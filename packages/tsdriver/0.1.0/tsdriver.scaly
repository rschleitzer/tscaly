; SPDX-License-Identifier: Apache-2.0
;
; tsdriver — the top of tscaly: the compiler options, the program host, the
; incremental state, the command line, `tsc`'s execute, watch and build. A
; package of its own above the checker, so that a change to the driver does
; not compile the checker again.
;
; Ported from microsoft/typescript-go, pinned at commit 2bd066d8 (tag
; typescript/v7.0.2). See ../../../README.md for provenance.

package scaly 0.2.0
package tsbase 0.1.0
package tscaly 0.2.0

define tsdriver
{
    ; a case's tsconfig.json → its options and root file names (slice 261); after the
    ; program, whose resolver answers a module-named `extends`
    module tsoptions

    ; internal/compiler's program construction (slice 268): the file loader and
    ; verifyCompilerOptions, after the emitter whose output paths it asks
    module compiler

    ; the System the driver runs against (tsctests' TestSys: the map file system,
    ; its clock and the harness's bookkeeping)
    module system

    ; tsoptions' command-line parser
    module commandline

    ; compiler.NewProgram, GetDiagnosticsOfAnyProgram and Program.Emit over the System
    module programhost

    ; internal/execute/incremental: the incremental program and the build info
    module incremental

    ; tsc's help text
    module help

    ; internal/execute's command line and the System it runs against (phase (b)2),
    ; after the compiler whose program it builds
    module execute

    ; internal/execute's watcher (tsc --watch) and its watch manager
    module watcher

    ; internal/execute/build: the tsc -b orchestrator
    module build
}
