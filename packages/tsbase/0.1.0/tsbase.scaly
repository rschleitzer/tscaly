; SPDX-License-Identifier: Apache-2.0
;
; tsbase — the bottom of tscaly: the constant tables, the scanner, the AST, the
; parser and what they need (jsnum, tspath, semver, the option declarations,
; the hash and the inflater), with the instruments that read nothing above
; them. A package of its own so that a change above it does not compile it
; again; nothing here reaches the binder, the checker or the driver.
;
; Ported from microsoft/typescript-go, pinned at commit 2bd066d8 (tag
; typescript/v7.0.2). See ../../../README.md for provenance.

package scaly 0.2.0

define tsbase
{
    ; The syntax-kind tag. GENERATED — edit tools/genkind.py, not the file.
    ;
    ; It is declared FIRST because module declaration order decides whether a
    ; module-level constant is visible: a `define` read from a module declared
    ; LATER is a hard `unknown identifier` in operator position and, worse, is
    ; SILENTLY DROPPED along with the whole call when it appears as a call
    ; argument. Every module below reads these constants.
    module Kind

    ; Per-token scanner flags. Hand-ported; short and readable.
    module TokenFlags

    ; Per-node parser/binder flags. Hand-ported, like TokenFlags, and declared
    ; here for the same reason Kind is: the parser reads these constants.
    module NodeFlags

    ; The four bits GetFunctionFlags answers with. Hand-ported like TokenFlags and
    ; NodeFlags, and declared here for the same reason: the checker reads these
    ; constants, and a `define` read from a module declared LATER is silently
    ; dropped in call-argument position.
    module FunctionFlags

    ; Per-modifier-keyword flags. Hand-ported like TokenFlags and NodeFlags, and
    ; declared up here for the same reason: the parser reads these constants, and
    ; a `define` read from a module declared LATER is silently dropped in
    ; call-argument position.
    module ModifierFlags

    ; Per-symbol flags and the EXCLUDES sets the binder tests a declaration
    ; against. GENERATED — edit tools/gensymbolflags.py, not the file; the
    ; generator's header has the argument for why this table is generated while
    ; NodeFlags and ModifierFlags are hand-ported. Declared up here with the other
    ; constant tables, for the same reason they are.
    module SymbolFlags

    ; The checker's TYPE flags, and the composites the checker tests a type's
    ; flags against. GENERATED — edit tools/gentypeflags.py, not the file; its
    ; header has the argument for why this table is generated (the composites, and
    ; the fact that the bit POSITIONS are an ORDER a union's printed form depends
    ; on). Declared up here with the other constant tables for the same reason
    ; they are.
    module TypeFlags

    ; ast.IsDeclarationNode, as a question about the KIND. GENERATED — edit
    ; tools/gendeclarationkinds.py, not the file; its header has the argument for
    ; why this one CANNOT be hand-written (the reference asks it of the node
    ; LAYOUT, not of the kind, and seven of the fifty-six answers are ones no
    ; reader would guess). Declared up here with the other constant tables,
    ; because it reads the Kind constants and every module below reads it.
    module DeclarationKinds

    ; The TS error numbers. GENERATED — edit tools/gendiagnostics.py, not the
    ; file. Declared here for the same reason Kind is: both the scanner and the
    ; parser read these constants, and a `define` read from a module declared
    ; LATER is silently dropped in call-argument position.
    module DiagnosticCodes

    ; Every message's text and category by code, which the driver prints.
    ; GENERATED — edit tools/genmessages.py, not the file.
    module DiagnosticMessages

    ; the 128-bit XXH3 hash incremental.ComputeHash asks for, ported from the
    ; reference's dependency (BSD-2-Clause, its notice in the file). Self-contained.
    module xxh3

    ; getSuggestedLibForNonExistentProperty's table: which lib adds which property
    ; to which type. GENERATED — edit tools/genfeaturemap.py, not the file; its
    ; header has the argument for why. Declared up here with the other constant
    ; tables, and the module is self-contained for exactly that reason.
    module FeatureMap

    ; core.ScriptTarget — the language-version numbers the ported guards compare
    ; against. Hand-ported, and up here with the other constant tables because
    ; both the scanner and the checker read them; it lived inside checker.scaly
    ; until slice 140 gave the SCANNER a reader, at which point a module declared
    ; after it could no longer see the constants.
    module ScriptTarget

    ; The parser's diagnostic LIST — shared with the scanner, which is what the
    ; reference's ErrorCallback reduces to here. Declared before the scanner,
    ; which appends to it.
    module Diagnostics

    ; The keyword table + GetIdentifierToken. GENERATED — edit
    ; tools/genkeywords.py, not the file.
    module Keywords

    ; The ECMAScript identifier code-point tables. GENERATED — edit
    ; tools/genunicode.py, not the file. Declared before the scanner, which
    ; calls into it.
    module UnicodeId

    ; The four Unicode PROPERTY tables — Table 66-68 of ECMA-262 plus the Unicode
    ; 15.1 script values — which the regular expression grammar validates
    ; `\p{...}` against. GENERATED — edit tools/genunicodeprops.py, not the file.
    ; Declared before the scanner, which calls into it, and after Keywords, whose
    ; kw_eq it compares bytes with.
    module UnicodeProps

    ; The ECMAScript case-mapping tables — specialCasingMappings plus the two
    ; range tables its Final_Sigma context needs. GENERATED — edit
    ; tools/genjscase.py, not the file. Declared before the checker, which reads
    ; it for the intrinsic `Uppercase`/`Lowercase`/`Capitalize`/`Uncapitalize`
    ; types, and beside the other generated tables for their reason: a `define`
    ; read from a module declared LATER is silently dropped in call-argument
    ; position.
    module JsCase

    ; Go's own `unicode.ToLower` and `unicode.SimpleFold` — the SIMPLE case
    ; mappings, which are a different function from JsCase's special casing and
    ; are the ones core.GetSpellingSuggestion measures a distance with.
    ; GENERATED — edit tools/genunicodecase.py, not the file. Declared beside the
    ; other tables for the same reason.
    module UnicodeCase

    ; The JSX entity table (`&nbsp;` …) the JSX transformer decodes with — GENERATED
    ; by tools/genjsxentities.py from the reference's jsx.go; reads nothing.
    module JsxEntities

    ; The ECMAScript Number conversions — internal/jsnum, plus the decimal↔binary
    ; machinery of Go's own strconv that it delegates to. Declared before the
    ; scanner, which normalizes every numeric literal's value through it; it reads
    ; nothing from any other module.
    module jsnum

    ; The scanner. Everything reachable from Scan() is ported; what remains is
    ; parser-driven (the re-scan entry points, JSX, comment directives) and is
    ; listed at `unported_pos`.
    module scanner

    ; The syntax tree. The reference's tag-struct-plus-interface becomes a
    ; tag-struct plus a SUM TYPE — see the file header.
    module ast

    ; The one function of internal/tspath the parser asks for: does this file's
    ; NAME make it a declaration file. Declared before the parser, which calls
    ; it; it reads nothing from any other module.
    module tspath

    ; The parser. Slice 1: the source-file spine, the statements a file of
    ; plain declarations is made of, and primary expressions. Everything else
    ; reports its own position (`unported_pos`) rather than building a tree
    ; that disagrees with the reference while looking well-formed.
    module parser

    ; internal/semver (slice 259): the typesVersions and `types@` ranges, before the
    ; resolver that tests them
    module semver

    ; an address-keyed index for the checker's link tables, before the checker
    module addressindex

    module TsOptionDecls

    ; xxh3's own instrument (slice 289), and NumCheck's argument one level over:
    ; `hash64` decides every `--generateTrace` file thread id, the two trace
    ; baselines reach ONE of its six length classes, and an arm no input reaches
    ; is indistinguishable from a correct one. tests/hashcheck.sh diffs this
    ; against the reference's own zeebo/xxh3.
    module HashCheck

    ; jsnum's own instrument (slice 44), and the same argument PathCheck makes one
    ; paragraph down: the corpus sees a numeric literal's VALUE in 27 units, and
    ; every other arm of the conversion is unexercised and therefore unmeasured.
    ; tests/numcheck.sh diffs this against the reference's own jsnum.
    module NumCheck

    ; jsnum's OTHER instrument (slice 116), and it is a second module rather than
    ; an arm of the first because the two corpora have nothing in common: a
    ; conversion's input is a string, an operation's is a pair of doubles. The
    ; checker yardstick sees these operators through enum member values only, and
    ; the corpus's enums are almost all small non-negative integers.
    ; tests/arithcheck.sh diffs this against the reference's own jsnum.
    module ArithCheck

    ; The absolute-path arms' own instrument (slice 28): the same generated corpus
    ; goes through this and through the reference's tspath, and tests/pathcheck.sh
    ; diffs the two. Not a port of anything either — the corpus cannot reach the
    ; root scanner's UNC/DOS/URL arms or the segment loop's `..`, and an
    ; unexercised arm is indistinguishable from a right one.
    module PathCheck

    ; OUR half of the binder yardstick's dump — not a port of anything; the format
    ; is ours and tests/oracle/symbols.go is its other producer. It lives in the
    ; package rather than in the dumper program because the numbering needs
    ; containers, and a generic instance handed to a program root reads back as
    ; garbage.
    ; ★ Slice 58 moved three dump bodies out of their PROGRAM roots and in here,
    ; so that `tscaly_dump` — which produces all five artifacts of a unit in one
    ; process — and the five single-artifact programs share one copy each. Declared
    ; after `parser` because JsDocDump asks the Parser for a node's JSDoc, and
    ; JsDocDump after AstDump because it prints a JSDoc tree with AstDump's printer.
    module TokenDump

    module AstDump

    module JsDocDump

    ; OUR half of the FLOW yardstick's dump (slice 92) — not a port of anything;
    ; the format is ours and tests/oracle/flow.go is its other producer. In the
    ; package rather than in the dumper program for SymbolDump's reason (the
    ; numbering needs containers), and after `binder` because it prints what a
    ; bind produced.
    module FlowDump

    ; internal/diagnosticwriter: a diagnostic as a terminal prints it
    ; gzip/DEFLATE for the embedded translations
    module inflate
}
