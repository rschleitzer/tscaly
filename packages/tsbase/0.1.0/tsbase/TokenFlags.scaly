; SPDX-License-Identifier: Apache-2.0
;
; TokenFlags — per-token scanner flags, ported from the reference's
; internal/ast/tokenflags.go.
;
; Hand-ported rather than generated: upstream writes this file by hand too, it is
; short, and its composites are more readable spelled out than derived.
;
; Upstream declares this int32. Here it is int (i64), for the same reason Kind is
; — the width question belongs to the stage where a token or node carries the
; value by value. The bit POSITIONS are what matter and they are exact.
;
; The composites below are written symbolically rather than as pre-computed
; numbers. That is not a given in Scaly: a module-level `define` initializer folds
; constant integer expressions at plan time, and it folds constant IDENTIFIERS as
; well as literals (measured — `define FC: int FA | FB` emits 12). Keeping them
; symbolic means a changed bit position cannot leave a stale composite behind.

define TokenFlagsNone:                           int 0
define TokenFlagsPrecedingLineBreak:             int 1 << 0
define TokenFlagsPrecedingJSDocComment:          int 1 << 1
define TokenFlagsUnterminated:                   int 1 << 2
define TokenFlagsExtendedUnicodeEscape:          int 1 << 3   ; e.g. \u{10ffff}
define TokenFlagsScientific:                     int 1 << 4   ; e.g. 10e2
define TokenFlagsOctal:                          int 1 << 5   ; e.g. 0777
define TokenFlagsHexSpecifier:                   int 1 << 6   ; e.g. 0x00000000
define TokenFlagsBinarySpecifier:                int 1 << 7   ; e.g. 0b0110010000000000
define TokenFlagsOctalSpecifier:                 int 1 << 8   ; e.g. 0o777
define TokenFlagsContainsSeparator:              int 1 << 9   ; e.g. 0b1100_0101
define TokenFlagsUnicodeEscape:                  int 1 << 10  ; e.g.
define TokenFlagsContainsInvalidEscape:          int 1 << 11  ; e.g. \uhello
define TokenFlagsHexEscape:                      int 1 << 12  ; e.g. \xa0
define TokenFlagsContainsLeadingZero:            int 1 << 13  ; e.g. 0888
define TokenFlagsContainsInvalidSeparator:       int 1 << 14  ; e.g. 0_1
define TokenFlagsPrecedingJSDocLeadingAsterisks: int 1 << 15
define TokenFlagsSingleQuote:                    int 1 << 16  ; e.g. 'abc'
define TokenFlagsPrecedingJSDocWithDeprecated:   int 1 << 17
define TokenFlagsPrecedingJSDocWithSeeOrLink:    int 1 << 18

; Composites.
define TokenFlagsBinaryOrOctalSpecifier: int TokenFlagsBinarySpecifier | TokenFlagsOctalSpecifier
define TokenFlagsWithSpecifier:          int TokenFlagsHexSpecifier | TokenFlagsBinarySpecifier | TokenFlagsOctalSpecifier
define TokenFlagsRegularExpressionLiteralFlags: int TokenFlagsUnterminated

define TokenFlagsStringLiteralFlags: int TokenFlagsUnterminated | TokenFlagsHexEscape | TokenFlagsUnicodeEscape | TokenFlagsExtendedUnicodeEscape | TokenFlagsContainsInvalidEscape | TokenFlagsSingleQuote

define TokenFlagsNumericLiteralFlags: int TokenFlagsScientific | TokenFlagsOctal | TokenFlagsContainsLeadingZero | TokenFlagsHexSpecifier | TokenFlagsBinarySpecifier | TokenFlagsOctalSpecifier | TokenFlagsContainsSeparator | TokenFlagsContainsInvalidSeparator

define TokenFlagsTemplateLiteralLikeFlags: int TokenFlagsUnterminated | TokenFlagsHexEscape | TokenFlagsUnicodeEscape | TokenFlagsExtendedUnicodeEscape | TokenFlagsContainsInvalidEscape

define TokenFlagsIsInvalid: int TokenFlagsOctal | TokenFlagsContainsLeadingZero | TokenFlagsContainsInvalidSeparator | TokenFlagsContainsInvalidEscape
