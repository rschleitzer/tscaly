; SPDX-License-Identifier: Apache-2.0
;
; tscaly_arith — our half of the jsnum ARITHMETIC cross-check (slice 116).
;
; Reads a corpus of two bit patterns per line and prints, per line, the thirteen
; results tests/oracle/arith.go prints off the reference's own jsnum;
; tests/arithcheck.sh runs both over the same file.
;
; Why it is a program of its own rather than a case in the four yardsticks: the
; question is about a PAIR OF DOUBLES and not about a source file, so there is no
; unit to hang it on — and the arms it covers are the ones a corpus of TypeScript
; enums cannot produce. See tscaly/ArithCheck.scaly.
;
; The work lives in the package; this is three steps and no logic of its own.

package scaly 0.1.0
package tscaly 0.1.1

use scaly.memory.Page
use scaly.os.File
use scaly.containers.String
use tscaly.ArithCheck.ArithCheck

procedure main(argc: int, mutable argv: pointer[pointer[char]]) returns int
{
    if argc <> 2
    {
        print "usage: tscaly_arith <corpus>"
        return 2
    }

    let path String(*(argv + 1))
    if File.exists(path) = false
    {
        print "cannot read `path`"
        return 1
    }

    let text File.read_to_string(path)

    ; The run region and its SMALL anchor: the corpus text is one oversized
    ; allocation, and Page.get() of an address inside one answers a page whose
    ; first allocation trips the oversized-page trap (§3.12).
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())

    ArithCheck.run(host, text)
    0
}
