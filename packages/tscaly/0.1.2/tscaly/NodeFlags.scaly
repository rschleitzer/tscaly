; SPDX-License-Identifier: Apache-2.0
;
; NodeFlags — per-node parser/binder flags, ported from the reference's
; internal/ast/nodeflags.go.
;
; Hand-ported rather than generated, for the same reasons TokenFlags is: upstream
; writes this file by hand, it is short, and its composites read better spelled
; out than derived. The composites stay SYMBOLIC — a module-level `define`
; initializer folds constant identifiers as well as literals, so a changed bit
; position cannot leave a stale composite behind.
;
; Upstream declares this uint32. Here it is int (i64); the bit POSITIONS are what
; the yardstick compares, and they are exact.
;
; ★ The flags fall into three groups, and only the first is this port's business
; at the parser stage:
;
;   - set by the PARSER            Let, Const, Using, ThisNodeHasError, HasJSDoc,
;                                  Ambient, the context flags, ...
;   - set by the BINDER or CHECKER ExportContext, ContainsThis, HasImplicitReturn,
;                                  Unreachable, ...  (never set here, and the
;                                  yardstick would see it if they were)
;   - REPURPOSED bits              IdentifierHasExtendedUnicodeEscape is
;                                  ContainsThis, NestedNamespace is OptionalChain.
;                                  Same bit, different meaning per node kind —
;                                  which is why they are aliases here rather than
;                                  new positions.

define NodeFlagsNone:                            int 0
define NodeFlagsLet:                             int 1 << 0   ; variable declaration
define NodeFlagsConst:                           int 1 << 1   ; variable declaration
define NodeFlagsUsing:                           int 1 << 2   ; variable declaration
define NodeFlagsReparsed:                        int 1 << 3   ; synthesized during parsing
define NodeFlagsSynthesized:                     int 1 << 4   ; synthesized during transformation
define NodeFlagsOptionalChain:                   int 1 << 5
define NodeFlagsExportContext:                   int 1 << 6   ; set by the binder
define NodeFlagsContainsThis:                    int 1 << 7
define NodeFlagsHasImplicitReturn:               int 1 << 8   ; set by the binder
define NodeFlagsHasExplicitReturn:               int 1 << 9   ; set by the binder
define NodeFlagsDisallowInContext:               int 1 << 10
define NodeFlagsYieldContext:                    int 1 << 11
define NodeFlagsDecoratorContext:                int 1 << 12
define NodeFlagsAwaitContext:                    int 1 << 13
define NodeFlagsDisallowConditionalTypesContext: int 1 << 14
define NodeFlagsThisNodeHasError:                int 1 << 15
define NodeFlagsJavaScriptFile:                  int 1 << 16
define NodeFlagsThisNodeOrAnySubNodesHasError:   int 1 << 17
define NodeFlagsHasAsyncFunctions:               int 1 << 18 ; set by the binder
define NodeFlagsPossiblyContainsDynamicImport:   int 1 << 19
define NodeFlagsPossiblyContainsImportMeta:      int 1 << 20
define NodeFlagsHasJSDoc:                        int 1 << 21
define NodeFlagsJSDoc:                           int 1 << 22
define NodeFlagsAmbient:                         int 1 << 23
define NodeFlagsInWithStatement:                 int 1 << 24
define NodeFlagsJsonFile:                        int 1 << 25
define NodeFlagsPossiblyContainsDeprecatedTag:   int 1 << 26
define NodeFlagsUnreachable:                     int 1 << 27 ; set by the binder
define NodeFlagsReparserTransformedLiteral:      int 1 << 28

; Composites.
define NodeFlagsBlockScoped: int NodeFlagsLet | NodeFlagsConst | NodeFlagsUsing
define NodeFlagsConstant:    int NodeFlagsConst | NodeFlagsUsing

; NOTE (upstream's own): on a single node these two would be mutually exclusive.
define NodeFlagsAwaitUsing: int NodeFlagsConst | NodeFlagsUsing

define NodeFlagsReachabilityCheckFlags:   int NodeFlagsHasImplicitReturn | NodeFlagsHasExplicitReturn
define NodeFlagsReachabilityAndEmitFlags: int NodeFlagsReachabilityCheckFlags | NodeFlagsHasAsyncFunctions

; The flags a node inherits from the parsing context at finishNode time.
define NodeFlagsContextFlags: int NodeFlagsDisallowInContext | NodeFlagsDisallowConditionalTypesContext | NodeFlagsYieldContext | NodeFlagsDecoratorContext | NodeFlagsAwaitContext | NodeFlagsJavaScriptFile | NodeFlagsInWithStatement | NodeFlagsAmbient

; Excluded while parsing a Type.
define NodeFlagsTypeExcludesFlags: int NodeFlagsYieldContext | NodeFlagsAwaitContext

define NodeFlagsPermanentlySetIncrementalFlags: int NodeFlagsPossiblyContainsDynamicImport | NodeFlagsPossiblyContainsImportMeta

; Repurposed bits — same position, different meaning, selected by node kind.
define NodeFlagsIdentifierHasExtendedUnicodeEscape: int NodeFlagsContainsThis
define NodeFlagsIdentifierIsInJSDocNamespace:       int NodeFlagsHasAsyncFunctions
define NodeFlagsNestedNamespace:                    int NodeFlagsOptionalChain
