; SPDX-License-Identifier: Apache-2.0
;
; compiler — internal/compiler's construction of a program for a case (slice 268):
; fileloader.go and filesparser.go's file set — the root tasks, triple-slash path
; references, the imports and module augmentations through the module resolver,
; maxNodeModuleJsDepth — with processingDiagnostic.go's explaining diagnostics, and
; program.go's verifyCompilerOptions.
;
; ★ The loader is sequential where the reference queues parse tasks on a work group:
; a task's data (lowest depth, loaded, its subtasks) is per PATH, the reference's own
; key, and collectFiles' depth-first order — a file after its subtasks — decides the
; program's file order either way.
;
; ★ Not ported, and said by a stop: a lib reference directive naming no known lib
; (the spelling suggestion). A KNOWN lib
; reference adds nothing here: the lib chain is the checker's own. Package
; deduplication (redirects by PackageId) and project references are not ported.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.ast.*
use tscaly.binder.Binder
use tscaly.parser.Parser
use tscaly.scanner.Scanner
use tscaly.checker.Checker
use tscaly.program.*
use tscaly.addressindex.HashChain
use tscaly.emitter.EmitOptions
use tscaly.emitter.Emitter
use tscaly.emitter.Transformer
use tscaly.modulespecifiers.SpecifierHost
use tscaly.printer.SourceFileInfo
use tscaly.TsOptionDecls.TsOptionDecls
use tscaly.tsoptions.TsConfigParser
use tscaly.Diagnostics.ChainLine
use tscaly.tracing.Tracing
use tscaly.tracing.TraceArg
use tscaly.program.ResolutionContext
use tscaly.system.CompileStats

; fileIncludeKind
define FileIncludeKindImport: int 0
define FileIncludeKindReferenceFile: int 1
define FileIncludeKindTypeReferenceDirective: int 2
define FileIncludeKindLibReferenceDirective: int 3
define FileIncludeKindRootFile: int 4
define FileIncludeKindAutomaticTypeDirectiveFile: int 5

; where a program diagnostic lies: a program file's index, or one of these
define ProgramDiagnosticGlobal: int -1
define ProgramDiagnosticConfig: int -2

; `reason` and `explained_file` (-1 for none) mark a createDiagnosticExplainingFile
; diagnostic: the driver's program builds its location, chain and related
; information from them
define ProgramDiagnostic (file_index: int  pos: int  end: int  code: int  args: ref[Array[String]]?  var chain: ref[Array[ChainLine]]?  reason: ref[IncludeReason]?  explained_file: int)
{
    ; the message arguments, copied onto host
    function args1(host: ref[Page], a0: String) returns ref[Array[String]]
    {
        let a &Array[String]^host()
        let c0 String^host(a0)
        a.add(c0)
        a
    }

    function args2(host: ref[Page], a0: String, a1: String) returns ref[Array[String]]
    {
        let a &Array[String]^host()
        let c0 String^host(a0)
        a.add(c0)
        let c1 String^host(a1)
        a.add(c1)
        a
    }

    function args3(host: ref[Page], a0: String, a1: String, a2: String) returns ref[Array[String]]
    {
        let a &Array[String]^host()
        let c0 String^host(a0)
        a.add(c0)
        let c1 String^host(a1)
        a.add(c1)
        let c2 String^host(a2)
        a.add(c2)
        a
    }

    function text(s: Slice[char]) returns String
        String(s.data as pointer[const_char], s.length)
}

; a FileIncludeReason: a root, or a reference in a program file — an import
; specifier (synthetic for tslib and the JSX runtime) or a triple-slash reference's
; range; `name` is a root's file name or an automatic type directive's, `package_id`
; the resolution's PackageId key
define IncludeReason (kind: int  file_index: int  pos: int  end: int  synthetic: bool  name: Slice[char]  package_id: Slice[char])

; a parse task as its parent created it
define LoaderEdge (path: Slice[char]  increase_depth: bool  elide_on_depth: bool  reason: ref[IncludeReason]  package_id: Slice[char])

; a parse task's data, per path
define LoaderNode
(
    var path: Slice[char]
    var lowest_depth: int
    var loaded: bool
    var subtasks_started: bool
    edges: ref[Array[ref[LoaderEdge]]]
    diagnostics: ref[Array[ProgramDiagnostic]]
    var file_index: int
    ; parseTaskData.packageId: the first resolution's PackageId that named the file
    var package_id: Slice[char]
    ; includeProcessor.fileIncludeReasons of the file, in collectFiles' order
    reasons: ref[Array[ref[IncludeReason]]]
    ; ★★★ THE SPELLING THE FILE WAS FIRST COLLECTED UNDER, and it is the casing
    ; check's anchor (slice 297). Upstream's is `seen[data]`, written in
    ; `collectFiles`' own loop — the COLLECTION order, which is stable — where this
    ; port compared against `node.path`, the spelling the WALK happened to create
    ; the node with. The two agree only while the walk and the collection run the
    ; same way round, and the reference's walk does not (§3.5lc): reversing it made
    ; `with-triple-slash-ref-from-file` lose its TS1261 entirely.
    var collected_path: Slice[char]
    ; parseTask.redirectedParseTask: a project reference's source, loaded as its
    ; output declaration file
    var redirected: bool
    ; traceResolution: the module resolutions' and the type reference directives'
    ; trace lines
    traces: ref[Array[String]]
    type_traces: ref[Array[String]]
    ; whether collect_files has put this node in its `seen` list (slice 333): the
    ; membership test was a scan of the list per edge
    var in_seen: bool
    ; a load task holds the node (start_parallel): loaded = false while it parses
    var loading: bool
)

; PROTOTYPE (parallel parse): one file for a TaskPool worker. The worker reads and
; parses onto a heap page of its own (Page.allocate_page — a heap page outlives the
; worker thread, ROADMAP 2.3b) and writes its result into the job, a slot nobody
; else writes while the wave runs.
define PreparseJob
(
    index: int
    path: Slice[char]
    disk: Slice[char]
    text: Slice[char]
    var result: ref[PreparsedFile]?
    ; 1 once `result` is written, stored atomically by the worker
    done: u64
    ; 1 once someone started the parse (CAS): the worker that takes the job, or
    ; the walk, which parses a job nobody has started yet itself instead of
    ; spinning on it (await_preparse) -- measured 2026-09-21: with one worker the
    ; walk burned two seconds of CPU in sched_yield behind the queue
    taken: u64
)

function sched_yield() returns i32 extern

; The parallel walk (slice 375), as the reference's filesParser.start queues a
; parse task per file on its work group: the task parses its file OUTSIDE the
; shared lock (preparse_run, on a heap page of the file's own) and resolves it
; UNDER the lock -- load_node and everything it writes (the node table, the
; file table's lazy indexes, the resolution records, the resolver's caches,
; the program diagnostics, a stop) run one at a time, the way the sequential
; walk ran them -- and then starts the node's subtasks, which is where the
; reference's depth-first discovery becomes breadth-first: every file's
; imports are queued the moment the file is resolved instead of after the walk
; returns from the first of them. What the walk produced in ITS order and
; collect_files re-derives afterwards is unchanged by the order the tasks run
; in; what a task appends to the loader's own lists is appended under the
; lock. ★★★ A TASK NEVER SUBMITS: TaskPool.submit allows one submitting thread
; per group, and it writes one wake byte per item into a pipe the workers
; drain one byte per item -- a pipe of 16 K bytes on macOS against VS Code's
; 17 678 files. Submitting under the lock deadlocked the first run (the
; submitter blocked in the write holding the lock, ten workers spinning on
; the lock instead of draining: three hours of CPU, 2026-09-21). So a task
; puts the nodes it discovers on the loader's frontier, and the walk's own
; thread, the only submitter, pumps the frontier into the pool (pump_tasks)
; holding nothing while it writes.
define LoadTask
(
    loader: ref[ProgramLoader]
    node: ref[LoaderNode]
    reason: ref[IncludeReason]
)

; ★★★ THE WALK'S OWN LOCK, NOT enter_shared: the resolution under it reaches
; Parser.jsdoc_for_node, which takes enter_shared for the lazy JSDoc cache --
; a spinlock nobody may re-enter. The first run with enter_shared here was
; eleven threads at 100 % (2026-09-21). Nothing under this lock is touched by
; anyone else while the walk runs, and the order is always loader lock first,
; shared lock inside, never the other way round.
shared atomic loader_lock: u64 0

; a failed try yields the core: the holder resolves a whole file under the
; lock, and ten workers spinning on it cost two seconds of CPU per run on VS
; Code (measured 2026-09-21) for nothing
procedure enter_loader()
{
    var spinning true
    while spinning
    {
        if scaly_atomic_cas_u64(&loader_lock, 0 as u64, 1 as u64) = (0 as u64)
            spinning := false
        else
            sched_yield()
    }
}

procedure leave_loader()
    scaly_atomic_store_u64(&loader_lock, 0 as u64)

procedure load_task(mutable arg: pointer[void]) returns pointer[void]
{
    let t arg as ref[LoadTask]
    let ld t.loader
    let node t.node
    ; 1. the parse, outside the lock: the job needs the file table's index,
    ; which the lock guards
    enter_loader()
    var job: ref[PreparseJob]? null
    if (ld.stop_tag.length as int) = 0
        job := ld.parse_job_for(node.path)
    leave_loader()
    if job <> null
        preparse_run(job as ref[PreparseJob])
    ; 2. the load, under the lock
    var go false
    var depth 0
    enter_loader()
    if (ld.stop_tag.length as int) = 0
    {
        if job <> null
        {
            let j job as ref[PreparseJob]
            if j.result <> null
                ld.files.set_preparsed(j.index, j.result as ref[PreparsedFile])
        }
        ld.load_node(node, t.reason)
        if node.subtasks_started = false
        {
            node.subtasks_started := true
            go := true
        }
        depth := node.lowest_depth
    }
    node.loading := false
    leave_loader()
    if go
        ld.start_parallel(node.edges, depth)
    null
}

; The parallel bind (slice 374), as the reference's BindSourceFiles queues a
; task per file on its work group: one job per worker, the files it binds by
; position, each binder on a heap page of the job's own (a heap page outlives
; the worker, ROADMAP 2.3b). The job also builds the two per-file tables the
; check pool would otherwise build one by one before its workers start (the
; list-range index and the ECMA line starts). A stop is recorded, never
; raised, on the worker: the loader raises the one the sequential walk would
; have met first after the wave (bind_all walks the files last to first).
define BindJob
(
    loader: ref[ProgramLoader]
    positions: ref[Array[int]]
    var stop_index: int
    var stop_tag: Slice[char]
    var bind_ns: int
)

procedure bind_task(mutable arg: pointer[void]) returns pointer[void]
{
    let job arg as ref[BindJob]
    let pg Page.allocate_page()
    let ld job.loader
    var i 0
    while i < (job.positions.get_length() as int)
    {
        let index job.positions[i as size_t]
        i := i + 1
        let t0 scaly_eio_now_ns()
        let tag ld.bind_one_on(pg, index)
        job.bind_ns := job.bind_ns + (scaly_eio_now_ns() - t0)
        if (tag.length as int) > 0
        {
            if index > job.stop_index
            {
                job.stop_index := index
                job.stop_tag := tag
            }
        }
    }
    null
}

procedure preparse_task(mutable arg: pointer[void]) returns pointer[void]
{
    let job arg as ref[PreparseJob]
    if scaly_atomic_cas_u64(&job.taken, 0 as u64, 1 as u64) <> (0 as u64)
        return null
    preparse_run(job)
    null
}

; the parse itself, on whichever thread took the job, onto a heap page of the
; file's own (a page per thread instead would be a thread-local global, whose
; write clause every caller up the walk would have to carry; measured 2026-09-21
; the page per file costs about 0.2 s of CPU over VS Code's 10 066 files)
procedure preparse_run(mutable job: ref[PreparseJob])
{
    let pg Page.allocate_page()
    var content String()
    if (job.disk.length as int) > 0
        content := ProgramFiles.read_disk_string(pg, job.disk)
    else
        content := String^pg(job.text.data as pointer[const_char], job.text.length)
    let path String^pg(job.path.data as pointer[const_char], job.path.length)
    let script_kind Parser.supported_script_kind(path)
    var parse_text content
    let decoded StringBuilder^pg()
    if Emitter.decode_bytes(Slice[char](content.get_length(), content.get_buffer() as pointer[char]), &decoded)
        parse_text := String^pg(decoded.to_string())
    var unported 0 - 1
    var tag: Slice[char] ""
    var detail 0
    let p Parser.parse_ex(pg, path, parse_text, script_kind, &unported, &tag, &detail)
    job.result := &PreparsedFile^pg(parse_text, p, unported, tag, detail)
    scaly_atomic_store_u64(&job.done, 1 as u64)
}

define ProgramLoader
(
    host: ref[Page]
    files: ref[ProgramFiles]
    options: EmitOptions
    ; ★NULLABLE since slice 293 — upstream's `fileloader.go` holds no checker at
    ; all, and this port's held one only so the walk could ask four questions that
    ; are pure (see ResolutionContext). It is set after the walk, for the two
    ; output-path calls `verify_emit_file_paths` makes.
    var checker: ref[Checker]?
    specifiers: ref[SpecifierHost]
    nodes: ref[Array[ref[LoaderNode]]]
    root_edges: ref[Array[ref[LoaderEdge]]]
    max_depth: int
    ; the program's files in the reference's order, and per table index whether
    ; the program holds it and whether it was found searching node_modules
    program_files: ref[Array[int]]
    program_paths: ref[Array[Slice[char]]]
    members: ref[Array[bool]]
    from_node_modules_search: ref[Array[bool]]
    diagnostics: ref[Array[ProgramDiagnostic]]
    var stop_tag: Slice[char]
    ; packageIdToSourceFile, as two parallel lists
    package_ids: ref[Array[Slice[char]]]
    package_files: ref[Array[int]]
    ; blockEmittingOfFile: the output paths an input would overwrite
    blocked_paths: ref[Array[Slice[char]]]
    ; projectReferenceFileMapper.sourceToProjectReference: a referenced project's
    ; source file and its output declaration file (empty for none)
    reference_sources: ref[Array[Slice[char]]]
    reference_outputs: ref[Array[Slice[char]]]
    ; redirectFilesByPath: a deduplicated package file, its target's table index
    ; and its position among the program's files
    redirect_paths: ref[Array[Slice[char]]]
    redirect_targets: ref[Array[int]]
    redirect_positions: ref[Array[int]]
    ; a program file carries a `/// <reference lib>` (the lib chain does not follow it)
    var lib_reference_directive: bool
    ; traceResolution, and the trace lines in collectFiles' order
    var trace_resolution: bool
    trace_lines: ref[Array[String]]
    ; getRedirectForResolution: per reference source its redirect (-1 none), and per
    ; redirect the config, its options, its `paths` and their base
    reference_redirects: ref[Array[int]]
    redirect_configs: ref[Array[Slice[char]]]
    redirect_options: ref[Array[EmitOptions]]
    redirect_path_options: ref[Array[ref[JsonValue]?]]
    redirect_paths_bases: ref[Array[Slice[char]]]
    ; the `/// <reference lib>` directives of the program's files in collectFiles'
    ; order: the name as written, and the file
    lib_ref_names: ref[Array[Slice[char]]]
    lib_ref_files: ref[Array[int]]
    ; tasksSeenByNameIgnoreCase (a case-sensitive file system): each walked task's
    ; lower-cased path and its node
    casing_keys: ref[Array[Slice[char]]]
    casing_nodes: ref[Array[ref[LoaderNode]]]
    ; the `--generateTrace` session, null unless the option was given: the parse
    ; and bind events belong where the work is, and since slice 292 the work is here
    var tracing: ref[Tracing]?
    ; `nodes` by path: rows chained under the case-folding hash of their path (a
    ; case-insensitive rename keeps the hash), first equal path answering
    node_chain: ref[HashChain]
    ; --diagnostics' timings, the driver's (slice 348): the bind is measured here,
    ; where the walk binds each file it parses
    var stats: ref[CompileStats]?
    ; PROTOTYPE (parallel parse): the pool of the walk, its group, and the job
    ; queued for each file index
    var prepool: ref[TaskPool]?
    var pregroup: ref[TaskGroup]?
    var prejobs: ref[Array[ref[PreparseJob]?]]?
    ; the nodes the tasks discovered and nobody has submitted yet (under the
    ; shared lock); pump_tasks moves them into the pool
    var frontier: ref[Array[ref[LoadTask]]]?
    ; the parse workers the driver sized (DriverProgram.preparse_size); 0 = the
    ; walk parses each file itself
    var preparse_n: int
    ; whether the bind jobs build each file's list-range index and line starts:
    ; the check pool needs them built before its workers start, a single
    ; checker builds them lazily for the files it asks about
    var bind_tables: bool
)
{
    procedure set_checker(mutable this, c: ref[Checker])
    {
        checker := c
        specifiers.set_checker(c)
    }

    function create(host: ref[Page], files: ref[ProgramFiles], options: EmitOptions, checker: ref[Checker]?) returns ref[ProgramLoader]
    {
        let members &Array[bool]^host()
        let searched &Array[bool]^host()
        var i 0
        while i < files.count()
        {
            members.add(false)
            searched.add(false)
            i := i + 1
        }
        var depth 0
        if options.max_node_module_js_depth > 0
            depth := options.max_node_module_js_depth
        let sh SpecifierHost.create(host, checker, files, options)
        &ProgramLoader^host(host, files, options, checker, sh, &Array[ref[LoaderNode]]^host(), &Array[ref[LoaderEdge]]^host(), depth, &Array[int]^host(), &Array[Slice[char]]^host(), members, searched, &Array[ProgramDiagnostic]^host(), Slice[char](), &Array[Slice[char]]^host(), &Array[int]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[int]^host(), &Array[int]^host(), false, false, &Array[String]^host(), &Array[int]^host(), &Array[Slice[char]]^host(), &Array[EmitOptions]^host(), &Array[ref[JsonValue]?]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[int]^host(), &Array[Slice[char]]^host(), &Array[ref[LoaderNode]]^host(), null, HashChain.create(host), null, null, null, null, null, 0, false)
    }

    procedure session_push(mutable tracing: ref[Tracing]?, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?) returns int
    {
        if tracing = null
            return TraceMainThreadId
        (tracing as ref[Tracing]).push(phase, name, args)
    }

    procedure session_pop(mutable tracing: ref[Tracing]?, tid: int, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?)
    {
        if tracing = null
            return
        (tracing as ref[Tracing]).pop(tid, phase, name, args)
    }

    procedure trace_push(mutable this, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?) returns int
    {
        if tracing = null
            return TraceMainThreadId
        (tracing as ref[Tracing]).push(phase, name, args)
    }

    procedure trace_pop(mutable this, tid: int, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?)
    {
        if tracing = null
            return
        (tracing as ref[Tracing]).pop(tid, phase, name, args)
    }

    procedure stop(mutable this, tag: Slice[char])
    {
        if (stop_tag.length as int) = 0
            this.stop_tag := tag
    }

    ; the loader's own inputs to getModeForUsageLocation — upstream's fileloader
    ; passes `(fileName, meta, options)` and holds no checker at all
    function resolution_context(this) returns ResolutionContext
        ResolutionContext(files, options.get_emit_module_kind(), options.get_module_resolution_kind(), options.resolve_package_json_exports, options.resolve_package_json_imports, ModuleKindNone)

    ; ★★★ fileLoader.parseSourceFile — the file at `index` parsed and bound THE
    ; FIRST TIME THE LOADER REACHES IT (slice 292). It used to be
    ; DriverProgram.add_source_unit, run over every source-extension file of the
    ; whole test filesystem before the walk began; the table now registers a path
    ; and its raw text and nothing else, and this is what fills an entry in.
    ; ★The symbol id base is the entry's INDEX. It used to be `pf.count()`, which
    ; was the same number only because a file was appended at the moment it was
    ; parsed.
    procedure ensure_parsed(mutable this, index: int) returns bool
    {
        this.await_preparse(index)
        let tag ProgramLoader.parse_entry(Page.get(this), files, options, index, tracing)
        if (tag.length as int) = 0
            return true
        this.stop(tag)
        false
    }

    ; the same parse as a STATIC, because `DriverProgram` needs ONE file parsed
    ; before it can build the checker the loader is handed — the reference's
    ; program is fully loaded before `GetTypeChecker` is asked, and this port
    ; creates its checker first (the loader's SpecifierHost needs one). Answers
    ; the stop tag, empty when the entry parsed or needed no parse.
    procedure parse_entry(host: ref[Page], mutable files: ref[ProgramFiles], options: EmitOptions, index: int, mutable tracing: ref[Tracing]?) returns Slice[char]
    {
        if files.file_at(index) <> null
            return Slice[char]()
        let path_data files.path_at(index)
        if ProgramLoader.parseable_extension(path_data) = false
            return Slice[char]()
        let path String^host(path_data.data as pointer[const_char], path_data.length as size_t)
        let script_kind Parser.supported_script_kind(path)
        ; PROTOTYPE (parallel parse): a file a worker parsed ahead of the walk
        let pre files.take_preparsed(index)
        if pre <> null
        {
            let pf pre as ref[PreparsedFile]
            files.keep_string(index, pf.text)
            if pf.unported >= 0
                return pf.tag
            if pf.parser = null
                return "parse-no-tree"
            return ProgramLoader.finish_entry(files, options, index, path_data, script_kind, pf.text, pf.parser as ref[Parser])
        }
        let content files.string_at(index)
        let raw files.text_at(index)
        var parse_text content
        let decoded StringBuilder^host()
        if Emitter.decode_bytes(raw, &decoded)
            parse_text := decoded.to_string()
        let text_copy parse_text
        var unported 0 - 1
        var unported_tag: Slice[char] ""
        var unported_detail 0
        let cs_args Tracing.no_args(host)
        Tracing.add_arg(host, cs_args, "path", path_data)
        let cs_tid ProgramLoader.session_push(tracing, TracePhaseParse, "createSourceFile", cs_args)
        let p Parser.parse_ex(host, path, text_copy, script_kind, &unported, &unported_tag, &unported_detail)
        ProgramLoader.session_pop(tracing, cs_tid, TracePhaseParse, "createSourceFile", cs_args)
        if unported >= 0
            return unported_tag
        ProgramLoader.finish_entry(files, options, index, path_data, script_kind, text_copy, p)
    }

    ; parse_entry after the parse: the file's module kindness, and the entry filled
    procedure finish_entry(mutable files: ref[ProgramFiles], options: EmitOptions, index: int, path_data: Slice[char], script_kind: int, text_copy: String, mutable p: ref[Parser]) returns Slice[char]
    {
        let file_opt Parser.source_file_of(p)
        if file_opt = null
            return "parse-no-tree"
        let file file_opt as ref[AstNode]
        var is_external Parser.external_module_indicator(file, AstNode.statements_of(file)) or Emitter.is_file_module_from_using_jsx_tag(file, script_kind, options)
        var forced false
        let is_json path_data.ends_with(".json")
        if options.module_detection_is_force() and (is_declaration_file_name_of(path_data) = false) and (is_json = false)
        {
            if is_external = false
                forced := true
            is_external := true
        }
        if (is_declaration_file_name_of(path_data) = false) and (is_json = false) and options.module_detection_is_auto()
        {
            if Emitter.is_file_forced_to_be_module_by_format(path_data, options)
            {
                if is_external = false
                    forced := true
                is_external := true
            }
        }
        ; ★The FORMAT is not recomputed here: the registration pass has already
        ; set it per entry from the nearest package.json's `type`
        ; (`unit_package_json_type`), which this loader's own options do not carry
        ; — recomputing it without one answered CJS where the file is ESM and
        ; turned four moduleResolution baselines red.
        ; ★★★ THE BIND IS NOT DONE HERE SINCE SLICE 293 — `bind_all` below is the
        ; reference's own `bindSourceFiles`, a block of its own after createProgram
        ; closes. What made the split possible is that nothing in the walk asks a
        ; binder any more: the two questions it had (external module, declaration
        ; file) are parse-time and are recorded on the next line.
        files.set_parsed(index, Slice[char](text_copy.get_length() as int, text_copy.get_buffer() as pointer[char]), file, null, p, files.format_at(index))
        files.set_module_kindness(index, is_external, forced)
        Slice[char]()
    }

    ; ★★★ program.go's `bindSourceFiles`, AND ITS ORDER IS A STACK. The reference
    ; queues one task per unbound file of `SourceFiles()` into a `core.WorkGroup`
    ; and runs it; the SINGLE-THREADED work group is LIFO — `Queue` appends and
    ; `pop` takes from the END (core/workgroup.go) — so the files are bound in the
    ; REVERSE of that order. Every task is queued before any runs, so iterating
    ; backwards is exactly the same program. It is what the trace baselines show:
    ; parsed lib, types.ts, main.ts and bound main.ts, types.ts, lib.
    ; ★The tasks are the PROGRAM's files in the program's order (`SourceFiles()`,
    ; which collectFiles built), so the loop runs over `program_files` backwards;
    ; a parsed entry that is not a program file (a package's second instance) is
    ; never bound, as upstream never binds it. It ran over the whole file TABLE
    ; until 2026-09-16, whose order is the registration's (§3.5le).
    procedure bind_all(mutable this) returns bool
    {
        if (preparse_n > 0) and (tracing = null)
            return this.bind_all_parallel(preparse_n)
        var i (program_files.get_length() as int) - 1
        while i >= 0
        {
            if this.bind_one(program_files[i as size_t]) = false
                return false
            i := i - 1
        }
        true
    }

    ; bind_all over n TaskPool workers: file position p goes to worker p % n;
    ; the stop raised afterwards is the one at the highest position, which is
    ; the one the last-to-first sequential walk meets first
    procedure bind_all_parallel(mutable this, n: int) returns bool
    {
        let host Page.get(this)
        let jobs &Array[ref[BindJob]]()
        var k 0
        while k < n
        {
            jobs.add(&BindJob^host(this, &Array[int]^host(), 0 - 1, null, 0))
            k := k + 1
        }
        var p 0
        while p < (program_files.get_length() as int)
        {
            let share jobs[(p % n) as size_t]
            share.positions.add(program_files[p as size_t])
            p := p + 1
        }
        let pool TaskPool.create((n - 1) as i64)
        let group TaskGroup.create()
        var w 1
        while w < n
        {
            TaskPool.submit(pool, &bind_task, jobs[w as size_t] as pointer[void], group)
            w := w + 1
        }
        bind_task(jobs[0 as size_t] as pointer[void])
        TaskGroup.wait(group)
        TaskGroup.dispose(group)
        TaskPool.shutdown(pool)
        var stop_index 0 - 1
        var stop_tag: Slice[char] ""
        var total_ns 0
        var j 0
        while j < n
        {
            let job jobs[j as size_t]
            total_ns := total_ns + job.bind_ns
            if job.stop_index > stop_index
            {
                stop_index := job.stop_index
                stop_tag := job.stop_tag
            }
            j := j + 1
        }
        if stats <> null
        {
            let st stats as ref[CompileStats]
            st.bind := st.bind + total_ns
        }
        if stop_index >= 0
        {
            this.stop(stop_tag)
            return false
        }
        true
    }

    ; one file's bind for a worker: the binder on `host`, the file's two lazy
    ; tables built here, the stop answered as a tag ("" none) instead of raised
    procedure bind_one_on(mutable this, host: ref[Page], index: int) returns Slice[char]
    {
        let f files.file_at(index)
        if f = null
            return ""
        if files.binder_at(index) <> null
            return ""
        let path_data files.path_at(index)
        let path String^host(path_data.data as pointer[const_char], path_data.length as size_t)
        let text files.string_at(index)
        let b Binder.bind_source_file_ex(host, f as ref[AstNode], text, path, files.external_at(index), files.forced_module_at(index))
        if Binder.unported_at(b) >= 0
            return Binder.unported_tag_at(b)
        files.set_binder(index, b)
        if bind_tables
        {
            AstNode.prepare_list_range_index(f)
            b.ecma_line_starts()
        }
        ""
    }

    procedure bind_one(mutable this, index: int) returns bool
    {
        let f files.file_at(index)
        if f = null or files.binder_at(index) <> null
            return true
        let host Page.get(this)
        let path_data files.path_at(index)
        let path String^host(path_data.data as pointer[const_char], path_data.length as size_t)
        let text files.string_at(index)
        let bs_args Tracing.no_args(host)
        Tracing.add_arg(host, bs_args, "path", path_data)
        let bs_tid ProgramLoader.session_push(tracing, TracePhaseBind, "bindSourceFile", bs_args)
        let bind_t0 scaly_eio_now_ns()
        let b Binder.bind_source_file_ex(host, f as ref[AstNode], text, path, files.external_at(index), files.forced_module_at(index))
        if stats <> null
        {
            let st stats as ref[CompileStats]
            st.bind := st.bind + (scaly_eio_now_ns() - bind_t0)
        }
        ProgramLoader.session_pop(tracing, bs_tid, TracePhaseBind, "bindSourceFile", bs_args)
        if Binder.unported_at(b) >= 0
        {
            this.stop(Binder.unported_tag_at(b))
            return false
        }
        files.set_binder(index, b)
        true
    }

    ; the extensions DriverProgram.source_extension names, minus `.json`: a JSON
    ; file reached as a MODULE is parsed by the same path, but the config file and
    ; every other stray `.json` of the test filesystem is never reached at all,
    ; which is the whole point of parsing on demand.
    function parseable_extension(path: Slice[char]) returns bool
    {
        if path.ends_with(".ts") or path.ends_with(".tsx") or path.ends_with(".mts") or path.ends_with(".cts")
            return true
        if path.ends_with(".js") or path.ends_with(".jsx") or path.ends_with(".mjs") or path.ends_with(".cjs")
            return true
        path.ends_with(".json")
    }

    ; processAllProgramFiles over the harness's root file names (lib files are the
    ; checker's lib chain)
    procedure load(mutable this, roots: ref[Array[Slice[char]]])
    {
        var r 0
        while r < (roots.get_length() as int)
        {
            this.add_root_file_task(roots[r as size_t])
            r := r + 1
        }
        if roots.get_length() > 0
            this.add_automatic_type_directive_tasks()
        this.preparse_roots()
        if prepool <> null
        {
            this.start_parallel(root_edges, 0)
            this.pump_tasks()
            TaskGroup.wait(pregroup as ref[TaskGroup])
        }
        else
            this.start(root_edges, 0)
        this.finish_preparse()
        let seen &Array[ref[LoaderNode]]^host()
        var ni 0
        while ni < (nodes.get_length() as int)
        {
            let nn nodes[ni as size_t]
            nn.in_seen := false
            ni := ni + 1
        }
        this.collect_files(root_edges, seen)
        var k 0
        while k < (program_files.get_length() as int)
        {
            members.put(program_files[k as size_t] as size_t, true)
            k := k + 1
        }
    }

    ; getRedirectForResolution's file name: a referenced project's output declaration
    ; file resolves from its source
    ; The parallel parse: every root file is read and parsed on TaskPool workers
    ; ahead of the walk, which then takes the results (parse_entry). The driver
    ; sizes the pool (preparse_n, DriverProgram.preparse_size: the reference's
    ; fileLoader queues its parse tasks on a work group over every core, and a
    ; TEST program runs single-threaded); TSCALY_PREPARSE=<n> overrides it, for
    ; measurements. Off whenever a trace is recorded.
    procedure preparse_workers() returns int
    {
        let env getenv("TSCALY_PREPARSE")
        if env = null
            return 0
        let bytes env as pointer[u8]
        var n 0
        var i 0
        while true
        {
            let b *(bytes + i) as int
            if (b < 48) or (b > 57)
                break
            n := (n * 10) + (b - 48)
            i := i + 1
        }
        n
    }

    ; the pool for the whole walk; the roots are queued by the walk's first
    ; start (prefetch_edges), which is where every later file is queued too
    procedure preparse_roots(mutable this)
    {
        var n preparse_n
        let forced ProgramLoader.preparse_workers()
        if forced > 0
            n := forced
        if n <= 0
            return
        if tracing <> null
            return
        this.prepool := TaskPool.create(n as i64)
        this.pregroup := TaskGroup.create()
        this.prejobs := &Array[ref[PreparseJob]?]^host()
        this.frontier := &Array[ref[LoadTask]]^host()
    }

    ; the walk's thread feeds the pool from the frontier until every task has
    ; finished and nothing is left to submit; it holds no lock while a submit
    ; may block on the pool's wake pipe
    procedure pump_tasks(mutable this)
    {
        let pool prepool as ref[TaskPool]
        let group pregroup as ref[TaskGroup]
        let fr frontier as ref[Array[ref[LoadTask]]]
        var batch &Array[ref[LoadTask]]()
        repeat
        {
            enter_loader()
            var k 0
            while k < (fr.get_length() as int)
            {
                batch.add(fr[k as size_t])
                k := k + 1
            }
            fr.clear()
            leave_loader()
            if batch.get_length() = 0
            {
                if scaly_atomic_load_u64(&group.pending) = (0 as u64)
                {
                    ; nothing running, and the frontier was empty when we looked
                    enter_loader()
                    let left fr.get_length()
                    leave_loader()
                    if left = 0
                        break
                }
                sched_yield()
                continue
            }
            var s 0
            while s < (batch.get_length() as int)
            {
                TaskPool.submit(pool, &load_task, batch[s as size_t] as pointer[void], group)
                s := s + 1
            }
            batch.clear()
        }
    }

    ; queue a parse for every edge target not parsed and not queued, in the
    ; order the walk will reach them (it walks the list from its end)
    procedure prefetch_edges(mutable this, edges: ref[Array[ref[LoaderEdge]]])
    {
        if prepool = null
            return
        let list prejobs as ref[Array[ref[PreparseJob]?]]
        var i (edges.get_length() as int) - 1
        while i >= 0
        {
            let edge edges[i as size_t]
            i := i - 1
            let index files.index_of_path(edge.path)
            if index < 0
                continue
            if files.file_at(index) <> null
                continue
            while (list.get_length() as int) <= index
                list.add(null)
            if list[index as size_t] <> null
                continue
            let path_data files.path_at(index)
            if ProgramLoader.parseable_extension(path_data) = false
                continue
            let disk files.disk_path_at(index)
            var text Slice[char]()
            if (disk.length as int) = 0
                text := files.text_at(index)
            let job &PreparseJob^host(index, path_data, disk, text, null, 0 as u64, 0 as u64)
            list.put(index as size_t, job)
            TaskPool.submit(prepool as ref[TaskPool], &preparse_task, job as pointer[void], pregroup as ref[TaskGroup])
        }
    }

    ; the walk needs file `index` now: wait for its job, if one was queued
    procedure await_preparse(mutable this, index: int)
    {
        if prejobs = null
            return
        let list prejobs as ref[Array[ref[PreparseJob]?]]
        if index >= (list.get_length() as int)
            return
        let row list[index as size_t]
        if row = null
            return
        let job row as ref[PreparseJob]
        ; a job no worker has started yet is parsed here, on the walk's thread
        if scaly_atomic_cas_u64(&job.taken, 0 as u64, 1 as u64) = (0 as u64)
            preparse_run(job)
        while scaly_atomic_load_u64(&job.done) = (0 as u64)
            sched_yield()
        if job.result <> null
            files.set_preparsed(index, job.result as ref[PreparsedFile])
    }

    procedure finish_preparse(mutable this)
    {
        if prepool = null
            return
        TaskGroup.wait(pregroup as ref[TaskGroup])
        TaskGroup.dispose(pregroup as ref[TaskGroup])
        TaskPool.shutdown(prepool as ref[TaskPool])
        this.prepool := null
        this.pregroup := null
    }

    procedure resolution_containing_path(mutable this, path_in: Slice[char]) returns Slice[char]
    {
        let path this.symlink_dts_path(path_in)
        var i 0
        while i < (reference_outputs.get_length() as int)
        {
            let output reference_outputs[i as size_t]
            if ((output.length as int) > 0) and output.equals(path)
                return reference_sources[i as size_t]
            i := i + 1
        }
        path_in
    }

    ; getSourceToDtsIfSymlink: a symlinked node_modules path under preserveSymlinks
    ; is looked up through its real path when that is a reference's output
    procedure symlink_dts_path(mutable this, path: Slice[char]) returns Slice[char]
    {
        if files.preserve_symlinks = false
            return path
        if slice_contains_node_modules(path) = false
            return path
        let real files.real_path(path)
        var i 0
        while i < (reference_outputs.get_length() as int)
        {
            let output reference_outputs[i as size_t]
            if ((output.length as int) > 0) and output.equals(real)
                return real
            i := i + 1
        }
        path
    }

    ; getRedirectForResolution: the redirect of a referenced project's source or
    ; output declaration file, -1 for none
    procedure redirect_for(mutable this, path_in: Slice[char]) returns int
    {
        let path this.symlink_dts_path(path_in)
        var i 0
        while i < (reference_sources.get_length() as int)
        {
            let source reference_sources[i as size_t]
            let output reference_outputs[i as size_t]
            if source.equals(path) or (((output.length as int) > 0) and output.equals(path))
            {
                if i < (reference_redirects.get_length() as int)
                    return reference_redirects[i as size_t]
                return 0 - 1
            }
            i := i + 1
        }
        0 - 1
    }

    ; a resolver for an import (or a type reference directive) of the file at `path`:
    ; the program's options, or its project reference redirect's
    ; `on_page` holds the resolver and every path it builds: the program's host, or
    ; resolve_one's scratch page (see there)
    procedure resolver_for(mutable this, on_page: ref[Page], path: Slice[char], mode: int, for_type_reference: bool) returns ref[ModuleResolver]
    {
        let redirect this.redirect_for(path)
        var o options
        if redirect >= 0
            o := redirect_options[redirect as size_t]
        var resolve_json o.get_resolve_json_module()
        if for_type_reference
            resolve_json := false
        let resolver ModuleResolver.create(on_page, files, o.get_module_resolution_kind(), resolve_json, mode, EmitOptions.on(o.allow_js), o.resolve_package_json_exports, o.resolve_package_json_imports, o.out_dir, o.project_root_directory(on_page))
        if redirect >= 0
        {
            resolver.module_suffixes := o.module_suffixes
            resolver.redirect_config_name := redirect_configs[redirect as size_t]
            resolver.has_paths_override := true
            resolver.paths_override := redirect_path_options[redirect as size_t]
            resolver.paths_base_override := redirect_paths_bases[redirect as size_t]
        }
        if trace_resolution
            resolver.enable_trace(o.module_resolution = o.get_module_resolution_kind())
        resolver
    }

    ; traceResolution: the resolver's tracer, and the moduleResolution line's question
    procedure enable_trace(this, mutable resolver: ref[ModuleResolver])
    {
        if trace_resolution
            resolver.enable_trace(options.module_resolution = options.get_module_resolution_kind())
    }

    ; the lines are COPIED onto the list's own page: a resolver may live on a
    ; scratch page that goes back after the resolution (resolve_one)
    procedure append_traces(mutable out: ref[Array[String]], resolver: ref[ModuleResolver])
    {
        if resolver.traces = null
            return
        let list resolver.traces as ref[Array[String]]
        let pg Page.get(out)
        var i 0
        while i < (list.get_length() as int)
        {
            out.add(String^pg(list[i as size_t]))
            i := i + 1
        }
    }

    ; the task data at `path`, null when no task named it
    function find_node(this, path: Slice[char]) returns ref[LoaderNode]?
    {
        var i node_chain.first(ProgramFiles.fold_hash(path))
        while i >= 0
        {
            let n nodes[i as size_t]
            if files.same_path(n.path, path)
                return n
            i := node_chain.after(i)
        }
        null
    }

    procedure node_for(mutable this, path: Slice[char]) returns ref[LoaderNode]
    {
        let found this.find_node(path)
        if found <> null
            return found as ref[LoaderNode]
        let made &LoaderNode^host(slice_copy_on(host, path), 1000000000, false, false, &Array[ref[LoaderEdge]]^host(), &Array[ProgramDiagnostic]^host(), 0 - 1, null, &Array[ref[IncludeReason]]^host(), Slice[char](), false, &Array[String]^host(), &Array[String]^host(), false, false)
        node_chain.add(ProgramFiles.fold_hash(made.path))
        nodes.add(made)
        made
    }

    ; addRootFileTask
    procedure add_root_file_task(mutable this, file_name: Slice[char])
    {
        let cwd options.get_current_directory()
        let abs_path get_normalized_absolute_path(host, file_name, cwd)
        var containing cwd
        if (options.config_file_path.length as int) > 0
            containing := get_normalized_absolute_path(host, options.config_file_path, cwd)
        let reason &IncludeReason^host(FileIncludeKindRootFile, 0 - 1, 0, 0, false, file_name, null)
        var resolved Slice[char]()
        let code this.source_file_from_reference(abs_path, containing, false, &resolved)
        var path resolved
        if code <> 0
            path := abs_path
        let edge &LoaderEdge^host(path, false, false, reason, null)
        root_edges.add(edge)
        if code <> 0
        {
            let node this.node_for(path)
            this.add_explaining_diagnostic(node.diagnostics, reason, code, this.reference_args(code, file_name))
        }
    }

    ; getSourceFileFromReference: the file a reference names, or a code
    procedure source_file_from_reference(mutable this, file_name: Slice[char], containing_file: Slice[char], is_referenced: bool, mutable out_path: ref[Slice[char]]) returns int
    {
        if ProgramLoader.has_extension(host, file_name)
        {
            if this.is_supported_extension(file_name) = false
            {
                if ProgramLoader.has_js_file_extension(file_name)
                    return DiagFile_0_is_a_JavaScript_file_Did_you_mean_to_enable_the_allowJs_option
                return DiagFile_0_has_an_unsupported_extension_The_only_supported_extensions_are_1
            }
            if files.file_exists(file_name) = false
                return DiagFile_0_not_found
            if is_referenced and containing_file.equals(file_name)
                return DiagA_file_cannot_have_a_reference_to_itself
            out_path.data := file_name.data
            out_path.length := file_name.length
            return 0
        }
        let candidates &Array[Slice[char]]()
        candidates.add(".ts")
        candidates.add(".tsx")
        candidates.add(".d.ts")
        var i 0
        while i < (candidates.get_length() as int)
        {
            let candidate join_slices(host, file_name, candidates[i as size_t])
            if files.file_exists(candidate)
            {
                out_path.data := candidate.data
                out_path.length := candidate.length
                return 0
            }
            i := i + 1
        }
        DiagCould_not_resolve_the_path_0_with_the_extensions_Colon_1
    }

    ; tspath.HasExtension: a dot in the base file name
    function has_extension(host: ref[Page], path: Slice[char]) returns bool
        slice_contains_byte(get_base_file_name(host, path), ("." as char) as int)

    function has_js_file_extension(path: Slice[char]) returns bool
        path.ends_with(".js") or path.ends_with(".jsx") or path.ends_with(".mjs") or path.ends_with(".cjs")

    ; isSupportedExtension over GetSupportedExtensionsWithJsonIfResolveJsonModule
    function is_supported_extension(this, path: Slice[char]) returns bool
    {
        if path.ends_with(".ts") or path.ends_with(".tsx") or path.ends_with(".cts") or path.ends_with(".mts")
            return true
        if EmitOptions.on(options.allow_js)
        {
            if ProgramLoader.has_js_file_extension(path)
                return true
        }
        if options.get_resolve_json_module()
        {
            if path.ends_with(".json")
                return true
        }
        false
    }

    ; createDiagnosticExplainingFile: at the reference when the reason is a
    ; non-synthetic reference in a file, else a compiler diagnostic
    procedure add_explaining_diagnostic(this, mutable out: ref[Array[ProgramDiagnostic]], reason: ref[IncludeReason], code: int, args: ref[Array[String]]?)
    {
        if (reason.kind <= FileIncludeKindLibReferenceDirective) and (reason.synthetic = false)
            out.add(ProgramDiagnostic(reason.file_index, reason.pos, reason.end, code, args, null, reason, 0 - 1))
        else
            out.add(ProgramDiagnostic(ProgramDiagnosticGlobal, 0, 0, code, args, null, reason, 0 - 1))
    }

    ; addProcessingDiagnosticsForFileCasing
    procedure add_casing_diagnostic(mutable this, file_node: ref[LoaderNode], existing: Slice[char], current: Slice[char], reason: ref[IncludeReason])
    {
        var existing_referenced false
        var r 0
        while r < (file_node.reasons.get_length() as int)
        {
            let known file_node.reasons[r as size_t]
            if known.kind <= FileIncludeKindLibReferenceDirective
                existing_referenced := true
            r := r + 1
        }
        var code DiagFile_name_0_differs_from_already_included_file_name_1_only_in_casing
        var args ProgramDiagnostic.args2(host, ProgramDiagnostic.text(current), ProgramDiagnostic.text(existing))
        if (reason.kind > FileIncludeKindLibReferenceDirective) and existing_referenced
        {
            code := DiagAlready_included_file_name_0_differs_from_file_name_1_only_in_casing
            args := ProgramDiagnostic.args2(host, ProgramDiagnostic.text(existing), ProgramDiagnostic.text(current))
        }
        if (reason.kind <= FileIncludeKindLibReferenceDirective) and (reason.synthetic = false)
            diagnostics.add(ProgramDiagnostic(reason.file_index, reason.pos, reason.end, code, args, null, reason, file_node.file_index))
        else
            diagnostics.add(ProgramDiagnostic(ProgramDiagnosticGlobal, 0, 0, code, args, null, reason, file_node.file_index))
    }

    ; createDiagnosticExplainingFile for a diagnostic about a file the program
    ; holds: recorded with the file, the driver's program builds its location, chain
    ; and related information from the file's include reasons
    procedure add_file_explaining_diagnostic(mutable this, file_index: int, code: int, args: ref[Array[String]]?)
    {
        ; located at the file's first non-synthetic reference, the driver adds the rest
        let reasons this.node_for(files.path_at(file_index)).reasons
        var i 0
        while i < (reasons.get_length() as int)
        {
            let reason reasons[i as size_t]
            i := i + 1
            if (reason.kind <= FileIncludeKindLibReferenceDirective) and (reason.synthetic = false)
            {
                diagnostics.add(ProgramDiagnostic(reason.file_index, reason.pos, reason.end, code, args, null, null, file_index))
                return
            }
        }
        diagnostics.add(ProgramDiagnostic(ProgramDiagnosticGlobal, 0, 0, code, args, null, null, file_index))
    }

    ; the arguments of getSourceFileFromReference's diagnostic
    procedure reference_args(mutable this, code: int, diagnostic_name: Slice[char]) returns ref[Array[String]]?
    {
        if (code = DiagFile_0_is_a_JavaScript_file_Did_you_mean_to_enable_the_allowJs_option) or (code = DiagFile_0_not_found)
            return ProgramDiagnostic.args1(host, ProgramDiagnostic.text(diagnostic_name))
        if (code = DiagFile_0_has_an_unsupported_extension_The_only_supported_extensions_are_1) or (code = DiagCould_not_resolve_the_path_0_with_the_extensions_Colon_1)
            return ProgramDiagnostic.args2(host, ProgramDiagnostic.text(diagnostic_name), this.supported_extensions_text())
        null
    }

    ; "'" + strings.Join(core.Flatten(supportedExtensions), "', '") + "'"
    function supported_extensions_text(this) returns String
    {
        var sb StringBuilder()
        if EmitOptions.on(options.allow_js)
            sb.append("'.ts', '.tsx', '.d.ts', '.js', '.jsx', '.cts', '.d.cts', '.cjs', '.mts', '.d.mts', '.mjs'")
        else
            sb.append("'.ts', '.tsx', '.d.ts', '.cts', '.d.cts', '.mts', '.d.mts'")
        sb.to_string()
    }

    ; filesParser.start
    ; ★★★ THE WALK RUNS BACKWARDS, AS THE REFERENCE'S DOES — see
    ; ProgramLoader.bind_all for the mechanism (the single-threaded
    ; `core.WorkGroup` is a LIFO stack, so `startTasks` runs its last edge first);
    ; it is what puts the trace's `createSourceFile` events in the reference's
    ; order. ★It became the same program only once every FIRST-REACH fact had
    ; moved out of it (§3.5lc, §3.5ld, §3.5le): the casing a case-insensitive
    ; file system keeps a file under, the casing check's anchor, and the order a
    ; redirected file's include reasons are recorded are all decided in
    ; `collect_files`, which walks the edges in their ORIGINAL order, exactly as
    ; upstream's `collectFiles` does. What this walk still decides is what
    ; upstream's queued closures decide: which task loads a file, its package id,
    ; its lowest depth. Slice 296 named the nine baselines that moved while the
    ; two were fused; none moves now.
    procedure start(mutable this, mutable edges: ref[Array[ref[LoaderEdge]]], depth: int)
    {
        this.prefetch_edges(edges)
        var i (edges.get_length() as int) - 1
        while i >= 0
        {
            let edge edges[i as size_t]
            i := i - 1
            let node this.node_for(edge.path)
            ; "Propagate packageId to data if we have one and data doesn't yet"
            if ((node.package_id.length as int) = 0) and ((edge.package_id.length as int) > 0)
                node.package_id := edge.package_id
            var start_subtasks false
            var current_depth depth
            if edge.increase_depth
                current_depth := depth + 1
            if current_depth < node.lowest_depth
            {
                node.lowest_depth := current_depth
                start_subtasks := true
            }
            if edge.elide_on_depth and (current_depth > max_depth)
                continue
            if node.loaded = false
                this.load_node(node, edge.reason)
            if (node.subtasks_started = false) and start_subtasks
            {
                node.subtasks_started := true
                this.start(node.edges, node.lowest_depth)
            }
        }
    }

    ; start over the pool (LoadTask): the same bookkeeping as start, under the
    ; shared lock, and a task for every node nobody has loaded or is loading;
    ; a node already loaded starts its subtasks here, as start does
    procedure start_parallel(mutable this, mutable edges: ref[Array[ref[LoaderEdge]]], depth: int)
    {
        var i (edges.get_length() as int) - 1
        while i >= 0
        {
            let edge edges[i as size_t]
            i := i - 1
            enter_loader()
            if (stop_tag.length as int) > 0
            {
                leave_loader()
                return
            }
            let node this.node_for(edge.path)
            if ((node.package_id.length as int) = 0) and ((edge.package_id.length as int) > 0)
                node.package_id := edge.package_id
            var start_subtasks false
            var current_depth depth
            if edge.increase_depth
                current_depth := depth + 1
            if current_depth < node.lowest_depth
            {
                node.lowest_depth := current_depth
                start_subtasks := true
            }
            if edge.elide_on_depth and (current_depth > max_depth)
            {
                leave_loader()
                continue
            }
            if node.loaded = false
            {
                if node.loading = false
                {
                    node.loading := true
                    let fr frontier as ref[Array[ref[LoadTask]]]
                    fr.add(&LoadTask^host(this, node, edge.reason))
                }
                leave_loader()
                continue
            }
            var go false
            if (node.subtasks_started = false) and start_subtasks
            {
                node.subtasks_started := true
                go := true
            }
            let lowest node.lowest_depth
            leave_loader()
            if go
                this.start_parallel(node.edges, lowest)
        }
    }

    ; the parse job of a node's file for a load task (under the lock): null
    ; when there is nothing to parse ahead -- no entry, parsed already, not a
    ; parseable extension; load_node then answers as it would sequentially
    procedure parse_job_for(mutable this, path: Slice[char]) returns ref[PreparseJob]?
    {
        let index files.index_of_path(path)
        if index < 0
            return null
        if files.file_at(index) <> null
            return null
        let path_data files.path_at(index)
        if ProgramLoader.parseable_extension(path_data) = false
            return null
        let disk files.disk_path_at(index)
        var text Slice[char]()
        if (disk.length as int) = 0
            text := files.text_at(index)
        &PreparseJob^host(index, path_data, disk, text, null, 0 as u64, 0 as u64)
    }

    ; getParseFileRedirect: the output declaration file of a referenced project's
    ; source, empty for none
    function parse_file_redirect(this, path: Slice[char]) returns Slice[char]
    {
        var result Slice[char]()
        var i 0
        while i < (reference_sources.get_length() as int)
        {
            let source reference_sources[i as size_t]
            if source.equals(path)
                result := reference_outputs[i as size_t]
            i := i + 1
        }
        result
    }

    ; parseTask.load
    procedure load_node(mutable this, mutable node: ref[LoaderNode], reason: ref[IncludeReason])
    {
        node.loaded := true
        let path node.path
        let redirect this.parse_file_redirect(path)
        if (redirect.length as int) > 0
        {
            node.redirected := true
            node.edges.add(&LoaderEdge^host(redirect, false, false, reason, null))
            return
        }
        if ProgramLoader.has_extension(host, path)
        {
            if this.is_supported_extension(path) = false
            {
                if ProgramLoader.has_js_file_extension(path)
                    this.add_explaining_diagnostic(node.diagnostics, reason, DiagFile_0_is_a_JavaScript_file_Did_you_mean_to_enable_the_allowJs_option, this.reference_args(DiagFile_0_is_a_JavaScript_file_Did_you_mean_to_enable_the_allowJs_option, path))
                else
                    this.add_explaining_diagnostic(node.diagnostics, reason, DiagFile_0_has_an_unsupported_extension_The_only_supported_extensions_are_1, this.reference_args(DiagFile_0_has_an_unsupported_extension_The_only_supported_extensions_are_1, path))
                return
            }
        }
        let index files.index_of_path(path)
        if index < 0
            return
        ; fileLoader.findSourceFile: the entry exists in the table as a path and a
        ; text; reaching it is what parses it
        if this.ensure_parsed(index) = false
            return
        if files.file_at(index) = null
            return
        node.file_index := index
        let parser files.parser_at(index)
        if (EmitOptions.on(options.no_resolve) = false) and (parser <> null)
        {
            let pp parser as ref[Parser]
            var ri 0
            while ri < Parser.reference_directive_count(pp)
            {
                var kind 0
                var rs 0
                var re 0
                Parser.reference_directive_at(pp, ri, &kind, &rs, &re)
                ri := ri + 1
                if kind = 0
                    this.resolve_tripleslash_path_reference(node, index, rs, re)
                if kind = 1
                {
                    ; getModeForTypeReferenceDirectiveInFile: the directive's own
                    ; resolution-mode (recorded right after it), else the file's
                    var mode 0 - 1
                    if ri < Parser.reference_directive_count(pp)
                    {
                        var mk 0
                        var mv 0
                        var mz 0
                        Parser.reference_directive_at(pp, ri, &mk, &mv, &mz)
                        if mk = 3
                        {
                            if mv = 1
                                mode := ModuleKindESNext
                            else
                                mode := ModuleKindCommonJS
                            ri := ri + 1
                        }
                    }
                    this.resolve_type_reference_directive(node, index, rs, re, mode)
                }
            }
        }
        if (options.no_lib <> TristateTrue) and (parser <> null)
        {
            let pp parser as ref[Parser]
            var li 0
            while li < Parser.reference_directive_count(pp)
            {
                var kind 0
                var rs 0
                var re 0
                Parser.reference_directive_at(pp, li, &kind, &rs, &re)
                li := li + 1
                if kind = 2
                {
                    let text files.text_at(index)
                    let name text.subslice(rs as size_t, re as size_t)
                    if ProgramLoader.is_known_lib(host, name) = false
                    {
                        ; processingDiagnosticKindUnknownReference
                        let lib_name ProgramLoader.lower_ascii(host, name)
                        var unqualified lib_name
                        if unqualified.starts_with("lib.")
                            unqualified := unqualified.slice_from(4)
                        if unqualified.ends_with(".d.ts")
                            unqualified := unqualified.subslice(0, unqualified.length - 5)
                        let suggestion this.lib_spelling_suggestion(unqualified)
                        let args ProgramDiagnostic.args1(host, ProgramDiagnostic.text(lib_name))
                        if suggestion.get_length() > 0
                        {
                            args.add(String^host(suggestion))
                            node.diagnostics.add(ProgramDiagnostic(index, rs, re, DiagCannot_find_lib_definition_for_0_Did_you_mean_1, args, null, null, 0 - 1))
                        }
                        else
                            node.diagnostics.add(ProgramDiagnostic(index, rs, re, DiagCannot_find_lib_definition_for_0, args, null, null, 0 - 1))
                        continue
                    }
                    this.lib_reference_directive := true
                    lib_ref_names.add(name)
                    lib_ref_files.add(index)
                }
            }
        }
        this.resolve_imports_and_module_augmentations(node, index)
    }

    ; core.GetSpellingSuggestionForStrings over tsoptions.Libs
    procedure lib_spelling_suggestion(mutable this, name: Slice[char]) returns String
    {
        let keys TsOptionDecls.enum_keys_text(TsOptionDecls.index_of("lib"))
        let rune_name Checker.name_runes_on(host, name)
        let rune_n rune_name.length as int
        var maximum_length_difference (rune_n * 34) / 100
        if maximum_length_difference < 2
            maximum_length_difference := 2
        var best_distance ((rune_n * 4) / 10) * 10 + 9
        var best Slice[char]()
        var has_best false
        var i 0
        while i < (keys.length as int)
        {
            ; the next quoted name
            while (i < (keys.length as int)) and ((keys[i as size_t] as int) <> (("'" as char) as int))
                i := i + 1
            if i >= (keys.length as int)
                break
            let start i + 1
            i := start
            while (i < (keys.length as int)) and ((keys[i as size_t] as int) <> (("'" as char) as int))
                i := i + 1
            let candidate keys.subslice(start as size_t, i as size_t)
            i := i + 1
            var max_len candidate.length as int
            var min_len rune_n
            if rune_n > max_len
            {
                max_len := rune_n
                min_len := candidate.length as int
            }
            if (candidate.length as int) = 0
                continue
            if (max_len - min_len) > maximum_length_difference
                continue
            if candidate.equals(name)
                continue
            if (candidate.length as int) < 3
            {
                if Checker.names_equal_fold(candidate, name) = false
                    continue
            }
            let rune_cand Checker.name_runes_on(host, candidate)
            let distance Checker.levenshtein_with_max_on(host, rune_name, rune_n, rune_cand, rune_cand.length as int, best_distance)
            if distance < 0
                continue
            if distance < best_distance
            {
                best_distance := distance
                best := candidate
                has_best := true
            }
            else
            {
                if (has_best = false) or (DiagnosticWriter.compare_bytes(candidate, best) < 0)
                {
                    best := candidate
                    has_best := true
                }
            }
        }
        String(best.data as pointer[const_char], best.length)
    }

    function lower_ascii(host: ref[Page], s: Slice[char]) returns Slice[char]
    {
        let sb StringBuilder^host()
        var i 0
        while i < (s.length as int)
        {
            var c s[i as size_t] as int
            if (c >= 65) and (c <= 90)
                c := c + 32
            sb.append(c as char)
            i := i + 1
        }
        let text String^host(sb.to_string())
        Slice[char](text.get_length() as int, text.get_buffer() as pointer[char])
    }

    ; tsoptions.GetLibFileName: a lib name or a lib file name
    function is_known_lib(host: ref[Page], name: Slice[char]) returns bool
    {
        let lower ProgramLoader.lower_ascii(host, name)
        let lib_index TsOptionDecls.index_of("lib")
        if lib_index < 0
            return false
        if (TsOptionDecls.enum_value(lib_index, lower).length as int) > 0
            return true
        if lower.starts_with("lib.") and lower.ends_with(".d.ts")
        {
            let inner lower.subslice(4, (lower.length as int - 5) as size_t)
            return (TsOptionDecls.enum_value(lib_index, inner).length as int) > 0
        }
        false
    }

    ; compilerOptions.GetEffectiveTypeRoots: the option, else node_modules/@types in
    ; every ancestor of the config's (or the current) directory
    procedure effective_type_roots(mutable this, mutable out_from_config: ref[bool]) returns ref[Array[Slice[char]]]
    {
        let roots &Array[Slice[char]]^host()
        let cwd options.get_current_directory()
        if (options.type_roots.length as int) > 0
        {
            out_from_config := true
            var start 0
            var i 0
            let text options.type_roots
            while i <= (text.length as int)
            {
                var at_end i = (text.length as int)
                var is_comma false
                if at_end = false
                    is_comma := (text[i as size_t] as int) = (("," as char) as int)
                if at_end or is_comma
                {
                    if i > start
                        roots.add(get_normalized_absolute_path(host, text.subslice(start as size_t, i as size_t), cwd))
                    start := i + 1
                }
                i := i + 1
            }
            return roots
        }
        out_from_config := false
        var base cwd
        if (options.config_file_path.length as int) > 0
            base := get_directory_path(host, get_normalized_absolute_path(host, options.config_file_path, cwd))
        var dir base
        repeat
        {
            roots.add(combine_paths(host, combine_paths(host, dir, "node_modules"), "@types"))
            let parent get_directory_path(host, dir)
            if parent.equals(dir)
                break
            dir := parent
        }
        roots
    }

    ; resolveTypeReferenceDirectives, one directive
    procedure resolve_type_reference_directive(mutable this, mutable node: ref[LoaderNode], index: int, start: int, stop: int, directive_mode: int)
    {
        let text files.text_at(index)
        let type_name text.subslice(start as size_t, stop as size_t)
        var from_config false
        let type_roots this.effective_type_roots(&from_config)
        var mode directive_mode
        if mode < 0
            mode := this.default_resolution_mode_for_file(index)
        let resolver this.resolver_for(host, files.path_at(index), mode, true)
        let r resolver.resolve_type_reference_directive(type_name, files.path_at(index), type_roots, from_config, false)
        ProgramLoader.append_traces(node.type_traces, resolver)
        if (resolver.stop_tag.length as int) > 0
        {
            this.stop(resolver.stop_tag)
            return
        }
        let reason &IncludeReason^host(FileIncludeKindTypeReferenceDirective, index, start, stop, false, null, resolver.package_id)
        if r < 0
        {
            node.diagnostics.add(ProgramDiagnostic(index, start, stop, DiagCannot_find_type_definition_file_for_0, ProgramDiagnostic.args1(host, ProgramDiagnostic.text(type_name)), null, null, 0 - 1))
            return
        }
        let resolved files.path_at(r)
        node.edges.add(&LoaderEdge^host(slice_copy_on(host, resolved), slice_contains_node_modules(resolved), false, reason, resolver.package_id))
    }

    ; getDefaultResolutionModeForFile: the implied format for emit where import
    ; syntax affects resolution, else none
    procedure default_resolution_mode_for_file(mutable this, index: int) returns int
    {
        let mr options.get_module_resolution_kind()
        var affects (mr >= ModuleResolutionKindNode16) and (mr <= ModuleResolutionKindNodeNext)
        ; GetResolvePackageJsonExports/Imports are IsTrueOrUnknown
        if (options.resolve_package_json_exports <> TristateFalse) or (options.resolve_package_json_imports <> TristateFalse)
            affects := true
        if affects = false
            return ModuleKindNone
        var unit_options options
        unit_options.package_json_type := files.package_json_type_at(index)
        unit_options.implied_node_format_for_emit_of_file(files.path_at(index))
    }

    ; addAutomaticTypeDirectiveTasks with loadAutomaticTypeDirectives: the `types`
    ; option's names, resolved from `__inferred type names__.ts`
    procedure add_automatic_type_directive_tasks(mutable this)
    {
        let text options.types
        if (text.length as int) = 0
            return
        let cwd options.get_current_directory()
        var directory cwd
        if (options.config_file_path.length as int) > 0
            directory := get_directory_path(host, get_normalized_absolute_path(host, options.config_file_path, cwd))
        let containing combine_paths(host, directory, "__inferred type names__.ts")
        var from_config false
        let type_roots this.effective_type_roots(&from_config)
        let node this.node_for(containing)
        node.loaded := true
        let reason &IncludeReason^host(FileIncludeKindRootFile, 0 - 1, 0, 0, false, null, null)
        root_edges.add(&LoaderEdge^host(containing, false, false, reason, null))
        var start 0
        var i 0
        while i <= (text.length as int)
        {
            var at_end i = (text.length as int)
            var is_comma false
            if at_end = false
                is_comma := (text[i as size_t] as int) = (("," as char) as int)
            if at_end or is_comma
            {
                var s start
                var e i
                while (s < e) and ((text[s as size_t] as int) = ((" " as char) as int))
                    s := s + 1
                while (e > s) and ((text[(e - 1) as size_t] as int) = ((" " as char) as int))
                    e := e - 1
                if e > s
                {
                    let type_name text.subslice(s as size_t, e as size_t)
                    if type_name.equals("*")
                    {
                        let matches this.wildcard_type_directive_names(type_roots)
                        var m 0
                        while m < (matches.get_length() as int)
                        {
                            this.add_automatic_type_directive(node, matches[m as size_t], containing, type_roots, from_config, reason)
                            m := m + 1
                        }
                    }
                    else
                        this.add_automatic_type_directive(node, type_name, containing, type_roots, from_config, reason)
                }
                start := i + 1
            }
            i := i + 1
        }
    }

    ; GetAutomaticTypeDirectiveNames' walk of the type roots: each root's
    ; directories, unless their package.json says `"typings": null` or the name
    ; starts with a dot
    procedure wildcard_type_directive_names(mutable this, type_roots: ref[Array[Slice[char]]]) returns ref[Array[Slice[char]]]
    {
        let result &Array[Slice[char]]^host()
        var r 0
        while r < (type_roots.get_length() as int)
        {
            let root ensure_trailing_directory_separator(host, type_roots[r as size_t])
            r := r + 1
            let names &Array[Slice[char]]()
            var f 0
            while f < files.count()
            {
                let path files.path_at(f)
                f := f + 1
                if (path.length <= root.length) or (path.starts_with(root) = false)
                    continue
                let rest path.slice_from(root.length)
                var slash 0 - 1
                var k 0
                while k < (rest.length as int)
                {
                    if (rest[k as size_t] as int) = (("/" as char) as int)
                    {
                        slash := k
                        break
                    }
                    k := k + 1
                }
                if slash <= 0
                    continue
                let dir_name rest.subslice(0, slash as size_t)
                var known false
                var n 0
                while n < (names.get_length() as int)
                {
                    let existing names[n as size_t]
                    if existing.equals(dir_name)
                    {
                        known := true
                        break
                    }
                    n := n + 1
                }
                if known = false
                    names.add(dir_name)
            }
            ; the directory listing's order
            var a 0
            while a < (names.get_length() as int)
            {
                var b a + 1
                while b < (names.get_length() as int)
                {
                    let x names[a as size_t]
                    let y names[b as size_t]
                    if TsConfigParser.compare_bytes(y, x) < 0
                    {
                        names.put(a as size_t, y)
                        names.put(b as size_t, x)
                    }
                    b := b + 1
                }
                a := a + 1
            }
            var q 0
            while q < (names.get_length() as int)
            {
                let dir_name names[q as size_t]
                q := q + 1
                if (dir_name[0] as int) = (("." as char) as int)
                    continue
                let package_json combine_paths(host, combine_paths(host, root, dir_name), "package.json")
                let pj_index files.index_of_path(package_json)
                if pj_index >= 0
                {
                    let json JsonParser.parse(host, files.text_at(pj_index))
                    if json <> null
                    {
                        let typings (json as ref[JsonValue]).get("typings")
                        if typings <> null
                        {
                            if (typings as ref[JsonValue]).kind = JsonKindNull
                                continue
                        }
                    }
                }
                result.add(dir_name)
            }
        }
        result
    }

    procedure add_automatic_type_directive(mutable this, mutable node: ref[LoaderNode], mutable type_name: Slice[char], containing: Slice[char], mutable type_roots: ref[Array[Slice[char]]], from_config: bool, reason: ref[IncludeReason])
    {
        let resolver ModuleResolver.create(host, files, options.get_module_resolution_kind(), false, ModuleKindNone, EmitOptions.on(options.allow_js), options.resolve_package_json_exports, options.resolve_package_json_imports, options.out_dir, options.project_root_directory(host))
        this.enable_trace(resolver)
        let r resolver.resolve_type_reference_directive(type_name, containing, type_roots, from_config, true)
        ProgramLoader.append_traces(node.type_traces, resolver)
        if (resolver.stop_tag.length as int) > 0
        {
            this.stop(resolver.stop_tag)
            return
        }
        if r < 0
            node.diagnostics.add(ProgramDiagnostic(ProgramDiagnosticGlobal, 0, 0, DiagCannot_find_type_definition_file_for_0, ProgramDiagnostic.args1(host, ProgramDiagnostic.text(type_name)), null, null, 0 - 1))
        else
        {
            let resolved files.path_at(r)
            let own &IncludeReason^host(FileIncludeKindAutomaticTypeDirectiveFile, reason.file_index, 0, 0, false, type_name, resolver.package_id)
            node.edges.add(&LoaderEdge^host(slice_copy_on(host, resolved), slice_contains_node_modules(resolved), false, own, resolver.package_id))
        }
    }

    ; resolveTripleslashPathReference
    procedure resolve_tripleslash_path_reference(mutable this, mutable node: ref[LoaderNode], index: int, start: int, stop: int)
    {
        let containing files.path_at(index)
        let text files.text_at(index)
        let module_name text.subslice(start as size_t, stop as size_t)
        var referenced module_name
        if is_rooted_disk_path(module_name) = false
            referenced := combine_paths(host, get_directory_path(host, containing), module_name)
        let normalized get_normalized_absolute_path(host, referenced, Slice[char]())
        let reason &IncludeReason^host(FileIncludeKindReferenceFile, index, start, stop, false, null, null)
        var resolved Slice[char]()
        let code this.source_file_from_reference(normalized, containing, true, &resolved)
        if code <> 0
        {
            this.add_explaining_diagnostic(node.diagnostics, reason, code, this.reference_args(code, normalize_slashes(host, module_name)))
            return
        }
        node.edges.add(&LoaderEdge^host(resolved, false, false, reason, null))
    }

    ; resolveImportsAndModuleAugmentations
    procedure resolve_imports_and_module_augmentations(mutable this, mutable node: ref[LoaderNode], index: int)
    {
        let file files.file_at(index) as ref[AstNode]
        let path files.path_at(index)
        ; ★ Both come from the PARSE, as upstream's `ast.IsExternalModule(file)` and
        ; `file.IsDeclarationFile` do: the files are bound after the loader since
        ; slice 293, so a binder asked here was absent and both answered false — no
        ; module augmentation name was ever resolved, and a `declare module 'x'`
        ; inside x's own typings (the @xterm/addon-* packages) merged nothing
        ; (2026-09-17, 29 TS2305 on VS Code).
        var is_external_module files.external_at(index)
        var is_declaration_file is_declaration_file_name_of(path)
        ; a caller that parsed AND bound before loading (the case harness's dump)
        ; keeps the binder's answer, which set_module_kindness never wrote there
        let binder files.binder_at(index)
        if binder <> null
        {
            is_external_module := (binder as ref[Binder]).is_external_module_of()
            is_declaration_file := (binder as ref[Binder]).is_declaration_file_of()
        }
        let is_js ProgramLoader.has_js_file_extension(path)

        let names &Array[ref[AstNode]?]^host()
        let synthetic_names &Array[Slice[char]]()
        ; the synthetic tslib import
        if is_js or ((is_declaration_file = false) and (EmitOptions.on(options.isolated_modules) or EmitOptions.on(options.verbatim_module_syntax) or is_external_module))
        {
            if EmitOptions.on(options.import_helpers)
                synthetic_names.add("tslib")
        }
        if path.ends_with(".jsx") or path.ends_with(".tsx")
        {
            ; `ast.GetJSXRuntimeImport(ast.GetJSXImplicitImportBase(optionsForFile, file), optionsForFile)`
            ; — fileloader.go:551, over the OPTIONS and not over a checker
            var script_kind ScriptKindUnknown
            let jp files.parser_at(index)
            if jp <> null
                script_kind := (jp as ref[Parser]).script_kind
            let jsx_import Checker.jsx_runtime_import_of(host, file, script_kind, options.jsx, options.jsx_import_source)
            if (jsx_import.length as int) > 0
                synthetic_names.add(jsx_import)
        }
        var si 0
        while si < (synthetic_names.get_length() as int)
        {
            this.resolve_one(node, index, synthetic_names[si as size_t], null, 0 - 1, 0)
            si := si + 1
        }
        let imports specifiers.imports_of(file)
        let import_count imports.get_length() as int
        var ii 0
        while ii < import_count
        {
            let entry imports[ii as size_t]
            if entry <> null
                names.add(entry)
            else
                names.add(null)
            ii := ii + 1
        }
        this.collect_module_augmentations(file, is_external_module, is_declaration_file, names)
        var n 0
        while n < (names.get_length() as int)
        {
            let entry names[n as size_t]
            if entry <> null
            {
                let en entry as ref[AstNode]
                this.resolve_one(node, index, AstNode.literal_text_of(en), en, n, import_count)
            }
            n := n + 1
        }
    }

    ; the module augmentations of collectModuleReferences (string-literal names only)
    procedure collect_module_augmentations(this, file: ref[AstNode], is_external_module: bool, is_declaration_file: bool, mutable out: ref[Array[ref[AstNode]?]])
    {
        let statements AstNode.statements_of(file)
        var i 0
        while i < AstNode.list_count(statements)
        {
            let st AstNode.child_in_list(statements, i)
            i := i + 1
            if st <> null
                this.collect_augmentations_of(st as ref[AstNode], false, is_external_module, is_declaration_file, out)
        }
    }

    procedure collect_augmentations_of(this, node: ref[AstNode], in_ambient_module: bool, is_external_module: bool, is_declaration_file: bool, mutable out: ref[Array[ref[AstNode]?]])
    {
        if AstNode.kind_of(node) <> KindModuleDeclaration
            return
        if Binder.is_ambient_module(node) = false
            return
        var eligible in_ambient_module or is_declaration_file
        if Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient)
            eligible := true
        if eligible = false
            return
        let name AstNode.name_of(node)
        let name_text AstNode.literal_text_of(name)
        if is_external_module or (in_ambient_module and (is_external_module_name_relative(name_text) = false))
        {
            if AstNode.kind_of(name) = KindStringLiteral
                out.add(name)
            return
        }
        if in_ambient_module
            return
        let body AstNode.body_of(node)
        if body = null
            return
        let statements AstNode.statements_of(body)
        var i 0
        while i < AstNode.list_count(statements)
        {
            let st AstNode.child_in_list(statements, i)
            i := i + 1
            if st <> null
                this.collect_augmentations_of(st as ref[AstNode], true, is_external_module, is_declaration_file, out)
        }
    }

    ; one module name of resolveImportsAndModuleAugmentations; `entry` null for a
    ; synthetic import, `import_count` the length of file.Imports()
    ;
    ; ★★ The resolution runs on a SCRATCH page that goes back when it is done: the
    ; resolver and every candidate path it builds are garbage the moment the answer
    ; is in, which upstream's GC collects and a region would keep to the end — 857 000
    ; resolvers and their paths, ~150 MB over the whole of VS Code (slice 354). What
    ; outlives it is copied onto the host in resolve_one_on: the package id, the
    ; stop tag, the trace lines (append_traces), the resolved path (the edge's own
    ; copy); ProgramFiles copies the keys it caches itself.
    procedure resolve_one(mutable this, mutable node: ref[LoaderNode], index: int, module_name: Slice[char], entry: ref[AstNode]?, import_index: int, import_count: int)
    {
        ; a page of its own, registered nowhere, so the host keeps no list cell for it
        let scratch Page.allocate_page()
        this.resolve_one_on(scratch, node, index, module_name, entry, import_index, import_count)
        scratch.deallocate_extensions()
        Page.release_page(scratch)
    }

    procedure resolve_one_on(mutable this, scratch: ref[Page], mutable node: ref[LoaderNode], index: int, module_name: Slice[char], entry: ref[AstNode]?, import_index: int, import_count: int)
    {
        if (module_name.length as int) = 0
            return
        files.record_resolution(index, module_name)
        let path files.path_at(index)
        var mode ModuleKindNone
        if entry <> null
            mode := Checker.usage_mode_in(this.resolution_context(), entry, files.format_at(index))
        else
            mode := Checker.usage_mode_in(this.resolution_context(), null, files.format_at(index))
        let resolver this.resolver_for(scratch, path, mode, false)
        let r resolver.resolve(module_name, this.resolution_containing_path(path))
        ProgramLoader.append_traces(node.traces, resolver)
        if (resolver.stop_tag.length as int) > 0
        {
            this.stop(slice_copy_on(host, resolver.stop_tag))
            return
        }
        let package_id slice_copy_on(host, resolver.package_id)
        ; the resolution's own diagnostics join the program's (includeProcessor)
        var rd 0
        while rd < (resolver.diagnostic_codes.get_length() as int)
        {
            let entry resolver.diagnostic_args[(2 * rd) as size_t]
            let package_path resolver.diagnostic_args[(2 * rd + 1) as size_t]
            diagnostics.add(ProgramDiagnostic(ProgramDiagnosticGlobal, 0, 0, resolver.diagnostic_codes[rd as size_t], ProgramDiagnostic.args2(host, ProgramDiagnostic.text(entry), ProgramDiagnostic.text(package_path)), null, null, 0 - 1))
            rd := rd + 1
        }
        if r < 0
            return
        if (package_id.length as int) > 0
            files.record_package(package_id, files.path_at(r))
        var resolved_path files.path_at(r)
        var found resolver.found_path
        if (found.length as int) = 0
            found := resolved_path
        let is_external_library_import slice_contains_node_modules(found)
        ; createResolvedModuleHandlingSymlink: the realpath only inside node_modules
        ; (a case-insensitive file system's realpath keeps the casing asked for)
        if is_external_library_import = false
            resolved_path := found
        else
        {
            if files.case_insensitive and files.same_path(found, resolved_path)
                resolved_path := found
        }
        var is_js true
        if resolved_path.ends_with(".ts") or resolved_path.ends_with(".tsx") or resolved_path.ends_with(".cts") or resolved_path.ends_with(".mts") or resolved_path.ends_with(".json")
            is_js := false
        let is_js_from_node_modules is_external_library_import and is_js and slice_contains_node_modules(resolved_path)
        if ProgramLoader.resolution_diagnostic(options, Checker.resolution_extension_for(resolved_path, resolver.resolved_arbitrary_extension), path) <> 0
            return
        if EmitOptions.on(options.no_resolve)
            return
        if is_js and (EmitOptions.on(options.allow_js) = false)
            return
        if entry <> null
        {
            let en entry as ref[AstNode]
            if import_index < import_count
            {
                if (Parser.is_in_js_file(en) = false) and ((AstNode.flags_of(en) & NodeFlagsJSDoc) <> 0)
                    return
            }
        }
        var reason &IncludeReason^host(FileIncludeKindImport, index, 0, 0, true, null, package_id)
        if entry <> null
        {
            let en entry as ref[AstNode]
            ; the SPAN of the import's module specifier: upstream computes it when
            ; the reason is REPORTED (fileInclude.go's referenceFileLocation, through
            ; GetErrorRangeForNode's default arm — skipTrivia from the node's pos,
            ; unless the node is missing, to its end), and the walk binds nothing.
            ; This port computed it here through a BINDER, which put a bindSourceFile
            ; event inside createProgram's; the arm is a function of the text and
            ; the node alone, so it is computed here from those (§3.5le).
            var s AstNode.pos_of(en)
            let e AstNode.end_of(en)
            if s <> e
                s := Scanner.skip_trivia(files.text_at(index), s)
            reason := &IncludeReason^host(FileIncludeKindImport, index, s, e, false, null, package_id)
        }
        node.edges.add(&LoaderEdge^host(slice_copy_on(host, resolved_path), is_external_library_import, is_js_from_node_modules, reason, package_id))
    }

    ; module.GetResolutionDiagnostic over the options
    function resolution_diagnostic(options: EmitOptions, ext: Slice[char], importing_path: Slice[char]) returns int
    {
        if ext.equals(".tsx") or ext.equals(".jsx")
        {
            if options.jsx = JsxEmitNone
                return DiagModule_0_was_resolved_to_1_but_jsx_is_not_set
        }
        if ext.equals(".ts") or ext.equals(".tsx") or ext.equals(".d.ts") or ext.equals(".mts") or ext.equals(".d.mts") or ext.equals(".cts") or ext.equals(".d.cts")
            return 0
        if ext.equals(".js") or ext.equals(".jsx") or ext.equals(".mjs") or ext.equals(".cjs")
        {
            if EmitOptions.on(options.allow_js) or (options.no_implicit_any_explicit() = false)
                return 0
            return DiagCould_not_find_a_declaration_file_for_module_0_1_implicitly_has_an_any_type
        }
        if ext.equals(".json")
        {
            if options.get_resolve_json_module()
                return 0
            return DiagModule_0_was_resolved_to_1_but_resolveJsonModule_is_not_used
        }
        if is_declaration_file_name_of(importing_path) or EmitOptions.on(options.allow_arbitrary_extensions)
            return 0
        DiagModule_0_was_resolved_to_1_but_allowArbitraryExtensions_is_not_set
    }

    ; filesParser.getProcessedFiles' collectFiles
    procedure collect_files(mutable this, mutable edges: ref[Array[ref[LoaderEdge]]], mutable seen: ref[Array[ref[LoaderNode]]])
    {
        var i 0
        while i < (edges.get_length() as int)
        {
            let edge edges[i as size_t]
            i := i + 1
            let node this.node_for(edge.path)
            if node.loaded = false
                continue
            let was_seen node.in_seen
            ; addIncludeReason, but for the automatic type directives' own task. A
            ; redirected file: the task that LOADED it (`redirectedParseTask` set)
            ; contributes its reason through the redirect edge's own collection, and
            ; every other task reaching the path (`loadedTask` set) appends its reason
            ; to the redirect's target as it is collected — whether or not the node
            ; has been walked yet. This port's redirect edge carries the loading
            ; reason, so the loading task is the edge whose reason IS that one; it
            ; used to be "the node was seen already", which coincides only while the
            ; walk and the collection run the same way round (§3.5le).
            if edge.path.ends_with("__inferred type names__.ts") = false
            {
                if node.redirected = false
                    node.reasons.add(edge.reason)
                else
                {
                    if node.edges.get_length() > 0
                    {
                        let redirect_edge node.edges[0]
                        let is_loading_edge (edge.reason as ref[IncludeReason]) = redirect_edge.reason
                        if is_loading_edge = false
                        {
                            let target_node this.node_for(redirect_edge.path)
                            if target_node.loaded
                                target_node.reasons.add(edge.reason)
                        }
                    }
                }
            }
            if was_seen
            {
                if (options.force_consistent_casing <> TristateFalse) and (edge.path.equals(node.collected_path) = false)
                    this.add_casing_diagnostic(node, node.collected_path, edge.path, edge.reason)
                continue
            }
            seen.add(node)
            node.in_seen := true
            ; `seen[data] = task.normalizedFilePath`
            node.collected_path := edge.path
            ; a case-insensitive file system names the file by the casing of the
            ; task that COLLECTS it first — upstream takes `task.file` of the task
            ; `seen[data]` records, and each casing's task parsed the file under its
            ; own name. Named at load time (the WALK's first reach) it agreed only
            ; while the walk and the collection ran the same way round (§3.5le).
            if files.case_insensitive and (node.file_index >= 0)
            {
                if files.path_at(node.file_index).equals(edge.path) = false
                    files.rename_path_once(node.file_index, edge.path)
                node.path := edge.path
            }
            if files.case_insensitive = false
            {
                let key ProgramLoader.lower_ascii(host, node.path)
                var ci 0
                var known_node: ref[LoaderNode]? null
                while ci < (casing_keys.get_length() as int)
                {
                    let known casing_keys[ci as size_t]
                    if known.equals(key)
                    {
                        known_node := casing_nodes[ci as size_t]
                        break
                    }
                    ci := ci + 1
                }
                if known_node <> null
                {
                    let kn known_node as ref[LoaderNode]
                    if options.force_consistent_casing <> TristateFalse
                        this.add_casing_diagnostic(kn, kn.path, node.path, edge.reason)
                }
                else
                {
                    casing_keys.add(key)
                    casing_nodes.add(node)
                }
            }
            ; the task's type resolution traces, then its module resolution traces
            var tt 0
            while tt < (node.type_traces.get_length() as int)
            {
                trace_lines.add(node.type_traces[tt as size_t])
                tt := tt + 1
            }
            var mt 0
            while mt < (node.traces.get_length() as int)
            {
                trace_lines.add(node.traces[mt as size_t])
                mt := mt + 1
            }
            ; package deduplication: a second instance of a package (same PackageId)
            ; redirects to the first one's file and contributes nothing else
            if EmitOptions.on_or_unknown(options.deduplicate_packages) and ((node.package_id.length as int) > 0)
            {
                var first_index 0 - 1
                var pi 0
                while pi < (package_ids.get_length() as int)
                {
                    let known_id package_ids[pi as size_t]
                    if known_id.equals(node.package_id)
                    {
                        first_index := package_files[pi as size_t]
                        break
                    }
                    pi := pi + 1
                }
                if first_index >= 0
                {
                    if node.file_index >= 0
                    {
                        redirect_positions.add((program_files.get_length() + redirect_paths.get_length()) as int)
                        redirect_paths.add(node.path)
                        redirect_targets.add(first_index)
                        files.set_redirect(node.file_index, first_index)
                        if node.lowest_depth > 0
                            from_node_modules_search.put(node.file_index as size_t, true)
                    }
                    continue
                }
                if node.file_index >= 0
                {
                    package_ids.add(node.package_id)
                    package_files.add(node.file_index)
                }
            }
            this.collect_files(node.edges, seen)
            var d 0
            while d < (node.diagnostics.get_length() as int)
            {
                diagnostics.add(node.diagnostics[d as size_t])
                d := d + 1
            }
            if node.file_index < 0
                continue
            program_files.add(node.file_index)
            program_paths.add(node.path)
            if node.lowest_depth > 0
                from_node_modules_search.put(node.file_index as size_t, true)
        }
    }

    function holds(this, index: int) returns bool
        members[index as size_t]

    ; sourceFileMayBeEmitted with forceDtsEmit: not a declaration file, not from
    ; node_modules
    function source_file_may_be_force_emitted(this, index: int) returns bool
    {
        if is_declaration_file_name_of(files.path_at(index))
            return false
        from_node_modules_search[index as size_t] = false
    }

    ; sourceFileMayBeEmitted (forceDtsEmit false, no project references)
    procedure source_file_may_be_emitted(mutable this, index: int) returns bool
    {
        let path files.path_at(index)
        if is_declaration_file_name_of(path)
            return false
        if from_node_modules_search[index as size_t]
            return false
        ; a referenced project's source is that project's to emit
        var r 0
        while r < (reference_sources.get_length() as int)
        {
            let source reference_sources[r as size_t]
            if source.equals(path)
                return false
            r := r + 1
        }
        if path.ends_with(".json") = false
            return true
        if (options.out_dir.length as int) = 0
            return false
        if ((options.root_dir.length as int) > 0) or ((options.config_file_path.length as int) > 0)
        {
            let cwd options.get_current_directory()
            let common get_normalized_absolute_path(host, options.project_root_directory(host), cwd)
            let out_dir get_normalized_absolute_path(host, options.out_dir, cwd)
            let output Emitter.source_file_path_in_new_dir(host, path, out_dir, cwd, common)
            if output.equals(path)
                return false
        }
        true
    }

    ; ── program.go verifyCompilerOptions ─────────────────────────────────────

    ; `removed_false`: the TS7-removed boolean options the program's options set to false
    procedure verify_compiler_options(mutable this, removed_false: ref[Array[Slice[char]]])
    {
        let o options
        let config_path files.config_path
        let config_text files.config_text
        var config_file: ref[AstNode]? null
        if (config_path.length as int) > 0
        {
            let name String^host(config_path.data as pointer[const_char], config_path.length)
            let source String^host(config_text.data as pointer[const_char], config_text.length)
            var unported 0 - 1
            var tag: Slice[char] ""
            var detail 0
            let p Parser.parse_ex(host, name, source, ScriptKindJSON, &unported, &tag, &detail)
            if unported >= 0
            {
                this.stop("tsconfig-json-parse")
                return
            }
            config_file := Parser.source_file_of(p)
        }
        let verifier &OptionVerifier(host, this, config_file, config_text)

        ; removed in TS7 (the harness skips a configuration carrying the others; the
        ; driver stops on those)
        if o.target = 1
            verifier.for_option(false, "target", "", DiagOption_0_1_has_been_removed_Please_remove_it_from_your_configuration, ProgramDiagnostic.args2(host, "target", "ES5"))
        var rf 0
        while rf < (removed_false.get_length() as int)
        {
            let removed_name removed_false[rf as size_t]
            rf := rf + 1
            verifier.for_option(false, removed_name, "", DiagOption_0_1_has_been_removed_Please_remove_it_from_your_configuration, ProgramDiagnostic.args2(host, ProgramDiagnostic.text(removed_name), "false"))
        }
        if o.downlevel_iteration <> TristateUnknown
            verifier.for_option(true, "downlevelIteration", "", DiagOption_0_has_been_removed_Please_remove_it_from_your_configuration, ProgramDiagnostic.args1(host, "downlevelIteration"))

        if (o.strict_property_initialization = TristateTrue) and (o.strict_option_on(o.strict_null_checks) = false)
            verifier.for_option_name("strictPropertyInitialization", "strictNullChecks", DiagOption_0_cannot_be_specified_without_specifying_option_1)
        if (o.exact_optional_property_types = TristateTrue) and (o.strict_option_on(o.strict_null_checks) = false)
            verifier.for_option_name("exactOptionalPropertyTypes", "strictNullChecks", DiagOption_0_cannot_be_specified_without_specifying_option_1)

        let emit_declarations EmitOptions.on(o.declaration) or EmitOptions.on(o.composite)
        if EmitOptions.on(o.isolated_declarations)
        {
            if EmitOptions.on(o.allow_js)
                verifier.for_option_name("allowJs", "isolatedDeclarations", DiagOption_0_cannot_be_specified_with_option_1)
            if emit_declarations = false
                verifier.for_option_name("isolatedDeclarations", "declaration", "composite", DiagOption_0_cannot_be_specified_without_specifying_option_1_or_option_2)
        }
        if EmitOptions.on(o.inline_source_map)
        {
            if EmitOptions.on(o.source_map)
                verifier.for_option_name("sourceMap", "inlineSourceMap", DiagOption_0_cannot_be_specified_with_option_1)
            if (o.map_root.length as int) > 0
                verifier.for_option_name("mapRoot", "inlineSourceMap", DiagOption_0_cannot_be_specified_with_option_1)
        }
        if EmitOptions.on(o.composite)
        {
            if o.declaration = TristateFalse
                verifier.for_option_name("declaration", "", DiagComposite_projects_may_not_disable_declaration_emit)
            if o.incremental = TristateFalse
                verifier.for_option_name("declaration", "", DiagComposite_projects_may_not_disable_incremental_compilation)
        }
        if ((o.ts_build_info_file.length as int) = 0) and EmitOptions.on(o.incremental) and ((o.config_file_path.length as int) = 0)
            verifier.compiler_options_diagnostic(DiagOption_incremental_is_only_valid_with_a_known_configuration_file_like_tsconfig_json_or_when_tsBuildInfoFile_is_explicitly_provided, null)

        if (EmitOptions.on(o.source_map) = false) and (EmitOptions.on(o.inline_source_map) = false)
        {
            if EmitOptions.on(o.inline_sources)
                verifier.for_option_name("inlineSources", "", DiagOption_0_can_only_be_used_when_either_option_inlineSourceMap_or_option_sourceMap_is_provided)
            if (o.source_root.length as int) > 0
                verifier.for_option_name("sourceRoot", "", DiagOption_0_can_only_be_used_when_either_option_inlineSourceMap_or_option_sourceMap_is_provided)
        }
        if ((o.map_root.length as int) > 0) and ((EmitOptions.on(o.source_map) or EmitOptions.on(o.declaration_map)) = false)
            verifier.for_option_name("mapRoot", "sourceMap", "declarationMap", DiagOption_0_cannot_be_specified_without_specifying_option_1_or_option_2)
        if (o.declaration_dir.length as int) > 0
        {
            if emit_declarations = false
                verifier.for_option_name("declarationDir", "declaration", "composite", DiagOption_0_cannot_be_specified_without_specifying_option_1_or_option_2)
        }
        if EmitOptions.on(o.declaration_map) and (emit_declarations = false)
            verifier.for_option_name("declarationMap", "declaration", "composite", DiagOption_0_cannot_be_specified_without_specifying_option_1_or_option_2)
        if ((o.lib.length as int) > 0) and EmitOptions.on(o.no_lib)
            verifier.for_option_name("lib", "noLib", DiagOption_0_cannot_be_specified_with_option_1)
        if EmitOptions.on(o.isolated_modules) or EmitOptions.on(o.verbatim_module_syntax)
        {
            if o.preserve_const_enums = TristateFalse
            {
                if EmitOptions.on(o.verbatim_module_syntax)
                    verifier.for_option_name("verbatimModuleSyntax", "preserveConstEnums", DiagOption_preserveConstEnums_cannot_be_disabled_when_0_is_enabled)
                else
                    verifier.for_option_name("isolatedModules", "preserveConstEnums", DiagOption_preserveConstEnums_cannot_be_disabled_when_0_is_enabled)
            }
        }
        if EmitOptions.on(o.composite) and ((o.config_file_path.length as int) > 0)
            this.verify_composite_file_list(o.get_current_directory())
        this.verify_root_dir_layout(verifier)
        ; the common subdirectory of the input files (rootDir, the config's
        ; directory, else computed) — none across different roots under outDir
        let emit_declarations_on EmitOptions.on(o.declaration) or EmitOptions.on(o.composite)
        if ((o.out_dir.length as int) > 0) or ((o.root_dir.length as int) > 0) or ((o.source_root.length as int) > 0) or ((o.map_root.length as int) > 0) or (emit_declarations_on and ((o.declaration_dir.length as int) > 0))
        {
            this.check_source_files_belong_to_root()
            var common_dir_found true
            if ((o.root_dir.length as int) = 0) and ((o.config_file_path.length as int) = 0)
                common_dir_found := (this.computed_common_source_directory().length as int) > 0
            if ((o.out_dir.length as int) > 0) and (common_dir_found = false)
            {
                var rooted false
                var rk 0
                while rk < (program_paths.get_length() as int)
                {
                    if get_root_length(program_paths[rk as size_t]) > 1
                        rooted := true
                    rk := rk + 1
                }
                if rooted
                    verifier.for_option_name("outDir", "", DiagCannot_find_the_common_subdirectory_path_for_the_input_files)
            }
        }
        if EmitOptions.on(o.check_js) and (EmitOptions.on(o.allow_js) = false)
            verifier.for_option_name("checkJs", "allowJs", DiagOption_0_cannot_be_specified_without_specifying_option_1)
        if EmitOptions.on(o.emit_declaration_only)
        {
            if emit_declarations = false
                verifier.for_option_name("emitDeclarationOnly", "declaration", "composite", DiagOption_0_cannot_be_specified_without_specifying_option_1_or_option_2)
        }
        if EmitOptions.on(o.emit_decorator_metadata) and (EmitOptions.on(o.experimental_decorators) = false)
            verifier.for_option_name("emitDecoratorMetadata", "experimentalDecorators", DiagOption_0_cannot_be_specified_without_specifying_option_1)
        let jsx_automatic (o.jsx = JsxEmitReactJSX) or (o.jsx = JsxEmitReactJSXDev)
        if (o.jsx_factory.length as int) > 0
        {
            if (o.react_namespace.length as int) > 0
                verifier.for_option_name("reactNamespace", "jsxFactory", DiagOption_0_cannot_be_specified_with_option_1)
            if jsx_automatic
                verifier.for_option_name("jsxFactory", OptionVerifier.jsx_emit_name(o.jsx), DiagOption_0_cannot_be_specified_when_option_jsx_is_1)
            if Parser.parse_isolated_entity_name(host, o.jsx_factory) = null
                verifier.for_option(false, "jsxFactory", "", DiagInvalid_value_for_jsxFactory_0_is_not_a_valid_identifier_or_qualified_name, ProgramDiagnostic.args1(host, ProgramDiagnostic.text(o.jsx_factory)))
        }
        else
        {
            if (o.react_namespace.length as int) > 0
            {
                if Checker.is_identifier_text(o.react_namespace) = false
                    verifier.for_option(false, "reactNamespace", "", DiagInvalid_value_for_reactNamespace_0_is_not_a_valid_identifier, ProgramDiagnostic.args1(host, ProgramDiagnostic.text(o.react_namespace)))
            }
        }
        if (o.jsx_fragment_factory.length as int) > 0
        {
            if (o.jsx_factory.length as int) = 0
                verifier.for_option_name("jsxFragmentFactory", "jsxFactory", DiagOption_0_cannot_be_specified_without_specifying_option_1)
            if jsx_automatic
                verifier.for_option_name("jsxFragmentFactory", OptionVerifier.jsx_emit_name(o.jsx), DiagOption_0_cannot_be_specified_when_option_jsx_is_1)
            if Parser.parse_isolated_entity_name(host, o.jsx_fragment_factory) = null
                verifier.for_option(false, "jsxFragmentFactory", "", DiagInvalid_value_for_jsxFragmentFactory_0_is_not_a_valid_identifier_or_qualified_name, ProgramDiagnostic.args1(host, ProgramDiagnostic.text(o.jsx_fragment_factory)))
        }
        if (o.react_namespace.length as int) > 0
        {
            if jsx_automatic
                verifier.for_option_name("reactNamespace", OptionVerifier.jsx_emit_name(o.jsx), DiagOption_0_cannot_be_specified_when_option_jsx_is_1)
        }
        if (o.jsx_import_source.length as int) > 0
        {
            if o.jsx = JsxEmitReact
                verifier.for_option_name("jsxImportSource", OptionVerifier.jsx_emit_name(o.jsx), DiagOption_0_cannot_be_specified_when_option_jsx_is_1)
        }
        let module_kind o.get_emit_module_kind()
        if EmitOptions.on(o.allow_importing_ts_extensions) and ((EmitOptions.on(o.no_emit) or EmitOptions.on(o.emit_declaration_only) or EmitOptions.on(o.rewrite_relative_import_extensions)) = false)
            verifier.for_option(false, "allowImportingTsExtensions", "", DiagOption_allowImportingTsExtensions_can_only_be_used_when_one_of_noEmit_emitDeclarationOnly_or_rewriteRelativeImportExtensions_is_set, null)
        let module_resolution o.get_module_resolution_kind()
        let supports_exports (module_resolution = ModuleResolutionKindNode16) or (module_resolution = ModuleResolutionKindNodeNext) or (module_resolution = ModuleResolutionKindBundler)
        if (o.resolve_package_json_exports = TristateTrue) and (supports_exports = false)
            verifier.for_option_name("resolvePackageJsonExports", "", DiagOption_0_can_only_be_used_when_moduleResolution_is_set_to_node16_nodenext_or_bundler)
        if (o.resolve_package_json_imports = TristateTrue) and (supports_exports = false)
            verifier.for_option_name("resolvePackageJsonImports", "", DiagOption_0_can_only_be_used_when_moduleResolution_is_set_to_node16_nodenext_or_bundler)
        if ((o.custom_conditions.length as int) > 0) and (supports_exports = false)
            verifier.for_option_name("customConditions", "", DiagOption_0_can_only_be_used_when_moduleResolution_is_set_to_node16_nodenext_or_bundler)
        let non_node_esm (module_kind >= ModuleKindES2015) and (module_kind <= ModuleKindESNext)
        if (module_resolution = ModuleResolutionKindBundler) and (non_node_esm = false) and (module_kind <> ModuleKindPreserve) and (module_kind <> ModuleKindCommonJS)
            verifier.for_option(false, "moduleResolution", "", DiagOption_0_can_only_be_used_when_module_is_set_to_preserve_commonjs_or_es2015_or_later, ProgramDiagnostic.args1(host, "bundler"))
        let node_module (module_kind >= ModuleKindNode16) and (module_kind <= ModuleKindNodeNext)
        let node_resolution (module_resolution >= ModuleResolutionKindNode16) and (module_resolution <= ModuleResolutionKindNodeNext)
        if node_module and (node_resolution = false)
            verifier.for_option(false, "moduleResolution", "", DiagOption_moduleResolution_must_be_set_to_0_or_left_unspecified_when_option_module_is_set_to_1, ProgramDiagnostic.args2(host, OptionVerifier.node_resolution_name_for(module_kind), Checker.module_kind_name(module_kind)))
        else
        {
            if node_resolution and (node_module = false)
                verifier.for_option(false, "module", "", DiagOption_module_must_be_set_to_0_when_option_moduleResolution_is_set_to_1, ProgramDiagnostic.args2(host, OptionVerifier.resolution_kind_name(module_resolution), OptionVerifier.resolution_kind_name(module_resolution)))
        }
        if (EmitOptions.on(o.no_emit) = false) and (EmitOptions.on(o.suppress_output_path_check) = false)
            this.verify_emit_file_paths()
    }

    ; the rootDir layout check (TS5011): a config file, an outDir or declarationDir,
    ; no rootDir, and a computed common directory unlike the config's
    ; the composite project's files: every file the program may emit is a root
    ; (TS6307 otherwise)
    procedure verify_composite_file_list(mutable this, cwd: Slice[char])
    {
        let config_path get_normalized_absolute_path(host, options.config_file_path, cwd)
        var k 0
        while k < (program_files.get_length() as int)
        {
            let index program_files[k as size_t]
            let path program_paths[k as size_t]
            k := k + 1
            if this.source_file_may_be_emitted(index) = false
                continue
            var is_root false
            var r 0
            while r < (root_edges.get_length() as int)
            {
                let edge root_edges[r as size_t]
                if edge.path.equals(path)
                    is_root := true
                r := r + 1
            }
            if is_root = false
                this.add_file_explaining_diagnostic(index, DiagFile_0_is_not_listed_within_the_file_list_of_project_1_Projects_must_list_all_files_or_use_an_include_pattern, ProgramDiagnostic.args2(host, ProgramDiagnostic.text(path), ProgramDiagnostic.text(config_path)))
        }
    }

    ; CommonSourceDirectory's checkSourceFilesBelongToPath: under rootDir, or the
    ; config file's directory (TS6059 otherwise)
    procedure check_source_files_belong_to_root(mutable this)
    {
        let cwd options.get_current_directory()
        var root Slice[char]()
        if (options.root_dir.length as int) > 0
            root := options.root_dir
        else
        {
            if (options.config_file_path.length as int) = 0
                return
            root := get_directory_path(host, get_normalized_absolute_path(host, options.config_file_path, cwd))
        }
        var k 0
        while k < (program_files.get_length() as int)
        {
            let index program_files[k as size_t]
            let path program_paths[k as size_t]
            k := k + 1
            if is_declaration_file_name_of(path)
                continue
            if this.source_file_may_be_emitted(index) = false
                continue
            if TsConfigParser.contains_path(host, root, path, cwd) = false
                this.add_file_explaining_diagnostic(index, DiagFile_0_is_not_under_rootDir_1_rootDir_is_expected_to_contain_all_source_files, ProgramDiagnostic.args2(host, ProgramDiagnostic.text(path), ProgramDiagnostic.text(root)))
        }
    }

    procedure verify_root_dir_layout(mutable this, mutable verifier: ref[OptionVerifier])
    {
        let o options
        if EmitOptions.on(o.no_emit) or EmitOptions.on(o.composite)
            return
        if ((o.root_dir.length as int) > 0) or ((o.config_file_path.length as int) = 0)
            return
        let emit_declarations EmitOptions.on(o.declaration) or EmitOptions.on(o.composite)
        if ((o.out_dir.length as int) = 0) and ((emit_declarations and ((o.declaration_dir.length as int) > 0)) = false)
            return
        let cwd o.get_current_directory()
        let dir ensure_trailing_directory_separator(host, get_normalized_absolute_path(host, o.project_root_directory(host), cwd))
        let computed this.computed_common_source_directory()
        if (computed.length as int) = 0
            return
        if dir.equals(computed)
            return
        let config_path get_normalized_absolute_path(host, o.config_file_path, cwd)
        let rel_dir get_relative_path_to_directory_or_url(host, get_directory_path(host, config_path), computed, false, cwd)
        var rel_text StringBuilder()
        if (is_rooted_disk_path(rel_dir) = false) and (rel_dir.starts_with("./") = false) and (rel_dir.starts_with("../") = false)
            rel_text.append("./")
        rel_text.append(rel_dir.data, rel_dir.length)
        let layout_args ProgramDiagnostic.args2(host, ProgramDiagnostic.text(get_base_file_name(host, config_path)), rel_text.to_string())
        if (o.out_dir.length as int) > 0
            verifier.for_option(true, "outDir", "declarationDir", DiagThe_common_source_directory_of_0_is_1_The_rootDir_setting_must_be_explicitly_set_to_this_or_another_path_to_adjust_your_output_s_file_layout, layout_args)
        else
            verifier.for_option(true, "declarationDir", "", DiagThe_common_source_directory_of_0_is_1_The_rootDir_setting_must_be_explicitly_set_to_this_or_another_path_to_adjust_your_output_s_file_layout, layout_args)
        ; diag.AddMessageChain(Visit_https_Colon_Slash_Slashaka_ms_Slashts6_for_migration_information)
        let last_index (diagnostics.get_length() as int) - 1
        if last_index >= 0
        {
            var last diagnostics[last_index as size_t]
            let chain &Array[ChainLine]^host()
            chain.add(ChainLine(1, DiagVisit_https_Colon_Slash_Slashaka_ms_Slashts6_for_migration_information, null, false, null))
            last.chain := chain
            diagnostics.put(last_index as size_t, last)
        }
    }

    ; outputpaths.GetComputedCommonSourceDirectory over the emitted non-declaration
    ; files, with its trailing separator
    procedure computed_common_source_directory(mutable this) returns Slice[char]
    {
        let cwd options.get_current_directory()
        var common: ref[Array[Slice[char]]]? null
        var k 0
        while k < (program_files.get_length() as int)
        {
            let index program_files[k as size_t]
            let path program_paths[k as size_t]
            k := k + 1
            if is_declaration_file_name_of(path)
                continue
            if this.source_file_may_be_emitted(index) = false
                continue
            let all reduce_path_components(host, get_path_components(host, path, cwd))
            let components &Array[Slice[char]]^host()
            var j 0
            while j < ((all.get_length() as int) - 1)
            {
                components.add(all[j as size_t])
                j := j + 1
            }
            if common = null
                common := components
            else
            {
                let cc common as ref[Array[Slice[char]]]
                var limit cc.get_length() as int
                if (components.get_length() as int) < limit
                    limit := components.get_length() as int
                let kept &Array[Slice[char]]^host()
                var m 0
                while m < limit
                {
                    let a cc[m as size_t]
                    let bcomp components[m as size_t]
                    var same a.equals(bcomp)
                    if (same = false) and options.case_insensitive_file_names
                    {
                        let la ProgramLoader.lower_ascii(host, a)
                        let lb ProgramLoader.lower_ascii(host, bcomp)
                        same := la.equals(lb)
                    }
                    if same = false
                        break
                    kept.add(a)
                    m := m + 1
                }
                if kept.get_length() = 0
                    return Slice[char]()
                common := kept
            }
        }
        if common = null
            return Slice[char]()
        ensure_trailing_directory_separator(host, get_path_from_path_components(host, common as ref[Array[Slice[char]]]))
    }

    ; the emit files: unique, and none over an input file (TS5055, TS5056)
    procedure verify_emit_file_paths(mutable this)
    {
        let o options
        let seen &Array[Slice[char]]^host()
        let cwd o.get_current_directory()
        let emitter Emitter.create(host)
        var k 0
        while k < (program_files.get_length() as int)
        {
            let index program_files[k as size_t]
            let path program_paths[k as size_t]
            k := k + 1
            if this.source_file_may_be_emitted(index) = false
                continue
            let file files.file_at(index) as ref[AstNode]
            let info &SourceFileInfo^host(file, path, files.text_at(index), &Array[int]^host(), false, Parser.supported_script_kind(String^host(path.data as pointer[const_char], path.length)), false, null, false)
            let is_json path.ends_with(".json")
            if EmitOptions.on(o.emit_declaration_only) = false
            {
                let js emitter.js_output_path(info, o, cwd, (checker as ref[Checker]))
                if (is_json and js.equals(path)) = false
                {
                    this.verify_emit_file_path(js, seen)
                    if (is_json = false) and EmitOptions.on(o.source_map) and (EmitOptions.on(o.inline_source_map) = false)
                        this.verify_emit_file_path(join_slices(host, js, ".map"), seen)
                }
            }
            if (EmitOptions.on(o.declaration) or EmitOptions.on(o.composite)) and (is_json = false)
            {
                let dts emitter.dts_output_path(info, o, cwd, (checker as ref[Checker]))
                this.verify_emit_file_path(dts, seen)
                if EmitOptions.on(o.declaration_map)
                    this.verify_emit_file_path(join_slices(host, dts, ".map"), seen)
            }
        }
    }

    procedure verify_emit_file_path(mutable this, emit_file_name: Slice[char], mutable seen: ref[Array[Slice[char]]])
    {
        if (emit_file_name.length as int) = 0
            return
        let index files.index_of_exact_path(emit_file_name)
        if index >= 0
        {
            if members[index as size_t]
            {
                diagnostics.add(ProgramDiagnostic(ProgramDiagnosticGlobal, 0, 0, DiagCannot_write_file_0_because_it_would_overwrite_input_file, ProgramDiagnostic.args1(host, ProgramDiagnostic.text(emit_file_name)), null, null, 0 - 1))
                blocked_paths.add(emit_file_name)
            }
        }
        var i 0
        while i < (seen.get_length() as int)
        {
            let seen_name seen[i as size_t]
            if seen_name.equals(emit_file_name)
            {
                diagnostics.add(ProgramDiagnostic(ProgramDiagnosticGlobal, 0, 0, DiagCannot_write_file_0_because_it_would_be_overwritten_by_multiple_input_files, ProgramDiagnostic.args1(host, ProgramDiagnostic.text(emit_file_name)), null, null, 0 - 1))
                blocked_paths.add(emit_file_name)
                return
            }
            i := i + 1
        }
        seen.add(emit_file_name)
    }
}

; verifyCompilerOptions' closures over the config file's syntax
define OptionVerifier
(
    host: ref[Page]
    loader: ref[ProgramLoader]
    config_file: ref[AstNode]?
    config_text: Slice[char]
)
{
    ; getTsConfigObjectLiteralExpression
    function root_object(this) returns ref[AstNode]?
    {
        if config_file = null
            return null
        let statements AstNode.statements_of(config_file)
        if AstNode.list_count(statements) = 0
            return null
        let first AstNode.child_in_list(statements, 0)
        let expression AstNode.expression_of(first)
        if AstNode.kind_of(expression) <> KindObjectLiteralExpression
            return null
        expression
    }

    ; ForEachPropertyAssignment's first match of key1 or key2
    function property_named(this, object_literal: ref[AstNode]?, key1: Slice[char], key2: Slice[char]) returns ref[AstNode]?
    {
        if object_literal = null
            return null
        let properties AstNode.properties_of(object_literal)
        var i 0
        while i < AstNode.list_count(properties)
        {
            let property AstNode.child_in_list(properties, i)
            i := i + 1
            if AstNode.kind_of(property) <> KindPropertyAssignment
                continue
            let name AstNode.name_of(property)
            let k AstNode.kind_of(name)
            if (k <> KindStringLiteral) and (k <> KindIdentifier) and (k <> KindNoSubstitutionTemplateLiteral)
                continue
            var text AstNode.literal_text_of(name)
            if k = KindIdentifier
                text := AstNode.identifier_text_of(name)
            if text.equals(key1)
                return property
            if ((key2.length as int) > 0) and text.equals(key2)
                return property
        }
        null
    }

    ; CreateDiagnosticForNodeInSourceFile over the config's text
    procedure add_at_node(mutable this, node: ref[AstNode]?, code: int, args: ref[Array[String]]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let start Scanner.skip_trivia(config_text, AstNode.pos_of(n))
        loader.diagnostics.add(ProgramDiagnostic(ProgramDiagnosticConfig, start, AstNode.end_of(n), code, args, null, null, 0 - 1))
    }

    ; createCompilerOptionsDiagnostic
    procedure compiler_options_diagnostic(mutable this, code: int, args: ref[Array[String]]?)
    {
        let compiler_options this.property_named(this.root_object(), "compilerOptions", "")
        if compiler_options <> null
            this.add_at_node(AstNode.name_of(compiler_options), code, args)
        else
            loader.diagnostics.add(ProgramDiagnostic(ProgramDiagnosticGlobal, 0, 0, code, args, null, null, 0 - 1))
    }

    ; createDiagnosticForOption: the option's key (or value) inside compilerOptions,
    ; else the compilerOptions key, else a compiler diagnostic
    procedure for_option(mutable this, on_key: bool, option1: Slice[char], option2: Slice[char], code: int, args: ref[Array[String]]?)
    {
        let compiler_options this.property_named(this.root_object(), "compilerOptions", "")
        if compiler_options <> null
        {
            let initializer AstNode.initializer_of(compiler_options)
            if AstNode.kind_of(initializer) = KindObjectLiteralExpression
            {
                let property this.property_named(initializer, option1, option2)
                if property <> null
                {
                    if on_key
                        this.add_at_node(AstNode.name_of(property), code, args)
                    else
                        this.add_at_node(AstNode.initializer_of(property), code, args)
                    return
                }
            }
        }
        this.compiler_options_diagnostic(code, args)
    }

    ; createDiagnosticForOptionName: the option names lead the arguments
    procedure for_option_name(mutable this, option1: Slice[char], option2: Slice[char], code: int)
    {
        let args ProgramDiagnostic.args2(host, ProgramDiagnostic.text(option1), ProgramDiagnostic.text(option2))
        this.for_option(true, option1, option2, code, args)
    }

    procedure for_option_name(mutable this, option1: Slice[char], option2: Slice[char], extra: Slice[char], code: int)
    {
        let args ProgramDiagnostic.args3(host, ProgramDiagnostic.text(option1), ProgramDiagnostic.text(option2), ProgramDiagnostic.text(extra))
        this.for_option(true, option1, option2, code, args)
    }

    ; JsxEmit.String
    function jsx_emit_name(jsx: int) returns Slice[char]
    {
        if jsx = JsxEmitPreserve
            return "preserve"
        if jsx = JsxEmitReactNative
            return "react-native"
        if jsx = JsxEmitReact
            return "react"
        if jsx = JsxEmitReactJSX
            return "react-jsx"
        if jsx = JsxEmitReactJSXDev
            return "react-jsxdev"
        ""
    }

    ; ModuleResolutionKind.String over the node kinds this check names
    function resolution_kind_name(kind: int) returns String
    {
        if kind = ModuleResolutionKindNodeNext
            return String("NodeNext")
        if kind = ModuleResolutionKindBundler
            return String("Bundler")
        String("Node16")
    }

    ; core.ModuleKindToModuleResolutionKind, else Node16
    function node_resolution_name_for(module_kind: int) returns String
    {
        if module_kind = ModuleKindNodeNext
            return String("NodeNext")
        String("Node16")
    }
}
