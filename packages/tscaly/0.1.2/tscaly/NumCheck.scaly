; SPDX-License-Identifier: Apache-2.0
;
; NumCheck — the SECOND PRODUCER for jsnum, and it exists because the corpus
; cannot reach it.
;
; The four yardsticks see a numeric literal's value in exactly one place: a
; literal used as a DECLARATION NAME, which is 27 units of 17 797. Everything
; else jsnum decides — a denormal's shortest digits, the fixed/exponential
; boundary at 1e-6 and 1e21, the round-to-even tie, `Infinity`, `NaN`, a radix
; literal past int64, the leading-zero and separator forms — is invisible to
; them, and a port whose unexercised arms are wrong is indistinguishable from a
; port whose unexercised arms are right (§3.5v's fourth row). So it gets an
; instrument of its own: tests/numcheck.sh feeds the same generated corpus to
; this and to the reference's own jsnum and diffs.
;
; One line of the corpus is one INPUT STRING, verbatim — which is why the corpus
; carries no `\n` and needs no escaping for anything else, tabs and multi-byte
; whitespace included. One line of output is
;
;     <the 16 hex digits of FromString(line)'s bits> <FromString(line).String()>
;
; The BITS and not a rendering of the double, because the rendering is the other
; half of what is being measured and two wrongs there would cancel; and the bits
; carry the NaN payload, the sign of negative zero and the exact denormal, none
; of which the text does.
;
; It lives in the PACKAGE rather than in the program root for the reason
; PathCheck and the symbol dump do: the accumulator is a container, and a generic
; instance handed to a program root reads back as garbage.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.Console

define NumCheck
{
    procedure run(host: ref[Page], text: String)
    {
        ; StringBuilder^host() and not allocate-then-assign — its init allocates
        ; through Page.get(this); see SymbolDump.write for the whole account.
        let out StringBuilder^host()

        let d text.get_buffer() as pointer[char]
        var n text.get_length() as int

        ; The final newline terminates the last case rather than starting an
        ; empty one — and the EMPTY string is a case here (FromString("") is 0),
        ; so a plain "skip empty lines" would drop it.
        if n > 0
        {
            if (*(d + (n - 1)) as int) = (("\n" as char) as int)
                n := n - 1
        }

        var i 0
        while i <= n
        {
            var e i
            while e < n
            {
                if (*(d + e) as int) = (("\n" as char) as int)
                    break
                e := e + 1
            }

            let bits jsnum_from_string(Slice[char](e - i, d + i))

            var k 60
            while k >= 0
            {
                let nib ((bits >> (k as u64)) & (0xF as u64)) as int
                if nib < 10
                    out.append((nib + (("0" as char) as int)) as char)
                else
                    out.append(((nib - 10) + (("A" as char) as int)) as char)
                k := k - 4
            }
            out.append(" " as char)

            var buf char[JSNUM_MAX_TEXT]
            let tl jsnum_to_string(bits, Slice[char](JSNUM_MAX_TEXT as size_t, &buf[0]))
            var j 0
            while j < tl
            {
                out.append(buf[j])
                j := j + 1
            }
            out.append("\n" as char)

            i := e + 1
        }

        let s out.to_string()
        Console.print(s.to_c_string())
    }
}
