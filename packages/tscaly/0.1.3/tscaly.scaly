; SPDX-License-Identifier: Apache-2.0
;
; tscaly — a Scaly port of the TypeScript compiler.
;
; Ported from microsoft/typescript-go, pinned at commit 2bd066d8 (tag
; typescript/v7.0.2). See ../README.md for provenance. The license boundary:
; nothing moves from here into Scaly's compiler, runtime or standard library,
; which are MIT.
;
; Memory doctrine, decided at kickoff and to be proven by this port: a compiler
; run is a region hierarchy. The cycles the reference carries — Node.Parent and
; Type.checker pointing back at their owner — cost nothing here, where a cycle
; inside one region is freed with the region. The reference's own memo caches
; already hang off the Checker rather than off globals, so N checkers are N
; regions.
;
; Dispatch doctrine: no dynamic dispatch in the core. The reference's tag-struct
; + interface-payload shape (nodeData, TypeData) becomes a sum type plus pattern
; matching, because a trait object makes the callee unknown at compile time and
; every purity, escape and parallelism question stops there.

package scaly 0.1.0
package tsbase 0.1.0

define tscaly
{
    ; The BINDER: symbols, symbol tables and the bind diagnostics. Declared after
    ; the parser because it reads nothing the parser does not already declare and
    ; because it calls into it for one question (is this file an external module).
    ; Slice 27 ports the skeleton and the variable/function/parameter arms, slice 28
    ; the MODULE SYMBOL (an external module's own symbol, the JSON arm's second one,
    ; and the two symbols an exported declaration owns), slice 29 the import/export
    ; ALIAS family (the four kinds that share one arm, the import clause, the export
    ; declaration, the export assignment and the UMD global); everything else in
    ; either switch reports itself as unported.
    module binder

    ; the program's file table and the module resolver over it (slice 248); after
    ; the binder because it holds binders and parsers, before the checker that asks it
    module program

    ; a JSON value tree as text, and the test system's readable build info
    module buildinfojson

    ; the compiler option declarations the tsconfig conversion reads (slice 261).
    ; GENERATED — edit tools/gentsoptions.py, not the file
    ; internal/tracing (slice 289): the `--generateTrace` session and its two
    ; text artifacts. Declared here — after the JSON writer it uses and BEFORE
    ; `checker`, which pushes its own check events — and holding no filesystem
    ; for exactly that reason; see its header.
    module tracing

    module SymbolDump

    ; The CHECKER: the semantic diagnostics of a file and the type of a node.
    ; Declared after the binder because it asks it two questions (is this file a
    ; module, and what is a module declaration's instance state) and because it
    ; reads nothing the binder does not already declare. Slice 47 ports the
    ; SKELETON — the type representation, the intrinsic types, the printer's
    ; keyword arms, the file-level check and getTypeOfNode's chain — with a REPORT
    ; at every arm that is not ported, which is what makes the unported column the
    ; work list for the slices after it.
    module checker

    ; internal/modulespecifiers (slice 253): after the checker, whose ModuleKind
    ; constants it reads, before the emitter whose node builder asks it
    module modulespecifiers

    module printer

    module factory

    ; The EMITTER: the JS half of compiler/emitter.go and the transformers it runs
    ; (slice 236). After factory, whose visitor it drives.
    module emitter

    module diagnosticwriter

    ; OUR half of the checker yardstick's dump — not a port of anything; the format
    ; is ours and tests/oracle/types.go is its other producer. In the package
    ; rather than in the dumper program for SymbolDump's reason, and after `checker`
    ; because it reads its types.
    module TypeDump

    ; The LITERAL TYPE NAME's own instrument (slice 71), and it is here for the
    ; reason NumCheck and PathCheck are: the yardstick cannot reach the code. A
    ; literal type's name is composed by type_to_string, and a T line is only
    ; written for a node the kind INVENTORY admits — three token and statement
    ; kinds, no expression — so not one of the four names slice 71 composes can
    ; appear in a dump. Declared after `checker` because it calls its escape
    ; worker directly.
    module LitCheck
}
