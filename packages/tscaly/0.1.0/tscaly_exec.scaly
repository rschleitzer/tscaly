; SPDX-License-Identifier: Apache-2.0
;
; tscaly_exec — the driver yardstick's program (phase (b)2): replays the scenarios
; tests/casedriver.py reads out of the reference's tsc/tsbuild baselines against the
; port's execute.CommandLine, and prints the FACTS each step leaves behind — the
; file tree before and after the command, the exit status, the writer's text —
; which casedriver renders through the harness's own rules and compares.
;
; ★ This file is the port of tsctests' TestSys setup and runner loop (runner.go,
; sys.go): the initial tree is created in path order with one clock tick per file,
; then the default libraries (ensureLibPathExists) with the harness's tiny lib text;
; an edit writes through the map file system (no written-file record, no lib read);
; the written-file record is cleared after each baseline.
;
; Input, `--batch <scenarios file>`:
;
;     ==== TSCALY-SCENARIO <key>
;     cwd <path> | case <0|1> | root <windows root> | env <name>\t<value>
;     deflib <bytes>\n<text>\n
;     step <i>
;       write <bytes> <path>\n<text>\n | delete <path> | touch <path> | link <path>\t<target>
;       run <args, separated by U+001F> | cycle
;     ==== TSCALY-END
;
; Output per step: `==== TSCALY-STEP <i>`, `==== PRE` (the tree), then either
; `==== UNPORTED <tag>` or `==== EXIT <status>`, `==== OUTPUT <bytes>`, `==== POST`.
; A tree is `F <mtime> <written> <bytes> <path>\n<text>`, `S <path>\t<target>` and
; `L <mtime> <path>` for a default lib not yet read (its text is the deflib text).

package scaly 0.1.0
package tscaly 0.1.0

use scaly.memory.Page
use scaly.io.File
use scaly.io.Console
use scaly.fiber.Io
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.system.ExecSystem
use tscaly.system.VfsFile
use tscaly.execute.Execute
use tscaly.watcher.Watcher
use tscaly.watcher.WatchManager
use tscaly.build.Orchestrator
use tscaly.xxh3.Xxh3
use tscaly.inflate.Inflate
use tscaly.TsOptionDecls.TsOptionDecls

; --bench-batch: the same replay without the file trees, the fsDiffer snapshots and
; the incremental shadow build — what a measurement of the compiler wants and the
; driver yardstick does not (on VS Code the two trees alone are ~1 GB of copies)
mutable bench_mode: bool false

procedure emit(text: String)
    Io.write_all(1, text.get_buffer() as pointer[void], text.get_length())

function exit_status_name(status: int) returns Slice[char]
{
    if status = 0
        return "Success"
    if status = 1
        return "DiagnosticsPresent_OutputsSkipped"
    if status = 2
        return "DiagnosticsPresent_OutputsGenerated"
    if status = 3
        return "InvalidProject_OutputsSkipped"
    if status = 4
        return "ProjectReferenceCycle_OutputsSkipped"
    "NotImplemented"
}

; the tree as the harness's snapshot sees it
procedure print_tree(sys: ref[ExecSystem], deflib: Slice[char])
{
    var sb StringBuilder()
    var i 0
    while i < (sys.files.get_length() as int)
    {
        let f_opt sys.files[i as size_t]
        set i: i + 1
        if f_opt = null
            continue
        let f f_opt as ref[VfsFile]
        if f.is_link
        {
            sb.append("S ")
            sb.append(f.path.data, f.path.length)
            sb.append("\t" as char)
            sb.append(f.link_target.data, f.link_target.length)
            sb.append("\n")
            continue
        }
        if ExecSystem.contains(sys.default_libs, f.path)
        {
            sb.append("L ")
            sb.append(f.mtime)
            sb.append(" " as char)
            sb.append(f.path.data, f.path.length)
            sb.append("\n")
            continue
        }
        sb.append("F ")
        sb.append(f.mtime)
        if ExecSystem.contains(sys.written, f.path)
            sb.append(" 1 ")
        else
            sb.append(" 0 ")
        sb.append(f.text.length as int)
        sb.append(" " as char)
        sb.append(f.path.data, f.path.length)
        sb.append("\n")
        sb.append(f.text.data, f.text.length)
        sb.append("\n")
    }
    emit(sb.to_string())
}

; ensureLibPathExists for lib.d.ts and every default lib file
procedure ensure_default_libs(sys: ref[ExecSystem], deflib: Slice[char])
{
    let h sys.host
    let names &Array[Slice[char]]^h()
    names.add("lib.d.ts")
    var i 0
    repeat
    {
        let name TsOptionDecls.default_lib_file_at(i)
        if (name.length as int) = 0
            break
        names.add(name)
        set i: i + 1
    }
    var k 0
    while k < (names.get_length() as int)
    {
        let name names[k as size_t]
        set k: k + 1
        var sb StringBuilder()
        sb.append(sys.default_library_path.data, sys.default_library_path.length)
        sb.append("/" as char)
        sb.append(name.data, name.length)
        let path_s sb.to_string()
        let path Slice[char](path_s.get_length(), path_s.get_buffer() as pointer[char])
        if sys.find_index(path) < 0
        {
            sys.put_file(path, deflib)
            sys.default_libs.add(ExecSystem.copy(sys.host, path))
        }
    }
}

; one number at `pos`, the index past it through the out-cell
function read_number(text: String, pos: int, out_end: ref[int]) returns int
{
    var p pos
    var n 0
    while (p < (text.get_length() as int)) and ((text.get(p as size_t) as int) >= 48) and ((text.get(p as size_t) as int) <= 57)
    {
        set n: n * 10 + ((text.get(p as size_t) as int) - 48)
        set p: p + 1
    }
    set out_end: p
    n
}

; a byte of a view as an int (a method-free read: `[]` on a view the caller built is
; the generic-operator trap of the root CLAUDE.md)
function byte_at(s: Slice[char], i: int) returns int
    *(s.data + i) as int

function slice_of(text: String, start: int, length: int) returns Slice[char]
    Slice[char](length as size_t, (text.get_buffer() as pointer[char]) + start)

function line_starts_with(text: String, pos: int, prefix: Slice[char]) returns bool
{
    if (pos + (prefix.length as int)) > (text.get_length() as int)
        return false
    var i 0
    while i < (prefix.length as int)
    {
        if (text.get((pos + i) as size_t) as int) <> byte_at(prefix, i)
            return false
        set i: i + 1
    }
    true
}

; the args of a `run` line, split at U+001F
procedure split_args(host: ref[Page], line: Slice[char]) returns ref[Array[Slice[char]]]
{
    let out &Array[Slice[char]]^host()
    var start 0
    var i 0
    while i <= (line.length as int)
    {
        var at_end i = (line.length as int)
        var sep false
        if at_end = false
            set sep: byte_at(line, i) = 31
        if at_end or sep
        {
            out.add(ExecSystem.copy(host, line.subslice(start as size_t, i as size_t)))
            set start: i + 1
        }
        set i: i + 1
    }
    out
}

; tsctests' newTestSys: the default library path under a windowsStyleRoot
procedure root_library_path(host: ref[Page], root: Slice[char]) returns Slice[char]
{
    var sb StringBuilder()
    sb.append(root.data, root.length)
    sb.append("home/src/tslibs/TS/Lib")
    let text sb.to_string()
    ExecSystem.copy(host, Slice[char](text.get_length(), text.get_buffer() as pointer[char]))
}

; one edit line at `pos` (its end at `eol`) applied to the file system; the position
; after it (past a write's content)
procedure apply_edit(sys: ref[ExecSystem], text: String, pos: int, eol: int, line: Slice[char]) returns int
{
    var next eol + 1
    if line.starts_with("write ")
    {
        var num_end 0
        let n read_number(text, pos + 6, &num_end)
        let path slice_of(text, num_end + 1, eol - num_end - 1)
        let content slice_of(text, eol + 1, n)
        sys.put_file(path, content)
        set next: eol + 1 + n + 1
    }
    ; `file <path>`: a file on disk under its own path, `file-as <path>\t<disk path>`:
    ; under another one (a default library) — the text is read when first asked for
    if line.starts_with("file ")
        sys.put_file_on_disk(line.slice_from(5), line.slice_from(5))
    if line.starts_with("file-as ")
    {
        var ftab 8
        while (ftab < (line.length as int)) and (byte_at(line, ftab) <> 9)
            set ftab: ftab + 1
        if ftab < (line.length as int)
            sys.put_file_on_disk(line.subslice(8, ftab as size_t), line.slice_from((ftab + 1) as size_t))
    }
    if line.starts_with("delete ")
        sys.remove_file(line.slice_from(7))
    if line.starts_with("touch ")
        sys.touch(line.slice_from(6))
    if line.starts_with("link ")
    {
        var tab 5
        while (tab < (line.length as int)) and (byte_at(line, tab) <> 9)
            set tab: tab + 1
        if tab < (line.length as int)
            sys.put_link(line.subslice(5, tab as size_t), line.slice_from((tab + 1) as size_t))
    }
    next
}

; the harness's incremental-correctness build (getDiffForIncremental): a fresh
; system with the scenario's files and every edit up to `step`, the command run once;
; answers the files it wrote and its output (`==== SHADOW-FILE`, `==== SHADOW-OUTPUT`)
; or the stop (`==== SHADOW-UNPORTED`)
procedure run_shadow(text: String, step_starts: ref[Array[int]], step: int, end: int, cwd: Slice[char], case_sensitive: bool, env_names: ref[Array[Slice[char]]], env_values: ref[Array[Slice[char]]], deflib: Slice[char], args_line: Slice[char], windows_root: Slice[char])
{
    let anchor String("shadow")
    let host Page.get(anchor.get_buffer())
    let s ExecSystem.create(host, cwd, case_sensitive)
    if (windows_root.length as int) > 0
        set s.default_library_path: root_library_path(host, windows_root)
    set s.env_names: env_names
    set s.env_values: env_values
    var k 0
    while k <= step
    {
        var pos step_starts[k as size_t]
        ; past the `step` line
        set pos: (text.index_of(10 as u8, pos as size_t) as int) + 1
        repeat
        {
            if pos >= end
                break
            let eol text.index_of(10 as u8, pos as size_t) as int
            if eol < 0
                break
            let line slice_of(text, pos, eol - pos)
            if line.starts_with("run ") or line.equals("cycle") or line.starts_with("unsupported ") or line.starts_with("step ")
                break
            set pos: apply_edit(s, text, pos, eol, line)
        }
        if k = 0
            ensure_default_libs(s, deflib)
        set k: k + 1
    }
    set s.written: &Array[Slice[char]]^host()
    Execute.command_line(s, split_args(host, args_line))
    if (s.stop_tag.length as int) > 0
    {
        var sb StringBuilder()
        sb.append("==== SHADOW-UNPORTED ")
        sb.append(s.stop_tag.data, s.stop_tag.length)
        sb.append("\n")
        emit(sb.to_string())
        return
    }
    var w 0
    while w < (s.written.get_length() as int)
    {
        let path s.written[w as size_t]
        set w: w + 1
        let i s.find_index(path)
        if i < 0
            continue
        let f s.files[i as size_t] as ref[VfsFile]
        var sb StringBuilder()
        sb.append("==== SHADOW-FILE ")
        sb.append(f.text.length as int)
        sb.append(" " as char)
        sb.append(path.data, path.length)
        sb.append("\n")
        sb.append(f.text.data, f.text.length)
        sb.append("\n")
        emit(sb.to_string())
    }
    let out s.output.to_string()
    var ob StringBuilder()
    ob.append("==== SHADOW-OUTPUT ")
    ob.append(out.get_length() as int)
    ob.append("\n")
    ob.append(out)
    ob.append("\n")
    emit(ob.to_string())
}

; runs one scenario, text[start, end); answers on stdout
procedure run_scenario(text: String, start: int, end: int, key: Slice[char])
{
    var sb_head StringBuilder()
    sb_head.append("==== TSCALY-SCENARIO ")
    sb_head.append(key.data, key.length)
    sb_head.append("\n")
    emit(sb_head.to_string())
    let anchor String("scenario")
    let host Page.get(anchor.get_buffer())
    var cwd: Slice[char] "/home/src/workspaces/project"
    var case_sensitive true
    var deflib Slice[char]()
    var sys: ref[ExecSystem]? null
    var step 0 - 1
    var stopped false
    ; a windowsStyleRoot scenario: the default library path under that root
    var windows_root Slice[char]()
    let env_names &Array[Slice[char]]^host()
    let env_values &Array[Slice[char]]^host()
    ; each step's `step` line, and the command of step 0 (a cycle's)
    let step_starts &Array[int]^host()
    var first_args Slice[char]()
    var pos start
    while (pos < end) and (stopped = false)
    {
        let eol text.index_of(10 as u8, pos as size_t) as int
        if eol < 0
            break
        let line slice_of(text, pos, eol - pos)
        var next eol + 1
        if line.starts_with("root ")
            set windows_root: ExecSystem.copy(host, line.slice_from(5))
        if line.starts_with("cwd ")
            set cwd: ExecSystem.copy(host, line.slice_from(4))
        if line.starts_with("case ")
            set case_sensitive: byte_at(line, 5) = 49
        if line.starts_with("env ")
        {
            var tab 4
            while (tab < (line.length as int)) and (byte_at(line, tab) <> 9)
                set tab: tab + 1
            env_names.add(ExecSystem.copy(host, line.subslice(4, tab as size_t)))
            if tab < (line.length as int)
                env_values.add(ExecSystem.copy(host, line.slice_from((tab + 1) as size_t)))
            else
                env_values.add("")
        }
        if line.starts_with("deflib ")
        {
            var num_end 0
            let n read_number(text, pos + 7, &num_end)
            set deflib: ExecSystem.copy(host, slice_of(text, eol + 1, n))
            set next: eol + 1 + n + 1
        }
        if line.starts_with("step ")
        {
            if sys = null
            {
                let made ExecSystem.create(host, cwd, case_sensitive)
                if (windows_root.length as int) > 0
                    set made.default_library_path: root_library_path(host, windows_root)
                set made.env_names: env_names
                set made.env_values: env_values
                set sys: made
            }
            var num_end 0
            set step: read_number(text, pos + 5, &num_end)
        }
        if line.starts_with("step ")
            step_starts.add(pos)
        if sys <> null
            set next: apply_edit(sys as ref[ExecSystem], text, pos, eol, line)
        var is_run line.starts_with("run ")
        if is_run and (step = 0)
            set first_args: line.slice_from(4)
        var is_cycle line.equals("cycle")
        var is_unsupported line.starts_with("unsupported ")
        if is_run or is_cycle or is_unsupported
        {
            let s sys as ref[ExecSystem]
            if step = 0
                ensure_default_libs(s, deflib)
            let step_line String("==== TSCALY-STEP `step`\n==== PRE\n")
            emit(step_line)
            if bench_mode = false
            {
                print_tree(s, deflib)
                s.take_snapshot()
            }
            set s.written: &Array[Slice[char]]^host()
            var status 0
            if is_unsupported
                s.stop("scenario-edit-unsupported")
            if is_cycle
            {
                ; SendChangedPaths, then DoCycle
                let deleted &Array[bool]^host()
                let changes s.changed_paths(deleted)
                if s.watcher <> null
                {
                    let w s.watcher as ref[Watcher]
                    w.wm.send_changed_paths(changes, deleted)
                    w.do_cycle()
                }
                else
                {
                    if s.build_watcher <> null
                    {
                        let o s.build_watcher as ref[Orchestrator]
                        o.wm.send_changed_paths(changes, deleted)
                        o.do_cycle()
                    }
                    else
                        s.stop("watch-cycle")
                }
            }
            if is_run
                set status: Execute.command_line(s, split_args(host, line.slice_from(4)))
            if (s.stop_tag.length as int) > 0
            {
                var sb StringBuilder()
                sb.append("==== UNPORTED ")
                sb.append(s.stop_tag.data, s.stop_tag.length)
                sb.append("\n")
                emit(sb.to_string())
                set stopped: true
            }
            else
            {
                var sb StringBuilder()
                if is_run
                {
                    sb.append("==== EXIT ")
                    let name exit_status_name(status)
                    sb.append(name.data, name.length)
                    sb.append("\n")
                }
                let out s.output.to_string()
                sb.append("==== OUTPUT ")
                sb.append(out.get_length() as int)
                sb.append("\n")
                sb.append(out)
                sb.append("\n==== POST\n")
                emit(sb.to_string())
                if bench_mode = false
                {
                    print_tree(s, deflib)
                    s.take_post_snapshot()
                }
                var wm_opt: ref[WatchManager]? null
                if s.watcher <> null
                    set wm_opt: (s.watcher as ref[Watcher]).wm
                if s.build_watcher <> null
                    set wm_opt: (s.build_watcher as ref[Orchestrator]).wm
                if wm_opt <> null
                {
                    let wmr wm_opt as ref[WatchManager]
                    if wmr.registered
                    {
                        var ws StringBuilder()
                        wmr.watch_state(&ws)
                        let state ws.to_string()
                        var wb StringBuilder()
                        wb.append("==== WATCH ")
                        wb.append(state.get_length() as int)
                        wb.append("\n")
                        wb.append(state)
                        wb.append("\n")
                        emit(wb.to_string())
                    }
                }
                if s.programs.get_length() > 0
                {
                    let programs s.programs.to_string()
                    var pb StringBuilder()
                    pb.append("==== PROGRAMS ")
                    pb.append(programs.get_length() as int)
                    pb.append("\n")
                    pb.append(programs)
                    pb.append("\n")
                    emit(pb.to_string())
                }
                if (step > 0) and (bench_mode = false)
                {
                    var args first_args
                    if is_run
                        set args: line.slice_from(4)
                    run_shadow(text, step_starts, step, end, cwd, case_sensitive, env_names, env_values, deflib, args, windows_root)
                }
                set s.written: &Array[Slice[char]]^host()
                s.reset_trace_cache()
                set s.output: &StringBuilder^host()
                set s.programs: &StringBuilder^host()
            }
        }
        set pos: next
    }
    emit(String("==== TSCALY-END\n"))
    ; --bench-batch ends the process after its last scenario, before the
    ; scenario's region is given back page by page: a compiler exits without
    ; freeing (the reference's process does), and the output is already written
    if bench_mode and ((end + 16) >= (text.get_length() as int))
        exit(0)
}

procedure run_batch(path: String) returns int
{
    if File.exists(path) = false
    {
        let m String("cannot read `path`")
        Console.println(m.to_c_string())
        return 1
    }
    let text File.read_to_string(path)
    let n text.get_length() as int
    let marker: Slice[char] "==== TSCALY-SCENARIO "
    let end_marker: Slice[char] "==== TSCALY-END\n"
    var pos 0
    while pos < n
    {
        if line_starts_with(text, pos, marker) = false
            return 3
        let eol text.index_of(10 as u8, pos as size_t) as int
        let key_start pos + (marker.length as int)
        let key slice_of(text, key_start, eol - key_start)
        ; the scenario's body runs to its end marker at a line start
        var scan eol + 1
        var body_end 0 - 1
        while (scan < n) and (body_end < 0)
        {
            if line_starts_with(text, scan, end_marker)
                set body_end: scan
            else
            {
                if line_starts_with(text, scan, "write ") or line_starts_with(text, scan, "deflib ")
                {
                    var num_end 0
                    var skip 6
                    if line_starts_with(text, scan, "deflib ")
                        set skip: 7
                    let bytes read_number(text, scan + skip, &num_end)
                    let line_end text.index_of(10 as u8, scan as size_t) as int
                    set scan: line_end + 1 + bytes + 1
                }
                else
                {
                    let line_end text.index_of(10 as u8, scan as size_t) as int
                    set scan: line_end + 1
                }
            }
        }
        if body_end < 0
            return 3
        run_scenario(text, eol + 1, body_end, key)
        set pos: body_end + (end_marker.length as int)
    }
    0
}

; the hash of every prefix 0..2100 of a file (the xxh3 port's check against the
; reference's dependency)
procedure xxh3_probe(path: String) returns int
{
    let text File.read_to_string(path)
    let host Page.get(text.get_buffer())
    var n 0
    while (n <= 2100) and (n <= (text.get_length() as int))
    {
        let h Xxh3.hex_of(host, Slice[char](n as size_t, text.get_buffer() as pointer[char]))
        var sb StringBuilder()
        sb.append(n)
        sb.append(" " as char)
        sb.append(h.data, h.length)
        sb.append("\n")
        emit(sb.to_string())
        set n: n + 1
    }
    0
}

; the inflated bytes of a gzip file (the inflate port's check against compress/gzip)
procedure gunzip_probe(path: String) returns int
{
    let raw File.read_to_string(path)
    let anchor String("gunzip")
    let host Page.get(anchor.get_buffer())
    let bytes Inflate.gunzip(host, Slice[char](raw.get_length(), raw.get_buffer() as pointer[char]))
    Io.write_all(1, bytes.data as pointer[void], bytes.length)
    0
}

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    if argc <> 3
    {
        print "usage: tscaly_exec --batch|--bench-batch <scenarios file>"
        return 2
    }
    let flag String(*(argv + 1))
    if flag.equals(String("--xxh3"))
        return xxh3_probe(String(*(argv + 2)))
    if flag.equals(String("--gunzip"))
        return gunzip_probe(String(*(argv + 2)))
    if flag.equals(String("--bench-batch"))
    {
        set bench_mode: true
        return run_batch(String(*(argv + 2)))
    }
    if flag.equals(String("--batch")) = false
    {
        print "usage: tscaly_exec --batch <scenarios file>"
        return 2
    }
    run_batch(String(*(argv + 2)))
}
