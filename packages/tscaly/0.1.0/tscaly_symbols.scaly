; SPDX-License-Identifier: Apache-2.0
;
; tscaly_symbols — our half of the BINDER yardstick (slice 26).
;
; Dumps our bind of one file in the format tests/oracle/symbols.go produces.
; Unlike the other three artifacts there is no trailing name column to strip on
; either side: the dump's lines have different field counts, so one `cut` width
; cannot mean "everything but the name" for all of them, and a per-line rule
; would be a normalisation inside the comparison. compare.py passes this artifact
; through uncut (keep = 0).
;
;   n <kind> <pos> <end> <sym|-> <locals|->       one line per node that has either
;   s <idx> <flags> <parent|-> <vdPos|-> <vdEnd|-> <members|-> <exports|-> <name>
;   d <idx> <kind> <pos> <end>                    one per declaration, in list order
;   x <idx> <exportSymIdx>                        the export symbol, when there is one
;   t <id> <count> / e <symIdx> <name>            one per table, entries name-sorted
;   f <symbolCount> <classifiableCount> / c <name>
;   B <pos> <end> <code>                          one per BIND diagnostic
;
; ★★★ THE YARDSTICK SHIPPED BEFORE THE BINDER DID (slice 26), and that is the
; lesson §3.5bd records from the JSDoc side: a construct the reference keeps
; OUTSIDE the tree is invisible to a green suite in both directions until it has an
; artifact of its own. Slice 27 fills it in — the container walk, declareSymbol and
; the variable/function/parameter arms — and every kind the reference's switch
; handles and that slice does not reports itself in the `unported` column, which is
; the progress bar the next binder slice is read off (tests/triage.py groups it).
;
; The program is three steps and no logic of its own: parse, bind, dump. The DUMP
; lives in the package (tscaly/SymbolDump.scaly) rather than here, because its
; numbering needs containers and a generic instance handed to a program root reads
; back as garbage — the same reason the other three dumpers ask for everything
; through statics.
;
; This is a program, not part of the `define tscaly` package module: it is
; compiled standalone against the package object, exactly as tscaly_ast is.

package scaly 0.1.0
package tscaly 0.1.0

use scaly.memory.Page
use scaly.io.File
use scaly.containers.String
use tscaly.ast.AstNode
use tscaly.parser.Parser
use tscaly.binder.Binder
use tscaly.SymbolDump.SymbolDump

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    if argc <> 2
    {
        print "usage: tscaly_symbols <file>"
        return 2
    }

    let path String(*(argv + 1))
    if File.exists(path) = false
    {
        print "cannot read `path`"
        return 1
    }

    let text File.read_to_string(path)

    ; The run region, the small anchor and the page it names: the idiom the other
    ; two dumpers use, and for the reason written down there — the source text of
    ; a large unit is an OVERSIZED allocation and Page.get() of an address inside
    ; one answers a page whose first allocation trips the oversized-page trap.
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer() as pointer[void])

    var unported 0 - 1
    var unported_tag null as pointer[const_char]
    var unported_detail 0
    let script_kind Parser.supported_script_kind(path)
    let file Parser.parse(host, path, text, script_kind, &unported, &unported_tag, &unported_detail)

    ; The parse's own unported report comes first: a tree built past a construct
    ; the parser could not scan has meaningless spans, so nothing downstream of it
    ; is worth reporting on.
    if unported >= 0
    {
        print "UNPORTED `unported` `unported_tag` `unported_detail`"
        return 0
    }

    if file = null
    {
        print "UNPORTED 0 no-tree 0"
        return 0
    }

    ; The BIND. `is_external_module` is asked of the parse rather than stored on the
    ; node, which is the same arrangement the parser already had for it (§3.5q), and
    ; it is asked ONCE because the reference asks it once too — its parser stores
    ; the indicator node and the binder only null-tests it.
    let is_external Parser.file_is_external_module(file, AstNode.statements_of(file))
    let b Binder.bind_source_file(host, file, text, is_external)

    ; The binder's own unported report, with the KIND as its detail: that is what
    ; makes the column a plan rather than a count.
    if Binder.unported_at(b) >= 0
    {
        print "UNPORTED `Binder.unported_at(b)` `Binder.unported_tag_at(b)` `Binder.unported_detail_at(b)`"
        return 0
    }

    SymbolDump.write(host, b, file)
    0
}
