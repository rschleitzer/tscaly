; SPDX-License-Identifier: Apache-2.0
;
; tscaly_dump — all FIVE artifacts of one unit, in one process.
;
; ★★★ WHY IT EXISTS, and the number is the whole argument. Measured over 17 900
; units, ten-wide: `/usr/bin/true` costs **16.3 s**, `tscaly_tokens` (a scan)
; 24.3 s, `tscaly_ast` (+ a parse) 26.6 s, `tscaly_symbols` (+ a bind) 27.6 s and
; `tscaly_types --sections` (+ three checkers) 28.0 s. So **58 % of the heaviest
; dumper is pure process creation** — the scan is 8.0 s of it, the parse 2.3 s, the
; bind 1.0 s and the three checkers 0.4 s. Five processes per unit therefore pay
; the 16.3 s five times and repeat the same scan, parse and bind four times over.
; One process pays it once.
;
; ★★★ AND IT IS NOT THE "BATCH DUMPER" TESTPLAN REFUSES. That refusal is about
; sharing process state ACROSS UNITS, where one unit's arena, caches and globals
; would reach the next; this shares one PARSE across the five artifacts OF ONE
; UNIT, which is the same thing `tscaly_types --sections` already does across its
; three checkers. Every unit still gets a fresh process, a fresh arena and a fresh
; everything.
;
; ★★★ WHAT THE SHARING RISKS, said plainly because it is the reason this file has a
; whole-corpus gate rather than an argument: **the BINDER MUTATES THE TREE** — flags
; and symbol slots — and the ast dump prints flags. So the order is tokens, ast,
; jsdoc, symbols, types, which is `ARTIFACTS` order in compare.py and puts every
; pre-bind dump in front of the bind. The jsdoc walk triggers a `.ts` file's LAZY
; JSDoc parse, which is why it stands after ast and not before. Neither of those is
; reasoned to be safe: `TSCALY_NO_COMBINED=1` runs the five programs instead, and
; the two were compared over every unit of both corpora, all five sections, before
; this became the default.
;
; ★★ THE PATH IS NORMALIZED ONCE AND SERVES ALL FIVE, where the five programs
; disagreed: tokens, ast and jsdoc took the raw argument and symbols and types the
; normalized one. tscaly_symbols' own header says why that was harmless — the two
; questions a parse asks of a name (is this a declaration file, which script kind)
; are asked of the LAST COMPONENT alone, so the two spellings cannot be told apart
; — and the bind is the one place the spelling shows, in an external module's symbol
; name. Normalizing for all five is therefore the strictly more correct of the two,
; and the corpus comparison is what says so rather than that paragraph.
;
; ★ ONE STREAM. Every line goes through `Console`, never through the prelude's
; `print`: the two are different streams to the same fd (stdio's buffer against a
; raw write) and mixing them reorders the output — see tscaly_types.scaly, where
; that cost 97 units of 1 123.

package scaly 0.1.0
package tscaly 0.1.0

use scaly.memory.Page
use scaly.io.File
use scaly.io.Console
use scaly.fiber.Io
use scaly.containers.String
use tscaly.ast.AstNode
use tscaly.tspath.TsPath
use tscaly.parser.Parser
use tscaly.binder.Binder
use tscaly.program.ProgramFiles
use tscaly.Diagnostics.DiagnosticList
use tscaly.Diagnostics.RelatedInfo
use tscaly.tsoptions.TsConfigParser
use tscaly.tsoptions.TsOptions
use tscaly.tsoptions.TsParsedCommandLine
use tscaly.program.JsonValue
use tscaly.checker.Checker
use tscaly.printer.SourceFileInfo
use tscaly.printer.Printer
use tscaly.emitter.Emitter
use tscaly.emitter.EmitOptions
use tscaly.compiler.ProgramLoader
use tscaly.compiler.ProgramDiagnostic
use scaly.containers.Array
use scaly.containers.StringBuilder
use tscaly.TokenDump.TokenDump
use tscaly.AstDump.AstDump
use tscaly.JsDocDump.JsDocDump
use tscaly.SymbolDump.SymbolDump
use tscaly.FlowDump.FlowDump
use tscaly.TypeDump.TypeDump
use tscaly.modulespecifiers.SpecifierHost

function getcwd(buf: pointer[char], size: size_t) returns pointer[char] extern

; The five artifact separators. `tscaly_types`' own two — `==== TSCALY-SECTION
; diags|dump` — nest inside the last one, so the two prefixes must differ.
procedure sep(name: Slice[char])
{
    Console.print("==== TSCALY-DUMP ")
    write(1, name.data as pointer[void], name.length)
    Console.println("")
}

; An unported report is MODE-INDEPENDENT: every one of the five programs prints the
; same line and returns. So one line becomes each remaining section, which is
; exactly what those programs would each have printed.
procedure fill(from: int, message: String)
{
    var i from
    while i < 7
    {
        if i = 1
            sep("ast")
        if i = 2
            sep("jsdoc")
        if i = 3
            sep("symbols")
        if i = 4
            sep("flow")
        if i = 5
            sep("types")
        if i = 6
            sep("emit")
        Console.println(message.to_c_string())
        set i: i + 1
    }
}

; ★★★ `--emit=<options>` — THE DRIVER CHAPTER'S ANSWER (slice 243): the JavaScript
; alone, under the options of one test configuration (`name=value;...`, the names
; lower-cased), against the reference's own `.js` baseline per CASE
; (tests/casejs.py). Nothing but the emit is printed; a stop is the same
; `UNPORTED n tag d` line the emit section prints.
; the lib chain a batch shares: the files and their binders, the program's order
define LibChain
(
    files: ref[Array[ref[AstNode]?]]
    binders: ref[Array[ref[Binder]?]]
)

; ── the emit driver (slices 243–248) ─────────────────────────────────────────

; the checker's options off the configuration (the resolver's answers depend on
; them)
procedure apply_emit_options(host: ref[Page], mutable cd: ref[Checker], emit_options: EmitOptions)
{
    set cd.module_kind: emit_options.get_emit_module_kind()
    set cd.language_version: emit_options.get_emit_script_target()
    set cd.use_define_for_class_fields: emit_options.get_use_define_for_class_fields()
    set cd.emit_standard_class_fields: emit_options.get_emit_standard_class_fields()
    set cd.legacy_decorators: EmitOptions.on(emit_options.experimental_decorators)
    set cd.emit_decorator_metadata: EmitOptions.on(emit_options.emit_decorator_metadata)
    set cd.verbatim_module_syntax: EmitOptions.on(emit_options.verbatim_module_syntax)
    set cd.isolated_modules: EmitOptions.on(emit_options.isolated_modules)
    set cd.preserve_const_enums: EmitOptions.on(emit_options.preserve_const_enums)
    set cd.module_resolution_kind: emit_options.get_module_resolution_kind()
    set cd.resolve_json_module: emit_options.get_resolve_json_module()
    set cd.import_helpers: EmitOptions.on(emit_options.import_helpers)
    set cd.erasable_syntax_only: EmitOptions.on(emit_options.erasable_syntax_only)
    set cd.no_unchecked_side_effect_imports: EmitOptions.true_or_unknown(emit_options.no_unchecked_side_effect_imports)
    set cd.no_implicit_override: EmitOptions.on(emit_options.no_implicit_override)
    set cd.allow_js: EmitOptions.on(emit_options.allow_js)
    set cd.resolve_package_json_exports: emit_options.resolve_package_json_exports
    set cd.resolve_package_json_imports: emit_options.resolve_package_json_imports
    set cd.jsx_emit: emit_options.jsx
    set cd.jsx_factory_option: emit_options.jsx_factory
    set cd.react_namespace_option: emit_options.react_namespace
    set cd.jsx_fragment_factory_option: emit_options.jsx_fragment_factory
    set cd.jsx_import_source_option: emit_options.jsx_import_source
    cd.set_program_directories(emit_options.out_dir, emit_options.project_root_directory(host), emit_options.get_current_directory())
}

; the lib chain of a configuration: the batch's (loaded once, run_batch) or this
; unit's own; null when a lib cannot be read
procedure chain_of(host: ref[Page], emit_options: EmitOptions, chain: ref[LibChain]?) returns ref[LibChain]?
{
    if chain <> null
        return chain
    let files &Array[ref[AstNode]?]^host()
    let binders &Array[ref[Binder]?]^host()
    let seen &Array[Slice[char]]^host()
    if Checker.load_lib_chain(host, emit_options.lib_names(host), files, binders, seen) = false
        return null
    &LibChain^host(files, binders)
}

; the checker over a lib chain: its first file as `lib_file`, the rest as the
; extras — handed to the CONSTRUCTOR, whose initialize_checker merges them
; (§3.5jt 6: set afterwards they were never merged)
procedure checker_over(host: ref[Page], file: ref[AstNode], path: String, b: ref[Binder], p: ref[Parser], ch: ref[LibChain], program: ref[ProgramFiles]?) returns ref[Checker]
{
    var lib_file: ref[AstNode]? null
    var lib_b: ref[Binder]? null
    var extra_files: ref[Array[ref[AstNode]?]]? null
    var extra_binders: ref[Array[ref[Binder]?]]? null
    let lib_files ch.files
    let lib_binders ch.binders
    if lib_files.get_length() > 0
    {
        set lib_file: lib_files[0]
        set lib_b: lib_binders[0]
    }
    if lib_files.get_length() > 1
    {
        let ef &Array[ref[AstNode]?]^host()
        let eb &Array[ref[Binder]?]^host()
        var li 1
        while li < (lib_files.get_length() as int)
        {
            ef.add(lib_files[li as size_t])
            eb.add(lib_binders[li as size_t])
            set li: li + 1
        }
        set extra_files: ef
        set extra_binders: eb
    }
    Checker.create_ex(host, file, path, b, p, lib_file, lib_b, extra_files, extra_binders, program)
}

; one unit's JavaScript to stdout, or its UNPORTED line; the checker has been
; pointed at the unit and has checked it
procedure emit_unit(host: ref[Page], mutable cd: ref[Checker], mutable file: ref[AstNode], mutable b: ref[Binder], mutable path_view: Slice[char], mutable text_view: Slice[char], script_kind: int, is_external: bool, mutable emit_options: EmitOptions, mutable out: ref[StringBuilder])
{
    let identifiers &Array[Slice[char]]^host()
    Emitter.collect_identifiers(host, file, identifiers)
    var forced false
    if b.is_declaration_file_of() = false
        set forced: Emitter.is_file_forced_to_be_module_by_format(path_view, emit_options)
    let info &SourceFileInfo^host(file, path_view, text_view, Printer.compute_ecma_line_starts(host, text_view), b.is_declaration_file_of(), script_kind, is_external or forced, identifiers, false)
    let em Emitter.create(host)
    let js StringBuilder^host()
    em.emit_js(file, info, emit_options, cd, b, &js)
    if em.unported_count = 0
    {
        let js_text js.to_string()
        out.append(js_text)
    }
    else
    {
        let m String("UNPORTED `em.unported_count` `Parser.tag_text(em.unported_tag)` `em.unported_detail`")
        out.append(m)
        out.append("\n")
    }
}

; one unit's DECLARATION file (slice 250): the `==== TSCALY-FILE <name>.d.ts`
; header the yardstick splits on, then the text; an UNPORTED line for a said
; stop; an EMPTY body where the file's declaration emit reported (the reference
; writes no .d.ts for it, and the yardstick checks that the baseline has none)
; false when the declaration emit reported (the reference's declaration
; diagnostics: the file gets no .d.ts)
procedure emit_unit_dts(host: ref[Page], mutable cd: ref[Checker], mutable file: ref[AstNode], mutable b: ref[Binder], mutable path_view: Slice[char], mutable text_view: Slice[char], script_kind: int, is_external: bool, mutable emit_options: EmitOptions, mutable out: ref[StringBuilder]) returns bool
{
    let hdr StringBuilder^host()
    hdr.append("==== TSCALY-FILE ")
    let dts_name Emitter.dts_name_of(host, path_view)
    hdr.append(dts_name.data, dts_name.length as size_t)
    let hs hdr.to_string()
    out.append(hs)
    out.append("\n")
    let identifiers &Array[Slice[char]]^host()
    Emitter.collect_identifiers(host, file, identifiers)
    var forced false
    if b.is_declaration_file_of() = false
        set forced: Emitter.is_file_forced_to_be_module_by_format(path_view, emit_options)
    ; the printer reads the OUTPUT's declaration-file flag (triple-slash
    ; directives, comments), which is true for a .d.ts
    let info &SourceFileInfo^host(file, path_view, text_view, Printer.compute_ecma_line_starts(host, text_view), true, script_kind, is_external or forced, identifiers, false)
    let em Emitter.create(host)
    let dts StringBuilder^host()
    em.emit_dts(file, info, emit_options, cd, b, &dts)
    if em.unported_count > 0
    {
        let m String("UNPORTED `em.unported_count` `Parser.tag_text(em.unported_tag)` `em.unported_detail`")
        out.append(m)
        out.append("\n")
        return true
    }
    if em.dts_blocked
    {
        out.append("TSCALY-DECLARATION-BLOCKED\n")
        return false
    }
    let dts_text dts.to_string()
    out.append(dts_text)
    true
}

procedure run_unit_emit(mutable options_text: String, arg: String, mutable text: String, mutable chain: ref[LibChain]?) returns int
{
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())
    let cwd_cap 4096
    let cwd_buf host.allocate(cwd_cap as size_t, 1) as pointer[char]
    if getcwd(cwd_buf, cwd_cap as size_t) = null
    {
        Console.println("UNPORTED 0 cwd 0")
        return 1
    }
    var cwd_len 0
    while (*(cwd_buf + cwd_len) as int) <> 0
        set cwd_len: cwd_len + 1
    var name_data Slice[char]()
    set name_data: TsPath.normalized_absolute_path(host, Slice[char](arg.get_length() as int, arg.get_buffer() as pointer[char]), Slice[char](cwd_len, cwd_buf))
    let path String(name_data.data as pointer[const_char], name_data.length as size_t)
    let script_kind Parser.supported_script_kind(path)
    let emit_options EmitOptions.parse(host, Slice[char](options_text.get_length() as int, options_text.get_buffer() as pointer[char]))
    ; the emit runs on the DECODED text (a byte order mark, UTF-16)
    var emit_text text
    let decoded StringBuilder^host()
    let raw_view Slice[char](text.get_length() as int, text.get_buffer() as pointer[char])
    if Emitter.decode_bytes(raw_view, &decoded)
        set emit_text: decoded.to_string()
    var unported 0 - 1
    var unported_tag: Slice[char] ""
    var unported_detail 0
    let p Parser.parse_ex(host, path, emit_text, script_kind, &unported, &unported_tag, &unported_detail)
    if unported >= 0
    {
        let m String("UNPORTED `unported` `Parser.tag_text(unported_tag)` `unported_detail`")
        Console.println(m.to_c_string())
        return 0
    }
    let file_opt Parser.source_file_of(p)
    if file_opt = null
    {
        Console.println("UNPORTED 0 no-tree 0")
        return 0
    }
    let file file_opt as ref[AstNode]
    ; moduleDetection auto: a JSX file the automatic runtime rewrites is a module
    ; (the binder and the emit both read it so)
    let is_external Parser.external_module_indicator(file, AstNode.statements_of(file)) or Emitter.is_file_module_from_using_jsx_tag(file, script_kind, emit_options)
    let b Binder.bind_source_file(host, file, emit_text, path, is_external)
    if Binder.unported_at(b) >= 0
    {
        let m String("UNPORTED `Binder.unported_at(b)` `Parser.tag_text(Binder.unported_tag_at(b))` `Binder.unported_detail_at(b)`")
        Console.println(m.to_c_string())
        return 0
    }
    ; the lib chain of the configuration (by target, or the `lib` option), the
    ; program's order; TSCALY_LIB still names ONE file for the older instruments
    let ch chain_of(host, emit_options, chain)
    if ch = null
    {
        Console.println("UNPORTED 0 lib 0")
        return 0
    }
    Checker.set_strict_null_checks(emit_options.strict_null_checks_on())
    Checker.set_exact_optional_property_types(emit_options.exact_optional_property_types_on())
    Checker.set_options(emit_options.strict_option_on(emit_options.no_implicit_any), emit_options.strict_option_on(emit_options.no_implicit_this), emit_options.strict_option_on(emit_options.use_unknown_in_catch_variables), emit_options.strict_option_on(emit_options.strict_property_initialization), emit_options.strict_option_on(emit_options.strict_function_types), emit_options.strict_option_on(emit_options.strict_bind_call_apply), emit_options.strict_option_on(emit_options.strict_builtin_iterator_return), emit_options.check_js, EmitOptions.on(emit_options.no_implicit_returns), EmitOptions.on(emit_options.no_unchecked_indexed_access), EmitOptions.on(emit_options.no_property_access_from_index_signature))
    Checker.set_resolution_options(EmitOptions.on(emit_options.allow_importing_ts_extensions), EmitOptions.on(emit_options.allow_arbitrary_extensions), EmitOptions.on(emit_options.rewrite_relative_import_extensions), emit_options.no_implicit_any_explicit())
    Checker.set_unused_options(EmitOptions.on(emit_options.no_unused_locals), EmitOptions.on(emit_options.no_unused_parameters))
    Checker.set_no_emit(EmitOptions.on(emit_options.no_emit))
    Checker.set_lib_option_has_dom(emit_options.lib_option_has_dom())
    Checker.set_report_options(emit_options.allow_unreachable_code, emit_options.allow_unused_labels, EmitOptions.on(emit_options.no_fallthrough_cases_in_switch), EmitOptions.on(emit_options.allow_umd_global_access))
    let cd checker_over(host, file, path, b, p, ch as ref[LibChain], null)
    apply_emit_options(host, cd, emit_options)
    ; the harness roots a batch unit at `/.src/<unit>`; the emit reads the file name
    let path_view Emitter.harness_file_name(host, Slice[char](path.get_length() as int, path.get_buffer() as pointer[char]))
    set cd.emit_module_format: emit_options.get_emit_module_format_of_file(path_view)
    cd.get_diagnostics()
    let text_view Slice[char](emit_text.get_length() as int, emit_text.get_buffer() as pointer[char])
    let single_out StringBuilder^host()
    emit_unit(host, cd, file, b, path_view, text_view, script_kind, is_external, emit_options, &single_out)
    let single_text single_out.to_string()
    Io.write_all(1, single_text.get_buffer() as pointer[void], single_text.get_length())
    0
}

; fileloader.go loadSourceFileMetaData: the nearest package.json's `type` reaches a
; file's metadata only under node16/nodenext resolution (and never for the
; extension-decided .mts/.cts/.mjs/.cjs), or for a file under node_modules
procedure unit_package_json_type(host: ref[Page], mutable pf: ref[ProgramFiles], mutable path: Slice[char], emit_options: EmitOptions) returns Slice[char]
{
    let t pf.package_json_type_of(host, path)
    if (t.length as int) = 0
        return t
    var under_node_modules false
    var i 0
    while (i + 14) <= (path.length as int)
    {
        let piece path.subslice(i as size_t, (i + 14) as size_t)
        if piece.equals("/node_modules/")
            set under_node_modules: true
        set i: i + 1
    }
    if under_node_modules
        return t
    if path.ends_with(".mts") or path.ends_with(".cts") or path.ends_with(".mjs") or path.ends_with(".cjs")
        return Slice[char]()
    if emit_options.module_resolution_is_node()
        return t
    Slice[char]()
}

; a bundle unit the parser has a grammar for; anything else (a `.css`, a `.txt`)
; is a file that exists and nothing more
function bundle_unit_is_source(path: Slice[char]) returns bool
{
    if path.ends_with(".ts") or path.ends_with(".tsx") or path.ends_with(".mts") or path.ends_with(".cts")
        return true
    if path.ends_with(".js") or path.ends_with(".jsx") or path.ends_with(".mjs") or path.ends_with(".cjs")
        return true
    path.ends_with(".json")
}

; the bundle's units into the table (the loop has a PAGE in scope so the views it
; hands the table are not the driver's frame to the escape checker); false after
; an UNPORTED line
procedure load_bundle(host: ref[Page], mutable pf: ref[ProgramFiles], mutable bundle: String, mutable emit_options: EmitOptions, mutable roots: ref[Array[Slice[char]]]) returns bool
{
    let root emit_options.get_current_directory()
    let n bundle.get_length() as int
    var pos 0
    while pos < n
    {
        let eol bundle.index_of(10 as u8, pos as size_t)
        if eol < 0
        {
            Console.println("UNPORTED 0 bundle 0")
            return false
        }
        ; `==== TSCALY-LINK <symlink>\t<target>` (slice 260)
        if (bundle.get((pos + 12) as size_t) as int) = ("L" as char) as int
        {
            let tab bundle.index_of(9 as u8, pos as size_t)
            if (tab < 0) or (tab > eol)
            {
                Console.println("UNPORTED 0 bundle 0")
                return false
            }
            let link bundle.substring((pos + 17) as size_t, (tab - pos - 17) as size_t)
            let target bundle.substring((tab + 1) as size_t, (eol - tab - 1) as size_t)
            pf.add_link(Slice[char](link.get_length() as int, link.get_buffer() as pointer[char]), Slice[char](target.get_length() as int, target.get_buffer() as pointer[char]))
            set pos: eol + 1
            continue
        }
        var q pos + 17
        var bytes 0
        while (bundle.get(q as size_t) as int) <> 32
        {
            set bytes: bytes * 10 + ((bundle.get(q as size_t) as int) - 48)
            set q: q + 1
        }
        set q: q + 1
        let flag_char bundle.get(q as size_t) as int
        let emit_flag (flag_char = 49) or (flag_char = 51)
        let root_flag (flag_char = 50) or (flag_char = 51)
        let config_flag flag_char = ("c" as char) as int
        set q: q + 2
        let name bundle.substring(q as size_t, (eol - q) as size_t)
        let body_start eol + 1
        let content bundle.substring(body_start as size_t, bytes as size_t)
        set pos: body_start + bytes + 1
        ; the unit's program path: `/.src/<unit>`, an absolute name standing
        let path_data TsPath.normalized_absolute_path(host, Slice[char](name.get_length() as int, name.get_buffer() as pointer[char]), root)
        let path String(path_data.data as pointer[const_char], path_data.length as size_t)
        if config_flag
        {
            pf.set_config(path_data, Slice[char](content.get_length() as int, content.get_buffer() as pointer[char]))
            continue
        }
        if root_flag
            roots.add(slice_copy_on(host, path_data))
        if bundle_unit_is_source(path_data) = false
        {
            let raw_copy String^host(content)
            pf.add(path_data, Slice[char](raw_copy.get_length() as int, raw_copy.get_buffer() as pointer[char]), null, null, null, false, 0)
            continue
        }
        if add_source_unit(host, pf, path_data, content, emit_flag, emit_options) = false
            return false
    }
    load_referenced_files(host, pf, emit_options)
}

; one source unit parsed, bound and added to the table (slice 256: load_bundle's
; loop body, shared with the referenced files); false after an UNPORTED line
procedure add_source_unit(host: ref[Page], mutable pf: ref[ProgramFiles], mutable path_data: Slice[char], mutable content: String, emit_flag: bool, emit_options: EmitOptions) returns bool
{
    let path String(path_data.data as pointer[const_char], path_data.length as size_t)
    let script_kind Parser.supported_script_kind(path)
    var emit_text content
    let decoded StringBuilder^host()
    let raw_view Slice[char](content.get_length() as int, content.get_buffer() as pointer[char])
    if Emitter.decode_bytes(raw_view, &decoded)
        set emit_text: decoded.to_string()
    let text_copy String^host(emit_text)
    var unported 0 - 1
    var unported_tag: Slice[char] ""
    var unported_detail 0
    let p Parser.parse_ex(host, path, text_copy, script_kind, &unported, &unported_tag, &unported_detail)
    if unported >= 0
    {
        let m String("UNPORTED `unported` `Parser.tag_text(unported_tag)` `unported_detail`")
        Console.println(m.to_c_string())
        return false
    }
    let file_opt Parser.source_file_of(p)
    if file_opt = null
    {
        Console.println("UNPORTED 0 no-tree 0")
        return false
    }
    let file file_opt as ref[AstNode]
    var is_external Parser.external_module_indicator(file, AstNode.statements_of(file)) or Emitter.is_file_module_from_using_jsx_tag(file, script_kind, emit_options)
    ; moduleDetection force (the default under node16..nodenext): every
    ; non-declaration file is a module, by force alone when no statement says so
    var forced false
    ; getExternalModuleIndicator: a JSON file is never a module (slice 257: a
    ; `package.json` under node16 took `export {}`)
    let is_json path_data.ends_with(".json")
    if emit_options.module_detection_is_force() and (is_declaration_file_name(path) = false) and (is_json = false)
    {
        if is_external = false
            set forced: true
        set is_external: true
    }
    ; moduleDetection auto: a `.mts`/`.cts` (or a node16+ ESM file) is a module
    ; by its FORMAT (getSetExternalModuleIndicator's third disjunct; slice 250 —
    ; the binder had only heard of it through the emitter's file info). ★Only under
    ; `auto`: GetExternalModuleIndicatorOptions' legacy arm forces nothing (slice 257)
    if (is_declaration_file_name(path) = false) and (is_json = false) and emit_options.module_detection_is_auto()
    {
        if Emitter.is_file_forced_to_be_module_by_format(path_data, emit_options)
        {
            if is_external = false
                set forced: true
            set is_external: true
        }
    }
    let b Binder.bind_source_file_ex(host, file, text_copy, path, is_external, forced)
    if Binder.unported_at(b) >= 0
    {
        let m String("UNPORTED `Binder.unported_at(b)` `Parser.tag_text(Binder.unported_tag_at(b))` `Binder.unported_detail_at(b)`")
        Console.println(m.to_c_string())
        return false
    }
    pf.add(path_data, Slice[char](text_copy.get_length() as int, text_copy.get_buffer() as pointer[char]), file, b, p, emit_flag, emit_options.get_emit_module_format_of_file(path_data))
    true
}

; the program's triple-slash `reference path` files (slice 256): filesparser.go's
; ReferencedFiles loop over resolveTripleslashPathReference and
; getSourceFileFromReference, over the table as it grows, so a referenced file's
; own references are followed too. A name with an extension is taken as it is, one
; without tries `.ts`, `.tsx`, `.d.ts`. A file that is not a bundle unit is read from
; disk only under the harness's `/.lib` folder (harnessutil's testLibFolderMap: the
; TypeScript submodule's tests/lib); anything else is the reference's "not found"
; diagnostic, which no yardstick here reads.
; ★ The reference adds a referenced file BEFORE its referrer; the table appends it.
; The noResolve option is not one the port parses.
procedure load_referenced_files(host: ref[Page], mutable pf: ref[ProgramFiles], emit_options: EmitOptions) returns bool
{
    var i 0
    while i < pf.count()
    {
        let f pf.file_at(i)
        let containing pf.path_at(i)
        set i: i + 1
        if f = null
            continue
        let refs AstNode.referenced_files_of(f)
        if refs = null
            continue
        let ra refs as ref[Array[Slice[char]]]
        var dir_len 0
        var s 0
        while s < (containing.length as int)
        {
            if (containing[s as size_t] as int) = ("/" as char) as int
                set dir_len: s
            set s: s + 1
        }
        let dir containing.subslice(0, dir_len as size_t)
        var k 0
        while k < (ra.get_length() as int)
        {
            let name ra[k as size_t]
            set k: k + 1
            let full TsPath.normalized_absolute_path(host, name, dir)
            if reference_has_extension(full)
            {
                if add_referenced_file(host, pf, full, emit_options) = false
                    return false
            }
            else
            {
                var added false
                if add_referenced_file_if_found(host, pf, Checker.concat_name(host, full, ".ts"), emit_options, &added) = false
                    return false
                if added = false
                {
                    if add_referenced_file_if_found(host, pf, Checker.concat_name(host, full, ".tsx"), emit_options, &added) = false
                        return false
                }
                if added = false
                {
                    if add_referenced_file_if_found(host, pf, Checker.concat_name(host, full, ".d.ts"), emit_options, &added) = false
                        return false
                }
            }
        }
    }
    true
}

function reference_has_extension(path: Slice[char]) returns bool
{
    var i (path.length as int) - 1
    while i >= 0
    {
        let c path[i as size_t] as int
        if c = ("/" as char) as int
            return false
        if c = ("." as char) as int
            return true
        set i: i - 1
    }
    false
}

; the disk path of a `/.lib/<name>` reference, empty for any other path
function test_lib_disk_path(host: ref[Page], path: Slice[char]) returns Slice[char]
{
    if path.length <= 6
        return Slice[char]()
    let head path.subslice(0, 6)
    if head.equals("/.lib/") = false
        return Slice[char]()
    Checker.concat_name(host, "packages/tscaly/_submodules/typescript-go/_submodules/TypeScript/tests/lib/", path.slice_from(6))
}

procedure add_referenced_file(host: ref[Page], mutable pf: ref[ProgramFiles], mutable path: Slice[char], emit_options: EmitOptions) returns bool
{
    var added false
    add_referenced_file_if_found(host, pf, path, emit_options, &added)
}

; the table's file of that path when it exists; otherwise a `/.lib` file read and
; added (never emitted); `added` says whether the path is in the table afterwards
procedure add_referenced_file_if_found(host: ref[Page], mutable pf: ref[ProgramFiles], mutable path: Slice[char], emit_options: EmitOptions, mutable added: ref[bool]) returns bool
{
    if pf.index_of_path(path) >= 0
    {
        set added: true
        return true
    }
    if bundle_unit_is_source(path) = false
        return true
    let disk test_lib_disk_path(host, path)
    if disk.length = 0
        return true
    let disk_s String^host(disk.data as pointer[const_char], disk.length as size_t)
    if File.exists(disk_s) = false
        return true
    let raw File.read_to_string(disk_s)
    let text String^host(raw)
    set added: true
    add_source_unit(host, pf, path, text, false, emit_options)
}

; the case BUNDLE (slice 248): `==== TSCALY-FILE <bytes> <emit 0|1> <unit>` lines
; with the unit's content after each, every unit rooted at `/.src/<unit>` as the
; reference's runner roots them. Every unit is parsed and bound, ONE checker holds
; the program, and each unit asked for is checked and emitted behind a
; `==== TSCALY-FILE <path>` line the yardstick splits on.
; ★ `--tsconfig=<options>` (slice 261): a case bundle's tsconfig.json read as the
; reference's test harness reads it (tsoptions.scaly), under the options' current
; directory — one `TSCONFIG-OPTION <name>\t<value>` line per compiler option the
; config sets, then one `TSCONFIG-FILE <path>` line per root file name, in order;
; `TSCONFIG-NONE` for a bundle without a config
procedure run_tsconfig(mutable options_text: String, bundle: String) returns int
{
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())
    let emit_options EmitOptions.parse(host, Slice[char](options_text.get_length() as int, options_text.get_buffer() as pointer[char]))
    let root emit_options.get_current_directory()
    let pf ProgramFiles.create(host)
    load_bundle_raw(host, pf, bundle, root)
    let index TsConfigParser.config_file_index(pf)
    if index < 0
    {
        Console.println("TSCONFIG-NONE")
        return 0
    }
    let parser TsConfigParser.create(host, pf, root)
    let parsed parser.parse_config_unit(index)
    if parsed = null
    {
        let tag parser.stop_tag
        let m String("UNPORTED 0 `String(tag.data as pointer[const_char], tag.length)` 0")
        Console.println(m.to_c_string())
        return 0
    }
    let options parsed.options
    var i 0
    while i < options.count()
    {
        let value options.value_at(i)
        let name options.name_at(i)
        set i: i + 1
        if value = null
            continue
        let text TsOptions.render(host, value as ref[JsonValue])
        let sb StringBuilder^host()
        sb.append("TSCONFIG-OPTION ")
        sb.append(name.data, name.length)
        sb.append("\t")
        sb.append(text.data, text.length)
        let line String^host(sb.to_string())
        Console.println(line.to_c_string())
    }
    let names parsed.file_names
    var j 0
    while j < (names.get_length() as int)
    {
        let file names[j as size_t]
        set j: j + 1
        let fb StringBuilder^host()
        fb.append("TSCONFIG-FILE ")
        fb.append(file.data, file.length)
        let fline String^host(fb.to_string())
        Console.println(fline.to_c_string())
    }
    0
}

; the bundle's units into the table as text only (the config reader parses nothing else)
procedure load_bundle_raw(host: ref[Page], mutable pf: ref[ProgramFiles], bundle: String, root: Slice[char])
{
    let n bundle.get_length() as int
    var pos 0
    while pos < n
    {
        let eol bundle.index_of(10 as u8, pos as size_t)
        if eol < 0
            return
        if (bundle.get((pos + 12) as size_t) as int) = ("L" as char) as int
        {
            set pos: eol + 1
            continue
        }
        var q pos + 17
        var bytes 0
        while (bundle.get(q as size_t) as int) <> 32
        {
            set bytes: bytes * 10 + ((bundle.get(q as size_t) as int) - 48)
            set q: q + 1
        }
        set q: q + 3
        let name bundle.substring(q as size_t, (eol - q) as size_t)
        let body_start eol + 1
        let content String^host(bundle.substring(body_start as size_t, bytes as size_t))
        set pos: body_start + bytes + 1
        let path_data TsPath.normalized_absolute_path(host, Slice[char](name.get_length() as int, name.get_buffer() as pointer[char]), root)
        pf.add(path_data, Slice[char](content.get_length() as int, content.get_buffer() as pointer[char]), null, null, null, false, 0)
    }
}

; the raw diagnostics of every parsed program file, one section each: `D` the
; parse, `J` the JS-only parse, `B` the bind, `C` the checker (the program's
; composition rules are the reader's); a checker stop anywhere is the case's
procedure print_case_diagnostics(host: ref[Page], mutable cd: ref[Checker], mutable pf: ref[ProgramFiles], mutable loader: ref[ProgramLoader]) returns int
{
    var ui 0
    while ui < pf.count()
    {
        let uf pf.file_at(ui)
        let upath pf.path_at(ui)
        if (uf = null) or (loader.holds(ui) = false)
        {
            set ui: ui + 1
            continue
        }
        ; a JSON program file: its parse diagnostics only (GetSyntacticDiagnostics)
        if upath.ends_with(".json")
        {
            let jf uf as ref[AstNode]
            let jb StringBuilder^host()
            jb.append("==== TSCALY-FILE ")
            jb.append(upath.data, upath.length)
            jb.append("\n")
            var jdi 0
            while jdi < AstNode.diagnostic_count(jf)
            {
                var p 0
                var e 0
                var c 0
                if AstNode.diagnostic_at(jf, jdi, &p, &e, &c)
                {
                    append_diagnostic_head(&jb, "D ", p, e, c)
                    AstNode.append_diagnostic_args_at(jf, false, jdi, &jb)
                    jb.append("\n")
                }
                set jdi: jdi + 1
            }
            let js jb.to_string()
            Io.write_all(1, js.get_buffer() as pointer[void], js.get_length())
            set ui: ui + 1
            continue
        }
        let file uf as ref[AstNode]
        let sb StringBuilder^host()
        sb.append("==== TSCALY-FILE ")
        sb.append(upath.data, upath.length)
        sb.append("\n")
        sb.append("K ")
        sb.append(AstNode.check_js_directive_of(file))
        sb.append("\n")
        let upp pf.parser_at(ui)
        if upp <> null
        {
            let up upp as ref[Parser]
            var ri 0
            while ri < Parser.comment_directive_count(up)
            {
                var rs 0
                var re 0
                var rk 0
                Parser.comment_directive_at(up, ri, &rs, &re, &rk)
                append_diagnostic_line(&sb, "R ", rs, re, rk)
                set ri: ri + 1
            }
            var si 0
            while si < Parser.jsdoc_diagnostic_count(up)
            {
                var sp 0
                var se 0
                var sc 0
                if Parser.jsdoc_diagnostic_at(up, si, &sp, &se, &sc)
                {
                    append_diagnostic_head(&sb, "S ", sp, se, sc)
                    Parser.append_jsdoc_diagnostic_args_at(up, si, &sb)
                    sb.append("\n")
                    Parser.append_jsdoc_diagnostic_related_at(up, si, &sb, upath)
                }
                set si: si + 1
            }
        }
        var di 0
        while di < AstNode.diagnostic_count(file)
        {
            var p 0
            var e 0
            var c 0
            if AstNode.diagnostic_at(file, di, &p, &e, &c)
            {
                append_diagnostic_head(&sb, "D ", p, e, c)
                AstNode.append_diagnostic_args_at(file, false, di, &sb)
                sb.append("\n")
                AstNode.append_diagnostic_related_at(file, false, di, &sb, upath)
            }
            set di: di + 1
        }
        var ji 0
        while ji < AstNode.js_diagnostic_count(file)
        {
            var p 0
            var e 0
            var c 0
            if AstNode.js_diagnostic_at(file, ji, &p, &e, &c)
            {
                append_diagnostic_head(&sb, "J ", p, e, c)
                AstNode.append_diagnostic_args_at(file, true, ji, &sb)
                sb.append("\n")
                AstNode.append_diagnostic_related_at(file, true, ji, &sb, upath)
            }
            set ji: ji + 1
        }
        let ub pf.binder_at(ui) as ref[Binder]
        var bi 0
        while bi < Binder.diagnostic_count(ub)
        {
            var p 0
            var e 0
            var c 0
            if Binder.diagnostic_at(ub, bi, &p, &e, &c)
            {
                append_diagnostic_head(&sb, "B ", p, e, c)
                Binder.append_diagnostic_args_at(ub, bi, &sb)
                sb.append("\n")
                Binder.append_diagnostic_related_at(ub, bi, &sb, upath)
            }
            set bi: bi + 1
        }
        let stops_before cd.unported_mark()
        cd.select_program_file(ui, pf.format_at(ui))
        cd.get_diagnostics()
        if cd.unported_mark() > stops_before
        {
            var tag: Slice[char] "checker-stop"
            var detail 0
            if Checker.stop_count(cd) > 0
            {
                set tag: Checker.stop_tag_at(cd, Checker.stop_count(cd) - 1)
                set detail: Checker.stop_detail_at(cd, Checker.stop_count(cd) - 1)
            }
            let m String("UNPORTED `cd.unported_mark() - stops_before` `Parser.tag_text(tag)` `detail`")
            Console.println(m.to_c_string())
            return 0
        }
        ; GetDiagnosticsForFile: what the one checker holds for this file now (an
        ; earlier file's diagnostic found later is not asked for again)
        var ci 0
        while ci < Checker.diagnostic_count(cd)
        {
            var p 0
            var e 0
            var c 0
            Checker.diagnostic_at(cd, ci, &p, &e, &c)
            if Checker.diagnostic_file_at(cd, ci) = ui
            {
                append_diagnostic_head(&sb, "C ", p, e, c)
                Checker.append_diagnostic_args_at(cd, ci, &sb)
                sb.append("\n")
                Checker.append_diagnostic_chain_at(cd, ci, &sb)
                Checker.append_diagnostic_related_at(cd, ci, &sb)
            }
            set ci: ci + 1
        }
        ; the include processor's diagnostics located in this file
        var li 0
        while li < (loader.diagnostics.get_length() as int)
        {
            let ld loader.diagnostics[li as size_t]
            if ld.file_index = ui
                append_program_diagnostic_line(&sb, "P ", ld)
            set li: li + 1
        }
        let s sb.to_string()
        Io.write_all(1, s.get_buffer() as pointer[void], s.get_length())
        set ui: ui + 1
    }
    ; GetDeclarationDiagnostics (slice 270), after every file's semantic
    ; diagnostics: a `TSCALY-DECL <path>` section of `X` lines per emitted file
    if EmitOptions.on(loader.options.declaration) or EmitOptions.on(loader.options.composite)
    {
        var di 0
        while di < pf.count()
        {
            let df pf.file_at(di)
            let dpath pf.path_at(di)
            let dindex di
            set di: di + 1
            if df = null
                continue
            if (loader.holds(dindex) = false) or (loader.source_file_may_be_emitted(dindex) = false) or dpath.ends_with(".json")
                continue
            let db pf.binder_at(dindex) as ref[Binder]
            let dpath_s String(dpath.data as pointer[const_char], dpath.length as size_t)
            let dtext pf.text_at(dindex)
            let identifiers &Array[Slice[char]]^host()
            Emitter.collect_identifiers(host, df as ref[AstNode], identifiers)
            let info &SourceFileInfo^host(df as ref[AstNode], dpath, dtext, Printer.compute_ecma_line_starts(host, dtext), true, Parser.supported_script_kind(dpath_s), db.is_external_module_of(), identifiers, false)
            let em Emitter.create(host)
            let found &Array[int]^host()
            let found_args &Array[ref[Array[String]]?]^host()
            let found_related &Array[ref[Array[RelatedInfo]]?]^host()
            cd.select_program_file(dindex, pf.format_at(dindex))
            if em.declaration_diagnostics(df as ref[AstNode], info, loader.options, cd, db, found, found_args, found_related) = false
            {
                let m String("UNPORTED `em.unported_count` `Parser.tag_text(em.unported_tag)` `em.unported_detail`")
                Console.println(m.to_c_string())
                return 0
            }
            let xb StringBuilder^host()
            xb.append("==== TSCALY-FILE TSCALY-DECL ")
            xb.append(dpath.data, dpath.length)
            xb.append("\n")
            var xi 0
            while xi < ((found.get_length() as int) / 3)
            {
                append_diagnostic_head(&xb, "X ", found[(3 * xi) as size_t], found[(3 * xi + 1) as size_t], found[(3 * xi + 2) as size_t])
                let xargs found_args[xi as size_t]
                if xargs <> null
                    DiagnosticList.append_escaped_args(xargs as ref[Array[String]], &xb)
                xb.append("\n")
                let xrelated found_related[xi as size_t]
                if xrelated <> null
                {
                    let xr xrelated as ref[Array[RelatedInfo]]
                    var xk 0
                    while xk < (xr.get_length() as int)
                    {
                        DiagnosticList.append_related_line(xr[xk as size_t], dpath, &xb)
                        set xk: xk + 1
                    }
                }
                set xi: xi + 1
            }
            let xs xb.to_string()
            Io.write_all(1, xs.get_buffer() as pointer[void], xs.get_length())
        }
    }
    ; the program's global diagnostics (G) and the config file's (P)
    let gb StringBuilder^host()
    gb.append("==== TSCALY-FILE TSCALY-GLOBAL\n")
    var gi 0
    while gi < Checker.global_diagnostic_code_count(cd)
    {
        append_diagnostic_head(&gb, "G ", 0, 0, Checker.global_diagnostic_code_at(cd, gi))
        Checker.append_global_diagnostic_args_at(cd, gi, &gb)
        gb.append("\n")
        Checker.append_global_diagnostic_chain_at(cd, gi, &gb)
        Checker.append_global_diagnostic_related_at(cd, gi, &gb)
        set gi: gi + 1
    }
    var pi 0
    while pi < (loader.diagnostics.get_length() as int)
    {
        let pd loader.diagnostics[pi as size_t]
        if pd.file_index = (0 - 1)
            append_program_diagnostic_line(&gb, "G ", pd)
        set pi: pi + 1
    }
    if (pf.config_path.length as int) > 0
    {
        gb.append("==== TSCALY-FILE ")
        gb.append(pf.config_path.data, pf.config_path.length)
        gb.append("\n")
        var ki 0
        while ki < (loader.diagnostics.get_length() as int)
        {
            let kd loader.diagnostics[ki as size_t]
            if kd.file_index = (0 - 2)
                append_program_diagnostic_line(&gb, "P ", kd)
            set ki: ki + 1
        }
    }
    let gs gb.to_string()
    Io.write_all(1, gs.get_buffer() as pointer[void], gs.get_length())
    0
}

procedure append_diagnostic_head(mutable sb: ref[StringBuilder], tag: Slice[char], p: int, e: int, c: int)
{
    sb.append(tag.data, tag.length)
    sb.append(p)
    sb.append(" " as char)
    sb.append(e)
    sb.append(" " as char)
    sb.append(c)
}

procedure append_program_diagnostic_line(mutable sb: ref[StringBuilder], tag: Slice[char], d: ProgramDiagnostic)
{
    append_diagnostic_head(sb, tag, d.pos, d.end, d.code)
    if d.args <> null
        DiagnosticList.append_escaped_args(d.args as ref[Array[String]], sb)
    sb.append("\n")
}

procedure append_diagnostic_line(mutable sb: ref[StringBuilder], tag: Slice[char], p: int, e: int, c: int)
{
    sb.append(tag.data, tag.length)
    sb.append(p)
    sb.append(" " as char)
    sb.append(e)
    sb.append(" " as char)
    sb.append(c)
    sb.append("\n")
}

procedure run_case_emit(mutable options_text: String, mutable bundle: String, mutable chain: ref[LibChain]?, errors_only: bool, post_emit: bool) returns int
{
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())
    let emit_options EmitOptions.parse(host, Slice[char](options_text.get_length() as int, options_text.get_buffer() as pointer[char]))
    let pf ProgramFiles.create(host)
    let custom emit_options.custom_condition_list(host)
    var cc 0
    while cc < (custom.get_length() as int)
    {
        pf.add_custom_condition(custom[cc as size_t])
        set cc: cc + 1
    }
    let roots &Array[Slice[char]]^host()
    if load_bundle(host, pf, bundle, emit_options, roots) = false
        return 0
    ; preserveSymlinks: a symlinked file is its own file at the link's path (the
    ; host reads it through the link; nothing takes its realpath)
    if EmitOptions.on(emit_options.preserve_symlinks)
    {
        var sli 0
        let link_n pf.link_count()
        while sli < link_n
        {
            let target_index pf.index_of_exact_path(pf.link_target_at(sli))
            if (target_index >= 0) and (pf.index_of_exact_path(pf.link_path_at(sli)) < 0)
            {
                let ttext pf.text_at(target_index)
                let lcontent String(ttext.data as pointer[const_char], ttext.length as size_t)
                if add_source_unit(host, pf, pf.link_path_at(sli), lcontent, false, emit_options) = false
                    return 0
            }
            set sli: sli + 1
        }
    }
    ; compilerOptions.TypeRoots, comma separated, absolute against the current directory
    let type_roots_text emit_options.type_roots
    var tr_root Slice[char]()
    var tr_start 0
    var tr_i 0
    while tr_i <= (type_roots_text.length as int)
    {
        var tr_end tr_i = (type_roots_text.length as int)
        var tr_comma false
        if tr_end = false
            set tr_comma: (type_roots_text[tr_i as size_t] as int) = ("," as char) as int
        if tr_end or tr_comma
        {
            if tr_i > tr_start
            {
                set tr_root: TsPath.normalized_absolute_path(host, type_roots_text.subslice(tr_start as size_t, tr_i as size_t), emit_options.get_current_directory())
                pf.add_type_root(tr_root)
            }
            set tr_start: tr_i + 1
        }
        set tr_i: tr_i + 1
    }
    var decl_dir Slice[char]()
    if (emit_options.declaration_dir.length as int) > 0
        set decl_dir: TsPath.normalized_absolute_path(host, emit_options.declaration_dir, emit_options.get_current_directory())
    var config_abs Slice[char]()
    if (emit_options.config_file_path.length as int) > 0
        set config_abs: TsPath.normalized_absolute_path(host, emit_options.config_file_path, emit_options.get_current_directory())
    pf.set_output_options(decl_dir, config_abs, emit_options.get_current_directory())
    ; the formats need the WHOLE table (the nearest package.json's `type`)
    var fi2 0
    while fi2 < pf.count()
    {
        var uo emit_options
        set uo.package_json_type: unit_package_json_type(host, pf, pf.path_at(fi2), emit_options)
        pf.set_format(fi2, uo.get_emit_module_format_of_file(pf.path_at(fi2)))
        pf.set_package_json_type(fi2, uo.package_json_type)
        set fi2: fi2 + 1
    }
    ; the checker is built over the first parsed unit
    var first 0 - 1
    var fi 0
    while fi < pf.count()
    {
        if (first < 0) and (pf.file_at(fi) <> null)
            set first: fi
        set fi: fi + 1
    }
    if first < 0
    {
        Console.println("UNPORTED 0 bundle 0")
        return 0
    }
    var ch chain_of(host, emit_options, chain)
    ; the program's own `/// <reference lib>` directives add lib files, and under
    ; libReplacement every lib file may resolve to `@typescript/lib-<name>`
    if EmitOptions.on(emit_options.no_lib) = false
    {
        let lib_refs &Array[Slice[char]]^host()
        var lri 0
        while lri < pf.count()
        {
            let lrp pf.parser_at(lri)
            if lrp <> null
            {
                let lpp lrp as ref[Parser]
                var ldi 0
                while ldi < Parser.reference_directive_count(lpp)
                {
                    var lkind 0
                    var lrs 0
                    var lre 0
                    Parser.reference_directive_at(lpp, ldi, &lkind, &lrs, &lre)
                    set ldi: ldi + 1
                    if lkind = 2
                        lib_refs.add(pf.text_at(lri).subslice(lrs as size_t, lre as size_t))
                }
            }
            set lri: lri + 1
        }
        if EmitOptions.on(emit_options.lib_replacement) or (lib_refs.get_length() > 0)
        {
            let lib_list emit_options.lib_names(host)
            var lli 0
            while lli < (lib_refs.get_length() as int)
            {
                lib_list.add(lib_refs[lli as size_t])
                set lli: lli + 1
            }
            var resolve_dir emit_options.get_current_directory()
            if (emit_options.config_file_path.length as int) > 0
                set resolve_dir: TsPath.directory_of(host, TsPath.normalized_absolute_path(host, emit_options.config_file_path, emit_options.get_current_directory()))
            let lfiles &Array[ref[AstNode]?]^host()
            let lbinders &Array[ref[Binder]?]^host()
            let lseen &Array[Slice[char]]^host()
            if Checker.load_lib_chain_replacing(host, lib_list, lfiles, lbinders, lseen, pf, EmitOptions.on(emit_options.lib_replacement), emit_options.get_module_resolution_kind(), resolve_dir) = false
            {
                Console.println("UNPORTED 0 lib 0")
                return 0
            }
            set ch: &LibChain^host(lfiles, lbinders)
        }
    }
    if ch = null
    {
        Console.println("UNPORTED 0 lib 0")
        return 0
    }
    let path0 pf.path_at(first)
    Checker.set_strict_null_checks(emit_options.strict_null_checks_on())
    Checker.set_exact_optional_property_types(emit_options.exact_optional_property_types_on())
    Checker.set_options(emit_options.strict_option_on(emit_options.no_implicit_any), emit_options.strict_option_on(emit_options.no_implicit_this), emit_options.strict_option_on(emit_options.use_unknown_in_catch_variables), emit_options.strict_option_on(emit_options.strict_property_initialization), emit_options.strict_option_on(emit_options.strict_function_types), emit_options.strict_option_on(emit_options.strict_bind_call_apply), emit_options.strict_option_on(emit_options.strict_builtin_iterator_return), emit_options.check_js, EmitOptions.on(emit_options.no_implicit_returns), EmitOptions.on(emit_options.no_unchecked_indexed_access), EmitOptions.on(emit_options.no_property_access_from_index_signature))
    Checker.set_resolution_options(EmitOptions.on(emit_options.allow_importing_ts_extensions), EmitOptions.on(emit_options.allow_arbitrary_extensions), EmitOptions.on(emit_options.rewrite_relative_import_extensions), emit_options.no_implicit_any_explicit())
    Checker.set_unused_options(EmitOptions.on(emit_options.no_unused_locals), EmitOptions.on(emit_options.no_unused_parameters))
    Checker.set_no_emit(EmitOptions.on(emit_options.no_emit))
    Checker.set_lib_option_has_dom(emit_options.lib_option_has_dom())
    Checker.set_report_options(emit_options.allow_unreachable_code, emit_options.allow_unused_labels, EmitOptions.on(emit_options.no_fallthrough_cases_in_switch), EmitOptions.on(emit_options.allow_umd_global_access))
    let cd checker_over(host, pf.file_at(first) as ref[AstNode], String(path0.data as pointer[const_char], path0.length as size_t), pf.binder_at(first) as ref[Binder], pf.parser_at(first) as ref[Parser], ch as ref[LibChain], pf)
    apply_emit_options(host, cd, emit_options)
    if errors_only
    {
        ; the program (slice 268): the file loader over the harness's root files,
        ; then verifyCompilerOptions
        let loader ProgramLoader.create(host, pf, emit_options, cd)
        pf.enable_resolution_records()
        loader.load(roots)
        if (loader.stop_tag.length as int) > 0
        {
            let m String("UNPORTED 0 `Parser.tag_text(loader.stop_tag)` 0")
            Console.println(m.to_c_string())
            return 0
        }
        pf.set_members(loader.members)
        var ei 0
        while ei < pf.count()
        {
            pf.set_emit(ei, loader.holds(ei) and loader.source_file_may_be_emitted(ei))
            set ei: ei + 1
        }
        loader.verify_compiler_options(&Array[Slice[char]]^host())
        if (loader.stop_tag.length as int) > 0
        {
            let m2 String("UNPORTED 0 `Parser.tag_text(loader.stop_tag)` 0")
            Console.println(m2.to_c_string())
            return 0
        }
        ; GetConfigFileParsingDiagnostics (slice 273): the config file's parse
        ; diagnostics and its conversion's errors, in the config section (P) or,
        ; without a position, among the global ones
        if (pf.config_path.length as int) > 0
        {
            let tp TsConfigParser.create(host, pf, emit_options.get_current_directory())
            let found tp.config_file_diagnostics(pf.config_path, pf.config_text)
            if found = null
            {
                let m3 String("UNPORTED 0 `Parser.tag_text(tp.stop_tag)` 0")
                Console.println(m3.to_c_string())
                return 0
            }
            let fl found as ref[Array[int]]
            var fi 0
            while fi < ((fl.get_length() as int) / 3)
            {
                let fp fl[(3 * fi) as size_t]
                var findex 0 - 2
                if fp < 0
                    set findex: 0 - 1
                loader.diagnostics.add(ProgramDiagnostic(findex, fp, fl[(3 * fi + 1) as size_t], fl[(3 * fi + 2) as size_t], tp.diagnostic_args_at(fi), null, null, 0 - 1))
                set fi: fi + 1
            }
        }
        ; the program's checker (slice 269): over the files the program holds, its
        ; globals and augmentations merged under the configuration's options
        Checker.set_defer_initialize(true)
        let pc checker_over(host, pf.file_at(first) as ref[AstNode], String(path0.data as pointer[const_char], path0.length as size_t), pf.binder_at(first) as ref[Binder], pf.parser_at(first) as ref[Parser], ch as ref[LibChain], pf)
        Checker.set_defer_initialize(false)
        apply_emit_options(host, pc, emit_options)
        pc.set_message_specifiers(SpecifierHost.create(host, pc, pf, emit_options))
        pc.initialize_checker()
        ; harnessutil's post-emit program: Emit runs before the diagnostics are
        ; asked for, and the emit resolver's answers can change what checking
        ; reports afterwards (the harness keeps the shorter of the two lists)
        if post_emit
        {
            var pi 0
            while pi < pf.count()
            {
                let pfile pf.file_at(pi)
                if pf.emit_at(pi) and (pfile <> null)
                {
                    pc.select_program_file(pi, pf.format_at(pi))
                    let ppath pf.path_at(pi)
                    let ppath_s String(ppath.data as pointer[const_char], ppath.length as size_t)
                    let pb pf.binder_at(pi) as ref[Binder]
                    var post_options emit_options
                    set post_options.package_json_type: unit_package_json_type(host, pf, ppath, emit_options)
                    let script_kind Parser.supported_script_kind(ppath_s)
                    var forced false
                    if pb.is_declaration_file_of() = false
                        set forced: Emitter.is_file_forced_to_be_module_by_format(ppath, post_options)
                    let pid &Array[Slice[char]]^host()
                    Emitter.collect_identifiers(host, pfile as ref[AstNode], pid)
                    if EmitOptions.on(emit_options.emit_declaration_only) = false
                    {
                        let jinfo &SourceFileInfo^host(pfile as ref[AstNode], ppath, pf.text_at(pi), Printer.compute_ecma_line_starts(host, pf.text_at(pi)), pb.is_declaration_file_of(), script_kind, pb.is_external_module_of() or forced, pid, false)
                        let jem Emitter.create(host)
                        let jout StringBuilder^host()
                        jem.emit_js(pfile as ref[AstNode], jinfo, post_options, pc, pb, &jout)
                        if jem.unported_count > 0
                        {
                            let jm String("UNPORTED `jem.unported_count` `Parser.tag_text(jem.unported_tag)` `jem.unported_detail`")
                            Console.println(jm.to_c_string())
                            return 0
                        }
                    }
                    if EmitOptions.on(emit_options.declaration) or EmitOptions.on(emit_options.composite)
                    {
                        let dinfo &SourceFileInfo^host(pfile as ref[AstNode], ppath, pf.text_at(pi), Printer.compute_ecma_line_starts(host, pf.text_at(pi)), true, script_kind, pb.is_external_module_of() or forced, pid, false)
                        let dem Emitter.create(host)
                        let dout StringBuilder^host()
                        dem.emit_dts(pfile as ref[AstNode], dinfo, post_options, pc, pb, &dout)
                        if dem.unported_count > 0
                        {
                            let dm String("UNPORTED `dem.unported_count` `Parser.tag_text(dem.unported_tag)` `dem.unported_detail`")
                            Console.println(dm.to_c_string())
                            return 0
                        }
                    }
                }
                set pi: pi + 1
            }
        }
        return print_case_diagnostics(host, pc, pf, loader)
    }
    var declaration_errors false
    var ui 0
    while ui < pf.count()
    {
        if pf.emit_at(ui)
        {
            let uf pf.file_at(ui)
            if uf <> null
            {
                cd.select_program_file(ui, pf.format_at(ui))
                let stops_before cd.unported_mark()
                let log_before Checker.stop_count(cd)
                ; the harness's post-emit program EMITS FIRST and checks afterwards;
                ; only noEmitOnError asks for the diagnostics before the emit
                let check_first EmitOptions.on(emit_options.no_emit_on_error)
                if check_first
                    cd.get_diagnostics()
                let upath pf.path_at(ui)
                let ub pf.binder_at(ui) as ref[Binder]
                let upath_s String(upath.data as pointer[const_char], upath.length as size_t)
                var unit_options emit_options
                set unit_options.package_json_type: unit_package_json_type(host, pf, upath, emit_options)
                let unit_out StringBuilder^host()
                ; the JS, unless emitDeclarationOnly (slice 250)
                let emits_js EmitOptions.on(emit_options.emit_declaration_only) = false
                let emits_dts EmitOptions.on(emit_options.declaration) or EmitOptions.on(emit_options.composite)
                var unit_declaration_errors false
                if cd.unported_mark() = stops_before
                {
                    if emits_js
                    {
                        let hdr StringBuilder^host()
                        hdr.append("==== TSCALY-FILE ")
                        hdr.append(upath.data, upath.length)
                        hdr.append("\n")
                        let hs hdr.to_string()
                        unit_out.append(hs)
                        emit_unit(host, cd, uf as ref[AstNode], ub, upath, pf.text_at(ui), Parser.supported_script_kind(upath_s), ub.is_external_module_of(), unit_options, &unit_out)
                    }
                    ; the declaration file under `declaration` or `composite` (slice 250)
                    if emits_dts and (cd.unported_mark() = stops_before)
                    {
                        if emit_unit_dts(host, cd, uf as ref[AstNode], ub, upath, pf.text_at(ui), Parser.supported_script_kind(upath_s), ub.is_external_module_of(), unit_options, &unit_out) = false
                            set unit_declaration_errors: true
                    }
                }
                ; a checker stop while THIS unit was emitted (or checked) is the unit's
                ; stop: an alias left unmarked by a stopped resolution elides an import,
                ; and a wrong answer is worth less than a said stop
                if cd.unported_mark() > stops_before
                {
                    var tag: Slice[char] "checker-stop"
                    var detail 0
                    if Checker.stop_count(cd) > log_before
                    {
                        set tag: Checker.stop_tag_at(cd, log_before)
                        set detail: Checker.stop_detail_at(cd, log_before)
                    }
                    let stop_line String("UNPORTED `cd.unported_mark() - stops_before` `Parser.tag_text(tag)` `detail`")
                    if emits_js
                    {
                        let shdr StringBuilder^host()
                        shdr.append("==== TSCALY-FILE ")
                        shdr.append(upath.data, upath.length)
                        let shs shdr.to_string()
                        Console.println(shs.to_c_string())
                        Console.println(stop_line.to_c_string())
                    }
                    if emits_dts
                    {
                        let hdr2 StringBuilder^host()
                        hdr2.append("==== TSCALY-FILE ")
                        let dn Emitter.dts_name_of(host, upath)
                        hdr2.append(dn.data, dn.length as size_t)
                        let hs2 hdr2.to_string()
                        Console.println(hs2.to_c_string())
                        Console.println(stop_line.to_c_string())
                    }
                }
                else
                {
                    if unit_declaration_errors
                        set declaration_errors: true
                    let unit_text unit_out.to_string()
                    Io.write_all(1, unit_text.get_buffer() as pointer[void], unit_text.get_length())
                }
            }
        }
        set ui: ui + 1
    }
    ; HandleNoEmitOnError (slice 262): under noEmitOnError a program with a
    ; syntactic, semantic or declaration diagnostic emits nothing, and the harness
    ; baselines the noCheck emit instead — which is what this answer printed, so the
    ; decision is a section of its own after the files
    if EmitOptions.on(emit_options.no_emit_on_error)
    {
        var has_errors declaration_errors
        var pi 0
        while pi < pf.count()
        {
            let pp pf.parser_at(pi)
            if pp <> null
            {
                let pd (pp as ref[Parser]).diagnostics
                if pd <> null
                {
                    if (pd as ref[DiagnosticList]).length() > 0
                        set has_errors: true
                }
            }
            set pi: pi + 1
        }
        ; GetSemanticDiagnostics over the program's files the emit loop did not check
        var ci 0
        while ci < pf.count()
        {
            let cpath pf.path_at(ci)
            if (pf.emit_at(ci) = false) and (pf.file_at(ci) <> null) and (cpath.ends_with(".json") = false)
            {
                cd.select_program_file(ci, pf.format_at(ci))
                cd.get_diagnostics()
            }
            set ci: ci + 1
        }
        if Checker.diagnostic_count(cd) > 0
            set has_errors: true
        if has_errors
        {
            Console.println("==== TSCALY-FILE TSCALY-NOEMITONERROR")
            Console.println("emit skipped")
        }
    }
    0
}

procedure run_unit(mutable flag: String, arg: String, mutable text: String, mutable chain: ref[LibChain]?) returns int
{
    if flag.starts_with("--tsconfig=")
        return run_tsconfig(flag.substring(11 as size_t, (flag.get_length() - 11) as size_t), text)
    ; `--errors=<options>` (slice 263): a case bundle's diagnostics per program file
    if flag.starts_with("--errors=")
    {
        let options_text flag.substring(9 as size_t, (flag.get_length() - 9) as size_t)
        run_case_emit(options_text, text, chain, true, false)
        ; the post-emit program, unless nothing is emitted (noEmit)
        let anchor String("post-emit")
        let host Page.get(anchor.get_buffer())
        let eo EmitOptions.parse(host, Slice[char](options_text.get_length() as int, options_text.get_buffer() as pointer[char]))
        if EmitOptions.on(eo.no_emit) = false
        {
            Console.println("==== TSCALY-FILE TSCALY-POST")
            run_case_emit(options_text, text, chain, true, true)
        }
        return 0
    }
    if flag.starts_with("--emit=")
    {
        ; a case bundle (slice 248) or one unit
        if text.starts_with("==== TSCALY-FILE ")
            return run_case_emit(flag.substring(7 as size_t, (flag.get_length() - 7) as size_t), text, chain, false, false)
        return run_unit_emit(flag.substring(7 as size_t, (flag.get_length() - 7) as size_t), arg, text, chain)
    }

    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())

    let cwd_cap 4096
    let cwd_buf host.allocate(cwd_cap as size_t, 1) as pointer[char]
    if getcwd(cwd_buf, cwd_cap as size_t) = null
    {
        Console.println("cannot read the working directory")
        return 1
    }
    var cwd_len 0
    while (*(cwd_buf + cwd_len) as int) <> 0
        set cwd_len: cwd_len + 1

    var name_data Slice[char]()
    set name_data: TsPath.normalized_absolute_path(host, Slice[char](arg.get_length() as int, arg.get_buffer() as pointer[char]), Slice[char](cwd_len, cwd_buf))
    let path String(name_data.data as pointer[const_char], name_data.length as size_t)

    ; ── 1. tokens ────────────────────────────────────────────────────────────
    TokenDump.write(host, text, Parser.script_kind_is_jsx_variant(path))

    ; ── the parse, once, for the four that need it ────────────────────────────
    var unported 0 - 1
    var unported_tag: Slice[char] ""
    var unported_detail 0
    let script_kind Parser.supported_script_kind(path)
    let p Parser.parse_ex(host, path, text, script_kind, &unported, &unported_tag, &unported_detail)

    if unported >= 0
    {
        fill(1, String("UNPORTED `unported` `Parser.tag_text(unported_tag)` `unported_detail`"))
        return 0
    }

    let file Parser.source_file_of(p)
    if file = null
    {
        fill(1, String("UNPORTED 0 no-tree 0"))
        return 0
    }

    ; ── 2. ast — BEFORE the bind, which mutates flags ────────────────────────
    sep("ast")
    AstDump.write(host, file)

    ; ── 3. jsdoc — after ast, because a .ts file's JSDoc is parsed on demand ──
    sep("jsdoc")
    JsDocDump.write(host, p, file)

    ; ── 4. symbols ───────────────────────────────────────────────────────────
    sep("symbols")
    let is_external Parser.external_module_indicator(file, AstNode.statements_of(file))
    let b Binder.bind_source_file(host, file, text, path, is_external)
    if Binder.unported_at(b) >= 0
    {
        let m String("UNPORTED `Binder.unported_at(b)` `Parser.tag_text(Binder.unported_tag_at(b))` `Binder.unported_detail_at(b)`")
        Console.println(m.to_c_string())
        sep("flow")
        Console.println(m.to_c_string())
        sep("types")
        Console.println(m.to_c_string())
        sep("emit")
        Console.println(m.to_c_string())
        return 0
    }
    SymbolDump.write(host, b, file)

    ; ── 5. flow — the same bind, read a second way (slice 92) ────────────────
    ;
    ; ★ It shares the BIND with the symbols section rather than re-binding, which
    ; is the whole argument of this file applied once more: a flow graph is a
    ; product of the bind, and a second bind would be a second graph that happens
    ; to be equal.
    sep("flow")
    FlowDump.write(host, file)

    ; ── the LIB, the second file of the program (slice 113) ─────────────────
    ;
    ; Loaded once, for tscaly_types' reason: the three Checkers below would
    ; otherwise each parse and bind the same 4 599 lines.
    var lib_file: ref[AstNode]? null
    var lib_b: ref[Binder]? null
    if Checker.load_lib(host, &lib_file, &lib_b) = false
    {
        sep("types")
        Console.println("UNPORTED 0 lib 0")
        Console.println("==== TSCALY-SECTION diags")
        Console.println("UNPORTED 0 lib 0")
        Console.println("==== TSCALY-SECTION dump")
        Console.println("UNPORTED 0 lib 0")
        sep("emit")
        Console.println("UNPORTED 0 lib 0")
        return 0
    }

    ; ── 6. types, itself in three sections, exactly as --sections ────────────
    sep("types")
    let cw Checker.create(host, file, path, b, p, lib_file, lib_b)
    TypeDump.write_walk(host, cw, file)
    Console.println("==== TSCALY-SECTION diags")
    let cd Checker.create(host, file, path, b, p, lib_file, lib_b)
    cd.get_diagnostics()
    TypeDump.write_diags(host, cd, file)
    Console.println("==== TSCALY-SECTION dump")
    let cs Checker.create(host, file, path, b, p, lib_file, lib_b)
    cs.get_diagnostics()
    if TypeDump.write(host, cs, file) = false
    {
        let m String("UNPORTED `Checker.unported_at(cs)` `Parser.tag_text(Checker.unported_tag_at(cs))` `Checker.unported_detail_at(cs)`")
        Console.println(m.to_c_string())
    }
    ; ── the emit yardstick (slice 229) ──
    ;
    ; The seventh section: the JavaScript the emitter writes for the unit under the
    ; default options, against the reference's own `Program.Emit` (tests/oracle/
    ; batch.go, dumpEmit). Since slice 236 the driver (`Emitter.emit_js`) runs the
    ; ported transformers and the printer; a transformer this port has not ported
    ; is a SAID stop the driver scans for (`transform-<name>`), and the printer's
    ; own stops ride the same channel — the column the emitter chapter counts
    ; down, exactly as the checker's did.
    sep("emit")
    ; ★ A file behind a byte order mark is read DECODED by the compiler host
    ; (Emitter.decode_bytes) and RAW by the six oracles, so the emit alone runs
    ; on the decoded text: a second parse, bind and check of that text, whose
    ; positions are the decoded file's. Seven UTF-16 files and one UTF-8-marked
    ; one in the stage-2 corpus; everything else takes the tree above as is.
    ; ★ The emit runs on `cd`, the checker whose diagnostics are already printed,
    ; never on `cs`: the import-elision walk (markLinkedReferencesRecursively)
    ; RESOLVES names the check never resolved and REPORTS while doing so, and the
    ; types dump asks getSymbolAtLocation of every node, which MARKS aliases the
    ; check alone never marks (a three-part name in a heritage clause kept its
    ; namespace import). The reference checks, collects the diagnostics, then
    ; emits — `cd` after write_diags is exactly that state (§3.5jj).
    var emit_file: ref[AstNode] file as ref[AstNode]
    var emit_b b
    var emit_cs cd
    var emit_text text
    var emit_external is_external
    let decoded StringBuilder^host()
    let raw_view Slice[char](text.get_length() as int, text.get_buffer() as pointer[char])
    if Emitter.decode_bytes(raw_view, &decoded)
    {
        set emit_text: decoded.to_string()
        var unported2 0 - 1
        var unported_tag2: Slice[char] ""
        var unported_detail2 0
        let p2 Parser.parse_ex(host, path, emit_text, script_kind, &unported2, &unported_tag2, &unported_detail2)
        let file2 Parser.source_file_of(p2)
        if (unported2 >= 0) or (file2 = null)
        {
            Console.println("UNPORTED 0 decoded-parse 0")
            return 0
        }
        set emit_file: file2 as ref[AstNode]
        set emit_external: Parser.external_module_indicator(emit_file, AstNode.statements_of(emit_file))
        set emit_b: Binder.bind_source_file(host, emit_file, emit_text, path, emit_external)
        let cs2 Checker.create(host, emit_file, path, emit_b, p2, lib_file, lib_b)
        cs2.get_diagnostics()
        set emit_cs: cs2
    }
    let identifiers &Array[Slice[char]]^host()
    Emitter.collect_identifiers(host, emit_file, identifiers)
    let text_view Slice[char](emit_text.get_length() as int, emit_text.get_buffer() as pointer[char])
    let path_view Slice[char](path.get_length() as int, path.get_buffer() as pointer[char])
    let emit_options EmitOptions.defaults()
    let info &SourceFileInfo^host(emit_file, path_view, text_view, Printer.compute_ecma_line_starts(host, text_view), emit_b.is_declaration_file_of(), script_kind, emit_external or Emitter.is_file_forced_to_be_module_by_format(path_view, emit_options), identifiers, false)
    let em Emitter.create(host)
    let js StringBuilder^host()
    em.emit_js(emit_file, info, emit_options, emit_cs, emit_b, &js)
    if em.unported_count = 0
    {
        ; length-bearing: a NUL inside a string literal is part of the answer,
        ; and a C-string print would stop at it
        let out js.to_string()
        Io.write_all(1, out.get_buffer() as pointer[void], out.get_length())
    }
    else
    {
        let m String("UNPORTED `em.unported_count` `Parser.tag_text(em.unported_tag)` `em.unported_detail`")
        Console.println(m.to_c_string())
    }
    0
}

; ★★★ `--batch <units file>` — EVERY UNIT OF A CORPUS IN ONE PROCESS (2026-09-02).
; The runner used to start this program once per unit (18 435 times at stage 2) and
; write each answer to its own file. In batch mode it reads ONE file of framed units,
;
;     ==== TSCALY-UNIT <bytes> <path>\n<content>\n      (repeated)
;
; and answers each on stdout between `==== TSCALY-UNIT <path>` and `==== TSCALY-END`,
; so a supervisor can tell a finished unit from the one a crash or a hang was in.
; ★Each unit runs in `run_unit_at`'s OWN frame — path, content and everything the
; port allocates live on that call's region and go with it — and the port keeps no
; mutable globals, so nothing of one unit is visible to the next; the symbol-id
; counter that DOES shape output lives in the Binder, which is fresh per unit. The
; reference side needs an explicit reset for the same reason (tests/oracle/batch.go).
; Measured on landing: byte-identical to the per-process answers over the whole
; stage-1 tree. Console writes are unbuffered syscalls, so a crash loses nothing.
procedure run_unit_at(mutable flag: String, mutable text: String, path_start: int, path_len: int, body_start: int, body_len: int, mutable chain: ref[LibChain]?)
{
    reset_symbol_ids()
    let path text.substring(path_start as size_t, path_len as size_t)
    let content text.substring(body_start as size_t, body_len as size_t)
    let hdr String("==== TSCALY-UNIT `path`")
    Console.println(hdr.to_c_string())
    run_unit(flag, path, content, chain)
    Console.println("==== TSCALY-END")
}

; the whole of standard input: `--batch -` takes the units through a pipe, so a
; batch touches no file (the endpoint protection scans every file a run writes)
procedure read_stdin_to_string() returns String
{
    var sb StringBuilder()
    var buf u8[65536]
    repeat
    {
        let n read(0, &buf[0] as pointer[void], 65536)
        if n = 0
            break
        ; read(2) answers -1 on an error, which a size_t holds as a huge count
        if n > 65536
            break
        sb.append(&buf[0] as pointer[char], n)
    }
    sb.to_string()
}

procedure run_batch(mutable flag: String, mutable units_path: String) returns int
{
    var text String()
    if units_path.equals(String("-"))
        set text: read_stdin_to_string()
    else
    {
        if File.exists(units_path) = false
        {
            let m String("cannot read `units_path`")
            Console.println(m.to_c_string())
            return 1
        }
        set text: File.read_to_string(units_path)
    }
    ; the emit's lib chain, loaded ONCE for the batch (one option string per batch)
    ; on this frame's page — the lib symbols are never mutated by a unit (mergeSymbol
    ; clones a non-transient target), so every unit may borrow them
    var chain: ref[LibChain]? null
    var options_start 0
    if flag.starts_with("--emit=")
        set options_start: 7
    if flag.starts_with("--errors=")
        set options_start: 9
    if options_start > 0
    {
        let anchor String("lib-chain")
        let host Page.get(anchor.get_buffer())
        let emit_options EmitOptions.parse(host, Slice[char]((flag.get_length() as int) - options_start, (flag.get_buffer() as pointer[char]) + options_start))
        let files &Array[ref[AstNode]?]^host()
        let binders &Array[ref[Binder]?]^host()
        let seen &Array[Slice[char]]^host()
        if Checker.load_lib_chain(host, emit_options.lib_names(host), files, binders, seen)
            set chain: &LibChain^host(files, binders)
    }
    let n text.get_length() as int
    var pos 0
    while pos < n
    {
        let eol text.index_of(10 as u8, pos as size_t)
        if eol < 0
        {
            Console.println("==== TSCALY-BATCH-ERROR unterminated header")
            return 3
        }
        var p pos + 17
        var bytes 0
        while (text.get(p as size_t) as int) <> 32
        {
            set bytes: bytes * 10 + ((text.get(p as size_t) as int) - 48)
            set p: p + 1
        }
        let path_start p + 1
        let path_len eol - path_start
        let body_start eol + 1
        run_unit_at(flag, text, path_start, path_len, body_start, bytes, chain)
        set pos: body_start + bytes + 1
    }
    0
}

procedure main(argc: int, argv: pointer[pointer[char]]) returns int
{
    var flag String("")
    var batch String("")
    var path String("")
    var i 1
    var bad false
    while i < argc
    {
        let a String(*(argv + i))
        var handled false
        if a.equals(String("--batch"))
        {
            set handled: true
            if i + 1 >= argc
                set bad: true
            if i + 1 < argc
            {
                set batch: String(*(argv + i + 1))
                set i: i + 1
            }
        }
        if handled = false
        {
            if a.starts_with("--")
            {
                if flag.get_length() > 0
                    set bad: true
                set flag: a
                set handled: true
            }
        }
        if handled = false
        {
            if path.get_length() > 0
                set bad: true
            set path: a
        }
        set i: i + 1
    }
    if batch.get_length() > 0
    {
        if path.get_length() > 0
            set bad: true
    }
    if batch.get_length() = 0
    {
        if path.get_length() = 0
            set bad: true
    }
    if flag.get_length() > 0
    {
        if (flag.starts_with("--emit=") = false) and (flag.starts_with("--tsconfig=") = false) and (flag.starts_with("--errors=") = false)
            set bad: true
    }
    if bad
    {
        print "usage: tscaly_dump [--emit=<options>] (<file> | --batch <units file>)"
        return 2
    }
    if batch.get_length() > 0
        return run_batch(flag, batch)
    if File.exists(path) = false
    {
        let m String("cannot read `path`")
        Console.println(m.to_c_string())
        return 1
    }
    let text File.read_to_string(path)
    run_unit(flag, path, text, null)
}
