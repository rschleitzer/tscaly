; SPDX-License-Identifier: Apache-2.0
;
; tscaly_dump — all FIVE artifacts of one unit, in one process.
;
; ★★★ WHY IT EXISTS, and the number is the whole argument. Measured over 17 900
; units, ten-wide: `/usr/bin/true` costs **16.3 s**, `tscaly_tokens` (a scan)
; 24.3 s, `tscaly_ast` (+ a parse) 26.6 s, `tscaly_symbols` (+ a bind) 27.6 s and
; `tscaly_types --sections` (+ three checkers) 28.0 s. So **58 % of the heaviest
; dumper is pure process creation** — the scan is 8.0 s of it, the parse 2.3 s, the
; bind 1.0 s and the three checkers 0.4 s. Five processes per unit therefore pay
; the 16.3 s five times and repeat the same scan, parse and bind four times over.
; One process pays it once.
;
; ★★★ AND IT IS NOT THE "BATCH DUMPER" TESTPLAN REFUSES. That refusal is about
; sharing process state ACROSS UNITS, where one unit's arena, caches and globals
; would reach the next; this shares one PARSE across the five artifacts OF ONE
; UNIT, which is the same thing `tscaly_types --sections` already does across its
; three checkers. Every unit still gets a fresh process, a fresh arena and a fresh
; everything.
;
; ★★★ WHAT THE SHARING RISKS, said plainly because it is the reason this file has a
; whole-corpus gate rather than an argument: **the BINDER MUTATES THE TREE** — flags
; and symbol slots — and the ast dump prints flags. So the order is tokens, ast,
; jsdoc, symbols, types, which is `ARTIFACTS` order in compare.py and puts every
; pre-bind dump in front of the bind. The jsdoc walk triggers a `.ts` file's LAZY
; JSDoc parse, which is why it stands after ast and not before. Neither of those is
; reasoned to be safe: `TSCALY_NO_COMBINED=1` runs the five programs instead, and
; the two were compared over every unit of both corpora, all five sections, before
; this became the default.
;
; ★★ THE PATH IS NORMALIZED ONCE AND SERVES ALL FIVE, where the five programs
; disagreed: tokens, ast and jsdoc took the raw argument and symbols and types the
; normalized one. tscaly_symbols' own header says why that was harmless — the two
; questions a parse asks of a name (is this a declaration file, which script kind)
; are asked of the LAST COMPONENT alone, so the two spellings cannot be told apart
; — and the bind is the one place the spelling shows, in an external module's symbol
; name. Normalizing for all five is therefore the strictly more correct of the two,
; and the corpus comparison is what says so rather than that paragraph.
;
; ★ ONE STREAM. Every line goes through `Console`, never through the prelude's
; `print`: the two are different streams to the same fd (stdio's buffer against a
; raw write) and mixing them reorders the output — see tscaly_types.scaly, where
; that cost 97 units of 1 123.

package scaly 0.1.0
package tscaly 0.1.0

use scaly.memory.Page
use scaly.io.File
use scaly.io.Console
use scaly.fiber.Io
use scaly.containers.String
use tscaly.ast.AstNode
use tscaly.tspath.TsPath
use tscaly.parser.Parser
use tscaly.binder.Binder
use tscaly.checker.Checker
use tscaly.printer.SourceFileInfo
use tscaly.printer.Printer
use tscaly.emitter.Emitter
use tscaly.emitter.EmitOptions
use scaly.containers.Array
use scaly.containers.StringBuilder
use tscaly.TokenDump.TokenDump
use tscaly.AstDump.AstDump
use tscaly.JsDocDump.JsDocDump
use tscaly.SymbolDump.SymbolDump
use tscaly.FlowDump.FlowDump
use tscaly.TypeDump.TypeDump

function getcwd(buf: pointer[char], size: size_t) returns pointer[char] extern

; The five artifact separators. `tscaly_types`' own two — `==== TSCALY-SECTION
; diags|dump` — nest inside the last one, so the two prefixes must differ.
procedure sep(name: Slice[char])
{
    Console.print("==== TSCALY-DUMP ")
    write(1, name.data as pointer[void], name.length)
    Console.println("")
}

; An unported report is MODE-INDEPENDENT: every one of the five programs prints the
; same line and returns. So one line becomes each remaining section, which is
; exactly what those programs would each have printed.
procedure fill(from: int, message: String)
{
    var i from
    while i < 7
    {
        if i = 1
            sep("ast")
        if i = 2
            sep("jsdoc")
        if i = 3
            sep("symbols")
        if i = 4
            sep("flow")
        if i = 5
            sep("types")
        if i = 6
            sep("emit")
        Console.println(message.to_c_string())
        set i: i + 1
    }
}

; ★★★ `--emit=<options>` — THE DRIVER CHAPTER'S ANSWER (slice 243): the JavaScript
; alone, under the options of one test configuration (`name=value;...`, the names
; lower-cased), against the reference's own `.js` baseline per CASE
; (tests/casejs.py). Nothing but the emit is printed; a stop is the same
; `UNPORTED n tag d` line the emit section prints.
function run_unit_emit(options_text: String, arg: String, text: String) returns int
{
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())
    let cwd_cap 4096
    let cwd_buf host.allocate(cwd_cap as size_t, 1) as pointer[char]
    if getcwd(cwd_buf, cwd_cap as size_t) = null
    {
        Console.println("UNPORTED 0 cwd 0")
        return 1
    }
    var cwd_len 0
    while (*(cwd_buf + cwd_len) as int) <> 0
        set cwd_len: cwd_len + 1
    var name_data Slice[char]()
    set name_data: TsPath.normalized_absolute_path(host, Slice[char](arg.get_length() as int, arg.get_buffer() as pointer[char]), Slice[char](cwd_len, cwd_buf))
    let path String(name_data.data as pointer[const_char], name_data.length as size_t)
    let script_kind Parser.supported_script_kind(path)
    let emit_options EmitOptions.parse(host, Slice[char](options_text.get_length() as int, options_text.get_buffer() as pointer[char]))
    ; the emit runs on the DECODED text (a byte order mark, UTF-16)
    var emit_text text
    let decoded StringBuilder^host()
    let raw_view Slice[char](text.get_length() as int, text.get_buffer() as pointer[char])
    if Emitter.decode_bytes(raw_view, &decoded)
        set emit_text: decoded.to_string()
    var unported 0 - 1
    var unported_tag: Slice[char] ""
    var unported_detail 0
    let p Parser.parse_ex(host, path, emit_text, script_kind, &unported, &unported_tag, &unported_detail)
    if unported >= 0
    {
        let m String("UNPORTED `unported` `Parser.tag_text(unported_tag)` `unported_detail`")
        Console.println(m.to_c_string())
        return 0
    }
    let file_opt Parser.source_file_of(p)
    if file_opt = null
    {
        Console.println("UNPORTED 0 no-tree 0")
        return 0
    }
    let file file_opt as ref[AstNode]
    ; moduleDetection auto: a JSX file the automatic runtime rewrites is a module
    ; (the binder and the emit both read it so)
    let is_external Parser.external_module_indicator(file, AstNode.statements_of(file)) or Emitter.is_file_module_from_using_jsx_tag(file, script_kind, emit_options)
    let b Binder.bind_source_file(host, file, emit_text, path, is_external)
    if Binder.unported_at(b) >= 0
    {
        let m String("UNPORTED `Binder.unported_at(b)` `Parser.tag_text(Binder.unported_tag_at(b))` `Binder.unported_detail_at(b)`")
        Console.println(m.to_c_string())
        return 0
    }
    var lib_file: ref[AstNode]? null
    var lib_b: ref[Binder]? null
    if Checker.load_lib(host, &lib_file, &lib_b) = false
    {
        Console.println("UNPORTED 0 lib 0")
        return 0
    }
    let cd Checker.create(host, file, path, b, p, lib_file, lib_b)
    ; the checker reads the configuration too (the resolver's answers depend on it)
    set cd.module_kind: emit_options.get_emit_module_kind()
    set cd.language_version: emit_options.get_emit_script_target()
    set cd.legacy_decorators: EmitOptions.on(emit_options.experimental_decorators)
    set cd.emit_decorator_metadata: EmitOptions.on(emit_options.emit_decorator_metadata)
    set cd.verbatim_module_syntax: EmitOptions.on(emit_options.verbatim_module_syntax)
    set cd.isolated_modules: EmitOptions.on(emit_options.isolated_modules)
    set cd.preserve_const_enums: EmitOptions.on(emit_options.preserve_const_enums)
    ; the harness roots a batch unit at `/.src/<unit>`; the emit reads the file name
    let path_view Emitter.harness_file_name(host, Slice[char](path.get_length() as int, path.get_buffer() as pointer[char]))
    set cd.emit_module_format: emit_options.get_emit_module_format_of_file(path_view)
    cd.get_diagnostics()
    let identifiers &Array[Slice[char]]^host()
    Emitter.collect_identifiers(host, file, identifiers)
    let text_view Slice[char](emit_text.get_length() as int, emit_text.get_buffer() as pointer[char])
    var forced false
    if b.is_declaration_file_of() = false
        set forced: Emitter.is_file_forced_to_be_module_by_format(path_view, emit_options)
    let info &SourceFileInfo^host(file, path_view, text_view, Printer.compute_ecma_line_starts(host, text_view), b.is_declaration_file_of(), script_kind, is_external or forced, identifiers)
    let em Emitter.create(host)
    let js StringBuilder^host()
    em.emit_js(file, info, emit_options, cd, b, &js)
    if em.unported_count = 0
    {
        let out js.to_string()
        Io.write_all(1, out.get_buffer() as pointer[void], out.get_length())
    }
    else
    {
        let m String("UNPORTED `em.unported_count` `Parser.tag_text(em.unported_tag)` `em.unported_detail`")
        Console.println(m.to_c_string())
    }
    0
}

function run_unit(flag: String, arg: String, text: String) returns int
{
    if flag.starts_with("--emit=")
        return run_unit_emit(flag.substring(7 as size_t, (flag.get_length() - 7) as size_t), arg, text)

    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())

    let cwd_cap 4096
    let cwd_buf host.allocate(cwd_cap as size_t, 1) as pointer[char]
    if getcwd(cwd_buf, cwd_cap as size_t) = null
    {
        Console.println("cannot read the working directory")
        return 1
    }
    var cwd_len 0
    while (*(cwd_buf + cwd_len) as int) <> 0
        set cwd_len: cwd_len + 1

    var name_data Slice[char]()
    set name_data: TsPath.normalized_absolute_path(host, Slice[char](arg.get_length() as int, arg.get_buffer() as pointer[char]), Slice[char](cwd_len, cwd_buf))
    let path String(name_data.data as pointer[const_char], name_data.length as size_t)

    ; ── 1. tokens ────────────────────────────────────────────────────────────
    TokenDump.write(host, text, Parser.script_kind_is_jsx_variant(path))

    ; ── the parse, once, for the four that need it ────────────────────────────
    var unported 0 - 1
    var unported_tag: Slice[char] ""
    var unported_detail 0
    let script_kind Parser.supported_script_kind(path)
    let p Parser.parse_ex(host, path, text, script_kind, &unported, &unported_tag, &unported_detail)

    if unported >= 0
    {
        fill(1, String("UNPORTED `unported` `Parser.tag_text(unported_tag)` `unported_detail`"))
        return 0
    }

    let file Parser.source_file_of(p)
    if file = null
    {
        fill(1, String("UNPORTED 0 no-tree 0"))
        return 0
    }

    ; ── 2. ast — BEFORE the bind, which mutates flags ────────────────────────
    sep("ast")
    AstDump.write(host, file)

    ; ── 3. jsdoc — after ast, because a .ts file's JSDoc is parsed on demand ──
    sep("jsdoc")
    JsDocDump.write(host, p, file)

    ; ── 4. symbols ───────────────────────────────────────────────────────────
    sep("symbols")
    let is_external Parser.external_module_indicator(file, AstNode.statements_of(file))
    let b Binder.bind_source_file(host, file, text, path, is_external)
    if Binder.unported_at(b) >= 0
    {
        let m String("UNPORTED `Binder.unported_at(b)` `Parser.tag_text(Binder.unported_tag_at(b))` `Binder.unported_detail_at(b)`")
        Console.println(m.to_c_string())
        sep("flow")
        Console.println(m.to_c_string())
        sep("types")
        Console.println(m.to_c_string())
        sep("emit")
        Console.println(m.to_c_string())
        return 0
    }
    SymbolDump.write(host, b, file)

    ; ── 5. flow — the same bind, read a second way (slice 92) ────────────────
    ;
    ; ★ It shares the BIND with the symbols section rather than re-binding, which
    ; is the whole argument of this file applied once more: a flow graph is a
    ; product of the bind, and a second bind would be a second graph that happens
    ; to be equal.
    sep("flow")
    FlowDump.write(host, file)

    ; ── the LIB, the second file of the program (slice 113) ─────────────────
    ;
    ; Loaded once, for tscaly_types' reason: the three Checkers below would
    ; otherwise each parse and bind the same 4 599 lines.
    var lib_file: ref[AstNode]? null
    var lib_b: ref[Binder]? null
    if Checker.load_lib(host, &lib_file, &lib_b) = false
    {
        sep("types")
        Console.println("UNPORTED 0 lib 0")
        Console.println("==== TSCALY-SECTION diags")
        Console.println("UNPORTED 0 lib 0")
        Console.println("==== TSCALY-SECTION dump")
        Console.println("UNPORTED 0 lib 0")
        sep("emit")
        Console.println("UNPORTED 0 lib 0")
        return 0
    }

    ; ── 6. types, itself in three sections, exactly as --sections ────────────
    sep("types")
    let cw Checker.create(host, file, path, b, p, lib_file, lib_b)
    TypeDump.write_walk(host, cw, file)
    Console.println("==== TSCALY-SECTION diags")
    let cd Checker.create(host, file, path, b, p, lib_file, lib_b)
    cd.get_diagnostics()
    TypeDump.write_diags(host, cd, file)
    Console.println("==== TSCALY-SECTION dump")
    let cs Checker.create(host, file, path, b, p, lib_file, lib_b)
    cs.get_diagnostics()
    if TypeDump.write(host, cs, file) = false
    {
        let m String("UNPORTED `Checker.unported_at(cs)` `Parser.tag_text(Checker.unported_tag_at(cs))` `Checker.unported_detail_at(cs)`")
        Console.println(m.to_c_string())
    }
    ; ── the emit yardstick (slice 229) ──
    ;
    ; The seventh section: the JavaScript the emitter writes for the unit under the
    ; default options, against the reference's own `Program.Emit` (tests/oracle/
    ; batch.go, dumpEmit). Since slice 236 the driver (`Emitter.emit_js`) runs the
    ; ported transformers and the printer; a transformer this port has not ported
    ; is a SAID stop the driver scans for (`transform-<name>`), and the printer's
    ; own stops ride the same channel — the column the emitter chapter counts
    ; down, exactly as the checker's did.
    sep("emit")
    ; ★ A file behind a byte order mark is read DECODED by the compiler host
    ; (Emitter.decode_bytes) and RAW by the six oracles, so the emit alone runs
    ; on the decoded text: a second parse, bind and check of that text, whose
    ; positions are the decoded file's. Seven UTF-16 files and one UTF-8-marked
    ; one in the stage-2 corpus; everything else takes the tree above as is.
    ; ★ The emit runs on `cd`, the checker whose diagnostics are already printed,
    ; never on `cs`: the import-elision walk (markLinkedReferencesRecursively)
    ; RESOLVES names the check never resolved and REPORTS while doing so, and the
    ; types dump asks getSymbolAtLocation of every node, which MARKS aliases the
    ; check alone never marks (a three-part name in a heritage clause kept its
    ; namespace import). The reference checks, collects the diagnostics, then
    ; emits — `cd` after write_diags is exactly that state (§3.5jj).
    var emit_file: ref[AstNode] file as ref[AstNode]
    var emit_b b
    var emit_cs cd
    var emit_text text
    var emit_external is_external
    let decoded StringBuilder^host()
    let raw_view Slice[char](text.get_length() as int, text.get_buffer() as pointer[char])
    if Emitter.decode_bytes(raw_view, &decoded)
    {
        set emit_text: decoded.to_string()
        var unported2 0 - 1
        var unported_tag2: Slice[char] ""
        var unported_detail2 0
        let p2 Parser.parse_ex(host, path, emit_text, script_kind, &unported2, &unported_tag2, &unported_detail2)
        let file2 Parser.source_file_of(p2)
        if (unported2 >= 0) or (file2 = null)
        {
            Console.println("UNPORTED 0 decoded-parse 0")
            return 0
        }
        set emit_file: file2 as ref[AstNode]
        set emit_external: Parser.external_module_indicator(emit_file, AstNode.statements_of(emit_file))
        set emit_b: Binder.bind_source_file(host, emit_file, emit_text, path, emit_external)
        let cs2 Checker.create(host, emit_file, path, emit_b, p2, lib_file, lib_b)
        cs2.get_diagnostics()
        set emit_cs: cs2
    }
    let identifiers &Array[Slice[char]]^host()
    Emitter.collect_identifiers(host, emit_file, identifiers)
    let text_view Slice[char](emit_text.get_length() as int, emit_text.get_buffer() as pointer[char])
    let path_view Slice[char](path.get_length() as int, path.get_buffer() as pointer[char])
    let emit_options EmitOptions.defaults()
    let info &SourceFileInfo^host(emit_file, path_view, text_view, Printer.compute_ecma_line_starts(host, text_view), emit_b.is_declaration_file_of(), script_kind, emit_external or Emitter.is_file_forced_to_be_module_by_format(path_view, emit_options), identifiers)
    let em Emitter.create(host)
    let js StringBuilder^host()
    em.emit_js(emit_file, info, emit_options, emit_cs, emit_b, &js)
    if em.unported_count = 0
    {
        ; length-bearing: a NUL inside a string literal is part of the answer,
        ; and a C-string print would stop at it
        let out js.to_string()
        Io.write_all(1, out.get_buffer() as pointer[void], out.get_length())
    }
    else
    {
        let m String("UNPORTED `em.unported_count` `Parser.tag_text(em.unported_tag)` `em.unported_detail`")
        Console.println(m.to_c_string())
    }
    0
}

; ★★★ `--batch <units file>` — EVERY UNIT OF A CORPUS IN ONE PROCESS (2026-09-02).
; The runner used to start this program once per unit (18 435 times at stage 2) and
; write each answer to its own file. In batch mode it reads ONE file of framed units,
;
;     ==== TSCALY-UNIT <bytes> <path>\n<content>\n      (repeated)
;
; and answers each on stdout between `==== TSCALY-UNIT <path>` and `==== TSCALY-END`,
; so a supervisor can tell a finished unit from the one a crash or a hang was in.
; ★Each unit runs in `run_unit_at`'s OWN frame — path, content and everything the
; port allocates live on that call's region and go with it — and the port keeps no
; mutable globals, so nothing of one unit is visible to the next; the symbol-id
; counter that DOES shape output lives in the Binder, which is fresh per unit. The
; reference side needs an explicit reset for the same reason (tests/oracle/batch.go).
; Measured on landing: byte-identical to the per-process answers over the whole
; stage-1 tree. Console writes are unbuffered syscalls, so a crash loses nothing.
procedure run_unit_at(flag: String, text: String, path_start: int, path_len: int, body_start: int, body_len: int)
{
    let path text.substring(path_start as size_t, path_len as size_t)
    let content text.substring(body_start as size_t, body_len as size_t)
    let hdr String("==== TSCALY-UNIT `path`")
    Console.println(hdr.to_c_string())
    run_unit(flag, path, content)
    Console.println("==== TSCALY-END")
}

procedure run_batch(flag: String, units_path: String) returns int
{
    if File.exists(units_path) = false
    {
        let m String("cannot read `units_path`")
        Console.println(m.to_c_string())
        return 1
    }
    let text File.read_to_string(units_path)
    let n text.get_length() as int
    var pos 0
    while pos < n
    {
        let eol text.index_of(10 as u8, pos as size_t)
        if eol < 0
        {
            Console.println("==== TSCALY-BATCH-ERROR unterminated header")
            return 3
        }
        var p pos + 17
        var bytes 0
        while (text.get(p as size_t) as int) <> 32
        {
            set bytes: bytes * 10 + ((text.get(p as size_t) as int) - 48)
            set p: p + 1
        }
        let path_start p + 1
        let path_len eol - path_start
        let body_start eol + 1
        run_unit_at(flag, text, path_start, path_len, body_start, bytes)
        set pos: body_start + bytes + 1
    }
    0
}

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    var flag String("")
    var batch String("")
    var path String("")
    var i 1
    var bad false
    while i < argc
    {
        let a String(*(argv + i))
        var handled false
        if a.equals(String("--batch"))
        {
            set handled: true
            if i + 1 >= argc
                set bad: true
            if i + 1 < argc
            {
                set batch: String(*(argv + i + 1))
                set i: i + 1
            }
        }
        if handled = false
        {
            if a.starts_with("--")
            {
                if flag.get_length() > 0
                    set bad: true
                set flag: a
                set handled: true
            }
        }
        if handled = false
        {
            if path.get_length() > 0
                set bad: true
            set path: a
        }
        set i: i + 1
    }
    if batch.get_length() > 0
    {
        if path.get_length() > 0
            set bad: true
    }
    if batch.get_length() = 0
    {
        if path.get_length() = 0
            set bad: true
    }
    if flag.get_length() > 0
    {
        if flag.starts_with("--emit=") = false
            set bad: true
    }
    if bad
    {
        print "usage: tscaly_dump [--emit=<options>] (<file> | --batch <units file>)"
        return 2
    }
    if batch.get_length() > 0
        return run_batch(flag, batch)
    if File.exists(path) = false
    {
        let m String("cannot read `path`")
        Console.println(m.to_c_string())
        return 1
    }
    let text File.read_to_string(path)
    run_unit(flag, path, text)
}
