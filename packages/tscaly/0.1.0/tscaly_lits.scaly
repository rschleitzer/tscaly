; SPDX-License-Identifier: Apache-2.0
;
; tscaly_lits — our half of the LITERAL TYPE NAME cross-check (slice 71).
;
; Reads a corpus of `<tag> <hex bytes>` lines and prints one composed name per
; line. tests/oracle/lits.go is the other producer and tests/litcheck.sh runs
; both over the same file.
;
; Why it is a program of its own rather than a case in the five yardsticks: the
; checker yardstick's T section cannot carry a literal type's name at all until
; getTypeOfNode's expression arm is ported — see tscaly/LitCheck.scaly, which
; carries the whole argument.
;
; The work lives in the package; this is three steps and no logic of its own.

package scaly 0.1.0
package tscaly 0.1.0

use scaly.memory.Page
use scaly.io.File
use scaly.containers.String
use tscaly.LitCheck.LitCheck

procedure main(argc: int, mutable argv: pointer[pointer[char]]) returns int
{
    if argc <> 2
    {
        print "usage: tscaly_lits <corpus>"
        return 2
    }

    let path String(*(argv + 1))
    if File.exists(path) = false
    {
        print "cannot read `path`"
        return 1
    }

    let text File.read_to_string(path)

    ; The run region and its SMALL anchor: the corpus text is one oversized
    ; allocation, and Page.get() of an address inside one answers a page whose
    ; first allocation trips the oversized-page trap (§3.12).
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())

    LitCheck.run(host, text)
    0
}
