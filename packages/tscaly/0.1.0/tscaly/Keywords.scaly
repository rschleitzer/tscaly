        if kw_eq(buf, Slice[char](6, "typeof"))
            return KindTypeOfKeyword
        if kw_eq(buf, Slice[char](6, "unique"))
            return KindUniqueKeyword
    }

    if len = 7
    {
        if kw_eq(buf, Slice[char](7, "asserts"))
            return KindAssertsKeyword
        if kw_eq(buf, Slice[char](7, "boolean"))
            return KindBooleanKeyword
        if kw_eq(buf, Slice[char](7, "declare"))
            return KindDeclareKeyword
        if kw_eq(buf, Slice[char](7, "default"))
