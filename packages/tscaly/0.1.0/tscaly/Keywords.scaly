;
; Keywords — the reference's textToKeyword map plus its
; GetIdentifierToken guard (internal/scanner/scanner.go).
;
; GENERATED by packages/tscaly/tools/genkeywords.py. Do not edit; edit the
; generator. Regenerate after a submodule pin bump.
;
; The reference guards its map lookup with
;   len(str) >= 2 && len(str) <= 12 && str[0] >= 'a' && str[0] <= 'z'
; and every keyword satisfies it, so the guard is an optimization, not a
; rule — it is ported as one. Behind it: dispatch on length, then compare
; bytes. No String is constructed, so scanning an identifier allocates
; nothing at all.
;
; ★ The bounds below are DERIVED from the table (2..11); the reference writes
; the upper one as a literal 12. That is not a behavioural deviation — the
; guard's only requirement is that it exclude no keyword, and both bounds
; satisfy it, so the two agree on every input. Deriving it makes that
; property true by construction instead of true by coincidence: a pin bump
; that introduces a longer keyword regenerates a correct bound, where a
; transcribed literal would silently start rejecting it.

use scaly.containers.String

; True when the len bytes at buf equal the ASCII literal `word`.
; Callers have already established that len equals the word's length, so
; this compares bytes only.
function kw_eq(buf: pointer[char], word: pointer[const_char], len: int) returns bool
{
    var i: int 0
    while i < len
    {
        if (*(buf + i) as int) <> (*(word + i) as int)
            return false
        set i: i + 1
    }
    true
}

; GetIdentifierToken — the Kind for an already-scanned identifier: its
; keyword Kind if it is one, KindIdentifier otherwise.
function get_identifier_token(buf: pointer[char], len: int) returns int
{
    ; The reference's guard, ported verbatim.
    if len < 2
        return KindIdentifier
    if len > 11
        return KindIdentifier
    let c0 *buf as int
    if c0 < ("a" as char) as int
        return KindIdentifier
    if c0 > ("z" as char) as int
        return KindIdentifier

    if len = 2
    {
        if kw_eq(buf, "as", 2)
            return KindAsKeyword
        if kw_eq(buf, "do", 2)
            return KindDoKeyword
        if kw_eq(buf, "if", 2)
            return KindIfKeyword
        if kw_eq(buf, "in", 2)
            return KindInKeyword
        if kw_eq(buf, "is", 2)
            return KindIsKeyword
        if kw_eq(buf, "of", 2)
            return KindOfKeyword
    }

    if len = 3
    {
        if kw_eq(buf, "any", 3)
            return KindAnyKeyword
        if kw_eq(buf, "for", 3)
            return KindForKeyword
        if kw_eq(buf, "get", 3)
            return KindGetKeyword
        if kw_eq(buf, "let", 3)
            return KindLetKeyword
        if kw_eq(buf, "new", 3)
            return KindNewKeyword
        if kw_eq(buf, "out", 3)
            return KindOutKeyword
        if kw_eq(buf, "set", 3)
            return KindSetKeyword
        if kw_eq(buf, "try", 3)
            return KindTryKeyword
        if kw_eq(buf, "var", 3)
            return KindVarKeyword
    }

    if len = 4
    {
        if kw_eq(buf, "case", 4)
            return KindCaseKeyword
        if kw_eq(buf, "else", 4)
            return KindElseKeyword
        if kw_eq(buf, "enum", 4)
            return KindEnumKeyword
        if kw_eq(buf, "from", 4)
            return KindFromKeyword
        if kw_eq(buf, "null", 4)
            return KindNullKeyword
        if kw_eq(buf, "this", 4)
            return KindThisKeyword
        if kw_eq(buf, "true", 4)
            return KindTrueKeyword
        if kw_eq(buf, "type", 4)
            return KindTypeKeyword
        if kw_eq(buf, "void", 4)
            return KindVoidKeyword
        if kw_eq(buf, "with", 4)
            return KindWithKeyword
    }

    if len = 5
    {
        if kw_eq(buf, "async", 5)
            return KindAsyncKeyword
        if kw_eq(buf, "await", 5)
            return KindAwaitKeyword
        if kw_eq(buf, "break", 5)
            return KindBreakKeyword
        if kw_eq(buf, "catch", 5)
            return KindCatchKeyword
        if kw_eq(buf, "class", 5)
            return KindClassKeyword
        if kw_eq(buf, "const", 5)
            return KindConstKeyword
        if kw_eq(buf, "defer", 5)
            return KindDeferKeyword
        if kw_eq(buf, "false", 5)
            return KindFalseKeyword
        if kw_eq(buf, "infer", 5)
            return KindInferKeyword
        if kw_eq(buf, "keyof", 5)
            return KindKeyOfKeyword
        if kw_eq(buf, "never", 5)
            return KindNeverKeyword
        if kw_eq(buf, "super", 5)
            return KindSuperKeyword
        if kw_eq(buf, "throw", 5)
            return KindThrowKeyword
        if kw_eq(buf, "using", 5)
            return KindUsingKeyword
        if kw_eq(buf, "while", 5)
            return KindWhileKeyword
        if kw_eq(buf, "yield", 5)
            return KindYieldKeyword
    }

    if len = 6
    {
        if kw_eq(buf, "assert", 6)
            return KindAssertKeyword
        if kw_eq(buf, "bigint", 6)
            return KindBigIntKeyword
        if kw_eq(buf, "delete", 6)
            return KindDeleteKeyword
        if kw_eq(buf, "export", 6)
            return KindExportKeyword
        if kw_eq(buf, "global", 6)
            return KindGlobalKeyword
        if kw_eq(buf, "import", 6)
            return KindImportKeyword
        if kw_eq(buf, "module", 6)
            return KindModuleKeyword
        if kw_eq(buf, "number", 6)
            return KindNumberKeyword
        if kw_eq(buf, "object", 6)
            return KindObjectKeyword
        if kw_eq(buf, "public", 6)
            return KindPublicKeyword
        if kw_eq(buf, "return", 6)
            return KindReturnKeyword
        if kw_eq(buf, "static", 6)
            return KindStaticKeyword
        if kw_eq(buf, "string", 6)
            return KindStringKeyword
        if kw_eq(buf, "switch", 6)
            return KindSwitchKeyword
        if kw_eq(buf, "symbol", 6)
            return KindSymbolKeyword
        if kw_eq(buf, "typeof", 6)
            return KindTypeOfKeyword
        if kw_eq(buf, "unique", 6)
            return KindUniqueKeyword
    }

    if len = 7
    {
        if kw_eq(buf, "asserts", 7)
            return KindAssertsKeyword
        if kw_eq(buf, "boolean", 7)
            return KindBooleanKeyword
        if kw_eq(buf, "declare", 7)
            return KindDeclareKeyword
        if kw_eq(buf, "default", 7)
            return KindDefaultKeyword
        if kw_eq(buf, "extends", 7)
            return KindExtendsKeyword
        if kw_eq(buf, "finally", 7)
            return KindFinallyKeyword
        if kw_eq(buf, "package", 7)
            return KindPackageKeyword
        if kw_eq(buf, "private", 7)
            return KindPrivateKeyword
        if kw_eq(buf, "require", 7)
            return KindRequireKeyword
        if kw_eq(buf, "unknown", 7)
            return KindUnknownKeyword
    }

    if len = 8
    {
        if kw_eq(buf, "abstract", 8)
            return KindAbstractKeyword
        if kw_eq(buf, "accessor", 8)
            return KindAccessorKeyword
        if kw_eq(buf, "continue", 8)
            return KindContinueKeyword
        if kw_eq(buf, "debugger", 8)
            return KindDebuggerKeyword
        if kw_eq(buf, "function", 8)
            return KindFunctionKeyword
        if kw_eq(buf, "override", 8)
            return KindOverrideKeyword
        if kw_eq(buf, "readonly", 8)
            return KindReadonlyKeyword
    }

    if len = 9
    {
        if kw_eq(buf, "immediate", 9)
            return KindImmediateKeyword
        if kw_eq(buf, "interface", 9)
            return KindInterfaceKeyword
        if kw_eq(buf, "intrinsic", 9)
            return KindIntrinsicKeyword
        if kw_eq(buf, "namespace", 9)
            return KindNamespaceKeyword
        if kw_eq(buf, "protected", 9)
            return KindProtectedKeyword
        if kw_eq(buf, "satisfies", 9)
            return KindSatisfiesKeyword
        if kw_eq(buf, "undefined", 9)
            return KindUndefinedKeyword
    }

    if len = 10
    {
        if kw_eq(buf, "implements", 10)
            return KindImplementsKeyword
        if kw_eq(buf, "instanceof", 10)
            return KindInstanceOfKeyword
    }

    if len = 11
    {
        if kw_eq(buf, "constructor", 11)
            return KindConstructorKeyword
    }

    KindIdentifier
}
