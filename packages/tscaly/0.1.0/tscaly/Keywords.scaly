;
; Keywords — the reference's textToKeyword map plus its
; GetIdentifierToken guard (internal/scanner/scanner.go).
;
; GENERATED by packages/tscaly/tools/genkeywords.py. Do not edit; edit the
; generator. Regenerate after a submodule pin bump.
;
; The reference guards its map lookup with
;   len(str) >= 2 && len(str) <= 12 && str[0] >= 'a' && str[0] <= 'z'
; and every keyword satisfies it, so the guard is an optimization, not a
; rule — it is ported as one. Behind it: dispatch on length, then compare
; bytes. No String is constructed, so scanning an identifier allocates
; nothing at all.
;
; ★ The bounds below are DERIVED from the table (2..11); the reference writes
; the upper one as a literal 12. That is not a behavioural deviation — the
; guard's only requirement is that it exclude no keyword, and both bounds
; satisfy it, so the two agree on every input. Deriving it makes that
; property true by construction instead of true by coincidence: a pin bump
; that introduces a longer keyword regenerates a correct bound, where a
; transcribed literal would silently start rejecting it.

use scaly.containers.String

; True when the bytes at buf equal the ASCII literal `word`.
; Callers have already established that the scanned length equals
; the word's length, so this compares bytes only.
function kw_eq(buf: pointer[char], word: Slice[char]) returns bool
{
    var i: int 0
    while i < word.length
    {
        if (*(buf + i) as int) <> (word[i] as int)
            return false
        set i: i + 1
    }
    true
}

; GetIdentifierToken — the Kind for an already-scanned identifier: its
; keyword Kind if it is one, KindIdentifier otherwise.
function get_identifier_token(buf: pointer[char], len: int) returns int
{
    ; The reference's guard, ported verbatim.
    if len < 2
        return KindIdentifier
    if len > 11
        return KindIdentifier
    let c0 *buf as int
    if c0 < ("a" as char) as int
        return KindIdentifier
    if c0 > ("z" as char) as int
        return KindIdentifier

    if len = 2
    {
        if kw_eq(buf, Slice[char](2, "as"))
            return KindAsKeyword
        if kw_eq(buf, Slice[char](2, "do"))
            return KindDoKeyword
        if kw_eq(buf, Slice[char](2, "if"))
            return KindIfKeyword
        if kw_eq(buf, Slice[char](2, "in"))
            return KindInKeyword
        if kw_eq(buf, Slice[char](2, "is"))
            return KindIsKeyword
        if kw_eq(buf, Slice[char](2, "of"))
            return KindOfKeyword
    }

    if len = 3
    {
        if kw_eq(buf, Slice[char](3, "any"))
            return KindAnyKeyword
        if kw_eq(buf, Slice[char](3, "for"))
            return KindForKeyword
        if kw_eq(buf, Slice[char](3, "get"))
            return KindGetKeyword
        if kw_eq(buf, Slice[char](3, "let"))
            return KindLetKeyword
        if kw_eq(buf, Slice[char](3, "new"))
            return KindNewKeyword
        if kw_eq(buf, Slice[char](3, "out"))
            return KindOutKeyword
        if kw_eq(buf, Slice[char](3, "set"))
            return KindSetKeyword
        if kw_eq(buf, Slice[char](3, "try"))
            return KindTryKeyword
        if kw_eq(buf, Slice[char](3, "var"))
            return KindVarKeyword
    }

    if len = 4
    {
        if kw_eq(buf, Slice[char](4, "case"))
            return KindCaseKeyword
        if kw_eq(buf, Slice[char](4, "else"))
            return KindElseKeyword
        if kw_eq(buf, Slice[char](4, "enum"))
            return KindEnumKeyword
        if kw_eq(buf, Slice[char](4, "from"))
            return KindFromKeyword
        if kw_eq(buf, Slice[char](4, "null"))
            return KindNullKeyword
        if kw_eq(buf, Slice[char](4, "this"))
            return KindThisKeyword
        if kw_eq(buf, Slice[char](4, "true"))
            return KindTrueKeyword
        if kw_eq(buf, Slice[char](4, "type"))
            return KindTypeKeyword
        if kw_eq(buf, Slice[char](4, "void"))
            return KindVoidKeyword
        if kw_eq(buf, Slice[char](4, "with"))
            return KindWithKeyword
    }

    if len = 5
    {
        if kw_eq(buf, Slice[char](5, "async"))
            return KindAsyncKeyword
        if kw_eq(buf, Slice[char](5, "await"))
            return KindAwaitKeyword
        if kw_eq(buf, Slice[char](5, "break"))
            return KindBreakKeyword
        if kw_eq(buf, Slice[char](5, "catch"))
            return KindCatchKeyword
        if kw_eq(buf, Slice[char](5, "class"))
            return KindClassKeyword
        if kw_eq(buf, Slice[char](5, "const"))
            return KindConstKeyword
        if kw_eq(buf, Slice[char](5, "defer"))
            return KindDeferKeyword
        if kw_eq(buf, Slice[char](5, "false"))
            return KindFalseKeyword
        if kw_eq(buf, Slice[char](5, "infer"))
            return KindInferKeyword
        if kw_eq(buf, Slice[char](5, "keyof"))
            return KindKeyOfKeyword
        if kw_eq(buf, Slice[char](5, "never"))
            return KindNeverKeyword
        if kw_eq(buf, Slice[char](5, "super"))
            return KindSuperKeyword
        if kw_eq(buf, Slice[char](5, "throw"))
            return KindThrowKeyword
        if kw_eq(buf, Slice[char](5, "using"))
            return KindUsingKeyword
        if kw_eq(buf, Slice[char](5, "while"))
            return KindWhileKeyword
        if kw_eq(buf, Slice[char](5, "yield"))
            return KindYieldKeyword
    }

    if len = 6
    {
        if kw_eq(buf, Slice[char](6, "assert"))
            return KindAssertKeyword
        if kw_eq(buf, Slice[char](6, "bigint"))
            return KindBigIntKeyword
        if kw_eq(buf, Slice[char](6, "delete"))
            return KindDeleteKeyword
        if kw_eq(buf, Slice[char](6, "export"))
            return KindExportKeyword
        if kw_eq(buf, Slice[char](6, "global"))
            return KindGlobalKeyword
        if kw_eq(buf, Slice[char](6, "import"))
            return KindImportKeyword
        if kw_eq(buf, Slice[char](6, "module"))
            return KindModuleKeyword
        if kw_eq(buf, Slice[char](6, "number"))
            return KindNumberKeyword
        if kw_eq(buf, Slice[char](6, "object"))
