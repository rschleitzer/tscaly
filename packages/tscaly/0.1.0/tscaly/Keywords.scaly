        if kw_eq(buf, Slice[char](9, "satisfies"))
            return KindSatisfiesKeyword
        if kw_eq(buf, Slice[char](9, "undefined"))
            return KindUndefinedKeyword
    }

    if len = 10
    {
        if kw_eq(buf, Slice[char](10, "implements"))
            return KindImplementsKeyword
        if kw_eq(buf, Slice[char](10, "instanceof"))
            return KindInstanceOfKeyword
    }

    if len = 11
    {
        if kw_eq(buf, Slice[char](11, "constructor"))
            return KindConstructorKeyword
    }

    KindIdentifier
}

