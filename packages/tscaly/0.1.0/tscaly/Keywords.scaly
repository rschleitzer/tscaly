        if kw_eq(buf, Slice[const_char]("static", 6))
            return KindStaticKeyword
        if kw_eq(buf, Slice[const_char]("string", 6))
            return KindStringKeyword
        if kw_eq(buf, Slice[const_char]("switch", 6))
            return KindSwitchKeyword
        if kw_eq(buf, Slice[const_char]("symbol", 6))
            return KindSymbolKeyword
        if kw_eq(buf, Slice[const_char]("typeof", 6))
            return KindTypeOfKeyword
        if kw_eq(buf, Slice[const_char]("unique", 6))
            return KindUniqueKeyword
    }

    if len = 7
    {
        if kw_eq(buf, Slice[const_char]("asserts", 7))
            return KindAssertsKeyword
        if kw_eq(buf, Slice[const_char]("boolean", 7))
            return KindBooleanKeyword
        if kw_eq(buf, Slice[const_char]("declare", 7))
            return KindDeclareKeyword
        if kw_eq(buf, Slice[const_char]("default", 7))
            return KindDefaultKeyword
        if kw_eq(buf, Slice[const_char]("extends", 7))
            return KindExtendsKeyword
        if kw_eq(buf, Slice[const_char]("finally", 7))
            return KindFinallyKeyword
        if kw_eq(buf, Slice[const_char]("package", 7))
            return KindPackageKeyword
        if kw_eq(buf, Slice[const_char]("private", 7))
            return KindPrivateKeyword
        if kw_eq(buf, Slice[const_char]("require", 7))
            return KindRequireKeyword
        if kw_eq(buf, Slice[const_char]("unknown", 7))
            return KindUnknownKeyword
    }

    if len = 8
    {
        if kw_eq(buf, Slice[const_char]("abstract", 8))
            return KindAbstractKeyword
        if kw_eq(buf, Slice[const_char]("accessor", 8))
            return KindAccessorKeyword
        if kw_eq(buf, Slice[const_char]("continue", 8))
            return KindContinueKeyword
        if kw_eq(buf, Slice[const_char]("debugger", 8))
            return KindDebuggerKeyword
        if kw_eq(buf, Slice[const_char]("function", 8))
            return KindFunctionKeyword
        if kw_eq(buf, Slice[const_char]("override", 8))
            return KindOverrideKeyword
        if kw_eq(buf, Slice[const_char]("readonly", 8))
            return KindReadonlyKeyword
    }

    if len = 9
    {
        if kw_eq(buf, Slice[const_char]("immediate", 9))
            return KindImmediateKeyword
        if kw_eq(buf, Slice[const_char]("interface", 9))
            return KindInterfaceKeyword
        if kw_eq(buf, Slice[const_char]("intrinsic", 9))
            return KindIntrinsicKeyword
        if kw_eq(buf, Slice[const_char]("namespace", 9))
            return KindNamespaceKeyword
        if kw_eq(buf, Slice[const_char]("protected", 9))
            return KindProtectedKeyword
        if kw_eq(buf, Slice[const_char]("satisfies", 9))
            return KindSatisfiesKeyword
        if kw_eq(buf, Slice[const_char]("undefined", 9))
            return KindUndefinedKeyword
    }

    if len = 10
    {
        if kw_eq(buf, Slice[const_char]("implements", 10))
            return KindImplementsKeyword
        if kw_eq(buf, Slice[const_char]("instanceof", 10))
            return KindInstanceOfKeyword
    }

    if len = 11
    {
        if kw_eq(buf, Slice[const_char]("constructor", 11))
            return KindConstructorKeyword
    }

    KindIdentifier
}

