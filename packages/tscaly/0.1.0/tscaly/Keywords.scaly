        if kw_eq(buf, Slice[char](7, "package"))
            return KindPackageKeyword
        if kw_eq(buf, Slice[char](7, "private"))
            return KindPrivateKeyword
        if kw_eq(buf, Slice[char](7, "require"))
            return KindRequireKeyword
        if kw_eq(buf, Slice[char](7, "unknown"))
            return KindUnknownKeyword
    }

    if len = 8
    {
        if kw_eq(buf, Slice[char](8, "abstract"))
            return KindAbstractKeyword
        if kw_eq(buf, Slice[char](8, "accessor"))
            return KindAccessorKeyword
        if kw_eq(buf, Slice[char](8, "continue"))
            return KindContinueKeyword
        if kw_eq(buf, Slice[char](8, "debugger"))
            return KindDebuggerKeyword
        if kw_eq(buf, Slice[char](8, "function"))
            return KindFunctionKeyword
        if kw_eq(buf, Slice[char](8, "override"))
            return KindOverrideKeyword
        if kw_eq(buf, Slice[char](8, "readonly"))
            return KindReadonlyKeyword
    }

    if len = 9
    {
        if kw_eq(buf, Slice[char](9, "immediate"))
            return KindImmediateKeyword
        if kw_eq(buf, Slice[char](9, "interface"))
            return KindInterfaceKeyword
        if kw_eq(buf, Slice[char](9, "intrinsic"))
            return KindIntrinsicKeyword
        if kw_eq(buf, Slice[char](9, "namespace"))
