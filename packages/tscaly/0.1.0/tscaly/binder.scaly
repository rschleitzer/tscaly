; SPDX-License-Identifier: Apache-2.0
;
; binder — the symbol half of the reference's internal/binder/binder.go.
;
; ── What this module is FOR, and what a slice of it is ──────────────────────
;
; The binder walks the parsed tree, decides which nodes are DECLARATIONS, makes a
; Symbol for each and files it in a table — the enclosing container's `locals`, or
; the container symbol's `members` or `exports` — merging declarations that share
; a name and reporting a diagnostic where they may not merge. Its output is what
; the fourth yardstick compares (tests/oracle/symbols.go, TESTPLAN.md's *The
; fourth yardstick*), and it is compared as SYMBOL IDENTITY rather than as shape:
; two `var x` are one symbol with two declarations, and a port that made two
; symbols would produce the identical picture at every node.
;
; ── What is NOT ported, and why each omission is a decision ─────────────────
;
; ★★★ THE FLOW GRAPH IS NOT PORTED AT ALL. The reference builds one in the same
; pass — a FlowNode on every reachable node, labels, antecedents, the
; reachability and HasImplicitReturn node flags — and NONE of it is reachable
; through an exported accessor, so the symbols dump cannot see it and neither can
; any dump this suite has. Its reader is the checker. What the flow half DOES
; decide and this port must therefore keep is the TRAVERSAL ORDER: `bindChildren`
; routes a dozen statement and expression kinds through flow-shaped helpers, and
; two of them visit children in an order ForEachChild does not — bindParameterFlow
; binds a parameter's NAME last, after its type and initializer, and
; bindBindingElementFlow does the same. The order decides the order symbols are
; created in and therefore the order DIAGNOSTICS come out in, both of which are
; compared. So every arm this slice ports either reproduces the reference's order
; or says, at its own line, why ForEachChild's order is the same one.
;
; ★★ AND WHAT IS NOT PORTED IS REPORTED. A kind the reference's `bind` switch or
; `bindChildren` switch has an arm for and this slice does not stops the bind and
; records `unported` with the KIND as its detail — the same mechanism the parser
; uses, and the same reason: an incomplete port that answered a well-formed dump
; would be reporting agreement it has not earned. tests/triage.py groups the
; column by tag, so the histogram names the arm that unlocks the most units next.
;
; ── The slice line ──────────────────────────────────────────────────────────
;
; Slice 27 ports the SKELETON and the arms a file of variables and functions is
; made of: the container walk with its locals, declareSymbol with the duplicate
; diagnostics, the source file (including its module-ness), the variable
; declaration, the parameter, the function declaration and the type parameter.
; Everything else in either switch reports itself.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use tscaly.scanner.Scanner
use tscaly.ast.AstNode
use tscaly.ast.Symbol
use tscaly.ast.SymbolTable
use tscaly.Diagnostics.DiagnosticList

; ── ContainerFlags ──────────────────────────────────────────────────────────
;
; The reference's own enum, hand-ported: eleven bits, no composites, and the
; comments are upstream's because each one says what the bit COSTS at the call
; site (a container becomes the current container, a block-scoped container only
; the current block-scope, and only HasLocals gets a table).

define ContainerFlagsNone: int 0
define ContainerFlagsIsContainer: int 1 << 0
define ContainerFlagsIsBlockScopedContainer: int 1 << 1
define ContainerFlagsIsControlFlowContainer: int 1 << 2
define ContainerFlagsIsFunctionLike: int 1 << 3
define ContainerFlagsIsFunctionExpression: int 1 << 4
define ContainerFlagsHasLocals: int 1 << 5
define ContainerFlagsIsInterface: int 1 << 6
define ContainerFlagsIsObjectLiteralOrClassExpressionMethodOrAccessor: int 1 << 7
define ContainerFlagsIsThisContainer: int 1 << 8
define ContainerFlagsPropagatesThisKeyword: int 1 << 9

define Binder
(
    host: pointer[Page]

    ; The SourceFile node. The reference's `b.file` is the *ast.SourceFile; here
    ; every accessor takes the node, so the node is what is kept.
    file: pointer[AstNode]

    ; A SCANNER over the same source, and it is here for exactly one question:
    ; `SkipTrivia(text, pos)`, which every bind diagnostic's start position goes
    ; through (`GetErrorRangeForNode`). The reference's SkipTrivia is a free
    ; function over the text; this port's lives on the Scanner because the text
    ; does, so the binder holds one. It scans nothing.
    trivia: pointer[Scanner]

    ; `ast.IsExternalModule(b.file)`, computed ONCE at create because the reference
    ; computes it once too — its parser stores the indicator NODE on the SourceFile
    ; and IsExternalModule is a null test on it. This port answers the question
    ; instead of storing the node (§3.5q), so the answer is cached here rather than
    ; re-walked at every declaration.
    ;
    ; ★ `b.file.IsDeclarationFile` is NOT carried, and the reason is the rule this
    ; file's own header states from the other side: its only reader in binder.go is
    ; the emitFlags/HasAsyncFunctions bit, a SourceFile node flag that no dump here
    ; can see. A field nothing reads is only DECLARED (§3.5be), so the slice that
    ; makes that flag observable is the slice that adds it back.
    is_external_module: bool

    ; `len(b.file.Diagnostics()) == 0`, which guards the contextual-identifier
    ; check. The parse is over, so the count cannot move during the bind.
    file_has_no_parse_errors: bool

    ; The four container registers. `last_container` is the head of the
    ; reference's container CHAIN (addToContainerChain) — the chain's links are
    ; NextContainer fields this port does not carry, since the only reader is the
    ; checker's getLocalNameOfContainer, so what is kept is the register the chain
    ; is threaded through and nothing else.
    container: pointer[AstNode]
    this_container: pointer[AstNode]
    block_scope_container: pointer[AstNode]
    last_container: pointer[AstNode]

    ; `b.symbolCount`, and it is not len(symbols): it counts every newSymbol call,
    ; including the ones a conflict throws away, so it is a statement about the
    ; path taken. The dump compares it, which makes it a check on the path.
    symbol_count: int

    ; `b.classifiableNames`, a SET of names. A SymbolTable stands in for it — the
    ; entries carry a null symbol and only the key matters — because a second
    ; container type would buy nothing and the dump reads it as a sorted name list.
    classifiable_names: pointer[SymbolTable]

    ; `SetBindDiagnostics`: a THIRD list, which is why the yardstick has a section
    ; of its own for it. Appended RAW (add_direct), because the reference's
    ; addDiagnostic is a plain append with neither the parser's dedup nor its
    ; has_error flag.
    bind_diagnostics: pointer[DiagnosticList]

    ; The unported report, in the parser's shape: the first construct this slice
    ; does not implement stops the bind and names itself.
    unported_pos: int
    unported_tag: pointer[const_char]
    unported_detail: int
)
{
    ; ── entry ───────────────────────────────────────────────────────────────
    ;
    ; The reference's BindSourceFile/bindSourceFile pair, minus the pool and the
    ; once-guard: a Binder here is one object on the caller's page, used once.
    function bind_source_file(host: pointer[Page], file: pointer[AstNode], source: String, is_external_module: bool) returns pointer[Binder]
    {
        let b host.allocate(sizeof Binder, alignof Binder) as pointer[Binder]
        set b.host: host
        set b.file: file
        let sc host.allocate(sizeof Scanner, alignof Scanner) as pointer[Scanner]
        set *sc: Scanner(source)
        set b.trivia: sc
        set b.is_external_module: is_external_module
        set b.file_has_no_parse_errors: AstNode.diagnostic_count(file) = 0
        set b.container: null
        set b.this_container: null
        set b.block_scope_container: null
        set b.last_container: null
        set b.symbol_count: 0
        set b.classifiable_names: SymbolTable.create(host)
        let dl host.allocate(sizeof DiagnosticList, alignof DiagnosticList) as pointer[DiagnosticList]
        set *dl: DiagnosticList(host)
        set b.bind_diagnostics: dl
        set b.unported_pos: 0 - 1
        set b.unported_tag: null
        set b.unported_detail: 0

        b.bind(file)
        b
    }

    ; ── the unported report ─────────────────────────────────────────────────
    ;
    ; FIRST one wins and the bind stops walking: the same rule the parser's
    ; `unported` follows, for the same reason — a tree bound past a construct
    ; nobody implemented has meaningless tables after it, so reporting the second
    ; one would be reporting about a state the reference never reaches.
    procedure record_unported(this, tag: pointer[const_char], detail: int)
    {
        if unported_pos < 0
        {
            set unported_pos: 0
            set unported_tag: tag
            set unported_detail: detail
        }
    }

    function is_unported(this) returns bool
        unported_pos >= 0

    function unported_at(b: pointer[Binder]) returns int
        b.unported_pos

    function unported_tag_at(b: pointer[Binder]) returns pointer[const_char]
        b.unported_tag

    function unported_detail_at(b: pointer[Binder]) returns int
        b.unported_detail

    ; ── what the dumper reads ───────────────────────────────────────────────
    ;
    ; Statics over a pointer, for the reason ast.scaly's accessors are statics: a
    ; program root calling a cross-package free function with a concept-pointer
    ; parameter fails resolution, while a concept static resolves.

    function symbol_count_of(b: pointer[Binder]) returns int
        b.symbol_count

    function classifiable_count(b: pointer[Binder]) returns int
        SymbolTable.length(b.classifiable_names)

    function classifiable_name_data_at(b: pointer[Binder], i: int) returns pointer[char]
        SymbolTable.entry_name_data_at(b.classifiable_names, i)

    function classifiable_name_len_at(b: pointer[Binder], i: int) returns int
        SymbolTable.entry_name_len_at(b.classifiable_names, i)

    function diagnostic_count(b: pointer[Binder]) returns int
        b.bind_diagnostics.length()

    function diagnostic_at(b: pointer[Binder], i: int, out_pos: pointer[int], out_end: pointer[int], out_code: pointer[int]) returns bool
        b.bind_diagnostics.at(i, out_pos, out_end, out_code)

    ; ── diagnostics ─────────────────────────────────────────────────────────
    ;
    ; errorOnNode → createDiagnosticForNode → **GetErrorRangeForNode**, and the
    ; last step is not a detail: it is what makes a diagnostic point at the
    ; CONSTRUCT rather than at the whitespace before it.
    ;
    ; ★★★ Leaving it out was worth 31 units of corpus stage 2, in FOUR apparent
    ; classes (TS1212, TS1100, TS2300, TS1359) that were ONE cause — every start
    ; position was one byte early, because a node's `pos` is its FULL start,
    ; leading trivia included, and the reference skips that trivia before
    ; reporting. Four signatures, one fix: a histogram groups by symptom, and the
    ; count of causes is smaller (§3.5bi's lesson, one phase later).
    procedure error_on_node(this, n: pointer[AstNode], code: int)
    {
        if n = null
            return
        var start 0
        var stop 0
        if this.error_range_for_node(n, &start, &stop) = false
            return
        bind_diagnostics.add_direct(start, stop, code)
    }

    ; scanner.GetErrorRangeForNode. Answers false when it meets an arm this slice
    ; has not ported — every one of those needs to RE-SCAN the source at a position
    ; (GetRangeOfTokenAtPosition), which is a scanner call rather than a range
    ; computation, and each belongs to a construct whose bind arm is unported too.
    function error_range_for_node(this, n: pointer[AstNode], out_start: pointer[int], out_end: pointer[int]) returns bool
    {
        let k AstNode.kind_of(n)

        ; The arms that need a re-scan of the source. Reported rather than
        ; approximated: an approximated SPAN is a wrong answer that looks like a
        ; right one, which is the class §3.5bw records for is_in_top_level_context.
        if Binder.error_range_needs_rescan(k)
        {
            this.record_unported("error-range-rescan", k)
            return false
        }

        ; The declaration kinds report at their NAME. The list is the reference's,
        ; and the two Reparsed guards with it: a synthesized function or method has
        ; no name to point at, so it reports at itself.
        var error_node n
        if Binder.error_range_uses_declaration_name(k)
        {
            var reparsed false
            if (AstNode.flags_of(n) & NodeFlagsReparsed) <> 0
            {
                if k = KindFunctionDeclaration
                    set reparsed: true
                if k = KindMethodDeclaration
                    set reparsed: true
            }
            if reparsed = false
                set error_node: AstNode.name_of(n)
        }
        if k = KindClassExpression
            set error_node: AstNode.name_of(n)

        if error_node = null
        {
            ; `GetRangeOfTokenAtPosition(file, node.Pos())` — the re-scan again.
            this.record_unported("error-range-no-name", k)
            return false
        }

        var pos AstNode.pos_of(error_node)
        ; A MISSING node is zero-width, so there is no trivia in front of it to
        ; skip and skipping would move the span into the following token; JSX TEXT
        ; is trivia-free by construction.
        var skip true
        if Binder.node_is_missing(error_node)
            set skip: false
        if AstNode.kind_of(error_node) = KindJsxText
            set skip: false
        if skip
            set pos: trivia.skip_trivia_at(pos)
        set *out_start: pos
        set *out_end: AstNode.end_of(error_node)
        true
    }

    function error_range_needs_rescan(k: int) returns bool
    {
        if k = KindSourceFile
            return true
        if k = KindArrowFunction
            return true
        if k = KindCaseClause
            return true
        if k = KindDefaultClause
            return true
        if k = KindReturnStatement
            return true
        if k = KindYieldExpression
            return true
        if k = KindSatisfiesExpression
            return true
        if k = KindConstructor
            return true
        false
    }

    function error_range_uses_declaration_name(k: int) returns bool
    {
        if k = KindFunctionDeclaration
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindVariableDeclaration
            return true
        if k = KindBindingElement
            return true
        if k = KindClassDeclaration
            return true
        if k = KindInterfaceDeclaration
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindEnumDeclaration
            return true
        if k = KindEnumMember
            return true
        if k = KindFunctionExpression
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindPropertySignature
            return true
        if k = KindNamespaceImport
            return true
        false
    }

    ; ast.NodeIsMissing: a zero-width node that is not the end-of-file token.
    function node_is_missing(n: pointer[AstNode]) returns bool
    {
        if n = null
            return true
        if AstNode.kind_of(n) = KindEndOfFile
            return false
        if AstNode.pos_of(n) < 0
            return false
        AstNode.pos_of(n) = AstNode.end_of(n)
    }

    ; ── internal symbol names ───────────────────────────────────────────────
    ;
    ; The reference's InternalSymbolName* constants: the byte 0xFE — deliberately
    ; not valid UTF-8, so it cannot collide with identifier text — followed by an
    ; ASCII word. Built on the host rather than declared, because Scaly has no
    ; spelling for a string constant carrying that byte and because the name only
    ; has to compare EQUAL by bytes, never by pointer.
    function internal_name(host: pointer[Page], word: pointer[const_char], out_data: pointer[pointer[char]]) returns int
    {
        var n 0
        while *(word + n) <> (0 as char)
            set n: n + 1
        let buf host.allocate(((n + 1) as size_t), 1) as pointer[char]
        set *buf: 0xFE as char
        var i 0
        while i < n
        {
            set *(buf + 1 + i): *(word + i)
            set i: i + 1
        }
        set *out_data: buf
        n + 1
    }

    ; ── the walk ────────────────────────────────────────────────────────────
    ;
    ; bind(), and the arm set is this slice's. The kinds the reference handles and
    ; this slice does not report themselves rather than falling through silently:
    ; falling through would bind their CHILDREN into the right tables and leave the
    ; declaration itself out, which is a dump that differs by one line and a defect
    ; that looks like a missing symbol rather than like a missing arm.
    procedure bind(this, n: pointer[AstNode])
    {
        if n = null
            return
        if this.is_unported()
            return

        let k AstNode.kind_of(n)

        if k = KindIdentifier
            this.check_contextual_identifier(n)
        if k = KindSourceFile
            this.bind_source_file_if_external_module()
        if k = KindTypeParameter
            this.bind_type_parameter(n)
        if k = KindParameter
            this.bind_parameter(n)
        if k = KindVariableDeclaration
            this.bind_variable_declaration_or_binding_element(n)
        if k = KindFunctionDeclaration
            this.bind_function_declaration(n)

        ; Every other arm of the reference's switch, by kind. One `if` per kind
        ; rather than a table, because the tag is what the reader looks up against
        ; binder.go and a table would hide which arm is missing.
        if Binder.kind_has_unported_bind_arm(k)
        {
            this.record_unported("bind", k)
            return
        }

        if this.is_unported()
            return

        ; The recursion. `node.Kind > KindLastToken` is the reference's own
        ; optimisation and it is not cosmetic here either: a token has no children
        ; and asking GetContainerFlags of one would answer None anyway.
        if k > KindLastToken
        {
            let container_flags Binder.get_container_flags(n)
            if container_flags = ContainerFlagsNone
                this.bind_children(n)
            else
                this.bind_container(n, container_flags)
        }
    }

    ; The kinds the reference's `bind` switch has an arm for and this slice has
    ; not ported. Read off binder.go's switch, arm for arm; the six kinds above
    ; are the ones absent from this list.
    function kind_has_unported_bind_arm(k: int) returns bool
    {
        if k = KindThisKeyword
            return true
        if k = KindSuperKeyword
            return true
        if k = KindQualifiedName
            return true
        if k = KindMetaProperty
            return true
        if k = KindPrivateIdentifier
            return true
        if k = KindPropertyAccessExpression
            return true
        if k = KindElementAccessExpression
            return true
        if k = KindBinaryExpression
            return true
        if k = KindCatchClause
            return true
        if k = KindDeleteExpression
            return true
        if k = KindPostfixUnaryExpression
            return true
        if k = KindPrefixUnaryExpression
            return true
        if k = KindWithStatement
            return true
        if k = KindLabeledStatement
            return true
        if k = KindThisType
            return true
        if k = KindBindingElement
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindPropertySignature
            return true
        if k = KindPropertyAssignment
            return true
        if k = KindShorthandPropertyAssignment
            return true
        if k = KindEnumMember
            return true
        if k = KindCallSignature
            return true
        if k = KindConstructSignature
            return true
        if k = KindIndexSignature
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindConstructor
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindFunctionType
            return true
        if k = KindConstructorType
            return true
        if k = KindTypeLiteral
            return true
        if k = KindMappedType
            return true
        if k = KindObjectLiteralExpression
            return true
        if k = KindFunctionExpression
            return true
        if k = KindArrowFunction
            return true
        if k = KindClassExpression
            return true
        if k = KindClassDeclaration
            return true
        if k = KindInterfaceDeclaration
            return true
        if k = KindCallExpression
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        if k = KindEnumDeclaration
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindImportEqualsDeclaration
            return true
        if k = KindNamespaceImport
            return true
        if k = KindImportSpecifier
            return true
        if k = KindExportSpecifier
            return true
        if k = KindNamespaceExportDeclaration
            return true
        if k = KindImportClause
            return true
        if k = KindExportDeclaration
            return true
        if k = KindExportAssignment
            return true
        if k = KindJsxAttributes
            return true
        if k = KindJsxAttribute
            return true
        false
    }

    ; bindChildren. The flow half is not ported (see the header), so what is left
    ; is the TRAVERSAL, and every arm below either reproduces the reference's order
    ; or argues that ForEachChild's order is the same.
    procedure bind_children(this, n: pointer[AstNode])
    {
        let k AstNode.kind_of(n)

        ; bindEachStatementFunctionsFirst: the function declarations of the list
        ; first, then everything else. NOT ForEachChild's order, and it is
        ; observable — two `function f` and a `var f` between them file their
        ; declarations in a different sequence under the two orders.
        if k = KindSourceFile
        {
            this.bind_each_statement_functions_first(AstNode.statements_of(n))
            this.bind(AstNode.end_of_file_token_of(n))
            return
        }
        if k = KindBlock
        {
            this.bind_each_statement_functions_first(AstNode.statements_of(n))
            return
        }
        if k = KindModuleBlock
        {
            this.bind_each_statement_functions_first(AstNode.statements_of(n))
            return
        }

        ; bindParameterFlow, and this is the arm that makes the order question
        ; real: the reference binds the modifiers, the `...`, the `?`, the type,
        ; the initializer and THEN the name — ForEachChild visits the name third.
        if k = KindParameter
        {
            this.bind_each(AstNode.modifiers_of(n))
            this.bind(AstNode.dot_dot_dot_token_of(n))
            this.bind(AstNode.parameter_question_token_of(n))
            this.bind(AstNode.type_of(n))
            this.bind(AstNode.initializer_of(n))
            this.bind(AstNode.name_of(n))
            return
        }

        ; bindVariableDeclarationFlow is `bindEachChild` plus flow bookkeeping, and
        ; bindReturnStatement/bindThrowStatement/bindExpressionStatement are
        ; `bind(node.Expression())` plus flow — which for those three kinds is the
        ; whole child list, so the order is ForEachChild's by construction. Each is
        ; named here rather than left to the default arm, so that a reader looking
        ; for the reference's function finds the place it was answered.
        if k = KindVariableDeclaration
        {
            this.bind_each_child(n)
            return
        }
        if k = KindReturnStatement
        {
            this.bind_each_child(n)
            return
        }
        if k = KindThrowStatement
        {
            this.bind_each_child(n)
            return
        }
        if k = KindExpressionStatement
        {
            this.bind_each_child(n)
            return
        }

        if Binder.kind_has_unported_bind_children_arm(k)
        {
            this.record_unported("bind-children", k)
            return
        }

        this.bind_each_child(n)
    }

    ; The kinds bindChildren has an arm for and this slice has not ported. Each of
    ; them either changes the traversal ORDER or reports a diagnostic, so binding
    ; them through the default arm would be a guess.
    function kind_has_unported_bind_children_arm(k: int) returns bool
    {
        if k = KindWhileStatement
            return true
        if k = KindDoStatement
            return true
        if k = KindForStatement
            return true
        if k = KindForInStatement
            return true
        if k = KindForOfStatement
            return true
        if k = KindIfStatement
            return true
        if k = KindBreakStatement
            return true
        if k = KindContinueStatement
            return true
        if k = KindTryStatement
            return true
        if k = KindSwitchStatement
            return true
        if k = KindCaseBlock
            return true
        if k = KindCaseClause
            return true
        if k = KindDefaultClause
            return true
        if k = KindLabeledStatement
            return true
        if k = KindPrefixUnaryExpression
            return true
        if k = KindPostfixUnaryExpression
            return true
        if k = KindBinaryExpression
            return true
        if k = KindDeleteExpression
            return true
        if k = KindConditionalExpression
            return true
        if k = KindPropertyAccessExpression
            return true
        if k = KindElementAccessExpression
            return true
        if k = KindCallExpression
            return true
        if k = KindNonNullExpression
            return true
        if k = KindBindingElement
            return true
        if k = KindObjectLiteralExpression
            return true
        if k = KindArrayLiteralExpression
            return true
        if k = KindPropertyAssignment
            return true
        if k = KindSpreadElement
            return true
        false
    }

    procedure bind_each_child(this, n: pointer[AstNode])
    {
        var i 0
        while true
        {
            let c AstNode.child_at(n, i)
            if c = null
                return
            this.bind(c)
            if this.is_unported()
                return
            set i: i + 1
        }
    }

    procedure bind_each(this, list: pointer[Array[pointer[AstNode]]])
    {
        if list = null
            return
        let len list.get_length() as int
        var i 0
        while i < len
        {
            this.bind(*(list.get_buffer() + i))
            if this.is_unported()
                return
            set i: i + 1
        }
    }

    procedure bind_each_statement_functions_first(this, list: pointer[Array[pointer[AstNode]]])
    {
        if list = null
            return
        let len list.get_length() as int
        var i 0
        while i < len
        {
            let s *(list.get_buffer() + i)
            if AstNode.kind_of(s) = KindFunctionDeclaration
                this.bind(s)
            if this.is_unported()
                return
            set i: i + 1
        }
        var j 0
        while j < len
        {
            let s *(list.get_buffer() + j)
            if AstNode.kind_of(s) <> KindFunctionDeclaration
                this.bind(s)
            if this.is_unported()
                return
            set j: j + 1
        }
    }

    ; ── containers ──────────────────────────────────────────────────────────
    ;
    ; GetContainerFlags, whole. It is ported in full although this slice binds only
    ; a few kinds, because the flags decide the TABLE a declaration lands in and a
    ; narrowed version would answer None for a container this slice does bind
    ; through — the §3.5br class, where an accessor narrowed to its callers costs
    ; more the second time.
    ;
    ; ★ The Block arm reads node.PARENT, which is why Parent had to be ported with
    ; this slice: a block parented by a function-like node is not a scope of its
    ; own (the function already is one), and any other block is.
    function get_container_flags(n: pointer[AstNode]) returns int
    {
        let k AstNode.kind_of(n)
        if k = KindClassExpression
            return ContainerFlagsIsContainer
        if k = KindClassDeclaration
            return ContainerFlagsIsContainer
        if k = KindEnumDeclaration
            return ContainerFlagsIsContainer
        if k = KindObjectLiteralExpression
            return ContainerFlagsIsContainer
        if k = KindTypeLiteral
            return ContainerFlagsIsContainer
        if k = KindJsxAttributes
            return ContainerFlagsIsContainer
        if k = KindInterfaceDeclaration
            return ContainerFlagsIsContainer | ContainerFlagsIsInterface
        if k = KindModuleDeclaration
            return ContainerFlagsIsContainer | ContainerFlagsHasLocals
        if k = KindTypeAliasDeclaration
            return ContainerFlagsIsContainer | ContainerFlagsHasLocals
        if k = KindJSTypeAliasDeclaration
            return ContainerFlagsIsContainer | ContainerFlagsHasLocals
        if k = KindMappedType
            return ContainerFlagsIsContainer | ContainerFlagsHasLocals
        if k = KindIndexSignature
            return ContainerFlagsIsContainer | ContainerFlagsHasLocals
        if k = KindSourceFile
            return ContainerFlagsIsContainer | ContainerFlagsIsControlFlowContainer | ContainerFlagsHasLocals

        ; The three method-ish kinds, whose flags depend on where the method sits:
        ; a method of an object literal or of a class EXPRESSION carries two extra
        ; bits, and the reference reaches the shared arm by falling through.
        if k = KindGetAccessor
            return Binder.method_container_flags(n)
        if k = KindSetAccessor
            return Binder.method_container_flags(n)
        if k = KindMethodDeclaration
            return Binder.method_container_flags(n)

        if k = KindConstructor
            return Binder.function_like_container_flags()
        if k = KindFunctionDeclaration
            return Binder.function_like_container_flags()
        if k = KindClassStaticBlockDeclaration
            return Binder.function_like_container_flags()

        if k = KindMethodSignature
            return Binder.signature_container_flags()
        if k = KindCallSignature
            return Binder.signature_container_flags()
        if k = KindFunctionType
            return Binder.signature_container_flags()
        if k = KindConstructSignature
            return Binder.signature_container_flags()
        if k = KindConstructorType
            return Binder.signature_container_flags()

        if k = KindFunctionExpression
            return ContainerFlagsIsContainer | ContainerFlagsIsControlFlowContainer | ContainerFlagsHasLocals | ContainerFlagsIsFunctionLike | ContainerFlagsIsFunctionExpression | ContainerFlagsIsThisContainer
        if k = KindArrowFunction
            return ContainerFlagsIsContainer | ContainerFlagsIsControlFlowContainer | ContainerFlagsHasLocals | ContainerFlagsIsFunctionLike | ContainerFlagsIsFunctionExpression | ContainerFlagsPropagatesThisKeyword
        if k = KindModuleBlock
            return ContainerFlagsIsControlFlowContainer

        ; A property declaration is a control-flow container only when it has an
        ; initializer — there is nothing to flow through otherwise.
        if k = KindPropertyDeclaration
        {
            if AstNode.initializer_of(n) <> null
                return ContainerFlagsIsControlFlowContainer | ContainerFlagsIsThisContainer
            return ContainerFlagsNone
        }

        if k = KindCatchClause
            return ContainerFlagsIsBlockScopedContainer | ContainerFlagsHasLocals
        if k = KindForStatement
            return ContainerFlagsIsBlockScopedContainer | ContainerFlagsHasLocals
        if k = KindForInStatement
            return ContainerFlagsIsBlockScopedContainer | ContainerFlagsHasLocals
        if k = KindForOfStatement
            return ContainerFlagsIsBlockScopedContainer | ContainerFlagsHasLocals
        if k = KindCaseBlock
            return ContainerFlagsIsBlockScopedContainer | ContainerFlagsHasLocals

        ; ★ THE PARENT IS THE QUESTION HERE. A block whose parent is function-like
        ; (or a class static block) is not a scope: its function already is one, and
        ; giving the block locals of its own would put a `var` in the wrong table.
        if k = KindBlock
        {
            let p AstNode.parent_node_of(n)
            if p <> null
            {
                if AstNode.is_function_like(p)
                    return ContainerFlagsNone
                if AstNode.kind_of(p) = KindClassStaticBlockDeclaration
                    return ContainerFlagsNone
            }
            return ContainerFlagsIsBlockScopedContainer | ContainerFlagsHasLocals
        }

        ContainerFlagsNone
    }

    function function_like_container_flags() returns int
        ContainerFlagsIsContainer | ContainerFlagsIsControlFlowContainer | ContainerFlagsHasLocals | ContainerFlagsIsFunctionLike | ContainerFlagsIsThisContainer

    function signature_container_flags() returns int
        ContainerFlagsIsContainer | ContainerFlagsIsControlFlowContainer | ContainerFlagsHasLocals | ContainerFlagsIsFunctionLike | ContainerFlagsPropagatesThisKeyword

    function method_container_flags(n: pointer[AstNode]) returns int
    {
        if Binder.is_object_literal_or_class_expression_method_or_accessor(n)
            return ContainerFlagsIsContainer | ContainerFlagsIsControlFlowContainer | ContainerFlagsHasLocals | ContainerFlagsIsFunctionLike | ContainerFlagsIsObjectLiteralOrClassExpressionMethodOrAccessor | ContainerFlagsIsThisContainer
        Binder.function_like_container_flags()
    }

    ; ast.IsObjectLiteralOrClassExpressionMethodOrAccessor: a method or accessor
    ; whose PARENT is an object literal or a class expression.
    function is_object_literal_or_class_expression_method_or_accessor(n: pointer[AstNode]) returns bool
    {
        let k AstNode.kind_of(n)
        var is_member false
        if k = KindMethodDeclaration
            set is_member: true
        if k = KindGetAccessor
            set is_member: true
        if k = KindSetAccessor
            set is_member: true
        if is_member = false
            return false
        let p AstNode.parent_node_of(n)
        if p = null
            return false
        let pk AstNode.kind_of(p)
        if pk = KindObjectLiteralExpression
            return true
        if pk = KindClassExpression
            return true
        false
    }

    ; bindContainer, minus the flow half. What remains is the three registers, the
    ; container chain and the recursion — and the SAVE/RESTORE around it, which is
    ; the whole reason a container is a container.
    procedure bind_container(this, n: pointer[AstNode], container_flags: int)
    {
        let save_container container
        let save_this_container this_container
        let saved_block_scope_container block_scope_container

        if (container_flags & ContainerFlagsIsContainer) <> 0
        {
            set container: n
            set block_scope_container: n
            if (container_flags & ContainerFlagsHasLocals) <> 0
                this.add_to_container_chain(n)
        }
        else
        {
            if (container_flags & ContainerFlagsIsBlockScopedContainer) <> 0
            {
                set block_scope_container: n
                this.add_to_container_chain(n)
            }
        }
        if (container_flags & ContainerFlagsIsThisContainer) <> 0
            set this_container: n

        ; ★ THE LOCALS TABLE IS NOT CREATED HERE, and that is the reference's own
        ; arrangement rather than an omission: upstream's eager creation is
        ; commented out and every reader goes through ast.GetLocals, which makes the
        ; table on first use. It is observable — 754 of the 12 444 stage-2 files
        ; have no locals table at all — so it is ported as laziness.
        this.bind_children(n)

        ; ★ THE REFERENCE'S TAIL IS NOT PORTED, and here is why nothing can reach
        ; it: after bindChildren, bindContainer binds a JavaScript source file's
        ; top-level `@typedef` aliases (deferred so the CommonJS indicators are
        ; known first), declares `module` and `exports` when a CommonJS indicator
        ; was found, and calls bindCommonJSTypeExports for an external or ambient
        ; module. The indicator is set only by the JS expando arms, `@typedef`
        ; arrives as a KindJSTypeAliasDeclaration statement, and an ambient module
        ; is a ModuleDeclaration — all three arms are unported, and each is bound
        ; BEFORE this point, so the bind stops first. §3.5p: the argument expires
        ; with those arms, and the slice that ports one of them owns this tail.
        set container: save_container
        set this_container: save_this_container
        set block_scope_container: saved_block_scope_container
    }

    procedure add_to_container_chain(this, next: pointer[AstNode])
    {
        set last_container: next
    }

    ; ast.GetLocals: the container's own table, made on first use.
    function get_locals(host: pointer[Page], n: pointer[AstNode]) returns pointer[SymbolTable]
    {
        if n.locals = null
            set n.locals: SymbolTable.create(host)
        n.locals
    }

    ; ── the symbol machinery ────────────────────────────────────────────────

    ; newSymbol. The counter is the reference's and is compared by the dump.
    procedure new_symbol(this, flags: int, name_data: pointer[char], name_len: int) returns pointer[Symbol]
    {
        set symbol_count: symbol_count + 1
        Symbol.create(host, flags, name_data, name_len)
    }

    ; addDeclarationToSymbol. `AppendIfUnique` is the reference's own append: a
    ; node may reach here twice — a parameter property declares into two tables —
    ; and the declaration list must not carry it twice.
    procedure add_declaration_to_symbol(this, s: pointer[Symbol], n: pointer[AstNode], symbol_flags: int)
    {
        set s.flags: s.flags | symbol_flags
        set n.symbol: s
        if s.declarations = null
        {
            let a host.allocate(sizeof Array[pointer[AstNode]], alignof Array[pointer[AstNode]]) as pointer[Array[pointer[AstNode]]]
            set *a: Array[pointer[AstNode]]()
            a.add(n)
            set s.declarations: a
        }
        else
        {
            var found false
            let len s.declarations.get_length() as int
            var i 0
            while i < len
            {
                if *(s.declarations.get_buffer() + i) = n
                    set found: true
                set i: i + 1
            }
            if found = false
                s.declarations.add(n)
        }

        ; The const-enum-only reset needs the module machinery this slice does not
        ; have; it can only fire on a symbol that already carries
        ; ConstEnumOnlyModule, which only bindModuleDeclaration sets, and that arm
        ; is unported. Reported rather than skipped, so the claim expires with the
        ; arm (§3.5p).
        if (s.flags & SymbolFlagsConstEnumOnlyModule) <> 0
            this.record_unported("const-enum-only-module", 0)

        if (symbol_flags & SymbolFlagsValue) <> 0
            Binder.set_value_declaration(s, n)
    }

    ; SetValueDeclaration. The two overriding conditions both concern declarations
    ; this slice cannot produce — an ASSIGNMENT declaration (a JS `f.x = 1`) and an
    ; effective MODULE declaration — so what is ported is the first clause and the
    ; other two are named at their line.
    function set_value_declaration(s: pointer[Symbol], n: pointer[AstNode])
    {
        if s.value_declaration = null
            set s.value_declaration: n
    }

    ; declareSymbol / declareSymbolEx. The heart of the binder: find or make the
    ; symbol of this name in this table, report where the two declarations may not
    ; merge, and hand the node to it.
    procedure declare_symbol(this, table: pointer[SymbolTable], parent: pointer[Symbol], n: pointer[AstNode], includes: int, excludes: int) returns pointer[Symbol]
    {
        var name_data null as pointer[char]
        var name_len 0
        ; isDefaultExport upstream is `HasSyntacticModifier(node, Default) ||
        ; IsExportSpecifier(node) && ModuleExportNameIsDefault(...)`. The second
        ; disjunct is about an `export { x as default }`, and the ExportSpecifier arm
        ; is unported, so no call can reach here with one — the slice that binds it
        ; owns that half.
        let is_default_export this.has_syntactic_modifier(n, ModifierFlagsDefault)

        ; The reference asks for InternalSymbolNameDefault when a default export
        ; has a parent symbol, because the exported symbol of `export default
        ; function f` is named `default` rather than `f`.
        if is_default_export
        {
            if parent <> null
                set name_len: Binder.internal_name(host, "default", &name_data)
            else
                this.get_declaration_name(n, &name_data, &name_len)
        }
        else
            this.get_declaration_name(n, &name_data, &name_len)

        if this.is_unported()
            return null

        var s null as pointer[Symbol]
        var missing_data null as pointer[char]
        var missing_len 0
        set missing_len: Binder.internal_name(host, "missing", &missing_data)
        if SymbolTable.names_equal(name_data, name_len, missing_data, missing_len)
            set s: this.new_symbol(SymbolFlagsNone, missing_data, missing_len)
        else
        {
            set s: SymbolTable.get(table, name_data, name_len)
            if (includes & SymbolFlagsClassifiable) <> 0
                SymbolTable.set_entry(host, classifiable_names, name_data, name_len, null as pointer[Symbol])
            if s = null
            {
                set s: this.new_symbol(SymbolFlagsNone, name_data, name_len)
                SymbolTable.set_entry(host, table, name_data, name_len, s)
            }
            else
            {
                ; isReplaceableByMethod is a JavaScript constructor-property
                ; concern (`this.method = …` losing to a prototype method) and only
                ; declareSymbolEx's JS callers pass it; every call this slice makes
                ; passes false, so the two arms that read it cannot be reached.
                if (s.flags & excludes) <> 0
                {
                    if (s.flags & SymbolFlagsReplaceableByMethod) <> 0
                        this.record_unported("replaceable-by-method", 0)
                    else
                    {
                        ; The assignment/variable merge — `SymbolFlagsAssignment`
                        ; is set only by the JS expando arms, which are unported,
                        ; so neither side of the reference's disjunction can be
                        ; true here.
                        var merges_as_assignment false
                        if (includes & SymbolFlagsVariable) <> 0
                        {
                            if (s.flags & SymbolFlagsAssignment) <> 0
                                set merges_as_assignment: true
                        }
                        if (includes & SymbolFlagsAssignment) <> 0
                        {
                            if (s.flags & SymbolFlagsVariable) <> 0
                                set merges_as_assignment: true
                        }
                        if merges_as_assignment = false
                        {
                            this.report_duplicate(s, n, includes, is_default_export)
                            if this.is_unported()
                                return null
                            ; When an accessor conflicts with a non-accessor the
                            ; reference marks the symbol a FULL accessor, so every
                            ; later declaration of that name conflicts too.
                            if (s.flags & SymbolFlagsAccessor) <> 0
                            {
                                if (s.flags & SymbolFlagsAccessor) <> (includes & SymbolFlagsAccessor)
                                    set s.flags: s.flags | SymbolFlagsAccessor
                            }
                            set s: this.new_symbol(SymbolFlagsNone, name_data, name_len)
                            SymbolTable.set_entry(host, table, name_data, name_len, s)
                        }
                    }
                }
            }
        }

        if this.is_unported()
            return null

        this.add_declaration_to_symbol(s, n, includes)
        if s.parent = null
            set s.parent: parent
        else
        {
            ; The reference PANICS here ("Existing symbol parent should match new
            ; one"). A panic is not something to reproduce, so the marker stands
            ; where it is — the parser's five markers follow the same convention.
            if s.parent <> parent
                this.record_unported("symbol-parent-mismatch", 0)
        }
        s
    }

    ; The diagnostic half of declareSymbolEx: one report at the new declaration's
    ; name and one at every declaration the symbol already had.
    ;
    ; ★ The RELATED INFO the reference attaches (Another_export_default_is_here,
    ; The_first_export_default_is_here, Did_you_mean_0) is deliberately absent: it
    ; hangs off a diagnostic rather than being appended to the list, so the dump
    ; cannot see it — the same reason the parser's related info is invisible in the
    ; D section.
    procedure report_duplicate(this, s: pointer[Symbol], n: pointer[AstNode], includes: int, is_default_export: bool)
    {
        var code: int DiagDuplicate_identifier_0
        if (s.flags & SymbolFlagsBlockScopedVariable) <> 0
            set code: DiagCannot_redeclare_block_scoped_variable_0
        var enum_merge false
        if (s.flags & SymbolFlagsEnum) <> 0
            set enum_merge: true
        if (includes & SymbolFlagsEnum) <> 0
            set enum_merge: true
        if enum_merge
            set code: DiagEnum_declarations_can_only_merge_with_namespace_or_other_enum_declarations

        var multiple_defaults false
        if Symbol.declaration_count(s) <> 0
        {
            if is_default_export
            {
                set code: DiagA_module_cannot_have_multiple_default_exports
                set multiple_defaults: true
            }
            else
            {
                ; The second half of the reference's test is an export assignment
                ; that is not `export =`; that kind's arm is unported, so it cannot
                ; reach here.
                if AstNode.kind_of(n) = KindExportAssignment
                    this.record_unported("export-assignment-duplicate", 0)
            }
        }
        if this.is_unported()
            return

        var declaration_name AstNode.name_of(n)
        if declaration_name = null
            set declaration_name: n

        ; ★ THE ORDER IS THE REFERENCE'S: every EXISTING declaration first, then
        ; the new one. The dump compares the list as it was appended, so a port
        ; that reported the new declaration first would differ on every conflict.
        let count Symbol.declaration_count(s)
        var i 0
        while i < count
        {
            let d Symbol.declaration_at(s, i)
            var decl AstNode.name_of(d)
            if decl = null
                set decl: d
            this.error_on_node(decl, code)
            set i: i + 1
        }
        this.error_on_node(declaration_name, code)
    }

    ; getDeclarationName. Answers through out-parameters, and reports unported for
    ; the name forms this slice cannot spell — a name that comes from a LITERAL
    ; needs the literal's text, which this port does not store yet (ast.scaly's
    ; header lists it as the one omission waiting for its first reader; this is
    ; that reader, and the slice that binds a property is the slice that adds it).
    procedure get_declaration_name(this, n: pointer[AstNode], out_data: pointer[pointer[char]], out_len: pointer[int])
    {
        let k AstNode.kind_of(n)
        if k = KindExportAssignment
        {
            this.record_unported("declaration-name-export-assignment", 0)
            return
        }

        ; ★ Before the name is looked at, the reference asks IsAmbientModule(node) —
        ; a module declaration named by a STRING — and answers the quoted module name
        ; or the global self-reference. Only a ModuleDeclaration can be one, and that
        ; arm is unported, so the question cannot be asked here yet.
        let name AstNode.name_of(n)
        if name <> null
        {
            let nk AstNode.kind_of(name)
            if nk = KindIdentifier
            {
                set *out_data: AstNode.identifier_text_of(name)
                set *out_len: AstNode.identifier_text_length_of(name)
                return
            }
            if nk = KindPrivateIdentifier
            {
                this.record_unported("declaration-name-private-identifier", 0)
                return
            }
            if nk = KindComputedPropertyName
            {
                this.record_unported("declaration-name-computed", 0)
                return
            }
            if nk = KindStringLiteral
            {
                this.record_unported("declaration-name-literal", nk)
                return
            }
            if nk = KindNumericLiteral
            {
                this.record_unported("declaration-name-literal", nk)
                return
            }
            if nk = KindNoSubstitutionTemplateLiteral
            {
                this.record_unported("declaration-name-literal", nk)
                return
            }
            if nk = KindJsxNamespacedName
            {
                this.record_unported("declaration-name-jsx", 0)
                return
            }
            set *out_len: Binder.internal_name(host, "missing", out_data)
            return
        }

        ; The nameless declarations, by kind. Every one of these belongs to an arm
        ; this slice has not ported, so reaching one is a defect in the arm set
        ; rather than a name this function cannot answer — but the answers are
        ; ported anyway, because they are one line each and the next slice needs
        ; them.
        if k = KindConstructor
        {
            set *out_len: Binder.internal_name(host, "constructor", out_data)
            return
        }
        if k = KindFunctionType
        {
            set *out_len: Binder.internal_name(host, "call", out_data)
            return
        }
        if k = KindCallSignature
        {
            set *out_len: Binder.internal_name(host, "call", out_data)
            return
        }
        if k = KindConstructorType
        {
            set *out_len: Binder.internal_name(host, "new", out_data)
            return
        }
        if k = KindConstructSignature
        {
            set *out_len: Binder.internal_name(host, "new", out_data)
            return
        }
        if k = KindIndexSignature
        {
            set *out_len: Binder.internal_name(host, "index", out_data)
            return
        }
        if k = KindExportDeclaration
        {
            set *out_len: Binder.internal_name(host, "export", out_data)
            return
        }
        if k = KindSourceFile
        {
            set *out_len: Binder.internal_name(host, "export=", out_data)
            return
        }
        if k = KindBinaryExpression
        {
            set *out_len: Binder.internal_name(host, "export=", out_data)
            return
        }
        set *out_len: Binder.internal_name(host, "missing", out_data)
    }

    ; declareModuleMember. This slice reaches only the last line of it — the plain
    ; `locals` case — and the two above it are reported: an ALIAS needs the
    ; import/export arms, and an exported member needs the export-context flag the
    ; unported module arm sets.
    procedure declare_module_member(this, n: pointer[AstNode], symbol_flags: int, symbol_excludes: int) returns pointer[Symbol]
    {
        if (symbol_flags & SymbolFlagsAlias) <> 0
        {
            this.record_unported("declare-module-member-alias", 0)
            return null
        }
        let has_export_modifier this.has_combined_modifier(n, ModifierFlagsExport)
        var exported: bool has_export_modifier
        if (AstNode.flags_of(container) & NodeFlagsExportContext) <> 0
            set exported: true
        if exported
        {
            this.record_unported("declare-module-member-exported", 0)
            return null
        }
        this.declare_symbol(Binder.get_locals(host, container), null as pointer[Symbol], n, symbol_flags, symbol_excludes)
    }

    ; declareSourceFileMember.
    procedure declare_source_file_member(this, n: pointer[AstNode], symbol_flags: int, symbol_excludes: int) returns pointer[Symbol]
    {
        if is_external_module
            return this.declare_module_member(n, symbol_flags, symbol_excludes)
        this.declare_symbol(Binder.get_locals(host, file), null as pointer[Symbol], n, symbol_flags, symbol_excludes)
    }

    ; declareSymbolAndAddToSymbolTable. The container's KIND decides the table, and
    ; the arms this slice has not ported are the containers it cannot reach.
    procedure declare_symbol_and_add_to_symbol_table(this, n: pointer[AstNode], symbol_flags: int, symbol_excludes: int) returns pointer[Symbol]
    {
        let ck AstNode.kind_of(container)
        if ck = KindSourceFile
            return this.declare_source_file_member(n, symbol_flags, symbol_excludes)

        ; The locals arm: every function-like container plus the type alias and the
        ; mapped type. A parameter and a type parameter land here.
        if Binder.container_declares_into_locals(ck)
            return this.declare_symbol(Binder.get_locals(host, container), null as pointer[Symbol], n, symbol_flags, symbol_excludes)

        this.record_unported("declare-into-container", ck)
        null
    }

    function container_declares_into_locals(ck: int) returns bool
    {
        if ck = KindFunctionType
            return true
        if ck = KindConstructorType
            return true
        if ck = KindCallSignature
            return true
        if ck = KindConstructSignature
            return true
        if ck = KindIndexSignature
            return true
        if ck = KindMethodDeclaration
            return true
        if ck = KindMethodSignature
            return true
        if ck = KindConstructor
            return true
        if ck = KindGetAccessor
            return true
        if ck = KindSetAccessor
            return true
        if ck = KindFunctionDeclaration
            return true
        if ck = KindFunctionExpression
            return true
        if ck = KindArrowFunction
            return true
        if ck = KindClassStaticBlockDeclaration
            return true
        if ck = KindTypeAliasDeclaration
            return true
        if ck = KindJSTypeAliasDeclaration
            return true
        if ck = KindMappedType
            return true
        false
    }

    ; bindBlockScopedDeclaration.
    procedure bind_block_scoped_declaration(this, n: pointer[AstNode], symbol_flags: int, symbol_excludes: int)
    {
        let bk AstNode.kind_of(block_scope_container)
        if bk = KindModuleDeclaration
        {
            this.declare_module_member(n, symbol_flags, symbol_excludes)
            return
        }
        if bk = KindSourceFile
        {
            if is_external_module
            {
                this.declare_module_member(n, symbol_flags, symbol_excludes)
                return
            }
        }
        this.declare_symbol(Binder.get_locals(host, block_scope_container), null as pointer[Symbol], n, symbol_flags, symbol_excludes)
    }

    ; bindAnonymousDeclaration: a symbol with a name of the binder's own choosing
    ; and no table.
    procedure bind_anonymous_declaration(this, n: pointer[AstNode], symbol_flags: int, name_data: pointer[char], name_len: int)
    {
        let s this.new_symbol(symbol_flags, name_data, name_len)
        var member false
        if (symbol_flags & SymbolFlagsEnumMember) <> 0
            set member: true
        if (symbol_flags & SymbolFlagsClassMember) <> 0
            set member: true
        if member
            set s.parent: container.symbol
        this.add_declaration_to_symbol(s, n, symbol_flags)
    }

    ; ── the arms ────────────────────────────────────────────────────────────

    ; bindSourceFileIfExternalModule. setExportContextFlag first, then the module
    ; symbol — and the module symbol needs a name built from the FILE NAME, which
    ; is bindSourceFileAsExternalModule's whole content.
    procedure bind_source_file_if_external_module(this)
    {
        this.set_export_context_flag(file)
        if is_external_module
        {
            this.record_unported("source-file-as-external-module", 0)
            return
        }

        ; ★★★ THE JSON ARM, and leaving it out was a WRONG ANSWER rather than a
        ; gap — which is what the yardstick was built to catch and did, on its first
        ; run: a JSON document is bound as an external module too (its symbol is the
        ; quoted file name) plus a second symbol standing for `module.exports = {}`,
        ; and this port answered `f 0 0` for six units with rc 0. An arm that is
        ; MISSING from a switch produces a well-formed dump; an arm that REPORTS
        ; produces a column entry. The difference is the whole discipline.
        ;
        ; ★ `IsJsonSourceFile` asks the file's SCRIPT KIND upstream; here the
        ; equivalent is the JsonFile context flag, which the parser stamps on every
        ; node of a JSON parse (parser.scaly's initializeState arm).
        if (AstNode.flags_of(file) & NodeFlagsJsonFile) <> 0
            this.record_unported("source-file-as-json", 0)
    }

    ; setExportContextFlag. An AMBIENT declaration container with no export
    ; declarations of its own is an export context: everything in it is exported
    ; implicitly. The flag is CLEARED otherwise, which matters for a re-bind and is
    ; ported as written.
    procedure set_export_context_flag(this, n: pointer[AstNode])
    {
        var ambient false
        if (AstNode.flags_of(n) & NodeFlagsAmbient) <> 0
            set ambient: true
        if ambient
        {
            if this.has_export_declarations(n) = false
            {
                set n.flags: AstNode.flags_of(n) | NodeFlagsExportContext
                return
            }
        }
        if (AstNode.flags_of(n) & NodeFlagsExportContext) <> 0
            set n.flags: AstNode.flags_of(n) - NodeFlagsExportContext
    }

    function has_export_declarations(this, n: pointer[AstNode]) returns bool
    {
        var statements null as pointer[Array[pointer[AstNode]]]
        let k AstNode.kind_of(n)
        if k = KindSourceFile
            set statements: AstNode.statements_of(n)
        if k = KindModuleDeclaration
        {
            let body AstNode.body_of(n)
            if body <> null
            {
                if AstNode.kind_of(body) = KindModuleBlock
                    set statements: AstNode.statements_of(body)
            }
        }
        if statements = null
            return false
        let len statements.get_length() as int
        var i 0
        while i < len
        {
            let sk AstNode.kind_of(*(statements.get_buffer() + i))
            if sk = KindExportDeclaration
                return true
            if sk = KindExportAssignment
                return true
            set i: i + 1
        }
        false
    }

    ; bindVariableDeclarationOrBindingElement.
    procedure bind_variable_declaration_or_binding_element(this, n: pointer[AstNode])
    {
        this.check_strict_mode_eval_or_arguments(n, AstNode.name_of(n))
        let name AstNode.name_of(n)
        if name = null
            return
        if Binder.is_binding_pattern(name)
            return

        ; A `var x = require("m")` in a JavaScript file is an ALIAS, and that arm
        ; needs the require detection the JS expando machinery brings with it.
        if Binder.is_variable_declaration_initialized_to_require(n)
        {
            this.record_unported("variable-initialized-to-require", 0)
            return
        }
        if this.is_block_or_catch_scoped(n)
        {
            this.bind_block_scoped_declaration(n, SymbolFlagsBlockScopedVariable, SymbolFlagsBlockScopedVariableExcludes)
            return
        }
        if Binder.is_part_of_parameter_declaration(n)
        {
            this.declare_symbol_and_add_to_symbol_table(n, SymbolFlagsFunctionScopedVariable, SymbolFlagsParameterExcludes)
            return
        }
        this.declare_symbol_and_add_to_symbol_table(n, SymbolFlagsFunctionScopedVariable, SymbolFlagsFunctionScopedVariableExcludes)
    }

    ; bindParameter. The binding-pattern arm and the parameter-property arm are
    ; both reported: the first needs a name built from the parameter's INDEX, the
    ; second declares into the containing class's members, which this slice's
    ; container set does not include.
    procedure bind_parameter(this, n: pointer[AstNode])
    {
        if (AstNode.flags_of(n) & NodeFlagsAmbient) = 0
            this.check_strict_mode_eval_or_arguments(n, AstNode.name_of(n))
        let name AstNode.name_of(n)
        if name <> null
        {
            if Binder.is_binding_pattern(name)
            {
                this.record_unported("parameter-binding-pattern", 0)
                return
            }
        }
        this.declare_symbol_and_add_to_symbol_table(n, SymbolFlagsFunctionScopedVariable, SymbolFlagsParameterExcludes)
        if this.is_unported()
            return
        if this.is_parameter_property_declaration(n)
            this.record_unported("parameter-property", 0)
    }

    ; bindFunctionDeclaration. The emitFlags half — HasAsyncFunctions, which the
    ; TRANSFORMS read — is a node flag on the SourceFile that no dump here can see;
    ; the check the reference does before it is ported.
    procedure bind_function_declaration(this, n: pointer[AstNode])
    {
        this.check_strict_mode_function_name(n)
        this.bind_block_scoped_declaration(n, SymbolFlagsFunction, SymbolFlagsFunctionExcludes)
    }

    ; bindTypeParameter. The INFER TYPE arm needs an ancestor walk over conditional
    ; types; a type parameter of a signature takes the ordinary path.
    procedure bind_type_parameter(this, n: pointer[AstNode])
    {
        let p AstNode.parent_node_of(n)
        if p <> null
        {
            if AstNode.kind_of(p) = KindInferType
            {
                this.record_unported("type-parameter-infer", 0)
                return
            }
        }
        this.declare_symbol_and_add_to_symbol_table(n, SymbolFlagsTypeParameter, SymbolFlagsTypeParameterExcludes)
    }

    ; ── the strict-mode and contextual checks ───────────────────────────────

    ; checkContextualIdentifier. A future reserved word, `await` or `yield` used as
    ; a plain identifier is reported HERE rather than by the parser, which is why
    ; the B section carries codes the D section never does.
    procedure check_contextual_identifier(this, n: pointer[AstNode])
    {
        if file_has_no_parse_errors = false
            return
        if (AstNode.flags_of(n) & NodeFlagsAmbient) <> 0
            return
        if (AstNode.flags_of(n) & NodeFlagsJSDoc) <> 0
            return
        if Binder.is_identifier_name(n)
            return
        let original get_identifier_token(AstNode.identifier_text_of(n), AstNode.identifier_text_length_of(n))
        if original = KindIdentifier
            return
        if original >= KindFirstFutureReservedWord
        {
            if original <= KindLastFutureReservedWord
            {
                this.error_on_node(n, this.strict_mode_identifier_code(n))
                return
            }
        }
        if original = KindAwaitKeyword
        {
            if is_external_module
            {
                if Binder.is_in_top_level_context(n)
                {
                    this.error_on_node(n, DiagIdentifier_expected_0_is_a_reserved_word_at_the_top_level_of_a_module)
                    return
                }
            }
            if (AstNode.flags_of(n) & NodeFlagsAwaitContext) <> 0
                this.error_on_node(n, DiagIdentifier_expected_0_is_a_reserved_word_that_cannot_be_used_here)
            return
        }
        if original = KindYieldKeyword
        {
            if (AstNode.flags_of(n) & NodeFlagsYieldContext) <> 0
                this.error_on_node(n, DiagIdentifier_expected_0_is_a_reserved_word_that_cannot_be_used_here)
        }
    }

    ; getStrictModeIdentifierMessage: three messages, and which one you get says
    ; WHY the binder thinks the code is in strict mode.
    function strict_mode_identifier_code(this, n: pointer[AstNode]) returns int
    {
        if Binder.get_containing_class(n) <> null
            return DiagIdentifier_expected_0_is_a_reserved_word_in_strict_mode_Class_definitions_are_automatically_in_strict_mode
        if is_external_module
            return DiagIdentifier_expected_0_is_a_reserved_word_in_strict_mode_Modules_are_automatically_in_strict_mode
        DiagIdentifier_expected_0_is_a_reserved_word_in_strict_mode
    }

    ; checkStrictModeEvalOrArguments, and it has NO strict-mode test — which reads
    ; like a missing gate and is not one. The reference's function is
    ; `if name != nil && isEvalOrArgumentsIdentifier(name)`, its callers gate only on
    ; NodeFlagsAmbient, and the message it picks (TS1100/1215/2332) merely SAYS
    ; "in strict mode". Measured on `tests/fixtures/binder_eval_parameter.ts`, which
    ; carries no `"use strict"` and is not a module: the reference reports TS1100 at
    ; the parameter, and so does this port. Fidelity is to the reference.
    procedure check_strict_mode_eval_or_arguments(this, context: pointer[AstNode], name: pointer[AstNode])
    {
        if name = null
            return
        if AstNode.kind_of(name) <> KindIdentifier
            return
        var is_eval_or_arguments false
        if AstNode.identifier_text_is(name, "eval")
            set is_eval_or_arguments: true
        if AstNode.identifier_text_is(name, "arguments")
            set is_eval_or_arguments: true
        if is_eval_or_arguments = false
            return
        this.error_on_node(name, this.strict_mode_eval_or_arguments_code(context))
    }

    function strict_mode_eval_or_arguments_code(this, n: pointer[AstNode]) returns int
    {
        if Binder.get_containing_class(n) <> null
            return DiagCode_contained_in_a_class_is_evaluated_in_JavaScript_s_strict_mode_which_does_not_allow_this_use_of_0_For_more_information_see_https_Colon_Slash_Slashdeveloper_mozilla_org_Slashen_US_Slashdocs_SlashWeb_SlashJavaScript_SlashReference_SlashStrict_mode
        if is_external_module
            return DiagInvalid_use_of_0_Modules_are_automatically_in_strict_mode
        DiagInvalid_use_of_0_in_strict_mode
    }

    procedure check_strict_mode_function_name(this, n: pointer[AstNode])
    {
        if (AstNode.flags_of(n) & NodeFlagsAmbient) <> 0
            return
        this.check_strict_mode_eval_or_arguments(n, AstNode.name_of(n))
    }

    ; ── the ast utilities the arms above need ───────────────────────────────
    ;
    ; Each is the reference's function of the same name, ported at the size its
    ; callers here need and no smaller — §3.5br's lesson is that an accessor
    ; narrowed to today's callers costs more the second time.

    function is_binding_pattern(n: pointer[AstNode]) returns bool
    {
        let k AstNode.kind_of(n)
        if k = KindObjectBindingPattern
            return true
        if k = KindArrayBindingPattern
            return true
        false
    }

    ; GetRootDeclaration: up through the binding elements to the declaration that
    ; owns them. A BindingElement's parent is the PATTERN and its grandparent the
    ; declaration, which is the reference's `node.Parent.Parent`.
    function get_root_declaration(n: pointer[AstNode]) returns pointer[AstNode]
    {
        var node n
        while AstNode.kind_of(node) = KindBindingElement
        {
            let p AstNode.parent_node_of(node)
            if p = null
                return node
            let g AstNode.parent_node_of(p)
            if g = null
                return node
            set node: g
        }
        node
    }

    function is_part_of_parameter_declaration(n: pointer[AstNode]) returns bool
        AstNode.kind_of(Binder.get_root_declaration(n)) = KindParameter

    ; GetCombinedNodeFlags / GetCombinedModifierFlags share one shape upstream (a
    ; generic over the flag getter): from the root declaration up through the
    ; declaration list and the statement, OR-ing at each level. Two functions here,
    ; because Scaly has no function-valued parameter for this and a delegate would
    ; make the callee unknown at exactly the place §3.1 refuses to.
    function combined_node_flags(n: pointer[AstNode]) returns int
    {
        var node Binder.get_root_declaration(n)
        var flags AstNode.flags_of(node)
        if AstNode.kind_of(node) = KindVariableDeclaration
            set node: AstNode.parent_node_of(node)
        if node <> null
        {
            if AstNode.kind_of(node) = KindVariableDeclarationList
            {
                set flags: flags | AstNode.flags_of(node)
                set node: AstNode.parent_node_of(node)
            }
        }
        if node <> null
        {
            if AstNode.kind_of(node) = KindVariableStatement
                set flags: flags | AstNode.flags_of(node)
        }
        flags
    }

    function has_combined_modifier(this, n: pointer[AstNode], flag: int) returns bool
    {
        var node Binder.get_root_declaration(n)
        var flags this.modifier_flags(node)
        if AstNode.kind_of(node) = KindVariableDeclaration
            set node: AstNode.parent_node_of(node)
        if node <> null
        {
            if AstNode.kind_of(node) = KindVariableDeclarationList
            {
                set flags: flags | this.modifier_flags(node)
                set node: AstNode.parent_node_of(node)
            }
        }
        if node <> null
        {
            if AstNode.kind_of(node) = KindVariableStatement
                set flags: flags | this.modifier_flags(node)
        }
        (flags & flag) <> 0
    }

    ; Node.ModifierFlags. Upstream caches the value on the ModifierList when the
    ; parser builds it; this port stores the modifier NODES, so the OR is computed
    ; here — the same OR, since modifiersToFlags is what fills the cache.
    function modifier_flags(this, n: pointer[AstNode]) returns int
    {
        if n = null
            return ModifierFlagsNone
        let mods AstNode.modifiers_of(n)
        if mods = null
            return ModifierFlagsNone
        var flags: int ModifierFlagsNone
        let len mods.get_length() as int
        var i 0
        while i < len
        {
            set flags: flags | AstNode.modifier_to_flag(AstNode.kind_of(*(mods.get_buffer() + i)))
            set i: i + 1
        }
        flags
    }

    function has_syntactic_modifier(this, n: pointer[AstNode], flag: int) returns bool
        (this.modifier_flags(n) & flag) <> 0

    ; IsBlockOrCatchScoped.
    function is_block_or_catch_scoped(this, n: pointer[AstNode]) returns bool
    {
        if (Binder.combined_node_flags(n) & NodeFlagsBlockScoped) <> 0
            return true
        Binder.is_catch_clause_variable_declaration_or_binding_element(n)
    }

    function is_catch_clause_variable_declaration_or_binding_element(n: pointer[AstNode]) returns bool
    {
        let root Binder.get_root_declaration(n)
        if AstNode.kind_of(root) <> KindVariableDeclaration
            return false
        let p AstNode.parent_node_of(root)
        if p = null
            return false
        AstNode.kind_of(p) = KindCatchClause
    }

    ; IsIdentifierName: is this identifier a NAME rather than a reference? The
    ; answer is entirely about the parent, which is the second reader that makes
    ; Parent load-bearing in this slice.
    function is_identifier_name(n: pointer[AstNode]) returns bool
    {
        let p AstNode.parent_node_of(n)
        if p = null
            return false
        let pk AstNode.kind_of(p)
        if Binder.parent_kind_names_by_name_slot(pk)
            return AstNode.name_of(p) = n
        if pk = KindQualifiedName
            return AstNode.qualified_right_of(p) = n
        if pk = KindBindingElement
            return AstNode.property_name_of(p) = n
        if pk = KindImportSpecifier
            return AstNode.property_name_of(p) = n
        if pk = KindExportSpecifier
            return true
        if pk = KindJsxAttribute
            return true
        if pk = KindJsxSelfClosingElement
            return true
        if pk = KindJsxOpeningElement
            return true
        if pk = KindJsxClosingElement
            return true
        false
    }

    function parent_kind_names_by_name_slot(pk: int) returns bool
    {
        if pk = KindPropertyDeclaration
            return true
        if pk = KindPropertySignature
            return true
        if pk = KindMethodDeclaration
            return true
        if pk = KindMethodSignature
            return true
        if pk = KindGetAccessor
            return true
        if pk = KindSetAccessor
            return true
        if pk = KindEnumMember
            return true
        if pk = KindPropertyAssignment
            return true
        if pk = KindPropertyAccessExpression
            return true
        false
    }

    ; GetContainingClass: the nearest class-like ancestor, by walking the parent
    ; chain. Its two callers are the strict-mode messages, which say WHY the binder
    ; thinks the code is in strict mode — a class body always is.
    function get_containing_class(n: pointer[AstNode]) returns pointer[AstNode]
    {
        var p AstNode.parent_node_of(n)
        while p <> null
        {
            let k AstNode.kind_of(p)
            if k = KindClassDeclaration
                return p
            if k = KindClassExpression
                return p
            set p: AstNode.parent_node_of(p)
        }
        null
    }

    ; IsInTopLevelContext: whether the node's THIS CONTAINER is the source file.
    ;
    ; ★ The first step is not decoration: a class or function DECLARATION's own name
    ; is a binding in the SURROUNDING scope, so the walk starts one level up for it.
    function is_in_top_level_context(n: pointer[AstNode]) returns bool
    {
        var node n
        if AstNode.kind_of(node) = KindIdentifier
        {
            let p AstNode.parent_node_of(node)
            if p <> null
            {
                let pk AstNode.kind_of(p)
                var is_named_decl false
                if pk = KindFunctionDeclaration
                    set is_named_decl: true
                if pk = KindClassDeclaration
                    set is_named_decl: true
                if is_named_decl
                {
                    if AstNode.name_of(p) = node
                        set node: p
                }
            }
        }
        let c Binder.get_this_container(node)
        if c = null
            return false
        AstNode.kind_of(c) = KindSourceFile
    }

    ; GetThisContainer(node, includeArrowFunctions: true,
    ; includeClassComputedPropertyName: false) — the two arguments its only caller
    ; here passes, which is why the arrow arm returns and the computed-name arm only
    ; skips.
    ;
    ; ★★★ A CLASS IS NOT A THIS CONTAINER in this function, and an approximation
    ; that treated it as one — the first draft of this file did — answers a
    ; different question. The kinds that stop the walk are the reference's own list:
    ; the function-likes, the signatures, a property declaration or signature, a
    ; module or enum declaration, a class STATIC BLOCK, and the source file.
    ;
    ; ★ The reference PANICS on a null parent; this answers null and the caller
    ; reads that as "not the source file", which is the same answer for every tree
    ; the parser can actually build (only a detached node has no parent chain).
    function get_this_container(n: pointer[AstNode]) returns pointer[AstNode]
    {
        var node n
        while true
        {
            set node: AstNode.parent_node_of(node)
            if node = null
                return null
            let k AstNode.kind_of(node)

            ; A computed property name is skipped together with the member it names
            ; (`node.Parent.Parent`), because `this` inside it belongs to the scope
            ; AROUND the class.
            if k = KindComputedPropertyName
            {
                let p AstNode.parent_node_of(node)
                if p = null
                    return null
                set node: AstNode.parent_node_of(p)
                if node = null
                    return null
            }
            else
            {
                ; A decorator is evaluated OUTSIDE the body it decorates, so the
                ; walk jumps over the class element — or, for a parameter
                ; decorator, over the parameter and its element both.
                if k = KindDecorator
                {
                    let p AstNode.parent_node_of(node)
                    if p <> null
                    {
                        if AstNode.kind_of(p) = KindParameter
                        {
                            let g AstNode.parent_node_of(p)
                            if g <> null
                            {
                                if Binder.is_class_element(g)
                                    set node: g
                            }
                        }
                        else
                        {
                            if Binder.is_class_element(p)
                                set node: p
                        }
                    }
                }
                else
                {
                    if k = KindArrowFunction
                        return node
                    if Binder.is_this_container_kind(k)
                        return node
                }
            }
        }
        null
    }

    function is_this_container_kind(k: int) returns bool
    {
        if k = KindFunctionDeclaration
            return true
        if k = KindFunctionExpression
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindClassStaticBlockDeclaration
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindPropertySignature
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindConstructor
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindCallSignature
            return true
        if k = KindConstructSignature
            return true
        if k = KindIndexSignature
            return true
        if k = KindEnumDeclaration
            return true
        if k = KindSourceFile
            return true
        false
    }

    ; ast.IsClassElement.
    function is_class_element(n: pointer[AstNode]) returns bool
    {
        let k AstNode.kind_of(n)
        if k = KindConstructor
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindIndexSignature
            return true
        if k = KindClassStaticBlockDeclaration
            return true
        if k = KindSemicolonClassElement
            return true
        false
    }

    ; The two JavaScript-only predicates this slice's arms ask about. Both answer
    ; FALSE and say why: each needs GetAssignmentDeclarationKind, the expando
    ; machinery of the JS binder, and every call site that could see a true answer
    ; is already reported as unported.
    function is_variable_declaration_initialized_to_require(n: pointer[AstNode]) returns bool
        false

    ; ast.IsParameterPropertyDeclaration: a parameter carrying an ACCESSIBILITY,
    ; `readonly` or `override` modifier, inside a CONSTRUCTOR — the shape that
    ; declares a class property and a parameter in one breath. Both halves are
    ; needed: without the modifier test every constructor parameter would declare a
    ; property, and without the parent test a modifier on any parameter would.
    function is_parameter_property_declaration(this, n: pointer[AstNode]) returns bool
    {
        let p AstNode.parent_node_of(n)
        if p = null
            return false
        if AstNode.kind_of(p) <> KindConstructor
            return false
        let f this.modifier_flags(n)
        if (f & ModifierFlagsPublic) <> 0
            return true
        if (f & ModifierFlagsPrivate) <> 0
            return true
        if (f & ModifierFlagsProtected) <> 0
            return true
        if (f & ModifierFlagsReadonly) <> 0
            return true
        if (f & ModifierFlagsOverride) <> 0
            return true
        false
    }
}
