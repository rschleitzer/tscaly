; SPDX-License-Identifier: Apache-2.0
;
; help — internal/execute/tsc/help.go: PrintVersion, PrintHelp (the easy and the
; --all view) and PrintBuildHelp (phase (b)2).
;
; ★ help.go assembles its text as a list of CHUNKS and one rule reads the list back
; (generateGroupOptionOutput's "always a blank line in the end" asks whether the
; chunk before the last is a newline), so the writer keeps the last two chunks'
; newline-ness rather than the chunks. The per-option data — value type, possible
; values, default text, whether the additional lines show — is generated from the
; declarations (TsOptionDecls.help_*), §3.23's argument.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.TsOptionDecls.TsOptionDecls
use tscaly.DiagnosticMessages.DiagnosticMessages
use tscaly.diagnosticwriter.DiagnosticWriter
use tscaly.system.ExecSystem
use tscaly.program.JsonValue
use tscaly.tsoptions.TsOptions

; an option of a help list: the declaration table and the index in it
define HelpOption (table: int  index: int)

; the chunk writer and tsc.colors
define HelpWriter
(
    host: ref[Page]
    out: ref[StringBuilder]
    last_newline: bool
    before_last_newline: bool
    count: int
    show_colors: bool
    is_windows: bool
    is_windows_terminal: bool
    is_vscode: bool
    supports_richer_colors: bool
    terminal_width: int
)
{
    ; createColors
    function create(host: ref[Page], sys: ref[ExecSystem], pretty: bool) returns ref[HelpWriter]
    {
        let os TsConfigParserless.lower(host, sys.get_environment_variable("OS"))
        var width 0
        let width_text sys.get_environment_variable("TS_TEST_TERMINAL_WIDTH")
        var wi 0
        while wi < (width_text.length as int)
        {
            set width: width * 10 + ((*(width_text.data + wi) as int) - 48)
            set wi: wi + 1
        }
        let term_program sys.get_environment_variable("TERM_PROGRAM")
        let colorterm sys.get_environment_variable("COLORTERM")
        let term sys.get_environment_variable("TERM")
        let wt sys.get_environment_variable("WT_SESSION")
        &HelpWriter^host(host, sys.output, false, false, 0, pretty, TsConfigParserless.contains(os, "windows"), (wt.length as int) > 0, term_program.equals("vscode"), colorterm.equals("truecolor") or term.equals("xterm-256color"), width)
    }

    procedure chunk(this, text: Slice[char])
    {
        out.append(text.data, text.length)
        set this.before_last_newline: last_newline
        set this.last_newline: text.equals("\n")
        set this.count: count + 1
    }

    procedure chunk_string(this, text: String)
        this.chunk(Slice[char](text.get_length(), text.get_buffer() as pointer[char]))

    procedure bold(this, text: Slice[char])
    {
        if show_colors = false
        {
            this.chunk(text)
            return
        }
        var sb StringBuilder()
        sb.append("\u001b[1m")
        sb.append(text.data, text.length)
        sb.append("\u001b[22m")
        this.chunk_string(sb.to_string())
    }

    procedure blue(this, text: Slice[char])
    {
        if show_colors = false
        {
            this.chunk(text)
            return
        }
        if is_windows and (is_windows_terminal = false) and (is_vscode = false)
        {
            this.bright_white(text)
            return
        }
        var sb StringBuilder()
        sb.append("\u001b[94m")
        sb.append(text.data, text.length)
        sb.append("\u001b[39m")
        this.chunk_string(sb.to_string())
    }

    procedure bright_white(this, text: Slice[char])
    {
        if show_colors = false
        {
            this.chunk(text)
            return
        }
        var sb StringBuilder()
        sb.append("\u001b[97m")
        sb.append(text.data, text.length)
        sb.append("\u001b[39m")
        this.chunk_string(sb.to_string())
    }

    ; blueBackground, around the brightWhite of `inner_white` when set
    procedure blue_background(this, text: Slice[char], inner_white: bool)
    {
        var sb StringBuilder()
        if show_colors
        {
            if supports_richer_colors
                sb.append("\u001b[48;5;68m")
            else
                sb.append("\u001b[44m")
        }
        if inner_white and show_colors
        {
            sb.append("\u001b[97m")
            sb.append(text.data, text.length)
            sb.append("\u001b[39m")
        }
        else
            sb.append(text.data, text.length)
        if show_colors
            sb.append("\u001b[39;49m")
        this.chunk_string(sb.to_string())
    }
}

; two text helpers of no module's own
define TsConfigParserless (reserved: int)
{
    function lower(host: ref[Page], s: Slice[char]) returns Slice[char]
    {
        let sb StringBuilder^host()
        var i 0
        while i < (s.length as int)
        {
            var c *(s.data + i) as int
            if (c >= 65) and (c <= 90)
                set c: c + 32
            sb.append(c as char)
            set i: i + 1
        }
        let text String^host(sb.to_string())
        Slice[char](text.get_length(), text.get_buffer() as pointer[char])
    }

    function contains(s: Slice[char], t: Slice[char]) returns bool
    {
        var i 0
        while (i + (t.length as int)) <= (s.length as int)
        {
            if s.subslice(i as size_t, (i + (t.length as int)) as size_t).equals(t)
                return true
            set i: i + 1
        }
        false
    }
}

define Help (reserved: int)
{
    ; core.Version() as the baselines were written: the pin's version.go says 7.0.2,
    ; but the help header's padding (the harness replaces the version after the
    ; text is laid out) is 9 characters wide — the 7.0.0-dev the baselines predate
    function version() returns Slice[char]
        "7.0.0-dev"

    function message(code: int) returns Slice[char]
        DiagnosticMessages.text_of(code)

    function message1(host: ref[Page], code: int, a0: Slice[char]) returns Slice[char]
    {
        let args &Array[String]^host()
        let a String^host(a0.data as pointer[const_char], a0.length)
        args.add(a)
        let text String^host(DiagnosticWriter.format_message(code, args))
        Slice[char](text.get_length(), text.get_buffer() as pointer[char])
    }

    ; PrintVersion
    procedure print_version(sys: ref[ExecSystem])
    {
        let text Help.message1(sys.host, DiagVersion_0, Help.version())
        sys.output.append(text.data, text.length)
        sys.output.append("\n")
    }

    function title(host: ref[Page]) returns Slice[char]
    {
        let sb StringBuilder^host()
        let tsc Help.message(DiagX_tsc_Colon_The_TypeScript_Compiler)
        sb.append(tsc.data, tsc.length)
        sb.append(" - ")
        let v Help.message1(host, DiagVersion_0, Help.version())
        sb.append(v.data, v.length)
        let text String^host(sb.to_string())
        Slice[char](text.get_length(), text.get_buffer() as pointer[char])
    }

    ; ── the declarations of a help list ─────────────────────────────────────

    function name_of(o: HelpOption) returns Slice[char]
    {
        if o.table = 1
            return TsOptionDecls.watch_name_of(o.index)
        if o.table = 2
            return TsOptionDecls.build_name_of(o.index)
        TsOptionDecls.name_of(o.index)
    }

    function short_name_of(o: HelpOption) returns Slice[char]
    {
        if o.table = 1
            return TsOptionDecls.watch_short_name_of(o.index)
        if o.table = 2
            return TsOptionDecls.build_short_name_of(o.index)
        TsOptionDecls.short_name_of(o.index)
    }

    function description_of(o: HelpOption) returns int
    {
        if o.table = 1
            return TsOptionDecls.watch_description_of(o.index)
        if o.table = 2
            return TsOptionDecls.build_description_of(o.index)
        TsOptionDecls.description_of(o.index)
    }

    function category_of(o: HelpOption) returns int
    {
        if o.table = 1
            return TsOptionDecls.watch_category_of(o.index)
        if o.table = 2
            return TsOptionDecls.build_category_of(o.index)
        TsOptionDecls.category_of(o.index)
    }

    function command_line_only(o: HelpOption) returns bool
    {
        if o.table = 1
            return TsOptionDecls.watch_help_command_line_only(o.index)
        if o.table = 2
            return TsOptionDecls.build_help_command_line_only(o.index)
        TsOptionDecls.help_command_line_only(o.index)
    }

    function simplified(o: HelpOption) returns bool
    {
        if o.table = 1
            return TsOptionDecls.watch_show_in_simplified_help_view(o.index)
        if o.table = 2
            return TsOptionDecls.build_show_in_simplified_help_view(o.index)
        TsOptionDecls.show_in_simplified_help_view(o.index)
    }

    function value_type(o: HelpOption) returns Slice[char]
    {
        if o.table = 1
            return TsOptionDecls.watch_help_value_type(o.index)
        if o.table = 2
            return TsOptionDecls.build_help_value_type(o.index)
        TsOptionDecls.help_value_type(o.index)
    }

    function possible_values(o: HelpOption) returns Slice[char]
    {
        if o.table = 1
            return TsOptionDecls.watch_help_possible_values(o.index)
        if o.table = 2
            return TsOptionDecls.build_help_possible_values(o.index)
        TsOptionDecls.help_possible_values(o.index)
    }

    function default_text(o: HelpOption) returns Slice[char]
    {
        if o.table = 1
            return TsOptionDecls.watch_help_default(o.index)
        if o.table = 2
            return TsOptionDecls.build_help_default(o.index)
        TsOptionDecls.help_default(o.index)
    }

    function shows_additional_info(o: HelpOption) returns bool
    {
        if o.table = 1
            return TsOptionDecls.watch_help_shows_additional_info(o.index)
        if o.table = 2
            return TsOptionDecls.build_help_shows_additional_info(o.index)
        TsOptionDecls.help_shows_additional_info(o.index)
    }

    ; getDisplayNameTextOfOption
    function display_name(host: ref[Page], o: HelpOption) returns Slice[char]
    {
        let sb StringBuilder^host()
        sb.append("--")
        let name Help.name_of(o)
        sb.append(name.data, name.length)
        let short Help.short_name_of(o)
        if (short.length as int) > 0
        {
            sb.append(", -")
            sb.append(short.data, short.length)
        }
        let text String^host(sb.to_string())
        Slice[char](text.get_length(), text.get_buffer() as pointer[char])
    }

    ; the options of a table in declaration order (OptionsDeclarations, the compiler
    ; table's names being unique by index)
    procedure compiler_options(host: ref[Page]) returns ref[Array[HelpOption]]
    {
        let list &Array[HelpOption]^host()
        var i 0
        while (TsOptionDecls.name_of(i).length as int) > 0
        {
            list.add(HelpOption(0, i))
            set i: i + 1
        }
        list
    }

    ; ── the chunks ───────────────────────────────────────────────────────────

    procedure spaces(host: ref[Page], n: int) returns Slice[char]
    {
        let sb StringBuilder^host()
        var i 0
        while i < n
        {
            sb.append(" " as char)
            set i: i + 1
        }
        let text String^host(sb.to_string())
        Slice[char](text.get_length(), text.get_buffer() as pointer[char])
    }

    ; getHeader
    procedure header(w: ref[HelpWriter], message: Slice[char])
    {
        let host w.host
        let width w.terminal_width
        if width >= ((message.length as int) + 5)
        {
            var right_align width
            if width > 120
                set right_align: 120
            let left_align right_align - 5
            let sb StringBuilder^host()
            sb.append(message.data, message.length)
            var pad (message.length as int)
            while pad < left_align
            {
                sb.append(" " as char)
                set pad: pad + 1
            }
            w.chunk_string(sb.to_string())
            w.blue_background("     ", false)
            w.chunk("\n")
            w.chunk(Help.spaces(host, left_align))
            w.blue_background("  TS ", true)
            w.chunk("\n")
            return
        }
        w.chunk(message)
        w.chunk("\n")
        w.chunk("\n")
    }

    ; getPrettyOutput
    procedure pretty_output(w: ref[HelpWriter], left: Slice[char], right: Slice[char], right_align_of_left: int, left_align_of_right: int, color_left: bool)
    {
        let host w.host
        var first true
        var remain right
        let right_count w.terminal_width - left_align_of_right
        while (remain.length as int) > 0
        {
            if first
            {
                let sb StringBuilder^host()
                var pad left.length as int
                while pad < right_align_of_left
                {
                    sb.append(" " as char)
                    set pad: pad + 1
                }
                sb.append(left.data, left.length)
                var width right_align_of_left
                if (left.length as int) > width
                    set width: left.length as int
                while width < left_align_of_right
                {
                    sb.append(" " as char)
                    set width: width + 1
                }
                let cur String^host(sb.to_string())
                if color_left
                    w.blue(Slice[char](cur.get_length(), cur.get_buffer() as pointer[char]))
                else
                    w.chunk(Slice[char](cur.get_length(), cur.get_buffer() as pointer[char]))
            }
            else
                w.chunk(Help.spaces(host, left_align_of_right))
            var idx remain.length as int
            if right_count < idx
                set idx: right_count
            if idx < 0
                set idx: 0
            w.chunk(remain.subslice(0, idx as size_t))
            set remain: remain.slice_from(idx as size_t)
            w.chunk("\n")
            set first: false
        }
    }

    ; generateOptionOutput
    procedure option_output(w: ref[HelpWriter], o: HelpOption, right_align_of_left: int, left_align_of_right: int)
    {
        let host w.host
        let name Help.display_name(host, o)
        let description_code Help.description_of(o)
        var description Slice[char]()
        if description_code <> 0
            set description: Help.message(description_code)
        let value_type Help.value_type(o)
        let has_candidates (value_type.length as int) > 0
        let default_text Help.default_text(o)
        if w.terminal_width >= 80
        {
            Help.pretty_output(w, name, description, right_align_of_left, left_align_of_right, true)
            w.chunk("\n")
            if Help.shows_additional_info(o)
            {
                if has_candidates
                {
                    Help.pretty_output(w, value_type, Help.possible_values(o), right_align_of_left, left_align_of_right, false)
                    w.chunk("\n")
                }
                if (default_text.length as int) > 0
                {
                    Help.pretty_output(w, Help.message(DiagX_default_Colon), default_text, right_align_of_left, left_align_of_right, false)
                    w.chunk("\n")
                }
            }
            w.chunk("\n")
            return
        }
        w.blue(name)
        w.chunk("\n")
        if description_code <> 0
            w.chunk(description)
        w.chunk("\n")
        if Help.shows_additional_info(o)
        {
            if has_candidates
            {
                w.chunk(value_type)
                w.chunk(" ")
                w.chunk(Help.possible_values(o))
            }
            if (default_text.length as int) > 0
            {
                if has_candidates
                    w.chunk("\n")
                w.chunk(Help.message(DiagX_default_Colon))
                w.chunk(" ")
                w.chunk(default_text)
            }
            w.chunk("\n")
        }
        w.chunk("\n")
    }

    ; generateGroupOptionOutput
    procedure group_output(w: ref[HelpWriter], options: ref[Array[HelpOption]])
    {
        let host w.host
        var max_length 0
        var i 0
        while i < (options.get_length() as int)
        {
            let n Help.display_name(host, options[i as size_t]).length as int
            if n > max_length
                set max_length: n
            set i: i + 1
        }
        let right_align_of_left max_length + 2
        let left_align_of_right right_align_of_left + 2
        let start_count w.count
        var k 0
        while k < (options.get_length() as int)
        {
            Help.option_output(w, options[k as size_t], right_align_of_left, left_align_of_right)
            set k: k + 1
        }
        if ((w.count - start_count) < 2) or (w.before_last_newline = false)
            w.chunk("\n")
    }

    ; generateSectionOptionsOutput
    procedure section_output(w: ref[HelpWriter], section_name: Slice[char], options: ref[Array[HelpOption]], sub_category: bool, before: Slice[char], after: Slice[char])
    {
        let host w.host
        w.bold(section_name)
        w.chunk("\n")
        w.chunk("\n")
        if (before.length as int) > 0
        {
            w.chunk(before)
            w.chunk("\n")
            w.chunk("\n")
        }
        if sub_category = false
        {
            Help.group_output(w, options)
            if (after.length as int) > 0
            {
                w.chunk(after)
                w.chunk("\n")
                w.chunk("\n")
            }
            return
        }
        let categories &Array[int]^host()
        var i 0
        while i < (options.get_length() as int)
        {
            let c Help.category_of(options[i as size_t])
            set i: i + 1
            if c = 0
                continue
            var seen false
            var k 0
            while k < (categories.get_length() as int)
            {
                if categories[k as size_t] = c
                    set seen: true
                set k: k + 1
            }
            if seen = false
                categories.add(c)
        }
        var ci 0
        while ci < (categories.get_length() as int)
        {
            let c categories[ci as size_t]
            set ci: ci + 1
            let group &Array[HelpOption]^host()
            var j 0
            while j < (options.get_length() as int)
            {
                let o options[j as size_t]
                if Help.category_of(o) = c
                    group.add(o)
                set j: j + 1
            }
            w.chunk("### ")
            w.chunk(Help.message(c))
            w.chunk("\n")
            w.chunk("\n")
            Help.group_output(w, group)
        }
        if (after.length as int) > 0
        {
            w.chunk(after)
            w.chunk("\n")
            w.chunk("\n")
        }
    }

    procedure example(w: ref[HelpWriter], line: Slice[char], code: int)
    {
        w.chunk("  ")
        w.blue(line)
        w.chunk("\n")
        w.chunk("  ")
        w.chunk(Help.message(code))
        w.chunk("\n")
        w.chunk("\n")
    }

    ; PrintHelp: the easy view, or --all's
    procedure print_help(sys: ref[ExecSystem], pretty: bool, all: bool)
    {
        let host sys.host
        let w HelpWriter.create(host, sys, pretty)
        let options Help.compiler_options(host)
        options.add(HelpOption(2, 0))
        if all
        {
            Help.print_all_help(w, options)
            return
        }
        Help.header(w, Help.title(host))
        w.bold(Help.message(DiagCOMMON_COMMANDS))
        w.chunk("\n")
        w.chunk("\n")
        Help.example(w, "tsc", DiagCompiles_the_current_project_tsconfig_json_in_the_working_directory)
        Help.example(w, "tsc app.ts util.ts", DiagIgnoring_tsconfig_json_compiles_the_specified_files_with_default_compiler_options)
        Help.example(w, "tsc -b", DiagBuild_a_composite_project_in_the_working_directory)
        Help.example(w, "tsc --init", DiagCreates_a_tsconfig_json_with_the_recommended_settings_in_the_working_directory)
        Help.example(w, "tsc -p ./path/to/tsconfig.json", DiagCompiles_the_TypeScript_project_located_at_the_specified_path)
        Help.example(w, "tsc --help --all", DiagAn_expanded_version_of_this_information_showing_all_possible_compiler_options)
        w.chunk("  ")
        w.blue("tsc --noEmit")
        w.chunk("\n")
        w.chunk("  ")
        w.blue("tsc --target esnext")
        w.chunk("\n")
        w.chunk("  ")
        w.chunk(Help.message(DiagCompiles_the_current_project_with_additional_settings))
        w.chunk("\n")
        w.chunk("\n")
        let cli &Array[HelpOption]^host()
        let config &Array[HelpOption]^host()
        var i 0
        while i < (options.get_length() as int)
        {
            let o options[i as size_t]
            set i: i + 1
            if Help.simplified(o) = false
                continue
            if Help.command_line_only(o) or (Help.category_of(o) = DiagCommand_line_Options)
                cli.add(o)
            else
                config.add(o)
        }
        Help.section_output(w, Help.message(DiagCOMMAND_LINE_FLAGS), cli, false, "", "")
        Help.section_output(w, Help.message(DiagCOMMON_COMPILER_OPTIONS), config, false, "", Help.message1(host, DiagYou_can_learn_about_all_of_the_compiler_options_at_0, "https://aka.ms/tsc"))
    }

    function lower_less(a: Slice[char], b: Slice[char]) returns int
    {
        var i 0
        while (i < (a.length as int)) and (i < (b.length as int))
        {
            var x *(a.data + i) as int
            var y *(b.data + i) as int
            if (x >= 65) and (x <= 90)
                set x: x + 32
            if (y >= 65) and (y <= 90)
                set y: y + 32
            if x <> y
                return x - y
            set i: i + 1
        }
        (a.length as int) - (b.length as int)
    }

    ; printAllHelp
    procedure print_all_help(w: ref[HelpWriter], options: ref[Array[HelpOption]])
    {
        let host w.host
        let sorted &Array[HelpOption]^host()
        var i 0
        while i < (options.get_length() as int)
        {
            let o options[i as size_t]
            set i: i + 1
            sorted.add(o)
            var j (sorted.get_length() as int) - 1
            while j > 0
            {
                let prev sorted[(j - 1) as size_t]
                if Help.lower_less(Help.name_of(prev), Help.name_of(o)) <= 0
                    break
                sorted.put(j as size_t, prev)
                set j: j - 1
            }
            sorted.put(j as size_t, o)
        }
        Help.header(w, Help.title(host))
        Help.section_output(w, Help.message(DiagALL_COMPILER_OPTIONS), sorted, true, "", Help.message1(host, DiagYou_can_learn_about_all_of_the_compiler_options_at_0, "https://aka.ms/tsc"))
        let watch &Array[HelpOption]^host()
        var wi 0
        while wi < TsOptionDecls.watch_count()
        {
            watch.add(HelpOption(1, wi))
            set wi: wi + 1
        }
        Help.section_output(w, Help.message(DiagWATCH_OPTIONS), watch, false, Help.message(DiagIncluding_watch_w_will_start_watching_the_current_project_for_the_file_changes_Once_set_you_can_config_watch_mode_with_Colon), "")
        Help.build_section(w)
    }

    procedure build_section(w: ref[HelpWriter])
    {
        let host w.host
        let build &Array[HelpOption]^host()
        var bi 1
        while bi < TsOptionDecls.build_count()
        {
            build.add(HelpOption(2, bi))
            set bi: bi + 1
        }
        Help.section_output(w, Help.message(DiagBUILD_OPTIONS), build, false, Help.message1(host, DiagUsing_build_b_will_make_tsc_behave_more_like_a_build_orchestrator_than_a_compiler_This_is_used_to_trigger_building_composite_projects_which_you_can_learn_more_about_at_0, "https://aka.ms/tsc-composite-builds"), "")
    }

    ; PrintBuildHelp
    procedure print_build_help(sys: ref[ExecSystem], pretty: bool)
    {
        let w HelpWriter.create(sys.host, sys, pretty)
        let host sys.host
        Help.header(w, Help.title(host))
        ; BuildOpts: commonOptionsWithBuild, then OptionsForBuild without TscBuildOption
        let options &Array[HelpOption]^host()
        var ci 0
        while TsOptionDecls.is_common_with_build(ci)
        {
            options.add(HelpOption(0, ci))
            set ci: ci + 1
        }
        var bi 1
        while bi < TsOptionDecls.build_count()
        {
            options.add(HelpOption(2, bi))
            set bi: bi + 1
        }
        Help.section_output(w, Help.message(DiagBUILD_OPTIONS), options, false, Help.message1(host, DiagUsing_build_b_will_make_tsc_behave_more_like_a_build_orchestrator_than_a_compiler_This_is_used_to_trigger_building_composite_projects_which_you_can_learn_more_about_at_0, "https://aka.ms/tsc-composite-builds"), "")
    }
}

; tsc/init.go: WriteConfigFile and generateTSConfig
define Init (reserved: int)
{
    ; WriteConfigFile; true when the file exists (the caller reports)
    procedure write_config_file(sys: ref[ExecSystem], pretty: bool, raw: ref[TsOptions]) returns bool
    {
        let host sys.host
        let file get_normalized_absolute_path(host, combine_paths(host, sys.cwd, "tsconfig.json"), Slice[char]())
        if sys.file_exists(file)
            return true
        let text Init.generate(host, raw)
        sys.write_file(file, Slice[char](text.get_length(), text.get_buffer() as pointer[char]))
        let w HelpWriter.create(host, sys, pretty)
        w.chunk("\n")
        Help.header(w, "Created a new tsconfig.json")
        w.chunk("You can learn more at https://aka.ms/tsconfig")
        w.chunk("\n")
        false
    }

    ; encoding/json's string encoding (HTML-safe, as json.Marshal writes it)
    procedure json_string(sb: ref[StringBuilder], s: Slice[char])
    {
        let hex: Slice[char] "0123456789abcdef"
        sb.append("\"" as char)
        let n s.length as int
        var i 0
        while i < n
        {
            let c (*(s.data + i) as int) & 255
            if (c = 34) or (c = 92)
            {
                sb.append("\\" as char)
                sb.append(c as char)
                set i: i + 1
                continue
            }
            if (c < 32) or (c = 60) or (c = 62) or (c = 38)
            {
                if c = 10
                    sb.append("\\n")
                else
                {
                    if c = 13
                        sb.append("\\r")
                    else
                    {
                        if c = 9
                            sb.append("\\t")
                        else
                        {
                            sb.append("\\u00")
                            sb.append(*(hex.data + (c >> 4)))
                            sb.append(*(hex.data + (c & 15)))
                        }
                    }
                }
                set i: i + 1
                continue
            }
            ; U+2028 and U+2029
            if (c = 0xE2) and ((i + 2) < n)
            {
                let c1 (*(s.data + i + 1) as int) & 255
                let c2 (*(s.data + i + 2) as int) & 255
                if (c1 = 0x80) and ((c2 = 0xA8) or (c2 = 0xA9))
                {
                    if c2 = 0xA8
                        sb.append("\\u2028")
                    else
                        sb.append("\\u2029")
                    set i: i + 3
                    continue
                }
            }
            sb.append(c as char)
            set i: i + 1
        }
        sb.append("\"" as char)
    }

    ; formatSingleValue over a parsed value; `option` the declaration whose enum map
    ; maps it back to its first key, -1 for none
    procedure format_single_value(sb: ref[StringBuilder], v: ref[JsonValue]?, option: int)
    {
        if v = null
        {
            sb.append("null")
            return
        }
        let jv v as ref[JsonValue]
        if jv.kind = JsonKindBoolean
        {
            if jv.truth
                sb.append("true")
            else
                sb.append("false")
            return
        }
        if jv.kind = JsonKindNumber
        {
            sb.append(jv.text.data, jv.text.length)
            return
        }
        if jv.kind = JsonKindString
        {
            if option >= 0
            {
                let key TsOptionDecls.enum_first_key(option, jv.text)
                if (key.length as int) > 0
                {
                    Init.json_string(sb, key)
                    return
                }
            }
            Init.json_string(sb, jv.text)
            return
        }
        sb.append("null")
    }

    ; formatValueOrArray
    procedure format_value_or_array(sb: ref[StringBuilder], setting: Slice[char], v: ref[JsonValue]?)
    {
        let option TsOptionDecls.index_of(setting)
        var is_enum false
        if option >= 0
            set is_enum: (TsOptionDecls.kind_of(option) = TsOptionKindEnum) or (TsOptionDecls.element_kind_of(option) = TsOptionKindEnum)
        var enum_option 0 - 1
        if is_enum
            set enum_option: option
        if v <> null
        {
            let jv v as ref[JsonValue]
            if jv.kind = JsonKindArray
            {
                sb.append("[" as char)
                var i 0
                while i < jv.size()
                {
                    if i > 0
                        sb.append(", ")
                    Init.format_single_value(sb, jv.value_at(i), enum_option)
                    set i: i + 1
                }
                sb.append("]" as char)
                return
            }
        }
        Init.format_single_value(sb, v, enum_option)
    }

    procedure line(host: ref[Page], lines: ref[StringBuilder], text: Slice[char])
    {
        lines.append(text.data, text.length)
        lines.append("\n")
    }

    procedure header(lines: ref[StringBuilder], code: int)
    {
        lines.append("    // ")
        let text DiagnosticMessages.text_of(code)
        lines.append(text.data, text.length)
        lines.append("\n")
    }

    ; emitOption; `mode` 0 never commented, 1 always, 2 unless set; `remaining`
    ; the set options not yet written
    procedure emit_option(host: ref[Page], lines: ref[StringBuilder], raw: ref[TsOptions], remaining: ref[Array[Slice[char]]], setting: Slice[char], default_value: ref[JsonValue]?, mode: int)
    {
        var k 0
        while k < (remaining.get_length() as int)
        {
            let r remaining[k as size_t]
            if r.equals(setting)
            {
                var j k
                while (j + 1) < (remaining.get_length() as int)
                {
                    remaining.put(j as size_t, remaining[(j + 1) as size_t])
                    set j: j + 1
                }
                remaining.put(j as size_t, "")
                Init.truncate(remaining)
                break
            }
            set k: k + 1
        }
        let index raw.index_of_name(setting)
        var comment false
        if mode = 1
            set comment: true
        if mode = 2
            set comment: index < 0
        var value default_value
        if index >= 0
            set value: raw.value_at(index)
        if comment
            lines.append("    // \"")
        else
            lines.append("    \"")
        lines.append(setting.data, setting.length)
        lines.append("\": ")
        Init.format_value_or_array(lines, setting, value)
        lines.append(",\n")
    }

    ; the list without its trailing empty entry (Array has no remove)
    procedure truncate(list: ref[Array[Slice[char]]])
    {
        let host Page.get(list)
        let copy &Array[Slice[char]]^host()
        var i 0
        while i < (list.get_length() as int)
        {
            let item list[i as size_t]
            if (item.length as int) > 0
                copy.add(item)
            set i: i + 1
        }
        set list.length: 0
        var j 0
        while j < (copy.get_length() as int)
        {
            list.add(copy[j as size_t])
            set j: j + 1
        }
    }

    function value(host: ref[Page], kind: int, text: Slice[char], truth: bool) returns ref[JsonValue]
        &JsonValue^host(kind, text, truth, null, null)

    ; generateTSConfig
    procedure generate(host: ref[Page], raw: ref[TsOptions]) returns String
    {
        let remaining &Array[Slice[char]]^host()
        var i 0
        while i < raw.count()
        {
            let name raw.name_at(i)
            set i: i + 1
            if name.equals("init") or name.equals("help") or name.equals("watch")
                continue
            remaining.add(name)
        }
        let t Init.value(host, JsonKindBoolean, "", true)
        let lines StringBuilder^host()
        lines.append("{\n")
        lines.append("  // ")
        let visit DiagnosticMessages.text_of(DiagVisit_https_Colon_Slash_Slashaka_ms_Slashtsconfig_to_read_more_about_this_file)
        lines.append(visit.data, visit.length)
        lines.append("\n")
        lines.append("  \"compilerOptions\": {\n")
        Init.header(&lines, DiagFile_Layout)
        Init.emit_option(host, &lines, raw, remaining, "rootDir", Init.value(host, JsonKindString, "./src", false), 2)
        Init.emit_option(host, &lines, raw, remaining, "outDir", Init.value(host, JsonKindString, "./dist", false), 2)
        lines.append("\n")
        Init.header(&lines, DiagEnvironment_Settings)
        Init.header(&lines, DiagSee_also_https_Colon_Slash_Slashaka_ms_Slashtsconfig_Slashmodule)
        Init.emit_option(host, &lines, raw, remaining, "module", Init.value(host, JsonKindString, "nodenext", false), 0)
        Init.emit_option(host, &lines, raw, remaining, "target", Init.value(host, JsonKindString, "esnext", false), 0)
        let none: Slice[char] ""
        let empty_list &JsonValue^host(JsonKindArray, none, false, null, &Array[ref[JsonValue]?]^host())
        Init.emit_option(host, &lines, raw, remaining, "types", empty_list, 0)
        if raw.index_of_name("lib") >= 0
            Init.emit_option(host, &lines, raw, remaining, "lib", null, 0)
        Init.header(&lines, DiagFor_nodejs_Colon)
        lines.append("    // \"lib\": [\"esnext\"],\n")
        lines.append("    // \"types\": [\"node\"],\n")
        Init.header(&lines, DiagX_and_npm_install_D_types_Slashnode)
        lines.append("\n")
        Init.header(&lines, DiagOther_Outputs)
        Init.emit_option(host, &lines, raw, remaining, "sourceMap", t, 0)
        Init.emit_option(host, &lines, raw, remaining, "declaration", t, 0)
        Init.emit_option(host, &lines, raw, remaining, "declarationMap", t, 0)
        lines.append("\n")
        Init.header(&lines, DiagStricter_Typechecking_Options)
        Init.emit_option(host, &lines, raw, remaining, "noUncheckedIndexedAccess", t, 0)
        Init.emit_option(host, &lines, raw, remaining, "exactOptionalPropertyTypes", t, 0)
        lines.append("\n")
        Init.header(&lines, DiagStyle_Options)
        Init.emit_option(host, &lines, raw, remaining, "noImplicitReturns", t, 2)
        Init.emit_option(host, &lines, raw, remaining, "noImplicitOverride", t, 2)
        Init.emit_option(host, &lines, raw, remaining, "noUnusedLocals", t, 2)
        Init.emit_option(host, &lines, raw, remaining, "noUnusedParameters", t, 2)
        Init.emit_option(host, &lines, raw, remaining, "noFallthroughCasesInSwitch", t, 2)
        Init.emit_option(host, &lines, raw, remaining, "noPropertyAccessFromIndexSignature", t, 2)
        lines.append("\n")
        Init.header(&lines, DiagRecommended_Options)
        Init.emit_option(host, &lines, raw, remaining, "strict", t, 0)
        Init.emit_option(host, &lines, raw, remaining, "jsx", Init.value(host, JsonKindString, "react-jsx", false), 0)
        Init.emit_option(host, &lines, raw, remaining, "verbatimModuleSyntax", t, 0)
        Init.emit_option(host, &lines, raw, remaining, "isolatedModules", t, 0)
        Init.emit_option(host, &lines, raw, remaining, "noUncheckedSideEffectImports", t, 0)
        Init.emit_option(host, &lines, raw, remaining, "moduleDetection", Init.value(host, JsonKindString, "force", false), 0)
        Init.emit_option(host, &lines, raw, remaining, "skipLibCheck", t, 0)
        if remaining.get_length() > 0
        {
            lines.append("\n")
            while remaining.get_length() > 0
            {
                let first remaining[0]
                Init.emit_option(host, &lines, raw, remaining, first, null, 0)
            }
        }
        lines.append("  }\n")
        lines.append("}\n")
        lines.to_string()
    }
}
