; `valuesOfNonBinaryUnicodeProperties[propertyName].Has(value)`, where the name
; is this file's int. Every canonical name has a set, so the reference's
; `values != nil` test cannot fail and is not ported; id 0 never reaches here,
; because its one caller has already branched on it.
function values_of_non_binary_unicode_property_has(property: int, s: Slice[char]) returns bool
{
    if property = 1
        return is_general_category_value(s)
    is_script_value(s)
}
