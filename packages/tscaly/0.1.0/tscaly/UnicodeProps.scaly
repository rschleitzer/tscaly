            return true
    }
    if s.length = 17
    {
        if kw_eq(s.data, Slice[char](17, "Old_North_Arabian"))
            return true
        if kw_eq(s.data, Slice[char](17, "Old_South_Arabian"))
            return true
    }
    if s.length = 18
    {
        if kw_eq(s.data, Slice[char](18, "Caucasian_Albanian"))
            return true
    }
    if s.length = 19
    {
        if kw_eq(s.data, Slice[char](19, "Canadian_Aboriginal"))
            return true
        if kw_eq(s.data, Slice[char](19, "Khitan_Small_Script"))
            return true
    }
    if s.length = 20
    {
        if kw_eq(s.data, Slice[char](20, "Egyptian_Hieroglyphs"))
            return true
        if kw_eq(s.data, Slice[char](20, "Katakana_Or_Hiragana"))
            return true
        if kw_eq(s.data, Slice[char](20, "Meroitic_Hieroglyphs"))
            return true
    }
    if s.length = 21
    {
        if kw_eq(s.data, Slice[char](21, "Anatolian_Hieroglyphs"))
            return true
        if kw_eq(s.data, Slice[char](21, "Inscriptional_Pahlavi"))
            return true
    }
    if s.length = 22
    {
        if kw_eq(s.data, Slice[char](22, "Inscriptional_Parthian"))
            return true
        if kw_eq(s.data, Slice[char](22, "Nyiakeng_Puachue_Hmong"))
            return true
    }
    false
}

; `valuesOfNonBinaryUnicodeProperties[propertyName].Has(value)`, where the name
; is this file's int. Every canonical name has a set, so the reference's
; `values != nil` test cannot fail and is not ported; id 0 never reaches here,
; because its one caller has already branched on it.
function values_of_non_binary_unicode_property_has(property: int, s: Slice[char]) returns bool
{
    if property = 1
        return is_general_category_value(s)
    is_script_value(s)
}
