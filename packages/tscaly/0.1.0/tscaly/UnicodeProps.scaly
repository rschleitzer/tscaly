; Table 66: the non-binary property aliases and their canonical names.
; https://tc39.es/ecma262/#table-nonbinary-unicode-properties
function non_binary_unicode_property(s: Slice[char]) returns int
{
    if s.length = 2
    {
        if kw_eq(s, "gc")
            return 1
        if kw_eq(s, "sc")
            return 2
    }
    if s.length = 3
    {
        if kw_eq(s, "scx")
            return 3
    }
    if s.length = 6
    {
        if kw_eq(s, "Script")
            return 2
    }
    if s.length = 16
    {
        if kw_eq(s, "General_Category")
            return 1
    }
    if s.length = 17
    {
        if kw_eq(s, "Script_Extensions")
            return 3
    }
    0
}

