; SPDX-License-Identifier: Apache-2.0
;
; ArithCheck — the SECOND PRODUCER for jsnum's ARITHMETIC, and NumCheck's twin
; for the same reason one file over.
;
; Slice 116 added the other half of internal/jsnum: the five bitwise operators,
; the three shifts, the four arithmetic ones and the two the enum evaluator needs
; beside them. The checker yardstick sees them through ENUM MEMBER VALUES and
; nowhere else, and the corpus's enums are almost all small non-negative
; integers — so ToInt32's modulus, the shift count's mask, NaN's propagation
; through a remainder, the sign of a negative zero and `-1 >>> 0` are between
; them zero units. An unexercised arm is indistinguishable from a correct one
; (§3.5v's fourth row), so they get an instrument.
;
; One line of the corpus is TWO 16-hex-digit bit patterns, so the generator can
; reach any pair of doubles — which a decimal text cannot, and a TypeScript
; source certainly cannot. One line of output is thirteen results in the fixed
; order tests/oracle/arith.go writes, each as bits: a rendering would be measuring
; jsnum_to_string a second time, and two wrongs there cancel.
;
; It lives in the PACKAGE rather than the program root for NumCheck's reason: the
; accumulator is a container, and a generic instance handed to a program root
; reads back as garbage.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.Console

define ArithCheck
{
    procedure append_hex(mutable out: ref[StringBuilder], bits: u64)
    {
        var k 60
        while k >= 0
        {
            let nib ((bits >> (k as u64)) & (0xF as u64)) as int
            if nib < 10
                out.append((nib + (("0" as char) as int)) as char)
            else
                out.append(((nib - 10) + (("A" as char) as int)) as char)
            set k: k - 4
        }
    }

    ; One 16-digit hex field of the corpus line, read back into the bits it
    ; spells. The corpus is generated by this suite, so a malformed digit is a
    ; harness defect rather than an input — it answers 0 and the diff says so.
    function read_hex(d: Slice[char], start: int, stop: int) returns u64
    {
        var v 0 as u64
        var i start
        while i < stop
        {
            let c d[i] as int
            var nib 0 - 1
            if (c >= (("0" as char) as int)) and (c <= (("9" as char) as int))
                set nib: c - (("0" as char) as int)
            if (c >= (("a" as char) as int)) and (c <= (("f" as char) as int))
                set nib: (c - (("a" as char) as int)) + 10
            if (c >= (("A" as char) as int)) and (c <= (("F" as char) as int))
                set nib: (c - (("A" as char) as int)) + 10
            if nib < 0
                return v
            set v: (v << (4 as u64)) | (nib as u64)
            set i: i + 1
        }
        v
    }

    procedure run(host: ref[Page], text: String)
    {
        let out StringBuilder^host()
        let d Slice[char](text.get_length(), text.get_buffer() as pointer[char])
        var n text.get_length() as int
        if n > 0
        {
            if (d[(n - 1)] as int) = (("\n" as char) as int)
                set n: n - 1
        }

        var i 0
        while i < n
        {
            var e i
            while e < n
            {
                if (d[e] as int) = (("\n" as char) as int)
                    break
                set e: e + 1
            }
            var sp i
            while sp < e
            {
                if (d[sp] as int) = ((" " as char) as int)
                    break
                set sp: sp + 1
            }
            let a ArithCheck.read_hex(d, i, sp)
            let b ArithCheck.read_hex(d, sp + 1, e)

            ArithCheck.append_hex(out, jsnum_add(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_subtract(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_multiply(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_divide(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_remainder(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_exponentiate(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_bitwise_or(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_bitwise_and(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_bitwise_xor(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_left_shift(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_signed_right_shift(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_unsigned_right_shift(a, b))
            out.append(" " as char)
            ArithCheck.append_hex(out, jsnum_bitwise_not(a))
            out.append("\n" as char)

            set i: e + 1
        }

        let s out.to_string()
        Console.print(s.to_c_string())
    }
}
