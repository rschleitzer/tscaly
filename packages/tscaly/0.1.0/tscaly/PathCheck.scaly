; SPDX-License-Identifier: Apache-2.0
;
; PathCheck — the SECOND PRODUCER for tspath's absolute-path arms, and it exists
; because the corpus cannot reach them.
;
; `get_normalized_absolute_path` is asked one shape of question by the yardsticks:
; a clean repo-relative path under a clean absolute working directory. Its root
; scanner distinguishes POSIX, UNC, a DOS volume, `^/` and two kinds of URL, and
; its segment loop folds `.`, `..`, doubled and trailing separators — none of
; which any harness path contains. A port whose unexercised arms are wrong is
; indistinguishable from a port whose unexercised arms are right (§3.5v's fourth
; row), so those arms get an instrument of their own: tests/pathcheck.sh feeds the
; same generated corpus to this and to the reference's own tspath and diffs.
;
; One line of the corpus is `<cwd>TAB<path>`; one line of output is
;
;     <length after RemoveFileExtension> <the normalized absolute path>
;
; which is exactly the pair the binder computes for a module symbol's name — the
; number first, because a path may contain a space.
;
; It lives in the PACKAGE rather than in the program root for the reason the
; symbol dump does: the accumulator is a container, and a generic instance handed
; to a program root reads back as garbage.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.Console

define PathCheck
{
    procedure run(host: ref[Page], text: String)
    {
        ; StringBuilder^host() and not allocate-then-assign — its init allocates
        ; through Page.get(this); see SymbolDump.write for the whole account.
        let out StringBuilder^host()

        let d text.get_buffer() as pointer[char]
        let n text.get_length() as int
        var i 0
        while i < n
        {
            var e i
            while e < n
            {
                if (*(d + e) as int) = (("\n" as char) as int)
                    break
                set e: e + 1
            }

            var t i
            while t < e
            {
                if (*(d + t) as int) = (("\t" as char) as int)
                    break
                set t: t + 1
            }

            ; An empty line is not a case — the corpus ends in a newline.
            if e > i
            {
                let wd d + i
                let wl t - i
                var ps t
                if ps < e
                    set ps: t + 1
                let fd d + ps
                let fl e - ps

                var od Slice[char]()
                set od: get_normalized_absolute_path(host, Slice[char](fl, fd), Slice[char](wl, wd))
                out.append(remove_file_extension(od))
                out.append(" " as char)
                var k 0
                while k < od.length
                {
                    out.append(od[k])
                    set k: k + 1
                }
                out.append("\n" as char)
            }

            set i: e + 1
        }

        let s out.to_string()
        Console.print(s.to_c_string())
    }
}
