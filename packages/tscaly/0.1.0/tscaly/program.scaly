; ── small string helpers over Slice[char] (page-hosted results) ────────────────

function join_slices(host: ref[Page], a: Slice[char], b: Slice[char]) returns Slice[char]
{
    let n (a.length + b.length) as int
    let buf host.allocate((n + 1) as size_t, 1) as pointer[char]
    var i 0
    while i < (a.length as int)
    {
        set *(buf + i): a[i as size_t]
        set i: i + 1
    }
    var j 0
    while j < (b.length as int)
    {
        set *(buf + i + j): b[j as size_t]
        set j: j + 1
    }
    Slice[char](n as size_t, buf)
}

function slice_index_of_byte(d: Slice[char], c: int) returns int
{
    var i 0
    while i < (d.length as int)
    {
        if (d[i as size_t] as int) = c
            return i
        set i: i + 1
    }
    0 - 1
}

function slice_last_index_of_byte(d: Slice[char], c: int) returns int
{
    var i (d.length as int) - 1
    while i >= 0
    {
        if (d[i as size_t] as int) = c
            return i
        set i: i - 1
    }
    0 - 1
}

function slice_contains_byte(d: Slice[char], c: int) returns bool
    slice_index_of_byte(d, c) >= 0

; tspath.IsDeclarationFileName: `.d.ts`, `.d.mts`, `.d.cts`, or `.d.<ext>.ts`
function is_declaration_file_name_of(d: Slice[char]) returns bool
{
    if d.ends_with(".d.ts") or d.ends_with(".d.mts") or d.ends_with(".d.cts")
        return true
    if d.ends_with(".ts") = false
        return false
    ; the base name carries `.d.` somewhere before its last `.ts`
    let slash slice_last_index_of_byte(d, ("/" as char) as int)
    var i slash + 1
    let n (d.length as int) - 3
    while (i + 2) < n
    {
        if ((d[i as size_t] as int) = ("." as char) as int) and ((d[(i + 1) as size_t] as int) = ("d" as char) as int) and ((d[(i + 2) as size_t] as int) = ("." as char) as int)
            return true
        set i: i + 1
    }
    false
}

; tspath.HasImplementationTSFileExtension: .ts .tsx .mts .cts, not a declaration
function has_implementation_ts_file_extension(d: Slice[char]) returns bool
{
    if is_declaration_file_name_of(d)
        return false
    d.ends_with(".ts") or d.ends_with(".tsx") or d.ends_with(".mts") or d.ends_with(".cts")
}

; module/util.go ParsePackageName: the split between the package and the rest,
; a scoped name (`@scope/name`) keeping its two segments; -1 when there is none
function package_name_split(name: Slice[char]) returns int
{
    var idx slice_index_of_byte(name, ("/" as char) as int)
    if ((name.length as int) > 0) and ((name[0] as int) = ("@" as char) as int)
    {
        let offset idx + 1
        let rest name.slice_from(offset as size_t)
        let idx2 slice_index_of_byte(rest, ("/" as char) as int)
        if idx2 < 0
            return 0 - 1
        set idx: idx2 + offset
    }
    idx
}

; module/util.go MangleScopedPackageName: `@scope/name` → `scope__name`
function mangle_scoped_package_name(host: ref[Page], name: Slice[char]) returns Slice[char]
{
    if ((name.length as int) = 0) or ((name[0] as int) <> ("@" as char) as int)
        return name
    let slash slice_index_of_byte(name, ("/" as char) as int)
    if slash < 0
        return name
    let sb StringBuilder^host()
    let scope name.subslice(1, slash as size_t)
    sb.append(scope.data, scope.length)
    sb.append("__")
    let rest name.slice_from((slash + 1) as size_t)
    sb.append(rest.data, rest.length)
    let s String^host(sb.to_string())
    Slice[char](s.get_length(), s.get_buffer() as pointer[char])
}

; strings.Contains(path, "/node_modules/")
function slice_contains_node_modules(path: Slice[char]) returns bool
{
    var i 0
    while (i + 14) <= (path.length as int)
    {
        let piece path.subslice(i as size_t, (i + 14) as size_t)
        if piece.equals("/node_modules/")
            return true
        set i: i + 1
    }
    false
}

; ★★★ WHAT THE FILE LOADER NEEDS TO ANSWER A RESOLUTION MODE, AND IT IS NOT A
; CHECKER (slice 293). Upstream's `fileloader.go` holds none: `getModeForUsageLocation`
; and `getDefaultResolutionModeForFile` are free functions over
; `(fileName, SourceFileMetaData, options)`, and this port asked a Checker for them —
; which is why the checker had to exist before the walk, which is why every file had
; to be bound before the walk, which is why `bindSourceFiles` could not be a block of
; its own. The chain is pure; this record is its inputs.
define ResolutionContext
(
    files: ref[ProgramFiles]?
    module_kind: int
    module_resolution_kind: int
    resolve_exports: int
    resolve_imports: int
    emit_module_format: int
)

; ── the program's file table ───────────────────────────────────────────────────

define ProgramFiles
(
    paths: ref[Array[Slice[char]]]
    texts: ref[Array[Slice[char]]]
    files: ref[Array[ref[AstNode]?]]
    binders: ref[Array[ref[Binder]?]]
    parsers: ref[Array[ref[Parser]?]]
    emits: ref[Array[bool]]
    formats: ref[Array[int]]
    ; SourceFileMetaData.PackageJsonType per file (slice 253), set with the format
    package_json_types: ref[Array[Slice[char]]]
    ; `file.IsExternalModule()` and the moduleDetection half of it — PARSE-time
    ; answers, recorded here since slice 293 so that the loader and the specifier
    ; host can ask them while walking without a BINDER, which is what let the bind
    ; become a pass of its own
    externals: ref[Array[bool]]
    forced_modules: ref[Array[bool]]
    ; whether the collection has already named this entry — see rename_path_once
    path_claimed: ref[Array[bool]]
    ; the file system's symlinks (slice 260): `link_paths[i]` is a symlink to
    ; `link_targets[i]`, a file or a directory
    link_paths: ref[Array[Slice[char]]]
    link_targets: ref[Array[Slice[char]]]
    ; the resolutions that went through a symlink inside node_modules, the
    ; resolved module's OriginalPath beside its realpath (the symlink cache's input)
    resolution_originals: ref[Array[Slice[char]]]
    resolution_realpaths: ref[Array[Slice[char]]]
    ; compilerOptions.CustomConditions (slice 260)
    custom_conditions: ref[Array[Slice[char]]]
    ; the case's config file (slice 268): its program path and text, for the
    ; option diagnostics' locations
    config_path: Slice[char]
    config_text: Slice[char]
    ; the files the program holds (the file loader's answer), null for all
    members: ref[Array[bool]]?
    ; tryLoadInputFileForPath's options (slice 268): declarationDir and the config
    ; file's path, absolute, and the current directory
    declaration_dir: Slice[char]
    config_file_path: Slice[char]
    current_directory: Slice[char]
    ; compilerOptions.TypeRoots as absolute paths, empty when the option is unset
    ; (the module resolver's resolveFromTypeRoot reads only an explicit one)
    type_roots: ref[Array[Slice[char]]]
    ; the file loader's resolvedModules keys (program.GetResolvedModule): one
    ; `<file index>:<module name>` per name it resolved for a file; null without a
    ; loader, when the checker resolves on its own
    resolution_keys: ref[Array[Slice[char]]]?
    ; package deduplication (filesByPath of a redirect): per table index the file
    ; a second instance of a package resolves to, -1 for none; null for no redirect
    redirect_targets: ref[Array[int]]?
    ; the resolver's packageJsonInfoCache keys: every package.json path looked up,
    ; and whether it exists (the incremental program's packageJsons)
    package_json_lookups: ref[Array[Slice[char]]]
    package_json_found: ref[Array[bool]]
    ; whether lookups are recorded: the driver's program turns it on once its own
    ; pre-pass over the file system is done
    package_json_recording: bool
    ; a referenced project's source per table index: its output declaration file
    ; (the checker's TS6305), null when the program has no references
    reference_outputs: ref[Array[Slice[char]]]?
    ; a referenced project's output declaration file per table index: whether that
    ; project preserves const enums (GetProjectReferenceFromOutputDts)
    reference_dts_preserve: ref[Array[int]]?
    ; outputFileToProjectReferenceSource: an output declaration file a redirected
    ; source task loaded, and that source
    included_outputs: ref[Array[Slice[char]]]
    included_output_sources: ref[Array[Slice[char]]]
    ; compilerOptions.paths (null for none) and GetPathsBasePath
    paths_option: ref[JsonValue]?
    paths_base_path: Slice[char]
    ; a referenced project's output declaration file or source per table index: its
    ; emit module format under that project's options (-1 for none)
    reference_module_formats: ref[Array[int]]?
    ; a referenced project's source or output declaration file per table index: 1
    ; when the relative path between the projects' outputs differs from the one
    ; between their root directories (TS2878)
    reference_rewrite_unsafe: ref[Array[int]]?
    ; a referenced project's source or output declaration file per table index: its
    ; redirect's `paths` (the checker's re-resolution uses them), 0 for none
    redirect_path_flags: ref[Array[int]]?
    redirect_path_values: ref[Array[ref[JsonValue]?]]?
    redirect_path_bases: ref[Array[Slice[char]]]?
    ; trackingvfs.SeenFiles: every path a read-like question named while set (the
    ; watcher's program load), null otherwise
    seen: ref[Array[Slice[char]]]?
    ; Program.GetPackagesMap: each resolved package name and whether one of its
    ; resolutions was a .d.ts
    package_map_names: ref[Array[Slice[char]]]?
    package_map_dts: ref[Array[bool]]?
    ; the file system's directories that hold no file any more (a directory stays
    ; when its files are removed), null for none known
    directory_paths: ref[Array[Slice[char]]]?
    ; compilerOptions.moduleSuffixes (comma-joined), and per table index a
    ; redirect's own (null for none)
    module_suffixes: Slice[char]
    redirect_suffixes: ref[Array[Slice[char]]]?
    ; compilerOptions.preserveSymlinks: a resolution keeps its symlinked path
    preserve_symlinks: bool
    ; useCaseSensitiveFileNames: a lookup on a case-insensitive file system folds case
    case_insensitive: bool
    ; the open-addressed index over resolution_keys (1-based key index, 0 empty),
    ; null until the first record; resolvedModules is a map upstream
    resolution_buckets: ref[Vector[int]]?
    resolution_mask: int
    ; the open-addressed index over `paths` (1-based row, 0 empty), covering the
    ; first `path_indexed` rows; a rename drops it and the next lookup rebuilds
    path_buckets: ref[Vector[int]]?
    path_mask: int
    path_indexed: int
    ; the resolver's packageJsonInfoCache: each package.json read once, keyed by its
    ; path, with the open-addressed index over the keys (1-based row, 0 empty)
    package_json_paths: ref[Array[Slice[char]]]?
    package_json_infos: ref[Array[PackageJsonInfo]]?
    package_json_buckets: ref[Vector[int]]?
    package_json_mask: int
    ; per table index the file on DISK its text is read from the first time anyone
    ; asks (empty once read, and for a text handed in); a registered file nothing
    ; reads is never read
    disk_paths: ref[Array[Slice[char]]]?
    ; per table index the text as a String on this page, made once: the parser
    ; and the binder both take a String, and each used to copy the text for itself
    strings: ref[Array[String]]?
)
{
    function create(host: ref[Page]) returns ref[ProgramFiles]
        &ProgramFiles^host(&Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[ref[AstNode]?]^host(), &Array[ref[Binder]?]^host(), &Array[ref[Parser]?]^host(), &Array[bool]^host(), &Array[int]^host(), &Array[Slice[char]]^host(), &Array[bool]^host(), &Array[bool]^host(), &Array[bool]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), null, null, null, null, null, null, &Array[Slice[char]]^host(), null, null, &Array[Slice[char]]^host(), &Array[bool]^host(), false, null, null, &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), null, null, null, null, null, null, null, null, null, null, null, null, null, false, false, null, 0, null, 0, 0, null, null, null, 0, null, null)

    procedure set_redirect_suffixes(this, index: int, suffixes: Slice[char])
    {
        if redirect_suffixes = null
        {
            let made &Array[Slice[char]]^this()
            var i 0
            while i < this.count()
            {
                made.add(Slice[char]())
                set i: i + 1
            }
            set this.redirect_suffixes: made
        }
        let list redirect_suffixes as ref[Array[Slice[char]]]
        list.put(index as size_t, slice_copy_on(Page.get(this), suffixes))
    }

    procedure set_redirect_paths(this, index: int, paths: ref[JsonValue]?, base_path: Slice[char])
    {
        if redirect_path_flags = null
        {
            let flags &Array[int]^this()
            let values &Array[ref[JsonValue]?]^this()
            let bases &Array[Slice[char]]^this()
            var i 0
            while i < this.count()
            {
                flags.add(0)
                values.add(null)
                bases.add(Slice[char]())
                set i: i + 1
            }
            set this.redirect_path_flags: flags
            set this.redirect_path_values: values
            set this.redirect_path_bases: bases
        }
        let flag_list redirect_path_flags as ref[Array[int]]
        flag_list.put(index as size_t, 1)
        let value_list redirect_path_values as ref[Array[ref[JsonValue]?]]
        value_list.put(index as size_t, paths)
        let base_list redirect_path_bases as ref[Array[Slice[char]]]
        base_list.put(index as size_t, slice_copy_on(Page.get(this), base_path))
    }

    ; the resolver's `paths` override for an importing file (a redirect's)
    ; getSourceToDtsIfSymlink: under preserveSymlinks a symlinked node_modules file
    ; stands for its real path's project reference output
    function symlink_dts_index(this, index: int) returns int
    {
        if (preserve_symlinks = false) or (index < 0)
            return index
        let path this.path_at(index)
        if slice_contains_node_modules(path) = false
            return index
        let real this.real_path(path)
        if real.equals(path)
            return index
        let real_index this.index_of_exact_path(real)
        if real_index < 0
            return index
        real_index
    }

    procedure apply_redirect_paths(this, index_in: int, resolver: ref[ModuleResolver])
    {
        let index this.symlink_dts_index(index_in)
        if (redirect_path_flags = null) or (index < 0)
            return
        let flags redirect_path_flags as ref[Array[int]]
        if index >= (flags.get_length() as int)
            return
        if flags[index as size_t] = 0
            return
        let value_list redirect_path_values as ref[Array[ref[JsonValue]?]]
        let base_list redirect_path_bases as ref[Array[Slice[char]]]
        if redirect_suffixes <> null
        {
            let suffix_list redirect_suffixes as ref[Array[Slice[char]]]
            set resolver.module_suffixes: suffix_list[index as size_t]
        }
        set resolver.has_paths_override: true
        set resolver.paths_override: value_list[index as size_t]
        set resolver.paths_base_override: base_list[index as size_t]
    }

    procedure set_reference_rewrite_unsafe(this, index: int)
    {
        if reference_rewrite_unsafe = null
        {
            let made &Array[int]^this()
            var i 0
            while i < this.count()
            {
                made.add(0)
                set i: i + 1
            }
            set this.reference_rewrite_unsafe: made
        }
        let list reference_rewrite_unsafe as ref[Array[int]]
        list.put(index as size_t, 1)
    }

    function reference_rewrite_unsafe_of(this, index: int) returns bool
    {
        if (reference_rewrite_unsafe = null) or (index < 0)
            return false
        let list reference_rewrite_unsafe as ref[Array[int]]
        if index >= (list.get_length() as int)
            return false
        list[index as size_t] = 1
    }

    procedure set_reference_module_format(this, index: int, format: int)
    {
        if reference_module_formats = null
        {
            let made &Array[int]^this()
            var i 0
            while i < this.count()
            {
                made.add(0 - 1)
                set i: i + 1
            }
            set this.reference_module_formats: made
        }
        let list reference_module_formats as ref[Array[int]]
        list.put(index as size_t, format)
    }

    function reference_module_format_of(this, index: int) returns int
    {
        if (reference_module_formats = null) or (index < 0)
            return 0 - 1
        let list reference_module_formats as ref[Array[int]]
        if index >= (list.get_length() as int)
            return 0 - 1
        list[index as size_t]
    }

    ; 1: the output of a project that preserves const enums, 0: of one that does
    ; not, -1: no project reference's output
    procedure set_reference_dts_preserve(this, index: int, preserve: bool)
    {
        if reference_dts_preserve = null
        {
            let made &Array[int]^this()
            var i 0
            while i < this.count()
            {
                made.add(0 - 1)
                set i: i + 1
            }
            set this.reference_dts_preserve: made
        }
        let list reference_dts_preserve as ref[Array[int]]
        if preserve
            list.put(index as size_t, 1)
        else
            list.put(index as size_t, 0)
    }

    function reference_dts_preserve_of(this, index: int) returns int
    {
        if (reference_dts_preserve = null) or (index < 0)
            return 0 - 1
        let list reference_dts_preserve as ref[Array[int]]
        if index >= (list.get_length() as int)
            return 0 - 1
        list[index as size_t]
    }

    procedure set_reference_output(this, index: int, output: Slice[char])
    {
        if reference_outputs = null
        {
            let made &Array[Slice[char]]^this()
            var i 0
            while i < this.count()
            {
                made.add(Slice[char]())
                set i: i + 1
            }
            set this.reference_outputs: made
        }
        let list reference_outputs as ref[Array[Slice[char]]]
        list.put(index as size_t, slice_copy_on(Page.get(this), output))
    }

    function reference_output_of(this, index: int) returns Slice[char]
    {
        if (reference_outputs = null) or (index < 0)
            return Slice[char]()
        let list reference_outputs as ref[Array[Slice[char]]]
        if index >= (list.get_length() as int)
            return Slice[char]()
        list[index as size_t]
    }

    ; GetSourceOfProjectReferenceIfOutputIncluded over a file name: the referenced
    ; project's source whose output declaration file it is, else the name itself
    function source_of_reference_output(this, file_name: Slice[char]) returns Slice[char]
    {
        var i 0
        while i < (included_outputs.get_length() as int)
        {
            let output included_outputs[i as size_t]
            if output.equals(file_name)
                return included_output_sources[i as size_t]
            set i: i + 1
        }
        file_name
    }

    ; getRedirectForResolution's file name: a referenced project's output declaration
    ; file resolves from its source
    function resolution_containing_path(this, index_in: int) returns Slice[char]
    {
        let index this.symlink_dts_index(index_in)
        let path this.path_at(index)
        if reference_outputs = null
            return path
        let list reference_outputs as ref[Array[Slice[char]]]
        var i 0
        while i < (list.get_length() as int)
        {
            let output list[i as size_t]
            if ((output.length as int) > 0) and output.equals(path)
                return this.path_at(i)
            set i: i + 1
        }
        path
    }

    procedure set_paths(this, paths: ref[JsonValue], base_path: Slice[char])
    {
        set this.paths_option: paths
        set this.paths_base_path: slice_copy_on(Page.get(this), base_path)
    }

    procedure add_included_output(this, output: Slice[char], source: Slice[char])
    {
        included_outputs.add(slice_copy_on(Page.get(this), output))
        included_output_sources.add(slice_copy_on(Page.get(this), source))
    }

    ; a package.json lookup into the cache's key list (once per path)
    procedure record_package_json_lookup(this, path: Slice[char], found: bool)
    {
        if package_json_recording = false
            return
        var i 0
        while i < (package_json_lookups.get_length() as int)
        {
            let known package_json_lookups[i as size_t]
            if this.same_path(known, path)
                return
            set i: i + 1
        }
        package_json_lookups.add(slice_copy_on(Page.get(this), path))
        package_json_found.add(found)
    }

    procedure set_config(this, path: Slice[char], text: Slice[char])
    {
        let pg Page.get(this)
        set this.config_path: slice_copy_on(pg, path)
        set this.config_text: slice_copy_on(pg, text)
    }

    procedure set_output_options(this, declaration_dir: Slice[char], config_file_path: Slice[char], current_directory: Slice[char])
    {
        let pg Page.get(this)
        set this.declaration_dir: slice_copy_on(pg, declaration_dir)
        set this.config_file_path: slice_copy_on(pg, config_file_path)
        set this.current_directory: slice_copy_on(pg, current_directory)
    }

    procedure set_members(this, list: ref[Array[bool]])
        set this.members: list

    ; the program holds the file (every file without a loader)
    function holds(this, i: int) returns bool
    {
        if members = null
            return true
        let m members as ref[Array[bool]]
        if i >= (m.get_length() as int)
            return true
        m[i as size_t]
    }

    function link_count(this) returns int
        link_paths.get_length() as int

    function link_path_at(this, i: int) returns Slice[char]
        link_paths[i as size_t]

    function link_target_at(this, i: int) returns Slice[char]
        link_targets[i as size_t]

    procedure add_link(this, link: Slice[char], target: Slice[char])
    {
        let pg Page.get(this)
        link_paths.add(slice_copy_on(pg, link))
        link_targets.add(slice_copy_on(pg, target))
    }

    procedure set_redirect(this, index: int, target: int)
    {
        if redirect_targets = null
        {
            let made &Array[int]^this()
            var i 0
            while i < this.count()
            {
                made.add(0 - 1)
                set i: i + 1
            }
            set this.redirect_targets: made
        }
        let rt redirect_targets as ref[Array[int]]
        rt.put(index as size_t, target)
    }

    ; the file a resolution to `index` answers (itself without a redirect)
    function redirect_target_of(this, index: int) returns int
    {
        if redirect_targets = null
            return index
        let rt redirect_targets as ref[Array[int]]
        if (index < 0) or (index >= (rt.get_length() as int))
            return index
        let t rt[index as size_t]
        if t < 0
            return index
        t
    }

    procedure enable_resolution_records(this)
        set this.resolution_keys: &Array[Slice[char]]^this()

    function resolution_key(host: ref[Page], index: int, name: Slice[char]) returns Slice[char]
    {
        let sb StringBuilder^host()
        sb.append(index)
        sb.append(":")
        sb.append(name.data, name.length)
        let key sb.to_string()
        slice_copy_on(host, Slice[char](key.get_length(), key.get_buffer() as pointer[char]))
    }

    ; a loader resolution's package into GetPackagesMap
    procedure record_package(this, package_key: Slice[char], resolved_path: Slice[char])
    {
        var end 0
        while (end < (package_key.length as int)) and ((package_key[end as size_t] as int) <> ("|" as char) as int)
            set end: end + 1
        if end = 0
            return
        let host Page.get(this)
        if package_map_names = null
        {
            set this.package_map_names: &Array[Slice[char]]^host()
            set this.package_map_dts: &Array[bool]^host()
        }
        let names package_map_names as ref[Array[Slice[char]]]
        let dts package_map_dts as ref[Array[bool]]
        let name package_key.subslice(0, end as size_t)
        let is_dts resolved_path.ends_with(".d.ts")
        var i 0
        while i < (names.get_length() as int)
        {
            let known names[i as size_t]
            if known.equals(name)
            {
                if is_dts
                    dts.put(i as size_t, true)
                return
            }
            set i: i + 1
        }
        names.add(slice_copy_on(host, name))
        dts.add(is_dts)
    }

    ; GetPackagesMap's lookup: 0 absent, 1 present, 2 present with a .d.ts
    function package_map_state(this, name: Slice[char]) returns int
    {
        if package_map_names = null
            return 0
        let names package_map_names as ref[Array[Slice[char]]]
        let dts package_map_dts as ref[Array[bool]]
        var i 0
        while i < (names.get_length() as int)
        {
            let known names[i as size_t]
            if known.equals(name)
            {
                if dts[i as size_t]
                    return 2
                return 1
            }
            set i: i + 1
        }
        0
    }

    procedure record_resolution(this, index: int, name: Slice[char])
    {
        if resolution_keys = null
            return
        if this.has_resolution(index, name)
            return
        let keys resolution_keys as ref[Array[Slice[char]]]
        keys.add(ProgramFiles.resolution_key(Page.get(this), index, name))
        this.index_resolutions(keys)
    }

    function resolution_hash(index: int, name: Slice[char]) returns int
    {
        var h: u64 14695981039346656037
        set h: h xor (index as u64)
        set h: h * 1099511628211
        var i: size_t 0
        while i < name.length
        {
            set h: h xor (((name[i] as int) & 255) as u64)
            set h: h * 1099511628211
            set i: i + 1
        }
        ((h >> 1) as int)
    }

    ; the key just added into the index, rebuilt at double the capacity when the
    ; table would pass half full
    procedure index_resolutions(this, keys: ref[Array[Slice[char]]])
    {
        let count keys.get_length() as int
        var cap 0
        if resolution_buckets <> null
            set cap: resolution_mask + 1
        var first count - 1
        if (count * 2) > cap
        {
            var new_cap 16
            while (count * 2) > new_cap
                set new_cap: new_cap * 2
            set resolution_buckets: Vector[int]^this(new_cap as size_t)
            set resolution_mask: new_cap - 1
            set first: 0
        }
        let v resolution_buckets as ref[Vector[int]]
        var j first
        while j < count
        {
            let key keys[j as size_t]
            var colon 0
            while (key[colon as size_t] as int) <> (":" as char) as int
                set colon: colon + 1
            var file_index 0
            var d 0
            while d < colon
            {
                set file_index: file_index * 10 + ((key[d as size_t] as int) - 48)
                set d: d + 1
            }
            var slot ProgramFiles.resolution_hash(file_index, key.slice_from((colon + 1) as size_t)) & resolution_mask
            while true
            {
                let e v.get(slot as size_t)
                if e = null
                    break
                if *e = 0
                {
                    v.put(slot as size_t, j + 1)
                    break
                }
                set slot: (slot + 1) & resolution_mask
            }
            set j: j + 1
        }
    }

    ; whether the loader resolved `name` for the file (true without a loader)
    function has_resolution(this, index: int, name: Slice[char]) returns bool
    {
        if resolution_keys = null
            return true
        let keys resolution_keys as ref[Array[Slice[char]]]
        if resolution_buckets = null
            return false
        let v resolution_buckets as ref[Vector[int]]
        var slot ProgramFiles.resolution_hash(index, name) & resolution_mask
        while true
        {
            let e v.get(slot as size_t)
            if e = null
                return false
            let idx *e
            if idx = 0
                return false
            if ProgramFiles.key_matches(keys[(idx - 1) as size_t], index, name)
                return true
            set slot: (slot + 1) & resolution_mask
        }
        false
    }

    function key_matches(key: Slice[char], index: int, name: Slice[char]) returns bool
    {
        var colon 0 - 1
        var j 0
        while j < (key.length as int)
        {
            if (key[j as size_t] as int) = (":" as char) as int
            {
                set colon: j
                break
            }
            set j: j + 1
        }
        if colon < 0
            return false
        var v 0
        var d 0
        while d < colon
        {
            set v: v * 10 + ((key[d as size_t] as int) - 48)
            set d: d + 1
        }
        if v <> index
            return false
        let rest key.slice_from((colon + 1) as size_t)
        rest.equals(name)
    }

    procedure add_type_root(this, root: Slice[char])
        type_roots.add(slice_copy_on(Page.get(this), root))

    procedure add_custom_condition(this, condition: Slice[char])
        custom_conditions.add(slice_copy_on(Page.get(this), condition))

    ; the vfs's Realpath: every symlink prefix replaced by its target until none
    ; applies (bounded, a cycle answers the path it reached)
    function real_path(this, path: Slice[char]) returns Slice[char]
    {
        this.record_seen(path)
        let n link_paths.get_length() as int
        if n = 0
            return this.existing_real_path(path, path)
        let pg Page.get(this)
        var current path
        var rounds 0
        while rounds < 40
        {
            set rounds: rounds + 1
            var changed false
            var i 0
            while i < n
            {
                let lp link_paths[i as size_t]
                if current.equals(lp)
                {
                    set current: link_targets[i as size_t]
                    set changed: true
                    break
                }
                if (current.length as int) > (lp.length as int)
                {
                    if (current[lp.length] as int) = ("/" as char) as int
                    {
                        let head current.subslice(0, lp.length)
                        if head.equals(lp)
                        {
                            set current: join_slices(pg, link_targets[i as size_t], current.slice_from(lp.length))
                            set changed: true
                            break
                        }
                    }
                }
                set i: i + 1
            }
            if changed = false
                return this.existing_real_path(path, current)
        }
        this.existing_real_path(path, current)
    }

    ; the vfs's Realpath fails for a path that does not exist and answers the path
    function existing_real_path(this, path: Slice[char], real: Slice[char]) returns Slice[char]
    {
        ; a case-insensitive file system's realpath answers the entry's own casing
        if case_insensitive
        {
            let entry this.index_of_exact_path(real)
            if entry >= 0
                return paths[entry as size_t]
        }
        if real.equals(path)
            return path
        if this.index_of_exact_path(real) >= 0
            return real
        if this.directory_exists_exact(real)
            return real
        path
    }

    ; a resolution through a symlink: recorded once per original path, on the
    ; TABLE's page — a resolver may run on a scratch page that is released after
    ; it answers (the checker's resolution memo), and the table outlives it
    procedure record_symlink_resolution(files: ref[ProgramFiles], original: Slice[char], real: Slice[char])
    {
        let pg Page.get(files)
        let originals files.resolution_originals
        var i 0
        while i < (originals.get_length() as int)
        {
            let o originals[i as size_t]
            if o.equals(original)
                return
            set i: i + 1
        }
        originals.add(slice_copy_on(pg, original))
        files.resolution_realpaths.add(slice_copy_on(pg, real))
    }

    ; the two views are COPIED onto the table's page: a caller without a page of
    ; its own (the dump's driver) may hand in a view of its frame
    procedure add(this, path: Slice[char], text: Slice[char], file: ref[AstNode]?, binder: ref[Binder]?, parser: ref[Parser]?, emit: bool, format: int)
    {
        let pg Page.get(this)
        paths.add(slice_copy_on(pg, path))
        texts.add(slice_copy_on(pg, text))
        files.add(file)
        binders.add(binder)
        parsers.add(parser)
        emits.add(emit)
        formats.add(format)
        package_json_types.add(Slice[char]())
        externals.add(false)
        forced_modules.add(false)
        path_claimed.add(false)
        if disk_paths <> null
        {
            let dp disk_paths as ref[Array[Slice[char]]]
            dp.add(Slice[char]())
        }
    }

    ; A file known by NAME, its text on disk at `disk_path` and read by text_at when
    ; first asked for — the file-system driver registers a whole tree this way.
    procedure add_on_disk(this, path: Slice[char], disk_path: Slice[char])
    {
        let pg Page.get(this)
        if disk_paths = null
        {
            let fresh &Array[Slice[char]]^pg()
            var k 0
            while k < (paths.get_length() as int)
            {
                fresh.add(Slice[char]())
                set k: k + 1
            }
            set disk_paths: fresh
        }
        this.add(path, Slice[char](), null, null, null, false, 0)
        let dp disk_paths as ref[Array[Slice[char]]]
        dp.put(dp.get_length() - 1, slice_copy_on(pg, disk_path))
    }

    ; `s` becomes entry i's text: the table's slice is a view into it
    procedure keep_string(this, i: int, s: String)
    {
        let pg Page.get(this)
        if strings = null
        {
            let fresh &Array[String]^pg()
            set strings: fresh
        }
        let st strings as ref[Array[String]]
        while (st.get_length() as int) < (paths.get_length() as int)
            st.add(String())
        st.put(i as size_t, s)
        texts.put(i as size_t, Slice[char](s.get_length(), s.get_buffer() as pointer[char]))
    }

    ; entry i's text as a String, shared by every caller
    function string_at(this, i: int) returns String
    {
        let text this.text_at(i)
        if strings <> null
        {
            let st strings as ref[Array[String]]
            if i < (st.get_length() as int)
            {
                let known st[i as size_t]
                if ((known.get_buffer() as pointer[char]) = text.data) and (text.data <> null)
                    return known
            }
        }
        let pg Page.get(this)
        let s String^pg(text.data as pointer[const_char], text.length)
        this.keep_string(i, s)
        s
    }

    ; the whole of a file on disk, on `host`
    function read_disk_text(host: ref[Page], disk_path: Slice[char]) returns Slice[char]
    {
        let whole File.read_to_string(String(disk_path.data as pointer[const_char], disk_path.length))
        slice_copy_on(host, Slice[char](whole.get_length(), whole.get_buffer() as pointer[char]))
    }

    ; parseSourceFile's write-back (slice 292): a registered entry carries its RAW
    ; text and nothing else until the loader first REACHES it, which is when the
    ; file is parsed and bound — `fileLoader.findSourceFile`'s own shape. The text
    ; is replaced too, because the parse decodes a byte-order mark.
    procedure set_parsed(this, i: int, text: Slice[char], file: ref[AstNode]?, binder: ref[Binder]?, parser: ref[Parser]?, format: int)
    {
        let pg Page.get(this)
        ; the parse's own text is usually the entry's String already
        let current texts[i as size_t]
        if (current.data <> text.data) or (current.length <> text.length)
        {
            let s String^pg(text.data as pointer[const_char], text.length)
            this.keep_string(i, s)
        }
        if disk_paths <> null
        {
            let dp disk_paths as ref[Array[Slice[char]]]
            dp.put(i as size_t, Slice[char]())
        }
        files.put(i as size_t, file)
        binders.put(i as size_t, binder)
        parsers.put(i as size_t, parser)
        formats.put(i as size_t, format)
    }

    procedure set_binder(this, i: int, binder: ref[Binder]?)
        binders.put(i as size_t, binder)

    procedure set_module_kindness(this, i: int, is_external: bool, forced: bool)
    {
        externals.put(i as size_t, is_external)
        forced_modules.put(i as size_t, forced)
    }

    function external_at(this, i: int) returns bool
        externals[i as size_t]

    function forced_module_at(this, i: int) returns bool
        forced_modules[i as size_t]

    function count(this) returns int
        paths.get_length() as int

    function path_at(this, i: int) returns Slice[char]
        paths[i as size_t]

    function text_at(this, i: int) returns Slice[char]
    {
        if disk_paths <> null
        {
            let dp disk_paths as ref[Array[Slice[char]]]
            let disk dp[i as size_t]
            if (disk.length as int) > 0
            {
                let pg Page.get(this)
                let whole File.read_to_string(String(disk.data as pointer[const_char], disk.length))
                let s String^pg(whole.get_buffer() as pointer[const_char], whole.get_length())
                this.keep_string(i, s)
                dp.put(i as size_t, Slice[char]())
            }
        }
        texts[i as size_t]
    }

    function file_at(this, i: int) returns ref[AstNode]?
        files[i as size_t]

    function binder_at(this, i: int) returns ref[Binder]?
        binders[i as size_t]

    function parser_at(this, i: int) returns ref[Parser]?
        parsers[i as size_t]

    function emit_at(this, i: int) returns bool
        emits[i as size_t]

    procedure set_emit(this, i: int, emit: bool)
        emits.put(i as size_t, emit)

    function format_at(this, i: int) returns int
        formats[i as size_t]

    procedure set_format(this, i: int, format: int)
        formats.put(i as size_t, format)

    function package_json_type_at(this, i: int) returns Slice[char]
        package_json_types[i as size_t]

    procedure set_package_json_type(this, i: int, t: Slice[char])
        package_json_types.put(i as size_t, slice_copy_on(Page.get(this), t))

    ; the `type` of the nearest package.json above a file (the program's
    ; SourceFileMetaData.PackageJsonType), empty when none
    function package_json_type_of(this, host: ref[Page], path: Slice[char]) returns Slice[char]
    {
        var dir get_directory_path(host, path)
        repeat
        {
            let info PackageJsonInfo.at(host, this, dir)
            if info.exists
                return info.type_field
            let parent get_directory_path(host, dir)
            if parent.equals(dir)
                return Slice[char]()
            set dir: parent
        }
    }

    ; SourceFileMetaData.PackageJsonDirectory: the nearest package.json's
    ; directory above a file, empty when none
    function package_json_directory_of(this, host: ref[Page], path: Slice[char]) returns Slice[char]
    {
        var dir get_directory_path(host, path)
        repeat
        {
            let info PackageJsonInfo.at(host, this, dir)
            if info.exists
                return info.directory
            let parent get_directory_path(host, dir)
            if parent.equals(dir)
                return Slice[char]()
            set dir: parent
        }
    }

    ; trackingvfs: the path recorded while the program is watched
    function record_seen(this, path: Slice[char])
    {
        if seen = null
            return
        let list seen as ref[Array[Slice[char]]]
        list.add(slice_copy_on(Page.get(list), path))
    }

    function index_of_path(this, path: Slice[char]) returns int
    {
        this.record_seen(path)
        let direct this.index_of_exact_path(path)
        if direct >= 0
            return direct
        if link_paths.get_length() = 0
            return 0 - 1
        let real this.real_path(path)
        if real.equals(path)
            return 0 - 1
        this.index_of_exact_path(real)
    }

    function index_of_exact_path(this, path: Slice[char]) returns int
    {
        let n paths.get_length() as int
        this.index_paths()
        if path_buckets <> null
        {
            let v path_buckets as ref[Vector[int]]
            var slot ProgramFiles.resolution_hash(0, path) & path_mask
            var probing true
            while probing
            {
                let e v.get(slot as size_t)
                if e = null
                    break
                let idx *e
                if idx = 0
                    break
                let p paths[(idx - 1) as size_t]
                if p.equals(path)
                    return idx - 1
                set slot: (slot + 1) & path_mask
            }
        }
        if case_insensitive
        {
            var k 0
            while k < n
            {
                let q paths[k as size_t]
                if ProgramFiles.equal_fold(q, path)
                    return k
                set k: k + 1
            }
        }
        0 - 1
    }

    ; the file system's comparison: exact, or folding ASCII case when case-insensitive
    function same_path(this, a: Slice[char], b: Slice[char]) returns bool
    {
        if case_insensitive
            return ProgramFiles.equal_fold(a, b)
        a.equals(b)
    }

    ; the rows added since the last lookup, into the path index; a row whose path is
    ; already there stays out, so a lookup answers the FIRST row as the scan did
    procedure index_paths(this)
    {
        let n paths.get_length() as int
        if path_indexed >= n
            return
        var cap 0
        if path_buckets <> null
            set cap: path_mask + 1
        if (n * 2) > cap
        {
            var new_cap 64
            while (n * 2) > new_cap
                set new_cap: new_cap * 2
            let fresh Vector[int]^this(new_cap as size_t)
            set path_buckets: fresh
            set path_mask: new_cap - 1
            set path_indexed: 0
        }
        let v path_buckets as ref[Vector[int]]
        var i path_indexed
        while i < n
        {
            let p paths[i as size_t]
            var slot ProgramFiles.resolution_hash(0, p) & path_mask
            var placing true
            while placing
            {
                let e v.get(slot as size_t)
                if e = null
                    break
                let idx *e
                if idx = 0
                {
                    v.put(slot as size_t, i + 1)
                    break
                }
                let q paths[(idx - 1) as size_t]
                if q.equals(p)
                    break
                set slot: (slot + 1) & path_mask
            }
            set i: i + 1
        }
        set path_indexed: n
    }

    ; the cached package.json read at `path`, null when it was never read
    function cached_package_json(this, path: Slice[char]) returns ref[PackageJsonInfo]?
    {
        if package_json_buckets = null
            return null
        let v package_json_buckets as ref[Vector[int]]
        let keys package_json_paths as ref[Array[Slice[char]]]
        let infos package_json_infos as ref[Array[PackageJsonInfo]]
        var slot ProgramFiles.resolution_hash(0, path) & package_json_mask
        while true
        {
            let e v.get(slot as size_t)
            if e = null
                return null
            let idx *e
            if idx = 0
                return null
            let k keys[(idx - 1) as size_t]
            if k.equals(path)
                return infos.get((idx - 1) as size_t)
            set slot: (slot + 1) & package_json_mask
        }
        null
    }

    procedure cache_package_json(this, path: Slice[char], info: PackageJsonInfo)
    {
        let pg Page.get(this)
        if package_json_paths = null
        {
            let fresh_paths &Array[Slice[char]]^pg()
            let fresh_infos &Array[PackageJsonInfo]^pg()
            set package_json_paths: fresh_paths
            set package_json_infos: fresh_infos
        }
        let keys package_json_paths as ref[Array[Slice[char]]]
        let infos package_json_infos as ref[Array[PackageJsonInfo]]
        keys.add(slice_copy_on(pg, path))
        infos.add(info)
        let count keys.get_length() as int
        var cap 0
        if package_json_buckets <> null
            set cap: package_json_mask + 1
        var first count - 1
        if (count * 2) > cap
        {
            var new_cap 64
            while (count * 2) > new_cap
                set new_cap: new_cap * 2
            let fresh Vector[int]^pg(new_cap as size_t)
            set package_json_buckets: fresh
            set package_json_mask: new_cap - 1
            set first: 0
        }
        let v package_json_buckets as ref[Vector[int]]
        var j first
        while j < count
        {
            var slot ProgramFiles.resolution_hash(0, keys[j as size_t]) & package_json_mask
            while true
            {
                let e v.get(slot as size_t)
                if e = null
                    break
                if *e = 0
                {
                    v.put(slot as size_t, j + 1)
                    break
                }
                set slot: (slot + 1) & package_json_mask
            }
            set j: j + 1
        }
    }

    function equal_fold(a: Slice[char], b: Slice[char]) returns bool
    {
        if a.length <> b.length
            return false
        var i 0
        while i < (a.length as int)
        {
            var x a[i as size_t] as int
            var y b[i as size_t] as int
            if (x >= 65) and (x <= 90)
                set x: x + 32
            if (y >= 65) and (y <= 90)
                set y: y + 32
            if x <> y
                return false
            set i: i + 1
        }
        true
    }

    ; a file name given the casing the task that first COLLECTED it carries
    ; ★★★ THE FIRST SPELLING WINS, NOT THE LAST (slice 297), AND IT IS THE
    ; COLLECTION'S FIRST, NOT THE WALK'S (slice 298). A case-insensitive table
    ; entry used to be renamed on EVERY reach of the walk, so the last spelling
    ; won; then once, at the walk's first reach — which agrees with upstream only
    ; while the walk and the collection run the same way round, and the
    ; reference's walk is a LIFO. Upstream parses the file under EACH casing's
    ; task and the program keeps `task.file` of the task `seen[data]` records in
    ; `collectFiles` (filesparser.go); the difference is visible as an emitted
    ; file's NAME — `src/D.js` against `src/d.js`.
    procedure rename_path_once(this, index: int, path: Slice[char])
    {
        if path_claimed[index as size_t]
            return
        path_claimed.put(index as size_t, true)
        this.rename_path(index, path)
    }

    procedure rename_path(this, index: int, path: Slice[char])
    {
        paths.put(index as size_t, slice_copy_on(Page.get(this), path))
        set path_buckets: null
        set path_indexed: 0
    }

    function index_of_file(this, f: ref[AstNode]?) returns int
    {
        if f = null
            return 0 - 1
        let n files.get_length() as int
        var i 0
        while i < n
        {
            let fi files[i as size_t]
            if fi <> null
            {
                ; an identity test on the two references (an Option = Option
                ; comparison is not one this port relies on)
                if (fi as ref[AstNode]) = (f as ref[AstNode])
                    return i
            }
            set i: i + 1
        }
        0 - 1
    }

    function file_exists(this, path: Slice[char]) returns bool
        this.index_of_path(path) >= 0

    ; a directory exists when some file lies below it (the root always does), or
    ; below the directory a symlink stands for
    function directory_exists(this, dir: Slice[char]) returns bool
    {
        this.record_seen(dir)
        if this.directory_exists_exact(dir)
            return true
        if link_paths.get_length() = 0
            return false
        var d dir
        if has_trailing_directory_separator(d)
            set d: remove_trailing_directory_separator(d)
        let real this.real_path(d)
        if real.equals(d)
            return false
        this.directory_exists_exact(real)
    }

    function directory_exists_exact(this, dir: Slice[char]) returns bool
    {
        var d dir
        if has_trailing_directory_separator(d)
            set d: remove_trailing_directory_separator(d)
        if (d.length as int) = 0
            return true
        if d.equals("/")
            return true
        let n paths.get_length() as int
        var i 0
        while i < n
        {
            let p paths[i as size_t]
            if (p.length as int) > (d.length as int)
            {
                if (p[d.length] as int) = ("/" as char) as int
                {
                    let head p.subslice(0, d.length)
                    if this.same_path(head, d)
                        return true
                }
            }
            set i: i + 1
        }
        if directory_paths <> null
        {
            let known_dirs directory_paths as ref[Array[Slice[char]]]
            var kd 0
            while kd < (known_dirs.get_length() as int)
            {
                let known known_dirs[kd as size_t]
                if known.equals(d)
                    return true
                set kd: kd + 1
            }
        }
        ; a symlink below the directory makes it exist too (a `node_modules` of links)
        let ln link_paths.get_length() as int
        var li 0
        while li < ln
        {
            let lp link_paths[li as size_t]
            set li: li + 1
            if (lp.length as int) > (d.length as int)
            {
                if (lp[d.length] as int) = ("/" as char) as int
                {
                    let lhead lp.subslice(0, d.length)
                    if lhead.equals(d)
                        return true
                }
            }
        }
        false
    }

    function text_of_path(this, path: Slice[char]) returns Slice[char]
    {
        let i this.index_of_path(path)
        if i < 0
            return Slice[char]()
        this.text_at(i)
    }
}

; ── a JSON value tree (internal/packagejson/jsonvalue.go) ─────────────────────

define JsonKindAbsent: int 0
define JsonKindNull: int 1
define JsonKindBoolean: int 2
define JsonKindNumber: int 3
define JsonKindString: int 4
define JsonKindArray: int 5
define JsonKindObject: int 6

; the exports/imports object kinds (packagejson.ExportsOrImports.initObjectKind)
define JsonObjectKindConditions: int 0
define JsonObjectKindSubpaths: int 1
define JsonObjectKindImports: int 2
define JsonObjectKindInvalid: int 3

define JsonValue
(
    kind: int
    text: Slice[char]
    truth: bool
    keys: ref[Array[Slice[char]]]?
    values: ref[Array[ref[JsonValue]?]]?
)
{
    ; JSONValue.IsFalsy
    function is_falsy(this) returns bool
    {
        if (kind = JsonKindAbsent) or (kind = JsonKindNull)
            return true
        if kind = JsonKindString
            return (text.length as int) = 0
        if kind = JsonKindNumber
            return text.equals("0")
        if kind = JsonKindBoolean
            return truth = false
        false
    }

    function size(this) returns int
    {
        if values = null
            return 0
        (values as ref[Array[ref[JsonValue]?]]).get_length() as int
    }

    ; the tree again on `host`, every list sized once — a parse builds its lists by
    ; doubling, and the copy is what a cached package.json keeps
    function copy_on(host: ref[Page], v: ref[JsonValue]) returns ref[JsonValue]
    {
        var keys: ref[Array[Slice[char]]]? null
        if v.keys <> null
        {
            let src v.keys as ref[Array[Slice[char]]]
            let n src.get_length()
            let dst &Array[Slice[char]]^host(n)
            var i: size_t 0
            while i < n
            {
                dst.add(slice_copy_on(host, src[i]))
                set i: i + 1
            }
            set keys: dst
        }
        var values: ref[Array[ref[JsonValue]?]]? null
        if v.values <> null
        {
            let src v.values as ref[Array[ref[JsonValue]?]]
            let n src.get_length()
            let dst &Array[ref[JsonValue]?]^host(n)
            var i: size_t 0
            while i < n
            {
                let row src[i]
                if row = null
                    dst.add(null)
                else
                    dst.add(JsonValue.copy_on(host, row as ref[JsonValue]))
                set i: i + 1
            }
            set values: dst
        }
        &JsonValue^host(v.kind, slice_copy_on(host, v.text), v.truth, keys, values)
    }

    function key_at(this, i: int) returns Slice[char]
        (keys as ref[Array[Slice[char]]])[i as size_t]

    function value_at(this, i: int) returns ref[JsonValue]?
        (values as ref[Array[ref[JsonValue]?]])[i as size_t]

    ; an object member by key (null when absent or not an object)
    function get(this, key: Slice[char]) returns ref[JsonValue]?
    {
        if kind <> JsonKindObject
            return null
        let n this.size()
        var i 0
        while i < n
        {
            let k this.key_at(i)
            if k.equals(key)
                return this.value_at(i)
            set i: i + 1
        }
        null
    }

    ; the string of a member, empty when absent or not a string
    function string_of(this, key: Slice[char]) returns Slice[char]
    {
        let v this.get(key)
        if v = null
            return Slice[char]()
        let jv v as ref[JsonValue]
        if jv.kind <> JsonKindString
            return Slice[char]()
        jv.text
    }

    ; ExportsOrImports.initObjectKind: every key `.`-led → subpaths, `#`-led →
    ; imports, neither → conditions, a mix → invalid
    function object_kind(this) returns int
    {
        if kind <> JsonKindObject
            return JsonObjectKindConditions
        let n this.size()
        if n = 0
            return JsonObjectKindConditions
        var seen_dot false
        var seen_hash false
        var seen_other false
        var i 0
        while i < n
        {
            let k this.key_at(i)
            set i: i + 1
            if (k.length as int) = 0
                continue
            let c k[0] as int
            if c = ("." as char) as int
                set seen_dot: true
            if c = ("#" as char) as int
                set seen_hash: true
            if (c <> ("." as char) as int) and (c <> ("#" as char) as int)
                set seen_other: true
            if seen_other and (seen_dot or seen_hash)
                return JsonObjectKindInvalid
        }
        if seen_dot
            return JsonObjectKindSubpaths
        if seen_hash
            return JsonObjectKindImports
        JsonObjectKindConditions
    }
}

; a recursive-descent reader over the text (encoding/json's grammar); `ok`
; false after the first error, the value then null
define JsonParser
(
    host: ref[Page]
    text: Slice[char]
    pos: int
    ok: bool
)
{
    function parse(host: ref[Page], text: Slice[char]) returns ref[JsonValue]?
    {
        let jp &JsonParser^host(host, text, 0, true)
        jp.skip_ws()
        let v jp.parse_value()
        if jp.ok = false
            return null
        v
    }

    function peek(this) returns int
    {
        if pos >= (text.length as int)
            return 0 - 1
        text[pos as size_t] as int
    }

    procedure skip_ws(this)
    {
        while pos < (text.length as int)
        {
            let c text[pos as size_t] as int
            if (c = 32) or (c = 10) or (c = 13) or (c = 9)
                set pos: pos + 1
            else
                return
        }
    }

    procedure fail(this)
        set ok: false

    procedure parse_value(this) returns ref[JsonValue]?
    {
        if ok = false
            return null
        let c this.peek()
        if c = ("{" as char) as int
            return this.parse_object()
        if c = ("[" as char) as int
            return this.parse_array()
        if c = ("\"" as char) as int
        {
            let str this.parse_string()
            if ok = false
                return null
            return &JsonValue^host(JsonKindString, str, false, null, null)
        }
        if this.text_at_is("true")
        {
            set pos: pos + 4
            return &JsonValue^host(JsonKindBoolean, null, true, null, null)
        }
        if this.text_at_is("false")
        {
            set pos: pos + 5
            return &JsonValue^host(JsonKindBoolean, null, false, null, null)
        }
        if this.text_at_is("null")
        {
            set pos: pos + 4
            return &JsonValue^host(JsonKindNull, null, false, null, null)
        }
        ; a number: the run of number characters, kept as text
        let start pos
        while pos < (text.length as int)
        {
            let d text[pos as size_t] as int
            var number_char false
            if (d >= ("0" as char) as int) and (d <= ("9" as char) as int)
                set number_char: true
            if (d = ("-" as char) as int) or (d = ("+" as char) as int) or (d = ("." as char) as int) or (d = ("e" as char) as int) or (d = ("E" as char) as int)
                set number_char: true
            if number_char = false
                break
            set pos: pos + 1
        }
        if pos = start
        {
            this.fail()
            return null
        }
        &JsonValue^host(JsonKindNumber, text.subslice(start as size_t, pos as size_t), false, null, null)
    }

    function text_at_is(this, word: Slice[char]) returns bool
    {
        if (pos + (word.length as int)) > (text.length as int)
            return false
        let piece text.subslice(pos as size_t, (pos + (word.length as int)) as size_t)
        piece.equals(word)
    }

    procedure parse_object(this) returns ref[JsonValue]?
    {
        set pos: pos + 1
        let keys &Array[Slice[char]]^host()
        let values &Array[ref[JsonValue]?]^host()
        this.skip_ws()
        if this.peek() = ("}" as char) as int
        {
            set pos: pos + 1
            return &JsonValue^host(JsonKindObject, null, false, keys, values)
        }
        repeat
        {
            this.skip_ws()
            if this.peek() <> ("\"" as char) as int
            {
                this.fail()
                return null
            }
            let key this.parse_string()
            if ok = false
                return null
            this.skip_ws()
            if this.peek() <> (":" as char) as int
            {
                this.fail()
                return null
            }
            set pos: pos + 1
            this.skip_ws()
            let v this.parse_value()
            if ok = false
                return null
            keys.add(key)
            values.add(v)
            this.skip_ws()
            let c this.peek()
            if c = ("," as char) as int
            {
                set pos: pos + 1
                continue
            }
            if c = ("}" as char) as int
            {
                set pos: pos + 1
                return &JsonValue^host(JsonKindObject, null, false, keys, values)
            }
            this.fail()
            return null
        }
    }

    procedure parse_array(this) returns ref[JsonValue]?
    {
        set pos: pos + 1
        let values &Array[ref[JsonValue]?]^host()
        this.skip_ws()
        if this.peek() = ("]" as char) as int
        {
            set pos: pos + 1
            return &JsonValue^host(JsonKindArray, null, false, null, values)
        }
        repeat
        {
            this.skip_ws()
            let v this.parse_value()
            if ok = false
                return null
            values.add(v)
            this.skip_ws()
            let c this.peek()
            if c = ("," as char) as int
            {
                set pos: pos + 1
                continue
            }
            if c = ("]" as char) as int
            {
                set pos: pos + 1
                return &JsonValue^host(JsonKindArray, null, false, null, values)
            }
            this.fail()
            return null
        }
    }

    ; a string with its escapes decoded (\uXXXX as UTF-8, surrogate pairs joined)
    procedure parse_string(this) returns Slice[char]
    {
        set pos: pos + 1
        let sb StringBuilder^host()
        while pos < (text.length as int)
        {
            let c text[pos as size_t] as int
            if c = ("\"" as char) as int
            {
                set pos: pos + 1
                let s String^host(sb.to_string())
                return Slice[char](s.get_length(), s.get_buffer() as pointer[char])
            }
            if c = ("\\" as char) as int
            {
                set pos: pos + 1
                if pos >= (text.length as int)
                    break
                let e text[pos as size_t] as int
                set pos: pos + 1
                if e = ("n" as char) as int
                    sb.append("\n" as char)
                else
                {
                    if e = ("t" as char) as int
                        sb.append("\t" as char)
                    else
                    {
                        if e = ("r" as char) as int
                            sb.append("\r" as char)
                        else
                        {
                            if e = ("b" as char) as int
                                sb.append(8 as char)
                            else
                            {
                                if e = ("f" as char) as int
                                    sb.append(12 as char)
                                else
                                {
                                    if e = ("u" as char) as int
                                    {
                                        var code this.hex4()
                                        if code < 0
                                            break
                                        if (code >= 0xD800) and (code <= 0xDBFF)
                                        {
                                            ; a surrogate pair
                                            if this.text_at_is("\\u")
                                            {
                                                set pos: pos + 2
                                                let low this.hex4()
                                                if low < 0
                                                    break
                                                set code: 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
                                            }
                                        }
                                        JsonParser.append_utf8(sb, code)
                                    }
                                    else
                                        sb.append(e as char)
                                }
                            }
                        }
                    }
                }
                continue
            }
            sb.append(c as char)
            set pos: pos + 1
        }
        this.fail()
        Slice[char]()
    }

    ; four hex digits at pos, advancing; -1 when malformed
    procedure hex4(this) returns int
    {
        if (pos + 4) > (text.length as int)
            return 0 - 1
        var v 0
        var i 0
        while i < 4
        {
            let h text[(pos + i) as size_t] as int
            var d 0 - 1
            if (h >= ("0" as char) as int) and (h <= ("9" as char) as int)
                set d: h - (("0" as char) as int)
            if (h >= ("a" as char) as int) and (h <= ("f" as char) as int)
                set d: 10 + h - (("a" as char) as int)
            if (h >= ("A" as char) as int) and (h <= ("F" as char) as int)
                set d: 10 + h - (("A" as char) as int)
            if d < 0
                return 0 - 1
            set v: v * 16 + d
            set i: i + 1
        }
        set pos: pos + 4
        v
    }

    procedure append_utf8(sb: ref[StringBuilder], code: int)
    {
        if code < 0x80
        {
            sb.append(code as char)
            return
        }
        if code < 0x800
        {
            sb.append((0xC0 | (code >> 6)) as char)
            sb.append((0x80 | (code & 0x3F)) as char)
            return
        }
        if code < 0x10000
        {
            sb.append((0xE0 | (code >> 12)) as char)
            sb.append((0x80 | ((code >> 6) & 0x3F)) as char)
            sb.append((0x80 | (code & 0x3F)) as char)
            return
        }
        sb.append((0xF0 | (code >> 18)) as char)
        sb.append((0x80 | ((code >> 12) & 0x3F)) as char)
        sb.append((0x80 | ((code >> 6) & 0x3F)) as char)
        sb.append((0x80 | (code & 0x3F)) as char)
    }
}

; ── package.json, the fields the resolver reads ────────────────────────────────

define PackageJsonInfo
(
    exists: bool
    directory: Slice[char]
    name: Slice[char]
    types: Slice[char]
    typings: Slice[char]
    main: Slice[char]
    type_field: Slice[char]
    exports: ref[JsonValue]?
    imports: ref[JsonValue]?
    has_exports: bool
    has_imports: bool
    has_types_versions: bool
    ; the `typesVersions` value itself (slice 259)
    types_versions: ref[JsonValue]?
    ; the `tsconfig` field (slice 261: a config lookup's package file)
    tsconfig: Slice[char]
    ; `version` and `peerDependencies`: a resolution's PackageId
    version: Slice[char]
    peer_dependencies: ref[JsonValue]?
    ; the document's root object (null for an unreadable one): the tracer's field
    ; validation reads the fields' JSON types off it
    raw: ref[JsonValue]?
)
{
    function none() returns PackageJsonInfo
        PackageJsonInfo(false, null, null, null, null, null, null, null, null, false, false, false, null, null, null, null, null)

    ; the package.json of a directory, read off the table; `exists` false when
    ; the directory carries none. An unreadable document is a package.json whose
    ; fields are all absent (packagejson.Parse ignores its error).
    function at(host: ref[Page], files: ref[ProgramFiles], directory: Slice[char]) returns PackageJsonInfo
    {
        let path combine_paths(host, directory, "package.json")
        if files.file_exists(path) = false
        {
            files.record_package_json_lookup(path, false)
            return PackageJsonInfo.none()
        }
        files.record_package_json_lookup(path, true)
        let cached files.cached_package_json(path)
        if cached <> null
        {
            var hit: PackageJsonInfo cached as ref[PackageJsonInfo]
            set hit.directory: directory
            return hit
        }
        let read PackageJsonInfo.read(files, files.text_of_path(path))
        files.cache_package_json(path, read)
        var info read
        set info.directory: directory
        info
    }

    ; packagejson.Parse and the fields the resolver reads, on the table's own page
    ; so a cached entry outlives the lookup that read it
    function read(files: ref[ProgramFiles], text: Slice[char]) returns PackageJsonInfo
    {
        let host Page.get(files)
        var info PackageJsonInfo.none()
        set info.exists: true
        ; parsed on a scratch page and copied: the parse's own garbage (the doubling
        ; lists, the string builders) goes back with the page
        let scratch host.allocate_exclusive_page()
        let parsed JsonParser.parse(scratch, text)
        var root: ref[JsonValue]? null
        if parsed <> null
            set root: JsonValue.copy_on(host, parsed as ref[JsonValue])
        host.deallocate_exclusive_page(scratch)
        if root = null
            return info
        let obj root as ref[JsonValue]
        if obj.kind <> JsonKindObject
            return info
        set info.raw: obj
        set info.name: obj.string_of("name")
        set info.types: obj.string_of("types")
        set info.typings: obj.string_of("typings")
        set info.main: obj.string_of("main")
        set info.type_field: obj.string_of("type")
        set info.tsconfig: obj.string_of("tsconfig")
        set info.version: obj.string_of("version")
        let peers obj.get("peerDependencies")
        if peers <> null
        {
            if (peers as ref[JsonValue]).kind = JsonKindObject
                set info.peer_dependencies: peers
        }
        set info.exports: obj.get("exports")
        set info.imports: obj.get("imports")
        if info.exports <> null
            set info.has_exports: true
        if info.imports <> null
            set info.has_imports: true
        if obj.get("typesVersions") <> null
        {
            set info.has_types_versions: true
            set info.types_versions: obj.get("typesVersions")
        }
        info
    }
}

; ── the resolver ───────────────────────────────────────────────────────────────

; module/resolver.go's resolutionState over the program's table. `resolve`
; answers the INDEX of the file in the table, -1 for none; a shape this port has
; not written sets `stop_tag` (the checker records it) and answers -1.
; module/types.go's NodeResolutionFeatures
define ResolutionFeatureImports: int 1
; tryLoadModuleUsingPaths' two loaders (slice 259)
define ResolverLoaderNodeModules: int 1
define ResolverLoaderDirectory: int 2
; nodeLoadModuleByRelativeName with considerPackageJson (the paths option's loader)
define ResolverLoaderRelative: int 3
define ResolutionFeatureSelfName: int 2
define ResolutionFeatureExports: int 4
define ResolutionFeatureExportsPatternTrailers: int 8
define ResolutionFeatureImportsPatternRoot: int 16

define ModuleResolver
(
    host: ref[Page]
    files: ref[ProgramFiles]
    module_resolution: int
    resolve_json: bool
    esm_mode: bool
    stop_tag: Slice[char]
    name: Slice[char]
    containing_directory: Slice[char]
    conditions: ref[Array[Slice[char]]]?
    features: int
    allow_js: bool
    out_dir: Slice[char]
    root_dir: Slice[char]
    ; the path the last successful file probe named (slice 260: a resolution's
    ; OriginalPath when a symlink stood in it)
    found_path: Slice[char]
    ; resolveConfig's lookup (slice 261): JSON only, a package's `tsconfig` field
    ; and `tsconfig` index
    is_config_lookup: bool
    ; ResolvedUsingTsExtension (slice 264): the found file came from a specifier
    ; spelled with a TS extension, by a TS extension
    resolved_using_ts_extension: bool
    original_extension: Slice[char]
    ; a type reference directive's lookup (slice 268): declaration files only
    is_type_reference_directive: bool
    ; resolutionState.diagnostics (slice 273): the codes a resolution reported
    diagnostic_codes: ref[Array[int]]
    ; each diagnostic's two message arguments
    diagnostic_args: ref[Array[Slice[char]]]
    ; the resolved extension is tryAddingExtensions' `.d<ext>.ts` (an arbitrary
    ; extension's declaration file) rather than the one TryExtractTSExtension reads
    resolved_arbitrary_extension: bool
    ; an exports/imports target that is `null` answers `unresolved()`, which ends
    ; the whole resolution: every probe after it fails
    resolution_blocked: bool
    ; the resolution's PackageId as one key (name, submodule, version, peers), empty
    ; when the resolved file carries none
    package_id: Slice[char]
    ; traceResolution: the tracer's formatted lines, null when tracing is off
    traces: ref[Array[String]]?
    ; the options set moduleResolution themselves (the tracer's first line)
    module_resolution_explicit: bool
    ; resolveNodeLike's retry narrows the extensions (-1: the request's own)
    extensions_override: int
    ; resolutionState.resolvedPackageDirectory
    resolved_package_directory: bool
    ; GetCompilerOptionsWithRedirect: a referenced project's config name (traced)
    ; and its `paths` in place of the program's
    redirect_config_name: Slice[char]
    has_paths_override: bool
    paths_override: ref[JsonValue]?
    paths_base_override: Slice[char]
    ; ResolvedModule.AlternateResult: the types the retry without `exports` found
    alternate_result: Slice[char]
    ; compilerOptions.moduleSuffixes, comma-joined (the program's, a redirect's)
    module_suffixes: Slice[char]
)
{
    ; `usage_mode` is the usage location's mode (ModuleKindNone/CommonJS/ESNext,
    ; the checker's GetEmitSyntaxForUsageLocation); `exports_option`/`imports_option`
    ; the two tristate options (2 = unset)
    function create(host: ref[Page], files: ref[ProgramFiles], module_resolution: int, resolve_json: bool, usage_mode: int, allow_js: bool, exports_option: int, imports_option: int, out_dir: Slice[char], root_dir: Slice[char]) returns ref[ModuleResolver]
    {
        var esm false
        if (module_resolution = ModuleResolutionKindNode16) or (module_resolution = ModuleResolutionKindNodeNext)
        {
            if usage_mode = 99
                set esm: true
        }
        ; GetConditions
        let conds &Array[Slice[char]]^host()
        var mode usage_mode
        if (mode = 0) and (module_resolution = ModuleResolutionKindBundler)
            set mode: 99
        if mode = 99
            conds.add("import")
        else
            conds.add("require")
        conds.add("types")
        if module_resolution <> ModuleResolutionKindBundler
            conds.add("node")
        var ci 0
        while ci < (files.custom_conditions.get_length() as int)
        {
            conds.add(files.custom_conditions[ci as size_t])
            set ci: ci + 1
        }
        ; getNodeResolutionFeatures
        var features ResolutionFeatureImports | ResolutionFeatureSelfName | ResolutionFeatureExports | ResolutionFeatureExportsPatternTrailers
        if module_resolution <> ModuleResolutionKindNode16
            set features: features | ResolutionFeatureImportsPatternRoot
        if exports_option = 1
            set features: features | ResolutionFeatureExports
        if exports_option = 0
            set features: features & (0 - 1 - ResolutionFeatureExports)
        if imports_option = 1
            set features: features | ResolutionFeatureImports
        if imports_option = 0
            set features: features & (0 - 1 - ResolutionFeatureImports)
        &ModuleResolver^host(host, files, module_resolution, resolve_json, esm, null, null, null, conds, features, allow_js, out_dir, root_dir, null, false, false, null, false, &Array[int]^host(), &Array[Slice[char]]^host(), false, false, null, null, false, 0 - 1, false, null, false, null, null, null, files.module_suffixes)
    }

    ; ── the tracer (module/resolver.go's tracer.write) ─────────────────────────

    procedure enable_trace(this, module_resolution_explicit_in: bool)
    {
        set this.traces: &Array[String]^host()
        set this.module_resolution_explicit: module_resolution_explicit_in
    }

    function tracing(this) returns bool
        traces <> null

    ; the message of `code` with `{i}` replaced by the i-th argument
    procedure trace_with(this, code: int, args: ref[Array[Slice[char]]])
    {
        if traces = null
            return
        let text Localization.text_of(code)
        let n text.length as int
        var sb StringBuilder()
        var i 0
        while i < n
        {
            let c text[i as size_t] as int
            if (c = ("{" as char) as int) and ((i + 2) < n)
            {
                let d text[(i + 1) as size_t] as int
                if (d >= 48) and (d <= 57)
                {
                    if (text[(i + 2) as size_t] as int) = ("}" as char) as int
                    {
                        let k d - 48
                        if k < (args.get_length() as int)
                        {
                            let a args[k as size_t]
                            sb.append(a.data, a.length)
                        }
                        set i: i + 3
                        continue
                    }
                }
            }
            sb.append(c as char)
            set i: i + 1
        }
        let list traces as ref[Array[String]]
        let line String^host(sb.to_string())
        list.add(line)
    }

    procedure trace0(this, code: int)
    {
        if traces = null
            return
        this.trace_with(code, &Array[Slice[char]]^host())
    }

    procedure trace1(this, code: int, a0: Slice[char])
    {
        if traces = null
            return
        let args &Array[Slice[char]]^host()
        args.add(a0)
        this.trace_with(code, args)
    }

    procedure trace2(this, code: int, a0: Slice[char], a1: Slice[char])
    {
        if traces = null
            return
        let args &Array[Slice[char]]^host()
        args.add(a0)
        args.add(a1)
        this.trace_with(code, args)
    }

    procedure trace3(this, code: int, a0: Slice[char], a1: Slice[char], a2: Slice[char])
    {
        if traces = null
            return
        let args &Array[Slice[char]]^host()
        args.add(a0)
        args.add(a1)
        args.add(a2)
        this.trace_with(code, args)
    }

    procedure trace4(this, code: int, a0: Slice[char], a1: Slice[char], a2: Slice[char], a3: Slice[char])
    {
        if traces = null
            return
        let args &Array[Slice[char]]^host()
        args.add(a0)
        args.add(a1)
        args.add(a2)
        args.add(a3)
        this.trace_with(code, args)
    }

    ; extensions.String
    function extensions_text(host: ref[Page], ext: int) returns Slice[char]
    {
        let sb StringBuilder^host()
        var first true
        if (ext & ExtTypeScript) <> 0
        {
            sb.append("TypeScript")
            set first: false
        }
        if (ext & ExtJavaScript) <> 0
        {
            if first = false
                sb.append(", ")
            sb.append("JavaScript")
            set first: false
        }
        if (ext & ExtDeclaration) <> 0
        {
            if first = false
                sb.append(", ")
            sb.append("Declaration")
            set first: false
        }
        if (ext & ExtJson) <> 0
        {
            if first = false
                sb.append(", ")
            sb.append("JSON")
        }
        let s sb.to_string()
        slice_copy_on(host, Slice[char](s.get_length(), s.get_buffer() as pointer[char]))
    }

    ; the JSON type name packagejson's Expected reports
    function json_type_name(v: ref[JsonValue]) returns Slice[char]
    {
        if v.kind = JsonKindNull
            return "null"
        if v.kind = JsonKindBoolean
            return "boolean"
        if v.kind = JsonKindNumber
            return "number"
        if v.kind = JsonKindString
            return "string"
        if v.kind = JsonKindArray
            return "array"
        "object"
    }

    function extensions(this) returns int
    {
        if extensions_override >= 0
            return extensions_override
        if is_config_lookup
            return ExtJson
        if is_type_reference_directive
            return ExtDeclaration
        var ext ExtTypeScript | ExtJavaScript | ExtDeclaration
        if resolve_json
            set ext: ext | ExtJson
        ext
    }

    procedure stop(this, tag: Slice[char])
    {
        if (stop_tag.length as int) = 0
            set stop_tag: tag
    }

    ; ResolveModuleName → resolveNodeLike → resolveNodeLikeWorker
    procedure resolve(this, module_name: Slice[char], containing_file: Slice[char]) returns int
    {
        set name: module_name
        set containing_directory: get_directory_path(host, containing_file)
        set found_path.data: null
        set found_path.length: 0
        set this.resolved_using_ts_extension: false
        set this.resolved_arbitrary_extension: false
        set this.resolution_blocked: false
        set package_id.data: null
        set package_id.length: 0
        set alternate_result.data: null
        set alternate_result.length: 0
        if traces <> null
        {
            this.trace2(TrResolving_module_0_from_1, module_name, containing_file)
            if (redirect_config_name.length as int) > 0
                this.trace1(TrUsing_compiler_options_of_project_reference_redirect_0, redirect_config_name)
            let kind_name ModuleResolver.module_resolution_name(module_resolution)
            if module_resolution_explicit
                this.trace1(TrExplicitly_specified_module_resolution_kind_Colon_0, kind_name)
            else
                this.trace1(TrModule_resolution_kind_is_not_specified_using_0, kind_name)
        }
        let r this.resolve_node_like()
        if traces <> null
        {
            if r >= 0
            {
                if (package_id.length as int) > 0
                    this.trace3(TrModule_name_0_was_successfully_resolved_to_1_with_Package_ID_2, module_name, files.path_at(r), ModuleResolver.package_id_text(host, package_id))
                else
                    this.trace2(TrModule_name_0_was_successfully_resolved_to_1, module_name, files.path_at(r))
            }
            else
                this.trace1(TrModule_name_0_was_not_resolved, module_name)
        }
        ; createResolvedModuleHandlingSymlink: a non-relative resolution inside
        ; node_modules keeps the symlinked path as its OriginalPath
        if (r >= 0) and (is_external_module_name_relative(module_name) = false) and (files.preserve_symlinks = false)
        {
            if slice_contains_node_modules(found_path)
            {
                let real slice_copy_on(host, files.path_at(r))
                let original slice_copy_on(host, found_path)
                if real.equals(original) = false
                    ProgramFiles.record_symlink_resolution(files, original, real)
            }
        }
        r
    }

    ; ResolveTypeReferenceDirective's traces around resolutionState.resolveTypeReferenceDirective:
    ; the type roots (primary), then node_modules above the containing directory
    ; (secondary)
    procedure resolve_type_reference_directive(this, type_name: Slice[char], containing_file: Slice[char], type_roots: ref[Array[Slice[char]]], from_config: bool, from_inferred: bool) returns int
    {
        if traces <> null
        {
            let sb StringBuilder^host()
            var ti 0
            while ti < (type_roots.get_length() as int)
            {
                if ti > 0
                    sb.append(",")
                let tr type_roots[ti as size_t]
                sb.append(tr.data, tr.length)
                set ti: ti + 1
            }
            let joined sb.to_string()
            this.trace3(TrResolving_type_reference_directive_0_containing_file_1_root_directory_2, type_name, containing_file, slice_copy_on(host, Slice[char](joined.get_length(), joined.get_buffer() as pointer[char])))
            if (redirect_config_name.length as int) > 0
                this.trace1(TrUsing_compiler_options_of_project_reference_redirect_0, redirect_config_name)
        }
        var primary false
        let r this.resolve_type_reference_directive_state(type_name, containing_file, type_roots, from_config, from_inferred, &primary)
        if traces <> null
        {
            var primary_text: Slice[char] "false"
            if primary
                set primary_text: "true"
            if r < 0
                this.trace1(TrType_reference_directive_0_was_not_resolved, type_name)
            else
            {
                if (package_id.length as int) > 0
                    this.trace4(TrType_reference_directive_0_was_successfully_resolved_to_1_with_Package_ID_2_primary_Colon_3, type_name, files.path_at(r), ModuleResolver.package_id_text(host, package_id), primary_text)
                else
                    this.trace3(TrType_reference_directive_0_was_successfully_resolved_to_1_primary_Colon_2, type_name, files.path_at(r), primary_text)
            }
        }
        r
    }

    ; resolutionState.resolveTypeReferenceDirective; `out_primary` for a type-roots hit
    procedure resolve_type_reference_directive_state(this, type_name: Slice[char], containing_file: Slice[char], type_roots: ref[Array[Slice[char]]], from_config: bool, from_inferred: bool, out_primary: ref[bool]) returns int
    {
        set name: type_name
        set containing_directory: get_directory_path(host, containing_file)
        set found_path.data: null
        set found_path.length: 0
        set this.resolution_blocked: false
        set package_id.data: null
        set package_id.length: 0
        set this.is_type_reference_directive: true
        set out_primary: false
        if type_roots.get_length() > 0
        {
            if traces <> null
            {
                let sb StringBuilder^host()
                var ti 0
                while ti < (type_roots.get_length() as int)
                {
                    if ti > 0
                        sb.append(", ")
                    let tr type_roots[ti as size_t]
                    sb.append(tr.data, tr.length)
                    set ti: ti + 1
                }
                let joined sb.to_string()
                this.trace1(TrResolving_with_primary_search_path_0, slice_copy_on(host, Slice[char](joined.get_length(), joined.get_buffer() as pointer[char])))
            }
            var i 0
            while i < (type_roots.get_length() as int)
            {
                let type_root type_roots[i as size_t]
                set i: i + 1
                let candidate this.candidate_from_type_root(type_root)
                if files.directory_exists(type_root) = false
                {
                    this.trace1(TrDirectory_0_does_not_exist_skipping_all_lookups_in_it, type_root)
                    continue
                }
                if from_config
                {
                    let rf this.load_module_from_file(ExtDeclaration, candidate)
                    if rf >= 0
                    {
                        this.set_package_id_from_node_module_path(rf)
                        set out_primary: true
                        this.trace_type_reference_real_path(rf)
                        return rf
                    }
                    if (stop_tag.length as int) > 0
                        return 0 - 1
                }
                let rd this.load_node_module_from_directory(ExtDeclaration, candidate, true)
                if rd >= 0
                {
                    set out_primary: true
                    this.trace_type_reference_real_path(rd)
                    return rd
                }
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
        }
        else
            this.trace0(TrRoot_directory_cannot_be_determined_skipping_primary_search_paths)
        if (from_config = false) or (from_inferred = false)
        {
            this.trace1(TrLooking_up_in_node_modules_folder_initial_location_0, containing_directory)
            var r 0 - 1
            if is_external_module_name_relative(type_name) = false
                set r: this.load_module_from_nearest_node_modules_directory()
            else
            {
                let candidate get_normalized_absolute_path(host, combine_paths(host, containing_directory, type_name), Slice[char]())
                set r: this.node_load_module_by_relative_name(ExtDeclaration, candidate, true)
            }
            this.trace_type_reference_real_path(r)
            return r
        }
        this.trace0(TrResolving_type_reference_directive_for_program_that_specifies_custom_typeRoots_skipping_lookup_in_node_modules_folder)
        0 - 1
    }

    ; createResolvedTypeReferenceDirective's realPath of a resolved directive
    procedure trace_type_reference_real_path(this, r: int)
    {
        if (traces = null) or (r < 0) or files.preserve_symlinks
            return
        this.trace2(TrResolving_real_path_for_0_result_1, this.resolved_path_of(r), files.path_at(r))
    }

    ; getCandidateFromTypeRoot, with mangleScopedPackageName's trace
    procedure candidate_from_type_root(this, type_root: Slice[char]) returns Slice[char]
    {
        var name_for_lookup name
        if type_root.ends_with("/node_modules/@types") or type_root.ends_with("/node_modules/@types/")
            set name_for_lookup: this.mangle_scoped(name)
        combine_paths(host, type_root, name_for_lookup)
    }

    ; resolutionState.mangleScopedPackageName
    procedure mangle_scoped(this, package_name: Slice[char]) returns Slice[char]
    {
        let mangled mangle_scoped_package_name(host, package_name)
        if mangled.equals(package_name) = false
            this.trace1(TrScoped_package_detected_looking_in_0, mangled)
        mangled
    }

    ; tryFile over the table, remembering the name that found the file
    procedure try_file_path(this, path: Slice[char]) returns int
    {
        if resolution_blocked
            return 0 - 1
        let r files.index_of_path(path)
        if r >= 0
        {
            set found_path: path
            this.trace1(TrFile_0_exists_use_it_as_a_name_resolution_result, path)
        }
        else
            this.trace1(TrFile_0_does_not_exist, path)
        r
    }

    ; module.ResolveConfig: a NodeNext CommonJS-mode lookup of a config file;
    ; `out_stopped` when it met a shape this port has not written
    function resolve_config(host: ref[Page], files: ref[ProgramFiles], module_name: Slice[char], containing_file: Slice[char], out_stopped: ref[bool]) returns int
    {
        let resolver ModuleResolver.create(host, files, ModuleResolutionKindNodeNext, false, 1, false, 2, 2, Slice[char](), Slice[char]())
        set resolver.is_config_lookup: true
        let r resolver.resolve(module_name, containing_file)
        if (resolver.stop_tag.length as int) > 0
            set out_stopped: true
        r
    }

    ; ModuleResolutionKind.String
    function module_resolution_name(kind: int) returns Slice[char]
    {
        if kind = ModuleResolutionKindNode16
            return "Node16"
        if kind = ModuleResolutionKindNodeNext
            return "NodeNext"
        "Bundler"
    }

    ; PackageId.String over the `name|sub|version|peers` key
    function package_id_text(host: ref[Page], key: Slice[char]) returns Slice[char]
    {
        let sb StringBuilder^host()
        var parts 0
        var start 0
        var i 0
        while i <= (key.length as int)
        {
            var at_end i = (key.length as int)
            var is_bar false
            if at_end = false
                set is_bar: (key[i as size_t] as int) = ("|" as char) as int
            if at_end or is_bar
            {
                let piece key.subslice(start as size_t, i as size_t)
                if parts = 0
                    sb.append(piece.data, piece.length)
                if parts = 1
                {
                    if (piece.length as int) > 0
                    {
                        sb.append("/")
                        sb.append(piece.data, piece.length)
                    }
                }
                if parts = 2
                {
                    sb.append("@")
                    sb.append(piece.data, piece.length)
                }
                if parts = 3
                    sb.append(piece.data, piece.length)
                set parts: parts + 1
                set start: i + 1
            }
            set i: i + 1
        }
        let s sb.to_string()
        slice_copy_on(host, Slice[char](s.get_length(), s.get_buffer() as pointer[char]))
    }

    ; resolveNodeLike: the conditions line, the worker, and the retry without
    ; export maps that only traces (its AlternateResult is not read here)
    procedure resolve_node_like(this) returns int
    {
        if traces <> null
        {
            let sb StringBuilder^host()
            let cl conditions as ref[Array[Slice[char]]]
            var ci 0
            while ci < (cl.get_length() as int)
            {
                if ci > 0
                    sb.append(", ")
                sb.append("'")
                let c cl[ci as size_t]
                sb.append(c.data, c.length)
                sb.append("'")
                set ci: ci + 1
            }
            let joined sb.to_string()
            let joined_view slice_copy_on(host, Slice[char](joined.get_length(), joined.get_buffer() as pointer[char]))
            if esm_mode
                this.trace2(TrResolving_in_0_mode_with_conditions_1, "ESM", joined_view)
            else
                this.trace2(TrResolving_in_0_mode_with_conditions_1, "CJS", joined_view)
        }
        let r this.resolve_node_like_worker()
        if (r >= 0) and resolved_package_directory and (is_config_lookup = false) and ((features & ResolutionFeatureExports) <> 0)
        {
            let result_path this.resolved_path_of(r)
            if ((this.extensions() & (ExtTypeScript | ExtDeclaration)) <> 0) and (is_external_module_name_relative(name) = false) and slice_contains_node_modules(result_path)
            {
                let result_ts is_declaration_file_name_of(result_path) or has_implementation_ts_file_extension(result_path)
                if (result_ts = false) and this.has_condition("import")
                {
                    if traces <> null
                        this.trace0(TrResolution_of_non_relative_name_failed_trying_with_modern_Node_resolution_features_disabled_to_see_if_npm_library_needs_configuration_update)
                    let saved_features features
                    let saved_override extensions_override
                    let saved_found found_path
                    let saved_package package_id
                    let saved_ts resolved_using_ts_extension
                    let saved_arbitrary resolved_arbitrary_extension
                    let saved_blocked resolution_blocked
                    let saved_codes diagnostic_codes.get_length()
                    set this.features: features & (0 - 1 - ResolutionFeatureExports)
                    set this.extensions_override: this.extensions() & (ExtTypeScript | ExtDeclaration)
                    set found_path.data: null
                    set found_path.length: 0
                    let diagnostic_result this.resolve_node_like_worker()
                    if diagnostic_result >= 0
                    {
                        let alternate this.resolved_path_of(diagnostic_result)
                        if slice_contains_node_modules(alternate)
                        {
                            set alternate_result.data: alternate.data
                            set alternate_result.length: alternate.length
                        }
                    }
                    set this.features: saved_features
                    set this.extensions_override: saved_override
                    set this.found_path: saved_found
                    set this.package_id: saved_package
                    set this.resolved_using_ts_extension: saved_ts
                    set this.resolved_arbitrary_extension: saved_arbitrary
                    set this.resolution_blocked: saved_blocked
                    ; r.diagnostics[:diagnosticsCount]
                    set diagnostic_codes.length: saved_codes
                    set diagnostic_args.length: saved_codes * 2
                }
            }
        }
        r
    }

    function has_condition(this, condition: Slice[char]) returns bool
    {
        let cl conditions as ref[Array[Slice[char]]]
        var i 0
        while i < (cl.get_length() as int)
        {
            let c cl[i as size_t]
            if c.equals(condition)
                return true
            set i: i + 1
        }
        false
    }

    ; createResolvedModuleHandlingSymlink's realPath: a non-relative name resolved
    ; into node_modules
    procedure trace_symlink_real_path(this, r: int)
    {
        if (traces = null) or (r < 0) or files.preserve_symlinks
            return
        let path this.resolved_path_of(r)
        if slice_contains_node_modules(path) and (is_external_module_name_relative(name) = false)
            this.trace2(TrResolving_real_path_for_0_result_1, path, files.path_at(r))
    }

    ; resolveNodeLikeWorker over `name` and `containing_directory` (re-entered by
    ; an imports map target that names another package)
    procedure resolve_node_like_worker(this) returns int
    {
        let module_name name
        let ext this.extensions()
        ; tryLoadModuleUsingOptionalResolutionSettings: the paths option
        var paths_option files.paths_option
        var paths_base files.paths_base_path
        if has_paths_override
        {
            set paths_option: paths_override
            set paths_base: paths_base_override
        }
        if (paths_option <> null) and (path_is_relative(module_name) = false)
        {
            let po paths_option as ref[JsonValue]
            if po.size() > 0
            {
                this.trace1(TrX_paths_option_is_specified_looking_for_a_pattern_to_match_module_name_0, module_name)
                let from_paths this.try_load_module_using_paths(ext, module_name, paths_base, po, ResolverLoaderRelative, PackageJsonInfo.none(), Slice[char]())
                if from_paths >= 0
                {
                    this.trace_symlink_real_path(from_paths)
                    return from_paths
                }
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
        }
        if is_external_module_name_relative(module_name) = false
        {
            if (features & ResolutionFeatureImports) <> 0
            {
                if ((module_name.length as int) > 0) and ((module_name[0] as int) = ("#" as char) as int)
                {
                    let r this.load_module_from_imports()
                    if r >= 0
                    {
                        this.trace_symlink_real_path(r)
                        return r
                    }
                    if (stop_tag.length as int) > 0
                        return 0 - 1
                }
            }
            if (features & ResolutionFeatureSelfName) <> 0
            {
                let r this.load_module_from_self_name_reference()
                if r >= 0
                {
                    this.trace_symlink_real_path(r)
                    return r
                }
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
            if slice_contains_byte(module_name, (":" as char) as int)
            {
                if traces <> null
                    this.trace2(TrSkipping_module_0_that_looks_like_an_absolute_URI_target_file_types_Colon_1, module_name, ModuleResolver.extensions_text(host, ext))
                return 0 - 1
            }
            if traces <> null
                this.trace2(TrLoading_module_0_from_node_modules_folder_target_file_types_Colon_1, module_name, ModuleResolver.extensions_text(host, ext))
            let from_node_modules this.load_module_from_nearest_node_modules_directory()
            if from_node_modules >= 0
            {
                this.trace_symlink_real_path(from_node_modules)
                return from_node_modules
            }
            if (stop_tag.length as int) > 0
                return 0 - 1
            if (ext & ExtDeclaration) <> 0
            {
                let from_type_root this.resolve_from_type_root()
                this.trace_symlink_real_path(from_type_root)
                return from_type_root
            }
            return 0 - 1
        }
        ; normalizePathForCJSResolution: a `.`/`..` tail keeps its separator
        var candidate get_normalized_absolute_path(host, combine_paths(host, containing_directory, module_name), Slice[char]())
        ; the LAST PATH COMPONENT of the combination, so `./` and `../` count too
        var last_part module_name
        while ((last_part.length as int) > 0) and ((last_part[(last_part.length - 1) as size_t] as int) = ("/" as char) as int)
            set last_part: last_part.subslice(0, (last_part.length - 1) as size_t)
        if last_part.equals(".") or last_part.equals("..") or last_part.ends_with("/.") or last_part.ends_with("/..")
            set candidate: ensure_trailing_directory_separator(host, candidate)
        this.node_load_module_by_relative_name(ext, candidate, true)
    }

    ; the path a successful probe named (tryFile's answer), the table's otherwise
    function resolved_path_of(this, r: int) returns Slice[char]
    {
        if (found_path.length as int) > 0
            return found_path
        files.path_at(r)
    }

    ; getPackageId: name and version from the package.json, the path below the
    ; package directory, the peer dependencies' installed versions
    procedure set_package_id(this, r: int, info: PackageJsonInfo)
    {
        if info.exists = false
            return
        if (info.name.data = null) or (info.version.data = null)
            return
        let resolved_file_name this.resolved_path_of(r)
        let sb StringBuilder^host()
        sb.append(info.name.data, info.name.length)
        sb.append("|")
        if (resolved_file_name.length as int) > (info.directory.length as int)
        {
            let sub resolved_file_name.slice_from((info.directory.length + 1) as size_t)
            sb.append(sub.data, sub.length)
        }
        sb.append("|")
        sb.append(info.version.data, info.version.length)
        sb.append("|")
        ; readPackageJsonPeerDependencies
        if this.validate_package_json_field(info, "peerDependencies", JsonKindObject)
        {
            let peers info.peer_dependencies as ref[JsonValue]
            if peers.size() > 0
            {
                this.trace0(TrX_package_json_has_a_peerDependencies_field)
                ; realPath of the package directory (the table answers real paths)
                let real_directory files.real_path(info.directory)
                this.trace2(TrResolving_real_path_for_0_result_1, info.directory, real_directory)
                let nm_index ModuleResolver.last_node_modules_index(real_directory)
                if nm_index >= 0
                {
                    let node_modules join_slices(host, real_directory.subslice(0, (nm_index + 13) as size_t), "/")
                    let names &Array[Slice[char]]^host()
                    var i 0
                    while i < peers.size()
                    {
                        ModuleResolver.insert_sorted(names, peers.key_at(i))
                        set i: i + 1
                    }
                    var j 0
                    while j < (names.get_length() as int)
                    {
                        let peer_name names[j as size_t]
                        set j: j + 1
                        let peer_info this.package_json_info(join_slices(host, node_modules, peer_name))
                        if peer_info.exists
                        {
                            sb.append("+")
                            sb.append(peer_name.data, peer_name.length)
                            sb.append("@")
                            sb.append(peer_info.version.data, peer_info.version.length)
                            this.trace2(TrFound_peerDependency_0_with_1_version, peer_name, peer_info.version)
                        }
                        else
                            this.trace1(TrFailed_to_find_peerDependency_0, peer_name)
                    }
                }
            }
        }
        let key sb.to_string()
        set package_id: slice_copy_on(host, Slice[char](key.get_length(), key.get_buffer() as pointer[char]))
    }

    ; resolutionState.getPackageJsonInfo: the table's answer with its trace (the
    ; harness's baseline tracer turns a repeated lookup into the cached form)
    procedure package_json_info(this, directory: Slice[char]) returns PackageJsonInfo
    {
        let info PackageJsonInfo.at(host, files, directory)
        if traces <> null
        {
            let path combine_paths(host, directory, "package.json")
            if info.exists
                this.trace1(TrFound_package_json_at_0, path)
            else
            {
                if files.directory_exists(directory)
                    this.trace1(TrFile_0_does_not_exist, path)
            }
        }
        info
    }

    ; validatePackageJSONField: present with the expected JSON kind; the traces for
    ; a wrong kind and for an absent (or invalid) field
    procedure validate_package_json_field(this, info: PackageJsonInfo, field_name: Slice[char], expected_kind: int) returns bool
    {
        var value: ref[JsonValue]? null
        if info.raw <> null
            set value: (info.raw as ref[JsonValue]).get(field_name)
        if value <> null
        {
            let v value as ref[JsonValue]
            if v.kind = expected_kind
                return true
            if traces <> null
            {
                var expected: Slice[char] "string"
                if expected_kind = JsonKindObject
                    set expected: "object"
                this.trace3(TrExpected_type_of_0_field_in_package_json_to_be_1_got_2, field_name, expected, ModuleResolver.json_type_name(v))
            }
        }
        this.trace1(TrX_package_json_does_not_have_a_0_field, field_name)
        false
    }

    ; getPackageId(path, getPackageJsonInfo(ParseNodeModuleFromPath(path, false)))
    procedure set_package_id_from_node_module_path(this, r: int)
    {
        let package_directory ModuleResolver.parse_node_module_from_path(this.resolved_path_of(r))
        if (package_directory.length as int) = 0
            return
        this.set_package_id(r, this.package_json_info(package_directory))
    }

    function last_node_modules_index(path: Slice[char]) returns int
    {
        let pattern: Slice[char] "/node_modules"
        var i (path.length as int) - (pattern.length as int)
        while i >= 0
        {
            let piece path.subslice(i as size_t, (i + (pattern.length as int)) as size_t)
            if piece.equals(pattern)
                return i
            set i: i - 1
        }
        0 - 1
    }

    procedure insert_sorted(names: ref[Array[Slice[char]]], name: Slice[char])
    {
        names.add(name)
        var k (names.get_length() as int) - 1
        while k > 0
        {
            let prev names[(k - 1) as size_t]
            if ModuleResolver.compare_ordinal(prev, name) <= 0
                break
            names.put(k as size_t, prev)
            names.put((k - 1) as size_t, name)
            set k: k - 1
        }
    }

    function compare_ordinal(a: Slice[char], b: Slice[char]) returns int
    {
        var i 0
        while (i < (a.length as int)) and (i < (b.length as int))
        {
            let ca a[i as size_t] as int
            let cb b[i as size_t] as int
            if ca <> cb
                return ca - cb
            set i: i + 1
        }
        (a.length as int) - (b.length as int)
    }

    ; module.ParseNodeModuleFromPath(path, isFolder: false): the package directory
    ; after the last `/node_modules/`, empty when there is none
    function parse_node_module_from_path(path: Slice[char]) returns Slice[char]
    {
        let pattern: Slice[char] "/node_modules/"
        var idx 0 - 1
        var i (path.length as int) - (pattern.length as int)
        while i >= 0
        {
            let piece path.subslice(i as size_t, (i + (pattern.length as int)) as size_t)
            if piece.equals(pattern)
            {
                set idx: i
                break
            }
            set i: i - 1
        }
        if idx < 0
            return Slice[char]()
        let after idx + (pattern.length as int)
        var end ModuleResolver.next_separator_or_previous(path, after)
        if (after < (path.length as int)) and ((path[after as size_t] as int) = ("@" as char) as int)
            set end: ModuleResolver.next_separator_or_previous(path, end)
        path.subslice(0, end as size_t)
    }

    ; moveToNextDirectorySeparatorIfAvailable(path, prev, isFolder: false)
    function next_separator_or_previous(path: Slice[char], prev: int) returns int
    {
        var j prev + 1
        while j < (path.length as int)
        {
            if (path[j as size_t] as int) = ("/" as char) as int
                return j
            set j: j + 1
        }
        prev
    }

    ; resolveFromTypeRoot: a non-relative module name under an explicit typeRoots
    procedure resolve_from_type_root(this) returns int
    {
        var i 0
        while i < (files.type_roots.get_length() as int)
        {
            let type_root files.type_roots[i as size_t]
            set i: i + 1
            let candidate this.candidate_from_type_root(type_root)
            if files.directory_exists(type_root) = false
            {
                this.trace1(TrDirectory_0_does_not_exist_skipping_all_lookups_in_it, type_root)
                continue
            }
            let from_file this.load_module_from_file(ExtDeclaration, candidate)
            if from_file >= 0
            {
                this.set_package_id_from_node_module_path(from_file)
                return from_file
            }
            if (stop_tag.length as int) > 0
                return 0 - 1
            let from_directory this.load_node_module_from_directory(ExtDeclaration, candidate, true)
            if from_directory >= 0
                return from_directory
            if (stop_tag.length as int) > 0
                return 0 - 1
        }
        0 - 1
    }

    ; getPackageScopeForPath: the nearest package.json at or above a directory
    procedure package_scope_for_path(this, directory: Slice[char]) returns PackageJsonInfo
    {
        var dir directory
        repeat
        {
            let info this.package_json_info(dir)
            if info.exists
                return info
            let parent get_directory_path(host, dir)
            if parent.equals(dir)
                return PackageJsonInfo.none()
            set dir: parent
        }
    }

    ; loadModuleFromSelfNameReference
    procedure load_module_from_self_name_reference(this) returns int
    {
        let scope this.package_scope_for_path(containing_directory)
        if scope.exists = false
            return 0 - 1
        if scope.exports = null
            return 0 - 1
        if (scope.exports as ref[JsonValue]).is_falsy()
            return 0 - 1
        if (scope.name.length as int) = 0
            return 0 - 1
        ; the specifier's components must start with the package name's
        let pkg scope.name
        if name.starts_with(pkg) = false
            return 0 - 1
        var subpath: Slice[char] "."
        if (name.length as int) > (pkg.length as int)
        {
            if (name[pkg.length] as int) <> ("/" as char) as int
                return 0 - 1
            set subpath: join_slices(host, ".", name.slice_from(pkg.length))
        }
        let ext this.extensions()
        if allow_js and (slice_contains_node_modules(containing_directory) = false)
            return this.load_module_from_exports(scope, ext, subpath)
        let priority ext & (ExtTypeScript | ExtDeclaration)
        let r this.load_module_from_exports(scope, priority, subpath)
        if r >= 0
            return r
        if (stop_tag.length as int) > 0
            return 0 - 1
        this.load_module_from_exports(scope, ext & (ExtJavaScript | ExtJson), subpath)
    }

    ; loadModuleFromImports: the `#` map of the nearest package.json
    procedure load_module_from_imports(this) returns int
    {
        if name.equals("#")
        {
            this.trace1(TrInvalid_import_specifier_0_has_no_possible_resolutions, name)
            return 0 - 1
        }
        if name.starts_with("#/") and ((features & ResolutionFeatureImportsPatternRoot) = 0)
        {
            this.trace1(TrInvalid_import_specifier_0_has_no_possible_resolutions, name)
            return 0 - 1
        }
        let scope this.package_scope_for_path(containing_directory)
        if scope.exists = false
        {
            this.trace1(TrDirectory_0_has_no_containing_package_json_scope_Imports_will_not_resolve, containing_directory)
            return 0 - 1
        }
        var imports_object false
        if scope.imports <> null
            set imports_object: (scope.imports as ref[JsonValue]).kind = JsonKindObject
        if imports_object = false
        {
            this.trace1(TrX_package_json_scope_0_has_no_imports_defined, scope.directory)
            return 0 - 1
        }
        let imports scope.imports as ref[JsonValue]
        let r this.load_module_from_exports_or_imports(this.extensions(), name, imports, scope, true)
        if (r >= 0) or resolution_blocked or ((stop_tag.length as int) > 0)
            return r
        this.trace2(TrImport_specifier_0_does_not_exist_in_package_json_scope_at_path_1, name, scope.directory)
        0 - 1
    }

    ; loadModuleFromExports
    procedure load_module_from_exports(this, scope: PackageJsonInfo, ext: int, subpath: Slice[char]) returns int
    {
        if scope.exists = false
            return 0 - 1
        if scope.exports = null
            return 0 - 1
        let exports scope.exports as ref[JsonValue]
        if exports.is_falsy()
            return 0 - 1
        if subpath.equals(".")
        {
            var main_export: ref[JsonValue]? null
            if (exports.kind = JsonKindString) or (exports.kind = JsonKindArray)
                set main_export: exports
            if exports.kind = JsonKindObject
            {
                if exports.object_kind() = JsonObjectKindConditions
                    set main_export: exports
                else
                    set main_export: exports.get(".")
            }
            if main_export <> null
                return this.load_module_from_target_export_or_import(ext, subpath, scope, false, main_export as ref[JsonValue], Slice[char](), false, subpath)
        }
        else
        {
            if exports.kind = JsonKindObject
            {
                if exports.object_kind() = JsonObjectKindSubpaths
                {
                    let r this.load_module_from_exports_or_imports(ext, subpath, exports, scope, false)
                    if (r >= 0) or resolution_blocked or ((stop_tag.length as int) > 0)
                        return r
                }
            }
        }
        this.trace2(TrExport_specifier_0_does_not_exist_in_package_json_scope_at_path_1, subpath, scope.directory)
        0 - 1
    }

    ; loadModuleFromExportsOrImports: an exact key, else the pattern keys in
    ; ComparePatternKeys order
    procedure load_module_from_exports_or_imports(this, ext: int, module_name: Slice[char], lookup: ref[JsonValue], scope: PackageJsonInfo, is_imports: bool) returns int
    {
        if (module_name.ends_with("/") = false) and (slice_contains_byte(module_name, ("*" as char) as int) = false)
        {
            let target lookup.get(module_name)
            if target <> null
                return this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, target as ref[JsonValue], Slice[char](), false, module_name)
        }
        ; the expanding keys: exactly one `*`, or a trailing `/`
        let expanding &Array[int]^host()
        let n lookup.size()
        var i 0
        while i < n
        {
            let key lookup.key_at(i)
            var stars 0
            var ki 0
            while ki < (key.length as int)
            {
                if (key[ki as size_t] as int) = ("*" as char) as int
                    set stars: stars + 1
                set ki: ki + 1
            }
            if (stars = 1) or key.ends_with("/")
                expanding.add(i)
            set i: i + 1
        }
        ; insertion sort by ComparePatternKeys
        var a 1
        while a < (expanding.get_length() as int)
        {
            let moving expanding[a as size_t]
            var b a - 1
            while b >= 0
            {
                let there expanding[b as size_t]
                if ModuleResolver.compare_pattern_keys(lookup.key_at(moving), lookup.key_at(there)) < 0
                {
                    expanding.put((b + 1) as size_t, there)
                    set b: b - 1
                }
                else
                    break
            }
            expanding.put((b + 1) as size_t, moving)
            set a: a + 1
        }
        var e 0
        while e < (expanding.get_length() as int)
        {
            let ki2 expanding[e as size_t]
            set e: e + 1
            let potential lookup.key_at(ki2)
            let target lookup.value_at(ki2)
            if target = null
                continue
            let tv target as ref[JsonValue]
            let star slice_index_of_byte(potential, ("*" as char) as int)
            if ((features & ResolutionFeatureExportsPatternTrailers) <> 0) and ModuleResolver.matches_pattern_with_trailer(potential, module_name)
            {
                let sub_end (module_name.length as int) - ((potential.length as int) - 1 - star)
                let subpath module_name.subslice(star as size_t, sub_end as size_t)
                return this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, tv, subpath, true, potential)
            }
            if potential.ends_with("*")
            {
                let head potential.subslice(0, ((potential.length as int) - 1) as size_t)
                if module_name.starts_with(head)
                {
                    let subpath module_name.slice_from(((potential.length as int) - 1) as size_t)
                    return this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, tv, subpath, true, potential)
                }
                continue
            }
            if module_name.starts_with(potential)
            {
                let subpath module_name.slice_from(potential.length)
                return this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, tv, subpath, false, potential)
            }
        }
        0 - 1
    }

    ; loadModuleFromTargetExportOrImport
    procedure load_module_from_target_export_or_import(this, ext: int, module_name: Slice[char], scope: PackageJsonInfo, is_imports: bool, target: ref[JsonValue], subpath: Slice[char], is_pattern: bool, key: Slice[char]) returns int
    {
        if target.kind = JsonKindNull
        {
            this.trace2(TrX_package_json_scope_0_explicitly_maps_specifier_1_to_null, scope.directory, module_name)
            set resolution_blocked: true
            return 0 - 1
        }
        if target.kind = JsonKindString
        {
            let target_string target.text
            if (is_pattern = false) and ((subpath.length as int) > 0) and (target_string.ends_with("/") = false)
            {
                this.trace2(TrX_package_json_scope_0_has_invalid_type_for_target_of_specifier_1, scope.directory, module_name)
                return 0 - 1
            }
            if target_string.starts_with("./") = false
            {
                if is_imports and (target_string.starts_with("../") = false) and (target_string.starts_with("/") = false) and (is_rooted_disk_path(target_string) = false)
                {
                    ; an imports target that names another package resolves as that package
                    let saved_name name
                    let saved_directory containing_directory
                    set name: ModuleResolver.combined_import_target(host, target_string, subpath, is_pattern)
                    set containing_directory: ensure_trailing_directory_separator(host, scope.directory)
                    this.trace3(TrUsing_0_subpath_1_with_target_2, "imports", key, name)
                    this.trace2(TrResolving_module_0_from_1, name, containing_directory)
                    let r this.resolve_node_like()
                    set name: saved_name
                    set containing_directory: saved_directory
                    return r
                }
                this.trace2(TrX_package_json_scope_0_has_invalid_type_for_target_of_specifier_1, scope.directory, module_name)
                return 0 - 1
            }
            ; no `..`, `.` or `node_modules` after the first component, in the
            ; target nor in the subpath
            if ModuleResolver.path_has_forbidden_part(target_string, true)
            {
                this.trace2(TrX_package_json_scope_0_has_invalid_type_for_target_of_specifier_1, scope.directory, module_name)
                return 0 - 1
            }
            if ModuleResolver.path_has_forbidden_part(subpath, false)
            {
                this.trace2(TrX_package_json_scope_0_has_invalid_type_for_target_of_specifier_1, scope.directory, module_name)
                return 0 - 1
            }
            if traces <> null
            {
                var message_target Slice[char]()
                if is_pattern
                    set message_target: ModuleResolver.replace_star(host, target_string, subpath)
                else
                    set message_target: join_slices(host, target_string, subpath)
                var kind_text: Slice[char] "exports"
                if is_imports
                    set kind_text: "imports"
                this.trace3(TrUsing_0_subpath_1_with_target_2, kind_text, key, message_target)
            }
            let resolved_target combine_paths(host, scope.directory, target_string)
            var final_path Slice[char]()
            if is_pattern
                set final_path: get_normalized_absolute_path(host, ModuleResolver.replace_star(host, resolved_target, subpath), Slice[char]())
            else
