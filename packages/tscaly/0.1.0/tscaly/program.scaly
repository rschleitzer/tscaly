; SPDX-License-Identifier: Apache-2.0
;
; program — the FILE TABLE of a multi-file compilation and the module resolver
; over it (slice 248): the sliver of internal/compiler/program.go a case's units
; reach (which file a specifier names) and internal/module/resolver.go's
; node-like resolution over that table — relative names with the reference's
; extension probing, bare names through node_modules and @types with the
; package.json `types`/`typings`/`main` fields, the ESM-mode restrictions of
; node16/nodenext. What it does NOT port is said as a STOP rather than answered:
; a package.json `exports`/`imports` map (a JSON value tree the port has no
; reader for yet), a self-name reference, `paths`/`rootDirs`/`moduleSuffixes`,
; typesVersions. The checker asks `ModuleResolver.resolve` where the reference
; asks `c.program.GetResolvedModule`, and records the stop tag it hands back.
;
; ★ The file system is the TABLE: the harness roots every unit at `/.src/<unit>`
; (tspath.GetNormalizedAbsolutePath(unit, "/.src") in the reference's runner,
; case-sensitive), so `FileExists` is a lookup by exact path and
; `DirectoryExists` is "some path lies below it".

use tscaly.semver.*
use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.ast.AstNode
use tscaly.binder.Binder
use tscaly.parser.Parser

; core.ModuleResolutionKind — the three the reference's resolver serves
define ModuleResolutionKindUnknown: int 0
define ModuleResolutionKindNode16: int 3
define ModuleResolutionKindNodeNext: int 99
define ModuleResolutionKindBundler: int 100

; module/types.go's `extensions` bit set
define ExtTypeScript: int 1
define ExtJavaScript: int 2
define ExtDeclaration: int 4
define ExtJson: int 8

; ── small string helpers over Slice[char] (page-hosted results) ────────────────

function join_slices(host: ref[Page], a: Slice[char], b: Slice[char]) returns Slice[char]
{
    let n (a.length + b.length) as int
    let buf host.allocate((n + 1) as size_t, 1) as pointer[char]
    var i 0
    while i < (a.length as int)
    {
        set *(buf + i): a[i as size_t]
        set i: i + 1
    }
    var j 0
    while j < (b.length as int)
    {
        set *(buf + i + j): b[j as size_t]
        set j: j + 1
    }
    Slice[char](n as size_t, buf)
}

function slice_index_of_byte(d: Slice[char], c: int) returns int
{
    var i 0
    while i < (d.length as int)
    {
        if (d[i as size_t] as int) = c
            return i
        set i: i + 1
    }
    0 - 1
}

function slice_last_index_of_byte(d: Slice[char], c: int) returns int
{
    var i (d.length as int) - 1
    while i >= 0
    {
        if (d[i as size_t] as int) = c
            return i
        set i: i - 1
    }
    0 - 1
}

function slice_contains_byte(d: Slice[char], c: int) returns bool
    slice_index_of_byte(d, c) >= 0

; tspath.IsDeclarationFileName: `.d.ts`, `.d.mts`, `.d.cts`, or `.d.<ext>.ts`
function is_declaration_file_name_of(d: Slice[char]) returns bool
{
    if d.ends_with(".d.ts") or d.ends_with(".d.mts") or d.ends_with(".d.cts")
        return true
    if d.ends_with(".ts") = false
        return false
    ; the base name carries `.d.` somewhere before its last `.ts`
    let slash slice_last_index_of_byte(d, ("/" as char) as int)
    var i slash + 1
    let n (d.length as int) - 3
    while (i + 2) < n
    {
        if ((d[i as size_t] as int) = ("." as char) as int) and ((d[(i + 1) as size_t] as int) = ("d" as char) as int) and ((d[(i + 2) as size_t] as int) = ("." as char) as int)
            return true
        set i: i + 1
    }
    false
}

; tspath.HasImplementationTSFileExtension: .ts .tsx .mts .cts, not a declaration
function has_implementation_ts_file_extension(d: Slice[char]) returns bool
{
    if is_declaration_file_name_of(d)
        return false
    d.ends_with(".ts") or d.ends_with(".tsx") or d.ends_with(".mts") or d.ends_with(".cts")
}

; module/util.go ParsePackageName: the split between the package and the rest,
; a scoped name (`@scope/name`) keeping its two segments; -1 when there is none
function package_name_split(name: Slice[char]) returns int
{
    var idx slice_index_of_byte(name, ("/" as char) as int)
    if ((name.length as int) > 0) and ((name[0] as int) = ("@" as char) as int)
    {
        let offset idx + 1
        let rest name.slice_from(offset as size_t)
        let idx2 slice_index_of_byte(rest, ("/" as char) as int)
        if idx2 < 0
            return 0 - 1
        set idx: idx2 + offset
    }
    idx
}

; module/util.go MangleScopedPackageName: `@scope/name` → `scope__name`
function mangle_scoped_package_name(host: ref[Page], name: Slice[char]) returns Slice[char]
{
    if ((name.length as int) = 0) or ((name[0] as int) <> ("@" as char) as int)
        return name
    let slash slice_index_of_byte(name, ("/" as char) as int)
    if slash < 0
        return name
    let sb StringBuilder^host()
    let scope name.subslice(1, slash as size_t)
    sb.append(scope.data, scope.length)
    sb.append("__")
    let rest name.slice_from((slash + 1) as size_t)
    sb.append(rest.data, rest.length)
    let s String^host(sb.to_string())
    Slice[char](s.get_length(), s.get_buffer() as pointer[char])
}

; strings.Contains(path, "/node_modules/")
function slice_contains_node_modules(path: Slice[char]) returns bool
{
    var i 0
    while (i + 14) <= (path.length as int)
    {
        let piece path.subslice(i as size_t, (i + 14) as size_t)
        if piece.equals("/node_modules/")
            return true
        set i: i + 1
    }
    false
}

; ── the program's file table ───────────────────────────────────────────────────

define ProgramFiles
(
    paths: ref[Array[Slice[char]]]
    texts: ref[Array[Slice[char]]]
    files: ref[Array[ref[AstNode]?]]
    binders: ref[Array[ref[Binder]?]]
    parsers: ref[Array[ref[Parser]?]]
    emits: ref[Array[bool]]
    formats: ref[Array[int]]
    ; SourceFileMetaData.PackageJsonType per file (slice 253), set with the format
    package_json_types: ref[Array[Slice[char]]]
    ; the file system's symlinks (slice 260): `link_paths[i]` is a symlink to
    ; `link_targets[i]`, a file or a directory
    link_paths: ref[Array[Slice[char]]]
    link_targets: ref[Array[Slice[char]]]
    ; the resolutions that went through a symlink inside node_modules, the
    ; resolved module's OriginalPath beside its realpath (the symlink cache's input)
    resolution_originals: ref[Array[Slice[char]]]
    resolution_realpaths: ref[Array[Slice[char]]]
    ; compilerOptions.CustomConditions (slice 260)
    custom_conditions: ref[Array[Slice[char]]]
)
{
    function create(host: ref[Page]) returns ref[ProgramFiles]
        &ProgramFiles^host(&Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[ref[AstNode]?]^host(), &Array[ref[Binder]?]^host(), &Array[ref[Parser]?]^host(), &Array[bool]^host(), &Array[int]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host())

    procedure add_link(this, link: Slice[char], target: Slice[char])
    {
        let pg Page.get(this)
        link_paths.add(slice_copy_on(pg, link))
        link_targets.add(slice_copy_on(pg, target))
    }

    procedure add_custom_condition(this, condition: Slice[char])
        custom_conditions.add(slice_copy_on(Page.get(this), condition))

    ; the vfs's Realpath: every symlink prefix replaced by its target until none
    ; applies (bounded, a cycle answers the path it reached)
    function real_path(this, path: Slice[char]) returns Slice[char]
    {
        let n link_paths.get_length() as int
        if n = 0
            return path
        let pg Page.get(this)
        var current path
        var rounds 0
        while rounds < 40
        {
            set rounds: rounds + 1
            var changed false
            var i 0
            while i < n
            {
                let lp link_paths[i as size_t]
                if current.equals(lp)
                {
                    set current: link_targets[i as size_t]
                    set changed: true
                    break
                }
                if (current.length as int) > (lp.length as int)
                {
                    if (current[lp.length] as int) = ("/" as char) as int
                    {
                        let head current.subslice(0, lp.length)
                        if head.equals(lp)
                        {
                            set current: join_slices(pg, link_targets[i as size_t], current.slice_from(lp.length))
                            set changed: true
                            break
                        }
                    }
                }
                set i: i + 1
            }
            if changed = false
                return current
        }
        current
    }

    ; a resolution through a symlink: recorded once per original path
    procedure record_symlink_resolution(host: ref[Page], files: ref[ProgramFiles], original: Slice[char], real: Slice[char])
    {
        let originals files.resolution_originals
        var i 0
        while i < (originals.get_length() as int)
        {
            let o originals[i as size_t]
            if o.equals(original)
                return
            set i: i + 1
        }
        originals.add(slice_copy_on(host, original))
        files.resolution_realpaths.add(slice_copy_on(host, real))
    }

    ; the two views are COPIED onto the table's page: a caller without a page of
    ; its own (the dump's driver) may hand in a view of its frame
    procedure add(this, path: Slice[char], text: Slice[char], file: ref[AstNode]?, binder: ref[Binder]?, parser: ref[Parser]?, emit: bool, format: int)
    {
        let pg Page.get(this)
        paths.add(slice_copy_on(pg, path))
        texts.add(slice_copy_on(pg, text))
        files.add(file)
        binders.add(binder)
        parsers.add(parser)
        emits.add(emit)
        formats.add(format)
        package_json_types.add(Slice[char]())
    }

    function count(this) returns int
        paths.get_length() as int

    function path_at(this, i: int) returns Slice[char]
        paths[i as size_t]

    function text_at(this, i: int) returns Slice[char]
        texts[i as size_t]

    function file_at(this, i: int) returns ref[AstNode]?
        files[i as size_t]

    function binder_at(this, i: int) returns ref[Binder]?
        binders[i as size_t]

    function parser_at(this, i: int) returns ref[Parser]?
        parsers[i as size_t]

    function emit_at(this, i: int) returns bool
        emits[i as size_t]

    function format_at(this, i: int) returns int
        formats[i as size_t]

    procedure set_format(this, i: int, format: int)
        formats.put(i as size_t, format)

    function package_json_type_at(this, i: int) returns Slice[char]
        package_json_types[i as size_t]

    procedure set_package_json_type(this, i: int, t: Slice[char])
        package_json_types.put(i as size_t, slice_copy_on(Page.get(this), t))

    ; the `type` of the nearest package.json above a file (the program's
    ; SourceFileMetaData.PackageJsonType), empty when none
    function package_json_type_of(this, host: ref[Page], path: Slice[char]) returns Slice[char]
    {
        var dir get_directory_path(host, path)
        repeat
        {
            let info PackageJsonInfo.at(host, this, dir)
            if info.exists
                return info.type_field
            let parent get_directory_path(host, dir)
            if parent.equals(dir)
                return Slice[char]()
            set dir: parent
        }
    }

    function index_of_path(this, path: Slice[char]) returns int
    {
        let direct this.index_of_exact_path(path)
        if direct >= 0
            return direct
        if link_paths.get_length() = 0
            return 0 - 1
        let real this.real_path(path)
        if real.equals(path)
            return 0 - 1
        this.index_of_exact_path(real)
    }

    function index_of_exact_path(this, path: Slice[char]) returns int
    {
        let n paths.get_length() as int
        var i 0
        while i < n
        {
            let p paths[i as size_t]
            if p.equals(path)
                return i
            set i: i + 1
        }
        0 - 1
    }

    function index_of_file(this, f: ref[AstNode]?) returns int
    {
        if f = null
            return 0 - 1
        let n files.get_length() as int
        var i 0
        while i < n
        {
            let fi files[i as size_t]
            if fi <> null
            {
                ; an identity test on the two references (an Option = Option
                ; comparison is not one this port relies on)
                if (fi as ref[AstNode]) = (f as ref[AstNode])
                    return i
            }
            set i: i + 1
        }
        0 - 1
    }

    function file_exists(this, path: Slice[char]) returns bool
        this.index_of_path(path) >= 0

    ; a directory exists when some file lies below it (the root always does), or
    ; below the directory a symlink stands for
    function directory_exists(this, dir: Slice[char]) returns bool
    {
        if this.directory_exists_exact(dir)
            return true
        if link_paths.get_length() = 0
            return false
        var d dir
        if has_trailing_directory_separator(d)
            set d: remove_trailing_directory_separator(d)
        let real this.real_path(d)
        if real.equals(d)
            return false
        this.directory_exists_exact(real)
    }

    function directory_exists_exact(this, dir: Slice[char]) returns bool
    {
        var d dir
        if has_trailing_directory_separator(d)
            set d: remove_trailing_directory_separator(d)
        if (d.length as int) = 0
            return true
        if d.equals("/")
            return true
        let n paths.get_length() as int
        var i 0
        while i < n
        {
            let p paths[i as size_t]
            if (p.length as int) > (d.length as int)
            {
                if (p[d.length] as int) = ("/" as char) as int
                {
                    let head p.subslice(0, d.length)
                    if head.equals(d)
                        return true
                }
            }
            set i: i + 1
        }
        ; a symlink below the directory makes it exist too (a `node_modules` of links)
        let ln link_paths.get_length() as int
        var li 0
        while li < ln
        {
            let lp link_paths[li as size_t]
            set li: li + 1
            if (lp.length as int) > (d.length as int)
            {
                if (lp[d.length] as int) = ("/" as char) as int
                {
                    let lhead lp.subslice(0, d.length)
                    if lhead.equals(d)
                        return true
                }
            }
        }
        false
    }

    function text_of_path(this, path: Slice[char]) returns Slice[char]
    {
        let i this.index_of_path(path)
        if i < 0
            return Slice[char]()
        texts[i as size_t]
    }
}

; ── a JSON value tree (internal/packagejson/jsonvalue.go) ─────────────────────

define JsonKindAbsent: int 0
define JsonKindNull: int 1
define JsonKindBoolean: int 2
define JsonKindNumber: int 3
define JsonKindString: int 4
define JsonKindArray: int 5
define JsonKindObject: int 6

; the exports/imports object kinds (packagejson.ExportsOrImports.initObjectKind)
define JsonObjectKindConditions: int 0
define JsonObjectKindSubpaths: int 1
define JsonObjectKindImports: int 2
define JsonObjectKindInvalid: int 3

define JsonValue
(
    kind: int
    text: Slice[char]
    truth: bool
    keys: ref[Array[Slice[char]]]?
    values: ref[Array[ref[JsonValue]?]]?
)
{
    ; JSONValue.IsFalsy
    function is_falsy(this) returns bool
    {
        if (kind = JsonKindAbsent) or (kind = JsonKindNull)
            return true
        if kind = JsonKindString
            return (text.length as int) = 0
        if kind = JsonKindNumber
            return text.equals("0")
        if kind = JsonKindBoolean
            return truth = false
        false
    }

    function size(this) returns int
    {
        if values = null
            return 0
        (values as ref[Array[ref[JsonValue]?]]).get_length() as int
    }

    function key_at(this, i: int) returns Slice[char]
        (keys as ref[Array[Slice[char]]])[i as size_t]

    function value_at(this, i: int) returns ref[JsonValue]?
        (values as ref[Array[ref[JsonValue]?]])[i as size_t]

    ; an object member by key (null when absent or not an object)
    function get(this, key: Slice[char]) returns ref[JsonValue]?
    {
        if kind <> JsonKindObject
            return null
        let n this.size()
        var i 0
        while i < n
        {
            let k this.key_at(i)
            if k.equals(key)
                return this.value_at(i)
            set i: i + 1
        }
        null
    }

    ; the string of a member, empty when absent or not a string
    function string_of(this, key: Slice[char]) returns Slice[char]
    {
        let v this.get(key)
        if v = null
            return Slice[char]()
        let jv v as ref[JsonValue]
        if jv.kind <> JsonKindString
            return Slice[char]()
        jv.text
    }

    ; ExportsOrImports.initObjectKind: every key `.`-led → subpaths, `#`-led →
    ; imports, neither → conditions, a mix → invalid
    function object_kind(this) returns int
    {
        if kind <> JsonKindObject
            return JsonObjectKindConditions
        let n this.size()
        if n = 0
            return JsonObjectKindConditions
        var seen_dot false
        var seen_hash false
        var seen_other false
        var i 0
        while i < n
        {
            let k this.key_at(i)
            set i: i + 1
            if (k.length as int) = 0
                continue
            let c k[0] as int
            if c = ("." as char) as int
                set seen_dot: true
            if c = ("#" as char) as int
                set seen_hash: true
            if (c <> ("." as char) as int) and (c <> ("#" as char) as int)
                set seen_other: true
            if seen_other and (seen_dot or seen_hash)
                return JsonObjectKindInvalid
        }
        if seen_dot
            return JsonObjectKindSubpaths
        if seen_hash
            return JsonObjectKindImports
        JsonObjectKindConditions
    }
}

; a recursive-descent reader over the text (encoding/json's grammar); `ok`
; false after the first error, the value then null
define JsonParser
(
    host: ref[Page]
    text: Slice[char]
    pos: int
    ok: bool
)
{
    function parse(host: ref[Page], text: Slice[char]) returns ref[JsonValue]?
    {
        let jp &JsonParser^host(host, text, 0, true)
        jp.skip_ws()
        let v jp.parse_value()
        if jp.ok = false
            return null
        v
    }

    function peek(this) returns int
    {
        if pos >= (text.length as int)
            return 0 - 1
        text[pos as size_t] as int
    }

    procedure skip_ws(this)
    {
        while pos < (text.length as int)
        {
            let c text[pos as size_t] as int
            if (c = 32) or (c = 10) or (c = 13) or (c = 9)
                set pos: pos + 1
            else
                return
        }
    }

    procedure fail(this)
        set ok: false

    procedure parse_value(this) returns ref[JsonValue]?
    {
        if ok = false
            return null
        let c this.peek()
        if c = ("{" as char) as int
            return this.parse_object()
        if c = ("[" as char) as int
            return this.parse_array()
        if c = ("\"" as char) as int
        {
            let str this.parse_string()
            if ok = false
                return null
            return &JsonValue^host(JsonKindString, str, false, null, null)
        }
        if this.text_at_is("true")
        {
            set pos: pos + 4
            return &JsonValue^host(JsonKindBoolean, null, true, null, null)
        }
        if this.text_at_is("false")
        {
            set pos: pos + 5
            return &JsonValue^host(JsonKindBoolean, null, false, null, null)
        }
        if this.text_at_is("null")
        {
            set pos: pos + 4
            return &JsonValue^host(JsonKindNull, null, false, null, null)
        }
        ; a number: the run of number characters, kept as text
        let start pos
        while pos < (text.length as int)
        {
            let d text[pos as size_t] as int
            var number_char false
            if (d >= ("0" as char) as int) and (d <= ("9" as char) as int)
                set number_char: true
            if (d = ("-" as char) as int) or (d = ("+" as char) as int) or (d = ("." as char) as int) or (d = ("e" as char) as int) or (d = ("E" as char) as int)
                set number_char: true
            if number_char = false
                break
            set pos: pos + 1
        }
        if pos = start
        {
            this.fail()
            return null
        }
        &JsonValue^host(JsonKindNumber, text.subslice(start as size_t, pos as size_t), false, null, null)
    }

    function text_at_is(this, word: Slice[char]) returns bool
    {
        if (pos + (word.length as int)) > (text.length as int)
            return false
        let piece text.subslice(pos as size_t, (pos + (word.length as int)) as size_t)
        piece.equals(word)
    }

    procedure parse_object(this) returns ref[JsonValue]?
    {
        set pos: pos + 1
        let keys &Array[Slice[char]]^host()
        let values &Array[ref[JsonValue]?]^host()
        this.skip_ws()
        if this.peek() = ("}" as char) as int
        {
            set pos: pos + 1
            return &JsonValue^host(JsonKindObject, null, false, keys, values)
        }
        repeat
        {
            this.skip_ws()
            if this.peek() <> ("\"" as char) as int
            {
                this.fail()
                return null
            }
            let key this.parse_string()
            if ok = false
                return null
            this.skip_ws()
            if this.peek() <> (":" as char) as int
            {
                this.fail()
                return null
            }
            set pos: pos + 1
            this.skip_ws()
            let v this.parse_value()
            if ok = false
                return null
            keys.add(key)
            values.add(v)
            this.skip_ws()
            let c this.peek()
            if c = ("," as char) as int
            {
                set pos: pos + 1
                continue
            }
            if c = ("}" as char) as int
            {
                set pos: pos + 1
                return &JsonValue^host(JsonKindObject, null, false, keys, values)
            }
            this.fail()
            return null
        }
    }

    procedure parse_array(this) returns ref[JsonValue]?
    {
        set pos: pos + 1
        let values &Array[ref[JsonValue]?]^host()
        this.skip_ws()
        if this.peek() = ("]" as char) as int
        {
            set pos: pos + 1
            return &JsonValue^host(JsonKindArray, null, false, null, values)
        }
        repeat
        {
            this.skip_ws()
            let v this.parse_value()
            if ok = false
                return null
            values.add(v)
            this.skip_ws()
            let c this.peek()
            if c = ("," as char) as int
            {
                set pos: pos + 1
                continue
            }
            if c = ("]" as char) as int
            {
                set pos: pos + 1
                return &JsonValue^host(JsonKindArray, null, false, null, values)
            }
            this.fail()
            return null
        }
    }

    ; a string with its escapes decoded (\uXXXX as UTF-8, surrogate pairs joined)
    procedure parse_string(this) returns Slice[char]
    {
        set pos: pos + 1
        let sb StringBuilder^host()
        while pos < (text.length as int)
        {
            let c text[pos as size_t] as int
            if c = ("\"" as char) as int
            {
                set pos: pos + 1
                let s String^host(sb.to_string())
                return Slice[char](s.get_length(), s.get_buffer() as pointer[char])
            }
            if c = ("\\" as char) as int
            {
                set pos: pos + 1
                if pos >= (text.length as int)
                    break
                let e text[pos as size_t] as int
                set pos: pos + 1
                if e = ("n" as char) as int
                    sb.append("\n" as char)
                else
                {
                    if e = ("t" as char) as int
                        sb.append("\t" as char)
                    else
                    {
                        if e = ("r" as char) as int
                            sb.append("\r" as char)
                        else
                        {
                            if e = ("b" as char) as int
                                sb.append(8 as char)
                            else
                            {
                                if e = ("f" as char) as int
                                    sb.append(12 as char)
                                else
                                {
                                    if e = ("u" as char) as int
                                    {
                                        var code this.hex4()
                                        if code < 0
                                            break
                                        if (code >= 0xD800) and (code <= 0xDBFF)
                                        {
                                            ; a surrogate pair
                                            if this.text_at_is("\\u")
                                            {
                                                set pos: pos + 2
                                                let low this.hex4()
                                                if low < 0
                                                    break
                                                set code: 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
                                            }
                                        }
                                        JsonParser.append_utf8(sb, code)
                                    }
                                    else
                                        sb.append(e as char)
                                }
                            }
                        }
                    }
                }
                continue
            }
            sb.append(c as char)
            set pos: pos + 1
        }
        this.fail()
        Slice[char]()
    }

    ; four hex digits at pos, advancing; -1 when malformed
    procedure hex4(this) returns int
    {
        if (pos + 4) > (text.length as int)
            return 0 - 1
        var v 0
        var i 0
        while i < 4
        {
            let h text[(pos + i) as size_t] as int
            var d 0 - 1
            if (h >= ("0" as char) as int) and (h <= ("9" as char) as int)
                set d: h - (("0" as char) as int)
            if (h >= ("a" as char) as int) and (h <= ("f" as char) as int)
                set d: 10 + h - (("a" as char) as int)
            if (h >= ("A" as char) as int) and (h <= ("F" as char) as int)
                set d: 10 + h - (("A" as char) as int)
            if d < 0
                return 0 - 1
            set v: v * 16 + d
            set i: i + 1
        }
        set pos: pos + 4
        v
    }

    procedure append_utf8(sb: ref[StringBuilder], code: int)
    {
        if code < 0x80
        {
            sb.append(code as char)
            return
        }
        if code < 0x800
        {
            sb.append((0xC0 | (code >> 6)) as char)
            sb.append((0x80 | (code & 0x3F)) as char)
            return
        }
        if code < 0x10000
        {
            sb.append((0xE0 | (code >> 12)) as char)
            sb.append((0x80 | ((code >> 6) & 0x3F)) as char)
            sb.append((0x80 | (code & 0x3F)) as char)
            return
        }
        sb.append((0xF0 | (code >> 18)) as char)
        sb.append((0x80 | ((code >> 12) & 0x3F)) as char)
        sb.append((0x80 | ((code >> 6) & 0x3F)) as char)
        sb.append((0x80 | (code & 0x3F)) as char)
    }
}

; ── package.json, the fields the resolver reads ────────────────────────────────

define PackageJsonInfo
(
    exists: bool
    directory: Slice[char]
    name: Slice[char]
    types: Slice[char]
    typings: Slice[char]
    main: Slice[char]
    type_field: Slice[char]
    exports: ref[JsonValue]?
    imports: ref[JsonValue]?
    has_exports: bool
    has_imports: bool
    has_types_versions: bool
    ; the `typesVersions` value itself (slice 259)
    types_versions: ref[JsonValue]?
    ; the `tsconfig` field (slice 261: a config lookup's package file)
    tsconfig: Slice[char]
)
{
    function none() returns PackageJsonInfo
        PackageJsonInfo(false, null, null, null, null, null, null, null, null, false, false, false, null, null)

    ; the package.json of a directory, read off the table; `exists` false when
    ; the directory carries none. An unreadable document is a package.json whose
    ; fields are all absent (packagejson.Parse ignores its error).
    function at(host: ref[Page], files: ref[ProgramFiles], directory: Slice[char]) returns PackageJsonInfo
    {
        let path combine_paths(host, directory, "package.json")
        if files.file_exists(path) = false
            return PackageJsonInfo.none()
        var info PackageJsonInfo.none()
        set info.exists: true
        set info.directory: directory
        let root JsonParser.parse(host, files.text_of_path(path))
        if root = null
            return info
        let obj root as ref[JsonValue]
        if obj.kind <> JsonKindObject
            return info
        set info.name: obj.string_of("name")
        set info.types: obj.string_of("types")
        set info.typings: obj.string_of("typings")
        set info.main: obj.string_of("main")
        set info.type_field: obj.string_of("type")
        set info.tsconfig: obj.string_of("tsconfig")
        set info.exports: obj.get("exports")
        set info.imports: obj.get("imports")
        if info.exports <> null
            set info.has_exports: true
        if info.imports <> null
            set info.has_imports: true
        if obj.get("typesVersions") <> null
        {
            set info.has_types_versions: true
            set info.types_versions: obj.get("typesVersions")
        }
        info
    }
}

; ── the resolver ───────────────────────────────────────────────────────────────

; module/resolver.go's resolutionState over the program's table. `resolve`
; answers the INDEX of the file in the table, -1 for none; a shape this port has
; not written sets `stop_tag` (the checker records it) and answers -1.
; module/types.go's NodeResolutionFeatures
define ResolutionFeatureImports: int 1
; tryLoadModuleUsingPaths' two loaders (slice 259)
define ResolverLoaderNodeModules: int 1
define ResolverLoaderDirectory: int 2
define ResolutionFeatureSelfName: int 2
define ResolutionFeatureExports: int 4
define ResolutionFeatureExportsPatternTrailers: int 8
define ResolutionFeatureImportsPatternRoot: int 16

define ModuleResolver
(
    host: ref[Page]
    files: ref[ProgramFiles]
    module_resolution: int
    resolve_json: bool
    esm_mode: bool
    stop_tag: Slice[char]
    name: Slice[char]
    containing_directory: Slice[char]
    conditions: ref[Array[Slice[char]]]?
    features: int
    allow_js: bool
    out_dir: Slice[char]
    root_dir: Slice[char]
    ; the path the last successful file probe named (slice 260: a resolution's
    ; OriginalPath when a symlink stood in it)
    found_path: Slice[char]
    ; resolveConfig's lookup (slice 261): JSON only, a package's `tsconfig` field
    ; and `tsconfig` index
    is_config_lookup: bool
)
{
    ; `usage_mode` is the usage location's mode (ModuleKindNone/CommonJS/ESNext,
    ; the checker's GetEmitSyntaxForUsageLocation); `exports_option`/`imports_option`
    ; the two tristate options (2 = unset)
    function create(host: ref[Page], files: ref[ProgramFiles], module_resolution: int, resolve_json: bool, usage_mode: int, allow_js: bool, exports_option: int, imports_option: int, out_dir: Slice[char], root_dir: Slice[char]) returns ref[ModuleResolver]
    {
        var esm false
        if (module_resolution = ModuleResolutionKindNode16) or (module_resolution = ModuleResolutionKindNodeNext)
        {
            if usage_mode = 99
                set esm: true
        }
        ; GetConditions
        let conds &Array[Slice[char]]^host()
        var mode usage_mode
        if (mode = 0) and (module_resolution = ModuleResolutionKindBundler)
            set mode: 99
        if mode = 99
            conds.add("import")
        else
            conds.add("require")
        conds.add("types")
        if module_resolution <> ModuleResolutionKindBundler
            conds.add("node")
        var ci 0
        while ci < (files.custom_conditions.get_length() as int)
        {
            conds.add(files.custom_conditions[ci as size_t])
            set ci: ci + 1
        }
        ; getNodeResolutionFeatures
        var features ResolutionFeatureImports | ResolutionFeatureSelfName | ResolutionFeatureExports | ResolutionFeatureExportsPatternTrailers
        if module_resolution <> ModuleResolutionKindNode16
            set features: features | ResolutionFeatureImportsPatternRoot
        if exports_option = 1
            set features: features | ResolutionFeatureExports
        if exports_option = 0
            set features: features & (0 - 1 - ResolutionFeatureExports)
        if imports_option = 1
            set features: features | ResolutionFeatureImports
        if imports_option = 0
            set features: features & (0 - 1 - ResolutionFeatureImports)
        &ModuleResolver^host(host, files, module_resolution, resolve_json, esm, null, null, null, conds, features, allow_js, out_dir, root_dir, null, false)
    }

    function extensions(this) returns int
    {
        if is_config_lookup
            return ExtJson
        var ext ExtTypeScript | ExtJavaScript | ExtDeclaration
        if resolve_json
            set ext: ext | ExtJson
        ext
    }

    procedure stop(this, tag: Slice[char])
    {
        if (stop_tag.length as int) = 0
            set stop_tag: tag
    }

    ; ResolveModuleName → resolveNodeLike → resolveNodeLikeWorker
    procedure resolve(this, module_name: Slice[char], containing_file: Slice[char]) returns int
    {
        set name: module_name
        set containing_directory: get_directory_path(host, containing_file)
        set found_path.data: null
        set found_path.length: 0
        let r this.resolve_node_like_worker()
        ; createResolvedModuleHandlingSymlink: a non-relative resolution inside
        ; node_modules keeps the symlinked path as its OriginalPath
        if (r >= 0) and (is_external_module_name_relative(module_name) = false)
        {
            if slice_contains_node_modules(found_path)
            {
                let real slice_copy_on(host, files.path_at(r))
                let original slice_copy_on(host, found_path)
                if real.equals(original) = false
                    ProgramFiles.record_symlink_resolution(host, files, original, real)
            }
        }
        r
    }

    ; tryFile over the table, remembering the name that found the file
    procedure try_file_path(this, path: Slice[char]) returns int
    {
        let r files.index_of_path(path)
        if r >= 0
            set found_path: path
        r
    }

    ; module.ResolveConfig: a NodeNext CommonJS-mode lookup of a config file;
    ; `out_stopped` when it met a shape this port has not written
    function resolve_config(host: ref[Page], files: ref[ProgramFiles], module_name: Slice[char], containing_file: Slice[char], out_stopped: ref[bool]) returns int
    {
        let resolver ModuleResolver.create(host, files, ModuleResolutionKindNodeNext, false, 1, false, 2, 2, Slice[char](), Slice[char]())
        set resolver.is_config_lookup: true
        let r resolver.resolve(module_name, containing_file)
        if (resolver.stop_tag.length as int) > 0
            set out_stopped: true
        r
    }

    ; resolveNodeLikeWorker over `name` and `containing_directory` (re-entered by
    ; an imports map target that names another package)
    procedure resolve_node_like_worker(this) returns int
    {
        let module_name name
        let ext this.extensions()
        if is_external_module_name_relative(module_name) = false
        {
            if (features & ResolutionFeatureImports) <> 0
            {
                if ((module_name.length as int) > 0) and ((module_name[0] as int) = ("#" as char) as int)
                {
                    let r this.load_module_from_imports()
                    if r >= 0
                        return r
                    if (stop_tag.length as int) > 0
                        return 0 - 1
                }
            }
            if (features & ResolutionFeatureSelfName) <> 0
            {
                let r this.load_module_from_self_name_reference()
                if r >= 0
                    return r
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
            if slice_contains_byte(module_name, (":" as char) as int)
                return 0 - 1
            return this.load_module_from_nearest_node_modules_directory()
        }
        ; normalizePathForCJSResolution: a `.`/`..` tail keeps its separator
        var candidate get_normalized_absolute_path(host, combine_paths(host, containing_directory, module_name), Slice[char]())
        if module_name.equals(".") or module_name.equals("..") or module_name.ends_with("/.") or module_name.ends_with("/..")
            set candidate: ensure_trailing_directory_separator(host, candidate)
        this.node_load_module_by_relative_name(ext, candidate, true)
    }

    ; getPackageScopeForPath: the nearest package.json at or above a directory
    function package_scope_for_path(this, directory: Slice[char]) returns PackageJsonInfo
    {
        var dir directory
        repeat
        {
            let info PackageJsonInfo.at(host, files, dir)
            if info.exists
                return info
            let parent get_directory_path(host, dir)
            if parent.equals(dir)
                return PackageJsonInfo.none()
            set dir: parent
        }
    }

    ; loadModuleFromSelfNameReference
    procedure load_module_from_self_name_reference(this) returns int
    {
        let scope this.package_scope_for_path(containing_directory)
        if scope.exists = false
            return 0 - 1
        if scope.exports = null
            return 0 - 1
        if (scope.exports as ref[JsonValue]).is_falsy()
            return 0 - 1
        if (scope.name.length as int) = 0
            return 0 - 1
        ; the specifier's components must start with the package name's
        let pkg scope.name
        if name.starts_with(pkg) = false
            return 0 - 1
        var subpath: Slice[char] "."
        if (name.length as int) > (pkg.length as int)
        {
            if (name[pkg.length] as int) <> ("/" as char) as int
                return 0 - 1
            set subpath: join_slices(host, ".", name.slice_from(pkg.length))
        }
        let ext this.extensions()
        if allow_js and (slice_contains_node_modules(containing_directory) = false)
            return this.load_module_from_exports(scope, ext, subpath)
        let priority ext & (ExtTypeScript | ExtDeclaration)
        let r this.load_module_from_exports(scope, priority, subpath)
        if r >= 0
            return r
        if (stop_tag.length as int) > 0
            return 0 - 1
        this.load_module_from_exports(scope, ext & (ExtJavaScript | ExtJson), subpath)
    }

    ; loadModuleFromImports: the `#` map of the nearest package.json
    procedure load_module_from_imports(this) returns int
    {
        if name.equals("#")
            return 0 - 1
        if name.starts_with("#/") and ((features & ResolutionFeatureImportsPatternRoot) = 0)
            return 0 - 1
        let scope this.package_scope_for_path(containing_directory)
        if scope.exists = false
            return 0 - 1
        if scope.imports = null
            return 0 - 1
        let imports scope.imports as ref[JsonValue]
        if imports.kind <> JsonKindObject
            return 0 - 1
        this.load_module_from_exports_or_imports(this.extensions(), name, imports, scope, true)
    }

    ; loadModuleFromExports
    procedure load_module_from_exports(this, scope: PackageJsonInfo, ext: int, subpath: Slice[char]) returns int
    {
        if scope.exists = false
            return 0 - 1
        if scope.exports = null
            return 0 - 1
        let exports scope.exports as ref[JsonValue]
        if exports.is_falsy()
            return 0 - 1
        if subpath.equals(".")
        {
            var main_export: ref[JsonValue]? null
            if (exports.kind = JsonKindString) or (exports.kind = JsonKindArray)
                set main_export: exports
            if exports.kind = JsonKindObject
            {
                if exports.object_kind() = JsonObjectKindConditions
                    set main_export: exports
                else
                    set main_export: exports.get(".")
            }
            if main_export <> null
                return this.load_module_from_target_export_or_import(ext, subpath, scope, false, main_export as ref[JsonValue], Slice[char](), false, subpath)
            return 0 - 1
        }
        if exports.kind = JsonKindObject
        {
            if exports.object_kind() = JsonObjectKindSubpaths
                return this.load_module_from_exports_or_imports(ext, subpath, exports, scope, false)
        }
        0 - 1
    }

    ; loadModuleFromExportsOrImports: an exact key, else the pattern keys in
    ; ComparePatternKeys order
    procedure load_module_from_exports_or_imports(this, ext: int, module_name: Slice[char], lookup: ref[JsonValue], scope: PackageJsonInfo, is_imports: bool) returns int
    {
        if (module_name.ends_with("/") = false) and (slice_contains_byte(module_name, ("*" as char) as int) = false)
        {
            let target lookup.get(module_name)
            if target <> null
                return this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, target as ref[JsonValue], Slice[char](), false, module_name)
        }
        ; the expanding keys: exactly one `*`, or a trailing `/`
        let expanding &Array[int]^host()
        let n lookup.size()
        var i 0
        while i < n
        {
            let key lookup.key_at(i)
            var stars 0
            var ki 0
            while ki < (key.length as int)
            {
                if (key[ki as size_t] as int) = ("*" as char) as int
                    set stars: stars + 1
                set ki: ki + 1
            }
            if (stars = 1) or key.ends_with("/")
                expanding.add(i)
            set i: i + 1
        }
        ; insertion sort by ComparePatternKeys
        var a 1
        while a < (expanding.get_length() as int)
        {
            let moving expanding[a as size_t]
            var b a - 1
            while b >= 0
            {
                let there expanding[b as size_t]
                if ModuleResolver.compare_pattern_keys(lookup.key_at(moving), lookup.key_at(there)) < 0
                {
                    expanding.put((b + 1) as size_t, there)
                    set b: b - 1
                }
                else
                    break
            }
            expanding.put((b + 1) as size_t, moving)
            set a: a + 1
        }
        var e 0
        while e < (expanding.get_length() as int)
        {
            let ki2 expanding[e as size_t]
            set e: e + 1
            let potential lookup.key_at(ki2)
            let target lookup.value_at(ki2)
            if target = null
                continue
            let tv target as ref[JsonValue]
            let star slice_index_of_byte(potential, ("*" as char) as int)
            if ((features & ResolutionFeatureExportsPatternTrailers) <> 0) and ModuleResolver.matches_pattern_with_trailer(potential, module_name)
            {
                let sub_end (module_name.length as int) - ((potential.length as int) - 1 - star)
                let subpath module_name.subslice(star as size_t, sub_end as size_t)
                return this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, tv, subpath, true, potential)
            }
            if potential.ends_with("*")
            {
                let head potential.subslice(0, ((potential.length as int) - 1) as size_t)
                if module_name.starts_with(head)
                {
                    let subpath module_name.slice_from(((potential.length as int) - 1) as size_t)
                    return this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, tv, subpath, true, potential)
                }
                continue
            }
            if module_name.starts_with(potential)
            {
                let subpath module_name.slice_from(potential.length)
                return this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, tv, subpath, false, potential)
            }
        }
        0 - 1
    }

    ; loadModuleFromTargetExportOrImport
    procedure load_module_from_target_export_or_import(this, ext: int, module_name: Slice[char], scope: PackageJsonInfo, is_imports: bool, target: ref[JsonValue], subpath: Slice[char], is_pattern: bool, key: Slice[char]) returns int
    {
        if target.kind = JsonKindString
        {
            let target_string target.text
            if (is_pattern = false) and ((subpath.length as int) > 0) and (target_string.ends_with("/") = false)
                return 0 - 1
            if target_string.starts_with("./") = false
            {
                if is_imports and (target_string.starts_with("../") = false) and (target_string.starts_with("/") = false) and (is_rooted_disk_path(target_string) = false)
                {
                    ; an imports target that names another package resolves as that package
                    let saved_name name
                    let saved_directory containing_directory
                    set name: ModuleResolver.combined_import_target(host, target_string, subpath, is_pattern)
                    set containing_directory: ensure_trailing_directory_separator(host, scope.directory)
                    let r this.resolve_node_like_worker()
                    set name: saved_name
                    set containing_directory: saved_directory
                    return r
                }
                return 0 - 1
            }
            ; no `..`, `.` or `node_modules` after the first component, in the
            ; target nor in the subpath
            if ModuleResolver.path_has_forbidden_part(target_string, true)
                return 0 - 1
            if ModuleResolver.path_has_forbidden_part(subpath, false)
                return 0 - 1
            let resolved_target combine_paths(host, scope.directory, target_string)
            var final_path Slice[char]()
            if is_pattern
                set final_path: get_normalized_absolute_path(host, ModuleResolver.replace_star(host, resolved_target, subpath), Slice[char]())
            else
                set final_path: get_normalized_absolute_path(host, join_slices(host, resolved_target, subpath), Slice[char]())
            ; tryLoadInputFileForPath: with an outDir an output path is mapped back to
            ; its input under rootDir; without a rootDir (or a config) the project root
            ; is ambiguous and the target stays unresolved
            if ((out_dir.length as int) > 0) and (slice_contains_node_modules(final_path) = false)
            {
                if (root_dir.length as int) = 0
                    return 0 - 1
                let mapped this.load_input_file_for_output_path(ext, final_path)
                if mapped >= 0
                    return mapped
            }
            return this.load_file_name_from_package_json_field(ext, final_path)
        }
        if target.kind = JsonKindObject
        {
            let n target.size()
            var i 0
            while i < n
            {
                let condition target.key_at(i)
                let sub target.value_at(i)
                set i: i + 1
                if sub = null
                    continue
                if this.condition_matches(condition)
                {
                    let r this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, sub as ref[JsonValue], subpath, is_pattern, key)
                    if r >= 0
                        return r
                    if (stop_tag.length as int) > 0
                        return 0 - 1
                }
            }
            return 0 - 1
        }
        if target.kind = JsonKindArray
        {
            let n target.size()
            var i 0
            while i < n
            {
                let elem target.value_at(i)
                set i: i + 1
                if elem = null
                    continue
                let r this.load_module_from_target_export_or_import(ext, module_name, scope, is_imports, elem as ref[JsonValue], subpath, is_pattern, key)
                if r >= 0
                    return r
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
            return 0 - 1
        }
        0 - 1
    }

    ; tryLoadInputFileForPath's mapping: `<outDir>/<fragment>` → `<rootDir>/<fragment>`
    ; with the output extension swapped for each possible input extension
    procedure load_input_file_for_output_path(this, ext: int, final_path: Slice[char]) returns int
    {
        let out_prefix ensure_trailing_directory_separator(host, out_dir)
        if final_path.starts_with(out_prefix) = false
            return 0 - 1
        let fragment final_path.slice_from(out_prefix.length)
        let base combine_paths(host, root_dir, fragment)
        var known false
        if base.ends_with(".mjs") or base.ends_with(".cjs") or base.ends_with(".js") or base.ends_with(".json") or base.ends_with(".d.mts") or base.ends_with(".d.cts") or base.ends_with(".d.ts")
            set known: true
        if known = false
            return 0 - 1
        ; GetPossibleOriginalInputExtensionForExtension
        let candidates &Array[Slice[char]]^host()
        if base.ends_with(".d.mts") or base.ends_with(".mjs") or base.ends_with(".mts")
        {
            candidates.add(".mts")
            candidates.add(".mjs")
        }
        else
        {
            if base.ends_with(".d.cts") or base.ends_with(".cjs") or base.ends_with(".cts")
            {
                candidates.add(".cts")
                candidates.add(".cjs")
            }
            else
            {
                candidates.add(".tsx")
                candidates.add(".ts")
                candidates.add(".jsx")
                candidates.add(".js")
            }
        }
        let stem base.subslice(0, remove_file_extension(base) as size_t)
        var i 0
        while i < (candidates.get_length() as int)
        {
            let e candidates[i as size_t]
            set i: i + 1
            if ModuleResolver.extension_is_ok(ext, e) = false
                continue
            let input join_slices(host, stem, e)
            if files.file_exists(input)
            {
                let r this.load_file_name_from_package_json_field(ext, input)
                if r >= 0
                    return r
            }
        }
        0 - 1
    }

    ; extensionIsOk
    function extension_is_ok(ext: int, e: Slice[char]) returns bool
    {
        if e.equals(".ts") or e.equals(".tsx") or e.equals(".mts") or e.equals(".cts")
            return (ext & ExtTypeScript) <> 0
        if e.equals(".js") or e.equals(".jsx") or e.equals(".mjs") or e.equals(".cjs")
            return (ext & ExtJavaScript) <> 0
        if e.equals(".json")
            return (ext & ExtJson) <> 0
        (ext & ExtDeclaration) <> 0
    }

    ; conditionMatches: `default`, one of the conditions, or a `types@<range>` key
    ; the compiler's version satisfies (types 7.0.2)
    function condition_matches(this, condition: Slice[char]) returns bool
    {
        if condition.equals("default")
            return true
        let cl conditions as ref[Array[Slice[char]]]
        var i 0
        var has_types false
        while i < (cl.get_length() as int)
        {
            let c cl[i as size_t]
            if c.equals(condition)
                return true
            if c.equals("types")
                set has_types: true
            set i: i + 1
        }
        if has_types = false
            return false
        if condition.starts_with("types@") = false
            return false
        ModuleResolver.versioned_types_key_applies(host, condition.slice_from(6))
    }

    ; IsApplicableVersionedTypesKey's range half: TryParseVersionRange and Test
    ; against the compiler's version (slice 259: internal/semver whole)
    function versioned_types_key_applies(host: ref[Page], range: Slice[char]) returns bool
    {
        var ok false
        let r Semver.try_parse_version_range(host, range, &ok)
        if ok = false
            return false
        r.test(Semver.typescript_version())
    }

    ; ComparePatternKeys
    function compare_pattern_keys(a: Slice[char], b: Slice[char]) returns int
    {
        let a_star slice_index_of_byte(a, ("*" as char) as int)
        let b_star slice_index_of_byte(b, ("*" as char) as int)
        var base_a a.length as int
        if a_star >= 0
            set base_a: a_star + 1
        var base_b b.length as int
        if b_star >= 0
            set base_b: b_star + 1
        if base_a > base_b
            return 0 - 1
        if base_b > base_a
            return 1
        if a_star < 0
            return 1
        if b_star < 0
            return 0 - 1
        if (a.length as int) > (b.length as int)
            return 0 - 1
        if (b.length as int) > (a.length as int)
            return 1
        0
    }

    ; matchesPatternWithTrailer: `before*after` with a non-empty trailer
    function matches_pattern_with_trailer(target: Slice[char], candidate: Slice[char]) returns bool
    {
        if target.ends_with("*")
            return false
        let star slice_index_of_byte(target, ("*" as char) as int)
        if star < 0
            return false
        let before target.subslice(0, star as size_t)
        let after target.slice_from((star + 1) as size_t)
        candidate.starts_with(before) and candidate.ends_with(after)
    }

    ; the imports target with its subpath: the `*` replaced for a pattern, appended
    ; otherwise (page-hosted, so the resolver may hold it as its name)
    function combined_import_target(host: ref[Page], target_string: Slice[char], subpath: Slice[char], is_pattern: bool) returns Slice[char]
    {
        if is_pattern
            return ModuleResolver.replace_star(host, target_string, subpath)
        join_slices(host, target_string, subpath)
    }

    ; strings.ReplaceAll(s, "*", subpath)
    function replace_star(host: ref[Page], s: Slice[char], subpath: Slice[char]) returns Slice[char]
    {
        let sb StringBuilder^host()
        var i 0
        while i < (s.length as int)
        {
            let c s[i as size_t] as int
            if c = ("*" as char) as int
                sb.append(subpath.data, subpath.length)
            else
                sb.append(c as char)
            set i: i + 1
        }
        let out String^host(sb.to_string())
        Slice[char](out.get_length(), out.get_buffer() as pointer[char])
    }

    ; a `..`, `.` or `node_modules` component (after the first, when `skip_first`)
    function path_has_forbidden_part(path: Slice[char], skip_first: bool) returns bool
    {
        var start 0
        var index 0
        var i 0
        let n path.length as int
        while i <= n
        {
            var at_sep i = n
            if i < n
            {
                if (path[i as size_t] as int) = ("/" as char) as int
                    set at_sep: true
            }
            if at_sep
            {
                let part path.subslice(start as size_t, i as size_t)
                if (skip_first = false) or (index > 0)
                {
                    if part.equals("..") or part.equals(".") or part.equals("node_modules")
                        return true
                }
                set index: index + 1
                set start: i + 1
            }
            set i: i + 1
        }
        false
    }

    ; nodeLoadModuleByRelativeName
    procedure node_load_module_by_relative_name(this, ext: int, candidate: Slice[char], consider_package_json: bool) returns int
    {
        if has_trailing_directory_separator(candidate) = false
        {
            let parent get_directory_path(host, candidate)
            if files.directory_exists(parent) = false
                return 0 - 1
            let from_file this.load_module_from_file(ext, candidate)
            if from_file >= 0
                return from_file
            if (stop_tag.length as int) > 0
                return 0 - 1
        }
        if files.directory_exists(candidate) = false
            return 0 - 1
        ; esm mode relative imports do no directory lookups
        if esm_mode = false
            return this.load_node_module_from_directory(ext, candidate, consider_package_json)
        0 - 1
    }

    ; loadModuleFromFile: `./foo.js` → `./foo.ts`, then `./foo` → `./foo.ts`
    procedure load_module_from_file(this, ext: int, candidate: Slice[char]) returns int
    {
        let by_replacing this.load_module_from_file_no_implicit_extensions(ext, candidate)
        if by_replacing >= 0
            return by_replacing
        if esm_mode = false
            return this.try_adding_extensions(ext, candidate, Slice[char]())
        0 - 1
    }

    ; loadModuleFromFileNoImplicitExtensions
    procedure load_module_from_file_no_implicit_extensions(this, ext: int, candidate: Slice[char]) returns int
    {
        let slash slice_last_index_of_byte(candidate, ("/" as char) as int)
        let base candidate.slice_from((slash + 1) as size_t)
        if slice_contains_byte(base, ("." as char) as int) = false
            return 0 - 1
        var cut remove_file_extension(candidate)
        if cut = (candidate.length as int)
            set cut: slice_last_index_of_byte(candidate, ("." as char) as int)
        let extensionless candidate.subslice(0, cut as size_t)
        let extension candidate.slice_from(cut as size_t)
        this.try_adding_extensions(ext, extensionless, extension)
    }

    ; tryAddingExtensions, arm by arm
    procedure try_adding_extensions(this, ext: int, extensionless: Slice[char], original_extension: Slice[char]) returns int
    {
        let directory get_directory_path(host, extensionless)
        if ((directory.length as int) > 0) and (files.directory_exists(directory) = false)
            return 0 - 1
        var r 0 - 1
        if original_extension.equals(".mjs") or original_extension.equals(".mts") or original_extension.equals(".d.mts")
        {
            if (ext & ExtTypeScript) <> 0
            {
                set r: this.try_extension(".mts", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtDeclaration) <> 0
            {
                set r: this.try_extension(".d.mts", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtJavaScript) <> 0
            {
                set r: this.try_extension(".mjs", extensionless)
                if r >= 0
                    return r
            }
            return 0 - 1
        }
        if original_extension.equals(".cjs") or original_extension.equals(".cts") or original_extension.equals(".d.cts")
        {
            if (ext & ExtTypeScript) <> 0
            {
                set r: this.try_extension(".cts", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtDeclaration) <> 0
            {
                set r: this.try_extension(".d.cts", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtJavaScript) <> 0
            {
                set r: this.try_extension(".cjs", extensionless)
                if r >= 0
                    return r
            }
            return 0 - 1
        }
        if original_extension.equals(".json")
        {
            if (ext & ExtDeclaration) <> 0
            {
                set r: this.try_extension(".d.json.ts", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtJson) <> 0
            {
                set r: this.try_extension(".json", extensionless)
                if r >= 0
                    return r
            }
            return 0 - 1
        }
        if original_extension.equals(".tsx") or original_extension.equals(".jsx")
        {
            if (ext & ExtTypeScript) <> 0
            {
                set r: this.try_extension(".tsx", extensionless)
                if r >= 0
                    return r
                set r: this.try_extension(".ts", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtDeclaration) <> 0
            {
                set r: this.try_extension(".d.ts", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtJavaScript) <> 0
            {
                set r: this.try_extension(".jsx", extensionless)
                if r >= 0
                    return r
                set r: this.try_extension(".js", extensionless)
                if r >= 0
                    return r
            }
            return 0 - 1
        }
        if original_extension.equals(".ts") or original_extension.equals(".d.ts") or original_extension.equals(".js") or ((original_extension.length as int) = 0)
        {
            if (ext & ExtTypeScript) <> 0
            {
                set r: this.try_extension(".ts", extensionless)
                if r >= 0
                    return r
                set r: this.try_extension(".tsx", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtDeclaration) <> 0
            {
                set r: this.try_extension(".d.ts", extensionless)
                if r >= 0
                    return r
            }
            if (ext & ExtJavaScript) <> 0
            {
                set r: this.try_extension(".js", extensionless)
                if r >= 0
                    return r
                set r: this.try_extension(".jsx", extensionless)
                if r >= 0
                    return r
            }
            if is_config_lookup
            {
                set r: this.try_extension(".json", extensionless)
                if r >= 0
                    return r
            }
            return 0 - 1
        }
        ; an arbitrary extension: its declaration file `.d.<ext>.ts`
        if (ext & ExtDeclaration) <> 0
        {
            let whole join_slices(host, extensionless, original_extension)
            if is_declaration_file_name_of(whole) = false
            {
                let dext join_slices(host, join_slices(host, ".d", original_extension), ".ts")
                set r: this.try_extension(dext, extensionless)
                if r >= 0
                    return r
            }
        }
        0 - 1
    }

    ; tryExtension → tryFile (moduleSuffixes are not read)
    procedure try_extension(this, extension: Slice[char], extensionless: Slice[char]) returns int
    {
        let file_name join_slices(host, extensionless, extension)
        this.try_file_path(file_name)
    }

    ; loadNodeModuleFromDirectory(Worker): the package.json's file, then `index`
    procedure load_node_module_from_directory(this, ext: int, candidate: Slice[char], consider_package_json: bool) returns int
    {
        var info PackageJsonInfo.none()
        if consider_package_json
            set info: PackageJsonInfo.at(host, files, candidate)
        this.load_node_module_from_directory_worker(ext, candidate, info)
    }

    procedure load_node_module_from_directory_worker(this, ext: int, candidate: Slice[char], info: PackageJsonInfo) returns int
    {
        var package_file Slice[char]()
        var version_paths: ref[JsonValue]? null
        if info.exists
        {
            set version_paths: this.version_paths_of(info)
            ; the package file only for the package's own directory (slice 259)
            if ModuleResolver.same_directory(candidate, info.directory)
                set package_file: this.package_file_of(ext, info)
        }
        if version_paths <> null
        {
            var in_candidate true
            if (package_file.length as int) > 0
                set in_candidate: ModuleResolver.directory_contains(candidate, package_file)
            if in_candidate
            {
                var module_name Slice[char]()
                if (package_file.length as int) > 0
                    set module_name: ModuleResolver.relative_below(candidate, package_file)
                else
                {
                    var index_name: Slice[char] "index"
                    if is_config_lookup
                    {
                        let tsconfig_name: Slice[char] "tsconfig"
                        set index_name: tsconfig_name
                    }
                    set module_name: ModuleResolver.relative_below(candidate, combine_paths(host, candidate, index_name))
                }
                let from_paths this.try_load_module_using_paths(ext, module_name, candidate, version_paths as ref[JsonValue], ResolverLoaderDirectory, info, Slice[char]())
                if from_paths >= 0
                    return from_paths
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
        }
        if (package_file.length as int) > 0
        {
            let r this.load_package_file(ext, package_file, info)
            if r >= 0
                return r
            if (stop_tag.length as int) > 0
                return 0 - 1
        }
        ; ESM mode resolutions do no package `index` lookups
        if esm_mode = false
        {
            if files.directory_exists(candidate) = false
                return 0 - 1
            if is_config_lookup
                return this.load_module_from_file(ext, combine_paths(host, candidate, "tsconfig"))
            return this.load_module_from_file(ext, combine_paths(host, candidate, "index"))
        }
        0 - 1
    }

    ; the worker's `loader`: the field's path as a file, then as a module by
    ; relative name with esm mode off for a package that is not `"type": "module"`
    procedure load_package_file(this, ext: int, package_file: Slice[char], info: PackageJsonInfo) returns int
    {
        let from_field this.load_file_name_from_package_json_field(ext, package_file)
        if from_field >= 0
            return from_field
        var expanded ext
        if ext = ExtDeclaration
            set expanded: ExtTypeScript | ExtDeclaration
        let save_esm esm_mode
        if info.exists
        {
            if info.type_field.equals("module") = false
                set esm_mode: false
        }
        let r this.node_load_module_by_relative_name(expanded, package_file, false)
        set esm_mode: save_esm
        r
    }

    ; getPackageFile: typings, types, then main, combined with the package directory
    function package_file_of(this, ext: int, info: PackageJsonInfo) returns Slice[char]
    {
        if is_config_lookup
        {
            if (info.tsconfig.length as int) > 0
                return get_normalized_absolute_path(host, combine_paths(host, info.directory, info.tsconfig), Slice[char]())
            return Slice[char]()
        }
        if (ext & ExtDeclaration) <> 0
        {
            if (info.typings.length as int) > 0
                return get_normalized_absolute_path(host, combine_paths(host, info.directory, info.typings), Slice[char]())
            if (info.types.length as int) > 0
                return get_normalized_absolute_path(host, combine_paths(host, info.directory, info.types), Slice[char]())
        }
        if (ext & (ExtTypeScript | ExtJavaScript | ExtDeclaration)) <> 0
        {
            if (info.main.length as int) > 0
                return get_normalized_absolute_path(host, combine_paths(host, info.directory, info.main), Slice[char]())
        }
        Slice[char]()
    }

    ; loadFileNameFromPackageJSONField: a TS/declaration path is tried as written
    ; and nothing else; anything else strips and re-adds extensions
    procedure load_file_name_from_package_json_field(this, ext: int, candidate: Slice[char]) returns int
    {
        var direct false
        if ((ext & ExtTypeScript) <> 0) and has_implementation_ts_file_extension(candidate)
            set direct: true
        if ((ext & ExtDeclaration) <> 0) and is_declaration_file_name_of(candidate)
            set direct: true
        if direct
            return this.try_file_path(candidate)
        if is_config_lookup and ((ext & ExtJson) <> 0) and candidate.ends_with(".json")
        {
            let found this.try_file_path(candidate)
            if found >= 0
                return found
        }
        this.load_module_from_file_no_implicit_extensions(ext, candidate)
    }

    ; loadModuleFromNearestNodeModulesDirectory: TS and declarations first up
    ; every ancestor, then JavaScript
    procedure load_module_from_nearest_node_modules_directory(this) returns int
    {
        let ext this.extensions()
        let priority ext & (ExtTypeScript | ExtDeclaration)
        let secondary ext & (ExtJavaScript | ExtJson)
        if priority <> 0
        {
            let r this.load_module_from_nearest_node_modules_directory_worker(priority)
            if r >= 0
                return r
            if (stop_tag.length as int) > 0
                return 0 - 1
        }
        if secondary <> 0
            return this.load_module_from_nearest_node_modules_directory_worker(secondary)
        0 - 1
    }

    procedure load_module_from_nearest_node_modules_directory_worker(this, ext: int) returns int
    {
        var dir containing_directory
        repeat
        {
            let base get_base_file_name(host, dir)
            if base.equals("node_modules") = false
            {
                let r this.load_module_from_immediate_node_modules_directory(ext, dir)
                if r >= 0
                    return r
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
            let parent get_directory_path(host, dir)
            if parent.equals(dir)
                return 0 - 1
            set dir: parent
        }
    }

    ; loadModuleFromImmediateNodeModulesDirectory: the package, then `@types`
    procedure load_module_from_immediate_node_modules_directory(this, ext: int, directory: Slice[char]) returns int
    {
        let node_modules combine_paths(host, directory, "node_modules")
        if files.directory_exists(node_modules) = false
            return 0 - 1
        let r this.load_module_from_specific_node_modules_directory(ext, name, node_modules)
        if r >= 0
            return r
        if (stop_tag.length as int) > 0
            return 0 - 1
        if (ext & ExtDeclaration) <> 0
        {
            let at_types combine_paths(host, node_modules, "@types")
            if files.directory_exists(at_types) = false
                return 0 - 1
            return this.load_module_from_specific_node_modules_directory(ExtDeclaration, mangle_scoped_package_name(host, name), at_types)
        }
        0 - 1
    }

    ; loadModuleFromSpecificNodeModulesDirectory
    procedure load_module_from_specific_node_modules_directory(this, ext: int, module_name: Slice[char], node_modules_directory: Slice[char]) returns int
    {
        let candidate remove_trailing_directory_separator(get_normalized_absolute_path(host, combine_paths(host, node_modules_directory, module_name), Slice[char]()))
        let split package_name_split(module_name)
        var package_name module_name
        var rest Slice[char]()
        if split >= 0
        {
            set package_name: module_name.subslice(0, split as size_t)
            set rest: module_name.slice_from((split + 1) as size_t)
        }
        let package_directory combine_paths(host, node_modules_directory, package_name)
        ; a nested package.json first (`node_modules/foo/bar/package.json`)
        var info PackageJsonInfo.at(host, files, candidate)
        var root_info PackageJsonInfo.none()
        var root_read false
        if ((rest.length as int) > 0) and info.exists
        {
            set root_info: PackageJsonInfo.at(host, files, package_directory)
            set root_read: true
            if (root_info.exists = false) or (root_info.has_exports = false)
            {
                let from_file this.load_module_from_file(ext, candidate)
                if from_file >= 0
                    return from_file
                let from_directory this.load_node_module_from_directory_worker(ext, candidate, info)
                if from_directory >= 0
                    return from_directory
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
        }
        if (rest.length as int) > 0
        {
            if root_read = false
                set root_info: PackageJsonInfo.at(host, files, package_directory)
            set info: root_info
        }
        if info.exists
        {
            ; package exports are higher priority than file/directory lookups (a
            ; top-level `"exports": null` does not block them)
            if ((features & ResolutionFeatureExports) <> 0) and (info.exports <> null)
            {
                if (info.exports as ref[JsonValue]).is_falsy() = false
                {
                    var subpath: Slice[char] "."
                    if (rest.length as int) > 0
                        set subpath: join_slices(host, "./", rest)
                    return this.load_module_from_exports(info, ext, subpath)
                }
            }
            if (rest.length as int) > 0
            {
                let version_paths this.version_paths_of(info)
                if version_paths <> null
                {
                    let from_paths this.try_load_module_using_paths(ext, rest, package_directory, version_paths as ref[JsonValue], ResolverLoaderNodeModules, info, rest)
                    if from_paths >= 0
                        return from_paths
                    if (stop_tag.length as int) > 0
                        return 0 - 1
                }
            }
        }
        this.node_modules_loader(ext, candidate, rest, info)
    }

    ; loadModuleFromSpecificNodeModulesDirectory's `loader`
    procedure node_modules_loader(this, ext: int, candidate: Slice[char], rest: Slice[char], info: PackageJsonInfo) returns int
    {
        if ((rest.length as int) > 0) or (esm_mode = false)
        {
            let from_file this.load_module_from_file(ext, candidate)
            if from_file >= 0
                return from_file
        }
        let from_directory this.load_node_module_from_directory_worker(ext, candidate, info)
        if from_directory >= 0
            return from_directory
        if (stop_tag.length as int) > 0
            return 0 - 1
        if ((rest.length as int) = 0) and info.exists and esm_mode
        {
            ; a bare package in esm mode still assumes `index.js`
            return this.load_module_from_file(ext, combine_paths(host, candidate, "index.js"))
        }
        0 - 1
    }

    ; PackageJson.GetVersionPaths: the `typesVersions` entry whose key is a range
    ; this compiler's version satisfies, null for none (or for a matching entry that
    ; is not an object, which ends the search)
    function version_paths_of(this, info: PackageJsonInfo) returns ref[JsonValue]?
        ModuleResolver.version_paths_for(host, info)

    function version_paths_for(host: ref[Page], info: PackageJsonInfo) returns ref[JsonValue]?
    {
        if info.types_versions = null
            return null
        let tv info.types_versions as ref[JsonValue]
        if tv.kind <> JsonKindObject
            return null
        let version Semver.typescript_version()
        let n tv.size()
        var i 0
        while i < n
        {
            let key tv.key_at(i)
            let value tv.value_at(i)
            set i: i + 1
            var ok false
            let key_range Semver.try_parse_version_range(host, key, &ok)
            if ok = false
                continue
            if key_range.test(version)
            {
                if value = null
                    return null
                if (value as ref[JsonValue]).kind <> JsonKindObject
                    return null
                return value
            }
        }
        null
    }

    ; tryLoadModuleUsingPaths over MatchPatternOrExact(TryParsePatterns(paths)).
    ; `loader` names the caller's closure: the node_modules directory's or the
    ; directory worker's; `rest` is the former's module subpath
    procedure try_load_module_using_paths(this, ext: int, module_name: Slice[char], containing_directory: Slice[char], paths: ref[JsonValue], loader: int, info: PackageJsonInfo, rest: Slice[char]) returns int
    {
        var found false
        let key ModuleResolver.match_pattern_or_exact(paths, module_name, &found)
        if found = false
            return 0 - 1
        let star slice_index_of_byte(key, ("*" as char) as int)
        var matched_star Slice[char]()
        if star >= 0
            set matched_star: module_name.subslice(star as size_t, ((module_name.length as int) - (key.length as int) + star + 1) as size_t)
        let substitutions paths.get(key)
        if substitutions = null
            return 0 - 1
        let subs substitutions as ref[JsonValue]
        if subs.kind <> JsonKindArray
            return 0 - 1
        var i 0
        while i < subs.size()
        {
            let sv subs.value_at(i)
            set i: i + 1
            var subst Slice[char]()
            if sv <> null
            {
                if (sv as ref[JsonValue]).kind = JsonKindString
                    set subst: (sv as ref[JsonValue]).text
            }
            ; strings.Replace(subst, "*", matchedStar, 1)
            var path subst
            let subst_star slice_index_of_byte(subst, ("*" as char) as int)
            if subst_star >= 0
                set path: join_slices(host, join_slices(host, subst.subslice(0, subst_star as size_t), matched_star), subst.slice_from((subst_star + 1) as size_t))
            let candidate get_normalized_absolute_path(host, combine_paths(host, containing_directory, path), Slice[char]())
            ; a path mapping may have an extension
            if ModuleResolver.has_known_extension(subst)
            {
                let direct this.try_file_path(candidate)
                if direct >= 0
                    return direct
            }
            var r 0 - 1
            if loader = ResolverLoaderNodeModules
                set r: this.node_modules_loader(ext, candidate, rest, info)
            else
                set r: this.load_package_file(ext, candidate, info)
            if r >= 0
                return r
            if (stop_tag.length as int) > 0
                return 0 - 1
        }
        0 - 1
    }

    ; MatchPatternOrExact: an exact key first, then the pattern with the longest
    ; prefix (FindBestPatternMatch); TryParsePattern refuses a key with two stars
    function match_pattern_or_exact(paths: ref[JsonValue], candidate: Slice[char], found: ref[bool]) returns Slice[char]
    {
        set found: false
        let n paths.size()
        var i 0
        while i < n
        {
            let key paths.key_at(i)
            set i: i + 1
            if slice_index_of_byte(key, ("*" as char) as int) < 0
            {
                if key.equals(candidate)
                {
                    set found: true
                    return key
                }
            }
        }
        var best Slice[char]()
        var longest 0 - 1
        set i: 0
        while i < n
        {
            let key paths.key_at(i)
            set i: i + 1
            let star slice_index_of_byte(key, ("*" as char) as int)
            if star < 0
                continue
            if slice_index_of_byte(key.slice_from((star + 1) as size_t), ("*" as char) as int) >= 0
                continue
            if star <= longest
                continue
            if (candidate.length as int) < ((key.length as int) - 1)
                continue
            if candidate.starts_with(key.subslice(0, star as size_t)) = false
                continue
            if candidate.ends_with(key.slice_from((star + 1) as size_t)) = false
                continue
            set best: key
            set longest: star
            set found: true
        }
        best
    }

    ; tspath.TryGetExtensionFromPath answering non-empty
    function has_known_extension(path: Slice[char]) returns bool
    {
        if path.ends_with(".d.ts") or path.ends_with(".d.mts") or path.ends_with(".d.cts")
            return true
        if path.ends_with(".ts") or path.ends_with(".tsx") or path.ends_with(".mts") or path.ends_with(".cts")
            return true
        if path.ends_with(".js") or path.ends_with(".jsx") or path.ends_with(".mjs") or path.ends_with(".cjs")
            return true
        path.ends_with(".json")
    }

    ; tspath.ComparePaths(a, b) == 0 over two normalized directories
    function same_directory(a: Slice[char], b: Slice[char]) returns bool
    {
        var an a.length as int
        var bn b.length as int
        if (an > 1) and ((a[(an - 1) as size_t] as int) = 47)
            set an: an - 1
        if (bn > 1) and ((b[(bn - 1) as size_t] as int) = 47)
            set bn: bn - 1
        if an <> bn
            return false
        let sa a.subslice(0, an as size_t)
        let sb b.subslice(0, bn as size_t)
        sa.equals(sb)
    }

    ; tspath.ContainsPath(directory, path)
    function directory_contains(directory: Slice[char], path: Slice[char]) returns bool
    {
        var dn directory.length as int
        if (dn > 1) and ((directory[(dn - 1) as size_t] as int) = 47)
            set dn: dn - 1
        if (path.length as int) <= dn
            return ModuleResolver.same_directory(directory, path)
        let head path.subslice(0, dn as size_t)
        let dir directory.subslice(0, dn as size_t)
        if head.equals(dir) = false
            return false
        (path[dn as size_t] as int) = 47
    }

    ; GetRelativePathFromDirectory(directory, path) for a path below the directory
    function relative_below(directory: Slice[char], path: Slice[char]) returns Slice[char]
    {
        var dn directory.length as int
        if (dn > 1) and ((directory[(dn - 1) as size_t] as int) = 47)
            set dn: dn - 1
        if (path.length as int) <= (dn + 1)
            return Slice[char]()
        path.slice_from((dn + 1) as size_t)
    }
}
