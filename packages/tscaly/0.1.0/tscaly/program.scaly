            if (typings.length as int) > 0
                return typings
            let types this.package_json_path_field(info, "types", info.types)
            if (types.length as int) > 0
                return types
        }
        if (ext & (ExtTypeScript | ExtJavaScript | ExtDeclaration)) <> 0
            return this.package_json_path_field(info, "main", info.main)
        Slice[char]()
    }

    ; getPackageJSONPathField: a string field's path under the package directory,
    ; empty when the field is absent, not a string or empty
    procedure package_json_path_field(this, info: PackageJsonInfo, field_name: Slice[char], value: Slice[char]) returns Slice[char]
    {
        if this.validate_package_json_field(info, field_name, JsonKindString) = false
            return Slice[char]()
        if (value.length as int) = 0
        {
            this.trace1(TrX_package_json_had_a_falsy_0_field, field_name)
            return Slice[char]()
        }
        let path get_normalized_absolute_path(host, combine_paths(host, info.directory, value), Slice[char]())
        this.trace3(TrX_package_json_has_0_field_1_that_references_2, field_name, value, path)
        path
    }

    ; loadFileNameFromPackageJSONField: a TS/declaration path is tried as written
    ; and nothing else; anything else strips and re-adds extensions
    procedure load_file_name_from_package_json_field(this, ext: int, candidate: Slice[char], package_json_value: Slice[char]) returns int
    {
        var direct false
        if ((ext & ExtTypeScript) <> 0) and has_implementation_ts_file_extension(candidate)
            set direct: true
        if ((ext & ExtDeclaration) <> 0) and is_declaration_file_name_of(candidate)
            set direct: true
        if direct
        {
            let found this.try_file_path(candidate)
            ; resolvedUsingTsExtension: the pattern ends with `*` and the candidate
            ; (so the `*`) carries a TS extension
            if (found >= 0) and package_json_value.ends_with("*")
                set resolved_using_ts_extension: true
            return found
        }
        if is_config_lookup and ((ext & ExtJson) <> 0) and candidate.ends_with(".json")
        {
            let found this.try_file_path(candidate)
            if found >= 0
                return found
        }
        this.load_module_from_file_no_implicit_extensions(ext, candidate)
    }

    ; loadModuleFromNearestNodeModulesDirectory: TS and declarations first up
    ; every ancestor, then JavaScript
    procedure load_module_from_nearest_node_modules_directory(this) returns int
    {
        let ext this.extensions()
        let priority ext & (ExtTypeScript | ExtDeclaration)
        let secondary ext & (ExtJavaScript | ExtJson)
        if priority <> 0
        {
            if traces <> null
                this.trace1(TrSearching_all_ancestor_node_modules_directories_for_preferred_extensions_Colon_0, ModuleResolver.extensions_text(host, priority))
            let r this.load_module_from_nearest_node_modules_directory_worker(priority)
            if r >= 0
                return r
            if (stop_tag.length as int) > 0
                return 0 - 1
        }
        if secondary <> 0
        {
            if traces <> null
                this.trace1(TrSearching_all_ancestor_node_modules_directories_for_fallback_extensions_Colon_0, ModuleResolver.extensions_text(host, secondary))
            return this.load_module_from_nearest_node_modules_directory_worker(secondary)
        }
        0 - 1
    }

    procedure load_module_from_nearest_node_modules_directory_worker(this, ext: int) returns int
    {
        var dir containing_directory
        repeat
        {
            let base get_base_file_name(host, dir)
            if base.equals("node_modules") = false
            {
                let r this.load_module_from_immediate_node_modules_directory(ext, dir)
                if r >= 0
                    return r
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
            let parent get_directory_path(host, dir)
            if parent.equals(dir)
                return 0 - 1
            set dir: parent
        }
    }

    ; loadModuleFromImmediateNodeModulesDirectory: the package, then `@types`
    procedure load_module_from_immediate_node_modules_directory(this, ext: int, directory: Slice[char]) returns int
    {
        let node_modules combine_paths(host, directory, "node_modules")
        if files.directory_exists(node_modules) = false
        {
            this.trace1(TrDirectory_0_does_not_exist_skipping_all_lookups_in_it, node_modules)
            return 0 - 1
        }
        let r this.load_module_from_specific_node_modules_directory(ext, name, node_modules)
        if r >= 0
            return r
        if (stop_tag.length as int) > 0
            return 0 - 1
        if (ext & ExtDeclaration) <> 0
        {
            let at_types combine_paths(host, node_modules, "@types")
            if files.directory_exists(at_types) = false
            {
                this.trace1(TrDirectory_0_does_not_exist_skipping_all_lookups_in_it, at_types)
                return 0 - 1
            }
            return this.load_module_from_specific_node_modules_directory(ExtDeclaration, this.mangle_scoped(name), at_types)
        }
        0 - 1
    }

    ; loadModuleFromSpecificNodeModulesDirectory
    procedure load_module_from_specific_node_modules_directory(this, ext: int, module_name: Slice[char], node_modules_directory: Slice[char]) returns int
    {
        let candidate remove_trailing_directory_separator(get_normalized_absolute_path(host, combine_paths(host, node_modules_directory, module_name), Slice[char]()))
        let split package_name_split(module_name)
        var package_name module_name
        var rest Slice[char]()
        if split >= 0
        {
            set package_name: module_name.subslice(0, split as size_t)
            set rest: module_name.slice_from((split + 1) as size_t)
        }
        var package_directory combine_paths(host, node_modules_directory, package_name)
        if (package_name.length as int) = 0
            set package_directory: candidate
        ; a nested package.json first (`node_modules/foo/bar/package.json`); the root
        ; one is "nil" unless read and present
        var info this.package_json_info(candidate)
        var root_info PackageJsonInfo.none()
        if ((rest.length as int) > 0) and info.exists
        {
            if (features & ResolutionFeatureExports) <> 0
                set root_info: this.package_json_info(package_directory)
            if (root_info.exists = false) or (root_info.has_exports = false)
            {
                let from_file this.load_module_from_file(ext, candidate)
                if from_file >= 0
                    return from_file
                if (stop_tag.length as int) > 0
                    return 0 - 1
                let from_directory this.load_node_module_from_directory_worker(ext, candidate, info)
                if from_directory >= 0
                {
                    this.set_package_id(from_directory, info)
                    return from_directory
                }
                if (stop_tag.length as int) > 0
                    return 0 - 1
            }
        }
        if (rest.length as int) > 0
        {
            set info: root_info
            if info.exists = false
                set info: this.package_json_info(package_directory)
        }
        if info.exists
        {
            set this.resolved_package_directory: true
            ; package exports are higher priority than file/directory lookups (a
            ; top-level `"exports": null` does not block them)
            if ((features & ResolutionFeatureExports) <> 0) and (info.exports <> null)
            {
                if (info.exports as ref[JsonValue]).is_falsy() = false
                {
                    var subpath: Slice[char] "."
                    if (rest.length as int) > 0
                        set subpath: join_slices(host, "./", rest)
                    return this.load_module_from_exports(info, ext, subpath)
                }
            }
            if (rest.length as int) > 0
            {
                var version_key Slice[char]()
                let version_paths this.version_paths_traced(info, &version_key)
                if version_paths <> null
                {
                    this.trace3(TrX_package_json_has_a_typesVersions_entry_0_that_matches_compiler_version_1_looking_for_a_pattern_to_match_module_name_2, version_key, "7.0.2", rest)
                    let from_paths this.try_load_module_using_paths(ext, rest, package_directory, version_paths as ref[JsonValue], ResolverLoaderNodeModules, info, rest)
                    if from_paths >= 0
                        return from_paths
                    if (stop_tag.length as int) > 0
                        return 0 - 1
                }
            }
        }
        this.node_modules_loader(ext, candidate, rest, info)
    }

    ; loadModuleFromSpecificNodeModulesDirectory's `loader`
    procedure node_modules_loader(this, ext: int, candidate: Slice[char], rest: Slice[char], info: PackageJsonInfo) returns int
    {
        if ((rest.length as int) > 0) or (esm_mode = false)
        {
            let from_file this.load_module_from_file(ext, candidate)
            if from_file >= 0
            {
                this.set_package_id(from_file, info)
                return from_file
            }
        }
        let from_directory this.load_node_module_from_directory_worker(ext, candidate, info)
        if from_directory >= 0
        {
            this.set_package_id(from_directory, info)
            return from_directory
        }
        if (stop_tag.length as int) > 0
            return 0 - 1
        if ((rest.length as int) = 0) and info.exists and esm_mode
        {
            var exports_absent info.exports = null
            if info.exports <> null
                set exports_absent: (info.exports as ref[JsonValue]).kind = JsonKindNull
            if exports_absent
            {
                ; a bare package in esm mode still assumes `index.js`
                let index_result this.load_module_from_file(ext, combine_paths(host, candidate, "index.js"))
                if index_result >= 0
                    this.set_package_id(index_result, info)
                return index_result
            }
        }
        0 - 1
    }

    ; PackageJson.GetVersionPaths with its traces: the `typesVersions` entry whose
    ; key is a range this compiler's version satisfies (`out_key`), null for none
    procedure version_paths_traced(this, info: PackageJsonInfo, out_key: ref[Slice[char]]) returns ref[JsonValue]?
    {
        var value: ref[JsonValue]? null
        if info.raw <> null
            set value: (info.raw as ref[JsonValue]).get("typesVersions")
        if value = null
        {
            this.trace1(TrX_package_json_does_not_have_a_0_field, "typesVersions")
            return null
        }
        let tv value as ref[JsonValue]
        if tv.kind <> JsonKindObject
        {
            this.trace3(TrExpected_type_of_0_field_in_package_json_to_be_1_got_2, "typesVersions", "object", ModuleResolver.json_type_name(tv))
            return null
        }
        this.trace1(TrX_package_json_has_a_typesVersions_field_with_version_specific_path_mappings, "typesVersions")
        let version Semver.typescript_version()
        let n tv.size()
        var i 0
        while i < n
        {
            let key tv.key_at(i)
            let entry tv.value_at(i)
            set i: i + 1
            var ok false
            let key_range Semver.try_parse_version_range(host, key, &ok)
            if ok = false
            {
                this.trace1(TrX_package_json_has_a_typesVersions_entry_0_that_is_not_a_valid_semver_range, key)
                continue
            }
            if key_range.test(version)
            {
                var entry_kind JsonKindNull
                if entry <> null
                    set entry_kind: (entry as ref[JsonValue]).kind
                if entry_kind <> JsonKindObject
                {
                    if traces <> null
                    {
                        let quoted join_slices(host, join_slices(host, "typesVersions['", key), "']")
                        var got: Slice[char] "null"
                        if entry <> null
                            set got: ModuleResolver.json_type_name(entry as ref[JsonValue])
                        this.trace3(TrExpected_type_of_0_field_in_package_json_to_be_1_got_2, quoted, "object", got)
                    }
                    return null
                }
                set out_key.data: key.data
                set out_key.length: key.length
                return entry
            }
        }
        this.trace1(TrX_package_json_does_not_have_a_typesVersions_entry_that_matches_version_0, "7.0")
        null
    }

    function version_paths_for(host: ref[Page], info: PackageJsonInfo) returns ref[JsonValue]?
    {
        if info.types_versions = null
            return null
        let tv info.types_versions as ref[JsonValue]
        if tv.kind <> JsonKindObject
            return null
        let version Semver.typescript_version()
        let n tv.size()
        var i 0
        while i < n
        {
            let key tv.key_at(i)
            let value tv.value_at(i)
            set i: i + 1
            var ok false
            let key_range Semver.try_parse_version_range(host, key, &ok)
            if ok = false
                continue
            if key_range.test(version)
            {
                if value = null
                    return null
                if (value as ref[JsonValue]).kind <> JsonKindObject
                    return null
                return value
            }
        }
        null
    }

    ; tryLoadModuleUsingPaths over MatchPatternOrExact(TryParsePatterns(paths)).
    ; `loader` names the caller's closure: the node_modules directory's or the
    ; directory worker's; `rest` is the former's module subpath
    procedure try_load_module_using_paths(this, ext: int, module_name: Slice[char], containing_directory: Slice[char], paths: ref[JsonValue], loader: int, info: PackageJsonInfo, rest: Slice[char]) returns int
    {
        var found false
        let key ModuleResolver.match_pattern_or_exact(paths, module_name, &found)
        if found = false
            return 0 - 1
        let star slice_index_of_byte(key, ("*" as char) as int)
        var matched_star Slice[char]()
        if star >= 0
            set matched_star: module_name.subslice(star as size_t, ((module_name.length as int) - (key.length as int) + star + 1) as size_t)
        this.trace2(TrModule_name_0_matched_pattern_1, module_name, key)
        let substitutions paths.get(key)
        if substitutions = null
            return 0 - 1
        let subs substitutions as ref[JsonValue]
        if subs.kind <> JsonKindArray
            return 0 - 1
        var i 0
        while i < subs.size()
        {
            let sv subs.value_at(i)
            set i: i + 1
            var subst Slice[char]()
            if sv <> null
            {
                if (sv as ref[JsonValue]).kind = JsonKindString
                    set subst: (sv as ref[JsonValue]).text
            }
            ; strings.Replace(subst, "*", matchedStar, 1)
            var path subst
            let subst_star slice_index_of_byte(subst, ("*" as char) as int)
            if subst_star >= 0
                set path: join_slices(host, join_slices(host, subst.subslice(0, subst_star as size_t), matched_star), subst.slice_from((subst_star + 1) as size_t))
            let candidate get_normalized_absolute_path(host, combine_paths(host, containing_directory, path), Slice[char]())
            this.trace2(TrTrying_substitution_0_candidate_module_location_Colon_1, subst, path)
            ; a path mapping may have an extension
            if ModuleResolver.has_known_extension(subst)
            {
                let direct this.try_file_path(candidate)
                if direct >= 0
                    return direct
            }
            var r 0 - 1
            if loader = ResolverLoaderNodeModules
                set r: this.node_modules_loader(ext, candidate, rest, info)
            if loader = ResolverLoaderDirectory
                set r: this.load_package_file(ext, candidate, info)
            if loader = ResolverLoaderRelative
                set r: this.node_load_module_by_relative_name(ext, candidate, true)
            if r >= 0
                return r
            if (stop_tag.length as int) > 0
                return 0 - 1
        }
        0 - 1
    }

    ; MatchPatternOrExact: an exact key first, then the pattern with the longest
    ; prefix (FindBestPatternMatch); TryParsePattern refuses a key with two stars
    function match_pattern_or_exact(paths: ref[JsonValue], candidate: Slice[char], found: ref[bool]) returns Slice[char]
    {
        set found: false
        let n paths.size()
        var i 0
        while i < n
        {
            let key paths.key_at(i)
            set i: i + 1
            if slice_index_of_byte(key, ("*" as char) as int) < 0
            {
                if key.equals(candidate)
                {
                    set found: true
                    return key
                }
            }
        }
        var best Slice[char]()
        var longest 0 - 1
        set i: 0
        while i < n
        {
            let key paths.key_at(i)
            set i: i + 1
            let star slice_index_of_byte(key, ("*" as char) as int)
            if star < 0
                continue
            if slice_index_of_byte(key.slice_from((star + 1) as size_t), ("*" as char) as int) >= 0
                continue
            if star <= longest
                continue
            if (candidate.length as int) < ((key.length as int) - 1)
                continue
            if candidate.starts_with(key.subslice(0, star as size_t)) = false
                continue
            if candidate.ends_with(key.slice_from((star + 1) as size_t)) = false
                continue
            set best: key
            set longest: star
            set found: true
        }
        best
    }

    ; tspath.TryGetExtensionFromPath answering non-empty
    function has_known_extension(path: Slice[char]) returns bool
    {
        if path.ends_with(".d.ts") or path.ends_with(".d.mts") or path.ends_with(".d.cts")
            return true
        if path.ends_with(".ts") or path.ends_with(".tsx") or path.ends_with(".mts") or path.ends_with(".cts")
            return true
        if path.ends_with(".js") or path.ends_with(".jsx") or path.ends_with(".mjs") or path.ends_with(".cjs")
            return true
        path.ends_with(".json")
    }

    ; tspath.ComparePaths(a, b) == 0 over two normalized directories
    function same_directory(a: Slice[char], b: Slice[char]) returns bool
    {
        var an a.length as int
        var bn b.length as int
        if (an > 1) and ((a[(an - 1) as size_t] as int) = 47)
            set an: an - 1
        if (bn > 1) and ((b[(bn - 1) as size_t] as int) = 47)
            set bn: bn - 1
        if an <> bn
            return false
        let sa a.subslice(0, an as size_t)
        let sb b.subslice(0, bn as size_t)
        sa.equals(sb)
    }

    ; tspath.ContainsPath(directory, path)
    function directory_contains(directory: Slice[char], path: Slice[char]) returns bool
    {
        var dn directory.length as int
        if (dn > 1) and ((directory[(dn - 1) as size_t] as int) = 47)
            set dn: dn - 1
        if (path.length as int) <= dn
            return ModuleResolver.same_directory(directory, path)
        let head path.subslice(0, dn as size_t)
        let dir directory.subslice(0, dn as size_t)
        if head.equals(dir) = false
            return false
        (path[dn as size_t] as int) = 47
    }

    ; GetRelativePathFromDirectory(directory, path) for a path below the directory
    function relative_below(directory: Slice[char], path: Slice[char]) returns Slice[char]
    {
        var dn directory.length as int
        if (dn > 1) and ((directory[(dn - 1) as size_t] as int) = 47)
            set dn: dn - 1
        if (path.length as int) <= (dn + 1)
            return Slice[char]()
        path.slice_from((dn + 1) as size_t)
    }
}
