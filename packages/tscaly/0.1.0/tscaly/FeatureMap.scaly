            if FeatureMap.bytes_are(prop, "findLast")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toReversed")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toSorted")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toSpliced")
                return "es2023"
            if FeatureMap.bytes_are(prop, "with")
                return "es2023"
            return ""
        }
        if FeatureMap.bytes_are(type_name, "Float64Array")
        {
            if FeatureMap.bytes_are(prop, "at")
                return "es2022"
            if FeatureMap.bytes_are(prop, "findLastIndex")
                return "es2023"
            if FeatureMap.bytes_are(prop, "findLast")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toReversed")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toSorted")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toSpliced")
                return "es2023"
            if FeatureMap.bytes_are(prop, "with")
                return "es2023"
            return ""
        }
        if FeatureMap.bytes_are(type_name, "BigInt64Array")
        {
            ; `es2020` adds no property names to this type — an empty row upstream.
            if FeatureMap.bytes_are(prop, "at")
                return "es2022"
            if FeatureMap.bytes_are(prop, "findLastIndex")
                return "es2023"
            if FeatureMap.bytes_are(prop, "findLast")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toReversed")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toSorted")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toSpliced")
                return "es2023"
            if FeatureMap.bytes_are(prop, "with")
                return "es2023"
            return ""
        }
        if FeatureMap.bytes_are(type_name, "BigUint64Array")
        {
            ; `es2020` adds no property names to this type — an empty row upstream.
            if FeatureMap.bytes_are(prop, "at")
                return "es2022"
            if FeatureMap.bytes_are(prop, "findLastIndex")
                return "es2023"
            if FeatureMap.bytes_are(prop, "findLast")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toReversed")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toSorted")
                return "es2023"
            if FeatureMap.bytes_are(prop, "toSpliced")
                return "es2023"
            if FeatureMap.bytes_are(prop, "with")
                return "es2023"
            return ""
        }
        if FeatureMap.bytes_are(type_name, "Error")
        {
            if FeatureMap.bytes_are(prop, "cause")
                return "es2022"
            return ""
        }
        if FeatureMap.bytes_are(type_name, "ErrorConstructor")
        {
            if FeatureMap.bytes_are(prop, "isError")
                return "esnext"
            return ""
        }
        if FeatureMap.bytes_are(type_name, "Uint8ArrayConstructor")
        {
            if FeatureMap.bytes_are(prop, "fromBase64")
                return "esnext"
            if FeatureMap.bytes_are(prop, "fromHex")
                return "esnext"
            return ""
        }
        if FeatureMap.bytes_are(type_name, "DisposableStack")
        {
            ; `esnext` adds no property names to this type — an empty row upstream.
            return ""
        }
        if FeatureMap.bytes_are(type_name, "AsyncDisposableStack")
        {
            ; `esnext` adds no property names to this type — an empty row upstream.
            return ""
        }
        if FeatureMap.bytes_are(type_name, "Date")
        {
            if FeatureMap.bytes_are(prop, "toTemporalInstant")
                return "esnext"
            return ""
        }
        ""
    }

    function has_suggested_lib(type_name: Slice[char], prop: Slice[char]) returns bool
        FeatureMap.suggested_lib(type_name, prop).length > 0

    ; getSuggestedLibForNonExistentName: the FIRST entry's lib of a type the map knows, or empty
    function first_lib(type_name: Slice[char]) returns Slice[char]
    {
        if FeatureMap.bytes_are(type_name, "Array")
