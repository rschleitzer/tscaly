; SPDX-License-Identifier: Apache-2.0
;
; system — the System internal/execute runs against (tsc.System), as tsctests'
; TestSys implements it (phase (b)2).
;
; ★★★ THE SYSTEM IS THE TEST HARNESS'S, AND THAT IS WHAT THE DRIVER BASELINES MEASURE.
; tsctests' TestSys is a virtual file system over a map with a CLOCK that advances one
; second on every `Now()` — every file write, every `sys.Now()` a compile-time
; measurement takes, every emitted file's touched timestamp. Modification times are
; observable twice in a baseline (`*mTime changed*`, and tsbuild's up-to-date checks
; that compare them), so the port keeps the clock as a tick count and asks it at
; exactly the reference's call sites. The default libraries are written at startup
; (ensureLibPathExists) and a file stays a "default lib" until something reads or
; writes it, which is what the harness's `*Lib*` entry reports.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.tsoptions.TsGlobPattern
use tscaly.tsoptions.TsConfigParser
use tscaly.program.JsonValue
use tscaly.program.JsonParser
use tscaly.program.ProgramFiles
use tscaly.addressindex.HashChain
use tscaly.buildinfojson.JsonText
use tscaly.buildinfojson.ReadableBuildInfo
use tscaly.watcher.Watcher
use tscaly.build.Orchestrator
use tscaly.tracing.Tracing
use tscaly.tracing.TraceArg

; one entry of the map file system: a regular file, or a symlink to `link_target`
; `disk_path` non-empty: the text is still on disk, read the first time it is asked
; for (tscaly_exec's `file` / `file-as` lines)
define VfsFile (path: Slice[char]  text: Slice[char]  var mtime: int  is_link: bool  link_target: Slice[char]  disk_path: Slice[char])

; --diagnostics' timings (slice 348): the reference's CompileTimes, measured on a
; REAL monotonic clock where `now()` advances the harness's TestClock. The two
; clocks are separate on purpose: the baselines drop the statistics block, so its
; numbers are for a person at a terminal and not for a yardstick. Nanoseconds.
define CompileStats
(
    start: int
    var config: int
    var parse: int
    var bind: int
    var check: int
    var emit: int
    ; the lib files' binder symbols (the lib binders live only inside the load)
    var lib_symbols: int
)

define ExecSystem
(
    host: ref[Page]
    cwd: Slice[char]
    case_sensitive: bool
    files: ref[Array[ref[VfsFile]?]]
    ; TestClock: seconds since the start, advanced by every now()
    var clock: int
    ; testFs.writtenFiles since the last baseline
    var written: ref[Array[Slice[char]]]
    ; testFs.defaultLibs: written at startup and not read or rewritten since
    default_libs: ref[Array[Slice[char]]]
    var default_library_path: Slice[char]
    var env_names: ref[Array[Slice[char]]]
    var env_values: ref[Array[Slice[char]]]
    ; the writer (TestSys.currentWrite)
    var output: ref[StringBuilder]
    ; the first construct the port does not implement
    var stop_tag: Slice[char]
    ; TestSys.programBaselines
    programs: ref[StringBuilder]
    ; the fsDiffer's snapshot at the step's start: each file's modification time
    var snapshot_paths: ref[Array[Slice[char]]]
    var snapshot_mtimes: ref[Array[int]]
    ; TracerForBaselining's package.json cache: the files a trace line named, and
    ; whether it found them (reset with the output)
    var trace_cache_paths: ref[Array[Slice[char]]]
    var trace_cache_found: ref[Array[bool]]
    ; a tsc -b task's trace writer (its own output, no cache), null for the writer
    var trace_target: ref[StringBuilder]?
    ; the fsDiffer's serialized snapshot after a step's baseline: each regular file's
    ; path, text and modification time (ChangedPaths compares against it)
    var post_files: ref[Array[ref[VfsFile]]]
    ; the command's watcher (CommandLineResult.Watcher), null without --watch: tsc's
    ; or the build orchestrator
    var watcher: ref[Watcher]?
    var build_watcher: ref[Orchestrator]?
    ; the map file system's directories: every ancestor of a file or link ever
    ; written (a removal leaves its directory behind)
    directories: ref[Array[Slice[char]]]
    ; the `--generateTrace` session, null unless the option was given. It hangs
    ; here because every layer that pushes an event already holds the system.
    var tracing: ref[Tracing]?
    ; `directories` chained by the case-folding hash of each entry (slice 335):
    ; the duplicate test of every file write and the directory question were
    ; scans of the whole list
    directory_chain: ref[HashChain]
    ; --diagnostics' timings, null until a compilation starts (slice 348)
    var stats: ref[CompileStats]?
    ; `files` by folded path hash (slice 357): find_index walked every file per
    ; lookup, 122 ms of setting up a 12 000-file scenario
    file_chain: ref[HashChain]
)
{
    function create(host: ref[Page], cwd: Slice[char], case_sensitive: bool) returns ref[ExecSystem]
    {
        let lib_path: Slice[char] "/home/src/tslibs/TS/Lib"
        let none: Slice[char] ""
        &ExecSystem^host(host, ExecSystem.copy(host, cwd), case_sensitive, &Array[ref[VfsFile]?]^host(), 0, &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), lib_path, &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &StringBuilder^host(), none, &StringBuilder^host(), &Array[Slice[char]]^host(), &Array[int]^host(), &Array[Slice[char]]^host(), &Array[bool]^host(), null, &Array[ref[VfsFile]]^host(), null, null, &Array[Slice[char]]^host(), null, HashChain.create(host), null, HashChain.create(host))
    }

    function copy(host: ref[Page], s: Slice[char]) returns Slice[char]
    {
        let text String^host(s.data as pointer[const_char], s.length)
        Slice[char](text.get_length(), text.get_buffer() as pointer[char])
    }

    ; the `--generateTrace` session's two entry points, here rather than in
    ; `Execute` because every layer that pushes an event holds the system and
    ; `execute` is declared after them all
    procedure trace_push(mutable this, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?) returns int
    {
        if tracing = null
            return TraceMainThreadId
        (tracing as ref[Tracing]).push(phase, name, args)
    }

    procedure trace_pop(mutable this, tid: int, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?)
    {
        if tracing = null
            return
        (tracing as ref[Tracing]).pop(tid, phase, name, args)
    }

    procedure stop(mutable this, tag: Slice[char])
    {
        if (stop_tag.length as int) = 0
            set stop_tag: tag
    }

    ; TestClock.Now
    procedure now(mutable this) returns int
    {
        set clock: clock + 1
        clock
    }

    function same_path(this, a: Slice[char], b: Slice[char]) returns bool
    {
        if case_sensitive
            return a.equals(b)
        TsGlobPattern.equal_fold(a, b)
    }

    function find_index(this, path: Slice[char]) returns int
    {
        ; the rows of the path's hash in insertion order, so the first match is the
        ; lowest index, as the linear scan answered
        var i file_chain.first(ProgramFiles.fold_hash(path))
        while i >= 0
        {
            let f files[i as size_t]
            if f <> null
            {
                if this.same_path((f as ref[VfsFile]).path, path)
                    return i
            }
            set i: file_chain.after(i)
        }
        0 - 1
    }

    ; `files.add` and its chain row, together
    procedure add_file(mutable this, entry: ref[VfsFile])
    {
        files.add(entry)
        file_chain.add(ProgramFiles.fold_hash(entry.path))
    }

    function file_at(this, i: int) returns ref[VfsFile]?
        files[i as size_t]

    procedure remove_from(mutable list: ref[Array[Slice[char]]], path: Slice[char])
    {
        var i 0
        while i < (list.get_length() as int)
        {
            let item list[i as size_t]
            if item.equals(path)
            {
                let none: Slice[char] ""
                list.put(i as size_t, none)
            }
            set i: i + 1
        }
    }

    function contains(list: ref[Array[Slice[char]]], path: Slice[char]) returns bool
    {
        var i 0
        while i < (list.get_length() as int)
        {
            let item list[i as size_t]
            if item.equals(path)
                return true
            set i: i + 1
        }
        false
    }

    function contains_int(list: ref[Array[int]], value: int) returns bool
    {
        var i 0
        while i < (list.get_length() as int)
        {
            if list[i as size_t] = value
                return true
            set i: i + 1
        }
        false
    }

    ; the list without its last element
    procedure pop_slice(host: ref[Page], mutable list: ref[Array[Slice[char]]])
    {
        let n list.get_length() as int
        let copy &Array[Slice[char]]()
        var i 0
        while i < (n - 1)
        {
            copy.add(list[i as size_t])
            set i: i + 1
        }
        list.clear()
        var k 0
        while k < (copy.get_length() as int)
        {
            list.add(copy[k as size_t])
            set k: k + 1
        }
    }

    ; MkdirAll for a path's parent
    procedure add_ancestors(mutable this, path: Slice[char])
    {
        var end (path.length as int) - 1
        while end > 0
        {
            if (path[end as size_t] as int) = ("/" as char) as int
            {
                let dir path.subslice(0, end as size_t)
                if this.directory_known(dir, true)
                    return
                directory_chain.add(ProgramFiles.fold_hash(dir))
                directories.add(ExecSystem.copy(host, dir))
            }
            set end: end - 1
        }
    }

    ; the map file system's write (vfstest): the modification time is the clock's
    procedure put_file(mutable this, path: Slice[char], text: Slice[char])
    {
        this.add_ancestors(path)
        let mtime this.now()
        let none: Slice[char] ""
        let entry &VfsFile^host(ExecSystem.copy(host, path), ExecSystem.copy(host, text), mtime, false, none, none)
        let i this.find_index(path)
        if i >= 0
            files.put(i as size_t, entry)
        else
            this.add_file(entry)
    }

    ; a file whose text stays on disk until something reads it
    procedure put_file_on_disk(mutable this, path: Slice[char], disk_path: Slice[char])
    {
        this.add_ancestors(path)
        let mtime this.now()
        let none: Slice[char] ""
        let entry &VfsFile^host(ExecSystem.copy(host, path), none, mtime, false, none, ExecSystem.copy(host, disk_path))
        let i this.find_index(path)
        if i >= 0
            files.put(i as size_t, entry)
        else
            this.add_file(entry)
    }

    ; the entry's text, read from disk first when it is still there
    procedure text_of(host: ref[Page], mutable f: ref[VfsFile]) returns Slice[char]
    {
        if (f.disk_path.length as int) > 0
        {
            ; stored by its two members: the escape checker refuses a call result
            let loaded ProgramFiles.read_disk_text(host, f.disk_path)
            set f.text.data: loaded.data
            set f.text.length: loaded.length
            set f.disk_path.length: 0
        }
        f.text
    }

    ; the program table's registration of one entry: by name alone while its text is
    ; still on disk, with its text otherwise
    procedure register_in(mutable pf: ref[ProgramFiles], path: Slice[char], f: ref[VfsFile])
    {
        if (f.disk_path.length as int) > 0
            pf.add_on_disk(path, f.disk_path)
        else
            pf.add(path, f.text, null, null, null, false, 0)
    }

    procedure put_link(mutable this, path: Slice[char], target: Slice[char])
    {
        this.add_ancestors(path)
        let none: Slice[char] ""
        let entry &VfsFile^host(ExecSystem.copy(host, path), none, 0, true, ExecSystem.copy(host, target), none)
        let i this.find_index(path)
        if i >= 0
            files.put(i as size_t, entry)
        else
            this.add_file(entry)
    }

    procedure remove_file(mutable this, path: Slice[char])
    {
        let i this.find_index(path)
        if i >= 0
            files.put(i as size_t, null)
    }

    procedure touch(mutable this, path: Slice[char])
    {
        let i this.find_index(path)
        if i < 0
            return
        let f files[i as size_t] as ref[VfsFile]
        set f.mtime: this.now()
    }

    ; OnEmittedFiles: an emitted file's timestamp advanced, unless the write reverted
    ; it to the snapshot's; true when touched
    procedure touch_emitted(mutable this, path: Slice[char]) returns bool
    {
        let i this.find_index(path)
        if i < 0
            return false
        let f files[i as size_t] as ref[VfsFile]
        var s 0
        while s < (snapshot_paths.get_length() as int)
        {
            let known snapshot_paths[s as size_t]
            if known.equals(path)
            {
                if snapshot_mtimes[s as size_t] = f.mtime
                    return false
                break
            }
            set s: s + 1
        }
        set f.mtime: this.now()
        true
    }

    ; TestSys.GetTrace: TracerForBaselining.sanitizeTrace, then the line
    procedure trace(mutable this, message: Slice[char])
    {
        var out output
        var use_cache true
        if trace_target <> null
        {
            set out: trace_target as ref[StringBuilder]
            set use_cache: false
        }
        let text this.sanitize_trace(message, use_cache)
        out.append("!!! Trace start\n")
        out.append(text.data, text.length)
        out.append("\n")
        out.append("!!! Trace end\n")
    }

    procedure reset_trace_cache(mutable this)
    {
        set this.trace_cache_paths: &Array[Slice[char]]^host()
        set this.trace_cache_found: &Array[bool]^host()
    }

    function trace_cache_index(this, path: Slice[char]) returns int
    {
        var i 0
        while i < (trace_cache_paths.get_length() as int)
        {
            let known trace_cache_paths[i as size_t]
            if known.equals(path)
                return i
            set i: i + 1
        }
        0 - 1
    }

    procedure sanitize_trace(mutable this, message: Slice[char], use_cache: bool) returns Slice[char]
    {
        let version_quoted: Slice[char] "'7.0.2'"
        let at_version TsConfigParser.index_of_text(message, version_quoted)
        if at_version >= 0
            return join_slices(host, join_slices(host, message.subslice(0, at_version as size_t), "'FakeTSVersion'"), message.slice_from((at_version + 7) as size_t))
        let not_cached: Slice[char] "' does not exist according to earlier cached lookups."
        let found_cached: Slice[char] "' exists according to earlier cached lookups."
        let not_found: Slice[char] "' does not exist."
        let file_prefix: Slice[char] "File '"
        let found_prefix: Slice[char] "Found 'package.json' at '"
        if message.ends_with(not_cached) and message.starts_with(file_prefix)
        {
            let file message.subslice(file_prefix.length, message.length - not_cached.length)
            if use_cache
            {
                if this.trace_cache_index(file) >= 0
                    return message
                trace_cache_paths.add(ExecSystem.copy(host, file))
                trace_cache_found.add(false)
            }
            return join_slices(host, join_slices(host, file_prefix, file), not_found)
        }
        if message.ends_with(found_cached) and message.starts_with(file_prefix)
        {
            let file message.subslice(file_prefix.length, message.length - found_cached.length)
            if use_cache
            {
                if this.trace_cache_index(file) >= 0
                    return message
                trace_cache_paths.add(ExecSystem.copy(host, file))
                trace_cache_found.add(true)
            }
            return join_slices(host, join_slices(host, found_prefix, file), "'.")
        }
        if use_cache
        {
            if message.ends_with(not_found) and message.starts_with(file_prefix)
            {
                let file message.subslice(file_prefix.length, message.length - not_found.length)
                if this.trace_cache_index(file) < 0
                {
                    trace_cache_paths.add(ExecSystem.copy(host, file))
                    trace_cache_found.add(false)
                    return message
                }
                return join_slices(host, join_slices(host, file_prefix, file), not_cached)
            }
            if message.starts_with(found_prefix) and message.ends_with("'.")
            {
                let file message.subslice(found_prefix.length, message.length - 2)
                if this.trace_cache_index(file) < 0
                {
                    trace_cache_paths.add(ExecSystem.copy(host, file))
                    trace_cache_found.add(true)
                    return message
                }
                return join_slices(host, join_slices(host, file_prefix, file), found_cached)
            }
        }
        message
    }

    ; the fsDiffer's snapshot, taken where a step's baseline starts
    procedure take_snapshot(mutable this)
    {
        set this.snapshot_paths: &Array[Slice[char]]^host()
        set this.snapshot_mtimes: &Array[int]^host()
        var i 0
        while i < (files.get_length() as int)
        {
            let entry files[i as size_t]
            set i: i + 1
            if entry = null
                continue
            let f entry as ref[VfsFile]
            snapshot_paths.add(f.path)
            snapshot_mtimes.add(f.mtime)
        }
    }

    ; FSDiffer.BaselineFSwithDiff's snapshot: the regular files as they are now
    procedure take_post_snapshot(mutable this)
    {
        set this.post_files: &Array[ref[VfsFile]]^host()
        var i 0
        while i < (files.get_length() as int)
        {
            let entry files[i as size_t]
            set i: i + 1
            if entry = null
                continue
            let f entry as ref[VfsFile]
            if f.is_link
                continue
            post_files.add(&VfsFile^host(f.path, ExecSystem.text_of(host, f), f.mtime, false, f.link_target, Slice[char]()))
        }
    }

    ; FSDiffer.ChangedPaths: the files new, rewritten or touched since the snapshot,
    ; then the ones deleted
    procedure changed_paths(this, mutable out_deleted: ref[Array[bool]]) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        var i 0
        while i < (files.get_length() as int)
        {
            let entry files[i as size_t]
            set i: i + 1
            if entry = null
                continue
            let f entry as ref[VfsFile]
            if f.is_link
                continue
            var found false
            var changed false
            var k 0
            while k < (post_files.get_length() as int)
            {
                let old post_files[k as size_t]
                set k: k + 1
                if old.path.equals(f.path)
                {
                    set found: true
                    if old.mtime <> f.mtime
                        set changed: true
                    if old.text.equals(f.text) = false
                        set changed: true
                    break
                }
            }
            if (found = false) or changed
            {
                out.add(f.path)
                out_deleted.add(false)
            }
        }
        var d 0
        while d < (post_files.get_length() as int)
        {
            let old post_files[d as size_t]
            set d: d + 1
            if this.find_index(old.path) < 0
            {
                out.add(old.path)
                out_deleted.add(true)
            }
        }
        out
    }

    ; the modification time of a file, -1 when there is none
    function mtime_of(this, path: Slice[char]) returns int
    {
        let i this.find_index(path)
        if i < 0
            return 0 - 1
        let f files[i as size_t] as ref[VfsFile]
        f.mtime
    }

    ; Chtimes without advancing the clock
    procedure set_mtime(mutable this, path: Slice[char], mtime: int)
    {
        let i this.find_index(path)
        if i < 0
            return
        let f files[i as size_t] as ref[VfsFile]
        set f.mtime: mtime
    }

    ; testFs.ReadFile: a read ends a file's default-lib status; a build info written
    ; with the harness's fake version reads back with the real one
    procedure read_file(mutable this, path: Slice[char], mutable out_text: ref[Slice[char]]) returns bool
    {
        ExecSystem.remove_from(default_libs, path)
        let i this.find_index(path)
        if i < 0
            return false
        let f files[i as size_t] as ref[VfsFile]
        if f.is_link
            return false
        var text ExecSystem.text_of(host, f)
        if path.ends_with(".tsbuildinfo")
        {
            let parsed JsonParser.parse(host, text)
            if parsed <> null
            {
                let info parsed as ref[JsonValue]
                let version info.string_of("version")
                if version.equals("FakeTSVersion")
                {
                    ExecSystem.set_version(host, info, "7.0.0-dev")
                    set text: JsonText.to_text(host, info, false)
                }
            }
        }
        set out_text.data: text.data
        set out_text.length: text.length
        true
    }

    procedure set_version(host: ref[Page], mutable info: ref[JsonValue], version: Slice[char])
    {
        var k 0
        while k < info.size()
        {
            let key info.key_at(k)
            if key.equals("version")
            {
                let values info.values as ref[Array[ref[JsonValue]?]]
                values.put(k as size_t, JsonText.new_string(host, version))
            }
            set k: k + 1
        }
    }

    ; testFs.WriteFile: a build info is written with the fake version, its readable
    ; form first
    procedure write_file(mutable this, path: Slice[char], mutable text_in: Slice[char])
    {
        ExecSystem.remove_from(default_libs, path)
        if ExecSystem.contains(written, path) = false
            written.add(ExecSystem.copy(host, path))
        var text text_in
        if path.ends_with(".tsbuildinfo")
        {
            let parsed JsonParser.parse(host, text)
            if parsed = null
            {
                this.stop("buildinfo-unmarshal")
                return
            }
            let info parsed as ref[JsonValue]
            let version info.string_of("version")
            if version.equals("7.0.0-dev")
            {
                ExecSystem.set_version(host, info, "FakeTSVersion")
                set text: JsonText.to_text(host, info, false)
            }
            let readable ReadableBuildInfo.convert(host, info, text)
            let readable_path join_slices(host, path, ".readable.baseline.txt")
            this.write_file(readable_path, readable)
        }
        this.put_file(path, text)
    }

    function file_exists(this, path: Slice[char]) returns bool
    {
        let i this.find_index(path)
        if i < 0
            return false
        let f files[i as size_t] as ref[VfsFile]
        f.is_link = false
    }

    ; a directory exists when some entry lies below it
    function directory_exists(this, path_in: Slice[char]) returns bool
    {
        var path path_in
        if (path.length as int) > 1
        {
            if (*(path.data + ((path.length as int) - 1)) as int) = ("/" as char) as int
                set path: path.subslice(0, path.length - 1)
        }
        var i 0
        while i < (files.get_length() as int)
        {
            let f files[i as size_t]
            set i: i + 1
            if f = null
                continue
            let p (f as ref[VfsFile]).path
            if (path.length as int) = 1
                return true
            if (p.length > path.length) and ((*(p.data + path.length) as int) = ("/" as char) as int)
            {
                if this.same_path(p.subslice(0, path.length), path)
                    return true
            }
        }
        this.directory_known(path, false)
    }

    ; whether `directories` holds `dir`: exactly, or by the file system's own
    ; comparison
    function directory_known(this, dir: Slice[char], exact: bool) returns bool
    {
        var r directory_chain.first(ProgramFiles.fold_hash(dir))
        while r >= 0
        {
            let known directories[r as size_t]
            if exact
            {
                if known.equals(dir)
                    return true
            }
            else
            {
                if this.same_path(known, dir)
                    return true
            }
            set r: directory_chain.after(r)
        }
        false
    }

    function get_environment_variable(this, name: Slice[char]) returns Slice[char]
    {
        var i 0
        while i < (env_names.get_length() as int)
        {
            let env_name env_names[i as size_t]
            if env_name.equals(name)
                return env_values[i as size_t]
            set i: i + 1
        }
        ""
    }

    procedure write(mutable this, text: Slice[char])
        output.append(text.data, text.length)
}

