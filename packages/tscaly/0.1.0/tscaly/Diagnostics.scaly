; SPDX-License-Identifier: Apache-2.0
;
; Diagnostics — the parser's diagnostic list, ported from the reference's
; `p.diagnostics` plus `ast.Diagnostic`.
;
; ── What a Diagnostic carries here, and what it deliberately does not ───────
;
; POS, END and CODE. The reference's `ast.Diagnostic` also holds the file, the
; message and its arguments, and may carry RELATED INFO (which
; parseExpectedMatchingBrackets attaches). None of that is compared: the
; yardstick's dump is `D <pos> <end> <code>` and TESTPLAN.md says so where it
; lists what the format hides — a wrong message with a right code passes here,
; and related info is attached to a diagnostic rather than appended to the list,
; so it never reaches the dump at all. The 2000-entry message table stays
; unported; what the port needs is the integer, and DiagnosticCodes.scaly
; generates those from the reference.
;
; ── Why this is a shared OBJECT and not a callback (CLAUDE.md §3.9d/§3.9e) ──
;
; The reference's scanner takes an ErrorCallback and the parser installs one:
;
;     p.scanner.SetOnError(p.scanError)
;     func (p *Parser) scanError(message *Message, pos int, length int, args ...any) {
;         p.parseErrorAtRange(core.NewTextRange(pos, pos+length), message, args...)
;     }
;
; So the callback's ENTIRE body is "append to the parser's list". Scaly's only
; escaping-closure form is `return \x: …`, and a scanner holding a closure over
; the parser is exactly the shape the escape checker exists to reject — and a
; back-pointer to the Parser would be a cycle between two modules where the
; scanner is declared first. The list is therefore its own concept and BOTH hold
; a pointer to the same one. That preserves the two things the callback bought:
; emission ORDER (a scan error is appended at the moment of scanning, in between
; the parser's own appends) and the DEDUP, which has to see every entry.
;
; ★ It also owns `has_error`, and that is the same argument one level down rather
; than a convenience. `parseErrorAtRange` sets `p.hasParseError = true` on every
; call — OUTSIDE the dedup, so a diagnostic that is discarded as a duplicate
; still marks the node — and `finishNode` reads it, stamps
; NodeFlagsThisNodeHasError and CLEARS it. Both writers of the list need to set
; that flag, so the object that owns the append owns the flag; the Parser reads
; and clears it through here.

use scaly.memory.Page
use scaly.containers.Array

define Diagnostic (pos: int  end: int  code: int)
{
    init(p: int, e: int, c: int)
    {
        set pos: p
        set end: e
        set code: c
    }
}

define DiagnosticList
(
    entries: pointer[Array[Diagnostic]]

    ; The LOGICAL length. Not `entries.get_length()`, because a rewind truncates
    ; the list — the reference does `p.diagnostics = p.diagnostics[0:len]` — and
    ; the stdlib Array has no truncate. Keeping the count here makes a rewind one
    ; assignment and makes the slots above it reusable, which matters: a
    ; speculation-heavy parse re-reports through the same positions many times.
    count: int

    ; The reference's `p.hasParseError`. Lives here rather than on the Parser
    ; because the scanner is the other writer; see the header.
    has_error: bool
)
{
    init(host: pointer[Page])
    {
        let a host.allocate(sizeof Array[Diagnostic], alignof Array[Diagnostic]) as pointer[Array[Diagnostic]]
        set *a: Array[Diagnostic]()
        set entries: a
        set count: 0
        set has_error: false
    }

    ; The reference's parseErrorAtRange, whole:
    ;
    ;     if len(p.diagnostics) == 0 || p.diagnostics[len(p.diagnostics)-1].Pos() != loc.Pos() {
    ;         p.diagnostics = append(p.diagnostics, ...)
    ;     }
    ;     p.hasParseError = true
    ;
    ; ★★ The DEDUP is load-bearing, not a tidiness pass — "don't report another
    ; error if it would just be at the same location as the last error". A port
    ; that appends unconditionally emits extra diagnostics wherever the reference
    ; reports twice at one position, which the recovery paths do routinely: an
    ; error at a token followed by a list-context error at the same token is one
    ; diagnostic upstream and two without this.
    ;
    ; ★ And note the flag is set on BOTH paths. A duplicate is dropped from the
    ; list and still marks the enclosing node.
    procedure add(this, pos: int, end: int, code: int)
    {
        var duplicate false
        if count > 0
        {
            let last *(entries.get_buffer() + (count - 1))
            if last.pos = pos
                set duplicate: true
        }
        if duplicate = false
        {
            let d Diagnostic(pos, end, code)
            if count < entries.get_length() as int
                entries.put(count as size_t, d)
            else
                entries.add(d)
            set count: count + 1
        }
        set has_error: true
    }

    function length(this) returns int
        count

    ; ★ Answers through OUT-PARAMETERS rather than returning the record. A
    ; `ref[T]?` from Array.get is fine inside this package, but the dump reads
    ; these from a program root across the package boundary, where a returned
    ; generic instance reads back as garbage (root CLAUDE.md: keep generic
    ; instances inside their package, hand the caller scalars). Three ints cross
    ; safely.
    function at(this, i: int, out_pos: pointer[int], out_end: pointer[int], out_code: pointer[int]) returns bool
    {
        if i < 0
            return false
        if count <= i
            return false
        let d *(entries.get_buffer() + i)
        set *out_pos: d.pos
        set *out_end: d.end
        set *out_code: d.code
        true
    }

    ; The reference's rewind, which truncates back to the mark's length. §3.5i is
    ; the whole argument for why our stand-in had to have this lifetime; with a
    ; real list it is the reference's own line.
    procedure truncate(this, n: int)
    {
        if n < count
            set count: n
    }
}
