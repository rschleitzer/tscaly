; SPDX-License-Identifier: Apache-2.0
;
; addressindex — an open-addressed map from an object ADDRESS to a row index, for the
; checker's link tables. The reference keeps each table as a Go map keyed by the
; node, symbol or type pointer; the port's tables are append-only arrays, and a
; linear scan over one is quadratic over a large program. The index stores the key
; itself, so it needs no knowledge of the row type.

use scaly.memory.Page
use scaly.containers.Vector

define AddressIndex
(
    ; the key addresses per slot, 0 for an empty slot (no object lives at 0)
    keys: ref[Vector[int]]?
    ; the row index per occupied slot
    rows: ref[Vector[int]]?
    mask: int
    count: int
)
{
    function create(host: ref[Page]) returns ref[AddressIndex]
        &AddressIndex^host(null, null, 0, 0)

    function hash_of(address: int) returns int
    {
        var h: u64 14695981039346656037
        set h: h xor (address as u64)
        set h: h * 1099511628211
        set h: h xor (h >> 29)
        set h: h * 1099511628211
        ((h >> 1) as int)
    }

    ; the row index + 1 recorded for `address`, 0 when there is none
    function find(this, address: int) returns int
    {
        if count = 0
            return 0
        let ks keys as ref[Vector[int]]
        let rs rows as ref[Vector[int]]
        var slot AddressIndex.hash_of(address) & mask
        while true
        {
            let k ks.get(slot as size_t)
            if k = null
                return 0
            let kv *k
            if kv = 0
                return 0
            if kv = address
            {
                let r rs.get(slot as size_t)
                if r = null
                    return 0
                return *r + 1
            }
            set slot: (slot + 1) & mask
        }
        0
    }

    ; records `row` for `address`, replacing an earlier row for the same address
    procedure insert(this, address: int, row: int)
    {
        var cap 0
        if keys <> null
            set cap: mask + 1
        if ((count + 1) * 2) > cap
            this.grow()
        this.place(address, row)
    }

    procedure place(this, address: int, row: int)
    {
        let ks keys as ref[Vector[int]]
        let rs rows as ref[Vector[int]]
        var slot AddressIndex.hash_of(address) & mask
        while true
        {
            let k ks.get(slot as size_t)
            if k = null
                return
            let kv *k
            if kv = 0
            {
                ks.put(slot as size_t, address)
                rs.put(slot as size_t, row)
                set count: count + 1
                return
            }
            if kv = address
            {
                rs.put(slot as size_t, row)
                return
            }
            set slot: (slot + 1) & mask
        }
    }

    procedure grow(this)
    {
        var old_cap 0
        if keys <> null
            set old_cap: mask + 1
        var new_cap 16
        while new_cap <= old_cap
            set new_cap: new_cap * 2
        let host Page.get(this)
        let old_keys keys
        let old_rows rows
        let new_keys Vector[int]^host(new_cap as size_t)
        let new_rows Vector[int]^host(new_cap as size_t)
        set keys: new_keys
        set rows: new_rows
        set mask: new_cap - 1
        set count: 0
        if old_keys = null
            return
        let oks old_keys as ref[Vector[int]]
        let ors old_rows as ref[Vector[int]]
        var i 0
        while i < old_cap
        {
            let k oks.get(i as size_t)
            if k <> null
            {
                let kv *k
                if kv <> 0
                {
                    let r ors.get(i as size_t)
                    if r <> null
                        this.place(kv, *r)
                }
            }
            set i: i + 1
        }
    }
}
