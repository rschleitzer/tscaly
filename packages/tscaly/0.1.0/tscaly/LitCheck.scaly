; SPDX-License-Identifier: Apache-2.0
;
; LitCheck — the SECOND PRODUCER for a LITERAL TYPE'S NAME, and it exists for
; exactly PathCheck's and NumCheck's reason: the corpus cannot reach the code.
;
; ★★★ THE CHECKER YARDSTICK CANNOT SEE A LITERAL TYPE'S NAME AT ALL TODAY, and
; that is a fact about `getTypeOfNode` rather than about the corpus. A T line is
; written for a node the type WALK asks about, and getTypeOfNode answers an
; EXPRESSION through `IsExpressionNode(node) -> getRegularTypeOfExpression(node)`
; — neither of which is ported, so the kind INVENTORY admits three token and
; statement kinds and no expression. Slice 71 therefore makes four kinds of
; literal type and composes four kinds of NAME for them, and not one of those
; names can appear in a dump. §3.5's rule for that is not "argue that it is
; right": an unexercised arm is indistinguishable from a correct one, so it gets
; an instrument.
;
; ★★★ IT CALLS THE SHIPPING BODIES AND NOT A COPY OF THEM, which is the whole
; reason the three composing steps are STATICS over bytes on Checker
; (write_string_literal_name, pseudo_big_int_digits, write_pseudo_big_int_value)
; rather than code inside the arms that use them. A second producer that
; re-implements what it checks agrees with itself; the first draft of this file
; did exactly that, and the slice-71 battery's g17 — which breaks the checker's
; leading-zero trim — refused to apply against it and said so.
;
; ★★ WHAT IS MEASURED IS THE COMPOSITION AND NOT THE ARM AROUND IT. The two arms
; that build a name out of bytes are the STRING literal (a double quote,
; escapeStringWorker, a double quote) and the BIGINT literal (ParsePseudoBigInt,
; NewPseudoBigInt's leading-zero trim, PseudoBigInt.String, and an `n`). The
; number arm is `jsnum_to_string`, which numcheck.sh already gates from both
; directions, and the boolean arm is two static keywords. So these two are the
; whole of what a new instrument can add.
;
; ── the corpus format, and why it is hex ────────────────────────────────────
;
; One line is `<tag> <hex bytes>`:
;
;     S 616263        the string literal VALUE `abc`   -> `"abc"`
;     B 30786666      the bigint literal TEXT `0xff`   -> `255n`
;     T 307866666e    the SOURCE `0xffn`               -> `<kind> <value in hex>`
;
; ★★ THE THIRD TAG MEASURES THE SCANNER AND IT IS HERE FOR THE SAME REASON THE
; OTHER TWO ARE. No yardstick dumps a token's VALUE — TokenDump prints kind,
; start, end and flags — so `scanBigIntSuffix`'s two steps (append the `n`,
; and for a binary or octal specifier rewrite the digits through
; ParsePseudoBigInt) had no instrument at all, which is how the raw source slice
; slice 44 stood in for them survived. What makes that stand-in a DEFECT and not
; merely a difference is the separator: `1_000n` reached the checker with its
; underscore intact, and a bigint type built from it would carry the digits
; `1_000`.
;
; NumCheck's corpus carries its inputs verbatim and therefore cannot carry a
; newline. Here the newline is one of the inputs that matters most — it is the
; first thing escapeStringWorker turns into two characters — and so are a NUL, a
; lone surrogate's three-byte sentinel and a stray byte that is not UTF-8 at all.
; A hex line carries every one of them and needs no escaping of its own.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.io.Console
use tscaly.scanner.Scanner
use tscaly.checker.Checker

define LitCheck
{
    function run(host: ref[Page], text: String)
    {
        let out StringBuilder^host()

        let d text.get_buffer() as pointer[char]
        var n text.get_length() as int
        if n > 0
        {
            if (*(d + (n - 1)) as int) = (("\n" as char) as int)
                set n: n - 1
        }

        ; The decoded bytes of the longest line. One page allocation for the
        ; whole run rather than one per line: the buffer is overwritten in place
        ; and nothing outside a line's own output reads it.
        let scratch String^host((n + 8) as size_t)
        let raw scratch.get_buffer()
        let digits String^host((n + 8) as size_t)
        let dec digits.get_buffer()

        var i 0
        while i <= n
        {
            var e i
            while e < n
            {
                if (*(d + e) as int) = (("\n" as char) as int)
                    break
                set e: e + 1
            }
            if e > i
            {
                let tag *(d + i) as int
                let m LitCheck.unhex(d, i + 2, e, raw)
                if m < 0
                    out.append("BAD")
                else
                {
                    if tag = (("S" as char) as int)
                        Checker.write_string_literal_name(&out, Slice[char](m, raw))
                    if tag = (("B" as char) as int)
                        LitCheck.write_bigint(&out, Slice[char](m, raw), dec)
                    if tag = (("T" as char) as int)
                        LitCheck.write_scan(host, &out, Slice[char](m, raw))
                }
                out.append("\n" as char)
            }
            set i: e + 1
        }

        let s out.to_string()
        Console.print(s.to_c_string())
    }

    ; `jsnum.NewPseudoBigInt(jsnum.ParsePseudoBigInt(text), false).String() + "n"`
    ; — the checker's bigint_literal_arm and its half of type_to_string, run back
    ; to back over one text, which is what the reference's two lines do.
    procedure write_bigint(out: ref[StringBuilder], text: Slice[char], dec: pointer[char])
    {
        var start 0
        let m Checker.pseudo_big_int_digits(text, dec, &start)
        if m < 0
        {
            out.append("PANIC")
            return
        }
        Checker.write_pseudo_big_int_value(out, Slice[char](m, dec + start), false)
        out.append("n" as char)
    }

    ; The scanner's first token over the given SOURCE bytes: its kind, and its
    ; token value hex-encoded — because a token value is bytes and not text, and
    ; because the whole point of the line is a value the source does not contain.
    ;
    ; ★ A fresh Scanner per line rather than one reset: `Reset`/`SetText` is the
    ; reference's shape for reuse and this port's Scanner takes its text at
    ; construction, so a line is a scanner. Nothing here is measuring cost.
    procedure write_scan(host: ref[Page], out: ref[StringBuilder], text: Slice[char])
    {
        let src String^host(text.data, text.length)
        var scanner Scanner(src)
        let k scanner.scan()
        out.append(k)
        out.append(" " as char)
        let v scanner.token_value()
        let vl scanner.token_value_length()
        var i 0
        while i < vl
        {
            let b v[i] as int
            LitCheck.hexit(out, (b >> 4) & 0xF)
            LitCheck.hexit(out, b & 0xF)
            set i: i + 1
        }
    }

    procedure hexit(out: ref[StringBuilder], d: int)
    {
        if d < 10
            out.append((d + 0x30) as char)
        else
            out.append(((d - 10) + 0x61) as char)
    }

    ; Two hex digits per byte, lower or upper case. Answers the byte count, or -1
    ; on a malformed line — which is a defect in the generator and must not be
    ; reported as a difference in the port.
    function unhex(s: pointer[char], start: int, stop: int, out: pointer[char]) returns int
    {
        if ((stop - start) % 2) <> 0
            return 0 - 1
        var w 0
        var i start
        while i < stop
        {
            let hi LitCheck.nibble(*(s + i) as int)
            let lo LitCheck.nibble(*(s + (i + 1)) as int)
            if hi < 0
                return 0 - 1
            if lo < 0
                return 0 - 1
            set *(out + w): ((hi << 4) | lo) as char
            set w: w + 1
            set i: i + 2
        }
        w
    }

    function nibble(c: int) returns int
    {
        if (c >= 0x30) and (c <= 0x39)
            return c - 0x30
        if (c >= 0x61) and (c <= 0x66)
            return (c - 0x61) + 10
        if (c >= 0x41) and (c <= 0x46)
            return (c - 0x41) + 10
        0 - 1
    }
}
