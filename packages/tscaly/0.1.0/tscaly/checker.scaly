                continue
            let source_prop_type this.get_indexed_access_type_or_undefined(source, name_type, AccessFlagsNone, null, null)
            if this.unported_mark() <> mark
                return reported
            if source_prop_type = null
                continue
            ; ★★★ THE ELEMENT IS ELABORATED THROUGH `elaborate_element` RATHER THAN
            ; RE-DERIVED HERE, which is a DIVERGENCE IN SPELLING AND NOT IN
            ; BEHAVIOUR — and it is said because a reader comparing the two files
            ; will see forty lines upstream against one here. Upstream inlines the
            ; whole of elaborateElement's tail (the relation test, the recursive
            ; elaborateError, the specificSource re-check, the createDiagnostic fork,
            ; the exactOptional fork and the two removeMissingType calls) with ONE
            ; difference: its target property type is the union computed above, not
            ; `getBestMatchIndexedAccessTypeOrUndefined`'s answer. So the faithful
            ; call is elaborate_element with that type ALREADY chosen — which is
            ; what the source/target pair below is.
            let tpt target_prop_type as ref[Type]
            let spt source_prop_type as ref[Type]
            if this.check_type_related_to(spt, tpt, relation, null) = false
            {
