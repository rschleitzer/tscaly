    ; ── c.cachedTypes at the three instantiation kinds (slice 151) ──────────

    ; ★ TWO readers, and only one of them mints. Upstream every one of these three
    ; kinds is a plain map lookup that inserts nothing, so a row minted on a MISS
    ; would be a row for a type whose answer was never computed — dead weight on a
    ; list that is scanned linearly, and one of the three readers (the
    ; restrictive-instance guard) asks about types that are never instantiated at
    ; all. `find` is the lookup, `of` is the lookup a write is about to fill.
    function find_instantiation_cache_link(this, t: ref[Type]) returns ref[InstantiationCacheLink]?
    {
        let ix instantiation_cache_links_index
        let at ix.find(t as int)
        if at > 0
        {
            let row instantiation_cache_links[at - 1]
            if row <> null
                return row as ref[InstantiationCacheLink]
        }
        null
    }

    procedure instantiation_cache_link_of(this, t: ref[Type]) returns ref[InstantiationCacheLink]
    {
        let found this.find_instantiation_cache_link(t)
        if found <> null
            return found as ref[InstantiationCacheLink]
        let fresh &InstantiationCacheLink^host(t)
        instantiation_cache_links.add(fresh)
        this.instantiation_cache_links_index_last()
        fresh
    }

    ; ── c.discriminatedContextualTypes (slice 146) ──────────────────────────
    ;
    ; ★ NOT a mint-on-miss reader: the key is a PAIR and a fresh row would answer
    ; null, which here means *the walk stopped*. The caller tests for the row.
    function discriminated_key_hash(node: ref[AstNode]?, contextual: ref[Type]?) returns int
        (node as int) xor ((contextual as int) * 31)

    procedure discriminated_contextual_type_link_of(this, node: ref[AstNode], contextual: ref[Type]) returns ref[DiscriminatedContextualTypeLink]?
    {
        let len discriminated_contextual_type_links.get_length() as int
        let chain discriminated_chain
        while chain.count() < len
        {
            let pending discriminated_contextual_type_links[chain.count() as size_t]
            if pending = null
                chain.add_blank()
            else
            {
                let pr pending as ref[DiscriminatedContextualTypeLink]
                chain.add(Checker.discriminated_key_hash(pr.node, pr.contextual))
            }
        }
        var i chain.first(Checker.discriminated_key_hash(node, contextual))
        while i >= 0
        {
            let row discriminated_contextual_type_links[i as size_t]
            if row <> null
            {
                let r row as ref[DiscriminatedContextualTypeLink]
                if r.node = node
                {
                    if r.contextual = contextual
                        return r
                }
            }
            set i: chain.after(i)
        }
        null
    }

    ; ── ast.SyntheticExpression's payload (slice 134) ───────────────────────
    ;
    ; ★ NOT a mint-on-miss reader: a node with no row is not a synthetic
    ; expression at all, and answering a fresh empty row for one would turn a
    ; wrong node into `undefined` rather than into a report.
    function synthetic_expression_link_of(this, node: ref[AstNode]) returns ref[SyntheticExpressionLink]?
    {
        let ix synthetic_expression_links_index
        let at ix.find(node as int)
        if at > 0
        {
            let row synthetic_expression_links[at - 1]
            if row <> null
                return row as ref[SyntheticExpressionLink]
        }
        null
    }

    ; createSyntheticExpression. ★The node carries the PARENT's range and the
    ; parent itself, which is what makes a report on a synthetic argument land on
    ; the source text the argument stands for.
    procedure new_synthetic_expression(this, parent: ref[AstNode], t: ref[Type]?, is_spread: bool, tuple_name_source: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_synthetic_node(KindSyntheticExpression, NodeData.Token(TokenData()))
        set n.pos: (AstNode.pos_of(parent)) as i32
        set n.end: (AstNode.end_of(parent)) as i32
        set n.parent: parent
        let link &SyntheticExpressionLink^host(n, t, is_spread, tuple_name_source)
        synthetic_expression_links.add(link)
        this.synthetic_expression_links_index_last()
        n
    }

    ; ── c.cachedTypes at the four DecoratorContext kinds (slice 134) ────────

    procedure decorator_context_override_link_of(this, name_type: ref[Type], is_private: bool, is_static: bool) returns ref[DecoratorContextOverrideLink]
    {
        let len decorator_context_override_links.get_length() as int
        var i 0
        while i < len
        {
            let row decorator_context_override_links[i]
            if row <> null
            {
                let r row as ref[DecoratorContextOverrideLink]
                if r.name_type = name_type
                {
                    if r.is_private = is_private
                    {
                        if r.is_static = is_static
                            return r
                    }
                }
            }
            set i: i + 1
        }
        let fresh &DecoratorContextOverrideLink^host(name_type, is_private, is_static)
        decorator_context_override_links.add(fresh)
        fresh
    }

    ; ── c.flowTypeCache ────────────────────────────────────────────────────
    ;
    ; ★ NOT a mint-on-miss reader, for flow_reachable_lookup's reason: an absent
    ; row and a row holding nothing are different facts here, and only the absent
    ; one means *not computed*.
    procedure flow_type_cache_lookup(this, node: ref[AstNode]) returns ref[Type]?
    {
        let list flow_type_cache
        let len list.get_length() as int
        if len = 0
            return null
        let slot flow_type_cache_chain_index.find(list as int)
        var chain_opt: ref[HashChain]? null
        if slot = 0
        {
            let made HashChain.create(host)
            flow_type_cache_chains.add(made)
            flow_type_cache_chain_index.insert(list as int, (flow_type_cache_chains.get_length() as int) - 1)
            set chain_opt: made
        }
        else
            set chain_opt: flow_type_cache_chains[(slot - 1) as size_t]
        let chain chain_opt as ref[HashChain]
        while chain.count() < len
        {
            let pending list[chain.count() as size_t]
            if pending = null
                chain.add_blank()
            else
            {
                let pr pending as ref[FlowTypeCacheLink]
                chain.add(pr.node as int)
            }
        }
        var i chain.first(node as int)
        while i >= 0
        {
            let row list[i as size_t]
            if row <> null
            {
                let r row as ref[FlowTypeCacheLink]
                if r.node = node
                    return r.t
            }
            set i: chain.after(i)
        }
        null
    }

    procedure flow_type_cache_put(this, node: ref[AstNode], t: ref[Type])
    {
        flow_type_cache.add(&FlowTypeCacheLink^host(node, t))
    }

