    ; getLongestCandidateIndex — the first candidate that could take this many
    ; arguments, else the widest one. ★A negative answer means the list was empty,
    ; which get_candidate_for_overload_failure's caller has already excluded.
    procedure get_longest_candidate_index(this, candidates: ref[Array[ref[Signature]?]], args_count: int) returns int
    {
        let mark this.unported_mark()
        let n candidates.get_length() as int
        var max_params_index 0 - 1
        var max_params 0 - 1
        var i 0
        while i < n
        {
            let row candidates[i]
            if row = null
                return 0 - 1
            let candidate row as ref[Signature]
            let param_count this.get_parameter_count(candidate)
            if this.unported_mark() <> mark
                return 0 - 1
            let has_rest this.has_effective_rest_parameter(candidate)
            if this.unported_mark() <> mark
                return 0 - 1
            if has_rest
                return i
            if param_count >= args_count
                return i
            if param_count > max_params
            {
                set max_params: param_count
                set max_params_index: i
            }
            set i: i + 1
        }
        max_params_index
    }

    ; getTypeArgumentsFromNodes — the written type arguments, TRUNCATED to the
    ; declared count and then FILLED from each remaining parameter's default, its
    ; constraint, or `unknown`.
    procedure get_type_arguments_from_nodes(this, type_argument_nodes: ref[Array[ref[AstNode]?]]?, type_parameters: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]?
    {
