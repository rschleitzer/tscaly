    ; ── the intrinsic types ─────────────────────────────────────────────────

    ; newType, reduced to what an intrinsic needs. The reference threads a payload
    ; interface through here; this slice has one payload kind (see Type's note).
    procedure new_intrinsic_type_ex(this, flags: int, intrinsic_name: Slice[char], object_flags: int) returns ref[Type]
    {
        set type_count: type_count + 1
        let t &Type^host(type_count, flags, object_flags, TypeData.None(NoTypeData(intrinsic_name)), false, null, null, null, null, null, null, null)
        this.record_traced_type(t)
        t
    }

    ; the intrinsic's name, empty for every other type
    function intrinsic_name_of(t: ref[Type]) returns Slice[char]
    {
        choose t.data
            when n: None
                return n.name
        Slice[char]()
    }

    procedure new_intrinsic_type(this, flags: int, intrinsic_name: Slice[char]) returns ref[Type]
        this.new_intrinsic_type_ex(flags, intrinsic_name, ObjectFlagsNone)

    ; createWideningType. Its whole body is `if c.strictNullChecks { return
    ; nonWideningType }` and then a fresh intrinsic carrying
    ; ObjectFlagsContainsWideningType — and strictNullChecks is TRUE under this
    ; harness's options (see the header), so the FIRST branch is the one that runs.
    ; It is written as the reference's conditional anyway, with the option spelled
    ; as a constant, so an options record arriving later is a substitution.
    procedure create_widening_type(this, non_widening_type: ref[Type]) returns ref[Type]
    {
        if Checker.strict_null_checks()
            return non_widening_type
        this.new_intrinsic_type_ex(non_widening_type.flags, Checker.intrinsic_name_of(non_widening_type), ObjectFlagsContainsWideningType)
    }

    ; ── the object types ────────────────────────────────────────────────────
    ;
    ; ★★★ SLICE 66. Every type before this one is an intrinsic minted once at
    ; startup; these are the first types a SOURCE FILE causes to exist.

    ; newType, for a payload that is not the intrinsic. The reference's `newType`
    ; takes the data interface; here the arm is passed in already built.
    procedure new_type(this, flags: int, object_flags: int, sym: ref[Symbol]?, d: TypeData) returns ref[Type]
    {
        set type_count: type_count + 1
        ; ★★★ THE MASK IS THE REFERENCE'S OWN LINE AND IT IS AN INVARIANT, NOT A
        ; TIDY-UP: `t.objectFlags = objectFlags &^ (CouldContainTypeVariablesComputed
        ; | CouldContainTypeVariables | MembersResolved)`. A fresh type has no
        ; resolved members and no computed containment answer, whatever its caller
        ; passed.
        ;
        ; ★★★ IT WAS MISSING UNTIL SLICE 125 AND COST NOTHING FOR SIXTY SLICES,
        ; because every `new_object_type` call site until then built its flags out
        ; of CONSTANTS. `instantiate_anonymous_type` is the first caller that hands
        ; over ANOTHER TYPE'S flags word — and if the target's members happened to
        ; be resolved already, the instantiation was born with MembersResolved SET
        ; and an EMPTY member reference. Upstream that is harmless (the members are
        ; an embedded zero-valued struct, so the type reads as `{}`); here they hang
        ; off a reference that is still null, so resolve_structured_type_members
        ; answered NULL, the printer returned false and TypeDump dropped the line.
        ; Four stage-2 units, no stop, no diagnostic — see §3.5dz.
        let masked object_flags & ~(ObjectFlagsCouldContainTypeVariablesComputed | ObjectFlagsCouldContainTypeVariables | ObjectFlagsMembersResolved)
        let t &Type^host(type_count, flags, masked, d, false, sym, null, null, null, null, null, null)
        this.record_traced_type(t)
        t
    }

    ; ── slice 146: THE UNIQUE ES SYMBOL TYPE GETS A PRODUCER ────────────────
    ;
    ; ★★★ SEVEN READERS IN THIS PORT AND NOTHING THAT COULD MAKE ONE, which is
    ; slice 136's shape one type over. `get_property_name_from_type`,
    ; `try_get_name_from_type`, `write_type_worker`,
    ; `write_name_of_symbol_from_name_type`, `add_property_to_element_list`,
    ; `widen_type_for_variable_like_declaration` and
    ; `get_widened_unique_es_symbol_type` each test TypeFlagsUniqueESSymbol, and
    ; SIX of them named the absent producer in as many words —
    ; *getESSymbolLikeTypeForNode is not written*, *a slot this port's
    ; unique-symbol type does not carry*, *a unique symbol type has no
    ; constructor in this port*. This is that producer, and the notes expire with
    ; it.
    ;
    ; newUniqueESSymbolType. ★The symbol rides `Type.symbol` (the reference sets
    ; it straight after newType, and `new_type` already takes it), so the arm
    ; carries only the name.
    procedure new_unique_es_symbol_type(this, symbol: ref[Symbol], name: Slice[char]) returns ref[Type]
        this.new_type(TypeFlagsUniqueESSymbol, ObjectFlagsNone, symbol, TypeData.UniqueESSymbol(UniqueESSymbolTypeData(name)))

    ; isValidESSymbolDeclaration, whole — three declaration shapes, and it is a
    ; question about the DECLARATION and never about the type.
    ;
    ; ★ `ast.IsVarConst` is NOT `is_var_const_like`: the wider one accepts `using`
    ; and `await using`, and a `using` binding is not a valid `unique symbol`
    ; declaration. The two sit ten lines apart in the reference for that reason.
    function is_valid_es_symbol_declaration(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindVariableDeclaration
        {
            if (Binder.combined_node_flags(node) & NodeFlagsBlockScoped) <> NodeFlagsConst
                return false
            if Checker.kind_or_unknown(AstNode.name_of(node)) <> KindIdentifier
                return false
            ; isVariableDeclarationInVariableStatement.
            let list AstNode.parent_node_of(node)
            if Checker.kind_or_unknown(list) <> KindVariableDeclarationList
                return false
            return Checker.kind_or_unknown(AstNode.parent_node_of(list)) = KindVariableStatement
        }
        if k = KindPropertyDeclaration
        {
            if b.has_syntactic_modifier(node, ModifierFlagsReadonly) = false
                return false
            return b.has_syntactic_modifier(node, ModifierFlagsStatic)
        }
        if k <> KindPropertySignature
            return false
        b.has_syntactic_modifier(node, ModifierFlagsReadonly)
    }

    ; getESSymbolLikeTypeForNode, whole.
    ;
    ; ★★★ THE CACHE IS A SLOT ON ValueSymbolLink RATHER THAN A TABLE OF ITS OWN,
    ; and the merge passes §3.22's test the same way `mappedSymbolLinks` did:
    ; upstream's `uniqueESSymbolTypes` has exactly ONE reader and ONE writer, both
    ; inside this function, so nothing anywhere asks `Has(symbol)` — the question
    ; a separate table would exist to answer. A second table here would be a
    ; second lookup for a question nothing puts.
    ;
    ; ★★★ THE NAME EMBEDS A SYMBOL ID AND THAT IS OBSERVABLE, which is why it is
    ; drawn through `get_symbol_id` and not from a counter of this port's own:
    ; upstream's id is LAZY (a symbol draws a number the first time somebody asks)
    ; and the number lands in a name the symbols artifact prints. §0.5 is the
    ; measurement — the reference's two process-wide counters had to be RESET per
    ; artifact before 24 symbols artifacts agreed — and get_symbol_id's own header
    ; is the contract this reuses rather than re-deriving.
    ;
    ; ★ The fallback is `esSymbolType` and it is the common answer: only a `const`
    ; identifier binding, a `static readonly` property or a `readonly` property
    ; signature gets a unique type at all.
    procedure get_es_symbol_like_type_for_node(this, node: ref[AstNode]?) returns ref[Type]?
    {
        if node = null
            return es_symbol_type
        let n node as ref[AstNode]
        if this.is_valid_es_symbol_declaration(n)
        {
            let symbol this.get_symbol_of_node(n)
            if symbol <> null
            {
                let sym symbol as ref[Symbol]
                let links this.value_symbol_link_of(sym)
                if this.value_symbol_extra_read(links).unique_es_symbol_type <> null
                    return this.value_symbol_extra_read(links).unique_es_symbol_type
                ; ast.InternalSymbolNamePrefix + "@" + symbol.Name + "@" +
                ; strconv.Itoa(GetSymbolId(symbol)) — the 0xFE prefix is what makes
                ; the name unspellable, which is the whole point of it here: two
                ; `unique symbol` declarations of the same source name must be two
                ; different property names, and the id is what tells them apart.
                let bn this.binder_of_node(n)
                let id bn.get_symbol_id(sym)
                let made this.new_unique_es_symbol_type(sym, Checker.unique_es_symbol_name(host, Symbol.name_of(sym), id))
                let vsx_9435 this.value_symbol_extra(links)
                set vsx_9435.unique_es_symbol_type: made
                return made
            }
        }
        es_symbol_type
    }

    ; The name above, on the checker's page — Binder.internal_name's shape with a
    ; second `@` and a decimal tail. ★It is built here rather than by composing
    ; internal_name with decimal_name because the answer must be ONE allocation:
    ; a name is a (pointer, length) pair and a reader indexes it.
    function unique_es_symbol_name(host: ref[Page], word: Slice[char], id: int) returns Slice[char]
    {
        var digits char[24]
        var dn 0
        var v id
        if v = 0
        {
            set digits[0]: "0" as char
            set dn: 1
        }
        while v > 0
        {
            set digits[dn]: (((v % 10) + 48) as char)
            set v: v / 10
            set dn: dn + 1
        }
        let wn word.length as int
        ; 0xFE + "@" + word + "@" + digits, plus the NUL every name in this port
        ; carries for the C boundary.
        let total 1 + 1 + wn + 1 + dn
        let buf host.allocate((total + 1) as size_t, 1) as pointer[char]
        var w 0
        set *(buf + w): 0xFE as char
        set w: w + 1
        set *(buf + w): "@" as char
        set w: w + 1
        var i 0
        while i < wn
        {
            set *(buf + w): word[i]
            set w: w + 1
            set i: i + 1
        }
        set *(buf + w): "@" as char
        set w: w + 1
        var j 0
        while j < dn
        {
            set *(buf + w): digits[dn - 1 - j]
            set w: w + 1
            set j: j + 1
        }
        set *(buf + w): 0 as char
        Slice[char](total, buf)
    }

    ; newObjectType. The reference's switch has EIGHT arms selecting the payload
    ; struct off the object flags, in that order, and this slice mints exactly two
    ; of them — so the other six report rather than being left out, which is this
    ; file's rule for an arm that stands in place (§3.5v). The reference's `default`
    ; is a panic, and it is a report here for the same reason every unhandled kind
    ; is: a panic would be a claim that the input is impossible.
    procedure new_object_type(this, object_flags: int, sym: ref[Symbol]?) returns ref[Type]?
    {
        if (object_flags & ObjectFlagsClassOrInterface) <> 0
            return this.new_type(TypeFlagsObject, object_flags, sym, TypeData.Interface(box_node_data[InterfaceTypeData](host, InterfaceTypeData())))
        ; ★★★ SLICE 115 FILLS THE TUPLE ARM, AND IT BUILDS AN *Interface* PAYLOAD.
        ; That is the reference's struct and not a shortcut: `type TupleType struct
        ; { InterfaceType; elementInfos; … }` EMBEDS the interface type, so the five
        ; tuple slots live on InterfaceTypeData (its header carries the argument) and
        ; the DISCRIMINATOR is `object_flags & ObjectFlagsTuple`, never the arm.
        ;
        ; ★ It stands ABOVE the Reference arm because the reference's switch does: a
        ; tuple target carries `Tuple | Reference`, and the Reference arm would give
        ; it a payload with no type parameters and no declared members.
        if (object_flags & ObjectFlagsTuple) <> 0
            return this.new_type(TypeFlagsObject, object_flags, sym, TypeData.Interface(box_node_data[InterfaceTypeData](host, InterfaceTypeData())))
        if (object_flags & ObjectFlagsReference) <> 0
            return this.new_type(TypeFlagsObject, object_flags, sym, TypeData.Reference(ReferenceTypeData(null, null)))
        ; ★ Slice 125 fills the mapped arm. It stands where the reference's switch
        ; puts it — after Reference and before ReverseMapped — and its payload is
        ; MappedTypeData, the reference's own struct.
        if (object_flags & ObjectFlagsMapped) <> 0
            return this.new_type(TypeFlagsObject, object_flags, sym, TypeData.Mapped(box_node_data[MappedTypeData](host, MappedTypeData())))
        ; ★ Slice 160 fills the reverse-mapped arm. It stands where the reference's
        ; switch puts it — directly after Mapped — and its payload starts empty:
        ; create_reverse_mapped_type writes the three slots in the next line, the
        ; way getEvolvingArrayType does for its own arm.
        if (object_flags & ObjectFlagsReverseMapped) <> 0
            return this.new_type(TypeFlagsObject, object_flags, sym, TypeData.ReverseMapped(box_node_data[ReverseMappedTypeData](host, ReverseMappedTypeData())))
        ; ★ Slice 141 fills the evolving-array arm. Upstream's switch reaches
        ; `&EvolvingArrayType{}` here and getEvolvingArrayType writes the element
        ; type onto the payload one line later; both slots therefore start null and
        ; the two §3.14 setters below fill them.
        if (object_flags & ObjectFlagsEvolvingArray) <> 0
            return this.new_type(TypeFlagsObject, object_flags, sym, TypeData.EvolvingArray(EvolvingArrayTypeData(null, null)))
        ; ★★ Slice 181 fills this arm, and its POSITION is the whole of it:
        ; getInstantiationExpressionType asks for `Anonymous|InstantiationExpression`
        ; and the reference's switch tests the second bit FIRST, so an arm written
        ; after the anonymous one below would never be reached and the node slot
        ; would be unreachable for every type that has one.
        if (object_flags & ObjectFlagsInstantiationExpressionType) <> 0
            return this.new_type(TypeFlagsObject, object_flags, sym, TypeData.InstantiationExpression(InstantiationExpressionTypeData(null, null, null, null, null)))
        ; ★ Slice 67 fills the anonymous arm, which used to report here. Its
        ; caller is getTypeOfFuncClassEnumModuleWorker and the first thing this
        ; port makes with it is the STATIC SIDE of a class.
        if (object_flags & ObjectFlagsAnonymous) <> 0
            return this.new_type(TypeFlagsObject, object_flags, sym, TypeData.Anonymous(AnonymousTypeData()))
        this.record_unported("new-object-type-unhandled", object_flags)
        null
    }

    ; newTypeParameter. Four lines in the reference and four here.
    procedure new_type_parameter(this, sym: ref[Symbol]?) returns ref[Type]
        this.new_type(TypeFlagsTypeParameter, ObjectFlagsNone, sym, TypeData.TypeParameter(TypeParameterTypeData()))

    ; ── literal types (slice 71) ────────────────────────────────────────────
    ;
    ; newLiteralType, and the two-slot dance at its tail is the reference's:
    ; `regularType` is the argument when one is given and the NEW TYPE ITSELF
    ; otherwise, so a regular literal type is its own regular type and a fresh one
    ; points back at the regular one it was minted from.
    ;
    ; ★ The reference passes ONE `value any` here; this takes the three slots
    ; LiteralTypeData holds, and each caller fills the one its flags name (see the
    ; record's note for why the flags are the discriminator).
    procedure new_literal_type(this, flags: int, text: Slice[char], bits: u64, negative: bool, bool_value: bool, regular_type: ref[Type]?) returns ref[Type]
    {
        let t this.new_type(flags, ObjectFlagsNone, null, TypeData.Literal(LiteralTypeData(text, bits, negative, bool_value)))
        if regular_type = null
            Checker.set_literal_regular_type(t, t)
        else
            Checker.set_literal_regular_type(t, regular_type)
        t
    }

    ; The LiteralType accessors — `AsLiteralType().value` and its two links, as
    ; questions about the union TAG, exactly as this file's other payload
    ; accessors are. Each answers a zero for an arm that is not Literal, where the
    ; reference's unchecked assertion would panic.
    function literal_text_slice_of(t: ref[Type]) returns Slice[char]
    {
        choose t.data
            when d: Literal
                return d.text
        Slice[char]()
    }

    function literal_text_of(t: ref[Type]) returns Slice[char]
    {
        Checker.literal_text_slice_of(t)
    }

    function literal_text_length_of(t: ref[Type]) returns int
    {
        Checker.literal_text_slice_of(t).length as int
    }

    function literal_bits_of(t: ref[Type]) returns u64
    {
        choose t.data
            when d: Literal
                return d.bits
        0 as u64
    }

    function literal_negative_of(t: ref[Type]) returns bool
    {
        choose t.data
            when d: Literal
                return d.negative
        false
    }

    ; getBooleanLiteralValue.
    function literal_bool_of(t: ref[Type]) returns bool
    {
        choose t.data
            when d: Literal
                return d.bool_value
        false
    }

    function literal_regular_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Literal
                return d.regular_type
        null
    }

    function literal_fresh_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Literal
                return d.fresh_type
        null
    }

    ; The two writers. Copy the arm out, mutate the copy, put the whole arm back —
    ; a `when` binding is a COPY and the direct spelling stores through the
    ; payload's first eight bytes (root CLAUDE.md).
    procedure set_literal_regular_type(t: ref[Type], rt: ref[Type]?)
    {
        choose t.data
            when l: Literal
            {
                var d l
                set d.regular_type: rt
                set t.data: TypeData.Literal(d)
            }
    }

    procedure set_literal_fresh_type(t: ref[Type], ft: ref[Type]?)
    {
        choose t.data
            when l: Literal
            {
                var d l
                set d.fresh_type: ft
                set t.data: TypeData.Literal(d)
            }
    }

    ; getFreshTypeOfLiteralType. The fresh type is minted ONCE per regular type and
    ; cached on it; it carries the same flags and value, points back at the regular
    ; type, and — the line that makes isFreshLiteralType work at all — points at
    ; ITSELF as its own fresh type.
    ;
    ; ★ `f.symbol = t.symbol` is the reference's and is ported even though every
    ; literal type this slice mints has a null symbol: the arm that gives one a
    ; symbol is getEnumLiteralType, and a copy that silently dropped it would be
    ; found the day that arm lands rather than here.
    procedure get_fresh_type_of_literal_type(this, t: ref[Type]) returns ref[Type]
    {
        if (t.flags & TypeFlagsFreshable) = 0
            return t
        let cached Checker.literal_fresh_type_of(t)
        if cached <> null
            return cached as ref[Type]
        let f this.new_literal_type(t.flags, Checker.literal_text_slice_of(t), Checker.literal_bits_of(t), Checker.literal_negative_of(t), Checker.literal_bool_of(t), t)
        set f.symbol: t.symbol
        Checker.set_literal_fresh_type(f, f)
        Checker.set_literal_fresh_type(t, f)
        f
    }

    ; getStringLiteralType. The table is scanned linearly and compared on the
    ; BYTES, which is what a Go map keyed on a string compares.
    ;
    ; ★★★ THE MINT COPIES THE TEXT ONTO THE CHECKER'S PAGE, AND THAT IS A FIX AND
    ; NOT A PRECAUTION. Upstream's key and value are a Go STRING, an immutable
    ; value; here `text` is a borrowed `Slice[char]` and the row kept it, so a
    ; caller whose bytes were a stack buffer or a frame that later died left an
    ; INTERNED type pointing at dead memory — permanently, and for every later ask
    ; with the same bytes, because the scan above hands that row back. It reads as
    ; a wrong ANSWER rather than a crash: `destructuringControlFlow` printed
    ; `"\uFFFD"` where the reference prints `"x"`, and it printed it only in the
    ; whole unit, never in the five lines around the site, because what the slice
    ; points at is whatever the arena put there next. Slice 195 met the same class
    ; one table over (`add_member_for_key_type_worker`) and fixed it at that ONE
    ; caller; this is the same fix at the table, where it covers all of them.
    ; The copy is on the MINT path only — one per distinct literal.
    procedure get_string_literal_type(this, text: Slice[char]) returns ref[Type]
    {
        let h SymbolTable.hash_name(text)
        if string_literal_buckets <> null
        {
            let b string_literal_buckets as ref[Vector[int]]
            var slot h & string_literal_mask
            var probing true
            while probing
            {
                let e b.get(slot as size_t)
                if e = null
                    set probing: false
                else
                {
                    let idx *e
                    if idx = 0
                        set probing: false
                    else
                    {
                        let row string_literal_types[idx - 1]
                        if row <> null
                        {
                            let t row as ref[Type]
                            if Checker.literal_text_length_of(t) = text.length
                            {
                                if Checker.text_equals(Checker.literal_text_of(t), text)
                                    return t
                            }
                        }
                        set slot: (slot + 1) & string_literal_mask
                    }
                }
            }
        }
        var owned text
        if text.length > 0
            set owned: this.copy_name_to_page(text)
        let t this.new_literal_type(TypeFlagsStringLiteral, owned, 0 as u64, false, false, null)
        string_literal_types.add(t)
        this.string_literal_index_insert(h, string_literal_types.get_length() as int)
        t
    }

    procedure string_literal_index_insert(this, h: int, count: int)
    {
        var cap 0
        if string_literal_buckets <> null
            set cap: string_literal_mask + 1
        if (count * 4) > (cap * 3)
        {
            var new_cap 64
            while (count * 4) > (new_cap * 3)
                set new_cap: new_cap * 2
            let old_string_literal_buckets string_literal_buckets
            let v AddressIndex.fresh_buckets(host, new_cap)
            set this.string_literal_buckets: v
            AddressIndex.release_buckets(host, old_string_literal_buckets)
            set this.string_literal_mask: new_cap - 1
            var j 0
            while j < count
            {
                let row string_literal_types[j]
                if row <> null
                {
                    let hh SymbolTable.hash_name(Checker.literal_text_of(row as ref[Type]))
                    Checker.bucket_insert(v, string_literal_mask, hh, j + 1)
                }
                set j: j + 1
            }
            return
        }
        Checker.bucket_insert(string_literal_buckets as ref[Vector[int]], string_literal_mask, h, count)
    }

    procedure bucket_insert(b: ref[Vector[int]], mask: int, h: int, value: int)
    {
        var slot h & mask
        var probing true
        while probing
        {
            let e b.get(slot as size_t)
            var empty false
            if e = null
                set empty: true
            else
            {
                if *e = 0
                    set empty: true
            }
            if empty
            {
                b.put(slot as size_t, value)
                set probing: false
            }
            else
                set slot: (slot + 1) & mask
        }
    }

    function number_bits_hash(bits: u64) returns int
    {
        let mixed (bits xor (bits >> 29)) * 1099511628211
        ((mixed >> 1) as int)
    }

    ; getNumberLiteralType — see the table's own note for why the NaN cell the
    ; reference keeps beside it is not here.
    procedure get_number_literal_type(this, bits: u64) returns ref[Type]
    {
        let h Checker.number_bits_hash(bits)
        if number_literal_buckets <> null
        {
            let b number_literal_buckets as ref[Vector[int]]
            var slot h & number_literal_mask
            var probing true
            while probing
            {
                let e b.get(slot as size_t)
                if e = null
                    set probing: false
                else
                {
                    let idx *e
                    if idx = 0
                        set probing: false
                    else
                    {
                        let row number_literal_types[idx - 1]
                        if row <> null
                        {
                            let t row as ref[Type]
                            if Checker.literal_bits_of(t) = bits
                                return t
                        }
                        set slot: (slot + 1) & number_literal_mask
                    }
                }
            }
        }
        let t this.new_literal_type(TypeFlagsNumberLiteral, Slice[char](), bits, false, false, null)
        number_literal_types.add(t)
        this.number_literal_index_insert(h, number_literal_types.get_length() as int)
        t
    }

    procedure number_literal_index_insert(this, h: int, count: int)
    {
        var cap 0
        if number_literal_buckets <> null
            set cap: number_literal_mask + 1
        if (count * 4) > (cap * 3)
        {
            var new_cap 64
            while (count * 4) > (new_cap * 3)
                set new_cap: new_cap * 2
            let old_number_literal_buckets number_literal_buckets
            let v AddressIndex.fresh_buckets(host, new_cap)
            set this.number_literal_buckets: v
            AddressIndex.release_buckets(host, old_number_literal_buckets)
            set this.number_literal_mask: new_cap - 1
            var j 0
            while j < count
            {
                let row number_literal_types[j]
                if row <> null
                {
                    let hh Checker.number_bits_hash(Checker.literal_bits_of(row as ref[Type]))
                    Checker.bucket_insert(v, number_literal_mask, hh, j + 1)
                }
                set j: j + 1
            }
            return
        }
        Checker.bucket_insert(number_literal_buckets as ref[Vector[int]], number_literal_mask, h, count)
    }

    ; getBigIntLiteralType. The key is the whole PseudoBigInt — the sign AND the
    ; digits — because that is what a Go map keyed on the struct compares.
    procedure get_bigint_literal_type(this, text: Slice[char], negative: bool) returns ref[Type]
    {
        let len bigint_literal_types.get_length() as int
        var i 0
        while i < len
        {
            let row bigint_literal_types[i]
            if row <> null
            {
                let t row as ref[Type]
                if Checker.literal_negative_of(t) = negative
                {
                    if Checker.literal_text_length_of(t) = text.length
                    {
                        if Checker.text_equals(Checker.literal_text_of(t), text)
                            return t
                    }
                }
            }
            set i: i + 1
        }
        let t this.new_literal_type(TypeFlagsBigIntLiteral, text, 0 as u64, negative, false, null)
        bigint_literal_types.add(t)
        t
    }

    function text_equals(a: Slice[char], b: Slice[char]) returns bool
    {
        if a.length <> b.length
            return false
        var i 0
        while i < b.length
        {
            if (a[i] as int) <> (b[i] as int)
                return false
            set i: i + 1
        }
        true
    }

    ; ── the payload accessors ───────────────────────────────────────────────
    ;
    ; The reference's `AsInterfaceType()` / `AsTypeReference()` downcasts, as
    ; questions about the union TAG. Each answers null for an arm that is not the
    ; one asked about, where the reference would panic — the same choice
    ; new_object_type's default makes, and for the same reason.

    ; InterfaceType.thisType.
    function this_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Interface
                return d.this_type
        null
    }

    ; ObjectType.target, which every object arm carries.
    ;
    ; ★★ THE ANONYMOUS AND MAPPED ARMS ARE SLICE 125'S, and adding them is not a
    ; widening of the question: `t.Target()` upstream is a method on the embedded
    ; ObjectType, so every one of these four arms answered it there. The two that
    ; were missing here answered NULL — the port's convention for an arm that is
    ; not the one asked about — and that reading was indistinguishable from *this
    ; instantiated type has no target*, which is the shape instantiate_type_worker
    ; forks on.
    ; ★★★ THE TYPE-PARAMETER, INDEX AND STRING-MAPPING ARMS ARE SLICE 228'S, for
    ; the same reason as the two above: upstream's `Target()` is ONE accessor over
    ; every kind that carries a target, and `createCanonicalSignature` asks it of
    ; a TYPE PARAMETER (`tp.Target() != nil && constraint == nil` → the original).
    ; Answering null there kept every cloned method type parameter as its own
    ; identity, so the canonical signature was the signature itself and the
    ; instantiation stream forked from the reference at the first generic method
    ; comparison (complexRecursiveCollections: >240 s against 2 s).
    function target_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when i: Interface
                return i.target
            when r: Reference
                return r.target
            when a: Anonymous
                return a.target
            when m: Mapped
                return m.target
            when ie: InstantiationExpression
                return ie.target
            when tp: TypeParameter
                return tp.target
            when ix: Index
                return ix.target
            when sm: StringMapping
                return sm.target
        null
    }

    ; ObjectType.mapper — `t.Mapper()`, which every object arm answers upstream.
    ; The Reference arm has its own reader (`reference_mapper_of`, slice 115) and
    ; is repeated here so that one question has one spelling.
    function mapper_of(t: ref[Type]) returns ref[TypeMapper]?
    {
        choose t.data
            when a: Anonymous
                return a.mapper
            when m: Mapped
                return m.mapper
            when r: Reference
                return r.mapper
            when ie: InstantiationExpression
                return ie.mapper
        null
    }

    ; instantiateAnonymousType's tail — `d.target = t; d.mapper = m` — as the one
    ; write both arms need. Copy / mutate / write the arm back (§3.14).
    procedure set_object_target_and_mapper(t: ref[Type], target: ref[Type]?, m: ref[TypeMapper]?)
    {
        choose t.data
            when a: Anonymous
            {
                var d a
                set d.target: target
                set d.mapper: m
                set t.data: TypeData.Anonymous(d)
            }
            when ie: InstantiationExpression
            {
                var d ie
                set d.target: target
                set d.mapper: m
                set t.data: TypeData.InstantiationExpression(d)
            }
            when m2: Mapped
            {
                var d m2
                set d.target: target
                set d.mapper: m
                set t.data: TypeData.Mapped(d)
            }
    }

    ; ── the reverse-mapped payload's three slots (slice 160) ────────────────
    ;
    ; `t.AsReverseMappedType().x`. All three are written once, by
    ; create_reverse_mapped_type, so the write is ONE procedure and not three —
    ; the copy / mutate / write-back dance (§3.14) is paid once per type.

    function reverse_source_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when r: ReverseMapped
                return r.source
        null
    }

    function reverse_mapped_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when r: ReverseMapped
                return r.mapped_type
        null
    }

    function reverse_constraint_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when r: ReverseMapped
                return r.constraint_type
        null
    }

    procedure set_reverse_mapped_slots(t: ref[Type], source: ref[Type]?, mapped: ref[Type]?, constraint: ref[Type]?)
    {
        choose t.data
            when r: ReverseMapped
            {
                var d r
                set d.source: source
                set d.mapped_type: mapped
                set d.constraint_type: constraint
                set t.data: TypeData.ReverseMapped(d)
            }
    }

    ; ── the mapped payload's eight slots ────────────────────────────────────
    ;
    ; `t.AsMappedType().x`, as a reader and a writer per lazily-filled slot. Every
    ; one of the memo writers is copy / mutate / write back for §3.14's reason.

    function mapped_declaration_of(t: ref[Type]) returns ref[AstNode]?
    {
        choose t.data
            when m: Mapped
                return m.declaration
        null
    }

    procedure set_mapped_declaration(t: ref[Type], node: ref[AstNode]?)
    {
        choose t.data
            when m: Mapped
            {
                var d m
                set d.declaration: node
                set t.data: TypeData.Mapped(d)
            }
    }

    function mapped_type_parameter_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when m: Mapped
                return m.type_parameter
        null
    }

    procedure set_mapped_type_parameter(t: ref[Type], tp: ref[Type]?)
    {
        choose t.data
            when m: Mapped
            {
                var d m
                set d.type_parameter: tp
                set t.data: TypeData.Mapped(d)
            }
    }

    function mapped_constraint_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when m: Mapped
                return m.constraint_type
        null
    }

    procedure set_mapped_constraint_type(t: ref[Type], ct: ref[Type]?)
    {
        choose t.data
            when m: Mapped
            {
                var d m
                set d.constraint_type: ct
                set t.data: TypeData.Mapped(d)
            }
    }

    function mapped_name_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when m: Mapped
                return m.name_type
        null
    }

    procedure set_mapped_name_type(t: ref[Type], nt: ref[Type]?)
    {
        choose t.data
            when m: Mapped
            {
                var d m
                set d.name_type: nt
                set t.data: TypeData.Mapped(d)
            }
    }

    function mapped_template_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when m: Mapped
                return m.template_type
        null
    }

    procedure set_mapped_template_type(t: ref[Type], tt: ref[Type]?)
    {
        choose t.data
            when m: Mapped
            {
                var d m
                set d.template_type: tt
                set t.data: TypeData.Mapped(d)
            }
    }

    function mapped_modifiers_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when m: Mapped
                return m.modifiers_type
        null
    }

    procedure set_mapped_modifiers_type(t: ref[Type], mt: ref[Type]?)
    {
        choose t.data
            when m: Mapped
            {
                var d m
                set d.modifiers_type: mt
                set t.data: TypeData.Mapped(d)
            }
    }

    function mapped_resolved_apparent_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when m: Mapped
                return m.resolved_apparent_type
        null
    }

    procedure set_mapped_resolved_apparent_type(t: ref[Type], at: ref[Type]?)
    {
        choose t.data
            when m: Mapped
            {
                var d m
                set d.resolved_apparent_type: at
                set t.data: TypeData.Mapped(d)
            }
    }

    ; The INTERSECTION's own resolvedApparentType (slice 155), the same pair one
    ; variant over. ★The write is the copy/mutate/write-back idiom a `when`
    ; binding demands — a binding is a COPY, so a store into it writes a
    ; temporary.
    function intersection_resolved_apparent_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Intersection
                return d.resolved_apparent_type
        null
    }

    procedure set_intersection_resolved_apparent_type(t: ref[Type], at: ref[Type]?)
    {
        choose t.data
            when d: Intersection
            {
                var v d
                set v.resolved_apparent_type: at
                set t.data: TypeData.Intersection(v)
            }
    }

    ; ── the reference's uniqueLiteralFilledInstantiation (slice 166) ─────────

    function unique_literal_filled_instantiation_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Intersection
                return d.unique_literal_filled_instantiation
        null
    }

    procedure set_unique_literal_filled_instantiation(t: ref[Type], v: ref[Type]?)
    {
        choose t.data
            when d: Intersection
            {
                var w d
                set w.unique_literal_filled_instantiation: v
                set t.data: TypeData.Intersection(w)
            }
    }

    ; ★The slot's first READER arrives with the printer's guard below — until then
    ; the comment on MappedTypeData called it a writer without one, which §3.5be
    ; admits and this retires.
    function mapped_contains_error_of(t: ref[Type]) returns bool
    {
        choose t.data
            when m: Mapped
                return m.contains_error
        false
    }

    procedure set_mapped_contains_error(t: ref[Type])
    {
        choose t.data
            when m: Mapped
            {
                var d m
                set d.contains_error: true
                set t.data: TypeData.Mapped(d)
            }
    }

    ; TypeReference.resolvedTypeArguments, likewise.
    function resolved_type_arguments_of(t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when i: Interface
                return i.resolved_type_arguments
            when r: Reference
                return r.resolved_type_arguments
        null
    }

    ; InterfaceType.baseTypesResolved / resolvedBaseTypes /
    ; resolvedBaseConstructorType, plus the two writers getBaseTypes and
    ; getBaseConstructorTypeOfClass need. Each write is copy / mutate / put the
    ; whole arm back — a `when` binding is a COPY, and the direct spelling stores
    ; through the payload's first eight bytes (see mark_this_type's note).
    function base_types_resolved_of(t: ref[Type]) returns bool
    {
        choose t.data
            when d: Interface
                return d.base_types_resolved
        false
    }

    function resolved_base_types_of(t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when d: Interface
                return d.resolved_base_types
        null
    }

    function resolved_base_constructor_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Interface
                return d.resolved_base_constructor_type
        null
    }

    procedure mark_base_types_resolved(t: ref[Type])
    {
        choose t.data
            when i: Interface
            {
                var d i
                set d.base_types_resolved: true
                set t.data: TypeData.Interface(d)
            }
    }

    procedure set_resolved_base_types(t: ref[Type], types: ref[Array[ref[Type]?]]?)
    {
        choose t.data
            when i: Interface
            {
                var d i
                set d.resolved_base_types: types
                set t.data: TypeData.Interface(d)
            }
    }

    procedure set_resolved_base_constructor_type(t: ref[Type], bct: ref[Type]?)
    {
        choose t.data
            when i: Interface
            {
                var d i
                set d.resolved_base_constructor_type: bct
                set t.data: TypeData.Interface(d)
            }
    }

    ; InterfaceType.TypeParameters() — allTypeParameters minus the trailing
    ; thisType, and nil when the array is empty. The two siblings
    ; (OuterTypeParameters, LocalTypeParameters) are not written: their readers
    ; are getTypeArguments' deferred path and getBaseTypes, both of which report
    ; in this slice, and a slicing accessor nobody calls is a claim about the
    ; future (§3.5be).
    function type_parameter_count_of(t: ref[Type]) returns int
    {
        choose t.data
            when d: Interface
            {
                if d.all_type_parameters = null
                    return 0
                let all d.all_type_parameters as ref[Array[ref[Type]?]]
                let n all.get_length() as int
                if n = 0
                    return 0
                return n - 1
            }
        0
    }

    ; InterfaceType.allTypeParameters — the WHOLE list, thisType included, and it
    ; cannot be derived from the count above: resolveTypeReferenceMembers hands
    ; exactly this list to the mapper as its SOURCES, and the trailing thisType is
    ; the one entry that mapper maps. Slice 86.
    function all_type_parameters_of(t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when d: Interface
                return d.all_type_parameters
        null
    }

