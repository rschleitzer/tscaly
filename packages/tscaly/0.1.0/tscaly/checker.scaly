            return true
        if Checker.name_bytes_are(s, "SharedArrayBuffer")
            return true
        if Checker.name_bytes_are(s, "AsyncIterable")
            return true
        if Checker.name_bytes_are(s, "AsyncIterableIterator")
            return true
        if Checker.name_bytes_are(s, "AsyncGenerator")
            return true
        if Checker.name_bytes_are(s, "AsyncGeneratorFunction")
            return true
        if Checker.name_bytes_are(s, "RegExp")
            return true
        if Checker.name_bytes_are(s, "RegExpConstructor")
            return true
        if Checker.name_bytes_are(s, "Reflect")
            return true
        if Checker.name_bytes_are(s, "ArrayConstructor")
            return true
        if Checker.name_bytes_are(s, "ObjectConstructor")
            return true
        if Checker.name_bytes_are(s, "NumberConstructor")
            return true
        if Checker.name_bytes_are(s, "Math")
            return true
        if Checker.name_bytes_are(s, "Map")
            return true
        if Checker.name_bytes_are(s, "MapConstructor")
            return true
        if Checker.name_bytes_are(s, "Set")
            return true
        if Checker.name_bytes_are(s, "PromiseConstructor")
            return true
        if Checker.name_bytes_are(s, "Symbol")
            return true
        if Checker.name_bytes_are(s, "WeakMap")
            return true
        if Checker.name_bytes_are(s, "WeakSet")
            return true
        if Checker.name_bytes_are(s, "String")
            return true
        if Checker.name_bytes_are(s, "StringConstructor")
            return true
        if Checker.name_bytes_are(s, "DateTimeFormat")
            return true
        if Checker.name_bytes_are(s, "Promise")
            return true
        if Checker.name_bytes_are(s, "RegExpMatchArray")
            return true
        if Checker.name_bytes_are(s, "RegExpExecArray")
            return true
        if Checker.name_bytes_are(s, "Intl")
            return true
