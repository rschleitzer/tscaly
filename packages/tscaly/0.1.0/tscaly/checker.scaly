    ; GetErrorRangeForNode over the node's own file's text
    procedure error_range_in_own_file(this, n: ref[AstNode], out_start: ref[int], out_end: ref[int]) returns bool
    {
        if program <> null
        {
            let index this.program_index_of_node(n)
            if index >= 0
            {
                let pf program as ref[ProgramFiles]
                let nb pf.binder_at(index)
                if nb <> null
                    return (nb as ref[Binder]).error_range_for_node_on(this.scanner_for(nb as ref[Binder]), pf.parser_at(index), n, out_start, out_end)
            }
        }
        b.error_range_for_node_on(this.scanner_for(b), p, n, out_start, out_end)
    }

    procedure type_to_string(this, t: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        ; a TOP-LEVEL ask is a fresh node-builder context: the estimate and its
        ; sticky verdict start at zero (typeToStringEx builds a new context per call)
        if printer_depth = 0
        {
            set this.printer_approximate_length: 0
            set this.printer_truncating: false
        }
        ; ★ The ONE place the worker is entered, which is what makes the depth
        ; counter a counter rather than a discipline — see printer_depth's note.
        ; Every arm recurses through THIS function and not through the worker.
        if t = null
        {
            set printer_depth: printer_depth + 1
            let ok0 this.type_to_string_worker(null, out)
            set printer_depth: printer_depth - 1
            return ok0
        }
        let mark this.unported_mark()
        let reduced this.get_reduced_type(t as ref[Type])
        if this.unported_mark() <> mark
            return false
        if reduced = null
            return false
        set printer_depth: printer_depth + 1
        let ok this.type_to_string_worker(reduced, out)
        set printer_depth: printer_depth - 1
        ok
    }

    ; isIdentifierTypeReference over the node the LAST `type_to_string` at `outer`
    ; answered — true only when the name was written by that call's OWN arm, and
    ; not by something it recursed into.
    function wrote_identifier_type_reference(this, outer: int) returns bool
    {
        if wrote_type_reference_name.length = 0
            return false
        wrote_name_depth = outer + 1
    }

    procedure type_to_string_worker(this, t: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        ; The node this call is about to build needs no parentheses anywhere until an
        ; arm says otherwise — see the field's note for why the writer records it.
        set wrote_type_precedence: TypePrecedenceNonArray
        ; …and it is not an identifier type reference until an arm says it is.
        set wrote_type_reference_name.data: null
        set wrote_type_reference_name.length: 0
        if t = null
        {
            ; The reference PANICS here ("should always get typenode"), because a
            ; nil type reaches the worker only with FlagsAllowEmptyUnionOrIntersection
            ; set and typeToString does not set it. Reported rather than trapped:
            ; the dump's caller skips a nil type exactly as the oracle does, so
            ; this is unreachable from the walk and a report says so without
            ; inventing a keyword.
            this.record_unported("type-to-string-null", 0)
            return false
        }

        if (t.flags & TypeFlagsAny) <> 0
        {
            ; ★★★ THE ALIAS ARM IS CODE SINCE SLICE 114, and the note that stood
            ; here — *"t.alias … is not represented yet, and CANNOT be: an alias is
            ; set by getTypeFromTypeNode, which reports"* — was wrong in both
            ; halves by the time it was read: the two slots have been on `Type`
            ; since slice 66, and getTypeFromTypeAliasReference's Unresolved arm
            ; writes them without going near a stop.
            ;
            ; ★ It is `ToTypeReferenceNode` and not the general alias path 130
            ; lines further down in the reference: an `any` carrying an alias
            ; prints its name UNCONDITIONALLY, with no accessibility question and
            ; no shouldExpandType — which is what makes an unresolved `Widget`
            ; print as `Widget` rather than as `any`.
            if t.alias_symbol <> null
                return this.write_alias_type_reference(t, out)
            if t = unresolved_type
            {
                ; The reference wraps the keyword in a SYNTHETIC LEADING COMMENT
                ; ("/*unresolved*/ any") and prints it with a printer that keeps
                ; comments, where every other type is printed with one that
                ; removes them. That is a printer feature rather than a name, so
                ; it reports.
                this.record_unported("type-to-string-unresolved", 0)
                return false
            }
            this.add_approximate_length(3)
            if t = intrinsic_marker_type
                return Checker.write_keyword(out, "intrinsic")
            return Checker.write_keyword(out, "any")
        }
        if (t.flags & TypeFlagsUnknown) <> 0
            return Checker.write_keyword(out, "unknown")
        if (t.flags & TypeFlagsString) <> 0
        {
            this.add_approximate_length(6)
            return Checker.write_keyword(out, "string")
        }
        if (t.flags & TypeFlagsNumber) <> 0
        {
            this.add_approximate_length(6)
            return Checker.write_keyword(out, "number")
        }
        if (t.flags & TypeFlagsBigInt) <> 0
        {
            this.add_approximate_length(6)
            return Checker.write_keyword(out, "bigint")
        }
        ; `t.flags&Boolean != 0 && t.alias == nil`. ★★★ THE ARM IS LIVE SINCE
        ; SLICE 94 AND IT IS THE REASON THE UNION CHAPTER SETS TypeFlagsBoolean ON
        ; A TWO-BOOLEAN-LITERAL UNION AT ALL: booleanType IS a union, and it
        ; reaches this keyword long before the union arm at the tail — which is
        ; what keeps `boolean` from printing as `false | true`.
        ;
        ; ★★★ AND THE SECOND CONJUNCT IS LOAD-BEARING, WHICH THE NOTE THAT STOOD
        ; HERE DENIED (*not carried and always true here*). The slot landed in slice
        ; 111, and the alias arm BELOW can never reach a type this one answered.
        ; `type A1 = true | false` is NOT booleanType: the intern key carries the
        ; alias (`union_key_matches`), so the alias mints its OWN two-constituent
        ; union which then gets TypeFlagsBoolean for the reason above — after which
        ; this keyword swallowed it and printed `boolean` for `A1`.
        if (t.flags & TypeFlagsBoolean) <> 0
        {
            if t.alias_symbol = null
            {
                this.add_approximate_length(7)
                return Checker.write_keyword(out, "boolean")
            }
        }
        ; ★★★ THE ENUM ARM, AND IT PRINTS THE PARENT ALONE MORE OFTEN THAN A
        ; READER EXPECTS. `getDeclaredTypeOfSymbol(parentSymbol) == t` is TRUE for
        ; every SINGLE-MEMBER enum — the union of one type IS that type
        ; (get_union_type_ex answers `types[0]` at length one) — so `enum E { A }`
        ; prints `E` for A's own type and not `E.A`. Reading the arm as *a member
        ; always prints qualified* is how that case comes out wrong.
        ;
        ; ★★ THE ORDER IS THE REFERENCE'S, READ BACKWARDS. Upstream BUILDS
        ; parentName first and then decides which of three things to answer with
        ; it; here the writer appends as it goes, so the decision has to come
        ; first. The two agree because the only effect of building parentName is
        ; the name itself — its one side effect, a stop inside symbol_to_type_node,
        ; ends the whole print either way.
        if (t.flags & TypeFlagsEnumLike) <> 0
        {
            if t.symbol = null
            {
                ; A symbol-less enum type is unrepresentable here: both producers
                ; (create_computed_enum_type and get_enum_literal_type) set one.
                this.record_unported("type-to-string-enum", 0)
                return false
            }
            let sym t.symbol as ref[Symbol]
            if (Symbol.flags_of(sym) & SymbolFlagsEnumMember) = 0
                return this.symbol_to_type_node(sym, SymbolFlagsType, out)
            let parent_symbol this.get_parent_of_symbol(sym)
            if parent_symbol = null
            {
                this.record_unported("type-to-string-enum", 0)
                return false
            }
            let ps parent_symbol as ref[Symbol]
            if this.get_declared_type_of_symbol(ps) = t
                return this.symbol_to_type_node(ps, SymbolFlagsType, out)
            ; `IsIdentifierText(memberName, LanguageVariantStandard)`. A member
            ; whose name is not one — `enum E { "a b" = 1 }`, and `enum E { 1.0 =
            ; 1 }` too, since a numeric name is stored as the digits — is written
            ; as an INDEXED ACCESS over a TYPE QUERY. ★★ The reference builds two
            ; nodes there and the PARENTHESES come from the emit printer, which
            ; wraps a TypeQuery standing in a type-node's objectType position; the
            ; writer here has no node to ask, so the two characters are written
            ; where that rule puts them. ★The third arm (`ast.IsImportTypeNode`)
            ; is behind symbol_to_type_node's own import-type stop and cannot be
            ; reached from here.
            if Checker.is_identifier_text(Symbol.name_of(sym)) = false
            {
                out.append("(typeof " )
                if this.write_symbol_name(ps, out) = false
                    return false
                out.append(")[")
                Checker.write_ascii_escaped_literal_name(out, Symbol.name_of(sym))
                out.append("]")
                set wrote_type_precedence: TypePrecedenceNonArray
                return true
            }
            if this.symbol_to_type_node(ps, SymbolFlagsType, out) = false
                return false
            out.append("." as char)
            out.append(Symbol.name_of(sym).data, Symbol.name_of(sym).length)
            set wrote_type_precedence: TypePrecedenceNonArray
            ; ★★★ THE PARENT'S NAME IS NOT THIS NODE'S NAME, AND THE DEPTH COUNTER
            ; CANNOT SEE THE DIFFERENCE: `symbol_to_type_node` is called DIRECTLY
            ; here rather than through `type_to_string`, so it writes `E` at this
            ; arm's own depth and the reader would take it for the whole node's.
            ; What this arm builds is a QualifiedName (`E.V2`), which is not an
            ; identifier type reference at all. Unstated, `E.V2 | E.V3 | E.V4` read
            ; as three constituents named `E` for three different enum-literal
            ; types, and the collision pass qualified all three — through the
            ; `import I = A.B.C.E` alias, so `constEnums` printed
            ; `I.V2 | I.V3 | I.V4`. **A counter that brackets one CALL cannot speak
            ; for a name written outside it.**
            set wrote_type_reference_name.data: null
            set wrote_type_reference_name.length: 0
            return true
        }
        ; ★★★ THE STRING LITERAL IS THE ONLY ARM WITH AN ESCAPE, and it is a port
        ; of the PRINTER rather than of the nodebuilder. The builder makes a
        ; synthetic StringLiteral node and adds EFNoAsciiEscaping to it; the
        ; printer then cannot reach an original source text (the node is
        ; synthesized) and falls into getLiteralText's StringLiteral arm, which is
        ; a double quote, escapeStringWorker, and a double quote. The emit flag is
        ; what makes NeverAsciiEscape true, which is the one bit of the worker's
        ; behaviour that would otherwise depend on it.
        if (t.flags & TypeFlagsStringLiteral) <> 0
        {
            this.add_approximate_length((Checker.literal_text_of(t).length as int) + 2)
            Checker.write_string_literal_name(out, Checker.literal_text_of(t))
            return true
        }
        ; The number's own String(). ★The reference's arm SPLITS a negative value
        ; into a PrefixUnaryExpression over the digits without the sign, which is
        ; two nodes printing the one text `-N` — so the split is a property of the
        ; node tree it builds and not of the name, and the name is the whole
        ; String() either way (§3.5ag).
        if (t.flags & TypeFlagsNumberLiteral) <> 0
        {
            var nb char[JSNUM_MAX_TEXT]
            let nn jsnum_to_string(Checker.literal_bits_of(t), Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
            out.append(&nb[0], nn as size_t)
            this.add_approximate_length(nn as int)
            return true
        }
        ; pseudoBigIntToString(value) + "n".
        if (t.flags & TypeFlagsBigIntLiteral) <> 0
        {
            let big_start out.get_length() as int
            Checker.write_pseudo_big_int(out, t)
            this.add_approximate_length(((out.get_length() as int) - big_start) + 1)
            out.append("n" as char)
            return true
        }
        if (t.flags & TypeFlagsBooleanLiteral) <> 0
        {
            if Checker.literal_bool_of(t)
            {
                this.add_approximate_length(4)
                return Checker.write_keyword(out, "true")
            }
            this.add_approximate_length(5)
            return Checker.write_keyword(out, "false")
        }
        ; ★★★ `unique symbol`, AND THE FLAG IS WHAT MAKES IT ONE LINE. The
        ; reference's arm forks on `flags&AllowUniqueESSymbolType == 0` into
        ; IsValueSymbolAccessible + symbolToTypeNode + a tracker report — and
        ; printer.go's typeToString SETS that flag, so the fork is not taken and
        ; what is left is `NewTypeOperatorNode(unique, symbol)`. This is the same
        ; collapse create_anonymous_type_node's header proves for its five flags,
        ; and it expires the same day a second entry point appears.
        if (t.flags & TypeFlagsUniqueESSymbol) <> 0
        {
            this.add_approximate_length(13)
            out.append("unique symbol")
            set wrote_type_precedence: TypePrecedenceTypeOperator
            return true
        }
        if (t.flags & TypeFlagsVoid) <> 0
        {
            this.add_approximate_length(4)
            return Checker.write_keyword(out, "void")
        }
        if (t.flags & TypeFlagsUndefined) <> 0
        {
            this.add_approximate_length(9)
            return Checker.write_keyword(out, "undefined")
        }
        if (t.flags & TypeFlagsNull) <> 0
        {
            this.add_approximate_length(4)
            return Checker.write_keyword(out, "null")
        }
        if (t.flags & TypeFlagsNever) <> 0
        {
            this.add_approximate_length(5)
            return Checker.write_keyword(out, "never")
        }
        if (t.flags & TypeFlagsESSymbol) <> 0
        {
            this.add_approximate_length(6)
            return Checker.write_keyword(out, "symbol")
        }
        if (t.flags & TypeFlagsNonPrimitive) <> 0
        {
            this.add_approximate_length(6)
            return Checker.write_keyword(out, "object")
        }
        ; `isThisTypeParameter(t)` → a ThisTypeNode, i.e. the keyword `this`.
        ;
        ; ★★★ IT WAS A SILENT WRONG ANSWER UNTIL SLICE 109, and the reason it could
        ; be is that the this-type's SYMBOL IS THE CLASS'S: createTypeParameter is
        ; handed the class symbol, so the type-parameter arm below names the class
        ; and the name it produces is well formed. Measured at stage 2 the day the
        ; chain landed: three units printed `CCC`, `CCCC` and `greeter` where the
        ; reference prints `this`, all of them `this.y = …` in a constructor.
        ;
        ; ★★ WHY NO EARLIER SLICE COULD SEE IT: `this` is an EXPRESSION, so the only
        ; door to it is getTypeOfNode's IsExpressionNode arm — which did not exist
        ; until this slice. The flag it needs has been set since slice 97 and
        ; `is_this_type_of` was its one reader; this is the second.
        ;
        ; ★ The two FlagsInObjectTypeLiteral branches around it are unreachable:
        ; typeToString does not set that flag.
        if Checker.is_this_type_parameter(t)
        {
            this.add_approximate_length(4)
            return Checker.write_keyword(out, "this")
        }
        ; ── slice 111: the type ALIAS, at the reference's own position ───────
        ;
        ; `inTypeAlias == 0 && t.alias != nil && (flags&UseAliasDefinedOutsideCurrentScope != 0 || IsTypeSymbolAccessible(…))`
        ; — and typeToString SETS that flag, so the second conjunct is true and no
        ; accessibility question is asked. `shouldExpandType` under it is false at
        ; its first line (maxExpansionDepth −1), so the arm always returns.
        ;
        ; ★★★ IT SITS HERE, AFTER THE KEYWORDS AND BEFORE THE OBJECT DISPATCH, AND
        ; THE POSITION IS THE REFERENCE'S. That is why `type S = string` prints
        ; `string` and not `S`: an alias over a primitive names the SHARED intrinsic
        ; type, which no producer can hang an alias on, so the keyword arms above
        ; have already answered. Only a type minted FOR the alias's right-hand side
        ; carries the slot — measured against the reference in both directions.
        ;
        ; ★★ `inTypeAlias` IS ALWAYS ZERO HERE. The flag is set only by
        ; `typeToTypeNodeHelperWithPossibleReusableTypeNode`'s caller inside the
        ; alias-expansion path, which `shouldExpandType`'s false closes; and
        ; typeToTypeNode clears it on entry regardless.
        if t.alias_symbol <> null
        {
            let asym t.alias_symbol as ref[Symbol]
            ; `isReservedMemberName(sym.Name) && sym.Flags&Class == 0` answers an
            ; EMPTY identifier plus the type arguments — a name that prints as
            ; nothing followed by `<…>`. The alias symbols this port can reach are
            ; type-alias declarations, whose names are never reserved-member names,
            ; so the fork is written as the reference's test and never taken.
            if Checker.is_reserved_member_name(Symbol.name_of(asym))
            {
                if (Symbol.flags_of(asym) & SymbolFlagsClass) = 0
                {
                    this.record_unported("type-to-string-reserved-alias-name", 0)
                    return false
                }
            }
            ; `len(typeArgumentNodes) == 1 && sym == globalArrayType.symbol` → the
            ; ARRAY shorthand `T[]`, CODE SINCE SLICE 115 — the note that stood here
            ; said *"the shorthand is a shape this function does not build"*, and
            ; write_array_type_reference builds it now.
            ;
            ; ★ It is `globalArrayType` ALONE and not ReadonlyArray, which is why
            ; `target_symbol_is_global_array` exists beside
            ; `target_is_global_array_type`: an alias whose right-hand side is a
            ; READONLY array prints its alias NAME, not `readonly T[]`.
            var na 0
            if t.alias_type_arguments <> null
                set na: (t.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() as int
            if na = 1
            {
                if this.target_symbol_is_global_array(asym)
                {
                    let args t.alias_type_arguments as ref[Array[ref[Type]?]]
                    if this.write_postfix_type_operand(args[0], out) = false
                        return false
                    out.append("[]")
                    set wrote_type_precedence: TypePrecedencePostfix
                    return true
                }
            }
            if this.symbol_to_type_node(asym, SymbolFlagsType, out) = false
                return false
            if na = 0
                return true
            ; The arguments below clear the name symbol_to_type_node just recorded,
            ; so it is carried across them — type_reference_to_type_node's note.
            let alias_ref_name wrote_type_reference_name
            ; mapToTypeNodes over the alias's own type arguments — the printer's
            ; `<A, B>`.
            let args t.alias_type_arguments as ref[Array[ref[Type]?]]
            if this.write_type_argument_list(args, out) = false
                return false
            set wrote_type_precedence: TypePrecedenceNonArray
            set wrote_type_reference_name: alias_ref_name
            set wrote_name_depth: printer_depth
            return true
        }
        ; ★★★ THE UNION ARM, SLICE 94 — the first arm of this printer that composes
        ; a name out of OTHER NAMES, and the point at which the two halves of the
        ; checker dimension stop being cut at the same place. This table's own
        ; header draws the boundary at *"an arm here whose result the T section
        ; cannot print would move a unit from an honest UNPORTED to a FAIL"*, and
        ; the union chapter is the first one that had to bring the printer with it:
        ; minting `string | undefined` without being able to NAME it moves a unit's
        ; stop from `get-union-type` to `type-to-string` and buys nothing at all.
        ;
        ; ★★ IT IS THREE STEPS OF nodebuilderimpl AND NOT ONE. The origin
        ; substitution in front of the arm is the identity here (origin has no
        ; writer — UnionTypeData's header); formatUnionTypes is the real
        ; transformation and is written; and `len(types) == 1` after it recurses on
        ; the single constituent rather than printing a one-member union, which is
        ; how `boolean | undefined` comes out in the reference's order.
        ;
        ; ★★★ THE PARENTHESIZATION IS LIVE SINCE SLICE 111, AND THE NOTE THAT STOOD
        ; HERE IS THE EXPIRY §3.5p WARNS ABOUT. It read *"the printer's
        ; parenthesization is the IDENTITY for every type this port can name … the
        ; only constituents reachable here are the keyword and literal arms above"*
        ; — a containment proof over what was PORTED, not over the language, and the
        ; object arm below invalidated it the moment it landed. Measured, not
        ; reasoned: `fixtures_binder_class_optional` printed
        ; `() => void | undefined` where the reference prints
        ; `(() => void) | undefined`, which is a DIFFERENT TYPE and not a formatting
        ; slip.
        ;
        ; ★★ THE RULE IS PRECEDENCE AND NOT A LIST OF KINDS. `emitUnionType` emits
        ; each constituent through `emitTypeNode(node, TypePrecedenceTypeOperator)`,
        ; which wraps when `GetTypeNodePrecedence(node) < prec`; of everything this
        ; printer can build only FunctionType and ConstructorType are below it. See
        ; `wrote_type_precedence` for why the WRITER answers that and not a
        ; predicate over the type.
        ;
        ; ★ The scratch builder is taken only for an ANONYMOUS OBJECT constituent,
        ; which is exactly the set that can need it — every other arm's node is at
        ; TypeOperator or above, so the common constituent still writes straight
        ; through. The separator is the emitter's ` | `.
        ; ★★★ THE ORIGIN SUBSTITUTION, LIVE SINCE SLICE 121. `if t.flags&Union != 0
        ; && t.AsUnionType().origin != nil { t = t.AsUnionType().origin }` — one line
        ; upstream, and until this slice it was the IDENTITY because origin had no
        ; writer. The cross-product branch of getIntersectionTypeEx is that writer,
        ; and what the line buys is exactly what the origin is for: `X & (A | B)`
        ; prints as itself rather than as the four-way union it reduces to.
        ;
        ; ★★★ AND UPSTREAM'S LINE IS A REBIND, NOT A LOCAL — SLICE 173. `t =
        ; t.AsUnionType().origin` replaces the SUBJECT of every arm below it, and
        ; this port read `subject` in the two arms it was written for and `t` in the
        ; eight after them. That is invisible while the only origin is an
        ; intersection, because the intersection arm consumes it — and it is a
        ; DROPPED ANSWER the moment a third writer appears with a different flag:
        ; `getLiteralTypeFromProperties` gives `keyof X` a union whose origin is an
        ; INDEX type, so the union arm passed it on, the Index arm asked `t` (still
        ; the union) and the walk fell off the end of the function. `keyof AB` —
        ; three tokens — recorded `type-to-string 134217728` for it.
        ;
        ; ★ The one test that stays on `t` is the ANONYMOUS/MAPPED one, and it is
        ; the reference's own asymmetry: `objectFlags` is captured BEFORE the rebind
        ; and the node is built from the rebound type. The two can only disagree for
        ; a union carrying ObjectFlagsAnonymous, which `newUnionType` never mints.
        var subject: ref[Type] t as ref[Type]
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let origin Checker.union_origin_of(t)
            if origin <> null
                set subject: origin as ref[Type]
        }
        ; ── slice 121: the INTERSECTION arm ─────────────────────────────────
        ;
        ; The reference shares one arm with the union and picks the constituent
        ; list off the tag; the two are written apart here because the union's runs
        ; formatUnionTypes over its list and the intersection takes its own
        ; unchanged.
        ;
        ; ★★★ THE CONSTITUENT WRITER IS NOT THE UNION'S. write_union_constituent
        ; takes the parenthesising path only for an ANONYMOUS OBJECT, and until
        ; slice 135 the reason given was *a union is never a constituent of a
        ; union*. A DENORMALIZED origin's constituents ARE unions, so the sentence
        ; is false and the conclusion survives on a narrower one: every
        ; constituent addNamedUnions puts into an origin is a NAMED union — it
        ; carries an alias, or an origin that is not a union — so it prints as a
        ; NAME and its node's precedence is a reference's, above TypeOperator.
        ; An intersection HAS union constituents — that is what the origin above
        ; exists for — and `X & (A | B)` without the parentheses is a different
        ; type. So this arm asks the precedence of every constituent.
        if (subject.flags & TypeFlagsIntersection) <> 0
        {
            let its Checker.intersection_types_of(subject)
            if its = null
            {
                this.record_unported("type-to-string", subject.flags)
                return false
            }
            let ilist its as ref[Array[ref[Type]?]]
            let inum ilist.get_length() as int
            if inum = 1
                return this.type_to_string(ilist[0], out)
            if inum = 0
            {
                this.record_unported("type-to-string-empty-intersection", subject.flags)
                return false
            }
            if this.write_constituent_list(ilist, inum, " & ", 2, out) = false
                return false
            set wrote_type_precedence: TypePrecedenceIntersection
            return true
        }
        if (subject.flags & TypeFlagsUnion) <> 0
        {
            let ts Checker.union_types_of(subject)
            if ts = null
            {
                this.record_unported("type-to-string", subject.flags)
                return false
            }
            let formatted this.format_union_types(ts as ref[Array[ref[Type]?]])
            if formatted = null
                return false
            let list formatted as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            if n = 1
                return this.type_to_string(list[0], out)
            if n = 0
            {
                ; `typeNodes` empty — upstream this sets encounteredError and
                ; answers nil, i.e. no name at all.
                this.record_unported("type-to-string-empty-union", t.flags)
                return false
            }
            if this.write_constituent_list(list, n, " | ", 1, out) = false
                return false
            ; ★★★ A UnionTypeNode IS TypePrecedenceUnion, and this line said
            ; `false` — *no parens* — until slice 115. Nothing read it wrongly while
            ; the only reader was the union arm itself (a union is never a
            ; constituent of a union: format_union_types flattens), and the array
            ; element is the first reader that asks a HIGHER question.
            set wrote_type_precedence: TypePrecedenceUnion
            return true
        }
        ; ── slice 95: the three arms that NAME a type ───────────────────────
        ;
        ; ★★★ THE WHOLE SYMBOL-CHAIN MACHINERY COLLAPSES HERE, AND IT IS A
        ; CONTAINMENT PROOF RATHER THAN A SHORTCUT. `symbolToTypeNode` opens with
        ; `lookupSymbolChain`, whose worker asks `!isTypeParameter &&
        ; (enclosingDeclaration != nil || flags&UseFullyQualifiedType != 0)` — and
        ; `Checker.TypeToString(t)`, which is the ONLY entry point the oracle uses,
        ; is `typeToString(t, nil)`: the enclosing declaration is nil and the flag
        ; is not in `AllowUniqueESSymbolType|UseAliasDefinedOutsideCurrentScope`.
        ; So the else branch runs for EVERY symbol, the chain is one element long,
        ; and `createAccessFromSymbolChain(chain, 0, 0, args)` has index == 0:
        ; the export-alias lookup needs a parent, the indexed-access fork needs a
        ; parent, and `index > stopper` is `0 > 0`. What is left is
        ; `getNameOfSymbolAsWritten` and the type-argument list. ★★★**Every one of
        ; those four collapses is a property of ONE argument — the nil enclosing
        ; declaration — so the day a second entry point appears, all four expire
        ; together.** They are written here as one sentence for that reason rather
        ; than four times at four sites.
        ;
        ; ★★ THE `default` FORK IN getNameOfSymbolAsWritten IS DEAD FOR THE SAME
        ; REASON, one flag over: its first conjunct is
        ; `flags&UseAliasDefinedOutsideCurrentScope == 0` and typeToString SETS
        ; that flag. So an export-default symbol prints its declaration's name here
        ; and not the word `default`.
        ;
        ; ★★★ THE REFERENCE ARM COMES FIRST BECAUSE THE REFERENCE PUTS IT FIRST,
        ; and the order is load-bearing rather than stylistic: a type reference to
        ; a generic class carries ObjectFlagsReference AND its target carries
        ; ObjectFlagsClassOrInterface, so testing the class arm first would print
        ; `Foo` where the reference prints `Foo<string>`.
        if (t.object_flags & ObjectFlagsReference) <> 0
            return this.type_reference_to_type_node(t, out)
        ; `t.flags&TypeParameter != 0 && slices.Contains(ctx.inferTypeParameters, t)`
        ; — the InferTypeNode, and it comes BEFORE the name for the reason the
        ; reference arm above comes before the class arm: an infer parameter is a
        ; type parameter, so testing the name first would print `P` where the
        ; reference prints `infer P`.
        if (t.flags & TypeFlagsTypeParameter) <> 0
        {
            if this.printer_infer_declares(t)
                return this.write_infer_type(t, out)
        }
        var names_a_symbol false
        if (t.flags & TypeFlagsTypeParameter) <> 0
            set names_a_symbol: true
        if (t.object_flags & ObjectFlagsClassOrInterface) <> 0
            set names_a_symbol: true
        if names_a_symbol
        {
            ; The two forks in front of the name — the infer-type parameter and
            ; the shadowed-name generator — are behind context this entry point
            ; does not set: `inferTypeParameters` is empty and
            ; `GenerateNamesForShadowedTypeParams` is not in the mask. What is left
            ; is `t.symbol != nil`, and the marker fork and `?` fallback under it.
            ;
            ; ★★★ THE THIRD FORK WAS ON THAT LIST UNTIL SLICE 173 AND ITS REASON
            ; WAS *the two marker types have no writer here* — a sentence about a
            ; FIELD, and the field got its writer in the same slice this arm
            ; landed in. checkTypeParameterDeferred's TS2636 comparison is the one
            ; place `variance_type_parameter` is set, and it is set exactly while
            ; the two ForCheck markers are the type arguments being compared.
            ;
            ; ★★★ AND IT HAS NO INPUT, WHICH IS MEASURED AND NOT ASSUMED: a
            ; `record_unported` planted in the arm was hit by **0 of 18 446**
            ; units. The reason is §3.20/§3.24 — this port formats no diagnostic
            ; ARGUMENTS, so the only route from a comparison to this printer is
            ; report_relation_error's same-name test, which asks nothing once
            ; `rel_head_code` is set, and TS2636 sets it. The arm is written for
            ; the elision loop's reason two files over: an arm that must name and
            ; does not is a WRONG NAME (`?` twice, for two types the reference
            ; tells apart), and the day a diagnostic carries its arguments the
            ; fork is not a line anybody would think to add.
            if t.symbol = null
            {
                ; `name = core.IfElse(t == markerSubTypeForCheck, "sub-", "super-")
                ; + SymbolName(varianceTypeParameter.symbol)` — the two anonymous
                ; type parameters TS2636 compares, named after the parameter whose
                ; annotation is under test, so the message reads `sub-T` and
                ; `super-T` rather than `?` twice.
                ;
                ; ★ It is `ast.SymbolName` and not the node builder's naming: for a
                ; type parameter's symbol those two agree — the private-identifier
                ; fork needs a class element — so the raw name is the reference's
                ; answer and not an approximation of it.
                if variance_type_parameter <> null
                {
                    let vtp variance_type_parameter as ref[Type]
                    if vtp.symbol <> null
                    {
                        var marked false
                        if marker_sub_type_for_check <> null
                        {
                            if t = (marker_sub_type_for_check as ref[Type])
                            {
                                out.append("sub-")
                                set marked: true
                            }
                        }
                        if marked = false
                        {
                            if marker_super_type_for_check <> null
                            {
                                if t = (marker_super_type_for_check as ref[Type])
                                {
                                    out.append("super-")
                                    set marked: true
                                }
                            }
                        }
                        if marked
                        {
                            let nm Symbol.name_of(vtp.symbol as ref[Symbol])
                            out.append(nm.data, nm.length)
                            return true
                        }
                    }
                }
                ; `name = "?"` — the anonymous type parameter. It is a NAME and not
                ; a failure, so it is written rather than reported.
                out.append("?" as char)
                return true
            }
            ; `return b.symbolToTypeNode(t.symbol, SymbolFlagsType, nil)` — the
            ; CHAIN, not the bare name. This arm wrote the name directly until
            ; slice 183, for the same reason type_reference_to_type_node did and
            ; with the same expiry: `Foo.Yep | Bar.Yep` printed `Yep | Yep`
            ; because an INTERFACE reaches the printer here and nowhere else.
            return this.symbol_to_type_node(t.symbol as ref[Symbol], SymbolFlagsType, out)
        }
        ; ── slice 111: the anonymous object type ────────────────────────────
        ;
        ; `objectFlags&(Anonymous|Mapped) != 0` — the worker's own arm, and the
        ; assertion under it (`t.Flags()&TypeFlagsObject != 0`) is why it can sit
        ; here rather than in front of the union: an anonymous type is an object
        ; type, so it is disjoint from every arm above.
        ;
        ; ★ THE MAPPED HALF IS WRITTEN SINCE SLICE 125 — the note that stood here
        ; said *this port cannot resolve a mapped type's members either*, which was
        ; the same sentence resolve_structured_type_members carried and is that
        ; slice's chapter.
        ;
        ; ★★★ AND THE MAPPED HALF IS NOT AN ARM OF ITS OWN — IT IS THE SAME ARM.
        ; Upstream's test here is `objectFlags&(Anonymous|Mapped) != 0 ->
        ; createAnonymousTypeNode`, and the choice between the `{ [K in …]: … }`
        ; SOURCE FORM and the resolved members is made three functions down, in
        ; createTypeNodeFromObjectType, by `isGenericMappedType(t) || (Mapped &&
        ; containsError)`. Splitting it out here sent every mapped type to the
        ; source form and past the symbol/typeof/visited bracket the anonymous
        ; route owns — so `type A = { [K in "x"]: any }` printed as its own text
        ; where the reference prints `{ x: any; }`.
        ; ★The precedence is NOT set here and setting it was worth six units: the
        ; anonymous route writes a FUNCTION or CONSTRUCTOR type as readily as a
        ; brace form, and those two are the lowest precedence there is —
        ; `(() => void)[]` came out as `() => void[]`. The writer answers.
        if (t.object_flags & (ObjectFlagsAnonymous | ObjectFlagsMapped)) <> 0
            return this.create_anonymous_type_node(subject, out)
        ; ── slice 121: the four instantiable printer arms ───────────────────
        ;
        ; ★ THE POSITION IS THE REFERENCE'S: all four sit AFTER the anonymous
        ; object arm, which is why an Index over an object type prints as
        ; `keyof { … }` and not the other way round.
        ;
        ; A TypeOperatorNode is TypePrecedenceTypeOperator, and its operand is
        ; emitted at TypePrecedencePostfix — one step higher — so a union or a
        ; function type under a `keyof` needs the parentheses.
        if (subject.flags & TypeFlagsIndex) <> 0
        {
            let target Checker.index_target_of(subject)
            if target = null
            {
                this.record_unported("type-to-string-index", subject.flags)
                return false
            }
            this.add_approximate_length(6)
            out.append("keyof ")
            if this.write_operand_at_postfix_precedence(target, out) = false
                return false
            set wrote_type_precedence: TypePrecedenceTypeOperator
            return true
        }
        if (subject.flags & TypeFlagsIndexedAccess) <> 0
        {
            let ot Checker.indexed_access_object_type_of(subject)
            let it Checker.indexed_access_index_type_of(subject)
            if ot = null
            {
                this.record_unported("type-to-string-indexed-access", subject.flags)
                return false
            }
            if it = null
            {
                this.record_unported("type-to-string-indexed-access", subject.flags)
                return false
            }
            ; An IndexedAccessTypeNode's OBJECT is emitted at TypePrecedencePostfix
            ; and its INDEX inside brackets, where nothing needs parenthesising.
            if this.write_operand_at_postfix_precedence(ot, out) = false
                return false
            out.append("[" as char)
            if this.type_to_string(it, out) = false
                return false
            out.append("]" as char)
            this.add_approximate_length(2)
            set wrote_type_precedence: TypePrecedencePostfix
            return true
        }
        ; A ConditionalTypeNode is TypePrecedenceConditional — the LOWEST — and the
        ; emitter emits its check type at TypePrecedenceUnion, its extends type at
        ; TypePrecedenceUnion, and the two branches at no precedence at all
        ; (`? X : Y` needs no parentheses, being right-delimited).
        ; ★★★ THE BRACKET IS THE THIRD SHAPE OF upstream's visitAndTransformType
        ; AND IT ARRIVED IN SLICE 173 — see PrinterSymbolFrame for the sentence
        ; that said this arm was not one of its call sites, and for the stack
        ; overflow that sentence cost. `conditionalTypeToTypeNode` is wrapped
        ; upstream, keyed on the ROOT'S NODE, so a conditional whose branch names
        ; the same alias again is expanded eleven times and then elided.
        if (subject.flags & TypeFlagsConditional) <> 0
        {
            let root Checker.conditional_root_of(subject)
            if root = null
            {
                this.record_unported("type-to-string-conditional", subject.flags)
                return false
            }
            let rnode (root as ref[ConditionalRoot]).node
            if this.printer_node_visits(rnode) > 10
                return this.write_elided_placeholder(out)
            this.push_printer_node(rnode)
            let ok this.write_conditional_type(subject, root as ref[ConditionalRoot], out)
            this.pop_printer_symbol()
            return ok
        }
        if (subject.flags & TypeFlagsTemplateLiteral) <> 0
            return this.write_template_literal_type(subject, out)
        if (subject.flags & TypeFlagsStringMapping) <> 0
        {
            let target Checker.string_mapping_target_of(subject)
            if target = null
            {
                this.record_unported("type-to-string-string-mapping", subject.flags)
                return false
            }
            if subject.symbol = null
            {
                this.record_unported("type-to-string-string-mapping", subject.flags)
                return false
            }
            ; `symbolToTypeNode(t.symbol, Type, [typeNode])` — the intrinsic's own
            ; name with the target as its single type argument.
            let sm_start out.get_length() as int
            if this.write_symbol_name(subject.symbol as ref[Symbol], out) = false
                return false
            this.add_approximate_length(((out.get_length() as int) - sm_start) + 1)
            out.append("<" as char)
            this.add_approximate_length(2)
            if this.type_to_string(target, out) = false
                return false
            out.append(">" as char)
            set wrote_type_precedence: TypePrecedenceNonArray
            return true
        }
        ; ── slice 173: the SUBSTITUTION arm ─────────────────────────────────
        ;
        ; ★★★ A SUBSTITUTION PRINTS AS ITS BASE, AND THE ONE EXCEPTION IS A NAME
        ; THE LIB OWNS. `T extends U ? …` substitutes the true branch's `T` with a
        ; type known to satisfy `U`, and that substitution is an INTERNAL record —
        ; the reference prints the base and says nothing about the constraint. The
        ; exception is `NoInfer<T>`, which is the same record with an `unknown`
        ; constraint (`is_no_infer_type`, and it asks the CONSTRAINT rather than the
        ; flag for exactly this reason), and which the reference prints back under
        ; the lib alias's own name.
        ;
        ; ★★ THE ALIAS IS LOOKED UP AND MAY BE ABSENT, AND UPSTREAM'S ANSWER TO
        ; THAT IS THE BASE. A lib without `NoInfer` is not an error here — the
        ; reference falls back to the same node the non-NoInfer arm returns — so
        ; only a MOVED MARK reports: a lookup that stopped did not establish that
        ; the alias is absent, and printing the base on the strength of it would be
        ; a name this port never computed.
        ;
        ; ★ Upstream builds the base's node FIRST and wraps it afterwards; a sink
        ; cannot, so the fork is asked before anything is written. The two differ
        ; only in the order two stops would be recorded, and the base arm records
        ; none the wrap arm does not.
        if (subject.flags & TypeFlagsSubstitution) <> 0
        {
            let base Checker.substitution_base_type_of(subject)
            if base = null
            {
                this.record_unported("type-to-string-substitution", subject.flags)
                return false
            }
            if Checker.is_no_infer_type(subject) = false
                return this.type_to_string(base, out)
            let mark this.unported_mark()
            let no_infer this.get_global_type_alias_symbol("NoInfer", 1)
            if this.unported_mark() <> mark
            {
                this.record_unported("type-to-string-substitution", subject.flags)
                return false
            }
            if no_infer = null
                return this.type_to_string(base, out)
            let ni_start out.get_length() as int
            if this.write_symbol_name(no_infer as ref[Symbol], out) = false
                return false
            this.add_approximate_length(((out.get_length() as int) - ni_start) + 1)
            out.append("<" as char)
            this.add_approximate_length(2)
            if this.type_to_string(base, out) = false
                return false
            out.append(">" as char)
            set wrote_type_precedence: TypePrecedenceNonArray
            return true
        }
        ; Everything past this point is the this-type, the alias, and the
        ; intersection machinery — the rest of nodebuilderimpl.
        this.record_unported("type-to-string", subject.flags)
        false
    }

    ; conditionalTypeToTypeNode — the transform the bracket above wraps. It is a
    ; function of its own for exactly that reason: the bracket must pop on every
    ; exit and this body has six.
    ; ★★★ typeToTypeNodeOrCircularityElision (slice 219): a conditional type's
    ; branches are printed through the VISITED set when they are unions — a
    ; union already being printed answers the elision placeholder (`any` under
    ; the harness's noErrorTruncation), an unvisited one is printed through
    ; visitAndTransformType, which ADDS it to the set for the duration (and
    ; counts its symbol's depth where it has one). The recursive conditional of
    ; `arrayFakeFlatNoCrashInferenceDeclarations` has the same union as the
    ; true type of the outer and the inner conditional; the reference prints
    ; the inner as `any`, this port expanded it to the truncation budget. Only
    ; a UNION takes the route — every other branch type prints as before.
    procedure write_type_or_circularity_elision(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.type_to_string(t, out)
        if this.visited_type(t.id)
            return this.write_elided_placeholder(out)
        var pushed_symbol false
        if t.symbol <> null
        {
            let sym t.symbol as ref[Symbol]
            if this.printer_symbol_visits(false, sym) > 10
                return this.write_elided_placeholder(out)
            this.push_printer_symbol(false, sym)
            set pushed_symbol: true
        }
        this.push_visited_type(t.id)
        let ok this.type_to_string(t, out)
        this.pop_visited_type()
        if pushed_symbol
            this.pop_printer_symbol()
        ok
    }

    procedure write_conditional_type(this, subject: ref[Type], root: ref[ConditionalRoot], out: ref[StringBuilder]) returns bool
    {
        ; conditionalTypeToTypeNode's first line: past the budget the whole
        ; conditional is the placeholder, and its branches are not resolved
        if this.check_truncation_length()
            return this.write_elided_placeholder(out)
        let ct Checker.conditional_check_type_of(subject)
        let et Checker.conditional_extends_type_of(subject)
        if ct = null
        {
            this.record_unported("type-to-string-conditional", subject.flags)
            return false
        }
        if et = null
        {
            this.record_unported("type-to-string-conditional", subject.flags)
            return false
        }
        ; ★★★ THE `infer` KEYWORD IN THE EXTENDS CLAUSE, AND THE STOP THAT STOOD
        ; HERE NAMED THE MISSING MECHANISM EXACTLY: *this printer has no context
        ; to carry the list in, so a type parameter of the root prints as its bare
        ; NAME.* Upstream's typeToTypeNodeHelper puts the root's
        ; inferTypeParameters into the node-builder CONTEXT for the extends
        ; operand alone and emits an InferTypeNode for any type parameter it finds
        ; there; the context is `printer_infer_type_parameters`, saved and restored
        ; around this one call, and the arm that reads it is the type-parameter arm
        ; of type_to_string_worker.
        ;
        ; ★The list is the ROOT'S OWN and not *any type parameter in sight*: a
        ; conditional with no infer parameter (`T extends string ? 1 : 2`) reaches
        ; the same writer and must print unchanged.
        ;
        ; ★★★ AND THE SECOND HALF OF THE OLD NOTE — *WITHOUT the parentheses this
        ; writer adds around a function type* — WAS NEVER INSIDE THIS GUARD. The
        ; parentheses came from emitting the extends operand at UNION precedence,
        ; which wraps a function type whether or not an `infer` is anywhere near
        ; it, and `thislessFunctionsNotContextSensitive3` — no infer at all —
        ; printed `extends ((...args: any) => any)` for it; fixed at
        ; write_operand_in_extends two slices before this one.
        if this.write_operand_at_union_precedence(ct, out) = false
            return false
        this.add_approximate_length(15)
        out.append(" extends ")
        let saved_infers printer_infer_type_parameters
        set this.printer_infer_type_parameters: root.infer_type_parameters
        let extends_ok this.write_operand_in_extends(et, out)
        set this.printer_infer_type_parameters: saved_infers
        if extends_ok = false
            return false
        out.append(" ? ")
        let tt this.get_true_type_from_conditional_type(subject)
        if tt = null
            return false
        if this.write_type_or_circularity_elision(tt as ref[Type], out) = false
            return false
        out.append(" : ")
        let ft this.get_false_type_from_conditional_type(subject)
        if ft = null
            return false
        if this.write_type_or_circularity_elision(ft as ref[Type], out) = false
            return false
        set wrote_type_precedence: TypePrecedenceConditional
        return true
    }

    ; One constituent of a union, with the printer's parenthesis rule.
    ;
    ; ★★★ THE PRE-TEST IS WHAT KEEPS THIS CHEAP AND IT IS EXACT RATHER THAN
    ; CONSERVATIVE: only an ANONYMOUS object type can reach the two arms that build
    ; a below-TypeOperator node, so every other constituent is written straight into
    ; the sink and allocates nothing. A `typeof X` reached through the anonymous arm
    ; takes the scratch and needs no parens — TypeQuery is AT TypeOperator — which
    ; costs one copy and keeps the test a property of the TYPE rather than of the
    ; routing.
    procedure write_union_constituent(this, ct: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        if ct = null
            return this.type_to_string(ct, out)
        let c ct as ref[Type]
        var may_need_parens false
        if (c.flags & TypeFlagsObject) <> 0
        {
            if (c.object_flags & ObjectFlagsAnonymous) <> 0
                set may_need_parens: true
        }
        ; ★★★ AN INTERSECTION CONSTITUENT IS THE SECOND FAMILY BELOW TypeOperator,
        ; AND SLICE 135 IS WHERE ONE BECAME REACHABLE. removeSubtypes let a union
        ; keep an intersection constituent, and `(T & {}) | null` came out
        ; `T & {} | null` (voidUndefinedReduction) — a DIFFERENT type, the same
        ; class of defect the anonymous-object filter above was added for.
        if (c.flags & TypeFlagsIntersection) <> 0
            set may_need_parens: true
        ; ★★★ A CONDITIONAL CONSTITUENT IS THE THIRD FAMILY BELOW TypeOperator, AND
        ; SLICE 177 IS WHERE ONE BECAME REACHABLE — the same shape slice 135's note
        ; one line up records, one family over. Until the conditional printer could
        ; write an `infer` keyword, every union carrying a conditional constituent
        ; stopped before this test; with the keyword written,
        ; `T | (T extends readonly (infer I)[] ? … : T)` came out without its
        ; parentheses, which is a DIFFERENT type and not a cosmetic difference.
        if (c.flags & TypeFlagsConditional) <> 0
            set may_need_parens: true
        ; ★★★ A UNION CARRYING AN ORIGIN IS THE FOURTH FAMILY, AND THE PRE-TEST
        ; CANNOT ASK ITS OWN FLAGS: type_to_string SUBSTITUTES the origin, so the
        ; node this constituent prints as is the ORIGIN's — an INTERSECTION for
        ; every cross-product origin getIntersectionTypeEx mints. `T & ({} | null)`
        ; IS such a union (the intersection distributes into `(T & {}) | (T & null)`
        ; and keeps the intersection as its origin), so `readonly T[] | (T & ({} |
        ; null))` came out without its parentheses — a different type, and the
        ; third time this pre-test has been too narrow.
        if (c.flags & TypeFlagsUnion) <> 0
        {
            if Checker.union_origin_of(c) <> null
                set may_need_parens: true
        }
        if may_need_parens = false
            return this.type_to_string(ct, out)
        let scratch StringBuilder^host()
        if this.type_to_string(ct, &scratch) = false
            return false
        let parens wrote_type_precedence < TypePrecedenceTypeOperator
        if parens
            out.append("(" as char)
        out.append(scratch.to_string())
        if parens
            out.append(")" as char)
        true
    }

    ; The TEMPLATE LITERAL type's name — `` `a${T}b` `` — out of the interleaved
    ; texts and types. ★`texts` is always exactly one longer than `types` and
    ; `types` holds at least one element, which is what makes the walk a single
    ; loop with the head written first; both are the reference's invariants and
    ; TemplateLiteralTypeData's header records them.
    ;
    ; ★ Nothing inside `${…}` needs parenthesising — a TemplateLiteralTypeSpan's
    ; type is emitted at no precedence at all — so the constituents write straight
    ; through.
    procedure write_template_literal_type(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        let texts Checker.template_literal_texts_of(t)
        let types Checker.template_literal_types_of(t)
        if texts = null
        {
            this.record_unported("type-to-string-template-literal", t.flags)
            return false
        }
        if types = null
        {
            this.record_unported("type-to-string-template-literal", t.flags)
            return false
        }
        let tx texts as ref[Array[ref[String]?]]
        let ty types as ref[Array[ref[Type]?]]
        let n ty.get_length() as int
        if (tx.get_length() as int) <> (n + 1)
        {
            this.record_unported("type-to-string-template-literal", t.flags)
            return false
        }
        ; ★★★ THE TEXTS ARE ESCAPED AND NOT COPIED. getLiteralText builds the
        ; head/middle/tail out of the SYNTHESIZED node's `text` — there is no raw
        ; text on a type's spans — so escapeStringWorker runs over each of them
        ; with a BACKTICK delimiter. Copied through, a tab inside a template
        ; literal type printed as a tab where the reference prints `\t`.
        out.append("\`" as char)
        let head tx[0]
        if head <> null
            Checker.write_template_text(out, head as ref[String])
        var i 0
        while i < n
        {
            out.append("${")
            if this.type_to_string(ty[i], out) = false
                return false
            out.append("}" as char)
            let tail tx[i + 1]
            if tail <> null
                Checker.write_template_text(out, tail as ref[String])
            set i: i + 1
        }
        out.append("\`" as char)
        this.add_approximate_length(2)
        set wrote_type_precedence: TypePrecedenceNonArray
        true
    }

    ; `slices.Contains(b.ctx.inferTypeParameters, t)` — by IDENTITY, which is the
    ; only equality a type parameter has.
    function printer_infer_declares(this, t: ref[Type]) returns bool
    {
        if printer_infer_type_parameters = null
            return false
        let list printer_infer_type_parameters as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            if list[i] = t
                return true
            set i: i + 1
        }
        false
    }

    ; The InferTypeNode — `infer P`, and `infer P extends C` when the DECLARED
    ; constraint is not the one the position would have inferred anyway.
    ;
    ; ★★★ THE CONSTRAINT TEST IS THE WHOLE OF THE ARM AND IT ASKS
    ; getInferredTypeParameterConstraint WITH `omitTypeReferences` TRUE — the
    ; parameter whose note in that function read *its only caller passes false*,
    ; which was true until this arm. With the flag on, `Foo<infer T>` does NOT
    ; take its constraint from Foo's own parameter, so a constraint that came only
    ; from the position is not printed back: upstream's comment says exactly that —
    ; *we omit inferred constraints from type references as they may be elided*.
    ;
    ; ★ A parameter with NO declared constraint prints as the bare keyword and
    ; asks nothing, which is every `infer P` in an ordinary conditional.
    procedure write_infer_type(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        let infer_start out.get_length() as int
        out.append("infer ")
        if this.write_symbol_name_or_question(t, out) = false
            return false
        this.add_approximate_length((out.get_length() as int) - infer_start)
        let mark this.unported_mark()
        let constraint this.get_constraint_of_type_parameter(t)
        if this.unported_mark() <> mark
            return false
        if constraint <> null
        {
            let inferred this.get_inferred_type_parameter_constraint_ex(t, true)
            if this.unported_mark() <> mark
                return false
            var elide false
            if inferred <> null
            {
                if this.is_type_identical_to(constraint as ref[Type], inferred as ref[Type])
                    set elide: true
                if this.unported_mark() <> mark
                    return false
            }
            if elide = false
            {
                this.add_approximate_length(9)
                out.append(" extends ")
                if this.type_to_string(constraint, out) = false
                    return false
            }
        }
        ; An InferTypeNode is emitted at the same precedence a type operator is —
        ; `infer P extends C` needs a parenthesis wherever `keyof C` would.
        set wrote_type_precedence: TypePrecedenceTypeOperator
        true
    }

    ; The name half of the type-parameter arm, shared by the infer node and the
    ; ordinary one: a type parameter with no symbol prints `?`.
    procedure write_symbol_name_or_question(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        if t.symbol = null
        {
            out.append("?" as char)
            return true
        }
        this.write_symbol_name(t.symbol as ref[Symbol], out)
    }

    ; An operand emitted at TypePrecedenceUnion — the conditional's check and
    ; extends positions.
    procedure write_operand_at_union_precedence(this, ct: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        if ct = null
            return this.type_to_string(ct, out)
        let scratch StringBuilder^host()
        if this.type_to_string(ct, &scratch) = false
            return false
        let parens wrote_type_precedence < TypePrecedenceUnion
        if parens
            out.append("(" as char)
        out.append(scratch.to_string())
        if parens
            out.append(")" as char)
        true
    }

    ; The EXTENDS operand of a conditional, and it is NOT the check type's
    ; precedence — slice 173.
    ;
    ; ★★★ UPSTREAM EMITS IT AT `TypePrecedenceLowest` WITH `inExtends` SET, AND
    ; THE FLAG IMMEDIATELY RAISES IT TO `TypePrecedenceFunction`: *in the extends
    ; clause of a ConditionalType or InferType, a ConditionalType must be
    ; parenthesized* — and only a conditional, because Function is the lowest
    ; precedence above it. The port emitted both operands at Union, which wraps a
    ; FUNCTION type as well, so `Required<T>[P] extends (...args: any) => any ? …`
    ; came out with a surplus pair. It is a different type only to a reader, but
    ; it is a different STRING, and the yardstick compares strings.
    ;
    ; ★★ THE STICKINESS IS NOT CARRIED. `inExtends` stays set while the emitter
    ; descends INTO the extends operand until a paren resets it, so a conditional
    ; buried in a union inside an extends clause is parenthesised too. That needs
    ; the flag threaded through the union and intersection constituent writers;
    ; nothing in either corpus reaches it, and the day it does the tell is a
    ; MISSING pair rather than a surplus one.
    procedure write_operand_in_extends(this, ct: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        if ct = null
            return this.type_to_string(ct, out)
        let scratch StringBuilder^host()
        if this.type_to_string(ct, &scratch) = false
            return false
        let parens wrote_type_precedence < TypePrecedenceFunction
        if parens
            out.append("(" as char)
        out.append(scratch.to_string())
        if parens
            out.append(")" as char)
        true
    }

    ; An operand emitted at TypePrecedencePostfix — what a TypeOperatorNode's and
    ; an IndexedAccessTypeNode's object position take. Same shape as the
    ; intersection's constituent writer, one precedence step higher.
    procedure write_operand_at_postfix_precedence(this, ct: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        if ct = null
            return this.type_to_string(ct, out)
        let scratch StringBuilder^host()
        if this.type_to_string(ct, &scratch) = false
            return false
        let parens wrote_type_precedence < TypePrecedencePostfix
        if parens
            out.append("(" as char)
        out.append(scratch.to_string())
        if parens
            out.append(")" as char)
        true
    }

    ; One constituent of an INTERSECTION. emitIntersectionTypeConstituent emits at
    ; TypePrecedenceTypeOperator exactly as the union's does, so the rule is the
    ; same and only the population differs — see the intersection arm's own note.
    procedure write_intersection_constituent(this, ct: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        if ct = null
            return this.type_to_string(ct, out)
        let scratch StringBuilder^host()
        if this.type_to_string(ct, &scratch) = false
            return false
        let parens wrote_type_precedence < TypePrecedenceTypeOperator
        if parens
            out.append("(" as char)
        out.append(scratch.to_string())
        if parens
            out.append(")" as char)
        true
    }

    ; `t.Target() == c.globalArrayType || t.Target() == c.globalReadonlyArrayType`,
    ; asked on the SYMBOL. getGlobalType("Array", 1) is the declared type of the
    ; globals table's `Array` when that symbol is a class or an interface of arity
    ; one, and get_declared_type_of_class_or_interface memoises per symbol — so one
    ; symbol has one declared type and the symbol comparison IS the type
    ; comparison. Asking it this way computes no declared type, which matters
    ; because this runs on every type reference the dump names.
    ;
    ; ★ The arity test is the reference's and it is load-bearing: at a different
    ; arity getGlobalType answers `emptyGenericType`, which no real target equals,
    ; so `interface Array<T, U> {}` is NOT the global array type.
    procedure target_is_global_array_type(this, tgt: ref[Type]) returns bool
    {
        if tgt.symbol = null
            return false
        if Checker.type_parameter_count_of(tgt) <> 1
            return false
        let sym tgt.symbol as ref[Symbol]
        if (Symbol.flags_of(sym) & (SymbolFlagsClass | SymbolFlagsInterface)) = 0
            return false
        let a this.lookup_globals("Array", SymbolFlagsType)
        if a = sym
            return true
        let r this.lookup_globals("ReadonlyArray", SymbolFlagsType)
        r = sym
    }

    ; `sym == c.globalArrayType.symbol`, asked the way target_is_global_array_type
    ; asks it — out of the GLOBALS table, at arity one. ★It differs from that
    ; function in taking the symbol directly and in NOT testing ReadonlyArray: the
    ; alias arm's shorthand is `T[]` off `globalArrayType` alone.
    procedure target_symbol_is_global_array(this, sym: ref[Symbol]) returns bool
    {
        let a this.lookup_globals("Array", SymbolFlagsType)
        a = sym
    }

    ; typeReferenceToTypeNode, and the ONE of its four branches this port can
    ; reach.
    ;
    ; ★★★ TWO BRANCHES ARE UNREACHABLE AND THE THIRD WAS NOT — SLICE 109 REFUTED
    ; THIS FILE'S OWN CLOSURE ARGUMENT. It read *the `globalArrayType` /
    ; `globalReadonlyArrayType` fork needs a lib type, and both are nil here
    ; (§3.11) — and the test is `target == globalArrayType`, so a nil global
    ; against a non-nil target is FALSE and the fork is closed by the comparison
    ; rather than by a guard*. The premise is wrong: `globalArrayType` is
    ; `getGlobalType("Array", 1)`, which resolves out of the GLOBALS TABLE — and
    ; since slice 104 that table carries a script file's own top-level names. A
    ; unit declaring `interface Array<T> {}` therefore HAS a global Array without
    ; any lib, and the reference names its declared type `T[]`.
    ;
    ; ★★ IT WAS INVISIBLE UNTIL THE CHAIN LANDED, AND THAT IS THE POINT: the one
    ; unit of the corpus that does it (`compiler_noLibAndNoUncheckedIndexedAccess`
    ; `DestructuringArray@globals.ts`, `@noLib: true`) used to stop at
    ; `type-of-node` before its dump was ever compared, so a wrong NAME was hidden
    ; behind a missing ANSWER. ★What it printed was `Array<T>` at rc 0 — a
    ; well-formed wrong answer, which is the class this port hunts.
    ;
    ; ★ So the fork REPORTS rather than being ported: `getGlobalType` is eager
    ; upstream with `reportErrors=true` and would owe TS2318 for every one of the
    ; forty globals `initializeChecker` resolves, which is §3.11's chapter and not
    ; a name. The trigger is the reference's own predicate asked on the SYMBOL
    ; instead of the type — `get_declared_type_of_class_or_interface` memoises per
    ; symbol, so the target's symbol being the global `Array`/`ReadonlyArray` at
    ; arity 1 is exactly `target == globalArrayType`, and it costs no declared type.
    ;
    ; `ObjectFlagsTuple` needs a tuple target and nothing in this port
    ; mints one. `WriteClassExpressionAsTypeLiteral` is a flag typeToString does
    ; not set. The fourth branch is the whole of what a type reference is called.
    ;
    ; ★★ THE OUTER-TYPE-PARAMETER GROUPING IS A STOP AND NOT AN OMISSION. Its guard
    ; is a non-empty `OuterTypeParameters()`, which a nested generic produces, and
    ; what it builds is a QUALIFIED name — `Outer<T>.Inner<U>` — through
    ; appendReferenceToType. That is a second name shape, not a variation on this
    ; one.
    ; typeReferenceToTypeNode's ARRAY branch plus the emit printer's ArrayTypeNode
    ; and — for a readonly array — its TypeOperatorNode.
    ;
    ; ★★★ THE ELEMENT IS EMITTED AT TypePrecedencePostfix, WHICH IS ONE LEVEL ABOVE
    ; A UNION CONSTITUENT'S, and that single fact is why `wrote_paren_needing_type`
    ; had to become a precedence VALUE this slice. `(A | null)[]` is what the
    ; reference prints and `A | null[]` is a different type; the corpus has the
    ; former eight times.
    ;
    ; ★ `WriteArrayAsGenericType` is not in typeToString's mask, so the `Array<T>`
    ; fork in front of this is closed and the shorthand is the only shape.
    procedure write_array_type_reference(this, t: ref[Type], tgt: ref[Type], out: ref[StringBuilder]) returns bool
    {
        let mark this.unported_mark()
        let args this.get_type_arguments(t)
        if this.unported_mark() <> mark
            return false
        if args = null
            return false
        let list args as ref[Array[ref[Type]?]]
        if list.get_length() = 0
            return false
        let readonly this.is_readonly_array_type(t)
        if printer_write_array_as_generic
        {
            if readonly
                out.append("ReadonlyArray<")
            else
                out.append("Array<")
            if this.type_to_string(list[0], out) = false
                return false
            out.append(">" as char)
            set wrote_type_precedence: TypePrecedenceNonArray
            return true
        }
        if readonly
            out.append("readonly ")
        if this.write_postfix_type_operand(list[0], out) = false
            return false
        out.append("[]")
        ; An ArrayTypeNode is TypePrecedencePostfix; wrapped in a readonly
        ; TypeOperatorNode it is TypePrecedenceTypeOperator.
        set wrote_type_precedence: TypePrecedencePostfix
        if readonly
            set wrote_type_precedence: TypePrecedenceTypeOperator
        true
    }

    ; emitPostfixTypeOperand — the operand of an array, an optional or an indexed
    ; access. ★★ ITS TypeQuery EXCEPTION IS UNREACHABLE HERE AND THAT IS EXACT: the
    ; guard is `ast.IsParseTreeNode(parent)`, and every node this printer would build
    ; is SYNTHESIZED, so the operand always goes at Postfix.
    ;
    ; ★★★ THE SENTENCE THAT FOLLOWED — *"TypeQuery is NonArray anyway, so the two
    ; answers coincide for it in any case"* — WAS FALSE, AND IT COST SIX UNITS
    ; (slice 183). `GetTypeNodePrecedence` answers TypePrecedenceTypeOperator for
    ; KindTypeQuery, with a comment saying exactly why: it is a NonArrayType that is
    ; treated as an operator SO THAT this position parenthesizes it. The exception
    ; above is indeed unreachable, but only because the unguarded path already
    ; wraps — `TypeOperator < Postfix` — which is the opposite of what the note
    ; claimed and made `(typeof C)[]` come out as `typeof C[]`. **An unreachability
    ; argument and the reason a line is harmless are two different claims; this note
    ; proved the first and asserted the second.** The precedence is set in
    ; symbol_to_type_node, which is the arm that builds the TypeQuery.
    procedure write_postfix_type_operand(this, element: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        let scratch StringBuilder^host()
        if this.type_to_string(element, &scratch) = false
            return false
        let parens wrote_type_precedence < TypePrecedencePostfix
        if parens
            out.append("(" as char)
        out.append(scratch.to_string())
        if parens
            out.append(")" as char)
        true
    }

    ; typeReferenceToTypeNode's TUPLE branch plus the emit printer's TupleTypeNode,
    ; NamedTupleMember, RestTypeNode and OptionalTypeNode.
    ;
    ; ★★★ A TUPLE ELEMENT IS EMITTED AT TypePrecedenceLowest AND IS THEREFORE NEVER
    ; PARENTHESIZED — `emitTupleElementType` is `emitTypeNodeOutsideExtends`, whose
    ; precedence argument is Lowest. So `[A | B, C]` is written straight through,
    ; which is the OPPOSITE of the array element one function above. The two are ten
    ; lines apart in the reference and disagree; reading one and assuming the other
    ; is how `[(A | B)]` would get written.
    ;
    ; ★★★ THE EMPTY TUPLE PRINTS `[]` AND THE REASON IS A FLAG ALIAS. The reference's
    ; fork is `if b.ctx.encounteredError || flags&AllowEmptyTuple != 0`, and
    ; `FlagsIgnoreErrors` — which typeToStringEx adds — is DEFINED as a union that
    ; INCLUDES AllowEmptyTuple. So the branch below the fork (`encounteredError =
    ; true; return nil`, i.e. no name at all) is unreachable from this entry point.
    ;
    ; ★★ THE OPTIONAL MARKER IS WRITTEN TWICE IN TWO PLACES AND THEY ARE NOT THE
    ; SAME `?`: a LABELLED element writes `name?: T` (the question token rides with
    ; the name) and an unlabelled one writes `T?` (an OptionalTypeNode, postfix). A
    ; REST element likewise: labelled is `...name: T[]` and unlabelled is `...T[]`,
    ; and in BOTH the element type is wrapped in an extra array — the tuple's own
    ; element type is the ELEMENT, not the array.
    procedure write_tuple_type_reference(this, t: ref[Type], tgt: ref[Type], out: ref[StringBuilder]) returns bool
    {
        let readonly Checker.tuple_readonly_of(tgt)
        if readonly
            out.append("readonly ")
        let mark this.unported_mark()
        let args this.get_type_arguments(t)
        if this.unported_mark() <> mark
            return false
        var na 0
        if args <> null
            set na: (args as ref[Array[ref[Type]?]]).get_length() as int
        var arity 0
        if na > 0
            set arity: Checker.get_type_reference_arity(t)
        ; ★★★ THE COLLISION PASS RUNS OVER THE BARE ELEMENT TYPES AND THE LABELS GO
        ; ON AFTERWARDS (slice 183), which is upstream's own order:
        ; `mapToTypeNodes(typeArguments[0:arity], false)` builds the plain nodes and
        ; the loop under it REPLACES each with a NamedTupleMember, a RestTypeNode or
        ; an OptionalTypeNode. Asking the collision about the wrapped node would
        ; answer *not an identifier type reference* for every labelled element, so
        ; `[c, m.c]` — the shape this was written for — has to be decided before the
        ; wrappers exist.
        ;
        ; ★★ EACH PIECE CARRIES ITS PRECEDENCE, because the wrappers are where the
        ; parentheses are decided and the piece is already text by then. It is the
        ; same value write_postfix_type_operand would have read, recorded per
        ; element instead of read once.
        let host Page.get(this)
        let pieces &Array[String]^host()
        let names &Array[Slice[char]]^host()
        let marks &Array[int]^host()
        let precs &Array[int]()
        let types &Array[ref[Type]?]^host()
        let outer printer_depth
        var i 0
        while i < arity
        {
            let flags Checker.tuple_element_flags_at(tgt, i)
            ; removeMissingType(arg, isOptional) — the missing type is undefined's
            ; twin, and an optional element carries it out of addOptionalityEx.
            let raw (args as ref[Array[ref[Type]?]])[i]
            if raw = null
                return false
            let arg this.remove_missing_type(raw as ref[Type], (flags & ElementFlagsOptional) <> 0)
            if arg = null
                return false
            let piece StringBuilder^host()
            this.add_approximate_length(2)
            if this.type_to_string(arg, &piece) = false
                return false
            pieces.add(piece.to_string())
            if this.wrote_identifier_type_reference(outer)
                names.add(wrote_type_reference_name)
            else
                names.add(Slice[char]())
            precs.add(wrote_type_precedence)
            marks.add(0)
            types.add(arg)
            set i: i + 1
        }
        this.mark_name_collisions(types, names, marks)
        var r 0
        while r < arity
        {
            if marks[r] <> 0
            {
                let saved printer_fully_qualified
                set printer_fully_qualified: true
                let piece StringBuilder^host()
                let ok this.type_to_string(types[r], &piece)
                set printer_fully_qualified: saved
                if ok = false
                    return false
                pieces.put(r, piece.to_string())
                precs.put(r, wrote_type_precedence)
            }
            set r: r + 1
        }
        out.append("[" as char)
        var k 0
        while k < arity
        {
            if k > 0
                out.append(", ")
            let flags Checker.tuple_element_flags_at(tgt, k)
            let labeled Checker.tuple_labeled_declaration_at(tgt, k)
            if labeled <> null
            {
                if (flags & ElementFlagsVariable) <> 0
                    out.append("...")
                ; getTupleElementLabel, and only its FIRST line is reachable from
                ; here: the printer calls it with `restSymbol` nil and only where
                ; the labelled declaration is non-null, so the answer is always
                ; `labeledDeclaration.Name().Text()` and the `arg_N` fallback has no
                ; input. ★It is the raw identifier text and not write_symbol_name's
                ; declaration text — a tuple label has no symbol at all.
                let name AstNode.name_of(labeled as ref[AstNode])
                if name = null
                    return false
                let nm name as ref[AstNode]
                out.append(AstNode.identifier_text_of(nm).data, AstNode.identifier_text_of(nm).length)
                if (flags & ElementFlagsOptional) <> 0
                    out.append("?" as char)
                out.append(": ")
                Checker.write_tuple_piece(pieces.at(k), precs[k], (flags & ElementFlagsRest) <> 0, out)
            }
            else
            {
                if (flags & ElementFlagsVariable) <> 0
                {
                    out.append("...")
                    Checker.write_tuple_piece(pieces.at(k), precs[k], (flags & ElementFlagsRest) <> 0, out)
                }
                else
                {
                    if (flags & ElementFlagsOptional) <> 0
                    {
                        ; An OptionalTypeNode: its operand is POSTFIX, unlike every
                        ; other element position here.
                        Checker.write_parenthesized_piece(pieces.at(k), precs[k], TypePrecedencePostfix, out)
                        out.append("?" as char)
                    }
                    else
                        out.append(pieces.at(k))
                }
            }
            set k: k + 1
        }
        out.append("]" as char)
        ; A TupleTypeNode is TypePrecedenceNonArray; wrapped in a readonly
        ; TypeOperatorNode it is TypePrecedenceTypeOperator.
        set wrote_type_precedence: TypePrecedenceNonArray
        if readonly
            set wrote_type_precedence: TypePrecedenceTypeOperator
        true
    }

    ; write_tuple_element_type over an ALREADY RENDERED piece — the REST wrapper's
    ; `[]` with its postfix parentheses, or the piece itself.
    procedure write_tuple_piece(piece: String, prec: int, rest: bool, out: ref[StringBuilder])
    {
        if rest = false
        {
            out.append(piece)
            return
        }
        Checker.write_parenthesized_piece(piece, prec, TypePrecedencePostfix, out)
        out.append("[]")
    }

    ; The emit printer's `emitTypeNode(node, prec)` over a piece whose precedence
    ; was recorded when it was written.
    procedure write_parenthesized_piece(piece: String, prec: int, at: int, out: ref[StringBuilder])
    {
        let parens prec < at
        if parens
            out.append("(" as char)
        out.append(piece)
        if parens
            out.append(")" as char)
    }

    ; One tuple element's TYPE, at Lowest precedence, with the extra `[]` a REST
    ; element's node carries. ★A VARIADIC element does NOT get the array wrapper —
    ; the reference's `IfElse(flags&Rest != 0, NewArrayTypeNode(...), ...)` tests
    ; Rest and not Variable — because a variadic element's type IS the array.
    procedure write_tuple_element_type(this, arg: ref[Type]?, rest: bool, out: ref[StringBuilder]) returns bool
    {
        if rest = false
            return this.type_to_string(arg, out)
        if this.write_postfix_type_operand(arg, out) = false
            return false
        out.append("[]")
        set wrote_type_precedence: TypePrecedencePostfix
        true
    }

    procedure type_reference_to_type_node(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        let target Checker.target_of(t)
        if target = null
        {
            this.record_unported("type-to-string-reference", t.object_flags)
            return false
        }
        let tgt target as ref[Type]
        ; ★★★ THE ARRAY AND TUPLE BRANCHES ARE CODE SINCE SLICE 115, and they had to
        ; land in the same commit as the factory: minting `string[]` without being
        ; able to NAME it moves a unit's stop from getTypeFromTypeNode to
        ; type-to-string and buys nothing — the sentence the union arm's header
        ; already wrote, applied a second time.
        ;
        ; ★ The ARRAY test comes FIRST here where the reference tests it first too,
        ; and it must: the global `Array` target is not a tuple target, so the two
        ; branches are disjoint and the order is the reference's rather than load-
        ; bearing. `target_is_global_array_type` is the symbol-side predicate slice
        ; 109 wrote and it stays the test, because it answers without computing a
        ; declared type.
        if this.target_is_global_array_type(tgt)
            return this.write_array_type_reference(t, tgt, out)
        if (tgt.object_flags & ObjectFlagsTuple) <> 0
            return this.write_tuple_type_reference(t, tgt, out)
        let mark this.unported_mark()
        let args this.get_type_arguments(t)
        if this.unported_mark() <> mark
            return false
        ; ── the OUTER TYPE PARAMETERS, and the answer is a QUALIFIED NAME ──────
        ;
        ; ★★★ WHAT IT PRINTS IS `Outer.createInner.Inner` AND NOT
        ; `Outer<string>.createInner<number>.Inner` — the group ARGUMENTS ARE
        ; DROPPED, and that is `appendReferenceToType`'s doing rather than a
        ; simplification: its TypeReference arm rebuilds the node as
        ; `UpdateTypeReferenceNode(root, <joined name>, ref.TypeArgumentList())`,
        ; so each append replaces the accumulated argument list with the newly
        ; appended one and only the LAST survives. Measured against the oracle on a
        ; local class inside a generic method of a generic class, which is the
        ; shape that produces two groups.
        ;
        ; ★★★ AND THE FINAL LIST IS A WINDOW, `typeArguments[i:typeParameterCount]`
        ; where `i` has walked the whole outer list. This is why the branch could
        ; not be *left out and reported*: with the report gone but the window still
        ; starting at 0, an inner type would print its container's arguments as its
        ; own — a wrong answer where the stop was a missing one.
        ;
        ; ★ A GROUP whose type ARGUMENTS are its own type PARAMETERS is not shown —
        ; those are the default outer arguments, and naming the container would say
        ; nothing. The comparison is by IDENTITY, one type pointer against another.
        var arg_start 0
        var wrote_qualified_prefix false
        let outer this.outer_type_parameters_of(tgt)
        if outer <> null
        {
            let ol outer as ref[Array[ref[Type]?]]
            let olen ol.get_length() as int
            var oi 0
            while oi < olen
            {
                let start oi
                let parent this.parent_symbol_of_type_parameter(ol[oi])
                if this.unported_mark() <> mark
                    return false
                ; The reference's do-while: advance past every parameter declared
                ; by the same container, starting with this one.
                set oi: oi + 1
                var same true
                while same
                {
                    set same: false
                    if oi < olen
                    {
                        let next this.parent_symbol_of_type_parameter(ol[oi])
                        if this.unported_mark() <> mark
                            return false
                        if next = parent
                        {
                            set same: true
                            set oi: oi + 1
                        }
                    }
                }
                var defaulted true
                var gi start
                while gi < oi
                {
                    var arg: ref[Type]? null
                    if args <> null
                    {
                        if gi < ((args as ref[Array[ref[Type]?]]).get_length() as int)
                            set arg: (args as ref[Array[ref[Type]?]])[gi]
                    }
                    if arg <> ol[gi]
                        set defaulted: false
                    set gi: gi + 1
                }
                if defaulted = false
                {
                    if parent = null
                    {
                        this.record_unported("type-to-string-outer-type-parameters", 0)
                        return false
                    }
                    if this.symbol_to_type_node(parent as ref[Symbol], SymbolFlagsType, out) = false
                        return false
                    out.append("." as char)
                    set wrote_qualified_prefix: true
                }
            }
            set arg_start: olen
        }
        if t.symbol = null
        {
            this.record_unported("type-to-string-reference", t.object_flags)
            return false
        }
        ; ★★★ IT IS symbolToTypeNode AND NOT THE BARE NAME (slice 183). Upstream's
        ; last line here is `b.symbolToTypeNode(t.symbol, SymbolFlagsType,
        ; typeArgumentNodes)`, and this port wrote `getNameOfSymbolAsWritten`
        ; directly — which was the same text for as long as the chain could only be
        ; one element, and stopped being it the moment the collision pass could turn
        ; the fully-qualified flag on. A shortcut past a function is a claim that the
        ; function is the identity, and it expires with the function.
        if this.write_symbol_chain(t.symbol as ref[Symbol], SymbolFlagsType, out) = false
            return false
        ; The TypeName is an Identifier unless an outer-type-parameter GROUP put a
        ; qualifier in front of it, in which case it is a QualifiedName. ★It is
        ; held in a LOCAL and re-stated at each exit for the same reason the
        ; precedence is: the type-argument list below recurses through
        ; type_to_string, whose first line clears the field.
        var ref_name Slice[char]()
        if wrote_qualified_prefix = false
        {
            if wrote_chain_length = 1
                set ref_name: Symbol.name_of(t.symbol as ref[Symbol])
        }
        ; ★★★ A TypeReferenceNode IS TypePrecedenceNonArray, AND THIS ARM SET
        ; NOTHING UNTIL SLICE 183 — so it answered whatever its LAST TYPE ARGUMENT
        ; had left, which is the only recursion in it. `TH<A & B> & { z: number; }`
        ; printed `(TH<A & B>) & { z: number; }` and `TC<string | number>[]`
        ; printed `(TC<string | number>)[]`: an argument's Intersection or Union
        ; sits BELOW the operand precedence the caller then compares against, so
        ; the parentheses are the argument's and not the reference's. The field's
        ; own note states the rule this broke — *every arm that writes must set
        ; it* — and a REFERENCE WITH NO ARGUMENTS obeyed it only by accident,
        ; through the NonArray seed on `type_to_string`'s first line. It is set at
        ; every exit here rather than at the one that recurses, because an arm that
        ; is right for the wrong reason reads exactly like one that is wrong.
        set wrote_type_precedence: TypePrecedenceNonArray
        set wrote_type_reference_name: ref_name
        set wrote_name_depth: printer_depth
        ; The type-argument list: `typeParameterCount` is `min(len(typeParams),
        ; len(typeArguments))`, less the trailing arguments identical to their
        ; parameters' defaults on the four Iterable globals (the reference's
        ; backwards-compatible elision)
        if args = null
            return true
        let list args as ref[Array[ref[Type]?]]
        let na list.get_length() as int
        if na = 0
            return true
        var count Checker.type_parameter_count_of(tgt)
        if na < count
            set count: na
        let type_params this.interface_type_parameters_of(tgt)
        if type_params <> null
        {
            let tps type_params as ref[Array[ref[Type]?]]
            var iterable false
            if Checker.is_reference_to_type(t, this.get_global_iterable_type())
                set iterable: true
            if Checker.is_reference_to_type(t, this.get_global_iterable_iterator_type())
                set iterable: true
            if Checker.is_reference_to_type(t, this.get_global_async_iterable_type())
                set iterable: true
            if Checker.is_reference_to_type(t, this.get_global_async_iterable_iterator_type())
                set iterable: true
            if iterable
            {
                var elide true
                let node Checker.reference_node_of(t)
                if node <> null
                {
                    let nn node as ref[AstNode]
                    if nn.kind = KindTypeReference
                    {
                        let node_args AstNode.type_reference_arguments_of(nn)
                        if node_args <> null
                        {
                            if AstNode.list_count(node_args) >= count
                                set elide: false
                        }
                    }
                }
                if elide
                {
                    var going true
                    while going and (count > 0)
                    {
                        let type_argument list[count - 1]
                        let type_parameter tps[count - 1]
                        let default_type this.get_default_from_type_parameter(type_parameter as ref[Type])
                        set going: false
                        if (default_type <> null) and (type_argument <> null)
                        {
                            if this.is_type_identical_to(type_argument as ref[Type], default_type as ref[Type])
                            {
                                set count: count - 1
                                set going: true
                            }
                        }
                    }
                }
            }
        }
        if count <= arg_start
            return true
        if this.write_type_argument_range(list, arg_start, count, out) = false
            return false
        set wrote_type_precedence: TypePrecedenceNonArray
        set wrote_type_reference_name: ref_name
        set wrote_name_depth: printer_depth
        true
    }

    ; getParentSymbolOfTypeParameter — the symbol of the CONTAINER a type parameter
    ; is declared on, which is what names a group in the qualified form above.
    ; ★The JSDoc template-tag arm is commented out upstream (`!!! JSDoc support`)
    ; and is therefore not a stop here either.
    procedure parent_symbol_of_type_parameter(this, tp: ref[Type]?) returns ref[Symbol]?
    {
        if tp = null
            return null
        let t tp as ref[Type]
        if t.symbol = null
            return null
        let decl Checker.get_declaration_of_kind(t.symbol as ref[Symbol], KindTypeParameter)
        if decl = null
            return null
        let host_node AstNode.parent_node_of(decl as ref[AstNode])
        if host_node = null
            return null
        this.get_symbol_of_node(host_node)
    }


    ; getTypeAliasForTypeLiteral — the name a circular type literal prints under.
    ;
    ; ★ The DECLARATION's parent and not the declaration: the symbol belongs to the
    ; `{ … }` node, and what carries the alias name is whatever the literal is the
    ; right-hand side OF, with parenthesised types walked through.
    procedure type_alias_for_type_literal(this, t: ref[Type]) returns ref[Symbol]?
    {
        if t.symbol = null
            return null
        let sym t.symbol as ref[Symbol]
        if (sym.flags & SymbolFlagsTypeLiteral) = 0
            return null
        if Symbol.declaration_count(sym) = 0
            return null
        let first Symbol.declaration_at(sym, 0)
        if first = null
            return null
        let node Checker.walk_up_parenthesized_types(AstNode.parent_node_of(first as ref[AstNode]))
        if node = null
            return null
        if AstNode.kind_of(node as ref[AstNode]) <> KindTypeAliasDeclaration
            return null
        this.symbol_of_declaration(node)
    }

    ; ── slice 111: the anonymous object type ─────────────────────────────────
    ;
    ; createAnonymousTypeNode → createAnonymousTypeNodeEx, then
    ; createTypeNodeFromObjectType, then the emit printer. THIS PORTS THE THREE
    ; NAME SHAPES AN ANONYMOUS OBJECT TYPE HAS — the function type, the
    ; constructor type and the type literal — plus the `typeof` shortcut in front
    ; of them.
    ;
    ; ★★★ FIVE FLAGS DECIDE THIS FAMILY AND typeToString SETS NONE OF THEM, which
    ; is what makes it portable at all. `printer.go`'s typeToString is
    ; `AllowUniqueESSymbolType | UseAliasDefinedOutsideCurrentScope`, widened by
    ; typeToStringEx to `| IgnoreErrors | NoTruncation`. Absent are:
    ;   • WriteClassExpressionAsTypeLiteral — collapses shouldEmitTypeOfSymbol's
    ;     long second conjunct to `true`, and removes the private/protected
    ;     tracker calls and the prototype filter from the property loop;
    ;   • UseStructuralFallback — collapses shouldWriteTypeOfFunctionSymbol's
    ;     accessibility conjunct to `true`, so no visibility question is asked;
    ;   • UseTypeOfFunction — leaves `visitedTypes.Has(id)` as the SOLE route by
    ;     which a function symbol reaches `typeof`, which is why visited_types is
    ;     an input to the NAME and not only a recursion guard;
    ;   • OmitThisParameter and OmitParameterModifiers — so the this-parameter is
    ;     written and `preserveModifierFlags` is the caller's own `false`;
    ;   • MultilineObjectLiterals — so a type literal is EFSingleLine, which is
    ;     the whole of its punctuation.
    ; ★★ And two context VALUES do the same work: `enclosingDeclaration` is nil
    ; (the collapse write_symbol_name's header already names) and `verbosity` is
    ; nil, so `maxExpansionDepth` is −1 — which makes `shouldExpandType` FALSE at
    ; its first line and `isExpanding` false for the whole walk. Without that the
    ; typeof arm would be a fork rather than a return, and the property loop would
    ; carry a prototype filter.
    ;
    ; ★★★ The truncation cutoff is 1 000 000 characters under NoTruncation
    ; (`noTruncationMaximumTruncationLength`). This line read *so
    ; `checkTruncationLength` is false for every name this corpus can produce and
    ; the three elision arms are not written* until slice 170, and the object
    ; spread's arms produced the counter-example on the first build — see
    ; truncation_budget_exceeded, which asks the question at the reference's four
    ; sites and reports rather than eliding.
    procedure create_anonymous_type_node(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        if t.symbol = null
            ; "Anonymous types without a symbol are never circular." — the
            ; reference's own comment on the else branch, and the reason this one
            ; needs no visited-types bracket.
            return this.create_type_node_from_object_type(t, out)
        let sym t.symbol as ref[Symbol]
        let mark this.unported_mark()
        ; ── the instantiation expression's own arm (slice 181) ───────────────
        ;
        ; ★★★ IT REUSES THE SOURCE NODE, and that is not a shortcut — it is the
        ; only answer that is RIGHT. `var xs4: typeof Array<typeof x>` prints
        ; `typeof Array<typeof x>` in the reference's baseline, where printing the
        ; type ARGUMENTS would give `typeof Array<number>` and lose the distinction
        ; from the line above it. Upstream reaches that through
        ; tryReuseExistingNonParameterTypeNode, which re-emits the existing node;
        ; this printer already produces TEXT, so re-emitting it is the node's own
        ; source range.
        ;
        ; ★★★ THE `getTypeFromTypeNode(existing) == t` GUARD IS THE REFERENCE'S AND
        ; ITS COMMENT SAYS WHY: the node is unreliable for a constituent of a union
        ; or an intersection, because every constituent of `typeof Err<number>`
        ; carries that same node and printing `typeof ErrImpl` from it is a lie.
        ; The identity test is what separates the type the node DENOTES from the
        ; ones that merely came out of it.
        ;
        ; ★★ THE VISITED BRACKET AROUND THE REUSE IS ALSO THE REFERENCE'S, for the
        ; recursion its own comment describes: a reuse that fails falls back into
        ; typeToTypeNode with the same instantiation type, which would try the same
        ; node again. It matters MORE here than upstream, because this port's
        ; write_reused_node never declines — where upstream answers nil it answers
        ; `type_to_string(t)`, which is the re-entry the bracket bottoms out.
        ;
        ; ★★★ THE REUSE IS SLICE 158's `write_possibly_reused_type_node` FAMILY AND
        ; NOT A WRITER OF ITS OWN. This slice wrote one — nine lines that printed
        ; the node's SOURCE RANGE — and it collided with `write_reused_type_node`
        ; 1 700 lines down, same name, same parameter list, so the emitter kept the
        ; NEW one and every existing caller of the real visitor silently got the
        ; naive one: five stage-1 units went red printing `{ a: string; b?: number }`
        ; where the reference prints `{ a: string; b?: number; }`. `dupmethods.py`,
        ; written the slice before, named it in one call. §3.5gc.
        if (t.object_flags & ObjectFlagsInstantiationExpressionType) <> 0
        {
            let existing Checker.instantiation_expression_node_of(t)
            if existing <> null
            {
                let ex existing as ref[AstNode]
                if AstNode.kind_of(ex) = KindTypeQuery
                {
                    let denoted this.get_type_from_type_node(ex)
                    if this.unported_mark() <> mark
                        return false
                    if denoted <> null
                    {
                        if (denoted as ref[Type]) = t
                        {
                            if this.visited_type(t.id)
                                return this.write_elided_placeholder(out)
                            this.push_visited_type(t.id)
                            let reused this.write_reused_node(ex, out)
                            this.pop_visited_type()
                            if reused
                                return true
                        }
                    }
                }
            }
            if this.visited_type(t.id)
                return this.write_elided_placeholder(out)
            this.push_visited_type(t.id)
            let ok this.create_type_node_from_object_type(t, out)
            this.pop_visited_type()
            return ok
        }
        ; isClassInstanceSide picks the MASK, and the mask IS the `typeof`: upstream
        ; `isTypeOf := mask == SymbolFlagsValue`, so the instance side of a class
        ; prints `C` and the static side prints `typeof C`.
        let instance_side this.is_class_instance_side(t, sym)
        if this.unported_mark() <> mark
            return false
        ; ★★ THE SYMBOL COMES BACK OUT, because shouldWriteTypeOfFunctionSymbol may
        ; REPLACE it — a function expression bound to a top-level `var` is named
        ; through its variable's symbol, not its own. Upstream returns the pair;
        ; here the second half is an out-cell.
        var named: ref[Symbol]? sym
        let emit_typeof this.should_emit_type_of_symbol(sym, t.id, &named)
        if this.unported_mark() <> mark
            return false
        if emit_typeof
        {
            ; `if b.shouldExpandType(t, false) { depth++ } else { return … }` —
            ; shouldExpandType is false at its FIRST LINE here (maxExpansionDepth
            ; is −1), so the else branch is the whole fork.
            var mask SymbolFlagsValue
            if instance_side
                set mask: SymbolFlagsType
            if named = null
                return false
            return this.symbol_to_type_node(named as ref[Symbol], mask, out)
        }
        if this.visited_type(t.id)
        {
            ; The recursion has closed. Upstream answers the type ALIAS's name when
            ; the literal is one alias's right-hand side, and the elision otherwise.
            ;
            ; ★★★ IT WAS A STOP UNTIL SLICE 163 AND ITS PREMISE HAD EXPIRED. The note
            ; read: *getTypeAliasForTypeLiteral needs SymbolFlagsTypeLiteral, which
            ; this port's binder does not set, so the fork cannot be DECIDED here —
            ; and answering the elision unconditionally would print `...` where the
            ; reference prints an alias name.* The reasoning was right and the fact
            ; was wrong: `binder.scaly` sets SymbolFlagsTypeLiteral at three sites
            ; (`bind_anonymous_declaration` for a TypeLiteral node among them), so
            ; the fork is decidable and the arm is four lines. ★The elision half is
            ; `any` here rather than `...` for the reason
            ; write_elided_information_placeholder gives.
            let alias_symbol this.type_alias_for_type_literal(t)
            if this.unported_mark() <> mark
                return false
            if alias_symbol <> null
                ; "The specified symbol flags need to be reinterpreted as type
                ; flags" — upstream's own comment on the mask.
                return this.symbol_to_type_node(alias_symbol as ref[Symbol], SymbolFlagsType, out)
            return this.write_elided_placeholder(out)
        }
        ; visitAndTransformType, minus its memo. ★★★THE MEMO IS NOT AN OMISSION AND
        ; IT WOULD NOT BE SAFE TO ADD: upstream keys `ctx.typeCache` on the type id
        ; and hands back the same NODE, which the printer re-prints identically —
        ; here the answer is already TEXT, so re-walking produces the same bytes and
        ; a cache would buy time and change nothing. What it would COST is the
        ; visited set's own meaning, because a cached hit never enters the bracket.
        ;
        ; ★★★ AND THE `symbolDepth` GUARD IS SLICE 163'S, DROPPED SILENTLY UNTIL
        ; THEN. The note above accounted for the memo and said nothing about the
        ; other half of the same function, which is not a cache at all: it is the
        ; recursion bound, and it is the ONE this printer needed. `visited_types`
        ; closes a cycle only where the same type ID comes round; a walk that mints
        ; a FRESH instantiation at each level repeats no id and recurses until the
        ; stack is gone. The reference's own comment names the fix — *instantiations
        ; of the same anonymous type have the same symbol* — and the eleven nested
        ; `{ y2: … }` of its `cyclicGenericTypeInstantiation` baseline are this
        ; `> 10` counted out. A dropped guard has no tag, no stop and no row
        ; (§3.5gi), so nothing in this apparatus was going to point at it; what
        ; found it was a BACKTRACE, after twelve slices of a note that blamed the
        ; instantiation (see get_object_type_instantiation's combined mapper).
        var is_constructor_object false
        if (t.object_flags & ObjectFlagsAnonymous) <> 0
        {
            if (sym.flags & SymbolFlagsClass) <> 0
                set is_constructor_object: true
        }
        if this.printer_symbol_visits(is_constructor_object, sym) > 10
            return this.write_elided_placeholder(out)
        this.push_printer_symbol(is_constructor_object, sym)
        this.push_visited_type(t.id)
        let ok this.create_type_node_from_object_type(t, out)
        this.pop_visited_type()
        this.pop_printer_symbol()
        ok
    }

    ; createMappedTypeNodeFromType plus the emit printer's MappedTypeNode, which
    ; under EFSingleLine is `{ `, the one member, `;` and ` }`.
    ;
    ; ★★★ THE PUNCTUATION IS THE PRINTER'S AND IT IS ASYMMETRIC IN A SECOND WAY
    ; the type literal is not: the trailing semicolon comes BEFORE the space, so a
    ; mapped type is `{ [P in K]: T; }` — the same two characters as a literal's,
    ; written by a different line. Both spellings are read off the reference's own
    ; answers (`internal/printer/printer_test.go`'s nine MappedTypeNode rows).
    ;
    ; ★★★ THREE FORKS OF THE REFERENCE ARE CONSTANT-FALSE UNDER THIS ENTRY POINT
    ; AND EACH IS WRITTEN AS ITS TEST RATHER THAN FOLDED AWAY. All three are
    ; guarded by `FlagsGenerateNamesForShadowedTypeParams`, which typeToString does
    ; not set — the same mask create_anonymous_type_node's own note names — so
    ; `needsModifierPreservingWrapper` is false, no fresh type variable is minted,
    ; and the constraint node is either `keyof <modifiers type>` or the constraint
    ; type itself.
    ;
    ; ★ The type parameter's NAME is the declaration's, which is what
    ; `typeParameterToName` answers with that flag unset — and an INSTANTIATED
    ; mapped type shares the original's symbol (clone_type_parameter passes it
    ; through), so the two spellings cannot diverge.
    procedure create_mapped_type_node_from_type(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        let mark this.unported_mark()
        let decl Checker.mapped_declaration_of(t)
        if decl = null
        {
            this.record_unported("type-to-string-mapped-no-declaration", t.object_flags)
            return false
        }
        let node decl as ref[AstNode]
        let template_type this.get_template_type_from_mapped_type(t)
        if this.unported_mark() <> mark
            return false
        let type_parameter this.get_type_parameter_from_mapped_type(t)
        if this.unported_mark() <> mark
            return false
        out.append("{ ")
        let ro AstNode.mapped_type_readonly_token_of(node)
        if ro <> null
        {
            let k AstNode.kind_of(ro as ref[AstNode])
            if k = KindPlusToken
                out.append("+" as char)
            if k = KindMinusToken
                out.append("-" as char)
            out.append("readonly ")
        }
        out.append("[" as char)
        ; emitMappedTypeParameter — the binding name, `in`, and the constraint.
        let tp_node AstNode.mapped_type_parameter_of(node)
        if tp_node = null
            return false
        if this.write_declaration_name(AstNode.name_of(tp_node), out) = false
            return false
        out.append(" in ")
        if Checker.is_mapped_type_with_keyof_constraint_declaration(t)
        {
            ; The top-level keyof-ness is retained deliberately: it can be lost to
            ; keyof DISTRIBUTION inside getConstraintTypeFromMappedType, so the
            ; printer goes back to the modifiers type.
            let ms this.get_modifiers_type_from_mapped_type(t)
            if this.unported_mark() <> mark
                return false
            if ms = null
                return false
            out.append("keyof ")
            if this.write_operand_at_postfix_precedence(ms, out) = false
                return false
        }
        if Checker.is_mapped_type_with_keyof_constraint_declaration(t) = false
        {
            let ct this.get_constraint_type_from_mapped_type(t)
            if this.unported_mark() <> mark
                return false
            if this.type_to_string(ct, out) = false
                return false
        }
        if AstNode.mapped_type_name_type_of(node) <> null
        {
            let nt this.get_name_type_from_mapped_type(t)
            if this.unported_mark() <> mark
                return false
            out.append(" as ")
            if this.type_to_string(nt, out) = false
                return false
        }
        out.append("]" as char)
        let q AstNode.question_token_of(node)
        if q <> null
        {
            let k AstNode.kind_of(q as ref[AstNode])
            if k = KindPlusToken
                out.append("+" as char)
            if k = KindMinusToken
                out.append("-" as char)
            out.append("?" as char)
        }
        out.append(": ")
        var include_optional false
        if (Checker.get_mapped_type_modifiers(t) & MappedTypeModifiersIncludeOptional) <> 0
            set include_optional: true
        var written template_type
        if template_type <> null
        {
            set written: this.remove_missing_type(template_type as ref[Type], include_optional)
            if this.unported_mark() <> mark
                return false
        }
        if this.type_to_string(written, out) = false
            return false
        ; `writeTrailingSemicolon` then the single-line space, in that order.
        out.append(";")
        ; The reference emits the mapped type's own MEMBERS after the semicolon,
        ; and the grammar forbids them — `A mapped type may not declare properties
        ; or methods` — so the list is filled only for a malformed source. It is
        ; not written here for the reason the port's member accessor gives: the one
        ; shape that produces one is a parse recovery, and printing it would be a
        ; name for a type the reference reports on instead.
        out.append(" }")
        this.add_approximate_length(10)
        true
    }

    ; isClassInstanceSide — the symbol's class flag, then `t` against the symbol's
    ; DECLARED type. ★The second disjunct (`ObjectFlagsIsClassInstanceClone`) has no
    ; writer in this port; it is set by getTypeWithThisArgument's clone path, which
    ; resolve_object_type_members reaches but which never mints an ANONYMOUS type,
    ; so it cannot arrive here. Written as the reference's test all the same.
    procedure is_class_instance_side(this, t: ref[Type], sym: ref[Symbol]) returns bool
    {
        if (Symbol.flags_of(sym) & SymbolFlagsClass) = 0
            return false
        if (t.flags & TypeFlagsObject) <> 0
        {
            if (t.object_flags & ObjectFlagsIsClassInstanceClone) <> 0
                return true
        }
        let declared this.get_declared_type_of_class_or_interface(sym)
        if declared = null
            return false
        (declared as ref[Type]) = t
    }

    ; shouldEmitTypeOfSymbol, with `forceExpansion` and `forceClassExpansion` both
    ; FALSE — createAnonymousTypeNode is the only caller and passes false twice.
    ;
    ; ★★★ THE LONG SECOND CONJUNCT IS `true`, AND THAT IS A FLAG ARGUMENT RATHER
    ; THAN A SIMPLIFICATION. Upstream reads
    ; `!(ValueDeclaration != nil && IsClassLike(…) && flags&WriteClassExpressionAsTypeLiteral != 0 && …)`;
    ; the third factor is false under this entry point, so the parenthesis is false
    ; and its negation is true. Both IsSymbolAccessible calls inside it are
    ; therefore never asked, which is the only reason this arm needs no visibility
    ; machinery at all.
    procedure should_emit_type_of_symbol(this, sym: ref[Symbol], type_id: int, out_sym: ref[ref[Symbol]?]) returns bool
    {
        set out_sym: sym
        let f Symbol.flags_of(sym)
        if (f & SymbolFlagsClass) <> 0
        {
            let mark this.unported_mark()
            let btv this.get_base_type_variable_of_class(sym)
            if this.unported_mark() <> mark
                return false
            if btv = null
                return true
        }
        if (f & (SymbolFlagsEnum | SymbolFlagsValueModule)) <> 0
            return true
        this.should_write_type_of_function_symbol(sym, type_id, out_sym)
    }

    ; shouldWriteTypeOfFunctionSymbol.
    ;
    ; ★★★ ITS ANSWER REDUCES TO `(isStaticMethod || isNonLocalFunction) && visitedTypes.Has(id)`,
    ; and the second half is why the function is not dead in a port with no
    ; UseTypeOfFunction caller: a function that names ITSELF in its own type —
    ; `function f() { return f; }` — re-enters the printer with its own type id on
    ; the visited stack, and `typeof f` is the only finite name there is.
    ;
    ; ★★ THE isFunctionExpressionSymbol RE-TARGETING IS WRITTEN, NOT DROPPED, and it
    ; always fires once its branch is taken: the guard is
    ; `ValueDeclaration.Parent != ctx.enclosingDeclaration`, a comparison against
    ; NIL, so it holds whenever there is a parent at all. That is the one place in
    ; this family where the symbol that gets NAMED is not the symbol that was asked
    ; about, which is why the caller takes it back through an out-cell.
    procedure should_write_type_of_function_symbol(this, sym: ref[Symbol], type_id: int, out_sym: ref[ref[Symbol]?]) returns bool
    {
        let f Symbol.flags_of(sym)
        let n Symbol.declaration_count(sym)
        var is_static_method false
        if (f & SymbolFlagsMethod) <> 0
        {
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(sym, i)
                if d <> null
                {
                    let decl d as ref[AstNode]
                    if this.declaration_is_static(decl)
                    {
                        ; `&& !isLateBindableIndexSignature(GetNameOfDeclaration(d))`.
                        ; WHOLE since slice 159.
                        ;
                        ; ★★★ THE ROW SAID THE CONJUNCT *"needs the name TYPE"* AND
                        ; `is_late_bindable_index_signature` IS IN THIS FILE — with
                        ; `check_computed_property_name` and
                        ; `is_type_usable_as_index_signature_declaration` behind it,
                        ; i.e. the name type it named. §3.5eo; the tags scan cannot
                        ; see this one, because the tag is the reference's predicate
                        ; and the port spells it in snake case one file-half away.
                        ;
                        ; ★★ A DECLARATION WITH NO NAME KEEPS THE OLD ANSWER, and the
                        ; reference agrees by a different route: `GetNameOfDeclaration`
                        ; would hand nil to a function that dereferences it, so upstream
                        ; reaches this line only for a named declaration. The guard is
                        ; therefore the shape of upstream's precondition and not a
                        ; tolerance this port invents.
                        let nm b.get_name_of_declaration(decl)
                        var late false
                        if nm <> null
                        {
                            let mark_lb this.unported_mark()
                            set late: this.is_late_bindable_index_signature(nm as ref[AstNode])
                            if this.unported_mark() <> mark_lb
                                return false
                        }
                        if late = false
                            set is_static_method: true
                    }
                }
                set i: i + 1
            }
        }
        var is_non_local_function false
        var is_function_expression false
        if (f & SymbolFlagsFunction) <> 0
        {
            if Symbol.parent_of(sym) <> null
                set is_non_local_function: true
            if Symbol.parent_of(sym) = null
            {
                var i 0
                var found false
                while i < n
                {
                    if found = false
                    {
                        let d Symbol.declaration_at(sym, i)
                        if d <> null
                        {
                            let decl d as ref[AstNode]
                            let p AstNode.parent_node_of(decl)
                            if p <> null
                            {
                                let pk AstNode.kind_of(p as ref[AstNode])
                                if pk = KindSourceFile
                                    set found: true
                                if pk = KindModuleBlock
                                    set found: true
                                if found = false
                                {
                                    if Checker.is_function_expression_or_arrow_function(decl)
                                    {
                                        if Checker.parent_is_top_level_variable(p as ref[AstNode])
                                        {
                                            set found: true
                                            set is_function_expression: true
                                        }
                                    }
                                }
                            }
                        }
                    }
                    set i: i + 1
                }
                if found
                    set is_non_local_function: true
            }
        }
        if is_static_method = false
        {
            if is_non_local_function = false
                return false
        }
        if is_function_expression
        {
            let vd Symbol.value_declaration_of(sym)
            if vd <> null
            {
                let vp AstNode.parent_node_of(vd as ref[AstNode])
                if vp <> null
                {
                    let ps this.get_symbol_of_declaration(vp as ref[AstNode])
                    if ps <> null
                        set out_sym: this.get_merged_symbol(ps)
                }
            }
        }
        ; `(flags&UseTypeOfFunction != 0 || visitedTypes.Has(typeId)) && (flags&UseStructuralFallback == 0 || …)`
        ; — the first disjunct is false and the second conjunct is true, both by the
        ; mask this entry point passes. What is left is the visited set.
        this.visited_type(type_id)
    }

    ; `ast.IsStatic` — a class element carrying the `static` modifier, or a static
    ; BLOCK. ★The second disjunct cannot arrive at the one call site above (a static
    ; block declaration carries no SymbolFlagsMethod) and is written as the
    ; reference's line rather than folded away.
    function declaration_is_static(this, n: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(n) = KindClassStaticBlockDeclaration
            return true
        if Binder.is_class_element(n) = false
            return false
        b.has_syntactic_modifier(n, ModifierFlagsStatic)
    }

    ; The tail of shouldWriteTypeOfFunctionSymbol's function-expression chain, asked
    ; on the declaration's PARENT: a variable declaration inside a declaration list
    ; inside a statement whose own parent is a source file or a module block.
    function parent_is_top_level_variable(p: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(p) <> KindVariableDeclaration
            return false
        let list AstNode.parent_node_of(p)
        if list = null
            return false
        if AstNode.kind_of(list as ref[AstNode]) <> KindVariableDeclarationList
            return false
        let stmt AstNode.parent_node_of(list as ref[AstNode])
        if stmt = null
            return false
        if AstNode.kind_of(stmt as ref[AstNode]) <> KindVariableStatement
            return false
        let owner AstNode.parent_node_of(stmt as ref[AstNode])
        if owner = null
            return false
        let k AstNode.kind_of(owner as ref[AstNode])
        if k = KindSourceFile
            return true
        k = KindModuleBlock
    }

    ; ── the visited set ──────────────────────────────────────────────────────
    ;
    ; `ctx.visitedTypes` — see the field's own note for why it is an INPUT to the
    ; name rather than only a guard. The three operations are visitAndTransformType's
    ; Add / Delete pair and shouldWriteTypeOfFunctionSymbol's Has.

    procedure push_visited_type(this, id: int)
    {
        let st visited_types as ref[Array[int]]
        if visited_type_depth < (st.get_length() as int)
            st.put(visited_type_depth as size_t, id)
        else
            st.add(id)
        set visited_type_depth: visited_type_depth + 1
    }

    procedure pop_visited_type(this)
        set visited_type_depth: visited_type_depth - 1

    ; ── the printer's symbolDepth (slice 163) ────────────────────────────────
    ;
    ; See PrinterSymbolFrame. `printer_symbol_visits` is upstream's
    ; `ctx.symbolDepth[id]` read, and the push/pop pair is its write and restore.

    function printer_symbol_visits(this, is_constructor_object: bool, symbol: ref[Symbol]) returns int
    {
        if printer_symbols = null
            return 0
        let st printer_symbols as ref[Array[ref[PrinterSymbolFrame]?]]
        var n 0
        var i 0
        while i < printer_symbol_count
        {
            let row st[i]
            if row <> null
            {
                let r row as ref[PrinterSymbolFrame]
                if r.is_constructor_object = is_constructor_object
                {
                    if r.symbol <> null
                    {
                        if (r.symbol as ref[Symbol]) = symbol
                            set n: n + 1
                    }
                }
            }
            set i: i + 1
        }
        n
    }

    ; The same read over the NODE half of the identity — upstream's
    ; `CompositeSymbolIdentity{false, 0, GetNodeId(root.node)}`, whose one call
    ; site here is the conditional arm.
    function printer_node_visits(this, node: ref[AstNode]) returns int
    {
        if printer_symbols = null
            return 0
        let st printer_symbols as ref[Array[ref[PrinterSymbolFrame]?]]
        var n 0
        var i 0
        while i < printer_symbol_count
        {
            let row st[i]
            if row <> null
            {
                let r row as ref[PrinterSymbolFrame]
                if r.node <> null
                {
                    if (r.node as ref[AstNode]) = node
                        set n: n + 1
                }
            }
            set i: i + 1
        }
        n
    }

    procedure push_printer_symbol(this, is_constructor_object: bool, symbol: ref[Symbol])
        this.push_printer_frame(is_constructor_object, symbol as ref[Symbol]?, null)

    procedure push_printer_node(this, node: ref[AstNode])
        this.push_printer_frame(false, null, node as ref[AstNode]?)

    procedure push_printer_frame(this, is_constructor_object: bool, symbol: ref[Symbol]?, node: ref[AstNode]?)
    {
        if printer_symbols = null
            return
        let st printer_symbols as ref[Array[ref[PrinterSymbolFrame]?]]
        if printer_symbol_count < (st.get_length() as int)
        {
            let row st[printer_symbol_count]
            if row <> null
            {
                let r row as ref[PrinterSymbolFrame]
                set r.is_constructor_object: is_constructor_object
                set r.symbol: symbol
                set r.node: node
                set printer_symbol_count: printer_symbol_count + 1
                return
            }
        }
        let page Page.get(st)
        st.add(&PrinterSymbolFrame^page(is_constructor_object, symbol, node))
        set printer_symbol_count: printer_symbol_count + 1
    }

    procedure pop_printer_symbol(this)
        set printer_symbol_count: printer_symbol_count - 1

    ; createElidedInformationPlaceholder. ★★★ IT IS `any` HERE AND NOT `...`:
    ; the placeholder reads `if ctx.flags&NoTruncation == 0 { "..." }` and
    ; typeToStringEx sets NoTruncation, so this entry point always takes the second
    ; return — a bare `any` keyword node carrying a synthetic `/*elided*/` leading
    ; comment that the emit printer this dump goes through does not write. The
    ; reference's own baselines are the witness: `cyclicGenericTypeInstantiation`
    ; prints eleven nested `{ y2: … }` and then a plain `any`.
    procedure write_elided_information_placeholder(out: ref[StringBuilder]) returns bool
    {
        out.append("any")
        true
    }

    function visited_type(this, id: int) returns bool
    {
        let st visited_types as ref[Array[int]]
        var i 0
        while i < visited_type_depth
        {
            if st[i] = id
                return true
            set i: i + 1
        }
        false
    }

    ; ── the five signature FORMS, which are one function upstream ────────────
    ;
    ; signatureToSignatureDeclarationHelper takes a `kind` and switches on it at the
    ; very end; these are the five that a type name can contain, and the number is
    ; what the emit printer does with the same three pieces.
    ;
    ;   FunctionType       <T>(p: A) => R
    ;   ConstructorType    new <T>(p: A) => R
    ;   CallSignature      <T>(p: A): R
    ;   ConstructSignature new <T>(p: A): R
    ;   MethodSignature    m?<T>(p: A): R
    ;
    ; ★ The other eight kinds of the switch are declaration EMITTER shapes
    ; (FunctionDeclaration, MethodDeclaration, ArrowFunction, the accessors, …) and
    ; no type NAME contains one — except the two accessor kinds, which
    ; addPropertyToElementList reaches and which stop there for a reason of their
    ; own.

    ; createTypeNodeFromObjectType — the four exits, in the reference's order.
    ;
    ; ★★★ THE ORDER IS LOAD-BEARING TWICE OVER. The `properties == 0 &&
    ; indexInfos == 0` gate stands in front of all three special shapes, so a type
    ; with ONE call signature AND a property is a type LITERAL and not a function
    ; type — which is exactly how `{ (a: string): void; (a: number): void; }` and
    ; `(x: string) => void` come out of the same builder. And the empty test comes
    ; first, so a type with nothing at all is `{}` rather than a literal with no
    ; members.
    procedure create_type_node_from_object_type(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        ; `isGenericMappedType(t) || (Mapped && containsError)` — the SOURCE-FORM
        ; fork, and it is the reference's first line rather than a caller's arm.
        let mark this.unported_mark()
        if (t.object_flags & ObjectFlagsMapped) <> 0
        {
            var source_form Checker.mapped_contains_error_of(t)
            if this.is_generic_mapped_type(t)
                set source_form: true
            if this.unported_mark() <> mark
                return false
            if source_form
            {
                let ok this.create_mapped_type_node_from_type(t, out)
                ; A MappedTypeNode prints as a brace form, so it is
                ; TypePrecedenceNonArray for the reason a TypeLiteralNode is — and
                ; it is set explicitly because the template type written inside may
                ; have lowered the field on the way past.
                set wrote_type_precedence: TypePrecedenceNonArray
                return ok
            }
        }
        let resolved this.resolve_structured_type_members(t)
        if resolved = null
            return false
        let sm resolved as ref[StructuredMembers]
        let call_sigs this.get_signatures_of_structured_type(t, SignatureKindCall)
        let ctor_sigs this.get_signatures_of_structured_type(t, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return false
        ; ★★★ A NULL SIGNATURE LIST IS THE EMPTY LIST HERE, AND READING IT AS A
        ; FAILURE IS A SILENT DROP. get_signatures_of_structured_type answers null
        ; for a resolved type whose `signatures` slot was never filled — which is
        ; every object type that has no call and no construct signature, i.e. the
        ; ordinary type literal — where upstream's `resolved.CallSignatures()`
        ; answers an empty slice. The mark above has already separated the other
        ; null, the one a stop produces; past it, null means NONE.
        ; ★It cost the first draft of this slice fourteen units, and every one of
        ; them failed by printing NOTHING rather than by printing something wrong:
        ; TypeDump skips a node whose name answers false, so an empty `{}` and a
        ; `{ p: string; }` both vanished from the dump with no stop logged. **A
        ; `return false` with no `record_unported` beside it is invisible to the
        ; stop histogram and to `stops.sh`'s agreement gate alike** — the reference
        ; comparison is the only instrument that sees it.
        let calls this.signature_list_or_empty(call_sigs)
        let ctors this.signature_list_or_empty(ctor_sigs)
        let nc calls.get_length() as int
        let nk ctors.get_length() as int
        var np 0
        if sm.properties <> null
            set np: (sm.properties as ref[Array[ref[Symbol]?]]).get_length() as int
        var ni 0
        if sm.index_infos <> null
            set ni: (sm.index_infos as ref[Array[ref[IndexInfo]?]]).get_length() as int
        if np = 0
        {
            if ni = 0
            {
                if nc = 0
                {
                    if nk = 0
                    {
                        ; NewTypeLiteralNode with an empty member list, EFSingleLine
                        ; — the printer writes the two braces and nothing between.
                        this.add_approximate_length(2)
                        out.append("{}")
                        return true
                    }
                }
                if nc = 1
                {
                    if nk = 0
                    {
                        let s0 calls[0]
                        if s0 = null
                            return false
                        let ok this.write_signature_form(s0 as ref[Signature], SigFormFunctionType, null, out)
                        ; A FunctionTypeNode — TypePrecedenceFunction, which is
                        ; BELOW a union constituent's TypeOperator. Set after the
                        ; write, because the parameter and return types are written
                        ; through this same field.
                        set wrote_type_precedence: TypePrecedenceFunction
                        return ok
                    }
                }
                if nk = 1
                {
                    if nc = 0
                    {
                        let s0 ctors[0]
                        if s0 = null
                            return false
                        let ok this.write_signature_form(s0 as ref[Signature], SigFormConstructorType, null, out)
                        ; A ConstructorTypeNode — the same precedence as the
                        ; function type, and parenthesized in the same places.
                        set wrote_type_precedence: TypePrecedenceFunction
                        return ok
                    }
                }
            }
        }
        ; The ABSTRACT-constructor fork, which is an INTERSECTION and not a literal:
        ; `abstract class C {}` names its static side `abstract new () => {}`, and
        ; with static members `(abstract new () => {}) & { … }`.
        ;
        ; ★★★ THE PARENTHESES ARE NOT WRITTEN HERE AND MUST NOT BE. The fork hands
        ; the finished intersection back to `type_to_string`, whose intersection arm
        ; asks every constituent's precedence; a constructor type writes itself at
        ; TypePrecedenceFunction, which is below TypePrecedenceIntersection, so the
        ; parentheses come out of `write_constituent_list` exactly where upstream's
        ; emitter puts them. A single abstract signature and no other member is one
        ; constituent, and `get_intersection_type` of one type is that type — which
        ; is how `abstract new () => {}` comes out unparenthesized from the same
        ; two lines.
        let printer_host Page.get(this)
        let abstract_sigs &Array[ref[Signature]?]^printer_host()
        var i 0
        while i < nk
        {
            let s ctors[i]
            if s <> null
            {
                if ((s as ref[Signature]).flags & SignatureFlagsAbstract) <> 0
                    abstract_sigs.add(s)
            }
            set i: i + 1
        }
        let abstract_count abstract_sigs.get_length() as int
        if abstract_count > 0
        {
            let parts &Array[ref[Type]?]^printer_host()
            set i: 0
            while i < abstract_count
            {
                let s abstract_sigs[i]
                if s = null
                    return false
                let st this.get_or_create_type_from_signature(s as ref[Signature])
                if st = null
                    return false
                parts.add(st)
                set i: i + 1
            }
            ; "count the number of type elements excluding abstract constructors",
            ; and "don't include an empty object literal if there were no other
            ; static-side properties to write". ★The property count is the plain
            ; one: the prototype filter upstream sits behind
            ; WriteClassExpressionAsTypeLiteral, which typeToString never sets.
            let type_element_count nc + (nk - abstract_count) + ni + np
            if type_element_count <> 0
            {
                let rest this.get_resolved_type_without_abstract_construct_signatures(t)
                if rest = null
                    return false
                parts.add(rest)
            }
            let inter this.get_intersection_type(parts)
            if inter = null
                return false
            return this.type_to_string(inter, out)
        }
        var reverse_mapped false
        if (t.object_flags & ObjectFlagsReverseMapped) <> 0
            set reverse_mapped: true
        let ok this.write_type_literal(sm, calls, ctors, reverse_mapped, out)
        ; A TypeLiteralNode is TypePrecedenceNonArray — never parenthesized. It is
        ; set explicitly rather than left alone because a MEMBER of this literal may
        ; have been a function type and lowered the field on the way past.
        set wrote_type_precedence: TypePrecedenceNonArray
        ok
    }

    ; createTypeNodesFromResolvedType plus the emit printer's TypeLiteralNode, which
    ; under EFSingleLine is `{ `, each member, `; `, and `}`.
    ;
    ; ★★★ THE PUNCTUATION IS THE PRINTER'S AND IT IS NOT SYMMETRIC: the separator
    ; and the TERMINATOR are the same two characters, so a one-member literal is
    ; `{ a: number; }` and not `{ a: number }`. The empty literal takes the other
    ; branch above and writes no space at all. Both spellings are read off the
    ; reference's own answers rather than reasoned about.
    ;
    ; ★★ THE MEMBER ORDER IS THE REFERENCE'S AND IT IS NOT THE DECLARATION ORDER:
    ; call signatures, then construct signatures, then index signatures, then
    ; properties — so `{ (a: string): void; x: number; }` comes out that way even
    ; where the source wrote `x` first.
    ; getResolvedTypeWithoutAbstractConstructSignatures — a copy of the object type
    ; with the abstract construct signatures filtered out, and the one memo the
    ; printer owns (`without_abstract_construct_signatures` on StructuredMembers).
    ;
    ; ★★★ THE COPY MEMOISES ITSELF, AND THAT LINE IS THE TERMINATION ARGUMENT.
    ; Upstream writes both `t.objectTypeWithoutAbstractConstructSignatures =
    ; typeCopy` and `typeCopy.objectTypeWithoutAbstractConstructSignatures =
    ; typeCopy`; the second is what makes asking the copy the identity instead of
    ; a second copy. Here the abstract fork above never reaches the copy anyway —
    ; it has no abstract construct signature left — but the slot is written as the
    ; reference writes it, because the invariant is the reference's and not this
    ; caller's.
    ;
    ; ★ The three early exits are the reference's, in its order: no construct
    ; signature at all is the type itself, a filled memo is the answer, and a
    ; filter that removed nothing memoises the type as its own copy.
    procedure get_resolved_type_without_abstract_construct_signatures(this, t: ref[Type]) returns ref[Type]?
    {
        let resolved this.resolve_structured_type_members(t)
        if resolved = null
            return null
        let sm resolved as ref[StructuredMembers]
        let ctors this.signature_list_or_empty(this.get_signatures_of_structured_type(t, SignatureKindConstruct))
        let nk ctors.get_length() as int
        if nk = 0
            return t
        if sm.without_abstract_construct_signatures <> null
            return sm.without_abstract_construct_signatures
        let host Page.get(this)
        let kept &Array[ref[Signature]?]^host()
        var i 0
        while i < nk
        {
            let sig ctors[i]
            if sig = null
                return null
            if ((sig as ref[Signature]).flags & SignatureFlagsAbstract) = 0
                kept.add(sig)
            set i: i + 1
        }
        if (kept.get_length() as int) = nk
        {
            set sm.without_abstract_construct_signatures: t
            return t
        }
        let calls this.signature_list_or_empty(this.get_signatures_of_structured_type(t, SignatureKindCall))
        let made this.new_anonymous_type(t.symbol, sm.members, calls, kept, sm.index_infos)
        if made = null
            return null
        let copy made as ref[Type]
        set sm.without_abstract_construct_signatures: copy
        let copy_members this.resolve_structured_type_members(copy)
        if copy_members = null
            return null
        ; ★ never `set (x as ref[T]).f: v` — the cast is a TEMPORARY and the store lands in it (slice 209)
        let copy_members_ref copy_members as ref[StructuredMembers]
        set copy_members_ref.without_abstract_construct_signatures: copy
        copy
    }

    procedure write_type_literal(this, sm: ref[StructuredMembers], calls: ref[Array[ref[Signature]?]], ctors: ref[Array[ref[Signature]?]], reverse_mapped: bool, out: ref[StringBuilder]) returns bool
    {
        ; createTypeNodesFromResolvedType's own checkTruncationLength: past the
        ; budget the members are ONE NotEmittedTypeElement carrying a comment the
        ; type printer strips, and nothing underneath is resolved
        if this.check_truncation_length()
        {
            out.append("{  }")
            this.add_approximate_length(2)
            return true
        }
        out.append("{ ")
        var i 0
        let nc calls.get_length() as int
        while i < nc
        {
            let s calls[i]
            if s = null
                return false
            if this.write_signature_form(s as ref[Signature], SigFormCallSignature, null, out) = false
                return false
            out.append("; ")
            set i: i + 1
        }
        set i: 0
        let nk ctors.get_length() as int
        while i < nk
        {
            let s ctors[i]
            if s = null
                return false
            ; The abstract ones are SKIPPED here rather than written — the fork above
            ; has already refused a type that has any, so this loop's guard is the
            ; reference's line and never fires.
            if ((s as ref[Signature]).flags & SignatureFlagsAbstract) = 0
            {
                if this.write_signature_form(s as ref[Signature], SigFormConstructSignature, null, out) = false
                    return false
                out.append("; ")
            }
            set i: i + 1
        }
        if sm.index_infos <> null
        {
            let infos sm.index_infos as ref[Array[ref[IndexInfo]?]]
            set i: 0
            while i < (infos.get_length() as int)
            {
                let info infos[i]
                if info = null
                    return false
                ; ★★★ A REVERSE-MAPPED TYPE'S INDEX SIGNATURE IS ELIDED, VALUE AND
                ; ALL (slice 160). The reference hands the helper a
                ; createElidedInformationPlaceholder for exactly this type kind, so
                ; `{ [x: string]: number }` prints as `{ [x: string]: any }` — the
                ; value is COMPUTED (the members are resolved, the reverse
                ; inference runs) and then not shown, which is a decision about
                ; the DISPLAY and not about the type.
                if this.write_index_signature_ex(info as ref[IndexInfo], reverse_mapped, out) = false
                    return false
                out.append("; ")
                set i: i + 1
            }
        }
        if sm.properties <> null
        {
            let props sm.properties as ref[Array[ref[Symbol]?]]
            let np props.get_length() as int
            set i: 0
            while i < np
            {
                ; a property list crossing the budget keeps its head and its LAST
                ; property; the elided middle is a trailing comment the printer
                ; strips (noTruncation)
                if this.check_truncation_length()
                {
                    if (i + 1) + 2 < np - 1
                    {
                        let last props[np - 1]
                        if last = null
                            return false
                        if this.write_property_member(last as ref[Symbol], out) = false
                            return false
                        break
                    }
                }
                let p props[i]
                if p = null
                    return false
                if this.write_property_member(p as ref[Symbol], out) = false
                    return false
                set i: i + 1
            }
        }
        out.append("}")
        this.add_approximate_length(2)
        true
    }

    ; getExpandedParameters, at `skipUnionExpanding` — the only shape this printer
    ; asks for, which closes the union branch and leaves the TUPLE one.
    ;
    ; ★★★ THE NOTE THIS REPLACES SAID THE LIST COMES BACK UNCHANGED BECAUSE *the
    ; tuple half of the port does not exist*, AND THAT PREMISE EXPIRED WITHOUT A
    ; WORD. The port mints tuple types and prints tuple labels; what kept the claim
    ; alive was the wall in get_effective_rest_type one chapter over, so every unit
    ; that would have shown the difference stopped before the printer ran. Lifting
    ; that wall (slice 161) turned four units from UNPORTED into a printed
    ; `(...args: [x: number]) => void` where the reference writes `(x: number) =>
    ; void` — §3.5eq exactly, a wrong answer a wall had been covering.
    ;
    ; ★★ AN ELEMENT FLAGGED `Rest` NEEDS createArrayType AND THEREFORE THE LIB
    ; (§3.11), so that one element shape reports; every other flag combination is
    ; answered here.
    procedure get_expanded_parameters(this, sig: ref[Signature]) returns ref[Array[ref[Symbol]?]]?
    {
        if Checker.signature_has_rest_parameter(sig) = false
            return sig.parameters
        if sig.parameters = null
            return sig.parameters
        let ps sig.parameters as ref[Array[ref[Symbol]?]]
        let rest_index (ps.get_length() as int) - 1
        if rest_index < 0
            return sig.parameters
        let rest_symbol ps[rest_index]
        if rest_symbol = null
            return sig.parameters
        let rs rest_symbol as ref[Symbol]
        let mark this.unported_mark()
        let rest_type this.get_type_of_symbol(rs)
        if this.unported_mark() <> mark
            return null
        if rest_type = null
            return sig.parameters
        let rt rest_type as ref[Type]
        if Checker.is_tuple_type(rt) = false
            return sig.parameters
        let target Checker.target_of(rt)
        if target = null
            return sig.parameters
        let tgt target as ref[Type]
        let infos Checker.tuple_element_infos_of(tgt)
        if infos = null
            return sig.parameters
        let element_infos infos as ref[Array[ref[TupleElementInfo]?]]
        let n element_infos.get_length() as int
        let element_types this.get_type_arguments(rt)
        if this.unported_mark() <> mark
            return null
        if element_types = null
            return sig.parameters
        let ets element_types as ref[Array[ref[Type]?]]
        ; getUniqAssociatedNamesFromTupleType. ★The membership test is a LINEAR
        ; SCAN over the names built so far rather than upstream's two maps: the
        ; array is a tuple's element count long, and the `counters` map upstream
        ; keys by the name it has just REPLACED, so a second table would reproduce
        ; a bookkeeping detail that cannot be observed.
        let names &Array[Slice[char]]^host()
        var i 0
        while i < n
        {
            let info element_infos[i]
            if info = null
                return sig.parameters
            names.add(this.get_tuple_element_label(info as ref[TupleElementInfo], rs, i))
            set i: i + 1
        }
        var d 0
        while d < n
        {
            var seen_before false
            var e 0
            while e < d
            {
                if SymbolTable.names_equal(names[e], names[d])
                    set seen_before: true
                set e: e + 1
            }
            if seen_before
            {
                var counter 1
                repeat
                {
                    let candidate Checker.suffixed_decimal_name(host, names[d], true, counter)
                    var taken false
                    var k 0
                    while k < n
                    {
                        if k <> d
                        {
                            if SymbolTable.names_equal(names[k], candidate)
                                set taken: true
                        }
                        set k: k + 1
                    }
                    if taken = false
                    {
                        names.put(d as size_t, candidate)
                        break
                    }
                    set counter: counter + 1
                }
            }
            set d: d + 1
        }
        ; expandSignatureParametersWithTupleMembers — `parameters[0:restIndex]`
        ; followed by one synthesized symbol per tuple element.
        let out &Array[ref[Symbol]?]^host()
        var j 0
        while j < rest_index
        {
            out.add(ps[j])
            set j: j + 1
        }
        var m 0
        while m < n
        {
            let info element_infos[m] as ref[TupleElementInfo]
            let flags info.flags
            var check_flags 0
            if (flags & ElementFlagsVariable) <> 0
                set check_flags: CheckFlagsRestParameter
            else
            {
                if (flags & ElementFlagsOptional) <> 0
                    set check_flags: CheckFlagsOptionalParameter
            }
            let sym this.new_symbol_ex(SymbolFlagsFunctionScopedVariable, names[m], check_flags)
            let links this.value_symbol_link_of(sym)
            if (flags & ElementFlagsRest) <> 0
            {
                let arr this.create_array_type(ets[m])
                if this.unported_mark() <> mark
                    return null
                if arr = null
                    return null
                set links.resolved_type: arr
            }
            else
                set links.resolved_type: ets[m]
            out.add(sym as ref[Symbol])
            set m: m + 1
        }
        out
    }

    ; signatureToSignatureDeclarationHelper, and the emit printer for the five
    ; forms above. `name` is the MethodSignature's property name and is null for
    ; every other form; the question token rides with it, because upstream passes
    ; both through the same options record.
    ;
    ; ★★ THE TYPE-ARGUMENT FORK IN FRONT OF THE TYPE PARAMETERS IS DEAD:
    ; `flags&WriteTypeArgumentsOfSignature` is not in typeToString's mask, so the
    ; `signature.target`/`mapper` branch is never taken and the declared type
    ; parameters are what get written.
    ; enterSignatureScope's one product this printer needs: `if mapper != nil {
    ; b.ctx.mapper = mapper }` over the whole signature declaration, restored
    ; after. Everything else that scope does — the fake parameter scopes, the
    ; type-parameter table — serves accessibility, which is unconditional here
    ; (see the node-REUSE site's header). ★The guard is the reference's: a
    ; signature with no mapper of its own does not CLEAR an outer one, because a
    ; nested signature type is printed inside the outer signature's scope.
    procedure write_signature_form(this, sig: ref[Signature], form: int, name: ref[Symbol]?, out: ref[StringBuilder]) returns bool
    {
        let save_mapper printer_type_mapper
        if sig.mapper <> null
            set printer_type_mapper: sig.mapper
        let answer this.write_signature_form_scoped(sig, form, name, out)
        set printer_type_mapper: save_mapper
        answer
    }

    procedure write_signature_form_scoped(this, sig: ref[Signature], form: int, name: ref[Symbol]?, out: ref[StringBuilder]) returns bool
    {
        this.add_approximate_length(3)
        ; `if kind == KindConstructorType && signature.flags&Abstract != 0` — the
        ; ONE modifier this writer can emit, and it is the CONSTRUCTOR TYPE's
        ; alone: a construct SIGNATURE inside an object type carries no modifier
        ; list upstream. ★★★It was missing until slice 177 and was invisible
        ; because every unit that reaches it — `T extends abstract new (...args:
        ; any) => infer U ? U : never`, the shape `SymbolHasInstance` and the mixin
        ; helpers are written in — stopped at the conditional's `infer` keyword
        ; first. **A printer's missing KEYWORD is a wrong NAME, not a missing one**,
        ; which is why it shows up only as a yardstick diff.
        if form = SigFormConstructorType
        {
            if (sig.flags & SignatureFlagsAbstract) <> 0
                out.append("abstract ")
            out.append("new ")
        }
        if form = SigFormConstructSignature
            out.append("new ")
        if form = SigFormMethodSignature
        {
            if name = null
                return false
            if this.write_property_name_of_symbol(name as ref[Symbol], out) = false
                return false
            if (Symbol.flags_of(name as ref[Symbol]) & SymbolFlagsOptional) <> 0
                out.append("?" as char)
        }
        ; ★The accessor forms take the NAME but not the question mark: upstream
        ; passes `name` and no questionToken, and an accessor cannot be optional.
        var accessor false
        if form = SigFormGetAccessor
        {
            out.append("get ")
            set accessor: true
        }
        if form = SigFormSetAccessor
        {
            out.append("set ")
            set accessor: true
        }
        if accessor
        {
            if name = null
                return false
            if this.write_property_name_of_symbol(name as ref[Symbol], out) = false
                return false
        }
        ; NewGetAccessorDeclaration and NewSetAccessorDeclaration are both handed a
        ; nil typeParamList, so neither writes one.
        if accessor = false
        {
            if this.write_type_parameter_list(sig, out) = false
                return false
        }
        out.append("(" as char)
        var wrote 0
        ; tryGetThisParameterDeclaration, PREPENDED — `this` is a parameter of the
        ; name even though it is not one of the signature's own, which is why
        ; `(this: string, a: number) => void` has two.
        if sig.this_parameter <> null
        {
            if this.write_parameter_declaration(sig.this_parameter as ref[Symbol], out) = false
                return false
            set wrote: wrote + 1
        }
        let params_mark this.unported_mark()
        var expanded this.get_expanded_parameters(sig)
        if this.unported_mark() <> params_mark
            return false
        ; `core.Some(expandedParams, p != last && p.CheckFlags&RestParameter)` —
        ; ★★★ IF THE EXPANSION PUT A VARIADIC ANYWHERE BUT LAST, THE ORIGINAL LIST
        ; IS WHAT GETS WRITTEN, because `(...args: A, ...args_1: B)` is not a
        ; parameter list any parser would accept. That is why upstream expands into
        ; a list it then MAY THROW AWAY, and dropping the test made three units
        ; print exactly that shape where the reference writes `...args: [...A,
        ; ...B]`.
        if expanded <> null
        {
            let ex expanded as ref[Array[ref[Symbol]?]]
            let en ex.get_length() as int
            var variadic_before_last false
            var vi 0
            while vi < (en - 1)
            {
                let ep ex[vi]
                if ep <> null
                {
                    if (Symbol.check_flags_of(ep as ref[Symbol]) & CheckFlagsRestParameter) <> 0
                        set variadic_before_last: true
                }
                set vi: vi + 1
            }
            if variadic_before_last
                set expanded: sig.parameters
        }
        if expanded <> null
        {
            let ps expanded as ref[Array[ref[Symbol]?]]
            var i 0
            while i < (ps.get_length() as int)
            {
                let p ps[i]
                if p = null
                    return false
                if wrote > 0
                    out.append(", ")
                if this.write_parameter_declaration(p as ref[Symbol], out) = false
                    return false
                set wrote: wrote + 1
                set i: i + 1
            }
        }
        out.append(")" as char)
        ; The separator IS the form: a type writes `=>`, a member writes `:`.
        if form = SigFormFunctionType
            out.append(" => ")
        if form = SigFormConstructorType
            out.append(" => ")
        if form = SigFormCallSignature
            out.append(": ")
        if form = SigFormConstructSignature
            out.append(": ")
        if form = SigFormMethodSignature
            out.append(": ")
        if form = SigFormGetAccessor
            out.append(": ")
        ; A SetAccessorDeclaration is built with a nil returnTypeNode, so `set x(v: T)`
        ; ends at the parenthesis.
        if form = SigFormSetAccessor
            return true
        this.write_return_type_of_signature(sig, out)
    }

    ; serializeReturnTypeForSignature, whose whole reuse half is behind
    ; `ctx.enclosingDeclaration != nil` — nil here, so the pseudochecker is never
    ; consulted and the answer is serializeInferredReturnTypeForSignature.
    ;
    ; ★★ `suppressAny` IS FALSE TWICE OVER: SuppressAnyReturnType is not in the mask
    ; AND signatureToSignatureDeclarationHelper clears it before the call. So the
    ; `any` return is written rather than elided, which is what makes `() => any`
    ; the name of an unannotated signature.
    ;
    ; ★★★ THE TYPE-PREDICATE FORK LANDED IN SLICE 134, and until then it was a stop
    ; DETECTED FROM THE DECLARATION rather than from the predicate.
    ; serializeInferredReturnTypeForSignature asks getTypePredicateOfSignature first
    ; and answers `x is T` / `asserts x is T` when there is one; the Signature
    ; record's `resolved_type_predicate` was one of the five slots this port
    ; defers, so the predicate could not be READ, and what could be read was the
    ; ANNOTATION that produces one. ★★★That detection was exact for the DECLARED
    ; predicate and blind to the INFERRED one — a boolean-returning single-return
    ; function carries a predicate with no annotation anywhere — so the stop was
    ; not merely coarse, it MISSED a case while looking precise. See the type
    ; predicate chapter.
    ;
    ; ★ `ctx.mapper` is nil at every entry point this printer has (there is no
    ; instantiating node builder here), so the instantiateTypePredicate fork of
    ; serializeInferredReturnTypeForSignature answers the predicate itself and is
    ; written as that rather than as a branch on a slot nothing sets.
    ;
    ; ★★ `ctx.suppressReportInferenceFallback` HAS NOTHING TO PORT, and that is read
    ; off its READERS rather than guessed from its name: all four sit in
    ; serializeTypeForDeclaration's PSEUDOCHECKER path (`reportErrors :=
    ; !suppressReportInferenceFallback`, then pseudoTypeEquivalentToType), and this
    ; function's own note two paragraphs up already records that the pseudochecker
    ; is never consulted here because ctx.enclosingDeclaration is nil. It is worth
    ; saying because the INFERRED predicate runs a body walk from inside the
    ; printer — checkExpressionCached plus the flow machinery — so a flag named
    ; *suppressReport* standing over that call reads exactly like a diagnostic gate
    ; and is not one.
    ; ★★★ THE RETURN TYPE IS INSTANTIATED THROUGH THE PRINTER'S ACTIVE MAPPER
    ; (slice 218). serializeReturnTypeForSignature reads `instantiateType(
    ; getReturnTypeOfSignature(signature), b.ctx.mapper)` for every signature
    ; that has a declaration, and enterNewScope KEEPS the outer mapper when the
    ; signature entered has none — so a fresh function type printed INSIDE an
    ; instantiated signature (an alias type argument of an unresolved reference,
    ; `ClassMethodDecoratorContext<This, (this: This, ...args: Args) => Return>`)
    ; prints its return type under the outer instantiation (`=> void`) while its
    ; parameters, which symbolToParameterDeclaration reads with a plain
    ; getTypeOfSymbol, stay as declared (`this: This`). The predicate is mapped
    ; the same way (serializeInferredReturnTypeForSignature); the reference asks
    ; the return type BEFORE the predicate, and the order is kept because both
    ; are instantiations with caches.
    procedure write_return_type_of_signature(this, sig: ref[Signature], out: ref[StringBuilder]) returns bool
    {
        let mark this.unported_mark()
        var rt2 this.get_return_type_of_signature(sig)
        if this.unported_mark() <> mark
            return false
        if rt2 = null
            return false
        if sig.declaration <> null
        {
            if printer_type_mapper <> null
            {
                set rt2: this.instantiate_type(rt2, printer_type_mapper)
                if this.unported_mark() <> mark
                    return false
                if rt2 = null
                    return false
            }
        }
        var predicate this.get_type_predicate_of_signature(sig)
        if this.unported_mark() <> mark
            return false
        if predicate <> null
        {
            if printer_type_mapper <> null
            {
                set predicate: this.instantiate_type_predicate(predicate as ref[TypePredicate], printer_type_mapper)
                if this.unported_mark() <> mark
                    return false
                if predicate = null
                    return false
            }
            return this.write_type_predicate(predicate as ref[TypePredicate], out)
        }
        this.type_to_string(rt2, out)
    }

    ; ── slice 134: THE TYPE PREDICATE ────────────────────────────────────────
    ;
    ; ★★★ IT RETIRES A SLOT THIS FILE HAS DEFERRED TWICE. Signature's header lists
    ; `resolved_type_predicate` among the five fields *"whose only writers are
    ; chapters this port has not opened"* and names getTypePredicateOfSignature as
    ; the writer; write_return_type_of_signature stops on the SYMPTOM, detecting a
    ; predicate from its ANNOTATION because the slot could not be read. Both are
    ; this chapter, and it is the fourth field of the five to land.
    ;
    ; ★★★ THERE ARE TWO WAYS TO GET ONE AND ONLY ONE OF THEM IS WRITTEN DOWN IN THE
    ; SOURCE. `function f(x: unknown): x is string` declares its predicate; but a
    ; boolean-returning function with ONE return statement gets a predicate
    ; INFERRED from that return's flow — `function f(x: unknown) { return typeof x
    ; === "string" }` is `x is string` — and the inference is run through the flow
    ; machinery on two synthetic flow nodes, a TrueCondition and a FalseCondition
    ; over the return expression. The `false` half is the part that makes it sound:
    ; *"x is T means that x is T if and only if it returns true"*, so the ELSE
    ; branch must reduce to `never` or there is no predicate.
    ;
    ; ★★ THE `composite` ARM IS NOT WRITTEN AND CANNOT BE. `sig.composite` is one of
    ; the two slots Signature still defers, and its own note calls the arm
    ; *"provably dead for every signature this file can mint"* — nothing here builds
    ; a union or intersection of signatures. The arm is named rather than reported,
    ; because a row for it would be a row no input can reach.
    ;
    ; ★ noTypePredicate is a SENTINEL and not a null: *asked, none* has to differ
    ; from *not asked*, which is what the `type_predicate_computed` flag already
    ; says one slot up. Both are kept — the flag is what this port's readers use,
    ; the sentinel is what the reference's `== c.noTypePredicate` test reads — and
    ; they agree by construction, because the only writer sets both.

    ; ★★★ THE THREE FUNCTIONS THIS CHAPTER LOOKED LIKE IT NEEDED WERE ALREADY
    ; HERE, and the note that sent this slice looking for them is what was expired:
    ; write_return_type_of_signature's header said `resolved_type_predicate` *"is
    ; one of the five slots this port defers"*, while getTypePredicateOfSignature,
    ; createTypePredicateFromTypePredicateNode and instantiateTypePredicate have
    ; stood in the relation's own chapter since slice 123 — see them beside
    ; has_type_predicate_or_never_return_type. What was missing is ONE ARM of the
    ; first (`get-type-predicate-from-body`) and the PRINTER's use of it.
    ;
    ; ★★★ AND THE COMPILER SAID NOTHING WHEN THIS SLICE WROTE ALL THREE A SECOND
    ; TIME: a duplicate METHOD in one concept compiles, one of the two is emitted,
    ; and `tests/run.sh`'s duplicate scan covers only TOP-LEVEL `define`s. **Grep
    ; the source for every reference function name before writing it** — §3.5fo's
    ; rule about reading the reference applies to reading the PORT as well.

    ; getTypePredicateFromBody — the INFERRED predicate.
    ;
    ; ★★ "Only attempt to infer a type predicate if there's exactly one return."
    ; An arrow with an expression body IS that one return; a block body is walked,
    ; and the walk bails on the SECOND return, on a bare `return;` and on a
    ; function that can fall off its end.
    procedure get_type_predicate_from_body(this, fn: ref[AstNode]) returns ref[TypePredicate]?
    {
        let k AstNode.kind_of(fn)
        if k = KindConstructor
            return null
        if Checker.is_accessor_kind(k)
            return null
        if b.get_function_flags(fn) <> FunctionFlagsNormal
            return null
        let mark this.unported_mark()
        let body AstNode.body_of(fn)
        var single_return: ref[AstNode]? null
        if body = null
            return null
        if AstNode.kind_of(body as ref[AstNode]) <> KindBlock
            set single_return: body
        else
        {
            var bailed_early false
            this.find_single_return_expression(body as ref[AstNode], &single_return, &bailed_early)
            if bailed_early
                return null
            if single_return = null
                return null
            if this.function_has_implicit_return(fn)
                return null
            if this.unported_mark() <> mark
                return null
        }
        this.check_if_expression_refines_any_parameter(fn, single_return as ref[AstNode])
    }

    ; ast.ForEachReturnStatement over getTypePredicateFromBody's visitor, fused the
    ; way for_each_return_statement_is_context_sensitive is (§3.9d: the visitor
    ; does not survive as a closure, so the walk carries the state).
    ;
    ; ★ THE KIND LIST IS THE WALK'S WHOLE DEFINITION and it is the reference's: a
    ; return inside a NESTED FUNCTION belongs to that function, so the descent
    ; enters only the statement forms — block, if, the loops, `with`, switch and
    ; its clauses, a label, try and catch.
    procedure find_single_return_expression(this, node: ref[AstNode], out_expr: ref[ref[AstNode]?], out_bailed: ref[bool])
    {
        let k AstNode.kind_of(node)
        if k = KindReturnStatement
        {
            ; `if singleReturn != nil || returnStatement.Expression() == nil {
            ; return true }` — the visitor's TRUE is the bail.
            ;
            ; ★ The cell is read in TWO STEPS, per CLAUDE.md: `out_expr = null`
            ; takes the NPO presence-test path and never loads, so it answers false
            ; for a cell that holds null and the walk would bail on the FIRST
            ; return.
            let seen: ref[AstNode]? out_expr
            if seen <> null
                set out_bailed: true
            if AstNode.expression_of(node) = null
                set out_bailed: true
            if out_bailed
                return
            set out_expr: AstNode.expression_of(node)
            return
        }
        ; ★ The kind list is kind_can_contain_return_statement, which
        ; for_each_return_statement_is_context_sensitive already carries: ONE
        ; reference function walked by two visitors, so the SET is shared and only
        ; the visitor differs (§3.5dm's rule for a third caller).
        if Checker.kind_can_contain_return_statement(k) = false
            return
        let n AstNode.child_count(node)
        var i 0
        while i < n
        {
            let child AstNode.child_at(node, i)
            set i: i + 1
            if child = null
                continue
            this.find_single_return_expression(child as ref[AstNode], out_expr, out_bailed)
            if out_bailed
                return
        }
    }


    ; checkIfExpressionRefinesAnyParameter.
    ;
    ; ★ THE FOUR SKIPS ARE THE REFERENCE'S, and the boolean one carries its
    ; comment: *"refining `x: boolean` to `x is true` or `x is false` isn't
    ; useful."* The other three are an assigned parameter (its declared type is not
    ; what a caller sees), a rest parameter and a parameter whose name is a binding
    ; pattern — none of which a predicate can name.
    procedure check_if_expression_refines_any_parameter(this, fn: ref[AstNode], expr_in: ref[AstNode]) returns ref[TypePredicate]?
    {
        let mark this.unported_mark()
        let expr Checker.skip_parentheses(expr_in)
        let return_type this.check_expression_cached(expr)
        if this.unported_mark() <> mark
            return null
        if return_type = null
            return null
        if ((return_type as ref[Type]).flags & TypeFlagsBoolean) = 0
            return null
        let params AstNode.parameters_of(fn)
        let count AstNode.list_count(params)
        var i 0
        while i < count
        {
            let row AstNode.child_in_list(params, i)
            set i: i + 1
            if row = null
                continue
            let param row as ref[AstNode]
            let sym AstNode.symbol_of(param)
            if sym = null
                continue
            let init_type this.get_type_of_symbol(sym as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            if init_type = null
                continue
            if ((init_type as ref[Type]).flags & TypeFlagsBoolean) <> 0
                continue
            let name AstNode.name_of(param)
            if Checker.kind_or_unknown(name) <> KindIdentifier
                continue
            ; ★ The mark is read BEFORE the verdict is acted on: a stop inside
            ; is_symbol_assigned that answered TRUE would `continue` and skip the
            ; parameter silently, which is a wrong predicate rather than a stop.
            let assigned this.is_symbol_assigned(sym as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            if assigned
                continue
            if Checker.is_rest_parameter(param)
                continue
            let true_type this.check_if_expression_refines_parameter(fn, expr, param, init_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if true_type <> null
            {
                let nm name as ref[AstNode]
                ; `c.newTypePredicate(TypePredicateKindIdentifier, param.Name()
                ; .Text(), int32(i), trueType)` — constructed the way this file's
                ; two other producers do, positionally (kind, index, name, len, t).
                return &TypePredicate^this(TypePredicateKindIdentifier, i - 1, AstNode.identifier_text_of(nm), true_type)
            }
        }
        null
    }

    ; checkIfExpressionRefinesParameter — the flow question, asked twice on two
    ; synthetic flow nodes.
    ;
    ; ★★★ THE `false` HALF IS WHAT MAKES IT SOUND and the reference states it:
    ; *"`x is T` means that x is T if and only if it returns true. If it returns
    ; false then x is not T. This means that if the function is called with an
    ; argument of type trueType, there can't be anything left in the `else` branch.
    ; It must reduce to never."* So a true-branch narrowing alone is not enough —
    ; `function f(x: unknown) { return typeof x === "string" || x === 1 }` narrows
    ; the true branch and leaves `number` in the false one, and is NOT a predicate.
    ;
    ; ★ The START node stands in for a return whose flow the binder did not label,
    ; which is the reference's `&ast.FlowNode{Flags: FlowFlagsStart}`.
    procedure check_if_expression_refines_parameter(this, fn: ref[AstNode], expr: ref[AstNode], param: ref[AstNode], init_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        var antecedent Checker.get_flow_node_of_node(expr)
        if antecedent = null
        {
            let parent AstNode.parent_node_of(expr)
            if Checker.kind_or_unknown(parent) = KindReturnStatement
                set antecedent: Checker.get_flow_node_of_node(parent)
        }
        if antecedent = null
            set antecedent: this.new_checker_flow_node(FlowFlagsStart, null, null)
        let name AstNode.name_of(param)
        if name = null
            return null
        let reference name as ref[AstNode]
        let true_condition this.new_checker_flow_node(FlowFlagsTrueCondition, expr, antecedent)
        let true_type this.get_flow_type_of_reference_ex(reference, init_type, init_type, fn, true_condition)
        if this.unported_mark() <> mark
            return null
        if true_type = null
            return null
        let tt true_type as ref[Type]
        if tt = init_type
            return null
        let false_condition this.new_checker_flow_node(FlowFlagsFalseCondition, expr, antecedent)
        let false_type this.get_flow_type_of_reference_ex(reference, init_type, tt, fn, false_condition)
        if this.unported_mark() <> mark
            return null
        if false_type = null
            return null
        let false_subtype this.get_reduced_type(false_type as ref[Type])
        if this.unported_mark() <> mark
            return null
        if false_subtype = null
            return null
        if ((false_subtype as ref[Type]).flags & TypeFlagsNever) <> 0
            return tt
        null
    }

    ; The checker's own flow-node mint. The BINDER has one (new_flow_node_ex) and
    ; it is on the binder, so the three nodes this chapter needs — a Start and the
    ; two conditions — get the same three lines here rather than a cross-object
    ; call: these nodes are not part of the file's flow GRAPH, they are arguments.
    procedure new_checker_flow_node(this, flags: int, node: ref[AstNode]?, antecedent: ref[FlowNode]?) returns ref[FlowNode]
    {
        set flow_nodes_allocated: flow_nodes_allocated + 1
        let f FlowNode.alloc(host)
        set f.flags: flags
        set f.node: node
        set f.antecedent: antecedent
        set f.antecedents: null
        f
    }

    ; typePredicateToTypePredicateNodeHelper, as this file writes a text:
    ; `[asserts ]<name|this>[ is <T>]`.
    ;
    ; ★ THE TYPE IS OPTIONAL AND ONLY FOR AN `asserts`: `asserts x` is a valid
    ; predicate with no type at all, which is why the ` is ` is inside the guard.
    procedure write_type_predicate(this, predicate: ref[TypePredicate], out: ref[StringBuilder]) returns bool
    {
        var asserts false
        if predicate.kind = TypePredicateKindAssertsThis
            set asserts: true
        if predicate.kind = TypePredicateKindAssertsIdentifier
            set asserts: true
        if asserts
            out.append("asserts ")
        var identifier false
        if predicate.kind = TypePredicateKindIdentifier
            set identifier: true
        if predicate.kind = TypePredicateKindAssertsIdentifier
            set identifier: true
        if identifier
            out.append(predicate.parameter_name.data, predicate.parameter_name.length)
        else
            out.append("this")
        if predicate.t = null
            return true
        out.append(" is ")
        this.type_to_string(predicate.t, out)
    }

    ; The type-parameter list, `<T, U extends V = W>`.
    ;
    ; ★ typeParameterToDeclaration's three parts are the NAME, the constraint and
    ; the default, and the two modifiers in front of them (`in` / `out`) come from
    ; getTypeParameterVariances, which needs the variance computation. A variance
    ; annotation is source syntax, so it is READ off the declaration rather than
    ; recomputed — and where it is present this stops, because the modifier order
    ; upstream is the computed one.
    procedure write_type_parameter_list(this, sig: ref[Signature], out: ref[StringBuilder]) returns bool
    {
        if sig.type_parameters = null
            return true
        let tps sig.type_parameters as ref[Array[ref[Type]?]]
        let n tps.get_length() as int
        if n = 0
            return true
        out.append("<" as char)
        var i 0
        while i < n
        {
            if i > 0
                out.append(", ")
            let tp tps[i]
            if tp = null
                return false
            if this.write_type_parameter_declaration(tp as ref[Type], out) = false
                return false
            set i: i + 1
        }
        out.append(">" as char)
        true
    }

    ; ── the printer's ONE node-REUSE site (slice 169) ────────────────────────
    ;
    ; typeToTypeNodeHelperWithPossibleReusableTypeNode, tryReuseExistingNodeHelper
    ; and the visitor behind it (`nodecopy.go`), plus the emitter's TYPE-NODE arms,
    ; which are what a reused node is printed BY. Until this slice the site was six
    ; shape-scoped stops and the units behind them were `frontier.sh`'s head.
    ;
    ; ★★★ THE CONTEXT IS WHAT MAKES IT AFFORDABLE, AND IT IS A MEASUREMENT AND NOT
    ; A SIMPLIFICATION. This printer is `TypeToString(t)`, whose enclosing
    ; declaration is NIL, and `isSymbolAccessibleWorker` answers ACCESSIBLE
    ; unconditionally when it is — `if symbol != nil && enclosingDeclaration != nil`
    ; guards its whole body. So the accessibility half of trackExistingEntityName
    ; (IsSymbolAccessible, getAccessibleSymbolChain, hasVisibleDeclarations, and the
    ; symbol-at-location cross-check that sits behind the same `!= nil`) cannot
    ; introduce an error here, and `ctx.mapper` is nil for the same reason, which
    ; closes the remapped-type-parameter refusal in tryVisitTypeReference. What is
    ; left of the entity-name walk is the JS `exports` shapes and the NAME — and the
    ; name is the identifier's TEXT either way, because
    ; attachSymbolToLeftmostIdentifier rebuilds the leftmost identifier from
    ; `node.Text()` and typeParameterToName reduces to the symbol's own name (its
    ; uniquifying loop is behind GenerateNamesForShadowedTypeParams, which
    ; typeToString does not set).
    ; ★★★ THE DAY AN ENCLOSING DECLARATION REACHES THIS PRINTER, EVERY ONE OF THOSE
    ; DOORS OPENS AND THIS PARAGRAPH IS THE LIST.
    ;
    ; ★★★ A REFUSAL IS LOCAL AND NOT FATAL, and reading it the other way is what
    ; made the six stops look like the only option. The visitor wraps every node in
    ; a recovery scope and the fallback is per NODE:
    ;
    ;     if bound.hadError { if IsTypeNode(node) && !IsTypePredicateNode(node) {
    ;         bound.endRecoveryScope(recover_)          ; the error is UNDONE
    ;         return b.typeToTypeNode(b.getTypeFromTypeNode(node, false)) } }
    ;
    ; so a node that cannot be reused is replaced by its own CANONICAL name while
    ; the tree around it is still reused. `<T extends unique symbol>` is the proof:
    ; the reference prints `symbol` — the canonical name — inside a reuse that
    ; SUCCEEDED. Only an error raised where no type node encloses it (a computed
    ; property name, a type predicate) travels further, and it travels exactly to
    ; the nearest enclosing type node.
    ;
    ; ★★ SO THE WRITER IS A PREDICATE PLUS AN EMITTER RATHER THAN ONE FUNCTION, and
    ; the reason is the buffer: the reference discards a NODE, this port would have
    ; to discard BYTES, and a StringBuilder cannot be rolled back.
    ;
    ; ★★ EVERY FORMAT BELOW IS READ OFF THE ORACLE AND NOT OFF THE EMITTER. Three
    ; probe fixtures over sixty constraint shapes fixed the whole table — `{ ` … `; }`
    ; for a type literal, `new ` with its space, the SOURCE's own quotes on a string
    ; literal, `-readonly`/`-?` on a mapped type, and `keyof (X)` KEEPING its
    ; parentheses, because `ast.SkipParentheses` in tryVisitSimpleTypeNode skips
    ; parenthesized EXPRESSIONS and a ParenthesizedType is not one.
    ;
    ; ★ IDENTIFIER ESCAPING IS NOT PORTED: the printer writes a non-ASCII identifier
    ; as `\uXXXX` unless EFNoAsciiEscaping is on it, which the visitor sets on the
    ; leftmost identifier of an entity name and on nothing else. Every identifier
    ; here is written as its text, so a non-ASCII name in a constraint is a FAIL and
    ; not a silence.
    ; `b.getTypeFromTypeNode(node, false)` — the type of an EXISTING node as the
    ; printer sees it, which is the checker's answer put through the context's
    ; mapper. The `noMappedTypes` half has no caller here.
    procedure printer_type_of_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let t this.get_type_from_type_node(node)
        if printer_type_mapper = null
            return t
        this.instantiate_type(t, printer_type_mapper)
    }

    procedure write_possibly_reused_type_node(this, t: ref[Type]?, node: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if t = null
            return Checker.write_keyword(out, "any")
        let tt t as ref[Type]
        ; isActivelyExpanding: maxExpansionDepth is a hover/verbosity slot this
        ; printer does not carry, so it is false.
        if node <> null
        {
            let nd node as ref[AstNode]
            let mark this.unported_mark()
            let nt this.printer_type_of_type_node(nd)
            if this.unported_mark() <> mark
                return false
            if nt <> null
            {
                if (nt as ref[Type]) = tt
                {
                    ; tryReuseExistingNodeHelper: the boundary restores the estimate
                    ; and the reused node counts its SOURCE width
                    let saved_approx printer_approximate_length
                    let reused this.write_reused_node(nd, out)
                    set this.printer_approximate_length: saved_approx + (AstNode.end_of(nd) - AstNode.pos_of(nd))
                    return reused
                }
            }
        }
        this.type_to_string(tt, out)
    }

    ; The visitor's per-node fork.
    procedure write_reused_node(this, node: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        let mark this.unported_mark()
        let fails this.type_node_reuse_fails(node)
        if this.unported_mark() <> mark
            return false
        if fails
        {
            ; `return b.typeToTypeNode(b.getTypeFromTypeNode(node, false))` — the
            ; fallback asks the node's type THROUGH the context mapper, which is
            ; what turns the `T` inside a reused `keys2<T, K1>` into `Foo`.
            let t this.printer_type_of_type_node(node)
            if this.unported_mark() <> mark
                return false
            return this.type_to_string(t, out)
        }
        this.write_reused_type_node(node, out)
    }

    ; Whether the visitor raises an error ON this node — the four `tryVisit*`
    ; helpers answering nil, the `unique symbol` scope test and the import type's
    ; two guards. An error UNDER it is absorbed by the nearest enclosing type node,
    ; which is why this asks about one node.
    ; the recovery boundary of a type literal: a kept member whose computed name
    ; introduces an error (markError) makes the literal serialize from its type
    procedure type_literal_reuse_fails(this, node: ref[AstNode]) returns bool
    {
        let members AstNode.member_list_of(node)
        if members = null
            return false
        let l members as ref[Array[ref[AstNode]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            let mo l[i]
            if mo <> null
            {
                let m mo as ref[AstNode]
                if this.reused_member_is_removed(m) = false
                {
                    let name AstNode.name_of(m)
                    if name <> null
                    {
                        if AstNode.kind_of(name as ref[AstNode]) = KindComputedPropertyName
                        {
                            let expr AstNode.expression_of(name as ref[AstNode])
                            if expr <> null
                            {
                                if Checker.is_entity_name_expression(expr as ref[AstNode])
                                {
                                    if this.entity_name_introduces_error(expr)
                                        return true
                                }
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    procedure type_node_reuse_fails(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindTypeReference
            return this.reference_reuse_fails(node)
        if k = KindTypeLiteral
            return this.type_literal_reuse_fails(node)
        if k = KindTypeQuery
            return this.entity_name_introduces_error(AstNode.type_query_expr_name_of(node))
        if k = KindIndexedAccessType
            return this.simple_type_node_reuse_fails(AstNode.indexed_access_object_type_of(node))
        if k = KindTypeOperator
        {
            let op AstNode.type_operator_operator_of(node)
            let inner AstNode.type_operator_inner_of(node)
            if op = KindUniqueKeyword
            {
                ; getEnclosingDeclarationIgnoringFakeScope answers nil here, so
                ; FindAncestor finds no same-scope ancestor and the arm always
                ; refuses. Measured: the reference prints the canonical `symbol`.
                if inner = null
                    return false
                return AstNode.kind_of(inner as ref[AstNode]) = KindSymbolKeyword
            }
            if op = KindKeyOfKeyword
                return this.simple_type_node_reuse_fails(inner)
            return false
        }
        if k = KindImportType
        {
            ; The deprecated `assert` attribute keyword, and a specifier whose type
            ; does not resolve.
            let attrs AstNode.import_type_attributes_of(node)
            if attrs <> null
            {
                if AstNode.import_attributes_token_of(attrs as ref[AstNode]) = KindAssertKeyword
                    return true
            }
            let mark this.unported_mark()
            let t this.get_type_from_type_node(node)
            if this.unported_mark() <> mark
                return false
            return t = null
        }
        false
    }

    ; tryVisitTypeReference's four refusals.
    procedure reference_reuse_fails(this, node: ref[AstNode]) returns bool
    {
        if this.is_const_type_reference(node)
            return true
        ; tryGetResolvedSymbolFromTypeNode: the type is asked FIRST, to resolve the
        ; symbol, and the answer is then read off the node's own links.
        let t this.get_type_from_type_node(node)
        let sym this.get_resolved_symbol_or_nil(node)
        if sym = null
            return true
        ; `s.Flags&TypeParameter != 0 && ctx.mapper != nil && ctx.mapper.Map(declared)
        ; != declared` — a reference to a type parameter this printing context
        ; REMAPS cannot be reused: the source writes the parameter's name and the
        ; printer owes the type it is mapped to. The per-node fallback above writes
        ; that type, which is the whole mechanism by which an instantiated
        ; constraint keeps its alias and still shows its arguments.
        if printer_type_mapper <> null
        {
            if (Symbol.flags_of(sym as ref[Symbol]) & SymbolFlagsTypeParameter) <> 0
            {
                let declared this.get_declared_type_of_symbol(sym as ref[Symbol])
                if declared <> null
                {
                    let mapped this.type_mapper_map(printer_type_mapper as ref[TypeMapper], declared)
                    if mapped <> null
                    {
                        if (mapped as ref[Type]) <> (declared as ref[Type])
                            return true
                    }
                }
            }
        }
        ; canReuseExistingJSTypeNode.
        if this.get_intended_type_from_jsdoc_type_reference(node) <> null
            return true
        if t <> null
        {
            if this.reference_type_argument_count_is_incompatible(node, t as ref[Type])
                return true
        }
        ; serializeTypeName is not ported, so an entity name that introduces an
        ; error refuses here where the reference would try to serialize it.
        this.entity_name_introduces_error(AstNode.type_reference_name_of(node))
    }

    ; existingTypeNodeIsNotReferenceOrIsReferenceWithCompatibleTypeArgumentCount,
    ; read as the refusal it feeds. Upstream's own comment says what it is for: *In
    ; JS, you can say something like `Foo` and get a `Foo<any>` implicitly - we
    ; don't want to preserve that original `Foo`*.
    procedure reference_type_argument_count_is_incompatible(this, node: ref[AstNode], t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return false
        let sym this.get_resolved_symbol_or_nil(node)
        if sym = null
            return false
        let existing_target this.get_declared_type_of_symbol(sym as ref[Symbol])
        if existing_target = null
            return false
        let target Checker.target_of(t)
        if target = null
            return false
        if (existing_target as ref[Type]) <> (target as ref[Type])
            return false
        var written 0
        let args AstNode.type_reference_arguments_of(node)
        if args <> null
            set written: (args as ref[Array[ref[AstNode]?]]).get_length() as int
        written < this.min_type_argument_count_of_target(target as ref[Type])
    }

    ; getMinTypeArgumentCount(target.TypeParameters()) — the same loop
    ; get_min_type_argument_count runs, bounded by the count that accessor answers,
    ; because `TypeParameters()` is allTypeParameters WITHOUT the trailing thisType
    ; and this port has no slicing accessor for it.
    function min_type_argument_count_of_target(this, tgt: ref[Type]) returns int
    {
        let all Checker.all_type_parameters_of(tgt)
        if all = null
            return 0
        let list all as ref[Array[ref[Type]?]]
        let n Checker.type_parameter_count_of(tgt)
        var min_count 0
        var i 0
        while i < n
        {
            let tp list[i]
            if tp <> null
            {
                if Checker.has_type_parameter_default(tp as ref[Type]) = false
                    set min_count: i + 1
            }
            set i: i + 1
        }
        min_count
    }

    ; tryVisitSimpleTypeNode, whose caller (a keyof or an indexed access) refuses
    ; WHOLESALE when the operand refuses — where the ordinary path would have let
    ; the operand alone fall back to its canonical name.
    ;
    ; ★ The `SkipParentheses` in front of the reference's switch is the identity for
    ; a type node (it skips parenthesized EXPRESSIONS), which is why a
    ; ParenthesizedType operand takes the ordinary path and keeps its parentheses.
    procedure simple_type_node_reuse_fails(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let nd node as ref[AstNode]
        let k AstNode.kind_of(nd)
        if k = KindTypeReference
            return this.reference_reuse_fails(nd)
        if k = KindTypeQuery
            return this.entity_name_introduces_error(AstNode.type_query_expr_name_of(nd))
        if k = KindIndexedAccessType
            return this.simple_type_node_reuse_fails(AstNode.indexed_access_object_type_of(nd))
        if k = KindTypeOperator
        {
            if AstNode.type_operator_operator_of(nd) = KindKeyOfKeyword
                return this.simple_type_node_reuse_fails(AstNode.type_operator_inner_of(nd))
        }
        false
    }

    ; trackExistingEntityName's `introducesError`, reduced to what can set it in
    ; this printer's context: the three JavaScript `exports` shapes. The header
    ; above says why the accessibility half cannot fire.
    function entity_name_introduces_error(this, name: ref[AstNode]?) returns bool
    {
        if name = null
            return false
        let nd name as ref[AstNode]
        if Parser.is_in_js_file(nd) = false
            return false
        let leftmost Checker.get_first_identifier(nd)
        if leftmost = null
            return false
        let lm leftmost as ref[AstNode]
        if Parser.is_exports_identifier(lm)
            return true
        let p AstNode.parent_node_of(lm)
        if p = null
            return false
        let pp p as ref[AstNode]
        if Parser.is_module_exports_access_expression(pp)
            return true
        if AstNode.kind_of(pp) = KindQualifiedName
        {
            if Parser.is_module_identifier(AstNode.qualified_left_of(pp))
            {
                if Parser.is_exports_identifier(AstNode.qualified_right_of(pp))
                    return true
            }
        }
        false
    }

    ; ── the emitter's type-node arms ─────────────────────────────────────────
    ;
    ; A kind with no arm REPORTS. Falling through to the canonical name instead
    ; would be the silent wrong answer the six stops this replaces existed to
    ; prevent: the reference reuses the node, so a canonical name here is a
    ; different text with nothing to say so.
    procedure write_reused_type_node(this, node: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindTypeReference
        {
            let nm AstNode.type_reference_name_of(node)
            ; A type reference whose name is the EMPTY identifier is `any`.
            if nm <> null
            {
                let n2 nm as ref[AstNode]
                if AstNode.kind_of(n2) = KindIdentifier
                {
                    if AstNode.identifier_text_of(n2).length = 0
                        return Checker.write_keyword(out, "any")
                }
            }
            if this.write_reused_entity_name(nm, out) = false
                return false
            return this.write_reused_type_arguments(AstNode.type_reference_arguments_of(node), out)
        }
        if k = KindTypeQuery
        {
            out.append("typeof ")
            if this.write_reused_entity_name(AstNode.type_query_expr_name_of(node), out) = false
                return false
            return this.write_reused_type_arguments(AstNode.type_arguments_of(node), out)
        }
        if k = KindParenthesizedType
        {
            out.append("(" as char)
            if this.write_reused_child(AstNode.parenthesized_type_inner_of(node), out) = false
                return false
            out.append(")" as char)
            return true
        }
        ; The reuse visitor's JSDoc arms (nodecopy.go's visitExistingNodeTreeSymbols,
        ; slice 202, `expressionWithJSDocTypeArguments`): a nullable is `T | null`,
        ; an optional `T | undefined`, a non-nullable its type, a variadic `T[]`,
        ; the `*` type `any`, and a type expression is unwrapped.
        if k = KindJSDocNullableType
        {
            if this.write_reused_synthesized_union_member(AstNode.type_of(node), out) = false
                return false
            out.append(" | null")
            return true
        }
        if k = KindJSDocOptionalType
        {
            if this.write_reused_synthesized_union_member(AstNode.type_of(node), out) = false
                return false
            out.append(" | undefined")
            return true
        }
        if k = KindJSDocNonNullableType
            return this.write_reused_child(AstNode.type_of(node), out)
        if k = KindJSDocVariadicType
        {
            if this.write_reused_child(AstNode.jsdoc_variadic_inner_of(node), out) = false
                return false
            out.append("[]")
            return true
        }
        if k = KindJSDocAllType
            return Checker.write_keyword(out, "any")
        if k = KindJSDocTypeExpression
            return this.write_reused_child(AstNode.type_of(node), out)
        if k = KindArrayType
        {
            if this.write_reused_child(AstNode.array_element_type_of(node), out) = false
                return false
            out.append("[]")
            return true
        }
        if k = KindOptionalType
        {
            if this.write_reused_child(AstNode.optional_type_inner_of(node), out) = false
                return false
            out.append("?" as char)
            return true
        }
        if k = KindRestType
        {
            out.append("...")
            return this.write_reused_child(AstNode.rest_type_inner_of(node), out)
        }
        if k = KindUnionType
            return this.write_reused_type_list(AstNode.type_list_of(node), " | ", out)
        if k = KindIntersectionType
            return this.write_reused_type_list(AstNode.type_list_of(node), " & ", out)
        if k = KindTupleType
        {
            out.append("[" as char)
            if this.write_reused_type_list(AstNode.type_list_of(node), ", ", out) = false
                return false
            out.append("]" as char)
            return true
        }
        if k = KindTypeOperator
        {
            let op AstNode.type_operator_operator_of(node)
            if op = KindKeyOfKeyword
                out.append("keyof ")
            if op = KindReadonlyKeyword
                out.append("readonly ")
            if op = KindUniqueKeyword
                out.append("unique ")
            if this.type_operator_keyword_is_known(op) = false
            {
                this.record_unported("type-to-string-reused-node-kind", op)
                return false
            }
            return this.write_reused_child(AstNode.type_operator_inner_of(node), out)
        }
        if k = KindIndexedAccessType
        {
            if this.write_reused_child(AstNode.indexed_access_object_type_of(node), out) = false
                return false
            out.append("[" as char)
            if this.write_reused_child(AstNode.indexed_access_index_type_of(node), out) = false
                return false
            out.append("]" as char)
            return true
        }
        if k = KindConditionalType
        {
            if this.write_reused_child(AstNode.conditional_check_type_of(node), out) = false
                return false
            out.append(" extends ")
            if this.write_reused_child(AstNode.conditional_extends_type_of(node), out) = false
                return false
            out.append(" ? ")
            if this.write_reused_child(AstNode.conditional_true_type_of(node), out) = false
                return false
            out.append(" : ")
            return this.write_reused_child(AstNode.conditional_false_type_of(node), out)
        }
        if k = KindInferType
        {
            out.append("infer ")
            return this.write_reused_type_parameter(AstNode.infer_type_parameter_of(node), out)
        }
        if k = KindThisType
            return Checker.write_keyword(out, "this")
        if k = KindLiteralType
            return this.write_reused_literal(AstNode.literal_type_inner_of(node), out)
        if k = KindTypeLiteral
            return this.write_reused_members(AstNode.member_list_of(node), out)
        if k = KindMappedType
            return this.write_reused_mapped_type(node, out)
        if k = KindTemplateLiteralType
            return this.write_reused_template_literal_type(node, out)
        if k = KindNamedTupleMember
        {
            if AstNode.named_tuple_member_dotdotdot_of(node) <> null
                out.append("...")
            if this.write_identifier_name(AstNode.name_of(node), out) = false
                return false
            if AstNode.named_tuple_member_question_token_of(node) <> null
                out.append("?" as char)
            out.append(": ")
            return this.write_reused_child(AstNode.type_of(node), out)
        }
        if k = KindFunctionType
        {
            if this.write_reused_type_parameter_list(AstNode.type_parameters_of(node), out) = false
                return false
            if this.write_reused_parameters(AstNode.parameters_of(node), out) = false
                return false
            out.append(" => ")
            return this.write_reused_child(AstNode.type_of(node), out)
        }
        if k = KindConstructorType
        {
            if this.write_reused_modifiers(AstNode.modifiers_of(node), out) = false
                return false
            out.append("new ")
            if this.write_reused_type_parameter_list(AstNode.type_parameters_of(node), out) = false
                return false
            if this.write_reused_parameters(AstNode.parameters_of(node), out) = false
                return false
            out.append(" => ")
            return this.write_reused_child(AstNode.type_of(node), out)
        }
        if k = KindTypePredicate
        {
            if AstNode.type_predicate_asserts_modifier_of(node) <> null
                out.append("asserts ")
            let pn AstNode.type_predicate_parameter_name_of(node)
            if pn <> null
            {
                if AstNode.kind_of(pn as ref[AstNode]) = KindThisType
                    out.append("this")
                if AstNode.kind_of(pn as ref[AstNode]) <> KindThisType
                {
                    if this.write_identifier_name(pn, out) = false
                        return false
                }
            }
            let pt AstNode.type_of(node)
            if pt = null
                return true
            out.append(" is ")
            return this.write_reused_child(pt, out)
        }
        if k = KindImportType
        {
            if AstNode.import_type_is_type_of(node)
                out.append("typeof ")
            out.append("import(")
            if this.write_reused_child(AstNode.import_type_argument_of(node), out) = false
                return false
            out.append(")" as char)
            let q AstNode.import_type_qualifier_of(node)
            if q <> null
            {
                out.append("." as char)
                if this.write_reused_entity_name(q, out) = false
                    return false
            }
            return this.write_reused_type_arguments(AstNode.type_arguments_of(node), out)
        }
        this.write_reused_keyword_type(k, out)
    }

    function type_operator_keyword_is_known(this, op: int) returns bool
    {
        if op = KindKeyOfKeyword
            return true
        if op = KindReadonlyKeyword
            return true
        if op = KindUniqueKeyword
            return true
        false
    }

    ; The keyword type nodes, which the printer emits as their own token text.
    procedure write_reused_keyword_type(this, k: int, out: ref[StringBuilder]) returns bool
    {
        if k = KindAnyKeyword
            return Checker.write_keyword(out, "any")
        if k = KindUnknownKeyword
            return Checker.write_keyword(out, "unknown")
        if k = KindStringKeyword
            return Checker.write_keyword(out, "string")
        if k = KindNumberKeyword
            return Checker.write_keyword(out, "number")
        if k = KindBigIntKeyword
            return Checker.write_keyword(out, "bigint")
        if k = KindBooleanKeyword
            return Checker.write_keyword(out, "boolean")
        if k = KindSymbolKeyword
            return Checker.write_keyword(out, "symbol")
        if k = KindVoidKeyword
            return Checker.write_keyword(out, "void")
        if k = KindUndefinedKeyword
            return Checker.write_keyword(out, "undefined")
        if k = KindNeverKeyword
            return Checker.write_keyword(out, "never")
        if k = KindObjectKeyword
            return Checker.write_keyword(out, "object")
        if k = KindIntrinsicKeyword
            return Checker.write_keyword(out, "intrinsic")
        this.record_unported("type-to-string-reused-node-kind", k)
        false
    }

    ; A CHILD type node: the fork again, so a child that refuses falls back to its
    ; own canonical name inside a tree that is still reused.
    procedure write_reused_child(this, node: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if node = null
            return Checker.write_keyword(out, "any")
        this.write_reused_node(node as ref[AstNode], out)
    }

    ; A member of a union the visitor BUILT (the JSDoc arms above): the printer's
    ; parenthesizer wraps a union, a function or constructor type and a
    ; conditional type inside a union constituent — `??string` is
    ; `(string | null) | null`. A source union never needs this, because the
    ; parser already holds its parentheses as ParenthesizedType nodes.
    procedure write_reused_synthesized_union_member(this, child: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if child = null
            return this.write_reused_child(child, out)
        let ck AstNode.kind_of(child as ref[AstNode])
        var wrap false
        if ck = KindUnionType
            set wrap: true
        if ck = KindJSDocNullableType
            set wrap: true
        if ck = KindJSDocOptionalType
            set wrap: true
        if ck = KindFunctionType
            set wrap: true
        if ck = KindConstructorType
            set wrap: true
        if ck = KindConditionalType
            set wrap: true
        if wrap = false
            return this.write_reused_child(child, out)
        out.append("(" as char)
        if this.write_reused_child(child, out) = false
            return false
        out.append(")" as char)
        true
    }

    procedure write_reused_type_list(this, list: ref[Array[ref[AstNode]?]]?, sep: Slice[char], out: ref[StringBuilder]) returns bool
    {
        if list = null
            return true
        let l list as ref[Array[ref[AstNode]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            if i > 0
                out.append(sep.data, sep.length)
            if this.write_reused_child(l[i], out) = false
                return false
            set i: i + 1
        }
        true
    }

    procedure write_reused_type_arguments(this, args: ref[Array[ref[AstNode]?]]?, out: ref[StringBuilder]) returns bool
    {
        if args = null
            return true
        let l args as ref[Array[ref[AstNode]?]]
        if (l.get_length() as int) = 0
            return true
        out.append("<" as char)
        if this.write_reused_type_list(args, ", ", out) = false
            return false
        out.append(">" as char)
        true
    }

    ; An entity name: every identifier as its TEXT, a qualified name dotted.
    procedure write_reused_entity_name(this, name: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if name = null
        {
            this.record_unported("type-to-string-reused-node-kind", 0)
            return false
        }
        let nd name as ref[AstNode]
        let k AstNode.kind_of(nd)
        if k = KindIdentifier
        {
            let t AstNode.identifier_text_of(nd)
            out.append(t.data, t.length)
            return true
        }
        if k = KindQualifiedName
        {
            if this.write_reused_entity_name(AstNode.qualified_left_of(nd), out) = false
                return false
            out.append("." as char)
            return this.write_reused_entity_name(AstNode.qualified_right_of(nd), out)
        }
        this.record_unported("type-to-string-reused-node-kind", k)
        false
    }

    ; getLiteralText for the literal of a literal type, with no source file in
    ; hand: the quote comes from the node's own TokenFlagsSingleQuote and the text
    ; is escaped with NeverAsciiEscape, which the visitor's clone sets.
    procedure write_reused_literal(this, node: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if node = null
        {
            this.record_unported("type-to-string-reused-node-kind", 0)
            return false
        }
        let nd node as ref[AstNode]
        let k AstNode.kind_of(nd)
        if k = KindStringLiteral
        {
            ; The delimiter as getLiteralText picks it. ★The binding is TYPED
            ; because a hex literal defaults to u64 and the callee takes an int.
            var quote: int 0x22
            if (AstNode.string_token_flags_of(nd) & TokenFlagsSingleQuote) <> 0
                set quote: 0x27
            Checker.write_quoted_literal_name(out, AstNode.literal_text_of(nd), quote, true)
            return true
        }
        if k = KindNumericLiteral
        {
            let t AstNode.literal_text_of(nd)
            out.append(t.data, t.length)
            return true
        }
        if k = KindBigIntLiteral
        {
            let t AstNode.literal_text_of(nd)
            out.append(t.data, t.length)
            return true
        }
        if k = KindTrueKeyword
            return Checker.write_keyword(out, "true")
        if k = KindFalseKeyword
            return Checker.write_keyword(out, "false")
        if k = KindNullKeyword
            return Checker.write_keyword(out, "null")
        if k = KindPrefixUnaryExpression
        {
            let op AstNode.prefix_unary_operator_kind(nd)
            if op = KindMinusToken
                out.append("-" as char)
            if op = KindPlusToken
                out.append("+" as char)
            if op <> KindMinusToken
            {
                if op <> KindPlusToken
                {
                    this.record_unported("type-to-string-reused-node-kind", op)
                    return false
                }
            }
            return this.write_reused_literal(AstNode.prefix_unary_operand_of(nd), out)
        }
        this.record_unported("type-to-string-reused-node-kind", k)
        false
    }

    ; A type literal, single-line: `{ `, then each member and its `; `, then `}`.
    ; The EFSingleLine the visitor stamps on a tuple, a type literal and a mapped
    ; type is what makes it one line; an EMPTY member list prints `{}`.
    procedure write_reused_members(this, members: ref[Array[ref[AstNode]?]]?, out: ref[StringBuilder]) returns bool
    {
        var n 0
        if members <> null
            set n: (members as ref[Array[ref[AstNode]?]]).get_length() as int
        if n = 0
        {
            out.append("{}")
            return true
        }
        let l members as ref[Array[ref[AstNode]?]]
        ; ★ A member with a computed name that is DYNAMIC and not late-bindable is
        ; REMOVED by the node-copy visitor (`shouldRemoveDeclaration` — the
        ; AllowUnresolvedNames exception is a declaration-emit flag TypeToString
        ; never sets): `{ [sa]: string }` with `sa` no unique symbol reuses as
        ; `{}` (slice 222). Counted first so an emptied literal prints `{}`.
        var kept 0
        var i 0
        while i < n
        {
            let m l[i]
            if m <> null
            {
                if this.reused_member_is_removed(m as ref[AstNode]) = false
                    set kept: kept + 1
            }
            set i: i + 1
        }
        if kept = 0
        {
            out.append("{}")
            return true
        }
        out.append("{ ")
        set i: 0
        while i < n
        {
            let m l[i]
            if m = null
            {
                this.record_unported("type-to-string-reused-node-kind", 0)
                return false
            }
            if this.reused_member_is_removed(m as ref[AstNode]) = false
            {
                if this.write_reused_member(m as ref[AstNode], out) = false
                    return false
                out.append("; ")
            }
            set i: i + 1
        }
        out.append("}" as char)
        true
    }

    procedure reused_member_is_removed(this, m: ref[AstNode]) returns bool
    {
        let name AstNode.name_of(m)
        if name = null
            return false
        if AstNode.kind_of(name as ref[AstNode]) <> KindComputedPropertyName
            return false
        if this.has_late_bindable_name(m)
            return false
        b.has_dynamic_name(m)
    }

    procedure write_reused_member(this, m: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        let k AstNode.kind_of(m)
        if k = KindPropertySignature
        {
            if this.write_reused_modifiers(AstNode.modifiers_of(m), out) = false
                return false
            if this.write_reused_property_name(AstNode.name_of(m), out) = false
                return false
            if AstNode.postfix_token_of(m) <> null
                out.append("?" as char)
            return this.write_reused_member_type(AstNode.type_of(m), out)
        }
        if k = KindMethodSignature
        {
            if this.write_reused_modifiers(AstNode.modifiers_of(m), out) = false
                return false
            if this.write_reused_property_name(AstNode.name_of(m), out) = false
                return false
            if AstNode.postfix_token_of(m) <> null
                out.append("?" as char)
            if this.write_reused_type_parameter_list(AstNode.type_parameters_of(m), out) = false
                return false
            if this.write_reused_parameters(AstNode.parameters_of(m), out) = false
                return false
            return this.write_reused_member_type(AstNode.type_of(m), out)
        }
        if k = KindCallSignature
        {
            if this.write_reused_type_parameter_list(AstNode.type_parameters_of(m), out) = false
                return false
            if this.write_reused_parameters(AstNode.parameters_of(m), out) = false
                return false
            return this.write_reused_member_type(AstNode.type_of(m), out)
        }
        if k = KindConstructSignature
        {
            out.append("new ")
            if this.write_reused_type_parameter_list(AstNode.type_parameters_of(m), out) = false
                return false
            if this.write_reused_parameters(AstNode.parameters_of(m), out) = false
                return false
            return this.write_reused_member_type(AstNode.type_of(m), out)
        }
        if k = KindIndexSignature
        {
            if this.write_reused_modifiers(AstNode.modifiers_of(m), out) = false
                return false
            out.append("[" as char)
            if this.write_reused_parameter_list_body(AstNode.parameters_of(m), out) = false
                return false
            out.append("]" as char)
            return this.write_reused_member_type(AstNode.type_of(m), out)
        }
        this.record_unported("type-to-string-reused-node-kind", k)
        false
    }

    ; `: T`, and `: any` where the annotation is absent — the visitor's own
    ; injection for a function-like, a property signature or a parameter with
    ; neither a type nor an initializer.
    procedure write_reused_member_type(this, t: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        out.append(": ")
        if t = null
            return Checker.write_keyword(out, "any")
        this.write_reused_child(t, out)
    }

    procedure write_reused_property_name(this, name: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if name = null
        {
            this.record_unported("type-to-string-reused-node-kind", 0)
            return false
        }
        let nd name as ref[AstNode]
        let k AstNode.kind_of(nd)
        if k = KindIdentifier
        {
            let t AstNode.identifier_text_of(nd)
            out.append(t.data, t.length)
            return true
        }
        if k = KindPrivateIdentifier
        {
            let t AstNode.identifier_text_of(nd)
            out.append(t.data, t.length)
            return true
        }
        if k = KindStringLiteral
            return this.write_reused_literal(nd, out)
        if k = KindNumericLiteral
            return this.write_reused_literal(nd, out)
        if k = KindBigIntLiteral
            return this.write_reused_literal(nd, out)
        if k = KindComputedPropertyName
        {
            ; the visitor keeps an entity-name expression that introduces no error
            ; (UpdateComputedPropertyName) — a JS `exports` shape is the only error
            ; without an enclosing declaration, and the type literal's reuse fails
            ; on it before this arm is reached (type_literal_reuse_fails); a literal
            ; name (`["a"]`) is visited child by child; the REMOVED members never
            ; reach this arm (reused_member_is_removed)
            let expr AstNode.expression_of(nd)
            if expr = null
            {
                this.record_unported("type-to-string-reused-node-kind", k)
                return false
            }
            let e expr as ref[AstNode]
            if Checker.is_entity_name_expression(e)
            {
                out.append("[" as char)
                if this.write_reused_entity_name_expression(e, out) = false
                    return false
                out.append("]" as char)
                return true
            }
            let ek AstNode.kind_of(e)
            var literal false
            if ek = KindStringLiteral
                set literal: true
            if ek = KindNumericLiteral
                set literal: true
            if ek = KindNoSubstitutionTemplateLiteral
                set literal: true
            if literal
            {
                out.append("[" as char)
                if this.write_reused_literal(e, out) = false
                    return false
                out.append("]" as char)
                return true
            }
            this.record_unported("type-to-string-reused-node-kind", ek)
            return false
        }
        this.record_unported("type-to-string-reused-node-kind", k)
        false
    }

    ; an entity name EXPRESSION (identifier or property access chain), as text
    procedure write_reused_entity_name_expression(this, e: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        let k AstNode.kind_of(e)
        if k = KindIdentifier
        {
            let t AstNode.identifier_text_of(e)
            out.append(t.data, t.length)
            return true
        }
        if k = KindPropertyAccessExpression
        {
            let left AstNode.expression_of(e)
            if left = null
                return false
            if this.write_reused_entity_name_expression(left as ref[AstNode], out) = false
                return false
            out.append("." as char)
            let name AstNode.property_access_name_of(e)
            if name = null
                return false
            let t AstNode.identifier_text_of(name)
            out.append(t.data, t.length)
            return true
        }
        this.record_unported("type-to-string-reused-node-kind", k)
        false
    }

    procedure write_reused_parameters(this, params: ref[Array[ref[AstNode]?]]?, out: ref[StringBuilder]) returns bool
    {
        out.append("(" as char)
        if this.write_reused_parameter_list_body(params, out) = false
            return false
        out.append(")" as char)
        true
    }

    procedure write_reused_parameter_list_body(this, params: ref[Array[ref[AstNode]?]]?, out: ref[StringBuilder]) returns bool
    {
        if params = null
            return true
        let l params as ref[Array[ref[AstNode]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            if i > 0
                out.append(", ")
            let p l[i]
            if p = null
            {
                this.record_unported("type-to-string-reused-node-kind", 0)
                return false
            }
            let pd p as ref[AstNode]
            if AstNode.dot_dot_dot_token_of(pd) <> null
                out.append("...")
            if this.write_reused_binding_name(AstNode.name_of(pd), out) = false
                return false
            if AstNode.parameter_question_token_of(pd) <> null
                out.append("?" as char)
            if this.write_reused_member_type(AstNode.type_of(pd), out) = false
                return false
            set i: i + 1
        }
        true
    }

    ; A parameter's name. A BINDING PATTERN is a chapter of the printer's own and
    ; reports; write_binding_pattern_name beside it answers for the SYMBOL side and
    ; not for a node.
    procedure write_reused_binding_name(this, name: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if name = null
        {
            this.record_unported("type-to-string-reused-node-kind", 0)
            return false
        }
        let nd name as ref[AstNode]
        if AstNode.kind_of(nd) = KindIdentifier
        {
            let t AstNode.identifier_text_of(nd)
            out.append(t.data, t.length)
            return true
        }
        this.record_unported("type-to-string-reused-node-kind", AstNode.kind_of(nd))
        false
    }

    procedure write_reused_type_parameter_list(this, tps: ref[Array[ref[AstNode]?]]?, out: ref[StringBuilder]) returns bool
    {
        if tps = null
            return true
        let l tps as ref[Array[ref[AstNode]?]]
        let n l.get_length() as int
        if n = 0
            return true
        out.append("<" as char)
        var i 0
        while i < n
        {
            if i > 0
                out.append(", ")
            if this.write_reused_type_parameter(l[i], out) = false
                return false
            set i: i + 1
        }
        out.append(">" as char)
        true
    }

    procedure write_reused_type_parameter(this, tp: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if tp = null
        {
            this.record_unported("type-to-string-reused-node-kind", 0)
            return false
        }
        let nd tp as ref[AstNode]
        if this.write_reused_modifiers(AstNode.modifiers_of(nd), out) = false
            return false
        if this.write_identifier_name(AstNode.name_of(nd), out) = false
            return false
        let c AstNode.type_parameter_constraint_of(nd)
        if c <> null
        {
            out.append(" extends ")
            if this.write_reused_child(c, out) = false
                return false
        }
        let d AstNode.type_parameter_default_of(nd)
        if d <> null
        {
            out.append(" = ")
            if this.write_reused_child(d, out) = false
                return false
        }
        true
    }

    procedure write_reused_modifiers(this, mods: ref[Array[ref[AstNode]?]]?, out: ref[StringBuilder]) returns bool
    {
        if mods = null
            return true
        let l mods as ref[Array[ref[AstNode]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            let m l[i]
            if m = null
            {
                this.record_unported("type-to-string-reused-node-kind", 0)
                return false
            }
            let k AstNode.kind_of(m as ref[AstNode])
            if this.write_reused_modifier(k, out) = false
                return false
            set i: i + 1
        }
        true
    }

    procedure write_reused_modifier(this, k: int, out: ref[StringBuilder]) returns bool
    {
        if k = KindReadonlyKeyword
        {
            out.append("readonly ")
            return true
        }
        if k = KindAbstractKeyword
        {
            out.append("abstract ")
            return true
        }
        if k = KindInKeyword
        {
            out.append("in ")
            return true
        }
        if k = KindOutKeyword
        {
            out.append("out ")
            return true
        }
        if k = KindConstKeyword
        {
            out.append("const ")
            return true
        }
        this.record_unported("type-to-string-reused-node-kind", k)
        false
    }

    ; The mapped type, single-line: the readonly token with its `+`/`-`, the
    ; parameter's `P in K`, an `as` clause, the question token with its own sign,
    ; and the value type. Its `members` list is the invalid-extra-member slot and
    ; reports rather than being dropped.
    procedure write_reused_mapped_type(this, node: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        let extra AstNode.member_list_of(node)
        if extra <> null
        {
            if ((extra as ref[Array[ref[AstNode]?]]).get_length() as int) <> 0
            {
                this.record_unported("type-to-string-reused-node-kind", KindMappedType)
                return false
            }
        }
        out.append("{ ")
        let ro AstNode.mapped_type_readonly_token_of(node)
        if ro <> null
        {
            let rk AstNode.kind_of(ro as ref[AstNode])
            if rk = KindMinusToken
                out.append("-" as char)
            if rk = KindPlusToken
                out.append("+" as char)
            out.append("readonly ")
        }
        out.append("[" as char)
        let tp AstNode.mapped_type_parameter_of(node)
        if tp = null
        {
            this.record_unported("type-to-string-reused-node-kind", KindMappedType)
            return false
        }
        let tpd tp as ref[AstNode]
        if this.write_identifier_name(AstNode.name_of(tpd), out) = false
            return false
        out.append(" in ")
        if this.write_reused_child(AstNode.type_parameter_constraint_of(tpd), out) = false
            return false
        let nt AstNode.mapped_type_name_type_of(node)
        if nt <> null
        {
            out.append(" as ")
            if this.write_reused_child(nt, out) = false
                return false
        }
        out.append("]" as char)
        let q AstNode.question_token_of(node)
        if q <> null
        {
            let qk AstNode.kind_of(q as ref[AstNode])
            if qk = KindMinusToken
                out.append("-" as char)
            if qk = KindPlusToken
                out.append("+" as char)
            out.append("?" as char)
        }
        let vt AstNode.type_of(node)
        if vt <> null
        {
            out.append(": ")
            if this.write_reused_child(vt, out) = false
                return false
        }
        out.append("; }")
        true
    }

    ; The template literal type: the head's text, then each span's type and its
    ; literal text, with the delimiters the emitter writes around them.
    procedure write_reused_template_literal_type(this, node: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        out.append("\`" as char)
        let head AstNode.template_head_of(node)
        if head <> null
        {
            let t AstNode.literal_text_of(head as ref[AstNode])
            out.append(t.data, t.length)
        }
        let spans AstNode.template_literal_type_spans_of(node)
        if spans = null
        {
            out.append("\`" as char)
            return true
        }
        let l spans as ref[Array[ref[AstNode]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            let s l[i]
            if s = null
            {
                this.record_unported("type-to-string-reused-node-kind", KindTemplateLiteralTypeSpan)
                return false
            }
            let sp s as ref[AstNode]
            out.append("${")
            if this.write_reused_child(AstNode.template_literal_type_span_type_of(sp), out) = false
                return false
            out.append("}" as char)
            let lit AstNode.template_span_literal(sp)
            if lit <> null
            {
                let t AstNode.literal_text_of(lit as ref[AstNode])
                out.append(t.data, t.length)
            }
            set i: i + 1
        }
        out.append("\`" as char)
        true
    }

    ; typeParameterToDeclarationWithConstraint: the variance modifiers, the name,
    ; the constraint and the default.
    ;
    ; ★★★ THE CONSTRAINT IS WRITTEN FROM THE ANNOTATION SINCE SLICE 169, and the
    ; paragraph this replaces claimed the opposite for four slices: *the one place
    ; in this slice where the reference has a mechanism this port does not … the
    ; CORPUS is the arbiter and it says the two coincide on every constrained
    ; parameter it holds*. The corpus said no such thing by then — five slices had
    ; each found a shape where they part and each had left a stop — and the mechanism
    ; is written out in write_possibly_reused_type_node above.
    ;
    ; ★ typeParameterToName reduces to the symbol's name: its uniquifying loop is
    ; behind GenerateNamesForShadowedTypeParams, which typeToString does not set.
    procedure write_type_parameter_declaration(this, tp: ref[Type], out: ref[StringBuilder]) returns bool
    {
        ; getTypeParameterModifiers, masked to in|out|const, in
        ; CreateModifiersFromModifierFlags' own order — `const` before `in` before
        ; `out`, which is the emitter's fixed list and not the source order.
        var mods 0
        if tp.symbol <> null
        {
            let sym tp.symbol as ref[Symbol]
            let n Symbol.declaration_count(sym)
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(sym, i)
                if d <> null
                    set mods: mods | b.modifier_flags(d as ref[AstNode])
                set i: i + 1
            }
        }
        if (mods & ModifierFlagsConst) <> 0
            out.append("const ")
        if (mods & ModifierFlagsIn) <> 0
            out.append("in ")
        if (mods & ModifierFlagsOut) <> 0
            out.append("out ")
        if tp.symbol = null
        {
            ; `(Missing type parameter)` — symbolToName answering a non-identifier.
            out.append("(Missing type parameter)")
            return true
        }
        if this.write_symbol_name(tp.symbol as ref[Symbol], out) = false
            return false
        let mark this.unported_mark()
        let c this.get_constraint_of_type_parameter(tp)
        if this.unported_mark() <> mark
            return false
        if c <> null
        {
            ; typeToTypeNodeHelperWithPossibleReusableTypeNode(constraint,
            ; getConstraintDeclaration(parameter)) — the ONLY call site of that
            ; function in the whole nodebuilder, and this printer's one node-REUSE
            ; site. Slices 115, 124, 136, 157 and 159 each found a SHAPE on which
            ; the reused node and the canonical name part, and each left a stop
            ; scoped to that shape; the mechanism is written out above and the six
            ; reports go with it.
            out.append(" extends ")
            if this.write_possibly_reused_type_node(c, this.get_constraint_declaration(tp), out) = false
                return false
        }
        let d0 this.get_default_from_type_parameter(tp)
        if this.unported_mark() <> mark
            return false
        if d0 <> null
        {
            out.append(" = ")
            if this.type_to_string(d0, out) = false
                return false
        }
        true
    }

    ; symbolToParameterDeclaration plus parameterToParameterDeclarationName.
    ;
    ; ★★★ THE TWO CheckFlags DISJUNCTS ARE WRITTEN SINCE SLICE 155, AND THE NOTE
    ; THAT CALLED THEM DEAD NAMED A PRODUCER RATHER THAN THE SET OF THEM. It read
    ; *"written by exactly one producer — getExpandedParameters' tuple expansion —
    ; and that producer cannot run"*: true of getExpandedParameters, and never a
    ; complete list. combineUnionOrIntersectionParameters writes both bits, and a
    ; combined parameter has NO DECLARATION at all — `pd` is null there — so
    ; without the disjuncts the printer answered a signature of a union of
    ; function types with neither `...` nor `?`. **A dead-arm claim is a claim
    ; about EVERY producer, and a note can only name the ones that exist.**
    ;
    ; ★ `preserveModifierFlags` is false at every call site this family has (only
    ; `kind == KindConstructor` passes true, and no type name contains one), so the
    ; parameter-property modifiers are never written.
    procedure write_parameter_declaration(this, ps: ref[Symbol], out: ref[StringBuilder]) returns bool
    {
        let pd Checker.effective_parameter_declaration(ps)
        var is_rest false
        if pd <> null
        {
            if Checker.is_rest_parameter(pd as ref[AstNode])
                set is_rest: true
        }
        if (Symbol.check_flags_of(ps) & CheckFlagsRestParameter) <> 0
            set is_rest: true
        if is_rest
            out.append("...")
        if this.write_parameter_name(ps, pd, out) = false
            return false
        var is_opt false
        if pd <> null
        {
            let mark this.unported_mark()
            let opt this.is_optional_parameter(pd as ref[AstNode])
            if this.unported_mark() <> mark
                return false
            if opt
                set is_opt: true
        }
        if (Symbol.check_flags_of(ps) & CheckFlagsOptionalParameter) <> 0
            set is_opt: true
        if is_opt
            out.append("?" as char)
        out.append(": ")
        let mark this.unported_mark()
        var pt this.get_type_of_symbol(ps)
        if this.unported_mark() <> mark
            return false
        if pt = null
            return false
        ; serializeTypeForDeclaration's `addUndefinedForParameter`.
        ;
        ; ★★★ IT IS THE ONE PLACE THE PRINTER ASKS THE EMIT RESOLVER, AND IT IS NOT
        ; DECORATION: `method(a = 0, b)` prints `a: number | undefined` because `a`
        ; is INITIALIZED and yet NOT optional — a required parameter follows it, so
        ; `isOptionalParameter` says no and the `?` cannot carry the meaning.
        ; ★Slice 112 is where it became visible: the method's own type is printed
        ; only once its return type is inferred, so every unit with this shape used
        ; to stop.
        if pd <> null
        {
            if this.requires_adding_implicit_undefined(pd as ref[AstNode])
            {
                if this.unported_mark() <> mark
                    return false
                set pt: this.get_optional_type(pt as ref[Type], false)
                if this.unported_mark() <> mark
                    return false
                if pt = null
                    return false
            }
        }
        let okp this.type_to_string(pt, out)
        this.add_approximate_length((Symbol.name_len_of(ps) as int) + 3)
        okp
    }

    ; EmitResolver.requiresAddingImplicitUndefined at its PARAMETER arm, which is
    ; the only one this printer reaches — the property arm needs the reverse-mapped
    ; symbol links, and nothing here mints one.
    ;
    ; ★ `enclosingDeclaration` is nil at every arrival from typeToString, so
    ; isRequiredInitializedParameter's parameter-property fork answers FALSE rather
    ; than TRUE; it is written as the reference has it and not collapsed, because
    ; the nil is the CALLER's and a second caller would have another.
    procedure requires_adding_implicit_undefined(this, parameter: ref[AstNode]) returns bool
    {
        var wants false
        if this.is_required_initialized_parameter(parameter)
            set wants: true
        if this.is_optional_uninitialized_parameter_property(parameter)
            set wants: true
        if wants = false
            return false
        this.declared_parameter_type_contains_undefined(parameter) = false
    }

    procedure is_required_initialized_parameter(this, parameter: ref[AstNode]) returns bool
    {
        if Checker.strict_null_checks() = false
            return false
        let mark this.unported_mark()
        let opt this.is_optional_parameter(parameter)
        if this.unported_mark() <> mark
            return false
        if opt
            return false
        if AstNode.initializer_of(parameter) = null
            return false
        if b.has_syntactic_modifier(parameter, ModifierFlagsParameterPropertyModifier)
        {
            ; `enclosingDeclaration != nil && IsFunctionLikeDeclaration(...)` — the
            ; printer passes nil, so this is false here.
            return false
        }
        true
    }

    procedure is_optional_uninitialized_parameter_property(this, parameter: ref[AstNode]) returns bool
    {
        if Checker.strict_null_checks() = false
            return false
        let mark this.unported_mark()
        let opt this.is_optional_parameter(parameter)
        if this.unported_mark() <> mark
            return false
        if opt = false
            return false
        if AstNode.initializer_of(parameter) <> null
            return false
        b.has_syntactic_modifier(parameter, ModifierFlagsParameterPropertyModifier)
    }

    ; declaredParameterTypeContainsUndefined. ★The reference's own comment says why
    ; the error type counts: *allow error type here to avoid confusing errors that
    ; the annotation has to contain undefined*.
    procedure declared_parameter_type_contains_undefined(this, parameter: ref[AstNode]) returns bool
    {
        let type_node AstNode.type_of(parameter)
        if type_node = null
            return false
        let mark this.unported_mark()
        let t this.get_type_from_type_node(type_node as ref[AstNode])
        if this.unported_mark() <> mark
            return false
        if t = null
            return false
        let ty t as ref[Type]
        if this.is_error_type(ty)
            return true
        Checker.contains_undefined_type(ty)
    }

    ; parameterToParameterDeclarationName — the DECLARATION's own name node when
    ; there is one, and the symbol's name otherwise.
    ;
    ; ★★ A BINDING PATTERN IS A STOP RATHER THAN A NAME. cloneBindingName rebuilds
    ; the pattern with every initializer removed, so `function f({a, b} = x)` names
    ; its parameter `{ a, b }` — a second name shape with its own printer, and one
    ; whose ELEMENTS are not the ones the source wrote.
    procedure write_parameter_name(this, ps: ref[Symbol], pd: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if pd = null
            return Checker.write_symbol_own_name(ps, out)
        let name AstNode.name_of(pd as ref[AstNode])
        if name = null
            return Checker.write_symbol_own_name(ps, out)
        let nm name as ref[AstNode]
        let k AstNode.kind_of(nm)
        ; ★★★ THE IDENTIFIER ARMS WRITE THE NODE'S TEXT AND NOT ITS SOURCE RANGE,
        ; because `parameterToParameterDeclarationName` DEEP-CLONES the identifier:
        ; a cloned node is synthesized, so `emitIdentifier` falls to `idText` — the
        ; SCANNED, unescaped text — where a parsed node prints the range. The two
        ; agree on every name that is spelled plainly and differ on exactly one
        ; shape: `function f(arg\u0032: string)` is `arg2` upstream and printed its
        ; source spelling here, silently.
        if k = KindIdentifier
            return Checker.write_identifier_node_text(nm, out)
        if k = KindQualifiedName
            return Checker.write_identifier_node_text(AstNode.qualified_right_of(nm), out)
        ; ★★★ SLICE 133 — the BINDING PATTERN, written out rather than taken from
        ; the source. The note above says why it cannot be the source slice
        ; write_declaration_name would hand back: cloneBindingName REMOVES every
        ; initializer, so `function f({ a = 1 })` names its parameter `{ a }` and
        ; the source spelling is a different string. The shapes are read off the
        ; reference's own answers — `{ a, b }`, `{ a: { b, c } }`, `{ ...p }`,
        ; `[x, y]`, `[[d], [e]]` — and the two brace forms differ: an object
        ; pattern pads inside the braces, an array pattern does not.
        if k = KindObjectBindingPattern
            return this.write_binding_pattern_name(nm, out)
        if k = KindArrayBindingPattern
            return this.write_binding_pattern_name(nm, out)
        this.record_unported("parameter-binding-pattern-name", k)
        false
    }

    ; The binding pattern as a NAME, recursively — a nested pattern is an element's
    ; name like any other.
    ;
    ; ★★★ THE TRAILING COMMA IS THE SOURCE'S AND IT IS NOT DECORATION (slice 183).
    ; Both pattern lists are emitted with LFAllowTrailingComma, and `emitList`
    ; writes the separator after the last element when the NodeList HAS one — so
    ; `function f({ a, })` names its parameter `{ a, }` and `function f({ a })`
    ; names it `{ a }`. Eleven units printed the comma-less spelling for both.
    ; It is the LIST's own range that answers, exactly as it does for the grammar
    ; checks (`list_has_trailing_comma`), and it is asked HERE rather than at the
    ; elements because a hole writes nothing at all: `[, b,]` is two elements, the
    ; first an OmittedExpression, and the last comma is the list's.
    procedure write_binding_pattern_name(this, pattern: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        let object_form AstNode.kind_of(pattern) = KindObjectBindingPattern
        let elements AstNode.elements_of(pattern)
        var n 0
        if elements <> null
            set n: (elements as ref[Array[ref[AstNode]?]]).get_length() as int
        if object_form
        {
            if n = 0
            {
                out.append("{}")
                return true
            }
            out.append("{ ")
        }
        else
            out.append("[" as char)
        var i 0
        while i < n
        {
            if i > 0
                out.append(", ")
            let element (elements as ref[Array[ref[AstNode]?]])[i]
            if element <> null
            {
                if this.write_binding_element_name(element as ref[AstNode], out) = false
                    return false
            }
            set i: i + 1
        }
        if this.node_list_has_trailing_comma(pattern, elements)
            out.append("," as char)
        if object_form
            out.append(" }")
        else
            out.append("]" as char)
        true
    }

    ; NodeList.HasTrailingComma for a list held by a node of ANY file — the
    ; printer's twin of `list_has_trailing_comma`, which asks the checker's own
    ; `file` and therefore answers only about the unit under check. A parameter
    ; whose type is being printed can be declared in the lib, so the range is
    ; looked up on the OWNER's source file.
    ;
    ; ★ A missing row answers FALSE and reports nothing: every list this printer
    ; reaches was parsed from a real file, and a pattern whose row is absent is a
    ; pattern with no trailing comma in every shape the corpus has. It is the same
    ; polarity `list_has_trailing_comma` chose and for the same reason — the answer
    ; feeds a decision where false is the quiet side.
    procedure node_list_has_trailing_comma(this, owner: ref[AstNode], list: ref[Array[ref[AstNode]?]]?) returns bool
    {
        let n AstNode.list_count(list)
        if n = 0
            return false
        let sf Checker.source_file_of_node(owner)
        if sf = null
            return false
        var lpos 0
        var lend 0
        if AstNode.list_range_of(sf, list, &lpos, &lend) = false
            return false
        AstNode.end_of((AstNode.child_in_list(list, n - 1)) as ref[AstNode]) < lend
    }

    ; One element of a pattern. ★An array HOLE is an OmittedExpression and writes
    ; nothing at all, which is what makes `[, a]` come out with its leading comma
    ; and no name in front of it.
    procedure write_binding_element_name(this, element: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        if AstNode.kind_of(element) <> KindBindingElement
            return true
        if AstNode.dot_dot_dot_token_of(element) <> null
            out.append("...")
        let property_name AstNode.property_name_of(element)
        if property_name <> null
        {
            ; ★A COMPUTED property name is PRINTED, not copied from the source — see
            ; write_printed_expression (slice 211).
            if AstNode.kind_of(property_name) = KindComputedPropertyName
            {
                if this.write_printed_property_name(property_name, 0, out) = false
                    return false
            }
            else
            {
                if this.write_identifier_name(property_name, out) = false
                    return false
            }
            out.append(": ")
        }
        let name AstNode.name_of(element)
        if name = null
            return true
        let nm name as ref[AstNode]
        let k AstNode.kind_of(nm)
        if k = KindObjectBindingPattern
            return this.write_binding_pattern_name(nm, out)
        if k = KindArrayBindingPattern
            return this.write_binding_pattern_name(nm, out)
        this.write_identifier_name(nm, out)
    }

    ; ── the printed COMPUTED property name of a binding pattern (slice 211) ──────
    ;
    ; `cloneBindingName` VISITS the pattern and the printer prints what the visit
    ; returns, so a computed property name is not the source slice the identifier
    ; arms take: `[class { static x = 1 }.x]` comes out as
    ; `[class {    static x = 1;}.x]`. The class members are a MULTILINE, INDENTED
    ; list (LFClassMembers) and the type writer's newline is the EMPTY string, so
    ; every member line begins with four spaces per indent level and ends with the
    ; trailing semicolon, and the closing brace sits at the OUTER level
    ; (`classWithStaticFieldInParameterBindingPattern` ×3). The arms below are the
    ; printer's shapes this needs; every other expression prints as its source text,
    ; which is the printer's own answer wherever an emission is token-for-token its
    ; source. ★A METHOD member falls to the source text too: printing its body is a
    ; statement emitter this file does not carry, and no unit prints one.
    procedure write_printed_expression(this, node: ref[AstNode], indent: int, out: ref[StringBuilder]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindPropertyAccessExpression
        {
            let e AstNode.expression_of(node)
            if e <> null
            {
                if this.write_printed_expression(e as ref[AstNode], indent, out) = false
                    return false
            }
            if AstNode.question_dot_token_of(node) <> null
                out.append("?.")
            else
                out.append("." as char)
            return this.write_node_source_text(AstNode.name_of(node), out)
        }
        if k = KindParenthesizedExpression
        {
            out.append("(" as char)
            let inner AstNode.expression_of(node)
            if inner <> null
            {
                if this.write_printed_expression(inner as ref[AstNode], indent, out) = false
                    return false
            }
            out.append(")" as char)
            return true
        }
        if k = KindClassExpression
            return this.write_printed_class_expression(node, indent, out)
        this.write_node_source_text(node, out)
    }

    ; emitClassExpression: modifiers, `class`, the name, type parameters, heritage
    ; clauses (each ` extends X, Y` with its own leading space), ` {`, the members
    ; one per indented line, `}` at the outer level.
    procedure write_printed_class_expression(this, node: ref[AstNode], indent: int, out: ref[StringBuilder]) returns bool
    {
        if this.write_printed_modifiers(node, out) = false
            return false
        out.append("class")
        let name AstNode.name_of(node)
        if name <> null
        {
            out.append(" " as char)
            if this.write_node_source_text(name, out) = false
                return false
        }
        if this.write_printed_node_list(AstNode.type_parameters_of(node), out) = false
            return false
        let clauses AstNode.heritage_clauses_of(node)
        if clauses <> null
        {
            let cl clauses as ref[Array[ref[AstNode]?]]
            let nc cl.get_length() as int
            var c 0
            while c < nc
            {
                let clause cl[c]
                set c: c + 1
                if clause = null
                    continue
                out.append(" " as char)
                if AstNode.heritage_clause_token_of(clause) = KindImplementsKeyword
                    out.append("implements")
                else
                    out.append("extends")
                out.append(" " as char)
                let types AstNode.heritage_clause_types_of(clause)
                if types <> null
                {
                    let tl types as ref[Array[ref[AstNode]?]]
                    let nt tl.get_length() as int
                    var t 0
                    while t < nt
                    {
                        let ewta tl[t]
                        if t > 0
                            out.append(", ")
                        set t: t + 1
                        if ewta = null
                            continue
                        let e AstNode.expression_of(ewta)
                        if e <> null
                        {
                            if this.write_printed_expression(e as ref[AstNode], indent, out) = false
                                return false
                        }
                        if this.write_printed_node_list(AstNode.type_arguments_of(ewta), out) = false
                            return false
                    }
                }
            }
        }
        out.append(" {")
        let members AstNode.member_list_of(node)
        if members <> null
        {
            let ml members as ref[Array[ref[AstNode]?]]
            let nm ml.get_length() as int
            var m 0
            while m < nm
            {
                let member ml[m]
                set m: m + 1
                if member = null
                    continue
                Checker.write_indentation(indent + 1, out)
                if this.write_printed_class_element(member as ref[AstNode], indent + 1, out) = false
                    return false
            }
        }
        Checker.write_indentation(indent, out)
        out.append("}" as char)
        true
    }

    ; emitClassElement, the PROPERTY arm written out: modifiers, name, postfix token,
    ; type annotation, ` = ` initializer, the trailing semicolon.
    procedure write_printed_class_element(this, member: ref[AstNode], indent: int, out: ref[StringBuilder]) returns bool
    {
        if AstNode.kind_of(member) <> KindPropertyDeclaration
            return this.write_node_source_text(member, out)
        if this.write_printed_modifiers(member, out) = false
            return false
        if this.write_printed_property_name(AstNode.name_of(member), indent, out) = false
            return false
        let postfix_kind AstNode.kind_of(AstNode.postfix_token_of(member))
        if postfix_kind = KindQuestionToken
            out.append("?" as char)
        if postfix_kind = KindExclamationToken
            out.append("!" as char)
        let t AstNode.type_of(member)
        if t <> null
        {
            out.append(": ")
            if this.write_node_source_text(t, out) = false
                return false
        }
        let initializer AstNode.initializer_of(member)
        if initializer <> null
        {
            out.append(" = ")
            if this.write_printed_expression(initializer as ref[AstNode], indent, out) = false
                return false
        }
        out.append(";" as char)
        true
    }

    ; A property name through the printer: a computed one is `[` expression `]`,
    ; every other kind its source text.
    procedure write_printed_property_name(this, name: ref[AstNode]?, indent: int, out: ref[StringBuilder]) returns bool
    {
        if name = null
            return true
        let nm name as ref[AstNode]
        if AstNode.kind_of(nm) = KindComputedPropertyName
        {
            out.append("[" as char)
            let e AstNode.expression_of(nm)
            if e <> null
            {
                if this.write_printed_expression(e as ref[AstNode], indent, out) = false
                    return false
            }
            out.append("]" as char)
            return true
        }
        this.write_node_source_text(nm, out)
    }

    ; emitModifierList: each modifier (or decorator) followed by one space.
    procedure write_printed_modifiers(this, node: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        let mods AstNode.modifiers_of(node)
        if mods = null
            return true
        let ml mods as ref[Array[ref[AstNode]?]]
        let n ml.get_length() as int
        var i 0
        while i < n
        {
            let mod ml[i]
            set i: i + 1
            if mod = null
                continue
            if this.write_node_source_text(mod, out) = false
                return false
            out.append(" " as char)
        }
        true
    }

    ; A `<…>` list of type parameters or type arguments, comma-separated, each item
    ; its source text; nothing at all for an absent list.
    procedure write_printed_node_list(this, list: ref[Array[ref[AstNode]?]]?, out: ref[StringBuilder]) returns bool
    {
        if list = null
            return true
        let l list as ref[Array[ref[AstNode]?]]
        let n l.get_length() as int
        if n = 0
            return true
        out.append("<" as char)
        var i 0
        while i < n
        {
            if i > 0
                out.append(", ")
            let item l[i]
            set i: i + 1
            if item = null
                continue
            if this.write_node_source_text(item, out) = false
                return false
        }
        out.append(">" as char)
        true
    }

    ; Four spaces per level — the text writer's indentation.
    procedure write_indentation(level: int, out: ref[StringBuilder]) returns bool
    {
        var i 0
        while i < level
        {
            out.append("    ")
            set i: i + 1
        }
        true
    }

    ; The node's source text from its first token to its end.
    procedure write_node_source_text(this, node: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if node = null
            return true
        let nm node as ref[AstNode]
        let pos AstNode.pos_of(nm)
        let stop AstNode.end_of(nm)
        if pos = stop
            return true
        let nb this.binder_of_node(nm)
        let start nb.skip_trivia_at(pos)
        let text nb.source_slice(start, stop)
        out.append(text.data, text.length)
        true
    }

    ; ★★★ A SYNTHESIZED IDENTIFIER HAS NO SOURCE AND THE PRINTER IS NOT
    ; DeclarationNameToString. Upstream this path CLONES the identifier and hands
    ; it to the emit printer, which writes a synthesized node's own text; the
    ; scanner function write_declaration_name transcribes answers `(Missing)` for
    ; the empty range such a node carries, and that is right where it is used — in
    ; a DIAGNOSTIC. The two are separated here rather than in that function for
    ; exactly that reason.
    ;
    ; ★★ THE SHAPE THAT SEPARATES THEM IS THE JSDOC REPARSER'S `@this` PARAMETER:
    ; it has a name, an Identifier reading `this`, and no source range at all, so
    ; `/** @this {string} */ function f(a) {}` printed
    ; `((Missing): string, a: number) => void`. Slice 112 is where it became
    ; visible, because until the return type was inferred the unit stopped.
    procedure write_identifier_name(this, name: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if name = null
            return Checker.write_keyword(out, "(Missing)")
        let nm name as ref[AstNode]
        if AstNode.pos_of(nm) = AstNode.end_of(nm)
        {
            out.append(AstNode.identifier_text_of(nm).data, AstNode.identifier_text_of(nm).length)
            return true
        }
        this.write_declaration_name(nm, out)
    }

    ; The identifier NODE's text — `idText` on a synthesized clone. ★A null node is
    ; the `(Missing)` word write_identifier_name answers, because the two callers
    ; above reach this through a qualified name's right half.
    procedure write_identifier_node_text(name: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if name = null
            return Checker.write_keyword(out, "(Missing)")
        let t AstNode.identifier_text_of(name as ref[AstNode])
        out.append(t.data, t.length)
        true
    }

    ; The symbol's own NAME, which is the fallback wherever a declaration cannot
    ; supply one. ★It is the raw name and not write_symbol_name's declaration text:
    ; upstream this is `b.newIdentifier(parameterSymbol.Name, …)`.
    procedure write_symbol_own_name(ps: ref[Symbol], out: ref[StringBuilder]) returns bool
    {
        out.append(Symbol.name_of(ps).data, Symbol.name_of(ps).length)
        true
    }

    ; getEffectiveParameterDeclaration — the parameter declaration among the
    ; symbol's own, and the JSDoc parameter tag when the symbol is not transient.
    ; ★The second arm is a JS shape whose declarations this port does not bind as
    ; parameters, so it answers null there; written as the reference's line.
    function effective_parameter_declaration(ps: ref[Symbol]) returns ref[AstNode]?
    {
        let n Symbol.declaration_count(ps)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(ps, i)
            if d <> null
            {
                if AstNode.kind_of(d as ref[AstNode]) = KindParameter
                    return d
            }
            set i: i + 1
        }
        if (Symbol.flags_of(ps) & SymbolFlagsTransient) <> 0
            return null
        set i: 0
        while i < n
        {
            let d Symbol.declaration_at(ps, i)
            if d <> null
            {
                if AstNode.kind_of(d as ref[AstNode]) = KindJSDocParameterTag
                    return d
            }
            set i: i + 1
        }
        null
    }

    ; isOptionalParameter, whose three arms need three different things.
    ;
    ; ★★★ THE INITIALIZER ARM COLLAPSES TO THE SIGNATURE'S OWN `minArgumentCount`,
    ; and that is READ OFF getMinArgumentCountEx rather than assumed. It is called
    ; with `StrongArityForUntypedJS|VoidIsNonOptional`, and under those two flags the
    ; function (a) skips the untyped-JS early return, (b) has no tuple rest to widen
    ; from, and (c) RETURNS BEFORE the void loop and before the memo write. What is
    ; left of it is the literal field. ★So this must NOT call get_min_argument_count,
    ; which is the same function under `MinArgumentCountFlagsNone` and answers a
    ; DIFFERENT number — its whole void loop is the difference.
    ;
    ; ★ The IIFE arm is written at its own line (slice 174).
    procedure is_optional_parameter(this, node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindParameter
            return false
        if AstNode.question_token_of(node) <> null
            return true
        let parent AstNode.parent_node_of(node)
        if AstNode.initializer_of(node) <> null
        {
            if parent = null
                return false
            let mark this.unported_mark()
            let sig this.get_signature_from_declaration(parent as ref[AstNode])
            if this.unported_mark() <> mark
                return false
            if sig = null
                return false
            let idx Checker.parameter_index_of(parent, node)
            if idx < 0
                return false
            return idx >= (sig as ref[Signature]).min_argument_count
        }
        if parent <> null
        {
            let iife AstNode.get_immediately_invoked_function_expression(parent as ref[AstNode])
            if iife <> null
            {
                ; The IIFE arm: a parameter of an immediately invoked function is
                ; optional exactly when the CALL passes it nothing — no annotation,
                ; no rest token, and an index at or past the argument count.
                ;
                ; ★ The note that stood here said the arm *needs
                ; getEffectiveCallArguments and stops*; that function has been in
                ; this file since slice 108 and answers the whole question.
                if AstNode.type_of(node) <> null
                    return false
                if AstNode.dot_dot_dot_token_of(node) <> null
                    return false
                let mark this.unported_mark()
                let args this.get_effective_call_arguments(iife as ref[AstNode])
                if this.unported_mark() <> mark
                    return false
                let idx Checker.parameter_index_of(parent, node)
                if idx < 0
                    return false
                var count 0
                if args <> null
                    set count: (args as ref[Array[ref[AstNode]?]]).get_length()
                return idx >= count
            }
        }
        false
    }

    ; indexInfoToObjectComputedNamesOrSignatureDeclaration, whose first half needs
    ; `indexInfo.components` — the slot Signature's neighbour IndexInfo deliberately
    ; does not carry (see its header: the two writers are getObjectLiteralIndexInfo
    ; and getUnionIndexInfos, neither of which exists here). With no components the
    ; function IS its last line, so this is
    ; indexInfoToIndexSignatureDeclarationHelper and nothing else.
    ;
    ; ★ `getNameFromIndexInfo` is the DECLARATION's own parameter name, or `x` when
    ; there is no declaration — which is the reference's own fallback and not an
    ; invention.
    procedure write_index_signature(this, info: ref[IndexInfo], out: ref[StringBuilder]) returns bool
        this.write_index_signature_ex(info, false, out)

    procedure write_index_signature_ex(this, info: ref[IndexInfo], elide: bool, out: ref[StringBuilder]) returns bool
    {
        if info.is_readonly
        {
            this.add_approximate_length(9)
            out.append("readonly ")
        }
        out.append("[" as char)
        let name_start out.get_length() as int
        if info.declaration = null
            out.append("x" as char)
        else
        {
            let ps AstNode.parameters_of(info.declaration as ref[AstNode])
            if ps = null
                out.append("x" as char)
            else
            {
                let list ps as ref[Array[ref[AstNode]?]]
                if list.get_length() = 0
                    out.append("x" as char)
                else
                {
                    if this.write_declaration_name(AstNode.name_of(list[0]), out) = false
                        return false
                }
            }
        }
        this.add_approximate_length(((out.get_length() as int) - name_start) + 4)
        out.append(": ")
        if this.type_to_string(info.key_type, out) = false
            return false
        out.append("]: ")
        ; The elided placeholder is `any` under NoErrorTruncation, which the
        ; harness sets (see type_to_string's header) — it is `...` without it.
        if elide
            return Checker.write_keyword(out, "any")
        ; `valueType == nil` answers the `any` keyword AND sets encounteredError,
        ; which typeToString's IgnoreErrors swallows — so the name is `any`.
        if info.value_type = null
            return Checker.write_keyword(out, "any")
        this.type_to_string(info.value_type, out)
    }

    ; ONE ACCESSOR of the pair: the declaration of that kind, its signature read
    ; through the symbol's mapper when there is one, and the member. ★A missing
    ; declaration is not a failure — upstream writes only the accessors that
    ; EXIST, which is how a getter-only property prints as one member.
    procedure write_accessor_member(this, sym: ref[Symbol], decl_kind: int, form: int, mapper: ref[TypeMapper]?, out: ref[StringBuilder]) returns bool
    {
        let decl Checker.get_declaration_of_kind(sym, decl_kind)
        if decl = null
            return true
        let mark this.unported_mark()
        let sig this.get_signature_from_declaration(decl as ref[AstNode])
        if this.unported_mark() <> mark
            return false
        if sig = null
            return false
        ; ★`use` is a reserved word here; the binding is `chosen`.
        var chosen: ref[Signature] sig as ref[Signature]
        if mapper <> null
        {
            let inst this.instantiate_signature(chosen, mapper as ref[TypeMapper])
            if inst = null
                return false
            set chosen: inst as ref[Signature]
        }
        if this.write_signature_form(chosen, form, sym, out) = false
            return false
        out.append("; ")
        true
    }

    ; addPropertyToElementList, which appends its OWN terminators because it can
    ; produce SEVERAL members: an overloaded method contributes one MethodSignature
    ; per call signature, which is how `{ (x: string): string; (x: number): string; }`
    ; and a two-overload method both come out.
    ;
    ; ★★★ FOUR OF ITS FORKS ARE CLOSED BY THE FLAG MASK AND ONE BY THE PORT.
    ; WriteClassExpressionAsTypeLiteral removes the prototype filter and both
    ; tracker reports; `isExpanding` is false (maxExpansionDepth −1) so the second
    ; prototype filter is dead too; and the late-bound-name block reports through
    ; the tracker, which typeToString does not read. The ACCESSOR fork is the one
    ; this port cannot take and it stops.
    ;
    ; ★★★ shouldUsePlaceholderForProperty IS LIVE SINCE SLICE 160, AND THE NOTE
    ; THAT STOOD HERE WAS RIGHT UNTIL THE DAY IT WASN'T. It read *"the reverse-
    ; mapped stack, whose only filler is a reverse-mapped type —
    ; resolve_structured_type_members already refuses those, so the placeholder
    ; cannot arrive"* — a claim about a STOP, and the stop is gone. A reverse-
    ; mapped property whose printing has already been entered, or which is nested
    ; inside a mapping over a non-anonymous type, is written `any` rather than
    ; descended into, so without this the printer follows a reverse mapping as
    ; deep as the type goes and prints a name the reference does not.
    procedure write_property_member(this, sym: ref[Symbol], out: ref[StringBuilder]) returns bool
    {
        let mark this.unported_mark()
        this.add_approximate_length((Symbol.name_len_of(sym) as int) + 1)
        let use_placeholder this.should_use_placeholder_for_property(sym)
        var ptype: ref[Type] any_type
        if use_placeholder = false
        {
            let pt this.get_non_missing_type_of_symbol(sym)
            if this.unported_mark() <> mark
                return false
            if pt = null
                return false
            set ptype: pt as ref[Type]
        }
        ; ── the ACCESSOR fork, slice 143 ────────────────────────────────
        ;
        ; Upstream writes TWO members — `get x(): T; set x(v: U);` — whenever the
        ; read and the write type DIFFER, or the property is a class accessor with
        ; no property declaration of its own. Its `else if` is the AUTO-ACCESSOR:
        ; a class field written `accessor x: T`, which has a property declaration
        ; carrying the `accessor` keyword and one type on both sides, and whose
        ; pair is SYNTHESIZED rather than read off declarations.
        ;
        ; ★★ THE CONDITION IS THE WHOLE CHAPTER and getting it wrong prints ONE
        ; member where the reference prints two. Both error guards are load-bearing
        ; in the same direction: an error type equals nothing, so without them a
        ; property whose getter failed to check would take the pair form.
        if (Symbol.flags_of(sym) & SymbolFlagsAccessor) <> 0
        {
            let wt this.get_write_type_of_symbol(sym)
            if this.unported_mark() <> mark
                return false
            if wt = null
                return false
            let wtype wt as ref[Type]
            var errored this.is_error_type(ptype)
            if this.is_error_type(wtype)
                set errored: true
            if errored = false
            {
                let prop_decl Checker.get_declaration_of_kind(sym, KindPropertyDeclaration)
                var in_class false
                let owner Symbol.parent_of(sym)
                if owner <> null
                {
                    if (Symbol.flags_of(owner as ref[Symbol]) & SymbolFlagsClass) <> 0
                        set in_class: true
                }
                var pair false
                if ptype <> wtype
                    set pair: true
                if in_class
                {
                    if prop_decl = null
                        set pair: true
                }
                if pair
                {
                    ; `valueSymbolLinks.Get(sym).mapper` — a member of an
                    ; INSTANTIATED type carries the mapper its signature must be
                    ; read through, and reading the declaration's signature raw
                    ; would print the generic type parameter.
                    let links this.value_symbol_link_of(sym)
                    if this.write_accessor_member(sym, KindGetAccessor, SigFormGetAccessor, links.mapper, out) = false
                        return false
                    if this.write_accessor_member(sym, KindSetAccessor, SigFormSetAccessor, links.mapper, out) = false
                        return false
                    return true
                }
                if in_class
                {
                    if prop_decl <> null
                    {
                        ; ★upstream spells the test inline as
                        ; `core.Find(ModifierNodes(), KindAccessorKeyword)`; the
                        ; binder's `IsAutoAccessorPropertyDeclaration` already
                        ; asks it, and a predicate spelled twice is one that will
                        ; disagree with itself (§3.5ft).
                        if b.is_auto_accessor_property_declaration(prop_decl as ref[AstNode])
                        {
                            ; The auto-accessor's SYNTHESIZED pair: a getter with no
                            ; parameters returning the property type, and a setter
                            ; taking one parameter named `arg` of the write type and
                            ; returning void.
                            let getter_sig this.new_signature(SignatureFlagsNone, null, null, null, null, ptype, 0)
                            if this.write_signature_form(getter_sig, SigFormGetAccessor, sym, out) = false
                                return false
                            out.append("; ")
                            let arg this.new_symbol(SymbolFlagsFunctionScopedVariable, "arg")
                            let arg_links this.value_symbol_link_of(arg)
                            set arg_links.resolved_type: wtype
                            let ps this.new_symbol_list()
                            ps.add(arg)
                            let setter_sig this.new_signature(SignatureFlagsNone, null, null, null, ps, void_type, 0)
                            if this.write_signature_form(setter_sig, SigFormSetAccessor, sym, out) = false
                                return false
                            out.append("; ")
                            return true
                        }
                    }
                }
            }
        }
        var optional false
        if (Symbol.flags_of(sym) & SymbolFlagsOptional) <> 0
            set optional: true
        ; The METHOD arm: a function or method symbol whose type has no properties
        ; of its own and which is not readonly is written as `m(…): T` rather than
        ; as `m: (…) => T`.
        ;
        ; ★★★ `filterType(propertyType, !Undefined)` IS LOAD-BEARING AND THE FIRST
        ; DRAFT OF THIS SLICE CALLED IT THE IDENTITY. It is not: an OPTIONAL method's
        ; type is `(…) => R | undefined` under strictNullChecks, which is a UNION, and
        ; handing that straight to getSignaturesOfType reaches getReducedType's union
        ; arm — a stop. So `{ m?(): void }` reported where the reference prints
        ; `{ m?(): void; }`, and the note claiming the identity was written in the
        ; same commit as the call that disproved it. ★The filter is what turns the
        ; union back into the signature-bearing half, which is exactly why the
        ; reference has it at this one call site and nowhere else in the function.
        if (Symbol.flags_of(sym) & (SymbolFlagsFunction | SymbolFlagsMethod)) <> 0
        {
            let own this.get_properties_of_object_type(ptype)
            if this.unported_mark() <> mark
                return false
            var own_count 0
            if own <> null
                set own_count: (own as ref[Array[ref[Symbol]?]]).get_length() as int
            if own_count = 0
            {
                if this.is_readonly_symbol(sym) = false
                {
                    let filtered this.filter_undefined_out(ptype)
                    if this.unported_mark() <> mark
                        return false
                    if filtered = null
                        return false
                    let sigs this.get_signatures_of_type(filtered as ref[Type], SignatureKindCall)
                    if this.unported_mark() <> mark
                        return false
                    ; Null is NONE here for create_type_node_from_object_type's
                    ; reason, and the reference tests `len(signatures) != 0` two
                    ; lines down — so an empty list is not only legal, it is the
                    ; branch that makes an optional method fall through to the
                    ; property form.
                    let list this.signature_list_or_empty(sigs)
                    let n list.get_length() as int
                    var i 0
                    while i < n
                    {
                        let s list[i]
                        if s = null
                            return false
                        if this.write_signature_form(s as ref[Signature], SigFormMethodSignature, sym, out) = false
                            return false
                        out.append("; ")
                        set i: i + 1
                    }
                    ; `if len(signatures) != 0 || optionalToken == nil { return }` —
                    ; an OPTIONAL method with no call signature falls through and is
                    ; written as a property instead.
                    if n <> 0
                        return true
                    if optional = false
                        return true
                }
            }
        }
        if this.is_readonly_symbol(sym)
        {
            this.add_approximate_length(9)
            out.append("readonly ")
        }
        if this.write_property_name_of_symbol(sym, out) = false
            return false
        if optional
            out.append("?" as char)
        out.append(": ")
        ; ★★★ THE STACK IS PUSHED ACROSS THE TYPE AND NOT AROUND THE MEMBER, which
        ; is what makes condition (1) above mean *already descended into*: the
        ; printer is inside this property's own type while it decides about the
        ; properties of the reverse-mapped types that type contains.
        var pushed false
        if (Symbol.check_flags_of(sym) & CheckFlagsReverseMapped) <> 0
        {
            if use_placeholder = false
            {
                printer_reverse_mapped_stack.add(sym as ref[Symbol]?)
                set pushed: true
            }
        }
        let named this.type_to_string(ptype, out)
        if pushed
            this.pop_symbol_stack(printer_reverse_mapped_stack)
        if named = false
            return false
        out.append("; ")
        true
    }

    ; shouldUsePlaceholderForProperty — *use a placeholder for a reverse mapped
    ; property we have (1) already descended into, (2) that is a nested reverse
    ; mapping within a mapping over a non-anonymous type, or (3) that is a deeply
    ; nested property originating from the same mapped type*.
    ;
    ; ★★ THE THREE CONDITIONS ARE NOT ONE RULE. (1) is termination for a cycle,
    ; (3) is termination for an infinitely deep reverse mapping, and (2) is a SIZE
    ; budget with the reference's own reasoning attached — a deep reverse mapping
    ; over a library type such as `Window` would print pages, while an anonymous
    ; source usually came from an expression the reader wants to see.
    ;
    ; ★ Upstream asks `ReverseMappedSymbolLinks.Has(prop)` before every read. The
    ; three slots live on ValueSymbolLink here (see its own note), so `Has` is the
    ; slot the branch is about to read being non-null — which is the same question
    ; and one lookup rather than two.
    procedure should_use_placeholder_for_property(this, prop: ref[Symbol]) returns bool
    {
        if (Symbol.check_flags_of(prop) & CheckFlagsReverseMapped) = 0
            return false
        let depth printer_reverse_mapped_stack.get_length() as int
        var i 0
        while i < depth
        {
            let row printer_reverse_mapped_stack[i]
            set i: i + 1
            if row = null
                continue
            if (row as ref[Symbol]) = prop
                return true
        }
        if depth > 0
        {
            let last_row printer_reverse_mapped_stack[depth - 1]
            if last_row <> null
            {
                let last_links this.value_symbol_link_of(last_row as ref[Symbol])
                let last_property_type this.value_symbol_extra_read(last_links).reverse_property_type
                if last_property_type <> null
                {
                    if (((last_property_type as ref[Type]).object_flags) & ObjectFlagsAnonymous) = 0
                        return true
                }
            }
        }
        ; (3) — only the last MAX_REVERSE_MAPPED_NESTING_INSPECTION_DEPTH entries
        ; are inspected, *to catch tight infinite loops*; upstream's own comment
        ; says the reasoning behind the number is lost.
        if depth < MaxReverseMappedNestingInspectionDepth
            return false
        let links this.value_symbol_link_of(prop)
        let prop_mapped this.value_symbol_extra_read(links).reverse_mapped_type
        if prop_mapped = null
            return false
        let prop_mapped_symbol (prop_mapped as ref[Type]).symbol
        if prop_mapped_symbol = null
            return false
        var k 0
        while k < depth
        {
            ; `if i > MAX…DEPTH { break }` — upstream's loop is over the WHOLE
            ; stack with the break inside, so it inspects one entry more than the
            ; constant names.
            if k > MaxReverseMappedNestingInspectionDepth
                break
            let row printer_reverse_mapped_stack[depth - 1 - k]
            set k: k + 1
            if row = null
                continue
            let row_links this.value_symbol_link_of(row as ref[Symbol])
            let row_mapped this.value_symbol_extra_read(row_links).reverse_mapped_type
            if row_mapped = null
                continue
            let row_symbol (row_mapped as ref[Type]).symbol
            if row_symbol = null
                continue
            if (row_symbol as ref[Symbol]) = (prop_mapped_symbol as ref[Symbol])
                return true
        }
        false
    }

    ; The symbol stack's pop, which is pop_type_stack's twin for the same reason:
    ; `Array` has no pop, so one shorter is rebuilt.
    procedure pop_symbol_stack(this, stack: ref[Array[ref[Symbol]?]])
    {
        let n stack.get_length() as int
        if n = 0
            return
        let kept &Array[ref[Symbol]?]()
        var i 0
        while i < (n - 1)
        {
            kept.add(stack[i])
            set i: i + 1
        }
        stack.clear()
        set i: 0
        while i < (n - 1)
        {
            stack.add(kept[i])
            set i: i + 1
        }
    }

    ; filterType, at the ONE predicate this port calls it with — `!Undefined`.
    ;
    ; ★★ IT IS WRITTEN AS THE PREDICATE AND NOT AS A DELEGATE because the reference's
    ; `f` is a closure and this port has one caller; the day a second predicate
    ; arrives, the shape to reach for is a second function beside this one rather
    ; than a delegate parameter (§3.9e's rule for lookAhead, met again).
    ;
    ; ★★★ THE `core.Same` SHORT CIRCUIT IS NOT AN OPTIMISATION HERE — IT IS WHAT KEEPS
    ; A NON-OPTIONAL METHOD OUT OF getUnionTypeFromSortedList. A property whose type
    ; is already the signature-bearing type filters to itself and must come back as
    ; the SAME type, not as a freshly interned union of one.
    ;
    ; ★ The `origin` block is skipped: UnionTypeData carries the slot but nothing
    ; WRITES it (its own header), so `origin != nil` is false and `newOrigin` stays
    ; nil.
    procedure filter_undefined_out(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) = 0
        {
            if (t.flags & TypeFlagsNever) <> 0
                return t
            if (t.flags & TypeFlagsUndefined) = 0
                return t
            return never_type
        }
        let types Checker.union_types_of(t)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let kept this.new_type_list(null)
        var i 0
        while i < n
        {
            let c list[i]
            if c = null
                return null
            if ((c as ref[Type]).flags & TypeFlagsUndefined) = 0
                kept.add(c)
            set i: i + 1
        }
        if (kept.get_length() as int) = n
            return t
        var origin_single: ref[Type]? null
        let new_origin this.filtered_union_origin(t, kept, &origin_single)
        if origin_single <> null
            return origin_single
        this.get_union_type_from_sorted_list(kept, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
    }

    ; getPropertyNameNodeForSymbol, then classifyPropertyName, then the printer.
    ;
    ; ★★★ THE QUOTING RULE IS THE WHOLE OF THIS FUNCTION AND IT IS NOT "quote what
    ; is not an identifier". classifyPropertyName is three-way: an identifier is
    ; written bare, a NUMERIC-LITERAL name that is not string-named and is
    ; non-negative is written bare as a number, and everything else is quoted. That
    ; is why `{ 1: number; }` has no quotes and `{ "peer-a": string; }` does.
    ;
    ; ★★ `stringNamed` IS AN `every` OVER THE DECLARATIONS and it flips the middle
    ; arm off: a property declared `{ "1": number }` is string-named, so its numeric
    ; text is QUOTED even though it would classify as numeric. Both spellings occur
    ; in the corpus.
    ;
    ; ★ getPropertyNameNodeForSymbolFromNameType, in front of all of it, reads
    ; valueSymbolLinks' `nameType` — a late-bound name. The slot is not carried, and
    ; a symbol that has one is exactly a computed name, which write_symbol_name
    ; already reports one level up.
    ;
    ; ★ The `__#private` rewrite and the PrivateIdentifier clone are two more shapes;
    ; the corpus's `#y` parameter shows the clone path is reachable, so it is written.
    procedure write_property_name_of_symbol(this, sym: ref[Symbol], out: ref[StringBuilder]) returns bool
    {
        let vd Symbol.value_declaration_of(sym)
        if vd <> null
        {
            let dn AstNode.name_of(vd as ref[AstNode])
            if dn <> null
            {
                if AstNode.kind_of(dn as ref[AstNode]) = KindPrivateIdentifier
                    return this.write_declaration_name(dn, out)
            }
        }
        let data Symbol.name_of(sym)
        let n Symbol.name_len_of(sym)
        var string_named false
        var i 0
        let dc Symbol.declaration_count(sym)
        if dc > 0
        {
            set string_named: true
            while i < dc
            {
                let d Symbol.declaration_at(sym, i)
                if this.declaration_is_string_named(d) = false
                    set string_named: false
                set i: i + 1
            }
        }
        ; ★★★ `singleQuote` STANDS HERE, BESIDE `stringNamed`, BECAUSE THE NAME-TYPE
        ; PATH BELOW IS THE SECOND OF ITS TWO READERS. It used to be computed at the
        ; bottom, so the nameType arm's `NewStringLiteral(name, IfElse(singleQuote,
        ; …))` was written with a hard double quote and `{'0': 0}` through a mapped
        ; type printed `{ "0": … }` where the reference prints `{ '0': … }` — rc 0,
        ; one character, and no instrument here reads a quote.
        var single_quote false
        if dc > 0
        {
            set single_quote: true
            var q 0
            while q < dc
            {
                if this.declaration_is_single_quoted_string_named(Symbol.declaration_at(sym, q)) = false
                    set single_quote: false
                set q: q + 1
            }
        }
        var quote_char 0x22
        if single_quote
            set quote_char: 0x27
        let is_method (Symbol.flags_of(sym) & SymbolFlagsMethod) <> 0
        ; ★★★ getPropertyNameNodeForSymbolFromNameType, SLICE 129 — and the note this
        ; replaces said it was out of reach: *"the reference builds a computed name
        ; for it one level up, in the name-TYPE path this port does not reach"*. The
        ; late-binding table fills `nameType` on every symbol it mints, so the path
        ; is reached now, and it stands BEFORE the symbol's own name because upstream
        ; returns from it whenever it answers.
        ;
        ; ★★ THE MINUS IS WHY THIS IS NOT A REFINEMENT OF THE NAME-BASED PATH:
        ; `{ [-1]: v }` prints `{ [-1]: v }`, a COMPUTED name over a prefix-minus
        ; numeric literal, where the name `-1` alone can only be written as a string.
        let links this.value_symbol_link_of(sym)
        if links.name_type <> null
        {
            let nt links.name_type as ref[Type]
            if (nt.flags & TypeFlagsUniqueESSymbol) <> 0
            {
                ; ★★★ `NewComputedPropertyName(symbolToExpression(nameType.symbol,
                ; SymbolFlagsValue))` — and the note that stood here called it *the
                ; printer's expression writer, one dimension over*. Slice 183 puts
                ; the dimension one step closer: `symbolToExpression` is
                ; `createExpressionFromSymbolChain` over the SAME chain
                ; symbolToTypeNode uses, and at index 0 — which is every chain this
                ; entry point can build — it is the identifier and nothing else.
                ; The printer writes a ComputedPropertyName as its brackets around
                ; the expression, so `[sym]` is the whole answer.
                ;
                ; ★★★ THE CHAIN CAN BE LONGER THAN ONE HERE AND THAT HALF IS A STOP,
                ; which is a claim about REACHABILITY rather than about the shape: a
                ; type literal can be a constituent of a list the collision pass is
                ; re-rendering fully qualified, and then the symbol is reached
                ; through its container. What is missing then is
                ; createExpressionFromSymbolChain's own fork —
                ; `canUsePropertyAccess` decides `a.b` against `a["b"]`, and an
                ; ENTITY NAME's dot is not that decision. Reported rather than
                ; guessed, because the two spellings are different text.
                if nt.symbol = null
                {
                    this.record_unported("property-name-from-unique-symbol", nt.flags)
                    return false
                }
                ; ★★★ THE PROPERTY NAME IS THE ONE PLACE THE PRINTER HAS A REAL
                ; ENCLOSING DECLARATION, AND THE CHAIN THIS SLICE PORTED CANNOT USE
                ; IT. `addPropertyToElementList` sets `ctx.enclosingDeclaration =
                ; propertySymbol.ValueDeclaration` around exactly this call and
                ; restores it after — so `lookupSymbolChainWorker`'s gate passes
                ; HERE for every property, where it fails everywhere else in this
                ; printer, and `someSymbolTableInScope` then walks locals, module
                ; exports and class member tables up the parent chain instead of
                ; answering the globals alone (the reduction this chapter's header
                ; argues for). The measured difference: `{ [OpTypes.equal]: string }`
                ; and `{ [OpNamespace.equal]: string }`, where the chain reduced to
                ; the globals answers the bare `[equal]`.
                ;
                ; ★★★ SO THE ARM SPLITS ON THE CONTAINER, AND THE HALF THAT NEEDS
                ; THE WALK REPORTS. The split is the module-exports arm of
                ; `someSymbolTableInScope`, which is the one arm that decides these
                ; units: a symbol whose container is an external MODULE is in scope
                ; by its bare name inside that module — the file's own exports table
                ; is one of the tables the walk visits — so the chain is one element
                ; and `[MySymbol]` is the reference's answer too
                ; (`declarationEmitExportValueSymbolWithTsIgnore`). A symbol whose
                ; container is an ENUM or a NAMESPACE is reachable only THROUGH the
                ; container, so the walk returns a two-element chain and the answer
                ; is `[OpTypes.equal]`.
                ;
                ; ★★ THE GUARD IS A CONTAINER TEST AND NOT THE WALK, and it is
                ; written as the narrower claim it is: it decides the two shapes the
                ; corpus contains and it is not a port of
                ; `getAccessibleSymbolChain` under a real enclosing declaration.
                ; The day a third container shape arrives, this reports instead of
                ; guessing. **A reduction that is sound for one caller is not sound
                ; for the caller that supplies the very input the reduction assumed
                ; away — and narrowing the guard is not the same as closing it.**
                let us nt.symbol as ref[Symbol]
                ; addPropertyToElementList sets the enclosing declaration to the
                ; PROPERTY'S declaration around getPropertyNameNodeForSymbol, and
                ; symbolToExpression's chain is the accessible chain from there
                ; (slice 221) — `[OpTypes.equal]`, `[NS.eq]`, `[K.ks]`, `[loc]`
                let saved_enclosing printer_enclosing_declaration
                var enclosing Symbol.value_declaration_of(sym)
                if enclosing = null
                {
                    if Symbol.declaration_count(sym) > 0
                        set enclosing: Symbol.declaration_at(sym, 0)
                }
                if enclosing <> null
                    set this.printer_enclosing_declaration: enclosing
                let scratch StringBuilder^host()
                let chain_mark this.unported_mark()
                let written this.write_symbol_expression_chain(us, &scratch)
                set this.printer_enclosing_declaration: saved_enclosing
                if written = false
                    return false
                if this.unported_mark() <> chain_mark
                    return false
                out.append("[" as char)
                out.append(scratch.to_string())
                out.append("]" as char)
                return true
            }
            if (nt.flags & TypeFlagsStringOrNumberLiteral) <> 0
            {
                var nb char[JSNUM_MAX_TEXT]
                let nd2 this.get_property_name_from_type(nt, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
                if nd2.data = null
                    return false
                let numeric Checker.is_numeric_literal_name(nd2)
                if Checker.is_identifier_text(nd2) = false
                {
                    var as_string false
                    if string_named
                        set as_string: true
                    if numeric = false
                        set as_string: true
                    if as_string
                    {
                        Checker.write_quoted_literal_name(out, nd2, quote_char, false)
                        return true
                    }
                }
                if numeric
                {
                    if (nd2[0] as int) = (("-" as char) as int)
                    {
                        out.append("[" as char)
                        out.append("-" as char)
                        out.append(nd2.data + 1, (nd2.length - 1) as size_t)
                        out.append("]" as char)
                        return true
                    }
                }
                ; Otherwise createPropertyNameNodeForIdentifierOrLiteral over the
                ; NAME TYPE's text — which is the symbol's own name for every symbol
                ; the late-binding table mints (getPropertyNameFromType is what named
                ; it), so the path below answers identically and is not duplicated.
            }
        }
        ; classifyPropertyName's three arms.
        var quoted false
        if is_method
        {
            if Checker.name_is(data, "new")
                set quoted: true
        }
        if quoted = false
        {
            if Checker.is_identifier_text(data)
                ; the identifier arm — written bare
                set quoted: false
            else
            {
                set quoted: true
                if string_named = false
                {
                    if Checker.is_numeric_literal_name(data)
                    {
                        ; `&& jsnum.FromString(name) >= 0` — a NEGATIVE numeric name
                        ; is quoted, because the numeric-literal node cannot carry
                        ; the minus (the reference builds a computed name for it one
                        ; level up, in the name-TYPE path this port does not reach).
                        if (data[0] as int) <> (("-" as char) as int)
                            set quoted: false
                    }
                }
            }
        }
        if quoted = false
        {
            out.append(data.data, data.length)
            return true
        }
        ; NewStringLiteral(name, IfElse(singleQuote, TokenFlagsSingleQuote, None)),
        ; printed by getLiteralText's synthesized arm.
        ;
        ; ★★★ THE `singleQuote` HALF IS CODE SINCE SLICE 115 AND THE NOTE THAT STOOD
        ; HERE WAS WRONG. It read *"the PRINTER only honours it through the node's
        ; token flags on a REUSED node; a synthesized literal prints with double
        ; quotes, which is what the reference's own answers show"* — and the
        ; reference's answers show the opposite: `{ 'stage-0': PluginConfig; }`, with
        ; single quotes, out of a SYNTHESIZED literal. getLiteralText reads
        ; TokenFlagsSingleQuote off the node whether the node was parsed or built,
        ; and the builder stamps it. Found by the stage-2 confirmation on two units;
        ; invisible at stage 1, where no fixture declared a single-quoted member.
        ;
        ; ★★★ AND IT IS ASCII-ESCAPED WHERE A STRING-LITERAL TYPE IS NOT — one emit
        ; flag: typeToTypeNodeHelper stamps `EFNoAsciiEscaping` on the TYPE's
        ; literal, createPropertyNameNodeForIdentifierOrLiteral stamps nothing, and
        ; typeToString's printer carries no `NeverAsciiEscape`. Hence
        ; `{ "\uD83E\uDD2A": number; }`, and hence the flag stays ON below.
        Checker.write_quoted_literal_name(out, data, quote_char, false)
        true
    }

    ; `b.isSingleQuotedStringNamed(d)` — the declaration's name is a string literal
    ; whose SingleQuote token flag is set. ★It is the STRICTER sibling of
    ; declaration_is_string_named and not a refinement of it: the reference asks both
    ; as separate `every` folds over the declarations, so a symbol declared once with
    ; `'a'` and once with `"a"` is string-named and NOT single-quoted.
    ; ★★★ `GetNameOfDeclaration` in BOTH predicates (§3.5hr): the slot accessor
    ; answered false for every assignment declaration, and classifyPropertyName
    ; un-quotes a numeric-looking name only when it is NOT string-named — which is
    ; what printed `decl5["101"]`'s member as a bare `101`. Takes `this` for the
    ; accessor.
    function declaration_is_single_quoted_string_named(this, d: ref[AstNode]?) returns bool
    {
        if d = null
            return false
        let name b.get_name_of_declaration(d as ref[AstNode])
        if name = null
            return false
        let nm name as ref[AstNode]
        if AstNode.kind_of(nm) <> KindStringLiteral
            return false
        (AstNode.string_token_flags_of(nm) & TokenFlagsSingleQuote) <> 0
    }

    ; `b.isStringNamed(d)` — the declaration's name is a string literal. ★Its two
    ; computed-name arms ask checkExpression for the name type; a computed name has
    ; already stopped one level up, so what is left is the literal test.
    ; isStringNamed, whole — and its first two arms are SLICE 129's, because they
    ; are the ones a COMPUTED name takes.
    ;
    ; ★★★ IT DECIDES A PRINTED FORM AND NOT A TASTE. `{ ["404"]: v }` prints
    ; `{ "404": v }` and `{ [100]: v }` prints `{ 100: v }`, and the whole difference
    ; is this predicate: classifyPropertyName un-quotes a numeric-looking name ONLY
    ; when it is not string-named, so a string-typed computed name has to answer TRUE
    ; here or the quotes vanish. The port had the third arm alone (a literal
    ; `"404":` in the source), which was every declaration that could reach it while
    ; every computed name stopped.
    ;
    ; ★ It CHECKS — `checkExpression` on the name's expression — so it is a method
    ; and not a static, and the type it asks for is memoized by the computed-name
    ; check that has already run in this chapter.
    procedure declaration_is_string_named(this, d: ref[AstNode]?) returns bool
    {
        if d = null
            return false
        let name b.get_name_of_declaration(d as ref[AstNode])
        if name = null
            return false
        let nm name as ref[AstNode]
        let k AstNode.kind_of(nm)
        if k = KindComputedPropertyName
        {
            let e AstNode.expression_of(nm)
            if e = null
                return false
            let t this.check_expression(e as ref[AstNode])
            if t = null
                return false
            return ((t as ref[Type]).flags & TypeFlagsStringLike) <> 0
        }
        if k = KindElementAccessExpression
        {
            let arg AstNode.element_access_argument_of(nm)
            if arg = null
                return false
            let t this.check_expression(arg as ref[AstNode])
            if t = null
                return false
            return ((t as ref[Type]).flags & TypeFlagsStringLike) <> 0
        }
        k = KindStringLiteral
    }

    function name_is(data: Slice[char], lit: Slice[char]) returns bool
    {
        if data.length <> lit.length
            return false
        var i 0
        while i < data.length
        {
            if (data[i] as int) <> (lit[i] as int)
                return false
            set i: i + 1
        }
        true
    }

    ; scanner.IsIdentifierText — the first rune must start an identifier and every
    ; later one must continue it. ★The LanguageVariant argument selects
    ; IsIdentifierPartEx, whose JSX arm admits `-` and `:`; this call site passes
    ; Standard, which is the plain predicate the scanner already exports.
    function is_identifier_text(data: Slice[char]) returns bool
    {
        if data.length = 0
            return false
        let c0 Scanner.utf8_decode_in(data, data.length, 0)
        if Scanner.is_identifier_start(c0) = false
            return false
        var i Scanner.utf8_size_in(data, data.length, 0)
        while i < data.length
        {
            let c Scanner.utf8_decode_in(data, data.length, i)
            if Scanner.is_identifier_part(c) = false
                return false
            set i: i + Scanner.utf8_size_in(data, data.length, i)
        }
        true
    }

    ; isNumericLiteralName — `jsnum.FromString(name).String() == name`, which is the
    ; reference's own spelling and NOT a syntactic test: it accepts `Infinity`,
    ; `-Infinity` and `NaN` deliberately, and refuses `0xF00D` and `0170015` because
    ; their round trip is not their text.
    function is_numeric_literal_name(data: Slice[char]) returns bool
    {
        let v jsnum_from_string(data)
        var nb char[JSNUM_MAX_TEXT]
        let nn jsnum_to_string(v, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if nn <> data.length
            return false
        var i 0
        while i < data.length
        {
            if (nb[i] as int) <> (data[i] as int)
                return false
            set i: i + 1
        }
        true
    }

    ; TypeAlias.ToTypeReferenceNode — the Any arm's printer, and it is NOT
    ; symbol_to_type_node with a different caller. That one goes through
    ; write_symbol_name, which reads the symbol's DECLARATIONS; an unresolved
    ; symbol has none, and the reference's line here is
    ; `b.symbolToEntityNameNode(t.Symbol())`, which reads `symbol.Name` and walks
    ; the PARENT chain. So `A.T` prints as `A.T` out of two synthetic symbols that
    ; were never declared anywhere.
    procedure write_alias_type_reference(this, t: ref[Type], out: ref[StringBuilder]) returns bool
    {
        let asym t.alias_symbol as ref[Symbol]
        let en_start out.get_length() as int
        Checker.write_symbol_entity_name(asym, out)
        ; createAccessFromSymbolChain: every component counts its width plus one,
        ; the ROOT component twice (its index-0 arm and the unconditional add)
        var en_root asym
        var en_parent Symbol.parent_of(asym)
        while en_parent <> null
        {
            set en_root: en_parent as ref[Symbol]
            set en_parent: Symbol.parent_of(en_parent as ref[Symbol])
        }
        this.add_approximate_length(((out.get_length() as int) - en_start) + (Symbol.name_len_of(en_root) as int) + 2)
        ; symbolToEntityNameNode joins the PARENT chain with dots, so the TypeName
        ; is an Identifier exactly when the alias symbol has no parent. Held in a
        ; local and re-stated at the exits, for type_reference_to_type_node's
        ; reason.
        var ref_name Slice[char]()
        if Symbol.parent_of(asym) = null
            set ref_name: Symbol.name_of(asym)
        var na 0
        if t.alias_type_arguments <> null
            set na: (t.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() as int
        if na = 0
        {
            set wrote_type_precedence: TypePrecedenceNonArray
            set wrote_type_reference_name: ref_name
            set wrote_name_depth: printer_depth
            return true
        }
        let args t.alias_type_arguments as ref[Array[ref[Type]?]]
        if this.write_type_argument_list(args, out) = false
            return false
        set wrote_type_precedence: TypePrecedenceNonArray
        set wrote_type_reference_name: ref_name
        set wrote_name_depth: printer_depth
        true
    }

    ; symbolToEntityNameNode — the parent chain joined by dots, LEAF LAST.
    procedure write_symbol_entity_name(symbol: ref[Symbol], out: ref[StringBuilder])
    {
        let parent Symbol.parent_of(symbol)
        if parent <> null
        {
            Checker.write_symbol_entity_name(parent as ref[Symbol], out)
            out.append("." as char)
        }
        out.append(Symbol.name_of(symbol).data, Symbol.name_of(symbol).length)
    }

    ; symbolToTypeNode, and the ONE of its two branches this entry point can take.
    ;
    ; ★★★ THE CHAIN IS ONE ELEMENT LONG HERE — write_symbol_name's header proves it
    ; from the nil enclosing declaration — so createAccessFromSymbolChain runs with
    ; `index == 0` and `parent == nil`, which removes the export-alias lookup, the
    ; indexed-access fork and the computed-name recursion in one step. What is left
    ; is getNameOfSymbolAsWritten, and the type-argument list is nil because the
    ; caller passes none.
    ;
    ; ★★★ THE IMPORT-TYPE BRANCH IS PORTED SINCE SLICE 129, AND THE STOP THAT STOOD
    ; HERE NAMED THE WRONG BLOCKER — §3.5dk from the outside. It read *the specifier
    ; comes from getSpecifierForModuleSymbol, which is `modulespecifiers` and its
    ; whole preference apparatus*; that function's SECOND guard is
    ; `if b.ctx.enclosingFile == nil`, and this printer's context has no enclosing
    ; declaration at all (write_symbol_name's header proves it), so the reference
    ; returns from that guard and never reaches GetModuleSpecifiers.
    ;
    ; ★★★ WHAT THE GUARD ANSWERS IS `StripQuotes(symbol.Name)`, AND ITS CONDITION
    ; HOLDS FOR BOTH ARMS THIS BRANCH CAN SEE — which is why the file-name fallback
    ; under it is unreachable here rather than skipped. A module symbol's name is
    ; QUOTED on both roads into this branch: `declare module "m"` carries the quotes
    ; in the source, and a source FILE that is a module is named
    ; `"<path without its extension>"` by bind_source_file_as_external_module (whose
    ; header states the same pair of bytes is how the checker recognises one).
    ; IsAmbientModuleSymbolName is a test for exactly that pair. The unquoted case
    ; keeps the stop, so an arm the argument says cannot arrive still cannot answer.
    ;
    ; ★ The `file`/`equivalentSymbol` pair the reference computes FIRST is dead on
    ; this path: its only reader is the `file == nil` guard one line above, which the
    ; same name test answers — and its helper
    ; (getFileSymbolIfFileSymbolExportEqualsContainer) lives in
    ; symbolaccessibility.go, which this project does not port.
    ;
    ; ★ The literal is `b.newStringLiteral(specifier)` with NO EmitFlags, and
    ; typeToStringEx prints through createPrinterWithRemoveComments — NOT the
    ; NeverAsciiEscape printer — so the specifier is ASCII-ESCAPED, which is
    ; write_ascii_escaped_literal_name and not the string-literal TYPE's writer.
    ;
    ; ★ is_ambient_module_symbol_name is the one already in this file (slice 104's,
    ; beside the globals merge) — §3.5ed: the grep that finds it asks about the
    ; reference name's distinctive MIDDLE, `AmbientModuleSymbolName`, not about a
    ; snake_case whole this slice would have invented. StripQuotes is then the
    ; two-byte window `nd + 1` / `nl - 2`, because the pair it accepts in general
    ; (`'`, `"` or a backtick, the two agreeing) is already known to be `"` here.
    ; ── symbolaccessibility.go: the chain that NAMES a symbol (slice 183) ─────
    ;
    ; ★★★ WHY A WHOLE CHAPTER OF AN EXCLUDED FILE IS PORTED HERE. `coverage.sh`
    ; lists `symbolaccessibility.go` under NOT_A_GOAL beside the declaration
    ; emitter, and that exclusion is about the DENOMINATOR, not about the exit
    ; criterion: the yardstick compares the text `TypeToString` produces, and this
    ; machinery decides that text whenever two constituents of one printed list
    ; carry the same name. `[c, m.c]` came out `[c, c]` and `Foo.Yep | Bar.Yep`
    ; came out `Yep | Yep` — a name that says two different types are one. **A file
    ; excluded from the coverage denominator can still own an answer the criterion
    ; compares, and the two lists are maintained for different questions.**
    ;
    ; ★★★ IT RUNS ONLY UNDER THE FULLY-QUALIFIED FLAG, AND THE FLAG IS SET BY A
    ; COLLISION. `lookupSymbolChainWorker`'s gate is `enclosingDeclaration != nil ||
    ; flags&UseFullyQualifiedType != 0`, and `TypeToString` passes a nil enclosing
    ; declaration — so with the flag off the chain is the symbol alone and nothing
    ; below this line can change a name. `mapToTypeNodes` turns the flag on for the
    ; entries of a list whose single-identifier names collided (see
    ; write_qualified_on_collision), which bounds the blast radius of this chapter
    ; to exactly the lists that print one name twice.
    ;
    ; ★★★ AND THE NIL ENCLOSING DECLARATION COLLAPSES `someSymbolTableInScope` TO
    ; ONE TABLE. Upstream it walks `location.Parent` from the enclosing declaration
    ; collecting locals, module exports and class/interface member tables, and ends
    ; with `callback(c.globals, …)`. With a nil start the loop body never runs, so
    ; the GLOBALS table is the whole walk. This is written as the reduction rather
    ; than as the general form with an unreachable loop, and the reduction is a
    ; claim about the CALLER: this printer has no enclosing declaration to thread
    ; and no field to hold one. The day one arrives, this function is where the
    ; walk goes — it is named `some_symbol_table_in_scope_globals` so that a reader
    ; looking for the general form does not find a half of it wearing the whole
    ; name.

    ; ── mapToTypeNodes' NAME-COLLISION PASS (slice 183) ──────────────────────
    ;
    ; ★★★ THIS IS THE SECOND ENTRY POINT THE PRINTER'S OWN CONTAINMENT PROOF SAID
    ; WOULD EXPIRE IT, AND IT IS INSIDE THE PRINTER. The note in the three
    ; name-writing arms reads *"`Checker.TypeToString(t)`, which is the ONLY entry
    ; point the oracle uses, is `typeToString(t, nil)` … the flag is not in
    ; `AllowUniqueESSymbolType|UseAliasDefinedOutsideCurrentScope`. So the else
    ; branch runs for EVERY symbol, the chain is one element long"* — and it ends
    ; *"the day a second entry point appears, all four collapses expire together."*
    ; The premise was about the CALLER, and what sets the flag is the printer
    ; SETTING IT ON ITSELF: `mapToTypeNodes` re-renders the colliding entries of one
    ; list with `UseFullyQualifiedType` on. **A containment proof that quantifies
    ; over entry points is not proof about a function that changes its own
    ; context.**
    ;
    ; ★★★ WHAT IT IS FOR, in upstream's own words: *to avoid printing types like
    ; `[Foo, Foo]` or `Bar & Bar` where occurrences of the same name actually come
    ; from different namespaces.* `[c, m.c]` printed `[c, c]` here and
    ; `Foo.Yep | Bar.Yep` printed `Yep | Yep` — a name that claims two types are
    ; one, which is worse than a long name.
    ;
    ; ★★ THE PORT NEEDS TWO PASSES WHERE UPSTREAM NEEDS ONE REWRITE, because
    ; upstream holds NODES it can replace in place and this printer writes TEXT.
    ; Each constituent is therefore rendered into a scratch builder of its own, the
    ; colliding ones are rendered a SECOND time with the flag on, and the pieces are
    ; joined. The cost is one builder per constituent on a path no measurement has
    ; ever named; the alternative — a predicate that decides qualification without
    ; rendering — would be a second copy of the whole naming fork.
    ;
    ; ★ `isBareList` is upstream's truncation switch and does not reach this half:
    ; the truncation budget is asked by the callers, which already report where the
    ; reference elides.

    ; typesAreSameReference — two occurrences of one name are innocent when they
    ; name the same thing, and identity is asked three ways: the type, its symbol,
    ; its alias.
    function types_are_same_reference(a: ref[Type]?, b: ref[Type]?) returns bool
    {
        if a = b
            return true
        if a = null
            return false
        if b = null
            return false
        let x a as ref[Type]
        let y b as ref[Type]
        if x.symbol <> null
        {
            if x.symbol = y.symbol
                return true
        }
        if x.alias_symbol <> null
        {
            if x.alias_symbol = y.alias_symbol
                return true
        }
        false
    }

    ; The pass itself: given one list's types and the identifier-type-reference
    ; name each rendered under (an empty slice where it rendered as anything else),
    ; mark the entries that must be rendered again fully qualified.
    ;
    ; ★★ IT IS NOT *"a name that appears twice"* — it is a name that appears twice
    ; for types that are NOT all the same reference. `A<string> | A<number>` keys
    ; both constituents on `A` and leaves both alone, because the two share a
    ; symbol; upstream's `arrayIsHomogeneous` is that test and dropping it would
    ; qualify every generic union.
    procedure mark_name_collisions(this, types: ref[Array[ref[Type]?]], names: ref[Array[Slice[char]]], marks: ref[Array[int]])
    {
        let n names.get_length() as int
        var i 0
        while i < n
        {
            let ni names.at(i)
            if ni.length <> 0
            {
                ; The first occurrence of this name decides for all of them, so an
                ; entry already marked, or one whose name was seen earlier, is
                ; skipped rather than re-grouped.
                var first true
                var j 0
                while j < i
                {
                    if SymbolTable.names_equal(names.at(j), ni)
                        set first: false
                    set j: j + 1
                }
                if first
                {
                    var homogeneous true
                    var k i + 1
                    while k < n
                    {
                        if SymbolTable.names_equal(names.at(k), ni)
                        {
                            if Checker.types_are_same_reference(types[i], types[k]) = false
                                set homogeneous: false
                        }
                        set k: k + 1
                    }
                    if homogeneous = false
                    {
                        var m i
                        while m < n
                        {
                            if SymbolTable.names_equal(names.at(m), ni)
                                marks.put(m, 1)
                            set m: m + 1
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; The two-pass list writer. `mode` selects the constituent renderer — 1 for a
    ; union, 2 for an intersection — because Scaly has no closure to hand one in
    ; and a delegate would put an indirect call on every constituent of every name.
    ;
    ; ★★ THE TRUNCATION TEST STAYS AGAINST THE REAL SINK. It asks how much has been
    ; written so far, and the scratch builders hold the pieces, so the check is made
    ; on `out` before each piece is appended — which is where the loop this replaces
    ; made it.
    procedure write_constituent_list(this, list: ref[Array[ref[Type]?]], n: int, sep: Slice[char], mode: int, out: ref[StringBuilder]) returns bool
    {
        let host Page.get(this)
        let names &Array[Slice[char]]^host()
        let marks &Array[int]^host()
        let pieces &Array[String]^host()
        ; The depth this loop calls FROM — a name written deeper than one step
        ; belongs to something the constituent recursed into, not to the
        ; constituent. See printer_depth.
        let outer printer_depth
        ; mapToTypeNodes for a BARE list: +2 per element; past the budget a list
        ; of more than two prints its first element, a placeholder and its last;
        ; a list crossing the budget mid-way keeps its head, a placeholder for the
        ; rest, and the last element
        var elided false
        if this.check_truncation_length()
        {
            if n > 2
            {
                set elided: true
                let first StringBuilder^host()
                if this.write_constituent(list[0], mode, &first) = false
                    return false
                pieces.add(first.to_string())
                names.add(Slice[char]())
                marks.add(0)
                let placeholder StringBuilder^host()
                if Checker.write_elided_information_placeholder(&placeholder) = false
                    return false
                pieces.add(placeholder.to_string())
                names.add(Slice[char]())
                marks.add(0)
                let last StringBuilder^host()
                if this.write_constituent(list[n - 1], mode, &last) = false
                    return false
                pieces.add(last.to_string())
                names.add(Slice[char]())
                marks.add(0)
            }
        }
        var i 0
        if elided
            set i: n
        while i < n
        {
            if this.check_truncation_length()
            {
                if (i + 1) + 2 < n - 1
                {
                    set elided: true
                    let placeholder StringBuilder^host()
                    if Checker.write_elided_information_placeholder(&placeholder) = false
                        return false
                    pieces.add(placeholder.to_string())
                    names.add(Slice[char]())
                    marks.add(0)
                    let last StringBuilder^host()
                    if this.write_constituent(list[n - 1], mode, &last) = false
                        return false
                    pieces.add(last.to_string())
                    names.add(Slice[char]())
                    marks.add(0)
                    break
                }
            }
            this.add_approximate_length(2)
            let piece StringBuilder^host()
            if this.write_constituent(list[i], mode, &piece) = false
                return false
            pieces.add(piece.to_string())
            if this.wrote_identifier_type_reference(outer)
                names.add(wrote_type_reference_name)
            else
                names.add(Slice[char]())
            marks.add(0)
            set i: i + 1
        }
        if elided
        {
            let ne pieces.get_length() as int
            var e 0
            while e < ne
            {
                if e > 0
                    out.append(sep.data, sep.length)
                out.append(pieces.at(e))
                set e: e + 1
            }
            return true
        }
        this.mark_name_collisions(list, names, marks)
        var j 0
        while j < n
        {
            if marks[j] <> 0
            {
                ; The flag is saved and restored around the re-render, as upstream's
                ; `saveRestoreFlags` does: a list nested inside this one must not
                ; inherit a qualification decision made about its parent.
                let saved printer_fully_qualified
                set printer_fully_qualified: true
                let piece StringBuilder^host()
                let ok this.write_constituent(list[j], mode, &piece)
                set printer_fully_qualified: saved
                if ok = false
                    return false
                pieces.put(j, piece.to_string())
            }
            set j: j + 1
        }
        var k 0
        while k < n
        {
            if k > 0
                out.append(sep.data, sep.length)
            out.append(pieces.at(k))
            set k: k + 1
        }
        true
    }

    procedure write_constituent(this, ct: ref[Type]?, mode: int, out: ref[StringBuilder]) returns bool
    {
        if mode = 2
            return this.write_intersection_constituent(ct, out)
        this.write_union_constituent(ct, out)
    }

    ; getQualifiedLeftMeaning — the meaning a QUALIFIER carries. Value stays Value;
    ; everything else asks for a namespace, because `A.B` can only be reached
    ; through an `A` that has members.
    function qualified_left_meaning(right_meaning: int) returns int
    {
        if right_meaning = SymbolFlagsValue
            return SymbolFlagsValue
        SymbolFlagsNamespace
    }

    ; needsQualification over the one table in scope. ★★ THE EARLY `return true` IS
    ; NOT A QUALIFY — upstream's callback answers *stop walking*, and it answers it
    ; in two places with opposite verdicts: a table whose entry IS this symbol stops
    ; with `qualify` still false (the name resolves to us, so the bare name is
    ; right), and a table whose entry is a DIFFERENT symbol of the same meaning
    ; stops with qualify TRUE. Folding the two into one boolean answer would lose
    ; the difference, which is why the walk is spelled out rather than inlined.
    ; ── slice 221: THE ACCESSIBLE SYMBOL CHAIN UNDER AN ENCLOSING DECLARATION ──
    ;
    ; ★★★ THE PRINTER HAS AN ENCLOSING DECLARATION FOR ONE PURPOSE HERE. The
    ; checker's TypeToString passes nil, and every reuse arm of the node builder
    ; is gated on it — but addPropertyToElementList sets it to the PROPERTY'S
    ; DECLARATION around getPropertyNameNodeForSymbol, and a unique-symbol
    ; property name is serialized through symbolToExpression → lookupSymbolChain,
    ; which under an enclosing declaration is the ACCESSIBLE chain from there:
    ; `{ [Op.equal]: string }` prints `[OpTypes.equal]` (the interface reached
    ; through the variable declared with its type), `[NS.eq]`, `[K.ks]`, and a
    ; local `[loc]`. Before this slice the port's chain machinery read the GLOBALS
    ; table only (the enclosing-declaration-is-nil specialisation), and the
    ; unique-symbol arm stopped on every container that was not a module.
    ;
    ; someSymbolTableInScope is a callback walk upstream; here it is materialised
    ; once per ask into a table list (`collect_scope_tables`), which the two
    ; consumers — needsQualification and getAccessibleSymbolChain — iterate. The
    ; walk: the locals of every container that can have them (a global source
    ; file's excluded), the exports of a module or module-file, the TYPE members
    ; of a class or interface, a named class expression's own name, then globals.
    ; The visited set of (symbol, table) pairs is the reference's
    ; visitedSymbolTablesMap, shared by the nested asks canQualifySymbol makes.
    procedure needs_qualification(this, symbol: ref[Symbol], meaning: int) returns bool
    {
        let tables &Array[ref[SymbolTable]?]^host()
        let kinds &Array[int]^host()
        this.collect_scope_tables(tables, kinds)
        let n tables.get_length() as int
        var i 0
        while i < n
        {
            let t tables[i]
            set i: i + 1
            if t <> null
            {
                let res SymbolTable.get(t, Symbol.name_of(symbol))
                if res <> null
                {
                    let merged this.get_merged_symbol(res)
                    if merged <> null
                    {
                        var from_table merged as ref[Symbol]
                        if from_table = symbol
                            return false
                        let should_resolve_alias this.should_resolve_alias_for_qualification(from_table)
                        var flags Symbol.flags_of(from_table)
                        var usable true
                        if should_resolve_alias
                        {
                            let resolved this.resolve_alias(from_table)
                            if resolved = null
                                set usable: false
                            else
                            {
                                set from_table: resolved as ref[Symbol]
                                set flags: this.get_symbol_flags(from_table)
                            }
                        }
                        if usable
                        {
                            if (flags & meaning) <> 0
                                return true
                        }
                    }
                }
            }
        }
        false
    }

    function should_resolve_alias_for_qualification(this, s: ref[Symbol]) returns bool
    {
        if (Symbol.flags_of(s) & SymbolFlagsAlias) = 0
            return false
        Checker.get_declaration_of_kind(s, KindExportSpecifier) = null
    }

    function can_have_locals(k: int) returns bool
    {
        if k = KindArrowFunction
            return true
        if k = KindBlock
            return true
        if k = KindCallSignature
            return true
        if k = KindCaseBlock
            return true
        if k = KindCatchClause
            return true
        if k = KindClassStaticBlockDeclaration
            return true
        if k = KindConditionalType
            return true
        if k = KindConstructor
            return true
        if k = KindConstructorType
            return true
        if k = KindConstructSignature
            return true
        if k = KindForStatement
            return true
        if k = KindForInStatement
            return true
        if k = KindForOfStatement
            return true
        if k = KindFunctionDeclaration
            return true
        if k = KindFunctionExpression
            return true
        if k = KindFunctionType
            return true
        if k = KindGetAccessor
            return true
        if k = KindIndexSignature
            return true
        if k = KindJSDocSignature
            return true
        if k = KindMappedType
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindSetAccessor
            return true
        if k = KindSourceFile
            return true
        if k = KindTypeAliasDeclaration
            return true
        k = KindJSTypeAliasDeclaration
    }

    ; someSymbolTableInScope, materialised: `kinds` carries per table whether it
    ; is a LOCAL-NAME lookup (bit 1) and whether it is the globals table (bit 2).
    procedure collect_scope_tables(this, tables: ref[Array[ref[SymbolTable]?]], kinds: ref[Array[int]])
    {
        var location printer_enclosing_declaration
        while location <> null
        {
            let loc location as ref[AstNode]
            let k AstNode.kind_of(loc)
            if Checker.can_have_locals(k)
            {
                let locals AstNode.locals_of(loc)
                if locals <> null
                {
                    if this.is_global_source_file_node(loc) = false
                    {
                        tables.add(locals)
                        kinds.add(ScopeTableLocalNameLookup)
                    }
                }
            }
            var module_like false
            if k = KindSourceFile
            {
                if this.binder_of_node(loc).is_external_or_common_js_module()
                    set module_like: true
            }
            if k = KindModuleDeclaration
                set module_like: true
            if module_like
            {
                let sym this.get_symbol_of_declaration(loc)
                if sym <> null
                {
                    let exports Symbol.exports_of(sym as ref[Symbol])
                    if exports <> null
                    {
                        tables.add(exports)
                        kinds.add(ScopeTableLocalNameLookup)
                    }
                }
            }
            var class_like false
            if k = KindClassDeclaration
                set class_like: true
            if k = KindClassExpression
                set class_like: true
            if k = KindInterfaceDeclaration
                set class_like: true
            if class_like
            {
                let sym this.get_symbol_of_declaration(loc)
                if sym <> null
                {
                    let s sym as ref[Symbol]
                    let members Symbol.members_of(s)
                    if members <> null
                    {
                        var table: ref[SymbolTable]? null
                        let mn SymbolTable.length(members)
                        var mi 0
                        while mi < mn
                        {
                            let ms SymbolTable.entry_symbol_at(members, mi)
                            if ms <> null
                            {
                                if (Symbol.flags_of(ms as ref[Symbol]) & SymbolFlagsType) <> 0
                                {
                                    if table = null
                                        set table: SymbolTable.create(host)
                                    SymbolTable.set_entry(host, table as ref[SymbolTable], SymbolTable.entry_name_at(members, mi), ms)
                                }
                            }
                            set mi: mi + 1
                        }
                        if table <> null
                        {
                            tables.add(table)
                            kinds.add(0)
                        }
                    }
                    if k = KindClassExpression
                    {
                        let name AstNode.name_of(loc)
                        if name <> null
                        {
                            let text AstNode.identifier_text_of(name)
                            if text.length > 0
                            {
                                let nt SymbolTable.create(host)
                                SymbolTable.set_entry(host, nt, text, s)
                                tables.add(nt)
                                kinds.add(ScopeTableLocalNameLookup)
                            }
                        }
                    }
                }
            }
            set location: AstNode.parent_node_of(loc)
        }
        tables.add(globals)
        kinds.add(ScopeTableLocalNameLookup | ScopeTableGlobals)
    }

    procedure get_accessible_symbol_chain(this, symbol: ref[Symbol]?, meaning: int, out: ref[Array[ref[Symbol]?]]) returns bool
    {
        if symbol = null
            return false
        let s symbol as ref[Symbol]
        if Checker.is_property_or_method_declaration_symbol(s)
            return false
        let tables &Array[ref[SymbolTable]?]^host()
        let kinds &Array[int]^host()
        this.collect_scope_tables(tables, kinds)
        let n tables.get_length() as int
        var i 0
        while i < n
        {
            let t tables[i]
            if t <> null
            {
                let kind kinds[i]
                if this.accessible_chain_from_table(s, meaning, t as ref[SymbolTable], (kind & ScopeTableGlobals) <> 0, false, (kind & ScopeTableLocalNameLookup) <> 0, out)
                    return true
            }
            set i: i + 1
        }
        false
    }

    function is_property_or_method_declaration_symbol(symbol: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(symbol)
        if n = 0
            return false
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d = null
                return false
            let k AstNode.kind_of(d as ref[AstNode])
            var member false
            if k = KindPropertyDeclaration
                set member: true
            if k = KindMethodDeclaration
                set member: true
            if k = KindGetAccessor
                set member: true
            if k = KindSetAccessor
                set member: true
            if member = false
                return false
            set i: i + 1
        }
        true
    }

    ; getAccessibleSymbolChainFromSymbolTable: the (symbol, table) pair already on
    ; the visited stack answers nothing — the recursion guard of the reference.
    procedure accessible_chain_from_table(this, symbol: ref[Symbol], meaning: int, t: ref[SymbolTable], is_globals: bool, ignore_qualification: bool, is_local_name_lookup: bool, out: ref[Array[ref[Symbol]?]]) returns bool
    {
        if this.chain_visited(symbol, t)
            return false
        this.push_chain_visited(symbol, t)
        let r this.try_symbol_table(symbol, meaning, t, is_globals, ignore_qualification, is_local_name_lookup, out)
        this.pop_chain_visited()
        r
    }

    function chain_visited(this, symbol: ref[Symbol], t: ref[SymbolTable]) returns bool
    {
        if chain_visited_symbols = null
            return false
        let syms chain_visited_symbols as ref[Array[ref[Symbol]?]]
        let tabs chain_visited_tables as ref[Array[ref[SymbolTable]?]]
        var i 0
        while i < chain_visited_count
        {
            let vs syms[i]
            if vs <> null
            {
                if (vs as ref[Symbol]) = symbol
                {
                    let vt tabs[i]
                    if vt <> null
                    {
                        if (vt as ref[SymbolTable]) = t
                            return true
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    procedure push_chain_visited(this, symbol: ref[Symbol], t: ref[SymbolTable])
    {
        if chain_visited_symbols = null
        {
            set this.chain_visited_symbols: &Array[ref[Symbol]?]^host()
            set this.chain_visited_tables: &Array[ref[SymbolTable]?]^host()
        }
        let syms chain_visited_symbols as ref[Array[ref[Symbol]?]]
        let tabs chain_visited_tables as ref[Array[ref[SymbolTable]?]]
        if chain_visited_count < (syms.get_length() as int)
        {
            syms.put(chain_visited_count as size_t, symbol)
            tabs.put(chain_visited_count as size_t, t)
        }
        else
        {
            syms.add(symbol)
            tabs.add(t)
        }
        set this.chain_visited_count: chain_visited_count + 1
    }

    procedure pop_chain_visited(this)
        set this.chain_visited_count: chain_visited_count - 1

    ; trySymbolTable: the symbol itself when the table names it accessibly, else
    ; the shortest candidate chain through the table's aliases, else (globals only)
    ; the chain through globalThis.
    procedure try_symbol_table(this, symbol: ref[Symbol], meaning: int, t: ref[SymbolTable], is_globals: bool, ignore_qualification: bool, is_local_name_lookup: bool, out: ref[Array[ref[Symbol]?]]) returns bool
    {
        let res SymbolTable.get(t, Symbol.name_of(symbol))
        if res <> null
        {
            if this.is_accessible(symbol, meaning, res as ref[Symbol], null, ignore_qualification)
            {
                out.add(symbol)
                return true
            }
        }
        let chains &Array[ref[Array[ref[Symbol]?]]?]^host()
        if res <> null
        {
            let ex Symbol.export_symbol_of(res as ref[Symbol])
            if ex <> null
            {
                let merged this.get_merged_symbol(ex)
                if merged <> null
                {
                    if this.is_accessible(symbol, meaning, merged as ref[Symbol], null, ignore_qualification)
                    {
                        let one &Array[ref[Symbol]?]^host()
                        one.add(symbol)
                        chains.add(one)
                    }
                }
            }
        }
        let n SymbolTable.length(t)
        var i 0
        while i < n
        {
            let entry SymbolTable.entry_symbol_at(t, i)
            if entry <> null
            {
                let e entry as ref[Symbol]
                if this.alias_entry_is_a_candidate(e, ignore_qualification, is_local_name_lookup)
                {
                    let resolved this.resolve_alias(e)
                    if resolved <> null
                    {
                        let candidate &Array[ref[Symbol]?]^host()
                        if this.candidate_list_for_symbol(symbol, meaning, e, resolved as ref[Symbol], ignore_qualification, candidate)
                        {
                            if (candidate.get_length() as int) > 0
                                chains.add(candidate)
                        }
                    }
                }
            }
            set i: i + 1
        }
        let cn chains.get_length() as int
        if cn > 0
        {
            var best chains[0]
            var j 1
            while j < cn
            {
                let c chains[j]
                if c <> null
                {
                    if best <> null
                    {
                        if this.compare_symbol_chains(c as ref[Array[ref[Symbol]?]], best as ref[Array[ref[Symbol]?]]) < 0
                            set best: c
                    }
                }
                set j: j + 1
            }
            if best = null
                return false
            Checker.append_symbols(out, best as ref[Array[ref[Symbol]?]])
            return true
        }
        if is_globals
        {
            let gt global_this_symbol
            return this.candidate_list_for_symbol(symbol, meaning, gt, gt, ignore_qualification, out)
        }
        false
    }

    procedure compare_symbol_chains(this, a: ref[Array[ref[Symbol]?]], b2: ref[Array[ref[Symbol]?]]) returns int
    {
        let la a.get_length() as int
        let lb b2.get_length() as int
        if la <> lb
            return la - lb
        var i 0
        while i < la
        {
            let c this.compare_symbols(a[i], b2[i])
            if c <> 0
                return c
            set i: i + 1
        }
        0
    }

    function is_umd_export_symbol(symbol: ref[Symbol]) returns bool
    {
        if Symbol.declaration_count(symbol) = 0
            return false
        let d Symbol.declaration_at(symbol, 0)
        if d = null
            return false
        AstNode.kind_of(d as ref[AstNode]) = KindNamespaceExportDeclaration
    }

    procedure alias_entry_is_a_candidate(this, e: ref[Symbol], ignore_qualification: bool, is_local_name_lookup: bool) returns bool
    {
        if (Symbol.flags_of(e) & SymbolFlagsAlias) = 0
            return false
        if Checker.symbol_name_is_export_equals(e)
            return false
        if Checker.symbol_name_is_default(e)
            return false
        if Checker.is_umd_export_symbol(e)
        {
            if printer_enclosing_declaration <> null
            {
                if this.binder_of_node(printer_enclosing_declaration).is_external_module_of()
                    return false
            }
        }
        if is_local_name_lookup
        {
            if Checker.has_namespace_reexport_declaration(e)
                return false
        }
        if ignore_qualification = false
        {
            if Checker.get_declaration_of_kind(e, KindExportSpecifier) <> null
                return false
        }
        true
    }

    procedure candidate_list_for_symbol(this, symbol: ref[Symbol], meaning: int, from_table: ref[Symbol], resolved: ref[Symbol], ignore_qualification: bool, out: ref[Array[ref[Symbol]?]]) returns bool
    {
        if this.is_accessible(symbol, meaning, from_table, resolved, ignore_qualification)
        {
            out.add(from_table)
            return true
        }
        let table this.get_exports_of_symbol(resolved)
        if table = null
            return false
        let inner &Array[ref[Symbol]?]^host()
        if this.accessible_chain_from_table(symbol, meaning, table as ref[SymbolTable], false, true, false, inner) = false
            return false
        if (inner.get_length() as int) = 0
            return false
        if this.can_qualify_symbol(from_table, Checker.qualified_left_meaning(meaning)) = false
            return false
        out.add(from_table)
        Checker.append_symbols(out, inner)
        true
    }

    procedure is_accessible(this, symbol: ref[Symbol], meaning: int, from_table: ref[Symbol], resolved: ref[Symbol]?, ignore_qualification: bool) returns bool
    {
        var like false
        if resolved <> null
        {
            if symbol = (resolved as ref[Symbol])
                set like: true
        }
        if symbol = from_table
            set like: true
        let merged this.get_merged_symbol(symbol)
        if merged <> null
        {
            let m merged as ref[Symbol]
            if resolved <> null
            {
                let mr this.get_merged_symbol(resolved)
                if mr <> null
                {
                    if m = (mr as ref[Symbol])
                        set like: true
                }
            }
            let mt this.get_merged_symbol(from_table)
            if mt <> null
            {
                if m = (mt as ref[Symbol])
                    set like: true
            }
        }
        if like = false
            return false
        if this.symbol_has_non_global_augmentation_external_module_declaration(from_table)
            return false
        if ignore_qualification
            return true
        let mt2 this.get_merged_symbol(from_table)
        if mt2 = null
            return false
        this.can_qualify_symbol(mt2 as ref[Symbol], meaning)
    }

    procedure can_qualify_symbol(this, from_table: ref[Symbol], meaning: int) returns bool
    {
        if this.needs_qualification(from_table, meaning) = false
            return true
        let parent Symbol.parent_of(from_table)
        if parent = null
            return false
        let scratch &Array[ref[Symbol]?]^host()
        if this.get_accessible_symbol_chain(parent, Checker.qualified_left_meaning(meaning), scratch) = false
            return false
        (scratch.get_length() as int) > 0
    }

    ; getContainersOfSymbol, reduced. ★★★ THE REDUCTION IS THE NIL ENCLOSING
    ; DECLARATION AGAIN, AND IT REMOVES THREE OF THE FOUR SOURCES:
    ; `getAlternativeContainingModules` is guarded by it, the variable-in-scope
    ; search walks the same empty scope chain, and the `container is in scope`
    ; preference fork tests it directly. What is left of getWithAlternativeContainers
    ; is `additionalContainers ++ [container] ++ objectLiteralContainer`, and the
    ; first and last are the `export =` file symbol and an object literal's
    ; variable — neither of which a namespace or class container has. So the answer
    ; is the PARENT, and the candidate branch below it (a symbol with no parent but
    ; a module-level declaration) reports instead of guessing.
    ; getContainersOfSymbol + getWithAlternativeContainers: the containers a chain
    ; may climb through, best first. A parent symbol is the container when the
    ; symbol has one (and is not a type parameter); otherwise the candidates come
    ; from the declarations' module parents.
    procedure containers_of_symbol(this, symbol: ref[Symbol], meaning: int, out: ref[Array[ref[Symbol]?]])
    {
        let container this.get_parent_of_symbol(symbol)
        if container <> null
        {
            if (Symbol.flags_of(symbol) & SymbolFlagsTypeParameter) = 0
            {
                this.with_alternative_containers(container as ref[Symbol], symbol, meaning, out)
                return
            }
        }
        let candidates &Array[ref[Symbol]?]^host()
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let dd Symbol.declaration_at(symbol, i)
            set i: i + 1
            if dd <> null
            {
                let d dd as ref[AstNode]
                var handled false
                let parent AstNode.parent_node_of(d)
                if parent <> null
                {
                    let p parent as ref[AstNode]
                    if Checker.is_ambient_module_or_null(d) = false
                    {
                        if this.is_non_global_augmentation_external_module_symbol(p)
                        {
                            let sym this.get_symbol_of_declaration(p)
                            if sym <> null
                            {
                                if Checker.symbol_list_contains(candidates, sym as ref[Symbol]) = false
                                    candidates.add(sym)
                            }
                            set handled: true
                        }
                        if handled = false
                        {
                            if AstNode.kind_of(p) = KindModuleBlock
                            {
                                let pp AstNode.parent_node_of(p)
                                if pp <> null
                                {
                                    let psym this.get_symbol_of_declaration(pp)
                                    let resolved this.resolve_external_module_symbol(psym, false)
                                    if resolved <> null
                                    {
                                        if (resolved as ref[Symbol]) = symbol
                                        {
                                            if psym <> null
                                            {
                                                if Checker.symbol_list_contains(candidates, psym as ref[Symbol]) = false
                                                    candidates.add(psym)
                                            }
                                            set handled: true
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if handled = false
                    {
                        ; a class expression assigned to an access expression (JS):
                        ; `module.exports`/`exports.x` answer the file, anything
                        ; else the resolved left operand (slice 254)
                        if (AstNode.kind_of(d) = KindClassExpression) and (AstNode.kind_of(p) = KindBinaryExpression)
                        {
                            if AstNode.binary_operator_kind(p) = KindEqualsToken
                            {
                                let left AstNode.binary_left_of(p)
                                if Parser.is_access_expression(left)
                                {
                                    let left_expr AstNode.expression_of(left)
                                    if Parser.is_entity_name_expression(left_expr)
                                    {
                                        var exports_like Parser.is_module_exports_access_expression(left)
                                        if Parser.is_exports_identifier(left_expr)
                                            set exports_like: true
                                        var container_symbol: ref[Symbol]? null
                                        if exports_like
                                            set container_symbol: this.get_symbol_of_declaration(Checker.source_file_of_node(d))
                                        else
                                        {
                                            let cmark this.unported_mark()
                                            this.check_expression_cached(left_expr as ref[AstNode])
                                            if this.unported_mark() <> cmark
                                                return
                                            set container_symbol: this.symbol_node_link_of(left_expr as ref[AstNode]).resolved_symbol
                                        }
                                        if container_symbol <> null
                                        {
                                            if Checker.symbol_list_contains(candidates, container_symbol as ref[Symbol]) = false
                                                candidates.add(container_symbol)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        let cn candidates.get_length() as int
        if cn = 0
            return
        let bests &Array[ref[Symbol]?]^host()
        let alternatives &Array[ref[Symbol]?]^host()
        var ci 0
        while ci < cn
        {
            let co candidates[ci]
            set ci: ci + 1
            if co <> null
            {
                let c co as ref[Symbol]
                if this.get_alias_for_symbol_in_container(c, symbol) <> null
                {
                    let alts &Array[ref[Symbol]?]^host()
                    this.with_alternative_containers(c, symbol, meaning, alts)
                    let an alts.get_length() as int
                    if an > 0
                    {
                        bests.add(alts[0])
                        var ai 1
                        while ai < an
                        {
                            alternatives.add(alts[ai])
                            set ai: ai + 1
                        }
                    }
                }
            }
        }
        Checker.append_symbols(out, bests)
        Checker.append_symbols(out, alternatives)
    }

    function symbol_list_contains(list: ref[Array[ref[Symbol]?]], s: ref[Symbol]) returns bool
    {
        var i 0
        while i < (list.get_length() as int)
        {
            let e list[i]
            if e <> null
            {
                if (e as ref[Symbol]) = s
                    return true
            }
            set i: i + 1
        }
        false
    }

    procedure with_alternative_containers(this, container: ref[Symbol], symbol: ref[Symbol], meaning: int, out: ref[Array[ref[Symbol]?]])
    {
        let additional &Array[ref[Symbol]?]^host()
        let cn Symbol.declaration_count(container)
        var i 0
        while i < cn
        {
            let dd Symbol.declaration_at(container, i)
            if dd <> null
            {
                let fs this.get_file_symbol_if_file_symbol_export_equals_container(dd as ref[AstNode], container)
                if fs <> null
                    additional.add(fs)
            }
            set i: i + 1
        }
        let reexport &Array[ref[Symbol]?]^host()
        if printer_enclosing_declaration <> null
            this.get_alternative_containing_modules(symbol, reexport)
        let object_literal this.get_variable_declaration_of_object_literal(container, meaning)
        let left_meaning Checker.qualified_left_meaning(meaning)
        var container_first false
        if printer_enclosing_declaration <> null
        {
            if (Symbol.flags_of(container) & left_meaning) <> 0
            {
                let scratch &Array[ref[Symbol]?]^host()
                if this.get_accessible_symbol_chain(container, SymbolFlagsNamespace, scratch)
                {
                    if (scratch.get_length() as int) > 0
                        set container_first: true
                }
            }
        }
        if container_first
        {
            out.add(container)
            Checker.append_symbols(out, additional)
            Checker.append_symbols(out, reexport)
            if object_literal <> null
                out.add(object_literal)
            return
        }
        ; a value-space ask on a TYPE container (an interface) is answered by the
        ; variables in scope declared WITH that type — `Op: OpTypes` for the
        ; property `OpTypes.equal`; the first table with a match ends the walk
        let matches &Array[ref[Symbol]?]^host()
        var probe_variables false
        if meaning = SymbolFlagsValue
        {
            if (Symbol.flags_of(container) & left_meaning) = 0
            {
                if (Symbol.flags_of(container) & SymbolFlagsType) <> 0
                {
                    let declared this.get_declared_type_of_symbol(container)
                    if declared <> null
                    {
                        if ((declared as ref[Type]).flags & TypeFlagsObject) <> 0
                            set probe_variables: true
                    }
                }
            }
        }
        if probe_variables
        {
            let declared_opt this.get_declared_type_of_symbol(container)
            if declared_opt <> null
            {
                let declared declared_opt as ref[Type]
                let tables &Array[ref[SymbolTable]?]^host()
                let kinds &Array[int]^host()
                this.collect_scope_tables(tables, kinds)
                let tn tables.get_length() as int
                var ti 0
                var stopped false
                while ti < tn
                {
                    if stopped = false
                    {
                        let t tables[ti]
                        if t <> null
                        {
                            let en SymbolTable.length(t)
                            var ei 0
                            while ei < en
                            {
                                let es SymbolTable.entry_symbol_at(t, ei)
                                if es <> null
                                {
                                    let s es as ref[Symbol]
                                    if (Symbol.flags_of(s) & left_meaning) <> 0
                                    {
                                        let ts this.get_type_of_symbol(s)
                                        if ts <> null
                                        {
                                            if (ts as ref[Type]) = declared
                                            {
                                                matches.add(s)
                                                set stopped: true
                                            }
                                        }
                                    }
                                }
                                set ei: ei + 1
                            }
                        }
                    }
                    set ti: ti + 1
                }
                this.sort_symbols(matches, 0, matches.get_length() as int)
            }
        }
        Checker.append_symbols(out, matches)
        Checker.append_symbols(out, additional)
        out.add(container)
        if object_literal <> null
            out.add(object_literal)
        Checker.append_symbols(out, reexport)
    }

    procedure get_external_module_container(this, declaration: ref[AstNode]) returns ref[Symbol]?
    {
        var n: ref[AstNode]? declaration
        while n <> null
        {
            let node n as ref[AstNode]
            var external false
            if AstNode.kind_of(node) = KindSourceFile
            {
                if this.binder_of_node(node).is_external_or_common_js_module()
                    set external: true
            }
            if Checker.is_ambient_module_or_null(node)
                set external: true
            if external
                return this.get_symbol_of_declaration(node)
            set n: AstNode.parent_node_of(node)
        }
        null
    }

    procedure get_file_symbol_if_file_symbol_export_equals_container(this, d: ref[AstNode], container: ref[Symbol]) returns ref[Symbol]?
    {
        let file_symbol this.get_external_module_container(d)
        if file_symbol = null
            return null
        let exports Symbol.exports_of(file_symbol as ref[Symbol])
        if exports = null
            return null
        let exported SymbolTable.get(exports, "export=")
        if exported = null
            return null
        if this.get_symbol_if_same_reference(exported, container) = null
            return null
        file_symbol
    }

    ; getAlternativeContainingModules: the modules the enclosing file imports
    ; that re-export the symbol. The reference reads the parser's import list;
    ; this port scans the file's top-level import and export declarations (a
    ; nested `import()` or an import-equals is not scanned — reported).
    procedure get_alternative_containing_modules(this, symbol: ref[Symbol], out: ref[Array[ref[Symbol]?]])
    {
        var n printer_enclosing_declaration
        var file: ref[AstNode]? null
        while n <> null
        {
            let node n as ref[AstNode]
            if AstNode.kind_of(node) = KindSourceFile
            {
                set file: node
                set n: null
            }
            else
                set n: AstNode.parent_node_of(node)
        }
        if file = null
            return
        let stmts AstNode.statements_of(file)
        if stmts = null
            return
        let list stmts as ref[Array[ref[AstNode]?]]
        let sn list.get_length() as int
        var i 0
        while i < sn
        {
            let so list[i]
            set i: i + 1
            if so <> null
            {
                let stmt so as ref[AstNode]
                let k AstNode.kind_of(stmt)
                var has_specifier false
                ; an `import x = require("m")` is one of the file's imports (slice 254)
                if k = KindImportEqualsDeclaration
                {
                    let module_reference AstNode.module_reference_of(stmt)
                    if AstNode.kind_of(module_reference) = KindExternalModuleReference
                    {
                        let ref_expression AstNode.expression_of(module_reference)
                        if AstNode.kind_of(ref_expression) = KindStringLiteral
                        {
                            let resolved_equals this.resolve_external_module_name(printer_enclosing_declaration, ref_expression, true)
                            if resolved_equals <> null
                            {
                                if this.get_alias_for_symbol_in_container(resolved_equals as ref[Symbol], symbol) <> null
                                    out.add(resolved_equals)
                            }
                        }
                    }
                }
                if k = KindImportDeclaration
                    set has_specifier: true
                if k = KindExportDeclaration
                    set has_specifier: true
                if has_specifier
                {
                    let spec AstNode.module_specifier_of(stmt)
                    if spec <> null
                    {
                        let resolved this.resolve_external_module_name(printer_enclosing_declaration, spec, true)
                        if resolved <> null
                        {
                            if this.get_alias_for_symbol_in_container(resolved as ref[Symbol], symbol) <> null
                                out.add(resolved)
                        }
                    }
                }
            }
        }
        if (out.get_length() as int) > 0
            return
        ; no module the file imports: every external module of the program
        ; (slice 253; the reference caches this per symbol, location-independent)
        if program = null
            return
        let pf program as ref[ProgramFiles]
        var fi 0
        while fi < pf.ordered_count()
        {
            let other pf.file_at(pf.ordered_at(fi))
            let other_binder pf.binder_at(pf.ordered_at(fi))
            set fi: fi + 1
            if (other = null) or (other_binder = null)
                continue
            if (other_binder as ref[Binder]).is_external_module = false
                continue
            let sym this.get_symbol_of_declaration(other)
            if sym = null
                continue
            if this.get_alias_for_symbol_in_container(sym as ref[Symbol], symbol) <> null
                out.add(sym)
        }
    }

    procedure get_variable_declaration_of_object_literal(this, symbol: ref[Symbol], meaning: int) returns ref[Symbol]?
    {
        if (meaning & SymbolFlagsValue) = 0
            return null
        if Symbol.declaration_count(symbol) = 0
            return null
        let fd Symbol.declaration_at(symbol, 0)
        if fd = null
            return null
        let first fd as ref[AstNode]
        let parent AstNode.parent_node_of(first)
        if parent = null
            return null
        let p parent as ref[AstNode]
        if AstNode.kind_of(p) <> KindVariableDeclaration
            return null
        var matches false
        if AstNode.kind_of(first) = KindObjectLiteralExpression
        {
            let ini AstNode.initializer_of(p)
            if ini <> null
            {
                if (ini as ref[AstNode]) = first
                    set matches: true
            }
        }
        if AstNode.kind_of(first) = KindTypeLiteral
        {
            let ty AstNode.type_of(p)
            if ty <> null
            {
                if (ty as ref[AstNode]) = first
                    set matches: true
            }
        }
        if matches
            return this.get_symbol_of_declaration(p)
        null
    }

    procedure get_alias_for_symbol_in_container(this, container: ref[Symbol], symbol: ref[Symbol]) returns ref[Symbol]?
    {
        let parent this.get_parent_of_symbol(symbol)
        if parent <> null
        {
            if (parent as ref[Symbol]) = container
                return symbol
        }
        let cexports Symbol.exports_of(container)
        if cexports <> null
        {
            let ee SymbolTable.get(cexports, "export=")
            if ee <> null
            {
                if this.get_symbol_if_same_reference(ee, symbol) <> null
                    return container
            }
        }
        let exports this.get_exports_of_symbol(container)
        if exports = null
            return null
        let quick SymbolTable.get(exports, Symbol.name_of(symbol))
        if quick <> null
        {
            if this.get_symbol_if_same_reference(quick, symbol) <> null
                return quick
        }
        var best: ref[Symbol]? null
        let n SymbolTable.length(exports)
        var i 0
        while i < n
        {
            let eo SymbolTable.entry_symbol_at(exports, i)
            if eo <> null
            {
                let e eo as ref[Symbol]
                if this.get_symbol_if_same_reference(e, symbol) <> null
                {
                    var take false
                    if best = null
                        set take: true
                    else
                    {
                        if this.compare_symbols(e, best) < 0
                            set take: true
                    }
                    if take
                        set best: e
                }
            }
            set i: i + 1
        }
        best
    }

    ; `symbolFromSymbolTable.Name != InternalSymbolNameExportEquals` and the same
    ; for `default` — two of the four UNPREFIXED internal names (see
    ; Binder.internal_name_unprefixed for why they carry no 0xFE).
    function symbol_name_is_export_equals(s: ref[Symbol]) returns bool
        SymbolTable.names_equal(Symbol.name_of(s), "export=")

    function symbol_name_is_default(s: ref[Symbol]) returns bool
        SymbolTable.names_equal(Symbol.name_of(s), "default")

    ; isNamespaceReexportDeclaration — `IsNamespaceExport(node) && node.Parent
    ; .ModuleSpecifier() != nil`, asked over a symbol's declarations.
    function has_namespace_reexport_declaration(s: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(s)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(s, i)
            if d <> null
            {
                if AstNode.kind_of(d as ref[AstNode]) = KindNamespaceExport
                {
                    let p AstNode.parent_node_of(d as ref[AstNode])
                    if p <> null
                    {
                        if AstNode.module_specifier_of(p as ref[AstNode]) <> null
                            return true
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    ; `core.Some(symbol.Declarations, hasNonGlobalAugmentationExternalModuleSymbol)`
    ; — the predicate symbol_to_type_node already asks one declaration at a time.
    procedure symbol_has_non_global_augmentation_external_module_declaration(this, s: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(s)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(s, i)
            if d <> null
            {
                if this.is_non_global_augmentation_external_module_symbol(d as ref[AstNode])
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; getSymbolChain, with `yieldModuleSymbol` false — symbolToTypeNode passes
    ; `flags&UseAliasDefinedOutsideCurrentScope == 0` and typeToString SETS that
    ; flag, so the argument is false at this entry point and the module guard in
    ; the tail is live.
    ;
    ; ★★ THE PARENT LIST IS ONE ENTRY HERE (see containers_of_symbol), so the
    ; reference's loop over sorted parents is a single test. Its `export =` fork —
    ; *the parent's chain root IS this symbol* — is kept, because it is the one
    ; shape where the loop would otherwise name a symbol as its own container.
    procedure get_symbol_chain(this, symbol: ref[Symbol], meaning: int, end_of_chain: bool, out: ref[Array[ref[Symbol]?]]) returns bool
    {
        let mark this.unported_mark()
        let accessible &Array[ref[Symbol]?]^host()
        this.get_accessible_symbol_chain(symbol, meaning, accessible)
        if this.unported_mark() <> mark
            return false
        var qualifier_meaning meaning
        if (accessible.get_length() as int) > 1
            set qualifier_meaning: Checker.qualified_left_meaning(meaning)
        var go_up ((accessible.get_length() as int) = 0)
        if go_up = false
        {
            let head accessible[0]
            if head <> null
            {
                if this.needs_qualification(head as ref[Symbol], qualifier_meaning)
                    set go_up: true
            }
        }
        var chained false
        if go_up
        {
            var root symbol
            if (accessible.get_length() as int) > 0
            {
                let head accessible[0]
                if head <> null
                    set root: head as ref[Symbol]
            }
            let parents &Array[ref[Symbol]?]^host()
            this.containers_of_symbol(root, meaning, parents)
            if this.unported_mark() <> mark
                return false
            let pn parents.get_length() as int
            ; the reference orders parents by module specifier first (sortByBestName)
            ; and by compareSymbols among equals; the specifier is a module-resolution
            ; product this port does not compute, so two or more parents with an
            ; external module declaration are reported rather than ordered
            var pi 0
            var module_parents 0
            while pi < pn
            {
                let po parents[pi]
                if po <> null
                {
                    if this.symbol_has_non_global_augmentation_external_module_declaration(po as ref[Symbol])
                        set module_parents: module_parents + 1
                }
                set pi: pi + 1
            }
            if module_parents > 1
            {
                this.record_unported("symbol-chain-module-specifier-order", module_parents)
                return false
            }
            this.sort_symbols(parents, 0, parents.get_length() as int)
            set pi: 0
            var going true
            if pn = 0
                set going: false
            while going
            {
                let po parents[pi]
                set pi: pi + 1
                if pi >= pn
                    set going: false
                if po <> null
                {
                    let parent po as ref[Symbol]
                    let parent_chain &Array[ref[Symbol]?]^host()
                    this.get_symbol_chain(parent, Checker.qualified_left_meaning(meaning), false, parent_chain)
                    if this.unported_mark() <> mark
                        return false
                    if (parent_chain.get_length() as int) > 0
                    {
                        var took false
                        let pexports Symbol.exports_of(parent)
                        if pexports <> null
                        {
                            let exported SymbolTable.get(pexports, "export=")
                            if exported <> null
                            {
                                if this.get_symbol_if_same_reference(exported, symbol) <> null
                                {
                                    Checker.append_symbols(out, parent_chain)
                                    set took: true
                                }
                            }
                        }
                        if took = false
                        {
                            Checker.append_symbols(out, parent_chain)
                            if (accessible.get_length() as int) > 0
                                Checker.append_symbols(out, accessible)
                            else
                            {
                                let fallback this.get_alias_for_symbol_in_container(parent, symbol)
                                if fallback <> null
                                    out.add(fallback)
                                else
                                    out.add(symbol)
                            }
                        }
                        set chained: true
                        set going: false
                    }
                }
            }
        }
        if chained
            return true
        if (accessible.get_length() as int) > 0
        {
            Checker.append_symbols(out, accessible)
            return true
        }
        var write end_of_chain
        if (Symbol.flags_of(symbol) & (SymbolFlagsTypeLiteral | SymbolFlagsObjectLiteral)) = 0
            set write: true
        if write = false
            return false
        if (end_of_chain = false) and (printer_yield_module_symbol = false)
        {
            if this.symbol_has_non_global_augmentation_external_module_declaration(symbol)
            {
                set printer_chain_dropped_container: true
                return false
            }
        }
        out.add(symbol)
        true
    }

    procedure append_symbols(out: ref[Array[ref[Symbol]?]], src: ref[Array[ref[Symbol]?]])
    {
        var i 0
        while i < (src.get_length() as int)
        {
            out.add(src[i])
            set i: i + 1
        }
    }

    ; lookupSymbolChainWorker. ★A TYPE PARAMETER is never qualified — it has no
    ; container that could name it — and that test is upstream's first conjunct.
    ; lookupSymbolChainWorker: a type parameter is its own chain; under an
    ; enclosing declaration (or a fully-qualified ask) the chain is computed;
    ; otherwise the symbol alone.
    procedure lookup_symbol_chain(this, symbol: ref[Symbol], meaning: int, out: ref[Array[ref[Symbol]?]])
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsTypeParameter) <> 0
        {
            out.add(symbol)
            return
        }
        var qualify printer_fully_qualified
        if printer_enclosing_declaration <> null
            set qualify: true
        if qualify = false
        {
            out.add(symbol)
            return
        }
        this.get_symbol_chain(symbol, meaning, true, out)
        if (out.get_length() as int) = 0
            out.add(symbol)
    }

    ; symbolToExpression for a unique-symbol property name: the chain, dotted.
    ; createExpressionFromSymbolChain writes a property access where the name is
    ; identifier text and an element access otherwise; only the former is written.
    procedure write_symbol_expression_chain(this, symbol: ref[Symbol], out: ref[StringBuilder]) returns bool
    {
        let chain &Array[ref[Symbol]?]^host()
        this.lookup_symbol_chain(symbol, SymbolFlagsValue, chain)
        let n chain.get_length() as int
        var i 0
        while i < n
        {
            let e chain[i]
            if e = null
                return false
            let es e as ref[Symbol]
            if i > 0
            {
                if Checker.is_identifier_text(Symbol.name_of(es)) = false
                {
                    this.record_unported("property-name-unique-symbol-element-access", i)
                    return false
                }
                out.append("." as char)
            }
            if this.write_symbol_name(es, out) = false
                return false
            set i: i + 1
        }
        true
    }

    procedure symbol_to_type_node(this, symbol: ref[Symbol], mask: int, out: ref[StringBuilder]) returns bool
    {
        var is_module false
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if this.is_non_global_augmentation_external_module_symbol(d as ref[AstNode])
                    set is_module: true
            }
            set i: i + 1
        }
        if is_module
        {
            ; The module is the chain's root, so the node is an ImportTypeNode whose
            ; qualifier is nil (the chain is one element) and whose type-argument
            ; list is nil (a module symbol has no type parameters).
            let nd Symbol.name_of(symbol)
            let nl Symbol.name_len_of(symbol)
            if Checker.is_ambient_module_symbol_name(nd) = false
            {
                this.record_unported("type-to-string-import-type", 0)
                return false
            }
            if mask = SymbolFlagsValue
                out.append("typeof ")
            let imp_start out.get_length() as int
            out.append("import(")
            Checker.write_ascii_escaped_literal_name(out, nd.subslice(1, (nl - 1) as size_t))
            out.append(")" as char)
            this.add_approximate_length((out.get_length() as int) - imp_start)
            ; An ImportTypeNode is TypePrecedenceNonArray — `typeof import("x")`
            ; included, because the `typeof` is a FIELD of that node and not a
            ; TypeQuery around it.
            set wrote_type_precedence: TypePrecedenceNonArray
            return true
        }
        ; `isTypeOf := mask == SymbolFlagsValue` — a TypeQueryNode, which the printer
        ; writes as the keyword, a space, and the entity name.
        ;
        ; ★★★ A TypeQueryNode IS TypePrecedenceTypeOperator AND THE REFERENCE SAYS
        ; WHY IN ITS OWN TABLE: *"TypeQueryNode is actually a NonArrayType, but we
        ; treat it as TypeOperatorNode precedence so that it is parenthesized when
        ; used in a PostfixType context (e.g., `(typeof C)[]` instead of `typeof
        ; C[]`)"*. This arm set nothing until slice 183, so it answered whatever the
        ; entry seed or a nested call had left — NonArray from `type_to_string`'s
        ; own first line — and six units printed the second spelling, which is a
        ; DIFFERENT TYPE. See write_postfix_type_operand, whose note claimed the
        ; opposite and is corrected there.
        if mask = SymbolFlagsValue
        {
            out.append("typeof ")
            if this.write_symbol_chain(symbol, mask, out) = false
                return false
            set wrote_type_precedence: TypePrecedenceTypeOperator
            return true
        }
        if this.write_symbol_chain(symbol, mask, out) = false
            return false
        ; A TypeReferenceNode is TypePrecedenceNonArray.
        set wrote_type_precedence: TypePrecedenceNonArray
        ; …and its TypeName is an Identifier exactly when the chain had one
        ; element; a longer chain is a QualifiedName and needs no disambiguating.
        if wrote_chain_length = 1
        {
            set wrote_type_reference_name: Symbol.name_of(symbol)
            set wrote_name_depth: printer_depth
        }
        true
    }

    ; createAccessFromSymbolChain over the chain lookup_symbol_chain answers — the
    ; entity name, LEAF LAST, each element named by getNameOfSymbolAsWritten (which
    ; is what write_symbol_name is).
    ;
    ; ★★ WITH THE FLAG OFF THE CHAIN IS ONE ELEMENT AND THIS IS write_symbol_name
    ; WITH A LOOP AROUND IT — which is why the conversion is emission-neutral for
    ; every name the corpus printed before slice 183. The loop is not hoisted out
    ; of the common case: a length-one chain costs one Array and the printer is not
    ; on any measured path.
    procedure write_symbol_chain(this, symbol: ref[Symbol], mask: int, out: ref[StringBuilder]) returns bool
    {
        let host Page.get(this)
        let chain &Array[ref[Symbol]?]^host()
        this.lookup_symbol_chain(symbol, mask, chain)
        let n chain.get_length() as int
        set wrote_chain_length: n
        var i 0
        ; a module root (only kept under yieldModuleSymbol): symbolToTypeNode's
        ; ImportTypeNode, `import("specifier")` qualified by the rest of the chain
        if printer_yield_module_symbol and (n > 1)
        {
            let root chain[0]
            if root <> null
            {
                let rs root as ref[Symbol]
                if this.symbol_has_non_global_augmentation_external_module_declaration(rs)
                {
                    let nd Symbol.name_of(rs)
                    if Checker.is_ambient_module_symbol_name(nd) = false
                    {
                        this.record_unported("type-to-string-import-type", 1)
                        return false
                    }
                    let imp_start out.get_length() as int
                    out.append("import(")
                    Checker.write_ascii_escaped_literal_name(out, nd.subslice(1, (Symbol.name_len_of(rs) - 1) as size_t))
                    out.append(")" as char)
                    this.add_approximate_length((out.get_length() as int) - imp_start)
                    set i: 1
                }
            }
        }
        while i < n
        {
            if i > 0
                out.append("." as char)
            let e chain[i]
            if e = null
                return false
            let el_start out.get_length() as int
            if this.write_symbol_name(e as ref[Symbol], out) = false
                return false
            ; createAccessFromSymbolChain adds the ROOT's width twice — once in
            ; its index-0 arm and once unconditionally after it
            this.add_approximate_length(((out.get_length() as int) - el_start) + 1)
            if i = 0
                this.add_approximate_length(((out.get_length() as int) - el_start) + 1)
            set i: i + 1
        }
        true
    }

    ; hasNonGlobalAugmentationExternalModuleSymbol — a module declaration whose name
    ; is a STRING literal (`declare module "x"`), or a source file that is itself a
    ; module. ★The string-literal test is what makes it *non-global*: a
    ; `declare global` block and a dotted namespace both fail it.
    procedure is_non_global_augmentation_external_module_symbol(this, d: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(d) = KindModuleDeclaration
        {
            let nm AstNode.name_of(d)
            if nm <> null
            {
                if AstNode.kind_of(nm as ref[AstNode]) = KindStringLiteral
                    return true
            }
            return false
        }
        if AstNode.kind_of(d) <> KindSourceFile
            return false
        ; the FILE's own binder answers, not the unit's (slice 251: `0.ts` of a
        ; program is a module whatever the unit being emitted is)
        (this.binder_of_node(d)).is_external_or_common_js_module()
    }

    ; getNonMissingTypeOfSymbol — getTypeOfSymbol with the missing type removed when
    ; the symbol is optional. Both halves already exist; this is the pair.
    procedure get_non_missing_type_of_symbol(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t this.get_type_of_symbol(symbol)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        var optional false
        if (Symbol.flags_of(symbol) & SymbolFlagsOptional) <> 0
            set optional: true
        this.remove_missing_type(t as ref[Type], optional)
    }

    ; getNameOfSymbolFromNameType — the name a symbol carries on its LINK rather
    ; than on a declaration, which is how a late-bound member and a mapped-type
    ; property are named at all.
    ;
    ; ★★★ IT ANSWERS THE EMPTY STRING FOR THREE DIFFERENT REASONS and the caller
    ; must tell that apart from a name, so the answer is the out-cell `wrote` and
    ; the RESULT is the usual *no stop was recorded*. Writing into `out` and then
    ; measuring its length would not do: the empty answer is decided BEFORE
    ; anything is written, and every arm below is a single append.
    ;
    ; ★ The three arms are the reference's, in its order: not an identifier and
    ; not a numeric name → `valueToString`, which QUOTES a string and writes a
    ; number bare; a NEGATIVE numeric name → `[-1]`, because the minus cannot ride
    ; on a numeric-literal node; anything else → the name itself.
    procedure write_name_of_symbol_from_name_type(this, symbol: ref[Symbol], out: ref[StringBuilder], wrote: ref[bool]) returns bool
    {
        set wrote: false
        let links this.value_symbol_link_of(symbol)
        if links.name_type = null
            return true
        let nt links.name_type as ref[Type]
        if (nt.flags & TypeFlagsUniqueESSymbol) <> 0
        {
            ; `[` + getNameOfSymbolAsWritten(uniqueESSymbolType.symbol) + `]`.
            ; ★The note that stood here said *the symbol behind a unique symbol
            ; type has no accessor* — it rides `Type.symbol` since slice 146, and
            ; write_symbol_name IS getNameOfSymbolAsWritten (its own header says
            ; so), so the arm is three appends.
            if nt.symbol = null
                return false
            out.append("[")
            if this.write_symbol_name(nt.symbol as ref[Symbol], out) = false
                return false
            out.append("]")
            set wrote: true
            return true
        }
        if (nt.flags & TypeFlagsStringOrNumberLiteral) = 0
            return true
        var nb char[JSNUM_MAX_TEXT]
        let nd this.get_property_name_from_type(nt, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if nd.data = null
            return false
        let numeric Checker.is_numeric_literal_name(nd)
        if Checker.is_identifier_text(nd) = false
        {
            if numeric = false
            {
                if (nt.flags & TypeFlagsStringLiteral) <> 0
                    Checker.write_string_literal_name(out, Checker.literal_text_of(nt))
                else
                    out.append(nd.data, nd.length)
                set wrote: true
                return true
            }
        }
        if numeric
        {
            if (nd[0] as int) = (("-" as char) as int)
            {
                out.append("[" as char)
                out.append(nd.data, nd.length)
                out.append("]" as char)
                set wrote: true
                return true
            }
        }
        out.append(nd.data, nd.length)
        set wrote: true
        true
    }

    ; EscapeInternalSymbolName — the 0xFE sentinel a synthetic name carries becomes
    ; the two underscores a reader sees. Every other name is written as it stands.
    procedure write_escaped_internal_symbol_name(out: ref[StringBuilder], name: Slice[char])
    {
        if name.length > (0 as size_t)
        {
            if (name[0] as int) = 0xFE
            {
                out.append("__")
                out.append(name.data + 1, name.length - (1 as size_t))
                return
            }
        }
        out.append(name.data, name.length)
    }

    ; getNameOfSymbolAsWritten, reduced by the two flag arguments above and by
    ; nothing else.
    ;
    ; ★★ THE COMPUTED-PROPERTY FORK asks the LATE-BOUND name — a different table —
    ; and is entered by a symbol whose first named declaration has a computed name,
    ; which a class member can have. It was a stop until the name-type writer above
    ; arrived. ★The three ANONYMOUS arms below it (`(Anonymous class)`,
    ; `(Anonymous function)`) are names too and are written: the `encounteredError`
    ; they set is a nodebuilder flag whose only reader is the caller's error path,
    ; and typeToString passes IgnoreErrors.
    procedure write_symbol_name(this, symbol: ref[Symbol], out: ref[StringBuilder]) returns bool
    {
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let name b.get_name_of_declaration(d as ref[AstNode])
                if name <> null
                {
                    let nm name as ref[AstNode]
                    if AstNode.kind_of(nm) = KindComputedPropertyName
                    {
                        if (Symbol.check_flags_of(symbol) & CheckFlagsLate) = 0
                        {
                            ; ★The reference's guard is narrower than the writer
                            ; below: only a STRING-OR-NUMBER name type takes this
                            ; fork, and only when it produces a non-empty name.
                            ; Everything else falls through to the declaration.
                            let lk this.value_symbol_link_of(symbol)
                            if lk.name_type <> null
                            {
                                let ntc lk.name_type as ref[Type]
                                if (ntc.flags & TypeFlagsStringOrNumberLiteral) <> 0
                                {
                                    var w false
                                    let ok this.write_name_of_symbol_from_name_type(symbol, out, &w)
                                    if ok = false
                                        return false
                                    if w
                                        return true
                                }
                            }
                        }
                    }
                    return this.write_declaration_name(nm, out)
                }
            }
            set i: i + 1
        }
        if n > 0
        {
            let d0 Symbol.declaration_at(symbol, 0)
            if d0 <> null
            {
                let decl d0 as ref[AstNode]
                let parent AstNode.parent_node_of(decl)
                if parent <> null
                {
                    if AstNode.kind_of(parent as ref[AstNode]) = KindVariableDeclaration
                        return this.write_declaration_name(AstNode.name_of(parent as ref[AstNode]), out)
                }
                let k AstNode.kind_of(decl)
                if k = KindClassExpression
                    return Checker.write_keyword(out, "(Anonymous class)")
                if k = KindFunctionExpression
                    return Checker.write_keyword(out, "(Anonymous function)")
                if k = KindArrowFunction
                    return Checker.write_keyword(out, "(Anonymous function)")
            }
        }
        ; getNameOfSymbolFromNameType, then EscapeInternalSymbolName(symbol.Name).
        ; ★The note that stood here said a symbol reaching this line *has no
        ; declaration at all, which nothing this port mints does* — and the
        ; frontier's largest row was this stop. The population is the anonymous
        ; class and function EXPRESSIONS whose declaration list is empty, plus the
        ; synthetic names behind the 0xFE sentinel.
        var w false
        let ok this.write_name_of_symbol_from_name_type(symbol, out, &w)
        if ok = false
            return false
        if w
            return true
        Checker.write_escaped_internal_symbol_name(out, Symbol.name_of(symbol))
        true
    }

    ; scanner.DeclarationNameToString — `(Missing)` for an empty range, and the
    ; node's own SOURCE TEXT otherwise. ★It is the source and not the scanned
    ; identifier text, which differs for `\u0041bc`; the ReparserTransformedLiteral
    ; fork above it is a JS-only shape and is a stop.
    procedure write_declaration_name(this, name: ref[AstNode]?, out: ref[StringBuilder]) returns bool
    {
        if name = null
            return Checker.write_keyword(out, "(Missing)")
        let nm name as ref[AstNode]
        let pos AstNode.pos_of(nm)
        let stop AstNode.end_of(nm)
        if pos = stop
            return Checker.write_keyword(out, "(Missing)")
        if (AstNode.flags_of(nm) & NodeFlagsReparserTransformedLiteral) <> 0
        {
            this.record_unported("declaration-name-reparser-transformed", 0)
            return false
        }
        ; ★ The node's OWN binder: since slice 113 a printed declaration name can be
        ; a LIB declaration's, and the source text is the only thing in this file
        ; that is per-file rather than per-node.
        let nb this.binder_of_node(nm)
        let start nb.skip_trivia_at(pos)
        let text nb.source_slice(start, stop)
        out.append(text.data, text.length)
        true
    }

    ; ── the ENTITY NAME's text (slice 148) ──────────────────────────────────
    ;
    ; scanner.GetTextOfNodeFromSourceText with `includeTrivia = false`, which is
    ; what scanner.GetTextOfNode is. ★★ IT IS write_declaration_name WITHOUT THE
    ; TWO `(Missing)` ANSWERS, and the difference is load-bearing rather than
    ; cosmetic: DeclarationNameToString substitutes that WORD for an empty range
    ; while this one answers the EMPTY STRING, and both callers below fork on the
    ; LENGTH of what comes back — a `(Missing)` would be nine characters of text
    ; where the reference has none, which is the difference between TS2532 and
    ; TS18048.
    procedure write_text_of_node(this, node: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        if Parser.node_is_missing(node)
            return true
        if (AstNode.flags_of(node) & NodeFlagsReparserTransformedLiteral) <> 0
        {
            ; The reparser transforms a string literal and an identifier into one
            ; another and nothing else; an entity name can only be the second, and
            ; there the reference answers the SCANNED text rather than the source
            ; range. The literal arms cannot arrive and are a stop for the reason
            ; write_declaration_name's are.
            if AstNode.kind_of(node) = KindIdentifier
            {
                let t AstNode.identifier_text_of(node)
                out.append(t.data, t.length)
                return true
            }
            this.record_unported("text-of-node-reparser-transformed", AstNode.kind_of(node))
            return false
        }
        let text this.source_text_of_node(node)
        out.append(text.data, text.length)
        true
    }

    ; The same source range as a VIEW. ★★It exists so the `== "undefined"` test
    ; below reads the bytes write_text_of_node writes rather than a second
    ; derivation of them, and the two genuinely differ: `\u0075ndefined` SCANS as
    ; `undefined` and READS as `\u0075ndefined`, so asking the scanner's text
    ; would put TS18050 on a name the reference gives TS18048.
    procedure source_text_of_node(this, node: ref[AstNode]) returns Slice[char]
    {
        let nb this.binder_of_node(node)
        let start nb.skip_trivia_at(AstNode.pos_of(node))
        nb.source_slice(start, AstNode.end_of(node))
    }

    ; ast.EntityNameToString, composed over a StringBuilder because what its two
    ; callers fork on is the LENGTH of the answer and not the answer: the type
    ; dump compares `C pos end code`, so the text itself is never printed and only
    ; its size and the one `undefined` comparison decide anything.
    ;
    ; ★ NodeIsSynthesized is not asked. The reference uses it to fall back on the
    ; scanned text for a node with no source range, and every node reaching here
    ; comes out of is_entity_name_expression over a parsed tree; the reparser's own
    ; transformed identifiers are the arm above, which answers the same text that
    ; branch would.
    ;
    ; ★★ THE `this` AND JsxNamespacedName ARMS HAVE NO INPUT FROM EITHER CALLER —
    ; isEntityNameExpression admits an Identifier and a dotted chain of them and
    ; nothing else — and they are written anyway, because EntityNameToString is one
    ; function upstream and a caller that arrives with a JSX name must meet a text
    ; rather than a gap. The kinds that remain are the reference's own panic.
    procedure write_entity_name(this, name: ref[AstNode], out: ref[StringBuilder]) returns bool
    {
        let k AstNode.kind_of(name)
        if k = KindThisKeyword
            return Checker.write_keyword(out, "this")
        if k = KindIdentifier
            return this.write_text_of_node(name, out)
        if k = KindPrivateIdentifier
            return this.write_text_of_node(name, out)
        if k = KindQualifiedName
        {
            let l AstNode.qualified_left_of(name)
            let r AstNode.qualified_right_of(name)
            if l = null
                return false
            if r = null
                return false
            if this.write_entity_name(l as ref[AstNode], out) = false
                return false
            out.append("." as char)
            return this.write_entity_name(r as ref[AstNode], out)
        }
        if k = KindPropertyAccessExpression
        {
            let e AstNode.expression_of(name)
            let n AstNode.property_access_name_of(name)
            if e = null
                return false
            if n = null
                return false
            if this.write_entity_name(e as ref[AstNode], out) = false
                return false
            out.append("." as char)
            return this.write_entity_name(n as ref[AstNode], out)
        }
        if k = KindJsxNamespacedName
        {
            let ns AstNode.namespaced_namespace_of(name)
            let n AstNode.namespaced_name_of(name)
            if ns = null
                return false
            if n = null
                return false
            if this.write_entity_name(ns as ref[AstNode], out) = false
                return false
            out.append(":" as char)
            return this.write_entity_name(n as ref[AstNode], out)
        }
        ; The reference PANICS here ("Unhandled case in EntityNameToString").
        this.record_unported("entity-name-to-string-kind", k)
        false
    }

    ; The fourteen keyword arms, which used to BE the answer and are now the
    ; degenerate case of composing one.
    procedure write_keyword(out: ref[StringBuilder], name: Slice[char]) returns bool
    {
        out.append(name.data, name.length)
        true
    }

    ; PseudoBigInt.String(): the empty Base10Value is the value ZERO, and a
    ; non-empty one is prefixed with a minus when the sign is set. The length test
    ; is the reference's and is not interchangeable with a digit test — see
    ; bigint_literal_arm for why zero is stored empty in the first place.
    procedure write_pseudo_big_int(out: ref[StringBuilder], t: ref[Type])
        Checker.write_pseudo_big_int_value(out, Checker.literal_text_of(t), Checker.literal_negative_of(t))

    ; ★★ THE THREE COMPOSING BODIES ARE STATICS OVER BYTES rather than over a
    ; Type, and that is what lets tests/litcheck.sh measure THIS code instead of a
    ; copy of it. An instrument that re-implements what it checks agrees with
    ; itself, which is the one thing a second producer must not do — and the first
    ; draft of that battery did exactly that until g17 refused to apply and said
    ; so.
    procedure write_pseudo_big_int_value(out: ref[StringBuilder], text: Slice[char], negative: bool)
    {
        if text.length = 0
        {
            out.append("0" as char)
            return
        }
        if negative
            out.append("-" as char)
        out.append(text.data, text.length)
    }

    ; The string literal's whole name: a double quote, the escape worker, a double
    ; quote.
    procedure write_string_literal_name(out: ref[StringBuilder], text: Slice[char])
        Checker.write_quoted_literal_name(out, text, 0x22, true)

    ; The same literal WITHOUT the emit flag, which is the enum member's indexed
    ; access (slice 116): `newStringLiteral` is built there with no EmitFlags at
    ; all, so getLiteralText's NeverAsciiEscape is off and a non-ASCII name is
    ; written as `\uXXXX`.
    procedure write_ascii_escaped_literal_name(out: ref[StringBuilder], text: Slice[char])
        Checker.write_quoted_literal_name(out, text, 0x22, false)

    ; getLiteralText's StringLiteral arm, with the delimiter the node's
    ; TokenFlagsSingleQuote selects. ★The two callers are not symmetric: a string
    ; literal TYPE's name is built with no token flags at all and is therefore always
    ; double-quoted, while a property NAME carries the flag from its declarations.
    procedure write_quoted_literal_name(out: ref[StringBuilder], text: Slice[char], quote_char: int, never_ascii_escape: bool)
    {
        out.append(quote_char as char)
        Checker.escape_string_worker(out, text, quote_char, never_ascii_escape)
        out.append(quote_char as char)
    }

    ; `jsnum.ParsePseudoBigInt(text)` followed by NewPseudoBigInt's
    ; `strings.TrimLeft(value, "0")` — the two steps between a bigint literal's
    ; TEXT and the digits a PseudoBigInt holds, with the all-zero case answering
    ; the EMPTY string the reference represents zero as. Answers the length and
    ; writes the START OFFSET into `out` through `out_start`, or -1 when
    ; ParsePseudoBigInt refuses the text.
    procedure pseudo_big_int_digits(text: Slice[char], out: Slice[char], out_start: ref[int]) returns int
    {
        set out_start: 0
        let m jsnum_parse_pseudo_big_int(text, out)
        if m < 0
            return 0 - 1
        var i 0
        while i < m
        {
            if (out[i] as int) <> (("0" as char) as int)
                break
            set i: i + 1
        }
        set out_start: i
        m - i
    }

    ; ── printer/utilities.go's escapeStringWorker ───────────────────────────
    ;
    ; ★★★ THE "ALWAYS A DOUBLE QUOTE" HALF OF THIS NARROWING WAS FALSE AND ONLY STAGE
    ; 2 FOUND IT. The note read *"the quote character is always the double quote
    ; (nodeBuilder passes isSingleQuote false and never sets
    ; FlagsUseSingleQuotesForStringLiteralType)"* — and the FLAG does not come from a
    ; parameter at all: createPropertyNameNodeForIdentifierOrLiteral stamps
    ; `TokenFlagsSingleQuote` onto the SYNTHESIZED literal when every declaration of
    ; the symbol is single-quoted (isSingleQuotedStringNamed), and getLiteralText
    ; reads that flag off the node. So `{ 'stage-0': T }` prints with single quotes,
    ; and this port printed double. **A narrowing that names the wrong INPUT is
    ; indistinguishable from a correct one until the other input appears.**
    ;
    ; ★★ THE QUOTE CHARACTER IS THE ESCAPE TRIGGER AND NOT THE ESCAPE TABLE. The
    ; reference's `case rune(quoteChar)` is what decides, while escapedCharsMap
    ; carries BOTH `\"` and `\'` unconditionally — so inside a single-quoted name a
    ; double quote is written BARE and an apostrophe is escaped, which is the
    ; opposite of the double-quoted case and is why the parameter had to reach the
    ; trigger rather than only the delimiters.
    ;
    ; What is still narrowed, and honestly: the flags are always
    ; NeverAsciiEscape and never JsxAttributeEscape (the emit flag the builder adds
    ; is exactly EFNoAsciiEscaping). So the three arms that read `quoteChar ==
    ; backtick`, the whole JSX branch and the `ch > 0x7f` half of the default test
    ; are all decided here rather than carried.
    ;
    ; ★★ WHAT SURVIVES THE NARROWING IS THE PART THAT ACTUALLY BITES: the canonical
    ; escapes, the sub-0x20 controls, the three line-ish code points U+2028,
    ; U+2029 and U+0085, and the SURROGATE cases — a lone surrogate and a
    ; supplementary code point both become `\uXXXX` sequences, uppercase hex, and a
    ; supplementary one becomes TWO of them.
    ;
    ; ★★★ THE DECODER IS `DecodeJSStringRune` AND NOT PLAIN UTF-8, which is the one
    ; place this could have been silently wrong: the scanner writes a lone
    ; surrogate out as its three-byte sentinel (see value_put_codepoint), and Go's
    ; own utf8 decoder REFUSES that encoding and answers RuneError — so a port
    ; reaching for the ordinary decoder would print U+FFFD where the reference
    ; prints `\uD800`.
    procedure escape_string_worker(out: ref[StringBuilder], s: Slice[char], quote_char: int, never_ascii_escape: bool)
    {
        var i 0
        while i < s.length
        {
            var size 0
            let ch Checker.decode_js_string_rune(s, i, &size)

            var escape false
            if (ch >= 0xD800) and (ch <= 0xDFFF)
                set escape: true
            if ch = 0xFFFD
            {
                ; `ch == utf8.RuneError && size == 1` — a stray byte that is not
                ; valid UTF-8. A REAL U+FFFD in the text decodes with size 3 and is
                ; not escaped, which is why the size is part of the test.
                if size = 1
                    set escape: true
            }
            if ch = 0x5C
                set escape: true
            if ch = quote_char
                set escape: true
            if ch = 0x2028
                set escape: true
            if ch = 0x2029
                set escape: true
            if ch = 0x0085
                set escape: true
            if ch = 0x0D
                set escape: true
            ; ★★★ THE THREE BACKTICK ARMS, SLICE 186 — the note above called them
            ; *decided here rather than carried* while every caller passed a quote
            ; or an apostrophe, and the template literal TYPE's texts are the
            ; caller that does not: `` `${string}:\t${number}` `` is written with
            ; a backtick delimiter, where a template preserves a simple LF, a `${`
            ; has to be escaped so the text cannot read as a substitution, and a
            ; CRLF must stay one escape rather than two.
            if ch = 0x0A
            {
                if quote_char <> 0x60
                    set escape: true
            }
            if ch = 0x24
            {
                if quote_char = 0x60
                {
                    if (i + size) < s.length
                    {
                        if (s[(i + size)] as int) = 0x7B
                            set escape: true
                    }
                }
            }
            if ch <= 0x1F
                set escape: true
            ; `flags&NeverAsciiEscape == 0 && ch > '\u007f'` — the second disjunct
            ; of the reference's DEFAULT arm, and slice 116 is what gave it an
            ; input. Until then every caller carried the flag, which is why the
            ; parameter did not exist and the note at write_utf16_escape called
            ; the supplementary-plane arm unreachable.
            if never_ascii_escape = false
            {
                if ch > 0x7F
                    set escape: true
            }

            if escape = false
            {
                out.append(s.data + i, size as size_t)
                set i: i + size
                continue
            }

            ; "Template strings preserve simple LF newlines, but still must escape
            ; CRLF. Left alone, the above cases for `\r` and `\n` would
            ; inadvertently escape CRLF as two independent characters."
            if ch = 0x0D
            {
                if quote_char = 0x60
                {
                    var crlf false
                    if (i + size) < s.length
                    {
                        if (s[(i + size)] as int) = 0x0A
                            set crlf: true
                    }
                    if crlf
                    {
                        out.append("\\r\\n")
                        set i: i + size + 1
                        continue
                    }
                }
            }
            ; ★★★ THE SUPPLEMENTARY-PLANE ARM IS BACK, AND ITS REMOVAL IS THE
            ; CLEANEST EXAMPLE IN THIS FILE OF A NARROWING THAT EXPIRES (§3.5p).
            ; It was transcribed in slice 111, removed when slice 115's row g13
            ; came back UNGATED, and the reason recorded for the removal was
            ; exact: *a code point above 0x7f is escaped only by the default
            ; test's second disjunct, which NeverAsciiEscape switches off, and
            ; none of the other conditions can be true above 0xffff.* Every word
            ; of that held while every caller carried the flag. ★★Slice 116 added
            ; the caller that does not — the enum member printed as an INDEXED
            ; ACCESS — and **stage 2 found it in one unit of 18 391**
            ; (`enumWithUnicodeEscape1`, `enum E { 'gold \u2730' }`), which stage 1
            ; cannot: no fixture in the corpus had a non-ASCII enum member name.
            ; ★A LONE surrogate is a different matter and was always escaped: it
            ; fails the UTF-8 decoder's own range test rather than the ascii one.
            if ch > 0xFFFF
            {
                let c ch - 0x10000
                Checker.write_utf16_escape(out, ((c >> 10) & 0x3FF) + 0xD800)
                Checker.write_utf16_escape(out, (c & 0x3FF) + 0xDC00)
                set i: i + size
                continue
            }
            if (ch >= 0xD800) and (ch <= 0xDFFF)
            {
                Checker.write_utf16_escape(out, ch)
                set i: i + size
                continue
            }
            if ch = 0
            {
                ; "If the null character is followed by digits, print as a hex
                ; escape to prevent the result from parsing as an octal".
                var digit false
                if (i + size) < s.length
                {
                    let nx s[(i + size)] as int
                    if (nx >= 0x30) and (nx <= 0x39)
                        set digit: true
                }
                if digit
                    out.append("\\x00")
                else
                    out.append("\\0")
                set i: i + size
                continue
            }
            Checker.write_escaped_char(out, ch)
            set i: i + size
        }
    }

    ; One of a template literal type's texts, through escapeStringWorker with the
    ; BACKTICK delimiter and NeverAsciiEscape — the flag the checker's own printer
    ; carries in its options (createPrinterWithRemoveCommentsNeverAsciiEscape).
    procedure write_template_text(out: ref[StringBuilder], text: ref[String])
    {
        let bytes text.as_slice()
        Checker.escape_string_worker(out, Slice[char](bytes.length, bytes.data as pointer[char]), 0x60, true)
    }

    ; escapedCharsMap, plus encodeUtf16EscapeSequence as its default. `$` and the
    ; backtick are in the reference's table and unreachable here — both are escaped
    ; only when the quote character is a backtick.
    procedure write_escaped_char(out: ref[StringBuilder], ch: int)
    {
        if ch = 0x09
        {
            out.append("\\t")
            return
        }
        if ch = 0x0B
        {
            out.append("\\v")
            return
        }
        if ch = 0x0C
        {
            out.append("\\f")
            return
        }
        if ch = 0x08
        {
            out.append("\\b")
            return
        }
        if ch = 0x0D
        {
            out.append("\\r")
            return
        }
        if ch = 0x0A
        {
            out.append("\\n")
            return
        }
        if ch = 0x5C
        {
            out.append("\\\\")
            return
        }
        if ch = 0x22
        {
            out.append("\\\"")
            return
        }
        ; escapedCharsMap's `'` entry, slice 115. It is reached only when the quote
        ; character is the apostrophe — the trigger above is `ch = quote_char` — but
        ; the MAP is unconditional upstream and is transcribed as such.
        if ch = 0x27
        {
            out.append("\\'")
            return
        }
        ; escapedCharsMap's backtick and `$` entries, slice 186. Both are reached
        ; only with a BACKTICK quote character — the trigger is `ch = quote_char`
        ; for the first and the `${` lookahead for the second — and the MAP is
        ; unconditional upstream, which is how the apostrophe entry above is
        ; written too.
        if ch = 0x60
        {
            out.append("\\\`")
            return
        }
        if ch = 0x24
        {
            out.append("\\$")
            return
        }
        if ch = 0x2028
        {
            out.append("\\u2028")
            return
        }
        if ch = 0x2029
        {
            out.append("\\u2029")
            return
        }
        if ch = 0x0085
        {
            out.append("\\u0085")
            return
        }
        Checker.write_utf16_escape(out, ch)
    }

    ; encodeUtf16EscapeSequence — `\u` and FOUR UPPERCASE hex digits, zero-padded.
    ; Every code point that reaches it is below 0x10000, and since slice 116 that
    ; is enforced by the ONE caller that can hand it more: escape_string_worker's
    ; supplementary-plane arm splits into a surrogate PAIR and calls this twice.
    ; ★★The note that stood here said the arm *is unreachable under this
    ; narrowing and is therefore not written* — it expired the moment a caller
    ; without NeverAsciiEscape existed, and stage 2 is what said so.
    procedure write_utf16_escape(out: ref[StringBuilder], ch: int)
    {
        out.append("\\u")
        var shift 12
        while shift >= 0
        {
            let d (ch >> shift) & 0xF
            if d < 10
                out.append((d + 0x30) as char)
            else
                out.append(((d - 10) + 0x41) as char)
            set shift: shift - 4
        }
    }

    ; stringutil.DecodeJSStringRune. The three-byte SENTINEL for a lone surrogate
    ; is recognised FIRST — `ED A0..BF 80..BF` — and everything else is Go's own
    ; utf8.DecodeRuneInString, which jsnum already ports arm for arm.
    procedure decode_js_string_rune(s: Slice[char], i: int, out_size: ref[int]) returns int
    {
        if (i + 2) < s.length
        {
            let b0 s[i] as int
            if b0 = 0xED
            {
                let b1 s[i + 1] as int
                let b2 s[i + 2] as int
                if (b1 >= 0xA0) and (b1 <= 0xBF)
                {
                    if (b2 >= 0x80) and (b2 <= 0xBF)
                    {
                        set out_size: 3
                        return (0xD000 | ((b1 & 0x3F) << 6)) | (b2 & 0x3F)
                    }
                }
            }
        }
        jsnum_decode_rune(s, s.length as int, i, out_size)
    }

    ; ── the symbol at a location ────────────────────────────────────────────
    ;
    ; ★ getSymbolOfDeclaration is `symbol_of_declaration` here and already ported;
    ; getSymbolOfNode is the same function upstream except that it reads the slot
    ; off DeclarationData rather than off the node, which in this port is the same
    ; read — so the second name is not introduced.

    ; ast.IsLiteralComputedPropertyDeclarationName. It lives here rather than in
    ; `ast` because its literal test is the BINDER's, and `ast` is declared before
    ; `binder` — a module-level name from a later module is a hard unknown
    ; identifier (root CLAUDE.md's module-order rule), the same reason
    ; get_meaning_from_declaration sits on this side.
    function is_literal_computed_property_declaration_name(n: ref[AstNode]?) returns bool
    {
        if n = null
            return false
        if Binder.is_string_or_numeric_literal_like(n) = false
            return false
        let p AstNode.parent_node_of(n)
        if p = null
            return false
        if AstNode.kind_of(p) <> KindComputedPropertyName
            return false
        AstNode.is_declaration(AstNode.parent_node_of(p))
    }

    ; isInRightSideOfImportOrExportAssignment. The loop climbs to the OUTERMOST
    ; qualified name first, so `import x = a.b.c` answers true for every component
    ; rather than for `c` alone.
    function is_in_right_side_of_import_or_export_assignment(node: ref[AstNode]) returns bool
    {
        var cur node
        while true
        {
            let p AstNode.parent_node_of(cur)
            if p = null
                return false
            if AstNode.kind_of(p) <> KindQualifiedName
                break
            set cur: p as ref[AstNode]
        }
        let p AstNode.parent_node_of(cur)
        if p = null
            return false
        let pk AstNode.kind_of(p)
        if pk = KindImportEqualsDeclaration
        {
            if AstNode.module_reference_of(p) = cur
                return true
        }
        if pk = KindExportAssignment
            return AstNode.expression_of(p) = cur
        false
    }

    ; isTypeReferenceIdentifier — the same climb, ending on a TypeReference.
    function is_type_reference_identifier(node: ref[AstNode]) returns bool
    {
        var cur node
        while true
        {
            let p AstNode.parent_node_of(cur)
            if p = null
                return false
            if AstNode.kind_of(p) <> KindQualifiedName
                break
            set cur: p as ref[AstNode]
        }
        let p AstNode.parent_node_of(cur)
        if p = null
            return false
        AstNode.kind_of(p) = KindTypeReference
    }


    ; getTypeOfExpression, without the FLOW TYPE CACHE — and the omission changes no
    ; answer, which is why it is an omission rather than a report: the cache is
    ; keyed on the node and filled with the very type the call just computed, so a
    ; hit and a miss return the same type. What it costs is the re-analysis, and
    ; `flowInvocationCount` exists upstream only to decide whether caching is worth
    ; it. ★ The reference's CheckModeTypeOnly is passed through, and this port's
    ; check_expression_ex already reads it (its diagnostics gate).
    ; getTypeOfExpression.
    ;
    ; ★★★ ITS CACHE IS OBSERVABLE AND SLICE 120 IS WHERE THAT WAS MEASURED. The
    ; body used to be the quick path plus `check_expression_ex`, i.e. a fresh
    ; check on every ask — and this function is asked by the CONTEXTUAL-TYPE
    ; machinery, which walks up to an assignment and checks its LEFT. Every such
    ; ask therefore REPORTS again, so the number of asks is part of the answer:
    ; `(h, h).b = { c: 2 }` reports TS2695 twice upstream and three times without
    ; the cache. ★The reference's condition is the interesting half — it caches
    ; only when the check it just ran actually did control-flow analysis, tested
    ; by whether `flowInvocationCount` MOVED — so a cheap expression is re-checked
    ; (and re-reports) and an expensive one is not.
    ;
    ; ★ A null is NOT cached, and that line is this port's own: a null here means
    ; the check STOPPED, and a cached stop would answer a later ask without
    ; reporting one.
    procedure get_type_of_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let gtoe_mark this.unported_mark()
        let quick this.get_quick_type_of_expression(node)
        if this.unported_mark() <> gtoe_mark
            return null
        if quick <> null
            return quick
        let cached this.flow_type_cache_lookup(node)
        if cached <> null
            return cached
        let start flow_invocation_count
        let t this.check_expression_ex(node, CheckModeTypeOnly)
        if flow_invocation_count <> start
        {
            if t <> null
                this.flow_type_cache_put(node, t as ref[Type])
        }
        t
    }

    ; getRegularTypeOfExpression. The hop to the parent is what makes `a.b` answer
    ; for the whole access rather than for the name: a right-hand component has no
    ; type of its own.
    procedure get_regular_type_of_expression(this, expr: ref[AstNode]) returns ref[Type]?
    {
        var e expr
        if Checker.is_right_side_of_qualified_name_or_property_access(e)
        {
            let p AstNode.parent_node_of(e)
            if p <> null
                set e: p as ref[AstNode]
        }
        let t this.get_type_of_expression(e)
        if t = null
            return null
        this.get_regular_type_of_literal_type(t as ref[Type])
    }

    ; checkMetaPropertyKeyword — errorType upstream too, verbatim, with the
    ; reference's own comment: it is a helper for GetSymbolAtLocation and
    ; GetTypeAtLocation and nothing else asks it.
    function check_meta_property_keyword(this, node: ref[AstNode]) returns ref[Type]?
        error_type

    ; ── getSymbolAtLocation ─────────────────────────────────────────────────
    ;
    ; A prefix chain of five context tests followed by a KIND dispatch, and its
    ; shape is kept because the prefix is what the ported arms need: a DECLARATION
    ; NAME answers `getSymbolOfDeclaration(parent)` before the dispatch is reached,
    ; which is the arm getTypeOfNode's name arms live on.
    ;
    ; ★★★ WHAT REPORTS AND WHY EACH ONE HAS TO. Nine of the dispatch's arms need
    ; machinery this slice does not have — resolveExternalModuleName, the JSX
    ; intrinsic tag symbol, getGlobalImportMetaExpressionType, the `instanceof`
    ; right-hand type, getTypeFromThisTypeNode, getSignatureFromDeclaration's this
    ; parameter — and every one of them is a position where the reference answers a
    ; SYMBOL. Falling through to null would make the caller answer errorType, i.e.
    ; `any`, which is 43 % of the corpus's type answers and therefore the single
    ; easiest way to look right while being wrong (getTypeOfNode's own header). So
    ; each reports with the node's kind as the detail.
    ;
    ; ★ `ignore_errors` is threaded because resolveExternalModuleName takes it; no
    ; ported arm reads it yet, and it stays in the signature rather than being
    ; dropped and re-added.
    procedure get_symbol_at_location(this, node: ref[AstNode], ignore_errors: bool) returns ref[Symbol]?
    {
        let k AstNode.kind_of(node)
        if k = KindSourceFile
        {
            if b.is_external_or_common_js_module()
                return this.get_merged_symbol(AstNode.symbol_of(node))
            return null
        }

        let parent AstNode.parent_node_of(node)
        var grand_parent: ref[AstNode]? null
        if parent <> null
            set grand_parent: AstNode.parent_node_of(parent)

        ; "We cannot answer semantic questions within a with block."
        if (AstNode.flags_of(node) & NodeFlagsInWithStatement) <> 0
            return null

        if AstNode.is_declaration_name_or_import_property_name(node)
        {
            ; A declaration, so the symbol is the PARENT's.
            let parent_symbol this.symbol_of_declaration(parent)
            if AstNode.is_import_or_export_specifier(parent)
            {
                if AstNode.property_name_of(parent) = node
                {
                    if parent_symbol = null
                        return null
                    ; getImmediateAliasedSymbol: the alias's own target rather
                    ; than the end of the chain.
                    return this.get_immediate_aliased_symbol(parent_symbol as ref[Symbol])
                }
            }
            return parent_symbol
        }
        if Checker.is_literal_computed_property_declaration_name(node)
            return this.symbol_of_declaration(grand_parent)

        if k = KindIdentifier
        {
            if Checker.is_in_right_side_of_import_or_export_assignment(node)
                return this.get_symbol_of_name_or_property_access_expression(node)

            var binding_property false
            if AstNode.kind_of(parent) = KindBindingElement
            {
                if AstNode.kind_of(grand_parent) = KindObjectBindingPattern
                {
                    if AstNode.property_name_of(parent) = node
                        set binding_property: true
                }
            }
            if binding_property
            {
                ; `getPropertyOfType(getTypeOfNode(grandParent), node.Text())`. Both
                ; halves are ported, and the reference FALLS THROUGH when the
                ; property is not found — so a miss continues into the dispatch
                ; rather than answering null.
                let um3 this.unported_mark()
                let pattern_type this.get_type_of_node(grand_parent)
                if this.unported_mark() <> um3
                    return null
                if pattern_type <> null
                {
                    let um4 this.unported_mark()
                    let prop this.get_property_of_type(pattern_type as ref[Type], AstNode.identifier_text_of(node))
                    if this.unported_mark() <> um4
                        return null
                    if prop <> null
                        return prop
                }
            }

            if AstNode.is_meta_property(parent)
            {
                if AstNode.name_of(parent) = node
                {
                    ; `target` in `new.target` and `meta` in `import.meta`. The
                    ; first needs checkNewTargetMetaProperty's container walk, the
                    ; second the global ImportMeta expression type; both report.
                    ; Every OTHER meta property is invalid syntax and has no symbol,
                    ; which is an answer and does not report.
                    let kw AstNode.meta_property_keyword_token_of(parent)
                    if kw = KindNewKeyword
                    {
                        this.record_unported("check-new-target-meta-property", k)
                        return null
                    }
                    if kw = KindImportKeyword
                    {
                        this.record_unported("get-global-import-meta-expression-type", k)
                        return null
                    }
                    return null
                }
            }

            if AstNode.kind_of(parent) = KindJSDocParameterTag
            {
                if AstNode.name_of(parent) = node
                {
                    ; The JSDoc parameter's own function, found by POSITION rather
                    ; than through the tree. GetNodeAtPosition is not ported.
                    this.record_unported("jsdoc-parameter-tag-symbol", k)
                    return null
                }
            }
        }

        ; ── the kind dispatch ───────────────────────────────────────────────
        var name_like false
        if k = KindIdentifier
            set name_like: true
        if k = KindPrivateIdentifier
            set name_like: true
        if k = KindPropertyAccessExpression
            set name_like: true
        if k = KindQualifiedName
            set name_like: true
        if name_like
        {
            if Checker.is_this_in_type_query(node) = false
                return this.get_symbol_of_name_or_property_access_expression(node)
            ; fallthrough into the `this` arm
        }

        var this_like false
        if name_like
            set this_like: true
        if k = KindThisKeyword
            set this_like: true
        if this_like
        {
            let container Binder.get_this_container(node, false, false)
            if AstNode.is_function_like(container)
            {
                ; `getSignatureFromDeclaration(container).thisParameter` — the
                ; signature is ported and the walk to it is one hop, but a
                ; container with an explicit `this` parameter is the shape this
                ; slice cannot answer for without the signature's own arm being
                ; reached, so it is asked and the null is the reference's answer.
                let um5 this.unported_mark()
                let sig this.get_signature_from_declaration(container as ref[AstNode])
                if this.unported_mark() <> um5
                    return null
                if sig <> null
                {
                    let s sig as ref[Signature]
                    if s.this_parameter <> null
                        return s.this_parameter
                }
            }
            if AstNode.is_in_expression_context(node)
            {
                let um6 this.unported_mark()
                let t this.check_expression(node)
                if this.unported_mark() <> um6
                    return null
                if t = null
                    return null
                let tt t as ref[Type]
                return tt.symbol
            }
            ; fallthrough into KindThisType
        }

        var this_type false
        if this_like
            set this_type: true
        if k = KindThisType
            set this_type: true
        if this_type
        {
            ; getTypeFromThisTypeNode → getThisType, both ported in slice 137.
            ; ★The caller wants a SYMBOL, and the reference takes it off the type it
            ; gets back; a `this` outside a class or interface answers the error type,
            ; whose symbol is null — which is the same nothing the stop answered.
            let t this.get_type_from_this_type_node(node)
            if t = null
                return null
            return (t as ref[Type]).symbol
        }

        if k = KindSuperKeyword
        {
            let um7 this.unported_mark()
            let t this.check_expression(node)
            if this.unported_mark() <> um7
                return null
            if t = null
                return null
            let tt t as ref[Type]
            return tt.symbol
        }

        if k = KindConstructorKeyword
        {
            ; The constructor keyword of an overload takes us to the class.
            if parent = null
                return null
            if AstNode.kind_of(parent) <> KindConstructor
                return null
            return AstNode.symbol_of(AstNode.parent_node_of(parent))
        }

        var module_name_literal false
        if k = KindStringLiteral
            set module_name_literal: true
        if k = KindNoSubstitutionTemplateLiteral
            set module_name_literal: true
        if module_name_literal
        {
            ; The four external-module-name positions and the bindable
            ; `Object.defineProperty` call's second argument. WHOLE since slice 159.
            ;
            ; ★★★ THE NOTE SAID *"Neither is ported"* AND BOTH WERE — §3.5eo.
            ; `resolve_external_module_name` sits eighteen thousand lines above
            ; with its worker, and `Parser.is_bindable_object_define_property_call`
            ; has been in the parser since the JS assignment chapter. What was
            ; genuinely absent is three ast predicates of one line each, written
            ; inline below because each has exactly this one caller.
            ;
            ; ★★★ AND THE ARM FALLS THROUGH, WHICH IS WHY THE STOP WAS EXPENSIVE
            ; OUT OF PROPORTION TO ITS CHAPTER: the reference's `case
            ; KindStringLiteral` ends in `fallthrough` into the numeric-literal
            ; INDEX-ACCESS arm, and that arm was already written twenty lines
            ; below. So a string literal in `a["x"]` — a shape that has nothing to
            ; do with modules — was answered by a module-name report. A stop placed
            ; at the head of a fallthrough case claims every case under it.
            let mark_mod this.unported_mark()
            var is_module_ref false

            ; (1) `import x = require("./mod")`, and the reference asks the
            ; GRANDparent because the literal sits inside the ExternalModuleReference.
            if Checker.kind_or_unknown(grand_parent) = KindImportEqualsDeclaration
            {
                if AstNode.import_equals_reference_kind(grand_parent) = KindExternalModuleReference
                {
                    if AstNode.expression_of(AstNode.module_reference_of(grand_parent)) = node
                        set is_module_ref: true
                }
            }
            ; (2) the external module name of an import/export declaration.
            if is_module_ref = false
            {
                let pk Checker.kind_or_unknown(parent)
                var decl_like false
                if pk = KindImportDeclaration
                    set decl_like: true
                if pk = KindJSImportDeclaration
                    set decl_like: true
                if pk = KindExportDeclaration
                    set decl_like: true
                if decl_like
                {
                    let name this.get_external_module_name(parent)
                    if this.unported_mark() <> mark_mod
                        return null
                    if name = null
                        set is_module_ref: false
                    else
                    {
                        if (name as ref[AstNode]) = node
                            set is_module_ref: true
                    }
                }
            }
            ; (3) `const x = require("m")` in JavaScript, and (4) `import("m")`.
            if is_module_ref = false
            {
                if grand_parent <> null
                {
                    if b.is_variable_declaration_initialized_to_require(grand_parent as ref[AstNode])
                        set is_module_ref: true
                }
            }
            if is_module_ref = false
            {
                if Parser.is_import_call(parent)
                    set is_module_ref: true
            }
            ; (5) `type A = import("./foo")` — ast.IsLiteralImportTypeNode of the
            ; grandparent AND the literal type being its own argument. The inner
            ; two tests of that predicate hold by construction here (we ARE the
            ; string literal under the LiteralType), and they are written out
            ; anyway: a predicate reproduced in part is the shape §3.5gg says
            ; nothing in this apparatus looks for.
            if is_module_ref = false
            {
                if Checker.kind_or_unknown(parent) = KindLiteralType
                {
                    if Checker.kind_or_unknown(grand_parent) = KindImportType
                    {
                        let arg AstNode.import_type_argument_of(grand_parent)
                        if arg <> null
                        {
                            if (arg as ref[AstNode]) = parent
                            {
                                if AstNode.kind_of(arg as ref[AstNode]) = KindLiteralType
                                {
                                    let inner AstNode.literal_type_inner_of(arg)
                                    if inner <> null
                                    {
                                        if AstNode.kind_of(inner as ref[AstNode]) = KindStringLiteral
                                            set is_module_ref: true
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if is_module_ref
                return this.resolve_external_module_name(node, node, ignore_errors)

            ; The bindable `Object.defineProperty(target, "name", …)` call, whose
            ; SECOND argument is this literal — the declaration is the CALL itself.
            if Checker.kind_or_unknown(parent) = KindCallExpression
            {
                if Parser.is_bindable_object_define_property_call(parent)
                {
                    let args AstNode.call_arguments_of(parent)
                    if AstNode.list_count(args) > 1
                    {
                        if (args as ref[Array[ref[AstNode]?]])[1] = node
                            return this.get_symbol_of_declaration(parent)
                    }
                }
            }
            ; and then the reference FALLS THROUGH to the index-access arm.
        }

        var index_literal false
        if module_name_literal
            set index_literal: true
        if k = KindNumericLiteral
            set index_literal: true
        if index_literal
        {
            ; The index-access arms: `a[0]`'s argument and an IndexedAccessType's
            ; literal. Both compute an OBJECT type and then ask it for the
            ; property; a literal in neither position answers null, which is an
            ; answer and does not report.
            var object_type: ref[Type]? null
            if AstNode.kind_of(parent) = KindElementAccessExpression
            {
                if AstNode.element_access_argument_of(parent) = node
                {
                    let e AstNode.expression_of(parent)
                    if e = null
                        return null
                    let um8 this.unported_mark()
                    set object_type: this.get_type_of_expression(e as ref[AstNode])
                    if this.unported_mark() <> um8
                        return null
                }
            }
            if AstNode.kind_of(parent) = KindLiteralType
            {
                if AstNode.kind_of(grand_parent) = KindIndexedAccessType
                {
                    this.record_unported("get-symbol-at-location-indexed-access", k)
                    return null
                }
            }
            if object_type <> null
            {
                let um9 this.unported_mark()
                let prop this.get_property_of_type(object_type as ref[Type], AstNode.identifier_text_of(node))
                if this.unported_mark() <> um9
                    return null
                return prop
            }
            return null
        }

        var keyword_of_parent false
        if k = KindDefaultKeyword
            set keyword_of_parent: true
        if k = KindFunctionKeyword
            set keyword_of_parent: true
        if k = KindEqualsGreaterThanToken
            set keyword_of_parent: true
        if k = KindClassKeyword
            set keyword_of_parent: true
        if keyword_of_parent
            return this.symbol_of_declaration(parent)

        if k = KindImportType
        {
            ; A literal import type's ARGUMENT decides, recursively; anything else
            ; has no symbol.
            this.record_unported("get-symbol-at-location-import-type", k)
            return null
        }

        if k = KindExportKeyword
        {
            if AstNode.kind_of(parent) = KindExportAssignment
                return AstNode.symbol_of(parent)
            return null
        }

        var meta_keyword false
        if k = KindImportKeyword
        {
            ; `import.defer` — the deferred form has no symbol on its keyword.
            if AstNode.is_meta_property(parent)
            {
                if Checker.meta_property_text_is_defer(parent)
                    return null
            }
            set meta_keyword: true
        }
        if k = KindNewKeyword
            set meta_keyword: true
        if meta_keyword
        {
            if AstNode.is_meta_property(parent)
            {
                let t this.check_meta_property_keyword(parent as ref[AstNode])
                if t = null
                    return null
                let tt t as ref[Type]
                return tt.symbol
            }
            return null
        }

        if k = KindInstanceOfKeyword
        {
            ; The right operand's type, then its `[Symbol.hasInstance]` member.
            ; getSymbolHasInstanceMethodOfObjectType is not ported.
            if AstNode.kind_of(parent) = KindBinaryExpression
            {
                this.record_unported("get-symbol-has-instance-method", k)
                return null
            }
            return null
        }

        if k = KindMetaProperty
        {
            let um10 this.unported_mark()
            let t this.check_expression(node)
            if this.unported_mark() <> um10
                return null
            if t = null
                return null
            let tt t as ref[Type]
            return tt.symbol
        }

        ; ★★ SLICE 119 EXPIRES THIS ROW. `getIntrinsicTagSymbol` exists now, so the
        ; arm is the reference's: a namespaced name that IS a tag name is always
        ; intrinsic (isJsxIntrinsicTagName's second disjunct), and unknownSymbol is
        ; the miss. ★It fires on NO unit of either corpus — the row read zero before
        ; it was wired — so what the wiring buys is that the next reader of this
        ; function does not meet a wall that is no longer there.
        if k = KindJsxNamespacedName
        {
            if AstNode.is_jsx_tag_name(node)
            {
                var jsx_stopped false
                let sym this.get_intrinsic_tag_symbol(AstNode.parent_node_of(node) as ref[AstNode], &jsx_stopped)
                if jsx_stopped
                    return null
                if sym = null
                    return null
                if (sym as ref[Symbol]) = unknown_symbol
                    return null
                return sym
            }
            return null
        }

        null
    }

    ; `import.defer`'s discriminator: MetaProperty.Text() is its NAME's text, and
    ; the deferred form is the one spelled `defer`.
    function meta_property_text_is_defer(n: ref[AstNode]?) returns bool
    {
        let nm AstNode.name_of(n)
        if nm = null
            return false
        Checker.identifier_text_equals(nm, "defer")
    }

    ; ast.IsEntityName — an identifier or a qualified name, i.e. the type-space
    ; spelling. (is_entity_name_EXPRESSION is the value-space one and is ported on
    ; the binder.)
    function is_entity_name(n: ref[AstNode]?) returns bool
    {
        if n = null
            return false
        let k AstNode.kind_of(n)
        if k = KindIdentifier
            return true
        k = KindQualifiedName
    }

    ; isInNameOfExpressionWithTypeArguments — the reference walks past property
    ; accesses to the head and asks whether the parent is an
    ; ExpressionWithTypeArguments.
    function is_in_name_of_expression_with_type_arguments(n: ref[AstNode]) returns bool
    {
        var cur n
        while true
        {
            let p AstNode.parent_node_of(cur)
            if p = null
                return false
            if AstNode.kind_of(p) <> KindPropertyAccessExpression
                break
            set cur: p as ref[AstNode]
        }
        let p AstNode.parent_node_of(cur)
        if p = null
            return false
        AstNode.kind_of(p) = KindExpressionWithTypeArguments
    }

    ; ── getSymbolOfNameOrPropertyAccessExpression ───────────────────────────
    ;
    ; Six prefix cases and then a three-way split on what the name IS: an
    ; expression, a type reference, or a type predicate's parameter. The prefix
    ; cases are the import/export ones and they report; the split is where the
    ; ported machinery is — resolve_entity_name for an identifier, and the two
    ; check_* entry points plus the symbol-node memo for a member chain.
    ; getSymbolOfPartOfRightHandSideOfImportEquals, whole — slice 131, and its own
    ; three cases are the reference's comment made executable:
    ;
    ;     import a = |b|;      // Namespace
    ;     import a = |b.c|;    // Value, type, namespace
    ;     import a = |b.c|.d;  // Namespace
    ;
    ; ★★ THE FIRST STEP CLIMBS OUT OF THE NAME rather than resolving it: the `c` of
    ; `b.c.d` is the RIGHT side of a qualified name, so what has to be resolved is
    ; the qualified name `b.c` and not the identifier. Resolving the identifier
    ; would ask for a NAMESPACE called `c` in the outer scope.
    ;
    ; ★ The reference's `debug.Assert` on the third case is not written as a row:
    ; the meaning set is the only thing the two branches differ in, and both are
    ; resolve_entity_name with dontResolveAlias TRUE — the whole point of the
    ; function, since the alias must not be followed to what it names.
    procedure get_symbol_of_name_or_property_access_expression(this, name: ref[AstNode]) returns ref[Symbol]?
    {
        if AstNode.is_declaration_name(name)
            return this.symbol_of_declaration(AstNode.parent_node_of(name))

        let parent AstNode.parent_node_of(name)
        let pk Checker.kind_or_unknown(parent)

        if pk = KindExportAssignment
        {
            if Binder.is_entity_name_expression(name)
            {
                let meanings ((SymbolFlagsValue | SymbolFlagsType) | SymbolFlagsNamespace) | SymbolFlagsAlias
                let um11 this.unported_mark()
                let success this.resolve_entity_name(name, meanings, true, false, null)
                if this.unported_mark() <> um11
                    return null
                if success <> null
                {
                    if success <> unknown_symbol
                        return success
                }
            }
        }
        else
        {
            if Checker.is_entity_name(name)
            {
                if Checker.is_in_right_side_of_import_or_export_assignment(name)
                    return this.get_symbol_of_part_of_right_hand_side_of_import_equals(name)
            }
        }

        if Checker.is_entity_name(name)
        {
            ; isImportTypeQualifierPart walks up to an ImportType whose QUALIFIER
            ; this is; the arm then resolves the import type and reads the memo.
            if Checker.entity_name_is_import_type_qualifier_part(name)
            {
                this.record_unported("import-type-qualifier-part", AstNode.kind_of(name))
                return null
            }
        }

        ; Climb to the outermost member of the chain.
        var cur name
        while Checker.is_right_side_of_qualified_name_or_property_access(cur)
        {
            let p AstNode.parent_node_of(cur)
            if p = null
                break
            set cur: p as ref[AstNode]
        }

        if Checker.is_in_name_of_expression_with_type_arguments(cur)
        {
            var meaning 0
            let cp AstNode.parent_node_of(cur)
            if Checker.kind_or_unknown(cp) = KindExpressionWithTypeArguments
            {
                ; An ExpressionWithTypeArguments stands in type space, value space
                ; or both; the meaning has to match, and a class `extends` clause
                ; asks for both.
                if AstNode.is_part_of_type_node(cur)
                    set meaning: SymbolFlagsType
                else
                    set meaning: SymbolFlagsValue
                if AstNode.is_expression_with_type_arguments_in_class_extends_clause(cp)
                    set meaning: meaning | SymbolFlagsValue
            }
            else
                set meaning: SymbolFlagsNamespace
            set meaning: meaning | SymbolFlagsAlias
            if Binder.is_entity_name_expression(cur)
            {
                let um12 this.unported_mark()
                let s this.resolve_entity_name(cur, meaning, true, false, null)
                if this.unported_mark() <> um12
                    return null
                if s <> null
                    return s
            }
        }

        if AstNode.is_expression_node(cur)
        {
            if Binder.node_is_missing(cur)
                return null
            ; isJSDoc — IsJSDocNameReferenceContext, and the JSDoc arms below it are
            ; the two the reference reaches only from a JSDoc name reference. This
            ; slice does not evaluate the context and reports where a JSDoc name
            ; reference could stand.
            if Checker.node_is_in_jsdoc_name_reference_context(cur)
            {
                this.record_unported("jsdoc-name-reference-symbol", AstNode.kind_of(cur))
                return null
            }
            let ck AstNode.kind_of(cur)
            if ck = KindIdentifier
            {
                ; ★★ SLICE 119 EXPIRES THIS ROW TOO — and the comment under it was
                ; already describing a guard the code did not have: it said *a
                ; non-intrinsic tag falls through to the ordinary resolution* while
                ; the stop fired for EVERY tag-name identifier. Both halves are the
                ; reference's now.
                if AstNode.is_jsx_tag_name(cur)
                {
                    if Checker.is_jsx_intrinsic_tag_name(cur)
                    {
                        var jsx_stopped false
                        let sym this.get_intrinsic_tag_symbol(AstNode.parent_node_of(cur) as ref[AstNode], &jsx_stopped)
                        if jsx_stopped
                            return null
                        if sym = null
                            return null
                        if (sym as ref[Symbol]) = unknown_symbol
                            return null
                        return sym
                    }
                }
                return this.resolve_entity_name(cur, SymbolFlagsValue, true, true, null)
            }
            if ck = KindPrivateIdentifier
                return this.get_symbol_for_private_identifier_expression(cur)
            var member_chain false
            if ck = KindPropertyAccessExpression
                set member_chain: true
            if ck = KindQualifiedName
                set member_chain: true
            if member_chain
            {
                let links this.symbol_node_link_of(cur)
                if links.resolved_symbol <> null
                    return links.resolved_symbol
                if ck = KindPropertyAccessExpression
                {
                    let um13 this.unported_mark()
                    this.check_property_access_expression(cur, CheckModeNormal, false)
                    if this.unported_mark() <> um13
                        return null
                    if links.resolved_symbol = null
                    {
                        ; getApplicableIndexSymbol off the receiver's type and the
                        ; literal type of the name — the index-signature fallback.
                        ; ★The stop that stood here called it *not ported*; it has
                        ; been in this file since the index-info chapter, six
                        ; hundred lines above its own caller.
                        let pname AstNode.property_access_name_of(cur)
                        if Checker.kind_or_unknown(pname) <> KindPrivateIdentifier
                        {
                            let recv AstNode.expression_of(cur)
                            if recv = null
                                return null
                            let rt this.check_expression_cached(recv as ref[AstNode])
                            if this.unported_mark() <> um13
                                return null
                            if rt = null
                                return null
                            if pname = null
                                return null
                            let kt this.get_literal_type_from_property_name(pname as ref[AstNode])
                            if this.unported_mark() <> um13
                                return null
                            if kt = null
                                return null
                            set links.resolved_symbol: this.get_applicable_index_symbol(rt as ref[Type], kt as ref[Type])
                            if this.unported_mark() <> um13
                                return null
                        }
                    }
                }
                else
                {
                    let um14 this.unported_mark()
                    this.check_qualified_name(cur, CheckModeNormal)
                    if this.unported_mark() <> um14
                        return null
                }
                return links.resolved_symbol
            }
        }
        else
        {
            if Checker.is_entity_name(cur)
            {
                if Checker.is_type_reference_identifier(cur)
                {
                    var meaning SymbolFlagsNamespace
                    if Checker.kind_or_unknown(AstNode.parent_node_of(cur)) = KindTypeReference
                        set meaning: SymbolFlagsType
                    let um15 this.unported_mark()
                    let symbol this.resolve_entity_name(cur, meaning, true, true, null)
                    if this.unported_mark() <> um15
                        return null
                    if symbol <> null
                    {
                        if symbol <> unknown_symbol
                            return symbol
                    }
                    ; getUnresolvedSymbolForEntityName mints a SYNTHETIC symbol for
                    ; a name that resolves to nothing, so a null here would be a
                    ; different answer.
                    this.record_unported("get-unresolved-symbol-for-entity-name", AstNode.kind_of(cur))
                    return null
                }
            }
        }

        if Checker.kind_or_unknown(AstNode.parent_node_of(cur)) = KindTypePredicate
            return this.resolve_entity_name(cur, SymbolFlagsFunctionScopedVariable, true, false, null)

        null
    }

    ; isImportTypeQualifierPart, as the PREDICATE its one reader needs: the walk up
    ; through qualified names ending on an ImportType whose Qualifier the chain is.
    ; (The reference returns the import node; the arm that would use it is not
    ; ported, so the question is only whether it exists.)
    function entity_name_is_import_type_qualifier_part(n: ref[AstNode]) returns bool
    {
        var cur n
        var p AstNode.parent_node_of(cur)
        while p <> null
        {
            if AstNode.kind_of(p) = KindQualifiedName
            {
                set cur: p as ref[AstNode]
                set p: AstNode.parent_node_of(cur)
            }
            else
            {
                if AstNode.kind_of(p) = KindImportType
                    return AstNode.import_type_qualifier_of(p) = cur
                return false
            }
        }
        false
    }

    ; ast.IsJSDocNameReferenceContext, as the one question its reader asks: is this
    ; node inside a JSDoc name reference or a JSDoc link? The reference walks the
    ; ancestor chain; the two kinds it looks for are the ones ported here.
    function node_is_in_jsdoc_name_reference_context(n: ref[AstNode]) returns bool
    {
        var p: ref[AstNode]? AstNode.parent_node_of(n)
        while p <> null
        {
            let k AstNode.kind_of(p)
            if k = KindJSDocNameReference
                return true
            if AstNode.is_jsdoc_link_like(p)
                return true
            if k = KindSourceFile
                return false
            set p: AstNode.parent_node_of(p)
        }
        false
    }

    ; ast.IsTypeDeclarationName — an IDENTIFIER that is the name of a type
    ; declaration. It is here rather than in `ast` because IsTypeDeclaration is (it
    ; reads the import/export type-only arms), and because GetNameOfDeclaration is
    ; on the binder.
    function is_type_declaration_name(this, name: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(name) <> KindIdentifier
            return false
        let p AstNode.parent_node_of(name)
        if Checker.is_type_declaration(p) = false
            return false
        b.get_name_of_declaration(p) = name
    }

    ; ── GetTypeAtLocation ───────────────────────────────────────────────────
    ;
    ; getTypeOfNode, and it is a CHAIN and not a kind switch because several of its
    ; predicates read the node's PARENT rather than its kind: `let x = 1` and
    ; `{ 1: v }` hold the same node in two spaces, and only the context tells them
    ; apart. Fifteen predicates in a fixed order, ending in errorType.
    ;
    ; ★★★ SLICE 109 REPLACED THE KIND INVENTORY WITH THE CHAIN, AND THAT IS THE
    ; WHOLE SLICE. Through slice 108 the ten predicates the port could not evaluate
    ; stood behind `kind_has_ported_type_arm`, a hand-written list of the kinds for
    ; which every one of them is provably false — three kinds, all of them tokens
    ; and empty statements. The list was the honest thing to do while the predicates
    ; were missing, because a chain that SKIPS a predicate it cannot evaluate falls
    ; through to errorType and answers `any`, which is 43 % of the corpus's type
    ; answers and therefore the single easiest way for this port to look right. The
    ; predicates are ported now (`ast.is_expression_node`,
    ; `is_declaration_name_or_import_property_name`, `is_type_declaration_name`,
    ; `try_get_class_implementing_or_extending`, `is_binding_pattern`,
    ; `is_in_right_side_of_import_or_export_assignment`, `is_meta_property`,
    ; `is_import_attributes`), so each arm is ASKED and the inventory is gone.
    ;
    ; ★ Where an arm's ANSWER is not ported the arm reports with the node's kind as
    ; the detail — which is a different and much smaller set than the kinds the
    ; inventory used to hold back, because most arms answer through machinery this
    ; port already has (get_type_from_type_node, get_declared_type_of_symbol,
    ; get_type_of_symbol, get_type_for_variable_like_declaration, check_expression).
    procedure get_type_of_node(this, node: ref[AstNode]?) returns ref[Type]?
    {
        if node = null
            return null
        let n node as ref[AstNode]
        let k AstNode.kind_of(n)

        ; `ast.IsSourceFile(node) && !ast.IsExternalOrCommonJSModule(...)`. The walk
        ; never asks about the source file itself (both dumpers skip it), so this
        ; arm is unreachable from the yardstick and is ported because it is one line.
        if k = KindSourceFile
        {
            if b.is_external_or_common_js_module() = false
                return error_type
        }

        ; "We cannot answer semantic questions within a with block, do not proceed
        ; any further" — the reference's own comment. The flag is the parser's, so
        ; this arm is complete.
        if (AstNode.flags_of(n) & NodeFlagsInWithStatement) <> 0
            return error_type

        ; TryGetClassImplementingOrExtendingExpressionWithTypeArguments, whose PAIR
        ; this slice split back apart: the class is needed for its declared type and
        ; the flag for the `classType != nil && !isImplements` arm below.
        var is_implements false
        let class_decl AstNode.try_get_class_implementing_or_extending(n, &is_implements)
        var class_type: ref[Type]? null
        if class_decl <> null
        {
            let sym this.symbol_of_declaration(class_decl)
            if sym = null
                return error_type
            let um16 this.unported_mark()
            set class_type: this.get_declared_type_of_class_or_interface(sym as ref[Symbol])
            if this.unported_mark() <> um16
                return null
        }

        if AstNode.is_part_of_type_node(n)
        {
            let um17 this.unported_mark()
            let from_type_node this.get_type_from_type_node(n)
            if this.unported_mark() <> um17
                return null
            if from_type_node = null
                return null
            if class_type <> null
            {
                ; getTypeWithThisArgument(typeFromTypeNode, classType.thisType,
                ; false). ★★★The note that stood here was a CLAIM and not a
                ; chapter — *the interface type's own `thisType` slot is not
                ; reachable from a Type here yet* — and both halves of it had been
                ; in the file for slices: `this_type_of` reads the Interface arm's
                ; own slot and `get_type_with_this_argument` is the reference's
                ; function whole. §3.5eo, and this is the row it named at +353.
                return this.get_type_with_this_argument(from_type_node as ref[Type], Checker.this_type_of(class_type as ref[Type]), false)
            }
            return from_type_node
        }

        if AstNode.is_expression_node(n)
            return this.get_regular_type_of_expression(n)

        if class_type <> null
        {
            if is_implements = false
            {
                ; "A SyntaxKind.ExpressionWithTypeArguments is considered a type
                ; node, except when it occurs in the extends clause of a class."
                ; core.FirstOrNil(getBaseTypes(classType)) and then the
                ; this-argument substitution; errorType where there is no base.
                ;
                ; ★★The MARK is the counter and not the flag, for the reason
                ; get_base_types' own header gives: the arms above this one report,
                ; so `is_unported()` is usually already true by the time the walk
                ; reaches a class's extends clause and a pair built out of it can
                ; never fire.
                let ct class_type as ref[Type]
                let mark this.unported_mark()
                let bases this.get_base_types(ct)
                if this.unported_mark() <> mark
                    return null
                if bases = null
                    return error_type
                let bl bases as ref[Array[ref[Type]?]]
                if bl.get_length() = 0
                    return error_type
                let first bl[0]
                if first = null
                    return error_type
                return this.get_type_with_this_argument(first as ref[Type], Checker.this_type_of(ct), false)
            }
        }

        if Checker.is_type_declaration(n)
        {
            ; getSymbolOfDeclaration rather than getSymbolAtLocation, because it IS
            ; a declaration — the reference's own comment.
            let symbol this.symbol_of_declaration(n)
            if symbol = null
                return error_type
            return this.get_declared_type_of_symbol(symbol as ref[Symbol])
        }

        if this.is_type_declaration_name(n)
        {
            let um18 this.unported_mark()
            let symbol this.get_symbol_at_location(n, false)
            if this.unported_mark() <> um18
                return null
            if symbol <> null
                return this.get_declared_type_of_symbol(symbol as ref[Symbol])
            return error_type
        }

        if k = KindBindingElement
        {
            let um19 this.unported_mark()
            let t this.get_type_for_variable_like_declaration(n, true, CheckModeNormal)
            if this.unported_mark() <> um19
                return null
            if t <> null
                return t
            return error_type
        }

        if AstNode.is_declaration(n)
        {
            let symbol this.symbol_of_declaration(n)
            if symbol <> null
                return this.get_type_of_symbol(symbol as ref[Symbol])
            return error_type
        }

        if AstNode.is_declaration_name_or_import_property_name(n)
        {
            let um20 this.unported_mark()
            let symbol this.get_symbol_at_location(n, false)
            if this.unported_mark() <> um20
                return null
            if symbol <> null
                return this.get_type_of_symbol(symbol as ref[Symbol])
            return error_type
        }

        if AstNode.is_binding_pattern(n)
        {
            let p AstNode.parent_node_of(n)
            if p = null
                return error_type
            let um21 this.unported_mark()
            let t this.get_type_for_variable_like_declaration(p as ref[AstNode], true, CheckModeNormal)
            if this.unported_mark() <> um21
                return null
            if t <> null
                return t
            return error_type
        }

        if Checker.is_in_right_side_of_import_or_export_assignment(n)
        {
            let um22 this.unported_mark()
            let symbol this.get_symbol_at_location(n, false)
            if this.unported_mark() <> um22
                return null
            if symbol <> null
            {
                let s symbol as ref[Symbol]
                let um23 this.unported_mark()
                let declared this.get_declared_type_of_symbol(s)
                if this.unported_mark() <> um23
                    return null
                if declared <> null
                {
                    if this.is_error_type(declared as ref[Type]) = false
                        return declared
                }
                return this.get_type_of_symbol(s)
            }
            ; ★ The reference FALLS THROUGH on a null symbol here — it does not
            ; return — so the meta-property and import-attributes arms below still
            ; get their turn.
        }

        let parent AstNode.parent_node_of(n)
        if AstNode.is_meta_property(parent)
        {
            if AstNode.meta_property_keyword_token_of(parent) = k
                return this.check_meta_property_keyword(parent as ref[AstNode])
        }

        if AstNode.is_import_attributes(n)
        {
            ; getGlobalImportAttributesType. ★The note that stood here read *a global
            ; interface this port does not load (§3.11's lib)* and it had expired
            ; twice over: slice 113 loaded `lib.es5.d.ts`, which DECLARES
            ; `interface ImportAttributes`, and slice 128 built the arity-general
            ; getter. ★The `Checked` twin the attributes CHECK uses differs only in
            ; the reference's reportErrors flag, which this port's getter does not
            ; have — so both callers ask the same question here.
            return this.get_global_type_of_arity("ImportAttributes", 0)
        }

        ; The chain's own end: "if we get here, the node is not something we have a
        ; type for". Every plain STATEMENT reaches it, which is what the inventory
        ; used to admit three of by hand.
        error_type
    }

    ; ── ast.GetMeaningFromDeclaration ───────────────────────────────────────
    ;
    ; ★★ IT LIVES HERE AND UPSTREAM HAS IT IN internal/ast, and the reason is this
    ; port's own layout rather than a preference: its ModuleDeclaration arm asks
    ; GetModuleInstanceState, which the reference keeps in `ast` and slice 31 put on
    ; the BINDER (it needs the visited set and the ancestor chain that the binder
    ; carries). The `ast` module is declared before `binder`, so a function in
    ; ast.scaly could not reach it — a module-level name from a module declared
    ; LATER is a hard `unknown identifier` and, in call-argument position, a
    ; silently dropped call. So the one arm that needs the binder decides where the
    ; whole function goes, and it goes with its dependency.
    ;
    ; Its reader is the type walk's exclusion for an IDENTIFIER: a name that
    ; declares nothing into the VALUE space is not asked for its type, with the
    ; type-alias name as the one exception.
    procedure get_meaning_from_declaration(this, node: ref[AstNode]?) returns int
    {
        if node = null
            return SemanticMeaningAll
        let k AstNode.kind_of(node)

        if Checker.kind_declares_a_value_only(k)
            return SemanticMeaningValue
        if Checker.kind_declares_a_type_only(k)
            return SemanticMeaningType
        if k = KindEnumMember
            return SemanticMeaningValue | SemanticMeaningType
        if k = KindClassDeclaration
            return SemanticMeaningValue | SemanticMeaningType

        if k = KindModuleDeclaration
        {
            if Binder.is_ambient_module(node)
                return SemanticMeaningNamespace | SemanticMeaningValue
            if b.get_module_instance_state(node) = ModuleInstanceStateInstantiated
                return SemanticMeaningNamespace | SemanticMeaningValue
            return SemanticMeaningNamespace
        }

        ; The reference's list here returns SemanticMeaningAll, which is also the
        ; function's default — the kinds are enumerated upstream to say that the
        ; answer is deliberate, and the enumeration changes no answer, so it is a
        ; comment here rather than eight more comparisons: EnumDeclaration,
        ; NamedImports, ImportSpecifier, ImportEqualsDeclaration, ImportDeclaration,
        ; JSImportDeclaration, ExportAssignment, ExportDeclaration. ★ And the
        ; SourceFile arm — "an external module can be a Value" — answers
        ; Namespace|Value, which IS different from the default and is therefore
        ; below rather than in this comment.
        if k = KindSourceFile
            return SemanticMeaningNamespace | SemanticMeaningValue

        SemanticMeaningAll
    }

    ; The two long `case` lists of GetMeaningFromDeclaration, as functions for the
    ; reason ast.scaly's is_kind_with_type_slot_for_part_of_type_node is one.
    function kind_declares_a_value_only(k: int) returns bool
    {
        if k = KindVariableDeclaration
            return true
        if k = KindParameter
            return true
        if k = KindBindingElement
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindPropertySignature
            return true
        if k = KindPropertyAssignment
            return true
        if k = KindShorthandPropertyAssignment
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindConstructor
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindFunctionDeclaration
            return true
        if k = KindFunctionExpression
            return true
        if k = KindArrowFunction
            return true
        if k = KindCatchClause
            return true
        if k = KindJsxAttribute
            return true
        false
    }

    function kind_declares_a_type_only(k: int) returns bool
    {
        if k = KindTypeParameter
            return true
        if k = KindInterfaceDeclaration
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        if k = KindTypeLiteral
            return true
        false
    }

    ; checker.IsTypeAny, which the type walk's class-extends workaround asks: the
    ; reference re-asks the node itself when the parent's answer is `any`.
    function is_type_any(t: ref[Type]?) returns bool
    {
        if t = null
            return false
        (t.flags & TypeFlagsAny) <> 0
    }

    ; ── GetDiagnostics ──────────────────────────────────────────────────────
    ;
    ; getDiagnostics: checkUnused is false under this harness's options (see the
    ; header), so the whole suggestion/unused branch is not entered, and what is
    ; left is checkSourceFile followed by the collection's sorted view.
    procedure get_diagnostics(this)
    {
        this.check_source_file()
        ; GetDiagnosticsForFile sorts the collection before answering — see
        ; DiagnosticList.sort_by_position for the comparison and for why this list
        ; sorts while the parser's does not.
        diagnostics.sort_by_position()
    }

    ; checkSourceFile. The `links.typeChecked` once-guard is dropped for the
    ; binder's reason: a Checker here is one object, used once, on the caller's
    ; page.
    procedure check_source_file(this)
    {
        ; Grammar checking. The result is discarded upstream too — the bool is
        ; there for the `&&` inside checkGrammarSourceFile and nothing reads it.
        this.check_grammar_source_file()

        ; `c.renamedBindingElementsInTypes = nil` — the list
        ; checkVariableLikeDeclaration appends to and
        ; checkUnusedRenamedBindingElements reads. Slice 56 ported the WRITER, and
        ; there is still nothing here to clear: this Checker is built per file and
        ; the list is empty when it arrives, where the reference reuses one Checker
        ; across the program and has to. ★The line is kept as a comment rather than
        ; dropped because the day this port checks a second file with one Checker,
        ; a list that survives the file boundary reports on nodes of the previous
        ; one — and the clear is the whole fix.

        this.check_source_elements(AstNode.statements_of(file))

        ; ★★★ SLICE 100 LIFTS THE EARLY RETURN THAT STOOD HERE, AND SLICE 60 NAMED
        ; THE DAY: *lifting that early return for real is a slice of its own, and
        ; the reference has no such exit.* It had to go with this chapter and not
        ; with another, because this chapter's whole product is BEHIND THE DRAIN —
        ; checkFunctionExpressionOrObjectLiteralMethod defers, and the body of
        ; every function expression and arrow function in the corpus is walked by
        ; check_deferred_nodes or by nothing. With the return in place the drain
        ; ran on 15 units of 1 517, because a unit that has stopped anywhere at all
        ; never reached it.
        ;
        ; ★★★ WHAT MAKES IT SAFE IS NOT AN ARGUMENT, IT IS THE RELATION: diagcheck
        ; compares our C section as a SUBSEQUENCE of the reference's, the drain
        ; runs at this line upstream too, and record_unported has never aborted a
        ; walk — so every diagnostic the drain adds is one the reference also
        ; emits, at a position the reference also emits it. What the lift CANNOT
        ; be argued into is a claim that the state is sound after a stop, and that
        ; is what the battery measures rather than this comment.
        this.check_deferred_nodes()

        ; ★★★ SLICE 110 LIFTS THE SECOND OF THE TWO EARLY RETURNS SLICE 100 NAMED,
        ; AND FOR THE SAME REASON IT LIFTED THE FIRST — the relation, not an
        ; argument: diagcheck compares our C section as a SUBSEQUENCE of the
        ; reference's, checkExternalModuleExports runs at this line upstream too, and
        ; record_unported has never aborted a walk. So every diagnostic the branch
        ; below adds is one the reference also emits, at a position it also emits it.
        ; ★★It is what this chapter's own product was standing behind: measured on
        ; `alias_import_conflicts`, TWO TS2323 were missing because the unit had
        ; stopped at `are-declaration-flags-identical` two statements earlier, and on
        ; `alias_module_not_found` two duplicate TS2307 — the second resolution of an
        ; `export * from` specifier, which happens inside getExportsOfModuleWorker.
        ; ★★★What it cannot be argued into is a claim that the state is SOUND after a
        ; stop, and diagcheck over the whole stage-2 corpus is what says so rather
        ; than this comment.
        if b.is_external_or_common_js_module()
        {
            ; checkExternalModuleExports plus registerForUnusedIdentifiersCheck.
            ; The second is observable only through checkUnusedIdentifiers, which
            ; checkUnused gates off here, so what this arm owes is the first —
            ; ANSWERED since slice 110. ★★★ It does NOT return: the reference falls
            ; through to checkUnusedRenamedBindingElements and the deferred
            ; diagnostics, and the stop that used to stand here did return, so 103
            ; units of the corpus never reached either.
            let um24 this.unported_mark()
            let f file
            if f <> null
            {
                this.check_external_module_exports(f as ref[AstNode])
                this.register_for_unused_identifiers_check(f as ref[AstNode])
            }
            if this.unported_mark() <> um24
                return
        }

        if is_declaration_file = false
            this.check_unused_renamed_binding_elements()

        this.produce_deferred_diagnostics()

        ; `checkUnused := NoUnusedLocals.IsTrue() || NoUnusedParameters.IsTrue()`
        ; (the suggestion collection's third disjunct prints nothing)
        if Checker.check_unused_enabled()
        {
            if is_declaration_file = false
                this.check_unused_identifiers()
        }
    }

    procedure check_source_elements(this, nodes: ref[Array[ref[AstNode]?]]?)
    {
        if nodes = null
            return
        var i 0
        while i < AstNode.list_count(nodes)
        {
            ; ★★★ SLICE 47 STOPPED HERE ON A REPORT AND SLICE 49 DOES NOT, AND THE
            ; REASON IT GAVE IS WHY. It read *the reference breaks on cancellation;
            ; a report is this port's equivalent stopping condition and there is
            ; nothing to gain from checking the rest of a file whose dump is
            ; already suppressed* — true on the day it was written, and slice 48
            ; built the instrument that makes it false: tests/diagcheck.sh compares
            ; the C section of every unit, suppressed dump or not, so the
            ; statements after the first report are exactly where a wrong span or
            ; an invented diagnostic would hide. It is also the more faithful
            ; reading: the reference checks every element, and cancellation is not
            ; a thing this port has.
            ;
            ; ★ The relation diagcheck asserts survives the change and gets
            ; stronger. With the stop, our lines were a PREFIX of the reference's;
            ; without it they are a SUBSET, and both sides are sorted, so a
            ; subsequence test holds either way — over more of the file.
            ; §3.5cp's lesson, one dimension on: a deferral's REASON expires, and
            ; nothing re-reads it when it does.
            this.check_source_element(AstNode.child_in_list(nodes, i))
            set i: i + 1
        }
    }

    ; checkSourceElement's whole body is the save/restore of two registers around
    ; checkSourceElementWorker plus `c.instantiationCount = 0`.
    ;
    ; ★★★ SLICE 154 GAVE IT THE FIRST REGISTER. The note here read *currentNode is
    ; read by the instantiation-depth machinery and withinUnreachableCode by the
    ; reachability check — neither of which exists here … so the saves have nothing
    ; to save yet*, and the instantiation-depth machinery landed in slice 86, seven
    ; slices before the sentence was last true. It cost two limiters their error
    ; and made them stops instead — see instantiate_type and get_conditional_type.
    ; ★★★ SLICE 184 GAVE IT THE SECOND, AND THE SENTENCE THAT STOOD HERE — *the
    ; reachability check produces nothing this yardstick compares* — is why it took
    ; twenty-nine slices: it is TRUE of the diagnostic and FALSE of the chapter.
    ; See within_unreachable_code's own note for the measurement and the route.
    procedure check_source_element(this, node: ref[AstNode]?)
    {
        if node = null
            return
        let save_current_node current_node
        let save_within_unreachable within_unreachable_code
        set current_node: node
        set instantiation_count: 0
        this.check_source_element_worker(node as ref[AstNode])
        set current_node: save_current_node
        set within_unreachable_code: save_within_unreachable
    }

    ; ── slice 184: the UNREACHABLE-CODE chapter ─────────────────────────────
    ;
    ; ast.IsInstantiatedModule. ★The `preserveConstEnums` argument is not taken:
    ; its one caller here passes `c.compilerOptions.ShouldPreserveConstEnums()`,
    ; which this port carries as the `preserve_const_enums` field, and a parameter
    ; that can only ever be that field is a parameter whose call sites cannot
    ; disagree.
    procedure is_instantiated_module(this, node: ref[AstNode]) returns bool
    {
        let state b.get_module_instance_state(node)
        if state = ModuleInstanceStateInstantiated
            return true
        if this.should_preserve_const_enums() = false
            return false
        state = ModuleInstanceStateConstEnumOnly
    }

    ; isSourceElementUnreachable, whole. Its precondition is
    ; is_potentially_executable_node, which the ONE caller below asks first.
    ;
    ; ★★★ THE TWO BRANCHES ANSWER THE SAME QUESTION FROM OPPOSITE SIDES AND ONLY
    ; ONE OF THEM IS CHEAP. NodeFlagsUnreachable is the BINDER's answer, written
    ; from currentFlow while binding, and it is a decision already made; the
    ; `else` asks the CHECKER, which walks the flow graph from this node's own flow
    ; node — and that walk is what makes this chapter visible to the yardstick at
    ; all (see within_unreachable_code). A port that answered the flag alone would
    ; be right about every statement after a `return` and silent about every one
    ; the binder could not decide.
    ;
    ; ★ The const-enum and module arms are not a refinement of *unreachable*: a
    ; non-instantiated module and a const enum EMIT NOTHING, so being unreachable
    ; is not a fact about them worth reporting. Both read the same option.
    procedure is_source_element_unreachable(this, node: ref[AstNode]) returns bool
    {
        if (AstNode.flags_of(node) & NodeFlagsUnreachable) <> 0
        {
            let k AstNode.kind_of(node)
            if k = KindEnumDeclaration
            {
                if this.is_enum_const(node) = false
                    return true
                return this.should_preserve_const_enums()
            }
            if k = KindModuleDeclaration
                return this.is_instantiated_module(node)
            return true
        }
        let flow AstNode.flow_node_of(node)
        if flow = null
            return false
        this.is_reachable_flow_node(flow as ref[FlowNode]) = false
    }

    ; `n.CanHaveStatements()` — the five kinds that own a statement LIST.
    function can_have_statements(k: int) returns bool
    {
        if k = KindSourceFile
            return true
        if k = KindBlock
            return true
        if k = KindModuleBlock
            return true
        if k = KindCaseClause
            return true
        k = KindDefaultClause
    }

    ; checkSourceElementUnreachable, whole — with ONE deliberate divergence, and
    ; the divergence is the diagnostic.
    ;
    ; ★★★ THE REPORT IS NOT WRITTEN, AND THE PRICE IS MEASURED RATHER THAN
    ; ARGUED. Upstream ends with
    ;
    ;     c.addErrorOrSuggestion(c.compilerOptions.AllowUnreachableCode == core.TSFalse, diagnostic)
    ;
    ; so TS7027 is an ERROR only when the option is explicitly false and a
    ; SUGGESTION otherwise — and suggestions are not in GetDiagnostics, which is
    ; the only list either yardstick reads. This oracle fixes its options to
    ; `{SkipDefaultLibCheck: TSTrue, NoErrorTruncation: TSTrue}`, leaving
    ; AllowUnreachableCode at TSUnknown, so the error branch cannot be taken.
    ; Measured over the whole stage-2 corpus: **0 of 64 148 reference C lines carry
    ; code 7027.** ★The expiry is one line long and belongs to the INSTRUMENT, not
    ; to this file: the day tests/oracle/types.go sets AllowUnreachableCode to
    ; TSFalse, or honours a case's `// @allowUnreachableCode` option, this
    ; function owes the diagnostic and its span (upstream takes
    ; GetTokenPosOfNode(startNode) through endNode.End(), which is why the forward
    ; scan below computes an END it does not otherwise need).
    ;
    ; ★★★ EVERYTHING ELSE IS PORTED BECAUSE IT DECIDES HOW OFTEN THE REACHABILITY
    ; WALK RUNS, and the walk reports. The `reported_unreachable` test sits in
    ; FRONT of is_source_element_unreachable, so it SUPPRESSES walks; the forward
    ; scan ADDS them, on the statements after this one, and marks each so the
    ; enclosing loop's later arrivals take the suppressing branch. Leaving either
    ; half out changes the diagnostic COUNT of a unit in one direction each.
    ;
    ; ★ Upstream's BACKWARD scan is commented out in the reference (region
    ; diagnostics are not supported there yet) and is therefore not written here
    ; either; `first` stays the node's own offset, as it does upstream.
    procedure check_source_element_unreachable(this, node: ref[AstNode]) returns bool
    {
        if Binder.is_potentially_executable_node(node) = false
            return false
        let links this.node_link_of(node)
        if links.reported_unreachable
            return true
        let mark this.unported_mark()
        if this.is_source_element_unreachable(node) = false
            return false
        if this.unported_mark() <> mark
            return false
        set links.reported_unreachable: true
        let parent AstNode.parent_node_of(node)
        if parent = null
        {
            this.report_unreachable_code(node, node)
            return true
        }
        let p parent as ref[AstNode]
        if Checker.can_have_statements(AstNode.kind_of(p)) = false
        {
            this.report_unreachable_code(node, node)
            return true
        }
        let statements AstNode.statements_of(p)
        let count AstNode.list_count(statements)
        var offset 0 - 1
        var i 0
        while i < count
        {
            if AstNode.child_in_list(statements, i) = node
            {
                set offset: i
                break
            }
            set i: i + 1
        }
        if offset < 0
        {
            this.report_unreachable_code(node, node)
            return true
        }
        var end_node: ref[AstNode] node
        var j offset + 1
        while j < count
        {
            let next_row AstNode.child_in_list(statements, j)
            if next_row = null
                break
            let next next_row as ref[AstNode]
            if Binder.is_potentially_executable_node(next) = false
                break
            if this.is_source_element_unreachable(next) = false
                break
            if this.unported_mark() <> mark
                break
            let next_links this.node_link_of(next)
            set next_links.reported_unreachable: true
            set end_node: next
            set j: j + 1
        }
        this.report_unreachable_code(node, end_node)
        true
    }

    ; the diagnostic: GetTokenPosOfNode(startNode) through endNode.End(), an error only
    ; under `allowUnreachableCode: false` (addErrorOrSuggestion)
    procedure report_unreachable_code(this, start_node: ref[AstNode], end_node: ref[AstNode])
    {
        if checker_allow_unreachable_code <> TristateFalse
            return
        let start this.binder_of_node(start_node).skip_trivia_at(AstNode.pos_of(start_node))
        this.add_diagnostic_direct(start, AstNode.end_of(end_node), DiagUnreachable_code_detected)
    }

    ; ── slice 78: the JSDoc pass in front of the switch ─────────────────────
    ;
    ; ★★★ THE STEP THAT STOOD AS A BLANKET STOP IS THREE FUNCTIONS, AND WHAT DECIDES
    ; ITS SIZE IS THAT THE REPORT IS ONE FUNCTION DEEP RATHER THAN ONE STEP DEEP.
    ; checkJSDocComment's whole body is a switch over THREE kinds — JSDocLink,
    ; JSDocLinkCode, JSDocLinkPlain — calling resolveJSDocMemberName; every other
    ; comment part, and a JSDoc with no parts at all, is a no-op in the reference.
    ; So a part that is not a link needs no code here and is not a hole: doing
    ; nothing IS the answer, the same statement kind_has_no_check_arm makes one
    ; screen down. **The old gate read NodeFlagsHasJSDoc, which is set for every
    ; documented node**, so it stopped a population two orders larger than the
    ; reference's own step ever reports on: 110 units of stage 1, of which 3 hold a
    ; link.
    ;
    ; ★★★ AND THE OTHER CANDIDATE FOR *what decides the size* WAS MEASURED AND
    ; REFUTED, which is worth more than the sentence it replaces. This note first
    ; read *the one that decides its size is EagerJSDoc* — the eager accessor reads
    ; the cache and never parses, so a TS file's plain doc comments are invisible to
    ; it — and control g02 swaps the LAZY accessor back in with nothing moving at
    ; all. The two provably coincide: a comment holding a link is always in the
    ; cache, because a link is what makes with_jsdoc parse eagerly. See
    ; `Parser.eager_jsdoc`, which is still what this asks and says why.
    ;
    ; ★★ WHY THE LINK ARM STILL STOPS THE WHOLE NODE, rather than recording and
    ; walking on. resolveJSDocMemberName is `resolveEntityName(…, ignoreErrors:
    ; true, …)` and then, for a qualified name, getTypeOfSymbol / getPropertyOfType
    ; / getDeclaredTypeOfSymbol — none of it ported, and the first of them is the
    ; entity-name chapter this port reports at 23 units elsewhere. Its documented
    ; PURPOSE is to record the reference for checkUnusedIdentifiers, which is inert
    ; under this harness (§3.5be's argument, twice over: both options unset and
    ; every report a suggestion), so the honest thing to say is that the machinery
    ; is missing rather than that the effect is nil — and abandoning is what the
    ; four link-bearing units already did. ★Control g05 walks on instead and prices
    ; the difference.
    ;
    ; ★ The DETAIL stays the node's kind rather than the link part's, so the
    ; `check-jsdoc-comments <kind>` rows of the work list keep meaning what they
    ; meant before the pass existed and the two histograms stay comparable across
    ; the slice.
    procedure check_jsdoc_of_node(this, node: ref[AstNode], k: int) returns bool
    {
        let docs Parser.eager_jsdoc(p, node)
        if docs = null
            return false
        let list docs as ref[Array[ref[AstNode]?]]
        let count list.get_length() as int
        var i 0
        while i < count
        {
            let jsdoc list[i]
            if this.check_jsdoc_comments(jsdoc, k)
                return true
            let tags AstNode.jsdoc_tags_of(jsdoc)
            if tags <> null
            {
                let tl tags as ref[Array[ref[AstNode]?]]
                let tcount tl.get_length() as int
                var j 0
                while j < tcount
                {
                    if this.check_jsdoc_comments(tl[j], k)
                        return true
                    set j: j + 1
                }
            }
            set i: i + 1
        }
        false
    }

    ; checkJSDocComments, whole — `for _, comment := range node.Comments()`.
    ; Answers true when a part stopped, which is this port's shape for a step the
    ; reference runs to the end.
    procedure check_jsdoc_comments(this, node: ref[AstNode]?, k: int) returns bool
    {
        let parts AstNode.jsdoc_comment_list_of(node)
        if parts = null
            return false
        let list parts as ref[Array[ref[AstNode]?]]
        let count list.get_length() as int
        var i 0
        while i < count
        {
            if this.check_jsdoc_comment(list[i], k)
                return true
            set i: i + 1
        }
        false
    }

    ; checkJSDocComment, whole. The reference's own comment at the line states the
    ; scope: *this performs minimal checking of JSDoc nodes to ensure that @link
    ; references to entities are recorded for purposes of checking unused
    ; identifiers.*
    ; ★★★ THE LINK ARM IS CODE SINCE SLICE 143 AND THE NOTE ABOVE IT HAD EXPIRED.
    ; It read *resolveJSDocMemberName is `resolveEntityName(…)` … none of it
    ; ported* — `resolve_entity_name` has been in this file since the entity-name
    ; chapter, and with it the whole of the reference's step. The ANSWER is still
    ; thrown away, because its documented purpose is to record a reference for
    ; checkUnusedIdentifiers, which is inert under this harness; what the call buys
    ; is the WALK, and the walk is the reference's own.
    procedure check_jsdoc_comment(this, node: ref[AstNode]?, k: int) returns bool
    {
        if AstNode.is_jsdoc_link_like(node) = false
            return false
        let mark this.unported_mark()
        let ignored this.resolve_jsdoc_member_name(AstNode.jsdoc_link_name_of(node))
        this.unported_mark() <> mark
    }

    ; ast.GetHostSignatureFromJSDoc — the function-like declaration a doc comment
    ; hangs on, which is what makes `{@link p}` resolve against a PARAMETER.
    ; ★GetJSDocRoot walks to the enclosing KindJSDoc and the host is its parent.
    function get_host_signature_from_jsdoc(node: ref[AstNode]) returns ref[AstNode]?
    {
        var p AstNode.parent_node_of(node)
        var root: ref[AstNode]? null
        while p <> null
        {
            let n p as ref[AstNode]
            if AstNode.kind_of(n) = KindJSDoc
            {
                set root: n
                set p: null
            }
            else
                set p: AstNode.parent_node_of(n)
        }
        if root = null
            return null
        let host AstNode.parent_node_of(root as ref[AstNode])
        if host = null
            return null
        let h host as ref[AstNode]
        ; `IsPropertySignatureDeclaration(host) && host.Type() != nil &&
        ; IsFunctionLike(host.Type())` — `foo: (x) => void` documented as a method.
        if AstNode.kind_of(h) = KindPropertySignature
        {
            let ht AstNode.type_of(h)
            if ht <> null
            {
                if AstNode.is_function_like(ht as ref[AstNode])
                    return ht
            }
        }
        if AstNode.is_function_like(h)
            return h
        null
    }

    ; resolveJSDocMemberName. ★The qualified fallback is the whole reason the
    ; function is recursive: `A.b` first tries the entity name whole, and only if
    ; that misses does it resolve `A` and look `b` up on the PROTOTYPE of its type
    ; — which is how `{@link C.m}` finds an instance method.
    procedure resolve_jsdoc_member_name(this, name: ref[AstNode]?) returns ref[Symbol]?
    {
        if name = null
            return null
        let nm name as ref[AstNode]
        ; ast.IsEntityName — an identifier or a qualified name, spelled out here
        ; because nothing else in this port asks it.
        let nk AstNode.kind_of(nm)
        if nk <> KindIdentifier
        {
            if nk <> KindQualifiedName
                return null
        }
        let mark this.unported_mark()
        let meaning SymbolFlagsType | SymbolFlagsNamespace | SymbolFlagsValue
        let direct this.resolve_entity_name(nm, meaning, true, true, Checker.get_host_signature_from_jsdoc(nm))
        if this.unported_mark() <> mark
            return null
        if direct <> null
            return direct
        if AstNode.kind_of(nm) <> KindQualifiedName
            return null
        let left this.resolve_jsdoc_member_name(AstNode.qualified_left_of(nm))
        if this.unported_mark() <> mark
            return null
        if left = null
            return null
        let ls left as ref[Symbol]
        var t: ref[Type]? null
        if (Symbol.flags_of(ls) & SymbolFlagsValue) <> 0
        {
            let lt this.get_type_of_symbol(ls)
            if this.unported_mark() <> mark
                return null
            if lt <> null
            {
                let proto this.get_property_of_type(lt as ref[Type], "prototype")
                if this.unported_mark() <> mark
                    return null
                if proto <> null
                {
                    set t: this.get_type_of_symbol(proto as ref[Symbol])
                    if this.unported_mark() <> mark
                        return null
                }
            }
        }
        if t = null
        {
            set t: this.get_declared_type_of_symbol(ls)
            if this.unported_mark() <> mark
                return null
        }
        if t = null
            return null
        let right AstNode.qualified_right_of(nm)
        if right = null
            return null
        let answer this.get_property_of_type(t as ref[Type], AstNode.identifier_text_of(right as ref[AstNode]))
        if this.unported_mark() <> mark
            return null
        answer
    }

    ; ★★★ checkSourceElementWorker. ALL FIFTY-NINE OF THE REFERENCE'S
    ; `case` LABELS ARE PORTED as of slice 83 (three in slice 47, five in slice 49, eight in
    ; slice 50 — the import/export/module family plus the two blocks — the class in
    ; slice 51, the function declaration in slice 52, the variable DECLARATION in
    ; slice 54, the PARAMETER in slice 55, the BINDING ELEMENT in slice 56, the type
    ; parameter in slice 60, the whole TYPE half in slice 61, the two type MEMBERS in
    ; slice 62, the eight JUMP-AND-GUARD statements in slice 63 and the five loop,
    ; return and switch arms in slice 64; slice 53 added none and finished one of
    ; the eighteen it found instead). checkVariableStatement
    ; runs to its last line, so the VariableStatement arm is the third in this file
    ; that is COMPLETE rather than a prefix — the count is a count of arms REACHED,
    ; not of arms finished, and those are two different numbers. ★Slice 63 makes it
    ; five: checkBreakOrContinueStatement and checkTryStatement run to their last
    ; lines too; slice 64 makes it six with checkForStatement.
    ;
    ; ★ THE UNIT OF THE COUNT CHANGED IN SLICE 61 and the two figures are not
    ; comparable: it used to read *twenty-one arms of its sixty*, counting some
    ; multi-kind cases (Block/ModuleBlock, TypeAlias/JSTypeAlias) as separate arms
    ; and some not. A `case` LABEL is countable against the reference's own text —
    ; fifty-nine of them, `case ConstructorType, FunctionType, CallSignature,
    ; ConstructSignature, IndexSignature:` being ONE — so that is the unit now. In
    ; the old unit slice 61 added nineteen cases; in the new one the total went from
    ; nineteen to thirty-eight.
    ;
    ; ★★★ THE STATEMENT CHAPTER CLOSED IN SLICE 64 AND THE SWITCH CLOSED IN SLICE
    ; 83. That line read *what is left is strays: the accessor pair, the constructor,
    ; the class static block, the enum member, the missing declaration and the four
    ; JSDoc type kinds* — and slice 82's member walk turned four of those from a
    ; sentence into a measurement (`check Constructor` 1 136 units at stage 2,
    ; GetAccessor 428, SetAccessor 347, ClassStaticBlock 79), which slice 83 wrote.
    ; ★★The other two entries of that list had ALREADY been written when it was
    ; last read: check_enum_member is an arm and the enum declaration walks its
    ; members before its own stop, and the four JSDoc type kinds are check_jsdoc_type.
    ; **The list outlived two of its own six items** — the same class as the counts
    ; two paragraphs up, which read *fifteen* while the table held seventeen.
    ; ★The namespace export
    ; declaration is NOT among them and used to be listed here — the reference's
    ; switch has no `case` for it at all, so it moved to kind_has_no_check_arm; see
    ; that function's own note, which is the more interesting half. Slice 83 added
    ; four more kinds and one CLASS of kinds there for the same reason.
    ;
    ; ★★★ SINCE SLICE 54 THE COUNT HAS A THIRD CATEGORY BESIDE `ported` AND `not
    ; ported`: the twelve kinds the switch has NO CASE for (kind_has_no_check_arm).
    ; They are not arms and they are not holes — doing nothing IS the reference's
    ; answer — and they are the reason the gate below can say true for a kind this
    ; file has no code for at all.
    ;
    ; What had to be settled before ANY of them
    ; could be was the two steps that stand in FRONT of the switch and run for
    ; every node. ★The count is the one kind_has_ported_check_arm answers true
    ; for, counted rather than incremented: it read *fifteen … seven in slice 50*
    ; for two slices while the table held sixteen and then seventeen, because the
    ; slice-50 figure was one short of its own parenthetical (six arms plus two
    ; blocks) and nothing re-added the sum.
    ;
    ; ★★★ THE REACHABILITY CHECK PRODUCES NOTHING THIS YARDSTICK COMPARES, and
    ; that is read off the reference rather than hoped: checkSourceElementUnreachable
    ; ends in `c.addErrorOrSuggestion(c.compilerOptions.AllowUnreachableCode ==
    ; core.TSFalse, diagnostic)`, and AllowUnreachableCode is UNSET under this
    ; harness (the oracle passes SkipDefaultLibCheck and NoErrorTruncation and
    ; nothing else), so the flag is TSUnknown, `== TSFalse` is false, and the
    ; diagnostic goes to `c.suggestionDiagnostics` with CategorySuggestion. The
    ; oracle calls GetDiagnostics, which reads `c.diagnostics`. Its only other
    ; effect is `c.withinUnreachableCode`, whose three readers are the guard
    ; itself and the save/restore around it. So TS7027 cannot appear in a C
    ; section at all here — which is why an arm may be claimed without the flow
    ; graph, and why this is stated at the line rather than left as a hole. ★It is
    ; conditional on the OPTION: a slice that lets `@allowUnreachableCode: false`
    ; through would make the whole family observable and owe the flow graph.
    ;
    ; ★★★ THE JSDOC PASS IS PORTED, AND THE GATE IT REPLACES WAS THE FLAG (slice
    ; 78). What stood here read *the tighter gate — walk the comment parts and admit
    ; a JSDoc that carries no link — is a refinement with a measurement attached,
    ; not a guess*, and this is that measurement: on the stage-1 corpus the flag
    ; gate stopped **110 units** and a link is present in **4** of them. The pass
    ; itself is check_jsdoc_of_node below, three functions that are the reference's
    ; three.
    ;
    ; ★ The kind test comes FIRST, before the pass, and the order is ours rather
    ; than the reference's: for a kind whose arm is not ported the unit is unported
    ; either way, and the tag should name what actually blocks it. Putting the
    ; JSDoc gate in front would relabel a VariableStatement carrying a doc comment
    ; as `check-jsdoc-comments`, which fragments the histogram this column exists
    ; to be.
    procedure check_source_element_worker(this, node: ref[AstNode])
    {
        let k AstNode.kind_of(node)
        if Checker.kind_has_ported_check_arm(k) = false
        {
            this.record_unported("check", k)
            this.spend_ambient_report_of_container(node)
            return
        }
        if this.check_jsdoc_of_node(node, k)
        {
            this.spend_ambient_report_of_container(node)
            return
        }
        ; ── slice 184: the reachability step, upstream's own position ───────
        ;
        ;   if !c.withinUnreachableCode && c.compilerOptions.AllowUnreachableCode != core.TSTrue {
        ;       if c.checkSourceElementUnreachable(node) { c.withinUnreachableCode = true }
        ;   }
        ;
        ; ★ The OPTION half of the guard is not written: `!= TSTrue` is satisfied by
        ; TSUnknown, which is what this oracle leaves it at, so the day it is set to
        ; TSTrue this line owes the test. Named rather than dropped, on the rule that
        ; a condition nobody can see is a condition nobody re-reads.
        ;
        ; ★★★ IT SITS AFTER THE JSDoc GATE AND BEFORE THE SWITCH, which is where the
        ; reference has it, and the position is load-bearing rather than tidy: the
        ; kinds with no switch case reach it too, so a statement after a `return`
        ; still sets the register for its own subtree even when nothing checks it.
        if (within_unreachable_code = false) and (checker_allow_unreachable_code <> TristateTrue)
        {
            if this.check_source_element_unreachable(node)
                set within_unreachable_code: true
        }

        ; The kinds the reference's switch has no CASE for, which is a different
        ; fact from an arm this port has not written — see kind_has_no_check_arm.
        ; The JSDoc gate stays in FRONT of it: the two steps before the switch run
        ; for every kind, and a keyword type carrying a doc comment would reach
        ; checkJSDocComments there as any other node does.
        if Checker.kind_has_no_check_arm(k)
            return

        ; case ast.KindBlock, ast.KindModuleBlock: c.checkBlock(node)
        ;
        ; ★★★ THIS ARM IS WHAT LIFTS SLICE 49's LAST BOUND. It wrote *only
        ; TOP-LEVEL statements are ever checked … anything inside a namespace body
        ; is reached through checkModuleDeclaration -> checkSourceElement(body) ->
        ; checkBlock, and neither arm is ported*, and named the next slice as the
        ; one that lifts it. Both arms are here, and they had to arrive together:
        ; the module arm's FIRST step is checkSourceElement(body), so porting it
        ; without this one would have measured the module prefix on a body that
        ; reports immediately.
        if k = KindBlock
        {
            this.check_block(node)
            return
        }
        if k = KindModuleBlock
        {
            this.check_block(node)
            return
        }
        if k = KindVariableStatement
        {
            this.check_variable_statement(node)
            return
        }
        if k = KindExpressionStatement
        {
            this.check_expression_statement(node)
            return
        }
        ; ── slice 63: the JUMP-AND-GUARD statement arms ─────────────────────
        ;
        ; The reference's own cases are eight: `IfStatement`, `DoStatement`,
        ; `WhileStatement`, `ContinueStatement, BreakStatement` (one label over one
        ; function), `WithStatement`, `LabeledStatement`, `ThrowStatement` and
        ; `TryStatement`. What is NOT here is the five that carry a loop head or a
        ; return type — see the section header.
        if k = KindIfStatement
        {
            this.check_if_statement(node)
            return
        }
        if k = KindDoStatement
        {
            this.check_do_statement(node)
            return
        }
        if k = KindWhileStatement
        {
            this.check_while_statement(node)
            return
        }
        if k = KindContinueStatement
        {
            this.check_break_or_continue_statement(node)
            return
        }
        if k = KindBreakStatement
        {
            this.check_break_or_continue_statement(node)
            return
        }
        if k = KindWithStatement
        {
            this.check_with_statement(node)
            return
        }
        if k = KindLabeledStatement
        {
            this.check_labeled_statement(node)
            return
        }
        if k = KindThrowStatement
        {
            this.check_throw_statement(node)
            return
        }
        if k = KindTryStatement
        {
            this.check_try_statement(node)
            return
        }
        ; ── slice 64: the LOOP, RETURN and SWITCH arms ──────────────────────
        ;
        ; The reference's remaining five statement cases — `ForStatement`,
        ; `ForInStatement`, `ForOfStatement`, `ReturnStatement` and
        ; `SwitchStatement`. With them all thirteen statement `case` labels of this
        ; switch are reached.
        if k = KindForStatement
        {
            this.check_for_statement(node)
            return
        }
        if k = KindForInStatement
        {
            this.check_for_in_statement(node)
            return
        }
        if k = KindForOfStatement
        {
            this.check_for_of_statement(node)
            return
        }
        if k = KindReturnStatement
        {
            this.check_return_statement(node)
            return
        }
        if k = KindSwitchStatement
        {
            this.check_switch_statement(node)
            return
        }
        if k = KindInterfaceDeclaration
        {
            this.check_interface_declaration(node)
            return
        }
        if k = KindTypeAliasDeclaration
        {
            this.check_type_alias_declaration(node)
            return
        }
        if k = KindJSTypeAliasDeclaration
        {
            this.check_type_alias_declaration(node)
            return
        }
        if k = KindEnumDeclaration
        {
            this.check_enum_declaration(node)
            return
        }
        ; Slice 65. Reached by the enum declaration's own members walk, which is why
        ; it arrives with that arm rather than in a slice of its own.
        if k = KindEnumMember
        {
            this.check_enum_member(node)
            return
        }
        ; Slice 50 — the six arms whose head is checkGrammarModuleElementContext.
        if k = KindModuleDeclaration
        {
            this.check_module_declaration(node)
            return
        }
        if k = KindImportDeclaration
        {
            this.check_import_declaration(node)
            return
        }
        if k = KindJSImportDeclaration
        {
            this.check_import_declaration(node)
            return
        }
        if k = KindImportEqualsDeclaration
        {
            this.check_import_equals_declaration(node)
            return
        }
        if k = KindExportDeclaration
        {
            this.check_export_declaration(node)
            return
        }
        if k = KindExportAssignment
        {
            this.check_export_assignment(node)
            return
        }
        ; Slice 51 — the class declaration, whose head is
        ; checkGrammarClassLikeDeclaration.
        if k = KindClassDeclaration
        {
            this.check_class_declaration(node)
            return
        }
        ; Slice 52 — the function declaration, whose head is
        ; checkSignatureDeclaration.
        if k = KindFunctionDeclaration
        {
            this.check_function_declaration(node)
            return
        }
        ; Slice 54 — the variable declaration, which the VariableStatement arm's
        ; own walk reaches.
        if k = KindVariableDeclaration
        {
            this.check_variable_declaration(node)
            return
        }
        ; Slice 55 — the parameter, which checkSignatureDeclaration's parameter
        ; list walk (slice 52) has been handing to this switch ever since.
        if k = KindParameter
        {
            this.check_parameter(node)
            return
        }
        ; Slice 56 — the binding element, which the element walk of slices 54 and
        ; 55 has been handing to this switch ever since.
        if k = KindBindingElement
        {
            this.check_binding_element(node)
            return
        }
        ; Slice 60 — the type parameter. It became REACHABLE in slice 61, through
        ; checkMappedType's own type parameter and through an InferType's — the two
        ; callers slice 60 named when it wrote the arm down inert.
        if k = KindTypeParameter
        {
            this.check_type_parameter(node)
            return
        }
        ; ── slice 62: the type-MEMBER arms ──────────────────────────────────
        ;
        ; The two kinds slice 61's members walk has been handing here ever since,
        ; plus the two class kinds that share their bodies and are INERT (nothing
        ; walks a class body or an object literal yet). The reference's own cases
        ; are `PropertyDeclaration`/`PropertySignature` separately and
        ; `MethodDeclaration, MethodSignature` together.
        if k = KindPropertySignature
        {
            this.check_property_signature(node)
            return
        }
        if k = KindPropertyDeclaration
        {
            this.check_property_declaration(node)
            return
        }
        if k = KindMethodSignature
        {
            this.check_method_declaration(node)
            return
        }
        if k = KindMethodDeclaration
        {
            this.check_method_declaration(node)
            return
        }
        ; ── slice 83: the class's last members ─────────────────────────────
        ;
        ; The three `case` labels left in the member half of the reference's
        ; switch, all of them reached through the class's own member walk (slice
        ; 82). The reference has GetAccessor and SetAccessor on ONE label; they are
        ; two here because every arm in this switch is one kind.
        if k = KindClassStaticBlockDeclaration
        {
            this.check_class_static_block_declaration(node)
            return
        }
        if k = KindConstructor
        {
            this.check_constructor_declaration(node)
            return
        }
        if k = KindGetAccessor
        {
            this.check_accessor_declaration(node)
            return
        }
        if k = KindSetAccessor
        {
            this.check_accessor_declaration(node)
            return
        }
        ; checkMissingDeclaration, whole: `c.checkDecorators(node)` and nothing
        ; else. A MissingDeclaration is what the parser leaves where a decorator or
        ; modifier list is followed by no declaration at all, and the reference's
        ; whole answer is to check the decorators it does carry.
        if k = KindMissingDeclaration
        {
            this.check_decorators(node)
            return
        }
        ; ── slice 61: the type-node half of the switch ──────────────────────
        ;
        ; case ConstructorType, FunctionType, CallSignature, ConstructSignature,
        ; IndexSignature: c.checkSignatureDeclaration(node) — five kinds and one
        ; call, the function slice 52 wrote whole and nothing had reached with a
        ; kind other than FunctionDeclaration.
        if k = KindConstructorType
        {
            this.check_signature_declaration(node)
            return
        }
        if k = KindFunctionType
        {
            this.check_signature_declaration(node)
            return
        }
        if k = KindCallSignature
        {
            this.check_signature_declaration(node)
            return
        }
        if k = KindConstructSignature
        {
            this.check_signature_declaration(node)
            return
        }
        if k = KindIndexSignature
        {
            this.check_signature_declaration(node)
            return
        }
        if k = KindTypeReference
        {
            this.check_type_reference_node(node)
            return
        }
        if k = KindTypePredicate
        {
            this.check_type_predicate(node)
            return
        }
        if k = KindTypeQuery
        {
            this.check_type_query(node)
            return
        }
        if k = KindTypeLiteral
        {
            this.check_type_literal(node)
            return
        }
        if k = KindArrayType
        {
            this.check_array_type(node)
            return
        }
        if k = KindTupleType
        {
            this.check_tuple_type(node)
            return
        }
        if k = KindUnionType
        {
            this.check_union_or_intersection_type(node)
            return
        }
        if k = KindIntersectionType
        {
            this.check_union_or_intersection_type(node)
            return
        }
        ; case ParenthesizedType, OptionalType, RestType:
        ;     node.ForEachChild(c.checkSourceElement)
        if k = KindParenthesizedType
        {
            this.check_each_child_source_element(node)
            return
        }
        if k = KindOptionalType
        {
            this.check_each_child_source_element(node)
            return
        }
        if k = KindRestType
        {
            this.check_each_child_source_element(node)
            return
        }
        if k = KindThisType
        {
            this.check_this_type(node)
            return
        }
        if k = KindTypeOperator
        {
            this.check_type_operator(node)
            return
        }
        if k = KindConditionalType
        {
            this.check_conditional_type(node)
            return
        }
        if k = KindInferType
        {
            this.check_infer_type(node)
            return
        }
        if k = KindTemplateLiteralType
        {
            this.check_template_literal_type(node)
            return
        }
        if k = KindImportType
        {
            this.check_import_type(node)
            return
        }
        if k = KindNamedTupleMember
        {
            this.check_named_tuple_member(node)
            return
        }
        if k = KindIndexedAccessType
        {
            this.check_indexed_access_type(node)
            return
        }
        if k = KindMappedType
        {
            this.check_mapped_type(node)
            return
        }
        ; case JSDocNonNullableType, JSDocNullableType, JSDocAllType,
        ; JSDocTypeLiteral: c.checkJSDocType(node)
        if k = KindJSDocNonNullableType
        {
            this.check_jsdoc_type(node)
            return
        }
        if k = KindJSDocNullableType
        {
            this.check_jsdoc_type(node)
            return
        }
        if k = KindJSDocAllType
        {
            this.check_jsdoc_type(node)
            return
        }
        if k = KindJSDocTypeLiteral
        {
            this.check_jsdoc_type(node)
            return
        }
        ; case ast.KindEmptyStatement:    c.checkGrammarStatementInAmbientContext(node)
        ; case ast.KindDebuggerStatement: c.checkGrammarStatementInAmbientContext(node)
        ;
        ; Two arms whose whole body is that one call — so they are COMPLETE, which
        ; is the first time anything in this file can say so.
        this.check_grammar_statement_in_ambient_context(node)
    }

    ; ★★★ THE ONCE-BIT OF checkGrammarStatementInAmbientContext IS A PROPERTY OF
    ; THE WHOLE BLOCK, AND AN UNPORTED ARM MAKES ITS OWNER UNKNOWABLE. Slice 50
    ; found this the moment it ported the BLOCK arm, on
    ; `compiler_ambientWithStatements`: `declare namespace M { break; continue;
    ; debugger; … }` — the reference reports ONE TS1036, on the FIRST statement, and
    ; our port reported it on the `debugger`, because that is the first statement
    ; whose arm exists. A diagnostic at a position the reference does not have is
    ; the one thing diagcheck can fail on, and it did.
    ;
    ; ★★★ SO THE HONEST ANSWER IS TO SAY NOTHING, and the reason is exactly the
    ; reason the port reports rather than approximates everywhere else: the
    ; reference calls checkGrammarStatementInAmbientContext from the FIRST LINE of
    ; some twenty statement arms (break/continue, return, if, do, while, for, throw,
    ; try, switch, with, …), so a statement whose arm this slice does not implement
    ; MIGHT have spent the bit. Marking the container is the only claim that cannot
    ; be wrong: it makes our C section a strict SUBSET of the reference's, which is
    ; the relation the instrument asserts, instead of a line in the wrong place.
    ;
    ; ★★ IT USES THE reported_ambient SET AND MEANS SOMETHING ELSE BY IT — *this
    ; container's report is spent or unknowable*, not *we reported it* — which is
    ; why it is its own procedure with its own name rather than a bare
    ; mark_reported_ambient at two call sites.
    ;
    ; ★ THE SUCCESSOR IS NAMED: porting the first line of those twenty arms puts the
    ; report back where the reference puts it and retires this function. Until then
    ; the number it costs is visible — it is read off diagcheck's *units we speak
    ; on*, which is what that counter is printed for.
    ;
    ; ★★ SLICE 63 TOOK EIGHT OF THE TWENTY and slice 64 the remaining five, and the
    ; function STILL stays — which is the ordinary shape of this retirement rather
    ; than a shortfall: the bit belongs to a BLOCK, and a block is unknowable while
    ; ANY of its statements has an unported arm, statement or not.
    ;
    ; ★★★ WHAT IS LEFT IS NOT A STATEMENT AT ALL, and that is the successor stated
    ; precisely rather than by kind-count. Slice 63 wrote *the five loop/return/
    ; switch arms plus NamespaceExportDeclaration and MissingDeclaration*; of those
    ; the five are ported, and NamespaceExportDeclaration turned out to have no arm
    ; in the reference either — it is in kind_has_no_check_arm now, so it reaches
    ; this function only through the JSDoc gate. What remains that can genuinely
    ; spend the bit is MissingDeclaration, whose arm is unported and sits in
    ; statement position.
    ;
    ; ★★ AND THE SECOND CALLER IS THE ONE THAT WILL OUTLIVE THE FIRST: the JSDoc
    ; gate. Any statement of an ambient block that carries a doc comment is
    ; unknowable regardless of whether its arm is written, because the port stops
    ; at `check-jsdoc-comments` in FRONT of the switch — which is a claim about
    ; checkJSDocComments and not about the statement chapter at all. So the
    ; retirement this function is waiting for is now two independent things, and
    ; naming them apart is the point: an inventory that says *the statement arms*
    ; would read as finished today and the function would still be load-bearing.
    ;
    ; ★ Only an AMBIENT node can spend the bit (the check returns at its own first
    ; line otherwise), and only the in-block half of it is a property of the
    ; CONTAINER: the signature half marks the node itself, so an unported statement
    ; there can affect nothing else.
    procedure spend_ambient_report_of_container(this, node: ref[AstNode])
    {
        if (AstNode.flags_of(node) & NodeFlagsAmbient) = 0
            return
        let parent AstNode.parent_node_of(node)
        let pk Checker.kind_or_unknown(parent)
        var in_block false
        if pk = KindBlock
            set in_block: true
        if pk = KindModuleBlock
            set in_block: true
        if pk = KindSourceFile
            set in_block: true
        if in_block = false
            return
        if this.has_reported_ambient(parent)
            return
        this.mark_reported_ambient(parent)
    }

    function kind_has_ported_check_arm(k: int) returns bool
    {
        ; ★★★ THE KINDS WITH NO ARM AT ALL ANSWER TRUE HERE, and the word `ported`
        ; is what makes that look wrong: what this gate decides is whether the port
        ; SPEAKS on the kind, and for a kind the reference's switch does not
        ; mention, doing nothing IS the whole arm. Slice 54 needed the distinction
        ; because it is the first slice whose walk reaches a TYPE node.
        if Checker.kind_has_no_check_arm(k)
            return true
        if k = KindExpressionStatement
            return true
        if k = KindEmptyStatement
            return true
        if k = KindDebuggerStatement
            return true
        ; Slice 63. The JUMP-AND-GUARD statement arms — the eight `case` labels of
        ; the statement chapter whose bodies reach neither a loop head nor a return
        ; type. Every one of them is REACHED (a statement list walks into it), which
        ; is what separates this row from slices 60 and 62's inert ones.
        if k = KindIfStatement
            return true
        if k = KindDoStatement
            return true
        if k = KindWhileStatement
            return true
        if k = KindContinueStatement
            return true
        if k = KindBreakStatement
            return true
        if k = KindWithStatement
            return true
        if k = KindLabeledStatement
            return true
        if k = KindThrowStatement
            return true
        if k = KindTryStatement
            return true
        ; Slice 64. The five that carry a loop head or a return type — the rest of
        ; the statement chapter, and with them every statement `case` label of
        ; checkSourceElementWorker is reached.
        if k = KindForStatement
            return true
        if k = KindForInStatement
            return true
        if k = KindForOfStatement
            return true
        if k = KindReturnStatement
            return true
        if k = KindSwitchStatement
            return true
        ; Slice 49. The five kinds whose arm BEGINS with checkGrammarModifiers and
        ; has nothing in front of it — so the ported prefix is the whole of the
        ; arm up to the first thing this slice does not implement, and the report
        ; names that thing.
        if k = KindVariableStatement
            return true
        if k = KindInterfaceDeclaration
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        if k = KindEnumDeclaration
            return true
        ; Slice 65. The enum MEMBER, reached by the enum declaration's members walk.
        if k = KindEnumMember
            return true
        ; Slice 50. The BLOCK pair plus the six arms of the import/export/module
        ; family — the whole set that reaches checkGrammarModuleElementContext, and
        ; the two blocks that carry the statements those arms recurse into.
        if k = KindBlock
            return true
        if k = KindModuleBlock
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindImportDeclaration
            return true
        if k = KindJSImportDeclaration
            return true
        if k = KindImportEqualsDeclaration
            return true
        if k = KindExportDeclaration
            return true
        if k = KindExportAssignment
            return true
        ; Slice 51. The class declaration — one arm, three functions of prefix,
        ; and the first reader of a list's RANGE outside the parser.
        if k = KindClassDeclaration
            return true
        ; Slice 52. The function declaration — the last of the switch's arms to be
        ; a HEAD, and the first whose grammar `||` this port runs to its end.
        if k = KindFunctionDeclaration
            return true
        ; Slice 54. The variable declaration, reached by the VariableStatement
        ; arm's own walk through checkVariableDeclarationList.
        if k = KindVariableDeclaration
            return true
        ; Slice 55. The parameter — the first arm this file reaches through a
        ; SIGNATURE rather than through a statement list, and the first whose
        ; reports are `c.error`s rather than grammar errors.
        if k = KindParameter
            return true
        ; Slice 56. The binding element — the other half of
        ; checkVariableLikeDeclaration, and the first arm whose own walk feeds
        ; ITSELF (a nested pattern's elements are binding elements too).
        if k = KindBindingElement
            return true
        ; Slice 60. The type parameter. ★★★It is INERT and it is here because the
        ; table is a claim about which kinds this port SPEAKS on, not about which
        ; ones it has been asked about: checkTypeParameters calls checkTypeParameter
        ; DIRECTLY, as the reference does, so nothing hands a type parameter to
        ; checkSourceElement today and neither this row nor the switch arm below can
        ; be reached. Leaving them out would make the first slice that does walk into
        ; one — checkMappedType's own type parameter, or an InferType's — report a
        ; hole for an arm that exists. ★The consequence of the direct call is worth
        ; the line: the two steps in FRONT of the switch do not run for a type
        ; parameter, so one carrying a doc comment does NOT take the
        ; check-jsdoc-comments tag. That is the reference's shape, not an omission.
        if k = KindTypeParameter
            return true
        ; Slice 62. The type-MEMBER arms — the property signature and the method
        ; signature, which slice 61's members walk reaches, plus the two CLASS kinds
        ; that share their bodies. ★★★The class pair is INERT for slice 60's reason:
        ; nothing walks a class body's members or an object literal's properties, so
        ; neither kind can reach the switch today — and the row is here because the
        ; table says which kinds this port SPEAKS on, not which ones it has been
        ; asked about.
        if k = KindPropertySignature
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindMethodDeclaration
            return true
        ; Slice 83. The three member arms left in the switch. ★The class-pair row
        ; above is no longer inert and neither is this one: slice 82 gave the class
        ; its member walk, which is what turned the four `check <kind>` counts this
        ; slice closes from a sentence into a measurement.
        if k = KindClassStaticBlockDeclaration
            return true
        if k = KindConstructor
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindMissingDeclaration
            return true
        ; Slice 61. The switch's whole TYPE half, plus the five signature kinds
        ; whose case is a call to checkSignatureDeclaration. ★★★It is the largest
        ; single addition this table has taken — twenty-seven kinds — and it is one
        ; slice for the reason the section header gives: eleven of the arms are a
        ; WALK, and a walk stopped one kind short of its neighbour is not a smaller
        ; slice, it is a broken one.
        if k = KindConstructorType
            return true
        if k = KindFunctionType
            return true
        if k = KindCallSignature
            return true
        if k = KindConstructSignature
            return true
        if k = KindIndexSignature
            return true
        if k = KindTypeReference
            return true
        if k = KindTypePredicate
            return true
        if k = KindTypeQuery
            return true
        if k = KindTypeLiteral
            return true
        if k = KindArrayType
            return true
        if k = KindTupleType
            return true
        if k = KindUnionType
            return true
        if k = KindIntersectionType
            return true
        if k = KindParenthesizedType
            return true
        if k = KindOptionalType
            return true
        if k = KindRestType
            return true
        if k = KindThisType
            return true
        if k = KindTypeOperator
            return true
        if k = KindConditionalType
            return true
        if k = KindInferType
            return true
        if k = KindTemplateLiteralType
            return true
        if k = KindImportType
            return true
        if k = KindNamedTupleMember
            return true
        if k = KindIndexedAccessType
            return true
        if k = KindMappedType
            return true
        if k = KindJSDocNonNullableType
            return true
        if k = KindJSDocNullableType
            return true
        if k = KindJSDocAllType
            return true
        if k = KindJSDocTypeLiteral
            return true
        false
    }

    ; ★★★ THE KINDS checkSourceElementWorker's SWITCH HAS NO CASE FOR — so
    ; `checkSourceElement(x)` on one of them runs the two steps in front of the
    ; switch and then does NOTHING, and a report would be a claim that the unit is
    ; unmeasured where the reference measures nothing either. That is §3.5cx's
    ; checkExternalEmitHelpers argument at a place where it costs units rather than
    ; a comment: over stage 1 the three commonest annotations alone —
    ; `any` 35, `number` 16, `string` 14 — plus `void` 5 and a literal type 2 are
    ; **72 units** that would have carried a tag naming a function that does not
    ; exist. Measured on the way in, with the family switched off.
    ;
    ; ★★★ IT IS A CLAIM ABOUT THE REFERENCE'S SWITCH AND IT IS ENUMERABLE, which is
    ; what separates it from a guess: the twelve kinds below are the ELEVEN keyword
    ; types a type annotation can be — the ten of the parser's own
    ; `keyword_type_start` table, plus `void`, which that table deliberately omits
    ; because there is no `void.Foo` fallback, plus `intrinsic`, which only a type
    ; alias's right-hand side can be — and the LITERAL TYPE wrapper. Every OTHER
    ; kind a type annotation can be HAS a case (TypeReference, ArrayType,
    ; TupleType, UnionType, TypeLiteral, FunctionType, TypeOperator, MappedType, …
    ; twenty-six of them).
    ;
    ; ★★ SINCE SLICE 61 THOSE TWENTY-SIX ARE PORTED RATHER THAN REPORTED, which
    ; inverts what this list is FOR without changing what it says. It used to keep
    ; seventy-two units of stage 1 from carrying a tag naming a function that does
    ; not exist while their neighbours carried honest ones; now every neighbour is
    ; an arm, and the list is the only thing standing between a keyword type and a
    ; hole that is not there. The measurement is unchanged and so is the argument.
    ;
    ; ★★ WHAT IS DELIBERATELY NOT IN THE LIST, because the list is only worth what
    ; its argument is: every other kind the switch omits — an EXPRESSION kind, a
    ; token, a JSX kind. Those are no-arm kinds too, but nothing in this port hands
    ; one to checkSourceElement, so admitting them would be a claim no instrument
    ; here can reach. The list grows with the arm that first walks into such a
    ; position.
    ;
    ; ★ A LiteralType's CHILD is not walked, and that is the reference's answer
    ; rather than an omission: no case means no ForEachChild, so `var x: "a"` never
    ; reaches the string literal. The three kinds whose case IS a bare
    ; `node.ForEachChild(c.checkSourceElement)` — Parenthesized/Optional/Rest — are
    ; not here for exactly that reason.
    function kind_has_no_check_arm(k: int) returns bool
    {
        if k = KindAnyKeyword
            return true
        if k = KindUnknownKeyword
            return true
        if k = KindStringKeyword
            return true
        if k = KindNumberKeyword
            return true
        if k = KindBigIntKeyword
            return true
        if k = KindSymbolKeyword
            return true
        if k = KindBooleanKeyword
            return true
        if k = KindUndefinedKeyword
            return true
        if k = KindNeverKeyword
            return true
        if k = KindObjectKeyword
            return true
        if k = KindVoidKeyword
            return true
        if k = KindIntrinsicKeyword
            return true
        ; ★★★ SLICE 64: NamespaceExportDeclaration BELONGS HERE AND HAD BEEN
        ; COUNTED AS AN UNPORTED ARM FOR SIXTEEN SLICES. `export as namespace N`
        ; has NO `case` in checkSourceElementWorker — the only mention of the kind
        ; anywhere in internal/checker's switch statements is
        ; getTargetOfDeclaration's — so doing nothing IS the reference's whole
        ; answer, and the seventeen units of stage 2 that were sitting at
        ; `check NamespaceExportDeclaration` were sitting on a row that names no
        ; work. ★It was found by asking what is left AFTER the statement chapter
        ; rather than by looking at the row, which is the point: a work-list row is
        ; a claim about the reference, and nothing re-checks a claim that has been
        ; on the list since slice 47.
        if k = KindNamespaceExportDeclaration
            return true
        ; ★★★ SLICE 83: THREE MORE, AND THEY ARRIVE THE WAY THIS LIST'S OWN NOTE
        ; SAID THEY WOULD — *the list grows with the arm that first walks into such
        ; a position*. Slice 82 gave the class its member walk and a JS file's
        ; parameter types reached the type-node table, so `check SemicolonClassElement`
        ; (2 units), `check JSDocVariadicType` (2) and `check JSDocOptionalType` (1)
        ; appeared on the work list — three rows naming a function the reference does
        ; not have. A `;` between two class members has NO case in
        ; checkSourceElementWorker at all, and the JSDoc label lists exactly four
        ; kinds — NonNullable, Nullable, All and TypeLiteral — of which these two are
        ; not. ★It is slice 64's NamespaceExportDeclaration finding a second time,
        ; and the reason it is a second time rather than a repeat is that nothing
        ; re-checks a claim once it is on the list: these three were unreachable when
        ; the argument above was written and became reachable one slice ago.
        if k = KindSemicolonClassElement
            return true
        if k = KindJSDocOptionalType
            return true
        if k = KindJSDocVariadicType
            return true
        ; ★★★ AND A FOURTH ENTRY THAT IS A CLASS RATHER THAN A KIND, found at STAGE 2
        ; only. checkClassStaticBlockDeclaration's whole second line is
        ; `node.ForEachChild(c.checkSourceElement)`, and the reference's own
        ; ForEachChild for that node is `visitModifiers(v, node.modifiers) ||
        ; visit(v, node.Body)` — so `@dec static {}` and `private static {}` hand a
        ; MODIFIER TOKEN to checkSourceElement, upstream exactly as here, and the
        ; switch has no case for one. Five units of stage 2 measured it, one per
        ; kind: Decorator, AsyncKeyword, PublicKeyword, ReadonlyKeyword,
        ; PrivateKeyword (classStaticBlock19 and classStaticBlock20).
        ;
        ; ★★ IT IS ASKED AS is_modifier_kind RATHER THAN AS FIVE ENTRIES, and that is
        ; the difference between the enumeration this list rests on and a sample: the
        ; reference has no case for ANY of the fifteen modifier keywords, so the five
        ; that this corpus happens to contain are not the claim. ★The Decorator is a
        ; separate line because it is a NODE and not a keyword token, and
        ; visitModifiers walks both.
        if Parser.is_modifier_kind(k)
            return true
        if k = KindDecorator
            return true
        ; ★★★ SLICE 131: THE IDENTIFIER, AND IT IS THE FIFTH TIME THIS LIST HAS
        ; GROWN BY A ROW THAT NAMES NO WORK. `checkSourceElementWorker`'s switch has
        ; NO `case ast.KindIdentifier` — checked over the whole switch, not sampled —
        ; so doing nothing is the reference's entire answer for one, and the row
        ; `check Identifier` was the LARGEST portable row on the stage-2 frontier
        ; (+143 units of 951 arrivals) while naming a function that does not exist.
        ; ★It arrives here the way every earlier entry did: an arm ported in an
        ; earlier slice walks its children, and a bare name in a position nothing
        ; had reached before lands in checkSourceElement. ★★The generalisable half
        ; is not the entry but the habit — **a work-list row is a claim about the
        ; REFERENCE, and nothing re-checks a claim once it is on the list**; four
        ; of the five entries below this line were found by asking what the
        ; reference does rather than by reading the row.
        ; ★★★ SLICE 131 WROTE THIS ENTRY AS `k = KindIdentifier` AND SLICE 154
        ; WIDENED IT TO THE CLASS THE IDENTIFIER IS ONE MEMBER OF. Its note read
        ; *`checkSourceElementWorker`'s switch has NO `case ast.KindIdentifier` —
        ; checked over the whole switch, not sampled — so doing nothing is the
        ; reference's entire answer for one*, and the row `check Identifier` was the
        ; LARGEST portable row on the stage-2 frontier (+143 units of 951 arrivals)
        ; while naming a function that does not exist. Every word of that holds for
        ; the OTHER thirty kinds of `isLeftHandSideExpressionKind` too, and five of
        ; them were back on the frontier three slices later as one row of 71 units:
        ; PropertyAccessExpression (35), CallExpression (21), ParenthesizedExpression
        ; (11), ClassExpression (7), NullKeyword (1) — which is `extends X.Y`,
        ; `extends f()`, `extends (class {})`, `extends class {}` and `extends null`
        ; arriving at checkClassLikeDeclaration's `checkSourceElement(baseTypeNode
        ; .Expression)`. Enumerating the five the corpus happens to hold would be
        ; the sample this list's modifier entry already refuses to be.
        ;
        ; ★★★ THE CLAIM IS MECHANICAL AND IT HAS ONE EXCEPTION. The switch's
        ; fifty-nine `case` labels were diffed against the thirty-one kinds
        ; `isLeftHandSideExpressionKind` answers true for: the sets are disjoint
        ; except for **MissingDeclaration**, which the grammar counts as a
        ; left-hand-side expression AND the switch dispatches to
        ; checkMissingDeclaration. It is asked first, so the class test never
        ; reaches it — and the ordering is load-bearing rather than tidy, because
        ; kind_has_ported_check_arm asks THIS function before its own table.
        if k <> KindMissingDeclaration
        {
            if Parser.is_left_hand_side_expression_kind(k)
                return true
        }
        k = KindLiteralType
    }

    ; ── slice 70: the EXPRESSION DISPATCH ───────────────────────────────────
    ;
    ; `check-expression` was ONE row of 4 118 units at the head of the work list
    ; and it is a CHAPTER rather than a function: checkExpression → checkExpressionEx
    ; → checkExpressionWorker, whose switch has forty-four `case` labels over
    ; thirty-eight kinds. This slice ports the three functions in front of the
    ; switch and the switch itself, so that the column stops naming a call and
    ; starts naming the ARM the corpus reaches — which is the move slice 47 made
    ; when it put the kind on `check`, slice 63 when it split the statement arms,
    ; and the reason a work-list row is only as good as its resolution.
    ;
    ; ★★★ WHAT THE SLICE PRODUCES IS A HISTOGRAM, AND THAT IS ITS WHOLE POINT.
    ; Three of the forty-six `case` labels answer a type this port already has, so
    ; the slice finishes three expression shapes; two more run their GRAMMAR check
    ; and stop at the type; every other label reports under its own reference
    ; function's name. The one number that decides the next slice is therefore not
    ; a diagnostic count but which arm the units land on.
    ;
    ; ★★ THE KIND COVERAGE IS DIFFED RATHER THAN EYEBALLED: the forty-six labels
    ; name forty-nine kinds, and the set below is IDENTICAL to the reference's,
    ; compared mechanically (its `ast.Kind*` mentions against this function's
    ; `if k = Kind*`). That check is worth keeping for the next reader — a missing
    ; kind here does not fail, it falls into the default and answers `any`.
    ;
    ; ★★★ AND THE FOUR ARMS COMPLETE THREE STATEMENT ARMS WITH THEM. An expression
    ; STATEMENT, a `throw` and a `with` hand the type to nothing — the reference
    ; discards it — so for a ported expression those arms now run to their last
    ; line rather than stopping, which is the first time in this dimension that
    ; porting an expression finishes a STATEMENT.
    ;
    ; ★★ NULL MEANS *I STOPPED* HERE AND NOTHING ELSE, which is what makes the
    ; chain readable after slice 69's two-meaning nil: the reference's worker ends
    ; in `return c.errorType` and never answers nil, so a null coming out of this
    ; chain is unambiguous and a caller tests it directly instead of taking a mark.
    ; ★The one caller that still needs the mark is the one whose own answer may be
    ; legitimately empty — check_variable_like_declaration — and it takes it for
    ; the reason slice 69 wrote down, not for this chain's sake.

    ; checkExpression, whole. The only mode any caller in this port passes.
    procedure check_expression(this, node: ref[AstNode]) returns ref[Type]?
        this.check_expression_ex(node, CheckModeNormal)

    ; checkExpressionEx, and its four steps split two and two.
    ;
    ; ★★ THE TWO IT SKIPS ARE FIELDS WITH NO READER (§3.5be), each named with the
    ; reader that would make it observable: `c.currentNode` is read by
    ; getTypeOfSymbol's circularity report and by the tracer, both of which report
    ; here; `c.instantiationCount = 0` is the budget instantiateType charges
    ; against, and nothing instantiates yet. A save/restore of a field this file
    ; does not have would be two lines that cannot be wrong and cannot be right.
    ;
    ; ★★★ THE TWO IT PORTS ARE BOTH GATES, AND BOTH ARE PROVABLY INERT RATHER THAN
    ; MERELY QUIET — which is why they stand here reporting instead of being left
    ; out. instantiateTypeWithSingleGenericCallSignature returns its argument
    ; unchanged unless the mode carries Inferential or SkipGenericFunctions, and
    ; CheckMode's own note says only Normal is ever passed, so that one still
    ; reports. ★★THE SECOND HALF OF THIS NOTE EXPIRED IN SLICE 116 (§3.5p): it
    ; said isConstEnumObjectType *needs an ANONYMOUS object type whose symbol is a
    ; const enum, and the only producer of one is getTypeOfFuncClassEnumModule's
    ; enum arm, which reports*. That arm does not report and had not for some
    ; time — it mints the anonymous type — and the stop it stood for went from
    ; ONE unit to thirteen the moment the enum chapter let those units reach it.
    ; checkConstEnumAccess is written out below.
    procedure check_expression_ex(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        ; ★ The two registers, slice 154, and the restore covers the WHOLE body
        ; (upstream restores after checkConstEnumAccess, not after the worker), so
        ; the body moves into a twin rather than growing three restore sites for
        ; the two stops it already has.
        let save_current_node current_node
        set current_node: node
        set instantiation_count: 0
        let result this.check_expression_ex_worker(node, check_mode)
        set current_node: save_current_node
        result
    }

    procedure check_expression_ex_worker(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let t this.check_expression_worker(node, check_mode)
        if t = null
            return null
        let inst this.instantiate_type_with_single_generic_call_signature(node, t as ref[Type], check_mode)
        if inst = null
            return null
        if Checker.is_const_enum_object_type(inst as ref[Type])
            this.check_const_enum_access(node, inst as ref[Type])
        inst
    }

    ; instantiateTypeWithSingleGenericCallSignature.
    ;
    ; ★★★ THE GATE THAT STOOD HERE EXPIRED IN THIS SLICE AND IT IS §3.5dk EXACTLY:
    ; the note above said *CheckMode's own note says only Normal is ever passed, so
    ; that one still reports* — and inferTypeArguments is the caller that passes
    ; SkipGenericFunctions. With the gate left as a stop the whole inference
    ; chapter answered nothing: `id(1)` reported here, one function below the
    ; inference it was meant to run.
    ;
    ; ★★★ AND THE FUNCTION IS MOSTLY AN EARLY EXIT, WHICH IS WHY THIS IS CHEAP.
    ; Every one of its four guards answers `t` UNCHANGED, and an ordinary argument
    ; fails the first: `1` has no call signature at all. What is behind them is the
    ; generic-function-as-argument case — `arrayMap(value => ({ value }))` — and
    ; that needs getAdjustedTypeWithFacts, getUniqueTypeParameters,
    ; instantiateSignatureInContextOf and getOrCreateTypeFromSignature, none of
    ; which is here. So the stop moves from EVERY inferential check to the one
    ; shape it belongs to.
    procedure instantiate_type_with_single_generic_call_signature(this, node: ref[AstNode], t: ref[Type], check_mode: int) returns ref[Type]?
    {
        if (check_mode & (CheckModeInferential | CheckModeSkipGenericFunctions)) = 0
            return t
        let mark this.unported_mark()
        let call_signature this.get_single_signature(t, SignatureKindCall, true)
        if this.unported_mark() <> mark
            return null
        var signature call_signature
        if signature = null
        {
            set signature: this.get_single_signature(t, SignatureKindConstruct, true)
            if this.unported_mark() <> mark
                return null
        }
        if signature = null
            return t
        let sig signature as ref[Signature]
        if sig.type_parameters = null
            return t
        if ((sig.type_parameters as ref[Array[ref[Type]?]]).get_length() as int) = 0
            return t
        let contextual this.get_apparent_type_of_contextual_type(node, ContextFlagsNoConstraints)
        if this.unported_mark() <> mark
            return null
        if contextual = null
            return t
        ; ★★★ WHOLE SINCE SLICE 159, AND THE NOTE BELOW WAS A LIST OF FOUR CALLEES
        ; OF WHICH THREE WERE ALREADY HERE — §3.5eo. It read *"GetNonNullableType,
        ; which under strictNullChecks is getAdjustedTypeWithFacts(t,
        ; NEUndefinedOrNull) — the type-FACTS chapter. Everything past it (the
        ; contextual signature, skippedGenericFunction and the outer-return-type
        ; inference) hangs off this one call"*, and `get_non_nullable_type`,
        ; `get_adjusted_type_with_facts` and `skipped_generic_function` are all in
        ; the file — the last one directly below this function, written by the same
        ; slice that wrote the note. Only `getUniqueTypeParameters` was absent.
        ;
        ; ★★ THE KIND OF THE CONTEXTUAL SIGNATURE FOLLOWS THE SIGNATURE THAT WAS
        ; FOUND, not the one that was asked for: the reference selects Call when the
        ; CALL lookup answered and Construct otherwise, which is why `call_signature`
        ; is kept as its own name beside `signature`.
        let non_null this.get_non_nullable_type(contextual as ref[Type])
        if this.unported_mark() <> mark
            return null
        if non_null = null
            return t
        var ctx_kind SignatureKindConstruct
        if call_signature <> null
            set ctx_kind: SignatureKindCall
        let contextual_signature this.get_single_signature(non_null as ref[Type], ctx_kind, false)
        if this.unported_mark() <> mark
            return null
        if contextual_signature = null
            return t
        let csig contextual_signature as ref[Signature]
        if csig.type_parameters <> null
        {
            if ((csig.type_parameters as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                return t
        }
        ; ★★★ THE SKIP ARM ANSWERS `anyFunctionType`, AND THAT TYPE IS A MARKER
        ; RATHER THAN A TYPE: it is one of the object types NewChecker builds so
        ; that a later pass can recognise *a generic function whose inference was
        ; deferred*. Its reader is chooseOverload's second pass; until that arm is
        ; here the marker travels and nothing compares it, which is exactly the
        ; reference's own shape and not a gap.
        if (check_mode & CheckModeSkipGenericFunctions) <> 0
        {
            ; ★★★ THE SKIP ARM IS WHOLE SINCE SLICE 164, AND IT WAS NEVER A LINE
            ; THAT COULD BE PRICED ON ITS OWN. The row that stood here said writing
            ; it out takes `compiler/declarationEmitExpandoArrowFunctionParameter`
            ; MATCH → FAIL with an invented TS2345 — TRUE, and it is the wildcard in
            ; `signatures_related_to` that makes the marker acceptable to an
            ; applicability test; that line's own note priced ITSELF at 28 MATCH →
            ; FAIL, on a tree without this arm. **Two lines each measured alone, each
            ; measured on a tree missing the other, and the pair costs nothing.**
            ; Written together with the re-derivation they need, the three move +92
            ; units at stage 2.
            ;
            ; ★★★ AND THE CONSUMER THE OLD NOTE COULD NOT FIND WAS NOT ON THIS PATH.
            ; It traced `typeArgumentInference` and reported *17 arrivals carry
            ; Contextual|Inferential and NOT ONE reaches the point where the
            ; inference context is asked for*, then named the five guards in between
            ; as *the next slice's first question*. The question was the wrong one:
            ; the re-derivation happens in
            ; `contextually_check_function_expression_or_object_literal_method`,
            ; whose inference block had been collapsed to its last line behind a note
            ; of its own — nothing about this function was in the way.
            this.skipped_generic_function(node, check_mode)
            return any_function_type
        }
        let context_opt this.get_inference_context(node)
        if this.unported_mark() <> mark
            return null
        if context_opt = null
        {
            ; CheckModeInferential is set only under inferTypeArguments, which
            ; pushes the context this reads — so a nil here is the reference's own
            ; nil dereference and not a shape it tolerates.
            this.record_unported("single-generic-call-signature-no-context", check_mode)
            return null
        }
        let context context_opt as ref[InferenceContext]
        ; "We have an expression that is an argument of a generic function for which
        ; we are performing type argument inference. […] check if the outer function
        ; returns a function type with a single non-generic call signature and if
        ; some of the outer function type parameters have no inferences so far. If
        ; so, we can potentially add inferred type parameters to the outer function
        ; return type."
        var return_signature: ref[Signature]? null
        if context.signature <> null
        {
            let ret this.get_return_type_of_signature(context.signature as ref[Signature])
            if this.unported_mark() <> mark
                return null
            if ret <> null
            {
                set return_signature: this.get_single_call_or_construct_signature(ret as ref[Type])
                if this.unported_mark() <> mark
                    return null
            }
        }
        var outer_ok false
        if return_signature <> null
        {
            let rs return_signature as ref[Signature]
            var rs_generic false
            if rs.type_parameters <> null
            {
                if ((rs.type_parameters as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                    set rs_generic: true
            }
            if rs_generic = false
            {
                ; `!core.Every(context.inferences, hasInferenceCandidates)` — at
                ; least one outer parameter has nothing inferred yet.
                var every true
                let inf_n context.inferences.get_length() as int
                var ii 0
                while ii < inf_n
                {
                    let info context.inferences[ii]
                    if info = null
                        set every: false
                    else
                    {
                        if Checker.has_inference_candidates(info as ref[InferenceInfo]) = false
                            set every: false
                    }
                    set ii: ii + 1
                }
                if every = false
                    set outer_ok: true
            }
        }
        if outer_ok
        {
            ; "Instantiate the signature with its own type parameters as type
            ; arguments, possibly renaming the type parameters to ensure they have
            ; unique names."
            let unique_tps this.get_unique_type_parameters(context, sig.type_parameters as ref[Array[ref[Type]?]])
            if this.unported_mark() <> mark
                return null
            if unique_tps = null
                return null
            let instantiated_opt this.get_signature_instantiation_without_filling_in_type_arguments(sig, unique_tps)
            if this.unported_mark() <> mark
                return null
            if instantiated_opt = null
                return null
            let instantiated instantiated_opt as ref[Signature]
            ; "Infer from the parameters of the instantiated signature to the
            ; parameters of the contextual signature starting with an EMPTY set of
            ; inference candidates" — a fresh InferenceInfo per outer parameter,
            ; which is what makes the overlap test below meaningful.
            let fresh &Array[ref[InferenceInfo]?]^host() as ref[Array[ref[InferenceInfo]?]]
            let inf_n context.inferences.get_length() as int
            var fi 0
            while fi < inf_n
            {
                let info context.inferences[fi]
                if info = null
                    fresh.add(null)
                else
                    fresh.add(this.new_inference_info((info as ref[InferenceInfo]).type_parameter))
                set fi: fi + 1
            }
            let param_cb &ApplyCallback^host(ApplyCallbackKindInferTypes, null, fresh, InferencePriorityNone, true)
            this.apply_to_parameter_types(param_cb, instantiated, csig)
            if this.unported_mark() <> mark
                return null
            var some false
            var si 0
            while si < inf_n
            {
                let info fresh[si]
                if info <> null
                {
                    if Checker.has_inference_candidates(info as ref[InferenceInfo])
                        set some: true
                }
                set si: si + 1
            }
            if some
            {
                ; "We have inference candidates, indicating that one or more type
                ; parameters are referenced in the parameter types of the contextual
                ; signature. Now also infer from the return type."
                let return_cb &ApplyCallback^host(ApplyCallbackKindInferTypes, null, fresh, InferencePriorityNone, false)
                this.apply_to_return_types(return_cb, instantiated, csig)
                if this.unported_mark() <> mark
                    return null
                ; "If the type parameters for which we produced candidates do not
                ; have any inferences yet, we adopt the new inference candidates and
                ; add the type parameters of the expression type to the set of
                ; inferred type parameters for the outer function return type."
                if Checker.has_overlapping_inferences(context.inferences, fresh) = false
                {
                    Checker.merge_inferences(context.inferences, fresh)
                    let joined &Array[ref[Type]?]^host() as ref[Array[ref[Type]?]]
                    if context.inferred_type_parameters <> null
                    {
                        let old context.inferred_type_parameters as ref[Array[ref[Type]?]]
                        let on old.get_length() as int
                        var oi 0
                        while oi < on
                        {
                            joined.add(old[oi])
                            set oi: oi + 1
                        }
                    }
                    let un unique_tps.get_length() as int
                    var ui 0
                    while ui < un
                    {
                        joined.add(unique_tps[ui])
                        set ui: ui + 1
                    }
                    set context.inferred_type_parameters: joined
                    return this.get_or_create_type_from_signature(instantiated)
                }
            }
        }
        ; ★The reference's own TODO sits here — the signature may reference outer
        ; inference contexts that are popped and re-pushed, and the result is cached
        ; on the FIRST attempt. Carried as a comment because it is a note about
        ; upstream's speculation model and not about this port.
        ; ★The reference passes a NIL comparer here and `newInferenceContext`
        ; substitutes `compareTypesAssignable` for one — so the honest spelling of
        ; that nil is the assignable comparer itself, which is also its zero.
        let in_context this.instantiate_signature_in_context_of(sig, csig, context, SignatureComparerAssignable)
        if this.unported_mark() <> mark
            return null
        if in_context = null
            return null
        this.get_or_create_type_from_signature(in_context as ref[Signature])
    }

    ; getUniqueTypeParameters, with hasTypeParameterByName and
    ; getUniqueTypeParameterName below it.
    ;
    ; ★★★ THE CLONE'S TWO SLOTS ARE THE POINT, AND SLICE 125 ALREADY DECLARED THEM
    ; for the mapped type's `P`: a renamed parameter carries `target` (the original)
    ; and `mapper` (old → new), and `getConstraintFromTypeParameter`'s first branch
    ; is what reads them. Without the mapper the renamed parameter would answer the
    ; ORIGINAL's constraint verbatim, which is wrong as soon as one renamed
    ; parameter's constraint mentions another.
    ;
    ; ★★ THE MAPPER IS BUILT ONCE AND STORED ON EVERY NEW PARAMETER, after the
    ; loop — it cannot be built inside it, because a parameter renamed early must
    ; map through the renamings that come later too.
    procedure get_unique_type_parameters(this, context: ref[InferenceContext], type_parameters: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]?
    {
        let old_tps &Array[ref[Type]?]^host() as ref[Array[ref[Type]?]]
        let new_tps &Array[ref[Type]?]^host() as ref[Array[ref[Type]?]]
        let result &Array[ref[Type]?]^host() as ref[Array[ref[Type]?]]
        let n type_parameters.get_length() as int
        var i 0
        while i < n
        {
            let tp_opt type_parameters[i]
            if tp_opt = null
            {
                result.add(null)
                set i: i + 1
                continue
            }
            let tp tp_opt as ref[Type]
            if tp.symbol = null
            {
                result.add(tp_opt)
                set i: i + 1
                continue
            }
            let name Symbol.name_of(tp.symbol as ref[Symbol])
            var taken false
            if context.inferred_type_parameters <> null
            {
                if Checker.has_type_parameter_by_name(context.inferred_type_parameters as ref[Array[ref[Type]?]], name)
                    set taken: true
            }
            if taken = false
            {
                if Checker.has_type_parameter_by_name(result, name)
                    set taken: true
            }
            if taken
            {
                ; core.Concatenate(context.inferredTypeParameters, result) — the
                ; names already spoken for, in one list.
                let spoken &Array[ref[Type]?]^host() as ref[Array[ref[Type]?]]
                if context.inferred_type_parameters <> null
                {
                    let old context.inferred_type_parameters as ref[Array[ref[Type]?]]
                    let on old.get_length() as int
                    var oi 0
                    while oi < on
                    {
                        spoken.add(old[oi])
                        set oi: oi + 1
                    }
                }
                let rn result.get_length() as int
                var ri 0
                while ri < rn
                {
                    spoken.add(result[ri])
                    set ri: ri + 1
                }
                let new_name Checker.unique_type_parameter_name(host, spoken, name)
                let symbol this.new_symbol(SymbolFlagsTypeParameter, new_name)
                let made this.new_type_parameter(symbol)
                choose made.data
                    when d0: TypeParameter
                    {
                        var d d0
                        set d.target: tp_opt
                        set made.data: TypeData.TypeParameter(d)
                    }
                old_tps.add(tp_opt)
                new_tps.add(made)
                result.add(made)
            }
            else
                result.add(tp_opt)
            set i: i + 1
        }
        if (new_tps.get_length() as int) <> 0
        {
            let m this.new_type_mapper(old_tps, new_tps)
            let nn new_tps.get_length() as int
            var ni 0
            while ni < nn
            {
                let e new_tps[ni]
                if e <> null
                {
                    let et e as ref[Type]
                    choose et.data
                        when d0: TypeParameter
                        {
                            var d d0
                            set d.mapper: m
                            set et.data: TypeData.TypeParameter(d)
                        }
                }
                set ni: ni + 1
            }
        }
        result
    }

    function has_type_parameter_by_name(type_parameters: ref[Array[ref[Type]?]], name: Slice[char]) returns bool
    {
        let n type_parameters.get_length() as int
        var i 0
        while i < n
        {
            let tp type_parameters[i]
            if tp <> null
            {
                let t tp as ref[Type]
                if t.symbol <> null
                {
                    if Checker.name_is(Symbol.name_of(t.symbol as ref[Symbol]), name)
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; getUniqueTypeParameterName. ★The trailing-digit strip keeps `len > 1`, so a
    ; parameter literally named `1` keeps its name and becomes `11` rather than
    ; losing it — the reference's own bound and worth preserving, because the
    ; augmented name is a SYMBOL name and an empty one would collide with every
    ; other stripped name.
    ;
    ; ★ The name is built on the checker's page in ONE allocation, the shape
    ; `unique_es_symbol_name` established: a name is a (pointer, length) pair and
    ; every reader indexes it, so it may not be two pieces.
    function unique_type_parameter_name(host: ref[Page], type_parameters: ref[Array[ref[Type]?]], base: Slice[char]) returns Slice[char]
    {
        var bn base.length as int
        while bn > 1
        {
            let c (base[bn - 1] as int)
            if c < 48
                break
            if c > 57
                break
            set bn: bn - 1
        }
        var index 1
        repeat
        {
            var digits char[24]
            var dn 0
            var v index
            while v > 0
            {
                set digits[dn]: (((v % 10) + 48) as char)
                set v: v / 10
                set dn: dn + 1
            }
            let total bn + dn
            let buf host.allocate((total + 1) as size_t, 1) as pointer[char]
            var w 0
            var i 0
            while i < bn
            {
                set *(buf + w): base[i]
                set w: w + 1
                set i: i + 1
            }
            var j 0
            while j < dn
            {
                set *(buf + w): digits[dn - 1 - j]
                set w: w + 1
                set j: j + 1
            }
            set *(buf + w): 0 as char
            let candidate Slice[char](total, buf)
            if Checker.has_type_parameter_by_name(type_parameters, candidate) = false
                return candidate
            set index: index + 1
        }
    }

    ; skippedGenericFunction — marks the inference context so that chooseOverload
    ; knows a second pass is owed. It has no caller until the branch above lands
    ; and is written with it, at the reference's own line.
    procedure skipped_generic_function(this, node: ref[AstNode], check_mode: int)
    {
        if (check_mode & CheckModeInferential) = 0
            return
        let context this.get_inference_context(node)
        if context = null
            return
        let ctx context as ref[InferenceContext]
        set ctx.flags: ctx.flags | InferenceFlagsSkippedGenericFunction
    }

    ; checkConstEnumAccess, and its FIRST half is the whole of it here.
    ;
    ; ★★★ A CONST ENUM'S OBJECT TYPE IS LEGAL IN FIVE POSITIONS AND NOWHERE ELSE
    ; (TS2475), which is what the `ok` disjunction spells: the left of a property
    ; access, the object of an index access, the right of an import or export
    ; assignment, a `typeof` query's name, and an export specifier. ★The
    ; disjunction's shape matters — the two access arms compare the PARENT's
    ; expression with this node by identity, so `E.A` licenses `E` and `x[E]`
    ; does not.
    ;
    ; ★★ THE SECOND HALF IS DEAD UNDER THIS HARNESS AND IS SAID SO RATHER THAN
    ; WRITTEN: `IsolatedModules.IsTrue() || VerbatimModuleSyntax.IsTrue() && …`,
    ; and both are unset here (get_isolated_modules' note). What it needs beyond
    ; the flag is `program.GetProjectReferenceFromOutputDts` — a PROGRAM question,
    ; and tests/oracle/types.go's program is a stub by construction, so the arm
    ; has no input on either side of the comparison.
    procedure check_const_enum_access(this, node: ref[AstNode], t: ref[Type])
    {
        let parent AstNode.parent_node_of(node)
        let pk Checker.kind_or_unknown(parent)
        var ok false
        if pk = KindPropertyAccessExpression
        {
            if AstNode.expression_of(parent) = node
                set ok: true
        }
        if pk = KindElementAccessExpression
        {
            if AstNode.expression_of(parent) = node
                set ok: true
        }
        let k AstNode.kind_of(node)
        if (k = KindIdentifier) or (k = KindQualifiedName)
        {
            if Checker.is_in_right_side_of_import_or_export_assignment(node)
                set ok: true
        }
        if pk = KindTypeQuery
        {
            if AstNode.type_query_expr_name_of(parent) = node
                set ok: true
        }
        if pk = KindExportSpecifier
            set ok: true
        if ok = false
            this.error_on_node(node, DiagX_const_enums_can_only_be_used_in_property_or_index_access_expressions_or_the_right_hand_side_of_an_import_declaration_or_export_assignment_or_type_query)
        ; the second half: an ambient const enum under isolatedModules, or under
        ; verbatimModuleSyntax when the usage does not resolve to an import
        ; (project-reference redirects are not ported: the redirect is nil)
        var check_ambient isolated_modules
        if (check_ambient = false) and verbatim_module_syntax and ok
        {
            let first Checker.get_first_identifier(node)
            if first <> null
            {
                let unported_before this.unported_mark()
                let alias this.resolve_name(node, AstNode.identifier_text_of(first as ref[AstNode]), SymbolFlagsAlias, 0, false, true)
                if this.unported_mark() <> unported_before
                    return
                if alias = null
                    set check_ambient: true
            }
        }
        if check_ambient and (t.symbol <> null)
        {
            let ced Symbol.value_declaration_of(t.symbol as ref[Symbol])
            if ced <> null
            {
                if ((AstNode.flags_of(ced as ref[AstNode]) & NodeFlagsAmbient) <> 0) and (this.is_valid_type_only_alias_use_site(node) = false) and (this.redirect_preserves_const_enums(ced as ref[AstNode]) = false)
                    this.error_on_node(node, DiagCannot_access_ambient_const_enums_when_0_is_enabled, this.isolated_modules_like_flag_name())
            }
        }
    }

    ; isConstEnumObjectType + isConstEnumSymbol, both whole and both one line.
    function is_const_enum_object_type(t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsAnonymous) = 0
            return false
        let sym t.symbol
        if sym = null
            return false
        (Symbol.flags_of(sym as ref[Symbol]) & SymbolFlagsConstEnum) <> 0
    }

    ; checkExpressionCached — the MEMO, and it is deliberately not one.
    ;
    ; ★★★ WHAT THE CACHE BUYS IS EXACTLY WHAT NOTHING HERE CAN OBSERVE YET, and the
    ; reader that changes that is named rather than guessed at. Its body is
    ; `links.resolvedType == nil` around a checkExpressionEx, with the flow-loop
    ; stack and the flow type cache saved and cleared across the call — neither of
    ; which exists here, because nothing in this port does flow analysis. A memo's
    ; only OBSERVABLE effect on a C section is a diagnostic reported twice when the
    ; same node is checked twice, and every arm this slice ports either answers a
    ; type in silence or reports unported; the first arm that writes an error into
    ; the C section (checkIdentifier's TS2304 is the nearest) is the arm that owes
    ; this function its links table.
    ;
    ; ★ It is `checkExpressionCachedEx(node, CheckModeNormal)`, which is the
    ; reference's own body — and since slice 88 that call reaches a real memo. The
    ; account of why it had to, and of the one shape that forced it, is at
    ; check_expression_cached_ex.
    procedure check_expression_cached(this, node: ref[AstNode]) returns ref[Type]?
        this.check_expression_cached_ex(node, CheckModeNormal)

    ; ★★★ checkExpressionWorker. THREE OF THE FORTY-SIX `case` LABELS ARE PORTED
    ; and the fourth thing ported is the switch's DEFAULT, which is not a case at
    ; all: `return c.errorType` for a kind the switch does not name. That default
    ; matters more than it looks — every expression kind this port will never see
    ; in expression position answers `any` through it, exactly as upstream.
    ;
    ; ★★★ WHY THESE THREE. A ported arm needs a type this port can MAKE, and the
    ; intrinsic table (see initialize_intrinsic_types) holds every widening and
    ; keyword type and no literal type at all: `null` and an omitted element
    ; answer nullWideningType and undefinedWideningType, a parenthesised expression
    ; answers its operand's type — one line in the reference and a recursion here —
    ; and the default answers errorType. The literal arms are the FIRST thing the
    ; next slice needs and they are one mechanism, not five: newLiteralType, a value
    ; payload on Type, the fresh/regular pair, three intern tables, and — the part
    ; that reaches outside the checker — type_to_string composing a NAME instead of
    ; answering a static string, which its own header already names as the arm that
    ; widens it to a builder.
    ;
    ; ★★ THE TWO LITERAL GRAMMAR CHECKS ARE PORTED ANYWAY, ahead of the types they
    ; stand in front of, because they are reached BEFORE the type in the reference's
    ; own order and neither needs one. Both are complete; neither can put a line
    ; into a C section, and the two reasons are different — see each at its site.
    ; They are ported rather than deferred so the numeric arm's stop names the TYPE
    ; and not a grammar check that would then have to be re-decided under it.
    ;
    ; ★ THE TAG IS THE REFERENCE FUNCTION'S NAME AND THE DETAIL IS THE KIND, even
    ; where the kind is implied by the tag (`check-identifier` is only ever asked
    ; about an Identifier). Two arms need the detail to tell them apart —
    ; checkCallExpression serves both CallExpression and NewExpression, checkAssertion
    ; both TypeAssertionExpression and AsExpression — and a column that is uniform
    ; is worth more than eight saved zeroes.
    ; ── slice 91: the IDENTIFIER ─────────────────────────────────────────────
    ;
    ; ★ ast.GetAssignmentTarget MOVED TO binder.scaly IN SLICE 92. Its second
    ; reader is bindBinaryExpressionFlow (`IsAssignmentOperator(op) &&
    ; !IsAssignmentTarget(node)`), and the binder is declared before the checker.
    ; It does not go to ast.scaly with its neighbour above, because it asks
    ; `Parser.is_assignment_operator` and `ast` is declared before `parser` — the
    ; one place where this port's module order and the reference's file layout
    ; disagree, and the binder is where they meet.

    ; getAssignmentTargetKind. ★The reference's default arm PANICS ("Unhandled
    ; case"); it is unreachable by construction — the target can only be one of the
    ; four kinds GetAssignmentTarget returns — so the fall-through answers None
    ; rather than reporting, the way try_get_declared_type_of_symbol's tail does.
    function get_assignment_target_kind(node: ref[AstNode]) returns int
    {
        let target Binder.get_assignment_target(node)
        if target = null
            return AssignmentKindNone
        let t target as ref[AstNode]
        let k AstNode.kind_of(t)
        if k = KindBinaryExpression
        {
            let op AstNode.binary_operator_kind(t)
            if op = KindEqualsToken
                return AssignmentKindDefinite
            if Binder.is_logical_or_coalescing_assignment_operator(op)
                return AssignmentKindDefinite
            return AssignmentKindCompound
        }
        if k = KindPrefixUnaryExpression
            return AssignmentKindCompound
        if k = KindPostfixUnaryExpression
            return AssignmentKindCompound
        if k = KindForInStatement
            return AssignmentKindDefinite
        if k = KindForOfStatement
            return AssignmentKindDefinite
        AssignmentKindNone
    }

    ; isCompoundLikeAssignment / isInCompoundLikeAssignment.
    function is_compound_like_assignment(assignment: ref[AstNode]) returns bool
    {
        let right Parser.skip_parentheses(AstNode.binary_right_of(assignment))
        if Checker.kind_or_unknown(right) <> KindBinaryExpression
            return false
        Checker.is_shift_operator_or_higher(AstNode.binary_operator_kind(right as ref[AstNode]))
    }

    function is_in_compound_like_assignment(node: ref[AstNode]) returns bool
    {
        let target Binder.get_assignment_target(node)
        if target = null
            return false
        let t target as ref[AstNode]
        if Checker.is_assignment_expression_excluding_compound(t) = false
            return false
        Checker.is_compound_like_assignment(t)
    }

    ; ast.IsThisInTypeQuery. The `for` climbs the LEFT spine of a qualified name,
    ; which is what makes `typeof this.a.b` answer true at the `this`.
    ;
    ; ★★★ ITS FIRST TERM IS `IsThisIdentifier`, WHICH IS AN IDENTIFIER WHOSE TEXT
    ; IS `this` AND NOT THE `this` KEYWORD. The two are different nodes and the
    ; distinction is the whole reason this line sits inside checkIdentifier: a
    ; ThisKeyword never reaches here — check_expression dispatches it to
    ; check-this-expression one level up — so a kind test against KindThisKeyword
    ; would make the branch DEAD. The identifier spelling is what a type query
    ; produces, because `typeof this.a` parses its head as an EntityName.
    function is_this_in_type_query(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindIdentifier
            return false
        if Checker.node_text_is(AstNode.identifier_text_of(node), "this") = false
            return false
        var n node
        while true
        {
            let parent AstNode.parent_node_of(n)
            if parent = null
                return false
            let pn parent as ref[AstNode]
            if AstNode.kind_of(pn) <> KindQualifiedName
                return AstNode.kind_of(pn) = KindTypeQuery
            if AstNode.qualified_left_of(pn) <> n
                return AstNode.kind_of(pn) = KindTypeQuery
            set n: pn
        }
        false
    }

    ; isInPropertyInitializerOrClassStaticBlock — FindAncestorOrQuit written as the
    ; walk it is (§3.9d), with its THREE verdicts kept apart: a hit answers true, a
    ; QUIT answers false immediately, and everything else climbs.
    function is_in_property_initializer_or_class_static_block(node: ref[AstNode], ignore_arrow_functions: bool) returns bool
    {
        var n: ref[AstNode]? node
        while n <> null
        {
            let c n as ref[AstNode]
            let k AstNode.kind_of(c)
            if k = KindPropertyDeclaration
                return true
            if k = KindClassStaticBlockDeclaration
                return true
            if k = KindTypeQuery
                return false
            if k = KindJsxClosingElement
                return false
            if k = KindArrowFunction
            {
                if ignore_arrow_functions = false
                    return false
            }
            if k = KindBlock
            {
                let parent AstNode.parent_node_of(c)
                if parent <> null
                {
                    if AstNode.is_function_like_declaration(parent as ref[AstNode])
                    {
                        if AstNode.kind_of(parent as ref[AstNode]) <> KindArrowFunction
                            return false
                    }
                }
            }
            set n: AstNode.parent_node_of(c)
        }
        false
    }

    ; getDeclarationNodeFlagsFromSymbol.
    function get_declaration_node_flags_from_symbol(s: ref[Symbol]) returns int
    {
        let vd Symbol.value_declaration_of(s)
        if vd = null
            return 0
        Binder.combined_node_flags(vd as ref[AstNode])
    }

    ; getDeclarationModifierFlagsFromSymbol, the isWrite-false form.
    ;
    ; ★★★ THE SYNTHETIC BRANCH WAS A REPORT UNTIL SLICE 151 AND ITS NOTE WAS AN
    ; EXPIRED ONE (§3.5eo). It read *a synthesized property is made by the
    ; union/intersection machinery, which nothing here builds* — slice 94 gave the
    ; port unions and the create_union_or_intersection_property machinery sets
    ; ContainsPublic/ContainsPrivate/ContainsStatic itself, which is what the branch
    ; reads. It is pure flag arithmetic over CheckFlags, needs nothing, and the
    ; second half of the note was the honest part: answering 0 LOSES a `static` and
    ; picks `public` over `protected`.
    function get_declaration_modifier_flags_from_symbol(this, s: ref[Symbol]) returns int
        this.get_declaration_modifier_flags_from_symbol_ex(s, false)

    ; getDeclarationModifierFlagsFromSymbolEx, and the isWrite half slice 96 needed.
    ;
    ; ★★ THE FLAG PICKS A DECLARATION, NOT A FILTER, and the order is the
    ; reference's: a WRITE looks for the SET accessor first, and only if there is
    ; none does the get-accessor search below run. An accessor pair can carry
    ; different modifiers on its two halves — `private set` beside a public get —
    ; so asking the wrong one is a wrong ACCESSIBILITY answer rather than a missing
    ; one.
    function get_declaration_modifier_flags_from_symbol_ex(this, s: ref[Symbol], is_write: bool) returns int
    {
        let vd Symbol.value_declaration_of(s)
        if vd = null
        {
            let cf Symbol.check_flags_of(s)
            if (cf & CheckFlagsSynthetic) <> 0
            {
                ; ★The default is PROTECTED and it is the reference's own: a
                ; synthesized property that carries neither Contains bit came out of
                ; constituents that were all protected.
                var access_modifier ModifierFlagsProtected
                if (cf & CheckFlagsContainsPrivate) <> 0
                    set access_modifier: ModifierFlagsPrivate
                else
                {
                    if (cf & CheckFlagsContainsPublic) <> 0
                        set access_modifier: ModifierFlagsPublic
                }
                var static_modifier 0
                if (cf & CheckFlagsContainsStatic) <> 0
                    set static_modifier: ModifierFlagsStatic
                return access_modifier | static_modifier
            }
            if (Symbol.flags_of(s) & SymbolFlagsPrototype) <> 0
                return ModifierFlagsPublic | ModifierFlagsStatic
            return 0
        }
        var declaration: ref[AstNode]? null
        if is_write
        {
            let n Symbol.declaration_count(s)
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(s, i)
                if d <> null
                {
                    if AstNode.kind_of(d as ref[AstNode]) = KindSetAccessor
                    {
                        set declaration: d
                        set i: n
                    }
                }
                set i: i + 1
            }
        }
        if declaration = null
        {
            if (Symbol.flags_of(s) & SymbolFlagsGetAccessor) <> 0
            {
                let n Symbol.declaration_count(s)
                var i 0
                while i < n
                {
                    let d Symbol.declaration_at(s, i)
                    if d <> null
                    {
                        if AstNode.kind_of(d as ref[AstNode]) = KindGetAccessor
                        {
                            set declaration: d
                            set i: n
                        }
                    }
                    set i: i + 1
                }
            }
        }
        if declaration = null
            set declaration: vd
        let flags b.combined_modifier_flags(declaration)
        let parent Symbol.parent_of(s)
        if parent <> null
        {
            if (Symbol.flags_of(parent as ref[Symbol]) & SymbolFlagsClass) <> 0
                return flags
        }
        flags & ~ModifierFlagsAccessibilityModifier
    }

    ; isReadonlyAssignmentDeclaration, whole. Only a CALL expression can be one —
    ; the CommonJS `Object.defineProperty(x, "p", {…})` form — and what it reads is
    ; that call's THIRD argument, the descriptor.
    ;
    ; ★★★ THE THREE ANSWERS ARE NOT SYMMETRIC AND THE ORDER IS THE FUNCTION.
    ; A descriptor carrying `value` is readonly unless it also carries a `writable`
    ; that is the literal `false` — so a MISSING `writable` means readonly, which is
    ; the CommonJS default and the opposite of what the word suggests. A descriptor
    ; with no `value` is readonly exactly when it has no `set` either, i.e. a
    ; getter-only accessor pair.
    ;
    ; ★★ THE `writable` TYPE IS READ TWO WAYS ON PURPOSE: through the property
    ; assignment's INITIALIZER where the descriptor is a literal — so the FRESH
    ; `false` survives rather than widening to `boolean` — and through
    ; getTypeOfSymbol otherwise.
    procedure is_readonly_assignment_declaration(this, node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindCallExpression
            return false
        let mark this.unported_mark()
        ; The reference INDEXES `node.Arguments()[2]`, so a shorter list is a panic
        ; there; here it is a report.
        let args AstNode.call_arguments_of(node)
        if AstNode.list_count(args) < 3
        {
            this.record_unported("property-descriptor-argument-missing", KindCallExpression)
            return false
        }
        let arg (args as ref[Array[ref[AstNode]?]])[2]
        if arg = null
        {
            this.record_unported("property-descriptor-argument-missing", KindCallExpression)
            return false
        }
        let descriptor_type this.check_expression_cached(arg as ref[AstNode])
        if this.unported_mark() <> mark
            return false
        if descriptor_type = null
            return false
        let dt descriptor_type as ref[Type]
        let value_type this.get_type_of_property_of_type(dt, "value")
        if this.unported_mark() <> mark
            return false
        if value_type = null
        {
            let set_type this.get_type_of_property_of_type(dt, "set")
            if this.unported_mark() <> mark
                return false
            return set_type = null
        }
        let writable_prop this.get_property_of_type(dt, "writable")
        if this.unported_mark() <> mark
            return false
        if writable_prop = null
            return true
        let wp writable_prop as ref[Symbol]
        var writable_type: ref[Type]? null
        let vd Symbol.value_declaration_of(wp)
        var through_the_initializer false
        if vd <> null
        {
            if AstNode.kind_of(vd as ref[AstNode]) = KindPropertyAssignment
                set through_the_initializer: true
        }
        if through_the_initializer
        {
            let ini AstNode.initializer_of(vd as ref[AstNode])
            if ini = null
                return false
            set writable_type: this.check_expression(ini as ref[AstNode])
        }
        else
            set writable_type: this.get_type_of_symbol(wp)
        if this.unported_mark() <> mark
            return false
        if writable_type = null
            return false
        let wt writable_type as ref[Type]
        if (wt.flags & TypeFlagsBooleanLiteral) = 0
            return false
        Checker.literal_bool_of(wt) = false
    }

    ; isReadonlySymbol, whole — six terms, in the reference's order.
    procedure is_readonly_symbol(this, symbol: ref[Symbol]) returns bool
    {
        if (Symbol.check_flags_of(symbol) & CheckFlagsReadonly) <> 0
            return true
        let f Symbol.flags_of(symbol)
        if (f & SymbolFlagsProperty) <> 0
        {
            if (this.get_declaration_modifier_flags_from_symbol(symbol) & ModifierFlagsReadonly) <> 0
                return true
        }
        if (f & SymbolFlagsVariable) <> 0
        {
            if (Checker.get_declaration_node_flags_from_symbol(symbol) & NodeFlagsConstant) <> 0
                return true
        }
        if (f & SymbolFlagsAccessor) <> 0
        {
            if (f & SymbolFlagsSetAccessor) = 0
                return true
        }
        if (f & SymbolFlagsEnumMember) <> 0
            return true
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if this.is_readonly_assignment_declaration(d as ref[AstNode])
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; getNarrowedTypeOfSymbol — getTypeOfSymbol, and the two discriminant cases
    ; WHOLE since slice 150.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE CALLED BOTH CASES UNREACHABLE, AND BOTH OF ITS
    ; PREMISES HAD EXPIRED — §3.5eo, eleventh harvest. It read *the binding-element
    ; one narrows a PATTERN as a pseudo-reference through getFlowTypeOfReferenceEx
    ; — the flow graph — and the parameter one needs getContextualSignature and an
    ; inference context*: the flow walk arrived in slice 93 and slice 123 finished
    ; it, getContextualSignature in slice 100 and the inference context in slice
    ; 122. Every mechanism the note named was in the file when the row was read,
    ; and nothing under either arm had to be built bar NodeLink's fifth boolean.
    ;
    ; ★★ THE TWO CASES ARE ONE MECHANISM SEEN TWICE, which is why they share this
    ; function upstream: a SYNTHETIC reference — the binding pattern, the arrow
    ; function — is narrowed at the identifier's own location, and the element's
    ; type is then recomputed out of the narrowed parent, by DESTRUCTURING in the
    ; first case and by INDEXING the narrowed tuple in the second.
    ;
    ; ★★★ EACH ARM'S GUARDED REGION IS A FUNCTION OF ITS OWN, and that is §3.5ge
    ; applied rather than re-learned: the binding-element arm SETS a re-entrancy
    ; bit on the pattern's parent, and an early return out of the region with the
    ; bit still standing is the same defect as a return out of a pushed type
    ; resolution — it would silence every later narrowing of that declaration.
    ; With the region behind a call there is exactly one place the bit is cleared.
    procedure get_narrowed_type_of_symbol(this, symbol: ref[Symbol], location: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t0 this.get_type_of_symbol(symbol)
        if this.unported_mark() <> mark
            return t0
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
            return t0
        let declaration vd as ref[AstNode]
        let dk AstNode.kind_of(declaration)
        if dk = KindBindingElement
        {
            if AstNode.initializer_of(declaration) <> null
                return t0
            if AstNode.dot_dot_dot_token_of(declaration) <> null
                return t0
            let pattern_opt AstNode.parent_node_of(declaration)
            if pattern_opt = null
                return t0
            let pattern pattern_opt as ref[AstNode]
            if AstNode.list_count(AstNode.elements_of(pattern)) < 2
                return t0
            ; `declaration.Parent.Parent` — the pattern's own parent is the
            ; VariableDeclaration, the Parameter or the outer BindingElement, and it
            ; is what both getRootDeclaration and the node link are asked about.
            let parent_opt AstNode.parent_node_of(pattern)
            if parent_opt = null
                return t0
            let parent parent_opt as ref[AstNode]
            let root_opt Binder.get_root_declaration(parent)
            if root_opt = null
                return t0
            let root root_opt as ref[AstNode]
            let rk AstNode.kind_of(root)
            ; *a const variable, or a parameter* — the second disjunct carries no
            ; constness test of its own because a parameter without assignments is
            ; const-LIKE, and that is what isSomeSymbolAssigned asks below.
            var take false
            if rk = KindVariableDeclaration
            {
                ; getCombinedNodeFlagsCached, whose one-entry memo is skipped with
                ; its argument for the reason is_const_variable's line gives.
                if (Binder.combined_node_flags(root) & NodeFlagsConstant) <> 0
                    set take: true
            }
            if rk = KindParameter
                set take: true
            if take = false
                return t0
            let links this.node_link_of(parent)
            if links.in_check_identifier
                return t0
            set links.in_check_identifier: true
            let narrowed this.narrowed_type_of_binding_element(declaration, pattern, parent, root, location)
            set links.in_check_identifier: false
            if narrowed = null
                return t0
            return narrowed
        }
        if dk = KindParameter
        {
            if AstNode.type_of(declaration) <> null
                return t0
            if AstNode.initializer_of(declaration) <> null
                return t0
            if AstNode.dot_dot_dot_token_of(declaration) <> null
                return t0
            let fn_opt AstNode.parent_node_of(declaration)
            if fn_opt = null
                return t0
            let fn fn_opt as ref[AstNode]
            if AstNode.list_count(AstNode.parameters_of(fn)) < 2
                return t0
            if this.is_context_sensitive_function_or_object_literal_method(fn) = false
                return t0
            if this.unported_mark() <> mark
                return t0
            let narrowed this.narrowed_type_of_parameter(declaration, fn, location)
            if narrowed = null
                return t0
            return narrowed
        }
        t0
    }

    ; getNarrowedTypeOfSymbol's BINDING-ELEMENT region, behind a call for the
    ; reason written at the caller. Answers null for *no narrowing*, which is the
    ; reference's *leave `t` as getTypeOfSymbol gave it*.
    ;
    ; ★★ THE PSEUDO-REFERENCE IS THE PATTERN AND THE DECLARED TYPE IS ITS PARENT'S
    ; CONSTRAINT, mapped constituent by constituent: a union of object types is
    ; what makes a binding element a discriminant, and a type PARAMETER whose
    ; constraint is such a union has to reach the same arm, which is what mapType
    ; over getBaseConstraintOrType is for.
    ;
    ; ★ The tuple bounds check is DISABLED on the way back, and the reference says
    ; why: the narrowed parent may have lower arity than the declared one, so for
    ; `[x, y]: [1, 2] | [3]` the narrowed `[3]` is a legitimate parent for a
    ; declaration naming two elements.
    procedure narrowed_type_of_binding_element(this, declaration: ref[AstNode], pattern: ref[AstNode], parent: ref[AstNode], root: ref[AstNode], location: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let parent_type this.get_type_for_binding_element_parent(parent, CheckModeNormal)
        if this.unported_mark() <> mark
            return null
        if parent_type = null
            return null
        let constraint this.map_type(parent_type as ref[Type], MapTypeKindBaseConstraintOrType, null)
        if this.unported_mark() <> mark
            return null
        if constraint = null
            return null
        let pc constraint as ref[Type]
        if (pc.flags & TypeFlagsUnion) = 0
            return null
        if AstNode.kind_of(root) = KindParameter
        {
            let assigned this.is_some_symbol_assigned(root)
            if this.unported_mark() <> mark
                return null
            if assigned
                return null
        }
        let narrowed this.get_flow_type_of_reference_ex(pattern, pc, pc, null, Checker.get_flow_node_of_node(location))
        if this.unported_mark() <> mark
            return null
        if narrowed = null
            return null
        let nt narrowed as ref[Type]
        if (nt.flags & TypeFlagsNever) <> 0
            return never_type
        this.get_binding_element_type_from_parent_type(declaration, nt, true)
    }

    ; getNarrowedTypeOfSymbol's PARAMETER region. The contextual signature has to
    ; be a single REST parameter of a union of tuples — `(...args: [kind: 'A',
    ; payload: number] | [kind: 'B', payload: string]) => void` — and then the
    ; arrow function itself is the pseudo-reference and the parameter's own type is
    ; the narrowed tuple indexed at the parameter's position.
    ;
    ; ★★ THE INDEX IS THE PARAMETER'S POSITION MINUS A `this` PARAMETER, because a
    ; declared `this` is not an element of the contextual tuple. parameter_index_of
    ; answers -1 for a node its parent's list does not hold, and an out-of-range
    ; numeric name answers nothing rather than an element, so the shape needs no
    ; guard of its own — but the region does not run at all for a signature whose
    ; parameters this function was not asked about.
    procedure narrowed_type_of_parameter(this, declaration: ref[AstNode], fn: ref[AstNode], location: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let cs this.get_contextual_signature(fn)
        if this.unported_mark() <> mark
            return null
        if cs = null
            return null
        let sig cs as ref[Signature]
        if sig.parameters = null
            return null
        let sps sig.parameters as ref[Array[ref[Symbol]?]]
        if (sps.get_length() as int) <> 1
            return null
        if Checker.signature_has_rest_parameter(sig) = false
            return null
        let rest_symbol sps[0]
        if rest_symbol = null
            return null
        ; `context.nonFixingMapper` — the READING mapper, so asking for the rest
        ; parameter's type here cannot fix an inference the caller is still making.
        var mapper: ref[TypeMapper]? null
        let context this.get_inference_context(fn)
        if this.unported_mark() <> mark
            return null
        if context <> null
            set mapper: (context as ref[InferenceContext]).non_fixing_mapper
        let declared this.get_type_of_symbol(rest_symbol as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        let instantiated this.instantiate_type(declared, mapper)
        if this.unported_mark() <> mark
            return null
        if instantiated = null
            return null
        let reduced this.get_reduced_apparent_type(instantiated as ref[Type])
        if this.unported_mark() <> mark
            return null
        if reduced = null
            return null
        let rt reduced as ref[Type]
        if (rt.flags & TypeFlagsUnion) = 0
            return null
        if this.every_type_is_tuple(rt) = false
            return null
        ; core.Some(fn.Parameters(), c.isSomeSymbolAssigned) — one assignment to any
        ; parameter of the list and none of them is const-like any more.
        let params AstNode.parameters_of(fn)
        let n AstNode.list_count(params)
        var i 0
        while i < n
        {
            let p AstNode.child_in_list(params, i)
            if p <> null
            {
                let assigned this.is_some_symbol_assigned(p as ref[AstNode])
                if this.unported_mark() <> mark
                    return null
                if assigned
                    return null
            }
            set i: i + 1
        }
        let narrowed this.get_flow_type_of_reference_ex(fn, rt, rt, null, Checker.get_flow_node_of_node(location))
        if this.unported_mark() <> mark
            return null
        if narrowed = null
            return null
        var index Checker.parameter_index_of(fn, declaration)
        if Checker.get_this_parameter(fn) <> null
            set index: index - 1
        this.get_indexed_access_type(narrowed as ref[Type], this.get_number_literal_type(Checker.number_bits_from_int(index)))
    }

    ; The FLOWPIN's one writer. Behind record_events like the pin logs: TypeDump is
    ; its only reader, and on vs/editor it was four million rows.
    procedure trace_flow(this, kind: int, a: int, b: int)
    {
        if record_events = false
            return
        let ev &FlowTraceEvent^host(kind, a, b)
        flow_trace.add(ev as ref[FlowTraceEvent])
    }

    ; ══ slice 93 — THE FLOW WALK ═══════════════════════════════════════════
    ;
    ; getFlowTypeOfReference and the graph walk under it: the checker's walk
    ; BACKWARD through the graph slice 92 built, and the row slice 92 named as its
    ; successor. Its two callers are `flow-graph 79` (checkIdentifier's tail) and
    ; `flow-graph 264` (checkPropertyInitialization); only the first is wired
    ; here, and the reason is at the caller.
    ;
    ; ★★★ WHAT THIS SLICE DOES **NOT** PORT IS ONE THING WEARING SEVEN NAMES, AND
    ; NAMING IT ONCE IS WORTH MORE THAN SEVEN STOPS: `getUnionType`. A branch
    ; label unions its antecedents, a loop label unions them again through a
    ; cache keyed on a reference HASH, `getOptionalType` unions with undefined,
    ; `getAssignmentReducedType` reduces one, the evolving-array family builds one
    ; per element, and narrowType's whole job is to produce one. The seven stops
    ; below are seven doors into that room. ★It is why the class caller cannot be
    ; wired: isPropertyInitializedInConstructor's initial type is
    ; `getOptionalType(propType, false)`.
    ;
    ; ★★ WHAT DOES ANSWER, THEN, AND IT IS NOT A REMNANT: the reference of a
    ; variable whose declared type is not a union, reached over straight-line
    ; flow, over an assignment to itself, over a junction whose antecedents agree,
    ; or from the top of its own container. That is the shape most code has.

    ; ast.IsAssignmentExpression(node, excludeCompoundAssignment: FALSE) — the
    ; second polarity, and the one isMatchingReference's target arm asks for. The
    ; first is already in this file under its own name; the two differ by exactly
    ; the compound operators, so they are two functions rather than one with a
    ; flag, which is §3.9e's treatment of the same shape.
    function is_assignment_expression_including_compound(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindBinaryExpression
            return false
        if Parser.is_assignment_operator(AstNode.binary_operator_kind(node)) = false
            return false
        Parser.is_left_hand_side_expression_kind(Checker.kind_or_unknown(AstNode.binary_left_of(node)))
    }

    ; ast.IsFunctionExpressionOrArrowFunction.
    function is_function_expression_or_arrow_function(node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindFunctionExpression
            return true
        k = KindArrowFunction
    }

    ; getFlowNodeOfNode. Slice 92's finding five measured the `FlowNodeData() !=
    ; nil` guard VACUOUS in this port — every node carries the slot — so what is
    ; left of the function is the slot read, and the guard is not written.
    function get_flow_node_of_node(node: ref[AstNode]?) returns ref[FlowNode]?
        AstNode.flow_node_of(node)

    ; convertAutoToAny. The autoArrayType arm CANNOT BE ASKED here and that is a
    ; containment proof rather than an omission: `c.autoArrayType` is
    ; `createArrayType(c.autoType)`, which needs the global `Array` symbol, which
    ; is the globals table (§3.11). Nothing in this port mints it, so no type in
    ; the run is equal to it, so the arm is written as the sentence you are
    ; reading.
    ; convertAutoToAny. The auto type is the control-flow tracked `any` that
    ; get_type_for_variable_like_declaration hands out for an un-annotated `var`,
    ; and its ARRAY TWIN; everything the outside world sees is the ordinary any.
    ;
    ; ★★★ THE ARRAY ARM WAS DEAD FOR THE §3.5dm REASON AND SLICE 141'S DUPLICATE
    ; SCAN IS WHAT FOUND IT: this function was defined TWICE — here, without the
    ; arm, and 25 000 lines below WITH it — and the planner keeps the FIRST, so
    ; every caller ran this body and the richer one was unreachable. It is not a
    ; cosmetic difference: `autoArrayType` and `anyArrayType` both PRINT as `any[]`,
    ; so no yardstick could see it, while the two are compared by IDENTITY at the
    ; sites that ask whether a declared type is still evolving. **The scan is three
    ; lines and it belongs at the end of every slice** (CLAUDE-lessons.md §3.5dx).
    procedure convert_auto_to_any(this, t: ref[Type]?) returns ref[Type]?
    {
        if t = null
            return null
        let ty t as ref[Type]
        if ty = auto_type
            return any_type
        let aat this.get_auto_array_type()
        if aat <> null
        {
            if ty = (aat as ref[Type])
            {
                let at this.get_any_array_type()
                if at <> null
                    return at
            }
        }
        ty
    }

    ; c.flowNodeReachable[flow] — the LOOKUP, and it is deliberately not the
    ; mint-on-miss reader the other six tables in this file use. Those answer a
    ; row whose fields start empty and mean *not yet computed*; this one's payload
    ; is a BOOL, where an absent row and a row holding false are different facts
    ; and a mint-on-miss reader could not tell them apart.
    function flow_reachable_lookup(this, flow: ref[FlowNode]) returns ref[FlowReachableLink]?
    {
        let ix flow_node_reachable_index
        let at ix.find(flow as int)
        if at > 0
        {
            let row flow_node_reachable[at - 1]
            if row <> null
                return row as ref[FlowReachableLink]
        }
        null
    }

    ; getBranchLabelAntecedents — the reduce-label stack read from the HEAD, which
    ; is the reference's backward walk over its array; see ReduceLabelStack's own
    ; note for why the head is the last push.
    function get_branch_label_antecedents(flow: ref[FlowNode], reduce_labels: ref[ReduceLabelStack]?) returns ref[FlowList]?
    {
        var cur reduce_labels
        while cur <> null
        {
            let c cur as ref[ReduceLabelStack]
            if AstNode.flow_reduce_target_of(c.data) = flow
                return AstNode.flow_reduce_antecedents_of(c.data)
            set cur: c.next
        }
        flow.antecedents
    }

    ; c.flowNodePostSuper[flow] — the LOOKUP, and it is flow_reachable_lookup's
    ; twin for the same reason that one is not a mint-on-miss reader: the payload
    ; is a BOOL, so an absent row and a row holding false are different facts.
    function flow_post_super_lookup(this, flow: ref[FlowNode]) returns ref[FlowPostSuperLink]?
    {
        let ix flow_node_post_super_index
        let at ix.find(flow as int)
        if at > 0
        {
            let row flow_node_post_super[at - 1]
            if row <> null
                return row as ref[FlowPostSuperLink]
        }
        null
    }

    ; isPostSuperFlowNode. The reference borrows a FlowState for the reduce-label
    ; stack and returns it; here the stack is the worker's parameter, exactly as at
    ; isReachableFlowNodeWorker, so the entry is the call.
    procedure is_post_super_flow_node(this, flow: ref[FlowNode], no_cache_check: bool) returns bool
        this.is_post_super_flow_node_worker(null, flow, no_cache_check)

    ; isPostSuperFlowNodeWorker — the fifth walk over the flow graph in this file,
    ; and the ONE that asks the checker nothing at all: every arm reads a flag, an
    ; antecedent or a node KIND, so it has no stop and cannot acquire one.
    ;
    ; ★★★ THE `default` ARM IS THE ANSWER AND NOT A FALLBACK: *unreachable nodes
    ; are considered post-super to silence errors*. A start node, a node the binder
    ; marked unreachable and anything else without one of the five flags answers
    ; `Unreachable`'s own bit — so the function says TRUE for dead code and FALSE
    ; for a live path that has not passed a `super()`. Reading it as "no evidence,
    ; so false" inverts exactly the case TS17009 exists for.
    ;
    ; ★ The Call arm is the only one that looks at a node, and it looks at the
    ; CALLEE: a flow Call node whose expression is the `super` keyword is the
    ; barrier. It needs no effects signature, which is what separates this walk from
    ; is_reachable_flow_node_worker's Call arm.
    procedure is_post_super_flow_node_worker(this, reduce_labels: ref[ReduceLabelStack]?, flow_in: ref[FlowNode], no_cache_check_in: bool) returns bool
    {
        var flow flow_in
        var no_cache_check no_cache_check_in
        repeat
        {
            let flags flow.flags
            if (flags & FlowFlagsShared) <> 0
            {
                if no_cache_check = false
                {
                    let hit this.flow_post_super_lookup(flow)
                    if hit <> null
                        return (hit as ref[FlowPostSuperLink]).post_super
                    let post_super this.is_post_super_flow_node_worker(reduce_labels, flow, true)
                    let made &FlowPostSuperLink^host(flow, post_super)
                    flow_node_post_super.add(made)
                    this.flow_node_post_super_index_last()
                    ; ★★★ THE REFERENCE DOES NOT RETURN HERE AND THIS PORT MUST NOT
                    ; EITHER. It caches and falls through with noCacheCheck cleared,
                    ; so the loop below recomputes the same node's answer once — a
                    ; difference from is_reachable_flow_node_worker, which RETURNS
                    ; the memoised value at the same place. Returning early is the
                    ; obvious tidy-up and it is a divergence: the two functions
                    ; differ here in upstream, and the second pass is what leaves
                    ; the walk positioned on the antecedent chain.
                }
                set no_cache_check: false
            }
            var advance false
            if (flags & (FlowFlagsAssignment | FlowFlagsCondition | FlowFlagsArrayMutation | FlowFlagsSwitchClause)) <> 0
                set advance: true
            if advance = false
            {
                if (flags & FlowFlagsCall) <> 0
                {
                    if Checker.kind_or_unknown(AstNode.expression_of(flow.node as ref[AstNode])) = KindSuperKeyword
                        return true
                    set advance: true
                }
            }
            if advance = false
            {
                if (flags & FlowFlagsBranchLabel) <> 0
                {
                    ; A branch point is post-super only if EVERY branch is, where
                    ; reachability asks whether ANY is — the two walks differ in the
                    ; quantifier and in nothing else at this arm.
                    var list Checker.get_branch_label_antecedents(flow, reduce_labels)
                    while list <> null
                    {
                        let l list as ref[FlowList]
                        if l.flow <> null
                        {
                            if this.is_post_super_flow_node_worker(reduce_labels, l.flow as ref[FlowNode], false) = false
                                return false
                        }
                        set list: l.next
                    }
                    return true
                }
            }
            if advance = false
            {
                if (flags & FlowFlagsLoopLabel) <> 0
                {
                    ; "A loop is post-super if the control flow path that leads to
                    ; the top is post-super."
                    let ants flow.antecedents
                    if ants = null
                        return false
                    set flow: (ants as ref[FlowList]).flow as ref[FlowNode]
                    continue
                }
            }
            if advance = false
            {
                if (flags & FlowFlagsReduceLabel) <> 0
                {
                    let cell &ReduceLabelStack^host(flow.node, reduce_labels)
                    return this.is_post_super_flow_node_worker(cell, flow.antecedent as ref[FlowNode], false)
                }
            }
            if advance = false
                return (flags & FlowFlagsUnreachable) <> 0
            set flow: flow.antecedent as ref[FlowNode]
        }
    }

    ; isReachableFlowNode. The one-entry cache is written here rather than in the
    ; worker, exactly as upstream: the worker recurses and would otherwise
    ; overwrite the entry with an inner question's answer.
    procedure is_reachable_flow_node(this, flow: ref[FlowNode]) returns bool
    {
        let result this.is_reachable_flow_node_worker(null, flow, false)
        set last_flow_node: flow
        set last_flow_node_reachable: result
        result
    }

    ; isReachableFlowNodeWorker. A pure walk over the GRAPH — no type is asked for
    ; anywhere in it except through getEffectsSignature, which is a stop — so this
    ; is the half of the flow chapter that needs nothing the checker cannot
    ; already answer.
    ;
    ; ★ The reference takes a `*FlowState` and reads exactly one field of it; the
    ; stack itself is the parameter here.
    procedure is_reachable_flow_node_worker(this, reduce_labels: ref[ReduceLabelStack]?, flow_in: ref[FlowNode], no_cache_check_in: bool) returns bool
    {
        var flow flow_in
        var no_cache_check no_cache_check_in
        repeat
        {
            if last_flow_node <> null
            {
                if (last_flow_node as ref[FlowNode]) = flow
                    return last_flow_node_reachable
            }
            let flags flow.flags
            if (flags & FlowFlagsShared) <> 0
            {
                if no_cache_check = false
                {
                    let hit this.flow_reachable_lookup(flow)
                    if hit <> null
                        return (hit as ref[FlowReachableLink]).reachable
                    let reachable this.is_reachable_flow_node_worker(reduce_labels, flow, true)
                    let made &FlowReachableLink^host(flow, reachable)
                    flow_node_reachable.add(made)
                    this.flow_node_reachable_index_last()
                    return reachable
                }
                set no_cache_check: false
            }
            var advance false
            if (flags & (FlowFlagsAssignment | FlowFlagsCondition | FlowFlagsArrayMutation)) <> 0
                set advance: true
            if advance = false
            {
                if (flags & FlowFlagsCall) <> 0
                {
                    ; getEffectsSignature — the assertion half of the graph.
                    ;
                    ; ★★★ THE NOTE THAT STOOD HERE CALLED IT *THE FIRST OF THIS
                    ; SLICE'S SEVEN DOORS*, AND SLICE 123 OPENED IT. Every function
                    ; the arm needs — get_effects_signature,
                    ; get_type_predicate_of_signature, is_false_expression and
                    ; get_return_type_of_signature — has been in the file since the
                    ; narrowing engine landed, and nothing re-read the sentence.
                    ; §3.5eo; the frontier ranked the row at +119 over 424 units.
                    ;
                    ; ★ The two ENDING branches are what the old note was right
                    ; about, and they are the whole content: an `asserts x` whose
                    ; argument is provably false, and a callee whose return type is
                    ; never, both answer UNREACHABLE. Everything else falls through
                    ; to the antecedent.
                    let mark this.unported_mark()
                    let signature this.get_effects_signature(flow.node as ref[AstNode])
                    if this.unported_mark() <> mark
                        return true
                    if signature <> null
                    {
                        let sig signature as ref[Signature]
                        let node flow.node as ref[AstNode]
                        let predicate this.get_type_predicate_of_signature(sig)
                        if this.unported_mark() <> mark
                            return true
                        if predicate <> null
                        {
                            let p predicate as ref[TypePredicate]
                            ; `predicate.t == nil` is the un-annotated `asserts x`,
                            ; the only shape whose falsity can be read off the
                            ; ARGUMENT rather than off a type.
                            if p.kind = TypePredicateKindAssertsIdentifier
                            {
                                if p.t = null
                                {
                                    if p.parameter_index >= 0
                                    {
                                        let args AstNode.call_arguments_of(node)
                                        if p.parameter_index < AstNode.list_count(args)
                                        {
                                            let arg AstNode.child_in_list(args, p.parameter_index)
                                            if arg <> null
                                            {
                                                if this.is_false_expression(arg as ref[AstNode])
                                                    return false
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        let rt this.get_return_type_of_signature(sig)
                        if this.unported_mark() <> mark
                            return true
                        if rt <> null
                        {
                            if ((rt as ref[Type]).flags & TypeFlagsNever) <> 0
                                return false
                        }
                    }
                    set advance: true
                }
            }
            if advance = false
            {
                if (flags & FlowFlagsBranchLabel) <> 0
                {
                    ; "A branching point is reachable if any branch is reachable."
                    var list Checker.get_branch_label_antecedents(flow, reduce_labels)
                    while list <> null
                    {
                        let l list as ref[FlowList]
                        if l.flow <> null
                        {
                            if this.is_reachable_flow_node_worker(reduce_labels, l.flow as ref[FlowNode], false)
                                return true
                        }
                        set list: l.next
                    }
                    return false
                }
            }
            if advance = false
            {
                if (flags & FlowFlagsLoopLabel) <> 0
                {
                    let ants flow.antecedents
                    if ants = null
                        return false
                    ; "A loop is reachable if the control flow path that leads to
                    ; the top is reachable" — the FIRST antecedent, which slice
                    ; 92's h12 measured to be the non-looping one by construction.
                    set flow: (ants as ref[FlowList]).flow as ref[FlowNode]
                    continue
                }
            }
            if advance = false
            {
                if (flags & FlowFlagsSwitchClause) <> 0
                {
                    ; "The control flow path representing an unmatched value in a
                    ; switch statement with no default clause is unreachable if the
                    ; switch statement is exhaustive." WHOLE since slice 159.
                    ;
                    ; ★★★ THE ROW'S NOTE NAMED A CHAPTER THAT WAS ALREADY WRITTEN —
                    ; §3.5eo. It read *"isExhaustiveSwitchStatement … asks
                    ; getTypeOfExpression of the switch subject and compares against
                    ; every clause's literal type, i.e. the union machinery again"*,
                    ; and `is_exhaustive_switch_statement` with its three-state memo
                    ; and `compute_exhaustive_switch_statement` sit six thousand
                    ; lines below, ported with the witnesses and the clause types by
                    ; slice 123 — whose own log row lists the exhaustiveness among
                    ; what it brought.
                    ;
                    ; ★★ THE CALL NEEDS NO MARK OF ITS OWN AND THAT IS A PROPERTY OF
                    ; THE CALLEE, not a convenience: `is_exhaustive_switch_statement`
                    ; answers FALSE on a stop and restores its memo to Unknown, and
                    ; the stop is recorded inside it — so the unit is unported either
                    ; way and this walk takes the reference's own not-exhaustive
                    ; path. A mark here would report a second time for the same
                    ; absence.
                    if AstNode.flow_clause_start_of(flow.node) = AstNode.flow_clause_end_of(flow.node)
                    {
                        let sw AstNode.flow_switch_statement_of(flow.node)
                        if sw <> null
                        {
                            if this.is_exhaustive_switch_statement(sw as ref[AstNode])
                                return false
                        }
                    }
                    set advance: true
                }
            }
            if advance = false
            {
                if (flags & FlowFlagsReduceLabel) <> 0
                {
                    ; "Cache is unreliable once we start adjusting labels."
                    set last_flow_node: null
                    let cell &ReduceLabelStack^host(flow.node, reduce_labels)
                    return this.is_reachable_flow_node_worker(cell, flow.antecedent as ref[FlowNode], false)
                }
            }
            if advance = false
                return (flags & FlowFlagsUnreachable) = 0
            set flow: flow.antecedent as ref[FlowNode]
        }
    }

    ; ── the reference-matching family ───────────────────────────────────────

    ; isMatchingReference, taken to the ONE source kind this port can hand it.
    ;
    ; ★★★ THE FIVE SOURCE ARMS BELOW THE IDENTIFIER HAVE ZERO INPUT AND THAT IS A
    ; CONTAINMENT PROOF, NOT A GAP. The reference is whatever the CALLER passes,
    ; and this slice wires one caller: checkIdentifier, which passes the
    ; identifier. The other producer of a reference is
    ; isPropertyInitializedInConstructor, which synthesizes `this.p` — and it is
    ; behind getOptionalType, i.e. behind the union wall. So a property access, an
    ; element access, a qualified name and a meta property cannot arrive here
    ; until that row lands, and §3.5be says the day it lands is the day they are
    ; written. ★They are a STOP rather than a `false`, because answering false
    ; would make a real assignment invisible to the walk, silently.
    procedure is_matching_reference(this, source: ref[AstNode], target: ref[AstNode]) returns bool
    {
        let tk AstNode.kind_of(target)
        if tk = KindParenthesizedExpression
        {
            let e AstNode.expression_of(target)
            if e = null
                return false
            return this.is_matching_reference(source, e as ref[AstNode])
        }
        if tk = KindNonNullExpression
        {
            let e AstNode.expression_of(target)
            if e = null
                return false
            return this.is_matching_reference(source, e as ref[AstNode])
        }
        if tk = KindBinaryExpression
        {
            if Checker.is_assignment_expression_including_compound(target)
            {
                let l AstNode.binary_left_of(target)
                if l <> null
                {
                    if this.is_matching_reference(source, l as ref[AstNode])
                        return true
                }
            }
            if AstNode.binary_operator_kind(target) = KindCommaToken
            {
                let r AstNode.binary_right_of(target)
                if r <> null
                    return this.is_matching_reference(source, r as ref[AstNode])
            }
            return false
        }
        let sk AstNode.kind_of(source)
        if sk = KindThisKeyword
            return tk = KindThisKeyword
        if sk = KindSuperKeyword
            return tk = KindSuperKeyword
        if sk = KindNonNullExpression
        {
            let e AstNode.expression_of(source)
            if e = null
                return false
            return this.is_matching_reference(e as ref[AstNode], target)
        }
        if sk = KindParenthesizedExpression
        {
            let e AstNode.expression_of(source)
            if e = null
                return false
            return this.is_matching_reference(e as ref[AstNode], target)
        }
        if sk = KindSatisfiesExpression
        {
            let e AstNode.expression_of(source)
            if e = null
                return false
            return this.is_matching_reference(e as ref[AstNode], target)
        }
        ; The META-PROPERTY arm, slice 176. ★It needs nothing this port lacked —
        ; `keyword_token` has been on MetaPropertyData since the module indicator
        ; needed to tell `import.meta` from `new.target`, and the name is an
        ; identifier on both sides.
        if sk = KindMetaProperty
        {
            if tk <> KindMetaProperty
                return false
            if AstNode.meta_property_keyword_token_of(source) <> AstNode.meta_property_keyword_token_of(target)
                return false
            return Checker.text_equals(AstNode.identifier_text_of(AstNode.name_of(source)), AstNode.identifier_text_of(AstNode.name_of(target)))
        }
        ; ★★★ THE PROPERTY-ACCESS ARM, SLICE 94, AND IT IS THE ONE SLICE 93
        ; PREDICTED. Its note said the five arms below the identifier *"have ZERO
        ; input and that is a containment proof, not a gap ... a property access, an
        ; element access, a qualified name and a meta property cannot arrive here
        ; until that row lands, and §3.5be says the day it lands is the day they are
        ; written"*. checkPropertyInitialization is that row and it synthesizes
        ; exactly one shape — `this.p` — so exactly one of the four is written and
        ; the other three still have no producer.
        ;
        ; ★★ THE SHARED HALF IS `IsAccessExpression(target)` AND NOT
        ; `IsPropertyAccessExpression`: `this.p = x` and `this["p"] = x` initialize
        ; the same property, and the reference compares the accessed NAMES rather
        ; than the syntax. The element-access side of getAccessedPropertyName is
        ; where this port stops, so an element-access TARGET is a stop rather than a
        ; false — a wrong `false` would make a real assignment invisible to the
        ; walk, silently, which is the hazard slice 93 named for these arms.
        if sk = KindPropertyAccessExpression
        {
            if Parser.is_access_expression(target)
            {
                var source_name Slice[char]()
                if this.get_accessed_property_name(source, &source_name) = false
                    return false
                var target_name Slice[char]()
                if this.get_accessed_property_name(target, &target_name) = false
                    return false
                if source_name.length <> target_name.length
                    return false
                if Checker.text_equals(source_name, target_name) = false
                    return false
                let se AstNode.expression_of(source)
                let te AstNode.expression_of(target)
                if se = null
                    return false
                if te = null
                    return false
                return this.is_matching_reference(se as ref[AstNode], te as ref[AstNode])
            }
            return false
        }
        ; ★★ THE ELEMENT-ACCESS SOURCE ARM, SLICE 117, AND IT SHARES THE PROPERTY
        ; ACCESS'S BODY BECAUSE THE REFERENCE'S `case` DOES — the two kinds are one
        ; label there. The second half compares two element accesses by their
        ; ARGUMENT SYMBOL rather than by a name; slice 182 writes it, because the
        ; computed-name arm of checkPropertyInitialization is the producer slice
        ; 117's note said it had none.
        ;
        ; ★★★ THE NAME COMPARISON IS A FALL-THROUGH AND NOT A `return false`, AND
        ; THE DIFFERENCE IS THE WHOLE POINT OF THE SECOND HALF. Upstream returns
        ; only when BOTH sides yield an accessed name; where either does not, it
        ; drops to the argument-symbol test — which is the only thing that matches
        ; `this[b]` against `this[b]` for a `b` whose type yields no printable
        ; name. Written as a return, the port answered *not initialized* and
        ; invented a TS2564 on `[b]: number` the moment the computed-name arm
        ; started synthesizing element accesses.
        if sk = KindElementAccessExpression
        {
            var decided false
            var matched false
            var source_name Slice[char]()
            if this.get_accessed_property_name(source, &source_name)
            {
                if Parser.is_access_expression(target)
                {
                    var target_name Slice[char]()
                    if this.get_accessed_property_name(target, &target_name)
                    {
                        set decided: true
                        if source_name.length = target_name.length
                        {
                            if Checker.text_equals(source_name, target_name)
                            {
                                let se AstNode.expression_of(source)
                                let te AstNode.expression_of(target)
                                if se <> null
                                {
                                    if te <> null
                                        set matched: this.is_matching_reference(se as ref[AstNode], te as ref[AstNode])
                                }
                            }
                        }
                    }
                }
            }
            if decided
                return matched
            if tk <> KindElementAccessExpression
                return false
            let sa AstNode.element_access_argument_of(source)
            let ta AstNode.element_access_argument_of(target)
            if sa = null
                return false
            if ta = null
                return false
            if AstNode.kind_of(sa as ref[AstNode]) <> KindIdentifier
                return false
            if AstNode.kind_of(ta as ref[AstNode]) <> KindIdentifier
                return false
            let em this.unported_mark()
            let ssym this.get_resolved_symbol(sa as ref[AstNode])
            let tsym this.get_resolved_symbol(ta as ref[AstNode])
            if this.unported_mark() <> em
                return false
            if ssym <> tsym
                return false
            var usable this.is_constant_variable(ssym)
            if usable = false
            {
                if this.is_parameter_or_mutable_local_variable(ssym)
                {
                    if this.is_symbol_assigned(ssym) = false
                        set usable: true
                }
            }
            if usable = false
                return false
            let se2 AstNode.expression_of(source)
            let te2 AstNode.expression_of(target)
            if se2 = null
                return false
            if te2 = null
                return false
            return this.is_matching_reference(se2 as ref[AstNode], te2 as ref[AstNode])
        }
        ; The QUALIFIED-NAME arm, slice 176 — `A.B` on the source side against an
        ; ACCESS expression on the target side. ★The reference falls through to
        ; `false` when the target is not an access or has no accessed name, which
        ; is what the two guards below spell.
        if sk = KindQualifiedName
        {
            if Parser.is_access_expression(target) = false
                return false
            var tname Slice[char]()
            let mark this.unported_mark()
            let got this.get_accessed_property_name(target, &tname)
            if this.unported_mark() <> mark
                return false
            if got = false
                return false
            let right AstNode.qualified_right_of(source)
            if right = null
                return false
            if Checker.text_equals(AstNode.identifier_text_of(right), tname) = false
                return false
            let left AstNode.qualified_left_of(source)
            let te AstNode.expression_of(target)
            if left = null
                return false
            if te = null
                return false
            return this.is_matching_reference(left as ref[AstNode], te as ref[AstNode])
        }
        if sk = KindBinaryExpression
        {
            ; the SOURCE-side comma arm: `(f(), x).p` narrows like `x.p` does
            if AstNode.binary_operator_kind(source) <> KindCommaToken
                return false
            let r AstNode.binary_right_of(source)
            if r = null
                return false
            return this.is_matching_reference(r as ref[AstNode], target)
        }
        var is_name false
        if sk = KindIdentifier
            set is_name: true
        if sk = KindPrivateIdentifier
            set is_name: true
        if is_name = false
            return false
        if Checker.is_this_in_type_query(source)
            return tk = KindThisKeyword
        if tk = KindIdentifier
        {
            if this.get_resolved_symbol(source) = this.get_resolved_symbol(target)
                return true
        }
        var target_declares false
        if tk = KindVariableDeclaration
            set target_declares: true
        if tk = KindBindingElement
            set target_declares: true
        if target_declares = false
            return false
        let exported this.get_export_symbol_of_value_symbol_if_exported(this.get_resolved_symbol(source))
        if exported = null
            return false
        let td this.symbol_of_declaration(target)
        if td = null
            return false
        (exported as ref[Symbol]) = (td as ref[Symbol])
    }

    ; ── the FLOW REFERENCE KEY, slice 141 ───────────────────────────────────
    ;
    ; getFlowReferenceKey and writeFlowCacheKey. The header above FlowLoopCacheLink
    ; carries the decision (upstream's 128-bit xxh3 of the parts; a symbol, type
    ; or node is written as its address).

    procedure key_write_byte(this, parts: ref[Array[char]], c: char)
    {
        parts.add(c)
    }

    ; eight bytes, low first: `hashWrite64`
    procedure key_write_u64(parts: ref[Array[char]], v: u64)
    {
        var k: u64 0
        while k < 64
        {
            parts.add(((v >> k) & 255) as char)
            set k: k + 8
        }
    }

    procedure key_write_symbol(this, parts: ref[Array[char]], s: ref[Symbol])
    {
        Checker.key_write_u64(parts, s as u64)
    }

    procedure key_write_type(this, parts: ref[Array[char]], t: ref[Type])
    {
        Checker.key_write_u64(parts, t.id as u64)
    }

    procedure key_write_node(this, parts: ref[Array[char]], n: ref[AstNode])
    {
        Checker.key_write_u64(parts, n as u64)
    }

    procedure key_write_text(this, parts: ref[Array[char]], text: Slice[char])
    {
        var i: size_t 0
        while i < text.length
        {
            parts.add(text[i])
            set i: i + 1
        }
    }

    ; getFlowReferenceKey. ★★ A NULL ANSWER MEANS NON-DOTTED — the reference's
    ; `nonDottedNameCacheKey` — and it is NOT the same fact as a stop, which is why
    ; the caller takes the mark around this call. writeFlowCacheKey's `false` and a
    ; stop inside get_accessed_property_name are two different reasons for the same
    ; return value, and reading the second as the first would answer the declared
    ; type where the reference narrows (§3.5dt).
    procedure get_flow_reference_key(this, f: ref[FlowState]) returns ref[Xxh3]?
    {
        let reference_opt f.reference
        if reference_opt = null
            return null
        let declared_opt f.declared_type
        if declared_opt = null
            return null
        ; the buffer is this frame's own; only the 16-byte hash reaches the host
        let parts &Array[char]()
        if this.write_flow_cache_key(parts, reference_opt as ref[AstNode], declared_opt as ref[Type], f.initial_type, f.flow_container) = false
            return null
        let h Xxh3.hash128(parts.as_slice())
        &Xxh3^host(h.hi, h.lo)
    }

    ; writeFlowCacheKey. ★★ THE `Identifier` ARM FALLS THROUGH INTO THE
    ; `ThisKeyword` ARM upstream — a Go `fallthrough`, which is why the two are one
    ; block here: a `this` reference writes the declared type and the container
    ; with no symbol in front of it, and an identifier writes the symbol first.
    procedure write_flow_cache_key(this, parts: ref[Array[char]], node: ref[AstNode], declared_type: ref[Type], initial_type: ref[Type]?, flow_container: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(node)
        var head_written false
        if k = KindIdentifier
        {
            if Checker.is_this_in_type_query(node) = false
            {
                let symbol this.get_resolved_symbol(node)
                if symbol = unknown_symbol
                    return false
                this.key_write_symbol(parts, symbol)
            }
            set head_written: true
        }
        if k = KindThisKeyword
            set head_written: true
        if head_written
        {
            this.key_write_byte(parts, ":" as char)
            this.key_write_type(parts, declared_type)
            ; ★ `initialType != declaredType` upstream, where initialType cannot be
            ; nil — get_flow_type_of_reference_ex coalesces it to the declared type
            ; on the way in — so a null here is that same coalesce and writes
            ; nothing.
            if initial_type <> null
            {
                if (initial_type as ref[Type]) <> declared_type
                {
                    this.key_write_byte(parts, "=" as char)
                    this.key_write_type(parts, initial_type as ref[Type])
                }
            }
            if flow_container <> null
            {
                this.key_write_byte(parts, "@" as char)
                this.key_write_node(parts, flow_container as ref[AstNode])
            }
            return true
        }
        var strips false
        if k = KindNonNullExpression
            set strips: true
        if k = KindParenthesizedExpression
            set strips: true
        if strips
        {
            let e AstNode.expression_of(node)
            if e = null
                return false
            return this.write_flow_cache_key(parts, e as ref[AstNode], declared_type, initial_type, flow_container)
        }
        if k = KindQualifiedName
        {
            let left AstNode.qualified_left_of(node)
            if left = null
                return false
            if this.write_flow_cache_key(parts, left as ref[AstNode], declared_type, initial_type, flow_container) = false
                return false
            let right AstNode.qualified_right_of(node)
            if right = null
                return false
            let r right as ref[AstNode]
            this.key_write_byte(parts, "." as char)
            this.key_write_text(parts, AstNode.identifier_text_of(r))
            return true
        }
        var is_access false
        if k = KindPropertyAccessExpression
            set is_access: true
        if k = KindElementAccessExpression
            set is_access: true
        if is_access
        {
            let mark this.unported_mark()
            var name_data Slice[char]()
            if this.get_accessed_property_name(node, &name_data)
            {
                let e AstNode.expression_of(node)
                if e = null
                    return false
                if this.write_flow_cache_key(parts, e as ref[AstNode], declared_type, initial_type, flow_container) = false
                    return false
                this.key_write_byte(parts, "." as char)
                this.key_write_text(parts, name_data)
                return true
            }
            if this.unported_mark() <> mark
                return false
            ; ★ The element access by a CONSTANT SYMBOL — `a[K]` where `K` is a
            ; `const`, or a parameter or mutable local that is never assigned. The
            ; NAME is not knowable, so the key carries the symbol behind `.@`, which
            ; is upstream's own spelling.
            if k = KindElementAccessExpression
            {
                let arg AstNode.element_access_argument_of(node)
                if arg = null
                    return false
                let a arg as ref[AstNode]
                if AstNode.kind_of(a) = KindIdentifier
                {
                    let symbol this.get_resolved_symbol(a)
                    var usable this.is_constant_variable(symbol)
                    if usable = false
                    {
                        if this.is_parameter_or_mutable_local_variable(symbol)
                        {
                            if this.is_symbol_assigned(symbol) = false
                                set usable: true
                        }
                    }
                    if this.unported_mark() <> mark
                        return false
                    if usable
                    {
                        let e AstNode.expression_of(node)
                        if e = null
                            return false
                        if this.write_flow_cache_key(parts, e as ref[AstNode], declared_type, initial_type, flow_container) = false
                            return false
                        this.key_write_byte(parts, "." as char)
                        this.key_write_byte(parts, "@" as char)
                        this.key_write_symbol(parts, symbol)
                        return true
                    }
                }
            }
            return false
        }
        ; The BINDING PATTERN and the four function-like kinds: the node itself,
        ; `#`, and the declared type. ★They are keyed by NODE rather than by a
        ; dotted path because there is no name to walk — a destructuring pattern and
        ; a function are their own reference.
        var is_node_keyed false
        if k = KindObjectBindingPattern
            set is_node_keyed: true
        if k = KindArrayBindingPattern
            set is_node_keyed: true
        if k = KindFunctionDeclaration
            set is_node_keyed: true
        if k = KindFunctionExpression
            set is_node_keyed: true
        if k = KindArrowFunction
            set is_node_keyed: true
        if k = KindMethodDeclaration
            set is_node_keyed: true
        if is_node_keyed
        {
            this.key_write_node(parts, node)
            this.key_write_byte(parts, "#" as char)
            this.key_write_type(parts, declared_type)
            return true
        }
        false
    }

    ; The key comparison — upstream's `==` on two CacheHashKeys.
    function flow_key_equal(a: ref[Xxh3], b: ref[Xxh3]) returns bool
    {
        if a.hi <> b.hi
            return false
        a.lo = b.lo
    }

    ; ── c.flowLoopCache ─────────────────────────────────────────────────────
    ;
    ; ★ NOT a mint-on-miss reader: an absent row means *not computed*, and the
    ; loop label writes a row only where the junction completed.
    function flow_loop_cache_lookup(this, flow: ref[FlowNode], key: ref[Xxh3]) returns ref[Type]?
    {
        ; upstream's map lookup: the rows of this flow node through the index, the
        ; first row with an equal key answering, as the scan over all rows did
        let hit flow_loop_cache_index.find(flow as int)
        if hit = 0
            return null
        var walk: ref[FlowLoopCacheLink]? flow_loop_cache[(hit - 1) as size_t]
        while walk <> null
        {
            let r walk as ref[FlowLoopCacheLink]
            set walk: r.next_same_flow
            if r.key <> null
            {
                if Checker.flow_key_equal(r.key as ref[Xxh3], key)
                    return r.t
            }
        }
        null
    }

    procedure flow_loop_cache_put(this, flow: ref[FlowNode], key: ref[Xxh3], t: ref[Type])
    {
        let made &FlowLoopCacheLink^host(flow, key, t, null)
        let hit flow_loop_cache_index.find(flow as int)
        flow_loop_cache.add(made)
        if hit = 0
        {
            flow_loop_cache_index.insert(flow as int, (flow_loop_cache.get_length() as int) - 1)
            return
        }
        var tail flow_loop_cache[(hit - 1) as size_t] as ref[FlowLoopCacheLink]
        while tail.next_same_flow <> null
            set tail: tail.next_same_flow as ref[FlowLoopCacheLink]
        set tail.next_same_flow: made
    }

    ; A fresh, empty flow type cache — check_expression_cached_ex's *clear*, where
    ; upstream assigns nil and lets the first write make a new map.
    function new_flow_type_cache(this) returns ref[Array[ref[FlowTypeCacheLink]?]]
    {
        let a &Array[ref[FlowTypeCacheLink]?]^host()
        a
    }

    ; ★★ getAccessedPropertyName, FOR THE ONE ARM THIS PORT CAN ANSWER. Upstream it
    ; answers a `(string, bool)` pair over four access shapes; here the name is a
    ; BORROWED run of source bytes and a length written through two out-cells, and
    ; the bool is the answer — the same shape type_to_string's caller-owns-the-
    ; buffer rule produces, and for the same reason: every name that reaches here is
    ; an identifier's text on the page the parse owns.
    ;
    ; ★ The three arms that report are the three with no producer in this slice.
    ; The element-access one is the sharp one: it is not a syntax question but
    ; tryGetElementAccessExpressionName, a literal/entity-name fork over the
    ; argument expression, and answering `false` for it would be a claim rather than
    ; a stop (see is_matching_reference's arm).
    procedure get_accessed_property_name(this, access: ref[AstNode], out_name: ref[Slice[char]]) returns bool
    {
        let k AstNode.kind_of(access)
        if k = KindPropertyAccessExpression
        {
            let n AstNode.name_of(access)
            if n = null
                return false
            let name n as ref[AstNode]
            set out_name.data: AstNode.identifier_text_of(name).data
            set out_name.length: AstNode.identifier_text_length_of(name)
            return true
        }
        ; ★★ SLICE 117 IS THE PRODUCER SLICE 94 SAID THIS ARM HAD NONE OF.
        ; getFlowTypeOfDestructuring synthesizes `obj["x"]` with a STRING LITERAL
        ; argument, so the literal half of tryGetElementAccessExpressionName is
        ; exactly what the destructuring needs. ★★★The ENTITY-NAME half —
        ; `obj[SomeEnum.A]`, whose name comes from the argument's TYPE — was the
        ; head of the stage-2 frontier when slice 154 opened (+54 units over 90
        ; arrivals) and is written below.
        if k = KindElementAccessExpression
        {
            let arg AstNode.element_access_argument_of(access)
            if arg = null
                return false
            let a arg as ref[AstNode]
            if Parser.is_string_or_numeric_literal_like(a)
            {
                set out_name.data: AstNode.literal_text_of(a).data
                set out_name.length: AstNode.literal_text_length_of(a)
                return true
            }
            if Checker.is_entity_name_expression(a)
                return this.try_get_name_from_entity_name_expression(a, out_name)
            return false
        }
        ; ★★★ BOTH REMAINING ARMS WERE EXPIRED: get_destructuring_property_name has
        ; been whole since slice 117 (four lines below the synthetic element access
        ; that is its only other caller) and the parameter arm is
        ; `strconv.Itoa(index)`, which Checker.decimal_name already writes.
        ;
        ; ★★★ THE SCRATCH IS ON THE CHECKER'S PAGE AND NOT ON THIS FRAME, and that is
        ; the function's documented lifetime rule rather than caution: the answer is
        ; a BORROWED run the caller reads after the return, so an array pattern's
        ; decimal index cannot be spelled into a stack buffer here. Upstream's
        ; `strconv.Itoa` allocates a string per call, so the page allocation is the
        ; port of it and not an addition. ★A buf PARAMETER would have been the other
        ; route and costs fourteen call sites their own buffer.
        if k = KindBindingElement
        {
            let scratch host.allocate(JSNUM_MAX_TEXT as size_t, 1) as pointer[char]
            let nm this.get_destructuring_property_name(access, Slice[char](JSNUM_MAX_TEXT as size_t, scratch))
            if nm.data = null
                return false
            set out_name.data: nm.data
            set out_name.length: nm.length
            return true
        }
        if k = KindParameter
        {
            let owner AstNode.parent_node_of(access)
            if owner = null
                return false
            let params AstNode.parameters_of(owner as ref[AstNode])
            let pn AstNode.list_count(params)
            var pi 0
            while pi < pn
            {
                if AstNode.child_in_list(params, pi) = access
                {
                    let nm Checker.decimal_name(host, pi)
                    set out_name.data: nm.data
                    set out_name.length: nm.length
                    return true
                }
                set pi: pi + 1
            }
            ; ★ `slices.Index` answers −1 for an absent element and upstream renders
            ; THAT, so the reference's answer here is the name `-1` with true. A
            ; parameter absent from its own owner's list is a broken tree, so `false`
            ; is the reading rather than a name nothing can match.
            return false
        }
        false
    }

    ; ── slice 154: the entity-name half of tryGetElementAccessExpressionName ──
    ;
    ; tryGetNameFromEntityNameExpression, whole. `obj[SomeEnum.A]` and
    ; `obj[SOME_CONST]`: the name is not in the SOURCE at that position, it is the
    ; VALUE of a constant, so the function resolves the entity name to a symbol,
    ; insists the symbol is a constant variable or an enum member, and then asks
    ; the symbol's type — its annotation first, its initializer second — for a
    ; literal it can print.
    ;
    ; ★★ THE OUT-SHAPE IS get_accessed_property_name's AND SO IS ITS LIFETIME RULE:
    ; the answer is a borrowed run that must outlive the call. Two of the three arms
    ; of try_get_name_from_type answer memory that already does; the number arm is
    ; the one that does not, and it is the only one that copies (see there).
    ;
    ; ★ resolveEntityName is called with ignoreErrors — the reference's `true` — so
    ; an unresolvable name is a false and never a diagnostic; this is a name LOOKUP
    ; in the service of narrowing, not a check.
    procedure try_get_name_from_entity_name_expression(this, node: ref[AstNode], out_name: ref[Slice[char]]) returns bool
    {
        let mark this.unported_mark()
        let symbol this.resolve_entity_name(node, SymbolFlagsValue, true, false, null)
        if this.unported_mark() <> mark
            return false
        if symbol = null
            return false
        let sym symbol as ref[Symbol]
        var usable this.is_constant_variable(sym)
        if usable = false
            set usable: (Symbol.flags_of(sym) & SymbolFlagsEnumMember) <> 0
        if usable = false
            return false
        let vd Symbol.value_declaration_of(sym)
        if vd = null
            return false
        let declaration vd as ref[AstNode]
        let dk AstNode.kind_of(declaration)
        let annotated this.try_get_type_from_type_node(declaration)
        if this.unported_mark() <> mark
            return false
        if annotated <> null
        {
            if this.try_get_name_from_type(annotated as ref[Type], out_name)
                return true
        }
        ; The reference's own comment: "We exclude binding elements because their
        ; initializers don't solely determine their types and resolving full types
        ; can cause circularities."
        if Checker.has_only_expression_initializer(dk) = false
            return false
        if dk = KindBindingElement
            return false
        if this.is_block_scoped_name_declared_before_use(declaration, node) = false
            return false
        if this.unported_mark() <> mark
            return false
        let initializer AstNode.initializer_of(declaration)
        if initializer <> null
        {
            let it this.get_type_of_expression(initializer as ref[AstNode])
            if this.unported_mark() <> mark
                return false
            if it = null
                return false
            return this.try_get_name_from_type(it as ref[Type], out_name)
        }
        if dk = KindEnumMember
        {
            ; ★ ast.TryGetTextOfPropertyName, and this is the SECOND caller its own
            ; note asked for — *the arm that would make [JsxNamespacedName]
            ; observable is a second caller, and there is none*. It does not: the
            ; argument here is an enum MEMBER's name, the same grammar position
            ; computeEnumMemberValue passes, so the containment holds unchanged.
            let text AstNode.property_name_text_of(AstNode.name_of(declaration))
            if text.data = null
                return false
            set out_name.data: text.data
            set out_name.length: text.length
            return true
        }
        false
    }

    ; tryGetNameFromType — the reference's two cases, which are
    ; getPropertyNameFromType's three arms under a different name and a different
    ; order. ★It is written over that function rather than beside it because the
    ; sets coincide EXACTLY: `UniqueESSymbol | StringOrNumberLiteral` is
    ; TypeFlagsStringOrNumberLiteralOrUnique, which is what
    ; is_type_usable_as_property_name asks, and `evaluator.AnyToString` of a string
    ; or number literal's value is the same text the property-name arm writes.
    ;
    ; ★★★ THE COPY IS CONDITIONAL AND THE CONDITION IS PROVENANCE, not tidiness. A
    ; string literal's text and a unique symbol's name already live on the
    ; checker's page; a NUMBER has no stored text at all, so its arm writes into
    ; `nb` — a stack buffer that dies with this frame — and only that arm is copied.
    ; ★copy_name_to_page's own note argues the opposite for a name STORED in a
    ; symbol (*a name that is sometimes borrowed and sometimes owned is the shape
    ; §3.5i warns about*), and the two are not in conflict: what this out-cell
    ; promises is that the run OUTLIVES THE CALL, which both provenances satisfy,
    ; where a symbol's name has to outlive the checker.
    procedure try_get_name_from_type(this, t: ref[Type], out_name: ref[Slice[char]]) returns bool
    {
        if Checker.is_type_usable_as_property_name(t) = false
            return false
        var nb char[JSNUM_MAX_TEXT]
        var nd this.get_property_name_from_type(t, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if nd.data = null
            return false
        if (t.flags & TypeFlagsNumberLiteral) <> 0
            set nd: this.copy_name_to_page(nd)
        set out_name.data: nd.data
        set out_name.length: nd.length
        true
    }

    ; hasOnlyExpressionInitializer — six kinds, asked on the KIND because every
    ; caller has it in hand.
    function has_only_expression_initializer(k: int) returns bool
    {
        if k = KindVariableDeclaration
            return true
        if k = KindParameter
            return true
        if k = KindBindingElement
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindPropertyAssignment
            return true
        k = KindEnumMember
    }

    ; containsMatchingReference — the dotted prefix walk.
    procedure contains_matching_reference(this, source: ref[AstNode], target: ref[AstNode]) returns bool
    {
        var s source
        while Parser.is_access_expression(s)
        {
            let e AstNode.expression_of(s)
            if e = null
                return false
            set s: e as ref[AstNode]
            if this.is_matching_reference(s, target)
                return true
        }
        false
    }

    ; optionalChainContainsReference — the same walk over the OPTIONAL chain.
    procedure optional_chain_contains_reference(this, source: ref[AstNode], target: ref[AstNode]) returns bool
    {
        var s source
        while Binder.is_optional_chain(s)
        {
            let e AstNode.expression_of(s)
            if e = null
                return false
            set s: e as ref[AstNode]
            if this.is_matching_reference(s, target)
                return true
        }
        false
    }

    ; ── the arms of getTypeAtFlowNode ───────────────────────────────────────

    ; getTypeAtFlowAssignment.
    ;
    ; ★★ THE ARM THAT ANSWERS, AND IT ANSWERS `f.declaredType`. An assignment
    ; narrows only where the declared type is a UNION — the reference says so in
    ; its own first comment — so the whole cost of the arm for a plain variable is
    ; the reachability test and the identity of the target.
    procedure get_type_at_flow_assignment(this, f: ref[FlowState], flow: ref[FlowNode], out_incomplete: ref[bool]) returns ref[Type]?
    {
        set out_incomplete: false
        let node_opt flow.node
        if node_opt = null
            return null
        let node node_opt as ref[AstNode]
        let reference f.reference as ref[AstNode]
        let declared f.declared_type as ref[Type]
        if this.is_matching_reference(reference, node)
        {
            if this.is_reachable_flow_node(flow) = false
                return unreachable_never_type
            ; ★★★ THE ROW `get-base-type-of-literal-type` WAS AN EXPIRED NOTE at
            ; all four of its sites (§3.5eo, third harvest): the function it named
            ; — with its enum arm, its union arm and the comparison twin — has been
            ; in this file since the literal-type slice, and nothing re-read the
            ; note. `x += 1` narrows to the ANTECEDENT's type widened out of its
            ; literal, which is why the antecedent is asked here and nowhere else
            ; in the arm.
            if Checker.get_assignment_target_kind(node) = AssignmentKindCompound
            {
                let antecedent flow.antecedent
                if antecedent = null
                    return null
                var ante_incomplete false
                let flow_type this.get_type_at_flow_node(f, antecedent as ref[FlowNode], &ante_incomplete)
                if flow_type = null
                    return null
                set out_incomplete: ante_incomplete
                let based this.get_base_type_of_literal_type(flow_type as ref[Type])
                if based = null
                    return null
                ; `newFlowType`, whose whole body is this substitution: an
                ; INCOMPLETE `never` becomes `silentNever`, so a circular flow does
                ; not publish a narrowed type it has not finished computing.
                if ante_incomplete
                {
                    if ((based as ref[Type]).flags & TypeFlagsNever) <> 0
                        return silent_never_type
                }
                return based
            }
            ; ★★★ THE EVOLVING ARRAY'S ONE PRODUCER, SLICE 141. The note that stood
            ; here called this *"the third door"* and stopped; it is where an `auto`
            ; declared type — `var x;` or `var x = [];` with no annotation — either
            ; mints the evolving array or widens the assigned literal. **Without
            ; this branch the whole family below would be readers with no producer,
            ; which §3.5fq calls transcribed rather than ported.**
            ;
            ; ★ The guard asks BOTH automatic types, as everywhere else in the
            ; family: `autoArrayType` is what `var x = []` becomes after its first
            ; widening, and a second push must keep evolving.
            var declared_is_automatic false
            if declared = auto_type
                set declared_is_automatic: true
            let aat_decl this.get_auto_array_type()
            if aat_decl <> null
            {
                if declared = (aat_decl as ref[Type])
                    set declared_is_automatic: true
            }
            if declared_is_automatic
            {
                ; `var x = []` — the empty array literal starts the evolution at
                ; `never`, which createFinalArrayType turns back into `any[]` if
                ; nothing is ever pushed.
                if Checker.is_empty_array_assignment(node)
                    return this.get_evolving_array_type(never_type)
                ; ★★★ THE ASSIGNED-TYPE HALF, AND ITS TERMINATION ARGUMENT IS THE
                ; ONE SLICE 141 WENT LOOKING FOR IN THE WRONG PLACE. That stop read
                ; *the guard that makes it terminate upstream is not the one this
                ; slice ported … the candidates are `pushTypeResolution` around the
                ; auto variable's type and the `resolutionStart` window*, and it is
                ; NEITHER: what stops `while (1) { bar = ~foo(...bar); }` upstream is
                ; getTypeAtFlowLoopLabel's OWN in-process stack. The re-entrant walk
                ; arrives at the same junction with the same key while the LOOPING
                ; antecedent is being analyzed, finds the row that antecedent pushed,
                ; and answers the union of what the FIRST antecedent already
                ; contributed — `undefined` for an unannotated `var` — marked
                ; incomplete. The stack is EMPTY only while the first antecedent runs,
                ; and the first antecedent of a loop junction is by construction the
                ; path that does not go through the loop body, so this recursion
                ; cannot start there.
                ;
                ; ★ Upstream's `flowLoopStart` window, which HIDES outer rows from a
                ; nested walk, is moved by checkExpressionCached and
                ; getContextFreeTypeOfExpression and NOT by getTypeOfExpression — the
                ; function this path goes through — so the row stays visible. This
                ; port has no window at all and walks the whole stack, which is the
                ; same answer here and never a looser one.
                ;
                ; ★ The empty-array arm above is the producer of every evolving array
                ; — `var x = []` — and needs no type at all; this arm is what widens
                ; `var x = 1` and what pushes an element into the evolution.
                let auto_mark this.unported_mark()
                let assigned_raw this.get_initial_or_assigned_type(f, flow)
                if this.unported_mark() <> auto_mark
                    return null
                if assigned_raw = null
                    return null
                let assigned this.get_widened_literal_type(assigned_raw as ref[Type])
                if this.unported_mark() <> auto_mark
                    return null
                if assigned = null
                    return null
                let at assigned as ref[Type]
                if this.is_type_assignable_to(at, declared)
                    return at
                ; `c.anyArrayType` — the fallback for a value the evolving array
                ; cannot hold.
                this.get_any_array_type()
            }
            var t declared
            if Checker.is_in_compound_like_assignment(node)
            {
                let based this.get_base_type_of_literal_type(declared)
                if based = null
                    return null
                set t: based as ref[Type]
            }
            ; ★Both readings below are the reference's `t` and not its
            ; `f.declaredType`: a compound assignment has already widened it out
            ; of its literal, and asking the DECLARED type again here would undo
            ; exactly the line above.
            if (t.flags & TypeFlagsUnion) <> 0
            {
                ; getAssignmentReducedType (slice 123) — the fourth door, and the
                ; one the reference's own comment points at: an assignment narrows
                ; a union and nothing else.
                let mark this.unported_mark()
                let assigned this.get_initial_or_assigned_type(f, flow)
                if this.unported_mark() <> mark
                    return null
                if assigned = null
                    return null
                return this.get_assignment_reduced_type(t, assigned as ref[Type])
            }
            return t
        }
        if this.contains_matching_reference(reference, node)
        {
            if this.is_reachable_flow_node(flow) = false
                return unreachable_never_type
            ; "A matching dotted name might also be an expando property on a
            ; function *expression*, in which case we continue control flow
            ; analysis back to the function's declaration."
            if AstNode.kind_of(node) = KindVariableDeclaration
            {
                var expando false
                if Parser.is_in_js_file(node)
                    set expando: true
                if this.is_var_const_like(node)
                    set expando: true
                if expando
                {
                    let ini AstNode.initializer_of(node)
                    if ini <> null
                    {
                        if Checker.is_function_expression_or_arrow_function(ini as ref[AstNode])
                            return this.get_type_at_flow_node(f, flow.antecedent as ref[FlowNode], out_incomplete)
                    }
                }
            }
            return declared
        }
        ; "for (const _ in ref) acts as a nonnull on ref"
        if AstNode.kind_of(node) = KindVariableDeclaration
        {
            let list AstNode.parent_node_of(node)
            if list <> null
            {
                let stmt AstNode.parent_node_of(list as ref[AstNode])
                if stmt <> null
                {
                    if AstNode.kind_of(stmt as ref[AstNode]) = KindForInStatement
                    {
                        let expr AstNode.expression_of(stmt as ref[AstNode])
                        if expr <> null
                        {
                            var hit false
                            if this.is_matching_reference(reference, expr as ref[AstNode])
                                set hit: true
                            if hit = false
                            {
                                if this.optional_chain_contains_reference(expr as ref[AstNode], reference)
                                    set hit: true
                            }
                            if hit
                            {
                                ; ★The note that stood here called
                                ; getNonNullableTypeIfNeeded the fifth door; both
                                ; it and finalizeEvolvingArrayType are in this file.
                                let mark this.unported_mark()
                                let ante this.get_type_at_flow_node(f, flow.antecedent as ref[FlowNode], out_incomplete)
                                if this.unported_mark() <> mark
                                    return null
                                if ante = null
                                    return null
                                let fin this.finalize_evolving_array_type(ante as ref[Type])
                                if this.unported_mark() <> mark
                                    return null
                                if fin = null
                                    return null
                                return this.get_non_nullable_type_if_needed(fin as ref[Type])
                            }
                        }
                    }
                }
            }
        }
        ; "Assignment doesn't affect reference" — the nil answer, which the
        ; dispatch reads as *walk on*.
        null
    }

    ; getTypeAtFlowCall (slice 123). ★★ ITS TWO ANSWERS ARE DIFFERENT KINDS OF
    ; THING: an ASSERTION narrows the antecedent type, and a callee returning
    ; `never` makes this node unreachable — which is why the second one answers
    ; `unreachable_never_type` rather than a narrowing. Everything else answers nil
    ; — *this call does not affect the reference* — and that is not a stop.
    procedure get_type_at_flow_call(this, f: ref[FlowState], flow: ref[FlowNode], out_incomplete: ref[bool]) returns ref[Type]?
    {
        set out_incomplete: false
        let node_opt flow.node
        if node_opt = null
            return null
        let node node_opt as ref[AstNode]
        let mark this.unported_mark()
        let signature this.get_effects_signature(node)
        if this.unported_mark() <> mark
            return null
        if signature = null
            return null
        let sig signature as ref[Signature]
        let predicate this.get_type_predicate_of_signature(sig)
        if this.unported_mark() <> mark
            return null
        if predicate <> null
        {
            let p predicate as ref[TypePredicate]
            var asserts false
            if p.kind = TypePredicateKindAssertsThis
                set asserts: true
            if p.kind = TypePredicateKindAssertsIdentifier
                set asserts: true
            if asserts
            {
                var inc false
                let flow_type this.get_type_at_flow_node(f, flow.antecedent as ref[FlowNode], &inc)
                if flow_type = null
                    return null
                let finalized this.finalize_evolving_array_type(flow_type as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if finalized = null
                    return null
                let t finalized as ref[Type]
                var narrowed: ref[Type]? t
                if p.t <> null
                    set narrowed: this.narrow_type_by_type_predicate(f, t, p, node, true)
                else
                {
                    if p.kind = TypePredicateKindAssertsIdentifier
                    {
                        if p.parameter_index >= 0
                        {
                            let args AstNode.call_arguments_of(node)
                            if p.parameter_index < AstNode.list_count(args)
                            {
                                let arg AstNode.child_in_list(args, p.parameter_index)
                                if arg <> null
                                    set narrowed: this.narrow_type_by_assertion(f, t, arg as ref[AstNode])
                            }
                        }
                    }
                }
                if this.unported_mark() <> mark
                    return null
                if narrowed = null
                    return null
                ; `flowType` UNCHANGED where the narrowing was the identity: the
                ; finalized type is not the flow type while an array still evolves
                ; (an assertion call inside a loop turned `const xs = []` into
                ; TS7034/TS7005), and newFlowType only where it narrowed.
                set out_incomplete: inc
                if (narrowed as ref[Type]) = t
                    return flow_type
                return this.new_flow_type(narrowed as ref[Type], inc)
            }
        }
        let rt this.get_return_type_of_signature(sig)
        if this.unported_mark() <> mark
            return null
        if rt = null
            return null
        if ((rt as ref[Type]).flags & TypeFlagsNever) <> 0
            return unreachable_never_type
        null
    }

    ; getTypeAtFlowCondition. The never early-out is REAL work and is written: it
    ; is what makes a reference after `if (false) { … }` answer at all.
    ; newFlowType, and it is not a constructor: this port carries a flow type as a
    ; (type, out_incomplete) pair, so what the reference's constructor DOES is the
    ; only thing left to port — the substitution below.
    ;
    ; ★★★ AN INCOMPLETE `never` BECOMES `silentNever`, AND get_type_at_flow_condition's
    ; own comment says this is the *only* place a silent never type is ever
    ; generated: a type guard met while a loop junction above is still being
    ; analyzed *could* be reachable once the type is complete, so the walk switches
    ; to the never that does NOT report when operators are applied to it. Without it
    ; a loop that narrows in one branch reports on the other — measured on
    ; `controlFlowWithIncompleteTypes` (TypeScript #11000), where the port invented
    ; two TS2339 and answered `string | number | boolean` for `string | number`.
    ;
    ; ★★★ IT WAS DEAD CODE UNTIL SLICE 141 AND THAT IS WHY ONE SITE HAD IT AND SIX
    ; DID NOT: before the loop label, NOTHING in this port could set `incomplete`,
    ; so the substitution was unobservable everywhere (§3.5be) and the assignment
    ; arm's copy of it was the only one anybody had reason to write. **A propagating
    ; site needs no call — the value went through here where it was created** — so
    ; the seven are exactly the reference's seven `newFlowType` call sites.
    function new_flow_type(this, t: ref[Type], incomplete: bool) returns ref[Type]
    {
        if incomplete
        {
            if (t.flags & TypeFlagsNever) <> 0
                return silent_never_type
        }
        t
    }

    procedure get_type_at_flow_condition(this, f: ref[FlowState], flow: ref[FlowNode], out_incomplete: ref[bool]) returns ref[Type]?
    {
        var inc false
        let t this.get_type_at_flow_node(f, flow.antecedent as ref[FlowNode], &inc)
        if t = null
            return null
        let ty t as ref[Type]
        if (ty.flags & TypeFlagsNever) <> 0
        {
            set out_incomplete: inc
            return ty
        }
        ; "If we have an antecedent type … we first attempt to narrow the
        ; antecedent type. If that produces the never type, and if the antecedent
        ; type is incomplete … we take the type guard as an indication that control
        ; *could* reach here once we have the complete type."
        let mark this.unported_mark()
        let assume_true (flow.flags & FlowFlagsTrueCondition) <> 0
        let finalized this.finalize_evolving_array_type(ty)
        if this.unported_mark() <> mark
            return null
        if finalized = null
            return null
        let non_evolving finalized as ref[Type]
        let node_opt flow.node
        if node_opt = null
            return null
        let narrowed this.narrow_type(f, non_evolving, node_opt as ref[AstNode], assume_true)
        if this.unported_mark() <> mark
            return null
        if narrowed = null
            return null
        if (narrowed as ref[Type]) = non_evolving
        {
            set out_incomplete: inc
            return ty
        }
        set out_incomplete: inc
        this.new_flow_type(narrowed as ref[Type], inc)
    }

    ; getTypeAtSwitchClause (slice 123) — the four-way fork over what the switch
    ; SUBJECT is: the reference itself, `typeof` of it, the literal `true`, or an
    ; expression that may carry a discriminant.
    procedure get_type_at_switch_clause(this, f: ref[FlowState], flow: ref[FlowNode], out_incomplete: ref[bool]) returns ref[Type]?
    {
        set out_incomplete: false
        let data_opt flow.node
        if data_opt = null
            return null
        let data data_opt as ref[AstNode]
        let sw AstNode.flow_switch_statement_of(data)
        if sw = null
            return null
        let switch_expr AstNode.expression_of(sw as ref[AstNode])
        if switch_expr = null
            return null
        let expr_opt Parser.skip_parentheses(switch_expr as ref[AstNode])
        if expr_opt = null
            return null
        let expr expr_opt as ref[AstNode]
        var inc false
        let flow_type this.get_type_at_flow_node(f, flow.antecedent as ref[FlowNode], &inc)
        if flow_type = null
            return null
        let mark this.unported_mark()
        let reference f.reference as ref[AstNode]
        var t flow_type as ref[Type]
        if this.is_matching_reference(reference, expr)
        {
            let narrowed this.narrow_type_by_switch_on_discriminant(t, data)
            if this.unported_mark() <> mark
                return null
            if narrowed = null
                return null
            set out_incomplete: inc
            return narrowed
        }
        if AstNode.kind_of(expr) = KindTypeOfExpression
        {
            let inner AstNode.expression_of(expr)
            if inner <> null
            {
                if this.is_matching_reference(reference, inner as ref[AstNode])
                {
                    let narrowed this.narrow_type_by_switch_on_typeof(t, data)
                    if this.unported_mark() <> mark
                        return null
                    if narrowed = null
                        return null
                    set out_incomplete: inc
                    return narrowed
                }
            }
        }
        if AstNode.kind_of(expr) = KindTrueKeyword
        {
            let narrowed this.narrow_type_by_switch_on_true(f, t, data)
            if this.unported_mark() <> mark
                return null
            if narrowed = null
                return null
            set out_incomplete: inc
            return narrowed
        }
        if Checker.strict_null_checks()
        {
            if this.optional_chain_contains_reference(expr, reference)
            {
                let narrowed this.narrow_type_by_switch_optional_chain_containment(t, data, false)
                if this.unported_mark() <> mark
                    return null
                if narrowed = null
                    return null
                set t: narrowed as ref[Type]
            }
            else
            {
                if AstNode.kind_of(expr) = KindTypeOfExpression
                {
                    let inner AstNode.expression_of(expr)
                    if inner <> null
                    {
                        if this.optional_chain_contains_reference(inner as ref[AstNode], reference)
                        {
                            let narrowed this.narrow_type_by_switch_optional_chain_containment(t, data, true)
                            if this.unported_mark() <> mark
                                return null
                            if narrowed = null
                                return null
                            set t: narrowed as ref[Type]
                        }
                    }
                }
            }
        }
        let access this.get_discriminant_property_access(f, expr, t)
        if this.unported_mark() <> mark
            return null
        if access <> null
        {
            let narrowed this.narrow_type_by_switch_on_discriminant_property(t, access as ref[AstNode], data)
            if this.unported_mark() <> mark
                return null
            if narrowed = null
                return null
            set t: narrowed as ref[Type]
        }
        set out_incomplete: inc
        this.new_flow_type(t, inc)
    }

    ; getTypeAtFlowBranchLabel.
    ;
    ; ★★★ THE EARLY-OUT IS THE REFERENCE'S OWN: *"if the type at a particular
    ; antecedent path is the declared type and the reference is known to always be
    ; assigned … there is no reason to process more antecedents"*. Where it fires,
    ; the union never comes up.
    ;
    ; ★★★ SLICE 141 SUPPLIES THE TAIL AND WITH IT subtypeReduction, whose two notes
    ; here said it *"is not computed and cannot be: its only reader is the union
    ; call"* and that a one-member list is answered directly. Both are gone: the
    ; union call is written, so the flag has a reader — and the one-member shortcut
    ; was NOT equivalent, because getUnionOrEvolvingArrayType also finalizes an
    ; evolving array, recombines the unknown union and restores the declared type's
    ; identity. ★The bypass branch was the last stop in this function and slice
    ; 159 closes it — the exhaustiveness chapter the note named had been in the
    ; file since slice 123, which is the narrowing engine's own slice.
    procedure get_type_at_flow_branch_label(this, f: ref[FlowState], flow: ref[FlowNode], antecedents: ref[FlowList], out_incomplete: ref[bool]) returns ref[Type]?
    {
        set out_incomplete: false
        ; ★ The Array is bound as a `ref` and not left as the `pointer` the
        ; allocation answers, and the difference is not style: a subscript on a
        ; `pointer[Array[X]]` is POINTER ARITHMETIC with an Array-sized stride,
        ; so `types[0]` on the raw allocation answers the whole Array. The
        ; compiler caught it here; it does not always.
        let types_p &Array[ref[Type]?]^host()
        let types types_p as ref[Array[ref[Type]?]]
        var seen_incomplete false
        var subtype_reduction false
        var list: ref[FlowList]? antecedents
        var bypass: ref[FlowNode]? null
        while list <> null
        {
            let l list as ref[FlowList]
            set list: l.next
            let antecedent l.flow as ref[FlowNode]
            if bypass = null
            {
                if (antecedent.flags & FlowFlagsSwitchClause) <> 0
                {
                    if AstNode.flow_clause_start_of(antecedent.node) = AstNode.flow_clause_end_of(antecedent.node)
                    {
                        ; "The antecedent is the bypass branch of a potentially
                        ; exhaustive switch statement."
                        set bypass: antecedent
                        continue
                    }
                }
            }
            var inc false
            let ft this.get_type_at_flow_node(f, antecedent, &inc)
            if ft = null
                return null
            let fty ft as ref[Type]
            if fty = (f.declared_type as ref[Type])
            {
                if (f.declared_type as ref[Type]) = (f.initial_type as ref[Type])
                    return fty
            }
            var present false
            let len types.get_length() as int
            var i 0
            while i < len
            {
                let row types[i]
                if row <> null
                {
                    if (row as ref[Type]) = fty
                        set present: true
                }
                set i: i + 1
            }
            if present = false
                types.add(fty)
            ; ★★★ THE SUBTYPE-REDUCTION FLAG, SLICE 141, and it was not merely
            ; unwritten before: the tail that reads it stopped, so the reference's
            ; own comment — *an antecedent type that is not a subset of the declared
            ; type needs subtype reduction; this happens when a "foreign" type is
            ; injected into the control flow by `instanceof` or a user-defined type
            ; predicate* — had nothing to act on. It is asked against the INITIAL
            ; type, which is upstream's argument and not the declared one.
            if this.is_type_subset_of(fty, f.initial_type as ref[Type]) = false
                set subtype_reduction: true
            if inc
                set seen_incomplete: true
        }
        if bypass <> null
        {
            ; The bypass branch, WHOLE since slice 159 — the second of the two
            ; doors isExhaustiveSwitchStatement stood behind.
            ;
            ; ★★★ SLICE 141'S SPLIT WAS HONEST AND ITS NOTE WENT STALE THE DAY THE
            ; CHAPTER LANDED. It read *"the exhaustiveness check is its own chapter
            ; (computeExhaustiveSwitchStatement, the typeof witnesses, the clause
            ; types and a three-state memo on the switch statement)"* — an exact
            ; list of what was missing, and every item of it is in this file now.
            ; §3.5eo: nothing in this apparatus re-reads a note, so an argument
            ; that was true when written keeps the row for as long as nobody looks.
            ;
            ; ★★ THE THREE CONJUNCTS ARE IN THE REFERENCE'S ORDER AND THE ORDER IS
            ; LOAD-BEARING, which its own comment says out loud: *since
            ; exhaustiveness checks increase the risk of circularities, we only
            ; want to perform them when they make a difference.* A bypass type that
            ; is `never`, or one already contributed by another antecedent, is
            ; dropped WITHOUT asking — so the memo is never entered for a switch
            ; whose answer cannot change the union.
            let bf bypass as ref[FlowNode]
            var binc false
            let bt this.get_type_at_flow_node(f, bf, &binc)
            if bt = null
                return null
            let bty bt as ref[Type]
            var consider false
            if (bty.flags & TypeFlagsNever) = 0
            {
                var seen false
                let blen types.get_length() as int
                var bi 0
                while bi < blen
                {
                    let row types[bi]
                    if row <> null
                    {
                        if (row as ref[Type]) = bty
                            set seen: true
                    }
                    set bi: bi + 1
                }
                if seen = false
                {
                    let sw AstNode.flow_switch_statement_of(bf.node)
                    if sw = null
                        set consider: true
                    else
                    {
                        if this.is_exhaustive_switch_statement(sw as ref[AstNode]) = false
                            set consider: true
                    }
                }
            }
            if consider
            {
                if bty = (f.declared_type as ref[Type])
                {
                    if (f.declared_type as ref[Type]) = (f.initial_type as ref[Type])
                        return bty
                }
                types.add(bty)
                if this.is_type_subset_of(bty, f.initial_type as ref[Type]) = false
                    set subtype_reduction: true
                if binc
                    set seen_incomplete: true
            }
        }
        var reduction UnionReductionLiteral
        if subtype_reduction
            set reduction: UnionReductionSubtype
        let joined this.get_union_or_evolving_array_type(f, types, reduction)
        if joined = null
            return null
        set out_incomplete: seen_incomplete
        this.new_flow_type(joined as ref[Type], seen_incomplete)
    }

    ; getTypeAtFlowLoopLabel — the cache, the key that keys it, and the in-process
    ; stack that makes a back edge terminate. Slice 141.
    ;
    ; ★ The SINGLE-antecedent loop label never reaches this function — the dispatch
    ; collapses it, exactly as upstream — so what arrives here is a loop with a real
    ; back edge.
    ;
    ; ★★★ THE FIRST ANTECEDENT IS THE NON-LOOPING PATH AND EVERYTHING TERMINATES ON
    ; THAT. The reference says it twice, and the second time is the load-bearing
    ; one: an inner loop reached from an outer loop's back edge may find an EMPTY
    ; in-process list, in which case the analysis of the inner loop restarts — and
    ; it terminates because the first antecedent of the outer junction is the path
    ; that leads to the top, so the second visit finds a non-empty list.
    ;
    ; ★★★ AND THAT IS EXACTLY WHY THIS STACK IS NOT THE GUARD FOR EVERY CYCLE, which
    ; slice 141 measured rather than assumed: with a probe on every entry, the shape
    ; `while (1) { bar = ~foo(...bar); }` reached this function sixty times with the
    ; in-process stack EMPTY at every arrival, because the re-entry happens while the
    ; FIRST antecedent is being analyzed — where upstream pushes nothing either. See
    ; get_type_at_flow_assignment's automatic branch for the stop that answers it and
    ; for what the successor has to find.
    ;
    ; ★★ THE FLOW TYPE CACHE IS CLEARED AROUND EVERY LOOPING ANTECEDENT and the
    ; reason is in the reference's own comment: a value appearing in the loop cache
    ; during that walk is a sign that control flow analysis was RESTARTED and
    ; completed by checkExpressionCached, and the answer can then simply be picked
    ; up. Both halves are ported: the clear, and the pick-up test after the call.
    procedure get_type_at_flow_loop_label(this, f: ref[FlowState], flow: ref[FlowNode], out_incomplete: ref[bool]) returns ref[Type]?
    {
        set out_incomplete: false
        let mark this.unported_mark()
        if f.ref_key_computed = false
        {
            set f.ref_key: this.get_flow_reference_key(f)
            if this.unported_mark() <> mark
            {
                return null
            }
            set f.ref_key_computed: true
        }
        ; ★ A null key is `nonDottedNameCacheKey`: no cache key is generated when
        ; binding patterns are in unnarrowable situations, and the declared type is
        ; the answer.
        if f.ref_key = null
        {
            return f.declared_type
        }
        let key f.ref_key as ref[Xxh3]
        let cached this.flow_loop_cache_lookup(flow, key)
        if cached <> null
        {
            return cached
        }
        ; If this junction and reference are already being processed, answer the
        ; union of the branches computed so far, marked INCOMPLETE.
        var walk flow_loop_stack
        while walk <> null
        {
            let w walk as ref[FlowLoopInfo]
            set walk: w.next
            if w.flow = null
            {
                continue
            }
            if (w.flow as ref[FlowNode]) <> flow
            {
                continue
            }
            if w.key = null
                continue
            if Checker.flow_key_equal(w.key as ref[Xxh3], key) = false
            {
                continue
            }
            if w.types = null
                continue
            let seen w.types as ref[Array[ref[Type]?]]
            if seen.get_length() = 0
            {
                continue
            }
            let partial this.get_union_or_evolving_array_type(f, seen, UnionReductionLiteral)
            if partial = null
                return null
            set out_incomplete: true
            return this.new_flow_type(partial as ref[Type], true)
        }
        let types_p &Array[ref[Type]?]^host()
        let types types_p as ref[Array[ref[Type]?]]
        var subtype_reduction false
        var first_seen false
        var first_incomplete false
        var list: ref[FlowList]? flow.antecedents
        while list <> null
        {
            let l list as ref[FlowList]
            set list: l.next
            let antecedent l.flow as ref[FlowNode]
            var inc false
            var ft: ref[Type]? null
            if first_seen = false
            {
                set ft: this.get_type_at_flow_node(f, antecedent, &inc)
                set first_seen: true
                set first_incomplete: inc
            }
            else
            {
                ; The looping paths. They are tracked on the in-process stack, and
                ; the flow type cache is cleared for the duration.
                set flow_loop_stack: &FlowLoopInfo^host(flow, key, types, flow_loop_stack)
                let save_cache flow_type_cache
                set flow_type_cache: this.new_flow_type_cache()
                set ft: this.get_type_at_flow_node(f, antecedent, &inc)
                set flow_type_cache: save_cache
                let popped flow_loop_stack
                if popped <> null
                    set flow_loop_stack: (popped as ref[FlowLoopInfo]).next
                if ft <> null
                {
                    ; ★ The pick-up: a row for this junction means the analysis was
                    ; restarted and completed elsewhere.
                    let restarted this.flow_loop_cache_lookup(flow, key)
                    if restarted <> null
                        return restarted
                }
            }
            if ft = null
                return null
            let fty ft as ref[Type]
            var present false
            let len types.get_length() as int
            var i 0
            while i < len
            {
                let row types[i]
                if row <> null
                {
                    if (row as ref[Type]) = fty
                        set present: true
                }
                set i: i + 1
            }
            if present = false
                types.add(fty)
            if this.is_type_subset_of(fty, f.initial_type as ref[Type]) = false
                set subtype_reduction: true
            ; ★ The early break: an antecedent that is the DECLARED type ends the
            ; loop, because everything after it can only be a subtype the final
            ; union removes anyway.
            if fty = (f.declared_type as ref[Type])
                set list: null
        }
        var reduction UnionReductionLiteral
        if subtype_reduction
            set reduction: UnionReductionSubtype
        let result this.get_union_or_evolving_array_type(f, types, reduction)
        if result = null
            return null
        ; ★★★ THE RESULT IS CACHED ONLY WHERE THE FIRST ANTECEDENT WAS COMPLETE, and
        ; that is the invariant the whole cache rests on: an incomplete answer is one
        ; taken while a junction above was still being analyzed, and writing it would
        ; freeze a transient type for the rest of the check.
        if first_incomplete
        {
            set out_incomplete: true
            return this.new_flow_type(result as ref[Type], true)
        }
        this.flow_loop_cache_put(flow, key, result as ref[Type])
        result
    }

    ; getTypeAtFlowArrayMutation, whole — slice 141.
    ;
    ; ★★★ THE GUARD IS THE WHOLE FUNCTION FOR EVERY ANNOTATED VARIABLE, and it now
    ; asks BOTH halves: upstream is `declaredType == autoType || declaredType ==
    ; autoArrayType`, and this port asked only the first while the body was a stop —
    ; a conjunct dropped for want of a reader, which is exactly the shape §3.5be
    ; means. The second half is what lets `var x = []` keep evolving after the first
    ; push has already widened it to `any[]`.
    ;
    ; ★★ THE TWO SHAPES ARE `x.push(v)` / `x.unshift(v)` AND `x[n] = v`, and they are
    ; told apart on the flow node's KIND rather than on anything about the reference:
    ; a Call gets every ARGUMENT added, an assignment gets its RIGHT side added and
    ; only when the INDEX is number-like. ★The index is asked through
    ; get_context_free_type_of_expression and the reference says why: *we must get
    ; the context free expression type so as to not recur in an uncached fashion on
    ; the LHS (which causes exponential blowup in compile time).*
    procedure get_type_at_flow_array_mutation(this, f: ref[FlowState], flow: ref[FlowNode], out_incomplete: ref[bool]) returns ref[Type]?
    {
        set out_incomplete: false
        let declared f.declared_type as ref[Type]
        var declared_is_auto false
        if declared = auto_type
            set declared_is_auto: true
        let aat this.get_auto_array_type()
        if aat <> null
        {
            if declared = (aat as ref[Type])
                set declared_is_auto: true
        }
        if declared_is_auto = false
            return null
        let node_opt flow.node
        if node_opt = null
            return null
        let node node_opt as ref[AstNode]
        let is_call Checker.kind_or_unknown(node) = KindCallExpression
        var expr: ref[AstNode]? null
        if is_call
        {
            let callee AstNode.expression_of(node)
            if callee = null
                return null
            set expr: AstNode.expression_of(callee as ref[AstNode])
        }
        else
        {
            let left AstNode.binary_left_of(node)
            if left = null
                return null
            set expr: AstNode.expression_of(left as ref[AstNode])
        }
        if expr = null
            return null
        let mark this.unported_mark()
        let candidate Checker.get_reference_candidate(expr as ref[AstNode])
        if this.is_matching_reference(f.reference as ref[AstNode], candidate) = false
        {
            if this.unported_mark() <> mark
                return null
            return null
        }
        var inc false
        let ft this.get_type_at_flow_node(f, flow.antecedent as ref[FlowNode], &inc)
        if ft = null
            return null
        let fty ft as ref[Type]
        if (fty.object_flags & ObjectFlagsEvolvingArray) = 0
        {
            set out_incomplete: inc
            return fty
        }
        var evolved fty
        if is_call
        {
            let args AstNode.call_arguments_of(node)
            if args <> null
            {
                let list args as ref[Array[ref[AstNode]?]]
                let n list.get_length() as int
                var i 0
                while i < n
                {
                    let arg list[i]
                    set i: i + 1
                    if arg = null
                        continue
                    let grown this.add_evolving_array_element_type(evolved, arg as ref[AstNode])
                    if grown = null
                        return null
                    set evolved: grown as ref[Type]
                }
            }
        }
        else
        {
            let left AstNode.binary_left_of(node)
            if left = null
                return null
            let index AstNode.element_access_argument_of(left as ref[AstNode])
            if index = null
                return null
            let it this.get_context_free_type_of_expression(index as ref[AstNode])
            if it = null
                return null
            if this.is_type_assignable_to_kind(it as ref[Type], TypeFlagsNumberLike)
            {
                let right AstNode.binary_right_of(node)
                if right = null
                    return null
                let grown this.add_evolving_array_element_type(evolved, right as ref[AstNode])
                if grown = null
                    return null
                set evolved: grown as ref[Type]
            }
        }
        set out_incomplete: inc
        this.new_flow_type(evolved, inc)
    }

    ; The arm switch of getTypeAtFlowNode, lifted out of its loop.
    ;
    ; ★★★ UPSTREAM THIS IS A GO `switch` WITH `continue` IN FIVE ARMS, AND A
    ; `continue` THERE DOES NOT ALWAYS MEAN `flow.Antecedent`. The two label arms
    ; collapse to their single antecedent and the Start arm hops to the CONTAINING
    ; function's flow node — three different next nodes wearing one keyword. So
    ; the lifted form answers through a `next` cell, and a non-null `next` IS the
    ; continue. Reading it as *the antecedent* would have made a nested function's
    ; reference walk its own container's graph instead of the outer one's.
    procedure get_type_at_flow_node_arm(this, f: ref[FlowState], flow: ref[FlowNode], out_incomplete: ref[bool], out_next: ref[ref[FlowNode]?]) returns ref[Type]?
    {
        let flags flow.flags
        if (flags & FlowFlagsAssignment) <> 0
        {
            let t this.get_type_at_flow_assignment(f, flow, out_incomplete)
            if t = null
                set out_next: flow.antecedent
            return t
        }
        if (flags & FlowFlagsCall) <> 0
        {
            let t this.get_type_at_flow_call(f, flow, out_incomplete)
            if t = null
                set out_next: flow.antecedent
            return t
        }
        if (flags & FlowFlagsCondition) <> 0
            return this.get_type_at_flow_condition(f, flow, out_incomplete)
        if (flags & FlowFlagsSwitchClause) <> 0
            return this.get_type_at_switch_clause(f, flow, out_incomplete)
        if (flags & FlowFlagsBranchLabel) <> 0
        {
            ; ★★ THE UNWRAP IS THE ASSERTION AND IT IS MEASURED, NOT ASSUMED. A
            ; label with no antecedents cannot be reached: finishFlowLabel answers
            ; the unreachable SENTINEL for one instead of the label, so nothing
            ; ever records it as an antecedent. Upstream `antecedents.Next` would
            ; panic; here the null-unwrap trap is the same statement in this
            ; language, and a `return null` in its place would be a silent
            ; no-answer with nothing in the work list. **Probed over 17 375
            ; stage-2 units: zero arrivals, both labels.**
            let al Checker.get_branch_label_antecedents(flow, f.reduce_labels) as ref[FlowList]
            if al.next = null
            {
                set out_next: al.flow
                return null
            }
            return this.get_type_at_flow_branch_label(f, flow, al, out_incomplete)
        }
        if (flags & FlowFlagsLoopLabel) <> 0
        {
            let al flow.antecedents as ref[FlowList]
            if al.next = null
            {
                set out_next: al.flow
                return null
            }
            return this.get_type_at_flow_loop_label(f, flow, out_incomplete)
        }
        if (flags & FlowFlagsArrayMutation) <> 0
        {
            let t this.get_type_at_flow_array_mutation(f, flow, out_incomplete)
            if t = null
                set out_next: flow.antecedent
            return t
        }
        if (flags & FlowFlagsReduceLabel) <> 0
        {
            let saved f.reduce_labels
            let cell &ReduceLabelStack^host(flow.node, saved)
            set f.reduce_labels: cell
            let t this.get_type_at_flow_node(f, flow.antecedent as ref[FlowNode], out_incomplete)
            set f.reduce_labels: saved
            return t
        }
        if (flags & FlowFlagsStart) <> 0
        {
            ; "Check if we should continue with the control flow of the containing
            ; function." Four terms, and the last of them is a negated
            ; conjunction — written as the two tests it is (§3.5u).
            let container flow.node
            if container <> null
            {
                let cn container as ref[AstNode]
                var hop true
                if f.flow_container <> null
                {
                    if (f.flow_container as ref[AstNode]) = cn
                        set hop: false
                }
                let rk AstNode.kind_of(f.reference as ref[AstNode])
                if rk = KindPropertyAccessExpression
                    set hop: false
                if rk = KindElementAccessExpression
                    set hop: false
                if rk = KindThisKeyword
                {
                    if AstNode.kind_of(cn) <> KindArrowFunction
                        set hop: false
                }
                if hop
                {
                    let next AstNode.flow_node_of(cn)
                    if next <> null
                    {
                        set out_next: next
                        return null
                    }
                }
            }
            ; "At the top of the flow we have the initial type."
            return f.initial_type
        }
        ; "Unreachable code errors are reported in the binding phase. Here we
        ; simply return the non-auto declared type to reduce follow-on errors."
        this.convert_auto_to_any(f.declared_type)
    }

    ; reportFlowControlError — FindAncestor over IsFunctionOrModuleBlock (a source
    ; file, a module block, or a block whose parent is function-like), then the
    ; token at the statement list's own start.
    procedure report_flow_control_error(this, node: ref[AstNode]?)
    {
        if node = null
            return
        if this.node_is_in_lib(node as ref[AstNode])
            return
        var block: ref[AstNode]? node
        while block <> null
        {
            let bk block as ref[AstNode]
            let k AstNode.kind_of(bk)
            if k = KindSourceFile
                break
            if k = KindModuleBlock
                break
            if k = KindBlock
            {
                if AstNode.is_function_like(AstNode.parent_node_of(bk))
                    break
            }
            set block: AstNode.parent_node_of(bk)
        }
        if block = null
            return
        let bl block as ref[AstNode]
        var lpos 0
        var lend 0
        ; the SOURCE FILE's statement list starts at position 0 — the parser's
        ; nodePos before the first token, leading trivia included — and the
        ; range recorder never sees that list (slice 224); a block's list is looked up
        if AstNode.kind_of(bl) <> KindSourceFile
        {
            if AstNode.list_range_of(file, AstNode.statements_of(bl), &lpos, &lend) = false
            {
                this.record_unported("report-flow-control-error-list-range", AstNode.kind_of(bl))
                return
            }
        }
        var start 0
        var stop 0
        Binder.range_of_token_on(this.scanner_for(b), lpos, &start, &stop)
        this.add_diagnostic_direct(start, stop, DiagThe_containing_function_or_module_body_is_too_large_for_control_flow_analysis)
    }

    ; getTypeAtFlowNode — the loop, the shared-node memo and the depth guard.
    procedure get_type_at_flow_node(this, f: ref[FlowState], flow_in: ref[FlowNode], out_incomplete: ref[bool]) returns ref[Type]?
    {
        set out_incomplete: false
        if f.depth = 2000
        {
            ; reportFlowControlError (slice 202, `largeControlFlowGraph`): TS2563
            ; on the first token of the enclosing function or module body's
            ; statement list. The LATCH beside it is what the guard is for.
            set flow_analysis_disabled: true
            this.report_flow_control_error(f.reference)
            return error_type
        }
        set f.depth: f.depth + 1
        var flow flow_in
        var shared_flow: ref[FlowNode]? null
        repeat
        {
            let flags flow.flags
            this.trace_flow(1, flags, 0)
            if (flags & FlowFlagsShared) <> 0
            {
                ; "We cache results of flow type resolution for shared nodes that
                ; were previously visited in the same getFlowTypeOfReference
                ; invocation."
                let len f.shared_flows.get_length() as int
                var i 0
                while i < len
                {
                    let sfr f.shared_flows.at(i as size_t)
                    if sfr.flow = flow
                    {
                        set f.depth: f.depth - 1
                        set out_incomplete: sfr.incomplete
                        return sfr.t
                    }
                    set i: i + 1
                }
                set shared_flow: flow
            }
            let mark this.unported_mark()
            var next: ref[FlowNode]? null
            var inc false
            let t this.get_type_at_flow_node_arm(f, flow, &inc, &next)
            if this.unported_mark() <> mark
            {
                set f.depth: f.depth - 1
                return null
            }
            if next <> null
            {
                set flow: next as ref[FlowNode]
                continue
            }
            if shared_flow <> null
            {
                f.shared_flows.add(SharedFlow(shared_flow, t, inc))
            }
            set f.depth: f.depth - 1
            set out_incomplete: inc
            return t
        }
    }

    ; ★ getFlowTypeOfReference — the two-argument entry — is NOT written. It is
    ; `getFlowTypeOfReferenceEx(reference, t, t, nil, nil)` and every caller of it
    ; in the reference is behind a wall this slice does not reach (the property
    ; access, the `this` expression, getFlowTypeOfProperty). A forwarder with no
    ; caller is machinery no instrument can see (§3.5be); it lands with its first
    ; caller. The one caller this slice HAS passes four of the five arguments.

    ; getFlowTypeOfReferenceEx — the entry, and the two-line tail under the walk.
    ;
    ; ★ The evolving-array half of that tail is an identity here for the reason
    ; convert_auto_to_any's second arm is unaskable: no type in this run carries
    ; ObjectFlagsEvolvingArray, because nothing mints one. finalizeEvolvingArrayType
    ; is therefore not written, and isEvolvingArrayOperationTarget with it.
    ;
    ; ★★ THE NonNullExpression TERM IS A STOP AND ITS GUARD ORDER IS LOAD-BEARING.
    ; Go's `||` short-circuits, so the unreachableNeverType test answers first and
    ; the getTypeWithFacts term is only asked where the parent is a `!`. Asking it
    ; first would have put a stop on every reference in the corpus.
    procedure get_flow_type_of_reference_ex(this, reference: ref[AstNode], declared_type: ref[Type], initial_type: ref[Type]?, flow_container: ref[AstNode]?, flow_node_in: ref[FlowNode]?) returns ref[Type]?
    {
        if flow_analysis_disabled
            return error_type
        var flow_node flow_node_in
        if flow_node = null
        {
            set flow_node: Checker.get_flow_node_of_node(reference)
            if flow_node = null
                return declared_type
        }
        var initial initial_type
        if initial = null
            set initial: declared_type
        ; The walk's state lives in THIS routine's region and goes with it: the
        ; shared-flow memo is per invocation upstream, and nothing keeps the state.
        var sf Array[SharedFlow]()
        var fs FlowState(reference, declared_type, initial, flow_container, 0, null, &sf, false, null)
        let f &fs
        ; `c.flowInvocationCount++` — at the reference's own line, between the
        ; flow state and the walk. Its ONE reader is get_type_of_expression.
        set flow_invocation_count: flow_invocation_count + 1
        this.trace_flow(0, AstNode.pos_of(reference), AstNode.end_of(reference))
        var inc false
        let evolved this.get_type_at_flow_node(f, flow_node as ref[FlowNode], &inc)
        if evolved = null
        {
            this.trace_flow(2, 0, 1)
            return null
        }
        this.trace_flow(2, (evolved as ref[Type]).id, 0)
        ; ★★★ THE EVOLVING-ARRAY FORK, SLICE 141, and the reference's own comment is
        ; the argument: *when the reference is `x` in an `x.length`, `x.push(value)`,
        ; `x.unshift(value)` or `x[n] = value` operation, we give type `any[]` to `x`
        ; instead of using the type determined by control flow analysis, such that
        ; operations on empty arrays are possible without implicit any errors and new
        ; element types can be inferred without type mismatch errors.* Everything
        ; else is FINALIZED here — the line that keeps an evolving array type from
        ; escaping this function, which is the invariant the whole family rests on.
        let evolved_type evolved as ref[Type]
        var result_opt: ref[Type]? null
        if (evolved_type.object_flags & ObjectFlagsEvolvingArray) <> 0
        {
            let target_mark this.unported_mark()
            let is_target this.is_evolving_array_operation_target(reference)
            if this.unported_mark() <> target_mark
                return null
            if is_target
                set result_opt: this.get_auto_array_type()
            else
                set result_opt: this.finalize_evolving_array_type(evolved_type)
        }
        else
            set result_opt: this.finalize_evolving_array_type(evolved_type)
        if result_opt = null
            return null
        let result result_opt as ref[Type]
        if result = unreachable_never_type
            return declared_type
        let parent AstNode.parent_node_of(reference)
        if parent <> null
        {
            if AstNode.kind_of(parent as ref[AstNode]) = KindNonNullExpression
            {
                if (result.flags & TypeFlagsNever) = 0
                {
                    ; ★★★ SLICE 165 — the note that stood here said this was *a
                    ; FILTER over a union, which is the same room the seven doors
                    ; open on*, and slice 117 built that room: `get_type_with_facts`
                    ; is `filter_type_by_facts` and has been whole since. The
                    ; conjunct is the reference's own last one — if narrowing has
                    ; already removed every non-nullish constituent, the `!` cannot
                    ; narrow further and the DECLARED type is the answer.
                    let facts_mark this.unported_mark()
                    let non_nullish this.get_type_with_facts(result, TypeFactsNEUndefinedOrNull)
                    if this.unported_mark() <> facts_mark
                        return null
                    if non_nullish = null
                        return null
                    if ((non_nullish as ref[Type]).flags & TypeFlagsNever) <> 0
                        return declared_type
                }
            }
        }
        result
    }

    ; ── slice 123: THE NARROWING ENGINE — the type algebra it stands on ──────
    ;
    ; ★★★ THIS SECTION IS NOT flow.go AND IT IS NOT A DETOUR EITHER. Every arm of
    ; the narrowing engine ends in one of four operations — filter a union, map a
    ; union, ask a fact, or intersect — and this port had exactly ONE of them
    ; (filter_type_by_facts, slice 117). What stands here is the rest, transcribed
    ; from checker.go and relater.go at the places flow.go reaches into them.
    ;
    ; ★★ THE FUNC VALUES BECOME NAMED ROUTINES, §3.5e's rule, and the PREDICATE is
    ; what names them: `filter_type_by_facts` is the shape, `filter_type_by_*` and
    ; `map_type_by_*` are its siblings. A shared walk with a tag was rejected for
    ; the reason §3.5e gives — where the call sites are static the flag is better
    ; than a delegate — except at ONE site where the closure genuinely varies over
    ; four callers, narrow_type_by_discriminant, and there the tag IS the flag.

    ; areTypesComparable — the symmetric closure of isTypeComparableTo, which this
    ; port already has.
    procedure are_types_comparable(this, type1: ref[Type], type2: ref[Type]) returns bool
    {
        if this.is_type_comparable_to(type1, type2)
            return true
        this.is_type_comparable_to(type2, type1)
    }

    ; isFunctionType.
    procedure is_function_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsObject) = 0
            return false
        let mark this.unported_mark()
        let sigs this.get_signatures_of_type(t, SignatureKindCall)
        if this.unported_mark() <> mark
            return false
        Checker.sig_count(sigs) > 0
    }

    ; isGenericFunctionReturningFunction, and `core.Some` over the candidate list
    ; beside it — the reference spells the loop at its one call site.
    procedure is_generic_function_returning_function(this, signature: ref[Signature]) returns bool
    {
        if signature.type_parameters = null
            return false
        if ((signature.type_parameters as ref[Array[ref[Type]?]]).get_length() as int) = 0
            return false
        let mark this.unported_mark()
        let ret this.get_return_type_of_signature(signature)
        if this.unported_mark() <> mark
            return false
        if ret = null
            return false
        this.is_function_type(ret as ref[Type])
    }

    procedure some_generic_function_returning_function(this, signatures: ref[Array[ref[Signature]?]]?) returns bool
    {
        if signatures = null
            return false
        let list signatures as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if this.is_generic_function_returning_function(row as ref[Signature])
                return true
        }
        false
    }

    ; getBaseConstraintOrType.
    procedure get_base_constraint_or_type(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let constraint this.get_base_constraint_of_type(t)
        if this.unported_mark() <> mark
            return null
        if constraint <> null
            return constraint
        t
    }

    ; isUnitLikeType. ★The reference scans the INTERSECTION *"such that tagged
    ; literal types are considered unit types"*, and the scan is written rather
    ; than folded away — an intersection reaching here is exactly the tagged
    ; literal the comment names.
    procedure is_unit_like_type(this, t: ref[Type]) returns bool
    {
        let based this.get_base_constraint_or_type(t)
        if based = null
            return false
        let b based as ref[Type]
        if (b.flags & TypeFlagsIntersection) = 0
            return Checker.is_unit_type(b)
        let types Checker.union_or_intersection_types_of(b)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if Checker.is_unit_type(row as ref[Type])
                return true
        }
        false
    }

    ; extractUnitType.
    function extract_unit_type(this, t: ref[Type]) returns ref[Type]
    {
        if (t.flags & TypeFlagsIntersection) = 0
            return t
        let types Checker.union_or_intersection_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if Checker.is_unit_type(row as ref[Type])
                return row as ref[Type]
        }
        t
    }

    ; extractTypesOfKind — filterType with the predicate `t.flags & kind != 0`, the
    ; positive twin of filter_type_outside_flags.
    procedure filter_type_inside_flags(this, t: ref[Type], mask: int) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if ((row as ref[Type]).flags & mask) <> 0
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = n
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & mask) <> 0
            return t
        never_type
    }

    ; removeType — filterType by IDENTITY against one constituent.
    procedure remove_type(this, t: ref[Type], target_type: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if (row as ref[Type]) <> target_type
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = n
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if t <> target_type
            return t
        never_type
    }

    ; allTypesAssignableToKindEx — everyType over isTypeAssignableToKindEx.
    procedure all_types_assignable_to_kind(this, source: ref[Type], kind: int) returns bool
        this.all_types_assignable_to_kind_ex(source, kind, false)

    procedure all_types_assignable_to_kind_ex(this, source: ref[Type], kind: int, strict: bool) returns bool
    {
        if (source.flags & TypeFlagsUnion) = 0
            return this.is_type_assignable_to_kind_ex(source, kind, strict)
        let types Checker.union_types_of(source)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if this.all_types_assignable_to_kind_ex(row as ref[Type], kind, strict) = false
                return false
        }
        true
    }

    ; getTargetType.
    function get_target_type(t: ref[Type]) returns ref[Type]
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return t
        let target Checker.target_of(t)
        if target = null
            return t
        target as ref[Type]
    }

    ; hasBaseType — the reference's inner `check` closure, written as the
    ; recursion it is (§3.5e: the closure is recursive and captures `checkBase`,
    ; so the capture becomes the second parameter).
    procedure has_base_type(this, t: ref[Type], check_base: ref[Type]) returns bool
    {
        if (t.object_flags & (ObjectFlagsClassOrInterface | ObjectFlagsReference)) <> 0
        {
            let target Checker.get_target_type(t)
            if target = check_base
                return true
            let mark this.unported_mark()
            let bases this.get_base_types(target)
            if this.unported_mark() <> mark
                return false
            if bases = null
                return false
            let list bases as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.has_base_type(row as ref[Type], check_base)
                    return true
            }
            return false
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.has_base_type(row as ref[Type], check_base)
                    return true
            }
        }
        false
    }

    ; isTypeDerivedFrom — the `instanceof` relation, and it is NOT assignability:
    ; its object arm asks the BASE-TYPE chain, which is what makes two structurally
    ; identical classes distinguishable.
    procedure is_type_derived_from(this, source: ref[Type], target: ref[Type]) returns bool
    {
        if (source.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(source)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.is_type_derived_from(row as ref[Type], target) = false
                    return false
            }
            return true
        }
        if (target.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(target)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.is_type_derived_from(source, row as ref[Type])
                    return true
            }
            return false
        }
        if (source.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(source)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.is_type_derived_from(row as ref[Type], target)
                    return true
            }
            return false
        }
        if (source.flags & TypeFlagsInstantiableNonPrimitive) <> 0
        {
            let mark this.unported_mark()
            let constraint this.get_base_constraint_of_type(source)
            if this.unported_mark() <> mark
                return false
            if constraint = null
                return this.is_type_derived_from(unknown_type, target)
            return this.is_type_derived_from(constraint as ref[Type], target)
        }
        if this.is_empty_anonymous_object_type(target)
            return (source.flags & (TypeFlagsObject | TypeFlagsNonPrimitive)) <> 0
        let global_object this.get_global_object_type()
        if global_object <> null
        {
            if target = (global_object as ref[Type])
            {
                if (source.flags & (TypeFlagsObject | TypeFlagsNonPrimitive)) = 0
                    return false
                return this.is_empty_anonymous_object_type(source) = false
            }
        }
        let global_function this.get_global_function_type()
        if global_function <> null
        {
            if target = (global_function as ref[Type])
            {
                if (source.flags & TypeFlagsObject) = 0
                    return false
                return this.is_function_object_type(source)
            }
        }
        if this.has_base_type(source, Checker.get_target_type(target))
            return true
        if this.is_array_type(target) = false
            return false
        if this.is_readonly_array_type(target)
            return false
        let ro this.get_global_readonly_array_type()
        if ro = null
            return false
        this.is_type_derived_from(source, ro as ref[Type])
    }

    ; getGlobalType("Function", 0) — get_global_object_type's twin, and a SECOND
    ; function for the reason that one gives: a missing non-generic global has no
    ; stand-in, so `nothing` has to stay distinguishable.
    procedure get_global_function_type(this) returns ref[Type]?
    {
        if global_function_type <> null
            return global_function_type
        let symbol this.lookup_globals("Function", SymbolFlagsType)
        if symbol = null
            return null
        let sym symbol as ref[Symbol]
        if (Symbol.flags_of(sym) & (SymbolFlagsClass | SymbolFlagsInterface)) = 0
            return null
        let mark this.unported_mark()
        let declared this.get_declared_type_of_symbol(sym)
        if this.unported_mark() <> mark
            return null
        if declared = null
            return null
        let d declared as ref[Type]
        if Checker.type_parameter_count_of(d) <> 0
            return null
        set global_function_type: d
        d
    }

    ; getGlobalStrictFunctionType("CallableFunction") / ("NewableFunction").
    ;
    ; ★★ THE `strictBindCallApply` FORK COLLAPSES TO ITS TRUE ARM under this
    ; harness, for the reason strict_null_checks' header gives — it is a
    ; strict-FAMILY option read through GetStrictOptionValue, so unset falls
    ; through to `Strict != TSFalse`. ★The FALSE arm answers globalFunctionType and
    ; is simply not written.
    ;
    ; ★★★ SLICE 154 REMOVED A FALLBACK THIS PORT HAD INVENTED. The two bodies read
    ; *if the lookup fails, answer get_global_function_type()* on the strength of
    ; the sentence above — but the reference's failure value here is getGlobalType's
    ; own, `emptyObjectType`, and the two are not the same type. It never fired
    ; (`CallableFunction` and `NewableFunction` are in lib.es5.d.ts) and it cannot
    ; fire now: with reportErrors true a missing global is a stop.
    procedure get_global_callable_function_type(this) returns ref[Type]?
    {
        if global_callable_function_type <> null
            return global_callable_function_type
        if Checker.strict_bind_call_apply() = false
            return this.get_global_function_type()
        let d this.get_global_type_zero_arity_ex("CallableFunction", SymbolFlagsType, false)
        if d = null
            return null
        set global_callable_function_type: d
        d
    }

    procedure get_global_newable_function_type(this) returns ref[Type]?
    {
        if global_newable_function_type <> null
            return global_newable_function_type
        if Checker.strict_bind_call_apply() = false
            return this.get_global_function_type()
        let d this.get_global_type_zero_arity_ex("NewableFunction", SymbolFlagsType, false)
        if d = null
            return null
        set global_newable_function_type: d
        d
    }

    ; getTypeOfPropertyOrIndexSignatureOfType — narrow_type_by_discriminant's
    ; filter reads this and not get_type_of_property_of_type, because a
    ; constituent that carries the name only through an INDEX SIGNATURE still
    ; participates in the comparison.
    procedure get_type_of_property_or_index_signature_of_type(this, t: ref[Type], d: Slice[char]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let prop_type this.get_type_of_property_of_type(t, d)
        if this.unported_mark() <> mark
            return null
        if prop_type <> null
            return prop_type
        let info this.get_applicable_index_info_for_name(t, d)
        if info = null
            return null
        let vt (info as ref[IndexInfo]).value_type
        if vt = null
            return null
        this.add_optionality_ex(vt as ref[Type], true, true)
    }

    ; recombineUnknownType.
    procedure recombine_unknown_type(this, t: ref[Type]) returns ref[Type]
    {
        let uu this.get_unknown_union_type()
        if uu = null
            return t
        if t = (uu as ref[Type])
            return unknown_type
        t
    }

    ; c.unknownUnionType, built lazily where the reference builds it eagerly in
    ; initializeChecker. ★It is `{} | null | undefined` under strictNullChecks and
    ; `unknown` otherwise, and its ONE job is to make `unknown` filterable: the
    ; facts machinery has nothing to remove from a type with no constituents.
    ;
    ; ★ The empty object it unions in is the reference's `unknownEmptyObjectType`,
    ; a SECOND anonymous empty type beside empty_object_type. They are compared by
    ; identity in different places (this one only here and in
    ; IsEmptyAnonymousObjectType's first disjunct, which this port answers
    ; structurally), so minting one and using it for both would tie two questions
    ; together that the reference keeps apart.
    procedure get_unknown_union_type(this) returns ref[Type]?
    {
        if unknown_union_type <> null
            return unknown_union_type
        if Checker.strict_null_checks() = false
        {
            set unknown_union_type: unknown_type
            return unknown_union_type
        }
        if unknown_empty_object_type = null
            set unknown_empty_object_type: this.new_anonymous_type(null, null, null, null, null)
        if unknown_empty_object_type = null
            return null
        let types &Array[ref[Type]?]()
        types.add(undefined_type)
        types.add(null_type)
        types.add(unknown_empty_object_type)
        let u this.get_union_type(types)
        if u = null
            return null
        set unknown_union_type: u
        unknown_union_type
    }

    ; IsNullableType.
    procedure is_nullable_type(this, t: ref[Type]) returns bool
        this.has_type_facts(t, TypeFactsIsUndefinedOrNull)

    ; GetNonNullableType.
    procedure get_non_nullable_type(this, t: ref[Type]) returns ref[Type]?
    {
        if Checker.strict_null_checks() = false
            return t
        this.get_adjusted_type_with_facts(t, TypeFactsNEUndefinedOrNull)
    }

    ; getNonNullableTypeIfNeeded.
    procedure get_non_nullable_type_if_needed(this, t: ref[Type]) returns ref[Type]?
    {
        if this.is_nullable_type(t) = false
            return t
        this.get_non_nullable_type(t)
    }

    ; getAdjustedTypeWithFacts — getTypeWithFacts with the two refinements the
    ; reference's own comment names: `unknown` is replaced by its union so the
    ; filter has constituents to work on, and an INSTANTIABLE constituent that can
    ; still be nullable is intersected with `{}` rather than left alone.
    ;
    ; ★★ THE `unknown` SUBSTITUTION IS WHAT MAKES `if (x)` NARROW AN `unknown`, and
    ; recombine_unknown_type is the other half: the filter answers a union whose
    ; identity is unknownUnionType exactly when nothing was removed, and the caller
    ; must see `unknown` again rather than the expansion.
    procedure get_adjusted_type_with_facts(this, t: ref[Type], facts: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        var input t
        if Checker.strict_null_checks()
        {
            if (t.flags & TypeFlagsUnknown) <> 0
            {
                let uu this.get_unknown_union_type()
                if uu = null
                    return null
                set input: uu as ref[Type]
            }
        }
        let filtered this.get_type_with_facts(input, facts)
        if this.unported_mark() <> mark
            return null
        if filtered = null
            return null
        let reduced this.recombine_unknown_type(filtered as ref[Type])
        if Checker.strict_null_checks() = false
            return reduced
        if facts = TypeFactsNEUndefined
            return this.remove_nullable_by_intersection(reduced, TypeFactsEQUndefined, TypeFactsEQNull, TypeFactsIsNull, null_type)
        if facts = TypeFactsNENull
            return this.remove_nullable_by_intersection(reduced, TypeFactsEQNull, TypeFactsEQUndefined, TypeFactsIsUndefined, undefined_type)
        var non_nullable false
        if facts = TypeFactsNEUndefinedOrNull
            set non_nullable: true
        if facts = TypeFactsTruthy
            set non_nullable: true
        if non_nullable
            return this.map_type_to_non_nullable_instantiation(reduced)
        reduced
    }

    ; The closure of getAdjustedTypeWithFacts' NEUndefinedOrNull/Truthy arm,
    ; §3.5e's rule: mapType over `hasTypeFacts(t, EQUndefinedOrNull)` ->
    ; getGlobalNonNullableTypeInstantiation.
    procedure map_type_to_non_nullable_instantiation(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & TypeFlagsUnion) = 0
        {
            if this.has_type_facts(t, TypeFactsEQUndefinedOrNull) = false
                return t
            return this.get_global_non_nullable_type_instantiation(t)
        }
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            var m: ref[Type]? s
            if this.has_type_facts(s, TypeFactsEQUndefinedOrNull)
                set m: this.get_global_non_nullable_type_instantiation(s)
            if this.unported_mark() <> mark
                return null
            if m = null
                return null
            if (m as ref[Type]) <> s
                set changed: true
            mapped.add(m)
        }
        if changed = false
            return t
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }

    ; getGlobalTypeAliasSymbol, slice 125 — the same shape as
    ; get_global_generic_type above, asking SymbolFlagsTypeAlias and checking the
    ; ARITY. ★The declared type is resolved for its side effect: it is what fills
    ; the link's type parameters, which is the only thing the arity can be read
    ; off. ★`reportErrors` is not taken: both call sites this port has pass it
    ; differently upstream and neither diagnostic is reachable — the message is
    ; *Cannot find global type*, which needs a lib without `Record`, and this
    ; harness fixes the lib set.
    procedure get_global_type_alias_symbol(this, name: Slice[char], arity: int) returns ref[Symbol]?
    {
        let symbol this.lookup_globals(name, SymbolFlagsTypeAlias)
        if symbol = null
            return null
        let sym symbol as ref[Symbol]
        let mark this.unported_mark()
        this.get_declared_type_of_symbol(sym)
        if this.unported_mark() <> mark
            return null
        let links this.type_alias_link_of(sym)
        var n 0
        if links.type_parameters <> null
            set n: (links.type_parameters as ref[Array[ref[Type]?]]).get_length() as int
        if n <> arity
            return null
        symbol
    }

    ; getGlobalNonNullableTypeInstantiation, whole since slice 125.
    ;
    ; ★★★ THE FALLBACK IS STILL NOT AVAILABLE AND THAT IS WHY IT STAYS WRITTEN.
    ; The reference intersects with `{}` only when the lib carries NO `NonNullable`
    ; alias; this port DOES read lib.es5.d.ts (slice 113), so the alias is there
    ; and the branch that answers it is the live one. The stop that stood here
    ; named getTypeAliasInstantiation and that function is this slice's.
    procedure get_global_non_nullable_type_instantiation(this, t: ref[Type]) returns ref[Type]?
    {
        var nd Slice[char]()
        set nd: Checker.plain_name(host, "NonNullable")
        let mark this.unported_mark()
        let alias this.get_global_type_alias_symbol(nd, 1)
        if this.unported_mark() <> mark
            return null
        if alias <> null
        {
            let args this.new_type_list_of(1)
            args.add(t)
            return this.get_type_alias_instantiation(alias as ref[Symbol], args, null)
        }
        let pair &Array[ref[Type]?]()
        pair.add(t)
        pair.add(empty_object_type)
        this.get_intersection_type(pair)
    }

    ; removeNullableByIntersection — the arm that keeps `T extends unknown` from
    ; losing its nullability silently.
    procedure remove_nullable_by_intersection(this, t: ref[Type], target_facts: int, other_facts: int, other_includes_facts: int, other_type: ref[Type]) returns ref[Type]?
    {
        let facts this.get_type_facts(t, TypeFactsEQUndefined | TypeFactsEQNull | TypeFactsIsUndefined | TypeFactsIsNull)
        if (facts & target_facts) = 0
            return t
        if empty_object_type = null
            return t
        let empty_and_other &Array[ref[Type]?]()
        empty_and_other.add(empty_object_type)
        empty_and_other.add(other_type)
        let eo this.get_union_type(empty_and_other)
        if eo = null
            return null
        this.map_type_by_nullable_intersection(t, facts, target_facts, other_facts, other_includes_facts, eo as ref[Type])
    }

    ; removeNullableByIntersection's closure, §3.5e's rule again. ★The captured
    ; `facts` is the WHOLE type's facts and the per-constituent test asks the
    ; constituent's — reading one for the other is the mistake this parameter list
    ; exists to prevent.
    procedure map_type_by_nullable_intersection(this, t: ref[Type], facts: int, target_facts: int, other_facts: int, other_includes_facts: int, empty_and_other: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & TypeFlagsUnion) = 0
            return this.intersect_one_for_nullable(t, facts, target_facts, other_facts, other_includes_facts, empty_and_other)
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            let m this.intersect_one_for_nullable(s, facts, target_facts, other_facts, other_includes_facts, empty_and_other)
            if this.unported_mark() <> mark
                return null
            if m = null
                return null
            if (m as ref[Type]) <> s
                set changed: true
            mapped.add(m)
        }
        if changed = false
            return t
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }

    procedure intersect_one_for_nullable(this, t: ref[Type], facts: int, target_facts: int, other_facts: int, other_includes_facts: int, empty_and_other: ref[Type]) returns ref[Type]?
    {
        if this.has_type_facts(t, target_facts) = false
            return t
        let pair &Array[ref[Type]?]()
        pair.add(t)
        if (facts & other_includes_facts) = 0
        {
            if this.has_type_facts(t, other_facts)
            {
                pair.add(empty_and_other)
                return this.get_intersection_type(pair)
            }
        }
        pair.add(empty_object_type)
        this.get_intersection_type(pair)
    }

    ; ── the key property, and why it costs almost nothing here ──────────────
    ;
    ; ★★★ getKeyPropertyName IS A GUARD BEFORE IT IS A LOOKUP, and the guard is
    ; the whole function on this corpus: computeKeyPropertyNameAndMap answers
    ; `missing` unless the union has TEN OR MORE constituents of which ten are
    ; object-like. The map behind it is a *speed* structure for very large
    ; discriminated unions — `getConstituentTypeForKeyType` is an O(1) route to a
    ; constituent the ordinary filter finds by walking — so the arms that read it
    ; all have a non-key path directly beneath them.
    ;
    ; ★ It is NOT memoised here where the reference memoises it on the union type,
    ; and the reason is that the computation is now the guard: three field reads
    ; and a count. The memo comes back with the candidate half.
    ; ★★★ THE MEMO IS BACK SINCE SLICE 130, AND IT HAS TO BE: the map is what
    ; getConstituentTypeForKeyType reads, and a second reader must see the SAME
    ; map — the entries are keyed by type identity, so rebuilding it would be
    ; correct but the duplicate sentinel makes it a decision, not a lookup. The
    ; note that stood here (*not memoised, the computation is now the guard*) was
    ; true only while the candidate half was a stop.
    procedure get_key_property_name(this, t: ref[Type], out_name: ref[Slice[char]]) returns bool
    {
        set out_name.data: null
        set out_name.length: 0
        if Checker.union_key_property_computed(t) = false
            this.compute_key_property_name_and_map(t)
        let d Checker.union_key_property(t)
        if d.data = null
            return false
        set out_name.data: d.data
        set out_name.length: Checker.union_key_property_len(t)
        true
    }

    ; getConstituentTypeForKeyType — the O(1) route the map exists for. The
    ; reference's `unknownType` value is the DUPLICATE sentinel: two constituents
    ; carrying the same key select neither.
    procedure get_constituent_type_for_key_type(this, t: ref[Type], key_type: ref[Type]) returns ref[Type]?
    {
        let map Checker.union_constituent_map(t)
        if map = null
            return null
        let regular this.get_regular_type_of_literal_type(key_type)
        if regular = null
            return null
        let list map as ref[Array[ref[ConstituentMapEntry]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let e row as ref[ConstituentMapEntry]
                if e.key = (regular as ref[Type])
                {
                    if e.value = null
                        return null
                    if (e.value as ref[Type]) = unknown_type
                        return null
                    return e.value
                }
            }
            set i: i + 1
        }
        null
    }

    ; computeKeyPropertyNameAndMap, whole, plus the memo write.
    ;
    ; ★★★ THE THREE REFUSALS ARE A COST MODEL AND NOT A CORRECTNESS RULE, which is
    ; why the map is safe to be absent: fewer than ten constituents, a primitive
    ; union, or fewer than ten object-like constituents, and the reference answers
    ; *missing* — every reader then walks the union instead. So a wrong answer
    ; here is a wrong ANSWER (a map that selects the wrong constituent), never a
    ; missing one, which is what makes the duplicate sentinel load-bearing.
    procedure compute_key_property_name_and_map(this, t: ref[Type])
    {
        Checker.set_union_key_property(t, Slice[char](), null)
        let types Checker.union_types_of(t)
        if types = null
            return
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        if n < 10
            return
        if (t.object_flags & ObjectFlagsPrimitiveUnion) <> 0
            return
        var objectish 0
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            if (s.flags & (TypeFlagsObject | TypeFlagsInstantiableNonPrimitive)) <> 0
                set objectish: objectish + 1
        }
        if objectish < 10
            return
        var cand_data Slice[char]()
        if this.get_key_property_candidate_name(list, &cand_data) = false
            return
        let map this.map_types_by_key_property(list, cand_data)
        if map = null
            return
        Checker.set_union_key_property(t, cand_data, map)
    }

    ; getKeyPropertyCandidateName — the FIRST unit-typed property of the first
    ; object-like constituent that has one. It is a candidate and not the answer:
    ; mapTypesByKeyProperty refuses the name if it does not discriminate.
    procedure get_key_property_candidate_name(this, types: ref[Array[ref[Type]?]], out_name: ref[Slice[char]]) returns bool
    {
        let mark this.unported_mark()
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let row types[i]
            set i: i + 1
            if row = null
                continue
            let ty row as ref[Type]
            if (ty.flags & (TypeFlagsObject | TypeFlagsInstantiableNonPrimitive)) = 0
                continue
            let props this.get_properties_of_type(ty)
            if this.unported_mark() <> mark
                return false
            if props = null
                continue
            let plist props as ref[Array[ref[Symbol]?]]
            let pn plist.get_length() as int
            var j 0
            while j < pn
            {
                let prow plist[j]
                set j: j + 1
                if prow = null
                    continue
                let ps prow as ref[Symbol]
                let pt this.get_type_of_symbol(ps)
                if this.unported_mark() <> mark
                    return false
                if pt = null
                    continue
                if Checker.is_unit_type(pt as ref[Type])
                {
                    set out_name.data: Symbol.name_of(ps).data
                    set out_name.length: Symbol.name_len_of(ps)
                    return true
                }
            }
        }
        false
    }

    ; mapTypesByKeyProperty — the map itself, and the two conditions at its tail
    ; are what make the name a KEY rather than merely a property: at least ten
    ; constituents must carry a UNIQUE key, and they must be at least half of the
    ; union. A non-literal key anywhere refuses the whole map.
    procedure map_types_by_key_property(this, types: ref[Array[ref[Type]?]], name_data: Slice[char]) returns ref[Array[ref[ConstituentMapEntry]?]]?
    {
        let mark this.unported_mark()
        let out &Array[ref[ConstituentMapEntry]?]^host()
        let n types.get_length() as int
        var count 0
        var i 0
        while i < n
        {
            let row types[i]
            set i: i + 1
            if row = null
                continue
            let ty row as ref[Type]
            if (ty.flags & (TypeFlagsObject | TypeFlagsIntersection | TypeFlagsInstantiableNonPrimitive)) = 0
                continue
            let discriminant this.get_type_of_property_of_type(ty, name_data)
            if this.unported_mark() <> mark
                return null
            if discriminant = null
                return null
            let dt discriminant as ref[Type]
            if Checker.is_literal_type(dt) = false
                return null
            var duplicate false
            let parts this.distributed_types(dt)
            let pn parts.get_length() as int
            var j 0
            while j < pn
            {
                let prow parts[j]
                set j: j + 1
                if prow = null
                    continue
                let key this.get_regular_type_of_literal_type(prow as ref[Type])
                if key = null
                    return null
                let existing Checker.constituent_entry_for(out, key as ref[Type])
                if existing = null
                    out.add(&ConstituentMapEntry^host(key, ty))
                else
                {
                    let e existing as ref[ConstituentMapEntry]
                    var already_duplicate false
                    if e.value <> null
                    {
                        if (e.value as ref[Type]) = unknown_type
                            set already_duplicate: true
                    }
                    if already_duplicate = false
                    {
                        set e.value: unknown_type
                        set duplicate: true
                    }
                }
            }
            if duplicate = false
                set count: count + 1
        }
        if count < 10
            return null
        if (count * 2) < n
            return null
        out
    }

    function constituent_entry_for(list: ref[Array[ref[ConstituentMapEntry]?]], key: ref[Type]) returns ref[ConstituentMapEntry]?
    {
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let e row as ref[ConstituentMapEntry]
                if e.key = key
                    return e
            }
            set i: i + 1
        }
        null
    }

    ; ── the union's key-property slots ──────────────────────────────────────

    function union_key_property_computed(t: ref[Type]) returns bool
    {
        choose t.data
            when u: Union
                return u.key_property_computed
        false
    }

    function union_key_property(t: ref[Type]) returns Slice[char]
    {
        choose t.data
            when u: Union
                return u.key_property
        Slice[char]()
    }

    function union_key_property_len(t: ref[Type]) returns int
    {
        choose t.data
            when u: Union
                return u.key_property.length
        0
    }

    function union_constituent_map(t: ref[Type]) returns ref[Array[ref[ConstituentMapEntry]?]]?
    {
        choose t.data
            when u: Union
                return u.constituent_map
        null
    }

    procedure set_union_key_property(t: ref[Type], name_data: Slice[char], map: ref[Array[ref[ConstituentMapEntry]?]]?)
    {
        choose t.data
            when u: Union
            {
                var d u
                set d.key_property_computed: true
                set d.key_property: name_data
                set d.constituent_map: map
                set t.data: TypeData.Union(d)
            }
    }

    ; isDiscriminantProperty, WHOLE (slice 127) — its input is a union's SYNTHETIC
    ; property, which is getUnionOrIntersectionProperty's product, and that is now
    ; here.
    ;
    ; ★★ THE ANSWER IS MEMOISED ON THE PROPERTY and the memo is two CHECK FLAGS
    ; rather than a table, because the symbol is itself synthesized and cached: the
    ; same symbol object comes back for the same (type, name), so a bit on it is a
    ; per-pair memo. That is the whole reason getUnionOrIntersectionProperty's
    ; cache has to answer the SAME symbol.
    ;
    ; ★ A discriminant is a property with NON-UNIFORM types of which at least one
    ; is a literal, and whose type is not generic — the reference's exact mask,
    ; without the `HasNeverType` veto isDiscriminantWithNeverType adds.
    procedure is_discriminant_property(this, t: ref[Type]?, d: Slice[char]) returns bool
    {
        if t = null
            return false
        let ty t as ref[Type]
        if (ty.flags & TypeFlagsUnion) = 0
            return false
        let mark this.unported_mark()
        let prop this.get_union_or_intersection_property(ty, d, false)
        if this.unported_mark() <> mark
            return false
        if prop = null
            return false
        let p prop as ref[Symbol]
        if (Symbol.check_flags_of(p) & CheckFlagsSyntheticProperty) = 0
            return false
        if (Symbol.check_flags_of(p) & CheckFlagsIsDiscriminantComputed) = 0
        {
            Symbol.set_check_flags(p, Symbol.check_flags_of(p) | CheckFlagsIsDiscriminantComputed)
            if (Symbol.check_flags_of(p) & CheckFlagsNonUniformAndLiteral) = CheckFlagsNonUniformAndLiteral
            {
                let pt this.get_type_of_symbol(p)
                if this.unported_mark() <> mark
                    return false
                if pt <> null
                {
                    if this.is_generic_type(pt as ref[Type]) = false
                        Symbol.set_check_flags(p, Symbol.check_flags_of(p) | CheckFlagsIsDiscriminant)
                    if this.unported_mark() <> mark
                        return false
                }
            }
        }
        (Symbol.check_flags_of(p) & CheckFlagsIsDiscriminant) <> 0
    }

    ; ── the type predicate (slice 123) ──────────────────────────────────────
    ;
    ; ★★★ IT IS PORTED HERE BECAUSE THE NARROWING ENGINE IS BLIND WITHOUT IT, not
    ; because checkTypePredicate wanted it: getTypeAtFlowCall, narrowTypeByCallExpression,
    ; narrowTypeByInstanceof's `[Symbol.hasInstance]` arm and isReachableFlowNode's
    ; Call arm all ask getEffectsSignature, and getEffectsSignature's last line is
    ; hasTypePredicateOrNeverReturnType. Leaving the predicate stopped would have
    ; made four of this slice's chapters answer nothing — §3.5dk from the outside,
    ; the shape slice 122 met twice.

    ; createTypePredicateFromTypePredicateNode.
    procedure create_type_predicate_from_type_predicate_node(this, node: ref[AstNode], signature: ref[Signature]) returns ref[TypePredicate]?
    {
        let mark this.unported_mark()
        var t: ref[Type]? null
        let type_node AstNode.type_of(node)
        if type_node <> null
        {
            set t: this.get_type_from_type_node(type_node as ref[AstNode])
            if this.unported_mark() <> mark
                return null
        }
        let param_name AstNode.type_predicate_parameter_name_of(node)
        if param_name = null
            return null
        let pn param_name as ref[AstNode]
        let asserts AstNode.type_predicate_asserts_modifier_of(node)
        if AstNode.kind_of(pn) = KindThisType
        {
            var kind TypePredicateKindThis
            if asserts <> null
                set kind: TypePredicateKindAssertsThis
            return &TypePredicate^this(kind, 0, Slice[char](), t)
        }
        var kind TypePredicateKindIdentifier
        if asserts <> null
            set kind: TypePredicateKindAssertsIdentifier
        let name_data AstNode.identifier_text_of(pn)
        let name_len AstNode.identifier_text_length_of(pn)
        var index 0 - 1
        let params signature.parameters
        if params <> null
        {
            let list params as ref[Array[ref[Symbol]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row <> null
                {
                    if SymbolTable.names_equal(Symbol.name_of(row as ref[Symbol]), name_data)
                    {
                        set index: i
                        set i: n
                    }
                }
                set i: i + 1
            }
        }
        &TypePredicate^this(kind, index, name_data, t)
    }

    ; instantiateTypePredicate.
    procedure instantiate_type_predicate(this, predicate: ref[TypePredicate], m: ref[TypeMapper]?) returns ref[TypePredicate]?
    {
        let mark this.unported_mark()
        let t this.instantiate_type(predicate.t, m)
        if this.unported_mark() <> mark
            return null
        if t = predicate.t
            return predicate
        &TypePredicate^this(predicate.kind, predicate.parameter_index, predicate.parameter_name, t)
    }

    ; getTypePredicateOfSignature.
    ;
    ; ★★ THE SENTINEL IS A BOOLEAN HERE. Upstream `noTypePredicate` is a shared
    ; object stored in the slot so that *computed, none* differs from *not
    ; computed*; a `computed` flag beside a nullable slot is the same program with
    ; one fewer object, and it is what the record carries.
    ;
    ; ★★★ THE COMPOSITE ARM ARRIVED IN SLICE 155 WITH ITS PRODUCER, exactly as the
    ; note that stood here predicted (*"the day getUnionSignatures arrives it comes
    ; with its own reader"*). It is the one deferral of this family that named the
    ; right event.
    procedure get_type_predicate_of_signature(this, sig: ref[Signature]) returns ref[TypePredicate]?
    {
        if sig.type_predicate_computed
            return sig.resolved_type_predicate
        let mark this.unported_mark()
        ; ★ NOT memoized before the computation completes (slice 210). The reference parks
        ; `noTypePredicate` in the slot ONLY in the inferred arm below (*"avoid infinite
        ; loop"*); every other arm stores at the END, so a NESTED ask for the same signature
        ; recomputes — which is how the predicate's `arg is First` reaches the alias cycle a
        ; second time and reports TS2456 (`controlFlowFunctionLikeCircular_8`, together with
        ; get_effects_signature's memo). The guard that stood here for every arm answered the
        ; nested ask with "no predicate". A stop memoizes nothing.
        if sig.target <> null
        {
            let target_predicate this.get_type_predicate_of_signature(sig.target as ref[Signature])
            if this.unported_mark() <> mark
                return null
            var inst: ref[TypePredicate]? null
            if target_predicate <> null
                set inst: this.instantiate_type_predicate(target_predicate as ref[TypePredicate], sig.mapper)
            if this.unported_mark() <> mark
                return null
            set sig.resolved_type_predicate: inst
            set sig.type_predicate_computed: true
            return sig.resolved_type_predicate
        }
        ; The COMPOSITE arm (slice 155) stands where the reference puts it, between the
        ; instantiated arm and the declaration's own.
        if sig.composite <> null
        {
            let comp sig.composite as ref[CompositeSignature]
            let pred this.get_union_or_intersection_type_predicate(comp.signatures, comp.is_union)
            if this.unported_mark() <> mark
                return null
            set sig.resolved_type_predicate: pred
            set sig.type_predicate_computed: true
            return sig.resolved_type_predicate
        }
        let decl sig.declaration
        if decl = null
        {
            set sig.type_predicate_computed: true
            return null
        }
        let d decl as ref[AstNode]
        let type_node AstNode.type_of(d)
        if type_node <> null
        {
            var pred: ref[TypePredicate]? null
            if AstNode.kind_of(type_node as ref[AstNode]) = KindTypePredicate
                set pred: this.create_type_predicate_from_type_predicate_node(type_node as ref[AstNode], sig)
            if this.unported_mark() <> mark
                return null
            set sig.resolved_type_predicate: pred
            set sig.type_predicate_computed: true
            return sig.resolved_type_predicate
        }
        var inferable AstNode.is_function_like_declaration(d)
        if inferable
        {
            if sig.resolved_return_type <> null
            {
                if ((sig.resolved_return_type as ref[Type]).flags & TypeFlagsBoolean) = 0
                    set inferable: false
            }
        }
        if inferable
        {
            if this.get_parameter_count(sig) = 0
                set inferable: false
        }
        if inferable = false
        {
            set sig.type_predicate_computed: true
            return null
        }
        ; getTypePredicateFromBody — the INFERRED predicate of TS 5.5, ported in
        ; slice 134; see its own header for what the flow walk asks. ★This is the one arm
        ; where the reference itself parks a sentinel in the slot BEFORE recursing
        ; (`sig.resolvedTypePredicate = c.noTypePredicate // avoid infinite loop`); the flag
        ; stays set across the walk and is cleared only on a stop.
        set sig.type_predicate_computed: true
        set sig.resolved_type_predicate: null
        let inferred this.get_type_predicate_from_body(d)
        if this.unported_mark() <> mark
        {
            set sig.type_predicate_computed: false
            return null
        }
        set sig.resolved_type_predicate: inferred
        sig.resolved_type_predicate
    }

    ; hasTypePredicateOrNeverReturnType — getEffectsSignature's last test, and the
    ; one that decides whether a call node carries an effect at all.
    procedure has_type_predicate_or_never_return_type(this, sig: ref[Signature]) returns bool
    {
        let mark this.unported_mark()
        let predicate this.get_type_predicate_of_signature(sig)
        if this.unported_mark() <> mark
            return false
        if predicate <> null
            return true
        if sig.declaration = null
            return false
        let annotated this.get_return_type_from_annotation(sig.declaration as ref[AstNode])
        if this.unported_mark() <> mark
            return false
        if annotated = null
            return false
        ((annotated as ref[Type]).flags & TypeFlagsNever) <> 0
    }

    ; ── slice 123: narrowType and its family ────────────────────────────────
    ;
    ; ★★★ THE ENGINE IS ONE DISPATCH AND TWENTY-FOUR ARMS, and what every arm ends
    ; in is one of the four operations the section above builds. `narrow_type` is
    ; the door getTypeAtFlowCondition knocks on; everything below it is reached
    ; from there, from the switch clause, or from the assertion.

    ; isNonNullAccess.
    function is_non_null_access(node: ref[AstNode]) returns bool
    {
        if Parser.is_access_expression(node) = false
            return false
        let e AstNode.expression_of(node)
        if e = null
            return false
        AstNode.kind_of(e as ref[AstNode]) = KindNonNullExpression
    }

    ; getReferenceCandidate — the assignment/comma/parenthesis descent, downward,
    ; and the twin of get_reference_root's climb.
    function get_reference_candidate(node: ref[AstNode]) returns ref[AstNode]
    {
        var n node
        repeat
        {
            let k AstNode.kind_of(n)
            if k = KindParenthesizedExpression
            {
                let e AstNode.expression_of(n)
                if e = null
                    return n
                set n: e as ref[AstNode]
                continue
            }
            if k <> KindBinaryExpression
                return n
            let op AstNode.binary_operator_kind(n)
            var take_left false
            if op = KindEqualsToken
                set take_left: true
            if op = KindBarBarEqualsToken
                set take_left: true
            if op = KindAmpersandAmpersandEqualsToken
                set take_left: true
            if op = KindQuestionQuestionEqualsToken
                set take_left: true
            if take_left
            {
                let l AstNode.binary_left_of(n)
                if l = null
                    return n
                set n: l as ref[AstNode]
                continue
            }
            if op = KindCommaToken
            {
                let r AstNode.binary_right_of(n)
                if r = null
                    return n
                set n: r as ref[AstNode]
                continue
            }
            return n
        }
    }

    ; isOrContainsMatchingReference.
    procedure is_or_contains_matching_reference(this, source: ref[AstNode], target: ref[AstNode]) returns bool
    {
        if this.is_matching_reference(source, target)
            return true
        this.contains_matching_reference(source, target)
    }

    ; hasMatchingArgument.
    procedure has_matching_argument(this, expression: ref[AstNode], reference: ref[AstNode]) returns bool
    {
        let args AstNode.call_arguments_of(expression)
        let n AstNode.list_count(args)
        var i 0
        while i < n
        {
            let arg AstNode.child_in_list(args, i)
            set i: i + 1
            if arg = null
                continue
            let a arg as ref[AstNode]
            if this.is_or_contains_matching_reference(reference, a)
                return true
            if this.optional_chain_contains_reference(a, reference)
                return true
        }
        let callee AstNode.expression_of(expression)
        if callee = null
            return false
        let c callee as ref[AstNode]
        if AstNode.kind_of(c) <> KindPropertyAccessExpression
            return false
        let recv AstNode.expression_of(c)
        if recv = null
            return false
        this.is_or_contains_matching_reference(reference, recv as ref[AstNode])
    }

    ; isCoercibleUnderDoubleEquals.
    function is_coercible_under_double_equals(source: ref[Type], target: ref[Type]) returns bool
    {
        if (source.flags & (TypeFlagsNumber | TypeFlagsString | TypeFlagsBooleanLiteral)) = 0
            return false
        (target.flags & (TypeFlagsNumber | TypeFlagsString | TypeFlagsBoolean)) <> 0
    }

    ; ── narrow_type_by_discriminant's four closures, as a TAG (§3.5e) ───────
    ;
    ; ★★★ THIS IS THE ONE SITE IN THE CHAPTER WHERE THE FUNC VALUE IS NOT STATIC:
    ; narrowTypeByDiscriminant is called from five places with five different
    ; closures, so neither a per-call-site copy of its filter nor a boolean will
    ; do. The tag plus the four values the closures capture is the same program —
    ; and it is the ONLY delegate-shaped thing in the section, which is why it is
    ; named here rather than buried at a call site.
    procedure apply_narrow_kind(this, t: ref[Type], nk: int, cand: ref[Type]?, value: ref[AstNode]?, op: int, assume_true: bool, data: ref[AstNode]?) returns ref[Type]?
    {
        if nk = NarrowKindNarrowedType
        {
            if cand = null
                return t
            return this.get_narrowed_type(t, cand as ref[Type], assume_true, false)
        }
        if nk = NarrowKindOptionality
        {
            var facts TypeFactsEQUndefinedOrNull
            if assume_true
                set facts: TypeFactsNEUndefinedOrNull
            return this.get_type_with_facts(t, facts)
        }
        if nk = NarrowKindTruthiness
        {
            var facts TypeFactsFalsy
            if assume_true
                set facts: TypeFactsTruthy
            return this.get_type_with_facts(t, facts)
        }
        if nk = NarrowKindLiteralExpression
        {
            if value = null
                return t
            return this.narrow_type_by_literal_expression(t, value as ref[AstNode], assume_true)
        }
        if nk = NarrowKindEquality
        {
            if value = null
                return t
            return this.narrow_type_by_equality(t, op, value as ref[AstNode], assume_true)
        }
        if nk = NarrowKindSwitchOnDiscriminant
        {
            if data = null
                return t
            return this.narrow_type_by_switch_on_discriminant(t, data as ref[AstNode])
        }
        t
    }

    ; narrowTypeByDiscriminant. ★Its own filter is the second half and it is what
    ; makes the arm a NARROWING rather than a property lookup: the property type is
    ; narrowed once, and then every constituent whose discriminant cannot compare
    ; equal to the result is dropped.
    procedure narrow_type_by_discriminant(this, t: ref[Type], access: ref[AstNode], nk: int, cand: ref[Type]?, value: ref[AstNode]?, op: int, assume_true: bool, data: ref[AstNode]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        var prop_data Slice[char]()
        if this.get_accessed_property_name(access, &prop_data) = false
            return t
        if this.unported_mark() <> mark
            return null
        let optional_chain Binder.is_optional_chain(access)
        var remove_nullable false
        if Checker.strict_null_checks()
        {
            var accessish optional_chain
            if Checker.is_non_null_access(access)
                set accessish: true
            if accessish
            {
                if Checker.maybe_type_of_kind(t, TypeFlagsNullable)
                    set remove_nullable: true
            }
        }
        var non_null_type t
        if remove_nullable
        {
            let nn this.get_type_with_facts(t, TypeFactsNEUndefinedOrNull)
            if this.unported_mark() <> mark
                return null
            if nn = null
                return null
            set non_null_type: nn as ref[Type]
        }
        var prop_type this.get_type_of_property_of_type(non_null_type, prop_data)
        if this.unported_mark() <> mark
            return null
        if prop_type = null
            return t
        if remove_nullable
        {
            if optional_chain
            {
                set prop_type: this.get_optional_type(prop_type as ref[Type], false)
                if this.unported_mark() <> mark
                    return null
                if prop_type = null
                    return null
            }
        }
        let narrowed this.apply_narrow_kind(prop_type as ref[Type], nk, cand, value, op, assume_true, data)
        if this.unported_mark() <> mark
            return null
        if narrowed = null
            return null
        this.filter_type_by_discriminant(t, narrowed as ref[Type], prop_data)
    }

    ; narrowTypeByDiscriminant's own filterType closure.
    procedure filter_type_by_discriminant(this, t: ref[Type], narrowed_prop_type: ref[Type], d: Slice[char]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let keep this.discriminant_constituent_survives(row as ref[Type], narrowed_prop_type, d)
                if this.unported_mark() <> mark
                    return null
                if keep
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let keep this.discriminant_constituent_survives(t, narrowed_prop_type, d)
        if this.unported_mark() <> mark
            return null
        if keep
            return t
        never_type
    }

    procedure discriminant_constituent_survives(this, t: ref[Type], narrowed_prop_type: ref[Type], d: Slice[char]) returns bool
    {
        let mark this.unported_mark()
        var discriminant_type unknown_type
        let found this.get_type_of_property_or_index_signature_of_type(t, d)
        if this.unported_mark() <> mark
            return false
        if found <> null
            set discriminant_type: found as ref[Type]
        if (discriminant_type.flags & TypeFlagsNever) <> 0
            return false
        if (narrowed_prop_type.flags & TypeFlagsNever) <> 0
            return false
        this.are_types_comparable(narrowed_prop_type, discriminant_type)
    }

    ; getCandidateVariableDeclarationInitializer.
    function get_candidate_variable_declaration_initializer(node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        let n node as ref[AstNode]
        if AstNode.kind_of(n) <> KindVariableDeclaration
            return null
        if AstNode.type_of(n) <> null
            return null
        let ini AstNode.initializer_of(n)
        if ini = null
            return null
        Parser.skip_parentheses(ini)
    }

    ; getCandidateDiscriminantPropertyAccess — the SYNTACTIC half of the
    ; discriminant question; is_discriminant_property is the semantic half.
    procedure get_candidate_discriminant_property_access(this, f: ref[FlowState], expr: ref[AstNode]) returns ref[AstNode]?
    {
        let mark this.unported_mark()
        let reference f.reference as ref[AstNode]
        var pseudo false
        if AstNode.is_binding_pattern(reference)
            set pseudo: true
        if Checker.is_function_expression_or_arrow_function(reference)
            set pseudo: true
        if Checker.is_object_literal_method(reference)
            set pseudo: true
        if pseudo
        {
            if AstNode.kind_of(expr) <> KindIdentifier
                return null
            let symbol this.get_resolved_symbol(expr)
            if this.unported_mark() <> mark
                return null
            let exported this.get_export_symbol_of_value_symbol_if_exported(symbol)
            if exported = null
                return null
            let decl Symbol.value_declaration_of(exported as ref[Symbol])
            if decl = null
                return null
            let d decl as ref[AstNode]
            let dk AstNode.kind_of(d)
            var declish false
            if dk = KindBindingElement
                set declish: true
            if dk = KindParameter
                set declish: true
            if declish = false
                return null
            if AstNode.parent_node_of(d) <> reference
                return null
            if AstNode.initializer_of(d) <> null
                return null
            if AstNode.dot_dot_dot_token_of(d) <> null
                return null
            return d
        }
        if Parser.is_access_expression(expr)
        {
            let e AstNode.expression_of(expr)
            if e = null
                return null
            if this.is_matching_reference(reference, e as ref[AstNode])
                return expr
            return null
        }
        if AstNode.kind_of(expr) <> KindIdentifier
            return null
        let symbol this.get_resolved_symbol(expr)
        if this.unported_mark() <> mark
            return null
        if this.is_constant_variable(symbol) = false
            return null
        let decl Symbol.value_declaration_of(symbol)
        if decl = null
            return null
        let d decl as ref[AstNode]
        let initializer Checker.get_candidate_variable_declaration_initializer(d)
        if initializer <> null
        {
            let ini initializer as ref[AstNode]
            if Parser.is_access_expression(ini)
            {
                let e AstNode.expression_of(ini)
                if e <> null
                {
                    if this.is_matching_reference(reference, e as ref[AstNode])
                        return ini
                }
            }
        }
        if AstNode.kind_of(d) <> KindBindingElement
            return null
        if AstNode.initializer_of(d) <> null
            return null
        let grand AstNode.parent_node_of(AstNode.parent_node_of(d))
        let outer Checker.get_candidate_variable_declaration_initializer(grand)
        if outer = null
            return null
        let o outer as ref[AstNode]
        var namelike false
        if AstNode.kind_of(o) = KindIdentifier
            set namelike: true
        if Parser.is_access_expression(o)
            set namelike: true
        if namelike = false
            return null
        if this.is_matching_reference(reference, o) = false
            return null
        d
    }

    ; getDiscriminantPropertyAccess. ★The reference's own comment is the whole
    ; reason the DECLARED type is preferred: a preceding predicate may have
    ; narrowed the computed type down past the discriminant that is still there.
    procedure get_discriminant_property_access(this, f: ref[FlowState], expr: ref[AstNode], computed_type: ref[Type]) returns ref[AstNode]?
    {
        let mark this.unported_mark()
        let declared f.declared_type as ref[Type]
        var unionish false
        if (declared.flags & TypeFlagsUnion) <> 0
            set unionish: true
        if (computed_type.flags & TypeFlagsUnion) <> 0
            set unionish: true
        if unionish = false
            return null
        let access this.get_candidate_discriminant_property_access(f, expr)
        if this.unported_mark() <> mark
            return null
        if access = null
            return null
        let a access as ref[AstNode]
        var name_data Slice[char]()
        if this.get_accessed_property_name(a, &name_data) = false
            return null
        if this.unported_mark() <> mark
            return null
        var t computed_type
        if (declared.flags & TypeFlagsUnion) <> 0
        {
            if this.is_type_subset_of(computed_type, declared)
                set t: declared
        }
        if this.is_discriminant_property(t, name_data) = false
            return null
        if this.unported_mark() <> mark
            return null
        a
    }

    ; ── the arms ────────────────────────────────────────────────────────────

    ; narrowType — the dispatch. ★The optional-chain pre-test is FIRST and it is
    ; not part of the switch: `a?.b` narrows `a` as though the source read
    ; `a !== null && a !== undefined`, which is a statement about the PARENT and
    ; not about the expression's kind.
    procedure narrow_type(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var optional false
        if Binder.is_expression_of_optional_chain_root(expr)
            set optional: true
        let parent AstNode.parent_node_of(expr)
        if parent <> null
        {
            let p parent as ref[AstNode]
            if AstNode.kind_of(p) = KindBinaryExpression
            {
                let op AstNode.binary_operator_kind(p)
                var coalescing false
                if op = KindQuestionQuestionToken
                    set coalescing: true
                if op = KindQuestionQuestionEqualsToken
                    set coalescing: true
                if coalescing
                {
                    if AstNode.binary_left_of(p) = expr
                        set optional: true
                }
            }
        }
        if optional
            return this.narrow_type_by_optionality(f, t, expr, assume_true)
        let k AstNode.kind_of(expr)
        if k = KindIdentifier
        {
            ; "When narrowing a reference to a const variable … we inline up to
            ; five levels of aliased conditional expressions."
            if this.is_matching_reference(f.reference as ref[AstNode], expr) = false
            {
                if inline_level < 5
                {
                    let symbol this.get_resolved_symbol(expr)
                    if this.unported_mark() <> mark
                        return null
                    if this.is_constant_variable(symbol)
                    {
                        let declaration Symbol.value_declaration_of(symbol)
                        if declaration <> null
                        {
                            let d declaration as ref[AstNode]
                            var inlinable false
                            if AstNode.kind_of(d) = KindVariableDeclaration
                            {
                                if AstNode.type_of(d) = null
                                {
                                    if AstNode.initializer_of(d) <> null
                                        set inlinable: true
                                }
                            }
                            if inlinable
                            {
                                if this.is_constant_reference(f.reference as ref[AstNode])
                                {
                                    set inline_level: inline_level + 1
                                    let result this.narrow_type(f, t, AstNode.initializer_of(d) as ref[AstNode], assume_true)
                                    set inline_level: inline_level - 1
                                    return result
                                }
                                if this.unported_mark() <> mark
                                    return null
                            }
                        }
                    }
                }
            }
            return this.narrow_type_by_truthiness(f, t, expr, assume_true)
        }
        var truthy false
        if k = KindThisKeyword
            set truthy: true
        if k = KindSuperKeyword
            set truthy: true
        if k = KindPropertyAccessExpression
            set truthy: true
        if k = KindElementAccessExpression
            set truthy: true
        if truthy
            return this.narrow_type_by_truthiness(f, t, expr, assume_true)
        if k = KindCallExpression
            return this.narrow_type_by_call_expression(f, t, expr, assume_true)
        var transparent false
        if k = KindParenthesizedExpression
            set transparent: true
        if k = KindNonNullExpression
            set transparent: true
        if k = KindSatisfiesExpression
            set transparent: true
        if transparent
        {
            let e AstNode.expression_of(expr)
            if e = null
                return t
            return this.narrow_type(f, t, e as ref[AstNode], assume_true)
        }
        if k = KindBinaryExpression
            return this.narrow_type_by_binary_expression(f, t, expr, assume_true)
        if k = KindPrefixUnaryExpression
        {
            if AstNode.prefix_unary_operator_kind(expr) = KindExclamationToken
            {
                let operand AstNode.prefix_unary_operand_of(expr)
                if operand = null
                    return t
                var flipped true
                if assume_true
                    set flipped: false
                return this.narrow_type(f, t, operand as ref[AstNode], flipped)
            }
        }
        t
    }

    ; narrowTypeByOptionality.
    procedure narrow_type_by_optionality(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], assume_present: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if this.is_matching_reference(f.reference as ref[AstNode], expr)
        {
            var facts TypeFactsEQUndefinedOrNull
            if assume_present
                set facts: TypeFactsNEUndefinedOrNull
            return this.get_adjusted_type_with_facts(t, facts)
        }
        let access this.get_discriminant_property_access(f, expr, t)
        if this.unported_mark() <> mark
            return null
        if access = null
            return t
        this.narrow_type_by_discriminant(t, access as ref[AstNode], NarrowKindOptionality, null, null, KindUnknown, assume_present, null)
    }

    ; narrowTypeByTruthiness.
    procedure narrow_type_by_truthiness(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let reference f.reference as ref[AstNode]
        if this.is_matching_reference(reference, expr)
        {
            var facts TypeFactsFalsy
            if assume_true
                set facts: TypeFactsTruthy
            return this.get_adjusted_type_with_facts(t, facts)
        }
        var cur t
        if Checker.strict_null_checks()
        {
            if assume_true
            {
                if this.optional_chain_contains_reference(expr, reference)
                {
                    let adjusted this.get_adjusted_type_with_facts(t, TypeFactsNEUndefinedOrNull)
                    if this.unported_mark() <> mark
                        return null
                    if adjusted = null
                        return null
                    set cur: adjusted as ref[Type]
                }
            }
        }
        let access this.get_discriminant_property_access(f, expr, cur)
        if this.unported_mark() <> mark
            return null
        if access = null
            return cur
        this.narrow_type_by_discriminant(cur, access as ref[AstNode], NarrowKindTruthiness, null, null, KindUnknown, assume_true, null)
    }

    ; narrowTypeByTypeFacts — the mapType behind every `typeof` name.
    procedure narrow_type_by_type_facts(this, t: ref[Type], implied_type: ref[Type], facts: int) returns ref[Type]?
    {
        ; `c.mapType(t, func(t) …)` — through map_type, never an inlined walk over the
        ; flattened members: mapType iterates the union's ORIGIN when it has one, which is
        ; what hands the enum `Color` back whole out of `Color | string`
        var a_value MapTypeArgs(implied_type, null, null, null, null, false, null, null, facts, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
        let a &a_value as ref[MapTypeArgs]?
        this.map_type_ex(t, MapTypeKindNarrowByTypeFacts, a, false)
    }

    procedure narrow_one_by_type_facts(this, t: ref[Type], implied_type: ref[Type], facts: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if this.is_type_related_to(t, implied_type, RelationStrictSubtype)
        {
            if this.unported_mark() <> mark
                return null
            if this.has_type_facts(t, facts)
                return t
            return never_type
        }
        if this.unported_mark() <> mark
            return null
        if this.is_type_subtype_of(implied_type, t)
            return implied_type
        if this.unported_mark() <> mark
            return null
        if this.has_type_facts(t, facts) = false
            return never_type
        let pair &Array[ref[Type]?]()
        pair.add(t)
        pair.add(implied_type)
        this.get_intersection_type(pair)
    }

    ; narrowTypeByTypeName — the eight `typeof` names plus the host-object
    ; fallback. ★`object` and `function` short-circuit on `any` because narrowing
    ; `any` to either would lose the any-ness the reference keeps.
    procedure narrow_type_by_type_name(this, t: ref[Type], name_data: Slice[char]) returns ref[Type]?
    {
        if Checker.name_is(name_data, "string")
            return this.narrow_type_by_type_facts(t, string_type, TypeFactsTypeofEQString)
        if Checker.name_is(name_data, "number")
            return this.narrow_type_by_type_facts(t, number_type, TypeFactsTypeofEQNumber)
        if Checker.name_is(name_data, "bigint")
            return this.narrow_type_by_type_facts(t, bigint_type, TypeFactsTypeofEQBigInt)
        if Checker.name_is(name_data, "boolean")
        {
            if boolean_type = null
                return null
            return this.narrow_type_by_type_facts(t, boolean_type as ref[Type], TypeFactsTypeofEQBoolean)
        }
        if Checker.name_is(name_data, "symbol")
            return this.narrow_type_by_type_facts(t, es_symbol_type, TypeFactsTypeofEQSymbol)
        if Checker.name_is(name_data, "undefined")
            return this.narrow_type_by_type_facts(t, undefined_type, TypeFactsEQUndefined)
        if Checker.name_is(name_data, "object")
        {
            if (t.flags & TypeFlagsAny) <> 0
                return t
            let mark this.unported_mark()
            let objectish this.narrow_type_by_type_facts(t, non_primitive_type, TypeFactsTypeofEQObject)
            if this.unported_mark() <> mark
                return null
            let nullish this.narrow_type_by_type_facts(t, null_type, TypeFactsEQNull)
            if this.unported_mark() <> mark
                return null
            if objectish = null
                return null
            if nullish = null
                return null
            let both &Array[ref[Type]?]()
            both.add(objectish)
            both.add(nullish)
            return this.get_union_type(both)
        }
        if Checker.name_is(name_data, "function")
        {
            if (t.flags & TypeFlagsAny) <> 0
                return t
            let gf this.get_global_function_type()
            if gf = null
                return null
            return this.narrow_type_by_type_facts(t, gf as ref[Type], TypeFactsTypeofEQFunction)
        }
        this.narrow_type_by_type_facts(t, non_primitive_type, TypeFactsTypeofEQHostObject)
    }

    ; typeofNEFacts, the reference's map, as the lookup it is.
    function typeof_ne_facts(d: Slice[char]) returns int
    {
        if Checker.name_is(d, "string")
            return TypeFactsTypeofNEString
        if Checker.name_is(d, "number")
            return TypeFactsTypeofNENumber
        if Checker.name_is(d, "bigint")
            return TypeFactsTypeofNEBigInt
        if Checker.name_is(d, "boolean")
            return TypeFactsTypeofNEBoolean
        if Checker.name_is(d, "symbol")
            return TypeFactsTypeofNESymbol
        if Checker.name_is(d, "undefined")
            return TypeFactsNEUndefined
        if Checker.name_is(d, "object")
            return TypeFactsTypeofNEObject
        if Checker.name_is(d, "function")
            return TypeFactsTypeofNEFunction
        TypeFactsTypeofNEHostObject
    }

    ; narrowTypeByLiteralExpression.
    procedure narrow_type_by_literal_expression(this, t: ref[Type], literal: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let d AstNode.literal_text_of(literal)
        let n AstNode.literal_text_length_of(literal)
        if assume_true
            return this.narrow_type_by_type_name(t, d)
        this.get_adjusted_type_with_facts(t, Checker.typeof_ne_facts(d))
    }

    ; narrowTypeByTypeof.
    procedure narrow_type_by_typeof(this, f: ref[FlowState], t: ref[Type], typeof_expr: ref[AstNode], op: int, literal: ref[AstNode], assume_true_in: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var assume_true assume_true_in
        var negated false
        if op = KindExclamationEqualsToken
            set negated: true
        if op = KindExclamationEqualsEqualsToken
            set negated: true
        if negated
        {
            if assume_true_in
                set assume_true: false
            else
                set assume_true: true
        }
        let inner AstNode.expression_of(typeof_expr)
        if inner = null
            return t
        let target Checker.get_reference_candidate(inner as ref[AstNode])
        let reference f.reference as ref[AstNode]
        if this.is_matching_reference(reference, target)
            return this.narrow_type_by_literal_expression(t, literal, assume_true)
        var cur t
        if Checker.strict_null_checks()
        {
            if this.optional_chain_contains_reference(target, reference)
            {
                let is_undefined Checker.name_is(AstNode.literal_text_of(literal), "undefined")
                var not_undefined true
                if is_undefined
                    set not_undefined: false
                if assume_true = not_undefined
                {
                    let adjusted this.get_adjusted_type_with_facts(t, TypeFactsNEUndefinedOrNull)
                    if this.unported_mark() <> mark
                        return null
                    if adjusted = null
                        return null
                    set cur: adjusted as ref[Type]
                }
            }
        }
        let access this.get_discriminant_property_access(f, target, cur)
        if this.unported_mark() <> mark
            return null
        if access = null
            return cur
        this.narrow_type_by_discriminant(cur, access as ref[AstNode], NarrowKindLiteralExpression, null, literal, op, assume_true, null)
    }

    ; narrowTypeByEquality — the `==` family, and the arm the whole equality half
    ; of the engine ends in.
    procedure narrow_type_by_equality(this, t: ref[Type], op: int, value: ref[AstNode], assume_true_in: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsAny) <> 0
            return t
        var assume_true assume_true_in
        var negated false
        if op = KindExclamationEqualsToken
            set negated: true
        if op = KindExclamationEqualsEqualsToken
            set negated: true
        if negated
        {
            if assume_true_in
                set assume_true: false
            else
                set assume_true: true
        }
        let vt this.get_type_of_expression(value)
        if this.unported_mark() <> mark
            return null
        if vt = null
            return null
        let value_type vt as ref[Type]
        var double_equals false
        if op = KindEqualsEqualsToken
            set double_equals: true
        if op = KindExclamationEqualsToken
            set double_equals: true
        if (value_type.flags & TypeFlagsNullable) <> 0
        {
            if Checker.strict_null_checks() = false
                return t
            var facts TypeFactsNEUndefined
            if double_equals
            {
                set facts: TypeFactsNEUndefinedOrNull
                if assume_true
                    set facts: TypeFactsEQUndefinedOrNull
            }
            else
            {
                if (value_type.flags & TypeFlagsNull) <> 0
                {
                    set facts: TypeFactsNENull
                    if assume_true
                        set facts: TypeFactsEQNull
                }
                else
                {
                    if assume_true
                        set facts: TypeFactsEQUndefined
                }
            }
            return this.get_adjusted_type_with_facts(t, facts)
        }
        if assume_true
        {
            if double_equals = false
            {
                var widenable false
                if (t.flags & TypeFlagsUnknown) <> 0
                    set widenable: true
                if widenable = false
                {
                    if this.some_type_is_empty_anonymous_object(t)
                        set widenable: true
                    if this.unported_mark() <> mark
                        return null
                }
                if widenable
                {
                    if (value_type.flags & (TypeFlagsPrimitive | TypeFlagsNonPrimitive)) <> 0
                        return value_type
                    if this.is_empty_anonymous_object_type(value_type)
                        return value_type
                    if (value_type.flags & TypeFlagsObject) <> 0
                        return non_primitive_type
                }
            }
            let filtered this.filter_type_by_comparability(t, value_type, double_equals)
            if this.unported_mark() <> mark
                return null
            if filtered = null
                return null
            return this.replace_primitives_with_literals(filtered as ref[Type], value_type)
        }
        if Checker.is_unit_type(value_type) = false
            return t
        this.filter_type_by_unit_inequality(t, value_type)
    }

    ; someType(t, c.IsEmptyAnonymousObjectType), written out.
    procedure some_type_is_empty_anonymous_object(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_empty_anonymous_object_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if this.is_empty_anonymous_object_type(row as ref[Type])
                return true
        }
        false
    }

    ; narrowTypeByEquality's TRUE filter: comparable, or coercible under `==`.
    procedure filter_type_by_comparability(this, t: ref[Type], value_type: ref[Type], double_equals: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let keep this.comparable_or_coercible(row as ref[Type], value_type, double_equals)
                if this.unported_mark() <> mark
                    return null
                if keep
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let keep this.comparable_or_coercible(t, value_type, double_equals)
        if this.unported_mark() <> mark
            return null
        if keep
            return t
        never_type
    }

    procedure comparable_or_coercible(this, t: ref[Type], value_type: ref[Type], double_equals: bool) returns bool
    {
        if this.are_types_comparable(t, value_type)
            return true
        if double_equals = false
            return false
        Checker.is_coercible_under_double_equals(t, value_type)
    }

    ; narrowTypeByEquality's FALSE filter: drop the unit constituents that could
    ; have compared equal.
    procedure filter_type_by_unit_inequality(this, t: ref[Type], value_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let keep this.survives_unit_inequality(row as ref[Type], value_type)
                if this.unported_mark() <> mark
                    return null
                if keep
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let keep this.survives_unit_inequality(t, value_type)
        if this.unported_mark() <> mark
            return null
        if keep
            return t
        never_type
    }

    procedure survives_unit_inequality(this, t: ref[Type], value_type: ref[Type]) returns bool
    {
        if this.is_unit_like_type(t) = false
            return true
        this.are_types_comparable(t, value_type) = false
    }

    ; replacePrimitivesWithLiterals — *"a limited form of intersection"*, and the
    ; reference's own comment says why it is not the real one: over a union the
    ; intersection would generate a large number of types nobody reads.
    procedure replace_primitives_with_literals(this, type_with_primitives: ref[Type], type_with_literals: ref[Type]) returns ref[Type]?
    {
        if Checker.maybe_type_of_kind(type_with_primitives, TypeFlagsString | TypeFlagsTemplateLiteral | TypeFlagsNumber | TypeFlagsBigInt) = false
            return type_with_primitives
        if Checker.maybe_type_of_kind(type_with_literals, TypeFlagsStringLiteral | TypeFlagsTemplateLiteral | TypeFlagsStringMapping | TypeFlagsNumberLiteral | TypeFlagsBigIntLiteral) = false
            return type_with_primitives
        this.map_type_replacing_primitives(type_with_primitives, type_with_literals)
    }

    procedure map_type_replacing_primitives(this, t: ref[Type], type_with_literals: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & TypeFlagsUnion) = 0
            return this.replace_one_primitive(t, type_with_literals)
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            let m this.replace_one_primitive(s, type_with_literals)
            if this.unported_mark() <> mark
                return null
            if m = null
                return null
            if (m as ref[Type]) <> s
                set changed: true
            mapped.add(m)
        }
        if changed = false
            return t
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }

    procedure replace_one_primitive(this, t: ref[Type], type_with_literals: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsString) <> 0
            return this.filter_type_inside_flags(type_with_literals, TypeFlagsString | TypeFlagsStringLiteral | TypeFlagsTemplateLiteral | TypeFlagsStringMapping)
        if this.is_pattern_literal_type(t)
        {
            if Checker.maybe_type_of_kind(type_with_literals, TypeFlagsString | TypeFlagsTemplateLiteral | TypeFlagsStringMapping) = false
                return this.filter_type_inside_flags(type_with_literals, TypeFlagsStringLiteral)
        }
        if (t.flags & TypeFlagsNumber) <> 0
            return this.filter_type_inside_flags(type_with_literals, TypeFlagsNumber | TypeFlagsNumberLiteral)
        if (t.flags & TypeFlagsBigInt) <> 0
            return this.filter_type_inside_flags(type_with_literals, TypeFlagsBigInt | TypeFlagsBigIntLiteral)
        t
    }

    ; narrowTypeByBinaryExpression — the switch over the operator, and the arm
    ; that reaches the most of the rest of the chapter.
    procedure narrow_type_by_binary_expression(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let reference f.reference as ref[AstNode]
        let op AstNode.binary_operator_kind(expr)
        var assignment false
        if op = KindEqualsToken
            set assignment: true
        if op = KindBarBarEqualsToken
            set assignment: true
        if op = KindAmpersandAmpersandEqualsToken
            set assignment: true
        if op = KindQuestionQuestionEqualsToken
            set assignment: true
        if assignment
        {
            let right AstNode.binary_right_of(expr)
            let left AstNode.binary_left_of(expr)
            if right = null
                return t
            if left = null
                return t
            let narrowed this.narrow_type(f, t, right as ref[AstNode], assume_true)
            if this.unported_mark() <> mark
                return null
            if narrowed = null
                return null
            return this.narrow_type_by_truthiness(f, narrowed as ref[Type], left as ref[AstNode], assume_true)
        }
        var equality false
        if op = KindEqualsEqualsToken
            set equality: true
        if op = KindExclamationEqualsToken
            set equality: true
        if op = KindEqualsEqualsEqualsToken
            set equality: true
        if op = KindExclamationEqualsEqualsToken
            set equality: true
        if equality
            return this.narrow_type_by_equality_operands(f, t, expr, op, assume_true)
        if op = KindInstanceOfKeyword
            return this.narrow_type_by_instanceof(f, t, expr, assume_true)
        if op = KindInKeyword
            return this.narrow_type_by_in_operator(f, t, expr, assume_true)
        if op = KindCommaToken
        {
            let right AstNode.binary_right_of(expr)
            if right = null
                return t
            return this.narrow_type(f, t, right as ref[AstNode], assume_true)
        }
        ; "Ordinarily we won't see && and || expressions in control flow analysis
        ; because the Binder breaks those expressions down … However, we may
        ; encounter them when analyzing aliased conditional expressions."
        var logical false
        if op = KindAmpersandAmpersandToken
            set logical: true
        if op = KindBarBarToken
            set logical: true
        if logical = false
            return t
        let left AstNode.binary_left_of(expr)
        let right AstNode.binary_right_of(expr)
        if left = null
            return t
        if right = null
            return t
        var sequential false
        if op = KindAmpersandAmpersandToken
        {
            if assume_true
                set sequential: true
        }
        if op = KindBarBarToken
        {
            if assume_true = false
                set sequential: true
        }
        if sequential
        {
            let first this.narrow_type(f, t, left as ref[AstNode], assume_true)
            if this.unported_mark() <> mark
                return null
            if first = null
                return null
            return this.narrow_type(f, first as ref[Type], right as ref[AstNode], assume_true)
        }
        let a this.narrow_type(f, t, left as ref[AstNode], assume_true)
        if this.unported_mark() <> mark
            return null
        let b this.narrow_type(f, t, right as ref[AstNode], assume_true)
        if this.unported_mark() <> mark
            return null
        if a = null
            return null
        if b = null
            return null
        let both &Array[ref[Type]?]()
        both.add(a)
        both.add(b)
        this.get_union_type(both)
    }

    ; The equality group of narrowTypeByBinaryExpression, lifted out because it is
    ; ten tests deep and the reference's own `case` is one arm.
    procedure narrow_type_by_equality_operands(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], op: int, assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let reference f.reference as ref[AstNode]
        let left_opt AstNode.binary_left_of(expr)
        let right_opt AstNode.binary_right_of(expr)
        if left_opt = null
            return t
        if right_opt = null
            return t
        let left Checker.get_reference_candidate(left_opt as ref[AstNode])
        let right Checker.get_reference_candidate(right_opt as ref[AstNode])
        if AstNode.kind_of(left) = KindTypeOfExpression
        {
            if Parser.is_string_literal_like(right)
                return this.narrow_type_by_typeof(f, t, left, op, right, assume_true)
        }
        if AstNode.kind_of(right) = KindTypeOfExpression
        {
            if Parser.is_string_literal_like(left)
                return this.narrow_type_by_typeof(f, t, right, op, left, assume_true)
        }
        if this.is_matching_reference(reference, left)
            return this.narrow_type_by_equality(t, op, right, assume_true)
        if this.is_matching_reference(reference, right)
            return this.narrow_type_by_equality(t, op, left, assume_true)
        var cur t
        if Checker.strict_null_checks()
        {
            if this.optional_chain_contains_reference(left, reference)
            {
                let adjusted this.narrow_type_by_optional_chain_containment(f, cur, op, right, assume_true)
                if this.unported_mark() <> mark
                    return null
                if adjusted = null
                    return null
                set cur: adjusted as ref[Type]
            }
            else
            {
                if this.optional_chain_contains_reference(right, reference)
                {
                    let adjusted this.narrow_type_by_optional_chain_containment(f, cur, op, left, assume_true)
                    if this.unported_mark() <> mark
                        return null
                    if adjusted = null
                        return null
                    set cur: adjusted as ref[Type]
                }
            }
        }
        let left_access this.get_discriminant_property_access(f, left, cur)
        if this.unported_mark() <> mark
            return null
        if left_access <> null
            return this.narrow_type_by_discriminant_property(cur, left_access as ref[AstNode], op, right, assume_true)
        let right_access this.get_discriminant_property_access(f, right, cur)
        if this.unported_mark() <> mark
            return null
        if right_access <> null
            return this.narrow_type_by_discriminant_property(cur, right_access as ref[AstNode], op, left, assume_true)
        if this.is_matching_constructor_reference(f, left)
            return this.narrow_type_by_constructor(cur, op, right, assume_true)
        if this.unported_mark() <> mark
            return null
        if this.is_matching_constructor_reference(f, right)
            return this.narrow_type_by_constructor(cur, op, left, assume_true)
        if this.unported_mark() <> mark
            return null
        if Binder.is_boolean_literal(right)
        {
            if Parser.is_access_expression(left) = false
                return this.narrow_type_by_boolean_comparison(f, cur, left, right, op, assume_true)
        }
        if Binder.is_boolean_literal(left)
        {
            if Parser.is_access_expression(right) = false
                return this.narrow_type_by_boolean_comparison(f, cur, right, left, op, assume_true)
        }
        cur
    }

    ; The `in` group of narrowTypeByBinaryExpression.
    procedure narrow_type_by_in_operator(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let reference f.reference as ref[AstNode]
        let left_opt AstNode.binary_left_of(expr)
        let right_opt AstNode.binary_right_of(expr)
        if left_opt = null
            return t
        if right_opt = null
            return t
        let left left_opt as ref[AstNode]
        if AstNode.is_private_identifier(left)
            return this.narrow_type_by_private_identifier_in_in_expression(f, t, expr, assume_true)
        let target Checker.get_reference_candidate(right_opt as ref[AstNode])
        if this.contains_missing_type(t)
        {
            if Parser.is_access_expression(reference)
            {
                let re AstNode.expression_of(reference)
                if re <> null
                {
                    if this.is_matching_reference(re as ref[AstNode], target)
                    {
                        let lt this.get_type_of_expression(left)
                        if this.unported_mark() <> mark
                            return null
                        if lt <> null
                        {
                            let left_type lt as ref[Type]
                            if Checker.is_type_usable_as_property_name(left_type)
                            {
                                var accessed_data Slice[char]()
                                if this.get_accessed_property_name(reference, &accessed_data)
                                {
                                    var nb char[JSNUM_MAX_TEXT]
                                    let name_data this.get_property_name_from_type(left_type, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
                                    if this.unported_mark() <> mark
                                        return null
                                    if SymbolTable.names_equal(accessed_data, name_data)
                                    {
                                        var facts TypeFactsEQUndefined
                                        if assume_true
                                            set facts: TypeFactsNEUndefined
                                        return this.get_type_with_facts(t, facts)
                                    }
                                }
                                if this.unported_mark() <> mark
                                    return null
                            }
                        }
                    }
                }
            }
        }
        if this.is_matching_reference(reference, target) = false
            return t
        let lt this.get_type_of_expression(left)
        if this.unported_mark() <> mark
            return null
        if lt = null
            return null
        let left_type lt as ref[Type]
        if Checker.is_type_usable_as_property_name(left_type) = false
            return t
        this.narrow_type_by_in_keyword(f, t, left_type, assume_true)
    }

    ; narrowTypeByOptionalChainContainment — the eight-line comment upstream is a
    ; truth table and the code is its two rows.
    procedure narrow_type_by_optional_chain_containment(this, f: ref[FlowState], t: ref[Type], op: int, value: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var equals_op false
        if op = KindEqualsEqualsToken
            set equals_op: true
        if op = KindEqualsEqualsEqualsToken
            set equals_op: true
        var nullable_flags TypeFlagsUndefined
        var loose false
        if op = KindEqualsEqualsToken
            set loose: true
        if op = KindExclamationEqualsToken
            set loose: true
        if loose
            set nullable_flags: TypeFlagsNullable
        let vt this.get_type_of_expression(value)
        if this.unported_mark() <> mark
            return null
        if vt = null
            return null
        let value_type vt as ref[Type]
        var remove_nullable false
        if equals_op <> assume_true
        {
            if Checker.every_type_has_flags(value_type, nullable_flags)
                set remove_nullable: true
        }
        if equals_op = assume_true
        {
            if Checker.every_type_lacks_flags(value_type, TypeFlagsAnyOrUnknown | nullable_flags)
                set remove_nullable: true
        }
        if remove_nullable = false
            return t
        this.get_adjusted_type_with_facts(t, TypeFactsNEUndefinedOrNull)
    }

    ; everyType over a flag test, in both polarities — the two closures
    ; narrowTypeByOptionalChainContainment passes.
    function every_type_has_flags(t: ref[Type], mask: int) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return (t.flags & mask) <> 0
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if ((row as ref[Type]).flags & mask) = 0
                return false
        }
        true
    }

    function every_type_lacks_flags(t: ref[Type], mask: int) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return (t.flags & mask) = 0
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if ((row as ref[Type]).flags & mask) <> 0
                return false
        }
        true
    }

    ; narrowTypeByDiscriminantProperty. ★Its fast path is the KEY PROPERTY route
    ; and it is guarded down to its input — see get_key_property_name for why the
    ; guard is the whole function on a corpus without ten-constituent unions.
    procedure narrow_type_by_discriminant_property(this, t: ref[Type], access: ref[AstNode], op: int, value: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var strict false
        if op = KindEqualsEqualsEqualsToken
            set strict: true
        if op = KindExclamationEqualsEqualsToken
            set strict: true
        if strict
        {
            if (t.flags & TypeFlagsUnion) <> 0
            {
                var key_data Slice[char]()
                if this.get_key_property_name(t, &key_data)
                {
                    var accessed_data Slice[char]()
                    if this.get_accessed_property_name(access, &accessed_data)
                    {
                        if SymbolTable.names_equal(key_data, accessed_data)
                        {
                            ; `unknown_type` from the key route is *no constituent for
                            ; the value*: the reference falls through to the
                            ; discriminant walk below, it does not answer t
                            let keyed this.narrow_by_key_property(t, key_data, op, value, assume_true)
                            if keyed = null
                                return null
                            if (keyed as ref[Type]) <> unknown_type
                                return keyed
                        }
                    }
                    if this.unported_mark() <> mark
                        return null
                }
                if this.unported_mark() <> mark
                    return null
            }
        }
        this.narrow_type_by_discriminant(t, access, NarrowKindEquality, null, value, op, assume_true, null)
    }

    ; The key-property route's body. ★It is UNREACHABLE while
    ; get_key_property_name reports rather than answers, and it is written whole
    ; anyway: the stop it ends at names the map, so the row this arm would produce
    ; is the same row the guard produces and the reader is not sent twice.
    procedure narrow_by_key_property(this, t: ref[Type], key_data: Slice[char], op: int, value: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let vt this.get_type_of_expression(value)
        if this.unported_mark() <> mark
            return null
        if vt = null
            return null
        let candidate this.get_constituent_type_for_key_type(t, vt as ref[Type])
        if this.unported_mark() <> mark
            return null
        ; ★ no constituent (a duplicate key maps to none): the caller walks on,
        ; as the reference's `if candidate != nil` does (2026-09-17)
        if candidate = null
            return unknown_type
        let cand candidate as ref[Type]
        var take_candidate false
        if assume_true
        {
            if op = KindEqualsEqualsEqualsToken
                set take_candidate: true
        }
        if assume_true = false
        {
            if op = KindExclamationEqualsEqualsToken
                set take_candidate: true
        }
        if take_candidate
            return cand
        let prop_type this.get_type_of_property_of_type(cand, key_data)
        if this.unported_mark() <> mark
            return null
        if prop_type = null
            return t
        if Checker.is_unit_type(prop_type as ref[Type]) = false
            return t
        this.remove_type(t, cand)
    }

    ; isMatchingConstructorReference.
    procedure is_matching_constructor_reference(this, f: ref[FlowState], expr: ref[AstNode]) returns bool
    {
        if Parser.is_access_expression(expr) = false
            return false
        let mark this.unported_mark()
        var d Slice[char]()
        if this.get_accessed_property_name(expr, &d) = false
            return false
        if this.unported_mark() <> mark
            return false
        if Checker.name_is(d, "constructor") = false
            return false
        let e AstNode.expression_of(expr)
        if e = null
            return false
        this.is_matching_reference(f.reference as ref[AstNode], e as ref[AstNode])
    }

    ; narrowTypeByConstructor — `x.constructor === C`. ★Its filter is
    ; isConstructedBy and NOT assignability, for the reason the reference's own
    ; comment gives: two structurally identical classes must not be confused, so a
    ; class on either side is compared by SYMBOL.
    procedure narrow_type_by_constructor(this, t: ref[Type], op: int, identifier: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var narrows false
        if assume_true
        {
            if op = KindEqualsEqualsToken
                set narrows: true
            if op = KindEqualsEqualsEqualsToken
                set narrows: true
        }
        else
        {
            if op = KindExclamationEqualsToken
                set narrows: true
            if op = KindExclamationEqualsEqualsToken
                set narrows: true
        }
        if narrows = false
            return t
        let it this.get_type_of_expression(identifier)
        if this.unported_mark() <> mark
            return null
        if it = null
            return null
        let identifier_type it as ref[Type]
        var callable this.is_function_type(identifier_type)
        if this.unported_mark() <> mark
            return null
        if callable = false
        {
            set callable: this.is_constructor_type(identifier_type)
            if this.unported_mark() <> mark
                return null
        }
        if callable = false
            return t
        let prototype_property this.get_property_of_type(identifier_type, "prototype")
        if this.unported_mark() <> mark
            return null
        if prototype_property = null
            return t
        let pt this.get_type_of_symbol(prototype_property as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        if pt = null
            return null
        let prototype_type pt as ref[Type]
        if Checker.is_type_any(prototype_type)
            return t
        let go this.get_global_object_type()
        if go <> null
        {
            if prototype_type = (go as ref[Type])
                return t
        }
        let gf this.get_global_function_type()
        if gf <> null
        {
            if prototype_type = (gf as ref[Type])
                return t
        }
        if Checker.is_type_any(t)
            return prototype_type
        this.filter_type_by_constructed_by(t, prototype_type)
    }

    procedure filter_type_by_constructed_by(this, t: ref[Type], candidate: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let keep this.is_constructed_by(row as ref[Type], candidate)
                if this.unported_mark() <> mark
                    return null
                if keep
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let keep this.is_constructed_by(t, candidate)
        if this.unported_mark() <> mark
            return null
        if keep
            return t
        never_type
    }

    ; isConstructedBy.
    procedure is_constructed_by(this, source: ref[Type], target: ref[Type]) returns bool
    {
        var class_involved false
        if (source.flags & TypeFlagsObject) <> 0
        {
            if (source.object_flags & ObjectFlagsClass) <> 0
                set class_involved: true
        }
        if (target.flags & TypeFlagsObject) <> 0
        {
            if (target.object_flags & ObjectFlagsClass) <> 0
                set class_involved: true
        }
        if class_involved
            return source.symbol = target.symbol
        this.is_type_subtype_of(source, target)
    }

    ; narrowTypeByBooleanComparison — `x === true`, folded to the truth value the
    ; comparison asserts. ★The reference writes it as two chained `!=` over
    ; booleans and it is transcribed as the same XOR, because reading it as three
    ; nested ifs is where the polarity gets lost.
    procedure narrow_type_by_boolean_comparison(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], bool_value: ref[AstNode], op: int, assume_true: bool) returns ref[Type]?
    {
        var is_true false
        if AstNode.kind_of(bool_value) = KindTrueKeyword
            set is_true: true
        var negated true
        if op = KindExclamationEqualsEqualsToken
            set negated: false
        if op = KindExclamationEqualsToken
            set negated: false
        var first false
        if assume_true <> is_true
            set first: true
        var result false
        if first <> negated
            set result: true
        this.narrow_type(f, t, expr, result)
    }

    ; narrowTypeByInstanceof.
    procedure narrow_type_by_instanceof(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let reference f.reference as ref[AstNode]
        let left_opt AstNode.binary_left_of(expr)
        let right_opt AstNode.binary_right_of(expr)
        if left_opt = null
            return t
        if right_opt = null
            return t
        let left Checker.get_reference_candidate(left_opt as ref[AstNode])
        if this.is_matching_reference(reference, left) = false
        {
            if assume_true
            {
                if Checker.strict_null_checks()
                {
                    if this.optional_chain_contains_reference(left, reference)
                        return this.get_adjusted_type_with_facts(t, TypeFactsNEUndefinedOrNull)
                }
            }
            return t
        }
        let right right_opt as ref[AstNode]
        let rt this.get_type_of_expression(right)
        if this.unported_mark() <> mark
            return null
        if rt = null
            return null
        let right_type rt as ref[Type]
        let go this.get_global_object_type()
        if this.unported_mark() <> mark
            return null
        if go = null
            return t
        if this.is_type_derived_from(right_type, go as ref[Type]) = false
            return t
        if this.unported_mark() <> mark
            return null
        ; "if the right-hand side has an object type with a custom
        ; `[Symbol.hasInstance]` method, and that method has a type predicate, use
        ; the type predicate to perform narrowing."
        let signature this.get_effects_signature(expr)
        if this.unported_mark() <> mark
            return null
        if signature <> null
        {
            let predicate this.get_type_predicate_of_signature(signature as ref[Signature])
            if this.unported_mark() <> mark
                return null
            if predicate <> null
            {
                let p predicate as ref[TypePredicate]
                if p.kind = TypePredicateKindIdentifier
                {
                    if p.parameter_index = 0
                    {
                        if p.t = null
                            return t
                        return this.get_narrowed_type(t, p.t as ref[Type], assume_true, true)
                    }
                }
            }
        }
        let gf this.get_global_function_type()
        if this.unported_mark() <> mark
            return null
        if gf = null
            return t
        if this.is_type_derived_from(right_type, gf as ref[Type]) = false
            return t
        if this.unported_mark() <> mark
            return null
        let inst this.map_type_to_instance_type(right_type)
        if this.unported_mark() <> mark
            return null
        if inst = null
            return null
        let instance_type inst as ref[Type]
        ; "Don't narrow from `any` if the target type is exactly `Object` or
        ; `Function`, and narrow in the false branch only if the target is a
        ; non-empty object type."
        if Checker.is_type_any(t)
        {
            if instance_type = (go as ref[Type])
                return t
            if instance_type = (gf as ref[Type])
                return t
        }
        if assume_true = false
        {
            var non_empty_object false
            if (instance_type.flags & TypeFlagsObject) <> 0
            {
                if this.is_empty_anonymous_object_type(instance_type) = false
                    set non_empty_object: true
                if this.unported_mark() <> mark
                    return null
            }
            if non_empty_object = false
                return t
        }
        this.get_narrowed_type(t, instance_type, assume_true, true)
    }

    ; mapType(rightType, c.getInstanceType) — §3.5e's rule with a METHOD as the
    ; func value, which is the one shape the reference passes directly.
    procedure map_type_to_instance_type(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & TypeFlagsUnion) = 0
            return this.get_instance_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            let m this.get_instance_type(s)
            if this.unported_mark() <> mark
                return null
            if m = null
                return null
            if (m as ref[Type]) <> s
                set changed: true
            mapped.add(m)
        }
        if changed = false
            return t
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }

    ; getInstanceType — the prototype property, else the construct signatures'
    ; return types, else `{}` *"to indicate we don't know the type of objects
    ; created by this constructor function"*.
    procedure get_instance_type(this, constructor_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let ppt this.get_type_of_property_of_type(constructor_type, "prototype")
        if this.unported_mark() <> mark
            return null
        if ppt <> null
        {
            if Checker.is_type_any(ppt as ref[Type]) = false
                return ppt
        }
        let sigs this.get_signatures_of_type(constructor_type, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return null
        let count Checker.sig_count(sigs)
        if count = 0
            return empty_object_type
        let list sigs as ref[Array[ref[Signature]?]]
        let return_types &Array[ref[Type]?]()
        var i 0
        while i < count
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let erased this.get_erased_signature(row as ref[Signature])
            if this.unported_mark() <> mark
                return null
            if erased = null
                return null
            let rt this.get_return_type_of_signature(erased as ref[Signature])
            if this.unported_mark() <> mark
                return null
            if rt = null
                return null
            return_types.add(rt)
        }
        this.get_union_type(return_types)
    }

    ; narrowTypeByPrivateIdentifierInInExpression — `#x in obj`.
    procedure narrow_type_by_private_identifier_in_in_expression(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let right_opt AstNode.binary_right_of(expr)
        let left_opt AstNode.binary_left_of(expr)
        if right_opt = null
            return t
        if left_opt = null
            return t
        let target Checker.get_reference_candidate(right_opt as ref[AstNode])
        if this.is_matching_reference(f.reference as ref[AstNode], target) = false
            return t
        let sym this.get_symbol_for_private_identifier_expression(left_opt as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if sym = null
            return t
        let symbol sym as ref[Symbol]
        ; `symbol.Parent` — the CLASS the private member was declared in. Upstream
        ; dereferences it unguarded; a private member's parent is its class by
        ; construction, so a null here is a binder defect and answering `t` is the
        ; reading that says the narrowing found nothing.
        let cls Symbol.parent_of(symbol)
        if cls = null
            return t
        let class_symbol cls as ref[Symbol]
        var target_type: ref[Type]? null
        if b.has_syntactic_modifier(Symbol.value_declaration_of(symbol), ModifierFlagsStatic)
            set target_type: this.get_type_of_symbol(class_symbol)
        else
            set target_type: this.get_declared_type_of_symbol(class_symbol)
        if this.unported_mark() <> mark
            return null
        if target_type = null
            return null
        this.get_narrowed_type(t, target_type as ref[Type], assume_true, true)
    }

    ; narrowTypeByInKeyword — `"k" in x`.
    procedure narrow_type_by_in_keyword(this, f: ref[FlowState], t: ref[Type], name_type: ref[Type], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var nb char[JSNUM_MAX_TEXT]
        let name_data this.get_property_name_from_type(name_type, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if this.unported_mark() <> mark
            return null
        let known this.some_type_has_property_possible(t, name_data)
        if this.unported_mark() <> mark
            return null
        if known
        {
            ; "If the check is for a known property … we filter the target type by
            ; presence of absence of the property."
            return this.filter_type_by_property_presence(t, name_data, assume_true)
        }
        if assume_true = false
            return t
        ; "If the check is for an unknown property, we intersect the target type
        ; with `Record<X, unknown>`" — whole since slice 125. ★A lib without
        ; `Record` answers the type unchanged, which is the reference's own tail.
        var rd Slice[char]()
        set rd: Checker.plain_name(host, "Record")
        this.report_checked_global_type_alias("Record", 2)
        let record_symbol this.get_global_type_alias_symbol(rd, 2)
        if this.unported_mark() <> mark
            return null
        if record_symbol = null
            return t
        let args this.new_type_list_of(2)
        args.add(name_type)
        args.add(unknown_type)
        let instantiated this.get_type_alias_instantiation(record_symbol as ref[Symbol], args, null)
        if this.unported_mark() <> mark
            return null
        let pair &Array[ref[Type]?]()
        pair.add(t)
        pair.add(instantiated)
        this.get_intersection_type(pair)
    }

    procedure some_type_has_property_possible(this, t: ref[Type], d: Slice[char]) returns bool
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_type_presence_possible(t, d, true)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let count list.get_length() as int
        var i 0
        while i < count
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let hit this.is_type_presence_possible(row as ref[Type], d, true)
            if this.unported_mark() <> mark
                return false
            if hit
                return true
        }
        false
    }

    procedure filter_type_by_property_presence(this, t: ref[Type], d: Slice[char], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let keep this.is_type_presence_possible(row as ref[Type], d, assume_true)
                if this.unported_mark() <> mark
                    return null
                if keep
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let keep this.is_type_presence_possible(t, d, assume_true)
        if this.unported_mark() <> mark
            return null
        if keep
            return t
        never_type
    }

    ; isTypePresencePossible.
    procedure is_type_presence_possible(this, t: ref[Type], d: Slice[char], assume_true: bool) returns bool
    {
        let mark this.unported_mark()
        let prop this.get_property_of_type(t, d)
        if this.unported_mark() <> mark
            return false
        if prop <> null
        {
            let p prop as ref[Symbol]
            if (Symbol.flags_of(p) & SymbolFlagsOptional) <> 0
                return true
            ; `prop.CheckFlags & CheckFlagsPartial` — a union property some
            ; constituent lacks. ★The note that stood here called the bit
            ; unwritable because getPropertyOfUnionOrIntersectionType was unported;
            ; it has been ported since, and without the test `'length' in obj` on
            ; `T extends any[] | Record<string, any>` filtered `T` to `never` in
            ; the else branch (`inKeywordTypeguard`, slice 203).
            if (Symbol.check_flags_of(p) & CheckFlagsPartial) <> 0
                return true
            return assume_true
        }
        let info this.get_applicable_index_info_for_name(t, d)
        if this.unported_mark() <> mark
            return false
        if info <> null
            return true
        assume_true = false
    }

    ; ── getNarrowedType, the instanceof/predicate narrowing itself ──────────

    ; getNarrowedType. ★The cache is on the UNION case only, which is the
    ; reference's own guard: a non-union answer is one worker call.
    procedure get_narrowed_type(this, t: ref[Type], candidate: ref[Type], assume_true: bool, check_derived: bool) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.get_narrowed_type_worker(t, candidate, assume_true, check_derived)
        var flags 0
        if assume_true
            set flags: flags | 1
        if check_derived
            set flags: flags | 2
        let cached this.lookup_narrowed_type(t, candidate, flags)
        if cached <> null
            return cached
        let mark this.unported_mark()
        let computed this.get_narrowed_type_worker(t, candidate, assume_true, check_derived)
        if this.unported_mark() <> mark
            return null
        if computed = null
            return null
        narrowed_types.add(&NarrowedTypeRow^this(t, candidate, flags, computed as ref[Type]))
        computed
    }

    function lookup_narrowed_type(this, t: ref[Type], candidate: ref[Type], flags: int) returns ref[Type]?
    {
        let n narrowed_types.get_length() as int
        var i 0
        while i < n
        {
            let row narrowed_types[i]
            set i: i + 1
            if row = null
                continue
            let r row as ref[NarrowedTypeRow]
            if r.flags <> flags
                continue
            if r.source <> t
                continue
            if r.candidate <> candidate
                continue
            return r.narrowed
        }
        null
    }

    ; getNarrowedTypeWorker — the largest single function of flow.go, and its
    ; shape is three questions: the FALSE branch subtracts, the TRUE branch filters
    ; the candidate against the current type, and what filtering cannot decide is
    ; settled by assignability or by an intersection.
    procedure get_narrowed_type_worker(this, t: ref[Type], candidate: ref[Type], assume_true: bool, check_derived: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if assume_true = false
        {
            if t = candidate
                return never_type
            if check_derived
                return this.filter_type_not_derived_from(t, candidate)
            var subject t
            if (t.flags & TypeFlagsUnknown) <> 0
            {
                let uu this.get_unknown_union_type()
                if uu = null
                    return null
                set subject: uu as ref[Type]
            }
            let true_type this.get_narrowed_type(subject, candidate, true, false)
            if this.unported_mark() <> mark
                return null
            if true_type = null
                return null
            let filtered this.filter_type_not_subset_of(subject, true_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if filtered = null
                return null
            return this.recombine_unknown_type(filtered as ref[Type])
        }
        if (t.flags & TypeFlagsAnyOrUnknown) <> 0
            return candidate
        if t = candidate
            return candidate
        ; The key-property fast route, guarded exactly as it is elsewhere.
        var key_data Slice[char]()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            this.get_key_property_name(t, &key_data)
            if this.unported_mark() <> mark
                return null
        }
        let narrowed this.map_candidate_against(t, candidate, key_data, check_derived)
        if this.unported_mark() <> mark
            return null
        if narrowed = null
            return null
        let nt narrowed as ref[Type]
        if (nt.flags & TypeFlagsNever) = 0
            return nt
        if this.is_type_subtype_of(candidate, t)
            return candidate
        if this.unported_mark() <> mark
            return null
        if this.is_type_assignable_to(t, candidate)
            return t
        if this.unported_mark() <> mark
            return null
        if this.is_type_assignable_to(candidate, t)
            return candidate
        if this.unported_mark() <> mark
            return null
        let pair &Array[ref[Type]?]()
        pair.add(t)
        pair.add(candidate)
        this.get_intersection_type(pair)
    }

    ; The outer mapType of getNarrowedTypeWorker's TRUE branch — over the
    ; CANDIDATE, which is the direction that is easy to read backwards.
    procedure map_candidate_against(this, t: ref[Type], candidate: ref[Type], key_data: Slice[char], check_derived: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (candidate.flags & TypeFlagsNever) <> 0
            return candidate
        if (candidate.flags & TypeFlagsUnion) = 0
            return this.narrow_one_candidate(t, candidate, key_data, check_derived)
        let types Checker.union_types_of(candidate)
        if types = null
            return candidate
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            let m this.narrow_one_candidate(t, s, key_data, check_derived)
            if this.unported_mark() <> mark
                return null
            if m = null
                return null
            if (m as ref[Type]) <> s
                set changed: true
            mapped.add(m)
        }
        if changed = false
            return candidate
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }

    ; The body of that closure, per candidate constituent `n`.
    procedure narrow_one_candidate(this, t: ref[Type], n: ref[Type], key_data: Slice[char], check_derived: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var matching t
        if key_data.length <> 0
        {
            let discriminant this.get_type_of_property_of_type(n, key_data)
            if this.unported_mark() <> mark
                return null
            if discriminant <> null
            {
                let constituent this.get_constituent_type_for_key_type(t, discriminant as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if constituent <> null
                    set matching: constituent as ref[Type]
            }
        }
        let directly_related this.map_type_pick_more_specific(matching, n, check_derived)
        if this.unported_mark() <> mark
            return null
        if directly_related = null
            return null
        let dr directly_related as ref[Type]
        if (dr.flags & TypeFlagsNever) = 0
            return dr
        ; "If no constituents are directly related, create intersections for any
        ; generic constituents that are related by constraint."
        this.map_type_intersect_generic(t, n, check_derived)
    }

    ; The inner mapType that picks the more specific of two directly related
    ; types. ★The reference builds one of TWO closures here and the difference is
    ; the whole comment above it: `instanceof` compares DERIVATION and a type
    ; predicate compares subtyping, strict first.
    procedure map_type_pick_more_specific(this, t: ref[Type], n: ref[Type], check_derived: bool) returns ref[Type]?
    {
        var a_value MapTypeArgs(n, null, null, null, null, check_derived, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
        let a &a_value as ref[MapTypeArgs]?
        this.map_type_ex(t, MapTypeKindPickMoreSpecific, a, false)
    }

    procedure pick_more_specific(this, t: ref[Type], n: ref[Type], check_derived: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if check_derived
        {
            if this.is_type_derived_from(t, n)
                return t
            if this.unported_mark() <> mark
                return null
            if this.is_type_derived_from(n, t)
                return n
            if this.unported_mark() <> mark
                return null
            return never_type
        }
        if this.is_type_strict_subtype_of(t, n)
            return t
        if this.unported_mark() <> mark
            return null
        if this.is_type_strict_subtype_of(n, t)
            return n
        if this.unported_mark() <> mark
            return null
        if this.is_type_subtype_of(t, n)
            return t
        if this.unported_mark() <> mark
            return null
        if this.is_type_subtype_of(n, t)
            return n
        if this.unported_mark() <> mark
            return null
        never_type
    }

    ; The last mapType of the worker: intersect the INSTANTIABLE constituents that
    ; are related by constraint.
    procedure map_type_intersect_generic(this, t: ref[Type], n: ref[Type], check_derived: bool) returns ref[Type]?
    {
        var a_value MapTypeArgs(n, null, null, null, null, check_derived, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
        let a &a_value as ref[MapTypeArgs]?
        this.map_type_ex(t, MapTypeKindIntersectIfGeneric, a, false)
    }

    procedure intersect_if_generic(this, t: ref[Type], n: ref[Type], check_derived: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if Checker.maybe_type_of_kind(t, TypeFlagsInstantiable) = false
            return never_type
        let constraint this.get_base_constraint_of_type(t)
        if this.unported_mark() <> mark
            return null
        var related true
        if constraint <> null
        {
            if check_derived
                set related: this.is_type_derived_from(n, constraint as ref[Type])
            else
                set related: this.is_type_subtype_of(n, constraint as ref[Type])
            if this.unported_mark() <> mark
                return null
        }
        if related = false
            return never_type
        let pair &Array[ref[Type]?]()
        pair.add(t)
        pair.add(n)
        this.get_intersection_type(pair)
    }

    ; getNarrowedTypeWorker's two FALSE-branch filters.
    procedure filter_type_not_derived_from(this, t: ref[Type], candidate: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let derived this.is_type_derived_from(row as ref[Type], candidate)
                if this.unported_mark() <> mark
                    return null
                if derived = false
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let derived this.is_type_derived_from(t, candidate)
        if this.unported_mark() <> mark
            return null
        if derived = false
            return t
        never_type
    }

    procedure filter_type_not_subset_of(this, t: ref[Type], true_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let subset this.is_type_subset_of(row as ref[Type], true_type)
                if this.unported_mark() <> mark
                    return null
                if subset = false
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let subset this.is_type_subset_of(t, true_type)
        if this.unported_mark() <> mark
            return null
        if subset = false
            return t
        never_type
    }

    ; ── the SWITCH (slice 123) ──────────────────────────────────────────────
    ;
    ; ★★ THE SWITCH IS A SECOND ENGINE BESIDE THE CONDITION and it is reached from
    ; one arm: getTypeAtSwitchClause. What differs from the condition is that the
    ; clause RANGE decides the narrowing — `data.ClauseStart`/`ClauseEnd` cut the
    ; clause list, and the empty range is the *bypass* branch that means *no case
    ; matched*.

    ; c.switchStatementLinks.Get(node), the mint-on-miss idiom once more.
    procedure switch_statement_link_of(this, node: ref[AstNode]) returns ref[SwitchStatementLink]
    {
        let ix switch_statement_links_index
        let at ix.find(node as int)
        if at > 0
        {
            let row switch_statement_links[at - 1]
            if row <> null
                return row as ref[SwitchStatementLink]
        }
        let made &SwitchStatementLink^host(node)
        switch_statement_links.add(made)
        ix.insert(node as int, (switch_statement_links.get_length() as int) - 1)
        made
    }

    ; getTypeOfSwitchClause.
    procedure get_type_of_switch_clause(this, clause: ref[AstNode]) returns ref[Type]?
    {
        if AstNode.kind_of(clause) <> KindCaseClause
            return never_type
        let e AstNode.expression_of(clause)
        if e = null
            return never_type
        let mark this.unported_mark()
        let t this.get_type_of_expression(e as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        this.get_regular_type_of_literal_type(t as ref[Type])
    }

    ; getSwitchClauseTypes, memoised on the switch statement.
    procedure get_switch_clause_types(this, node: ref[AstNode]) returns ref[Array[ref[Type]?]]?
    {
        let links this.switch_statement_link_of(node)
        if links.switch_types_computed
            return links.switch_types
        let mark this.unported_mark()
        let clauses AstNode.case_clauses_of(AstNode.case_block_of(node))
        let types this.new_type_list(null)
        let n AstNode.list_count(clauses)
        var i 0
        while i < n
        {
            let clause AstNode.child_in_list(clauses, i)
            set i: i + 1
            if clause = null
                continue
            let t this.get_type_of_switch_clause(clause as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if t = null
                return null
            types.add(t)
        }
        set links.switch_types: types
        set links.switch_types_computed: true
        links.switch_types
    }

    ; getSwitchClauseTypeOfWitnesses. ★A witness is the case's string TEXT, and
    ; the empty one means *default clause, or a duplicate of an earlier case* —
    ; both of which the readers skip. `usable` false is the reference's `nil`: one
    ; case expression that is not a string literal disqualifies the whole switch.
    procedure get_switch_clause_type_of_witnesses(this, node: ref[AstNode]) returns bool
    {
        let links this.switch_statement_link_of(node)
        if links.witnesses_computed
            return links.witnesses_usable
        set links.witnesses_computed: true
        set links.witnesses_usable: true
        let clauses AstNode.case_clauses_of(AstNode.case_block_of(node))
        let n AstNode.list_count(clauses)
        var i 0
        while i < n
        {
            let clause AstNode.child_in_list(clauses, i)
            if clause = null
            {
                links.witnesses.add(null)
                set i: i + 1
                continue
            }
            let c clause as ref[AstNode]
            if AstNode.kind_of(c) <> KindCaseClause
            {
                links.witnesses.add(null)
                set i: i + 1
                continue
            }
            let e AstNode.expression_of(c)
            if e = null
            {
                set links.witnesses_usable: false
                return false
            }
            if Parser.is_string_literal_like(e as ref[AstNode]) = false
            {
                set links.witnesses_usable: false
                return false
            }
            let d AstNode.literal_text_of(e as ref[AstNode])
            let dn AstNode.literal_text_length_of(e as ref[AstNode])
            var duplicate false
            var j 0
            let m links.witnesses.get_length() as int
            while j < m
            {
                let prev links.witnesses[j]
                set j: j + 1
                if prev = null
                    continue
                let p prev as ref[SwitchWitness]
                if SymbolTable.names_equal(p.text, d)
                    set duplicate: true
            }
            if duplicate
                links.witnesses.add(null)
            else
                links.witnesses.add(&SwitchWitness^this(d))
            set i: i + 1
        }
        true
    }

    ; getNotEqualFactsFromTypeofSwitch — *"the combined not-equal type facts for
    ; all cases except those between the start and end indices"*.
    procedure get_not_equal_facts_from_typeof_switch(this, node: ref[AstNode], start: int, end: int) returns int
    {
        let links this.switch_statement_link_of(node)
        var facts TypeFactsNone
        let n links.witnesses.get_length() as int
        var i 0
        while i < n
        {
            let row links.witnesses[i]
            let idx i
            set i: i + 1
            if row = null
                continue
            var outside false
            if idx < start
                set outside: true
            if idx >= end
                set outside: true
            if outside = false
                continue
            let w row as ref[SwitchWitness]
            set facts: facts | Checker.typeof_ne_facts(w.text)
        }
        facts
    }

    ; narrowTypeBySwitchOnDiscriminant — `switch (x)`.
    procedure narrow_type_by_switch_on_discriminant(this, t: ref[Type], data: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let sw AstNode.flow_switch_statement_of(data)
        if sw = null
            return t
        let switch_statement sw as ref[AstNode]
        let switch_types this.get_switch_clause_types(switch_statement)
        if this.unported_mark() <> mark
            return null
        if switch_types = null
            return null
        let all switch_types as ref[Array[ref[Type]?]]
        let total all.get_length() as int
        if total = 0
            return t
        let clause_start AstNode.flow_clause_start_of(data)
        let clause_end AstNode.flow_clause_end_of(data)
        let clause_types this.new_type_list(null)
        var i clause_start
        while i < clause_end
        {
            if i < total
                clause_types.add(all[i])
            set i: i + 1
        }
        var has_default false
        if clause_start = clause_end
            set has_default: true
        var k 0
        let ct_len clause_types.get_length() as int
        while k < ct_len
        {
            let row clause_types[k]
            set k: k + 1
            if row = null
                continue
            if (row as ref[Type]) = never_type
                set has_default: true
        }
        ; "We only narrow if all case expressions specify values with unit types,
        ; except for the case where `type` is unknown."
        if (t.flags & TypeFlagsUnknown) <> 0
        {
            if has_default = false
                return this.narrow_unknown_by_switch_clauses(t, clause_types)
        }
        let discriminant_type this.get_union_type(clause_types)
        if this.unported_mark() <> mark
            return null
        if discriminant_type = null
            return null
        let dt discriminant_type as ref[Type]
        var case_type never_type
        if (dt.flags & TypeFlagsNever) = 0
        {
            let filtered this.filter_type_comparable_to_discriminant(t, dt)
            if this.unported_mark() <> mark
                return null
            if filtered = null
                return null
            let replaced this.replace_primitives_with_literals(filtered as ref[Type], dt)
            if this.unported_mark() <> mark
                return null
            if replaced = null
                return null
            set case_type: replaced as ref[Type]
        }
        if has_default = false
            return case_type
        let default_type this.filter_type_not_in_switch_types(t, all)
        if this.unported_mark() <> mark
            return null
        if default_type = null
            return null
        if (case_type.flags & TypeFlagsNever) <> 0
            return default_type
        let both &Array[ref[Type]?]()
        both.add(case_type)
        both.add(default_type)
        this.get_union_type(both)
    }

    ; The `unknown` arm of narrowTypeBySwitchOnDiscriminant: *"we map object types
    ; to the nonPrimitive type and narrow with that"*, and a clause type that is
    ; neither primitive nor object gives up on the whole switch.
    procedure narrow_unknown_by_switch_clauses(this, t: ref[Type], clause_types: ref[Array[ref[Type]?]]) returns ref[Type]?
    {
        let n clause_types.get_length() as int
        let ground &Array[ref[Type]?]()
        var i 0
        while i < n
        {
            let row clause_types[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            if (s.flags & (TypeFlagsPrimitive | TypeFlagsNonPrimitive)) <> 0
            {
                ground.add(s)
                continue
            }
            if (s.flags & TypeFlagsObject) <> 0
            {
                ground.add(non_primitive_type)
                continue
            }
            return t
        }
        this.get_union_type(ground)
    }

    ; The case filter: comparable to the union of this clause range's types.
    procedure filter_type_comparable_to_discriminant(this, t: ref[Type], discriminant_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let keep this.are_types_comparable(discriminant_type, row as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if keep
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let keep this.are_types_comparable(discriminant_type, t)
        if this.unported_mark() <> mark
            return null
        if keep
            return t
        never_type
    }

    ; The DEFAULT filter: a unit-like constituent survives only if no case in the
    ; WHOLE switch could have matched it.
    procedure filter_type_not_in_switch_types(this, t: ref[Type], switch_types: ref[Array[ref[Type]?]]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let keep this.survives_default_clause(row as ref[Type], switch_types)
                if this.unported_mark() <> mark
                    return null
                if keep
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let keep this.survives_default_clause(t, switch_types)
        if this.unported_mark() <> mark
            return null
        if keep
            return t
        never_type
    }

    procedure survives_default_clause(this, t: ref[Type], switch_types: ref[Array[ref[Type]?]]) returns bool
    {
        let mark this.unported_mark()
        if this.is_unit_like_type(t) = false
            return true
        if this.unported_mark() <> mark
            return false
        var u undefined_type
        if (t.flags & TypeFlagsUndefined) = 0
        {
            let unit this.extract_unit_type(t)
            let regular this.get_regular_type_of_literal_type(unit)
            if this.unported_mark() <> mark
                return false
            if regular = null
                return false
            set u: regular as ref[Type]
        }
        let n switch_types.get_length() as int
        var i 0
        while i < n
        {
            let row switch_types[i]
            set i: i + 1
            if row = null
                continue
            let st row as ref[Type]
            if Checker.is_unit_type(st) = false
                continue
            if this.are_types_comparable(st, u)
                return false
            if this.unported_mark() <> mark
                return false
        }
        true
    }

    ; narrowTypeBySwitchOnTypeOf — `switch (typeof x)`.
    procedure narrow_type_by_switch_on_typeof(this, t: ref[Type], data: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let sw AstNode.flow_switch_statement_of(data)
        if sw = null
            return t
        let switch_statement sw as ref[AstNode]
        if this.get_switch_clause_type_of_witnesses(switch_statement) = false
            return t
        if this.unported_mark() <> mark
            return null
        let links this.switch_statement_link_of(switch_statement)
        let clause_start AstNode.flow_clause_start_of(data)
        let clause_end AstNode.flow_clause_end_of(data)
        let has_default Checker.switch_range_has_default(switch_statement, clause_start, clause_end)
        if has_default
        {
            ; "In the default clause we filter constituents down to those that are
            ; not-equal to all handled cases."
            let facts this.get_not_equal_facts_from_typeof_switch(switch_statement, clause_start, clause_end)
            return this.filter_type_by_exact_facts(t, facts)
        }
        ; "In the non-default cause we create a union of the type narrowed by each
        ; of the listed cases."
        let parts &Array[ref[Type]?]()
        let n links.witnesses.get_length() as int
        var i clause_start
        while i < clause_end
        {
            if i >= n
            {
                set i: i + 1
                continue
            }
            let row links.witnesses[i]
            set i: i + 1
            if row = null
            {
                parts.add(never_type)
                continue
            }
            let w row as ref[SwitchWitness]
            let narrowed this.narrow_type_by_type_name(t, w.text)
            if this.unported_mark() <> mark
                return null
            if narrowed = null
                return null
            parts.add(narrowed)
        }
        this.get_union_type(parts)
    }

    ; The default-clause test the two typeof/true arms share: *"equal start and end
    ; denotes implicit fallthrough; undefined marks explicit default clause"*.
    function switch_range_has_default(switch_statement: ref[AstNode], clause_start: int, clause_end: int) returns bool
    {
        if clause_start = clause_end
            return true
        let clauses AstNode.case_clauses_of(AstNode.case_block_of(switch_statement))
        let n AstNode.list_count(clauses)
        var i 0
        while i < n
        {
            let clause AstNode.child_in_list(clauses, i)
            let idx i
            set i: i + 1
            if clause = null
                continue
            if AstNode.kind_of(clause as ref[AstNode]) <> KindDefaultClause
                continue
            if idx < clause_start
                return false
            if idx >= clause_end
                return false
            return true
        }
        false
    }

    ; filterType(t, getTypeFacts(t, facts) == facts) — the default clause's filter,
    ; and it is an EXACT-match test rather than a mask test.
    procedure filter_type_by_exact_facts(this, t: ref[Type], facts: int) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.get_type_facts(row as ref[Type], facts) = facts
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if this.get_type_facts(t, facts) = facts
            return t
        never_type
    }

    ; narrowTypeBySwitchOnTrue — `switch (true)`, where each case is a CONDITION
    ; and the narrowing is narrowType over the clause expressions.
    procedure narrow_type_by_switch_on_true(this, f: ref[FlowState], t: ref[Type], data: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let sw AstNode.flow_switch_statement_of(data)
        if sw = null
            return t
        let switch_statement sw as ref[AstNode]
        let clauses AstNode.case_clauses_of(AstNode.case_block_of(switch_statement))
        let n AstNode.list_count(clauses)
        let clause_start AstNode.flow_clause_start_of(data)
        let clause_end AstNode.flow_clause_end_of(data)
        let has_default Checker.switch_range_has_default(switch_statement, clause_start, clause_end)
        var cur t
        ; "First, narrow away all of the cases that preceded this set of cases."
        var i 0
        while i < clause_start
        {
            let clause AstNode.child_in_list(clauses, i)
            set i: i + 1
            if clause = null
                continue
            let c clause as ref[AstNode]
            if AstNode.kind_of(c) <> KindCaseClause
                continue
            let e AstNode.expression_of(c)
            if e = null
                continue
            let narrowed this.narrow_type(f, cur, e as ref[AstNode], false)
            if this.unported_mark() <> mark
                return null
            if narrowed = null
                return null
            set cur: narrowed as ref[Type]
        }
        ; "If our current set has a default, then none the other cases were hit
        ; either."
        if has_default
        {
            var j clause_end
            while j < n
            {
                let clause AstNode.child_in_list(clauses, j)
                set j: j + 1
                if clause = null
                    continue
                let c clause as ref[AstNode]
                if AstNode.kind_of(c) <> KindCaseClause
                    continue
                let e AstNode.expression_of(c)
                if e = null
                    continue
                let narrowed this.narrow_type(f, cur, e as ref[AstNode], false)
                if this.unported_mark() <> mark
                    return null
                if narrowed = null
                    return null
                set cur: narrowed as ref[Type]
            }
            return cur
        }
        ; "Now, narrow based on the cases in this set."
        let parts &Array[ref[Type]?]()
        var k clause_start
        while k < clause_end
        {
            let clause AstNode.child_in_list(clauses, k)
            set k: k + 1
            if clause = null
                continue
            let c clause as ref[AstNode]
            if AstNode.kind_of(c) <> KindCaseClause
            {
                parts.add(never_type)
                continue
            }
            let e AstNode.expression_of(c)
            if e = null
            {
                parts.add(never_type)
                continue
            }
            let narrowed this.narrow_type(f, cur, e as ref[AstNode], true)
            if this.unported_mark() <> mark
                return null
            if narrowed = null
                return null
            parts.add(narrowed)
        }
        this.get_union_type(parts)
    }

    ; narrowTypeBySwitchOptionalChainContainment. ★Its func value is one of two
    ; static predicates (§3.5e), so it travels as a boolean: `true` for the
    ; typeof form, whose clause type must not be the string `"undefined"`.
    procedure narrow_type_by_switch_optional_chain_containment(this, t: ref[Type], data: ref[AstNode], typeof_form: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let clause_start AstNode.flow_clause_start_of(data)
        let clause_end AstNode.flow_clause_end_of(data)
        if clause_start = clause_end
            return t
        let sw AstNode.flow_switch_statement_of(data)
        if sw = null
            return t
        let switch_types this.get_switch_clause_types(sw as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if switch_types = null
            return null
        let all switch_types as ref[Array[ref[Type]?]]
        let total all.get_length() as int
        var i clause_start
        while i < clause_end
        {
            if i >= total
            {
                set i: i + 1
                continue
            }
            let row all[i]
            set i: i + 1
            if row = null
                return t
            let s row as ref[Type]
            if typeof_form = false
            {
                if (s.flags & (TypeFlagsUndefined | TypeFlagsNever)) <> 0
                    return t
                continue
            }
            if (s.flags & TypeFlagsNever) <> 0
                return t
            if (s.flags & TypeFlagsStringLiteral) <> 0
            {
                var lb char[JSNUM_MAX_TEXT]
                let ld this.get_property_name_from_type(s, Slice[char](JSNUM_MAX_TEXT as size_t, &lb[0]))
                if this.unported_mark() <> mark
                    return null
                if Checker.name_is(ld, "undefined")
                    return t
            }
        }
        this.get_type_with_facts(t, TypeFactsNEUndefinedOrNull)
    }

    ; narrowTypeBySwitchOnDiscriminantProperty — `switch (x.kind)`.
    procedure narrow_type_by_switch_on_discriminant_property(this, t: ref[Type], access: ref[AstNode], data: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let clause_start AstNode.flow_clause_start_of(data)
        let clause_end AstNode.flow_clause_end_of(data)
        if clause_start < clause_end
        {
            if (t.flags & TypeFlagsUnion) <> 0
            {
                var accessed_data Slice[char]()
                if this.get_accessed_property_name(access, &accessed_data)
                {
                    if accessed_data.length <> 0
                    {
                        var key_data Slice[char]()
                        if this.get_key_property_name(t, &key_data)
                        {
                            if SymbolTable.names_equal(key_data, accessed_data)
                            {
                                ; `unknown_type` is the reference's `candidate ==
                                ; unknownType`: fall through to the discriminant walk
                                let keyed this.narrow_by_switch_key_property(t, data, clause_start, clause_end)
                                if keyed = null
                                    return null
                                if (keyed as ref[Type]) <> unknown_type
                                    return keyed
                            }
                        }
                        if this.unported_mark() <> mark
                            return null
                    }
                }
                if this.unported_mark() <> mark
                    return null
            }
        }
        this.narrow_type_by_discriminant(t, access, NarrowKindSwitchOnDiscriminant, null, null, KindUnknown, false, data)
    }

    ; The key-property route of the switch arm — unreachable for
    ; narrow_by_key_property's reason, and written whole for the same one.
    procedure narrow_by_switch_key_property(this, t: ref[Type], data: ref[AstNode], clause_start: int, clause_end: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let sw AstNode.flow_switch_statement_of(data)
        if sw = null
            return t
        let switch_types this.get_switch_clause_types(sw as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if switch_types = null
            return null
        let all switch_types as ref[Array[ref[Type]?]]
        let total all.get_length() as int
        let parts &Array[ref[Type]?]()
        var i clause_start
        while i < clause_end
        {
            if i >= total
            {
                set i: i + 1
                continue
            }
            let row all[i]
            set i: i + 1
            if row = null
                continue
            let result this.get_constituent_type_for_key_type(t, row as ref[Type])
            if this.unported_mark() <> mark
                return null
            if result = null
                parts.add(unknown_type)
            else
                parts.add(result)
        }
        let candidate this.get_union_type(parts)
        if this.unported_mark() <> mark
            return null
        if candidate = null
            return null
        ; ★ a clause whose key has no constituent (a DUPLICATE key: two members
        ; share `type: T.A3`) makes the union `unknown`, and the reference then
        ; narrows by the discriminant walk instead — this answered t, unnarrowed,
        ; and every member access in the arm reported TS2339 (2026-09-17)
        candidate
    }

    ; ── the exhaustiveness question ─────────────────────────────────────────

    ; isExhaustiveSwitchStatement. ★The three-state memo is the reference's own
    ; circularity break: a switch whose exhaustiveness is being computed answers
    ; FALSE if it is asked again.
    procedure is_exhaustive_switch_statement(this, node: ref[AstNode]) returns bool
    {
        let links this.switch_statement_link_of(node)
        if links.exhaustive_state = ExhaustiveStateUnknown
        {
            set links.exhaustive_state: ExhaustiveStateComputing
            let mark this.unported_mark()
            let exhaustive this.compute_exhaustive_switch_statement(node)
            if this.unported_mark() <> mark
            {
                set links.exhaustive_state: ExhaustiveStateUnknown
                return false
            }
            if links.exhaustive_state = ExhaustiveStateComputing
            {
                if exhaustive
                    set links.exhaustive_state: ExhaustiveStateTrue
                else
                    set links.exhaustive_state: ExhaustiveStateFalse
            }
        }
        else
        {
            if links.exhaustive_state = ExhaustiveStateComputing
                set links.exhaustive_state: ExhaustiveStateFalse
        }
        links.exhaustive_state = ExhaustiveStateTrue
    }

    ; computeExhaustiveSwitchStatement.
    procedure compute_exhaustive_switch_statement(this, node: ref[AstNode]) returns bool
    {
        let mark this.unported_mark()
        let expr_opt AstNode.expression_of(node)
        if expr_opt = null
            return false
        let expr expr_opt as ref[AstNode]
        if AstNode.kind_of(expr) = KindTypeOfExpression
        {
            if this.get_switch_clause_type_of_witnesses(node) = false
                return false
            if this.unported_mark() <> mark
                return false
            let inner AstNode.expression_of(expr)
            if inner = null
                return false
            let checked this.check_expression_cached(inner as ref[AstNode])
            if this.unported_mark() <> mark
                return false
            if checked = null
                return false
            let constraint this.get_base_constraint_or_type(checked as ref[Type])
            if this.unported_mark() <> mark
                return false
            if constraint = null
                return false
            let operand constraint as ref[Type]
            let facts this.get_not_equal_facts_from_typeof_switch(node, 0, 0)
            if (operand.flags & TypeFlagsAnyOrUnknown) <> 0
            {
                ; "We special case the top types to be exhaustive when all cases
                ; are handled."
                return (TypeFactsAllTypeofNE & facts) = TypeFactsAllTypeofNE
            }
            ; "A missing not-equal flag indicates that the type wasn't handled by
            ; some case."
            let some this.some_type_has_exact_facts(operand, facts)
            if this.unported_mark() <> mark
                return false
            return some = false
        }
        let checked this.check_expression_cached(expr)
        if this.unported_mark() <> mark
            return false
        if checked = null
            return false
        let based this.get_base_constraint_or_type(checked as ref[Type])
        if this.unported_mark() <> mark
            return false
        if based = null
            return false
        let t based as ref[Type]
        if Checker.is_literal_type(t) = false
            return false
        let switch_types this.get_switch_clause_types(node)
        if this.unported_mark() <> mark
            return false
        if switch_types = null
            return false
        let all switch_types as ref[Array[ref[Type]?]]
        let n all.get_length() as int
        if n = 0
            return false
        var i 0
        while i < n
        {
            let row all[i]
            set i: i + 1
            if row = null
                continue
            if Checker.is_neither_unit_type_nor_never(row as ref[Type])
                return false
        }
        let mapped this.map_type_to_regular_literal(t)
        if this.unported_mark() <> mark
            return false
        if mapped = null
            return false
        this.each_type_contained_in(mapped as ref[Type], all)
    }

    ; isNeitherUnitTypeNorNever.
    function is_neither_unit_type_nor_never(t: ref[Type]) returns bool
        (t.flags & (TypeFlagsUnit | TypeFlagsNever)) = 0

    ; someType(t, getTypeFacts(t, facts) == facts).
    procedure some_type_has_exact_facts(this, t: ref[Type], facts: int) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.get_type_facts(t, facts) = facts
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if this.get_type_facts(row as ref[Type], facts) = facts
                return true
        }
        false
    }

    ; mapType(t, c.getRegularTypeOfLiteralType).
    procedure map_type_to_regular_literal(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & TypeFlagsUnion) = 0
            return this.get_regular_type_of_literal_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            let m this.get_regular_type_of_literal_type(s)
            if this.unported_mark() <> mark
                return null
            if m = null
                return null
            if (m as ref[Type]) <> s
                set changed: true
            mapped.add(m)
        }
        if changed = false
            return t
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }

    ; eachTypeContainedIn.
    function each_type_contained_in(this, source: ref[Type], types: ref[Array[ref[Type]?]]) returns bool
    {
        if (source.flags & TypeFlagsUnion) = 0
            return Checker.type_list_contains(types, source)
        let list Checker.union_types_of(source)
        if list = null
            return false
        let l list as ref[Array[ref[Type]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            let row l[i]
            set i: i + 1
            if row = null
                continue
            if Checker.type_list_contains(types, row as ref[Type]) = false
                return false
        }
        true
    }

    ; ★ eachTypeContainedIn's membership test is the file's EXISTING
    ; `type_list_contains` (slice 118's, over a nullable element) rather than a
    ; second copy: a duplicate definition here would have SHADOWED that one — the
    ; first definition wins and the later body is dead — and the compiler said so
    ; at its four call sites the moment both existed.

    ; ── the ASSIGNMENT MARKS (slice 123) ────────────────────────────────────
    ;
    ; ★★ THE WALK IS RUN ONCE PER FUNCTION AND ITS PRODUCT IS A POSITION. For every
    ; parameter and mutable local it records the SOURCE POSITION of the last
    ; assignment, so that `isSymbolAssigned` and `isPastLastAssignment` are two
    ; comparisons rather than a flow analysis — the reference's own comment calls
    ; it *"more conservative than full control flow analysis, but … only a single
    ; walk over the AST"*.

    ; c.markedAssignmentSymbolLinks.Get(symbol), the mint-on-miss idiom keyed on
    ; the SYMBOL.
    procedure marked_assignment_link_of(this, symbol: ref[Symbol]) returns ref[MarkedAssignmentLink]
    {
        let ix marked_assignment_links_index
        let at ix.find(symbol as int)
        if at > 0
        {
            let row marked_assignment_links[at - 1]
            if row <> null
                return row as ref[MarkedAssignmentLink]
        }
        let made &MarkedAssignmentLink^host(symbol)
        marked_assignment_links.add(made)
        ix.insert(symbol as int, (marked_assignment_links.get_length() as int) - 1)
        made
    }

    ; isSymbolAssignedDefinitely.
    procedure is_symbol_assigned_definitely(this, symbol: ref[Symbol]) returns bool
    {
        this.ensure_assignments_marked(symbol)
        this.marked_assignment_link_of(symbol).has_definite_assignment
    }

    ; isSymbolAssigned.
    procedure is_symbol_assigned(this, symbol: ref[Symbol]) returns bool
    {
        this.ensure_assignments_marked(symbol)
        this.marked_assignment_link_of(symbol).last_assignment_pos <> 0
    }

    ; isPastLastAssignment.
    procedure is_past_last_assignment(this, symbol: ref[Symbol], location: ref[AstNode]?) returns bool
    {
        this.ensure_assignments_marked(symbol)
        let pos this.marked_assignment_link_of(symbol).last_assignment_pos
        if pos = 0
            return true
        if location = null
            return false
        pos < AstNode.pos_of(location as ref[AstNode])
    }

    ; isSomeSymbolAssigned / isSomeSymbolAssignedWorker — the binding pattern's
    ; question, asked of every name a pattern declares.
    procedure is_some_symbol_assigned(this, root_declaration: ref[AstNode]) returns bool
    {
        let name AstNode.name_of(root_declaration)
        if name = null
            return false
        this.is_some_symbol_assigned_worker(name as ref[AstNode])
    }

    procedure is_some_symbol_assigned_worker(this, node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) = KindIdentifier
        {
            let symbol this.get_symbol_of_declaration(AstNode.parent_node_of(node))
            if symbol = null
                return false
            return this.is_symbol_assigned(symbol as ref[Symbol])
        }
        let elements AstNode.elements_of(node)
        let n AstNode.list_count(elements)
        var i 0
        while i < n
        {
            let element AstNode.child_in_list(elements, i)
            set i: i + 1
            if element = null
                continue
            let e element as ref[AstNode]
            if AstNode.kind_of(e) = KindOmittedExpression
                continue
            let en AstNode.name_of(e)
            if en = null
                continue
            if this.is_some_symbol_assigned_worker(en as ref[AstNode])
                return true
        }
        false
    }

    ; ensureAssignmentsMarked.
    procedure ensure_assignments_marked(this, symbol: ref[Symbol])
    {
        if this.marked_assignment_link_of(symbol).last_assignment_pos <> 0
            return
        let decl Symbol.value_declaration_of(symbol)
        if decl = null
            return
        let parent Checker.find_function_or_source_file(decl as ref[AstNode])
        if parent = null
            return
        let p parent as ref[AstNode]
        let links this.node_link_of(p)
        if links.assignments_marked
            return
        set links.assignments_marked: true
        if this.has_parent_with_assignments_marked(p)
            return
        this.mark_node_assignments(p)
    }

    ; ast.FindAncestor(node, ast.IsFunctionOrSourceFile), written as the climb it
    ; is (§3.9d). ★It starts AT the node, which is what makes a function
    ; declaration its own container.
    function find_function_or_source_file(node: ref[AstNode]) returns ref[AstNode]?
    {
        var cur: ref[AstNode]? node
        while cur <> null
        {
            let n cur as ref[AstNode]
            if Checker.is_function_or_source_file(n)
                return n
            set cur: AstNode.parent_node_of(n)
        }
        null
    }

    function is_function_or_source_file(n: ref[AstNode]) returns bool
    {
        if AstNode.is_function_like(n)
            return true
        AstNode.kind_of(n) = KindSourceFile
    }

    ; hasParentWithAssignmentsMarked.
    procedure has_parent_with_assignments_marked(this, node: ref[AstNode]) returns bool
    {
        var cur AstNode.parent_node_of(node)
        while cur <> null
        {
            let n cur as ref[AstNode]
            if Checker.is_function_or_source_file(n)
            {
                if this.node_link_of(n).assignments_marked
                    return true
            }
            set cur: AstNode.parent_node_of(n)
        }
        false
    }

    ; markNodeAssignments — the reference's ForEachChild(visitor) recursion, as
    ; the walk §3.9d prescribes. ★The worker answers *stop descending* and the
    ; walker reads it, which is the whole shape of ForEachChild's bool.
    procedure mark_node_assignments(this, node: ref[AstNode])
    {
        if this.mark_node_assignments_worker(node)
            return
        ; `node.ForEachChild`: child_at answers null past the last child, so the
        ; walk needs no child_count first (which asked child_at for every child
        ; once more — slice 357, a walk over every node of every file)
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            set i: i + 1
            this.mark_node_assignments(child as ref[AstNode])
        }
    }

    ; markNodeAssignmentsWorker.
    procedure mark_node_assignments_worker(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindIdentifier
        {
            let assignment_kind Checker.get_assignment_target_kind(node)
            if assignment_kind = AssignmentKindNone
                return true
            let mark this.unported_mark()
            let symbol this.get_resolved_symbol(node)
            if this.unported_mark() <> mark
                return true
            if this.is_parameter_or_mutable_local_variable(symbol) = false
                return true
            let links this.marked_assignment_link_of(symbol)
            var revisit false
            if links.last_assignment_pos = 0
                set revisit: true
            if links.last_assignment_pos <> MARKED_ASSIGNMENT_MAX
                set revisit: true
            if revisit
            {
                let referencing Checker.find_function_or_source_file(node)
                let decl Symbol.value_declaration_of(symbol)
                var declaring: ref[AstNode]? null
                if decl <> null
                    set declaring: Checker.find_function_or_source_file(decl as ref[AstNode])
                if referencing = declaring
                {
                    if decl <> null
                        set links.last_assignment_pos: Checker.extend_assignment_position(node, decl as ref[AstNode])
                }
                else
                    set links.last_assignment_pos: MARKED_ASSIGNMENT_MAX
            }
            if assignment_kind = AssignmentKindDefinite
                set links.has_definite_assignment: true
            return true
        }
        if k = KindExportSpecifier
        {
            ; "When … references occur in export specifiers, record MaxInt32."
            let spec_parent AstNode.parent_node_of(AstNode.parent_node_of(node))
            if spec_parent = null
                return true
            let ed spec_parent as ref[AstNode]
            let name Checker.property_name_or_name_of(node)
            if name = null
                return true
            if AstNode.is_type_only_of(node)
                return true
            if AstNode.is_type_only_of(ed)
                return true
            if AstNode.module_specifier_of(ed) <> null
                return true
            if AstNode.kind_of(name as ref[AstNode]) = KindStringLiteral
                return true
            let mark this.unported_mark()
            let symbol this.resolve_entity_name(name as ref[AstNode], SymbolFlagsValue, true, true, null)
            if this.unported_mark() <> mark
                return true
            if symbol = null
                return true
            if this.is_parameter_or_mutable_local_variable(symbol as ref[Symbol]) = false
                return true
            set this.marked_assignment_link_of(symbol as ref[Symbol]).last_assignment_pos: MARKED_ASSIGNMENT_MAX
            return true
        }
        var skip false
        if k = KindInterfaceDeclaration
            set skip: true
        if k = KindTypeAliasDeclaration
            set skip: true
        if k = KindJSTypeAliasDeclaration
            set skip: true
        if k = KindEnumDeclaration
            set skip: true
        if skip
            return true
        if k >= KindFirstTypeNode
        {
            if k <= KindLastTypeNode
                return true
        }
        false
    }

    ; extendAssignmentPosition — *"extend the position … to the end of any
    ; intervening variable statement, expression statement, compound statement, or
    ; class declaration occurring between the node and the given declaration"*.
    function extend_assignment_position(node: ref[AstNode], declaration: ref[AstNode]) returns int
    {
        var pos AstNode.pos_of(node)
        var cur: ref[AstNode]? node
        while cur <> null
        {
            let n cur as ref[AstNode]
            if AstNode.pos_of(n) <= AstNode.pos_of(declaration)
                return pos
            let k AstNode.kind_of(n)
            var extends_it false
            if k = KindVariableStatement
                set extends_it: true
            if k = KindExpressionStatement
                set extends_it: true
            if k = KindIfStatement
                set extends_it: true
            if k = KindDoStatement
                set extends_it: true
            if k = KindWhileStatement
                set extends_it: true
            if k = KindForStatement
                set extends_it: true
            if k = KindForInStatement
                set extends_it: true
            if k = KindForOfStatement
                set extends_it: true
            if k = KindWithStatement
                set extends_it: true
            if k = KindSwitchStatement
                set extends_it: true
            if k = KindTryStatement
                set extends_it: true
            if k = KindClassDeclaration
                set extends_it: true
            if extends_it
                set pos: AstNode.end_of(n)
            set cur: AstNode.parent_node_of(n)
        }
        pos
    }

    ; isConstantReference — the question every cache key and every alias inline
    ; asks: *"can this reference change between the narrowing and the use?"*
    procedure is_constant_reference(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindThisKeyword
            return true
        if k = KindIdentifier
        {
            if Checker.is_this_in_type_query(node)
                return false
            let mark this.unported_mark()
            let symbol this.get_resolved_symbol(node)
            if this.unported_mark() <> mark
                return false
            if this.is_constant_variable(symbol)
                return true
            if this.is_parameter_or_mutable_local_variable(symbol)
            {
                if this.is_symbol_assigned(symbol) = false
                    return true
            }
            let decl Symbol.value_declaration_of(symbol)
            if decl = null
                return false
            return AstNode.kind_of(decl as ref[AstNode]) = KindFunctionExpression
        }
        var access false
        if k = KindPropertyAccessExpression
            set access: true
        if k = KindElementAccessExpression
            set access: true
        if access
        {
            ; "The resolvedSymbol property is initialized by checkPropertyAccess or
            ; checkElementAccess before we get here."
            let e AstNode.expression_of(node)
            if e = null
                return false
            if this.is_constant_reference(e as ref[AstNode]) = false
                return false
            let symbol this.get_resolved_symbol_or_nil(node)
            if symbol = null
                return false
            return this.is_readonly_symbol(symbol as ref[Symbol])
        }
        var pattern false
        if k = KindObjectBindingPattern
            set pattern: true
        if k = KindArrayBindingPattern
            set pattern: true
        if pattern = false
            return false
        let root Binder.get_root_declaration(AstNode.parent_node_of(node))
        if root = null
            return false
        let r root as ref[AstNode]
        let rk AstNode.kind_of(r)
        var caught false
        if rk = KindParameter
            set caught: true
        if rk = KindVariableDeclaration
        {
            if Checker.kind_or_unknown(AstNode.parent_node_of(r)) = KindCatchClause
                set caught: true
        }
        if caught
            return this.is_some_symbol_assigned(r) = false
        if rk <> KindVariableDeclaration
            return false
        this.is_var_const_like(r)
    }

    ; ── the type predicate's narrowing arms ─────────────────────────────────

    ; getTypePredicateArgument.
    function get_type_predicate_argument(predicate: ref[TypePredicate], call_expression: ref[AstNode]) returns ref[AstNode]?
    {
        var identifier_form false
        if predicate.kind = TypePredicateKindIdentifier
            set identifier_form: true
        if predicate.kind = TypePredicateKindAssertsIdentifier
            set identifier_form: true
        if identifier_form
        {
            let args AstNode.call_arguments_of(call_expression)
            if predicate.parameter_index < 0
                return null
            if predicate.parameter_index >= AstNode.list_count(args)
                return null
            return AstNode.child_in_list(args, predicate.parameter_index)
        }
        let callee AstNode.expression_of(call_expression)
        if callee = null
            return null
        let invoked Parser.skip_parentheses(callee)
        if invoked = null
            return null
        let iv invoked as ref[AstNode]
        if Parser.is_access_expression(iv) = false
            return null
        Parser.skip_parentheses(AstNode.expression_of(iv))
    }

    ; narrowTypeByTypePredicate — `x is T`.
    procedure narrow_type_by_type_predicate(this, f: ref[FlowState], t: ref[Type], predicate: ref[TypePredicate], call_expression: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if predicate.t = null
            return t
        let pt predicate.t as ref[Type]
        ; "Don't narrow from 'any' if the predicate type is exactly 'Object' or
        ; 'Function'."
        if Checker.is_type_any(t)
        {
            let go this.get_global_object_type()
            if this.unported_mark() <> mark
                return null
            if go <> null
            {
                if pt = (go as ref[Type])
                    return t
            }
            let gf this.get_global_function_type()
            if this.unported_mark() <> mark
                return null
            if gf <> null
            {
                if pt = (gf as ref[Type])
                    return t
            }
        }
        let arg Checker.get_type_predicate_argument(predicate, call_expression)
        if arg = null
            return t
        let predicate_argument arg as ref[AstNode]
        let reference f.reference as ref[AstNode]
        if this.is_matching_reference(reference, predicate_argument)
            return this.get_narrowed_type(t, pt, assume_true, false)
        var cur t
        if Checker.strict_null_checks()
        {
            if this.optional_chain_contains_reference(predicate_argument, reference)
            {
                var removes_nullable false
                if assume_true
                {
                    if this.has_type_facts(pt, TypeFactsEQUndefined) = false
                        set removes_nullable: true
                }
                else
                {
                    if this.every_type_is_nullable(pt)
                        set removes_nullable: true
                    if this.unported_mark() <> mark
                        return null
                }
                if removes_nullable
                {
                    let adjusted this.get_adjusted_type_with_facts(t, TypeFactsNEUndefinedOrNull)
                    if this.unported_mark() <> mark
                        return null
                    if adjusted = null
                        return null
                    set cur: adjusted as ref[Type]
                }
            }
        }
        let access this.get_discriminant_property_access(f, predicate_argument, cur)
        if this.unported_mark() <> mark
            return null
        if access = null
            return cur
        this.narrow_type_by_discriminant(cur, access as ref[AstNode], NarrowKindNarrowedType, pt, null, KindUnknown, assume_true, null)
    }

    ; narrowTypeByAssertion — `assert(cond)`, whose argument is a CONDITION rather
    ; than a reference, so the whole conditional engine runs on it.
    procedure narrow_type_by_assertion(this, f: ref[FlowState], t: ref[Type], expr: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let skipped Parser.skip_parentheses(expr)
        if skipped = null
            return t
        let node skipped as ref[AstNode]
        if AstNode.kind_of(node) = KindFalseKeyword
            return unreachable_never_type
        if AstNode.kind_of(node) = KindBinaryExpression
        {
            let op AstNode.binary_operator_kind(node)
            let left AstNode.binary_left_of(node)
            let right AstNode.binary_right_of(node)
            if left <> null
            {
                if right <> null
                {
                    if op = KindAmpersandAmpersandToken
                    {
                        let first this.narrow_type_by_assertion(f, t, left as ref[AstNode])
                        if this.unported_mark() <> mark
                            return null
                        if first = null
                            return null
                        return this.narrow_type_by_assertion(f, first as ref[Type], right as ref[AstNode])
                    }
                    if op = KindBarBarToken
                    {
                        let a this.narrow_type_by_assertion(f, t, left as ref[AstNode])
                        if this.unported_mark() <> mark
                            return null
                        let b this.narrow_type_by_assertion(f, t, right as ref[AstNode])
                        if this.unported_mark() <> mark
                            return null
                        if a = null
                            return null
                        if b = null
                            return null
                        let both &Array[ref[Type]?]()
                        both.add(a)
                        both.add(b)
                        return this.get_union_type(both)
                    }
                }
            }
        }
        this.narrow_type(f, t, node, true)
    }

    ; narrowTypeByCallExpression — a call that narrows: a type predicate, or the
    ; `hasOwnProperty` special case the reference carries for exactOptionalPropertyTypes.
    procedure narrow_type_by_call_expression(this, f: ref[FlowState], t: ref[Type], call_expression: ref[AstNode], assume_true: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let reference f.reference as ref[AstNode]
        if this.has_matching_argument(call_expression, reference)
        {
            var may_have_effects false
            if assume_true
                set may_have_effects: true
            if Checker.is_call_chain(call_expression) = false
                set may_have_effects: true
            if may_have_effects
            {
                let signature this.get_effects_signature(call_expression)
                if this.unported_mark() <> mark
                    return null
                if signature <> null
                {
                    let predicate this.get_type_predicate_of_signature(signature as ref[Signature])
                    if this.unported_mark() <> mark
                        return null
                    if predicate <> null
                    {
                        let p predicate as ref[TypePredicate]
                        var narrowing false
                        if p.kind = TypePredicateKindThis
                            set narrowing: true
                        if p.kind = TypePredicateKindIdentifier
                            set narrowing: true
                        if narrowing
                            return this.narrow_type_by_type_predicate(f, t, p, call_expression, assume_true)
                    }
                }
            }
        }
        if this.contains_missing_type(t) = false
            return t
        if Parser.is_access_expression(reference) = false
            return t
        let callee AstNode.expression_of(call_expression)
        if callee = null
            return t
        let call_access callee as ref[AstNode]
        if AstNode.kind_of(call_access) <> KindPropertyAccessExpression
            return t
        let recv AstNode.expression_of(call_access)
        let ref_expr AstNode.expression_of(reference)
        if recv = null
            return t
        if ref_expr = null
            return t
        if this.is_matching_reference(ref_expr as ref[AstNode], Checker.get_reference_candidate(recv as ref[AstNode])) = false
            return t
        let name AstNode.name_of(call_access)
        if name = null
            return t
        let nm name as ref[AstNode]
        if AstNode.kind_of(nm) <> KindIdentifier
            return t
        if Checker.node_text_is(AstNode.identifier_text_of(nm), "hasOwnProperty") = false
            return t
        let args AstNode.call_arguments_of(call_expression)
        if AstNode.list_count(args) <> 1
            return t
        let argument AstNode.child_in_list(args, 0)
        if argument = null
            return t
        let a argument as ref[AstNode]
        var accessed_data Slice[char]()
        if this.get_accessed_property_name(reference, &accessed_data) = false
            return t
        if this.unported_mark() <> mark
            return null
        if Parser.is_string_literal_like(a) = false
            return t
        if SymbolTable.names_equal(accessed_data, AstNode.literal_text_of(a)) = false
            return t
        var facts TypeFactsEQUndefined
        if assume_true
            set facts: TypeFactsNEUndefined
        this.get_type_with_facts(t, facts)
    }

    ; ── the EFFECTS SIGNATURE ───────────────────────────────────────────────
    ;
    ; ★★ IT IS THE GATE IN FRONT OF FOUR CHAPTERS — the call arm of the flow walk,
    ; narrowTypeByCallExpression, the `[Symbol.hasInstance]` half of instanceof and
    ; isReachableFlowNode's Call arm — and what it answers is *does this call
    ; assert or return `never`?* The memo is on the CALL node, which is why the
    ; reference keeps it on signatureLinks and this port does the same.
    procedure get_effects_signature(this, node: ref[AstNode]) returns ref[Signature]?
    {
        let links this.signature_link_of(node)
        if links.effects_computed
            return links.effects_signature
        let mark this.unported_mark()
        ; ★ NOT memoized before the computation completes (slice 210): upstream stores
        ; `links.effectsSignature` only at the END, so a NESTED ask for the same call (the
        ; predicate's type resolves an alias whose `typeof x` walks the flow back over this
        ; very call) recomputes and runs into the type-resolution cycle — which is how
        ; `First = typeof arg` under `arg is First` becomes TS2456 + any
        ; (`controlFlowFunctionLikeCircular_8`). The in-progress guard that stood here
        ; answered the nested ask with "no effects". A stop below memoizes nothing.
        var func_type: ref[Type]? null
        if AstNode.kind_of(node) = KindBinaryExpression
        {
            let right AstNode.binary_right_of(node)
            if right = null
                return null
            let rt this.check_non_null_expression(right as ref[AstNode])
            if this.unported_mark() <> mark
            {
                return null
            }
            if rt = null
                return null
            set func_type: this.get_symbol_has_instance_method_of_object_type(rt as ref[Type])
            if this.unported_mark() <> mark
            {
                return null
            }
        }
        else
        {
            let callee AstNode.expression_of(node)
            if callee = null
                return null
            let c callee as ref[AstNode]
            if Checker.kind_or_unknown(AstNode.parent_node_of(node)) = KindExpressionStatement
            {
                ; "In order to avoid triggering circularities in control flow
                ; analysis, we use getTypeOfDottedName when resolving the call
                ; target expression of an assertion."
                set func_type: this.get_type_of_dotted_name(c)
                if this.unported_mark() <> mark
                {
                    return null
                }
            }
            else
            {
                if AstNode.kind_of(c) <> KindSuperKeyword
                {
                    ; ★The optional-chain arm, slice 139: the CHAIN's own
                    ; nullability is removed before the non-null check, where the
                    ; ordinary arm hands the expression straight to it.
                    if Binder.is_optional_chain(node)
                    {
                        let raw this.check_expression(c)
                        if this.unported_mark() <> mark
                        {
                            return null
                        }
                        if raw = null
                        {
                            return null
                        }
                        let non_optional this.get_optional_expression_type(raw as ref[Type], c)
                        if this.unported_mark() <> mark
                        {
                            return null
                        }
                        if non_optional = null
                        {
                            return null
                        }
                        set func_type: this.check_non_null_type(non_optional as ref[Type], c)
                        if this.unported_mark() <> mark
                        {
                            return null
                        }
                    }
                    if Binder.is_optional_chain(node) = false
                    {
                        set func_type: this.check_non_null_expression(c)
                        if this.unported_mark() <> mark
                        {
                            return null
                        }
                    }
                }
            }
        }
        var apparent: ref[Type]? null
        if func_type <> null
        {
            set apparent: this.get_apparent_type(func_type as ref[Type])
            if this.unported_mark() <> mark
            {
                return null
            }
        }
        var subject unknown_type
        if apparent <> null
            set subject: apparent as ref[Type]
        let signatures this.get_signatures_of_type(subject, SignatureKindCall)
        if this.unported_mark() <> mark
        {
            return null
        }
        let count Checker.sig_count(signatures)
        var chosen: ref[Signature]? null
        if count = 1
        {
            let only (signatures as ref[Array[ref[Signature]?]])[0]
            if only <> null
            {
                let sig only as ref[Signature]
                var generic false
                if sig.type_parameters <> null
                {
                    if ((sig.type_parameters as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                        set generic: true
                }
                if generic = false
                    set chosen: sig
            }
        }
        if chosen = null
        {
            var any_effect false
            var i 0
            while i < count
            {
                let row (signatures as ref[Array[ref[Signature]?]])[i]
                set i: i + 1
                if row = null
                    continue
                if this.has_type_predicate_or_never_return_type(row as ref[Signature])
                    set any_effect: true
                if this.unported_mark() <> mark
                {
                    return null
                }
            }
            if any_effect
            {
                set chosen: this.get_resolved_signature(node, CheckModeNormal)
                if this.unported_mark() <> mark
                {
                    return null
                }
            }
        }
        if chosen = null
        {
            set links.effects_computed: true
            return null
        }
        if this.has_type_predicate_or_never_return_type(chosen as ref[Signature]) = false
        {
            if this.unported_mark() <> mark
                return null
            set links.effects_computed: true
            return null
        }
        if this.unported_mark() <> mark
            return null
        set links.effects_computed: true
        set links.effects_signature: chosen
        links.effects_signature
    }

    ; getSymbolHasInstanceMethodOfObjectType.
    procedure get_symbol_has_instance_method_of_object_type(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        var nb char[JSNUM_MAX_TEXT]
        let nd this.get_property_name_for_known_symbol_name("hasInstance", Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if this.unported_mark() <> mark
            return null
        if this.all_types_assignable_to_kind(t, TypeFlagsNonPrimitive) = false
            return null
        if this.unported_mark() <> mark
            return null
        let prop this.get_property_of_type(t, nd)
        if this.unported_mark() <> mark
            return null
        if prop = null
            return null
        let pt this.get_type_of_symbol(prop as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        if pt = null
            return null
        let sigs this.get_signatures_of_type(pt as ref[Type], SignatureKindCall)
        if this.unported_mark() <> mark
            return null
        if Checker.sig_count(sigs) = 0
            return null
        pt
    }

    ; getPropertyNameForKnownSymbolName. ★The fallback is the INTERNAL name and it
    ; is what the corpus actually takes: the ESSymbol constructor's own type is a
    ; lib type, so a unit that does not resolve it lands on `__@hasInstance`, which
    ; is the name the binder gives a computed `[Symbol.hasInstance]` member.
    procedure get_property_name_for_known_symbol_name(this, d: Slice[char], buf: Slice[char]) returns Slice[char]
    {
        let mark this.unported_mark()
        let ctor this.get_global_es_symbol_constructor_symbol_or_nil()
        if this.unported_mark() <> mark
        {
            return Slice[char]()
        }
        if ctor <> null
        {
            let ct this.get_type_of_symbol(ctor as ref[Symbol])
            if this.unported_mark() <> mark
            {
                return Slice[char]()
            }
            if ct <> null
            {
                let unique this.get_type_of_property_of_type(ct as ref[Type], d)
                if this.unported_mark() <> mark
                {
                    return Slice[char]()
                }
                if unique <> null
                {
                    if Checker.is_type_usable_as_property_name(unique as ref[Type])
                        return this.get_property_name_from_type(unique as ref[Type], buf)
                }
            }
        }
        ; ast.InternalSymbolNamePrefix + "@" + symbolName
        var w 0
        buf.put(w, 0xFE as char)
        set w: w + 1
        buf.put(w, "@" as char)
        set w: w + 1
        var i 0
        while i < d.length
        {
            buf.put(w, d[i])
            set w: w + 1
            set i: i + 1
        }
        buf.subslice(0, w as size_t)
    }

    ; getGlobalESSymbolConstructorSymbolOrNil — the globals lookup behind the
    ; known-symbol name. ★It answers null rather than reporting: the reference's
    ; own name ends in `OrNil` and its caller has a fallback, so a missing lib
    ; symbol is a value here and not an incompleteness.
    procedure get_global_es_symbol_constructor_symbol_or_nil(this) returns ref[Symbol]?
        this.lookup_globals("Symbol", SymbolFlagsValue)

    ; getGlobalESSymbolConstructorTypeSymbolOrNil — its TYPE twin, slice 146.
    ; `getGlobalTypeSymbolResolver("SymbolConstructor", false)`, which is
    ; getGlobalSymbol with SymbolFlagsType, which is `resolveName(nil, …)` — and a
    ; nil location makes the resolver's whole location loop a no-op, so the globals
    ; table IS the answer. That collapse is the twin above's and is written once.
    ;
    ; ★★★ IT IS WHAT `is-global-symbol-constructor` WAS WAITING FOR, and the note
    ; that stop carried — *whose global symbol comes from a lib this compilation
    ; does not load* — was expired the day slice 104 put a table behind
    ; `lookup_globals`: `lib.es5.d.ts` declares `interface SymbolConstructor`.
    ; §3.5eo, and the same reading that expired the two
    ; `get-global-es-symbol-constructor-symbol` rows in this slice.
    procedure get_global_es_symbol_constructor_type_symbol_or_nil(this) returns ref[Symbol]?
        this.lookup_globals("SymbolConstructor", SymbolFlagsType)

    ; isGlobalSymbolConstructor, whole. ★A null node answers false through
    ; get_symbol_of_node's own null arm, which is why the parameter is nullable —
    ; its one caller hands it `declaration.Parent`.
    procedure is_global_symbol_constructor(this, node: ref[AstNode]?) returns bool
    {
        let symbol this.get_symbol_of_node(node)
        if symbol = null
            return false
        let global_symbol this.get_global_es_symbol_constructor_type_symbol_or_nil()
        if global_symbol = null
            return false
        (symbol as ref[Symbol]) = (global_symbol as ref[Symbol])
    }

    ; ── getTypeOfDottedName and the explicit type ───────────────────────────
    ;
    ; ★★ THE POINT OF IT IS THE CIRCULARITY, not the lookup: an assertion's call
    ; target must be resolvable *"with no possibility of triggering circularities
    ; in control flow analysis"*, so only declarations with EXPLICIT annotations
    ; answer. ★The reference's `diagnostic` argument is not taken: its only reader
    ; adds related info, and the one caller in this slice passes nil.
    procedure get_type_of_dotted_name(this, node: ref[AstNode]) returns ref[Type]?
    {
        if (AstNode.flags_of(node) & NodeFlagsInWithStatement) <> 0
            return null
        let mark this.unported_mark()
        let k AstNode.kind_of(node)
        if k = KindIdentifier
        {
            let resolved this.get_resolved_symbol(node)
            if this.unported_mark() <> mark
                return null
            let symbol this.get_export_symbol_of_value_symbol_if_exported(resolved)
            if symbol = null
                return null
            return this.get_explicit_type_of_symbol(symbol as ref[Symbol])
        }
        if k = KindThisKeyword
            return this.get_explicit_this_type(node)
        ; ★★★ THE ONE ARM OF THIS FUNCTION THAT IS NOT A LOOKUP, AND ITS STOP HAD
        ; EXPIRED. The note that stood here called checkSuperExpression *the
        ; expression chapter*; that function has been whole since slice 94 and
        ; nothing re-read the sentence. §3.5eo, thirteenth harvest — and the
        ; refutation was not expiredstops.py's, which reads the note for a callee
        ; this file defines and found this one: it was the FRONTIER, which ranked
        ; `check-super-expression` over 276 units.
        if k = KindSuperKeyword
            return this.check_super_expression(node)
        if k = KindPropertyAccessExpression
        {
            let e AstNode.expression_of(node)
            if e = null
                return null
            let t this.get_type_of_dotted_name(e as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if t = null
                return null
            let name AstNode.name_of(node)
            if name = null
                return null
            let nm name as ref[AstNode]
            let ty t as ref[Type]
            var prop: ref[Symbol]? null
            if AstNode.is_private_identifier(nm)
            {
                ; `if t.symbol != nil { prop = getPropertyOfType(t, GetSymbol
                ; NameForPrivateIdentifier(t.symbol, name.Text())) }` — and a type
                ; with no symbol leaves prop nil, which falls out of the switch.
                ; ★The id is READ and never minted, for lookup_symbol_for_private_
                ; identifier_declaration's reason: the number lands in a symbol
                ; NAME, so a checker that draws one shifts every later class's
                ; private members — and a class whose id is still 0 declares no
                ; private member and cannot own the one being looked up.
                let ts ty.symbol
                if ts <> null
                {
                    let cs ts as ref[Symbol]
                    if cs.id <> 0
                    {
                        let key Binder.private_identifier_name(Page.get(this), cs.id, AstNode.identifier_text_of(nm))
                        set prop: this.get_property_of_type(ty, key)
                        if this.unported_mark() <> mark
                            return null
                    }
                }
            }
            else
            {
                set prop: this.get_property_of_type(ty, AstNode.identifier_text_of(nm))
                if this.unported_mark() <> mark
                    return null
            }
            if prop = null
                return null
            return this.get_explicit_type_of_symbol(prop as ref[Symbol])
        }
        if k = KindParenthesizedExpression
        {
            let e AstNode.expression_of(node)
            if e = null
                return null
            return this.get_type_of_dotted_name(e as ref[AstNode])
        }
        null
    }

    ; getExplicitTypeOfSymbol.
    procedure get_explicit_type_of_symbol(this, symbol_in: ref[Symbol]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let resolved this.resolve_symbol(symbol_in)
        if this.unported_mark() <> mark
            return null
        if resolved = null
            return null
        let symbol resolved as ref[Symbol]
        let flags Symbol.flags_of(symbol)
        if (flags & (SymbolFlagsFunction | SymbolFlagsMethod | SymbolFlagsClass | SymbolFlagsValueModule)) <> 0
            return this.get_type_of_symbol(symbol)
        if (flags & (SymbolFlagsVariable | SymbolFlagsProperty)) = 0
            return null
        ; ★ The MAPPED arm, whole since slice 125 — the note that stood here said
        ; *CheckFlagsMapped is set only by the mapped-type chapter, which this port
        ; does not build*, and this is that chapter.
        if (Symbol.check_flags_of(symbol) & CheckFlagsMapped) <> 0
        {
            let origin_links this.value_symbol_link_of(symbol)
            let origin this.value_symbol_extra_read(origin_links).synthetic_origin
            if origin <> null
            {
                let mark0 this.unported_mark()
                let ot this.get_explicit_type_of_symbol(origin as ref[Symbol])
                if this.unported_mark() <> mark0
                    return null
                if ot <> null
                    return this.get_type_of_symbol(symbol)
            }
        }
        let decl Symbol.value_declaration_of(symbol)
        if decl = null
            return null
        let declaration decl as ref[AstNode]
        if this.is_declaration_with_explicit_type_annotation(declaration)
            return this.get_type_of_symbol(symbol)
        var grand: ref[AstNode]? null
        if AstNode.kind_of(declaration) = KindVariableDeclaration
            set grand: AstNode.parent_node_of(AstNode.parent_node_of(declaration))
        if Checker.kind_or_unknown(grand) <> KindForOfStatement
        {
            if explicit_type_diagnostic >= 0
                this.related_info_at(explicit_type_diagnostic, declaration, DiagX_0_needs_an_explicit_type_annotation, this.message_args1(this.symbol_arg(symbol)))
            return null
        }
        let statement grand as ref[AstNode]
        let e AstNode.expression_of(statement)
        if e = null
            return null
        let expression_type this.get_type_of_dotted_name(e as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if expression_type = null
            return null
        var iteration_use IterationUseForOf
        if AstNode.for_await_modifier_of(statement) <> null
            set iteration_use: IterationUseForAwaitOf
        this.check_iterated_type_or_element_type(iteration_use, expression_type as ref[Type], undefined_type, null)
    }

    ; isDeclarationWithExplicitTypeAnnotation.
    function is_declaration_with_explicit_type_annotation(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        var annotatable false
        if k = KindVariableDeclaration
            set annotatable: true
        if k = KindPropertyDeclaration
            set annotatable: true
        if k = KindPropertySignature
            set annotatable: true
        if k = KindParameter
            set annotatable: true
        if annotatable
        {
            if AstNode.type_of(node) <> null
                return true
        }
        Checker.is_expando_property_function_with_return_type_annotation(node)
    }

    ; isExpandoPropertyFunctionWithReturnTypeAnnotation.
    function is_expando_property_function_with_return_type_annotation(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindBinaryExpression
            return false
        let right AstNode.binary_right_of(node)
        if right = null
            return false
        let r right as ref[AstNode]
        if AstNode.is_function_like(r) = false
            return false
        AstNode.type_of(r) <> null
    }

    ; getExplicitThisType.
    procedure get_explicit_this_type(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let container_opt Binder.get_this_container(node, false, false)
        if container_opt = null
            return null
        let container container_opt as ref[AstNode]
        if AstNode.is_function_like(container)
        {
            let signature this.get_signature_from_declaration(container)
            if this.unported_mark() <> mark
                return null
            if signature <> null
            {
                let tp (signature as ref[Signature]).this_parameter
                if tp <> null
                    return this.get_explicit_type_of_symbol(tp as ref[Symbol])
            }
        }
        let parent AstNode.parent_node_of(container)
        if parent = null
            return null
        let p parent as ref[AstNode]
        if Checker.is_class_like(p) = false
            return null
        let symbol this.get_symbol_of_declaration(p)
        if this.unported_mark() <> mark
            return null
        if symbol = null
            return null
        if this.declaration_is_static(container)
            return this.get_type_of_symbol(symbol as ref[Symbol])
        let declared this.get_declared_type_of_symbol(symbol as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        if declared = null
            return null
        ; `getDeclaredTypeOfSymbol(symbol).AsInterfaceType().thisType`. ★★★ THE
        ; STOP THAT STOOD HERE READ *the `this` type of a class, which this port
        ; mints only where the interface chapter does* — and the class arm of
        ; get_declared_type_of_class_or_interface has said `if is_class set
        ; give_this_type: true` ever since that chapter landed, so the premise was
        ; already false when it was written. A class-like parent is the only way
        ; here, so the slot is filled by construction.
        Checker.this_type_of(declared as ref[Type])
    }

    ; ── the EVOLVING ARRAY, slice 141 ───────────────────────────────────────
    ;
    ; The reference's own comment is the boundary and it is the reason this family
    ; is invisible to every yardstick in this directory until it is COMPLETE: *an
    ; evolving array type tracks the element types that have so far been seen in an
    ; `x.push(value)` or `x[n] = value` operation along the control flow graph.
    ; Evolving array types are ultimately converted into manifest array types
    ; (using getFinalArrayType) and never escape the getFlowTypeOfReference
    ; function.* So the type the dump can see is always the FINAL array type, and a
    ; half-ported family answers a manifest array with the wrong element type
    ; rather than nothing at all.
    ;
    ; ★★★ WHAT THE NOTE THAT STOOD HERE CLAIMED, AND WHY IT EXPIRED. It read
    ; *"finalizeEvolvingArrayType IS ITS OWN GUARD ON THIS CORPUS … new_object_type
    ; refuses ObjectFlagsEvolvingArray, so no type reaching here can carry the
    ; bit"* — a claim about the MINT, correct when it was written and discharged by
    ; this slice at the line that refused the bit. §3.5be's rule the other way
    ; round: a flag with no writer is not a fact about the language, it is a
    ; measurement with an expiry date.
    ;
    ; ★ getUnionOrEvolvingArrayType is the ONE exit every antecedent join takes, so
    ; it is written here beside the family rather than in the branch label that
    ; used to stop on it.

    ; getEvolvingArrayType. c.cachedTypes[CachedTypeKindEvolvingArrayType],
    ; array_literal_type_link_of's idiom at the third kind this port reads.
    ;
    ; ★★ THE MEMO IS LOAD-BEARING AND NOT AN OPTIMISATION, for the reason the
    ; array-literal memo is: `isEvolvingArrayTypeList` and the two subset tests
    ; compare TYPE IDENTITY, so two asks for the evolving array over one element
    ; type must answer the same object or a join of two paths that agree reads as a
    ; join of two paths that differ.
    procedure get_evolving_array_type(this, element_type: ref[Type]) returns ref[Type]?
    {
        let link this.evolving_array_type_link_of(element_type)
        if link.evolving <> null
            return link.evolving
        let t this.new_object_type(ObjectFlagsEvolvingArray, null)
        if t = null
            return null
        let et t as ref[Type]
        Checker.set_evolving_array_element_type(et, element_type)
        set link.evolving: et
        et
    }

    ; getElementTypeOfEvolvingArrayType.
    function get_element_type_of_evolving_array_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.object_flags & ObjectFlagsEvolvingArray) <> 0
            return Checker.evolving_array_element_type_of(t)
        never_type
    }

    ; isEvolvingArrayTypeList — every non-`never` constituent is an evolving array
    ; type and at least one constituent is. ★A list of nothing but `never` answers
    ; FALSE through `hasEvolvingArrayType`, which is what keeps the join of two
    ; unreachable paths out of this family.
    function is_evolving_array_type_list(types: ref[Array[ref[Type]?]]) returns bool
    {
        var has_evolving false
        let len types.get_length() as int
        var i 0
        while i < len
        {
            let row types[i]
            set i: i + 1
            if row = null
                continue
            let t row as ref[Type]
            if (t.flags & TypeFlagsNever) <> 0
                continue
            if (t.object_flags & ObjectFlagsEvolvingArray) = 0
                return false
            set has_evolving: true
        }
        has_evolving
    }

    ; addEvolvingArrayElementType. ★★ NO SUBTYPE REDUCTION HERE — the reference's
    ; own comment says it is deferred until the array is finalized, which is why
    ; createFinalArrayType asks for UnionReductionSubtype and this asks for
    ; nothing.
    procedure add_evolving_array_element_type(this, evolving_array_type: ref[Type], node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let cft this.get_context_free_type_of_expression(node)
        if this.unported_mark() <> mark
            return null
        if cft = null
            return null
        let base this.get_base_type_of_literal_type(cft as ref[Type])
        if this.unported_mark() <> mark
            return null
        if base = null
            return null
        let new_element_type this.get_regular_type_of_object_literal(base as ref[Type])
        if this.unported_mark() <> mark
            return null
        if new_element_type = null
            return null
        let net new_element_type as ref[Type]
        let element_type_opt Checker.evolving_array_element_type_of(evolving_array_type)
        if element_type_opt = null
            return null
        let element_type element_type_opt as ref[Type]
        if this.is_type_subset_of(net, element_type)
            return evolving_array_type
        let pair &Array[ref[Type]?]()
        pair.add(element_type)
        pair.add(net)
        let u this.get_union_type(pair)
        if this.unported_mark() <> mark
            return null
        if u = null
            return null
        this.get_evolving_array_type(u as ref[Type])
    }

    ; finalizeEvolvingArrayType.
    procedure finalize_evolving_array_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.object_flags & ObjectFlagsEvolvingArray) = 0
            return t
        this.get_final_array_type(t)
    }

    ; getFinalArrayType — the lazy memo on the payload. ★§3.14: the write goes
    ; through the setter, because a `when` binding is a copy.
    procedure get_final_array_type(this, t: ref[Type]) returns ref[Type]?
    {
        let cached Checker.evolving_array_final_type_of(t)
        if cached <> null
            return cached
        let element_opt Checker.evolving_array_element_type_of(t)
        if element_opt = null
            return null
        let fresh this.create_final_array_type(element_opt as ref[Type])
        if fresh = null
            return null
        Checker.set_evolving_array_final_type(t, fresh)
        fresh
    }

    ; createFinalArrayType. ★The `never` arm answers the AUTO array type — the
    ; `any[]` an untyped `[]` starts out as — and not `never[]`: an evolving array
    ; that saw no element at all is the empty literal it began as.
    procedure create_final_array_type(this, element_type: ref[Type]) returns ref[Type]?
    {
        if (element_type.flags & TypeFlagsNever) <> 0
            return this.get_auto_array_type()
        if (element_type.flags & TypeFlagsUnion) <> 0
        {
            let ts Checker.union_types_of(element_type)
            if ts = null
                return null
            let reduced this.get_union_type_ex(ts as ref[Array[ref[Type]?]], UnionReductionSubtype, null, null)
            if reduced = null
                return null
            return this.create_array_type(reduced)
        }
        this.create_array_type(element_type)
    }

    ; getUnionOrEvolvingArrayType — *at flow control branch or loop junctions, if
    ; the type along every antecedent code path is an evolving array type, we
    ; construct a combined evolving array type; otherwise we finalize all evolving
    ; array types.*
    ;
    ; ★★★ THE LAST THREE LINES ARE AN IDENTITY RESTORE AND NOT A REDUCTION, and
    ; dropping them is a wrong ANSWER rather than a missing one: a union that has
    ; the same constituents as the DECLARED type answers the declared type itself,
    ; so a later `t = f.declaredType` test — getTypeAtFlowLoopLabel's early break
    ; is one — sees the identity the reference sees.
    procedure get_union_or_evolving_array_type(this, f: ref[FlowState], types: ref[Array[ref[Type]?]], subtype_reduction: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if Checker.is_evolving_array_type_list(types)
        {
            let elements &Array[ref[Type]?]()
            let len types.get_length() as int
            var i 0
            while i < len
            {
                let row types[i]
                set i: i + 1
                if row = null
                    continue
                let e this.get_element_type_of_evolving_array_type(row as ref[Type])
                if e = null
                    return null
                elements.add(e)
            }
            let u this.get_union_type(elements)
            if this.unported_mark() <> mark
                return null
            if u = null
                return null
            return this.get_evolving_array_type(u as ref[Type])
        }
        let finalized &Array[ref[Type]?]()
        let len types.get_length() as int
        var i 0
        while i < len
        {
            let row types[i]
            set i: i + 1
            if row = null
                continue
            let fin this.finalize_evolving_array_type(row as ref[Type])
            if this.unported_mark() <> mark
                return null
            if fin = null
                return null
            finalized.add(fin)
        }
        let u this.get_union_type_ex(finalized, subtype_reduction, null, null)
        if this.unported_mark() <> mark
            return null
        if u = null
            return null
        let result this.recombine_unknown_type(u as ref[Type])
        let declared f.declared_type
        if declared = null
            return result
        let dt declared as ref[Type]
        if result = dt
            return result
        if ((result.flags & dt.flags) & TypeFlagsUnion) = 0
            return result
        if this.union_constituents_equal(result, dt)
            return dt
        result
    }

    ; slices.Equal over the two unions' constituent lists — the last conjunct of
    ; getUnionOrEvolvingArrayType's identity restore. ★It compares the LISTS and
    ; not the ORIGINS, which is the reference's own `AsUnionType().types`.
    function union_constituents_equal(this, a: ref[Type], b: ref[Type]) returns bool
    {
        let at Checker.union_types_of(a)
        let bt Checker.union_types_of(b)
        if at = null
            return false
        if bt = null
            return false
        let al at as ref[Array[ref[Type]?]]
        let bl bt as ref[Array[ref[Type]?]]
        let n al.get_length() as int
        if n <> bl.get_length() as int
            return false
        var i 0
        while i < n
        {
            let x al[i]
            let y bl[i]
            set i: i + 1
            if x = null
                return false
            if y = null
                return false
            if (x as ref[Type]) <> (y as ref[Type])
                return false
        }
        true
    }

    ; ── the ASSIGNED and INITIAL types ──────────────────────────────────────
    ;
    ; ★★ WHAT THE ASSIGNMENT ARM NEEDS IS A TYPE FOR THE VALUE BEING ASSIGNED, and
    ; the reference splits it in two: a DECLARATION has an initial type
    ; (initializer, `for…in`'s string, `for…of`'s element), an assignment TARGET
    ; has an assigned type (the right-hand side, or the destructured slot).

    ; getInitialOrAssignedType.
    procedure get_initial_or_assigned_type(this, f: ref[FlowState], flow: ref[FlowNode]) returns ref[Type]?
    {
        let node_opt flow.node
        if node_opt = null
            return null
        let node node_opt as ref[AstNode]
        let mark this.unported_mark()
        let k AstNode.kind_of(node)
        var t: ref[Type]? null
        var declaration false
        if k = KindVariableDeclaration
            set declaration: true
        if k = KindBindingElement
            set declaration: true
        if declaration
            set t: this.get_initial_type(node)
        else
            set t: this.get_assigned_type(node)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        this.get_narrowable_type_for_reference(t as ref[Type], f.reference as ref[AstNode], CheckModeNormal)
    }

    ; getInitialType.
    procedure get_initial_type(this, node: ref[AstNode]) returns ref[Type]?
    {
        let k AstNode.kind_of(node)
        if k = KindVariableDeclaration
            return this.get_initial_type_of_variable_declaration(node)
        if k = KindBindingElement
            return this.get_initial_type_of_binding_element(node)
        ; The reference PANICS here ("Unhandled case in getInitialType"), so the
        ; honest answer is a report and not a value.
        this.record_unported("initial-type-unhandled-kind", k)
        null
    }

    ; getInitialTypeOfVariableDeclaration.
    procedure get_initial_type_of_variable_declaration(this, node: ref[AstNode]) returns ref[Type]?
    {
        let ini AstNode.initializer_of(node)
        if ini <> null
            return this.get_type_of_initializer(ini as ref[AstNode])
        let grand AstNode.parent_node_of(AstNode.parent_node_of(node))
        let gk Checker.kind_or_unknown(grand)
        if gk = KindForInStatement
            return string_type
        if gk = KindForOfStatement
        {
            let mark this.unported_mark()
            let t this.check_right_hand_side_of_for_of(grand as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if t <> null
                return t
        }
        error_type
    }

    ; getInitialTypeOfBindingElement.
    procedure get_initial_type_of_binding_element(this, node: ref[AstNode]) returns ref[Type]?
    {
        let pattern_opt AstNode.parent_node_of(node)
        if pattern_opt = null
            return null
        let pattern pattern_opt as ref[AstNode]
        let mark this.unported_mark()
        let parent_type this.get_initial_type(AstNode.parent_node_of(pattern) as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if parent_type = null
            return null
        let pt parent_type as ref[Type]
        var t: ref[Type]? null
        if AstNode.kind_of(pattern) = KindObjectBindingPattern
            set t: this.get_type_of_destructured_property(pt, Checker.property_name_or_name_of(node))
        else
        {
            if AstNode.dot_dot_dot_token_of(node) = null
                set t: this.get_type_of_destructured_array_element(pt, Checker.index_in_list(AstNode.elements_of(pattern), node))
            else
                set t: this.get_type_of_destructured_spread_expression(pt)
        }
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        this.get_type_with_default(t as ref[Type], AstNode.initializer_of(node))
    }

    ; slices.Index over a node list.
    ; ★ The parameter is a NODE ARRAY and was declared `ref[AstNode]?` until slice
    ; 135 — every caller hands it an `AstNode.elements_of(...)` result and both
    ; types lower to `ptr`, so the planner had nothing to compare and the wrong
    ; declaration was invisible. It is the shape the root CLAUDE.md calls a mixed
    ; parameter list, one parameter wide.
    function index_in_list(list: ref[Array[ref[AstNode]?]]?, node: ref[AstNode]) returns int
    {
        let n AstNode.list_count(list)
        var i 0
        while i < n
        {
            if AstNode.child_in_list(list, i) = node
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; getAssignedType — the kind of the assignment target's PARENT decides.
    procedure get_assigned_type(this, node: ref[AstNode]) returns ref[Type]?
    {
        let parent_opt AstNode.parent_node_of(node)
        if parent_opt = null
            return error_type
        let parent parent_opt as ref[AstNode]
        let k AstNode.kind_of(parent)
        if k = KindForInStatement
            return string_type
        if k = KindForOfStatement
        {
            let mark this.unported_mark()
            let t this.check_right_hand_side_of_for_of(parent)
            if this.unported_mark() <> mark
                return null
            if t <> null
                return t
        }
        if k = KindBinaryExpression
            return this.get_assigned_type_of_binary_expression(parent)
        if k = KindDeleteExpression
            return undefined_type
        if k = KindArrayLiteralExpression
        {
            let mark this.unported_mark()
            let element_of this.get_assigned_type(parent)
            if this.unported_mark() <> mark
                return null
            if element_of = null
                return null
            return this.get_type_of_destructured_array_element(element_of as ref[Type], Checker.index_in_list(AstNode.elements_of(parent), node))
        }
        if k = KindSpreadElement
        {
            let mark this.unported_mark()
            let outer this.get_assigned_type(AstNode.parent_node_of(parent) as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if outer = null
                return null
            return this.get_type_of_destructured_spread_expression(outer as ref[Type])
        }
        if k = KindPropertyAssignment
            return this.get_assigned_type_of_property_assignment(parent)
        if k = KindShorthandPropertyAssignment
        {
            let mark this.unported_mark()
            let base this.get_assigned_type_of_property_assignment(parent)
            if this.unported_mark() <> mark
                return null
            if base = null
                return null
            return this.get_type_with_default(base as ref[Type], AstNode.shorthand_object_assignment_initializer_of(parent))
        }
        error_type
    }

    ; getAssignedTypeOfBinaryExpression.
    procedure get_assigned_type_of_binary_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let parent AstNode.parent_node_of(node)
        var destructuring_default false
        if Checker.kind_or_unknown(parent) = KindArrayLiteralExpression
        {
            if Checker.is_destructuring_assignment_target(parent as ref[AstNode])
                set destructuring_default: true
        }
        if Checker.kind_or_unknown(parent) = KindPropertyAssignment
        {
            if Checker.is_destructuring_assignment_target(AstNode.parent_node_of(parent) as ref[AstNode])
                set destructuring_default: true
        }
        if destructuring_default
        {
            let base this.get_assigned_type(node)
            if this.unported_mark() <> mark
                return null
            if base = null
                return null
            return this.get_type_with_default(base as ref[Type], AstNode.binary_right_of(node))
        }
        let right AstNode.binary_right_of(node)
        if right = null
            return error_type
        this.get_type_of_expression(right as ref[AstNode])
    }

    ; getAssignedTypeOfPropertyAssignment.
    procedure get_assigned_type_of_property_assignment(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let outer this.get_assigned_type(AstNode.parent_node_of(node) as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if outer = null
            return null
        this.get_type_of_destructured_property(outer as ref[Type], AstNode.name_of(node))
    }

    ; getTypeOfDestructuredProperty.
    procedure get_type_of_destructured_property(this, t: ref[Type], name: ref[AstNode]?) returns ref[Type]?
    {
        if name = null
            return error_type
        let mark this.unported_mark()
        let name_type this.get_literal_type_from_property_name(name as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if name_type = null
            return null
        let nt name_type as ref[Type]
        if Checker.is_type_usable_as_property_name(nt) = false
            return error_type
        var nb char[JSNUM_MAX_TEXT]
        let nd this.get_property_name_from_type(nt, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if this.unported_mark() <> mark
            return null
        let prop_type this.get_type_of_property_of_type(t, nd)
        if this.unported_mark() <> mark
            return null
        if prop_type <> null
            return prop_type
        let info this.get_applicable_index_info_for_name(t, nd)
        if this.unported_mark() <> mark
            return null
        if info = null
            return error_type
        this.include_undefined_in_index_signature((info as ref[IndexInfo]).value_type)
    }

    ; getTupleElementType — the tuple chapter's indexed read, and its NULL is the
    ; reference's own `nil` rather than a stop: the caller reads the mark first and
    ; only then the answer, which is what lets one function mean both.
    ;
    ; ★ `strconv.Itoa(index)` is decimal_name on the checker's page, the spelling
    ; every numeric property name in this file uses.
    procedure get_tuple_element_type(this, t: ref[Type], index: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let nd Checker.decimal_name(host, index)
        let prop_type this.get_type_of_property_of_type(t, nd)
        if this.unported_mark() <> mark
            return null
        if prop_type <> null
            return prop_type
        if this.every_type_is_tuple(t)
        {
            if this.unported_mark() <> mark
                return null
            var undefined_like: ref[Type]? null
            if Checker.no_unchecked_indexed_access()
                set undefined_like: undefined_type
            return this.get_tuple_element_type_out_of_start_count(t, jsnum_from_int(index), undefined_like)
        }
        if this.unported_mark() <> mark
            return null
        null
    }

    ; getTypeOfDestructuredArrayElement.
    procedure get_type_of_destructured_array_element(this, t: ref[Type], index: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if this.every_type_is_tuple_like(t)
        {
            if this.unported_mark() <> mark
                return null
            let elem this.get_tuple_element_type(t, index)
            if this.unported_mark() <> mark
                return null
            if elem <> null
                return elem
        }
        if this.unported_mark() <> mark
            return null
        let element_type this.check_iterated_type_or_element_type(IterationUseDestructuring, t, undefined_type, null)
        if this.unported_mark() <> mark
            return null
        if element_type <> null
            return this.include_undefined_in_index_signature(element_type)
        error_type
    }

    ; everyType(t, c.isTupleLikeType).
    procedure every_type_is_tuple_like(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_tuple_like_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if this.is_tuple_like_type(row as ref[Type]) = false
                return false
        }
        true
    }

    ; getTypeOfDestructuredSpreadExpression.
    procedure get_type_of_destructured_spread_expression(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        var element_type this.check_iterated_type_or_element_type(IterationUseDestructuring, t, undefined_type, null)
        if this.unported_mark() <> mark
            return null
        if element_type = null
            set element_type: error_type
        this.create_array_type(element_type)
    }

    ; includeUndefinedInIndexSignature.
    procedure include_undefined_in_index_signature(this, t: ref[Type]?) returns ref[Type]?
    {
        if t = null
            return null
        if Checker.no_unchecked_indexed_access() = false
            return t
        let both &Array[ref[Type]?]()
        both.add(t)
        both.add(missing_type)
        this.get_union_type(both)
    }

    ; isDestructuringAssignmentTarget.
    ; getTypeWithDefault.
    procedure get_type_with_default(this, t: ref[Type], default_expression: ref[AstNode]?) returns ref[Type]?
    {
        if default_expression = null
            return t
        let mark this.unported_mark()
        let without this.get_non_undefined_type(t)
        if this.unported_mark() <> mark
            return null
        if without = null
            return null
        let dt this.get_type_of_expression(default_expression as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if dt = null
            return null
        let both &Array[ref[Type]?]()
        both.add(without)
        both.add(dt)
        this.get_union_type(both)
    }

    ; ── the assignment REDUCTION ────────────────────────────────────────────
    ;
    ; ★★ *"Remove those constituent types of declaredType to which no constituent
    ; type of assignedType is assignable"* — and the reference's own comment says
    ; the heuristic is crude: where the reduced type does not accept the assigned
    ; type at all, it gives up and answers the declared type unchanged.

    ; getAssignmentReducedType.
    procedure get_assignment_reduced_type(this, declared_type: ref[Type], assigned_type: ref[Type]) returns ref[Type]?
    {
        if declared_type = assigned_type
            return declared_type
        if (assigned_type.flags & TypeFlagsNever) <> 0
            return assigned_type
        let cached this.lookup_assignment_reduced(declared_type, assigned_type)
        if cached <> null
            return cached
        let mark this.unported_mark()
        let computed this.get_assignment_reduced_type_worker(declared_type, assigned_type)
        if this.unported_mark() <> mark
            return null
        if computed = null
            return null
        assignment_reduced_types.add(&AssignmentReducedRow^this(declared_type, assigned_type, computed as ref[Type]))
        computed
    }

    procedure lookup_assignment_reduced(this, declared_type: ref[Type], assigned_type: ref[Type]) returns ref[Type]?
    {
        let n assignment_reduced_types.get_length() as int
        let chain assignment_reduced_types_chain
        while chain.count() < n
        {
            let pending assignment_reduced_types[chain.count() as size_t]
            if pending = null
                chain.add_blank()
            else
            {
                let pr pending as ref[AssignmentReducedRow]
                chain.add(Checker.key3_hash(pr.declared as int, pr.assigned as int, 0))
            }
        }
        var i chain.first(Checker.key3_hash(declared_type as int, assigned_type as int, 0))
        while i >= 0
        {
            let row assignment_reduced_types[i as size_t]
            set i: chain.after(i)
            if row = null
                continue
            let r row as ref[AssignmentReducedRow]
            if r.declared <> declared_type
                continue
            if r.assigned <> assigned_type
                continue
            return r.reduced
        }
        null
    }

    procedure get_assignment_reduced_type_worker(this, declared_type: ref[Type], assigned_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let filtered this.filter_type_maybe_assignable_from(declared_type, assigned_type)
        if this.unported_mark() <> mark
            return null
        if filtered = null
            return null
        var reduced filtered as ref[Type]
        ; "Ensure that we narrow to fresh types if the assignment is a fresh
        ; boolean literal type."
        if (assigned_type.flags & TypeFlagsBooleanLiteral) <> 0
        {
            if Checker.is_fresh_literal_type(assigned_type)
            {
                let fresh this.map_type_to_fresh_literal(reduced)
                if this.unported_mark() <> mark
                    return null
                if fresh = null
                    return null
                set reduced: fresh as ref[Type]
            }
        }
        ; "Our crude heuristic produces an invalid result in some cases … when that
        ; happens, we give up and don't narrow at all."
        if this.is_type_assignable_to(assigned_type, reduced)
            return reduced
        if this.unported_mark() <> mark
            return null
        declared_type
    }

    procedure filter_type_maybe_assignable_from(this, t: ref[Type], assigned_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let count list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < count
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let keep this.type_maybe_assignable_to(assigned_type, row as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if keep
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = count
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        let keep this.type_maybe_assignable_to(assigned_type, t)
        if this.unported_mark() <> mark
            return null
        if keep
            return t
        never_type
    }

    ; typeMaybeAssignableTo — SOME constituent, where isTypeAssignableTo would ask
    ; for every one.
    procedure type_maybe_assignable_to(this, source: ref[Type], target: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        if (source.flags & TypeFlagsUnion) = 0
            return this.is_type_assignable_to(source, target)
        let types Checker.union_types_of(source)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if this.is_type_assignable_to(row as ref[Type], target)
                return true
            if this.unported_mark() <> mark
                return false
        }
        false
    }

    ; mapType(t, c.getFreshTypeOfLiteralType).
    procedure map_type_to_fresh_literal(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & TypeFlagsUnion) = 0
            return this.get_fresh_type_of_literal_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let s row as ref[Type]
            let m this.get_fresh_type_of_literal_type(s)
            if this.unported_mark() <> mark
                return null
            if m <> s
                set changed: true
            mapped.add(m)
        }
        if changed = false
            return t
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }

    ; ── the remaining flow predicates ───────────────────────────────────────

    ; isFalseExpression — isReachableFlowNode's assertion argument test.
    function is_false_expression(this, expr: ref[AstNode]) returns bool
    {
        let skipped Parser.skip_parentheses(expr)
        if skipped = null
            return false
        let node skipped as ref[AstNode]
        if AstNode.kind_of(node) = KindFalseKeyword
            return true
        if AstNode.kind_of(node) <> KindBinaryExpression
            return false
        let op AstNode.binary_operator_kind(node)
        let left AstNode.binary_left_of(node)
        let right AstNode.binary_right_of(node)
        if left = null
            return false
        if right = null
            return false
        if op = KindAmpersandAmpersandToken
        {
            if this.is_false_expression(left as ref[AstNode])
                return true
            return this.is_false_expression(right as ref[AstNode])
        }
        if op <> KindBarBarToken
            return false
        if this.is_false_expression(left as ref[AstNode]) = false
            return false
        this.is_false_expression(right as ref[AstNode])
    }

    ; ── the caller's own half (slice 93) ────────────────────────────────────

    ; getControlFlowContainer — FindAncestor from the PARENT over a four-term
    ; predicate, written as the walk it is (§3.9d).
    ;
    ; ★ The IIFE exclusion is the same one slice 92's h03 measured on the binder's
    ; side: an immediately invoked function expression is part of the containing
    ; control flow, so it is not a container here either. The two sites have to
    ; agree — the binder decides which Start node exists and this decides which
    ; one the walk stops at.
    function get_control_flow_container(node: ref[AstNode]) returns ref[AstNode]?
    {
        var cur AstNode.parent_node_of(node)
        while cur <> null
        {
            let n cur as ref[AstNode]
            let k AstNode.kind_of(n)
            var hit false
            if AstNode.is_function_like(n)
            {
                if AstNode.get_immediately_invoked_function_expression(n) = null
                    set hit: true
            }
            if k = KindModuleBlock
                set hit: true
            if k = KindSourceFile
                set hit: true
            if k = KindPropertyDeclaration
                set hit: true
            if hit
                return n
            set cur: AstNode.parent_node_of(n)
        }
        null
    }

    ; getReferenceRoot — the parenthesis/assignment/comma climb, upward.
    function get_reference_root(node: ref[AstNode]) returns ref[AstNode]
    {
        var n node
        repeat
        {
            let p AstNode.parent_node_of(n)
            if p = null
                return n
            let parent p as ref[AstNode]
            let pk AstNode.kind_of(parent)
            var climb false
            if pk = KindParenthesizedExpression
                set climb: true
            if pk = KindBinaryExpression
            {
                let op AstNode.binary_operator_kind(parent)
                if op = KindEqualsToken
                {
                    if AstNode.binary_left_of(parent) = n
                        set climb: true
                }
                if op = KindCommaToken
                {
                    if AstNode.binary_right_of(parent) = n
                        set climb: true
                }
            }
            if climb = false
                return n
            set n: parent
        }
    }

    ; ast.IsPushOrUnshiftIdentifier.
    function is_push_or_unshift_identifier(n: ref[AstNode]) returns bool
    {
        if Checker.node_text_is(AstNode.identifier_text_of(n), "push")
            return true
        Checker.node_text_is(AstNode.identifier_text_of(n), "unshift")
    }

    ; isEvolvingArrayOperationTarget, whole — slice 141 supplies the last term.
    ;
    ; ★★ THE `length` DISJUNCT IS NOT ABOUT MUTATION and reads like a mistake:
    ; asking an evolving array for its `length` is what forces it to be FINALIZED,
    ; so the reference lists it beside the two mutators.
    ;
    ; ★★★ THE FIRST DRAFT OF SLICE 141 RE-PORTED THIS FUNCTION eighty lines above
    ; its existing body — §3.5fu's trap exactly, a duplicate definition accepted in
    ; silence with the FIRST one winning — and the duplicate scan at the end of the
    ; slice is what found it. **Grep for the callee before writing it.**
    procedure is_evolving_array_operation_target(this, node: ref[AstNode]) returns bool
    {
        let root Checker.get_reference_root(node)
        let p AstNode.parent_node_of(root)
        if p = null
            return false
        let parent p as ref[AstNode]
        let pk AstNode.kind_of(parent)
        if pk = KindPropertyAccessExpression
        {
            let nm AstNode.property_access_name_of(parent)
            if nm <> null
            {
                let name nm as ref[AstNode]
                if Checker.node_text_is(AstNode.identifier_text_of(name), "length")
                    return true
                let gp AstNode.parent_node_of(parent)
                if gp <> null
                {
                    if AstNode.kind_of(gp as ref[AstNode]) = KindCallExpression
                    {
                        if AstNode.kind_of(name) = KindIdentifier
                        {
                            if Checker.is_push_or_unshift_identifier(name)
                                return true
                        }
                    }
                }
            }
            return false
        }
        if pk <> KindElementAccessExpression
            return false
        if AstNode.expression_of(parent) <> root
            return false
        let gp AstNode.parent_node_of(parent)
        if gp = null
            return false
        let grand gp as ref[AstNode]
        if AstNode.kind_of(grand) <> KindBinaryExpression
            return false
        if AstNode.binary_operator_kind(grand) <> KindEqualsToken
            return false
        if AstNode.binary_left_of(grand) <> parent
            return false
        if Binder.is_assignment_target(grand)
            return false
        ; isTypeAssignableToKind(getTypeOfExpression(argumentExpression), NumberLike)
        ; — the last term, slice 141. ★A stop underneath answers FALSE and the
        ; CALLER takes the mark: this function returns a bool and has no third
        ; state, which is the shape is_matching_reference's arm already has.
        let arg AstNode.element_access_argument_of(parent)
        if arg = null
            return false
        let it this.get_type_of_expression(arg as ref[AstNode])
        if it = null
            return false
        this.is_type_assignable_to_kind(it as ref[Type], TypeFlagsNumberLike)
    }

    ; containsUndefinedType. The union arm reads the FIRST constituent and nothing
    ; else, which is exact rather than an approximation: a union's constituents are
    ; sorted by CompareTypes, whose first key is the type FLAGS, and only Any
    ; (1 << 0) and Unknown (1 << 1) sort ahead of Undefined (1 << 2) — a union
    ; containing either of those is not a union at all, because getUnionTypeWorker
    ; answers `any` or `unknown` for it. So an undefined-carrying union carries it
    ; first.
    ;
    ; ★★★ THE ARM IS WRITTEN IN SLICE 94 AND THE LINE IT REPLACES NAMED ITS OWN
    ; EXPIRY DATE: *"No union is minted here, so the arm has no input either way"*.
    ; It has input now, and it is the input that decides the whole property-
    ; initialization row — `p: string` and `p: string | undefined` differ here and
    ; nowhere else.
    function contains_undefined_type(t: ref[Type]) returns bool
    {
        var ty t
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let ts Checker.union_types_of(t)
            if ts <> null
            {
                let list ts as ref[Array[ref[Type]?]]
                if (list.get_length() as int) > 0
                {
                    let f list[0]
                    if f <> null
                        set ty: f as ref[Type]
                }
            }
        }
        (ty.flags & TypeFlagsUndefined) <> 0
    }

    ; isDestructuringAssignmentTarget.
    ; isDestructuringAssignmentTarget.
    ;
    ; ★★★ IT EXISTED TWICE UNTIL SLICE 147 — ONCE AS A `this` METHOD AND ONCE AS A
    ; STATIC WITH THE SAME NAME AND THE SAME PARAMETER LIST — AND THE TWO MANGLED
    ; TO ONE SYMBOL. `nm` on the package object showed a single
    ; `_ZN7Checker34is_destructuring_assignment_targetER7AstNode`, because Scaly's
    ; Itanium mangling encodes neither the RECEIVER nor the implicit caller page:
    ; `f(this, x: T)` and `f(x: T)` are the same name. The emitter keeps ONE body,
    ; so one of the two call forms passes its first argument into the wrong slot —
    ; the static's `Checker.is_destructuring_assignment_target(parent)` handed
    ; `parent` where the surviving body wanted the receiver, and
    ; `AstNode.parent_node_of` answered `0x0a0000000a`, a SIGBUS three frames
    ; further on.
    ;
    ; ★★★ IT WAS LATENT FOR AS LONG AS THE STATIC'S ONE CALLER WAS UNREACHABLE:
    ; that caller is `check_identifier`'s spread-destructuring arm, which is
    ; entered only from inside a SpreadAssignment — and `check_object_literal`'s
    ; spread arm was a stop until this slice. **A stop hides a WRONG BINARY as
    ; readily as a wrong answer.** The sweep is three lines of Python over the
    ; package (same name, same parameter types, one with `this` and one without)
    ; and it reads ONE — this pair.
    ;
    ; ★ The STATIC is the form that stays: the function reads only the node.
    function is_destructuring_assignment_target(parent: ref[AstNode]) returns bool
    {
        let g AstNode.parent_node_of(parent)
        if g = null
            return false
        let grand g as ref[AstNode]
        let gk AstNode.kind_of(grand)
        if gk = KindBinaryExpression
        {
            if AstNode.binary_left_of(grand) = parent
                return true
        }
        if gk = KindForOfStatement
        {
            if AstNode.initializer_of(grand) = parent
                return true
        }
        false
    }

    ; ast.IsInTypeQuery — FindAncestorOrQuit, and the QUIT is the mechanism: the
    ; walk climbs only through the entity-name spine and stops at anything else,
    ; so `typeof (x)` and `typeof f()` answer differently from `typeof a.b`.
    function is_in_type_query(node: ref[AstNode]) returns bool
    {
        var p: ref[AstNode]? node
        while p <> null
        {
            let n p as ref[AstNode]
            let k AstNode.kind_of(n)
            if k = KindTypeQuery
                return true
            if k <> KindIdentifier
            {
                if k <> KindQualifiedName
                    return false
            }
            set p: AstNode.parent_node_of(n)
        }
        false
    }

    ; isMutableLocalVariableDeclaration — "a non-exported and non-global `let`".
    procedure is_mutable_local_variable_declaration(this, declaration: ref[AstNode]) returns bool
    {
        let lp AstNode.parent_node_of(declaration)
        if lp = null
            return false
        let list lp as ref[AstNode]
        if (AstNode.flags_of(list) & NodeFlagsLet) = 0
            return false
        if (b.combined_modifier_flags(declaration) & ModifierFlagsExport) <> 0
            return false
        let sp AstNode.parent_node_of(list)
        if sp = null
            return true
        let stmt sp as ref[AstNode]
        if AstNode.kind_of(stmt) <> KindVariableStatement
            return true
        this.is_global_source_file_node(AstNode.parent_node_of(stmt)) = false
    }

    ; isConstantVariable.
    function is_constant_variable(this, symbol: ref[Symbol]) returns bool
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsVariable) = 0
            return false
        (Checker.get_declaration_node_flags_from_symbol(symbol) & NodeFlagsConstant) <> 0
    }

    ; isParameterOrMutableLocalVariable — "a parameter, a catch clause variable,
    ; or a mutable local variable".
    procedure is_parameter_or_mutable_local_variable(this, symbol: ref[Symbol]) returns bool
    {
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
            return false
        let rd Binder.get_root_declaration(vd as ref[AstNode])
        if rd = null
            return false
        let declaration rd as ref[AstNode]
        let k AstNode.kind_of(declaration)
        if k = KindParameter
            return true
        if k <> KindVariableDeclaration
            return false
        let p AstNode.parent_node_of(declaration)
        if p <> null
        {
            if AstNode.kind_of(p as ref[AstNode]) = KindCatchClause
                return true
        }
        this.is_mutable_local_variable_declaration(declaration)
    }

    ; isSameScopedBindingElement.
    function is_same_scoped_binding_element(this, node: ref[AstNode], declaration: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(declaration) <> KindBindingElement
            return false
        let be Checker.find_ancestor_kind(node, KindBindingElement)
        if be = null
            return false
        let a Binder.get_root_declaration(be as ref[AstNode])
        let d Binder.get_root_declaration(declaration)
        if a = null
            return false
        if d = null
            return false
        (a as ref[AstNode]) = (d as ref[AstNode])
    }

    ; someType(t, isGenericTypeWithUnionConstraint) — the OUTER of the two
    ; composite walks the reference writes here, and it is a function of its own
    ; from slice 116 because the two are no longer one question.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE EXPIRED (§3.5p). It said *neither a union nor
    ; an intersection type is minted anywhere in this port, so neither list can be
    ; reached* — true when it was written and false in two steps: slice 94 gave
    ; the port unions, and slice 116 gave it one that reaches THIS function, since
    ; an enum's declared type is the union of its members'. The INTERSECTION half
    ; is unchanged and still stops, because nothing mints one.
    ;
    ; ★★★ AND THAT LAST CLAUSE HAD EXPIRED TOO, in a way no instrument looks for:
    ; `get_intersection_type_ex` mints an intersection and has since slice 121, so
    ; *nothing mints one* was a statement about a producer that had arrived four
    ; chapters earlier. Slice 155 wrote the arm — two loops, no new callee. **A
    ; premise naming a PRODUCER ages exactly like a premise naming a callee, and
    ; `expiredstops.py` can only see the second kind.**
    ; someType with the type-PARAMETER predicate, slice 139 — the relation's
    ; comparability carve-out is its one caller. ★The someType family is spelled
    ; one function per predicate in this port (§3.18) and this is the cheapest
    ; member of it: a union asks its constituents, anything else asks itself.
    function some_type_is_type_parameter(t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return (t.flags & TypeFlagsTypeParameter) <> 0
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                if ((e as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
                    return true
            }
            set i: i + 1
        }
        false
    }

    procedure some_type_is_generic_with_union_constraint(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e <> null
                {
                    if this.is_generic_type_with_union_constraint(e as ref[Type])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        this.is_generic_type_with_union_constraint(t)
    }

    ; isGenericTypeWithUnionConstraint — the INNER walk, whose own composite arm
    ; is the intersection.
    ;
    ; ★★★ SLICE 155 — THE INTERSECTION ARM, AND IT IS THE REFERENCE'S OWN `core.Some`
    ; OVER `t.AsIntersectionType().types`. The stop that stood here was tagged
    ; `some-type` after the combinator rather than after anything missing, and the
    ; walk it stood in front of is the walk this same function already does one
    ; level up: `some_type_is_generic_with_union_constraint` folds the UNION, this
    ; folds the INTERSECTION, and the two are the reference's two `core.Some` call
    ; sites. Nothing was needed for it.
    ;
    ; ★ It answered TRUE while it stopped, which is the conservative half of a stop
    ; on a predicate — and conservative in the direction that costs the caller a
    ; distribution it did not need, never a wrong narrowing.
    procedure is_generic_type_with_union_constraint(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.intersection_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e <> null
                {
                    if this.is_generic_type_with_union_constraint(e as ref[Type])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        if (t.flags & TypeFlagsInstantiable) = 0
            return false
        let mark this.unported_mark()
        var base this.get_base_constraint_of_type(t)
        if this.unported_mark() <> mark
            return true
        if base = null
            set base: t
        ((base as ref[Type]).flags & (TypeFlagsNullable | TypeFlagsUnion)) <> 0
    }

    ; getNarrowableTypeForReference, WHOLE since slice 159, with isConstraintPosition
    ; and hasContextualTypeWithNoGenericTypes below it.
    ;
    ; ★★★ THE ROW WAS THE CONTEXTUAL-TYPE CHAPTER AND SLICE 158 IS THAT CHAPTER —
    ; §3.5eo, and it is the sharpest form of the polarity §3.5gm names: the note
    ; read *"what is not [answerable] is the DISJUNCTION that guards it, whose
    ; second half is the contextual type chapter"*, which was an exact and honest
    ; statement of a dependency, made one slice before the dependency arrived.
    ; A note that names what it waits for cannot say when the wait is over.
    ;
    ; ★★ THE isNoInferType PEEL IS WRITTEN NOW FOR THE SAME REASON: its own half
    ; of the note said *"nothing in this port mints one"*, and
    ; `get_substitution_type` at the bottom of this file does — it is the producer
    ; `is_no_infer_type` was written against. The peel is `baseType` and not
    ; `getSubstitutionIntersection`: `NoInfer<T>` must narrow as T, not as the
    ; intersection with its `unknown` constraint.
    ;
    ; ★★★ THE DISJUNCTION IS SHORT-CIRCUITING AND THAT IS WHAT KEEPS IT CHEAP.
    ; `isConstraintPosition` is four kind tests on the PARENT and answers most
    ; references without a type question at all; only its element-access arm and
    ; the contextual half ask the checker anything. So the expensive term is asked
    ; exactly where the reference asks it, and a `some_type_is_generic_with_union_
    ; constraint` of false — the answer for every non-generic reference there is —
    ; never reaches either.
    procedure get_narrowable_type_for_reference(this, t_in: ref[Type], reference: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        var t t_in
        if Checker.is_no_infer_type(t_in)
        {
            let base Checker.substitution_base_type_of(t_in)
            if base <> null
                set t: base as ref[Type]
        }
        if (check_mode & CheckModeInferential) <> 0
            return t
        let some this.some_type_is_generic_with_union_constraint(t)
        if this.unported_mark() <> mark
            return null
        if some = false
            return t
        var substitute this.is_constraint_position(t, reference)
        if this.unported_mark() <> mark
            return null
        if substitute = false
        {
            set substitute: this.has_contextual_type_with_no_generic_types(reference, check_mode)
            if this.unported_mark() <> mark
                return null
        }
        if substitute = false
            return t
        this.map_type(t, MapTypeKindBaseConstraintOrType, null)
    }

    ; isConstraintPosition.
    ;
    ; ★★★ THE ELEMENT-ACCESS ARM IS THE ONLY ONE THAT ASKS A TYPE, AND ITS
    ; NEGATION IS THE POINT — the reference's own comment: *when both obj and x are
    ; of generic types T and K, we want the resulting type to be T[K]*. So an
    ; element access is a constraint position UNLESS substituting would destroy the
    ; indexed access, which is why the term is a conjunction of two positives under
    ; one `not`.
    procedure is_constraint_position(this, t: ref[Type], node: ref[AstNode]) returns bool
    {
        let parent_opt AstNode.parent_node_of(node)
        if parent_opt = null
            return false
        let parent parent_opt as ref[AstNode]
        let k AstNode.kind_of(parent)
        if k = KindPropertyAccessExpression
            return true
        if k = KindQualifiedName
            return true
        var call_like false
        if k = KindCallExpression
            set call_like: true
        if k = KindNewExpression
            set call_like: true
        if call_like
        {
            if AstNode.expression_of(parent) = node
                return true
            return false
        }
        if k <> KindElementAccessExpression
            return false
        if AstNode.expression_of(parent) <> node
            return false
        let mark this.unported_mark()
        let some this.some_type_is_generic_without_nullable_constraint(t)
        if this.unported_mark() <> mark
            return false
        if some = false
            return true
        let arg AstNode.element_access_argument_of(parent)
        if arg = null
            return true
        let at this.get_type_of_expression(arg as ref[AstNode])
        if this.unported_mark() <> mark
            return false
        if at = null
            return true
        if this.is_generic_index_type(at as ref[Type])
            return false
        true
    }

    ; someType(t, isGenericTypeWithoutNullableConstraint) and its predicate — the
    ; NEGATIVE twin of the union-constraint pair above, and written the same way
    ; for the same reason: `someType` distributes over a union and the predicate
    ; itself recurses into an INTERSECTION, so the two levels are not one loop.
    procedure some_type_is_generic_without_nullable_constraint(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e <> null
                {
                    if this.is_generic_type_without_nullable_constraint(e as ref[Type])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        this.is_generic_type_without_nullable_constraint(t)
    }

    procedure is_generic_type_without_nullable_constraint(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.intersection_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e <> null
                {
                    if this.is_generic_type_without_nullable_constraint(e as ref[Type])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        if (t.flags & TypeFlagsInstantiable) = 0
            return false
        let mark this.unported_mark()
        var base this.get_base_constraint_of_type(t)
        if this.unported_mark() <> mark
            return false
        if base = null
            set base: t
        Checker.maybe_type_of_kind(base as ref[Type], TypeFlagsNullable) = false
    }

    ; hasContextualTypeWithNoGenericTypes.
    ;
    ; ★★ THE JSX EXCLUSION IS A CIRCULARITY BREAK, in the reference's own words:
    ; *computing the contextual type for a child of a JSX element involves
    ; resolving the type of the element's tag name, so we exclude that here to
    ; avoid circularities.* It is the TAG NAME position specifically, not any node
    ; under a JSX element.
    ;
    ; ★ A nil contextual type answers FALSE and not true: the question is *is
    ; there a context and is it non-generic*, so no context is no permission to
    ; substitute.
    procedure has_contextual_type_with_no_generic_types(this, node: ref[AstNode], check_mode: int) returns bool
    {
        let k AstNode.kind_of(node)
        var eligible false
        if k = KindIdentifier
            set eligible: true
        if k = KindPropertyAccessExpression
            set eligible: true
        if k = KindElementAccessExpression
            set eligible: true
        if eligible = false
            return false
        let parent_opt AstNode.parent_node_of(node)
        if parent_opt <> null
        {
            let parent parent_opt as ref[AstNode]
            let pk AstNode.kind_of(parent)
            var jsx_like false
            if pk = KindJsxOpeningElement
                set jsx_like: true
            if pk = KindJsxSelfClosingElement
                set jsx_like: true
            if jsx_like
            {
                if AstNode.jsx_tag_name_of(parent) = node
                    return false
            }
        }
        var flags ContextFlagsNone
        if (check_mode & CheckModeRestBindingElement) <> 0
            set flags: ContextFlagsSkipBindingPatterns
        let mark this.unported_mark()
        let contextual this.get_contextual_type(node, flags)
        if this.unported_mark() <> mark
            return false
        if contextual = null
            return false
        this.is_generic_type(contextual as ref[Type]) = false
    }

    ; removeOptionalityFromDeclaredType — the FOUR terms in the reference's own
    ; order, which is what keeps the fourth from being asked.
    procedure remove_optionality_from_declared_type(this, declared_type: ref[Type], declaration: ref[AstNode]) returns ref[Type]?
    {
        if Checker.strict_null_checks() = false
            return declared_type
        if AstNode.kind_of(declaration) <> KindParameter
            return declared_type
        if AstNode.initializer_of(declaration) = null
            return declared_type
        let mark this.unported_mark()
        let is_undef this.has_type_facts(declared_type, TypeFactsIsUndefined)
        if this.unported_mark() <> mark
            return null
        if is_undef = false
            return declared_type
        ; ★★★ THE FOURTH TERM'S NOTE NAMED TWO CALLEES AS *the union room* and both
        ; had left it: check_declaration_initializer and get_type_with_facts are
        ; code. What the term genuinely needed was a NODE on the resolution stack —
        ; see TypeResolution's own note — because the question is asked of a
        ; DECLARATION and `function f(x = x) {}` must report a circularity rather
        ; than recurse.
        let contains this.parameter_initializer_contains_undefined(declaration)
        if this.unported_mark() <> mark
            return null
        if contains
            return declared_type
        this.get_type_with_facts(declared_type, TypeFactsNEUndefined)
    }

    ; parameterInitializerContainsUndefined. ★★★THE SECOND `computed` TEST IS THE
    ; REFERENCE'S OWN AND IS NOT REDUNDANT: checkDeclarationInitializer under it can
    ; re-enter this function for the same declaration and answer first, and the
    ; reference declines to overwrite what that inner call recorded.
    procedure parameter_initializer_contains_undefined(this, declaration: ref[AstNode]) returns bool
    {
        let mark this.unported_mark()
        let links this.node_link_of(declaration)
        if links.initializer_is_undefined_computed = false
        {
            if this.push_type_resolution(null, null, null, declaration, TypeSystemPropertyNameInitializerIsUndefined) = false
            {
                let sym AstNode.symbol_of(declaration)
                if sym <> null
                    this.report_circularity_error(sym as ref[Symbol])
                return true
            }
            let init_type this.check_declaration_initializer(declaration, CheckModeNormal, null)
            var contains_undefined false
            if init_type <> null
                set contains_undefined: this.has_type_facts(init_type as ref[Type], TypeFactsIsUndefined)
            if this.pop_type_resolution() = false
            {
                let sym AstNode.symbol_of(declaration)
                if sym <> null
                    this.report_circularity_error(sym as ref[Symbol])
                return true
            }
            if this.unported_mark() <> mark
                return false
            ; ★`links` is still the row: node_link_of's table holds REFERENCES to
            ; page-hosted rows, so a growth behind this call moves the array's
            ; buffer and not the row — which is why the reference's single `links`
            ; is transcribed rather than re-read.
            if links.initializer_is_undefined_computed = false
            {
                set links.initializer_is_undefined_computed: true
                set links.initializer_is_undefined: contains_undefined
            }
            return links.initializer_is_undefined
        }
        links.initializer_is_undefined
    }

    ; checkIdentifier — the work list's largest row, taken to its three walls.
    ;
    ; ★★★ THE STOP THAT STOOD AT THE DISPATCH WAS ONE ARGUMENT AND THE ARGUMENT WAS
    ; ABOUT ONE LINE. Slice 79 wired resolveName's one safe caller and wrote that
    ; this one *"passes a nameNotFoundMessage, so a MISS reports TS2304 — one
    ; invented diagnostic per lib name, corpus-wide"*. That is true of REPORTING the
    ; miss and not of meeting it: resolve_name's tail STOPS there instead, which
    ; loses a real TS2304 where the corpus has one and can never invent. The
    ; argument was for the report, and the report is the only thing that had to go.
    ;
    ; ★★★ WHAT IS BEHIND IT IS THREE WALLS AND NOT ONE, WHICH IS THIS SLICE'S FIRST
    ; MEASUREMENT. Over stage 1's 651 arrivals: 400 MISS (61 %) — the globals table,
    ; §3.11 — 30 are a missing node, 75 stop inside the walk, and 146 RESOLVE. Of
    ; those 146, 121 are Variables, and a Variable in a non-assignment position
    ; falls through to getFlowTypeOfReferenceEx, i.e. `flow-graph`. So the arms that
    ; ANSWER are the ones the reference answers ABOVE the flow: a function, a class,
    ; an enum, a namespace, and a variable in a DEFINITE assignment position.
    ;
    ; ★★ AND THE REPORTS ARE THE PRODUCT RATHER THAN THE TYPE. Nine codes hang off
    ; the assignment-target block below and none of them needs a flow graph or a lib:
    ; they are decided by the resolved symbol's FLAGS.
    procedure check_identifier(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let ident_mark this.unported_mark()
        if Checker.is_this_in_type_query(node)
            return this.check_this_expression(node)
        let symbol this.get_resolved_symbol(node)
        if symbol = unknown_symbol
            return error_type
        if symbol = arguments_symbol
        {
            if Checker.is_in_property_initializer_or_class_static_block(node, true)
            {
                this.error_on_node(node, DiagX_arguments_cannot_be_referenced_in_property_initializers_or_class_static_initialization_blocks)
                return error_type
            }
            return this.get_type_of_symbol(symbol)
        }
        ; ★★★ markLinkedReferences IS CALLED, since slice 202. The note that stood
        ; here said its whole effect was a flag the emit resolver alone reads — true
        ; of the flag, false of the walk behind it: markAliasSymbolAsReferenced
        ; resolves an internal `import x = a.b`'s FIRST identifier with the
        ; cannot-find-name message, which is a report (see mark_linked_references).
        if Checker.should_mark_identifier_alias_referenced(node)
            this.mark_linked_references(node, ReferenceHintIdentifier, null, null)
        let local_or_export this.get_export_symbol_of_value_symbol_if_exported(symbol)
        if local_or_export = null
            return error_type
        let les local_or_export as ref[Symbol]
        ; ★★★ THE DEPRECATION BLOCK WAS SKIPPED BECAUSE ITS PRODUCT IS A SUGGESTION,
        ; AND THAT ARGUMENT WAS RIGHT ABOUT THE PRODUCT AND WRONG ABOUT THE CALL —
        ; slice 117 found it at STAGE 2, on one unit in 18 391. The note that stood
        ; here reasoned correctly that `addDeprecatedSuggestion` can never put a line
        ; into a C section, and then dropped the whole block including
        ; `resolveAliasWithDeprecationCheck`, whose first step is **resolveAlias** —
        ; and resolving an alias to a module that does not exist REPORTS TS2307.
        ; `import { X } from "./m"; const X = 42; X;` is the shape: the merged symbol
        ; carries the Alias flag, the reference reports the missing module a second
        ; time at the identifier, and this port reported it once.
        ;
        ; ★★★ THE TRANSFERABLE HALF: **a call is not a suggestion just because its
        ; RESULT is.** A skip justified by what a routine PRODUCES has to be checked
        ; against what it does on the way — and nothing local says so, because the
        ; suggestion is the only thing visible at the call site.
        ;
        ; ★ What stays skipped is the suggestion itself, for the reason the old note
        ; gives; isUncalledFunctionReference is not asked, because the count it would
        ; move is not compared either.
        let target_symbol this.resolve_alias_with_deprecation_check(les, node)
        if this.unported_mark() <> ident_mark
            return null
        if target_symbol <> null
        {
            let tsym target_symbol as ref[Symbol]
            if Symbol.declaration_count(tsym) <> 0
            {
                if this.is_deprecated_symbol(tsym)
                    set suggestion_count: suggestion_count + 1
            }
        }
        ; ★ `declaration` is a VAR since slice 114: the alias arm below rebinds it
        ; to getDeclarationOfAliasSymbol's answer. `immediate_declaration` keeps the
        ; value declaration, which is what isNeverInitialized reads.
        var declaration Symbol.value_declaration_of(les)
        let immediate_declaration declaration
        ; ★★★ THE CONTEXTUAL-BINDING-PATTERN EARLY-OUT LANDED IN SLICE 134, WITH ITS
        ; ONE WRITER. It stood here as a containment proof — *"the list is always
        ; empty, so nonInferrableAnyType is unreachable from here; the day that row
        ; lands, this branch comes with it"* — and get_type_from_binding_pattern is
        ; that row. See reference_is_inside_computing_binding_pattern for what the
        ; two conjuncts ask and why the stack alone is not enough.
        if this.reference_is_inside_computing_binding_pattern(node, immediate_declaration)
            return non_inferrable_any_type
        let t this.get_narrowed_type_of_symbol(les, node)
        let assignment_kind Checker.get_assignment_target_kind(node)
        if assignment_kind <> AssignmentKindNone
        {
            let lf Symbol.flags_of(les)
            var not_a_variable false
            if (lf & SymbolFlagsVariable) = 0
                set not_a_variable: true
            if not_a_variable
            {
                ; The JS exception: in a JavaScript file a value MODULE may be
                ; assigned to (`module.exports = …` shapes), so it is not an error
                ; there.
                if Parser.is_in_js_file(node)
                {
                    if (lf & SymbolFlagsValueModule) <> 0
                        set not_a_variable: false
                }
            }
            if not_a_variable
            {
                ; ★ The six codes are a Go `switch` with no subject, i.e. an ORDERED
                ; chain, and the order is the answer: a symbol that is both an enum
                ; and a namespace answers *enum*. Written as the chain it is (§3.5u).
                var code: int DiagCannot_assign_to_0_because_it_is_not_a_variable
                if (lf & SymbolFlagsAlias) <> 0
                    set code: DiagCannot_assign_to_0_because_it_is_an_import
                if (lf & SymbolFlagsFunction) <> 0
                    set code: DiagCannot_assign_to_0_because_it_is_a_function
                if (lf & SymbolFlagsModule) <> 0
                    set code: DiagCannot_assign_to_0_because_it_is_a_namespace
                if (lf & SymbolFlagsClass) <> 0
                    set code: DiagCannot_assign_to_0_because_it_is_a_class
                if (lf & SymbolFlagsEnum) <> 0
                    set code: DiagCannot_assign_to_0_because_it_is_an_enum
                this.error_on_node(node, code, this.symbol_arg(symbol))
                return error_type
            }
            if this.is_readonly_symbol(les)
            {
                var code: int DiagCannot_assign_to_0_because_it_is_a_read_only_property
                if (lf & SymbolFlagsVariable) <> 0
                    set code: DiagCannot_assign_to_0_because_it_is_a_constant
                this.error_on_node(node, code, this.symbol_arg(symbol))
                return error_type
            }
        }
        var is_alias false
        if (Symbol.flags_of(les) & SymbolFlagsAlias) <> 0
            set is_alias: true
        ; "We only narrow variables and parameters occurring in a non-assignment
        ; position. For all other entities we simply return the declared type."
        if (Symbol.flags_of(les) & SymbolFlagsVariable) <> 0
        {
            if assignment_kind = AssignmentKindDefinite
            {
                if Checker.is_in_compound_like_assignment(node)
                {
                    if t = null
                        return null
                    return this.get_base_type_of_literal_type(t as ref[Type])
                }
                return t
            }
        }
        if (Symbol.flags_of(les) & SymbolFlagsVariable) = 0
        {
            if is_alias = false
                return t
        }
        ; ★★★ EVERYTHING BELOW THIS LINE IS THE CONTROL FLOW GRAPH, which is the
        ; second of the three walls and the one that owns the 121 Variable hits.
        ; The reference's next statements are getNarrowableTypeForReference and then
        ; getFlowTypeOfReferenceEx over a flow node this port's binder does not
        ; build; the `assumeInitialized` disjunction above it is eleven terms of
        ; which every one is answerable and none is worth asking, because the value
        ; it computes has exactly one reader and that reader is the flow call.
        ;
        ; ★★★ THE ALIAS ARM IS WRITTEN IN SLICE 114 AND IT REBINDS `declaration`,
        ; which is what the stop that stood here could not do. Its ARGUMENT is
        ; `symbol` and not `les` — the reference asks the symbol the NAME resolved
        ; to, not the exported one getExportSymbolOfValueSymbolIfExported handed
        ; back — and where it answers nil the next line returns `t` without touching
        ; the flow at all.
        if is_alias
        {
            if (Symbol.flags_of(les) & SymbolFlagsVariable) = 0
                set declaration: this.get_declaration_of_alias_symbol(symbol)
        }
        if declaration = null
            return t
        let decl declaration as ref[AstNode]
        if t = null
            return null
        var ty t as ref[Type]
        ; ── the flow tail (slice 93) ────────────────────────────────────────
        ;
        ; ★★★ SLICE 91 WROTE THAT THE `assumeInitialized` DISJUNCTION IS "ELEVEN
        ; TERMS OF WHICH EVERY ONE IS ANSWERABLE AND NONE IS WORTH ASKING,
        ; BECAUSE THE VALUE IT COMPUTES HAS EXACTLY ONE READER AND THAT READER IS
        ; THE FLOW CALL." That was true while the flow call was a stop and it is
        ; false now — and the way it is false is the point. The value picks the
        ; INITIAL TYPE, and the two things it picks between are `t`, which is
        ; free, and `getOptionalType(t, false)`, which is the union wall. So the
        ; disjunction is not an input to the flow call: it decides whether the
        ; call can happen at all, and every term of it is written.
        ;
        ; ★★★ TWO TERMS ARE COMPUTED LAZILY, AND THAT IS FAITHFULNESS RATHER THAN
        ; CLEVERNESS. `isNeverInitialized` is read in exactly one place —
        ; `isOuterVariable && !isNeverInitialized` — and the container-extending
        ; loop runs only where the two containers differ; both therefore stand
        ; behind the SAME test, and both need markNodeAssignments, a walk of its
        ; own. Computing them eagerly would put that stop on every identifier in
        ; the corpus to decide a term that cannot change the answer.
        let outer_mark this.unported_mark()
        let narrowed this.get_narrowable_type_for_reference(ty, node, check_mode)
        if narrowed = null
            return null
        set ty: narrowed as ref[Type]
        var is_parameter false
        let root_decl Binder.get_root_declaration(decl)
        if root_decl <> null
        {
            if AstNode.kind_of(root_decl as ref[AstNode]) = KindParameter
                set is_parameter: true
        }
        let declaration_container Checker.get_control_flow_container(decl)
        var flow_container Checker.get_control_flow_container(node)
        var is_outer_variable true
        if flow_container = null
        {
            if declaration_container = null
                set is_outer_variable: false
        }
        if flow_container <> null
        {
            if declaration_container <> null
            {
                if (flow_container as ref[AstNode]) = (declaration_container as ref[AstNode])
                    set is_outer_variable: false
            }
        }
        var is_spread_destructuring_assignment_target false
        let np AstNode.parent_node_of(node)
        if np <> null
        {
            let parent np as ref[AstNode]
            if AstNode.parent_node_of(parent) <> null
            {
                if AstNode.kind_of(parent) = KindSpreadAssignment
                {
                    if Checker.is_destructuring_assignment_target(parent)
                        set is_spread_destructuring_assignment_target: true
                }
            }
        }
        var is_module_exports false
        if (Symbol.flags_of(symbol) & SymbolFlagsModuleExports) <> 0
            set is_module_exports: true
        ; ★★★ `t == c.autoType || t == c.autoArrayType`, AND THE SECOND HALF WAS
        ; MISSING. `var arr = []` gets autoArrayType, not autoType, so the whole
        ; evolving-array branch below — the TS7034/TS7005 PAIR and
        ; convertAutoToAny — was unreachable for exactly the declaration that
        ; produces it, and the identifier answered the manifest `any[]` with
        ; nothing said. Found at stage 2 through
        ; `mixedPropertyElementAccessAssignmentDeclaration`, which reached this
        ; line only once slice 131 gave the port checkIndexedAccess.
        var type_is_automatic false
        if ty = auto_type
            set type_is_automatic: true
        let aat_for_automatic this.get_auto_array_type()
        if aat_for_automatic <> null
        {
            if ty = (aat_for_automatic as ref[Type])
                set type_is_automatic: true
        }
        var is_automatic_type_in_non_null false
        if type_is_automatic
        {
            if Checker.kind_or_unknown(np) = KindNonNullExpression
                set is_automatic_type_in_non_null: true
        }
        ; "When the control flow originates in a function expression, arrow
        ; function, method, or accessor, and we are referencing a closed-over
        ; const variable or parameter or mutable local variable past its last
        ; assignment, we extend the origin of the control flow analysis to include
        ; the immediately enclosing control flow container."
        ;
        ; ★ The third conjunct is an OR whose FIRST half is decidable here
        ; (isConstantVariable is a flag test on the symbol's declaration) and
        ; whose second ends in isPastLastAssignment. So a closed-over `const`
        ; extends the container with no stop at all, and only a closed-over
        ; parameter or `let` reaches the eighth door.
        var extending true
        while extending
        {
            set extending: false
            if flow_container = null
                break
            let fc flow_container as ref[AstNode]
            var same false
            if declaration_container <> null
            {
                if (declaration_container as ref[AstNode]) = fc
                    set same: true
            }
            if same
                break
            var container_is_closure false
            if Checker.is_function_expression_or_arrow_function(fc)
                set container_is_closure: true
            if Binder.is_object_literal_or_class_expression_method_or_accessor(fc)
                set container_is_closure: true
            if container_is_closure = false
                break
            ; ★★★ THE STOP HERE WAS AN EXPIRED NOTE (§3.5eo), AND ITS PREMISE WAS
            ; NOT ABOUT AN ABSENT CALLEE BUT ABOUT AN ABSENT SLICE: it called
            ; `isPastLastAssignment -> ensureAssignmentsMarked ->
            ; markNodeAssignments` *a slice of its own*, and that whole family —
            ; the walk, the per-symbol link, extendAssignmentPosition, the
            ; export-specifier arm — has been in this file since slice 100, four
            ; thousand lines above. `expiredstops.py` cannot see this one: the
            ; claim names no callee this port lacks, it names WORK.
            var referencing false
            if this.is_constant_variable(les)
            {
                ; ★The `t != autoArrayType` conjunct was missing here until slice
                ; 142, invisible because the stop below took every unit that could
                ; have shown it. `auto_array_type` is a LAZY memo, so it is asked
                ; through its getter and a null answer means the lib has no
                ; `any[]` to compare against, i.e. the term cannot hold.
                let aat this.get_auto_array_type()
                var is_auto_array false
                if aat <> null
                {
                    if t = (aat as ref[Type])
                        set is_auto_array: true
                }
                if is_auto_array = false
                    set referencing: true
            }
            if referencing = false
            {
                if this.is_parameter_or_mutable_local_variable(les)
                {
                    if this.is_past_last_assignment(les, node)
                        set referencing: true
                }
            }
            if referencing = false
                break
            set flow_container: Checker.get_control_flow_container(fc)
            set extending: true
        }
        ; isNeverInitialized, behind its one reader. ★ Its node is
        ; `immediate_declaration` and NOT `decl`: the two are the same value until
        ; the alias arm rebinds `declaration`, which is exactly the case the
        ; reference keeps a second name for.
        var is_never_initialized false
        if is_outer_variable
        {
            if Checker.kind_or_unknown(immediate_declaration) = KindVariableDeclaration
            {
                let imm immediate_declaration as ref[AstNode]
                var in_for_in_or_of false
                let dl AstNode.parent_node_of(imm)
                if dl <> null
                {
                    let ds AstNode.parent_node_of(dl as ref[AstNode])
                    if ds <> null
                    {
                        let dsk AstNode.kind_of(ds as ref[AstNode])
                        if dsk = KindForInStatement
                            set in_for_in_or_of: true
                        if dsk = KindForOfStatement
                            set in_for_in_or_of: true
                    }
                }
                if in_for_in_or_of = false
                {
                    if AstNode.initializer_of(imm) = null
                    {
                        if AstNode.exclamation_token_of(imm) = null
                        {
                            if this.is_mutable_local_variable_declaration(imm)
                            {
                                if this.is_symbol_assigned_definitely(symbol) = false
                                    set is_never_initialized: true
                            }
                        }
                    }
                }
            }
        }
        var assume_initialized false
        if is_parameter
            set assume_initialized: true
        if is_alias
            set assume_initialized: true
        if is_outer_variable
        {
            if is_never_initialized = false
                set assume_initialized: true
        }
        if is_spread_destructuring_assignment_target
            set assume_initialized: true
        if is_module_exports
            set assume_initialized: true
        if this.is_same_scoped_binding_element(node, decl)
            set assume_initialized: true
        if assume_initialized = false
        {
            if type_is_automatic = false
            {
                if Checker.strict_null_checks() = false
                    set assume_initialized: true
                if (ty.flags & (TypeFlagsAnyOrUnknown | TypeFlagsVoid)) <> 0
                    set assume_initialized: true
                if Checker.is_in_type_query(node)
                    set assume_initialized: true
                if this.is_in_ambient_or_type_node(node)
                    set assume_initialized: true
                if Checker.kind_or_unknown(np) = KindExportSpecifier
                    set assume_initialized: true
            }
        }
        if Checker.kind_or_unknown(np) = KindNonNullExpression
            set assume_initialized: true
        if AstNode.kind_of(decl) = KindVariableDeclaration
        {
            if AstNode.exclamation_token_of(decl) <> null
                set assume_initialized: true
        }
        if (AstNode.flags_of(decl) & NodeFlagsAmbient) <> 0
            set assume_initialized: true
        var initial: ref[Type]? null
        if is_automatic_type_in_non_null
            set initial: undefined_type
        if initial = null
        {
            if assume_initialized
            {
                if is_parameter
                {
                    set initial: this.remove_optionality_from_declared_type(ty, decl)
                    if initial = null
                        return null
                }
                if initial = null
                    set initial: ty
            }
        }
        if initial = null
        {
            if type_is_automatic
                set initial: undefined_type
        }
        if initial = null
        {
            ; getOptionalType(t, false) — `getUnionType([t, undefinedType])`.
            ;
            ; ★★★ THIS WAS THE NINTH DOOR AND SLICE 94 OPENS IT. Slice 93 called it
            ; *"the one that decides how much of the corpus this slice reaches"*,
            ; and it is: an uninitialized `let` whose declared type does not already
            ; admit undefined is exactly the shape TS2454 is about, and it is the
            ; shape the flow walk is asked about most.
            set initial: this.get_optional_type(ty, false)
            if initial = null
                return null
        }
        if this.unported_mark() <> outer_mark
            return null
        var flow_type: ref[Type]? this.get_flow_type_of_reference_ex(node, ty, initial, flow_container, null)
        if flow_type = null
            return null
        ; ★★★ THE NON-NULL WRAP, AND IT IS A SECOND READING OF THE SAME FLAG. The
        ; reference asks `isAutomaticTypeInNonNull` TWICE — once to choose the INITIAL
        ; type (undefinedType, the switch's first arm, which this port had) and once
        ; HERE, where the flow type of `x` inside `x!` is run through
        ; GetNonNullableType. Without it an auto-typed `let` referenced under a `!`
        ; keeps the `| undefined` the flow walk put there, so `last!` answered
        ; `number | undefined` where the reference answers `number`
        ; (compiler/nonNullFullInference, the issue the test is named after).
        ; ★It is invisible to a reader who checked the initial-type switch and stopped:
        ; the flag is used in two places forty lines apart, and the first use looks
        ; like the whole of it.
        if is_automatic_type_in_non_null
        {
            set flow_type: this.get_non_nullable_type(flow_type as ref[Type])
            if flow_type = null
                return null
        }
        let ft flow_type as ref[Type]
        var took_automatic_branch false
        if type_is_automatic
        {
            ; The two implicit-any reports and convertAutoToAny, behind
            ; isEvolvingArrayOperationTarget. ★The conjunction is asked in the
            ; opposite order from the reference's, and that is a decision rather
            ; than an accident: `!isEvolvingArrayOperationTarget(node) && t ==
            ; autoType` evaluates the CALL first upstream, and the call can stop
            ; here, where the second term is a pointer comparison that decides the
            ; answer on its own. Reordering two side-effect-free terms of an AND
            ; cannot change what it answers; asking the stopping one first would
            ; have put a stop on every identifier in the corpus.
            let eaot_mark this.unported_mark()
            let is_target this.is_evolving_array_operation_target(node)
            if this.unported_mark() <> eaot_mark
                return null
            if is_target = false
            {
                set took_automatic_branch: true
                var ft_is_automatic false
                if ft = auto_type
                    set ft_is_automatic: true
                let aat this.get_auto_array_type()
                if aat <> null
                {
                    if ft = (aat as ref[Type])
                        set ft_is_automatic: true
                }
                if ft_is_automatic
                {
                    ; ★ TS7034 and TS7005. The note that stood here read *both
                    ; take symbolToString / TypeToString arguments no instrument in
                    ; this package compares — so a report here is its CODE and its
                    ; LOCATION alone*. Slice 189 retires the second half of it: the
                    ; TypeToString ARGUMENT is not compared and is not free either
                    ; (name_type_for_message).
                    if Checker.no_implicit_any()
                    {
                        let symbol_name this.symbol_arg(symbol)
                        let flow_name this.type_arg(ft)
                        this.error_on_node_or_null(b.get_name_of_declaration(decl), DiagVariable_0_implicitly_has_type_1_in_some_locations_where_its_type_cannot_be_determined, symbol_name, flow_name)
                        let symbol_name2 this.symbol_arg(symbol)
                        let flow_name2 this.type_arg(ft)
                        this.error_on_node(node, DiagVariable_0_implicitly_has_an_1_type, symbol_name2, flow_name2)
                    }
                    return this.convert_auto_to_any(ft)
                }
            }
        }
        ; ★★★ IT IS AN `else if` UPSTREAM AND THE ELSE IS LOAD-BEARING, which the
        ; stop above hid: `if !isEvolvingArrayOperationTarget(node) && (t == autoType
        ; || t == autoArrayType) { … } else if !assumeInitialized && … { TS2454 }`.
        ; While the first branch was a stop its `return null` supplied the else by
        ; accident; slice 141 makes the branch answer, so the flag has to say so.
        if took_automatic_branch = false
        {
            if assume_initialized = false
            {
                if Checker.contains_undefined_type(ty) = false
                {
                    if Checker.contains_undefined_type(ft)
                    {
                        ; TS2454. ★It became REACHABLE the day the ninth door
                        ; (getOptionalType) opened in slice 94, and the `else`
                        ; above is what keeps it off the automatic-type path.
                        this.error_on_node(node, DiagVariable_0_is_used_before_being_assigned, this.symbol_arg(symbol))
                        return ty
                    }
                }
            }
        }
        ; "Identifier is target of a compound assignment"
        if assignment_kind <> AssignmentKindNone
            return this.get_base_type_of_literal_type(ft)
        ft
    }

    procedure check_expression_worker(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let k AstNode.kind_of(node)

        ; ★★★ THE STOP IS GONE SINCE SLICE 91 — see check_identifier's header for
        ; what replaced the argument that kept it.
        if k = KindIdentifier
            return this.check_identifier(node, check_mode)
        if k = KindPrivateIdentifier
            return this.check_private_identifier_expression(node)
        if k = KindThisKeyword
            return this.check_this_expression(node)
        if k = KindSuperKeyword
            return this.check_super_expression(node)
        ; `case ast.KindNullKeyword: return c.nullWideningType` — the first
        ; expression in this port with a type.
        if k = KindNullKeyword
            return null_widening_type
        if k = KindStringLiteral
            return this.string_literal_arm(node)
        if k = KindNoSubstitutionTemplateLiteral
            return this.string_literal_arm(node)
        ; The grammar check runs FIRST and the type second, which is the
        ; reference's order: `c.checkGrammarNumericLiteral(...)` then
        ; `getFreshTypeOfLiteralType(getNumberLiteralType(jsnum.FromString(
        ; node.Text())))`.
        if k = KindNumericLiteral
        {
            this.check_grammar_numeric_literal(node)
            let bits jsnum_from_string(AstNode.literal_text_of(node))
            return this.get_fresh_type_of_literal_type(this.get_number_literal_type(bits))
        }
        if k = KindBigIntLiteral
        {
            this.check_grammar_bigint_literal(node)
            return this.bigint_literal_arm(node, false)
        }
        ; c.trueType / c.falseType — the FRESH member of each boolean pair, built
        ; eagerly in initialize_intrinsic_types.
        if k = KindTrueKeyword
            return true_type
        if k = KindFalseKeyword
            return false_type
        if k = KindTemplateExpression
            return this.check_template_expression(node)
        if k = KindRegularExpressionLiteral
            return this.check_regular_expression_literal(node)
        if k = KindArrayLiteralExpression
            return this.check_array_literal(node, check_mode)
        if k = KindObjectLiteralExpression
            return this.check_object_literal(node, check_mode)
        if k = KindPropertyAccessExpression
            return this.check_property_access_expression(node, check_mode, false)
        if k = KindQualifiedName
            return this.check_qualified_name(node, check_mode)
        if k = KindElementAccessExpression
            return this.check_indexed_access(node, check_mode)
        ; ast.IsImportCall picks a DIFFERENT function, so the fork is in the work
        ; list rather than behind one row. ★★★SLICE 72 REPLACES THE KIND TEST THAT
        ; USED TO STAND HERE with the predicate itself: `import("m")`'s callee is
        ; the `import` KEYWORD and `import.defer("m")`'s is a MetaProperty, and the
        ; reference sends BOTH here — so the kind test, whose note read *"which is
        ; a kind test and needs nothing else"*, sent the deferred form to
        ; check-call-expression. See Parser.is_import_call.
        if k = KindCallExpression
        {
            if Parser.is_import_call(node)
                return this.check_import_call_expression(node)
            return this.check_call_expression(node, check_mode)
        }
        if k = KindNewExpression
            return this.check_call_expression(node, check_mode)
        if k = KindTaggedTemplateExpression
            return this.check_tagged_template_expression(node)
        ; checkParenthesizedExpression, whole:
        ;   `return c.checkExpressionEx(node.Expression(), checkMode)`
        ;
        ; ★ THE JSDOC TYPE-ASSERTION ARM THAT USED TO STAND HERE IS GONE FROM THE
        ; REFERENCE at this pin — the function is one line — so `(null)` answers
        ; the same type `null` does, and a parenthesised unported expression takes
        ; ITS arm's tag rather than one naming the parenthesis. That is the same
        ; property the statement arms have: the tag names the first thing not
        ; implemented, however deep it sits.
        if k = KindParenthesizedExpression
        {
            let inner AstNode.expression_of(node)
            if inner = null
                return error_type
            return this.check_expression_ex(inner as ref[AstNode], check_mode)
        }
        if k = KindClassExpression
            return this.check_class_expression(node)
        if k = KindFunctionExpression
            return this.check_function_expression_or_object_literal_method(node, check_mode)
        if k = KindArrowFunction
            return this.check_function_expression_or_object_literal_method(node, check_mode)
        if k = KindTypeAssertionExpression
            return this.check_assertion(node, check_mode)
        if k = KindAsExpression
            return this.check_assertion(node, check_mode)
        if k = KindTypeOfExpression
            return this.check_type_of_expression(node)
        if k = KindNonNullExpression
            return this.check_non_null_assertion(node)
        if k = KindExpressionWithTypeArguments
            return this.check_expression_with_type_arguments(node)
        if k = KindSatisfiesExpression
            return this.check_satisfies_expression(node)
        if k = KindMetaProperty
            return this.check_meta_property(node)
        if k = KindDeleteExpression
            return this.check_delete_expression(node)
        ; checkVoidExpression, whole: `checkNodeDeferred(node)` and
        ; `undefinedWideningType`. The operand is checked LATER, off the deferred
        ; queue, which is why the arm itself asks nothing of it.
        if k = KindVoidExpression
        {
            this.check_node_deferred(node)
            return undefined_widening_type
        }
        if k = KindAwaitExpression
            return this.check_await_expression(node)
        if k = KindPrefixUnaryExpression
            return this.check_prefix_unary_expression(node)
        if k = KindPostfixUnaryExpression
            return this.check_postfix_unary_expression(node)
        if k = KindBinaryExpression
            return this.check_binary_expression(node, check_mode)
        if k = KindConditionalExpression
            return this.check_conditional_expression(node, check_mode)
        if k = KindSpreadElement
            return this.check_spread_expression(node, check_mode)
        ; `case ast.KindOmittedExpression: return c.undefinedWideningType` — the
        ; elision in `[, x]` and in `let [, a] = xs`.
        if k = KindOmittedExpression
            return undefined_widening_type
        if k = KindYieldExpression
            return this.check_yield_expression(node)
        if k = KindSyntheticExpression
            return this.check_synthetic_expression(node)
        if k = KindJsxExpression
            return this.check_jsx_expression(node, check_mode)
        if k = KindJsxElement
            return this.check_jsx_element(node, check_mode)
        if k = KindJsxSelfClosingElement
            return this.check_jsx_self_closing_element(node, check_mode)
        if k = KindJsxFragment
            return this.check_jsx_fragment(node)
        if k = KindJsxAttributes
            return this.check_jsx_attributes(node, check_mode)
        ; ★★ THE REFERENCE PANICS HERE ("Should never directly check a
        ; JsxOpeningElement") and this port REPORTS, which is the same choice
        ; type_to_string's null arm and reportCircularityError made: a panic is an
        ; unreachability CLAIM, and the port's way of holding a claim is a row that
        ; would appear if it were false. A trap here would be a crash class the
        ; suite handles through accepted.txt — the wrong instrument for our own
        ; claim about the reference's own tree.
        if k = KindJsxOpeningElement
        {
            this.record_unported("check-jsx-opening-element-unreachable", k)
            return null
        }
        ; The switch's default. Not a hole: `return c.errorType` is the reference's
        ; answer for every kind above, printed `any`.
        error_type
    }

    ; The two string-literal `case` labels, which share a body in the reference and
    ; therefore share one here (§3.5bb: a shared record buys a shared BODY only —
    ; here it is the labels that are shared, and the body is the same one).
    ;
    ; ★★ isSkipDirectInferenceNode IS PROVABLY FALSE AND IS THEREFORE NOT ASKED.
    ; It is a membership test in `c.skipDirectInferenceNodes`, a set whose only
    ; writer is the inference machinery's `skipDirectInference` path; nothing here
    ; infers, so the set is empty and the blockedStringType arm cannot be taken.
    ; ★It is one of the few places in this port where the honest port of a test is
    ; NO test — the set does not exist, so a test against it would be a test
    ; against a literal false. The reader that changes that is the inference
    ; dimension, and it arrives with the set.
    procedure string_literal_arm(this, node: ref[AstNode]) returns ref[Type]?
        this.get_fresh_type_of_literal_type(this.get_string_literal_type(AstNode.literal_text_of(node)))

    ; `getFreshTypeOfLiteralType(getBigIntLiteralType(jsnum.NewPseudoBigInt(
    ; jsnum.ParsePseudoBigInt(node.Text()), false)))`, which is three routines
    ; deep and is written out because two of the three do something to the digits.
    ;
    ; ★★★ ParsePseudoBigInt IS THE STAND-IN SLICE 44 NAMED THIS ARM AS THE READER
    ; OF, and it is earned here (§3.5p). The scanner's own call on it is earned in
    ; the same commit — see set_bigint_token_value, and the note there for why the
    ; two together are belt and braces rather than a doubled conversion.
    ;
    ; ★★ NewPseudoBigInt TRIMS LEADING ZEROS AND ZERO IS THE EMPTY STRING, which is
    ; not tidiness: `PseudoBigInt`'s own comment says *"The value zero is
    ; represented as an empty string"*, and pseudo_big_int_to_string reads exactly
    ; that — a length test, not a value test. A port that stored `"0"` here would
    ; print `0n` correctly and compare UNEQUAL to a zero that came the other way.
    ;
    ; ★★★ `negative` WAS FALSE AT THE ONE CALL SITE AND IS NOT ANY MORE, and the
    ; note that stood here — *"a minus sign is a PrefixUnaryExpression, so the
    ; literal itself never carries one"* — was the whole reason slice 102's
    ; prefix-unary arm could reuse this function rather than write a second one:
    ; `-1n` is exactly that PrefixUnaryExpression, and the reference's arm is
    ; `getBigIntLiteralType(NewPseudoBigInt(ParsePseudoBigInt(text), true))`. The
    ; slot was filled from a parameter rather than hard-coded, so the second caller
    ; cost a parameter and nothing else.
    procedure bigint_literal_arm(this, node: ref[AstNode], negative: bool) returns ref[Type]?
    {
        let text AstNode.literal_text_of(node)
        let n AstNode.literal_text_length_of(node)
        let cap ((n + (n / 4)) + 4) as size_t
        let scratch String^host(cap)
        let out Slice[char](cap, scratch.get_buffer() as pointer[char])
        var start 0
        let m Checker.pseudo_big_int_digits(text, out, &start)
        if m < 0
        {
            ; The reference PANICS. Unreachable from here — the scanner accepted
            ; the digits — so it reports rather than trapping, which is this file's
            ; standing answer to a reference panic.
            this.record_unported("parse-pseudo-big-int-invalid", 0)
            return null
        }
        ; NewPseudoBigInt: `Negative: negative && len(value) != 0` — `-0n` IS `0n`
        ; (slice 202, `parseBigInt`).
        var neg negative
        if m = 0
            set neg: false
        this.get_fresh_type_of_literal_type(this.get_bigint_literal_type(out.subslice(start as size_t, (start + m) as size_t), neg))
    }

    ; checkGrammarNumericLiteral, whole.
    ;
    ; ★★★ ITS REPORT IS A SUGGESTION AND CANNOT REACH A C SECTION, which is why the
    ; whole function is ported and its measurement is zero: the last line is
    ; `c.addErrorOrSuggestion(false, …)`, and with isError false that sets
    ; CategorySuggestion and appends to `c.suggestionDiagnostics` — a list
    ; GetDiagnostics does not read. TS80008's own generated line says `Suggestion`.
    ; It is ported rather than skipped because the arm around it is ported, and a
    ; skipped step under a ported arm is the shape §3.5ae warns about: invisible
    ; from both sides.
    ;
    ; ★★★ THE TWO TEXTS ARE DIFFERENT TEXTS AND THE REFERENCE SAYS SO. The
    ; fractional test reads the RAW source (`scanner.GetTextOfNode`) because
    ; `node.Text` of `1100000000000000000000` is the scanner's cooked `1.1e21`,
    ; which contains a `.` the source does not — so asking the cooked text would
    ; return early on a literal that must be reported. The VALUE is read from the
    ; cooked text, because that is the one jsnum parses. Two questions, two texts,
    ; and swapping them is a wrong answer in both directions.
    ;
    ; ★★ THE COMPARISON IS ON THE BIT PATTERN and it is exact rather than
    ; approximate: jsnum_from_string answers an IEEE-754 double's BITS, and for two
    ; non-negative finite doubles the unsigned ordering of the bits IS the ordering
    ; of the values. MaxSafeInteger = 2^53 - 1 is 0x433FFFFFFFFFFFFF. A literal is
    ; never negative (the minus sign is a PrefixUnaryExpression) and never NaN, so
    ; the two exclusions the bit trick needs are properties of the input.
    procedure check_grammar_numeric_literal(this, node: ref[AstNode])
    {
        if (AstNode.numeric_token_flags_of(node) & TokenFlagsScientific) <> 0
            return
        let start b.skip_trivia_at(AstNode.pos_of(node))
        let stop AstNode.end_of(node)
        var i: int start
        while i < stop
        {
            if b.byte_at(i) = 0x2E
                return
            set i: i + 1
        }
        let bits jsnum_from_string(AstNode.literal_text_of(node))
        if bits <= 0x433FFFFFFFFFFFFF
            return
        ; addErrorOrSuggestion(false, …) — see the header. The diagnostic is
        ; deliberately NOT added to this checker's list, and this is the first
        ; SUGGESTION site in the port: writing it into `diagnostics` would invent a
        ; C line the reference does not have, which is the one thing diagcheck
        ; fails on.
        this.record_suggestion(DiagNumeric_literals_with_absolute_values_equal_to_2_53_or_greater_are_too_large_to_be_represented_accurately_as_integers)
    }

    ; The suggestion sink. It counts and drops, and BOTH halves are the point: a
    ; suggestion must not reach the C section, and a suggestion site that did
    ; nothing at all would be indistinguishable from an unported one.
    ;
    ; ★ The counter is the only way a control can prove this function ran — see
    ; slice 70's g-rows.
    procedure record_suggestion(this, code: int)
        set suggestion_count: suggestion_count + 1

    ; checkGrammarBigIntLiteral, whole.
    ;
    ; ★★★ ITS REPORT IS DEAD UNDER THIS HARNESS AND THE PROOF IS ONE COMPARISON:
    ; `c.languageVersion < core.ScriptTargetES2020` with languageVersion at the
    ; DERIVED DEFAULT ES2025 = 12 and ES2020 = 7. So TS2737 cannot appear, and the
    ; function's answer is false for every input. ★It is the fourth reading of an
    ; unset option in this file (see ScriptTarget's note) and the second that kills
    ; a branch outright rather than steering one.
    ;
    ; ★ The literalType test is two kind comparisons and is ported because it is
    ; the reference's own short-circuit: a bigint in `type T = 1n` or `type T = -1n`
    ; is exempt whatever the target is, so it is not part of what the target kills.
    procedure check_grammar_bigint_literal(this, node: ref[AstNode]) returns bool
    {
        let parent AstNode.parent_node_of(node)
        var literal_type: bool false
        if Checker.kind_or_unknown(parent) = KindLiteralType
            set literal_type: true
        if Checker.kind_or_unknown(parent) = KindPrefixUnaryExpression
        {
            if Checker.kind_or_unknown(AstNode.parent_node_of(parent)) = KindLiteralType
                set literal_type: true
        }
        if literal_type
            return false
        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            return false
        if language_version < ScriptTargetES2020
            return this.grammar_error_on_node(node, DiagBigInt_literals_are_not_available_when_targeting_lower_than_ES2020)
        false
    }

    ; ── slice 88: THE BINARY EXPRESSION ─────────────────────────────────────
    ;
    ; checkBinaryExpression is three lines; checkBinaryLikeExpression is the
    ; chapter — two operand checks, a pre-pass for the logical and coalescing
    ; operators, and a switch over sixteen operator groups.
    ;
    ; ★★★ TWO GROUPS CAN ANSWER AND FOURTEEN CANNOT, AND ONE MISSING TYPE DRAWS
    ; THE LINE. `booleanType` is the SEVENTH line of NewChecker that
    ; initialize_intrinsic_types does not transcribe — it is
    ; `getUnionType(trueType, falseType)`, and that note already said so — so every
    ; comparison and equality arm has no value to return; and every arithmetic arm
    ; reaches isTypeAssignableToKind, which is isTypeAssignableTo, which is the
    ; assignability RELATION that slice 70 named as a dimension. What is left is
    ; `=`, which answers rightType, and `,`, which answers rightType.
    ;
    ; ★★★ AND THE HISTOGRAM SAYS THOSE TWO ARE THE CHAPTER. The row was opened as
    ; a histogram the way slice 70 opened its own — `record_unported` was pointed at
    ; the OPERATOR kind for one run instead of at KindBinaryExpression — and the
    ; forty-one operators the corpus holds behind this stop are not evenly spread:
    ; **`=` alone is 245 of the 413 stop events and 98 of the 142 units**, `,` is
    ; six more units, and the whole remaining thirty-nine operators together are
    ; thirty-eight units. ★The two arms that can answer are the two that need no
    ; type at all, which is not a coincidence to pass over: the row was never
    ; waiting on the relation, it was waiting on the DISPATCH.
    ;
    ; ★★★ AN OPERAND'S STOP DOES NOT ABORT THE FUNCTION, and that is what the slice
    ; is worth rather than a detail of style. `x = 1` checks an Identifier on the
    ; left, which stops at check-identifier (the globals table, §3.11) — so
    ; `leftType` is nil for most of the corpus — while the reference's sequence
    ; reaches checkAssignmentOperator regardless, and TS2364 is decided by the
    ; NODE. Bailing out at the first nil would have made this whole chapter
    ; invisible behind a table it does not need. It is the discipline
    ; check_variable_declaration's tail already carries, one level down.
    ;
    ; ★★ WHERE A nil TYPE *IS* LOAD-BEARING IT IS TESTED, at three places and each
    ; for its own reason: the silentNever short-circuit compares an identity that a
    ; nil cannot have, checkTruthinessOfType reads flags off the type, and
    ; checkForDisallowedESSymbolOperand asks maybeTypeOfKind. Each skips rather
    ; than guesses — skipping loses a report, and diagcheck's subsequence relation
    ; is green on a LOSS and red on an INVENTION.

    ; checkBinaryExpression, whole.
    ;
    ; ★ The three slots are non-optional in BinaryExpressionData; the accessors
    ; answer nil only through their union DEFAULT arm, which the caller's own kind
    ; test has already excluded. The report is that claim's holder rather than a
    ; live path — a row that would appear if it were false.
    procedure check_binary_expression(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let left AstNode.binary_left_of(node)
        let operator_token AstNode.binary_operator_token_of(node)
        let right AstNode.binary_right_of(node)
        if left = null
        {
            this.record_unported("binary-expression-slot-missing", KindBinaryExpression)
            return null
        }
        if operator_token = null
        {
            this.record_unported("binary-expression-slot-missing", KindBinaryExpression)
            return null
        }
        if right = null
        {
            this.record_unported("binary-expression-slot-missing", KindBinaryExpression)
            return null
        }
        this.check_binary_like_expression(left as ref[AstNode], operator_token as ref[AstNode], right as ref[AstNode], check_mode, node)
    }

    ; ── the two UNARY expressions (slice 102) ───────────────────────────────
    ;
    ; ★★★ THEY ARE HERE BECAUSE THEY ARE checkArithmeticOperandType'S OTHER TWO
    ; READERS, and that is what makes this a chapter rather than two arms: the
    ; `++`/`--` arm of the prefix expression and the whole of the postfix one are
    ; the SAME four lines the binary arithmetic arm's tail is, over one operand
    ; instead of two. `getUnaryResultType` between them is the third reader of
    ; numberOrBigIntType. A slice that wired the binary arms and left these would
    ; have minted a field for one of its three consumers.
    ;
    ; ★★ THE LITERAL FOLD IN FRONT OF THE SWITCH IS THE PREFIX ARM'S OWN PRODUCT
    ; AND IT IS THE HALF NO RELATION TOUCHES: `-1` is a NumberLiteral type of value
    ; −1, not `number` and not a negation applied later, and `-1n` is the one place
    ; in the whole port where a PseudoBigInt is minted with its sign set. Both
    ; answer BEFORE the operator switch, so every `-1` in the corpus leaves this
    ; function without asking a single question about kinds.

    ; getUnaryResultType, whole.
    procedure get_unary_result_type(this, operand_type: ref[Type]) returns ref[Type]?
    {
        if Checker.maybe_type_of_kind(operand_type, TypeFlagsBigIntLike)
        {
            var number_like false
            if this.is_type_assignable_to_kind(operand_type, TypeFlagsAnyOrUnknown)
                set number_like: true
            else
            {
                if Checker.maybe_type_of_kind(operand_type, TypeFlagsNumberLike)
                    set number_like: true
            }
            if number_like
            {
                if number_or_bigint_type = null
                {
                    this.record_unported("number-or-bigint-type-unminted", TypeFlagsBigIntLike)
                    return null
                }
                return number_or_bigint_type
            }
            return bigint_type
        }
        ; "If it's not a bigint type, implicit coercion will result in a number"
        number_type
    }

    ; The `++`/`--` tail both unary expressions end in — three lines shared because
    ; the reference writes them twice, character for character.
    ;
    ; ★ The `ok` guard is checkArithmeticOperandType's own, which under this port
    ; is FALSE for every input (see that function's header and §3.5ev's finding
    ; one), so `checkReferenceExpression` is unreachable from here today. It is
    ; written rather than deferred because the day the relation's union half lands
    ; it becomes live with no edit, and because a guard whose reason is another
    ; function's wall belongs beside the call it guards.
    procedure check_increment_operand(this, operand: ref[AstNode], operand_type: ref[Type])
    {
        let t this.check_non_null_type(operand_type, operand)
        if t = null
            return
        if this.check_arithmetic_operand_type(operand, t as ref[Type], DiagAn_arithmetic_operand_must_be_of_type_any_number_bigint_or_an_enum_type) = false
            return
        ; "run check only if former checks succeeded to avoid reporting cascading
        ; errors"
        this.check_reference_expression(operand, DiagThe_operand_of_an_increment_or_decrement_operator_must_be_a_variable_or_a_property_access, DiagThe_operand_of_an_increment_or_decrement_operator_may_not_be_an_optional_property_access)
    }

    ; checkPrefixUnaryExpression, whole.
    ;
    ; ★★ THE `+` OPERATOR'S TS2736 IS THE ONE REPORT HERE WHOSE MESSAGE ARGUMENT IS
    ; A TYPE NAME, and it is dropped for report_relation_error's reason: the name
    ; decides nothing, the C section carries pos/end/code, and asking the printer
    ; could only turn a report into a row.
    procedure check_prefix_unary_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let operand AstNode.prefix_unary_operand_of(node)
        if operand = null
        {
            this.record_unported("prefix-unary-slot-missing", KindPrefixUnaryExpression)
            return null
        }
        let expr operand as ref[AstNode]
        let op_kind AstNode.prefix_unary_operator_kind(node)
        let operand_type this.check_expression(expr)
        if operand_type = null
            return null
        let ot operand_type as ref[Type]
        if ot = silent_never_type
            return silent_never_type
        ; The literal fold, which answers before the operator switch is reached.
        let ok AstNode.kind_of(expr)
        if ok = KindNumericLiteral
        {
            if op_kind = KindMinusToken
            {
                let bits jsnum_from_string(AstNode.literal_text_of(expr))
                return this.get_fresh_type_of_literal_type(this.get_number_literal_type(jsnum_negate(bits)))
            }
            if op_kind = KindPlusToken
            {
                let bits jsnum_from_string(AstNode.literal_text_of(expr))
                return this.get_fresh_type_of_literal_type(this.get_number_literal_type(bits))
            }
        }
        if ok = KindBigIntLiteral
        {
            if op_kind = KindMinusToken
                return this.bigint_literal_arm(expr, true)
        }
        ; `+`, `-` and `~`.
        var arith false
        if op_kind = KindPlusToken
            set arith: true
        if op_kind = KindMinusToken
            set arith: true
        if op_kind = KindTildeToken
            set arith: true
        if arith
        {
            this.check_non_null_type(ot, expr)
            if this.maybe_type_of_kind_considering_base_constraint(ot, TypeFlagsESSymbolLike)
                this.error_on_node(expr, DiagThe_0_operator_cannot_be_applied_to_type_symbol, Checker.arg_text(Scanner.token_to_string(op_kind)))
            if op_kind = KindPlusToken
            {
                if this.maybe_type_of_kind_considering_base_constraint(ot, TypeFlagsBigIntLike)
                {
                    let name_arg21 this.type_arg(this.get_base_type_of_literal_type(ot))
                    this.error_on_node(expr, DiagOperator_0_cannot_be_applied_to_type_1, Checker.arg_text(Scanner.token_to_string(op_kind)), name_arg21)
                }
                return number_type
            }
            return this.get_unary_result_type(ot)
        }
        if op_kind = KindExclamationToken
        {
            this.check_truthiness_of_type(ot, expr)
            let facts this.get_type_facts(ot, TypeFactsTruthy | TypeFactsFalsy)
            if facts = TypeFactsTruthy
                return false_type
            if facts = TypeFactsFalsy
                return true_type
            ; ★ booleanType is an Option and a null is the union worker having
            ; stopped, not an answer — see the field's own note.
            if boolean_type = null
            {
                this.record_unported("boolean-type-unminted", op_kind)
                return null
            }
            return boolean_type
        }
        var increment false
        if op_kind = KindPlusPlusToken
            set increment: true
        if op_kind = KindMinusMinusToken
            set increment: true
        if increment
        {
            this.check_increment_operand(expr, ot)
            return this.get_unary_result_type(ot)
        }
        ; The switch's fall-through. Every prefix operator the grammar admits is
        ; named above, so this is the reference's own unreachable tail.
        error_type
    }

    ; checkPostfixUnaryExpression, whole — and it is checkPrefixUnaryExpression's
    ; increment arm with no switch in front of it.
    procedure check_postfix_unary_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let operand AstNode.postfix_unary_operand_of(node)
        if operand = null
        {
            this.record_unported("postfix-unary-slot-missing", KindPostfixUnaryExpression)
            return null
        }
        let expr operand as ref[AstNode]
        let operand_type this.check_expression(expr)
        if operand_type = null
            return null
        let ot operand_type as ref[Type]
        if ot = silent_never_type
            return silent_never_type
        this.check_increment_operand(expr, ot)
        this.get_unary_result_type(ot)
    }

    ; ── the DESTRUCTURING ASSIGNMENT (slice 145) ─────────────────────────────
    ;
    ; `[a, b] = xs`, `({a} = o)`, `({a, ...rest} = o)` and every nesting of them,
    ; plus the for-of head that is one of those. Six functions, mutually recursive
    ; through checkDestructuringAssignment, and the whole chapter was ONE stop with
    ; two rows (the object-literal kind and the array-literal kind).
    ;
    ; ★★★ THE LEFT SIDE IS NOT AN EXPRESSION AND THAT IS THE POINT OF THE CHAPTER.
    ; `{a} = o` parses as an object LITERAL, so the ordinary binary path would ask
    ; for its type and check assignability against it; the reference leaves
    ; checkBinaryLikeExpression before that and re-reads the literal as a PATTERN,
    ; taking each element's type out of the SOURCE by property name or index and
    ; recursing. Nothing here asks the pattern for a type.
    ;
    ; ★★ THE THREE HEADS OF checkDestructuringAssignment ARE THREE DIFFERENT
    ; TARGETS AND EACH ONE MOVES `sourceType`. A shorthand `{a = 1}` checks its own
    ; default through checkBinaryLikeExpression and then strips undefined off the
    ; source; a `[a = 1]` element is a BinaryExpression whose whole self is checked
    ; and whose LEFT becomes the target, stripping undefined again; anything else is
    ; the target as it stands. Only after that is the target's kind dispatched on.
    ;
    ; ★★ EVERY SLOT THE REFERENCE DEREFERENCES UNCONDITIONALLY IS A ROW HERE, not a
    ; silent `null`: `destructuring-slot-missing` names the kind. A shorthand's Name
    ; and EqualsToken, a default's Left, a spread's Expression and the two element
    ; lists are all non-nil in any tree the parser produces, so the row should never
    ; fire — which is precisely why it must be a row and not a bail. A `null` with no
    ; stop is an answer, and answering nothing about a pattern the walk did enter is
    ; the shape §3.5cz calls an unmeasured claim.
    ;
    ; ★ markPropertyAsReferenced is CALLED in the reference and is not ported, for
    ; the reason its neighbours already carry: its entire effect is
    ; `symbolReferenceLinks.Get(target).referenceKinds |= SymbolFlagsAll`, and every
    ; reader of that table is in the checkUnusedIdentifiers family, which this port
    ; does not have. ★★It cannot interact with the one row that does name the table
    ; (check_unused_renamed_binding_elements' `symbol-reference-links`): that drain
    ; asks about a BINDING ELEMENT's symbol, and this writer only ever marks a
    ; CLASS MEMBER — `prop.Flags&ClassMember == 0` returns on its first line.
    procedure check_destructuring_assignment(this, node: ref[AstNode], source_type_in: ref[Type], check_mode: int, right_is_this: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var source_type: ref[Type] source_type_in
        var target: ref[AstNode] node
        if AstNode.kind_of(node) = KindShorthandPropertyAssignment
        {
            let initializer AstNode.shorthand_object_assignment_initializer_of(node)
            if initializer <> null
            {
                let init_expr initializer as ref[AstNode]
                ; "In strict null checking mode, if a default value of a
                ; non-undefined type is specified, remove undefined from the final
                ; type."
                if Checker.strict_null_checks()
                {
                    let init_type this.check_expression(init_expr)
                    if this.unported_mark() <> mark
                        return null
                    if init_type = null
                        return null
                    if this.has_type_facts(init_type as ref[Type], TypeFactsIsUndefined) = false
                    {
                        let stripped this.get_type_with_facts(source_type, TypeFactsNEUndefined)
                        if this.unported_mark() <> mark
                            return null
                        if stripped = null
                            return null
                        set source_type: stripped as ref[Type]
                    }
                }
                let name AstNode.name_of(node)
                let equals AstNode.shorthand_equals_token_of(node)
                if name = null
                {
                    this.record_unported("destructuring-slot-missing", KindShorthandPropertyAssignment)
                    return null
                }
                if equals = null
                {
                    this.record_unported("destructuring-slot-missing", KindShorthandPropertyAssignment)
                    return null
                }
                this.check_binary_like_expression(name as ref[AstNode], equals as ref[AstNode], init_expr, check_mode, null)
                if this.unported_mark() <> mark
                    return null
            }
            let name AstNode.name_of(node)
            if name = null
            {
                this.record_unported("destructuring-slot-missing", KindShorthandPropertyAssignment)
                return null
            }
            set target: name as ref[AstNode]
        }
        var default_valued false
        if AstNode.kind_of(target) = KindBinaryExpression
        {
            if Checker.kind_or_unknown(AstNode.binary_operator_token_of(target)) = KindEqualsToken
                set default_valued: true
        }
        if default_valued
        {
            this.check_binary_expression(target, check_mode)
            if this.unported_mark() <> mark
                return null
            let left AstNode.binary_left_of(target)
            if left = null
            {
                this.record_unported("destructuring-slot-missing", KindBinaryExpression)
                return null
            }
            set target: left as ref[AstNode]
            ; "A default value is specified, so remove undefined from the final
            ; type."
            if Checker.strict_null_checks()
            {
                let stripped this.get_type_with_facts(source_type, TypeFactsNEUndefined)
                if this.unported_mark() <> mark
                    return null
                if stripped = null
                    return null
                set source_type: stripped as ref[Type]
            }
        }
        let tk AstNode.kind_of(target)
        if tk = KindObjectLiteralExpression
            return this.check_object_literal_assignment(target, source_type, right_is_this)
        if tk = KindArrayLiteralExpression
            return this.check_array_literal_assignment(target, source_type, check_mode)
        this.check_reference_assignment(target, source_type, check_mode)
    }

    ; checkObjectLiteralAssignment. ★The EMPTY pattern is the one arm that answers
    ; something other than the source: `({} = o)` under strictNullChecks is a
    ; non-null assertion and nothing else, which is why the report it can make is
    ; checkNonNullType's and not this function's.
    procedure check_object_literal_assignment(this, node: ref[AstNode], source_type: ref[Type], right_is_this: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let properties AstNode.properties_of(node)
        var count 0
        if properties <> null
            set count: (properties as ref[Array[ref[AstNode]?]]).get_length() as int
        if Checker.strict_null_checks()
        {
            if count = 0
                return this.check_non_null_type(source_type, node)
        }
        var i 0
        while i < count
        {
            this.check_object_literal_destructuring_property_assignment(node, source_type, i, properties, right_is_this)
            if this.unported_mark() <> mark
                return null
            set i: i + 1
        }
        source_type
    }

    ; checkObjectLiteralDestructuringPropertyAssignment — one property of an object
    ; pattern, and the reference's own note is the reason `all_properties` is a
    ; parameter of its own: *if property cannot be a SpreadAssignment, then
    ; allProperties does not need to be provided.*
    ;
    ; ★★ THE ELEMENT TYPE IS TAKEN TWICE OVER AND THE SECOND READ IS THE FLOW'S.
    ; getIndexedAccessTypeEx answers the DECLARED element type; getFlowTypeOfDestructuring
    ; then narrows it through the synthetic `o["x"]` reference, which is the machinery
    ; slice 117 built. Skipping the second read would lose every narrowing a
    ; destructuring assignment inherits from its source.
    ;
    ; ★ `AccessFlagsAllowMissing` is conditional on hasDefaultValue and nothing
    ; else: `{a = 1} = o` may read a property `o` does not have, `{a} = o` may not.
    procedure check_object_literal_destructuring_property_assignment(this, node: ref[AstNode], object_literal_type: ref[Type], property_index: int, all_properties: ref[Array[ref[AstNode]?]]?, right_is_this: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let properties AstNode.properties_of(node)
        if properties = null
        {
            this.record_unported("destructuring-slot-missing", KindObjectLiteralExpression)
            return null
        }
        let plist properties as ref[Array[ref[AstNode]?]]
        let popt plist[property_index]
        if popt = null
        {
            this.record_unported("destructuring-slot-missing", KindObjectLiteralExpression)
            return null
        }
        let property popt as ref[AstNode]
        let pk AstNode.kind_of(property)
        var assignment false
        if pk = KindPropertyAssignment
            set assignment: true
        if pk = KindShorthandPropertyAssignment
            set assignment: true
        if assignment
        {
            let name_opt AstNode.name_of(property)
            if name_opt = null
            {
                this.record_unported("destructuring-slot-missing", pk)
                return null
            }
            let name name_opt as ref[AstNode]
            let expr_type this.get_literal_type_from_property_name(name)
            if this.unported_mark() <> mark
                return null
            if expr_type = null
                return null
            let et expr_type as ref[Type]
            if Checker.is_type_usable_as_property_name(et)
            {
                var nb char[JSNUM_MAX_TEXT]
                let text this.get_property_name_from_type(et, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
                let prop this.get_property_of_type(object_literal_type, text)
                if this.unported_mark() <> mark
                    return null
                if prop <> null
                {
                    this.mark_property_as_referenced(prop as ref[Symbol], property, right_is_this)
                    this.check_property_accessibility(property, false, true, object_literal_type, prop as ref[Symbol])
                    if this.unported_mark() <> mark
                        return null
                }
            }
            var access_flags AccessFlagsExpressionPosition
            if this.has_default_value(property)
                set access_flags: access_flags | AccessFlagsAllowMissing
            let element_type this.get_indexed_access_type_ex(object_literal_type, et, access_flags, name, null)
            if this.unported_mark() <> mark
                return null
            if element_type = null
                return null
            let t this.get_flow_type_of_destructuring(property, element_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if t = null
                return null
            var expr: ref[AstNode] property
            if pk = KindPropertyAssignment
            {
                let init_node AstNode.initializer_of(property)
                if init_node = null
                {
                    this.record_unported("destructuring-slot-missing", pk)
                    return null
                }
                set expr: init_node as ref[AstNode]
            }
            return this.check_destructuring_assignment(expr, t as ref[Type], CheckModeNormal, false)
        }
        if pk = KindSpreadAssignment
        {
            if property_index < ((plist.get_length() as int) - 1)
            {
                this.error_on_node(property, DiagA_rest_element_must_be_last_in_a_destructuring_pattern)
                return null
            }
            if language_version < ScriptTargetES2018
                this.check_external_emit_helpers(property, ExternalEmitHelpersRest)
            let non_rest_names &Array[ref[AstNode]?]^host()
            if all_properties <> null
            {
                let alist all_properties as ref[Array[ref[AstNode]?]]
                let an alist.get_length() as int
                var j 0
                while j < an
                {
                    let other alist[j]
                    set j: j + 1
                    if other = null
                        continue
                    if AstNode.kind_of(other as ref[AstNode]) = KindSpreadAssignment
                        continue
                    non_rest_names.add(AstNode.name_of(other as ref[AstNode]))
                }
            }
            let t this.get_rest_type(object_literal_type, non_rest_names as ref[Array[ref[AstNode]?]]?, object_literal_type.symbol)
            if this.unported_mark() <> mark
                return null
            if t = null
                return null
            this.check_grammar_for_disallowed_trailing_comma(all_properties, DiagA_rest_parameter_or_binding_pattern_may_not_have_a_trailing_comma)
            let e AstNode.expression_of(property)
            if e = null
            {
                this.record_unported("destructuring-slot-missing", KindSpreadAssignment)
                return null
            }
            return this.check_destructuring_assignment(e as ref[AstNode], t as ref[Type], CheckModeNormal, false)
        }
        this.error_on_node(property, DiagProperty_assignment_expected)
        null
    }

    ; checkArrayLiteralAssignment.
    ;
    ; ★★★ TWO ELEMENT TYPES, AND THE SECOND ONE IS ASKED LAZILY BECAUSE ASKING IT
    ; REPORTS. `possiblyOutOfBoundsType` comes from one
    ; checkIteratedTypeOrElementType with PossiblyOutOfBounds set — which is also
    ; the call that CHECKS the source is iterable at all, so it must happen once and
    ; unconditionally. The in-bounds type is the same question without that flag,
    ; and under noUncheckedIndexedAccess it is asked only when a SPREAD element
    ; needs it: a second call would run the iterability check, and its reports, a
    ; second time.
    procedure check_array_literal_assignment(this, node: ref[AstNode], source_type: ref[Type], check_mode: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let elements AstNode.elements_of(node)
        var count 0
        if elements <> null
            set count: (elements as ref[Array[ref[AstNode]?]]).get_length() as int
        let possibly this.check_iterated_type_or_element_type(IterationUseDestructuring | IterationUsePossiblyOutOfBounds, source_type, undefined_type, node)
        if this.unported_mark() <> mark
            return null
        var possibly_out_of_bounds: ref[Type] error_type
        if possibly <> null
            set possibly_out_of_bounds: possibly as ref[Type]
        var in_bounds: ref[Type]? possibly_out_of_bounds
        if Checker.no_unchecked_indexed_access()
            set in_bounds: null
        var i 0
        while i < count
        {
            let row (elements as ref[Array[ref[AstNode]?]])[i]
            var t: ref[Type] possibly_out_of_bounds
            if row <> null
            {
                if AstNode.kind_of(row as ref[AstNode]) = KindSpreadElement
                {
                    if in_bounds = null
                    {
                        let strict this.check_iterated_type_or_element_type(IterationUseDestructuring, source_type, undefined_type, node)
                        if this.unported_mark() <> mark
                            return null
                        if strict = null
                            set in_bounds: error_type
                        else
                            set in_bounds: strict
                    }
                    set t: in_bounds as ref[Type]
                }
            }
            this.check_array_literal_destructuring_element_assignment(node, source_type, i, t, check_mode)
            if this.unported_mark() <> mark
                return null
            set i: i + 1
        }
        source_type
    }

    ; checkArrayLiteralDestructuringElementAssignment — one element of an array
    ; pattern.
    ;
    ; ★★★ THE ARRAY-LIKE ARM SYNTHESIZES AN EXPRESSION AND THE REFERENCE SAYS WHY:
    ; *we create a synthetic expression so that getIndexedAccessType doesn't get
    ; confused when the element is a SyntaxKind.ElementAccessExpression.* The access
    ; NODE is what an indexed-access report points at, and for `[o[0]] = xs` the
    ; element is itself an element access — pointing the report at it would name the
    ; wrong access.
    ;
    ; ★★ THE REST ELEMENT'S TYPE IS A TUPLE SLICE WHERE IT CAN BE AND AN ARRAY
    ; OTHERWISE, and the test is `everyType(sourceType, isTupleType)`: slicing a
    ; tuple keeps the remaining elements' individual types, while
    ; `createArrayType(elementType)` collapses them into one. The port already had
    ; the predicate as every_type_is_tuple.
    ;
    ; ★ A HOLE — `[, a] = xs` — is an OmittedExpression and the whole function is
    ; skipped for it, which is not the same as checking it against `undefined`.
    procedure check_array_literal_destructuring_element_assignment(this, node: ref[AstNode], source_type: ref[Type], element_index: int, element_type: ref[Type], check_mode: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let elements AstNode.elements_of(node)
        if elements = null
        {
            this.record_unported("destructuring-slot-missing", KindArrayLiteralExpression)
            return null
        }
        let elist elements as ref[Array[ref[AstNode]?]]
        let eopt elist[element_index]
        if eopt = null
        {
            this.record_unported("destructuring-slot-missing", KindArrayLiteralExpression)
            return null
        }
        let element eopt as ref[AstNode]
        let ek AstNode.kind_of(element)
        if ek = KindOmittedExpression
            return null
        if ek <> KindSpreadElement
        {
            let index_type this.get_number_literal_type(jsnum_from_int(element_index))
            if this.is_array_like_type(source_type)
            {
                if this.unported_mark() <> mark
                    return null
                var access_flags AccessFlagsExpressionPosition
                let has_default this.has_default_value(element)
                if has_default
                    set access_flags: access_flags | AccessFlagsAllowMissing
                let synthetic this.new_synthetic_expression(element, index_type, false, null)
                let accessed this.get_indexed_access_type_or_undefined(source_type, index_type, access_flags, synthetic, null)
                if this.unported_mark() <> mark
                    return null
                var assigned: ref[Type] error_type
                if accessed <> null
                    set assigned: accessed as ref[Type]
                if has_default
                {
                    let stripped this.get_type_with_facts(assigned, TypeFactsNEUndefined)
                    if this.unported_mark() <> mark
                        return null
                    if stripped = null
                        return null
                    set assigned: stripped as ref[Type]
                }
                let t this.get_flow_type_of_destructuring(element, assigned)
                if this.unported_mark() <> mark
                    return null
                if t = null
                    return null
                return this.check_destructuring_assignment(element, t as ref[Type], check_mode, false)
            }
            if this.unported_mark() <> mark
                return null
            return this.check_destructuring_assignment(element, element_type, check_mode, false)
        }
        if element_index < ((elist.get_length() as int) - 1)
        {
            this.error_on_node(element, DiagA_rest_element_must_be_last_in_a_destructuring_pattern)
            return null
        }
        let rest_opt AstNode.expression_of(element)
        if rest_opt = null
        {
            this.record_unported("destructuring-slot-missing", KindSpreadElement)
            return null
        }
        let rest_expression rest_opt as ref[AstNode]
        var initialized false
        if AstNode.kind_of(rest_expression) = KindBinaryExpression
        {
            if Checker.kind_or_unknown(AstNode.binary_operator_token_of(rest_expression)) = KindEqualsToken
                set initialized: true
        }
        if initialized
        {
            this.error_on_node(AstNode.binary_operator_token_of(rest_expression), DiagA_rest_element_cannot_have_an_initializer)
            return null
        }
        this.check_grammar_for_disallowed_trailing_comma(elements, DiagA_rest_parameter_or_binding_pattern_may_not_have_a_trailing_comma)
        var t: ref[Type]? null
        if this.every_type_is_tuple(source_type)
        {
            var a_value MapTypeArgs(null, null, null, null, null, false, null, null, element_index, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
            let a &a_value as ref[MapTypeArgs]?
            set t: this.map_type(source_type, MapTypeKindSliceTuple, a)
        }
        else
            set t: this.create_array_type(element_type)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        this.check_destructuring_assignment(rest_expression, t as ref[Type], check_mode, false)
    }

    ; checkReferenceAssignment — the LEAF of the chapter: the target is an ordinary
    ; reference, so it is checked as an expression and the source is checked against
    ; it. ★The two diagnostics are chosen by the target's PARENT and not by the
    ; target: inside a `{...x}` the message names the object-rest form.
    procedure check_reference_assignment(this, target: ref[AstNode], source_type: ref[Type], check_mode: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let target_type this.check_expression_ex(target, check_mode)
        if this.unported_mark() <> mark
            return null
        if target_type = null
            return null
        var message DiagThe_left_hand_side_of_an_assignment_expression_must_be_a_variable_or_a_property_access
        var optional_message DiagThe_left_hand_side_of_an_assignment_expression_may_not_be_an_optional_property_access
        if Checker.kind_or_unknown(AstNode.parent_node_of(target)) = KindSpreadAssignment
        {
            set message: DiagThe_target_of_an_object_rest_assignment_must_be_a_variable_or_a_property_access
            set optional_message: DiagThe_target_of_an_object_rest_assignment_may_not_be_an_optional_property_access
        }
        if this.check_reference_expression(target, message, optional_message)
        {
            if this.unported_mark() <> mark
                return null
            this.check_type_assignable_to_and_optionally_elaborate(source_type, target_type as ref[Type], target, target, 0)
            if this.unported_mark() <> mark
                return null
        }
        source_type
    }

    ; checkBinaryLikeExpression. The head, the pre-pass and the switch.
    ;
    ; ★★ `errorNode` IS OPTIONAL UPSTREAM AND IS OPTIONAL HERE: checkDestructuring
    ; Assignment's shorthand arm passes nil. The one report in this slice's prefix
    ; that lands ON it — the equality arm's TS2839 — therefore goes through
    ; error_on_node_or_null, which DROPS a nil, and that is the faithful answer
    ; rather than a leniency: `c.error(nil, …)` builds a diagnostic with no file,
    ; which lands in the GLOBAL list and never appears among the reference's own C
    ; lines. The reporter family's header states the same rule from its own side.
    procedure check_binary_like_expression(this, left: ref[AstNode], operator_token: ref[AstNode], right: ref[AstNode], check_mode: int, error_node: ref[AstNode]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let op_kind AstNode.kind_of(operator_token)

        ; The destructuring fork. `[a, b] = xs` and `({a} = o)` are not binary
        ; operators at all — the left side is a PATTERN — so the reference leaves
        ; the function here, and so does this port.
        if op_kind = KindEqualsToken
        {
            let lk AstNode.kind_of(left)
            var pattern false
            if lk = KindObjectLiteralExpression
                set pattern: true
            if lk = KindArrayLiteralExpression
                set pattern: true
            if pattern
            {
                ; The reference evaluates `c.checkExpressionEx(right, checkMode)` as
                ; the ARGUMENT, so the right side is checked FIRST — the order is
                ; observable and the stop that stood here already relied on it.
                ; ★`rightIsThis` is `right.Kind == KindThisKeyword`, which is what
                ; makes `{a} = this` mark its properties as self-accesses.
                let source_type this.check_expression_ex(right, check_mode)
                if this.unported_mark() <> mark
                    return null
                if source_type = null
                    return null
                return this.check_destructuring_assignment(left, source_type as ref[Type], check_mode, AstNode.kind_of(right) = KindThisKeyword)
            }
        }

        let left_type this.check_expression_ex(left, check_mode)
        let right_type this.check_expression_ex(right, check_mode)

        ; ── the logical / coalescing pre-pass ────────────────────────────────
        ;
        ; ★ The walk starts at `left.Parent.Parent`, which for `a && b` is the
        ; binary expression's own parent: the reference is looking for the
        ; STATEMENT this chain hangs off, and it climbs through parentheses and
        ; through further logical operators to find it.
        if Binder.is_logical_or_coalescing_binary_operator(op_kind)
        {
            var parent AstNode.parent_node_of(AstNode.parent_node_of(left))
            while Checker.is_parenthesis_or_logical_chain(parent)
                set parent: AstNode.parent_node_of(parent)
            var ask_known_truthy false
            if op_kind = KindAmpersandAmpersandToken
                set ask_known_truthy: true
            if Checker.kind_or_unknown(parent) = KindIfStatement
                set ask_known_truthy: true
            if ask_known_truthy
            {
                ; checkTestingKnownTruthyCallableOrAwaitableOrEnumMemberType(left,
                ; leftType, body) — the `body` here is the STATEMENT the chain hangs
                ; off, which is what the climb above was for.
                ;
                ; ★★★ THE ROW'S NOTE NAMED ITS OWN EXPIRY — *"the line moves in the
                ; commit that fixed the limit it named"* — and the limit it named,
                ; the control-flow graph, is not what any of the three reports asks.
                ; §3.5eo.
                ; ★ THE BODY IS THE IF STATEMENT'S THEN-BRANCH AND NIL OTHERWISE —
                ; not the climbed `parent` itself. With `&&` under anything but an
                ; `if`, the reference has no body to search and the note is decided
                ; by the binary-chain walk alone.
                var body: ref[AstNode]? null
                if Checker.kind_or_unknown(parent) = KindIfStatement
                    set body: AstNode.then_statement_of(parent as ref[AstNode])
                if left_type <> null
                    this.check_testing_known_truthy(left, left_type as ref[Type], body)
            }
            if Binder.is_logical_binary_operator(op_kind)
            {
                ; ★ `??` is excluded here and included above, which is the whole
                ; reason is_logical_binary_operator was split back out of its
                ; caller in binder.scaly.
                if left_type <> null
                    this.check_truthiness_of_type(left_type as ref[Type], left)
            }
        }

        ; ── the switch ───────────────────────────────────────────────────────

        ; The arithmetic and bitwise group, twenty-two operators — WHOLE since slice
        ; 102. The silentNever short-circuit, checkNonNullType on both operands
        ; (slice 90), the BOOLEAN SUGGESTION, the two operand reports, the
        ; three-way result fork and the assignment tail.
        ;
        ; ★★ A nil OPERAND TYPE STILL STOPS, and it stops at the row the typed path
        ; used to name. checkNonNullType cannot be asked about a type this port
        ; never computed, and neither can checkArithmeticOperandType — so the arm
        ; keeps `check-arithmetic-operand-type` for exactly that population and for
        ; nothing else. **The row therefore no longer means *this chapter is
        ; unported*; it means *this unit's operand type is*.**
        ;
        ; ★★★ THE SHIFT SUGGESTION IS THE ARM'S ONE REMAINING WALL AND IT IS AN
        ; EVALUATOR, not a relation: `c.evaluate(right, right)` folds the right-hand
        ; side to a constant so that a shift by 32 or more can be reported as
        ; TS6807. Nothing in this port evaluates a constant expression — the same
        ; absence `compute-enum-member-values` names from the enum side — so the six
        ; shift operators keep a row of their own, reached only after both operands
        ; were accepted. ★It is a SUGGESTION outside an enum member, which
        ; record_suggestion would drop; the reason it is a stop and not a drop is
        ; the `isEnumMember` half, where the same line is an ERROR.
        if Checker.is_arithmetic_or_bitwise_operator(op_kind)
        {
            if Checker.either_is(left_type, right_type, silent_never_type)
                return silent_never_type
            if left_type = null
            {
                this.record_unported("check-arithmetic-operand-type", op_kind)
                return null
            }
            if right_type = null
            {
                this.record_unported("check-arithmetic-operand-type", op_kind)
                return null
            }
            let lt0 this.check_non_null_type(left_type as ref[Type], left)
            if lt0 = null
                return null
            let rt0 this.check_non_null_type(right_type as ref[Type], right)
            if rt0 = null
                return null
            ; "if a user tries to apply a bitwise operator to 2 boolean
            ; operands try and return them a helpful suggestion"
            let lt lt0 as ref[Type]
            let rt rt0 as ref[Type]
            if (lt.flags & TypeFlagsBooleanLike) <> 0
            {
                if (rt.flags & TypeFlagsBooleanLike) <> 0
                {
                    let suggested Checker.get_suggested_boolean_operator(op_kind)
                    if suggested <> KindUnknown
                    {
                        this.error_on_node(operator_token, DiagThe_0_operator_is_not_allowed_for_boolean_types_Consider_using_1_instead, Checker.arg_text(Scanner.token_to_string(op_kind)), Checker.arg_text(Scanner.token_to_string(suggested)))
                        return number_type
                    }
                }
            }
            ; "otherwise just check each operand separately and report errors as
            ; normal" — TS2362 and TS2363. Both calls run; the reference reads the
            ; two answers together at the tail and so does this.
            let left_ok this.check_arithmetic_operand_type(left, lt, DiagThe_left_hand_side_of_an_arithmetic_operation_must_be_of_type_any_number_bigint_or_an_enum_type)
            let right_ok this.check_arithmetic_operand_type(right, rt, DiagThe_right_hand_side_of_an_arithmetic_operation_must_be_of_type_any_number_bigint_or_an_enum_type)
            ; ★★★ THE MARK IS TAKEN HERE AND NOT AT THE ARM'S HEAD, and the split is
            ; the whole safety argument. The two operand reports carry their own
            ; guard INSIDE check_arithmetic_operand_type, because a comparison that
            ; stopped must not be read as *not assignable*; what the mark below
            ; protects is the RESULT FORK, where a stop inside either
            ; isTypeAssignableToKind would choose an arm on an answer the port did
            ; not have — and the third arm REPORTS. A `nil` answer here is the
            ; port's third state, not the reference's errorType.
            let fork_mark this.unported_mark()
            ; "If both are any or unknown, allow operation; assume it will resolve
            ; to number". Transcribed with the reference's short-circuits: the
            ; maybeTypeOfKind pair is asked only when the AnyOrUnknown pair failed,
            ; which matters because the first can stop and the second cannot.
            var use_number false
            if this.is_type_assignable_to_kind(lt, TypeFlagsAnyOrUnknown)
            {
                if this.is_type_assignable_to_kind(rt, TypeFlagsAnyOrUnknown)
                    set use_number: true
            }
            if use_number = false
            {
                if Checker.maybe_type_of_kind(lt, TypeFlagsBigIntLike) = false
                {
                    if Checker.maybe_type_of_kind(rt, TypeFlagsBigIntLike) = false
                        set use_number: true
                }
            }
            var result_type: ref[Type]? null
            if use_number
                set result_type: number_type
            else
            {
                if this.both_are_big_int_like(lt, rt)
                {
                    ; `>>>` and `>>>=` are not defined on BigInt at all, so the
                    ; reference reports and keeps bigintType as the answer.
                    var unsigned_shift false
                    if op_kind = KindGreaterThanGreaterThanGreaterThanToken
                        set unsigned_shift: true
                    if op_kind = KindGreaterThanGreaterThanGreaterThanEqualsToken
                        set unsigned_shift: true
                    if unsigned_shift
                        this.report_operator_error(lt, op_kind, rt, error_node, 0)
                    var exponent false
                    if op_kind = KindAsteriskAsteriskToken
                        set exponent: true
                    if op_kind = KindAsteriskAsteriskEqualsToken
                        set exponent: true
                    if exponent
                    {
                        ; Dead under this harness — see ScriptTargetES2016's note.
                        if language_version < ScriptTargetES2016
                            this.error_on_node_or_null(error_node, DiagExponentiation_cannot_be_performed_on_bigint_values_unless_the_target_option_is_set_to_es2016_or_later)
                    }
                    set result_type: bigint_type
                }
                else
                {
                    ; TS2365. The reference hands both_are_big_int_like in as the
                    ; `isRelated` callback; see report_operator_error's header for
                    ; why the callback has no reader here.
                    this.report_operator_error(lt, op_kind, rt, error_node, 1)
                    set result_type: error_type
                }
            }
            if this.unported_mark() <> fork_mark
                return null
            if left_ok
            {
                if right_ok
                {
                    this.check_assignment_operator(left, op_kind, right, lt, result_type)
                    ; ★★★ THE SHIFT-SIMPLIFICATION REPORT, ANSWERABLE SINCE SLICE
                    ; 116, and its whole content was the constant EVALUATOR: `x <<
                    ; 33` shifts by 1, so the reference tells the author. ★It is
                    ; `errorOrSuggestion`, and the bool that decides which is
                    ; whether the shift sits inside an ENUM MEMBER — a suggestion
                    ; never reaches the C section (suggestion_count's note), so the
                    ; enum case is the only one this yardstick can see, and the
                    ; count is what makes the other one provable.
                    if Checker.is_shift_operator(op_kind)
                    {
                        let rhs_eval this.evaluate(right, right)
                        if rhs_eval.kind = EvalKindNumber
                        {
                            if jsnum_at_least(jsnum_abs(rhs_eval.bits), jsnum_from_int(32))
                            {
                                let host_node Checker.walk_up_parenthesized_expressions(AstNode.parent_node_of(AstNode.parent_node_of(right)))
                                if Checker.kind_or_unknown(host_node) = KindEnumMember
                                {
                                    var remainder_text StringBuilder()
                                    var rb char[JSNUM_MAX_TEXT]
                                    let rn jsnum_to_string(jsnum_remainder(rhs_eval.bits, jsnum_from_int(32)), Slice[char](JSNUM_MAX_TEXT as size_t, &rb[0]))
                                    remainder_text.append(&rb[0], rn as size_t)
                                    this.error_on_node_or_null(error_node, DiagThis_operation_can_be_simplified_This_shift_is_identical_to_0_1_2, this.node_text_arg(left), Checker.arg_text(Scanner.token_to_string(op_kind)), remainder_text.to_string())
                                }
                                else
                                    set suggestion_count: suggestion_count + 1
                            }
                        }
                    }
                }
            }
            return result_type
        }

        ; `+` and `+=` — WHOLE since slice 102, and it is the arm every
        ; isTypeAssignableToKindEx STRICT caller lives in.
        ;
        ; ★★★ THE STRICT FLAG IS WHAT MAKES THIS ARM DIFFERENT FROM THE ONE ABOVE.
        ; The first test the arm makes is NON-strict (a StringLike operand skips
        ; checkNonNullType) and the three that choose the result are STRICT — so
        ; `any + any` falls past number, past bigint and past string into the
        ; IsTypeAny arm and answers `any`, where a non-strict reading would have
        ; answered `number` at the first fork. One flag, one line apart, and the
        ; commonest input in the corpus.
        ;
        ; ★★★ THE ES-SYMBOL CALL IS ASKED ONLY WHEN A RESULT TYPE WAS FOUND, AND ITS
        ; POLARITY IS THE OPPOSITE OF WHAT IT READS AS. `checkForDisallowedESSymbol
        ; Operand` answers TRUE when it did NOT report, so the reference's
        ; `resultType != nil && !c.checkFor…` returns early exactly when a symbol
        ; operand DID collect TS2469 — the early return is a SUPPRESSION of the
        ; `+=` assignment check, not the ordinary exit. Written the natural way
        ; round the `+=` tail is skipped for every well-typed `+` in the corpus.
        if Checker.is_plus_operator(op_kind)
        {
            if Checker.either_is(left_type, right_type, silent_never_type)
                return silent_never_type
            if left_type = null
            {
                this.record_unported("is-type-assignable-to-kind", op_kind)
                return null
            }
            if right_type = null
            {
                this.record_unported("is-type-assignable-to-kind", op_kind)
                return null
            }
            let arm_mark this.unported_mark()
            var lt left_type as ref[Type]
            var rt right_type as ref[Type]
            var either_string false
            if this.is_type_assignable_to_kind(lt, TypeFlagsStringLike)
                set either_string: true
            else
            {
                if this.is_type_assignable_to_kind(rt, TypeFlagsStringLike)
                    set either_string: true
            }
            if this.unported_mark() <> arm_mark
                return null
            if either_string = false
            {
                let ltn this.check_non_null_type(lt, left)
                if ltn = null
                    return null
                let rtn this.check_non_null_type(rt, right)
                if rtn = null
                    return null
                set lt: ltn as ref[Type]
                set rt: rtn as ref[Type]
            }
            var result_type: ref[Type]? null
            ; "Operands of an enum type are treated as having the primitive type
            ; Number. If both operands are of the Number primitive type, the result
            ; is of the Number primitive type."
            if this.is_type_assignable_to_kind_ex(lt, TypeFlagsNumberLike, true)
            {
                if this.is_type_assignable_to_kind_ex(rt, TypeFlagsNumberLike, true)
                    set result_type: number_type
            }
            if result_type = null
            {
                if this.is_type_assignable_to_kind_ex(lt, TypeFlagsBigIntLike, true)
                {
                    if this.is_type_assignable_to_kind_ex(rt, TypeFlagsBigIntLike, true)
                        set result_type: bigint_type
                }
            }
            if result_type = null
            {
                var either_string_strict false
                if this.is_type_assignable_to_kind_ex(lt, TypeFlagsStringLike, true)
                    set either_string_strict: true
                else
                {
                    if this.is_type_assignable_to_kind_ex(rt, TypeFlagsStringLike, true)
                        set either_string_strict: true
                }
                if either_string_strict
                    set result_type: string_type
            }
            if result_type = null
            {
                var either_any false
                if Checker.is_type_any(lt)
                    set either_any: true
                if Checker.is_type_any(rt)
                    set either_any: true
                if either_any
                {
                    ; "NOTE: unknown type here denotes error type. Old compiler
                    ; treated this case as any type so do we."
                    var either_error false
                    if this.is_error_type(lt)
                        set either_error: true
                    if this.is_error_type(rt)
                        set either_error: true
                    if either_error
                        set result_type: error_type
                    else
                        set result_type: any_type
                }
            }
            ; ★★★ THE FOUR FORKS ARE READ TOGETHER OR NOT AT ALL. A stop inside any
            ; of the six strict comparisons above leaves `result_type` holding an
            ; answer the port did not earn, and the branch below turns a nil into a
            ; REPORT — the one direction diagcheck can see.
            if this.unported_mark() <> arm_mark
                return null
            ; "Symbols are not allowed at all in arithmetic expressions"
            if result_type <> null
            {
                if this.check_for_disallowed_es_symbol_operand(left, right, lt, rt, op_kind) = false
                    return result_type as ref[Type]
            }
            if result_type = null
            {
                ; "Types that have a reasonably good chance of being a valid operand
                ; type. If both types have an awaited type of one of these, we'll
                ; assume the user might be missing an await …" — the closeEnoughKind
                ; callback, which report_operator_error's header prices at zero.
                this.report_operator_error(lt, op_kind, rt, error_node, 2)
                return any_type
            }
            if op_kind = KindPlusEqualsToken
                this.check_assignment_operator(left, op_kind, right, lt, result_type)
            return result_type
        }

        ; The four relational operators, WHOLE since this slice.
        ; checkForDisallowedESSymbolOperand runs FIRST and is ported whole; the two
        ; checkNonNullType calls behind it are slice 90; and the relation behind
        ; THOSE — getBaseTypeOfLiteralTypeForComparison, then
        ; reportOperatorErrorUnless — is what this slice writes.
        ;
        ; ★★★ THE PREDICATE IS A FOUR-LINE DISJUNCTION AND IT IS INLINED RATHER
        ; THAN PASSED, for §3.5e's reason: Scaly has no closure value here and
        ; each of the reference's two call sites passes a FIXED lambda. The
        ; report's own second use of the predicate — getBaseTypesIfUnrelated, which
        ; re-asks it on the widened operands — decides only the message's
        ; ARGUMENTS, and the dump carries a code and a span (slice 68), so
        ; report_operator_error takes neither the types nor the predicate.
        if Checker.is_relational_operator(op_kind)
        {
            if this.check_for_disallowed_es_symbol_operand(left, right, left_type, right_type, op_kind)
            {
                if left_type = null
                    return boolean_type
                if right_type = null
                    return boolean_type
                let mark this.unported_mark()
                let lt0 this.check_non_null_type(left_type as ref[Type], left)
                if lt0 = null
                    return null
                let rt0 this.check_non_null_type(right_type as ref[Type], right)
                if rt0 = null
                    return null
                let lt this.get_base_type_of_literal_type_for_comparison(lt0 as ref[Type])
                if lt = null
                    return null
                let rt this.get_base_type_of_literal_type_for_comparison(rt0 as ref[Type])
                if rt = null
                    return null
                if this.unported_mark() <> mark
                    return null
                if this.relational_operands_are_compatible(lt as ref[Type], rt as ref[Type]) = false
                {
                    if this.unported_mark() <> mark
                        return null
                    this.report_operator_error(lt as ref[Type], op_kind, rt as ref[Type], error_node, 3)
                }
                if this.unported_mark() <> mark
                    return null
            }
            else
                ; ★★★ THE ERROR PATH ANSWERS SINCE SLICE 94, AND THE LINE IT
                ; REPLACES IS THE CLEAREST STATEMENT OF WHAT THE UNION WALL COST:
                ; *"on a reported ES-symbol operand the reference skips the rest and
                ; returns booleanType, which is exactly the one thing this port
                ; cannot mint — so the tag names getUnionType and not the step that
                ; is no longer reached"*. It can mint it now, so the arm is a real
                ; answer rather than a row, and the diagnostic
                ; check_for_disallowed_es_symbol_operand already reported stands.
                return boolean_type
            ; "The result is always of the Boolean primitive type" — both paths,
            ; which is what made the `return null` that stood here a REGRESSION the
            ; moment the true branch stopped reporting.
            return boolean_type
        }

        ; The four equality operators. Two of the three steps inside the
        ; CheckModeTypeOnly gate are node-driven and are ported; the third is the
        ; relation, and the answer is booleanType.
        if Checker.is_equality_operator(op_kind)
        {
            if (check_mode & CheckModeTypeOnly) = 0
            {
                var object_literal false
                if Checker.is_literal_expression_of_object(left)
