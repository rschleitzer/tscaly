            {
                let resolved this.resolve_symbol(md)
                if this.unported_mark() <> mark
                    return null
                set result: this.get_merged_symbol(resolved)
            }
        }
        if links <> null
        {
            let l2 links as ref[JsxElementLink]
            if result <> null
                set l2.jsx_implicit_import_container: result
            else
                set l2.jsx_implicit_import_container: unknown_symbol
        }
        result
    }

    ; Program.GetJSXRuntimeImportSpecifier's module reference (slice 255), empty for
    ; a file that is not JSX or TSX or has no automatic runtime
    ;
    ; ★★★ WITHOUT A PROGRAM THE ANSWER IS EMPTY, and that is the checker yardstick's
    ; ORACLE: tests/oracle/batch.go's stub program answers `"", nil` here, so a
    ; `@jsxImportSource` or `@jsxRuntime automatic` pragma resolves nothing under it.
    ; Computed without that guard, eight stage-2 units reported TS2875 the oracle
    ; does not (§3.5kb).
    procedure get_jsx_runtime_import_specifier(this, file: ref[AstNode]?) returns Slice[char]
    {
        if program = null
            return Slice[char]()
        if file = null
            return Slice[char]()
        Checker.jsx_runtime_import_of(host, file, this.script_kind_of_file(file as ref[AstNode]), jsx_emit, jsx_import_source_option)
    }

    ; `ast.GetJSXRuntimeImport(ast.GetJSXImplicitImportBase(options, file), options)` —
    ; free functions over the OPTIONS upstream, which is what lets its file loader
    ; ask them without a checker (slice 293)
    function jsx_runtime_import_of(host: ref[Page], file: ref[AstNode]?, script_kind: int, jsx_emit: int, jsx_import_source_option: Slice[char]) returns Slice[char]
    {
        if file = null
            return Slice[char]()
        if (script_kind <> ScriptKindJSX) and (script_kind <> ScriptKindTSX)
            return Slice[char]()
        let base Checker.jsx_implicit_import_base_of(file as ref[AstNode], jsx_emit, jsx_import_source_option)
        if base.length = 0
            return base
        if jsx_emit = JsxEmitReactJSXDev
            return Checker.concat_name(host, base, "/jsx-dev-runtime")
        Checker.concat_name(host, base, "/jsx-runtime")
    }

    ; ast.GetJSXImplicitImportBase
    function get_jsx_implicit_import_base(this, file: ref[AstNode]) returns Slice[char]
        Checker.jsx_implicit_import_base_of(file, jsx_emit, jsx_import_source_option)

    function jsx_implicit_import_base_of(file: ref[AstNode], jsx_emit: int, jsx_import_source_option: Slice[char]) returns Slice[char]
    {
        let import_source_pragma AstNode.jsx_import_source_pragma_of(file)
        let runtime_pragma AstNode.jsx_runtime_pragma_of(file)
        if Checker.name_bytes_are(runtime_pragma, "classic")
            return Slice[char]()
        var automatic (jsx_emit = JsxEmitReactJSX) or (jsx_emit = JsxEmitReactJSXDev)
        if jsx_import_source_option.length > 0
            set automatic: true
        if import_source_pragma.length > 0
            set automatic: true
        if Checker.name_bytes_are(runtime_pragma, "automatic")
            set automatic: true
        if automatic = false
            return Slice[char]()
        if import_source_pragma.length > 0
            return import_source_pragma
        if jsx_import_source_option.length > 0
            return jsx_import_source_option
        Slice[char](5, "react")
    }

    ; a file's ScriptKind, off the parser that read it (slice 255)
    function script_kind_of_file(this, sf: ref[AstNode]) returns int
    {
        let idx this.program_index_of_node(sf)
        if idx >= 0
        {
            let pp (program as ref[ProgramFiles]).parser_at(idx)
            if pp <> null
                return (pp as ref[Parser]).script_kind
        }
        p.script_kind
    }

    ; compilerOptions.GetJSXTransformEnabled
    function jsx_transform_enabled(this) returns bool
    {
        if jsx_emit = JsxEmitReact
            return true
        (jsx_emit = JsxEmitReactJSX) or (jsx_emit = JsxEmitReactJSXDev)
    }

    ; getJsxNamespace, as a NAME rather than as a string — the port's ordinary
    ; shape for a Go `string` return (§3.5bc), with `false` for the one caller-
    ; visible failure the port can have and the reference cannot.
    ;
    ; ★★ Whole since slice 255: the pragma arms parse their factory as an isolated
    ; entity name into the file links, and the checker-wide fallback reads the
    ; `jsxFactory` and `reactNamespace` options before it mints `<ns>.createElement`.
    procedure get_jsx_namespace(this, location: ref[AstNode]?, out_name: ref[Slice[char]]) returns bool
    {
        if location <> null
        {
            let file Checker.source_file_of_node(location)
            if file <> null
            {
                let links this.source_file_link_of(file as ref[AstNode])
                if AstNode.kind_of(location) = KindJsxOpeningFragment
                {
                    if links.local_jsx_fragment_namespace.length <> 0
                    {
                        set out_name: links.local_jsx_fragment_namespace
                        return true
                    }
                    let entity this.get_jsx_fragment_factory_entity(location)
                    if entity <> null
                    {
                        let first Checker.get_first_identifier(entity)
                        if first <> null
                        {
                            let fid first as ref[AstNode]
                            let text Slice[char](AstNode.identifier_text_length_of(fid), AstNode.identifier_text_of(fid).data)
                            set links.local_jsx_fragment_factory: entity
                            set links.local_jsx_fragment_namespace: text
                            set out_name: text
                            return true
                        }
                    }
                }
                else
                {
                    var lj_data Slice[char]()
                    if this.get_local_jsx_namespace(file as ref[AstNode], &lj_data)
                    {
                        set links.local_jsx_namespace: lj_data
                        set out_name: lj_data
                        return true
                    }
                }
            }
        }
        if jsx_namespace_name.length = 0
        {
            set jsx_namespace_name: Slice[char](5, "React")
            if jsx_factory_option.length > 0
            {
                set jsx_factory_entity: Parser.parse_isolated_entity_name(host, jsx_factory_option)
                if jsx_factory_entity <> null
                {
                    let first Checker.get_first_identifier(jsx_factory_entity)
                    if first <> null
                    {
                        let fid first as ref[AstNode]
                        set jsx_namespace_name: Slice[char](AstNode.identifier_text_length_of(fid), AstNode.identifier_text_of(fid).data)
                    }
                }
            }
            else
            {
                if react_namespace_option.length > 0
                    set jsx_namespace_name: react_namespace_option
            }
        }
        ; `c.factory.NewQualifiedName(NewIdentifier(ns), NewIdentifier("createElement"))`
        ; — minted here as the parse of that text, whose nodes are synthetic the same way
        if jsx_factory_entity = null
            set jsx_factory_entity: Parser.parse_isolated_entity_name(host, Checker.concat_name(host, jsx_namespace_name, ".createElement"))
        set out_name.data: jsx_namespace_name.data
        set out_name.length: jsx_namespace_name.length
        true
    }

    ; getLocalJsxNamespace — the `@jsx` pragma's factory, parsed as an entity name
    ; into the file links (slice 255)
    procedure get_local_jsx_namespace(this, file: ref[AstNode], out_name: ref[Slice[char]]) returns bool
    {
        let links this.source_file_link_of(file)
        if links.local_jsx_namespace.length <> 0
        {
            set out_name: links.local_jsx_namespace
            return true
        }
        let pragma AstNode.jsx_factory_text_of(file)
        if pragma.length = 0
            return false
        let entity Parser.parse_isolated_entity_name(host, pragma)
        set links.local_jsx_factory: entity
        if entity = null
            return false
        let first Checker.get_first_identifier(entity)
        if first = null
            return false
        let fid first as ref[AstNode]
        let ns Slice[char](AstNode.identifier_text_length_of(fid), AstNode.identifier_text_of(fid).data)
        set links.local_jsx_namespace: ns
        set out_name.data: ns.data
        set out_name.length: ns.length
        true
    }

    ; getJsxFactoryEntity and getJsxFragmentFactoryEntity (slice 255: the pragmas
    ; and the two options)
    procedure get_jsx_factory_entity(this, location: ref[AstNode]?) returns ref[AstNode]?
    {
        if location <> null
        {
            var ignored_name Slice[char]()
            let ignored this.get_jsx_namespace(location, &ignored_name)
            let file Checker.source_file_of_node(location)
            if file <> null
            {
                let links this.source_file_link_of(file as ref[AstNode])
                if links.local_jsx_factory <> null
                    return links.local_jsx_factory
            }
        }
        jsx_factory_entity
    }

    procedure get_jsx_fragment_factory_entity(this, location: ref[AstNode]?) returns ref[AstNode]?
    {
        if location <> null
        {
            let file Checker.source_file_of_node(location)
            if file <> null
            {
                let links this.source_file_link_of(file as ref[AstNode])
                if links.local_jsx_fragment_factory <> null
                    return links.local_jsx_fragment_factory
                let pragma AstNode.jsx_fragment_factory_text_of(file)
                if pragma.length > 0
                {
                    set links.local_jsx_fragment_factory: Parser.parse_isolated_entity_name(host, pragma)
                    return links.local_jsx_fragment_factory
                }
            }
        }
        if jsx_fragment_factory_option.length > 0
            return Parser.parse_isolated_entity_name(host, jsx_fragment_factory_option)
        null
    }

    ; getJsxType, whole — and it is the function the whole chapter's answer rests
    ; on. ★A MISS IS `errorType` AND NOT NULL, which is what makes every caller's
    ; `isErrorType` test the real fork; a port that answered null here would turn
    ; the chapter's ordinary answer into a stop.
    procedure get_jsx_type(this, name: Slice[char], location: ref[AstNode]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let namespace this.get_jsx_namespace_at(location)
        if this.unported_mark() <> mark
            return null
        if namespace <> null
        {
            let exports this.get_exports_of_symbol(namespace as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            if exports <> null
            {
                var stopped false
                let type_symbol this.lookup_in_table(exports, name, SymbolFlagsType, &stopped, false)
                if stopped
                    return null
                if type_symbol <> null
                {
                    let declared this.get_declared_type_of_symbol(type_symbol as ref[Symbol])
                    if this.unported_mark() <> mark
                        return null
                    return declared
                }
            }
        }
        error_type
    }

    procedure get_jsx_element_type_at(this, location: ref[AstNode]?) returns ref[Type]?
        this.get_jsx_type("Element", location)

    procedure get_jsx_element_class_type_at(this, location: ref[AstNode]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t this.get_jsx_type("ElementClass", location)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        if this.is_error_type(t as ref[Type])
            return null
        t
    }

    ; getJsxStatelessElementTypeAt. ★Its `jsxElementType == nil` guard is dead for
    ; getJsxType's reason (a miss is errorType), and it is transcribed for the same
    ; reason checkJsxPreconditions' second arm is.
    procedure get_jsx_stateless_element_type_at(this, location: ref[AstNode]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let jsx_element_type this.get_jsx_element_type_at(location)
        if this.unported_mark() <> mark
            return null
        if jsx_element_type = null
            return null
        let types &Array[ref[Type]?]()
        types.add(jsx_element_type)
        types.add(null_type)
        this.get_union_type(types)
    }

    ; getJsxElementTypeSymbol and getJsxLibraryManagedAttributes — two getSymbol
    ; calls over the namespace's exports, kept apart because their callers are.
    procedure get_jsx_element_type_symbol(this, jsx_namespace: ref[Symbol]?, stopped: ref[bool]) returns ref[Symbol]?
    {
        if jsx_namespace = null
            return null
        this.lookup_in_table(Symbol.exports_of(jsx_namespace as ref[Symbol]), "ElementType", SymbolFlagsType, stopped, false)
    }

    procedure get_jsx_library_managed_attributes(this, jsx_namespace: ref[Symbol]?, stopped: ref[bool]) returns ref[Symbol]?
    {
        if jsx_namespace = null
            return null
        this.lookup_in_table(Symbol.exports_of(jsx_namespace as ref[Symbol]), "LibraryManagedAttributes", SymbolFlagsType, stopped, false)
    }

    ; getJsxElementTypeTypeAt — `JSX.ElementType`, the modern constraint that
    ; replaces the JSX.Element / JSX.ElementClass pair when it exists.
    procedure get_jsx_element_type_type_at(this, location: ref[AstNode]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let ns this.get_jsx_namespace_at(location)
        if this.unported_mark() <> mark
            return null
        if ns = null
            return null
        var stopped false
        let sym this.get_jsx_element_type_symbol(ns, &stopped)
        if stopped
            return null
        if sym = null
            return null
        let t this.instantiate_alias_or_interface_with_defaults(sym as ref[Symbol], null, Parser.is_in_js_file(location))
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        if this.is_error_type(t as ref[Type])
            return null
        t
    }

    ; getJsxElementPropertiesName and getJsxElementChildrenPropertyName over
    ; getNameFromJsxElementAttributesContainer.
    ;
    ; ★★★ THE ANSWER HAS THREE STATES AND THE PORT SPELLS THEM AS A PAIR. Upstream
    ; returns `InternalSymbolNameMissing` for *the container does not exist* (all
    ; non-intrinsic attributes are `any`), `""` for *it exists with no properties*
    ; (the attributes type is the element instance type) and a NAME otherwise —
    ; three answers its callers genuinely tell apart. Here the verdict is the return
    ; value (false = MISSING) and the name is the out pair, so a caller that forgets
    ; the difference does not compile rather than reading an empty name as a
    ; sentinel. It is `effective_property_name`'s shape, one chapter over.
    procedure get_jsx_element_properties_name(this, jsx_namespace: ref[Symbol]?, out_name: ref[Slice[char]], stopped: ref[bool]) returns bool
        this.get_name_from_jsx_element_attributes_container("ElementAttributesProperty", jsx_namespace, out_name, stopped)

    procedure get_jsx_element_children_property_name(this, jsx_namespace: ref[Symbol]?, out_name: ref[Slice[char]], stopped: ref[bool]) returns bool
    {
        ; "In these JsxEmit modes the children property is fixed to 'children'"
        if (jsx_emit = JsxEmitReactJSX) or (jsx_emit = JsxEmitReactJSXDev)
        {
            set stopped: false
            set out_name: Slice[char](8, "children")
            return true
        }
        this.get_name_from_jsx_element_attributes_container("ElementChildrenAttribute", jsx_namespace, out_name, stopped)
    }

    procedure get_name_from_jsx_element_attributes_container(this, container_name: Slice[char], jsx_namespace: ref[Symbol]?, out_name: ref[Slice[char]], stopped: ref[bool]) returns bool
    {
        set out_name.data: null
        set out_name.length: 0
        if jsx_namespace = null
            return false
        let mark this.unported_mark()
        let sym this.lookup_in_table(Symbol.exports_of(jsx_namespace as ref[Symbol]), container_name, SymbolFlagsType, stopped, false)
        if stopped
            return false
        if sym = null
            return false
        let declared this.get_declared_type_of_symbol(sym as ref[Symbol])
        if this.unported_mark() <> mark
        {
            set stopped: true
            return false
        }
        if declared = null
        {
            set stopped: true
            return false
        }
        let props this.get_properties_of_type(declared as ref[Type])
        if this.unported_mark() <> mark
        {
            set stopped: true
            return false
        }
        var count 0
        if props <> null
            set count: (props as ref[Array[ref[Symbol]?]]).get_length() as int
        ; "Element Attributes has zero properties, so the element attributes type
        ; will be the class instance type" — the `""` answer, which is TRUE with an
        ; empty name and not the MISSING verdict.
        if count = 0
            return true
        if count = 1
        {
            let p (props as ref[Array[ref[Symbol]?]])[0]
            if p = null
                return false
            set out_name.data: Symbol.name_of(p as ref[Symbol]).data
            set out_name.length: Symbol.name_len_of(p as ref[Symbol])
            return true
        }
        if Symbol.declaration_count(sym as ref[Symbol]) <> 0
            this.error_on_node(Symbol.declaration_at(sym as ref[Symbol], 0), DiagThe_global_type_JSX_0_may_not_have_more_than_one_property, Checker.arg_text(container_name))
        false
    }

    ; ── the five entry points ────────────────────────────────────────────────

    ; checkJsxElement and checkJsxSelfClosingElement — two lines each, and the
    ; DEFERRAL is the load-bearing half: the opening element is checked after the
    ; whole file, so a component declared below its own use is in scope by then.
    procedure check_jsx_element(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        this.check_node_deferred(node)
        this.get_jsx_element_type_at(node)
    }

    procedure check_jsx_self_closing_element(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        this.check_node_deferred(node)
        this.get_jsx_element_type_at(node)
    }

    ; checkJsxElementDeferred. ★The closing tag is resolved for no reason this
    ; yardstick can see EXCEPT one: `getIntrinsicTagSymbol` REPORTS, so `</span>`
    ; against a missing IntrinsicElements is a second TS7026 at the closing tag's
    ; own span. The reference's comment says the call is for rename and go-to-
    ; definition; its diagnostic is what makes it observable here.
    procedure check_jsx_element_deferred(this, node: ref[AstNode])
    {
        let opening AstNode.jsx_element_opening_of(node)
        if opening = null
            return
        this.check_jsx_opening_like_element_or_opening_fragment(opening as ref[AstNode])
        let closing AstNode.jsx_element_closing_of(node)
        if closing <> null
        {
            let tag AstNode.jsx_tag_name_of(closing)
            if Checker.is_jsx_intrinsic_tag_name(tag)
            {
                var stopped false
                let ignored this.get_intrinsic_tag_symbol(closing as ref[AstNode], &stopped)
            }
            else
            {
                if tag <> null
                {
                    let ignored this.check_expression(tag as ref[AstNode])
                }
            }
        }
        let ignored_children this.check_jsx_children(node, CheckModeNormal)
    }

    procedure check_jsx_self_closing_element_deferred(this, node: ref[AstNode])
        this.check_jsx_opening_like_element_or_opening_fragment(node)

    ; checkJsxExpression, whole.
    procedure check_jsx_expression(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let ignored this.check_grammar_jsx_expression(node)
        let expr AstNode.expression_of(node)
        if expr = null
            return error_type
        let mark this.unported_mark()
        let t this.check_expression_ex(expr as ref[AstNode], check_mode)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        let ty t as ref[Type]
        if AstNode.dot_dot_dot_token_of(node) <> null
        {
            if ty <> any_type
            {
                if this.is_array_type(ty) = false
                    this.error_on_node(node, DiagJSX_spread_child_must_be_an_array_type)
            }
        }
        t
    }

    ; checkJsxFragment, whole. ★The factory report between the two halves is behind
    ; `GetJSXTransformEnabled()` — the checker's `jsx_emit` since slice 255.
    procedure check_jsx_fragment(this, node: ref[AstNode]) returns ref[Type]?
    {
        let opening AstNode.jsx_fragment_opening_of(node)
        if opening = null
            return null
        this.check_jsx_opening_like_element_or_opening_fragment(opening as ref[AstNode])
        let node_source_file Checker.source_file_of_node(node)
        if this.jsx_transform_enabled()
        {
            let jsx_pragma AstNode.jsx_factory_text_of(node_source_file)
            let frag_pragma AstNode.jsx_fragment_factory_text_of(node_source_file)
            if (jsx_factory_option.length > 0) or (jsx_pragma.length > 0)
            {
                if (jsx_fragment_factory_option.length = 0) and (frag_pragma.length = 0)
                {
                    if jsx_factory_option.length > 0
                        this.error_on_node(node, DiagThe_jsxFragmentFactory_compiler_option_must_be_provided_to_use_JSX_fragments_with_the_jsxFactory_compiler_option)
                    else
                        this.error_on_node(node, DiagAn_jsxFrag_pragma_is_required_when_using_an_jsx_pragma_with_JSX_fragments)
                }
            }
        }
        let mark this.unported_mark()
        let ignored this.check_jsx_children(node, CheckModeNormal)
        if this.unported_mark() <> mark
            return null
        let t this.get_jsx_element_type_at(node)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        if this.is_error_type(t as ref[Type])
            return any_type
        t
    }

    ; checkJsxAttributes — one line, and the node it asks about is the PARENT: the
    ; attributes list's type is the opening element's attributes type.
    procedure check_jsx_attributes(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let parent AstNode.parent_node_of(node)
        if parent = null
            return null
        this.create_jsx_attributes_type_from_attributes_property(parent as ref[AstNode], check_mode)
    }

    ; checkJsxOpeningLikeElementOrOpeningFragment — the chapter's spine.
    procedure check_jsx_opening_like_element_or_opening_fragment(this, node: ref[AstNode])
    {
        let is_node_opening_like_element AstNode.is_jsx_opening_like_element(node)
        if is_node_opening_like_element
        {
            let ignored this.check_grammar_jsx_element(node)
        }
        this.check_jsx_preconditions(node)
        this.mark_jsx_alias_referenced(node)
        let mark this.unported_mark()
        let sig this.get_resolved_signature(node, CheckModeNormal)
        if this.unported_mark() <> mark
            return
        if sig = null
            return
        this.check_deprecated_signature(sig as ref[Signature], node)
        if is_node_opening_like_element = false
            return
        let element_type_constraint this.get_jsx_element_type_type_at(node)
        if this.unported_mark() <> mark
            return
        let tag_name AstNode.jsx_tag_name_of(node)
        if element_type_constraint <> null
        {
            if tag_name = null
                return
            var tag_type: ref[Type]? null
            if Checker.is_jsx_intrinsic_tag_name(tag_name)
            {
                var td Slice[char]()
                if Checker.jsx_tag_name_text(this.host, tag_name as ref[AstNode], &td) = false
                {
                    this.record_unported("jsx-namespaced-tag-text", AstNode.kind_of(tag_name as ref[AstNode]))
                    return
                }
                set tag_type: this.get_string_literal_type(td)
            }
            else
                set tag_type: this.check_expression(tag_name as ref[AstNode])
            if this.unported_mark() <> mark
                return
            if tag_type = null
                return
            ; `checkTypeRelatedToEx(tagType, elementTypeConstraint, assignable,
            ; tagName, Its_type_0_is_not_a_valid_JSX_element_type, &diags)` and then
            ; a CHAIN whose head is `X_0_cannot_be_used_as_a_JSX_component`. A dump
            ; carries the head's code and span (§3.5's chain rule, slice 118), so
            ; what has to be exact is TS2786 at the tag name.
            let related this.is_type_related_to(tag_type as ref[Type], element_type_constraint as ref[Type], RelationAssignable)
            if this.unported_mark() <> mark
                return
            if related = false
                this.error_on_node(tag_name, DiagX_0_cannot_be_used_as_a_JSX_component, this.node_text_arg(tag_name))
            return
        }
        let ret this.get_return_type_of_signature(sig as ref[Signature])
        if this.unported_mark() <> mark
            return
        if ret = null
            return
        this.check_jsx_return_assignable_to_appropriate_bound(this.get_jsx_reference_kind(node), ret as ref[Type], node)
    }

    ; checkJsxPreconditions.
    ;
    ; ★★★ UNDER THE CHECKER YARDSTICK'S HARNESS `compilerOptions.Jsx` is `JsxEmitNone`,
    ; so every opening-like element and every opening fragment of every `.tsx` and
    ; `.jsx` unit collects TS17004 — the commonest diagnostic slice 119 added. The
    ; guard reads the option since slice 255.
    ;
    ; ★★ THE SECOND ARM HAS NO INPUT — see the chapter header — and is written
    ; anyway.
    procedure check_jsx_preconditions(this, error_node: ref[AstNode])
    {
        if jsx_emit = JsxEmitNone
            this.error_on_node(error_node, DiagCannot_use_JSX_unless_the_jsx_flag_is_provided)
        if Checker.no_implicit_any()
        {
            let mark this.unported_mark()
            let t this.get_jsx_element_type_at(error_node)
            if this.unported_mark() <> mark
                return
            if t = null
                this.error_on_node(error_node, DiagJSX_element_implicitly_has_type_any_because_the_global_type_JSX_Element_does_not_exist)
        }
    }

    ; markJsxAliasReferenced.
    ;
    ; ★★★ WHOLE SINCE SLICE 255, AND ITS PRODUCT IS THE IMPORT ELISION'S: the alias
    ; it marks is the `import React` (or the `jsxFactory` / `reactNamespace` root) a
    ; transformed JSX file keeps. With the factory namespace a constant `React` the
    ; wrong alias was marked — nine case pairs dropped an import the reference keeps.
    procedure mark_jsx_alias_referenced(this, node: ref[AstNode])
    {
        let mark this.unported_mark()
        let implicit this.get_jsx_namespace_container_for_implicit_import(node)
        if this.unported_mark() <> mark
            return
        if implicit <> null
            return
        var jsx_factory_ref_err 0
        if jsx_emit = JsxEmitReact
            set jsx_factory_ref_err: DiagThis_JSX_tag_requires_0_to_be_in_scope_but_it_could_not_be_found
        var ns_data Slice[char]()
        if this.get_jsx_namespace(node, &ns_data) = false
            return
        var factory_location node
        if AstNode.is_jsx_opening_like_element(node)
        {
            let tag AstNode.jsx_tag_name_of(node)
            if tag = null
                return
            set factory_location: tag as ref[AstNode]
        }
        let should_factory_ref_err (jsx_emit <> JsxEmitPreserve) and (jsx_emit <> JsxEmitReactNative)
        var flags SymbolFlagsValue
        if should_factory_ref_err = false
            set flags: flags - (flags & SymbolFlagsEnum)
        ; #38720/60122, allow null as jsxFragmentFactory
        var skip false
        if AstNode.kind_of(node) = KindJsxOpeningFragment
        {
            if Checker.name_bytes_are(ns_data, "null")
                set skip: true
        }
        if skip = false
        {
            let jsx_factory_sym this.resolve_name(factory_location, ns_data, flags, jsx_factory_ref_err, true, false)
            if this.unported_mark() <> mark
                return
            if jsx_factory_sym <> null
            {
                let sym jsx_factory_sym as ref[Symbol]
                ; `c.symbolReferenced(sym, SymbolFlagsAll)` — the emit resolver's
                ; bit with no reader here. `canCollectSymbolAliasAccessibilityData`
                ; is true for a program's checker.
                if (Symbol.flags_of(sym) & SymbolFlagsAlias) <> 0
                {
                    let type_only this.get_type_only_alias_declaration(sym)
                    if this.unported_mark() <> mark
                        return
                    if type_only = null
                    {
                        this.mark_alias_symbol_as_referenced(sym)
                        if this.unported_mark() <> mark
                            return
                    }
                }
            }
        }
        ; a fragment also marks the jsx pragma's namespace, since `getJsxNamespace`
        ; above resolved only the fragment factory when the two are distinct
        if AstNode.kind_of(node) = KindJsxOpeningFragment
        {
            let file Checker.source_file_of_node(node)
            let entity this.get_jsx_factory_entity(file)
            if entity <> null
            {
                let first Checker.get_first_identifier(entity)
                if first <> null
                {
                    let fid first as ref[AstNode]
                    let local_ns Slice[char](AstNode.identifier_text_length_of(fid), AstNode.identifier_text_of(fid).data)
                    let ignored this.resolve_name(factory_location, local_ns, flags, jsx_factory_ref_err, true, false)
                }
            }
        }
    }

    ; checkJsxReturnAssignableToAppropriateBound. All three arms end in one
    ; `checkTypeRelatedToEx` whose failure is chained under TS2786, so the port
    ; reports the head at the tag name and the three inner messages are chain links
    ; a dump cannot see (slice 118's rule).
    procedure check_jsx_return_assignable_to_appropriate_bound(this, ref_kind: int, elem_instance_type: ref[Type], opening_like_element: ref[AstNode])
    {
        let mark this.unported_mark()
        var constraint: ref[Type]? null
        if ref_kind = JsxReferenceKindFunction
            set constraint: this.get_jsx_stateless_element_type_at(opening_like_element)
        if ref_kind = JsxReferenceKindComponent
            set constraint: this.get_jsx_element_class_type_at(opening_like_element)
        if ref_kind = JsxReferenceKindMixed
        {
            let sfc this.get_jsx_stateless_element_type_at(opening_like_element)
            if this.unported_mark() <> mark
                return
            let cls this.get_jsx_element_class_type_at(opening_like_element)
            if this.unported_mark() <> mark
                return
            if sfc = null
                return
            if cls = null
                return
            let types &Array[ref[Type]?]()
            types.add(sfc)
            types.add(cls)
            set constraint: this.get_union_type(types)
        }
        if this.unported_mark() <> mark
            return
        if constraint = null
            return
        let related this.is_type_related_to(elem_instance_type, constraint as ref[Type], RelationAssignable)
        if this.unported_mark() <> mark
            return
        if related = false
            this.error_on_node(AstNode.jsx_tag_name_of(opening_like_element), DiagX_0_cannot_be_used_as_a_JSX_component, this.node_text_arg(AstNode.jsx_tag_name_of(opening_like_element)))
    }

    ; getJsxReferenceKind, whole.
    procedure get_jsx_reference_kind(this, node: ref[AstNode]) returns int
    {
        let tag_name AstNode.jsx_tag_name_of(node)
        if Checker.is_jsx_intrinsic_tag_name(tag_name)
            return JsxReferenceKindMixed
        if tag_name = null
            return JsxReferenceKindMixed
        let mark this.unported_mark()
        let checked this.check_expression(tag_name as ref[AstNode])
        if this.unported_mark() <> mark
            return JsxReferenceKindMixed
        if checked = null
            return JsxReferenceKindMixed
        let tag_type this.get_apparent_type(checked as ref[Type])
        if this.unported_mark() <> mark
            return JsxReferenceKindMixed
        if tag_type = null
            return JsxReferenceKindMixed
        if Checker.sig_count(this.get_signatures_of_type(tag_type as ref[Type], SignatureKindConstruct)) <> 0
            return JsxReferenceKindComponent
        if Checker.sig_count(this.get_signatures_of_type(tag_type as ref[Type], SignatureKindCall)) <> 0
            return JsxReferenceKindFunction
        JsxReferenceKindMixed
    }

    ; ── the intrinsic tag ────────────────────────────────────────────────────

    ; isJsxIntrinsicTagName (checker/utilities.go) over scanner.IsIntrinsicJsxName.
    ; ★A NAMESPACED name is intrinsic WHATEVER its case — `<a:b />` — which is the
    ; comment the reference puts on the second disjunct.
    function is_jsx_intrinsic_tag_name(tag_name: ref[AstNode]?) returns bool
    {
        if tag_name = null
            return false
        let t tag_name as ref[AstNode]
        if AstNode.kind_of(t) = KindJsxNamespacedName
            return true
        if AstNode.kind_of(t) <> KindIdentifier
            return false
        let n AstNode.identifier_text_length_of(t)
        if n = 0
            return false
        let d AstNode.identifier_text_of(t)
        let first d[0] as int
        if first >= 97
        {
            if first <= 122
                return true
        }
        var i 0
        while i < n
        {
            if (d[i] as int) = 45
                return true
            set i: i + 1
        }
        false
    }

    ; `tagName.Text()` for the two kinds a tag name can have here.
    ;
    ; ★★★ THE NAMESPACED HALF IS BUILT, AND THE NOTE THAT SAID IT COULD NOT BE
    ; NAMED THE WRONG OBSTACLE. It read *this port stores no such buffer … the bytes
    ; do not exist, and inventing them would put a wrong property name into a lookup
    ; that reports on a miss*. The first clause is true and the conclusion does not
    ; follow: upstream stores no buffer either — `Text()` CONCATENATES on every ask
    ; — and `Binder.get_declaration_name` had been building exactly these bytes into
    ; exactly this shape since slice 26, for the attribute name `xlink:href`. What
    ; would have been an invention is a DIFFERENT spelling; this is the reference's.
    ;
    ; ★ Both halves are Identifiers by grammar, so the two texts are IdentifierData
    ; reads and neither can be a literal needing a decode.
    procedure jsx_tag_name_text(host: ref[Page], tag_name: ref[AstNode], out_name: ref[Slice[char]]) returns bool
    {
        if AstNode.kind_of(tag_name) = KindIdentifier
        {
            set out_name.data: AstNode.identifier_text_of(tag_name).data
            set out_name.length: AstNode.identifier_text_length_of(tag_name)
            return true
        }
        if AstNode.kind_of(tag_name) = KindJsxNamespacedName
        {
            let ns AstNode.namespaced_namespace_of(tag_name)
            let nm AstNode.namespaced_name_of(tag_name)
            let nsd AstNode.identifier_text_of(ns)
            let nsl AstNode.identifier_text_length_of(ns)
            let nmd AstNode.identifier_text_of(nm)
            let nml AstNode.identifier_text_length_of(nm)
            let buf host.allocate((nsl + nml + 1) as size_t, 1) as pointer[char]
            var i 0
            while i < nsl
            {
                set *(buf + i): nsd[i]
                set i: i + 1
            }
            set *(buf + nsl): ":" as char
            set i: 0
            while i < nml
            {
                set *(buf + nsl + 1 + i): nmd[i]
                set i: i + 1
            }
            set out_name.data: buf
            set out_name.length: nsl + nml + 1
            return true
        }
        set out_name.data: null
        set out_name.length: 0
        false
    }

    ; getIntrinsicTagSymbol.
    ;
    ; ★★★ ITS MEMO IS A REPORT MEMO — AND THIS SLICE'S OWN CONTROL CORRECTED THE
    ; SENTENCE THAT STOOD HERE. It read *the function is asked twice about one
    ; element, so without the memo the same span appears twice*, naming
    ; `getIntrinsicAttributesTypeFromJsxOpeningLikeElement` and `getStaticTypeOf
    ; ReferencedJsxConstructor` as the two callers. g07 disables the READ and moves
    ; NOTHING on any of the fifteen instruments: the second caller sits behind
    ; `jsx-library-managed-attributes`, which fires on no unit of this corpus, so
    ; the function is asked exactly ONCE per node today. The memo is written anyway,
    ; for SymbolNodeLink's reason — **a stop must not change how many times a
    ; reporting routine runs**, and the day the second caller is wired is the day
    ; the report doubles without it. ★The write on the FAILURE path is the half that
    ; matters: `unknown_symbol` is what records *asked, and it was not there*.
    procedure get_intrinsic_tag_symbol(this, node: ref[AstNode], stopped: ref[bool]) returns ref[Symbol]?
    {
        let links this.symbol_node_link_of(node)
        if links.resolved_symbol <> null
            return links.resolved_symbol
        let mark this.unported_mark()
        let intrinsic_elements_type this.get_jsx_type("IntrinsicElements", node)
        if this.unported_mark() <> mark
        {
            set stopped: true
            return null
        }
        if intrinsic_elements_type = null
        {
            set stopped: true
            return null
        }
        let iet intrinsic_elements_type as ref[Type]
        if this.is_error_type(iet) = false
        {
            let tag_name AstNode.jsx_tag_name_of(node)
            var pd Slice[char]()
            if Checker.jsx_tag_name_text(this.host, tag_name as ref[AstNode], &pd) = false
            {
                ; `panic("Invalid tag name")` guards the kind; what stops here is the
                ; namespaced name's CONSTRUCTED text — see jsx_tag_name_text.
                this.record_unported("jsx-namespaced-tag-text", AstNode.kind_of(tag_name as ref[AstNode]))
                set stopped: true
                return null
            }
            let intrinsic_prop this.get_property_of_type(iet, pd)
            if this.unported_mark() <> mark
            {
                set stopped: true
                return null
            }
            if intrinsic_prop <> null
            {
                let el this.jsx_element_link_of(node)
                set el.jsx_flags: el.jsx_flags | JsxFlagsIntrinsicNamedElement
                set links.resolved_symbol: intrinsic_prop
                return links.resolved_symbol
            }
            ; "Intrinsic string indexer case" and the
            ; getTypeOfPropertyOrIndexSignatureOfType case under it. ★★★The note
            ; that stood here said `getApplicableIndexSymbol` *mints a symbol onto an
            ; IndexInfo slot this port's IndexInfo does not have*, and that was a
            ; hole rather than a wall: the slot is one field, every other piece
            ; (new_symbol_ex, the value link, isApplicableIndexType) was in the file.
            let key_lit this.get_string_literal_type(pd)
            let index_symbol this.get_applicable_index_symbol(iet, key_lit)
            if this.unported_mark() <> mark
            {
                set stopped: true
                return null
            }
            if index_symbol <> null
            {
                let el this.jsx_element_link_of(node)
                set el.jsx_flags: el.jsx_flags | JsxFlagsIntrinsicIndexedElement
                set links.resolved_symbol: index_symbol
                return links.resolved_symbol
            }
            let sig_type this.get_type_of_property_or_index_signature_of_type(iet, pd)
            if this.unported_mark() <> mark
            {
                set stopped: true
                return null
            }
            if sig_type <> null
            {
                let el this.jsx_element_link_of(node)
                set el.jsx_flags: el.jsx_flags | JsxFlagsIntrinsicIndexedElement
                set links.resolved_symbol: iet.symbol
                return links.resolved_symbol
            }
            ; "Wasn't found"
            this.error_on_node(node, DiagProperty_0_does_not_exist_on_type_1, Checker.arg_text(AstNode.identifier_text_of(AstNode.jsx_tag_name_of(node))), "JSX.IntrinsicElements")
            set links.resolved_symbol: unknown_symbol
            return links.resolved_symbol
        }
        if Checker.no_implicit_any()
            this.error_on_node(node, DiagJSX_element_implicitly_has_type_any_because_no_interface_JSX_0_exists, "IntrinsicElements")
        set links.resolved_symbol: unknown_symbol
        links.resolved_symbol
    }

    ; getIntrinsicAttributesTypeFromJsxOpeningLikeElement.
    procedure get_intrinsic_attributes_type_from_jsx_opening_like_element(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.jsx_element_link_of(node)
        if links.resolved_jsx_element_attributes_type <> null
            return links.resolved_jsx_element_attributes_type
        var stopped false
        let symbol this.get_intrinsic_tag_symbol(node, &stopped)
        if stopped
            return null
        if (links.jsx_flags & JsxFlagsIntrinsicNamedElement) <> 0
        {
            let mark this.unported_mark()
            var t: ref[Type]? null
            if symbol <> null
                set t: this.get_type_of_symbol(symbol as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            if t = null
                set t: error_type
            set links.resolved_jsx_element_attributes_type: t
            return links.resolved_jsx_element_attributes_type
        }
        if (links.jsx_flags & JsxFlagsIntrinsicIndexedElement) <> 0
        {
            ; `indexInfo := getApplicableIndexInfoForName(IntrinsicElements, tagName.Text())` — the
            ; string indexer's VALUE type is the attributes type of every unnamed intrinsic
            ; (the note that stood here said the bit could not be set; the tag resolver
            ; has set it since the indexer arm was ported)
            let mark this.unported_mark()
            let iet this.get_jsx_type("IntrinsicElements", node)
            if this.unported_mark() <> mark
                return null
            if iet <> null
            {
                let tag_name AstNode.jsx_tag_name_of(node)
                if tag_name <> null
                {
                    var pd Slice[char]()
                    if Checker.jsx_tag_name_text(this.host, tag_name as ref[AstNode], &pd)
                    {
                        let info this.get_applicable_index_info_for_name(iet as ref[Type], pd)
                        if this.unported_mark() <> mark
                            return null
                        if info <> null
                        {
                            set links.resolved_jsx_element_attributes_type: (info as ref[IndexInfo]).value_type
                            return links.resolved_jsx_element_attributes_type
                        }
                    }
                }
            }
        }
        set links.resolved_jsx_element_attributes_type: error_type
        links.resolved_jsx_element_attributes_type
    }

    ; getIntrinsicAttributesTypeFromStringLiteralType — `var CustomTag: "h1" = "h1"`.
    ; ★A nil answer means *this string is not an intrinsic element*, which the two
    ; callers turn into a report; `anyType` is the answer when there is no
    ; IntrinsicElements at all, because the report was already made.
    procedure get_intrinsic_attributes_type_from_string_literal_type(this, t: ref[Type], location: ref[AstNode], stopped: ref[bool]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let intrinsic_elements_type this.get_jsx_type("IntrinsicElements", location)
        if this.unported_mark() <> mark
        {
            set stopped: true
            return null
        }
        if intrinsic_elements_type = null
        {
            set stopped: true
            return null
        }
        let iet intrinsic_elements_type as ref[Type]
        if this.is_error_type(iet)
            return any_type
        let name_data Checker.literal_text_of(t)
        let name_len Checker.literal_text_length_of(t)
        let intrinsic_prop this.get_property_of_type(iet, name_data)
        if this.unported_mark() <> mark
        {
            set stopped: true
            return null
        }
        if intrinsic_prop <> null
        {
            let pt this.get_type_of_symbol(intrinsic_prop as ref[Symbol])
            if this.unported_mark() <> mark
            {
                set stopped: true
                return null
            }
            return pt
        }
        let index_signature_type this.get_index_type_of_type_ex(iet, string_type, null)
        if this.unported_mark() <> mark
        {
            set stopped: true
            return null
        }
        if index_signature_type <> null
            return index_signature_type
        null
    }

    ; createSignatureForJSXIntrinsic — the fake `(props: <attrs>) => JSX.Element`
    ; that stands in for an intrinsic tag's call signature. ★Its return type is
    ; errorType whenever `JSX.Element` is missing, which is the whole corpus minus
    ; eight units, and that is what a `<div />` answers.
    procedure create_signature_for_jsx_intrinsic(this, node: ref[AstNode], result: ref[Type]?) returns ref[Signature]?
    {
        let mark this.unported_mark()
        var element_type: ref[Type]? error_type
        let namespace this.get_jsx_namespace_at(node)
        if this.unported_mark() <> mark
            return null
        if namespace <> null
        {
            let exports this.get_exports_of_symbol(namespace as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            var stopped false
            let type_symbol this.lookup_in_table(exports, "Element", SymbolFlagsType, &stopped, false)
            if stopped
                return null
            if type_symbol <> null
            {
                set element_type: this.get_declared_type_of_symbol(type_symbol as ref[Symbol])
                if this.unported_mark() <> mark
                    return null
            }
        }
        let parameter_symbol this.new_symbol(SymbolFlagsFunctionScopedVariable, "props")
        set this.value_symbol_link_of(parameter_symbol).resolved_type: result
        let parameters this.new_symbol_list()
        parameters.add(parameter_symbol)
        this.new_signature(SignatureFlagsNone, null, null, null, parameters, element_type, 1)
    }

    ; ── getSpreadType, whole (slice 170) ───────────────────────────
    ;
    ; ★★★ IT IS PORTED HERE AND NOT IN THE OBJECT-LITERAL CHAPTER, because THIS is
    ; the caller that reaches it without a spread in the source: every JSX element
    ; with at least one attribute folds its attributes table through `getSpreadType`
    ; whether or not a `{...x}` appears. The object literal's own arm keeps its row,
    ; and that row is RETAGGED: its wall is no longer this function but
    ; `checkSpreadPropOverrides` and `isValidSpreadType` in front of it.
    ;
    ; ★★★ THE THREE ARMS THAT WERE ROWS UNTIL SLICE 170 ARE WHAT A `{...x}` REACHES,
    ; and the note that priced them was WRONG ABOUT ALL THREE. It read *the union
    ; and generic arms are rows rather than code* because a JSX attributes list
    ; hands this function an `emptyJsxObjectType` left — true, and it says nothing
    ; about what the arms COST: `try_merge_union_of_object_type_and_empty_object`
    ; had been ported IN FULL since slice 147 for the object literal's own remap
    ; and this function simply never called it, so the union row's whole content
    ; was a `map_type` kind; the generic arm is nine lines over three predicates
    ; that were all here; and the optional-property merge's `spreadLinks` pair —
    ; the reason the third row named the port's Symbol as the obstacle — has ONE
    ; reader in the whole reference and it is `services.go`'s `getRootSymbols`,
    ; which this port does not build. The slot is therefore NOT added, deliberately
    ; and on the mappedSymbolLinks precedent read the other way round: that table
    ; was merged into ValueSymbolLink because every ported reader asks the same
    ; question through `CheckFlagsMapped`, and this one has no ported reader to
    ; serve at all.
    procedure get_spread_type(this, left: ref[Type], right: ref[Type], symbol: ref[Symbol]?, object_flags: int, readonly: bool) returns ref[Type]?
    {
        if (left.flags & TypeFlagsAny) <> 0
            return any_type
        if (right.flags & TypeFlagsAny) <> 0
            return any_type
        if (left.flags & TypeFlagsUnknown) <> 0
            return unknown_type
        if (right.flags & TypeFlagsUnknown) <> 0
            return unknown_type
        if (left.flags & TypeFlagsNever) <> 0
            return right
        if (right.flags & TypeFlagsNever) <> 0
            return left
        let mark this.unported_mark()
        ; tryMergeUnionOfObjectTypeAndEmptyObject is the IDENTITY on a non-union —
        ; its first line — and it REPLACES the operand it is asked about, so both
        ; halves below read the merged type and not the argument.
        ;
        ; ★★ THE CROSS-PRODUCT GUARD'S FALSE ARM IS NOT REACHED HERE, and the
        ; `errorType` beside it is written for the day it is: `check_cross_product_union`
        ; records a stop of its own before answering false (its report is
        ; `c.error(c.currentNode, …)` and this port has no current node), so the mark
        ; test above the branch is what actually fires and the arm below is the
        ; reference's line kept in place.
        var l left
        let merged_left this.try_merge_union_of_object_type_and_empty_object(left, readonly)
        if this.unported_mark() <> mark
            return null
        if merged_left = null
            return null
        set l: merged_left as ref[Type]
        if (l.flags & TypeFlagsUnion) <> 0
        {
            let pair this.new_type_list_of(2)
            pair.add(l)
            pair.add(right)
            let ok this.check_cross_product_union(pair)
            if this.unported_mark() <> mark
                return null
            if ok = false
                return error_type
            var a_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, right, symbol, object_flags, readonly, null, null, 0, null, null, null, null, 0, 0)
            let a &a_value as ref[MapTypeArgs]?
            return this.map_type(l, MapTypeKindSpreadLeft, a)
        }
        var r right
        let merged_right this.try_merge_union_of_object_type_and_empty_object(right, readonly)
        if this.unported_mark() <> mark
            return null
        if merged_right = null
            return null
        set r: merged_right as ref[Type]
        if (r.flags & TypeFlagsUnion) <> 0
        {
            let pair this.new_type_list_of(2)
            pair.add(l)
            pair.add(r)
            let ok this.check_cross_product_union(pair)
            if this.unported_mark() <> mark
                return null
            if ok = false
                return error_type
            var a_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, l, symbol, object_flags, readonly, null, null, 0, null, null, null, null, 0, 0)
            let a &a_value as ref[MapTypeArgs]?
            return this.map_type(r, MapTypeKindSpreadRight, a)
        }
        ; "Spreading a primitive adds nothing" — the reference's own line, and the
        ; one arm of this function that answers without building anything.
        let primitive_right TypeFlagsBooleanLike | TypeFlagsNumberLike | TypeFlagsBigIntLike | TypeFlagsStringLike | TypeFlagsEnumLike | TypeFlagsNonPrimitive | TypeFlagsIndex
        if (r.flags & primitive_right) <> 0
