        set c.global_awaited_symbol_asked: false
        set c.global_extract_symbol: null
        set c.global_extract_symbol_asked: false
        let itc &Array[ref[IterationTypesLink]?]^host()
        set c.iteration_types_cache: itc
        set c.iteration_types_cache_chain: HashChain.create(host)
        let atl &Array[ref[AwaitedTypeLink]?]^host()
        set c.awaited_type_links: atl
        set c.awaited_type_links_index: AddressIndex.create(host)
        let ptl &Array[ref[PromisedTypeLink]?]^host()
        set c.promised_type_links: ptl
        set c.promised_type_links_index: AddressIndex.create(host)
        let ats &Array[ref[Type]?]^host()
        set c.awaited_type_stack: ats
        set c.awaited_type_depth: 0
        c.initialize_intrinsic_types()
        ; NewChecker mints its four singleton signatures right here, after the
        ; intrinsic types and before the globals, and slice 108 mints all four —
        ; see the field block for what reads each.
        set c.any_signature: c.new_signature(SignatureFlagsNone, null, null, null, null, c.any_type, 0)
        set c.unknown_signature: c.new_signature(SignatureFlagsNone, null, null, null, null, c.error_type, 0)
        set c.resolving_signature: c.new_signature(SignatureFlagsNone, null, null, null, null, c.any_type, 0)
        set c.silent_never_signature: c.new_signature(SignatureFlagsNone, null, null, null, null, c.silent_never_type, 0)
        ; ★★★ THE TEXT POINTER MUST BE REAL EVEN AT LENGTH ZERO, and getting that
        ; wrong cost four units. `get_string_literal_type` interns on (length,
        ; text) and its text comparison is vacuous at length 0, so a `null` here
        ; becomes THE interned `""` type for the whole compilation — and every
        ; later late-bound name `[""]` then carries a null name pointer, which
        ; made `var v = { [""]: 0 }` answer `any` plus a TS7005 the reference does
        ; not have. It surfaced only in the four computedPropertyNames units,
        ; because a string literal `""` as a VALUE never has its text read.
        let empty_text Slice[char](0, "")
        set c.empty_string_type: c.get_string_literal_type(empty_text)
        set c.zero_type: c.get_number_literal_type(Checker.number_bits_from_int(0))
        ; ★Same rule as empty_string_type above: the reference's zero BigInt is
        ; PseudoBigInt{} — an EMPTY base-10 string with a false sign — and the
        ; bigint table interns on (negative, length, text), so the pointer must be
        ; real even though the length is zero.
        set c.zero_big_int_type: c.get_bigint_literal_type(empty_text, false)
        set c.typeof_type: c.new_typeof_type()
        if checker_defer_initialize = false
            c.initialize_checker()
        c
    }

    procedure set_defer_initialize(defer: bool)
        set checker_defer_initialize: defer

    procedure set_trace_types(on: bool)
        set checker_trace_types: on

    ; ── the unported report ─────────────────────────────────────────────────
    ;
    ; The binder's mechanism, verbatim in intent: the FIRST report wins, so the
    ; tag names the construct that stopped the check rather than the last one
    ; noticed. `pos` is 0 rather than a real position for the same reason the
    ; binder's is — the dump's consumer wants the TAG, and a checker report is
    ; about a construct rather than about a place in the text.
    ; TSCALY_PROGRESS prints each program file as the driver starts checking it, so a
    ; long run that ends at a stop says how far it came
    function stats_enabled() returns bool
        getenv("TSCALY_STATS") <> null

    procedure report_stat(name: Slice[char], value: int)
    {
        let line String("stat `Parser.tag_text(name)` `value`")
        Console.println(line.to_c_string())
    }

    procedure report_progress(index: int, path: Slice[char])
    {
        if getenv("TSCALY_PROGRESS") = null
            return
        let line String("check `index` `Parser.tag_text(path)`")
        Console.println(line.to_c_string())
    }

    procedure record_unported(this, tag: Slice[char], detail: int)
    {
        ; Incremented OUTSIDE the first-wins guard, which is the whole point of it
        ; — see the field's own note. The LOG is appended outside it for the same
        ; reason, one notch further: the count says how many and the log says which.
        set unported_count: unported_count + 1
        ; TSCALY_DEBUG_STOPS prints every stop as it fires — the emit driver reports
        ; none of the checker's, and one hidden `cannot-find-global-type` cost a
        ; slice (§3.5jt 6)
        if getenv("TSCALY_DEBUG_STOPS") <> null
        {
            let stop_line String("stop `Parser.tag_text(tag)` `detail`")
            Console.println(stop_line.to_c_string())
        }
        let ev &StopEvent^host(tag, detail)
        stop_log.add(ev as ref[StopEvent])
        if unported_pos < 0
        {
            set unported_pos: 0
            set unported_tag: tag
            set unported_detail: detail
        }
    }

    function is_unported(this) returns bool
        unported_pos >= 0

    ; The monotone report count, for the callers that need *did THIS call stop*
    ; rather than *has this unit stopped*.
    function unported_mark(this) returns int
        unported_count

    ; ★★★ THE MARK WITHOUT THE LOG, and it exists for exactly one caller — see
    ; check_expression_cached_ex. A memoised nil must still MOVE the mark, because
    ; every `unported_mark` guard in this file reads *did anything stop under this
    ; call* and a cached incomplete answer is still incomplete; but it must NOT
    ; append to the log, because the log is the WORK LIST and the stop it stands
    ; for was logged the first time the node was checked. ★It is the one place
    ; where the count and the log deliberately disagree, which is the field's own
    ; note (*the count says how many and the log says which*) used rather than
    ; broken.
    procedure replay_stop_mark(this)
        set unported_count: unported_count + 1

    function unported_at(c: ref[Checker]) returns int
        c.unported_pos

    function unported_tag_at(c: ref[Checker]) returns Slice[char]
        c.unported_tag

    function unported_detail_at(c: ref[Checker]) returns int
        c.unported_detail

    ; ── the stop log's readers (slice 75) ───────────────────────────────────
