        if this.unported_mark() <> mark
            return false
        var target_is_optional false
        var source_is_optional false
        if name_data.data <> null
        {
            let tprop this.get_property_of_type(tuple_parts, name_data)
            if this.unported_mark() <> mark
                return false
            if tprop <> null
            {
                if (Symbol.flags_of(tprop as ref[Symbol]) & SymbolFlagsOptional) <> 0
                    set target_is_optional: true
            }
            let sprop this.get_property_of_type(source, name_data)
            if this.unported_mark() <> mark
                return false
            if sprop <> null
            {
                if (Symbol.flags_of(sprop as ref[Symbol]) & SymbolFlagsOptional) <> 0
                    set source_is_optional: true
            }
        }
        let tpt2 this.remove_missing_type(tpt, target_is_optional)
        if tpt2 = null
            return false
        set tpt: tpt2 as ref[Type]
        var both_optional false
        if target_is_optional
        {
            if source_is_optional
                set both_optional: true
        }
        let spt2 this.remove_missing_type(spt, both_optional)
        if spt2 = null
            return false
        set spt: spt2 as ref[Type]
        let result this.check_type_related_to_ex(specific_source, tpt, relation, prop, 0)
        if this.unported_mark() <> mark
            return false
        if result
        {
            if specific_source <> spt
            {
                let ignored this.check_type_related_to_ex(spt, tpt, relation, prop, 0)
                if this.unported_mark() <> mark
                    return false
            }
        }
        false
    }

    ; ── slice 119: the JSX element ───────────────────────────────────────────
    ;
    ; internal/checker/jsx.go, the file `tests/coverage.sh` reported at 0 % and
    ; `frontier.sh` at the top of its list. Its five entry points —
    ; `checkJsxElement`, `checkJsxSelfClosingElement`, `checkJsxFragment`,
    ; `checkJsxExpression` and `checkJsxAttributes` — are ONE chapter and not five:
    ; every one of them ends in `getJsxElementTypeAt`, and the two element kinds
    ; defer to a single `checkJsxOpeningLikeElementOrOpeningFragment`.
    ;
    ; ★★★ THE CHAPTER'S ANSWER IS `errorType` FOR ALMOST THE WHOLE CORPUS, AND THAT
    ; IS THE REFERENCE'S ANSWER RATHER THAN A STAND-IN. `getJsxType` answers
    ; `c.errorType` when the JSX namespace cannot be found, `TypeToString` prints an
    ; errorType as `any`, and this harness's lib set is `lib.es5.d.ts` alone — no
    ; React, no global `JSX`. So a unit's `T` lines for a JSX element read `any`
    ; because the REFERENCE could not find `JSX.Element` either. **What the chapter
    ; has to get right over this corpus is therefore mostly the DIAGNOSTICS**:
    ; TS17004 once per opening-like element or fragment, and TS7026 once per
    ; intrinsic tag whose `JSX.IntrinsicElements` does not exist.
    ;
    ; ★★★ THE JSX OPTIONS WERE CONSTANTS HERE UNTIL SLICE 255 and are the checker's
    ; `jsx_emit` and four option slices since. The checker yardstick's oracle sets
    ; `SkipDefaultLibCheck` and `NoErrorTruncation` and nothing else, so under it
    ; `checkJsxPreconditions`' first arm fires on EVERY opening-like node,
    ; `GetJSXTransformEnabled()` is false and `getJSXFragmentType` answers `anyType`;
    ; the emit driver sets the case's options, and the arms those constants hid are
    ; written (§3.5kb).
    ;
    ; ★★ THE SECOND ARM OF `checkJsxPreconditions` CANNOT FIRE, and that is a
    ; statement about `getJsxType` rather than about `noImplicitAny`. Its guard is
    ; `c.getJsxElementTypeAt(errorNode) == nil`; that function ends in `getJsxType`,
    ; whose miss is `c.errorType` — a type, never nil. So TS2602 has no input at all
    ; while `getJsxType` is its only producer. It is written as the reference writes
    ; it rather than dropped, because the day `getJsxElementTypeAt` grows a nil path
    ; is the day it becomes reachable, and a missing arm is invisible then.
    ;
    ; ★★ EIGHT UNITS OF THIS CORPUS DECLARE A REAL `namespace JSX`, so the intrinsic
    ; path is not hypothetical: `fixtures_binder_jsx_attributes.tsx` carries an
    ; `IntrinsicElements` with two members and reaches the type of every attribute
    ; it writes. That is why `createJsxAttributesTypeFromAttributesProperty` is
    ; ported whole rather than stubbed at its empty case.
    ;
    ; ★★★ WHAT IS DELIBERATELY NOT IN THIS SLICE, each with the chapter that owns it
    ; (§3.5v's *unreachable* row, not its *uncovered* one): `elaborateJsxComponents`
    ; and the three functions under it belong to the ELABORATOR, whose own head
    ; (`elaborate-object-literal`) stops for every object literal in 1 565 units;
    ; `inferJsxTypeArguments` needs an InferenceContext, which no part of this port
    ; has; `discriminateContextualTypeByJSXAttributes` needs the discriminator; and
    ; `getSuggestedSymbolForNonexistentJSXAttribute` needs the spelling suggester's
    ; JSX half. Each is a row here rather than a silence.

    ; ── the JSX namespace, and the types hanging off it ──────────────────────

    ; getJsxNamespaceAt, whole.
    ;
    ; ★★★ ITS MEMO HAS THREE STATES AND SKIPPING ONE WOULD RE-RUN A RESOLUTION THAT
    ; REPORTS. `links.jsxNamespace` is nil for *not yet asked*, `unknownSymbol` for
    ; *asked, and nothing in scope* and a real symbol otherwise; the middle state is
    ; what makes the second visit skip the `resolveName` and drop straight to the
    ; global fallback. It is SymbolNodeLink's rule read from the other side.
    ;
    ; ★ `location` may be null — `getJsxNamespaceAt(nil)` is how `getJsxType` is
    ; asked about no node in particular — and then there is no row to memoise into,
    ; which is what the reference's `links == nil` guards say.
    procedure get_jsx_namespace_at(this, location: ref[AstNode]?) returns ref[Symbol]?
    {
