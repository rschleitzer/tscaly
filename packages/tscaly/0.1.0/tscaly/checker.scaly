            set s.candidates_for_argument_error: this.new_signature_list()
        let list s.candidates_for_argument_error as ref[Array[ref[Signature]?]]
        list.add(candidate)
    }

    ; getCandidateForOverloadFailure. ★`hasCandidatesOutArray` is the constant
    ; FALSE here for resolve_call's own recorded reason, so the fork is decided by
