                {
                    let tps type_params as ref[Array[ref[Type]?]]
                    if tps.get_length() <> 0
                    {
                        ; "apply JSX.IntrinsicClassAttributes<hostClassType, ...>"
                        let host_class this.get_return_type_of_signature(sig)
                        if this.unported_mark() <> mark
                            return null
                        if host_class = null
                            return null
                        let one &Array[ref[Type]?]^host()
                        one.add(host_class)
                        let inferred this.fill_missing_type_arguments(one, tps, this.get_min_type_argument_count(tps), Parser.is_in_js_file(context))
                        if this.unported_mark() <> mark
                            return null
                        let inst this.instantiate_type(ic, this.new_type_mapper(tps, inferred))
                        if this.unported_mark() <> mark
                            return null
                        if inst = null
                            return null
                        set managed: inst as ref[Type]
                    }
                }
            }
            let folded this.intersect_types(managed, apparent)
            if this.unported_mark() <> mark
                return null
            if folded = null
                return null
            set apparent: folded as ref[Type]
        }
        let ia this.get_jsx_type("IntrinsicAttributes", context)
        if this.unported_mark() <> mark
            return null
        if ia = null
            return null
        if this.is_error_type(ia as ref[Type])
            return apparent
        let folded2 this.intersect_types(ia as ref[Type], apparent)
        if this.unported_mark() <> mark
            return null
        folded2
    }

    ; getJsxPropsTypeForSignatureFromMember. ★★★ THE COMPOSITE FORK INTERSECTS
    ; WHERE THE ORDINARY UNION SIGNATURE WOULD UNION, and upstream's own comment
    ; says why: the `props` member is read out of the signature's OUTPUT position
    ; while it is being used as an INPUT, so the union of the return types is the
    ; wrong direction. It goes back to the composite's own signatures and folds
    ; their `props` types with getIntersectionType. ★An `any` instance short-circuits
    ; the whole fold, and a MISSING member answers null for the caller to report.
    procedure get_jsx_props_type_for_signature_from_member(this, sig: ref[Signature], forced_lookup_location: Slice[char]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if sig.composite <> null
        {
            let comp sig.composite as ref[CompositeSignature]
            if comp.signatures = null
                return null
            let list comp.signatures as ref[Array[ref[Signature]?]]
            let n list.get_length() as int
            let results &Array[ref[Type]?]^host()
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return null
                let instance this.get_return_type_of_signature(row as ref[Signature])
                if this.unported_mark() <> mark
                    return null
                if instance = null
                    return null
                let inst instance as ref[Type]
                if Checker.is_type_any(inst)
                    return inst
                let prop_type this.get_type_of_property_of_type(inst, forced_lookup_location)
                if this.unported_mark() <> mark
                    return null
                if prop_type = null
                    return null
                results.add(prop_type)
                set i: i + 1
            }
            ; "Same result for both union and intersection signatures"
            return this.get_intersection_type(results)
        }
        let instance_type this.get_return_type_of_signature(sig)
        if this.unported_mark() <> mark
            return null
        if instance_type = null
            return null
        let it instance_type as ref[Type]
        if Checker.is_type_any(it)
            return it
        this.get_type_of_property_of_type(it, forced_lookup_location)
    }

    ; getLocalTypeParametersOfClassOrInterfaceOrTypeAlias and its append twin —
    ; checker.go, and they belong to the declared-type chapter; they are written
    ; here because getJsxPropsTypeFromClassType is the first caller this port has.
    procedure get_local_type_parameters_of_class_or_interface_or_type_alias(this, symbol: ref[Symbol]) returns ref[Array[ref[Type]?]]?
    {
        let mark this.unported_mark()
        var acc: ref[Array[ref[Type]?]]? null
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let node d as ref[AstNode]
                let k AstNode.kind_of(node)
                var takes false
                if k = KindInterfaceDeclaration
                    set takes: true
                if k = KindClassDeclaration
                    set takes: true
                if k = KindClassExpression
                    set takes: true
                if Checker.is_type_alias(node)
                    set takes: true
                if takes
                {
                    set acc: this.append_type_parameters(acc, AstNode.type_parameters_of(node))
                    if this.unported_mark() <> mark
                        return null
                }
            }
            set i: i + 1
        }
        acc
    }

    procedure get_jsx_props_type_from_call_signature(this, sig: ref[Signature], context: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        var props_type this.get_type_of_first_parameter_of_signature_with_fallback(sig, unknown_type)
        if this.unported_mark() <> mark
            return null
        if props_type = null
            return null
        let ns this.get_jsx_namespace_at(context)
        if this.unported_mark() <> mark
            return null
        set props_type: this.get_jsx_managed_attributes_from_located_attributes(context, ns, props_type as ref[Type])
        if this.unported_mark() <> mark
            return null
        if props_type = null
            return null
        let intrinsic_attribs this.get_jsx_type("IntrinsicAttributes", context)
        if this.unported_mark() <> mark
            return null
        if intrinsic_attribs = null
            return null
        if this.is_error_type(intrinsic_attribs as ref[Type])
            return props_type
        ; `c.intersectTypes(intrinsicAttribs, propsType)`. ★★The note that stood
        ; here — *nothing in this port mints an intersection type* — carried a
        ; premise that expired at slice 121, and `intersect_types` is code since
        ; 157; `tools/expiredstops.py` named it the same hour the helper landed.
        let intersected this.intersect_types(intrinsic_attribs, props_type)
        if this.unported_mark() <> mark
            return null
        intersected
    }

    ; getTypeOfFirstParameterOfSignatureWithFallback — checker.go, and it belongs to
    ; the signature chapter rather than to this one; it is written here because this
    ; is the first caller.
    procedure get_type_of_first_parameter_of_signature_with_fallback(this, sig: ref[Signature], fallback: ref[Type]) returns ref[Type]?
    {
        if Checker.symbol_count(sig.parameters) = 0
            return fallback
        this.get_type_at_position(sig, 0)
    }

    ; getJsxManagedAttributesFromLocatedAttributes. ★`JSX.LibraryManagedAttributes`
    ; is declared by exactly one unit of this corpus, and there as an ENUM — which
    ; is why the row below is reachable at all.
    procedure get_jsx_managed_attributes_from_located_attributes(this, context: ref[AstNode], ns: ref[Symbol]?, attributes_type: ref[Type]) returns ref[Type]?
    {
        var stopped false
        let managed_sym this.get_jsx_library_managed_attributes(ns, &stopped)
        if stopped
            return null
        if managed_sym = null
            return attributes_type
        let mark this.unported_mark()
        let ctor_type this.get_static_type_of_referenced_jsx_constructor(context)
        if this.unported_mark() <> mark
            return null
        if ctor_type = null
            return null
        let args &Array[ref[Type]?]^host()
        args.add(ctor_type)
        args.add(attributes_type)
        let result this.instantiate_alias_or_interface_with_defaults(managed_sym as ref[Symbol], args, Parser.is_in_js_file(context))
        if this.unported_mark() <> mark
            return null
        ; ★A null here is upstream's own fall-through and not a stop: the managed
        ; symbol exists but declares FEWER parameters than the two arguments, and
        ; then the located attributes type is the answer unchanged.
        if result = null
            return attributes_type
        result
    }

    ; getStaticTypeOfReferencedJsxConstructor — the CONSTRUCTOR side of the tag,
    ; which is what LibraryManagedAttributes takes as its first argument. Three
    ; forks: an opening fragment answers the fragment type, an intrinsic tag name
    ; answers a type built from a FAKE signature over the intrinsic attributes, and
    ; a tag whose expression types as a string literal takes the same fake route
    ; through the string-literal lookup. Everything else is the tag's own type.
    procedure get_static_type_of_referenced_jsx_constructor(this, context: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if AstNode.kind_of(context) = KindJsxOpeningFragment
            return this.get_jsx_fragment_type(context)
        let tag_name AstNode.jsx_tag_name_of(context)
        if tag_name = null
            return null
        if Checker.is_jsx_intrinsic_tag_name(tag_name)
        {
            let result this.get_intrinsic_attributes_type_from_jsx_opening_like_element(context)
            if this.unported_mark() <> mark
                return null
            if result = null
                return null
            let fake this.create_signature_for_jsx_intrinsic(context, result as ref[Type])
            if this.unported_mark() <> mark
                return null
            if fake = null
                return null
            return this.get_or_create_type_from_signature(fake as ref[Signature])
        }
        let tag_type this.check_expression_cached(tag_name as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if tag_type = null
            return null
        let tt tag_type as ref[Type]
        if (tt.flags & TypeFlagsStringLiteral) <> 0
        {
            var stopped false
            let result this.get_intrinsic_attributes_type_from_string_literal_type(tt, context, &stopped)
            if stopped
                return null
            if this.unported_mark() <> mark
                return null
            if result = null
                return error_type
            let fake this.create_signature_for_jsx_intrinsic(context, result as ref[Type])
            if this.unported_mark() <> mark
                return null
            if fake = null
                return null
            return this.get_or_create_type_from_signature(fake as ref[Signature])
        }
        tt
    }

    ; instantiateAliasOrInterfaceWithDefaults, at the ZERO-argument arity
    ; getJsxElementTypeTypeAt asks for. ★At that arity `fillMissingTypeArguments`
    ; answers an empty list for an alias and the alias's own declared type is the
    ; answer; for an INTERFACE the reference still builds a type reference, and that
    ; is the arm this port cannot take without the interface's type parameters.
    procedure instantiate_alias_or_interface_with_defaults(this, managed_sym: ref[Symbol], type_arguments: ref[Array[ref[Type]?]]?, in_java_script: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let declared this.get_declared_type_of_symbol(managed_sym)
        if this.unported_mark() <> mark
            return null
        if declared = null
            return null
        let d declared as ref[Type]
        ; ★The argument count is the whole condition on both arms: a declaration
        ; with FEWER parameters than the caller has arguments is skipped, and the
        ; null that falls out is the caller's cue to keep what it had.
        var arg_count 0
        if type_arguments <> null
            set arg_count: (type_arguments as ref[Array[ref[Type]?]]).get_length() as int
        if (Symbol.flags_of(managed_sym) & SymbolFlagsTypeAlias) <> 0
        {
            let params this.type_alias_link_of(managed_sym).type_parameters
            var param_count 0
            if params <> null
                set param_count: (params as ref[Array[ref[Type]?]]).get_length() as int
            if param_count >= arg_count
            {
                if params = null
                    return d
                ; nil type arguments are an empty list: the defaults are filled in
                var given: ref[Array[ref[Type]?]]? type_arguments
                if given = null
                    set given: this.new_type_list(null)
                let args this.fill_missing_type_arguments(given as ref[Array[ref[Type]?]], params as ref[Array[ref[Type]?]], arg_count, in_java_script)
                if this.unported_mark() <> mark
                    return null
                if args = null
                    return d
                if (args as ref[Array[ref[Type]?]]).get_length() = 0
                    return d
                return this.get_type_alias_instantiation(managed_sym, args, null)
            }
        }
        if (d.object_flags & ObjectFlagsClassOrInterface) <> 0
        {
            let tps this.interface_type_parameters_of(d)
            var tp_count 0
            if tps <> null
                set tp_count: (tps as ref[Array[ref[Type]?]]).get_length() as int
            if tp_count >= arg_count
            {
                if tps = null
                    return this.create_type_reference(d, null, ObjectFlagsNone)
                var given_i: ref[Array[ref[Type]?]]? type_arguments
                if given_i = null
                    set given_i: this.new_type_list(null)
                let args this.fill_missing_type_arguments(given_i as ref[Array[ref[Type]?]], tps as ref[Array[ref[Type]?]], arg_count, in_java_script)
                if this.unported_mark() <> mark
                    return null
                return this.create_type_reference(d, args, ObjectFlagsNone)
            }
        }
        null
    }

    ; ── the contextual types a JSX node asks for ─────────────────────────────

    ; tryGetTypeFromTypeNode — the annotation's type, or none.
    ; getContextualTypeForJsxExpression and getContextualTypeForJsxAttribute.
    procedure get_contextual_type_for_jsx_expression(this, node: ref[AstNode], context_flags: int) returns ref[Type]?
    {
        let parent AstNode.parent_node_of(node)
        if AstNode.is_jsx_attribute_like(parent)
            return this.get_contextual_type(node, context_flags)
        if Checker.kind_or_unknown(parent) = KindJsxElement
            return this.get_contextual_type_for_child_jsx_expression(parent as ref[AstNode], node, context_flags)
        null
    }

    ; getContextualTypeForChildJsxExpression. ★★★ THE NOTE THAT DEFERRED IT NAMED
    ; TWO CALLEES THAT WERE BOTH HERE (slice 158, §3.5eo): it read *it needs
    ; getTypeOfPropertyOfContextualType and mapTypeEx, neither of which is here* —
    ; slice 120 ported the first and slice 125 the second, and the row stood for
    ; thirty-eight slices after the later of the two.
    ;
    ; ★★★ THE INDEX IS AMONG THE SEMANTIC CHILDREN AND THE COUNT DECIDES WHETHER
    ; IT IS USED AT ALL: with ONE child the `children` property type IS the child's
    ; contextual type, and only with several does the child take the ELEMENT at its
    ; own index — which is why an array-like `children` type behaves differently in
    ; `<E>{a}</E>` and in `<E>{a}{b}</E>`.
    procedure get_contextual_type_for_child_jsx_expression(this, node: ref[AstNode], child: ref[AstNode], context_flags: int) returns ref[Type]?
    {
        let opening AstNode.jsx_element_opening_of(node)
        if opening = null
            return null
        let attributes AstNode.jsx_attributes_of(opening as ref[AstNode])
        if attributes = null
            return null
        let mark this.unported_mark()
        let attributes_type this.get_apparent_type_of_contextual_type(attributes as ref[AstNode], context_flags)
        if this.unported_mark() <> mark
            return null
        let ns this.get_jsx_namespace_at(node)
        if this.unported_mark() <> mark
            return null
        var children_stopped false
        var children_data Slice[char]()
        let children_name_found this.get_jsx_element_children_property_name(ns, &children_data, &children_stopped)
        if children_stopped
            return null
        if children_name_found = false
            return null
        if children_data.length = 0
            return null
        if attributes_type = null
            return null
        let at attributes_type as ref[Type]
        if Checker.is_type_any(at)
            return null
        let children AstNode.jsx_children_of(node)
        let real_count AstNode.semantic_jsx_child_count(children)
        var child_index 0 - 1
        var i 0
        while i < real_count
        {
            let row AstNode.semantic_jsx_child_at(children, i)
            if row <> null
            {
                if (row as ref[AstNode]) = child
                {
                    set child_index: i
                    set i: real_count
                    continue
                }
            }
            set i: i + 1
        }
        let child_field_type this.get_type_of_property_of_contextual_type(at, children_data)
        if this.unported_mark() <> mark
            return null
        if child_field_type = null
            return null
        if real_count = 1
            return child_field_type
        if child_index < 0
            return child_field_type
        var a_value MapTypeArgs(null, null, null, null, null, false, null, null, child_index, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
        let a &a_value as ref[MapTypeArgs]?
        this.map_type_ex(child_field_type as ref[Type], MapTypeKindJsxChildElement, a, true)
    }

    procedure get_contextual_type_for_jsx_attribute(this, attribute: ref[AstNode], context_flags: int) returns ref[Type]?
    {
        let parent AstNode.parent_node_of(attribute)
        if parent = null
            return null
        if AstNode.kind_of(attribute) = KindJsxAttribute
        {
            let mark this.unported_mark()
            let attributes_type this.get_apparent_type_of_contextual_type(parent as ref[AstNode], context_flags)
            if this.unported_mark() <> mark
                return null
            if attributes_type = null
                return null
            if Checker.is_type_any(attributes_type)
                return null
            ; ★The note that stood here — *getTypeOfPropertyOfContextualType, the
            ; contextual-type chapter's own head, which stops for every object
            ; literal in this corpus* — described slice 119's tree; slice 120 ported
            ; that function the next day and nothing came back to this arm.
            let name AstNode.name_of(attribute)
            if name = null
                return null
            let nm name as ref[AstNode]
            ; ★`attribute.Name().Text()` is Node.Text(), and for a
            ; JsxNamespacedName that is `namespace + ":" + name`. The note that
            ; stood here called that *a two-part string this port has no builder
            ; for* and stopped rather than passing `identifier_text_of`'s EMPTY
            ; slice — the second half of which is still the right instinct and the
            ; first is no longer true: `jsx_tag_name_text` builds exactly these
            ; bytes as of slice 162, so the lookup gets the name it needs.
            var nd Slice[char]()
            if Checker.jsx_tag_name_text(this.host, nm, &nd) = false
                return null
            return this.get_type_of_property_of_contextual_type(attributes_type as ref[Type], nd)
        }
        this.get_contextual_type(parent as ref[AstNode], context_flags)
    }

    ; getContextualJsxElementAttributesType.
    procedure get_contextual_jsx_element_attributes_type(this, node: ref[AstNode], context_flags: int) returns ref[Type]?
    {
        if AstNode.kind_of(node) = KindJsxOpeningElement
        {
            if context_flags <> ContextFlagsIgnoreNodeInferences
            {
                let parent AstNode.parent_node_of(node)
                if parent <> null
                {
                    let index this.find_contextual_node(parent as ref[AstNode], context_flags = ContextFlagsNone)
                    if index >= 0
                        return this.contextual_type_at(index)
                }
            }
        }
        this.get_contextual_type_for_argument_at_index(node, 0)
    }

    ; getContextualTypeForArgument, whole since slice 131. The index of the
    ; argument inside the effective argument list, and nil for a node that is not
    ; one of them — a CallExpression's own CALLEE reaches getContextualType with
    ; the call as its parent, and that is what the −1 answers.
    procedure get_contextual_type_for_argument(this, call_target: ref[AstNode], arg: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let args this.get_effective_call_arguments(call_target)
        if this.unported_mark() <> mark
            return null
        let n AstNode.list_count(args)
        var index 0 - 1
        var i 0
        while i < n
        {
            if AstNode.child_in_list(args, i) = arg
            {
                set index: i
                set i: n
            }
            set i: i + 1
        }
        if index < 0
            return null
        this.get_contextual_type_for_argument_at_index(call_target, index)
    }

    ; getContextualTypeForArgumentAtIndex, whole since slice 131 — the JSX arm was
    ; all slice 119 needed and the CALL arms are this slice's.
    ;
    ; ★★★ THE RESOLVING-SIGNATURE GUARD IS NOT AN OPTIMISATION AND IT IS THE REASON
    ; THIS FUNCTION IS WRITTEN THE WAY IT IS: the route here is
    ; `resolveJsxOpeningLikeElement` → `checkExpressionWithContextualType` on the
    ; attributes → `getContextualType` → back to this function, and without the
    ; guard the second `getResolvedSignature` on the same node recurses forever. The
    ; reference's answer is `anySignature`, whose first parameter type is the
    ; unknown fallback.
    ;
    ; ★ The IMPORT CALL's second argument is `getGlobalImportCallOptionsType()`;
    ; index 0 is `string` and index ≥ 2 is `any`.
    procedure get_contextual_type_for_argument_at_index(this, call_target: ref[AstNode], arg_index: int) returns ref[Type]?
    {
        if Parser.is_import_call(call_target)
        {
            if arg_index = 0
                return string_type
            if arg_index = 1
                return this.get_global_import_call_options_type()
            return any_type
        }
        let mark this.unported_mark()
        var signature: ref[Signature]? resolving_signature
        if this.signature_link_of(call_target).resolved_signature <> resolving_signature
        {
            set signature: this.get_resolved_signature(call_target, CheckModeNormal)
            if this.unported_mark() <> mark
                return null
            if signature = null
                return null
        }
        let sig signature as ref[Signature]
        if AstNode.is_jsx_opening_like_element(call_target)
        {
            if arg_index = 0
                return this.get_effective_first_argument_for_jsx_signature(sig, call_target)
        }
        var param_count 0
        if sig.parameters <> null
            set param_count: (sig.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
        let rest_index param_count - 1
        if Checker.signature_has_rest_parameter(sig)
        {
            if arg_index >= rest_index
            {
                if sig.parameters = null
                    return null
                let row (sig.parameters as ref[Array[ref[Symbol]?]])[rest_index]
                if row = null
                    return null
                let rest_type this.get_type_of_symbol(row as ref[Symbol])
                if this.unported_mark() <> mark
                    return null
                if rest_type = null
                    return null
                let offset this.get_number_literal_type(jsnum_from_int(arg_index - rest_index))
                return this.get_indexed_access_type_ex(rest_type as ref[Type], offset, AccessFlagsContextual, null, null)
            }
        }
        this.get_type_at_position(sig, arg_index)
    }

    ; checkApplicableSignatureForJsxCallLikeElement — the JSX half of
    ; isSignatureApplicable, and the only place a JSX element's attributes are
    ; RELATED to anything.
    ;
    ; ★★★ ITS ARITY GUARD IS A NO-OP IN THIS PORT AND THE REASON IS AN OMISSION
    ; THIS SLICE ALREADY NAMED. `checkTagNameDoesNotExpectTooManyArguments` walks
    ; the JSX FACTORY's signatures to see whether the factory can supply as many
    ; arguments as the component demands — and its fourth line is
    ; `factory := c.getJsxFactoryEntity(node); if factory == nil { return true }`.
    ; This port never mints `React.createElement` (see `get_jsx_namespace`'s note on
    ; the synthesized node), so the guard answers TRUE at that line for every input
    ; and TS6229 has no producer. The walk below it is written down to that line and
    ; no further: everything past it reads a factory that is not there.
    ;
    ; ★ The reference's first line — `if getJsxNamespaceContainerForImplicitImport
    ; (node) != nil { return true }` — is also constant here, and for the harness's
    ; reason rather than the port's.
    ; checkTagNameDoesNotExpectTooManyArguments, the closure of
    ; checkApplicableSignatureForJsxCallLikeElement. A function component's tag type is
    ; compared against what the JSX FACTORY's first parameter can call: the factory
    ; (`React.createElement`) must have a call signature whose first parameter has a
    ; signature accepting at least the tag's minimum argument count. Every early `true` is
    ; upstream's ("assume it fits"); TS6229 is reported at the tag name. ★The related
    ; information (`_0_is_declared_here`) produces no C line and is not written.
    procedure tag_name_does_not_expect_too_many_arguments(this, node: ref[AstNode], report_errors: bool) returns bool
    {
        let mark this.unported_mark()
        let implicit this.get_jsx_namespace_container_for_implicit_import(node)
        if this.unported_mark() <> mark
            return true
        if implicit <> null
            return true
        let k AstNode.kind_of(node)
        var opening false
        if k = KindJsxOpeningElement
            set opening: true
        if k = KindJsxSelfClosingElement
            set opening: true
        if opening = false
            return true
        let tag_name AstNode.jsx_tag_name_of(node)
        if tag_name = null
            return true
        if Checker.is_jsx_intrinsic_tag_name(tag_name)
            return true
        let tn tag_name as ref[AstNode]
        if AstNode.kind_of(tn) = KindJsxNamespacedName
            return true
        let tag_type this.check_expression(tn)
        if this.unported_mark() <> mark
            return true
        if tag_type = null
            return true
        let tag_call_signatures this.get_signatures_of_type(tag_type as ref[Type], SignatureKindCall)
        if this.unported_mark() <> mark
            return true
        let n_tag Checker.sig_count(tag_call_signatures)
        if n_tag = 0
            return true
        let factory this.get_jsx_factory_entity(node)
        if this.unported_mark() <> mark
            return true
        if factory = null
            return true
        let factory_symbol this.resolve_entity_name(factory as ref[AstNode], SymbolFlagsValue, true, false, node)
        if this.unported_mark() <> mark
            return true
        if factory_symbol = null
            return true
        let factory_type this.get_type_of_symbol(factory_symbol as ref[Symbol])
        if this.unported_mark() <> mark
            return true
        if factory_type = null
            return true
        let call_signatures this.get_signatures_of_type(factory_type as ref[Type], SignatureKindCall)
        if this.unported_mark() <> mark
            return true
        let n_call Checker.sig_count(call_signatures)
        if n_call = 0
            return true
        var has_first_param_signatures false
        var max_param_count 0
        var i 0
        while i < n_call
        {
            let row (call_signatures as ref[Array[ref[Signature]?]])[i]
            set i: i + 1
            if row = null
                continue
            let first_param this.get_type_at_position(row as ref[Signature], 0)
            if this.unported_mark() <> mark
                return true
            if first_param = null
                continue
            let signatures_of_param this.get_signatures_of_type(first_param as ref[Type], SignatureKindCall)
            if this.unported_mark() <> mark
                return true
            let n_param Checker.sig_count(signatures_of_param)
            var j 0
            while j < n_param
            {
                let prow (signatures_of_param as ref[Array[ref[Signature]?]])[j]
                set j: j + 1
                if prow = null
                    continue
                let param_sig prow as ref[Signature]
                set has_first_param_signatures: true
                let rest this.has_effective_rest_parameter(param_sig)
                if this.unported_mark() <> mark
                    return true
                if rest
                    return true
                let param_count this.get_parameter_count(param_sig)
                if param_count > max_param_count
                    set max_param_count: param_count
            }
        }
        if has_first_param_signatures = false
            return true
        var absolute_min_arg_count 1000000000
        var t 0
        while t < n_tag
        {
            let trow (tag_call_signatures as ref[Array[ref[Signature]?]])[t]
            set t: t + 1
            if trow = null
                continue
            let tag_required_arg_count this.get_min_argument_count(trow as ref[Signature])
            if this.unported_mark() <> mark
                return true
            if tag_required_arg_count < absolute_min_arg_count
                set absolute_min_arg_count: tag_required_arg_count
        }
        if absolute_min_arg_count <= max_param_count
            return true
        if report_errors
        {
            let tag_mark this.diagnostic_mark()
            this.error_on_node(tn, DiagTag_0_expects_at_least_1_arguments_but_the_JSX_factory_2_provides_at_most_3, this.entity_name_arg(tn), Checker.arg_int(absolute_min_arg_count), this.synthesized_entity_name_arg(factory as ref[AstNode]), Checker.arg_int(max_param_count))
            let tag_name_symbol this.get_symbol_at_location(tn, false)
            if this.unported_mark() <> mark
                return true
            if tag_name_symbol <> null
                this.related_info_since(tag_mark, Symbol.value_declaration_of(tag_name_symbol as ref[Symbol]), DiagX_0_is_declared_here, this.entity_name_arg(tn))
        }
        false
    }

    procedure check_applicable_signature_for_jsx_call_like_element(this, node: ref[AstNode], signature: ref[Signature], relation: int, check_mode: int, report_errors: bool) returns bool
    {
        let mark this.unported_mark()
        let param_type this.get_effective_first_argument_for_jsx_signature(signature, node)
        if this.unported_mark() <> mark
            return false
        if param_type = null
            return false
        let is_open_fragment AstNode.kind_of(node) = KindJsxOpeningFragment
        var attributes: ref[AstNode]? null
        var attributes_type: ref[Type]? null
        if is_open_fragment
            set attributes_type: this.create_jsx_attributes_type_from_attributes_property(node, CheckModeNormal)
        else
        {
            set attributes: AstNode.jsx_attributes_of(node)
            if attributes = null
                return false
            set attributes_type: this.check_expression_with_contextual_type(attributes as ref[AstNode], param_type as ref[Type], check_mode)
        }
        if this.unported_mark() <> mark
            return false
        if attributes_type = null
            return false
        ; ★The freshness strip under SkipContextSensitive. The stop that stood here
        ; said getRegularTypeOfObjectLiteral *has no writer here* — it is at
        ; get_regular_type_of_object_literal and has been since the object-literal
        ; chapter (§3.5eo).
        if (check_mode & CheckModeSkipContextSensitive) <> 0
        {
            let regular this.get_regular_type_of_object_literal(attributes_type as ref[Type])
            if this.unported_mark() <> mark
                return false
            if regular = null
                return false
            set attributes_type: regular
        }
        ; checkTagNameDoesNotExpectTooManyArguments — upstream's closure runs BEFORE the
        ; relation, and its check_expression of the TAG NAME is one of the reference's four
        ; checks of that expression per element (slice 211: the fourth TS2729 of
        ; `useBeforeDeclaration_jsx`). A false answer fails the candidate.
        if this.tag_name_does_not_expect_too_many_arguments(node, report_errors) = false
            return false
        if this.unported_mark() <> mark
            return false
        var error_node: ref[AstNode]? null
        if report_errors
        {
            if is_open_fragment
                set error_node: node
            else
                set error_node: AstNode.jsx_tag_name_of(node)
        }
        this.check_type_related_to_and_optionally_elaborate(attributes_type as ref[Type], param_type as ref[Type], relation, error_node, attributes, 0)
    }

    ; ast.IsJsxCallLike — an opening-like element or an opening FRAGMENT, which is
    ; the one predicate in this file that puts the fragment on the same side as the
    ; two element kinds.
    function is_jsx_call_like(n: ref[AstNode]?) returns bool
    {
        if AstNode.is_jsx_opening_like_element(n)
            return true
        AstNode.kind_of(n) = KindJsxOpeningFragment
    }

    ; ── the JSX grammar checks ───────────────────────────────────────────────

    ; checkGrammarJsxElement, checkGrammarJsxName and checkGrammarJsxExpression.
    ; ★checkGrammarJsxName's SECOND arm (TS2639) is behind `GetJSXTransformEnabled()`,
    ; written since slice 255; the first is a `PropertyAccessExpression` whose
    ; expression is a namespaced name, which the grammar of a tag name allows.
    procedure check_grammar_jsx_element(this, node: ref[AstNode]) returns bool
    {
        let ignored this.check_grammar_jsx_name(AstNode.jsx_tag_name_of(node))
        let ignored2 this.check_grammar_type_arguments(AstNode.type_arguments_of(node))
        let seen SymbolTable.create(host)
        let props AstNode.properties_of(AstNode.jsx_attributes_of(node))
        var i 0
        while i < AstNode.list_count(props)
        {
            let row AstNode.child_in_list(props, i)
            set i: i + 1
            if row = null
                continue
            let attr_node row as ref[AstNode]
            if AstNode.kind_of(attr_node) = KindJsxSpreadAttribute
                continue
            let name AstNode.name_of(attr_node)
            if name = null
                continue
            var nd Slice[char]()
            if Checker.jsx_tag_name_text(this.host, name as ref[AstNode], &nd) = false
            {
                ; Neither kind — nothing else can be an attribute name by grammar,
                ; so this is the unreachable arm rather than the namespaced one it
                ; used to be (jsx_tag_name_text builds those since slice 162).
                continue
            }
            if SymbolTable.get(seen, nd) <> null
                return this.grammar_error_on_node(name, DiagJSX_elements_cannot_have_multiple_attributes_with_the_same_name)
            SymbolTable.set_entry(host, seen, nd, unknown_symbol)
            let initializer AstNode.initializer_of(attr_node)
            if initializer <> null
            {
                if AstNode.kind_of(initializer as ref[AstNode]) = KindJsxExpression
                {
                    if AstNode.expression_of(initializer as ref[AstNode]) = null
                        return this.grammar_error_on_node(initializer, DiagJSX_attributes_must_only_be_assigned_a_non_empty_expression)
                }
            }
        }
        false
    }

    procedure check_grammar_jsx_name(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if AstNode.kind_of(n) = KindPropertyAccessExpression
        {
            let e AstNode.expression_of(n)
            if Checker.kind_or_unknown(e) = KindJsxNamespacedName
                return this.grammar_error_on_node(e, DiagJSX_property_access_expressions_cannot_include_JSX_namespace_names)
        }
        if AstNode.kind_of(n) = KindJsxNamespacedName
        {
            if this.jsx_transform_enabled()
            {
                let ns AstNode.namespaced_namespace_of(n)
                let ns_text Slice[char](AstNode.identifier_text_length_of(ns), AstNode.identifier_text_of(ns).data)
                if Checker.is_intrinsic_jsx_name(ns_text) = false
                    return this.grammar_error_on_node(n, DiagReact_components_cannot_include_JSX_namespace_names)
            }
        }
        false
    }

    ; scanner.IsIntrinsicJsxName: a lower-case first letter or a dash
    function is_intrinsic_jsx_name(name: Slice[char]) returns bool
    {
        if name.length = 0
            return false
        let c0 name[0] as int
        if (c0 >= ("a" as char) as int) and (c0 <= ("z" as char) as int)
            return true
        var i 0
        while i < (name.length as int)
        {
            if (name[i as size_t] as int) = ("-" as char) as int
                return true
            set i: i + 1
        }
        false
    }

    procedure check_grammar_jsx_expression(this, node: ref[AstNode]) returns bool
    {
        let e AstNode.expression_of(node)
        if e = null
            return false
        ; ast.IsCommaSequence over IsCommaExpression — one test, written at its
        ; only caller for §3.5br's reason.
        if AstNode.kind_of(e as ref[AstNode]) = KindBinaryExpression
        {
            if AstNode.binary_operator_kind(e as ref[AstNode]) = KindCommaToken
                return this.grammar_error_on_node(e, DiagJSX_expressions_may_not_use_the_comma_operator_Did_you_mean_to_write_an_array)
        }
        false
    }

    ; ── THE INFERENCE ENGINE (slice 122) ────────────────────────────────────
    ;
    ; internal/checker/inference.go, whole, plus the InferenceContext lifecycle
    ; internal/checker/checker.go declares beside it. The chapter behind
    ; `infer-type-arguments`, the fifth-largest row of the frontier at 708 units.
    ;
    ; ★★★ WHAT IS STOPPED HERE IS NAMED IN ONE PLACE SO THE NEXT SLICE FINDS IT.
    ; Every callee this file cannot reach is a `record_unported` at the line that
    ; wants it, and they fall into five chapters rather than twenty rows: the
    ; MAPPED type (its four accessors, inferToMappedType and the whole
    ; reverse-mapped family), the TEMPLATE LITERAL (inferTypesFromTemplateLiteralType),
    ; the SIMPLIFICATION of an indexed access or a conditional, the VARIANCE
    ; measurement (marker types), and the three signature helpers
    ; getBaseSignature / getErasedSignature / getTypePredicateOfSignature.

    ; newInferenceInfo. `priority` starts at MaxValue and `implied_arity` at -1,
    ; both of which are read as sentinels rather than as values.
    function new_inference_info(this, type_parameter: ref[Type]?) returns ref[InferenceInfo]
    {
        let cs &Array[ref[Type]?]^host()
        let cd &Array[int]^host()
        let cc &Array[ref[Type]?]^host()
        &InferenceInfo^host(type_parameter, cs, cd, cc, null, InferencePriorityMaxValue, true, false, 0 - 1)
    }

    ; cloneInferenceInfo — the three candidate lists are COPIED, which is the whole
    ; point of it: a cloned context must not append into the original's lists.
    function clone_inference_info(this, info: ref[InferenceInfo]) returns ref[InferenceInfo]
    {
        let cs &Array[ref[Type]?]^host()
        let cd &Array[int]^host()
        let cc &Array[ref[Type]?]^host()
        var i 0
        let n1 info.candidates.get_length() as int
        while i < n1
        {
            cs.add(info.candidates[i])
            set i: i + 1
        }
        set i: 0
        let n2 info.candidate_depths.get_length() as int
        while i < n2
        {
            cd.add(info.candidate_depths[i])
            set i: i + 1
        }
        set i: 0
        let n3 info.contra_candidates.get_length() as int
        while i < n3
        {
            cc.add(info.contra_candidates[i])
            set i: i + 1
        }
        &InferenceInfo^host(info.type_parameter, cs, cd, cc, info.inferred_type, info.priority, info.top_level, info.is_fixed, info.implied_arity)
    }

    ; clearCachedInferences.
    procedure clear_cached_inferences(inferences: ref[Array[ref[InferenceInfo]?]])
    {
        let n inferences.get_length() as int
        var i 0
        while i < n
        {
            let e inferences[i]
            if e <> null
            {
                let info e as ref[InferenceInfo]
                if info.is_fixed = false
                    set info.inferred_type: null
            }
            set i: i + 1
        }
    }

    function has_inference_candidates(info: ref[InferenceInfo]) returns bool
    {
        if (info.candidates.get_length() as int) <> 0
            return true
        (info.contra_candidates.get_length() as int) <> 0
    }

    function has_inference_candidates_or_default(info: ref[InferenceInfo]) returns bool
    {
        if Checker.has_inference_candidates(info)
            return true
        if info.type_parameter = null
            return false
        Checker.has_type_parameter_default(info.type_parameter as ref[Type])
    }

    ; hasOverlappingInferences and mergeInferences. Both belong to the relater's
    ; own use of an inference context (isRelatedToWorker over signature
    ; parameters), which is still a stop — they are written because they are this
    ; file's and cost four lines each, and because a helper written from the
    ; reference now is a transcription rather than a rediscovery later.
    function has_overlapping_inferences(a: ref[Array[ref[InferenceInfo]?]], b: ref[Array[ref[InferenceInfo]?]]) returns bool
    {
        let n a.get_length() as int
        var i 0
        while i < n
        {
            if i < (b.get_length() as int)
            {
                let ea a[i]
                let eb b[i]
                if ea <> null
                {
                    if eb <> null
                    {
                        if Checker.has_inference_candidates(ea as ref[InferenceInfo])
                        {
                            if Checker.has_inference_candidates(eb as ref[InferenceInfo])
                                return true
                        }
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    procedure merge_inferences(target: ref[Array[ref[InferenceInfo]?]], source: ref[Array[ref[InferenceInfo]?]])
    {
        let n target.get_length() as int
        var i 0
        while i < n
        {
            if i < (source.get_length() as int)
            {
                let et target[i]
                let es source[i]
                if et <> null
                {
                    if es <> null
                    {
                        if Checker.has_inference_candidates(et as ref[InferenceInfo]) = false
                        {
                            if Checker.has_inference_candidates(es as ref[InferenceInfo])
                                target.put(i as size_t, es)
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; getInferenceInfoForType. The name test is `TypeFlagsTypeVariable`, so an
    ; indexed access is not a candidate here and a `this` type parameter is.
    function get_inference_info_for_type(n: ref[InferenceState], t: ref[Type]?) returns ref[InferenceInfo]?
    {
        if t = null
            return null
        let ty t as ref[Type]
        if (ty.flags & TypeFlagsTypeVariable) = 0
            return null
        let list n.inferences
        let cnt list.get_length() as int
        var i 0
        while i < cnt
        {
            let e list[i]
            if e <> null
            {
                let info e as ref[InferenceInfo]
                if info.type_parameter = t
                    return info
            }
            set i: i + 1
        }
        null
    }

    ; ── the mapper factories this chapter needs ─────────────────────────────

    function new_array_to_single_type_mapper(this, sources: ref[Array[ref[Type]?]]?, target: ref[Type]?) returns ref[TypeMapper]
    {
        let p &TypeMapper^host(TypeMapperData.ArrayToSingle(ArrayToSingleTypeMapperData(sources, target)))
        p
    }

    function new_merged_type_mapper(this, m1: ref[TypeMapper]?, m2: ref[TypeMapper]?) returns ref[TypeMapper]
    {
        let p &TypeMapper^host(TypeMapperData.Merged(MergedTypeMapperData(m1, m2)))
        p
    }

    ; mergeTypeMappers — a nil first mapper is the identity, so the answer is m2.
    function merge_type_mappers(this, m1: ref[TypeMapper]?, m2: ref[TypeMapper]?) returns ref[TypeMapper]?
    {
        if m1 = null
            return m2
        this.new_merged_type_mapper(m1, m2) as ref[TypeMapper]?
    }

    function new_composite_type_mapper(this, m1: ref[TypeMapper]?, m2: ref[TypeMapper]?) returns ref[TypeMapper]
    {
        let p &TypeMapper^host(TypeMapperData.Composite(CompositeTypeMapperData(m1, m2)))
        p
    }

    ; combineTypeMappers — mergeTypeMappers' twin, one arm apart. The guard is the
    ; same one and the answer for a nil first mapper is the same m2; what differs
    ; is the arm it mints, and the difference is the whole content of the two
    ; records' headers.
    function combine_type_mappers(this, m1: ref[TypeMapper]?, m2: ref[TypeMapper]?) returns ref[TypeMapper]?
    {
        if m1 = null
            return m2
        this.new_composite_type_mapper(m1, m2) as ref[TypeMapper]?
    }

    ; ── the three mapping factories the mapped type needs (slice 125) ───────
    ;
    ; newSimpleTypeMapper, appendTypeMapping and prependTypeMapping. The last two
    ; are one line each upstream and the ORDER is the whole content: appended, the
    ; new mapping runs LAST and so sees what the existing mapper produced;
    ; prepended it runs FIRST. resolveMappedTypeMembers uses the appended form for
    ; the key type and instantiateMappedType the prepended one for the homomorphic
    ; variable, and swapping them is a wrong answer rather than a slower one.
    function new_deferred_type_mapper(this, sources: ref[Array[ref[Type]?]], node: ref[AstNode]) returns ref[TypeMapper]
    {
        let p &TypeMapper^host(TypeMapperData.Deferred(DeferredTypeMapperData(sources, node)))
        p
    }

    function new_simple_type_mapper(this, source: ref[Type]?, target: ref[Type]?) returns ref[TypeMapper]
    {
        let p &TypeMapper^host(TypeMapperData.Simple(SimpleTypeMapperData(source, target)))
        p
    }

    function append_type_mapping(this, m: ref[TypeMapper]?, source: ref[Type]?, target: ref[Type]?) returns ref[TypeMapper]
    {
        if m = null
            return this.new_simple_type_mapper(source, target)
        this.new_merged_type_mapper(m, this.new_simple_type_mapper(source, target))
    }

    function prepend_type_mapping(this, source: ref[Type]?, target: ref[Type]?, m: ref[TypeMapper]?) returns ref[TypeMapper]
    {
        if m = null
            return this.new_simple_type_mapper(source, target)
        this.new_merged_type_mapper(this.new_simple_type_mapper(source, target), m)
    }

    function new_inference_type_mapper(this, n: ref[InferenceContext]?, fixing: bool) returns ref[TypeMapper]
    {
        let p &TypeMapper^host(TypeMapperData.Inference(InferenceTypeMapperData(n, fixing)))
        p
    }

    ; newFunctionTypeMapper, slice 151. ★Called exactly twice, from the intrinsic
    ; init — see the field's note on why the two answers are kept rather than
    ; re-made.
    function new_function_type_mapper(this, worker: int) returns ref[TypeMapper]
    {
        let p &TypeMapper^host(TypeMapperData.Function(FunctionTypeMapperData(worker)))
        p
    }

    ; newBackreferenceMapper — every type parameter from `index` on maps to
    ; `unknown`. It exists so that a type parameter DEFAULT that names a later
    ; type parameter does not read an inference that is not made yet.
    function new_backreference_mapper(this, context: ref[InferenceContext], index: int) returns ref[TypeMapper]
    {
        let tps &Array[ref[Type]?]^host()
        let list context.inferences
        let n list.get_length() as int
        var i index
        while i < n
        {
            let e list[i]
            if e <> null
                tps.add((e as ref[InferenceInfo]).type_parameter)
            set i: i + 1
        }
        this.new_array_to_single_type_mapper(tps, unknown_type)
    }

    ; ── the InferenceContext lifecycle ──────────────────────────────────────

    procedure new_inference_context_worker(this, inferences: ref[Array[ref[InferenceInfo]?]], signature: ref[Signature]?, flags: int, compare_kind: int) returns ref[InferenceContext]
    {
        let sites &Array[ref[IntraExpressionSite]?]^host()
        let n &InferenceContext^host(inferences, signature, flags, compare_kind, null, null, null, null, null, sites)
        ; The two mappers are built AFTER the context and point back at it, which
        ; is the reference's own order and the reason they are not init parameters.
        set n.mapper: this.new_inference_type_mapper(n, true)
        set n.non_fixing_mapper: this.new_inference_type_mapper(n, false)
        n
    }

    procedure new_inference_context(this, type_parameters: ref[Array[ref[Type]?]]?, signature: ref[Signature]?, flags: int, compare_kind: int) returns ref[InferenceContext]
    {
        let list &Array[ref[InferenceInfo]?]^host()
        if type_parameters <> null
        {
            let tps type_parameters as ref[Array[ref[Type]?]]
            let n tps.get_length() as int
            var i 0
            while i < n
            {
                list.add(this.new_inference_info(tps[i]) as ref[InferenceInfo]?)
                set i: i + 1
            }
        }
        this.new_inference_context_worker(list, signature, flags, compare_kind)
    }

    procedure clone_inference_context(this, n: ref[InferenceContext]?, extra_flags: int) returns ref[InferenceContext]?
    {
        if n = null
            return null
        let ctx n as ref[InferenceContext]
        let list &Array[ref[InferenceInfo]?]^host()
        let src ctx.inferences
        let cnt src.get_length() as int
        var i 0
        while i < cnt
        {
            let e src[i]
            if e <> null
                list.add(this.clone_inference_info(e as ref[InferenceInfo]) as ref[InferenceInfo]?)
            set i: i + 1
        }
        this.new_inference_context_worker(list, ctx.signature, ctx.flags | extra_flags, ctx.compare_kind) as ref[InferenceContext]?
    }

    ; cloneInferredPartOfContext — only the inferences that HAVE candidates, and
    ; nil when there are none. Its one caller reads that nil as *nothing was
    ; inferred from the return type*.
    procedure clone_inferred_part_of_context(this, n: ref[InferenceContext]) returns ref[InferenceContext]?
    {
        let list &Array[ref[InferenceInfo]?]^host()
        let src n.inferences
        let cnt src.get_length() as int
        var i 0
        while i < cnt
        {
            let e src[i]
            if e <> null
            {
                let info e as ref[InferenceInfo]
                if Checker.has_inference_candidates(info)
                    list.add(this.clone_inference_info(info) as ref[InferenceInfo]?)
            }
            set i: i + 1
        }
        if (list.get_length() as int) = 0
            return null
        this.new_inference_context_worker(list, n.signature, n.flags, n.compare_kind) as ref[InferenceContext]?
    }

    procedure add_intra_expression_inference_site(this, n: ref[InferenceContext], node: ref[AstNode]?, t: ref[Type]?)
    {
        let site &IntraExpressionSite^host(node, t)
        n.intra_expression_sites.add(site as ref[IntraExpressionSite]?)
    }

    ; inferFromIntraExpressionSites. The list is cleared at the end whatever
    ; happened, exactly as upstream: a site is a one-shot.
    procedure infer_from_intra_expression_sites(this, n: ref[InferenceContext])
    {
        let sites n.intra_expression_sites
        let cnt sites.get_length() as int
        var i 0
        while i < cnt
        {
            let e sites[i]
            if e <> null
            {
                let site e as ref[IntraExpressionSite]
                if site.node <> null
                {
                    let node site.node as ref[AstNode]
                    let mark this.unported_mark()
                    var contextual: ref[Type]? null
                    if AstNode.kind_of(node) = KindMethodDeclaration
                    {
                        ; getContextualTypeForObjectLiteralMethod: nothing inside a
                        ; `with`, the object literal element's walk otherwise
                        if (AstNode.flags_of(node) & NodeFlagsInWithStatement) = 0
                            set contextual: this.get_contextual_type_for_object_literal_element(node, ContextFlagsNoConstraints)
                    }
                    if this.unported_mark() = mark
                    {
                        if AstNode.kind_of(node) <> KindMethodDeclaration
                            set contextual: this.get_contextual_type(node, ContextFlagsNoConstraints)
                        if this.unported_mark() = mark
                        {
                            if contextual <> null
                                this.infer_types(n.inferences, site.t, contextual, InferencePriorityNone, false)
                        }
                    }
                }
            }
            set i: i + 1
        }
        sites.clear()
    }

    function get_mapper_from_context(n: ref[InferenceContext]?) returns ref[TypeMapper]?
    {
        if n = null
            return null
        (n as ref[InferenceContext]).mapper
    }

    ; createOuterReturnMapper — the context's return mapper composed with a
    ; SNAPSHOT of its current inferences, memoised on the context.
    procedure create_outer_return_mapper(this, context: ref[InferenceContext]) returns ref[TypeMapper]?
    {
        if context.outer_return_mapper <> null
            return context.outer_return_mapper
        let cloned this.clone_inference_context(context, InferenceFlagsNone)
        if cloned = null
            return null
        var m (cloned as ref[InferenceContext]).mapper
        if context.return_mapper <> null
            set m: this.new_merged_type_mapper(context.return_mapper, m) as ref[TypeMapper]?
        set context.outer_return_mapper: m
        m
    }

    ; ── the predicates this chapter needs and did not have ──────────────────

    ; isNoInferType — `NoInfer<T>` is a substitution type with an `unknown`
    ; constraint, which is the whole representation.
    function is_no_infer_type(t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsSubstitution) = 0
            return false
        let c Checker.substitution_constraint_of(t)
        if c = null
            return false
        ((c as ref[Type]).flags & TypeFlagsUnknown) <> 0
    }

    procedure get_substitution_intersection(this, t: ref[Type]) returns ref[Type]?
    {
        if Checker.is_no_infer_type(t)
            return Checker.substitution_base_type_of(t)
        let pair &Array[ref[Type]?]^host()
        pair.add(Checker.substitution_constraint_of(t))
        pair.add(Checker.substitution_base_type_of(t))
        this.get_intersection_type(pair)
    }

    ; ── slice 136: THE SUBSTITUTION TYPE GETS A PRODUCER ─────────────────────
    ;
    ; newSubstitutionType, getOrCreateSubstitutionType, getSubstitutionType,
    ; getNoInferType and isNoInferTargetType.
    ;
    ; ★★★ EVERY READER OF A SUBSTITUTION TYPE WAS ALREADY HERE AND NOTHING COULD
    ; MAKE ONE. `is_no_infer_type`, `get_substitution_intersection`,
    ; `get_actual_type_variable`, the relation's Substitution arm, the inference's
    ; two, `compute_base_constraint`'s and `get_generic_object_flags`' — eleven
    ; sites reading a payload arm with no producer, and three of them carried a
    ; note saying so in as many words (`TypeFlagsSubstitution has no producer`,
    ; get_index_type's *"whose only producers are the conditional's true branch and
    ; NoInfer<T> itself"*, instantiate_type's stop). This is the producer, and it is
    ; what turns those eleven from inert transcription into live arms.
    procedure new_substitution_type(this, base_type: ref[Type], constraint: ref[Type]) returns ref[Type]
        this.new_type(TypeFlagsSubstitution, ObjectFlagsNone, null, TypeData.Substitution(SubstitutionTypeData(base_type, constraint)))

    ; getOrCreateSubstitutionType. The key is the reference's own pair of type ids,
    ; held as an entry and compared on IDENTITY of the two types — which is what
    ; the id pair stands for, since a Type is interned by every producer that makes
    ; one.
    procedure get_or_create_substitution_type(this, base_type: ref[Type], constraint: ref[Type]) returns ref[Type]
    {
        let n substitution_types.get_length() as int
        var i 0
        while i < n
        {
            let row substitution_types[i]
            set i: i + 1
            if row = null
                continue
            let e row as ref[SubstitutionEntry]
            if e.base_type = base_type
            {
                if e.constraint = constraint
                {
                    if e.t <> null
                        return e.t as ref[Type]
                }
            }
        }
        let made this.new_substitution_type(base_type, constraint)
        substitution_types.add(&SubstitutionEntry^host(base_type, constraint, made))
        made
    }

    ; getSubstitutionType. ★★★ THE THREE FOLDS ARE WHAT MAKE THE TYPE RARE, and
    ; they are why the intern table cannot be keyed on the answer: a constraint
    ; that is `any`/`unknown`, a constraint EQUAL to the base, or an `any` base all
    ; answer the BASE TYPE, so most calls mint nothing at all.
    procedure get_substitution_type(this, base_type: ref[Type], constraint: ref[Type]) returns ref[Type]
    {
        if (constraint.flags & TypeFlagsAnyOrUnknown) <> 0
            return base_type
        if constraint = base_type
            return base_type
        if (base_type.flags & TypeFlagsAny) <> 0
            return base_type
        this.get_or_create_substitution_type(base_type, constraint)
    }

    ; getNoInferType — `NoInfer<T>`. It goes through getOrCreateSubstitutionType
    ; DIRECTLY rather than through getSubstitutionType, and that is the whole
    ; representation: the constraint IS `unknown`, which the folding entry point
    ; would answer the base type for.
    procedure get_no_infer_type(this, t: ref[Type]) returns ref[Type]
    {
        if this.is_no_infer_target_type(t) = false
            return t
        this.get_or_create_substitution_type(t, unknown_type)
    }

    ; isNoInferTargetType. The reference's own comment names the design: *"a more
    ; conservative and predictable form of couldContainTypeVariables … we don't
    ; want to exhaustively examine all object type members"*.
    ;
    ; ★ The last disjunct masks Substitution OUT of Instantiable, so a substitution
    ; type is judged by the disjunct above it and never by this one.
    procedure is_no_infer_target_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnionOrIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(t)
            if types <> null
            {
                let l types as ref[Array[ref[Type]?]]
                let n l.get_length() as int
                var i 0
                while i < n
                {
                    let e l[i]
                    set i: i + 1
                    if e = null
                        continue
                    if this.is_no_infer_target_type(e as ref[Type])
                        return true
                }
            }
        }
        if (t.flags & TypeFlagsSubstitution) <> 0
        {
            if Checker.is_no_infer_type(t) = false
            {
                let base Checker.substitution_base_type_of(t)
                if base <> null
                {
                    if this.is_no_infer_target_type(base as ref[Type])
                        return true
                }
            }
        }
        if (t.flags & TypeFlagsObject) <> 0
        {
            if this.is_empty_anonymous_object_type(t) = false
                return true
        }
        if (t.flags & (TypeFlagsInstantiable & ~TypeFlagsSubstitution)) <> 0
        {
            if this.is_pattern_literal_type(t) = false
                return true
        }
        false
    }

    ; ★Both of these were STATIC until is_generic_mapped_type stopped being one.
    procedure is_non_generic_object_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsObject) = 0
            return false
        this.is_generic_mapped_type(t) = false
    }

    procedure every_type_is_non_generic_object(this, types: ref[Array[ref[Type]?]]) returns bool
    {
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e = null
                return false
            if this.is_non_generic_object_type(e as ref[Type]) = false
                return false
            set i: i + 1
        }
        true
    }

    ; hasEmptyObjectIntersection — `someType(t, …)` at its one predicate, written
    ; as the predicate rather than as a delegate (§3.9e).
    procedure has_empty_object_intersection(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.constituent_is_empty_object_intersection(row as ref[Type])
                    return true
            }
            return false
        }
        this.constituent_is_empty_object_intersection(t)
    }

    procedure constituent_is_empty_object_intersection(this, t: ref[Type]) returns bool
    {
        if t = unknown_empty_object_type
            return true
        if (t.flags & TypeFlagsIntersection) = 0
            return false
        let mark this.unported_mark()
        let base this.get_base_constraint_or_type(t)
        if this.unported_mark() <> mark
            return false
        if base = null
            return false
        this.is_empty_anonymous_object_type(base as ref[Type])
    }

    function is_literal_type(t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsBoolean) <> 0
            return true
        if (t.flags & TypeFlagsUnion) <> 0
        {
            if (t.flags & TypeFlagsEnumLiteral) <> 0
                return true
            let list Checker.union_types_of(t)
            if list = null
                return false
            let types list as ref[Array[ref[Type]?]]
            let n types.get_length() as int
            var i 0
            while i < n
            {
                let e types[i]
                if e = null
                    return false
                if Checker.is_unit_type(e as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        Checker.is_unit_type(t)
    }

    function is_object_or_array_literal_type(t: ref[Type]) returns bool
        (t.object_flags & (ObjectFlagsObjectLiteral | ObjectFlagsArrayLiteral)) <> 0

    ; isTypeSubtypeOf and isTypeStrictSubtypeOf — the relation under two of its
    ; five names. They are one line each and they belong to the relater; they are
    ; written here because getCommonSupertype is this file's and cannot answer
    ; without them.
    procedure is_type_subtype_of(this, source: ref[Type], target: ref[Type]) returns bool
        this.is_type_related_to(source, target, RelationSubtype)

    procedure is_type_strict_subtype_of(this, source: ref[Type], target: ref[Type]) returns bool
        this.is_type_related_to(source, target, RelationStrictSubtype)

    ; ── THE SIMPLIFICATION CHAPTER (slice 166) ───────────────────────────────
    ;
    ; getSimplifiedType and the six functions under it. The two arms that DO work
    ; are the indexed access and the conditional; everything else is the identity.
    ;
    ; ★★★ IT IS THE `writing` FLAG THAT MAKES THE CHAPTER TWO CHAPTERS, and the
    ; reference says why at the head of the indexed access: the flag *indicates
    ; that the type is the target of an assignment*, and every distribution in
    ; here flips between a UNION and an INTERSECTION on it. `T[A | B]` read is
    ; `T[A] | T[B]` — the value is one of them; written it is `T[A] & T[B]` —
    ; the slot must accept either. A port that carried one polarity would be
    ; right on every read and silently wrong on every assignment target.
    procedure get_simplified_type(this, t: ref[Type], writing: bool) returns ref[Type]?
    {
        if (t.flags & TypeFlagsIndexedAccess) <> 0
            return this.get_simplified_indexed_access_type(t, writing)
        if (t.flags & TypeFlagsConditional) <> 0
            return this.get_simplified_conditional_type(t, writing)
        t
    }

    ; getSimplifiedIndexedAccessType — the memo around the worker.
    ;
    ; ★★★ THE `t`-INTO-THE-SLOT BEFORE THE CALL IS THE RECURSION BRAKE AND NOT AN
    ; OPTIMISATION, and the worker's own first two lines are what need it: it
    ; simplifies the object type and the index type, either of which can be this
    ; access again. See SimplifiedIndexedAccessLink for the one divergence — the
    ; slot is CLEARED when the worker stops, because an in-progress `t` left
    ; behind would answer the identity at the next ask with no stop recorded.
    ;
    ; ★ `removeType(result, t)` is the reference's own line and its comment says
    ; what it is for: *if the simplification is a union type that includes t,
    ; remove t from the type* — a distribution over an index union can hand back
    ; a union one of whose constituents is the access we started from.
    procedure get_simplified_indexed_access_type(this, t: ref[Type], writing: bool) returns ref[Type]?
    {
        let link this.simplified_indexed_access_link_of(t)
        var cached: ref[Type]? link.for_reading
        if writing
            set cached: link.for_writing
        if cached <> null
        {
            if (cached as ref[Type]) = circular_constraint_type
                return t
            return cached
        }
        if writing
            set link.for_writing: t
        else
            set link.for_reading: t
        let mark this.unported_mark()
        let worked this.get_simplified_indexed_access_type_worker(t, writing)
        if this.unported_mark() <> mark
        {
            if writing
                set link.for_writing: null
            else
                set link.for_reading: null
            return null
        }
        if worked = null
            return null
        let result worked as ref[Type]
        if result = t
            return result
        let stripped this.remove_type(result, t)
        if this.unported_mark() <> mark
        {
            if writing
                set link.for_writing: null
            else
                set link.for_reading: null
            return null
        }
        if stripped = null
            return null
        if writing
            set link.for_writing: stripped
        else
            set link.for_reading: stripped
        stripped
    }

    ; getSimplifiedIndexedAccessTypeWorker — four transformations, tried in the
    ; reference's own order, and the fall-through is the access as it stands.
    ;
    ; ★★★ THE GUARD IN FRONT OF THE SECOND DISTRIBUTION IS LOAD-BEARING AND THE
    ; REFERENCE STATES IT: *only do the inner distributions if the index can no
    ; longer be instantiated to cause index distribution again*. Distributing the
    ; object over an index that is still instantiable would re-enter through the
    ; substituted index and the memo above would be answering an access that is
    ; not the one asked about.
    procedure get_simplified_indexed_access_type_worker(this, t: ref[Type], writing: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let object_source Checker.indexed_access_object_type_of(t)
        let index_source Checker.indexed_access_index_type_of(t)
        if object_source = null
            return null
        if index_source = null
            return null
        let simplified_object this.get_simplified_type(object_source as ref[Type], writing)
        if this.unported_mark() <> mark
            return null
        if simplified_object = null
            return null
        let object_type simplified_object as ref[Type]
        let simplified_index this.get_simplified_type(index_source as ref[Type], writing)
        if this.unported_mark() <> mark
            return null
        if simplified_index = null
            return null
        let index_type simplified_index as ref[Type]
        ; T[A | B] -> T[A] | T[B] (reading), T[A] & T[B] (writing).
        let over_index this.distribute_object_over_index_type(object_type, index_type, writing)
        if this.unported_mark() <> mark
            return null
        if over_index <> null
            return over_index
        if (index_type.flags & TypeFlagsInstantiable) = 0
        {
            ; (T | U)[K] -> T[K] | U[K] (reading), and & for the writing and the
            ; intersection cases.
            let over_object this.distribute_index_over_object_type(object_type, index_type, writing)
            if this.unported_mark() <> mark
                return null
            if over_object <> null
                return over_object
        }
        ; "A generic tuple type indexed by a number exists only when the index
        ; type doesn't select a fixed element." The whole number type takes every
        ; element; a narrower number-like index takes the non-fixed tail.
        if Checker.is_generic_tuple_type(object_type)
        {
            if (index_type.flags & TypeFlagsNumberLike) <> 0
            {
                var start 0
                if (index_type.flags & TypeFlagsNumber) = 0
                {
                    let tuple_target Checker.target_of(object_type)
                    if tuple_target = null
                        return null
                    set start: Checker.tuple_fixed_length_of(tuple_target as ref[Type])
                }
                let element this.get_element_type_of_slice_of_tuple_type(object_type, start, 0, writing, false)
                if this.unported_mark() <> mark
                    return null
                if element <> null
                    return element
            }
        }
        ; "If the object type is a mapped type { [P in K]: E }, where K is
        ; generic … instantiate E using a mapper that substitutes the index type
        ; for P." ★The index passed is the UNSIMPLIFIED one — the reference reads
        ; `t.AsIndexedAccessType().indexType` here and not the local, because the
        ; substitution is into the mapped type's own parameter and must carry the
        ; index the author wrote.
        ; ★ Both predicates can STOP and answer false, so each is bound and the
        ; mark asked before the answer is used — a stop that reads as *not a
        ; generic mapped type* would fall through to the identity below and
        ; record the wall nowhere.
        let generic_mapped this.is_generic_mapped_type(object_type)
        if this.unported_mark() <> mark
            return null
        if generic_mapped
        {
            let name_kind this.get_mapped_type_name_type_kind(object_type)
            if this.unported_mark() <> mark
                return null
            if name_kind <> MappedTypeNameTypeKindRemapping
            {
                let substituted this.substitute_indexed_mapped_type(object_type, index_source as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if substituted = null
                    return null
                var a_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, writing, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
                let a &a_value as ref[MapTypeArgs]?
                return this.map_type(substituted as ref[Type], MapTypeKindSimplified, a)
            }
        }
        t
    }

    ; distributeObjectOverIndexType — T[A | B] over the index union. ★null here
    ; means NOT APPLICABLE and not a stop; every caller asks the mark first,
    ; which is what separates the two in this file.
    procedure distribute_object_over_index_type(this, object_type: ref[Type], index_type: ref[Type], writing: bool) returns ref[Type]?
    {
        if (index_type.flags & TypeFlagsUnion) = 0
            return null
        let mark this.unported_mark()
        let members Checker.union_types_of(index_type)
        if members = null
            return null
        let list members as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let out &Array[ref[Type]?]()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let access this.get_indexed_access_type(object_type, row as ref[Type])
            if this.unported_mark() <> mark
                return null
            if access = null
                return null
            let simplified this.get_simplified_type(access as ref[Type], writing)
            if this.unported_mark() <> mark
                return null
            if simplified = null
                return null
            out.add(simplified)
        }
        if writing
            return this.get_intersection_type(out)
        this.get_union_type(out)
    }

    ; distributeIndexOverObjectType — (T | U)[K] and (T & U)[K].
    ;
    ; ★ The INTERSECTION half carries a guard the union half does not:
    ; shouldDeferIndexType. An intersection whose index type is deferred is one
    ; whose `keyof` cannot be resolved yet, and distributing it would decide the
    ; question the deferral exists to postpone.
    procedure distribute_index_over_object_type(this, object_type: ref[Type], index_type: ref[Type], writing: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var applies false
        if (object_type.flags & TypeFlagsUnion) <> 0
            set applies: true
        if (object_type.flags & TypeFlagsIntersection) <> 0
        {
            if this.should_defer_index_type(object_type, IndexFlagsNone) = false
                set applies: true
            if this.unported_mark() <> mark
                return null
        }
        if applies = false
            return null
        ; ★ `Types()` upstream is the UnionOrIntersection accessor, and this arm
        ; is reached from both — union_types_of alone answers null on every
        ; intersection, which would silently read as *not applicable*.
        let members Checker.union_or_intersection_types_of(object_type)
        if members = null
            return null
        let list members as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let out &Array[ref[Type]?]()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let access this.get_indexed_access_type(row as ref[Type], index_type)
            if this.unported_mark() <> mark
                return null
            if access = null
                return null
            let simplified this.get_simplified_type(access as ref[Type], writing)
            if this.unported_mark() <> mark
                return null
            if simplified = null
                return null
            out.add(simplified)
        }
        if (object_type.flags & TypeFlagsIntersection) <> 0
            return this.get_intersection_type(out)
        if writing
            return this.get_intersection_type(out)
        this.get_union_type(out)
    }

    ; getSimplifiedConditionalType — the two shapes `T extends U ? T : never` and
    ; `T extends U ? never : T`, and nothing else.
    ;
    ; ★★★ THE RELATION IT ASKS IS THE RESTRICTIVE ONE ON BOTH SIDES, and that is
    ; the whole reason the simplification is sound: a restrictive instantiation
    ; replaces every type parameter's constraint with `unknown`, so an assignable
    ; answer holds for EVERY instantiation of the conditional rather than for the
    ; one in hand. Asking `isTypeAssignableTo(checkType, extendsType)` directly
    ; would simplify a conditional whose branch depends on a type argument nobody
    ; has supplied yet.
    procedure get_simplified_conditional_type(this, t: ref[Type], writing: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let check_source Checker.conditional_check_type_of(t)
        let extends_source Checker.conditional_extends_type_of(t)
        if check_source = null
            return null
        if extends_source = null
            return null
        let check_type check_source as ref[Type]
        let extends_type extends_source as ref[Type]
        let true_source this.get_true_type_from_conditional_type(t)
        if this.unported_mark() <> mark
            return null
        if true_source = null
            return null
        let false_source this.get_false_type_from_conditional_type(t)
        if this.unported_mark() <> mark
            return null
        if false_source = null
            return null
        let true_type true_source as ref[Type]
        let false_type false_source as ref[Type]
        ; ★ getActualTypeVariable always answers upstream; here it can be null
        ; without a stop (a substitution whose base is missing), and TWO nulls
        ; would compare EQUAL and simplify a conditional that must not be
        ; simplified — so the identity is asked between unwrapped references.
        let check_variable this.get_actual_type_variable(check_type)
        if this.unported_mark() <> mark
            return null
        if check_variable = null
            return null
        let check_var check_variable as ref[Type]
        if (false_type.flags & TypeFlagsNever) <> 0
        {
            let true_variable this.get_actual_type_variable(true_type)
            if this.unported_mark() <> mark
                return null
            if true_variable = null
                return null
            if (true_variable as ref[Type]) = check_var
            {
                if (check_type.flags & TypeFlagsAny) <> 0
                    return this.get_simplified_type(true_type, writing)
                if this.restrictively_assignable(check_type, extends_type)
                {
                    if this.unported_mark() <> mark
                        return null
                    return this.get_simplified_type(true_type, writing)
                }
                if this.unported_mark() <> mark
                    return null
                if this.is_intersection_empty(check_type, extends_type)
                    return never_type
                if this.unported_mark() <> mark
                    return null
                return t
            }
        }
        if (true_type.flags & TypeFlagsNever) <> 0
        {
            let false_variable this.get_actual_type_variable(false_type)
            if this.unported_mark() <> mark
                return null
            if false_variable = null
                return null
            if (false_variable as ref[Type]) = check_var
            {
                if (check_type.flags & TypeFlagsAny) = 0
                {
                    if this.restrictively_assignable(check_type, extends_type)
                        return never_type
                    if this.unported_mark() <> mark
                        return null
                }
                var falls false
                if (check_type.flags & TypeFlagsAny) <> 0
                    set falls: true
                if falls = false
                {
                    if this.is_intersection_empty(check_type, extends_type)
                        set falls: true
                    if this.unported_mark() <> mark
                        return null
                }
                if falls
                    return this.get_simplified_type(false_type, writing)
                return t
            }
        }
        t
    }

    ; The `isTypeAssignableTo(getRestrictiveInstantiation(a), getRestrictiveInstantiation(b))`
    ; pair, written once because getSimplifiedConditionalType asks it twice.
    procedure restrictively_assignable(this, source: ref[Type], target: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        let rs this.get_restrictive_instantiation(source)
        if this.unported_mark() <> mark
            return false
        if rs = null
            return false
        let rt this.get_restrictive_instantiation(target)
        if this.unported_mark() <> mark
            return false
        if rt = null
            return false
        this.is_type_assignable_to(rs as ref[Type], rt as ref[Type])
    }

    ; isIntersectionEmpty — "invokes union simplification logic to determine if an
    ; intersection is considered empty as a union constituent". ★The union of the
    ; intersection with `never` is the whole test: getUnionType reduces it away
    ; unless the intersection itself is never.
    procedure is_intersection_empty(this, type1: ref[Type], type2: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        let both this.intersect_types(type1, type2)
        if this.unported_mark() <> mark
            return false
        if both = null
            return false
        let pair &Array[ref[Type]?]()
        pair.add(both)
        pair.add(never_type)
        let u this.get_union_type(pair)
        if this.unported_mark() <> mark
            return false
        if u = null
            return false
        ((u as ref[Type]).flags & TypeFlagsNever) <> 0
    }

    ; getVariances, at the arm that needs no measurement: an array, a readonly
    ; array and a TUPLE are known covariant, and the reference short-circuits them
    ; for exactly that reason. Everything else is getVariancesWorker, which
    ; compares instantiations of the generic type against MARKER types — a chapter
    ; with no floor under it here.
    ;
    ; ★★★ IT ANSWERS null RATHER THAN AN EMPTY LIST WHERE IT CANNOT MEASURE, AND
    ; THE DIFFERENCE IS NOT COSMETIC. `inferFromTypeArguments` reads a variance
    ; list positionally and treats a MISSING entry as covariant, so an empty list
    ; would make every type parameter of every generic interface silently
    ; covariant — right for most and wrong for an `in` parameter, with nothing to
    ; say so. The empty list IS a legitimate answer upstream (the recursive case),
    ; which is precisely why it may not double as *not measured*.
    procedure get_variances(this, t: ref[Type]) returns ref[Array[int]]?
    {
        var covariant false
        if (t.object_flags & ObjectFlagsTuple) <> 0
            set covariant: true
        if any_array_type <> null
        {
            if t = any_array_type as ref[Type]
                set covariant: true
        }
        if this.is_array_type(t)
            set covariant: true
        if covariant
        {
            let one &Array[int]^host()
            one.add(VarianceFlagsCovariant)
            return one
        }
        if t.symbol = null
            return null
        this.get_variances_worker(t.symbol as ref[Symbol], this.interface_type_parameters_of(t))
    }

    ; getAliasVariances — the same worker over the ALIAS's type parameters, which
    ; is the whole difference: an alias has no declared InterfaceType to read a
    ; list off, so the list comes from typeAliasLinks.
    procedure get_alias_variances(this, symbol: ref[Symbol]) returns ref[Array[int]]?
    {
        let link this.type_alias_link_of(symbol)
        this.get_variances_worker(symbol, link.type_parameters)
    }

    ; ── c.varianceLinks ─────────────────────────────────────────────────────

    procedure variance_link_of(this, sym: ref[Symbol]) returns ref[VarianceLink]
    {
        let ix variance_links_index
        let at ix.find(sym as int)
        if at > 0
        {
            let row variance_links[at - 1]
            if row <> null
                return row as ref[VarianceLink]
        }
        let fresh &VarianceLink^host(sym)
        variance_links.add(fresh)
        ix.insert(sym as int, (variance_links.get_length() as int) - 1)
        fresh
    }

    ; InterfaceType.TypeParameters() — allTypeParameters minus the trailing
    ; thisType. The COUNT of that list already had an accessor above; the LIST
    ; itself arrives with its first reader, which is the variance worker.
    function interface_type_parameters_of(this, t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        let all Checker.all_type_parameters_of(t)
        if all = null
            return null
        let list all as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        if n = 0
            return null
        let out &Array[ref[Type]?]^host()
        var i 0
        while i < (n - 1)
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    ; ── the three MARKER type parameters ────────────────────────────────────
    ;
    ; ★★★ THEY ARE CREATED LAZILY WHERE THE REFERENCE CREATES THEM IN
    ; `initializeChecker`, AND THE DIFFERENCE IS OBSERVABLE IN EXACTLY ONE PLACE
    ; THAT DOES NOT EXIST HERE: a type's `id` is drawn from a counter, so creating
    ; three type parameters eagerly shifts every later type's id by three. This
    ; port's type ids are compared by the type dump, so the lazy form is the one
    ; that keeps the artifact — and the markers are never printed, because they
    ; escape neither the worker nor the two reliability mappers.
    ;
    ; ★ markerSubType's CONSTRAINT is markerSuperType, which is the entire
    ; measurement: two otherwise indistinguishable type parameters standing in a
    ; known subtype relation. markerOtherType is constrained by nothing, so it is
    ; related to neither — which is how an INDEPENDENT type parameter is told from
    ; a bivariant one.
    ;
    ; ★ markerSuperTypeForCheck and markerSubTypeForCheck are the reference's
    ; fourth and fifth; their one reader is checkTypeParameterDeferred's variance
    ; ANNOTATION check (TS2636) and the node builder's naming of them. They
    ; arrived with it in slice 173 and are two accessors further down.
    procedure get_marker_super_type(this) returns ref[Type]
    {
        if marker_super_type <> null
            return marker_super_type as ref[Type]
        let tp this.new_type_parameter(null)
        set this.marker_super_type: tp
        tp
    }

    procedure get_marker_sub_type(this) returns ref[Type]
    {
        if marker_sub_type <> null
            return marker_sub_type as ref[Type]
        let sup this.get_marker_super_type()
        let tp this.new_type_parameter(null)
        Checker.set_type_parameter_constraint(tp, sup)
        set this.marker_sub_type: tp
        tp
    }

    procedure get_marker_other_type(this) returns ref[Type]
    {
        if marker_other_type <> null
            return marker_other_type as ref[Type]
        let tp this.new_type_parameter(null)
        set this.marker_other_type: tp
        tp
    }

    ; The FOURTH and FIFTH, lazily for the three above's reason and in the
    ; reference's own order: markerSubTypeForCheck's CONSTRAINT is
    ; markerSuperTypeForCheck, so asking for the sub mints the super first exactly
    ; as `initializeChecker`'s three consecutive lines do.
    procedure get_marker_super_type_for_check(this) returns ref[Type]
    {
        if marker_super_type_for_check <> null
            return marker_super_type_for_check as ref[Type]
        let tp this.new_type_parameter(null)
        set this.marker_super_type_for_check: tp
        tp
    }

    procedure get_marker_sub_type_for_check(this) returns ref[Type]
    {
        if marker_sub_type_for_check <> null
            return marker_sub_type_for_check as ref[Type]
        let sup this.get_marker_super_type_for_check()
        let tp this.new_type_parameter(null)
        Checker.set_type_parameter_constraint(tp, sup)
        set this.marker_sub_type_for_check: tp
        tp
    }

    ; isMarkerType — membership in c.markerTypes, the set createMarkerType fills.
    ; Its readers are the node builder and the relation's error reporting, neither
    ; of which is in this slice; it is written because createMarkerType's `Add` is,
    ; and a set with a writer and no reader is the shape §3.5be warns about only
    ; when the WRITER is speculative too.
    function is_marker_type(this, t: ref[Type]) returns bool
    {
        marker_type_index.find(t as int) > 0
    }

    ; createMarkerType — the generic type instantiated with ONE of its type
    ; parameters replaced by a marker.
    procedure create_marker_type(this, symbol: ref[Symbol], source: ref[Type], target: ref[Type]?) returns ref[Type]?
    {
        let m this.new_simple_type_mapper(source, target)
        let t this.get_declared_type_of_symbol(symbol)
        if t = null
            return null
        let dt t as ref[Type]
        if this.is_error_type(dt)
            return dt
        var result: ref[Type]? null
        if (symbol.flags & SymbolFlagsTypeAlias) <> 0
        {
            let link this.type_alias_link_of(symbol)
            set result: this.get_type_alias_instantiation(symbol, this.instantiate_types(link.type_parameters, m), null)
        }
        if (symbol.flags & SymbolFlagsTypeAlias) = 0
            set result: this.create_type_reference(dt, this.instantiate_types(this.interface_type_parameters_of(dt), m), ObjectFlagsNone)
        if result <> null
        {
            marker_types.add(result)
            marker_type_index.insert((result as ref[Type]) as int, (marker_types.get_length() as int) - 1)
        }
        result
    }

    ; getVariancesWorker, whole.
    ;
    ; ★★★ THE MEASUREMENT IS THE FUNCTION. For each type parameter it builds two
    ; instantiations of the generic type — one with the parameter replaced by
    ; markerSubType, one by markerSuperType — and asks which way round they are
    ; assignable: sub→super only is COVARIANT, super→sub only CONTRAVARIANT, both
    ; BIVARIANT, neither INVARIANT. A bivariant answer is then re-asked with
    ; markerOtherType, which is related to neither: if THAT is assignable too the
    ; parameter is not witnessed anywhere in the type at all, which is
    ; INDEPENDENT and is why `typeArgumentsRelatedTo` may skip its argument.
    ;
    ; ★★★ AN EXPLICIT `in`/`out` MODIFIER SHORT-CIRCUITS THE WHOLE MEASUREMENT,
    ; and that is not an optimisation: a declared variance is a CONTRACT the
    ; relation honours even where the structure says otherwise (the check that
    ; the two agree is TS2636, its own chapter).
    ;
    ; ★★★ THE RECURSION GUARD IS THE EMPTY LIST AND IT IS LOAD-BEARING, which is
    ; why VarianceLink carries `computing`. Measuring `Array<T>`'s variance
    ; compares two `Array<marker>`s, and comparing them asks for `Array<T>`'s
    ; variance again — the reference answers that inner call with the empty list
    ; it wrote before the loop, and `typeArgumentsRelatedTo` reads a missing entry
    ; as covariant. The empty answer is therefore the reference's intent and not
    ; a failure, and it must be told apart from *not measured*, which is null.
    procedure get_variances_worker(this, symbol: ref[Symbol], type_parameters: ref[Array[ref[Type]?]]?) returns ref[Array[int]]?
    {
        let links this.variance_link_of(symbol)
        if links.variances <> null
            return links.variances
        let old_variance_computation in_variance_computation
        let save_resolution_start resolution_start
        if in_variance_computation = false
        {
            set this.in_variance_computation: true
            set this.resolution_start: type_resolution_count
        }
        ; links.variances = []VarianceFlags{} — the guard, written BEFORE the loop
        ; exactly where the reference writes it.
        let guard &Array[int]^host()
        set links.variances: guard
        set links.computing: true
        let variances &Array[int]^host()
        var n 0
        if type_parameters <> null
            set n: (type_parameters as ref[Array[ref[Type]?]]).get_length() as int
        var i 0
        while i < n
        {
            let tpo (type_parameters as ref[Array[ref[Type]?]])[i]
            var variance VarianceFlagsInvariant
            if tpo <> null
            {
                let tp tpo as ref[Type]
                let modifiers this.get_type_parameter_modifiers(tp)
                if (modifiers & ModifierFlagsOut) <> 0
                {
                    set variance: VarianceFlagsCovariant
                    if (modifiers & ModifierFlagsIn) <> 0
                        set variance: VarianceFlagsInvariant
                }
                if (modifiers & ModifierFlagsOut) = 0
                {
                    if (modifiers & ModifierFlagsIn) <> 0
                        set variance: VarianceFlagsContravariant
                    if (modifiers & ModifierFlagsIn) = 0
                        set variance: this.measure_variance(symbol, tp)
                }
            }
            if variance = VarianceFlagsUnmeasured
            {
                ; The guard row stays in place — a re-entrant call still reads the
                ; empty list, which is the reference's own answer for it — but the
                ; ROW is cleared so a later, unblocked call measures again rather
                ; than inheriting a half answer.
                set links.variances: null
                set links.computing: false
                if old_variance_computation = false
                {
                    set this.in_variance_computation: false
                    set this.resolution_start: save_resolution_start
                }
                return null
            }
            variances.add(variance)
            set i: i + 1
        }
        if old_variance_computation = false
        {
            set this.in_variance_computation: false
            set this.resolution_start: save_resolution_start
        }
        set links.variances: variances
        set links.computing: false
        variances
    }

    ; The `default:` arm of getVariancesWorker's switch, lifted into a function
    ; of its own for the s178 alloca-pool rule: the loop above sits inside a body
    ; that already carries several locals, and the marker pair plus the two
    ; comparisons are four more.
    ; ★★★ IT ANSWERS THROUGH A MARK, AND WITHOUT THAT THE WALL WOULD HIDE A WRONG
    ; ANSWER (§3.5eb). The measurement IS two `is_type_assignable_to` calls; if
    ; anything under either of them stopped, the boolean it answered is not the
    ; reference's, and a variance derived from it is a silently wrong CONTRACT
    ; that the relation then honours everywhere the type is compared. So a moved
    ; mark makes the whole worker answer *not measured*, which is what the
    ; caller's null already means, and `measure_variance` says so by handing back
    ; the impossible bit combination the caller tests for.
    procedure measure_variance(this, symbol: ref[Symbol], tp: ref[Type]) returns int
    {
        let mark this.unported_mark()
        let save_reliability reliability_flags
        set this.reliability_flags: 0
        let type_with_super this.create_marker_type(symbol, tp, this.get_marker_super_type())
        let type_with_sub this.create_marker_type(symbol, tp, this.get_marker_sub_type())
        var variance VarianceFlagsInvariant
        if type_with_sub <> null
        {
            if type_with_super <> null
            {
                if this.is_type_assignable_to(type_with_sub as ref[Type], type_with_super as ref[Type])
                    set variance: variance | VarianceFlagsCovariant
                if this.is_type_assignable_to(type_with_super as ref[Type], type_with_sub as ref[Type])
                    set variance: variance | VarianceFlagsContravariant
            }
        }
        if variance = VarianceFlagsBivariant
        {
            let other this.create_marker_type(symbol, tp, this.get_marker_other_type())
            if other <> null
            {
                if type_with_super <> null
                {
                    if this.is_type_assignable_to(other as ref[Type], type_with_super as ref[Type])
                        set variance: VarianceFlagsIndependent
                }
            }
        }
        if (reliability_flags & RelationComparisonResultReportsUnmeasurable) <> 0
            set variance: variance | VarianceFlagsUnmeasurable
        if (reliability_flags & RelationComparisonResultReportsUnreliable) <> 0
            set variance: variance | VarianceFlagsUnreliable
        set this.reliability_flags: save_reliability
        if this.unported_mark() <> mark
            return VarianceFlagsUnmeasured
        variance
    }

    ; hasCovariantVoidArgument — *does this type reference have a `void` type
    ; argument in a covariant position*. Its one caller is recursiveTypeRelatedTo,
    ; where a covariant `void` argument forces the STRUCTURAL comparison: `void`
    ; is assignable to nothing structurally, so the variance-based shortcut would
    ; answer false where the reference wants the members compared.
    function has_covariant_void_argument(type_arguments: ref[Array[ref[Type]?]]?, variances: ref[Array[int]]?) returns bool
    {
        if variances = null
            return false
        if type_arguments = null
            return false
        let vs variances as ref[Array[int]]
        let args type_arguments as ref[Array[ref[Type]?]]
        let n vs.get_length() as int
        let m args.get_length() as int
        var i 0
        while i < n
        {
            if i < m
            {
                if (vs[i] & VarianceFlagsVarianceMask) = VarianceFlagsCovariant
                {
                    let a args[i]
                    if a <> null
                    {
                        if ((a as ref[Type]).flags & TypeFlagsVoid) <> 0
                            return true
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    ; strictFunctionTypes — the sixth strict-family option, and TRUE by the same
    ; derivation as the five above: an unset strict-family option falls through to
    ; `Strict != TSFalse`. Its one reader is
    ; infer_from_contravariant_types_if_strict_function_types, which is what makes
    ; a parameter position of a signature a CONTRAVARIANT inference.
    function strict_function_types() returns bool
        checker_strict_function_types

    ; isDeeplyNestedType against a stack the CALLER owns. The existing entry point
    ; reads the relater's two fixed-size stacks off the Checker; inference has its
    ; own pair on its own state, and the reverse-mapped family will have a third.
    ; The body is one function with the stack as a parameter, and the two-stack
    ; entry point above now chooses which one to hand it.
    procedure is_deeply_nested_type_in(this, t_in: ref[Type], stack: ref[Array[ref[Type]?]], start: int, depth: int, max_depth: int) returns bool
    {
        if depth - start < max_depth
            return false
        ; ★ Slice 160 adds the reference's two pre-passes, both inside the depth
        ; guard where it has them: an instantiated mapped type is *considered
        ; deeply nested if its target type is*, and an intersection *if any
        ; constituent is*.
        let t this.get_mapped_target_with_symbol(t_in)
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let list Checker.intersection_types_of(t)
            if list <> null
            {
                let types list as ref[Array[ref[Type]?]]
                let n types.get_length() as int
                var k 0
                while k < n
                {
                    let e types[k]
                    set k: k + 1
                    if e = null
                        continue
                    if this.is_deeply_nested_type_in(e as ref[Type], stack, start, depth, max_depth)
                        return true
                }
            }
        }
        let id this.get_recursion_identity(t)
        var count 0
        var last_type_id 0
        var i start
        while i < depth
        {
            let row stack[i]
            if row <> null
            {
                let st row as ref[Type]
                if this.has_matching_recursion_identity(st, &id)
                {
                    if st.id >= last_type_id
                    {
                        set count: count + 1
                        if count >= max_depth
                            return true
                    }
                    set last_type_id: st.id
                }
            }
            set i: i + 1
        }
        false
    }

    ; ── inferTypes and the walk ─────────────────────────────────────────────

    ; getInferenceState + putInferenceState, minus the pool — see InferenceState's
    ; header. The state is built on the Checker's page and dies with the walk.
    function new_inference_state(this, inferences: ref[Array[ref[InferenceInfo]?]], original_source: ref[Type]?, original_target: ref[Type]?, priority: int, contravariant: bool) returns ref[InferenceState]
    {
        let vs &Array[int]^host()
        let vt &Array[int]^host()
        let vp &Array[int]^host()
        let ss &Array[ref[Type]?]^host()
        let ts &Array[ref[Type]?]^host()
        &InferenceState^host(inferences, original_source, original_target, priority, InferencePriorityMaxValue, contravariant, false, ExpandingFlagsNone, null, vs, vt, vp, ss, ts, 0)
    }

    procedure infer_types(this, inferences: ref[Array[ref[InferenceInfo]?]], original_source: ref[Type]?, original_target: ref[Type]?, priority: int, contravariant: bool)
    {
        if original_source = null
            return
        if original_target = null
            return
        ; the walk's state is this routine's: nothing of it outlives the walk
        var vs Array[int]()
        var vt Array[int]()
        var vp Array[int]()
        var ss Array[ref[Type]?]()
        var ts Array[ref[Type]?]()
        var n_value InferenceState(inferences, original_source, original_target, priority, InferencePriorityMaxValue, contravariant, false, ExpandingFlagsNone, null, &vs, &vt, &vp, &ss, &ts, 0)
        this.infer_from_types(&n_value, original_source as ref[Type], original_target as ref[Type])
    }

    ; ── inferFromTypes, the dispatch ────────────────────────────────────────
    ;
    ; ★★★ THE HEAD IS A CHAIN OF REWRITES AND THE TAIL IS A `switch`, AND THE TWO
    ; HALVES ARE NOT INTERCHANGEABLE. Everything before the switch either RETURNS
    ; or narrows `source`/`target` in place — the union and intersection arms
    ; remove the constituents they matched and re-form the rest — so by the time
    ; the switch is reached the pair is the residue rather than the argument. The
    ; type-variable arm in between is where a candidate is actually recorded.
    ; inferToTemplateLiteralType, slice 126.
    ;
    ; ★★★ THE `never` FALLBACK IS THE POINT OF THE OUTER CONDITION AND THE
    ; REFERENCE EXPLAINS IT: when the target is nothing BUT placeholders and the
    ; matcher fails, inferring `never` for each is what makes the later assignment
    ; check FAIL. Making no inference at all would leave the constraint `string`,
    ; which on instantiation collapses every placeholder and the check would
    ; succeed — *a pointless and confusing outcome*.
    ;
    ; ★★ THE PREFERRED-TYPE SEARCH is the 30-arm `choose` closure, lifted into
    ; template_preferred_type: it runs only for a STRING LITERAL source against a
    ; TYPE VARIABLE target whose base constraint is neither `any` nor contains
    ; `string`, and it picks the constraint constituent the literal really belongs
    ; to so that `` `${"42"}` `` infers the NUMBER 42 where the constraint says
    ; number.
    procedure infer_to_template_literal_type(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        let mark this.unported_mark()
        var match_list Array[ref[Type]?]()
        let matched this.infer_types_from_template_literal_type(source, target, &match_list)
        if this.unported_mark() <> mark
            return
        let tty Checker.template_literal_types_of(target)
        if tty = null
            return
        let types tty as ref[Array[ref[Type]?]]
        var have_matches false
        if matched
        {
            if (match_list.get_length() as int) <> 0
                set have_matches: true
        }
        var all_texts_empty true
        let ttx Checker.template_literal_texts_of(target)
        if ttx = null
            return
        let texts ttx as ref[Array[ref[String]?]]
        let tn texts.get_length() as int
        var i 0
        while i < tn
        {
            let row texts[i]
            if row = null
                set all_texts_empty: false
            else
            {
                if ((row as ref[String]).get_length() as int) <> 0
                    set all_texts_empty: false
            }
            set i: i + 1
        }
        var proceed have_matches
        if all_texts_empty
            set proceed: true
        if proceed = false
            return
        let count types.get_length() as int
        set i: 0
        while i < count
        {
            let trow types[i]
            if trow = null
                return
            let tt trow as ref[Type]
            var src: ref[Type]? never_type
            if have_matches
            {
                let ml &match_list
                if i >= (ml.get_length() as int)
                    return
                set src: ml[i]
            }
            if src = null
                return
            let sv src as ref[Type]
            var inferred false
            if (sv.flags & TypeFlagsStringLiteral) <> 0
            {
                if (tt.flags & TypeFlagsTypeVariable) <> 0
                {
                    let info Checker.get_inference_info_for_type(n, tt)
                    if info <> null
                    {
                        let ii info as ref[InferenceInfo]
                        if ii.type_parameter = null
                            return
                        let constraint this.get_base_constraint_of_type(ii.type_parameter as ref[Type])
                        if this.unported_mark() <> mark
                            return
                        if constraint <> null
                        {
                            let cn constraint as ref[Type]
                            if Checker.is_type_any(cn) = false
                            {
                                let preferred this.template_preferred_type(sv, cn)
                                if this.unported_mark() <> mark
                                    return
                                if preferred <> null
                                {
                                    this.infer_from_types(n, preferred as ref[Type], tt)
                                    set inferred: true
                                }
                            }
                        }
                    }
                }
            }
            if inferred = false
                this.infer_from_types(n, sv, tt)
            if this.unported_mark() <> mark
                return
            set i: i + 1
        }
    }

    ; The preferred-type fold over the constraint's constituents. It answers null
    ; when the fold ends at `never`, which is the reference's *no preferred type,
    ; infer from the string literal itself*.
    procedure template_preferred_type(this, source: ref[Type], constraint: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        ; `allTypeFlags` over constraint.Distributed().
        var all_flags 0
        let parts this.distributed_types(constraint)
        let n parts.get_length() as int
        var i 0
        while i < n
        {
            let row parts[i]
            if row <> null
                set all_flags: all_flags | (row as ref[Type]).flags
            set i: i + 1
        }
        ; A constraint containing `string` needs no preferred type at all.
        if (all_flags & TypeFlagsString) <> 0
            return null
        let sd Checker.literal_text_of(source)
        let sn Checker.literal_text_length_of(source)
        if (all_flags & TypeFlagsNumberLike) <> 0
        {
            ; isValidNumberString(str, roundTripOnly: true) — the round trip is the
            ; half is_valid_number_string does not carry, so it is asked here.
            var ok Checker.is_valid_number_string(sd)
            if ok
            {
                var nb char[JSNUM_MAX_TEXT]
                let nn jsnum_to_string(jsnum_from_string(sd), Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
                if nn <> sn
                    set ok: false
                else
                {
                    if Checker.bytes_equal(Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]), 0, sd, 0, sn) = false
                        set ok: false
                }
            }
            if ok = false
                set all_flags: all_flags & ~TypeFlagsNumberLike
        }
        if (all_flags & TypeFlagsBigIntLike) <> 0
        {
            ; isValidBigIntString(str, roundTripOnly: true) — the round trip is
            ; what distinguishes this caller from the one above.
            if this.is_valid_big_int_string(sd, true) = false
                set all_flags: all_flags & ~TypeFlagsBigIntLike
        }
        var matching never_type
        set i: 0
        while i < n
        {
            let row parts[i]
            if row <> null
            {
                let picked this.template_choose_type(matching, row as ref[Type], source, sd, all_flags)
                if this.unported_mark() <> mark
                    return null
                if picked = null
                    return null
                set matching: picked as ref[Type]
            }
            set i: i + 1
        }
        if (matching.flags & TypeFlagsNever) <> 0
            return null
        matching
    }

    ; `Type.Distributed()` — a union's constituents, `never`'s nothing, and
    ; anything else itself.
    procedure distributed_types(this, t: ref[Type]) returns ref[Array[ref[Type]?]]
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let ts Checker.union_types_of(t)
            if ts <> null
                return ts as ref[Array[ref[Type]?]]
        }
        let out this.new_type_list(null)
        if (t.flags & TypeFlagsNever) <> 0
            return out
        out.add(t)
        out
    }

    ; The `choose` closure of inferToTemplateLiteralType, arm for arm and in the
    ; reference's own order — it is a FOLD, so `left` is what has been chosen so
    ; far and `right` the next constituent.
    procedure template_choose_type(this, left: ref[Type], right: ref[Type], source: ref[Type], s: Slice[char], all_flags: int) returns ref[Type]?
    {
        if (right.flags & all_flags) = 0
            return left
        if (left.flags & TypeFlagsString) <> 0
            return left
        if (right.flags & TypeFlagsString) <> 0
            return source
        if (left.flags & TypeFlagsTemplateLiteral) <> 0
            return left
        if (right.flags & TypeFlagsTemplateLiteral) <> 0
        {
            if this.is_type_matched_by_template_literal_type(source, right, SignatureComparerAssignable)
                return source
            return left
        }
        if (left.flags & TypeFlagsStringMapping) <> 0
            return left
        if (right.flags & TypeFlagsStringMapping) <> 0
        {
            ; `str == applyStringMapping(right.symbol, str)` — the mapping is
            ; chosen when it leaves the matched TEXT alone, i.e. when the text is
            ; already in that case.
            if right.symbol = null
                return left
            let kind Checker.intrinsic_type_kind(Symbol.name_of(right.symbol as ref[Symbol]))
            let mapped this.apply_string_mapping(kind, s)
            if (mapped.get_length() as int) <> (s.length as int)
                return left
            if Checker.bytes_equal(Slice[char](mapped.get_length() as int, mapped.get_buffer() as pointer[char]), 0, s, 0, s.length as int) = false
                return left
            return right
        }
        if (left.flags & TypeFlagsStringLiteral) <> 0
            return left
        if (right.flags & TypeFlagsStringLiteral) <> 0
        {
            if Checker.literal_text_length_of(right) = (s.length as int)
            {
                if Checker.bytes_equal(Checker.literal_text_of(right), 0, s, 0, s.length as int)
                    return right
            }
            return left
        }
        if (left.flags & TypeFlagsNumber) <> 0
            return left
        if (right.flags & TypeFlagsNumber) <> 0
            return this.get_number_literal_type(jsnum_from_string(s))
        if (left.flags & TypeFlagsEnum) <> 0
            return left
        if (right.flags & TypeFlagsEnum) <> 0
            return this.get_number_literal_type(jsnum_from_string(s))
        if (left.flags & TypeFlagsNumberLiteral) <> 0
            return left
        if (right.flags & TypeFlagsNumberLiteral) <> 0
        {
            if Checker.literal_bits_of(right) = jsnum_from_string(s)
                return right
            return left
        }
        if (left.flags & TypeFlagsBigInt) <> 0
            return left
        if (right.flags & TypeFlagsBigInt) <> 0
        {
            ; parseBigIntLiteralType — jsnum.ParseValidBigInt: an optional leading
            ; `-`, then ParsePseudoBigInt and the leading-zero trim, which is what
            ; pseudo_big_int_digits performs (slice 202). The digits are written
            ; onto the checker's page because the literal table keeps the view.
            var negative false
            var body s
            if s.length > 0
            {
                if (s[0] as int) = (("-" as char) as int)
                {
                    set negative: true
                    set body: s.slice_from(1)
                }
            }
            let cap ((body.length as int) + (body.length as int) / 4 + 4) as size_t
            let db host.allocate(cap, 1 as size_t) as pointer[char]
            var start 0
            let m Checker.pseudo_big_int_digits(body, Slice[char](cap, db), &start)
            if m < 0
                return left
            if m = 0
                set negative: false
            return this.get_bigint_literal_type(Slice[char](m as size_t, db + (start as size_t)), negative)
        }
        if (left.flags & TypeFlagsBigIntLiteral) <> 0
            return left
        if (right.flags & TypeFlagsBigIntLiteral) <> 0
        {
            let sb StringBuilder^host()
            Checker.write_pseudo_big_int(&sb, right)
            let txt sb.to_string()
            if (txt.get_length() as int) = (s.length as int)
            {
                if Checker.bytes_equal(Slice[char](txt.get_length(), txt.get_buffer() as pointer[char]), 0, s, 0, s.length as int)
                    return right
            }
            return left
        }
        if (left.flags & TypeFlagsBoolean) <> 0
            return left
        if (right.flags & TypeFlagsBoolean) <> 0
        {
            if Checker.name_is(s, "true")
                return true_type
            if Checker.name_is(s, "false")
                return false_type
            return boolean_type
        }
        if (left.flags & TypeFlagsBooleanLiteral) <> 0
            return left
        if (right.flags & TypeFlagsBooleanLiteral) <> 0
        {
            var matched Checker.name_is(s, "false")
            if Checker.literal_bool_of(right)
                set matched: Checker.name_is(s, "true")
            if matched
                return right
            return left
        }
        if (left.flags & TypeFlagsUndefined) <> 0
            return left
        if (right.flags & TypeFlagsUndefined) <> 0
        {
            if Checker.name_is(s, Checker.intrinsic_name_of(right))
                return right
            return left
        }
        if (left.flags & TypeFlagsNull) <> 0
            return left
        if (right.flags & TypeFlagsNull) <> 0
        {
            if Checker.name_is(s, Checker.intrinsic_name_of(right))
                return right
            return left
        }
        left
    }

    procedure infer_from_types(this, n: ref[InferenceState], source_in: ref[Type], target_in: ref[Type])
    {
        var source source_in
        var target target_in
        let mark this.unported_mark()
        let could this.could_contain_type_variables(target)
        if this.unported_mark() <> mark
            return
        if could = false
            return
        if Checker.is_no_infer_type(target)
            return
        if source = wildcard_type
        {
            let save n.propagation_type
            set n.propagation_type: source
            this.infer_from_types(n, target, target)
            set n.propagation_type: save
            return
        }
        if source = blocked_string_type
        {
            let save n.propagation_type
            set n.propagation_type: source
            this.infer_from_types(n, target, target)
            set n.propagation_type: save
            return
        }
        ; The two types come from the same generic type ALIAS: infer argument for
        ; argument with defaults filled in, and nothing else.
        if source.alias_symbol <> null
        {
            if target.alias_symbol <> null
            {
                if source.alias_symbol = target.alias_symbol
                {
                    var have_args false
                    if source.alias_type_arguments <> null
                    {
                        if ((source.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                            set have_args: true
                    }
                    if target.alias_type_arguments <> null
                    {
                        if ((target.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                            set have_args: true
                    }
                    ; ★★★ "Source and target are types originating in the same
                    ; generic type alias declaration. Simply infer from source type
                    ; arguments to target type arguments, with defaults applied."
                    ; The stop that stood here said the variance measurement was
                    ; one *this port has none of* — slice 130 measured it, and
                    ; get_alias_variances is its entry point (§3.5eo).
                    if have_args
                    {
                        let alias_sym source.alias_symbol as ref[Symbol]
                        let params this.type_alias_link_of(alias_sym).type_parameters
                        if params = null
                            return
                        let ps params as ref[Array[ref[Type]?]]
                        let min_params this.get_min_type_argument_count(ps)
                        var is_js false
                        let vd Symbol.value_declaration_of(alias_sym)
                        if vd <> null
                        {
                            if Parser.is_in_js_file(vd as ref[AstNode])
                                set is_js: true
                        }
                        if source.alias_type_arguments = null
                            return
                        if target.alias_type_arguments = null
                            return
                        let source_types this.fill_missing_type_arguments(source.alias_type_arguments as ref[Array[ref[Type]?]], ps, min_params, is_js)
                        let target_types this.fill_missing_type_arguments(target.alias_type_arguments as ref[Array[ref[Type]?]], ps, min_params, is_js)
                        let variances this.get_alias_variances(alias_sym)
                        if this.unported_mark() <> mark
                            return
                        this.infer_from_type_arguments(n, source_types, target_types, variances)
                    }
                    return
                }
            }
        }
        ; Source and target are the SAME union or intersection: relate each
        ; constituent to itself, which is how the propagation type above reaches
        ; every type variable inside a wildcard source.
        if source = target
        {
            if (source.flags & TypeFlagsUnionOrIntersection) <> 0
            {
                var list Checker.union_types_of(source)
                if list = null
                    set list: Checker.intersection_types_of(source)
                if list <> null
                {
                    let types list as ref[Array[ref[Type]?]]
                    let cnt types.get_length() as int
                    var i 0
                    while i < cnt
                    {
                        let e types[i]
                        if e <> null
                        {
                            this.infer_from_types(n, e as ref[Type], e as ref[Type])
                            if this.unported_mark() <> mark
                                return
                        }
                        set i: i + 1
                    }
                }
                return
            }
        }
        if (target.flags & TypeFlagsUnion) <> 0
        {
            let source_types &Array[ref[Type]?]^host()
            if (source.flags & TypeFlagsUnion) <> 0
            {
                let list Checker.union_types_of(source)
                if list <> null
                {
                    let types list as ref[Array[ref[Type]?]]
                    let cnt types.get_length() as int
                    var i 0
                    while i < cnt
                    {
                        source_types.add(types[i])
                        set i: i + 1
                    }
                }
            }
            else
                source_types.add(source)
            let target_list Checker.union_types_of(target)
            if target_list = null
                return
            let target_types &Array[ref[Type]?]^host()
            let tl target_list as ref[Array[ref[Type]?]]
            let tcnt tl.get_length() as int
            var ti 0
            while ti < tcnt
            {
                target_types.add(tl[ti])
                set ti: ti + 1
            }
            ; Two passes, and the ORDER is the specification: identical (or
            ; base-identical) constituents first, then instantiations of the same
            ; object type or alias. Each pass infers from the pairs it matched and
            ; removes them.
            var temp_sources: ref[Array[ref[Type]?]]? null
            var temp_targets: ref[Array[ref[Type]?]]? null
            this.infer_from_matching_types(n, source_types, target_types, 0, &temp_sources, &temp_targets)
            if this.unported_mark() <> mark
                return
            if temp_sources = null
                return
            if temp_targets = null
                return
            var sources: ref[Array[ref[Type]?]]? null
            var targets: ref[Array[ref[Type]?]]? null
            this.infer_from_matching_types(n, temp_sources as ref[Array[ref[Type]?]], temp_targets as ref[Array[ref[Type]?]], 1, &sources, &targets)
            if this.unported_mark() <> mark
                return
            if sources = null
                return
            if targets = null
                return
            let src_left sources as ref[Array[ref[Type]?]]
            let tgt_left targets as ref[Array[ref[Type]?]]
            if (tgt_left.get_length() as int) = 0
                return
            let ut this.get_union_type(tgt_left)
            if this.unported_mark() <> mark
                return
            if ut = null
                return
            set target: ut as ref[Type]
            if (src_left.get_length() as int) = 0
            {
                ; Everything on the source side matched. Making no inference at
                ; all would end up inferring a CONSTRAINT, so the whole source
                ; goes to whatever is left of the target at the naked-type-variable
                ; priority instead.
                this.infer_with_priority(n, source, target, InferencePriorityNakedTypeVariable)
                return
            }
            let us this.get_union_type(src_left)
            if this.unported_mark() <> mark
                return
            if us = null
                return
            set source: us as ref[Type]
        }
        else
        {
            if (target.flags & TypeFlagsIntersection) <> 0
            {
                let tlist Checker.intersection_types_of(target)
                var reduce false
                if tlist <> null
                {
                    if this.every_type_is_non_generic_object(tlist as ref[Array[ref[Type]?]]) = false
                        set reduce: true
                }
                if reduce
                {
                    if (source.flags & TypeFlagsUnion) = 0
                    {
                        let source_types &Array[ref[Type]?]^host()
                        if (source.flags & TypeFlagsIntersection) <> 0
                        {
                            let list Checker.intersection_types_of(source)
                            if list <> null
                            {
                                let types list as ref[Array[ref[Type]?]]
                                let cnt types.get_length() as int
                                var i 0
                                while i < cnt
                                {
                                    source_types.add(types[i])
                                    set i: i + 1
                                }
                            }
                        }
                        else
                            source_types.add(source)
                        let target_types &Array[ref[Type]?]^host()
                        let tl tlist as ref[Array[ref[Type]?]]
                        let tcnt tl.get_length() as int
                        var ti 0
                        while ti < tcnt
                        {
                            target_types.add(tl[ti])
                            set ti: ti + 1
                        }
                        var sources: ref[Array[ref[Type]?]]? null
                        var targets: ref[Array[ref[Type]?]]? null
                        this.infer_from_matching_types(n, source_types, target_types, 2, &sources, &targets)
                        if this.unported_mark() <> mark
                            return
                        if sources = null
                            return
                        if targets = null
                            return
                        let sl sources as ref[Array[ref[Type]?]]
                        let tll targets as ref[Array[ref[Type]?]]
                        if (sl.get_length() as int) = 0
                            return
                        if (tll.get_length() as int) = 0
                            return
                        let si this.get_intersection_type(sl)
                        if this.unported_mark() <> mark
                            return
                        if si = null
                            return
                        let tiy this.get_intersection_type(tll)
                        if this.unported_mark() <> mark
                            return
                        if tiy = null
                            return
                        set source: si as ref[Type]
                        set target: tiy as ref[Type]
                    }
                }
            }
        }
        if (target.flags & (TypeFlagsIndexedAccess | TypeFlagsSubstitution)) <> 0
        {
            if Checker.is_no_infer_type(target)
                return
            let actual this.get_actual_type_variable(target)
            if this.unported_mark() <> mark
                return
            if actual = null
                return
            set target: actual as ref[Type]
        }
        if (target.flags & TypeFlagsTypeVariable) <> 0
        {
            if this.is_from_inference_blocked_source(source)
                return
            let inference Checker.get_inference_info_for_type(n, target)
            if inference <> null
            {
                let info inference as ref[InferenceInfo]
                ; A NON-INFERRABLE source is a marker rather than a type — the
                ; wildcard, the auto types, silentNever — and the flag is
                ; infectious, which is why the test is on the SOURCE and not on
                ; what it was built from.
                if (source.object_flags & ObjectFlagsNonInferrableType) <> 0
                    return
                if source = non_inferrable_any_type
                    return
                if info.is_fixed = false
                {
                    var candidate source
                    if n.propagation_type <> null
                        set candidate: n.propagation_type as ref[Type]
                    if candidate = blocked_string_type
                        return
                    if n.priority < info.priority
                    {
                        ; A better priority discards everything gathered so far.
                        info.candidates.clear()
                        info.candidate_depths.clear()
                        info.contra_candidates.clear()
                        set info.top_level: true
                        set info.priority: n.priority
                    }
                    if n.priority = info.priority
                    {
                        var contra false
                        if n.contravariant
                        {
                            if n.bivariant = false
                                set contra: true
                        }
                        if contra
                        {
                            if Checker.type_list_contains(info.contra_candidates, candidate) = false
                            {
                                info.contra_candidates.add(candidate as ref[Type]?)
                                Checker.clear_cached_inferences(n.inferences)
                            }
                        }
                        else
                            this.record_candidate_at_depth(n, info, candidate)
                    }
                    ; A type parameter that is NOT at top level in the original
                    ; target loses `top_level`, which is what decides whether a
                    ; literal candidate is widened later.
                    if (n.priority & InferencePriorityReturnType) = 0
                    {
                        if (target.flags & TypeFlagsTypeParameter) <> 0
                        {
                            if info.top_level
                            {
                                if n.original_target <> null
                                {
                                    if this.is_type_parameter_at_top_level(n.original_target as ref[Type], target, 0) = false
                                    {
                                        set info.top_level: false
                                        Checker.clear_cached_inferences(n.inferences)
                                    }
                                }
                            }
                        }
                    }
                }
                if n.priority < n.inference_priority
                    set n.inference_priority: n.priority
                return
            }
            ; "Infer to the simplified version of an indexed access, if
            ; possible, to (hopefully) expose more bare type parameters to the
            ; inference engine."
            ;
            ; ★★★ NEITHER RECURSION RETURNS, AND THE `return` THAT USED TO STAND
            ; HERE WAS A DIVERGENCE NOBODY COULD SEE. Upstream this block is the
            ; tail of the type-variable arm and FALLS THROUGH into the switch
            ; below, so a target that simplifies is inferred from twice — once
            ; simplified, once by its own structure. It was invisible while
            ; get_simplified_type was a stop: the mark check above returned
            ; first on every input that could reach the difference.
            let simplified this.get_simplified_type(target, false)
            if this.unported_mark() <> mark
                return
            var took_simplified false
            if simplified <> null
            {
                if simplified <> target
                {
                    this.infer_from_types(n, source, simplified as ref[Type])
                    if this.unported_mark() <> mark
                        return
                    set took_simplified: true
                }
            }
            if took_simplified = false
            {
                if (target.flags & TypeFlagsIndexedAccess) <> 0
                {
                    ; "Generally simplifications of instantiable indexes are
                    ; avoided to keep relationship checking correct, however if
                    ; our target is an access, we can consider that key of that
                    ; access to be 'instantiated', since we're looking to find
                    ; the inference goal in any way we can."
                    let index_source Checker.indexed_access_index_type_of(target)
                    let object_source Checker.indexed_access_object_type_of(target)
                    if index_source = null
                        return
                    if object_source = null
                        return
                    let index_type this.get_simplified_type(index_source as ref[Type], false)
                    if this.unported_mark() <> mark
                        return
                    if index_type = null
                        return
                    let it index_type as ref[Type]
                    if (it.flags & TypeFlagsInstantiable) <> 0
                    {
                        let object_type this.get_simplified_type(object_source as ref[Type], false)
                        if this.unported_mark() <> mark
                            return
                        if object_type = null
                            return
                        let distributed this.distribute_index_over_object_type(object_type as ref[Type], it, false)
                        if this.unported_mark() <> mark
                            return
                        if distributed <> null
                        {
                            if distributed <> target
                            {
                                this.infer_from_types(n, source, distributed as ref[Type])
                                if this.unported_mark() <> mark
                                    return
                            }
                        }
                    }
                }
            }
        }
        ; ── the switch ──────────────────────────────────────────────────────
        if (source.object_flags & ObjectFlagsReference) <> 0
        {
            if (target.object_flags & ObjectFlagsReference) <> 0
            {
                let st Checker.target_of(source)
                let tt Checker.target_of(target)
                var same false
                if st = tt
                    set same: true
                if same = false
                {
                    if this.is_array_type(source)
                    {
                        if this.is_array_type(target)
                            set same: true
                    }
                }
                ; ★★★ `!(source.node != nil && target.node != nil)` IS THE
                ; CONJUNCT THAT SENDS TWO DEFERRED REFERENCES THROUGH
                ; `invoke_once`, AND IT IS WHERE THE WALK IS BOUNDED. The note
                ; that stood here read *both nodes are nil in this port for
                ; could_contain_type_variables' own reason, so the conjunct is
                ; constant true* — it CITED the premise that function carried, and
                ; that premise was wrong: `Reference.node` is filled by
                ; create_deferred_type_reference. With the conjunct dropped, a pair
                ; of deferred references takes this arm and returns, so
                ; infer_from_object_types — the only route to `invoke_once`, whose
                ; is_deeply_nested_type is the guard — is never reached, and
                ; infer_from_types / infer_from_type_arguments /
                ; infer_from_matching_types recurse until the stack runs out.
                ; `recursiveTypeReferences1` is the witness.
                if same
                {
                    var both_deferred false
                    if Checker.reference_node_of(source) <> null
                    {
                        if Checker.reference_node_of(target) <> null
                            set both_deferred: true
                    }
                    if both_deferred
                        set same: false
                }
                if same
                {
                    if st <> null
                    {
                        let variances this.get_variances(st as ref[Type])
                        if this.unported_mark() <> mark
                            return
                        let sargs this.get_type_arguments(source)
                        if this.unported_mark() <> mark
                            return
                        let targs this.get_type_arguments(target)
                        if this.unported_mark() <> mark
                            return
                        this.infer_from_type_arguments(n, sargs, targs, variances)
                        return
                    }
                }
            }
        }
        if (source.flags & TypeFlagsIndex) <> 0
        {
            if (target.flags & TypeFlagsIndex) <> 0
            {
                let s Checker.index_target_of(source)
                let t Checker.index_target_of(target)
                if s <> null
                {
                    if t <> null
                        this.infer_from_contravariant_types(n, s as ref[Type], t as ref[Type])
                }
                return
            }
        }
        if (target.flags & TypeFlagsIndex) <> 0
        {
            var literal_source false
            if Checker.is_literal_type(source)
                set literal_source: true
            if (source.flags & TypeFlagsString) <> 0
                set literal_source: true
            if literal_source
            {
                let empty this.create_empty_object_type_from_string_literal(source)
                if this.unported_mark() <> mark
                    return
                let t Checker.index_target_of(target)
                if empty <> null
                {
                    if t <> null
                        this.infer_from_contravariant_types_with_priority(n, empty as ref[Type], t as ref[Type], InferencePriorityLiteralKeyof)
                }
                return
            }
        }
        if (source.flags & TypeFlagsIndexedAccess) <> 0
        {
            if (target.flags & TypeFlagsIndexedAccess) <> 0
            {
                let so Checker.indexed_access_object_type_of(source)
                let to Checker.indexed_access_object_type_of(target)
                if so <> null
                {
                    if to <> null
                    {
                        this.infer_from_types(n, so as ref[Type], to as ref[Type])
                        if this.unported_mark() <> mark
                            return
                    }
                }
                let si Checker.indexed_access_index_type_of(source)
                let tix Checker.indexed_access_index_type_of(target)
                if si <> null
                {
                    if tix <> null
                        this.infer_from_types(n, si as ref[Type], tix as ref[Type])
                }
                return
            }
        }
        if (source.flags & TypeFlagsStringMapping) <> 0
        {
            if (target.flags & TypeFlagsStringMapping) <> 0
            {
                if source.symbol = target.symbol
                {
                    let s Checker.string_mapping_target_of(source)
                    let t Checker.string_mapping_target_of(target)
                    if s <> null
                    {
                        if t <> null
                            this.infer_from_types(n, s as ref[Type], t as ref[Type])
                    }
                }
                return
            }
        }
        if (source.flags & TypeFlagsSubstitution) <> 0
        {
            let base Checker.substitution_base_type_of(source)
            if base <> null
            {
                this.infer_from_types(n, base as ref[Type], target)
                if this.unported_mark() <> mark
                    return
            }
            let si this.get_substitution_intersection(source)
            if this.unported_mark() <> mark
                return
            if si <> null
                this.infer_with_priority(n, si as ref[Type], target, InferencePrioritySubstituteSource)
            return
        }
        if (target.flags & TypeFlagsConditional) <> 0
        {
            this.invoke_once(n, source, target, 0)
            return
        }
        if (target.flags & TypeFlagsUnionOrIntersection) <> 0
        {
            var list Checker.union_types_of(target)
            if list = null
                set list: Checker.intersection_types_of(target)
            if list <> null
                this.infer_to_multiple_types(n, source, list as ref[Array[ref[Type]?]], target.flags)
            return
        }
        if (source.flags & TypeFlagsUnion) <> 0
        {
            let list Checker.union_types_of(source)
            if list <> null
            {
                let types list as ref[Array[ref[Type]?]]
                let cnt types.get_length() as int
                var i 0
                while i < cnt
                {
                    let e types[i]
                    if e <> null
                    {
                        this.infer_from_types(n, e as ref[Type], target)
                        if this.unported_mark() <> mark
                            return
                    }
                    set i: i + 1
                }
            }
            return
        }
        if (target.flags & TypeFlagsTemplateLiteral) <> 0
        {
            this.infer_to_template_literal_type(n, source, target)
            return
        }
        ; the default arm
        let reduced this.get_reduced_type(source)
        if this.unported_mark() <> mark
            return
        if reduced = null
            return
        set source: reduced as ref[Type]
        if this.is_generic_mapped_type(source)
        {
            if this.is_generic_mapped_type(target)
            {
                this.invoke_once(n, source, target, 1)
                if this.unported_mark() <> mark
                    return
            }
        }
        var skip_apparent false
        if (n.priority & InferencePriorityNoConstraints) <> 0
        {
            if (source.flags & (TypeFlagsIntersection | TypeFlagsInstantiable)) <> 0
                set skip_apparent: true
        }
        if skip_apparent = false
        {
            let apparent this.get_apparent_type(source)
            if this.unported_mark() <> mark
                return
            if apparent = null
                return
            let ap apparent as ref[Type]
            if ap <> source
            {
                ; getApparentType can answer ANY type, so a result that is neither
                ; an object nor an intersection restarts the whole dispatch.
                if (ap.flags & (TypeFlagsObject | TypeFlagsIntersection)) = 0
                {
                    this.infer_from_types(n, ap, target)
                    return
                }
            }
            set source: ap
        }
        if (source.flags & (TypeFlagsObject | TypeFlagsIntersection)) <> 0
            this.invoke_once(n, source, target, 2)
    }

    ; The candidate insert of inferFromTypes' type-variable arm, lifted out
    ; because it is the one place in this chapter with an insertion ORDER: the
    ; candidates are kept in DECREASING depth, so a candidate found at a deeper
    ; type-argument nesting is preferred. Scaly's Array has no insert or delete,
    ; so both lists are rebuilt — they hold a handful of entries each.
    procedure record_candidate_at_depth(this, n: ref[InferenceState], info: ref[InferenceInfo], candidate: ref[Type])
    {
        let cnt info.candidates.get_length() as int
        var index 0 - 1
        var i 0
        while i < cnt
        {
            if info.candidates[i] = candidate
            {
                set index: i
                set i: cnt
            }
            else
                set i: i + 1
        }
        if index >= 0
        {
            if index < (info.candidate_depths.get_length() as int)
            {
                if info.candidate_depths[index] >= n.depth
                    return
            }
        }
        ; the two working lists are this routine's; only the rebuilt pair is kept
        var cs_value Array[ref[Type]?]()
        var cd_value Array[int]()
        let cs &cs_value
        let cd &cd_value
        set i: 0
        while i < cnt
        {
            if i <> index
            {
                cs.add(info.candidates[i])
                if i < (info.candidate_depths.get_length() as int)
                    cd.add(info.candidate_depths[i])
                else
                    cd.add(0)
            }
            set i: i + 1
        }
        ; The insertion point is the first entry whose depth is LOWER than this
        ; one's, or the end.
        let kept cs.get_length() as int
        var at kept
        set i: 0
        while i < kept
        {
            if cd[i] < n.depth
            {
                set at: i
                set i: kept
            }
            else
                set i: i + 1
        }
        let ncs &Array[ref[Type]?]^host((kept + 1) as size_t)
        let ncd &Array[int]^host((kept + 1) as size_t)
        set i: 0
        while i < at
        {
            ncs.add(cs[i])
            ncd.add(cd[i])
            set i: i + 1
        }
        ncs.add(candidate as ref[Type]?)
        ncd.add(n.depth)
        set i: at
        while i < kept
        {
            ncs.add(cs[i])
            ncd.add(cd[i])
            set i: i + 1
        }
        set info.candidates: ncs
        set info.candidate_depths: ncd
        Checker.clear_cached_inferences(n.inferences)
    }

    ; `slices.Contains` over a type list, by IDENTITY — the membership test of
    ; every insertion-ordered set in this file, which is NOT contains_type's
    ; binary search over the sorted union list.
    ;
    ; ★★★ IT STOOD UNDER THREE NAMES UNTIL SLICE 176 (§3.5gg): this one,
    ; `contains_type_by_identity` (a method whose `this` it never read) and
    ; `contains_type_identity` — one reference function, three bodies, and the
    ; fourth was about to be written for the union-origin fast paths. The two
    ; others are gone and their four call sites read this.
    function type_list_contains(list: ref[Array[ref[Type]?]], t: ref[Type]?) returns bool
    {
        let n list.get_length() as int
        var i 0
        while i < n
        {
            if list[i] = t
                return true
            set i: i + 1
        }
        false
    }

    procedure infer_from_type_arguments(this, n: ref[InferenceState], source_types: ref[Array[ref[Type]?]]?, target_types: ref[Array[ref[Type]?]]?, variances: ref[Array[int]]?)
    {
        if source_types = null
            return
        if target_types = null
            return
        let ss source_types as ref[Array[ref[Type]?]]
        let ts target_types as ref[Array[ref[Type]?]]
        var count ss.get_length() as int
        if (ts.get_length() as int) < count
            set count: ts.get_length() as int
        var vcount 0
        if variances <> null
            set vcount: (variances as ref[Array[int]]).get_length() as int
        set n.depth: n.depth + 1
        let mark this.unported_mark()
        var i 0
        while i < count
        {
            let s ss[i]
            let t ts[i]
            if s <> null
            {
                if t <> null
                {
                    var contravariant false
                    if i < vcount
                    {
                        let v (variances as ref[Array[int]])[i]
                        if (v & VarianceFlagsVarianceMask) = VarianceFlagsContravariant
                            set contravariant: true
                    }
                    if contravariant
                        this.infer_from_contravariant_types(n, s as ref[Type], t as ref[Type])
                    else
                        this.infer_from_types(n, s as ref[Type], t as ref[Type])
                    if this.unported_mark() <> mark
                    {
                        set n.depth: n.depth - 1
                        return
                    }
                }
            }
            set i: i + 1
        }
        set n.depth: n.depth - 1
    }

    procedure infer_with_priority(this, n: ref[InferenceState], source: ref[Type], target: ref[Type], new_priority: int)
    {
        let save n.priority
        set n.priority: n.priority | new_priority
        this.infer_from_types(n, source, target)
        set n.priority: save
    }

    procedure infer_from_contravariant_types_with_priority(this, n: ref[InferenceState], source: ref[Type], target: ref[Type], new_priority: int)
    {
        let save n.priority
        set n.priority: n.priority | new_priority
        this.infer_from_contravariant_types(n, source, target)
        set n.priority: save
    }

    procedure infer_from_contravariant_types(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        let save n.contravariant
        if save
            set n.contravariant: false
        else
            set n.contravariant: true
        this.infer_from_types(n, source, target)
        set n.contravariant: save
    }

    procedure infer_from_contravariant_types_if_strict_function_types(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        var strict Checker.strict_function_types()
        if (n.priority & InferencePriorityAlwaysStrict) <> 0
            set strict: true
        if strict
            this.infer_from_contravariant_types(n, source, target)
        else
            this.infer_from_types(n, source, target)
    }

    ; invokeOnce. The reference's `action` is a func value over a closed set of
    ; three; here it is a tag on §3.5e's rule — 0 the conditional, 1 the generic
    ; mapped pair, 2 the object types.
    ;
    ; ★★★ THE VISIT TABLE IS WRITTEN TWICE PER PAIR AND BOTH WRITES MATTER. The
    ; first parks `Circularity` so that a recursive arrival answers *circular*
    ; rather than recursing; the second records what the action actually
    ; concluded, so a LATER arrival at the same pair reuses the priority instead of
    ; walking it again.
    procedure invoke_once(this, n: ref[InferenceState], source: ref[Type], target: ref[Type], action: int)
    {
        let cnt n.visited_source.get_length() as int
        var i 0
        while i < cnt
        {
            if n.visited_source[i] = source.id
            {
                if n.visited_target[i] = target.id
                {
                    let status n.visited_priority[i]
                    if status < n.inference_priority
                        set n.inference_priority: status
                    return
                }
            }
            set i: i + 1
        }
        n.visited_source.add(source.id)
        n.visited_target.add(target.id)
        n.visited_priority.add(InferencePriorityCircularity)
        let slot cnt
        let save_inference_priority n.inference_priority
        set n.inference_priority: InferencePriorityMaxValue
        let save_expanding n.expanding_flags
        n.source_stack.add(source as ref[Type]?)
        n.target_stack.add(target as ref[Type]?)
        if this.is_deeply_nested_type_in(source, n.source_stack, 0, n.source_stack.get_length() as int, 2)
            set n.expanding_flags: n.expanding_flags | ExpandingFlagsSource
        if this.is_deeply_nested_type_in(target, n.target_stack, 0, n.target_stack.get_length() as int, 2)
            set n.expanding_flags: n.expanding_flags | ExpandingFlagsTarget
        if n.expanding_flags <> ExpandingFlagsBoth
        {
            if action = 0
                this.infer_to_conditional_type(n, source, target)
            if action = 1
                this.infer_from_generic_mapped_types(n, source, target)
            if action = 2
                this.infer_from_object_types(n, source, target)
        }
        else
            set n.inference_priority: InferencePriorityCircularity
        this.pop_type_stack(n.target_stack)
        this.pop_type_stack(n.source_stack)
        set n.expanding_flags: save_expanding
        n.visited_priority.put(slot as size_t, n.inference_priority)
        if save_inference_priority < n.inference_priority
            set n.inference_priority: save_inference_priority
    }

    ; The stack pop Scaly's Array has no method for: rebuild one shorter. The
    ; stacks are as deep as the type nesting, which is a handful.
    procedure pop_type_stack(this, stack: ref[Array[ref[Type]?]])
    {
        let n stack.get_length() as int
        if n = 0
            return
        ; the length alone, as Array.clear sets it: a copy per pop was garbage
        set stack.length: (n - 1) as size_t
    }

    ; inferFromMatchingTypes. The `matches` func value is a tag: 0
    ; isTypeOrBaseIdenticalTo, 1 isTypeCloselyMatchedBy, 2 isTypeIdenticalTo — the
    ; three predicates its three call sites pass.
    procedure infer_from_matching_types(this, n: ref[InferenceState], sources: ref[Array[ref[Type]?]], targets: ref[Array[ref[Type]?]], matcher: int, out_sources: ref[ref[Array[ref[Type]?]]?], out_targets: ref[ref[Array[ref[Type]?]]?])
    {
        let matched_sources &Array[ref[Type]?]^host()
        let matched_targets &Array[ref[Type]?]^host()
        let mark this.unported_mark()
        let tn targets.get_length() as int
        let sn sources.get_length() as int
        var ti 0
        while ti < tn
        {
            let te targets[ti]
            if te <> null
            {
                let t te as ref[Type]
                var si 0
                while si < sn
                {
                    let se sources[si]
                    if se <> null
                    {
                        let s se as ref[Type]
                        var hit false
                        if matcher = 0
                            set hit: this.is_type_or_base_identical_to(s, t)
                        if matcher = 1
                            set hit: Checker.is_type_closely_matched_by(s, t)
                        if matcher = 2
                            set hit: this.is_type_identical_to(s, t)
                        if this.unported_mark() <> mark
                            return
                        if hit
                        {
                            this.infer_from_types(n, s, t)
                            if this.unported_mark() <> mark
                                return
                            if Checker.type_list_contains(matched_sources, se) = false
                                matched_sources.add(se)
                            if Checker.type_list_contains(matched_targets, te) = false
                                matched_targets.add(te)
                        }
                    }
                    set si: si + 1
                }
            }
            set ti: ti + 1
        }
        let rem_sources &Array[ref[Type]?]^host()
        var i 0
        while i < sn
        {
            if Checker.type_list_contains(matched_sources, sources[i]) = false
                rem_sources.add(sources[i])
            set i: i + 1
        }
        let rem_targets &Array[ref[Type]?]^host()
        set i: 0
        while i < tn
        {
            if Checker.type_list_contains(matched_targets, targets[i]) = false
                rem_targets.add(targets[i])
            set i: i + 1
        }
        set out_sources: rem_sources as ref[Array[ref[Type]?]]?
        set out_targets: rem_targets as ref[Array[ref[Type]?]]?
    }

    ; inferToMultipleTypes — the union arm and the intersection arm, then the
    ; shared naked-type-variable tail.
    procedure infer_to_multiple_types(this, n: ref[InferenceState], source: ref[Type], targets: ref[Array[ref[Type]?]], target_flags: int)
    {
        let mark this.unported_mark()
        var type_variable_count 0
        let tn targets.get_length() as int
        if (target_flags & TypeFlagsUnion) <> 0
        {
            var naked_type_variable: ref[Type]? null
            let sources &Array[ref[Type]?]^host()
            if (source.flags & TypeFlagsUnion) <> 0
            {
                let list Checker.union_types_of(source)
                if list <> null
                {
                    let types list as ref[Array[ref[Type]?]]
                    let cnt types.get_length() as int
                    var i 0
                    while i < cnt
                    {
                        sources.add(types[i])
                        set i: i + 1
                    }
                }
            }
            else
                sources.add(source)
            let sn sources.get_length() as int
            let matched &Array[int]()
            var mi 0
            while mi < sn
            {
                matched.add(0)
                set mi: mi + 1
            }
            var circularity false
            var ti 0
            while ti < tn
            {
                let te targets[ti]
                if te <> null
                {
                    let t te as ref[Type]
                    if Checker.get_inference_info_for_type(n, t) <> null
                    {
                        set naked_type_variable: t
                        set type_variable_count: type_variable_count + 1
                    }
                    else
                    {
                        var si 0
                        while si < sn
                        {
                            let se sources[si]
                            if se <> null
                            {
                                let save n.inference_priority
                                set n.inference_priority: InferencePriorityMaxValue
                                this.infer_from_types(n, se as ref[Type], t)
                                if this.unported_mark() <> mark
                                    return
                                if n.inference_priority = n.priority
                                    matched.put(si as size_t, 1)
                                if n.inference_priority = InferencePriorityCircularity
                                    set circularity: true
                                if save < n.inference_priority
                                    set n.inference_priority: save
                            }
                            set si: si + 1
                        }
                    }
                }
                set ti: ti + 1
            }
            if type_variable_count = 0
            {
                ; Every target is an intersection around ONE type variable: make a
                ; low-priority inference to it. `A | B` to `T & (X | Y)`.
                let tv Checker.get_single_type_variable_from_intersection_types(n, targets)
                if tv <> null
                    this.infer_with_priority(n, source, tv as ref[Type], InferencePriorityNakedTypeVariable)
                return
            }
            if type_variable_count = 1
            {
                if circularity = false
                {
                    let unmatched &Array[ref[Type]?]^host()
                    var si 0
                    while si < sn
                    {
                        if matched[si] = 0
                            unmatched.add(sources[si])
                        set si: si + 1
                    }
                    if (unmatched.get_length() as int) <> 0
                    {
                        let u this.get_union_type(unmatched)
                        if this.unported_mark() <> mark
                            return
                        if u = null
                            return
                        if naked_type_variable = null
                            return
                        this.infer_from_types(n, u as ref[Type], naked_type_variable as ref[Type])
                        return
                    }
                }
            }
        }
        else
        {
            var ti 0
            while ti < tn
            {
                let te targets[ti]
                if te <> null
                {
                    let t te as ref[Type]
                    if Checker.get_inference_info_for_type(n, t) <> null
                        set type_variable_count: type_variable_count + 1
                    else
                    {
                        this.infer_from_types(n, source, t)
                        if this.unported_mark() <> mark
                            return
                    }
                }
                set ti: ti + 1
            }
        }
        var tail false
        if (target_flags & TypeFlagsIntersection) <> 0
        {
            if type_variable_count = 1
                set tail: true
        }
        else
        {
            if type_variable_count > 0
                set tail: true
        }
        if tail
        {
            var ti 0
            while ti < tn
            {
                let te targets[ti]
                if te <> null
                {
                    let t te as ref[Type]
                    if Checker.get_inference_info_for_type(n, t) <> null
                    {
                        this.infer_with_priority(n, source, t, InferencePriorityNakedTypeVariable)
                        if this.unported_mark() <> mark
                            return
                    }
                }
                set ti: ti + 1
            }
        }
    }

    function get_single_type_variable_from_intersection_types(n: ref[InferenceState], types: ref[Array[ref[Type]?]]) returns ref[Type]?
    {
        var type_variable: ref[Type]? null
        let cnt types.get_length() as int
        var i 0
        while i < cnt
        {
            let e types[i]
            if e = null
                return null
            let t e as ref[Type]
            if (t.flags & TypeFlagsIntersection) = 0
                return null
            let list Checker.intersection_types_of(t)
            if list = null
                return null
            let parts list as ref[Array[ref[Type]?]]
            let pn parts.get_length() as int
            var v: ref[Type]? null
            var j 0
            while j < pn
            {
                let pe parts[j]
                if pe <> null
                {
                    if Checker.get_inference_info_for_type(n, pe as ref[Type]) <> null
                    {
                        set v: pe
                        set j: pn
                    }
                    else
                        set j: j + 1
                }
                else
                    set j: j + 1
            }
            if v = null
                return null
            if type_variable <> null
            {
                if v <> type_variable
                    return null
            }
            set type_variable: v
            set i: i + 1
        }
        type_variable
    }

    procedure infer_to_multiple_types_with_priority(this, n: ref[InferenceState], source: ref[Type], targets: ref[Array[ref[Type]?]], target_flags: int, new_priority: int)
    {
        let save n.priority
        set n.priority: n.priority | new_priority
        this.infer_to_multiple_types(n, source, targets, target_flags)
        set n.priority: save
    }

    procedure infer_to_conditional_type(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        let mark this.unported_mark()
        if (source.flags & TypeFlagsConditional) <> 0
        {
            let sc Checker.conditional_check_type_of(source)
            let tc Checker.conditional_check_type_of(target)
            if sc <> null
            {
                if tc <> null
                {
                    this.infer_from_types(n, sc as ref[Type], tc as ref[Type])
                    if this.unported_mark() <> mark
                        return
                }
            }
            let se Checker.conditional_extends_type_of(source)
            let te Checker.conditional_extends_type_of(target)
            if se <> null
            {
                if te <> null
                {
                    this.infer_from_types(n, se as ref[Type], te as ref[Type])
                    if this.unported_mark() <> mark
                        return
                }
            }
            let strue this.get_true_type_from_conditional_type(source)
            if this.unported_mark() <> mark
                return
            let ttrue this.get_true_type_from_conditional_type(target)
            if this.unported_mark() <> mark
                return
            if strue <> null
            {
                if ttrue <> null
                {
                    this.infer_from_types(n, strue as ref[Type], ttrue as ref[Type])
                    if this.unported_mark() <> mark
                        return
                }
            }
            let sfalse this.get_false_type_from_conditional_type(source)
            if this.unported_mark() <> mark
                return
            let tfalse this.get_false_type_from_conditional_type(target)
            if this.unported_mark() <> mark
                return
            if sfalse <> null
            {
                if tfalse <> null
                    this.infer_from_types(n, sfalse as ref[Type], tfalse as ref[Type])
            }
            return
        }
        let ttrue this.get_true_type_from_conditional_type(target)
        if this.unported_mark() <> mark
            return
        let tfalse this.get_false_type_from_conditional_type(target)
        if this.unported_mark() <> mark
            return
        let both &Array[ref[Type]?]^host()
        both.add(ttrue)
        both.add(tfalse)
        var priority 0
        if n.contravariant
            set priority: InferencePriorityContravariantConditional
        this.infer_to_multiple_types_with_priority(n, source, both, target.flags, priority)
    }

    ; inferFromGenericMappedTypes — the constraint, the template and the name
    ; type. ★The stop that stood here said *all four accessors belong to the
    ; mapped-type chapter*; that chapter landed and the three accessors sit
    ; together at the head of it. The reference's own comment: the two types are
    ; `{ [P in S]: X }` and `{ [P in T]: Y }`, so infer from S to T and X to Y.
    procedure infer_from_generic_mapped_types(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        let mark this.unported_mark()
        let sc this.get_constraint_type_from_mapped_type(source)
        let tc this.get_constraint_type_from_mapped_type(target)
        if this.unported_mark() <> mark
            return
        if sc <> null
        {
            if tc <> null
                this.infer_from_types(n, sc as ref[Type], tc as ref[Type])
        }
        if this.unported_mark() <> mark
            return
        let st this.get_template_type_from_mapped_type(source)
        let tt this.get_template_type_from_mapped_type(target)
        if this.unported_mark() <> mark
            return
        if st <> null
        {
            if tt <> null
                this.infer_from_types(n, st as ref[Type], tt as ref[Type])
        }
        if this.unported_mark() <> mark
            return
        let sn this.get_name_type_from_mapped_type(source)
        let tn this.get_name_type_from_mapped_type(target)
        if this.unported_mark() <> mark
            return
        if sn = null
            return
        if tn = null
            return
        this.infer_from_types(n, sn as ref[Type], tn as ref[Type])
    }

    procedure infer_from_object_types(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        let mark this.unported_mark()
        if (source.object_flags & ObjectFlagsReference) <> 0
        {
            if (target.object_flags & ObjectFlagsReference) <> 0
            {
                let st Checker.target_of(source)
                let tt Checker.target_of(target)
                var same false
                if st = tt
                    set same: true
                if same = false
                {
                    if this.is_array_type(source)
                    {
                        if this.is_array_type(target)
                            set same: true
                    }
                }
                if same
                {
                    if st <> null
                    {
                        let variances this.get_variances(st as ref[Type])
                        if this.unported_mark() <> mark
                            return
                        let sargs this.get_type_arguments(source)
                        if this.unported_mark() <> mark
                            return
                        let targs this.get_type_arguments(target)
                        if this.unported_mark() <> mark
                            return
                        this.infer_from_type_arguments(n, sargs, targs, variances)
                        return
                    }
                }
            }
        }
        if this.is_generic_mapped_type(source)
        {
            if this.is_generic_mapped_type(target)
            {
                this.infer_from_generic_mapped_types(n, source, target)
                if this.unported_mark() <> mark
                    return
            }
        }
        ; ★ Slice 160. The guard is the reference's: a mapped type with a NAME TYPE
        ; (`{ [P in K as N]: X }`) is not inferred to this way, because the
        ; property names of the result are not the keys the mapping ran over.
        if (target.object_flags & ObjectFlagsMapped) <> 0
        {
            var has_name_type false
            let decl Checker.mapped_declaration_of(target)
            if decl <> null
            {
                if AstNode.mapped_type_name_type_of(decl as ref[AstNode]) <> null
                    set has_name_type: true
            }
            if has_name_type = false
            {
                let constraint_type this.get_constraint_type_from_mapped_type(target)
                if this.unported_mark() <> mark
                    return
                if constraint_type = null
                {
                    this.record_unported("infer-to-mapped-type-constraint", target.object_flags)
                    return
                }
                if this.infer_to_mapped_type(n, source, target, constraint_type as ref[Type])
                    return
                if this.unported_mark() <> mark
                    return
            }
        }
        let unrelated this.types_definitely_unrelated(source, target)
        if this.unported_mark() <> mark
            return
        if unrelated
            return
        if this.is_array_or_tuple_type(source)
        {
            if Checker.is_tuple_type(target)
            {
                this.infer_from_tuple_target(n, source, target)
                return
            }
            if this.is_array_type(target)
            {
                this.infer_from_index_types(n, source, target)
                return
            }
        }
        this.infer_from_properties(n, source, target)
        if this.unported_mark() <> mark
            return
        this.infer_from_signatures(n, source, target, SignatureKindCall)
        if this.unported_mark() <> mark
            return
        this.infer_from_signatures(n, source, target, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return
        this.infer_from_index_types(n, source, target)
    }

    ; The tuple half of inferFromObjectTypes, lifted into its own function
    ; because it is the longest arm of the reference's own and the s178
    ; alloca-pool rule applies to the caller.
    ;
    ; ★★★ THE STRUCTURE-MATCHING FAST PATH IS NOT AN OPTIMISATION: it infers
    ; POSITION BY POSITION where the general path slices the source, and for
    ; `[A, B]` against `[T, U]` those are different answers only when the general
    ; path's slicing is wrong. It is written first for the same reason upstream
    ; writes it first — the arms below it all assume the shapes differ.
    procedure infer_from_tuple_target(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        let mark this.unported_mark()
        let starget Checker.target_of(source)
        let ttarget Checker.target_of(target)
        if ttarget = null
            return
        let tt ttarget as ref[Type]
        let source_arity Checker.get_type_reference_arity(source)
        let target_arity Checker.get_type_reference_arity(target)
        let element_types this.get_type_arguments(target)
        if this.unported_mark() <> mark
            return
        if element_types = null
            return
        let et element_types as ref[Array[ref[Type]?]]
        let element_infos Checker.tuple_element_infos_of(tt)
        if element_infos = null
            return
        let ei element_infos as ref[Array[ref[TupleElementInfo]?]]
        let source_is_tuple Checker.is_tuple_type(source)
        if source_is_tuple
        {
            if this.is_tuple_type_structure_matching(source, target)
            {
                let sargs this.get_type_arguments(source)
                if this.unported_mark() <> mark
                    return
                if sargs = null
                    return
                let sa sargs as ref[Array[ref[Type]?]]
                var i 0
                while i < target_arity
                {
                    if i < (sa.get_length() as int)
                    {
                        let s sa[i]
                        let t et[i]
                        if s <> null
                        {
                            if t <> null
                            {
                                this.infer_from_types(n, s as ref[Type], t as ref[Type])
                                if this.unported_mark() <> mark
                                    return
                            }
                        }
                    }
                    set i: i + 1
                }
                return
            }
        }
        var start_length 0
        var end_length 0
        if source_is_tuple
        {
            if starget = null
                return
            let st starget as ref[Type]
            set start_length: Checker.tuple_fixed_length_of(st)
            let tfixed Checker.tuple_fixed_length_of(tt)
            if tfixed < start_length
                set start_length: tfixed
            if (Checker.tuple_combined_flags_of(tt) & ElementFlagsVariable) <> 0
            {
                var se Checker.end_element_count(st, ElementFlagsFixed)
                let te Checker.end_element_count(tt, ElementFlagsFixed)
                if te < se
                    set se: te
                set end_length: se
            }
        }
        let sargs this.get_type_arguments(source)
        if this.unported_mark() <> mark
            return
        if sargs = null
            return
        let sa sargs as ref[Array[ref[Type]?]]
        var i 0
        while i < start_length
        {
            if i < (sa.get_length() as int)
            {
                let s sa[i]
                let t et[i]
                if s <> null
                {
                    if t <> null
                    {
                        this.infer_from_types(n, s as ref[Type], t as ref[Type])
                        if this.unported_mark() <> mark
                            return
                    }
                }
            }
            set i: i + 1
        }
        var single_rest_source false
        if source_is_tuple = false
            set single_rest_source: true
        else
        {
            if (source_arity - start_length - end_length) = 1
            {
                if starget <> null
                {
                    let sinfos Checker.tuple_element_infos_of(starget as ref[Type])
                    if sinfos <> null
                    {
                        let si sinfos as ref[Array[ref[TupleElementInfo]?]]
                        if start_length < (si.get_length() as int)
                        {
                            let row si[start_length]
                            if row <> null
                            {
                                if ((row as ref[TupleElementInfo]).flags & ElementFlagsRest) <> 0
                                    set single_rest_source: true
                            }
                        }
                    }
                }
            }
        }
        if single_rest_source
        {
            ; One rest element left in the source: it feeds every remaining
            ; target element, wrapped in an array where the target is variadic.
            if start_length >= (sa.get_length() as int)
                return
            let rest_type sa[start_length]
            if rest_type = null
                return
            var j start_length
            while j < (target_arity - end_length)
            {
                var t rest_type
                if j < (ei.get_length() as int)
                {
                    let row ei[j]
                    if row <> null
                    {
                        if ((row as ref[TupleElementInfo]).flags & ElementFlagsVariadic) <> 0
                        {
                            let arr this.create_array_type(rest_type)
                            if this.unported_mark() <> mark
                                return
                            if arr = null
                                return
                            set t: arr
                        }
                    }
                }
                let tgt et[j]
                if t <> null
                {
                    if tgt <> null
                    {
                        this.infer_from_types(n, t as ref[Type], tgt as ref[Type])
                        if this.unported_mark() <> mark
                            return
                    }
                }
                set j: j + 1
            }
        }
        else
        {
            ; ★★★ THE FIVE MIDDLE SHAPES, AND THE NOTE THAT KEPT FOUR OF THEM OUT
            ; WAS AN EXPIRED CLAIM: it read *all slice the SOURCE tuple, and
            ; sliceTupleType belongs to the tuple chapter* — slice_tuple_type and
            ; get_element_type_of_slice_of_tuple_type have both been in this file
            ; since that chapter landed, and the frontier put 19 units on the row.
            ;
            ; ★ The reference's ladder is `middleLength == 2` with three variadic/rest
            ; pairings inside it, then two `middleLength == 1` arms. It is written as
            ; that ladder rather than as a flag, because each arm asks a different
            ; question of the same two infos and a reader has to see which fired.
            let middle_length target_arity - start_length - end_length
            var first_flags 0
            if start_length >= 0
            {
                if start_length < (ei.get_length() as int)
                {
                    let row ei[start_length]
                    if row <> null
                        set first_flags: (row as ref[TupleElementInfo]).flags
                }
            }
            var second_flags 0
            if (start_length + 1) < (ei.get_length() as int)
            {
                let row ei[start_length + 1]
                if row <> null
                    set second_flags: (row as ref[TupleElementInfo]).flags
            }
            if middle_length = 2
            {
                if (first_flags & second_flags & ElementFlagsVariadic) <> 0
                {
                    ; Middle of target is [...T, ...U]: slice the source at T's
                    ; IMPLIED ARITY, which is the only thing that can say where one
                    ; variadic ends and the next begins.
                    let target_info Checker.get_inference_info_for_type(n, et[start_length])
                    if target_info <> null
                    {
                        let ti target_info as ref[InferenceInfo]
                        if ti.implied_arity >= 0
                        {
                            let head this.slice_tuple_type(source, start_length, end_length + source_arity - ti.implied_arity)
                            if this.unported_mark() <> mark
                                return
                            let tgt0 et[start_length]
                            if head <> null
                            {
                                if tgt0 <> null
                                {
                                    this.infer_from_types(n, head as ref[Type], tgt0 as ref[Type])
                                    if this.unported_mark() <> mark
                                        return
                                }
                            }
                            let tail this.slice_tuple_type(source, start_length + ti.implied_arity, end_length)
                            if this.unported_mark() <> mark
                                return
                            let tgt1 et[start_length + 1]
                            if tail <> null
                            {
                                if tgt1 <> null
                                {
                                    this.infer_from_types(n, tail as ref[Type], tgt1 as ref[Type])
                                    if this.unported_mark() <> mark
                                        return
                                }
                            }
                        }
                    }
                }
                else
                {
                    ; The other two pairings both take the implied arity from T's
                    ; CONSTRAINT rather than from the inference info, and both refuse
                    ; unless that constraint is a fixed-size tuple.
                    var variadic_then_rest false
                    if (first_flags & ElementFlagsVariadic) <> 0
                    {
                        if (second_flags & ElementFlagsRest) <> 0
                            set variadic_then_rest: true
                    }
                    var rest_then_variadic false
                    if (first_flags & ElementFlagsRest) <> 0
                    {
                        if (second_flags & ElementFlagsVariadic) <> 0
                            set rest_then_variadic: true
                    }
                    if variadic_then_rest
                    {
                        ; Middle of target is [...T, ...rest].
                        let info Checker.get_inference_info_for_type(n, et[start_length])
                        if info <> null
                        {
                            let ii info as ref[InferenceInfo]
                            if ii.type_parameter <> null
                            {
                                let constraint this.get_base_constraint_of_type(ii.type_parameter as ref[Type])
                                if this.unported_mark() <> mark
                                    return
                                if constraint <> null
                                {
                                    let ct constraint as ref[Type]
                                    if Checker.is_tuple_type(ct)
                                    {
                                        let ctt Checker.target_of(ct)
                                        if ctt <> null
                                        {
                                            let ctarget ctt as ref[Type]
                                            if (Checker.tuple_combined_flags_of(ctarget) & ElementFlagsVariable) = 0
                                            {
                                                let implied_arity Checker.tuple_fixed_length_of(ctarget)
                                                let head this.slice_tuple_type(source, start_length, source_arity - (start_length + implied_arity))
                                                if this.unported_mark() <> mark
                                                    return
                                                let tgt0 et[start_length]
                                                if head <> null
                                                {
                                                    if tgt0 <> null
                                                    {
                                                        this.infer_from_types(n, head as ref[Type], tgt0 as ref[Type])
                                                        if this.unported_mark() <> mark
                                                            return
                                                    }
                                                }
                                                let rest this.get_element_type_of_slice_of_tuple_type(source, start_length + implied_arity, end_length, false, false)
                                                if this.unported_mark() <> mark
                                                    return
                                                let tgt1 et[start_length + 1]
                                                if rest <> null
                                                {
                                                    if tgt1 <> null
                                                    {
                                                        this.infer_from_types(n, rest as ref[Type], tgt1 as ref[Type])
                                                        if this.unported_mark() <> mark
                                                            return
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if rest_then_variadic
                    {
                        ; Middle of target is [...rest, ...T]. ★The TRAILING slice is
                        ; built by hand rather than through slice_tuple_type, because
                        ; the reference takes a WINDOW `[startIndex:endIndex]` of the
                        ; source's arguments AND of its infos — neither end of it is
                        ; the tuple's own end.
                        let info Checker.get_inference_info_for_type(n, et[start_length + 1])
                        if info <> null
                        {
                            let ii info as ref[InferenceInfo]
                            if ii.type_parameter <> null
                            {
                                let constraint this.get_base_constraint_of_type(ii.type_parameter as ref[Type])
                                if this.unported_mark() <> mark
                                    return
                                if constraint <> null
                                {
                                    let ct constraint as ref[Type]
                                    if Checker.is_tuple_type(ct)
                                    {
                                        let ctt Checker.target_of(ct)
                                        if ctt <> null
                                        {
                                            let ctarget ctt as ref[Type]
                                            if (Checker.tuple_combined_flags_of(ctarget) & ElementFlagsVariable) = 0
                                            {
                                                let implied_arity Checker.tuple_fixed_length_of(ctarget)
                                                let end_index source_arity - Checker.end_element_count(tt, ElementFlagsFixed)
                                                let start_index end_index - implied_arity
                                                if start_index >= start_length
                                                {
                                                    ; ★`starget` was proven non-null by
                                                    ; the source_is_tuple block above, but
                                                    ; that narrowing is in another scope —
                                                    ; an `as ref[Type]` here would be an
                                                    ; exit-21 waiting for the day the
                                                    ; branch above changes.
                                                    if starget = null
                                                        return
                                                    let source_infos Checker.tuple_element_infos_of(starget as ref[Type])
                                                    if source_infos = null
                                                        return
                                                    let si source_infos as ref[Array[ref[TupleElementInfo]?]]
                                                    let window_types this.new_type_list(null)
                                                    let window_infos &Array[ref[TupleElementInfo]?]^host()
                                                    var w start_index
                                                    while w < end_index
                                                    {
                                                        if w >= 0
                                                        {
                                                            if w < (sa.get_length() as int)
                                                                window_types.add(sa[w])
                                                            if w < (si.get_length() as int)
                                                                window_infos.add(si[w])
                                                        }
                                                        set w: w + 1
                                                    }
                                                    let trailing this.create_tuple_type_ex(window_types, window_infos, false)
                                                    if this.unported_mark() <> mark
                                                        return
                                                    let rest this.get_element_type_of_slice_of_tuple_type(source, start_length, end_length + implied_arity, false, false)
                                                    if this.unported_mark() <> mark
                                                        return
                                                    let tgt0 et[start_length]
                                                    if rest <> null
                                                    {
                                                        if tgt0 <> null
                                                        {
                                                            this.infer_from_types(n, rest as ref[Type], tgt0 as ref[Type])
                                                            if this.unported_mark() <> mark
                                                                return
                                                        }
                                                    }
                                                    let tgt1 et[start_length + 1]
                                                    if trailing <> null
                                                    {
                                                        if tgt1 <> null
                                                        {
                                                            this.infer_from_types(n, trailing as ref[Type], tgt1 as ref[Type])
                                                            if this.unported_mark() <> mark
                                                                return
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if middle_length = 1
            {
                if (first_flags & ElementFlagsVariadic) <> 0
                {
                    ; Exactly one variadic in the middle: infer the slice between the
                    ; fixed parts. ★A target ending in an OPTIONAL element makes this
                    ; a SPECULATIVE inference rather than an ordinary one, which is
                    ; the reference's own priority term and not a refinement.
                    var priority 0
                    if (target_arity - 1) >= 0
                    {
                        if (target_arity - 1) < (ei.get_length() as int)
                        {
                            let last ei[target_arity - 1]
                            if last <> null
                            {
                                if ((last as ref[TupleElementInfo]).flags & ElementFlagsOptional) <> 0
                                    set priority: InferencePrioritySpeculativeTuple
                            }
                        }
                    }
                    let source_slice this.slice_tuple_type(source, start_length, end_length)
                    if this.unported_mark() <> mark
                        return
                    let tgt et[start_length]
                    if source_slice <> null
                    {
                        if tgt <> null
                        {
                            this.infer_with_priority(n, source_slice as ref[Type], tgt as ref[Type], priority)
                            if this.unported_mark() <> mark
                                return
                        }
                    }
                }
                if (first_flags & ElementFlagsRest) <> 0
                {
                    ; Exactly one rest element in the middle of the target: the union
                    ; of the source's middle element types.
                    let rest this.get_element_type_of_slice_of_tuple_type(source, start_length, end_length, false, false)
                    if this.unported_mark() <> mark
                        return
                    if rest <> null
                    {
                        let tgt et[start_length]
                        if tgt <> null
                        {
                            this.infer_from_types(n, rest as ref[Type], tgt as ref[Type])
                            if this.unported_mark() <> mark
                                return
                        }
                    }
                }
            }
        }
        var k 0
        while k < end_length
        {
            let si source_arity - k - 1
            let tix target_arity - k - 1
            if si >= 0
            {
                if si < (sa.get_length() as int)
                {
                    if tix >= 0
                    {
                        if tix < (et.get_length() as int)
                        {
                            let s sa[si]
                            let t et[tix]
                            if s <> null
                            {
                                if t <> null
                                {
                                    this.infer_from_types(n, s as ref[Type], t as ref[Type])
                                    if this.unported_mark() <> mark
                                        return
                                }
                            }
                        }
                    }
                }
            }
            set k: k + 1
        }
    }

    ; getEndElementCount — how many trailing element infos carry `flags`.
    function end_element_count(target: ref[Type], flags: int) returns int
    {
        let infos Checker.tuple_element_infos_of(target)
        if infos = null
            return 0
        let list infos as ref[Array[ref[TupleElementInfo]?]]
        let n list.get_length() as int
        var i n
        while i > 0
        {
            let row list[i - 1]
            if row = null
                return n - i
            if ((row as ref[TupleElementInfo]).flags & flags) = 0
                return n - i
            set i: i - 1
        }
        n
    }

    procedure infer_from_properties(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        let mark this.unported_mark()
        let props this.get_properties_of_object_type(target)
        if this.unported_mark() <> mark
            return
        if props = null
            return
        let list props as ref[Array[ref[Symbol]?]]
        let cnt list.get_length() as int
        var i 0
        while i < cnt
        {
            let e list[i]
            if e <> null
            {
                let target_prop e as ref[Symbol]
                let source_prop this.get_property_of_type(source, Symbol.name_of(target_prop))
                if this.unported_mark() <> mark
                    return
                if source_prop <> null
                {
                    ; `!core.Some(sourceProp.Declarations, c.isSkipDirectInferenceNode)`
                    ; — the set is empty in this port, so the conjunct is constant
                    ; true; see is_skip_direct_inference_node.
                    let sp source_prop as ref[Symbol]
                    let st this.get_type_of_symbol(sp)
                    if this.unported_mark() <> mark
                        return
                    let tt this.get_type_of_symbol(target_prop)
                    if this.unported_mark() <> mark
                        return
                    if st <> null
                    {
                        if tt <> null
                        {
                            let so this.remove_missing_type(st as ref[Type], (Symbol.flags_of(sp) & SymbolFlagsOptional) <> 0)
                            if this.unported_mark() <> mark
                                return
                            let to this.remove_missing_type(tt as ref[Type], (Symbol.flags_of(target_prop) & SymbolFlagsOptional) <> 0)
                            if this.unported_mark() <> mark
                                return
                            if so <> null
                            {
                                if to <> null
                                {
                                    this.infer_from_types(n, so as ref[Type], to as ref[Type])
                                    if this.unported_mark() <> mark
                                        return
                                }
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; inferFromSignatures. The pairing is BOTTOM-UP — a source with fewer
    ; signatures than the target infers from its first to the target's excess —
    ; and getBaseSignature / getErasedSignature are the two signature helpers this
    ; port does not have, so the loop body reports at its first pair.
    procedure infer_from_signatures(this, n: ref[InferenceState], source: ref[Type], target: ref[Type], kind: int)
    {
        let mark this.unported_mark()
        let ss this.get_signatures_of_type(source, kind)
        if this.unported_mark() <> mark
            return
        if ss = null
            return
        let slist ss as ref[Array[ref[Signature]?]]
        let source_len slist.get_length() as int
        if source_len = 0
            return
        let ts this.get_signatures_of_type(target, kind)
        if this.unported_mark() <> mark
            return
        if ts = null
            return
        let tlist ts as ref[Array[ref[Signature]?]]
        let target_len tlist.get_length() as int
        if target_len = 0
            return
        var i 0
        while i < target_len
        {
            var source_index source_len - target_len + i
            if source_index < 0
                set source_index: 0
            let se slist[source_index]
            let te tlist[i]
            if se <> null
            {
                if te <> null
                {
                    let base this.get_base_signature(se as ref[Signature])
                    if this.unported_mark() <> mark
                        return
                    let erased this.get_erased_signature(te as ref[Signature])
                    if this.unported_mark() <> mark
                        return
                    if base <> null
                    {
                        if erased <> null
                        {
                            this.infer_from_signature(n, base as ref[Signature], erased as ref[Signature])
                            if this.unported_mark() <> mark
                                return
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; ── getBaseSignature and getErasedSignature ─────────────────────────────
    ;
    ; ★★★ THE PAIR IS ASYMMETRIC AND THAT ASYMMETRY IS THE SPECIFICATION.
    ; inferFromSignatures takes the SOURCE's base signature — its type parameters
    ; replaced by their CONSTRAINTS — and the TARGET's erased signature — its type
    ; parameters replaced by `any`. So inferring from `<T>(x: T) => T` to
    ; `<U>(y: U) => U` relates `unknown` against `any` rather than relating two
    ; type parameters neither side can resolve.
    function signature_cache_lookup(this, sig: ref[Signature], kind: int) returns ref[Signature]?
    {
        if sig.cache_rows = null
            return null
        let rows sig.cache_rows as ref[Array[ref[CachedSignature]?]]
        let n rows.get_length() as int
        var i 0
        while i < n
        {
            let e rows[i]
            if e <> null
            {
                let row e as ref[CachedSignature]
                if row.kind = kind
                    return row.instantiation
            }
            set i: i + 1
        }
        null
    }

    procedure signature_cache_add(sig: ref[Signature], row: ref[CachedSignature])
    {
        if sig.cache_rows = null
        {
            let sig_page Page.get(sig)
            set sig.cache_rows: &Array[ref[CachedSignature]?]^sig_page()
        }
        (sig.cache_rows as ref[Array[ref[CachedSignature]?]]).add(row)
    }

    procedure get_base_signature(this, signature: ref[Signature]) returns ref[Signature]?
    {
        if signature.type_parameters = null
            return signature
        let tps signature.type_parameters as ref[Array[ref[Type]?]]
        let tpn tps.get_length() as int
        if tpn = 0
            return signature
        let cached this.signature_cache_lookup(signature, SignatureCacheKindBase)
        if cached <> null
            return cached
        let mark this.unported_mark()
        ; The constraint of each type parameter, `unknown` where there is none.
        let constraints &Array[ref[Type]?]^host()
        var i 0
        while i < tpn
        {
            let e tps[i]
            if e = null
                return null
            let c this.get_constraint_of_type_parameter(e as ref[Type])
            if this.unported_mark() <> mark
                return null
            if c = null
                constraints.add(unknown_type)
            else
                constraints.add(c)
            set i: i + 1
        }
        let constraint_mapper this.new_type_mapper(tps, constraints)
        var base_constraints &Array[ref[Type]?]^host()
        set i: 0
        while i < tpn
        {
            let e tps[i]
            if e = null
                return null
            let t this.instantiate_type(e, constraint_mapper)
            if this.unported_mark() <> mark
                return null
            base_constraints.add(t)
            set i: i + 1
        }
        ; "Run the immediate constraint mapper N-1 times so non-circular
        ; interdependent type parameters resolve to their external dependencies
        ; without adding an extra expansion step for self-recursive constraints."
        set i: 0
        while i < (tpn - 1)
        {
            let next this.instantiate_types(base_constraints, constraint_mapper)
            if this.unported_mark() <> mark
                return null
            if next = null
                return null
            set base_constraints: next as ref[Array[ref[Type]?]]
            set i: i + 1
        }
        ; "and then apply a type eraser to remove any remaining circularly
        ; dependent type parameters"
        let eraser this.new_array_to_single_type_mapper(tps, any_type)
        let erased_constraints this.instantiate_types(base_constraints, eraser)
        if this.unported_mark() <> mark
            return null
        if erased_constraints = null
            return null
        let result this.instantiate_signature_ex(signature, this.new_type_mapper(tps, erased_constraints as ref[Array[ref[Type]?]]), true)
        if this.unported_mark() <> mark
            return null
        if result = null
            return null
        let row &CachedSignature^host(signature, SignatureCacheKindBase, null, result)
        Checker.signature_cache_add(signature, row)
        result
    }

    procedure get_erased_signature(this, signature: ref[Signature]) returns ref[Signature]?
    {
        if signature.type_parameters = null
            return signature
        let tps signature.type_parameters as ref[Array[ref[Type]?]]
        if (tps.get_length() as int) = 0
            return signature
        let cached this.signature_cache_lookup(signature, SignatureCacheKindErased)
        if cached <> null
            return cached
        let mark this.unported_mark()
        let m this.new_array_to_single_type_mapper(tps, any_type)
        let erased this.instantiate_signature_ex(signature, m, true)
        if this.unported_mark() <> mark
            return null
        if erased = null
            return null
        let row &CachedSignature^host(signature, SignatureCacheKindErased, null, erased)
        Checker.signature_cache_add(signature, row)
        erased
    }

    ; ── the CANONICAL signature (slice 145) ──────────────────────────────────
    ;
    ; getCanonicalSignature + createCanonicalSignature, the third row of the same
    ; cache. The reference's own comment is the argument for it: *when a generic
    ; class or interface is instantiated, each generic method in it is instantiated
    ; with a fresh set of CLONED type parameters, which we need to handle scenarios
    ; where different generations of the same type parameter are in scope. This
    ; leads to a lot of new type identities* — so the canonicalisation replaces
    ; every UNCONSTRAINED clone by the original it was cloned from, and two
    ; comparisons of the same method through two instantiations then meet the same
    ; identities.
    ;
    ; ★★ THE PREDICATE IS `tp.Target() != nil && constraintOf(tp.Target()) == nil`
    ; AND BOTH HALVES MATTER. `Target()` is what makes it a CLONE rather than a
    ; declaration's own parameter, and the constraint is asked of the TARGET and not
    ; of the clone — a constrained parameter keeps its clone, because two
    ; generations of a constrained parameter can have different constraints and
    ; collapsing them would compare the wrong thing.
    procedure get_canonical_signature(this, signature: ref[Signature]) returns ref[Signature]?
    {
        if signature.type_parameters = null
            return signature
        let tps signature.type_parameters as ref[Array[ref[Type]?]]
        if (tps.get_length() as int) = 0
            return signature
        let cached this.signature_cache_lookup(signature, SignatureCacheKindCanonical)
        if cached <> null
            return cached
        let mark this.unported_mark()
        let canonical this.create_canonical_signature(signature)
        if this.unported_mark() <> mark
            return null
        if canonical = null
            return null
        let row &CachedSignature^host(signature, SignatureCacheKindCanonical, null, canonical)
        Checker.signature_cache_add(signature, row)
        canonical
    }

    procedure create_canonical_signature(this, signature: ref[Signature]) returns ref[Signature]?
    {
        let mark this.unported_mark()
        if signature.type_parameters = null
            return signature
        let tps signature.type_parameters as ref[Array[ref[Type]?]]
        let n tps.get_length() as int
        let type_arguments this.new_type_list(null)
        var i 0
        while i < n
        {
            let e tps[i]
            if e = null
                return null
            let tp e as ref[Type]
            var chosen tp
            let tgt Checker.target_of(tp)
            if tgt <> null
            {
                let c this.get_constraint_of_type_parameter(tgt as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if c = null
                    set chosen: tgt as ref[Type]
            }
            type_arguments.add(chosen)
            set i: i + 1
        }
        this.get_signature_instantiation(signature, type_arguments, Parser.is_in_js_file(signature.declaration), null)
    }

    ; ── instantiateSignatureInContextOf (slice 145) ──────────────────────────
    ;
    ; *Instantiate a generic signature in the context of a non-generic signature
    ; (section 3.8.5 in the TypeScript spec).* It runs a whole INFERENCE of the
    ; signature's own type parameters from the contextual signature's parameter
    ; types, and then instantiates with what came out — which is why the stop it
    ; replaces said the chapter *changes which SIGNATURE is compared and not only
    ; the answer*.
    ;
    ; ★★★ THE CLONE THE REFERENCE'S COMMENT TALKS ABOUT IS NOT A CLONE OF THE
    ; CONTEXT AND THE COMMENT IS IN THE WRONG PLACE. It reads *we clone the
    ; inferenceContext to avoid fixing*, but the line under it makes a FRESH
    ; context with `newInferenceContext` and then reads the PASSED context's mapper
    ; only to instantiate the contextual signature — the non-fixing mapper is the
    ; device, and `cloneInferenceContext` is not called here at all. Following the
    ; comment instead of the code would have added a clone with no reader.
    ;
    ; ★★ THE MAPPER CHOICE IS THE REST TYPE'S DOING: a rest type that is itself a
    ; type PARAMETER takes the NON-FIXING mapper, so that inferring the element
    ; type of `A`'s constraint for `T` leaves `[any]` inferable back to `A` later.
    ; With no inference context there is no mapper and the contextual signature is
    ; used as it stands.
    ;
    ; ★ The RETURN types are only applied when there is NO inference context, and
    ; the source there is the ORIGINAL contextual signature rather than the
    ; instantiated one — both are the reference's, and neither is symmetrical with
    ; the parameter call above it.
    procedure instantiate_signature_in_context_of(this, signature: ref[Signature], contextual_signature: ref[Signature], inference_context: ref[InferenceContext]?, compare_kind: int) returns ref[Signature]?
    {
        let mark this.unported_mark()
        let tps this.get_type_parameters_for_mapper(signature)
        if this.unported_mark() <> mark
            return null
        let context this.new_inference_context(tps, signature, InferenceFlagsNone, compare_kind)
        let rest_type this.get_effective_rest_type(contextual_signature)
        if this.unported_mark() <> mark
            return null
        var m: ref[TypeMapper]? null
        if inference_context <> null
        {
            let ic inference_context as ref[InferenceContext]
            var non_fixing false
            if rest_type <> null
            {
                if ((rest_type as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
                    set non_fixing: true
            }
            if non_fixing
                set m: ic.non_fixing_mapper
            else
                set m: ic.mapper
        }
        var source_signature: ref[Signature] contextual_signature
        if m <> null
        {
            let inst this.instantiate_signature(contextual_signature, m as ref[TypeMapper])
            if this.unported_mark() <> mark
                return null
            if inst = null
                return null
            set source_signature: inst as ref[Signature]
        }
        ; "Type parameters from outer context referenced by source type are fixed
        ; by instantiation of the source type."
        let param_cb &ApplyCallback^host(ApplyCallbackKindInferTypes, null, context.inferences, InferencePriorityNone, false)
        this.apply_to_parameter_types(param_cb, source_signature, signature)
        if this.unported_mark() <> mark
            return null
        if inference_context = null
        {
            let return_cb &ApplyCallback^host(ApplyCallbackKindInferTypes, null, context.inferences, InferencePriorityReturnType, false)
            this.apply_to_return_types(return_cb, contextual_signature, signature)
            if this.unported_mark() <> mark
                return null
        }
        let inferred this.get_inferred_types(context)
        if this.unported_mark() <> mark
            return null
        if inferred = null
            return null
        this.get_signature_instantiation(signature, inferred, Parser.is_in_js_file(contextual_signature.declaration), null)
    }

    procedure infer_from_signature(this, n: ref[InferenceState], source: ref[Signature], target: ref[Signature])
    {
        let mark this.unported_mark()
        if (source.flags & SignatureFlagsIsNonInferrable) = 0
        {
            let save_bivariant n.bivariant
            var kind KindUnknown
            if target.declaration <> null
                set kind: AstNode.kind_of(target.declaration as ref[AstNode])
            ; Once bivariant, bivariant for everything nested.
            if kind = KindMethodDeclaration
                set n.bivariant: true
            if kind = KindMethodSignature
                set n.bivariant: true
            if kind = KindConstructor
                set n.bivariant: true
            this.apply_to_parameter_types(&ApplyCallback^host(ApplyCallbackKindInferFromSignature, n, null, InferencePriorityNone, false), source, target)
            set n.bivariant: save_bivariant
            if this.unported_mark() <> mark
                return
        }
        this.apply_to_return_types(&ApplyCallback^host(ApplyCallbackKindInferFromSignature, n, null, InferencePriorityNone, false), source, target)
    }

    ; The callback of applyToParameterTypes, resolved. See the ApplyCallback header
    ; for why the parameter side and the return side need one of these each.
    procedure apply_parameter_callback(this, cb: ref[ApplyCallback], s: ref[Type], t: ref[Type])
    {
        if cb.kind = ApplyCallbackKindInferFromSignature
        {
            if cb.state = null
                return
            this.infer_from_contravariant_types_if_strict_function_types(cb.state as ref[InferenceState], s, t)
            return
        }
        if cb.inferences = null
            return
        this.infer_types(cb.inferences as ref[Array[ref[InferenceInfo]?]], s, t, cb.priority, cb.contravariant)
    }

    ; The callback of applyToReturnTypes. ★The InferFromSignature arm is
    ; `inferFromTypes` and NOT the contravariant-if-strict wrapper the parameter
    ; side gets — a return type is covariant, so the wrapper would be wrong here
    ; and it is the reason the tag names the caller rather than the callee.
    procedure apply_return_callback(this, cb: ref[ApplyCallback], s: ref[Type], t: ref[Type])
    {
        if cb.kind = ApplyCallbackKindInferFromSignature
        {
            if cb.state = null
                return
            this.infer_from_types(cb.state as ref[InferenceState], s, t)
            return
        }
        if cb.inferences = null
            return
        this.infer_types(cb.inferences as ref[Array[ref[InferenceInfo]?]], s, t, cb.priority, cb.contravariant)
    }

    ; applyToParameterTypes and applyToReturnTypes.
    ;
    ; ★★★ THE `callback` IS A TAG SINCE SLICE 145, AND THE NOTE THAT STOOD HERE
    ; PREDICTED THE DAY. It read *inference.go passes exactly ONE callback to each,
    ; so a tag would have a single value — the relater's own two calls pass a
    ; different pair and are still stops; the day one lands, the tag lands with it.*
    ; instantiateSignatureInContextOf is that call, so ApplyCallback exists and
    ; carries both shapes. **A deferral written at the line it changes was read by
    ; the slice that changed it, which is the whole of §0.4's argument.**
    procedure apply_to_parameter_types(this, cb: ref[ApplyCallback], source: ref[Signature], target: ref[Signature])
    {
        let mark this.unported_mark()
        let source_count this.get_parameter_count(source)
        if this.unported_mark() <> mark
            return
        let target_count this.get_parameter_count(target)
        if this.unported_mark() <> mark
            return
        let source_rest this.get_effective_rest_type(source)
        if this.unported_mark() <> mark
            return
        let target_rest this.get_effective_rest_type(target)
        if this.unported_mark() <> mark
            return
        var target_non_rest_count target_count
        if target_rest <> null
            set target_non_rest_count: target_non_rest_count - 1
        var param_count target_non_rest_count
        if source_rest = null
        {
            set param_count: source_count
            if target_non_rest_count < param_count
                set param_count: target_non_rest_count
        }
        let source_this this.get_this_type_of_signature(source)
        if this.unported_mark() <> mark
            return
        if source_this <> null
        {
            let target_this this.get_this_type_of_signature(target)
            if this.unported_mark() <> mark
                return
            if target_this <> null
                this.apply_parameter_callback(cb, source_this as ref[Type], target_this as ref[Type])
            if this.unported_mark() <> mark
                return
        }
        var i 0
        while i < param_count
        {
            let s this.get_type_at_position(source, i)
            if this.unported_mark() <> mark
                return
            let t this.get_type_at_position(target, i)
            if this.unported_mark() <> mark
                return
            if s <> null
            {
                if t <> null
                {
                    this.apply_parameter_callback(cb, s as ref[Type], t as ref[Type])
                    if this.unported_mark() <> mark
                        return
                }
            }
            set i: i + 1
        }
        if target_rest <> null
        {
            ; getRestTypeAtPosition over the SOURCE's remaining parameters, and its
            ; readonly argument is the reference's own conjunction: a const type
            ; variable receiving them, none of whose constituents is a mutable
            ; array-like. It is the call site §3.18's dropped parameter was a claim
            ; about — see get_rest_type_at_position.
            let tr target_rest as ref[Type]
            var readonly false
            if this.is_const_type_variable(tr, 0)
            {
                if this.some_type_is_mutable_array_like(tr) = false
                    set readonly: true
            }
            if this.unported_mark() <> mark
                return
            let source_rest this.get_rest_type_at_position(source, param_count, readonly)
            if this.unported_mark() <> mark
                return
            if source_rest <> null
                this.apply_parameter_callback(cb, source_rest as ref[Type], tr)
        }
    }

    ; applyToReturnTypes, whole since slice 131.
    ;
    ; ★★★ THE ROW THAT STOOD HERE WAS GUARDED BY A PREDICATE THAT HAD GONE
    ; BACKWARDS. signature_may_have_type_predicate answered *the declaration
    ; carries a type-predicate annotation*, and its note called that *the case
    ; where asking would be a stop* — which was true before slice 123 and is the
    ; exact OPPOSITE afterwards: an ANNOTATED predicate is the arm slice 123 wrote,
    ; and the only thing get_type_predicate_of_signature still stops on is the
    ; INFERRED one (getTypePredicateFromBody), which has no annotation at all. So
    ; the guard was routing the working case into a report. **A predicate named
    ; after another function's stops has to be re-read whenever that function
    ; moves; nothing here did.**
    ;
    ; ★ getTypePredicateOfSignature is asked on the TARGET first, and the SOURCE is
    ; only asked if the target has one: two matching predicates infer from
    ; predicate type to predicate type and from nothing else.
    procedure apply_to_return_types(this, cb: ref[ApplyCallback], source: ref[Signature], target: ref[Signature])
    {
        let mark this.unported_mark()
        let target_predicate this.get_type_predicate_of_signature(target)
        if this.unported_mark() <> mark
            return
        if target_predicate <> null
        {
            let tp target_predicate as ref[TypePredicate]
            let source_predicate this.get_type_predicate_of_signature(source)
            if this.unported_mark() <> mark
                return
            if source_predicate <> null
            {
                let sp source_predicate as ref[TypePredicate]
                if Checker.type_predicate_kinds_match(sp, tp)
                {
                    if sp.t <> null
                    {
                        if tp.t <> null
                        {
                            this.apply_return_callback(cb, sp.t as ref[Type], tp.t as ref[Type])
                            return
                        }
                    }
                }
            }
        }
        let target_return this.get_return_type_of_signature(target)
        if this.unported_mark() <> mark
            return
        if target_return = null
            return
        let could this.could_contain_type_variables(target_return as ref[Type])
        if this.unported_mark() <> mark
            return
        if could = false
            return
        let source_return this.get_return_type_of_signature(source)
        if this.unported_mark() <> mark
            return
        if source_return = null
            return
        this.apply_return_callback(cb, source_return as ref[Type], target_return as ref[Type])
    }

    procedure infer_from_index_types(this, n: ref[InferenceState], source: ref[Type], target: ref[Type])
    {
        let mark this.unported_mark()
        var priority InferencePriorityNone
        if ((source.object_flags & target.object_flags) & ObjectFlagsMapped) <> 0
            set priority: InferencePriorityHomomorphicMappedType
        let infos this.get_index_infos_of_type(target)
        if this.unported_mark() <> mark
            return
        if infos = null
            return
        let ilist infos as ref[Array[ref[IndexInfo]?]]
        let icnt ilist.get_length() as int
        let inferable this.is_object_type_with_inferable_index(source)
        if this.unported_mark() <> mark
            return
        if inferable
        {
            var i 0
            while i < icnt
            {
                let e ilist[i]
                if e <> null
                {
                    let target_info e as ref[IndexInfo]
                    let prop_types &Array[ref[Type]?]^host()
                    let props this.get_properties_of_type(source)
                    if this.unported_mark() <> mark
                        return
                    if props <> null
                    {
                        let plist props as ref[Array[ref[Symbol]?]]
                        let pcnt plist.get_length() as int
                        var j 0
                        while j < pcnt
                        {
                            let pe plist[j]
                            if pe <> null
                            {
                                let prop pe as ref[Symbol]
                                let name_type this.get_literal_type_from_property(prop, TypeFlagsStringOrNumberLiteralOrUnique, false)
                                if this.unported_mark() <> mark
                                    return
                                if name_type <> null
                                {
                                    if target_info.key_type <> null
                                    {
                                        let applicable this.is_applicable_index_type(name_type as ref[Type], target_info.key_type as ref[Type])
                                        if this.unported_mark() <> mark
                                            return
                                        if applicable
                                        {
                                            let pt this.get_type_of_symbol(prop)
                                            if this.unported_mark() <> mark
                                                return
                                            if pt <> null
                                            {
                                                var contributed pt
                                                if (Symbol.flags_of(prop) & SymbolFlagsOptional) <> 0
                                                {
                                                    ; ★The stop that stood here
                                                    ; named removeMissingOrUndefinedType
                                                    ; as absent; it is two
                                                    ; screens down the file.
                                                    set contributed: this.remove_missing_or_undefined_type(pt as ref[Type])
                                                    if this.unported_mark() <> mark
                                                        return
                                                }
                                                if contributed <> null
                                                    prop_types.add(contributed)
                                            }
                                        }
                                    }
                                }
                            }
                            set j: j + 1
                        }
                    }
                    let sinfos this.get_index_infos_of_type(source)
                    if this.unported_mark() <> mark
                        return
                    if sinfos <> null
                    {
                        let slist sinfos as ref[Array[ref[IndexInfo]?]]
                        let scnt slist.get_length() as int
                        var j 0
                        while j < scnt
                        {
                            let se slist[j]
                            if se <> null
                            {
                                let info se as ref[IndexInfo]
                                if info.key_type <> null
                                {
                                    if target_info.key_type <> null
                                    {
                                        let applicable this.is_applicable_index_type(info.key_type as ref[Type], target_info.key_type as ref[Type])
                                        if this.unported_mark() <> mark
                                            return
                                        if applicable
                                            prop_types.add(info.value_type)
                                    }
                                }
                            }
                            set j: j + 1
                        }
                    }
                    if (prop_types.get_length() as int) <> 0
                    {
                        let u this.get_union_type(prop_types)
                        if this.unported_mark() <> mark
                            return
                        if u <> null
                        {
                            if target_info.value_type <> null
                                this.infer_with_priority(n, u as ref[Type], target_info.value_type as ref[Type], priority)
                            if this.unported_mark() <> mark
                                return
                        }
                    }
                }
                set i: i + 1
            }
        }
        var i 0
        while i < icnt
        {
            let e ilist[i]
            if e <> null
            {
                let target_info e as ref[IndexInfo]
                if target_info.key_type <> null
                {
                    let source_info this.get_applicable_index_info(source, target_info.key_type as ref[Type])
                    if this.unported_mark() <> mark
                        return
                    if source_info <> null
                    {
                        let si source_info as ref[IndexInfo]
                        if si.value_type <> null
                        {
                            if target_info.value_type <> null
                            {
                                this.infer_with_priority(n, si.value_type as ref[Type], target_info.value_type as ref[Type], priority)
                                if this.unported_mark() <> mark
                                    return
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; isObjectTypeWithInferableIndex. The ReverseMapped arm is a stop rather than
    ; a recursion: this port has no reverse-mapped type to meet there.
    procedure is_object_type_with_inferable_index(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let list Checker.intersection_types_of(t)
            if list = null
                return false
            let types list as ref[Array[ref[Type]?]]
            let n types.get_length() as int
            var i 0
            while i < n
            {
                let e types[i]
                if e = null
                    return false
                if this.is_object_type_with_inferable_index(e as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        if t.symbol <> null
        {
            let sym t.symbol as ref[Symbol]
            let f Symbol.flags_of(sym)
            if (f & (SymbolFlagsObjectLiteral | SymbolFlagsTypeLiteral | SymbolFlagsEnum | SymbolFlagsValueModule)) <> 0
            {
                if (f & SymbolFlagsClass) = 0
                {
                    let mark this.unported_mark()
                    let has this.type_has_call_or_construct_signatures(t)
                    if this.unported_mark() <> mark
                        return false
                    if has = false
                        return true
                }
            }
        }
        if (t.object_flags & (ObjectFlagsJSLiteral | ObjectFlagsObjectRestType)) <> 0
            return true
        ; ★ Slice 160 closes this arm with the recursion the reference has: a
        ; reverse-mapped type has an inferable index exactly when its SOURCE has.
        if (t.object_flags & ObjectFlagsReverseMapped) <> 0
        {
            let src Checker.reverse_source_of(t)
            if src = null
                return false
            return this.is_object_type_with_inferable_index(src as ref[Type])
        }
        false
    }

    ; The two reverse memos' shared lookup — the reference's map keyed on
    ; `ReverseMappedTypeKey{sourceId, targetId, constraintId}`, as this file's
    ; linear scan (find_subtype_reduction's idiom). It answers the ROW so that the
    ; caller can tell a cached null from an absent key; see ReverseMappedRow.
    function find_reverse_row(rows: ref[Array[ref[ReverseMappedRow]?]], source_id: int, target_id: int, constraint_id: int) returns ref[ReverseMappedRow]?
    {
        let n rows.get_length() as int
        var i 0
        while i < n
        {
            let row rows[i]
            set i: i + 1
            if row = null
                continue
            let r row as ref[ReverseMappedRow]
            if r.source_id <> source_id
                continue
            if r.target_id <> target_id
                continue
            if r.constraint_id <> constraint_id
                continue
            return r
        }
        null
    }

    ; ══ THE REVERSE-MAPPED TYPE (slice 160) ═════════════════════════════════
    ;
    ; inferToMappedType and the whole family behind it: the homomorphic
    ; inference, createReverseMappedType, the ReverseMapped type kind, its member
    ; resolution and the reverse inference of one property's type.
    ;
    ; ★★★ WHAT THE CHAPTER IS. Inferring `S` to `{ [P in keyof T]: X }` cannot go
    ; property by property, because the target has no properties — it has a RULE.
    ; So the reference turns the question around: it builds an object with the same
    ; property NAMES as the source whose property TYPES are each inferred BACKWARDS
    ; through `X` (treating `T[P]` as the variable), and then infers from THAT
    ; object to `T`. The object is the ReverseMapped type, and it is lazy in two
    ; steps — its members are resolved on first ask, and each member's type on
    ; first read — because a reverse inference is a whole inference run per
    ; property.
    ;
    ; ★★ THE SECOND INFERENCE IS WHY THE PRIORITY EXISTS. `inferWithPriority` with
    ; HomomorphicMappedType keeps a DIRECT inference to `T` ahead of one made
    ; through `Partial<T>`, and PartialHomomorphicMappedType lowers it again where
    ; the source contains a non-inferrable type — a partial result is worth less
    ; than a whole one, which is a statement about the SOURCE and not about the
    ; mapping.
    procedure infer_to_mapped_type(this, n: ref[InferenceState], source: ref[Type], target: ref[Type], constraint_type: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        if (constraint_type.flags & (TypeFlagsUnion | TypeFlagsIntersection)) <> 0
        {
            ; Every constituent is asked and the answers are OR'd — `core.OrElse`
            ; over a bool — so a union constraint infers through each half.
            let list Checker.union_or_intersection_types_of(constraint_type)
            if list = null
                return false
            let types list as ref[Array[ref[Type]?]]
            let cnt types.get_length() as int
            var result false
            var i 0
            while i < cnt
            {
                let e types[i]
                set i: i + 1
                if e = null
                    continue
                if this.infer_to_mapped_type(n, source, target, e as ref[Type])
                    set result: true
                if this.unported_mark() <> mark
                    return result
            }
            return result
        }
        if (constraint_type.flags & TypeFlagsIndex) <> 0
        {
            ; The HOMOMORPHIC case: `{ [P in keyof T]: X }` where T is a variable.
            let index_target Checker.index_target_of(constraint_type)
            let inference Checker.get_inference_info_for_type(n, index_target)
            if inference = null
                return true
            let info inference as ref[InferenceInfo]
            if info.is_fixed
                return true
            if this.is_from_inference_blocked_source(source)
                return true
            let inferred this.infer_type_for_homomorphic_mapped_type(source, target, constraint_type)
            if this.unported_mark() <> mark
                return true
            if inferred = null
                return true
            var priority InferencePriorityHomomorphicMappedType
            if (source.object_flags & ObjectFlagsNonInferrableType) <> 0
                set priority: InferencePriorityPartialHomomorphicMappedType
            let tp info.type_parameter
            if tp = null
                return true
            this.infer_with_priority(n, inferred as ref[Type], tp as ref[Type], priority)
            return true
        }
        if (constraint_type.flags & TypeFlagsTypeParameter) <> 0
        {
            ; `{ [P in K]: X }` with K a type parameter: first infer from `keyof S`
            ; to K.
            var index_flags IndexFlagsNone
            if this.pattern_for_type(source) <> null
                set index_flags: IndexFlagsNoIndexSignatures
            let keyof this.get_index_type_ex(source, index_flags)
            if this.unported_mark() <> mark
                return true
            if keyof = null
            {
                this.record_unported("infer-to-mapped-type-keyof-source", source.object_flags)
                return true
            }
            this.infer_with_priority(n, keyof as ref[Type], constraint_type, InferencePriorityMappedTypeConstraint)
            if this.unported_mark() <> mark
                return true
            ; If K is constrained to C, make the same inferences as for the
            ; homomorphic shape — this is what makes `Pick<T, K>` meaningful.
            let extended this.get_constraint_of_type(constraint_type)
            if this.unported_mark() <> mark
                return true
            if extended <> null
            {
                if this.infer_to_mapped_type(n, source, target, extended as ref[Type])
                    return true
                if this.unported_mark() <> mark
                    return true
            }
            ; And otherwise from a union of the source's property and index types
            ; to the template type X.
            let all &Array[ref[Type]?]()
            let props this.get_properties_of_type(source)
            if this.unported_mark() <> mark
                return true
            if props <> null
            {
                let list props as ref[Array[ref[Symbol]?]]
                let pn list.get_length() as int
                var i 0
                while i < pn
                {
                    let row list[i]
                    set i: i + 1
                    if row = null
                        continue
                    let pt this.get_type_of_symbol(row as ref[Symbol])
                    if this.unported_mark() <> mark
                        return true
                    all.add(pt)
                }
            }
            let infos this.get_index_infos_of_type(source)
            if this.unported_mark() <> mark
                return true
            if infos <> null
            {
                let list infos as ref[Array[ref[IndexInfo]?]]
                let inn list.get_length() as int
                var i 0
                while i < inn
                {
                    let row list[i]
                    set i: i + 1
                    if row = null
                        continue
                    let info row as ref[IndexInfo]
                    ; The enum's own number index info contributes `never`, which
                    ; is upstream's way of saying an enum's numeric index is not a
                    ; property of the source for this purpose.
                    var v: ref[Type]? never_type
                    if enum_number_index_info = null
                        set v: info.value_type
                    else
                    {
                        if (enum_number_index_info as ref[IndexInfo]) <> info
                            set v: info.value_type
                    }
                    all.add(v)
                }
            }
            let u this.get_union_type(all)
            if this.unported_mark() <> mark
                return true
            if u = null
            {
                this.record_unported("infer-to-mapped-type-source-union", source.object_flags)
                return true
            }
            let template this.get_template_type_from_mapped_type(target)
            if this.unported_mark() <> mark
                return true
            if template = null
            {
                this.record_unported("infer-to-mapped-type-template", target.object_flags)
                return true
            }
            this.infer_from_types(n, u as ref[Type], template as ref[Type])
            return true
        }
        false
    }

    ; inferTypeForHomomorphicMappedType — createReverseMappedType behind a memo on
    ; the triple (source, target, constraint).
    ;
    ; ★ The memo is read as *non-null* rather than as *present*, which is the
    ; reference's own asymmetry with the other reverse table: a null answer here
    ; is recomputed. See ReverseMappedRow's note.
    procedure infer_type_for_homomorphic_mapped_type(this, source: ref[Type], target: ref[Type], constraint: ref[Type]) returns ref[Type]?
    {
        let cached Checker.find_reverse_row(reverse_homomorphic_cache, source.id, target.id, constraint.id)
        if cached <> null
        {
            let row cached as ref[ReverseMappedRow]
            if row.result <> null
                return row.result
        }
        let mark this.unported_mark()
        let made this.create_reverse_mapped_type(source, target, constraint)
        if this.unported_mark() <> mark
            return null
        let row &ReverseMappedRow^this(source.id, target.id, constraint.id, made) as ref[ReverseMappedRow]?
        reverse_homomorphic_cache.add(row)
        made
    }

    ; createReverseMappedType. The three shapes are the reference's: an array and a
    ; tuple get the mapping applied to their ELEMENT types eagerly, every other
    ; object type gets the lazy ReverseMapped kind.
    ;
    ; ★★ THE GUARD IS THE CHAPTER'S ADMISSION TEST — *a source is reverse mappable
    ; if it has a string index signature, or has properties and is partially
    ; inferable*. A null here is an ANSWER (the reference returns nil), not a hole,
    ; which is why nothing reports.
    procedure create_reverse_mapped_type(this, source: ref[Type], target: ref[Type], constraint: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let string_index this.get_index_info_of_type(source, string_type)
        if this.unported_mark() <> mark
            return null
        if string_index = null
        {
            let props this.get_properties_of_type(source)
            if this.unported_mark() <> mark
                return null
            var any_props false
            if props <> null
            {
                if ((props as ref[Array[ref[Symbol]?]]).get_length() as int) <> 0
                    set any_props: true
            }
            if any_props = false
                return null
            if this.is_partially_inferable_type(source) = false
                return null
            if this.unported_mark() <> mark
                return null
        }
        if this.is_array_type(source)
        {
            let args this.get_type_arguments(source)
            if this.unported_mark() <> mark
                return null
            if args = null
                return null
            let list args as ref[Array[ref[Type]?]]
            if (list.get_length() as int) = 0
                return null
            let first list[0]
            if first = null
                return null
            let element this.infer_reverse_mapped_type(first as ref[Type], target, constraint)
            if this.unported_mark() <> mark
                return null
            if element = null
                return null
            return this.create_array_type_ex(element, this.is_readonly_array_type(source))
        }
        if Checker.is_tuple_type(source)
        {
            let elements this.get_element_types(source)
            if this.unported_mark() <> mark
                return null
            if elements = null
                return null
            let list elements as ref[Array[ref[Type]?]]
            let cnt list.get_length() as int
            let mapped_elements this.new_type_list(null)
            var i 0
            while i < cnt
            {
                let e list[i]
                set i: i + 1
                if e = null
                    return null
                let m this.infer_reverse_mapped_type(e as ref[Type], target, constraint)
                if this.unported_mark() <> mark
                    return null
                ; core.Every over the results: one nil and the whole tuple is not
                ; reverse mappable.
                if m = null
                    return null
                mapped_elements.add(m)
            }
            let tuple_target Checker.get_target_type(source)
            let infos Checker.tuple_element_infos_of(tuple_target)
            if infos = null
                return null
            var element_infos infos as ref[Array[ref[TupleElementInfo]?]]
            ; An OPTIONAL element becomes REQUIRED where the mapping adds `?`,
            ; because the mapped type will put the optionality back on.
            if (Checker.get_mapped_type_modifiers(target) & MappedTypeModifiersIncludeOptional) <> 0
            {
                let same &Array[ref[TupleElementInfo]?]^host()
                let inn element_infos.get_length() as int
                var j 0
                while j < inn
                {
                    let row element_infos[j]
                    set j: j + 1
                    if row = null
                    {
                        same.add(row)
                        continue
                    }
                    let info row as ref[TupleElementInfo]
                    if (info.flags & ElementFlagsOptional) = 0
                    {
                        same.add(row)
                        continue
                    }
                    let required &TupleElementInfo^host(ElementFlagsRequired, info.labeled_declaration) as ref[TupleElementInfo]?
                    same.add(required)
                }
                set element_infos: same as ref[Array[ref[TupleElementInfo]?]]
            }
            return this.create_tuple_type_ex(mapped_elements, element_infos, Checker.tuple_readonly_of(tuple_target))
        }
        let reversed this.new_object_type(ObjectFlagsReverseMapped | ObjectFlagsAnonymous, null)
        if reversed = null
            return null
        let rt reversed as ref[Type]
        Checker.set_reverse_mapped_slots(rt, source, target, constraint)
        rt
    }

    ; isPartiallyInferableType — *not marked non-inferable, or an object literal
    ; with at least one property of an inferable type, or a tuple with one*. The
    ; three disjuncts are the reference's and the recursion is over the properties.
    procedure is_partially_inferable_type(this, t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsNonInferrableType) = 0
            return true
        let mark this.unported_mark()
        if Checker.is_object_literal_type(t)
        {
            let props this.get_properties_of_type(t)
            if this.unported_mark() <> mark
                return false
            if props <> null
            {
                let list props as ref[Array[ref[Symbol]?]]
                let pn list.get_length() as int
                var i 0
                while i < pn
                {
                    let row list[i]
                    set i: i + 1
                    if row = null
                        continue
                    let pt this.get_type_of_symbol(row as ref[Symbol])
                    if this.unported_mark() <> mark
                        return false
                    if pt = null
                        continue
                    if this.is_partially_inferable_type(pt as ref[Type])
                        return true
                    if this.unported_mark() <> mark
                        return false
                }
            }
        }
        if Checker.is_tuple_type(t)
        {
            let elements this.get_element_types(t)
            if this.unported_mark() <> mark
                return false
            if elements <> null
            {
                let list elements as ref[Array[ref[Type]?]]
                let cnt list.get_length() as int
                var i 0
                while i < cnt
                {
                    let e list[i]
                    set i: i + 1
                    if e = null
                        continue
                    if this.is_partially_inferable_type(e as ref[Type])
                        return true
                    if this.unported_mark() <> mark
                        return false
                }
            }
        }
        false
    }

    ; inferReverseMappedType — the memo, the recursion guard and the worker.
    ;
    ; ★★★ THE MEMO HERE IS READ AS *PRESENT*, so a null result is an ANSWER and
    ; the caller turns it into `unknownType`. That is what makes the guard below
    ; terminating: a source that is deeply nested twice over stores its null and
    ; every later arrival reads it instead of descending again.
    procedure infer_reverse_mapped_type(this, source: ref[Type], target: ref[Type], constraint: ref[Type]) returns ref[Type]?
    {
        let cached Checker.find_reverse_row(reverse_mapped_cache, source.id, target.id, constraint.id)
        if cached <> null
        {
            let row cached as ref[ReverseMappedRow]
            if row.result = null
                return unknown_type
            return row.result
        }
        let mark this.unported_mark()
        reverse_mapped_source_stack.add(source as ref[Type]?)
        reverse_mapped_target_stack.add(target as ref[Type]?)
        let save_expanding reverse_expanding_flags
        if this.is_deeply_nested_type_in(source, reverse_mapped_source_stack, 0, reverse_mapped_source_stack.get_length() as int, 2)
            set reverse_expanding_flags: reverse_expanding_flags | ExpandingFlagsSource
        if this.is_deeply_nested_type_in(target, reverse_mapped_target_stack, 0, reverse_mapped_target_stack.get_length() as int, 2)
            set reverse_expanding_flags: reverse_expanding_flags | ExpandingFlagsTarget
        var t: ref[Type]? null
        if reverse_expanding_flags <> ExpandingFlagsBoth
            set t: this.infer_reverse_mapped_type_worker(source, target, constraint)
        this.pop_type_stack(reverse_mapped_target_stack)
        this.pop_type_stack(reverse_mapped_source_stack)
        set reverse_expanding_flags: save_expanding
        ; ★ A stop must not leave a memo behind: the row would answer for a
        ; computation that never finished, and every later arrival would read it.
        if this.unported_mark() <> mark
            return null
        let row &ReverseMappedRow^this(source.id, target.id, constraint.id, t) as ref[ReverseMappedRow]?
        reverse_mapped_cache.add(row)
        if t = null
            return unknown_type
        t
    }

    ; inferReverseMappedTypeWorker — ONE inference run per property, with `T[P]`
    ; standing in for the variable being inferred.
    procedure infer_reverse_mapped_type_worker(this, source: ref[Type], target: ref[Type], constraint: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let index_target Checker.index_target_of(constraint)
        if index_target = null
            return null
        let tp this.get_type_parameter_from_mapped_type(target)
        if this.unported_mark() <> mark
            return null
        if tp = null
            return null
        let type_parameter this.get_indexed_access_type(index_target as ref[Type], tp as ref[Type])
        if this.unported_mark() <> mark
            return null
        if type_parameter = null
            return null
        let template this.get_template_type_from_mapped_type(target)
        if this.unported_mark() <> mark
            return null
        if template = null
            return null
        let inference this.new_inference_info(type_parameter)
        let inferences &Array[ref[InferenceInfo]?]^host()
        inferences.add(inference as ref[InferenceInfo]?)
        this.infer_types(inferences as ref[Array[ref[InferenceInfo]?]], source, template, InferencePriorityNone, false)
        if this.unported_mark() <> mark
            return null
        var inferred this.get_type_from_inference(inference)
        if this.unported_mark() <> mark
            return null
        if inferred = null
            set inferred: unknown_type
        this.get_widened_type(inferred as ref[Type])
    }

    ; resolveReverseMappedTypeMembers — one synthesized property per property of
    ; the source, each carrying what its type will have to be inferred back
    ; through. The type itself is NOT computed here; get_type_of_reverse_mapped_
    ; symbol does that on first read.
    procedure resolve_reverse_mapped_type_members(this, t: ref[Type])
    {
        let mark this.unported_mark()
        let source_opt Checker.reverse_source_of(t)
        let mapped_opt Checker.reverse_mapped_type_of(t)
        let constraint_opt Checker.reverse_constraint_type_of(t)
        if source_opt = null
        {
            this.record_unported("reverse-mapped-members-no-source", t.object_flags)
            return
        }
        if mapped_opt = null
        {
            this.record_unported("reverse-mapped-members-no-mapped", t.object_flags)
            return
        }
        if constraint_opt = null
        {
            this.record_unported("reverse-mapped-members-no-constraint", t.object_flags)
            return
        }
        let source source_opt as ref[Type]
        let mapped mapped_opt as ref[Type]
        let constraint constraint_opt as ref[Type]
        let index_info this.get_index_info_of_type(source, string_type)
        if this.unported_mark() <> mark
            return
        let modifiers Checker.get_mapped_type_modifiers(mapped)
        var readonly_mask true
        if (modifiers & MappedTypeModifiersIncludeReadonly) <> 0
            set readonly_mask: false
        var optional_mask SymbolFlagsOptional
        if (modifiers & MappedTypeModifiersIncludeOptional) <> 0
            set optional_mask: 0
        var index_infos: ref[Array[ref[IndexInfo]?]]? null
        if index_info <> null
        {
            let ii index_info as ref[IndexInfo]
            var value this.infer_reverse_mapped_type(ii.value_type as ref[Type], mapped, constraint)
            if this.unported_mark() <> mark
                return
            if value = null
                set value: unknown_type
            var ro false
            if readonly_mask
            {
                if ii.is_readonly
                    set ro: true
            }
            let made this.new_index_info_list()
            made.add(this.new_index_info(string_type, value, ro, null) as ref[IndexInfo]?)
            set index_infos: made as ref[Array[ref[IndexInfo]?]]?
        }
        let members SymbolTable.create(host)
        let limited this.get_limited_constraint(t)
        if this.unported_mark() <> mark
            return
        let props this.get_properties_of_type(source)
        if this.unported_mark() <> mark
            return
        if props <> null
        {
            let list props as ref[Array[ref[Symbol]?]]
            let pn list.get_length() as int
            var i 0
            while i < pn
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let prop row as ref[Symbol]
                ; With an intersection constraint whose filtering literals could be
                ; extracted, a property not assignable to them is skipped — the
                ; mapping would not let it through anyway.
                if limited <> null
                {
                    let name_type this.get_literal_type_from_property(prop, TypeFlagsStringOrNumberLiteralOrUnique, false)
                    if this.unported_mark() <> mark
                        return
                    if name_type = null
                        continue
                    if this.is_type_assignable_to(name_type as ref[Type], limited as ref[Type]) = false
                        continue
                    if this.unported_mark() <> mark
                        return
                }
                var check_flags CheckFlagsReverseMapped
                if readonly_mask
                {
                    if this.is_readonly_symbol(prop)
                        set check_flags: check_flags | CheckFlagsReadonly
                    if this.unported_mark() <> mark
                        return
                }
                let name Symbol.name_of(prop)
                let inferred_prop this.new_symbol_ex(SymbolFlagsProperty | (Symbol.flags_of(prop) & optional_mask), name, check_flags)
                Symbol.share_declarations(inferred_prop, prop)
                let plinks this.value_symbol_link_of(inferred_prop)
                set plinks.name_type: this.value_symbol_link_of(prop).name_type
                let pt this.get_type_of_symbol(prop)
                if this.unported_mark() <> mark
                    return
                let vsx_148417 this.value_symbol_extra(plinks)
                set vsx_148417.reverse_property_type: pt
                ; A reverse mapping of `{[K in keyof T[K_1]]: T[K_1]}` is the same
                ; as that of `{[K in keyof T]: T}` — all that matters is the shared
                ; variable — so the indexed access is simplified to keep the number
                ; of type identities down.
                let constraint_target Checker.index_target_of(constraint)
                var simplified false
                if constraint_target <> null
                {
                    let ct constraint_target as ref[Type]
                    if (ct.flags & TypeFlagsIndexedAccess) <> 0
                    {
                        let obj Checker.indexed_access_object_type_of(ct)
                        let idx Checker.indexed_access_index_type_of(ct)
                        if obj <> null
                        {
                            if idx <> null
                            {
                                if ((obj as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
                                {
                                    if ((idx as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
                                    {
                                        let new_type_param obj as ref[Type]
                                        let new_mapped this.replace_indexed_access(mapped, ct, new_type_param)
                                        if this.unported_mark() <> mark
                                            return
                                        let new_constraint this.get_index_type(new_type_param)
                                        if this.unported_mark() <> mark
                                            return
                                        let vsx_148446 this.value_symbol_extra(plinks)
                                        set vsx_148446.reverse_mapped_type: new_mapped
                                        let vsx_148447 this.value_symbol_extra(plinks)
                                        set vsx_148447.reverse_constraint_type: new_constraint
                                        set simplified: true
                                    }
                                }
                            }
                        }
                    }
                }
                if simplified = false
                {
                    let vsx_148457 this.value_symbol_extra(plinks)
                    set vsx_148457.reverse_mapped_type: mapped
                    let vsx_148458 this.value_symbol_extra(plinks)
                    set vsx_148458.reverse_constraint_type: constraint
                }
                SymbolTable.set_entry(host, members, name, inferred_prop)
            }
        }
        this.set_structured_type_members(t, members, null, null, index_infos)
    }

    ; getTypeOfReverseMappedSymbol — the property's type, inferred back through
    ; the mapping on first read and memoised on the symbol's own link.
    procedure get_type_of_reverse_mapped_symbol(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.resolved_type <> null
            return links.resolved_type
        let pt this.value_symbol_extra_read(links).reverse_property_type
        let mt this.value_symbol_extra_read(links).reverse_mapped_type
        let ct this.value_symbol_extra_read(links).reverse_constraint_type
        if pt = null
            return null
        if mt = null
            return null
        if ct = null
            return null
        let mark this.unported_mark()
        var t this.infer_reverse_mapped_type(pt as ref[Type], mt as ref[Type], ct as ref[Type])
        if this.unported_mark() <> mark
            return null
        if t = null
            set t: unknown_type
        set links.resolved_type: t
        links.resolved_type
    }

    ; getLimitedConstraint — where the mapped type's constraint was an
    ; INTERSECTION, its filtering literals, so that resolve_reverse_mapped_type_
    ; members can drop the properties the mapping would never produce.
    ;
    ; ★ The attempt is made even where the intersection has been REDUCED to a
    ; union, which is what the `origin` read is for: a union that came out of an
    ; intersection remembers the intersection it was.
    procedure get_limited_constraint(this, t: ref[Type]) returns ref[Type]?
    {
        let mapped Checker.reverse_mapped_type_of(t)
        if mapped = null
            return null
        let constraint_target Checker.reverse_constraint_type_of(t)
        if constraint_target = null
            return null
        let mark this.unported_mark()
        let constraint_opt this.get_constraint_type_from_mapped_type(mapped as ref[Type])
        if this.unported_mark() <> mark
            return null
        if constraint_opt = null
            return null
        let constraint constraint_opt as ref[Type]
        if (constraint.flags & (TypeFlagsUnion | TypeFlagsIntersection)) = 0
            return null
        var origin: ref[Type]? constraint
        if (constraint.flags & TypeFlagsUnion) <> 0
            set origin: Checker.union_origin_of(constraint)
        if origin = null
            return null
        if ((origin as ref[Type]).flags & TypeFlagsIntersection) = 0
            return null
        let list Checker.union_or_intersection_types_of(origin as ref[Type])
        if list = null
            return null
        let types list as ref[Array[ref[Type]?]]
        let cnt types.get_length() as int
        let kept &Array[ref[Type]?]()
        var i 0
        while i < cnt
        {
            let e types[i]
            set i: i + 1
            if e = null
                continue
            if e = constraint_target
                continue
            kept.add(e)
        }
        let limited this.get_intersection_type(kept)
        if this.unported_mark() <> mark
            return null
        if limited = null
            return null
        if (limited as ref[Type]) = never_type
            return null
        limited
    }

    ; replaceIndexedAccess — map `t.indexType` to `0` and `t.objectType` to
    ; `[TReplacement]`, which turns the indexed access `T[K]` into
    ; `[TReplacement][0]`, i.e. into TReplacement itself.
    procedure replace_indexed_access(this, instantiable: ref[Type], t: ref[Type], replacement: ref[Type]) returns ref[Type]?
    {
        let idx Checker.indexed_access_index_type_of(t)
        let obj Checker.indexed_access_object_type_of(t)
        if idx = null
            return null
        if obj = null
            return null
        let sources this.new_type_list_of(2)
        sources.add(idx)
        sources.add(obj)
        let mark this.unported_mark()
        let zero: ref[Type]? this.get_number_literal_type(Checker.number_bits_from_int(0))
        let one_element this.new_type_list_of(1)
        one_element.add(replacement as ref[Type]?)
        let tuple this.create_tuple_type(one_element)
        if this.unported_mark() <> mark
            return null
        if tuple = null
            return null
        let targets this.new_type_list_of(2)
        targets.add(zero)
        targets.add(tuple)
        let m this.new_type_mapper(sources, targets)
        this.instantiate_type(instantiable, m)
    }

    ; ── typesDefinitelyUnrelated and the two tuple predicates ───────────────

    procedure types_definitely_unrelated(this, source: ref[Type], target: ref[Type]) returns bool
    {
        if Checker.is_tuple_type(source)
        {
            if Checker.is_tuple_type(target)
                return Checker.tuple_types_definitely_unrelated(source, target)
        }
        let mark this.unported_mark()
        let a this.get_unmatched_property_ex(source, target, false, true)
        if this.unported_mark() <> mark
            return false
        if a = null
            return false
        let b this.get_unmatched_property(target, source, false)
        if this.unported_mark() <> mark
            return false
        b <> null
    }

    function tuple_types_definitely_unrelated(source: ref[Type], target: ref[Type]) returns bool
    {
        let st Checker.target_of(source)
        let tt Checker.target_of(target)
        if st = null
            return false
        if tt = null
            return false
        let s st as ref[Type]
        let t tt as ref[Type]
        if (Checker.tuple_combined_flags_of(t) & ElementFlagsVariadic) = 0
        {
            if Checker.tuple_min_length_of(t) > Checker.tuple_min_length_of(s)
                return true
        }
        if (Checker.tuple_combined_flags_of(t) & ElementFlagsVariable) = 0
        {
            if (Checker.tuple_combined_flags_of(s) & ElementFlagsVariable) <> 0
                return true
            if Checker.tuple_fixed_length_of(t) < Checker.tuple_fixed_length_of(s)
                return true
        }
        false
    }

    function is_tuple_type_structure_matching(this, t1: ref[Type], t2: ref[Type]) returns bool
    {
        if Checker.get_type_reference_arity(t1) <> Checker.get_type_reference_arity(t2)
            return false
        let a Checker.target_of(t1)
        let b Checker.target_of(t2)
        if a = null
            return false
        if b = null
            return false
        let ia Checker.tuple_element_infos_of(a as ref[Type])
        let ib Checker.tuple_element_infos_of(b as ref[Type])
        if ia = null
            return false
        if ib = null
            return false
        let la ia as ref[Array[ref[TupleElementInfo]?]]
        let lb ib as ref[Array[ref[TupleElementInfo]?]]
        let n la.get_length() as int
        if (lb.get_length() as int) <> n
            return false
        var i 0
        while i < n
        {
            let ra la[i]
            let rb lb[i]
            if ra = null
                return false
            if rb = null
                return false
            let fa (ra as ref[TupleElementInfo]).flags & ElementFlagsVariable
            let fb (rb as ref[TupleElementInfo]).flags & ElementFlagsVariable
            if fa <> fb
                return false
            set i: i + 1
        }
        true
    }

    ; isTypeOrBaseIdenticalTo — identity, or a literal against the primitive it
    ; widens to. The `missingType` arm is an IDENTITY test on purpose: the missing
    ; type is only ever itself.
    procedure is_type_or_base_identical_to(this, s: ref[Type], t: ref[Type]) returns bool
    {
        if t = missing_type
            return s = t
        if this.is_type_identical_to(s, t)
            return true
        if (t.flags & TypeFlagsString) <> 0
        {
            if (s.flags & TypeFlagsStringLiteral) <> 0
                return true
        }
        if (t.flags & TypeFlagsNumber) <> 0
        {
            if (s.flags & TypeFlagsNumberLiteral) <> 0
                return true
        }
        false
    }

    ; isTypeCloselyMatchedBy — two instantiations of the same object type, or of
    ; the same generic type alias.
    function is_type_closely_matched_by(s: ref[Type], t: ref[Type]) returns bool
    {
        if (s.flags & TypeFlagsObject) <> 0
        {
            if (t.flags & TypeFlagsObject) <> 0
            {
                if s.symbol <> null
                {
                    if s.symbol = t.symbol
                        return true
                }
            }
        }
        if s.alias_symbol <> null
        {
            if t.alias_symbol <> null
            {
                if s.alias_type_arguments <> null
                {
                    if ((s.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                    {
                        if s.alias_symbol = t.alias_symbol
                            return true
                    }
                }
            }
        }
        false
    }

    ; createEmptyObjectTypeFromStringLiteral — one `any` property per string
    ; literal constituent, plus a string index signature when `string` itself is
    ; in there. It is what makes `keyof T` inferable from a string literal.
    procedure create_empty_object_type_from_string_literal(this, t: ref[Type]) returns ref[Type]?
    {
        let members SymbolTable.create(host)
        var list Checker.union_types_of(t)
        let one &Array[ref[Type]?]^host()
        if list = null
        {
            one.add(t)
            set list: one
        }
        let types list as ref[Array[ref[Type]?]]
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                let lit e as ref[Type]
                if (lit.flags & TypeFlagsStringLiteral) <> 0
                {
                    let nd Checker.literal_text_of(lit)
                    let nl Checker.literal_text_length_of(lit)
                    let prop this.new_symbol(SymbolFlagsProperty, nd)
                    let links this.value_symbol_link_of(prop)
                    set links.resolved_type: any_type
                    if lit.symbol <> null
                        Symbol.copy_declarations_from(prop, lit.symbol as ref[Symbol])
                    SymbolTable.set_entry(host, members, nd, prop)
                }
            }
            set i: i + 1
        }
        var index_infos: ref[Array[ref[IndexInfo]?]]? null
        if (t.flags & TypeFlagsString) <> 0
        {
            let ii &Array[ref[IndexInfo]?]^host()
            ii.add(this.new_index_info(string_type, empty_object_type, false, null) as ref[IndexInfo]?)
            set index_infos: ii
        }
        this.new_anonymous_type(null, members, null, null, index_infos)
    }

    ; isFromInferenceBlockedSource and isSkipDirectInferenceNode.
    ;
    ; ★★★ THE SET IS EMPTY IN THIS PORT AND THAT IS A PROPERTY OF ITS ONE WRITER,
    ; NOT OF THIS SLICE. `c.skipDirectInferenceNodes` is filled by
    ; checkExpressionForMutableLocationWithNoDirectInference, which is reached only
    ; from a JavaScript `module.exports` assignment — so the predicate is FALSE
    ; here, the conjunct it guards in inferFromProperties is constant true, and
    ; the day that chapter lands the set lands with it (§3.5be read the other way:
    ; a field whose only writer is unported is a claim about the future).
    function is_skip_direct_inference_node(this, node: ref[AstNode]) returns bool
        false

    function is_from_inference_blocked_source(this, t: ref[Type]) returns bool
        false

    ; ── from candidates to a type ───────────────────────────────────────────

    ; getNullableType.
    procedure get_nullable_type(this, t: ref[Type], flags: int) returns ref[Type]?
    {
        let missing (flags & ~t.flags) & (TypeFlagsUndefined | TypeFlagsNull)
        if missing = 0
            return t
        let list &Array[ref[Type]?]^host()
        list.add(t)
        if missing <> TypeFlagsNull
            list.add(undefined_type)
        if missing <> TypeFlagsUndefined
            list.add(null_type)
        this.get_union_type(list)
    }

    ; getCombinedTypeFlags — the flags of every constituent, flattening unions.
    function get_combined_type_flags(t_list: ref[Array[ref[Type]?]]) returns int
    {
        var flags TypeFlagsNone
        let n t_list.get_length() as int
        var i 0
        while i < n
        {
            let e t_list[i]
            if e <> null
            {
                let t e as ref[Type]
                if (t.flags & TypeFlagsUnion) <> 0
                {
                    let list Checker.union_types_of(t)
                    if list <> null
                        set flags: flags | Checker.get_combined_type_flags(list as ref[Array[ref[Type]?]])
                }
                else
                    set flags: flags | t.flags
            }
            set i: i + 1
        }
        flags
    }

    ; literalTypesWithSameBaseType. `baseType == t` means t is NOT a literal, and
    ; that answers false for the whole set — which is why the test is written the
    ; reference's way round rather than as *every type is a literal*.
    procedure literal_types_with_same_base_type(this, types: ref[Array[ref[Type]?]]) returns bool
    {
        var common: ref[Type]? null
        let mark this.unported_mark()
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                let t e as ref[Type]
                if (t.flags & TypeFlagsNever) = 0
                {
                    let base this.get_base_type_of_literal_type(t)
                    if this.unported_mark() <> mark
                        return false
                    if base = null
                        return false
                    if common = null
                        set common: base
                    if base = t
                        return false
                    if base <> common
                        return false
                }
            }
            set i: i + 1
        }
        true
    }

    procedure find_leftmost_type(this, types: ref[Array[ref[Type]?]], strict: bool) returns ref[Type]?
    {
        var candidate: ref[Type]? null
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                var take false
                if candidate = null
                    set take: true
                else
                {
                    if strict
                        set take: this.is_type_strict_subtype_of(candidate as ref[Type], e as ref[Type])
                    else
                        set take: this.is_type_subtype_of(candidate as ref[Type], e as ref[Type])
                }
                if take
                    set candidate: e
            }
            set i: i + 1
        }
        candidate
    }

    ; getSingleCommonSupertype — the leftmost type no later type is a STRICT
    ; supertype of, if it is a strict supertype of every other; otherwise the
    ; leftmost under the ordinary subtype relation.
    procedure get_single_common_supertype(this, types: ref[Array[ref[Type]?]]) returns ref[Type]?
    {
        let candidate this.find_leftmost_type(types, true)
        if candidate = null
            return null
        let cand candidate as ref[Type]
        var every true
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                if e <> candidate
                {
                    if this.is_type_strict_subtype_of(e as ref[Type], cand) = false
                    {
                        set every: false
                        set i: n
                    }
                    else
                        set i: i + 1
                }
                else
                    set i: i + 1
            }
            else
                set i: i + 1
        }
        if every
            return candidate
        this.find_leftmost_type(types, false)
    }

    procedure get_common_supertype(this, types: ref[Array[ref[Type]?]]) returns ref[Type]?
    {
        let n types.get_length() as int
        if n = 1
            return types[0]
        let mark this.unported_mark()
        ; Nullable constituents come off every candidate and go back on at the end.
        let primary &Array[ref[Type]?]^host()
        var same true
        var i 0
        while i < n
        {
            let e types[i]
            if e = null
                return null
            if Checker.strict_null_checks()
            {
                let f this.filter_type_outside_flags(e as ref[Type], TypeFlagsNullable)
                if this.unported_mark() <> mark
                    return null
                if f = null
                    return null
                if f <> e
                    set same: false
                primary.add(f)
            }
            else
                primary.add(e)
            set i: i + 1
        }
        var supertype: ref[Type]? null
        let literals this.literal_types_with_same_base_type(primary)
        if this.unported_mark() <> mark
            return null
        if literals
        {
            set supertype: this.get_union_type(primary)
            if this.unported_mark() <> mark
                return null
        }
        else
            set supertype: this.get_single_common_supertype(primary)
        if this.unported_mark() <> mark
            return null
        if supertype = null
            return null
        if same
            return supertype
        this.get_nullable_type(supertype as ref[Type], Checker.get_combined_type_flags(types) & TypeFlagsNullable)
    }

    ; getCommonSubtype — the leftmost type no later type is a subtype of.
    procedure get_common_subtype(this, types: ref[Array[ref[Type]?]]) returns ref[Type]?
    {
        var subtype: ref[Type]? null
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                var take false
                if subtype = null
                    set take: true
                else
                    set take: this.is_type_subtype_of(e as ref[Type], subtype as ref[Type])
                if take
                    set subtype: e
            }
            set i: i + 1
        }
        subtype
    }

    ; getTypeFromInference — the candidates as a subtype-reduced union, or the
    ; contravariant candidates as an intersection, or nil.
    procedure get_type_from_inference(this, info: ref[InferenceInfo]) returns ref[Type]?
    {
        if (info.candidates.get_length() as int) <> 0
            return this.get_union_type_ex(info.candidates, UnionReductionSubtype, null, null)
        if (info.contra_candidates.get_length() as int) <> 0
            return this.get_intersection_type(info.contra_candidates)
        null
    }

    ; unionObjectAndArrayLiteralCandidates — the object and array literals fold
    ; into ONE subtype-reduced union and go to the END of the list.
    procedure union_object_and_array_literal_candidates(this, candidates: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]?
    {
        if (candidates.get_length() as int) <= 1
            return candidates
        let literals &Array[ref[Type]?]^host()
        let others &Array[ref[Type]?]^host()
        let n candidates.get_length() as int
        var i 0
        while i < n
        {
            let e candidates[i]
            if e <> null
            {
                if Checker.is_object_or_array_literal_type(e as ref[Type])
                    literals.add(e)
                else
                    others.add(e)
            }
            set i: i + 1
        }
        if (literals.get_length() as int) = 0
            return candidates
        let mark this.unported_mark()
        let folded this.get_union_type_ex(literals, UnionReductionSubtype, null, null)
        if this.unported_mark() <> mark
            return null
        if folded = null
            return null
        others.add(folded)
        others
    }

    ; hasPrimitiveConstraint.
    procedure has_primitive_constraint(this, t: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        let constraint this.get_constraint_of_type_parameter(t)
        if this.unported_mark() <> mark
            return false
        if constraint = null
            return false
        var c constraint as ref[Type]
        ; ★ The stop that stood here called getDefaultConstraintOfConditionalType
        ; *the conditional chapter's own union of the true and false branches*, and
        ; that chapter is in this file — the function has two other callers.
        if (c.flags & TypeFlagsConditional) <> 0
        {
            ; ★ Upstream assigns the answer back unconditionally and would fault on
            ; a nil; here a nil is a producer that reported, so `false` is the
            ; conservative reading of a predicate rather than a second guess.
            let dc this.get_default_constraint_of_conditional_type(c)
            if this.unported_mark() <> mark
                return false
            if dc = null
                return false
            set c: dc as ref[Type]
        }
        Checker.maybe_type_of_kind(c, TypeFlagsPrimitive | TypeFlagsIndex | TypeFlagsTemplateLiteral | TypeFlagsStringMapping)
    }

    ; isTypeParameterAtTopLevel — `tp` occurs at top level in `t`. The depth cap
    ; of 3 is the reference's and applies to the CONDITIONAL recursion only.
    procedure is_type_parameter_at_top_level(this, t: ref[Type], tp: ref[Type], depth: int) returns bool
    {
        if t = tp
            return true
        if (t.flags & TypeFlagsUnionOrIntersection) <> 0
        {
            var list Checker.union_types_of(t)
            if list = null
                set list: Checker.intersection_types_of(t)
            if list <> null
            {
                let types list as ref[Array[ref[Type]?]]
                let n types.get_length() as int
                var i 0
                while i < n
                {
                    let e types[i]
                    if e <> null
                    {
                        if this.is_type_parameter_at_top_level(e as ref[Type], tp, depth)
                            return true
                    }
                    set i: i + 1
                }
            }
        }
        if depth < 3
        {
            if (t.flags & TypeFlagsConditional) <> 0
            {
                let mark this.unported_mark()
                let tt this.get_true_type_from_conditional_type(t)
                if this.unported_mark() <> mark
                    return false
                if tt <> null
                {
                    if this.is_type_parameter_at_top_level(tt as ref[Type], tp, depth + 1)
                        return true
                }
                let ft this.get_false_type_from_conditional_type(t)
                if this.unported_mark() <> mark
                    return false
                if ft <> null
                {
                    if this.is_type_parameter_at_top_level(ft as ref[Type], tp, depth + 1)
                        return true
                }
            }
        }
        false
    }

    ; isTypeParameterAtTopLevelInReturnType, whole since slice 131 — the predicate
    ; arm for apply_to_return_types' recorded reason.
    procedure is_type_parameter_at_top_level_in_return_type(this, signature: ref[Signature], type_parameter: ref[Type]) returns bool
    {
        let pmark this.unported_mark()
        let predicate this.get_type_predicate_of_signature(signature)
        if this.unported_mark() <> pmark
            return false
        if predicate <> null
        {
            let pd predicate as ref[TypePredicate]
            if pd.t = null
                return false
            return this.is_type_parameter_at_top_level(pd.t as ref[Type], type_parameter, 0)
        }
        let mark this.unported_mark()
        let rt this.get_return_type_of_signature(signature)
        if this.unported_mark() <> mark
            return false
        if rt = null
            return false
        this.is_type_parameter_at_top_level(rt as ref[Type], type_parameter, 0)
    }

    ; getCovariantInference — the widening decision and then either a union of
    ; every candidate or their common supertype.
    ;
    ; ★★★ `widenLiteralTypes` IS THE ANSWER TO *WHY DOES `f(1)` INFER `number` AND
    ; `f<1>(1)` INFER `1`*, and its three conjuncts are not interchangeable: the
    ; type parameter must have no primitive-ish constraint, every inference must
    ; have been at TOP LEVEL, and the parameter must either already be fixed or
    ; not occur at top level in the RETURN type — the last being what keeps
    ; `declare function id<T>(x: T): T; id("a")` at `"a"`.
    procedure get_covariant_inference(this, inference: ref[InferenceInfo], signature: ref[Signature]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let candidates this.union_object_and_array_literal_candidates(inference.candidates)
        if this.unported_mark() <> mark
            return null
        if candidates = null
            return null
        let cl candidates as ref[Array[ref[Type]?]]
        if inference.type_parameter = null
            return null
        let tp inference.type_parameter as ref[Type]
        var primitive_constraint this.has_primitive_constraint(tp)
        if this.unported_mark() <> mark
            return null
        if primitive_constraint = false
        {
            if this.is_const_type_variable(tp, 0)
                set primitive_constraint: true
            if this.unported_mark() <> mark
                return null
        }
        var widen_literal_types false
        if primitive_constraint = false
        {
            if inference.top_level
            {
                if inference.is_fixed
                    set widen_literal_types: true
                else
                {
                    let at_top this.is_type_parameter_at_top_level_in_return_type(signature, tp)
                    if this.unported_mark() <> mark
                        return null
                    if at_top = false
                        set widen_literal_types: true
                }
            }
        }
        var base_candidates cl
        if primitive_constraint
        {
            let regular &Array[ref[Type]?]^host()
            let n cl.get_length() as int
            var i 0
            while i < n
            {
                let e cl[i]
                if e = null
                    return null
                let r this.get_regular_type_of_literal_type(e as ref[Type])
                if this.unported_mark() <> mark
                    return null
                regular.add(r)
                set i: i + 1
            }
            set base_candidates: regular
        }
        else
        {
            if widen_literal_types
            {
                let widened &Array[ref[Type]?]^host()
                let n cl.get_length() as int
                var i 0
                while i < n
                {
                    let e cl[i]
                    if e = null
                        return null
                    let w this.get_widened_literal_type(e as ref[Type])
                    if this.unported_mark() <> mark
                        return null
                    widened.add(w)
                    set i: i + 1
                }
                set base_candidates: widened
            }
        }
        var unwidened: ref[Type]? null
        if (inference.priority & InferencePriorityPriorityImpliesCombination) <> 0
            set unwidened: this.get_union_type_ex(base_candidates, UnionReductionSubtype, null, null)
        else
            set unwidened: this.get_common_supertype(base_candidates)
        if this.unported_mark() <> mark
            return null
        if unwidened = null
            return null
        this.get_widened_type(unwidened as ref[Type])
    }

    procedure get_contravariant_inference(this, inference: ref[InferenceInfo]) returns ref[Type]?
    {
        if (inference.priority & InferencePriorityPriorityImpliesCombination) <> 0
            return this.get_intersection_type(inference.contra_candidates)
        this.get_common_subtype(inference.contra_candidates)
    }

    ; ★★★ clearActiveMapperCaches STOOD HERE AS AN EMPTY BODY FOR THIRTY SLICES,
    ; and its note was expired in both halves: *this port has neither mapper and
    ; neither cache, so the call site keeps the name and the body is empty (§3.5v)*.
    ; The restrictive and permissive mappers landed in slice 151 and the cache is
    ; slice 163's — and the reason nothing retired the note is that an INERT BODY
    ; has no tag, no row and no stop, so not one instrument in this apparatus can
    ; see it. §3.5v's advice (an inert step with an argument beats a missing one
    ; nobody can find) is still right about the alternative and says nothing about
    ; the expiry. The real body is beside `instantiate_type_with_alias`, with the
    ; stack it clears.

    ; ── getInferredType, the one function every caller of this chapter wants ──
    ;
    ; ★★★ ITS THREE ANSWERS ARE NOT THREE BRANCHES OF ONE COMPUTATION. With a
    ; SIGNATURE in hand it picks between the covariant and the contravariant
    ; inference and falls back to the type parameter's DEFAULT; without one it is
    ; just getTypeFromInference. Then, whatever came out, the CONSTRAINT gets the
    ; last word — and the constraint arm can replace the answer entirely.
    procedure get_inferred_type(this, n: ref[InferenceContext], index: int) returns ref[Type]?
    {
        let list n.inferences
        if index >= (list.get_length() as int)
            return null
        let e list[index]
        if e = null
            return null
        let inference e as ref[InferenceInfo]
        if inference.inferred_type <> null
            return inference.inferred_type
        if inference.type_parameter = null
            return null
        let tp inference.type_parameter as ref[Type]
        if tp = error_type
            return tp
        let mark this.unported_mark()
        var inferred: ref[Type]? null
        var fallback: ref[Type]? null
        if n.signature <> null
        {
            let sig n.signature as ref[Signature]
            var covariant: ref[Type]? null
            if (inference.candidates.get_length() as int) <> 0
            {
                set covariant: this.get_covariant_inference(inference, sig)
                if this.unported_mark() <> mark
                    return null
            }
            var contravariant: ref[Type]? null
            if (inference.contra_candidates.get_length() as int) <> 0
            {
                set contravariant: this.get_contravariant_inference(inference)
                if this.unported_mark() <> mark
                    return null
            }
            var have false
            if covariant <> null
                set have: true
            if contravariant <> null
                set have: true
            if have
            {
                var prefer_covariant false
                if covariant <> null
                {
                    if contravariant = null
                        set prefer_covariant: true
                    else
                    {
                        let cov covariant as ref[Type]
                        if (cov.flags & (TypeFlagsNever | TypeFlagsAny)) = 0
                        {
                            let assignable this.covariant_reaches_some_contra(inference, cov)
                            if this.unported_mark() <> mark
                                return null
                            if assignable
                            {
                                let ok this.no_other_inference_conflicts(n, inference, cov)
                                if this.unported_mark() <> mark
                                    return null
                                set prefer_covariant: ok
                            }
                        }
                    }
                }
                if prefer_covariant
                {
                    set inferred: covariant
                    set fallback: contravariant
                }
                else
                {
                    set inferred: contravariant
                    set fallback: covariant
                }
            }
            else
            {
                if (n.flags & InferenceFlagsNoDefault) <> 0
                    set inferred: silent_never_type
                else
                {
                    let dflt this.get_default_from_type_parameter(tp)
                    if this.unported_mark() <> mark
                        return null
                    if dflt <> null
                    {
                        ; A forward reference to a LATER type parameter inside the
                        ; default is erased to `unknown` — that is the whole job of
                        ; the backreference mapper.
                        let back this.new_backreference_mapper(n, index)
                        let m this.merge_type_mappers(back, n.non_fixing_mapper)
                        set inferred: this.instantiate_type(dflt, m)
                        if this.unported_mark() <> mark
                            return null
                    }
                }
            }
        }
        else
        {
            set inferred: this.get_type_from_inference(inference)
            if this.unported_mark() <> mark
                return null
        }
        set inference.inferred_type: inferred
        if inference.inferred_type = null
        {
            if (n.flags & InferenceFlagsAnyDefault) <> 0
                set inference.inferred_type: any_type
            else
                set inference.inferred_type: unknown_type
        }
        let constraint this.get_constraint_of_type_parameter(tp)
        if this.unported_mark() <> mark
            return null
        if constraint <> null
        {
            let instantiated this.instantiate_type(constraint, n.non_fixing_mapper)
            if this.unported_mark() <> mark
                return null
            if instantiated = null
                return null
            let ic instantiated as ref[Type]
            if inferred <> null
            {
                let with_this this.get_type_with_this_argument(ic, inferred, false)
                if this.unported_mark() <> mark
                    return null
                if with_this = null
                    return null
                let cwt with_this as ref[Type]
                if this.compare_types_by_comparer(n.compare_kind, inferred as ref[Type], cwt) = false
                {
                    if this.unported_mark() <> mark
                        return null
                    ; "If we have a pure return type inference, we may succeed by
                    ; removing constituents of the inferred type that aren't
                    ; assignable to the constraint type (pure return type inferences
                    ; are speculation anyway)."
                    ;
                    ; ★★★ THE FILTER IS A MAP TO `never`, NOT A REMOVAL, and the
                    ; difference is what makes the guard below correct: mapType's
                    ; union reduction drops the never constituents, and a filter
                    ; that removed EVERY constituent answers `never` rather than
                    ; nil — which is why the reference keeps the result only when it
                    ; is not never, and takes the constraint fallback otherwise.
                    var filtered: ref[Type]? null
                    if inference.priority = InferencePriorityReturnType
                    {
                        var a_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, cwt, n.compare_kind, null, null, null, null, 0, 0)
                        let a &a_value as ref[MapTypeArgs]?
                        set filtered: this.map_type(inferred as ref[Type], MapTypeKindConstraintFilter, a)
                        if this.unported_mark() <> mark
                            return null
                    }
                    set inferred: null
                    if filtered <> null
                    {
                        if ((filtered as ref[Type]).flags & TypeFlagsNever) = 0
                            set inferred: filtered
                    }
                }
                if this.unported_mark() <> mark
                    return null
            }
            if inferred = null
            {
                ; The fallback if it satisfies the constraint, the constraint
                ; otherwise.
                var take_fallback false
                if fallback <> null
                {
                    let fb fallback as ref[Type]
                    let fwt this.get_type_with_this_argument(ic, fb, false)
                    if this.unported_mark() <> mark
                        return null
                    if fwt <> null
                    {
                        set take_fallback: this.compare_types_by_comparer(n.compare_kind, fb, fwt as ref[Type])
                        if this.unported_mark() <> mark
                            return null
                    }
                }
                if take_fallback
                    set inferred: fallback
                else
                    set inferred: ic
            }
            set inference.inferred_type: inferred
        }
        this.clear_active_mapper_caches()
        inference.inferred_type
    }

    ; `core.Some(inference.contraCandidates, ...)` — the covariant inference must
    ; be assignable to at least one contravariant candidate.
    procedure covariant_reaches_some_contra(this, inference: ref[InferenceInfo], covariant: ref[Type]) returns bool
    {
        let list inference.contra_candidates
        let n list.get_length() as int
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                if this.is_type_assignable_to(covariant, e as ref[Type])
                    return true
                if this.unported_mark() <> mark
                    return false
            }
            set i: i + 1
        }
        false
    }

    ; `core.Every(n.inferences, ...)` — no OTHER type parameter constrained to
    ; this one may have a candidate that is not assignable to the covariant
    ; inference.
    procedure no_other_inference_conflicts(this, n: ref[InferenceContext], inference: ref[InferenceInfo], covariant: ref[Type]) returns bool
    {
        let list n.inferences
        let cnt list.get_length() as int
        let mark this.unported_mark()
        var i 0
        while i < cnt
        {
            let e list[i]
            if e <> null
            {
                let other e as ref[InferenceInfo]
                ; `other != inference && constraintOf(other) != tp || every(other.candidates, …)`:
                ; the inference ITSELF is checked too — "all co-variant inferences are assignable
                ; to it (i.e. it isn't one of a conflicting set of candidates)" — and so is every
                ; other parameter constrained to this one
                var must_check true
                if other <> inference
                {
                    set must_check: false
                    if other.type_parameter <> null
                    {
                        let c this.get_constraint_of_type_parameter(other.type_parameter as ref[Type])
                        if this.unported_mark() <> mark
                            return false
                        if c = inference.type_parameter
                            set must_check: true
                    }
                }
                if must_check
                {
                    let cands other.candidates
                    let cn cands.get_length() as int
                    var j 0
                    while j < cn
                    {
                        let ce cands[j]
                        if ce <> null
                        {
                            if this.is_type_assignable_to(ce as ref[Type], covariant) = false
                                return false
                            if this.unported_mark() <> mark
                                return false
                        }
                        set j: j + 1
                    }
                }
            }
            set i: i + 1
        }
        true
    }

    procedure get_inferred_types(this, n: ref[InferenceContext]) returns ref[Array[ref[Type]?]]?
    {
        let out &Array[ref[Type]?]^host()
        let mark this.unported_mark()
        let cnt n.inferences.get_length() as int
        var i 0
        while i < cnt
        {
            let t this.get_inferred_type(n, i)
            if this.unported_mark() <> mark
                return null
            out.add(t)
            set i: i + 1
        }
        out
    }

    ; ── the inference-context STACK (slice 122) ─────────────────────────────
    ;
    ; c.inferenceContextInfos. getInferenceContext answers the INNERMOST context
    ; whose node is an ancestor of the asking node, which is what lets
    ; inferTypeArguments read the context of the CALL it is nested inside.
    procedure push_inference_context(this, node: ref[AstNode]?, context: ref[InferenceContext]?)
    {
        let e &InferenceContextInfo^host(node, context)
        inference_context_infos.add(e as ref[InferenceContextInfo]?)
    }

    procedure pop_inference_context(this)
    {
        let n inference_context_infos.get_length() as int
        if n = 0
            return
        ; the length alone: a copy per pop was garbage
        set inference_context_infos.length: (n - 1) as size_t
    }

    function is_node_descendant_of(node_in: ref[AstNode]?, ancestor: ref[AstNode]?) returns bool
    {
        var node node_in
        while node <> null
        {
            if node = ancestor
                return true
            set node: AstNode.parent_node_of(node as ref[AstNode])
        }
        false
    }

    function get_inference_context(this, node: ref[AstNode]) returns ref[InferenceContext]?
    {
        var i (inference_context_infos.get_length() as int) - 1
        while i >= 0
        {
            let e inference_context_infos[i]
            if e <> null
            {
                let info e as ref[InferenceContextInfo]
                if Checker.is_node_descendant_of(node, info.node)
                    return info.context
            }
            set i: i - 1
        }
        null
    }

    ; ── getSignatureInstantiation and its cache ─────────────────────────────

    ; getTypeParametersForMapper — `SameMap(sig.typeParameters, tp =>
    ; instantiateType(tp, tp.Mapper()))`.
    ;
    ; ★★★ IT IS THE IDENTITY IN THIS PORT AND THAT IS A PROVABLE CLAIM, NOT AN
    ; APPROXIMATION. A TypeParameter's `mapper` slot has exactly one writer
    ; upstream — instantiateSignatureEx's FRESH-type-parameter branch — and that
    ; branch is `instantiate-signature-type-parameters`, still a stop here; so
    ; every type parameter this port can hold has a nil mapper, and
    ; `instantiateType(t, nil)` answers `t`. The day the branch lands, this
    ; function is where the slot is read.
    ; getTypeParametersForMapper: `SameMap(sig.typeParameters, tp => instantiateType(tp, tp.Mapper()))`.
    ; A signature instantiated with FRESH type parameters (instantiateSignature's clones)
    ; leaves each clone's mapper on it, and the parameter types of that signature refer to
    ; what the clone maps TO — so an inference context keyed on the bare clone never finds
    ; its own type parameter inside the signature (slice 206; `genericCallInferenceConditionalType1`).
    procedure get_type_parameters_for_mapper(this, sig: ref[Signature]) returns ref[Array[ref[Type]?]]?
    {
        let tps sig.type_parameters
        if tps = null
            return null
        let list tps as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var any_mapped false
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                if Checker.type_parameter_mapper_of(row as ref[Type]) <> null
                    set any_mapped: true
            }
            set i: i + 1
        }
        if any_mapped = false
            return tps
        let out this.new_type_list(null)
        set i: 0
        while i < n
        {
            let row list[i]
            if row = null
                return null
            let tp row as ref[Type]
            let m Checker.type_parameter_mapper_of(tp)
            if m = null
                out.add(tp)
            else
            {
                let inst this.instantiate_type(tp, m)
                if inst = null
                    return null
                out.add(inst)
            }
            set i: i + 1
        }
        out
    }

    procedure create_signature_type_mapper(this, sig: ref[Signature], type_arguments: ref[Array[ref[Type]?]]?) returns ref[TypeMapper]
        this.new_type_mapper(this.get_type_parameters_for_mapper(sig), type_arguments)

    procedure create_signature_instantiation(this, sig: ref[Signature], type_arguments: ref[Array[ref[Type]?]]?) returns ref[Signature]?
    {
        let m this.create_signature_type_mapper(sig, type_arguments)
        this.instantiate_signature_ex(sig, m, true)
    }

    ; getSignatureInstantiationWithoutFillingInTypeArguments. The reference keys a
    ; Go map on (signature, getTypeListKey(typeArguments)); this is an association
    ; list compared on the LIST — same signature, same type arguments in the same
    ; order — which is what the key string stands in for and is exact where a
    ; string is a rendering.
    ;
    ; ★★★ WHAT THE CACHE BUYS IS IDENTITY AND IT IS OBSERVABLE HERE: a signature
    ; instantiated twice for one call would give the call two different return
    ; TYPES, and everything downstream compares types by pointer.
    procedure get_signature_instantiation_without_filling_in_type_arguments(this, sig: ref[Signature], type_arguments: ref[Array[ref[Type]?]]?) returns ref[Signature]?
    {
        if sig.cache_rows <> null
        {
            let rows sig.cache_rows as ref[Array[ref[CachedSignature]?]]
            let n rows.get_length() as int
            let chained n >= ObjectRowChainMin
            var ch: ref[HashChain]? null
            var i 0
            if chained
            {
                set ch: this.signature_row_chain(rows)
                set i: (ch as ref[HashChain]).first(Checker.type_list_hash(type_arguments))
            }
            while (i >= 0) and (i < n)
            {
                let e rows[i]
                if e <> null
                {
                    let row e as ref[CachedSignature]
                    if row.kind = SignatureCacheKindInstantiation
                    {
                        if Checker.type_lists_equal(row.type_arguments, type_arguments)
                            return row.instantiation
                    }
                }
                if chained
                    set i: (ch as ref[HashChain]).after(i)
                else
                    set i: i + 1
            }
        }
        let made this.create_signature_instantiation(sig, type_arguments)
        if made = null
            return null
        let row &CachedSignature^host(sig, SignatureCacheKindInstantiation, type_arguments, made)
        Checker.signature_cache_add(sig, row)
        made
    }

    procedure get_signature_instantiation(this, sig: ref[Signature], type_arguments: ref[Array[ref[Type]?]]?, is_java_script: bool, inferred_type_parameters: ref[Array[ref[Type]?]]?) returns ref[Signature]?
    {
        let mark this.unported_mark()
        var filled type_arguments
        if sig.type_parameters <> null
        {
            let tps sig.type_parameters as ref[Array[ref[Type]?]]
            let min this.get_min_type_argument_count(tps)
            if this.unported_mark() <> mark
                return null
            var args type_arguments
            if args = null
                set args: &Array[ref[Type]?]^host() as ref[Array[ref[Type]?]]?
            set filled: this.fill_missing_type_arguments(args as ref[Array[ref[Type]?]], tps, min, is_java_script)
            if this.unported_mark() <> mark
                return null
        }
        let instantiated this.get_signature_instantiation_without_filling_in_type_arguments(sig, filled)
        if this.unported_mark() <> mark
            return null
        ; ★★★ THE INFERRED-PARAMETER TAIL, SLICE 139. Its stop called
        ; getOrCreateTypeFromSignature *the anonymous-signature-type factory this
        ; port does not have* — the factory is `get_or_create_type_from_signature`
        ; and it has had a reader for slices (§3.5eo).
        ;
        ; ★★★ AND IT BOUGHT NOTHING, WHICH IS THE HONEST MEASUREMENT: the arm has NO
        ; INPUT. `InferenceContext.inferred_type_parameters` is read at the one call
        ; site that fills this parameter and WRITTEN NOWHERE — the writer is
        ; inferTypeArguments' outer-type-parameter path — so the guard below is
        ; constantly false and the stop it replaced had never fired. **An expired
        ; note on an arm with no input is still expired and still worth removing,
        ; but it is not a unit**; `expiredstops.py`'s hits have to be read for
        ; reachability as well as for the premise. The body is the reference's, so
        ; the day the writer lands nothing here moves. What the tail does: the
        ; instantiated signature RETURNS a function type, and the inferred type
        ; parameters are moved onto THAT signature, so `<A>(a: A[]) => …` inferred
        ; through a generic wrapper stays generic in the wrapper's result.
        ;
        ; ★ The new return type carries the instantiated signature's own mapper, so
        ; the inner signature's constraints still instantiate — and the setter
        ; writes the target slot too, which is null on a freshly minted isolated
        ; type and stays that way.
        if inferred_type_parameters <> null
        {
            if ((inferred_type_parameters as ref[Array[ref[Type]?]]).get_length() as int) <> 0
            {
                if instantiated = null
                    return null
                let inst instantiated as ref[Signature]
                let ret this.get_return_type_of_signature(inst)
                if this.unported_mark() <> mark
                    return null
                if ret = null
                    return null
                let return_signature this.get_single_call_or_construct_signature(ret as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if return_signature <> null
                {
                    let new_return_signature this.clone_signature(return_signature as ref[Signature])
                    set new_return_signature.type_parameters: inferred_type_parameters
                    let new_return_type this.get_or_create_type_from_signature(new_return_signature)
                    if this.unported_mark() <> mark
                        return null
                    if new_return_type = null
                        return null
                    Checker.set_object_target_and_mapper(new_return_type as ref[Type], null, inst.mapper)
                    let new_instantiated this.clone_signature(inst)
                    set new_instantiated.resolved_return_type: new_return_type
                    return new_instantiated
                }
            }
        }
        instantiated
    }

    ; ── inferTypeArguments ──────────────────────────────────────────────────
    ;
    ; ★★★ THE FUNCTION IS THREE PASSES AND ONLY THE THIRD IS THE ONE ITS NAME
    ; SUGGESTS. First the CONTEXTUAL type of the call flows backwards into the
    ; signature's return type at the ReturnType priority — the lowest there is —
    ; then a SECOND, isolated context is built for the same inference so that
    ; `context.returnMapper` can instantiate contextual types of later arguments
    ; without letting those inferences into the real context; only then are the
    ; ARGUMENTS walked. Collapsing the first two loses `wrap(s => s.length)`.
    procedure infer_type_arguments(this, node: ref[AstNode], signature: ref[Signature], args: ref[Array[ref[AstNode]?]]?, check_mode: int, context: ref[InferenceContext]) returns ref[Array[ref[Type]?]]?
    {
        let mark this.unported_mark()
        let nk AstNode.kind_of(node)
        if nk = KindJsxOpeningElement
            return this.infer_jsx_type_arguments(node, signature, check_mode, context)
        if nk = KindJsxSelfClosingElement
            return this.infer_jsx_type_arguments(node, signature, check_mode, context)
        var contextual_pass true
        if nk = KindDecorator
            set contextual_pass: false
        if nk = KindBinaryExpression
            set contextual_pass: false
        if contextual_pass
        {
            let stopped this.infer_from_contextual_return_type(node, signature, context)
            if this.unported_mark() <> mark
                return null
            if stopped
                return null
        }
        let rest_type this.get_non_array_rest_type(signature)
        if this.unported_mark() <> mark
            return null
        var arg_count 0
        if args <> null
            set arg_count: (args as ref[Array[ref[AstNode]?]]).get_length() as int
        let all_args arg_count
        if rest_type <> null
        {
            let pc this.get_parameter_count(signature)
            if this.unported_mark() <> mark
                return null
            if (pc - 1) < arg_count
                set arg_count: pc - 1
        }
        if rest_type <> null
        {
            if ((rest_type as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
            {
                ; The implied ARITY of a rest type parameter: how many arguments
                ; are left over, but only when none of them is a spread.
                let info Checker.find_inference_for(context, rest_type as ref[Type])
                if info <> null
                {
                    var spread false
                    var i arg_count
                    while i < all_args
                    {
                        let a (args as ref[Array[ref[AstNode]?]])[i]
                        if a <> null
                        {
                            if this.is_spread_argument(a as ref[AstNode])
                                set spread: true
                        }
                        set i: i + 1
                    }
                    if spread = false
                    {
                        ; ★ `set (info as ref[…]).implied_arity` stored into the CAST'S TEMPORARY and the
                        ; inference never saw an implied arity (slice 209; `variadicTuples1`'s `curry`)
                        let info_ref info as ref[InferenceInfo]
                        set info_ref.implied_arity: all_args - arg_count
                    }
                }
            }
        }
        let this_type this.get_this_type_of_signature(signature)
        if this.unported_mark() <> mark
            return null
        if this_type <> null
        {
            let could this.could_contain_type_variables(this_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if could
            {
                ; ★ Slice 160. The inference to the DECLARED `this` runs before the
                ; arguments', which is the reference's order and observable: a
                ; candidate inferred from the receiver is the FIRST candidate.
                let this_argument_node this.get_this_argument_of_call(node)
                let this_argument_type this.get_this_argument_type(this_argument_node)
                if this.unported_mark() <> mark
                    return null
                if this_argument_type = null
                    return null
                this.infer_types(context.inferences, this_argument_type as ref[Type], this_type as ref[Type], InferencePriorityNone, false)
                if this.unported_mark() <> mark
                    return null
            }
        }
        var i 0
        while i < arg_count
        {
            let ae (args as ref[Array[ref[AstNode]?]])[i]
            if ae <> null
            {
                let arg ae as ref[AstNode]
                if AstNode.kind_of(arg) <> KindOmittedExpression
                {
                    let param_type this.get_type_at_position(signature, i)
                    if this.unported_mark() <> mark
                        return null
                    if param_type <> null
                    {
                        let could this.could_contain_type_variables(param_type as ref[Type])
                        if this.unported_mark() <> mark
                            return null
                        if could
                        {
                            let arg_type this.check_expression_with_contextual_type_ex(arg, param_type as ref[Type], context, check_mode)
                            if this.unported_mark() <> mark
                                return null
                            if arg_type = null
                                return null
                            this.infer_types(context.inferences, arg_type, param_type, InferencePriorityNone, false)
                            if this.unported_mark() <> mark
                                return null
                        }
                    }
                }
            }
            set i: i + 1
        }
        if rest_type <> null
        {
            let could this.could_contain_type_variables(rest_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if could
            {
                let spread_type this.get_spread_argument_type(args, arg_count, all_args, rest_type as ref[Type], context, check_mode)
                if this.unported_mark() <> mark
                    return null
                if spread_type = null
                    return null
                this.infer_types(context.inferences, spread_type as ref[Type], rest_type as ref[Type], InferencePriorityNone, false)
                if this.unported_mark() <> mark
                    return null
            }
        }
        this.get_inferred_types(context)
    }

    ; The first two passes of inferTypeArguments, lifted out on the s178
    ; alloca-pool rule. Answers TRUE when it stopped.
    procedure infer_from_contextual_return_type(this, node: ref[AstNode], signature: ref[Signature], context: ref[InferenceContext]) returns bool
    {
        let mark this.unported_mark()
        ; skipBindingPatterns — every type parameter has a default, in which case
        ; a binding pattern on the left contributes nothing.
        var skip_binding_patterns true
        if signature.type_parameters <> null
        {
            let tps signature.type_parameters as ref[Array[ref[Type]?]]
            let n tps.get_length() as int
            var i 0
            while i < n
            {
                let e tps[i]
                if e = null
                    set skip_binding_patterns: false
                else
                {
                    let d this.get_default_from_type_parameter(e as ref[Type])
                    if this.unported_mark() <> mark
                        return true
                    if d = null
                        set skip_binding_patterns: false
                }
                set i: i + 1
            }
        }
        var flags ContextFlagsNone
        if skip_binding_patterns
            set flags: ContextFlagsSkipBindingPatterns
        let contextual_type this.get_contextual_type(node, flags)
        if this.unported_mark() <> mark
            return true
        if contextual_type = null
            return false
        let target_type this.get_return_type_of_signature(signature)
        if this.unported_mark() <> mark
            return true
        if target_type = null
            return false
        let could this.could_contain_type_variables(target_type as ref[Type])
        if this.unported_mark() <> mark
            return true
        if could = false
            return false
        let outer_context this.get_inference_context(node)
        var is_from_binding_pattern false
        if skip_binding_patterns = false
        {
            let other this.get_contextual_type(node, ContextFlagsSkipBindingPatterns)
            if this.unported_mark() <> mark
                return true
            if other <> contextual_type
                set is_from_binding_pattern: true
        }
        if is_from_binding_pattern = false
        {
            ; A SNAPSHOT of the outer context, so an outer resolution in progress
            ; is not disturbed.
            let cloned this.clone_inference_context(outer_context, InferenceFlagsNoDefault)
            let outer_mapper Checker.get_mapper_from_context(cloned)
            let instantiated this.instantiate_type(contextual_type, outer_mapper)
            if this.unported_mark() <> mark
                return true
            if instantiated = null
                return true
            let contextual_signature this.get_single_call_signature(instantiated as ref[Type])
            if this.unported_mark() <> mark
                return true
            ; ★★★ THE STOP HERE NAMED getOrCreateTypeFromSignature AS ABSENT AND
            ; IT HAS EXISTED SINCE THE SIGNATURE-TYPE CHAPTER LANDED — the same
            ; expiry slice 195 found under `type-to-string-abstract-construct-
            ; signature`, one function over. Both callees of the reference's one
            ; line are here: get_signature_instantiation_without_filling_in_type_
            ; arguments (its other caller is the signature-type factory itself) and
            ; get_or_create_type_from_signature.
            ;
            ; ★ WHY THE INSTANTIATION IS WITH THE SIGNATURE'S OWN TYPE PARAMETERS,
            ; in the reference's own words: it keeps them from being erased to `any`
            ; during inference, so `arrayMap(value => ({ value }))` against
            ; `<A>(a: A[]) => { value: A }[]` can infer `value: A` rather than
            ; `value: any`. The WITHOUT-FILLING form is the one that leaves a type
            ; argument the caller did not give alone.
            var source_type: ref[Type]? instantiated
            if contextual_signature <> null
            {
                let cs contextual_signature as ref[Signature]
                if cs.type_parameters <> null
                {
                    if ((cs.type_parameters as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                    {
                        let inst this.get_signature_instantiation_without_filling_in_type_arguments(cs, cs.type_parameters)
                        if this.unported_mark() <> mark
                            return true
                        if inst = null
                            return true
                        set source_type: this.get_or_create_type_from_signature(inst as ref[Signature])
                        if this.unported_mark() <> mark
                            return true
                    }
                }
            }
            ; An inference from a return type is the LOWEST priority there is.
            this.infer_types(context.inferences, source_type, target_type, InferencePriorityReturnType, false)
            if this.unported_mark() <> mark
                return true
        }
        ; The second, isolated pass: its inferences never enter `context`, only
        ; `context.return_mapper`.
        let return_context this.new_inference_context(signature.type_parameters, signature, context.flags, SignatureComparerAssignable)
        var outer_return_mapper: ref[TypeMapper]? null
        if outer_context <> null
        {
            set outer_return_mapper: this.create_outer_return_mapper(outer_context as ref[InferenceContext])
            if this.unported_mark() <> mark
                return true
        }
        let return_source this.instantiate_type(contextual_type, outer_return_mapper)
        if this.unported_mark() <> mark
            return true
        if return_source = null
            return true
        this.infer_types(return_context.inferences, return_source, target_type, InferencePriorityNone, false)
        if this.unported_mark() <> mark
            return true
        var some false
        let rl return_context.inferences
        let rn rl.get_length() as int
        var i 0
        while i < rn
        {
            let e rl[i]
            if e <> null
            {
                if Checker.has_inference_candidates(e as ref[InferenceInfo])
                    set some: true
            }
            set i: i + 1
        }
        if some
        {
            let part this.clone_inferred_part_of_context(return_context)
            set context.return_mapper: Checker.get_mapper_from_context(part)
        }
        else
            set context.return_mapper: null
        false
    }

    function find_inference_for(context: ref[InferenceContext], tp: ref[Type]) returns ref[InferenceInfo]?
    {
        let list context.inferences
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                if (e as ref[InferenceInfo]).type_parameter = tp
                    return e
            }
            set i: i + 1
        }
        null
    }

    ; isSpreadArgument, BOTH halves since slice 139. ★★★The note that stood here
    ; said the SyntheticExpression half *has no producer* and named
    ; getSpreadArgumentType as its writer; the actual writer is
    ; get_effective_call_arguments' spread synthesis, which landed in this same
    ; slice — so the predicate is completed in the SAME edit that gives it input,
    ; because a half-answering predicate would silently treat a synthesized spread
    ; as an ordinary argument.
    ; ★It is a METHOD now: the synthetic node's `is_spread` lives on the side link,
    ; which only the Checker can look up.
    function is_spread_argument(this, arg: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(arg) = KindSpreadElement
            return true
        if AstNode.kind_of(arg) <> KindSyntheticExpression
            return false
        let link this.synthetic_expression_link_of(arg)
        if link = null
            return false
        (link as ref[SyntheticExpressionLink]).is_spread
    }

    ; getMutableArrayOrTupleType — the spread of a READONLY tuple into a rest
    ; parameter has to lose the readonly, and a non-tuple becomes a one-element
    ; VARIADIC tuple so the arity machinery sees an open end.
    procedure get_mutable_array_or_tuple_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) <> 0
            return this.map_type(t, MapTypeKindMutableArrayOrTuple, null)
        if (t.flags & TypeFlagsAny) <> 0
            return t
        let mark this.unported_mark()
        let base this.get_base_constraint_or_type(t)
        if this.unported_mark() <> mark
            return null
        if base <> null
        {
            if this.is_mutable_array_or_tuple(base as ref[Type])
                return t
        }
        if Checker.is_tuple_type(t)
        {
            let target Checker.target_of(t)
            if target = null
                return null
            let infos Checker.tuple_element_infos_of(target as ref[Type])
            if infos = null
                return null
            let elements this.get_element_types(t)
            if this.unported_mark() <> mark
                return null
            return this.create_tuple_type_ex(elements, infos as ref[Array[ref[TupleElementInfo]?]], false)
        }
        let types this.new_type_list_of(1)
        types.add(t)
        let infos &Array[ref[TupleElementInfo]?]^host()
        infos.add(&TupleElementInfo^host(ElementFlagsVariadic, null) as ref[TupleElementInfo]?)
        this.create_tuple_type_ex(types as ref[Array[ref[Type]?]]?, infos as ref[Array[ref[TupleElementInfo]?]], false)
    }

    ; ★★★ getSpreadArgumentType — the TUPLE the trailing arguments make, which is
    ; what a rest parameter is related to and inferred from. Its two stops each
    ; blamed a missing tuple writer and a missing SyntheticExpression; slice 115
    ; wrote the first and this file has had the second since the tagged-template
    ; arm (§3.5eo).
    ;
    ; ★★★ THE FIRST BLOCK IS THE ...x-AGAINST-...y CASE and it is not a special
    ; case of the loop: when the LAST argument is itself a spread and the rest
    ; parameter starts at or before it, the spread's own type IS the answer — as a
    ; mutable array or tuple when it is array-like, and as an array of the iterated
    ; element type otherwise. Folding it into the loop would wrap `...args` in a
    ; second tuple.
    ;
    ; ★ The per-argument contextual type differs by what the REST type is: for a
    ; tuple it is the element's contextual type at that position, for anything else
    ; the indexed access at the numeric literal — the same fork
    ; get_contextual_type_for_element_expression serves for an array literal.
    procedure get_spread_argument_type(this, args: ref[Array[ref[AstNode]?]]?, index: int, arg_count: int, rest_type: ref[Type], context: ref[InferenceContext]?, check_mode: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let in_const_context this.is_const_type_variable(rest_type, 0)
        if arg_count > 0
        {
            if index >= (arg_count - 1)
            {
                let last AstNode.child_in_list(args, arg_count - 1)
                if last = null
                    return null
                let arg last as ref[AstNode]
                if this.is_spread_argument(arg)
                {
                    var spread_type: ref[Type]? null
                    if AstNode.kind_of(arg) = KindSyntheticExpression
                    {
                        let link this.synthetic_expression_link_of(arg)
                        if link = null
                            return null
                        set spread_type: (link as ref[SyntheticExpressionLink]).resolved_type
                    }
                    if AstNode.kind_of(arg) <> KindSyntheticExpression
                    {
                        let inner AstNode.expression_of(arg)
                        if inner = null
                            return null
                        set spread_type: this.check_expression_with_contextual_type_ex(inner as ref[AstNode], rest_type, context, check_mode)
                        if this.unported_mark() <> mark
                            return null
                    }
                    if spread_type = null
                        return null
                    let st spread_type as ref[Type]
                    if this.is_array_like_type(st)
                        return this.get_mutable_array_or_tuple_type(st)
                    var error_node arg
                    if AstNode.kind_of(arg) = KindSpreadElement
                    {
                        let inner AstNode.expression_of(arg)
                        if inner = null
                            return null
                        set error_node: inner as ref[AstNode]
                    }
                    let element this.check_iterated_type_or_element_type(IterationUseSpread, st, undefined_type, error_node)
                    if this.unported_mark() <> mark
                        return null
                    return this.create_array_type_ex(element, in_const_context)
                }
            }
        }
        let types this.new_type_list(null)
        let infos &Array[ref[TupleElementInfo]?]^host()
        var i index
        while i < arg_count
        {
            let a AstNode.child_in_list(args, i)
            if a = null
                return null
            let arg a as ref[AstNode]
            var t: ref[Type]? null
            var flags ElementFlagsRequired
            if this.is_spread_argument(arg)
            {
                var spread_type: ref[Type]? null
                if AstNode.kind_of(arg) = KindSyntheticExpression
                {
                    let link this.synthetic_expression_link_of(arg)
                    if link = null
                        return null
                    set spread_type: (link as ref[SyntheticExpressionLink]).resolved_type
                }
                if AstNode.kind_of(arg) <> KindSyntheticExpression
                {
                    let inner AstNode.expression_of(arg)
                    if inner = null
                        return null
                    set spread_type: this.check_expression(inner as ref[AstNode])
                    if this.unported_mark() <> mark
                        return null
                }
                if spread_type = null
                    return null
                let st spread_type as ref[Type]
                if this.is_array_like_type(st)
                {
                    set t: st
                    set flags: ElementFlagsVariadic
                }
                if this.is_array_like_type(st) = false
                {
                    var error_node arg
                    if AstNode.kind_of(arg) = KindSpreadElement
                    {
                        let inner AstNode.expression_of(arg)
                        if inner = null
                            return null
                        set error_node: inner as ref[AstNode]
                    }
                    set t: this.check_iterated_type_or_element_type(IterationUseSpread, st, undefined_type, error_node)
                    if this.unported_mark() <> mark
                        return null
                    set flags: ElementFlagsRest
                }
            }
            if this.is_spread_argument(arg) = false
            {
                var contextual_type: ref[Type]? null
                if Checker.is_tuple_type(rest_type)
                {
                    set contextual_type: this.get_contextual_type_for_element_expression(rest_type, i - index, arg_count - index, 0 - 1, 0 - 1)
                    if this.unported_mark() <> mark
                        return null
                    if contextual_type = null
                        set contextual_type: unknown_type
                }
                if Checker.is_tuple_type(rest_type) = false
                {
                    set contextual_type: this.get_indexed_access_type_ex(rest_type, this.get_number_literal_type(Checker.number_bits_from_int(i - index)), AccessFlagsContextual, null, null)
                    if this.unported_mark() <> mark
                        return null
                }
                if contextual_type = null
                    return null
                let ct contextual_type as ref[Type]
                let arg_type this.check_expression_with_contextual_type_ex(arg, ct, context, check_mode)
                if this.unported_mark() <> mark
                    return null
                if arg_type = null
                    return null
                var has_primitive_contextual_type in_const_context
                if has_primitive_contextual_type = false
                    set has_primitive_contextual_type: Checker.maybe_type_of_kind(ct, TypeFlagsPrimitive | TypeFlagsIndex | TypeFlagsTemplateLiteral | TypeFlagsStringMapping)
                if has_primitive_contextual_type
                    set t: this.get_regular_type_of_literal_type(arg_type as ref[Type])
                if has_primitive_contextual_type = false
                    set t: this.get_widened_literal_type(arg_type as ref[Type])
                if this.unported_mark() <> mark
                    return null
                set flags: ElementFlagsRequired
            }
            if t = null
                return null
            var labeled: ref[AstNode]? null
            if AstNode.kind_of(arg) = KindSyntheticExpression
            {
                let link this.synthetic_expression_link_of(arg)
                if link <> null
                    set labeled: (link as ref[SyntheticExpressionLink]).tuple_name_source
            }
            types.add(t)
            infos.add(&TupleElementInfo^host(flags, labeled) as ref[TupleElementInfo]?)
            set i: i + 1
        }
        var readonly in_const_context
        if readonly
        {
            if this.some_type_is_mutable_array_like(rest_type)
                set readonly: false
        }
        this.create_tuple_type_ex(types as ref[Array[ref[Type]?]]?, infos as ref[Array[ref[TupleElementInfo]?]], readonly)
    }


    ; ── slice 128: THE ITERATION AND ASYNC PROTOCOL ──────────────────────────
    ;
    ; `for-of`, spread, array destructuring, `yield`, `yield*`, `await` and the
    ; generator/promise return types — one chapter, because they are one mechanism
    ; in the reference: every one of them asks getIteratedTypeOrElementType or
    ; getAwaitedType, and those two ask each other (a for-await-of awaits what the
    ; sync iterator yields; an async generator's `next` type is awaited).
    ;
    ; ★★★ IT IS THE DIMENSION THE PORT HAS BEEN STOPPING AT SINCE SLICE 69, and the
    ; stops were spread over twelve chapters rather than one: check_expression's
    ; Await/Yield/Spread arms, check_for_of_statement's right-hand side,
    ; get_initial_type_of_variable_declaration and get_assigned_type's ForOf arms,
    ; get_type_of_destructured_array_element and _spread_expression,
    ; unwrap_return_type's two arms, get_contextual_return_type's two,
    ; report_errors_from_widening's contextual arm and get_explicit_type_of_symbol's
    ; for-of arm. Every one of them names a function of THIS chapter, which is what
    ; made the chapter a chapter rather than a list.
    ;
    ; ★★★ THE RESOLVER IS A TAG (§3.18), and here the tag is a single BOOL. Upstream
    ; `IterationTypesResolver` is a record of TWELVE function values built twice, in
    ; initializeIterationResolvers — eight global-type getters, the `resolveIteration
    ; Type` hook, the symbol name and three diagnostics. There are exactly two
    ; instances and no third is constructible, so every field is a two-way choice on
    ; `is_async`; the record would carry no information the bool does not. What the
    ; bool costs is that the twelve fields become twelve `resolver_*` functions, each
    ; one `if is_async` — which is the price §3.18 already names and which is paid
    ; here in the CALLEES rather than in a state record, because none of the twelve
    ; closes over anything but the checker.
    ;
    ; ★★ AND THE ONE FIELD THAT IS NOT A LOOKUP IS `resolveIterationType`, whose
    ; sync arm is the IDENTITY and whose async arm is getAwaitedTypeEx. That is the
    ; whole difference between the two directions of this chapter: an async iterator
    ; awaits its yield and return types and does NOT await the type sent to `next`.
    ; resolver_resolve_iteration_type is where that lives, and its comment is the
    ; reference's own.

    ; ── §3.11's table: the iteration and promise globals ─────────────────────
    ;
    ; getGlobalType at an arbitrary ARITY, minus the reports — get_global_object_type
    ; and get_global_generic_type were this body at arity 0 and 1, and the third
    ; caller in one slice is what §3.5dm asks for. ★The failure VALUE is the
    ; reference's and it is arity-dependent: `emptyGenericType` for a generic global
    ; (a real type its callers instantiate) and `emptyObjectType` for a non-generic
    ; one, which is why the two cannot share a sentinel.
    procedure get_global_type_of_arity(this, name: Slice[char], arity: int) returns ref[Type]?
    {
        var absent: ref[Type]? empty_object_type
        if arity <> 0
            set absent: empty_generic_type
        let symbol this.lookup_globals(name, SymbolFlagsType)
        if symbol = null
            return absent
        let sym symbol as ref[Symbol]
        if (Symbol.flags_of(sym) & (SymbolFlagsClass | SymbolFlagsInterface)) = 0
            return absent
        let mark this.unported_mark()
        let declared this.get_declared_type_of_symbol(sym)
        if this.unported_mark() <> mark
            return null
        if declared = null
            return absent
        let d declared as ref[Type]
        if Checker.type_parameter_count_of(d) <> arity
            return absent
        d
    }

    ; getGlobalType("RegExp", 0, reportErrors), memoised like every other global
    ; here — see get_global_generic_type's header for why this port resolves a
    ; global on demand where the reference resolves forty at start-up, and why
    ; the report is the one part not ported.
    ;
    ; ★ ARITY ZERO, which is what makes `empty_object_type` the miss value rather
    ; than `empty_generic_type`; get_global_type_of_arity carries that fork.
    procedure get_global_reg_exp_type(this) returns ref[Type]?
    {
        if global_reg_exp_type <> null
            return global_reg_exp_type
        let t this.get_global_type_of_arity("RegExp", 0)
        set global_reg_exp_type: t
        t
    }

    ; getGlobalType("IArguments", 0, reportErrors) — the type of the `arguments`
    ; symbol, and the one line of initializeChecker that its neighbours' slice had
    ; to leave out: the three seeds beside it (undefined, unknown, globalThis) name
    ; a type this checker already holds, while this one names a LIB INTERFACE.
    procedure get_global_i_arguments_type(this) returns ref[Type]?
    {
        if global_i_arguments_type <> null
            return global_i_arguments_type
        let t this.get_global_type_of_arity("IArguments", 0)
        set global_i_arguments_type: t
        t
    }

    ; checkRegularExpressionLiteral, whole. The TYPE is a constant; everything
    ; this arm actually does is the grammar check, and it runs ONCE per literal —
    ; TypeChecked on the node's links is what makes it once, and it matters here
    ; more than elsewhere because the check REPORTS.
    procedure check_regular_expression_literal(this, node: ref[AstNode]?) returns ref[Type]?
    {
        let n node as ref[AstNode]
        let links this.node_link_of(n)
        if links.type_checked = false
        {
            set links.type_checked: true
            this.check_grammar_regular_expression_literal(n)
        }
        this.get_global_reg_exp_type()
    }

    ; checkGrammarRegularExpressionLiteral, whole — and it is the ONE caller of
    ; the scanner's reportErrors branch, which is the whole reason that branch
    ; and its parameter exist (see Scanner.re_scan_slash_token).
    ;
    ; ★★★ THE ERROR CALLBACK IS THE INTERESTING HALF AND IT IS NOT THE PARSER'S.
    ; Upstream installs a SetOnError whose body is three lines with two rules:
    ; a CategoryMessage diagnostic landing on exactly the span of the last one
    ; reported becomes RELATED INFO rather than a report, and any diagnostic
    ; landing at the same POSITION as the last one reported is dropped. The
    ; second rule lives in Scanner.error_at behind `regexp_error_mode`, with its
    ; own memory, because DiagnosticList's dedup asks about the list's last entry
    ; and that is a different question once the checker has reported elsewhere in
    ; the file. The first cannot fire — RegExpParser's header has the argument.
    ;
    ; ★ The reference's `debug.Assert(tokenIsRegularExpressionLiteral)` is the
    ; whole use of ReScanSlashToken's answer, so what is ported is the call.
    procedure check_grammar_regular_expression_literal(this, node: ref[AstNode])
    {
        ; ★★ THE PARSE-DIAGNOSTIC GUARD, and here it is not merely tidiness: a
        ; file that failed to parse has token boundaries the re-scan would read
        ; as a regular expression that is not there.
        ; ★★ `sourceFile := ast.GetSourceFileOfNode(node)`: the NODE's file, not
        ; the one being checked. A regex literal of another file is reached
        ; through its declaration's type; with one checker its own file always
        ; came first, and the parallel checkers (slice 366) scanned the node's
        ; offset in the wrong text.
        let sf Checker.source_file_of_node(node)
        if sf = null
            return
        let rsf sf as ref[AstNode]
        if AstNode.diagnostic_count(rsf) > 0
            return
        var sc: ref[Scanner]? reg_exp_scanner
        if sc = null
        {
            let fresh &Scanner^host()
            set reg_exp_scanner: fresh
            set sc: fresh
        }
        let rx sc as ref[Scanner]
        rx.set_script_target(language_version)
        rx.set_language_variant_jsx(language_variant_is_jsx(this.script_kind_of_file(rsf)))
        let nb this.binder_of_node(node)
        let text nb.trivia.buffer
        let at AstNode.pos_of(node)
        let regexp_mark diagnostics.length()
        rx.begin_regexp_scan(text, diagnostics, at)
        rx.scan()
        rx.re_scan_slash_token(true)
        ; the scanner reports untagged: the regular expression is its file's
        diagnostics.retag_from(regexp_mark, this.program_index_of_node(rsf))
    }

