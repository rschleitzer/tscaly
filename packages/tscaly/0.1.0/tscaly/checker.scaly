                ; set before the `if !elaborated` fork — so the helper's answer is
                ; not read: a failed relation is a reported element whether the
                ; recursion narrowed the span or the tail issued the message.
                let ignored this.elaborate_iterable_element_report(source, tp, relation, prop, el.inner_expression, name_type, spt, tpt, el.text_child_code, el.text_child_args)
                set reported: true
