        ; location and no message.
        let mark2 this.unported_mark()
        let global_jsx this.resolve_symbol(this.resolve_name(null, "JSX", SymbolFlagsNamespace, 0, false, false))
        if this.unported_mark() <> mark2
            return null
        if global_jsx <> null
        {
            if (global_jsx as ref[Symbol]) <> unknown_symbol
                return global_jsx
        }
        ; ★★★ THE UNIT-WIDE LATCH THAT STOOD HERE WAS A CLAIM ABOUT ONE STOP, AND
        ; THAT STOP NO LONGER EXISTS. It read: *a `declare global { namespace JSX
        ; { … } }` inside a module is a GLOBAL AUGMENTATION, and merging one stops
        ; (`merge-module-augmentation`) … so on a unit that has already stopped,
        ; answering “there is no JSX namespace” would make `getIntrinsicTagSymbol`
        ; emit TS7026 for a namespace the reference found* — and it guarded on
        ; `is_unported()`, the whole unit's latch, because *no delta taken across
        ; this call can see* a stop from `initialize_checker`.
        ;
        ; The premise expired: `merge_module_augmentation` is whole, and its
        ; global-scope arm merges the augmentation's exports into `globals` — so
        ; `record_unported("merge-module-augmentation", …)` is not in this file any
        ; more. What the latch cost meanwhile is the frontier's LARGEST row, 111
        ; units at stage 2, because it fires wherever a JSX file met ANY unrelated
        ; wall first.
        ;
        ; ★★★ THE WIDTH IS WHY IT COULD NOT BE RE-JUDGED BY READING. A latch on the
        ; unit is a claim about every stop in the checker, so its correctness is not
        ; a property of this function and no reading of this function can settle it;
        ; only the two instruments that see the whole unit can — `diagcheck` over
        ; the corpus and the stage-2 verdict transition. Both are what retired it,
        ; and `compiler_jsxHexEntityUppercaseMarker.tsx`, the unit named in the old
        ; note as the witness FOR the guard, is the control: it must stay clean.
        null
    }

    ; getJsxNamespaceContainerForImplicitImport, whole since slice 255. The
    ; program's `GetJSXRuntimeImportSpecifier` is computed here from the file:
    ; fileloader.go builds it for a JSX or TSX script kind out of
    ; GetJSXImplicitImportBase and GetJSXRuntimeImport, and its synthetic import
    ; specifier is the location (the port has no synthesized literal to hand).
    procedure get_jsx_namespace_container_for_implicit_import(this, location: ref[AstNode]?) returns ref[Symbol]?
    {
