                if this.unported_mark() <> mark
                {
                    this.pop_type_resolution_defensively()
                    return null
                }
            }
        }
        if t = null
        {
            var reported false
            if setter <> null
            {
                if this.is_private_within_ambient(setter as ref[AstNode]) = false
                {
                    if Checker.no_implicit_any()
                        this.error_on_node(setter as ref[AstNode], DiagProperty_0_implicitly_has_type_any_because_its_set_accessor_lacks_a_parameter_type_annotation, this.symbol_arg(symbol))
                    set reported: true
                }
            }
            if reported = false
            {
                if getter <> null
                {
                    if this.is_private_within_ambient(getter as ref[AstNode]) = false
                    {
                        if Checker.no_implicit_any()
                            this.error_on_node(getter as ref[AstNode], DiagProperty_0_implicitly_has_type_any_because_its_get_accessor_lacks_a_return_type_annotation, this.symbol_arg(symbol))
                        set reported: true
                    }
                }
            }
            if reported = false
            {
                if accessor <> null
                {
                    if this.is_private_within_ambient(accessor as ref[AstNode]) = false
                    {
                        if Checker.no_implicit_any()
                            this.error_on_node(accessor as ref[AstNode], DiagMember_0_implicitly_has_an_1_type, this.symbol_arg(symbol), "any")
                    }
                }
            }
            set t: any_type
