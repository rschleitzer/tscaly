    function substitution_base_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Substitution
                return d.base_type
        null
    }

    function substitution_constraint_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Substitution
                return d.constraint
        null
