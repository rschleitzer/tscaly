                ; "Unlike in 'checkPrivateIdentifierExpression' we now have access
                ; to the RHS type which provides us with the opportunity to emit
                ; more detailed errors."
                let links this.symbol_node_link_of(left)
                if links.resolved_symbol = null
                {
                    if Checker.get_containing_class(left) <> null
                    {
                        let unchecked this.is_unchecked_js_suggestion(left, rt.symbol, true)
                        if this.unported_mark() <> mark
                            return null
                        this.report_nonexistent_property(left, rt, unchecked)
                        if this.unported_mark() <> mark
                            return null
                    }
                }
            }
            else
            {
                if string_number_symbol_type = null
                {
                    this.record_unported("string-number-symbol-type-unminted", op_kind)
                    return null
                }
                let ln this.check_non_null_type(lt, left)
                if this.unported_mark() <> mark
                    return null
                if ln = null
                    return null
                this.check_type_assignable_to(ln as ref[Type], string_number_symbol_type as ref[Type], left, 0)
                if this.unported_mark() <> mark
                    return null
            }
            let rn this.check_non_null_type(rt, right)
            if this.unported_mark() <> mark
                return null
            if rn = null
                return null
            let object_ok this.check_type_assignable_to(rn as ref[Type], non_primitive_type, right, 0)
            if this.unported_mark() <> mark
                return null
            if object_ok
            {
                ; "The {} type is assignable to the object type, yet {} might
                ; represent a primitive type." The report is on the ORIGINAL right
                ; type, not the non-null one.
                let empty this.has_empty_object_intersection(rt)
                if this.unported_mark() <> mark
                    return null
                if empty
                {
                    let right_name this.type_arg(rt)
                    this.error_on_node(right, DiagType_0_may_represent_a_primitive_value_which_is_not_permitted_as_the_right_operand_of_the_in_operator, right_name)
                }
            }
            return boolean_type
        }

        ; `&&`, `||`, `??` and their three compound spellings.
        ;
        ; ★★★ ALL SIX HAVE THE SAME SHAPE AND SLICE 90 SPLITS THEM IN TWO: the
        ; answer is `resultType := leftType`, and the UNION is built only INSIDE an
        ; `if hasTypeFacts(leftType, F)`. So the operator answers its LEFT operand's
        ; type whenever that fact is absent — which is a real answer this port can
        ; give, and the first one this chapter has ever given.
        ;
        ; ★★★ THE THREE FACTS ARE NOT INTERCHANGEABLE AND THE OBJECT ARM IS WHY.
        ; `??` asks EQUndefinedOrNull and `checkNonNullType` asks IsUndefinedOrNull;
        ; neither is among the object facts under strictNullChecks, so an object
        ; operand takes getTypeFactsWorker's early-out and answers None without
        ; touching a member. `&&` asks Truthy and `||` asks Falsy, and BOTH are in
        ; TypeFactsEmptyObjectStrictFacts — so those two meet the members wall on an
        ; object operand where `??` does not. See get_type_facts_worker's header.
        ;
