        ; constituents are a SUBSET of a sorted list and are therefore still
        ; sorted, so there is nothing to reduce, and this spelling is the one that
        ; forwards the two object-flag hints upstream forwards here (the comment
        ; there notes `ContainsIntersections` may be forwarded "incorrectly" and
        ; that this is harmless, being only a hint).
        var origin_single: ref[Type]? null
        let new_origin this.filtered_union_origin(t, out, &origin_single)
        if origin_single <> null
            return origin_single
        this.get_union_type_from_sorted_list(out, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
    }

    procedure jsx_children_filter_admits(this, t: ref[Type], kind: int, any_iterable: ref[Type]?) returns bool
    {
        if kind = JsxChildFilterAssignable
        {
            if any_iterable = null
                return false
            return this.is_type_assignable_to(t, any_iterable as ref[Type])
        }
        if kind = JsxChildFilterNotAssignable
        {
            if any_iterable = null
                return true
            return this.is_type_assignable_to(t, any_iterable as ref[Type]) = false
        }
        if kind = JsxChildFilterArrayLike
            return this.is_array_or_tuple_like_type(t)
        this.is_array_or_tuple_like_type(t) = false
    }

    ; generateJsxChildren — upstream an `iter.Seq` yielded lazily; here the LIST,
    ; which is exact rather than a convenience: its one consumer walks it to the end
    ; with no break, so the generator's early-exit path (`if !yield(e) { return }`)
    ; is unreachable and the two spellings observe the same elements in the same
    ; order.
    ;
    ; ★★★ `memberOffset` IS THE WHOLE REASON THE INDEX IS NOT THE LOOP VARIABLE. A
    ; whitespace-only JsxText yields NOTHING and does not consume a position, so the
    ; children `["a", <ws>, "b"]` elaborate against tuple slots 0 and 1 rather than
    ; 0 and 2 — and the name type is built from the ADJUSTED index.
    ; getInvalidTextualChildDiagnostic's arguments: the tag's text, the children
    ; property's name and the children target type
    procedure jsx_text_child_args(this, tag_name: ref[AstNode]?, children_prop: Slice[char], children_target: ref[Type]) returns ref[Array[String]]
    {
        ; copied onto host: the array outlives this frame
        let args this.message_args()
        let h host
        let tag_text this.node_text_arg(tag_name)
        let c0 String^h(tag_text)
        args.add(c0)
        let c1 String^h(children_prop.data as pointer[const_char], children_prop.length)
        args.add(c1)
        let target_text this.type_arg(children_target)
        let c2 String^h(target_text)
        args.add(c2)
        args
    }

    procedure generate_jsx_children(this, node: ref[AstNode], tag_name: ref[AstNode]?, children_prop: Slice[char], children_target: ref[Type]) returns ref[Array[ref[JsxElaborationElement]?]]
    {
        let out &Array[ref[JsxElaborationElement]?]^host()
        let kids AstNode.jsx_children_of(node)
        let n AstNode.list_count(kids)
        var member_offset 0
        var i 0
        while i < n
        {
            let child AstNode.child_in_list(kids, i)
            if child <> null
            {
                let name_type this.get_number_literal_type(Checker.number_bits_from_int(i - member_offset))
                var error_node: ref[AstNode]? null
                var inner: ref[AstNode]? null
                var text_code 0
                Checker.elaboration_element_for_jsx_child(child as ref[AstNode], &error_node, &inner, &text_code)
                if error_node <> null
                {
                    var text_args: ref[Array[String]]? null
                    if text_code <> 0
                        set text_args: this.jsx_text_child_args(tag_name, children_prop, children_target)
                    out.add(&JsxElaborationElement^host(error_node, inner, name_type, text_code, text_args))
                }
                else
                    set member_offset: member_offset + 1
            }
            set i: i + 1
        }
        out
    }

    ; getElaborationElementForJsxChild. ★It is the out-parameter shape rather than a
    ; returned record because two of its three callers want only the error node and
    ; the inner expression, and the third is the list builder above; a whitespace-
    ; only JsxText answers the EMPTY element, which is a null error node.
    procedure elaboration_element_for_jsx_child(child: ref[AstNode], out_error_node: ref[ref[AstNode]?], out_inner: ref[ref[AstNode]?], out_text_code: ref[int])
    {
        set out_error_node: null
        set out_inner: null
        set out_text_code: 0
        let k AstNode.kind_of(child)
        if k = KindJsxExpression
        {
            ; "child is of the type of the expression"
            set out_error_node: child
            set out_inner: AstNode.expression_of(child)
            return
        }
        if k = KindJsxText
        {
            ; "Whitespace only jsx text isn't real jsx text"
            if AstNode.jsx_text_is_whitespace_only(child)
                return
            ; "child is a string" — and the custom diagnostic is what makes this arm
            ; different from the other two.
            set out_error_node: child
            set out_text_code: DiagX_0_components_don_t_accept_text_as_child_elements_Text_in_JSX_has_the_type_string_but_the_expected_type_of_1_is_2
            return
        }
        if k = KindJsxElement
        {
            set out_error_node: child
            set out_inner: child
            return
        }
        if k = KindJsxSelfClosingElement
        {
            set out_error_node: child
            set out_inner: child
            return
        }
        if k = KindJsxFragment
        {
            set out_error_node: child
            set out_inner: child
            return
        }
    }

    ; elaborateIterableOrArrayLikeTargetElementwise — the MULTI-child branch's
    ; worker, and it re-splits the target the way its caller split the children
    ; type, because the target it is handed may still be a union.
    ;
    ; ★★★ THE TARGET PROPERTY TYPE IS A UNION OF TWO SOURCES AND EITHER MAY BE
    ; ABSENT: the ITERATION type of the non-array-like parts (one value for every
    ; element) and the INDEXED type of the array-like parts (one per position). With
    ; both present the element is compared against their union; with neither the
    ; element is SKIPPED, which is the `continue` and not a report.
    procedure elaborate_iterable_or_array_like_target_elementwise(this, elements: ref[Array[ref[JsxElaborationElement]?]], source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        let mark this.unported_mark()
        let tuple_parts this.filter_type_by_jsx_children_kind(target, JsxChildFilterArrayLike, null)
        if this.unported_mark() <> mark
            return false
        let non_tuple_parts this.filter_type_by_jsx_children_kind(target, JsxChildFilterNotArrayLike, null)
        if this.unported_mark() <> mark
            return false
        if tuple_parts = null
            return false
        if non_tuple_parts = null
            return false
        let tp tuple_parts as ref[Type]
        let ntp non_tuple_parts as ref[Type]
        ; "If `nonTupleOrArrayLikeTargetParts` is not `never`, then that should mean
        ; `Iterable` is defined."
        var iteration_type: ref[Type]? null
        if ntp <> never_type
        {
            set iteration_type: this.get_iteration_type_of_iterable(IterationUseForOf, IterationTypeKindYield, ntp, null)
            if this.unported_mark() <> mark
                return false
        }
        var reported false
        let n elements.get_length() as int
        var i 0
        while i < n
        {
            let e elements[i]
            set i: i + 1
            if e = null
                continue
            let el e as ref[JsxElaborationElement]
            if el.error_node = null
                continue
            if el.name_type = null
                continue
            let prop el.error_node as ref[AstNode]
            let name_type el.name_type as ref[Type]
            var target_prop_type iteration_type
            if tp <> never_type
            {
                let indexed this.get_best_match_indexed_access_type_or_undefined(source, tp, name_type)
                if this.unported_mark() <> mark
                    return reported
                if indexed <> null
                {
                    let ix indexed as ref[Type]
                    if (ix.flags & TypeFlagsIndexedAccess) = 0
                    {
                        if iteration_type = null
                            set target_prop_type: ix
                        else
                        {
                            let pair this.new_type_list_of(2)
                            pair.add(iteration_type)
                            pair.add(ix)
                            set target_prop_type: this.get_union_type_ex(pair, UnionReductionLiteral, null, null)
                            if this.unported_mark() <> mark
