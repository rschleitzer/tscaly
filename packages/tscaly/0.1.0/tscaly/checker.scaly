        ; REFERENCE'S, with its own six-line reason: *"we need to ensure that the
        ; result is present for the error checks below so that if this signature is
        ; encountered again, we handle the circularity (rather than producing a
        ; different result which may produce no errors and assert)"*. The report
        ; below re-runs the argument comparison, which can ask for this very
        ; signature again through a contextual type.
        let fallback this.get_candidate_for_overload_failure(node, cands, args, check_mode)
        if this.unported_mark() <> mark
            return null
        if fallback = null
            return null
        let links this.signature_link_of(node)
        set links.resolved_signature: fallback
