        set c.global_iterator_return_result_type: null
        set c.global_promise_type: null
        set c.global_promise_like_type: null
        set c.global_template_strings_array_type: null
        set c.global_import_call_options_type: null
        set c.global_builtin_iterator_types: null
        set c.global_async_builtin_iterator_types: null
