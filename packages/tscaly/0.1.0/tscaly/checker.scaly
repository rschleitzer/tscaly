    function base_name_of(path: Slice[char]) returns Slice[char]
    {
        var i (path.length as int) - 1
        while i >= 0
        {
            if path[i] = ("/" as char)
                return path.slice_from((i + 1) as size_t)
            set i: i - 1
        }
        path
    }

    ; the lib chain's files in the reference's program order: sortLibs ranks them
    ; by lib_priority, ties in load order
    procedure lib_chain_index_of(this, sf: ref[AstNode]) returns int
    {
        if lib_file = null
            return 0 - 1
        var my_index 0 - 1
        if sf = lib_file
            set my_index: 0
        else
        {
            let li this.extra_lib_index_of(sf)
            if li < 0
                return 0 - 1
            set my_index: li + 1
        }
        return this.lib_rank_at(my_index)
    }

    ; the rank of lib file `my_index` in the lib files' sorted order, computed for
    ; every lib file at once and kept while the lib count stands
    procedure lib_rank_at(this, my_index: int) returns int
    {
        let count this.lib_file_count()
        var ranks_ok false
        if lib_ranks <> null
        {
            if ((lib_ranks as ref[Array[int]]).get_length() as int) = count
                set ranks_ok: true
        }
        if ranks_ok = false
        {
            let fresh &Array[int]^host()
            var k 0
            while k < count
            {
                fresh.add(this.lib_rank_uncached(k))
                set k: k + 1
            }
            set lib_ranks: fresh
        }
        (lib_ranks as ref[Array[int]])[my_index as size_t]
    }

    procedure lib_rank_uncached(this, my_index: int) returns int
    {
        let mine this.lib_file_at(my_index)
        if mine = null
            return 0
        let my_priority Checker.lib_priority(Checker.base_name_of((this.binder_of_node(mine)).file_name))
        var rank 0
        var ci 0
        let count this.lib_file_count()
        while ci < count
        {
            if ci <> my_index
            {
                let other this.lib_file_at(ci)
                if other <> null
                {
                    let p Checker.lib_priority(Checker.base_name_of((this.binder_of_node(other)).file_name))
                    if (p < my_priority) or ((p = my_priority) and (ci < my_index))
                        set rank: rank + 1
                }
            }
            set ci: ci + 1
        }
        rank
    }

    function lib_file_count(this) returns int
    {
        if lib_file = null
            return 0
        if extra_lib_files = null
            return 1
        1 + ((extra_lib_files as ref[Array[ref[AstNode]?]]).get_length() as int)
    }

    function lib_file_at(this, i: int) returns ref[AstNode]?
    {
        if i = 0
            return lib_file
        if extra_lib_files = null
            return null
        (extra_lib_files as ref[Array[ref[AstNode]?]])[(i - 1) as size_t]
    }

    ; c.fileIndexMap: the lib files first in their sorted order, then the
    ; program's files in program order; a file outside both (the single-unit
    ; runs' own file) after the libs
    procedure file_index_of(this, sf: ref[AstNode]?) returns int
    {
        if sf = null
            return 0 - 1
        let f sf as ref[AstNode]
        let li this.lib_chain_index_of(f)
        if li >= 0
            return li
        let libs this.lib_file_count()
        if program <> null
        {
            let pi (program as ref[ProgramFiles]).index_of_file(f)
            if pi >= 0
                return libs + pi
        }
        libs
    }

    ; compareNodes: by the file's index in the program, then by position
    procedure compare_nodes_ex(this, n1: ref[AstNode]?, n2: ref[AstNode]?) returns int
    {
        if n1 = n2
            return 0
        if n1 = null
            return 1
        if n2 = null
            return 0 - 1
        let s1 Checker.source_file_of_node(n1)
        let s2 Checker.source_file_of_node(n2)
        if s1 <> s2
        {
            let f1 this.file_index_of(s1)
            let f2 this.file_index_of(s2)
            if f1 <> f2
                return f1 - f2
        }
        AstNode.pos_of(n1 as ref[AstNode]) - AstNode.pos_of(n2 as ref[AstNode])
    }

    ; compareNodes without a program: position only (the static form the
    ; single-file callers keep)
    function compare_nodes(n1: ref[AstNode]?, n2: ref[AstNode]?) returns int
    {
        if n1 = n2
            return 0
        if n1 = null
            return 1
        if n2 = null
            return 0 - 1
        AstNode.pos_of(n1 as ref[AstNode]) - AstNode.pos_of(n2 as ref[AstNode])
    }

    ; strings.Compare over the two names, as bytes.
    function compare_names(d1: Slice[char], d2: Slice[char]) returns int
    {
        var n d1.length
        if d2.length < n
            set n: d2.length
        var i 0
        while i < n
        {
            let a (d1[i]) as u8
            let b2 (d2[i]) as u8
            if a < b2
                return 0 - 1
            if a > b2
                return 1
            set i: i + 1
        }
        if d1.length < d2.length
            return 0 - 1
        if d1.length > d2.length
            return 1
        0
    }

    ; compareSymbolsWorker, WHOLE since slice 195.
    ;
    ; ★★★ THE SYMBOL-ID FALLBACK WAS A STOP THROUGH TWO WRONG ARGUMENTS, AND EACH
    ; ONE WAS RETIRED BY A MEASUREMENT RATHER THAN BY A DECISION. The first —
    ; *every list this port sorts is built out of ONE SymbolTable, which is keyed by
    ; name*, so the fallback cannot be reached — was corrected in slice 179 when the
    ; report fired on five stage-2 units. The second — *there is nothing here to ask
    ; WHICH binder owns a declaration-less symbol, and an id drawn at the wrong
    ; counter would shift a later class's private-name mangling* — assumed the
    ; question was open; it is not. See the tail below: the arrivals are TRANSIENT
    ; symbols, and a transient symbol's binder is the unit's by the same rule
    ; `get_es_symbol_like_type_for_node` already follows.
    procedure compare_symbols(this, s1: ref[Symbol]?, s2: ref[Symbol]?) returns int
    {
        if s1 = s2
            return 0
        if s1 = null
            return 1
        if s2 = null
            return 0 - 1
        let sa s1 as ref[Symbol]
        let sb s2 as ref[Symbol]
        let n1 Symbol.declaration_count(sa)
        let n2 Symbol.declaration_count(sb)
        if n1 <> 0
        {
            if n2 <> 0
            {
                let r this.compare_nodes_ex(Symbol.declaration_at(sa, 0), Symbol.declaration_at(sb, 0))
                if r <> 0
                    return r
            }
            if n2 = 0
                return 0 - 1
        }
        if n1 = 0
        {
            if n2 <> 0
                return 1
        }
        let rn Checker.compare_names(Symbol.name_of(sa), Symbol.name_of(sb))
        if rn <> 0
            return rn
        ; `int(ast.GetSymbolId(s1)) - int(ast.GetSymbolId(s2))`, upstream's own last
        ; resort, with its comment: *should happen only when symbols have no
        ; declaration and duplicate names*.
        ;
        ; ★★★ WHICH COUNTER IS NOT A CHOICE, AND THE ROW'S OPEN QUESTION IS WHAT
        ; ANSWERED IT. The note here asked *which list has two declaration-less
        ; entries of one name*; a probe on the six arrivals says every one of them is
        ; a pair of TRANSIENT property symbols (`Transient|Property`, some also
        ; `Optional`) — the checker's own synthesized members, reached through
        ; compare_types' Object arm. A transient symbol has no declaration, therefore
        ; no node, therefore `binder_of_node(null)` answers the UNIT's binder: the
        ; same counter get_es_symbol_like_type_for_node already draws from. The
        ; second counter this port has belongs to the LIB binder and nothing draws
        ; from it (lib.es5.d.ts declares no private identifier), so the one number
        ; upstream hands out and the one this port hands out are the same number.
        ;
        ; ★★ THE TWO DRAWS ARE TWO STATEMENTS BECAUSE THE ORDER *IS* THE ANSWER.
        ; An id is drawn lazily, so at the first comparison of a pair neither symbol
        ; has one: s1 draws first and the difference is negative. That is what
        ; upstream's left-to-right evaluation of the subtraction says, and writing it
        ; as one expression would leave it to this compiler to agree by accident.
        let bn this.binder_of_node(null)
        let id1 bn.get_symbol_id(sa)
        let id2 bn.get_symbol_id(sb)
        id1 - id2
    }

    ; sortSymbols over a SUB-RANGE, which is what getNamedMembers' two calls are
    ; (`result[:containedCount]` and `result[containedCount:]`).
    ;
    ; ★★ IT IS AN INSERTION SORT AND THAT IS A MEASUREMENT RATHER THAN A SHRUG:
    ; the range is one type's member list, and `slices.SortFunc` is not stable
    ; either — what the two share is the ORDER they produce, which for a comparator
    ; that never answers 0 (see compare_symbols) is unique. Scaly's Array has no
    ; sort, and a quicksort over a list this size would be more code for no
    ; measurable difference.
    procedure sort_symbols(this, list: ref[Array[ref[Symbol]?]], from: int, to: int)
    {
        var i from + 1
        while i < to
        {
            let key list[i]
            var j i - 1
            while j >= from
            {
                let cur list[j]
                if this.compare_symbols(cur, key) <= 0
                    break
                list.put((j + 1) as size_t, cur)
                set j: j - 1
            }
            list.put((j + 1) as size_t, key)
            set i: i + 1
        }
    }

    ; getNamedMembers, whole.
    ;
    ; ★★ THE TWO PASSES ARE NOT AN OPTIMISATION AND THE COMMENT UPSTREAM SAYS SO:
    ; a class's or interface's OWN members are stored ahead of the inherited ones,
    ; *"because explicitly declared members are more likely to contain
    ; discriminating differences"* in a type relation. The order is therefore
    ; observable by the relation and by nothing in this port yet, which is why the
    ; battery gates it with a reader named rather than with a colour.
    procedure get_named_members(this, members: ref[SymbolTable]?, container: ref[Symbol]?) returns ref[Array[ref[Symbol]?]]?
    {
        let n SymbolTable.length(members)
        if n = 0
            return null
        ; sized once: the list is kept, and doubling left every smaller buffer behind
        let result &Array[ref[Symbol]?]^host(n as size_t)
        var container_is_class_or_interface false
        if container <> null
        {
            let cs container as ref[Symbol]
            if (Symbol.flags_of(cs) & (SymbolFlagsClass | SymbolFlagsInterface)) <> 0
                set container_is_class_or_interface: true
        }
        var contained_count 0
        if container_is_class_or_interface
        {
            let cs container as ref[Symbol]
            var i 0
            while i < n
            {
                let sym SymbolTable.entry_symbol_at(members, i)
                let nd SymbolTable.entry_name_at(members, i)
                let nl SymbolTable.entry_name_len_at(members, i)
                if this.is_named_member(sym, nd)
                {
                    if this.is_declaration_contained_by(sym as ref[Symbol], cs)
                        result.add(sym)
                }
                set i: i + 1
            }
            set contained_count: result.get_length() as int
        }
        var j 0
        while j < n
        {
            let sym SymbolTable.entry_symbol_at(members, j)
            let nd SymbolTable.entry_name_at(members, j)
            let nl SymbolTable.entry_name_len_at(members, j)
            if this.is_named_member(sym, nd)
            {
                var take true
                if container_is_class_or_interface
                {
                    let cs container as ref[Symbol]
                    if this.is_declaration_contained_by(sym as ref[Symbol], cs)
                        set take: false
                }
                if take
                    result.add(sym)
            }
            set j: j + 1
        }
        this.sort_symbols(result, 0, contained_count)
        this.sort_symbols(result, contained_count, result.get_length() as int)
        result
    }

    ; ── THE LATE-BINDING TABLE (slice 129) ──────────────────────────────────
    ;
    ; ★★★ WHAT THIS CHAPTER IS: a member whose name is COMPUTED gets a symbol from
    ; the binder under the internal name `computed`, and its REAL name is only
    ; knowable once the computed expression has a type. So a second, "late" binding
    ; phase runs over the container's declarations, types every computed name, and
    ; files the member under the name that type spells. getMembersOfSymbol and
    ; getExportsOfSymbol are its two doors and getLateBoundSymbol is the third.
    ;
    ; ★★★ IT IS ONE MECHANISM SEEN FROM SEVEN PLACES, which is why the seven stops
    ; it retires were never seven chapters: `late-bound-members`,
    ; `late-bound-exports`, `late-bound-module-exports`,
    ; `late-bound-object-literal-member`, `get-late-bound-symbol`,
    ; `has-late-bindable-name` and `is-late-bindable-name` all sit on the same
    ; table, and the two stand-ins the members and exports doors carried
    ; (*does any declaration have a computed name? then stop*) were the same
    ; question asked without the answer.

    ; getExcludedSymbolFlags, whole — the set a declaration of these flags may NOT
    ; merge with. ★ReplaceableByMethod is a SUBTRACTION and stands last, which is
    ; what lets a JavaScript expando property be replaced by a method of the same
    ; name.
    function get_excluded_symbol_flags(flags: int) returns int
    {
        var result 0
        if (flags & SymbolFlagsBlockScopedVariable) <> 0
            set result: result | SymbolFlagsBlockScopedVariableExcludes
        if (flags & SymbolFlagsFunctionScopedVariable) <> 0
            set result: result | SymbolFlagsFunctionScopedVariableExcludes
        if (flags & SymbolFlagsProperty) <> 0
            set result: result | SymbolFlagsPropertyExcludes
        if (flags & SymbolFlagsEnumMember) <> 0
            set result: result | SymbolFlagsEnumMemberExcludes
        if (flags & SymbolFlagsFunction) <> 0
            set result: result | SymbolFlagsFunctionExcludes
        if (flags & SymbolFlagsClass) <> 0
            set result: result | SymbolFlagsClassExcludes
        if (flags & SymbolFlagsInterface) <> 0
            set result: result | SymbolFlagsInterfaceExcludes
        if (flags & SymbolFlagsRegularEnum) <> 0
            set result: result | SymbolFlagsRegularEnumExcludes
        if (flags & SymbolFlagsConstEnum) <> 0
            set result: result | SymbolFlagsConstEnumExcludes
        if (flags & SymbolFlagsValueModule) <> 0
            set result: result | SymbolFlagsValueModuleExcludes
        if (flags & SymbolFlagsMethod) <> 0
            set result: result | SymbolFlagsMethodExcludes
        if (flags & SymbolFlagsGetAccessor) <> 0
            set result: result | SymbolFlagsGetAccessorExcludes
        if (flags & SymbolFlagsSetAccessor) <> 0
            set result: result | SymbolFlagsSetAccessorExcludes
        if (flags & SymbolFlagsTypeParameter) <> 0
            set result: result | SymbolFlagsTypeParameterExcludes
        if (flags & SymbolFlagsTypeAlias) <> 0
            set result: result | SymbolFlagsTypeAliasExcludes
        if (flags & SymbolFlagsAlias) <> 0
            set result: result | SymbolFlagsAliasExcludes
        if (flags & SymbolFlagsReplaceableByMethod) <> 0
            set result: result & ~SymbolFlagsMethod
        result
    }

    ; getAdjustedNodeForError — the declaration's NAME if it has one.
    ; getAdjustedNodeForError. ★★★`GetNameOfDeclaration`, not `Node.Name()` — the
    ; same slip (§3.5hr): the point is to move a duplicate-identifier report off a
    ; DECLARATION and onto its name, and a JS assignment declaration is exactly the
    ; kind whose name is not in a slot. Takes `this` for the accessor.
    function get_adjusted_node_for_error(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let name b.get_name_of_declaration(node)
        if name = null
            return node
        name as ref[AstNode]
    }

    ; lookupOrIssueError, at the shape this port's diagnostics have.
    ;
    ; ★★★ UPSTREAM IT ANSWERS A DIAGNOSTIC SO THAT RELATED INFORMATION CAN BE HUNG
    ; ON IT; here a diagnostic is (pos, end, code) with no related information
    ; (§3.20, §3.24), so the whole of it is *report unless an identical one is
    ; already in the list* — which is the half that IS observable, because the
    ; second report of one duplicate-identifier pair would otherwise be a
    ; diagnostic the reference does not have.
    procedure lookup_or_issue_error(this, node: ref[AstNode], code: int)
    {
        this.lookup_or_issue_error_with(node, code, null)
    }

    procedure lookup_or_issue_error(this, node: ref[AstNode], code: int, a0: String)
    {
        let args this.message_args()
        args.add(a0)
        this.lookup_or_issue_error_with(node, code, args)
    }

    ; lookupOrIssueError — DiagnosticsCollection.Lookup compares the MESSAGE too;
    ; the index of the diagnostic found or added, -1 for none
    procedure lookup_or_issue_error_with(this, node: ref[AstNode], code: int, args: ref[Array[String]]?) returns int
    {
        if this.node_is_in_lib(node)
            return 0 - 1
        var start 0
        var stop 0
        if this.error_range_in_own_file(node, &start, &stop) = false
        {
            this.record_unported("error-range", AstNode.kind_of(node))
            return 0 - 1
        }
        let tag this.program_index_of_node(node)
        let n diagnostics.length()
        var i 0
        while i < n
        {
            var p 0
            var e 0
            var c 0
            if diagnostics.at(i, &p, &e, &c)
            {
                if (p = start) and (diagnostics.file_tag_at(i) = tag)
                {
                    if e = stop
                    {
                        ; CompareDiagnostics also compares the chain and the related
                        ; information, and this report has neither
                        if (c = code) and (diagnostics.chain_length_at(i) = 0) and (diagnostics.related_count_at(i) = 0)
                        {
                            if diagnostics.args_equal_at(i, args)
                                return i
                        }
                    }
                }
            }
            set i: i + 1
        }
        let before this.diagnostic_mark()
        this.add_diagnostic_at_node_with(start, stop, code, node, args)
        if this.diagnostic_mark() > before
            return before
        0 - 1
    }

    ; addDuplicateDeclarationErrorsForSymbols + addDuplicateDeclarationError, whose
    ; related-information half is a DROP here (§3.24's rule, one chapter over): the
    ; `0 was also declared here` / `and here` chain is related information on the
    ; diagnostic this port does not carry.
    procedure add_duplicate_declaration_errors_for_symbols(this, target: ref[Symbol], code: int, symbol_name: String, source: ref[Symbol]?)
    {
        let n Symbol.declaration_count(target)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(target, i)
            set i: i + 1
            if d = null
                continue
            let error_node this.get_adjusted_node_for_error(d as ref[AstNode])
            let args this.message_args()
            args.add(symbol_name)
            let index this.lookup_or_issue_error_with(error_node, code, args)
            if (index < 0) or (source = null)
                continue
            ; addDuplicateDeclarationError's related nodes: the other symbol's
            ; declarations, the first as `was also declared here`, the rest `and here`,
            ; five at most and none twice
            let src source as ref[Symbol]
            let m Symbol.declaration_count(src)
            var k 0
            while k < m
            {
                let rd Symbol.declaration_at(src, k)
                set k: k + 1
                if rd = null
                    continue
                let adjusted this.get_adjusted_node_for_error(rd as ref[AstNode])
                if adjusted = error_node
                    continue
                var start 0
                var stop 0
                if this.related_range_of(adjusted, &start, &stop) = false
                    continue
                let list diagnostics as ref[DiagnosticList]
                let count list.related_count_at(index)
                let file Checker.source_file_of_node(adjusted)
                if count >= 5
                    continue
                if list.related_contains_at(index, file, start, stop, DiagX_and_here, null) or list.related_contains_at(index, file, start, stop, DiagX_0_was_also_declared_here, args)
                    continue
                if count = 0
                    list.add_related_at(index, file, start, stop, DiagX_0_was_also_declared_here, args)
                else
                    list.add_related_at(index, file, start, stop, DiagX_and_here, null)
            }
        }
    }

    ; reportMergeSymbolError. ★The two `IsPlainJSFile` guards are FALSE under this
    ; harness for a TypeScript unit and are asked all the same, because a JS unit
    ; reaches this chapter too — checkJs is off here, so a plain JS file suppresses
    ; both reports.
    procedure report_merge_symbol_error(this, target: ref[Symbol], source: ref[Symbol])
    {
        var code DiagDuplicate_identifier_0
        var either_enum false
        if (Symbol.flags_of(target) & SymbolFlagsEnum) <> 0
            set either_enum: true
        if (Symbol.flags_of(source) & SymbolFlagsEnum) <> 0
            set either_enum: true
        var either_block_scoped false
        if (Symbol.flags_of(target) & SymbolFlagsBlockScopedVariable) <> 0
            set either_block_scoped: true
        if (Symbol.flags_of(source) & SymbolFlagsBlockScopedVariable) <> 0
            set either_block_scoped: true
        if either_enum
            set code: DiagEnum_declarations_can_only_merge_with_namespace_or_other_enum_declarations
        else
        {
            if either_block_scoped
                set code: DiagCannot_redeclare_block_scoped_variable_0
        }
        let symbol_name this.symbol_arg(source)
        if this.symbol_is_in_plain_js_file(source) = false
            this.add_duplicate_declaration_errors_for_symbols(source, code, symbol_name, target)
        if this.symbol_is_in_plain_js_file(target) = false
            this.add_duplicate_declaration_errors_for_symbols(target, code, symbol_name, source)
    }

    ; ast.IsPlainJSFile(GetSourceFileOfNode(getFirstDeclaration(symbol)), c.CheckJs)
    ; — a JavaScript file WITHOUT `checkJs`, i.e. one whose errors are not reported.
    function symbol_is_in_plain_js_file(this, symbol: ref[Symbol]) returns bool
    {
        let d Symbol.declaration_at(symbol, 0)
        if d = null
            return false
        if (AstNode.flags_of(d as ref[AstNode]) & NodeFlagsJavaScriptFile) = 0
            return false
        if (AstNode.flags_of(d as ref[AstNode]) & NodeFlagsJsonFile) <> 0
            return false
        if Checker.check_js_is_unset() = false
            return false
        let sf Checker.source_file_of_node(d)
        if sf = null
            return true
        AstNode.check_js_directive_of(sf) = CheckJsDirectiveNone
    }

    ; ── mergeSymbol and mergeSymbolTable (slice 137) ────────────────────────
    ;
    ; ★★★ THIS IS THE PRODUCER FOUR READERS OF THIS FILE HAVE NAMED IN THEIR OWN
    ; HEADERS, and each of them named it as the reason it was stopping rather than
    ; guessing: `combine_symbol_tables` (*"the merge is a stop and not a fold, and
    ; what it is waiting for is mergeSymbol"*), `merge_global_symbol` (*"storing the
    ; incoming symbol unmerged would answer a name with HALF its declarations, at rc
    ; 0"*), `clone_symbol` (*"the slice that ports mergeSymbol owes both"*) and
    ; `get_merged_symbol`, whose table had no writer at all. So the four are ONE
    ; chapter and never were four, which is why they retire together.
    ;
    ; ★★★ THE FUNCTION MUTATES ITS TARGET AND RETURNS IT, AND THE TARGET IS NOT
    ; ALWAYS THE ONE IT WAS GIVEN — the reference's own header says it: *if target is
    ; transient it is mutable, and mergeSymbol will both mutate and return it; if it
    ; is not transient, mergeSymbol will produce a transient CLONE, mutate that and
    ; return it*. Every caller must therefore use the RETURN and never assume the
    ; symbol it handed in was the one that changed; mergeSymbolTable's `target[id] =
    ; merged` is that rule written down at the only place it is easy to get wrong.
    procedure merge_symbol(this, target_in: ref[Symbol], source: ref[Symbol], unidirectional: bool) returns ref[Symbol]
    {
        var target target_in
        var mergeable false
        if (Symbol.flags_of(target) & Checker.get_excluded_symbol_flags(Symbol.flags_of(source))) = 0
            set mergeable: true
        if ((Symbol.flags_of(source) | Symbol.flags_of(target)) & SymbolFlagsAssignment) <> 0
            set mergeable: true
        if mergeable
        {
            ; `source == target` — an export-assigned namespace exporting something
            ; that is also exported at the top level reaches this with one symbol on
            ; both sides, and the reference returns rather than merging it into
            ; itself (its own comment names the fixture).
            if source = target
                return target
            if (Symbol.flags_of(target) & SymbolFlagsTransient) = 0
            {
                let resolved this.resolve_symbol(target)
                if resolved = null
                    return source
                let rt resolved as ref[Symbol]
                if rt = unknown_symbol
                    return source
                var ok false
                if (Symbol.flags_of(rt) & Checker.get_excluded_symbol_flags(Symbol.flags_of(source))) = 0
                    set ok: true
                if ((Symbol.flags_of(source) | Symbol.flags_of(rt)) & SymbolFlagsAssignment) <> 0
                    set ok: true
                if ok = false
                {
                    this.report_merge_symbol_error(target, source)
                    return source
                }
                set target: this.clone_symbol(rt)
            }
            ; The const-enum-only reset, and it is asked in BOTH directions: the
            ; flag comes OFF the target when an instantiated module merges into one
            ; that had only const enums, and it is masked OUT of the source's flags
            ; when the target does not carry it.
            var reset false
            if (Symbol.flags_of(source) & SymbolFlagsValueModule) <> 0
            {
                if (Symbol.flags_of(target) & SymbolFlagsValueModule) <> 0
                {
                    if (Symbol.flags_of(target) & SymbolFlagsConstEnumOnlyModule) <> 0
                    {
                        if (Symbol.flags_of(source) & SymbolFlagsConstEnumOnlyModule) = 0
                            set reset: true
                    }
                }
            }
            if reset
                Symbol.set_flags(target, Symbol.flags_of(target) & ~SymbolFlagsConstEnumOnlyModule)
            var source_flags Symbol.flags_of(source)
            if (Symbol.flags_of(target) & SymbolFlagsConstEnumOnlyModule) = 0
                set source_flags: source_flags & ~SymbolFlagsConstEnumOnlyModule
            Symbol.set_flags(target, Symbol.flags_of(target) | source_flags)
            if Symbol.value_declaration_of(source) <> null
                Binder.set_value_declaration(target, Symbol.value_declaration_of(source) as ref[AstNode])
            let dn Symbol.declaration_count(source)
            var di 0
            while di < dn
            {
                let d Symbol.declaration_at(source, di)
                if d <> null
                    Symbol.append_declaration(host, target, d as ref[AstNode])
                set di: di + 1
            }
            ; ★★ THE TWO TABLE MERGES DIFFER IN THEIR LAST ARGUMENT AND THAT IS THE
            ; WHOLE OF THE `mergedParent` MECHANISM: members get `nil`, exports get
            ; the merged TARGET, so a symbol that was itself merged while merging the
            ; exports is re-parented onto the survivor. See merge_symbol_table.
            if Symbol.members_of(source) <> null
                this.merge_symbol_table(Symbol.get_members(host, target), Symbol.members_of(source) as ref[SymbolTable], unidirectional, null)
            if Symbol.exports_of(source) <> null
                this.merge_symbol_table(Symbol.get_exports(host, target), Symbol.exports_of(source) as ref[SymbolTable], unidirectional, target)
            if unidirectional = false
                this.record_merged_symbol(target, source)
            return target
        }
        if (Symbol.flags_of(target) & SymbolFlagsNamespaceModule) <> 0
        {
            ; ★ The globalThis exemption is a report question and not a merge one:
            ; `var globalThis` has already drawn a *Declaration name conflicts* line,
            ; and the reference suppresses this one so the pair does not read as two
            ; unrelated complaints.
            if target <> global_this_symbol
                this.error_on_node_or_null(this.first_declaration_name(source), DiagCannot_augment_module_0_with_value_exports_because_it_resolves_to_a_non_module_entity, this.symbol_arg(target))
            return target
        }
        this.report_merge_symbol_error(target, source)
        target
    }

    ; ast.GetNameOfDeclaration(getFirstDeclaration(symbol)) — the one operand the
    ; merge's TS2649 needs. ★A symbol with no declaration answers null and
    ; error_on_node_or_null drops the report, which is the reference's own behaviour
    ; through a nil node.
    function first_declaration_name(this, symbol: ref[Symbol]) returns ref[AstNode]?
    {
        let d Symbol.declaration_at(symbol, 0)
        if d = null
            return null
        b.get_name_of_declaration(d as ref[AstNode])
    }

    ; mergeSymbolTable, whole.
    ;
    ; ★★★ THE `mergedParent` ARM IS ASKED OF THE **TARGET**, NOT OF THE MERGE'S
    ; RESULT, and the distinction is the reference's own worked example: merging a
    ; module augmentation into `a.ts`, the symbol for an interface the augmentation
    ; RE-declares is itself merged, so its parent must become the merged module;
    ; the symbol for one the augmentation declares ALONE has a single declaration,
    ; came only from the source, and keeps the augmentation as its parent. So the
    ; guard is `targetSymbol != nil` — was there something here to merge with —
    ; and the re-parenting is restricted to a TRANSIENT symbol, i.e. one this merge
    ; is entitled to mutate.
    procedure merge_symbol_table(this, target: ref[SymbolTable], source: ref[SymbolTable], unidirectional: bool, merged_parent: ref[Symbol]?)
    {
        let n SymbolTable.length(source)
        var i 0
        while i < n
        {
            let nd SymbolTable.entry_name_at(source, i)
            let nl SymbolTable.entry_name_len_at(source, i)
            let src SymbolTable.entry_symbol_at(source, i)
            if src <> null
            {
                let ss src as ref[Symbol]
                let existing SymbolTable.get(target, nd)
                var merged: ref[Symbol]? null
                if existing <> null
                    set merged: this.merge_symbol(existing as ref[Symbol], ss, unidirectional)
                else
                    set merged: this.get_merged_symbol(ss)
                if merged_parent <> null
                {
                    if existing <> null
                    {
                        let m merged as ref[Symbol]
                        if (Symbol.flags_of(m) & SymbolFlagsTransient) <> 0
                            Symbol.set_parent(m, merged_parent)
                    }
                }
                SymbolTable.set_entry(host, target, nd, merged)
            }
            set i: i + 1
        }
    }

    ; combineSymbolTables, WHOLE since slice 137 — two calls to merge_symbol_table
    ; where the reference has two, and the two empty fast paths in front of them.
    ;
    ; ★★★ ITS OLD NOTE NAMED THE PRODUCER AND THE SHAPE: *"a name that is in BOTH the
    ; early and the late table is a genuine merge (two declarations of one member),
    ; and answering either table alone would drop the other's declarations ... `class
    ; C { x: T; ["x"]: U }` — where lateBindMember has ALREADY reported the duplicate
    ; identifier"*. So the report was already made and only the TABLE was unfinished,
    ; which is why this arm changes what a member ANSWERS and not what it reports.
    procedure combine_symbol_tables(this, first: ref[SymbolTable]?, second: ref[SymbolTable]?) returns ref[SymbolTable]?
    {
        if SymbolTable.length(first) = 0
            return second
        if SymbolTable.length(second) = 0
            return first
        let combined SymbolTable.create(host)
        this.merge_symbol_table(combined, first as ref[SymbolTable], false, null)
        this.merge_symbol_table(combined, second as ref[SymbolTable], false, null)
        combined
    }

    ; The name a late-bound symbol carries has to outlive the function that computes
    ; it — getPropertyNameFromType's NUMBER arm answers into a caller-owned stack
    ; buffer (its own header says so) — so it is copied onto the checker's page.
    ; ★The string-literal arm already answers page memory and is copied anyway: a
    ; name that is sometimes borrowed and sometimes owned is the shape §3.5i warns
    ; about, and the copy is one allocation per late-bound member.
    procedure copy_name_to_page(this, d: Slice[char]) returns Slice[char]
    {
        let buf host.allocate(d.length as size_t, 1) as pointer[char]
        var i 0
        while i < d.length
        {
            set *(buf + i): d[i]
            set i: i + 1
        }
        Slice[char](d.length, buf)
    }

    ; addDeclarationToLateBoundSymbol, whole.
    procedure add_declaration_to_late_bound_symbol(this, symbol: ref[Symbol], member: ref[AstNode], symbol_flags: int)
    {
        let ms AstNode.symbol_of(member)
        if ms = null
            return
        let member_symbol ms as ref[Symbol]
        let links this.late_bound_link_of(member_symbol)
        set links.late_symbol: symbol
        var replaceable false
        if (Symbol.flags_of(member_symbol) & SymbolFlagsReplaceableByMethod) <> 0
            set replaceable: true
        if Symbol.declaration_count(symbol) = 0
        {
            Symbol.add_flags(symbol, symbol_flags)
            Symbol.append_declaration(host, symbol, member)
        }
        else
        {
            if replaceable = false
            {
                Symbol.add_flags(symbol, symbol_flags)
                Symbol.append_declaration(host, symbol, member)
            }
            else
            {
                var symbol_replaceable false
                if (Symbol.flags_of(symbol) & SymbolFlagsReplaceableByMethod) <> 0
                    set symbol_replaceable: true
                var member_is_method false
                if (Symbol.flags_of(member_symbol) & SymbolFlagsMethod) <> 0
                    set member_is_method: true
                if symbol_replaceable
                {
                    if member_is_method
                    {
                        ; "Remove all replacable-by-method members, along with their
                        ; flags", then re-derive the flags from what is left.
                        let kept &Array[ref[AstNode]?]^host()
                        let dn Symbol.declaration_count(symbol)
                        var i 0
                        while i < dn
                        {
                            let d Symbol.declaration_at(symbol, i)
                            set i: i + 1
                            if d = null
                                continue
                            let dsym AstNode.symbol_of(d as ref[AstNode])
                            if dsym = null
                                continue
                            if (Symbol.flags_of(dsym as ref[Symbol]) & SymbolFlagsReplaceableByMethod) <> 0
                                continue
                            kept.add(d)
                        }
                        kept.add(member)
                        let old_flags Symbol.flags_of(symbol)
                        Symbol.set_declarations(symbol, kept)
                        Symbol.set_flags(symbol, SymbolFlagsNone)
                        let kn kept.get_length() as int
                        var j 0
                        while j < kn
                        {
                            let d kept[j]
                            set j: j + 1
                            if d = null
                                continue
                            let dsym AstNode.symbol_of(d as ref[AstNode])
                            if dsym = null
                                continue
                            Symbol.add_flags(symbol, Symbol.flags_of(dsym as ref[Symbol]))
                        }
                        if (old_flags & SymbolFlagsAccessor) <> 0
                            Symbol.add_flags(symbol, SymbolFlagsAccessor)
                    }
                }
            }
        }
        if (symbol_flags & SymbolFlagsValue) <> 0
            Binder.set_value_declaration(symbol, member)
    }

    ; lateBindMember, whole.
    ;
    ; ★★★ THE MEMO IS THE RECURSION GUARD AND IT IS WRITTEN BEFORE THE TYPE IS
    ; ASKED FOR: `links.resolvedSymbol = decl.Symbol()` first, so that typing the
    ; computed name — which can reach this member again — falls back to the EARLY
    ; symbol instead of looping. The reference says so in a comment; it is the same
    ; discipline push_type_resolution gives the type memos.
    procedure late_bind_member(this, parent: ref[Symbol], early_symbols: ref[SymbolTable]?, late_symbols: ref[SymbolTable], decl: ref[AstNode]) returns ref[Symbol]?
    {
        let ds AstNode.symbol_of(decl)
        if ds = null
        {
            ; The reference asserts ("The member is expected to have a symbol.").
            this.record_unported("late-bind-member-no-symbol", AstNode.kind_of(decl))
            return null
        }
        let decl_symbol ds as ref[Symbol]
        let links this.symbol_node_link_of(decl)
        if links.resolved_symbol <> null
            return links.resolved_symbol
        set links.resolved_symbol: decl_symbol
        var decl_name: ref[AstNode]? null
        if AstNode.kind_of(decl) = KindBinaryExpression
            set decl_name: AstNode.binary_left_of(decl)
        else
            set decl_name: AstNode.name_of(decl)
        if decl_name = null
            return links.resolved_symbol
        let dn decl_name as ref[AstNode]
        var t: ref[Type]? null
        if AstNode.kind_of(dn) = KindElementAccessExpression
        {
            let arg AstNode.element_access_argument_of(dn)
            if arg = null
                return links.resolved_symbol
            set t: this.check_expression_cached(arg as ref[AstNode])
        }
        else
            set t: this.check_computed_property_name(dn)
        if t = null
            return links.resolved_symbol
        let ty t as ref[Type]
        if Checker.is_type_usable_as_property_name(ty) = false
            return links.resolved_symbol
        var nb char[JSNUM_MAX_TEXT]
        let raw this.get_property_name_from_type(ty, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if raw.data = null
            return links.resolved_symbol
        let member_name this.copy_name_to_page(raw)
        let symbol_flags Symbol.flags_of(decl_symbol)
        ; "Get or add a late-bound symbol for the member. This allows us to merge
        ; late-bound accessor declarations."
        var late_symbol: ref[Symbol]? SymbolTable.get(late_symbols, member_name)
        if late_symbol = null
        {
            set late_symbol: this.new_symbol_ex(SymbolFlagsNone, member_name, CheckFlagsLate)
            SymbolTable.set_entry(host, late_symbols, member_name, late_symbol as ref[Symbol])
        }
        var ls late_symbol as ref[Symbol]
        let early_symbol SymbolTable.get(early_symbols, member_name)
        if (Symbol.flags_of(ls) & Checker.get_excluded_symbol_flags(symbol_flags)) <> 0
        {
            ; "If we have an existing early-bound member, combine its declarations
            ; so that we can report an error at each declaration."
            var duplicate_name Checker.arg_text(member_name)
            if (ty.flags & TypeFlagsUniqueESSymbol) <> 0
                set duplicate_name: this.declaration_name_to_string(dn)
            if early_symbol <> null
                this.add_duplicate_declaration_errors_for_symbols(early_symbol as ref[Symbol], DiagDuplicate_identifier_0, duplicate_name, ls)
            this.add_duplicate_declaration_errors_for_symbols(ls, DiagDuplicate_identifier_0, duplicate_name, early_symbol)
            this.lookup_or_issue_error(dn, DiagDuplicate_identifier_0, duplicate_name)
            if (Symbol.flags_of(ls) & SymbolFlagsAccessor) <> 0
            {
                if (Symbol.flags_of(ls) & SymbolFlagsAccessor) <> (symbol_flags & SymbolFlagsAccessor)
                    Symbol.add_flags(ls, SymbolFlagsAccessor)
            }
            set ls: this.new_symbol_ex(SymbolFlagsNone, member_name, CheckFlagsLate)
        }
        set this.value_symbol_link_of(ls).name_type: ty
        this.add_declaration_to_late_bound_symbol(ls, decl, symbol_flags)
        if Symbol.has_parent(ls) = false
            Symbol.set_parent(ls, parent)
        set links.resolved_symbol: ls
        links.resolved_symbol
    }

    ; lateBindIndexSignature, whole. ★It does NOT write the member's
    ; `lateSymbol` link, and the reference's comment says why: the symbol here is
    ; the container's INDEX symbol, not a single property's.
    procedure late_bind_index_signature(this, parent: ref[Symbol], early_symbols: ref[SymbolTable]?, late_symbols: ref[SymbolTable], decl: ref[AstNode])
    {
        var id Slice[char]()
        set id: Binder.internal_name(host, "index")
        var index_symbol: ref[Symbol]? SymbolTable.get(late_symbols, id)
        if index_symbol = null
        {
            let early SymbolTable.get(early_symbols, id)
            if early = null
                set index_symbol: this.new_symbol_ex(SymbolFlagsNone, id, CheckFlagsLate)
            else
            {
                let cloned this.clone_symbol(early as ref[Symbol])
                Symbol.set_check_flags(cloned, Symbol.check_flags_of(cloned) | CheckFlagsLate)
                set index_symbol: cloned
            }
            SymbolTable.set_entry(host, late_symbols, id, index_symbol as ref[Symbol])
        }
        let isym index_symbol as ref[Symbol]
        ; ★★★ THE DISJUNCTION'S LEFT SIDE ASKS NOTHING OF THE DECLARATION'S SYMBOL,
        ; and reading the symbol FIRST is what a transcription wants to do — the
        ; reference writes `len(indexSymbol.Declarations) == 0 || decl.Symbol().Flags&…`.
        ; It cost this slice a measuring round: `AstNode.symbol_of` answers null for
        ; a type literal's PropertySignature here, so a guard in front of the
        ; disjunction returned before the FIRST declaration was ever appended, the
        ; index symbol stayed empty, and `{ [k]: string }` printed `{}` with nothing
        ; logged. **A `||` whose left side is cheap is also the side that must be
        ; asked first.**
        if Symbol.declaration_count(isym) = 0
        {
            Symbol.append_declaration(host, isym, decl)
            return
        }
        let ms AstNode.symbol_of(decl)
        if ms = null
        {
            ; The reference dereferences it (its own `debug.Assert` sits one function
            ; over), so a null here is its panic.
            this.record_unported("late-bind-index-no-symbol", AstNode.kind_of(decl))
            return
        }
        if (Symbol.flags_of(ms as ref[Symbol]) & SymbolFlagsReplaceableByMethod) = 0
            Symbol.append_declaration(host, isym, decl)
    }

    ; cloneSymbol, WHOLE since slice 137 — the recordMergedSymbol its old header
    ; deferred (*"the slice that ports mergeSymbol owes both"*) is the last line
    ; here now, and the table it writes exists.
    ;
    ; ★★ IT IS LOAD-BEARING FOR THE CLONE THE MERGE MAKES AND NOT FOR THE OTHER ONE.
    ; The pre-existing caller is lateBindIndexSignature, whose clone is a fresh index
    ; symbol nothing looks up through the merged map; merge_symbol's clone is the
    ; opposite — the ORIGINAL is still in whatever table the caller read it from, so
    ; without this row every later lookup of it would answer the symbol the merge
    ; abandoned.
    procedure clone_symbol(this, symbol: ref[Symbol]) returns ref[Symbol]
    {
        let result this.new_symbol(Symbol.flags_of(symbol), Symbol.name_of(symbol))
        ; ★★★ THE DECLARATION LIST IS COPIED ELEMENT BY ELEMENT AND **NOT** SHARED,
        ; AND THAT IS THE REFERENCE'S OWN LINE WITH ITS OWN COMMENT ON IT:
        ; `result.Declarations = symbol.Declarations[0:len(…):len(…)]` — *"Force
        ; reallocation if anything is ever appended to declarations"*. A Go slice
        ; whose capacity is clamped to its length reallocates on the first append;
        ; `copy_declarations_from` here ASSIGNS THE ARRAY, so an append to the clone
        ; would land in the ORIGINAL's list.
        ; ★★★ Nothing before this slice could see that, because the only caller was
        ; lateBindIndexSignature, which clones and never appends. merge_symbol appends
        ; on its very next lines, and the original is a symbol of the **LIB** — shared
        ; across every unit of a `--batch` process — so the shared array would have
        ; written the unit's own declarations into lib.es5.d.ts's symbols and left
        ; them there for the next unit.
        let dn Symbol.declaration_count(symbol)
        var di 0
        while di < dn
        {
            let d Symbol.declaration_at(symbol, di)
            if d <> null
                Symbol.append_declaration(host, result, d as ref[AstNode])
            set di: di + 1
        }
        ; ★★ The parent and the value declaration are the clone's other two lines, and
        ; they were missing while `copy_declarations_from` carried them by accident —
        ; it sets all three. merge_symbol reads the value declaration back immediately:
        ; its next act is `SetValueDeclaration(target, …)`, whose whole decision is
        ; *what does the target already have*.
        Symbol.set_parent(result, Symbol.parent_of(symbol))
        Symbol.set_value_declaration(result, Symbol.value_declaration_of(symbol))
        ; ★ The two tables are cloned ONLY where the original has one: a symbol with
        ; no members table and a symbol with an EMPTY one are different objects here
        ; (the symbols dump prints `-` for the first), and this file's own
        ; clone_symbol_table answers a fresh table for a nil argument.
        if Symbol.members_of(symbol) <> null
            Symbol.set_members(result, this.clone_symbol_table(Symbol.members_of(symbol)))
        if Symbol.exports_of(symbol) <> null
            Symbol.set_exports(result, this.clone_symbol_table(Symbol.exports_of(symbol)))
        this.record_merged_symbol(result, symbol)
        result
    }

    ; getMembersOfDeclaration — the four member-bearing kinds and the object
    ; literal's properties, and NOTHING else. ★It is not member_list_of: that one
    ; answers for an ENUM and a MAPPED type as well, neither of which the reference
    ; late-binds.
    function get_members_of_declaration(node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let k AstNode.kind_of(node)
        if k = KindInterfaceDeclaration
            return AstNode.member_list_of(node)
        if k = KindClassDeclaration
            return AstNode.member_list_of(node)
        if k = KindClassExpression
            return AstNode.member_list_of(node)
        if k = KindTypeLiteral
            return AstNode.member_list_of(node)
        if k = KindObjectLiteralExpression
            return AstNode.properties_of(node)
        null
    }

    ; getResolvedMembersOrExportsOfSymbol, whole.
    ;
    ; ★★ THE MODULE ARM CALLS THE WORKER AND NOT THE MEMO, which is the reference's
    ; own arrangement and is kept: getExportsOfModule memoizes, this does not, so a
    ; symbol that is both a module and a late-binding container resolves its export
    ; star twice. Routing it through the memo would be the safer-LOOKING change and
    ; would move the diagnostic ORDER of a shape the reference reports twice.
    procedure get_resolved_members_or_exports_of_symbol(this, symbol: ref[Symbol], is_static: bool) returns ref[SymbolTable]?
    {
        let links this.members_and_exports_link_of(symbol)
        if is_static
        {
            if links.resolved_exports <> null
                return links.resolved_exports
        }
        else
        {
            if links.resolved_members <> null
                return links.resolved_members
        }
        var early: ref[SymbolTable]? Symbol.members_of(symbol)
        if is_static
        {
            set early: Symbol.exports_of(symbol)
            if (Symbol.flags_of(symbol) & SymbolFlagsModule) <> 0
            {
                let throwaway &Array[ref[TypeOnlyExportStar]?]^host()
                set early: this.get_exports_of_module_worker(symbol, throwaway)
            }
        }
        ; The early table is installed BEFORE the late pass, because typing a
        ; computed name can ask for this very table (the reference does the same
        ; assignment for the same reason).
        if is_static
            set links.resolved_exports: early
        else
            set links.resolved_members: early
        var late: ref[SymbolTable]? null
        let dcount Symbol.declaration_count(symbol)
        var di 0
        while di < dcount
        {
            let d Symbol.declaration_at(symbol, di)
            set di: di + 1
            if d = null
                continue
            let list Checker.get_members_of_declaration(d as ref[AstNode])
            if list = null
                continue
            let members list as ref[Array[ref[AstNode]?]]
            let mcount members.get_length() as int
            var mi 0
            while mi < mcount
            {
                let m members[mi]
                set mi: mi + 1
                if m = null
                    continue
                let member m as ref[AstNode]
                if b.has_syntactic_modifier(member, ModifierFlagsStatic) <> is_static
                    continue
                if this.has_late_bindable_name(member)
                {
                    if late = null
                        set late: SymbolTable.create(host)
                    this.late_bind_member(symbol, early, late as ref[SymbolTable], member)
                }
                else
                {
                    if this.has_late_bindable_index_signature(member)
                    {
                        if late = null
                            set late: SymbolTable.create(host)
                        this.late_bind_index_signature(symbol, early, late as ref[SymbolTable], member)
                    }
                }
            }
        }
        if is_static
        {
            var ad Slice[char]()
            set ad: Binder.internal_name(host, "assignment")
            let assignment_symbol SymbolTable.get(Symbol.exports_of(symbol), ad)
            if assignment_symbol <> null
            {
                let asym assignment_symbol as ref[Symbol]
                let acount Symbol.declaration_count(asym)
                var ai 0
                while ai < acount
                {
                    let d Symbol.declaration_at(asym, ai)
                    set ai: ai + 1
                    if d = null
                        continue
                    if this.has_late_bindable_name(d as ref[AstNode])
                    {
                        if late = null
                            set late: SymbolTable.create(host)
                        this.late_bind_member(symbol, early, late as ref[SymbolTable], d as ref[AstNode])
                    }
                }
            }
        }
        let combined this.combine_symbol_tables(early, late)
        if is_static
        {
            set links.resolved_exports: combined
            return links.resolved_exports
        }
        set links.resolved_members: combined
        links.resolved_members
    }

    ; getMembersOfSymbol — the fork is REAL since slice 129.
    ;
    ; ★★★ THE STAND-IN THAT STOOD HERE ASKED THE RIGHT QUESTION AND HAD NO ANSWER,
    ; and its own header said so at length: *does any declaration of this container
    ; carry a computed name? then stop* — hasLateBindableName's first conjunct
    ; without the type test, conservative in the safe direction and a wall in front
    ; of 306 units. The late-binding table answers it (see its header above), so
    ; both halves of the fork now run.
    ;
    ; ★★ THE ONE MEASUREMENT THE STAND-IN LEAVES BEHIND IS WORTH KEEPING: for
    ; `interface I { [key]: string }` the interface symbol's members table has
    ; length ZERO, because the binder files a computed member under the internal
    ; name `computed` in a table this port could not reach FROM THE CONTAINER. That
    ; is exactly what getResolvedMembersOrExportsOfSymbol is for — it walks the
    ; DECLARATIONS, not the table — and it is why the marker that works for
    ; get_late_bound_symbol (which is handed the MEMBER's symbol) says nothing here.
    procedure get_members_of_symbol(this, symbol: ref[Symbol]) returns ref[SymbolTable]?
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsLateBindingContainer) = 0
            return Symbol.members_of(symbol)
        this.get_resolved_members_or_exports_of_symbol(symbol, false)
    }

    ; getExportsOfSymbol — the STATIC half of the fork, and it is REAL since slice
    ; 129 as well.
    ;
    ; ★★★ THE THREE ARMS ARE THE REFERENCE'S IN ITS OWN ORDER AGAIN. Slice 110's
    ; note explained why the MODULE question had to be asked FIRST — for a symbol
    ; that is both a late-binding container and a module (a class merged with a
    ; namespace) the early symbols come from getExportsOfModuleWorker rather than
    ; from `symbol.Exports`, so the fork this port could write would have answered
    ; the wrong table. getResolvedMembersOrExportsOfSymbol makes that choice
    ; internally, which is what lets the order go back to the reference's.
    ;
    ; ★★ THE ASSIGNMENT-DECLARATION ENTRY has no counterpart on the members side:
    ; the binder files a dynamically named `this.x = v` under `%FEassignment` in the
    ; container's EXPORTS, and every declaration hanging off it is late-bound. It is
    ; the static half's third loop, inside the resolver.
    procedure get_exports_of_symbol(this, symbol: ref[Symbol]) returns ref[SymbolTable]?
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsLateBindingContainer) <> 0
            return this.get_resolved_members_or_exports_of_symbol(symbol, true)
        if (Symbol.flags_of(symbol) & SymbolFlagsModule) <> 0
            return this.get_exports_of_module(symbol)
        Symbol.exports_of(symbol)
    }

    ; getSignaturesOfSymbol, whole.
    ;
    ; ★★ THE OVERLOAD SKIP IS THE WHOLE FUNCTION APART FROM THE CALL. A symbol with
    ; three declarations of one overloaded function contributes TWO signatures: the
    ; implementation is dropped, and it is recognised as the declaration that has a
    ; BODY, follows a declaration of the same kind under the same parent, and either
    ; starts exactly where that one ended or was REPARSED. The last disjunct is the
    ; JSDoc reparser's — a synthesized declaration has no source position to abut.
    procedure get_signatures_of_symbol(this, symbol: ref[Symbol]?) returns ref[Array[ref[Signature]?]]?
    {
        if symbol = null
            return null
        let sym symbol as ref[Symbol]
        let result this.new_signature_list()
        let n Symbol.declaration_count(sym)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(sym, i)
            if d = null
            {
                set i: i + 1
                continue
            }
            let decl d as ref[AstNode]
            if AstNode.is_function_like(decl) = false
            {
                set i: i + 1
                continue
            }
            var skip false
            if i > 0
            {
                if AstNode.body_of(decl) <> null
                {
                    let prev Symbol.declaration_at(sym, i - 1)
                    if prev <> null
                    {
                        let pn prev as ref[AstNode]
                        if AstNode.parent_node_of(decl) = AstNode.parent_node_of(pn)
                        {
                            if AstNode.kind_of(decl) = AstNode.kind_of(pn)
                            {
                                if AstNode.pos_of(decl) = AstNode.end_of(pn)
                                    set skip: true
                                if (AstNode.flags_of(pn) & NodeFlagsReparsed) <> 0
                                    set skip: true
                            }
                        }
                    }
                }
            }
            if skip
            {
                set i: i + 1
                continue
            }
            ; "If this is a function or method declaration, get the signature from
            ; the @type tag for the sake of optional parameters." The tag's own
            ; signature stands in for the declaration's whenever there is one.
            var sig this.get_signature_of_full_signature_type(decl)
            if sig = null
                set sig: this.get_signature_from_declaration(decl)
            if sig = null
                return null
            result.add(sig)
            set i: i + 1
        }
        result
    }

    ; isValidIndexKeyType, whole since slice 179.
    ;
    ; ★★★ ITS TWO ROWS STOOD ON A PRODUCER CLAIM THAT HAD STOPPED BEING TRUE — the
    ; note said *nothing in this port sets any of the three flags on a type*, and
    ; the template-literal and string-mapping minters plus is_pattern_literal_type
    ; itself all landed later. **A claim about what a port CANNOT MINT expires the
    ; slice that mints it, and nothing re-reads the readers.**
    procedure is_valid_index_key_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & (TypeFlagsString | TypeFlagsNumber | TypeFlagsESSymbol)) <> 0
            return true
        ; ★★★ BOTH ROWS WERE EXPIRED PREMISES OF THE SAME KIND, and the header above
        ; this function still spelled the first one out: *nothing in this port sets
        ; any of the three flags*. Template-literal and string-mapping types are
        ; minted here (new_template_literal_type, get_string_mapping_type) and
        ; is_pattern_literal_type has been whole since they arrived, so the second
        ; disjunct is a CALL; the intersection one needs is_generic_type and the
        ; constituent walk, both of which this file has.
        ;
        ; ★ The intersection disjunct is `Some`, not `Every` — one valid key type
        ; among the constituents is enough, which is what makes `string & {}` a
        ; legal index key.
        let mark this.unported_mark()
        if this.is_pattern_literal_type(t)
            return true
        if this.unported_mark() <> mark
            return false
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            if this.is_generic_type(t)
                return false
            if this.unported_mark() <> mark
                return false
            let parts Checker.union_or_intersection_types_of(t)
            if parts = null
                return false
            let list parts as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.is_valid_index_key_type(row as ref[Type])
                    return true
                if this.unported_mark() <> mark
                    return false
            }
        }
        false
    }

    ; getIndexInfosOfIndexSymbol, and the split is by DECLARATION KIND.
    ;
    ; ★★★ THE INDEX-SIGNATURE HALF IS THE WHOLE FUNCTION FOR A TYPESCRIPT FILE; the
    ; other half is `hasLateBindableIndexSignature`, i.e. `obj[expr] = v` or a
    ; computed member whose key type is a literal, and it needs
    ; checkExpressionCached / checkComputedPropertyName and then THREE
    ; isTypeAssignableTo calls to sort the key into the string, number or symbol
    ; bucket. That is the relation, and the whole late-bound tail behind it —
    ; getObjectLiteralIndexInfo, getUnionTypeEx — with it. The arm reports.
    ;
    ; ★★ `forEachType` OVER THE KEY IS ONE CALL HERE, not a loop: it distributes
    ; over a UNION and this port makes none, so the union case is a report exactly
    ; as check_type_for_duplicate_index_signatures' `Distributed()` is. ★The `never`
    ; case is NOT special here where it is there: forEachType visits a `never` type
    ; once like any other, and isValidIndexKeyType then rejects it.
    procedure get_index_infos_of_index_symbol(this, index_symbol: ref[Symbol], siblings: ref[SymbolTable]?) returns ref[Array[ref[IndexInfo]?]]?
    {
        let mark this.unported_mark()
        let infos this.new_index_info_list()
        var has_computed_string false
        var has_computed_number false
        var has_computed_symbol false
        var readonly_computed_string true
        var readonly_computed_number true
        var readonly_computed_symbol true
        let property_symbols &Array[ref[Symbol]?]^host()
        let n Symbol.declaration_count(index_symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(index_symbol, i)
            set i: i + 1
            if d = null
                continue
            let decl d as ref[AstNode]
            if AstNode.kind_of(decl) = KindIndexSignature
            {
                let params AstNode.parameters_of(decl)
                if params = null
                    continue
                let ps params as ref[Array[ref[AstNode]?]]
                if ps.get_length() <> 1
                    continue
                let p0 ps[0]
                if p0 = null
                    continue
                let type_node AstNode.type_of(p0 as ref[AstNode])
                if type_node = null
                    continue
                var value_type any_type
                let return_type_node AstNode.type_of(decl)
                if return_type_node <> null
                {
                    let vt this.get_type_from_type_node(return_type_node as ref[AstNode])
                    if vt = null
                        return null
                    set value_type: vt as ref[Type]
                }
                let kt this.get_type_from_type_node(type_node as ref[AstNode])
                if kt = null
                    return null
                let key_type kt as ref[Type]
                ; `forEachType(getTypeFromTypeNode(typeNode), …)` — a UNION key type
                ; contributes one index info per constituent, which is what
                ; `[key: string | number]: T` means (slice 170).
                ;
                ; ★★★ IT WAS A STOP UNTIL THE PRINTER STARTED ASKING. The union arm
                ; is reached from `lib.es5.d.ts` and nothing in this port had walked
                ; that far into an index symbol, so the row cost nothing — until
                ; slice 170 put `get_reduced_type` at the top of `type_to_string`,
                ; whose property walk resolves members and took SEVEN units out of
                ; MATCH at once. **A stop is priced by who asks, and a new caller
                ; re-prices every stop under it.**
                var keys: ref[Array[ref[Type]?]]? null
                if (key_type.flags & TypeFlagsUnion) <> 0
                    set keys: Checker.union_types_of(key_type)
                if keys = null
                {
                    set keys: this.new_type_list(null)
                    (keys as ref[Array[ref[Type]?]]).add(key_type)
                }
                let klist keys as ref[Array[ref[Type]?]]
                let kn klist.get_length() as int
                var ki 0
                while ki < kn
                {
                    let krow klist[ki]
                    set ki: ki + 1
                    if krow = null
                        continue
                    let k1 krow as ref[Type]
                    if this.is_valid_index_key_type(k1)
                    {
                        if Checker.find_index_info(infos, k1) = null
                        {
                            let readonly b.has_syntactic_modifier(decl, ModifierFlagsReadonly)
                            infos.add(this.new_index_info(k1, value_type, readonly, decl))
                        }
                    }
                }
                continue
            }
            ; ★★★ THE LATE-BINDABLE HALF, SLICE 129 — the branch the
            ; `has-late-bindable-index-signature` stop stood on. A member whose
            ; computed name types as `string`, `number` or a symbol is not a property
            ; at all: it IMPLIES an index signature, whose value type is the union of
            ; every sibling property that matches the key.
            if this.has_late_bindable_index_signature(decl) = false
                continue
            if this.unported_mark() <> mark
                return null
            var decl_name: ref[AstNode]? null
            if AstNode.kind_of(decl) = KindBinaryExpression
                set decl_name: AstNode.binary_left_of(decl)
            else
                set decl_name: AstNode.name_of(decl)
            if decl_name = null
                continue
            let dn decl_name as ref[AstNode]
            var kt2: ref[Type]? null
            if AstNode.kind_of(dn) = KindElementAccessExpression
            {
                let arg AstNode.element_access_argument_of(dn)
                if arg = null
                    continue
                set kt2: this.check_expression_cached(arg as ref[AstNode])
            }
            else
                set kt2: this.check_computed_property_name(dn)
            if kt2 = null
                return null
            let key_type kt2 as ref[Type]
            ; "Explicit index for key type takes priority."
            if Checker.find_index_info(infos, key_type) <> null
                continue
            if string_number_symbol_type = null
            {
                this.record_unported("string-number-symbol-type-unminted", key_type.flags)
                return null
            }
            if this.is_type_assignable_to(key_type, string_number_symbol_type as ref[Type]) = false
                continue
            if this.unported_mark() <> mark
                return null
            let readonly b.has_syntactic_modifier(decl, ModifierFlagsReadonly)
            if this.is_type_assignable_to(key_type, number_type)
            {
                set has_computed_number: true
                if readonly = false
                    set readonly_computed_number: false
            }
            else
            {
                if this.is_type_assignable_to(key_type, es_symbol_type)
                {
                    set has_computed_symbol: true
                    if readonly = false
                        set readonly_computed_symbol: false
                }
                else
                {
                    set has_computed_string: true
                    if readonly = false
                        set readonly_computed_string: false
                }
            }
            if this.unported_mark() <> mark
                return null
            let dsym AstNode.symbol_of(decl)
            if dsym <> null
                property_symbols.add(dsym)
        }
        var any_computed false
        if has_computed_string
            set any_computed: true
        if has_computed_number
            set any_computed: true
        if has_computed_symbol
            set any_computed: true
        if any_computed = false
            return infos
        ; The siblings come in as the TABLE they live in (see getIndexInfosOfSymbol's
        ; note); every one but the index symbol itself joins the property list.
        let sn SymbolTable.length(siblings)
        var si 0
        while si < sn
        {
            let sym SymbolTable.entry_symbol_at(siblings, si)
            set si: si + 1
            if sym = null
                continue
            if (sym as ref[Symbol]) = index_symbol
                continue
            property_symbols.add(sym)
        }
        ; "aggregate similar index infos implied to be the same key to the same
        ; combined index info"
        if has_computed_string
        {
            if Checker.find_index_info(infos, string_type) = null
            {
                let info this.get_object_literal_index_info(readonly_computed_string, property_symbols, string_type)
                if info = null
                    return null
                infos.add(info)
            }
        }
        if has_computed_number
        {
            if Checker.find_index_info(infos, number_type) = null
            {
                let info this.get_object_literal_index_info(readonly_computed_number, property_symbols, number_type)
                if info = null
                    return null
                infos.add(info)
            }
        }
        if has_computed_symbol
        {
            if Checker.find_index_info(infos, es_symbol_type) = null
            {
                let info this.get_object_literal_index_info(readonly_computed_symbol, property_symbols, es_symbol_type)
                if info = null
                    return null
                infos.add(info)
            }
        }
        infos
    }

    ; getIndexInfosOfSymbol, whole.
    ;
    ; ★ The reference hands the SIBLING SYMBOLS to the call below and this port
    ; hands the TABLE they come out of. The list is read only by the late-bound
    ; half, which reports — so passing the table costs nothing and saves building a
    ; list nothing reads (§3.5be's rule about a slot with no reader, applied to an
    ; argument).
    procedure get_index_infos_of_symbol(this, symbol: ref[Symbol]) returns ref[Array[ref[IndexInfo]?]]?
    {
        let index_symbol this.get_index_symbol(symbol)
        if index_symbol = null
            return null
        let members this.get_members_of_symbol(symbol)
        this.get_index_infos_of_index_symbol(index_symbol as ref[Symbol], members)
    }

    ; ── resolveStructuredTypeMembers and what is behind it ───────────────────

    ; setStructuredTypeMembers, whole.
    ;
    ; ★ The reference's `slices.Clip` calls are about a Go slice sharing a backing
    ; array with the list it was cut from; an Array here is a value the caller
    ; owns, so there is nothing to clip.
    procedure set_structured_type_members(this, t: ref[Type], members: ref[SymbolTable]?, call_signatures: ref[Array[ref[Signature]?]]?, construct_signatures: ref[Array[ref[Signature]?]]?, index_infos: ref[Array[ref[IndexInfo]?]]?)
    {
        set t.object_flags: t.object_flags | ObjectFlagsMembersResolved
        if Checker.structured_members_of(t) = null
        {
            let made &StructuredMembers^host()
            Checker.attach_structured_members(t, made)
        }
        let sm Checker.structured_members_of(t) as ref[StructuredMembers]
        set sm.members: members
        set sm.properties: this.get_named_members(members, t.symbol)
        var call_count 0
        if call_signatures <> null
            set call_count: (call_signatures as ref[Array[ref[Signature]?]]).get_length() as int
        var construct_count 0
        if construct_signatures <> null
            set construct_count: (construct_signatures as ref[Array[ref[Signature]?]]).get_length() as int
        set sm.call_signatures_memo: null
        set sm.construct_signatures_memo: null
        if (call_count + construct_count) = 0
        {
            set sm.signatures: null
            set sm.call_signature_count: 0
        }
        if (call_count + construct_count) <> 0
        {
            let all this.new_signature_list()
            Checker.append_signatures(all, call_signatures)
            Checker.append_signatures(all, construct_signatures)
            set sm.signatures: all
            set sm.call_signature_count: call_count
        }
        set sm.index_infos: index_infos
        this.log_members(t, sm, call_count, construct_count)
    }

    ; The member log's one writer. It reads only slots that are already computed —
    ; no accessor here can resolve anything — which is what keeps the log from
    ; changing the walk it is watching.
    procedure log_members(this, t: ref[Type], sm: ref[StructuredMembers], call_count: int, construct_count: int)
    {
        if record_events = false
            return
        var prop_count 0
        if sm.properties <> null
            set prop_count: (sm.properties as ref[Array[ref[Symbol]?]]).get_length() as int
        var index_count 0
        if sm.index_infos <> null
            set index_count: (sm.index_infos as ref[Array[ref[IndexInfo]?]]).get_length() as int
        let head &MemberEvent^host(0, t.object_flags, prop_count, call_count + construct_count, index_count, Slice[char]())
        member_log.add(head as ref[MemberEvent])
        if sm.properties = null
            return
        let list sm.properties as ref[Array[ref[Symbol]?]]
        var i 0
        while i < prop_count
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let p row as ref[Symbol]
            let ev &MemberEvent^host(1, Symbol.flags_of(p), Symbol.check_flags_of(p), Symbol.declaration_count(p), 0, Symbol.name_of(p))
            member_log.add(ev as ref[MemberEvent])
        }
        this.log_signatures(sm)
    }

    ; The signature half of the member log, slice 87. Four columns per signature —
    ; flags, type parameters, parameters, minimum argument count — in the order
    ; set_structured_type_members appends them, so the call signatures come first
    ; and the header's own count says where the construct ones begin.
    ;
    ; ★ The RETURN type is deliberately not a column. It is a Type, and printing
    ; one means type_to_string, which reports for most kinds — a pin that stops is
    ; a pin that measures the printer. What the four ints already separate is every
    ; distinction this slice makes: `class C {}` answers Construct/0/0/0,
    ; `abstract class C {}` Construct|Abstract, `class C<T> {}` one type parameter,
    ; and a DECLARED constructor carries its own parameters.
    procedure log_signatures(this, sm: ref[StructuredMembers])
    {
        if record_events = false
            return
        if sm.signatures = null
            return
        let sigs sm.signatures as ref[Array[ref[Signature]?]]
        let n sigs.get_length() as int
        var i 0
        while i < n
        {
            let row sigs[i]
            set i: i + 1
            if row = null
                continue
            let sig row as ref[Signature]
            var tpn 0
            if sig.type_parameters <> null
                set tpn: (sig.type_parameters as ref[Array[ref[Type]?]]).get_length() as int
            var pn 0
            if sig.parameters <> null
                set pn: (sig.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
            let ev &MemberEvent^host(2, sig.flags, tpn, pn, sig.min_argument_count, Slice[char]())
            member_log.add(ev as ref[MemberEvent])
        }
    }

    procedure append_signatures(dest: ref[Array[ref[Signature]?]], src: ref[Array[ref[Signature]?]]?)
    {
        if src = null
            return
        let list src as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            dest.add(list[i])
            set i: i + 1
        }
    }

    procedure append_index_infos(dest: ref[Array[ref[IndexInfo]?]], src: ref[Array[ref[IndexInfo]?]]?)
    {
        if src = null
            return
        let list src as ref[Array[ref[IndexInfo]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            dest.add(list[i])
            set i: i + 1
        }
    }

    ; addInheritedMembers, whole. It answers the table it was handed — the
    ; reference's `symbols` is an in-out parameter and its `if symbols == nil`
    ; allocation is what the return is for.
    procedure add_inherited_members(this, symbols: ref[SymbolTable]?, base_symbols: ref[Array[ref[Symbol]?]]?) returns ref[SymbolTable]?
    {
        if base_symbols = null
            return symbols
        let list base_symbols as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        var table symbols
        ; room for every base member at once (slice 351): the table grows once
        ; instead of doubling past its size, an overridden member costs a slot
        if table <> null
            SymbolTable.reserve(table as ref[SymbolTable], SymbolTable.length(table) + n)
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let base row as ref[Symbol]
            if this.is_static_private_identifier_property(base)
                continue
            var take true
            if table <> null
            {
                let existing SymbolTable.get(table, Symbol.name_of(base))
                if existing <> null
                {
                    if (Symbol.flags_of(existing as ref[Symbol]) & SymbolFlagsValue) <> 0
                        set take: false
                }
            }
            if take
            {
                if table = null
                    set table: SymbolTable.create_sized(host, n)
                SymbolTable.set_entry(host, table as ref[SymbolTable], Symbol.name_of(base), base)
            }
        }
        table
    }

    ; isStaticPrivateIdentifierProperty.
    function is_static_private_identifier_property(this, s: ref[Symbol]) returns bool
    {
        let vd Symbol.value_declaration_of(s)
        if vd = null
            return false
        let d vd as ref[AstNode]
        if AstNode.is_private_identifier_class_element_declaration(d) = false
            return false
        b.is_static(d)
    }

    ; resolveDeclaredMembers, whole.
    ;
    ; ★★★ THE ORDER IS THE REFERENCE'S AND IT IS LOAD-BEARING: the members table is
    ; read, the record is ATTACHED, and only then are the three lists computed.
    ; Upstream writes `declaredMembersResolved = true` between the first and the
    ; second for the same reason get_declared_type_of_class_or_interface stores the
    ; type before resolving its parameters — a signature whose annotation names the
    ; type it belongs to closes on the half-built record instead of running forever.
    procedure resolve_declared_members(this, t: ref[Type]) returns ref[DeclaredMembers]?
    {
        let existing Checker.declared_members_of(t)
        if existing <> null
            return existing
        let members this.get_members_of_symbol(t.symbol as ref[Symbol])
        let made &DeclaredMembers^host()
        set made.members: members
        Checker.attach_declared_members(t, made)
        var cd Slice[char]()
        set cd: Binder.internal_name(host, "call")
        var nd Slice[char]()
        set nd: Binder.internal_name(host, "new")
        var call_symbol: ref[Symbol]? null
        var new_symbol: ref[Symbol]? null
        if members <> null
        {
            set call_symbol: SymbolTable.get(members, cd)
            set new_symbol: SymbolTable.get(members, nd)
        }
        let mark this.unported_mark()
        set made.call_signatures: this.get_signatures_of_symbol(call_symbol)
        if this.unported_mark() <> mark
            return null
        set made.construct_signatures: this.get_signatures_of_symbol(new_symbol)
        if this.unported_mark() <> mark
            return null
        set made.index_infos: this.get_index_infos_of_symbol(t.symbol as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        made
    }

    ; resolveObjectTypeMembers, whole since slice 86.
    ;
    ; ★★★ THE `slices.Equal(typeParameters, typeArguments)` TEST SPLITS THE TWO
    ; CALLERS AND NOT THE CORPUS, which is slice 85's sentence with the branch it
    ; described now written. resolveClassOrInterfaceMembers passes nil for both
    ; lists, so the test is TRUE and the declared members are taken as they are;
    ; resolveTypeReferenceMembers passes `allTypeParameters` (ending in the
    ; thisType) against `typeArguments + [t]`, which can never be equal because a
    ; type is not its own `this` type — so the instantiating branch runs for every
    ; class and for every generic or this-using interface, and for nothing else.
    ;
    ; ★★ THE BASE LOOP'S `getTypeWithThisArgument` ARM IS WRITTEN NOW, and slice
    ; 85's note said what it was waiting for: `thisArgument` is
    ; `LastOrNil(typeArguments)`, nil under the class-or-interface caller and the
    ; type itself under the reference one. It is UNREACHED on this corpus for a
    ; reason the battery measures rather than this note asserting it — both
    ; resolveBaseTypesOfClass and resolveBaseTypesOfInterface answer an empty list
    ; for every type that gets here.
    procedure resolve_object_type_members(this, t: ref[Type], source: ref[Type], type_parameters: ref[Array[ref[Type]?]]?, type_arguments: ref[Array[ref[Type]?]]?)
    {
        let mark this.unported_mark()
        let resolved this.resolve_declared_members(source)
        if resolved = null
            return
        let d resolved as ref[DeclaredMembers]
        var members d.members
        var call_signatures d.call_signatures
        var construct_signatures d.construct_signatures
        var index_infos d.index_infos
        var instantiated false
        var mapper: ref[TypeMapper]? null
        if Checker.type_lists_equal(type_parameters, type_arguments) = false
        {
            set instantiated: true
            let m this.new_type_mapper(type_parameters, type_arguments)
            set mapper: m
            set members: this.instantiate_symbol_table(d.members, m)
            if this.unported_mark() <> mark
                return
            set call_signatures: this.instantiate_signatures(d.call_signatures, m)
            if this.unported_mark() <> mark
                return
            set construct_signatures: this.instantiate_signatures(d.construct_signatures, m)
            if this.unported_mark() <> mark
                return
            set index_infos: this.instantiate_index_infos(d.index_infos, m)
            if this.unported_mark() <> mark
                return
        }
        let base_types this.get_base_types(source)
        if this.unported_mark() <> mark
            return
        var base_count 0
        if base_types <> null
            set base_count: (base_types as ref[Array[ref[Type]?]]).get_length() as int
        if base_count <> 0
        {
            if instantiated = false
                set members: this.clone_symbol_table(members)
            this.set_structured_type_members(t, members, call_signatures, construct_signatures, index_infos)
            ; core.LastOrNil(typeArguments), the argument every base type is
            ; re-anchored on.
            var this_argument: ref[Type]? null
            if type_arguments <> null
            {
                let args type_arguments as ref[Array[ref[Type]?]]
                let an args.get_length() as int
                if an <> 0
                    set this_argument: args[an - 1]
            }
            set t.object_flags: t.object_flags | ObjectFlagsUnresolvedMembers
            let bases base_types as ref[Array[ref[Type]?]]
            var i 0
            while i < base_count
            {
                let row bases[i]
                set i: i + 1
                if row = null
                    continue
                var base row as ref[Type]
                if this_argument <> null
                {
                    let inst this.instantiate_type(row, mapper)
                    if this.unported_mark() <> mark
                        return
                    if inst = null
                        return
                    let with_this this.get_type_with_this_argument(inst as ref[Type], this_argument, false)
                    if this.unported_mark() <> mark
                        return
                    if with_this = null
                        return
                    set base: with_this as ref[Type]
                }
                ; ★★★ THE STOP THAT STOOD HERE SAID THE `{ [k: string]: any }`
                ; SINGLETON WAS *"one of the fifteen empty/marker objects this
                ; port does not make yet"*, AND IT HAS BEEN MINTED SINCE THE
                ; INTRINSICS CARRIED `any_base_type_index_info` — the identity
                ; comparison the note was protecting is exactly what the field
                ; buys, and its two readers are already here. §3.5hd.
                var inherited_any false
                if base = any_type
                    set inherited_any: true
                let props this.get_properties_of_type(base)
                if this.unported_mark() <> mark
                    return
                set members: this.add_inherited_members(members, props)
                let base_calls this.get_signatures_of_type(base, SignatureKindCall)
                if this.unported_mark() <> mark
                    return
                let base_constructs this.get_signatures_of_type(base, SignatureKindConstruct)
                if this.unported_mark() <> mark
                    return
                let merged_calls this.new_signature_list()
                Checker.append_signatures(merged_calls, call_signatures)
                Checker.append_signatures(merged_calls, base_calls)
                set call_signatures: merged_calls
                let merged_constructs this.new_signature_list()
                Checker.append_signatures(merged_constructs, construct_signatures)
                Checker.append_signatures(merged_constructs, base_constructs)
                set construct_signatures: merged_constructs
                var inherited: ref[Array[ref[IndexInfo]?]]? null
                if inherited_any
                {
                    let one this.new_index_info_list()
                    if any_base_type_index_info <> null
                        one.add(any_base_type_index_info)
                    set inherited: one
                }
                else
                {
                    set inherited: this.get_index_infos_of_type(base)
                    if this.unported_mark() <> mark
                        return
                }
                let merged_infos this.new_index_info_list()
                Checker.append_index_infos(merged_infos, index_infos)
                if inherited <> null
                {
                    let il inherited as ref[Array[ref[IndexInfo]?]]
                    let n il.get_length() as int
                    var j 0
                    while j < n
                    {
                        let info il[j]
                        set j: j + 1
                        if info = null
                            continue
                        if Checker.find_index_info(merged_infos, (info as ref[IndexInfo]).key_type) = null
                            merged_infos.add(info)
                    }
                }
                set index_infos: merged_infos
            }
            set t.object_flags: (t.object_flags & ~ObjectFlagsUnresolvedMembers) as u32
        }
        this.set_structured_type_members(t, members, call_signatures, construct_signatures, index_infos)
    }

    ; ── the instantiation chapter (slice 86) ─────────────────────────────────
    ;
    ; resolveTypeReferenceMembers and everything under it: the TypeMapper, the four
    ; instantiate* list walks, instantiateType and the predicate that gates it. It
    ; is the reader slice 85's closing paragraph named — *"the INSTANTIATION chapter
    ; (TypeMapper, instantiateSymbolTable, couldContainTypeVariables)"* — and the
    ; work list's head, 212 units of 1 409 at stage 1 taken FIRST and 274 reached.
    ;
    ; ★★★ EVERY CLASS IS A TYPE REFERENCE AND NO CLASS IS GENERIC ENOUGH TO NEED
    ; THIS, WHICH IS THE WHOLE SHAPE OF THE SLICE. get_declared_type_of_class_or_
    ; interface gives every class a `this` type, so allTypeParameters ends in the
    ; thisType while the padded arguments end in the type itself — never equal, so
    ; the instantiating branch is taken for EVERY class, generic or not, and the
    ; mapper is `{thisType -> t}` and nothing else. `MapsThisOnly` is true of
    ; exactly that mapper, and instantiateSymbol's first test pairs it with
    ; `isThisless`, which is PURE SYNTAX — a property whose annotation is a keyword,
    ; a method whose parameters and return annotation are. So the ordinary member
    ; comes back as ITSELF and the transient symbol this port cannot make is never
    ; asked for.
    ;
    ; ★★★ WHICH IS WHY THE MINTING BRANCH IS A STOP AND NOT A WALL. A transient
    ; symbol needs CheckFlags, which get_type_of_symbol's header calls
    ; *"not merely unreached, UNREPRESENTABLE"*; that the chapter runs at all
    ; without one is a fact about `isThisless`, and the control battery measures it
    ; rather than the header asserting it.


    ; isThislessType. The keyword list is the reference's own and it is a LIST
    ; rather than a range test: KindLiteralType sits nowhere near the keywords, and
    ; the eleven that are named are named because upstream names them — `KindNull
    ; Keyword` and `KindStringLiteral` are NOT among them, which is a claim about
    ; the reference rather than an omission.
    function is_thisless_type(node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindAnyKeyword
            return true
        if k = KindUnknownKeyword
            return true
        if k = KindStringKeyword
            return true
        if k = KindNumberKeyword
            return true
        if k = KindBigIntKeyword
            return true
        if k = KindBooleanKeyword
            return true
        if k = KindSymbolKeyword
            return true
        if k = KindObjectKeyword
            return true
        if k = KindVoidKeyword
            return true
        if k = KindUndefinedKeyword
            return true
        if k = KindNeverKeyword
            return true
        if k = KindLiteralType
            return true
        if k = KindArrayType
        {
            let inner AstNode.array_element_type_of(node)
            if inner = null
                return false
            return Checker.is_thisless_type(inner as ref[AstNode])
        }
        if k = KindTypeReference
        {
            ; core.Every over the type ARGUMENTS — and the reference does not look
            ; at the type's NAME at all, so `Foo` with no arguments is thisless
            ; whatever Foo turns out to be. That is upstream's own conservatism
            ; running in the cheap direction, and it is the reason this predicate
            ; needs no type resolution.
            let args AstNode.type_arguments_of(node)
            let n AstNode.list_count(args)
            var i 0
            while i < n
            {
                let a AstNode.child_in_list(args, i)
                if a = null
                    return false
                if Checker.is_thisless_type(a as ref[AstNode]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        false
    }

    ; isThislessVariableLikeDeclaration.
    function is_thisless_variable_like_declaration(node: ref[AstNode]) returns bool
    {
        let type_node AstNode.type_of(node)
        if type_node <> null
            return Checker.is_thisless_type(type_node as ref[AstNode])
        AstNode.initializer_of(node) = null
    }

    ; isThislessTypeParameter.
    function is_thisless_type_parameter(node: ref[AstNode]) returns bool
    {
        let constraint AstNode.type_parameter_constraint_of(node)
        if constraint = null
            return true
        Checker.is_thisless_type(constraint as ref[AstNode])
    }

    ; isThislessFunctionLikeDeclaration. A CONSTRUCTOR needs no return annotation —
    ; it has none to write — and that disjunct is what makes an ordinary
    ; `constructor(x: number)` thisless.
    function is_thisless_function_like_declaration(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindConstructor
        {
            let return_type AstNode.type_of(node)
            if return_type = null
                return false
            if Checker.is_thisless_type(return_type as ref[AstNode]) = false
                return false
        }
        let params AstNode.parameters_of(node)
        let pn AstNode.list_count(params)
        var i 0
        while i < pn
        {
            let p AstNode.child_in_list(params, i)
            if p = null
                return false
            if Checker.is_thisless_variable_like_declaration(p as ref[AstNode]) = false
                return false
            set i: i + 1
        }
        let tps AstNode.type_parameters_of(node)
        let tn AstNode.list_count(tps)
        var j 0
        while j < tn
        {
            let tp AstNode.child_in_list(tps, j)
            if tp = null
                return false
            if Checker.is_thisless_type_parameter(tp as ref[AstNode]) = false
                return false
            set j: j + 1
        }
        true
    }

    ; isThisless. A MERGED symbol — two declarations — is never thisless, which is
    ; the reference's `len(symbol.Declarations) == 1` and is conservative in the
    ; direction that costs an instantiation rather than a wrong table.
    function is_thisless(symbol: ref[Symbol]) returns bool
    {
        if Symbol.declaration_count(symbol) <> 1
            return false
        let d Symbol.declaration_at(symbol, 0)
        if d = null
            return false
        let node d as ref[AstNode]
        let k AstNode.kind_of(node)
        if k = KindParameter
            return Checker.is_thisless_variable_like_declaration(node)
        if k = KindPropertyDeclaration
            return Checker.is_thisless_variable_like_declaration(node)
        if k = KindPropertySignature
            return Checker.is_thisless_variable_like_declaration(node)
        if k = KindMethodDeclaration
            return Checker.is_thisless_function_like_declaration(node)
        if k = KindMethodSignature
            return Checker.is_thisless_function_like_declaration(node)
        if k = KindConstructor
            return Checker.is_thisless_function_like_declaration(node)
        if k = KindGetAccessor
            return Checker.is_thisless_function_like_declaration(node)
        if k = KindSetAccessor
            return Checker.is_thisless_function_like_declaration(node)
        false
    }

    ; newTypeMapper. The one-entry case picks the simple arm exactly as upstream,
    ; and it is not a micro-optimisation there either: SimpleTypeMapper is the arm
    ; whose MapsThisOnly asks its single source, and the array arm's own MapsThisOnly
    ; answers the same question by first checking that it holds exactly one.
    procedure new_type_mapper(this, sources: ref[Array[ref[Type]?]]?, targets: ref[Array[ref[Type]?]]?) returns ref[TypeMapper]
    {
        let p host.allocate(sizeof TypeMapper, alignof TypeMapper) as pointer[TypeMapper]
        var n 0
        if sources <> null
            set n: (sources as ref[Array[ref[Type]?]]).get_length() as int
        if n = 1
        {
            let src sources as ref[Array[ref[Type]?]]
            var tg: ref[Type]? null
            if targets <> null
            {
                let tl targets as ref[Array[ref[Type]?]]
                if (tl.get_length() as int) > 0
                    set tg: tl[0]
            }
            set *p: TypeMapper(TypeMapperData.Simple(SimpleTypeMapperData(src[0], tg)))
            return p
        }
        set *p: TypeMapper(TypeMapperData.Array(ArrayTypeMapperData(sources, targets)))
        p
    }

    ; TypeMapper.Map.
    ;
    ; ★★★ IT IS A METHOD SINCE SLICE 122, AND THE REASON IS THE INFERENCE ARM: its
    ; Map calls get_inferred_type and infer_from_intra_expression_sites, both of
    ; which need the Checker. Upstream every mapper implementation that needs one
    ; carries a `c *Checker` field; here the receiver is the same thing spelled once
    ; instead of per arm. ★The Merged arm makes it recursive, which a static
    ; function could have done and a method does the same way.
    procedure type_mapper_map(this, m: ref[TypeMapper], t: ref[Type]?) returns ref[Type]?
    {
        choose m.data
            when s: Simple
            {
                if s.source = t
                    return s.target
                return t
            }
            when a: Array
            {
                if a.sources = null
                    return t
                let src a.sources as ref[Array[ref[Type]?]]
                let n src.get_length() as int
                var i 0
                while i < n
                {
                    if src[i] = t
                    {
                        if a.targets = null
                            return t
                        let tgt a.targets as ref[Array[ref[Type]?]]
                        if i < (tgt.get_length() as int)
                            return tgt[i]
                        return t
                    }
                    set i: i + 1
                }
                return t
            }
            when ats: ArrayToSingle
            {
                if ats.sources = null
                    return t
                let src ats.sources as ref[Array[ref[Type]?]]
                let n src.get_length() as int
                var i 0
                while i < n
                {
                    if src[i] = t
                        return ats.target
                    set i: i + 1
                }
                return t
            }
            when df: Deferred
            {
                if df.sources = null
                    return t
                if df.node = null
                    return t
                let src df.sources as ref[Array[ref[Type]?]]
                let n src.get_length() as int
                var i 0
                while i < n
                {
                    if src[i] = t
                        return this.get_effective_type_argument_at_index(df.node as ref[AstNode], src, i)
                    set i: i + 1
                }
                return t
            }
            when mg: Merged
            {
                if mg.m1 = null
                    return t
                if mg.m2 = null
                    return t
                let mark this.unported_mark()
                let first this.type_mapper_map(mg.m1 as ref[TypeMapper], t)
                if this.unported_mark() <> mark
                    return null
                return this.type_mapper_map(mg.m2 as ref[TypeMapper], first)
            }
            when cp: Composite
            {
                ; CompositeTypeMapper.Map. ★The recursion is INSTANTIATION and not
                ; mapping — see the record's header — so this arm is the only one
                ; that can answer a type m2 never saw.
                if cp.m1 = null
                    return t
                if cp.m2 = null
                    return t
                let mark this.unported_mark()
                let t1 this.type_mapper_map(cp.m1 as ref[TypeMapper], t)
                if this.unported_mark() <> mark
                    return null
                if t1 <> t
                    return this.instantiate_type(t1, cp.m2)
                return this.type_mapper_map(cp.m2 as ref[TypeMapper], t)
            }
            when inf: Inference
            {
                if inf.context = null
                    return t
                if t = null
                    return t
                let ctx inf.context as ref[InferenceContext]
                let list ctx.inferences
                let n list.get_length() as int
                var i 0
                while i < n
                {
                    let e list[i]
                    if e <> null
                    {
                        let info e as ref[InferenceInfo]
                        if info.type_parameter = t
                        {
                            if inf.fixing
                            {
                                if info.is_fixed = false
                                {
                                    ; Committing to an inference locks out every
                                    ; later one, so the intra-expression sites are
                                    ; drained FIRST — the reference's own order, and
                                    ; the whole reason the two mappers differ.
                                    let mark this.unported_mark()
                                    this.infer_from_intra_expression_sites(ctx)
                                    if this.unported_mark() <> mark
                                        return null
                                    Checker.clear_cached_inferences(list)
                                    set info.is_fixed: true
                                }
                            }
                            return this.get_inferred_type(ctx, i)
                        }
                    }
                    set i: i + 1
                }
                return t
            }
            when fn: Function
            {
                ; restrictiveMapperWorker / permissiveMapperWorker, slice 151 — the
                ; two `FunctionTypeMapper`s this port mints, one test apart.
                ; ★Neither reports: a type that is not a type parameter is the
                ; identity on both, and the restrictive branch's own answer is a
                ; memo lookup or a fresh type parameter.
                if t = null
                    return t
                let tt t as ref[Type]
                if (tt.flags & TypeFlagsTypeParameter) = 0
                    return t
                if fn.worker = FunctionMapperRestrictive
                    return this.get_restrictive_type_parameter(tt)
                ; getUniqueLiteralTypeForTypeParameter (slice 166) — the marker a
                ; union reduction can see through. ★It is the `never` intrinsic
                ; under another name, and getReducedType treats it as a LITERAL,
                ; which is the whole trick: only intersections with conflicting
                ; literal-typed properties reduce, so filling every type parameter
                ; with one asks *would this intersection reduce under SOME
                ; instantiation*.
                if fn.worker = FunctionMapperUniqueLiteral
                    return unique_literal_type
                return wildcard_type
            }
            when rel: Reliability
            {
                ; reportUnreliableWorker / reportUnmeasurableWorker, which are one
                ; body in the reference too — the identity, plus the bit, plus the
                ; three-way test that decides whether the bit is set at all.
                if t <> null
                {
                    let tt t as ref[Type]
                    var is_marker false
                    if marker_super_type <> null
                    {
                        if tt = marker_super_type as ref[Type]
                            set is_marker: true
                    }
                    if marker_sub_type <> null
                    {
                        if tt = marker_sub_type as ref[Type]
                            set is_marker: true
                    }
                    if marker_other_type <> null
                    {
                        if tt = marker_other_type as ref[Type]
                            set is_marker: true
                    }
                    if is_marker
                    {
                        if rel.unmeasurable
                            set this.reliability_flags: reliability_flags | RelationComparisonResultReportsUnmeasurable
                        if rel.unmeasurable = false
                            set this.reliability_flags: reliability_flags | RelationComparisonResultReportsUnreliable
                    }
                }
                return t
            }
        t
    }

    ; TypeMapper.MapsThisOnly.
    function type_mapper_maps_this_only(m: ref[TypeMapper]) returns bool
    {
        choose m.data
            when s: Simple
            {
                if s.source = null
                    return false
                return Checker.is_this_type_parameter(s.source as ref[Type])
            }
            when a: Array
            {
                if a.sources = null
                    return false
                let src a.sources as ref[Array[ref[Type]?]]
                if (src.get_length() as int) <> 1
                    return false
                let s0 src[0]
                if s0 = null
                    return false
                return Checker.is_this_type_parameter(s0 as ref[Type])
            }
            when ats: ArrayToSingle
            {
                ; Upstream's ArrayToSingleTypeMapper answers the ARRAY arm's
                ; question, not the base's — so it is written rather than left to
                ; the tail. Merged and Inference DO take the base's `false`.
                if ats.sources = null
                    return false
                let src ats.sources as ref[Array[ref[Type]?]]
                if (src.get_length() as int) <> 1
                    return false
                let s0 src[0]
                if s0 = null
                    return false
                return Checker.is_this_type_parameter(s0 as ref[Type])
            }
        false
    }

    ; isNonGenericTopLevelType, WRITTEN OUT SINCE SLICE 139.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE NAMED ITS OWN EXPIRY CONDITION — *the day the
    ; alias slot arrives, one body changes and no caller does* — AND THE SLOT
    ; ARRIVED IN SLICE 111, WHICH MADE THE CONSTANT `false` A STACK OVERFLOW. It is
    ; the RECURSION GUARD of could_contain_type_variables, on both its arms: a
    ; top-level non-generic type ALIAS is where the walk must stop, and a RECURSIVE
    ; alias is exactly where it otherwise cannot. `type Expression =
    ; BooleanLogicExpression | 'true' | 'false'` with `type BooleanLogicExpression =
    ; ['and', ...Expression[]] | ['not', Expression]` recursed until the stack ran
    ; out — SIGSEGV, all six artifacts of one unit at once, which reads as a harness
    ; failure and not as a checker one. It only became reachable when this slice
    ; removed the walls in front of it (§3.5fq: a wall hides wrong answers).
    ;
    ; ★ The ancestor walk is the reference's `FindAncestorOrQuit`: a SourceFile is
    ; the match, a ModuleDeclaration keeps walking, and ANY other parent quits — so
    ; an alias inside a namespace body is not top-level, because its parent is the
    ; ModuleBlock and that is the quit case.
    function is_non_generic_top_level_type(t: ref[Type]) returns bool
    {
        if t.alias_symbol = null
            return false
        if t.alias_type_arguments <> null
        {
            if ((t.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                return false
        }
        var declaration Checker.get_declaration_of_kind(t.alias_symbol as ref[Symbol], KindTypeAliasDeclaration)
        if declaration = null
            set declaration: Checker.get_declaration_of_kind(t.alias_symbol as ref[Symbol], KindJSTypeAliasDeclaration)
        if declaration = null
            return false
        var up AstNode.parent_node_of(declaration as ref[AstNode])
        while up <> null
        {
            let node up as ref[AstNode]
            let k AstNode.kind_of(node)
            if k = KindSourceFile
                return true
            if k <> KindModuleDeclaration
                return false
            set up: AstNode.parent_node_of(node)
        }
        false
    }

    ; couldContainTypeVariablesWorker, whole, memo included.
    ;
    ; ★★★ IT IS THE GATE IN FRONT OF EVERY instantiateType AND ITS ANSWER IS `false`
    ; FOR ALMOST EVERYTHING THIS CHAPTER TOUCHES — a `number` annotation, a
    ; non-generic class's own declared type (whose type arguments are the EMPTY
    ; list), an index signature's value type. That is what keeps instantiate_type's
    ; unported arms unreached rather than merely unwritten, and g-rows of the
    ; battery measure it.
    ;
    ; ★ It REPORTS, because getTypeArguments does — so its callers check the mark,
    ; the idiom is_thisless_interface' callers already use. The memo is written
    ; only on a complete answer: a half-computed `false` cached under
    ; CouldContainTypeVariablesComputed would outlive the stop that produced it.
    procedure could_contain_type_variables(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsStructuredOrInstantiable) = 0
            return false
        if (t.object_flags & ObjectFlagsCouldContainTypeVariablesComputed) <> 0
            return (t.object_flags & ObjectFlagsCouldContainTypeVariables) <> 0
        var result false
        if (t.flags & TypeFlagsInstantiable) <> 0
            set result: true
        if result = false
        {
            if (t.flags & TypeFlagsObject) <> 0
            {
                if Checker.is_non_generic_top_level_type(t) = false
                {
                    if (t.object_flags & ObjectFlagsReference) <> 0
                    {
                        ; ★★★ `t.AsTypeReference().node != nil ||` IS A SHORT
                        ; CIRCUIT AND DROPPING IT IS AN UNBOUNDED WALK. The note
                        ; that stood here read *the DEFERRED type reference, whose
                        ; slot this port does not carry … the disjunct is therefore
                        ; constant false here and the walk over the arguments is
                        ; the whole test* — the slot is `Reference.node`, read by
                        ; `reference_node_of` since slice 115, and
                        ; createDeferredTypeReference fills it. With the disjunct
                        ; dropped a deferred reference asks get_type_arguments,
                        ; whose instantiate_types asks instantiate_type, whose
                        ; FIRST gate is this function again — and the depth counter
                        ; that bounds the walk upstream is incremented AFTER that
                        ; gate, so it never leaves zero. `type T1<T> = [number,
                        ; T1<{ x: T }>]` is six lines and SIGSEGVs.
                        if Checker.reference_node_of(t) <> null
                            set result: true
                        else
                        {
                            let mark this.unported_mark()
                            let args this.get_type_arguments(t)
                            if this.unported_mark() <> mark
                                return false
                            if args <> null
                            {
                                let list args as ref[Array[ref[Type]?]]
                                let n list.get_length() as int
                                var i 0
                                while i < n
                                {
                                    let a list[i]
                                    if a <> null
                                    {
                                        let inner this.could_contain_type_variables(a as ref[Type])
                                        if this.unported_mark() <> mark
                                            return false
                                        if inner
                                            set result: true
                                    }
                                    set i: i + 1
                                }
                            }
                        }
                    }
                    if (t.object_flags & ObjectFlagsAnonymous) <> 0
                    {
                        if t.symbol <> null
                        {
                            let sym t.symbol as ref[Symbol]
                            if (Symbol.flags_of(sym) & (SymbolFlagsFunction | SymbolFlagsMethod | SymbolFlagsClass | SymbolFlagsTypeLiteral | SymbolFlagsObjectLiteral)) <> 0
                            {
                                if Symbol.declaration_count(sym) <> 0
                                    set result: true
                            }
                        }
                    }
                    if (t.object_flags & (ObjectFlagsMapped | ObjectFlagsReverseMapped | ObjectFlagsObjectRestType | ObjectFlagsInstantiationExpressionType)) <> 0
                        set result: true
                }
            }
        }
        ; ★★★ SLICE 131: THE UNION/INTERSECTION ARM, AND WHAT STOOD HERE WAS AN
        ; EXPIRED CLAIM RATHER THAN A GAP. The row read *nothing in this port makes
        ; a union or an intersection type … the arm is unreachable rather than
        ; unwritten* — true when it was written and false since slice 121 gave the
        ; port the intersection; measured, 336 units of stage 2 were arriving here.
        ; **An unreachability claim is a measurement with an expiry date, and the
        ; thing that expires it is a slice somewhere else in the file.**
        ;
        ; ★ The reference's disjunct carries two guards the object arm above does not
        ; have: an ENUM LITERAL union is excluded (its constituents are literal
        ; types and can hold no variable), and isNonGenericTopLevelType is asked
        ; again — constant false here, for that function's own recorded reason.
        if result = false
        {
            if (t.flags & TypeFlagsUnionOrIntersection) <> 0
            {
                if (t.flags & TypeFlagsEnumLiteral) = 0
                {
                    if Checker.is_non_generic_top_level_type(t) = false
                    {
                        let mark2 this.unported_mark()
                        ; `t.Types()` covers BOTH halves of the flag, so the
                        ; accessor has to as well — union_types_of alone answers
                        ; null for an intersection, which would have made the arm
                        ; a silent `false` for the very types slice 121 added.
                        let types Checker.union_or_intersection_types_of(t)
                        if types <> null
                        {
                            let list types as ref[Array[ref[Type]?]]
                            let n list.get_length() as int
                            var i 0
                            while i < n
                            {
                                let a list[i]
                                if a <> null
                                {
                                    let inner this.could_contain_type_variables(a as ref[Type])
                                    if this.unported_mark() <> mark2
                                        return false
                                    if inner
                                        set result: true
                                }
                                set i: i + 1
                            }
                        }
                    }
                }
            }
        }
        var bits ObjectFlagsCouldContainTypeVariablesComputed
        if result
            set bits: bits | ObjectFlagsCouldContainTypeVariables
        set t.object_flags: (t.object_flags | bits) as u32
        result
    }

    ; ── the active-mapper stack (slice 163) ─────────────────────────────────
    ;
    ; findActiveMapper / pushActiveMapper / popActiveMapper /
    ; clearActiveMapperCaches. ONE stack of ActiveMapper records where upstream has
    ; two parallel slices — the record's header carries the mapping decision and
    ; what the memo is for.

    ; core.FindLastIndex over c.activeMappers. ★LAST and not first: the same mapper
    ; can be pushed at two depths, and the entry an outer frame is filling is the
    ; one nearest the top.
    function find_active_mapper(this, m: ref[TypeMapper]) returns int
    {
        if active_mappers = null
            return 0 - 1
        let list active_mappers as ref[Array[ref[ActiveMapper]?]]
        var i active_mapper_count - 1
        while i >= 0
        {
            let row list[i]
            if row <> null
            {
                let r row as ref[ActiveMapper]
                if r.mapper <> null
                {
                    if (r.mapper as ref[TypeMapper]) = m
                        return i
                }
            }
            set i: i - 1
        }
        0 - 1
    }

    ; pushActiveMapper. A row past the count is one pop_active_mapper left
    ; behind: its `entries` list is already empty (the pop clears it, as upstream's
    ; does) and only the mapper has to be re-pointed.
    procedure push_active_mapper(this, m: ref[TypeMapper])
    {
        if active_mappers = null
            return
        let list active_mappers as ref[Array[ref[ActiveMapper]?]]
        let n list.get_length() as int
        if active_mapper_count < n
        {
            let row list[active_mapper_count]
            if row <> null
            {
                let r row as ref[ActiveMapper]
                set r.mapper: m as ref[TypeMapper]?
                set active_mapper_count: active_mapper_count + 1
                return
            }
        }
        let page Page.get(list)
        let entries &Array[ref[MapperCacheEntry]?]^page()
        list.add(&ActiveMapper^page(m as ref[TypeMapper]?, entries as ref[Array[ref[MapperCacheEntry]?]]?))
        set active_mapper_count: active_mapper_count + 1
    }

    ; popActiveMapper — the level leaves the stack and its memo is CLEARED, which
    ; is upstream's own `clear(...)` and not tidiness: the row is reused by the next
    ; push, and an entry taken under the previous occupant of this level is keyed on
    ; a mapper nobody will compare against again.
    procedure pop_active_mapper(this)
    {
        if active_mappers = null
            return
        if active_mapper_count = 0
            return
        let list active_mappers as ref[Array[ref[ActiveMapper]?]]
        set active_mapper_count: active_mapper_count - 1
        let row list[active_mapper_count]
        if row <> null
        {
            let r row as ref[ActiveMapper]
            set r.mapper: null
            if r.entries <> null
                (r.entries as ref[Array[ref[MapperCacheEntry]?]]).clear()
        }
    }

    ; clearActiveMapperCaches — every LIVE level's memo is dropped, the stack
    ; itself stays. ★★★ IT IS A CORRECTNESS CALL AND NOT A HOUSEKEEPING ONE:
    ; getInferredType calls it the moment an inference is settled, because an
    ; InferenceTypeMapper asked before and after that moment answers differently,
    ; and an entry taken under such a mapper is then a wrong answer with nothing to
    ; say so.
    procedure clear_active_mapper_caches(this)
    {
        if active_mappers = null
            return
        let list active_mappers as ref[Array[ref[ActiveMapper]?]]
        var i 0
        while i < active_mapper_count
        {
            let row list[i]
            if row <> null
            {
                let r row as ref[ActiveMapper]
                if r.entries <> null
                    (r.entries as ref[Array[ref[MapperCacheEntry]?]]).clear()
            }
            set i: i + 1
        }
    }

    ; The level's map, read and written. The key upstream is a hash of
    ; `writeType(t)` + `writeAlias(alias)`; here it is the association-list scan
    ; find_object_instantiation uses for the very same key parts (§3.16), so a nil
    ; alias and an alias with a nil symbol and no arguments are one key — which is
    ; the existing idiom's tolerance too, and every TypeAlias this port mints
    ; carries a symbol.
    function find_active_mapper_entry(level: ref[ActiveMapper], t: ref[Type], alias: ref[TypeAlias]?) returns ref[MapperCacheEntry]?
    {
        if level.entries = null
            return null
        let rows level.entries as ref[Array[ref[MapperCacheEntry]?]]
        var asym: ref[Symbol]? null
        var aargs: ref[Array[ref[Type]?]]? null
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set asym: al.symbol
            set aargs: al.type_arguments
        }
        let n rows.get_length() as int
        var i 0
        while i < n
        {
            let row rows[i]
            if row <> null
            {
                let r row as ref[MapperCacheEntry]
                if r.t <> null
                {
                    if (r.t as ref[Type]) = t
                    {
                        if r.alias_symbol = asym
                        {
                            if Checker.type_lists_equal(r.alias_type_arguments, aargs)
                                return row
                        }
                    }
                }
            }
            set i: i + 1
        }
        null
    }

    procedure add_active_mapper_entry(level: ref[ActiveMapper], t: ref[Type], alias: ref[TypeAlias]?, result: ref[Type]?)
    {
        if level.entries = null
            return
        let rows level.entries as ref[Array[ref[MapperCacheEntry]?]]
        var asym: ref[Symbol]? null
        var aargs: ref[Array[ref[Type]?]]? null
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set asym: al.symbol
            set aargs: al.type_arguments
        }
        let page Page.get(rows)
        rows.add(&MapperCacheEntry^page(t as ref[Type]?, asym, aargs, result))
    }

    ; instantiateType / instantiateTypeWithAlias, folded into one because `alias`
    ; is nil at every call site this port has — the reference's own instantiateType
    ; passes nil, and the three callers that do not are all behind stops.
    ;
    ; ★★★ THE ALIAS HALF OF THE GUARD IS LIVE SINCE SLICE 139, and the sentence
    ; that stood here — *constant FALSE … `Type.alias` is not carried* — expired with
    ; slice 111's alias slots, the same expiry that turned
    ; is_non_generic_top_level_type into a stack overflow. Upstream's own comment
    ; says what it buys: *"Check for type variables in the alias, so things like
    ; `type Brand<T> = number & {}` can potentially be copied with new alias type
    ; args, despite them being unreferenced"* — without it an alias whose arguments
    ; are type variables the BODY never mentions is not instantiated at all, and the
    ; cache then leaks type parameters out of their scope.
    ;
    ; ★★★ THE PARAGRAPH THAT STOOD HERE WAS EXPIRED IN BOTH ITS HALVES, and
    ; neither half had a tag. It read: *THE ACTIVE-MAPPER CACHE IS NOT PORTED and
    ; its reader is named … it arrives with the first recursion that can reach it,
    ; which is the conditional-type chapter. The five-million-instantiation limiter
    ; is not carried either: its counter is reset per statement by
    ; checkSourceElement, a line this port does not have.* The second sentence
    ; expired in slice 154 (checkSourceElement had been in the file since slice 47
    ; and the limiter is a disjunction here now, §3.5gi); the first named the
    ; conditional-type chapter as its arrival, and that chapter landed in slice 121
    ; — the cache is this slice's, and its READER turned out not to be identity but
    ; the last `combineTypeMappers` site, four hundred lines below.
    procedure instantiate_type(this, t: ref[Type]?, m: ref[TypeMapper]?) returns ref[Type]?
        this.instantiate_type_with_alias(t, m, null)

    ; instantiateTypeWithAlias. ★★★THE ALIAS PARAMETER IS SLICE 125'S AND IT IS NOT
    ; A CONVENIENCE: five arms of the worker read it, and an instantiation that
    ; drops it prints `{ x: string; }` where the reference prints `A<string>` —
    ; a well-formed wrong answer rather than a missing one, which is the class
    ; slice 111's alias slot was added for.
    procedure instantiate_type_with_alias(this, t: ref[Type]?, m: ref[TypeMapper]?, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        if t = null
            return null
        if m = null
            return t
        let ty t as ref[Type]
        let mark this.unported_mark()
        var could this.could_contain_type_variables(ty)
        if this.unported_mark() <> mark
            return null
        if could = false
        {
            if ty.alias_type_arguments <> null
            {
                let aliases ty.alias_type_arguments as ref[Array[ref[Type]?]]
                let an aliases.get_length() as int
                var i 0
                while i < an
                {
                    let a aliases[i]
                    if a <> null
                    {
                        if this.could_contain_type_variables(a as ref[Type])
                            set could: true
                        if this.unported_mark() <> mark
                            return null
                    }
                    set i: i + 1
                }
            }
        }
        if could = false
            return t
        ; ★★★ SLICE 154: THE LIMIT IS A DISJUNCTION AND THE ERROR IS THE ANSWER.
        ; What stood here was `if instantiation_depth = 100` plus a stop whose
        ; comment read *there is no currentNode in this port — the field is set by
        ; checkSourceElement, which is a chapter away — so the depth limit reports
        ; instead of erroring*. checkSourceElement had been in the file since slice
        ; 47; the field is here now, and with it the reference's own two halves —
        ; `instantiationDepth == 100 || instantiationCount >= 5_000_000` and
        ; `return c.errorType`. The 5 000 000 budget is the disjunct §3.5gi is
        ; about: it had no tag, no stop and no row, because a dropped disjunct
        ; cannot have one.
        if instantiation_depth = 100 or instantiation_count >= 5000000
        {
            this.error_on_node(current_node, DiagType_instantiation_is_excessively_deep_and_possibly_infinite)
            return error_type
        }
        ; ── the active-mapper memo, slice 163 ────────────────────────────────
        ;
        ; The reference's own five lines, in its order: find the mapper on the
        ; stack, push it if it is not there, read the level's (type, alias) memo,
        ; and on the way out either POP the level this call pushed or WRITE the
        ; entry into the level somebody else owns.
        ;
        ; ★★★ THE ASYMMETRY IS THE MECHANISM (see ActiveMapper): a level this call
        ; pushed is gone before anyone could read it, so upstream does not write
        ; there; a level already on the stack belongs to an outer frame that is
        ; still instantiating under the same mapper, and the entry is what its next
        ; ask reads. ★It is a memo and not a cycle breaker, and it is measured inert
        ; on this corpus — ActiveMapper's header carries both halves of that.
        let mapper m as ref[TypeMapper]
        let index this.find_active_mapper(mapper)
        if index = 0 - 1
            this.push_active_mapper(mapper)
        var level: ref[ActiveMapper]? null
        if active_mappers <> null
        {
            let list active_mappers as ref[Array[ref[ActiveMapper]?]]
            var at index
            if index = 0 - 1
                set at: active_mapper_count - 1
            if at >= 0
            {
                if at < (list.get_length() as int)
                    set level: list[at]
            }
        }
        if level <> null
        {
            let cached Checker.find_active_mapper_entry(level as ref[ActiveMapper], ty, alias)
            if cached <> null
            {
                ; ★ The entry is the answer even when it holds null: upstream's map
                ; is read with the two-value form (`if cachedType, ok := ...; ok`),
                ; so a stored nil is a HIT there too. Nothing stores a nil here —
                ; the write below is skipped for a reported walk — so this is the
                ; reference's shape rather than a case with a producer.
                if index = 0 - 1
                    this.pop_active_mapper()
                return (cached as ref[MapperCacheEntry]).instantiated
            }
        }
        set total_instantiation_count: total_instantiation_count + 1
        set instantiation_count: instantiation_count + 1
        set instantiation_depth: instantiation_depth + 1
        let result this.instantiate_type_worker(ty, m as ref[TypeMapper], alias)
        set instantiation_depth: instantiation_depth - 1
        if index = 0 - 1
            this.pop_active_mapper()
        else
        {
            ; ★★★ A REPORTED WALK IS NOT MEMOISED. `instantiate_type_worker`
            ; answering null because it met a wall is not an answer about the type,
            ; and an entry holding it would hand that null back to a later ask
            ; whose walk might have got further — this port's own hazard, with no
            ; counterpart upstream.
            if this.unported_mark() = mark
            {
                if level <> null
                    Checker.add_active_mapper_entry(level as ref[ActiveMapper], ty, alias, result)
            }
        }
        result
    }

    ; instantiateTypeWorker, WHOLE except the substitution arm.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE WAS TRUE AND IS NOW ITS OWN EXPIRY. It read
    ; *"seven [arms] report, and the seven are one fact rather than seven: a union,
    ; an intersection, an index, an indexed access, a template literal, a string
    ; mapping, a conditional and a substitution are type KINDS nothing in this port
    ; can make"* — that was slice 86 speaking, and slice 121 minted every one of
    ; them. From that slice on the arms were not unreachable but WALLS, and the
    ; difference was invisible because a wall and an unreachable branch report
    ; exactly the same line (§3.5v).
    ;
    ; ★★★ THE SUBSTITUTION ARM IS THE ONE THAT STAYS, and it is a genuine
    ; unreachable rather than a wall: nothing in this port mints a substitution
    ; type — getSubstitutionType has no caller here, the conditional's true branch
    ; does not narrow, and NoInfer is a chapter away — so its three callees
    ; (get_substitution_type, get_no_infer_type, get_restrictive_instantiation) are
    ; named rather than written.
    procedure instantiate_type_worker(this, t: ref[Type], m: ref[TypeMapper], alias_in: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        var alias alias_in
        if (t.flags & TypeFlagsTypeParameter) <> 0
            return this.type_mapper_map(m, t)
        if (t.flags & TypeFlagsObject) <> 0
        {
            if (t.object_flags & (ObjectFlagsReference | ObjectFlagsAnonymous | ObjectFlagsMapped)) = 0
                return t
            if (t.object_flags & ObjectFlagsReference) <> 0
            {
                ; `&& t.AsTypeReference().node == nil` — a DEFERRED reference has a
                ; node and falls through to getObjectTypeInstantiation, which is
                ; where the reference sends it too.
                if Checker.reference_node_of(t) = null
                {
                    let args Checker.resolved_type_arguments_of(t)
                    let mapped this.instantiate_types(args, m)
                    if this.unported_mark() <> mark
                        return null
                    if mapped = args
                        return t
                    let target Checker.target_of(t)
                    if target = null
                    {
                        this.record_unported("instantiate-type-reference-no-target", t.object_flags)
                        return null
                    }
                    return this.create_normalized_type_reference(target as ref[Type], mapped)
                }
            }
            if (t.object_flags & ObjectFlagsReverseMapped) <> 0
            {
                ; instantiateReverseMappedType. ★The note that stood here called its
                ; one step *inferTypeForHomomorphicMappedType — the reverse-mapping
                ; half of the inference, which has no producer here either*; slice
                ; 160 ported that function and the three slots this reads, and
                ; `tools/expiredstops.py` named it by the callee.
                ;
                ; ★★ THE TWO EARLY RETURNS ARE THE IDENTITY AND NOT A FAILURE: an
                ; instantiated mapped type that is no longer Mapped, or an index
                ; type that is no longer an Index, means the mapper has taken the
                ; shape apart and the reverse-mapped type stands as it is. So does
                ; a null from the inference — upstream's own trailing comment says
                ; *nested invocation … or the `source` instantiated into something
                ; unmappable* — which is why none of the three reports.
                let inner_mapped this.instantiate_type(Checker.reverse_mapped_type_of(t), m)
                if this.unported_mark() <> mark
                    return null
                if inner_mapped = null
                    return t
                let im inner_mapped as ref[Type]
                if (im.object_flags & ObjectFlagsMapped) = 0
                    return t
                let inner_index this.instantiate_type(Checker.reverse_constraint_type_of(t), m)
                if this.unported_mark() <> mark
                    return null
                if inner_index = null
                    return t
                let ii inner_index as ref[Type]
                if (ii.flags & TypeFlagsIndex) = 0
                    return t
                let inner_source this.instantiate_type(Checker.reverse_source_of(t), m)
                if this.unported_mark() <> mark
                    return null
                if inner_source = null
                    return t
                let instantiated this.infer_type_for_homomorphic_mapped_type(inner_source as ref[Type], im, ii)
                if this.unported_mark() <> mark
                    return null
                if instantiated <> null
                    return instantiated
                return t
            }
            return this.get_object_type_instantiation(t, m, alias)
        }
        if (t.flags & TypeFlagsUnionOrIntersection) <> 0
        {
            ; `source` is the ORIGIN of a union when it has one, which is the
            ; reference's own way of instantiating the union a reduction came
            ; from rather than the reduced list.
            var source t
            if (t.flags & TypeFlagsUnion) <> 0
            {
                let origin Checker.union_origin_of(t)
                if origin <> null
                {
                    if ((origin as ref[Type]).flags & TypeFlagsUnionOrIntersection) <> 0
                        set source: origin as ref[Type]
                }
            }
            let types Checker.union_or_intersection_types_of(source)
            let new_types this.instantiate_types(types, m)
            if this.unported_mark() <> mark
                return null
            if new_types = types
            {
                var same_alias false
                if alias = null
                {
                    if t.alias_symbol = null
                        set same_alias: true
                }
                if alias <> null
                {
                    if (alias as ref[TypeAlias]).symbol = t.alias_symbol
                        set same_alias: true
                }
                if same_alias
                    return t
            }
            if alias = null
                set alias: this.instantiate_type_alias(t, m)
            if this.unported_mark() <> mark
                return null
            if (source.flags & TypeFlagsIntersection) <> 0
                return this.get_intersection_type_ex(this.type_list_or_empty(new_types), IntersectionFlagsNone, alias)
            return this.get_union_type_ex(this.type_list_or_empty(new_types), UnionReductionLiteral, alias, null)
        }
        if (t.flags & TypeFlagsIndex) <> 0
        {
            let target Checker.index_target_of(t)
            if target = null
                return t
            let inner this.instantiate_type(target, m)
            if this.unported_mark() <> mark
                return null
            if inner = null
                return null
            return this.get_index_type(inner as ref[Type])
        }
        if (t.flags & TypeFlagsIndexedAccess) <> 0
        {
            if alias = null
                set alias: this.instantiate_type_alias(t, m)
            if this.unported_mark() <> mark
                return null
            let ot Checker.indexed_access_object_type_of(t)
            let it Checker.indexed_access_index_type_of(t)
            if ot = null
                return t
            if it = null
                return t
            let new_ot this.instantiate_type(ot, m)
            if this.unported_mark() <> mark
                return null
            let new_it this.instantiate_type(it, m)
            if this.unported_mark() <> mark
                return null
            if new_ot = null
                return null
            if new_it = null
                return null
            return this.get_indexed_access_type_ex(new_ot as ref[Type], new_it as ref[Type], Checker.indexed_access_flags_of(t), null, alias)
        }
        ; ★★★ THE TEMPLATE-LITERAL AND STRING-MAPPING ARMS ARE ONE LINE EACH, AND
        ; THE NOTE THAT STOOD HERE FOR FORTY-FIVE SLICES PRICED A CHAPTER SLICE 126
        ; HAD ALREADY WRITTEN. It read *`getTemplateLiteralType` is a chapter of its
        ; own (the cross-product check, the span folding, the intern table keyed on
        ; texts AND types, …)* — every one of those is four hundred lines above,
        ; landed the same slice as this stop's neighbours; only the string-mapping
        ; half was genuinely absent, and this row was the frontier's largest by
        ; ROW at stage 2 the whole time (§3.5eo again, slice 171).
        if (t.flags & TypeFlagsTemplateLiteral) <> 0
        {
            let ty Checker.template_literal_types_of(t)
            let tx Checker.template_literal_texts_of(t)
            if ty = null
                return null
            if tx = null
                return null
            let new_types this.instantiate_types(ty as ref[Array[ref[Type]?]], m)
            if this.unported_mark() <> mark
                return null
            if new_types = null
                return null
            return this.get_template_literal_type(tx as ref[Array[ref[String]?]], new_types as ref[Array[ref[Type]?]])
        }
        if (t.flags & TypeFlagsStringMapping) <> 0
        {
            let target Checker.string_mapping_target_of(t)
            if target = null
                return null
            if t.symbol = null
                return null
            let new_target this.instantiate_type(target as ref[Type], m)
            if this.unported_mark() <> mark
                return null
            if new_target = null
                return null
            return this.get_string_mapping_type(t.symbol as ref[Symbol], new_target as ref[Type])
        }
        if (t.flags & TypeFlagsConditional) <> 0
        {
            ; ★`combineTypeMappers`, not `mergeTypeMappers` — see the note at
            ; get_conditional_type's combined mapper for the sweep this belongs to.
            let combined this.combine_type_mappers(Checker.conditional_mapper_of(t), m)
            return this.get_conditional_type_instantiation(t, combined, false, alias)
        }
        ; ★★★ THE SUBSTITUTION ARM, SLICE 136, AND THE HEADER ABOVE NAMED ITS
        ; EXPIRY: it called this *"a genuine unreachable rather than a wall"*
        ; because *"nothing in this port mints a substitution type —
        ; getSubstitutionType has no caller here"*. Both halves fell in one slice:
        ; get_conditional_flow_type_of_type now calls get_substitution_type, and a
        ; substitution reaching instantiation is the ORDINARY consequence, since the
        ; type originates in a conditional's true branch and every use of that branch
        ; instantiates it.
        ;
        ; ★★★ THE THIRD TEST IS WHOLE SINCE SLICE 151 AND THE ARM HAS NO STOP LEFT.
        ; The note that stood here said the second disjunct —
        ; `isTypeAssignableTo(restrictive(base), restrictive(constraint))` — *"needs
        ; getRestrictiveInstantiation, whose mapper is a FUNCTION type mapper this
        ; port has no arm for"*, and that reading it as false would take the two
        ; branches BELOW it, i.e. a wrong answer rather than a missing one. Both the
        ; mapper arm and the instantiation landed in this slice, so the disjunct is
        ; the reference's and the two branches below it are written for the first
        ; time — they were unreachable while the report stood in front of them.
        if (t.flags & TypeFlagsSubstitution) <> 0
        {
            let base Checker.substitution_base_type_of(t)
            if base = null
                return null
            let new_base this.instantiate_type(base as ref[Type], m)
            if this.unported_mark() <> mark
                return null
            if new_base = null
                return null
            let nb new_base as ref[Type]
            if Checker.is_no_infer_type(t)
                return this.get_no_infer_type(nb)
            let constraint Checker.substitution_constraint_of(t)
            if constraint = null
                return null
            let new_constraint this.instantiate_type(constraint as ref[Type], m)
            if this.unported_mark() <> mark
                return null
            if new_constraint = null
                return null
            let nc new_constraint as ref[Type]
            ; "A substitution type originates in the true branch of a conditional
            ; type and can be resolved to just the base type in the same cases as the
            ; conditional type resolves to its true branch (because the base type is
            ; then known to satisfy the constraint)."
            if (nb.flags & TypeFlagsTypeVariable) <> 0
            {
                if this.is_generic_type(nc)
                    return this.get_substitution_type(nb, nc)
            }
            var resolves false
            if (nc.flags & TypeFlagsAnyOrUnknown) <> 0
                set resolves: true
            if resolves = false
            {
                let rb this.get_restrictive_instantiation(nb)
                if this.unported_mark() <> mark
                    return null
                if rb = null
                    return null
                let rc this.get_restrictive_instantiation(nc)
                if this.unported_mark() <> mark
                    return null
                if rc = null
                    return null
                if this.is_type_assignable_to(rb as ref[Type], rc as ref[Type])
                    set resolves: true
                if this.unported_mark() <> mark
                    return null
            }
            if resolves
                return nb
            if (nb.flags & TypeFlagsTypeVariable) <> 0
                return this.get_substitution_type(nb, nc)
            let pair &Array[ref[Type]?]()
            pair.add(nc)
            pair.add(nb)
            return this.get_intersection_type(pair)
        }
        t
    }

    ; `core.Map(list, f)` answers an EMPTY list where the input is nil, and the two
    ; union factories below take a non-optional one. One helper rather than the
    ; ternary at each of the four sites.
    function type_list_or_empty(this, list: ref[Array[ref[Type]?]]?) returns ref[Array[ref[Type]?]]
    {
        if list = null
            return this.new_type_list(null)
        list as ref[Array[ref[Type]?]]
    }

    ; instantiateTypeAlias — the reference takes a `*TypeAlias`, this takes the TYPE
    ; whose two alias slots hold one (§3.15). A type with no alias symbol has no
    ; alias, which is upstream's nil check.
    procedure instantiate_type_alias(this, t: ref[Type], m: ref[TypeMapper]) returns ref[TypeAlias]?
    {
        if t.alias_symbol = null
            return null
        let mark this.unported_mark()
        let args this.instantiate_types(t.alias_type_arguments, m)
        if this.unported_mark() <> mark
            return null
        &TypeAlias^host(t.alias_symbol, args) as ref[TypeAlias]?
    }

    ; ── getObjectTypeInstantiation and what it stands on (slice 125) ────────
    ;
    ; The reference's own comment names the four object kinds it handles:
    ; AnonymousType, a MAPPED type, a deferred TypeReference and the instantiation
    ; expression. ★All four arrive since slice 181 gave the last a producer.
    ;
    ; ★★★ THE MEMO IS ON THE *TARGET*, NOT ON THE TYPE BEING INSTANTIATED, and that
    ; is what makes `Partial<T>` inside a generic function answer ONE type rather
    ; than one per visit. Its key is the type ARGUMENTS for the outer type
    ; parameters, plus the alias, plus the single-signature bit.
    procedure get_object_type_instantiation(this, t: ref[Type], m: ref[TypeMapper]?, alias_in: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        var declaration: ref[AstNode]? null
        if (t.object_flags & ObjectFlagsReference) <> 0
            set declaration: Checker.reference_node_of(t)
        if (t.object_flags & ObjectFlagsReference) = 0
        {
            ; `declaration = t.AsInstantiationExpressionType().node`. ★The stop that
            ; stood here read *no producer, so the branch is unreachable rather
            ; than missing* — true until this slice wrote
            ; getInstantiationExpressionType, and the arm is the one line it always
            ; was.
            if (t.object_flags & ObjectFlagsInstantiationExpressionType) <> 0
                set declaration: Checker.instantiation_expression_node_of(t)
            else
            {
                if t.symbol = null
                {
                    this.record_unported("object-type-instantiation-no-symbol", t.object_flags)
                    return null
                }
                set declaration: Symbol.declaration_at(t.symbol as ref[Symbol], 0)
            }
        }
        if declaration = null
        {
            this.record_unported("object-type-instantiation-no-declaration", t.object_flags)
            return null
        }
        let decl declaration as ref[AstNode]
        let links this.type_node_link_of(decl)
        var target: ref[Type]? null
        if (t.object_flags & ObjectFlagsReference) <> 0
            set target: links.resolved_type
        if (t.object_flags & ObjectFlagsReference) = 0
        {
            if (t.object_flags & ObjectFlagsInstantiated) <> 0
                set target: Checker.target_of(t)
            if (t.object_flags & ObjectFlagsInstantiated) = 0
                set target: t
        }
        if target = null
        {
            this.record_unported("object-type-instantiation-no-target", t.object_flags)
            return null
        }
        let tgt target as ref[Type]
        if links.outer_type_parameters_computed = false
        {
            ; The first time an anonymous type is instantiated the type parameters
            ; in SCOPE are computed and stored; for a type literal that is not the
            ; right-hand side of a generic alias the set is reduced to those the
            ; literal could possibly name.
            var tps this.get_outer_type_parameters(decl, true)
            if this.unported_mark() <> mark
                return null
            var alias_arg_count 0
            if tgt.alias_type_arguments <> null
                set alias_arg_count: (tgt.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() as int
            if alias_arg_count = 0
            {
                if (t.object_flags & (ObjectFlagsReference | ObjectFlagsInstantiationExpressionType)) <> 0
                {
                    set tps: this.filter_possibly_referenced_at(tps, decl)
                    if this.unported_mark() <> mark
                        return null
                }
                if (t.object_flags & (ObjectFlagsReference | ObjectFlagsInstantiationExpressionType)) = 0
                {
                    var filter_by_symbol false
                    if tgt.symbol <> null
                    {
                        if (Symbol.flags_of(tgt.symbol as ref[Symbol]) & (SymbolFlagsMethod | SymbolFlagsTypeLiteral)) <> 0
                            set filter_by_symbol: true
                    }
                    if filter_by_symbol
                    {
                        set tps: this.filter_possibly_referenced_in_declarations(tps, t.symbol)
                        if this.unported_mark() <> mark
                            return null
                    }
                }
            }
            if tps = null
                set tps: this.new_type_list(null)
            set links.outer_type_parameters: tps
            set links.outer_type_parameters_computed: true
        }
        let type_parameters links.outer_type_parameters
        if type_parameters = null
            return t
        let tpl type_parameters as ref[Array[ref[Type]?]]
        let tp_count tpl.get_length() as int
        if tp_count = 0
            return t
        ; The mapper for the outer parameters, and the key built from what it
        ; answers for each of them.
        ;
        ; ★★★ THIS IS `combineTypeMappers` AGAIN SINCE SLICE 163, AND THE THING
        ; THAT HAD BLOCKED IT FOR TWELVE SLICES WAS IN ANOTHER FUNCTION ENTIRELY.
        ; It kept `mergeTypeMappers` from slice 151 because the reference's spelling
        ; took `compiler/cyclicGenericTypeInstantiation` and its `…Inference` sibling
        ; to rc 139 on all six artifacts, with a 64 MB stack too. That measurement
        ; was right every time it was repeated. The DIAGNOSIS was wrong: the note
        ; blamed the eager instantiation and named `findActiveMapper` /
        ; `pushActiveMapper` / `activeTypeMappersCaches` as the missing mechanism,
        ; slice 158 reproduced the crash and slice 159 wrote a hand-composition
        ; around half of it — and a BACKTRACE says the recursion is not here at all.
        ; It is the PRINTER: type_to_string -> create_anonymous_type_node ->
        ; create_type_node_from_object_type -> write_type_literal ->
        ; write_property_member -> get_non_missing_type_of_symbol -> ONE
        ; instantiate_type -> back into type_to_string, one level deeper. The
        ; instantiation frames are a leaf of that walk, which is exactly why
        ; `instantiation_depth` oscillated 0-1-0-1 — the observation the old note
        ; recorded and then read as evidence about the instantiation.
        ;
        ; ★★★ WHAT THE COMPOSITION CHANGES IS ONLY THAT THE CYCLIC TYPE GETS BUILT.
        ; The merged mapper leaves a type variable standing where `m` still had
        ; something to do, so `foo<typeof y>()` inside `foo` never becomes the
        ; genuinely self-referential object type; composed, it does, and the printer
        ; then walks it forever. The fix is `visitAndTransformType`'s `symbolDepth`
        ; guard, dropped silently when that function was ported (see
        ; create_anonymous_type_node) — eleven levels and then `any`, which is what
        ; the reference's own baseline for these two units prints.
        ;
        ; ★★★ AND THE DIFFERENCE THE COMPOSITION MAKES IS THE WHOLE ROW: the merged
        ; mapper answers `m1.Map(tp)` and stops, so wherever `m` still had something
        ; to do to that answer this port kept a type variable the reference
        ; substitutes — `Partial<T extends string ? 1 : 2>` inside a generic alias,
        ; asked at `SF<number>`, answered the uninstantiated mapped type where
        ; upstream answers `2`, at rc 0 and with a TS2322 the reference does not
        ; have. Slice 159's hand-composition of the TYPE-PARAMETER half and slice
        ; 158's report for the rest (`merged-mapper-not-combined`) are both gone with
        ; it: they were the divergence made visible, and there is no divergence left
        ; to see.
        let combined_mapper this.combine_type_mappers(Checker.mapper_of(t), m)
        if combined_mapper = null
            return t
        let cm combined_mapper as ref[TypeMapper]
        let type_arguments this.new_type_list(null)
        var i 0
        while i < tp_count
        {
            let mapped this.type_mapper_map(cm, tpl[i])
            if this.unported_mark() <> mark
                return null
            type_arguments.add(mapped)
            set i: i + 1
        }
        var alias alias_in
        if alias = null
            set alias: this.instantiate_type_alias(t, m as ref[TypeMapper])
        if this.unported_mark() <> mark
            return null
        var single_signature false
        if (t.object_flags & ObjectFlagsSingleSignatureType) <> 0
            set single_signature: true
        if Checker.object_instantiations_of(tgt) = null
        {
            ; `data.instantiations[getTypeInstantiationKey(typeParameters, target.alias, false)] = target`
            ; — the table is seeded with the target under its OWN parameters, so
            ; that instantiating with the identity answers the target itself.
            let seeded &Array[ref[ObjectInstantiation]?]^host()
            Checker.attach_object_instantiations(tgt, seeded)
            var target_alias: ref[TypeAlias]? null
            if tgt.alias_symbol <> null
                set target_alias: &TypeAlias^host(tgt.alias_symbol, tgt.alias_type_arguments) as ref[TypeAlias]?
            Checker.add_object_instantiation(tgt, type_parameters, target_alias, false, tgt)
        }
        let found this.find_object_instantiation(tgt, type_arguments, alias, single_signature)
        if found <> null
            return found
        ; ★ combineTypeMappers and NOT mergeTypeMappers, which is what stood here
        ; while the COMPOSITE arm had no writer: a single-signature type's outer
        ; mapper has to be applied to the whole result of the inner one, not merely
        ; asked about the type it answers. Slice 139 gives the arm its writer and
        ; the line its reference spelling.
        var new_mapper this.new_type_mapper(type_parameters, type_arguments) as ref[TypeMapper]?
        if (tgt.object_flags & ObjectFlagsSingleSignatureType) <> 0
        {
            if m <> null
                set new_mapper: this.combine_type_mappers(new_mapper, m)
        }
        var result: ref[Type]? null
        ; ★ The REFERENCE arm reads the node off `t` and the target off `t.Target()`
        ; — not off `tgt`, which is `t`'s own target already; the deferred reference
        ; is re-made against the DEFERRED node with the new mapper.
        if (tgt.object_flags & ObjectFlagsReference) <> 0
        {
            let node Checker.reference_node_of(t)
            if node = null
                return null
            let inner Checker.target_of(t)
            if inner = null
                return null
            set result: this.create_deferred_type_reference_ex(inner as ref[Type], node as ref[AstNode], new_mapper, alias)
        }
        if (tgt.object_flags & ObjectFlagsReference) = 0
        {
            if (tgt.object_flags & ObjectFlagsMapped) <> 0
                set result: this.instantiate_mapped_type(tgt, new_mapper, alias)
            if (tgt.object_flags & ObjectFlagsMapped) = 0
                set result: this.instantiate_anonymous_type(tgt, new_mapper, alias)
        }
        if this.unported_mark() <> mark
            return null
        if result = null
            return null
        Checker.add_object_instantiation(tgt, type_arguments, alias, single_signature, result)
        ; ★★★ The `CouldContainTypeVariablesComputed` carry-forward IS AN ANSWER, NOT A
        ; MEMO — the note that stood here said could_contain_type_variables computes the
        ; same bit, and for a MAPPED type it does not: that function answers TRUE off the
        ; Mapped bit, while this stamp answers from the OUTER TYPE ARGUMENTS — an
        ; instantiation whose arguments hold no type variable cannot reference one, so
        ; `Record<any, any>` is stamped `computed, false` and instantiateType returns it
        ; untouched ever after. Without the stamp the port re-instantiated the constraint
        ; of every substitution under it, one extra instantiation per level, and reported
        ; two TS2321 the reference does not reach (`excessivelyDeepConditionalTypes`,
        ; slice 216).
        let made result as ref[Type]
        if (made.flags & TypeFlagsObjectFlagsType) <> 0
        {
            if (made.object_flags & ObjectFlagsCouldContainTypeVariablesComputed) = 0
            {
                var args_could false
                let nta type_arguments.get_length() as int
                var ai 0
                while ai < nta
                {
                    let a type_arguments[ai]
                    if a <> null
                    {
                        if this.could_contain_type_variables(a as ref[Type])
                            set args_could: true
                    }
                    set ai: ai + 1
                }
                if (made.object_flags & (ObjectFlagsMapped | ObjectFlagsAnonymous | ObjectFlagsReference)) <> 0
                {
                    var stamp ObjectFlagsCouldContainTypeVariablesComputed
                    if args_could
                        set stamp: stamp | ObjectFlagsCouldContainTypeVariables
                    set made.object_flags: (made.object_flags | stamp) as u32
                }
                else
                {
                    if args_could = false
                        set made.object_flags: made.object_flags | ObjectFlagsCouldContainTypeVariablesComputed
                }
            }
        }
        result
    }

    ; `core.Filter(typeParameters, func(tp) { return c.isTypeParameterPossiblyReferenced(tp, declaration) })`
    ; and its sibling over the type's OWN declarations — two loops rather than a
    ; func value, on §3.5e's rule.
    procedure filter_possibly_referenced_at(this, tps: ref[Array[ref[Type]?]]?, decl: ref[AstNode]) returns ref[Array[ref[Type]?]]?
    {
        if tps = null
            return null
        let list tps as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        let out this.new_type_list(null)
        var i 0
        while i < n
        {
            let tp list[i]
            if tp <> null
            {
                let keep this.is_type_parameter_possibly_referenced(tp as ref[Type], decl)
                if this.unported_mark() <> mark
                    return null
                if keep
                    out.add(tp)
            }
            set i: i + 1
        }
        out
    }

    procedure filter_possibly_referenced_in_declarations(this, tps: ref[Array[ref[Type]?]]?, symbol: ref[Symbol]?) returns ref[Array[ref[Type]?]]?
    {
        if tps = null
            return null
        if symbol = null
            return tps
        let sym symbol as ref[Symbol]
        let list tps as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let dn Symbol.declaration_count(sym)
        let mark this.unported_mark()
        let out this.new_type_list(null)
        var i 0
        while i < n
        {
            let tp list[i]
            if tp <> null
            {
                var keep false
                var j 0
                while j < dn
                {
                    let d Symbol.declaration_at(sym, j)
                    if d <> null
                    {
                        let hit this.is_type_parameter_possibly_referenced(tp as ref[Type], d as ref[AstNode])
                        if this.unported_mark() <> mark
                            return null
                        if hit
                        {
                            set keep: true
                            set j: dn
                        }
                    }
                    set j: j + 1
                }
                if keep
                    out.add(tp)
            }
            set i: i + 1
        }
        out
    }

    ; isTypeParameterPossiblyReferenced. ★★★THE ANSWER IS CONSERVATIVE IN ONE
    ; DIRECTION ONLY and the reference's own comment says which: a `true` costs an
    ; instantiation, a wrong `false` drops a type parameter out of the key and two
    ; different instantiations then share one cached answer.
    procedure is_type_parameter_possibly_referenced(this, tp: ref[Type], node: ref[AstNode]) returns bool
    {
        if tp.symbol = null
            return true
        let sym tp.symbol as ref[Symbol]
        if Symbol.declaration_count(sym) <> 1
            return true
        let first Symbol.declaration_at(sym, 0)
        if first = null
            return true
        let container AstNode.parent_node_of(first as ref[AstNode])
        let mark this.unported_mark()
        var n: ref[AstNode]? node
        while n <> null
        {
            let cur n as ref[AstNode]
            if container <> null
            {
                if cur = (container as ref[AstNode])
                    set n: null
            }
            if n <> null
            {
                if AstNode.kind_of(cur) = KindBlock
                    return true
                if AstNode.kind_of(cur) = KindConditionalType
                {
                    let et AstNode.conditional_extends_type_of(cur)
                    if et <> null
                    {
                        let hit this.contains_type_parameter_reference(tp, et as ref[AstNode])
                        if this.unported_mark() <> mark
                            return true
                        if hit
                            return true
                    }
                }
                set n: AstNode.parent_node_of(cur)
                ; The walk terminates at the container; running off the top means
                ; the node is not inside the parameter's own scope at all, which
                ; the reference reaches as `n == nil` and answers true for.
                if n = null
                    return true
            }
        }
        this.contains_type_parameter_reference(tp, node)
    }

    ; `containsReference`, the closure. It is a method taking `tp` for §3.9's
    ; reason — a Scaly closure cannot escape into a recursive walk — and the walk
    ; itself is the index pair §3.9d prescribes for ForEachChild.
    procedure contains_type_parameter_reference(this, tp: ref[Type], node: ref[AstNode]) returns bool
    {
        let mark this.unported_mark()
        let k AstNode.kind_of(node)
        if k = KindThisType
            return Checker.is_this_type_of(tp)
        if k = KindTypeReference
        {
            if Checker.is_this_type_of(tp) = false
            {
                if AstNode.list_count(AstNode.type_arguments_of(node)) = 0
                {
                    let sym this.get_symbol_from_type_reference(node)
                    if this.unported_mark() <> mark
                        return true
                    if sym <> null
                    {
                        if (sym as ref[Symbol]) = tp.symbol
                            return true
                    }
                }
            }
        }
        if k = KindTypeQuery
        {
            let entity AstNode.type_query_expr_name_of(node)
            let firstid Checker.get_first_identifier(entity)
            if AstNode.is_this_identifier(firstid) = false
            {
                if firstid = null
                    return true
                let fsym this.get_resolved_symbol(firstid as ref[AstNode])
                if this.unported_mark() <> mark
                    return true
                let tpd Symbol.declaration_at(tp.symbol as ref[Symbol], 0)
                if tpd = null
                    return true
                var scope: ref[AstNode]? null
                if AstNode.kind_of(tpd as ref[AstNode]) = KindTypeParameter
                    set scope: AstNode.parent_node_of(tpd as ref[AstNode])
                if AstNode.kind_of(tpd as ref[AstNode]) <> KindTypeParameter
                {
                    if Checker.is_this_type_of(tp)
                        set scope: tpd
                }
                if scope <> null
                {
                    let sc scope as ref[AstNode]
                    let fn Symbol.declaration_count(fsym)
                    var i 0
                    while i < fn
                    {
                        let d Symbol.declaration_at(fsym, i)
                        if Checker.is_node_descendant_of(d, sc)
                            return true
                        set i: i + 1
                    }
                    let args AstNode.type_arguments_of(node)
                    let an AstNode.list_count(args)
                    var j 0
                    while j < an
                    {
                        let a AstNode.child_in_list(args, j)
                        if a <> null
                        {
                            let hit this.contains_type_parameter_reference(tp, a as ref[AstNode])
                            if this.unported_mark() <> mark
                                return true
                            if hit
                                return true
                        }
                        set j: j + 1
                    }
                    return false
                }
            }
            return true
        }
        var is_method false
        if k = KindMethodDeclaration
            set is_method: true
        if k = KindMethodSignature
            set is_method: true
        if is_method
        {
            let return_type AstNode.type_of(node)
            if return_type = null
            {
                if AstNode.body_of(node) <> null
                    return true
            }
            let tps AstNode.type_parameters_of(node)
            let tn AstNode.list_count(tps)
            var i 0
            while i < tn
            {
                let a AstNode.child_in_list(tps, i)
                if a <> null
                {
                    let hit this.contains_type_parameter_reference(tp, a as ref[AstNode])
                    if this.unported_mark() <> mark
                        return true
                    if hit
                        return true
                }
                set i: i + 1
            }
            let params AstNode.parameters_of(node)
            let pn AstNode.list_count(params)
            var j 0
            while j < pn
            {
                let a AstNode.child_in_list(params, j)
                if a <> null
                {
                    let hit this.contains_type_parameter_reference(tp, a as ref[AstNode])
                    if this.unported_mark() <> mark
                        return true
                    if hit
                        return true
                }
                set j: j + 1
            }
            if return_type <> null
                return this.contains_type_parameter_reference(tp, return_type as ref[AstNode])
            return false
        }
        let cn AstNode.child_count(node)
        var i 0
        while i < cn
        {
            let child AstNode.child_at(node, i)
            if child <> null
            {
                let hit this.contains_type_parameter_reference(tp, child as ref[AstNode])
                if this.unported_mark() <> mark
                    return true
                if hit
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; cloneTypeParameter — three lines upstream and three here. The clone carries
    ; the ORIGINAL as its target; the mapper is written by the one caller.
    procedure clone_type_parameter(this, tp: ref[Type]) returns ref[Type]
    {
        let result this.new_type_parameter(tp.symbol)
        Checker.set_type_parameter_target(result, tp)
        result
    }

    ; instantiateAnonymousType. ★The mapped arm mints a FRESH type parameter for
    ; the mapped type's `P` and prepends `{orig -> fresh}` to the mapper, which is
    ; the reference's own `C.f. instantiateSignature` comment: without it two
    ; instantiations of one mapped type share a parameter and the second overwrites
    ; the first's constraint memo.
    procedure instantiate_anonymous_type(this, t: ref[Type], m_in: ref[TypeMapper]?, alias_in: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        var m m_in
        var alias alias_in
        let flags (t.object_flags & ~(ObjectFlagsCouldContainTypeVariablesComputed | ObjectFlagsCouldContainTypeVariables)) | ObjectFlagsInstantiated
        let made this.new_object_type(flags, t.symbol)
        if made = null
            return null
        let result made as ref[Type]
        if (t.object_flags & ObjectFlagsMapped) <> 0
        {
            Checker.set_mapped_declaration(result, Checker.mapped_declaration_of(t))
            let orig this.get_type_parameter_from_mapped_type(t)
            if this.unported_mark() <> mark
                return null
            if orig = null
                return null
            let fresh this.clone_type_parameter(orig as ref[Type])
            Checker.set_mapped_type_parameter(result, fresh)
            set m: this.combine_type_mappers(this.new_simple_type_mapper(orig, fresh) as ref[TypeMapper]?, m)
            Checker.set_type_parameter_mapper(fresh, m)
        }
        ; The reference's SECOND switch arm, and it is the one
        ; getObjectTypeInstantiation reads back: an instantiated
        ; InstantiationExpressionType carries the ORIGINAL's node, because that
        ; node is what the memo and the outer type parameters hang off. Written
        ; as an `else` arm because the reference's is a `switch` — the two kind
        ; bits are exclusive, but the exclusivity is the reference's statement
        ; and not this port's inference.
        else
        {
            if (t.object_flags & ObjectFlagsInstantiationExpressionType) <> 0
                Checker.set_instantiation_expression_node(result, Checker.instantiation_expression_node_of(t))
        }
        if alias = null
        {
            if m <> null
                set alias: this.instantiate_type_alias(t, m as ref[TypeMapper])
            if this.unported_mark() <> mark
                return null
        }
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set result.alias_symbol: al.symbol
            set result.alias_type_arguments: al.type_arguments
            var argn 0
            if al.type_arguments <> null
                set argn: (al.type_arguments as ref[Array[ref[Type]?]]).get_length() as int
            if argn <> 0
                set result.object_flags: (result.object_flags | Checker.get_propagating_flags_of_types(al.type_arguments, TypeFlagsNone)) as u32
        }
        Checker.set_object_target_and_mapper(result, t, m)
        result
    }

    ; ── the map-over-a-union family (slice 125) ─────────────────────────────
    ;
    ; mapType / mapTypeEx / mapTypeWithAlias, with the func value replaced by the
    ; TAG + captures of §3.18 (see MapTypeArgs' header for the three callers).

    procedure apply_map_type_kind(this, mk: int, a: ref[MapTypeArgs]?, t: ref[Type]) returns ref[Type]?
    {
        if mk = MapTypeKindLowerBoundOfKeyType
            return this.get_lower_bound_of_key_type(t)
        if mk = MapTypeKindNarrowByTypeFacts
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            if args.mapped = null
                return null
            return this.narrow_one_by_type_facts(t, args.mapped as ref[Type], args.index)
        }
        if mk = MapTypeKindPickMoreSpecific
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            if args.mapped = null
                return null
            return this.pick_more_specific(t, args.mapped as ref[Type], args.for_constraint)
        }
        if mk = MapTypeKindIntersectIfGeneric
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            if args.mapped = null
                return null
            return this.intersect_if_generic(t, args.mapped as ref[Type], args.for_constraint)
        }
        if mk = MapTypeKindBaseTypeForComparison
            return this.get_base_type_of_literal_type_for_comparison(t)
        if mk = MapTypeKindBaseTypeOfLiteral
            return this.get_base_type_of_literal_type(t)
        if mk = MapTypeKindDefinitelyFalsyPart
            return this.get_definitely_falsy_part_of_type(t)
        if mk = MapTypeKindWidenedLiteral
            return this.get_widened_literal_type(t)
        if mk = MapTypeKindEmptyObjectLiteralRemap
        {
            if a = null
                return t
            let args a as ref[MapTypeArgs]
            if args.objlit_node = null
                return t
            if args.objlit_state = null
                return t
            if empty_object_type = null
                return t
            if (t = (empty_object_type as ref[Type])) = false
                return t
            return this.create_object_literal_type(args.objlit_node as ref[AstNode], args.objlit_state as ref[ObjectLiteralState], 6)
        }
        if mk = MapTypeKindThisTypeFromContextual
            return this.this_type_from_contextual_constituent(t)
        if mk = MapTypeKindSpreadLeft
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            if args.spread_other = null
                return null
            return this.get_spread_type(t, args.spread_other as ref[Type], args.spread_symbol, args.spread_object_flags, args.spread_readonly)
        }
        if mk = MapTypeKindSpreadRight
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            if args.spread_other = null
                return null
            return this.get_spread_type(args.spread_other as ref[Type], t, args.spread_symbol, args.spread_object_flags, args.spread_readonly)
        }
        if mk = MapTypeKindSimplified
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            return this.get_simplified_type(t, args.simplify_writing)
        }
        if mk = MapTypeKindStringMapping
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            if args.string_mapping_symbol = null
                return null
            return this.get_string_mapping_type(args.string_mapping_symbol as ref[Symbol], t)
        }
        if mk = MapTypeKindConstraintFilter
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            if args.filter_constraint = null
                return null
            if this.compare_types_by_comparer(args.filter_comparer, t, args.filter_constraint as ref[Type])
                return t
            return never_type
        }
        if mk = MapTypeKindInstantiationExpression
        {
            if a = null
                return t
            let args a as ref[MapTypeArgs]
            if args.inst_expr_node = null
                return t
            if args.inst_expr_state = null
                return t
            return this.get_instantiated_expression_type(t, args.inst_expr_node as ref[AstNode], args.inst_expr_state as ref[InstantiationExpressionState])
        }
        if mk = MapTypeKindJsxChildElement
        {
            if a = null
                return t
            let args a as ref[MapTypeArgs]
            if this.is_array_like_type(t) = false
                return t
            return this.get_indexed_access_type(t, this.get_number_literal_type(jsnum_from_int(args.index)))
        }
        if mk = MapTypeKindContextualIndexInfoValue
        {
            if a = null
                return null
            let args a as ref[MapTypeArgs]
            if args.key_name_type = null
                return null
            let mark this.unported_mark()
            let infos this.get_index_infos_of_structured_type(t)
            if this.unported_mark() <> mark
                return null
            let info this.find_applicable_index_info(infos, args.key_name_type as ref[Type])
            if info = null
                return null
            return (info as ref[IndexInfo]).value_type
        }
        if mk = MapTypeKindBaseConstraintOrType
            return this.get_base_constraint_or_type(t)
        if mk = MapTypeKindMutableArrayOrTuple
            return this.get_mutable_array_or_tuple_type(t)
        if mk = MapTypeKindTupleElementOutOfStartCount
        {
            if a = null
                return null
            let ta a as ref[MapTypeArgs]
            let rest this.get_rest_type_of_tuple_type(t)
            if rest = null
                return undefined_type
            if ta.undefined_like = null
                return rest
            ; ★★★ THE COUNT IS THE TARGET'S (§3.5he) — the reference writes
            ; `getTotalFixedElementCount(t.TargetTupleType())`, and asking `t`
            ; made the total 0, so `index >= 0` held for every index and the
            ; `| undefined` was added to every element of every tuple that has
            ; one. Fixed slice 176.
            let total Checker.get_total_fixed_element_count_of(t)
            if jsnum_at_least(ta.start_index, jsnum_from_int(total)) = false
                return rest
            let pair &Array[ref[Type]?]()
            pair.add(rest)
            pair.add(ta.undefined_like)
            return this.get_union_type(pair)
        }
        if mk = MapTypeKindContextualElement
        {
            if a = null
                return null
            let ea a as ref[MapTypeArgs]
            return this.contextual_type_of_element_constituent(t, ea.element_index, ea.element_length, ea.first_spread_index, ea.last_spread_index)
        }
        if a = null
            return null
        let args a as ref[MapTypeArgs]
        ; getRestType's own recursion over the union's constituents (slice 145).
        if mk = MapTypeKindRestType
            return this.get_rest_type(t, args.rest_properties, args.rest_symbol)
        ; sliceTupleType at the captured element index, end skip count 0.
        if mk = MapTypeKindSliceTuple
            return this.slice_tuple_type(t, args.index, 0)
        if mk = MapTypeKindMappedConstituent
            return this.instantiate_mapped_constituent(args, t)
        if mk = MapTypeKindConditionalDistribution
        {
            if args.root = null
                return null
            let m this.prepend_type_mapping(args.check_type, t, args.mapper)
            return this.get_conditional_type(args.root as ref[ConditionalRoot], m, args.for_constraint, null)
        }
        ; getTemplateLiteralType's own distribution — core.ReplaceElement at the
        ; captured index, then the whole thing again.
        if mk = MapTypeKindTemplateLiteralSpan
        {
            if args.texts = null
                return null
            if args.types = null
                return null
            let tx args.texts as ref[Array[ref[String]?]]
            let ty args.types as ref[Array[ref[Type]?]]
            let repl this.new_type_list(null)
            let n ty.get_length() as int
            var i 0
            while i < n
            {
                if i = args.index
                    repl.add(t)
                else
                    repl.add(ty[i])
                set i: i + 1
            }
            return this.get_template_literal_type(tx, repl)
        }
        ; createNormalizedTupleTypeEx's own distribution — core.ReplaceElement at
        ; the captured variadic slot, then the same entry point again. ★The
        ; recursion terminates because the replacement is ONE constituent of the
        ; union that made the slot distributable, so the arm that sends us here
        ; cannot fire for it a second time.
        if mk = MapTypeKindNormalizedTupleVariadic
        {
            if args.tuple_target = null
                return null
            if args.tuple_element_types = null
                return null
            let src args.tuple_element_types as ref[Array[ref[Type]?]]
            let repl2 this.new_type_list(null)
            let n2 src.get_length() as int
            var i2 0
            while i2 < n2
            {
                if i2 = args.tuple_variadic_index
                    repl2.add(t)
                else
                    repl2.add(src[i2])
                set i2: i2 + 1
            }
            return this.create_normalized_tuple_type_ex(args.tuple_target as ref[Type], repl2, args.tuple_object_flags)
        }
        null
    }

    ; getTupleElementTypeOutOfStartCount — the answer for a NUMERIC name against a
    ; tuple, distributed over the union the way the reference's mapType does.
    ; ★The `undefinedLikeType != nil` term is what the IncludeUndefined access
    ; flag becomes, so a nullable capture is the honest carrier and not a bool.
    procedure get_tuple_element_type_out_of_start_count(this, t: ref[Type], index: u64, undefined_like: ref[Type]?) returns ref[Type]?
    {
        var a_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, 0, 0, 0, 0, index, undefined_like, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
        let a &a_value as ref[MapTypeArgs]?
        this.map_type(t, MapTypeKindTupleElementOutOfStartCount, a)
    }

    procedure map_type(this, t: ref[Type], mk: int, a: ref[MapTypeArgs]?) returns ref[Type]?
        this.map_type_ex(t, mk, a, false)

    procedure map_type_ex(this, t: ref[Type], mk: int, a: ref[MapTypeArgs]?, no_reductions: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & TypeFlagsUnion) = 0
            return this.apply_map_type_kind(mk, a, t)
        var types Checker.union_types_of(t)
        let origin Checker.union_origin_of(t)
        if origin <> null
        {
            if ((origin as ref[Type]).flags & TypeFlagsUnion) <> 0
                set types: Checker.union_types_of(origin as ref[Type])
        }
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let out &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let sopt list[i]
            if sopt <> null
            {
                let sv sopt as ref[Type]
                var mapped: ref[Type]? null
                if (sv.flags & TypeFlagsUnion) <> 0
                    set mapped: this.map_type_ex(sv, mk, a, no_reductions)
                if (sv.flags & TypeFlagsUnion) = 0
                    set mapped: this.apply_map_type_kind(mk, a, sv)
                if this.unported_mark() <> mark
                    return null
                if mapped <> sopt
                    set changed: true
                if mapped <> null
                    out.add(mapped)
            }
            set i: i + 1
        }
        if changed = false
            return t
        if (out.get_length() as int) = 0
            return null
        var reduction UnionReductionLiteral
        if no_reductions
            set reduction: UnionReductionNone
        this.get_union_type_ex(out, reduction, null, null)
    }

    ; mapTypeWithAlias. ★The alias fork maps the constituents WITHOUT the
    ; per-constituent union recursion mapTypeEx does, which is the reference's own
    ; shape: an alias names the whole union, so the result must be one union
    ; carrying it rather than a tree of anonymous ones.
    procedure map_type_with_alias(this, t: ref[Type], mk: int, a: ref[MapTypeArgs]?, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            if alias <> null
            {
                let mark this.unported_mark()
                let types Checker.union_types_of(t)
                if types = null
                    return t
                let list types as ref[Array[ref[Type]?]]
                let n list.get_length() as int
                let out &Array[ref[Type]?]()
                var i 0
                while i < n
                {
                    let sopt list[i]
                    if sopt <> null
                    {
                        let mapped this.apply_map_type_kind(mk, a, sopt as ref[Type])
                        if this.unported_mark() <> mark
                            return null
                        out.add(mapped)
                    }
                    set i: i + 1
                }
                return this.get_union_type_ex(out, UnionReductionLiteral, alias, null)
            }
        }
        this.map_type_ex(t, mk, a, false)
    }

    ; ── the conditional type's instantiation (slice 125) ────────────────────

    procedure find_conditional_instantiation(root: ref[ConditionalRoot], args: ref[Array[ref[Type]?]]?, alias: ref[TypeAlias]?, for_constraint: bool) returns ref[Type]?
    {
        if root.instantiations = null
            return null
        let rows root.instantiations as ref[Array[ref[ConditionalInstantiation]?]]
        var asym: ref[Symbol]? null
        var aargs: ref[Array[ref[Type]?]]? null
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set asym: al.symbol
            set aargs: al.type_arguments
        }
        let h Checker.type_list_hash(args)
        let n rows.get_length() as int
        if root.instantiation_chain = null
            set root.instantiation_chain: HashChain.create(Page.get(rows))
        let chain root.instantiation_chain as ref[HashChain]
        while chain.count() < n
        {
            let pending rows[chain.count() as size_t]
            if pending = null
                chain.add_blank()
            else
                chain.add((pending as ref[ConditionalInstantiation]).hash)
        }
        var i chain.first(h)
        while i >= 0
        {
            let row rows[i as size_t]
            if row <> null
            {
                let r row as ref[ConditionalInstantiation]
                if r.hash = h
                {
                    if r.for_constraint = for_constraint
                    {
                        if r.alias_symbol = asym
                        {
                            if Checker.type_lists_equal(r.arguments, args)
                            {
                                if Checker.type_lists_equal(r.alias_type_arguments, aargs)
                                    return r.instantiated
                            }
                        }
                    }
                }
            }
            set i: chain.after(i)
        }
        null
    }

    procedure add_conditional_instantiation(this, root: ref[ConditionalRoot], args: ref[Array[ref[Type]?]]?, alias: ref[TypeAlias]?, for_constraint: bool, t: ref[Type]?)
    {
        if root.instantiations = null
            return
        let rows root.instantiations as ref[Array[ref[ConditionalInstantiation]?]]
        var asym: ref[Symbol]? null
        var aargs: ref[Array[ref[Type]?]]? null
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set asym: al.symbol
            set aargs: al.type_arguments
        }
        let rows_page Page.get(rows)
        let row &ConditionalInstantiation^rows_page(args, asym, aargs, for_constraint, t, Checker.type_list_hash(args))
        rows.add(row)
    }

    ; getConditionalTypeInstantiation. ★★The DISTRIBUTIVE fork is the whole
    ; content: `T extends U ? X : Y` instantiated with `A | B` for a distributive
    ; `T` is `(A extends U ? X : Y) | (B extends U ? X : Y)`, and the union is
    ; built by mapping the check type's constituents rather than by instantiating
    ; the conditional once.
    procedure get_conditional_type_instantiation(this, t: ref[Type], mapper: ref[TypeMapper]?, for_constraint: bool, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        let root_opt Checker.conditional_root_of(t)
        if root_opt = null
            return t
        let root root_opt as ref[ConditionalRoot]
        if root.outer_type_parameters = null
            return t
        let otp root.outer_type_parameters as ref[Array[ref[Type]?]]
        let n otp.get_length() as int
        if n = 0
            return t
        if mapper = null
            return t
        let m mapper as ref[TypeMapper]
        let mark this.unported_mark()
        let type_arguments this.new_type_list(null)
        var i 0
        while i < n
        {
            let mapped this.type_mapper_map(m, otp[i])
            if this.unported_mark() <> mark
                return null
            type_arguments.add(mapped)
            set i: i + 1
        }
        let found Checker.find_conditional_instantiation(root, type_arguments, alias, for_constraint)
        if found <> null
            return found
        let new_mapper this.new_type_mapper(otp, type_arguments)
        let check_type root.check_type
        var distribution_type: ref[Type]? null
        if root.is_distributive
        {
            let mapped this.type_mapper_map(new_mapper, check_type)
            if this.unported_mark() <> mark
                return null
            set distribution_type: this.get_reduced_type_or_self(mapped)
            if this.unported_mark() <> mark
                return null
        }
        var result: ref[Type]? null
        var distribute false
        if distribution_type <> null
        {
            let dt distribution_type as ref[Type]
            if dt <> check_type
            {
                if (dt.flags & (TypeFlagsUnion | TypeFlagsNever)) <> 0
                    set distribute: true
            }
        }
        if distribute
        {
            var a_value MapTypeArgs(null, null, new_mapper as ref[TypeMapper]?, root, check_type, for_constraint, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
            let a &a_value
            set result: this.map_type_with_alias(distribution_type as ref[Type], MapTypeKindConditionalDistribution, a, alias)
        }
        if distribute = false
            set result: this.get_conditional_type(root, new_mapper as ref[TypeMapper]?, for_constraint, alias)
        if this.unported_mark() <> mark
            return null
        if root.instantiations = null
        {
            let seeded &Array[ref[ConditionalInstantiation]?]^host()
            set root.instantiations: seeded
        }
        this.add_conditional_instantiation(root, type_arguments, alias, for_constraint, result)
        result
    }

    ; `c.getReducedType(t)` where the caller wants the type back rather than an
    ; Option — get_reduced_type answers null on a stop, and every arm here treats
    ; *no reduction* as *the type itself*.
    procedure get_reduced_type_or_self(this, t: ref[Type]?) returns ref[Type]?
    {
        if t = null
            return null
        let mark this.unported_mark()
        let reduced this.get_reduced_type(t as ref[Type])
        if this.unported_mark() <> mark
            return null
        if reduced = null
            return t
        reduced
    }

    ; ── the MAPPED TYPE (slice 125) ─────────────────────────────────────────
    ;
    ; `{ [P in K]: T }` and everything hanging off it. The chapter is one graph
    ; and not a list of functions: the four lazily-filled slots feed each other
    ; (the constraint needs the type parameter, the modifiers type needs the
    ; constraint DECLARATION, the template needs the modifiers), the member
    ; resolution reads all four, and the instantiation re-enters the whole thing
    ; through a fresh type parameter.

    ; getTypeFromMappedTypeNode. ★The eager getConstraintTypeFromMappedType at the
    ; tail is the reference's own and its comment says why: it forces the error for
    ; a constraint that references itself through a type alias, at the node rather
    ; than three functions away.
    procedure get_type_from_mapped_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type = null
        {
            let made this.new_object_type(ObjectFlagsMapped, AstNode.symbol_of(node))
            if made = null
                return null
            let t made as ref[Type]
            Checker.set_mapped_declaration(t, node)
            let alias this.get_alias_for_type_node(node)
            if alias <> null
            {
                let al alias as ref[TypeAlias]
                set t.alias_symbol: al.symbol
                set t.alias_type_arguments: al.type_arguments
            }
            set links.resolved_type: t
            let mark this.unported_mark()
            this.get_constraint_type_from_mapped_type(t)
            if this.unported_mark() <> mark
                return null
        }
        links.resolved_type
    }

    ; The four lazily-filled slots, in the reference's own order.

    procedure get_type_parameter_from_mapped_type(this, t: ref[Type]) returns ref[Type]?
    {
        if Checker.mapped_type_parameter_of(t) = null
        {
            let decl Checker.mapped_declaration_of(t)
            if decl = null
                return null
            let tp AstNode.mapped_type_parameter_of(decl as ref[AstNode])
            if tp = null
                return null
            let sym this.get_symbol_of_declaration(tp as ref[AstNode])
            if sym = null
                return null
            let mark this.unported_mark()
            let declared this.get_declared_type_of_type_parameter(sym as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            if declared = null
                return null
            Checker.set_mapped_type_parameter(t, declared)
        }
        Checker.mapped_type_parameter_of(t)
    }

    procedure get_constraint_type_from_mapped_type(this, t: ref[Type]) returns ref[Type]?
    {
        if Checker.mapped_constraint_type_of(t) = null
        {
            let mark this.unported_mark()
            let tp this.get_type_parameter_from_mapped_type(t)
            if this.unported_mark() <> mark
                return null
            var ct: ref[Type]? null
            if tp <> null
            {
                set ct: this.get_constraint_of_type_parameter(tp as ref[Type])
                if this.unported_mark() <> mark
                    return null
            }
            ; `core.OrElse(..., c.errorType)` — an unconstrained `P` in a mapped
            ; type is an error the grammar check reports, and errorType is what
            ; keeps every reader below from having to ask.
            if ct = null
                set ct: error_type
            Checker.set_mapped_constraint_type(t, ct as ref[Type])
        }
        Checker.mapped_constraint_type_of(t)
    }

    procedure get_name_type_from_mapped_type(this, t: ref[Type]) returns ref[Type]?
    {
        let decl Checker.mapped_declaration_of(t)
        if decl = null
            return null
        let nt_node AstNode.mapped_type_name_type_of(decl as ref[AstNode])
        if nt_node = null
            return null
        if Checker.mapped_name_type_of(t) = null
        {
            let mark this.unported_mark()
            let base this.get_type_from_type_node(nt_node as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if base = null
                return null
            let inst this.instantiate_type(base, Checker.mapper_of(t))
            if this.unported_mark() <> mark
                return null
            if inst = null
                return null
            Checker.set_mapped_name_type(t, inst as ref[Type])
        }
        Checker.mapped_name_type_of(t)
    }

    procedure get_template_type_from_mapped_type(this, t: ref[Type]) returns ref[Type]?
    {
        if Checker.mapped_template_type_of(t) = null
        {
            let decl Checker.mapped_declaration_of(t)
            if decl = null
                return null
            let tn AstNode.type_of(decl as ref[AstNode])
            if tn = null
                Checker.set_mapped_template_type(t, error_type)
            else
            {
                let mark this.unported_mark()
                let base this.get_type_from_type_node(tn as ref[AstNode])
                if this.unported_mark() <> mark
                    return null
                if base = null
                    return null
                var include_optional false
                if (Checker.get_mapped_type_modifiers(t) & MappedTypeModifiersIncludeOptional) <> 0
                    set include_optional: true
                let opt this.add_optionality_ex(base as ref[Type], true, include_optional)
                if this.unported_mark() <> mark
                    return null
                if opt = null
                    return null
                let inst this.instantiate_type(opt, Checker.mapper_of(t))
                if this.unported_mark() <> mark
                    return null
                if inst = null
                    return null
                Checker.set_mapped_template_type(t, inst as ref[Type])
            }
        }
        Checker.mapped_template_type_of(t)
    }

    ; getMappedTypeModifiers — a static, because the declaration is all it reads.
    ; The MINUS token is what separates *strip* from *add*.
    function get_mapped_type_modifiers(t: ref[Type]) returns int
    {
        let decl Checker.mapped_declaration_of(t)
        if decl = null
            return 0
        let node decl as ref[AstNode]
        var modifiers 0
        let ro AstNode.mapped_type_readonly_token_of(node)
        if ro <> null
        {
            if AstNode.kind_of(ro as ref[AstNode]) = KindMinusToken
                set modifiers: modifiers | MappedTypeModifiersExcludeReadonly
            else
                set modifiers: modifiers | MappedTypeModifiersIncludeReadonly
        }
        let q AstNode.question_token_of(node)
        if q <> null
        {
            if AstNode.kind_of(q as ref[AstNode]) = KindMinusToken
                set modifiers: modifiers | MappedTypeModifiersExcludeOptional
            else
                set modifiers: modifiers | MappedTypeModifiersIncludeOptional
        }
        modifiers
    }

    ; getModifiedReadonlyState — INCLUDE wins, then EXCLUDE, then the inherited
    ; state.
    function get_modified_readonly_state(state: bool, modifiers: int) returns bool
    {
        if (modifiers & MappedTypeModifiersIncludeReadonly) <> 0
            return true
        if (modifiers & MappedTypeModifiersExcludeReadonly) <> 0
            return false
        state
    }

    function get_constraint_declaration_for_mapped_type(t: ref[Type]) returns ref[AstNode]?
    {
        let decl Checker.mapped_declaration_of(t)
        if decl = null
            return null
        let tp AstNode.mapped_type_parameter_of(decl as ref[AstNode])
        if tp = null
            return null
        AstNode.type_parameter_constraint_of(tp as ref[AstNode])
    }

    ; isMappedTypeWithKeyofConstraintDeclaration. ★★The question is SYNTACTIC on
    ; purpose and the reference's own comment says why: for a non-generic `T` the
    ; logic below eagerly resolves `keyof T` to a literal union, and `T` cannot be
    ; recovered from that type.
    function is_mapped_type_with_keyof_constraint_declaration(t: ref[Type]) returns bool
    {
        let d Checker.get_constraint_declaration_for_mapped_type(t)
        if d = null
            return false
        let node d as ref[AstNode]
        if AstNode.kind_of(node) <> KindTypeOperator
            return false
        AstNode.type_operator_operator_of(node) = KindKeyOfKeyword
    }

    procedure get_mapped_type_name_type_kind(this, t: ref[Type]) returns int
    {
        let mark this.unported_mark()
        let name_type this.get_name_type_from_mapped_type(t)
        if this.unported_mark() <> mark
            return MappedTypeNameTypeKindNone
        if name_type = null
            return MappedTypeNameTypeKindNone
        let tp this.get_type_parameter_from_mapped_type(t)
        if this.unported_mark() <> mark
            return MappedTypeNameTypeKindNone
        if tp = null
            return MappedTypeNameTypeKindRemapping
        if this.is_type_assignable_to(name_type as ref[Type], tp as ref[Type])
            return MappedTypeNameTypeKindFiltering
        MappedTypeNameTypeKindRemapping
    }

    ; getModifiersTypeFromMappedType — the `T` of a `{ [P in keyof T]: X }`.
    procedure get_modifiers_type_from_mapped_type(this, t: ref[Type]) returns ref[Type]?
    {
        if Checker.mapped_modifiers_type_of(t) = null
        {
            let mark this.unported_mark()
            if Checker.is_mapped_type_with_keyof_constraint_declaration(t)
            {
                let cd Checker.get_constraint_declaration_for_mapped_type(t)
                if cd = null
                    return null
                let inner AstNode.type_of(cd as ref[AstNode])
                if inner = null
                    return null
                let base this.get_type_from_type_node(inner as ref[AstNode])
                if this.unported_mark() <> mark
                    return null
                if base = null
                    return null
                let inst this.instantiate_type(base, Checker.mapper_of(t))
                if this.unported_mark() <> mark
                    return null
                if inst = null
                    return null
                Checker.set_mapped_modifiers_type(t, inst as ref[Type])
            }
            if Checker.is_mapped_type_with_keyof_constraint_declaration(t) = false
            {
                ; The DECLARED type of the node — not `t`, which may be an
                ; instantiation whose constraint has already been substituted.
                let decl Checker.mapped_declaration_of(t)
                if decl = null
                    return null
                let declared_type this.get_type_from_mapped_type_node(decl as ref[AstNode])
                if this.unported_mark() <> mark
                    return null
                if declared_type = null
                    return null
                var constraint this.get_constraint_type_from_mapped_type(declared_type as ref[Type])
                if this.unported_mark() <> mark
                    return null
                var extended constraint
                if constraint <> null
                {
                    if ((constraint as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
                    {
                        set extended: this.get_constraint_of_type_parameter(constraint as ref[Type])
                        if this.unported_mark() <> mark
                            return null
                    }
                }
                var made: ref[Type]? unknown_type
                if extended <> null
                {
                    if ((extended as ref[Type]).flags & TypeFlagsIndex) <> 0
                    {
                        let target Checker.index_target_of(extended as ref[Type])
                        let inst this.instantiate_type(target, Checker.mapper_of(t))
                        if this.unported_mark() <> mark
                            return null
                        if inst <> null
                            set made: inst
                    }
                }
                if made = null
                    return null
                Checker.set_mapped_modifiers_type(t, made as ref[Type])
            }
        }
        Checker.mapped_modifiers_type_of(t)
    }

    ; getHomomorphicTypeVariable — the `T` of a `keyof T` constraint, when it is a
    ; type PARAMETER. A mapped type with one is homomorphic: it maps over whatever
    ; T turns out to be, arrays and tuples included.
    procedure get_homomorphic_type_variable(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let ct this.get_constraint_type_from_mapped_type(t)
        if this.unported_mark() <> mark
            return null
        if ct = null
            return null
        let c ct as ref[Type]
        if (c.flags & TypeFlagsIndex) = 0
            return null
        let target Checker.index_target_of(c)
        if target = null
            return null
        let tv this.get_actual_type_variable(target as ref[Type])
        if this.unported_mark() <> mark
            return null
        if tv = null
            return null
        if ((tv as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
            return tv
        null
    }

    procedure get_apparent_type_of_mapped_type(this, t: ref[Type]) returns ref[Type]?
    {
        if Checker.mapped_resolved_apparent_type_of(t) = null
        {
            let mark this.unported_mark()
            let r this.get_resolved_apparent_type_of_mapped_type(t)
            if this.unported_mark() <> mark
                return null
            if r = null
                return null
            Checker.set_mapped_resolved_apparent_type(t, r as ref[Type])
        }
        Checker.mapped_resolved_apparent_type_of(t)
    }

    ; getResolvedApparentTypeOfMappedType. ★★The recursion into the modifiers
    ; type is safe for the reference's own reason: getTypeFromMappedTypeNode
    ; forces the constraint eagerly, which is where a circular one is caught.
    procedure get_resolved_apparent_type_of_mapped_type(this, t: ref[Type]) returns ref[Type]?
    {
        var target t
        let tgt Checker.target_of(t)
        if tgt <> null
            set target: tgt as ref[Type]
        let mark this.unported_mark()
        let type_variable this.get_homomorphic_type_variable(target)
        if this.unported_mark() <> mark
            return null
        if type_variable = null
            return t
        let target_decl Checker.mapped_declaration_of(target)
        if target_decl = null
            return t
        if AstNode.mapped_type_name_type_of(target_decl as ref[AstNode]) <> null
            return t
        let modifiers_type this.get_modifiers_type_from_mapped_type(t)
        if this.unported_mark() <> mark
            return null
        if modifiers_type = null
            return t
        let mt modifiers_type as ref[Type]
        var base_constraint: ref[Type]? null
        if this.is_generic_mapped_type(mt)
        {
            set base_constraint: this.get_apparent_type_of_mapped_type(mt)
            if this.unported_mark() <> mark
                return null
        }
        if this.is_generic_mapped_type(mt) = false
        {
            set base_constraint: this.get_base_constraint_of_type(mt)
            if this.unported_mark() <> mark
                return null
        }
        if base_constraint = null
            return t
        let every this.every_type_is_array_or_tuple_like(base_constraint as ref[Type])
        if this.unported_mark() <> mark
            return null
        if every = false
            return t
        let m this.prepend_type_mapping(type_variable, base_constraint, Checker.mapper_of(t))
        let inst this.instantiate_type(target, m as ref[TypeMapper]?)
        if this.unported_mark() <> mark
            return null
        if inst = null
            return t
        inst
    }

    ; getApparentTypeOfIntersectionType, whole (slice 155).
    ;
    ; ★★★ THE TWO HALVES ARE TWO MEMOS AND NOT ONE, AND THE FORK IS `t ==
    ; thisArgument`. When the intersection IS the `this` argument — the ordinary
    ; case, an intersection asked for its own apparent type — the answer is stored
    ; ON the type, in IntersectionTypeData's third slot. When it is not, upstream
    ; goes to `cachedTypes` under CachedTypeKindApparentType.
    ;
    ; ★★★ AND THAT SECOND KEY IS `thisArgument.id` ALONE — the intersection `t` is
    ; not in it. It reads as a transcription error, and it is written as upstream
    ; wrote it: two different intersections asked with the same `this` argument
    ; would share a row, and the port that "fixes" the key answers a different
    ; program on exactly the input where they disagree. See ApparentTypeLink.
    ;
    ; ★ Both halves call getTypeWithThisArgument with needApparentType TRUE, which
    ; is the only caller in the file that passes true — get_apparent_type's own
    ; reference arm passes false. The recursion terminates because the callee's
    ; intersection arm descends into CONSTITUENTS, and a constituent of an
    ; intersection is not that intersection.
    procedure get_apparent_type_of_intersection_type(this, t: ref[Type], this_argument: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if t = this_argument
        {
            if Checker.intersection_resolved_apparent_type_of(t) = null
            {
                let made this.get_type_with_this_argument(t, this_argument, true)
                if this.unported_mark() <> mark
                    return null
                if made = null
                    return null
                Checker.set_intersection_resolved_apparent_type(t, made)
            }
            return Checker.intersection_resolved_apparent_type_of(t)
        }
        let link this.apparent_type_link_of(this_argument)
        if link.apparent = null
        {
            let made this.get_type_with_this_argument(t, this_argument, true)
            if this.unported_mark() <> mark
                return null
            if made = null
                return null
            set link.apparent: made
        }
        link.apparent
    }

    ; `everyType(baseConstraint, func(t) { return c.isArrayOrTupleType(t) || c.isArrayOrTupleOrIntersection(t) })`
    ; — one predicate loop rather than a func value (§3.5e).
    procedure every_type_is_array_or_tuple_like(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_array_or_tuple_like(t)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let u list[i]
            if u = null
                return false
            if this.is_array_or_tuple_like(u as ref[Type]) = false
                return false
            set i: i + 1
        }
        true
    }

    ; everyType(t, isArrayOrTupleType) and everyType(t, isMutableTupleType) — a
    ; union asks each constituent, anything else asks itself.
    procedure every_type_is_array_or_tuple(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_array_or_tuple_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let u list[i]
            if u = null
                return false
            if this.is_array_or_tuple_type(u as ref[Type]) = false
                return false
            set i: i + 1
        }
        true
    }

    function every_type_is_mutable_tuple(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return Checker.is_mutable_tuple_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let u list[i]
            if u = null
                return false
            if Checker.is_mutable_tuple_type(u as ref[Type]) = false
                return false
            set i: i + 1
        }
        true
    }

    ; isMutableTupleType — a tuple whose target is not readonly.
    function is_mutable_tuple_type(t: ref[Type]) returns bool
    {
        if Checker.is_tuple_type(t) = false
            return false
        let target Checker.target_of(t)
        if target = null
            return false
        Checker.tuple_readonly_of(target as ref[Type]) = false
    }

    procedure is_array_or_tuple_like(this, t: ref[Type]) returns bool
    {
        if this.is_array_or_tuple_type(t)
            return true
        this.is_array_or_tuple_or_intersection(t)
    }

    ; isArrayOrTupleOrIntersection.
    procedure is_array_or_tuple_or_intersection(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsIntersection) = 0
            return false
        let types Checker.intersection_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let u list[i]
            if u = null
                return false
            if this.is_array_or_tuple_type(u as ref[Type]) = false
                return false
            set i: i + 1
        }
        true
    }

    ; hasArrayOrTypeTypeConstraint — `everyType(constraint, c.isArrayOrTupleType)`.
    procedure has_array_or_tuple_type_constraint(this, type_variable: ref[Type]?) returns bool
    {
        if type_variable = null
            return false
        let mark this.unported_mark()
        let constraint this.get_constraint_of_type_parameter(type_variable as ref[Type])
        if this.unported_mark() <> mark
            return false
        if constraint = null
            return false
        let c constraint as ref[Type]
        if (c.flags & TypeFlagsUnion) = 0
            return this.is_array_or_tuple_type(c)
        let types Checker.union_types_of(c)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let u list[i]
            if u = null
                return false
            if this.is_array_or_tuple_type(u as ref[Type]) = false
                return false
            set i: i + 1
        }
        true
    }

    ; ── instantiateMappedType and its three constituent arms ────────────────
    ;
    ; ★★★ THE REFERENCE'S OWN COMMENT IS THE SPECIFICATION and it is worth
    ; keeping: for a homomorphic `{ [P in keyof T]: X }` the mapping DEPENDS on
    ; what T becomes — a primitive maps to itself, a union distributes, an array
    ; maps to an array of transformed elements, a tuple to a tuple, an
    ; intersection of those to an intersection, and anything else to an object
    ; type with each property transformed.
    procedure instantiate_mapped_type(this, t: ref[Type], m: ref[TypeMapper]?, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let type_variable this.get_homomorphic_type_variable(t)
        if this.unported_mark() <> mark
            return null
        if type_variable <> null
        {
            let mapped_type_variable this.instantiate_type(type_variable, m)
            if this.unported_mark() <> mark
                return null
            if type_variable <> mapped_type_variable
            {
                let reduced this.get_reduced_type_or_self(mapped_type_variable)
                if this.unported_mark() <> mark
                    return null
                if reduced = null
                    return null
                var a_value MapTypeArgs(t, type_variable, m, null, null, false, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
                let a &a_value
                return this.map_type_with_alias(reduced as ref[Type], MapTypeKindMappedConstituent, a, alias)
            }
        }
        ; ★★★ SLICE 158 SAYS THE FALL-THROUGH FOR AN ALREADY-INSTANTIATED MAPPED
        ; TYPE, because the answer it gives there is WRONG and was invisible until
        ; the contextual-property chapter routed a real question into it. The shape
        ; is `{ [P in keyof X]: … }` instantiated ONCE with a type that still holds
        ; an outer type variable — `Partial<T extends string ? 1 : 2>` inside a
        ; generic alias — and then instantiated AGAIN when the outer alias is:
        ; `getHomomorphicTypeVariable` no longer finds a type parameter to map, so
        ; this routine instantiates the mapped type anonymously and the reference
        ; answers the mapped type's PRIMITIVE short-circuit instead. Measured in
        ; three lines: `type SF<T> = { args: Partial<T extends string ? 1 : 2> }`
        ; with `SF<number>` answers `2` upstream and the uninstantiated
        ; `Partial<T extends string ? 1 : 2>` here — at rc 0, with a TS2322 the
        ; reference does not have. The mechanism is in the mapped-type chapter, not
        ; in this one; the guard is the OBSERVED shape (an already-instantiated
        ; mapped type reaching the non-homomorphic fall-through) rather than a
        ; guess at the cause.
        ; If the constraint of the instantiation is the wildcard, so is the answer.
        let ct this.get_constraint_type_from_mapped_type(t)
        if this.unported_mark() <> mark
            return null
        let inst_ct this.instantiate_type(ct, m)
        if this.unported_mark() <> mark
            return null
        if inst_ct <> null
        {
            if (inst_ct as ref[Type]) = wildcard_type
                return wildcard_type
        }
        this.instantiate_anonymous_type(t, m, alias)
    }

    ; `instantiateConstituent`, the closure — the ONE arm of apply_map_type_kind
    ; that needs all three of MapTypeArgs' first slots.
    procedure instantiate_mapped_constituent(this, a: ref[MapTypeArgs], s: ref[Type]) returns ref[Type]?
    {
        if a.mapped = null
            return s
        let t a.mapped as ref[Type]
        let mark this.unported_mark()
        if (s.flags & (TypeFlagsAnyOrUnknown | TypeFlagsInstantiableNonPrimitive | TypeFlagsObject | TypeFlagsIntersection)) = 0
            return s
        if s = wildcard_type
            return s
        if this.is_error_type(s)
            return s
        let decl Checker.mapped_declaration_of(t)
        if decl = null
            return s
        if AstNode.mapped_type_name_type_of(decl as ref[AstNode]) = null
        {
            var array_like this.is_array_type(s)
            if array_like = false
            {
                if (s.flags & TypeFlagsAny) <> 0
                {
                    if this.find_resolution_cycle_start_index(null, a.type_variable, null, null, TypeSystemPropertyNameResolvedBaseConstraint) < 0
                    {
                        if this.has_array_or_tuple_type_constraint(a.type_variable)
                            set array_like: true
                    }
                }
            }
            if array_like
            {
                let m this.prepend_type_mapping(a.type_variable, s, a.mapper)
                return this.instantiate_mapped_array_type(s, t, m as ref[TypeMapper]?)
            }
            if Checker.is_tuple_type(s)
                return this.instantiate_mapped_tuple_type(s, t, a.type_variable, a.mapper)
            if this.is_array_or_tuple_or_intersection(s)
            {
                let types Checker.intersection_types_of(s)
                if types = null
                    return s
                let list types as ref[Array[ref[Type]?]]
                let n list.get_length() as int
                let out &Array[ref[Type]?]()
                var i 0
                while i < n
                {
                    let u list[i]
                    if u = null
                        return null
                    let mapped this.instantiate_mapped_constituent(a, u as ref[Type])
                    if this.unported_mark() <> mark
                        return null
                    out.add(mapped)
                    set i: i + 1
                }
                return this.get_intersection_type(out)
            }
        }
        let m this.prepend_type_mapping(a.type_variable, s, a.mapper)
        this.instantiate_anonymous_type(t, m as ref[TypeMapper]?, null)
    }

    procedure instantiate_mapped_array_type(this, array_type: ref[Type], mapped_type: ref[Type], m: ref[TypeMapper]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let element_type this.instantiate_mapped_type_template(mapped_type, number_type, true, m)
        if this.unported_mark() <> mark
            return null
        if element_type = null
            return null
        if this.is_error_type(element_type as ref[Type])
            return error_type
        let readonly Checker.get_modified_readonly_state(this.is_readonly_array_type(array_type), Checker.get_mapped_type_modifiers(mapped_type))
        this.create_array_type_ex(element_type, readonly)
    }

    ; instantiateMappedTupleType. ★★The reference's example is the whole rule:
    ; `Keys<[string, string, ...T, string]>` is `["0", "1", ...Keys<T>, number]` —
    ; the FIXED part gets a per-index string key, a VARIADIC element has the
    ; mapped type applied to it whole, and every other element of the variable
    ; part is wrapped in an array first so that its key type comes out `number`.
    procedure instantiate_mapped_tuple_type(this, tuple_type: ref[Type], mapped_type: ref[Type], type_variable: ref[Type]?, m: ref[TypeMapper]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let target Checker.target_of(tuple_type)
        if target = null
            return null
        let tgt target as ref[Type]
        let element_infos Checker.tuple_element_infos_of(tgt)
        if element_infos = null
            return null
        let infos element_infos as ref[Array[ref[TupleElementInfo]?]]
        let fixed_length Checker.tuple_fixed_length_of(tgt)
        var fixed_mapper m
        if fixed_length <> 0
            set fixed_mapper: this.prepend_type_mapping(type_variable, tuple_type, m) as ref[TypeMapper]?
        let modifiers Checker.get_mapped_type_modifiers(mapped_type)
        let element_types this.get_element_types(tuple_type)
        if element_types = null
            return null
        let els element_types as ref[Array[ref[Type]?]]
        let n els.get_length() as int
        let new_element_types this.new_type_list(null)
        let new_element_infos &Array[ref[TupleElementInfo]?]^host()
        var has_error false
        var i 0
        while i < n
        {
            let info infos[i]
            if info = null
                return null
            let ei info as ref[TupleElementInfo]
            let flags ei.flags
            var mapped: ref[Type]? null
            if i < fixed_length
            {
                var nd Slice[char]()
                set nd: Checker.decimal_name(host, i)
                let key this.get_string_literal_type(nd)
                var optional false
                if (flags & ElementFlagsOptional) <> 0
                    set optional: true
                set mapped: this.instantiate_mapped_type_template(mapped_type, key, optional, fixed_mapper)
                if this.unported_mark() <> mark
                    return null
            }
            if i >= fixed_length
            {
                if (flags & ElementFlagsVariadic) <> 0
                {
                    let mm this.prepend_type_mapping(type_variable, els[i], m)
                    set mapped: this.instantiate_type(mapped_type, mm as ref[TypeMapper]?)
                    if this.unported_mark() <> mark
                        return null
                }
                if (flags & ElementFlagsVariadic) = 0
                {
                    let wrapped this.create_array_type(els[i])
                    if this.unported_mark() <> mark
                        return null
                    let mm this.prepend_type_mapping(type_variable, wrapped, m)
                    let inst this.instantiate_type(mapped_type, mm as ref[TypeMapper]?)
                    if this.unported_mark() <> mark
                        return null
                    if inst = null
                        return null
                    set mapped: this.get_element_type_of_array_type(inst as ref[Type])
                    if this.unported_mark() <> mark
                        return null
                    if mapped = null
                        set mapped: unknown_type
                }
            }
            var new_flags flags
            if (modifiers & MappedTypeModifiersIncludeOptional) <> 0
            {
                if (flags & ElementFlagsRequired) <> 0
                    set new_flags: ElementFlagsOptional
            }
            if (modifiers & MappedTypeModifiersIncludeOptional) = 0
            {
                if (modifiers & MappedTypeModifiersExcludeOptional) <> 0
                {
                    if (flags & ElementFlagsOptional) <> 0
                        set new_flags: ElementFlagsRequired
                }
            }
            new_element_infos.add(&TupleElementInfo^host(new_flags, ei.labeled_declaration))
            if mapped <> null
            {
                if (mapped as ref[Type]) = error_type
                    set has_error: true
            }
            new_element_types.add(mapped)
            set i: i + 1
        }
        if has_error
            return error_type
        let new_readonly Checker.get_modified_readonly_state(Checker.tuple_readonly_of(tgt), modifiers)
        this.create_tuple_type_ex(new_element_types, new_element_infos, new_readonly)
    }

    ; instantiateMappedTypeTemplate — the template type at ONE key.
    procedure instantiate_mapped_type_template(this, t: ref[Type], key: ref[Type], is_optional: bool, m: ref[TypeMapper]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let tp this.get_type_parameter_from_mapped_type(t)
        if this.unported_mark() <> mark
            return null
        let template_mapper this.append_type_mapping(m, tp, key)
        var source t
        let tgt Checker.target_of(t)
        if tgt <> null
            set source: tgt as ref[Type]
        let template this.get_template_type_from_mapped_type(source)
        if this.unported_mark() <> mark
            return null
        let prop_type this.instantiate_type(template, template_mapper as ref[TypeMapper]?)
        if this.unported_mark() <> mark
            return null
        if prop_type = null
            return null
        let pt prop_type as ref[Type]
        let modifiers Checker.get_mapped_type_modifiers(t)
        if Checker.strict_null_checks()
        {
            if (modifiers & MappedTypeModifiersIncludeOptional) <> 0
            {
                if Checker.maybe_type_of_kind(pt, TypeFlagsUndefined | TypeFlagsVoid) = false
                    return this.get_optional_type(pt, true)
            }
            if (modifiers & MappedTypeModifiersExcludeOptional) <> 0
            {
                if is_optional
                    return this.get_type_with_facts(pt, TypeFactsNEUndefined)
            }
        }
        prop_type
    }

    ; ── resolveMappedTypeMembers and its two closures (slice 125) ───────────
    ;
    ; ★★★ THE PROPERTIES ARE SYNTHESIZED, NOT FOUND, which is what makes this the
    ; centre of the chapter: for each key in the constraint a fresh symbol is
    ; minted, its optionality and readonly-ness computed from the mapped type's
    ; modifiers AND from the modifiers type's own property, and its TYPE left
    ; lazy — get_type_of_mapped_symbol instantiates the template at that key when
    ; someone asks.
    procedure resolve_mapped_type_members(this, t: ref[Type])
    {
        let mark this.unported_mark()
        let members SymbolTable.create(host)
        let index_infos this.new_index_info_list()
        ; Resolved upfront so that a recursive reference sees an empty object type.
        this.set_structured_type_members(t, null, null, null, null)
        let type_parameter this.get_type_parameter_from_mapped_type(t)
        if this.unported_mark() <> mark
            return
        let constraint_type this.get_constraint_type_from_mapped_type(t)
        if this.unported_mark() <> mark
            return
        var mapped_type t
        let tgt Checker.target_of(t)
        if tgt <> null
            set mapped_type: tgt as ref[Type]
        let name_type this.get_name_type_from_mapped_type(mapped_type)
        if this.unported_mark() <> mark
            return
        let kind this.get_mapped_type_name_type_kind(mapped_type)
        if this.unported_mark() <> mark
            return
        var should_link true
        if kind = MappedTypeNameTypeKindRemapping
            set should_link: false
        let template_type this.get_template_type_from_mapped_type(mapped_type)
        if this.unported_mark() <> mark
            return
        ; ★★★ SLICE 136 — THE FOUR SILENT RETURNS OF THIS FUNCTION WERE WRONG
        ; ANSWERS, NOT MISSING ONES, AND THE SHAPE IS §3.5fp's OWN: *a `null` no stop
        ; accompanies is not the reference's own `nil`*. Every route out of here that
        ; leaves `members` empty publishes a mapped type WITH NO PROPERTIES, and the
        ; next property access on it reports TS2339 — a diagnostic the reference does
        ; not have, at rc 0, with nothing on any frontier to say a chapter is owed.
