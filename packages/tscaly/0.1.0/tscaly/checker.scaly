        ; whichever way the fact goes, which is the reference's own order and is
        ; where their TS2364 comes from.
        if Checker.is_logical_or_coalescing_operator(op_kind)
        {
            if op_kind = KindQuestionQuestionToken
                this.check_nullish_coalesce_operands(left, right)
            var result: ref[Type]? left_type
            if left_type <> null
            {
                let fact Checker.logical_operator_fact(op_kind)
                let mark this.unported_mark()
                let asked this.has_type_facts(left_type as ref[Type], fact)
                if this.unported_mark() <> mark
                    set result: null
                else
                {
                    if asked
                    {
                        ; ★★★ THE THREE ANSWERS, LIVE SINCE SLICE 135. The row the
                        ; stop here carried was tagged `filter-type` by slice 94,
                        ; on the reasoning that all three are filterType over the
                        ; constituents with getUnionType at the tail. That was the
                        ; right chapter and it is now in the file: `&&` extracts
                        ; the definitely-falsy PART of the left type, `||` removes
                        ; it and then strips nullability, `??` strips nullability
                        ; alone — and the last two reduce under SUBTYPE, not
                        ; literal.
                        ;
                        ; ★ `&&`'s operand is the LEFT type under strictNullChecks
                        ; and the right type's BASE otherwise; the harness sets
                        ; strict, so the conditional is written with the option
                        ; spelled as a constant the way create_widening_type is.
                        let lt left_type as ref[Type]
                        if op_kind = KindQuestionQuestionToken
                            set result: this.union_of_non_nullable_and_right(lt, right_type)
                        else
                        {
                            if op_kind = KindQuestionQuestionEqualsToken
                                set result: this.union_of_non_nullable_and_right(lt, right_type)
                            else
                            {
                                if Checker.is_logical_and_operator(op_kind)
                                {
                                    var operand: ref[Type]? lt
                                    if Checker.strict_null_checks() = false
                                    {
                                        if right_type = null
                                            set operand: null
                                        else
                                            set operand: this.get_base_type_of_literal_type(right_type as ref[Type])
                                    }
                                    if operand = null
                                        set result: null
                                    else
                                    {
                                        let falsy this.extract_definitely_falsy_types(operand as ref[Type])
                                        if this.unported_mark() <> mark
                                            set result: null
                                        else
                                        {
                                            if falsy = null
                                                set result: null
                                            else
                                            {
                                                let pair &Array[ref[Type]?]()
                                                pair.add(falsy)
                                                pair.add(right_type)
                                                set result: this.get_union_type(pair)
                                                if this.unported_mark() <> mark
                                                    set result: null
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    ; `||` and `||=`.
                                    let truthy this.remove_definitely_falsy_types(lt)
                                    if this.unported_mark() <> mark
                                        set result: null
                                    else
                                    {
                                        if truthy = null
                                            set result: null
                                        else
                                            set result: this.union_of_non_nullable_and_right(truthy as ref[Type], right_type)
                                    }
                                }
                            }
                        }
                        if this.unported_mark() <> mark
                            set result: null
                    }
                }
            }
            if Binder.is_logical_or_coalescing_assignment_operator(op_kind)
                this.check_assignment_operator(left, op_kind, right, left_type, right_type)
            return result
        }

        ; ★★★ THE ASSIGNMENT, WHICH IS TWO THIRDS OF THE ROW. It answers the RIGHT
        ; operand's type — the reference's `return rightType` — so a unit whose
        ; right side this port can type walks on past the assignment even when its
        ; left side stopped.
        if op_kind = KindEqualsToken
        {
            this.check_assignment_operator(left, op_kind, right, left_type, right_type)
            return right_type
        }

        ; The comma operator, whole. Its report is the last thing in this chapter
        ; that needs neither a type nor a table.
        if op_kind = KindCommaToken
        {
            this.check_comma_operand(left)
            return right_type
        }

        ; The reference PANICS here ("Unhandled case in checkBinaryLikeExpression").
        ; A report rather than a trap, for the reason the JsxOpeningElement arm
        ; above gives: this port holds an unreachability claim as a row.
        this.record_unported("check-binary-like-expression-unhandled", op_kind)
        null
    }

    ; `ast.IsParenthesizedExpression(parent) || ast.IsLogicalOrCoalescingBinary
    ; Expression(parent)`, the pre-pass walk's loop condition.
    function is_parenthesis_or_logical_chain(n: ref[AstNode]?) returns bool
    {
        let k Checker.kind_or_unknown(n)
        if k = KindParenthesizedExpression
            return true
        if k <> KindBinaryExpression
            return false
        Binder.is_logical_or_coalescing_binary_operator(AstNode.binary_operator_kind(n))
    }

    ; `leftType == c.silentNeverType || rightType == c.silentNeverType`.
    ;
    ; ★ A nil operand type cannot BE silentNeverType — nothing answers that type
    ; but the arms that return it — so a nil answers false here, which is the
    ; conservative direction: it lets the arm fall through to its own stop instead
    ; of claiming an answer.
    function either_is(a: ref[Type]?, b: ref[Type]?, t: ref[Type]) returns bool
    {
        if a <> null
        {
            if (a as ref[Type]) = t
                return true
        }
        if b <> null
        {
            if (b as ref[Type]) = t
                return true
        }
        false
    }

    ; The switch's four operator GROUPS, as four predicates. They are written out
    ; rather than derived from the Kind ranges because the reference's `case`
    ; labels are not contiguous runs: the arithmetic group interleaves each
    ; operator with its compound assignment, and `+`/`+=` sit in a group of their
    ; own between them.
    function is_arithmetic_or_bitwise_operator(k: int) returns bool
    {
        if k = KindAsteriskToken
            return true
        if k = KindAsteriskAsteriskToken
            return true
        if k = KindAsteriskEqualsToken
            return true
        if k = KindAsteriskAsteriskEqualsToken
            return true
        if k = KindSlashToken
            return true
        if k = KindSlashEqualsToken
            return true
        if k = KindPercentToken
            return true
        if k = KindPercentEqualsToken
            return true
        if k = KindMinusToken
            return true
        if k = KindMinusEqualsToken
            return true
        if k = KindLessThanLessThanToken
            return true
        if k = KindLessThanLessThanEqualsToken
            return true
        if k = KindGreaterThanGreaterThanToken
            return true
        if k = KindGreaterThanGreaterThanEqualsToken
            return true
        if k = KindGreaterThanGreaterThanGreaterThanToken
            return true
        if k = KindGreaterThanGreaterThanGreaterThanEqualsToken
            return true
        if k = KindBarToken
            return true
        if k = KindBarEqualsToken
            return true
        if k = KindCaretToken
            return true
        if k = KindCaretEqualsToken
            return true
        if k = KindAmpersandToken
            return true
        k = KindAmpersandEqualsToken
    }

    ; The arithmetic arm's shift switch (slice 102) — the six operators whose tail
    ; asks the CONSTANT EVALUATOR. It is not `isShiftOperator` upstream, which
    ; names the three non-assigning ones only; the switch lists all six, so the
    ; predicate does too and carries the arm's name rather than the reference's.
    function is_shift_operator(k: int) returns bool
    {
        if k = KindLessThanLessThanToken
            return true
        if k = KindLessThanLessThanEqualsToken
            return true
        if k = KindGreaterThanGreaterThanToken
            return true
        if k = KindGreaterThanGreaterThanEqualsToken
            return true
        if k = KindGreaterThanGreaterThanGreaterThanToken
            return true
        k = KindGreaterThanGreaterThanGreaterThanEqualsToken
    }

    ; isShiftOperator / isShiftOperatorOrHigher — the reference's five-function
    ; ladder (exponentiation, multiplicative, additive, shift) flattened into the
    ; one predicate that has a reader here, §3.5u's reading of a chain whose links
    ; differ only in which kinds they add.
    function is_shift_operator_or_higher(k: int) returns bool
    {
        if k = KindLessThanLessThanToken
            return true
        if k = KindGreaterThanGreaterThanToken
            return true
        if k = KindGreaterThanGreaterThanGreaterThanToken
            return true
        if k = KindPlusToken
            return true
        if k = KindMinusToken
            return true
        if k = KindAsteriskAsteriskToken
            return true
        if k = KindAsteriskToken
            return true
        if k = KindSlashToken
            return true
        k = KindPercentToken
    }

    ; ast.IsAssignmentExpression(node, excludeCompoundAssignment: true) — the one
    ; polarity this port has a caller for.
    function is_assignment_expression_excluding_compound(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindBinaryExpression
            return false
        if AstNode.binary_operator_kind(node) <> KindEqualsToken
            return false
        Parser.is_left_hand_side_expression_kind(Checker.kind_or_unknown(AstNode.binary_left_of(node)))
    }

    function is_plus_operator(k: int) returns bool
    {
        if k = KindPlusToken
            return true
        k = KindPlusEqualsToken
    }

    function is_relational_operator(k: int) returns bool
    {
        if k = KindLessThanToken
            return true
        if k = KindGreaterThanToken
            return true
        if k = KindLessThanEqualsToken
            return true
        k = KindGreaterThanEqualsToken
    }

    function is_equality_operator(k: int) returns bool
    {
        if k = KindEqualsEqualsToken
            return true
        if k = KindExclamationEqualsToken
            return true
        if k = KindEqualsEqualsEqualsToken
            return true
        k = KindExclamationEqualsEqualsToken
    }

    ; The six that produce a UNION: the three operators and their three compound
    ; assignments. It is not ast.IsLogicalOrCoalescingBinaryOperator — that one is
    ; the pre-pass's question and excludes the compound spellings.
    function is_logical_or_coalescing_operator(k: int) returns bool
    {
        if Binder.is_logical_or_coalescing_binary_operator(k)
            return true
        Binder.is_logical_or_coalescing_assignment_operator(k)
    }

    ; Whether the kind is `&&` or `&&=` — the one of the three logical groups whose
    ; answer is built from the LEFT operand's definitely-falsy part.
    function is_logical_and_operator(k: int) returns bool
    {
        if k = KindAmpersandAmpersandToken
            return true
        k = KindAmpersandAmpersandEqualsToken
    }

    ; The FACT each of the six logical spellings asks its left operand for. It is
    ; not a function upstream — the three switch arms name their own constant — and
    ; it is one here because this port asks the question from ONE arm, which is the
    ; §3.5u reading of a Go switch whose arms differ in a single value.
    ;
    ; ★ There is no default: the caller has already established
    ; is_logical_or_coalescing_operator, so the six kinds are the whole domain, and
    ; the tail is `??`'s value rather than a sentinel.
    function logical_operator_fact(k: int) returns int
    {
        if k = KindAmpersandAmpersandToken
            return TypeFactsTruthy
        if k = KindAmpersandAmpersandEqualsToken
            return TypeFactsTruthy
        if k = KindBarBarToken
            return TypeFactsFalsy
        if k = KindBarBarEqualsToken
            return TypeFactsFalsy
        TypeFactsEQUndefinedOrNull
    }

    ; getSuggestedBooleanOperator, whole. `KindUnknown` is the reference's own
    ; not-a-suggestion answer and the caller tests for it.
    function get_suggested_boolean_operator(k: int) returns int
    {
        if k = KindBarToken
            return KindBarBarToken
        if k = KindBarEqualsToken
            return KindBarBarToken
        if k = KindCaretToken
            return KindExclamationEqualsEqualsToken
        if k = KindCaretEqualsToken
            return KindExclamationEqualsEqualsToken
        if k = KindAmpersandToken
            return KindAmpersandAmpersandToken
        if k = KindAmpersandEqualsToken
            return KindAmpersandAmpersandToken
        KindUnknown
    }

    ; isLiteralExpressionOfObject, whole — five kinds and no type.
    function is_literal_expression_of_object(n: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(n)
        if k = KindObjectLiteralExpression
            return true
        if k = KindArrayLiteralExpression
            return true
        if k = KindRegularExpressionLiteral
            return true
        if k = KindFunctionExpression
            return true
        k = KindClassExpression
    }

    ; checkForDisallowedESSymbolOperand, whole, and it answers TRUE when there was
    ; NO error — the reference's own comment says so, and reading the bool the
    ; other way round inverts three arms at once.
    ;
    ; ★★ A nil OPERAND TYPE IS NOT AN OPERAND OF SYMBOL TYPE, so a nil is skipped
    ; and the function answers *no error* — the losing direction. The alternative
    ; would be reporting TS2469 for an operand this port has not typed, which is
    ; the one thing diagcheck's subsequence relation fails on.
    procedure check_for_disallowed_es_symbol_operand(this, left: ref[AstNode], right: ref[AstNode], left_type: ref[Type]?, right_type: ref[Type]?, op_kind: int) returns bool
    {
        var offending: ref[AstNode]? null
        if this.maybe_type_of_kind_considering_base_constraint(left_type, TypeFlagsESSymbolLike)
            set offending: left
        if offending = null
        {
            if this.maybe_type_of_kind_considering_base_constraint(right_type, TypeFlagsESSymbolLike)
                set offending: right
        }
        if offending = null
            return true
        this.error_on_node(offending as ref[AstNode], DiagThe_0_operator_cannot_be_applied_to_type_symbol, Checker.arg_text(Scanner.token_to_string(op_kind)))
        false
    }

    ; maybeTypeOfKindConsideringBaseConstraint, with getBaseConstraintOrType
    ; inlined (`core.OrElse(getBaseConstraintOfType(t), t)`).
    ;
    ; ★★ A STOP UNDERNEATH getBaseConstraintOfType IS NOT "no constraint", and the
    ; mark is what tells them apart: OrElse would read a stop's nil as the type
    ; itself and then answer a question it has no answer to. On a stop this
    ; answers FALSE — the same losing direction the nil operand takes.
    procedure maybe_type_of_kind_considering_base_constraint(this, t: ref[Type]?, kind: int) returns bool
    {
        if t = null
            return false
        let ty t as ref[Type]
        if Checker.maybe_type_of_kind(ty, kind)
            return true
        let mark this.unported_mark()
        let base this.get_base_constraint_of_type(ty)
        if this.unported_mark() <> mark
            return false
        if base = null
            return Checker.maybe_type_of_kind(ty, kind)
        Checker.maybe_type_of_kind(base as ref[Type], kind)
    }

    ; checkNaNEquality — LIVE SINCE SLICE 135.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE WAS AN EXPIRED CONTAINMENT PROOF, AND IT IS THE
    ; SAME SHAPE AS THE FOUR SLICES 131–133 HARVESTED. It read: *"isGlobalNaN is a
    ; lookup in the GLOBALS TABLE (§3.11) that this port does not have — so the
    ; left half is nil and the conjunction is false for every input"*, and it went
    ; on to argue that a stop would be worse than the silence. Both halves were
    ; right when they were written. The table arrived in slice 104, `lookup_globals`
    ; has been three lines away ever since, and nothing pointed at this sentence:
    ; the cost was SEVENTEEN diagnostics missing from one unit (nanEquality), which
    ; is a FAIL and not a row on any frontier.
    ;
    ; ★ The SUGGESTION half — `!Number.isNaN(x)` as related information — is not
    ; built: the reference attaches it to the diagnostic it just made, and a
    ; related-info list is a dimension this port's diagnostic record does not have.
    ; It carries no code and no span of its own, so no yardstick can see it.
    procedure check_na_n_equality(this, error_node: ref[AstNode]?, op_kind: int, left: ref[AstNode], right: ref[AstNode])
    {
        let is_left this.is_global_na_n(left)
        let is_right this.is_global_na_n(right)
        var any_na_n false
        if is_left
            set any_na_n: true
        if is_right
            set any_na_n: true
        if any_na_n
        {
            let nan_mark this.diagnostic_mark()
            if (op_kind = KindEqualsEqualsEqualsToken) or (op_kind = KindEqualsEqualsToken)
                this.error_on_node_or_null(error_node, DiagThis_condition_will_always_return_0, "false")
            else
                this.error_on_node_or_null(error_node, DiagThis_condition_will_always_return_0, "true")
            if is_left and is_right
                return
            ; the `Number.isNaN` suggestion on the other operand
            var suggestion StringBuilder()
            if (op_kind = KindExclamationEqualsEqualsToken) or (op_kind = KindExclamationEqualsToken)
                suggestion.append("!")
            suggestion.append("Number.isNaN(")
            var location left
            if is_left
                set location: right
            let expression Checker.skip_parentheses(location)
            var entity StringBuilder()
            if Checker.is_entity_name_expression(expression) and this.write_entity_name(expression, &entity)
                suggestion.append(entity.to_string())
            else
                suggestion.append("...")
            suggestion.append(")")
            this.related_info_since(nan_mark, location, DiagDid_you_mean_0, suggestion.to_string())
        }
    }

    ; isGlobalNaN. ★getGlobalNaNSymbolOrNil is `getGlobalSymbol("NaN", Value, nil)`
    ; = `resolveName(nil, …)`, and a nil location resolves in the GLOBALS table —
    ; which is what lookup_globals is.
    procedure is_global_na_n(this, expr: ref[AstNode]) returns bool
    {
        let e Parser.skip_parentheses(expr)
        if Checker.kind_or_unknown(e) <> KindIdentifier
            return false
        let nm Slice[char](3, "NaN")
        let global this.lookup_globals(nm, SymbolFlagsValue)
        if global = null
            return false
        let resolved this.get_resolved_symbol(e as ref[AstNode])
        (global as ref[Symbol]) = resolved
    }

    ; checkAssignmentOperator, and it is reached from FOUR of the switch's arms
    ; (the arithmetic group's tail, `+=`, the three logical compounds and `=`) of
    ; which this slice's prefix reaches two.
    ;
    ; ★★★ THE CommonJS GUARD IS A STOP AND NOT A SKIPPED STEP, because it decides
    ; whether TS2364 is reported at all. Its third conjunct is
    ; `c.symbolNodeLinks.Get(left).resolvedSymbol` — a links table this port does
    ; not have — so on a `module.exports`-shaped left side the port cannot tell the
    ; guard's two answers apart and reports the row instead of guessing. It is
    ; confined to the two conditions it CAN ask, so an ordinary assignment never
    ; reaches it.
    procedure check_assignment_operator(this, left: ref[AstNode], op_kind: int, right: ref[AstNode], left_type: ref[Type]?, right_type: ref[Type]?)
    {
        if Parser.is_assignment_operator(op_kind) = false
            return
        let parent AstNode.parent_node_of(left)
        if parent <> null
        {
            if AstNode.is_declaration_node(parent)
            {
                if Parser.get_assignment_declaration_kind(parent as ref[AstNode]) = JSDeclarationKindExportsProperty
                {
                    ; ★★★ THE FOURTH CONJUNCT IS ASKED BEFORE THE THIRD, AND THAT IS
                    ; WHAT KEEPS THIS ROW SMALL. The reference's guard is
                    ; `resolvedSymbol != nil && len(Declarations) > 1 &&
                    ; rightType&Undefined != 0`; the links table the first two need
                    ; does not exist here, but the LAST one is a flag on a type this
                    ; port often has — and where the right side is not undefined the
                    ; guard cannot fire whatever the symbol says. Both tests are pure,
                    ; so the reordering is free. ★Asked in the reference's order the
                    ; row was 25 events over 15 units of `exports.x = …`, every one of
                    ; them a report LOST for a condition that was already false.
                    var may_skip false
                    if right_type = null
                        set may_skip: true
                    else
                    {
                        if ((right_type as ref[Type]).flags & TypeFlagsUndefined) <> 0
                            set may_skip: true
                    }
                    if may_skip
                    {
                        ; ★★★ AND SINCE SLICE 180 THE FIRST TWO CONJUNCTS ARE
                        ; ASKED TOO. The note above said the links table *does not
                        ; exist here*; `symbol_node_link_of` has carried
                        ; `resolved_symbol` since the identifier chapter, and the
                        ; `in` expression's private-identifier arm reads exactly
                        ; this pair four hundred lines up. The reordering the note
                        ; describes stays — the cheap flag test still runs first —
                        ; so what this adds is only the half that had no reader.
                        ; ★The RETURN is the guard FIRING — the assignment check
                        ; is skipped — so a missing symbol or a single declaration
                        ; falls THROUGH rather than returning.
                        let links this.symbol_node_link_of(left)
                        if links.resolved_symbol <> null
                        {
                            let sym links.resolved_symbol as ref[Symbol]
                            if Symbol.declaration_count(sym) > 1
                                return
                        }
                    }
                }
            }
        }
        ; "getters can be a subtype of setters, so to check for assignability we
        ; use the setter's type instead" — `checkPropertyAccessExpression(left,
        ; CheckModeNormal, writeOnly: true)`, which is the THIRD producer of the row
        ; slice 96 closed and the one no histogram separated from the other two.
        ; ★The rewritten leftType is read only by the relation below, which reports
        ; either way, so the answer is discarded here exactly as the walk discarded
        ; the stop — what changes is that the write half of the access now RUNS,
        ; which is where getWriteTypeOfSymbol and its two rows live.
        var write_type: ref[Type]? null
        if Parser.is_compound_assignment(op_kind)
        {
            if AstNode.kind_of(left) = KindPropertyAccessExpression
                set write_type: this.check_property_access_expression(left, CheckModeNormal, true)
        }
        if this.check_reference_expression(left, DiagThe_left_hand_side_of_an_assignment_expression_must_be_a_variable_or_a_property_access, DiagThe_left_hand_side_of_an_assignment_expression_may_not_be_an_optional_property_access) = false
            return
        ; The exactOptionalPropertyTypes head-message branch is dead under this
        ; harness — the option is a plain equality against TSTrue and answers false
        ; (see exact_optional_property_types) — and headMessage is a message
        ; ARGUMENT of the relation's own report, which the C section does not carry
        ; anyway. Both readings agree, which is why the branch is stated here and
        ; not transcribed.
        ;
        ; ★★★ THE THIRD SITE SLICE 101 WIRES, AND THE ONLY ONE WITH A REWRITTEN
        ; OPERAND. The reference's `leftType` on a COMPOUND assignment to a property
        ; access is the WRITE type the call above answers, not the one this
        ; procedure was handed — so the relation is asked about the rewritten one or
        ; not at all: a comparison against the read type is a well-formed WRONG
        ; answer, which is the shape this file is organized against.
        var target_type: ref[Type]? left_type
        if Parser.is_compound_assignment(op_kind)
        {
            if AstNode.kind_of(left) = KindPropertyAccessExpression
                set target_type: write_type
        }
        if right_type = null
            return
        if target_type = null
            return
        var head_message 0
        if Checker.exact_optional_property_types() and (AstNode.kind_of(left) = KindPropertyAccessExpression)
        {
            if Checker.maybe_type_of_kind(right_type as ref[Type], TypeFlagsUndefined)
            {
                let object_type this.get_type_of_expression(AstNode.expression_of(left) as ref[AstNode])
                let pname AstNode.name_of(left)
                if (object_type <> null) and (pname <> null)
                {
                    let target this.get_type_of_property_of_type(object_type as ref[Type], AstNode.identifier_text_of(pname as ref[AstNode]))
                    if target <> null
                    {
                        if this.is_exact_optional_property_mismatch(right_type as ref[Type], target as ref[Type])
                            set head_message: DiagType_0_is_not_assignable_to_type_1_with_exactOptionalPropertyTypes_Colon_true_Consider_adding_undefined_to_the_type_of_the_target
                    }
                }
            }
        }
        this.check_type_assignable_to_and_optionally_elaborate(right_type as ref[Type], target_type as ref[Type], left, right, head_message)
    }

    ; checkReferenceExpression, whole. Both of its reports are node-driven, which
    ; is what makes the assignment arm produce diagnostics on a corpus whose
    ; operand types this port cannot yet answer.
    ;
    ; ★ The optional-chain test is the reference's — the RAW flag, with no kind
    ; test in front of it. NodeFlagsOptionalChain shares its bit (binder.scaly's
    ; is_optional_chain says so), but by this line the node is an Identifier or an
    ; access expression, and neither carries ContainsThis or NestedNamespace.
    procedure check_reference_expression(this, expr: ref[AstNode], invalid_reference_code: int, invalid_optional_chain_code: int) returns bool
    {
        let node Parser.skip_outer_expressions(expr, OEKAssertions | OEKParentheses)
        if node = null
        {
            ; Unreachable: every kind is_outer_expression walks through has a
            ; non-optional expression slot. The report holds the claim.
            this.record_unported("skip-outer-expressions-nil", AstNode.kind_of(expr))
            return false
        }
        let n node as ref[AstNode]
        var reference_like false
        if AstNode.kind_of(n) = KindIdentifier
            set reference_like: true
        if Parser.is_access_expression(n)
            set reference_like: true
        if reference_like = false
        {
            this.error_on_node(expr, invalid_reference_code)
            return false
        }
        if (AstNode.flags_of(n) & NodeFlagsOptionalChain) <> 0
        {
            this.error_on_node(expr, invalid_optional_chain_code)
            return false
        }
        true
    }

    ; The comma operator's arm, whole — `isSideEffectFree(left) &&
    ; !isIndirectCall(left.Parent)` and then the TS2657 overlap test.
    ;
    ; ★★ THE OVERLAP TEST IS NOT DECORATION AND IT IS WHY THIS IS A FUNCTION. In a
    ; JSX file `<a/> <b/>` parses as a comma expression whose left side is
    ; side-effect free, and the reference suppresses TS2695 exactly where it has
    ; already said *JSX expressions must have one parent element* at the same
    ; position. Without it this port would INVENT a line on those units, which is
    ; the one direction diagcheck fails on.
    ;
    ; ★ `AllowUnreachableCode.IsTrue()` is a plain equality against TSTrue, so an
    ; unset option answers false and the check RUNS — the second reading of an
    ; unset option in this file, not the strict-family one.
    procedure check_comma_operand(this, left: ref[AstNode])
    {
        if checker_allow_unreachable_code = TristateTrue
            return
        if this.is_side_effect_free(left) = false
            return
        if Checker.is_indirect_call(AstNode.parent_node_of(left))
            return
        let start b.skip_trivia_at(AstNode.pos_of(left))
        if this.position_is_in_jsx_parent_diagnostic(start)
            return
        this.error_on_node(left, DiagLeft_side_of_comma_operator_is_unused_and_has_no_side_effects)
    }

    ; `core.Some(sf.Diagnostics(), …)` — the file's PARSE diagnostics, which is
    ; the list AstNode.diagnostic_at reads, filtered by code 2657 and by
    ; `d.Loc().Contains(start)` (pos <= start < end).
    function position_is_in_jsx_parent_diagnostic(this, start: int) returns bool
    {
        let n AstNode.diagnostic_count(file)
        var i 0
        while i < n
        {
            var pos 0
            var stop 0
            var code 0
            if AstNode.diagnostic_at(file, i, &pos, &stop, &code)
            {
                if code = DiagJSX_expressions_must_have_one_parent_element
                {
                    if start >= pos
                    {
                        if start < stop
                            return true
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    ; isSideEffectFree, whole. A *shallow* smell test, in the reference's words,
    ; and it needs no type.
    function is_side_effect_free(this, node: ref[AstNode]) returns bool
    {
        let n Parser.skip_parentheses(node)
        if n = null
            return false
        let x n as ref[AstNode]
        let k AstNode.kind_of(x)
        if Checker.is_side_effect_free_kind(k)
            return true
        if k = KindConditionalExpression
        {
            let wt AstNode.conditional_when_true_of(x)
            let wf AstNode.conditional_when_false_of(x)
            if wt = null
                return false
            if wf = null
                return false
            if this.is_side_effect_free(wt as ref[AstNode]) = false
                return false
            return this.is_side_effect_free(wf as ref[AstNode])
        }
        if k = KindBinaryExpression
        {
            if Parser.is_assignment_operator(AstNode.binary_operator_kind(x))
                return false
            let l AstNode.binary_left_of(x)
            let r AstNode.binary_right_of(x)
            if l = null
                return false
            if r = null
                return false
            if this.is_side_effect_free(l as ref[AstNode]) = false
                return false
            return this.is_side_effect_free(r as ref[AstNode])
        }
        if k = KindPrefixUnaryExpression
        {
            ; "Unary operators ~, !, + and - have no side effects. The rest do."
            let op AstNode.prefix_unary_operator_kind(x)
            if op = KindExclamationToken
                return true
            if op = KindPlusToken
                return true
            if op = KindMinusToken
                return true
            if op = KindTildeToken
                return true
            return false
        }
        false
    }

    ; The eighteen kinds of isSideEffectFree's first `case` label.
    function is_side_effect_free_kind(k: int) returns bool
    {
        if k = KindIdentifier
            return true
        if k = KindStringLiteral
            return true
        if k = KindRegularExpressionLiteral
            return true
        if k = KindTaggedTemplateExpression
            return true
        if k = KindTemplateExpression
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        if k = KindNullKeyword
            return true
        if k = KindUndefinedKeyword
            return true
        if k = KindFunctionExpression
            return true
        if k = KindClassExpression
            return true
        if k = KindArrowFunction
            return true
        if k = KindArrayLiteralExpression
            return true
        if k = KindObjectLiteralExpression
            return true
        if k = KindTypeOfExpression
            return true
        if k = KindNonNullExpression
            return true
        if k = KindJsxSelfClosingElement
            return true
        k = KindJsxElement
    }

    ; isIndirectCall — `(0, x.f)(...)` and `(0, eval)(...)`, which the reference
    ; exempts because the comma is load-bearing there: it is what keeps `this`
    ; from being passed.
    function is_indirect_call(n: ref[AstNode]?) returns bool
    {
        if n = null
            return false
        if AstNode.kind_of(n as ref[AstNode]) <> KindBinaryExpression
            return false
        let node n as ref[AstNode]
        let left AstNode.binary_left_of(node)
        let right AstNode.binary_right_of(node)
        let parent AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(parent) <> KindParenthesizedExpression
            return false
        if Checker.kind_or_unknown(left) <> KindNumericLiteral
            return false
        if Checker.node_text_is(AstNode.literal_text_of(left), "0") = false
            return false
        let grandparent AstNode.parent_node_of(parent)
        var call_shaped false
        if Checker.kind_or_unknown(grandparent) = KindCallExpression
        {
            if AstNode.expression_of(grandparent) = parent
                set call_shaped: true
        }
        if Checker.kind_or_unknown(grandparent) = KindTaggedTemplateExpression
            set call_shaped: true
        if call_shaped = false
            return false
        if Parser.is_access_expression(right)
            return true
        if Checker.kind_or_unknown(right) <> KindIdentifier
            return false
        Checker.node_text_is(AstNode.identifier_text_of(right), "eval")
    }

    ; A node's own text against a literal. symbol_name_equals' shape, over the
    ; AstNode payload accessors rather than over a Symbol's name bytes.
    function node_text_is(data: Slice[char], lit: Slice[char]) returns bool
    {
        if data.length <> lit.length
            return false
        if data.data = null
            return false
        var i 0
        while i < lit.length
        {
            if (data[i] as int) <> ((lit[i] as char) as int)
                return false
            set i: i + 1
        }
        true
    }

    ; checkTruthinessOfType, whole. Slice 63 left `check-truthiness-of-type` on
    ; the work list from checkTruthinessExpression and this closes it — the arm
    ; the binary expression needs and the arm the `if`, `do` and `while`
    ; conditions need are the same arm.
    procedure check_truthiness_of_type(this, t: ref[Type], node: ref[AstNode]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsVoid) <> 0
        {
            this.error_on_node(node, DiagAn_expression_of_type_void_cannot_be_tested_for_truthiness)
            return t
        }
        let semantics this.get_syntactic_truthy_semantics(node)
        if semantics <> PredicateSemanticsSometimes
        {
            if semantics = PredicateSemanticsAlways
                this.error_on_node(node, DiagThis_kind_of_expression_is_always_truthy)
            else
                this.error_on_node(node, DiagThis_kind_of_expression_is_always_falsy)
        }
        t
    }

    ; getSyntacticTruthySemantics, whole.
    ;
    ; ★★★ THE IDENTIFIER ARM'S ROW WAS AN EXPIRED PREMISE — the seventh harvest of
    ; §3.5hd, and it is is_null_or_undefined's finding a second time, in the same
    ; words. What stood here said *only `undefined` is a question this port cannot
    ; answer … the reader that closes it is the globals table*, and the reader it
    ; needs is `get_resolved_symbol`, which has been in this file since slice 91,
    ; cannot stop, and is already asked in exactly this shape one arm over
    ; (is_null_or_undefined, slice 131 — whose row read *a name resolution this
    ; port does not have* on the day the resolution was there).
    ;
    ; ★★ AND THE TEXT PRE-FILTER GOES WITH IT, because it is not the reference's
    ; line. Upstream resolves EVERY identifier that reaches this arm, and
    ; get_resolved_symbol REPORTS on a miss — so a guard that resolves only the
    ; one spelling whose answer it reads also drops every Cannot_find_name the
    ; reference files here. The filter was sound while the call was a stop and is
    ; a divergence now.
    procedure get_syntactic_truthy_semantics(this, node: ref[AstNode]) returns int
    {
        let t Parser.skip_outer_expressions(node, OEKAll)
        if t = null
            return PredicateSemanticsSometimes
        let n t as ref[AstNode]
        let k AstNode.kind_of(n)
        if k = KindNumericLiteral
        {
            ; "Allow `while(0)` or `while(1)`"
            let d AstNode.literal_text_of(n)
            let len AstNode.literal_text_length_of(n)
            if Checker.node_text_is(d, "0")
                return PredicateSemanticsSometimes
            if Checker.node_text_is(d, "1")
                return PredicateSemanticsSometimes
            return PredicateSemanticsAlways
        }
        if Checker.is_always_truthy_kind(k)
            return PredicateSemanticsAlways
        if k = KindVoidExpression
            return PredicateSemanticsNever
        if k = KindNullKeyword
            return PredicateSemanticsNever
        if Checker.is_plain_string_literal_kind(k)
        {
            if AstNode.literal_text_length_of(n) <> 0
                return PredicateSemanticsAlways
            return PredicateSemanticsNever
        }
        if k = KindConditionalExpression
        {
            let wt AstNode.conditional_when_true_of(n)
            let wf AstNode.conditional_when_false_of(n)
            if wt = null
                return PredicateSemanticsSometimes
            if wf = null
                return PredicateSemanticsSometimes
            return this.get_syntactic_truthy_semantics(wt as ref[AstNode]) | this.get_syntactic_truthy_semantics(wf as ref[AstNode])
        }
        if k = KindIdentifier
        {
            if this.get_resolved_symbol(n) = undefined_symbol
                return PredicateSemanticsNever
        }
        PredicateSemanticsSometimes
    }

    ; The nine kinds that are always truthy without asking their text.
    function is_always_truthy_kind(k: int) returns bool
    {
        if k = KindArrayLiteralExpression
            return true
        if k = KindArrowFunction
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindClassExpression
            return true
        if k = KindFunctionExpression
            return true
        if k = KindJsxElement
            return true
        if k = KindJsxSelfClosingElement
            return true
        if k = KindObjectLiteralExpression
            return true
        k = KindRegularExpressionLiteral
    }

    ; The two kinds whose EMPTINESS decides — a template with substitutions is a
    ; TemplateExpression and is not one of them.
    function is_plain_string_literal_kind(k: int) returns bool
    {
        if k = KindNoSubstitutionTemplateLiteral
            return true
        k = KindStringLiteral
    }

    ; checkNullishCoalesceOperands, whole: the mixing report over three shapes,
    ; then the left operand's own nullishness.
    procedure check_nullish_coalesce_operands(this, left: ref[AstNode], right: ref[AstNode])
    {
        let grandparent AstNode.parent_node_of(AstNode.parent_node_of(left))
        if Checker.kind_or_unknown(grandparent) = KindBinaryExpression
        {
            let gl AstNode.binary_left_of(grandparent)
            if Checker.kind_or_unknown(gl) = KindBinaryExpression
            {
                if AstNode.binary_operator_kind(grandparent) = KindBarBarToken
                    this.grammar_error_on_node_or_null(gl, DiagX_0_and_1_operations_cannot_be_mixed_without_parentheses, "??", "||")
            }
        }
        else
        {
            if AstNode.kind_of(left) = KindBinaryExpression
            {
                let op AstNode.binary_operator_kind(left)
                var mixed false
                if op = KindBarBarToken
                    set mixed: true
                if op = KindAmpersandAmpersandToken
                    set mixed: true
                if mixed
                    this.grammar_error_on_node(left, DiagX_0_and_1_operations_cannot_be_mixed_without_parentheses, Checker.arg_text(Scanner.token_to_string(op)), "??")
            }
            else
            {
                if AstNode.kind_of(right) = KindBinaryExpression
                {
                    if AstNode.binary_operator_kind(right) = KindAmpersandAmpersandToken
                        this.grammar_error_on_node(right, DiagX_0_and_1_operations_cannot_be_mixed_without_parentheses, "??", "&&")
                }
            }
        }
        this.check_nullish_coalesce_operand_left(left)
    }

    procedure check_nullish_coalesce_operand_left(this, left: ref[AstNode])
    {
        let target Parser.skip_outer_expressions(left, OEKAll)
        if target = null
            return
        let t target as ref[AstNode]
        let semantics this.get_syntactic_nullishness_semantics(t)
        if semantics = PredicateSemanticsSometimes
            return
        if semantics = PredicateSemanticsAlways
            this.error_on_node(t, DiagThis_expression_is_always_nullish)
        else
            this.error_on_node(t, DiagRight_operand_of_is_unreachable_because_the_left_operand_is_never_nullish)
    }

    ; getSyntacticNullishnessSemantics, whole but for the same one lookup, and
    ; confined the same way — see get_syntactic_truthy_semantics' note.
    ;
    ; ★ Its DEFAULT is Never where the truthiness walk's is Sometimes, so an
    ; unlisted kind here REPORTS (TS2869, *right operand is unreachable*) rather
    ; than falling silent. That asymmetry is the reference's and it is why the
    ; nine-kind first label is transcribed rather than folded into the default.
    procedure get_syntactic_nullishness_semantics(this, node: ref[AstNode]) returns int
    {
        let t Parser.skip_outer_expressions(node, OEKAll)
        if t = null
            return PredicateSemanticsNever
        let n t as ref[AstNode]
        let k AstNode.kind_of(n)
        if Checker.is_sometimes_nullish_kind(k)
            return PredicateSemanticsSometimes
        if k = KindBinaryExpression
        {
            let op AstNode.binary_operator_kind(n)
            ; "List of operators that can produce null/undefined: || ||= && &&="
            if Binder.is_logical_binary_operator(op)
                return PredicateSemanticsSometimes
            if op = KindBarBarEqualsToken
                return PredicateSemanticsSometimes
            if op = KindAmpersandAmpersandEqualsToken
                return PredicateSemanticsSometimes
            ; "For these operator kinds, the right operand is effectively
            ; controlling"
            var right_controls false
            if op = KindCommaToken
                set right_controls: true
            if op = KindEqualsToken
                set right_controls: true
            if op = KindQuestionQuestionToken
                set right_controls: true
            if op = KindQuestionQuestionEqualsToken
                set right_controls: true
            if right_controls
            {
                let r AstNode.binary_right_of(n)
                if r = null
                    return PredicateSemanticsNever
                return this.get_syntactic_nullishness_semantics(r as ref[AstNode])
            }
            return PredicateSemanticsNever
        }
        if k = KindConditionalExpression
        {
            let wt AstNode.conditional_when_true_of(n)
            let wf AstNode.conditional_when_false_of(n)
            if wt = null
                return PredicateSemanticsNever
            if wf = null
                return PredicateSemanticsNever
            return this.get_syntactic_nullishness_semantics(wt as ref[AstNode]) | this.get_syntactic_nullishness_semantics(wf as ref[AstNode])
        }
        if k = KindNullKeyword
            return PredicateSemanticsAlways
        if k = KindIdentifier
        {
            ; `getResolvedSymbol(node) == undefinedSymbol` — the name resolves,
            ; it is not a text test (slice 202).
            if this.get_resolved_symbol(n) = undefined_symbol
                return PredicateSemanticsAlways
            return PredicateSemanticsSometimes
        }
        PredicateSemanticsNever
    }

    ; The nine kinds of the first `case` label — the ones that may or may not be
    ; nullish and therefore report nothing.
    function is_sometimes_nullish_kind(k: int) returns bool
    {
        if k = KindAwaitExpression
            return true
        if k = KindCallExpression
            return true
        if k = KindTaggedTemplateExpression
            return true
        if k = KindElementAccessExpression
            return true
        if k = KindMetaProperty
            return true
        if k = KindNewExpression
            return true
        if k = KindPropertyAccessExpression
            return true
        if k = KindYieldExpression
            return true
        k = KindThisKeyword
    }

    ; ── the call and the new expression (slice 89) ──────────────────────────
    ;
    ; checkCallExpression serves BOTH kinds — the dispatch sends it every
    ; NewExpression and every CallExpression that is not an import call — and so
    ; does the whole chain below it, down to resolveCall. THAT is where this slice
    ; stops: overload resolution is a thousand lines in the reference and its first
    ; step is the assignability relation, a dimension of its own.
    ;
    ; ★★★ WHAT THIS CHAPTER CAN ANSWER IS DECIDED BY THE CALLEE, NOT BY THE CALL.
    ; resolveCallExpression's third line is `c.checkExpression(node.Expression())`
    ; and resolveNewExpression's first is the same call one wrapper down, and in
    ; this corpus a callee is an Identifier or a property access almost everywhere —
    ; so the row this slice closes hands most of its units on to `check-identifier`
    ; (the globals table, §3.11) and `check-property-access-expression`. That is row
    ; TRUTH rather than a diagnostic, and slice 88's finding three is the precedent:
    ; a stop that names the wall its units actually hit is worth the slice even
    ; where the corpus total does not move.
    ;
    ; ★★★ ONE OF NewChecker's FOUR SINGLETON SIGNATURES IS MINTED AND THREE ARE NOT,
    ; on §3.5be's rule that a field with no reader is DECLARED rather than ported —
    ; and each of the three is named here with the function that reads it.
    ; `resolvingSignature` is minted because it has both a live writer and a live
    ; reader in this file: getResolvedSignature parks it in the links slot while the
    ; resolution runs, and checkCallExpression compares against it. `anySignature`
    ; is resolveUntypedCall's answer, `unknownSignature` resolveErrorCall's, and
    ; `silentNeverSignature` the answer of the two silentNever short-circuits — all
    ; four of those functions sit BEHIND checkNonNullType, which is this chapter's
    ; near wall, so minting their values now would be three fields nothing reads.
    ; ★Nothing compares a signature ID (Type's own note says the same for type ids),
    ; so the counter running three lower than the reference's costs nothing.
    ; ── THE DYNAMIC IMPORT, slice 138 ───────────────────────────────────────
    ;
    ; checkImportCallExpression. ★★★It is not a call in the resolution sense at
    ; all — no signature, no overload set: the result is `Promise<T>` where T is
    ; the imported module's type, and the whole body is the grammar, the specifier's
    ; type and the options argument.
    ;
    ; ★★ THE EXTRA ARGUMENTS ARE CHECKED ON PURPOSE though the grammar has already
    ; reported them: *"Even though multiple arguments is grammatically incorrect,
    ; type-check extra arguments for completion"*.
    procedure check_import_call_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let ignored_grammar this.check_grammar_import_call_expression(node)
        let args AstNode.call_arguments_of(node)
        let arg_count AstNode.list_count(args)
        if arg_count = 0
            return this.create_promise_return_type(node, any_type)
        let specifier_row AstNode.child_in_list(args, 0)
        if specifier_row = null
            return null
        let specifier specifier_row as ref[AstNode]
        let specifier_type this.check_expression_cached(specifier)
        if this.unported_mark() <> mark
            return null
        if specifier_type = null
            return null
        var options_type: ref[Type]? null
        if arg_count > 1
        {
            let options_row AstNode.child_in_list(args, 1)
            if options_row = null
                return null
            set options_type: this.check_expression_cached(options_row as ref[AstNode])
            if this.unported_mark() <> mark
                return null
        }
        var i 2
        while i < arg_count
        {
            let extra AstNode.child_in_list(args, i)
            set i: i + 1
            if extra = null
                return null
            let ignored_extra this.check_expression_cached(extra as ref[AstNode])
            if this.unported_mark() <> mark
                return null
        }
        var specifier_bad false
        if ((specifier_type as ref[Type]).flags & TypeFlagsNullable) <> 0
            set specifier_bad: true
        if specifier_bad = false
        {
            if this.is_type_assignable_to(specifier_type as ref[Type], string_type) = false
                set specifier_bad: true
            if this.unported_mark() <> mark
                return null
        }
        if specifier_bad
        {
            let specifier_name this.type_arg(specifier_type)
            this.error_on_node(specifier, DiagDynamic_import_s_specifier_must_be_of_type_string_but_here_has_type_0, specifier_name)
        }
        if options_type <> null
        {
            let options_target this.get_global_import_call_options_type_checked()
            if this.unported_mark() <> mark
                return null
            if options_target <> null
            {
                if (options_target as ref[Type]) <> empty_object_type
                {
                    let nullable this.get_nullable_type(options_target as ref[Type], TypeFlagsUndefined)
                    if this.unported_mark() <> mark
                        return null
                    if nullable = null
                        return null
                    let ignored_assign this.check_type_assignable_to(options_type as ref[Type], nullable as ref[Type], AstNode.child_in_list(args, 1), 0)
                    if this.unported_mark() <> mark
                        return null
                }
            }
            ; `assert` was renamed to `with`, and the report lands on the property
            ; NAME. ★It breaks out of the loop at the first one.
            let options_node AstNode.child_in_list(args, 1)
            if options_node = null
                return null
            if AstNode.kind_of(options_node as ref[AstNode]) = KindObjectLiteralExpression
            {
                let properties AstNode.properties_of(options_node as ref[AstNode])
                var pi 0
                while pi < AstNode.list_count(properties)
                {
                    let prop AstNode.child_in_list(properties, pi)
                    set pi: pi + 1
                    if prop = null
                        return null
                    let p prop as ref[AstNode]
                    if AstNode.kind_of(p) <> KindPropertyAssignment
                        continue
                    let nm AstNode.name_of(p)
                    if nm = null
                        continue
                    let name nm as ref[AstNode]
                    if AstNode.kind_of(name) <> KindIdentifier
                        continue
                    if Checker.identifier_text_is(name, "assert") = false
                        continue
                    this.error_on_node(name, DiagImport_assertions_have_been_replaced_by_import_attributes_Use_with_instead_of_assert)
                    set pi: AstNode.list_count(properties)
                }
            }
        }
        ; "resolveExternalModuleName will return undefined if the
        ; moduleReferenceExpression is not a string literal"
        let module_symbol this.resolve_external_module_name(node, specifier, false)
        if this.unported_mark() <> mark
            return null
        if module_symbol <> null
        {
            let es_module_symbol this.resolve_external_module_symbol(module_symbol, true)
            if this.unported_mark() <> mark
                return null
            if es_module_symbol <> null
            {
                ; ★★★ THE SYNTHETIC DEFAULT IS THE ONE WALL LEFT IN THIS ARM, and
                ; it is a chapter rather than a helper: `getTypeWithSyntheticDefault
                ; Only` and `getTypeWithSyntheticDefaultImportType` both go through
                ; `createDefaultPropertyWrapperForModule` and `canHaveSyntheticDefault`,
                ; whose own body asks the PROGRAM for a file's implied module format
                ; and for project-reference redirects — three readings this port has
                ; no source for. The row therefore stands at the moment a specifier
                ; RESOLVES; an unresolved one answers `Promise<any>` below, which is
                ; the reference's own answer.
                ; slice 248: the default-only wrapper, else the synthetic-default type
                let esm es_module_symbol as ref[Symbol]
                let esm_type this.get_type_of_symbol(esm)
                if this.unported_mark() <> mark
                    return null
                if esm_type = null
                    return null
                let et esm_type as ref[Type]
                var synthetic this.get_type_with_synthetic_default_only(et, esm, module_symbol, specifier)
                if this.unported_mark() <> mark
                    return null
                if synthetic = null
                    set synthetic: this.get_type_with_synthetic_default_import_type(et, esm, module_symbol, specifier)
                if this.unported_mark() <> mark
                    return null
                return this.create_promise_return_type(node, synthetic)
            }
        }
        this.create_promise_return_type(node, any_type)
    }

    ; getGlobalImportCallOptionsTypeChecked — the CHECKED resolver of the pair, so
    ; a missing `ImportCallOptions` reports. ★The unchecked twin's only reader is
    ; the contextual type of the second argument, which is unported.
    procedure get_global_import_call_options_type_checked(this) returns ref[Type]?
    {
        this.report_checked_global_type("ImportCallOptions", 0)
        if global_import_call_options_type <> null
            return global_import_call_options_type
        let t this.get_global_type_of_arity("ImportCallOptions", 0)
        set global_import_call_options_type: t
        t
    }

    ; checkGrammarImportCallExpression, whole — and every option it reads is
    ; DECIDED under this harness rather than guessed: `module` is unset, so
    ; `moduleKind` is the DERIVED **ES2022** (see the field's own note), and
    ; VerbatimModuleSyntax is unset.
    ;
    ; ★★ TWO OF ITS SEVEN REPORTS ARE THEREFORE DEAD and are written as the
    ; constant they are, each with the option that would wake it: the
    ; verbatim-module-syntax report needs ModuleKindCommonJS, and TS1323 needs
    ; ModuleKindES2015 exactly.
    procedure check_grammar_import_call_expression(this, node: ref[AstNode]) returns bool
    {
        if verbatim_module_syntax and (module_kind = ModuleKindCommonJS)
        {
            if this.is_mts_or_cts_file_name_cjs(node)
                return this.grammar_error_on_node(node, DiagECMAScript_imports_and_exports_cannot_be_written_in_a_CommonJS_file_under_verbatimModuleSyntax)
            return this.grammar_error_on_node(node, DiagECMAScript_imports_and_exports_cannot_be_written_in_a_CommonJS_file_under_verbatimModuleSyntax_Adjust_the_type_field_in_the_nearest_package_json_to_make_this_file_an_ECMAScript_module_or_adjust_your_verbatimModuleSyntax_module_and_moduleResolution_settings_in_TypeScript)
        }
        ; `import.defer("m")` — the callee is a MetaProperty, and a deferred import
        ; needs esnext or preserve; a plain import() is refused under es2015
        let callee AstNode.expression_of(node)
        if Checker.kind_or_unknown(callee) = KindMetaProperty
        {
            if (module_kind <> ModuleKindESNext) and (module_kind <> ModuleKindPreserve)
                return this.grammar_error_on_node(node, DiagDeferred_imports_are_only_supported_when_the_module_flag_is_set_to_esnext_or_preserve)
        }
        else
        {
            if module_kind = ModuleKindES2015
                return this.grammar_error_on_node(node, DiagDynamic_imports_are_only_supported_when_the_module_flag_is_set_to_es2020_es2022_esnext_commonjs_amd_system_umd_node16_node18_node20_or_nodenext)
        }
        ; ★★★ THE TEST IS `nodeAsCall.TypeArguments != nil` AND NOT A COUNT: an
        ; empty `import<>("m")` list exists and reports (importCallExpressionWithTypeArgument)
        if AstNode.type_arguments_of(node) <> null
            return this.grammar_error_on_node(node, DiagThis_use_of_import_is_invalid_import_calls_can_be_written_but_they_must_have_parentheses_and_cannot_have_type_arguments)
        let args AstNode.call_arguments_of(node)
        let arg_count AstNode.list_count(args)
        let node_module (module_kind >= ModuleKindNode16) and (module_kind <= ModuleKindNodeNext)
        if (node_module = false) and (module_kind <> ModuleKindESNext) and (module_kind <> ModuleKindPreserve)
        {
            ; "We are allowed trailing comma after proposal-import-assertions."
            let ignored_comma this.check_grammar_for_disallowed_trailing_comma(args, DiagTrailing_comma_not_allowed)
            if arg_count > 1
                return this.grammar_error_on_node_or_null(AstNode.child_in_list(args, 1), DiagDynamic_imports_only_support_a_second_argument_when_the_module_option_is_set_to_esnext_node16_node18_node20_nodenext_or_preserve)
        }
        if (arg_count = 0) or (arg_count > 2)
            return this.grammar_error_on_node(node, DiagDynamic_imports_can_only_accept_a_module_specifier_and_an_optional_set_of_attributes_as_arguments)
        ; "parseArgumentOrArrayLiteralElement allows spread element to be in an
        ; argument list which is not allowed as specifier in dynamic import."
        var si 0
        while si < arg_count
        {
            let arg AstNode.child_in_list(args, si)
            set si: si + 1
            if arg = null
                continue
            if AstNode.kind_of(arg as ref[AstNode]) = KindSpreadElement
                return this.grammar_error_on_node(arg as ref[AstNode], DiagArgument_of_dynamic_import_cannot_be_spread_element)
        }
        false
    }

    ; c.error(node, getVerbatimModuleSyntaxErrorMessage(node))
    procedure report_verbatim_module_syntax_error(this, node: ref[AstNode])
    {
        if this.is_mts_or_cts_file_name_cjs(node)
            this.error_on_node(node, DiagECMAScript_imports_and_exports_cannot_be_written_in_a_CommonJS_file_under_verbatimModuleSyntax)
        else
            this.error_on_node(node, DiagECMAScript_imports_and_exports_cannot_be_written_in_a_CommonJS_file_under_verbatimModuleSyntax_Adjust_the_type_field_in_the_nearest_package_json_to_make_this_file_an_ECMAScript_module_or_adjust_your_verbatimModuleSyntax_module_and_moduleResolution_settings_in_TypeScript)
    }

    ; getVerbatimModuleSyntaxErrorMessage's test: a `.cts`/`.cjs` file
    function is_mts_or_cts_file_name_cjs(this, node: ref[AstNode]) returns bool
    {
        if program = null
            return false
        let pf program as ref[ProgramFiles]
        let index this.program_index_of_node(node)
        if index < 0
            return false
        let path pf.path_at(index)
        path.ends_with(".cts") or path.ends_with(".cjs")
    }

    ; checkTaggedTemplateExpression, whole — and the `!!! JSX` comment upstream
    ; stands over a line the reference does not have either.
    ;
    ; ★ THE GRAMMAR PAIR IS AN `else`: the chain error and the type-argument check
    ; are mutually exclusive, because a tagged template in an optional chain has
    ; already reported and its type arguments are not the author's next problem.
    procedure check_tagged_template_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if this.check_grammar_tagged_template_chain(node) = false
            this.check_grammar_type_arguments(AstNode.type_arguments_of(node))
        let sig this.get_resolved_signature(node, CheckModeNormal)
        if this.unported_mark() <> mark
            return null
        if sig = null
            return null
        let signature sig as ref[Signature]
        this.check_deprecated_signature(signature, node)
        if this.unported_mark() <> mark
            return null
        this.get_return_type_of_signature(signature)
    }

    ; checkGrammarTaggedTemplateChain, whole. ★The report lands on the TEMPLATE and
    ; not on the tag, which is the reference's choice: `a?.b`` `` `'s problem is the
    ; template that follows the chain.
    procedure check_grammar_tagged_template_chain(this, node: ref[AstNode]) returns bool
    {
        var in_chain false
        if AstNode.question_dot_token_of(node) <> null
            set in_chain: true
        if (AstNode.flags_of(node) & NodeFlagsOptionalChain) <> 0
            set in_chain: true
        if in_chain = false
            return false
        this.grammar_error_on_node_or_null(AstNode.tagged_template_template_of(node), DiagTagged_template_expressions_are_not_permitted_in_an_optional_chain)
    }

    procedure check_call_expression(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        this.check_grammar_type_arguments(AstNode.type_arguments_of(node))
        let mark this.unported_mark()
        let sig this.get_resolved_signature(node, check_mode)
        if this.unported_mark() <> mark
            return null
        if sig = null
            return null
        let signature sig as ref[Signature]
        ; CheckMode.SkipGenericFunctions deferred the call. Nothing passes that mode
        ; here — checkExpressionEx reports on it — so the arm is live code with no
        ; input; it is transcribed because the value it compares against is the one
        ; singleton this slice does mint.
        if signature = resolving_signature
            return silent_never_type
        this.check_deprecated_signature(signature, node)
        if Checker.kind_or_unknown(AstNode.expression_of(node)) = KindSuperKeyword
            return void_type
        if AstNode.kind_of(node) = KindNewExpression
        {
            let decl signature.declaration
            if decl <> null
            {
                let dk AstNode.kind_of(decl as ref[AstNode])
                var constructs false
                if dk = KindConstructor
                    set constructs: true
                if dk = KindConstructSignature
                    set constructs: true
                if dk = KindConstructorType
                    set constructs: true
                if constructs = false
                {
                    ; ★ noImplicitAny is TRUE here — an unset strict-family option,
                    ; see the option accessors — so this is a live report and the
                    ; `if` around it is not a gate this port can fail.
                    if Checker.no_implicit_any()
                        this.error_on_node(node, DiagX_new_expression_whose_target_lacks_a_construct_signature_implicitly_has_an_any_type)
                    return any_type
                }
            }
        }
        ; ★The row that stood here named c.requireSymbol as unminted; it is minted
        ; since slice 143, so both lines of isCommonJSRequire are answerable.
        if Parser.is_in_js_file(node)
        {
            let cjs_mark this.unported_mark()
            let cjs this.is_common_js_require(node)
            if this.unported_mark() <> cjs_mark
                return null
            if cjs
                return this.resolve_external_module_type_by_literal(AstNode.child_in_list(AstNode.call_arguments_of(node), 0))
        }
        let rt this.get_return_type_of_signature(signature)
        if this.unported_mark() <> mark
            return null
        if rt = null
            return null
        let return_type rt as ref[Type]
        ; The fresh-unique-symbol arm — *treat any call to the global `Symbol`
        ; function that is part of a const variable or readonly property as a fresh
        ; unique symbol literal type*, WHOLE since slice 146. Its first conjunct is
        ; a flag test on the RETURN type, so the globals term behind it is asked
        ; only where a signature whose return type is symbol-like exists — which is
        ; behind resolveCall.
        ;
        ; ★The node handed to the producer is `WalkUpParenthesizedExpressions(node.Parent)`
        ; and not the call: what owns the unique symbol is the DECLARATION the call
        ; initializes, which is what isValidESSymbolDeclaration asks about.
        if (return_type.flags & TypeFlagsESSymbolLike) <> 0
        {
            if this.is_symbol_or_symbol_for_call(node)
            {
                if this.unported_mark() <> mark
                    return null
                let host_decl Checker.walk_up_parenthesized_expressions(AstNode.parent_node_of(node))
                return this.get_es_symbol_like_type_for_node(host_decl)
            }
            if this.unported_mark() <> mark
                return null
        }
        ; The assertion-target pair, TS2776 and TS2775. Four syntactic conjuncts and
        ; then getTypePredicateOfSignature — and the FOURTH conjunct is what decides
        ; whether the row is reached at all, because a call answers a VOID return
        ; type only from a signature resolveCall built.
        var assertion_shape false
        if AstNode.kind_of(node) = KindCallExpression
        {
            if AstNode.question_dot_token_of(node) = null
            {
                if Checker.kind_or_unknown(AstNode.parent_node_of(node)) = KindExpressionStatement
                {
                    if (return_type.flags & TypeFlagsVoid) <> 0
                        set assertion_shape: true
                }
            }
        }
        ; ★★★ SLICE 131: THE ASSERTION SHAPE ASKS FOR THE PREDICATE NOW. The row
        ; that stood here named get_type_predicate_of_signature, which slice 123
        ; wrote — the fourth conjunct of the reference's condition, and the one
        ; that decides whether `assert(x)` in statement position is an ASSERTION
        ; call at all. ★Nearly every arrival answers nil and falls straight through
        ; to the return type, which is why the row was so large: it was reporting
        ; on every void-returning call in statement position.
        if assertion_shape
        {
            let predicate this.get_type_predicate_of_signature(signature)
            if this.unported_mark() <> mark
                return null
            if predicate <> null
            {
                let callee AstNode.expression_of(node)
                if Binder.is_dotted_name(callee) = false
                    this.error_on_node(callee, DiagAssertions_require_the_call_target_to_be_an_identifier_or_qualified_name)
                else
                {
                    let effects this.get_effects_signature(node)
                    if this.unported_mark() <> mark
                        return null
                    if effects = null
                    {
                        let assertion_mark this.diagnostic_mark()
                        this.error_on_node(callee, DiagAssertions_require_every_name_in_the_call_target_to_be_declared_with_an_explicit_type_annotation)
                        ; `c.getTypeOfDottedName(node.Expression(), diagnostic)`
                        if this.diagnostic_mark() > assertion_mark
                        {
                            let saved_diagnostic explicit_type_diagnostic
                            set this.explicit_type_diagnostic: assertion_mark
                            let ignored this.get_type_of_dotted_name(callee as ref[AstNode])
                            set this.explicit_type_diagnostic: saved_diagnostic
                            if this.unported_mark() <> mark
                                return null
                        }
                    }
                }
            }
        }
        return_type
    }

    ; checkDeprecatedSignature. Its product is a SUGGESTION and never a C line, so
    ; what this port would owe it is the suggestion COUNT — the discipline
    ; check_grammar_numeric_literal's report follows.
    ;
    ; ★★★ SLICE 108 MOVED THE ROW DOWN ONE CONJUNCT, AND THE REASON IT HAD TO IS
    ; THAT THE ROW'S OWN JUSTIFICATION HAD EXPIRED. Slice 89 wrote this row at
    ; `sig.declaration != nil` and explained it as *the second conjunct is the row
    ; and the first is ported* — and the second conjunct, `IsDeprecatedDeclaration`,
    ; had been ported SIX SLICES LATER, in slice 95, and sits eleven thousand lines
    ; down this file. Nothing re-read the sentence when that landed, because the row
    ; had NO INPUT until this slice: a signature's declaration slot is filled only by
    ; getSignatureFromDeclaration, and every signature that reaches here comes from
    ; resolveCall. **The first corpus run of slice 108 turned the row from 0 events to
    ; 14, and every one of those 14 was a call that had just been resolved and then
    ; lost its type to a suggestion nothing measures.**
    ;
    ; ★★ WHAT IS ACTUALLY UNPORTED IS THE SUGGESTION, so the row is named after it:
    ; addDeprecatedSuggestionWithSignature wants signatureToString and
    ; tryGetPropertyAccessOrIdentifierToString, i.e. two printers, and the flag gate in
    ; front of it answers FALSE for every declaration in this corpus that carries no
    ; `@deprecated`.
    procedure check_deprecated_signature(this, sig: ref[Signature], node: ref[AstNode])
    {
        if (sig.flags & SignatureFlagsIsSignatureCandidateForOverloadFailure) <> 0
            return
        if sig.declaration = null
            return
        if this.is_deprecated_declaration(sig.declaration as ref[AstNode]) = false
            return
        ; addDeprecatedSuggestionWithSignature into the suggestion sink, which counts
        ; and drops: the name and signature strings only choose between the two
        ; messages, and the sink reads neither. Unmeasured: whether signatureToString
        ; leaves a type behind that a later dump would see.
        this.record_suggestion(DiagThe_signature_0_of_1_is_deprecated)
    }

    ; getResolvedSignature — the MEMO, on the same signatureLinks table
    ; get_signature_from_declaration writes, keyed here on the CALL node rather than
    ; on a declaration. That is the reference's own arrangement and not a shortcut:
    ; `c.signatureLinks.Get(node)` is the same map in both functions.
    ;
    ; ★★★ IT CACHES ITS OWN INCOMPLETENESS, which is slice 88's second correction
    ; arriving in a second table. Upstream never answers nil, so the slot has two
    ; states; here a stop is a third, and caching the nil WITHOUT recording that it
    ; was a stop would let the second ask answer nil while `unported_mark` stands
    ; still — and every incompleteness guard in this file is a mark delta. The bit
    ; is `signature_stopped` and the replay moves the mark without touching the log,
    ; exactly as check_expression_cached_ex does.
    ;
    ; ★★★ AND THE MARKER IS TAKEN BACK OUT OF THE SLOT ON A STOP. A slot still
    ; holding resolvingSignature reads as *resolution in progress* to every other
    ; reader of this table, which is a THIRD meaning nobody would test for — so the
    ; stop restores what was there and records itself in the bit instead.
    ;
    ; ★★ `c.flowLoopStack` IS EMPTY AND WILL BE UNTIL `flow-graph 264` LANDS, so the
    ; branch that restores the PREVIOUS value instead of storing the result is named
    ; at the line it decides rather than folded away.
    procedure get_resolved_signature(this, node: ref[AstNode], check_mode: int) returns ref[Signature]?
    {
        let links this.signature_link_of(node)
        let cached links.resolved_signature
        if cached <> null
        {
            if (cached as ref[Signature]) <> resolving_signature
                return cached
        }
        if links.signature_stopped
        {
            this.replay_stop_mark()
            return null
        }
        let save_resolution_start resolution_start
        if cached = null
            set resolution_start: type_resolution_count
        set links.resolved_signature: resolving_signature
        let mark this.unported_mark()
        var result this.resolve_signature(node, check_mode)
        set resolution_start: save_resolution_start
        if this.unported_mark() <> mark
        {
            set links.resolved_signature: cached
            set links.signature_stopped: true
            return null
        }
        if result = null
        {
            set links.resolved_signature: cached
            set links.signature_stopped: true
            return null
        }
        if (result as ref[Signature]) <> resolving_signature
        {
            if links.resolved_signature <> null
            {
                if (links.resolved_signature as ref[Signature]) <> resolving_signature
                    set result: links.resolved_signature
            }
            ; *If signature resolution originated in control flow type analysis (for
            ; example to compute the assigned type in a flow assignment) we don't
            ; cache the result as it may be based on temporary types from the
            ; control flow analysis.* ★The note that stood here read *`len(flowLoopStack)
            ; == 0` — always true here*, a premise slice 141's loop label expired:
            ; without the guard `x = x.slice()` inside `while … if (typeof x ===
            ; "string")` kept the signature resolved while `x` was the loop's
            ; incomplete `never`, and the assignment answered `never` for good
            ; (`controlFlowWithIncompleteTypes`, slice 203).
            if flow_loop_stack = null
                set links.resolved_signature: result
            else
                set links.resolved_signature: cached
        }
        result
    }

    ; resolveSignature. Six arms, two of them ported and four of them rows — and the
    ; four are rows rather than an omission because the reference's default PANICS,
    ; so a kind arriving here that is none of the six is a defect in the caller
    ; rather than an unported construct.
    ;
    ; ★★ ALL FOUR ARE UNREACHABLE TODAY and each names the caller that would reach
    ; it: the tagged template through checkTaggedTemplateExpression, the decorator
    ; through checkDecorator, the three JSX kinds through checkJsxOpeningLikeElement
    ; and the BinaryExpression through checkInstanceOfExpression — every one of them
    ; a stop of its own in the dispatch or in the binary chapter.
    procedure resolve_signature(this, node: ref[AstNode], check_mode: int) returns ref[Signature]?
    {
        let k AstNode.kind_of(node)
        if k = KindCallExpression
            return this.record_call(node, k, this.resolve_call_expression(node, check_mode))
        if k = KindNewExpression
            return this.record_call(node, k, this.resolve_new_expression(node, check_mode))
        if k = KindTaggedTemplateExpression
            return this.record_call(node, k, this.resolve_tagged_template_expression(node, check_mode))
        if k = KindDecorator
            return this.record_call(node, k, this.resolve_decorator(node, check_mode))
        var jsx false
        if k = KindJsxOpeningFragment
            set jsx: true
        if k = KindJsxOpeningElement
            set jsx: true
        if k = KindJsxSelfClosingElement
            set jsx: true
        if jsx
            return this.record_call(node, k, this.resolve_jsx_opening_like_element(node, check_mode))
        if k = KindBinaryExpression
            return this.record_call(node, k, this.resolve_instanceof_expression(node, check_mode))
        ; `panic("Unhandled case in resolveSignature")`, held as a row on this
        ; file's rule about the reference's own assertions.
        this.record_unported("resolve-signature-unhandled", k)
        null
    }

    ; The CALLPIN's entry — see CallEvent's header. ★It ANSWERS as well as records,
    ; the way record_fork does, so that the two ported doors of resolve_signature
    ; keep reading as one-line dispatches; a separate statement before each `return`
    ; would need a local and would put the pin one line away from the outcome it is
    ; about.
    procedure record_call(this, node: ref[AstNode], kind: int, sig: ref[Signature]?) returns ref[Signature]?
    {
        var verdict 0
        var param_count 0 - 1
        var min_args 0 - 1
        if sig <> null
        {
            let s sig as ref[Signature]
            set verdict: 1
            if s = any_signature
                set verdict: 2
            if s = unknown_signature
                set verdict: 3
            if s = silent_never_signature
                set verdict: 4
            if verdict = 1
            {
                set param_count: 0
                if s.parameters <> null
                    set param_count: (s.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
                set min_args: s.min_argument_count
            }
        }
        if record_events
        {
            let ev &CallEvent^host(AstNode.pos_of(node), kind, verdict, AstNode.list_count(AstNode.call_arguments_of(node)), param_count, min_args)
            call_log.add(ev as ref[CallEvent])
        }
        sig
    }

    ; ── the type facts (slice 90) ───────────────────────────────────────────
    ;
    ; getTypeFacts, hasTypeFacts, getTypeFactsWorker and getIntersectionTypeFacts,
    ; and the checkNonNullType family that is their first caller.
    ;
    ; ★★★ IT IS A JOINT AND NOT A CHAPTER, which is why it is worth a slice of its
    ; own: five arms of three different chapters were standing at this one call.
    ; resolveCallExpression and resolveNewExpression stop at `checkNonNullType` on
    ; their second line, the arithmetic and the relational operators stop at it in
    ; the middle of their own switch arms, the three logical operators stop at
    ; `hasTypeFacts`, and `checkPropertyAccessExpression` — the work list's first
    ; REACHABLE row at stage 2 — stops at `checkNonNullExpression`, which is this
    ; function under a wrapper.
    ;
    ; ★★★ THE WORKER SIGNALS A STOP THROUGH THE MARK, NOT THROUGH A nil, and it has
    ; to: its answer is an int, so TypeFactsNone and *I could not tell* have the same
    ; spelling. Every caller here compares `unported_mark()` across the call before
    ; it reads the answer, the way get_apparent_type's callers compare it across
    ; get_base_constraint_of_type. **A caller that forgets is not diagnosed — it
    ; reads TypeFactsNone as an answer**, which for `hasTypeFacts` means FALSE and
    ; for checkNonNullType means *not nullable*, i.e. exactly the two lenient
    ; readings. That is why the four call sites are written out rather than folded
    ; into a helper: the mark is part of the call.
    ;
    ; ★★ WHAT ARRIVES HERE IN THIS CORPUS WAS MEASURED BEFORE THE CODE WAS WRITTEN,
    ; with the five stop tags temporarily carrying `t.flags` in their detail column
    ; instead of the operator kind. Over stage 1's 1 440 units, exactly THREE
    ; distinct type flags reach a live call: NumberLiteral (77 events),
    ; StringLiteral (2) and Null (1) — every other arrival has a nil operand type,
    ; i.e. the operand's own chapter stopped first. So the literal arms are the
    ; ones this corpus exercises, the object arm's EARLY-OUT is what the call and
    ; the `??` operator actually take, and the union and intersection arms have no
    ; input at all — nothing in this port sets TypeFlagsUnion (get_widened_literal_
    ; type's arm has said so since slice 71).
    procedure get_type_facts(this, t: ref[Type], mask: int) returns int
        this.get_type_facts_worker(t, mask) & mask

    procedure has_type_facts(this, t: ref[Type], mask: int) returns bool
        this.get_type_facts(t, mask) <> 0

    ; getTypeFactsWorker, whole.
    ;
    ; ★★★ THE OBJECT ARM'S EARLY-OUT IS NOT AN OPTIMISATION HERE — IT IS THE ONLY
    ; REASON THE ARM HAS AN ANSWER AT ALL. Upstream it exists to skip resolving
    ; members; here it decides whether the arm reaches a wall, because everything
    ; below it (isEmptyObjectType → isGenericMappedType and anyFunctionType,
    ; isFunctionObjectType → isTypeSubtypeOf and globalFunctionType) is unported.
    ; And the two masks the callers of this slice pass are exactly the ones that
    ; take it: `IsUndefinedOrNull` (checkNonNullType) and `EQUndefinedOrNull` (`??`)
    ; are in NONE of the three possible object facts under strictNullChecks, so an
    ; object type answers TypeFactsNone without touching a member. `Truthy` (`&&`)
    ; and `Falsy` (`||`) are in them, so those two do meet the wall — which is the
    ; whole difference between the three logical operators and is stated here
    ; rather than at each of them.
    ;
    ; ★★ `callerOnlyNeeds` IS THE MASK AND NOT A SECOND ONE. getTypeFacts ANDs the
    ; answer with the same value afterwards, so the parameter is the caller's mask
    ; travelling one level down — which is what makes the early-out sound: a fact
    ; the caller is not asking about would be masked off anyway.
    ;
    ; ★ The non-strict half of every pair is DEAD under this harness for
    ; get_apparent_type's reason — strict_null_checks is a constant TRUE here — and
    ; is written as the reference's own test rather than folded away.
    ; isEmptyResolvedType and isEmptyObjectType, slice 117.
    ;
    ; ★ `t.AsType() != c.anyFunctionType` is TRUE for every type this port can
    ; build: the anyFunctionType sentinel has no producer here (§3.5be), so the term
    ; is written as the containment argument it is rather than as a comparison
    ; against a field that does not exist.
    procedure is_empty_resolved_type(this, t: ref[Type]) returns bool
    {
        let sm this.resolve_structured_type_members(t)
        if sm = null
            return false
        let m sm as ref[StructuredMembers]
        if m.properties <> null
        {
            if (m.properties as ref[Array[ref[Symbol]?]]).get_length() <> 0
                return false
        }
        if m.signatures <> null
        {
            if (m.signatures as ref[Array[ref[Signature]?]]).get_length() <> 0
                return false
        }
        if m.index_infos <> null
        {
            if (m.index_infos as ref[Array[ref[IndexInfo]?]]).get_length() <> 0
                return false
        }
        true
    }


    ; isFunctionObjectType. ★★ THE SECOND DISJUNCT IS THE ONLY WALL AND THE
    ; REFERENCE'S OWN COMMENT IS WHY: *a quick check for a "bind" property before
    ; performing the more expensive subtype check*. No signatures and no member
    ; named `bind` answers FALSE with no relation asked, which is every ordinary
    ; object type; a `bind` member and no signature is where isTypeSubtypeOf against
    ; the global Function type is needed, and that is the stop.
    procedure is_function_object_type(this, t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsEvolvingArray) <> 0
            return false
        let sm this.resolve_structured_type_members(t)
        if sm = null
            return false
        let m sm as ref[StructuredMembers]
        if m.signatures <> null
        {
            if (m.signatures as ref[Array[ref[Signature]?]]).get_length() <> 0
                return true
        }
        if m.members = null
            return false
        ; ★ `bind` is a REAL property name, so the lookup key is the plain bytes —
        ; internal_name would put the 0xFE prefix in front of it and the table would
        ; never answer (see internal_name_unprefixed's own note at `this`).
        var bd Slice[char]()
        set bd: Binder.internal_name_unprefixed(host, "bind")
        if SymbolTable.get(m.members, bd) = null
            return false
        ; ★ The stop that stood here named the subtype check as the wall; the
        ; relation and the global `Function` type are both here, and upstream's
        ; second disjunct is this one call.
        let gf this.get_global_function_type()
        if gf = null
            return false
        this.is_type_subtype_of(t, gf as ref[Type])
    }

    procedure get_type_facts_worker(this, t: ref[Type], caller_only_needs: int) returns int
    {
        let facts_mark this.unported_mark()
        var base: ref[Type]? t
        if (t.flags & (TypeFlagsIntersection | TypeFlagsInstantiable)) <> 0
        {
            let mark this.unported_mark()
            let constraint this.get_base_constraint_of_type(t)
            if this.unported_mark() <> mark
                return TypeFactsNone
            if constraint = null
                set base: unknown_type
            if constraint <> null
                set base: constraint
        }
        let ty base as ref[Type]
        let flags ty.flags

        if (flags & (TypeFlagsString | TypeFlagsStringMapping)) <> 0
        {
            if Checker.strict_null_checks()
                return TypeFactsStringStrictFacts
            return TypeFactsStringFacts
        }
        if (flags & (TypeFlagsStringLiteral | TypeFlagsTemplateLiteral)) <> 0
        {
            ; `getStringLiteralValue(t) == ""` is asked of the StringLiteral half
            ; only — a template literal TYPE carries no literal payload, and the
            ; reference's own conjunct is what keeps it out.
            var is_empty false
            if (flags & TypeFlagsStringLiteral) <> 0
            {
                if Checker.literal_text_length_of(ty) = 0
                    set is_empty: true
            }
            if Checker.strict_null_checks()
            {
                if is_empty
                    return TypeFactsEmptyStringStrictFacts
                return TypeFactsNonEmptyStringStrictFacts
            }
            if is_empty
                return TypeFactsEmptyStringFacts
            return TypeFactsNonEmptyStringFacts
        }
        if (flags & (TypeFlagsNumber | TypeFlagsEnum)) <> 0
        {
            if Checker.strict_null_checks()
                return TypeFactsNumberStrictFacts
            return TypeFactsNumberFacts
        }
        if (flags & TypeFlagsNumberLiteral) <> 0
        {
            ; ★★ `getNumberLiteralValue(t) == 0` IS A VALUE TEST AND THE PAYLOAD IS
            ; BITS, so NEGATIVE ZERO has to be named: `-0 == 0` holds in Go and in
            ; JavaScript, and the two have different IEEE-754 encodings. ★This port
            ; interns a number literal type BY ITS BITS while the reference keys a
            ; Go map on the float64, where -0 and +0 are one key — so the two zeroes
            ; are one type upstream and two here. That divergence is
            ; get_number_literal_type's and predates this slice; what this arm owes
            ; is only that both of them answer ZERO.
            var is_zero false
            if Checker.literal_bits_of(ty) = 0 as u64
                set is_zero: true
            if Checker.literal_bits_of(ty) = 0x8000000000000000
                set is_zero: true
            if Checker.strict_null_checks()
            {
                if is_zero
                    return TypeFactsZeroNumberStrictFacts
                return TypeFactsNonZeroNumberStrictFacts
            }
            if is_zero
                return TypeFactsZeroNumberFacts
            return TypeFactsNonZeroNumberFacts
        }
        if (flags & TypeFlagsBigInt) <> 0
        {
            if Checker.strict_null_checks()
                return TypeFactsBigIntStrictFacts
            return TypeFactsBigIntFacts
        }
        if (flags & TypeFlagsBigIntLiteral) <> 0
        {
            if Checker.strict_null_checks()
            {
                if Checker.is_zero_big_int(ty)
                    return TypeFactsZeroBigIntStrictFacts
                return TypeFactsNonZeroBigIntStrictFacts
            }
            if Checker.is_zero_big_int(ty)
                return TypeFactsZeroBigIntFacts
            return TypeFactsNonZeroBigIntFacts
        }
        if (flags & TypeFlagsBoolean) <> 0
        {
            if Checker.strict_null_checks()
                return TypeFactsBooleanStrictFacts
            return TypeFactsBooleanFacts
        }
        if (flags & TypeFlagsBooleanLike) <> 0
        {
            ; The test is IDENTITY against both members of the false pair, not the
            ; stored value: the reference asks `t == c.falseType || t ==
            ; c.regularFalseType`, and both are minted eagerly here.
            var is_false false
            if ty = false_type
                set is_false: true
            if ty = regular_false_type
                set is_false: true
            if Checker.strict_null_checks()
            {
                if is_false
                    return TypeFactsFalseStrictFacts
                return TypeFactsTrueStrictFacts
            }
            if is_false
                return TypeFactsFalseFacts
            return TypeFactsTrueFacts
        }
        if (flags & TypeFlagsObject) <> 0
        {
            var possible: int TypeFactsEmptyObjectFacts | TypeFactsFunctionFacts | TypeFactsObjectFacts
            if Checker.strict_null_checks()
                set possible: TypeFactsEmptyObjectStrictFacts | TypeFactsFunctionStrictFacts | TypeFactsObjectStrictFacts
            ; "If the caller doesn't care about any of the facts that we could
            ; possibly produce, return zero so we can skip resolving members."
            if (caller_only_needs & possible) = 0
                return TypeFactsNone
            ; ★★★ THE THREE ARMS BELOW WERE ONE ROW AND THE WALL WAS SMALLER THAN
            ; THE NOTE SAID — slice 117 opened it because the destructuring chapter
            ; asks this function about the SOURCE of every `const {a} = o`. The
            ; sentence that stood here read *isFunctionObjectType wants
            ; isTypeSubtypeOf and globalFunctionType*, which is true of the SECOND
            ; disjunct only: the reference's own comment calls the first one *a
            ; quick check for a "bind" property before performing the more
            ; expensive subtype check*, so an object type with no call signature and
            ; no member named `bind` answers FALSE without the relation. The
            ; population behind the relation is an object that HAS a `bind` member
            ; and no signatures, and that is the stop.
            ;
            ; ★★ isEmptyObjectType's own two terms are answerable too: the
            ; anyFunctionType sentinel is unminted, so `resolved != anyFunctionType`
            ; is TRUE by the same containment argument that made it look like a
            ; wall, and isGenericMappedType is the zero flag test declared with the
            ; indexed-access family. What is left is three lengths.
            if (ty.object_flags & ObjectFlagsAnonymous) <> 0
            {
                if this.is_empty_object_type(ty)
                {
                    if this.unported_mark() <> facts_mark
                        return TypeFactsNone
                    if Checker.strict_null_checks()
                        return TypeFactsEmptyObjectStrictFacts
                    return TypeFactsEmptyObjectFacts
                }
                if this.unported_mark() <> facts_mark
                    return TypeFactsNone
            }
            if this.is_function_object_type(ty)
            {
                if this.unported_mark() <> facts_mark
                    return TypeFactsNone
                if Checker.strict_null_checks()
                    return TypeFactsFunctionStrictFacts
                return TypeFactsFunctionFacts
            }
            if this.unported_mark() <> facts_mark
                return TypeFactsNone
            if Checker.strict_null_checks()
                return TypeFactsObjectStrictFacts
            return TypeFactsObjectFacts
        }
        if (flags & TypeFlagsVoid) <> 0
            return TypeFactsVoidFacts
        if (flags & TypeFlagsUndefined) <> 0
            return TypeFactsUndefinedFacts
        if (flags & TypeFlagsNull) <> 0
            return TypeFactsNullFacts
        if (flags & TypeFlagsESSymbolLike) <> 0
        {
            if Checker.strict_null_checks()
                return TypeFactsSymbolStrictFacts
            return TypeFactsSymbolFacts
        }
        if (flags & TypeFlagsNonPrimitive) <> 0
        {
            if Checker.strict_null_checks()
                return TypeFactsObjectStrictFacts
            return TypeFactsObjectFacts
        }
        if (flags & TypeFlagsNever) <> 0
            return TypeFactsNone
        ; ★★★ SLICE 133 — the two CONSTITUENT arms. The note that stood on the
        ; union one read *"nothing in this port sets TypeFlagsUnion, so this is a
        ; gate with a report rather than a comment"*, and it had EXPIRED: unions
        ; have been minted since the type algebra landed, which is why 17 units
        ; were arriving at a row whose comment said none could.
        ; ★★★ THE TWO CONSTITUENT ARMS ASK `ty`, NOT `t`, AND UNTIL SLICE 185 THEY
        ; ASKED `t`. Upstream REBINDS — `t = c.getBaseConstraintOfType(t)` — so
        ; every arm below reads the constraint; this port gave the constraint a new
        ; name and these two kept the original. The cost is exact and it is the
        ; commonest generic shape there is: for a TYPE PARAMETER whose constraint
        ; is a union, `union_types_of(t)` answers null and the whole function
        ; returned TypeFactsNone — so filter_type_by_facts filtered the parameter
        ; out and every narrowing of it answered `never`. Six stage-2 units, and
        ; `T extends {x: string} | undefined` narrowed by `obj?.x === "hello"`
        ; printed `never` where the reference prints `NonNullable<T>`.
        if (flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(ty)
            if types = null
                return TypeFactsNone
            let ts types as ref[Array[ref[Type]?]]
            let n ts.get_length() as int
            var facts TypeFactsNone
            var i 0
            while i < n
            {
                let member ts[i]
                if member = null
                    return TypeFactsNone
                set facts: facts | this.get_type_facts_worker(member as ref[Type], caller_only_needs)
                set i: i + 1
            }
            return facts
        }
        if (flags & TypeFlagsIntersection) <> 0
            return this.get_intersection_type_facts(ty, caller_only_needs)
        TypeFactsUnknownFacts
    }

    ; getIntersectionTypeFacts, whole.
    ;
    ; ★★★ THE TWO MASKS ARE NOT A DETAIL: `typeof x === "function"` and
    ; `typeof x !== "object"` are ORed across the constituents and everything else
    ; is ANDed, so an intersection is truthy only when EVERY member is and is
    ; callable when ANY member is. ★And an intersection carrying a PRIMITIVE
    ; ignores its object members outright — the reference's own comment calls them
    ; type tags, as in `string & { __kind__: "name" }`.
    procedure get_intersection_type_facts(this, t: ref[Type], caller_only_needs: int) returns int
    {
        let types Checker.intersection_types_of(t)
        if types = null
            return TypeFactsNone
        let ts types as ref[Array[ref[Type]?]]
        let n ts.get_length() as int
        let ignore_objects Checker.maybe_type_of_kind(t, TypeFlagsPrimitive)
        var ored TypeFactsNone
        var anded TypeFactsAll
        var i 0
        while i < n
        {
            let member ts[i]
            if member = null
                return TypeFactsNone
            let m member as ref[Type]
            var skip false
            if ignore_objects
            {
                if (m.flags & TypeFlagsObject) <> 0
                    set skip: true
            }
            if skip = false
            {
                let f this.get_type_facts_worker(m, caller_only_needs)
                set ored: ored | f
                set anded: anded & f
            }
            set i: i + 1
        }
        (ored & TypeFactsOrFactsMask) | (anded & TypeFactsAndFactsMask)
    }

    ; isZeroBigInt. `getBigIntLiteralValue(t) == jsnum.PseudoBigInt{}` compares the
    ; whole struct against its zero value, and the reference's representation of a
    ; zero BigInt literal is the EMPTY base-10 string with a false sign — which is
    ; the same length test pseudo_big_int_to_string already makes, from the other
    ; side.
    function is_zero_big_int(t: ref[Type]) returns bool
    {
        if Checker.literal_text_length_of(t) <> 0
            return false
        if Checker.literal_negative_of(t)
            return false
        true
    }

    ; ── the ARRAY LITERAL element's contextual type (slice 135) ─────────────
    ;
    ; getContextualTypeForElementExpression, the frontier's third largest row. It
    ; is mapTypeEx with noReductions over a mapper whose four captures are
    ; INTEGERS, which is why it needed a map-type kind and not a fixed predicate.
    ;
    ; ★ The FIRST LINE is `if t == nil return nil`, which is what let the caller
    ; stop one step early until now: with no contextual type on the array, neither
    ; the element index nor the spread scan can change the answer.
    procedure get_contextual_type_for_element_expression(this, t: ref[Type]?, index: int, length: int, first_spread_index: int, last_spread_index: int) returns ref[Type]?
    {
        if t = null
            return null
        var a_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, index, length, first_spread_index, last_spread_index, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
        let a &a_value as ref[MapTypeArgs]?
        this.map_type_ex(t as ref[Type], MapTypeKindContextualElement, a, true)
    }

    ; The mapper itself, per constituent.
    ;
    ; ★★★ THE TUPLE ARM ASKS THREE DIFFERENT QUESTIONS AND THE ORDER IS THE
    ; ANSWER. Before any spread and inside the fixed HEAD, the element's own type;
    ; after every spread and inside the fixed TAIL, the element counted from the
    ; end; otherwise a union of everything the middle could be, built WITHOUT
    ; subtype reduction so a contextual type never collapses two candidates the
    ; author distinguished.
    procedure contextual_type_of_element_constituent(this, t: ref[Type], index: int, length: int, first_spread_index: int, last_spread_index: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if Checker.is_tuple_type(t)
        {
            let target Checker.target_of(t)
            if target = null
                return null
            let tgt target as ref[Type]
            var before_spread false
            if first_spread_index < 0
                set before_spread: true
            if index < first_spread_index
                set before_spread: true
            if before_spread
            {
                if index < Checker.tuple_fixed_length_of(tgt)
                {
                    let args this.get_type_arguments(t)
                    if this.unported_mark() <> mark
                        return null
                    if args = null
                        return null
                    let list args as ref[Array[ref[Type]?]]
                    if index >= (list.get_length() as int)
                        return null
                    let elem list[index]
                    if elem = null
                        return null
                    let optional (Checker.tuple_element_flags_at(tgt, index) & ElementFlagsOptional) <> 0
                    return this.remove_missing_type(elem as ref[Type], optional)
                }
            }
            var offset 0
            if length >= 0
            {
                var after_spread false
                if last_spread_index < 0
                    set after_spread: true
                if index > last_spread_index
                    set after_spread: true
                if after_spread
                    set offset: length - index
            }
            var fixed_end_length 0
            if offset > 0
            {
                if (Checker.tuple_combined_flags_of(tgt) & ElementFlagsVariable) <> 0
                    set fixed_end_length: Checker.get_end_element_count(tgt, ElementFlagsFixed)
            }
            if offset > 0
            {
                if offset <= fixed_end_length
                {
                    let args this.get_type_arguments(t)
                    if this.unported_mark() <> mark
                        return null
                    if args = null
                        return null
                    let list args as ref[Array[ref[Type]?]]
                    let at Checker.get_type_reference_arity(t) - offset
                    if at < 0
                        return null
                    if at >= (list.get_length() as int)
                        return null
                    return list[at]
                }
            }
            var tuple_index Checker.tuple_fixed_length_of(tgt)
            if first_spread_index >= 0
            {
                if first_spread_index < tuple_index
                    set tuple_index: first_spread_index
            }
            var end_skip_count fixed_end_length
            if length >= 0
            {
                if last_spread_index >= 0
                {
                    let tail length - last_spread_index
                    if tail < end_skip_count
                        set end_skip_count: tail
                }
            }
            return this.get_element_type_of_slice_of_tuple_type(t, tuple_index, end_skip_count, false, true)
        }
        var before_spread false
        if first_spread_index < 0
            set before_spread: true
        if index < first_spread_index
            set before_spread: true
        if before_spread
        {
            var nd Slice[char]()
            set nd: Checker.decimal_name(host, index)
            let prop_type this.get_type_of_property_of_contextual_type(t, nd)
            if this.unported_mark() <> mark
                return null
            if prop_type <> null
                return prop_type
        }
        this.get_iterated_type_or_element_type(IterationUseElement, t, undefined_type, null, false)
    }

    ; getStartElementCount — how many of a tuple's LEADING elements carry `flags`.
    function get_start_element_count(t: ref[Type], flags: int) returns int
    {
        let infos Checker.tuple_element_infos_of(t)
        if infos = null
            return 0
        let list infos as ref[Array[ref[TupleElementInfo]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            if (Checker.tuple_info_flags_at(list, i) & flags) = 0
                return i
            set i: i + 1
        }
        n
    }

    ; getEndElementCount — how many of a tuple's TRAILING elements carry `flags`.
    function get_end_element_count(t: ref[Type], flags: int) returns int
    {
        let infos Checker.tuple_element_infos_of(t)
        if infos = null
            return 0
        let list infos as ref[Array[ref[TupleElementInfo]?]]
        let n list.get_length() as int
        var i n
        while i > 0
        {
            if (Checker.tuple_info_flags_at(list, i - 1) & flags) = 0
                return n - i
            set i: i - 1
        }
        n
    }

    ; getTotalFixedElementCount — the tuple's fixed head plus its trailing fixed
    ; run. Its parameter is the TUPLE TARGET, as upstream's `*TupleType` is.
    function get_total_fixed_element_count(target: ref[Type]) returns int
        Checker.tuple_fixed_length_of(target) + Checker.get_end_element_count(target, ElementFlagsFixed)

    ; …and the same question asked of a tuple type REFERENCE, which is the form
    ; every call site upstream spells `getTotalFixedElementCount(t.TargetTupleType())`.
    ; ★A reference whose target this port cannot read answers 0, which is what the
    ; unguarded reads answered for every tuple before slice 176 (§3.5he).
    function get_total_fixed_element_count_of(t: ref[Type]) returns int
    {
        let target Checker.target_of(t)
        if target = null
            return 0
        Checker.get_total_fixed_element_count(target as ref[Type])
    }

    ; getSpreadIndices — the first and last SpreadElement positions of an array
    ; literal, written into the two out-cells.
    ;
    ; ★ The reference memoises this on an arrayLiteralLinks row. The memo is not
    ; carried: the answer is a pure function of the element list, so a miss costs
    ; a walk over a list the caller is already indexing into.
    procedure get_spread_indices(node: ref[AstNode], first: ref[int], last: ref[int])
    {
        set first: 0 - 1
        set last: 0 - 1
        let elements AstNode.elements_of(node)
        let n AstNode.list_count(elements)
        var i 0
        while i < n
        {
            let e AstNode.child_in_list(elements, i)
            if e <> null
            {
                if AstNode.kind_of(e as ref[AstNode]) = KindSpreadElement
                {
                    if first < 0
                        set first: i
                    set last: i
                }
            }
            set i: i + 1
        }
    }

    ; `getUnionTypeEx([GetNonNullableType(x), rightType], UnionReductionSubtype)`
    ; — the tail `||` and `??` share, written once because the two arms differ
    ; only in what they hand it.
    procedure union_of_non_nullable_and_right(this, t: ref[Type], right_type: ref[Type]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let nn this.get_non_nullable_type(t)
        if this.unported_mark() <> mark
            return null
        if nn = null
            return null
        let pair &Array[ref[Type]?]()
        pair.add(nn)
        pair.add(right_type)
        let u this.get_union_type_ex(pair, UnionReductionSubtype, null, null)
        if this.unported_mark() <> mark
            return null
        u
    }

    ; ── the DEFINITELY FALSY family (slice 135) ─────────────────────────────
    ;
    ; The three answers behind `&&`, `||` and `??` — the row `filter-type` named,
    ; the frontier's eighth largest.
    ;
    ; ★★★ removeDefinitelyFalsyTypes IS ALREADY IN THIS FILE UNDER ANOTHER NAME:
    ; `filterType(t, hasTypeFacts(t, Truthy))` is exactly filter_type_by_facts
    ; with TypeFactsTruthy, which slice 90 wrote for getTypeWithFacts. So of the
    ; three answers the row was standing on, one needed nothing at all — which is
    ; the same shape as the stops slices 131–133 harvested, seen from inside a
    ; chapter rather than from the frontier.
    procedure remove_definitely_falsy_types(this, t: ref[Type]) returns ref[Type]?
        this.filter_type_by_facts(t, TypeFactsTruthy)

    procedure extract_definitely_falsy_types(this, t: ref[Type]) returns ref[Type]?
        this.map_type(t, MapTypeKindDefinitelyFalsyPart, null)

    ; getDefinitelyFalsyPartOfType. ★The three primitive domains answer their own
    ; falsy INHABITANT rather than themselves — `string` becomes `""` — which is
    ; what makes `s && x` answer `"" | X` and not `string | X`.
    function get_definitely_falsy_part_of_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsString) <> 0
            return empty_string_type
        if (t.flags & TypeFlagsNumber) <> 0
            return zero_type
        if (t.flags & TypeFlagsBigInt) <> 0
            return zero_big_int_type
        var itself false
        if t = regular_false_type
            set itself: true
        if t = false_type
            set itself: true
        if (t.flags & (TypeFlagsVoid | TypeFlagsUndefined | TypeFlagsNull | TypeFlagsAnyOrUnknown)) <> 0
            set itself: true
        if (t.flags & TypeFlagsStringLiteral) <> 0
        {
            if Checker.literal_text_length_of(t) = 0
                set itself: true
        }
        if (t.flags & TypeFlagsNumberLiteral) <> 0
        {
            ; `getNumberLiteralValue(t) == 0`, and it must be the VALUE and not the
            ; bits: negative zero is a different bit pattern and the same number.
            let bits Checker.literal_bits_of(t)
            let zero jsnum_from_int(0)
            if jsnum_at_least(bits, zero)
            {
                if jsnum_at_least(zero, bits)
                    set itself: true
            }
        }
        if (t.flags & TypeFlagsBigIntLiteral) <> 0
        {
            if Checker.is_zero_big_int(t)
                set itself: true
        }
        if itself
            return t
        never_type
    }

    ; checkNonNullExpression and checkNonNullType, the two wrappers.
    procedure check_non_null_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t this.check_expression(node)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        this.check_non_null_type(t as ref[Type], node)
    }

    ; ── the optional CALL chain (slice 139) ─────────────────────────────────
    ;
    ; ★★★ THE TWO STOPS THIS SLICE RETIRED HERE NAMED A FUNCTION THAT WAS ALREADY
    ; IN THE FILE, AND THAT IS §3.5eo'S SHARPEST FORM YET. One read *GetNonNullableType
    ; at an optional-chain ROOT and removeOptionalTypeMarker inside one … machinery
    ; this port does not have*, the other *the optional-chain marker removal, which
    ; this port has no producer for* — and `get_optional_expression_type` sits four
    ; thousand lines below, beside check_non_null_chain, which has been calling it
    ; since the chain arrived. Nothing had to be WRITTEN for either site; the notes
    ; were the whole obstacle. ★★★A first draft of this slice re-ported it here as a
    ; DUPLICATE definition, which the compiler accepts in silence: when a stop names
    ; a callee as absent, grep for the callee before writing it.
    ;
    ; getOptionalCallSignature — cloneSignature under the call-chain bits, memoised
    ; per (signature, inner/outer). ★The cache is the file's own association list
    ; over `cached_signatures` with two kinds of its own, so an optional-call clone
    ; cannot collide with a base or an erased signature; the reference keys the same
    ; two by its SignatureKeyInner/Outer sentinels.
    procedure get_optional_call_signature(this, signature: ref[Signature], call_chain_flags: int) returns ref[Signature]?
    {
        if (signature.flags & SignatureFlagsCallChainFlags) = call_chain_flags
            return signature
        var kind SignatureCacheKindOptionalOuter
        if call_chain_flags = SignatureFlagsIsInnerCallChain
            set kind: SignatureCacheKindOptionalInner
        let cached this.signature_cache_lookup(signature, kind)
        if cached <> null
            return cached
        let result this.clone_signature(signature)
        set result.flags: result.flags | call_chain_flags
        let row &CachedSignature^host(signature, kind, null, result)
        Checker.signature_cache_add(signature, row)
        result
    }

    procedure check_non_null_type(this, t: ref[Type], node: ref[AstNode]) returns ref[Type]?
        this.check_non_null_type_with_reporter(t, node, false)

    ; checkNonNullNonVoidType, slice 117 — checkNonNullType plus a VOID report,
    ; and WHOLE since slice 148.
    ;
    ; ★★★ ITS ENTITY-NAME HALF HAS NO INPUT FROM THIS SLICE'S CALLER AND IS WRITTEN
    ; ANYWAY. Both call sites in checkVariableLikeDeclaration pass the DECLARATION
    ; as the error node, and a VariableDeclaration is not an entity-name expression
    ; under any tree the parser builds — so the three reports the reference chooses
    ; between still collapse to the last one on today's input. What stood here was
    ; a STOP on the text, on the argument that the FIRST caller passing an
    ; expression (the `.` access family) would otherwise get TS2532 where the
    ; reference gives TS18048; the argument was right and the mechanism is here
    ; now, so the fork answers instead of reporting.
    procedure check_non_null_non_void_type(this, t: ref[Type], node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let non_null this.check_non_null_type(t, node)
        if this.unported_mark() <> mark
            return null
        if non_null = null
            return null
        let nn non_null as ref[Type]
        if (nn.flags & TypeFlagsVoid) <> 0
        {
            if Checker.is_entity_name_expression(node)
            {
                let sb StringBuilder^host()
                let wrote this.write_entity_name(node, &sb)
                if this.unported_mark() <> mark
                    return nn
                if wrote = false
                    return nn
                if AstNode.kind_of(node) = KindIdentifier
                {
                    if Checker.text_equals(this.source_text_of_node(node), "undefined")
                    {
                        this.error_on_node(node, DiagThe_value_0_cannot_be_used_here, sb.to_string())
                        return nn
                    }
                }
                ; ★ The reference's length test has no lower bound here — unlike
                ; reportObjectPossiblyNullOrUndefinedError, which asks for a
                ; NON-EMPTY text first — so an empty name takes the named report
                ; and not the anonymous one. Transcribed as written.
                if (sb.get_length() as int) < 100
                {
                    this.error_on_node(node, DiagX_0_is_possibly_undefined, sb.to_string())
                    return nn
                }
            }
            this.error_on_node(node, DiagObject_is_possibly_undefined)
        }
        nn
    }

    ; checkNonNullTypeWithReporter.
    ;
    ; ★★★ THE `reportError` FUNC VALUE IS A FLAG (§3.5e), AND THIS IS THE FIRST ONE
    ; IN THIS PORT WHOSE TWO CALLEES DIVERGE ON WHETHER THEY CAN BE PORTED AT ALL.
    ; `reportCannotInvokePossiblyNullOrUndefinedError` reads nothing but the facts
    ; — three codes, one fork — so it is written out below. Its sibling
    ; `reportObjectPossiblyNullOrUndefinedError` picks between SIX codes on
    ; `entityNameToString(node)` and its LENGTH, and this port has no
    ; getTextOfNode: choosing among six codes without the mechanism that decides
    ; would be an invented diagnostic, which is the one thing diagcheck's
    ; subsequence relation is red on. So SIX of its seven codes are a row —
    ; **and the seventh is not, because it is decided ABOVE the text**: see
    ; report_object_possibly_null_or_undefined_error.
    ; ★★That is what gives the flag a READER, which §3.5be demands of any flag at
    ; all — the two branches do different things here, not merely call different
    ; functions.
    ;
    ; ★★★ THE unknown ARM IS WRITTEN SINCE SLICE 176, AND ITS FORK IS A LENGTH
    ; AND NOT A STRING. The stop that stood here said the arm was *"behind the
    ; same missing mechanism as the reporter above: the fork is
    ; `len(nodeText) < 100`"* — and the whole of what that string decides here is
    ; a LENGTH: `entityNameToString`'s other use is as the message's `{0}`, and
    ; this port's diagnostics carry no arguments at all (`error_on_node` takes a
    ; node and a code), while the yardstick compares code and span. So
    ; `entity_name_text_length` computes what `EntityNameToString` would have
    ; MEASURED — the identifier texts and the dots between them — and the two
    ; codes fork on it. ★It is NOT the reporter above's mechanism: that one picks
    ; among SIX codes on the text's CONTENT, which a length cannot answer.
    ;
    ; ★ The nullable branch's ANSWER is GetNonNullableType → getAdjustedTypeWith
    ; Facts → mapType and getUnionType, i.e. the same union machinery every other
    ; arm of this file stops at. Report first, then stop: that is the reference's
    ; own order, and the report is real product even when the type is not.
    ; ast.EntityNameToString's LENGTH — the identifier texts of an entity-name
    ; expression plus one separator per hop. ★★The reference's `getTextOfNode`
    ; branch and its synthesized-node branch measure the same thing for an
    ; identifier: the source slice of a non-synthesized identifier IS its text,
    ; trivia having been skipped. `this` is four, as upstream's literal is.
    function entity_name_text_length(n: ref[AstNode]?) returns int
    {
        if n = null
            return 0
        let node n as ref[AstNode]
        if node.kind = KindThisKeyword
            return 4
        if node.kind = KindIdentifier
            return AstNode.identifier_text_length_of(node)
        if node.kind = KindPrivateIdentifier
            return AstNode.identifier_text_length_of(node)
        if node.kind = KindQualifiedName
            return Checker.entity_name_text_length(AstNode.qualified_left_of(node)) + 1 + Checker.entity_name_text_length(AstNode.qualified_right_of(node))
        if node.kind = KindPropertyAccessExpression
            return Checker.entity_name_text_length(AstNode.expression_of(node)) + 1 + Checker.entity_name_text_length(AstNode.property_access_name_of(node))
        if node.kind = KindJsxNamespacedName
            return Checker.entity_name_text_length(AstNode.namespaced_namespace_of(node)) + 1 + Checker.entity_name_text_length(AstNode.namespaced_name_of(node))
        0
    }

    procedure check_non_null_type_with_reporter(this, t: ref[Type], node: ref[AstNode], report_cannot_invoke: bool) returns ref[Type]?
    {
        if Checker.strict_null_checks()
        {
            if (t.flags & TypeFlagsUnknown) <> 0
            {
                if Parser.is_entity_name_expression_ex(node, false)
                {
                    if Checker.entity_name_text_length(node) < 100
                    {
                        this.error_on_node(node, DiagX_0_is_of_type_unknown, this.entity_name_arg(node))
                        return error_type
                    }
                }
                this.error_on_node(node, DiagObject_is_of_type_unknown)
                return error_type
            }
        }
        let mark this.unported_mark()
        let facts this.get_type_facts(t, TypeFactsIsUndefinedOrNull)
        if this.unported_mark() <> mark
            return null
        if (facts & TypeFactsIsUndefinedOrNull) <> 0
        {
            var reported false
            if report_cannot_invoke
            {
                this.report_cannot_invoke_possibly_null_or_undefined_error(node, facts)
                set reported: true
            }
            else
                set reported: this.report_object_possibly_null_or_undefined_error(node, facts)
            ; ★The note that stood here made GetNonNullableType the wall on the
            ; REPORTED half too; getAdjustedTypeWithFacts arrived with the
            ; type-facts chapter, so only the reporter's own stop remains.
            if reported = false
            {
                this.record_unported("report-object-possibly-null-or-undefined", t.flags)
                return null
            }
            ; ★★★ THE GUARD UNDER THE CALL IS THE HALF THAT MATTERS HERE: a type
            ; whose non-nullable remainder is still nullable, or is `never`,
            ; answers the ERROR type. `null()` is exactly that shape — the
            ; remainder is `never` — and without the guard the callee came back as
            ; `never`, which is not callable, so TS2349 and TS2351 were reported on
            ; top of the TS2721 the reference stops at.
            let nn this.get_non_nullable_type(t)
            if this.unported_mark() <> mark
                return null
            if nn = null
                return null
            let n2 nn as ref[Type]
            if (n2.flags & (TypeFlagsNullable | TypeFlagsNever)) <> 0
                return error_type
            return n2
        }
        t
    }

    ; reportObjectPossiblyNullOrUndefinedError, WHOLE (slice 148) — all seven
    ; codes. It still answers whether it REPORTED, which the reference does not
    ; need because it always does; the bool is now a constant `true` on every path
    ; except a stop inside the text, and the caller's row survives for that one.
    ;
    ; ★★★ THE HISTORY IS THE POINT AND IT IS KEPT: six of these seven codes were
    ; WRITTEN AND TAKEN BACK OUT IN SLICE 147, because they cost one INVENTED
    ; diagnostic — `compiler_thisPropertyAssignmentTyping` collected TS2532 at two
    ; spans the reference does not report at all. **The report was a faithful
    ; consequence of a WRONG TYPE**, and the wrong type came from
    ; `get_type_of_expression` testing the unit-wide latch `is_unported()` where a
    ; per-call mark belonged: once anything in a unit had stopped, every later
    ; expression answered null, so a `this.foo` narrowed by an assignment in one
    ; class stopped being narrowed the moment ANOTHER class stopped first. That is
    ; fixed in this slice at all thirty-one sites, and
    ; `tests/fixtures/checker_this_property_flow_probe.js` is the witness: it now
    ; records exactly the stops its first class records alone.
    ;
    ; ★★ THE KIND TEST SITS ABOVE THE TEXT and stays first: `null` is the only
    ; nullable type this port answers from an expression without a symbol table,
    ; so in this corpus it is the branch most arrivals take, and it was 87 of the
    ; slice-124 chapter's 93 new diagnostics.
    ;
    ; ★ The `undefined` arm asks the SOURCE text and not the scanned one — see
    ; source_text_of_node — and it is asked only for an IDENTIFIER, where the
    ; composed entity name IS that range.
    procedure report_object_possibly_null_or_undefined_error(this, node: ref[AstNode], facts: int) returns bool
    {
        if AstNode.kind_of(node) = KindNullKeyword
        {
            this.error_on_node(node, DiagThe_value_0_cannot_be_used_here, "null")
            return true
        }
        if Checker.is_entity_name_expression(node)
        {
            let mark this.unported_mark()
            let sb StringBuilder^host()
            let wrote this.write_entity_name(node, &sb)
            if this.unported_mark() <> mark
                return false
            if wrote = false
                return false
            let text_length sb.get_length() as int
            if text_length > 0
            {
                if text_length < 100
                {
                    if AstNode.kind_of(node) = KindIdentifier
                    {
                        if Checker.text_equals(this.source_text_of_node(node), "undefined")
                        {
                            this.error_on_node(node, DiagThe_value_0_cannot_be_used_here, "undefined")
                            return true
                        }
                    }
                    var named DiagX_0_is_possibly_null
                    if (facts & TypeFactsIsUndefined) <> 0
                    {
                        set named: DiagX_0_is_possibly_undefined
                        if (facts & TypeFactsIsNull) <> 0
                            set named: DiagX_0_is_possibly_null_or_undefined
                    }
                    this.error_on_node(node, named, sb.to_string())
                    return true
                }
            }
        }
        var anonymous DiagObject_is_possibly_null
        if (facts & TypeFactsIsUndefined) <> 0
        {
            set anonymous: DiagObject_is_possibly_undefined
            if (facts & TypeFactsIsNull) <> 0
                set anonymous: DiagObject_is_possibly_null_or_undefined
        }
        this.error_on_node(node, anonymous)
        true
    }

    ; reportCannotInvokePossiblyNullOrUndefinedError, whole — three codes and one
    ; nested fork on the facts, and nothing else.
    procedure report_cannot_invoke_possibly_null_or_undefined_error(this, node: ref[AstNode], facts: int)
    {
        if (facts & TypeFactsIsUndefined) <> 0
        {
            if (facts & TypeFactsIsNull) <> 0
                this.error_on_node(node, DiagCannot_invoke_an_object_which_is_possibly_null_or_undefined)
            else
                this.error_on_node(node, DiagCannot_invoke_an_object_which_is_possibly_undefined)
            return
        }
        this.error_on_node(node, DiagCannot_invoke_an_object_which_is_possibly_null)
    }

    ; resolveCallExpression, down to the first unportable step of each branch.
    procedure resolve_call_expression(this, node: ref[AstNode], check_mode: int) returns ref[Signature]?
    {
        let callee AstNode.expression_of(node)
        if callee = null
        {
            this.record_unported("call-expression-slot-missing", KindCallExpression)
            return null
        }
        let expr callee as ref[AstNode]
        ; ★★★ THE SECOND EXPIRED `check-super-expression` STOP, AND ITS NOTE NAMED
        ; ITS OWN REFUTATION. It read *the base constructors, resolveCall and
        ; resolveUntypedCall all wait behind it* — three functions, and all three
        ; have been in this file for slices (resolveUntypedCall since 108,
        ; getInstantiatedConstructorsForTypeArguments with the base-type chapter,
        ; resolveCall with the call resolution). §3.5eo again, and the same lesson
        ; in a sharper form: a note that ENUMERATES its blockers is refutable by
        ; grepping the list, which is cheaper than re-deriving the chapter.
        ;
        ; ★ The `IsTypeAny` arm still CHECKS the arguments before answering
        ; anySignature — the reference's own comment is *still visit arguments so
        ; they get marked for visibility, etc* — so the loop is not a formality and
        ; may not be dropped for having no value.
        if AstNode.kind_of(expr) = KindSuperKeyword
        {
            let super_mark this.unported_mark()
            let super_type this.check_super_expression(expr)
            if this.unported_mark() <> super_mark
                return null
            if Checker.is_type_any(super_type)
            {
                let args AstNode.call_arguments_of(node)
                if args <> null
                {
                    let al args as ref[Array[ref[AstNode]?]]
                    let an al.get_length() as int
                    var ai 0
                    while ai < an
                    {
                        let arg al[ai]
                        if arg <> null
                            this.check_expression(arg as ref[AstNode])
                        set ai: ai + 1
                    }
                }
                return any_signature
            }
            if super_type = null
                return this.resolve_untyped_call(node)
            let st super_type as ref[Type]
            if this.is_error_type(st) = false
            {
                let containing Checker.get_containing_class(node)
                if containing <> null
                {
                    let base_type_node Checker.get_extends_heritage_clause_element(containing as ref[AstNode])
                    if base_type_node <> null
                    {
                        let btn base_type_node as ref[AstNode]
                        let base_constructors this.get_instantiated_constructors_for_type_arguments(st, AstNode.type_arguments_of(btn), btn)
                        if this.unported_mark() <> super_mark
                            return null
                        return this.resolve_call(node, base_constructors, check_mode, SignatureFlagsNone, 0)
                    }
                }
            }
            return this.resolve_untyped_call(node)
        }
        ; ★ ast.IsImportCall is asked AGAIN here, and this port cannot reach the
        ; branch: the dispatch has already sent an import call to
        ; `check-import-call-expression`, which is why the test stands above the
        ; callee's own check in the reference and below it in the work list. ★★It is
        ; an ANSWER since slice 108 rather than the row it was: resolveUntypedCall
        ; exists now, so the line the reference writes is the line this port writes,
        ; and the arm's unreachability is a claim about the DISPATCH rather than about
        ; this function.
        if Parser.is_import_call(node)
            return this.resolve_untyped_call(node)
        let mark this.unported_mark()
        let ft this.check_expression(expr)
        if this.unported_mark() <> mark
            return null
        if ft = null
            return null
        ; ★★★ THE CALL-CHAIN ARM, SLICE 139, AND ITS THREE-WAY FORK IS WHAT THE
        ; SIGNATURE'S FLAGS ARE FOR: a chain whose callee's type did not change is
        ; no chain for this purpose (SignatureFlagsNone), the OUTERMOST link is an
        ; outer call chain, and everything between is an inner one — which is the
        ; difference between propagating the optional marker outwards and merely
        ; carrying it.
        var func_type ft as ref[Type]
        var call_chain_flags SignatureFlagsNone
        if Checker.is_call_chain(node)
        {
            let non_optional this.get_optional_expression_type(func_type, expr)
            if this.unported_mark() <> mark
                return null
            if non_optional = null
                return null
            let no non_optional as ref[Type]
            if no <> func_type
            {
                if Binder.is_outermost_optional_chain(node)
                    set call_chain_flags: SignatureFlagsIsOuterCallChain
                else
                    set call_chain_flags: SignatureFlagsIsInnerCallChain
            }
            set func_type: no
        }
        ; checkNonNullTypeWithReporter, with the CANNOT-INVOKE reporter — the half
        ; of the flag that can report (see check_non_null_type_with_reporter's
        ; header). The note that stood here said the flag *would have no reader*
        ; and that it *arrives WITH getTypeFacts*; getTypeFacts is slice 90, and it
        ; does.
        let ft2 this.check_non_null_type_with_reporter(func_type, expr, true)
        if ft2 = null
            return null
        let fnt ft2 as ref[Type]
        if fnt = silent_never_type
            return silent_never_signature
        let apparent this.get_apparent_type(fnt)
        if apparent = null
            return null
        let at apparent as ref[Type]
        ; "Another error has already been reported" — resolveErrorCall, which is
        ; resolveUntypedCall and then unknownSignature. ★It was a row until slice 108
        ; and it read ZERO events at stage 1 either way, so the conversion is a
        ; SPELLING and not a product; it is made anyway, because a row standing where
        ; the function it names now exists is a wall that is no longer there.
        if this.is_error_type(at)
            return this.resolve_error_call(node)
        ; ★ A null answer here is an EMPTY list and not a stop — get_signatures_of_
        ; type answers null for a type with no structured members, which is
        ; upstream's nil slice. The stop is the MARK, and only the mark.
        let mark2 this.unported_mark()
        let call_sigs this.get_signatures_of_type(at, SignatureKindCall)
        if this.unported_mark() <> mark2
            return null
        let construct_sigs this.get_signatures_of_type(at, SignatureKindConstruct)
        if this.unported_mark() <> mark2
            return null
        let num_call Checker.sig_count(call_sigs)
        let num_construct Checker.sig_count(construct_sigs)
        let untyped this.is_untyped_function_call(fnt, at, num_call, num_construct)
        if this.unported_mark() <> mark2
            return null
        if untyped
        {
            ; "The unknownType indicates that an error already occurred (and was
            ; reported). No need to report another error in this case."
            ;
            ; ★ The guard is UNREACHABLE and says so at its line: getApparentType of
            ; errorType is errorType, and `is_error_type(at)` two arms up already
            ; returned. It is written because the reference asks it of funcType and
            ; not of the apparent type, and only that asymmetry keeps it alive.
            if this.is_error_type(fnt) = false
            {
                if AstNode.type_arguments_of(node) <> null
                    this.error_on_node(node, DiagUntyped_function_calls_may_not_accept_type_arguments)
            }
            return this.resolve_untyped_call(node)
        }
        if num_call = 0
        {
            if num_construct <> 0
            {
                let callee_name this.type_arg(fnt)
                this.error_on_node(node, DiagValue_of_type_0_is_not_callable_Did_you_mean_to_include_new, callee_name)
                return this.resolve_error_call(node)
            }
            ; ★★ THE `Are_you_missing_a_semicolon` BRANCH IS RELATED INFORMATION AND
            ; NOTHING ELSE, so it produces no `C` line and is not written: it builds
            ; a diagnostic for the callee, hands it to invocationError as
            ; `relatedInformation`, and AddRelatedInfo nests it under the head. Same
            ; reading slice 107 made of `_0_is_declared_here`. ★What it WOULD need is
            ; scanner.SkipTriviaEx with StopAfterLineBreak, which nothing else here
            ; asks for — so the branch is named rather than half-built.
            this.invocation_error(expr, at, SignatureKindCall)
            return this.resolve_error_call(node)
        }
        ; The SkipGenericFunctions deferral, whole since slice 164. It defers a
        ; call whose callee is itself a generic function RETURNING a function —
        ; `compose(f)(g)` — by answering resolvingSignature, which makes the outer
        ; check_expression answer the marker; the second round of chooseOverload
        ; then asks again with Normal and gets the real signature.
        if (check_mode & CheckModeSkipGenericFunctions) <> 0
        {
            if AstNode.list_count(AstNode.type_arguments_of(node)) = 0
            {
                let some_mark this.unported_mark()
                let deferrable this.some_generic_function_returning_function(call_sigs)
                if this.unported_mark() <> some_mark
                    return null
                if deferrable
                {
                    this.skipped_generic_function(node, check_mode)
                    return resolving_signature
                }
            }
        }
        this.resolve_call(node, call_sigs, check_mode, call_chain_flags, 0)
    }

    ; resolveNewExpression, to the same depth as its sibling above.
    ;
    ; ★ Its first line is checkNonNullExpression rather than checkExpression plus a
    ; wrapper, so it goes through the wrapper — and the wrapper carries the OTHER
    ; half of the reporter flag, the one that cannot report yet. That asymmetry is
    ; the reference's own: a `new` on a possibly-null target reports through
    ; reportObjectPossiblyNullOrUndefined, a call through
    ; reportCannotInvokePossiblyNullOrUndefined.
    procedure resolve_new_expression(this, node: ref[AstNode], check_mode: int) returns ref[Signature]?
    {
        let callee AstNode.expression_of(node)
        if callee = null
        {
            this.record_unported("new-expression-slot-missing", KindNewExpression)
            return null
        }
        let expr callee as ref[AstNode]
        let et this.check_non_null_expression(expr)
        if et = null
            return null
        let ent et as ref[Type]
        if ent = silent_never_type
            return silent_never_signature
        let apparent this.get_apparent_type(ent)
        if apparent = null
            return null
        let at apparent as ref[Type]
        ; resolveErrorCall — see the call sibling's note.
        if this.is_error_type(at)
            return this.resolve_error_call(node)
        ; ★ The reference's TS2347 test here is `len(node.TypeArguments()) != 0`
        ; where the CALL sibling's is `node.TypeArguments() != nil` — an empty list
        ; and no list differ upstream at one site and not at the other. The
        ; asymmetry is transcribed rather than smoothed: a `new C<>()` cannot be
        ; written, so no input separates them, and the day one does the two lines
        ; must still disagree.
        if Checker.is_type_any(at)
        {
            if AstNode.list_count(AstNode.type_arguments_of(node)) <> 0
                this.error_on_node(node, DiagUntyped_function_calls_may_not_accept_type_arguments)
            return this.resolve_untyped_call(node)
        }
        ; A null answer is an empty list, not a stop — see the sibling above.
        let mark2 this.unported_mark()
        let construct_sigs this.get_signatures_of_type(at, SignatureKindConstruct)
        if this.unported_mark() <> mark2
            return null
        if Checker.sig_count(construct_sigs) <> 0
        {
            ; ── slice 124: the four the row named ────────────────────────────
            ;
            ; isConstructorAccessible, the abstract-class pair (TS2511 twice) and
            ; then resolveCall over the CONSTRUCT signatures.
            ;
            ; ★★ THE TWO TS2511 ARMS ARE NOT ONE TEST. The first asks the
            ; SIGNATURES (an abstract construct signature, which a type may have
            ; without any class declaring it), the second the class-like
            ; DECLARATION of the type's symbol — and the reference's own comment
            ; says why both are needed: *in the case of a merged class-module or
            ; class-interface declaration, only the class declaration node will
            ; have the Abstract flag set.*
            let cs construct_sigs as ref[Array[ref[Signature]?]]
            let first cs[0]
            if this.is_constructor_accessible(node, first) = false
                return this.resolve_error_call(node)
            if this.unported_mark() <> mark2
                return null
            if this.some_signature_is_abstract(cs)
            {
                this.error_on_node(node, DiagCannot_create_an_instance_of_an_abstract_class)
                return this.resolve_error_call(node)
            }
            if at.symbol <> null
            {
                let value_decl Checker.get_class_like_declaration_of_symbol(at.symbol as ref[Symbol])
                if value_decl <> null
                {
                    if (b.combined_modifier_flags(value_decl as ref[AstNode]) & ModifierFlagsAbstract) <> 0
                    {
                        this.error_on_node(node, DiagCannot_create_an_instance_of_an_abstract_class)
                        return this.resolve_error_call(node)
                    }
                }
            }
            return this.resolve_call(node, construct_sigs, check_mode, SignatureFlagsNone, 0)
        }

        ; "If expressionType's apparent type is an object type with no construct
        ; signatures but one or more call signatures, the expression is processed as
        ; a function call." WHOLE since slice 159.
        ;
        ; ★★★ THE ROW WAS NEVER A CHAPTER AND THE NOTE SAID SO ITSELF: it read
        ; *"the arm is resolveCall and nothing else — which is why the row is
        ; placed at resolveCall's own door"*, and `resolve_call` is the very
        ; function the construct-signature arm twenty lines above returns through.
        ; A row placed at a door already open is §3.5eo in its purest form.
        ;
        ; ★★ THE TWO REPORTS ARE TRANSCRIBED RATHER THAN LEFT OUT, although
        ; `!c.noImplicitAny` is FALSE under this harness and neither can fire. The
        ; old note used that fact to justify the stop; using it to justify an
        ; OMISSION would be the same mistake in the other direction — a constant
        ; that holds because of a harness option is exactly the premise that
        ; expires when the option becomes settable, and both readers cost two
        ; lines each. ★`signature.declaration <> null` is the reference's own
        ; first conjunct, and it is what keeps the void test off a synthesized
        ; signature.
        let call_sigs this.get_signatures_of_type(at, SignatureKindCall)
        if this.unported_mark() <> mark2
            return null
        if Checker.sig_count(call_sigs) <> 0
        {
            let signature this.resolve_call(node, call_sigs, check_mode, SignatureFlagsNone, 0)
            if this.unported_mark() <> mark2
                return null
            if signature = null
                return null
            let sig signature as ref[Signature]
            if Checker.no_implicit_any() = false
            {
                if sig.declaration <> null
                {
                    let rt this.get_return_type_of_signature(sig)
                    if this.unported_mark() <> mark2
                        return null
                    if rt <> null
                    {
                        if (rt as ref[Type]) <> void_type
                            this.error_on_node(node, DiagOnly_a_void_function_can_be_called_with_the_new_keyword)
                    }
                }
                let tt this.get_this_type_of_signature(sig)
                if this.unported_mark() <> mark2
                    return null
                if tt <> null
                {
                    if (tt as ref[Type]) = void_type
                        this.error_on_node(node, DiagA_function_that_is_called_with_the_new_keyword_cannot_have_a_this_type_that_is_void)
                }
            }
            return signature
        }
        ; ★★★ THE CLASS-OR-INTERFACE GUARD IS RETIRED, AND ITS OWN NOTE NAMED THE
        ; CAUSE. It stood here from slice 108 because `interface ErrorConstructor {
        ; captureStackTrace(...) }` augments a lib interface whose `new (message?:
        ; string): Error` this port did not read — the merged symbol carried the
        ; file's declaration alone, the construct list was genuinely empty, and
        ; `new x()` invented TS2351. **`Checker.load_lib` landed in slice 113 and that
        ; is the marker the note said did not exist**: the witness the note names,
        ; `submodule_compiler_errorConstructorSubtypes`, is a MATCH and no longer
        ; reaches this line. A stop justified by a measurement expires when the CAUSE
        ; it names lands, and by nothing else.
        this.invocation_error(expr, at, SignatureKindConstruct)
        this.resolve_error_call(node)
    }

    ; ── slice 108: the call's RESOLUTION ────────────────────────────────────
    ;
    ; `is-untyped-function-call 214` — 52 events over 33 units at stage 1, 1 322
    ; units and 4 881 events at stage 2 — the largest row slice 107 could name that
    ; is neither the lib nor a name resolution. What stood there was one
    ; `record_unported` after getSignaturesOfType, and the function it is named
    ; after is four disjuncts.
    ;
    ; ★★★ THE ROW IS NOT THE CHAPTER, AND A PROBE SAID SO BEFORE A LINE WAS
    ; WRITTEN. Replacing the stop's tag argument by a bitfield over the four
    ; disjuncts' own inputs — and then by `ncall*1000 + single_non_generic*100 +
    ; nargs*10 + ntypeargs` — reports 50 of the 52 arrivals as **one call signature
    ; that is not generic**, i.e. every one of them passes every disjunct of
    ; `isUntypedFunctionCall` and falls through to `resolveCall`. Only TWO are
    ; untyped calls, both `any` on both sides. **So the wall behind a row named
    ; after a predicate was the OVERLOAD RESOLUTION, and the predicate answers
    ; FALSE for 96 % of its own population.** ★★A stop's tag names the first thing
    ; the porter could not do, never the shape of what arrives — and the only
    ; instrument that separates the two is a probe on the stop's own argument.
    ;
    ; ★★★ WHICH IS WHY THIS SLICE IS BOUNDED BY `chooseOverload`'s FIRST ARM AND
    ; NOT BY THE ROW. `s.isSingleNonGenericCandidate` is exactly the 47 of 52
    ; arrivals that also carry no type arguments, and its arm is three lines:
    ; hasCorrectArity, then isSignatureApplicable, then the candidate. The
    ; multi-candidate loop underneath it needs inferTypeArguments, the inference
    ; context and getSignatureInstantiation, and it is a row.
    ;
    ; ★★★ AND THE HEAD MESSAGE IS NOT THREADED THROUGH THE RELATION, WHICH IS THE
    ; MEASUREMENT THAT SAVED THE SLICE'S WIDEST EDIT. `isSignatureApplicable` hands
    ; `Argument_of_type_0_is_not_assignable_to_parameter_of_type_1` (TS2345) to
    ; checkTypeRelatedToAndOptionallyElaborate, and TS2345 is a CODE — so a `C` line
    ; depends on it and the parameter looked mandatory. It is not: `chooseOverload`
    ; passes `reportErrors` FALSE at every call, `errorNode` is therefore nil, and
    ; the relation returns before any message is selected. The reporting pass that
    ; passes TRUE is `reportCallResolutionErrors`, and that is this slice's wall —
    ; so a `head_message` parameter added here would be **a parameter with a writer
    ; and no reader**, slice 67's finding two in the other direction.
    ;
    ; ★★ WHAT THE SLICE ANSWERS is a SIGNATURE, and the diagnostics are a
    ; by-product: check_call_expression already asks get_return_type_of_signature,
    ; so a call whose one candidate has the right arity and assignable arguments now
    ; has a TYPE. The four codes it can emit — TS2347, TS2348, TS2349, TS2351 — all
    ; sit on the paths where resolution does NOT happen.

    ; The list length of a signature array, which is `len(...)` at seven sites here.
    ; ★It is a static and not a method for the reason the file's other `*_count`
    ; statics are: it asks nothing of the checker.
    function sig_count(a: ref[Array[ref[Signature]?]]?) returns int
    {
        if a = null
            return 0
        a.get_length() as int
    }

    ; Its two siblings, slice 119, for the same `len(...)` at the same shape.
    function symbol_count(a: ref[Array[ref[Symbol]?]]?) returns int
    {
        if a = null
            return 0
        a.get_length() as int
    }

    function index_info_count(a: ref[Array[ref[IndexInfo]?]]?) returns int
    {
        if a = null
            return 0
        a.get_length() as int
    }

    ; isUntypedFunctionCall, whole — "TS 1.0 spec: 4.12. If FuncExpr is of type Any,
    ; or of an object type that has no call or construct signatures but is a subtype
    ; of the Function interface, the call is an untyped function call."
    ;
    ; ★★★ ITS THIRD DISJUNCT ENDS IN `globalFunctionType` AND IS THEREFORE §3.11,
    ; AND THE CONTAINMENT IS WHAT MAKES THAT SURVIVABLE: four conjuncts stand in
    ; front of the lib term, and the corpus fails the FIRST of them — a call whose
    ; callee has a call signature — at every one of the 50 arrivals a probe counted.
    ; So the row is written at the lib term rather than at the function's door, and
    ; it reads ZERO at stage 1.
    ;
    ; ★★ THE UNION EXCLUSION IS THE REFERENCE'S OWN COMMENT and not an optimisation:
    ; "We exclude union types because we may have a union of function types that
    ; happen to have no common signatures." It is asked before getReducedType, which
    ; is what keeps this function off get_reduced_type's union row.
    procedure is_untyped_function_call(this, func_type: ref[Type], apparent_func_type: ref[Type], num_call_signatures: int, num_construct_signatures: int) returns bool
    {
        if Checker.is_type_any(func_type)
            return true
        if Checker.is_type_any(apparent_func_type)
        {
            if (func_type.flags & TypeFlagsTypeParameter) <> 0
                return true
        }
        if num_call_signatures <> 0
            return false
        if num_construct_signatures <> 0
            return false
        if (apparent_func_type.flags & TypeFlagsUnion) <> 0
            return false
        let mark this.unported_mark()
        let reduced this.get_reduced_type(apparent_func_type)
        if this.unported_mark() <> mark
            return false
        if reduced = null
            return false
        if ((reduced as ref[Type]).flags & TypeFlagsNever) <> 0
            return false
        ; `isTypeAssignableTo(funcType, c.globalFunctionType)` — the last term of
        ; the untyped-call test, and the one that makes an object with no call
        ; signature but a `Function` base still count as callable.
        let ft this.get_global_function_type()
        if this.unported_mark() <> mark
            return false
        if ft = null
        {
            this.record_unported("global-function-type-absent", apparent_func_type.flags)
            return false
        }
        this.is_type_assignable_to(func_type, ft as ref[Type])
    }

    ; callLikeExpressionMayHaveTypeArguments, whole.
    function call_like_expression_may_have_type_arguments(n: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(n)
        if k = KindCallExpression
            return true
        if k = KindNewExpression
            return true
        if k = KindTaggedTemplateExpression
            return true
        if k = KindJsxOpeningElement
            return true
        if k = KindJsxSelfClosingElement
            return true
        false
    }

    ; resolveUntypedCall, whole for the two kinds that reach it.
    ;
    ; ★★ THE TYPE ARGUMENTS ARE CHECKED EVEN THOUGH THE CALL IS AN ERROR, which is
    ; the reference's own comment: "Check type arguments even though we will give an
    ; error that untyped calls may not accept type arguments. This gets us
    ; diagnostics for the type arguments and marks them as referenced." So the
    ; TS2347 above and this walk are not alternatives.
    ;
    ; ★ Its two other arms are rows, and each is unreachable for the reason its own
    ; caller is: a tagged template reaches resolveSignature through
    ; checkTaggedTemplateExpression and the BinaryExpression through
    ; checkInstanceOfExpression — both already a stop one level up (see
    ; resolve_signature's header).
    ;
    ; ★★★ AND THE STOP USED TO BE A DEFAULT WHERE THE REFERENCE HAS NO ARM AT ALL
    ; (slice 134). The line below said *"a decorator its expression"* and the
    ; reference's `switch` has FOUR arms — TaggedTemplate, the two Jsx kinds,
    ; BinaryExpression, Call/New — and no Decorator among them, so a decorator
    ; walks NOTHING and answers anySignature. Reading the default as unported made
    ; an untyped decorator (`@d` on an `any`) a stop, which is nine units and the
    ; one wall the decorator chapter left behind for no reason. **A stop is a claim
    ; about the reference, and a claim about a `switch` has to name the arms.**
    ; resolveInstanceofExpression. ★★★ THE ONLY BINARY EXPRESSION resolveSignature
    ; IS EVER ASKED ABOUT IS AN `instanceof`, and the reference does not test for
    ; it: checkInstanceOfExpression is the one caller that hands a binary node to
    ; getResolvedSignature, so the arm's kind IS the operator. The port keeps that
    ; — a test here would be a claim about callers rather than about the node.
    ;
    ; ★ The fall-through answer is anySignature and not an error: an `instanceof`
    ; whose right operand is a plain class has no `[Symbol.hasInstance]` method, and
    ; that is the ordinary case rather than a failure. The reference's own comment
    ; is *fall back to a default signature*.
    procedure resolve_instanceof_expression(this, node: ref[AstNode], check_mode: int) returns ref[Signature]?
    {
        let right AstNode.binary_right_of(node)
        if right = null
            return null
        let r right as ref[AstNode]
        let mark this.unported_mark()
        let right_type this.check_expression(r)
        if this.unported_mark() <> mark
            return null
        if right_type = null
            return null
        let rt right_type as ref[Type]
        if Checker.is_type_any(rt)
            return any_signature
        ; "if rightType is an object type with a custom `[Symbol.hasInstance]`
        ; method, then it is potentially valid on the right-hand side of the
        ; `instanceof` operator. This allows normal `object` types to participate in
        ; `instanceof`, as per Step 2 of the ECMA-262 InstanceofOperator."
        let has_instance_method_type this.get_symbol_has_instance_method_of_object_type(rt)
        if this.unported_mark() <> mark
            return null
        if has_instance_method_type = null
        {
            var function_like this.type_has_call_or_construct_signatures(rt)
            if this.unported_mark() <> mark
                return null
            if function_like = false
            {
                let gf this.get_global_function_type()
                if this.unported_mark() <> mark
                    return null
                if gf <> null
                    set function_like: this.is_type_subtype_of(rt, gf as ref[Type])
                if this.unported_mark() <> mark
                    return null
            }
            if function_like = false
            {
                this.error_on_node(r, DiagThe_right_hand_side_of_an_instanceof_expression_must_be_either_of_type_any_a_class_function_or_other_type_assignable_to_the_Function_interface_type_or_an_object_type_with_a_Symbol_hasInstance_method)
                return this.resolve_error_call(node)
            }
            return any_signature
        }
        let him has_instance_method_type as ref[Type]
        let apparent_type this.get_apparent_type(him)
        if this.unported_mark() <> mark
            return null
        if apparent_type = null
            return null
        let at apparent_type as ref[Type]
        if this.is_error_type(at)
            return this.resolve_error_call(node)
        let call_signatures this.get_signatures_of_type(at, SignatureKindCall)
        if this.unported_mark() <> mark
            return null
        let construct_signatures this.get_signatures_of_type(at, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return null
        var num_call 0
        if call_signatures <> null
            set num_call: (call_signatures as ref[Array[ref[Signature]?]]).get_length() as int
        var num_construct 0
        if construct_signatures <> null
            set num_construct: (construct_signatures as ref[Array[ref[Signature]?]]).get_length() as int
        let untyped this.is_untyped_function_call(him, at, num_call, num_construct)
        if this.unported_mark() <> mark
            return null
        if untyped
            return this.resolve_untyped_call(node)
        if num_call <> 0
            return this.resolve_call(node, call_signatures, check_mode, SignatureFlagsNone, 0)
        ; "fall back to a default signature"
        any_signature
    }

    procedure resolve_untyped_call(this, node: ref[AstNode]) returns ref[Signature]?
    {
        let mark this.unported_mark()
        if Checker.call_like_expression_may_have_type_arguments(node)
            this.check_source_elements(AstNode.type_arguments_of(node))
        if this.unported_mark() <> mark
            return null
        let k AstNode.kind_of(node)
        ; The reference's switch: a tagged template walks its template, a JSX
        ; OPENING-LIKE element checks its attributes, a `instanceof` its left
        ; operand, and a call or `new` its arguments. Everything else — a fragment,
        ; a DECORATOR — has no arm and walks nothing. Slice 119 wires the two JSX
        ; kinds and the empty default; slice 134 arrived at the default through the
        ; decorator and is what corrected it.
        if AstNode.is_jsx_opening_like_element(node)
        {
            let attributes AstNode.jsx_attributes_of(node)
            if attributes = null
                return null
            let ignored this.check_expression(attributes as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            return any_signature
        }
        ; The two arms that exist upstream and are not ported keep a row each; the
        ; DEFAULT does not, because the reference's default is to walk nothing.
        if k = KindTaggedTemplateExpression
        {
            ; `c.checkExpression(node.AsTaggedTemplateExpression().Template)` — the
            ; template, not the arguments: its spans' expressions are reached
            ; through it.
            let template AstNode.tagged_template_template_of(node)
            if template = null
                return null
            let ignored_template this.check_expression(template as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            return any_signature
        }
        if k = KindBinaryExpression
        {
            ; `c.checkExpression(node.AsBinaryExpression().Left)` — the LEFT operand,
            ; because the right one has already been checked by the caller that got
            ; here (resolveInstanceofExpression checks it to ask about
            ; `[Symbol.hasInstance]` at all).
            let bl AstNode.binary_left_of(node)
            if bl = null
                return null
            let ignored_left this.check_expression(bl as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            return any_signature
        }
        var walks_arguments false
        if k = KindCallExpression
            set walks_arguments: true
        if k = KindNewExpression
            set walks_arguments: true
        if walks_arguments = false
            return any_signature
        let args AstNode.call_arguments_of(node)
        var i 0
        while i < AstNode.list_count(args)
        {
            let arg AstNode.child_in_list(args, i)
            if arg <> null
            {
                let ignored this.check_expression(arg as ref[AstNode])
                if this.unported_mark() <> mark
                    return null
            }
            set i: i + 1
        }
        any_signature
    }

    ; resolveErrorCall, whole — two lines upstream and two here.
    procedure resolve_error_call(this, node: ref[AstNode]) returns ref[Signature]?
    {
        let mark this.unported_mark()
        let ignored this.resolve_untyped_call(node)
        if this.unported_mark() <> mark
            return null
        unknown_signature
    }

    ; invocationError and invocationErrorDetails, folded into one procedure — and
    ; the fold is a claim about this port's DIAGNOSTIC, not a shortcut.
    ;
    ; ★★★ THE REFERENCE BUILDS A CHAIN AND THE DUMP CARRIES ITS HEAD. Every path
    ; through invocationErrorDetails ends in
    ; `NewDiagnosticChainForNode(diagnostic, target, headMessage)`, whose outermost
    ; message is the head and whose LOC is `target`'s at every branch — so the `C`
    ; line is (target's range, head code) whether the apparent type is a union or
    ; not. The union arm's own three codes (TS2757/TS2758, TS2759/TS2760, TS2762) and
    ; the awaited-type test exist to compose the chain BELOW the head and to add
    ; related information, neither of which the fifth yardstick compares. That is why
    ; this port emits one diagnostic and reports no row: the union branch changes
    ; nothing it can observe.
    ;
    ; ★★ THE ONE THING THAT DOES MOVE THE HEAD IS THE GET-ACCESSOR ARM, and it is
    ; ported: `f()` where `f` is a getter reports TS6234 rather than TS2349. Its guard
    ; is a call with ZERO arguments, which is what makes it a suggestion about the
    ; PARENTHESES rather than about the callee.
    ;
    ; ★ invocationErrorRecovery is not written: it adds related information on an
    ; originating import, and it reads exportTypeLinks — a table this port does not
    ; keep.
    procedure invocation_error(this, error_target: ref[AstNode], apparent_type: ref[Type], kind: int)
    {
        let parent AstNode.parent_node_of(error_target)
        let parent_is_call Checker.kind_or_unknown(parent) = KindCallExpression
        var target error_target
        if AstNode.kind_of(error_target) = KindPropertyAccessExpression
        {
            if parent_is_call
            {
                let nm AstNode.name_of(error_target)
                if nm <> null
                    set target: nm as ref[AstNode]
            }
        }
        var head DiagThis_expression_is_not_callable
        if kind <> SignatureKindCall
            set head: DiagThis_expression_is_not_constructable
        if parent_is_call
        {
            if AstNode.list_count(AstNode.call_arguments_of(parent)) = 0
            {
                let rs this.get_resolved_symbol_or_nil(error_target)
                if rs <> null
                {
                    if (Symbol.flags_of(rs as ref[Symbol]) & SymbolFlagsGetAccessor) <> 0
                        set head: DiagThis_expression_is_not_callable_because_it_is_a_get_accessor_Did_you_mean_to_use_it_without
                }
            }
        }
        this.error_on_node(target, head)
    }

    ; resolveCall, down to the one arm of chooseOverload this slice ports.
    ;
    ; ★★★ THE CALL STATE IS NOT A RECORD HERE AND THAT IS A CONSEQUENCE OF THE
    ; BOUNDARY. Upstream's `CallState` carries nine fields, five of which exist only
    ; so that the FAILURE pass can pick the best candidate to report on —
    ; candidatesForArgumentError, candidateForArgumentArityError,
    ; candidateForTypeArgumentError — and that pass is
    ; `getCandidateForOverloadFailure` plus `reportCallResolutionErrors`, this
    ; slice's wall. With one candidate and no failure reporting, what is left is four
    ; locals.
    ;
    ; ★★ THREE OF THE REFERENCE'S OWN LINES ARE CONSTANT UNDER THIS HARNESS and are
    ; written as their constant with the reason at the line: `reportErrors` is
    ; `!isInferencePartiallyBlocked && candidatesOutArray == nil` and no caller here
    ; passes an out array; `signatureHelpTrailingComma` needs
    ; CheckModeIsForSignatureHelp, which only the language service sets; and
    ; `argCheckMode` is Normal because its own guard excludes a single non-generic
    ; candidate.
    ;
    ; ★ reorderCandidates is the identity on ONE candidate — the loop body inserts at
    ; index 0 of an empty result — so it is not written as a function; the row stands
    ; at the >1 case, which is where its five index registers start to mean something.
    ; ── slice 131: the OVERLOAD SET ─────────────────────────────────────────
    ;
    ; ★★★ resolveCall's SHAPE CHANGES WITH MORE THAN ONE CANDIDATE, WHICH IS WHY
    ; THE PER-CANDIDATE BODY HAD TO MOVE OUT OF resolve_call. With one candidate a
    ; failure IS the answer, so the old body reported at the line that failed; with
    ; several, a failure is a `continue` and only the EMPTY loop is a failure of the
    ; call. Keeping the reports where they were would have marked a unit unported
    ; because the FIRST overload did not match.
    ;
    ; ★★★ AND THAT IS THE PART A ROW CANNOT SHOW: the row `reorder-candidates` named
    ; a 49-line function, and what it was actually holding was every call in the
    ; corpus to an OVERLOADED function — 210 units of stage 2 — because the port had
    ; no way to say *this candidate did not match, try the next*.
    ;
    ; ★ The state record is the reference's CallState minus its five failure slots:
    ; candidatesForArgumentError, candidateForArgumentArityError and
    ; candidateForTypeArgumentError exist only for the FAILURE PASS
    ; (getCandidateForOverloadFailure + reportCallResolutionErrors), which is still
    ; a row — so what a failed loop owes is one stop and not a best-candidate
    ; choice.
    ; ★The candidate list is the CALLER's (slice 344): it is read out and dropped
    ; inside `resolve_call`, so the frame that outlives the ordering owns it and
    ; the list goes back with that frame. A list built here and RETURNED cannot be
    ; frame-local — a returned value lives on the caller's page, which is the
    ; long-lived one.
    procedure reorder_candidates(this, signatures: ref[Array[ref[Signature]?]], call_chain_flags: int, result: ref[Array[ref[Signature]?]]) returns bool
    {
        let mark this.unported_mark()
        let n signatures.get_length() as int
        var last_parent: ref[AstNode]? null
        var last_symbol: ref[Symbol]? null
        var index 0
        var cutoff_index 0
        var splice_index 0
        var specialized_index 0 - 1
        var i 0
        while i < n
        {
            let row signatures[i]
            set i: i + 1
            if row = null
                return false
            var signature row as ref[Signature]
            var symbol: ref[Symbol]? null
            var parent: ref[AstNode]? null
            if signature.declaration <> null
            {
                let decl signature.declaration as ref[AstNode]
                set symbol: this.get_symbol_of_declaration(decl)
                if this.unported_mark() <> mark
                    return false
                set parent: AstNode.parent_node_of(decl)
            }
            var same_symbol false
            if last_symbol = null
                set same_symbol: true
            if last_symbol <> null
            {
                if symbol <> null
                {
                    if (symbol as ref[Symbol]) = (last_symbol as ref[Symbol])
                        set same_symbol: true
                }
            }
            if same_symbol
            {
                var same_parent false
                if last_parent <> null
                {
                    if parent <> null
                    {
                        if (parent as ref[AstNode]) = (last_parent as ref[AstNode])
                            set same_parent: true
                    }
                }
                if same_parent
                    set index: index + 1
                else
                {
                    set last_parent: parent
                    set index: cutoff_index
                }
            }
            else
            {
                ; "current declaration belongs to a different symbol; set
                ; cutoffIndex so re-orderings in the future won't change result set
                ; from 0 to cutoffIndex"
                set index: result.get_length() as int
                set cutoff_index: result.get_length() as int
                set last_parent: parent
            }
            set last_symbol: symbol
            ; "specialized signatures always need to be placed before
            ; non-specialized signatures regardless of the cutoff position"
            if Checker.signature_has_literal_types(signature)
            {
                set specialized_index: specialized_index + 1
                set splice_index: specialized_index
                set cutoff_index: cutoff_index + 1
            }
            else
                set splice_index: index
            if call_chain_flags <> 0
            {
                let opt this.get_optional_call_signature(signature, call_chain_flags)
                if opt = null
                    return false
                set signature: opt as ref[Signature]
            }
            ; `slices.Insert(result, spliceIndex, signature)`. Scaly's Array has no
            ; insert, so the tail is shifted up by one after an append — which is
            ; what slices.Insert does anyway.
            let length result.get_length() as int
            result.add(signature)
            var j length
            while j > splice_index
            {
                result.put(j as size_t, result[j - 1])
                set j: j - 1
            }
            result.put(splice_index as size_t, signature)
        }
        true
    }

    function signature_has_literal_types(s: ref[Signature]) returns bool
        (s.flags & SignatureFlagsHasLiteralTypes) <> 0

    ; chooseOverload, WHOLE — the three failure slots landed with slice 138.
    ;
    ; ★★★ A CANDIDATE THAT DOES NOT MATCH IS A `continue`, AND A STOP IS NOT. The
    ; two are told apart by the unported mark: `is_signature_applicable` answering
    ; FALSE is an answer about this candidate, while the mark having MOVED means the
    ; relation met a construct this port does not have — and then no later candidate
    ; can be trusted either, so the whole resolution returns null.
    procedure choose_overload(this, s: ref[CallState], relation: int) returns ref[Signature]?
    {
        let mark this.unported_mark()
        let node s.node
        let args s.args
        ; The reference's three `= nil` lines. They matter because resolve_call runs
        ; this twice — the subtype pass and then the assignable pass — and the
        ; report reads what the LAST pass left.
        set s.candidates_for_argument_error: null
        set s.candidate_for_argument_arity_error: null
        set s.candidate_for_type_argument_error: null
        if s.is_single_non_generic_candidate
        {
            let row s.candidates[0]
            if row = null
                return null
            let candidate row as ref[Signature]
            if AstNode.list_count(s.type_arguments) <> 0
                return null
