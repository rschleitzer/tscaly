        ; property access records: ES2025 clears both feature minimums and
        ; use_define_for_class_fields is true.
        if op_kind = KindInKeyword
        {
            if left_type = null
                return null
            if right_type = null
                return null
            let lt left_type as ref[Type]
            let rt right_type as ref[Type]
            if lt = silent_never_type
                return silent_never_type
            if rt = silent_never_type
                return silent_never_type
            let mark this.unported_mark()
            if AstNode.kind_of(left) = KindPrivateIdentifier
            {
                if (language_version < ScriptTargetES2022) or (language_version < ScriptTargetLatest) or (use_define_for_class_fields = false)
