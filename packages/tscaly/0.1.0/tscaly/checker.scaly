            if parent = null
                return null
            let signature this.get_resolved_signature(parent as ref[AstNode], check_mode)
            if this.unported_mark() <> mark
                return null
            if signature = null
                return null
            let sig signature as ref[Signature]
            ; "CheckMode.SkipGenericFunctions is enabled and this is a call to a
            ; generic function that returns a function type. We defer checking and
            ; return silentNeverType."
            if sig = resolving_signature
                return silent_never_type
            let return_type this.get_return_type_of_signature(sig)
            if this.unported_mark() <> mark
                return null
            if return_type = null
                return null
