                        set report: false
                        if op_kind = KindEqualsEqualsEqualsToken
                            set report: true
                        if op_kind = KindExclamationEqualsEqualsToken
                            set report: true
                    }
                    if report
                    {
                        if (op_kind = KindEqualsEqualsToken) or (op_kind = KindEqualsEqualsEqualsToken)
                            this.error_on_node_or_null(error_node, DiagThis_condition_will_always_return_0_since_JavaScript_compares_objects_by_reference_not_value, "false")
                        else
                            this.error_on_node_or_null(error_node, DiagThis_condition_will_always_return_0_since_JavaScript_compares_objects_by_reference_not_value, "true")
                    }
                }
                this.check_na_n_equality(error_node, op_kind, left, right)
                ; reportOperatorErrorUnless with the equality predicate:
                ; isTypeEqualityComparableTo(l, r) || isTypeEqualityComparableTo(r, l).
                if left_type = null
                    return boolean_type
                if right_type = null
                    return boolean_type
                let lt left_type as ref[Type]
                let rt right_type as ref[Type]
                let mark this.unported_mark()
                var compatible this.is_type_equality_comparable_to(lt, rt)
                if compatible = false
                    set compatible: this.is_type_equality_comparable_to(rt, lt)
                if this.unported_mark() <> mark
                    return null
                if compatible = false
                    this.report_operator_error(lt, op_kind, rt, error_node, 4)
                if this.unported_mark() <> mark
                    return null
            }
            ; ★★★ SLICE 90 RECORDED THE ROW ON BOTH PATHS AND SLICE 94 SPLITS THEM,
            ; WHICH IS THE SAME ARGUMENT ARRIVING AT ITS OTHER END. That slice's
            ; note reads *"the answer is booleanType whichever way the gate goes,
            ; and this port cannot mint it — so both paths owe a stop"*, and its
            ; control g16 proved the shape of the hazard: with the gate forced
            ; closed and no stop recorded, one unit INVENTED a TS7005. Both halves
            ; still hold. What changed is that the CLOSED path now has a real
            ; answer — booleanType — so it owes no row at all, while the OPEN path
            ; still stops, because reportOperatorErrorUnless is the relation and
            ; produces diagnostics this port cannot.
            ;
            ; ★ The stop moved INSIDE the gate, which is exactly the placement g16
            ; refuted while the answer was nil. It is safe for the reason g16
            ; names and not despite it: a nil is how this port says *no claim*, and
            ; the closed path no longer answers nil.
            return boolean_type
        }

        ; ── checkInstanceOfExpression ───────────────────────────────────
        ;
        ; ★★★ THE OPERATOR IS RESOLVED AS A CALL, AND THAT IS THE WHOLE SHAPE OF THE
        ; FUNCTION. `x instanceof y` where y carries a `[Symbol.hasInstance]` method
        ; is checked *as if it were a call to `right[Symbol.hasInstance](left)`* —
        ; the reference's own comment — so getResolvedSignature is asked about the
        ; BINARY EXPRESSION itself, and it is that call which checks the left
        ; operand against the method's first parameter. The two reports below are
        ; what is left over once the call has spoken: the left operand's kind and
        ; the method's return type.
        ;
        ; ★ `left.Parent` rather than the binary node in hand: the reference reaches
        ; the expression through the operand because the operand is what it was
        ; given, and the two are the same node — written the reference's way so the
        ; line still reads against it.
        if op_kind = KindInstanceOfKeyword
        {
            if left_type = null
                return null
            if right_type = null
                return null
            let lt2 left_type as ref[Type]
            let rt2 right_type as ref[Type]
            if lt2 = silent_never_type
                return silent_never_type
            if rt2 = silent_never_type
                return silent_never_type
            let mark this.unported_mark()
            ; "The instanceof operator requires the left operand to be of type Any,
            ; an object type, or a type parameter type. NOTE: do not raise error if
            ; leftType is unknown as related error was already reported."
            if Checker.is_type_any(lt2) = false
            {
                let all_primitive this.all_types_assignable_to_kind(lt2, TypeFlagsPrimitive)
                if this.unported_mark() <> mark
                    return null
                if all_primitive
                    this.error_on_node(left, DiagThe_left_hand_side_of_an_instanceof_expression_must_be_of_type_any_an_object_type_or_a_type_parameter)
            }
