    ; The tail elaborateIterableOrArrayLikeTargetElementwise runs once the relation
    ; has already failed — elaborateElement's own tail with the target type fixed by
    ; the caller. ★`reportedError` is set by the CALLER unconditionally at this
    ; point (upstream: `reportedError = true` before the `if !elaborated`), so this
    ; function's answer says only whether the recursion reported, not whether
    ; anything did.
    procedure elaborate_iterable_element_report(this, source: ref[Type], tuple_parts: ref[Type], relation: int, prop: ref[AstNode], next: ref[AstNode]?, name_type: ref[Type], source_prop_type: ref[Type], target_prop_type: ref[Type], text_child_code: int, text_child_args: ref[Array[String]]?) returns bool
    {
