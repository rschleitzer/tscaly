    ; parenthesis case for a `(x as T)` the JSDoc reparser built, so the test is
    ; written where the reference puts it rather than folded away.
    function get_effective_check_node(this, argument: ref[AstNode]) returns ref[AstNode]
    {
        let exclude_jsdoc Parser.is_in_js_file(argument)
        var n argument
        repeat
        {
            let k AstNode.kind_of(n)
            if k = KindSatisfiesExpression
            {
                let inner AstNode.expression_of(n)
                if inner = null
                    return n
                set n: inner as ref[AstNode]
                continue
            }
            if k <> KindParenthesizedExpression
                return n
            if exclude_jsdoc
            {
                if Checker.is_jsdoc_type_assertion(n)
                    return n
            }
            let inner AstNode.expression_of(n)
            if inner = null
                return n
            set n: inner as ref[AstNode]
        }
    }

    ; ast.IsJSDocTypeAssertion. ★Its `IsInJSFile` conjunct is asked by the caller
    ; above, which is the only one here.
    function is_jsdoc_type_assertion(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindParenthesizedExpression
            return false
        let expr AstNode.expression_of(node)
        if expr = null
            return false
        let e expr as ref[AstNode]
        if AstNode.kind_of(e) <> KindAsExpression
            return false
        let tn AstNode.type_of(e)
        if tn = null
            return false
        (AstNode.flags_of(tn as ref[AstNode]) & NodeFlagsReparsed) <> 0
    }

    ; ── slice 174: the JSDoc FULL SIGNATURE ──────────────────────────────────
    ;
    ; getSignatureOfFullSignatureType, whole. Its three conjuncts are syntactic —
    ; a JavaScript file, one of four function-like kinds, and a FullSignature slot
    ; that only a JSDoc `@type` tag carrying a whole function type fills.
    ;
    ; ★★★ THE NOTE THAT KEPT THIS A GUARD IN FIVE PLACES SAID THE SIGNATURE IS
    ; *"the very thing none of them can get"* — true when written, and false twice
    ; over since: get_type_from_type_node (slice 48) and get_single_call_signature
    ; (slice 69) are the whole of the tail. The five copies collapse into this one
    ; function and the two tails the reference has.
    procedure get_signature_of_full_signature_type(this, node: ref[AstNode]) returns ref[Signature]?
    {
        if Parser.is_in_js_file(node) = false
            return null
        let k AstNode.kind_of(node)
        var full_kind k = KindFunctionDeclaration
        if k = KindMethodDeclaration
            set full_kind: true
        if k = KindFunctionExpression
            set full_kind: true
        if k = KindArrowFunction
            set full_kind: true
        if full_kind = false
            return null
        let full AstNode.full_signature_of(node)
        if full = null
            return null
        let t this.get_type_from_type_node(full as ref[AstNode])
        if t = null
            return null
        this.get_single_call_signature(t as ref[Type])
    }

    ; getParameterTypeOfFullSignature — the `@type` tag's answer for ONE parameter.
    ; ★The rest parameter takes the REST type at the position and not the type at
    ; it, which is the reference's own fork and the reason the position is computed
    ; before the branch.
    procedure get_parameter_type_of_full_signature(this, node: ref[AstNode], parameter: ref[AstNode]) returns ref[Type]?
    {
        let sig this.get_signature_of_full_signature_type(node)
        if sig = null
            return null
        let s sig as ref[Signature]
        let pos Checker.parameter_index_of(node, parameter)
        if pos < 0
            return null
        if AstNode.dot_dot_dot_token_of(parameter) <> null
            return this.get_rest_type_at_position(s, pos, false)
        this.get_type_at_position(s, pos)
    }

    ; getReturnTypeOfFullSignature.
    procedure get_return_type_of_full_signature(this, node: ref[AstNode]) returns ref[Type]?
    {
        let sig this.get_signature_of_full_signature_type(node)
        if sig = null
            return null
        this.get_return_type_of_signature(sig as ref[Signature])
    }

    ; getReturnTypeFromAnnotation, whole.
    ;
    ; ★★★ TWO OF ITS FOUR ARMS HAVE NO INPUT FROM THIS PORT'S ONE CALLER AND THEY GET
    ; DIFFERENT TREATMENT, WHICH IS THE POINT WORTH KEEPING. checkFunctionOrMethod
    ; Declaration is the only call site here and it sees FunctionDeclaration,
    ; MethodDeclaration and MethodSignature; a Constructor reaches the reference's
    ; function through checkConstructorDeclaration and getReturnTypeOfSignature, a
    ; GetAccessor through checkAccessorDeclaration. Neither arm may simply be dropped
    ; — nil is this function's answer for *there is no annotation*, so an omitted arm
    ; is a WRONG ANSWER waiting for its second caller (slice 79's scope-chain rule)
    ; rather than a missing row. **The Constructor arm is WRITTEN because every
    ; function it needs already exists here; the GetAccessor arm is a STOP because
    ; hasBindableName's late-bound half and getAnnotatedAccessorTypeNode do not, and
    ; writing them would be machinery no instrument in this suite could reach.**
    procedure get_return_type_from_annotation(this, declaration: ref[AstNode]) returns ref[Type]?
    {
        let k AstNode.kind_of(declaration)
        if k = KindConstructor
        {
            ; `getDeclaredTypeOfClassOrInterface(getMergedSymbol(declaration.Parent.
            ; Symbol()))` — the class's own instance type, which is what a constructor
            ; "returns". The parent's symbol is read directly rather than through
            ; symbol_of_declaration: the reference reads `declaration.Parent.Symbol()`,
            ; the binder's slot, and getMergedSymbol is the only lookup it does.
            let parent AstNode.parent_node_of(declaration)
            if parent = null
                return null
            let psym AstNode.symbol_of(parent as ref[AstNode])
            if psym = null
                return null
            let merged this.get_merged_symbol(psym)
            if merged = null
                return null
            return this.get_declared_type_of_class_or_interface(merged as ref[Symbol])
        }
        let return_type AstNode.type_of(declaration)
        if return_type <> null
            return this.get_type_from_type_node(return_type as ref[AstNode])
        if k = KindGetAccessor
        {
            ; "hasBindableName(declaration) && getAnnotatedAccessorType(...)" — a
            ; getter with no return annotation borrows the SETTER's parameter
            ; annotation, which slice 112's accessor chapter makes askable.
            ;
            ; ★★★ THE STOP HERE WAS AN EXPIRED NOTE (§3.5eo, slice 151): it said the
            ; guard's late-bound half *is checkComputedPropertyName's stop*, and slice
            ; 129 ported the late-binding table and has_bindable_name with it. ★A
            ; FALSE answer falls through to get_return_type_of_full_signature — the
            ; reference's conjunct guards the arm, it does not refuse the question —
            ; so the arm is nested rather than guarded by an early return.
            let mark this.unported_mark()
            let bindable this.has_bindable_name(declaration)
            if this.unported_mark() <> mark
                return null
            if bindable
            {
                let sym this.get_symbol_of_declaration(declaration)
                if sym = null
                    return null
                return this.get_annotated_accessor_type(Checker.get_declaration_of_kind(sym as ref[Symbol], KindSetAccessor))
            }
        }
        this.get_return_type_of_full_signature(declaration)
    }

    ; ── slice 84: the signature ──────────────────────────────────────────────
    ;
    ; getSignatureFromDeclaration and getReturnTypeOfSignature — the two functions
    ; the work list's largest REACHABLE row has stood in front of since slice 63,
    ; and the door to the members dimension, whose own head (`check-index-
    ; constraints`, 496 units over three kinds) needs getSignaturesOfSymbol and
    ; therefore needs this.
    ;
    ; ★★★ WHAT MAKES IT REACHABLE IS THAT IT IS ALMOST ENTIRELY SYNTACTIC. The
    ; reference's body asks four questions that are not: `resolveName` for a
    ; parameter PROPERTY (slice 79), `hasBindableName` for the accessor's borrowed
    ; `this` (slice 83), `getDeclaredTypeOfClassOrInterface` for a constructor's
    ; type parameters (slice 66) and `getDeclaredTypeOfTypeParameter` for everyone
    ; else's (slice 60). All four are here. The fifth — `getContextualType` — is a
    ; chapter, and it is the one conjunct this port does not ask; see below.
    ;
    ; ★★★ THE SLICE'S DIAGNOSTIC IS TS2408 AND IT COMES FROM THE **CALLER**. Neither
    ; function below reports anything a fixture in this corpus can reach:
    ; getReturnTypeOfSignature's two reports need a CIRCULAR annotation, and the only
    ; way to write one is `function f(): typeof f {}`, whose annotation is a TypeQuery
    ; and stops one call earlier in getTypeFromTypeNode. What the slice buys a
    ; diagnostic for is checkReturnStatement's tail: `set x(v) { return v }` is
    ; *Setters cannot return a value*, and it needs the signature only to get PAST the
    ; two lines in front of it.

    ; InterfaceType.LocalTypeParameters() — allTypeParameters from
    ; outerTypeParameterCount to the last (exclusive), i.e. the class's OWN
    ; parameters without the trailing thisType. Slice 66's note said the two
    ; slicing accessors were unwritten because *their readers are getTypeArguments'
    ; deferred path and getBaseTypes, both of which report in this slice* — and it
    ; named neither of this one's real reader, which is the constructor arm of
    ; getSignatureFromDeclaration. ★It answers a FRESH list rather than a view:
    ; Scaly's Array has no slice, and the caller stores the answer in a Signature
    ; that outlives the call.
    procedure local_type_parameters_of(this, t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when d: Interface
            {
                if d.all_type_parameters = null
                    return null
                let all d.all_type_parameters as ref[Array[ref[Type]?]]
                let n all.get_length() as int
                if n = 0
                    return null
                let out this.new_type_list(null)
                var i d.outer_type_parameter_count
                while i < (n - 1)
                {
                    out.add(all[i])
                    set i: i + 1
                }
                return out
            }
        null
    }

    ; isRestParameter / hasRestParameter. Both live on the checker upstream and
    ; both are one test; `has_rest_parameter` reads the LAST parameter, which is
    ; `core.LastOrNil` and therefore false for an empty list.
    function is_rest_parameter(param: ref[AstNode]) returns bool
        AstNode.dot_dot_dot_token_of(param) <> null

    function has_rest_parameter(signature: ref[AstNode]) returns bool
    {
        let parameters AstNode.parameters_of(signature)
        let n AstNode.list_count(parameters)
        if n = 0
            return false
        let last AstNode.child_in_list(parameters, n - 1)
        if last = null
            return false
        Checker.is_rest_parameter(last as ref[AstNode])
    }

    ; ast.GetImmediatelyInvokedFunctionExpression. Whole, and purely syntactic —
    ; the parenthesis walk is the reference's own loop, and the last test compares
    ; the call's EXPRESSION against the node the walk came up through, so
    ; `(function(){})()` answers the call and `f(function(){})` answers nil.
    ; ★ ast.GetImmediatelyInvokedFunctionExpression MOVED TO ast.scaly IN SLICE 92,
    ; where the reference keeps it (internal/ast/utilities.go). bindContainer asks
    ; it to decide whether a function expression is an IIFE — which decides whether
    ; the container gets a flow graph of its OWN or joins the containing one — and
    ; the binder is declared before the checker, so a copy here would have been the
    ; §3.5br class: an accessor narrowed to its first caller, paid for twice.

    ; getAccessorThisParameter / getAnnotatedAccessorThisParameter. The arity test
    ; is the reference's — ONE higher than the accessor's plain arity — and
    ; does_accessor_have_correct_parameter_count already carries the same pair of
    ; numbers at its own line (slice 83).
    function get_accessor_this_parameter(accessor: ref[AstNode]) returns ref[AstNode]?
    {
        let parameters AstNode.parameters_of(accessor)
        let n AstNode.list_count(parameters)
        var plain 1
        if AstNode.kind_of(accessor) = KindGetAccessor
            set plain: 0
        if n <> plain + 1
            return null
        let first AstNode.child_in_list(parameters, 0)
        if AstNode.is_this_parameter(first) = false
            return null
        first
    }

    function get_annotated_accessor_this_parameter(accessor: ref[AstNode]) returns ref[Symbol]?
    {
        let parameter Checker.get_accessor_this_parameter(accessor)
        if parameter = null
            return null
        AstNode.symbol_of(parameter)
    }

    ; newSignature. `resolvedMinArgumentCount` is -1 in the constructor and not a
    ; parameter, which is the reference's own shape.
    procedure new_signature(this, flags: int, declaration: ref[AstNode]?, type_parameters: ref[Array[ref[Type]?]]?, this_parameter: ref[Symbol]?, parameters: ref[Array[ref[Symbol]?]]?, resolved_return_type: ref[Type]?, min_argument_count: int) returns ref[Signature]
    {
        set signature_count: signature_count + 1
        let s &Signature^host(signature_count, flags, declaration, type_parameters, this_parameter, parameters, resolved_return_type, min_argument_count)
        s
    }

    ; getTypeParametersFromDeclaration. Its loop IS append_type_parameters — the
    ; reference writes `core.AppendIfUnique(result, c.getDeclaredTypeOfTypeParameter(
    ; node.Symbol()))` and that helper is the same two lines over the same list
    ; (slice 60) — so the function is its GUARD plus one call. ★The one difference
    ; is that append_type_parameters routes the declaration through
    ; symbol_of_declaration where the reference reads `node.Symbol()` directly, and
    ; for a TYPE PARAMETER the two coincide: get_late_bound_symbol's guard needs a
    ; computed name and get_merged_symbol is the identity here.
    procedure get_type_parameters_from_declaration(this, declaration: ref[AstNode]) returns ref[Array[ref[Type]?]]?
    {
        ; A `@type` tag carrying a whole function type supplies the type
        ; parameters directly (slice 174).
        let full_sig this.get_signature_of_full_signature_type(declaration)
        if full_sig <> null
            return (full_sig as ref[Signature]).type_parameters
        this.append_type_parameters(null, AstNode.type_parameters_of(declaration))
    }

    ; getSignatureFromDeclaration, WHOLE since slice 138.
    ;
    ; ★★★ `isUntypedSignatureInJSFile` WAS THE ONE DROPPED CONJUNCT, AND THE
    ; ARGUMENT FOR DROPPING IT WAS ALREADY FALSE WHEN IT WAS WRITTEN. It read: *a
    ; flag with no reader is not ported — it is only DECLARED*, and named the
    ; relation as the only reader. But `get_min_argument_count` reads it TWO SCREENS
    ; UP in this same file (*"if IsUntypedSignatureInJSFile return 0"*), and in a JS
    ; file an unannotated parameter is therefore OPTIONAL — so with the flag never
    ; set, every `function f(x) {}` in a `.js` unit had a minimum of ONE.
    ;
    ; ★★★ NOTHING COULD SEE IT UNTIL THERE WAS AN ARITY REPORT. `has_correct_arity`
    ; answered false and the resolution simply failed, which was one more UNPORTED
    ; unit; the moment slice 138's `report_argument_arity_error` landed, the same
    ; wrong minimum became **six spurious TS2554 on one unit** (salsa/
    ; unannotatedParametersAreOptional) and one more on jsdocReadonlyDeclarations.
    ; §3.5fp's class: **a dropped line in a ported function produces no row on any
    ; frontier**, and a note that justifies the drop by naming the readers ages
    ; exactly as fast as the reader list.
    ;
    ; ★★ ITS LAST TERM IS `getContextualType(declaration, ContextFlagsSignature)`,
    ; which was the real reason for the drop and is ported since the contextual
    ; chapter. The other four are the IIFE (already here, for the min-argument
    ; count's fourth disjunct), a JS file, one of five function-like kinds, and
    ; every parameter unannotated.
    ;
    ; ★★★ THE PARAMETER-PROPERTY DETOUR IS THE ONE PLACE A SIGNATURE ASKS THE
    ; RESOLVER. `constructor(private x: number)` binds its parameter TWICE — once as
    ; a parameter and once as the class property the binder synthesises — and the
    ; symbol hanging off the node is the PROPERTY, so the reference re-resolves the
    ; name in the parameter's own scope to get the parameter symbol back. It hands
    ; resolveName a nil nameNotFoundMessage, so a miss is silent and answers nil,
    ; which is what the reference then stores.
    ;
    ; ★★ AND THE FIRST PARAMETER'S NAME IS COMPARED AS BYTES, not by asking
    ; is_this_parameter about the NODE. The reference tests `paramSymbol.Name ==
    ; ast.InternalSymbolNameThis`, and the two are not the same question at the one
    ; place they can differ: a parameter whose symbol was replaced by the detour
    ; above carries the PROPERTY's name. `this` is one of the few internal names
    ; that is not behind the 0xFE prefix, which get_type_for_variable_like_
    ; declaration's parameter arm already relies on.
    procedure get_signature_from_declaration(this, declaration: ref[AstNode]) returns ref[Signature]?
    {
        let links this.signature_link_of(declaration)
        if links.resolved_signature <> null
            return links.resolved_signature

        let mark this.unported_mark()
        var flags SignatureFlagsNone
        var this_parameter: ref[Symbol]? null
        var min_argument_count 0
        var has_this_parameter false
        let iife AstNode.get_immediately_invoked_function_expression(declaration)
        let parameters &Array[ref[Symbol]?]^host()

        ; isUntypedSignatureInJSFile — the five conjuncts, in the reference's own
        ; order, and the contextual type LAST because it is the expensive one.
        if iife = null
        {
            if Parser.is_in_js_file(declaration)
            {
                let dk AstNode.kind_of(declaration)
                var function_like false
                if dk = KindFunctionExpression
                    set function_like: true
                if dk = KindArrowFunction
                    set function_like: true
                if dk = KindFunctionDeclaration
                    set function_like: true
                if dk = KindConstructor
                    set function_like: true
                if AstNode.is_method_or_accessor(declaration)
                    set function_like: true
                if function_like
                {
                    var all_untyped true
                    let plist AstNode.parameters_of(declaration)
                    var pi 0
                    while pi < AstNode.list_count(plist)
                    {
                        let p AstNode.child_in_list(plist, pi)
                        set pi: pi + 1
                        if p = null
                            continue
                        if AstNode.type_of(p as ref[AstNode]) <> null
                            set all_untyped: false
                    }
                    if all_untyped
                    {
                        let ctx this.get_contextual_type(declaration, ContextFlagsSignature)
                        if this.unported_mark() <> mark
                            return null
                        if ctx = null
                            set flags: flags | SignatureFlagsIsUntypedSignatureInJSFile
                    }
                }
            }
        }

        var this_data Slice[char]()
        set this_data: Binder.internal_name_unprefixed(host, "this")

        let param_list AstNode.parameters_of(declaration)
        let param_count AstNode.list_count(param_list)
        var i 0
        while i < param_count
        {
            let pn AstNode.child_in_list(param_list, i)
            if pn = null
            {
                set i: i + 1
                continue
            }
            let param pn as ref[AstNode]
            var param_symbol AstNode.symbol_of(param)
            let type_node AstNode.type_of(param)
            if param_symbol <> null
            {
                let ps param_symbol as ref[Symbol]
                if (Symbol.flags_of(ps) & SymbolFlagsProperty) <> 0
                {
                    if AstNode.is_binding_pattern(AstNode.name_of(param)) = false
                    {
                        set param_symbol: this.resolve_name(param, Symbol.name_of(ps), SymbolFlagsValue, 0, false, false)
                        if this.unported_mark() <> mark
                            return null
                    }
                }
            }
            var is_this_symbol false
            if i = 0
            {
                if param_symbol <> null
                {
                    let ps2 param_symbol as ref[Symbol]
                    if SymbolTable.names_equal(Symbol.name_of(ps2), this_data)
                        set is_this_symbol: true
                }
            }
            if is_this_symbol
            {
                set has_this_parameter: true
                ; `thisParameter = param.Symbol()` — the NODE's symbol, not the
                ; possibly-re-resolved one. The reference writes it that way and the
                ; two differ exactly when the detour above fired.
                set this_parameter: AstNode.symbol_of(param)
            }
            else
                parameters.add(param_symbol)
            if type_node <> null
            {
                if AstNode.kind_of(type_node as ref[AstNode]) = KindLiteralType
                    set flags: flags | SignatureFlagsHasLiteralTypes
            }
            var is_optional_parameter false
            if Checker.is_optional_declaration(param)
                set is_optional_parameter: true
            if AstNode.initializer_of(param) <> null
                set is_optional_parameter: true
            if Checker.is_rest_parameter(param)
                set is_optional_parameter: true
            if iife <> null
            {
                if type_node = null
                {
                    if (parameters.get_length() as int) > AstNode.list_count(AstNode.call_arguments_of(iife as ref[AstNode]))
                        set is_optional_parameter: true
                }
            }
            if is_optional_parameter = false
                set min_argument_count: parameters.get_length() as int
            set i: i + 1
        }

        ; "If only one accessor includes a this-type annotation, the other behaves as
        ; if it had the same type annotation."
        let dk AstNode.kind_of(declaration)
        var is_accessor false
        if dk = KindGetAccessor
            set is_accessor: true
        if dk = KindSetAccessor
            set is_accessor: true
        if is_accessor
        {
            var needs_other false
            if has_this_parameter = false
                set needs_other: true
            if this_parameter = null
                set needs_other: true
            if needs_other
            {
                ; hasBindableName. Slice 83 ports its guard at the accessor's own
                ; arm.
                ;
                ; ★★★ THE STOP HERE WAS AN EXPIRED NOTE (§3.5eo, slice 151) — *its
                ; answer is checkComputedPropertyName or checkExpressionCached, an
                ; expression either way* — and slice 129 ported both. ★A FALSE answer
                ; leaves `this_parameter` as it stands and the signature is built
                ; without the sibling's annotation; it is a conjunct of the
                ; reference's guard, not a refusal.
                let bindable this.has_bindable_name(declaration)
                if this.unported_mark() <> mark
                    return null
                if bindable
                {
                    var other_kind KindGetAccessor
                    if dk = KindGetAccessor
                        set other_kind: KindSetAccessor
                    let acc_sym this.symbol_of_declaration(declaration)
                    if this.unported_mark() <> mark
                        return null
                    if acc_sym <> null
                    {
                        let other Checker.declaration_of_kind(acc_sym as ref[Symbol], other_kind)
                        if other <> null
                            set this_parameter: Checker.get_annotated_accessor_this_parameter(other as ref[AstNode])
                    }
                }
            }
        }

        var type_parameters: ref[Array[ref[Type]?]]? null
        if dk = KindConstructor
        {
            let parent AstNode.parent_node_of(declaration)
            if parent <> null
            {
                let psym AstNode.symbol_of(parent as ref[AstNode])
                if psym <> null
                {
                    let merged this.get_merged_symbol(psym)
                    if merged <> null
                    {
                        let class_type this.get_declared_type_of_class_or_interface(merged as ref[Symbol])
                        if this.unported_mark() <> mark
                            return null
                        if class_type <> null
                            set type_parameters: this.local_type_parameters_of(class_type as ref[Type])
                    }
                }
            }
        }
        ; ★ The reference's `if classType != nil` is what selects the branch, and a
        ; constructor whose class type this port could not build would take the
        ; ELSE arm there. It cannot happen here: the only way class_type is nil is a
        ; stop, and a stop has already returned above.
        if dk <> KindConstructor
        {
            set type_parameters: this.get_type_parameters_from_declaration(declaration)
            if this.unported_mark() <> mark
                return null
        }

        if Checker.has_rest_parameter(declaration)
            set flags: flags | SignatureFlagsHasRestParameter
        var is_construct false
        if dk = KindConstructorType
            set is_construct: true
        if dk = KindConstructor
            set is_construct: true
        if dk = KindConstructSignature
            set is_construct: true
        if is_construct
            set flags: flags | SignatureFlagsConstruct
        var is_abstract false
        if dk = KindConstructorType
        {
            if b.has_syntactic_modifier(declaration, ModifierFlagsAbstract)
                set is_abstract: true
        }
        if dk = KindConstructor
        {
            let cparent AstNode.parent_node_of(declaration)
            if cparent <> null
            {
                if b.has_syntactic_modifier(cparent as ref[AstNode], ModifierFlagsAbstract)
                    set is_abstract: true
            }
        }
        if is_abstract
            set flags: flags | SignatureFlagsAbstract

        set links.resolved_signature: this.new_signature(flags, declaration, type_parameters, this_parameter, parameters, null, min_argument_count)
        links.resolved_signature
    }

    ; getReturnTypeOfSignature, whose switch is ONE arm here — see Signature's own
    ; note for why the other two are provably dead rather than omitted.
    ;
    ; ★★★ THE CYCLE GUARD IS THE HALF WORTH PORTING EXACTLY, AND IT IS THE FIRST
    ; PUSH KEYED ON A SIGNATURE. Without pushTypeResolution a self-referential return
    ; annotation recurses until the stack ends; with it the frames from the cycle's
    ; start are MARKED failed on the way in and each learns on the way out that its
    ; answer is not to be memoised, which is slice 67's design restated. ★Its two
    ; reports are written and neither is reachable from this corpus: the only
    ; annotation that can reference its own function is a TypeQuery (`typeof f`), and
    ; getTypeFromTypeNode stops on that kind — so the pop can never answer false
    ; here. They are WRITTEN rather than stopped because a stop in a branch nothing
    ; can enter is a work-list row that can never appear (slice 82's rule), and
    ; because both are one line over machinery that already exists.
    ;
    ; ★★ `getReturnTypeFromBody` IS THE STOP, and it is the common case rather than
    ; the exotic one: every function with a body and no return annotation goes
    ; through it. That is the inference chapter — checkExpressionCached over every
    ; return statement, then getUnionType over what they answer — so the row it
    ; raises names two dimensions and not one.
    ; The two call-chain arms of getReturnTypeOfSignature, and what they do is the
    ; whole of an optional call's `| undefined`: an INNER link carries the marker
    ; so the chain's outermost link can turn it into the union, and the OUTER link
    ; IS that union.
    ;
    ; ★★★ THE STOP THAT STOOD IN THEIR PLACE READ *both bits are declared and
    ; neither has a writer in this port* — a premise slice 139 expired when it
    ; wrote resolveCallExpression's fork and getOptionalCallSignature's clone —
    ; and slice 176 measured its cost from the other side: five stage-2 units
    ; whose only difference from the reference was that missing `| undefined`.
    ;
    ; ★★★ IT IS A FUNCTION AND NOT THREE COPIES BECAUSE THE REFERENCE'S SWITCH HAS
    ; ONE TAIL AND THIS PORT'S THREE ARMS RETURN SEPARATELY. Upstream applies the
    ; two tests AFTER the switch, so they reach the INSTANTIATED and the COMPOSITE
    ; answer as well as the declaration's — and `cloneSignature` copies `target`,
    ; so an optional call on an instantiated signature is exactly the shape that
    ; would have been missed by writing the arms only where the stop was.
    procedure apply_call_chain_flags(this, sig: ref[Signature], t: ref[Type]) returns ref[Type]?
    {
        if (sig.flags & SignatureFlagsIsInnerCallChain) <> 0
            return this.add_optional_type_marker(t)
        if (sig.flags & SignatureFlagsIsOuterCallChain) <> 0
            return this.get_optional_type(t, false)
        t
    }

    ; The `!popTypeResolution()` tail of getReturnTypeOfSignature — TS2577 on the
    ; annotation, else under noImplicitAny TS7023 on the declaration's name or
    ; TS7024 on the declaration.
    ;
    ; ★★★ `ast.GetNameOfDeclaration`, NOT `decl.Name()` — the difference is the
    ; whole fork. A function EXPRESSION has no name of its own and is named by
    ; what it is assigned to, so `var fn2 = function(name) { … }` reports TS7023
    ; AT `fn2` upstream where the bare accessor answers null and takes the
    ; anonymous TS7024 arm. Corrected in slice 182, on
    ; `simpleRecursionWithBaseCase4`, whose unit reached this line for the first
    ; time that slice.
    procedure report_circular_return_type(this, decl: ref[AstNode]?)
    {
        if decl = null
            return
        let d decl as ref[AstNode]
        let type_node AstNode.type_of(d)
        if type_node <> null
        {
            this.error_on_node(type_node as ref[AstNode], DiagReturn_type_annotation_circularly_references_itself)
            return
        }
        if Checker.no_implicit_any() = false
            return
        let name b.get_name_of_declaration(d)
        if name <> null
            this.error_on_node(name as ref[AstNode], DiagX_0_implicitly_has_return_type_any_because_it_does_not_have_a_return_type_annotation_and_is_referenced_directly_or_indirectly_in_one_of_its_return_expressions, this.declaration_name_to_string(name))
        else
            this.error_on_node(d, DiagFunction_implicitly_has_return_type_any_because_it_does_not_have_a_return_type_annotation_and_is_referenced_directly_or_indirectly_in_one_of_its_return_expressions)
    }

    procedure get_return_type_of_signature(this, sig: ref[Signature]) returns ref[Type]?
    {
        if sig.resolved_return_type <> null
            return sig.resolved_return_type
        if this.push_type_resolution(null, null, sig, null, TypeSystemPropertyNameResolvedReturnType) = false
            return error_type
        let mark this.unported_mark()
        var t: ref[Type]? null
        ; ★★ THE INSTANTIATED ARM, slice 86, and it had to land with the two slots:
        ; an instantiated signature's return type is its TARGET's return type put
        ; through the mapper, and without this arm the switch would fall to the
        ; declaration below and answer the UNinstantiated annotation — a silently
        ; wrong type rather than a stop. ★★★THE COMPOSITE ARM BELOW IT IS SLICE
        ; 155's, and it arrives for the same reason: without it a union signature
        ; falls to the DECLARATION arm and answers the return type of whichever
        ; constituent happened to lend its declaration to the clone — silently one
        ; of the arms rather than the fold of them.
        if sig.target <> null
        {
            let inner this.get_return_type_of_signature(sig.target as ref[Signature])
            if this.unported_mark() <> mark
            {
                this.pop_type_resolution_defensively()
                return null
            }
            if inner = null
            {
                this.pop_type_resolution_defensively()
                return null
            }
            let mapped this.instantiate_type(inner, sig.mapper)
            if this.unported_mark() <> mark
            {
                this.pop_type_resolution_defensively()
                return null
            }
            if mapped = null
            {
                this.pop_type_resolution_defensively()
                return null
            }
            let adjusted this.apply_call_chain_flags(sig, mapped as ref[Type])
            if this.unported_mark() <> mark
            {
                this.pop_type_resolution_defensively()
                return null
            }
            if adjusted = null
            {
                this.pop_type_resolution_defensively()
                return null
            }
            var final: ref[Type] adjusted as ref[Type]
            if this.pop_type_resolution() = false
            {
                ; The reference's tail is shared by both paths: the report goes
                ; on the (instantiated) signature's declaration and the answer is
                ; `any` (slice 202, `recursiveResolveTypeMembers`).
                this.report_circular_return_type(sig.declaration)
                set final: any_type
            }
            if sig.resolved_return_type = null
                set sig.resolved_return_type: final
            return sig.resolved_return_type
        }
        ; The COMPOSITE arm — the fold of every member's return type, then the
        ; signature's own mapper. ★The reduction is SUBTYPE here and LITERAL at
        ; every other getUnionOrIntersectionType call site in this file, which is
        ; upstream's own choice: a return type is a value the caller reads, so
        ; `1 | number` is worth reducing to `number`.
        if sig.composite <> null
        {
            let comp sig.composite as ref[CompositeSignature]
            let members &Array[ref[Type]?]()
            if comp.signatures <> null
            {
                let inner comp.signatures as ref[Array[ref[Signature]?]]
                let cn inner.get_length() as int
                var ci 0
                while ci < cn
                {
                    let row inner[ci]
                    set ci: ci + 1
                    if row = null
                        continue
                    let rt this.get_return_type_of_signature(row as ref[Signature])
                    if this.unported_mark() <> mark
                    {
                        this.pop_type_resolution_defensively()
                        return null
                    }
                    if rt = null
                    {
                        this.pop_type_resolution_defensively()
                        return null
                    }
                    members.add(rt)
                }
            }
            let folded this.get_union_or_intersection_type(members, comp.is_union, UnionReductionSubtype)
            if this.unported_mark() <> mark
            {
                this.pop_type_resolution_defensively()
                return null
            }
            if folded = null
            {
                this.pop_type_resolution_defensively()
                return null
            }
            let mapped this.instantiate_type(folded, sig.mapper)
            if this.unported_mark() <> mark
            {
                this.pop_type_resolution_defensively()
                return null
            }
            if mapped = null
            {
                this.pop_type_resolution_defensively()
                return null
            }
            let adjusted this.apply_call_chain_flags(sig, mapped as ref[Type])
            if this.unported_mark() <> mark
            {
                this.pop_type_resolution_defensively()
                return null
            }
            if adjusted = null
            {
                this.pop_type_resolution_defensively()
                return null
            }
            if this.pop_type_resolution() = false
            {
                this.record_unported("composite-return-type-circular", sig.flags)
                return null
            }
            set sig.resolved_return_type: adjusted
            return adjusted
        }
        if sig.declaration = null
        {
            ; The reference reaches `sig.declaration.Body()` unguarded, because the
            ; two arms above it are the only ones that can carry a nil declaration
            ; and both are dead here. Answered rather than trapped, on this file's
            ; rule about assertions.
            this.pop_type_resolution_defensively()
            this.record_unported("get-return-type-of-signature-no-declaration", 0)
            return null
        }
        let decl sig.declaration as ref[AstNode]
        set t: this.get_return_type_from_annotation(decl)
        if this.unported_mark() <> mark
        {
            this.pop_type_resolution_defensively()
            return null
        }
        if t = null
        {
            if Binder.node_is_missing(AstNode.body_of(decl)) = false
            {
                set t: this.get_return_type_from_body(decl, CheckModeNormal)
                if this.unported_mark() <> mark
                {
                    this.pop_type_resolution_defensively()
                    return null
                }
                if t = null
                {
                    this.pop_type_resolution_defensively()
                    return null
                }
            }
            else
                set t: any_type
        }
        set t: this.apply_call_chain_flags(sig, t as ref[Type])
        if this.unported_mark() <> mark
        {
            this.pop_type_resolution_defensively()
            return null
        }
        if t = null
        {
            this.pop_type_resolution_defensively()
            return null
        }
        if this.pop_type_resolution() = false
        {
            this.report_circular_return_type(decl)
            set t: any_type
        }
        if sig.resolved_return_type = null
            set sig.resolved_return_type: t
        sig.resolved_return_type
    }

    ; checkAllCodePathsInNonVoidFunctionReturnOrThrow, ported down to the one
    ; question this port cannot ask.
    ;
    ; ★★★ THE `t == nil` COLLAPSE IS THE SLICE, and it is written as an ASSERTION and
    ; not as an argument in a comment. With no return type the first three switch
    ; cases are dead by their own `t != nil` guard and the fourth is dead by the
    ; option, so nothing below the guards can report — and the guards themselves only
    ; RETURN. The stop therefore fires if noImplicitReturns ever moves, which is
    ; slice 79's shape for useOuterVariableScopeInParameter: **without it the reduced
    ; form becomes a silent wrong answer in the direction that LOSES a diagnostic.**
    ;
    ; ★★ WHAT IS OMITTED, WITH THE READER NAMED (§3.5ao). `hasExplicitReturn`, the
    ; errorNode walk (node.Type(), else the FullSignature, else the function) and the
    ; four switch arms all sit behind functionHasImplicitReturn, so they arrive with
    ; the flow graph and not before. The three codes they carry — TS2534, TS2355 and
    ; TS2366 — are named here rather than written, because a report this port cannot
    ; reach is a line no instrument can see.
    procedure check_all_code_paths_in_non_void_function_return_or_throw(this, fn: ref[AstNode], return_type: ref[Type]?)
    {
        let mark this.unported_mark()
        let function_flags b.get_function_flags(fn)
        var t: ref[Type]? null
        if return_type <> null
        {
            set t: this.unwrap_return_type(return_type as ref[Type], function_flags, fn)
            if this.unported_mark() <> mark
                return
        }
        ; ★★★ SLICE 184: THE `if t = null { … return }` THAT STOOD HERE WAS A
        ; COLLAPSE JUSTIFIED BY THE DIAGNOSTICS, AND IT REMOVED A CALL WHOSE
        ; SIDE EFFECT IS A DIAGNOSTIC SOMEWHERE ELSE. Upstream never returns on a
        ; nil `t`: it SKIPS the void/any pair (whose guard is `t != nil`), runs the
        ; three syntactic guards and `functionHasImplicitReturn`, and only then
        ; reaches a switch whose every arm but the last needs `t != nil`. The
        ; collapse was therefore exact about what this function REPORTS — with
        ; no_implicit_returns() a constant false here, a nil `t` can report nothing
        ; — and wrong about what it CAUSES: function_has_implicit_return runs the
        ; reachability walk, whose Call arm asks get_effects_signature, whose
        ; expression-statement arm asks get_type_of_dotted_name, whose super arm
        ; calls check_super_expression, WHICH REPORTS. A function with no return
        ; annotation whose LAST statement is an illegal `super` call therefore lost
        ; the reference's second diagnostic — and that is most of the twelve units
        ; this slice is about, because a lone `super.m();` in a method body has no
        ; following statement for the unreachable chapter's own walk to reach.
        ; ★It is within_unreachable_code's note one level down, and the same
        ; sentence: a proof about the REPORT is not a proof about the CHAPTER.
        if t <> null
        {
            let ty0 t as ref[Type]
            ; "Functions with an explicitly specified return type that includes
            ; `void` or is exactly `any` or `undefined` don't need any return
            ; statements."
            if Checker.maybe_type_of_kind(ty0, TypeFlagsVoid)
                return
            if (ty0.flags & (TypeFlagsAny | TypeFlagsUndefined)) <> 0
                return
        }
        ; "If all we have is a function signature, or an arrow function with an
        ; expression body, then there is nothing to check." The three syntactic terms
        ; of that guard are asked in the reference's order; the fourth is the stop.
        if AstNode.kind_of(fn) = KindMethodSignature
            return
        let body AstNode.body_of(fn)
        if Binder.node_is_missing(body)
            return
        if AstNode.kind_of(body as ref[AstNode]) <> KindBlock
            return
        ; functionHasImplicitReturn — `fn.BodyData().EndFlowNode != nil &&
        ; c.isReachableFlowNode(endFlowNode)`, and it is ANSWERED since slice 93.
        ;
        ; ★★★ IT IS THE HALF OF THE FLOW CHAPTER THAT NEEDS NO TYPE, AND THAT IS
        ; WHY THIS CALLER LANDS WHERE checkPropertyInitialization DOES NOT. Both
        ; stood behind the tag `flow-graph`; one of them wants a reachability walk
        ; over the graph and the other wants a flow TYPE for a synthesized `this.p`
        ; whose initial type is getOptionalType. Sharing a tag made them look like
        ; one wall (slice 77 named it precisely because two chapters share it), and
        ; they are two.
        ; ★★★ THE MARK IS CHECKED HERE AND STAGE 2 IS WHY. isReachableFlowNode
        ; answers a BOOL, so the getEffectsSignature stop inside its Call arm
        ; cannot travel out through the answer — and that arm's honest answer is
        ; *reachable*, which is the direction that INVENTS. Measured: without this
        ; guard, `class C { err(): never { super.throw() } }` reports TS2534 twice
        ; where the reference reports nothing, because a callee returning never
        ; makes the end point unreachable and only getEffectsSignature knows that.
        ; ★It is ONE unit of 18 242 and NOT ONE of the 1 473 at stage 1 — slice
        ; 64's *confirm at stage 2 once* earning its rule in a single run.
        let fhir_mark this.unported_mark()
        let fhir this.function_has_implicit_return(fn)
        if this.unported_mark() <> fhir_mark
            return
        if fhir = false
            return
        var has_explicit_return false
        if (AstNode.flags_of(fn) & NodeFlagsHasExplicitReturn) <> 0
            set has_explicit_return: true
        ; The errorNode walk: the return type annotation, else the JSDoc full
        ; signature, else the function itself.
        var error_node: ref[AstNode]? AstNode.type_of(fn)
        if error_node = null
            set error_node: AstNode.full_signature_of(fn)
        if error_node = null
            set error_node: fn
        ; The four-arm switch, in the reference's order — a `switch` with no
        ; subject is an ORDERED chain (§3.5u).
        ;
        ; ★★★ THE FIRST THREE ARMS CARRY `t != nil` AS A CONJUNCT UPSTREAM and the
        ; nesting below is that conjunct: with no return annotation the only arm
        ; that can fire is the noImplicitReturns one at the bottom. Before slice
        ; 184 the conjunct was an early return at the top of the function, which
        ; is the same thing for the REPORTS and not for the walk above.
        if t <> null
        {
            let ty t as ref[Type]
            if (ty.flags & TypeFlagsNever) <> 0
            {
                this.error_on_node(error_node, DiagA_function_returning_never_cannot_have_a_reachable_end_point)
                return
            }
            if has_explicit_return = false
            {
                this.error_on_node(error_node, DiagA_function_whose_declared_type_is_neither_undefined_void_nor_any_must_return_a_value)
                return
            }
            ; isTypeAssignableTo(undefinedType, t). ★★★THE NOTE HERE CALLED IT *the only
            ; term of the four this port cannot ask* and the relation chapter had already
            ; answered it. ★★★THE MARK IS STILL READ AND THE STOP IS STILL KEPT, for the
            ; reason check_rest_parameter_is_array_like records: this arm's `no` is a
            ; REPORT, so reading a relation that could not answer as one invents TS2366
            ; on every function whose return type the checker cannot compare. When the
            ; relation answers YES the reference falls through to the noImplicitReturns
            ; arm, which is why that one is not an `else`.
            if Checker.strict_null_checks()
            {
                let rel_mark this.unported_mark()
                let assignable this.is_type_assignable_to(undefined_type, ty)
                if this.unported_mark() <> rel_mark
                {
                    this.record_unported("is-type-assignable-to", AstNode.kind_of(fn))
                    return
                }
                if assignable = false
                {
                    this.error_on_node(error_node, DiagFunction_lacks_ending_return_statement_and_return_type_does_not_include_undefined)
                    return
                }
            }
        }
        if Checker.no_implicit_returns()
        {
            if t = null
            {
                ; no annotation: without an explicit return the inferred type is
                ; void; otherwise only a non-void inferred type reports
                if has_explicit_return = false
                    return
                let smark this.unported_mark()
                let sig this.get_signature_from_declaration(fn)
                if (sig = null) or (this.unported_mark() <> smark)
                    return
                let inferred this.get_return_type_of_signature(sig as ref[Signature])
                if this.unported_mark() <> smark
                    return
                if inferred <> null
                {
                    let is_void this.is_unwrapped_return_type_undefined_void_or_any(fn, inferred as ref[Type])
                    if this.unported_mark() <> smark
                        return
                    if is_void
                        return
                }
            }
            this.error_on_node(error_node, DiagNot_all_code_paths_return_a_value)
        }
    }

    ; functionHasImplicitReturn — two reads and the reachability walk.
    ;
    ; ★ The slot is on the FUNCTION node and not on its body: upstream it is
    ; `fn.BodyData().EndFlowNode`, i.e. a field of the function-like data, and the
    ; binder writes it through `n.end_flow_node` at the container's close.
    procedure function_has_implicit_return(this, fn: ref[AstNode]) returns bool
    {
        let end AstNode.end_flow_node_of(fn)
        if end = null
            return false
        this.is_reachable_flow_node(end as ref[FlowNode])
    }

    ; isPrivateWithinAmbient. ★`ast.HasModifier` and `ast.HasSyntacticModifier` are
    ; the SAME expression at this pin — both are `node.ModifierFlags()&flags != 0` —
    ; so the binder's predicate is exact for the reference's spelling here.
    function is_private_within_ambient(this, node: ref[AstNode]) returns bool
    {
        if (AstNode.flags_of(node) & NodeFlagsAmbient) = 0
            return false
        if b.has_syntactic_modifier(node, ModifierFlagsPrivate)
            return true
        AstNode.is_private_identifier_class_element_declaration(node)
    }

    ; ── slice 85: the MEMBERS ────────────────────────────────────────────────
    ;
    ; resolveStructuredTypeMembers and the three accessors over it —
    ; getPropertiesOfType, getSignaturesOfType, getIndexInfosOfType. It is the
    ; dimension slice 84 called *"the door"*: its own header named
    ; `check-index-constraints` (496 units over three kinds, the largest reachable
    ; row of the work list) and said the row needs getSignaturesOfSymbol and
    ; therefore needs the signature. The signature landed; this is the room behind
    ; the door.
    ;
    ; ★★★ THE SLICE TAKES THE CLASS-OR-INTERFACE ARM AND STOPS AT THE INSTANTIATING
    ; ONE, AND WHICH TYPES THAT COVERS IS DECIDED IN get_declared_type_of_class_or_
    ; interface RATHER THAN HERE. That function sets ObjectFlagsReference on every
    ; declared type it gives a `this` type — which is EVERY CLASS (`kind ==
    ; ObjectFlagsClass` is one of the three disjuncts) and every generic or
    ; this-using interface — and upstream's switch tests Reference BEFORE
    ; ClassOrInterface. So a class goes to resolveTypeReferenceMembers, whose
    ; `paddedTypeArguments` ends in the type itself while `typeParameters` ends in
    ; the thisType, the two lists are therefore never equal, and the members are
    ; INSTANTIATED through a mapper: instantiateSymbolTable, instantiateSignatures,
    ; instantiateIndexInfos, and behind them TypeMapper and couldContainTypeVariables.
    ; That is a chapter of its own and it is this slice's first stop.
    ;
    ; ★★★ WHAT IS LEFT IS NOT A REMNANT — IT IS THE TWO CONTAINER KINDS THE ROW IS
    ; BIGGEST ON. A non-generic interface free of `this` gets no Reference flag and
    ; goes straight to resolveClassOrInterfaceMembers, and a TYPE LITERAL is an
    ; anonymous type whose symbol is a TypeLiteral — the middle branch of
    ; resolveAnonymousTypeMembers, which is three calls this slice writes anyway.
    ; The class arm moves from `check-index-constraints` to a stop one call deeper,
    ; which is the honest half of the result and is what the battery's premise row
    ; measures.
    ;
    ; ★★★ AND THE SLICE BUYS ALMOST NO DIAGNOSTIC, FOR A REASON THAT IS STRUCTURAL
    ; RATHER THAN A GAP. checkIndexConstraints reports nothing until a type HAS an
    ; index signature: its first two lines are `getIndexInfosOfType` and `if len ==
    ; 0 return`, and everything after that line needs `isTypeAssignableTo` — the
    ; relation, an entire dimension. So for the overwhelming majority of the corpus
    ; the function is now COMPLETE and silent, and for the few units with an index
    ; signature it stops one line further in than it did. **A slice whose product is
    ; that a walk gets FURTHER is measured by the stop log and by nothing else**,
    ; which is slice 84's finding arriving a second time.

    ; ── the two payload accessors, and why they are functions ────────────────
    ;
    ; `t.AsStructuredType()` and `t.AsInterfaceType()`, which upstream are casts
    ; and here are a `choose` over the payload union. The READ answers null for an
    ; arm that has no such slot — an intrinsic, a type parameter, a literal — which
    ; is what upstream's cast would panic on, and every caller here is guarded by
    ; the flags test that made the cast legal there.

    function structured_members_of(t: ref[Type]) returns ref[StructuredMembers]?
    {
        choose t.data
            when i: Interface
                return i.resolved
            when a: Anonymous
                return a.resolved
            when m: Mapped
                return m.resolved
            when rm: ReverseMapped
                return rm.resolved
            when r: Reference
                return r.resolved
            when u: Union
                return u.resolved
            when x: Intersection
                return x.resolved
            when ie: InstantiationExpression
                return ie.resolved
        null
    }

    ; ★★ THE ATTACH IS THE ONLY WRITE THAT NEEDS THE COPY/MUTATE/WRITE-BACK DANCE,
    ; and that is the whole argument for holding the members behind a reference: a
    ; `when` binding is a COPY, so a slot written through one is written into a
    ; temporary (the root CLAUDE.md's rule). Attaching once and storing through the
    ; reference afterwards pays the dance exactly one time per type.
    procedure attach_structured_members(t: ref[Type], sm: ref[StructuredMembers])
    {
        choose t.data
            when i: Interface
            {
                var d i
                set d.resolved: sm
                set t.data: TypeData.Interface(d)
            }
            when a: Anonymous
            {
                var d a
                set d.resolved: sm
                set t.data: TypeData.Anonymous(d)
            }
            when ie: InstantiationExpression
            {
                var d ie
                set d.resolved: sm
                set t.data: TypeData.InstantiationExpression(d)
            }
            when m: Mapped
            {
                var d m
                set d.resolved: sm
                set t.data: TypeData.Mapped(d)
            }
            when rm: ReverseMapped
            {
                var d rm
                set d.resolved: sm
                set t.data: TypeData.ReverseMapped(d)
            }
            when r: Reference
            {
                var d r
                set d.resolved: sm
                set t.data: TypeData.Reference(d)
            }
            when u: Union
            {
                var d u
                set d.resolved: sm
                set t.data: TypeData.Union(d)
            }
            when x: Intersection
            {
                var d x
                set d.resolved: sm
                set t.data: TypeData.Intersection(d)
            }
    }

    function declared_members_of(t: ref[Type]) returns ref[DeclaredMembers]?
    {
        choose t.data
            when i: Interface
                return i.declared
        null
    }

    procedure attach_declared_members(t: ref[Type], dm: ref[DeclaredMembers])
    {
        choose t.data
            when i: Interface
            {
                var d i
                set d.declared: dm
                set t.data: TypeData.Interface(d)
            }
    }

    ; ── the small constructors ───────────────────────────────────────────────

    ; newIndexInfo. The reference's `components` argument is not taken — see the
    ; record's header for the two writers that would fill it.
    function new_index_info(this, key_type: ref[Type]?, value_type: ref[Type]?, is_readonly: bool, declaration: ref[AstNode]?) returns ref[IndexInfo]
    {
        let p &IndexInfo^host(key_type, value_type, is_readonly, declaration, null, null)
        p
    }

    function new_index_info_ex(this, key_type: ref[Type]?, value_type: ref[Type]?, is_readonly: bool, declaration: ref[AstNode]?, components: ref[Array[ref[AstNode]?]]?) returns ref[IndexInfo]
    {
        let p &IndexInfo^host(key_type, value_type, is_readonly, declaration, null, components)
        p
    }

    ; getObjectLiteralIndexInfo, whole (slice 129) — the index info a COMPUTED
    ; property name implies, whose value type is the subtype-reduced union of every
    ; property whose name matches the key.
    ;
    ; ★★★ THE `components` PARAMETER IS NOT CARRIED AND THAT IS §3.22's TEST, NOT AN
    ; OMISSION: its only readers in all of internal/checker are in
    ; `emitresolver.go`, which this project does not port, so IndexInfo has no such
    ; slot. The day a ported reader asks for it, the slot and this argument arrive
    ; together.
    ;
    ; ★ `undefinedType` for an EMPTY property list is the reference's own answer and
    ; not a fallback: `{ [k]: never }`-shaped output would be a different type.
    procedure get_object_literal_index_info(this, is_readonly: bool, properties: ref[Array[ref[Symbol]?]], key_type: ref[Type]) returns ref[IndexInfo]?
    {
        let mark this.unported_mark()
        let prop_types &Array[ref[Type]?]()
        let components &Array[ref[AstNode]?]^host()
        let n properties.get_length() as int
        var i 0
        while i < n
        {
            let row properties[i]
            set i: i + 1
            if row = null
                continue
            let prop row as ref[Symbol]
            var wanted false
            if key_type = string_type
            {
                if this.is_symbol_with_symbol_name(prop) = false
                    set wanted: true
            }
            if key_type = number_type
            {
                if this.is_symbol_with_numeric_name(prop)
                    set wanted: true
            }
            if key_type = es_symbol_type
            {
                if this.is_symbol_with_symbol_name(prop)
                    set wanted: true
            }
            if this.unported_mark() <> mark
                return null
            if wanted = false
                continue
            let t this.get_type_of_symbol(prop)
            if t = null
                return null
            prop_types.add(t)
            if Checker.is_symbol_with_computed_name(prop)
            {
                let d0 Symbol.declaration_at(prop, 0)
                if d0 <> null
                    components.add(d0)
            }
        }
        var union_type: ref[Type]? undefined_type
        if (prop_types.get_length() as int) <> 0
        {
            set union_type: this.get_union_type_ex(prop_types, UnionReductionSubtype, null, null)
            if union_type = null
                return null
        }
        this.new_index_info_ex(key_type, union_type, is_readonly, null, components)
    }

    ; isSymbolWithSymbolName / isSymbolWithNumericName / isSymbolWithComputedName —
    ; the three questions getObjectLiteralIndexInfo asks of a property's NAME.
    ; ★All three read the FIRST declaration only, which is the reference's own
    ; shape: a computed name cannot be merged with anything.
    procedure is_symbol_with_symbol_name(this, symbol: ref[Symbol]) returns bool
    {
        if Checker.is_late_bound_name(Symbol.name_of(symbol))
            return true
        let d Symbol.declaration_at(symbol, 0)
        if d = null
            return false
        let name AstNode.name_of(d as ref[AstNode])
        if name = null
            return false
        if AstNode.kind_of(name as ref[AstNode]) <> KindComputedPropertyName
            return false
        let t this.check_computed_property_name(name as ref[AstNode])
        if t = null
            return false
        this.is_type_assignable_to_kind(t as ref[Type], TypeFlagsESSymbol)
    }

    procedure is_symbol_with_numeric_name(this, symbol: ref[Symbol]) returns bool
    {
        if Checker.is_numeric_literal_name(Symbol.name_of(symbol))
            return true
        let d Symbol.declaration_at(symbol, 0)
        if d = null
            return false
        let name AstNode.name_of(d as ref[AstNode])
        if name = null
            return false
        this.is_numeric_name(name as ref[AstNode])
    }

    ; isNumericName + isNumericComputedName. ★The computed arm treats an `any`
    ; expression as numeric, which the reference's own comment calls odd and
    ; consistent with checkIndexedAccess — transcribed rather than tidied.
    procedure is_numeric_name(this, name: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(name)
        if k = KindComputedPropertyName
        {
            let t this.check_computed_property_name(name)
            if t = null
                return false
            return this.is_type_assignable_to_kind(t as ref[Type], TypeFlagsNumberLike)
        }
        ; The reference's three literal kinds and no more — NOT
        ; property_name_text_of, which also answers for a private identifier, a
        ; bigint and a no-substitution template.
        var textual false
        if k = KindIdentifier
            set textual: true
        if k = KindNumericLiteral
            set textual: true
        if k = KindStringLiteral
            set textual: true
        if textual = false
            return false
        let d AstNode.property_name_text_of(name)
        if d.data = null
            return false
        Checker.is_numeric_literal_name(d)
    }

    function is_symbol_with_computed_name(symbol: ref[Symbol]) returns bool
    {
        let d Symbol.declaration_at(symbol, 0)
        if d = null
            return false
        let name AstNode.name_of(d as ref[AstNode])
        if name = null
            return false
        AstNode.kind_of(name as ref[AstNode]) = KindComputedPropertyName
    }

    function new_index_info_list(this) returns ref[Array[ref[IndexInfo]?]]
    {
        let a &Array[ref[IndexInfo]?]^host()
        a
    }

    ; A signature accessor's null read as the EMPTY list, which is what
    ; `resolved.CallSignatures()` answers upstream. ★It must be called only AFTER
    ; the caller has separated a stop with `unported_mark`, because the accessors
    ; use null for both.
    function signature_list_or_empty(this, l: ref[Array[ref[Signature]?]]?) returns ref[Array[ref[Signature]?]]
    {
        if l = null
            return this.new_signature_list()
        l as ref[Array[ref[Signature]?]]
    }

    function new_signature_list(this) returns ref[Array[ref[Signature]?]]
    {
        let a &Array[ref[Signature]?]^host()
        a
    }

    ; c.newSymbol, slice 86 — the checker's own symbol constructor and the first
    ; one this port has. `SymbolFlagsTransient` is or'd in exactly as upstream, and
    ; the NAME is borrowed rather than copied: the bytes live on the parse's page
    ; and the checker does not outlive it, which is the same argument
    ; LiteralTypeData's `text` makes.
    ;
    ; ★ `c.SymbolCount++` is `symbols_allocated`: it feeds the `Symbols` row of
    ; --diagnostics (slice 348) and nothing the yardsticks compare; the BINDER's
    ; per-file counter, which the symbols yardstick does compare, is a different one.
    procedure new_symbol(this, flags: int, name_data: Slice[char]) returns ref[Symbol]
    {
        set symbols_allocated: symbols_allocated + 1
        let made Symbol.create(host, flags | SymbolFlagsTransient, name_data)
        made
    }

    function new_symbol_list(this) returns ref[Array[ref[Symbol]?]]
    {
        let a &Array[ref[Symbol]?]^host()
        a
    }

    ; The same for a NODE list — `AstNode.new_node_list` takes the parse's page and
    ; every list built here belongs to the checker's.
    function new_node_list(this) returns ref[Array[ref[AstNode]?]]
    {
        let a &Array[ref[AstNode]?]^host()
        a
    }

    ; checkKindsOfPropertyMemberOverrides' `notImplementedInfo`. ★It must come back
    ; as a `ref`, not the `pointer` the allocation is: a subscript on a
    ; `pointer[Array[X]]` is POINTER ARITHMETIC at Array stride, and it compiles.
    function new_unimplemented_list(this) returns ref[Array[UnimplementedMembers]]
    {
        let a &Array[UnimplementedMembers]^host()
        a
    }

    ; findIndexInfo. Identity on the KEY TYPE, which is what the reference's `==`
    ; on two *Type is — and this port's types are interned through one constructor,
    ; so the two questions coincide (check_type_for_duplicate_index_signatures'
    ; header makes the same argument for `Type.id`).
    function find_index_info(infos: ref[Array[ref[IndexInfo]?]]?, key_type: ref[Type]?) returns ref[IndexInfo]?
    {
        if infos = null
            return null
        let list infos as ref[Array[ref[IndexInfo]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let info row as ref[IndexInfo]
                if info.key_type = key_type
                    return row
            }
            set i: i + 1
        }
        null
    }

    ; isReservedMemberName. The reference reads `name[0] == '\xFE' && name[1] !=
    ; '@' && name[1] != '#'`, i.e. an internal name that is neither a symbol-id
    ; mangling nor a private one.
    ;
    ; ★ The byte is compared as a u8 rather than as a char: `char` is signed here,
    ; so 0xFE reads as -2 and a literal comparison would have to spell the negative
    ; number. The binder writes the same byte in internal_name.
    function is_reserved_member_name(d: Slice[char]) returns bool
    {
        if d.length < 2
            return false
        if ((d[0]) as u8) <> 254
            return false
        let second (d[1]) as u8
        if second = 64
            return false
        if second = 35
            return false
        true
    }

    ; symbolIsValue, and its alias half is a stop.
    ;
    ; ★★ THE ALIAS BRANCH IS getSymbolFlagsEx's WALK — resolveAlias, the type-only
    ; alias test and getExportSymbolOfValueSymbolIfExported, none of which exists
    ; here. It cannot be folded to `false`: an `import { x } from "m"` re-exported
    ; into a type literal's members would then vanish from the property list, which
    ; is a well-formed WRONG answer rather than a missing one (§3.5bk).
    ; symbolIsValueEx: an alias counts through its type-only meanings too when
    ; type-only members are included (a qualified name in a type query)
    procedure symbol_is_value_ex(this, symbol: ref[Symbol], include_type_only_members: bool) returns bool
    {
        let flags Symbol.flags_of(symbol)
        if (flags & SymbolFlagsValue) <> 0
            return true
        if (flags & SymbolFlagsAlias) = 0
            return false
        (this.get_symbol_flags_ex(symbol, include_type_only_members = false, false) & SymbolFlagsValue) <> 0
    }

    procedure symbol_is_value(this, symbol: ref[Symbol]) returns bool
    {
        let flags Symbol.flags_of(symbol)
        if (flags & SymbolFlagsValue) <> 0
            return true
        if (flags & SymbolFlagsAlias) = 0
            return false
        ; ANSWERED since slice 110: getSymbolFlagsEx's walk exists, and its
        ; unknownSymbol answer is SymbolFlagsAll — so an alias to a module this
        ; harness cannot resolve IS a value.
        (this.get_symbol_flags_ex(symbol, true, false) & SymbolFlagsValue) <> 0
    }

    ; isNamedMember.
    procedure is_named_member(this, symbol: ref[Symbol]?, d: Slice[char]) returns bool
    {
        if symbol = null
            return false
        if Checker.is_reserved_member_name(d)
            return false
        this.symbol_is_value(symbol as ref[Symbol])
    }

    ; isDeclarationContainedBy. `Loc.ContainedBy` is `t2.pos <= t.pos && t2.end >=
    ; t.end` (core/text.go), written out here because a Span is offsets and nothing
    ; else in this port (§ the memory note on plan spans).
    function is_declaration_contained_by(this, symbol: ref[Symbol], container: ref[Symbol]) returns bool
    {
        let declaration Symbol.value_declaration_of(symbol)
        if declaration = null
            return false
        let dn declaration as ref[AstNode]
        let dpos AstNode.pos_of(dn)
        let dend AstNode.end_of(dn)
        let n Symbol.declaration_count(container)
        var i 0
        while i < n
        {
            let cd Symbol.declaration_at(container, i)
            if cd <> null
            {
                let cn cd as ref[AstNode]
                if AstNode.pos_of(cn) <= dpos
                {
                    if AstNode.end_of(cn) >= dend
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; fileloader.go's getDefaultLibFilePriority: a lib file's rank is its lib
    ; name's position in tsoptions.LibMap (transcribed from enummaps.go, slice
    ; 251), `lib.d.ts`/`lib.es6.d.ts` first, an unknown file after every known one
    function lib_priority(basename: Slice[char]) returns int
    {
        let lib_d_ts: Slice[char] "lib.d.ts"
        let lib_es6: Slice[char] "lib.es6.d.ts"
        if SymbolTable.names_equal(basename, lib_d_ts) or SymbolTable.names_equal(basename, lib_es6)
            return 0
        if basename.length < 9
            return 109
        let name basename.subslice(4, (basename.length - 5) as size_t)
        if SymbolTable.names_equal(name, "es5")
            return 1
        if SymbolTable.names_equal(name, "es6")
            return 2
        if SymbolTable.names_equal(name, "es2015")
            return 3
        if SymbolTable.names_equal(name, "es7")
            return 4
        if SymbolTable.names_equal(name, "es2016")
            return 5
        if SymbolTable.names_equal(name, "es2017")
            return 6
        if SymbolTable.names_equal(name, "es2018")
            return 7
        if SymbolTable.names_equal(name, "es2019")
            return 8
        if SymbolTable.names_equal(name, "es2020")
            return 9
        if SymbolTable.names_equal(name, "es2021")
            return 10
        if SymbolTable.names_equal(name, "es2022")
            return 11
        if SymbolTable.names_equal(name, "es2023")
            return 12
        if SymbolTable.names_equal(name, "es2024")
            return 13
        if SymbolTable.names_equal(name, "es2025")
            return 14
        if SymbolTable.names_equal(name, "esnext")
            return 15
        if SymbolTable.names_equal(name, "dom")
            return 16
        if SymbolTable.names_equal(name, "dom.iterable")
            return 17
        if SymbolTable.names_equal(name, "dom.asynciterable")
            return 18
        if SymbolTable.names_equal(name, "webworker")
            return 19
        if SymbolTable.names_equal(name, "webworker.importscripts")
            return 20
        if SymbolTable.names_equal(name, "webworker.iterable")
            return 21
        if SymbolTable.names_equal(name, "webworker.asynciterable")
            return 22
        if SymbolTable.names_equal(name, "scripthost")
            return 23
        if SymbolTable.names_equal(name, "es2015.core")
            return 24
        if SymbolTable.names_equal(name, "es2015.collection")
            return 25
        if SymbolTable.names_equal(name, "es2015.generator")
            return 26
        if SymbolTable.names_equal(name, "es2015.iterable")
            return 27
        if SymbolTable.names_equal(name, "es2015.promise")
            return 28
        if SymbolTable.names_equal(name, "es2015.proxy")
            return 29
        if SymbolTable.names_equal(name, "es2015.reflect")
            return 30
        if SymbolTable.names_equal(name, "es2015.symbol")
            return 31
        if SymbolTable.names_equal(name, "es2015.symbol.wellknown")
            return 32
        if SymbolTable.names_equal(name, "es2016.array.include")
            return 33
        if SymbolTable.names_equal(name, "es2016.intl")
            return 34
        if SymbolTable.names_equal(name, "es2017.arraybuffer")
            return 35
        if SymbolTable.names_equal(name, "es2017.date")
            return 36
        if SymbolTable.names_equal(name, "es2017.object")
            return 37
        if SymbolTable.names_equal(name, "es2017.sharedmemory")
            return 38
        if SymbolTable.names_equal(name, "es2017.string")
