    ; ast.GetDeclarationOfKind.
    function get_declaration_of_kind(symbol: ref[Symbol], kind: int) returns ref[AstNode]?
    {
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if AstNode.kind_of(d as ref[AstNode]) = kind
                    return d
            }
            set i: i + 1
        }
        null
    }

    ; core.Find(symbol.Declarations, ast.IsAutoAccessorPropertyDeclaration).
    function find_auto_accessor_declaration(this, symbol: ref[Symbol]) returns ref[AstNode]?
    {
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if b.is_auto_accessor_property_declaration(d as ref[AstNode])
                    return d
            }
            set i: i + 1
        }
        null
    }

    ; getAnnotatedAccessorType and getAnnotatedAccessorTypeNode.
    procedure get_annotated_accessor_type(this, accessor: ref[AstNode]?) returns ref[Type]?
    {
        let node this.get_annotated_accessor_type_node(accessor)
        if node = null
            return null
        this.get_type_from_type_node(node as ref[AstNode])
    }

    function get_annotated_accessor_type_node(this, accessor: ref[AstNode]?) returns ref[AstNode]?
    {
        if accessor = null
            return null
        let a accessor as ref[AstNode]
        let k AstNode.kind_of(a)
        if k = KindGetAccessor
            return AstNode.type_of(a)
        if k = KindPropertyDeclaration
            return AstNode.type_of(a)
        if k = KindSetAccessor
        {
            ; getEffectiveSetAccessorTypeAnnotationNode — the VALUE PARAMETER's
            ; annotation, which is where `set x(v: T)` keeps the accessor's type.
            let param Checker.get_set_accessor_value_parameter(a)
            if param = null
                return null
            return AstNode.type_of(param as ref[AstNode])
        }
        null
    }

    procedure get_type_of_func_class_enum_module(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.resolved_type = null
        {
            let made this.get_type_of_func_class_enum_module_worker(symbol)
            if made = null
                return null
            set links.resolved_type: made
        }
        links.resolved_type
    }

    procedure get_type_of_func_class_enum_module_worker(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let f Symbol.flags_of(symbol)
        if (f & SymbolFlagsModule) <> 0
        {
            if Checker.is_shorthand_ambient_module_symbol(symbol)
                return any_type
        }
        ; The CommonJS branch, whole since slice 133 — resolveExternalModuleSymbol
        ; has been in this file since slice 129 and the row that stood here was
        ; the note that it was not.
        ;
        ; ★★★ THE TERM IS `CommonJSModuleIndicator != nil` AND THE STOP ASKED THE
        ; WRONG QUESTION: it asked `is_external_or_common_js_module`, the
        ; DISJUNCTION, so every ES module took the branch as well and reported.
        ; The indicator is asked of the BINDER, which is this file's binder, so it
        ; is exact only for the declaration that IS the unit — the same argument
        ; the JSON arm of get_type_of_variable_or_parameter_or_property_worker
        ; makes, and the same guard.
        ;
        ; ★ `resolvedModule != symbol` is an IDENTITY test: resolveExternalModuleSymbol
        ; answers its own argument when there is no `export =`, and the branch is
        ; about the case where there IS one.
        if (f & SymbolFlagsValueModule) <> 0
        {
            let vd Symbol.value_declaration_of(symbol)
            if vd <> null
            {
                let decl vd as ref[AstNode]
                var commonjs false
                if AstNode.kind_of(decl) = KindSourceFile
                {
                    if decl = file
                    {
                        if b.common_js_module_indicator_of() <> null
                            set commonjs: true
                    }
                }
                if commonjs
                {
                    let mark this.unported_mark()
                    let resolved this.resolve_external_module_symbol(symbol, false)
                    if this.unported_mark() <> mark
                        return null
                    if resolved = null
                        return null
                    let rm resolved as ref[Symbol]
                    if rm <> symbol
                        return this.get_type_of_symbol(rm)
                }
            }
        }
        let made this.new_object_type(ObjectFlagsAnonymous, symbol)
        if made = null
            return null
        let t made as ref[Type]
        if (f & SymbolFlagsClass) <> 0
        {
            let before this.unported_mark()
            let base_type_variable this.get_base_type_variable_of_class(symbol)
            if this.unported_mark() <> before
                return null
            ; A class whose base is a TYPE VARIABLE is a mixin, and its static
            ; type is the intersection of the anonymous type with that variable.
            ; ★★★ THE NOTE HERE NAMED A REACHABILITY THAT HAD ENDED — *unreachable
            ; while getBaseConstructorTypeOfClass reports for every class that HAS a
            ; base* — and by the time it was read the frontier put 29 units on it.
            ; getIntersectionType has been in this file since the intersection
            ; chapter, so the arm is the reference's one line.
            if base_type_variable <> null
            {
                let both &Array[ref[Type]?]()
                both.add(t)
                both.add(base_type_variable)
                return this.get_intersection_type(both)
            }
            return t
        }
        ; strictNullChecks is true under this harness, so the guard's SECOND term is
        ; the one that decides — and an optional function or module symbol is not
        ; something this slice can be handed. ★The `get-optional-type` stop that
        ; stood here is a call since slice 94, which is what makes that sentence a
        ; claim about the INPUT rather than about the port.
        if Checker.strict_null_checks()
        {
            if (f & SymbolFlagsOptional) <> 0
                return this.get_optional_type(t, true)
        }
        t
    }

    ; isShorthandAmbientModuleSymbol — a module declaration with no body, which is
    ; the only kind that can be missing one.
    function is_shorthand_ambient_module_symbol(symbol: ref[Symbol]) returns bool
    {
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
            return false
        let n vd as ref[AstNode]
        if AstNode.kind_of(n) <> KindModuleDeclaration
            return false
        AstNode.body_of(n) = null
    }

    ; ── slice 69: getTypeOfVariableOrParameterOrProperty ─────────────────────
    ;
    ; ★★★ THIS IS THE WORK LIST'S HEAD AND IT IS ONE FUNCTION WITH ONE FORK. Slice
    ; 67 named it and slice 68 walked past it; what stands here is the ANNOTATED
    ; half of a variable-like declaration's type, the widening that follows it, and
    ; the IMPLICIT-ANY family the un-annotated half reports instead. The
    ; INITIALIZER half is a stop, because it is checkExpression — a dimension
    ; rather than a step.
    ;
    ; ★★ THE MEMO IS PART OF THE SEMANTICS HERE, not a speed-up. Everything behind
    ; this function can REPORT — the implicit-any diagnostics below are its whole
    ; product — so a second computation of one symbol's type is a duplicated line,
    ; and diagcheck's relation is a SUBSEQUENCE. The reference guards the write
    ; with isParameterOfContextSensitiveSignature and the guard is transcribed.
    ;
    ; ★ `t == nil` is the reference's panic ("Unexpected nil type") and is this
    ; port's STOP: a worker that reported answers null, and the caller tells the
    ; two apart by is_unported(), which is this file's idiom everywhere.
    procedure get_type_of_variable_or_parameter_or_property(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let links this.value_symbol_link_of(symbol)
        ; ★★★ THE `arguments` SEED, AND ITS PLACEMENT IS THE PORT'S LAZINESS AND
        ; NOTHING ELSE. Upstream writes `valueSymbolLinks.Get(argumentsSymbol).
        ; resolvedType = getGlobalType("IArguments", 0)` at the end of
        ; initializeChecker, one line below the three seeds this port already does
        ; there — it was left out because it is the only one of the four that needs
        ; a LIB LOOKUP, and this port resolves a global on demand rather than
        ; resolving forty at start-up (get_global_generic_type's header). The read
        ; below is the ONE place any of that reaches: `arguments` carries
        ; SymbolFlagsProperty, so getTypeOfSymbol routes it here, and without the
        ; seed the worker meets a symbol with no value declaration — upstream's
        ; `debug.Assert(symbol.ValueDeclaration != nil)`, i.e. a shape the reference
        ; says cannot happen because THIS line made it impossible.
        if symbol = arguments_symbol
        {
            if links.resolved_type = null
                set links.resolved_type: this.get_global_i_arguments_type()
            return links.resolved_type
        }
        if links.resolved_type = null
        {
            let t this.get_type_of_variable_or_parameter_or_property_worker(symbol)
            if t = null
                return null
            ; "For a contextually typed parameter it is possible that a type has
            ; already been assigned … we need to _prefer_ that type, but it won't
            ; be assigned until contextual typing is complete" — the reference's own
            ; comment, and the RE-READ of links.resolvedType is what it is about.
            if links.resolved_type = null
            {
                let sensitive this.is_parameter_of_context_sensitive_signature(symbol)
                if this.unported_mark() <> mark
                    return null
                if sensitive = false
                    set links.resolved_type: t
            }
            return t
        }
        links.resolved_type
    }

    ; isParameterOfContextSensitiveSignature.
    ;
    ; ★★★ THE FIRST CONJUNCT IS THE WHOLE OF IT TODAY, AND THAT IS A PROVABLE
    ; UNREACHABILITY RATHER THAN A GAP. isContextSensitiveFunctionOrObjectLiteral
    ; Method opens `IsFunctionExpressionOrArrowFunction(fn) || IsObjectLiteralMethod
    ; (fn)`, and NO ARM OF THIS PORT WALKS A PARAMETER OF ANY OF THE THREE: a
    ; function expression and an arrow function are EXPRESSIONS, so the only route
    ; into their parameter list is checkExpression, which stops; an object-literal
    ; method is reached the same way. What this port does walk — a function or
    ; method DECLARATION, a signature, a function TYPE node — fails the test at its
    ; first term. So the report below stands in place and cannot fire, which is why
    ; it is a report and not a guess: the slice that ports checkExpression is the
    ; slice that makes it observable.
    function is_parameter_of_context_sensitive_signature(this, symbol: ref[Symbol]) returns bool
    {
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
            return false
        var decl vd as ref[AstNode]
        if AstNode.kind_of(decl) = KindBindingElement
        {
            let up Checker.walk_up_binding_elements_and_patterns(decl)
            if up = null
                return false
            set decl: up as ref[AstNode]
        }
        if AstNode.kind_of(decl) <> KindParameter
            return false
        let fn AstNode.parent_node_of(decl)
        if fn = null
            return false
        this.is_context_sensitive_function_or_object_literal_method(fn as ref[AstNode])
    }

    ; ast.WalkUpBindingElementsAndPatterns — from a binding element up through the
    ; patterns to the variable declaration or parameter that roots them. It is the
    ; same climb Binder.get_root_declaration makes and is written here because the
    ; reference's spelling at this call site is the walk rather than the root.
    function walk_up_binding_elements_and_patterns(binding: ref[AstNode]) returns ref[AstNode]?
    {
        var node AstNode.parent_node_of(binding)
        while node <> null
        {
            let n node as ref[AstNode]
            if AstNode.kind_of(n) = KindBindingElement
            {
                set node: AstNode.parent_node_of(n)
                continue
            }
            if AstNode.is_binding_pattern(n)
            {
                set node: AstNode.parent_node_of(n)
                continue
            }
            return n
        }
        null
    }

    function is_context_sensitive_function_or_object_literal_method(this, fn: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(fn)
        var admits false
        if k = KindFunctionExpression
            set admits: true
        if k = KindArrowFunction
            set admits: true
        if Checker.is_object_literal_method(fn)
            set admits: true
        if admits = false
            return false
        this.is_context_sensitive_function_like_declaration(fn)
    }

    ; ── slice 100: isContextSensitive and the three walks under it ──────────
    ;
    ; ★★★ THE HEADER THAT STOOD ABOVE THIS FUNCTION SAID *no input reaches this
    ; line today*, AND SLICE 100 IS THE SLICE THAT FALSIFIES IT. Both readers —
    ; getContextuallyTypedParameterType and getContextualThisParameterType —
    ; opened with `isContextSensitiveFunctionOrObjectLiteralMethod`, which
    ; admits only a function expression, an arrow function and an
    ; object-literal method: the three shapes this port stopped at in
    ; checkExpressionWorker. Porting the chapter is what gives the predicate an
    ; input, exactly as its own note predicted.
    ;
    ; isContextSensitiveFunctionLikeDeclaration, whole.
    function is_context_sensitive_function_like_declaration(this, node: ref[AstNode]) returns bool
    {
        if Checker.has_context_sensitive_parameters(node)
            return true
        if this.has_context_sensitive_return_expression(node)
            return true
        this.has_context_sensitive_yield_expression(node)
    }

    ; ast.HasContextSensitiveParameters, whole and purely syntactic.
    ;
    ; ★★ THE `this` TERM IS THE BINDER'S AND NOT A WALK. `node.Flags &
    ; NodeFlagsContainsThis` is a bit the binder sets while it binds the body, so
    ; a function with an implicit `this` parameter is recognised without visiting
    ; a single expression — which is why this half is cheap and the two below are
    ; not.
    function has_context_sensitive_parameters(node: ref[AstNode]) returns bool
    {
        ; "Functions with type parameters are not context sensitive."
        if AstNode.type_parameters_of(node) <> null
            return false
        let params AstNode.parameters_of(node)
        if params <> null
        {
            let ps params as ref[Array[ref[AstNode]?]]
            var i 0
            while i < ps.get_length()
            {
                let p ps[i]
                if p <> null
                {
                    ; "Functions with any parameters that lack type annotations
                    ; are context sensitive."
                    if AstNode.type_of(p as ref[AstNode]) = null
                        return true
                }
                set i: i + 1
            }
        }
        if AstNode.kind_of(node) <> KindArrowFunction
        {
            ; "If the first parameter is not an explicit 'this' parameter, then
            ; the function has an implicit 'this' parameter which is subject to
            ; contextual typing."
            var first: ref[AstNode]? null
            if params <> null
            {
                let ps params as ref[Array[ref[AstNode]?]]
                if ps.get_length() > 0
                    set first: ps[0]
            }
            var explicit_this false
            if first <> null
            {
                if AstNode.is_this_parameter(first)
                    set explicit_this: true
            }
            if explicit_this = false
                return (AstNode.flags_of(node) & NodeFlagsContainsThis) <> 0
        }
        false
    }

    ; hasContextSensitiveReturnExpression.
    ;
    ; ★ The two leading guards are what keep this walk off almost every function
    ; in the corpus: type parameters or a return ANNOTATION answer false before
    ; any node is visited.
    function has_context_sensitive_return_expression(this, node: ref[AstNode]) returns bool
    {
        if AstNode.type_parameters_of(node) <> null
            return false
        if AstNode.type_of(node) <> null
            return false
        let body_opt AstNode.body_of(node)
        if body_opt = null
            return false
        let body body_opt as ref[AstNode]
        if AstNode.kind_of(body) <> KindBlock
            return this.is_context_sensitive(body)
        this.for_each_return_statement_is_context_sensitive(body)
    }

    ; ast.ForEachReturnStatement with this file's ONE visitor folded in (§3.9d:
    ; the callback does not survive, and here the walk and its visitor are one
    ; function rather than an index pair, because the recursion is the walk).
    ;
    ; ★★ THE ARM LIST IS A CLOSED SET AND IT IS THE REFERENCE'S: everything that
    ; is not a return statement and not one of the fifteen statement kinds that
    ; can CONTAIN one answers false without descending — which is what stops the
    ; walk at a nested function's boundary without a test for one.
    function for_each_return_statement_is_context_sensitive(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindReturnStatement
        {
            let e AstNode.expression_of(node)
            if e = null
                return false
            return this.is_context_sensitive(e as ref[AstNode])
        }
        if Checker.kind_can_contain_return_statement(k) = false
            return false
        let n AstNode.child_count(node)
        var i 0
        while i < n
        {
            let child AstNode.child_at(node, i)
            if child <> null
            {
                if this.for_each_return_statement_is_context_sensitive(child as ref[AstNode])
                    return true
            }
            set i: i + 1
        }
        false
    }

    function kind_can_contain_return_statement(k: int) returns bool
    {
        if k = KindCaseBlock
            return true
        if k = KindBlock
            return true
        if k = KindIfStatement
            return true
        if k = KindDoStatement
            return true
        if k = KindWhileStatement
            return true
        if k = KindForStatement
            return true
        if k = KindForInStatement
            return true
        if k = KindForOfStatement
            return true
        if k = KindWithStatement
            return true
        if k = KindSwitchStatement
            return true
        if k = KindCaseClause
            return true
        if k = KindDefaultClause
            return true
        if k = KindLabeledStatement
            return true
        if k = KindTryStatement
            return true
        k = KindCatchClause
    }

    ; hasContextSensitiveYieldExpression, and forEachYieldExpression folded in the
    ; same way.
    function has_context_sensitive_yield_expression(this, node: ref[AstNode]) returns bool
    {
        if (b.get_function_flags(node) & FunctionFlagsGenerator) = 0
            return false
        let body AstNode.body_of(node)
        if body = null
            return false
        this.for_each_yield_expression_is_context_sensitive(body as ref[AstNode])
    }

    ; ★★ THE DEFAULT ARM IS THE INTERESTING ONE AND ITS TWO TESTS ARE NOT
    ; SYMMETRIC. A function-like node is NOT descended into — the reference's own
    ; comment says a class's methods would require descending into the class and
    ; that is by design — except through a COMPUTED NAME, which is evaluated in
    ; the enclosing scope and so can carry a yield. Everything that is not
    ; function-like descends unless it is part of a TYPE node, where no expression
    ; is evaluated at all.
    function for_each_yield_expression_is_context_sensitive(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindYieldExpression
        {
            if this.is_context_sensitive(node)
                return true
            let operand AstNode.expression_of(node)
            if operand = null
                return false
            return this.for_each_yield_expression_is_context_sensitive(operand as ref[AstNode])
        }
        ; "These are not allowed inside a generator now, but eventually they may
        ; be allowed as local types. Regardless, skip them to avoid the work."
        if k = KindEnumDeclaration
            return false
        if k = KindInterfaceDeclaration
            return false
        if k = KindModuleDeclaration
            return false
        if k = KindTypeAliasDeclaration
            return false
        if AstNode.is_function_like(node)
        {
            let name AstNode.name_of(node)
            if Checker.kind_or_unknown(name) = KindComputedPropertyName
            {
                let e AstNode.expression_of(name as ref[AstNode])
                if e = null
                    return false
                return this.for_each_yield_expression_is_context_sensitive(e as ref[AstNode])
            }
            return false
        }
        if AstNode.is_part_of_type_node(node)
            return false
        let n AstNode.child_count(node)
        var i 0
        while i < n
        {
            let child AstNode.child_at(node, i)
            if child <> null
            {
                if this.for_each_yield_expression_is_context_sensitive(child as ref[AstNode])
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; isContextSensitive, the twelve-arm dispatch.
    ;
    ; ★★★ ITS FunctionDeclaration ARM IS NOT DEAD CODE EVEN THOUGH NO ARM OF THIS
    ; PORT ASKS ABOUT ONE FROM OUTSIDE: the recursion reaches it through a
    ; property assignment or a parenthesis, and it is the reference's own arm. What
    ; IS unreachable is nothing here — every arm has an input in this corpus.
    ;
    ; ★★ THE BINARY ARM IS TWO OPERATORS AND NOT ALL OF THEM, which is the whole
    ; content of that line: only `||` and `??` propagate a contextual type to both
    ; sides, so `f() || (x => x)` is context sensitive and `a + (x => x)` is not.
    function is_context_sensitive(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        let k AstNode.kind_of(n)
        if k = KindFunctionExpression
            return this.is_context_sensitive_function_like_declaration(n)
        if k = KindArrowFunction
            return this.is_context_sensitive_function_like_declaration(n)
        if k = KindMethodDeclaration
            return this.is_context_sensitive_function_like_declaration(n)
        if k = KindFunctionDeclaration
            return this.is_context_sensitive_function_like_declaration(n)
        if k = KindObjectLiteralExpression
            return this.some_is_context_sensitive(AstNode.properties_of(n))
        if k = KindArrayLiteralExpression
            return this.some_is_context_sensitive(AstNode.elements_of(n))
        if k = KindConditionalExpression
        {
            if this.is_context_sensitive(AstNode.conditional_when_true_of(n))
                return true
            return this.is_context_sensitive(AstNode.conditional_when_false_of(n))
        }
        if k = KindBinaryExpression
        {
            let op Checker.kind_or_unknown(AstNode.binary_operator_token_of(n))
            var propagates false
            if op = KindBarBarToken
                set propagates: true
            if op = KindQuestionQuestionToken
                set propagates: true
            if propagates = false
                return false
            if this.is_context_sensitive(AstNode.binary_left_of(n))
                return true
            return this.is_context_sensitive(AstNode.binary_right_of(n))
        }
        if k = KindPropertyAssignment
            return this.is_context_sensitive(AstNode.initializer_of(n))
        if k = KindParenthesizedExpression
            return this.is_context_sensitive(AstNode.expression_of(n))
        if k = KindJsxAttributes
        {
            if this.some_is_context_sensitive(AstNode.properties_of(n))
                return true
            let parent AstNode.parent_node_of(n)
            if Checker.kind_or_unknown(parent) <> KindJsxOpeningElement
                return false
            let grand AstNode.parent_node_of(parent as ref[AstNode])
            if grand = null
                return false
            return this.some_is_context_sensitive(AstNode.jsx_element_children_of(grand as ref[AstNode]))
        }
        if k = KindJsxAttribute
        {
            ; "If there is no initializer, JSX attribute has a boolean value of
            ; true which is not context sensitive."
            return this.is_context_sensitive(AstNode.initializer_of(n))
        }
        if k = KindJsxExpression
        {
            ; "It is possible to that node.expression is undefined (e.g <div x={} />)"
            return this.is_context_sensitive(AstNode.expression_of(n))
        }
        if k = KindYieldExpression
            return this.is_context_sensitive(AstNode.expression_of(n))
        false
    }

    function some_is_context_sensitive(this, nodes: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if nodes = null
            return false
        let ns nodes as ref[Array[ref[AstNode]?]]
        var i 0
        while i < ns.get_length()
        {
            if this.is_context_sensitive(ns[i])
                return true
            set i: i + 1
        }
        false
    }

    ; ast.IsObjectLiteralMethod — a MethodDeclaration whose parent is an object
    ; literal, which is what separates it from a class member of the same kind.
    function is_object_literal_method(n: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(n) <> KindMethodDeclaration
            return false
        Checker.kind_or_unknown(AstNode.parent_node_of(n)) = KindObjectLiteralExpression
    }

    ; getTypeOfVariableOrParameterOrPropertyWorker.
    ;
    ; ★★ THE RESOLUTION PUSH IS THE REFERENCE'S CIRCULARITY GUARD AND IT IS LIVE
    ; HERE: `var x: typeof x` pushes, re-enters through its own annotation and the
    ; second push finds the cycle. Both exits — the failed push and the failed pop
    ; — go through reportCircularityError, which is a DIAGNOSTIC and therefore this
    ; slice's product rather than a stop.
    ;
    ; ★★ EVERY REPORTING EXIT AFTER THE PUSH POPS FIRST, and that line is OURS
    ; rather than the reference's — slice 67's g19 priced the same shape: a report
    ; is an exit the reference does not have, so its unwinding is ours to write,
    ; and a leaked frame can only bite a LATER push in the same file.
    ;
    ; ★ Two arms of the reference's prefix have no input here and say so at their
    ; line rather than being left out: `symbol == c.requireSymbol` (this port has no
    ; require symbol — it comes from a lib this compilation does not load) and the
    ; JSON source file (a SourceFile is a value declaration only for a JSON module,
    ; which needs a program).
    ; getTypeOfPrototypeProperty — the declared type of the symbol's PARENT, with
    ; `any` supplied for each of the class's type parameters (TypeScript 1.0 spec
    ; 8.4). ★★★THE NOTE THAT STOOD AT ITS CALL SITE SAID *the parent walk is
    ; getParentOfSymbol, which this port does not have* — and get_parent_of_symbol
    ; has been in this file for dozens of slices (§3.5eo).
    ;
    ; ★ The reference indexes `AsInterfaceType()` without a guard, because a
    ; prototype's parent is a CLASS and a class's declared type is an interface
    ; type. Here a null answer is reported the way every other absent
    ; precondition is, so the shape that would panic upstream says so instead.
    procedure get_type_of_prototype_property(this, prototype: ref[Symbol]) returns ref[Type]?
    {
        let parent this.get_parent_of_symbol(prototype)
        if parent = null
            return null
        let class_type this.get_declared_type_of_symbol(parent as ref[Symbol])
        if class_type = null
            return null
        let ct class_type as ref[Type]
        let type_parameters this.interface_type_parameters_of(ct)
        if type_parameters = null
            return class_type
        let tps type_parameters as ref[Array[ref[Type]?]]
        let n tps.get_length() as int
        if n = 0
            return class_type
        let args &Array[ref[Type]?]^host()
        var i 0
        while i < n
        {
            args.add(any_type)
            set i: i + 1
        }
        this.create_type_reference(ct, args as ref[Array[ref[Type]?]]?, ObjectFlagsNone)
    }

    procedure get_type_of_variable_or_parameter_or_property_worker(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        ; ★★★ THE MARK, NOT THE FLAG — see unported_count's own note. The flag says
        ; whether the UNIT has stopped and this chapter has to know whether THIS
        ; call did, because its nil is ambiguous. Both wrong readings were built and
        ; measured: an absolute is_unported() test made every declaration after a
        ; file's first report a silent no-op, and a before/after test on the FLAG
        ; invented a TS7005 for each of them (377 units red).
        let mark this.unported_mark()
        let f Symbol.flags_of(symbol)
        if (f & SymbolFlagsPrototype) <> 0
            return this.get_type_of_prototype_property(symbol)
        ; "CommonsJS require and module both have type any."
        if symbol = require_symbol
            return any_type
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
        {
            ; debug.Assert(symbol.ValueDeclaration != nil). An assertion is a claim
            ; that the input is impossible, so it is reported rather than trapped
            ; (§3.5v) — the treatment typeResolutionHasProperty's tail gets.
            this.record_unported("value-declaration-of-variable-symbol", f)
            return null
        }
        let declaration vd as ref[AstNode]
        let dk AstNode.kind_of(declaration)
        ; `IsSourceFile(declaration) && IsJsonSourceFile(...)` — a `.json` unit's
        ; module symbol takes the type of its ONE expression statement, widened
        ; twice: getWidenedLiteralType turns the literals into their base types and
        ; getWidenedType then widens the object literal's inferred members.
        ;
        ; ★★ IsJsonSourceFile is `file.ScriptKind == ScriptKindJSON`, and a Checker
        ; holds ONE parser — the unit's. Two source files can reach this arm, the
        ; unit and lib.es5.d.ts, so the kind is asked only of the declaration that
        ; IS the unit; that is exact rather than a caveat, and it stays exact if a
        ; later slice gives the Checker more files.
        if dk = KindSourceFile
        {
            ; slice 248: any unit of the program — the parser stamps NodeFlagsJsonFile
            ; on a JSON parse, so the flag stands in for the script kind
            var json false
            if (AstNode.flags_of(declaration) & NodeFlagsJsonFile) <> 0
            {
                if true
                    set json: true
            }
            if json
            {
                let statements AstNode.statements_of(declaration)
                var count 0
                if statements <> null
                    set count: (statements as ref[Array[ref[AstNode]?]]).get_length() as int
                if count = 0
                {
                    if empty_object_type = null
                    {
                        this.record_unported("empty-object-type-unminted", 0)
                        return null
                    }
                    return empty_object_type
                }
                let first (statements as ref[Array[ref[AstNode]?]])[0]
                let expr AstNode.expression_of(first)
                if expr = null
                    return null
                let et this.check_expression(expr as ref[AstNode])
                if et = null
                    return null
                let widened_literal this.get_widened_literal_type(et as ref[Type])
                if widened_literal = null
                    return null
                return this.get_widened_type(widened_literal as ref[Type])
            }
        }
        if this.push_type_resolution(symbol, null, null, null, TypeSystemPropertyNameType) = false
            return this.report_circularity_error(symbol)
        ; The `module.exports` symbol, whole. Its own `exports` member resolves
        ; through resolveExternalModuleSymbol and everything else becomes an
        ; anonymous type over the symbol's MEMBERS.
        ;
        ; ★★★ THE PUSHED RESOLUTION IS NOT POPPED AND THAT IS THE REFERENCE'S OWN
        ; SHAPE: both returns below sit under `pushTypeResolution` and neither
        ; reaches the `popTypeResolution` at the tail. The stop that stood here
        ; popped defensively because a stop is not a return the reference makes;
        ; an ARM is, so the pop goes with it.
        if (f & SymbolFlagsModuleExports) <> 0
        {
            if Checker.name_is(Symbol.name_of(symbol), "exports")
            {
                let owner AstNode.symbol_of(vd)
                let resolved this.resolve_external_module_symbol(owner, false)
                ; ★★★ THE STOP POPS AND THE ARM DOES NOT, AND THAT ASYMMETRY IS THE
                ; WHOLE OF IT. The reference's two returns below leave the frame on
                ; the stack because they ANSWER — getTypeOfSymbol memoises the type
                ; and the worker is never re-entered for this symbol. A stop
                ; memoises nothing, so a frame left here is found by the NEXT ask
                ; for the same symbol as a cycle that is not there: over
                ; `module.exports = f` in a JavaScript file this port reported
                ; TS7022 on the SOURCE FILE, a diagnostic the reference does not
                ; have anywhere. See the same rule at get_base_constraint_of_type
                ; and get_declared_type_of_type_alias, where it is written out.
                if this.unported_mark() <> mark
                {
                    this.pop_type_resolution_defensively()
                    return null
                }
                if resolved = null
                {
                    this.pop_type_resolution_defensively()
                    return null
                }
                ; ★★★ AND THE ARM'S OWN RETURN NEEDS THE SAME TREATMENT WHEN IT
                ; ANSWERS NULL, for the reason the reference may leave the frame at
                ; all: upstream this return hands back a TYPE, get_type_of_symbol
                ; memoises it in links.type, and the worker is never entered for
                ; this symbol again — so nobody ever meets the frame. A null is not
                ; a type, nothing is memoised, and the NEXT ask walks straight into
                ; it. `module.exports = {a:1}` in one branch and `{b:"hello"}` in
                ; the other stops one level down in getWidenedTypeOfObjectLiteral,
                ; and the phantom cycle was reported as TS7022 on the source file.
                let et this.get_type_of_symbol(resolved as ref[Symbol])
                if et = null
                {
                    this.pop_type_resolution_defensively()
                    return null
                }
                return et
            }
            return this.new_anonymous_type(symbol, Symbol.members_of(symbol), null, null, null)
        }
        var result: ref[Type]? null
        var variable_like false
        if dk = KindParameter
            set variable_like: true
        if dk = KindPropertyDeclaration
            set variable_like: true
        if dk = KindPropertySignature
            set variable_like: true
        if dk = KindVariableDeclaration
            set variable_like: true
        if dk = KindBindingElement
            set variable_like: true
        if variable_like
            set result: this.get_widened_type_for_variable_like_declaration(declaration, true)
        else
            set result: this.type_of_variable_symbol_arm(symbol, declaration, dk)
        if this.unported_mark() <> mark
        {
            this.pop_type_resolution_defensively()
            return null
        }
        if this.pop_type_resolution() = false
            return this.report_circularity_error(symbol)
        result
    }

    ; The arms of getTypeOfVariableOrParameterOrPropertyWorker's
    ; `switch declaration.Kind` that are NOT variable-like, as one function
    ; because the caller owns the type-resolution frame: a stop here reports and
    ; answers null, and the caller's mark check does the pop the reference has no
    ; exit for.
    ;
    ; ★★★ FOUR OF THESE ARMS WERE ALREADY PORTED WHEN THIS SLICE ARRIVED, and the
    ; stop that stood in their place was the largest single row on the frontier —
    ; 65 units, three times the next one — for that reason alone.
    ; checkPropertyAssignment, checkShorthandPropertyAssignment and
    ; checkObjectLiteralMethod landed with the object-literal chapter and
    ; getTypeOfEnumMember with the enum, each of them reached from
    ; checkObjectLiteral or from the enum's own walk, and nothing re-read the
    ; comment here that called them *"a declaration kind this port does not
    ; reach"*. ★★★A STOP IS A CLAIM ABOUT THE PORT AND IT EXPIRES WHEN ITS CALLEE
    ; LANDS — and no instrument in this package can see that it has: the stop
    ; histogram counts arrivals, the frontier ranks by units, and both read the
    ; row as a chapter still to be written.
    procedure type_of_variable_symbol_arm(this, symbol: ref[Symbol], declaration: ref[AstNode], dk: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if dk = KindPropertyAssignment
            return this.check_property_assignment(declaration, CheckModeNormal)
        if dk = KindShorthandPropertyAssignment
            return this.check_shorthand_property_assignment(declaration, true, CheckModeNormal)
        ; ast.KindMethodDeclaration here is an OBJECT-LITERAL method — a class
        ; member of the same kind never becomes this symbol's value declaration —
        ; so the reference's arm and check_object_literal_member's third test are
        ; the same routine reached from two sides.
        if dk = KindMethodDeclaration
            return this.check_object_literal_method(declaration, dk, CheckModeNormal)
        ; ★★★ THE ExportAssignment ARM ARRIVES IN SLICE 114 BECAUSE THE ALIAS
        ; CHAPTER IS WHAT REACHES IT: `export = expr` in one unit and
        ; `import a = require(...)` in another are the two halves of one shape, and
        ; until getTypeOfAlias existed nothing asked this symbol for a type.
        ; ★Note which widener it is — `widenTypeForVariableLikeDeclaration`, the
        ; INNER one, not the `getWidened…` the variable-like arm takes: the outer
        ; one computes the type from the declaration, and here the type is the
        ; checked EXPRESSION.
        if dk = KindExportAssignment
        {
            let type_node AstNode.type_of(declaration)
            if type_node <> null
                return this.get_type_from_type_node(type_node as ref[AstNode])
            let e AstNode.expression_of(declaration)
            if e = null
            {
                this.record_unported("export-assignment-no-expression", dk)
                return null
            }
            let et this.check_expression_cached(e as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            return this.widen_type_for_variable_like_declaration(et, declaration, false)
        }
        ; ★★★ THE JsxAttribute ARM IS SLICE 119's AND IT IS WHAT MAKES AN
        ; ATTRIBUTE'S TYPE VISIBLE AT ALL. `getTypeOfNode` sends a JsxAttribute
        ; down the DECLARATION route — it is no expression node — so the dump's `T`
        ; line for `id="one"` comes from here and not from the attributes type the
        ; JSX chapter also builds.
        if dk = KindJsxAttribute
            return this.check_jsx_attribute(declaration, CheckModeNormal)
        if dk = KindEnumMember
            return this.get_type_of_enum_member(symbol)
        ; The two ASSIGNMENT-DECLARATION kinds, `this.x = 1` and
        ; `exports.x = 1` — getWidenedTypeForAssignmentDeclaration, which is a
        ; chapter of its own and not an arm: it asks
        ; isConstructorDeclaredThisProperty first and reaches
        ; getFlowTypeInConstructor through it.
        if dk = KindBinaryExpression
            return this.get_widened_type_for_assignment_declaration(symbol)
        if dk = KindCallExpression
            return this.get_widened_type_for_assignment_declaration(symbol)
        ; The reference's default arm is a panic.
        this.record_unported("get-type-of-variable-worker-arm", dk)
        null
    }

    ; ── the JS ASSIGNMENT DECLARATION (slice 120) ────────────────────────────
    ;
    ; getWidenedTypeForAssignmentDeclaration and the five routines under it: the
    ; type of `this.x = 1` written inside a constructor, of `module.exports = …`
    ; and `exports.x = …`, and of
    ; `Object.defineProperty(f, "x", { value: 1 })`. It is the arm
    ; getTypeOfVariableOrParameterOrPropertyWorker routes BOTH BinaryExpression
    ; and CallExpression to, and it is a chapter rather than an arm because
    ; isConstructorDeclaredThisProperty is its first line and the constructor's
    ; CONTROL FLOW sits behind that.

    ; isConstructorDeclaredThisProperty. Go's `(kind, location)` becomes the kind
    ; as the result and the location in an out cell (§3.6): both call sites read
    ; the two together, and the location means nothing without the kind.
    ;
    ; ★★ THE `thisExpandoKinds` / `thisExpandoLocations` MEMO IS DELIBERATELY NOT
    ; PORTED, and that is a claim rather than an omission: every term of the
    ; computation is pure over the AST — get_assignment_declaration_kind reads the
    ; node, get_declaring_constructor walks each declaration's this-container — so
    ; a recomputation answers the same pair. The reference's own panic over the
    ; pair (*"location should be cached whenever this expando symbol is cached"*)
    ; is a CACHE invariant and not a semantic one, which is why it has no
    ; counterpart here. §3.11 owns the general question.
    procedure is_constructor_declared_this_property(this, symbol: ref[Symbol], out_location: ref[ref[AstNode]?]) returns int
    {
        set out_location: null
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
            return ThisAssignmentDeclarationNone
        if AstNode.kind_of(vd as ref[AstNode]) <> KindBinaryExpression
            return ThisAssignmentDeclarationNone
        var all_this true
        var type_annotation: ref[AstNode]? null
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            set i: i + 1
            if d = null
            {
                set all_this: false
                break
            }
            let decl d as ref[AstNode]
            if AstNode.kind_of(decl) <> KindBinaryExpression
            {
                set all_this: false
                break
            }
            var this_property false
            if Parser.get_assignment_declaration_kind(decl) = JSDeclarationKindThisProperty
            {
                set this_property: true
                ; `bin.Left.Kind != KindElementAccessExpression ||
                ; IsStringOrNumericLiteralLike(…ArgumentExpression)` — `this["x"]`
                ; and `this[0]` declare a nameable property, `this[expr]` does not.
                let left AstNode.binary_left_of(decl)
                if left <> null
                {
                    if AstNode.kind_of(left as ref[AstNode]) = KindElementAccessExpression
                    {
                        let arg AstNode.element_access_argument_of(left as ref[AstNode])
                        if arg = null
                            set this_property: false
                        else
                        {
                            if Parser.is_string_or_numeric_literal_like(arg as ref[AstNode]) = false
                                set this_property: false
                        }
                    }
                }
            }
            if this_property = false
            {
                set all_this: false
                break
            }
            ; The annotation is the LAST one found and not the first — the
            ; reference assigns rather than breaks.
            let tn AstNode.type_of(decl)
            if tn <> null
                set type_annotation: tn
        }
        if all_this = false
            return ThisAssignmentDeclarationNone
        if type_annotation <> null
        {
            set out_location: type_annotation
            return ThisAssignmentDeclarationTyped
        }
        let ctor this.get_declaring_constructor(symbol)
        set out_location: ctor
        if ctor = null
            return ThisAssignmentDeclarationMethod
        ThisAssignmentDeclarationConstructor
    }

    ; getWidenedTypeForAssignmentDeclaration.
    ;
    ; ★★ THE THREE KIND ARMS AND THE DECLARATION LOOP ARE NOT ALTERNATIVES: the
    ; loop runs whenever the arms produced NO type, which includes the
    ; `Constructor` arm whose flow type came back nil because every assignment was
    ; null or undefined. Reading the arms as a `switch` with a default is the wrong
    ; shape — the reference's `if t == nil` sits AFTER the switch.
    procedure get_widened_type_for_assignment_declaration(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let mark this.unported_mark()
        var location: ref[AstNode]? null
        let kind this.is_constructor_declared_this_property(symbol, &location)
        if this.unported_mark() <> mark
            return null
        var t: ref[Type]? null
        if kind = ThisAssignmentDeclarationTyped
        {
            ; `panic("location should not be nil when this assignment has a
            ; type.")` — an assertion is a claim that the input is impossible, so
            ; it is reported rather than trapped (§3.5v).
            if location = null
            {
                this.record_unported("this-assignment-typed-without-location", kind)
                return null
            }
            set t: this.get_type_from_type_node(location as ref[AstNode])
        }
        if kind = ThisAssignmentDeclarationConstructor
        {
            if location = null
            {
                this.record_unported("this-assignment-constructor-without-location", kind)
                return null
            }
            set t: this.get_flow_type_in_constructor(symbol, location as ref[AstNode])
        }
        if kind = ThisAssignmentDeclarationMethod
            set t: this.get_type_of_property_in_base_class(symbol)
        if this.unported_mark() <> mark
            return null
        if t = null
        {
            let types &Array[ref[Type]?]()
            let n Symbol.declaration_count(symbol)
            var i 0
            while i < n
            {
                let idx i
                set i: i + 1
                let d Symbol.declaration_at(symbol, idx)
                if d = null
                    continue
                let decl d as ref[AstNode]
                var annotated false
                if AstNode.kind_of(decl) = KindBinaryExpression
                {
                    let tn AstNode.type_of(decl)
                    if tn <> null
                    {
                        set t: this.get_type_from_type_node(tn as ref[AstNode])
                        set annotated: true
                    }
                }
                if annotated
                    break
                let assigned this.get_assignment_declaration_initializer_type(decl)
                if this.unported_mark() <> mark
                    return null
                if assigned = null
                    continue
                ; "We ignore initial assignments of undefined to CommonJS exports
                ; when there are multiple assignment declarations."
                var keep true
                if Parser.get_assignment_declaration_kind(decl) = JSDeclarationKindExportsProperty
                {
                    if idx = 0
                    {
                        if n <> 1
                        {
                            if ((assigned as ref[Type]).flags & TypeFlagsUndefined) <> 0
                                set keep: false
                        }
                    }
                }
                if keep
                    Checker.append_type_if_unique(types, assigned as ref[Type])
            }
            if kind = ThisAssignmentDeclarationMethod
            {
                ; strict_null_checks is TRUE under this harness — see its own
                ; header for the derivation — so the guard is written and taken.
                if (types.get_length() as int) > 0
                {
                    if Checker.strict_null_checks()
                        Checker.append_type_if_unique(types, undefined_or_missing_type)
                }
            }
            if t = null
            {
                set t: any_type
                if (types.get_length() as int) <> 0
                    set t: this.get_union_type(types)
            }
        }
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        let widened this.get_widened_type(t as ref[Type])
        if this.unported_mark() <> mark
            return null
        if widened = null
            return null
        ; "report an all-nullable or empty union as an implicit any in JS files"
        let vd Symbol.value_declaration_of(symbol)
        if vd <> null
        {
            if Parser.is_in_js_file(vd)
            {
                let filtered this.filter_type_outside_flags(widened as ref[Type], TypeFlagsNullable)
                if filtered <> null
                {
                    if (filtered as ref[Type]) = never_type
                    {
                        this.report_implicit_any(vd as ref[AstNode], any_type, WideningKindNormal)
                        return any_type
                    }
                }
            }
        }
        widened
    }

    ; core.AppendIfUnique over a type list. The reference compares POINTERS and so
    ; does this: a type is interned, so identity is the equality that matters.
    procedure append_type_if_unique(list: ref[Array[ref[Type]?]], t: ref[Type])
    {
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if (row as ref[Type]) = t
                return
        }
        list.add(t)
    }

    ; filterType with the reference's PREDICATE fixed to *carries a flag OUTSIDE
    ; this mask* — §3.5e's rule for a func value whose callees are static, and the
    ; second fixed predicate beside filter_type_by_facts.
    ;
    ; ★★★ THE `origin` BRANCH, AND THE CONDITION UNDER WHICH THE `null` BELOW IS
    ; THE REFERENCE'S ANSWER — READ THIS BEFORE "FIXING" ANY OF THE SEVENTEEN
    ; filter_type_* FUNCTIONS. Until slice 135 the reason given here was that the
    ; union type has no origin slot; it has one, with two writers (the
    ; intersection cross-product since slice 121, the denormalized union of named
    ; unions since 135). The reference's branch filters the ORIGIN's constituents
    ; under `u.flags&Union != 0 || f(u)` — every union constituent is KEPT
    ; unconditionally — and then builds a new origin only when
    ; `len(originTypes)-len(originFiltered) == len(types)-len(filtered)`.
    ; ★So where every origin constituent is itself a union — which is exactly the
    ; `E | F` shape the enum alias produces — nothing is removed from the origin,
    ; the left side of that test is 0, the right side is not (we only reach here
    ; because something WAS removed), and the reference's own answer is a nil
    ; origin. The `null` here agrees with it for that whole family.
    ; ★★What is NOT covered is an origin with NON-UNION constituents — the
    ; intersection cross-product's `X & (A | B) | C` shape — where the predicate
    ; would have to be re-asked per origin constituent. Doing that needs the
    ; predicate as a VALUE, i.e. the filter-kind dispatcher these seventeen fixed
    ; predicates exist instead of; it is not written, and the divergence it can
    ; produce is a printed FORM and never a membership.
    ; filterType's `newOrigin` half, lifted out because the predicate split the
    ; reference's ONE function into eighteen here, and it was written into none of
    ; them (slice 187).
    ;
    ; ★★★ WHAT IT IS FOR: the ORIGIN is the DENORMALISED union, and it is how a
    ; narrowed type keeps its ALIAS. `WrappedStringOr<number> | null` normalises to
    ; three constituents and remembers the two-member union it was written as; drop
    ; the `null` and the origin's own filter leaves exactly `WrappedStringOr<number>`
    ; — ONE type, which the reference then RETURNS in place of the rebuilt union.
    ; Without it `wrapped` printed `{ value?: string | undefined; } | { value?:
    ; number | undefined; }` where the reference prints the alias, and
    ; `type_to_string` cannot recover it: it substitutes a union's origin and the
    ; rebuilt union had none.
    ;
    ; ★★★ THE PREDICATE IS NOT RE-APPLIED, AND THAT IS THE ONE DELIBERATE
    ; DIFFERENCE. The reference calls `f(u)` again on the origin's non-union
    ; constituents; a non-union constituent of the origin is carried into the
    ; normalised list unchanged, so `u` survives exactly when it is in the FILTERED
    ; list — which is a membership test and needs no closure. The count test below
    ; is the reference's own and rejects every case where that correspondence does
    ; not hold (a constituent the normalisation merged away, a filtered type inside
    ; a nested union).
    ;
    ; ★ `out_single` is the reference's `return originFiltered[0]`: a caller that
    ; finds it non-null must RETURN it and must not build a union at all.
    ;
    ; ★ The five iteration-type filters (`filter_type_is_iterator_result`, the three
    ; generator ones and `filter_type_by_contextual_async_return`) do NOT call this:
    ; they answer through `get_union_type`, not the sorted list, and carry no origin
    ; to forward. Named here rather than left to be noticed.
    procedure filtered_union_origin(this, t: ref[Type], filtered: ref[Array[ref[Type]?]], out_single: ref[ref[Type]?]) returns ref[Type]?
    {
        set out_single: null
        let origin Checker.union_origin_of(t)
        if origin = null
            return null
        let o origin as ref[Type]
        if (o.flags & TypeFlagsUnion) = 0
            return null
        let otypes Checker.union_types_of(o)
        if otypes = null
            return null
        let olist otypes as ref[Array[ref[Type]?]]
        let types Checker.union_types_of(t)
        if types = null
            return null
        let n (types as ref[Array[ref[Type]?]]).get_length() as int
        let on olist.get_length() as int
        let kept this.new_type_list(null)
        var i 0
        while i < on
        {
            let row olist[i]
            set i: i + 1
            if row = null
                continue
            let u row as ref[Type]
            if (u.flags & TypeFlagsUnion) <> 0
            {
                kept.add(row)
                continue
            }
            if Checker.type_list_contains(filtered, row)
                kept.add(row)
        }
        let kn kept.get_length() as int
        ; `len(originTypes)-len(originFiltered) == len(types)-len(filtered)` — if the
        ; origin lost FEWER than the normalised list did, some filtered type sat
        ; inside a nested union and no origin can be constructed.
        if (on - kn) <> (n - (filtered.get_length() as int))
            return null
        if kn = 1
        {
            set out_single: kept[0]
            return null
        }
        this.new_union_type(ObjectFlagsNone, kept, null)
    }

    procedure filter_type_outside_flags(this, t: ref[Type], mask: int) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if ((row as ref[Type]).flags & ~mask) <> 0
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = n
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if (t.flags & ~mask) <> 0
            return t
        never_type
    }

    ; getAssignmentDeclarationInitializerType.
    procedure get_assignment_declaration_initializer_type(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let k AstNode.kind_of(node)
        if k = KindCallExpression
        {
            ; `getTypeFromPropertyDescriptor(node.Arguments()[2])` — the
            ; `Object.defineProperty(target, "name", descriptor)` form, whose THIRD
            ; argument is the descriptor. The reference INDEXES, so a shorter list
            ; is a panic there; here it is a report.
            let args AstNode.call_arguments_of(node)
            if AstNode.list_count(args) < 3
            {
                this.record_unported("property-descriptor-argument-missing", k)
                return null
            }
            let arg (args as ref[Array[ref[AstNode]?]])[2]
            if arg = null
            {
                this.record_unported("property-descriptor-argument-missing", k)
                return null
            }
            return this.get_type_from_property_descriptor(arg as ref[AstNode])
        }
        if k <> KindBinaryExpression
            return null
        var t: ref[Type]? null
        let adk Parser.get_assignment_declaration_kind(node)
        var through_the_right true
        if adk = JSDeclarationKindModuleExports
            set through_the_right: false
        if adk = JSDeclarationKindExportsProperty
            set through_the_right: false
        if through_the_right = false
        {
            ; The RIGHTMOST assigned expression, because `module.exports = a = b`
            ; declares the module's type as b's.
            let rm Parser.get_right_most_assigned_expression(node)
            if rm = null
                return null
            let ct this.check_expression_cached(rm as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if ct = null
                return null
            set t: this.get_regular_type_of_literal_type(ct as ref[Type])
        }
        else
        {
            ; ★ THE `fallthrough` IS THE SHAPE HERE, not a second arm: the
            ; ThisProperty case tests for a same-named `this` property on the right
            ; and then falls INTO the default, so both reach the same call.
            let right AstNode.binary_right_of(node)
            if right = null
                return null
            if adk = JSDeclarationKindThisProperty
            {
                let left AstNode.binary_left_of(node)
                if left = null
                    return null
                if this.contains_same_named_this_property(left as ref[AstNode], right as ref[AstNode])
                    return null
                if this.unported_mark() <> mark
                    return null
            }
            set t: this.check_expression_for_mutable_location(right as ref[AstNode], CheckModeNormal)
            if this.unported_mark() <> mark
                return null
        }
        if t = null
            return null
        let ty t as ref[Type]
        if this.is_empty_array_literal_type(ty)
        {
            let sym AstNode.symbol_of(node)
            var annotated false
            if sym <> null
                set annotated: this.has_parent_with_type_annotation(sym as ref[Symbol])
            if annotated = false
            {
                let aat this.get_any_array_type()
                if aat = null
                    return null
                this.report_implicit_any(node, aat as ref[Type], WideningKindNormal)
                return aat
            }
        }
        t
    }

    ; isEmptyArrayLiteralType.
    procedure is_empty_array_literal_type(this, t: ref[Type]) returns bool
    {
        let element this.get_element_type_of_array_type(t)
        if element = null
            return false
        this.is_empty_literal_type(element as ref[Type])
    }

    ; hasParentWithTypeAnnotation — *"returns true for the symbol associated with
    ; `f.a` below: `const f: { (): void, a: string[] } = () => {}; f.a = [];`"*.
    procedure has_parent_with_type_annotation(this, symbol: ref[Symbol]) returns bool
    {
        let parent Symbol.parent_of(symbol)
        if parent = null
            return false
        let pvd Symbol.value_declaration_of(parent as ref[Symbol])
        if pvd = null
            return false
        if Checker.is_function_expression_or_arrow_function(pvd as ref[AstNode]) = false
            return false
        let owner AstNode.parent_node_of(pvd as ref[AstNode])
        if owner = null
            return false
        let annotated this.get_symbol_of_node(owner as ref[AstNode])
        if annotated = null
            return false
        let avd Symbol.value_declaration_of(annotated as ref[Symbol])
        if avd = null
            return false
        AstNode.type_of(avd as ref[AstNode]) <> null
    }

    ; containsSameNamedThisProperty. The reference's closure over `thisProperty`
    ; becomes a parameter of the recursion, and ForEachChild becomes the index pair
    ; (§3.9d).
    procedure contains_same_named_this_property(this, this_property: ref[AstNode], expression: ref[AstNode]) returns bool
    {
        if this.is_matching_reference(this_property, expression)
            return true
        ; The walk does NOT enter a function-like node: `this` means something else
        ; in there, so a property of the same name is a different property.
        if AstNode.is_function_like(expression)
            return false
        let n AstNode.child_count(expression)
        var i 0
        while i < n
        {
            let child AstNode.child_at(expression, i)
            set i: i + 1
            if child = null
                continue
            if this.contains_same_named_this_property(this_property, child as ref[AstNode])
                return true
        }
        false
    }

    ; getTypeFromPropertyDescriptor — `{ value: … }`, `{ get() {…} }` or
    ; `{ set(v) {…} }` read off an `Object.defineProperty` descriptor.
    procedure get_type_from_property_descriptor(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let object_literal_type this.check_expression_cached(node)
        if this.unported_mark() <> mark
            return null
        if object_literal_type = null
            return null
        let olt object_literal_type as ref[Type]
        let value_type this.get_type_of_property_of_type(olt, "value")
        if this.unported_mark() <> mark
            return null
        if value_type <> null
            return value_type
        let get_func this.get_type_of_property_of_type(olt, "get")
        if this.unported_mark() <> mark
            return null
        if get_func <> null
        {
            let get_sig this.get_single_call_signature(get_func as ref[Type])
            if this.unported_mark() <> mark
                return null
            if get_sig <> null
                return this.get_return_type_of_signature(get_sig as ref[Signature])
        }
        let set_func this.get_type_of_property_of_type(olt, "set")
        if this.unported_mark() <> mark
            return null
        if set_func <> null
        {
            let set_sig this.get_single_call_signature(set_func as ref[Type])
            if this.unported_mark() <> mark
                return null
            if set_sig <> null
                return this.get_type_of_first_parameter_of_signature(set_sig as ref[Signature])
        }
        any_type
    }

    ; getSingleCallSignature.
    procedure get_single_call_signature(this, t: ref[Type]) returns ref[Signature]?
        this.get_single_signature(t, SignatureKindCall, false)

    ; getTypeOfFirstParameterOfSignature.
    procedure get_type_of_first_parameter_of_signature(this, sig: ref[Signature]) returns ref[Type]?
        this.get_type_of_first_parameter_of_signature_with_fallback(sig, never_type)

    ; getFlowTypeInConstructor — the flow type of `this.x` at the END of the
    ; constructor, read off a SYNTHESIZED `this.x` reference pinned to the
    ; constructor's RETURN flow node.
    ;
    ; ★★ IT IS THE SECOND SYNTHESIS IN THIS FILE AND THE FIRST ONE'S TWIN:
    ; is_property_initialized_in_constructor builds the same two nodes for the
    ; definite-assignment check. What differs is where the NAME comes from — the
    ; declaration's own name node there, the SYMBOL's name here, which is why this
    ; one has to mint an identifier and that one does not.
    ;
    ; ★ The private-name branch is not decoration: a `#x` symbol's name is
    ; `<0xFE>#<id>@#x`, so the identifier this walk needs is the text after the
    ; `@` and it must be a PrivateIdentifier — get_accessed_property_name reads the
    ; TEXT of either kind, but is_matching_reference compares the kinds.
    procedure get_flow_type_in_constructor(this, symbol: ref[Symbol], constructor: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let access_name this.new_flow_access_name(symbol)
        let this_node this.new_synthetic_node(KindThisKeyword, NodeData.Token(TokenData()))
        let reference this.new_synthetic_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(this_node, null, access_name)))
        set this_node.parent: reference
        set reference.parent: constructor
        set reference.flow_node: AstNode.return_flow_node_of(constructor)
        let flow_type this.get_flow_type_of_property(reference, symbol)
        if this.unported_mark() <> mark
            return null
        if flow_type = null
            return null
        let ft flow_type as ref[Type]
        if Checker.no_implicit_any()
        {
            var auto false
            if ft = auto_type
                set auto: true
            let aat this.get_auto_array_type()
            if aat <> null
            {
                if ft = (aat as ref[Type])
                    set auto: true
            }
            ; ★ The message's two arguments are symbolToString and TypeToString
            ; calls and no instrument in this package compares one, so the report
            ; is its code and its location alone (slice 68's note) — ★★★but the
            ; TypeToString half is still WALKED (slice 189, name_type_for_message).
            if auto
            {
                let symbol_name this.symbol_arg(symbol)
                let flow_name this.type_arg(ft)
                this.error_on_node(Symbol.value_declaration_of(symbol), DiagMember_0_implicitly_has_an_1_type, symbol_name, flow_name)
            }
        }
        ; "We don't infer a type if assignments are only null or undefined."
        if this.every_type_is_nullable(ft)
            return null
        this.convert_auto_to_any(flow_type)
    }

    ; The symbol-name split both flow-in-* functions open with. The reference
    ; writes it out twice — `strings.HasPrefix(symbol.Name,
    ; InternalSymbolNamePrefix+"#")` and the `@` cut behind it — and this port
    ; writes it once, because the second copy would have been the first one's
    ; transcription rather than a reading.
    procedure new_flow_access_name(this, symbol: ref[Symbol]) returns ref[AstNode]
    {
        let name_data Symbol.name_of(symbol)
        let name_len Symbol.name_len_of(symbol)
        var private_name false
        if name_len > 1
        {
            if name_data[0] = 0xFE as char
            {
                if name_data[(1 as size_t)] = "#" as char
                    set private_name: true
            }
        }
        var access_data name_data
        if private_name
        {
            var at 0
            while at < name_len
            {
                if name_data[(at as size_t)] = "@" as char
                {
                    set access_data: name_data.slice_from((at + 1) as size_t)
                    set at: name_len
                }
                else
                    set at: at + 1
            }
        }
        this.new_synthetic_access_name(private_name, access_data)
    }

    ; getFlowTypeInStaticBlocks. The constructor's twin, and the whole difference
    ; is the LOOP: a static block whose assignments are all null or undefined is
    ; `continue`d and the next block asked, where the constructor returns nil.
    ;
    ; ★ core.Filter(parent.Members(), IsClassStaticBlockDeclaration) is not
    ; materialised — the reference needs the filtered list only to walk it and to
    ; ask whether it is empty, and both questions are asked of the member list
    ; directly (the emptiness by `class_has_static_block`).
    procedure get_flow_type_in_static_blocks(this, symbol: ref[Symbol], cls: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let members AstNode.member_list_of(cls)
        if members = null
            return null
        let ms members as ref[Array[ref[AstNode]?]]
        let n ms.get_length() as int
        var i 0
        while i < n
        {
            let m ms[i]
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if AstNode.kind_of(member) <> KindClassStaticBlockDeclaration
                continue
            let access_name this.new_flow_access_name(symbol)
            let this_node this.new_synthetic_node(KindThisKeyword, NodeData.Token(TokenData()))
            let reference this.new_synthetic_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(this_node, null, access_name)))
            set this_node.parent: reference
            set reference.parent: member
            set reference.flow_node: AstNode.return_flow_node_of(member)
            let flow_type this.get_flow_type_of_property(reference, symbol)
            if this.unported_mark() <> mark
                return null
            if flow_type = null
                return null
            let ft flow_type as ref[Type]
            if Checker.no_implicit_any()
            {
                var auto false
                if ft = auto_type
                    set auto: true
                let aat this.get_auto_array_type()
                if aat <> null
                {
                    if ft = (aat as ref[Type])
                        set auto: true
                }
                if auto
                {
                    let symbol_name this.symbol_arg(symbol)
                    let flow_name this.type_arg(ft)
                    this.error_on_node(Symbol.value_declaration_of(symbol), DiagMember_0_implicitly_has_an_1_type, symbol_name, flow_name)
                }
            }
            if this.every_type_is_nullable(ft) = false
                return this.convert_auto_to_any(flow_type)
        }
        null
    }

    ; `len(core.Filter(parent.Members(), IsClassStaticBlockDeclaration)) != 0`,
    ; which is the only thing the caller reads off that list before walking it.
    function class_has_static_block(cls: ref[AstNode]) returns bool
    {
        let members AstNode.member_list_of(cls)
        if members = null
            return false
        let ms members as ref[Array[ref[AstNode]?]]
        let n ms.get_length() as int
        var i 0
        while i < n
        {
            let m ms[i]
            set i: i + 1
            if m = null
                continue
            if AstNode.kind_of(m as ref[AstNode]) = KindClassStaticBlockDeclaration
                return true
        }
        false
    }

    ; The synthesized access NAME getFlowTypeInConstructor needs: an Identifier,
    ; or a PrivateIdentifier when the symbol's name carries the private prefix.
    ; The two share IdentifierData and differ in the union ARM, which is what
    ; is_matching_reference compares (§3.5bb).
    procedure new_synthetic_access_name(this, private_name: bool, data: Slice[char]) returns ref[AstNode]
    {
        if private_name
            return this.new_synthetic_node(KindPrivateIdentifier, NodeData.PrivateIdentifier(IdentifierData(data)))
        this.new_synthetic_node(KindIdentifier, NodeData.Identifier(IdentifierData(data)))
    }

    ; everyType(t, c.IsNullableType), written out because Scaly has no closure
    ; value here and the predicate is fixed (§3.5e).
    procedure every_type_is_nullable(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    return false
                if this.has_type_facts(row as ref[Type], TypeFactsIsUndefinedOrNull) = false
                    return false
            }
            return true
        }
        this.has_type_facts(t, TypeFactsIsUndefinedOrNull)
    }

    ; The unwinding the header names. It is not popTypeResolution's own answer that
    ; matters here — the frame is being discarded because the unit is over — so the
    ; result is deliberately dropped.
    procedure pop_type_resolution_defensively(this)
    {
        let popped this.pop_type_resolution()
    }

    ; reportCircularityError. Its two message ARGUMENTS are symbolToString calls
    ; and no instrument this package has compares one (slice 68's note), so the
    ; reports are their code and their location alone.
    ;
    ; ★★★ THE ALIAS BRANCH IS WRITTEN IN SLICE 114 AND THE NOTE THAT STOOD HERE
    ; NAMED ITS OWN EXPIRY: *"the caller that can reach it is getTypeOfAlias, which
    ; is a work-list row of its own"*. That row landed, and the branch's other half
    ; — getDeclarationOfAliasSymbol — had been ported since slice 110.
    procedure report_circularity_error(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
        {
            if (Symbol.flags_of(symbol) & SymbolFlagsAlias) <> 0
            {
                let node this.get_declaration_of_alias_symbol(symbol)
                if node <> null
                    this.error_on_node(node, DiagCircular_definition_of_import_alias_0, this.symbol_arg(symbol))
                return any_type
            }
            ; "Circularities could also result from parameters in function
            ; expressions that end up having themselves as contextual types … we
            ; have already reported an implicit any error so we don't report
            ; anything here."
            return any_type
        }
        let declaration vd as ref[AstNode]
        if AstNode.type_of(declaration) <> null
        {
            this.error_on_node(declaration, DiagX_0_is_referenced_directly_or_indirectly_in_its_own_type_annotation, this.symbol_arg(symbol))
            return error_type
        }
        if Checker.no_implicit_any()
        {
            var report true
            if AstNode.kind_of(declaration) = KindParameter
            {
                if AstNode.initializer_of(declaration) = null
                    set report: false
            }
            if report
                this.error_on_node(declaration, DiagX_0_implicitly_has_type_any_because_it_does_not_have_a_type_annotation_and_is_referenced_directly_or_indirectly_in_its_own_initializer, this.symbol_arg(symbol))
        }
        any_type
    }

    ; getWidenedTypeForVariableLikeDeclaration — one line upstream, and the two
    ; halves it composes are the whole of this slice.
    procedure get_widened_type_for_variable_like_declaration(this, declaration: ref[AstNode], report_errors: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t this.get_type_for_variable_like_declaration(declaration, true, CheckModeNormal)
        if this.unported_mark() <> mark
            return null
        this.widen_type_for_variable_like_declaration(t, declaration, report_errors)
    }

    ; getTypeForVariableLikeDeclaration — "the inferred type for a variable,
    ; parameter, or property declaration".
    ;
    ; ★★★ ITS ANSWER IS NULLABLE IN THE REFERENCE TOO, so this port's two nulls
    ; MEAN different things here: `null` with is_unported() set is a stop, and
    ; `null` without it is the reference's own *"No type specified and nothing can
    ; be inferred"* — which the widener turns into `any` plus an implicit-any
    ; report. Every caller therefore compares is_unported() rather than the value.
    ;
    ; ★★ THE checkMode PARAMETER IS CARRIED SINCE SLICE 72, and slice 69's reason
    ; for leaving it out is recorded there rather than deleted: its two readers
    ; upstream were checkExpressionEx on a for-in right-hand side and
    ; checkDeclarationInitializer, and while BOTH were stops the parameter was a
    ; claim about a signature nothing could exercise (§3.5ar). The second is ported
    ; now, so the alternative is not an absent claim but a FOLDED CONSTANT — every
    ; call would pass Normal because that is all the port has, and a folded constant
    ; leaves nothing to grep. The one non-Normal producer, getTypeForBindingElement-
    ; Parent's CheckModeRestBindingElement, is still behind a stop, so nothing
    ; observable moves. includeOptionality was always carried, because the reference
    ; calls this with both values.
    procedure get_type_for_variable_like_declaration(this, declaration: ref[AstNode], include_optionality: bool, check_mode: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let dk AstNode.kind_of(declaration)
        if dk = KindVariableDeclaration
        {
            ; "A variable declared in a for..in statement is of type string, or of
            ; type keyof T when the right hand expression is of a type parameter
            ; type." The GRANDPARENT is the statement, because the parent is the
            ; declaration LIST.
            let parent AstNode.parent_node_of(declaration)
            let gk Checker.kind_or_unknown(AstNode.parent_node_of(parent))
            if gk = KindForInStatement
            {
                ; ★★★ THE STOP THAT STOOD HERE WAS AN EXPIRED NOTE (§3.5eo): it named
                ; `getIndexType`, and `get_index_type` has been in this file since
                ; slice 89. `getNonNullableTypeIfNeeded` and `checkExpressionEx`
                ; were there too; the one thing genuinely missing was
                ; getExtractStringType, which is six lines.
                let statement AstNode.parent_node_of(parent)
                if statement = null
                    return null
                let rhs AstNode.expression_of(statement as ref[AstNode])
                if rhs = null
                    return null
                let checked this.check_expression_ex(rhs as ref[AstNode], check_mode)
                if this.unported_mark() <> mark
                    return null
                if checked = null
                    return null
                let nn this.get_non_nullable_type_if_needed(checked as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if nn = null
                    return null
                let index_type this.get_index_type(nn as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if index_type = null
                    return null
                let it index_type as ref[Type]
                if (it.flags & (TypeFlagsTypeParameter | TypeFlagsIndex)) <> 0
                    return this.get_extract_string_type(it)
                return string_type
            }
            if gk = KindForOfStatement
            {
                let statement AstNode.parent_node_of(parent)
                if statement <> null
                    return this.check_right_hand_side_of_for_of(statement as ref[AstNode])
                return null
            }
        }
        else
        {
            if dk = KindBindingElement
                return this.get_type_for_binding_element(declaration)
        }
        var is_property false
        if dk = KindPropertyDeclaration
        {
            if b.has_syntactic_modifier(declaration, ModifierFlagsAccessor) = false
                set is_property: true
        }
        if dk = KindPropertySignature
            set is_property: true
        var is_optional false
        if include_optionality
            set is_optional: Checker.is_optional_declaration(declaration)
        ; Use type from type annotation if one is present.
        let declared_type this.try_get_type_from_type_node(declaration)
        if this.unported_mark() <> mark
            return null
        if Checker.is_catch_clause_variable_declaration_or_binding_element(declaration)
        {
            if declared_type <> null
            {
                let dt declared_type as ref[Type]
                ; "If the catch clause is explicitly annotated with any or unknown,
                ; accept it, otherwise error." The error IS the errorType it
                ; returns; the diagnostic about it belongs to a caller.
                if (dt.flags & TypeFlagsAnyOrUnknown) <> 0
                    return dt
                return error_type
            }
            ; "If the catch clause is not explicitly annotated, treat it as though
            ; it were explicitly annotated with unknown or any, depending on
            ; useUnknownInCatchVariables."
            if Checker.use_unknown_in_catch_variables()
                return unknown_type
            return any_type
        }
        if declared_type <> null
            return this.add_optionality_ex(declared_type as ref[Type], is_property, is_optional)
        if Checker.no_implicit_any()
        {
            if dk = KindVariableDeclaration
            {
                var eligible true
                if AstNode.is_binding_pattern(AstNode.name_of(declaration))
                    set eligible: false
                if (b.combined_modifier_flags(declaration) & ModifierFlagsExport) <> 0
                    set eligible: false
                if (AstNode.flags_of(declaration) & NodeFlagsAmbient) <> 0
                    set eligible: false
                if eligible
                {
                    ; "use control flow tracked 'any' type for non-ambient,
                    ; non-exported var or let variables with no initializer or a
                    ; 'null' or 'undefined' initializer"
                    let initializer AstNode.initializer_of(declaration)
                    if (Binder.combined_node_flags(declaration) & NodeFlagsConstant) = 0
                    {
                        if initializer = null
                            return auto_type
                        if this.is_null_or_undefined(initializer as ref[AstNode])
                            return auto_type
                        if this.unported_mark() <> mark
                            return null
                    }
                    ; "Use control flow tracked 'any[]' type for non-ambient,
                    ; non-exported variables with an empty array literal
                    ; initializer."
                    if initializer <> null
                    {
                        if Checker.is_empty_array_literal(initializer as ref[AstNode])
                        {
                            ; ★ autoArrayType, and the note that stood here —
                            ; *"createArrayType(anyType), which needs the global
                            ; Array, from a lib this compilation does not load"* —
                            ; was wrong in both halves by slice 115: the lib loads
                            ; (slice 113) and the type is createArrayType of
                            ; AUTOType, not anyType.
                            return this.get_auto_array_type()
                        }
                    }
                }
            }
        }
        ; ★★★ THE PARAMETER ARM FALLS THROUGH, AND THAT IS THE WHOLE OF TS7006.
        ; Its four questions all answer NOTHING for an ordinary parameter — a set
        ; accessor's paired getter, a JSDoc full signature, a contextual `this` and
        ; a contextual parameter type — and the reference then carries on to the
        ; initializer arm and finally to `return nil`, which is what makes the
        ; widener report. A stop covering the block whole was written first and
        ; MEASURED: it takes the slice's largest report family with it, because
        ; `function f(a) {}` reaches every one of the four and is refused by all of
        ; them at a SYNTACTIC test.
        if dk = KindParameter
        {
            if AstNode.symbol_of(declaration) = null
            {
                ; "parameters of function types defined in JSDoc in TS files don't
                ; have symbols" — a real nil answer rather than a stop.
                return null
            }
            let fnp AstNode.parent_node_of(declaration)
            if fnp = null
                return null
            let fn fnp as ref[AstNode]
            let fk AstNode.kind_of(fn)
            ; "For a parameter of a set accessor, use the type of the get accessor
            ; if one is present"
            if fk = KindSetAccessor
            {
                ; ★★★ THE STOP HERE WAS AN EXPIRED NOTE (§3.5eo, slice 151). It read
                ; *hasLateBindableName, whose answer is checkComputedPropertyName or
                ; checkExpressionCached — an expression either way*, and slice 129
                ; ported the whole late-binding table including has_bindable_name,
                ; which is `!HasDynamicName(node) || hasLateBindableName(node)` — the
                ; reference's own `c.hasBindableName(fn)` at this very line.
                ; ★The false answer FALLS THROUGH to the arms below — it is one
                ; conjunct of the reference's `if`, not a refusal — which is why the
                ; block below is nested rather than guarded by an early return.
                let bindable this.has_bindable_name(fn)
                if this.unported_mark() <> mark
                    return null
                var acc_sym: ref[Symbol]? null
                if bindable
                {
                    set acc_sym: this.symbol_of_declaration(fn)
                    if this.unported_mark() <> mark
                        return null
                }
                if acc_sym <> null
                {
                    let getter Checker.declaration_of_kind(acc_sym as ref[Symbol], KindGetAccessor)
                    if getter <> null
                    {
                        ; ★★ SLICE 84 OPENS THIS AND THE TWO EXITS ARE DIFFERENT
                        ; CHAPTERS. `set x(v)` with a `get x(): T` takes the getter's
                        ; RETURN type — which is this slice — while a `this`
                        ; parameter of the setter takes the getter's `this`
                        ; parameter's TYPE, i.e. getTypeOfSymbol, which is the symbol
                        ; dimension and stops. The reference asserts the `this`
                        ; parameter carries no annotation of its own; a stop says the
                        ; same thing without claiming the input is impossible.
                        let getter_signature this.get_signature_from_declaration(getter as ref[AstNode])
                        if getter_signature = null
                            return null
                        let gs getter_signature as ref[Signature]
                        let setter_this Checker.get_accessor_this_parameter(fn)
                        if setter_this <> null
                        {
                            if setter_this = declaration
                            {
                                ; `getTypeOfSymbol(getterSignature.thisParameter)` —
                                ; the reference asserts the setter's `this` carries
                                ; no annotation of its own (slice 202).
                                if gs.this_parameter = null
                                {
                                    this.record_unported("get-type-of-symbol-getter-this", KindGetAccessor)
                                    return null
                                }
                                return this.get_type_of_symbol(gs.this_parameter as ref[Symbol])
                            }
                        }
                        return this.get_return_type_of_signature(gs)
                    }
                }
            }
            ; getParameterTypeOfFullSignature — the JSDoc `@type` tag's own answer
            ; for this parameter, asked before the contextual one (slice 174).
            let full_param this.get_parameter_type_of_full_signature(fn, declaration)
            if full_param <> null
                return full_param
            ; "Use contextual parameter type if one is available". The branch is
            ; chosen on the SYMBOL's name rather than on the syntax, which is the
            ; reference's spelling — InternalSymbolNameThis is the unprefixed word
            ; `this` (ast/symbol.go), so it is one of the few internal names that
            ; is not behind the 0xFE prefix.
            var contextual: ref[Type]? null
            var this_data Slice[char]()
            set this_data: Binder.internal_name_unprefixed(host, "this")
            let psym AstNode.symbol_of(declaration)
            var is_this_symbol false
            if psym <> null
            {
                let ps psym as ref[Symbol]
                if SymbolTable.names_equal(Symbol.name_of(ps), this_data)
                    set is_this_symbol: true
            }
            if is_this_symbol
                set contextual: this.get_contextual_this_parameter_type(fn)
            else
                set contextual: this.get_contextually_typed_parameter_type(declaration)
            if this.unported_mark() <> mark
                return null
            if contextual <> null
                return this.add_optionality_ex(contextual as ref[Type], false, is_optional)
        }
        ; "Use the type of the initializer expression if one is present and the
        ; declaration is not a parameter of a contextually typed function."
        if AstNode.initializer_of(declaration) <> null
        {
            let init_type this.check_declaration_initializer(declaration, check_mode, null)
            if this.unported_mark() <> mark
                return null
            let widened this.widen_type_inferred_from_initializer(declaration, init_type)
            if this.unported_mark() <> mark
                return null
            if widened = null
                return null
            return this.add_optionality_ex(widened as ref[Type], is_property, is_optional)
        }
        if Checker.no_implicit_any()
        {
            if dk = KindPropertyDeclaration
            {
                ; "We have a property declaration with no type annotation or
                ; initializer, in noImplicitAny mode or a .js file. Use control flow
                ; analysis of this.xxx assignments in the constructor or static
                ; block to determine the type of the property."
                ;
                ; ★★★ THE NOTE THAT STOOD HERE NAMED THREE ARMS AND TWO OF THE
                ; THREE HAD LANDED — get_flow_type_in_constructor and
                ; get_type_of_property_in_base_class are both in the file, the
                ; first of them since the flow chapter. Only the STATIC twin was
                ; genuinely absent, and it is twenty lines. §3.5eo; the frontier
                ; ranked the row at +139 over 249 units.
                ;
                ; ★ The `t == nil` fall-out is the reference's own and is why this
                ; is not a fallthrough: a property with no constructor and no
                ; `declare` answers NOTHING here, and the caller's next arm is a
                ; different question.
                let psym AstNode.symbol_of(declaration)
                if psym = null
                    return null
                let sym psym as ref[Symbol]
                let cls_node AstNode.parent_node_of(declaration)
                if cls_node = null
                    return null
                let cls cls_node as ref[AstNode]
                let mark2 this.unported_mark()
                var t: ref[Type]? null
                if b.has_syntactic_modifier(declaration, ModifierFlagsStatic) = false
                {
                    let constructor Checker.find_constructor_declaration(cls)
                    if constructor <> null
                        set t: this.get_flow_type_in_constructor(sym, constructor as ref[AstNode])
                    else
                    {
                        if (b.modifier_flags(declaration) & ModifierFlagsAmbient) <> 0
                            set t: this.get_type_of_property_in_base_class(sym)
                    }
                }
                else
                {
                    if Checker.class_has_static_block(cls)
                        set t: this.get_flow_type_in_static_blocks(sym, cls)
                    else
                    {
                        if (b.modifier_flags(declaration) & ModifierFlagsAmbient) <> 0
                            set t: this.get_type_of_property_in_base_class(sym)
                    }
                }
                if this.unported_mark() <> mark2
                    return null
                if t = null
                    return null
                return this.add_optionality_ex(t as ref[Type], true, is_optional)
            }
        }
        if dk = KindJsxAttribute
        {
            ; "if JSX attribute doesn't have initializer, by default the attribute
            ; will have boolean value of true". trueType needs newLiteralType, i.e.
            ; the value payload initialize_intrinsic_types names as missing.
            this.record_unported("jsx-attribute-true-type", dk)
            return null
        }
        ; "If the declaration specifies a binding pattern and is not a parameter of
        ; a contextually typed function, use the type implied by the binding
        ; pattern" — slice 134. reportErrors is TRUE here and includePatternInType
        ; is not: this is the declaration's own type, so its implicit `any`s are
        ; reported and the pattern is not attached to the answer.
        if AstNode.is_binding_pattern(AstNode.name_of(declaration))
            return this.get_type_from_binding_pattern(AstNode.name_of(declaration) as ref[AstNode], false, true)
        ; "No type specified and nothing can be inferred."
        null
    }

    ; ── slice 134: THE TYPE IMPLIED BY A BINDING PATTERN ─────────────────────
    ;
    ; ★★★ IT IS A TYPE NOBODY WROTE. `const { a, b = 1 } = x` and `const [p, q] =
    ; y` name no type at all, and the checker manufactures one from the PATTERN —
    ; an anonymous object type for the object form, a TUPLE for the array form —
    ; so that a declaration with neither an annotation nor an inferable initializer
    ; still has something to be. Two callers ask for it and they ask different
    ; questions: widenTypeForVariableLikeDeclaration wants it as the declaration's
    ; own type and REPORTS the implicit `any`s it finds on the way, while
    ; getContextualTypeForInitializerExpression wants it as a CONTEXT for the
    ; initializer and reports nothing — which is what the two booleans are for.
    ;
    ; ★★★ `includePatternInType` IS THE ONE THAT CHANGES THE ANSWER AND IT DOES SO
    ; THREE WAYS: it pushes the pattern on c.contextualBindingPatterns (which is
    ; what makes `const [a, b = a + 1] = [2]` answer nonInferrableAny for the `a`
    ; inside the default rather than recursing), it registers the result in
    ; c.patternForType, and for the array form it CLONES the tuple reference first,
    ; because a pattern may not be attached to a type object other code shares.
    ;
    ; ★★ THE CONTEXTUAL-BINDING-PATTERN STACK LANDS WITH THIS SLICE AND NOT LATER,
    ; and check_identifier is where it is read. That early-out has stood in this
    ; file as a containment proof — *"the day that row lands, this branch comes
    ; with it"* — and this is that day: a stack with a writer and no reader would
    ; be a silently wrong answer on exactly the fixture the reference wrote the
    ; branch for.

    ; getTypeFromBindingPattern.
    procedure get_type_from_binding_pattern(this, pattern: ref[AstNode], include_pattern_in_type: bool, report_errors: bool) returns ref[Type]?
    {
        if include_pattern_in_type
            this.push_contextual_binding_pattern(pattern)
        var result: ref[Type]? null
        if AstNode.kind_of(pattern) = KindObjectBindingPattern
            set result: this.get_type_from_object_binding_pattern(pattern, include_pattern_in_type, report_errors)
        else
            set result: this.get_type_from_array_binding_pattern(pattern, include_pattern_in_type, report_errors)
        ; ★ The POP is unconditional on the way out and must survive a stop: the
        ; stack is checker state, and a stop that left the pattern on it would make
        ; every later identifier inside that pattern answer nonInferrableAny.
        if include_pattern_in_type
            this.pop_contextual_binding_pattern()
        result
    }

    ; isDeclarationInContextualBindingPattern — checkIdentifier's early-out, whose
    ; comment is the reference's: *"if the identifier is declared in a binding
    ; pattern for which we're currently computing the implied type and the
    ; reference occurs with the same binding pattern, return the non-inferrable any
    ; type. This for example occurs in 'const [a, b = a + 1] = [2]' when we're
    ; computing the contextual type for the array literal '[2]'."*
    ;
    ; ★ The second conjunct is `FindAncestor(node, parent == declaration.Parent)`,
    ; i.e. *is this OCCURRENCE inside that pattern too* — the stack alone says only
    ; that some pattern is being computed.
    function reference_is_inside_computing_binding_pattern(this, node: ref[AstNode], declaration: ref[AstNode]?) returns bool
    {
        if declaration = null
            return false
        let decl declaration as ref[AstNode]
        if AstNode.kind_of(decl) <> KindBindingElement
            return false
        let pattern AstNode.parent_node_of(decl)
        if pattern = null
            return false
        let pat pattern as ref[AstNode]
        var found false
        var i 0
        while i < contextual_binding_pattern_depth
        {
            let row contextual_binding_patterns[i]
            if row <> null
            {
                if (row as ref[AstNode]) = pat
                    set found: true
            }
            set i: i + 1
        }
        if found = false
            return false
        var walk: ref[AstNode]? node
        while walk <> null
        {
            if (walk as ref[AstNode]) = pat
                return true
            set walk: AstNode.parent_node_of(walk as ref[AstNode])
        }
        false
    }

    ; contextual_binding_patterns' push and pop — contextual_infos' idiom, see the
    ; field.
    procedure push_contextual_binding_pattern(this, pattern: ref[AstNode])
    {
        if contextual_binding_pattern_depth < (contextual_binding_patterns.get_length() as int)
            contextual_binding_patterns.put(contextual_binding_pattern_depth as size_t, pattern)
        else
            contextual_binding_patterns.add(pattern)
        set contextual_binding_pattern_depth: contextual_binding_pattern_depth + 1
    }

    procedure pop_contextual_binding_pattern(this)
    {
        if contextual_binding_pattern_depth > 0
            set contextual_binding_pattern_depth: contextual_binding_pattern_depth - 1
    }

    ; getTypeFromObjectBindingPattern — "return the type implied by an object
    ; binding pattern".
    ;
    ; ★★ A REST ELEMENT CONTRIBUTES AN INDEX SIGNATURE AND NOT A PROPERTY: `{ a,
    ; ...rest }` implies `{ a: …, [x: string]: any }`, because what is left over
    ; after `a` is exactly *any other string-named property*.
    ;
    ; ★ A COMPUTED name whose type is not usable as a property name is DROPPED from
    ; the member table and recorded in the object flags instead
    ; (ObjectLiteralPatternWithComputedProperties), which is the reference's own
    ; comment: "do not include computed properties in the implied type".
    procedure get_type_from_object_binding_pattern(this, pattern: ref[AstNode], include_pattern_in_type: bool, report_errors: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let members SymbolTable.create(host)
        var string_index_info: ref[IndexInfo]? null
        var object_flags ObjectFlagsObjectLiteral | ObjectFlagsContainsObjectOrArrayLiteral
        let elements AstNode.elements_of(pattern)
        let count AstNode.list_count(elements)
        var i 0
        while i < count
        {
            let row AstNode.child_in_list(elements, i)
            set i: i + 1
            if row = null
                continue
            let e row as ref[AstNode]
            if AstNode.dot_dot_dot_token_of(e) <> null
            {
                set string_index_info: this.new_index_info(string_type, any_type, false, null)
                continue
            }
            let name Checker.property_name_or_name_of(e)
            if name = null
                return null
            let expr_type this.get_literal_type_from_property_name(name as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if expr_type = null
                return null
            let et expr_type as ref[Type]
            if Checker.is_type_usable_as_property_name(et) = false
            {
                set object_flags: object_flags | ObjectFlagsObjectLiteralPatternWithComputedProperties
                continue
            }
            var nb char[JSNUM_MAX_TEXT]
            let nd this.get_property_name_from_type(et, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
            if this.unported_mark() <> mark
                return null
            if nd.data = null
                return null
            let name_data this.copy_name_to_page(nd)
            var flags SymbolFlagsProperty
            if AstNode.initializer_of(e) <> null
                set flags: flags | SymbolFlagsOptional
            let symbol this.new_symbol(flags, name_data)
            let element_type this.get_type_from_binding_element(e, include_pattern_in_type, report_errors)
            if this.unported_mark() <> mark
                return null
            set this.value_symbol_link_of(symbol).resolved_type: element_type
            SymbolTable.set_entry(host, members, name_data, symbol)
        }
        var index_infos: ref[Array[ref[IndexInfo]?]]? null
        if string_index_info <> null
        {
            let list this.new_index_info_list()
            list.add(string_index_info)
            set index_infos: list
        }
        let made this.new_anonymous_type(null, members, null, null, index_infos)
        if made = null
            return null
        let result made as ref[Type]
        set result.object_flags: (result.object_flags | object_flags) as u32
        if include_pattern_in_type
        {
            this.record_pattern_for_type(result, pattern)
            set result.object_flags: result.object_flags | ObjectFlagsContainsObjectOrArrayLiteral
        }
        result
    }

    ; getTypeFromArrayBindingPattern — "return the type implied by an array binding
    ; pattern".
    ;
    ; ★★ THE EMPTY AND REST-ONLY PATTERNS ARE NOT TUPLES: `const [] = x` and
    ; `const [...r] = x` imply `Iterable<any>`, because neither says anything about
    ; a length. The reference's `// TODO: remove ScriptTargetES2015` guard is
    ; written as the comparison it is — languageVersion is ES2025 here, so the
    ; iterable branch is the live one and anyArrayType is not reachable.
    ;
    ; ★★ `minLength` IS A FindLastIndex AND NOT A COUNT: it is one past the last
    ; element that is neither the rest element, nor an elision, nor defaulted — so
    ; `[a, b = 1, c]` has minLength 3 and `[a, b = 1]` has 1.
    procedure get_type_from_array_binding_pattern(this, pattern: ref[AstNode], include_pattern_in_type: bool, report_errors: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let elements AstNode.elements_of(pattern)
        let count AstNode.list_count(elements)
        var rest_element: ref[AstNode]? null
        if count <> 0
        {
            let last AstNode.child_in_list(elements, count - 1)
            if last <> null
            {
                let l last as ref[AstNode]
                if AstNode.kind_of(l) = KindBindingElement
                {
                    if AstNode.dot_dot_dot_token_of(l) <> null
                        set rest_element: l
                }
            }
        }
        var iterable false
        if count = 0
            set iterable: true
        if count = 1
        {
            if rest_element <> null
                set iterable: true
        }
        if iterable
        {
            ; `if c.languageVersion >= core.ScriptTargetES2015 { return
            ; c.createIterableType(c.anyType) }; return c.anyArrayType`
            if language_version >= ScriptTargetES2015
                return this.create_iterable_type(any_type)
            return this.get_any_array_type()
        }
        var min_length 0
        var j count
        while j > 0
        {
            set j: j - 1
            let row AstNode.child_in_list(elements, j)
            if row = null
                continue
            let e row as ref[AstNode]
            if rest_element <> null
            {
                if e = (rest_element as ref[AstNode])
                    continue
            }
            if AstNode.name_of(e) = null
                continue
            if this.has_default_value(e)
                continue
            set min_length: j + 1
            break
        }
        let element_types this.new_type_list(null)
        let element_infos this.new_tuple_info_list()
        var i 0
        while i < count
        {
            let row AstNode.child_in_list(elements, i)
            var t: ref[Type]? any_type
            var is_rest false
            if row <> null
            {
                let e row as ref[AstNode]
                if rest_element <> null
                {
                    if e = (rest_element as ref[AstNode])
                        set is_rest: true
                }
                if AstNode.name_of(e) <> null
                {
                    set t: this.get_type_from_binding_element(e, include_pattern_in_type, report_errors)
                    if this.unported_mark() <> mark
                        return null
                }
            }
            var flags ElementFlagsRequired
            if is_rest
                set flags: ElementFlagsRest
            else
            {
                if i >= min_length
                    set flags: ElementFlagsOptional
            }
            element_types.add(t)
            element_infos.add(&TupleElementInfo^host(flags, null))
            set i: i + 1
        }
        let made this.create_tuple_type_ex(element_types, element_infos, false)
        if this.unported_mark() <> mark
            return null
        if made = null
            return null
        var result made as ref[Type]
        if include_pattern_in_type
        {
            let cloned this.clone_type_reference(result)
            if cloned = null
                return null
            set result: cloned as ref[Type]
            this.record_pattern_for_type(result, pattern)
            set result.object_flags: result.object_flags | ObjectFlagsContainsObjectOrArrayLiteral
        }
        result
    }

    ; getTypeFromBindingElement — "the type implied by a binding pattern element.
    ; This is the type of the initializer of the element if one is present.
    ; Otherwise, if the element is itself a binding pattern, it is the type implied
    ; by the binding pattern. Otherwise, it is the type any."
    ;
    ; ★★ THE INITIALIZER IS CHECKED WITH `unknown` AS ITS CONTEXT, not with none —
    ; "the type implied by a binding pattern is independent of context" — except
    ; where the element is ITSELF a pattern, in which case that pattern's own
    ; implied type is the context.
    ;
    ; ★ The nonInferrableAny in the last branch is the reference's own note:
    ; "inference will never directly infer this type, but it is possible to infer a
    ; type that contains it, e.g. for a binding pattern like [foo] or { foo }".
    procedure get_type_from_binding_element(this, element: ref[AstNode], include_pattern_in_type: bool, report_errors: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let name AstNode.name_of(element)
        if AstNode.initializer_of(element) <> null
        {
            var contextual_type: ref[Type]? unknown_type
            if AstNode.is_binding_pattern(name)
            {
                set contextual_type: this.get_type_from_binding_pattern(name as ref[AstNode], true, false)
                if this.unported_mark() <> mark
                    return null
            }
            let initializer_type this.check_declaration_initializer(element, CheckModeNormal, contextual_type)
            if this.unported_mark() <> mark
                return null
            if initializer_type = null
                return null
            let widened this.get_widened_literal_type_for_initializer(element, initializer_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if widened = null
                return null
            return this.add_optionality_ex(widened as ref[Type], false, true)
        }
        if AstNode.is_binding_pattern(name)
            return this.get_type_from_binding_pattern(name as ref[AstNode], include_pattern_in_type, report_errors)
        if report_errors
        {
            if this.declaration_belongs_to_private_ambient_member(element) = false
            {
                this.report_implicit_any(element, any_type, WideningKindNormal)
                if this.unported_mark() <> mark
                    return null
            }
        }
        if include_pattern_in_type
            return non_inferrable_any_type
        any_type
    }

    ; widenTypeForVariableLikeDeclaration.
    ;
    ; ★★★ THE NIL BRANCH IS THIS SLICE'S PRODUCT. A declaration with no annotation,
    ; no initializer and nothing to infer from gets `any` AND AN IMPLICIT-ANY
    ; DIAGNOSTIC — TS7005/7006/7008/7019/7031 — which is the first family of
    ; reports this port produces from the TYPE side rather than from a grammar
    ; check.
    ;
    ; ★★ THE THREE TESTS ON THE NON-NIL SIDE ARE ANSWERED SINCE SLICE 146, and the
    ; note that stood here is the reason it is worth recording what changed rather
    ; than deleting it. It read: *`t.flags&ESSymbol` reaches isGlobalSymbolConstructor,
    ; whose global symbol comes from a lib this compilation does not load;
    ; `t.flags&UniqueESSymbol` is set only by getESSymbolLikeTypeForNode, which no
    ; ported arm calls; and reportErrorsFromWidening stands behind
    ; ObjectFlagsContainsWideningType, which no type this slice can make carries.*
    ; ★The FIRST premise was expired when it was written — `lookup_globals` has had
    ; a table behind it since slice 104 and `SymbolConstructor` is in `lib.es5.d.ts`,
    ; so the answer was a lookup away, not a lib away (§3.5eo). ★The SECOND is what
    ; slice 146 built. ★The THIRD still holds and is a CALL rather than a stop since
    ; slice 112 — create_widening_type answers the NON-widening type under
    ; strictNullChecks, which is its own header's finding.
    procedure widen_type_for_variable_like_declaration(this, t: ref[Type]?, declaration: ref[AstNode], report_errors: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if t <> null
        {
            let ty t as ref[Type]
            ; ★★★ THE REFERENCE REASSIGNS `t` HERE — it does not return — and the
            ; whole comment above the line is the reason: *this special case is
            ; required for backwards compatibility with libraries that merge a
            ; `symbol` property into `SymbolConstructor`.* An early return would
            ; skip the widening report AND the widening below it, which is the
            ; shape the rest-parameter arm at the foot of this function paid for.
            var ty2 ty
            if (ty.flags & TypeFlagsESSymbol) <> 0
            {
                if this.is_global_symbol_constructor(AstNode.parent_node_of(declaration))
                {
                    let sym_like this.get_es_symbol_like_type_for_node(declaration)
                    if this.unported_mark() <> mark
                        return null
                    if sym_like = null
                        return null
                    set ty2: sym_like as ref[Type]
                }
                if this.unported_mark() <> mark
                    return null
            }
            if report_errors
            {
                ; reportErrorsFromWidening, ported in slice 112. ★The header's
                ; third zero — *no type this slice can make carries
                ; ContainsWideningType* — is why this call has never had input and
                ; why the port of it costs nothing here.
                this.report_errors_from_widening(declaration, ty2, WideningKindNormal)
                if this.unported_mark() <> mark
                    return null
            }
            ; "always widen a 'unique symbol' type if the type was created for a
            ; different declaration" — and the THIRD conjunct is the whole content:
            ; a `unique symbol` belongs to ONE declaration, so a second name bound
            ; to it widens back to `symbol`. ★The first two conjuncts are
            ; syntactic and the reference's order is kept, because the third asks
            ; the binder for a symbol.
            if (ty2.flags & TypeFlagsUniqueESSymbol) <> 0
            {
                var own false
                if AstNode.kind_of(declaration) = KindBindingElement
                    set own: true
                if AstNode.type_of(declaration) = null
                    set own: true
                if own
                {
                    let ds this.get_symbol_of_declaration(declaration)
                    var same false
                    if ty2.symbol <> null
                    {
                        if ds <> null
                        {
                            if (ty2.symbol as ref[Symbol]) = (ds as ref[Symbol])
                                set same: true
                        }
                    }
                    if same = false
                        set ty2: es_symbol_type
                }
            }
            return this.get_widened_type(ty2)
        }
        ; "Rest parameters default to type any[], other parameters default to type
        ; any"
        ;
        ; ★★★ THE REST ARM USED TO `return` HERE AND THAT SKIPPED THE REPORT BELOW
        ; IT. The reference's two arms ASSIGN `t` and fall into one shared report;
        ; an early return turns the whole implicit-any family off for exactly the
        ; declaration whose message the family's fork names — TS7019, *rest
        ; parameter implicitly has an any[] type*. ★★It was invisible while the
        ; relation stopped: `declare function h(...r): void` reported nothing and
        ; the unit was SKIPPED as unported, so the loss had no reader. Slice 118's
        ; recursion made the unit complete and the yardstick said so on the same
        ; run. **A lost line behind a stop is a lost line, and the stop is the only
        ; reason nobody sees it.**
        var t: ref[Type]? any_type
        if AstNode.kind_of(declaration) = KindParameter
        {
            if AstNode.dot_dot_dot_token_of(declaration) <> null
                set t: this.get_any_array_type()
        }
        if t = null
            return null
        ; "Report implicit any errors unless this is a private property within an
        ; ambient declaration"
        if report_errors
        {
            if this.declaration_belongs_to_private_ambient_member(declaration) = false
                this.report_implicit_any(declaration, t as ref[Type], WideningKindNormal)
        }
        t
    }

    ; ── slice 117: the DESTRUCTURING element's TYPE ──────────────────────────
    ;
    ; ★★★ THE CHAPTER IS `getTypeForBindingElement`, AND WHAT MAKES IT A FAMILY
    ; RATHER THAN A FUNCTION IS THAT ITS ANSWER IS AN INDEXED ACCESS. `const {a} =
    ; o` binds `a` to `(typeof o)["a"]`, so the whole `T[K]` constructor stands
    ; between this port and the 74 units the frontier counts — which is why this
    ; slice opens getIndexedAccessType as well, and why the arms of
    ; getPropertyTypeForIndexType that need an ELEMENT ACCESS EXPRESSION are
    ; written with stops rather than left out: this slice's caller passes a
    ; property NAME as the access node, so `accessExpression` is nil throughout and
    ; every one of those arms is dead here and live for the element-access reader
    ; that comes next.

    ; isTypeUsableAsPropertyName.
    function is_type_usable_as_property_name(t: ref[Type]) returns bool
        (t.flags & TypeFlagsStringOrNumberLiteralOrUnique) <> 0

    ; ast.IsPropertyName. NOT is_property_name_literal, which is a different list
    ; four screens down: this one carries the private identifier and the computed
    ; name and drops the no-substitution template.
    function is_property_name_kind(k: int) returns bool
    {
        if k = KindIdentifier
            return true
        if k = KindPrivateIdentifier
            return true
        if k = KindStringLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindComputedPropertyName
            return true
        false
    }

    ; getPropertyNameFromType, as this file writes a text: the DATA pointer is the
    ; answer and null is the reference's `panic` — a real difference, and it is why
    ; every caller asks is_type_usable_as_property_name first, exactly as the
    ; reference does.
    ;
    ; ★ THE NUMBER ARM NEEDS STORAGE AND THE CALLER OWNS IT, in write_property_name's
    ; shape: `buf` is a `char[JSNUM_MAX_TEXT]` the caller declares, and the answer
    ; points either into the literal's own text or into that buffer. A
    ; UniqueESSymbol's name has no producer in this port
    ; (getESSymbolLikeTypeForNode is not written), so it is a stop.
    procedure get_property_name_from_type(this, t: ref[Type], buf: Slice[char]) returns Slice[char]
    {
        if (t.flags & TypeFlagsStringLiteral) <> 0
        {
            return Checker.literal_text_of(t)
        }
        if (t.flags & TypeFlagsNumberLiteral) <> 0
        {
            ; ★★★ The text is made ONCE per literal type, on the checker's page, and
            ; `buf` is only the scratch jsnum writes into. The reference answers a Go
            ; string — immutable and owned — and the name travels on into symbol
            ; names and table keys: the union property cache keys on it. A view of
            ; the caller's STACK buffer dangled there, and the SymbolTable's stored
            ; hash had hidden it until slice 351 dropped the hash: `U[1]` of
            ; `[boolean] | [string, number]` then found the cached `"0"`, whose
            ; bytes had since been overwritten with `"1"`.
            let ix number_names_index
            let row ix.find(t as int)
            if row > 0
                return number_names[row - 1]
            let out_n jsnum_to_string(Checker.literal_bits_of(t), buf)
            let text allocate_slice[char](host, out_n as size_t)
            var k 0
            while k < out_n
            {
                text.put(k as size_t, buf[k])
                set k: k + 1
            }
            number_names.add(text)
            ix.insert(t as int, (number_names.get_length() as int) - 1)
            return text
        }
        if (t.flags & TypeFlagsUniqueESSymbol) <> 0
        {
            ; `t.AsUniqueESSymbolType().name`, slice 146. ★The name is NOT copied
            ; into `buf`: it already lives on the checker's page, where the two
            ; literal arms above have to be written out because a number has no
            ; stored text.
            return Checker.unique_es_symbol_name_of(t)
        }
        Slice[char]()
    }

    ; getLiteralTypeFromPropertyName.
    ;
    ; ★★ THE `ast.IsExpression(name)` FALL-THROUGH IS A STOP AND ITS POPULATION IS
    ; NAMED: GetPropertyNameForPropertyNameNode answers MISSING only for a computed
    ; name whose expression is not a literal — and the arm above already took every
    ; computed name — so what is left was a JsxNamespacedName, the one arm
    ; property_name_text_of deliberately does not carry (its own note says so).
    ; ★★★Since slice 162 that name is BUILT here instead: jsx_tag_name_text is the
    ; `namespace:name` concatenation the reference's own `Text()` performs, so the
    ; arm answers a string literal type and the remaining population of the stop is
    ; EMPTY — which is why it is kept rather than deleted: an arm set this function
    ; cannot enumerate is exactly what a stop is for.
    procedure get_literal_type_from_property_name(this, name: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let k AstNode.kind_of(name)
        if k = KindPrivateIdentifier
            return never_type
        if k = KindNumericLiteral
        {
            let e this.check_expression(name)
            if this.unported_mark() <> mark
                return null
            if e = null
                return null
            return this.get_regular_type_of_literal_type(e as ref[Type])
        }
        ; ★★★ SLICE 124 MAKES THE COMPUTED ARM ANSWER. It was a stop because
        ; check_computed_property_name was a PROCEDURE — its second half being the
        ; late-binding chapter — and both halves are ported now, so the arm is the
        ; reference's own line: `getRegularTypeOfLiteralType(checkComputedProperty
        ; Name(name))`.
        if k = KindComputedPropertyName
        {
            let c this.check_computed_property_name(name)
            if this.unported_mark() <> mark
                return null
            if c = null
                return null
            return this.get_regular_type_of_literal_type(c as ref[Type])
        }
        let d AstNode.property_name_text_of(name)
        if d.data <> null
            return this.get_string_literal_type(d)
        if k = KindJsxNamespacedName
        {
            var nd Slice[char]()
            if Checker.jsx_tag_name_text(this.host, name, &nd)
                return this.get_string_literal_type(nd)
        }
        ; GetPropertyNameForPropertyNameNode answers the TEXT for every name kind,
        ; the EMPTY identifier included (a missing binding name), where
        ; property_name_text_of answers a null view for an empty text — so the
        ; name kinds take the empty string literal here (slice 202,
        ; `destructuringEmptyBinding`).
        if k = KindIdentifier
            return this.get_string_literal_type(d)
        if k = KindStringLiteral
            return this.get_string_literal_type(d)
        if k = KindNoSubstitutionTemplateLiteral
            return this.get_string_literal_type(d)
        if k = KindBigIntLiteral
            return this.get_string_literal_type(d)
        ; isExpression(name) → getRegularTypeOfLiteralType(checkExpression(name)).
        if AstNode.is_expression_node(name)
        {
            let e2 this.check_expression(name)
            if this.unported_mark() <> mark
                return null
            if e2 = null
                return null
            return this.get_regular_type_of_literal_type(e2 as ref[Type])
        }
        never_type
    }

    ; getPropertyNameFromIndex — the index TYPE first, the access NODE as fallback.
    procedure get_property_name_from_index(this, index_type: ref[Type], access_node: ref[AstNode]?, buf: Slice[char]) returns Slice[char]
    {
        if Checker.is_type_usable_as_property_name(index_type)
            return this.get_property_name_from_type(index_type, buf)
        if access_node <> null
        {
            let an access_node as ref[AstNode]
            if Checker.is_property_name_kind(AstNode.kind_of(an))
            {
                let d AstNode.property_name_text_of(an)
                if d.data <> null
                {
                    return d
                }
            }
        }
        Slice[char]()
    }

    ; ── the genericity tests behind shouldDeferIndexedAccessType ─────────────
    ;
    ; ★★ isGenericStringLikeType IS WRITTEN AS A FLAG TEST THAT IS ZERO TODAY, not
    ; omitted, and it names its expiry: no template-literal or string-mapping type
    ; is minted here. **The day one of them is created this reader must be re-read**;
    ; spelling it as the real bit is what lets a grep find it.
    ;
    ; ★★★ ITS TWIN ABOVE WAS THE SAME SHAPE AND THE EXPIRY CAME AND WENT UNREAD.
    ; `is_generic_mapped_type` stood as a bare `objectFlags&Mapped != 0` under the
    ; same note — *"the day one of the three is created these two readers must be
    ; re-read"* — and slice 125 became that writer. Neither reader was re-read, so
    ; for seventeen slices EVERY mapped type answered GENERIC at nineteen call
    ; sites. The printer is where it showed: `createTypeNodeFromObjectType` takes
    ; the `{ [K in "x"]: any }` form for a generic mapped type and resolves the
    ; MEMBERS for any other, so `{ x: any; }` came out as its own source text —
    ; and it was invisible until the stop in `check_mapped_type` was retired, which
    ; is §3.5fx read from the other side. **A note that names its own expiry date is
    ; only as good as the reading nobody scheduled.**
    procedure is_generic_mapped_type(this, t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsMapped) = 0
            return false
        let constraint this.get_constraint_type_from_mapped_type(t)
        if constraint = null
            return false
        if this.is_generic_index_type(constraint as ref[Type])
            return true
        ; The `as` clause. The constraint is known non-generic by the test above,
        ; so it is substituted for the ITERATION type and what is left is asked
        ; again — a name type that mentions only the iteration variable is not
        ; what makes the mapped type generic.
        let name_type this.get_name_type_from_mapped_type(t)
        if name_type = null
            return false
        let tp this.get_type_parameter_from_mapped_type(t)
        let mapper this.new_simple_type_mapper(tp, constraint)
        let inst this.instantiate_type(name_type, mapper)
        if inst = null
            return false
        this.is_generic_index_type(inst as ref[Type])
    }

    ; isGenericStringLikeType. ★★★ITS SECOND CONJUNCT WAS MISSING UNTIL SLICE 171
    ; AND IT IS THE WHOLE PREDICATE: a template literal is generic only when it is
    ; NOT a pattern, so `` `A${string}` `` is a PATTERN and answers false here.
    ; With the conjunct absent every pattern counted as a generic index type,
    ; is_deferred_type answered true for it, and `"ABC" extends `A${string}`` was
    ; DEFERRED instead of resolving to its true branch — rc 0, no stop, no
    ; diagnostic. It was invisible for forty-five slices because every unit that
    ; reaches this shape also instantiated a template literal, and THAT was a
    ; stop: the wall in instantiate_type_worker made the whole unit UNPORTED and
    ; the yardstick honours an UNPORTED verdict. A WALL HIDES A WRONG ANSWER for
    ; exactly as long as it stands in front of it.
    function is_generic_string_like_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & (TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) = 0
            return false
        this.is_pattern_literal_type(t) = false
    }

    function is_generic_tuple_type(t: ref[Type]) returns bool
    {
        if Checker.is_tuple_type(t) = false
            return false
        let target Checker.target_of(t)
        if target = null
            return false
        (Checker.tuple_combined_flags_of(target as ref[Type]) & ElementFlagsVariadic) <> 0
    }

    ; isSingleElementGenericTupleType, slice 139 — a generic tuple whose element
    ; list holds exactly ONE entry, i.e. `[...T]`. ★It asks the GENERIC predicate
    ; above and not the flags directly: a one-element tuple is single-element
    ; without being generic (`[string]`), and the two relation arms this feeds are
    ; about the variadic spread alone.
    function is_single_element_generic_tuple_type(t: ref[Type]) returns bool
    {
        if Checker.is_generic_tuple_type(t) = false
            return false
        let target Checker.target_of(t)
        if target = null
            return false
        let infos Checker.tuple_element_infos_of(target as ref[Type])
        if infos = null
            return false
        ((infos as ref[Array[ref[TupleElementInfo]?]]).get_length() as int) = 1
    }

    ; getGenericObjectFlags. ★The union MEMO is the reference's own and it WRITES
    ; into object_flags, which is why the two predicates below cannot ask the flags
    ; themselves.
    procedure get_generic_object_flags(this, t: ref[Type]) returns int
    {
        var combined 0
        if (t.flags & (TypeFlagsUnionOrIntersection | TypeFlagsSubstitution)) <> 0
        {
            if (t.object_flags & ObjectFlagsIsGenericTypeComputed) = 0
            {
                ; ★★★ THE FORK IS UnionOrIntersection AGAINST Substitution, AND IT
                ; USED TO BE Union AGAINST A STOP whose note read *neither type is
                ; minted anywhere in this port — there is no new_intersection_type
                ; and TypeFlagsSubstitution has no producer*. Both premises expired:
                ; slice 121 brought the intersection and `new_substitution_type` has
                ; been a writer since the substitution chapter (§3.5eo). The
                ; ACCESSOR is what the fork is for — upstream reads `t.Types()` for
                ; either composite and `AsSubstitutionType()` for the third, so this
                ; asks union_or_intersection_types_of and not union_types_of.
                if (t.flags & TypeFlagsUnionOrIntersection) <> 0
                {
                    let types Checker.union_or_intersection_types_of(t)
                    if types <> null
                    {
                        let list types as ref[Array[ref[Type]?]]
                        let n list.get_length() as int
                        var i 0
                        while i < n
                        {
                            let row list[i]
                            if row <> null
                                set combined: combined | this.get_generic_object_flags(row as ref[Type])
                            set i: i + 1
                        }
                    }
                }
                else
                {
                    let base Checker.substitution_base_type_of(t)
                    if base <> null
                        set combined: combined | this.get_generic_object_flags(base as ref[Type])
                    let constraint Checker.substitution_constraint_of(t)
                    if constraint <> null
                        set combined: combined | this.get_generic_object_flags(constraint as ref[Type])
                }
                set t.object_flags: (t.object_flags | ObjectFlagsIsGenericTypeComputed | combined) as u32
            }
            return t.object_flags & ObjectFlagsIsGenericType
        }
        if (t.flags & TypeFlagsInstantiableNonPrimitive) <> 0
            set combined: combined | ObjectFlagsIsGenericObjectType
        if this.is_generic_mapped_type(t)
            set combined: combined | ObjectFlagsIsGenericObjectType
        if Checker.is_generic_tuple_type(t)
            set combined: combined | ObjectFlagsIsGenericObjectType
        if (t.flags & (TypeFlagsInstantiableNonPrimitive | TypeFlagsIndex)) <> 0
            set combined: combined | ObjectFlagsIsGenericIndexType
        if this.is_generic_string_like_type(t)
            set combined: combined | ObjectFlagsIsGenericIndexType
        combined
    }

    procedure is_generic_object_type(this, t: ref[Type]) returns bool
        (this.get_generic_object_flags(t) & ObjectFlagsIsGenericObjectType) <> 0

    procedure is_generic_index_type(this, t: ref[Type]) returns bool
        (this.get_generic_object_flags(t) & ObjectFlagsIsGenericIndexType) <> 0

    ; isGenericReducibleType. Its intersection half is isReducibleIntersection,
    ; ported in slice 166 together with the uniqueLiteralMapper the note that
    ; stood here said this port had no equivalent of.
    procedure is_generic_reducible_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            if (t.object_flags & ObjectFlagsContainsIntersections) <> 0
            {
                let types Checker.union_types_of(t)
                if types <> null
                {
                    let list types as ref[Array[ref[Type]?]]
                    let n list.get_length() as int
                    var i 0
                    while i < n
                    {
                        let row list[i]
                        if row <> null
                        {
                            if this.is_generic_reducible_type(row as ref[Type])
                                return true
                        }
                        set i: i + 1
                    }
                }
            }
        }
        if (t.flags & TypeFlagsIntersection) <> 0
            return this.is_reducible_intersection(t)
        false
    }

    ; isReducibleIntersection — "a union type which is reducible upon
    ; instantiation must be kept generic, as that instantiation information needs
    ; to flow through the type system."
    ;
    ; ★★★ IT ASKS THE QUESTION BY ANSWERING A DIFFERENT ONE. Filling every type
    ; parameter with `uniqueLiteralType` — the `never` intrinsic that
    ; getReducedType treats as a LITERAL — turns *could this intersection reduce
    ; under some instantiation* into *does this ONE instantiation reduce*, which
    ; is decidable here and now. The reference's own comment says why that is
    ; sound: only intersections with conflicting literal-typed properties are
    ; reducible at all.
    ;
    ; ★ false on a stop, like every other predicate in this file; the mark the
    ; caller took is what separates it from a measured `no`.
    procedure is_reducible_intersection(this, t: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        var filled Checker.unique_literal_filled_instantiation_of(t)
        if filled = null
        {
            if unique_literal_mapper = null
                return false
            set filled: this.instantiate_type(t, unique_literal_mapper)
            if this.unported_mark() <> mark
                return false
            if filled = null
                return false
            Checker.set_unique_literal_filled_instantiation(t, filled)
        }
        let inst filled as ref[Type]
        let reduced this.get_reduced_type(inst)
        if this.unported_mark() <> mark
            return false
        if reduced = null
            return false
        (reduced as ref[Type]) <> inst
    }

    ; indexTypeLessThan — EVERY constituent of the index is a numeric literal name
    ; below `limit`.
    procedure index_type_less_than_one(this, t: ref[Type], limit: int) returns bool
    {
        if (t.flags & TypeFlagsStringOrNumberLiteral) = 0
            return false
        var nb char[JSNUM_MAX_TEXT]
        let nd this.get_property_name_from_type(t, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if nd.data = null
            return false
        if Checker.is_numeric_literal_name(nd) = false
            return false
        let index jsnum_from_string(nd)
        if jsnum_at_least(index, jsnum_from_int(0)) = false
            return false
        jsnum_at_least(index, jsnum_from_int(limit)) = false
    }

    procedure index_type_less_than(this, index_type: ref[Type], limit: int) returns bool
    {
        if (index_type.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(index_type)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return false
                if this.index_type_less_than_one(row as ref[Type], limit) = false
                    return false
                set i: i + 1
            }
            return true
        }
        this.index_type_less_than_one(index_type, limit)
    }

    ; shouldDeferIndexedAccessType, whole since slice 176.
    ;
    ; ★★★ THE STOP THAT STOOD HERE READ *"both terms sit behind isGenericTupleType
    ; — a VARIADIC element, which getTupleElementFlags stops on before one is ever
    ; built"*, AND THE VARIADIC ELEMENT ARRIVED WITH SLICE 137. What the term
    ; actually needed was getTotalFixedElementCount, which is two accessors this
    ; file already had; it is written above, beside getEndElementCount. §3.5hd.
    ;
    ; ★★★ AND IT IS THE WALL IN FRONT OF A NON-TERMINATION, WHICH THE SLICE THAT
    ; REMOVED IT OWES A NAME. `recursiveConditionalTypes` and
    ; `declarationEmitRecursiveConditionalAliasPreserved` were UNPORTED here and
    ; are TIMEOUT at stage 2 since slice 176: both run past ten minutes without
    ; answering, where the reference answers in well under a second. The
    ; separating experiment is §3.5he's — put the two `record_unported` lines back
    ; and each unit finishes in ZERO seconds on other rows — so the deferral
    ; written here is the wall and, the arm being the reference's two lines
    ; verbatim, the divergence is downstream of it: something in the conditional
    ; type's own instantiation has no limit where upstream has one. It is named
    ; here rather than papered over, because a unit that hangs is worse than a unit
    ; that answers wrongly and only the runner's per-unit limit contains it.
    procedure should_defer_indexed_access_type(this, object_type: ref[Type], index_type: ref[Type], access_node: ref[AstNode]?) returns bool
    {
        if this.is_generic_index_type(index_type)
            return true
        if access_node <> null
        {
            if AstNode.kind_of(access_node as ref[AstNode]) <> KindIndexedAccessType
            {
                if Checker.is_generic_tuple_type(object_type) = false
                    return false
                return this.index_type_less_than(index_type, Checker.get_total_fixed_element_count_of(object_type)) = false
            }
        }
        if this.is_generic_object_type(object_type)
        {
            if Checker.is_tuple_type(object_type) = false
                return true
            if this.index_type_less_than(index_type, Checker.get_total_fixed_element_count_of(object_type))
                return this.is_generic_reducible_type(object_type)
            return true
        }
        this.is_generic_reducible_type(object_type)
    }


    ; ── the index SIGNATURE lookups (slice 117) ──────────────────────────────

    ; getIndexInfoOfType.
    procedure get_index_info_of_type(this, t: ref[Type], key_type: ref[Type]) returns ref[IndexInfo]?
        Checker.find_index_info(this.get_index_infos_of_type(t), key_type)

    ; isApplicableIndexType, whole. ★The `numericStringType` disjunct stood out
    ; until slice 202 under a note that said no template-literal type was minted
    ; anywhere in this port — true when written, false since the template chapter
    ; landed, and it cost `T[K]` with `K extends \`${number}\`` its element type.
    procedure is_applicable_index_type(this, source: ref[Type], target: ref[Type]) returns bool
    {
        if this.is_type_assignable_to(source, target)
            return true
        if target = string_type
        {
            if this.is_type_assignable_to(source, number_type)
                return true
        }
        if target = number_type
        {
            ; `source == c.numericStringType` — the `${number}` pattern applies to a
            ; number index (slice 202; `T[K]` with `K extends \`${number}\`` answered
            ; `any` and its relation failed).
            if numeric_string_type <> null
            {
                if source = (numeric_string_type as ref[Type])
                    return true
            }
            if (source.flags & TypeFlagsStringLiteral) <> 0
            {
                if Checker.is_numeric_literal_name(Checker.literal_text_of(source))
                    return true
            }
        }
        false
    }

    ; findApplicableIndexInfo, WHOLE since slice 195. ★The note that stood here read
    ; *the multi-info arm builds a SYNTHETIC IndexInfo over the intersection of the
    ; value types; no intersection type is minted in this port* — `get_intersection_type`
    ; has been in this file since slice 136 and `new_index_info` longer than that, so
    ; the arm is eight lines. ★★The key type is `unknownType` and that is upstream's
    ; own comment rather than a shortcut: *instead of computing the intersected key
    ; type, we just use unknownType, as nothing actually depends on the keyType
    ; property of the returned IndexInfo*.
    procedure find_applicable_index_info(this, infos: ref[Array[ref[IndexInfo]?]]?, key_type: ref[Type]) returns ref[IndexInfo]?
    {
        if infos = null
            return null
        let list infos as ref[Array[ref[IndexInfo]?]]
        let n list.get_length() as int
        var string_index_info: ref[IndexInfo]? null
        var applicable_value Array[ref[IndexInfo]?]()
        let applicable &applicable_value
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let info row as ref[IndexInfo]
            if info.key_type = string_type
            {
                set string_index_info: row
                continue
            }
            let kt info.key_type
            if kt = null
                continue
            if this.is_applicable_index_type(key_type, kt as ref[Type])
                applicable.add(row)
        }
        let count applicable.get_length() as int
        if count = 0
        {
            if string_index_info <> null
            {
                if this.is_applicable_index_type(key_type, string_type)
                    return string_index_info
            }
            return null
        }
        if count = 1
            return applicable[0]
        var is_readonly true
        let value_types &Array[ref[Type]?]()
        var j 0
        while j < count
        {
            let row applicable[j]
            set j: j + 1
            if row = null
                continue
            let info row as ref[IndexInfo]
            value_types.add(info.value_type)
            if info.is_readonly = false
                set is_readonly: false
        }
        let intersected this.get_intersection_type(value_types)
        if intersected = null
            return null
        this.new_index_info(unknown_type, intersected, is_readonly, null)
    }

    ; getApplicableIndexInfo.
    procedure get_applicable_index_info(this, t: ref[Type], key_type: ref[Type]) returns ref[IndexInfo]?
        this.find_applicable_index_info(this.get_index_infos_of_type(t), key_type)

    ; getApplicableIndexSymbol — the SYNTHESIZED property that stands in for an
    ; index signature, so a caller which wants a Symbol (getIntrinsicTagSymbol's
    ; string-indexer arm) has one to hand back.
    ;
    ; ★★★ THE DECLARATION LIST IS THE WHOLE CONDITION: an info with no declaration
    ; behind it mints nothing, and the answer stays nil. Where the applicable info
    ; carries one, that is the list; where it does not, EVERY info of the type whose
    ; key the lookup applies to contributes its own — which is how an intersection's
    ; several signatures end up on one symbol.
    ;
    ; ★★ THE `anyBaseTypeIndexInfo` EXCLUSION IS NOT AN OPTIMISATION. That info is
    ; the SHARED one the base-constructor fork installs, so writing a memo onto it
    ; would attach one type's synthesized symbol to every type that borrows it.
    procedure get_applicable_index_symbol(this, t: ref[Type], key_type: ref[Type]) returns ref[Symbol]?
    {
        let mark this.unported_mark()
        let info this.get_applicable_index_info(t, key_type)
        if this.unported_mark() <> mark
            return null
        if info = null
            return null
        let inf info as ref[IndexInfo]
        if any_base_type_index_info <> null
        {
            if inf = any_base_type_index_info as ref[IndexInfo]
                return null
        }
        if inf.index_symbol <> null
            return inf.index_symbol
        let declarations &Array[ref[AstNode]?]^host()
        if inf.declaration <> null
            declarations.add(inf.declaration)
        else
        {
            let infos this.get_index_infos_of_type(t)
            if this.unported_mark() <> mark
                return null
            if infos <> null
            {
                let list infos as ref[Array[ref[IndexInfo]?]]
                let n list.get_length() as int
                var i 0
                while i < n
                {
                    let row list[i]
                    if row <> null
                    {
                        let r row as ref[IndexInfo]
                        if r.declaration <> null
                        {
                            if r.key_type <> null
                            {
                                if this.is_applicable_index_type(key_type, r.key_type as ref[Type])
                                    declarations.add(r.declaration)
                                if this.unported_mark() <> mark
                                    return null
                            }
                        }
                    }
                    set i: i + 1
                }
            }
        }
        if declarations.get_length() = 0
            return inf.index_symbol
        var nd Slice[char]()
        set nd: Binder.internal_name(host, "index")
        let symbol this.new_symbol_ex(SymbolFlagsProperty, nd, CheckFlagsIndexSymbol)
        Symbol.set_declarations(symbol, declarations)
        Symbol.set_value_declaration(symbol, declarations[0])
        Symbol.set_parent(symbol, t.symbol)
        set this.value_symbol_link_of(symbol).resolved_type: inf.value_type
        set inf.index_symbol: symbol
        symbol
    }

    ; isStringIndexSignatureOnlyType — the shortcut getIndexedAccessTypeOrUndefined
    ; takes before it looks at anything else.
    procedure is_string_index_signature_only_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsObject) <> 0
        {
            if this.is_generic_mapped_type(t)
                return false
            let props this.get_properties_of_type(t)
            if props <> null
            {
                if (props as ref[Array[ref[Symbol]?]]).get_length() <> 0
                    return false
            }
            let infos this.get_index_infos_of_type(t)
            if infos = null
                return false
            if (infos as ref[Array[ref[IndexInfo]?]]).get_length() <> 1
                return false
            return this.get_index_info_of_type(t, string_type) <> null
        }
        ; ★★★ ONE ARM FOR BOTH, WHICH IS WHAT THE REFERENCE WRITES — the disjunct is
        ; `t.flags&TypeFlagsUnionOrIntersection != 0 && core.Every(t.Types(), …)`,
        ; so the intersection is not a second case with a rule of its own. The stop
        ; that stood under it (36 units at stage 2, the frontier's head by ROW) was
        ; a union-only arm plus a report, and closing it is a flag and an accessor.
        if (t.flags & TypeFlagsUnionOrIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return false
                if this.is_string_index_signature_only_type(row as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        false
    }


    ; containsMissingType — the reference builds it as a closure in
    ; initializeChecker; here it is an ordinary function. ★The union arm reads
    ; element ZERO only, which is not a shortcut: `missing` sorts first in a union
    ; by construction, and the reference asks exactly that.
    function contains_missing_type(this, t: ref[Type]) returns bool
    {
        if t = missing_type
            return true
        if (t.flags & TypeFlagsUnion) = 0
            return false
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        if list.get_length() = 0
            return false
        let first list[0]
        if first = null
            return false
        (first as ref[Type]) = missing_type
    }

    ; isJSLiteralType. ★ITS FIRST LINE ANSWERS EVERY CALL UNDER THIS HARNESS —
    ; *the flag is meaningless under noImplicitAny mode*, and noImplicitAny is TRUE
    ; here (strict_null_checks' own note gives the derivation). The rest is
    ; transcribed behind it rather than dropped, up to the instantiable arm, whose
    ; getResolvedBaseConstraint is a chapter of its own.
    procedure is_js_literal_type(this, t: ref[Type]) returns bool
    {
        if Checker.no_implicit_any()
            return false
        if (t.object_flags & ObjectFlagsJSLiteral) <> 0
            return true
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return false
                if this.is_js_literal_type(row as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let itypes Checker.intersection_types_of(t)
            if itypes = null
                return false
            let ilist itypes as ref[Array[ref[Type]?]]
            var j 0
            while j < (ilist.get_length() as int)
            {
                let member ilist[j as size_t]
                set j: j + 1
                if member = null
                    continue
                if this.is_js_literal_type(member as ref[Type])
                    return true
            }
            return false
        }
        if (t.flags & TypeFlagsInstantiable) <> 0
        {
            let constraint this.get_resolved_base_constraint(t)
            if constraint = null
                return false
            if (constraint as ref[Type]) = t
                return false
            return this.is_js_literal_type(constraint as ref[Type])
        }
        false
    }

    ; noUncheckedIndexedAccess — a plain equality against TSTrue, so an unset value
    ; answers FALSE. It is the FIFTH unset option this port reads and the third
    ; whose family matters (§3.5cw): this one is NOT in the strict family, so
    ; `strict` does not turn it on.
    function no_unchecked_indexed_access() returns bool
        checker_no_unchecked_indexed_access

    ; ── getPropertyTypeForIndexType (slice 117, completed in slice 142) ──────
    ;
    ; ★★★ SLICE 117 COULD ONLY REACH HALF OF IT AND SAID SO: `accessExpression` is
    ; the access node WHEN IT IS AN ElementAccessExpression, and that slice's only
    ; caller was the destructuring one, which passes a property NAME. Every arm
    ; under `accessExpression <> null` was written as a STOP rather than dropped,
    ; on the argument that an element-access reader arriving to find them missing
    ; would get a plausible wrong type. Slice 142 is that reader: the tag
    ; `index-type-access-expression` stood at the head of `frontier.sh` with +106
    ; units, and the three stops it named are the whole of this chapter.
    ;
    ; ★★ THE TAIL REPORTS WERE ALREADY LIVE, and they are what makes
    ; `const {nope} = o` produce TS2339 rather than nothing.
    ;
    ; ★★★ THE noImplicitAny CASCADE'S LAST FORK COLLAPSES TO ONE REPORT, AND THAT
    ; IS READ OFF THE REFERENCE RATHER THAN ASSUMED. Upstream builds one of five
    ; diagnostics in a switch and then hands it to `NewDiagnosticChainForNode(
    ; diagnostic, accessExpression, Element_implicitly_has_an_any_type_because_
    ; expression_of_type_0_can_t_be_used_to_index_type_1)`, which makes a NEW
    ; diagnostic carrying THAT code at the chained one's own loc and hangs the
    ; inner one off it as a MESSAGE CHAIN. All five inner diagnostics are on
    ; `accessExpression`, so code and span are the same whichever arm ran — and
    ; when none does, the nil path reports the same code on the same node. The
    ; yardstick dumps `C pos end code` and carries no chain, so the five-way switch
    ; is left out (§3.5be) rather than written and never distinguished.
    procedure get_property_type_for_index_type(this, original_object_type: ref[Type], object_type: ref[Type], index_type: ref[Type], full_index_type: ref[Type], access_node: ref[AstNode]?, access_flags: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        var access_expression: ref[AstNode]? null
        if access_node <> null
        {
            if AstNode.kind_of(access_node as ref[AstNode]) = KindElementAccessExpression
                set access_expression: access_node
        }
        var prop_name Slice[char]()
        var name_buf char[JSNUM_MAX_TEXT]
        var has_prop_name false
        var private_access false
        if access_node <> null
        {
            if AstNode.kind_of(access_node as ref[AstNode]) = KindPrivateIdentifier
                set private_access: true
        }
        if private_access = false
        {
            set prop_name: this.get_property_name_from_index(index_type, access_node, Slice[char](JSNUM_MAX_TEXT as size_t, &name_buf[0]))
            if this.unported_mark() <> mark
                return null
            if prop_name.data <> null
                set has_prop_name: true
        }
        if has_prop_name
        {
            if (access_flags & AccessFlagsContextual) <> 0
            {
                ; getTypeOfPropertyOfContextualType, and `any` where it answers
                ; nothing — the reference's own fallback.
                let ct this.get_type_of_property_of_contextual_type(object_type, prop_name)
                if this.unported_mark() <> mark
                    return null
                if ct = null
                    return any_type
                return ct
            }
            let prop this.get_property_of_type(object_type, prop_name)
            if this.unported_mark() <> mark
                return null
            if prop <> null
            {
                let p prop as ref[Symbol]
                ; The DEPRECATION suggestion. ★It is asked in the reference's own
                ; order, and the three terms are what keep it silent for an
                ; ordinary property: a symbol with no `@deprecated` tag is not
                ; deprecated, so nothing below runs. ★addDeprecatedSuggestion is a
                ; SUGGESTION diagnostic, which this port keeps as a COUNT (slice
                ; 70's `suggestion_count`) — the node it would report on is a
                ; message argument's worth of detail the yardstick does not carry.
                if (access_flags & AccessFlagsReportDeprecated) <> 0
                {
                    if access_node <> null
                    {
                        if Symbol.declaration_count(p) <> 0
                        {
                            if this.is_deprecated_symbol(p)
                            {
                                if this.is_uncalled_function_reference(access_node as ref[AstNode], p)
                                    set suggestion_count: suggestion_count + 1
                            }
                            if this.unported_mark() <> mark
                                return null
                        }
                    }
                }
                if access_expression <> null
                {
                    let ae access_expression as ref[AstNode]
                    let ae_expr AstNode.expression_of(ae)
                    var self_access false
                    if ae_expr <> null
                        set self_access: this.is_self_type_access(ae_expr as ref[AstNode], object_type.symbol)
                    this.mark_property_as_referenced(p, ae, self_access)
                    let atk Checker.get_assignment_target_kind(ae)
                    if this.is_assignment_to_readonly_entity(ae, p, atk)
                    {
                        this.error_on_node(AstNode.element_access_argument_of(ae), DiagCannot_assign_to_0_because_it_is_a_read_only_property, this.symbol_arg(p))
                        return null
                    }
                    if this.unported_mark() <> mark
                        return null
                    if (access_flags & AccessFlagsCacheSymbol) <> 0
                    {
                        if access_node <> null
                            set (this.symbol_node_link_of(access_node as ref[AstNode])).resolved_symbol: prop
                    }
                    if this.is_this_property_access_in_constructor(ae, p)
                        return auto_type
                    if this.unported_mark() <> mark
                        return null
                }
                var prop_type: ref[Type]? null
                if (access_flags & AccessFlagsWriting) <> 0
                    set prop_type: this.get_write_type_of_symbol(p)
                else
                    set prop_type: this.get_type_of_symbol(p)
                if this.unported_mark() <> mark
                    return null
                if prop_type = null
                    return null
                ; The reference's three-way switch, in its order: the FLOW type of
                ; the access wins over the missing-type union, and both over the
                ; property type itself.
                if access_expression <> null
                {
                    if Checker.get_assignment_target_kind(access_expression as ref[AstNode]) <> AssignmentKindDefinite
                        return this.get_flow_type_of_reference(access_expression as ref[AstNode], prop_type as ref[Type])
                }
                if access_node <> null
                {
                    if AstNode.kind_of(access_node as ref[AstNode]) = KindIndexedAccessType
                    {
                        if this.contains_missing_type(prop_type as ref[Type])
                        {
                            let pair &Array[ref[Type]?]()
                            pair.add(prop_type)
                            pair.add(undefined_type)
                            return this.get_union_type(pair)
                        }
                    }
                }
                return prop_type
            }
            ; The TUPLE arm — a numeric name against a tuple.
            ;
            ; ★★★ THE REPORT AND THE ANSWER ARE GUARDED SEPARATELY and the second
            ; guard is `index >= 0`, not the first one's conjunction: a NEGATIVE
            ; index reports and answers `undefined`, while a non-negative one out
            ; of a variadic tuple answers the rest type with no report at all.
            if this.every_type_is_tuple(object_type)
            {
                if Checker.is_numeric_literal_name(prop_name)
                {
                    let index jsnum_from_string(prop_name)
                    if access_node <> null
                    {
                        if this.every_tuple_has_no_variable_element(object_type)
                        {
                            if (access_flags & AccessFlagsAllowMissing) = 0
                            {
                                let index_node Checker.index_node_for_access_expression(access_node as ref[AstNode])
                                if Checker.is_tuple_type(object_type)
                                {
                                    if jsnum_at_least(index, jsnum_from_int(0)) = false
                                    {
                                        this.error_on_node(index_node, DiagA_tuple_type_cannot_be_indexed_with_a_negative_value)
                                        return undefined_type
                                    }
                                    let tuple_name this.type_arg(object_type)
                                    this.error_on_node(index_node, DiagTuple_type_0_of_length_1_has_no_element_at_index_2, tuple_name, Checker.arg_int(Checker.get_type_reference_arity(object_type)), Checker.arg_text(prop_name))
                                }
                                else
                                {
                                    let object_name this.type_arg(object_type)
                                    this.error_on_node(index_node, DiagProperty_0_does_not_exist_on_type_1, Checker.arg_text(prop_name), object_name)
                                }
                            }
                        }
                        if this.unported_mark() <> mark
                            return null
                    }
                    if jsnum_at_least(index, jsnum_from_int(0))
                    {
                        let ni this.get_index_info_of_type(object_type, number_type)
                        if this.unported_mark() <> mark
                            return null
                        this.error_if_writing_to_readonly_index(ni, object_type, access_expression)
                        var undefined_like: ref[Type]? null
                        if (access_flags & AccessFlagsIncludeUndefined) <> 0
                            set undefined_like: missing_type
                        return this.get_tuple_element_type_out_of_start_count(object_type, index, undefined_like)
                    }
                }
            }
        }
        if (index_type.flags & TypeFlagsNullable) = 0
        {
            if this.is_type_assignable_to_kind(index_type, TypeFlagsStringLike | TypeFlagsNumberLike | TypeFlagsESSymbolLike)
            {
                if (object_type.flags & (TypeFlagsAny | TypeFlagsNever)) <> 0
                    return object_type
                var index_info this.get_applicable_index_info(object_type, index_type)
                if this.unported_mark() <> mark
                    return null
                if index_info = null
                {
                    set index_info: this.get_index_info_of_type(object_type, string_type)
                    if this.unported_mark() <> mark
                        return null
                }
                if index_info <> null
                {
                    let info index_info as ref[IndexInfo]
                    if (access_flags & AccessFlagsNoIndexSignatures) <> 0
                    {
                        if info.key_type <> number_type
                        {
                            if access_expression <> null
                            {
                                if (access_flags & AccessFlagsWriting) <> 0
                                {
                                    this.error_on_node(access_expression, DiagType_0_is_generic_and_can_only_be_indexed_for_reading, this.type_arg(original_object_type))
                                }
                                else
                                {
                                    let index_name this.type_arg(index_type)
                                    let object_name this.type_arg(original_object_type)
                                    this.error_on_node(access_expression, DiagType_0_cannot_be_used_to_index_type_1, index_name, object_name)
                                }
                            }
                            return null
                        }
                    }
                    if access_node <> null
                    {
                        if info.key_type = string_type
                        {
                            if this.is_type_assignable_to_kind(index_type, TypeFlagsString | TypeFlagsNumber) = false
                            {
                                let index_name this.type_arg(index_type)
                                this.error_on_node(Checker.index_node_for_access_expression(access_node), DiagType_0_cannot_be_used_as_an_index_type, index_name)
                                if (access_flags & AccessFlagsIncludeUndefined) <> 0
                                {
                                    let pair &Array[ref[Type]?]()
                                    pair.add(info.value_type)
                                    pair.add(missing_type)
                                    return this.get_union_type(pair)
                                }
                                return info.value_type
                            }
                        }
                    }
                    this.error_if_writing_to_readonly_index(index_info, object_type, access_expression)
                    if (access_flags & AccessFlagsIncludeUndefined) <> 0
                    {
                        ; The ENUM exemption: an enum object indexed by its own
                        ; literal type keeps undefined out. Both halves are asked
                        ; because the term is a conjunction the reference negates
                        ; whole.
                        var enum_self false
                        if object_type.symbol <> null
                        {
                            if (Symbol.flags_of(object_type.symbol as ref[Symbol]) & (SymbolFlagsRegularEnum | SymbolFlagsConstEnum)) <> 0
                            {
                                if index_type.symbol <> null
                                {
                                    if (index_type.flags & TypeFlagsEnumLiteral) <> 0
                                    {
                                        if this.get_parent_of_symbol(index_type.symbol as ref[Symbol]) = object_type.symbol
                                            set enum_self: true
                                    }
                                }
                            }
                        }
                        if enum_self = false
                        {
                            let pair &Array[ref[Type]?]()
                            pair.add(info.value_type)
                            pair.add(missing_type)
                            return this.get_union_type(pair)
                        }
                    }
                    return info.value_type
                }
                if (index_type.flags & TypeFlagsNever) <> 0
                    return never_type
                if this.is_js_literal_type(object_type)
                    return any_type
                if this.unported_mark() <> mark
                    return null
                if access_expression <> null
                {
                    let ae access_expression as ref[AstNode]
                    if Checker.is_const_enum_object_type(object_type) = false
                    {
                        if Checker.is_object_literal_type(object_type)
                        {
                            if Checker.no_implicit_any()
                            {
                                if (index_type.flags & (TypeFlagsStringLiteral | TypeFlagsNumberLiteral)) <> 0
                                {
                                    let object_name this.type_arg(object_type)
                                    this.error_on_node(ae, DiagProperty_0_does_not_exist_on_type_1, this.literal_value_arg(index_type), object_name)
                                    return undefined_type
                                }
                            }
                            if (index_type.flags & (TypeFlagsNumber | TypeFlagsString)) <> 0
                            {
                                ; The union of every property's type plus
                                ; `undefined`. ★It reads the object type's OWN
                                ; property list — `AsStructuredType().properties`
                                ; upstream — and NOT getPropertiesOfType, whose
                                ; apparent-type reduction and union arm answer for
                                ; a different question here.
                                ; ★A null list is an EMPTY one — `{}` has no
                                ; properties — and upstream's `append(types,
                                ; undefinedType)` over an empty slice is
                                ; `undefined` alone.
                                let props this.get_properties_of_object_type(object_type)
                                if this.unported_mark() <> mark
                                    return null
                                let out this.new_type_list(null)
                                if props <> null
                                {
                                    let list props as ref[Array[ref[Symbol]?]]
                                    let pn list.get_length() as int
                                    var pi 0
                                    while pi < pn
                                    {
                                        let row list[pi]
                                        if row = null
                                            return null
                                        let pt this.get_type_of_symbol(row as ref[Symbol])
                                        if this.unported_mark() <> mark
                                            return null
                                        if pt = null
                                            return null
                                        out.add(pt)
                                        set pi: pi + 1
                                    }
                                }
                                out.add(undefined_type)
                                return this.get_union_type(out)
                            }
                        }
                        ; The globalThis fork. ★Its third and fourth terms ask the
                        ; SAME export twice upstream; one lookup answers both.
                        var global_this_block false
                        if object_type.symbol = global_this_symbol
                        {
                            if has_prop_name
                            {
                                let ex SymbolTable.get(Symbol.exports_of(global_this_symbol), prop_name)
                                if ex <> null
                                {
                                    if (Symbol.flags_of(ex as ref[Symbol]) & SymbolFlagsBlockScoped) <> 0
                                        set global_this_block: true
                                }
                            }
                        }
                        if global_this_block
                        {
                            let object_name this.type_arg(object_type)
                            this.error_on_node(ae, DiagProperty_0_does_not_exist_on_type_1, Checker.arg_text(prop_name), object_name)
                            return null
                        }
                        if Checker.no_implicit_any()
                        {
                            if (access_flags & AccessFlagsSuppressNoImplicitAnyError) = 0
                            {
                                var static_member false
                                if has_prop_name
                                {
                                    set static_member: this.type_has_static_property(prop_name, object_type)
                                    if this.unported_mark() <> mark
                                        return null
                                }
                                if static_member
                                {
                                    let type_name this.type_arg(object_type)
                                    var static_text StringBuilder()
                                    static_text.append(type_name)
                                    static_text.append("[" as char)
                                    let arg_node AstNode.element_access_argument_of(ae)
                                    if arg_node <> null
                                        static_text.append(Checker.arg_text(this.source_text_of_node(arg_node as ref[AstNode])))
                                    static_text.append("]" as char)
                                    this.error_on_node(ae, DiagProperty_0_does_not_exist_on_type_1_Did_you_mean_to_access_the_static_member_2_instead, Checker.arg_text(prop_name), type_name, static_text.to_string())
                                    return null
                                }
                                let numeric this.get_index_type_of_type(object_type, number_type)
                                if this.unported_mark() <> mark
                                    return null
                                if numeric <> null
                                {
                                    this.error_on_node(AstNode.element_access_argument_of(ae), DiagElement_implicitly_has_an_any_type_because_index_expression_is_not_of_type_number)
                                    return null
                                }
                                var suggestion: ref[Symbol]? null
                                if has_prop_name
                                {
                                    set suggestion: this.get_suggestion_for_nonexistent_property(prop_name, object_type)
                                    if this.unported_mark() <> mark
                                        return null
                                }
                                if suggestion <> null
                                {
                                    let object_name this.type_arg(object_type)
                                    this.error_on_node(AstNode.element_access_argument_of(ae), DiagProperty_0_does_not_exist_on_type_1_Did_you_mean_2, Checker.arg_text(prop_name), object_name, Checker.arg_text(Symbol.name_of(suggestion as ref[Symbol])))
                                    return null
                                }
                                let index_suggestion this.get_suggestion_for_nonexistent_index_signature(object_type, ae, index_type)
                                if this.unported_mark() <> mark
                                    return null
                                if index_suggestion
                                {
                                    let object_name this.type_arg(object_type)
                                    this.error_on_node(ae, DiagElement_implicitly_has_an_any_type_because_type_0_has_no_index_signature_Did_you_mean_to_call_1, object_name, this.index_signature_suggestion_text(ae))
                                    return null
                                }
                                ; The five-way switch and its chain — one report,
                                ; for the reason this function's header gives. ★★★Its
                                ; ARGUMENTS are named all the same (slice 189): four
                                ; of the five arms print the index type and every one
                                ; of them the object type, and the chain link prints
                                ; the FULL index type — see name_type_for_message.
                                if (index_type.flags & (TypeFlagsEnumLiteral | TypeFlagsStringLiteral | TypeFlagsNumberLiteral | TypeFlagsNumber | TypeFlagsString)) <> 0
                                {
                                    if (index_type.flags & (TypeFlagsStringLiteral | TypeFlagsNumberLiteral)) = 0
                                        this.name_type_for_message(index_type)
                                    this.name_type_for_message(object_type)
                                }
                                if (index_type.flags & TypeFlagsUniqueESSymbol) <> 0
                                    this.name_type_for_message(object_type)
                                let full_index_name this.type_arg(full_index_type)
                                let object_name this.type_arg(object_type)
                                this.error_on_node(ae, DiagElement_implicitly_has_an_any_type_because_expression_of_type_0_can_t_be_used_to_index_type_1, full_index_name, object_name)
                            }
                        }
                        ; ★★★ THE `return nil` BELONGS TO THE CONST-ENUM GUARD AND
                        ; STOOD OUTSIDE IT UNTIL SLICE 185. Upstream's whole block is
                        ; `if accessExpression != nil && !isConstEnumObjectType(objectType) { … return nil }`,
                        ; so a CONST ENUM falls THROUGH to the tail below and gets
                        ; its TS2339 there; with the return one level out, `E["B"]`
                        ; answered null in silence.
                        return null
                    }
                }
            }
        }
        if (access_flags & AccessFlagsAllowMissing) <> 0
        {
            if Checker.is_object_literal_type(object_type)
                return undefined_type
        }
        if this.is_js_literal_type(object_type)
            return any_type
        if this.unported_mark() <> mark
            return null
        if access_node <> null
        {
            let index_node Checker.index_node_for_access_expression(access_node)
            var reported false
            if AstNode.kind_of(index_node) <> KindBigIntLiteral
            {
                if (index_type.flags & (TypeFlagsStringLiteral | TypeFlagsNumberLiteral)) <> 0
                {
                    let object_name this.type_arg(object_type)
                    this.error_on_node(index_node, DiagProperty_0_does_not_exist_on_type_1, this.literal_value_arg(index_type), object_name)
                    set reported: true
                }
            }
            if reported = false
            {
                if (index_type.flags & (TypeFlagsString | TypeFlagsNumber)) <> 0
                {
                    let object_name this.type_arg(object_type)
                    let index_name this.type_arg(index_type)
                    this.error_on_node(index_node, DiagType_0_has_no_matching_index_signature_for_type_1, object_name, index_name)
                    set reported: true
                }
            }
            if reported = false
            {
                ; `typeString` is "bigint" for a BigInt literal index and the index
                ; type's own name otherwise — so only the second spelling walks.
                var type_string String("bigint")
                if AstNode.kind_of(index_node) <> KindBigIntLiteral
                    set type_string: this.type_arg(index_type)
                this.error_on_node(index_node, DiagType_0_cannot_be_used_as_an_index_type, type_string)
            }
        }
        if Checker.is_type_any(index_type)
            return index_type
        null
    }

    ; getIndexNodeForAccessExpression.
    function index_node_for_access_expression(access_node: ref[AstNode]) returns ref[AstNode]
    {
        let k AstNode.kind_of(access_node)
        if k = KindElementAccessExpression
        {
            let a AstNode.element_access_argument_of(access_node)
            if a <> null
                return a as ref[AstNode]
        }
        if k = KindIndexedAccessType
        {
            let it AstNode.indexed_access_index_type_of(access_node)
            if it <> null
                return it as ref[AstNode]
        }
        if k = KindComputedPropertyName
        {
            let e AstNode.expression_of(access_node)
            if e <> null
                return e as ref[AstNode]
        }
        access_node
    }

    ; everyType(t, isTupleType), written out because Scaly has no closure value
    ; here and the predicate is fixed (§3.5e).
    function every_type_is_tuple(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return false
                if Checker.is_tuple_type(row as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        Checker.is_tuple_type(t)
    }

    ; The tuple arm's second everyType, whose predicate is *this tuple has no
    ; VARIABLE element*. ★It is a separate walk rather than a flag on the one
    ; above because the reference asks it separately and later — a tuple with a
    ; rest element still HAS an element at a fixed index, so it must not report.
    ;
    ; ★★★ THE COMBINED FLAGS ARE THE TARGET'S (§3.5he). The predicate's whole
    ; body upstream is `t.TargetTupleType().combinedFlags&Variable == 0`, and
    ; until slice 176 this asked the tuple REFERENCE — where `is_tuple_target`
    ; is false and the accessor answers its neutral `ElementFlagsNone`, so the
    ; predicate was CONSTANTLY TRUE and `[string, ...number[]]` reached the
    ; negative-index and out-of-range reports the reference suppresses.
    function every_tuple_has_no_variable_element(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return false
                if Checker.tuple_has_no_variable_element(row as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        Checker.tuple_has_no_variable_element(t)
    }

    ; The predicate itself, over ONE tuple type reference. ★A target this port
    ; cannot read answers *has a variable element*, which is the side that
    ; reports nothing — the reference cannot reach the question at all, its
    ; caller having established `isTupleType` first.
    function tuple_has_no_variable_element(t: ref[Type]) returns bool
    {
        let target Checker.target_of(t)
        if target = null
            return false
        (Checker.tuple_combined_flags_of(target as ref[Type]) & ElementFlagsVariable) = 0
    }

    ; errorIfWritingToReadonlyIndex, whole.
    procedure error_if_writing_to_readonly_index(this, index_info: ref[IndexInfo]?, object_type: ref[Type], access_expression: ref[AstNode]?)
    {
        if index_info = null
            return
        if (index_info as ref[IndexInfo]).is_readonly = false
            return
        if access_expression = null
            return
        let ae access_expression as ref[AstNode]
        var target false
        if Binder.is_assignment_target(ae)
            set target: true
        if target = false
            set target: Checker.is_delete_target(ae)
        if target = false
            return
        let object_name this.type_arg(object_type)
        this.error_on_node(ae, DiagIndex_signature_in_type_0_only_permits_reading, object_name)
    }

    ; ── getIndexedAccessType (slice 117) ─────────────────────────────────────

    procedure get_indexed_access_type(this, object_type: ref[Type], index_type: ref[Type]) returns ref[Type]?
        this.get_indexed_access_type_ex(object_type, index_type, AccessFlagsNone, null, null)

    ; getIndexedAccessTypeEx.
    ;
    ; ★★★ THE FALLBACK IS `IfElse(accessNode != nil, c.errorType, c.unknownType)` AND THE
    ; NOTE HERE SAID `core.OrElse(…, c.errorType)` — one arm of a two-arm answer, written
    ; down as the whole of it. The `accessNode == nil` half is the COMMON one: the
    ; two-argument `get_indexed_access_type` passes null, so every internal indexed access
    ; whose property is missing was answering an ANY where the reference answers UNKNOWN,
    ; and Any is assignable to everything while unknown is assignable to almost nothing.
    ; ★It was found by a reporting site that never fires (§3.5hv): elaborate_jsx_components'
    ; two arity reports both sit behind `is_type_related_to(get_indexed_access_type(source,
    ; children_name_type), …) = false`, and with an Any source that guard can never be false
    ; — the source-Any arm of is_simple_type_related_to is the reference's own line.
    procedure get_indexed_access_type_ex(this, object_type: ref[Type], index_type: ref[Type], access_flags: int, access_node: ref[AstNode]?, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t this.get_indexed_access_type_or_undefined(object_type, index_type, access_flags, access_node, alias)
        if this.unported_mark() <> mark
            return null
        if t = null
        {
            if access_node = null
                return unknown_type
            return error_type
        }
        t
    }

    ; getIndexedAccessTypeOrUndefined.
    ;
    ; ★★ THE DEFERRAL BRANCH MINTS AN IndexedAccess TYPE AND THIS PORT HAS NO SUCH
    ; RECORD, so it is a stop; should_defer_indexed_access_type is what decides
    ; whether it is reached, and its own note says the only route in is a GENERIC
    ; index or object type — neither of which a destructuring source can be until
    ; the inference chapter lands.
    ;
    ; ★ noUncheckedIndexedAccess is unset under this harness, which is the fifth
    ; reading of an unset option §3.5cw counts: the flag is asked rather than
    ; folded, so the day the option is read the line is already right.
    procedure get_indexed_access_type_or_undefined(this, object_type_in: ref[Type], index_type_in: ref[Type], access_flags_in: int, access_node: ref[AstNode]?, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        if object_type_in = wildcard_type
            return wildcard_type
        if index_type_in = wildcard_type
            return wildcard_type
        var object_type: ref[Type] object_type_in
        let reduced this.get_reduced_type(object_type)
        if this.unported_mark() <> mark
            return null
        if reduced <> null
            set object_type: reduced as ref[Type]
        var index_type: ref[Type] index_type_in
        var access_flags access_flags_in
        if this.is_string_index_signature_only_type(object_type)
        {
            if (index_type.flags & TypeFlagsNullable) = 0
            {
                if this.is_type_assignable_to_kind(index_type, TypeFlagsString | TypeFlagsNumber)
                    set index_type: string_type
            }
        }
        if this.unported_mark() <> mark
            return null
        if Checker.no_unchecked_indexed_access()
        {
            if (access_flags & AccessFlagsExpressionPosition) <> 0
                set access_flags: access_flags | AccessFlagsIncludeUndefined
        }
        ; ★★★ THE DEFERRAL IS CODE SINCE SLICE 121 and the note that stood on this
        ; function is its expiry: *"the deferral branch MINTS an IndexedAccess type
        ; and this port has no such record"*. It has one now. What the branch is
        ; FOR is the reference's own comment: for a generic T there is no
        ; meaningful property of the object type to read, so `T[K]` stays `T[K]`.
        if this.should_defer_indexed_access_type(object_type, index_type, access_node)
        {
            if (object_type.flags & TypeFlagsAnyOrUnknown) <> 0
                return object_type
            ; getIndexedAccessKey(objectType, indexType, accessFlags, alias) — and
            ; note the KEY takes the full flags while the TYPE keeps only the
            ; persistent ones, which is the reference's own asymmetry.
            let persistent access_flags & AccessFlagsPersistent
            let existing this.find_indexed_access_type(object_type, index_type, access_flags, alias)
            if existing <> null
                return existing
            let made this.new_indexed_access_type(object_type, index_type, persistent)
            Checker.set_type_alias(made, alias)
            indexed_access_types.add(&IndexedAccessEntry^host(access_flags, object_type, index_type, made))
            return made
        }
        if this.unported_mark() <> mark
            return null
        let apparent this.get_reduced_apparent_type(object_type)
        if this.unported_mark() <> mark
            return null
        if apparent = null
            return null
        let apparent_object_type apparent as ref[Type]
        if (index_type.flags & TypeFlagsUnion) <> 0
        {
            if (index_type.flags & TypeFlagsBoolean) = 0
            {
                ; The per-constituent loop, whose two exits are an intersection
                ; (AccessFlagsWriting) and a union of the property types. The
                ; intersection has no producer here, so the arm is written and the
                ; write direction stops.
                let types Checker.union_types_of(index_type)
                if types = null
                    return null
                let list types as ref[Array[ref[Type]?]]
                let n list.get_length() as int
                let prop_types &Array[ref[Type]?]()
                var was_missing_prop false
                var i 0
                while i < n
                {
                    let row list[i]
                    set i: i + 1
                    if row = null
                        continue
                    var extra 0
                    if was_missing_prop
                        set extra: AccessFlagsSuppressNoImplicitAnyError
                    let pt this.get_property_type_for_index_type(object_type, apparent_object_type, row as ref[Type], index_type, access_node, access_flags | extra)
                    if this.unported_mark() <> mark
                        return null
                    if pt <> null
                        prop_types.add(pt)
                    else
                    {
                        if access_node = null
                            return null
                        set was_missing_prop: true
                    }
                }
                if was_missing_prop
                    return null
                ; ★ THE WRITING ARM IS CODE SINCE SLICE 121 — the note above this
                ; loop said *"the intersection has no producer here, so the arm is
                ; written and the write direction stops"*, and the intersection is
                ; the producer.
                if (access_flags & AccessFlagsWriting) <> 0
                    return this.get_intersection_type_ex(prop_types, IntersectionFlagsNone, alias)
                return this.get_union_type_ex(prop_types, UnionReductionLiteral, alias, null)
            }
        }
        this.get_property_type_for_index_type(object_type, apparent_object_type, index_type, index_type, access_node, access_flags | AccessFlagsCacheSymbol | AccessFlagsReportDeprecated)
    }


    ; ── filterType and the two facts wrappers (slice 117) ────────────────────

    ; filterType, with the reference's PREDICATE fixed to a TypeFacts mask — the
    ; only shape this slice calls it in, and §3.5e's rule for a func value whose
    ; callees are static.
    ;
    ; ★★ THE `origin` BRANCH IS NOT PORTED — filter_type_outside_flags carries the
    ; condition under which that is the REFERENCE's answer and not a divergence,
    ; and the one shape it does not cover. The branch is a refinement of the
    ; RESULT and never of the membership, so leaving it out cannot change which
    ; constituents survive.
    procedure filter_type_by_facts(this, t: ref[Type], include: int) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            let filtered this.new_type_list(null)
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if this.has_type_facts(row as ref[Type], include)
                    filtered.add(row)
            }
            if (filtered.get_length() as int) = n
                return t
            var origin_single: ref[Type]? null
            let new_origin this.filtered_union_origin(t, filtered, &origin_single)
            if origin_single <> null
                return origin_single
            return this.get_union_type_from_sorted_list(filtered, t.object_flags & (ObjectFlagsPrimitiveUnion | ObjectFlagsContainsIntersections), null, new_origin)
        }
        if (t.flags & TypeFlagsNever) <> 0
            return t
        if this.has_type_facts(t, include)
            return t
        never_type
    }

    ; getTypeWithFacts.
    procedure get_type_with_facts(this, t: ref[Type], include: int) returns ref[Type]?
        this.filter_type_by_facts(t, include)

    ; getNonUndefinedType. ★Its first half maps an INSTANTIABLE constituent onto its
    ; base constraint, which needs getBaseConstraintOrType — a chapter of its own —
    ; and someType of a non-instantiable union answers false, so the arm is a stop
    ; behind a predicate that nothing in this slice can satisfy.
    procedure get_non_undefined_type(this, t: ref[Type]) returns ref[Type]?
    {
        ; `someType(t, isGenericTypeWithUndefinedConstraint)` → every INSTANTIABLE
        ; constituent is replaced by its base constraint (or itself) before the
        ; facts are applied. ★The stop that stood here asked the bare type and let
        ; a UNION through, so `P["foo"] | undefined` lost its `undefined` and kept
        ; `P["foo"]` where the reference answers the constraint `boolean` — a
        ; destructuring default on a `Readonly<P>` parent (slice 203,
        ; `destructuringWithConstraint`, `strictNullNotNullIndexTypeShouldWork`).
        let mark this.unported_mark()
        var type_or_constraint t
        if this.some_type_is_generic_with_undefined_constraint(t)
        {
            let mapped this.map_instantiable_to_base_constraint(t)
            if this.unported_mark() <> mark
                return null
            if mapped = null
                return null
            set type_or_constraint: mapped as ref[Type]
        }
        if this.unported_mark() <> mark
            return null
        this.get_type_with_facts(type_or_constraint, TypeFactsNEUndefined)
    }

    ; isGenericTypeWithUndefinedConstraint, asked of some constituent.
    procedure some_type_is_generic_with_undefined_constraint(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_generic_type_with_undefined_constraint(t)
        let members Checker.union_types_of(t)
        if members = null
            return false
        let ml members as ref[Array[ref[Type]?]]
        let n ml.get_length() as int
        var i 0
        while i < n
        {
            let row ml[i]
            set i: i + 1
            if row = null
                continue
            if this.is_generic_type_with_undefined_constraint(row as ref[Type])
                return true
        }
        false
    }

    procedure is_generic_type_with_undefined_constraint(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsInstantiable) = 0
            return false
        let mark this.unported_mark()
        let constraint this.get_base_constraint_of_type(t)
        if this.unported_mark() <> mark
            return false
        if constraint = null
            return false
        Checker.maybe_type_of_kind(constraint as ref[Type], TypeFlagsUndefined)
    }

    ; mapType(t, t => Instantiable ? getBaseConstraintOrType(t) : t)
    procedure map_instantiable_to_base_constraint(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            if (t.flags & TypeFlagsInstantiable) <> 0
                return this.get_base_constraint_or_type(t)
            return t
        }
        let members Checker.union_types_of(t)
        if members = null
            return t
        let ml members as ref[Array[ref[Type]?]]
        let n ml.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row ml[i]
            set i: i + 1
            if row = null
                continue
            let m row as ref[Type]
            var nm: ref[Type]? m
            if (m.flags & TypeFlagsInstantiable) <> 0
            {
                set nm: this.get_base_constraint_or_type(m)
                if this.unported_mark() <> mark
                    return null
                if nm = null
                    return null
                if (nm as ref[Type]) <> m
                    set changed: true
            }
            mapped.add(nm)
        }
        if changed = false
            return t
        this.get_union_type(mapped)
    }

    ; getTypeOfInitializer — the CACHED type of an initializer expression, so that a
    ; transient type is recomputed rather than remembered.
    procedure get_type_of_initializer(this, node: ref[AstNode]) returns ref[Type]?
    {
        ; ★ The reference asks `typeNodeLinks.Has(node)` first; this port's reader
        ; MINTS on miss, and the two agree — a fresh row's resolved_type is null,
        ; which is the same fall-through. What it costs is one row per uncached
        ; initializer, which is the table's own design (see type_node_link_of).
        let links this.type_node_link_of(node)
        let t links.resolved_type
        if t <> null
            return t
        this.get_type_of_expression(node)
    }

    ; ── the binding element's TYPE (slice 117) ───────────────────────────────

    ; getTypeForBindingElementParent. ★The cached resolvedType is read only under
    ; CheckModeNormal AND only when no optionality was folded into it, which is the
    ; reference's own condition and not an optimisation: the cache is filled by
    ; getTypeOfVariableOrParameterOrProperty, which passes includeOptionality TRUE.
    procedure get_type_for_binding_element_parent(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        if check_mode = CheckModeNormal
        {
            let mark this.unported_mark()
            let symbol this.symbol_of_declaration(node)
            if this.unported_mark() <> mark
                return null
            if symbol <> null
            {
                let links this.value_symbol_link_of(symbol as ref[Symbol])
                let resolved links.resolved_type
                if resolved <> null
                {
                    var optional false
                    if Checker.strict_null_checks()
                    {
                        if Checker.is_optional_declaration(node)
                            set optional: true
                    }
                    if optional = false
                        return resolved
                }
            }
        }
        this.get_type_for_variable_like_declaration(node, false, check_mode)
    }

    ; getTypeForBindingElement.
    procedure get_type_for_binding_element(this, declaration: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        var check_mode CheckModeNormal
        if AstNode.dot_dot_dot_token_of(declaration) <> null
            set check_mode: CheckModeRestBindingElement
        let parent AstNode.parent_node_of(declaration)
        if parent = null
            return null
        let grandparent AstNode.parent_node_of(parent as ref[AstNode])
        if grandparent = null
            return null
        let parent_type this.get_type_for_binding_element_parent(grandparent as ref[AstNode], check_mode)
        if this.unported_mark() <> mark
            return null
        if parent_type = null
            return null
        this.get_binding_element_type_from_parent_type(declaration, parent_type as ref[Type], false)
    }

    ; getBindingElementTypeFromParentType.
    ;
    ; ★★★ THIS IS WHERE `const {a} = o` BECOMES `(typeof o)["a"]`, and the two
    ; patterns take genuinely different routes: an OBJECT pattern indexes, an ARRAY
    ; pattern iterates. The array half is a row of its own — checkIteratedType
    ; OrElementType with IterationUseDestructuring, the iteration-type family — and
    ; so is the object REST element, whose answer is getRestType over the spreadable
    ; properties.
    ;
    ; ★★ THE UNDEFINED-STRIPPING PRELUDE IS NOT DECORATION. `const {a} = o` where
    ; the DECLARATION has an initializer removes `undefined` from the parent type
    ; before indexing, because a destructuring of a possibly-undefined value has
    ; already been reported; without it every property of an optional source comes
    ; out one union member too wide.
    ; mapType(parentType, t => InstantiableNonPrimitive ? getBaseConstraintOrType(t) : t)
    procedure map_parent_to_base_constraint(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            if (t.flags & TypeFlagsInstantiableNonPrimitive) <> 0
                return this.get_base_constraint_or_type(t)
            return t
        }
        let members Checker.union_types_of(t)
        if members = null
            return t
        let ml members as ref[Array[ref[Type]?]]
        let n ml.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let row ml[i]
            set i: i + 1
            if row = null
                continue
            let m row as ref[Type]
            var nm: ref[Type]? m
            if (m.flags & TypeFlagsInstantiableNonPrimitive) <> 0
            {
                set nm: this.get_base_constraint_or_type(m)
                if this.unported_mark() <> mark
                    return null
                if nm = null
                    return null
                if (nm as ref[Type]) <> m
                    set changed: true
            }
            mapped.add(nm)
        }
        if changed = false
            return t
        this.get_union_type(mapped)
    }

    procedure get_binding_element_type_from_parent_type(this, declaration: ref[AstNode], parent_type_in: ref[Type], no_tuple_bounds_check: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if Checker.is_type_any(parent_type_in)
            return parent_type_in
        let pattern_opt AstNode.parent_node_of(declaration)
        if pattern_opt = null
            return null
        let pattern pattern_opt as ref[AstNode]
        var parent_type: ref[Type] parent_type_in
        var ambient_parameter false
        if Checker.strict_null_checks()
        {
            if (AstNode.flags_of(declaration) & NodeFlagsAmbient) <> 0
            {
                if Binder.is_part_of_parameter_declaration(declaration)
                    set ambient_parameter: true
            }
        }
        if ambient_parameter
        {
            ; ★The note that stood here named getAdjustedTypeWithFacts and the
            ; removeNullableByIntersection family as absent; both have been in this
            ; file since the type-facts chapter.
            let nn this.get_non_nullable_type(parent_type)
            if nn = null
                return null
            set parent_type: nn as ref[Type]
        }
        else
        {
            if Checker.strict_null_checks()
            {
                let pattern_parent AstNode.parent_node_of(pattern)
                if pattern_parent <> null
                {
                    let pinit AstNode.initializer_of(pattern_parent as ref[AstNode])
                    if pinit <> null
                    {
                        let it this.get_type_of_initializer(pinit as ref[AstNode])
                        if this.unported_mark() <> mark
                            return null
                        if it <> null
                        {
                            if this.has_type_facts(it as ref[Type], TypeFactsEQUndefined) = false
                            {
                                let stripped this.get_type_with_facts(parent_type, TypeFactsNEUndefined)
                                if this.unported_mark() <> mark
                                    return null
                                if stripped = null
                                    return null
                                set parent_type: stripped as ref[Type]
                            }
                        }
                    }
                }
            }
        }
        var access_flags AccessFlagsExpressionPosition
        var allow_missing no_tuple_bounds_check
        if this.has_default_value(declaration)
            set allow_missing: true
        if allow_missing
            set access_flags: access_flags | AccessFlagsAllowMissing
        var t: ref[Type]? null
        let pk AstNode.kind_of(pattern)
        if pk = KindObjectBindingPattern
        {
            if AstNode.dot_dot_dot_token_of(declaration) <> null
            {
                ; ── the object binding pattern's REST (slice 145) ────────────
                ;
                ; ★★ THE REDUCTION IS NOT COSMETIC AND IT HAPPENS BEFORE THE GUARD:
                ; getReducedType removes the never-valued discriminant members, so a
                ; union whose every constituent is empty after reduction is what the
                ; TS2700 guard is actually asked about. Asking isValidSpreadType of
                ; the unreduced type would accept sources the reference rejects.
                ;
                ; ★ The omitted names are the pattern's OTHER elements, taken through
                ; PropertyNameOrName so that `{ p: q, ...rest }` omits `p` and not
                ; `q` — the same accessor the non-rest arm below uses.
                let reduced this.get_reduced_type(parent_type)
                if this.unported_mark() <> mark
                    return null
                if reduced = null
                    return null
                set parent_type: reduced as ref[Type]
                var invalid (parent_type.flags & TypeFlagsUnknown) <> 0
                if invalid = false
                {
                    if this.is_valid_spread_type(parent_type) = false
                        set invalid: true
                }
                if this.unported_mark() <> mark
                    return null
                if invalid
                {
                    this.error_on_node(declaration, DiagRest_types_may_only_be_created_from_object_types)
                    return error_type
                }
                let literal_members &Array[ref[AstNode]?]^host()
                let pattern_elements AstNode.elements_of(pattern)
                if pattern_elements <> null
                {
                    let plist pattern_elements as ref[Array[ref[AstNode]?]]
                    let pn plist.get_length() as int
                    var i 0
                    while i < pn
                    {
                        let row plist[i]
                        set i: i + 1
                        if row = null
                            continue
                        if AstNode.dot_dot_dot_token_of(row as ref[AstNode]) <> null
                            continue
                        literal_members.add(Checker.property_name_or_name_of(row as ref[AstNode]))
                    }
                }
                let rest this.get_rest_type(parent_type, literal_members as ref[Array[ref[AstNode]?]]?, this.get_symbol_of_declaration(declaration))
                if this.unported_mark() <> mark
                    return null
                if rest = null
                    return null
                set t: rest
            }
            else
            {
                ; "Use explicitly specified property name ({ p: xxx } form), or
                ; otherwise the implied name ({ p } form)."
                let name Checker.property_name_or_name_of(declaration)
                if name = null
                    return null
                let index_type this.get_literal_type_from_property_name(name as ref[AstNode])
                if this.unported_mark() <> mark
                    return null
                if index_type = null
                    return null
                let declared_type this.get_indexed_access_type_ex(parent_type, index_type as ref[Type], access_flags, name, null)
                if this.unported_mark() <> mark
                    return null
                if declared_type = null
                    return null
                set t: this.get_flow_type_of_destructuring(declaration, declared_type as ref[Type])
                if this.unported_mark() <> mark
                    return null
            }
        }
        else
        {
            ; ── the ARRAY pattern (slice 128) ────────────────────────────────
            ;
            ; ★★ THE FIRST STATEMENT IS THE ITERATION QUESTION AND IT RUNS EVEN
            ; WHERE ITS ANSWER IS UNUSED, because the reference's own comment says
            ; what it is for: *"This call also checks that the parentType is in
            ; fact an iterable or array (depending on target language)"* — the
            ; array-like arm below reports nothing about iterability, so removing
            ; the call would drop TS2461/TS2488 for every destructuring.
            ;
            ; ★★ PossiblyOutOfBounds IS OFF FOR A REST ELEMENT and on for every
            ; other, which is what makes `const [a] = xs` include `undefined`
            ; under noUncheckedIndexedAccess while `const [...r] = xs` does not.
            var iteration_use IterationUseDestructuring
            if AstNode.dot_dot_dot_token_of(declaration) = null
                set iteration_use: IterationUseDestructuring | IterationUsePossiblyOutOfBounds
            let element_type this.check_iterated_type_or_element_type(iteration_use, parent_type as ref[Type], undefined_type, pattern)
            if this.unported_mark() <> mark
                return null
            let index Checker.index_in_list(AstNode.elements_of(pattern), declaration)
            if AstNode.dot_dot_dot_token_of(declaration) <> null
            {
                ; The REST element: *if the parent is a tuple type, the rest element
                ; has a tuple type of the remaining tuple element types* — asked of
                ; the BASE CONSTRAINT of each instantiable constituent (`singletons[i]`
                ; with `i: N` is `["a"][][N]`, whose constraint is the tuple; slice
                ; 203, `spreadTupleAccessedByTypeParameter`) and answered per
                ; constituent; anything else is `createArrayType(elementType)`.
                let base_constraint this.map_parent_to_base_constraint(parent_type as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if base_constraint = null
                    return null
                let bc base_constraint as ref[Type]
                if this.every_type_is_tuple(bc)
                {
                    if (bc.flags & TypeFlagsUnion) = 0
                        return this.slice_tuple_type(bc, index, 0)
                    let members Checker.union_types_of(bc)
                    if members = null
                        return null
                    let ml members as ref[Array[ref[Type]?]]
                    let mn ml.get_length() as int
                    let slices &Array[ref[Type]?]()
                    var mi 0
                    while mi < mn
                    {
                        let row ml[mi]
                        set mi: mi + 1
                        if row = null
                            continue
                        let sliced this.slice_tuple_type(row as ref[Type], index, 0)
                        if this.unported_mark() <> mark
                            return null
                        if sliced = null
                            return null
                        slices.add(sliced)
                    }
                    return this.get_union_type(slices)
                }
                return this.create_array_type(element_type)
            }
            if this.is_array_like_type(parent_type as ref[Type])
            {
                if this.unported_mark() <> mark
                    return null
                ; ★★★ `index as u64` STOOD HERE AND IT IS A LIVE DEFECT, RIGHT
                ; AT ZERO AND WRONG EVERYWHERE ELSE: this takes a jsnum BIT
                ; PATTERN, and the integer 1 read as one is the denormal 5e-324.
                ; So `var [a] = t` was correct — +0.0 has the bit pattern 0 — and
                ; `var [a, b] = t` looked up a property named `5e-324`, found
                ; none, and fell into the tuple arm. It was invisible while that
                ; arm was a stop; slice 142 ported the arm and the fixture
                ; `checker_type_of_node_binding.ts` reported TS2493 on `b`. Every
                ; other one of this function's thirteen call sites already went
                ; through `number_bits_from_int` or `jsnum_from_int`.
                let index_type this.get_number_literal_type(jsnum_from_int(index))
                var declared this.get_indexed_access_type_or_undefined(parent_type as ref[Type], index_type, access_flags, AstNode.name_of(declaration), null)
                if this.unported_mark() <> mark
                    return null
                if declared = null
                    set declared: error_type
                set t: this.get_flow_type_of_destructuring(declaration, declared as ref[Type])
                if this.unported_mark() <> mark
                    return null
            }
            else
            {
                if this.unported_mark() <> mark
                    return null
                set t: element_type
            }
        }
        if t = null
            return null
        if AstNode.initializer_of(declaration) = null
            return t
        let root Checker.walk_up_binding_elements_and_patterns(declaration)
        var root_annotated false
        if root <> null
        {
            if AstNode.type_of(root as ref[AstNode]) <> null
                set root_annotated: true
        }
        if root_annotated
        {
            ; "In strict null checking mode, if a default value of a non-undefined
            ; type is specified, remove undefined from the final type."
            if Checker.strict_null_checks()
            {
                let init_type this.check_declaration_initializer(declaration, CheckModeNormal, null)
                if this.unported_mark() <> mark
                    return null
                if init_type = null
                    return null
                if this.has_type_facts(init_type as ref[Type], TypeFactsIsUndefined) = false
                    return this.get_non_undefined_type(t as ref[Type])
            }
            return t
        }
        let nu this.get_non_undefined_type(t as ref[Type])
        if this.unported_mark() <> mark
            return null
        if nu = null
            return null
        let init_type this.check_declaration_initializer(declaration, CheckModeNormal, null)
        if this.unported_mark() <> mark
            return null
        if init_type = null
            return null
        let pair &Array[ref[Type]?]()
        pair.add(nu)
        pair.add(init_type)
        let widened_source this.get_union_type_ex(pair, UnionReductionSubtype, null, null)
        if this.unported_mark() <> mark
            return null
        if widened_source = null
            return null
        this.widen_type_inferred_from_initializer(declaration, widened_source)
    }

    ; ── the OBJECT REST type (slice 145) ─────────────────────────────────────
    ;
    ; getRestType — what `{a, ...rest} = o` gives `rest`, and what the object
    ; BINDING pattern's `...rest` gives too. Two call sites, one function, and it
    ; was two rows on the frontier (`get-rest-type` and the assignment chapter's).
    ;
    ; ★★★ THE ANSWER IS A DIFFERENT KIND OF TYPE ON EACH SIDE OF ONE TEST, and the
    ; test is `isGenericObjectType(source) || isGenericIndexType(omitKeyType)`. For a
    ; CONCRETE source it builds an anonymous type out of the spreadable properties
    ; — a real member table, flagged ObjectRestType. For a GENERIC one it cannot
    ; enumerate anything, so it hands back `Omit<Source, Keys>` from the global
    ; type alias and lets instantiation do the work later. A port that built only
    ; the first would answer a member-less object for every generic rest.
    ;
    ; ★★ THE UNSPREADABLE PROPERTIES ARE ADDED TO THE OMIT KEY ONLY ON THE GENERIC
    ; PATH, and the reference says why: *if the type we're spreading from has
    ; properties that cannot be spread into the rest type (e.g. getters, methods),
    ; ensure they are explicitly omitted, as they would in the non-generic case.*
    ; On the concrete path they are omitted by construction — they never enter the
    ; member table — so the same effect needs no key.
    ;
    ; ★ The head filter is the reference's `filterType(source, t.flags&Nullable == 0)`
    ; and filter_type_outside_flags is that predicate: for any constituent a
    ; nullable flag is the WHOLE of its flags, so *has no nullable flag* and *has a
    ; flag outside the nullable mask* pick the same constituents.
    procedure get_rest_type(this, source_in: ref[Type], properties: ref[Array[ref[AstNode]?]]?, symbol: ref[Symbol]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let filtered this.filter_type_outside_flags(source_in, TypeFlagsNullable)
        if this.unported_mark() <> mark
            return null
        if filtered = null
            return null
        let source filtered as ref[Type]
        if (source.flags & TypeFlagsNever) <> 0
            return empty_object_type
        if (source.flags & TypeFlagsUnion) <> 0
        {
            var a_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, 0, 0, 0, 0, 0, null, properties, symbol, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
            let a &a_value as ref[MapTypeArgs]?
            return this.map_type(source, MapTypeKindRestType, a)
        }
        ; `getUnionType(core.Map(properties, c.getLiteralTypeFromPropertyName))` —
        ; the properties are NAME nodes on both call sites.
        let omit_names &Array[ref[Type]?]()
        if properties <> null
        {
            let plist properties as ref[Array[ref[AstNode]?]]
            let pn plist.get_length() as int
            var i 0
            while i < pn
            {
                let row plist[i]
                set i: i + 1
                if row = null
                    continue
                let lit this.get_literal_type_from_property_name(row as ref[AstNode])
                if this.unported_mark() <> mark
                    return null
                if lit = null
                    return null
                omit_names.add(lit)
            }
        }
        var omit_key_type this.get_union_type(omit_names)
        if this.unported_mark() <> mark
            return null
        if omit_key_type = null
            return null
        let spreadable &Array[ref[Symbol]?]()
        let unspreadable_keys &Array[ref[Type]?]()
        let props this.get_properties_of_type(source)
        if this.unported_mark() <> mark
            return null
        var i 0
        while i < Checker.symbol_count(props)
        {
            let row (props as ref[Array[ref[Symbol]?]])[i]
            set i: i + 1
            if row = null
                continue
            let prop row as ref[Symbol]
            let literal this.get_literal_type_from_property(prop, TypeFlagsStringOrNumberLiteralOrUnique, false)
            if this.unported_mark() <> mark
                return null
            if literal = null
                return null
            let lt literal as ref[Type]
            var keep false
            if this.is_type_assignable_to(lt, omit_key_type as ref[Type]) = false
            {
                if (this.get_declaration_modifier_flags_from_symbol(prop) & (ModifierFlagsPrivate | ModifierFlagsProtected)) = 0
                {
                    if this.is_spreadable_property(prop)
                        set keep: true
                }
            }
            if this.unported_mark() <> mark
                return null
            if keep
                spreadable.add(row)
            else
                unspreadable_keys.add(literal)
        }
        var generic this.is_generic_object_type(source)
        if generic = false
            set generic: this.is_generic_index_type(omit_key_type as ref[Type])
        if this.unported_mark() <> mark
            return null
        if generic
        {
            if (unspreadable_keys.get_length() as int) <> 0
            {
                let widened &Array[ref[Type]?]()
                widened.add(omit_key_type)
                let un unspreadable_keys.get_length() as int
                var j 0
                while j < un
                {
                    widened.add(unspreadable_keys[j])
                    set j: j + 1
                }
                set omit_key_type: this.get_union_type(widened)
                if this.unported_mark() <> mark
                    return null
                if omit_key_type = null
                    return null
            }
            if ((omit_key_type as ref[Type]).flags & TypeFlagsNever) <> 0
                return source
            let omit_alias this.get_global_omit_symbol()
            if this.unported_mark() <> mark
                return null
            if omit_alias = null
                return error_type
            let args this.new_type_list_of(2)
            args.add(source)
            args.add(omit_key_type)
            return this.get_type_alias_instantiation(omit_alias as ref[Symbol], args, null)
        }
        let members SymbolTable.create(host)
        let sn spreadable.get_length() as int
        var k 0
        while k < sn
        {
            let row spreadable[k]
            set k: k + 1
            if row = null
                continue
            let prop row as ref[Symbol]
            let sp this.get_spread_symbol(prop, false)
            if this.unported_mark() <> mark
                return null
            if sp = null
                return null
            SymbolTable.set_entry(host, members, Symbol.name_of(prop), sp as ref[Symbol])
        }
        let infos this.get_index_infos_of_type(source)
        if this.unported_mark() <> mark
            return null
        let result this.new_anonymous_type(symbol, members, null, null, infos)
        if this.unported_mark() <> mark
            return null
        if result = null
            return null
        let r result as ref[Type]
        set r.object_flags: r.object_flags | ObjectFlagsObjectRestType
        r
    }

    ; getGlobalOmitSymbol — `Omit<T, K>`, the two-parameter alias every generic
    ; object rest is expressed through. ★It answers NULL where the lib does not
    ; declare it, and getRestType turns that into `error_type` rather than into a
    ; report: the reference does the same, because a missing `Omit` has already been
    ; reported by the global-type resolution itself.
    procedure get_global_omit_symbol(this) returns ref[Symbol]?
    {
        this.report_checked_global_type_alias("Omit", 2)
        this.get_global_type_alias_symbol("Omit", 2)
    }

    ; isValidSpreadType — the object BINDING pattern's rest guard (slice 145).
    ; ★★ THE UNION ARM RECURSES ON THE FILTERED TYPE'S OWN CONSTITUENTS and not on
    ; the argument's, which matters because the head has already mapped every
    ; constituent to its base constraint and removed the definitely-falsy ones: the
    ; question is about what the spread would actually see.
    procedure is_valid_spread_type(this, t: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        let based this.map_type(t, MapTypeKindBaseConstraintOrType, null)
        if this.unported_mark() <> mark
            return false
        if based = null
            return false
        let cleaned this.remove_definitely_falsy_types(based as ref[Type])
        if this.unported_mark() <> mark
            return false
        if cleaned = null
            return false
        let sv cleaned as ref[Type]
        if (sv.flags & (TypeFlagsAny | TypeFlagsNonPrimitive | TypeFlagsObject | TypeFlagsInstantiableNonPrimitive)) <> 0
            return true
        if (sv.flags & TypeFlagsUnionOrIntersection) = 0
            return false
        let types Checker.union_or_intersection_types_of(sv)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if this.is_valid_spread_type(row as ref[Type]) = false
                return false
            if this.unported_mark() <> mark
                return false
        }
        true
    }

    ; ── the destructuring's FLOW type (slice 117) ────────────────────────────
    ;
    ; ★★★ THE REFERENCE SYNTHESIZES `obj["x"]` SO THAT THE FLOW ANALYSER DOES NOT
    ; HAVE TO KNOW THE FIVE DESTRUCTURING FORMS, and this port can do it since
    ; slice 94 built new_synthetic_node for checkPropertyInitialization. What it
    ; owes on top of that node is the ELEMENT-ACCESS half of two flow predicates:
    ; get_accessed_property_name's element arm and is_matching_reference's element
    ; SOURCE arm — both of which slice 94 left as stops with the note that they had
    ; no producer, and this is the producer.
    procedure get_flow_type_of_destructuring(this, node: ref[AstNode], declared_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let reference this.get_synthetic_element_access(node)
        if this.unported_mark() <> mark
            return null
        if reference = null
            return declared_type
        this.get_flow_type_of_reference(reference as ref[AstNode], declared_type)
    }

    ; getParentElementAccess.
    procedure get_parent_element_access(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let parent AstNode.parent_node_of(node)
        if parent = null
            return null
        let ancestor_opt AstNode.parent_node_of(parent as ref[AstNode])
        if ancestor_opt = null
            return null
        let ancestor ancestor_opt as ref[AstNode]
        let k AstNode.kind_of(ancestor)
        if k = KindBindingElement
            return this.get_synthetic_element_access(ancestor)
        if k = KindPropertyAssignment
            return this.get_synthetic_element_access(ancestor)
        if k = KindArrayLiteralExpression
            return this.get_synthetic_element_access(parent as ref[AstNode])
        if k = KindVariableDeclaration
            return AstNode.initializer_of(ancestor)
        if k = KindBinaryExpression
            return AstNode.binary_right_of(ancestor)
        null
    }

    ; getDestructuringPropertyName, in this file's (data, len) shape. ★The ARRAY
    ; arm's name is the element's INDEX rendered as decimal, which needs storage the
    ; caller owns — the same buffer discipline get_property_name_from_type uses.
    procedure get_destructuring_property_name(this, node: ref[AstNode], buf: Slice[char]) returns Slice[char]
    {
        let parent_opt AstNode.parent_node_of(node)
        if parent_opt = null
        {
            return Slice[char]()
        }
        let parent parent_opt as ref[AstNode]
        let pk AstNode.kind_of(parent)
        let k AstNode.kind_of(node)
        if k = KindBindingElement
        {
            if pk = KindObjectBindingPattern
            {
                let pn Checker.property_name_or_name_of(node)
                if pn = null
                {
                    return Slice[char]()
                }
                return this.get_literal_property_name_text(pn as ref[AstNode])
            }
        }
        if k = KindPropertyAssignment
            return this.get_literal_property_name_text(AstNode.name_of(node))
        if k = KindShorthandPropertyAssignment
            return this.get_literal_property_name_text(AstNode.name_of(node))
        var indexed false
        if pk = KindArrayLiteralExpression
            set indexed: true
        if pk = KindArrayBindingPattern
            set indexed: true
        if indexed
        {
            let elements AstNode.elements_of(parent)
            let n AstNode.list_count(elements)
            var i 0
            while i < n
            {
                if AstNode.child_in_list(elements, i) = node
                {
                    let out_n jsnum_to_string(jsnum_from_int(i), buf)
                    return buf.subslice(0, out_n as size_t)
                }
                set i: i + 1
            }
        }
        Slice[char]()
    }

    ; getLiteralPropertyNameText — getLiteralTypeFromPropertyName, then the name off
    ; the resulting literal type. ★It goes through the TYPE rather than through the
    ; node's text because a computed name whose expression is a literal has a text
    ; the node itself does not carry.
    procedure get_literal_property_name_text(this, name: ref[AstNode]?) returns Slice[char]
    {
        if name = null
        {
            return Slice[char]()
        }
        let mark this.unported_mark()
        let t this.get_literal_type_from_property_name(name as ref[AstNode])
        if this.unported_mark() <> mark
        {
            return Slice[char]()
        }
        if t = null
        {
            return Slice[char]()
        }
        let ty t as ref[Type]
        if Checker.is_type_usable_as_property_name(ty) = false
        {
            return Slice[char]()
        }
        ; ★★★ THE BUFFER IS ON THE CHECKER'S PAGE AND IT USED TO BE ON THIS FRAME —
        ; a dangling read, found by slice 179 giving this function a second caller.
        ; get_property_name_from_type's number arm writes the decimal INTO the
        ; buffer and returns a view of it (the string-literal and unique-symbol arms
        ; return page-resident text, which is why the frame buffer survived every
        ; test): so for `const { 0: a } = o` the answer pointed into `nb` after the
        ; return. **A caller-owns-the-buffer rule is safe only where the caller
        ; OUTLIVES the answer, and a function that RETURNS the view is not that
        ; caller** — get_property_name_from_type's own callers declare the array
        ; because they read it before returning; this one hands it upward.
        let nb host.allocate(JSNUM_MAX_TEXT as size_t, 1) as pointer[char]
        this.get_property_name_from_type(ty, Slice[char](JSNUM_MAX_TEXT as size_t, nb))
    }

    ; getSyntheticElementAccess, whole (the parenthesis arm since slice 202).
    procedure get_synthetic_element_access(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let mark this.unported_mark()
        let parent_access this.get_parent_element_access(node)
        if this.unported_mark() <> mark
            return null
        if parent_access = null
            return null
        let pa parent_access as ref[AstNode]
        let flow Checker.get_flow_node_of_node(pa)
        if flow = null
            return null
        var nb char[JSNUM_MAX_TEXT]
        let name_data this.get_destructuring_property_name(node, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if this.unported_mark() <> mark
            return null
        if name_data.data = null
            return null
        ; A parent access that is not a left-hand-side expression is WRAPPED, as
        ; the reference wraps it; is_matching_reference walks through the
        ; parenthesis (slice 202, `destructuringControlFlowNoCrash`).
        var lhs: ref[AstNode] pa
        if Binder.is_left_hand_side_expression(pa) = false
        {
            let wrapped this.new_synthetic_node(KindParenthesizedExpression, NodeData.ParenthesizedExpression(WrappedTypeData(pa)))
            set wrapped.pos: (AstNode.pos_of(node)) as i32
            set wrapped.end: (AstNode.end_of(node)) as i32
            set lhs: wrapped
        }
        ; The literal's text is COPIED onto the checker's page: `nb` is a stack
        ; buffer for the array arm, and the node outlives this frame.
        let text_data host.allocate((name_data.length as size_t) + 1, 1 as size_t) as pointer[char]
        var ci 0
        while ci < name_data.length
        {
            set *(text_data + (ci as size_t)): name_data[(ci as size_t)]
            set ci: ci + 1
        }
        set *(text_data + (name_data.length as size_t)): 0 as char
        let literal this.new_synthetic_node(KindStringLiteral, NodeData.StringLiteral(LiteralData(Slice[char](name_data.length, text_data), TokenFlagsNone)))
        set literal.pos: (AstNode.pos_of(node)) as i32
        set literal.end: (AstNode.end_of(node)) as i32
        let result this.new_synthetic_node(KindElementAccessExpression, NodeData.ElementAccessExpression(ElementAccessData(lhs, null, literal)))
        set result.pos: (AstNode.pos_of(node)) as i32
        set result.end: (AstNode.end_of(node)) as i32
        set literal.parent: result
        set result.parent: node
        if lhs <> pa
            set lhs.parent: result
        set result.flow_node: flow
        result
    }

    ; ── slice 72: the declaration's INITIALIZER ──────────────────────────────
    ;
    ; checkDeclarationInitializer and the widening in front of it. The work list's
    ; head — `check-declaration-initializer`, 202 units at stage 1 — is ONE
    ; statement of getTypeOfVariableOrParameterOrPropertyWorker:
    ;
    ;   t := c.widenTypeInferredFromInitializer(declaration,
    ;            c.checkDeclarationInitializer(declaration, checkMode, nil))
    ;   return c.addOptionalityEx(t, isProperty, isOptional)
    ;
    ; and both halves of it are this slice. What it buys is the type of `let x = e`
    ; for every `e` slice 71 gave a type to, and what it costs is the widening
    ; decision on top: a literal type is FRESH out of the expression dispatch, and
    ; a non-const declaration widens it back to its base type. So `let s = "a"` is
    ; `string`, `const s = "a"` is `"a"`, and the difference is one bit read off
    ; the declaration.
    ;
    ; ★★★ THIS IS WHERE SLICE 71's DEFERRED PAIR HALF EXPIRES, and only half.
    ; That slice stored `regular_type` and `fresh_type` on a literal type and wrote
    ; down that neither getRegularTypeOfLiteralType nor isFreshLiteralType was
    ; ported, both being "behind the same door". getWidenedLiteralType is that
    ; door, and it opens for exactly ONE of them: it asks isFreshLiteralType five
    ; times and never asks getRegularTypeOfLiteralType at all. ★So `fresh_type`
    ; gains its second reader here and `regular_type` still has NONE — its only
    ; reader in the whole reference is getRegularTypeOfLiteralType, whose own only
    ; callers are getRegularTypeOfExpression and getBaseTypeOfLiteralType. The
    ; phantom-row argument for leaving that function out therefore still holds, and
    ; the field's note is corrected rather than retired.
    ;
    ; ★★ AND SLICE 71's ATTRIBUTION OF THE TWO SLOTS WAS WRONG BY ONE, which is
    ; only visible from here: it wrote that `regular_type` is read by
    ; getRegularTypeOfLiteralType AND isFreshLiteralType. isFreshLiteralType is
    ; `t.flags&Freshable != 0 && t.AsLiteralType().freshType == t` — it reads
    ; `freshType`. A slot's reader list is the kind of claim that reads as checked
    ; and is not, so it is fixed at the field.

    ; checkDeclarationInitializer, whole — the two padding arms included, each as
    ; the gate it is rather than as a comment.
    ;
    ; ★★★ THE checkMode PARAMETER IS CARRIED HERE AND THROUGH
    ; getTypeForVariableLikeDeclaration, WHICH IS A REVERSAL, and §3.5ar is the
    ; reason. Slice 69's header left it out with an argument that was true then:
    ; *"its two readers upstream are checkExpressionEx on a for-in right-hand side
    ; and checkDeclarationInitializer, and both are stops in this slice — so the
    ; parameter would be a claim about a signature nothing can exercise."* One of
    ; the two readers is this function. Leaving the parameter out now would not
    ; leave a claim behind, it would FOLD A CONSTANT: every call would pass Normal
    ; because that is all the port has, and §3.5ar's second half is precisely the
    ; measurement that a folded constant leaves nothing to grep and no comment to
    ; expire. ★The non-Normal producer is still exactly one and still a stop —
    ; getTypeForBindingElementParent passes CheckModeRestBindingElement for a rest
    ; binding element — so nothing OBSERVABLE changes; the signature now matches
    ; the reference's and the day that stop lifts, the value flows on its own.
    ;
    ; ★★ THE CONTEXTUAL BRANCH IS A STOP AND ITS ARGUMENT IS ITS OWN CALLER LIST:
    ; every one of the reference's five other callers passes nil for contextualType
    ; except getTypeFromBindingElement, which is behind `get-type-from-binding-
    ; pattern`. So the parameter is carried, the branch is transcribed, and the
    ; report names checkExpressionWithContextualType rather than pretending the
    ; null path is the whole function.
    ;
    ; ★★★ THE TUPLE PADDING ARM WENT LIVE IN SLICE 115 AND THE NOTE PREDICTED IT
    ; EXACTLY: *"the producers are checkObjectLiteral and createTupleType, both a
    ; dimension away — so the slice that gives either flag a producer meets a report
    ; instead of a silently skipped step"*. createTupleType is this slice, and the
    ; `pad-tuple-type` report is now REACHED rather than proved inert. It stays a
    ; report: padTupleType is the SYNTHETIC-ELEMENT path (a binding pattern with
    ; more names than the tuple has elements), which needs a type per missing
    ; element and the missing type itself. ★The OBJECT-LITERAL half is still inert
    ; and still written, on the same argument as before.
    procedure check_declaration_initializer(this, declaration: ref[AstNode], check_mode: int, contextual_type: ref[Type]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let initializer AstNode.initializer_of(declaration)
        if initializer = null
            return null
        ; ★`init` is a reserved word here (§3.5d's family), so the local is named
        ; for what it is rather than for the reference's `initializer`.
        let expr initializer as ref[AstNode]
        var t this.get_quick_type_of_expression(expr)
        if this.unported_mark() <> mark
            return null
        if t = null
        {
            if contextual_type <> null
            {
                ; ★★★ SLICE 165 — the note that stood here read *checkExpression-
                ; WithContextualType — pushContextualType, the inference context and
                ; a checkExpressionEx under CheckModeContextual*, all three of which
                ; this file has had since slice 119 wrote the four-argument form. The
                ; `null` inference context is the reference's own argument here.
                set t: this.check_expression_with_contextual_type_ex(expr, contextual_type as ref[Type], null, check_mode)
                if this.unported_mark() <> mark
                    return null
                if t = null
                    return null
            }
            ; The reference's `else`, spelled as the no-else `if` this file uses:
            ; the branch above returns rather than falling through, so `t` is still
            ; null here only when there was no contextual type.
            if t = null
            {
                set t: this.check_expression_cached_ex(expr, check_mode)
                if t = null
                    return null
            }
        }
        let ty t as ref[Type]
        if Binder.is_part_of_parameter_declaration(declaration)
        {
            let name AstNode.name_of(declaration)
            let nk Checker.kind_or_unknown(name)
            if nk = KindObjectBindingPattern
            {
                if Checker.is_object_literal_type(ty)
                    return this.pad_object_literal_type(ty, name as ref[AstNode])
            }
            if nk = KindArrayBindingPattern
            {
                if Checker.is_tuple_type(ty)
                    return this.pad_tuple_type(ty, name as ref[AstNode])
            }
        }
        ty
    }

    ; isObjectLiteralType and isTupleType, both one line. ★The sentence that stood
    ; here called them *both false today*; the header above already records that
    ; slice 115 gave the tuple half a producer, and slice 175 gave both of them a
    ; reader — the two padders below.
    function is_object_literal_type(t: ref[Type]) returns bool
        (t.object_flags & ObjectFlagsObjectLiteral) <> 0

    function is_tuple_type(t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return false
        ; `t.Target()` is the reference's target slot. ★★★BOTH CONJUNCTS ARE LIVE
        ; SINCE SLICE 115 — the sentence that stood here (*"this conjunct is the live
        ; one and the tuple bit is what cannot be set"*) named createTupleType as its
        ; expiry, and that is the slice.
        let target Checker.target_of(t)
        if target = null
            return false
        ((target as ref[Type]).object_flags & ObjectFlagsTuple) <> 0
    }

    ; getPropertyNameFromBindingElement. ★The reference answers
    ; InternalSymbolNameMissing where the name is not usable as one; this port's
    ; spelling for that is a slice with a NULL data pointer, which is what every
    ; text-answering function in this file returns for *no name* — and the NUMERIC
    ; arm needs the caller's buffer, for the reason get_property_name_from_type's
    ; own header gives.
    procedure get_property_name_from_binding_element(this, e: ref[AstNode], buf: Slice[char]) returns Slice[char]
    {
        let mark this.unported_mark()
        let name Checker.property_name_or_name_of(e)
        if name = null
            return Slice[char]()
        let expr_type this.get_literal_type_from_property_name(name as ref[AstNode])
        if this.unported_mark() <> mark
            return Slice[char]()
        if expr_type = null
            return Slice[char]()
        let et expr_type as ref[Type]
        if Checker.is_type_usable_as_property_name(et) = false
            return Slice[char]()
        this.get_property_name_from_type(et, buf)
    }

    ; padObjectLiteralType — the SYNTHETIC-MEMBER path: a binding pattern naming a
    ; property the inferred object literal does not have, where the name carries a
    ; DEFAULT, gets an optional member of the default's type. Its shape is
    ; get_type_from_object_binding_pattern's, which is the one other producer of a
    ; symbol table out of a pattern in this file.
    ;
    ; ★ THE NAME IS COPIED TO THE PAGE and the numeric buffer is not the storage: a
    ; symbol name outlives the call by definition, and copy_name_to_page is what
    ; every other symbol minted here goes through.
    procedure pad_object_literal_type(this, t: ref[Type], pattern: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let elements AstNode.elements_of(pattern)
        let count AstNode.list_count(elements)
        let missing this.new_node_list()
        var i 0
        while i < count
        {
            let row AstNode.child_in_list(elements, i)
            set i: i + 1
            if row = null
                continue
            let e row as ref[AstNode]
            if AstNode.initializer_of(e) = null
                continue
            var nb char[JSNUM_MAX_TEXT]
            let nd this.get_property_name_from_binding_element(e, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
            if this.unported_mark() <> mark
                return null
            if nd.data = null
                continue
            let prop this.get_property_of_type(t, nd)
            if this.unported_mark() <> mark
                return null
            if prop = null
                missing.add(e)
        }
        if missing.get_length() = 0
            return t
        let members SymbolTable.create(host)
        let props this.get_properties_of_object_type(t)
        if this.unported_mark() <> mark
            return null
        if props <> null
        {
            let list props as ref[Array[ref[Symbol]?]]
            let pn list.get_length() as int
            var j 0
            while j < pn
            {
                let row list[j]
                set j: j + 1
                if row = null
                    continue
                let prop row as ref[Symbol]
                SymbolTable.set_entry(host, members, Symbol.name_of(prop), prop)
            }
        }
        let mn missing.get_length() as int
        var k 0
        while k < mn
        {
            let row missing[k]
            set k: k + 1
            if row = null
                continue
            let e row as ref[AstNode]
            var mb char[JSNUM_MAX_TEXT]
            let nd this.get_property_name_from_binding_element(e, Slice[char](JSNUM_MAX_TEXT as size_t, &mb[0]))
            if this.unported_mark() <> mark
                return null
            if nd.data = null
                return null
            let name_data this.copy_name_to_page(nd)
            let symbol this.new_symbol(SymbolFlagsProperty | SymbolFlagsOptional, name_data)
            let element_type this.get_type_from_binding_element(e, false, false)
            if this.unported_mark() <> mark
                return null
            set this.value_symbol_link_of(symbol).resolved_type: element_type
            SymbolTable.set_entry(host, members, name_data, symbol)
        }
        let infos this.get_index_infos_of_type(t)
        if this.unported_mark() <> mark
            return null
        let made this.new_anonymous_type(t.symbol, members, null, null, infos)
        if made = null
            return null
        let result made as ref[Type]
        set result.object_flags: t.object_flags
        result
    }

    ; padTupleType — the same step for an ARRAY pattern: every name past the
    ; tuple's arity becomes an OPTIONAL element, of the default's type where there
    ; is one and `any` (with the implicit-any report) where there is not.
    ;
    ; ★★★ BOTH LISTS ARE CLONED AND THAT IS NOT A CONVENIENCE. get_element_types
    ; answers the STORED type-argument list wherever its length already equals the
    ; arity, so appending to it would grow the tuple TARGET's own arguments —
    ; `slices.Clone` in the reference is load-bearing for the same reason.
    procedure pad_tuple_type(this, t: ref[Type], pattern: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        ; ★★★ EVERY `TargetTupleType()` READ IS ON THE TARGET AND NOT ON `t`, and the
        ; first draft asked `t` for all three. The accessors answer their NEUTRAL
        ; value for a non-target — infos `null`, combined flags `None`, readonly
        ; `false` — so nothing failed: the info clone came out EMPTY and
        ; `f([x, y] = [1])` answered `[(number | undefined)?]` where the reference
        ; answers `[number, any?]`, because create_tuple_type_ex takes the ARITY from
        ; the infos and there was one info for two element types.
        let target Checker.target_of(t)
        if target = null
            return t
        let tt target as ref[Type]
        if (Checker.tuple_combined_flags_of(tt) & ElementFlagsVariable) <> 0
            return t
        let elements AstNode.elements_of(pattern)
        let pattern_count AstNode.list_count(elements)
        let arity Checker.get_type_reference_arity(t)
        if arity >= pattern_count
            return t
        ; ★★★ A NULL HERE IS AN EMPTY LIST AND NOT A FAILURE, and reading it as one
        ; cost the whole function: `f([x, y] = [])` pads the EMPTY tuple, whose
        ; element list is empty — the first draft returned null on it, the caller
        ; read the mark (unmoved), took the null for *no answer* and the parameter
        ; widened to `any` where the reference answers `[any?, any?]`. The mark above
        ; is what separates the two, so after it a null is `slices.Clone(nil)`.
        let src this.get_element_types(t)
        if this.unported_mark() <> mark
            return null
        let element_types this.new_type_list(null)
        if src <> null
        {
            let sl src as ref[Array[ref[Type]?]]
            var i 0
            while i < (sl.get_length() as int)
            {
                element_types.add(sl[i])
                set i: i + 1
            }
        }
        let element_infos &Array[ref[TupleElementInfo]?]^host()
        let src_infos Checker.tuple_element_infos_of(tt)
        if src_infos <> null
        {
            let il src_infos as ref[Array[ref[TupleElementInfo]?]]
            var j 0
            while j < (il.get_length() as int)
            {
                element_infos.add(il[j])
                set j: j + 1
            }
        }
        var k arity
        while k < pattern_count
        {
            let row AstNode.child_in_list(elements, k)
            set k: k + 1
            if row = null
                continue
            let e row as ref[AstNode]
            let ek AstNode.kind_of(e)
            ; `i < len-1 || !(isBindingElement(e) && hasDotDotDotToken(e))` — the
            ; TRAILING rest name is the one element that is not padded, and `k` has
            ; already been advanced, so `k = pattern_count` is *this was the last*.
            var trailing_rest false
            if k = pattern_count
            {
                if ek = KindBindingElement
                {
                    if AstNode.dot_dot_dot_token_of(e) <> null
                        set trailing_rest: true
                }
            }
            if trailing_rest
                continue
            var has_default false
            if ek <> KindOmittedExpression
            {
                if this.has_default_value(e)
                    set has_default: true
            }
            var element_type: ref[Type]? any_type
            if has_default
            {
                set element_type: this.get_type_from_binding_element(e, false, false)
                if this.unported_mark() <> mark
                    return null
            }
            element_types.add(element_type)
            element_infos.add(&TupleElementInfo^host(ElementFlagsOptional, null))
            if ek <> KindOmittedExpression
            {
                if has_default = false
                    this.report_implicit_any(e, any_type, WideningKindNormal)
            }
        }
        this.create_tuple_type_ex(element_types, element_infos, Checker.tuple_readonly_of(tt))
    }

    ; checkExpressionCachedEx.
    ;
    ; ★★★ SLICE 88 IS THE READER SLICE 70 NAMED, AND IT ARRIVED AS A RED DIAGCHECK
    ; RATHER THAN AS A DESIGN STEP. This function's own header carried the sentence
    ; *"a memo's only OBSERVABLE effect on a C section is a diagnostic reported
    ; twice when the same node is checked twice … the first arm that writes an
    ; error into the C section is the arm that owes this function its links
    ; table"* — and the comma operator is that arm. `const comma = (1, 2, 3)`
    ; produced TWO TS2695 per comma against the reference's one, because
    ; check_variable_declaration checks the initializer once through
    ; getTypeOfSymbol and once in its own tail.
    ;
    ; ★★★ AND THE PREDICTION WAS RIGHT ABOUT THE MECHANISM AND WRONG ABOUT WHICH
    ; ARM: it named checkIdentifier's TS2304 as the nearest candidate, and that arm
    ; is still a stop. What made this the one is not that the arm REPORTS but that
    ; it also ANSWERS — the `??` arm of the same slice reports TS5076 and then
    ; stops, its nil makes check_variable_declaration return before the second
    ; check, and it stays single all on its own. **A double needs a diagnostic AND
    ; a non-nil answer on the same node**, which no earlier slice could produce.
    ;
    ; ★★★ A nil IS CACHED THROUGH A SECOND SLOT, AND THE FIRST DRAFT DID NOT DO
    ; THAT — read TypeNodeLink's own note, which carries the measurement. The
    ; reading *upstream nil means not-yet-computed, a stop's nil means no claim, so
    ; recomputing is right under both* is WRONG in its second half: recomputing
    ; re-runs the check, and a check that stopped may have REPORTED on its way to
    ; the stop. It cost two stage-2 units and it is the reason to run stage 2.
    ; ★The price is that the stop LOG counts such a node once where the reference's
    ; walk arrives twice — a number, against a duplicated diagnostic, which is a
    ; hard failure.
    ;
    ; ★★★ THE SAVE/RESTORE IS LIVE SINCE SLICE 141, AND THE NOTE THAT STOOD HERE
    ; NAMED ITS OWN EXPIRY: it read *"neither field exists here — nothing in this
    ; port does flow analysis — so the save/restore is two lines that cannot be
    ; wrong and cannot be right (§3.5be), and the reader that changes that is the
    ; flow-graph dimension, which arrives with both fields."* `flow_type_cache`
    ; arrived in slice 120 and the flow LOOP STACK in 141, so both fields exist and
    ; the reference's own comment is the reason it matters: *when computing a type
    ; that we're going to cache, we need to ignore any ongoing control flow analysis
    ; because variables may have transient types in indeterminable states.* A type
    ; cached on the node under an in-process loop would be one of those transient
    ; answers, kept for good.
    ;
    ; ★ Clearing is a FRESH EMPTY table here where upstream assigns nil, and the
    ; two are the same thing: a nil Go map reads as empty and the first write makes
    ; a new one, which the restore then throws away.
    procedure check_expression_cached_ex(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        if check_mode <> CheckModeNormal
            return this.check_expression_ex(node, check_mode)
        let links this.type_node_link_of(node)
        if links.resolved_type = null
        {
            if links.expression_resolved = false
            {
                let mark this.unported_mark()
                let save_stack flow_loop_stack
                let save_cache flow_type_cache
                set flow_loop_stack: null
                set flow_type_cache: this.new_flow_type_cache()
                set links.resolved_type: this.check_expression_ex(node, check_mode)
                set flow_type_cache: save_cache
                set flow_loop_stack: save_stack
                set links.expression_resolved: true
                if this.unported_mark() <> mark
                    set links.expression_stopped: true
            }
            else
            {
                ; ★★★ A CACHED STOP MUST STILL MOVE THE MARK. Slice 88's second
                ; correction, and the first one caused it: with the nil merely
                ; cached, the SECOND ask returned it without moving
                ; `unported_mark`, so getWidenedTypeForVariableLikeDeclaration's
                ; incompleteness guard read *nothing stopped* and ran on an
                ; incomplete answer — `var co = (3, q); var co: any;` then INVENTED
                ; a TS7005, because a nil that means *the check stopped* had been
                ; handed to a caller that reads nil as *nothing to infer from*. The
                ; replay moves the mark and does not touch the log; the stop it
                ; stands for is already on the work list from the first ask.
                if links.expression_stopped
                    this.replay_stop_mark()
            }
        }
        links.resolved_type
    }

    ; getContextFreeTypeOfExpression — the type of an expression checked with NO
    ; contextual type at all: `anyType` is pushed as the context and the check runs
    ; with CheckModeSkipContextSensitive, so every function expression inside it
    ; answers the context-free shape instead of being contextually typed.
    ;
    ; ★★★ IT IS THE WRITER THAT MADE THE FRONTIER'S LARGEST ROW HOT, and that is
    ; the whole reason this function and the early-out it feeds are in one slice:
    ; until slice 141 the only writers of CheckModeSkipContextSensitive were the
    ; call's argument check and infer_type_arguments (slices 108 and 138), and
    ; checkFunctionExpressionOrObjectLiteralMethod's note still claimed *"CheckMode's
    ; own note says only Normal is ever passed in this port"*.
    ;
    ; ★★ THE POP RUNS ON EVERY PATH, the stop included. The contextual-type stack is
    ; a stack: a push that is not popped because the check underneath it stopped
    ; leaves every later ask reading this node's `any` as its context.
    procedure get_context_free_type_of_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let cached this.context_free_type_lookup(node)
        if cached <> null
            return cached
        this.push_contextual_type(node, any_type, false)
        let t this.check_expression_ex(node, CheckModeSkipContextSensitive)
        if t <> null
            this.context_free_type_put(node, t as ref[Type])
        this.pop_contextual_type()
        t
    }

    ; getQuickTypeOfExpression — "optimize for the common case", five arms over a
    ; parenthesis-stripped expression.
    ;
    ; ★★★ ITS NULL MEANS *NO QUICK ANSWER* AND NOT *I STOPPED*, so this is slice
    ; 69's two-meaning nil again and the caller takes a MARK rather than testing
    ; the value. That is forced rather than chosen: the reference's own answer is
    ; nil for every expression that is none of the five shapes, and
    ; checkDeclarationInitializer's next line depends on telling that apart from a
    ; stop.
    ;
    ; ★★★ THE LAST ARM READS `node` AND EVERY OTHER ARM READS `expr`, and it is the
    ; reference's own asymmetry rather than a transcription slip: `case
    ; ast.IsLiteralExpression(node) || ast.IsBooleanLiteral(node)`. So `("a")` gets
    ; NO quick answer while `"a"` does — both end in the same type through
    ; checkExpressionCached, but only one of them takes this path, and a port that
    ; "fixed" it would answer identically and stop reproducing the reference's
    ; call graph.
    ;
    ; ★★ THE ASSERTION ARM IS LIVE, and it is the only arm here that is not a
    ; literal: `x as string` answers getTypeFromTypeNode of the type node, whose
    ; keyword arms slice 69 ported. `x as const` is excluded by IsConstTypeReference
    ; and falls through to the dispatch, where KindAsExpression reports.
    ;
    ; ★★ THE CALL ARM's FOURTH CONJUNCT IS THE ONLY THING IN THIS FUNCTION THAT
    ; NEEDS A GLOBAL, and it is reported at exactly the term that needs one rather
    ; than in front of the arm: isSymbolOrSymbolForCall is two syntactic tests and
    ; then `globalESSymbol == c.resolveName(left, "Symbol", …)`. A call whose callee
    ; is not the identifier `Symbol` (or `Symbol.for`) fails a syntactic test, so
    ; the term is PROVED false and the arm's own report stands; a call to `Symbol`
    ; cannot be decided here, and the difference matters — the conjunct chooses
    ; between this arm's stop and the dispatch's `check-call-expression`, i.e.
    ; between two rows of the work list.
    procedure get_quick_type_of_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let e Parser.skip_parentheses(node)
        if e = null
            return null
        let expr e as ref[AstNode]
        let ek AstNode.kind_of(expr)
        if ek = KindAwaitExpression
        {
            ; `t := c.getQuickTypeOfExpression(expr.Expression()); if t != nil {
            ; return c.getAwaitedType(t) }; return nil` — the RECURSION is ported
            ; and the awaited type is not, which is what makes the report exact:
            ; only an await whose operand HAS a quick type reaches getAwaitedType,
            ; and the rest answers nothing here and lands on the dispatch's
            ; `check-await-expression`.
            let inner AstNode.expression_of(expr)
            if inner = null
                return null
            let mark this.unported_mark()
            let inner_type this.get_quick_type_of_expression(inner as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if inner_type <> null
                return this.get_awaited_type(inner_type as ref[Type])
            return null
        }
        if ek = KindCallExpression
        {
            ; ★★★ THE ORDER OF THE FOUR CONJUNCTS IS THE REFERENCE'S AND IT IS
            ; LOAD-BEARING SINCE SLICE 146, where it was a set of independent
            ; flags before. Three of them are syntactic and commute; the third —
            ; isSymbolOrSymbolForCall — resolves a NAME, which memoises on the
            ; symbol links, so `&&`'s short-circuit decides whether it runs at
            ; all. It sits after `super`/`require` and before `import`, exactly as
            ; upstream writes it.
            var eligible true
            if Checker.kind_or_unknown(AstNode.expression_of(expr)) = KindSuperKeyword
                set eligible: false
            if eligible
            {
                if Parser.is_require_call(expr, true)
                    set eligible: false
            }
            if eligible
            {
                let sym_mark this.unported_mark()
                if this.is_symbol_or_symbol_for_call(expr)
                    set eligible: false
                if this.unported_mark() <> sym_mark
                    return null
            }
            if eligible
            {
                if Parser.is_import_call(expr)
                    set eligible: false
            }
            if eligible
            {
                ; ★★★ THE FORK IS TWO ROWS AND NOT ONE, AND BOTH ARE WRITTEN SINCE
                ; SLICE 176. Slice 115's stop named five callees the chain half
                ; needs — getOptionalExpressionType, propagateOptionalTypeMarker,
                ; `optionalType`, removeType and getNonNullableType — and said
                ; *"none of which exists here"*; every one of the five has been in
                ; this file for slices (the marker pair since 143). §3.5hd.
                if Checker.is_call_chain(expr)
                    return this.get_return_type_of_single_non_generic_signature_of_call_chain(expr)
                let callee AstNode.expression_of(expr)
                if callee = null
                    return null
                let um1 this.unported_mark()
                let func_type this.check_non_null_expression(callee as ref[AstNode])
                if this.unported_mark() <> um1
                    return null
                if func_type = null
                    return null
                return this.get_return_type_of_single_non_generic_signature(func_type as ref[Type], SignatureKindCall)
            }
        }
        if ek = KindNewExpression
        {
            let callee AstNode.expression_of(expr)
            if callee = null
                return null
            let um2 this.unported_mark()
            let func_type this.check_non_null_expression(callee as ref[AstNode])
            if this.unported_mark() <> um2
                return null
            if func_type = null
                return null
            return this.get_return_type_of_single_non_generic_signature(func_type as ref[Type], SignatureKindConstruct)
        }
        var assertion false
        if ek = KindTypeAssertionExpression
            set assertion: true
        if ek = KindAsExpression
            set assertion: true
        if assertion
        {
            let type_node AstNode.type_of(expr)
            if type_node <> null
            {
                if Parser.is_const_type_reference(type_node) = false
                    return this.get_type_from_type_node(type_node as ref[AstNode])
            }
        }
        ; ★ `node`, not `expr` — see the header.
        let k AstNode.kind_of(node)
        var literal false
        if k >= KindFirstLiteralToken
        {
            if k <= KindLastLiteralToken
                set literal: true
        }
        if k = KindTrueKeyword
            set literal: true
        if k = KindFalseKeyword
            set literal: true
        if literal
            return this.check_expression(node)
        null
    }

    ; getReturnTypeOfSingleNonGenericSignature and getSingleSignature, slice 115 —
    ; the frontier's largest row by UNITS COMPLETED for four slices, and thirty-five
    ; reference lines.
    ;
    ; ★★★ WHAT MAKES IT THE LARGEST ROW IS NOT ITS SIZE BUT ITS POSITION: it is the
    ; fast path getTypeOfExpression and checkDeclarationInitializer take FIRST, so a
    ; unit whose only remaining wall was `let x = f()` stopped here before any of
    ; the call-resolution machinery was reached. The reference's own comment says so
    ; — *"optimize for the common case of a call to a function with a single
    ; non-generic call signature where we can just fetch the return type without
    ; checking the arguments"*.
    ;
    ; ★★ IT ANSWERS nil FOR EVERYTHING IT CANNOT SHORTCUT, and that nil is NOT a
    ; stop: an overloaded callee, a generic one, or a callee whose type carries
    ; properties falls through to the ordinary dispatch. So a null here means *no
    ; quick answer*, which is the two-meaning nil get_quick_type_of_expression's own
    ; header already describes — the caller reads a MARK, not the value.
    procedure get_return_type_of_single_non_generic_signature(this, func_type: ref[Type], kind: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let signature this.get_single_signature(func_type, kind, true)
        if this.unported_mark() <> mark
            return null
        if signature = null
            return null
        let sig signature as ref[Signature]
        if sig.type_parameters <> null
        {
            if (sig.type_parameters as ref[Array[ref[Type]?]]).get_length() <> 0
                return null
        }
        this.get_return_type_of_signature(sig)
    }

    ; getReturnTypeOfSingleNonGenericSignatureOfCallChain (slice 176).
    ;
    ; ★★ THE ARGUMENT OF `propagateOptionalTypeMarker` IS AN IDENTITY TEST AND NOT
    ; A PREDICATE: `nonOptionalType != funcType` is *the chain stripped something*,
    ; which is exactly what getOptionalExpressionType answers by returning its own
    ; argument when the expression is not a chain link. ★The callee is checked with
    ; check_expression here and NOT with check_non_null_expression — the ordinary
    ; arm's non-null check is what the chain replaces.
    procedure get_return_type_of_single_non_generic_signature_of_call_chain(this, expr: ref[AstNode]) returns ref[Type]?
    {
        let callee AstNode.expression_of(expr)
        if callee = null
            return null
        let ce callee as ref[AstNode]
        let mark this.unported_mark()
        let func_type this.check_expression(ce)
        if this.unported_mark() <> mark
            return null
        if func_type = null
            return null
        let ft func_type as ref[Type]
        let non_optional this.get_optional_expression_type(ft, ce)
        if this.unported_mark() <> mark
            return null
        if non_optional = null
            return null
        let return_type this.get_return_type_of_single_non_generic_signature(ft, SignatureKindCall)
        if this.unported_mark() <> mark
            return null
        if return_type = null
            return null
        this.propagate_optional_type_marker(return_type as ref[Type], expr, (non_optional as ref[Type]) <> ft)
    }

    ; getSingleSignature, whole. ★★ `allowMembers` IS THE WHOLE OF THE PROPERTY
    ; TEST: at the one call site above it is TRUE, so a callee type carrying
    ; properties or index signatures still qualifies — the two narrower wrappers
    ; (getSingleCallSignature, getSingleCallOrConstructSignature) pass false and have
    ; no caller here, so they are left out (§3.5be).
    ;
    ; ★ The counting is the point rather than the lookup: EXACTLY ONE signature of
    ; the asked kind and NONE of the other. An overloaded function has two call
    ; signatures and answers nil; a class has one construct signature and no call
    ; signature, which is why `new C()` reaches this at all.
    ; getSingleCallOrConstructSignature — the call signature if there is exactly
    ; one, else the construct one. ★`allowMembers` is FALSE at this call site, so a
    ; type carrying properties beside its one signature answers nothing.
    procedure get_single_call_or_construct_signature(this, t: ref[Type]) returns ref[Signature]?
    {
        let mark this.unported_mark()
        let call_sig this.get_single_signature(t, SignatureKindCall, false)
        if this.unported_mark() <> mark
            return null
        if call_sig <> null
            return call_sig
        this.get_single_signature(t, SignatureKindConstruct, false)
    }

    procedure get_single_signature(this, t: ref[Type], kind: int, allow_members: bool) returns ref[Signature]?
    {
        if (t.flags & TypeFlagsObject) = 0
            return null
        let mark this.unported_mark()
        let resolved this.resolve_structured_type_members(t)
        if this.unported_mark() <> mark
            return null
        if resolved = null
            return null
        let sm resolved as ref[StructuredMembers]
        if allow_members = false
        {
            if sm.properties <> null
            {
                if (sm.properties as ref[Array[ref[Symbol]?]]).get_length() <> 0
                    return null
            }
            if sm.index_infos <> null
            {
                if (sm.index_infos as ref[Array[ref[IndexInfo]?]]).get_length() <> 0
                    return null
            }
        }
        var total 0
        if sm.signatures <> null
            set total: (sm.signatures as ref[Array[ref[Signature]?]]).get_length() as int
        let calls sm.call_signature_count
        let constructs total - calls
        if kind = SignatureKindCall
        {
            if calls <> 1
                return null
            if constructs <> 0
                return null
            return (sm.signatures as ref[Array[ref[Signature]?]])[0]
        }
        if kind = SignatureKindConstruct
        {
            if constructs <> 1
                return null
            if calls <> 0
                return null
            return (sm.signatures as ref[Array[ref[Signature]?]])[calls]
        }
        null
    }

    ; isSymbolOrSymbolForCall, WHOLE since slice 146.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE WAS AN EXPIRED PREMISE AND THE TWO ROWS IT FED
    ; WERE THE FRONTIER'S HEAD. It read *up to the term that needs a global … the
    ; answer is a global lookup away, which is a stop* — and both halves of that
    ; lookup were already in this file: `get_global_es_symbol_constructor_symbol_or_nil`
    ; four thousand lines up (slice 143 wrote it for the known-symbol name) and
    ; `resolve_name` with the reference's exact six parameters (slice 79). What was
    ; missing was the READING, which is §3.5eo's whole subject. The function is
    ; renamed with the reference's own name, because `symbol_call_undecidable` was
    ; a name for the stop and there is no stop.
    ;
    ; ★ The last line is an IDENTITY test and not a name test — the point of it is
    ; the reference's own comment, *make sure `Symbol` is the global symbol*, so a
    ; local `Symbol` shadowing the lib's must answer false.
    procedure is_symbol_or_symbol_for_call(this, node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindCallExpression
            return false
        var left AstNode.expression_of(node)
        if left = null
            return false
        if AstNode.kind_of(left as ref[AstNode]) = KindPropertyAccessExpression
        {
            let nm AstNode.property_access_name_of(left as ref[AstNode])
            if nm <> null
            {
                if AstNode.text_is(nm as ref[AstNode], "for")
                    set left: AstNode.expression_of(left as ref[AstNode])
            }
        }
        if left = null
            return false
        let l left as ref[AstNode]
        if AstNode.kind_of(l) <> KindIdentifier
            return false
        if AstNode.text_is(l, "Symbol") = false
            return false
        let global_es_symbol this.get_global_es_symbol_constructor_symbol_or_nil()
        if global_es_symbol = null
            return false
        let resolved this.resolve_name(l, "Symbol", SymbolFlagsValue, 0, false, false)
        if resolved = null
            return false
        (global_es_symbol as ref[Symbol]) = (resolved as ref[Symbol])
    }

    ; widenTypeInferredFromInitializer, whole.
    ;
    ; ★★★ ITS SECOND HALF IS A JAVASCRIPT-ONLY IMPLICIT-ANY REPORT, and both of
    ; its tests are decided WITHOUT the globals table — one exactly and one by a
    ; sufficient condition that is proved rather than asserted (§3.5ag).
    ; isEmptyLiteralType is `t == c.implicitNeverType` under strictNullChecks,
    ; which is a pointer comparison against an intrinsic this port builds, so the
    ; arm is transcribed whole and is live code with no input today — nothing
    ; answers implicitNeverType, whose producers are the empty array literal and
    ; the object-literal inference. isEmptyArrayLiteralType goes through
    ; getElementTypeOfArrayType, whose first conjunct is isArrayType's
    ; `objectFlags&Reference`: a type WITHOUT that bit answers nil whatever
    ; globalArrayType is, so the false answer is proved and only a reference-typed
    ; widened type needs the global.
    procedure widen_type_inferred_from_initializer(this, declaration: ref[AstNode], t: ref[Type]?) returns ref[Type]?
    {
        if t = null
            return null
        let mark this.unported_mark()
        let widened this.get_widened_literal_type_for_initializer(declaration, t as ref[Type])
        if this.unported_mark() <> mark
            return null
        if widened = null
            return null
        let w widened as ref[Type]
        if Parser.is_in_js_file(declaration)
        {
            if this.is_empty_literal_type(w)
            {
                this.report_implicit_any(declaration, any_type, WideningKindNormal)
                return any_type
            }
            ; ★★★ isEmptyArrayLiteralType, CODE SINCE SLICE 115. The two notes that
            ; stood here — *"getElementTypeOfArrayType → isArrayType →
            ; globalArrayType"* and *"anyArrayType is createArrayType over the same
            ; global, so the arm it guards is behind the row above rather than
            ; beside it"* — were one claim about the lib and one about a stop, and
            ; the array chapter answers both. ★The `objectFlags&Reference` pre-test
            ; is not the reference's: isArrayType asks it itself, so the guard is
            ; dropped and the predicate is called as written.
            if this.is_empty_array_literal_type(w)
            {
                let aat this.get_any_array_type()
                if aat = null
                    return null
                this.report_implicit_any(declaration, aat as ref[Type], WideningKindNormal)
                return aat
            }
        }
        w
    }


    ; isEmptyLiteralType. strictNullChecks is TRUE under this harness, so the
    ; second arm is the dead one — and it is transcribed because the option is a
    ; harness fact and not a language one.
    function is_empty_literal_type(this, t: ref[Type]) returns bool
    {
        if Checker.strict_null_checks()
            return t = implicit_never_type
        t = undefined_widening_type
    }

    ; getWidenedLiteralTypeForInitializer — the one bit that decides whether a
    ; literal type survives.
    ;
    ; ★★ THE MEMO IN FRONT OF getCombinedNodeFlags IS SKIPPED WITH ITS ARGUMENT:
    ; `c.lastGetCombinedNodeFlagsNode`/`Result` is a one-entry cache over a pure
    ; function of the node, so it can change no answer, and is_var_const_like above
    ; already calls Binder.combined_node_flags directly. A two-field cache that
    ; cannot be observed is two fields that cannot be wrong and cannot be right.
    procedure get_widened_literal_type_for_initializer(this, declaration: ref[AstNode], t: ref[Type]) returns ref[Type]?
    {
        if (Binder.combined_node_flags(declaration) & NodeFlagsConstant) <> 0
            return t
        if this.is_declaration_readonly(declaration)
            return t
        this.get_widened_literal_type(t)
    }

    ; getWidenedLiteralType — five freshness arms and a union.
    ;
    ; ★★★ THREE OF THE FIVE ARE LIVE AND THIS IS THE FIRST WIDENING IN THE PORT
    ; THAT ANSWERS A DIFFERENT TYPE THAN IT WAS GIVEN. A fresh string literal
    ; becomes `string`, a fresh number literal `number`, a fresh bigint literal
    ; `bigint` — and the freshness is what makes the answer depend on the
    ; DECLARATION and not only on the expression, which is the whole content of the
    ; caller above.
    ;
    ; ★★★ THE BOOLEAN ARM WAS THE ONE REACHABLE STOP AND SLICE 94 CLOSES IT. The
    ; sentence that stood here — *"`let b = true` gets the fresh true type from the
    ; dispatch and needs `booleanType` to widen to ... so this slice makes a THIRD
    ; reader for it, and all three report"* — named its own expiry date, and the
    ; union chapter is it. All three readers answer now.
    ;
    ; ★★ THE ENUM-LIKE ARM IS STILL INERT FOR THE REASON ITS FLAGS ARE: nothing
    ; here sets TypeFlagsEnum or TypeFlagsEnumLiteral on a type. ★★★THE UNION ARM
    ; IS LIVE SINCE SLICE 139 — the sentence that stood here counted it among the
    ; inert ones and named `TypeFlagsUnion` with them, which stopped being true the
    ; slice the union chapter landed; it is now the ordinary map over the
    ; constituents (§3.5eo).
    ;
    ; ★ THE ORDER IS THE REFERENCE'S SWITCH ORDER AND IT MATTERS ONCE: EnumLike is
    ; tested before the four literal kinds, and an enum LITERAL type carries both
    ; TypeFlagsEnumLiteral and its base literal's flag, so a reordering would widen
    ; an enum member to `string` or `number` instead of to its enum.
    procedure get_widened_literal_type(this, t: ref[Type]) returns ref[Type]?
    {
        let fresh Checker.is_fresh_literal_type(t)
        if fresh
        {
            if (t.flags & TypeFlagsEnumLike) <> 0
                return this.get_base_type_of_enum_like_type(t)
            if (t.flags & TypeFlagsStringLiteral) <> 0
                return string_type
            if (t.flags & TypeFlagsNumberLiteral) <> 0
                return number_type
            if (t.flags & TypeFlagsBigIntLiteral) <> 0
                return bigint_type
            if (t.flags & TypeFlagsBooleanLiteral) <> 0
                return boolean_type
        }
        if (t.flags & TypeFlagsUnion) <> 0
            return this.map_type(t, MapTypeKindWidenedLiteral, null)
        t
    }

    ; isFreshLiteralType, whole. ★It reads `fresh_type`, which is the correction
    ; the chapter header records: a literal type is FRESH exactly when its fresh
    ; slot points at itself, and the regular member of the pair points at the fresh
    ; one only in the boolean case, where both are built eagerly.
    function is_fresh_literal_type(t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsFreshable) = 0
            return false
        let f Checker.literal_fresh_type_of(t)
        if f = null
            return false
        (f as ref[Type]) = t
    }

    ; getContextuallyTypedParameterType.
    ;
    ; ★★★ THE HEADER THAT STOOD HERE SAID *its first line is the whole function
    ; today* AND SLICE 100 IS WHERE THAT EXPIRED — for the reason the sentence
    ; itself gave, which is the good kind of expiry (§3.5p): the three shapes its
    ; guard admits are exactly the three checkExpressionWorker used to stop at.
    ;
    ; ★★ THE IIFE BRANCH IS THE CALL DIMENSION AND STOPS AS ONE. `(function (x)
    ; { … })(1)` types its parameter off the ARGUMENT, which needs
    ; getEffectiveCallArguments and the signature-links cell the reference
    ; temporarily overwrites with anySignature. The syntactic test in front of it
    ; is cheap and is ported, so the stop is a claim about the branch and not
    ; about every parameter.
    procedure get_contextually_typed_parameter_type(this, parameter: ref[AstNode]) returns ref[Type]?
    {
        let fn_opt AstNode.parent_node_of(parameter)
        if fn_opt = null
            return null
        let fn fn_opt as ref[AstNode]
        let mark this.unported_mark()
        if this.is_context_sensitive_function_or_object_literal_method(fn) = false
            return null
        if this.unported_mark() <> mark
            return null
        ; ★★★ SLICE 165 — THE IIFE BRANCH, AND ITS NOTE NAMED TWO THINGS THAT ARE
        ; BOTH HERE. It read *it needs getEffectiveCallArguments and the
        ; signature-links cell the reference temporarily overwrites with
        ; anySignature*; `get_effective_call_arguments` is whole and
        ; `signature_link_of` is the mint-on-miss reader slice 84 wrote, whose
        ; `resolved_signature` slot is exactly that cell. **The overwrite is what
        ; the branch is FOR**: checking an argument re-enters the call whose
        ; parameter is being typed, and parking `any_signature` in the slot is how
        ; the reference stops that recursion.
        let iife Checker.immediately_invoked_function_expression(fn)
        if iife <> null
        {
            let call iife as ref[AstNode]
            let args this.get_effective_call_arguments(call)
            if this.unported_mark() <> mark
                return null
            if args = null
                return null
            let arg_list args as ref[Array[ref[AstNode]?]]
            let arg_count arg_list.get_length() as int
            let plist AstNode.parameters_of(fn)
            if plist = null
                return null
            let pl plist as ref[Array[ref[AstNode]?]]
            var pindex -1
            var pi 0
            while pi < (pl.get_length() as int)
            {
                let row pl[pi]
                if row <> null
                {
                    if (row as ref[AstNode]) = parameter
                    {
                        set pindex: pi
                        break
                    }
                }
                set pi: pi + 1
            }
            if pindex < 0
                return null
            if AstNode.dot_dot_dot_token_of(parameter) <> null
            {
                let spread this.get_spread_argument_type(args, pindex, arg_count, any_type, null, CheckModeNormal)
                if this.unported_mark() <> mark
                    return null
                return spread
            }
            ; The cell, parked and restored around the one check — the reference's
            ; own order, and the restore happens on every arm including the two
            ; that never look at an argument.
            let links this.signature_link_of(call)
            let cached links.resolved_signature
            let cached_stopped links.signature_stopped
            set links.resolved_signature: any_signature
            set links.signature_stopped: false
            var answer: ref[Type]? null
            if pindex < arg_count
            {
                let arg arg_list[pindex]
                if arg <> null
                {
                    let at this.check_expression(arg as ref[AstNode])
                    if at <> null
                        set answer: this.get_widened_literal_type(at as ref[Type])
                }
            }
            else
            {
                ; A parameter past the last argument answers the WIDENING undefined
                ; — unless it has an initializer, where the reference answers nil
                ; and the caller falls back to the initializer's own type.
                if AstNode.initializer_of(parameter) = null
                    set answer: undefined_widening_type
            }
            set links.resolved_signature: cached
            set links.signature_stopped: cached_stopped
            if this.unported_mark() <> mark
                return null
            return answer
        }
        let contextual_signature this.get_contextual_signature(fn)
        if this.unported_mark() <> mark
            return null
        if contextual_signature = null
            return null
        let sig contextual_signature as ref[Signature]
        let params AstNode.parameters_of(fn)
        if params = null
            return null
        let ps params as ref[Array[ref[AstNode]?]]
        var index -1
        var i 0
        while i < ps.get_length()
        {
            let p ps[i]
            if p <> null
            {
                if (p as ref[AstNode]) = parameter
                {
                    set index: i
                    break
                }
            }
            set i: i + 1
        }
        if index < 0
            return null
        if ps.get_length() > 0
        {
            if AstNode.is_this_parameter(ps[0])
                set index: index - 1
        }
        if AstNode.dot_dot_dot_token_of(parameter) <> null
        {
            let last ps[(ps.get_length() as int) - 1]
            var is_last false
            if last <> null
            {
                if (last as ref[AstNode]) = parameter
                    set is_last: true
            }
            ; ★The rest parameter's contextual type is the tuple of everything
            ; from `index` on. The stop that stood here named *the TUPLE chapter,
            ; which this port has no producer for at all* — createTupleTypeEx has
            ; been a producer since slice 115 and get_rest_type_at_position itself
            ; since the signature chapter (§3.5eo).
            if is_last
                return this.get_rest_type_at_position(sig, index, false)
        }
        this.try_get_type_at_position(sig, index)
    }

    ; ast.GetImmediatelyInvokedFunctionExpression — purely syntactic, and the one
    ; half of the IIFE branch that can be answered here.
    function immediately_invoked_function_expression(fn: ref[AstNode]) returns ref[AstNode]?
    {
        let k AstNode.kind_of(fn)
        var function_like false
        if k = KindFunctionExpression
            set function_like: true
        if k = KindArrowFunction
            set function_like: true
        if function_like = false
            return null
        var prev fn
        var parent_opt AstNode.parent_node_of(fn)
        while Checker.kind_or_unknown(parent_opt) = KindParenthesizedExpression
        {
            set prev: parent_opt as ref[AstNode]
            set parent_opt: AstNode.parent_node_of(prev)
        }
        if parent_opt = null
            return null
        let parent parent_opt as ref[AstNode]
        if AstNode.kind_of(parent) <> KindCallExpression
            return null
        let callee AstNode.expression_of(parent)
        if callee = null
            return null
        if (callee as ref[AstNode]) <> prev
            return null
        parent

    }

    ; tryGetTypeAtPosition, whole.
    ;
    ; ★★★ ITS REST HALF WAS A STOP WHOSE NOTE READ *a tuple rest type has no
    ; producer in this port, and getIndexedAccessType behind it is a chapter of its
    ; own* — and getIndexedAccessType has BEEN that chapter since slice 117
    ; (§3.5eo). The reference's own comment is the whole content of the guard: the
    ; bounds test comes FIRST, because getIndexedAccessType would answer
    ; `undefined` for an out-of-range index where this function must answer
    ; NOTHING, and the caller reads those two apart.
    procedure try_get_type_at_position(this, signature: ref[Signature], pos: int) returns ref[Type]?
    {
        var length 0
        if signature.parameters <> null
            set length: (signature.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
        var param_count length
        if Checker.signature_has_rest_parameter(signature)
            set param_count: length - 1
        if pos < param_count
        {
            let p (signature.parameters as ref[Array[ref[Symbol]?]])[pos]
            if p = null
                return null
            return this.get_type_of_parameter(p as ref[Symbol])
        }
        if Checker.signature_has_rest_parameter(signature) = false
            return null
        let rest_param (signature.parameters as ref[Array[ref[Symbol]?]])[param_count]
        if rest_param = null
            return null
        let mark this.unported_mark()
        let rest_type this.get_type_of_symbol(rest_param as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        if rest_type = null
            return null
        let rt rest_type as ref[Type]
        let index pos - param_count
        var reachable true
        if Checker.is_tuple_type(rt)
        {
            let target Checker.target_of(rt)
            if target <> null
            {
                let tt target as ref[Type]
                if (Checker.tuple_combined_flags_of(tt) & ElementFlagsVariable) = 0
                {
                    if index >= Checker.tuple_fixed_length_of(tt)
                        set reachable: false
                }
            }
        }
        if reachable = false
            return null
        this.get_indexed_access_type(rt, this.get_number_literal_type(Checker.number_bits_from_int(index)))
    }

    ; getTypeOfParameter, whole.
    ;
    ; ★ ITS OPTIONALITY TERM IS A DISJUNCTION AND NOT THE ONE assignParameterType
    ; ASKS. Here an INITIALIZER makes the parameter optional (`f(x = 1)` accepts a
    ; call with no argument); there the initializer is the reason NOT to add
    ; undefined, because the declared type is the initializer's. Two readers, two
    ; conditions, one helper — the difference is worth a line because the first
    ; draft of this function copied the wrong one.
    procedure get_type_of_parameter(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t this.get_type_of_symbol(symbol)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        let declaration Symbol.value_declaration_of(symbol)
        var optional false
        if declaration <> null
        {
            let d declaration as ref[AstNode]
            if AstNode.initializer_of(d) <> null
                set optional: true
            if Checker.is_optional_declaration(d)
                set optional: true
        }
        this.add_optionality_ex(t as ref[Type], false, optional)
    }

    ; getContextualThisParameterType.
    ;
    ; ★★ noImplicitThis IS TRUE, so the second half of this function is LIVE — it
    ; is a strict-FAMILY option, the fourth one strict_null_checks' header names.
    ; What keeps it quiet is the shape: an object-literal container or an
    ; `obj.xxx = function (…)` assignment, both of which stop, and everything else
    ; answers nothing.
    ;
    ; ★★★ THE CONTEXTUAL-SIGNATURE ARM'S STOP WAS AN EXPIRED NOTE: it named
    ; getContextualSignature as absent, and that function has been whole — bar the
    ; multi-callable union's comparison — since slice 100. The arm asks it for the
    ; signature's OWN `this` parameter, which this port's Signature has carried
    ; since slice 54, so nothing had to be built.
    procedure get_contextual_this_parameter_type(this, fn: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if AstNode.kind_of(fn) = KindArrowFunction
            return null
        if this.is_context_sensitive_function_or_object_literal_method(fn)
        {
            let cs this.get_contextual_signature(fn)
            if this.unported_mark() <> mark
                return null
            if cs <> null
            {
                let tp (cs as ref[Signature]).this_parameter
                if tp <> null
                    return this.get_type_of_symbol(tp as ref[Symbol])
            }
        }
        if this.unported_mark() <> mark
            return null
        var considered: bool Checker.no_implicit_this()
        if Parser.is_in_js_file(fn)
            set considered: true
        if considered
        {
            let containing Checker.containing_object_literal(fn)
            if containing <> null
            {
                let literal containing as ref[AstNode]
                ; "We have an object literal method. Check if the containing object
                ; literal has a contextual type that includes a ThisType<T>. If so,
                ; T is the contextual type for 'this'."
                let contextual this.get_apparent_type_of_contextual_type(literal, ContextFlagsNone)
                if this.unported_mark() <> mark
                    return null
                let marker this.get_this_type_of_object_literal_from_contextual_type(literal, contextual)
                if this.unported_mark() <> mark
                    return null
                if marker <> null
                {
                    let ctx this.get_inference_context(literal)
                    if this.unported_mark() <> mark
                        return null
                    return this.instantiate_type(marker, Checker.get_mapper_from_context(ctx))
                }
                ; "There was no contextual ThisType<T> …, so the contextual type for
                ; 'this' is the non-null form of the contextual type for the
                ; containing object literal or the type of the object literal
                ; itself."
                var this_type: ref[Type]? null
                if contextual <> null
                    set this_type: this.get_non_nullable_type(contextual as ref[Type])
                else
                    set this_type: this.check_expression_cached(literal)
                if this.unported_mark() <> mark
                    return null
                if this_type = null
                    return null
                return this.get_widened_type(this_type as ref[Type])
            }
            ; "In an assignment of the form 'obj.xxx = function(...)' or
            ; 'obj[xxx] = function(...)', the contextual type for 'this' is 'obj'."
            let parent Checker.walk_up_parenthesized_expressions(AstNode.parent_node_of(fn))
            if Parser.is_assignment_expression_node(parent)
            {
                let target AstNode.binary_left_of(parent as ref[AstNode])
                if Parser.is_access_expression(target)
                {
                    let expression AstNode.expression_of(target)
                    if expression = null
                        return null
                    let expr expression as ref[AstNode]
                    ; "Don't contextually type `this` as `exports` in
                    ; `exports.Point = function(x, y) { … }`" — a JS-only guard, and
                    ; the module-exports flag is what tells the two apart.
                    if Parser.is_in_js_file(fn)
                    {
                        if AstNode.kind_of(expr) = KindIdentifier
                        {
                            ; The reference reads the indicator off
                            ; `getSourceFileOfNode(parent)`; this port binds ONE file
                            ; per unit and the Binder holds that file's flag, so the
                            ; source-file hop has nothing to select between.
                            if b.common_js_module_indicator_of() <> null
                            {
                                let resolved this.get_resolved_symbol(expr)
                                if this.unported_mark() <> mark
                                    return null
                                if (Symbol.flags_of(resolved) & SymbolFlagsModuleExports) <> 0
                                    return null
                            }
                        }
                    }
                    let et this.check_expression_cached(expr)
                    if this.unported_mark() <> mark
                        return null
                    if et = null
                        return null
                    return this.get_widened_type(et as ref[Type])
                }
            }
        }
        null
    }

    ; getThisTypeOfObjectLiteralFromContextualType — the walk OUTWARD through
    ; enclosing object literals. ★★★ IT CLIMBS ONLY THROUGH A PROPERTY
    ; ASSIGNMENT, two nodes at a time: the literal's parent is the property
    ; assignment and ITS parent is the enclosing literal, so a literal reached any
    ; other way ends the walk. That is what makes `ThisType<T>` on an outer literal
    ; reach an inner method without reaching out of the literal nest entirely.
    procedure get_this_type_of_object_literal_from_contextual_type(this, containing_literal: ref[AstNode], contextual_type: ref[Type]?) returns ref[Type]?
    {
        var literal containing_literal
        var t contextual_type
        let mark this.unported_mark()
        while t <> null
        {
            let this_type this.get_this_type_from_contextual_type(t as ref[Type])
            if this.unported_mark() <> mark
                return null
            if this_type <> null
                return this_type
            let parent AstNode.parent_node_of(literal)
            if Checker.kind_or_unknown(parent) <> KindPropertyAssignment
                return null
            let grandparent AstNode.parent_node_of(parent as ref[AstNode])
            if grandparent = null
                return null
            set literal: grandparent as ref[AstNode]
            set t: this.get_apparent_type_of_contextual_type(literal, ContextFlagsNone)
            if this.unported_mark() <> mark
                return null
        }
        null
    }

    ; getThisTypeFromContextualType — mapType over the contextual type, per §3.18.
    procedure get_this_type_from_contextual_type(this, t: ref[Type]) returns ref[Type]?
        this.map_type(t, MapTypeKindThisTypeFromContextual, null)

    ; The closure's body, per constituent.
    procedure this_type_from_contextual_constituent(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.intersection_types_of(t)
            if types = null
                return null
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            let mark this.unported_mark()
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let arg this.get_this_type_argument(row as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if arg <> null
                    return arg
            }
            return null
        }
        this.get_this_type_argument(t)
    }

    ; getThisTypeArgument — the one type argument of a `ThisType<T>` reference.
    procedure get_this_type_argument(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return null
        let target Checker.target_of(t)
        if target = null
            return null
        let marker this.get_global_this_marker_type()
        if marker = null
            return null
        if (target as ref[Type]) <> (marker as ref[Type])
            return null
        let mark this.unported_mark()
        let args this.get_type_arguments(t)
        if this.unported_mark() <> mark
            return null
        if args = null
            return null
        let list args as ref[Array[ref[Type]?]]
        if (list.get_length() as int) = 0
            return null
        list[0]
    }

    ; getContainingObjectLiteral — two shapes, and the second reaches one level
    ; further up (a function EXPRESSION is the property assignment's initializer,
    ; so the literal is its grandparent).
    function containing_object_literal(f: ref[AstNode]) returns ref[AstNode]?
    {
        let k AstNode.kind_of(f)
        var member false
        if k = KindMethodDeclaration
            set member: true
        if k = KindGetAccessor
            set member: true
        if k = KindSetAccessor
            set member: true
        let parent AstNode.parent_node_of(f)
        if member
        {
            if Checker.kind_or_unknown(parent) = KindObjectLiteralExpression
                return parent
            return null
        }
        if k = KindFunctionExpression
        {
            if Checker.kind_or_unknown(parent) = KindPropertyAssignment
                return AstNode.parent_node_of(parent)
        }
        null
    }

    ; ast.WalkUpParenthesizedExpressions.
    ; isDeleteTarget — *is this access the operand of a `delete`*, and the one
    ; caller is the read-only index-signature report.
    function is_delete_target(node: ref[AstNode]) returns bool
    {
        if Parser.is_access_expression(node) = false
            return false
        let up Checker.walk_up_parenthesized_expressions(AstNode.parent_node_of(node))
        if up = null
            return false
        AstNode.kind_of(up as ref[AstNode]) = KindDeleteExpression
    }

    function walk_up_parenthesized_expressions(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var n node
        while n <> null
        {
            if AstNode.kind_of(n as ref[AstNode]) <> KindParenthesizedExpression
                return n
            set n: AstNode.parent_node_of(n)
        }
        null
    }

    ; ast.WalkUpParenthesizedTypes — the TYPE twin, slice 146.
    ;
    ; ★★★ IT IS NOT INTERCHANGEABLE WITH THE EXPRESSION ONE and the fixture that
    ; says so predates the reader by eighty-five slices:
    ; `checker_type_operator_unique.ts`'s own header names
    ; `declare const parenthesized: (unique symbol)` the *WalkUpParenthesizedTypes
    ; witness*, and it was the ONE unit that failed when this arm first climbed a
    ; bare `node.Parent`: `(unique symbol)`'s operator sits under a
    ; ParenthesizedType, so the declaration is two hops up and the port answered
    ; `symbol` where the reference answers `unique symbol`.
    function walk_up_parenthesized_types(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var n node
        while n <> null
        {
            if AstNode.kind_of(n as ref[AstNode]) <> KindParenthesizedType
                return n
            set n: AstNode.parent_node_of(n)
        }
        null
    }

    ; ── slice 112: getWidenedType, WHOLE ─────────────────────────────────────
    ;
    ; getWidenedType, getWidenedTypeWithContext and getWidenedTypeOfObjectLiteral
    ; with the two property helpers under it.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE HAD EXPIRED TWO SLICES BEFORE IT WAS READ. It
    ; said the five widening arms could stand behind ONE report because *no type
    ; this slice makes carries either bit* — true of slice 69's tree, and false
    ; since slice 99: ObjectFlagsContainsObjectOrArrayLiteral is one half of
    ; RequiresWidening and create_object_literal_type sets it on every type it
    ; mints. That is the whole row, measured rather than argued: 91 arrivals over
    ; 49 units, every one of them at TypeFlagsObject and none at any other flag —
    ; so the OBJECT-LITERAL arm is the live one and the other four are not.
    ;
    ; ★★★ THE MEMO IS PORTED AND IT IS NOT AN OPTIMISATION. This function MINTS a
    ; type, so without the cache two widenings of one object literal answer two
    ; DIFFERENT types, and type identity is read all over this file — the
    ; `core.Same` short circuit in filter_undefined_out, the interning in
    ; get_union_type_from_sorted_list. Upstream keys it in `c.cachedTypes` under
    ; CachedTypeKindWidened; here it is one link list beside the other nine,
    ; because exactly ONE kind of that key is in use and a two-part key with a
    ; single reader is a table nobody can check.
    procedure get_widened_type(this, t: ref[Type]) returns ref[Type]?
        this.get_widened_type_with_context(t, null)

    procedure get_widened_type_with_context(this, t: ref[Type], context: ref[WideningContext]?) returns ref[Type]?
    {
        if (t.object_flags & ObjectFlagsRequiresWidening) = 0
            return t
        if context = null
        {
            let cached this.widened_type_link_of(t).widened
            if cached <> null
                return cached
        }
        let mark this.unported_mark()
        ; The reference's `switch` with no subject — an ORDERED chain (§3.5u), and
        ; `result` staying nil is its own case: the fall-through answers `t`.
        var result: ref[Type]? null
        if (t.flags & (TypeFlagsAny | TypeFlagsNullable)) <> 0
            set result: any_type
        else
        {
            if Checker.is_object_literal_type(t)
                set result: this.get_widened_type_of_object_literal(t, context)
            else
            {
                if (t.flags & TypeFlagsUnion) <> 0
                    set result: this.get_widened_type_of_union(t, context)
                else
                {
                    ; ★★★ SLICE 131: BOTH ARMS, AND THE INTERSECTION ONE WAS THE
                    ; THIRD EXPIRED CLAIM OF THIS SLICE — *nothing in this port
                    ; mints an intersection* stopped being true at slice 121.
                    if (t.flags & TypeFlagsIntersection) <> 0
                    {
                        ; `getIntersectionType(core.SameMap(t.Types(),
                        ; c.getWidenedType))` — the CONTEXT is deliberately not
                        ; passed down, exactly as upstream: an intersection's
                        ; constituents are not siblings of one another the way a
                        ; union's are, so each is widened on its own.
                        let parts Checker.union_or_intersection_types_of(t)
                        if parts = null
                            return null
                        let pl parts as ref[Array[ref[Type]?]]
                        let pn pl.get_length() as int
                        let widened this.new_type_list(null)
                        var pi 0
                        while pi < pn
                        {
                            let e pl[pi]
                            if e = null
                                return null
                            let w this.get_widened_type(e as ref[Type])
                            if this.unported_mark() <> mark
                                return null
                            if w = null
                                return null
                            widened.add(w)
                            set pi: pi + 1
                        }
                        set result: this.get_intersection_type(widened)
                    }
                    else
                    {
                        if this.is_array_or_tuple_type(t)
                        {
                            ; `createTypeReference(t.Target(),
                            ; core.SameMap(c.getTypeArguments(t), c.getWidenedType))`.
                            let target Checker.target_of(t)
                            if target = null
                                return null
                            let args this.get_type_arguments(t)
                            if this.unported_mark() <> mark
                                return null
                            let widened this.new_type_list(null)
                            if args <> null
                            {
                                let al args as ref[Array[ref[Type]?]]
                                let an al.get_length() as int
                                var ai 0
                                while ai < an
                                {
                                    let e al[ai]
                                    if e = null
                                        return null
                                    let w this.get_widened_type(e as ref[Type])
                                    if this.unported_mark() <> mark
                                        return null
                                    if w = null
                                        return null
                                    widened.add(w)
                                    set ai: ai + 1
                                }
                            }
                            set result: this.create_type_reference(target as ref[Type], widened, ObjectFlagsNone)
                        }
                    }
                }
            }
        }
        if this.unported_mark() <> mark
            return null
        if result = null
            return t
        if context = null
        {
            let link this.widened_type_link_of(t)
            set link.widened: result
        }
        result
    }

    ; The union arm, lifted out of the chain because `core.SameMap` plus the
    ; `core.Some` that picks the reduction is four statements and the chain above
    ; is already four deep.
    ;
    ; ★ A NULLABLE CONSTITUENT IS NOT WIDENED and that is the reference's own test,
    ; not a shortcut: `undefined | T` must keep its `undefined` while T widens, and
    ; the any/nullable arm above would turn the constituent into `any`.
    procedure get_widened_type_of_union(this, t: ref[Type], context: ref[WideningContext]?) returns ref[Type]?
    {
        let types Checker.union_types_of(t)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        var union_context context
        if union_context = null
            set union_context: &WideningContext^host(list)
        let n list.get_length() as int
        let widened &Array[ref[Type]?]()
        var has_empty_object false
        var i 0
        while i < n
        {
            let c list[i]
            if c = null
                return null
            let ct c as ref[Type]
            var w: ref[Type]? ct
            if (ct.flags & TypeFlagsNullable) = 0
                set w: this.get_widened_type_with_context(ct, union_context)
            if w = null
                return null
            if this.is_empty_object_type(w as ref[Type])
                set has_empty_object: true
            widened.add(w)
            set i: i + 1
        }
        var reduction UnionReductionLiteral
        if has_empty_object
            set reduction: UnionReductionSubtype
        this.get_union_type_ex(widened, reduction, null, null)
    }

    ; getWidenedTypeOfObjectLiteral.
    ;
    ; ★★★ THE CONTEXT HALF IS ONE STOP AND THE POPULATION SAYS SO. Every read of a
    ; WideningContext — the `widenedTypes` memo, getPropertiesOfContext, the
    ; undefined-property fill and getChildContext — is reachable only from the
    ; UNION arm above, i.e. only for a union that CONTAINS an object literal. A
    ; top-level getWidenedType passes nil and never sees one, which is the whole
    ; measured row.
    procedure get_widened_type_of_object_literal(this, t: ref[Type], context: ref[WideningContext]?) returns ref[Type]?
    {
        ; The `widenedTypes` memo — read on EVERY context, written only on a child
        ; one (see the write at the end of the body for the reference's reason).
        if context <> null
        {
            let cached Checker.widened_type_memo_of(context as ref[WideningContext], t)
            if cached <> null
                return cached
        }
        let props this.get_properties_of_object_type(t)
        let members SymbolTable.create(host)
        if props <> null
        {
            let pl props as ref[Array[ref[Symbol]?]]
            let n pl.get_length() as int
            var i 0
            while i < n
            {
                let p pl[i]
                if p = null
                    return null
                let prop p as ref[Symbol]
                let widened this.get_widened_property(prop, context)
                if widened = null
                    return null
                SymbolTable.set_entry(host, members, Symbol.name_of(prop), widened)
                set i: i + 1
            }
        }
        ; "for _, prop := range c.getPropertiesOfContext(context)" — the properties
        ; a SIBLING object literal has and this one does not, filled in as optional
        ; `undefined`. It is what makes `[{ a: 1 }, { b: 2 }]` widen to a union of
        ; two types that each carry both names.
        if context <> null
        {
            let ctx context as ref[WideningContext]
            let extra this.get_properties_of_context(ctx)
            if extra = null
                return null
            let el extra as ref[Array[ref[Symbol]?]]
            let en el.get_length() as int
            var k 0
            while k < en
            {
                let e el[k]
                if e = null
                    return null
                let ep e as ref[Symbol]
                if SymbolTable.get(members, Symbol.name_of(ep)) = null
                    SymbolTable.set_entry(host, members, Symbol.name_of(ep), this.get_undefined_property(ep))
                set k: k + 1
            }
        }
        let infos this.get_index_infos_of_type(t)
        var widened_infos: ref[Array[ref[IndexInfo]?]]? null
        if infos <> null
        {
            let il infos as ref[Array[ref[IndexInfo]?]]
            let n il.get_length() as int
            let out this.new_index_info_list()
            var i 0
            while i < n
            {
                let info il[i]
                if info = null
                    return null
                let ii info as ref[IndexInfo]
                var wv: ref[Type]? ii.value_type
                if wv <> null
                    set wv: this.get_widened_type(wv as ref[Type])
                if wv = null
                    return null
                out.add(this.new_index_info_ex(ii.key_type, wv, ii.is_readonly, ii.declaration, ii.components))
                set i: i + 1
            }
            set widened_infos: out
        }
        let made this.new_anonymous_type(t.symbol, members, null, null, widened_infos)
        if made = null
            return null
        let result made as ref[Type]
        ; "Retain js literal flag through widening"
        set result.object_flags: (result.object_flags | (t.object_flags & (ObjectFlagsJSLiteral | ObjectFlagsNonInferrableType))) as u32
        ; "Only cache in child contexts since the root context never widens a
        ; particular object literal type more than once."
        if context <> null
        {
            let ctx context as ref[WideningContext]
            if ctx.parent <> null
            {
                if ctx.widened_types = null
                    set ctx.widened_types: &Array[ref[WidenedTypeEntry]?]^host()
                (ctx.widened_types as ref[Array[ref[WidenedTypeEntry]?]]).add(&WidenedTypeEntry^host(t, result))
            }
        }
        result
    }

    ; The `context.widenedTypes[t]` read, as a scan — see the record's header for
    ; why a list. ★A miss is null and so is a hit on a null entry, which cannot
    ; happen: nothing writes one.
    function widened_type_memo_of(context: ref[WideningContext], t: ref[Type]) returns ref[Type]?
    {
        if context.widened_types = null
            return null
        let list context.widened_types as ref[Array[ref[WidenedTypeEntry]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                let entry e as ref[WidenedTypeEntry]
                if entry.source = t
                    return entry.widened
            }
            set i: i + 1
        }
        null
    }

    ; ── slice 154: the sibling machinery ────────────────────────────────────
    ;
    ; ★★★ WHAT IT IS FOR, because the three functions read as bookkeeping until the
    ; question they answer is written down. Widening `[{ a: 1 }, { b: 2 }]` must not
    ; produce `{ a: number }[] | { b: number }[]`: every constituent of the union
    ; gets the properties of ALL of them, the ones it lacks as optional `undefined`.
    ; The context is how a constituent learns what its SIBLINGS have — the root one
    ; holds the union's members, and a child context, one per property NAME, holds
    ; the types that property has across those members.
    ;
    ; WideningContext.getChildContext, whole.
    procedure get_child_context(this, w: ref[WideningContext], property_name: Slice[char]) returns ref[WideningContext]
    {
        if w.child_contexts <> null
        {
            let list w.child_contexts as ref[Array[ref[WideningChild]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e <> null
                {
                    let child e as ref[WideningChild]
                    if SymbolTable.names_equal(child.name, property_name)
                        return child.context
                }
                set i: i + 1
            }
        }
        let result &WideningContext^host(w, property_name)
        if w.child_contexts = null
            set w.child_contexts: &Array[ref[WideningChild]?]^host()
        (w.child_contexts as ref[Array[ref[WideningChild]?]]).add(&WideningChild^host(property_name, result))
        result
    }

    ; getSiblingsOfContext, whole.
    ;
    ; ★★ `.Distributed()` IS WRITTEN OUT rather than given a helper: it is three
    ; lines (a union's constituents, a never's nothing, anything else itself) and
    ; this is its only reader in the file.
    procedure get_siblings_of_context(this, context: ref[WideningContext]) returns ref[Array[ref[Type]?]]?
    {
        if context.siblings <> null
            return context.siblings
        if context.parent = null
        {
            ; Unreachable — the only context built without a parent is the union
            ; arm's root, and that one is built WITH its siblings. Upstream would
            ; nil-dereference here; the report holds the claim.
            this.record_unported("widening-context-root-without-siblings", 0)
            return null
        }
        let parent_siblings this.get_siblings_of_context(context.parent as ref[WideningContext])
        if parent_siblings = null
            return null
        let pl parent_siblings as ref[Array[ref[Type]?]]
        let out &Array[ref[Type]?]^host()
        let n pl.get_length() as int
        var i 0
        while i < n
        {
            let e pl[i]
            if e <> null
            {
                let sib e as ref[Type]
                if Checker.is_object_literal_type(sib)
                {
                    let prop this.get_property_of_object_type(sib, context.property_name)
                    if prop <> null
                    {
                        let pt this.get_type_of_symbol(prop as ref[Symbol])
                        if pt = null
                            return null
                        let ptt pt as ref[Type]
                        if (ptt.flags & TypeFlagsUnion) <> 0
                        {
                            let cs Checker.union_types_of(ptt)
                            if cs = null
                                return null
                            let cl cs as ref[Array[ref[Type]?]]
                            let cn cl.get_length() as int
                            var j 0
                            while j < cn
                            {
                                out.add(cl[j])
                                set j: j + 1
                            }
                        }
                        else
                        {
                            if (ptt.flags & TypeFlagsNever) = 0
                                out.add(ptt)
                        }
                    }
                }
            }
            set i: i + 1
        }
        set context.siblings: out
        context.siblings
    }

    ; getPropertiesOfContext, whole. ★The reference's `collections.OrderedMap` is a
    ; SymbolTable here, and that is exact rather than close: this file's table keeps
    ; its entries in INSERTION order beside the buckets (its own header says so) and
    ; replaces a repeated name in place, which is `names.Set` twice over.
    procedure get_properties_of_context(this, context: ref[WideningContext]) returns ref[Array[ref[Symbol]?]]?
    {
        if context.resolved_properties <> null
            return context.resolved_properties
        let names SymbolTable.create(host)
        let sibs this.get_siblings_of_context(context)
        if sibs = null
            return null
        let sl sibs as ref[Array[ref[Type]?]]
        let n sl.get_length() as int
        var i 0
        while i < n
        {
            let e sl[i]
            if e <> null
            {
                let sib e as ref[Type]
                if Checker.is_object_literal_type(sib)
                {
                    if (sib.object_flags & ObjectFlagsContainsSpread) = 0
                    {
                        ; ★★★ A NULL PROPERTY LIST IS AN EMPTY ONE AND NOT A
                        ; FAILURE. get_named_members answers null for a member
                        ; table of size zero, which is upstream's nil slice —
                        ; `range` over it is a no-op. Read as a failure, the `{}`
                        ; sibling of `[{ a: 1, b: 2 }, { a: "abc" }, {}][0]`
                        ; abandoned the whole fill, get_widened_type_of_union
                        ; answered null and get_widened_type_with_context fell back
                        ; to the UNWIDENED union — so every union of object
                        ; literals containing an empty one printed without its
                        ; `?: undefined` members, at rc 0 and with nothing said.
                        let props this.get_properties_of_type(sib)
                        if props <> null
                        {
                            let pl props as ref[Array[ref[Symbol]?]]
                            let pn pl.get_length() as int
                            var j 0
                            while j < pn
                            {
                                let p pl[j]
                                if p <> null
                                    SymbolTable.set_entry(host, names, Symbol.name_of(p as ref[Symbol]), p)
                                set j: j + 1
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
        let out &Array[ref[Symbol]?]^host()
        let cnt SymbolTable.length(names)
        var k 0
        while k < cnt
        {
            out.add(SymbolTable.entry_symbol_at(names, k))
            set k: k + 1
        }
        set context.resolved_properties: out
        context.resolved_properties
    }

    ; getUndefinedProperty, whole — one symbol per NAME for the whole checker, which
    ; is upstream's own memo and not a saving: the fill above runs once per
    ; constituent per missing property.
    procedure get_undefined_property(this, prop: ref[Symbol]) returns ref[Symbol]
    {
        let cached SymbolTable.get(undefined_properties, Symbol.name_of(prop))
        if cached <> null
            return cached as ref[Symbol]
        let result this.create_symbol_with_type(prop, undefined_or_missing_type)
        Symbol.set_flags(result, Symbol.flags_of(result) | SymbolFlagsOptional)
        SymbolTable.set_entry(host, undefined_properties, Symbol.name_of(prop), result)
        result
    }

    ; getWidenedProperty. ★The accessor arm is the reference's own early return and
    ; not a reduction: a get accessor has already widened its return value, so a
    ; non-Property symbol comes back unchanged.
    procedure get_widened_property(this, prop: ref[Symbol], context: ref[WideningContext]?) returns ref[Symbol]?
    {
        if (Symbol.flags_of(prop) & SymbolFlagsProperty) = 0
            return prop
        let original this.get_type_of_symbol(prop)
        if original = null
            return null
        var prop_context: ref[WideningContext]? null
        if context <> null
            set prop_context: this.get_child_context(context as ref[WideningContext], Symbol.name_of(prop))
        let widened this.get_widened_type_with_context(original as ref[Type], prop_context)
        if widened = null
            return null
        if widened = original
            return prop
        this.create_symbol_with_type(prop, widened)
    }

    ; isArrayOrTupleType, both halves since slice 115. ★The note that stood here
    ; read *"isArrayType is `getTargetType(t) == globalArrayType ||
    ; globalReadonlyArrayType`, and neither global is minted here (the lib is
    ; §3.11), so the first disjunct is FALSE for every type this port can build and
    ; the answer is isTupleType's alone"* — a containment proof over the types the
    ; port could BUILD, and this slice builds both.
    procedure is_array_or_tuple_type(this, t: ref[Type]) returns bool
    {
        if this.is_array_type(t)
            return true
        Checker.is_tuple_type(t)
    }

    ; isEmptyObjectType.
    ;
    ; ★★★ THE isGenericMappedType GUARD IS BACK, AND ITS ABSENCE WAS THIS FILE'S
    ; OWN EXPIRY NOTICE. The line read *"ObjectFlagsMapped has no writer here — it
    ; is not declared at all, on §3.5be's rule — so the conjunct is false and
    ; `!isGenericMappedType(t)` is the constant true this reduction leaves out"*,
    ; and slice 121 gives that flag its writer.
    ;
    ; ★★★ THERE WERE TWO COPIES OF THIS FUNCTION, WITH ONE SYMBOL. Slice 120 wrote
    ; a second `is_empty_object_type(this, t: ref[Type])` 19 000 lines further down;
    ; identical signature, so the planner kept ONE and slice 120's body was DEAD —
    ; its callers ran this one. Nothing said so: not the compiler, not any of the
    ; six yardsticks, not `stops.sh` (both bodies stop on the intersection arm, and
    ; each carries a DIFFERENT tag — `empty-object-type-intersection` could never
    ; fire and reads exactly like a row nothing reaches). See CLAUDE-lessons.md
    ; §3.5dm for the one-command check.
    procedure is_empty_object_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsObject) <> 0
        {
            if this.is_generic_mapped_type(t)
                return false
            if any_function_type <> null
            {
                if t = (any_function_type as ref[Type])
                    return false
            }
            let sm this.resolve_structured_type_members(t)
            if sm = null
                return false
            return Checker.is_empty_resolved_type(sm as ref[StructuredMembers])
        }
        if (t.flags & TypeFlagsNonPrimitive) <> 0
            return true
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let c list[i]
                if c <> null
                {
                    if this.is_empty_object_type(c as ref[Type])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            ; core.Every over the constituents.
            ;
            ; ★★★ THE ROW STOOD ON *"Nothing mints an intersection"* — SLICE 121
            ; FALSIFIED IT AND `intersection_types_of` SITS IN THIS FILE. It is the
            ; same dead premise §3.5gn found under two contextual-type rows, and it
            ; is the reason this arm was a stop for thirty-eight slices: the note
            ; was a claim about a PRODUCER, and nothing in this apparatus re-checks
            ; one when a producer arrives.
            ;
            ; ★ EVERY over an EMPTY constituent list is TRUE, which is core.Every's
            ; own answer and not this port's convenience — but a null list is a
            ; failure to read the type and answers false, as the union arm does.
            let types Checker.intersection_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let c list[i]
                if c = null
                    return false
                if this.is_empty_object_type(c as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        false
    }

    ; isEmptyResolvedType. ★Its first conjunct is `t != c.anyFunctionType`, and
    ; anyFunctionType is one of the eleven marker object types NewChecker builds
    ; that still have no reader here (initialize_intrinsic_types' header) — so the
    ; comparison is a constant TRUE and is left out with its reason rather than
    ; written against a type that does not exist.
    ; isEmptyResolvedType — the NAMED members (`properties`, which excludes the
    ; reserved names such as `__constructor`), the signatures and the index infos.
    ; ★It counted the whole member TABLE until slice 202, so a class with a
    ; constructor and nothing else was not empty and `d = { foo: '' }` against it
    ; reported an excess property (`classWithEmptyBody`). The anyFunctionType
    ; exclusion is asked by is_empty_object_type, the one caller that can meet it.
    function is_empty_resolved_type(sm: ref[StructuredMembers]) returns bool
    {
        if sm.properties <> null
        {
            if ((sm.properties as ref[Array[ref[Symbol]?]]).get_length() as int) <> 0
                return false
        }
        if sm.signatures <> null
        {
            if ((sm.signatures as ref[Array[ref[Signature]?]]).get_length() as int) <> 0
                return false
        }
        if sm.index_infos <> null
        {
            if ((sm.index_infos as ref[Array[ref[IndexInfo]?]]).get_length() as int) <> 0
                return false
        }
        true
    }

    ; addOptionalityEx, whole since slice 94. It stands behind strictNullChecks,
    ; which is TRUE here, so `x?: string` reaches getOptionalType and `x: string`
    ; does not.
    ;
    ; ★ The line that stood here said *"getOptionalType is a UNION and this port has
    ; none, so the optional half is one report"* — the union chapter is what retires
    ; it, and this is the site where the difference is visible in the T section: an
    ; optional parameter or property now prints `T | undefined` instead of stopping.
    procedure add_optionality_ex(this, t: ref[Type], is_property: bool, is_optional: bool) returns ref[Type]?
    {
        if Checker.strict_null_checks()
        {
            if is_optional
                return this.get_optional_type(t, is_property)
        }
        t
    }

    ; ── getTypeFromTypeNode, and the arms that need no printer ───────────────
    ;
    ; ★★★ THE KEYWORD ARMS ARE PORTED AND NOTHING ELSE, and the boundary is the one
    ; type_to_string already draws: an intrinsic answers a NAME the printer prints
    ; unchanged, and every other arm makes a type the printer cannot render. So the
    ; two halves of the checker dimension are cut at the same place, on purpose —
    ; porting an arm here whose result the T section cannot print would move a unit
    ; from an honest UNPORTED to a FAIL.
    ;
    ; ★ The `get-type-from-type-node` tag is NOT new: eleven call sites in this file
    ; already report it, and they keep reporting it for the arms below that stay
    ; unported. What changes is that the tag names the ARMS rather than the
    ; function.
    procedure try_get_type_from_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let type_node AstNode.type_of(node)
        if type_node = null
            return null
        this.get_type_from_type_node(type_node as ref[AstNode])
    }

    procedure get_type_from_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let t this.get_type_from_type_node_worker(node)
        if t = null
            return null
        this.get_conditional_flow_type_of_type(t as ref[Type], node)
    }

    procedure get_type_from_type_node_worker(this, node: ref[AstNode]) returns ref[Type]?
    {
        let k AstNode.kind_of(node)
        if k = KindAnyKeyword
            return any_type
        if k = KindJSDocAllType
            return any_type
        if k = KindUnknownKeyword
            return unknown_type
        if k = KindStringKeyword
            return string_type
        if k = KindNumberKeyword
            return number_type
        if k = KindBigIntKeyword
            return bigint_type
        if k = KindSymbolKeyword
            return es_symbol_type
        if k = KindVoidKeyword
            return void_type
        if k = KindUndefinedKeyword
            return undefined_type
        if k = KindNullKeyword
            return null_type
        if k = KindNeverKeyword
            return never_type
        if k = KindObjectKeyword
            return non_primitive_type
        if k = KindIntrinsicKeyword
            return intrinsic_marker_type
        ; ★★★ KindBooleanKeyword ARRIVES IN SLICE 94 AND ITS OLD NOTE NAMED THE
        ; EXPIRY DATE: *"booleanType is a UNION of the two boolean literal types ...
        ; so the keyword reports with its neighbours"*. It is the one keyword arm in
        ; this table whose answer is not an intrinsic, and it prints as a bare
        ; keyword anyway — see type_to_string's Boolean arm for the one line that
        ; makes that true. ★The TypePredicate arm the same sentence deferred is
        ; STILL not here: its other half is voidType and its guard is a type
        ; predicate NODE, which this table has no arm for at all.
        if k = KindBooleanKeyword
            return boolean_type
        ;
        ; ★ ParenthesizedType and the three JSDoc wrappers RECURSE into
        ; getTypeFromTypeNode and would work; they are left out deliberately,
        ; because each is a one-line forward whose value is exactly the inner arm's,
        ; so porting them buys nothing this slice can print and costs a row the work
        ; list would then have to explain twice.
        ;
        ; ★★★ SLICE 80 ADDS THE THREE KINDS THAT SHARE ONE FUNCTION, and it is the
        ; first arm here whose answer the T section CANNOT print. The header above
        ; drew this table's boundary at *"porting an arm here whose result the T
        ; section cannot print would move a unit from an honest UNPORTED to a
        ; FAIL"*, and that sentence is one step short: type_to_string does not
        ; invent a name for an object type, its tail RECORDS `type-to-string` with
        ; the type's FLAGS and answers false, and TypeDump's one call site drops
        ; the line on false without writing it into the real sink. So the unit
        ; stays UNPORTED and only the TAG moves — from this table to the printer,
        ; which is where the missing dimension actually is.
        ; ★★★ KindUnionType, SLICE 94, AND IT IS THE ARM THAT MAKES THE UNION
        ; CHAPTER VISIBLE IN THE T SECTION. Every other consumer of a union in this
        ; slice reaches it through an inference (getOptionalType, getWidenedLiteral
        ; Type); this is the one where the SOURCE says `string | undefined` and the
        ; dump prints what we answer. It is the second-largest row of this table at
        ; stage 1.
        if k = KindUnionType
            return this.get_type_from_union_type_node(node)
        ; ★★★ KindIntersectionType, SLICE 121. checkUnionOrIntersectionType has
        ; called getTypeFromTypeNode for both halves since slice 94 and the note
        ; beside it recorded the split: *"the INTERSECTION half still stops, inside
        ; getTypeFromTypeNode's tail and under its own kind"*. This is that arm.
        if k = KindIntersectionType
            return this.get_type_from_intersection_type_node(node)
        if k = KindIndexedAccessType
            return this.get_type_from_indexed_access_type_node(node)
        if k = KindConditionalType
            return this.get_type_from_conditional_type_node(node)
        if k = KindInferType
            return this.get_type_from_infer_type_node(node)
        ; ★ KindMappedType, slice 125 — one forward, and the whole chapter behind
        ; it. It sits where the reference's switch puts it, beside the type
        ; literal, because a mapped type IS the second brace form.
        if k = KindMappedType
            return this.get_type_from_mapped_type_node(node)
        if k = KindTypeLiteral
            return this.get_type_from_type_literal_or_function_or_constructor_type_node(node)
        if k = KindFunctionType
            return this.get_type_from_type_literal_or_function_or_constructor_type_node(node)
        if k = KindConstructorType
            return this.get_type_from_type_literal_or_function_or_constructor_type_node(node)
        ; ★★★ KindTypeReference, SLICE 95 — the head of the work list by both
        ; measures, and the arm every `Foo`, `T` and `Array<T>` in an annotation
        ; stands behind. See the chapter's own header for what the 520 arrivals at
        ; this line split into and why four of the six ways out are stops.
        ; ★★★ ExpressionWithTypeArguments SHARES THIS ARM UPSTREAM (`case
        ; ast.KindTypeReference, ast.KindExpressionWithTypeArguments`) and slice 127
        ; routes it here. The note that stood in its place — *its arrivals come
        ; through checkExpressionWithTypeArguments, which is a different wall* —
        ; described where the arrivals CAME FROM and not what the arm answers; the
        ; heritage clause of every `class D extends B` and `interface I extends J`
        ; is one of these nodes, and get_type_reference_name has carried its arm
        ; since slice 95, so the reference's own one-line share is the port's too.
        if k = KindTypeReference
            return this.get_type_from_type_reference(node)
        if k = KindExpressionWithTypeArguments
            return this.get_type_from_type_reference(node)
        ; ★★★ SLICE 115 — THE ARRAY AND THE TUPLE, plus the seven arms that are one
        ; forward each and were left out with an argument that this slice retires.
        ;
        ; ★★★ THE PARENTHESIZED / JSDoc WRAPPER NOTE EXPIRED. It read *"each is a
        ; one-line forward whose value is exactly the inner arm's, so porting them
        ; buys nothing this slice can print and costs a row the work list would then
        ; have to explain twice"* — true while the inner arms were keywords, and
        ; false the moment `(A | B)[]` became nameable: a PARENTHESIZED element of an
        ; array type is the ordinary spelling of that type, and 6 units stop on it.
        if k = KindParenthesizedType
        {
            let inner AstNode.parenthesized_type_inner_of(node)
            if inner = null
                return null
            return this.get_type_from_type_node(inner as ref[AstNode])
        }
        if k = KindArrayType
            return this.get_type_from_array_or_tuple_type_node(node)
        if k = KindTupleType
            return this.get_type_from_array_or_tuple_type_node(node)
        if k = KindOptionalType
            return this.get_type_from_optional_type_node(node)
        if k = KindRestType
            return this.get_type_from_rest_type_node(node)
        if k = KindNamedTupleMember
            return this.get_type_from_named_tuple_type_node(node)
        if k = KindLiteralType
            return this.get_type_from_literal_type_node(node)
        if k = KindTypeOperator
            return this.get_type_from_type_operator_node(node)
        ; ★★★ SLICE 126 — the TEMPLATE LITERAL type node. It was the two biggest
        ; rows of this switch's stop (TemplateLiteralType 108 events,
        ; TemplateLiteralTypeSpan 112).
        if k = KindTemplateLiteralType
            return this.get_type_from_template_type_node(node)
        ; ★★ THE TYPE PREDICATE IS TWO KEYWORDS AND SLICE 94 NAMED IT: *"its other
        ; half is voidType and its guard is a type predicate NODE, which this table
        ; has no arm for at all"*. Both halves are here now, and the guard is the
        ; `asserts` modifier — `asserts x is T` denotes void, `x is T` denotes
        ; boolean, and neither reads the type at all.
        if k = KindTypePredicate
        {
            if AstNode.type_predicate_asserts_modifier_of(node) <> null
                return void_type
            return boolean_type
        }
        ; ★★★ SLICE 133 — the TYPE QUERY. `typeof x` is the one arm of this switch
        ; whose answer comes from the EXPRESSION side, so it was a chapter of its
        ; own until checkExpressionWithTypeArguments arrived; see that function.
        if k = KindTypeQuery
            return this.get_type_from_type_query_node(node)
        ; ★★★ SLICE 137 — THE FOUR JSDoc WRAPPERS, and the note that left them out
        ; EXPIRED for the reason the Parenthesized one's did two slices earlier. It
        ; read *"each is a one-line forward whose value is exactly the inner arm's,
        ; so porting them buys nothing this slice can print"*, which was true while
        ; the inner arms were keywords. Two of the four are NOT forwards at all —
        ; `?T` adds null and `...T` builds an array — and the two that are carry the
        ; `get-type-from-type-node` row's largest event counts (312 and 311).
        if k = KindJSDocNonNullableType
            return this.try_get_type_from_type_node(node)
        if k = KindJSDocNullableType
        {
            let inner this.try_get_type_from_type_node(node)
            if inner = null
                return null
            if Checker.strict_null_checks() = false
                return inner
            return this.get_nullable_type(inner as ref[Type], TypeFlagsNull)
        }
        ; ★The variadic's inner type is NOT reached through `type_of`: see
        ; AstNode.jsdoc_variadic_inner_of, where the reference does the same.
        if k = KindJSDocVariadicType
        {
            let inner AstNode.jsdoc_variadic_inner_of(node)
            if inner = null
                return null
            return this.create_array_type(this.get_type_from_type_node(inner as ref[AstNode]))
        }
        if k = KindJSDocOptionalType
        {
            let inner this.try_get_type_from_type_node(node)
            if inner = null
                return null
            return this.add_optionality_ex(inner as ref[Type], false, true)
        }
        ; ★★★ SLICE 137 — `this`, AND THE TWO KINDS SHARE ONE ARM UPSTREAM (`case
        ; ast.KindThisType, ast.KindThisKeyword`). The second is what makes the arm
        ; reachable outside a type position at all: `getTypeOfNode` on a `this`
        ; EXPRESSION that is not in an expression context falls through to here, which
        ; is the fallthrough its own site spells out.
        if k = KindThisType
            return this.get_type_from_this_type_node(node)
        if k = KindThisKeyword
            return this.get_type_from_this_type_node(node)
        ; ★★★ SLICE 137 — THE IMPORT TYPE, the largest row of this switch BY UNITS.
        if k = KindImportType
            return this.get_type_from_import_type_node(node)
        ; ★★★ AND THE `default` ARM IS `c.errorType`, NOT A STOP — the switch is
        ; COMPLETE now, so a kind that reaches this line is one the reference itself
        ; has no arm for, and answering the error type is what it does. The tag stays
        ; alive at the three OTHER sites that raise it, which is why it does not
        ; disappear from the histogram.
        error_type
    }

    ; ── the IMPORT TYPE (slice 137) ─────────────────────────────────────────
    ;
    ; getTypeFromImportTypeNode, whole. `import("m").A.B` and `typeof import("m").x`.
    ;
    ; ★★★ EVERY FAILURE ARM WRITES `unknownSymbol` INTO THE NODE'S RESOLVED SYMBOL
    ; AND ANSWERS THE ERROR TYPE, and the pair is one act rather than two: a later
    ; reader that finds no resolved symbol at all would ask again and report again,
    ; where one that finds the unknown symbol stops quietly. That is why the arms are
    ; not folded into a single `return error_type`.
    ;
    ; ★★ THE MEANING IS DECIDED BY `typeof` AND CARRIED TO THE LAST NAME ONLY: every
    ; segment but the final one is looked up as a NAMESPACE, because `import("m").a.b`
    ; walks module members and only the tail is the thing being named.
    procedure get_type_from_import_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let argument AstNode.import_type_argument_of(node)
        ; ast.IsLiteralImportTypeNode — the argument must be a LiteralType whose
        ; literal is a string. Anything else is `import(SomeType)`, which parses.
        var literal: ref[AstNode]? null
        if argument <> null
        {
            let a argument as ref[AstNode]
            if AstNode.kind_of(a) = KindLiteralType
            {
                let lit AstNode.literal_type_inner_of(a)
                if lit <> null
                {
                    if AstNode.kind_of(lit as ref[AstNode]) = KindStringLiteral
                        set literal: lit
                }
            }
        }
        if literal = null
        {
            this.error_on_node(argument, DiagString_literal_expected)
            return this.fail_import_type(node, links)
        }
        var target_meaning SymbolFlagsType
        if AstNode.import_type_is_type_of(node)
            set target_meaning: SymbolFlagsValue
        let mark this.unported_mark()
        let inner this.resolve_external_module_name(node, literal, false)
        if this.unported_mark() <> mark
            return null
        if inner = null
            return this.fail_import_type(node, links)
        let module_symbol this.resolve_external_module_symbol(inner, false)
        if module_symbol = null
            return this.fail_import_type(node, links)
        let qualifier AstNode.import_type_qualifier_of(node)
        if Parser.node_is_missing(qualifier) = false
        {
            if qualifier = null
                return this.fail_import_type(node, links)
            let chain &Array[ref[AstNode]?]^host()
            this.append_identifier_chain(chain, qualifier as ref[AstNode])
            let cn chain.get_length() as int
            var current module_symbol as ref[Symbol]
            var ci 0
            while ci < cn
            {
                let seg chain[ci]
                if seg = null
                    return this.fail_import_type(node, links)
                let sg seg as ref[AstNode]
                var meaning SymbolFlagsNamespace
                if ci = cn - 1
                    set meaning: target_meaning
                set ci: ci + 1
                let merged this.get_merged_symbol(this.resolve_symbol(current))
                if merged = null
                    return this.fail_import_type(node, links)
                let mg merged as ref[Symbol]
                var next: ref[Symbol]? null
                if AstNode.import_type_is_type_of(node)
                {
                    let ct this.get_type_of_symbol(mg)
                    if this.unported_mark() <> mark
                        return null
                    if ct <> null
                        set next: this.get_property_of_type_ex(ct as ref[Type], AstNode.identifier_text_of(sg), false, true)
                }
                else
                {
                    ; ★★ THE COMMONJS `export=`-ALONGSIDE-TYPEDEFS FALLBACK IS THE
                    ; REFERENCE'S OWN `!!!` — an unfinished line upstream — and it is
                    ; left out here for that reason rather than transcribed: porting a
                    ; marked-incomplete branch would pin behaviour the reference does
                    ; not itself stand behind.
                    set next: this.get_symbol_in_table(this.get_exports_of_symbol(mg), AstNode.identifier_text_of(sg), meaning)
                    if this.unported_mark() <> mark
                        return null
                }
                if next = null
                {
                    this.error_on_node(sg, DiagNamespace_0_has_no_exported_member_1, this.fully_qualified_name_arg(mg), this.declaration_name_to_string(sg))
                    set links.resolved_type: error_type
                    return links.resolved_type
                }
                ; Both the segment and its PARENT get the symbol: the parent of the
                ; last identifier of `a.b` is the QualifiedName, and a reader that
                ; lands on either must find the same answer.
                let sn this.symbol_node_link_of(sg)
                set sn.resolved_symbol: next
                let pn AstNode.parent_node_of(sg)
                if pn <> null
                {
                    let pl this.symbol_node_link_of(pn as ref[AstNode])
                    set pl.resolved_symbol: next
                }
                set current: next as ref[Symbol]
            }
            let t this.resolve_import_symbol_type(node, current, target_meaning)
            if this.unported_mark() <> mark
                return null
            set links.resolved_type: t
            return links.resolved_type
        }
        if (this.get_symbol_flags(module_symbol as ref[Symbol]) & target_meaning) <> 0
        {
            let t this.resolve_import_symbol_type(node, module_symbol as ref[Symbol], target_meaning)
            if this.unported_mark() <> mark
                return null
            set links.resolved_type: t
            return links.resolved_type
        }
        var code DiagModule_0_does_not_refer_to_a_type_but_is_used_as_a_type_here_Did_you_mean_typeof_import_0
        if target_meaning = SymbolFlagsValue
            set code: DiagModule_0_does_not_refer_to_a_value_but_is_used_as_a_value_here
        this.error_on_node(node, code, Checker.arg_text(AstNode.literal_text_of(literal)))
        this.fail_import_type(node, links)
    }

    ; The three lines every failure arm of getTypeFromImportTypeNode ends with.
    procedure fail_import_type(this, node: ref[AstNode], links: ref[TypeNodeLink]) returns ref[Type]?
    {
        let sn this.symbol_node_link_of(node)
        set sn.resolved_symbol: unknown_symbol
        set links.resolved_type: error_type
        links.resolved_type
    }

    ; getIdentifierChain, as an APPEND rather than a return — the reference builds
    ; the list by appending its own recursion's result, which is this in the shape
    ; this language has.
    procedure append_identifier_chain(this, out: ref[Array[ref[AstNode]?]], node: ref[AstNode])
    {
        if AstNode.kind_of(node) = KindIdentifier
        {
            out.add(node)
            return
        }
        let left AstNode.qualified_left_of(node)
        if left <> null
            this.append_identifier_chain(out, left as ref[AstNode])
        let right AstNode.qualified_right_of(node)
        if right <> null
            out.add(right)
    }

    ; resolveImportSymbolType, whole.
    ;
    ; ★ The VALUE arm deliberately asks getTypeOfSymbol of the UNRESOLVED symbol —
    ; the reference's own comment says so (*"intentionally doesn't use resolved symbol
    ; so type is cached as expected on the alias"*) — while getTypeReferenceType needs
    ; the resolved one because it does not handle aliases.
    procedure resolve_import_symbol_type(this, node: ref[AstNode], symbol: ref[Symbol], meaning: int) returns ref[Type]?
    {
        let resolved this.resolve_symbol(symbol)
        let sn this.symbol_node_link_of(node)
        set sn.resolved_symbol: resolved
        if meaning = SymbolFlagsValue
        {
            let t this.get_type_of_symbol(symbol)
            if t = null
                return null
            return this.get_instantiation_expression_type(t as ref[Type], node)
        }
        if resolved = null
            return null
        this.get_type_reference_type(node, resolved as ref[Symbol])
    }

    ; getSymbol — a table lookup that is FILTERED BY MEANING, which is what makes it
    ; more than SymbolTable.get. ★The alias arm is the second half: an alias whose
    ; TARGET carries the meaning answers, and `getSymbolFlags` returns SymbolFlagsAll
    ; when the alias resolution itself failed, which the reference relies on to avoid
    ; cascading a second report out of one broken import.
    procedure get_symbol_in_table(this, symbols: ref[SymbolTable]?, d: Slice[char], meaning: int) returns ref[Symbol]?
    {
        if (meaning & SymbolFlagsAll) = 0
            return null
        let found this.get_merged_symbol(SymbolTable.get(symbols, d))
        if found = null
            return null
        let f found as ref[Symbol]
        if (Symbol.flags_of(f) & meaning) <> 0
            return f
        if (Symbol.flags_of(f) & SymbolFlagsAlias) = 0
            return null
        if (this.get_symbol_flags(f) & meaning) <> 0
            return f
        null
    }

    ; ── getTypeFromThisTypeNode and getThisType (slice 137) ─────────────────
    ;
    ; ★★★ THE MEMO IS THE POINT OF THE OUTER FUNCTION AND NOT DECORATION: getThisType
    ; REPORTS on failure, so a second ask of one `this` would emit TS2526 twice, and
    ; diagcheck's relation is a SUBSEQUENCE — an extra line is the one thing it fails
    ; on. Both call sites (the type-node switch and checkThisType) reach the same node.
    procedure get_type_from_this_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let t this.get_this_type(node)
        set links.resolved_type: t
        t
    }

    ; getThisType, whole.
    ;
    ; ★★★ ITS THREE CONDITIONS ARE ONE SENTENCE AND EACH IS A DIFFERENT QUESTION: the
    ; container's PARENT has to be a class or an interface (a `this` in a free
    ; function has no home type), the container may not be STATIC (a static member's
    ; `this` is the constructor, not the instance), and a CONSTRUCTOR is admitted only
    ; for a node inside its BODY — a `this` in a constructor's parameter list or
    ; return annotation is outside the instance the constructor is building.
    ;
    ; ★★ THE ANSWER IS THE INTERFACE TYPE'S OWN `thisType` SLOT, which
    ; get_declared_type_of_class_or_interface fills only where the declaration needs
    ; one; the reference's `core.Coalesce(..., c.errorType)` is what says so, and it
    ; is the null case here.
    procedure get_this_type(this, node: ref[AstNode]) returns ref[Type]?
    {
        let container Binder.get_this_container(node, false, false)
        if container <> null
        {
            let cn container as ref[AstNode]
            let parent AstNode.parent_node_of(cn)
            if parent <> null
            {
                let pn parent as ref[AstNode]
                var class_like_or_interface false
                if Checker.is_class_like(pn)
                    set class_like_or_interface: true
                if AstNode.kind_of(pn) = KindInterfaceDeclaration
                    set class_like_or_interface: true
                if class_like_or_interface
                {
                    if b.is_static(cn) = false
                    {
                        var in_scope true
                        if AstNode.kind_of(cn) = KindConstructor
                            set in_scope: Checker.is_node_descendant_of(node, AstNode.body_of(cn))
                        if in_scope
                        {
                            let sym this.get_symbol_of_declaration(pn)
                            if sym = null
                                return error_type
                            let declared this.get_declared_type_of_class_or_interface(sym as ref[Symbol])
                            if declared = null
                                return error_type
                            let tt Checker.this_type_of(declared as ref[Type])
                            if tt = null
                                return error_type
                            return tt
                        }
                    }
                }
            }
        }
        this.error_on_node(node, DiagA_this_type_is_available_only_in_a_non_static_member_of_a_class_or_interface)
        error_type
    }

    ; ── the tuple element wrappers ──────────────────────────────────────────
    ;
    ; getTypeFromOptionalTypeNode, getTypeFromRestTypeNode and
    ; getTypeFromNamedTupleTypeNode.
    ;
    ; ★★★ ALL THREE ARE ONLY LEGAL INSIDE A TUPLE, and what they denote is the
    ; element type with the marker STRIPPED — the marker itself lives in the tuple
    ; target's element infos, which is why `[a?: string]`'s member type is `string`
    ; and the optionality is on the SYMBOL.
    ;
    ; ★★★ ALL THREE PASS isProperty TRUE, AND THE FIRST DRAFT OF THIS BLOCK PASSED
    ; FALSE. `addOptionality(t)` is the isProperty-FALSE wrapper and NOT what any of
    ; these calls — reading the wrapper's name instead of the call site put the
    ; MISSING type where undefined belongs, which is a different type with the same
    ; printed name in most positions. The three reference lines are
    ; `addOptionalityEx(…, true, …)` every time.
    procedure get_type_from_optional_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let inner AstNode.optional_type_inner_of(node)
        if inner = null
            return null
        let t this.get_type_from_type_node(inner as ref[AstNode])
        if t = null
            return null
        this.add_optionality_ex(t as ref[Type], true, true)
    }

    ; getTypeFromRestTypeNode. ★★★ THE ARRAY PROBE IS APPLIED TO THE REST NODE'S
    ; *TYPE*, NOT TO THE REST NODE — `getArrayElementTypeNode(node.Type())` — and the
    ; first draft asked it of `node`, where the function has no RestType arm at all
    ; and answers null unconditionally. The effect is exactly one level of array:
    ; `...T[]` denoted `T[]` instead of `T`, silently, on every rest element in the
    ; corpus. ★It reads `node.Type()` so that getTypeFromNamedTupleTypeNode can hand
    ; it a NAMED MEMBER, whose `Type()` is the member's annotation.
    procedure get_type_from_rest_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        var type_node AstNode.rest_type_inner_of(node)
        if AstNode.kind_of(node) = KindNamedTupleMember
            set type_node: AstNode.type_of(node)
        if type_node = null
            return null
        let element Checker.array_element_type_node_of(type_node)
        if element <> null
            set type_node: element
        this.get_type_from_type_node(type_node as ref[AstNode])
    }

    procedure get_type_from_named_tuple_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        if AstNode.dot_dot_dot_token_of(node) <> null
        {
            let rest this.get_type_from_rest_type_node(node)
            if rest = null
                return null
            set links.resolved_type: rest
            return links.resolved_type
        }
        let type_node AstNode.type_of(node)
        if type_node = null
            return null
        let t this.get_type_from_type_node(type_node as ref[AstNode])
        if t = null
            return null
        let with_opt this.add_optionality_ex(t as ref[Type], true, AstNode.question_token_of(node) <> null)
        if with_opt = null
            return null
        set links.resolved_type: with_opt
        links.resolved_type
    }

    ; getTypeFromLiteralTypeNode, whole — and it is the largest single arm of this
    ; table by units (47), because a literal type is what every `"a" | "b"` and every
    ; `const x: 0` in the corpus is made of.
    ;
    ; ★ The NULL keyword is answered BEFORE the memo, which is the reference's order
    ; and not an optimisation: `null` as a literal type node is the nullType, a
    ; type nothing else in this table would give it.
    procedure get_type_from_literal_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let literal AstNode.literal_type_inner_of(node)
        if Checker.kind_or_unknown(literal) = KindNullKeyword
            return null_type
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        if literal = null
            return null
        let mark this.unported_mark()
        let t this.check_expression(literal as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        let regular this.get_regular_type_of_literal_type(t as ref[Type])
        if regular = null
            return null
        set links.resolved_type: regular
        links.resolved_type
    }

    ; getTypeFromTypeOperatorNode. ★★ TWO OF THE THREE ARMS ARE HERE AND THE THIRD
    ; IS ITS OWN CHAPTER: `readonly T` denotes exactly `T` (the readonly-ness is
    ; read by getArrayOrTupleTargetType off the PARENT), `unique symbol` needs
    ; getESSymbolLikeTypeForNode, and `keyof` is getIndexType — which already has a
    ; tag of its own, so the row does not move.
    procedure get_type_from_type_operator_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let inner AstNode.type_operator_inner_of(node)
        let op AstNode.type_operator_operator_of(node)
        if op = KindReadonlyKeyword
        {
            if inner = null
                return null
            let t this.get_type_from_type_node(inner as ref[AstNode])
            if t = null
                return null
            set links.resolved_type: t
            return links.resolved_type
        }
        ; ★★★ `keyof`, SLICE 121. The note above this function said *"`keyof` is
        ; getIndexType — which already has a tag of its own, so the row does not
        ; move"*, and this is the arm that closes it.
        if op = KindKeyOfKeyword
        {
            if inner = null
                return null
            let arg this.get_type_from_type_node(inner as ref[AstNode])
            if arg = null
                return null
            let t this.get_index_type(arg as ref[Type])
            if t = null
                return null
            set links.resolved_type: t
            return links.resolved_type
        }
        if op = KindUniqueKeyword
        {
            ; The reference's fork: a `unique symbol` answers
            ; getESSymbolLikeTypeForNode of the enclosing declaration, and anything
            ; else answers errorType. ★The note that stood here said the first half
            ; *is not portable* — slice 146 is the producer, and this is the arm the
            ; note named as its expiry.
            if Checker.kind_or_unknown(inner) <> KindSymbolKeyword
            {
                set links.resolved_type: error_type
                return links.resolved_type
            }
            let u this.get_es_symbol_like_type_for_node(Checker.walk_up_parenthesized_types(AstNode.parent_node_of(node)))
            if u = null
                return null
            set links.resolved_type: u
            return links.resolved_type
        }
        ; "Unhandled case in getTypeFromTypeOperatorNode" — the reference panics.
        this.record_unported("get-type-from-type-operator-node", op)
        null
    }

    ; ── slice 115: the ARRAY and the TUPLE ──────────────────────────────────
    ;
    ; ★★★ THE CHAPTER IS ONE FUNCTION WITH A TYPE FACTORY UNDER IT.
    ; getTypeFromArrayOrTupleTypeNode is twenty-eight lines; what it needs is a
    ; TARGET, and for a tuple the reference SYNTHESIZES one — a generic interface
    ; with no symbol, one type parameter per element, a numbered property per FIXED
    ; element and a `length` whose type is a union of number literals. That factory
    ; is the slice.
    ;
    ; ★★★ AND IT IS THE SLICE A DOZEN LINES OF THIS FILE NAMED AS THEIR EXPIRY.
    ; `new_object_type`'s Tuple arm, `get_base_types`' Tuple arm, `is_tuple_type`,
    ; `is_array_or_tuple_type`, `create_normalized_type_reference`,
    ; `get_parameter_count`, `get_effective_rest_type`, the two padding arms of
    ; `check_declaration_initializer`, `write_signature_form`'s expandedParams
    ; proof, `get_base_constraint_of_type`'s isGenericTupleType proof, the printer's
    ; `type-to-string-array` / `type-to-string-tuple` / `type-to-string-alias-array`
    ; stops and the ElementFlags composites' §3.5be note — every one of them says
    ; *nothing here mints a tuple*, and every one is answered in this commit
    ; rather than left to be discovered.

    ; ── the tuple's payload, read through the FLAG ──────────────────────────
    ;
    ; ★★★ EVERY ONE OF THESE ASKS `object_flags & ObjectFlagsTuple` FIRST, and the
    ; guard is not defensive — it is the reference's `AsTupleType()` downcast. The
    ; five slots live on InterfaceTypeData (see its header for why), so an ordinary
    ; interface would answer a zero here that a zero-arity tuple cannot be told
    ; apart from.
    function is_tuple_target(t: ref[Type]) returns bool
        (t.object_flags & ObjectFlagsTuple) <> 0

    function tuple_element_infos_of(t: ref[Type]) returns ref[Array[ref[TupleElementInfo]?]]?
    {
        if Checker.is_tuple_target(t) = false
            return null
        choose t.data
            when d: Interface
                return d.element_infos
        null
    }

    function tuple_arity_of(t: ref[Type]) returns int
    {
        let infos Checker.tuple_element_infos_of(t)
        if infos = null
            return 0
        (infos as ref[Array[ref[TupleElementInfo]?]]).get_length() as int
    }

    function tuple_element_flags_at(t: ref[Type], index: int) returns int
    {
        let infos Checker.tuple_element_infos_of(t)
        if infos = null
            return ElementFlagsNone
        let list infos as ref[Array[ref[TupleElementInfo]?]]
        if index < 0
            return ElementFlagsNone
        if index >= (list.get_length() as int)
            return ElementFlagsNone
        let e list[index]
        if e = null
            return ElementFlagsNone
        (e as ref[TupleElementInfo]).flags
    }

    function tuple_labeled_declaration_at(t: ref[Type], index: int) returns ref[AstNode]?
    {
        let infos Checker.tuple_element_infos_of(t)
        if infos = null
            return null
        let list infos as ref[Array[ref[TupleElementInfo]?]]
        if index < 0
            return null
        if index >= (list.get_length() as int)
            return null
        let e list[index]
        if e = null
            return null
        (e as ref[TupleElementInfo]).labeled_declaration
    }

    function tuple_combined_flags_of(t: ref[Type]) returns int
    {
        if Checker.is_tuple_target(t) = false
            return ElementFlagsNone
        choose t.data
            when d: Interface
                return d.combined_flags
        ElementFlagsNone
    }

    function tuple_fixed_length_of(t: ref[Type]) returns int
    {
        if Checker.is_tuple_target(t) = false
            return 0
        choose t.data
            when d: Interface
                return d.fixed_length
        0
    }

    function tuple_min_length_of(t: ref[Type]) returns int
    {
        if Checker.is_tuple_target(t) = false
            return 0
        choose t.data
            when d: Interface
                return d.min_length
        0
    }

    function tuple_readonly_of(t: ref[Type]) returns bool
    {
        if Checker.is_tuple_target(t) = false
            return false
        choose t.data
            when d: Interface
                return d.readonly
        false
    }

    ; The one writer. `when` binds a COPY, so it is copy / mutate / put the arm
    ; back — the direct spelling stores through the payload's first eight bytes
    ; (mark_this_type's note).
    procedure fill_tuple_data(t: ref[Type], infos: ref[Array[ref[TupleElementInfo]?]]?, min_length: int, fixed_length: int, combined_flags: int, readonly: bool)
    {
        choose t.data
            when i: Interface
            {
                var d i
                set d.element_infos: infos
                set d.min_length: min_length
                set d.fixed_length: fixed_length
                set d.combined_flags: combined_flags
                set d.readonly: readonly
                set t.data: TypeData.Interface(d)
            }
    }

    ; ── the tuple TARGET ────────────────────────────────────────────────────
    ;
    ; ★★★ A TUPLE TYPE IS A REFERENCE TO A SYNTHESIZED GENERIC INTERFACE, and the
    ; reference's own comment is the whole design:
    ;
    ;     interface Tuple<T0, T1, T2, ...> extends Array<T0 | T1 | T2 | ...>
    ;         { 0: T0, 1: T1, 2: T2, ... }
    ;
    ; So `[string, number]` is `Tuple<string, number>` over a target minted here,
    ; and the elements are TYPE ARGUMENTS. Nothing about it carries a symbol —
    ; neither the interface nor any of its type parameters — which is what makes it
    ; a factory rather than a declaration.
    ;
    ; ★★★ AND IT IS WHY `resolve_declared_members` MUST NOT RUN ON ONE. That
    ; function's second line is `this.get_members_of_symbol(t.symbol as ref[Symbol])`
    ; — an unwrap, so exit 21 on a symbol-less type. The reference sidesteps it by
    ; setting `declaredMembersResolved = true` before anyone can ask; here the
    ; record's PRESENCE is that bit (DeclaredMembers' own header), so the factory
    ; attaches it and the unwrap is never reached. **A type with no symbol that
    ; reaches the declared-members path is an exit 21 with no source location.**
    procedure get_tuple_target_type(this, infos: ref[Array[ref[TupleElementInfo]?]], readonly: bool) returns ref[Type]?
    {
        let n infos.get_length() as int
        ; `[...X[]]` is equivalent to just `X[]` — the reference's own first line,
        ; and it is what keeps a one-element rest tuple from minting a target whose
        ; only property would be the array's.
        if n = 1
        {
            if (Checker.tuple_info_flags_at(infos, 0) & ElementFlagsRest) <> 0
            {
                if readonly
                    return this.get_global_readonly_array_type()
                return this.get_global_array_type()
            }
        }
        let cached this.find_tuple_target(tuple_targets, infos, readonly)
        if cached <> null
            return cached
        let made this.create_tuple_target_type(infos, readonly)
        if made = null
            return null
        let row &TupleTarget^host(infos, readonly, made)
        tuple_targets.add(row)
        made
    }

    function tuple_info_flags_at(infos: ref[Array[ref[TupleElementInfo]?]], index: int) returns int
    {
        let e infos[index]
        if e = null
            return ElementFlagsNone
        (e as ref[TupleElementInfo]).flags
    }

    ; getTupleKey, as a structural comparison — see the `tuple_targets` field for
    ; why there is no hash here. ★The reference's key distinguishes the four flag
    ; classes and the labelled DECLARATION, and nothing else; so does this.
    procedure find_tuple_target(this, rows: ref[Array[ref[TupleTarget]?]], infos: ref[Array[ref[TupleElementInfo]?]], readonly: bool) returns ref[Type]?
    {
        let n infos.get_length() as int
        let rn rows.get_length() as int
        while tuple_target_chain.count() < rn
        {
            let pending rows[tuple_target_chain.count() as size_t]
            if pending = null
                tuple_target_chain.add_blank()
            else
            {
                let pr pending as ref[TupleTarget]
                if pr.element_infos = null
                    tuple_target_chain.add_blank()
                else
                    tuple_target_chain.add(Checker.tuple_key_hash(pr.element_infos as ref[Array[ref[TupleElementInfo]?]], pr.readonly))
            }
        }
        var i tuple_target_chain.first(Checker.tuple_key_hash(infos, readonly))
        while i >= 0
        {
            let row rows[i]
            if row <> null
            {
                let r row as ref[TupleTarget]
                if r.readonly = readonly
                {
                    if r.element_infos <> null
                    {
                        let other r.element_infos as ref[Array[ref[TupleElementInfo]?]]
                        if (other.get_length() as int) = n
                        {
                            var same true
                            var j 0
                            while j < n
                            {
                                let a infos[j]
                                let b other[j]
                                if a = null
                                    set same: false
                                if b = null
                                    set same: false
                                if same
                                {
                                    let ai a as ref[TupleElementInfo]
                                    let bi b as ref[TupleElementInfo]
                                    if ai.flags <> bi.flags
                                        set same: false
                                    if ai.labeled_declaration <> bi.labeled_declaration
                                        set same: false
                                }
                                set j: j + 1
                            }
                            if same
                                return r.target
                        }
                    }
                }
            }
            set i: tuple_target_chain.after(i)
        }
        null
    }

    ; getTupleKey's parts as a hash: readonly, and per element its flags and its
    ; labelled declaration
    function tuple_key_hash(infos: ref[Array[ref[TupleElementInfo]?]], readonly: bool) returns int
    {
        var h: u64 14695981039346656037
        if readonly
            set h: h xor 1
        set h: h * 1099511628211
        let n infos.get_length() as int
        var j 0
        while j < n
        {
            let e infos[j]
            if e <> null
            {
                let ei e as ref[TupleElementInfo]
                set h: h xor (ei.flags as u64)
                set h: h * 1099511628211
                if ei.labeled_declaration <> null
                    set h: h xor ((ei.labeled_declaration as ref[AstNode]) as int as u64)
                set h: h * 1099511628211
            }
            set j: j + 1
        }
        ((h >> 1) as int)
    }

    ; createTupleTargetType, whole.
    ;
    ; ★★★ THE NUMBERED PROPERTIES STOP AT THE FIRST VARIABLE ELEMENT, and the test
    ; is on the ACCUMULATED flags rather than on this element's: once a rest or a
    ; variadic element has been seen, no later element has a fixed INDEX, so it gets
    ; no property. `fixed_length` is then literally the member count at that point,
    ; which is why the reference reads it off the table instead of counting again.
    ;
    ; ★★★ `length` IS THE ONE MEMBER EVERY TUPLE HAS AND ITS TYPE IS THE ARITY
    ; INFORMATION. With no variable element it is the union of the number literals
    ; minLength..arity — so `[string, number?]` answers `1 | 2` — and with one it is
    ; plain `number`. That union is the first thing in this chapter that needs
    ; get_union_type, and it is why the literal-type chapter (slice 71) had to come
    ; first.
    procedure create_tuple_target_type(this, infos: ref[Array[ref[TupleElementInfo]?]], readonly: bool) returns ref[Type]?
    {
        let arity infos.get_length() as int
        var min_length 0
        var mi 0
        while mi < arity
        {
            if (Checker.tuple_info_flags_at(infos, mi) & (ElementFlagsRequired | ElementFlagsVariadic)) <> 0
                set min_length: min_length + 1
            set mi: mi + 1
        }
        let members SymbolTable.create(host)
        let type_parameters this.new_type_list(null)
        var combined_flags ElementFlagsNone
        var member_count 0
        var i 0
        while i < arity
        {
            let type_parameter this.new_type_parameter(null)
            let tp: ref[Type]? type_parameter
            type_parameters.add(tp)
            let flags Checker.tuple_info_flags_at(infos, i)
            set combined_flags: combined_flags | flags
            if (combined_flags & ElementFlagsVariable) = 0
            {
                var sym_flags SymbolFlagsProperty
                if (flags & ElementFlagsOptional) <> 0
                    set sym_flags: sym_flags | SymbolFlagsOptional
                var check_flags 0
                if readonly
                    set check_flags: CheckFlagsReadonly
                var nd Slice[char]()
                set nd: Checker.decimal_name(host, i)
                let property this.new_symbol_ex(sym_flags, nd, check_flags)
                let plinks this.value_symbol_link_of(property)
                set plinks.resolved_type: type_parameter
                SymbolTable.set_entry(host, members, nd, property)
                set member_count: member_count + 1
            }
            set i: i + 1
        }
        let fixed_length member_count
        var ld Slice[char]()
        set ld: Checker.plain_name(host, "length")
        var length_check_flags 0
        if readonly
            set length_check_flags: CheckFlagsReadonly
        let length_symbol this.new_symbol_ex(SymbolFlagsProperty, ld, length_check_flags)
        let llinks this.value_symbol_link_of(length_symbol)
        if (combined_flags & ElementFlagsVariable) <> 0
            set llinks.resolved_type: number_type
        else
        {
            let literal_types &Array[ref[Type]?]()
            var k min_length
            while k <= arity
            {
                let lt: ref[Type]? this.get_number_literal_type(Checker.number_bits_from_int(k))
                literal_types.add(lt)
                set k: k + 1
            }
            let u this.get_union_type(literal_types)
            if u = null
                return null
            set llinks.resolved_type: u
        }
        SymbolTable.set_entry(host, members, ld, length_symbol)
        let made this.new_object_type(ObjectFlagsTuple | ObjectFlagsReference, null)
        if made = null
            return null
        let t made as ref[Type]
        let this_type this.new_type_parameter(null)
        Checker.mark_this_type(this_type)
        Checker.set_type_parameter_constraint(this_type, t)
        let all this.new_type_list(type_parameters)
        let this_arg: ref[Type]? this_type
        all.add(this_arg)
        let insts &Array[ref[TypeInstantiation]?]^host()
        let seed &TypeInstantiation^host(Checker.type_list_hash(type_parameters), type_parameters, t)
        insts.add(seed)
        ; ★ outer_type_parameter_count is 0: a synthesized tuple interface has no
        ; enclosing declaration, so every one of its type parameters is local.
        Checker.fill_interface_data(t, all, type_parameters, insts, 0, this_type)
        let dm &DeclaredMembers^host()
        set dm.members: members
        Checker.attach_declared_members(t, dm)
        Checker.fill_tuple_data(t, infos, min_length, fixed_length, combined_flags, readonly)
        t
    }

    ; ── getTypeFromArrayOrTupleTypeNode ─────────────────────────────────────
    ;
    ; ★★★ THE FUNCTION IS A FOUR-WAY FORK AND ONLY ONE ARM BUILDS ANYTHING. The
    ; target is `Array<T>`, `ReadonlyArray<T>` or a synthesized tuple interface;
    ; the empty-generic answer is the reference's own sentinel path (a unit with no
    ; `Array` in scope), the DEFERRED arm is a stop, and the last arm resolves the
    ; element types and makes the reference.
    ;
    ; ★★★ THE DEFERRED ARM STOPS BECAUSE ReferenceTypeData CARRIES NEITHER `mapper`
    ; NOR `node`, and that is not a slot to add on the way past:
    ; createDeferredTypeReference's whole point is that the type arguments are
    ; resolved LATER, off the node, which is exactly the branch
    ; `get_type_arguments` already reports as `get-type-arguments-deferred`. Adding
    ; the two slots without that reader would be a type whose arguments nothing can
    ; ever answer. ★Its guard is narrow: the node must sit inside a type ALIAS
    ; declaration AND its elements must be able to resolve one, so `type A =
    ; string[]` is NOT deferred and `type A = B[]` with `type B = …` is.
    ;
    ; ★ The zero-element tuple inside the deferred arm answers the TARGET itself,
    ; which is `[]` — a tuple interface of arity zero, whose only member is
    ; `length: 0`.
    procedure get_type_from_array_or_tuple_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let mark this.unported_mark()
        let target this.get_array_or_tuple_target_type(node)
        if target = null
            return null
        let tgt target as ref[Type]
        if tgt = empty_generic_type
        {
            set links.resolved_type: empty_object_type
            return links.resolved_type
        }
        let k AstNode.kind_of(node)
        let elements AstNode.elements_of(node)
        var element_count 0
        if elements <> null
            set element_count: (elements as ref[Array[ref[AstNode]?]]).get_length() as int
        ; `!(node.Kind == KindTupleType && Some(node.Elements(), isVariadicTupleElement))
        ; && c.isDeferredTypeReferenceNode(node, false)`
        var variadic_tuple false
        if k = KindTupleType
        {
            var i 0
            while i < element_count
            {
                if Checker.is_variadic_tuple_element((elements as ref[Array[ref[AstNode]?]])[i])
                    set variadic_tuple: true
                set i: i + 1
            }
        }
        if variadic_tuple = false
        {
            if this.is_deferred_type_reference_node(node, false)
            {
                if this.unported_mark() <> mark
                    return null
                if k = KindTupleType
                {
                    if element_count = 0
                    {
                        set links.resolved_type: target
                        return links.resolved_type
                    }
                }
                let deferred this.create_deferred_type_reference(tgt, node)
                if deferred = null
                    return null
                set links.resolved_type: deferred
                return links.resolved_type
            }
            if this.unported_mark() <> mark
                return null
        }
        let element_types this.new_type_list(null)
        if k = KindArrayType
        {
            let et AstNode.array_element_type_of(node)
            if et = null
                return null
            let t this.get_type_from_type_node(et as ref[AstNode])
            if t = null
                return null
            element_types.add(t)
        }
        else
        {
            var i 0
            while i < element_count
            {
                let e (elements as ref[Array[ref[AstNode]?]])[i]
                if e = null
                    return null
                let t this.get_type_from_type_node(e as ref[AstNode])
                if t = null
                    return null
                element_types.add(t)
                set i: i + 1
            }
        }
        var made: ref[Type]? null
        if (tgt.object_flags & ObjectFlagsTuple) <> 0
            set made: this.create_normalized_tuple_type_ex(tgt, element_types, ObjectFlagsFromTypeNode)
        else
            set made: this.create_type_reference(tgt, element_types, ObjectFlagsFromTypeNode)
        if made = null
            return null
        set links.resolved_type: made
        links.resolved_type
    }

    ; createDeferredTypeReference. ★★The two callers of the ARRAY/TUPLE chapter pass
    ; nil for both `mapper` and `alias`, which is what the short form below spells;
    ; ★★★the INSTANTIATION caller passes both, and the note that stood here — *the
    ; deferred half of the reference chapter, which has no producer* — was written
    ; at that call site while this producer sat four thousand lines above it
    ; (§3.5eo). The `alias.typeArguments = instantiateTypes(...)` line the old note
    ; called unreachable is now written, because that caller is the one it is for.
    procedure create_deferred_type_reference(this, target: ref[Type], node: ref[AstNode]) returns ref[Type]?
        this.create_deferred_type_reference_ex(target, node, null, null)

    procedure create_deferred_type_reference_ex(this, target: ref[Type], node: ref[AstNode], m: ref[TypeMapper]?, alias_in: ref[TypeAlias]?) returns ref[Type]?
    {
        var alias alias_in
        if alias = null
        {
            set alias: this.get_alias_for_type_node(node)
            if alias <> null
            {
                if m <> null
                {
                    let a alias as ref[TypeAlias]
                    set a.type_arguments: this.instantiate_types(a.type_arguments, m as ref[TypeMapper])
                }
            }
        }
        let made this.new_object_type(ObjectFlagsReference, target.symbol)
        if made = null
            return null
        let t made as ref[Type]
        if alias <> null
        {
            let a alias as ref[TypeAlias]
            set t.alias_symbol: a.symbol
            set t.alias_type_arguments: a.type_arguments
        }
        Checker.fill_deferred_reference_data(t, target, node, m)
        t
    }

    ; isVariadicTupleElement, one line.
    function is_variadic_tuple_element(node: ref[AstNode]?) returns bool
        (Checker.get_tuple_element_flags(node) & ElementFlagsVariadic) <> 0

    ; getArrayOrTupleTargetType, whole.
    ;
    ; ★ `getArrayElementTypeNode` is the SYNTACTIC probe slice 61 already wrote, and
    ; it is what makes `readonly string[]` and `[...string[]]` land on the same
    ; global: both spell an array, so both take the Array target and the tuple
    ; factory is not reached at all.
    procedure get_array_or_tuple_target_type(this, node: ref[AstNode]) returns ref[Type]?
    {
        let readonly Checker.is_readonly_type_operator(AstNode.parent_node_of(node))
        let element_type Checker.array_element_type_node_of(node)
        if element_type <> null
        {
            if readonly
                return this.get_global_readonly_array_type()
            return this.get_global_array_type()
        }
        let elements AstNode.elements_of(node)
        var n 0
        if elements <> null
            set n: (elements as ref[Array[ref[AstNode]?]]).get_length() as int
        let infos &Array[ref[TupleElementInfo]?]^host()
        var i 0
        while i < n
        {
            infos.add(this.get_tuple_element_info((elements as ref[Array[ref[AstNode]?]])[i]))
            set i: i + 1
        }
        this.get_tuple_target_type(infos, readonly)
    }

    ; isReadonlyTypeOperator, one line. ★It is asked of the PARENT, so a null parent
    ; is a real input and answers false rather than being guarded against.
    function is_readonly_type_operator(node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if AstNode.kind_of(n) <> KindTypeOperator
            return false
        AstNode.type_operator_operator_of(n) = KindReadonlyKeyword
    }

    ; getTupleElementInfo, whole. ★The second slot is the node itself for a named
    ; member or a parameter and null otherwise — see TupleElementInfo's header for
    ; why it is the NODE and not a name.
    function get_tuple_element_info(this, node: ref[AstNode]?) returns ref[TupleElementInfo]
    {
        var labeled: ref[AstNode]? null
        if node <> null
        {
            let n node as ref[AstNode]
            ; `ast.IsNamedTupleMember(node) || ast.IsParameterDeclaration(node)`, and
            ; the second is the GENERATED kind test (`node.Kind == KindParameter`),
            ; NOT `IsPartOfParameterDeclaration`, which walks to the root
            ; declaration. Two functions one word apart; the port has the second
            ; one under the name `Binder.is_part_of_parameter_declaration`, and it
            ; would answer true for every type node inside a parameter's
            ; annotation.
            let nk AstNode.kind_of(n)
            if nk = KindNamedTupleMember
                set labeled: n
            if nk = KindParameter
                set labeled: n
        }
        &TupleElementInfo^host(Checker.get_tuple_element_flags(node), labeled)
    }

    ; ── the normalizer ──────────────────────────────────────────────────────
    ;
    ; createNormalizedTupleTypeEx. ★★★ ITS FIRST THREE LINES ARE THE WHOLE FUNCTION
    ; FOR ALMOST EVERY TUPLE THIS PORT SEES: with no optional, rest or variadic
    ; element there is nothing to normalize and the answer is a plain type
    ; reference. `ElementFlagsNonRequired` is that test, and it is one of the three
    ; composites this slice gave a reader.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE UNTIL SLICE 201 NAMED FIVE OPERATIONS AS ABSENT
    ; AND ALL FIVE WERE PRESENT — check_cross_product_union (slice 197), map_type,
    ; get_indexed_access_type, is_array_like_type, get_index_type_of_type. Slice 154
    ; landed the four arms of the NORMALIZER on exactly that reading and left the
    ; sentence standing, so the one half that was genuinely missing — the union
    ; distribution below — kept a licence it never had. ★★★And it was missing
    ; SILENTLY: there is no `record_unported` in front of it, so `frontier.sh`
    ; ranked nothing and the answer was simply wrong. `[string, ...([string] |
    ; [number])]` came out as `[string, ...(string | number)[]]`, which is a
    ; DIFFERENT type, and every signature relation that builds a rest tuple through
    ; get_rest_type_at_position compared the two collapsed forms instead.
    procedure create_normalized_tuple_type_ex(this, target: ref[Type], element_types: ref[Array[ref[Type]?]]?, object_flags: int) returns ref[Type]?
    {
        let combined Checker.tuple_combined_flags_of(target)
        if (combined & ElementFlagsNonRequired) = 0
            return this.create_type_reference(target, element_types, object_flags)
        let infos Checker.tuple_element_infos_of(target)
        if infos = null
        {
            this.record_unported("create-normalized-tuple-type", target.object_flags)
            return null
        }
        let info_list infos as ref[Array[ref[TupleElementInfo]?]]
        let arity info_list.get_length() as int
        var given 0
        if element_types <> null
            set given: (element_types as ref[Array[ref[Type]?]]).get_length() as int
        ; ── Transform [A, ...(X | Y | Z)] into [A, ...X] | [A, ...Y] | [A, ...Z] ──
        ;
        ; ★★★ THE CHECK LIST IS NOT THE ELEMENT LIST: `core.MapIndex` keeps the
        ; VARIADIC slots and puts `unknown` in every other one, so the cross-product
        ; size is a question about the distributable slots alone — a tuple with two
        ; ten-constituent unions in fixed positions and one variadic slot is not
        ; 100 times more expensive than the same tuple with none.
        ;
        ; ★★ `never` distributes too (`TypeFlagsNever|TypeFlagsUnion`): map_type
        ; answers `never` for it without calling the arm, and `[A, ...never]` is
        ; `never` — which is the reference's answer and not an empty tuple.
        if (combined & ElementFlagsVariadic) <> 0
        {
            var vi 0
            while vi < given
            {
                let et (element_types as ref[Array[ref[Type]?]])[vi]
                if et <> null
                {
                    let ev et as ref[Type]
                    var slot_variadic false
                    if vi < arity
                    {
                        let vinfo info_list[vi]
                        if vinfo <> null
                            set slot_variadic: ((vinfo as ref[TupleElementInfo]).flags & ElementFlagsVariadic) <> 0
                    }
                    if slot_variadic
                    {
                        if (ev.flags & (TypeFlagsNever | TypeFlagsUnion)) <> 0
                        {
                            let check_types &Array[ref[Type]?]()
                            var ci 0
                            while ci < given
                            {
                                var keep false
                                if ci < arity
                                {
                                    let cinfo info_list[ci]
                                    if cinfo <> null
                                        set keep: ((cinfo as ref[TupleElementInfo]).flags & ElementFlagsVariadic) <> 0
                                }
                                if keep
                                    check_types.add((element_types as ref[Array[ref[Type]?]])[ci])
                                if keep = false
                                    check_types.add(unknown_type)
                                set ci: ci + 1
                            }
                            let mark this.unported_mark()
                            let ok this.check_cross_product_union(check_types)
                            if this.unported_mark() <> mark
                                return null
                            if ok
                            {
                                var da_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, target, element_types, vi, object_flags)
                                let da &da_value as ref[MapTypeArgs]?
                                return this.map_type(ev, MapTypeKindNormalizedTupleVariadic, da)
                            }
                        }
                    }
                }
                set vi: vi + 1
            }
        }
        ; `elementTypes[:len(d.elementInfos)]` — the list may carry ONE extra entry,
        ; the `this` type argument resolveTypeReferenceMembers pads with, and the
        ; reference normalizes without it and appends it afterwards.
        let head this.new_type_list(null)
        var i 0
        while i < arity
        {
            if i < given
                head.add((element_types as ref[Array[ref[Type]?]])[i])
            set i: i + 1
        }
        var n TupleNormalizer()
        ; `if !n.normalize(…) { return c.errorType }` — the tuple that hit the size wall is the
        ; ERROR type, not a stop: its `as const` variable is then `any` and prints as such,
        ; and no TS7005 follows (slice 210; `excessivelyLargeTupleSpread`)
        if this.normalize_tuple(&n, head, info_list) = false
            return error_type
        let types n.types as ref[Array[ref[Type]?]]
        let out_infos n.infos as ref[Array[ref[TupleElementInfo]?]]
        if given > arity
            types.add((element_types as ref[Array[ref[Type]?]])[arity])
        let tuple_target this.get_tuple_target_type(out_infos, Checker.tuple_readonly_of(target))
        if tuple_target = null
            return null
        let tt tuple_target as ref[Type]
        if tt = empty_generic_type
            return empty_object_type
        if types.get_length() <> 0
            return this.create_type_reference(tt, types, object_flags)
        tuple_target
    }

    procedure create_normalized_tuple_type(this, target: ref[Type], element_types: ref[Array[ref[Type]?]]?) returns ref[Type]?
        this.create_normalized_tuple_type_ex(target, element_types, ObjectFlagsNone)

    ; TupleNormalizer.normalize. Answers false where the reference answers false —
    ; the 10 000-element guard — and, in this port, also where an arm reports.
    procedure normalize_tuple(this, n: ref[TupleNormalizer], element_types: ref[Array[ref[Type]?]], element_infos: ref[Array[ref[TupleElementInfo]?]]) returns bool
    {
        set n.types: this.new_type_list(null)
        let fresh_infos &Array[ref[TupleElementInfo]?]^host()
        set n.infos: fresh_infos
        let count element_types.get_length() as int
        var i 0
        while i < count
        {
            let info element_infos[i]
            if info = null
                return false
            let inf info as ref[TupleElementInfo]
            if (inf.flags & ElementFlagsVariadic) <> 0
            {
                ; ★★★ SLICE 154: THE FOUR ARMS, AND THE NOTE THEY REPLACE WAS THE
                ; §3.5eo SHAPE AGAIN. It read *every one of the reference's four
                ; variadic arms needs machinery this port does not have — see the
                ; header*, and the header (TupleNormalizer's, at the record) names
                ; no machinery at all; the four callees the arms actually want —
                ; is_generic_mapped_type, is_tuple_type + get_element_types,
                ; is_array_like_type + get_index_type_of_type — were all in this
                ; file when the sentence was written or landed shortly after.
                ; +40 units of stage 2 over 93 arrivals.
                let vt element_types[i]
                if vt = null
                    return false
                let v vt as ref[Type]
                if (v.flags & TypeFlagsAny) <> 0
                {
                    ; `any` spreads as a REST element of `any`.
                    this.normalizer_add(n, v, &TupleElementInfo^host(ElementFlagsRest, inf.labeled_declaration))
                    set i: i + 1
                    continue
                }
                var generic (v.flags & TypeFlagsInstantiableNonPrimitive) <> 0
                if generic = false
                    set generic: this.is_generic_mapped_type(v)
                if generic
                {
                    ; "Generic variadic elements stay as they are."
                    this.normalizer_add(n, v, inf)
                    set i: i + 1
                    continue
                }
                if Checker.is_tuple_type(v)
                {
                    ; "Spread variadic elements with tuple types into the
                    ; resulting tuple." ★The infos come off the TARGET, not off the
                    ; reference — the same rule is_const_type_variable's tuple arm
                    ; writes down.
                    let spread_types this.get_element_types(v)
                    if spread_types = null
                        return false
                    let sl spread_types as ref[Array[ref[Type]?]]
                    let types_so_far n.types as ref[Array[ref[Type]?]]
                    if ((sl.get_length() as int) + (types_so_far.get_length() as int)) >= 10000
                    {
                        ; ★★ THE GUARD IS THE ONE PLACE THIS FUNCTION ANSWERS FALSE
                        ; IN THE REFERENCE, which is what the header's *answers
                        ; false where the reference answers false* was about; until
                        ; this slice the sentence described a contract with no
                        ; implementation behind it.
                        var code DiagExpression_produces_a_tuple_type_that_is_too_large_to_represent
                        if AstNode.is_part_of_type_node(current_node)
                            set code: DiagType_produces_a_tuple_type_that_is_too_large_to_represent
                        this.error_on_node(current_node, code)
                        return false
                    }
                    let target Checker.target_of(v)
                    if target = null
                        return false
                    let spread_infos Checker.tuple_element_infos_of(target as ref[Type])
                    if spread_infos = null
                        return false
                    let il spread_infos as ref[Array[ref[TupleElementInfo]?]]
                    let sn sl.get_length() as int
                    var j 0
                    while j < sn
                    {
                        let si il[j]
                        if si = null
                            return false
                        this.normalizer_add(n, sl[j], si as ref[TupleElementInfo])
                        set j: j + 1
                    }
                    set i: i + 1
                    continue
                }
                ; "Treat everything else as an array type and create a rest
                ; element." ★A non-array-like variadic falls to errorType, which is
                ; the reference's `s == nil` branch and not a stop: the diagnostic
                ; for it is filed by the CALLER that checked the type node.
                var elem: ref[Type]? null
                if this.is_array_like_type(v)
                    set elem: this.get_index_type_of_type(v, number_type)
                if elem = null
                    set elem: error_type
                this.normalizer_add(n, elem, &TupleElementInfo^host(ElementFlagsRest, inf.labeled_declaration))
                set i: i + 1
                continue
            }
            this.normalizer_add(n, element_types[i], inf)
            set i: i + 1
        }
        ; Turn optional elements preceding the last required element into required.
        let out_infos n.infos as ref[Array[ref[TupleElementInfo]?]]
        var j 0
        while j < n.last_required_index
        {
            let e out_infos[j]
            if e <> null
            {
                let ei e as ref[TupleElementInfo]
                if (ei.flags & ElementFlagsOptional) <> 0
                    out_infos.put(j as size_t, &TupleElementInfo^host(ElementFlagsRequired, ei.labeled_declaration))
            }
            set j: j + 1
        }
        ; Fold the run between the first rest and the last optional-or-rest element
        ; into a single rest element.
        ;
        ; ★★★ SLICE 154 HAD TO WRITE THE getIndexedAccessType CALL THIS LOOP HAD
        ; DECLARED UNREACHABLE. The note read *no arm of this loop can meet a
        ; VARIADIC entry — the walk above stops on one — so the reference's
        ; getIndexedAccessType call inside it is unreachable rather than unwritten*:
        ; true while the walk stopped, and the second of the four arms it now runs
        ; keeps a GENERIC variadic element with its info unchanged. **An
        ; unreachability proof whose premise is a stop expires with the stop**, and
        ; nothing links the two lines — this one was found by reading the function
        ; the arms were being written into, not by any instrument.
        if n.first_rest_index >= 0
        {
            if n.first_rest_index < n.last_optional_or_rest_index
            {
                let types n.types as ref[Array[ref[Type]?]]
                let run this.new_type_list(null)
                var k n.first_rest_index
                while k <= n.last_optional_or_rest_index
                {
                    let ki out_infos[k]
                    if ki = null
                        return false
                    if ((ki as ref[TupleElementInfo]).flags & ElementFlagsVariadic) <> 0
                    {
                        let kt types[k]
                        if kt = null
                            return false
                        let indexed this.get_indexed_access_type(kt as ref[Type], number_type)
                        if indexed = null
                            return false
                        run.add(indexed)
                        set k: k + 1
                        continue
                    }
                    run.add(types[k])
                    set k: k + 1
                }
                let folded this.get_union_type(run)
                if folded = null
                    return false
                let kept_types this.new_type_list(null)
                let kept_infos &Array[ref[TupleElementInfo]?]^host()
                let total types.get_length() as int
                var m 0
                while m < total
                {
                    if m = n.first_rest_index
                    {
                        kept_types.add(folded)
                        kept_infos.add(out_infos[m])
                    }
                    if m < n.first_rest_index
                    {
                        kept_types.add(types[m])
                        kept_infos.add(out_infos[m])
                    }
                    if m > n.last_optional_or_rest_index
                    {
                        kept_types.add(types[m])
                        kept_infos.add(out_infos[m])
                    }
                    set m: m + 1
                }
                set n.types: kept_types
                set n.infos: kept_infos
            }
        }
        true
    }

    ; TupleNormalizer.add.
    procedure normalizer_add(this, n: ref[TupleNormalizer], t: ref[Type]?, info: ref[TupleElementInfo])
    {
        let types n.types as ref[Array[ref[Type]?]]
        let infos n.infos as ref[Array[ref[TupleElementInfo]?]]
        let at types.get_length() as int
        if (info.flags & ElementFlagsRequired) <> 0
            set n.last_required_index: at
        if (info.flags & ElementFlagsRest) <> 0
        {
            if n.first_rest_index < 0
                set n.first_rest_index: at
        }
        if (info.flags & (ElementFlagsOptional | ElementFlagsRest)) <> 0
            set n.last_optional_or_rest_index: at
        var widened: ref[Type]? t
        if t <> null
            set widened: this.add_optionality_ex(t as ref[Type], true, (info.flags & ElementFlagsOptional) <> 0)
        types.add(widened)
        infos.add(info)
    }

    ; createTupleType and createTupleTypeEx — the VALUE-side factory, which nothing
    ; in this slice calls yet: its callers upstream are the array literal's inferred
    ; type, the spread of a call's arguments and getRestTypeAtPosition, all of them a
    ; chapter away. It is written because getTypeFromArrayOrTupleTypeNode's own
    ; answer for a tuple goes through the same two lines and reading them twice is
    ; how the two drift apart. ★§3.5be says a function with no reader is a claim
    ; about the future; this one HAS a reader — create_normalized_tuple_type_ex —
    ; and the plain `create_tuple_type` is the one that does not, so it is left out.
    procedure create_tuple_type_ex(this, element_types: ref[Array[ref[Type]?]]?, element_infos: ref[Array[ref[TupleElementInfo]?]], readonly: bool) returns ref[Type]?
    {
        let tuple_target this.get_tuple_target_type(element_infos, readonly)
        if tuple_target = null
            return null
        let tt tuple_target as ref[Type]
        if tt = empty_generic_type
            return empty_object_type
        var n 0
        if element_types <> null
            set n: (element_types as ref[Array[ref[Type]?]]).get_length() as int
        if n <> 0
            return this.create_normalized_type_reference(tt, element_types)
        tuple_target
    }

    ; getTupleBaseType — the `extends Array<T0 | T1 | …>` of the synthesized
    ; interface, and getBaseTypes' Tuple arm is its one caller.
    ;
    ; ★★★ THE VARIADIC ARM'S NOTE WAS AN EXPIRED CLAIM ABOUT getIndexedAccessType.
    ; It read *the VARIADIC arm reports for the same reason the normalizer's does
    ; (getIndexedAccessType)* — and that function has been in this file since the
    ; indexed-access chapter, four thousand lines above. The arm is one line: a
    ; variadic element contributes `T[number]` to the union rather than `T`.
    procedure get_tuple_base_type(this, t: ref[Type]) returns ref[Type]?
    {
        let type_parameters Checker.resolved_type_arguments_of(t)
        if type_parameters = null
            return null
        let tps type_parameters as ref[Array[ref[Type]?]]
        let n tps.get_length() as int
        let element_types &Array[ref[Type]?]()
        var i 0
        while i < n
        {
            var e: ref[Type]? tps[i]
            if (Checker.tuple_element_flags_at(t, i) & ElementFlagsVariadic) <> 0
            {
                if e = null
                    return null
                let ia this.get_indexed_access_type(e as ref[Type], number_type)
                if ia = null
                    return null
                set e: ia
            }
            element_types.add(e)
            set i: i + 1
        }
        let u this.get_union_type(element_types)
        if u = null
            return null
        this.create_array_type_ex(u, Checker.tuple_readonly_of(t))
    }

    ; `jsnum.Number(i)` — an int-to-float64 conversion, routed through the DECIMAL
    ; PARSER rather than written as bit arithmetic.
    ;
    ; ★★★ THE EXACTNESS IS jsnum's OWN ARGUMENT AND NOT A HOPE. jsnum_try_parse_int's
    ; header already records it: *"ParseFloat of an integer string is the exact
    ; integer rounded to nearest-even, which is what int64→float64 is"*. So
    ; formatting the digits and parsing them back is the conversion, and it is the
    ; only spelling available — this port has no float type to cast through.
    ;
    ; ★ The one caller is `length`'s literal union, where the value is a tuple ARITY,
    ; so 24 digits is a bound no input can reach.
    function number_bits_from_int(value: int) returns u64
    {
        var digits char[24]
        let n jsnum_format_uint(value as u64, Slice[char](24 as size_t, &digits[0]))
        jsnum_from_string(Slice[char](n, &digits[0]))
    }

    ; `strconv.Itoa(i)` on the checker's page, and `length` likewise — a symbol name
    ; here is a `(pointer[char], int)` pair that must outlive the call.
    ;
    ; ★ Neither goes through Binder.internal_name: that prefixes 0xFE, which marks a
    ; name the SOURCE cannot spell, and a tuple's `0` and `length` are ordinary
    ; property names a member access finds.
    function decimal_name(host: ref[Page], value: int) returns Slice[char]
    {
        var digits char[24]
        var n 0
        var v value
        if v = 0
        {
            set digits[0]: "0" as char
            set n: 1
        }
        while v > 0
        {
            set digits[n]: (((v % 10) + 48) as char)
            set v: v / 10
            set n: n + 1
        }
        let buf host.allocate((n as size_t) + 1, 1) as pointer[char]
        var i 0
        while i < n
        {
            set *(buf + i): digits[n - 1 - i]
            set i: i + 1
        }
        set *(buf + n): 0 as char
        Slice[char](n, buf)
    }

    ; `word + "_"? + <decimal>` (slice 155) — decimal_name's loop with a PREFIX,
    ; for the four synthesized parameter names getTupleElementLabel and
    ; combineUnionOrIntersectionParameters mint (`arg0`, `x_1`, `arg_0`).
    ; ★It writes the trailing NUL every name in this port carries for the C
    ; boundary, which is why the buffer is one byte longer than the slice.
    function suffixed_decimal_name(host: ref[Page], word: Slice[char], underscore: bool, value: int) returns Slice[char]
    {
        var digits char[24]
        var n 0
        var v value
        if v = 0
        {
            set digits[0]: "0" as char
            set n: 1
        }
        while v > 0
        {
            set digits[n]: (((v % 10) + 48) as char)
            set v: v / 10
            set n: n + 1
        }
        let wn word.length as int
        var extra 0
        if underscore
            set extra: 1
        let total wn + extra + n
        let buf host.allocate(((total + 1) as size_t), 1) as pointer[char]
        var w 0
        var i 0
        while i < wn
        {
            set *(buf + w): word[i]
            set w: w + 1
            set i: i + 1
        }
        if underscore
        {
            set *(buf + w): "_" as char
            set w: w + 1
        }
        var j 0
        while j < n
        {
            set *(buf + w): digits[n - 1 - j]
            set w: w + 1
            set j: j + 1
        }
        set *(buf + total): 0 as char
        Slice[char](total, buf)
    }

    ; `a + b` over two names (slice 155) — plain_name over a pair. Its one caller
    ; is getTupleElementLabelFromBindingElement's `name + "_n"`.
    function concat_name(host: ref[Page], a: Slice[char], b: Slice[char]) returns Slice[char]
    {
        let an a.length as int
        let bn b.length as int
        let total an + bn
        let buf host.allocate(((total + 1) as size_t), 1) as pointer[char]
        var w 0
        var i 0
        while i < an
        {
            set *(buf + w): a[i]
            set w: w + 1
            set i: i + 1
        }
        var j 0
        while j < bn
        {
            set *(buf + w): b[j]
            set w: w + 1
            set j: j + 1
        }
        set *(buf + total): 0 as char
        Slice[char](total, buf)
    }

    function plain_name(host: ref[Page], word: Slice[char]) returns Slice[char]
    {
        let n word.length as int
        let buf host.allocate(((n + 1) as size_t), 1) as pointer[char]
        var i 0
        while i < n
        {
            set *(buf + i): word[i]
            set i: i + 1
        }
        set *(buf + n): 0 as char
        Slice[char](n, buf)
    }

    ; ── the two globals, and they are the LIB's ─────────────────────────────
    ;
    ; ★★★ getGlobalType("Array", 1, reportErrors) — and the REPORT half stays out,
    ; which is the same decision `target_is_global_array_type` already made and for
    ; the same reason: upstream `initializeChecker` resolves forty globals EAGERLY
    ; with reportErrors=true, so porting the report here would owe TS2318 for the
    ; other thirty-nine as well. What is ported is the ANSWER.
    ;
    ; ★★★ AND SINCE SLICE 113 THE ANSWER IS USUALLY NON-NULL, WHICH IS WHY THIS
    ; CHAPTER IS POSSIBLE AT ALL. `lib.es5.d.ts` declares `interface Array<T>` and
    ; `interface ReadonlyArray<T>`, so the globals table has both at arity one; a
    ; `@noLib` unit has whatever it declares itself, and a unit that declares
    ; neither gets `empty_generic_type` — the reference's own sentinel, which no
    ; real target equals.
    ;
    ; ★★ THE MEMO IS PER CHECKER AND NOT PER CALL. getDeclaredTypeOfSymbol
    ; memoises per symbol, so re-asking is cheap, but the ARITY test is not free
    ; and this is asked once per array type node; the two fields carry the answer.
    procedure get_global_array_type(this) returns ref[Type]?
    {
        if global_array_type <> null
            return global_array_type
        let t this.get_global_generic_type("Array")
        set global_array_type: t
        t
    }

    ; ★★★ THE READONLY FALLBACK IS THE REFERENCE'S AND IT IS NOT COSMETIC:
    ; `if c.globalReadonlyArrayType == c.emptyGenericType { c.globalReadonlyArrayType
    ; = c.globalArrayType }`. Without it a unit that declares `Array` but not
    ; `ReadonlyArray` — every `@noLib` unit that declares one — would name
    ; `readonly T[]` as `{}` instead of as the array, and `is_readonly_array_type`
    ; would answer false for the type the source spells readonly.
    procedure get_global_readonly_array_type(this) returns ref[Type]?
    {
        if global_readonly_array_type <> null
            return global_readonly_array_type
        var t this.get_global_generic_type("ReadonlyArray")
        if t = empty_generic_type
            set t: this.get_global_array_type()
        set global_readonly_array_type: t
        t
    }

    ; anyArrayType and autoArrayType — `createArrayType(anyType)` and
    ; `createArrayType(autoType)`, which initializeChecker mints EAGERLY right after
    ; the globals. They are memoised here for the reason the two globals are: this
    ; port resolves a global on demand rather than resolving forty at start-up.
    ;
    ; ★★★ autoArrayType HAS A UNIQUENESS FALLBACK AND THE REFERENCE SAYS WHY:
    ; *"autoArrayType is used as a marker, so even if global Array type is not
    ; defined, it needs to be a unique type"*. Without it a unit with no `Array` in
    ; scope would give autoArrayType the SHARED emptyObjectType, and every identity
    ; test against the marker would answer true for any empty object.
    procedure get_any_array_type(this) returns ref[Type]?
    {
        if any_array_type <> null
            return any_array_type
        let t this.create_array_type(any_type)
        set any_array_type: t
        t
    }

    procedure get_auto_array_type(this) returns ref[Type]?
    {
        if auto_array_type <> null
            return auto_array_type
        var t this.create_array_type(auto_type)
        if t = empty_object_type
            set t: this.new_anonymous_type(null, null, null, null, null)
        set auto_array_type: t
        t
    }

    ; getGlobalType at arity one, minus the reports. ★The arity test is the
    ; reference's and it is load-bearing in both directions: `interface Array<T, U>`
    ; is NOT the global array type, and neither is a non-class-or-interface `Array`.
    ; ★Slice 128 made the body general — get_global_type_of_arity, whose header
    ; carries the arity-dependent failure value this used to spell inline.
    procedure get_global_generic_type(this, name: Slice[char]) returns ref[Type]?
        this.get_global_type_of_arity(name, 1)

    ; createTypeFromGenericGlobalType, whole.
    procedure create_type_from_generic_global_type(this, generic_global_type: ref[Type]?, type_arguments: ref[Array[ref[Type]?]]?) returns ref[Type]?
    {
        if generic_global_type = null
            return null
        let g generic_global_type as ref[Type]
        if g = empty_generic_type
            return empty_object_type
        this.create_type_reference(g, type_arguments, ObjectFlagsNone)
    }

    ; createArrayType and createArrayTypeEx.
    procedure create_array_type(this, element_type: ref[Type]?) returns ref[Type]?
        this.create_array_type_ex(element_type, false)

    procedure create_array_type_ex(this, element_type: ref[Type]?, readonly: bool) returns ref[Type]?
    {
        var g: ref[Type]? null
        if readonly
            set g: this.get_global_readonly_array_type()
        else
            set g: this.get_global_array_type()
        if g = null
            return null
        let args this.new_type_list_of(1)
        args.add(element_type)
        this.create_type_from_generic_global_type(g, args)
    }

    ; isArrayType, isReadonlyArrayType, isArrayOrTupleType and
    ; getElementTypeOfArrayType.
    ;
    ; ★★★ THE FIRST DISJUNCT OF isArrayType WENT LIVE IN THIS SLICE, and
    ; `is_array_or_tuple_type`'s old body — `Checker.is_tuple_type(t)` alone, with a
    ; header proving the array half FALSE for every type this port could build — is
    ; the expiry. Both halves are real now.
    ;
    ; ★The comparison is against the GLOBAL TYPE and not against its symbol, which
    ; is the difference from `target_is_global_array_type`: that predicate exists to
    ; answer without computing a declared type, and here the declared type is
    ; already in hand.
    procedure is_array_type(this, t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return false
        let target Checker.target_of(t)
        if target = null
            return false
        let tgt target as ref[Type]
        if tgt = this.get_global_array_type()
            return true
        tgt = this.get_global_readonly_array_type()
    }

    procedure is_readonly_array_type(this, t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return false
        let target Checker.target_of(t)
        if target = null
            return false
        (target as ref[Type]) = this.get_global_readonly_array_type()
    }

    procedure get_element_type_of_array_type(this, t: ref[Type]) returns ref[Type]?
    {
        if this.is_array_type(t) = false
            return null
        let args this.get_type_arguments(t)
        if args = null
            return null
        let list args as ref[Array[ref[Type]?]]
        if list.get_length() = 0
            return null
        list[0]
    }

    ; getTypeReferenceArity and getElementTypes.
    function get_type_reference_arity(t: ref[Type]) returns int
    {
        let target Checker.target_of(t)
        if target = null
            return 0
        Checker.type_parameter_count_of(target as ref[Type])
    }

    procedure get_element_types(this, t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        let args this.get_type_arguments(t)
        if args = null
            return null
        let list args as ref[Array[ref[Type]?]]
        let arity Checker.get_type_reference_arity(t)
        let n list.get_length() as int
        if n = arity
            return args
        let cut this.new_type_list(null)
        var i 0
        while i < arity
        {
            if i < n
                cut.add(list[i])
            set i: i + 1
        }
        cut
    }


    ; ── slice 80: the anonymous object type ─────────────────────────────────
    ;
    ; getTypeFromTypeLiteralOrFunctionOrConstructorTypeNode, whole.
    ;
    ; ★★★ THE FUNCTION IS SIX LINES AND WHAT IT COSTS IS THE THREE QUESTIONS IN
    ; ITS GUARD, each of which is a different kind of answer: the node's SYMBOL
    ; (the binder's, already here), the size of that symbol's MEMBERS (a table
    ; read, argued below), and whether an ALIAS names this node (a walk up the
    ; parents). Only the last one is new code.
    ;
    ; ★★★ `getMembersOfSymbol` IS ASKED FOR ITS LENGTH ONLY, AND READING
    ; `symbol.Members` DIRECTLY IS EXACT FOR THAT QUESTION. The reference forks to
    ; the LATE-BOUND resolution here, because SymbolFlagsTypeLiteral is one of the
    ; five LateBindingContainer flags — but late binding never CREATES a member,
    ; it re-files one the binder already put in the table under `__computed`. So a
    ; container whose Members is empty has nothing to late-bind and both sides
    ; answer zero, and a container with any member at all is non-empty on both.
    ; ★It is the same argument get_index_symbol makes one dimension over, and it
    ; is what keeps `get-late-bound-symbol` off this path.
    ;
    ; ★★ THE ALIAS IS COMPUTED FOR ITS PRESENCE AND NOT FOR ITS VALUE (§3.5ag).
    ; `getAliasForTypeNode` answers a TypeAlias whenever getAliasSymbolForTypeNode
    ; answers a symbol — the type ARGUMENTS it also fills may legitimately be nil —
    ; so `alias != nil` is exactly `aliasSymbol != nil`, and this port asks the
    ; question it needs. What the value is FOR is `t.alias`, a slot on Type whose
    ; only readers (type_to_string's alias arm, getTypeAliasInstantiation) report
    ; today; §3.5be says that slot arrives with them.
    ; getTypeFromUnionTypeNode. Six lines upstream and the memo is the reference's
    ; own — two `string | undefined` annotations in one file are two NODES and one
    ; type, and the interning in the union chapter is what makes them one; this
    ; table is what makes the second one free.
    ;
    ; ★★★ THE ALIAS STOP THAT STOOD HERE IS SLICE 121's, AND ITS OWN ARGUMENT NAMED
    ; THE EXPIRY: *"a union PRINTS — so `type X = string | number` would come out as
    ; `string | number` where the reference prints `X`, and that is a well-formed
    ; WRONG answer rather than an honest UNPORTED. The alias slot on Type and its
    ; two readers arrive together (§3.5be)."* Both readers are here now — the
    ; printer's alias arm and getTypeAliasInstantiation — so the alias travels into
    ; the union's intern KEY instead of stopping the walk.
    procedure get_type_from_union_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let alias this.get_alias_for_type_node(node)
        let nodes AstNode.type_list_of(node)
        if nodes = null
            return null
        let list nodes as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        let types &Array[ref[Type]?]()
        var i 0
        while i < n
        {
            let e list[i]
            set i: i + 1
            if e = null
                return null
            let t this.get_type_from_type_node(e as ref[AstNode])
            if t = null
                return null
            types.add(t)
        }
        let u this.get_union_type_ex(types, UnionReductionLiteral, alias, null)
        if u = null
            return null
        set links.resolved_type: u
        links.resolved_type
    }

    procedure get_type_from_type_literal_or_function_or_constructor_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        ; ★★★ THE ALIAS IS COMPUTED FIRST BECAUSE THE REFERENCE COMPUTES IT FIRST,
        ; AND THAT IS THE ONLY REASON — WHICH IS A CORRECTION THE BATTERY MADE. The
        ; line was written expecting the order to be OBSERVABLE:
        ; getAliasSymbolForTypeNode ends in getSymbolOfDeclaration, whose
        ; getLateBoundSymbol reports, so pulling it inside the short-circuit should
        ; have moved a stop. Controls g10 and g11 both come back with nothing moving,
        ; and the reason is structural rather than a corpus gap — getLateBoundSymbol
        ; reports only for a CLASS MEMBER named `__computed`, and the symbol handed
        ; to it here is a TYPE ALIAS. So the whole alias walk is report-free and the
        ; order can never be measured from this caller. ★It stays the reference's
        ; anyway: the next caller of this function is what makes the order matter,
        ; and an order changed because today's caller cannot see it is §3.5bk's
        ; well-formed wrong answer waiting to happen.
        let alias_symbol this.get_alias_symbol_for_type_node(node)
        let has_alias alias_symbol <> null
        let sym AstNode.symbol_of(node)
        if sym = null
        {
            set links.resolved_type: empty_type_literal_type
            return links.resolved_type
        }
        ; ★★★ THE EMPTINESS TEST IS `len(c.getMembersOfSymbol(...))` AND NOT
        ; `symbol.Members` — the LATE-BINDING DOOR, and reading the raw table here
        ; was the second of the two places slice 129 found the same divergence (the
        ; first is get_index_symbol). It decides whether the node gets a type of its
        ; own at all: a type literal whose ONLY member is a computed name has an
        ; EMPTY members table and a one-entry late-bound one, so the raw reading
        ; answered emptyTypeLiteralType and `{ [k]: string }` printed `{}` — and the
        ; whole late-binding chapter was then unreachable from this node, which is
        ; why the index-signature half looked broken when it was not.
        if has_alias = false
        {
            if SymbolTable.length(this.get_members_of_symbol(sym as ref[Symbol])) = 0
            {
                set links.resolved_type: empty_type_literal_type
                return links.resolved_type
            }
        }
        let t this.new_object_type(ObjectFlagsAnonymous, sym)
        if t = null
            return null
        ; `t.alias = alias` — written after the construction, which is the
        ; reference's own order and the reason the two slots take no init
        ; parameter. ★getTypeArgumentsForAliasSymbol is
        ; getLocalTypeParametersOfClassOrInterfaceOrTypeAlias, so a generic alias
        ; carries its own parameters and `type T<A> = { x: A }` names `T<A>`.
        if alias_symbol <> null
        {
            let ty t as ref[Type]
            set ty.alias_symbol: alias_symbol
            set ty.alias_type_arguments: this.append_local_type_parameters_of_class_or_interface_or_type_alias(null, alias_symbol as ref[Symbol])
        }
        set links.resolved_type: t
        links.resolved_type
    }

    ; getTypeFromIndexedAccessTypeNode, whole.
    ;
    ; ★★★ THIS STOP WAS EXPIRED AND §3.5dk IS WHY IT WAS FOUND: its whole callee
    ; chain — getIndexedAccessTypeEx, getIndexedAccessTypeOrUndefined,
    ; getPropertyTypeForIndexType — has been ported since slice 105, and
    ; check_indexed_access_type reported `get-type-from-indexed-access-type-node`
    ; without asking any of it. What was actually missing was the ALIAS parameter
    ; and the deferral's IndexedAccess record, both of which this slice adds.
    procedure get_type_from_indexed_access_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let on AstNode.indexed_access_object_type_of(node)
        let ix AstNode.indexed_access_index_type_of(node)
        if on = null
            return null
        if ix = null
            return null
        let object_type this.get_type_from_type_node(on as ref[AstNode])
        if object_type = null
            return null
        let index_type this.get_type_from_type_node(ix as ref[AstNode])
        if index_type = null
            return null
        let potential_alias this.get_alias_for_type_node(node)
        let t this.get_indexed_access_type_ex(object_type as ref[Type], index_type as ref[Type], AccessFlagsNone, node, potential_alias)
        if t = null
            return null
        set links.resolved_type: t
        links.resolved_type
    }

    ; checkIndexedAccessIndexType.
    ;
    ; ★★★ ITS FIRST LINE IS THE WHOLE FUNCTION FOR EVERY RESOLVED ACCESS, and that
    ; is what makes this row cheap: a `T[K]` the machinery above ANSWERED is not an
    ; IndexedAccess type any more, so there is nothing to check. Only a DEFERRED
    ; access — the branch this slice just gave a record to — reaches the rest, and
    ; the rest is `isTypeAssignableTo` over `keyof T`, i.e. the relation.
    ; checkIndexedAccessIndexType, whole — "check if the index type is assignable
    ; to `keyof T` for the object type".
    ;
    ; ★★ IT IS ASKED ON THE ANSWER, NOT ON THE ACCESS, and the guard is what makes
    ; that safe: only a DEFERRED indexed access carries an object and an index type
    ; to compare, and every other answer falls straight through. So a `T[K]` that
    ; resolved to a property type is not re-judged here.
    ;
    ; ★ The `everyType` predicate is written as its own function rather than as a
    ; closure, which is this port's spelling everywhere (there is no `every_type`):
    ; the two values the reference's closure captures become its parameters.
    procedure check_indexed_access_index_type(this, t: ref[Type], access_node: ref[AstNode]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsIndexedAccess) = 0
            return t
        let mark this.unported_mark()
        let object_type_or_null Checker.indexed_access_object_type_of(t)
        let index_type_or_null Checker.indexed_access_index_type_of(t)
        if object_type_or_null = null
            return null
        if index_type_or_null = null
            return null
        let object_type object_type_or_null as ref[Type]
        let index_type index_type_or_null as ref[Type]
        ; "skip index type deferral on remapping mapped types"
        var object_index_type: ref[Type]? null
        var remapping false
        if this.is_generic_mapped_type(object_type)
        {
            if this.get_mapped_type_name_type_kind(object_type) = MappedTypeNameTypeKindRemapping
                set remapping: true
            if this.unported_mark() <> mark
                return null
        }
        if remapping
            set object_index_type: this.get_index_type_for_mapped_type(object_type, IndexFlagsNone)
        else
            set object_index_type: this.get_index_type_ex(object_type, IndexFlagsNone)
        if this.unported_mark() <> mark
            return null
        if object_index_type = null
            return null
        let has_number_index_info this.get_index_info_of_type(object_type, number_type) <> null
        if this.unported_mark() <> mark
            return null
        let indexable this.every_index_constituent_is_indexable(index_type, object_index_type as ref[Type], has_number_index_info)
        if this.unported_mark() <> mark
            return null
        if indexable
        {
            if AstNode.kind_of(access_node) = KindElementAccessExpression
            {
                if Binder.is_assignment_target(access_node)
                {
                    if (object_type.object_flags & ObjectFlagsMapped) <> 0
                    {
                        if (Checker.get_mapped_type_modifiers(object_type) & MappedTypeModifiersIncludeReadonly) <> 0
                        {
                            let object_name this.type_arg(object_type)
                            this.error_on_node(access_node, DiagIndex_signature_in_type_0_only_permits_reading, object_name)
                        }
                    }
                }
            }
            return t
        }
        if this.is_generic_object_type(object_type)
        {
            var name_buf char[JSNUM_MAX_TEXT]
            let prop_name this.get_property_name_from_index(index_type, access_node, Slice[char](JSNUM_MAX_TEXT as size_t, &name_buf[0]))
            if this.unported_mark() <> mark
                return null
            if prop_name.data <> null
            {
                let prop this.get_constituent_property(object_type, prop_name)
                if this.unported_mark() <> mark
                    return null
                if prop <> null
                {
                    let flags this.get_declaration_modifier_flags_from_symbol(prop as ref[Symbol])
                    if this.unported_mark() <> mark
                        return null
                    if (flags & ModifierFlagsNonPublicAccessibilityModifier) <> 0
                    {
                        this.error_on_node(access_node, DiagPrivate_or_protected_member_0_cannot_be_accessed_on_a_type_parameter, Checker.arg_text(prop_name))
                        return error_type
                    }
                }
            }
        }
        let name_arg11 this.type_arg(index_type)
        let name_arg12 this.type_arg(object_type)
        this.error_on_node(access_node, DiagType_0_cannot_be_used_to_index_type_1, name_arg11, name_arg12)
        error_type
    }

    ; `everyType(indexType, func(t) { isTypeAssignableTo(t, objectIndexType) ||
    ; hasNumberIndexInfo && isApplicableIndexType(t, c.numberType) })`.
    procedure every_index_constituent_is_indexable(this, index_type: ref[Type], object_index_type: ref[Type], has_number_index_info: bool) returns bool
    {
        let mark this.unported_mark()
        if (index_type.flags & TypeFlagsUnion) = 0
            return this.one_index_constituent_is_indexable(index_type, object_index_type, has_number_index_info)
        let types Checker.union_types_of(index_type)
        if types = null
            return true
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e = null
                return false
            if this.one_index_constituent_is_indexable(e as ref[Type], object_index_type, has_number_index_info) = false
                return false
            if this.unported_mark() <> mark
                return false
            set i: i + 1
        }
        true
    }

    procedure one_index_constituent_is_indexable(this, t: ref[Type], object_index_type: ref[Type], has_number_index_info: bool) returns bool
    {
        let mark this.unported_mark()
        if this.is_type_assignable_to(t, object_index_type)
            return true
        if this.unported_mark() <> mark
            return false
        if has_number_index_info = false
            return false
        this.is_applicable_index_type(t, number_type)
    }

    ; getConstituentProperty — the apparent type's constituents, first hit wins.
    procedure get_constituent_property(this, object_type: ref[Type], name_data: Slice[char]) returns ref[Symbol]?
    {
        let mark this.unported_mark()
        let apparent this.get_apparent_type(object_type)
        if this.unported_mark() <> mark
            return null
        if apparent = null
            return null
        let a apparent as ref[Type]
        if (a.flags & TypeFlagsUnion) = 0
        {
            ; `Distributed()` answers NOTHING for `never` and the type itself
            ; otherwise, so the loop below runs zero or one time.
            if (a.flags & TypeFlagsNever) <> 0
                return null
            return this.get_property_of_type(a, name_data)
        }
        let types Checker.union_types_of(a)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                let prop this.get_property_of_type(e as ref[Type], name_data)
                if this.unported_mark() <> mark
                    return null
                if prop <> null
                    return prop
            }
            set i: i + 1
        }
        null
    }

    ; getTypeFromIntersectionTypeNode, whole.
    ;
    ; ★★★ THE noSupertypeReduction TEST IS NOT AN OPTIMISATION AND THE REFERENCE'S
    ; OWN COMMENT SAYS WHY: `X & {}` and `{} & X`, for X one of string, number,
    ; bigint or a pattern literal template type, perform NO supertype reduction —
    ; which is what lets a union like `"a" | "b" | string & {}` keep its literal
    ; types for statement completion. Reduce there and `string & {}` collapses to
    ; `string`, which swallows the two literals as well.
    procedure get_type_from_intersection_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let alias this.get_alias_for_type_node(node)
        let nodes AstNode.type_list_of(node)
        if nodes = null
            return null
        let list nodes as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        let types this.new_type_list(null)
        var i 0
        while i < n
        {
            let e list[i]
            if e = null
                return null
            let t this.get_type_from_type_node(e as ref[AstNode])
            if t = null
                return null
            types.add(t)
            set i: i + 1
        }
        var flags IntersectionFlagsNone
        if n = 2
        {
            ; `slices.Index(types, c.emptyTypeLiteralType)` and then the OTHER one.
            var empty_index 0 - 1
            var k 0
            while k < 2
            {
                if types[k] = empty_type_literal_type
                {
                    set empty_index: k
                    set k: 2
                }
                set k: k + 1
            }
            if empty_index >= 0
            {
                let other types[1 - empty_index]
                if other <> null
                {
                    let o other as ref[Type]
                    var no_reduction false
                    if (o.flags & (TypeFlagsString | TypeFlagsNumber | TypeFlagsBigInt)) <> 0
                        set no_reduction: true
                    if (o.flags & TypeFlagsTemplateLiteral) <> 0
                    {
                        if this.is_pattern_literal_type(o)
                            set no_reduction: true
                    }
                    if no_reduction
                        set flags: IntersectionFlagsNoSupertypeReduction
                }
            }
        }
        let made this.get_intersection_type_ex(types, flags, alias)
        if made = null
            return null
        set links.resolved_type: made
        links.resolved_type
    }

    ; isPatternLiteralType and isPatternLiteralPlaceholderType — the mutually
    ; recursive pair that decides whether a template literal is a PATTERN (only
    ; non-generic placeholders) or a generic string-like type.
    ;
    ; ★ Both arms read a TemplateLiteral or StringMapping payload, so before those
    ; arrive the pair answers FALSE for every type — which is the honest answer and
    ; not a stop: a type this port cannot mint is not a pattern literal.
    function is_pattern_literal_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsTemplateLiteral) <> 0
        {
            let ts Checker.template_literal_types_of(t)
            if ts = null
                return false
            let list ts as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e = null
                    return false
                if this.is_pattern_literal_placeholder_type(e as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        if (t.flags & TypeFlagsStringMapping) <> 0
        {
            let target Checker.string_mapping_target_of(t)
            if target = null
                return false
            return this.is_pattern_literal_placeholder_type(target as ref[Type])
        }
        false
    }

    function is_pattern_literal_placeholder_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            ; True when the intersection is one or more placeholders plus zero or
            ; more object type tags.
            let ts Checker.intersection_types_of(t)
            if ts = null
                return false
            let list ts as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var seen false
            var i 0
            while i < n
            {
                let e list[i]
                if e = null
                    return false
                let s e as ref[Type]
                var placeholder false
                if (s.flags & (TypeFlagsLiteral | TypeFlagsNullable)) <> 0
                    set placeholder: true
                if this.is_pattern_literal_placeholder_type(s)
                    set placeholder: true
                if placeholder
                    set seen: true
                if placeholder = false
                {
                    if (s.flags & TypeFlagsObject) = 0
                        return false
                }
                set i: i + 1
            }
            return seen
        }
        if (t.flags & (TypeFlagsAny | TypeFlagsString | TypeFlagsNumber | TypeFlagsBigInt)) <> 0
            return true
        this.is_pattern_literal_type(t)
    }

    ; getAliasSymbolForTypeNode, whole.
    ;
    ; ★ The loop's second disjunct is a TypeOperator whose operator is `readonly`
    ; and nothing else — `keyof T` and `unique symbol` are types in their own
    ; right, so an alias declared over one of them names the OPERATOR node, not
    ; the operand. That asymmetry is the reference's and is transcribed rather
    ; than simplified.
    procedure get_alias_symbol_for_type_node(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        var owner AstNode.parent_node_of(node)
        while owner <> null
        {
            let o owner as ref[AstNode]
            let k AstNode.kind_of(o)
            if k = KindParenthesizedType
            {
                set owner: AstNode.parent_node_of(o)
                continue
            }
            if k = KindTypeOperator
            {
                if AstNode.type_operator_operator_of(o) = KindReadonlyKeyword
                {
                    set owner: AstNode.parent_node_of(o)
                    continue
                }
            }
            break
        }
        if owner = null
            return null
        if Checker.is_type_alias(owner as ref[AstNode]) = false
            return null
        this.symbol_of_declaration(owner)
    }

    ; isTypeAlias → ast.IsTypeOrJSTypeAliasDeclaration.
    function is_type_alias(node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindTypeAliasDeclaration
            return true
        k = KindJSTypeAliasDeclaration
    }

    ; getAliasForTypeNode and getTypeArgumentsForAliasSymbol, both whole. The pair
    ; is what turns the two Type slots into something a CALLEE can be handed: every
    ; producer in this chapter takes the reference's `alias *TypeAlias`, so the
    ; alias travels as one nullable value rather than as a pair of parameters
    ; threaded through nine recursions.
    ;
    ; ★ getTypeArgumentsForAliasSymbol's nil guard is the caller's here — this
    ; function only reaches it with a symbol in hand.
    procedure get_alias_for_type_node(this, node: ref[AstNode]) returns ref[TypeAlias]?
    {
        let symbol this.get_alias_symbol_for_type_node(node)
        if symbol = null
            return null
        let args this.append_local_type_parameters_of_class_or_interface_or_type_alias(null, symbol as ref[Symbol])
        &TypeAlias^host(symbol, args)
    }

    ; `t.alias = alias`, over the two slots Type carries instead of a record. It is
    ; a procedure rather than two lines at each producer because the chapter has
    ; nine of them and the reference writes one assignment.
    procedure set_type_alias(t: ref[Type], alias: ref[TypeAlias]?)
    {
        if alias = null
            return
        let a alias as ref[TypeAlias]
        set t.alias_symbol: a.symbol
        set t.alias_type_arguments: a.type_arguments
    }

    ; Whether a type already carries exactly this alias — the half of
    ; getUnionKey / getIntersectionKey that the intern tables need, spelled as a
    ; comparison because those tables are linear scans rather than hashes.
    ;
    ; ★★★ THE ALIAS IS PART OF THE KEY AND LEAVING IT OUT IS NOT A MISSING
    ; OPTIMISATION, IT IS A WRONG ANSWER. `type A = string | number` and a bare
    ; `string | number` are the same constituent list and DIFFERENT printed types;
    ; find_union_type's note said the alias was out of the key because it had *no
    ; writer*, which is precisely what this slice changes.
    function type_alias_matches(t: ref[Type], alias: ref[TypeAlias]?) returns bool
    {
        if alias = null
            return t.alias_symbol = null
        let a alias as ref[TypeAlias]
        if t.alias_symbol = null
            return false
        if (t.alias_symbol as ref[Symbol]) <> (a.symbol as ref[Symbol])
            return false
        Checker.type_lists_identical(t.alias_type_arguments, a.type_arguments)
    }

    ; Two type lists, element by element, with null standing for the empty list —
    ; the comparison the two intern keys make of their alias type arguments.
    function type_lists_identical(a: ref[Array[ref[Type]?]]?, b: ref[Array[ref[Type]?]]?) returns bool
    {
        var an 0
        if a <> null
            set an: (a as ref[Array[ref[Type]?]]).get_length() as int
        var bn 0
        if b <> null
            set bn: (b as ref[Array[ref[Type]?]]).get_length() as int
        if an <> bn
            return false
        if an = 0
            return true
        let al a as ref[Array[ref[Type]?]]
        let bl b as ref[Array[ref[Type]?]]
        var i 0
        while i < an
        {
            let x al[i]
            let y bl[i]
            if x = null
                return false
            if y = null
                return false
            if (x as ref[Type]) <> (y as ref[Type])
                return false
            set i: i + 1
        }
        true
    }


    ; ── slice 95: the type reference ────────────────────────────────────────
    ;
    ; ★★★ THE HEAD OF THE WORK LIST BY BOTH MEASURES, AND IT IS A ROW WITH TWO
    ; PRODUCERS. `get-type-from-type-node 184` is 1 773 events over 190 units at
    ; stage 1 and it is NOT one arm: 1 253 of those events are
    ; `check_type_reference_or_import`, i.e. the CHECK of a type-reference node,
    ; and 520 are the dispatcher's own TypeReference arm. Every count below that
    ; says *arrival* is an arrival at the second of those two, because a probe was
    ; the only thing that could separate them (§3.5dk's rule, met from the far
    ; side: a row is not a chapter's cost, it is the cost of the first thing behind
    ; it — and here the first thing is two things).
    ;
    ; ★★★ AND THE SPLIT OF THOSE 520 IS WHAT SCOPED THE SLICE. `resolve_name` was
    ; called with the TYPE meaning at each arrival and the answers counted:
    ; **255 MISS (49 %)** — the globals table, §3.11 — **162 a TYPE PARAMETER
    ; (31 %)**, 35 not an identifier, 26 a type ALIAS, 24 an INTERFACE, 17 an ENUM
    ; and 1 a CLASS. So the resolvable half is 187 of 520, the type parameter is
    ; two thirds of it, and the four stops below are not a hedge — each is a
    ; measured row.
    ;
    ; ★★★ THE MISS NEEDS NO NEW STOP, AND THAT IS THE SLICE'S CHEAPEST FINDING.
    ; `resolveTypeReferenceName` hands `resolveEntityName` a MESSAGE, and
    ; resolve_name's own tail already refuses to report TS2304 without the globals
    ; table (slice 91's argument, at its line). So the 255 misses stop at
    ; `resolve-name-not-found`, one chapter earlier, and this one owes nothing for
    ; them.
    ;
    ; ★★★ BUT `getUnresolvedSymbolForEntityName` IS **NOT** A CHAPTER WITH NO INPUT,
    ; AND THE FIRST DRAFT OF THIS PARAGRAPH SAID IT WAS. The claim followed from the
    ; miss stopping — and there is a second way to reach the tail that does not go
    ; through a miss at all: `resolveEntityName` answers nil WITHOUT stopping when
    ; the name node IS MISSING (`let x: ;`), which the parser produces from a
    ; recovered parse. Measured on the stage-1 corpus: **14 events over 5 units**,
    ; and the reduction is two lines. So the unresolved-symbol table is a ROW, with
    ; a number, and the tail below reports rather than pretending nothing arrives.
    ; ★★★**A containment proof derived from one caller's behaviour is a claim about
    ; that caller, not about the callee** — §3.5en's finding two from a third
    ; direction, and this time the instrument that refuted it was the stop histogram
    ; the same slice was reading for something else.

