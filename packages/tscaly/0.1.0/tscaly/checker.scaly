    ; ★★★ THE ONE ACCESSOR THAT ANSWERS FOR BOTH ARMS, and it is a decision rather
    ; than a convenience: the reference has THREE accessors here — `AsUnionType()`,
    ; `AsIntersectionType()` and `AsUnionOrIntersectionType()` — and a site that
    ; asks the wrong one panics. Which one a ported line needs is read off the
    ; reference, not guessed: `union_types_of` where upstream says AsUnionType, this
    ; one where it says AsUnionOrIntersectionType.
    function union_or_intersection_types_of(t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when d: Union
                return d.types
            when d2: Intersection
                return d2.types
        null
    }


    ; ── slice 121: keyof ─────────────────────────────────────────────────────
    ;
    ; getIndexTypeEx and the four functions behind it. It is the arm the
    ; TypeOperator's `keyof` fork has stopped on since slice 61, and the mapped type
    ; needs it twice over: a mapped type's CONSTRAINT is normally a `keyof`, and
    ; getIndexTypeForMappedType is one of this dispatch's own arms.
    ;
    ; ★★★ THE DISPATCH IS A `switch` WITH NO DEFAULT AND ITS ORDER IS LOAD-BEARING
    ; TWICE OVER. The union arm answers an INTERSECTION and the intersection arm a
    ; UNION — `keyof (A | B)` is the keys BOTH have, `keyof (A & B)` the keys either
    ; has — so the two are not interchangeable; and the deferral test stands in
    ; front of both, because a generic type's keys cannot be enumerated at all.
    ; getIndexTypeOrString — `keyof T` narrowed to its string constituents, with
    ; `string` itself standing in when nothing is left. ★It is the type of the
    ; variable a `for-in` binds, which is why the answer is never `never`.
    procedure get_index_type_or_string(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let keys this.get_index_type(t)
        if this.unported_mark() <> mark
            return null
        if keys = null
            return null
        let extracted this.get_extract_string_type(keys as ref[Type])
        if this.unported_mark() <> mark
            return null
        if extracted = null
            return null
        let e extracted as ref[Type]
        if (e.flags & TypeFlagsNever) <> 0
            return string_type
        e
    }

    procedure get_index_type(this, t: ref[Type]) returns ref[Type]?
        this.get_index_type_ex(t, IndexFlagsNone)

    procedure get_index_type_ex(this, t_in: ref[Type], index_flags: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        var t t_in
        let reduced this.get_reduced_type(t)
        if this.unported_mark() <> mark
            return null
        if reduced <> null
            set t: reduced as ref[Type]
        ; ★★★ THE NO-INFER ARM IS LIVE SINCE SLICE 136, AND THE NOTE THAT STOOD
        ; HERE NAMED THE DAY: it read *"isNoInferType needs a SUBSTITUTION type,
        ; whose only producers are the conditional's true branch and `NoInfer<T>`
        ; itself — neither reachable before those land"*. The conditional's true
        ; branch is get_conditional_flow_type_of_type and it mints one now.
        ;
        ; ★ It is asked on `is_no_infer_type` and not on the SUBSTITUTION FLAG: a
        ; substitution type whose constraint is not `unknown` is not a NoInfer and
        ; falls through to should_defer_index_type like any other instantiable.
        if Checker.is_no_infer_type(t)
        {
            let base Checker.substitution_base_type_of(t)
            if base = null
                return null
            let inner this.get_index_type_ex(base as ref[Type], index_flags)
            if inner = null
                return null
            return this.get_no_infer_type(inner as ref[Type])
        }
        if this.should_defer_index_type(t, index_flags)
            return this.get_index_type_for_generic_type(t, index_flags)
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let mapped this.map_index_type_over(Checker.union_types_of(t), index_flags)
            if mapped = null
                return null
            return this.get_intersection_type(mapped as ref[Array[ref[Type]?]])
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let mapped this.map_index_type_over(Checker.intersection_types_of(t), index_flags)
            if mapped = null
                return null
            return this.get_union_type(mapped as ref[Array[ref[Type]?]])
        }
        if (t.object_flags & ObjectFlagsMapped) <> 0
            return this.get_index_type_for_mapped_type(t, index_flags)
        if t = wildcard_type
            return wildcard_type
        if (t.flags & TypeFlagsUnknown) <> 0
            return never_type
        if (t.flags & (TypeFlagsAny | TypeFlagsNever)) <> 0
        {
            if string_number_symbol_type = null
            {
                this.record_unported("string-number-symbol-type-unminted", t.flags)
                return null
            }
            return string_number_symbol_type
        }
        var include TypeFlagsStringLike
        if (index_flags & IndexFlagsNoIndexSignatures) <> 0
            set include: TypeFlagsStringLiteral
        if (index_flags & IndexFlagsStringsOnly) = 0
            set include: include | TypeFlagsNumberLike | TypeFlagsESSymbolLike
        var include_origin false
        if index_flags = IndexFlagsNone
            set include_origin: true
        this.get_literal_type_from_properties(t, include, include_origin)
    }

    ; `core.Map(t.Types(), func(t) { return c.getIndexTypeEx(t, indexFlags) })`, the
    ; two constituent walks of the dispatch above written once.
    procedure map_index_type_over(this, types: ref[Array[ref[Type]?]]?, index_flags: int) returns ref[Array[ref[Type]?]]?
    {
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let out this.new_type_list(null)
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e = null
                return null
            let one this.get_index_type_ex(e as ref[Type], index_flags)
            if one = null
                return null
            out.add(one)
            set i: i + 1
        }
        out
    }

    ; shouldDeferIndexType. ★★ THE THIRD AND FIFTH DISJUNCTS REACH THE MAPPED TYPE
    ; AND THE INTERSECTION, so this predicate could not be written before either
    ; existed — which is why the TypeOperator's keyof fork stopped rather than
    ; deferring.
    procedure should_defer_index_type(this, t: ref[Type], index_flags: int) returns bool
    {
        if (t.flags & TypeFlagsInstantiableNonPrimitive) <> 0
            return true
        if Checker.is_generic_tuple_type(t)
            return true
        if this.is_generic_mapped_type(t)
        {
            ; `c.getNameTypeFromMappedType(t) != nil` — a mapped type's `as` clause,
            ; whole since slice 125.
            let mark this.unported_mark()
            let nt this.get_name_type_from_mapped_type(t)
            if this.unported_mark() <> mark
                return false
            if nt <> null
                return true
        }
        if (t.flags & TypeFlagsUnion) <> 0
        {
            if (index_flags & IndexFlagsNoReducibleCheck) = 0
            {
                if this.is_generic_reducible_type(t)
                    return true
            }
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            if Checker.maybe_type_of_kind(t, TypeFlagsInstantiable)
            {
                let ts Checker.intersection_types_of(t)
                if ts <> null
                {
                    let list ts as ref[Array[ref[Type]?]]
                    let n list.get_length() as int
                    var i 0
                    while i < n
                    {
                        let e list[i]
                        if e <> null
                        {
                            if this.is_empty_anonymous_object_type(e as ref[Type])
                                return true
                        }
                        set i: i + 1
                    }
                }
            }
        }
        false
    }

    ; getIndexTypeForGenericType, and its memo. ★The key is (kind, type id) with the
    ; kind chosen by StringsOnly alone, so `keyof T` and `keyof T` under different
    ; NoIndexSignatures flags share a row — the reference's own key, not a
    ; simplification.
    procedure get_index_type_for_generic_type(this, t: ref[Type], index_flags: int) returns ref[Type]?
    {
        let kind index_flags & IndexFlagsStringsOnly
        let n index_types.get_length() as int
        var i 0
        while i < n
        {
            let row index_types[i]
            if row <> null
            {
                let e row as ref[Type]
                if Checker.index_flags_of(e) = kind
                {
                    let target Checker.index_target_of(e)
                    if target <> null
                    {
                        if (target as ref[Type]) = t
                            return e
                    }
                }
            }
            set i: i + 1
        }
        let made this.new_index_type(t, kind)
        index_types.add(made)
        made
    }

    procedure new_index_type(this, target: ref[Type], index_flags: int) returns ref[Type]
        this.new_type(TypeFlagsIndex, ObjectFlagsNone, null, TypeData.Index(IndexTypeData(target, index_flags)))

    ; ── slice 126: THE TEMPLATE LITERAL TYPE ────────────────────────────
    ;
    ; getTypeFromTemplateTypeNode, getTemplateLiteralType and getTemplateStringFor
    ; Type. ★The STRING MAPPING half — `Uppercase<T>` and its three siblings — is
    ; deliberately NOT here and is named rather than written: `applyStringMapping`
    ; is JS case mapping (`ToUpperJS`/`ToLowerJS` over a special-casing table),
    ; which is a Unicode TABLE and its generator, i.e. a chapter with its own gate.
    ; Everything below reaches it through getStringMappingType, which stays a stop.
    procedure get_type_from_template_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let head AstNode.template_head_of(node)
        if head = null
            return null
        let spans AstNode.template_literal_type_spans_of(node)
        let count AstNode.list_count(spans)
        let texts this.new_string_list()
        let types this.new_type_list(null)
        ; ★ `texts` is one longer than `types`: the HEAD first, then one literal per
        ; span. TemplateLiteralTypeData's header records the invariant.
        texts.add(this.literal_text_string(head as ref[AstNode]))
        var i 0
        while i < count
        {
            let span AstNode.child_in_list(spans, i)
            let lit AstNode.template_span_literal(span)
            if lit = null
                return null
            texts.add(this.literal_text_string(lit as ref[AstNode]))
            let st AstNode.template_literal_type_span_type_of(span)
            if st = null
                return null
            let t this.get_type_from_type_node(st as ref[AstNode])
            if t = null
                return null
            types.add(t)
            set i: i + 1
        }
        let made this.get_template_literal_type(texts, types)
        if made = null
            return null
        set links.resolved_type: made
        links.resolved_type
    }

    ; A template token's COOKED text as a page-hosted String — `Head.Text()` and
    ; `span.Literal.Text()`, which is what the texts list holds.
    function literal_text_string(this, n: ref[AstNode]) returns ref[String]
    {
        let len AstNode.literal_text_length_of(n)
        let s String^host(AstNode.literal_text_of(n).data as pointer[const_char], len as size_t)
        &s
    }

    ; getTemplateStringForType — `evaluator.AnyToString(value)` for a literal and
    ; the INTRINSIC NAME for `null`/`undefined`. ★It is the RAW value: no quotes on
    ; a string, no `n` on a bigint — the printer adds those, this does not.
    ; ★Everything else answers the EMPTY string, which is why the caller cannot
    ; distinguish *nothing to add* from *this arm*; the caller's own flag test does.
    procedure get_template_string_for_type(t: ref[Type], out: ref[StringBuilder])
    {
        if (t.flags & TypeFlagsStringLiteral) <> 0
        {
            out.append(Checker.literal_text_of(t).data, Checker.literal_text_of(t).length)
            return
        }
        if (t.flags & TypeFlagsNumberLiteral) <> 0
        {
            var nb char[JSNUM_MAX_TEXT]
            let nn jsnum_to_string(Checker.literal_bits_of(t), Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
            out.append(&nb[0], nn as size_t)
            return
        }
        if (t.flags & TypeFlagsBooleanLiteral) <> 0
        {
            if Checker.literal_bool_of(t)
                out.append("true")
            else
                out.append("false")
            return
        }
        if (t.flags & TypeFlagsBigIntLiteral) <> 0
        {
            Checker.write_pseudo_big_int(out, t)
            return
        }
        if (t.flags & (TypeFlagsUndefined | TypeFlagsNull)) <> 0
        {
            let iname Checker.intrinsic_name_of(t)
            out.append(iname.data, iname.length)
        }
    }

    ; stringutil.CombineSurrogatePairs — a HIGH surrogate sentinel immediately
    ; followed by a LOW one becomes the one code point they encode.
    ;
    ; ★★ IT IS NOT COSMETIC AND IT IS NOT RARE-ONLY: the reference calls it on
    ; every text this chapter composes, so a port without it differs on any
    ; template whose spans SPLIT a surrogate pair — `` `${"\uD83D"}${"\uDE00"}` ``
    ; is one emoji upstream and two lone sentinels here. ★The fast path is the
    ; reference's own: no 0xED lead byte, no work.
    function combined_text(this, sb: ref[StringBuilder]) returns ref[String]?
    {
        let src sb.to_string()
        this.combined_bytes(Slice[char](src.get_length(), src.get_buffer() as pointer[char]))
    }

    function combined_bytes(this, data: Slice[char]) returns ref[String]?
    {
        var has_lead false
        var i 0
        while i < data.length
        {
            if (data[i] as int) = 0xED
                set has_lead: true
            set i: i + 1
        }
        if has_lead = false
        {
            let plain String^host(data.data as pointer[const_char], data.length)
            return &plain
        }
        let out StringBuilder^host()
        set i: 0
        while i < data.length
        {
            var size 0
            let r Checker.decode_js_string_rune(data, i, &size)
            var combined false
            if r >= 0xD800
            {
                if r <= 0xDBFF
                {
                    var low_size 0
                    let low Checker.decode_js_string_rune(data, i + size, &low_size)
                    if low >= 0xDC00
                    {
                        if low <= 0xDFFF
                        {
                            ; SurrogatePairToCodePoint, then the four-byte UTF-8.
                            let cp (0x10000 + ((r - 0xD800) << 10)) + (low - 0xDC00)
                            out.append((0xF0 | (cp >> 18)) as char)
                            out.append((0x80 | ((cp >> 12) & 0x3F)) as char)
                            out.append((0x80 | ((cp >> 6) & 0x3F)) as char)
                            out.append((0x80 | (cp & 0x3F)) as char)
                            set i: (i + size) + low_size
                            set combined: true
                        }
                    }
                }
            }
            if combined = false
            {
                out.append(data.data + i, size as size_t)
                set i: i + size
            }
        }
        let built out.to_string()
        let joined String^host(built.get_buffer() as pointer[const_char], built.get_length())
        &joined
    }

    ; ── slice 131: checkTemplateExpression ──────────────────────────────────
    ;
    ; ★★ THE THREE HEAVY CALLEES WERE ALREADY HERE and that is why the row fell to
    ; one function: `evaluate` (slice 96's constant evaluator) answers the whole
    ; folded case, `get_template_literal_type` (slice 121) the generic case, and
    ; `is_const_context` (slice 120) the `as const` fork. What the row was waiting
    ; for was the FUNCTION, not a chapter.
    ;
    ; ★ `texts` is one longer than `types`, the invariant
    ; get_type_from_template_type_node's note records: the HEAD first, then one
    ; literal per span.
    ;
    ; ★ A span whose type is not assignable to the template constraint contributes
    ; `string` rather than itself — which is what keeps `${anObject}` from making a
    ; template literal type out of an object.
    procedure check_template_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let head AstNode.template_head_of(node)
        if head = null
            return null
        let spans AstNode.template_expression_spans_of(node)
        let count AstNode.list_count(spans)
        let texts this.new_string_list()
        let types this.new_type_list(null)
        texts.add(this.literal_text_string(head as ref[AstNode]))
        let constraint this.get_template_constraint_type()
        if this.unported_mark() <> mark
            return null
        var i 0
        while i < count
        {
            let span AstNode.child_in_list(spans, i)
            set i: i + 1
            let expr AstNode.expression_of(span)
            if expr = null
                return null
            let e expr as ref[AstNode]
            let t this.check_expression(e)
            if this.unported_mark() <> mark
                return null
            if t = null
                return null
            if this.maybe_type_of_kind_considering_base_constraint(t, TypeFlagsESSymbolLike)
                this.error_on_node(e, DiagImplicit_conversion_of_a_symbol_to_a_string_will_fail_at_runtime_Consider_wrapping_this_expression_in_String)
            if this.unported_mark() <> mark
                return null
            let lit AstNode.template_span_literal(span)
            if lit = null
                return null
            texts.add(this.literal_text_string(lit as ref[AstNode]))
            if constraint = null
                return null
            var contributed t as ref[Type]
            if this.is_type_assignable_to(t as ref[Type], constraint as ref[Type]) = false
                set contributed: string_type
            if this.unported_mark() <> mark
                return null
            types.add(contributed)
        }
        ; `evaluate(node, node)` is skipped for a TAGGED template: there the raw
        ; strings are the tag's argument and the cooked value is not the type.
        var folded: ref[Type]? null
        if Checker.kind_or_unknown(AstNode.parent_node_of(node)) <> KindTaggedTemplateExpression
        {
            let ev this.evaluate(node, node)
            if this.unported_mark() <> mark
                return null
            ; ★★★ THE REFERENCE'S TEST IS `evaluated != nil` AND THE PORT'S IS
            ; `ev.text <> null`, NOT the KIND. evaluate_template_expression
            ; answers EvalKindString with a NULL text for a template it could not
            ; fold — the kind is kept so that `is_syntactically_string` survives,
            ; which is upstream's `evaluatorResult(nil, true, …)`. Reading the kind
            ; alone folded `` `hello, ${name}` `` to the EMPTY STRING LITERAL and
            ; cost three units of the checker yardstick before diagcheck's
            ; neighbour caught it. ★A no-value sentinel that keeps its kind is
            ; exactly the shape a kind test cannot see.
            if Checker.eval_has_value(ev)
                set folded: this.get_fresh_type_of_literal_type(this.get_string_literal_type(ev.text))
        }
        if folded <> null
            return folded
        var literal_context false
        if this.is_const_context(node)
            set literal_context: true
        if this.unported_mark() <> mark
            return null
        if literal_context = false
        {
            if Checker.is_template_literal_context(node)
                set literal_context: true
        }
        if literal_context = false
        {
            let contextual this.get_contextual_type(node, ContextFlagsNone)
            if this.unported_mark() <> mark
                return null
            var subject unknown_type
            if contextual <> null
                set subject: contextual as ref[Type]
            if this.some_type_is_template_literal_contextual(subject)
                set literal_context: true
            if this.unported_mark() <> mark
                return null
        }
        if literal_context
            return this.get_template_literal_type(texts, types)
        string_type
    }

    ; isTemplateLiteralContext — a parenthesized expression whose own parent is one,
    ; or the ARGUMENT of an element access. ★It climbs through parentheses only, so
    ; it is not the general contextual walk.
    function is_template_literal_context(node: ref[AstNode]) returns bool
    {
        let parent AstNode.parent_node_of(node)
        if parent = null
            return false
        let p parent as ref[AstNode]
        let pk AstNode.kind_of(p)
        if pk = KindParenthesizedExpression
            return Checker.is_template_literal_context(p)
        if pk = KindElementAccessExpression
            return AstNode.element_access_argument_of(p) = node
        false
    }

    ; `someType(t, c.isTemplateLiteralContextualType)` — the union walk and the
    ; predicate, as one function for the reason every other `someType` in this file
    ; is one (there is no closure form here).
    procedure some_type_is_template_literal_contextual(this, t: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_template_literal_contextual_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                if this.is_template_literal_contextual_type(e as ref[Type])
                    return true
                if this.unported_mark() <> mark
                    return false
            }
            set i: i + 1
        }
        false
    }

    procedure is_template_literal_contextual_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & (TypeFlagsStringLiteral | TypeFlagsTemplateLiteral)) <> 0
            return true
        if (t.flags & TypeFlagsInstantiableNonPrimitive) = 0
            return false
        let mark this.unported_mark()
        let constraint this.get_base_constraint_of_type(t)
        if this.unported_mark() <> mark
            return false
        var subject unknown_type
        if constraint <> null
            set subject: constraint as ref[Type]
        Checker.maybe_type_of_kind(subject, TypeFlagsStringLike)
    }

    function new_string_list(this) returns ref[Array[ref[String]?]]
    {
        let a &Array[ref[String]?]^host()
        a
    }

    ; §3.21's state record for addSpans, whose closure captures `sb`, `newTexts`
    ; and `newTypes` and whose walk RECURSES on a nested template literal's own
    ; lists. ★The builder is a SLOT rather than a parameter because the reference
    ; RESETS it when a span opens, and a StringBuilder here has no reset — so a
    ; fresh builder is put in its place, which is the same program.
    ;
    ; ★★ IT MUST BE ONE STATE ACROSS THE RECURSION: a nested template's spans
    ; append to the SAME text under construction and close it in the same lists.
    procedure add_template_spans(this, st: ref[TemplateSpanState], texts: ref[Array[ref[String]?]], types: ref[Array[ref[Type]?]]) returns bool
    {
        let mark this.unported_mark()
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let row types[i]
            if row = null
                return false
            let t row as ref[Type]
            let tail texts[i + 1]
            if (t.flags & (TypeFlagsLiteral | TypeFlagsNull | TypeFlagsUndefined)) <> 0
            {
                Checker.get_template_string_for_type(t, st.sb)
                if tail <> null
                    st.sb.append(tail as ref[String])
            }
            else
            {
                if (t.flags & TypeFlagsTemplateLiteral) <> 0
                {
                    let itx Checker.template_literal_texts_of(t)
                    let ity Checker.template_literal_types_of(t)
                    if itx = null
                        return false
                    if ity = null
                        return false
                    let il itx as ref[Array[ref[String]?]]
                    let ihead il[0]
                    if ihead <> null
                        st.sb.append(ihead as ref[String])
                    if this.add_template_spans(st, il, ity as ref[Array[ref[Type]?]]) = false
                        return false
                    if tail <> null
                        st.sb.append(tail as ref[String])
                }
                else
                {
                    var is_span this.is_generic_index_type(t)
                    if this.unported_mark() <> mark
                        return false
                    if is_span = false
                    {
                        set is_span: this.is_pattern_literal_placeholder_type(t)
                        if this.unported_mark() <> mark
                            return false
                    }
                    if is_span = false
                        return false
                    st.new_types.add(t)
                    let closed this.combined_text(st.sb)
                    if closed = null
                        return false
                    st.new_texts.add(closed)
                    ; `sb.Reset()`.
                    let fresh StringBuilder^host()
                    set st.sb: &fresh
                    if tail <> null
                        st.sb.append(tail as ref[String])
                }
            }
            set i: i + 1
        }
        true
    }

    ; getTemplateLiteralType, whole.
    ;
    ; ★★★ ITS THREE EXITS ARE THE NORMALISATION AND EACH IS LOAD-BEARING: a
    ; template with no remaining spans is a STRING LITERAL type, a template whose
    ; texts are all empty over spans that are all `string` IS `string`, and a
    ; single such span around a pattern literal is that pattern itself. Without
    ; them `` `${string}` `` would be a distinct type from `string` and nothing
    ; would ever compare equal.
    procedure get_template_literal_type(this, texts: ref[Array[ref[String]?]], types: ref[Array[ref[Type]?]]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let n types.get_length() as int
        ; core.FindIndex over Never|Union — the constituent this has to distribute.
        var union_index 0 - 1
        var i 0
        while i < n
        {
            let row types[i]
            if row <> null
            {
                if ((row as ref[Type]).flags & (TypeFlagsNever | TypeFlagsUnion)) <> 0
                {
                    if union_index < 0
                        set union_index: i
                }
            }
            set i: i + 1
        }
        if union_index >= 0
        {
            if this.check_cross_product_union(types) = false
                return error_type
            let subject types[union_index]
            if subject = null
                return null
            var a_value MapTypeArgs(null, null, null, null, null, false, texts, types, union_index, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, null, null, 0, null, null, null, null, 0, 0)
            let a &a_value
            return this.map_type(subject as ref[Type], MapTypeKindTemplateLiteralSpan, a)
        }
        ; slices.Contains(types, wildcardType).
        set i: 0
        while i < n
        {
            let row types[i]
            if row <> null
            {
                if (row as ref[Type]) = wildcard_type
                    return wildcard_type
            }
            set i: i + 1
        }
        let new_texts this.new_string_list()
        let new_types this.new_type_list(null)
        let sb StringBuilder^host()
        let head texts[0]
        if head <> null
            sb.append(head as ref[String])
        let st &TemplateSpanState^host(&sb, new_texts, new_types)
        if this.add_template_spans(st, texts, types) = false
        {
            if this.unported_mark() <> mark
                return null
            return string_type
        }
        let last this.combined_text(st.sb)
        if last = null
            return null
        if (new_types.get_length() as int) = 0
        {
            let only last as ref[String]
            return this.get_string_literal_type(Slice[char](only.get_length() as int, only.get_buffer() as pointer[char]))
        }
        new_texts.add(last)
        ; `core.Every(newTexts, == "")` and then `core.Every(newTypes, String)`.
        var all_empty true
        let tn new_texts.get_length() as int
        set i: 0
        while i < tn
        {
            let row new_texts[i]
            if row = null
                set all_empty: false
            else
            {
                if ((row as ref[String]).get_length() as int) <> 0
                    set all_empty: false
            }
            set i: i + 1
        }
        if all_empty
        {
            var all_string true
            let yn new_types.get_length() as int
            set i: 0
            while i < yn
            {
                let row new_types[i]
                if row = null
                    set all_string: false
                else
                {
                    if ((row as ref[Type]).flags & TypeFlagsString) = 0
                        set all_string: false
                }
                set i: i + 1
            }
            if all_string
                return string_type
            ; Normalize `${Mapping<xxx>}` into Mapping<xxx>.
            if yn = 1
            {
                let only new_types[0]
                if only <> null
                {
                    let ot only as ref[Type]
                    if this.is_pattern_literal_type(ot)
                        return ot
                    if this.unported_mark() <> mark
                        return null
                }
            }
        }
        let found this.find_template_literal_type(new_texts, new_types)
        if found <> null
            return found
        let made this.new_template_literal_type(new_texts, new_types)
        template_literal_types.add(made)
        made
    }

    ; getTemplateTypeKey's table, read as find_union_type reads its own: the key is
    ; the texts and the types, both recoverable off the answer. ★The texts compare
    ; by CONTENT and the types by IDENTITY, which is what the Go map's key does.
    function find_template_literal_type(this, texts: ref[Array[ref[String]?]], types: ref[Array[ref[Type]?]]) returns ref[Type]?
    {
        let n types.get_length() as int
        let tn texts.get_length() as int
        let count template_literal_types.get_length() as int
        var i 0
        while i < count
        {
            let row template_literal_types[i]
            if row <> null
            {
                let cand row as ref[Type]
                let ctx Checker.template_literal_texts_of(cand)
                let cty Checker.template_literal_types_of(cand)
                if ctx <> null
                {
                    if cty <> null
                    {
                        let cl ctx as ref[Array[ref[String]?]]
                        let yl cty as ref[Array[ref[Type]?]]
                        var same false
                        if (cl.get_length() as int) = tn
                        {
                            if (yl.get_length() as int) = n
                                set same: true
                        }
                        if same
                        {
                            var j 0
                            while j < tn
                            {
                                let x cl[j]
                                let y texts[j]
                                if x = null
                                    set same: false
                                if y = null
                                    set same: false
                                if same
                                {
                                    if (x as ref[String]) <> (y as ref[String])
                                        set same: false
                                }
                                if same = false
                                    break
                                set j: j + 1
                            }
                        }
                        if same
                        {
                            var j 0
                            while j < n
                            {
                                if yl[j] <> types[j]
                                    set same: false
                                if same = false
                                    break
                                set j: j + 1
                            }
                        }
                        if same
                            return cand
                    }
                }
            }
            set i: i + 1
        }
        null
    }

    procedure new_template_literal_type(this, texts: ref[Array[ref[String]?]], types: ref[Array[ref[Type]?]]) returns ref[Type]
        this.new_type(TypeFlagsTemplateLiteral, ObjectFlagsNone, null, TypeData.TemplateLiteral(TemplateLiteralTypeData(texts, types)))

    ; ── slice 171: THE INTRINSIC STRING-MAPPING TYPE ────────────────────────
    ;
    ; `Uppercase<T>`, `Lowercase<T>`, `Capitalize<T>` and `Uncapitalize<T>` are
    ; declared in lib.es5.d.ts as `type X<S extends string> = intrinsic`, so an
    ; alias reference to one has the intrinsic MARKER as its declared type and
    ; get_type_alias_instantiation answers it instead of instantiating anything.
    ; That is the mint site; everything here is what it mints with.
    ;
    ; ★★★ THE CASE MAPPING IS A TABLE, NOT A RULE. ToUpperJS and ToLowerJS write
    ; a rune UNCHANGED when it is absent from specialCasingMappings — there is no
    ; library fallback underneath — so `JsCase.scaly` IS the mapping, generated
    ; from the reference's own generated table by tools/genjscase.py. A
    ; hand-written `c - 32` would answer differently on most of its 2 927
    ; entries, silently, and only for text nobody writes into a test.

    ; intrinsicTypeKinds. ★A MAP from name to kind upstream; five names here, for
    ; the reason type_alias_intrinsic_is_legal's header gives — the VALUE is read
    ; at four sites, all of them in this chapter, and that fifth reader asks only
    ; whether it is Unknown.
    function intrinsic_type_kind(name: Slice[char]) returns int
    {
        if Checker.name_bytes_are(name, "Uppercase")
            return IntrinsicTypeKindUppercase
        if Checker.name_bytes_are(name, "Lowercase")
            return IntrinsicTypeKindLowercase
        if Checker.name_bytes_are(name, "Capitalize")
            return IntrinsicTypeKindCapitalize
        if Checker.name_bytes_are(name, "Uncapitalize")
            return IntrinsicTypeKindUncapitalize
        if Checker.name_bytes_are(name, "NoInfer")
            return IntrinsicTypeKindNoInfer
        IntrinsicTypeKindUnknown
    }

    ; `strings.Builder.WriteRune` — the plain UTF-8 encoder, the same one
    ; Scanner.value_put_codepoint is.
    ;
    ; ★ A LONE SURROGATE NEVER REACHES IT: both walkers below take the surrogate
    ; arm first and copy the three sentinel bytes verbatim, which is exactly what
    ; EncodeJSStringRune writes, so this encoder is only ever asked about code
    ; points Go's own WriteRune encodes. The one place the two would disagree is
    ; therefore unreachable rather than approximated.
    procedure js_write_rune(sb: ref[StringBuilder], cp: int)
    {
        if cp < 0x80
        {
            sb.append(cp as char)
            return
        }
        if cp < 0x800
        {
            sb.append((0xC0 | (cp >> 6)) as char)
            sb.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        if cp < 0x10000
        {
            sb.append((0xE0 | (cp >> 12)) as char)
            sb.append((0x80 | ((cp >> 6) & 0x3F)) as char)
            sb.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        sb.append((0xF0 | (cp >> 18)) as char)
        sb.append((0x80 | ((cp >> 12) & 0x3F)) as char)
        sb.append((0x80 | ((cp >> 6) & 0x3F)) as char)
        sb.append((0x80 | (cp & 0x3F)) as char)
    }

    ; One encoded mapping out of JsCase — a rune below JSCASE_MULTI_BASE, a pool
    ; run at or above it (`ß` uppercases to `SS`).
    ;
    ; ★★★ THE POOL INDEX IS BIASED RATHER THAN NEGATED, AND THAT IS A COMPILER
    ; FINDING AND NOT A STYLE: a NEGATIVE element in a const array literal is
    ; silently TWO elements. `define T: int[] [0x10, 0 - 0x5, 0x30]` emits
    ; `[3 x i64] [16, 0, 5]` at rc 0 — three lines reproduce it — so the first
    ; version of this table shifted every mapping after `ß` by one and
    ; `Lowercase<"Ο">` answered `ξ`. Nothing but the corpus said so.
    procedure js_write_mapping(sb: ref[StringBuilder], code: int)
    {
        if code = 0
            return
        if code < js_case_multi_base()
        {
            Checker.js_write_rune(sb, code)
            return
        }
        let start code - js_case_multi_base()
        let n js_case_multi_length(start)
        var i 0
        while i < n
        {
            Checker.js_write_rune(sb, js_case_multi_at(start, i))
            set i: i + 1
        }
    }

    ; utf16.IsSurrogate.
    function js_rune_is_surrogate(r: int) returns bool
    {
        if r < 0xD800
            return false
        r <= 0xDFFF
    }

    ; hasSigmaCasedAfter — the forward half of the Final_Sigma condition: skip
    ; Case_Ignorable code points, then answer whether the next one is Cased.
    function js_has_sigma_cased_after(s: Slice[char], start: int) returns bool
    {
        var i start
        while i < (s.length as int)
        {
            var size 0
            let r Checker.decode_js_string_rune(s, i, &size)
            set i: i + size
            if js_case_is_case_ignorable(r) = false
                return js_case_is_cased(r)
        }
        false
    }

    ; stringutil.ToUpperJS.
    ;
    ; ★ The reference's ASCII fast path is an OPTIMISATION and not a second
    ; answer — 0x41…0x5A and 0x61…0x7A are in the table with exactly that
    ; mapping and no other ASCII byte is in it at all — so it is not transcribed:
    ; a fast path that has to agree with the slow one is a second place to be
    ; wrong, and this table is searched in eleven comparisons.
    procedure js_to_upper(this, s: Slice[char]) returns ref[String]
    {
        let sb StringBuilder^host()
        var i 0
        while i < (s.length as int)
        {
            var size 0
            let r Checker.decode_js_string_rune(s, i, &size)
            if Checker.js_rune_is_surrogate(r)
                sb.append(s.data + i, size as size_t)
            else
            {
                let k js_case_index(r)
                if k < 0
                    Checker.js_write_rune(&sb, r)
                else
                    Checker.js_write_mapping(&sb, js_case_upper(k))
            }
            set i: i + size
        }
        Checker.string_of_builder(host, &sb)
    }

    ; stringutil.ToLowerJS, whose one difference from the upper direction is the
    ; Final_Sigma context.
    ;
    ; ★★★ `casedBefore` IS ACCUMULATED FORWARD ON PURPOSE — the reference says so
    ; at the field: it is the backward half of the Final_Sigma condition, tracked
    ; as the stream is walked so that nothing ever has to decode backwards. The
    ; forward half is a scan from just past the sigma, which is why `i` is
    ; advanced BEFORE the body here as it is upstream.
    procedure js_to_lower(this, s: Slice[char]) returns ref[String]
    {
        let sb StringBuilder^host()
        var cased_before false
        var i 0
        while i < (s.length as int)
        {
            var size 0
            let r Checker.decode_js_string_rune(s, i, &size)
            let at i
            set i: i + size
            if Checker.js_rune_is_surrogate(r)
                sb.append(s.data + at, size as size_t)
            else
            {
                let k js_case_index(r)
                if k < 0
                    Checker.js_write_rune(&sb, r)
                else
                {
                    var written false
                    let cond js_case_conditional_lower(r)
                    if cond <> 0
                    {
                        if cased_before
                        {
                            if Checker.js_has_sigma_cased_after(s, i) = false
                            {
                                Checker.js_write_mapping(&sb, cond)
                                set written: true
                            }
                        }
                    }
                    if written = false
                        Checker.js_write_mapping(&sb, js_case_lower(k))
                }
            }
            if js_case_is_case_ignorable(r) = false
                set cased_before: js_case_is_cased(r)
        }
        Checker.string_of_builder(host, &sb)
    }

    ; The builder's bytes as a page-hosted String — combined_bytes' own two lines,
    ; which every producer in this chapter ends with.
    function string_of_builder(host: ref[Page], sb: ref[StringBuilder]) returns ref[String]
    {
        let built sb.to_string()
        let made String^host(built.get_buffer() as pointer[const_char], built.get_length())
        &made
    }

    ; applyStringMapping — the four intrinsics over a string VALUE. ★The fifth
    ; kind (NoInfer) never arrives: getTypeAliasInstantiation forks it away before
    ; any of this, and the `default` upstream returns the string unchanged.
    procedure apply_string_mapping(this, kind: int, s: Slice[char]) returns ref[String]
    {
        if kind = IntrinsicTypeKindUppercase
            return this.js_to_upper(s)
        if kind = IntrinsicTypeKindLowercase
            return this.js_to_lower(s)
        if kind = IntrinsicTypeKindCapitalize
            return this.js_map_first_rune(s, true)
        if kind = IntrinsicTypeKindUncapitalize
            return this.js_map_first_rune(s, false)
        let same String^host(s.data as pointer[const_char], s.length)
        &same
    }

    ; `ToUpperJS(str[:size]) + str[size:]` and its lower twin — Capitalize and
    ; Uncapitalize map the FIRST CODE POINT and copy the rest verbatim, which is
    ; why they decode a rune rather than taking one byte.
    ;
    ; ★ The EMPTY string is the identity on both sides: upstream
    ; `DecodeJSStringRune("")` answers RuneError with size 0, so the head is empty
    ; and the tail is the whole string.
    procedure js_map_first_rune(this, s: Slice[char], upper: bool) returns ref[String]
    {
        if (s.length as int) = 0
        {
            let empty String^host()
            return &empty
        }
        var size 0
        let head_rune Checker.decode_js_string_rune(s, 0, &size)
        let head s.subslice(0, size as size_t)
        var mapped: ref[String]? null
        if upper
            set mapped: this.js_to_upper(head)
        else
            set mapped: this.js_to_lower(head)
        let sb StringBuilder^host()
        sb.append(mapped as ref[String])
        sb.append(s.data + size, s.length - (size as size_t))
        Checker.string_of_builder(host, &sb)
    }

    ; applyTemplateStringMapping — the mapping pushed INTO a template literal's
    ; parts, so that `Uppercase<`a${T}b`>` stays a template rather than becoming
    ; opaque.
    ;
    ; ★★★ THE TWO PAIRS ARE NOT THE SAME SHAPE. Uppercase and Lowercase map EVERY
    ; text and EVERY span; Capitalize and Uncapitalize touch exactly one, and
    ; WHICH one is decided by the head text — a template whose head is `""` starts
    ; with a span, so the mapping goes onto the span's TYPE and the texts are
    ; handed back untouched.
    procedure apply_template_string_mapping(this, symbol: ref[Symbol], kind: int, texts: ref[Array[ref[String]?]], types: ref[Array[ref[Type]?]], out_texts: ref[ref[Array[ref[String]?]]?], out_types: ref[ref[Array[ref[Type]?]]?]) returns bool
    {
        let mark this.unported_mark()
        set out_texts: texts
        set out_types: types
        var whole false
        if kind = IntrinsicTypeKindUppercase
            set whole: true
        if kind = IntrinsicTypeKindLowercase
            set whole: true
        if whole
        {
            let nt this.new_string_list()
            let tn texts.get_length() as int
            var i 0
            while i < tn
            {
                let row texts[i]
                if row = null
                    return false
                let one row as ref[String]
                nt.add(this.apply_string_mapping(kind, Slice[char](one.get_length() as int, one.get_buffer() as pointer[char])))
                set i: i + 1
            }
            let ny this.new_type_list(null)
            let yn types.get_length() as int
            set i: 0
            while i < yn
            {
                let row types[i]
                if row = null
                    return false
                let made this.get_string_mapping_type(symbol, row as ref[Type])
                if made = null
                    return false
                ny.add(made)
                set i: i + 1
            }
            set out_texts: nt
            set out_types: ny
            return true
        }
        var first false
        if kind = IntrinsicTypeKindCapitalize
            set first: true
        if kind = IntrinsicTypeKindUncapitalize
            set first: true
        if first = false
            return true
        let head texts[0]
        if head = null
            return false
        let h head as ref[String]
        if (h.get_length() as int) <> 0
        {
            let nt this.new_string_list()
            let tn texts.get_length() as int
            var i 0
            while i < tn
            {
                let row texts[i]
                if row = null
                    return false
                if i = 0
                {
                    let one row as ref[String]
                    nt.add(this.apply_string_mapping(kind, Slice[char](one.get_length() as int, one.get_buffer() as pointer[char])))
                }
                else
                    nt.add(row)
                set i: i + 1
            }
            set out_texts: nt
            return true
        }
        let ny this.new_type_list(null)
        let yn types.get_length() as int
        var i 0
        while i < yn
        {
            let row types[i]
            if row = null
                return false
            if i = 0
            {
                let made this.get_string_mapping_type(symbol, row as ref[Type])
                if made = null
                    return false
                ny.add(made)
            }
            else
                ny.add(row)
            set i: i + 1
        }
        if this.unported_mark() <> mark
            return false
        set out_types: ny
        true
    }

    ; getStringMappingType — the intrinsic applied to a type. ★★★ITS ARMS ARE THE
    ; NORMALISATION: over a UNION it distributes, over a string LITERAL it is the
    ; case mapping and the answer is a literal again, over a TEMPLATE it pushes
    ; into the parts, over ITSELF it is idempotent, and only what is left is
    ; deferred as a StringMapping type. Without the first four `Uppercase<"a">`
    ; would be an opaque type nothing compares equal to `"A"`.
    procedure get_string_mapping_type(this, symbol: ref[Symbol], t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let kind Checker.intrinsic_type_kind(Symbol.name_of(symbol))
        if (t.flags & (TypeFlagsUnion | TypeFlagsNever)) <> 0
        {
            var a_value MapTypeArgs(null, null, null, null, null, false, null, null, 0, 0, 0, 0, 0, 0, null, null, null, null, null, null, false, null, null, 0, false, symbol, null, 0, null, null, null, null, 0, 0)
            let a &a_value as ref[MapTypeArgs]?
            return this.map_type(t, MapTypeKindStringMapping, a)
        }
        if (t.flags & TypeFlagsStringLiteral) <> 0
        {
            let mapped this.apply_string_mapping(kind, Checker.literal_text_of(t))
            return this.get_string_literal_type(Slice[char](mapped.get_length() as int, mapped.get_buffer() as pointer[char]))
        }
        if (t.flags & TypeFlagsTemplateLiteral) <> 0
        {
            let tx Checker.template_literal_texts_of(t)
            let ty Checker.template_literal_types_of(t)
            if tx = null
                return null
            if ty = null
                return null
            var new_texts: ref[Array[ref[String]?]]? null
            var new_types: ref[Array[ref[Type]?]]? null
            if this.apply_template_string_mapping(symbol, kind, tx as ref[Array[ref[String]?]], ty as ref[Array[ref[Type]?]], &new_texts, &new_types) = false
                return null
            if new_texts = null
                return null
            if new_types = null
                return null
            return this.get_template_literal_type(new_texts as ref[Array[ref[String]?]], new_types as ref[Array[ref[Type]?]])
        }
        if (t.flags & TypeFlagsStringMapping) <> 0
        {
            if t.symbol <> null
            {
                if (t.symbol as ref[Symbol]) = symbol
                    return t
            }
        }
        var generic false
        if (t.flags & (TypeFlagsAny | TypeFlagsString | TypeFlagsStringMapping)) <> 0
            set generic: true
        if generic = false
        {
            set generic: this.is_generic_index_type(t)
            if this.unported_mark() <> mark
                return null
        }
        if generic
            return this.get_string_mapping_type_for_generic_type(symbol, t)
        if this.is_pattern_literal_placeholder_type(t)
        {
            ; `getTemplateLiteralType(["", ""], [t])` — the placeholder wrapped as
            ; `` `${T}` `` so that the deferred mapping has a template to sit on.
            let texts this.new_string_list()
            texts.add(this.empty_string())
            texts.add(this.empty_string())
            let types this.new_type_list_of(1)
            types.add(t)
            let wrapped this.get_template_literal_type(texts, types)
            if wrapped = null
                return null
            return this.get_string_mapping_type_for_generic_type(symbol, wrapped as ref[Type])
        }
        if this.unported_mark() <> mark
            return null
        t
    }

    ; c.stringMappingTypes, keyed on (symbol, target). ★A LINEAR table like
    ; template_literal_types and for find_union_type's reason: both halves of the
    ; key are recoverable off the answer, the symbol from Type.symbol — which is
    ; where the reference keeps it too — and the target from the payload.
    procedure get_string_mapping_type_for_generic_type(this, symbol: ref[Symbol], t: ref[Type]) returns ref[Type]
    {
        let n string_mapping_types.get_length() as int
        var i 0
        while i < n
        {
            let row string_mapping_types[i]
            if row <> null
            {
                let cand row as ref[Type]
                if cand.symbol <> null
                {
                    if (cand.symbol as ref[Symbol]) = symbol
                    {
                        let target Checker.string_mapping_target_of(cand)
                        if target <> null
                        {
                            if (target as ref[Type]) = t
                                return cand
                        }
                    }
                }
            }
            set i: i + 1
        }
        let made this.new_string_mapping_type(symbol, t)
        string_mapping_types.add(made)
        made
    }

    procedure new_string_mapping_type(this, symbol: ref[Symbol], t: ref[Type]) returns ref[Type]
        this.new_type(TypeFlagsStringMapping, ObjectFlagsNone, symbol, TypeData.StringMapping(StringMappingTypeData(t)))

    ; isTypeMatchedByTemplateLiteralOrStringMapping — the two-armed test
    ; removeStringLiteralsMatchedByTemplateLiterals filters with.
    procedure is_type_matched_by_template_literal_or_string_mapping(this, t: ref[Type], template: ref[Type]) returns bool
    {
        if (template.flags & TypeFlagsTemplateLiteral) <> 0
            return this.is_type_matched_by_template_literal_type(t, template, SignatureComparerAssignable)
        this.is_member_of_string_mapping(t, template)
    }

    ; removeStringLiteralsMatchedByTemplateLiterals — a string literal already
    ; denoted by a pattern in the same union is redundant. ★It walks BACKWARDS
    ; because it deletes as it goes.
    procedure remove_string_literals_matched_by_template_literals(this, types: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]?
    {
        let mark this.unported_mark()
        let templates &Array[ref[Type]?]()
        var n types.get_length() as int
        var i 0
        while i < n
        {
            let row types[i]
            if row = null
                return null
            let one row as ref[Type]
            if this.is_pattern_literal_type(one)
                templates.add(one)
            if this.unported_mark() <> mark
                return null
            set i: i + 1
        }
        let tn templates.get_length() as int
        if tn = 0
            return types
        var out types
        set i: out.get_length() as int
        while i > 0
        {
            set i: i - 1
            let row out[i]
            if row = null
                return null
            let one row as ref[Type]
            if (one.flags & TypeFlagsStringLiteral) <> 0
            {
                var matched false
                var j 0
                while j < tn
                {
                    let trow templates[j]
                    if trow = null
                        return null
                    if this.is_type_matched_by_template_literal_or_string_mapping(one, trow as ref[Type])
                        set matched: true
                    if this.unported_mark() <> mark
                        return null
                    if matched
                        break
                    set j: j + 1
                }
                if matched
                    set out: this.type_list_without(out, i)
            }
        }
        out
    }

    ; extractRedundantTemplateLiterals — the INTERSECTION twin of the row above:
    ; `` `get${T}` `` & "getX" is just "getX", and Lowercase<string> & "foo" is
    ; just "foo". ★★★The second exit is what makes it two-valued: a pattern that
    ; no literal is a subtype of makes the whole intersection EMPTY, and the
    ; caller answers `never` rather than dropping a constituent.
    procedure extract_redundant_template_literals(this, types: ref[Array[ref[Type]?]], out_empty: ref[bool]) returns ref[Array[ref[Type]?]]?
    {
        let mark this.unported_mark()
        set out_empty: false
        let literals &Array[ref[Type]?]()
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let row types[i]
            if row = null
                return null
            let one row as ref[Type]
            if (one.flags & TypeFlagsStringLiteral) <> 0
                literals.add(one)
            set i: i + 1
        }
        let ln literals.get_length() as int
        var out types
        set i: out.get_length() as int
        while i > 0
        {
            set i: i - 1
            let row out[i]
            if row = null
                return null
            let one row as ref[Type]
            if (one.flags & (TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) <> 0
            {
                var j 0
                while j < ln
                {
                    let lrow literals[j]
                    if lrow = null
                        return null
                    var removed false
                    if this.is_type_subtype_of(lrow as ref[Type], one)
                    {
                        set out: this.type_list_without(out, i)
                        set removed: true
                    }
                    if this.unported_mark() <> mark
                        return null
                    if removed
                        break
                    if this.is_pattern_literal_type(one)
                    {
                        set out_empty: true
                        return out
                    }
                    if this.unported_mark() <> mark
                        return null
                    set j: j + 1
                }
            }
        }
        out
    }

    ; ── slice 126: the template literal's RELATION and INFERENCE halves ──
    ;
    ; getStringLikeTypeForType — anything that is not already string-like is
    ; wrapped as `` `${T}` ``, which is what lets the matcher work uniformly.
    procedure get_string_like_type_for_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & (TypeFlagsAny | TypeFlagsStringLike)) <> 0
            return t
        let texts this.new_string_list()
        texts.add(this.empty_string())
        texts.add(this.empty_string())
        let types this.new_type_list_of(1)
        types.add(t)
        this.get_template_literal_type(texts, types)
    }

    function empty_string(this) returns ref[String]
    {
        let s String^host()
        &s
    }

    ; templateLiteralTypesDefinitelyUnrelated — two templates whose STARTING or
    ; ENDING texts disagree over their common length can never be related, which is
    ; the cheap refusal in front of the matcher.
    function template_literal_types_definitely_unrelated(source: ref[Type], target: ref[Type]) returns bool
    {
        let stx Checker.template_literal_texts_of(source)
        let ttx Checker.template_literal_texts_of(target)
        if stx = null
            return false
        if ttx = null
            return false
        let sl stx as ref[Array[ref[String]?]]
        let tl ttx as ref[Array[ref[String]?]]
        let s_start sl[0]
        let t_start tl[0]
        let s_end sl[(sl.get_length() as int) - 1]
        let t_end tl[(tl.get_length() as int) - 1]
        if s_start = null
            return false
        if t_start = null
            return false
        if s_end = null
            return false
        if t_end = null
            return false
        let ss s_start as ref[String]
        let ts t_start as ref[String]
        let se s_end as ref[String]
        let te t_end as ref[String]
        var start_len ss.get_length() as int
        if (ts.get_length() as int) < start_len
            set start_len: ts.get_length() as int
        var end_len se.get_length() as int
        if (te.get_length() as int) < end_len
            set end_len: te.get_length() as int
        if Checker.bytes_equal(Slice[char](ss.get_length(), ss.get_buffer() as pointer[char]), 0, Slice[char](ts.get_length(), ts.get_buffer() as pointer[char]), 0, start_len) = false
            return true
        Checker.bytes_equal(Slice[char](se.get_length(), se.get_buffer() as pointer[char]), (se.get_length() as int) - end_len, Slice[char](te.get_length(), te.get_buffer() as pointer[char]), (te.get_length() as int) - end_len, end_len) = false
    }

    function bytes_equal(a: Slice[char], a_from: int, b: Slice[char], b_from: int, n: int) returns bool
    {
        var i 0
        while i < n
        {
            if a[(a_from + i)] <> b[(b_from + i)]
                return false
            set i: i + 1
        }
        true
    }

    ; strings.Index(hay[from:], needle) — the offset IN hay, or −1.
    function index_of_bytes(hay: Slice[char], from: int, needle: Slice[char]) returns int
    {
        if needle.length = 0
            return from
        var i from
        while (i + needle.length) <= hay.length
        {
            if Checker.bytes_equal(hay, i, needle, 0, needle.length)
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; isValidNumberString — `jsnum.FromString(s)` is neither NaN nor infinite.
    ; ★`roundTripOnly` is FALSE at both call sites this port has, so the
    ; `n.String() == s` half is the parameter's, not the body's.
    function is_valid_number_string(data: Slice[char]) returns bool
    {
        if data.length = 0
            return false
        let v jsnum_from_string(data)
        if jsnum_is_nan(v)
            return false
        jsnum_is_inf(v) = false
    }

    ; isValidBigIntString — a FRESH scanner over `s + "n"` with an error hook.
    ;
    ; ★★★ THE HOOK IS A DIAGNOSTIC LIST OF ITS OWN, AND THAT IS THE WHOLE OF IT.
    ; Upstream installs `SetOnError(func(...) { success = false })` — a closure
    ; whose only state is *did anything report* — and this scanner already reports
    ; into a DiagnosticList. A list nobody else holds answers the same question by
    ; its LENGTH and cannot reach the checker's own diagnostics, which is the one
    ; property the closure has that a shared list would not.
    ;
    ; ★ The `n` is appended rather than assumed: the caller's text is a STRING
    ; literal's value, so `"123"` has to be scanned as the bigint `123n` — which
    ; is also why the end test is `len(s)+1`.
    ;
    ; ★ The round trip is `s == pseudoBigIntToString(NewPseudoBigInt(...))`, and
    ; both halves of it are already here: pseudo_big_int_digits is
    ; ParsePseudoBigInt plus NewPseudoBigInt's TrimLeft, and
    ; write_pseudo_big_int_value is PseudoBigInt.String() including the empty →
    ; "0" case. The capacity the digits owe is jsnum's own `slen + slen/4 + 4`.
    procedure is_valid_big_int_string(this, s: Slice[char], round_trip_only: bool) returns bool
    {
        if s.length = 0
            return false
        let sb StringBuilder^host()
        sb.append(s.data, s.length)
        sb.append("n" as char)
        let augmented sb.to_string()
        let text Slice[char](augmented.get_length(), augmented.get_buffer() as pointer[char])
        let sink &DiagnosticList^host(host)
        let sc &Scanner^host()
        sc.begin_value_scan(text, sink)
        var result sc.scan()
        let negative result = KindMinusToken
        if negative
            set result: sc.scan()
        let flags sc.token_flags()
        if sink.length() <> 0
            return false
        if result <> KindBigIntLiteral
            return false
        if sc.token_end() <> (s.length + 1)
            return false
        if (flags & TokenFlagsContainsSeparator) <> 0
            return false
        if round_trip_only = false
            return true
        let tv sc.token_value()
        var digits_buf char[JSNUM_MAX_TEXT]
        if (tv.length + tv.length / 4 + 4) > JSNUM_MAX_TEXT
            return false
        var start 0
        let m Checker.pseudo_big_int_digits(tv, Slice[char](JSNUM_MAX_TEXT as size_t, &digits_buf[0]), &start)
        if m < 0
            return false
        let round StringBuilder^host()
        Checker.write_pseudo_big_int_value(&round, Slice[char](m as size_t, &digits_buf[start]), negative)
        let printed round.to_string()
        if printed.get_length() <> (s.length as size_t)
            return false
        Checker.bytes_equal(Slice[char](printed.get_length(), printed.get_buffer() as pointer[char]), 0, s, 0, s.length)
    }

    ; isValidTypeForTemplateLiteralPlaceholder — may `source` stand in the hole a
    ; template literal leaves for `target`?
    procedure is_valid_type_for_template_literal_placeholder(this, source: ref[Type], target: ref[Type], comparer: int) returns bool
    {
        let mark this.unported_mark()
        if (target.flags & TypeFlagsIntersection) <> 0
        {
            let ts Checker.intersection_types_of(target)
            if ts = null
                return false
            let list ts as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return false
                let ct row as ref[Type]
                var ok false
                if empty_type_literal_type <> null
                {
                    if ct = (empty_type_literal_type as ref[Type])
                        set ok: true
                }
                if ok = false
                {
                    if this.is_valid_type_for_template_literal_placeholder(source, ct, comparer) = false
                        return false
                }
                set i: i + 1
            }
            return true
        }
        if (target.flags & TypeFlagsString) <> 0
            return true
        if this.compare_types_by_comparer(comparer, source, target)
            return true
        if this.unported_mark() <> mark
            return false
        if (source.flags & TypeFlagsStringLiteral) <> 0
        {
            let vd Checker.literal_text_of(source)
            let vn Checker.literal_text_length_of(source)
            if (target.flags & TypeFlagsNumber) <> 0
                return Checker.is_valid_number_string(vd)
            if (target.flags & TypeFlagsBigInt) <> 0
                return this.is_valid_big_int_string(vd, false)
            ; `value == target.AsIntrinsicType().intrinsicName`. ★A BOOLEAN LITERAL
            ; is an intrinsic type upstream and a LITERAL type here, so its name is
            ; read off the value rather than off the slot.
            if (target.flags & TypeFlagsBooleanLiteral) <> 0
            {
                if Checker.literal_bool_of(target)
                    return Checker.name_is(vd, "true")
                return Checker.name_is(vd, "false")
            }
            if (target.flags & (TypeFlagsUndefined | TypeFlagsNull)) <> 0
                return Checker.name_is(vd, Checker.intrinsic_name_of(target))
            if (target.flags & TypeFlagsStringMapping) <> 0
                return this.is_member_of_string_mapping(source, target)
            if (target.flags & TypeFlagsTemplateLiteral) <> 0
                return this.is_type_matched_by_template_literal_type(source, target, comparer)
            return false
        }
        if (source.flags & TypeFlagsTemplateLiteral) <> 0
        {
            ; `` `${T}` `` — a template with two EMPTY texts and one type is that
            ; type, so the comparison is on the type itself.
            let stx Checker.template_literal_texts_of(source)
            let sty Checker.template_literal_types_of(source)
            if stx = null
                return false
            if sty = null
                return false
            let tl stx as ref[Array[ref[String]?]]
            if (tl.get_length() as int) <> 2
                return false
            let t0 tl[0]
            let t1 tl[1]
            if t0 = null
                return false
            if t1 = null
                return false
            if ((t0 as ref[String]).get_length() as int) <> 0
                return false
            if ((t1 as ref[String]).get_length() as int) <> 0
                return false
            let yl sty as ref[Array[ref[Type]?]]
            let only yl[0]
            if only = null
                return false
            return this.compare_types_by_comparer(comparer, only as ref[Type], target)
        }
        false
    }

    ; isMemberOfStringMapping. ★★★ITS THIRD ARM IS THE DEFINITION OF MEMBERSHIP IN
    ; A DEFERRED MAPPING and it is a FIXED POINT rather than a comparison: `s` is a
    ; member of `Uppercase<T>` exactly when mapping `s` leaves it alone and it is
    ; a member of T — which is what makes `Uppercase<Lowercase<string>>` decidable
    ; without ever expanding either.
    procedure is_member_of_string_mapping(this, source: ref[Type], target: ref[Type]) returns bool
    {
        if (target.flags & TypeFlagsAny) <> 0
            return true
        if (target.flags & (TypeFlagsString | TypeFlagsTemplateLiteral)) <> 0
            return this.is_type_assignable_to(source, target)
        if (target.flags & TypeFlagsStringMapping) <> 0
        {
            ; ★★★ THE NESTED MAPPINGS COMPOSE, AND UNTIL SLICE 185 THIS LINE ASKED
            ; THE OUTERMOST ONE ALONE. Upstream is
            ; `mapped, inner := applyTargetStringMappingToSource(source, target)`
            ; followed by `mapped == source && isMemberOfStringMapping(source, inner)`
            ; — `inner` is the INNERMOST non-string-mapped target, and the source
            ; that the outer mapping is applied to is the source with every INNER
            ; mapping already applied. Asking one level at a time is a different
            ; question: for `Uppercase<Lowercase<string>>` and source `"A"` the
            ; recursion's second step asked whether `Lowercase<"A">` is `"A"`,
            ; which is `"a"`, and the assignment was refused. Nine stage-2 units
            ; carried the resulting TS2322.
            var inner: ref[Type]? null
            let mapped this.apply_target_string_mapping_to_source(source, target, &inner)
            if mapped = null
                return false
            if inner = null
                return false
            if (mapped as ref[Type]) <> source
                return false
            return this.is_member_of_string_mapping(source, inner as ref[Type])
        }
        false
    }

    ; applyTargetStringMappingToSource — the pair the reference returns: the
    ; source with the target's whole mapping chain applied INNERMOST FIRST, and
    ; the innermost non-string-mapped target. `out_inner` carries the second.
    procedure apply_target_string_mapping_to_source(this, source: ref[Type], target: ref[Type], out_inner: ref[ref[Type]?]) returns ref[Type]?
    {
        if target.symbol = null
            return null
        let t0 Checker.string_mapping_target_of(target)
        if t0 = null
            return null
        var inner t0 as ref[Type]
        var src source
        if (inner.flags & TypeFlagsStringMapping) <> 0
        {
            var deeper: ref[Type]? null
            let mapped this.apply_target_string_mapping_to_source(src, inner, &deeper)
            if mapped = null
                return null
            if deeper = null
                return null
            set src: mapped as ref[Type]
            set inner: deeper as ref[Type]
        }
        set out_inner: inner
        this.get_string_mapping_type(target.symbol as ref[Symbol], src)
    }

    ; isTypeMatchedByTemplateLiteralType — the matcher, then every inference
    ; against the placeholder it filled.
    procedure is_type_matched_by_template_literal_type(this, source: ref[Type], target: ref[Type], comparer: int) returns bool
    {
        var inferences Array[ref[Type]?]()
        if this.infer_types_from_template_literal_type(source, target, &inferences) = false
            return false
        let list &inferences
        let tty Checker.template_literal_types_of(target)
        if tty = null
            return false
        let tl tty as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        if (tl.get_length() as int) < n
            return false
        var i 0
        while i < n
        {
            let inf list[i]
            let ph tl[i]
            if inf = null
                return false
            if ph = null
                return false
            if this.is_valid_type_for_template_literal_placeholder(inf as ref[Type], ph as ref[Type], comparer) = false
                return false
            set i: i + 1
        }
        true
    }

    ; inferTypesFromTemplateLiteralType — the two source shapes.
    ;
    ; ★★★ THE EQUAL-TEXTS ARM IS A MAP AND NOT A PASS-THROUGH, AND THE LINE THAT
    ; STOOD HERE CERTIFIED THE PASS-THROUGH (*a source template whose texts are
    ; EXACTLY the target's contributes its own types unchanged*, slice 181). The
    ; reference's `core.MapIndex` asks, per position, whether the source's
    ; constituent is assignable to the target's under both base constraints; only
    ; then does it contribute ITSELF. Where it is not, the inference contributes
    ; `` `${T}` `` — getStringLikeTypeForType — which is what keeps a placeholder
    ; constrained to `string` from inferring a type its constraint refuses. That
    ; helper had been written since slice 126 and this was its only caller, so it
    ; sat in the file with no call site at all (`tools/nocaller.py`).
    ;
    ; ★ The inferences go into `out`, which the CALLER holds in its own region —
    ; every caller only reads them — and `false` is the reference's nil.
    procedure infer_types_from_template_literal_type(this, source: ref[Type], target: ref[Type], out: ref[Array[ref[Type]?]]) returns bool
    {
        if (source.flags & TypeFlagsStringLiteral) <> 0
        {
            var texts Array[ref[String]?]()
            var v String(Checker.literal_text_of(source).data as pointer[const_char], Checker.literal_text_length_of(source) as size_t)
            texts.add(&v)
            return this.infer_from_literal_parts_to_template_literal(&texts, null, target, out)
        }
        if (source.flags & TypeFlagsTemplateLiteral) <> 0
        {
            if Checker.template_texts_equal(source, target)
                return this.map_template_source_types(source, target, out)
            let stx Checker.template_literal_texts_of(source)
            let sty Checker.template_literal_types_of(source)
            if stx = null
                return false
            return this.infer_from_literal_parts_to_template_literal(stx as ref[Array[ref[String]?]], sty, target, out)
        }
        false
    }

    ; The equal-texts arm's `core.MapIndex`. ★The index is the point: the source's
    ; i-th constituent is compared against the TARGET's i-th, so this cannot be
    ; written as a plain map over the source alone.
    procedure map_template_source_types(this, source: ref[Type], target: ref[Type], out: ref[Array[ref[Type]?]]) returns bool
    {
        let mark this.unported_mark()
        let sty Checker.template_literal_types_of(source)
        let tty Checker.template_literal_types_of(target)
        if sty = null
            return false
        let st sty as ref[Array[ref[Type]?]]
        let n st.get_length() as int
        var i 0
        while i < n
        {
            let row st[i]
            if row = null
            {
                out.add(null)
                set i: i + 1
                continue
            }
            let s row as ref[Type]
            var contributed: ref[Type]? null
            var tgt: ref[Type]? null
            if tty <> null
            {
                let tt tty as ref[Array[ref[Type]?]]
                if i < (tt.get_length() as int)
                    set tgt: tt[i]
            }
            if tgt <> null
            {
                let sb this.get_base_constraint_or_type(s)
                if this.unported_mark() <> mark
                    return false
                let tb this.get_base_constraint_or_type(tgt as ref[Type])
                if this.unported_mark() <> mark
                    return false
                if (sb <> null) and (tb <> null)
                {
                    if this.is_type_assignable_to(sb as ref[Type], tb as ref[Type])
                        set contributed: s
                }
                if this.unported_mark() <> mark
                    return false
            }
            if contributed = null
            {
                set contributed: this.get_string_like_type_for_type(s)
                if this.unported_mark() <> mark
                    return false
            }
            out.add(contributed)
            set i: i + 1
        }
        true
    }

    ; The source text at `index` — the trailing segment is the END text with the
    ; target's own suffix already removed.
    function template_source_text(source_texts: ref[Array[ref[String]?]], last_source_index: int, remaining_end: ref[String], index: int) returns ref[String]
    {
        if index < last_source_index
        {
            let row source_texts[index]
            if row <> null
                return row as ref[String]
        }
        remaining_end
    }

    ; addMatch — the closure over `seg`, `pos` and `matches`.
    ;
    ; ★★ THE TWO ARMS ARE *the match lies inside ONE source segment* (a plain
    ; substring, so a string literal type) and *it spans several* (so a template
    ; literal type built from the partial texts and the types between them).
    procedure add_template_match(this, st: ref[TemplateMatchState], source_texts: ref[Array[ref[String]?]], source_types: ref[Array[ref[Type]?]]?, last_source_index: int, remaining_end: ref[String], s: int, p: int)
    {
        if s = st.seg
        {
            let seg_text Checker.template_source_text(source_texts, last_source_index, remaining_end, s)
            let cut this.combined_bytes(Slice[char](seg_text.get_length(), seg_text.get_buffer() as pointer[char]).subslice(st.pos as size_t, p as size_t))
            if cut = null
                return
            let only cut as ref[String]
            let mt this.get_string_literal_type(Slice[char](only.get_length() as int, only.get_buffer() as pointer[char]))
            st.matches.add(mt)
        }
        else
        {
            let match_texts this.new_string_list()
            let first source_texts[st.seg]
            if first = null
                return
            let fs first as ref[String]
            let head String^host(((fs.get_buffer() as pointer[char]) + st.pos) as pointer[const_char], ((fs.get_length() as int) - st.pos) as size_t)
            match_texts.add(&head)
            var k st.seg + 1
            while k < s
            {
                match_texts.add(source_texts[k])
                set k: k + 1
            }
            let tail_text Checker.template_source_text(source_texts, last_source_index, remaining_end, s)
            let tail String^host(tail_text.get_buffer() as pointer[const_char], p as size_t)
            match_texts.add(&tail)
            let between this.new_type_list(null)
            if source_types <> null
            {
                let sl source_types as ref[Array[ref[Type]?]]
                var j st.seg
                while j < s
                {
                    if j < (sl.get_length() as int)
                        between.add(sl[j])
                    set j: j + 1
                }
            }
            let mt this.get_template_literal_type(match_texts, between)
            if mt = null
                return
            st.matches.add(mt)
        }
        set st.seg: s
        set st.pos: p
    }

    ; inferFromLiteralPartsToTemplateLiteral — the matcher itself: it walks the
    ; TARGET's delimiters and cuts the source into the pieces between them.
    ;
    ; ★★★ THE EMPTY-DELIMITER ARM CONSUMES ONE CODE POINT AT A TIME AND THE
    ; REFERENCE SAYS WHY: `` `${A}${B}` `` has nothing to search for, so the split
    ; is the string ITERATOR's, not UTF-16 code-unit indexing — and it must use
    ; DecodeJSStringRune, because a lone surrogate is stored as an invalid-UTF-8
    ; sentinel that plain UTF-8 decoding would break into stray bytes. That is a
    ; deliberate divergence from Strada, documented upstream at this line.
    procedure infer_from_literal_parts_to_template_literal(this, source_texts: ref[Array[ref[String]?]], source_types: ref[Array[ref[Type]?]]?, target: ref[Type], out: ref[Array[ref[Type]?]]) returns bool
    {
        let ttx Checker.template_literal_texts_of(target)
        if ttx = null
            return false
        let target_texts ttx as ref[Array[ref[String]?]]
        let last_source_index (source_texts.get_length() as int) - 1
        let s0 source_texts[0]
        let sl source_texts[last_source_index]
        if s0 = null
            return false
        if sl = null
            return false
        let source_start s0 as ref[String]
        let source_end sl as ref[String]
        let last_target_index (target_texts.get_length() as int) - 1
        let t0 target_texts[0]
        let tl target_texts[last_target_index]
        if t0 = null
            return false
        if tl = null
            return false
        let target_start t0 as ref[String]
        let target_end tl as ref[String]
        let ss_len source_start.get_length() as int
        let se_len source_end.get_length() as int
        let ts_len target_start.get_length() as int
        let te_len target_end.get_length() as int
        if last_source_index = 0
        {
            if ss_len < (ts_len + te_len)
                return false
        }
        ; HasPrefix and HasSuffix.
        if ss_len < ts_len
            return false
        if Checker.bytes_equal(Slice[char](source_start.get_length(), source_start.get_buffer() as pointer[char]), 0, Slice[char](target_start.get_length(), target_start.get_buffer() as pointer[char]), 0, ts_len) = false
            return false
        if se_len < te_len
            return false
        if Checker.bytes_equal(Slice[char](source_end.get_length(), source_end.get_buffer() as pointer[char]), se_len - te_len, Slice[char](target_end.get_length(), target_end.get_buffer() as pointer[char]), 0, te_len) = false
            return false
        var remaining_end String(source_end.get_buffer() as pointer[const_char], (se_len - te_len) as size_t)
        var state TemplateMatchState(0, ts_len, out)
        let st &state
        var i 1
        while i < last_target_index
        {
            let drow target_texts[i]
            if drow = null
                return false
            let delim drow as ref[String]
            let dn delim.get_length() as int
            if dn > 0
            {
                var sseg st.seg
                var p st.pos
                var found false
                while found = false
                {
                    let hay Checker.template_source_text(source_texts, last_source_index, &remaining_end, sseg)
                    let d Checker.index_of_bytes(Slice[char](hay.get_length() as int, hay.get_buffer() as pointer[char]), p, Slice[char](dn, delim.get_buffer() as pointer[char]))
                    if d >= 0
                    {
                        set p: d
                        set found: true
                    }
                    else
                    {
                        set sseg: sseg + 1
                        if sseg = (source_texts.get_length() as int)
                            return false
                        set p: 0
                    }
                }
                this.add_template_match(st, source_texts, source_types, last_source_index, &remaining_end, sseg, p)
                set st.pos: st.pos + dn
            }
            else
            {
                let seg_text Checker.template_source_text(source_texts, last_source_index, &remaining_end, st.seg)
                if st.pos < (seg_text.get_length() as int)
                {
                    var size 0
                    Checker.decode_js_string_rune(Slice[char](seg_text.get_length(), seg_text.get_buffer() as pointer[char]), st.pos, &size)
                    this.add_template_match(st, source_texts, source_types, last_source_index, &remaining_end, st.seg, st.pos + size)
                }
                else
                {
                    if st.seg < last_source_index
                        this.add_template_match(st, source_texts, source_types, last_source_index, &remaining_end, st.seg + 1, 0)
                    else
                        return false
                }
            }
            set i: i + 1
        }
        let final_text Checker.template_source_text(source_texts, last_source_index, &remaining_end, last_source_index)
        this.add_template_match(st, source_texts, source_types, last_source_index, &remaining_end, last_source_index, final_text.get_length() as int)
        true
    }

    ; c.templateConstraintType, memoized on first use — see the slot's note.
    procedure get_template_constraint_type(this) returns ref[Type]?
    {
        if template_constraint_type <> null
            return template_constraint_type
        let list this.new_type_list_of(6)
        list.add(string_type)
        list.add(number_type)
        list.add(boolean_type)
        list.add(bigint_type)
        list.add(null_type)
        list.add(undefined_type)
        let t this.get_union_type(list)
        if t = null
            return null
        set template_constraint_type: t
        template_constraint_type
    }


    ; getLiteralTypeFromProperties — the enumerating half: a union of the literal
    ; types of every property name plus every index signature's key type.
    ;
    ; ★★ THE ORIGIN IS THE SAME MECHANISM THE INTERSECTION'S CROSS PRODUCT USES,
    ; and it is what makes `keyof Foo` print as `keyof Foo` instead of as the list
    ; of its keys. It is attached for a CLASS, an INTERFACE, a REFERENCE or an
    ; ALIASED type — which is the whole of what has a name to print.
    ;
    ; ★ The propertiesTypes memo is NOT carried: its key is
    ; (type id, include, includeOrigin, unresolvedMembers) and its answer is
    ; interned by the union table, so a miss costs a re-walk and cannot cost a
    ; second type. That is find_union_type's argument, applied a second time.
    procedure get_literal_type_from_properties(this, t: ref[Type], include: int, include_origin: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var origin: ref[Type]? null
        var wants_origin false
        if include_origin
        {
            if (t.object_flags & (ObjectFlagsClassOrInterface | ObjectFlagsReference)) <> 0
                set wants_origin: true
        }
        if t.alias_symbol <> null
            set wants_origin: true
        if wants_origin
            set origin: this.new_index_type(t, IndexFlagsNone)
        let props this.get_properties_of_type(t)
        if this.unported_mark() <> mark
            return null
        let types &Array[ref[Type]?]()
        if props <> null
        {
            let list props as ref[Array[ref[Symbol]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e = null
                    return null
                let one this.get_literal_type_from_property(e as ref[Symbol], include, false)
                if one = null
                    return null
                types.add(one)
                set i: i + 1
            }
        }
        let infos this.get_index_infos_of_type(t)
        if this.unported_mark() <> mark
            return null
        if infos <> null
        {
            let list infos as ref[Array[ref[IndexInfo]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e <> null
                {
                    let info e as ref[IndexInfo]
                    var is_enum_number false
                    if enum_number_index_info <> null
                    {
                        if (enum_number_index_info as ref[IndexInfo]) = info
                            set is_enum_number: true
                    }
                    if is_enum_number = false
                    {
                        if info.key_type <> null
                        {
                            let kt info.key_type as ref[Type]
                            if Checker.is_key_type_included(kt, include)
                            {
                                var substituted false
                                if kt = string_type
                                {
                                    if (include & TypeFlagsNumber) <> 0
                                    {
                                        if string_or_number_type = null
                                        {
                                            this.record_unported("string-or-number-type-unminted", include)
                                            return null
                                        }
                                        types.add(string_or_number_type)
                                        set substituted: true
                                    }
                                }
                                if substituted = false
                                    types.add(kt)
                            }
                        }
                    }
                }
                set i: i + 1
            }
        }
        this.get_union_type_ex(types, UnionReductionLiteral, null, origin)
    }

    ; isKeyTypeIncluded — the key's own flags, or for an intersection SOME
    ; constituent's (`core.Some`). ★It asked EVERY constituent until slice 202, so a
    ; tagged string `string & { __tag: 'id' }` was not a key and
    ; `keyof { [key: Id]: number }` answered `never` (`indexSignatures1`).
    function is_key_type_included(key_type: ref[Type], include: int) returns bool
    {
        if (key_type.flags & include) <> 0
            return true
        if (key_type.flags & TypeFlagsIntersection) <> 0
        {
            let ts Checker.intersection_types_of(key_type)
            if ts <> null
            {
                let list ts as ref[Array[ref[Type]?]]
                let n list.get_length() as int
                var i 0
                while i < n
                {
                    let e list[i]
                    if e <> null
                    {
                        if Checker.is_key_type_included(e as ref[Type], include)
                            return true
                    }
                    set i: i + 1
                }
            }
        }
        false
    }

    ; getLiteralTypeFromProperty, whole but for one guard. ★The `nameType` slot it
    ; reads first is a late-bound name's computed type; get_late_bound_symbol stops
    ; on a computed member, so the memo is null for everything this port reaches and
    ; the name comes from the DECLARATION instead.
    procedure get_literal_type_from_property(this, prop: ref[Symbol], include: int, include_non_public: bool) returns ref[Type]?
    {
        var visible include_non_public
        if visible = false
        {
            if (this.get_declaration_modifier_flags_from_symbol(prop) & ModifierFlagsNonPublicAccessibilityModifier) = 0
                set visible: true
        }
        if visible = false
            return never_type
        let mark this.unported_mark()
        ; `c.valueSymbolLinks.Get(c.getLateBoundSymbol(prop)).nameType`.
        ;
        ; ★★★ THE SLOT HAS A PRODUCER SINCE SLICE 125 AND THE NOTE THAT STOOD HERE
        ; IS ITS EXPIRY. It read *"nameType is filled only for a LATE-BOUND member
        ; … so the memo would be null at every arrival"* — true of the late-bound
        ; path, and resolve_mapped_type_members writes the same slot for every
        ; property it synthesizes. Reading it is what makes `keyof { [P in K]: T }`
        ; answer the REMAPPED name rather than the property's spelling.
        ;
        ; ★★★ THE CALL WOULD STAY EVEN IF THE VALUE WERE THROWN AWAY, because it
        ; REPORTS: get_late_bound_symbol's stop is what makes a computed member an
        ; honest UNPORTED instead of a name read off the declaration (§3.5dl).
        let late this.get_late_bound_symbol(prop)
        if this.unported_mark() <> mark
            return null
        if late = null
            return null
        var t: ref[Type]? this.value_symbol_link_of(late as ref[Symbol]).name_type
        if t = null
        {
            var dd Slice[char]()
            ; InternalSymbolNameDefault is the plain `default` (no internal prefix)
            set dd: Binder.internal_name_unprefixed(host, "default")
            if SymbolTable.names_equal(Symbol.name_of(prop), dd)
                set t: this.get_string_literal_type("default")
            else
            {
                let name b.get_name_of_declaration(Symbol.value_declaration_of(prop))
                if name <> null
                {
                    set t: this.get_literal_type_from_property_name(name as ref[AstNode])
                    if this.unported_mark() <> mark
                        return null
                }
                if t = null
                {
                    ; `!IsKnownSymbol(prop)` — a well-known symbol member, whose name
                    ; carries the internal `@@` prefix. get_late_bound_symbol is the
                    ; only producer of one and it stops, so the guard is constant
                    ; true and the plain name is the answer.
                    set t: this.get_string_literal_type(Symbol.name_of(prop))
                }
            }
        }
        if t = null
            return never_type
        if ((t as ref[Type]).flags & include) <> 0
            return t
        never_type
    }

    ; newIndexedAccessType and its table's lookup.
    procedure new_indexed_access_type(this, object_type: ref[Type], index_type: ref[Type], access_flags: int) returns ref[Type]
        this.new_type(TypeFlagsIndexedAccess, ObjectFlagsNone, null, TypeData.IndexedAccess(IndexedAccessTypeData(object_type, index_type, access_flags)))

    procedure find_indexed_access_type(this, object_type: ref[Type], index_type: ref[Type], flags: int, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        let n indexed_access_types.get_length() as int
        let chain indexed_access_types_chain
        while chain.count() < n
        {
            let pending indexed_access_types[chain.count() as size_t]
            if pending = null
                chain.add_blank()
            else
            {
                let pe pending as ref[IndexedAccessEntry]
                chain.add(Checker.key3_hash(pe.object_type as int, pe.index_type as int, pe.key_flags))
            }
        }
        var i chain.first(Checker.key3_hash(object_type as int, index_type as int, flags))
        while i >= 0
        {
            let row indexed_access_types[i as size_t]
            if row <> null
            {
                let e row as ref[IndexedAccessEntry]
                if e.key_flags = flags
                {
                    if e.object_type = object_type
                    {
                        if e.index_type = index_type
                        {
                            if e.t <> null
                            {
                                if Checker.type_alias_matches(e.t as ref[Type], alias)
                                    return e.t
                            }
                        }
                    }
                }
            }
            set i: chain.after(i)
        }
        null
    }


    ; ── slice 121: THE CONDITIONAL TYPE ──────────────────────────────────────
    ;
    ; getTypeFromConditionalTypeNode, getConditionalType and the six functions
    ; around them. It is the largest row on the frontier by events and the reason is
    ; that `T extends U ? X : Y` is how the lib's own utility types are written.
    ;
    ; ★★★ THE DEFERRED PATH IS THE ONE THIS SLICE ANSWERS, AND THAT IS NOT A
    ; SHORTCUT — IT IS WHERE THE REFERENCE ALSO STOPS COMPUTING. getConditionalType
    ; resolves a conditional only when BOTH the check type and the inferred extends
    ; type are non-generic; with a type parameter on either side it mints a
    ; ConditionalType and answers. Every RESOLVING branch goes through
    ; `isTypeAssignableTo` — the relation — so the split between what this chapter
    ; writes and what it reports follows the reference's own `if`, not a budget.
    ;
    ; ★★ THE `for` LOOP IS A TAIL RECURSION AND ITS COUNTER IS A REPORT. Upstream
    ; treats `A extends B ? X : C extends D ? Y : ...` as ONE construct and loops
    ; rather than recursing, with a 1000-iteration guard that reports TS2589. Only
    ; the resolving branches `continue`, so the loop this port writes runs once —
    ; but it is written AS a loop, because the day the relation lands the branches
    ; are already in the right place.
    procedure get_type_from_conditional_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let cn AstNode.conditional_type_check_of(node)
        let en AstNode.conditional_type_extends_of(node)
        if cn = null
            return null
        if en = null
            return null
        let check_type this.get_type_from_type_node(cn as ref[AstNode])
        if check_type = null
            return null
        let alias this.get_alias_for_type_node(node)
        ; ★★ TWO DIVERGENCES, ONE READER, AND THE READER IS NOT PORTED. The
        ; reference passes `includeThisTypes: true` here, which this port's
        ; get_outer_type_parameters does not take — it never appends a class's
        ; `thisType` — and the `core.Filter` below it is dropped (see the note at
        ; `outer`). Both affect ONLY `root.outerTypeParameters`, whose single
        ; reader is getConditionalTypeInstantiation; neither reaches the type this
        ; function answers.
        ; `getOuterTypeParameters(node, true /*includeThisTypes*/)`: a conditional written on
        ; `this` (`this extends C ? … : …` in a method return type) resolves on instantiation
        ; only if the class's `this` type parameter is among the root's outer parameters
        let all_outer this.get_outer_type_parameters(node, true)
        ; `alias != nil && len(alias.typeArguments) != 0` keeps EVERY outer type
        ; parameter; otherwise only the ones the node could possibly reference.
        ; ★★★ THE FILTER IS THE REFERENCE'S OWN CONSERVATIVE BRANCH, NOT A GAP.
        ; `core.Filter(allOuterTypeParameters, isTypeParameterPossiblyReferenced)`
        ; drops an outer type parameter the node cannot mention; that predicate's
        ; documented FALLBACK is *"we consider the type parameter possibly
        ; referenced"* — it answers TRUE whenever it cannot prove otherwise — so
        ; keeping every parameter is the same answer it gives for anything it
        ; cannot decide, taken for everything.
        ;
        ; ★★★ AND THE ONLY READER OF THE DIFFERENCE IS NOT PORTED. `outer` is used
        ; twice: for `keep_all` (unchanged) and to decide whether the root seeds
        ; its instantiation memo — whose reader is
        ; getConditionalTypeInstantiation. Keeping more parameters seeds the memo
        ; more often and nothing reads it, so the divergence is unobservable
        ; TODAY and stops being so on the day that function lands. It is written
        ; here rather than in a lessons file because that is the line that has to
        ; change.
        let outer all_outer
        let extends_type this.get_type_from_type_node(en as ref[AstNode])
        if extends_type = null
            return null
        var distributive false
        if ((check_type as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
            set distributive: true
        let infer_params this.get_infer_type_parameters(node)
        let root &ConditionalRoot^host(node, check_type as ref[Type], extends_type as ref[Type], distributive, infer_params, outer, alias)
        let t this.get_conditional_type(root, null, false, null)
        if t = null
            return null
        set links.resolved_type: t
        ; `root.instantiations[key] = links.resolvedType` — the root's own memo,
        ; seeded with the uninstantiated answer, i.e. the root's OWN outer type
        ; parameters as the arguments. Slice 125's
        ; get_conditional_type_instantiation is the reader this line was written
        ; for.
        if outer <> null
        {
            let seeded &Array[ref[ConditionalInstantiation]?]^host()
            set root.instantiations: seeded
            this.add_conditional_instantiation(root, outer, alias, false, links.resolved_type)
        }
        links.resolved_type
    }

    procedure get_conditional_type(this, root_in: ref[ConditionalRoot], mapper: ref[TypeMapper]?, for_constraint: bool, alias_in: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        var root root_in
        var alias: ref[TypeAlias]? alias_in
        ; ★ `mapper` is REBOUND by the two tail-recursion arms, so the loop carries
        ; its own `m` — the reference assigns the parameter and this port cannot.
        var m: ref[TypeMapper]? mapper
        var tail_count 0
        ; ★★★ `result` AND `extra_types` ARE WHAT MAKE THE LOOP A LOOP. Until slice
        ; 151 every path out of this body was a `return`, because the only path that
        ; existed was the deferred one; the resolving half exits through a `break`
        ; instead, since a distributive conditional's TRUE branch is collected in
        ; `extra_types` across iterations and unioned with the answer at the end.
        var result: ref[Type]? null
        var extra_types: ref[Array[ref[Type]?]]? null
        repeat
        {
            if tail_count = 1000
            {
                ; TS2589, at c.currentNode — the field slice 154 added; see
                ; instantiate_type's limiter, which is the same report.
                this.error_on_node(current_node, DiagType_instantiation_is_excessively_deep_and_possibly_infinite)
                return error_type
            }
            let actual this.get_actual_type_variable(root.check_type)
            if actual = null
                return null
            let check_type this.instantiate_type(actual, m)
            if this.unported_mark() <> mark
                return null
            if check_type = null
                return null
            let extends_type this.instantiate_type(root.extends_type, m)
            if this.unported_mark() <> mark
                return null
            if extends_type = null
                return null
            let ct check_type as ref[Type]
            let et extends_type as ref[Type]
            if ct = error_type
                return error_type
            if et = error_type
                return error_type
            if ct = wildcard_type
                return wildcard_type
            if et = wildcard_type
                return wildcard_type
            ; `checkTuples` — two SIMPLE tuple type nodes of the same arity, which is
            ; what lets `[X] extends [Y] ? …` defer the way `X extends Y ? …` does.
            let check_node Checker.skip_type_parentheses(AstNode.conditional_type_check_of(root.node))
            let extends_node Checker.skip_type_parentheses(AstNode.conditional_type_extends_of(root.node))
            var check_tuples false
            if this.is_simple_tuple_type(check_node)
            {
                if this.is_simple_tuple_type(extends_node)
                {
                    if Checker.type_node_element_count(check_node) = Checker.type_node_element_count(extends_node)
                        set check_tuples: true
                }
            }
            let check_type_deferred this.is_deferred_type(ct, check_tuples)
            if this.unported_mark() <> mark
                return null
            ; ★★★ THE INFERENCE CONTEXT, SLICE 136, AND ITS NOTE NAMED THE
            ; DIMENSION IT WAS WAITING FOR: *"newInferenceContext, inferTypes and
            ; combineTypeMappers, i.e. the inference dimension"*. `inference.go`
            ; landed WHOLE in slice 122 — the context lifecycle and its four mappers
            ; included — and the stop stood for thirteen slices after it.
            ;
            ; ★★★ THE ORDER OF THE COMBINED MAPPER IS THE REFERENCE'S OWN AND IT IS
            ; LOAD-BEARING: `combineTypeMappers(context.mapper, mapper)`, the
            ; INFERENCE mapper first. Its comment says why — *"it's possible for
            ; 'infer T' type parameters to be given uninstantiated constraints when
            ; those type parameters are used in type references (see
            ; getInferredTypeParameterConstraint)"* — which is exactly the arm this
            ; same slice writes, so the two are one mechanism read from two ends.
            ;
            ; ★ The nonFixingMapper is combined the OTHER way round
            ; (`context.nonFixingMapper` then `mapper`), because a constraint asked
            ; through it must be instantiated in the CALLER's context and not only in
            ; the inference's.
            ;
            ; ★★★ AND BOTH ARE `combineTypeMappers` AND NOT `mergeTypeMappers`, WHICH
            ; THEY WERE UNTIL SLICE 151, AND THEY WERE NOT ALONE. Slice 136 wrote the
            ; merged form because the COMPOSITE arm had no writer yet; slice 139 gave
            ; it one and its own header then claimed instantiate_symbol and
            ; instantiate_signature *are the whole of combine_type_mappers' caller
            ; list*, which was false at the moment it was written. The reference has
            ; ELEVEN `combineTypeMappers` call sites and exactly ONE
            ; `mergeTypeMappers` (inference.go's type-parameter default); this port
            ; had five merged, of which four were combine's — these two, the
            ; conditional arm of instantiate_type_worker, get_object_type_
            ; instantiation's outer-parameter mapper and instantiate_anonymous_type's
            ; fresh mapped parameter. FOUR of the four are the reference's spelling
            ; now; the fifth, get_object_type_instantiation's, is a MEASURED
            ; divergence and its own note names the mechanism it is waiting for.
            ;
            ; ★★★ THE TWO DIFFER EXACTLY WHERE IT MATTERS FOR AN `infer`: merged asks
            ; m2 about the TOP-LEVEL type alone, composite INSTANTIATES the whole of
            ; m1's answer through m2, so an inference that lands inside a type
            ; reference's argument (`Foo<infer U>`) was mapped by the inference and
            ; then left alone by the caller's mapper. Here it could not be seen while
            ; the resolving half reported (§3.5fq); at the other three it was a wrong
            ; answer nothing guarded.
            var combined_mapper: ref[TypeMapper]? null
            if root.infer_type_parameters <> null
            {
                let infer_tps root.infer_type_parameters as ref[Array[ref[Type]?]]
                if (infer_tps.get_length() as int) <> 0
                {
                    let context this.new_inference_context(infer_tps, null, InferenceFlagsNone, SignatureComparerAssignable)
                    if m <> null
                        set context.non_fixing_mapper: this.combine_type_mappers(context.non_fixing_mapper, m)
                    if check_type_deferred = false
                    {
                        ; "We don't want inferences from constraints as they may
                        ; cause us to eagerly resolve the conditional type instead of
                        ; deferring resolution. Also, we always want strict function
                        ; types rules (i.e. proper contravariance) for inferences."
                        this.infer_types(context.inferences, ct, et, InferencePriorityNoConstraints | InferencePriorityAlwaysStrict, false)
                        if this.unported_mark() <> mark
                            return null
                    }
                    if m <> null
                        set combined_mapper: this.combine_type_mappers(context.mapper, m)
                    else
                        set combined_mapper: context.mapper
                }
            }
            ; "Instantiate the extends type including inferences for 'infer T' type
            ; parameters."
            var inferred_extends_type et
            if combined_mapper <> null
            {
                let inst this.instantiate_type(root.extends_type, combined_mapper)
                if this.unported_mark() <> mark
                    return null
                if inst = null
                    return null
                set inferred_extends_type: inst as ref[Type]
            }
            ; `core.OrElse(combinedMapper, mapper)` — the mapper the TRUE branch is
            ; instantiated through, at both of the two places that instantiate it.
            var branch_mapper: ref[TypeMapper]? m
            if combined_mapper <> null
                set branch_mapper: combined_mapper
            ; ── THE RESOLVING HALF, SLICE 151 ───────────────────────────────
            ;
            ; "We attempt to resolve the conditional type only when the check and
            ; extends types are non-generic."
            var resolving false
            if check_type_deferred = false
            {
                let extends_deferred this.is_deferred_type(inferred_extends_type, check_tuples)
                if this.unported_mark() <> mark
                    return null
                if extends_deferred = false
                    set resolving: true
            }
            if resolving
            {
                ; "Return falseType for a definitely false extends check. We check
                ; an instantiations of the two types with type parameters mapped to
                ; the wildcard type, the most permissive instantiations possible
                ; (the wildcard type is assignable to and from all types). If those
                ; are not related, then no instantiations will be and we can just
                ; return the false branch type."
                var definitely_false false
                if (inferred_extends_type.flags & TypeFlagsAnyOrUnknown) = 0
                {
                    if (ct.flags & TypeFlagsAny) <> 0
                        set definitely_false: true
                    if definitely_false = false
                    {
                        let pc this.get_permissive_instantiation(ct)
                        if this.unported_mark() <> mark
                            return null
                        if pc = null
                            return null
                        let pe this.get_permissive_instantiation(inferred_extends_type)
                        if this.unported_mark() <> mark
                            return null
                        if pe = null
                            return null
                        let related this.is_type_assignable_to(pc as ref[Type], pe as ref[Type])
                        if this.unported_mark() <> mark
                            return null
                        if related = false
                            set definitely_false: true
                    }
                }
                if definitely_false
                {
                    ; "Return union of trueType and falseType for 'any' since it
                    ; matches anything. Furthermore, for a distributive conditional
                    ; type applied to the constraint of a type variable, include
                    ; trueType if there are possible values of the check type that
                    ; are also possible values of the extends type. We use a reverse
                    ; assignability check as it is less expensive than the comparable
                    ; relationship and avoids false positives of a non-empty
                    ; intersection check."
                    var include_true false
                    if (ct.flags & TypeFlagsAny) <> 0
                        set include_true: true
                    if include_true = false
                    {
                        if for_constraint
                        {
                            if (inferred_extends_type.flags & TypeFlagsNever) = 0
                            {
                                let pe this.get_permissive_instantiation(inferred_extends_type)
                                if this.unported_mark() <> mark
                                    return null
                                if pe = null
                                    return null
                                let pc this.get_permissive_instantiation(ct)
                                if this.unported_mark() <> mark
                                    return null
                                if pc = null
                                    return null
                                let overlaps this.some_type_is_assignable_to(pe as ref[Type], pc as ref[Type])
                                if this.unported_mark() <> mark
                                    return null
                                if overlaps
                                    set include_true: true
                            }
                        }
                    }
                    if include_true
                    {
                        let tn AstNode.conditional_type_true_of(root.node)
                        if tn = null
                            return null
                        let written this.get_type_from_type_node(tn as ref[AstNode])
                        if this.unported_mark() <> mark
                            return null
                        if written = null
                            return null
                        let inst this.instantiate_type(written as ref[Type], branch_mapper)
                        if this.unported_mark() <> mark
                            return null
                        if inst = null
                            return null
                        if extra_types = null
                            set extra_types: this.new_type_list(null)
                        (extra_types as ref[Array[ref[Type]?]]).add(inst)
                    }
                    ; "If falseType is an immediately nested conditional type that
                    ; isn't distributive or has an identical checkType, switch to
                    ; that type and loop."
                    let fn AstNode.conditional_type_false_of(root.node)
                    if fn = null
                        return null
                    let false_written this.get_type_from_type_node(fn as ref[AstNode])
                    if this.unported_mark() <> mark
                        return null
                    if false_written = null
                        return null
                    let ft false_written as ref[Type]
                    var looped false
                    if (ft.flags & TypeFlagsConditional) <> 0
                    {
                        let nested Checker.conditional_root_of(ft)
                        if nested <> null
                        {
                            let nr nested as ref[ConditionalRoot]
                            var nested_here false
                            if AstNode.parent_node_of(nr.node) = root.node
                            {
                                if nr.is_distributive = false
                                    set nested_here: true
                                if nr.check_type = root.check_type
                                    set nested_here: true
                            }
                            if nested_here
                            {
                                set root: nr
                                set looped: true
                            }
                        }
                        if looped = false
                        {
                            var tail_mapper: ref[TypeMapper]? null
                            let tail_root this.get_tail_recursion_root(ft, m, &tail_mapper)
                            if this.unported_mark() <> mark
                                return null
                            if tail_root <> null
                            {
                                let tr tail_root as ref[ConditionalRoot]
                                set root: tr
                                set m: tail_mapper
                                set alias: null
                                if tr.alias <> null
                                    set tail_count: tail_count + 1
                                set looped: true
                            }
                        }
                    }
                    if looped
                        continue
                    let answer this.instantiate_type(ft, m)
                    if this.unported_mark() <> mark
                        return null
                    if answer = null
                        return null
                    set result: answer
                    break
                }
                ; "Return trueType for a definitely true extends check. We check
                ; instantiations of the two types with type parameters mapped to
                ; their restrictive form, i.e. a form of the type parameter that has
                ; no constraint. This ensures that, for example, the type
                ;   type Foo<T extends { x: any }> = T extends { x: string } ? string : number
                ; doesn't immediately resolve to 'string' instead of being deferred."
                var definitely_true false
                if (inferred_extends_type.flags & TypeFlagsAnyOrUnknown) <> 0
                    set definitely_true: true
                if definitely_true = false
                {
                    let rc this.get_restrictive_instantiation(ct)
                    if this.unported_mark() <> mark
                        return null
                    if rc = null
                        return null
                    let re this.get_restrictive_instantiation(inferred_extends_type)
                    if this.unported_mark() <> mark
                        return null
                    if re = null
                        return null
                    let related this.is_type_assignable_to(rc as ref[Type], re as ref[Type])
                    if this.unported_mark() <> mark
                        return null
                    if related
                        set definitely_true: true
                }
                if definitely_true
                {
                    let tn AstNode.conditional_type_true_of(root.node)
                    if tn = null
                        return null
                    let true_written this.get_type_from_type_node(tn as ref[AstNode])
                    if this.unported_mark() <> mark
                        return null
                    if true_written = null
                        return null
                    let tt true_written as ref[Type]
                    var tail_mapper: ref[TypeMapper]? null
                    let tail_root this.get_tail_recursion_root(tt, branch_mapper, &tail_mapper)
                    if this.unported_mark() <> mark
                        return null
                    if tail_root <> null
                    {
                        let tr tail_root as ref[ConditionalRoot]
                        set root: tr
                        set m: tail_mapper
                        set alias: null
                        if tr.alias <> null
                            set tail_count: tail_count + 1
                        continue
                    }
                    let answer this.instantiate_type(tt, branch_mapper)
                    if this.unported_mark() <> mark
                        return null
                    if answer = null
                        return null
                    set result: answer
                    break
                }
            }
            ; "Return a deferred type for a check that is neither definitely true
            ; nor definitely false."
            ; ★It carries the COMBINED mapper now, which is what
            ; get_inferred_true_type_from_conditional_type reads: the true branch of
            ; a deferred `T extends Foo<infer U> ? U : never` must be instantiated
            ; with the inference, not with the caller's mapper alone.
            let made this.new_conditional_type(root, m, combined_mapper)
            if made = null
                return null
            let deferred made as ref[Type]
            if alias <> null
                Checker.set_type_alias(deferred, alias)
            else
            {
                let inst this.instantiate_type_alias(root.alias, m)
                Checker.set_type_alias(deferred, inst)
            }
            set result: deferred
            break
        }
        if extra_types <> null
        {
            let list extra_types as ref[Array[ref[Type]?]]
            list.add(result)
            return this.get_union_type(list)
        }
        result
    }

    ; getTailRecursionRoot, slice 151 — the reference returns a PAIR and this
    ; writes the mapper through a cell, which is this file's out-parameter idiom.
    ;
    ; ★★★ ITS COMMENT IS THE WHOLE CONTRACT: *"we tail-recurse for generic
    ; conditional types that (a) have not already been evaluated and cached, and
    ; (b) are non distributive, have a check type that is unaffected by
    ; instantiation, or have a non-union check type"*. The third disjunct is the
    ; one that carries the argument — a DISTRIBUTIVE conditional over a UNION check
    ; type distributes, and distributing is not a tail call, so it must go back
    ; through get_conditional_type_instantiation rather than round this loop.
    ;
    ; ★ Recursion is possible only through ALIASED conditional types, which is why
    ; the caller increments the counter only for a root that has an alias.
    procedure get_tail_recursion_root(this, new_type: ref[Type], new_mapper: ref[TypeMapper]?, out_mapper: ref[ref[TypeMapper]?]) returns ref[ConditionalRoot]?
    {
        if (new_type.flags & TypeFlagsConditional) = 0
            return null
        if new_mapper = null
            return null
        let root Checker.conditional_root_of(new_type)
        if root = null
            return null
        let nr root as ref[ConditionalRoot]
        if nr.outer_type_parameters = null
            return null
        let otp nr.outer_type_parameters as ref[Array[ref[Type]?]]
        let n otp.get_length() as int
        if n = 0
            return null
        let mark this.unported_mark()
        let type_param_mapper this.combine_type_mappers(Checker.conditional_mapper_of(new_type), new_mapper)
        if type_param_mapper = null
            return null
        let tpm type_param_mapper as ref[TypeMapper]
        let arguments this.new_type_list(null)
        var i 0
        while i < n
        {
            let mapped this.type_mapper_map(tpm, otp[i])
            if this.unported_mark() <> mark
                return null
            arguments.add(mapped)
            set i: i + 1
        }
        let new_root_mapper this.new_type_mapper(otp, arguments)
        var new_check_type: ref[Type]? null
        if nr.is_distributive
        {
            set new_check_type: this.type_mapper_map(new_root_mapper, nr.check_type)
            if this.unported_mark() <> mark
                return null
        }
        var accept false
        if new_check_type = null
            set accept: true
        if accept = false
        {
            let nct new_check_type as ref[Type]
            if nct = nr.check_type
                set accept: true
            if (nct.flags & (TypeFlagsUnion | TypeFlagsNever)) = 0
                set accept: true
        }
        if accept = false
            return null
        set out_mapper: new_root_mapper
        nr
    }

    ; someType with the *assignable to this target* predicate, slice 151 — the
    ; forConstraint arm of the resolving half is its one caller. §3.18: one function
    ; per predicate, because a predicate cannot be passed here.
    procedure some_type_is_assignable_to(this, t: ref[Type], target: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_type_assignable_to(t, target)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                if this.is_type_assignable_to(e as ref[Type], target)
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; ast.SkipTypeParentheses — a walk DOWN through ParenthesizedType wrappers,
    ; which is the opposite direction from WalkUpParenthesizedTypes.
    function skip_type_parentheses(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var n node
        while n <> null
        {
            let cur n as ref[AstNode]
            if AstNode.kind_of(cur) <> KindParenthesizedType
                return cur
            set n: AstNode.parenthesized_type_inner_of(cur)
        }
        null
    }

    ; getActualTypeVariable — through a SUBSTITUTION type to its base, and through
    ; an IndexedAccess whose object or index is itself a substitution.
    procedure get_actual_type_variable(this, t: ref[Type]) returns ref[Type]?
    {
        ; The substitution arm RECURSES: a true branch's `Tuple[Key]` is a
        ; substitution over an indexed access over a substitution, and only the
        ; innermost `Tuple[Key]` is the inference target minted by the reverse
        ; mapping (slice 204, `inferRestArgumentsMappedTuple`).
        if (t.flags & TypeFlagsSubstitution) <> 0
        {
            let base Checker.substitution_base_type_of(t)
            if base = null
                return null
            return this.get_actual_type_variable(base as ref[Type])
        }
        if (t.flags & TypeFlagsIndexedAccess) <> 0
        {
            let ot Checker.indexed_access_object_type_of(t)
            let it Checker.indexed_access_index_type_of(t)
            if ot = null
                return t
            if it = null
                return t
            var substituted false
            if ((ot as ref[Type]).flags & TypeFlagsSubstitution) <> 0
                set substituted: true
            if ((it as ref[Type]).flags & TypeFlagsSubstitution) <> 0
                set substituted: true
            if substituted
            {
                let no this.get_actual_type_variable(ot as ref[Type])
                if no = null
                    return null
                let ni this.get_actual_type_variable(it as ref[Type])
                if ni = null
                    return null
                return this.get_indexed_access_type(no as ref[Type], ni as ref[Type])
            }
        }
        t
    }

    ; newConditionalType. ★Its two INSTANTIATED slots are not the root's: the root
    ; carries the written check and extends types, the TYPE carries them mapped.
    procedure new_conditional_type(this, root: ref[ConditionalRoot], mapper: ref[TypeMapper]?, combined_mapper: ref[TypeMapper]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let ct this.instantiate_type(root.check_type, mapper)
        if this.unported_mark() <> mark
            return null
        let et this.instantiate_type(root.extends_type, mapper)
        if this.unported_mark() <> mark
            return null
        this.new_type(TypeFlagsConditional, ObjectFlagsNone, null, TypeData.Conditional(box_node_data[ConditionalTypeData](host, ConditionalTypeData(root, ct, et, null, null, null, null, null, mapper, combined_mapper))))
    }

    ; instantiateTypeAlias — `alias` mapped through the mapper, which for a null
    ; mapper or a null alias is the identity.
    procedure instantiate_type_alias(this, alias: ref[TypeAlias]?, mapper: ref[TypeMapper]?) returns ref[TypeAlias]?
    {
        if alias = null
            return null
        if mapper = null
            return alias
        let a alias as ref[TypeAlias]
        let mark this.unported_mark()
        let args this.instantiate_types(a.type_arguments, mapper)
        if this.unported_mark() <> mark
            return null
        &TypeAlias^host(a.symbol, args)
    }

    ; getTrueTypeFromConditionalType and getFalseTypeFromConditionalType — the two
    ; branch types, each instantiated through the conditional's own mapper and
    ; memoised on the payload.
    procedure get_true_type_from_conditional_type(this, t: ref[Type]) returns ref[Type]?
    {
        let existing Checker.conditional_true_type_of(t)
        if existing <> null
            return existing
        let root Checker.conditional_root_of(t)
        if root = null
            return null
        let tn AstNode.conditional_type_true_of((root as ref[ConditionalRoot]).node)
        if tn = null
            return null
        let written this.get_type_from_type_node(tn as ref[AstNode])
        if written = null
            return null
        let inst this.instantiate_type(written, Checker.conditional_mapper_of(t))
        if inst = null
            return null
        Checker.set_conditional_true_type(t, inst)
        inst
    }

    procedure get_false_type_from_conditional_type(this, t: ref[Type]) returns ref[Type]?
    {
        let existing Checker.conditional_false_type_of(t)
        if existing <> null
            return existing
        let root Checker.conditional_root_of(t)
        if root = null
            return null
        let fn AstNode.conditional_type_false_of((root as ref[ConditionalRoot]).node)
        if fn = null
            return null
        let written this.get_type_from_type_node(fn as ref[AstNode])
        if written = null
            return null
        let inst this.instantiate_type(written, Checker.conditional_mapper_of(t))
        if inst = null
            return null
        Checker.set_conditional_false_type(t, inst)
        inst
    }

    ; getTypeFromInferTypeNode, whole — three lines, and its whole content is that
    ; an `infer U` DENOTES the type parameter the binder already declared for it.
    procedure get_type_from_infer_type_node(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        let tp AstNode.infer_type_parameter_of(node)
        if tp = null
            return null
        let sym this.symbol_of_declaration(tp as ref[AstNode])
        if sym = null
            return null
        let t this.get_declared_type_of_type_parameter(sym as ref[Symbol])
        if t = null
            return null
        set links.resolved_type: t
        links.resolved_type
    }

    ; getInferTypeParameters — the `infer` type parameters a conditional node
    ; declares, read off the node's own LOCALS table, which the binder filled.
    procedure get_infer_type_parameters(this, node: ref[AstNode]) returns ref[Array[ref[Type]?]]?
    {
        let locals AstNode.locals_of(node)
        if locals = null
            return null
        let out this.new_type_list(null)
        let n SymbolTable.length(locals) as int
        var i 0
        while i < n
        {
            let sym SymbolTable.entry_symbol_at(locals, i)
            if sym <> null
            {
                let s sym as ref[Symbol]
                if (Symbol.flags_of(s) & SymbolFlagsTypeParameter) <> 0
                {
                    let t this.get_declared_type_of_symbol(s)
                    if t = null
                        return null
                    out.add(t)
                }
            }
            set i: i + 1
        }
        out
    }

    ; isSimpleTupleType and isDeferredType, both whole.
    ;
    ; ★ isSimpleTupleType asks the NODE and not the type — a tuple type node with
    ; at least one element and no optional, rest or variadic member — which is why
    ; it can be asked before the tuple's type exists.
    function is_simple_tuple_type(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if AstNode.kind_of(n) <> KindTupleType
            return false
        let elems AstNode.type_list_of(n)
        if elems = null
            return false
        let list elems as ref[Array[ref[AstNode]?]]
        let count list.get_length() as int
        if count = 0
            return false
        var i 0
        while i < count
        {
            let e list[i]
            if e <> null
            {
                let el e as ref[AstNode]
                let k AstNode.kind_of(el)
                if k = KindOptionalType
                    return false
                if k = KindRestType
                    return false
                if k = KindNamedTupleMember
                {
                    if AstNode.named_tuple_member_question_token_of(el) <> null
                        return false
                    if AstNode.named_tuple_member_dotdotdot_of(el) <> null
                        return false
                }
            }
            set i: i + 1
        }
        true
    }

    procedure is_deferred_type(this, t: ref[Type], check_tuples: bool) returns bool
    {
        if this.is_generic_type(t)
            return true
        if check_tuples = false
            return false
        if Checker.is_tuple_type(t) = false
            return false
        let elems this.get_element_types(t)
        if elems = null
            return false
        let list elems as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                if this.is_generic_type(e as ref[Type])
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; ── the permissive and the restrictive instantiation (slice 151) ────────
    ;
    ; ★★★ THEY ARE THE WHOLE REASON A CONDITIONAL TYPE CAN BE DECIDED WITHOUT
    ; LYING, and the two are not symmetric. The PERMISSIVE instantiation maps every
    ; type parameter to the WILDCARD, which is assignable to and from everything, so
    ; a check that FAILS through it says no instantiation could ever relate the two
    ; and the false branch is definite. The RESTRICTIVE one maps every type
    ; parameter to a copy of itself with NO CONSTRAINT, so a check that SUCCEEDS
    ; through it says every instantiation relates and the true branch is definite —
    ; and the reference names the shape that forces it: `type Foo<T extends { x: any
    ; }> = T extends { x: string } ? string : number` must not resolve to `string`
    ; on the constraint alone, and dropping the constraint is what prevents it.
    ;
    ; ★ The early exit is the reference's and it is what keeps the table small: a
    ; primitive, `any`, `unknown` and `never` are their own instantiation under both
    ; mappers, and those are most of what a resolving conditional is handed.
    procedure get_permissive_instantiation(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & (TypeFlagsPrimitive | TypeFlagsAnyOrUnknown | TypeFlagsNever)) <> 0
            return t
        let found this.find_instantiation_cache_link(t)
        if found <> null
        {
            let cached (found as ref[InstantiationCacheLink]).permissive
            if cached <> null
                return cached
        }
        let mark this.unported_mark()
        let result this.instantiate_type(t, permissive_mapper)
        if this.unported_mark() <> mark
            return null
        if result = null
            return null
        let link this.instantiation_cache_link_of(t)
        set link.permissive: result
        result
    }

    procedure get_restrictive_instantiation(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & (TypeFlagsPrimitive | TypeFlagsAnyOrUnknown | TypeFlagsNever)) <> 0
            return t
        let found this.find_instantiation_cache_link(t)
        if found <> null
        {
            let cached (found as ref[InstantiationCacheLink]).restrictive
            if cached <> null
                return cached
        }
        let mark this.unported_mark()
        let result this.instantiate_type(t, restrictive_mapper)
        if this.unported_mark() <> mark
            return null
        if result = null
            return null
        let r result as ref[Type]
        let link this.instantiation_cache_link_of(t)
        set link.restrictive: r
        ; "We set the following so we don't attempt to set the restrictive instance
        ; of a restrictive instance which is redundant … This also gives us a way to
        ; detect restrictive instances upon comparisons and _disable_ the
        ; 'distributive constraint' assignability check for them, which is distinctly
        ; unsafe."
        ; ★★★ THE SECOND WRITE IS THE OBSERVABLE ONE and its reader is
        ; get_constraint_of_distributive_conditional_type — see that function's own
        ; note, which stood as a comment on an absent table until this slice.
        let self this.instantiation_cache_link_of(r)
        set self.restrictive: r
        r
    }

    ; getRestrictiveTypeParameter — the type parameter with its constraint dropped.
    ;
    ; ★ The guard is the reference's and it is an IDENTITY test rather than an
    ; emptiness one: a parameter with no constraint and no constraint DECLARATION is
    ; already its own restrictive form, and one whose constraint is the
    ; noConstraintType sentinel has been through here before.
    procedure get_restrictive_type_parameter(this, t: ref[Type]) returns ref[Type]
    {
        var already false
        if Checker.type_parameter_constraint_of(t) = null
        {
            if this.get_constraint_declaration(t) = null
                set already: true
        }
        if Checker.type_parameter_constraint_of(t) = no_constraint_type
            set already: true
        if already
            return t
        let found this.find_instantiation_cache_link(t)
        if found <> null
        {
            let cached (found as ref[InstantiationCacheLink]).restrictive_type_parameter
            if cached <> null
                return cached as ref[Type]
        }
        let result this.new_type_parameter(t.symbol)
        Checker.set_type_parameter_constraint(result, no_constraint_type)
        let link this.instantiation_cache_link_of(t)
        set link.restrictive_type_parameter: result
        result
    }

    ; The number of elements of a TUPLE type node — `node.Elements()` at the two
    ; places the conditional compares arities.
    function type_node_element_count(node: ref[AstNode]?) returns int
    {
        if node = null
            return 0
        let elems AstNode.type_list_of(node as ref[AstNode])
        if elems = null
            return 0
        (elems as ref[Array[ref[AstNode]?]]).get_length() as int
    }

    ; getOptionalType. ★Its `debug.Assert(c.strictNullChecks)` holds under this
    ; harness, so the assertion is a comment rather than a branch.
    ;
    ; ★★ THE FIRST TEST IS WHAT MAKES THE INTERN TABLE LOAD-BEARING: `t.Types()[0]
    ; == missingOrUndefined` is a POINTER comparison against the first constituent,
    ; and it can only answer yes because the sort puts `undefined` (flags 1 << 2)
    ; in front of everything but `any` and `unknown`, and because a union minted
    ; twice would be a different object.
    procedure get_optional_type(this, t: ref[Type], is_property: bool) returns ref[Type]?
    {
        var missing_or_undefined undefined_type
        if is_property
            set missing_or_undefined: undefined_or_missing_type
        if t = missing_or_undefined
            return t
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let ts Checker.union_types_of(t)
            if ts <> null
            {
                let list ts as ref[Array[ref[Type]?]]
                if (list.get_length() as int) > 0
                {
                    let f list[0]
                    if f <> null
                    {
                        if (f as ref[Type]) = missing_or_undefined
                            return t
                    }
                }
            }
        }
        this.get_union_type_pair(t, missing_or_undefined)
    }

    ; ★★★ formatUnionTypes — THE PRINTER'S HALF, AND IT IS WHY THIS SLICE CAN SHOW
    ; ANYTHING AT ALL. Minting a union without it moves a unit's stop from
    ; `get-union-type` to `type-to-string` and buys nothing: the T section is
    ; emitted only for a unit whose check COMPLETES, so a type nobody can name is a
    ; type nobody can measure. This is the transformation the nodebuilder applies
    ; before it builds a UnionTypeNode — it collapses a boolean-literal pair back
    ; into `boolean`, collapses an enum's members back into the enum, and moves
    ; `null` and `undefined` to the END of the printed list wherever they occur.
    ;
    ; ★ `expandingEnum` is FALSE at the one call site this port has: it is set only
    ; in the nodebuilder's enum-expansion branch, which is behind shouldExpandType
    ; — a HOVER verbosity question this port does not ask — so the second disjunct
    ; of the collapse test reads as `t.flags&EnumLike != 0` alone. ★★Until slice
    ; 116 this note ended *"and the enum arm below reports before that can
    ; matter"*, which was an argument about a STOP and expired with it; what
    ; carries the claim now is shouldExpandType's absence and nothing else.
    procedure format_union_types(this, types: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]?
    {
        let out this.new_type_list(null)
        var flags 0
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e = null
                return null
            let t e as ref[Type]
            set flags: flags | t.flags
            ; The reference's `i += count - 1; continue` inside a `for` with its own
            ; `i++`; here the step is carried out of the arm instead, because a
            ; `continue` in this loop would skip the increment rather than perform
            ; the reference's TWO.
            var step 1
            if (t.flags & TypeFlagsNullable) = 0
            {
                ; `t.flags&BooleanLiteral != 0 || (!expandingEnum && t.flags&EnumLike != 0)`,
                ; and the two halves choose a DIFFERENT base — booleanType for the
                ; first, getBaseTypeOfEnumLikeType for the second. Slice 116 gives
                ; the enum half its base; before it, the arm reported.
                var collapse false
                var base_type: ref[Type]? null
                if (t.flags & TypeFlagsBooleanLiteral) <> 0
                {
                    set collapse: true
                    set base_type: boolean_type
                }
                else
                {
                    if (t.flags & TypeFlagsEnumLike) <> 0
                    {
                        set collapse: true
                        set base_type: this.get_base_type_of_enum_like_type(t)
                    }
                }
                if collapse
                {
                    ; ★★ THE BOOLEAN HALF OF THIS GUARD IS DEAD AND THE ENUM HALF
                    ; IS NOT, which is what slice 116 changed about it. `boolean_type`
                    ; is minted by initialize_intrinsic_types out of two boolean
                    ; LITERAL types and no arm of get_union_type_worker can stop on
                    ; that input — the reduction it takes is
                    ; removeRedundantLiteralTypes, which removes neither of them,
                    ; and every gate below it needs a flag a boolean literal does
                    ; not carry. Control h04 (booleanType forced null) is what
                    ; showed the shape of that claim — **diagcheck RED 18 by
                    ; INVENTION**. `get_base_type_of_enum_like_type` CAN answer
                    ; null (its tail is get_declared_type_of_symbol through
                    ; get_parent_of_symbol), so from this slice the guard has a
                    ; live input and stays a `return null` rather than a stop for a
                    ; different reason: the enclosing function is a PRINTER helper,
                    ; and its caller already reports when it answers nothing.
                    if base_type = null
                        return null
                    let base base_type as ref[Type]
                    if (base.flags & TypeFlagsUnion) <> 0
                    {
                        let bl Checker.union_types_of(base)
                        if bl <> null
                        {
                            let blist bl as ref[Array[ref[Type]?]]
                            let count blist.get_length() as int
                            if (i + count) <= n
                            {
                                let last_here types[i + count - 1]
                                let last_there blist[count - 1]
                                ; `match` is a reserved word here (see CLAUDE.md's
                                ; list beside init/label/loop/shared).
                                var matched false
                                if last_here <> null
                                {
                                    if last_there <> null
                                    {
                                        let ra this.get_regular_type_of_literal_type(last_here as ref[Type])
                                        let rb this.get_regular_type_of_literal_type(last_there as ref[Type])
                                        if ra <> null
                                        {
                                            if ra = rb
                                                set matched: true
                                        }
                                    }
                                }
                                if matched
                                {
                                    out.add(base)
                                    set step: count
                                }
                            }
                        }
                    }
                }
                if step = 1
                    out.add(t)
            }
            set i: i + step
        }
        if (flags & TypeFlagsNull) <> 0
            out.add(null_type)
        if (flags & TypeFlagsUndefined) <> 0
            out.add(undefined_type)
        out
    }

    ; getRegularTypeOfLiteralType, WHOLE since slice 112 — the note that stood here
    ; called its union arm *a chapter away*, and the chapter is mapType, which that
    ; slice needs anyway.
    ;
    ; ★★ THE `u.regularType` MEMO IS NOT CARRIED AND THAT IS OBSERVABLY FREE, which
    ; is a different argument from the widened-type memo one screen up. Unions are
    ; INTERNED here (get_union_type_from_sorted_list consults find_union_type), so
    ; recomputing this answers the SAME object rather than an equal one — where
    ; get_widened_type_of_object_literal mints a fresh anonymous type on every call
    ; and its memo is therefore load-bearing.
    procedure get_regular_type_of_literal_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsFreshable) <> 0
            return Checker.literal_regular_type_of(t)
        if (t.flags & TypeFlagsUnion) = 0
            return t
        let types Checker.union_types_of(t)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let c list[i]
            if c = null
                return null
            let m this.get_regular_type_of_literal_type(c as ref[Type])
            if m = null
                return null
            if m <> c
                set changed: true
            mapped.add(m)
            set i: i + 1
        }
        if changed = false
            return t
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }

    ; NewChecker's intrinsic block. The order is the reference's, because the type
    ; ids are assigned along it.
    ;
    ; ★★ WHAT IS MISSING FROM THE RUN, and each omission is one mechanism rather
    ; than one type: the BOOLEAN family (regularFalseType, falseType,
    ; regularTrueType, trueType) needs newLiteralType, i.e. a value payload on
    ; Type — §3.5be's rule says a field with no reader is DECLARED rather than
    ; ported, and nothing in this slice can produce a literal type, so the payload
    ; arrives with the arm that does. booleanType, stringOrNumberType,
    ; stringNumberSymbolType, numberOrBigIntType and templateConstraintType need
    ; getUnionType; numericStringType needs getTemplateLiteralType; and ELEVEN of
    ; the fifteen empty/marker OBJECT types still have no reader — slice 80 minted
    ; emptyTypeLiteralType and slice 81 the three constraint markers, and the note
    ; that used to say "fifteen" here is what those two slices moved. Every one of
    ; the eleven is reachable only from an arm that reports, so their absence cannot
    ; be observed — which is exactly why it is listed here instead.
    procedure initialize_intrinsic_types(this)
    {
        set any_type: this.new_intrinsic_type(TypeFlagsAny, "any")
        set auto_type: this.new_intrinsic_type_ex(TypeFlagsAny, "any", ObjectFlagsNonInferrableType)
        set wildcard_type: this.new_intrinsic_type(TypeFlagsAny, "any")
        set blocked_string_type: this.new_intrinsic_type(TypeFlagsAny, "any")
        ; ★ errorType's intrinsic NAME is "error" and its printed form is "any":
        ; the printer branches on TypeFlagsAny and never reads the name except to
        ; recognise intrinsicMarkerType. That is why a `T … any` line in the dump
        ; is most often this type rather than anyType — see get_type_of_node's
        ; fallthrough.
        set error_type: this.new_intrinsic_type(TypeFlagsAny, "error")
        set unresolved_type: this.new_intrinsic_type(TypeFlagsAny, "unresolved")
        set non_inferrable_any_type: this.new_intrinsic_type_ex(TypeFlagsAny, "any", ObjectFlagsContainsWideningType)
        set intrinsic_marker_type: this.new_intrinsic_type(TypeFlagsAny, "intrinsic")
        set unknown_type: this.new_intrinsic_type(TypeFlagsUnknown, "unknown")
        set undefined_type: this.new_intrinsic_type(TypeFlagsUndefined, "undefined")
        set undefined_widening_type: this.create_widening_type(undefined_type)
        set missing_type: this.new_intrinsic_type(TypeFlagsUndefined, "undefined")
        ; core.IfElse(c.exactOptionalPropertyTypes, c.missingType, c.undefinedType)
        set undefined_or_missing_type: undefined_type
        if Checker.exact_optional_property_types()
            set undefined_or_missing_type: missing_type
        set optional_type: this.new_intrinsic_type(TypeFlagsUndefined, "undefined")
        set null_type: this.new_intrinsic_type(TypeFlagsNull, "null")
        set null_widening_type: this.create_widening_type(null_type)
        set string_type: this.new_intrinsic_type(TypeFlagsString, "string")
        set number_type: this.new_intrinsic_type(TypeFlagsNumber, "number")
        set bigint_type: this.new_intrinsic_type(TypeFlagsBigInt, "bigint")

        ; ★★★ THE BOOLEAN PAIR IS BUILT HERE AND IN THE REFERENCE'S OWN ORDER,
        ; which is REGULAR then FRESH and then two writes that close the cycle —
        ; `regularFalseType.freshType = falseType` and
        ; `falseType.freshType = falseType`. It is the one literal type
        ; getFreshTypeOfLiteralType never mints, so the eight lines below are the
        ; only place in this port where that function's postcondition is
        ; established by hand.
        ;
        ; ★★★ SLICE 94 MOVES THE BLOCK AND ADDS THE SEVENTH LINE. Slice 71 wrote
        ; the six after uniqueLiteralType, at the END of this procedure, because
        ; `c.booleanType = c.getUnionType(...)` could not follow them and a block
        ; whose last line is missing has no natural place. Both halves are here
        ; now, in NewChecker's own position — which is what keeps the type IDS in
        ; the reference's order through the whole intrinsic run, the one property
        ; this procedure's header says the order is for.
        set regular_false_type: this.new_literal_type(TypeFlagsBooleanLiteral, Slice[char](), 0 as u64, false, false, null)
        set false_type: this.new_literal_type(TypeFlagsBooleanLiteral, Slice[char](), 0 as u64, false, false, regular_false_type)
        Checker.set_literal_fresh_type(regular_false_type, false_type)
        Checker.set_literal_fresh_type(false_type, false_type)
        set regular_true_type: this.new_literal_type(TypeFlagsBooleanLiteral, Slice[char](), 0 as u64, false, true, null)
        set true_type: this.new_literal_type(TypeFlagsBooleanLiteral, Slice[char](), 0 as u64, false, true, regular_true_type)
        Checker.set_literal_fresh_type(regular_true_type, true_type)
        Checker.set_literal_fresh_type(true_type, true_type)
        ; c.booleanType. The FIRST union this port mints, and the first type here
        ; whose creation runs code rather than a constructor.
        set boolean_type: this.get_union_type_pair(regular_false_type, regular_true_type)

        set es_symbol_type: this.new_intrinsic_type(TypeFlagsESSymbol, "symbol")
        set void_type: this.new_intrinsic_type(TypeFlagsVoid, "void")
        set never_type: this.new_intrinsic_type(TypeFlagsNever, "never")
        set silent_never_type: this.new_intrinsic_type_ex(TypeFlagsNever, "never", ObjectFlagsNonInferrableType)
        set implicit_never_type: this.new_intrinsic_type(TypeFlagsNever, "never")
        set unreachable_never_type: this.new_intrinsic_type(TypeFlagsNever, "never")
        set non_primitive_type: this.new_intrinsic_type(TypeFlagsNonPrimitive, "object")
        ; ★★ THREE OF THE FOUR INTRINSIC UNIONS STAND HERE UPSTREAM AND ARE STILL
        ; NOT MINTED — stringOrNumberType, stringNumberSymbolType and
        ; templateConstraintType — under the rule §3.5be states: each is read by a
        ; checkTypeAssignableTo call site, and a field with no reader is a claim
        ; about the future rather than a port. ★numericStringType between them needs
        ; getTemplateLiteralType and is a second reason the same line is not written.
        ;
        ; ★★★ THE FOURTH IS MINTED SINCE SLICE 102 AND IT IS THE SAME RULE, NOT AN
        ; EXCEPTION TO IT: `checkArithmeticOperandType` reads numberOrBigIntType and
        ; nothing else decides TS2362 and TS2363, so the field arrives in the commit
        ; that gives it a reader. It stands in the REFERENCE'S OWN POSITION so that
        ; the ids below it keep their relative order.
        ; ★★★ THE THREE STAND IN THE REFERENCE'S OWN ORDER SINCE SLICE 289, and
        ; the note above claimed that of `number_or_bigint_type` while it stood
        ; FIRST: initializeChecker mints stringOrNumberType (29), then
        ; stringNumberSymbolType (30), then numberOrBigIntType (31), and slice 102
        ; wrote its line where the three unminted ones were described rather than
        ; where its own belonged. Nothing could see it until `--generateTrace`
        ; printed the types in creation order.
        set string_or_number_type: this.get_union_type_pair(string_type, number_type)
        let sns &Array[ref[Type]?]()
        sns.add(string_type)
        sns.add(number_type)
        sns.add(es_symbol_type)
        set string_number_symbol_type: this.get_union_type(sns)
        set number_or_bigint_type: this.get_union_type_pair(number_type, bigint_type)
        ; ★★★ c.numericStringType, SLICE 136, AND THE NOTE ABOVE NAMED ITS OWN
        ; EXPIRY TWICE: this line was *"a second reason the same line is not
        ; written"* because it *"needs getTemplateLiteralType"*, and
        ; is_applicable_index_type's own note said *"no template-literal type is
        ; minted anywhere in this port … the day one is, this line and that one move
        ; together"*. get_template_literal_type has been here since slice 126. Both
        ; readers land with it, so the field arrives under the same rule the three
        ; unminted intrinsic unions are still held by, not as an exception to it.
        let nst_texts this.new_string_list()
        nst_texts.add(this.empty_string())
        nst_texts.add(this.empty_string())
        let nst_types this.new_type_list_of(1)
        nst_types.add(number_type)
        set numeric_string_type: this.get_template_literal_type(nst_texts, nst_types)
        ; ★★★ c.templateConstraintType, SLICE 289, AND THE NOTE THAT HELD IT BACK
        ; NAMED THE RULE RATHER THAN THE FIELD: *"each is read by a
        ; checkTypeAssignableTo call site, and a field with no reader is a claim
        ; about the future rather than a port"*. It HAS had its reader since the
        ; template-literal chapter; what kept the line unwritten after that was the
        ; memo below it, which mints the same union on first use. The ORDER is the
        ; thing the memo cannot give: `--generateTrace` writes every type in
        ; CREATION order with its id, so a type minted lazily is a type at the
        ; wrong id, and the whole types file after it is off by one.
        this.get_template_constraint_type()
        ; Special `never` flagged by union reduction to behave as a literal.
        set unique_literal_type: this.new_intrinsic_type(TypeFlagsNever, "never")

        ; c.restrictiveMapper / c.permissiveMapper, slice 151, at the reference's
        ; own position — after uniqueLiteralType and before emptyObjectType. ★They
        ; take no type id, so nothing below moves either way; the position is the
        ; reference's because there is no reason for it to be anything else.
        set restrictive_mapper: this.new_function_type_mapper(FunctionMapperRestrictive)
        set permissive_mapper: this.new_function_type_mapper(FunctionMapperPermissive)
        set unique_literal_mapper: this.new_function_type_mapper(FunctionMapperUniqueLiteral)

        ; ★★ c.emptyTypeLiteralType, slice 80, and it stands where the reference
        ; puts it — between the marker types it is the only one of, so the ids of
        ; everything above it keep the reference's order.
        ;
        ; ★★★ THE REFERENCE'S CALL IS newAnonymousType(sym, nil, nil, nil, nil),
        ; WHOSE SECOND HALF IS setStructuredTypeMembers — i.e. the type arrives
        ; with EMPTY member tables and ObjectFlagsMembersResolved set. This port
        ; has no member tables to set, so the flag is not set either, and the
        ; difference is confined to resolveStructuredTypeMembers, which reports:
        ; setting a resolved bit over tables that do not exist would claim the
        ; members dimension is here.
        ; ★ c.emptyObjectType, slice 115, and it stands ABOVE emptyTypeLiteralType
        ; because the reference mints it there — see that field's note on ids.
        set empty_object_type: this.new_anonymous_type(null, null, null, null, null)
        ; ★★★ c.emptyJsxObjectType AND c.emptyFreshJsxObjectType, SLICE 119, MINTED
        ; WHERE THE REFERENCE MINTS THEM — AND THROUGH `new_anonymous_type` WHERE
        ; THE LINE ABOVE USES `new_object_type`. The difference is the resolved bit,
        ; and empty_object_type's own header says exactly where it shows: *"the
        ; difference is confined to resolveStructuredTypeMembers, which reports"*.
        ; This slice is the reader that reaches it — `getSpreadType` asks
        ; `getPropertiesOfType` of the empty JSX object on the FIRST fold of every
        ; attributes list — so the seed is minted resolved-and-empty, which is the
        ; reference's own `newAnonymousType(nil, nil, nil, nil, nil)`. **The header's
        ; claim was true and it had an expiry date; it does not extend to a seed
        ; something reads.**
        set empty_jsx_object_type: this.new_anonymous_type(null, null, null, null, null)
        set empty_fresh_jsx_object_type: this.new_anonymous_type(null, null, null, null, null)
        var etl_data Slice[char]()
        set etl_data: Binder.internal_name(host, "type")
        let etl_symbol Symbol.create(host, SymbolFlagsTypeLiteral, etl_data)
        set empty_type_literal_type: this.new_anonymous_type(etl_symbol, null, null, null, null)
        ; c.unknownEmptyObjectType and c.unknownUnionType (slice 289), the two the
        ; reference mints here and this port minted on first use. `createUnknownUnionType`
        ; IS the second call: it mints the empty object and then the union over it,
        ; which is the reference's own pair of ids in the reference's own order.
        ; ★Under a non-strict compilation the union is `unknown` and no type is
        ; minted — upstream's own branch, and the trace of such a compilation has
        ; one fewer row here on both sides.
        this.get_unknown_union_type()
        ; c.emptyGenericType, which the reference mints between emptyTypeLiteralType
        ; and the markers below. Its instantiation map is deliberately not carried
        ; (the field's note).
        set empty_generic_type: this.new_anonymous_type(null, null, null, null, null)

        ; c.anyFunctionType, slice 141, at the reference's own position — between
        ; emptyGenericType and the three markers below. ★The flag is set after the
        ; mint, exactly as upstream does it, and new_object_type's mask does not
        ; touch NonInferrableType.
        set any_function_type: this.new_anonymous_type(null, null, null, null, null)
        if any_function_type <> null
        {
            let ft any_function_type as ref[Type]
            set ft.object_flags: ft.object_flags | ObjectFlagsNonInferrableType
        }

        ; ★★ c.noConstraintType / c.circularConstraintType / c.resolvingDefaultType,
        ; slice 81, and they stand where the reference puts them — after
        ; anyFunctionType, which slice 141 mints, so the three ids they take are the
        ; reference's own. Nothing compares an id (see Type's note), and the ORDER
        ; among the types this port does mint is what the reference's order buys.
        ;
        ; ★ Same argument as emptyTypeLiteralType's: newAnonymousType is
        ; newObjectType PLUS setStructuredTypeMembers, and this port has no member
        ; tables to set, so ObjectFlagsMembersResolved is not set either. For a
        ; SENTINEL the difference cannot be observed at all — nothing ever asks one
        ; of these three for its members.
        set no_constraint_type: this.new_anonymous_type(null, null, null, null, null) as ref[Type]
        set circular_constraint_type: this.new_anonymous_type(null, null, null, null, null) as ref[Type]
        set resolving_default_type: this.new_anonymous_type(null, null, null, null, null) as ref[Type]

        ; ★★★ THE FIVE MARKER TYPE PARAMETERS, SLICE 289. They were minted on first
        ; use since slices 81/173, and the accessors' own note argued the laziness
        ; was free because *"nothing compares an id"*. That was measured against the
        ; five yardsticks, and it expired with `--generateTrace`, which prints every
        ; type in CREATION order: the markers are ids 46–50 upstream and were the
        ; last five in this port. The accessors STAY — they carry the constraint
        ; wiring (`marker_sub_type`'s constraint is `marker_super_type`, and the
        ; for-check pair the same one level over) and every reader still goes
        ; through them; these five lines only decide WHEN the memo is filled.
        this.get_marker_super_type()
        this.get_marker_sub_type()
        this.get_marker_other_type()
        this.get_marker_super_type_for_check()
        this.get_marker_sub_type_for_check()

        ; c.enumNumberIndexInfo / c.anyBaseTypeIndexInfo, slice 87. The reference's
        ; two struct literals; new_index_info is the same four slots and takes no
        ; type id, so nothing above moves.
        set enum_number_index_info: this.new_index_info(number_type, string_type, true, null)
        set any_base_type_index_info: this.new_index_info(string_type, any_type, false, null)
    }

    ; ── internal/checker/tracer.go: types_<n>.json ──────────────────────────
    ;
    ; The reference adapts every `Type` to a `tracing.TracedType` interface of 27
    ; accessors, because `internal/tracing` may not import `internal/checker`.
    ; That is §3.26's single-implementation rule at its plainest — there is
    ; exactly one implementor — so the adapter collapses and the descriptor is
    ; built here, off `t.data` directly.
    ;
    ; ★★★ THE FILE IS A LIST IN CREATION ORDER AND THE ID IS THE LINE NUMBER
    ; (upstream's own comment: *"no newline so type ID matches line number"*).
    ; That is what makes `trace_types` a list rather than a walk of the memo
    ; tables, and it is why slice 289 had to make the eight lazily-minted
    ; well-known types eager: a type at the wrong id is every later line wrong.

    procedure record_traced_type(this, t: ref[Type])
    {
        if trace_types = null
            return
        let list trace_types as ref[Array[ref[Type]?]]
        list.add(t)
    }

    ; FormatTypeFlags — typeFlagNames in the reference's own order, `None` when the
    ; word is empty
    procedure append_type_flags(this, arr: ref[JsonValue], flags: int)
    {
        let h host
        var n 0
        if (flags & TypeFlagsAny) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Any"))
            set n: n + 1
        }
        if (flags & TypeFlagsUnknown) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Unknown"))
            set n: n + 1
        }
        if (flags & TypeFlagsUndefined) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Undefined"))
            set n: n + 1
        }
        if (flags & TypeFlagsNull) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Null"))
            set n: n + 1
        }
        if (flags & TypeFlagsVoid) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Void"))
            set n: n + 1
        }
        if (flags & TypeFlagsString) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "String"))
            set n: n + 1
        }
        if (flags & TypeFlagsNumber) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Number"))
            set n: n + 1
        }
        if (flags & TypeFlagsBigInt) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "BigInt"))
            set n: n + 1
        }
        if (flags & TypeFlagsBoolean) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Boolean"))
            set n: n + 1
        }
        if (flags & TypeFlagsESSymbol) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "ESSymbol"))
            set n: n + 1
        }
        if (flags & TypeFlagsStringLiteral) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "StringLiteral"))
            set n: n + 1
        }
        if (flags & TypeFlagsNumberLiteral) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "NumberLiteral"))
            set n: n + 1
        }
        if (flags & TypeFlagsBigIntLiteral) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "BigIntLiteral"))
            set n: n + 1
        }
        if (flags & TypeFlagsBooleanLiteral) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "BooleanLiteral"))
            set n: n + 1
        }
        if (flags & TypeFlagsUniqueESSymbol) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "UniqueESSymbol"))
            set n: n + 1
        }
        if (flags & TypeFlagsEnumLiteral) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "EnumLiteral"))
            set n: n + 1
        }
        if (flags & TypeFlagsEnum) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Enum"))
            set n: n + 1
        }
        if (flags & TypeFlagsNonPrimitive) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "NonPrimitive"))
            set n: n + 1
        }
        if (flags & TypeFlagsNever) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Never"))
            set n: n + 1
        }
        if (flags & TypeFlagsTypeParameter) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "TypeParameter"))
            set n: n + 1
        }
        if (flags & TypeFlagsObject) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Object"))
            set n: n + 1
        }
        if (flags & TypeFlagsIndex) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Index"))
            set n: n + 1
        }
        if (flags & TypeFlagsTemplateLiteral) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "TemplateLiteral"))
            set n: n + 1
        }
        if (flags & TypeFlagsStringMapping) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "StringMapping"))
            set n: n + 1
        }
        if (flags & TypeFlagsSubstitution) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Substitution"))
            set n: n + 1
        }
        if (flags & TypeFlagsIndexedAccess) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "IndexedAccess"))
            set n: n + 1
        }
        if (flags & TypeFlagsConditional) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Conditional"))
            set n: n + 1
        }
        if (flags & TypeFlagsUnion) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Union"))
            set n: n + 1
        }
        if (flags & TypeFlagsIntersection) <> 0
        {
            JsonText.push(arr, JsonText.new_string(h, "Intersection"))
            set n: n + 1
        }
        if n = 0
            JsonText.push(arr, JsonText.new_string(h, "None"))
    }

    ; EscapeAllInternalSymbolNames: the `\xFE` sentinel spells `__`
    function escaped_symbol_name(this, s: ref[Symbol]) returns Slice[char]
    {
        let name Symbol.name_of(s)
        var has false
        var i 0
        while i < (name.length as int)
        {
            if ((*(name.data + (i as size_t)) as int) & 255) = 254
                set has: true
            set i: i + 1
        }
        if has = false
            return name
        var sb StringBuilder()
        var k 0
        while k < (name.length as int)
        {
            let c (*(name.data + (k as size_t)) as int) & 255
            if c = 254
                sb.append("__")
            else
                sb.append(*(name.data + (k as size_t)))
            set k: k + 1
        }
        let out String^host(sb.to_string())
        Slice[char](out.get_length(), out.get_buffer() as pointer[char])
    }

    ; the three ReverseMapped slots the trace prints; they have no accessor of
    ; their own because nothing else reads them one at a time
    function reverse_mapped_slot_of(t: ref[Type], which: int) returns ref[Type]?
    {
        choose t.data
            when rm: ReverseMapped
            {
                if which = 0
                    return rm.source
                if which = 1
                    return rm.mapped_type
                return rm.constraint_type
            }
        null
    }

    ; the recursion identity's TOKEN — a unique integer per identity, in first-seen
    ; order, exactly as the reference's `recursionIdentityMap` hands them out
    procedure recursion_token(this, t: ref[Type], syms: ref[Array[ref[Symbol]?]], tys: ref[Array[ref[Type]?]], nodes: ref[Array[ref[AstNode]?]]) returns int
    {
        let rid this.get_recursion_identity(t)
        let sym rid.target_symbol
        let ty rid.target_type
        let nd rid.target_node
        var i 0
        while i < (syms.get_length() as int)
        {
            let a syms[i as size_t]
            let b tys[i as size_t]
            let c nodes[i as size_t]
            if (a = sym) and (b = ty) and (c = nd)
                return i
            set i: i + 1
        }
        let n syms.get_length() as int
        syms.add(sym)
        tys.add(ty)
        nodes.add(nd)
        n
    }

    ; getLocation: the file's path lower-cased (tspath.ToPath(name, "", false)) and
    ; the 1-indexed ECMA line / UTF-16 character of the node's token start and end
    procedure location_of(this, n: ref[AstNode]) returns ref[JsonValue]?
    {
        let file Checker.source_file_of_node(n)
        if file = null
            return null
        ; ★The path comes from the program's table for a program file and from the
        ; lib chain for a lib, because this port keeps the two apart (see
        ; select_lib_file) and EVERY row of the smaller trace baseline's types file
        ; but two names a lib declaration.
        var path Slice[char]()
        if program <> null
        {
            let pf program as ref[ProgramFiles]
            let idx pf.index_of_file(file)
            if idx >= 0
                set path: pf.paths[idx as size_t]
        }
        if (path.length as int) = 0
            set path: this.lib_path_of_file(file)
        if (path.length as int) = 0
            return null
        let h host
        let bn this.binder_of_node(n)
        ; `scanner.GetTokenPosOfNode(node, file, false)` — the node's OWN token
        ; start and not the error range a diagnostic would use: the reference's
        ; firstDeclaration for `interface Boolean {}` is the `interface` keyword,
        ; where the error range is the name.
        let start bn.skip_trivia_at(AstNode.pos_of(n))
        let obj JsonText.new_object(h)
        JsonText.put_member(obj, "path", JsonText.new_string(h, Checker.lower_path(h, path)))
        JsonText.put_member(obj, "start", this.line_and_char(bn, start))
        JsonText.put_member(obj, "end", this.line_and_char(bn, AstNode.end_of(n)))
        obj
    }

    ; the lib chain's path for one of its files, empty for anything else
    function lib_path_of_file(this, file: ref[AstNode]?) returns Slice[char]
    {
        if file = null
            return Slice[char]()
        if lib_file = file
            return this.lib_chain_path(0)
        if extra_lib_files = null
            return Slice[char]()
        let ef extra_lib_files as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ef.get_length() as int)
        {
            if ef[i as size_t] = file
                return this.lib_chain_path(i + 1)
            set i: i + 1
        }
        Slice[char]()
    }

    function lower_path(host: ref[Page], p: Slice[char]) returns Slice[char]
    {
        var any false
        var i 0
        while i < (p.length as int)
        {
            let c (*(p.data + (i as size_t)) as int) & 255
            if (c >= 65) and (c <= 90)
                set any: true
            set i: i + 1
        }
        if any = false
            return p
        var sb StringBuilder()
        var k 0
        while k < (p.length as int)
        {
            var c (*(p.data + (k as size_t)) as int) & 255
            if (c >= 65) and (c <= 90)
                set c: c + 32
            sb.append(c as char)
            set k: k + 1
        }
        let s String^host(sb.to_string())
        Slice[char](s.get_length(), s.get_buffer() as pointer[char])
    }

    ; GetECMALineAndUTF16CharacterOfPosition, 1-indexed on both members. The line
    ; breaks are stringutil.IsLineBreak's four (see ecma_lines_differ) and the
    ; character counts UTF-16 CODE UNITS, so an astral character is two.
    procedure line_and_char(this, bn: ref[Binder], pos: int) returns ref[JsonValue]
    {
        let h host
        let text bn.source_slice(0, pos)
        var line 1
        var line_start 0
        let n text.length as int
        var i 0
        while i < pos
        {
            if i >= n
                break
            let c (*(text.data + (i as size_t)) as int) & 255
            if c = 13
            {
                var q i + 1
                if q < n
                {
                    if ((*(text.data + (q as size_t)) as int) & 255) = 10
                        set q: q + 1
                }
                set line: line + 1
                set line_start: q
                set i: q
                continue
            }
            if c = 10
            {
                set line: line + 1
                set line_start: i + 1
                set i: i + 1
                continue
            }
            if c = 226
            {
                if (i + 2) < n
                {
                    if ((*(text.data + ((i + 1) as size_t)) as int) & 255) = 128
                    {
                        let third (*(text.data + ((i + 2) as size_t)) as int) & 255
                        if (third = 168) or (third = 169)
                        {
                            set line: line + 1
                            set line_start: i + 3
                            set i: i + 3
                            continue
                        }
                    }
                }
            }
            set i: i + 1
        }
        ; the UTF-16 units between the line start and the position
        var ch 0
        var j line_start
        while j < pos
        {
            if j >= n
                break
            let c (*(text.data + (j as size_t)) as int) & 255
            if c < 128
            {
                set ch: ch + 1
                set j: j + 1
                continue
            }
            if c < 224
            {
                set ch: ch + 1
                set j: j + 2
                continue
            }
            if c < 240
            {
                set ch: ch + 1
                set j: j + 3
                continue
            }
            ; an astral code point is a surrogate PAIR in UTF-16
            set ch: ch + 2
            set j: j + 4
        }
        let obj JsonText.new_object(h)
        JsonText.put_member(obj, "line", JsonText.new_number(h, line))
        JsonText.put_member(obj, "character", JsonText.new_number(h, ch + 1))
        obj
    }

    procedure put_type_id(this, obj: ref[JsonValue], key: Slice[char], t: ref[Type]?)
    {
        if t = null
            return
        JsonText.put_member(obj, key, JsonText.new_number(host, (t as ref[Type]).id))
    }

    procedure put_type_ids(this, obj: ref[JsonValue], key: Slice[char], list: ref[Array[ref[Type]?]]?)
    {
        if list = null
            return
        let l list as ref[Array[ref[Type]?]]
        if (l.get_length() as int) = 0
            return
        let h host
        let arr JsonText.new_array(h)
        var i 0
        while i < (l.get_length() as int)
        {
            let e l[i as size_t]
            var id 0
            if e <> null
                set id: (e as ref[Type]).id
            JsonText.push(arr, JsonText.new_number(h, id))
            set i: i + 1
        }
        JsonText.put_member(obj, key, arr)
    }

    ; Display: the reference computes it for anonymous objects and for the literal,
    ; template-literal, union and intersection flags, and swallows a panic with an
    ; empty string. Here the printer ANSWERS whether it could serialize, so the
    ; recovery is that answer rather than a recover().
    procedure trace_display(this, t: ref[Type]) returns Slice[char]
    {
        var wanted false
        if (t.object_flags & ObjectFlagsAnonymous) <> 0
            set wanted: true
        if (t.flags & (TypeFlagsLiteral | TypeFlagsTemplateLiteral | TypeFlagsUnion | TypeFlagsIntersection)) <> 0
            set wanted: true
        if wanted = false
            return Slice[char]()
        var sb StringBuilder()
        if this.type_to_string_serialized(t, &sb) = false
            return Slice[char]()
        let s String^host(sb.to_string())
        Slice[char](s.get_length(), s.get_buffer() as pointer[char])
    }

    ; buildTypeDescriptor, in the reference's own field order
    procedure type_descriptor(this, t: ref[Type], syms: ref[Array[ref[Symbol]?]], tys: ref[Array[ref[Type]?]], nodes: ref[Array[ref[AstNode]?]]) returns ref[JsonValue]
    {
        let h host
        let obj JsonText.new_object(h)
        JsonText.put_member(obj, "id", JsonText.new_number(h, t.id))
        if (t.flags & TypeFlagsIntrinsic) <> 0
        {
            let iname Checker.intrinsic_name_of(t)
            if (iname.length as int) > 0
                JsonText.put_member(obj, "intrinsicName", JsonText.new_string(h, iname))
        }
        ; `aliasSymbol ?? symbol`
        var named: ref[Symbol]? t.alias_symbol
        if named = null
            set named: t.symbol
        if named <> null
            JsonText.put_member(obj, "symbolName", JsonText.new_string(h, this.escaped_symbol_name(named as ref[Symbol])))
        JsonText.put_member(obj, "recursionId", JsonText.new_number(h, this.recursion_token(t, syms, tys, nodes)))
        if (t.object_flags & ObjectFlagsTuple) <> 0
            JsonText.put_member(obj, "isTuple", JsonText.new_bool(h, true))
        if (t.flags & TypeFlagsUnion) <> 0
            this.put_type_ids(obj, "unionTypes", Checker.union_types_of(t))
        if (t.flags & TypeFlagsIntersection) <> 0
            this.put_type_ids(obj, "intersectionTypes", Checker.intersection_types_of(t))
        if t.alias_symbol <> null
            this.put_type_ids(obj, "aliasTypeArguments", t.alias_type_arguments)
        if (t.flags & TypeFlagsIndex) <> 0
            this.put_type_id(obj, "keyofType", Checker.index_target_of(t))
        if (t.flags & TypeFlagsIndexedAccess) <> 0
        {
            this.put_type_id(obj, "indexedAccessObjectType", Checker.indexed_access_object_type_of(t))
            this.put_type_id(obj, "indexedAccessIndexType", Checker.indexed_access_index_type_of(t))
        }
        if (t.flags & TypeFlagsConditional) <> 0
        {
            this.put_type_id(obj, "conditionalCheckType", Checker.conditional_check_type_of(t))
            this.put_type_id(obj, "conditionalExtendsType", Checker.conditional_extends_type_of(t))
            let tt Checker.conditional_true_type_of(t)
            if tt = null
                JsonText.put_member(obj, "conditionalTrueType", JsonText.new_number(h, 0 - 1))
            else
                JsonText.put_member(obj, "conditionalTrueType", JsonText.new_number(h, (tt as ref[Type]).id))
            let ft Checker.conditional_false_type_of(t)
            if ft = null
                JsonText.put_member(obj, "conditionalFalseType", JsonText.new_number(h, 0 - 1))
            else
                JsonText.put_member(obj, "conditionalFalseType", JsonText.new_number(h, (ft as ref[Type]).id))
        }
        if (t.flags & TypeFlagsSubstitution) <> 0
        {
            this.put_type_id(obj, "substitutionBaseType", Checker.substitution_base_type_of(t))
            this.put_type_id(obj, "constraintType", Checker.substitution_constraint_of(t))
        }
        if (t.flags & TypeFlagsObject) <> 0
        {
            if (t.object_flags & ObjectFlagsReference) <> 0
            {
                this.put_type_id(obj, "instantiatedType", Checker.target_of(t))
                this.put_type_ids(obj, "typeArguments", Checker.resolved_type_arguments_of(t))
                let rn Checker.reference_node_of(t)
                if rn <> null
                {
                    let loc this.location_of(rn as ref[AstNode])
                    if loc <> null
                        JsonText.put_member(obj, "referenceLocation", loc as ref[JsonValue])
                }
            }
            if (t.object_flags & ObjectFlagsReverseMapped) <> 0
            {
                this.put_type_id(obj, "reverseMappedSourceType", Checker.reverse_mapped_slot_of(t, 0))
                this.put_type_id(obj, "reverseMappedMappedType", Checker.reverse_mapped_slot_of(t, 1))
                this.put_type_id(obj, "reverseMappedConstraintType", Checker.reverse_mapped_slot_of(t, 2))
            }
            if (t.object_flags & ObjectFlagsEvolvingArray) <> 0
            {
                this.put_type_id(obj, "evolvingArrayElementType", Checker.evolving_array_element_type_of(t))
                this.put_type_id(obj, "evolvingArrayFinalType", Checker.evolving_array_final_type_of(t))
            }
        }
        let pat this.pattern_for_type(t)
        if pat <> null
        {
            let loc this.location_of(pat as ref[AstNode])
            if loc <> null
                JsonText.put_member(obj, "destructuringPattern", loc as ref[JsonValue])
        }
        if named <> null
        {
            let s named as ref[Symbol]
            if Symbol.declaration_count(s) > 0
            {
                let d Symbol.declaration_at(s, 0)
                if d <> null
                {
                    let loc this.location_of(d as ref[AstNode])
                    if loc <> null
                        JsonText.put_member(obj, "firstDeclaration", loc as ref[JsonValue])
                }
            }
        }
        let flags JsonText.new_array(h)
        this.append_type_flags(flags, t.flags)
        JsonText.put_member(obj, "flags", flags)
        let disp this.trace_display(t)
        if (disp.length as int) > 0
            JsonText.put_member(obj, "display", JsonText.new_string(h, disp))
        obj
    }

    ; DumpTypes: the whole list, one descriptor per line, the opening bracket
    ; carrying no newline so a type's id IS its line number
    procedure dump_types_text(this) returns Slice[char]
    {
        let h host
        if trace_types = null
            return Slice[char]()
        let list trace_types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        if n = 0
            return Slice[char]()
        let syms &Array[ref[Symbol]?]^h()
        let tys &Array[ref[Type]?]^h()
        let nodes &Array[ref[AstNode]?]^h()
        var sb StringBuilder()
        sb.append("[")
        var i 0
        while i < n
        {
            let e list[i as size_t]
            if e <> null
            {
                let d this.type_descriptor(e as ref[Type], syms, tys, nodes)
                let text JsonText.to_text(h, d, false)
                sb.append(text.data, text.length)
            }
            if i < (n - 1)
                sb.append(",\n")
            set i: i + 1
        }
        sb.append("]\n")
        let s String^h(sb.to_string())
        Slice[char](s.get_length(), s.get_buffer() as pointer[char])
    }

    ; ── the type printer ────────────────────────────────────────────────────
    ;
    ; TypeToString → typeToString → typeToStringEx → nodeBuilder.TypeToTypeNode →
    ; the emit printer. THIS PORTS THE KEYWORD ARMS OF THAT WORKER AND NOTHING
    ; ELSE, and the boundary is not arbitrary: those arms answer a bare keyword
    ; that the printer prints unchanged, so they are the shapes for which the
    ; nodebuilder and the printer are both identity. Every other arm builds a NODE
    ; and needs a printer, which is a dimension of its own (3 585 + 486 lines).
    ;
    ; ★ THE ORDER OF THE TESTS IS THE REFERENCE'S, and it is load-bearing rather
    ; than stylistic: the flags are not disjoint. A fresh boolean literal carries
    ; TypeFlagsBooleanLiteral, and an enum literal carries StringLiteral or
    ; NumberLiteral as well as EnumLiteral, so testing Void before the literal
    ; flags would answer a keyword for a literal type. Every arm this slice does
    ; not port therefore stands IN PLACE, reporting, rather than being left out.
    ;
    ; ★ Of the two things typeToStringEx does before the worker, ONE is a no-op
    ; here and says so at its line: the truncation (NoErrorTruncation is
    ; set by the harness, which is the whole reason the oracle passes it — a
    ; truncated name would make the T section depend on a display budget).
    ;
    ; ★★★ IT IS A BUILDER SINCE SLICE 71, AND THE ARM THAT WIDENED IT IS THE ONE
    ; THIS FUNCTION'S OWN HEADER NAMED: *"the arm that first needs composition is
    ; the one that widens this to a builder"*. Four of the arms below now compose
    ; a name out of a VALUE — a quoted and escaped string, a number's
    ; ECMAScript-to-String, a bigint's digits plus `n`, and the two boolean
    ; keywords — so a `pointer[const_char]` can no longer be the answer.
    ;
    ; ★★ THE CALLER OWNS THE BUFFER AND MUST HAND IN A SCRATCH ONE. The answer is
    ; written into `out` and the function reports `false` when it cannot name the
    ; type — by which point it may already have written part of a name, so `out`
    ; must not be the caller's real sink. TypeDump obeys this at its one call site
    ; and says so. ★A `String` return would have been the smaller change and the
    ; worse one: the name is appended to a builder either way, so a String would be
    ; an allocation and a copy per node of the walk.
    ; checkTruncationLength, asked at the four sites the reference asks it (slice
    ; 170).
    ;
    ; ★★★ IT REFUTES A NOTE THAT STOOD IN create_anonymous_type_node SINCE SLICE
    ; 95: *the truncation cutoff is 1 000 000 characters under NoTruncation, so
    ; checkTruncationLength is false for every name this corpus can produce.* It
    ; was true of the corpus REACHABLE THEN, and it stopped being true the moment
    ; slice 170 opened the object spread in front of it — `nestedSpreadsAndWidening`
    ; folds ten spreads into one another and the reference prints 1.47 MB where
    ; this port printed 6.15 MB, the difference being exactly the three elision
    ; arms. **A budget priced as unreachable is a claim about the corpus a stop
    ; lets through, not about the budget.**
    ;
    ; ★★★ THE MEASURE IS A DIVERGENCE AND IT IS BOUNDED IN ONE DIRECTION. Upstream
    ; compares `ctx.approximateLength` — a per-arm ESTIMATE (+2 per separator, +15
    ; for a conditional, a symbol's name length) — against the budget, and this
    ; port has no such counter: it compares the CHARACTERS ALREADY WRITTEN into the
    ; name's own scratch builder, which is what that counter approximates. The two
    ; cannot be made equal without carrying every one of the reference's increments,
    ; so this asks the honest question and STOPS rather than eliding: a name whose
    ; budget is spent is one this port does not claim, and the arms below therefore
    ; report where the reference truncates.
    procedure add_approximate_length(this, n: int)
        set this.printer_approximate_length: printer_approximate_length + n

    ; checkTruncationLength: the sticky verdict of the estimate against the
    ; noTruncation maximum
    procedure check_truncation_length(this) returns bool
    {
        if printer_truncating
            return true
        if printer_approximate_length > 1000000
            set this.printer_truncating: true
        printer_truncating
    }

    ; createElidedInformationPlaceholder: +3 and `any` (noTruncation)
    procedure write_elided_placeholder(this, out: ref[StringBuilder]) returns bool
    {
        this.add_approximate_length(3)
        Checker.write_elided_information_placeholder(out)
    }

    ; ★ mapToTypeNodes builds its `any` placeholders INLINE and adds nothing for
    ; them; only createElidedInformationPlaceholder (a conditional past the
    ; budget, a symbol past depth 10) adds 3 — the two list writers below call
    ; the static placeholder, the others the adding wrapper.
    ; mapToTypeNodes for a NON-bare list (type arguments): +2 per element; past
    ; the budget the whole list is one placeholder, and a list crossing it mid-way
    ; keeps its head, a placeholder for the rest, and the last element
    procedure write_type_argument_list(this, args: ref[Array[ref[Type]?]], out: ref[StringBuilder]) returns bool
        this.write_type_argument_range(args, 0, args.get_length() as int, out)

    procedure write_type_argument_range(this, args: ref[Array[ref[Type]?]], from: int, to: int, out: ref[StringBuilder]) returns bool
    {
        let n to - from
        if n <= 0
            return true
        out.append("<" as char)
        if this.check_truncation_length()
        {
            if Checker.write_elided_information_placeholder(out) = false
                return false
            out.append(">" as char)
            return true
        }
        var i 0
        while i < n
        {
            if i > 0
                out.append(", ")
            if this.check_truncation_length()
            {
                if (i + 1) + 2 < n - 1
                {
                    if Checker.write_elided_information_placeholder(out) = false
                        return false
                    out.append(", ")
                    if this.type_to_string(args[to - 1], out) = false
                        return false
                    out.append(">" as char)
                    return true
                }
            }
            this.add_approximate_length(2)
            if this.type_to_string(args[from + i], out) = false
                return false
            set i: i + 1
        }
        out.append(">" as char)
        true
    }

    ; typeToTypeNode's own two lines, and the reduction is the reason this is a
    ; wrapper (slice 170).
    ;
    ; ★★★ THE NOTE IN THE WORKER READ *both of those report below, so the call is
    ; the identity for every type this slice can hold* — TRUE when the union and
    ; intersection arms were stops, and false since slice 121 wrote them. The
    ; object spread produced the first intersection that actually reduces:
    ; `{ a: number; id: boolean } & { c: number; d: string } & { id: string }` is
    ; `never` to the reference and printed whole here, because `get_reduced_type`
    ; existed and nothing called it from the printer. **A note saying a call is the
    ; identity is a claim about the arms AROUND it, and it expires when one of them
    ; stops reporting.**
    ;
    ; ★ It wraps rather than opening the worker's body because the worker recurses
    ; through this name at ~40 sites and every one of them is a `typeToTypeNode`
    ; entry upstream, which is exactly where the reduction belongs.
    ; typeToStringEx's OUTER shell (slice 213). *"Serialization of types can lead to (lazy)
    ; resolution of members, which can cause diagnostics that again require serialization
    ; of types"* — so the reference counts the TypeToString invocations in progress,
    ; answers "?" from the second nested one on (maxSerializationLevel = 2) and DISCARDS
    ; every diagnostic created at that depth (addDiagnostic). The port's printer recurses
    ; through type_to_string for its own arms, so the level is counted HERE, at the
    ; entries that stand for a TypeToString call of the reference: the message argument
    ; (name_type_for_message) and the chain's printed names (types_print_alike,
    ; emit_error_chain). ★The two notes that said this guard could not fire because
    ; nothing recurses into the printer were wrong: printing a prototype literal's
    ; `mobile: () => any` infers the method's return type from its BODY, whose
    ; `this._cache` reports TS2339 — fourteen of them in `fixSignatureCaching`, every one
    ; created at level 2 and dropped by the reference.
    procedure type_to_string_serialized(this, t: ref[Type]?, out: ref[StringBuilder]) returns bool
    {
        if serialization_level >= 2
        {
            out.append("?" as char)
            return true
        }
        if serialization_level = 0
        {
            set printer_emitted: 0
            set this.printer_approximate_length: 0
            set this.printer_truncating: false
            set serialization_level: 1
            let start0 out.get_length() as int
            let ok0 this.type_to_string(t, out)
            set serialization_level: 0
            set printer_emitted: 0
            set this.printer_approximate_length: 0
            set this.printer_truncating: false
            ; typeToStringEx's hard cutoff: a text of 2 000 000 characters or
            ; more is cut to that length less "..." — not written; reported
            if (out.get_length() as int) - start0 >= 2000000
            {
                this.record_unported("type-to-string-hard-cutoff", 0)
                return false
            }
            return ok0
        }
        ; ★★★ enterContext — a NESTED TypeToString prints in a FRESH node-builder context
        ; (nodebuilder.go pushes a new NodeBuilderContext per call): its own symbol stack,
        ; visited types, reverse-mapped stack, mapper and depth. This port keeps that state
        ; on the checker, so the outer print's is saved here and restored below; without
        ; the swap the inner print of the SAME type met the outer's frames, took the
        ; recursion placeholder and resolved nothing — and the members it should have
        ; resolved were resolved by the OUTER print instead, one level lower, where their
        ; diagnostics are kept (`fixSignatureCaching`).
        let saved_symbols printer_symbols
        let saved_symbol_count printer_symbol_count
        let saved_visited visited_types
        let saved_visited_depth visited_type_depth
        let saved_reverse printer_reverse_mapped_stack
        let saved_mapper printer_type_mapper
        let saved_fully_qualified printer_fully_qualified
        let saved_name_data wrote_type_reference_name.data
        let saved_name_length wrote_type_reference_name.length
        let saved_depth printer_depth
        let saved_dropped printer_chain_dropped_container
        let saved_yield printer_yield_module_symbol
        let saved_precedence wrote_type_precedence
        let saved_infer printer_infer_type_parameters
        let saved_chain_length wrote_chain_length
        let saved_name_depth wrote_name_depth
        let saved_emitted printer_emitted
        set printer_emitted: 0
        let saved_approx printer_approximate_length
        let saved_truncating printer_truncating
        set this.printer_approximate_length: 0
        set this.printer_truncating: false
        let page Page.get(this)
        let pss &Array[ref[PrinterSymbolFrame]?]^page()
        set printer_symbols: pss
        set printer_symbol_count: 0
        let vts &Array[int]^page()
        set visited_types: vts
        set visited_type_depth: 0
        let prms &Array[ref[Symbol]?]^page()
        set printer_reverse_mapped_stack: prms as ref[Array[ref[Symbol]?]]
        set printer_type_mapper: null
        set printer_fully_qualified: false
        set wrote_type_reference_name.data: null
        set wrote_type_reference_name.length: 0
        set printer_depth: 0
        set printer_chain_dropped_container: false
        set printer_yield_module_symbol: false
        set wrote_type_precedence: TypePrecedenceNonArray
        set printer_infer_type_parameters: null
        set wrote_chain_length: 0
        set wrote_name_depth: 0 - 1
        set serialization_level: serialization_level + 1
        let ok this.type_to_string(t, out)
        set serialization_level: serialization_level - 1
        set printer_symbols: saved_symbols
        set printer_symbol_count: saved_symbol_count
        set visited_types: saved_visited
        set visited_type_depth: saved_visited_depth
        set printer_reverse_mapped_stack: saved_reverse
        set printer_type_mapper: saved_mapper
        set printer_fully_qualified: saved_fully_qualified
        set wrote_type_reference_name.data: saved_name_data
        set wrote_type_reference_name.length: saved_name_length
        set printer_depth: saved_depth
        set printer_chain_dropped_container: saved_dropped
        set printer_yield_module_symbol: saved_yield
        set wrote_type_precedence: saved_precedence
        set printer_infer_type_parameters: saved_infer
        set wrote_chain_length: saved_chain_length
        set wrote_name_depth: saved_name_depth
        set printer_emitted: saved_emitted
        set this.printer_approximate_length: saved_approx
        set this.printer_truncating: saved_truncating
        ok
    }

    ; addDiagnostic — *"Discard diagnostics created while at the maximum number of
    ; recursive TypeToString invocations."* Every append of the checker's own list goes
    ; through here.
    procedure add_diagnostic_direct(this, start: int, stop: int, code: int)
        this.add_diagnostic_direct_with(start, stop, code, null)

    procedure add_diagnostic_direct_with(this, start: int, stop: int, code: int, args: ref[Array[String]]?)
    {
        if serialization_level >= 2
            return
        diagnostics.add_direct_tagged_args(start, stop, code, this.program_index_of_node(file), args)
    }

    procedure add_diagnostic_direct(this, start: int, stop: int, code: int, a0: String)
    {
        let args this.message_args()
        args.add(a0)
        this.add_diagnostic_direct_with(start, stop, code, args)
    }

    procedure add_diagnostic_direct(this, start: int, stop: int, code: int, a0: String, a1: String)
    {
        let args this.message_args()
        args.add(a0)
        args.add(a1)
        this.add_diagnostic_direct_with(start, stop, code, args)
    }

    procedure add_diagnostic_direct(this, start: int, stop: int, code: int, a0: String, a1: String, a2: String)
    {
        let args this.message_args()
        args.add(a0)
        args.add(a1)
        args.add(a2)
        this.add_diagnostic_direct_with(start, stop, code, args)
    }

    procedure add_diagnostic_direct(this, start: int, stop: int, code: int, a0: String, a1: String, a2: String, a3: String)
    {
        let args this.message_args()
        args.add(a0)
        args.add(a1)
        args.add(a2)
        args.add(a3)
        this.add_diagnostic_direct_with(start, stop, code, args)
    }

    ; a diagnostic at a node, in the node's own file (slice 269: the reference's
    ; diagnostics collection is keyed by file, and a node of another file carries
    ; that file's text)
    procedure add_diagnostic_at_node(this, start: int, stop: int, code: int, n: ref[AstNode])
        this.add_diagnostic_at_node_with(start, stop, code, n, null)

    procedure add_diagnostic_at_node_with(this, start: int, stop: int, code: int, n: ref[AstNode], args: ref[Array[String]]?)
    {
        if serialization_level >= 2
            return
        diagnostics.add_direct_tagged_args(start, stop, code, this.program_index_of_node(n), args)
    }


    ; ── the reporters with MESSAGE ARGUMENTS (phase (b)1): one overload per arity,
    ; each forwarding to its `_with` core; the arguments are the reference's own
    ; `args ...any` after diagnostics.StringifyArgs
    procedure message_args(this) returns ref[Array[String]]
    {
        let h host
        &Array[String]^h()
    }

    ; a message argument from a text view
    function arg_text(s: Slice[char]) returns String
        String(s.data as pointer[const_char], s.length as size_t)

    function arg_int(i: int) returns String
    {
        var sb StringBuilder()
        sb.append(i)
        sb.to_string()
    }

    ; scanner.DeclarationNameToString
    procedure declaration_name_to_string(this, name: ref[AstNode]?) returns String
    {
        if name = null
            return String("(Missing)")
        if AstNode.pos_of(name) = AstNode.end_of(name)
            return String("(Missing)")
        Checker.arg_text(this.source_text_of_node(name as ref[AstNode]))
    }

    ; TypeToString as a message argument
    procedure type_arg(this, t: ref[Type]?) returns String
    {
        var sb StringBuilder()
        this.type_to_string_serialized(t, &sb)
        sb.to_string()
    }

    ; typeToStringEx(t, enclosing, flags) for the two flag sets a message asks:
    ; typeToString's (enclosing given) and UseFullyQualifiedType
    procedure type_arg_ex(this, t: ref[Type]?, enclosing: ref[AstNode]?, fully_qualified: bool) returns String
    {
        let saved_enclosing printer_enclosing_declaration
        let saved_fq printer_fully_qualified
        let saved_yield printer_yield_module_symbol
        set this.printer_enclosing_declaration: enclosing
        set printer_fully_qualified: fully_qualified
        set printer_yield_module_symbol: fully_qualified
        var sb StringBuilder()
        this.type_to_string_serialized(t, &sb)
        set this.printer_enclosing_declaration: saved_enclosing
        set printer_fully_qualified: saved_fq
        set printer_yield_module_symbol: saved_yield
        sb.to_string()
    }

    ; typeToStringEx(t, nil, TypeFormatFlagsWriteArrayAsGenericType)
    procedure type_arg_array_as_generic(this, t: ref[Type]?) returns String
    {
        let saved printer_write_array_as_generic
        set printer_write_array_as_generic: true
        var sb StringBuilder()
        this.type_to_string_serialized(t, &sb)
        set printer_write_array_as_generic: saved
        sb.to_string()
    }

    ; getIsolatedModulesLikeFlagName
    function isolated_modules_like_flag_name(this) returns String
    {
        if verbatim_module_syntax
            return String("verbatimModuleSyntax")
        String("isolatedModules")
    }

    ; scanner.GetTextOfNode as a message argument (the empty text for no node)
    procedure node_text_arg(this, n: ref[AstNode]?) returns String
    {
        if n = null
            return String("")
        Checker.arg_text(this.source_text_of_node(n as ref[AstNode]))
    }

    ; ModuleKind.String()
    function module_kind_name(kind: int) returns String
    {
        if kind = 0
            return String("None")
        if kind = 1
            return String("CommonJS")
        if kind = 2
            return String("AMD")
        if kind = 3
            return String("UMD")
        if kind = 4
            return String("System")
        if kind = 5
            return String("ES2015")
        if kind = 6
            return String("ES2020")
        if kind = 7
            return String("ES2022")
        if kind = 99
            return String("ESNext")
        if kind = 100
            return String("Node16")
        if kind = 101
            return String("Node18")
        if kind = 102
            return String("Node20")
        if kind = 199
            return String("NodeNext")
        if kind = 200
            return String("Preserve")
        var sb StringBuilder()
        sb.append("ModuleKind(")
        sb.append(kind)
        sb.append(")" as char)
        sb.to_string()
    }

    ; getTypeNameForErrorDisplay
    procedure type_name_for_error_display(this, t: ref[Type]) returns String
        this.type_arg_ex(t, null, true)

    ; symbolValueDeclarationIsContextSensitive's typeToString half of getTypeNamesForErrorDisplay
    procedure type_display_arg(this, t: ref[Type]) returns String
    {
        if t.symbol <> null
        {
            let vd Symbol.value_declaration_of(t.symbol as ref[Symbol])
            if vd <> null
            {
                if AstNode.is_expression_node(vd)
                {
                    if this.is_context_sensitive(vd) = false
                        return this.type_arg_ex(t, vd, false)
                }
            }
        }
        this.type_arg(t)
    }

    ; typeCouldHaveTopLevelSingletonTypes
    procedure type_could_have_top_level_singleton_types(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsBoolean) <> 0
            return false
        if (t.flags & TypeFlagsUnionOrIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            var i 0
            while i < (list.get_length() as int)
            {
                let e list[i as size_t]
                if e <> null
                {
                    if this.type_could_have_top_level_singleton_types(e as ref[Type])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        if (t.flags & TypeFlagsInstantiable) <> 0
        {
            let constraint this.get_constraint_of_type(t)
            if constraint <> null
            {
                if (constraint as ref[Type]) <> t
                    return this.type_could_have_top_level_singleton_types(constraint as ref[Type])
            }
        }
        if Checker.is_unit_type(t)
            return true
        (t.flags & (TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) <> 0
    }

    ; getUnmatchedProperties(source, target, requireOptionalProperties, false)
    procedure collect_unmatched_properties(this, source: ref[Type], target: ref[Type], require_optional_properties: bool, out: ref[Array[ref[Symbol]?]])
    {
        let props this.get_properties_of_type(target)
        if props = null
            return
        let list props as ref[Array[ref[Symbol]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            let row list[i as size_t]
            if row <> null
            {
                let tp row as ref[Symbol]
                if this.is_static_private_identifier_property(tp) = false
                {
                    var ask require_optional_properties
                    if ask = false
                    {
                        if (Symbol.flags_of(tp) & SymbolFlagsOptional) = 0
                        {
                            if (Symbol.check_flags_of(tp) & CheckFlagsPartial) = 0
                                set ask: true
                        }
                    }
                    if ask
                    {
                        let sp this.get_property_of_type(source, Symbol.name_of(tp))
                        if sp = null
                            out.add(tp)
                    }
                }
            }
            set i: i + 1
        }
    }

    ; symbolToString — symbolToStringEx(symbol, nil, SymbolFlagsAll, AllowAnyNodeKind).
    ; With no enclosing declaration the chain is the symbol alone, so the node is the
    ; identifier getNameOfSymbolAsWritten names (in the initial entity name).
    procedure symbol_arg(this, symbol: ref[Symbol]?) returns String
    {
        if symbol = null
            return String("")
        let s symbol as ref[Symbol]
        if Checker.symbol_name_is_default(s)
        {
            if Symbol.declaration_count(s) = 0
                return String("default")
        }
        var sb StringBuilder()
        this.write_symbol_name(s, &sb)
        sb.to_string()
    }

    procedure set_message_specifiers(this, sh: ref[SpecifierHost])
        set message_specifiers: sh

    ; getFullyQualifiedName(symbol, containingLocation): the root written by the
    ; node builder over the location, whose module symbol prints as the
    ; getSpecifierForModuleSymbol specifier from the location's file
    procedure fully_qualified_name_at(this, symbol: ref[Symbol], location: ref[AstNode]) returns String
    {
        let parent Symbol.parent_of(symbol)
        if parent <> null
        {
            var sb StringBuilder()
            sb.append(this.fully_qualified_name_at(parent as ref[Symbol], location))
            sb.append("." as char)
            sb.append(this.symbol_arg(symbol))
            return sb.to_string()
        }
        let name Symbol.name_of(symbol)
        if name.starts_with("\"") or name.starts_with("'")
        {
            {
                if this.symbol_has_non_global_augmentation_external_module_declaration(symbol)
                {
                    let specifier this.specifier_for_module_symbol_at(symbol, location)
                    if specifier <> null
                    {
                        var qb StringBuilder()
                        qb.append("\"" as char)
                        let sp specifier as ref[String]
                        qb.append(sp)
                        qb.append("\"" as char)
                        return qb.to_string()
                    }
                }
            }
        }
        this.fully_qualified_name_arg(symbol)
    }

    ; getSpecifierForModuleSymbol with an enclosing declaration: null when no
    ; program host is at hand or no specifier comes back
    procedure specifier_for_module_symbol_at(this, symbol: ref[Symbol], location: ref[AstNode]) returns ref[String]?
    {
        let sh_opt message_specifiers
        if sh_opt = null
            return null
        let sh sh_opt as ref[SpecifierHost]
        let context_file Checker.source_file_of_node(location)
        if context_file = null
            return null
        let cf context_file as ref[AstNode]
        var original_module_specifier: ref[AstNode]? null
        if NodeBuilder.can_have_module_specifier(AstNode.kind_of(location))
            set original_module_specifier: NodeBuilder.try_get_module_specifier_from_declaration(location)
        var resolution_mode ModuleKindNone
        if original_module_specifier <> null
            set resolution_mode: sh.get_mode_for_usage_location(cf, original_module_specifier as ref[AstNode])
        else
            set resolution_mode: sh.get_default_resolution_mode_for_file(cf)
        ; modulespecifiers' constants are module-level defines of a LATER module,
        ; which a call argument must not read: ProjectRelative 2, ending None 0 / Js 4
        var ending_preference 0
        if resolution_mode = ModuleKindESNext
            set ending_preference: 4
        let all_specifiers sh.get_module_specifiers(symbol, cf, 2, ending_preference, ModuleKindNone)
        if (all_specifiers.get_length() as int) = 0
            return null
        let first all_specifiers[0]
        let h Page.get(this)
        let copy String^h(first.data as pointer[const_char], first.length)
        &copy
    }

    ; getFullyQualifiedName(symbol, nil)
    procedure fully_qualified_name_arg(this, symbol: ref[Symbol]) returns String
    {
        var sb StringBuilder()
        this.write_fully_qualified_name(symbol, &sb)
        sb.to_string()
    }

    procedure write_fully_qualified_name(this, symbol: ref[Symbol], out: ref[StringBuilder])
    {
        let parent Symbol.parent_of(symbol)
        if parent <> null
        {
            this.write_fully_qualified_name(parent as ref[Symbol], out)
            out.append("." as char)
        }
        out.append(this.symbol_arg(symbol))
    }

    ; `%v` of a literal type's value: the string, or the number as JavaScript prints it
    function literal_value_arg(this, t: ref[Type]) returns String
    {
        if (t.flags & TypeFlagsNumberLiteral) <> 0
        {
            var nb char[JSNUM_MAX_TEXT]
            let nn jsnum_to_string(Checker.literal_bits_of(t), Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
            return String(&nb[0] as pointer[const_char], nn as size_t)
        }
        Checker.arg_text(Checker.literal_text_of(t))
    }

    ; entityNameToString as a message argument
    ; EntityNameToString over a node that may be synthesized (no source text): the
    ; identifiers' own text
    function synthesized_entity_name_arg(this, n: ref[AstNode]) returns String
    {
        var sb StringBuilder()
        Checker.write_synthesized_entity_name(n, &sb)
        sb.to_string()
    }

    procedure write_synthesized_entity_name(n: ref[AstNode], out: ref[StringBuilder])
    {
        let k AstNode.kind_of(n)
        if k = KindThisKeyword
        {
            out.append("this")
            return
        }
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
        {
            let t AstNode.identifier_text_of(n)
            out.append(t.data, t.length)
            return
        }
        if k = KindQualifiedName
        {
            let l AstNode.qualified_left_of(n)
            let r AstNode.qualified_right_of(n)
            if (l = null) or (r = null)
                return
            Checker.write_synthesized_entity_name(l as ref[AstNode], out)
            out.append("." as char)
            Checker.write_synthesized_entity_name(r as ref[AstNode], out)
            return
        }
        if k = KindPropertyAccessExpression
        {
            let e AstNode.expression_of(n)
            let nm AstNode.property_access_name_of(n)
            if (e = null) or (nm = null)
                return
            Checker.write_synthesized_entity_name(e as ref[AstNode], out)
            out.append("." as char)
            Checker.write_synthesized_entity_name(nm as ref[AstNode], out)
        }
    }

    procedure entity_name_arg(this, n: ref[AstNode]) returns String
    {
        var sb StringBuilder()
        this.write_entity_name(n, &sb)
        sb.to_string()
    }

