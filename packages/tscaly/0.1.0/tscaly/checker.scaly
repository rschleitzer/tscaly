    ; ── getDeclaredTypeOfSymbol ─────────────────────────────────────────────
    ;
    ; ★★★ SLICE 66's HEAD, and the histogram that chose it is in CLAUDE.md §3.5dl:
    ; over all 17 973 units the tag `get-declared-type-of-symbol` carried, the
    ; symbol's flags select ONE of the six arms below — Class 3 007, Interface
    ; 1 432, and NOTHING else, at either stage. So the switch is written whole and
    ; five of its six arms report; only getDeclaredTypeOfClassOrInterface is code.
    ;
    ; ★★★ THE ZERO ON TypeParameter WAS EXPLAINED BY AN ORDER, THE ORDER EXPIRED IN
    ; SLICE 81, AND THE ZERO DID NOT MOVE — so the explanation was never the reason.
    ; As slice 66 wrote it: `check_type_parameters` runs before
    ; `check_exports_on_merged_declarations`, and check_type_parameter reported
    ; unconditionally, so a GENERIC class or interface was claimed by that earlier
    ; row and could never reach this head; *the day that row lands, generics arrive
    ; here*. The row landed. Measured with a probe on this arm over stage 1: **ZERO
    ; arrivals**, while the class/interface arm above answers as before — because
    ; every caller that wants a type parameter's declared type calls
    ; get_declared_type_of_type_parameter DIRECTLY (check_type_parameter, the
    ; deferred arm, append_type_parameters), and none of them goes through this
    ; head. **The zero is a property of the CALLERS, not of an ordering**, which is
    ; only visible once the ordering is gone.
    procedure get_declared_type_of_symbol(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let result this.try_get_declared_type_of_symbol(symbol)
        if result = null
            return error_type
        result
    }

    procedure try_get_declared_type_of_symbol(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let f Symbol.flags_of(symbol)
        if (f & (SymbolFlagsClass | SymbolFlagsInterface)) <> 0
            return this.get_declared_type_of_class_or_interface(symbol)
        if (f & SymbolFlagsTypeParameter) <> 0
            return this.get_declared_type_of_type_parameter(symbol)
        if (f & SymbolFlagsTypeAlias) <> 0
            return this.get_declared_type_of_type_alias(symbol)
        if (f & SymbolFlagsEnum) <> 0
            return this.get_declared_type_of_enum(symbol)
        if (f & SymbolFlagsEnumMember) <> 0
            return this.get_declared_type_of_enum_member(symbol)
        if (f & SymbolFlagsAlias) <> 0
            return this.get_declared_type_of_alias(symbol)
        ; The reference falls out of the switch answering nil, which
        ; getDeclaredTypeOfSymbol turns into errorType. That is an ANSWER rather
        ; than a hole, so it does not report.
        null
    }

    ; getDeclaredTypeOfTypeParameter — four lines in the reference and four here.
    ;
    ; ★★★ IT IS THE HEAD OF A 1 317-UNIT WORK-LIST ROW AND IT IS FOUR LINES, which
    ; is slice 65's finding about getSymbolOfDeclaration arriving a second time: a
    ; row's DEPTH counts the callers waiting behind it, never the code in it.
    ;
    ; ★★★ AND THE ROW IS CLOSED BY SLICE 106, WHOSE SITE IS NOT THE ONE THIS HEADER
    ; NAMED. The sentence that stood here said the units were waiting on
    ; check_type_parameter's three READERS of the type; slice 81 answered two of
    ; them and re-tagged the third `check-type-assignable-to`, so from that day the
    ; row carrying this function's NAME belonged entirely to the DEFERRED check —
    ; 1 697 units at stage 2 — and nothing here said so. ★A tag names the first
    ; thing not implemented, so a tag can migrate to a different site while keeping
    ; its word, and a header that explains a count is explaining somebody else's.
    procedure get_declared_type_of_type_parameter(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.declared_type_link_of(symbol)
        if links.declared_type = null
            set links.declared_type: this.new_type_parameter(symbol)
        links.declared_type
    }

    ; getDeclaredTypeOfAlias — three lines, and the memo is `declaredTypeLinks`
    ; rather than the alias table, because what it caches is a TYPE keyed on the
    ; ALIAS symbol and not on its target.
    ;
    ; ★ It has no resolution frame of its own: the recursion it could take part in
    ; is guarded one level down, in whichever arm getDeclaredTypeOfSymbol picks for
    ; the resolved symbol.
    procedure get_declared_type_of_alias(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.declared_type_link_of(symbol)
        if links.declared_type <> null
            return links.declared_type
        let target this.resolve_alias(symbol)
        if target = null
            return null
        let t this.get_declared_type_of_symbol(target as ref[Symbol])
        if t = null
            return null
        set links.declared_type: t
        t
    }

    ; ── getDeclaredTypeOfTypeAlias ──────────────────────────────────────────
    ;
    ; ★★★ SLICE 105's CHAPTER, and the row it stands under is the second-largest
    ; at stage 2 that is not the lib: `get-type-from-type-alias-reference` at
    ; 13 340 events / 966 units, 414 / 48 at stage 1.
    ;
    ; ★★★ THE PUSH IS NOT AN OPTIMISATION AND ITS PRODUCT IS A DIAGNOSTIC.
    ; `type A = A` has no answer, and the reference does not detect that by
    ; refusing to re-enter — it marks every frame from the cycle's start as failed
    ; (see push_type_resolution's header), so this body learns on the way OUT that
    ; the type it computed is not to be memoised, and reports TS2456 instead. The
    ; DeclaredType arm of type_resolution_has_property is what the search asks on
    ; the way in, and it is minted with this slice for that reason alone.
    ;
    ; ★★ THE MEMO IS WRITTEN UNDER A GUARD THE REFERENCE ALSO WRITES
    ; (`if links.declaredType == nil`), and the guard is not redundant with the
    ; one at the top: the recursive call this body can make through
    ; get_type_from_type_node reaches the same symbol and fills the row, so the
    ; outer frame must not overwrite a row that is already answered.
    procedure get_declared_type_of_type_alias(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.type_alias_link_of(symbol)
        if links.declared_type <> null
            return links.declared_type
        if this.push_type_resolution(symbol, null, null, null, TypeSystemPropertyNameDeclaredType) = false
            return error_type
        ; `core.Find(symbol.Declarations, ast.IsTypeOrJSTypeAliasDeclaration)`.
        var declaration: ref[AstNode]? null
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if declaration = null
                {
                    let k AstNode.kind_of(d as ref[AstNode])
                    if k = KindTypeAliasDeclaration
                        set declaration: d
                    if k = KindJSTypeAliasDeclaration
                        set declaration: d
                }
            }
            set i: i + 1
        }
        ; The reference dereferences the result of that Find unconditionally, i.e.
        ; it asserts a TypeAlias symbol has a type-alias declaration. An assertion
        ; is a claim about the input, so it is a stop here rather than a trap —
        ; type_resolution_has_property's tail gives the reasoning.
        if declaration = null
        {
            this.pop_type_resolution_defensively()
            this.record_unported("declared-type-of-type-alias-no-declaration", 0)
            return null
        }
        let decl declaration as ref[AstNode]
        let type_node AstNode.type_of(decl)
        if type_node = null
        {
            this.pop_type_resolution_defensively()
            this.record_unported("declared-type-of-type-alias-no-type", AstNode.kind_of(decl))
            return null
        }
        let rhs_mark this.unported_mark()
        var t this.get_type_from_type_node(type_node as ref[AstNode])
        ; ★★★ THE POP RUNS ON EVERY ROUTE OUT OF THE BODY ABOVE, INCLUDING A STOP,
        ; and that is the one thing this function may not get wrong. The stack is
        ; shared by nine questions and a frame left on it makes the NEXT
        ; resolution find a cycle that is not there — a wrong answer with no
        ; witness anywhere. So the stop is taken AFTER the pop, not instead of it.
        let resolved this.pop_type_resolution()
        if t = null
        {
            ; get_type_from_type_node could not finish; its own stop is already in
            ; the log and the memo stays empty, so the second visit asks again.
            return null
        }
        if resolved
        {
            let type_parameters this.append_local_type_parameters_of_class_or_interface_or_type_alias(null, symbol)
            if type_parameters <> null
            {
                let tps type_parameters as ref[Array[ref[Type]?]]
                if tps.get_length() <> 0
                {
                    ; `links.instantiations` is seeded here upstream and is not
                    ; carried — see TypeAliasLink's header. What IS carried is the
                    ; list itself, because getTypeFromTypeAliasReference forks on
                    ; it.
                    set links.type_parameters: type_parameters
                }
            }
            ; `t == c.intrinsicMarkerType && symbol.Name == "BuiltinIteratorReturn"`.
            ; Both halves are written: `intrinsic` is a type node this port already
            ; answers (get_type_from_type_node's keyword table), so the arm is
            ; reachable from a fixture even though the name it tests for lives in
            ; lib.es5.d.ts.
            if (t as ref[Type]) = intrinsic_marker_type
            {
                let nd Symbol.name_of(symbol)
                let nl Symbol.name_len_of(symbol)
                if Checker.name_bytes_are(nd, "BuiltinIteratorReturn")
                    set t: this.builtin_iterator_return_type()
            }
        }
        else
        {
            ; ★★★ THE CIRCULARITY IS ONLY REAL IF THE WHOLE RIGHT-HAND SIDE WAS
            ; COMPUTED, AND THE `t = null` GUARD ABOVE IS TOO NARROW FOR THAT.
            ; This function's own header already names the hazard from the other
            ; side — *"resolution find a cycle that is not there — a wrong answer
            ; with no witness anywhere"* — and slice 121 produced exactly that
            ; case: with the conditional arm answering, `Recur<T> = (T extends
            ; unknown[] ? {} : { [K in keyof T]?: Recur<T[K]> }) | [...]` computes
            ; a UNION successfully while the mapped type inside it STOPS, so the
            ; alias is re-entered where the reference would have deferred and the
            ; resolution stack sees a cycle the language does not have. Measured:
            ; TS2456 plus six TS2315 the reference reports nowhere, on
            ; compiler_recursiveIndexedAccessSimplification.
            ;
            ; ★★★ A NON-NULL `t` IS NOT PROOF THE WALK FINISHED. A stop deeper in
            ; the RHS leaves an inner type null and the enclosing union, tuple or
            ; conditional still answers — so the question is whether anything
            ; reported, not whether this level did.
            if this.unported_mark() <> rhs_mark
                return null
            ; `errorNode := declaration.Name(); if errorNode == nil { errorNode = declaration }`
            var error_node AstNode.name_of(decl)
            if error_node = null
                set error_node: decl
            this.error_on_node(error_node, DiagType_alias_0_circularly_references_itself, this.symbol_arg(symbol))
            set t: error_type
        }
        if links.declared_type = null
            set links.declared_type: t
        links.declared_type
    }

    ; getBuiltinIteratorReturnType. `strictBuiltinIteratorReturn` is a
    ; strict-FAMILY option read through GetStrictOptionValue, so an unset value
    ; falls through to `Strict != TSFalse` and answers TRUE — strict_null_checks'
    ; derivation, one option over. The `anyType` fork is therefore unreachable
    ; here and is written as the option's own reading rather than as an arm.
    function builtin_iterator_return_type(this) returns ref[Type]?
    {
        if Checker.strict_builtin_iterator_return()
            return undefined_type
        any_type
    }

    function strict_builtin_iterator_return() returns bool
        checker_strict_builtin_iterator_return

    ; getDeclaredTypeOfClassOrInterface, whole.
    ;
    ; ★★ THE GUARD IS A DISJUNCTION AND ITS THREE TERMS DO NOT COST THE SAME. A
    ; CLASS short-circuits on the second term, so isThislessInterface is never
    ; asked about one — which is why the only units in this slice that can reach
    ; resolveEntityName are the 28 interfaces WITH a heritage clause, of 17 973.
    procedure get_declared_type_of_class_or_interface(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.declared_type_link_of(symbol)
        if links.declared_type <> null
            return links.declared_type
        var kind ObjectFlagsInterface
        let is_class (Symbol.flags_of(symbol) & SymbolFlagsClass) <> 0
        if is_class
            set kind: ObjectFlagsClass
        let made this.new_object_type(kind, symbol)
        if made = null
            return null
        let t made as ref[Type]
        ; The reference stores the type in the links BEFORE resolving the type
        ; parameters, and that order is load-bearing rather than incidental: a
        ; class whose own type parameter's constraint mentions the class closes the
        ; recursion on the half-built type instead of running forever.
        set links.declared_type: t
        ; ★★★ THE GUARDS BELOW ASK WHETHER *THIS CALL* REPORTED, NOT WHETHER THE
        ; CHECKER HAS EVER REPORTED, and the file already paid for the difference
        ; once — see check_grammar_modifiers' note. record_unported is FIRST-WINS
        ; and unit-wide, so by the time a file's second declaration is checked the
        ; flag is usually already set; a blanket `is_unported()` test would return
        ; here for every declaration after the first. Measured while writing this
        ; slice, on the guard one level up: two TS2368 reports vanished from
        ; checker_type_parameter_reserved_name.ts, because the second and third
        ; type parameter returned before checkTypeNameIsReserved.
        let unported_before this.unported_mark()
        let outer this.get_outer_type_parameters_of_class_or_interface(symbol)
        if this.unported_mark() <> unported_before
            return t
        ; ★★★ THE COUNT IS TAKEN BEFORE THE APPEND, AND TAKING IT AFTER WAS A
        ; SILENT WRONG ANSWER. Upstream is `typeParameters := append(outerTypeParameters,
        ; localTypeParameters...)` and reads `len(outerTypeParameters)` afterwards —
        ; a Go slice is a VALUE, so the local variable's length cannot move. This
        ; port's `append_type_parameters` grows the array IN PLACE and hands the
        ; same object back, so `outer` had already become outer+local by the time
        ; the count was read: for `function f<X>(x: X) { class C<Y> {…} }` the
        ; outer count came out **2** where it is 1, which made
        ; `outer_type_parameters_of` claim C's own `Y` as one of its container's
        ; and `local_type_parameters_of` answer an EMPTY local list. Both were
        ; invisible while the printer's outer-type-parameter branch was a stop —
        ; it is the only reader that shows the first — and the second silently
        ; empties a constructor signature's type-parameter list.
        var outer_count 0
        if outer <> null
            set outer_count: (outer as ref[Array[ref[Type]?]]).get_length() as int
        let type_parameters this.append_local_type_parameters_of_class_or_interface_or_type_alias(outer, symbol)
        if this.unported_mark() <> unported_before
            return t

        var give_this_type false
        if type_parameters <> null
            set give_this_type: true
        if is_class
            set give_this_type: true
        if give_this_type = false
        {
            let thisless this.is_thisless_interface(symbol)
            if this.unported_mark() <> unported_before
                return t
            if thisless = false
                set give_this_type: true
        }
        if give_this_type
        {
            set t.object_flags: t.object_flags | ObjectFlagsReference
            let this_type this.new_type_parameter(symbol)
            Checker.mark_this_type(this_type)
            Checker.set_type_parameter_constraint(this_type, t)
            ; `d.resolvedTypeArguments = d.TypeParameters()` is allTypeParameters
            ; WITHOUT the trailing thisType — which is exactly the list that went
            ; in, so it is built once and handed over as both.
            let tps this.new_type_list(type_parameters)
            let all this.new_type_list(tps)
            all.add(this_type)
            let insts &Array[ref[TypeInstantiation]?]^host()
            let seed &TypeInstantiation^host(Checker.type_list_hash(tps), tps, t)
            insts.add(seed)
            Checker.fill_interface_data(t, all, tps, insts, outer_count, this_type)
        }
        t
    }

    ; A fresh type list seeded with an existing one — `append(typeParameters,
    ; d.thisType)`'s allocation, written out because Scaly's Array is a value the
    ; caller owns rather than a slice the callee may share.
    function new_type_list(this, seed: ref[Array[ref[Type]?]]?) returns ref[Array[ref[Type]?]]
    {
        if seed <> null
        {
            ; a copy is sized once: growing it by doubling left the smaller buffers behind
            let src seed as ref[Array[ref[Type]?]]
            let n src.get_length() as int
            let copy &Array[ref[Type]?]^host(n as size_t)
            var i 0
            while i < n
            {
                copy.add(src[i])
                set i: i + 1
            }
            return copy
        }
        let a &Array[ref[Type]?]^host()
        a
    }

    ; The same list, SIZED, for a caller that knows how many types it will hold
    ; (slice 340). An Array grows by doubling and leaves its smaller buffers
    ; behind — in a region nothing reclaims those, and the checker builds 12.6
    ; million type lists over a large program, most of them with one or two
    ; entries in a four-slot buffer. `n` must be the FINAL count: a list that
    ; outgrows it doubles from there, which is correct but pays the copy.
    function new_type_list_of(this, n: int) returns ref[Array[ref[Type]?]]
        &Array[ref[Type]?]^host(n as size_t)

    ; The three writes into a payload arm, each its own procedure because a
    ; `choose` binding is the only way to reach the arm's slots.
    ; ★★★ THE WRITE-BACK IS THE IDIOM AND IT IS NOT DECORATION — a `when` binding is
    ; a COPY of the payload, so a `set` through it mutates a temporary. ast.scaly's
    ; `set_type` has written it this way since slice 17 (copy, mutate, put the whole
    ; arm back) and the other eighty-eight payload writes in this tree follow it.
    ; Spelled the direct way — `set d.is_this_type: true` — the emitter GEPs through
    ; the LOADED STRUCT VALUE (`getelementptr %PayloadA, %PayloadA %variant.val`) and
    ; the store lands on whatever the payload's first eight bytes point at. It
    ; SIGSEGVs here, which is the lucky half; the same spelling over a payload whose
    ; first slot is a valid address is a silent wrong write.
    procedure mark_this_type(t: ref[Type])
    {
        choose t.data
            when tp: TypeParameter
            {
                var d tp
                set d.is_this_type: true
                set t.data: TypeData.TypeParameter(d)
            }
    }

    procedure set_type_parameter_constraint(t: ref[Type], c: ref[Type])
    {
        choose t.data
            when tp: TypeParameter
            {
                var d tp
                set d.constraint: c
                set t.data: TypeData.TypeParameter(d)
            }
    }

    ; TypeParameter.constraint / ConstrainedType.resolvedBaseConstraint /
    ; TypeParameter.resolvedDefaultType, the three memo slots slice 81 reads and
    ; writes. Each write is the same copy / mutate / put-the-arm-back as the two
    ; above, for the reason mark_this_type's note gives.
    ; TypeParameter.target / TypeParameter.mapper, and the one writer
    ; clone_type_parameter needs (slice 125).
    function type_parameter_target_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: TypeParameter
                return d.target
        null
    }

    function type_parameter_mapper_of(t: ref[Type]) returns ref[TypeMapper]?
    {
        choose t.data
            when d: TypeParameter
                return d.mapper
        null
    }

    procedure set_type_parameter_target(t: ref[Type], target: ref[Type]?)
    {
        choose t.data
            when d0: TypeParameter
            {
                var d d0
                set d.target: target
                set t.data: TypeData.TypeParameter(d)
            }
    }

    procedure set_type_parameter_mapper(t: ref[Type], m: ref[TypeMapper]?)
    {
        choose t.data
            when d0: TypeParameter
            {
                var d d0
                set d.mapper: m
                set t.data: TypeData.TypeParameter(d)
            }
    }

    function type_parameter_constraint_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when tp: TypeParameter
                return tp.constraint
        null
    }

    function is_this_type_of(t: ref[Type]) returns bool
    {
        choose t.data
            when tp: TypeParameter
                return tp.is_this_type
        false
    }

    ; isThisTypeParameter, whole. Its reader is type_to_string's `this` arm, which
    ; has to run BEFORE the type-parameter arm: a this-type carries the CLASS's
    ; symbol, so naming it by symbol answers the class name.
    function is_this_type_parameter(t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsTypeParameter) = 0
            return false
        Checker.is_this_type_of(t)
    }

    function resolved_base_constraint_of(t: ref[Type]) returns ref[Type]?
        t.resolved_base_constraint

    procedure set_resolved_base_constraint(t: ref[Type], c: ref[Type])
        set t.resolved_base_constraint: c

    function resolved_default_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when tp: TypeParameter
                return tp.resolved_default_type
        null
    }

    ; ★ The default's setter takes an OPTION where the other two take a plain ref,
    ; and the one call that needs it is the stop path in
    ; getResolvedTypeParameterDefault: the marker it writes before computing has to
    ; be taken back out again when the computation did not finish. See that
    ; function's note.
    procedure set_resolved_default_type(t: ref[Type], d0: ref[Type]?)
    {
        choose t.data
            when tp: TypeParameter
            {
                var d tp
                set d.resolved_default_type: d0
                set t.data: TypeData.TypeParameter(d)
            }
    }

    ; d.allTypeParameters / d.outerTypeParameterCount / d.thisType, plus the two
    ; TypeReference slots the reference sets in the same block:
    ; `resolvedTypeArguments = d.TypeParameters()`, `target = t`, and the one-entry
    ; instantiations seed.
    ;
    ; ★ resolvedTypeArguments is d.TypeParameters() — allTypeParameters WITHOUT the
    ; trailing thisType — so it is the seed list before `all.add(this_type)`, which
    ; is why the caller hands both.
    procedure fill_interface_data(t: ref[Type], all: ref[Array[ref[Type]?]], tps: ref[Array[ref[Type]?]], insts: ref[Array[ref[TypeInstantiation]?]], outer_count: int, this_type: ref[Type])
    {
        choose t.data
            when i: Interface
            {
                var d i
                set d.all_type_parameters: all
                set d.outer_type_parameter_count: outer_count
                set d.this_type: this_type
                set d.resolved_type_arguments: tps
                set d.instantiations: insts
                set d.target: t
                set t.data: TypeData.Interface(d)
            }
    }

    ; ── the type-parameter collectors ───────────────────────────────────────
    ;
    ; ★★ EVERY LOOP BELOW IS EMPTY FOR EVERY UNIT THIS SLICE REACHES, by the ORDER
    ; proof at get_declared_type_of_symbol — and they are written out anyway rather
    ; than folded to `null`, because the day the type-parameter row lands is the day
    ; they run, and a folded version would be a silent wrong answer rather than a
    ; missing one.

    ; getOuterTypeParametersOfClassOrInterface. The `Find` picks the INTERFACE
    ; declaration (or a variable declaration initialised to a function) when the
    ; symbol is neither a class nor a function — which is what makes a reopened
    ; interface use one of its own declarations rather than a value declaration it
    ; may not have.
    procedure get_outer_type_parameters_of_class_or_interface(this, symbol: ref[Symbol]) returns ref[Array[ref[Type]?]]?
    {
        var declaration Symbol.value_declaration_of(symbol)
        if (Symbol.flags_of(symbol) & (SymbolFlagsClass | SymbolFlagsFunction)) = 0
        {
            set declaration: null
            let n Symbol.declaration_count(symbol)
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(symbol, i)
                if d <> null
                {
                    let dn d as ref[AstNode]
                    if AstNode.kind_of(dn) = KindInterfaceDeclaration
                    {
                        set declaration: dn
                        set i: n
                    }
                    else
                    {
                        if AstNode.kind_of(dn) = KindVariableDeclaration
                        {
                            let initializer AstNode.initializer_of(dn)
                            if initializer <> null
                            {
                                let ik AstNode.kind_of(initializer as ref[AstNode])
                                if ik = KindFunctionExpression
                                {
                                    set declaration: dn
                                    set i: n
                                }
                                if ik = KindArrowFunction
                                {
                                    set declaration: dn
                                    set i: n
                                }
                            }
                        }
                    }
                }
                set i: i + 1
            }
        }
        ; The reference asserts here ("Class was missing valueDeclaration -OR-
        ; non-class had no interface declarations"). A report rather than a trap,
        ; on this file's rule: an assertion is a claim that the input is impossible.
        if declaration = null
        {
            this.record_unported("outer-type-parameters-no-declaration", 0)
            return null
        }
        this.get_outer_type_parameters(declaration as ref[AstNode], false)
    }

    ; getOuterTypeParameters. ★★★THE `includeThisTypes` PARAMETER IS SLICE 125'S AND
    ; THE NOTE THAT STOOD HERE IS ITS EXPIRY: it read *its only caller here passes
    ; false, and the true branch is the one that asks getDeclaredTypeOfClassOrInterface
    ; back*, and getObjectTypeInstantiation — this slice's — passes TRUE. The
    ; recursion the note was avoiding is the reference's own and is bounded by the
    ; declaration chain.
    ;
    ; ★★★ THE THREE STOPS ARE GONE AND THEY ARE §3.5dk EXACTLY — every one of them
    ; named machinery *this slice does not have* and every callee has been ported
    ; since: `get_signatures_of_type` over `get_type_of_symbol` for the
    ; context-sensitive arm, `get_declared_type_of_type_parameter` for the mapped
    ; one and `get_infer_type_parameters` for the conditional one. With them left
    ; standing the mapped type answers nothing, because a mapped type's own type
    ; parameter is in scope for every node inside it.
    procedure get_outer_type_parameters(this, start: ref[AstNode], include_this_types: bool) returns ref[Array[ref[Type]?]]?
    {
        var node AstNode.parent_node_of(start)
        while node <> null
        {
            let n node as ref[AstNode]
            let kind AstNode.kind_of(n)
            if Checker.kind_carries_outer_type_parameters(kind)
            {
                let mark this.unported_mark()
                let outer this.get_outer_type_parameters(n, include_this_types)
                if this.unported_mark() <> mark
                    return null
                var context_sensitive_kind false
                if kind = KindFunctionExpression
                    set context_sensitive_kind: true
                if kind = KindArrowFunction
                    set context_sensitive_kind: true
                if Checker.is_object_literal_method(n)
                    set context_sensitive_kind: true
                if context_sensitive_kind
                {
                    if this.is_context_sensitive(n)
                    {
                        let sym this.get_symbol_of_declaration(n)
                        if sym <> null
                        {
                            let st this.get_type_of_symbol(sym as ref[Symbol])
                            if this.unported_mark() <> mark
                                return null
                            if st <> null
                            {
                                let sigs this.get_signatures_of_type(st as ref[Type], SignatureKindCall)
                                if this.unported_mark() <> mark
                                    return null
                                if sigs <> null
                                {
                                    let list sigs as ref[Array[ref[Signature]?]]
                                    if (list.get_length() as int) > 0
                                    {
                                        let first list[0]
                                        if first <> null
                                        {
                                            let sig first as ref[Signature]
                                            let tps sig.type_parameters
                                            if tps <> null
                                            {
                                                let tpl tps as ref[Array[ref[Type]?]]
                                                let tn tpl.get_length() as int
                                                if tn > 0
                                                {
                                                    let out this.append_type_list(outer, tpl)
                                                    return out
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if kind = KindMappedType
                {
                    let tp AstNode.mapped_type_parameter_of(n)
                    if tp = null
                        return outer
                    let tsym this.get_symbol_of_declaration(tp as ref[AstNode])
                    if tsym = null
                        return outer
                    let declared this.get_declared_type_of_type_parameter(tsym as ref[Symbol])
                    if this.unported_mark() <> mark
                        return null
                    let out this.copy_or_new_type_list(outer)
                    out.add(declared)
                    return out
                }
                if kind = KindConditionalType
                {
                    let infers this.get_infer_type_parameters(n)
                    if this.unported_mark() <> mark
                        return null
                    if infers = null
                        return outer
                    return this.append_type_list(outer, infers as ref[Array[ref[Type]?]])
                }
                let outer_and_own this.append_type_parameters(outer, AstNode.type_parameters_of(n))
                if include_this_types = false
                    return outer_and_own
                var is_class_like false
                if kind = KindClassDeclaration
                    set is_class_like: true
                if kind = KindClassExpression
                    set is_class_like: true
                if kind = KindInterfaceDeclaration
                    set is_class_like: true
                if is_class_like = false
                    return outer_and_own
                let csym this.get_symbol_of_declaration(n)
                if csym = null
                    return outer_and_own
                let declared this.get_declared_type_of_class_or_interface(csym as ref[Symbol])
                if this.unported_mark() <> mark
                    return null
                if declared = null
                    return outer_and_own
                let this_type Checker.this_type_of(declared as ref[Type])
                if this_type = null
                    return outer_and_own
                let out this.copy_or_new_type_list(outer_and_own)
                out.add(this_type)
                return out
            }
            set node: AstNode.parent_node_of(n)
        }
        null
    }

    ; `append(xs, ys...)` and `append(xs, y)` — Go's variadic append over a list
    ; that may be nil, which is the shape three arms above need. It COPIES rather
    ; than appending in place, because `outer` is the answer of a recursive call
    ; and the reference's slice append is free to reallocate; sharing it would let
    ; two branches of the walk write into one list.
    procedure copy_or_new_type_list(this, src: ref[Array[ref[Type]?]]?) returns ref[Array[ref[Type]?]]
    {
        let out this.new_type_list(null)
        if src <> null
        {
            let list src as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                out.add(list[i])
                set i: i + 1
            }
        }
        out
    }

    procedure append_type_list(this, src: ref[Array[ref[Type]?]]?, extra: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]
    {
        let out this.copy_or_new_type_list(src)
        let n extra.get_length() as int
        var i 0
        while i < n
        {
            out.add(extra[i])
            set i: i + 1
        }
        out
    }

    ; The reference's `case` list, as a predicate. A MethodDeclaration is in it and
    ; is also what IsObjectLiteralMethod tests for above — the two questions are
    ; separate and only the first is asked here.
    function kind_carries_outer_type_parameters(kind: int) returns bool
    {
        if kind = KindClassDeclaration
            return true
        if kind = KindClassExpression
            return true
        if kind = KindInterfaceDeclaration
            return true
        if kind = KindCallSignature
            return true
        if kind = KindConstructSignature
            return true
        if kind = KindMethodSignature
            return true
        if kind = KindFunctionType
            return true
        if kind = KindConstructorType
            return true
        if kind = KindFunctionDeclaration
            return true
        if kind = KindMethodDeclaration
            return true
        if kind = KindFunctionExpression
            return true
        if kind = KindArrowFunction
            return true
        if kind = KindTypeAliasDeclaration
            return true
        if kind = KindJSTypeAliasDeclaration
            return true
        if kind = KindMappedType
            return true
        if kind = KindConditionalType
            return true
        false
    }

    ; appendLocalTypeParametersOfClassOrInterfaceOrTypeAlias.
    procedure append_local_type_parameters_of_class_or_interface_or_type_alias(this, types: ref[Array[ref[Type]?]]?, symbol: ref[Symbol]) returns ref[Array[ref[Type]?]]?
    {
        var acc types
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                let k AstNode.kind_of(dn)
                var takes false
                if k = KindInterfaceDeclaration
                    set takes: true
                if k = KindClassDeclaration
                    set takes: true
                if k = KindClassExpression
                    set takes: true
                if k = KindTypeAliasDeclaration
                    set takes: true
                if k = KindJSTypeAliasDeclaration
                    set takes: true
                if takes
                {
                    set acc: this.append_type_parameters(acc, AstNode.type_parameters_of(dn))
                }
            }
            set i: i + 1
        }
        acc
    }

    ; appendTypeParameters. `AppendIfUnique` is the reference's, and the identity
    ; it compares is the TYPE's — which is why the memo in declared_type_link_of
    ; has to be the one answering, not a fresh type per ask.
    procedure append_type_parameters(this, types: ref[Array[ref[Type]?]]?, declarations: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[Type]?]]?
    {
        if declarations = null
            return types
        let list declarations as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        if n = 0
            return types
        var acc types
        var i 0
        while i < n
        {
            let d list[i]
            if d <> null
            {
                let sym this.symbol_of_declaration(d as ref[AstNode])
                if sym <> null
                {
                    let tp this.get_declared_type_of_type_parameter(sym as ref[Symbol])
                    if tp <> null
                    {
                        if acc = null
                            set acc: this.new_type_list(null)
                        let a acc as ref[Array[ref[Type]?]]
                        var seen false
                        let m a.get_length() as int
                        var j 0
                        while j < m
                        {
                            let aj: ref[Type]? a.at(j)
                            if aj = tp
                                set seen: true
                            set j: j + 1
                        }
                        if seen = false
                            a.add(tp)
                    }
                }
            }
            set i: i + 1
        }
        acc
    }

    ; isThislessInterface. ★★★ ANSWERED SINCE SLICE 110: the wall was
    ; resolveEntityName's QUALIFIED-name walk, which this slice ports.
    procedure is_thisless_interface(this, symbol: ref[Symbol]) returns bool
    {
        let unported_before this.unported_mark()
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                if AstNode.kind_of(dn) = KindInterfaceDeclaration
                {
                    if (AstNode.flags_of(dn) & NodeFlagsContainsThis) <> 0
                        return false
                    let bases Checker.get_extends_heritage_clause_elements(dn)
                    let bn AstNode.list_count(bases)
                    var bi 0
                    while bi < bn
                    {
                        let base AstNode.child_in_list(bases, bi)
                        set bi: bi + 1
                        let expr AstNode.expression_of(base)
                        if expr = null
                            continue
                        if Checker.is_entity_name_expression(expr as ref[AstNode]) = false
                            continue
                        let base_symbol this.resolve_entity_name(expr as ref[AstNode], SymbolFlagsType, true, false, null)
                        if this.unported_mark() <> unported_before
                            return false
                        if base_symbol = null
                            return false
                        let bs base_symbol as ref[Symbol]
                        if (Symbol.flags_of(bs) & SymbolFlagsInterface) = 0
                            return false
                        let declared this.get_declared_type_of_class_or_interface(bs)
                        if this.unported_mark() <> unported_before
                            return false
                        if declared = null
                            return false
                        if Checker.this_type_of(declared as ref[Type]) <> null
                            return false
                    }
                }
            }
            set i: i + 1
        }
        true
    }

    ; ast.GetExtendsHeritageClauseElements — the list, at last with readers.
    ;
    ; ★★ SLICE 66 DEFERRED THIS AND SAID SO: its note read "reduced to the
    ; question the caller asks — does the loop run at all … pulling them out would
    ; be a list nobody reads". Slice 67 has three readers (getBaseTypeNodeOfClass
    ; through FirstOrNil, resolveBaseTypesOfInterface's loop, and the predicate
    ; below), so the deferral has expired and the reduced form is now the derived
    ; one rather than the primitive.
    function get_extends_heritage_clause_elements(node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        Checker.get_heritage_elements(node, KindExtendsKeyword)
    }

    ; ast.GetImplementsHeritageClauseElements — the second of the two wrappers.
    ;
    ; ★ SLICE 74 IS WHAT SPLIT THE SHARED HALF OUT. The reference has always had
    ; GetHeritageElements(node, kind) with the two wrappers over it; this port
    ; inlined it while `extends` was the only kind anybody asked for, and the
    ; implements loop of checkClassLikeDeclaration is the second caller that makes
    ; the reference's own decomposition the cheaper one to keep.
    function get_implements_heritage_clause_elements(node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        Checker.get_heritage_elements(node, KindImplementsKeyword)
    }

    ; ast.GetHeritageElements — GetHeritageClause(node, kind) and then its Types.
    ; The clause SEARCH is inlined into the walk, exactly as before the split: the
    ; reference's GetHeritageClause has no other caller here.
    function get_heritage_elements(node: ref[AstNode], kind: int) returns ref[Array[ref[AstNode]?]]?
    {
        let clauses AstNode.heritage_clauses_of(node)
        if clauses = null
            return null
        let list clauses as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let c list[i]
            if c <> null
            {
                if AstNode.heritage_clause_token_of(c as ref[AstNode]) = kind
                    return AstNode.heritage_clause_types_of(c as ref[AstNode])
            }
            set i: i + 1
        }
        null
    }

    ; ast.GetExtendsHeritageClauseElement — core.FirstOrNil of the list.
    function get_extends_heritage_clause_element(node: ref[AstNode]) returns ref[AstNode]?
    {
        let elems Checker.get_extends_heritage_clause_elements(node)
        if elems = null
            return null
        let list elems as ref[Array[ref[AstNode]?]]
        if list.get_length() = 0
            return null
        list[0]
    }

    function has_extends_heritage(node: ref[AstNode]) returns bool
    {
        Checker.get_extends_heritage_clause_element(node) <> null
    }

    ; ── the type reference ──────────────────────────────────────────────────

    ; getTypeArguments, for the case this slice can reach: resolvedTypeArguments is
    ; written at construction by getDeclaredTypeOfClassOrInterface, so the deferred
    ; branch — which resolves them off the type NODE and needs getTypeFromTypeNode —
    ; is unreachable and reports instead of being left out.
    ; ★★★ THE DEFERRED BRANCH IS CODE SINCE SLICE 115 FOR THE ARRAY AND THE TUPLE,
    ; and the note that stood here — *"resolvedTypeArguments is written at
    ; construction by getDeclaredTypeOfClassOrInterface, so the deferred branch is
    ; unreachable and reports instead of being left out"* — was true only while
    ; nothing built a deferred reference. createDeferredTypeReference does.
    ;
    ; ★★★ THE TypeReference ARM STAYS A STOP AND THE SPLIT IS EXACT: it needs
    ; `OuterTypeParameters()` and getEffectiveTypeArguments, i.e. the type-argument
    ; FILL and the outer-parameter slicing, neither of which this port has. The
    ; Array and Tuple arms need only getTypeFromTypeNode, which is this slice's own
    ; chapter — so the tag keeps its name and loses two of its three arms.
    ;
    ; ★★★ THE CIRCULARITY HALF WAS WRITTEN IN SLICE 195, MEASURED, AND TAKEN BACK
    ; OUT — and this note is the measurement, not a judgement, so that the slice
    ; which lands the CAUSE can retire the row without re-deriving any of it.
    ; Both arms are eight lines and both are faithful: `pushTypeResolution` false
    ; answers `slices.Repeat(errorType, len(n.TypeParameters()))` without memoising,
    ; `popTypeResolution` false memoises the same list (behind upstream's own
    ; `if d.resolvedTypeArguments == nil` re-read, which matters because the cycle
    ; IS a re-entry) and then errors TS4109, or TS4110 when the target carries no
    ; symbol. With them in, stage 2 read 18288/18455 — 21 UNPORTED→MATCH — and
    ; **three units SIGSEGV**: `inferFromNestedSameShapeTuple`,
    ; `recursiveTypeReferences1` and `recursiveConditionalTypes`, of which the first
    ; two were MATCH on the five non-checker yardsticks, so the crash costs ten
    ; MATCH→FAIL rows that no FAIL could.
    ;
    ; ★★★ THE CRASH IS NOT IN THIS FUNCTION AND THE PROBE SAYS SO. Over 10 445
    ; consecutive entries for `type T1<T> = [number, T1<{ x: T }>]` the tuple
    ; reference is THE SAME type id, `instantiation_depth` is **0** and the
    ; type-resolution stack is **empty** at every one — so the recursion that
    ; overflows the stack runs neither through `instantiate_type` (whose
    ; depth-100 / 5 000 000 guard is what bounds this upstream) nor through the
    ; resolution stack, and this function is only the innermost frame that happens
    ; to touch it. Neither arm is reached for that type: it returns null from the
    ; tuple arm's `one = null` and therefore never memoises, which is what lets the
    ; outer walk ask again at every level. **The stop is standing in front of an
    ; unbounded walk in the tuple-element path, not in front of these eight lines**,
    ; and the row cannot be retired until that walk is bounded the way upstream
    ; bounds it.
    ; slices.Repeat(errorType, len(n.TypeParameters())) — InterfaceType.TypeParameters
    ; is allTypeParameters without the trailing thisType, and empty for an empty list.
    procedure error_type_arguments_of(this, t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        let out this.new_type_list(null)
        let tgt Checker.target_of(t)
        if tgt = null
            return out
        let all Checker.all_type_parameters_of(tgt as ref[Type])
        if all = null
            return out
        let list all as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < (n - 1)
        {
            out.add(error_type)
            set i: i + 1
        }
        out
    }

    procedure get_type_arguments(this, t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        let args Checker.resolved_type_arguments_of(t)
        if args <> null
            return args
        let node Checker.reference_node_of(t)
        if node = null
        {
            this.record_unported("get-type-arguments-deferred", 0)
            return null
        }
        let n node as ref[AstNode]
        let k AstNode.kind_of(n)
        if k <> KindArrayType
        {
            if k <> KindTupleType
            {
                if k <> KindTypeReference
                {
                    this.record_unported("get-type-arguments-deferred", k)
                    return null
                }
            }
        }
        if this.push_type_resolution(null, t, null, null, TypeSystemPropertyNameResolvedTypeArguments) = false
            return this.error_type_arguments_of(t)
        let mark this.unported_mark()
        let resolved this.new_type_list(null)
        if k = KindArrayType
        {
            let et AstNode.array_element_type_of(n)
            if et = null
            {
                this.pop_type_resolution()
                return null
            }
            let one this.get_type_from_type_node(et as ref[AstNode])
            if one = null
            {
                this.pop_type_resolution()
                return null
            }
            resolved.add(one)
        }
        ; ★★★ SLICE 165 — THE TypeReference ARM, AND ITS SPLIT WAS *EXACT* AND HAS
        ; EXPIRED. The note read *it needs `OuterTypeParameters()` and
        ; getEffectiveTypeArguments, i.e. the type-argument FILL and the
        ; outer-parameter slicing, neither of which this port has* — both are here:
        ; `outer_type_parameters_of` since slice 121 and `get_effective_type_arguments`
        ; (which IS the fill, through fill_missing_type_arguments) since slice 136.
        ; The concatenation order is the reference's: outer parameters first, the
        ; node's own effective arguments after.
        if k = KindTypeReference
        {
            let tgt Checker.target_of(t)
            if tgt = null
            {
                this.pop_type_resolution()
                return null
            }
            let target tgt as ref[Type]
            let outer this.outer_type_parameters_of(target)
            if outer <> null
            {
                let ol outer as ref[Array[ref[Type]?]]
                let on ol.get_length() as int
                var oi 0
                while oi < on
                {
                    resolved.add(ol[oi])
                    set oi: oi + 1
                }
            }
            let local this.local_type_parameters_of(target)
            if local = null
            {
                this.pop_type_resolution()
                return null
            }
            let eff this.get_effective_type_arguments(n, local as ref[Array[ref[Type]?]])
            if eff = null
            {
                this.pop_type_resolution()
                return null
            }
            let el eff as ref[Array[ref[Type]?]]
            let en el.get_length() as int
            var ei 0
            while ei < en
            {
                resolved.add(el[ei])
                set ei: ei + 1
            }
        }
        if k = KindTupleType
        {
            let elements AstNode.elements_of(n)
            var count 0
            if elements <> null
                set count: (elements as ref[Array[ref[AstNode]?]]).get_length() as int
            var i 0
            while i < count
            {
                let e (elements as ref[Array[ref[AstNode]?]])[i]
                if e = null
                {
                    this.pop_type_resolution()
                    return null
                }
                let one this.get_type_from_type_node(e as ref[AstNode])
                if one = null
                {
                    this.pop_type_resolution()
                    return null
                }
                resolved.add(one)
                set i: i + 1
            }
        }
        if this.pop_type_resolution() = false
        {
            if Checker.resolved_type_arguments_of(t) = null
            {
                let errs this.error_type_arguments_of(t)
                if errs = null
                    return null
                Checker.set_reference_type_arguments(t, errs as ref[Array[ref[Type]?]])
            }
            let tgt2 Checker.target_of(t)
            if tgt2 <> null
            {
                let sym (tgt2 as ref[Type]).symbol
                if sym <> null
                    this.error_on_node(n, DiagType_arguments_for_0_circularly_reference_themselves, this.symbol_arg(sym))
                else
                    this.error_on_node(n, DiagTuple_type_arguments_circularly_reference_themselves)
            }
            else
                this.error_on_node(n, DiagTuple_type_arguments_circularly_reference_themselves)
            return Checker.resolved_type_arguments_of(t)
        }
        if this.unported_mark() <> mark
            return null
        ; `instantiateTypes(typeArguments, d.mapper)`, and a NIL mapper is the
        ; IDENTITY upstream — instantiateType's own first line is `if t == nil || m
        ; == nil { return t }`. This port's instantiate_types takes a non-optional
        ; mapper (it dereferences it), so the nil case is spelled at the call rather
        ; than by widening the callee: the reference's answer for nil is *the list
        ; unchanged*, which no walk needs to be entered to produce.
        var mapped: ref[Array[ref[Type]?]]? resolved
        let m Checker.reference_mapper_of(t)
        if m <> null
            set mapped: this.instantiate_types(resolved, m as ref[TypeMapper])
        if mapped = null
            return null
        Checker.set_reference_type_arguments(t, mapped)
        Checker.resolved_type_arguments_of(t)
    }

    ; TypeReference.node / TypeReference.mapper, and the write-back
    ; getTypeArguments' deferred branch needs.
    function reference_node_of(t: ref[Type]) returns ref[AstNode]?
    {
        choose t.data
            when r: Reference
                return r.node
        null
    }

    function reference_mapper_of(t: ref[Type]) returns ref[TypeMapper]?
    {
        choose t.data
            when r: Reference
                return r.mapper
        null
    }

    procedure set_reference_type_arguments(t: ref[Type], args: ref[Array[ref[Type]?]]?)
    {
        choose t.data
            when r: Reference
            {
                var d r
                set d.resolved_type_arguments: args
                set t.data: TypeData.Reference(d)
            }
    }

    procedure fill_deferred_reference_data(t: ref[Type], target: ref[Type], node: ref[AstNode], m: ref[TypeMapper]?)
    {
        choose t.data
            when r: Reference
            {
                var d r
                set d.target: target
                set d.node: node
                set d.mapper: m
                set t.data: TypeData.Reference(d)
            }
    }

    ; getPropagatingFlagsOfTypes, whole. Its caller passes TypeFlagsNone as the
    ; exclusion, so the guard is `t.flags & 0 == 0` — always true — and the loop is
    ; a plain or-fold. It is written with the parameter anyway: the OTHER callers
    ; (createArrayType, createTupleType) pass a real mask, and a version specialised
    ; to this one would have to be un-specialised by the first of them.
    function get_propagating_flags_of_types(types: ref[Array[ref[Type]?]]?, exclude_kinds: int) returns int
    {
        if types = null
            return ObjectFlagsNone
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var result ObjectFlagsNone
        var i 0
        while i < n
        {
            let t list[i]
            if t <> null
            {
                let ty t as ref[Type]
                if (ty.flags & exclude_kinds) = 0
                    set result: result | ty.object_flags
            }
            set i: i + 1
        }
        result & ObjectFlagsPropagatingFlags
    }

    ; createTypeReferenceEx. The lookup is over the target's instantiation LIST,
    ; comparing the argument lists themselves — see TypeInstantiation for why the
    ; reference's hash key is not ported and what would bring it back.
    procedure create_type_reference(this, target: ref[Type], type_arguments: ref[Array[ref[Type]?]]?, object_flags: int) returns ref[Type]?
    {
        let existing Checker.find_instantiation(target, type_arguments)
        if existing <> null
            return existing
        let propagating Checker.get_propagating_flags_of_types(type_arguments, 0)
        let made this.new_object_type(ObjectFlagsReference | object_flags | propagating, target.symbol)
        if made = null
            return null
        let t made as ref[Type]
        Checker.fill_reference_data(t, target, type_arguments)
        Checker.add_instantiation(target, type_arguments, t)
        t
    }

    procedure fill_reference_data(t: ref[Type], target: ref[Type], args: ref[Array[ref[Type]?]]?)
    {
        choose t.data
            when r: Reference
            {
                var d r
                set d.target: target
                set d.resolved_type_arguments: args
                set t.data: TypeData.Reference(d)
            }
    }

    procedure find_instantiation(target: ref[Type], args: ref[Array[ref[Type]?]]?) returns ref[Type]?
    {
        let h Checker.type_list_hash(args)
        choose target.data
            when d: Interface
            {
                if d.instantiations = null
                    return null
                let list d.instantiations as ref[Array[ref[TypeInstantiation]?]]
                let n list.get_length() as int
                if n < ObjectRowChainMin
                {
                    var k 0
                    while k < n
                    {
                        let row list[k as size_t]
                        set k: k + 1
                        if row = null
                            continue
                        let r row as ref[TypeInstantiation]
                        if r.hash = h
                        {
                            if Checker.type_lists_equal(r.arguments, args)
                                return r.instantiated
                        }
                    }
                    return null
                }
                var rebuild false
                if d.instantiation_index = null
                    set rebuild: true
                else
                {
                    let old_ix d.instantiation_index as ref[InstantiationIndex]
                    if old_ix.list <> list
                        set rebuild: true
                }
                let pg Page.get(list)
                if rebuild
                {
                    let fresh &InstantiationIndex^pg(list, AddressIndex.fresh_buckets(pg, 16), 15, 0)
                    set d.instantiation_index: fresh
                }
                let ix d.instantiation_index as ref[InstantiationIndex]
                Checker.catch_up_instantiation_index(pg, ix)
                var slot h & ix.mask
                repeat
                {
                    let e ix.slots[slot as size_t]
                    if e = 0
                        return null
                    let row list[(e - 1) as size_t]
                    if row <> null
                    {
                        let r row as ref[TypeInstantiation]
                        if r.hash = h
                        {
                            if Checker.type_lists_equal(r.arguments, args)
                                return r.instantiated
                        }
                    }
                    set slot: (slot + 1) & ix.mask
                }
            }
        null
    }

    ; the rows added since, into the slots; grown (from scratch, in list order)
    ; before passing three quarters full
    procedure catch_up_instantiation_index(pg: ref[Page], ix: ref[InstantiationIndex])
    {
        let list ix.list
        let n list.get_length() as int
        if (n * 4) > ((ix.mask + 1) * 3)
        {
            var cap (ix.mask + 1) * 2
            while (n * 4) > (cap * 3)
                set cap: cap * 2
            let old ix.slots
            set ix.slots: AddressIndex.fresh_buckets(pg, cap)
            AddressIndex.release_buckets(pg, old)
            set ix.mask: cap - 1
            set ix.indexed: 0
        }
        while ix.indexed < n
        {
            let i ix.indexed
            set ix.indexed: i + 1
            let row list[i as size_t]
            if row = null
                continue
            var slot (row as ref[TypeInstantiation]).hash & ix.mask
            while ix.slots[slot as size_t] <> 0
                set slot: (slot + 1) & ix.mask
            ix.slots.put(slot as size_t, i + 1)
        }
    }

    procedure find_object_instantiation(this, target: ref[Type], args: ref[Array[ref[Type]?]]?, alias: ref[TypeAlias]?, single_signature: bool) returns ref[Type]?
    {
        let list Checker.object_instantiations_of(target)
        if list = null
            return null
        let rows list as ref[Array[ref[ObjectInstantiation]?]]
        var asym: ref[Symbol]? null
        var aargs: ref[Array[ref[Type]?]]? null
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set asym: al.symbol
            set aargs: al.type_arguments
        }
        let h Checker.type_list_hash(args)
        let n rows.get_length() as int
        let chained n >= ObjectRowChainMin
        var ch: ref[HashChain]? null
        var i 0
        if chained
        {
            set ch: this.object_row_chain(rows)
            set i: (ch as ref[HashChain]).first(h)
        }
        while (i >= 0) and (i < n)
        {
            let row rows[i]
            if row <> null
            {
                let r row as ref[ObjectInstantiation]
                if r.hash = h
                {
                    if r.single_signature = single_signature
                    {
                        if r.alias_symbol = asym
                        {
                            if Checker.type_lists_equal(r.arguments, args)
                            {
                                if Checker.type_lists_equal(r.alias_type_arguments, aargs)
                                    return r.instantiated
                            }
                        }
                    }
                }
            }
            if chained
                set i: (ch as ref[HashChain]).after(i)
            else
                set i: i + 1
        }
        null
    }

    ; a signature's cache rows chained by type-argument hash (every kind; the
    ; lookup filters the kind), caught up like object_row_chain
    procedure signature_row_chain(this, rows: ref[Array[ref[CachedSignature]?]]) returns ref[HashChain]
    {
        let address rows as int
        let n rows.get_length() as int
        let hit signature_row_chains.find(address)
        var chain: ref[HashChain]? null
        if hit > 0
        {
            let known signature_row_chain_list[(hit - 1) as size_t]
            if known.count() <= n
                set chain: known
        }
        if chain = null
        {
            let made HashChain.create(host)
            signature_row_chain_list.add(made)
            signature_row_chains.insert(address, (signature_row_chain_list.get_length() as int) - 1)
            set chain: made
        }
        let c chain as ref[HashChain]
        while c.count() < n
        {
            let row rows[c.count() as size_t]
            if row = null
                c.add_blank()
            else
                c.add(Checker.type_list_hash((row as ref[CachedSignature]).type_arguments))
        }
        c
    }

    ; an instantiation list's rows chained by argument hash, caught up with the
    ; rows added since; a list shorter than its chain is a new list at a released
    ; address and gets a fresh chain
    procedure object_row_chain(this, rows: ref[Array[ref[ObjectInstantiation]?]]) returns ref[HashChain]
    {
        let address rows as int
        let n rows.get_length() as int
        let hit object_row_chains.find(address)
        var chain: ref[HashChain]? null
        if hit > 0
        {
            let known object_row_chain_list[(hit - 1) as size_t]
            if known.count() <= n
                set chain: known
        }
        if chain = null
        {
            let made HashChain.create(host)
            object_row_chain_list.add(made)
            object_row_chains.insert(address, (object_row_chain_list.get_length() as int) - 1)
            set chain: made
        }
        let c chain as ref[HashChain]
        while c.count() < n
        {
            let row rows[c.count() as size_t]
            if row = null
                c.add_blank()
            else
                c.add((row as ref[ObjectInstantiation]).hash)
        }
        c
    }

    function object_instantiations_of(t: ref[Type]) returns ref[Array[ref[ObjectInstantiation]?]]?
    {
        choose t.data
            when a: Anonymous
                return a.instantiations
            when r: Reference
                return r.instantiations
            when m: Mapped
                return m.instantiations
            when ie: InstantiationExpression
                return ie.instantiations
        null
    }

    procedure attach_object_instantiations(t: ref[Type], list: ref[Array[ref[ObjectInstantiation]?]])
    {
        choose t.data
            when a: Anonymous
            {
                var d a
                set d.instantiations: list
                set t.data: TypeData.Anonymous(d)
            }
            when r: Reference
            {
                var d r
                set d.instantiations: list
                set t.data: TypeData.Reference(d)
            }
            when ie: InstantiationExpression
            {
                var d ie
                set d.instantiations: list
                set t.data: TypeData.InstantiationExpression(d)
            }
            when m: Mapped
            {
                var d m
                set d.instantiations: list
                set t.data: TypeData.Mapped(d)
            }
    }

    procedure add_object_instantiation(target: ref[Type], args: ref[Array[ref[Type]?]]?, alias: ref[TypeAlias]?, single_signature: bool, t: ref[Type]?)
    {
        let list Checker.object_instantiations_of(target)
        if list = null
            return
        let rows list as ref[Array[ref[ObjectInstantiation]?]]
        var asym: ref[Symbol]? null
        var aargs: ref[Array[ref[Type]?]]? null
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set asym: al.symbol
            set aargs: al.type_arguments
        }
        let rows_page Page.get(rows)
        let row &ObjectInstantiation^rows_page(Checker.type_list_hash(args), args, asym, aargs, single_signature, t)
        rows.add(row)
    }

    procedure add_instantiation(target: ref[Type], args: ref[Array[ref[Type]?]]?, t: ref[Type])
    {
        choose target.data
            when d: Interface
            {
                if d.instantiations <> null
                {
                    let list d.instantiations as ref[Array[ref[TypeInstantiation]?]]
                    let list_page Page.get(list)
                    let row &TypeInstantiation^list_page(Checker.type_list_hash(args), args, t)
                    list.add(row)
                }
            }
    }

    ; The key comparison the reference's hash stands in for: two argument lists are
    ; the same when they are the same length and their entries are the same TYPE
    ; OBJECTS. Identity, not structural equality — which is what upstream's hash of
    ; the type IDS means too.
    function type_lists_equal(a: ref[Array[ref[Type]?]]?, b: ref[Array[ref[Type]?]]?) returns bool
    {
        var an 0
        if a <> null
            set an: (a as ref[Array[ref[Type]?]]).get_length() as int
        var bn 0
        if b <> null
            set bn: (b as ref[Array[ref[Type]?]]).get_length() as int
        if an <> bn
            return false
        if an = 0
            return true
        let al a as ref[Array[ref[Type]?]]
        let bl b as ref[Array[ref[Type]?]]
        var i 0
        while i < an
        {
            let bi: ref[Type]? bl.at(i)
            if al[i] <> bi
                return false
            set i: i + 1
        }
        true
    }

    ; getTypeWithThisArgument.
    ;
    ; ★★★ THE `needApparentType` PARAMETER IS CARRIED SINCE SLICE 98, AND THE REASON
    ; IS THE ONE SLICE 97 PAID FOR: a flag frozen at one caller's arguments is not a
    ; limitation, it is a wrong answer at the next call site. The note that stood
    ; here said the two call sites of the day pass `false` AND a nil thisArgument —
    ; and by then resolve_object_type_members was passing a non-nil one. The flag
    ; itself has NO input on this corpus (its only true caller upstream is
    ; getApparentTypeOfIntersectionType, which is a stop one call in front of it), so
    ; the tail arm is written from the reference and defended from the reference, not
    ; from a measurement — see slice 98's g07.
    procedure get_type_with_this_argument(this, t: ref[Type], this_argument: ref[Type]?, need_apparent_type: bool) returns ref[Type]?
    {
        if (t.object_flags & ObjectFlagsReference) <> 0
        {
            let target Checker.target_of(t)
            if target = null
            {
                this.record_unported("type-with-this-argument-no-target", 0)
                return null
            }
            let tg target as ref[Type]
            let before this.unported_mark()
            let type_arguments this.get_type_arguments(t)
            if this.unported_mark() <> before
                return null
            var argn 0
            if type_arguments <> null
                set argn: (type_arguments as ref[Array[ref[Type]?]]).get_length() as int
            if Checker.type_parameter_count_of(tg) <> argn
            {
                this.record_with_this(t, null, t, 2)
                return t
            }
            var arg this_argument
            if arg = null
                set arg: Checker.this_type_of(tg)
            let combined this.new_type_list(type_arguments)
            combined.add(arg)
            let made this.create_type_reference(tg, combined, ObjectFlagsNone)
            if made = null
                return null
            this.record_with_this(t, arg, made as ref[Type], 1)
            return made
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            ; core.SameMap over the constituents, and `core.Same` is what decides
            ; whether a new intersection is minted at all: an intersection none of
            ; whose constituents moved must answer ITSELF, because the caller's
            ; memo and every identity test downstream read the pointer.
            let types Checker.intersection_types_of(t)
            var moved false
            let mark this.unported_mark()
            let mapped &Array[ref[Type]?]()
            if types <> null
            {
                let list types as ref[Array[ref[Type]?]]
                let n list.get_length() as int
                var i 0
                while i < n
                {
                    let row list[i]
                    if row = null
                        return null
                    let c row as ref[Type]
                    let made this.get_type_with_this_argument(c, this_argument, need_apparent_type)
                    if this.unported_mark() <> mark
                        return null
                    if made = null
                        return null
                    let m made as ref[Type]
                    if m <> c
                        set moved: true
                    let e: ref[Type]? m
                    mapped.add(e)
                    set i: i + 1
                }
            }
            if moved = false
            {
                this.record_with_this(t, this_argument, t, 5)
                return t
            }
            let made this.get_intersection_type(mapped)
            if this.unported_mark() <> mark
                return null
            if made = null
                return null
            this.record_with_this(t, this_argument, made as ref[Type], 4)
            return made
        }
        if need_apparent_type
        {
            let ap this.get_apparent_type(t)
            if ap = null
                return null
            this.record_with_this(t, null, ap as ref[Type], 3)
            return ap
        }
        this.record_with_this(t, null, t, 0)
        t
    }

    ; The WITHPIN's entry — see WithThisEvent's header for why this chapter needs
    ; one of its own. It is written at all four answering paths and at none of the
    ; two stops, so the log's length is what the function ANSWERED.
    procedure record_with_this(this, t: ref[Type], arg: ref[Type]?, out: ref[Type], arm: int)
    {
        var arg_id 0
        if arg <> null
            set arg_id: (arg as ref[Type]).id
        if record_events
        {
            let ev &WithThisEvent^host(t.id, arg_id, out.id, arm, out)
            with_log.add(ev as ref[WithThisEvent])
        }
    }


    ; ── slice 67: the resolution stack ──────────────────────────────────────
    ;
    ; c.typeResolutions, pushTypeResolution / popTypeResolution and the cycle
    ; search, whole. It arrives with the first two memoised type questions that
    ; need it rather than with either one of them, because it is one stack shared
    ; by nine of them and a per-question guard would be a shape the next slice has
    ; to undo.
    ;
    ; ★★★ IT IS WHAT MAKES `interface I extends I {}` REPORT ONCE INSTEAD OF
    ; RECURSING, and the reference's design is worth restating because it is not
    ; the obvious one: the cycle is not broken by refusing to re-enter, it is
    ; broken by MARKING every frame from the cycle's start as failed, so each of
    ; them learns on the way out that its answer is not to be memoised.

    procedure push_type_resolution(this, target_symbol: ref[Symbol]?, target_type: ref[Type]?, target_signature: ref[Signature]?, target_node: ref[AstNode]?, property_name: int) returns bool
    {
        let start this.find_resolution_cycle_start_index(target_symbol, target_type, target_signature, target_node, property_name)
        if start >= 0
        {
            var i start
            while i < type_resolution_count
            {
                let row type_resolutions[i]
                if row <> null
                {
                    let r row as ref[TypeResolution]
                    set r.result: false
                }
                set i: i + 1
            }
            return false
        }
        ; a slot the stack has held before keeps its row: nothing reads a row above
        ; the count, and a row per push was garbage in the checker's region
        if type_resolution_count < (type_resolutions.get_length() as int)
        {
            let old type_resolutions[type_resolution_count]
            if old <> null
            {
                let r old as ref[TypeResolution]
                set r.target_symbol: target_symbol
                set r.target_type: target_type
                set r.target_signature: target_signature
                set r.target_node: target_node
                set r.property_name: property_name
                set r.result: true
            }
            else
                type_resolutions.put(type_resolution_count as size_t, &TypeResolution^host(target_symbol, target_type, target_signature, target_node, property_name, true))
        }
        else
            type_resolutions.add(&TypeResolution^host(target_symbol, target_type, target_signature, target_node, property_name, true))
        set type_resolution_count: type_resolution_count + 1
        true
    }

    procedure pop_type_resolution(this) returns bool
    {
        set type_resolution_count: type_resolution_count - 1
        let row type_resolutions[type_resolution_count]
        if row = null
            return true
        let r row as ref[TypeResolution]
        r.result
    }

    ; findResolutionCycleStartIndex. The FIRST test in the loop is the one that
    ; ends the search: an entry whose property has since been ANSWERED means the
    ; frames above it are not part of a cycle at all, so the walk stops rather
    ; than continuing past it.
    procedure find_resolution_cycle_start_index(this, target_symbol: ref[Symbol]?, target_type: ref[Type]?, target_signature: ref[Signature]?, target_node: ref[AstNode]?, property_name: int) returns int
    {
        var i type_resolution_count - 1
        while i >= resolution_start
        {
            let row type_resolutions[i]
            if row <> null
            {
                let r row as ref[TypeResolution]
                if this.type_resolution_has_property(r)
                    return 0 - 1
                if r.property_name = property_name
                {
                    var same true
                    if r.target_symbol <> target_symbol
                        set same: false
                    if r.target_type <> target_type
                        set same: false
                    if r.target_signature <> target_signature
                        set same: false
                    if r.target_node <> target_node
                        set same: false
                    if same
                        return i
                }
            }
            set i: i - 1
        }
        0 - 1
    }

    ; typeResolutionHasProperty. SEVEN arms have a PUSH (three from slice 67, the
    ; base constraint from slice 81, the return type from slice 84, the DECLARED
    ; TYPE from slice 105, the ALIAS TARGET from slice 110); the other three
    ; cannot be on the stack at all,
    ; so they report in place rather than
    ; being left out (§3.5v) — and the reference's own tail is a panic, which this
    ; file never ports as a trap because an assertion is a claim that the input is
    ; impossible.
    procedure type_resolution_has_property(this, r: ref[TypeResolution]) returns bool
    {
        ; Slice 175's arm, the eighth, and the first on the NODE target: the search
        ; must be able to ask whether the frame it found has since been ANSWERED,
        ; and for this question the answer's home is the node link's own pair.
        if r.property_name = TypeSystemPropertyNameInitializerIsUndefined
        {
            if r.target_node = null
                return false
            let nl this.node_link_of(r.target_node as ref[AstNode])
            return nl.initializer_is_undefined_computed
        }
        if r.property_name = TypeSystemPropertyNameType
        {
            if r.target_symbol = null
                return false
            let links this.value_symbol_link_of(r.target_symbol as ref[Symbol])
            return links.resolved_type <> null
        }
        if r.property_name = TypeSystemPropertyNameWriteType
        {
            if r.target_symbol = null
                return false
            let wlinks this.value_symbol_link_of(r.target_symbol as ref[Symbol])
            return wlinks.write_type <> null
        }
        ; Slice 105's arm, the sixth, and it is what makes the alias's own push
        ; mean anything: `type A = A` pushes DeclaredType on A, the annotation's
        ; resolution reaches A again, and the search must be able to ask whether
        ; the frame it found has since been ANSWERED. That question is this row —
        ; the table this slice mints — and with the arm reporting instead, the
        ; search's first test would stop the walk on every alias in scope.
        if r.property_name = TypeSystemPropertyNameDeclaredType
        {
            if r.target_symbol = null
                return false
            let al this.type_alias_link_of(r.target_symbol as ref[Symbol])
            return al.declared_type <> null
        }
        ; Slice 110's arm, the seventh. resolveAlias pushes AliasTarget and the
        ; search must be able to ask whether that frame has since been answered —
        ; the same argument the DeclaredType arm above makes, one table over.
        if r.property_name = TypeSystemPropertyNameAliasTarget
        {
            if r.target_symbol = null
                return false
            let asl this.alias_symbol_link_of(r.target_symbol as ref[Symbol])
            return asl.alias_target <> null
        }
        if r.property_name = TypeSystemPropertyNameResolvedBaseTypes
        {
            if r.target_type = null
                return false
            return Checker.base_types_resolved_of(r.target_type as ref[Type])
        }
        if r.property_name = TypeSystemPropertyNameResolvedBaseConstructorType
        {
            if r.target_type = null
                return false
            return Checker.resolved_base_constructor_type_of(r.target_type as ref[Type]) <> null
        }
        ; Slice 81's arm, the fourth. ★It answers FALSE for a non-type-parameter
        ; where the reference would answer off ConstrainedType's shared slot — see
        ; is_constrained_type's note — and that cannot be observed here, because a
        ; type whose base constraint HAS been resolved no longer has a frame on this
        ; stack to be asked about.
        if r.property_name = TypeSystemPropertyNameResolvedBaseConstraint
        {
            if r.target_type = null
                return false
            return Checker.resolved_base_constraint_of(r.target_type as ref[Type]) <> null
        }
        ; Slice 84's arm, the fifth, and the FIRST one keyed on the signature slot.
        ; `t.(*Signature).resolvedReturnType != nil` — the memo the frame above it
        ; is on the stack to fill.
        if r.property_name = TypeSystemPropertyNameResolvedReturnType
        {
            if r.target_signature = null
                return false
            return (r.target_signature as ref[Signature]).resolved_return_type <> null
        }
        ; The ResolvedTypeArguments arm, and it is the half that makes
        ; get_type_arguments' own push mean anything: a reference whose arguments
        ; are being resolved has a frame on this stack, and the search must be able
        ; to ask whether that frame has since been ANSWERED. Same argument as the
        ; DeclaredType and AliasTarget arms above, one slot over.
        if r.property_name = TypeSystemPropertyNameResolvedTypeArguments
        {
            if r.target_type = null
                return false
            return Checker.resolved_type_arguments_of(r.target_type as ref[Type]) <> null
        }
        this.record_unported("type-resolution-has-property", r.property_name)
        false
    }

    ; ── c.valueSymbolLinks ──────────────────────────────────────────────────

    ; The address hash the two indexed links tables share. An object address is
    ; 16-byte aligned at worst, so the low bits carry nothing — the FNV round
    ; `rel_result_hash` uses spreads them and the final shift clears the sign, for
    ; that function's own reason.
    ; The argument list's hash — the ids in order. A null list and an empty one
    ; hash alike, which is what type_lists_equal answers for them too.
    function type_list_hash(types: ref[Array[ref[Type]?]]?) returns int
    {
        var h: u64 14695981039346656037
        if types <> null
        {
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e <> null
                {
                    set h: h xor ((e as ref[Type]).id as u64)
                    set h: h * 1099511628211
                }
                set i: i + 1
            }
        }
        ((h >> 1) as int)
    }

    ; the link's extra record, made on the first write
    procedure value_symbol_extra(this, links: ref[ValueSymbolLink]) returns ref[ValueSymbolExtra]
    {
        if links.extra <> null
            return links.extra as ref[ValueSymbolExtra]
        let made &ValueSymbolExtra^host(null, null, null, null, null, null, null, null, null)
        set links.extra: made
        made
    }

    ; the link's extra record for a READ: the shared empty one when there is none
    function value_symbol_extra_read(this, links: ref[ValueSymbolLink]) returns ref[ValueSymbolExtra]
    {
        if links.extra <> null
            return links.extra as ref[ValueSymbolExtra]
        empty_value_symbol_extra
    }

    ; the symbol's value link, in a flat array indexed by its ordinal (slice 338)
    ; A scanner over `b`'s text that belongs to THIS checker (slice 363): the
    ; reference scans a token range with a fresh scanner per question; the port
    ; borrowed the binder's own, which parallel checkers would share (and scanning
    ; can allocate on its page). One per checker, pointed at the file it asks about.
    procedure scanner_for(this, b: ref[Binder]) returns ref[Scanner]
    {
        if error_scanner = null
        {
            let made &Scanner^host()
            set this.error_scanner: made
        }
        let sc error_scanner as ref[Scanner]
        var same false
        if error_scanner_binder <> null
        {
            if (error_scanner_binder as ref[Binder]) = b
                set same: true
        }
        if same = false
        {
            let own b.trivia
            sc.retarget(own.buffer, own.language_variant_jsx())
            set this.error_scanner_binder: b
        }
        sc
    }

    ; `c.symbolReferenceLinks.Get(symbol).referenceKinds`, 0 for a symbol never
    ; referenced
    function reference_kinds_of(this, sym: ref[Symbol]) returns int
    {
        let ord sym.link_ordinal as int
        if ord >= (symbol_reference_kinds.get_length() as int)
            return 0
        let kinds: u32 symbol_reference_kinds[ord as size_t]
        kinds as int
    }

    ; `… .referenceKinds |= meaning`: a meaning is added and never taken away
    procedure add_reference_kinds(this, sym: ref[Symbol], meaning: int)
    {
        let ord sym.link_ordinal as int
        while (symbol_reference_kinds.get_length() as int) <= ord
            symbol_reference_kinds.add(0 as u32)
        let kinds: u32 symbol_reference_kinds[ord as size_t]
        symbol_reference_kinds.put(ord as size_t, kinds | (meaning as u32))
    }

    procedure value_symbol_link_of(this, sym: ref[Symbol]) returns ref[ValueSymbolLink]
    {
        let ord sym.link_ordinal as int
        while (value_symbol_links.get_length() as int) <= ord
            value_symbol_links.add(null)
        let row value_symbol_links[ord as size_t]
        if row <> null
            return row as ref[ValueSymbolLink]
        let made &ValueSymbolLink^host()
        value_symbol_links.put(ord as size_t, made)
        made
    }

    ; ── c.typeNodeLinks (slice 80) ──────────────────────────────────────────
    ;
    ; The two above, keyed on a NODE. `typeNodeLinks.Get(node)` mints on miss, so
    ; the caller reads and writes one row and never tests for absence.
    ;
    ; The four node-keyed tables below are flat arrays indexed by the node's link
    ; ordinal (slice 339), which the node hands out on the first ask
    ; (AstNode.link_ordinal_of). They shared an AddressIndex on the node's ADDRESS
    ; until then, and `symbol_node_link_of` alone was 86 % of one unit's samples
    ; (§3.37) — 30 million hash probes over the whole of VS Code. One ordinal
    ; serves all four, so a node that has one row occupies a null slot in the
    ; other three; that is what makes the four arrays cheaper than four indexes.
    ; the checker's own dense index of a node, minted on the first ask
    procedure node_local_of(this, node: ref[AstNode]) returns int
    {
        let ord AstNode.link_ordinal_of(node)
        if node_local_on = false
            return ord
        let table node_local
        while (table.get_length() as int) <= ord
            table.add(0 as u32)
        let cur: u32 table[ord as size_t]
        if cur <> (0 as u32)
            return (cur as int) - 1
        let fresh node_local_count
        set node_local_count: fresh + 1
        table.put(ord as size_t, (fresh + 1) as u32)
        fresh
    }

    procedure type_node_link_of(this, node: ref[AstNode]) returns ref[TypeNodeLink]
    {
        let ord this.node_local_of(node)
        while (type_node_links.get_length() as int) <= ord
            type_node_links.add(null)
        let row type_node_links[ord as size_t]
        if row <> null
            return row as ref[TypeNodeLink]
        let made &TypeNodeLink^host()
        type_node_links.put(ord as size_t, made)
        made
    }

    ; c.nodeLinks.Get(node) — the same mint-on-miss reader over the fourth table.
    procedure node_link_of(this, node: ref[AstNode]) returns ref[NodeLink]
    {
        let ord this.node_local_of(node)
        while (node_links.get_length() as int) <= ord
            node_links.add(null)
        let row node_links[ord as size_t]
        if row <> null
            return row as ref[NodeLink]
        let made &NodeLink^host()
        node_links.put(ord as size_t, made)
        made
    }

    ; c.symbolNodeLinks.Get(node) — the same mint-on-miss reader a SIXTH time
    ; (slice 91).
    procedure symbol_node_link_of(this, node: ref[AstNode]) returns ref[SymbolNodeLink]
    {
        let ord this.node_local_of(node)
        while (symbol_node_links.get_length() as int) <= ord
            symbol_node_links.add(null)
        let row symbol_node_links[ord as size_t]
        if row <> null
            return row as ref[SymbolNodeLink]
        let made &SymbolNodeLink^host()
        symbol_node_links.put(ord as size_t, made)
        made
    }

    ; c.aliasSymbolLinks.Get(symbol) — the same mint-on-miss reader a SEVENTH time
    ; (slice 110).
    procedure alias_symbol_link_of(this, sym: ref[Symbol]) returns ref[AliasSymbolLink]
    {
        let ix alias_symbol_links_index
        let at ix.find(sym as int)
        if at > 0
        {
            let row alias_symbol_links[at - 1]
            if row <> null
                return row as ref[AliasSymbolLink]
        }
        let made &AliasSymbolLink^host(sym)
        alias_symbol_links.add(made)
        ix.insert(sym as int, (alias_symbol_links.get_length() as int) - 1)
        made
    }

    ; c.moduleSymbolLinks.Get(symbol) — an EIGHTH time.
    procedure module_symbol_link_of(this, sym: ref[Symbol]) returns ref[ModuleSymbolLink]
    {
        let ix module_symbol_links_index
        let at ix.find(sym as int)
        if at > 0
        {
            let row module_symbol_links[at - 1]
            if row <> null
                return row as ref[ModuleSymbolLink]
        }
        let made &ModuleSymbolLink^host(sym)
        module_symbol_links.add(made)
        ix.insert(sym as int, (module_symbol_links.get_length() as int) - 1)
        made
    }

    ; c.membersAndExportsLinks.Get(symbol) and c.lateBoundLinks.Get(symbol) — an
    ; ELEVENTH and TWELFTH time (slice 129).
    procedure members_and_exports_link_of(this, sym: ref[Symbol]) returns ref[MembersAndExportsLink]
    {
        let ix members_and_exports_links_index
        let at ix.find(sym as int)
        if at > 0
        {
            let row members_and_exports_links[at - 1]
            if row <> null
                return row as ref[MembersAndExportsLink]
        }
        let made &MembersAndExportsLink^host(sym)
        members_and_exports_links.add(made)
        ix.insert(sym as int, (members_and_exports_links.get_length() as int) - 1)
        made
    }

    procedure late_bound_link_of(this, sym: ref[Symbol]) returns ref[LateBoundLink]
    {
        let ix late_bound_links_index
        let at ix.find(sym as int)
        if at > 0
        {
            let row late_bound_links[at - 1]
            if row <> null
                return row as ref[LateBoundLink]
        }
        let made &LateBoundLink^host(sym)
        late_bound_links.add(made)
        ix.insert(sym as int, (late_bound_links.get_length() as int) - 1)
        made
    }

    ; c.jsxElementLinks.Get(node) and c.sourceFileLinks.Get(file) — a NINTH and
    ; TENTH time (slice 119). ★The first is keyed on a JSX node OR on a source
    ; FILE node: getJsxNamespaceContainerForImplicitImport reads the file's row out
    ; of the same table, which is upstream's own arrangement and not a fold.
    procedure jsx_element_link_of(this, node: ref[AstNode]) returns ref[JsxElementLink]
    {
        let ix jsx_element_links_index
        let at ix.find(node as int)
        if at > 0
        {
            let row jsx_element_links[at - 1]
            if row <> null
                return row as ref[JsxElementLink]
        }
        let made &JsxElementLink^host(node)
        jsx_element_links.add(made)
        ix.insert(node as int, (jsx_element_links.get_length() as int) - 1)
        made
    }

    procedure source_file_link_of(this, node: ref[AstNode]) returns ref[SourceFileLink]
    {
        let ix source_file_links_index
        let at ix.find(node as int)
        if at > 0
        {
            let row source_file_links[at - 1]
            if row <> null
                return row as ref[SourceFileLink]
        }
        let made &SourceFileLink^host(node)
        source_file_links.add(made)
        ix.insert(node as int, (source_file_links.get_length() as int) - 1)
        made
    }

    ; getResolvedSymbol, whole — and it is the function slice 79 named as the one
    ; caller it could not wire.
    ;
    ; ★★★ THE MESSAGE IS A CONSTANT AND THAT IS EXACT, NOT A SHORTCUT.
    ; `getCannotFindNameDiagnosticForName` picks among five codes by the identifier's
    ; TEXT, and every one of them is read in exactly one place: the
    ; onFailedToResolveSymbol callback, which is a STOP here (see resolve_name's
    ; tail for why it must be). resolve_name asks the message only as `<> 0`. So
    ; porting the text switch would be machinery whose one reader is unported —
    ; §3.5be's forbidden shape — and the honest form is the default code with this
    ; sentence beside it. ★It expires the day the globals table lands, and then the
    ; five-way fork is part of that slice rather than a fossil in this one.
    ;
    ; ★★★ isUse IS PASSED TRUE AND ITS ONLY CONSUMER IS SKIPPED. The reference
    ; passes `!IsWriteOnlyAccess(node)`; the flag's whole effect inside Resolve is
    ; the `SymbolReferenced` write, which resolve_name skips with the enumeration
    ; that proves it unobservable. So neither IsWriteOnlyAccess nor the flag can
    ; change an answer here, and a predicate with no reader is not ported.
    procedure get_resolved_symbol(this, node: ref[AstNode]) returns ref[Symbol]
    {
        let links this.symbol_node_link_of(node)
        if links.resolved_symbol = null
        {
            var sym: ref[Symbol]? null
            if Binder.node_is_missing(node) = false
                set sym: this.resolve_name(node, AstNode.identifier_text_of(node), SymbolFlagsValue | SymbolFlagsExportValue, this.get_cannot_find_name_diagnostic_for_name(node), Checker.is_write_only_access(node) = false, false)
            if sym = null
                set sym: unknown_symbol
            set links.resolved_symbol: sym
        }
        links.resolved_symbol as ref[Symbol]
    }

    ; ── slice 113: getCannotFindNameDiagnosticForName, whole ─────────────────
    ;
    ; ★★★ IT WAS A CONSTANT UNTIL THE LIB, AND THE CONSTANT WAS WRONG. This site
    ; passed `DiagCannot_find_name_0` because the callee STOPPED before it could
    ; use the code; with the report live the table decides which of nine codes the
    ; unit gets, and `console` — the first name anyone tries — is TS2584 and not
    ; TS2304. ★A message chosen by the CALLER and consumed three functions down is
    ; exactly the shape §3.5ae names: a value that is invisible while the reader
    ; is a stop.
    ;
    ; ★ `UsesWildcardTypes()` is `slices.Contains(options.Types, "*")` and this
    ; port has no options record, so it is FALSE and each of its four forks takes
    ; the second, longer message. Written as the constant with the reading named,
    ; the way every other unset option in this file is.
    function get_cannot_find_name_diagnostic_for_name(this, node: ref[AstNode]) returns int
    {
        let t AstNode.identifier_text_of(node)
        if Checker.name_bytes_are(t, "document")
