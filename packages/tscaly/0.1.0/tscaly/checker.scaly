            let fresh_buckets AddressIndex.fresh_buckets(host, new_cap)
            set resolution_memo_buckets: fresh_buckets
            AddressIndex.release_buckets(host, old_resolution_memo_buckets)
            set resolution_memo_mask: new_cap - 1
            set first: 0
        }
        let v resolution_memo_buckets as ref[Vector[int]]
        var j first
        while j < count
        {
            let r rows[j as size_t] as ref[ResolutionMemo]
            var slot Checker.resolution_memo_hash(r.importing_index, r.mode, r.name) & resolution_memo_mask
            while true
            {
                let e v.get(slot as size_t)
                if e = null
                    break
                if *e = 0
                {
                    v.put(slot as size_t, j + 1)
                    break
                }
                set slot: (slot + 1) & resolution_memo_mask
            }
            set j: j + 1
        }
        memo
    }

    ; resolveExternalModule (slice 264: whole but for project references): the
    ; resolution, its resolution diagnostic, the file it names when the program
    ; holds it, the TS-extension and CommonJS/ESM reports, the pattern ambient
    ; modules, an untyped module, and the not-found fork with its extension hints
    procedure resolve_external_module(this, location: ref[AstNode]?, d: Slice[char], module_not_found_error: int, error_node: ref[AstNode]?, is_for_augmentation: bool) returns ref[Symbol]?
    {
        if error_node <> null
        {
            if d.length > 7
            {
                if Checker.name_bytes_are(d.subslice(0, 7), "@types/")
                    this.error_on_node(error_node, DiagCannot_import_type_declaration_files_Consider_importing_0_instead_of_1, Checker.arg_text(d.slice_from(7)), Checker.arg_text(d))
            }
        }
        let ambient this.try_find_ambient_module(d, true)
        if ambient <> null
            return ambient
        var resolved_index 0 - 1
        var resolution_diagnostic 0
        var mode ModuleKindNone
        var importing_index 0 - 1
        var resolved_ext: Slice[char] ""
        var resolved_using_ts_extension false
        var in_program_index 0 - 1
        var resolved_package_key Slice[char]()
        var alternate_result Slice[char]()
        if program <> null
        {
            let pf program as ref[ProgramFiles]
            set importing_index: this.program_index_of_node(location)
            if importing_index < 0
                set importing_index: pf.index_of_file(file)
            ; program.GetResolvedModule: only a name the file loader resolved for
            ; the file (an import inside a module augmentation is not collected)
            if importing_index >= 0
            {
                if pf.has_resolution(importing_index, d) = false
                    set importing_index: 0 - 1
            }
            if importing_index >= 0
            {
                ; the containing path is built lazily in ProgramFiles: under
                ; enter_shared (slice 366, found by --write-report's frozen mode)
                enter_shared()
                let containing_path pf.resolution_containing_path(importing_index)
                leave_shared()
                set mode: this.usage_mode_of(location, pf.format_at(importing_index))
                let memo this.resolution_memo_for(pf, importing_index, d, mode, containing_path)
                set resolved_index: memo.resolved_index
                set resolved_package_key: memo.package_id
                set alternate_result: memo.alternate_result
                if (memo.stop_tag.length as int) > 0
                {
                    this.record_unported(memo.stop_tag, 0)
                    return null
                }
                if resolved_index >= 0
                {
                    let rpath pf.path_at(resolved_index)
                    set resolved_ext: Checker.resolution_extension_for(rpath, memo.arbitrary_extension)
                    set resolved_using_ts_extension: memo.using_ts_extension
                    if error_node <> null
                        set resolution_diagnostic: this.get_resolution_diagnostic(resolved_ext, pf.path_at(importing_index))
                    if (resolution_diagnostic = 0) or (resolution_diagnostic = DiagModule_0_was_resolved_to_1_but_jsx_is_not_set)
                    {
                        ; GetSourceFileForResolvedModule: a deduplicated package's
                        ; second instance answers the first one's file
                        let target_index pf.redirect_target_of(resolved_index)
                        if this.program_holds_file(pf, target_index)
                            set in_program_index: target_index
                    }
                }
            }
        }
        if in_program_index >= 0
        {
            let pf program as ref[ProgramFiles]
            let sf pf.file_at(in_program_index) as ref[AstNode]
            if resolution_diagnostic <> 0
                this.error_on_node(error_node as ref[AstNode], resolution_diagnostic, Checker.arg_text(d), Checker.arg_text(pf.path_at(resolved_index)))
            if error_node <> null
            {
                let en error_node as ref[AstNode]
                let emittable Checker.find_emittable_import_ancestor(location)
                if resolved_using_ts_extension and is_declaration_file_name_of(d)
                {
                    if emittable <> null
                        this.error_on_node(en, DiagA_declaration_file_cannot_be_imported_without_import_type_Did_you_mean_to_import_an_implementation_file_0_instead, this.get_suggested_import_source(d, Checker.try_extract_ts_extension(d), mode))
                }
                else
                {
                    if resolved_using_ts_extension and (Checker.allow_importing_ts_extensions_from(pf.path_at(importing_index)) = false)
                    {
                        if emittable <> null
                            this.error_on_node(en, DiagAn_import_path_can_only_end_with_a_0_extension_when_allowImportingTsExtensions_is_enabled, Checker.arg_text(Checker.try_extract_ts_extension(d)))
                    }
                    else
                    {
                        if checker_rewrite_relative_import_extensions and ((AstNode.flags_of(location as ref[AstNode]) & NodeFlagsAmbient) = 0) and (is_declaration_file_name_of(d) = false)
                        {
                            let literal_import_type Checker.is_literal_import_type_node(location)
                            let type_only Checker.find_type_only_import_or_export_ancestor(location) <> null
                            if (literal_import_type = false) and (type_only = false)
                            {
                                let should_rewrite Checker.should_rewrite_module_specifier(d)
                                if (resolved_using_ts_extension = false) and should_rewrite
                                {
                                    let importing_path pf.path_at(importing_index)
                                    let relative_path get_relative_path_to_directory_or_url(host, get_directory_path(host, importing_path), pf.path_at(resolved_index), false, Slice[char]())
                                    var relative_text StringBuilder()
                                    if (is_rooted_disk_path(relative_path) = false) and (relative_path.starts_with("./") = false) and (relative_path.starts_with("../") = false)
                                        relative_text.append("./")
                                    relative_text.append(relative_path.data, relative_path.length)
                                    this.error_on_node(en, DiagThis_relative_import_path_is_unsafe_to_rewrite_because_it_looks_like_a_file_name_but_actually_resolves_to_0, relative_text.to_string())
                                }
                                else
                                {
                                    if resolved_using_ts_extension and (should_rewrite = false)
                                    {
                                        if Checker.source_file_may_be_emitted(pf.path_at(in_program_index))
                                            this.error_on_node(en, DiagThis_import_uses_a_0_extension_to_resolve_to_an_input_TypeScript_file_but_will_not_be_rewritten_during_emit_because_it_is_not_a_relative_path, Checker.arg_text(Checker.any_extension_of(d)))
                                    }
                                    ; GetRedirectForResolution: an import of another project whose
                                    ; outputs do not sit where its inputs do, relatively
                                    if resolved_using_ts_extension and should_rewrite
                                    {
                                        if pf.reference_rewrite_unsafe_of(in_program_index)
                                            this.error_on_node(en, DiagThis_import_path_is_unsafe_to_rewrite_because_it_resolves_to_another_project_and_the_relative_path_between_the_projects_output_files_is_not_the_same_as_the_relative_path_between_its_input_files)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            let file_symbol AstNode.symbol_of(sf)
            if file_symbol <> null
            {
                if error_node <> null
                {
                    let en error_node as ref[AstNode]
                    if slice_contains_node_modules(pf.path_at(in_program_index)) and (Checker.resolution_extension_is_ts_or_json(resolved_ext) = false)
                        this.error_on_implicit_any_module(false, en, d, pf.path_at(in_program_index), importing_index, mode, Slice[char]())
                    if (module_kind = ModuleKindNode16) or (module_kind = ModuleKindNode18)
                        this.check_cjs_importing_esm(location, en, pf, importing_index, in_program_index, d)
                }
                return this.get_merged_symbol(file_symbol)
            }
            if (error_node <> null) and (module_not_found_error <> 0) and (Checker.is_side_effect_import(error_node) = false)
                this.error_on_node(error_node as ref[AstNode], DiagFile_0_is_not_a_module, Checker.arg_text((program as ref[ProgramFiles]).path_at(in_program_index)))
            return null
        }
        ; the pattern ambient modules (`declare module "foo*baz"`): the best match
        ; is the one with the longest prefix before its `*` (core.FindBestPatternMatch)
        let pattern this.find_best_pattern_ambient_module(d)
        if pattern <> null
        {
            var pai 0
            while pai < (pattern_augmentation_names.get_length() as int)
            {
                let pan pattern_augmentation_names[pai as size_t]
                if pan.equals(d)
                    return this.get_merged_symbol(pattern_augmentation_symbols[pai as size_t])
                set pai: pai + 1
            }
            return this.get_merged_symbol(pattern)
        }
        if error_node = null
            return null
        let en error_node as ref[AstNode]
        var resolved_file_name String("")
        if resolved_index >= 0
            set resolved_file_name: Checker.arg_text((program as ref[ProgramFiles]).path_at(resolved_index))
        var untyped false
        if (resolved_index >= 0) and (Checker.resolution_extension_is_ts_or_json(resolved_ext) = false) and (resolution_diagnostic = 0)
            set untyped: true
        if resolution_diagnostic = DiagCould_not_find_a_declaration_file_for_module_0_1_implicitly_has_an_any_type
            set untyped: true
        if untyped
        {
            if is_for_augmentation
                this.error_on_node(en, DiagInvalid_module_name_in_augmentation_Module_0_resolves_to_an_untyped_module_at_1_which_cannot_be_augmented, Checker.arg_text(d), resolved_file_name)
            else
                this.error_on_implicit_any_module(Checker.no_implicit_any() and (module_not_found_error <> 0), en, d, Slice[char](resolved_file_name.get_length() as int, resolved_file_name.get_buffer() as pointer[char]), importing_index, mode, resolved_package_key)
            return null
        }
        if module_not_found_error <> 0
        {
            ; a project reference redirect whose output was not built
            if (resolved_index >= 0) and (program <> null)
            {
                let rpf program as ref[ProgramFiles]
                let output rpf.reference_output_of(resolved_index)
                if (output.length as int) > 0
                {
                    this.error_on_node(en, DiagOutput_file_0_has_not_been_built_from_source_file_1, Checker.arg_text(output), resolved_file_name)
                    return null
                }
            }
            if resolution_diagnostic <> 0
            {
                this.error_on_node(en, resolution_diagnostic, Checker.arg_text(d), resolved_file_name)
                return null
            }
            let extensionless_relative Checker.specifier_is_extensionless_relative(d)
            let node16_or_next (module_resolution_kind = ModuleResolutionKindNode16) or (module_resolution_kind = ModuleResolutionKindNodeNext)
            if (resolve_json_module = false) and d.ends_with(".json")
            {
                this.error_on_node(en, DiagCannot_find_module_0_Consider_using_resolveJsonModule_to_import_module_with_json_extension, Checker.arg_text(d))
                return null
            }
            if (mode = ModuleKindESNext) and node16_or_next and extensionless_relative and (importing_index >= 0)
            {
                let pf program as ref[ProgramFiles]
                let absolute get_normalized_absolute_path(host, d, get_directory_path(host, pf.path_at(importing_index)))
                let suggested_ext this.suggested_import_extension(pf, absolute)
                if (suggested_ext.length as int) > 0
                {
                    var with_ext StringBuilder()
                    with_ext.append(d.data, d.length)
                    with_ext.append(suggested_ext.data, suggested_ext.length)
                    this.error_on_node(en, DiagRelative_import_paths_need_explicit_file_extensions_in_ECMAScript_imports_when_moduleResolution_is_node16_or_nodenext_Did_you_mean_0, with_ext.to_string())
                }
                else
                    this.error_on_node(en, DiagRelative_import_paths_need_explicit_file_extensions_in_ECMAScript_imports_when_moduleResolution_is_node16_or_nodenext_Consider_adding_an_extension_to_the_import_path)
                return null
            }
            if (alternate_result.length as int) > 0
            {
                ; createModuleNotFoundChain under the not-found message
                let dl diagnostics as ref[DiagnosticList]
                let before dl.length()
                this.error_on_node(en, module_not_found_error, Checker.arg_text(d))
                this.add_module_not_found_chain(dl, before, importing_index, d, mode, d)
                return null
            }
            this.error_on_node(en, module_not_found_error, Checker.arg_text(d))
        }
        null
    }

    ; checker.createModuleNotFoundChain as the chain line of the diagnostic at `at`,
    ; with its RepopulateModuleNotFound info
    procedure add_module_not_found_chain(this, dl: ref[DiagnosticList], at: int, importing_index: int, module_reference: Slice[char], mode: int, package_name: Slice[char])
    {
        if dl.length() <= at
            return
        if program = null
            return
        let pf program as ref[ProgramFiles]
        let args this.message_args()
        let code this.module_not_found_details(pf, importing_index, module_reference, mode, package_name, args)
        let info this.message_args()
        info.add(String^host(Checker.arg_text(module_reference)))
        var mode_text StringBuilder()
        if mode > 0
            mode_text.append(mode)
        info.add(String^host(mode_text.to_string()))
        if package_name.equals(module_reference)
            info.add(String^host(""))
        else
            info.add(String^host(Checker.arg_text(package_name)))
        dl.add_chain_line_with_info(at, 1, code, args, info)
    }

    ; CreateModuleNotFoundChain: the message code, its arguments into `out_args`
    procedure module_not_found_details(this, pf: ref[ProgramFiles], importing_index: int, module_reference: Slice[char], mode: int, package_name_in: Slice[char], out_args: ref[Array[String]]) returns int
    {
        var package_name package_name_in
        var alternate Slice[char]()
        ; program.GetResolvedModule(file, moduleReference, mode).AlternateResult
        if importing_index >= 0
        {
            if pf.has_resolution(importing_index, module_reference)
            {
                ; the resolution fills ProgramFiles' lazy caches: under
                ; enter_shared, as resolution_memo_for (slice 366)
                enter_shared()
                let resolver ModuleResolver.create(host, pf, module_resolution_kind, resolve_json_module, mode, allow_js, resolve_package_json_exports, resolve_package_json_imports, out_dir, root_dir)
                pf.apply_redirect_paths(importing_index, resolver)
                resolver.resolve(module_reference, pf.resolution_containing_path(importing_index))
                leave_shared()
                set alternate: resolver.alternate_result
            }
        }
        let mangled mangle_scoped_package_name(host, package_name)
        if (alternate.length as int) > 0
        {
            if index_of_literal(alternate, "/node_modules/@types/") >= 0
                set package_name: join_slices(host, "@types/", mangled)
            out_args.add(String^host(Checker.arg_text(alternate)))
            out_args.add(String^host(Checker.arg_text(package_name)))
            return DiagThere_are_types_at_0_but_this_result_could_not_be_resolved_when_respecting_package_json_exports_The_1_library_may_need_to_update_its_package_json_or_typings
        }
        if pf.package_map_state(join_slices(host, "@types/", mangled)) > 0
        {
            out_args.add(String^host(Checker.arg_text(package_name)))
            out_args.add(String^host(Checker.arg_text(mangled)))
            return DiagIf_the_0_package_actually_exposes_this_module_consider_sending_a_pull_request_to_amend_https_Colon_Slash_Slashgithub_com_SlashDefinitelyTyped_SlashDefinitelyTyped_Slashtree_Slashmaster_Slashtypes_Slash_1
        }
        if pf.package_map_state(package_name) = 2
        {
            out_args.add(String^host(Checker.arg_text(package_name)))
            out_args.add(String^host(Checker.arg_text(module_reference)))
            return DiagIf_the_0_package_actually_exposes_this_module_try_adding_a_new_declaration_d_ts_file_containing_declare_module_1
        }
        out_args.add(String^host(Checker.arg_text(module_reference)))
        out_args.add(String^host(Checker.arg_text(mangled)))
        DiagTry_npm_i_save_dev_types_Slash_1_if_it_exists_or_add_a_new_declaration_d_ts_file_containing_declare_module_0
    }

    ; GetProjectReferenceFromOutputDts(file of the declaration).Resolved's
    ; ShouldPreserveConstEnums (false without a redirect)
    function redirect_preserves_const_enums(this, declaration: ref[AstNode]) returns bool
    {
        if program = null
            return false
        let pf program as ref[ProgramFiles]
        let index pf.index_of_file(Checker.source_file_of_node(declaration))
        pf.reference_dts_preserve_of(index) = 1
    }

    ; errorOnImplicitAnyModule: TS7016 when it is an error (a suggestion otherwise)
    procedure error_on_implicit_any_module(this, is_error: bool, error_node: ref[AstNode], module_reference: Slice[char], resolved_file_name: Slice[char], importing_index: int, mode: int, package_key: Slice[char])
    {
        if Checker.is_side_effect_import(error_node)
            return
        if is_error = false
            return
        let dl diagnostics as ref[DiagnosticList]
        let before dl.length()
        this.error_on_node(error_node, DiagCould_not_find_a_declaration_file_for_module_0_1_implicitly_has_an_any_type, Checker.arg_text(module_reference), Checker.arg_text(resolved_file_name))
        ; a package's resolution: createModuleNotFoundChain under the message
        if is_external_module_name_relative(module_reference)
            return
        var end 0
        while (end < (package_key.length as int)) and ((package_key[end as size_t] as int) <> ("|" as char) as int)
            set end: end + 1
        if end = 0
            return
        this.add_module_not_found_chain(dl, before, importing_index, module_reference, mode, package_key.subslice(0, end as size_t))
    }

    ; tspath.TryExtractTSExtension
    function try_extract_ts_extension(d: Slice[char]) returns Slice[char]
    {
        if d.ends_with(".d.ts")
            return ".d.ts"
        if d.ends_with(".d.cts")
            return ".d.cts"
        if d.ends_with(".d.mts")
            return ".d.mts"
        if d.ends_with(".ts")
            return ".ts"
        if d.ends_with(".tsx")
            return ".tsx"
        if d.ends_with(".mts")
            return ".mts"
        if d.ends_with(".cts")
            return ".cts"
        ""
    }

    ; tspath.GetAnyExtensionFromPath(path, nil, false): the extension of the base name
    function any_extension_of(d: Slice[char]) returns Slice[char]
    {
        var i (d.length as int) - 1
        while i >= 0
        {
            let ch d[i as size_t] as int
            if ch = ("/" as char) as int
                return ""
            if ch = ("." as char) as int
            {
                if i = 0
                    return ""
                return d.slice_from(i as size_t)
            }
            set i: i - 1
        }
        ""
    }

    ; resolveExternalModule's node16/node18 arm: a synchronous import of an ES module
    ; from a CommonJS file
    procedure check_cjs_importing_esm(this, location: ref[AstNode]?, error_node: ref[AstNode], pf: ref[ProgramFiles], importing_index: int, resolved_index: int, module_reference: Slice[char])
    {
        let import_call Checker.find_import_call_ancestor(location)
        let import_equals Checker.find_ancestor_kind(location, KindImportEqualsDeclaration)
        var is_sync_import false
        if (pf.format_at(importing_index) = ModuleKindCommonJS) and (import_call = null)
            set is_sync_import: true
        if import_equals <> null
            set is_sync_import: true
        if is_sync_import = false
            return
        if pf.format_at(resolved_index) <> ModuleKindESNext
            return
        let override_host Checker.find_resolution_mode_override_host(location)
        if this.has_resolution_mode_override(override_host)
            return
        if import_equals <> null
        {
            this.error_on_node(error_node, DiagModule_0_cannot_be_imported_using_this_construct_The_specifier_only_resolves_to_an_ES_module_which_cannot_be_imported_with_require_Use_an_ECMAScript_import_instead, Checker.arg_text(module_reference))
            return
        }
        var code DiagThe_current_file_is_a_CommonJS_module_whose_imports_will_produce_require_calls_however_the_referenced_file_is_an_ECMAScript_module_and_cannot_be_imported_with_require_Consider_writing_a_dynamic_import_0_call_instead
        if override_host <> null
        {
            let host_node override_host as ref[AstNode]
            if host_node.kind = KindImportDeclaration
            {
                let clause AstNode.import_clause_of(host_node)
                if clause <> null
                {
                    if AstNode.is_type_only_of(clause)
                        set code: DiagType_only_import_of_an_ECMAScript_module_from_a_CommonJS_module_must_have_a_resolution_mode_attribute
                }
            }
            if host_node.kind = KindImportType
                set code: DiagType_import_of_an_ECMAScript_module_from_a_CommonJS_module_must_have_a_resolution_mode_attribute
        }
        let dl diagnostics as ref[DiagnosticList]
        let before dl.length()
        this.error_on_node(error_node, code, Checker.arg_text(module_reference))
        ; createModeMismatchDetails for a .ts/.js/.tsx/.jsx importing file
        let importing_path pf.path_at(importing_index)
        var target_ext Slice[char]()
        if importing_path.ends_with(".ts") and (importing_path.ends_with(".d.ts") = false)
            set target_ext: ".mts"
        if importing_path.ends_with(".js")
            set target_ext: ".mjs"
        var details_apply (target_ext.length as int) > 0
        if importing_path.ends_with(".tsx") or importing_path.ends_with(".jsx")
            set details_apply: true
        if (details_apply = false) or (dl.length() <= before)
            return
        let h host
        let package_type pf.package_json_type_at(importing_index)
        enter_shared()
        let package_directory pf.package_json_directory_of(h, importing_path)
        leave_shared()
        let ext_arg String^h(Checker.arg_text(target_ext))
        if ((package_directory.length as int) > 0) and ((package_type.length as int) = 0)
        {
            let package_json_arg String^h(Checker.arg_text(combine_paths(h, package_directory, "package.json")))
            let with_json this.message_args()
            if (target_ext.length as int) > 0
            {
                with_json.add(ext_arg)
                with_json.add(package_json_arg)
                dl.add_chain_line_at(before, 1, 1481, with_json)
            }
            else
            {
                with_json.add(package_json_arg)
                dl.add_chain_line_at(before, 1, 1482, with_json)
            }
            return
        }
        if (target_ext.length as int) > 0
        {
            let with_ext this.message_args()
            with_ext.add(ext_arg)
            dl.add_chain_line_at(before, 1, 1480, with_ext)
        }
        else
            dl.add_chain_line_at(before, 1, 1483, null)
    }

    ; ast.FindAncestor(node, ast.IsEmittableImport)
    function find_emittable_import_ancestor(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var p node
        while p <> null
        {
            let q p as ref[AstNode]
            if q.kind = KindImportDeclaration
            {
                let clause AstNode.import_clause_of(q)
                if clause <> null
                {
                    if AstNode.is_type_only_of(clause) = false
                        return q
                }
            }
            if (q.kind = KindExportDeclaration) or (q.kind = KindImportEqualsDeclaration)
            {
                if AstNode.is_type_only_of(q) = false
                    return q
            }
            if q.kind = KindCallExpression
            {
                if AstNode.is_import_call(q)
                    return q
            }
            set p: AstNode.parent_node_of(q)
        }
        null
    }

    function find_type_only_import_or_export_ancestor(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var p node
        while p <> null
        {
            let q p as ref[AstNode]
            if Checker.is_type_only_import_or_export_declaration(q)
                return q
            set p: AstNode.parent_node_of(q)
        }
        null
    }

    function find_import_call_ancestor(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var p node
        while p <> null
        {
            let q p as ref[AstNode]
            if q.kind = KindCallExpression
            {
                if AstNode.is_import_call(q)
                    return q
            }
            set p: AstNode.parent_node_of(q)
        }
        null
    }

    function find_resolution_mode_override_host(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var p node
        while p <> null
        {
            if Checker.is_resolution_mode_override_host(p)
                return p
            set p: AstNode.parent_node_of(p as ref[AstNode])
        }
        null
    }

    function is_resolution_mode_override_host(n: ref[AstNode]?) returns bool
    {
        let k Checker.kind_or_unknown(n)
        (k = KindImportType) or (k = KindExportDeclaration) or (k = KindImportDeclaration) or (k = KindJSImportDeclaration)
    }

    ; getModeForUsageLocation's two override readings of a module specifier
    function resolution_mode_override_for_usage(this, usage: ref[AstNode]) returns int
        Checker.resolution_mode_override_of(usage)

    ; the reference reads the override through `Attributes.GetResolutionModeOverride()`,
    ; which does NOT report — the reporting twin is the checker's grammar check. So
    ; this half is pure and the file loader may ask it.
    function resolution_mode_override_of(usage: ref[AstNode]) returns int
    {
        let parent AstNode.parent_node_of(usage)
        if parent = null
            return ModuleKindNone
        let pn parent as ref[AstNode]
        let pk AstNode.kind_of(pn)
        if (pk = KindImportDeclaration) or (pk = KindJSImportDeclaration) or (pk = KindExportDeclaration)
        {
            if Checker.is_exclusively_type_only_import_or_export(pn)
            {
                let attributes AstNode.import_attributes_of(pn)
                if attributes <> null
                    return Checker.resolution_mode_override_quiet(attributes as ref[AstNode])
            }
            return ModuleKindNone
        }
        if pk = KindLiteralType
        {
            let gp AstNode.parent_node_of(pn)
            if Checker.kind_or_unknown(gp) = KindImportType
            {
                let attributes AstNode.import_type_attributes_of(gp)
                if attributes <> null
                    return Checker.resolution_mode_override_quiet(attributes as ref[AstNode])
            }
        }
        ModuleKindNone
    }

    ; ast.HasResolutionModeOverride
    procedure has_resolution_mode_override(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        var attributes: ref[AstNode]? null
        if n.kind = KindImportType
            set attributes: AstNode.import_type_attributes_of(n)
        else
            set attributes: AstNode.import_attributes_of(n)
        if attributes = null
            return false
        this.get_resolution_mode_override(attributes as ref[AstNode], false) <> ModuleKindNone
    }

    ; the extension a resolution reports (the resolved file's known extension, else
    ; an arbitrary one)
    ; the resolution's extension: `arbitrary` when the resolver found the
    ; `.d<ext>.ts` declaration file of an arbitrary extension
    function resolution_extension_for(path: Slice[char], arbitrary: bool) returns Slice[char]
    {
        if arbitrary
            return ".arbitrary"
        Checker.resolution_extension_of(path)
    }

    function resolution_extension_of(path: Slice[char]) returns Slice[char]
    {
        if path.ends_with(".d.ts")
            return ".d.ts"
        if path.ends_with(".d.mts")
            return ".d.mts"
        if path.ends_with(".d.cts")
            return ".d.cts"
        if path.ends_with(".tsx")
            return ".tsx"
        if path.ends_with(".mts")
            return ".mts"
        if path.ends_with(".cts")
            return ".cts"
        if path.ends_with(".ts")
            return ".ts"
        if path.ends_with(".jsx")
            return ".jsx"
        if path.ends_with(".mjs")
            return ".mjs"
        if path.ends_with(".cjs")
            return ".cjs"
        if path.ends_with(".js")
            return ".js"
        if path.ends_with(".json")
            return ".json"
        ".arbitrary"
    }

    function index_of_text_in(s: Slice[char], t: Slice[char]) returns int
    {
        var i 0
        while i + (t.length as int) <= (s.length as int)
        {
            let piece s.subslice(i as size_t, (i + (t.length as int)) as size_t)
            if piece.equals(t)
                return i
            set i: i + 1
        }
        0 - 1
    }

    function extension_is_ts(ext: Slice[char]) returns bool
    {
        ext.equals(".ts") or ext.equals(".tsx") or ext.equals(".d.ts") or ext.equals(".mts") or ext.equals(".d.mts") or ext.equals(".cts") or ext.equals(".d.cts")
    }

    ; resolutionExtensionIsTSOrJson
    function resolution_extension_is_ts_or_json(ext: Slice[char]) returns bool
    {
        if Checker.extension_is_ts(ext)
            return true
        if ext.equals(".arbitrary")
            return true
        ext.equals(".json")
    }

    ; tspath.TryExtractTSExtension over a specifier
    function ts_extension_of_specifier(d: Slice[char]) returns Slice[char]
    {
        if d.ends_with(".d.ts")
            return ".d.ts"
        if d.ends_with(".d.mts")
            return ".d.mts"
        if d.ends_with(".d.cts")
            return ".d.cts"
        if d.ends_with(".ts")
            return ".ts"
        if d.ends_with(".tsx")
            return ".tsx"
        if d.ends_with(".mts")
            return ".mts"
        if d.ends_with(".cts")
            return ".cts"
        ""
    }

    ; module.GetResolutionDiagnostic
    function get_resolution_diagnostic(this, ext: Slice[char], importing_path: Slice[char]) returns int
    {
        if Checker.extension_is_ts(ext) and (ext.equals(".tsx") = false)
            return 0
        if ext.equals(".tsx")
        {
            if jsx_emit = JsxEmitNone
                return DiagModule_0_was_resolved_to_1_but_jsx_is_not_set
            return 0
        }
        var js false
        if ext.equals(".jsx")
        {
            if jsx_emit = JsxEmitNone
                return DiagModule_0_was_resolved_to_1_but_jsx_is_not_set
            set js: true
        }
        if ext.equals(".js") or ext.equals(".mjs") or ext.equals(".cjs")
            set js: true
        if js
        {
            if allow_js or (checker_no_implicit_any_explicit = false)
                return 0
            return DiagCould_not_find_a_declaration_file_for_module_0_1_implicitly_has_an_any_type
        }
        if ext.equals(".json")
        {
            if resolve_json_module
                return 0
            return DiagModule_0_was_resolved_to_1_but_resolveJsonModule_is_not_used
        }
        if is_declaration_file_name_of(importing_path) or checker_allow_arbitrary_extensions
            return 0
        DiagModule_0_was_resolved_to_1_but_allowArbitraryExtensions_is_not_set
    }

    ; GetSourceFileForResolvedModule: the program holds a parsed file, except a
    ; JavaScript one without allowJs or inside node_modules (maxNodeModuleJsDepth 0)
    function program_holds_file(this, pf: ref[ProgramFiles], index: int) returns bool
    {
        if pf.file_at(index) = null
            return false
        ; the file loader's answer, where one ran (slice 268)
        if pf.members <> null
            return pf.holds(index)
        let path pf.path_at(index)
        let is_js path.ends_with(".js") or path.ends_with(".jsx") or path.ends_with(".mjs") or path.ends_with(".cjs")
        if is_js
        {
            if allow_js = false
                return false
            if slice_contains_node_modules(path)
                return false
        }
        true
    }

    ; getSuggestedImportSource
    function get_suggested_import_source(this, module_reference: Slice[char], ts_extension: Slice[char], mode: int) returns String
    {
        var sb StringBuilder()
        var without module_reference
        if module_reference.ends_with(ts_extension)
            set without: module_reference.subslice(0, module_reference.length - ts_extension.length)
        sb.append(without.data, without.length)
        if ((module_kind >= ModuleKindES2015) and (module_kind <= ModuleKindESNext)) or (mode = ModuleKindESNext)
        {
            let prefer_ts is_declaration_file_name_of(module_reference) and (checker_allow_importing_ts_extensions or checker_rewrite_relative_import_extensions)
            var mjs false
            if ts_extension.equals(".mts") or ts_extension.equals(".d.mts")
                set mjs: true
            var cjs false
            if ts_extension.equals(".cts") or ts_extension.equals(".d.cts")
                set cjs: true
            if mjs
            {
                if prefer_ts
                    sb.append(".mts")
                else
                    sb.append(".mjs")
            }
            if cjs
            {
                if prefer_ts
                    sb.append(".cts")
                else
                    sb.append(".cjs")
            }
            if (mjs = false) and (cjs = false)
            {
                if prefer_ts
                    sb.append(".ts")
                else
                    sb.append(".js")
            }
        }
        sb.to_string()
    }

    function allow_importing_ts_extensions_from(file_name: Slice[char]) returns bool
    {
        ; GetAllowImportingTsExtensions: the option or rewriteRelativeImportExtensions
        if checker_allow_importing_ts_extensions or checker_rewrite_relative_import_extensions
            return true
        is_declaration_file_name_of(file_name)
    }

    ; core.ShouldRewriteModuleSpecifier (the option already asked)
    function should_rewrite_module_specifier(d: Slice[char]) returns bool
    {
        if path_is_relative(d) = false
            return false
        if is_declaration_file_name_of(d)
            return false
        (Checker.ts_extension_of_specifier(d).length as int) > 0
    }

    ; program.SourceFileMayBeEmitted for a resolved input file
    function source_file_may_be_emitted(path: Slice[char]) returns bool
    {
        if is_declaration_file_name_of(path)
            return false
        slice_contains_node_modules(path) = false
    }

    function specifier_is_extensionless_relative(d: Slice[char]) returns bool
    {
        if path_is_relative(d) = false
            return false
        ; tspath.HasExtension: a dot in GetBaseFileName, which drops a trailing separator
        let trimmed remove_trailing_directory_separator(d)
        let slash slice_last_index_of_byte(trimmed, ("/" as char) as int)
        let base trimmed.slice_from((slash + 1) as size_t)
        slice_contains_byte(base, ("." as char) as int) = false
    }

    function is_literal_import_type_node(n: ref[AstNode]?) returns bool
        Checker.kind_or_unknown(n) = KindImportType

    ; ProgramFiles.file_exists under enter_shared (slice 365): the probe fills the
    ; program's path index and watch list
    procedure locked_file_exists(this, pf: ref[ProgramFiles], path: Slice[char]) returns bool
    {
        enter_shared()
        let found pf.file_exists(path)
        leave_shared()
        found
    }

    ; getSuggestedImportExtension
    procedure suggested_import_extension(this, pf: ref[ProgramFiles], p: Slice[char]) returns Slice[char]
    {
        if this.locked_file_exists(pf, join_slices(host, p, ".mts"))
            return ".mjs"
        if this.locked_file_exists(pf, join_slices(host, p, ".ts"))
            return ".js"
        if this.locked_file_exists(pf, join_slices(host, p, ".cts"))
            return ".cjs"
        if this.locked_file_exists(pf, join_slices(host, p, ".mjs"))
            return ".mjs"
        if this.locked_file_exists(pf, join_slices(host, p, ".js"))
            return ".js"
        if this.locked_file_exists(pf, join_slices(host, p, ".cjs"))
            return ".cjs"
        if this.locked_file_exists(pf, join_slices(host, p, ".tsx"))
        {
            if jsx_emit = JsxEmitPreserve
                return ".jsx"
            return ".js"
        }
        if this.locked_file_exists(pf, join_slices(host, p, ".jsx"))
            return ".jsx"
        if this.locked_file_exists(pf, join_slices(host, p, ".json"))
            return ".json"
        ""
    }

    ; resolveExternalModuleNameWorker.
    procedure resolve_external_module_name_worker(this, location: ref[AstNode]?, module_reference_expression: ref[AstNode]?, module_not_found_error: int, ignore_errors: bool, is_for_augmentation: bool) returns ref[Symbol]?
    {
        if module_reference_expression = null
            return null
        let m module_reference_expression as ref[AstNode]
        let k AstNode.kind_of(m)
        var literal_like false
        if k = KindStringLiteral
            set literal_like: true
        if k = KindNoSubstitutionTemplateLiteral
            set literal_like: true
        if literal_like = false
            return null
        var error_node: ref[AstNode]? null
        if ignore_errors = false
            set error_node: m
        this.resolve_external_module(location, AstNode.literal_text_of(m), module_not_found_error, error_node, is_for_augmentation)
    }

    ; resolveExternalModuleName. ★`NoCheck` is unset, so `ignoreErrors` arrives
    ; from the caller alone.
    procedure resolve_external_module_name(this, location: ref[AstNode]?, module_reference_expression: ref[AstNode]?, ignore_errors: bool) returns ref[Symbol]?
    {
        var message this.get_cannot_resolve_module_name_error_for_specific_module(module_reference_expression)
        if message = 0
            set message: DiagCannot_find_module_0_or_its_corresponding_type_declarations
        if ignore_errors
            set message: 0
        this.resolve_external_module_name_worker(location, module_reference_expression, message, ignore_errors, false)
    }

    ; resolveExternalModuleSymbol — a module defined by `export =` is the one
    ; export that has to be resolved before anything else can be asked of it.
    procedure resolve_external_module_symbol(this, module_symbol: ref[Symbol]?, dont_resolve_alias: bool) returns ref[Symbol]?
    {
        if module_symbol = null
            return null
        let ms module_symbol as ref[Symbol]
        var ed Slice[char]()
        set ed: Binder.internal_name_unprefixed(host, "export=")
        let export_equals this.resolve_symbol_ex(SymbolTable.get(Symbol.exports_of(ms), ed), dont_resolve_alias)
        if export_equals <> null
            return this.get_merged_symbol(export_equals)
        module_symbol
    }

    ; ast.IsNonLocalAlias, whole.
    function is_non_local_alias(symbol: ref[Symbol]?, excludes: int) returns bool
    {
        if symbol = null
            return false
        let s symbol as ref[Symbol]
        let f Symbol.flags_of(s)
        if (f & (SymbolFlagsAlias | excludes)) = SymbolFlagsAlias
            return true
        if (f & SymbolFlagsAlias) = 0
            return false
        (f & SymbolFlagsAssignment) <> 0
    }

    ; resolveSymbol / resolveSymbolEx.
    procedure resolve_symbol(this, symbol: ref[Symbol]?) returns ref[Symbol]?
        this.resolve_symbol_ex(symbol, false)

    procedure resolve_symbol_ex(this, symbol: ref[Symbol]?, dont_resolve_alias: bool) returns ref[Symbol]?
    {
        if dont_resolve_alias = false
        {
            if Checker.is_non_local_alias(symbol, SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace)
                return this.resolve_alias(symbol as ref[Symbol])
        }
        symbol
    }

    ; getSymbolOfDeclaration and getSymbolOfNode. The reference keeps them apart on
    ; a type-safety argument (`DeclarationData()` versus `Symbol()`); here both read
    ; the same slot, so the second is the first, and the pair is kept because a call
    ; site names which question it is asking.
    procedure get_symbol_of_declaration(this, node: ref[AstNode]?) returns ref[Symbol]?
    {
        let symbol AstNode.symbol_of(node)
        if symbol = null
            return null
        this.get_merged_symbol(this.get_late_bound_symbol(symbol as ref[Symbol]))
    }

    procedure get_symbol_of_node(this, node: ref[AstNode]?) returns ref[Symbol]?
        this.get_symbol_of_declaration(node)

    ; getSymbolIfSameReference.
    procedure get_symbol_if_same_reference(this, s1: ref[Symbol]?, s2: ref[Symbol]?) returns ref[Symbol]?
    {
        let a this.get_merged_symbol(this.resolve_symbol(this.get_merged_symbol(s1)))
        let b this.get_merged_symbol(this.resolve_symbol(this.get_merged_symbol(s2)))
        if a = null
        {
            if b = null
                return s1
            return null
        }
        if b = null
            return null
        if (a as ref[Symbol]) = (b as ref[Symbol])
            return s1
        null
    }

    ; getDeclarationOfAliasSymbol — `core.FindLast(symbol.Declarations,
    ; ast.IsAliasSymbolDeclaration)`, and LAST is load-bearing: a merge puts the
    ; alias declaration after the local one.
    function get_declaration_of_alias_symbol(this, symbol: ref[Symbol]) returns ref[AstNode]?
    {
        var i Symbol.declaration_count(symbol) - 1
        while i >= 0
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if this.is_alias_symbol_declaration(d as ref[AstNode])
                    return d
            }
            set i: i - 1
        }
        null
    }

    ; ast.IsAliasSymbolDeclaration, whole.
    function is_alias_symbol_declaration(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindImportEqualsDeclaration
            return true
        if k = KindNamespaceExportDeclaration
            return true
        if k = KindNamespaceImport
            return true
        if k = KindNamespaceExport
            return true
        if k = KindImportSpecifier
            return true
        if k = KindExportSpecifier
            return true
        if k = KindImportClause
            return AstNode.name_of(node) <> null
        if k = KindExportAssignment
            return Binder.expression_is_alias(AstNode.expression_of(node))
        if k = KindVariableDeclaration
            return b.is_variable_declaration_initialized_to_require(node)
        if k = KindBindingElement
            return b.is_variable_declaration_initialized_to_require(node)
        if k = KindBinaryExpression
        {
            ; GetAssignmentDeclarationKind's ModuleExports and ExportsProperty arms
            ; — the JavaScript `module.exports = x` / `exports.x = y` forms.
            ;
            ; ★★★ THE STOP THAT STOOD HERE CLAIMED *the classifier is the JS-expando
            ; chapter and has no port*, AND THE CLASSIFIER HAS BEEN WHOLE IN
            ; `parser.scaly` SINCE SLICE 33 — four other call sites in this file
            ; already ask it. The note was an argument whose premise had expired.
            let adk Parser.get_assignment_declaration_kind(node)
            if adk = JSDeclarationKindModuleExports
                return Binder.expression_is_alias(AstNode.binary_right_of(node))
            if adk = JSDeclarationKindExportsProperty
                return Binder.expression_is_alias(AstNode.binary_right_of(node))
            return false
        }
        false
    }

    ; markSymbolOfAliasDeclarationIfTypeOnly.
    procedure mark_symbol_of_alias_declaration_if_type_only(this, alias_declaration: ref[AstNode]?, export_star_declaration: ref[AstNode]?) returns bool
    {
        if alias_declaration = null
            return false
        let ad alias_declaration as ref[AstNode]
        if AstNode.is_declaration_node(ad) = false
            return false
        let source_symbol this.get_symbol_of_declaration(ad)
        if source_symbol = null
            return false
        let links this.alias_symbol_link_of(source_symbol as ref[Symbol])
        if links.type_only_declaration = null
        {
            if Checker.is_type_only_import_or_export_declaration(ad)
            {
                set links.type_only_declaration: ad
                return true
            }
        }
        if links.type_only_declaration = null
        {
            if export_star_declaration <> null
            {
                set links.type_only_declaration: export_star_declaration
                return true
            }
        }
        links.type_only_declaration <> null
    }

    ; resolveAlias. ★★★ THE MEMO STORES unknownSymbol FOR A FAILED RESOLUTION AND
    ; THAT IS THE REFERENCE'S OWN `core.OrElse(target, c.unknownSymbol)`, not an
    ; optimisation: getTargetOfAliasDeclaration REPORTS — TS2307 for every specifier
    ; this harness cannot resolve — and diagcheck's relation is a SUBSEQUENCE, so a
    ; second resolution's second TS2307 is a failure.
    procedure resolve_alias(this, symbol: ref[Symbol]) returns ref[Symbol]?
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsAlias) = 0
        {
            ; The reference panics ("Should only get alias here").
            this.record_unported("resolve-alias-not-an-alias", Symbol.flags_of(symbol))
            return null
        }
        let links this.alias_symbol_link_of(symbol)
        if links.alias_target = null
        {
            if this.push_type_resolution(symbol, null, null, null, TypeSystemPropertyNameAliasTarget) = false
                return unknown_symbol
            let node this.get_declaration_of_alias_symbol(symbol)
            if node = null
            {
                ; The reference PANICS here, which is why this stays a stop rather
                ; than an answer. ★Until slice 161 the JS `module.exports = x` /
                ; `exports.x = y` forms arrived here, because is_alias_symbol_declaration
                ; reported instead of classifying them; that arm answers now.
                this.pop_type_resolution()
                this.record_unported("resolve-alias-no-declaration", Symbol.flags_of(symbol))
                return null
            }
            var target this.get_target_of_alias_declaration(node as ref[AstNode])
            if Checker.is_non_local_alias(target, SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace)
                set target: this.resolve_indirection_alias(symbol, target as ref[Symbol])
            if target = null
                set links.alias_target: unknown_symbol
            else
                set links.alias_target: target
            if this.pop_type_resolution() = false
            {
                this.error_on_node(node, DiagCircular_definition_of_import_alias_0, this.symbol_arg(symbol))
                set links.alias_target: unknown_symbol
            }
        }
        links.alias_target
    }

    ; resolveIndirectionAlias — the type-only marker is back-propagated from the
    ; target onto the source, which is what makes a chain of pure aliases carry one.
    procedure resolve_indirection_alias(this, source: ref[Symbol], target: ref[Symbol]) returns ref[Symbol]?
    {
        let result this.get_merged_symbol(this.resolve_alias(target))
        let target_links this.alias_symbol_link_of(target)
        if target_links.type_only_declaration <> null
        {
            let source_links this.alias_symbol_link_of(source)
            if source_links.type_only_declaration = null
                set source_links.type_only_declaration: target_links.type_only_declaration
        }
        result
    }

    ; tryResolveAlias.
    procedure try_resolve_alias(this, symbol: ref[Symbol]) returns ref[Symbol]?
    {
        let links this.alias_symbol_link_of(symbol)
        if links.alias_target <> null
            return this.resolve_alias(symbol)
        if this.find_resolution_cycle_start_index(symbol, null, null, null, TypeSystemPropertyNameAliasTarget) < 0
            return this.resolve_alias(symbol)
        null
    }

    ; getImmediateAliasedSymbol — the ONE hop the symbol's own declaration names,
    ; where resolveAlias walks to the end of the chain. Its memo is a field of its
    ; own for that reason (see AliasSymbolLink.immediate_target).
    ;
    ; ★ The reference asserts the ALIAS flag and panics on a missing declaration;
    ; both are reported here, on this file's rule about assertions.
    procedure get_immediate_aliased_symbol(this, symbol: ref[Symbol]) returns ref[Symbol]?
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsAlias) = 0
        {
            this.record_unported("immediate-aliased-symbol-not-an-alias", Symbol.flags_of(symbol))
            return null
        }
        let links this.alias_symbol_link_of(symbol)
        if links.immediate_target <> null
            return links.immediate_target
        let node this.get_declaration_of_alias_symbol(symbol)
        if node = null
        {
            this.record_unported("immediate-aliased-symbol-no-declaration", Symbol.flags_of(symbol))
            return null
        }
        set links.immediate_target: this.get_target_of_alias_declaration(node as ref[AstNode])
        links.immediate_target
    }

    ; getTypeOnlyAliasDeclaration.
    procedure get_type_only_alias_declaration(this, symbol: ref[Symbol]) returns ref[AstNode]?
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsAlias) = 0
            return null
        this.resolve_alias(symbol)
        this.alias_symbol_link_of(symbol).type_only_declaration
    }

    ; getTypeOnlyAliasDeclarationEx — "the FIRST type-only alias declaration node
    ; (if any) in the resolution chain that affects the symbol for the given
    ; meaning". Its non-Ex twin above is not this function with a default: that one
    ; asks ONE symbol, this one WALKS, and it stops as soon as the symbol carries
    ; the meaning asked for.
    ;
    ; ★ The walk needs no seen-set of its own: resolveAlias memoises through
    ; `alias_target`, and a cycle there resolves to unknownSymbol, which is not an
    ; alias — so the loop's own condition ends it.
    procedure get_type_only_alias_declaration_ex(this, symbol: ref[Symbol], meaning: int) returns ref[AstNode]?
    {
        var cur symbol
        while (Symbol.flags_of(cur) & SymbolFlagsAlias) <> 0
        {
            if (Symbol.flags_of(cur) & meaning) <> 0
                return null
            let resolved this.resolve_alias(cur)
            let links this.alias_symbol_link_of(cur)
            if links.type_only_declaration <> null
                return links.type_only_declaration
            if resolved = null
                return null
            set cur: resolved as ref[Symbol]
        }
        null
    }

    ; ── ast.IsValidTypeOnlyAliasUseSite and its three helpers ────────────────
    ;
    ; ★★★ THE PREDICATE IS WRITTEN THE WAY THE REFERENCE WRITES IT — a disjunction
    ; whose LAST term is a NEGATION — and the negation is what carries almost every
    ; true answer: a use site that is not an expression at all is valid, so the
    ; three positive terms are the exceptions to that and not the rule. Reading it
    ; the other way round (enumerate the valid sites) is the shape that would need
    ; a fourth term the day the grammar grows one.
    function is_valid_type_only_alias_use_site(this, use_site: ref[AstNode]) returns bool
    {
        if (AstNode.flags_of(use_site) & (NodeFlagsAmbient | NodeFlagsJSDoc)) <> 0
            return true
        if Binder.is_part_of_type_query(use_site)
            return true
        if Checker.is_identifier_in_non_emitting_heritage_clause(use_site)
            return true
        if this.is_part_of_possibly_valid_type_or_abstract_computed_property_name(use_site)
            return true
        if AstNode.is_expression_node(use_site)
            return false
        if Checker.is_shorthand_property_name_use_site(use_site)
            return false
        true
    }

    ; isIdentifierInNonEmittingHeritageClause. The walk up through property
    ; accesses and type arguments is what makes `implements A.B.C` one site rather
    ; than three.
    function is_identifier_in_non_emitting_heritage_clause(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindIdentifier
            return false
        var parent AstNode.parent_node_of(node)
        while parent <> null
        {
            let pk AstNode.kind_of(parent as ref[AstNode])
            if pk <> KindPropertyAccessExpression
            {
                if pk <> KindExpressionWithTypeArguments
                    break
            }
            set parent: AstNode.parent_node_of(parent as ref[AstNode])
        }
        if parent = null
            return false
        let p parent as ref[AstNode]
        if AstNode.kind_of(p) <> KindHeritageClause
            return false
        if AstNode.heritage_clause_token_of(p) = KindImplementsKeyword
            return true
        let gp AstNode.parent_node_of(p)
        if gp = null
            return false
        AstNode.kind_of(gp as ref[AstNode]) = KindInterfaceDeclaration
    }

    ; isPartOfPossiblyValidTypeOrAbstractComputedPropertyName.
    function is_part_of_possibly_valid_type_or_abstract_computed_property_name(this, node: ref[AstNode]) returns bool
    {
        var cur node
        while true
        {
            let k AstNode.kind_of(cur)
            if k <> KindIdentifier
            {
                if k <> KindPropertyAccessExpression
                    break
            }
            let up AstNode.parent_node_of(cur)
            if up = null
                return false
            set cur: up as ref[AstNode]
        }
        if AstNode.kind_of(cur) <> KindComputedPropertyName
            return false
        let parent AstNode.parent_node_of(cur)
        if parent = null
            return false
        let p parent as ref[AstNode]
        if b.has_syntactic_modifier(p, ModifierFlagsAbstract)
            return true
        let gp AstNode.parent_node_of(p)
        if gp = null
            return false
        let gk AstNode.kind_of(gp as ref[AstNode])
        if gk = KindInterfaceDeclaration
            return true
        gk = KindTypeLiteral
    }

    ; isShorthandPropertyNameUseSite.
    function is_shorthand_property_name_use_site(use_site: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(use_site) <> KindIdentifier
            return false
        let parent AstNode.parent_node_of(use_site)
        if parent = null
            return false
        let p parent as ref[AstNode]
        if AstNode.kind_of(p) <> KindShorthandPropertyAssignment
            return false
        AstNode.name_of(p) = use_site
    }

    ; getSymbolFlagsEx / getSymbolFlags. ★★★ THE `unknownSymbol` ANSWER IS
    ; **SymbolFlagsAll**, and under this harness that is not a corner: an alias to a
    ; module nothing resolves comes to unknownSymbol, so the reference's answer for
    ; every `import … from "m"` is *yes, whatever meaning you asked for*. That is
    ; the whole of the `get-symbol-flags` row lookup_symbol used to record.
    procedure get_symbol_flags(this, symbol: ref[Symbol]) returns int
        this.get_symbol_flags_ex(symbol, false, false)

    procedure get_symbol_flags_ex(this, symbol: ref[Symbol], exclude_type_only_meanings: bool, exclude_local_meanings: bool) returns int
    {
        var seen: ref[Array[ref[Symbol]?]]? null
        var flags 0
        if exclude_local_meanings = false
            set flags: Symbol.flags_of(symbol)
        var cur symbol
        while (Symbol.flags_of(cur) & SymbolFlagsAlias) <> 0
        {
            if exclude_type_only_meanings
            {
                if this.get_type_only_alias_declaration(cur) <> null
                    return flags
            }
            let resolved this.resolve_alias(cur)
            let target this.get_export_symbol_of_value_symbol_if_exported(resolved)
            if target = null
                return flags
            let t target as ref[Symbol]
            if t = unknown_symbol
                return SymbolFlagsAll
            if (Symbol.flags_of(t) & SymbolFlagsAlias) <> 0
            {
                if t = cur
                    return flags | Symbol.flags_of(t)
                if Checker.symbol_list_has(seen, t)
                    return flags | Symbol.flags_of(t)
                if seen = null
                {
                    set seen: &Array[ref[Symbol]?]^host()
                    (seen as ref[Array[ref[Symbol]?]]).add(cur)
                }
                (seen as ref[Array[ref[Symbol]?]]).add(t)
            }
            set flags: flags | Symbol.flags_of(t)
            set cur: t
        }
        flags
    }

    ; `seenSymbols.Has(target)`, over the port's list form.
    function symbol_list_has(list: ref[Array[ref[Symbol]?]]?, sym: ref[Symbol]) returns bool
    {
        if list = null
            return false
        let l list as ref[Array[ref[Symbol]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            let row l[i]
            if row <> null
            {
                if (row as ref[Symbol]) = sym
                    return true
            }
            set i: i + 1
        }
        false
    }


    ; `node.PropertyNameOrName()` — the reference's own accessor, whose fallback is
    ; the plain name.
    function property_name_or_name_of(n: ref[AstNode]?) returns ref[AstNode]?
    {
        let pn AstNode.property_name_of(n)
        if pn <> null
            return pn
        AstNode.name_of(n)
    }

    ; `name.Text()` for the two kinds a module export name may be. Answers through
    ; a Slice because the callers compare it and hand it to SymbolTable.get.
    function module_export_name_text(n: ref[AstNode]?) returns Slice[char]
    {
        if AstNode.kind_of(n) = KindIdentifier
            return AstNode.identifier_text_of(n)
        AstNode.literal_text_of(n)
    }

    ; ast.ModuleExportNameIsDefault.
    function module_export_name_is_default(n: ref[AstNode]?) returns bool
        Checker.name_bytes_are(Checker.module_export_name_text(n), "default")

    ; ast.GetExternalModuleName, whole. ★The reference PANICS on an unhandled kind;
    ; reported here, the way every other unreachable panic in this file is.
    procedure get_external_module_name(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        let k Checker.kind_or_unknown(node)
        if k = KindImportDeclaration
            return AstNode.module_specifier_of(node)
        if k = KindJSImportDeclaration
            return AstNode.module_specifier_of(node)
        if k = KindExportDeclaration
            return AstNode.module_specifier_of(node)
        if k = KindImportEqualsDeclaration
        {
            if AstNode.import_equals_reference_kind(node) = KindExternalModuleReference
                return AstNode.expression_of(AstNode.module_reference_of(node))
            return null
        }
        if k = KindModuleDeclaration
        {
            let nm AstNode.name_of(node)
            if Checker.kind_or_unknown(nm) = KindStringLiteral
                return nm
            return null
        }
        ; KindImportType (getImportTypeNodeLiteral) and KindCallExpression (the
        ; first argument of an `import(...)` call) are the reference's other two
        ; arms; both belong to chapters whose callers stop before this point.
        this.record_unported("get-external-module-name", k)
        null
    }

    ; getExternalModuleRequireArgument — the JS `const x = require("m")` form, whose
    ; whole body is `node.Initializer().Arguments()[0]`. ★The predicate in front of
    ; it is the binder's and has been here all along; the stop was on the ARGUMENT
    ; hop, which is two accessors.
    function get_external_module_require_argument(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if b.is_variable_declaration_initialized_to_require(node) = false
            return null
        ; `ini` and not `init` — §3.19's second reserved word, met for the second
        ; time in this file.
        let ini AstNode.initializer_of(node)
        if ini = null
            return null
        let args AstNode.call_arguments_of(ini as ref[AstNode])
        if args = null
            return null
        let list args as ref[Array[ref[AstNode]?]]
        if (list.get_length() as int) = 0
            return null
        list[0]
    }

    ; getModuleSpecifierFromNode. ★The reference panics on anything else.
    procedure get_module_specifier_from_node(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        let k Checker.kind_or_unknown(node)
        if k = KindImportDeclaration
            return AstNode.module_specifier_of(node)
        if k = KindJSImportDeclaration
            return AstNode.module_specifier_of(node)
        if k = KindExportDeclaration
            return AstNode.module_specifier_of(node)
        this.record_unported("module-specifier-from-node", k)
        null
    }

    ; getModuleSpecifierForImportOrExport. ★The ImportEqualsDeclaration arm answers
    ; nil for an INTERNAL reference, which is an answer and not a miss.
    procedure get_module_specifier_for_import_or_export(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k AstNode.kind_of(node)
        if k = KindImportClause
            return this.get_module_specifier_from_node(AstNode.parent_node_of(node))
        if k = KindImportEqualsDeclaration
        {
            if AstNode.import_equals_reference_kind(node) = KindExternalModuleReference
                return AstNode.expression_of(AstNode.module_reference_of(node))
            return null
        }
        if k = KindNamespaceImport
            return this.get_module_specifier_from_node(AstNode.parent_node_of(AstNode.parent_node_of(node)))
        if k = KindImportSpecifier
            return this.get_module_specifier_from_node(AstNode.parent_node_of(AstNode.parent_node_of(AstNode.parent_node_of(node))))
        if k = KindNamespaceExport
            return this.get_module_specifier_from_node(AstNode.parent_node_of(node))
        if k = KindExportSpecifier
            return this.get_module_specifier_from_node(AstNode.parent_node_of(AstNode.parent_node_of(node)))
        this.record_unported("module-specifier-for-import-or-export", k)
        null
    }

    ; getEmitSyntaxForModuleSpecifierExpression. The stub program's
    ; GetEmitSyntaxForUsageLocation answers ResolutionModeNone for every location,
    ; so this is a CONSTANT under the harness rather than a hole — and it is the
    ; constant three forks below read.
    ; getEmitSyntaxForModuleSpecifierExpression → the program's
    ; GetEmitSyntaxForUsageLocation (slice 248): a `require` or `import =` is
    ; CommonJS, an `import()` follows whether it is transformed, anything else
    ; takes the FILE's emit format. None without a program (the single-unit runs).
    function get_emit_syntax_for_module_specifier_expression(this, usage: ref[AstNode]?) returns int
        Checker.emit_syntax_for_module_specifier(this.resolution_context(), usage)

    ; getEmitSyntaxForUsageLocationWorker
    function emit_syntax_for_module_specifier(rc: ResolutionContext, usage: ref[AstNode]?) returns int
    {
        if usage = null
            return ModuleKindNone
        let uk Checker.kind_or_unknown(usage)
        if (uk <> KindStringLiteral) and (uk <> KindNoSubstitutionTemplateLiteral)
            return ModuleKindNone
        if rc.files = null
            return ModuleKindNone
        let file_format Checker.file_emit_format_in(rc, Checker.source_file_of_node(usage))
        let parent AstNode.parent_node_of(usage)
        if parent = null
            return ModuleKindNone
        let pn parent as ref[AstNode]
        let pk AstNode.kind_of(pn)
        if pk = KindCallExpression
        {
            if Parser.is_require_call(pn, false)
                return ModuleKindCommonJS
        }
        ; IsImportCall(WalkUpParenthesizedExpressions(usage.Parent))
        if AstNode.is_import_call(Checker.walk_up_parenthesized_expressions(pn))
        {
            if Checker.should_transform_import_call_of(rc, file_format)
                return ModuleKindCommonJS
            return ModuleKindESNext
        }
        if pk = KindExternalModuleReference
        {
            if Checker.kind_or_unknown(AstNode.parent_node_of(pn)) = KindImportEqualsDeclaration
                return ModuleKindCommonJS
        }
        if file_format = ModuleKindCommonJS
            return ModuleKindCommonJS
        if ((file_format >= ModuleKindES2015) and (file_format <= ModuleKindESNext)) or (file_format = ModuleKindPreserve)
            return ModuleKindESNext
        ModuleKindNone
    }

    ; ast.ShouldTransformImportCall. ★ Until slice 253 both usage-mode readers
    ; answered CommonJS for every import() in a CommonJS-format file; under
    ; node16..nodenext and preserve the call is never lowered, so it is an ESM
    ; usage there, and a CommonJS target then has a synthetic `default`
    function should_transform_import_call(this, implied_node_format_for_emit: int) returns bool
        Checker.should_transform_import_call_of(this.resolution_context(), implied_node_format_for_emit)

    function should_transform_import_call_of(rc: ResolutionContext, implied_node_format_for_emit: int) returns bool
    {
        if (rc.module_kind >= ModuleKindNode16) and (rc.module_kind <= ModuleKindNodeNext)
            return false
        if rc.module_kind = ModuleKindPreserve
            return false
        implied_node_format_for_emit < ModuleKindES2015
    }

    ; the emit format of a program file (GetEmitModuleFormatOfFile); the unit's own
    ; `emit_module_format` when the file is not in the table
    function file_emit_format_of(this, sf: ref[AstNode]?) returns int
        Checker.file_emit_format_in(this.resolution_context(), sf)

    function file_emit_format_in(rc: ResolutionContext, sf: ref[AstNode]?) returns int
    {
        if rc.files <> null
        {
            let pf rc.files as ref[ProgramFiles]
            let fi pf.index_of_file(sf)
            if fi >= 0
                return pf.format_at(fi)
        }
        rc.emit_module_format
    }

    ; program.GetImpliedNodeFormatForEmit of a program file; ModuleKindNone off the
    ; table (the stub program's answer)
    function implied_node_format_for_emit_of_file(this, sf: ref[AstNode]?) returns int
    {
        if program = null
            return ModuleKindNone
        let pf program as ref[ProgramFiles]
        let fi pf.index_of_file(sf)
        if fi < 0
            return ModuleKindNone
        let path pf.path_at(fi)
        let package_type pf.package_json_type_at(fi)
        Checker.implied_node_format_for_emit_of(path, module_kind, Checker.implied_node_format_for_file(path, package_type), package_type)
    }

    function current_file_emit_format(this) returns int
        this.file_emit_format_of(file)

    ; isOnlyImportableAsDefault: in Node.js a JSON module has no named exports
    ; (slice 248: the usage mode and the resolved file come from the program)
    procedure is_only_importable_as_default(this, usage: ref[AstNode]?, resolved_module: ref[Symbol]?) returns bool
    {
        if module_kind < ModuleKindNode16
            return false
        if module_kind > ModuleKindNodeNext
            return false
        if this.get_emit_syntax_for_module_specifier_expression(usage) <> ModuleKindESNext
            return false
        var rm resolved_module
        if rm = null
            set rm: this.resolve_external_module_name(usage, usage, true)
        if rm = null
            return false
        let rms rm as ref[Symbol]
        let dn Symbol.declaration_count(rms)
        var di 0
        while di < dn
        {
            let d Symbol.declaration_at(rms, di)
            set di: di + 1
            if Checker.kind_or_unknown(d) = KindSourceFile
            {
                if (AstNode.flags_of(d as ref[AstNode]) & NodeFlagsJsonFile) <> 0
                    return true
                let pf_index this.program_index_of_node(d)
                if pf_index >= 0
                {
                    let pf program as ref[ProgramFiles]
                    let path pf.path_at(pf_index)
                    if path.ends_with(".d.json.ts")
                        return true
                }
                return false
            }
        }
        false
    }

    ; canHaveSyntheticDefault. ★★★ `file` IS ALWAYS NIL UNDER THIS HARNESS AND THAT
    ; IS WHAT MAKES THE FUNCTION PORTABLE: resolve_external_module can only answer
    ; an AMBIENT module (globals), whose declarations are ModuleDeclarations, so
    ; `core.Find(declarations, IsSourceFile)` finds nothing and the reference's
    ; declaration-file branch is the live one.
    procedure can_have_synthetic_default(this, file: ref[AstNode]?, module_symbol: ref[Symbol]?, dont_resolve_alias: bool, usage: ref[AstNode]?) returns bool
    {
        if file <> null
        {
            ; usageMode is ModuleKindNone (above), so the reference's whole
            ; program-format block is skipped; what is behind it is the project-
            ; reference redirect, which the stub program answers with nil.
            let usage_mode this.get_emit_syntax_for_module_specifier_expression(usage)
            if usage_mode <> ModuleKindNone
            {
                let target_mode this.implied_node_format_for_emit_of_file(file)
                if (usage_mode = ModuleKindESNext) and (target_mode = ModuleKindCommonJS) and (module_kind >= ModuleKindNode16) and (module_kind <= ModuleKindNodeNext)
                    return true
                if (usage_mode = ModuleKindESNext) and (target_mode = ModuleKindESNext)
                    return false
                ; a declaration file of a referenced project: its module format under
                ; that project's options
                if (target_mode = ModuleKindNone) and (program <> null)
                {
                    let rpf program as ref[ProgramFiles]
                    let target_format rpf.reference_module_format_of(rpf.index_of_file(file as ref[AstNode]))
                    let target_is_declaration this.binder_of_node(file as ref[AstNode]).is_declaration_file_of()
                    if (target_format >= ModuleKindES2015) and target_is_declaration
                    {
                        if usage_mode = ModuleKindESNext
                        {
                            if target_format <= ModuleKindESNext
                                return false
                        }
                    }
                }
            }
        }
        if module_symbol = null
            return false
        let ms module_symbol as ref[Symbol]
        ; `file.IsDeclarationFile` — the RESOLVED file's, asked of its binder (the
        ; checker's own `is_declaration_file` is the unit being checked; slice 248)
        var is_declaration_like false
        if file = null
            set is_declaration_like: true
        if file <> null
        {
            let fb this.binder_of_node(file)
            if fb.is_declaration_file_of()
                set is_declaration_like: true
        }
        if is_declaration_like
        {
            var dd Slice[char]()
            set dd: Binder.internal_name_unprefixed(host, "default")
            let default_export_symbol this.resolve_export_by_name(ms, dd, null, true)
            if default_export_symbol <> null
            {
                let des default_export_symbol as ref[Symbol]
                let n Symbol.declaration_count(des)
                var i 0
                while i < n
                {
                    if this.is_syntactic_default(Symbol.declaration_at(des, i))
                        return false
                    set i: i + 1
                }
            }
            var ed Slice[char]()
            set ed: Binder.internal_name_unprefixed(host, "__esModule")
            if this.resolve_export_by_name(ms, ed, null, dont_resolve_alias) <> null
                return false
            return true
        }
        ; A TypeScript file never has a synthetic default unless it carries an
        ; `export =`; a JS file has one when it shows no ES module syntax and no
        ; `__esModule` marker. Both need the module's own SOURCE FILE, which the
        ; branch above proves cannot be reached here.
        ; a source file (slice 248): TypeScript answers by its `export =`; JavaScript
        ; by having no statement that makes it a module and no `__esModule` export
        let f file as ref[AstNode]
        if Parser.is_in_js_file(f) = false
            return this.has_export_assignment_symbol(ms)
        if Parser.external_module_indicator(f, AstNode.statements_of(f))
            return false
        var ed2 Slice[char]()
        set ed2: Binder.internal_name_unprefixed(host, "__esModule")
        this.resolve_export_by_name(ms, ed2, null, dont_resolve_alias) = null
    }

    ; isSyntacticDefault.
    function is_syntactic_default(this, node: ref[AstNode]?) returns bool
    {
        let k Checker.kind_or_unknown(node)
        if k = KindExportAssignment
        {
            if AstNode.is_export_equals_of(node) = false
                return true
        }
        if b.has_syntactic_modifier(node, ModifierFlagsDefault)
            return true
        if k = KindExportSpecifier
            return true
        k = KindNamespaceExport
    }

    ; hasExportAssignmentSymbol.
    procedure has_export_assignment_symbol(this, module_symbol: ref[Symbol]) returns bool
    {
        var ed Slice[char]()
        set ed: Binder.internal_name_unprefixed(host, "export=")
        SymbolTable.get(Symbol.exports_of(module_symbol), ed) <> null
    }

    ; resolveExportByName.
    procedure resolve_export_by_name(this, module_symbol: ref[Symbol], d: Slice[char], source_node: ref[AstNode]?, dont_resolve_alias: bool) returns ref[Symbol]?
    {
        var ed Slice[char]()
        set ed: Binder.internal_name_unprefixed(host, "export=")
        let export_value SymbolTable.get(Symbol.exports_of(module_symbol), ed)
        var export_symbol: ref[Symbol]? null
        if export_value <> null
        {
            let t this.get_type_of_symbol(export_value as ref[Symbol])
            if t = null
                return null
            set export_symbol: this.get_property_of_type_ex(t as ref[Type], d, true, false)
        }
        else
            set export_symbol: SymbolTable.get(Symbol.exports_of(module_symbol), d)
        let resolved this.resolve_symbol_ex(export_symbol, dont_resolve_alias)
        this.mark_symbol_of_alias_declaration_if_type_only(source_node, null)
        resolved
    }

    ; getExportOfModule. ★The typeOnlyExportStarMap read is nil by the argument in
    ; ModuleSymbolLink's header.
    procedure get_export_of_module(this, symbol: ref[Symbol], d: Slice[char], specifier: ref[AstNode]?, dont_resolve_alias: bool) returns ref[Symbol]?
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsModule) = 0
            return null
        let exports this.get_exports_of_module(symbol)
        let export_symbol SymbolTable.get(exports, d)
        let resolved this.resolve_symbol_ex(export_symbol, dont_resolve_alias)
        this.mark_symbol_of_alias_declaration_if_type_only(specifier, this.type_only_export_star_declaration(symbol, d))
        resolved
    }

    ; getPropertyOfVariable.
    procedure get_property_of_variable(this, symbol: ref[Symbol], d: Slice[char]) returns ref[Symbol]?
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsVariable) = 0
            return null
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
            return null
        let annotation AstNode.type_of(vd)
        if annotation = null
            return null
        let t this.get_type_from_type_node(annotation as ref[AstNode])
        if t = null
            return null
        this.resolve_symbol(this.get_property_of_type(t as ref[Type], d))
    }

    ; combineValueAndTypeSymbols — the SYNTHETIC symbol that joins a value side to a
    ; type side (`declare module "graphics" { export = graphics }` beside an
    ; interface of the same name). Whole since slice 202 (`exportEqualsOfModule`):
    ; the declaration list is the concatenation with CONSECUTIVE duplicates
    ; removed (slices.Compact), the parent is the value's or else the type's, and
    ; the member and export tables are shallow COPIES (maps.Clone), so a later
    ; merge into the synthetic symbol cannot reach the originals.
    procedure combine_value_and_type_symbols(this, value_symbol: ref[Symbol], type_symbol: ref[Symbol]) returns ref[Symbol]?
    {
        if value_symbol = unknown_symbol
        {
            if type_symbol = unknown_symbol
                return unknown_symbol
        }
        if (Symbol.flags_of(type_symbol) & SymbolFlagsValue) <> 0
            return type_symbol
        if (Symbol.flags_of(value_symbol) & (SymbolFlagsType | SymbolFlagsNamespace)) <> 0
            return value_symbol
        let result this.new_symbol(Symbol.flags_of(value_symbol) | Symbol.flags_of(type_symbol), Symbol.name_of(value_symbol))
        let decls &Array[ref[AstNode]?]^host()
        var last: ref[AstNode]? null
        var pass 0
        while pass < 2
        {
            var from value_symbol
            if pass = 1
                set from: type_symbol
            let n Symbol.declaration_count(from)
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(from, i)
                set i: i + 1
                if d = null
                    continue
                if d = last
                    continue
                decls.add(d)
                set last: d
            }
            set pass: pass + 1
        }
        Symbol.set_declarations(result, decls)
        var parent Symbol.parent_of(value_symbol)
        if parent = null
            set parent: Symbol.parent_of(type_symbol)
        Symbol.set_parent(result, parent)
        Symbol.set_value_declaration(result, Symbol.value_declaration_of(value_symbol))
        ; maps.Clone: a nil table stays nil.
        if Symbol.members_of(type_symbol) <> null
            Symbol.set_members(result, this.clone_symbol_table(Symbol.members_of(type_symbol)))
        if Symbol.exports_of(value_symbol) <> null
            Symbol.set_exports(result, this.clone_symbol_table(Symbol.exports_of(value_symbol)))
        result
    }

    ; reportInvalidImportEqualsExportMember. module_kind is ES2022, so the first
    ; fork is the live one and the other two are dead by value.
    procedure report_invalid_import_equals_export_member(this, name: ref[AstNode]?, declaration_name: String, module_name: String)
    {
        if module_kind >= ModuleKindES2015
        {
            this.error_on_node(name, DiagX_0_can_only_be_imported_by_using_a_default_import, declaration_name)
            return
        }
        if Parser.is_in_js_file(name)
        {
            this.error_on_node(name, DiagX_0_can_only_be_imported_by_using_a_require_call_or_by_using_a_default_import, declaration_name)
            return
        }
        this.error_on_node(name, DiagX_0_can_only_be_imported_by_using_import_1_require_2_or_a_default_import, declaration_name, declaration_name, module_name)
    }

    ; reportNonExportedMember. ★Every arm of it is a REPORT and the related info is
    ; invisible to this yardstick (the dump is `C pos end code`), so what has to be
    ; exact is WHICH code and at which span.
    procedure report_non_exported_member(this, name: ref[AstNode], module_symbol: ref[Symbol], declaration_name: String, module_name: String)
    {
        let nt Checker.module_export_name_text(name)
        var local_symbol: ref[Symbol]? null
        let vd Symbol.value_declaration_of(module_symbol)
        if vd <> null
            set local_symbol: SymbolTable.get(AstNode.locals_of(vd), Slice[char](nt.length, nt.data))
        let exports Symbol.exports_of(module_symbol)
        if local_symbol = null
        {
            this.error_on_node(name, DiagModule_0_has_no_exported_member_1, module_name, declaration_name)
            return
        }
        let ls local_symbol as ref[Symbol]
        var ed Slice[char]()
        set ed: Binder.internal_name_unprefixed(host, "export=")
        let exported_equals SymbolTable.get(exports, ed)
        if exported_equals <> null
        {
            if this.get_symbol_if_same_reference(exported_equals, ls) <> null
                this.report_invalid_import_equals_export_member(name, declaration_name, module_name)
            else
                this.error_on_node(name, DiagModule_0_has_no_exported_member_1, module_name, declaration_name)
            return
        }
        ; findInMap over the exports for a symbol that resolves to the same thing as
        ; the local one. The reference's map iteration has no order; both arms below
        ; report a DIFFERENT code, so the search's ANSWER is what matters and not
        ; which entry it found.
        var found: ref[Symbol]? null
        let n SymbolTable.length(exports)
        var i 0
        while i < n
        {
            let sym SymbolTable.entry_symbol_at(exports, i)
            if sym <> null
            {
                if found = null
                {
                    if this.get_symbol_if_same_reference(sym, ls) <> null
                        set found: sym
                }
            }
            set i: i + 1
        }
        let local_mark this.diagnostic_mark()
        if found <> null
            this.error_on_node(name, DiagModule_0_declares_1_locally_but_it_is_exported_as_2, module_name, declaration_name, this.symbol_arg(found))
        else
            this.error_on_node(name, DiagModule_0_declares_1_locally_but_it_is_not_exported, module_name, declaration_name)
        var di 0
        while di < Symbol.declaration_count(ls)
        {
            let decl Symbol.declaration_at(ls, di)
            if di = 0
                this.related_info_since(local_mark, decl, DiagX_0_is_declared_here, declaration_name)
            else
                this.related_info_since(local_mark, decl, DiagX_and_here, declaration_name)
            set di: di + 1
        }
    }

    ; errorNoModuleMemberSymbol. ★★★ THE SUGGESTION FORK DECIDES THE CODE, so it is
    ; a STOP and not a fallthrough: getSuggestedSymbolForNonexistentModule runs the
    ; spelling suggester over the module's exports, and answering *no suggestion*
    ; without asking would report TS2305 where the reference reports TS2724.
    procedure error_no_module_member_symbol(this, module_symbol: ref[Symbol]?, target_symbol: ref[Symbol]?, node: ref[AstNode]?, name: ref[AstNode]?)
    {
        if name = null
            return
        let nm name as ref[AstNode]
        var module_name String("")
        if module_symbol <> null
        {
            if node <> null
                set module_name: this.fully_qualified_name_at(module_symbol as ref[Symbol], node as ref[AstNode])
            else
                set module_name: this.fully_qualified_name_arg(module_symbol as ref[Symbol])
        }
        let declaration_name this.declaration_name_to_string(nm)
        if AstNode.kind_of(nm) = KindIdentifier
        {
            if target_symbol <> null
            {
                let mark this.unported_mark()
                let suggestion this.get_suggested_symbol_for_nonexistent_module(nm, target_symbol as ref[Symbol])
                if this.unported_mark() <> mark
                    return
                if suggestion <> null
                {
                    ; TS2724. ★The related information the reference attaches when
                    ; the suggestion has a value declaration is not written: the
                    ; yardstick dumps `C pos end code` and carries none, which is
                    ; error_on_node's own note.
                    let suggestion_name this.symbol_arg(suggestion)
                    let member_mark this.diagnostic_mark()
                    this.error_on_node(nm, DiagX_0_has_no_exported_member_named_1_Did_you_mean_2, module_name, declaration_name, suggestion_name)
                    this.related_info_since(member_mark, Symbol.value_declaration_of(suggestion as ref[Symbol]), DiagX_0_is_declared_here, suggestion_name)
                    return
                }
            }
        }
        if module_symbol = null
            return
        let ms module_symbol as ref[Symbol]
        var dd Slice[char]()
        set dd: Binder.internal_name_unprefixed(host, "default")
        if SymbolTable.get(Symbol.exports_of(ms), dd) <> null
        {
            this.error_on_node(nm, DiagModule_0_has_no_exported_member_1_Did_you_mean_to_use_import_1_from_0_instead, module_name, declaration_name)
            return
        }
        this.report_non_exported_member(nm, ms, declaration_name, module_name)
    }

    ; reportNonDefaultExport. ★The `export *` related-info search is kept for its
    ; SIDE EFFECT and not for the info: it resolves each `export * from "m"`
    ; specifier WITH errors, so it is a report of its own.
    procedure report_non_default_export(this, module_symbol: ref[Symbol], node: ref[AstNode])
    {
        let exports Symbol.exports_of(module_symbol)
        let own AstNode.symbol_of(node)
        if own <> null
        {
            let o own as ref[Symbol]
            if SymbolTable.get(exports, Symbol.name_of(o)) <> null
            {
                this.error_on_node(node, DiagModule_0_has_no_default_export_Did_you_mean_to_use_import_1_from_0_instead, this.symbol_arg(module_symbol), this.symbol_arg(o))
                return
            }
        }
        let default_mark this.diagnostic_mark()
        this.error_on_node(AstNode.name_of(node), DiagModule_0_has_no_default_export, this.symbol_arg(module_symbol))
        var sd Slice[char]()
        set sd: Binder.internal_name(host, "export")
        let export_star SymbolTable.get(exports, sd)
        if export_star = null
            return
        let es export_star as ref[Symbol]
        let n Symbol.declaration_count(es)
        var i 0
        while i < n
        {
            let decl Symbol.declaration_at(es, i)
            if Checker.kind_or_unknown(decl) = KindExportDeclaration
            {
                let spec AstNode.module_specifier_of(decl)
                if spec <> null
                {
                    let resolved this.resolve_external_module_name(decl, spec, false)
                    if resolved <> null
                    {
                        var dd Slice[char]()
                        set dd: Binder.internal_name_unprefixed(host, "default")
                        if SymbolTable.get(Symbol.exports_of(resolved as ref[Symbol]), dd) <> null
                        {
                            this.related_info_since(default_mark, decl, DiagX_export_Asterisk_does_not_re_export_a_default)
                            return
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; getTargetOfModuleDefault. ★The exportModuleDotExports fork needs
    ; `Node20 <= moduleKind <= NodeNext`, which is false here, so the else branch is
    ; the whole of it; `hasDefaultOnly` is is_only_importable_as_default's constant
    ; false.
    procedure get_target_of_module_default(this, module_symbol: ref[Symbol], node: ref[AstNode], dont_resolve_alias: bool) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        let file Checker.find_source_file_declaration(module_symbol)
        let specifier this.get_module_specifier_for_import_or_export(node)
        if (file <> null) and (specifier <> null) and (module_kind >= ModuleKindNode20) and (module_kind <= ModuleKindNodeNext)
        {
            if Checker.is_shorthand_ambient_module_symbol(module_symbol) = false
            {
                if (this.get_emit_syntax_for_module_specifier_expression(specifier) = ModuleKindCommonJS) and (this.implied_node_format_for_emit_of_file(file) = ModuleKindESNext)
                {
                    var me Slice[char]()
                    set me: Binder.internal_name_unprefixed(host, "module.exports")
                    let export_module_dot_exports_symbol this.resolve_export_by_name(module_symbol, me, node, dont_resolve_alias)
                    if this.unported_mark() <> unported_before
                        return null
                    if export_module_dot_exports_symbol <> null
                    {
                        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
                        return export_module_dot_exports_symbol
                    }
                }
            }
        }
        var dd Slice[char]()
        set dd: Binder.internal_name_unprefixed(host, "default")
        let export_default_symbol this.resolve_export_by_name(module_symbol, dd, node, dont_resolve_alias)
        if specifier = null
            return export_default_symbol
        let has_default_only this.is_only_importable_as_default(specifier, module_symbol)
        let has_synthetic_default this.can_have_synthetic_default(file, module_symbol, dont_resolve_alias, specifier)
        if this.unported_mark() <> unported_before
            return null
        var reported false
        if export_default_symbol = null
        {
            if has_synthetic_default = false
            {
                if has_default_only = false
                {
                    set reported: true
                    if AstNode.kind_of(node) = KindImportClause
                        this.report_non_default_export(module_symbol, node)
                    else
                    {
                        var nm: ref[AstNode]? AstNode.name_of(node)
                        if AstNode.is_import_or_export_specifier(node)
                            set nm: Checker.property_name_or_name_of(node)
                        this.error_no_module_member_symbol(module_symbol, module_symbol, node, nm)
                    }
                }
            }
        }
        if reported = false
        {
            var synthetic false
            if has_synthetic_default
                set synthetic: true
            if has_default_only
                set synthetic: true
            if synthetic
            {
                var resolved this.resolve_external_module_symbol(module_symbol, dont_resolve_alias)
                if resolved = null
                    set resolved: this.resolve_symbol_ex(module_symbol, dont_resolve_alias)
                this.mark_symbol_of_alias_declaration_if_type_only(node, null)
                return resolved
            }
        }
        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
        export_default_symbol
    }

    ; `core.Find(moduleSymbol.Declarations, ast.IsSourceFile)`.
    function find_source_file_declaration(module_symbol: ref[Symbol]) returns ref[AstNode]?
    {
        let n Symbol.declaration_count(module_symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(module_symbol, i)
            if Checker.kind_or_unknown(d) = KindSourceFile
                return d
            set i: i + 1
        }
        null
    }

    ; resolveESModuleSymbol. ★The synthetic-default WRAPPER is the module TYPE
    ; machinery (getTypeWithSyntheticDefaultOnly, cloneTypeAsModuleType) and belongs
    ; to a chapter of its own; it is reached only for a namespace import or an
    ; `import()` call whose specifier RESOLVED, which under this harness means an
    ; ambient module.
    procedure resolve_es_module_symbol(this, module_symbol: ref[Symbol]?, node: ref[AstNode]?, module_specifier: ref[AstNode]?) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        var symbol this.resolve_external_module_symbol(module_symbol, true)
        if Checker.is_non_local_alias(symbol, SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace)
        {
            let src this.get_symbol_of_declaration(node)
            if src = null
                return null
            set symbol: this.get_merged_symbol(this.resolve_indirection_alias(src as ref[Symbol], symbol as ref[Symbol]))
        }
        if symbol = null
            return null
        let reference_parent AstNode.parent_node_of(module_specifier)
        var namespace_import: ref[AstNode]? null
        if Checker.kind_or_unknown(reference_parent) = KindImportDeclaration
            set namespace_import: Checker.get_namespace_declaration_node(reference_parent)
        var wraps false
        if namespace_import <> null
            set wraps: true
        if AstNode.is_import_call(reference_parent)
            set wraps: true
        if wraps
        {
            ; ★ THE WRAP IS DECIDED FIRST (slice 224): a namespace import or an import
            ; call is cloned as a module type only when the module's type has
            ; signatures, a `default` property, or is an ESM reference to a
            ; CommonJS-format file; otherwise the symbol itself is the answer. The
            ; usage mode this port computes is ModuleKindNone, so the default-only
            ; type (Node16–NodeNext), the module.exports export (Node20–NodeNext,
            ; CommonJS usage) and the ESM→CJS reference never apply; the clone
            ; itself (cloneTypeAsModuleType over a synthetic-default type) stays
            ; reported.
            let sym symbol as ref[Symbol]
            var reference: ref[AstNode]? null
            if AstNode.is_import_call(reference_parent)
            {
                let args AstNode.call_arguments_of(reference_parent)
                if args <> null
                {
                    if ((args as ref[Array[ref[AstNode]?]]).get_length() as int) > 0
                        set reference: (args as ref[Array[ref[AstNode]?]])[0]
                }
            }
            else
                set reference: AstNode.module_specifier_of(reference_parent)
            let typ this.get_type_of_symbol(sym)
            if this.unported_mark() <> unported_before
                return null
            if typ = null
                return null
            let t typ as ref[Type]
            ; slice 248: the clone as a MODULE TYPE (a multi-file program reaches
            ; it for every namespace import of a module with a default or call
            ; signatures); the node20+ `module.exports` export and the ESM→CJS
            ; reference still read a usage mode of None and never apply
            let default_only this.get_type_with_synthetic_default_only(t, sym, module_symbol, reference)
            if this.unported_mark() <> unported_before
                return null
            if default_only <> null
                return this.clone_type_as_module_type(sym, default_only as ref[Type], reference_parent)
            let target_file Checker.find_source_file_declaration(sym)
            let usage_mode this.get_emit_syntax_for_module_specifier_expression(reference)
            if (namespace_import <> null) and (target_file <> null) and (module_kind >= ModuleKindNode20) and (module_kind <= ModuleKindNodeNext) and (usage_mode = ModuleKindCommonJS)
            {
                if this.implied_node_format_for_emit_of_file(target_file) = ModuleKindESNext
                {
                    var me Slice[char]()
                    set me: Binder.internal_name_unprefixed(host, "module.exports")
                    let export_module_dot_exports_symbol this.get_export_of_module(sym, me, namespace_import, true)
                    if this.unported_mark() <> unported_before
                        return null
                    if export_module_dot_exports_symbol <> null
                    {
                        if this.has_signatures(t)
                            return this.clone_type_as_module_type(export_module_dot_exports_symbol as ref[Symbol], t, reference_parent)
                        return export_module_dot_exports_symbol
                    }
                }
            }
            var wrap false
            if (target_file <> null) and (usage_mode = ModuleKindESNext)
            {
                if this.implied_node_format_for_emit_of_file(target_file) = ModuleKindCommonJS
                    set wrap: true
            }
            if this.has_signatures(t)
                set wrap: true
            if this.unported_mark() <> unported_before
                return null
            if wrap = false
            {
                if this.get_property_of_type_ex(t, "default", true, false) <> null
                    set wrap: true
                if this.unported_mark() <> unported_before
                    return null
            }
            if wrap
            {
                var module_type: ref[Type]? null
                if (t.flags & TypeFlagsStructuredType) <> 0
                    set module_type: this.get_type_with_synthetic_default_import_type(t, sym, module_symbol, reference)
                else
                    set module_type: this.create_default_property_wrapper_for_module(sym, Symbol.parent_of(sym), null)
                if this.unported_mark() <> unported_before
                    return null
                if module_type = null
                    return null
                return this.clone_type_as_module_type(sym, module_type as ref[Type], reference_parent)
            }
        }
        symbol
    }

    ; getTypeWithSyntheticDefaultOnly — the `{ default: … }` wrapper alone, for a
    ; module only importable as a default (no cache: the alias resolution that
    ; asks is memoized one level up)
    procedure get_type_with_synthetic_default_only(this, t: ref[Type], symbol: ref[Symbol], original_symbol: ref[Symbol]?, module_specifier: ref[AstNode]?) returns ref[Type]?
    {
        if this.is_only_importable_as_default(module_specifier, null) = false
            return null
        if this.is_error_type(t)
            return null
        this.create_default_property_wrapper_for_module(symbol, original_symbol, null)
    }

    ; getTypeWithSyntheticDefaultImportType: the module's own type spread with the
    ; `default` wrapper when the module can have a synthetic default
    procedure get_type_with_synthetic_default_import_type(this, t: ref[Type], symbol: ref[Symbol], original_symbol: ref[Symbol]?, module_specifier: ref[AstNode]?) returns ref[Type]?
    {
        if this.is_error_type(t)
            return t
        var file: ref[AstNode]? null
        if original_symbol <> null
        {
            let os original_symbol as ref[Symbol]
            let dn Symbol.declaration_count(os)
            var di 0
            while di < dn
            {
                let d Symbol.declaration_at(os, di)
                if (file = null) and (Checker.kind_or_unknown(d) = KindSourceFile)
                    set file: d
                set di: di + 1
            }
        }
        if this.can_have_synthetic_default(file, original_symbol, false, module_specifier) = false
            return t
        var type_name Slice[char]()
        set type_name: Binder.internal_name_unprefixed(host, "type")
        let anonymous_symbol this.new_symbol(SymbolFlagsTypeLiteral, type_name)
        let default_containing_object this.create_default_property_wrapper_for_module(symbol, original_symbol, anonymous_symbol)
        if default_containing_object = null
            return null
        let dco default_containing_object as ref[Type]
        let al this.value_symbol_link_of(anonymous_symbol)
        set al.resolved_type: dco
        if this.is_valid_spread_type(t)
            return this.get_spread_type(t, dco, anonymous_symbol, 0, false)
        dco
    }

    ; createDefaultPropertyWrapperForModule: an anonymous object type with one
    ; member, an alias `default` whose target is the module's resolved symbol
    procedure create_default_property_wrapper_for_module(this, symbol: ref[Symbol], original_symbol: ref[Symbol]?, anonymous_symbol: ref[Symbol]?) returns ref[Type]?
    {
        let member_table SymbolTable.create(host)
        var default_name Slice[char]()
        set default_name: Binder.internal_name_unprefixed(host, "default")
        let made this.new_symbol(SymbolFlagsAlias, default_name)
        set made.parent: original_symbol
        let vl this.value_symbol_link_of(made)
        set vl.name_type: this.get_string_literal_type("default")
        let al this.alias_symbol_link_of(made)
        set al.alias_target: this.resolve_symbol(symbol)
        SymbolTable.set_entry(host, member_table, default_name, made)
        this.new_anonymous_type(anonymous_symbol, member_table, null, null, null)
    }

    ; cloneTypeAsModuleType: a copy of the module symbol whose type is the module
    ; type's members. ★The reference also files the clone in `exportTypeLinks`
    ; (target, originatingImport) for two diagnostics and a services walk; this
    ; port has no such table and none of those readers.
    procedure clone_type_as_module_type(this, symbol: ref[Symbol], module_type: ref[Type], reference_parent: ref[AstNode]?) returns ref[Symbol]?
    {
        let result this.new_symbol(Symbol.flags_of(symbol), Symbol.name_of(symbol))
        let decls &Array[ref[AstNode]?]^host()
        let dn Symbol.declaration_count(symbol)
        var di 0
        while di < dn
        {
            decls.add(Symbol.declaration_at(symbol, di))
            set di: di + 1
        }
        Symbol.set_declarations(result, decls)
        set result.value_declaration: Symbol.value_declaration_of(symbol)
        set result.members: this.symbol_table_shallow_copy(Symbol.members_of(symbol))
        set result.exports: this.symbol_table_shallow_copy(Symbol.exports_of(symbol))
        set result.parent: Symbol.parent_of(symbol)
        let resolved this.resolve_structured_type_members(module_type)
        if resolved = null
            return null
        let rm resolved as ref[StructuredMembers]
        let cloned this.new_anonymous_type(result, rm.members, null, null, rm.index_infos)
        if cloned = null
            return null
        let rl this.value_symbol_link_of(result)
        set rl.resolved_type: cloned
        result
    }

    ; maps.Clone over a symbol table (null stays null)
    procedure symbol_table_shallow_copy(this, t: ref[SymbolTable]?) returns ref[SymbolTable]?
    {
        if t = null
            return null
        let copy SymbolTable.create(host)
        let n SymbolTable.length(t)
        var i 0
        while i < n
        {
            SymbolTable.set_entry(host, copy, SymbolTable.entry_name_at(t, i), SymbolTable.entry_symbol_at(t, i))
            set i: i + 1
        }
        copy
    }

    procedure has_signatures(this, t: ref[Type]) returns bool
    {
        if Checker.sig_count(this.get_signatures_of_structured_type(t, SignatureKindCall)) > 0
            return true
        Checker.sig_count(this.get_signatures_of_structured_type(t, SignatureKindConstruct)) > 0
    }

    ; ast.GetNamespaceDeclarationNode — the `* as ns` binding of an import
    ; declaration, nil for every other shape.
    function get_namespace_declaration_node(node: ref[AstNode]?) returns ref[AstNode]?
    {
        let clause AstNode.import_clause_of(node)
        if clause = null
            return null
        let nb AstNode.named_bindings_of(clause)
        if Checker.kind_or_unknown(nb) = KindNamespaceImport
            return nb
        null
    }

    ; getExternalModuleMember.
    procedure get_external_module_member(this, node: ref[AstNode], specifier: ref[AstNode], dont_resolve_alias: bool) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        var module_specifier this.get_external_module_require_argument(node)
        if this.unported_mark() <> unported_before
            return null
        if module_specifier = null
            set module_specifier: this.get_external_module_name(node)
        if this.unported_mark() <> unported_before
            return null
        let module_symbol this.resolve_external_module_name(node, module_specifier, false)
        var name: ref[AstNode]? null
        if AstNode.kind_of(specifier) = KindPropertyAccessExpression
            set name: AstNode.property_access_name_of(specifier)
        else
            set name: Checker.property_name_or_name_of(specifier)
        if name = null
            return null
        let nm name as ref[AstNode]
        let nk AstNode.kind_of(nm)
        var spellable false
        if nk = KindIdentifier
            set spellable: true
        if nk = KindStringLiteral
            set spellable: true
        if spellable = false
            return null
        let nt Checker.module_export_name_text(nm)
        let target_symbol this.resolve_es_module_symbol(module_symbol, specifier, module_specifier)
        if this.unported_mark() <> unported_before
            return null
        if target_symbol = null
            return null
        ; "Note: The empty string is a valid module export name" — `import { "" as
        ; foo }` — so an empty IDENTIFIER text is the only thing that falls through.
        if nt.length = 0
        {
            if nk <> KindStringLiteral
                return null
        }
        if module_symbol <> null
        {
            if Checker.is_shorthand_ambient_module_symbol(module_symbol as ref[Symbol])
                return module_symbol
        }
        let ts target_symbol as ref[Symbol]
        var has_export_equals false
        if module_symbol <> null
            set has_export_equals: this.has_export_assignment_symbol(module_symbol as ref[Symbol])
        var symbol_from_variable: ref[Symbol]? null
        if has_export_equals
        {
            let t this.get_type_of_symbol(ts)
            if t = null
                return null
            set symbol_from_variable: this.get_property_of_type_ex(t as ref[Type], Slice[char](nt.length, nt.data), true, false)
        }
        else
            set symbol_from_variable: this.get_property_of_variable(ts, Slice[char](nt.length, nt.data))
        if this.unported_mark() <> unported_before
            return null
        set symbol_from_variable: this.resolve_symbol_ex(symbol_from_variable, dont_resolve_alias)
        var export_container ts
        if has_export_equals
            set export_container: module_symbol as ref[Symbol]
        var symbol_from_module this.get_export_of_module(export_container, Slice[char](nt.length, nt.data), specifier, dont_resolve_alias)
        if this.unported_mark() <> unported_before
            return null
        if symbol_from_module = null
        {
            if Checker.name_bytes_are(nt, "default")
            {
                if module_symbol = null
                    return null
                let ms module_symbol as ref[Symbol]
                let file Checker.find_source_file_declaration(ms)
                var synthetic this.is_only_importable_as_default(module_specifier, ms)
                if synthetic = false
                    set synthetic: this.can_have_synthetic_default(file, ms, dont_resolve_alias, module_specifier)
                if this.unported_mark() <> unported_before
                    return null
                if synthetic
                {
                    set symbol_from_module: this.resolve_external_module_symbol(ms, dont_resolve_alias)
                    if symbol_from_module = null
                        set symbol_from_module: this.resolve_symbol_ex(ms, dont_resolve_alias)
                }
            }
        }
        var symbol symbol_from_variable
        if symbol_from_module <> null
        {
            set symbol: symbol_from_module
            if symbol_from_variable <> null
            {
                set symbol: this.combine_value_and_type_symbols(symbol_from_variable as ref[Symbol], symbol_from_module as ref[Symbol])
                if this.unported_mark() <> unported_before
                    return null
            }
        }
        var named_json_import false
        if AstNode.is_import_or_export_specifier(specifier) and (Checker.name_bytes_are(nt, "default") = false)
            set named_json_import: this.is_only_importable_as_default(module_specifier, module_symbol)
        if named_json_import
            this.error_on_node(nm, DiagNamed_imports_from_a_JSON_file_into_an_ECMAScript_module_are_not_allowed_when_module_is_set_to_0, Checker.module_kind_name(module_kind))
        else
        {
            if symbol = null
                this.error_no_module_member_symbol(module_symbol, target_symbol, node, nm)
        }
        symbol
    }

    ; getTargetOfImportEqualsDeclaration. ★The moduleExports fork needs
    ; `Node20 <= moduleKind <= NodeNext` and is dead by value.
    procedure get_target_of_import_equals_declaration(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        var external false
        if AstNode.kind_of(node) = KindVariableDeclaration
            set external: true
        if AstNode.kind_of(node) = KindImportEqualsDeclaration
        {
            if AstNode.import_equals_reference_kind(node) = KindExternalModuleReference
                set external: true
        }
        if external
        {
            var module_reference this.get_external_module_require_argument(node)
            if this.unported_mark() <> unported_before
                return null
            if module_reference = null
                set module_reference: this.get_external_module_name(node)
            if this.unported_mark() <> unported_before
                return null
            let immediate this.resolve_external_module_name(node, module_reference, false)
            let resolved this.resolve_external_module_symbol(immediate, true)
            if (resolved <> null) and (module_kind >= ModuleKindNode20) and (module_kind <= ModuleKindNodeNext)
            {
                var me Slice[char]()
                set me: Binder.internal_name_unprefixed(host, "module.exports")
                let module_exports this.get_export_of_module(resolved as ref[Symbol], me, node, true)
                if this.unported_mark() <> unported_before
                    return null
                if module_exports <> null
                    return module_exports
            }
            this.mark_symbol_of_alias_declaration_if_type_only(node, null)
            return resolved
        }
        let resolved this.get_symbol_of_part_of_right_hand_side_of_import_equals(AstNode.module_reference_of(node))
        this.check_and_report_error_for_resolving_import_alias_to_type_only_symbol(node, resolved)
        resolved
    }

    ; getSymbolOfPartOfRightHandSideOfImportEquals — the reference's own three
    ; cases, with its comment as the map: `import a = |b|` is a NAMESPACE,
    ; `import a = |b.c|` is value/type/namespace, `import a = |b.c|.d` is a
    ; namespace again.
    procedure get_symbol_of_part_of_right_hand_side_of_import_equals(this, entity_name: ref[AstNode]?) returns ref[Symbol]?
    {
        if entity_name = null
            return null
        var en entity_name as ref[AstNode]
        if AstNode.kind_of(en) = KindIdentifier
        {
            if Checker.is_right_side_of_qualified_name_or_property_access(en)
                set en: AstNode.parent_node_of(en) as ref[AstNode]
        }
        var namespace_case false
        if AstNode.kind_of(en) = KindIdentifier
            set namespace_case: true
        if Checker.kind_or_unknown(AstNode.parent_node_of(en)) = KindQualifiedName
            set namespace_case: true
        if namespace_case
            return this.resolve_entity_name(en, SymbolFlagsNamespace, false, true, null)
        this.resolve_entity_name(en, SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace, false, true, null)
    }

    ; isRightSideOfQualifiedNameOrPropertyAccess.
    function is_right_side_of_qualified_name_or_property_access(node: ref[AstNode]) returns bool
    {
        let p AstNode.parent_node_of(node)
        let pk Checker.kind_or_unknown(p)
        if pk = KindQualifiedName
            return AstNode.qualified_right_of(p) = node
        if pk = KindPropertyAccessExpression
            return AstNode.property_access_name_of(p as ref[AstNode]) = node
        ; ★★★ THE META PROPERTY IS THE THIRD ARM AND IT WAS MISSING (slice 133).
        ; `meta` in `import.meta` is the RIGHT side of its parent exactly as `b` in
        ; `a.b` is, so getRegularTypeOfExpression asks the PARENT and the identifier
        ; answers ImportMeta. Without the arm it resolved as a NAME, found nothing
        ; and answered errorType — invisible until slice 133 gave the meta property
        ; itself an answer, which is §3.5er: the wall was the only thing keeping the
        ; wrong answer out of the comparison.
        if pk = KindMetaProperty
            return AstNode.name_of(p as ref[AstNode]) = node
        false
    }

    ; checkAndReportErrorForResolvingImportAliasToTypeOnlySymbol. ★The related info
    ; is invisible to this yardstick; what has to be exact is the pair of codes and
    ; the span, which is the module REFERENCE.
    procedure check_and_report_error_for_resolving_import_alias_to_type_only_symbol(this, node: ref[AstNode], resolved: ref[Symbol]?)
    {
        let unported_before this.unported_mark()
        var name AstNode.module_reference_of(node)
        repeat
        {
            if name = null
                break
            let type_only this.get_type_only_declaration_of_entity_name(name as ref[AstNode])
            if this.unported_mark() <> unported_before
                break
            if type_only <> null
            {
                let tk AstNode.kind_of(type_only as ref[AstNode])
                var is_export false
                if tk = KindExportSpecifier
                    set is_export: true
                if tk = KindExportDeclaration
                    set is_export: true
                let alias_mark this.diagnostic_mark()
                if is_export
                    this.error_on_node(AstNode.module_reference_of(node), DiagAn_import_alias_cannot_reference_a_declaration_that_was_exported_using_export_type)
                else
                    this.error_on_node(AstNode.module_reference_of(node), DiagAn_import_alias_cannot_reference_a_declaration_that_was_imported_using_import_type)
                var related_code DiagX_0_was_imported_here
                if is_export
                    set related_code: DiagX_0_was_exported_here
                var type_only_name String("*")
                if tk <> KindExportDeclaration
                    set type_only_name: Checker.arg_text(AstNode.identifier_text_of(AstNode.name_of(type_only as ref[AstNode])))
                this.related_info_since(alias_mark, type_only, related_code, type_only_name)
                break
            }
            if AstNode.kind_of(name as ref[AstNode]) = KindIdentifier
                break
            set name: AstNode.qualified_left_of(name)
        }
    }

    ; getTypeOnlyDeclarationOfEntityName.
    procedure get_type_only_declaration_of_entity_name(this, name: ref[AstNode]) returns ref[AstNode]?
    {
        let symbol this.resolve_entity_name(name, SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace, true, true, null)
        if symbol = null
            return null
        this.get_type_only_alias_declaration(symbol as ref[Symbol])
    }

    ; getTargetOfImportClause.
    procedure get_target_of_import_clause(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        let spec this.get_module_specifier_from_node(AstNode.parent_node_of(node))
        if this.unported_mark() <> unported_before
            return null
        let module_symbol this.resolve_external_module_name(node, spec, false)
        if module_symbol = null
            return null
        this.get_target_of_module_default(module_symbol as ref[Symbol], node, true)
    }

    ; getTargetOfNamespaceImport.
    procedure get_target_of_namespace_import(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        let spec this.get_module_specifier_for_import_or_export(node)
        if this.unported_mark() <> unported_before
            return null
        let immediate this.resolve_external_module_name(node, spec, false)
        let resolved this.resolve_es_module_symbol(immediate, node, spec)
        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
        resolved
    }

    ; getTargetOfNamespaceExport.
    procedure get_target_of_namespace_export(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        let spec this.get_module_specifier_for_import_or_export(node)
        if this.unported_mark() <> unported_before
            return null
        if spec = null
            return null
        let immediate this.resolve_external_module_name(node, spec, false)
        let resolved this.resolve_es_module_symbol(immediate, node, spec)
        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
        resolved
    }

    ; getTargetOfImportSpecifier.
    procedure get_target_of_import_specifier(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        let name Checker.property_name_or_name_of(node)
        if AstNode.kind_of(node) = KindImportSpecifier
        {
            if Checker.module_export_name_is_default(name)
            {
                let spec this.get_module_specifier_for_import_or_export(node)
                if this.unported_mark() <> unported_before
                    return null
                if spec <> null
                {
                    let module_symbol this.resolve_external_module_name(node, spec, false)
                    if module_symbol <> null
                        return this.get_target_of_module_default(module_symbol as ref[Symbol], node, true)
                }
            }
        }
        var root: ref[AstNode]? AstNode.parent_node_of(AstNode.parent_node_of(AstNode.parent_node_of(node)))
        if AstNode.kind_of(node) = KindBindingElement
            set root: Binder.get_root_declaration(node)
        if root = null
            return null
        let resolved this.get_external_module_member(root as ref[AstNode], node, true)
        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
        resolved
    }

    ; getTargetOfExportSpecifier.
    procedure get_target_of_export_specifier(this, node: ref[AstNode], meaning: int, dont_resolve_alias: bool) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        let name Checker.property_name_or_name_of(node)
        if Checker.module_export_name_is_default(name)
        {
            let spec this.get_module_specifier_for_import_or_export(node)
            if this.unported_mark() <> unported_before
                return null
            if spec <> null
            {
                let module_symbol this.resolve_external_module_name(node, spec, false)
                if module_symbol <> null
                    return this.get_target_of_module_default(module_symbol as ref[Symbol], node, dont_resolve_alias)
            }
        }
        let export_declaration AstNode.parent_node_of(AstNode.parent_node_of(node))
        var resolved: ref[Symbol]? null
        if AstNode.module_specifier_of(export_declaration) <> null
            set resolved: this.get_external_module_member(export_declaration as ref[AstNode], node, dont_resolve_alias)
        else
        {
            if Checker.kind_or_unknown(name) <> KindStringLiteral
                set resolved: this.resolve_entity_name(name as ref[AstNode], meaning, false, dont_resolve_alias, null)
        }
        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
        resolved
    }

    ; getTargetOfExportAssignment / getTargetOfBinaryExpression.
    procedure get_target_of_export_assignment(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let resolved this.get_target_of_alias_like_expression(AstNode.expression_of(node))
        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
        resolved
    }

    procedure get_target_of_binary_expression(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let resolved this.get_target_of_alias_like_expression(AstNode.binary_right_of(node))
        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
        resolved
    }

    ; getTargetOfAliasLikeExpression.
    procedure get_target_of_alias_like_expression(this, expression: ref[AstNode]?) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        if expression = null
            return null
        let e expression as ref[AstNode]
        if AstNode.kind_of(e) = KindClassExpression
        {
            let t this.check_expression_cached(e)
            if t = null
                return null
            return (t as ref[Type]).symbol
        }
        var entity false
        if Checker.is_entity_name(e)
            set entity: true
        if Checker.is_entity_name_expression(e)
            set entity: true
        if entity = false
            return null
        let alias_like this.resolve_entity_name(e, SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace, true, true, null)
        if alias_like <> null
            return alias_like
        if this.unported_mark() <> unported_before
            return null
        this.check_expression_cached(e)
        this.get_resolved_symbol_or_nil(e)
    }

    ; getTargetOfNamespaceExportDeclaration.
    procedure get_target_of_namespace_export_declaration(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let p AstNode.parent_node_of(node)
        let sym AstNode.symbol_of(p)
        if sym = null
            return null
        let resolved this.resolve_external_module_symbol(sym, true)
        this.mark_symbol_of_alias_declaration_if_type_only(node, null)
        resolved
    }

    ; getTargetOfAccessExpression.
    procedure get_target_of_access_expression(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let p AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(p) <> KindBinaryExpression
            return null
        if AstNode.binary_left_of(p) <> node
            return null
        if AstNode.binary_operator_kind(p) <> KindEqualsToken
            return null
        this.get_target_of_alias_like_expression(AstNode.binary_right_of(p))
    }

    ; getTargetOfAliasDeclaration — the dispatch. ★The reference PANICS on an
    ; unhandled kind and the tail reports instead.
    procedure get_target_of_alias_declaration(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let k AstNode.kind_of(node)
        if k = KindImportEqualsDeclaration
            return this.get_target_of_import_equals_declaration(node)
        if k = KindVariableDeclaration
            return this.get_target_of_import_equals_declaration(node)
        if k = KindImportClause
            return this.get_target_of_import_clause(node)
        if k = KindNamespaceImport
            return this.get_target_of_namespace_import(node)
        if k = KindNamespaceExport
            return this.get_target_of_namespace_export(node)
        if k = KindImportSpecifier
            return this.get_target_of_import_specifier(node)
        if k = KindBindingElement
            return this.get_target_of_import_specifier(node)
        if k = KindExportSpecifier
            return this.get_target_of_export_specifier(node, SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace, true)
        if k = KindExportAssignment
            return this.get_target_of_export_assignment(node)
        if k = KindBinaryExpression
            return this.get_target_of_binary_expression(node)
        if k = KindNamespaceExportDeclaration
            return this.get_target_of_namespace_export_declaration(node)
        if k = KindShorthandPropertyAssignment
            return this.resolve_entity_name(AstNode.name_of(node) as ref[AstNode], SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace, true, true, null)
        if k = KindPropertyAssignment
            return this.get_target_of_alias_like_expression(AstNode.initializer_of(node))
        if k = KindElementAccessExpression
            return this.get_target_of_access_expression(node)
        if k = KindPropertyAccessExpression
            return this.get_target_of_access_expression(node)
        this.record_unported("target-of-alias-declaration", k)
        null
    }

    ; A shallow copy of a symbol table — `maps.Clone(symbol.Exports)`.
    procedure clone_symbol_table(this, t: ref[SymbolTable]?) returns ref[SymbolTable]
    {
        let out SymbolTable.create(host)
        let n SymbolTable.length(t)
        var i 0
        while i < n
        {
            SymbolTable.set_entry(host, out, SymbolTable.entry_name_at(t, i), SymbolTable.entry_symbol_at(t, i))
            set i: i + 1
        }
        out
    }

    ; extendExportSymbols. ★The lookupTable is what makes TS2308 possible at all:
    ; it records, per name, WHICH `export *` first contributed it and which later
    ; ones contributed a DIFFERENT symbol under the same name.
    procedure extend_export_symbols(this, target: ref[SymbolTable], source: ref[SymbolTable]?, lookup: ref[Array[ref[ExportCollision]?]]?, export_node: ref[AstNode]?)
    {
        var dd Slice[char]()
        set dd: Binder.internal_name_unprefixed(host, "default")
        let n SymbolTable.length(source)
        var i 0
        while i < n
        {
            let id_data SymbolTable.entry_name_at(source, i)
            let id_len SymbolTable.entry_name_len_at(source, i)
            let source_symbol SymbolTable.entry_symbol_at(source, i)
            var is_default false
            if id_len = dd.length
            {
                if SymbolTable.names_equal(id_data, dd)
                    set is_default: true
            }
            if is_default = false
            {
                let target_symbol SymbolTable.get(target, id_data)
                if target_symbol = null
                {
                    SymbolTable.set_entry(host, target, id_data, source_symbol)
                    if lookup <> null
                    {
                        if export_node <> null
                            (lookup as ref[Array[ref[ExportCollision]?]]).add(&ExportCollision^host(id_data, export_node))
                    }
                }
                else
                {
                    if lookup <> null
                    {
                        if export_node <> null
                        {
                            let a this.resolve_symbol(target_symbol)
                            let b this.resolve_symbol(source_symbol)
                            if Checker.symbol_option_differs(a, b)
                            {
                                let row Checker.find_export_collision(lookup, id_data)
                                if row <> null
                                {
                                    let r row as ref[ExportCollision]
                                    if r.dups = null
                                        set r.dups: &Array[ref[AstNode]?]^host()
                                    (r.dups as ref[Array[ref[AstNode]?]]).add(export_node)
                                }
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; `a != b` over two optional symbols.
    function symbol_option_differs(a: ref[Symbol]?, b: ref[Symbol]?) returns bool
    {
        if a = null
            return b <> null
        if b = null
            return true
        (a as ref[Symbol]) <> (b as ref[Symbol])
    }

    function find_export_collision(lookup: ref[Array[ref[ExportCollision]?]], d: Slice[char]) returns ref[ExportCollision]?
    {
        let len lookup.get_length() as int
        var i 0
        while i < len
        {
            let row lookup[i]
            if row <> null
            {
                let r row as ref[ExportCollision]
                if SymbolTable.names_equal(r.name, d)
                    return r
            }
            set i: i + 1
        }
        null
    }

    ; getExportsOfModuleWorker's `visit`, as a method: the closure's captured state
    ; is the visited list, threaded through.
    ;
    ; ★ `nonTypeOnlyNames` and the star map are threaded the same way, for the same
    ; reason: both belong to the WHOLE worker call and not to one visit, and the
    ; reference expresses that by closing over them. The set's one reader is the
    ; worker's final loop, which removes every name an ordinary `export *` also
    ; brought — an `export type *` and an `export *` contributing the same name make
    ; that name a VALUE export, whichever order the two were visited in, which is
    ; why the removal is a post-pass rather than a test at the write.
    procedure exports_of_module_visit(this, symbol: ref[Symbol]?, export_star: ref[AstNode]?, is_type_only: bool, visited: ref[Array[ref[Symbol]?]], star_map: ref[Array[ref[TypeOnlyExportStar]?]], non_type_only: ref[SymbolTable]) returns ref[SymbolTable]?
    {
        let unported_before this.unported_mark()
        ; "Add non-type-only names before checking if we've visited this module,
        ; because we might have visited it via an 'export type *', and visiting again
        ; with 'export *' will override the type-onlyness of its exports."
        if is_type_only = false
        {
            if symbol <> null
            {
                let ns symbol as ref[Symbol]
                let nt Symbol.exports_of(ns)
                let nn SymbolTable.length(nt)
                var ni 0
                while ni < nn
                {
                    let nsym SymbolTable.entry_symbol_at(nt, ni)
                    if nsym <> null
                        SymbolTable.set_entry(host, non_type_only, SymbolTable.entry_name_at(nt, ni), nsym)
                    set ni: ni + 1
                }
            }
        }
        if symbol = null
            return null
        let s symbol as ref[Symbol]
        if Symbol.exports_of(s) = null
            return null
        if Checker.symbol_list_has(visited, s)
            return null
        visited.add(s)
        let symbols this.clone_symbol_table(Symbol.exports_of(s))
        var sd Slice[char]()
        set sd: Binder.internal_name(host, "export")
        let export_stars SymbolTable.get(Symbol.exports_of(s), sd)
        if export_stars <> null
        {
            let nested SymbolTable.create(host)
            let lookup &Array[ref[ExportCollision]?]^host()
            let es export_stars as ref[Symbol]
            let dn Symbol.declaration_count(es)
            var i 0
            while i < dn
            {
                let node Symbol.declaration_at(es, i)
                set i: i + 1
                if node = null
                    continue
                let nd node as ref[AstNode]
                let resolved this.resolve_external_module_name(nd, AstNode.module_specifier_of(nd), false)
                var to is_type_only
                if AstNode.is_type_only_of(nd)
                    set to: true
                let exported this.exports_of_module_visit(resolved, nd, to, visited, star_map, non_type_only)
                if this.unported_mark() <> unported_before
                    return symbols
                this.extend_export_symbols(nested, exported, lookup, nd)
                set i: i
            }
            var ed Slice[char]()
            set ed: Binder.internal_name_unprefixed(host, "export=")
            let ln lookup.get_length() as int
            var j 0
            while j < ln
            {
                let row lookup[j]
                set j: j + 1
                if row = null
                    continue
                let r row as ref[ExportCollision]
                if r.dups = null
                    continue
                if SymbolTable.names_equal(r.name, ed)
                    continue
                if SymbolTable.get(symbols, r.name) <> null
                    continue
                let dups r.dups as ref[Array[ref[AstNode]?]]
                let cn dups.get_length() as int
                var k 0
                while k < cn
                {
                    var specifier_text String("")
                    if r.specifier_node <> null
                        set specifier_text: this.node_text_arg(AstNode.module_specifier_of(r.specifier_node as ref[AstNode]))
                    this.error_on_node(dups[k], DiagModule_0_has_already_exported_a_member_named_1_Consider_explicitly_re_exporting_to_resolve_the_ambiguity, specifier_text, Checker.arg_text(r.name))
                    set k: k + 1
                }
            }
            this.extend_export_symbols(symbols, nested, null, null)
        }
        if export_star <> null
        {
            if AstNode.is_type_only_of(export_star)
            {
                ; Every name this module contributes came in through an
                ; `export type *`, so each maps to THIS declaration. A later write
                ; for the same name overwrites, exactly as the reference's map does.
                let sn SymbolTable.length(symbols)
                var si 0
                while si < sn
                {
                    let snd SymbolTable.entry_name_at(symbols, si)
                    let snl SymbolTable.entry_name_len_at(symbols, si)
                    let row Checker.type_only_export_star_row(star_map, snd)
                    if row = null
                        star_map.add(&TypeOnlyExportStar^host(snd, export_star))
                    else
                    {
                        let r row as ref[TypeOnlyExportStar]
                        set r.node: export_star
                    }
                    set si: si + 1
                }
            }
        }
        symbols
    }

    ; The star map's lookup by name, shared by its writer and its two readers.
    function type_only_export_star_row(star_map: ref[Array[ref[TypeOnlyExportStar]?]], d: Slice[char]) returns ref[TypeOnlyExportStar]?
    {
        let len star_map.get_length() as int
        var i 0
        while i < len
        {
            let row star_map[i]
            if row <> null
            {
                let r row as ref[TypeOnlyExportStar]
                if r.node <> null
                {
                    if SymbolTable.names_equal(r.name, d)
                        return row
                }
            }
            set i: i + 1
        }
        null
    }

    ; getExportsOfModuleWorker. ★The Go signature returns the pair
    ; `(exports, typeOnlyExportStarMap)`; here the map is the CALLER's container
    ; (§3.6 — the discriminant is the result, the payload is the cell), because its
    ; one caller is the memo that has to store both halves anyway.
    procedure get_exports_of_module_worker(this, module_symbol: ref[Symbol]?, star_map: ref[Array[ref[TypeOnlyExportStar]?]]) returns ref[SymbolTable]
    {
        let visited &Array[ref[Symbol]?]^host()
        let non_type_only SymbolTable.create(host)
        var ed Slice[char]()
        set ed: Binder.internal_name_unprefixed(host, "export=")
        var original: ref[Symbol]? null
        if module_symbol <> null
        {
            let ms module_symbol as ref[Symbol]
            if this.resolve_symbol_ex(SymbolTable.get(Symbol.exports_of(ms), ed), false) <> null
                set original: module_symbol
        }
        let resolved this.resolve_external_module_symbol(module_symbol, false)
        var exports this.exports_of_module_visit(resolved, null, false, visited, star_map, non_type_only)
        if exports = null
            set exports: this.clone_symbol_table(null)
        let out exports as ref[SymbolTable]
        ; "A CommonJS module defined by an 'export=' might also export typedefs,
        ; stored on the original module."
        if original <> null
        {
            let om original as ref[Symbol]
            var sd Slice[char]()
            set sd: Binder.internal_name(host, "export")
            let n SymbolTable.length(Symbol.exports_of(om))
            if n > 1
            {
                var i 0
                while i < n
                {
                    let nd SymbolTable.entry_name_at(Symbol.exports_of(om), i)
                    let nl SymbolTable.entry_name_len_at(Symbol.exports_of(om), i)
                    let sym SymbolTable.entry_symbol_at(Symbol.exports_of(om), i)
                    set i: i + 1
                    if sym = null
                        continue
                    if SymbolTable.names_equal(nd, ed)
                        continue
                    if SymbolTable.names_equal(nd, sd)
                        continue
                    let flags this.get_symbol_flags(sym as ref[Symbol])
                    if (flags & (SymbolFlagsType | SymbolFlagsNamespace)) = 0
                        continue
                    if (flags & SymbolFlagsValue) <> 0
                        continue
                    if SymbolTable.get(out, nd) <> null
                        continue
                    SymbolTable.set_entry(host, out, nd, sym)
                }
            }
        }
        ; `for name := range nonTypeOnlyNames { delete(typeOnlyExportStarMap, name) }`
        ; — a row is deleted by clearing its NODE, which is also what
        ; type_only_export_star_row treats as absent.
        let tn SymbolTable.length(non_type_only)
        var ti 0
        while ti < tn
        {
            let row Checker.type_only_export_star_row(star_map, SymbolTable.entry_name_at(non_type_only, ti))
            if row <> null
            {
                let r row as ref[TypeOnlyExportStar]
                set r.node: null
            }
            set ti: ti + 1
        }
        out
    }

    ; getExportsOfModule — the memo, and it is a REPORT memo as well as a work one:
    ; the worker's export-star loop resolves every specifier WITH errors.
    ;
    ; ★ The star map is memoized with the exports and on the same test, because the
    ; reference fills both from the one worker call: reading it off a second call
    ; would report the export-star specifiers twice.
    procedure get_exports_of_module(this, module_symbol: ref[Symbol]) returns ref[SymbolTable]?
    {
        let links this.module_symbol_link_of(module_symbol)
        if links.resolved_exports = null
        {
            let star_map &Array[ref[TypeOnlyExportStar]?]^host()
            set links.resolved_exports: this.get_exports_of_module_worker(module_symbol, star_map)
            set links.type_only_export_star: star_map
        }
        links.resolved_exports
    }

    ; The star map's read side, at the two places the reference asks for one: a
    ; name's `export type *` declaration, or nil.
    procedure type_only_export_star_declaration(this, module_symbol: ref[Symbol], d: Slice[char]) returns ref[AstNode]?
    {
        let links this.module_symbol_link_of(module_symbol)
        if links.type_only_export_star = null
            return null
        let row Checker.type_only_export_star_row(links.type_only_export_star as ref[Array[ref[TypeOnlyExportStar]?]], d)
        if row = null
            return null
        (row as ref[TypeOnlyExportStar]).node
    }

    ; resolveQualifiedName. ★The isCommonJSRequire block is dead by value:
    ; `GetModuleResolutionKind() != Bundler` is its second conjunct and the
    ; derivation answers Bundler under this harness (see resolve_external_module's
    ; header). ★`canSuggestTypeof` needs `globalObjectType != nil`, i.e. the lib, so
    ; tryGetQualifiedNameAsValue has no reader here and is not written.
    procedure resolve_qualified_name(this, name: ref[AstNode], left: ref[AstNode]?, right: ref[AstNode]?, meaning: int, ignore_errors: bool, location: ref[AstNode]?) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        if left = null
            return null
        let namespace this.resolve_entity_name(left as ref[AstNode], SymbolFlagsNamespace, ignore_errors, false, location)
        if namespace = null
            return null
        if Binder.node_is_missing(right)
            return null
        let ns namespace as ref[Symbol]
        if ns = unknown_symbol
            return namespace
        let text Checker.module_export_name_text(right)
        let exports this.get_exports_of_symbol(ns)
        if this.unported_mark() <> unported_before
            return null
        var symbol this.get_merged_symbol(this.lookup_symbol(exports, Slice[char](text.length, text.data), meaning))
        if symbol = null
        {
            if (Symbol.flags_of(ns) & SymbolFlagsAlias) <> 0
            {
                let target this.resolve_alias(ns)
                if target = null
                    return null
                let te this.get_exports_of_symbol(target as ref[Symbol])
                if this.unported_mark() <> unported_before
                    return null
                set symbol: this.get_merged_symbol(this.lookup_symbol(te, Slice[char](text.length, text.data), meaning))
            }
        }
        if symbol <> null
            return symbol
        if ignore_errors
            return null
        let namespace_name this.fully_qualified_name_arg(ns)
        let declaration_name this.declaration_name_to_string(right)
        ; The suggestion fork decides the CODE (TS2724 against TS2694).
        ; ★getSuggestedSymbolForNonexistentModule is asked UNCONDITIONALLY upstream
        ; here — unlike errorNoModuleMemberSymbol, which guards on the name being
        ; an identifier — and `right` is a qualified name's right half, so it is
        ; one whenever the node exists.
        if right <> null
        {
            let sug_mark this.unported_mark()
            let suggestion this.get_suggested_symbol_for_nonexistent_module(right as ref[AstNode], namespace)
            if this.unported_mark() <> sug_mark
                return null
            if suggestion <> null
            {
                this.error_on_node(right, DiagX_0_has_no_exported_member_named_1_Did_you_mean_2, namespace_name, declaration_name, this.symbol_arg(suggestion))
                return null
            }
        }
        ; canSuggestTypeof. ★★★ THE HEADER'S CLAIM THAT IT IS DEAD IS NOT WHAT
        ; DECIDES IT ANY MORE: that note rested on the suggestion fork above
        ; stopping first, so nothing ever reached this line. With the fork ported
        ; the term is live, and answering the NEXT report without asking it would
        ; report TS2694 where the reference reports TS2749.
        if this.get_global_object_type() <> null
        {
            if (meaning & SymbolFlagsType) <> 0
            {
                ; ★★★ THE GUARD IS `ast.IsQualifiedName(name)` AND THIS ASKED THE
                ; PARENT UNTIL SLICE 185. `name` is already the qualified name at
                ; every call that can reach here, and its parent is the TYPE
                ; REFERENCE — so the term was dead for the commonest shape there
                ; is: `var b: A.B` where `A.B` is a function/namespace merge
                ; reported TS2694 at `B` where the reference reports TS2749 at
                ; `A.B`. The block BELOW asks the parent and is right to: upstream
                ; spells that one `ast.IsQualifiedName(name.Parent)`.
                var containing: ref[AstNode]? null
                if AstNode.kind_of(name) = KindQualifiedName
                    set containing: Checker.containing_qualified_name_node(name)
                if containing <> null
                {
                    let cn containing as ref[AstNode]
                    if Checker.kind_or_unknown(AstNode.parent_node_of(cn)) <> KindTypeOfExpression
                    {
                        let v this.try_get_qualified_name_as_value(cn)
                        if this.unported_mark() <> unported_before
                            return null
                        if v <> null
                        {
                            this.error_on_node(cn, DiagX_0_refers_to_a_value_but_is_being_used_as_a_type_here_Did_you_mean_typeof_0, this.entity_name_arg(cn))
                            return null
                        }
                    }
                }
            }
        }
        if (meaning & SymbolFlagsNamespace) <> 0
        {
            if Checker.kind_or_unknown(AstNode.parent_node_of(name)) = KindQualifiedName
            {
                let exported_type this.get_merged_symbol(this.lookup_symbol(exports, Slice[char](text.length, text.data), SymbolFlagsType))
                if exported_type <> null
                {
                    let qualified_right AstNode.qualified_right_of(AstNode.parent_node_of(name))
                    this.error_on_node(qualified_right, DiagCannot_access_0_1_because_0_is_a_type_but_not_a_namespace_Did_you_mean_to_retrieve_the_type_of_the_property_1_in_0_with_0_1, this.symbol_arg(exported_type), Checker.arg_text(AstNode.identifier_text_of(qualified_right)))
                    return null
                }
            }
        }
        this.error_on_node(right, DiagNamespace_0_has_no_exported_member_1, namespace_name, declaration_name)
        null
    }

    ; getContainingQualifiedNameNode — the OUTERMOST qualified name `node` is the
    ; left spine of.
    function containing_qualified_name_node(node: ref[AstNode]) returns ref[AstNode]
    {
        var n node
        while Checker.kind_or_unknown(AstNode.parent_node_of(n)) = KindQualifiedName
            set n: AstNode.parent_node_of(n) as ref[AstNode]
        n
    }

    ; tryGetQualifiedNameAsValue, whole. ★The name resolution passes NO
    ; not-found message, so the walk down the spine is silent and its only product
    ; is the symbol canSuggestTypeof tests for presence.
    procedure try_get_qualified_name_as_value(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let mark this.unported_mark()
        let id_opt Checker.get_first_identifier(node)
        if id_opt = null
            return null
        let id id_opt as ref[AstNode]
        var symbol this.resolve_name(id, AstNode.identifier_text_of(id), SymbolFlagsValue, 0, true, false)
        if this.unported_mark() <> mark
            return null
        if symbol = null
            return null
        var n id
        while Checker.kind_or_unknown(AstNode.parent_node_of(n)) = KindQualifiedName
        {
            let t this.get_type_of_symbol(symbol as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            if t = null
                return null
            let right AstNode.qualified_right_of(AstNode.parent_node_of(n))
            if right = null
                return null
            let r right as ref[AstNode]
            set symbol: this.get_property_of_type(t as ref[Type], AstNode.identifier_text_of(r))
            if this.unported_mark() <> mark
                return null
            if symbol = null
                return null
            set n: AstNode.parent_node_of(n) as ref[AstNode]
        }
        symbol
    }

    ; ── The reference-marking family, as much of it as one caller needs ──────
    ;
    ; ★★★ THE WHOLE FAMILY IS REPORT-FREE and that is why it can be ported without
    ; a chapter of its own: its product is a `referenced` BIT read by the emit
    ; resolver, which this port does not have. What it is ported FOR is its SIDE
    ; EFFECTS — it calls resolveAlias, getSymbolFlagsEx and getResolvedSymbol, each
    ; of which reports — so leaving it out would be a missing report rather than a
    ; missing bit, and stopping on it would suppress a unit the reference completes.
    ;
    ; ★ `canCollectSymbolAliasAccessibilityData` is
    ; `VerbatimModuleSyntax.IsFalseOrUnknown()`, i.e. TRUE under this harness, so
    ; the guard at the head of both entry points is live and passes.

    ; markLinkedReferences — the ExportSpecifier arm, which is the one this slice's
    ; caller passes. The other seven hints have no ported caller; each reports
    ; rather than falling through, because falling through would claim the marking
    ; ran.
    ; ═══ emitresolver.go — the four answers the import-elision transformer asks (slice 237) ═══
    ;
    ; The reference's EmitResolver wraps the checker behind a mutex; here the
    ; checker IS the resolver (§3.41), and `canCollectSymbolAliasAccessibilityData`
    ; is always true (a normal program's checker).

    ; IsReferencedAliasDeclaration
    procedure is_referenced_alias_declaration(this, node: ref[AstNode]) returns bool
    {
        if (AstNode.flags_of(node) & NodeFlagsSynthesized) <> 0
            return true
        if this.is_alias_symbol_declaration(node)
        {
            let symbol this.get_symbol_of_declaration(node)
            if symbol <> null
            {
                let s symbol as ref[Symbol]
                let links this.alias_symbol_link_of(s)
                if links.referenced
                    return true
                let target links.alias_target
                if target <> null
                {
                    let t target as ref[Symbol]
                    if b.has_syntactic_modifier(node, ModifierFlagsExport) and ((this.get_symbol_flags(t) & SymbolFlagsValue) <> 0)
                    {
                        if this.should_preserve_const_enums() or (Checker.is_const_enum_or_const_enum_only_module(t) = false)
                            return true
                    }
                }
            }
        }
        false
    }

    ; IsValueAliasDeclaration
    procedure is_value_alias_declaration(this, node: ref[AstNode]) returns bool
    {
        if (AstNode.flags_of(node) & NodeFlagsSynthesized) <> 0
            return true
        this.is_value_alias_declaration_worker(node)
    }

    function export_assignment_expression_of(node: ref[AstNode]) returns ref[AstNode]?
    {
        choose node.data
            when d: ExportAssignment
                return d.expression
        null
    }

    procedure is_value_alias_declaration_worker(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindImportEqualsDeclaration
            return this.is_alias_resolved_to_value(this.get_symbol_of_declaration(node), false)
        if (k = KindImportClause) or (k = KindNamespaceImport) or (k = KindImportSpecifier) or (k = KindExportSpecifier)
        {
            let symbol this.get_symbol_of_declaration(node)
            if symbol = null
                return false
            return this.is_alias_resolved_to_value(symbol, true)
        }
        if k = KindExportDeclaration
        {
            let export_clause AstNode.export_clause_of(node)
            if export_clause = null
                return false
            let ec export_clause as ref[AstNode]
            if AstNode.kind_of(ec) = KindNamespaceExport
                return true
            let elements AstNode.elements_of(ec)
            if elements = null
                return false
            let list elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (list.get_length() as int)
            {
                if this.is_value_alias_declaration(list[i] as ref[AstNode])
                    return true
                set i: i + 1
            }
            return false
        }
        if k = KindExportAssignment
        {
            let e Checker.export_assignment_expression_of(node)
            if e <> null
            {
                if AstNode.kind_of(e) = KindIdentifier
                    return this.is_alias_resolved_to_value(this.get_symbol_of_declaration(node), true)
            }
            return true
        }
        if k = KindBinaryExpression
        {
            if this.is_common_js_module_exports(node) and (AstNode.kind_of(AstNode.binary_right_of(node)) = KindIdentifier)
                return this.is_alias_resolved_to_value(this.get_symbol_of_declaration(node), true)
        }
        false
    }

    ; isCommonJSModuleExports: `module.exports = x` / `exports.p = x` at the top of
    ; a file the binder found a CommonJS module indicator in
    function is_common_js_module_exports(this, node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindBinaryExpression
            return false
        let parent AstNode.parent_node_of(node)
        if AstNode.kind_of(parent) <> KindExpressionStatement
            return false
        let grand AstNode.parent_node_of(parent)
        if AstNode.kind_of(grand) <> KindSourceFile
            return false
        if b.common_js_module_indicator_of() = null
            return false
        let adk Parser.get_assignment_declaration_kind(node)
        (adk = JSDeclarationKindModuleExports) or (adk = JSDeclarationKindExportsProperty)
    }

    ; isAliasResolvedToValue
    procedure is_alias_resolved_to_value(this, symbol: ref[Symbol]?, exclude_type_only_values: bool) returns bool
    {
        if symbol = null
            return false
        let s symbol as ref[Symbol]
        let vd Symbol.value_declaration_of(s)
        if vd <> null
        {
            let container Checker.source_file_of_node(vd)
            if container <> null
            {
                let file_symbol this.get_symbol_of_declaration(container)
                this.resolve_external_module_symbol(file_symbol, false)
            }
        }
        let target this.get_export_symbol_of_value_symbol_if_exported(this.resolve_alias(s))
        if target = unknown_symbol
        {
            if exclude_type_only_values = false
                return true
            return this.get_type_only_alias_declaration(s) = null
        }
        if (this.get_symbol_flags_ex(s, exclude_type_only_values, true) & SymbolFlagsValue) = 0
            return false
        this.should_preserve_const_enums() or (Checker.is_const_enum_or_const_enum_only_module(target) = false)
    }

    ; IsTopLevelValueImportEqualsWithEntityName
    procedure is_top_level_value_import_equals_with_entity_name(this, node: ref[AstNode]) returns bool
    {
        if (AstNode.flags_of(node) & NodeFlagsSynthesized) <> 0
            return false
        if AstNode.kind_of(node) <> KindImportEqualsDeclaration
            return false
        if AstNode.kind_of(AstNode.parent_node_of(node)) <> KindSourceFile
            return false
        let mr AstNode.module_reference_of(node)
        if Parser.node_is_missing(mr)
            return false
        if AstNode.kind_of(mr) = KindExternalModuleReference
            return false
        this.is_alias_resolved_to_value(this.get_symbol_of_declaration(node), false)
    }

    ; MarkLinkedReferencesRecursively: every node of the file but the import
    ; declarations and the un-exported import-equals (those are marked in a chain
    ; when referenced), with the UNSPECIFIED hint
    procedure mark_linked_references_recursively(this, file: ref[AstNode])
    {
        if (AstNode.flags_of(file) & NodeFlagsSynthesized) <> 0
            return
        this.mark_linked_references_children(file)
    }

    procedure mark_linked_references_children(this, node: ref[AstNode])
    {
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            let n child as ref[AstNode]
            set i: i + 1
            let k AstNode.kind_of(n)
            if (k = KindImportEqualsDeclaration) and (b.has_syntactic_modifier(n, ModifierFlagsExport) = false)
                continue
            if k = KindImportDeclaration
                continue
            this.mark_linked_references(n, ReferenceHintUnspecified, null, null)
            this.mark_linked_references_children(n)
        }
    }

    function is_property_access_or_qualified_name(n: ref[AstNode]?) returns bool
    {
        let k Checker.kind_or_unknown(n)
        (k = KindPropertyAccessExpression) or (k = KindQualifiedName)
    }

    function specifier_is_type_only(n: ref[AstNode]) returns bool
    {
        choose n.data
            when d: ImportSpecifier
                return d.is_type_only
            when d: ExportSpecifier
                return d.is_type_only
        false
    }

    function is_internal_module_import_equals_declaration(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindImportEqualsDeclaration
            return false
        AstNode.kind_of(AstNode.module_reference_of(node)) <> KindExternalModuleReference
    }

    ; the ReferenceHintUnspecified arm of markLinkedReferences, whole
    procedure mark_linked_references_unspecified(this, location: ref[AstNode])
    {
        if AstNode.is_jsx_tag_name(location) and Checker.is_jsx_intrinsic_tag_name(location)
            return
        if Checker.find_ancestor_kind(location, KindMetaProperty) <> null
            return
        let k AstNode.kind_of(location)
        let parent AstNode.parent_node_of(location)
        if k = KindIdentifier
        {
            var expression_like AstNode.is_expression_node(location)
            if parent <> null
            {
                let p parent as ref[AstNode]
                if AstNode.kind_of(p) = KindShorthandPropertyAssignment
                    set expression_like: true
                if (AstNode.kind_of(p) = KindImportEqualsDeclaration) and (AstNode.module_reference_of(p) = location)
                    set expression_like: true
            }
            if expression_like and Checker.should_mark_identifier_alias_referenced(location)
            {
                if Checker.is_property_access_or_qualified_name(parent)
                {
                    let p parent as ref[AstNode]
                    var left: ref[AstNode]? null
                    if AstNode.kind_of(p) = KindPropertyAccessExpression
                        set left: AstNode.property_access_expression_of(p)
                    else
                        set left: AstNode.qualified_left_of(p)
                    if left <> location
                        return
                }
                this.mark_identifier_alias_referenced(location)
                return
            }
        }
        if Checker.is_property_access_or_qualified_name(location)
        {
            var top: ref[AstNode]? location
            while Checker.is_property_access_or_qualified_name(top)
            {
                if AstNode.is_part_of_type_node(top)
                    return
                set top: AstNode.parent_node_of(top)
            }
            this.mark_property_alias_referenced(location, null, null)
            return
        }
        if k = KindExportAssignment
        {
            this.mark_export_assignment_alias_referenced(location)
            return
        }
        if AstNode.is_jsx_opening_like_element(location) or (k = KindJsxOpeningFragment)
        {
            this.mark_jsx_alias_referenced(location)
            return
        }
        if k = KindImportEqualsDeclaration
        {
            if Checker.is_internal_module_import_equals_declaration(location) or this.check_external_import_or_export_declaration(location)
            {
                if b.has_syntactic_modifier(location, ModifierFlagsExport)
                    this.mark_export_as_referenced(location)
            }
            return
        }
        if k = KindExportSpecifier
        {
            this.mark_export_specifier_alias_referenced(location)
            return
        }
        if emit_decorator_metadata = false
            return
        if (AstNode.can_have_decorators(location) = false) or (this.has_decorators(location) = false)
            return
        if AstNode.modifiers_of(location) = null
            return
        if this.node_can_be_decorated(legacy_decorators, location, parent, AstNode.parent_node_of(parent)) = false
            return
        this.mark_decorator_alias_referenced(location)
    }

    ; getReferencedValueSymbol with the emit resolver's hooks (emitresolver.go:
    ; getResolvedSymbolOrNil first, then resolveName without a message)
    procedure rr_referenced_value_symbol(this, reference: ref[AstNode], start_in_declaration_container: bool) returns ref[Symbol]?
    {
        ; the cached resolution stands unless it is the UNKNOWN symbol (an
        ; identifier the check could not resolve is resolved again here, as the
        ; reference's getReferencedValueOrAliasSymbol does; slice 249)
        let resolved this.get_resolved_symbol_or_nil(reference)
        if resolved <> null
        {
            if (resolved as ref[Symbol]) <> unknown_symbol
                return resolved
        }
        var location: ref[AstNode]? reference
        if start_in_declaration_container
        {
            let parent AstNode.parent_node_of(reference)
            if parent <> null
            {
                let p parent as ref[AstNode]
                if AstNode.is_declaration(p) and (Printer.declaration_name_of(p) = reference)
                    set location: Checker.get_declaration_container(p)
            }
        }
        this.resolve_name(location, AstNode.identifier_text_of(reference), SymbolFlagsExportValue | SymbolFlagsValue | SymbolFlagsAlias, 0, false, false)
    }

    ; GetReferencedImportDeclaration (binder/referenceresolver.go): the alias
    ; declaration an identifier refers to, unless a local value declaration exists
    ; emitresolver.go SetReferencedImportDeclaration: the JSX transformer's generated
    ; names for its runtime imports, looked up before the symbol tables (slice 246)
    procedure set_referenced_import_declaration(this, node: ref[AstNode], declaration: ref[AstNode])
    {
        if jsx_import_refs = null
            set this.jsx_import_refs: &Array[NodeDeclPair]^host()
        (jsx_import_refs as ref[Array[NodeDeclPair]]).add(NodeDeclPair(node, declaration))
    }

    procedure get_referenced_import_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if jsx_import_refs <> null
        {
            let refs jsx_import_refs as ref[Array[NodeDeclPair]]
            var i 0
            while i < (refs.get_length() as int)
            {
                let e refs[i as size_t]
                if e.node = node
                    return e.declaration
                set i: i + 1
            }
        }
        ; emitresolver.go: getReferencedValueOrAliasSymbol — the cached resolution,
        ; else resolveName from the identifier itself with isUse (it marks the
        ; symbol referenced, which checkUnused reads afterwards)
        var symbol this.get_resolved_symbol_or_nil(node)
        if symbol <> null
        {
            if (symbol as ref[Symbol]) = unknown_symbol
                set symbol: null
        }
        if symbol = null
        {
            let mark this.unported_mark()
            set symbol: this.resolve_name(node, AstNode.identifier_text_of(node), SymbolFlagsValue | SymbolFlagsExportValue | SymbolFlagsAlias, 0, true, false)
            if this.unported_mark() <> mark
                return null
        }
        if symbol = null
            return null
        let s symbol as ref[Symbol]
        if Checker.is_non_local_alias(s, SymbolFlagsValue) = false
            return null
        if this.get_type_only_alias_declaration_ex(s, SymbolFlagsValue) <> null
            return null
        this.get_declaration_of_alias_symbol(s)
    }

    ; GetReferencedValueDeclaration
    procedure get_referenced_value_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let symbol this.rr_referenced_value_symbol(node, false)
        if symbol = null
            return null
        let ex this.get_export_symbol_of_value_symbol_if_exported(symbol)
        if ex = null
            return null
        Symbol.value_declaration_of(ex as ref[Symbol])
    }

    ; GetReferencedValueDeclarations: the value declarations of the symbol, null
    ; when the identifier resolves to nothing
    procedure get_referenced_value_declarations(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let symbol this.rr_referenced_value_symbol(node, false)
        if symbol = null
            return null
        let ex this.get_export_symbol_of_value_symbol_if_exported(symbol)
        if ex = null
            return null
        let s ex as ref[Symbol]
        let declarations &Array[ref[AstNode]?]^host()
        let n Symbol.declaration_count(s)
        var i 0
        while i < n
        {
            let declaration Symbol.declaration_at(s, i)
            let k AstNode.kind_of(declaration)
            if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindPropertyDeclaration) or (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment) or (k = KindEnumMember) or (k = KindObjectLiteralExpression) or (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindArrowFunction) or (k = KindClassDeclaration) or (k = KindClassExpression) or (k = KindEnumDeclaration) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindModuleDeclaration)
                declarations.add(declaration)
            set i: i + 1
        }
        declarations
    }

    ; ═══ emitresolver.go — the DECLARATION EMITTER's half (slice 250) ═══════════
    ;
    ; The reference's EmitResolver wraps the checker behind a mutex; here the
    ; checker IS the resolver (§3.41). `IsParseTreeNode` is the NodeFlagsSynthesized
    ; test the four answers above spell. Its per-node `declarationLinks.isVisible`
    ; tristate is a SLOT on the node (`AstNode.decl_visible`), its per-file
    ; `aliasesMarked` a list of the files walked. The node-builder entry points
    ; (CreateTypeOfDeclaration and its kin) are NOT here: they need the factory,
    ; a later module, and live with the transformer until the builder lands.

    ; IsDeclarationVisible
    procedure is_declaration_visible(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if (n.flags & NodeFlagsSynthesized) <> 0
            return false
        let link this.node_link_of(n)
        if link.decl_visible = 0
        {
            var v: u8 2
            if this.determine_if_declaration_is_visible(n)
                set v: 1
            set link.decl_visible: v
        }
        link.decl_visible = 1
    }

    procedure determine_if_declaration_is_visible(this, n: ref[AstNode]) returns bool
    {
        let k n.kind
        if (k = KindJSDocCallbackTag) or (k = KindJSDocTypedefTag)
        {
            ; a top-level jsdoc type alias: comment → hosting declaration → file
            let p1 AstNode.parent_node_of(n)
            if p1 = null
                return false
            let p2 AstNode.parent_node_of(p1)
            if p2 = null
                return false
            let p3 AstNode.parent_node_of(p2)
            if p3 = null
                return false
            return AstNode.kind_of(p3) = KindSourceFile
        }
        if k = KindBindingElement
        {
            let p1 AstNode.parent_node_of(n)
            if p1 = null
                return false
            return this.is_declaration_visible(AstNode.parent_node_of(p1))
        }
        var declaration_like false
        if k = KindVariableDeclaration
            set declaration_like: true
        if k = KindModuleDeclaration
            set declaration_like: true
        if k = KindClassDeclaration
            set declaration_like: true
        if k = KindInterfaceDeclaration
            set declaration_like: true
        if k = KindTypeAliasDeclaration
            set declaration_like: true
        if k = KindJSTypeAliasDeclaration
            set declaration_like: true
        if k = KindFunctionDeclaration
            set declaration_like: true
        if k = KindEnumDeclaration
            set declaration_like: true
        if k = KindImportEqualsDeclaration
            set declaration_like: true
        if declaration_like
        {
            if k = KindVariableDeclaration
            {
                let name AstNode.name_of(n)
                if AstNode.is_binding_pattern(name)
                {
                    let els AstNode.elements_of(name)
                    var empty true
                    if els <> null
                    {
                        if ((els as ref[Array[ref[AstNode]?]]).get_length() as int) > 0
                            set empty: false
                    }
                    ; an empty binding pattern declares nothing visible
                    if empty
                        return false
                }
            }
            ; an external module augmentation is always visible, and so is a
            ; @typedef at the top level of an external module
            if Checker.is_external_module_augmentation(this, n)
                return true
            if this.binder_of_node(n).is_implicitly_exported_jsdoc_declaration(n)
                return true
            let parent_opt Checker.get_declaration_container(n)
            if parent_opt = null
                return false
            let parent parent_opt as ref[AstNode]
            var ambient_module_element false
            if k <> KindImportEqualsDeclaration
            {
                if parent.kind <> KindSourceFile
                {
                    if (parent.flags & NodeFlagsAmbient) <> 0
                        set ambient_module_element: true
                }
            }
            ; not exported, and not an ambient module element (except an import
            ; declaration): visible only at the top of a global script
            if ((b.combined_modifier_flags(n) & ModifierFlagsExport) = 0) and (ambient_module_element = false)
                return Checker.is_global_source_file(this.binder_of_node(parent), parent)
            ; exported members / ambient module elements are visible if the parent is
            return this.is_declaration_visible(parent)
        }
        var member false
        if k = KindPropertyDeclaration
            set member: true
        if k = KindPropertySignature
            set member: true
        if k = KindGetAccessor
            set member: true
        if k = KindSetAccessor
            set member: true
        if k = KindMethodDeclaration
            set member: true
        if k = KindMethodSignature
            set member: true
        if member
        {
            ; private/protected members are not visible; public ones follow the parent
            if this.get_effective_declaration_flags(n, ModifierFlagsPrivate | ModifierFlagsProtected) <> 0
                return false
            return this.is_declaration_visible(AstNode.parent_node_of(n))
        }
        var follows_parent false
        if k = KindConstructor
            set follows_parent: true
        if k = KindConstructSignature
            set follows_parent: true
        if k = KindCallSignature
            set follows_parent: true
        if k = KindIndexSignature
            set follows_parent: true
        if k = KindParameter
            set follows_parent: true
        if k = KindModuleBlock
            set follows_parent: true
        if k = KindFunctionType
            set follows_parent: true
        if k = KindConstructorType
            set follows_parent: true
        if k = KindTypeLiteral
            set follows_parent: true
        if k = KindTypeReference
            set follows_parent: true
        if k = KindArrayType
            set follows_parent: true
        if k = KindTupleType
            set follows_parent: true
        if k = KindUnionType
            set follows_parent: true
        if k = KindIntersectionType
            set follows_parent: true
        if k = KindParenthesizedType
            set follows_parent: true
        if k = KindNamedTupleMember
            set follows_parent: true
        if follows_parent
            return this.is_declaration_visible(AstNode.parent_node_of(n))
        ; a default binding, import specifier or namespace import is visible only
        ; on demand — by default it is not
        if (k = KindImportClause) or (k = KindNamespaceImport) or (k = KindImportSpecifier)
            return false
        ; type parameters, the file and a namespace export are always visible
        if k = KindTypeParameter
            return true
        if (k = KindSourceFile) or (k = KindNamespaceExportDeclaration)
            return true
        ; an export assignment creates no name binding outside the module
        if k = KindExportAssignment
            return false
        ; `export {X}` without a module specifier is itself a visible re-export
        if k = KindExportSpecifier
        {
            let p1 AstNode.parent_node_of(n)
            if p1 = null
                return false
            let export_decl AstNode.parent_node_of(p1)
            if AstNode.kind_of(export_decl) = KindExportDeclaration
            {
                if AstNode.module_specifier_of(export_decl) = null
                    return this.is_declaration_visible(AstNode.parent_node_of(export_decl))
            }
            return false
        }
        false
    }

    ; the checker's getEffectiveDeclarationFlags: the combined modifier flags, with
    ; `declare` (and `export` inside an exporting ambient container) implied for a
    ; node in an ambient context that is not a class or interface member
    function get_effective_declaration_flags(this, n: ref[AstNode], flags_to_check: int) returns int
    {
        var flags b.combined_modifier_flags(n)
        let parent AstNode.parent_node_of(n)
        var parent_is_class_like false
        if parent <> null
        {
            let pk AstNode.kind_of(parent)
            if (pk = KindInterfaceDeclaration) or (pk = KindClassDeclaration) or (pk = KindClassExpression)
                set parent_is_class_like: true
        }
        if (parent_is_class_like = false) and ((n.flags & NodeFlagsAmbient) <> 0)
        {
            let container Checker.get_enclosing_container(n)
            if container <> null
            {
                let c container as ref[AstNode]
                if ((c.flags & NodeFlagsExportContext) <> 0) and ((flags & ModifierFlagsAmbient) = 0)
                {
                    var global_augmentation false
                    if parent <> null
                    {
                        if AstNode.kind_of(parent) = KindModuleBlock
                        {
                            if Binder.is_global_scope_augmentation(AstNode.parent_node_of(parent))
                                set global_augmentation: true
                        }
                    }
                    ; nested in an ambient export context: automatically exported
                    if global_augmentation = false
                        set flags: flags | ModifierFlagsExport
                }
            }
            set flags: flags | ModifierFlagsAmbient
        }
        flags & flags_to_check
    }

    ; getEnclosingContainer: the nearest ancestor the binder treats as a container
    function get_enclosing_container(n: ref[AstNode]) returns ref[AstNode]?
    {
        var p AstNode.parent_node_of(n)
        while p <> null
        {
            let node p as ref[AstNode]
            if (Binder.get_container_flags(node) & ContainerFlagsIsContainer) <> 0
                return node
            set p: AstNode.parent_node_of(node)
        }
        null
    }

    ; PrecalculateDeclarationEmitVisibility: the aliases an `export =`, an export
    ; assignment or an export specifier links to are painted visible up front,
    ; once per file
    procedure precalculate_declaration_emit_visibility(this, file: ref[AstNode])
    {
        if decl_visibility_marked_files = null
            set this.decl_visibility_marked_files: &Array[ref[AstNode]?]^host()
        let marked decl_visibility_marked_files as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (marked.get_length() as int)
        {
            let m marked[i]
            if m <> null
            {
                if (m as ref[AstNode]) = file
                    return
            }
            set i: i + 1
        }
        marked.add(file)
        this.alias_marking_visit_children(file)
    }

    procedure alias_marking_visit_children(this, node: ref[AstNode])
    {
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            this.alias_marking_visit(child as ref[AstNode])
            set i: i + 1
        }
    }

    ; aliasMarkingVisitorWorker, over the whole tree
    procedure alias_marking_visit(this, node: ref[AstNode])
    {
        let k node.kind
        if k = KindBinaryExpression
        {
            if this.is_common_js_module_exports(node)
            {
                let right AstNode.binary_right_of(node)
                if AstNode.kind_of(right) = KindIdentifier
                    this.mark_linked_aliases(right as ref[AstNode])
            }
        }
        if k = KindExportAssignment
        {
            let e AstNode.expression_of(node)
            if AstNode.kind_of(e) = KindIdentifier
                this.mark_linked_aliases(e as ref[AstNode])
        }
        if k = KindExportSpecifier
        {
            let pn Checker.property_name_or_name_of(node)
            if pn <> null
                this.mark_linked_aliases(pn as ref[AstNode])
        }
        this.alias_marking_visit_children(node)
    }

    ; markLinkedAliases: sets the isVisible link on the statements the identifier
    ; or export name points at, following chains of `import d = a.b.c`
    procedure mark_linked_aliases(this, node: ref[AstNode])
    {
        var export_symbol: ref[Symbol]? null
        let parent AstNode.parent_node_of(node)
        var handled false
        if (node.kind <> KindStringLiteral) and (parent <> null)
        {
            let p parent as ref[AstNode]
            var parent_exports false
            if p.kind = KindExportAssignment
                set parent_exports: true
            if this.is_common_js_module_exports(p)
                set parent_exports: true
            if parent_exports
            {
                set export_symbol: this.resolve_name(node, AstNode.identifier_text_of(node), SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace | SymbolFlagsAlias, 0, false, false)
                set handled: true
            }
        }
        if handled = false
        {
            if AstNode.kind_of(parent) = KindExportSpecifier
                set export_symbol: this.get_target_of_export_specifier(parent as ref[AstNode], SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace | SymbolFlagsAlias, false)
        }
        ; guard against circular imports
        let visited &Array[ref[Symbol]?]^host()
        while export_symbol <> null
        {
            let es export_symbol as ref[Symbol]
            if Checker.symbol_list_contains(visited, es)
                break
            visited.add(es)
            var next_symbol: ref[Symbol]? null
            let n Symbol.declaration_count(es)
            var i 0
            while i < n
            {
                let dd Symbol.declaration_at(es, i)
                if dd <> null
                {
                    let d dd as ref[AstNode]
                    let dlink this.node_link_of(d)
                    set dlink.decl_visible: 1
                    if Checker.is_internal_module_import_equals_declaration(d)
                    {
                        ; add the referenced top container visible
                        let first Checker.get_first_identifier(AstNode.module_reference_of(d))
                        if first <> null
                            set next_symbol: this.resolve_name(d, AstNode.identifier_text_of(first), SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace | SymbolFlagsAlias, 0, false, false)
                    }
                }
                set i: i + 1
            }
            set export_symbol: next_symbol
        }
    }

    ; getMeaningOfEntityNameReference: which meaning the first identifier of an
    ; entity name is resolved under
    function get_meaning_of_entity_name_reference(entity_name: ref[AstNode]) returns int
    {
        let parent AstNode.parent_node_of(entity_name)
        let pk AstNode.kind_of(parent)
        var value false
        if pk = KindTypeQuery
            set value: true
        if pk = KindExpressionWithTypeArguments
        {
            if AstNode.is_part_of_type_node(parent) = false
                set value: true
        }
        if pk = KindComputedPropertyName
            set value: true
        if pk = KindTypePredicate
        {
            if AstNode.type_predicate_parameter_name_of(parent) = entity_name
                set value: true
        }
        if pk = KindBinaryExpression
            set value: true
        ; typeof value
        if value
            return SymbolFlagsValue | SymbolFlagsExportValue
        var namespace false
        let k entity_name.kind
        if k = KindQualifiedName
            set namespace: true
        if k = KindPropertyAccessExpression
            set namespace: true
        if pk = KindImportEqualsDeclaration
            set namespace: true
        if pk = KindQualifiedName
        {
            if AstNode.qualified_left_of(parent) = entity_name
                set namespace: true
        }
        if (pk = KindPropertyAccessExpression) or (pk = KindElementAccessExpression)
        {
            if AstNode.expression_of(parent) = entity_name
                set namespace: true
        }
        ; the left identifier of a type reference, or an import's entity name
        if namespace
            return SymbolFlagsNamespace
        ; a type reference or type alias entity that is one identifier
        SymbolFlagsType
    }

    ; IsEntityNameVisible
    procedure is_entity_name_visible(this, entity_name: ref[AstNode], enclosing: ref[AstNode]?, should_compute_alias: bool) returns SymbolAccessibilityResult
    {
        if (entity_name.flags & NodeFlagsSynthesized) <> 0
            return SymbolAccessibilityResult(SymbolAccessibilityNotAccessible, null, null, null, null)
        let meaning Checker.get_meaning_of_entity_name_reference(entity_name)
        let first_opt Checker.get_first_identifier(entity_name)
        if first_opt = null
            return SymbolAccessibilityResult(SymbolAccessibilityNotResolved, null, null, null, null)
        let first first_opt as ref[AstNode]
        let first_text AstNode.identifier_text_of(first)
        let symbol this.resolve_name(enclosing, first_text, meaning, 0, false, false)
        if symbol <> null
        {
            let s symbol as ref[Symbol]
            if ((Symbol.flags_of(s) & SymbolFlagsTypeParameter) <> 0) and ((meaning & SymbolFlagsType) <> 0)
                return SymbolAccessibilityResult(SymbolAccessibilityAccessible, null, null, null, null)
        }
        if symbol = null
        {
            if AstNode.is_this_identifier(first)
            {
                let container Binder.get_this_container(first, false, false)
                let sym this.get_symbol_of_declaration(container)
                let r this.is_symbol_accessible(sym, enclosing, meaning, false)
                if r.accessibility = SymbolAccessibilityAccessible
                    return SymbolAccessibilityResult(SymbolAccessibilityAccessible, null, null, null, null)
            }
            var unresolved SymbolAccessibilityResult(SymbolAccessibilityNotResolved, null, null, null, first)
            set unresolved.error_symbol_name: first_text
            return unresolved
        }
        let visible this.has_visible_declarations(symbol as ref[Symbol], should_compute_alias)
        if visible <> null
        {
            let copy: SymbolAccessibilityResult (visible as ref[SymbolAccessibilityResult])
            return copy
        }
        var r SymbolAccessibilityResult(SymbolAccessibilityNotAccessible, null, null, null, first)
        set r.error_symbol_name: first_text
        r
    }

    ; hasVisibleDeclarations: null when some declaration of the symbol cannot be
    ; made visible; else Accessible with the aliasing statements to paint
    ; (`AliasesToMakeVisible`), each recorded once per declaration
    procedure has_visible_declarations(this, symbol: ref[Symbol], should_compute_alias: bool) returns ref[SymbolAccessibilityResult]?
    {
        var alias_keys: ref[Array[ref[AstNode]?]]? null
        var alias_values: ref[Array[ref[AstNode]?]]? null
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let dd Symbol.declaration_at(symbol, i)
            set i: i + 1
            if dd <> null
            {
                let d dd as ref[AstNode]
                if d.kind <> KindIdentifier
                {
                    if this.is_declaration_visible(d) = false
                    {
                        var aliasing: ref[AstNode]? null
                        var refused false
                        ; an unexported alias whose parent is visible can name a type
                        let any_import Checker.get_any_import_syntax(d)
                        if any_import <> null
                        {
                            let ai any_import as ref[AstNode]
                            if b.has_syntactic_modifier(ai, ModifierFlagsExport) = false
                            {
                                if this.is_declaration_visible(AstNode.parent_node_of(ai))
                                    set aliasing: ai
                            }
                        }
                        if aliasing = null
                        {
                            if d.kind = KindVariableDeclaration
                            {
                                let p1 AstNode.parent_node_of(d)
                                let stmt AstNode.parent_node_of(p1)
                                if AstNode.kind_of(stmt) = KindVariableStatement
                                {
                                    ; an unexported variable statement in a visible container
                                    if b.has_syntactic_modifier(stmt, ModifierFlagsExport) = false
                                    {
                                        if this.is_declaration_visible(AstNode.parent_node_of(stmt))
                                            set aliasing: stmt
                                    }
                                }
                            }
                        }
                        if aliasing = null
                        {
                            ; an unexported top-level statement
                            if Checker.is_late_visibility_painted_statement(d)
                            {
                                if b.has_syntactic_modifier(d, ModifierFlagsExport) = false
                                {
                                    if this.is_declaration_visible(AstNode.parent_node_of(d))
                                        set aliasing: d
                                }
                            }
                        }
                        if aliasing = null
                        {
                            if d.kind = KindBindingElement
                            {
                                var js_require false
                                if ((Symbol.flags_of(symbol) & SymbolFlagsAlias) <> 0) and Parser.is_in_js_file(d)
                                {
                                    ; an exported import-like top-level JS require statement
                                    let p1 AstNode.parent_node_of(d)
                                    let p2 AstNode.parent_node_of(p1)
                                    if AstNode.kind_of(p2) = KindVariableDeclaration
                                    {
                                        let p3 AstNode.parent_node_of(p2)
                                        let p4 AstNode.parent_node_of(p3)
                                        if AstNode.kind_of(p4) = KindVariableStatement
                                        {
                                            if b.has_syntactic_modifier(p4, ModifierFlagsExport) = false
                                            {
                                                let p5 AstNode.parent_node_of(p4)
                                                if p5 <> null
                                                {
                                                    if this.is_declaration_visible(p5)
                                                    {
                                                        set aliasing: p4
                                                        set js_require: true
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if js_require = false
                                {
                                    if (Symbol.flags_of(symbol) & SymbolFlagsBlockScopedVariable) <> 0
                                    {
                                        let root Checker.walk_up_binding_elements_and_patterns(d)
                                        if root = null
                                            return null
                                        if AstNode.kind_of(root) = KindParameter
                                            return null
                                        let vs AstNode.parent_node_of(AstNode.parent_node_of(root))
                                        if AstNode.kind_of(vs) <> KindVariableStatement
                                            return null
                                        if b.has_syntactic_modifier(vs, ModifierFlagsExport)
                                            set refused: false
                                        else
                                        {
                                            if this.is_declaration_visible(AstNode.parent_node_of(vs)) = false
                                                return null
                                            set aliasing: vs
                                        }
                                        ; already exported: no alias to add, and the
                                        ; declaration is not refused
                                        if aliasing = null
                                            set js_require: true
                                    }
                                }
                                if (aliasing = null) and (js_require = false)
                                    set refused: true
                            }
                            else
                                set refused: true
                        }
                        if refused
                            return null
                        if (aliasing <> null) and should_compute_alias
                        {
                            let dlink this.node_link_of(d)
                            set dlink.decl_visible: 1
                            if alias_keys = null
                            {
                                set alias_keys: &Array[ref[AstNode]?]^host()
                                set alias_values: &Array[ref[AstNode]?]^host()
                            }
                            let keys alias_keys as ref[Array[ref[AstNode]?]]
                            var seen false
                            var ki 0
                            while ki < (keys.get_length() as int)
                            {
                                let kd keys[ki]
                                if kd <> null
                                {
                                    if (kd as ref[AstNode]) = d
                                        set seen: true
                                }
                                set ki: ki + 1
                            }
                            if seen = false
                            {
                                keys.add(d)
                                (alias_values as ref[Array[ref[AstNode]?]]).add(aliasing)
                            }
                        }
                    }
                }
            }
        }
        &SymbolAccessibilityResult^host(SymbolAccessibilityAccessible, alias_values, null, null, null)
    }

    ; getAnyImportSyntax: the import statement an import binding belongs to
    function get_any_import_syntax(node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if k = KindImportEqualsDeclaration
            return node
        if k = KindImportClause
            return AstNode.parent_node_of(node)
        if k = KindNamespaceImport
            return AstNode.parent_node_of(AstNode.parent_node_of(node))
        if k = KindImportSpecifier
            return AstNode.parent_node_of(AstNode.parent_node_of(AstNode.parent_node_of(node)))
        null
    }

    ; ast.IsLateVisibilityPaintedStatement
    function is_late_visibility_painted_statement(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if k = KindImportDeclaration
            return true
        if k = KindJSImportDeclaration
            return true
        if k = KindImportEqualsDeclaration
            return true
        if k = KindVariableStatement
            return true
        if k = KindClassDeclaration
            return true
        if k = KindFunctionDeclaration
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        if k = KindInterfaceDeclaration
            return true
        k = KindEnumDeclaration
    }

    ; IsImplementationOfOverload: a function body that belongs to a symbol with
    ; several signatures, or with one signature that is not this node's
    procedure is_implementation_of_overload(this, node: ref[AstNode]) returns bool
    {
        if (node.flags & NodeFlagsSynthesized) <> 0
            return false
        if Binder.node_is_present(AstNode.body_of(node))
        {
            ; get or set accessors can never be overload implementations
            if (node.kind = KindGetAccessor) or (node.kind = KindSetAccessor)
                return false
            let symbol this.get_symbol_of_declaration(node)
            let sigs this.get_signatures_of_symbol(symbol)
            if sigs <> null
            {
                let s sigs as ref[Array[ref[Signature]?]]
                let n s.get_length() as int
                if n > 1
                    return true
                if n = 1
                {
                    let sig s[0]
                    if sig <> null
                    {
                        let decl (sig as ref[Signature]).declaration
                        if decl <> null
                        {
                            let d decl as ref[AstNode]
                            if (d <> node) and ((d.flags & NodeFlagsJSDoc) = 0)
                                return true
                        }
                    }
                }
            }
        }
        false
    }

    ; IsImportRequiredByAugmentation: an import whose target file declares an
    ; augmentation of something this file exports
    procedure is_import_required_by_augmentation(this, decl: ref[AstNode]) returns bool
    {
        if (decl.flags & NodeFlagsSynthesized) <> 0
            return false
        let file Checker.source_file_of_node(decl)
        if file = null
            return false
        let file_symbol AstNode.symbol_of(file)
        if file_symbol = null
            return false
        let import_target this.get_external_module_file_from_declaration(decl)
        if import_target = null
            return false
        if import_target = file
            return false
        let exports this.get_exports_of_module(file_symbol as ref[Symbol])
        if exports = null
            return false
        let t exports as ref[SymbolTable]
        let n SymbolTable.length(t)
        var i 0
        while i < n
        {
            let so SymbolTable.entry_symbol_at(t, i)
            set i: i + 1
            if so <> null
            {
                let s so as ref[Symbol]
                let merged this.get_merged_symbol(s)
                if merged <> null
                {
                    let m merged as ref[Symbol]
                    if m <> s
                    {
                        let dn Symbol.declaration_count(m)
                        var di 0
                        while di < dn
                        {
                            let d Symbol.declaration_at(m, di)
                            if d <> null
                            {
                                if Checker.source_file_of_node(d) = import_target
                                    return true
                            }
                            set di: di + 1
                        }
                    }
                }
            }
        }
        false
    }

    ; getExternalModuleFileFromDeclaration: the source file an import, export or
    ; string-named module declaration resolves to
    procedure get_external_module_file_from_declaration(this, declaration: ref[AstNode]) returns ref[AstNode]?
    {
        var specifier: ref[AstNode]? null
        if declaration.kind = KindModuleDeclaration
        {
            let name AstNode.name_of(declaration)
            if AstNode.kind_of(name) = KindStringLiteral
                set specifier: name
        }
        else
            set specifier: AstNode.get_external_module_name(declaration)
        if specifier = null
            return null
        let module_symbol this.resolve_external_module_name(specifier, specifier, true)
        if module_symbol = null
            return null
        Checker.get_declaration_of_kind(module_symbol as ref[Symbol], KindSourceFile)
    }

    ; IsDefinitelyReferenceToGlobalSymbolObject: exactly `Symbol.x` or
    ; `globalThis.Symbol.x` resolving to the global Symbol
    procedure is_definitely_reference_to_global_symbol_object(this, node: ref[AstNode]) returns bool
    {
        if node.kind <> KindPropertyAccessExpression
            return false
        let name AstNode.name_of(node)
        if AstNode.kind_of(name) <> KindIdentifier
            return false
        let expr_opt AstNode.expression_of(node)
        if expr_opt = null
            return false
        let expr expr_opt as ref[AstNode]
        ; ★ The three name tests bind their literal first: `call().equals("x")`
        ; answers false at rc 0 (slice 252), so this function was false for
        ; every input until then
        let symbol_name: Slice[char] "Symbol"
        if expr.kind = KindIdentifier
        {
            if SymbolTable.names_equal(AstNode.identifier_text_of(expr), symbol_name) = false
                return false
            let resolved this.get_resolved_symbol(expr)
            ; getGlobalSymbol: resolveName with no location
            let global this.resolve_name(null, "Symbol", SymbolFlagsValue | SymbolFlagsExportValue, 0, false, false)
            if global = null
                return false
            return resolved = (global as ref[Symbol])
        }
        if expr.kind <> KindPropertyAccessExpression
            return false
        let inner_opt AstNode.expression_of(expr)
        if inner_opt = null
            return false
        let inner inner_opt as ref[AstNode]
        if inner.kind <> KindIdentifier
            return false
        let global_this_name: Slice[char] "globalThis"
        if SymbolTable.names_equal(AstNode.identifier_text_of(inner), global_this_name) = false
            return false
        if SymbolTable.names_equal(AstNode.identifier_text_of(AstNode.name_of(expr)), symbol_name) = false
            return false
        this.get_resolved_symbol(inner) = global_this_symbol
    }

    ; RequiresAddingImplicitUndefined with the declaration emitter's ENCLOSING
    ; declaration (the printer's entry above passes none); the parameter arms
    procedure requires_adding_implicit_undefined_ex(this, declaration: ref[AstNode], enclosing: ref[AstNode]?) returns bool
    {
        if (declaration.flags & NodeFlagsSynthesized) <> 0
            return false
        if (declaration.kind <> KindParameter) and (declaration.kind <> KindJSDocParameterTag)
            return false
        var wants false
        if this.is_required_initialized_parameter_ex(declaration, enclosing)
            set wants: true
        if this.is_optional_uninitialized_parameter_property(declaration)
            set wants: true
        if wants = false
            return false
        this.declared_parameter_type_contains_undefined(declaration) = false
    }

    procedure is_required_initialized_parameter_ex(this, parameter: ref[AstNode], enclosing: ref[AstNode]?) returns bool
    {
        if Checker.strict_null_checks() = false
            return false
        let mark this.unported_mark()
        let opt this.is_optional_parameter(parameter)
        if this.unported_mark() <> mark
            return false
        if opt
            return false
        if AstNode.initializer_of(parameter) = null
            return false
        if b.has_syntactic_modifier(parameter, ModifierFlagsParameterPropertyModifier)
        {
            if enclosing = null
                return false
            return AstNode.is_function_like_declaration(enclosing)
        }
        true
    }

    ; IsLiteralConstDeclaration: a readonly or const declaration whose type is a
    ; fresh literal type — printed with its initializer rather than a type
    procedure is_literal_const_declaration(this, node: ref[AstNode]) returns bool
    {
        if (node.flags & NodeFlagsSynthesized) <> 0
            return false
        var const_like this.is_declaration_readonly(node)
        if node.kind = KindVariableDeclaration
        {
            if (Binder.combined_node_flags(node) & NodeFlagsBlockScoped) = NodeFlagsConst
                set const_like: true
        }
        if const_like = false
            return false
        let symbol this.get_symbol_of_declaration(node)
        if symbol = null
            return false
        let t this.get_type_of_symbol(symbol as ref[Symbol])
        if t = null
            return false
        Checker.is_fresh_literal_type(t as ref[Type])
    }

    ; GetPropertiesOfContainerFunction
    procedure get_properties_of_container_function(this, node: ref[AstNode]) returns ref[Array[ref[Symbol]?]]?
    {
        let s this.get_symbol_of_declaration(node)
        if s = null
            return null
        let t this.get_type_of_symbol(s as ref[Symbol])
        if t = null
            return null
        this.get_properties_of_type(t as ref[Type])
    }

    ; IsExpandoFunctionDeclaration: a function some property assignment declares on
    procedure is_expando_function_declaration(this, node: ref[AstNode]) returns bool
    {
        if (node.flags & NodeFlagsSynthesized) <> 0
            return false
        let props this.get_properties_of_container_function(node)
        if props = null
            return false
        let list props as ref[Array[ref[Symbol]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            let p list[i]
            if p <> null
            {
                let vd Symbol.value_declaration_of(p as ref[Symbol])
                if vd <> null
                {
                    if AstNode.kind_of(vd) = KindBinaryExpression
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; IsSymbolAccessible: whether the symbol can be named from the enclosing
    ; declaration under the meaning, marking the aliases that make it so when asked
    procedure is_symbol_accessible(this, symbol: ref[Symbol]?, enclosing: ref[AstNode]?, meaning: int, should_compute_aliases: bool) returns SymbolAccessibilityResult
        this.is_symbol_accessible_worker(symbol, enclosing, meaning, should_compute_aliases, true)

    procedure is_symbol_accessible_worker(this, symbol: ref[Symbol]?, enclosing: ref[AstNode]?, meaning: int, should_compute_aliases: bool, allow_modules: bool) returns SymbolAccessibilityResult
    {
        if (symbol <> null) and (enclosing <> null)
        {
            let s symbol as ref[Symbol]
            ; the accessible-chain walk reads its enclosing declaration off the
            ; printer's cell (§3.20's shape): set it for the duration
            let saved printer_enclosing_declaration
            set this.printer_enclosing_declaration: enclosing
            let one &Array[ref[Symbol]?]^host()
            one.add(s)
            let result this.is_any_symbol_accessible(one, s, meaning, should_compute_aliases, allow_modules)
            set this.printer_enclosing_declaration: saved
            if result <> null
            {
                let copy: SymbolAccessibilityResult (result as ref[SymbolAccessibilityResult])
                return copy
            }
            ; not exported from its external module, or from a different external
            ; module with no alias — hence cannot be named
            var symbol_external_module: ref[Symbol]? null
            let n Symbol.declaration_count(s)
            var i 0
            while i < n
            {
                if symbol_external_module = null
                {
                    let d Symbol.declaration_at(s, i)
                    if d <> null
                        set symbol_external_module: this.get_external_module_container(d as ref[AstNode])
                }
                set i: i + 1
            }
            if symbol_external_module <> null
            {
                let enclosing_external_module this.get_external_module_container(enclosing as ref[AstNode])
                var same false
                if enclosing_external_module <> null
                {
                    if (enclosing_external_module as ref[Symbol]) = (symbol_external_module as ref[Symbol])
                        set same: true
                }
                if same = false
                {
                    var cannot SymbolAccessibilityResult(SymbolAccessibilityCannotBeNamed, null, null, null, null)
                    set cannot.error_symbol_name: Symbol.name_of(s)
                    set cannot.error_module_name: Symbol.name_of(symbol_external_module as ref[Symbol])
                    if Parser.is_in_js_file(enclosing)
                        set cannot.error_node: enclosing
                    return cannot
                }
            }
            ; just a local name that is not accessible
            var local SymbolAccessibilityResult(SymbolAccessibilityNotAccessible, null, null, null, null)
            set local.error_symbol_name: Symbol.name_of(s)
            return local
        }
        SymbolAccessibilityResult(SymbolAccessibilityAccessible, null, null, null, null)
    }

    ; IsAnySymbolAccessible, over the printer's enclosing-declaration cell: null
    ; when no verdict — the caller's fallbacks decide
    procedure is_any_symbol_accessible(this, symbols: ref[Array[ref[Symbol]?]], initial_symbol: ref[Symbol], meaning: int, should_compute_aliases: bool, allow_modules: bool) returns ref[SymbolAccessibilityResult]?
    {
        let count symbols.get_length() as int
        if count = 0
            return null
        var had_accessible_chain: ref[Symbol]? null
        var early_module_bail false
        var i 0
        while i < count
        {
            let so symbols[i]
            set i: i + 1
            if so <> null
            {
                let symbol so as ref[Symbol]
                ; the symbol is accessible if it by itself is accessible
                let chain &Array[ref[Symbol]?]^host()
                let mark this.unported_mark()
                this.get_accessible_symbol_chain(symbol, meaning, chain)
                if this.unported_mark() <> mark
                    return null
                if (chain.get_length() as int) > 0
                {
                    set had_accessible_chain: symbol
                    let head chain[0]
                    if head <> null
                    {
                        let visible this.has_visible_declarations(head as ref[Symbol], should_compute_aliases)
                        if visible <> null
                            return visible
                    }
                }
                var skip false
                if allow_modules
                {
                    if this.symbol_has_non_global_augmentation_external_module_declaration(symbol)
                    {
                        ; a module's aliases must be found first in declaration emit,
                        ; so the module fast path waits until every other route failed
                        if should_compute_aliases
                        {
                            set early_module_bail: true
                            set skip: true
                        }
                        else
                            return &SymbolAccessibilityResult^host(SymbolAccessibilityAccessible, null, null, null, null)
                    }
                }
                if skip = false
                {
                    ; a qualified symbol is accessible if its parent is (`m.c`)
                    let containers &Array[ref[Symbol]?]^host()
                    this.containers_of_symbol(symbol, meaning, containers)
                    var next_meaning meaning
                    if initial_symbol = symbol
                        set next_meaning: Checker.qualified_left_meaning(meaning)
                    let parent_result this.is_any_symbol_accessible(containers, initial_symbol, next_meaning, should_compute_aliases, allow_modules)
                    if parent_result <> null
                        return parent_result
                }
            }
        }
        if early_module_bail
            return &SymbolAccessibilityResult^host(SymbolAccessibilityAccessible, null, null, null, null)
        if had_accessible_chain <> null
        {
            let r &SymbolAccessibilityResult^host(SymbolAccessibilityNotAccessible, null, null, null, null)
            set r.error_symbol_name: Symbol.name_of(initial_symbol)
            if (had_accessible_chain as ref[Symbol]) <> initial_symbol
                set r.error_module_name: Symbol.name_of(had_accessible_chain as ref[Symbol])
            return r
        }
        null
    }

    ; IsNameResolvable: the name resolves to any symbol at the location
    procedure is_name_resolvable(this, location: ref[AstNode]?, name: Slice[char]) returns bool
        this.resolve_name(location, name, SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace, 0, false, false) <> null

    ; GetElementAccessExpressionName: the property name of `o["x"]` / `o[K.a]`,
    ; empty when it has none
    procedure get_element_access_expression_name(this, expression: ref[AstNode]) returns Slice[char]
    {
        if (expression.flags & NodeFlagsSynthesized) <> 0
            return Slice[char]()
        let arg AstNode.element_access_argument_of(expression)
        if arg = null
            return Slice[char]()
        let a arg as ref[AstNode]
        if Binder.is_string_or_numeric_literal_like(a)
            return AstNode.literal_text_of(a)
        if Parser.is_entity_name_expression(a)
        {
            var out_name Slice[char]()
            if this.try_get_name_from_entity_name_expression(a, &out_name)
                return out_name
        }
        Slice[char]()
    }

    ; GetReferencedMemberValueDeclaration: `this.x` / `this[x]` references have a
    ; resolved symbol; a declaration instead of a reference has its own
    procedure get_referenced_member_value_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (node.flags & NodeFlagsSynthesized) <> 0
            return null
        var s this.get_resolved_symbol_or_nil(node)
        if s = null
        {
            let own AstNode.symbol_of(node)
            if own <> null
                set s: this.get_merged_symbol(own)
        }
        if s = null
            return null
        let ex this.get_export_symbol_of_value_symbol_if_exported(s)
        if ex = null
            return null
        Symbol.value_declaration_of(ex as ref[Symbol])
    }

    ; CreateLiteralConstValue, minus the node: the transformer builds it (the
    ; factory is a later module) from the KIND this answers and the text —
    ; 0 none · 1 string · 2 number · 3 negative number (text is the magnitude) ·
    ; 4 Infinity · 5 -Infinity · 6 NaN · 7 bigint (text carries its `n`) ·
    ; 8 true · 9 false · 10 an enum member (its expression needs the node builder)
    procedure literal_const_value(this, node: ref[AstNode], out_text: ref[Slice[char]]) returns int
    {
        set out_text.data: null
        set out_text.length: 0
        let symbol this.get_symbol_of_declaration(node)
        if symbol = null
            return 0
        let to this.get_type_of_symbol(symbol as ref[Symbol])
        if to = null
            return 0
        let t to as ref[Type]
        if (t.flags & TypeFlagsEnumLike) <> 0
            return 10
        if t = true_type
            return 8
        if t = false_type
            return 9
        if (t.flags & TypeFlagsLiteral) = 0
            return 0
        if (t.flags & TypeFlagsStringLiteral) <> 0
        {
            let text Checker.literal_text_of(t)
            set out_text.data: text.data
            set out_text.length: text.length
            return 1
        }
        if (t.flags & TypeFlagsNumberLiteral) <> 0
        {
            let bits Checker.literal_bits_of(t)
            if jsnum_is_inf(bits)
            {
                if jsnum_abs(bits) = bits
                    return 4
                return 5
            }
            if jsnum_is_nan(bits)
                return 6
            var kind 2
            var magnitude bits
            if jsnum_abs(bits) <> bits
            {
                set kind: 3
                set magnitude: jsnum_abs(bits)
            }
            let raw host.allocate(40 as size_t, 1) as pointer[char]
            let buf Slice[char](40 as size_t, raw)
            let n jsnum_to_string(magnitude, buf)
            set out_text.data: raw
            set out_text.length: n
            return kind
        }
        if (t.flags & TypeFlagsBigIntLiteral) <> 0
        {
            let sb StringBuilder^host()
            Checker.write_pseudo_big_int(sb, t)
            sb.append("n")
            let s Printer.slice_on(host, sb.to_string())
            set out_text.data: s.data
            set out_text.length: s.length
            return 7
        }
        if (t.flags & TypeFlagsBooleanLiteral) <> 0
        {
            ; the regular true/false types
            if Checker.literal_bool_of(t)
                return 8
            return 9
        }
        0
    }

    ; IsThisPropertyAssignmentDeclarationRedundant: a JS `this.x = …` whose member
    ; an `extends` base already provides — an inherited accessor or method (always
    ; redundant), or an identical inherited property (same readonly-ness,
    ; optionality and type); `implements` members are not inherited
    procedure is_this_property_assignment_declaration_redundant(this, node: ref[AstNode]) returns bool
    {
        let so this.get_symbol_of_declaration(node)
        if so = null
            return false
        let s so as ref[Symbol]
        let parent Symbol.parent_of(s)
        if parent = null
            return false
        let pt this.get_declared_type_of_symbol(parent as ref[Symbol])
        if pt = null
            return false
        let bases this.get_base_types(pt as ref[Type])
        if bases = null
            return false
        let bl bases as ref[Array[ref[Type]?]]
        var i 0
        while i < (bl.get_length() as int)
        {
            let bo bl[i as size_t]
            set i: i + 1
            if bo <> null
            {
                let base_prop this.get_property_of_type(bo as ref[Type], Symbol.name_of(s))
                if base_prop <> null
                {
                    let bp base_prop as ref[Symbol]
                    if (Symbol.flags_of(bp) & (SymbolFlagsAccessor | SymbolFlagsMethod | SymbolFlagsFunction)) <> 0
                        return true
                    if this.is_readonly_symbol(bp) = this.is_readonly_symbol(s)
                    {
                        if (Symbol.flags_of(s) & SymbolFlagsOptional) = (Symbol.flags_of(bp) & SymbolFlagsOptional)
                        {
                            let ts this.get_type_of_symbol(s)
                            let tb this.get_type_of_symbol(bp)
                            if (ts <> null) and (tb <> null)
                            {
                                if this.is_type_identical_to(ts as ref[Type], tb as ref[Type])
                                    return true
                            }
                        }
                    }
                }
            }
        }
        false
    }

    ; the count of a class's index signatures that only the node builder can
    ; write: an index info without a declaration (a late-bound one), static or
    ; instance, that is not the inherited any-base placeholder
    procedure late_bound_index_signature_count(this, container: ref[AstNode]) returns int
    {
        let sym_opt AstNode.symbol_of(container)
        if sym_opt = null
            return 0
        let sym sym_opt as ref[Symbol]
        var count 0
        let t this.get_type_of_symbol(sym)
        if t <> null
            set count: count + this.count_undeclared_index_infos(this.get_index_infos_of_type(t as ref[Type]))
        let index_symbol this.get_index_symbol(sym)
        if index_symbol <> null
        {
            let members this.get_members_of_symbol(sym)
            set count: count + this.count_undeclared_index_infos(this.get_index_infos_of_index_symbol(index_symbol as ref[Symbol], members))
        }
        count
    }

    function count_undeclared_index_infos(this, infos: ref[Array[ref[IndexInfo]?]]?) returns int
    {
        if infos = null
            return 0
        let list infos as ref[Array[ref[IndexInfo]?]]
        var count 0
        var i 0
        while i < (list.get_length() as int)
        {
            let io list[i]
            if io <> null
            {
                let info io as ref[IndexInfo]
                if info.declaration = null
                {
                    var inherited false
                    if any_base_type_index_info <> null
                    {
                        if (any_base_type_index_info as ref[IndexInfo]) = info
                            set inherited: true
                    }
                    if inherited = false
                        set count: count + 1
                }
            }
            set i: i + 1
        }
        count
    }

    ; GetReferencedExportContainer: the SourceFile, ModuleDeclaration or
    ; EnumDeclaration whose export `node` refers to, else null
    ; ═══ checker/emitresolver.go GetTypeReferenceSerializationKind (slice 245) ═══
    ; what a decorated member's type reference is at runtime, for `design:type`
    procedure get_type_reference_serialization_kind(this, type_name: ref[AstNode]?, location: ref[AstNode]?) returns int
    {
        if (type_name = null) or (location = null)
            return TypeReferenceSerializationKindUnknown
        let tn type_name as ref[AstNode]
        let loc location as ref[AstNode]
        ; Resolve the symbol as a value to ensure the type can be reached at runtime during emit.
        var is_type_only false
        if tn.kind = KindQualifiedName
        {
            let root_value_symbol this.resolve_entity_name(Checker.get_first_identifier(tn) as ref[AstNode], SymbolFlagsValue, true, true, loc)
            if root_value_symbol <> null
            {
                let rvs root_value_symbol as ref[Symbol]
                let decl_n Symbol.declaration_count(rvs)
                if decl_n > 0
                {
                    set is_type_only: true
                    var i 0
                    while i < decl_n
                    {
                        if Checker.is_type_only_import_or_export_declaration(Symbol.declaration_at(rvs, i) as ref[AstNode]) = false
                            set is_type_only: false
                        set i: i + 1
                    }
                }
            }
        }
        let value_symbol this.resolve_entity_name(tn, SymbolFlagsValue, true, true, loc)
        var resolved_value_symbol value_symbol
        if value_symbol <> null
        {
            let vs value_symbol as ref[Symbol]
            if (vs.flags & SymbolFlagsAlias) <> 0
                set resolved_value_symbol: this.resolve_alias(vs)
            if this.get_type_only_alias_declaration_ex(vs, SymbolFlagsValue) <> null
                set is_type_only: true
        }
        ; Resolve the symbol as a type so that we can provide a more useful hint for the type serializer.
        let type_symbol this.resolve_entity_name(tn, SymbolFlagsType, true, true, loc)
        var resolved_type_symbol type_symbol
        if type_symbol <> null
        {
            let ts type_symbol as ref[Symbol]
            if (ts.flags & SymbolFlagsAlias) <> 0
                set resolved_type_symbol: this.resolve_alias(ts)
            if this.get_type_only_alias_declaration_ex(ts, SymbolFlagsType) <> null
                set is_type_only: true
        }
        if (resolved_value_symbol <> null) and (resolved_type_symbol <> null)
        {
            let rvs resolved_value_symbol as ref[Symbol]
            if rvs = (resolved_type_symbol as ref[Symbol])
            {
                let global_promise_symbol this.get_global_promise_constructor_symbol()
                if global_promise_symbol <> null
                {
                    if rvs = (global_promise_symbol as ref[Symbol])
                        return TypeReferenceSerializationKindPromise
                }
                let constructor_type this.get_type_of_symbol(rvs)
                if constructor_type <> null
                {
                    if this.is_constructor_type(constructor_type as ref[Type])
                    {
                        if is_type_only
                            return TypeReferenceSerializationKindTypeWithCallSignature
                        return TypeReferenceSerializationKindTypeWithConstructSignatureAndValue
                    }
                }
            }
        }
        ; We might not be able to resolve type symbol so use unknown type in that case (eg error case)
        if resolved_type_symbol = null
        {
            if is_type_only
                return TypeReferenceSerializationKindObjectType
            return TypeReferenceSerializationKindUnknown
        }
        let t this.get_declared_type_of_symbol(resolved_type_symbol as ref[Symbol]) as ref[Type]
        if this.is_error_type(t)
        {
            if is_type_only
                return TypeReferenceSerializationKindObjectType
            return TypeReferenceSerializationKindUnknown
        }
        if (t.flags & TypeFlagsAnyOrUnknown) <> 0
            return TypeReferenceSerializationKindObjectType
        if this.is_type_assignable_to_kind(t, TypeFlagsVoid | TypeFlagsNullable | TypeFlagsNever)
            return TypeReferenceSerializationKindVoidNullableOrNeverType
        if this.is_type_assignable_to_kind(t, TypeFlagsBooleanLike)
            return TypeReferenceSerializationKindBooleanType
        if this.is_type_assignable_to_kind(t, TypeFlagsNumberLike)
            return TypeReferenceSerializationKindNumberLikeType
        if this.is_type_assignable_to_kind(t, TypeFlagsBigIntLike)
            return TypeReferenceSerializationKindBigIntLikeType
        if this.is_type_assignable_to_kind(t, TypeFlagsStringLike)
            return TypeReferenceSerializationKindStringLikeType
        if Checker.is_tuple_type(t)
            return TypeReferenceSerializationKindArrayLikeType
        if this.is_type_assignable_to_kind(t, TypeFlagsESSymbolLike)
            return TypeReferenceSerializationKindESSymbolType
        if this.is_function_type(t)
            return TypeReferenceSerializationKindTypeWithCallSignature
        if this.is_array_type(t)
            return TypeReferenceSerializationKindArrayLikeType
        TypeReferenceSerializationKindObjectType
    }

    procedure get_referenced_export_container(this, node: ref[AstNode], prefix_locals: bool) returns ref[AstNode]?
    {
        ; When resolving the export for the name of a module or enum declaration, we
        ; need to start resolution at the declaration's container.
        var start_in_declaration_container false
        let parent AstNode.parent_node_of(node)
        if parent <> null
        {
            let p parent as ref[AstNode]
            if (p.kind = KindModuleDeclaration) or (p.kind = KindEnumDeclaration)
            {
                if Printer.declaration_name_of(p) = node
                    set start_in_declaration_container: true
            }
        }
        let resolved this.rr_referenced_value_symbol(node, start_in_declaration_container)
        if resolved = null
            return null
        var symbol resolved as ref[Symbol]
        if (Symbol.flags_of(symbol) & SymbolFlagsExportValue) <> 0
        {
            ; If we reference an exported entity within the same module declaration, then whether
            ; we prefix depends on the kind of entity. SymbolFlags.ExportHasLocal encompasses all the
            ; kinds that we do NOT prefix.
            let export_symbol this.get_merged_symbol(symbol.export_symbol)
            if export_symbol = null
                return null
            let es export_symbol as ref[Symbol]
            if (prefix_locals = false) and ((Symbol.flags_of(es) & SymbolFlagsExportHasLocal) <> 0) and ((Symbol.flags_of(es) & SymbolFlagsVariable) = 0)
                return null
            set symbol: es
        }
        let parent_symbol this.get_parent_of_symbol(symbol)
        if parent_symbol = null
            return null
        let ps parent_symbol as ref[Symbol]
        if (Symbol.flags_of(ps) & SymbolFlagsValueModule) <> 0
        {
            let vd ps.value_declaration
            if vd <> null
            {
                if AstNode.kind_of(vd) = KindSourceFile
                {
                    ; an export in another file is a namespace export: nil
                    if vd <> Checker.source_file_of_node(node)
                        return null
                    return vd
                }
            }
        }
        var n AstNode.parent_node_of(node)
        while n <> null
        {
            let c n as ref[AstNode]
            if (c.kind = KindModuleDeclaration) or (c.kind = KindEnumDeclaration)
            {
                if this.get_symbol_of_declaration(c) = parent_symbol
                    return c
            }
            set n: AstNode.parent_node_of(c)
        }
        null
    }

    ; services.go GetConstantValue: an enum member's value, or the value of a
    ; property/element access that resolves to a member of a CONST enum
    ; (EvalKindNone when there is none)
    procedure get_constant_value(this, node: ref[AstNode]) returns EvalResult
    {
        if node.kind = KindEnumMember
            return this.get_enum_member_value(node)
        var symbol this.get_resolved_symbol_or_nil(node)
        if symbol = null
        {
            this.check_expression_cached(node)
            set symbol: this.get_resolved_symbol_or_nil(node)
        }
        if (symbol = null) and Checker.is_entity_name_expression(node)
            set symbol: this.resolve_entity_name(node, SymbolFlagsValue, true, false, null)
        if symbol <> null
        {
            let sym symbol as ref[Symbol]
            if (Symbol.flags_of(sym) & SymbolFlagsEnumMember) <> 0
            {
                let member sym.value_declaration
                if member <> null
                {
                    if this.is_enum_const(AstNode.parent_node_of(member))
                        return this.get_enum_member_value(member)
                }
            }
        }
        let none: Slice[char] ""
        EvalResult(EvalKindNone, none, 0 as u64, false, false, false)
    }

    procedure mark_linked_references(this, location: ref[AstNode], hint: int, prop_symbol: ref[Symbol]?, parent_type: ref[Type]?)
    {
        if (AstNode.flags_of(location) & NodeFlagsAmbient) <> 0
        {
            let k AstNode.kind_of(location)
            var property false
            if k = KindPropertySignature
                set property: true
            if k = KindPropertyDeclaration
                set property: true
            if property = false
                return
        }
        if hint = ReferenceHintExportSpecifier
        {
            this.mark_export_specifier_alias_referenced(location)
            return
        }
        if hint = ReferenceHintExportAssignment
        {
            this.mark_export_assignment_alias_referenced(location)
            return
        }
        if hint = ReferenceHintExportImportEquals
        {
            ; markImportEqualsAliasReferenced, whole — four lines and report-free.
            if b.has_syntactic_modifier(location, ModifierFlagsExport)
                this.mark_export_as_referenced(location)
            return
        }
        ; slice 134 — the DECORATOR arm, whose body is a provable no-op behind an
        ; unset option; see mark_decorator_alias_referenced.
        if hint = ReferenceHintDecorator
        {
            this.mark_decorator_alias_referenced(location)
            return
        }
        ; ★★★ THE IDENTIFIER AND PROPERTY ARMS ARE NOT FLAG WRITES (slice 202).
        ; Both notes that stood at their call sites said the whole effect was
        ; `aliasSymbolLinks.referenced = true`, read by the emit resolver alone.
        ; True of the FLAG and false of the WALK: markIdentifierAliasReferenced
        ; calls getResolvedSymbol, which REPORTS, and markAliasSymbolAsReferenced
        ; walks an internal `import x = a.b` back to its first identifier and
        ; resolves THAT with the cannot-find-name message — the TS2304 on `My` in
        ; `import Internal = My.Internal;` and the TS2591 on `module` in
        ; `import fs = module("fs")` that this port could not produce.
        if hint = ReferenceHintIdentifier
        {
            this.mark_identifier_alias_referenced(location)
            return
        }
        if hint = ReferenceHintProperty
        {
            this.mark_property_alias_referenced(location, prop_symbol, parent_type)
            return
        }
        ; the UNSPECIFIED hint — the emit resolver's whole-file walk (slice 237)
        if hint = ReferenceHintUnspecified
        {
            this.mark_linked_references_unspecified(location)
            return
        }
        this.record_unported("mark-linked-references", hint)
    }

    ; markPropertyAliasReferenced — `Foo.Bar`'s `Foo` is referenced unless `Bar`
    ; is a const enum (or an enum member read inside an enum member), with the
    ; property lookup deferred as far as the reference defers it.
    procedure mark_property_alias_referenced(this, location: ref[AstNode], prop_symbol: ref[Symbol]?, parent_type: ref[Type]?)
    {
        if Checker.is_part_of_import_equals_module_reference(location)
            return
        var left: ref[AstNode]? null
        if AstNode.kind_of(location) = KindPropertyAccessExpression
            set left: AstNode.expression_of(location)
        else
            set left: AstNode.qualified_left_of(location)
        if left = null
            return
        let l left as ref[AstNode]
        if AstNode.is_this_identifier(l)
            return
        if AstNode.kind_of(l) <> KindIdentifier
            return
        let unported_before this.unported_mark()
        let parent_symbol this.get_resolved_symbol(l)
        if this.unported_mark() <> unported_before
            return
        if parent_symbol = unknown_symbol
            return
        var early false
        if this.get_isolated_modules()
            set early: true
        if early = false
        {
            if this.should_preserve_const_enums()
            {
                if Checker.is_export_or_export_expression(location)
                    set early: true
            }
        }
        if early
        {
            this.mark_alias_referenced(parent_symbol, location)
            return
        }
        var left_type: ref[Type]? parent_type
        if left_type = null
        {
            set left_type: this.check_expression_cached(l)
            if this.unported_mark() <> unported_before
                return
            if left_type = null
                return
        }
        let lt left_type as ref[Type]
        var any_or_silent (lt.flags & TypeFlagsAny) <> 0
        if lt = silent_never_type
            set any_or_silent: true
        if any_or_silent
        {
            this.mark_alias_referenced(parent_symbol, location)
            return
        }
        var prop: ref[Symbol]? prop_symbol
        if prop = null
        {
            if parent_type = null
            {
                var right: ref[AstNode]? null
                if AstNode.kind_of(location) = KindPropertyAccessExpression
                    set right: AstNode.property_access_name_of(location)
                else
                    set right: AstNode.qualified_right_of(location)
                if right = null
                    return
                let r right as ref[AstNode]
                var lexically_scoped: ref[Symbol]? null
                if AstNode.kind_of(r) = KindPrivateIdentifier
                {
                    set lexically_scoped: this.lookup_symbol_for_private_identifier_declaration(AstNode.identifier_text_of(r), r)
                    if this.unported_mark() <> unported_before
                        return
                }
                var widened lt
                var widen false
                if Checker.get_assignment_target_kind(location) <> AssignmentKindNone
                    set widen: true
                if Checker.is_method_access_for_call(location)
                    set widen: true
                if widen
                {
                    let w this.get_widened_type(lt)
                    if this.unported_mark() <> unported_before
                        return
                    if w = null
                        return
                    set widened: w as ref[Type]
                }
                let apparent this.get_apparent_type(widened)
                if this.unported_mark() <> unported_before
                    return
                if apparent = null
                    return
                let at apparent as ref[Type]
                if AstNode.kind_of(r) = KindPrivateIdentifier
                {
                    if lexically_scoped <> null
                        set prop: this.get_private_identifier_property_of_type(at, lexically_scoped as ref[Symbol])
                }
                else
                    set prop: this.get_property_of_type(at, AstNode.identifier_text_of(r))
                if this.unported_mark() <> unported_before
                    return
            }
        }
        var skip false
        if prop <> null
        {
            let ps prop as ref[Symbol]
            if Checker.is_const_enum_or_const_enum_only_module(ps)
                set skip: true
            if (Symbol.flags_of(ps) & SymbolFlagsEnumMember) <> 0
            {
                if Checker.kind_or_unknown(AstNode.parent_node_of(location)) = KindEnumMember
                    set skip: true
            }
        }
        if skip = false
            this.mark_alias_referenced(parent_symbol, location)
    }

    ; isPartOfImportEqualsModuleReference — the location sits inside the module
    ; reference of an enclosing `import x = …`.
    function is_part_of_import_equals_module_reference(location: ref[AstNode]) returns bool
    {
        let import_equals Checker.find_ancestor_kind(location, KindImportEqualsDeclaration)
        if import_equals = null
            return false
        let ie import_equals as ref[AstNode]
        let module_reference AstNode.module_reference_of(ie)
        var n: ref[AstNode]? location
        while n <> null
        {
            let nn n as ref[AstNode]
            if nn = ie
                break
            if module_reference <> null
            {
                if nn = (module_reference as ref[AstNode])
                    return true
            }
            set n: AstNode.parent_node_of(nn)
        }
        false
    }

    ; ShouldPreserveConstEnums — `preserveConstEnums || isolatedModules`, both
    ; unset under this harness.
    ; ShouldPreserveConstEnums: `preserveConstEnums` or isolatedModules (which
    ; keeps every const enum, since nothing can be inlined across a file)
    function should_preserve_const_enums(this) returns bool
    {
        if preserve_const_enums
            return true
        this.get_isolated_modules()
    }

    ; isExportOrExportExpression — an export assignment's expression, an export
    ; specifier's name, or an exported declaration on the way up.
    function is_export_or_export_expression(location: ref[AstNode]) returns bool
    {
        var n: ref[AstNode]? location
        while n <> null
        {
            let nn n as ref[AstNode]
            let p AstNode.parent_node_of(nn)
            if p = null
                return false
            let pn p as ref[AstNode]
            let pk AstNode.kind_of(pn)
            if pk = KindExportAssignment
                return AstNode.expression_of(pn) = nn
            if pk = KindExportSpecifier
                return true
            if pk = KindSourceFile
                return false
            set n: p
        }
        false
    }

    ; shouldMarkIdentifierAliasReferenced — not the LHS of a property access
    ; (checkPropertyAccessExpression handles that), not a name inside a type-only
    ; export specifier or declaration.
    function should_mark_identifier_alias_referenced(node: ref[AstNode]) returns bool
    {
        let parent AstNode.parent_node_of(node)
        if parent = null
            return true
        let p parent as ref[AstNode]
        let pk AstNode.kind_of(p)
        if pk = KindPropertyAccessExpression
        {
            if AstNode.expression_of(p) = node
                return false
        }
        if pk = KindExportSpecifier
        {
            if AstNode.is_type_only_of(p)
                return false
        }
        let gp AstNode.parent_node_of(p)
        if gp <> null
        {
            let ggp AstNode.parent_node_of(gp as ref[AstNode])
            if ggp <> null
            {
                if AstNode.kind_of(ggp as ref[AstNode]) = KindExportDeclaration
                {
                    if AstNode.is_type_only_of(ggp as ref[AstNode])
                        return false
                }
            }
        }
        true
    }

    ; markExportAssignmentAliasReferenced.
    procedure mark_export_assignment_alias_referenced(this, location: ref[AstNode])
    {
        let id AstNode.expression_of(location)
        if Checker.kind_or_unknown(id) <> KindIdentifier
            return
        let sym this.get_export_symbol_of_value_symbol_if_exported(this.resolve_entity_name(id as ref[AstNode], SymbolFlagsAll, true, true, location))
        if sym = null
            return
        this.mark_alias_referenced(sym, id as ref[AstNode])
    }

    ; markExportSpecifierAliasReferenced.
    procedure mark_export_specifier_alias_referenced(this, location: ref[AstNode])
    {
        let unported_before this.unported_mark()
        let decl AstNode.parent_node_of(AstNode.parent_node_of(location))
        if AstNode.module_specifier_of(decl) <> null
            return
        if AstNode.is_type_only_of(location)
            return
        if AstNode.is_type_only_of(decl)
            return
        let exported_name Checker.property_name_or_name_of(location)
        if exported_name = null
            return
        let en exported_name as ref[AstNode]
        if AstNode.kind_of(en) = KindStringLiteral
            return
        let symbol this.resolve_name(en, AstNode.identifier_text_of(en), SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace | SymbolFlagsAlias, 0, true, false)
        if this.unported_mark() <> unported_before
            return
        if Checker.symbol_is_non_local(this, symbol)
            return
        var target symbol
        if target <> null
        {
            let t target as ref[Symbol]
            if (Symbol.flags_of(t) & SymbolFlagsAlias) <> 0
            {
                set target: this.resolve_alias(t)
                if this.unported_mark() <> unported_before
                    return
            }
        }
        var marks false
        if target = null
            set marks: true
        else
        {
            if (this.get_symbol_flags(target as ref[Symbol]) & SymbolFlagsValue) <> 0
                set marks: true
        }
        if this.unported_mark() <> unported_before
            return
        if marks
        {
            this.mark_export_as_referenced(location)
            this.mark_identifier_alias_referenced(en)
        }
    }

    ; The `symbol == undefinedSymbol || symbol == globalThisSymbol ||
    ; IsGlobalSourceFile(GetDeclarationContainer(declarations[0]))` test, which
    ; checkExportSpecifier and the marker ask in opposite directions.
    procedure symbol_is_non_local(c: ref[Checker], symbol: ref[Symbol]?) returns bool
    {
        if symbol = null
            return false
        let s symbol as ref[Symbol]
        if s = c.undefined_symbol
            return true
        if s = c.global_this_symbol
            return true
        if Symbol.declaration_count(s) = 0
            return false
        c.is_global_source_file_node(Checker.get_declaration_container(Symbol.declaration_at(s, 0) as ref[AstNode]))
    }

    ; markIdentifierAliasReferenced.
    procedure mark_identifier_alias_referenced(this, location: ref[AstNode])
    {
        let unported_before this.unported_mark()
        let symbol this.get_resolved_symbol(location)
        if this.unported_mark() <> unported_before
            return
        if symbol = arguments_symbol
            return
        if symbol = unknown_symbol
            return
        if Checker.is_this_in_type_query(location)
            return
        this.mark_alias_referenced(symbol, location)
    }

    ; markAliasReferenced — all three disjuncts since slice 248 (a multi-file
    ; program reaches the first two).
    procedure mark_alias_referenced(this, symbol: ref[Symbol]?, location: ref[AstNode])
    {
        let unported_before this.unported_mark()
        if Checker.is_non_local_alias(symbol, SymbolFlagsValue) = false
            return
        if Checker.is_in_type_query(location)
            return
        let s symbol as ref[Symbol]
        let target this.resolve_alias(s)
        if this.unported_mark() <> unported_before
            return
        if (this.get_symbol_flags_ex(s, true, false) & (SymbolFlagsValue | SymbolFlagsExportValue)) = 0
            return
        if this.unported_mark() <> unported_before
            return
        ; an alias resolving to a const enum cannot be elided under isolatedModules
        ; (nothing is inlined), nor when it is an export of a const enum that will
        ; be preserved — the two disjuncts the single-file harness never reached
        var keep this.get_isolated_modules()
        if keep = false
        {
            if this.should_preserve_const_enums()
                set keep: Checker.is_export_or_export_expression(location)
        }
        if keep = false
        {
            if Checker.is_const_enum_or_const_enum_only_module(this.get_export_symbol_of_value_symbol_if_exported(target))
                return
        }
        this.mark_alias_symbol_as_referenced(s)
    }

    ; isConstEnumOrConstEnumOnlyModule.
    function is_const_enum_or_const_enum_only_module(s: ref[Symbol]?) returns bool
    {
        if s = null
            return false
        let f Symbol.flags_of(s as ref[Symbol])
        if (f & SymbolFlagsConstEnum) <> 0
            return true
        (f & SymbolFlagsConstEnumOnlyModule) <> 0
    }

    ; markAliasSymbolAsReferenced. ★The deferred half — an `import a = b.c` whose
    ; reference is checked only once the import itself is referenced — is the
    ; reference's own comment and is ported with it.
    procedure mark_alias_symbol_as_referenced(this, symbol: ref[Symbol])
    {
        let links this.alias_symbol_link_of(symbol)
        if links.referenced
            return
        set links.referenced: true
        let node this.get_declaration_of_alias_symbol(symbol)
        if node = null
        {
            this.record_unported("mark-alias-no-declaration", 0)
            return
        }
        let n node as ref[AstNode]
        if AstNode.kind_of(n) <> KindImportEqualsDeclaration
            return
        if AstNode.import_equals_reference_kind(n) = KindExternalModuleReference
            return
        let resolved this.resolve_symbol(symbol)
        if resolved = null
            return
        if (this.get_symbol_flags(resolved as ref[Symbol]) & SymbolFlagsValue) = 0
            return
        let left Checker.get_first_identifier(AstNode.module_reference_of(n))
        if left = null
            return
        this.mark_identifier_alias_referenced(left as ref[AstNode])
    }

    ; ast.GetFirstIdentifier — the leftmost name of a dotted entity name.
    function get_first_identifier(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var n node
        repeat
        {
            let k Checker.kind_or_unknown(n)
            if k = KindQualifiedName
            {
                set n: AstNode.qualified_left_of(n)
                continue
            }
            if k = KindPropertyAccessExpression
            {
                set n: AstNode.expression_of(n)
                continue
            }
            break
        }
        n
    }

    ; markExportAsReferenced.
    procedure mark_export_as_referenced(this, node: ref[AstNode])
    {
        let unported_before this.unported_mark()
        let symbol this.get_symbol_of_declaration(node)
        if symbol = null
            return
        let s symbol as ref[Symbol]
        let target this.resolve_alias(s)
        if this.unported_mark() <> unported_before
            return
        if target = null
            return
        var mark_alias false
        if (target as ref[Symbol]) = unknown_symbol
            set mark_alias: true
        else
        {
            if (this.get_symbol_flags_ex(s, true, false) & SymbolFlagsValue) <> 0
            {
                if Checker.is_const_enum_or_const_enum_only_module(target) = false
                    set mark_alias: true
            }
        }
        if this.unported_mark() <> unported_before
            return
        if mark_alias
            this.mark_alias_symbol_as_referenced(s)
    }

    ; ── checkAliasSymbol, checkExportSpecifier, checkExternalModuleExports ───
    ;
    ; ★★★ THE ISOLATED-MODULES BLOCK IS DEAD BY VALUE AND IT IS HALF THE FUNCTION.
    ; `GetIsolatedModules()` is `IsolatedModules == true || VerbatimModuleSyntax ==
    ; true` and both are unset, so the eight reports it guards — every
    ; verbatimModuleSyntax message, the const-enum access report and the two
    ; re-export ones — have no host. Written as the guard plus one stop, which is
    ; §3.5v's shape and makes them the work list for an options record.
    procedure check_alias_symbol(this, node: ref[AstNode])
    {
        let unported_before this.unported_mark()
        let symbol0 this.get_symbol_of_declaration(node)
        if symbol0 = null
            return
        let target this.resolve_alias(symbol0 as ref[Symbol])
        if this.unported_mark() <> unported_before
            return
        if target = null
            return
        let t target as ref[Symbol]
        if t = unknown_symbol
            return
        var symbol symbol0 as ref[Symbol]
        let es Symbol.export_symbol_of(symbol)
        if es <> null
            set symbol: es as ref[Symbol]
        let merged this.get_merged_symbol(symbol)
        if merged = null
            return
        set symbol: merged as ref[Symbol]
        let target_flags this.get_symbol_flags(t)
        if this.unported_mark() <> unported_before
            return
        ; The JS-file arm: a type imported into JavaScript. ★Both reports are exact
        ; here; only the related info reads the source file's export table, and the
        ; related info is invisible to this yardstick.
        if Parser.is_in_js_file(node)
        {
            if (target_flags & SymbolFlagsValue) = 0
            {
                if Checker.is_type_only_import_or_export_declaration(node) = false
                {
                    var error_node: ref[AstNode]? Checker.property_name_or_name_of(node)
                    if error_node = null
                        set error_node: node
                    if AstNode.kind_of(node) = KindExportSpecifier
                    {
                        let js_export_mark this.diagnostic_mark()
                        this.error_on_node(error_node, DiagTypes_cannot_appear_in_export_declarations_in_JavaScript_files)
                        ; the alias already exported under that name: its JS type alias declaration
                        let source_symbol AstNode.symbol_of(Checker.source_file_of_node(node))
                        if source_symbol <> null
                        {
                            let exported_name AstNode.identifier_text_of(Checker.property_name_or_name_of(node))
                            let already SymbolTable.get(Symbol.exports_of(source_symbol as ref[Symbol]), exported_name)
                            if (already <> null) and (already = target)
                            {
                                let already_symbol already as ref[Symbol]
                                var ai 0
                                while ai < Symbol.declaration_count(already_symbol)
                                {
                                    let ad Symbol.declaration_at(already_symbol, ai)
                                    set ai: ai + 1
                                    if Checker.kind_or_unknown(ad) = KindJSTypeAliasDeclaration
                                    {
                                        this.related_info_since(js_export_mark, ad, DiagX_0_is_automatically_exported_here, Checker.arg_text(Symbol.name_of(already_symbol)))
                                        break
                                    }
                                }
                            }
                        }
                    }
                    else
                    {
                        var identifier_text Checker.arg_text(Symbol.name_of(symbol))
                        if Checker.kind_or_unknown(error_node) = KindIdentifier
                            set identifier_text: Checker.arg_text(AstNode.identifier_text_of(error_node))
                        var specifier_text String("...")
                        var up: ref[AstNode]? node
                        while up <> null
                        {
                            let uk AstNode.kind_of(up as ref[AstNode])
                            if (uk = KindImportDeclaration) or (uk = KindJSImportDeclaration) or (uk = KindImportEqualsDeclaration) or (uk = KindVariableDeclaration)
                            {
                                let spec NodeBuilder.try_get_module_specifier_from_declaration(up as ref[AstNode])
                                if spec <> null
                                    set specifier_text: Checker.arg_text(AstNode.literal_text_of(spec))
                                set up: null
                            }
                            else
                                set up: AstNode.parent_node_of(up as ref[AstNode])
                        }
                        var import_text StringBuilder()
                        import_text.append("import(\"")
                        import_text.append(specifier_text)
                        import_text.append("\")")
                        if AstNode.kind_of(node) = KindImportSpecifier
                        {
                            import_text.append("." as char)
                            import_text.append(identifier_text)
                        }
                        this.error_on_node(error_node, DiagX_0_is_a_type_and_cannot_be_imported_in_JavaScript_files_Use_1_in_a_JSDoc_type_annotation, identifier_text, import_text.to_string())
                    }
                    return
                }
            }
        }
        let sf Symbol.flags_of(symbol)
        var excluded 0
        if (sf & (SymbolFlagsValue | SymbolFlagsExportValue)) <> 0
            set excluded: excluded | SymbolFlagsValue
        if (sf & SymbolFlagsType) <> 0
            set excluded: excluded | SymbolFlagsType
        if (sf & SymbolFlagsNamespace) <> 0
            set excluded: excluded | SymbolFlagsNamespace
        if (target_flags & excluded) <> 0
        {
            if AstNode.kind_of(node) = KindExportSpecifier
                this.error_on_node(node, DiagExport_declaration_conflicts_with_exported_declaration_of_0, this.symbol_arg(symbol))
            else
                this.error_on_node(node, DiagImport_declaration_conflicts_with_local_declaration_of_0, this.symbol_arg(symbol))
        }
        else
        {
            ; `else if !IsExportSpecifier(node)`, whose body reads
            ; `compilerOptions.IsolatedModules` DIRECTLY rather than through
            ; GetIsolatedModules — the reference's own comment says why: under
            ; verbatimModuleSyntax the type-import report has already fired. The
            ; option is unset, so the report has no host.
            if AstNode.kind_of(node) <> KindExportSpecifier
            {
                ; an import that LOOKS like a value to a transpiler (isolatedModules,
                ; not type-only) conflicting with a local value (slice 249)
                if isolated_modules
                {
                    if Checker.find_ancestor_type_only_import_or_export(node) = null
                    {
                        if (sf & (SymbolFlagsValue | SymbolFlagsExportValue)) <> 0
                            this.error_on_node(node, DiagImport_0_conflicts_with_local_value_so_must_be_declared_with_a_type_only_import_when_isolatedModules_is_enabled, this.symbol_arg(symbol), this.isolated_modules_like_flag_name())
                    }
                }
            }
        }
        ; the isolatedModules/verbatimModuleSyntax type-only arms (slice 249)
        if this.get_isolated_modules() and (Checker.is_type_only_import_or_export_declaration(node) = false) and ((AstNode.flags_of(node) & NodeFlagsAmbient) = 0)
        {
            let type_only_alias this.get_type_only_alias_declaration(symbol)
            let is_type (target_flags & SymbolFlagsValue) = 0
            if is_type or (type_only_alias <> null)
            {
                let nk AstNode.kind_of(node)
                if (nk = KindImportClause) or (nk = KindImportSpecifier) or (nk = KindImportEqualsDeclaration)
                {
                    if verbatim_module_syntax
                    {
                        if Checker.is_internal_module_import_equals_declaration(node)
                            this.error_on_node(node, DiagAn_import_alias_cannot_resolve_to_a_type_or_type_only_declaration_when_verbatimModuleSyntax_is_enabled)
                        else
                        {
                            let import_name Checker.arg_text(AstNode.identifier_text_of(Checker.property_name_or_name_of(node)))
                            let import_mark this.diagnostic_mark()
                            if is_type
                                this.error_on_node(node, DiagX_0_is_a_type_and_must_be_imported_using_a_type_only_import_when_verbatimModuleSyntax_is_enabled, import_name)
                            else
                            {
                                this.error_on_node(node, DiagX_0_resolves_to_a_type_only_declaration_and_must_be_imported_using_a_type_only_import_when_verbatimModuleSyntax_is_enabled, import_name)
                                this.add_type_only_declaration_related_info(import_mark, type_only_alias, import_name)
                            }
                        }
                    }
                    if is_type and (nk = KindImportEqualsDeclaration) and b.has_syntactic_modifier(node, ModifierFlagsExport)
                        this.error_on_node(node, DiagCannot_use_export_import_on_a_type_or_type_only_namespace_when_0_is_enabled, this.isolated_modules_like_flag_name())
                }
                if nk = KindExportSpecifier
                {
                    var report verbatim_module_syntax
                    if report = false
                    {
                        if Checker.source_file_of_node(type_only_alias) <> Checker.source_file_of_node(node)
                            set report: true
                    }
                    if report
                    {
                        if is_type
                            this.error_on_node(node, DiagRe_exporting_a_type_when_0_is_enabled_requires_using_export_type, this.isolated_modules_like_flag_name())
                        else
                        {
                            let export_name Checker.arg_text(AstNode.identifier_text_of(Checker.property_name_or_name_of(node)))
                            let export_mark this.diagnostic_mark()
                            this.error_on_node(node, DiagX_0_resolves_to_a_type_only_declaration_and_must_be_re_exported_using_a_type_only_re_export_when_1_is_enabled, export_name, this.isolated_modules_like_flag_name())
                            this.add_type_only_declaration_related_info(export_mark, type_only_alias, export_name)
                        }
                    }
                }
            }
            let nk2 AstNode.kind_of(node)
            let node_format this.file_emit_format_of(Checker.source_file_of_node(node))
            if verbatim_module_syntax and (nk2 <> KindImportEqualsDeclaration) and (Parser.is_in_js_file(node) = false) and (node_format = ModuleKindCommonJS)
                this.report_verbatim_module_syntax_error(node)
            else
            {
                if (module_kind = ModuleKindPreserve) and (nk2 <> KindImportEqualsDeclaration) and (nk2 <> KindVariableDeclaration) and (node_format = ModuleKindCommonJS)
                    this.error_on_node(node, DiagECMAScript_module_syntax_is_not_allowed_in_a_CommonJS_module_when_module_is_set_to_preserve)
            }
            ; the ambient const enum under verbatimModuleSyntax (project-reference
            ; redirects are not ported: the redirect is nil)
            if verbatim_module_syntax and (Checker.is_type_only_import_or_export_declaration(node) = false) and ((AstNode.flags_of(node) & NodeFlagsAmbient) = 0) and ((target_flags & SymbolFlagsConstEnum) <> 0)
            {
                let ced Symbol.value_declaration_of(t)
                if ced <> null
                {
                    if ((AstNode.flags_of(ced as ref[AstNode]) & NodeFlagsAmbient) <> 0) and (this.redirect_preserves_const_enums(ced as ref[AstNode]) = false)
                        this.error_on_node(node, DiagCannot_access_ambient_const_enums_when_0_is_enabled, this.isolated_modules_like_flag_name())
                }
            }
        }
        if AstNode.kind_of(node) = KindImportSpecifier
        {
            let target_symbol this.resolve_alias_with_deprecation_check(symbol, node)
            if this.unported_mark() <> unported_before
                return
            ; addDeprecatedSuggestion writes to the SUGGESTION list, which
            ; GetDiagnostics does not read (c.suggestion_count's note), so what is
            ; kept here is the count.
            if target_symbol <> null
            {
                if this.is_deprecated_symbol(target_symbol as ref[Symbol])
                {
                    if Symbol.declaration_count(target_symbol as ref[Symbol]) > 0
                        set suggestion_count: suggestion_count + 1
                }
            }
        }
    }

    ; resolveAliasWithDeprecationCheck.
    procedure resolve_alias_with_deprecation_check(this, symbol: ref[Symbol], location: ref[AstNode]) returns ref[Symbol]?
    {
        let unported_before this.unported_mark()
        if (Symbol.flags_of(symbol) & SymbolFlagsAlias) = 0
            return symbol
        if this.is_deprecated_symbol(symbol)
            return symbol
        if this.get_declaration_of_alias_symbol(symbol) = null
            return symbol
        let target_symbol this.resolve_alias(symbol)
        if this.unported_mark() <> unported_before
            return null
        if target_symbol = null
            return null
        let ts target_symbol as ref[Symbol]
        if ts = unknown_symbol
            return target_symbol
        var cur symbol
        repeat
        {
            if (Symbol.flags_of(cur) & SymbolFlagsAlias) = 0
                break
            let target this.get_immediate_aliased_symbol(cur)
            if this.unported_mark() <> unported_before
                return null
            if target = null
                break
            let tg target as ref[Symbol]
            if tg = ts
                break
            if Symbol.declaration_count(tg) = 0
                break
            if this.is_deprecated_symbol(tg)
            {
                set suggestion_count: suggestion_count + 1
                break
            }
            if cur = ts
                break
            set cur: tg
        }
        target_symbol
    }

    ; checkExportSpecifier.
    procedure check_export_specifier(this, node: ref[AstNode])
    {
        let unported_before this.unported_mark()
        this.check_alias_symbol(node)
        if this.unported_mark() <> unported_before
            return
        let decl AstNode.parent_node_of(AstNode.parent_node_of(node))
        let has_module_specifier AstNode.module_specifier_of(decl) <> null
        this.check_module_export_name(AstNode.property_name_of(node), has_module_specifier)
        this.check_module_export_name(AstNode.name_of(node), true)
        if has_module_specifier = false
        {
            let exported_name Checker.property_name_or_name_of(node)
            if Checker.kind_or_unknown(exported_name) = KindStringLiteral
                return
            let en exported_name as ref[AstNode]
            let symbol this.resolve_name(en, AstNode.identifier_text_of(en), SymbolFlagsValue | SymbolFlagsType | SymbolFlagsNamespace | SymbolFlagsAlias, 0, true, false)
            if this.unported_mark() <> unported_before
                return
            if Checker.symbol_is_non_local(this, symbol)
                this.error_on_node(en, DiagCannot_export_0_Only_local_declarations_can_be_exported_from_a_module, Checker.arg_text(AstNode.identifier_text_of(en)))
            else
                this.mark_linked_references(node, ReferenceHintExportSpecifier, null, null)
            return
        }
        ; The emit-helper branch needs the file's emit format to be CommonJS, and
        ; the stub program answers ModuleKindNone.
        if emit_module_format = ModuleKindCommonJS
            this.check_external_emit_helpers(node, ExternalEmitHelpersImportDefault)
    }

    ; checkModuleExportName. ★The second arm needs module_kind to be ES2015 or
    ; ES2020 and it is ES2022, so the string-literal name is permitted here and the
    ; identifier-expected report is the whole of the function.
    procedure check_module_export_name(this, name: ref[AstNode]?, allow_string_literal: bool)
    {
        if Checker.kind_or_unknown(name) <> KindStringLiteral
            return
        if allow_string_literal = false
        {
            this.grammar_error_on_node(name, DiagIdentifier_expected)
            return
        }
        ; slice 254: the emit programs read the module option
        if (module_kind = ModuleKindES2015) or (module_kind = ModuleKindES2020)
        {
            let nb this.binder_of_node(name)
            if nb.is_declaration_file_of() = false
                this.grammar_error_on_node(name, DiagString_literal_import_and_export_names_are_not_supported_when_the_module_flag_is_set_to_es2015_or_es2020)
        }
    }

    ; checkExternalModuleExports — the file's export table walked for a name
    ; exported twice with different meanings, plus the `export =` conflict.
    procedure check_external_module_exports(this, node: ref[AstNode])
    {
        let unported_before this.unported_mark()
        let module_symbol this.get_symbol_of_declaration(node)
        if module_symbol = null
            return
        let ms module_symbol as ref[Symbol]
        let links this.module_symbol_link_of(ms)
        if links.exports_checked
            return
        ; ★★★ THE BIT IS SET **HERE** AND NOT AT THE REFERENCE'S PLACE AT THE END,
        ; and the difference is a defect diagcheck caught: this function REPORTS and
        ; every stop-guard below it returns early, so with the bit at the end a walk
        ; that stopped mid-body left it clear and the second caller re-reported.
        ; Measured on `export default 1; export = a;` — TS2309 TWICE against the
        ; reference's once, and only when `a` is undeclared, so that get_symbol_flags
        ; stops inside has_exported_members_of_kind. It is SymbolNodeLink's rule read
        ; in the other direction: *a memo may remove work; it may not remove a stop*
        ; — and a REPORT memo may not be removed BY one.
        set links.exports_checked: true
        var ed Slice[char]()
        set ed: Binder.internal_name_unprefixed(host, "export=")
        let export_equals_symbol SymbolTable.get(Symbol.exports_of(ms), ed)
        if export_equals_symbol <> null
        {
            var conflicts this.has_exported_members_of_kind(ms, SymbolFlagsValue)
            if this.unported_mark() <> unported_before
                return
            if conflicts = false
            {
                set conflicts: this.has_shadowed_namespace(export_equals_symbol as ref[Symbol])
                if this.unported_mark() <> unported_before
                    return
            }
            if conflicts
            {
                var declaration this.get_declaration_of_alias_symbol(export_equals_symbol as ref[Symbol])
                if declaration = null
                    set declaration: Symbol.value_declaration_of(export_equals_symbol as ref[Symbol])
                if declaration <> null
                {
                    if this.is_top_level_in_external_module_augmentation(declaration as ref[AstNode]) = false
                        this.error_on_node(declaration, DiagAn_export_assignment_cannot_be_used_in_a_module_with_other_exported_elements)
                }
            }
        }
        ; "Checks for export * conflicts."
        var sd Slice[char]()
        set sd: Binder.internal_name(host, "export")
        let exports this.get_exports_of_module(ms)
        if this.unported_mark() <> unported_before
            return
        let n SymbolTable.length(exports)
        var i 0
        while i < n
        {
            let id_data SymbolTable.entry_name_at(exports, i)
            let id_len SymbolTable.entry_name_len_at(exports, i)
            let sym SymbolTable.entry_symbol_at(exports, i)
            set i: i + 1
            if sym = null
                continue
            if SymbolTable.names_equal(id_data, sd)
                continue
            let s sym as ref[Symbol]
            if (Symbol.flags_of(s) & (SymbolFlagsNamespace | SymbolFlagsEnum)) <> 0
                continue
            ; "TS Exceptions: namespaces, function overloads, enums, and
            ; interfaces" — the count is of declarations that are neither an
            ; overload signature, nor an accessor, nor an interface.
            let dn Symbol.declaration_count(s)
            var counted 0
            var j 0
            while j < dn
            {
                let d Symbol.declaration_at(s, j)
                set j: j + 1
                if d = null
                    continue
                if Checker.is_not_overload(d as ref[AstNode]) = false
                    continue
                let dk AstNode.kind_of(d as ref[AstNode])
                if dk = KindGetAccessor
                    continue
                if dk = KindSetAccessor
                    continue
                if dk = KindInterfaceDeclaration
                    continue
                set counted: counted + 1
            }
            if (Symbol.flags_of(s) & SymbolFlagsTypeAlias) <> 0
            {
                ; "it is legal to merge type alias with other values, so count
                ; should be either 1 (just type alias) or 2 (type alias + merged
                ; value)".
                if counted <= 2
                    continue
            }
            if counted <= 1
                continue
            ; `core.Every(declarations, GetAssignmentDeclarationKind(node) ==
            ; ExportsProperty)` — the JS `exports.x = …` form, which SUPPRESSES the
            ; report: several `exports.x = …` for one name are one declaration as
            ; far as ECMA262's duplicate rule is concerned.
            ;
            ; ★★ THE PREDICATE RUNS OVER EVERY DECLARATION, the overload signatures
            ; included, where `counted` above counts only the ones that are not
            ; overloads — so the two walks are not interchangeable.
            var every_exports_property true
            var k 0
            while k < dn
            {
                let d Symbol.declaration_at(s, k)
                set k: k + 1
                if Parser.get_assignment_declaration_kind(d) <> JSDeclarationKindExportsProperty
                    set every_exports_property: false
            }
            if every_exports_property
                continue
            var m 0
            while m < dn
            {
                let d Symbol.declaration_at(s, m)
                set m: m + 1
                if d = null
                    continue
                if Checker.is_not_overload(d as ref[AstNode])
                    this.error_on_node(d, DiagCannot_redeclare_exported_variable_0, Checker.arg_text(id_data))
            }
        }
    }

    ; hasExportedMembersOfKind.
    procedure has_exported_members_of_kind(this, module_symbol: ref[Symbol], kind: int) returns bool
    {
        let unported_before this.unported_mark()
        var ed Slice[char]()
        set ed: Binder.internal_name_unprefixed(host, "export=")
        let exports Symbol.exports_of(module_symbol)
        let n SymbolTable.length(exports)
        var i 0
        while i < n
        {
            let nd SymbolTable.entry_name_at(exports, i)
            let nl SymbolTable.entry_name_len_at(exports, i)
            let sym SymbolTable.entry_symbol_at(exports, i)
            set i: i + 1
            if sym = null
                continue
            if SymbolTable.names_equal(nd, ed)
                continue
            if (this.get_symbol_flags(sym as ref[Symbol]) & kind) <> 0
                return true
            if this.unported_mark() <> unported_before
                return false
        }
        false
    }

    ; hasShadowedNamespace.
    procedure has_shadowed_namespace(this, symbol: ref[Symbol]) returns bool
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsNamespaceModule) = 0
            return false
        if (Symbol.flags_of(symbol) & SymbolFlagsAlias) = 0
            return false
        let target this.resolve_alias(symbol)
        if target = null
            return false
        let t target as ref[Symbol]
        if (Symbol.flags_of(t) & SymbolFlagsNamespace) = 0
            return false
        this.has_exported_members_of_kind(t, SymbolFlagsType | SymbolFlagsNamespace)
    }

    ; isNotOverload — a function or method declaration WITHOUT a body is an
    ; overload signature; everything else is not an overload.
    function is_not_overload(node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        var signature_bearing false
        if k = KindFunctionDeclaration
            set signature_bearing: true
        if k = KindMethodDeclaration
            set signature_bearing: true
        if signature_bearing = false
            return true
        AstNode.body_of(node) <> null
    }

    ; isTopLevelInExternalModuleAugmentation.
    procedure is_top_level_in_external_module_augmentation(this, node: ref[AstNode]) returns bool
    {
        let p AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(p) <> KindModuleBlock
            return false
        Checker.is_external_module_augmentation(this, AstNode.parent_node_of(p))
    }

    ; ast.IsExternalModuleAugmentation.
    procedure is_external_module_augmentation(c: ref[Checker], node: ref[AstNode]?) returns bool
    {
        if Binder.is_ambient_module(node) = false
            return false
        c.binder_of_node(node).is_module_augmentation_external(node)
    }

    ; resolveTypeReferenceName, whole. ★The `name == nil` answer is unknownSymbol
    ; and NOT a stop: getTypeReferenceType turns it into errorType, which is the
    ; reference's own answer for an expression that is not a qualified name.
    ;
    ; ★★ THE `ignoreErrors` TAIL IS UNREACHABLE AND THE ONE UNDER IT IS NOT. The
    ; only caller that passes ignoreErrors is getTypeFromTypeAliasReference, which
    ; is itself a stop; the unresolved-symbol tail below is reached by a MISSING
    ; name node and has a number (see the chapter header). ★A miss inside
    ; resolve_name STOPS and is caught by the mark above, which is why the two are
    ; different rows rather than one.
    procedure resolve_type_reference_name(this, type_reference: ref[AstNode], meaning: int, ignore_errors: bool) returns ref[Symbol]?
    {
        let nm Checker.get_type_reference_name(type_reference)
        if nm = null
            return unknown_symbol
        let mark this.unported_mark()
        let symbol this.resolve_entity_name(nm as ref[AstNode], meaning, ignore_errors, false, null)
        if symbol <> null
        {
            if (symbol as ref[Symbol]) <> unknown_symbol
                return symbol
        }
        ; ★★★ THE MARK, AND IT IS SLICE 94's FINDING THREE MET FROM THE FAR SIDE.
        ; `is_unported()` is a BOOL — *has this unit stopped at all* — and the very
        ; first thing that happens in a unit carrying a type reference is
        ; `check_type_reference_or_import` stopping on it. So a sticky test here
        ; makes every later resolution in the same unit return without ever asking,
        ; and the chapter answers nothing while its work-list row still empties.
        ; Measured on the first build: the dispatcher's 520 arrivals disappeared
        ; from the tag and not ONE new stop appeared anywhere — **a row that closes
        ; while nothing takes its place is the signature of this defect.**
        if this.unported_mark() <> mark
            return null
        if ignore_errors
            return unknown_symbol
        this.get_unresolved_symbol_for_entity_name(nm as ref[AstNode])
    }

    ; ── slice 114: the name that resolves to nothing ─────────────────────────
    ;
    ; getUnresolvedSymbolForEntityName. ★★★ WHAT IT IS FOR is not error recovery
    ; but a NAME: the symbol it mints carries the identifier's text and its parent
    ; chain, an errorType is hung off it in getTypeFromTypeAliasReference, and the
    ; printer then answers `Widget` where an unrepresented miss would answer `any`.
    ; Under this harness that is not a corner case — every unit of a multi-file
    ; corpus case imports from a module the single-file compile cannot resolve.
    ;
    ; ★ The table is keyed on the PATH and not on the identifier, so `A.T` and
    ; `B.T` are two symbols; the parent is minted by the same recursion, which is
    ; what makes the path unique in the first place.
    procedure get_unresolved_symbol_for_entity_name(this, name: ref[AstNode]) returns ref[Symbol]?
    {
        let k AstNode.kind_of(name)
        var identifier name
        if k = KindQualifiedName
            set identifier: AstNode.qualified_right_of(name) as ref[AstNode]
        if k = KindPropertyAccessExpression
        {
            let nm AstNode.name_of(name)
            if nm = null
                return unknown_symbol
            set identifier: nm as ref[AstNode]
        }
        let text AstNode.identifier_text_of(identifier)
        let text_len AstNode.identifier_text_length_of(identifier)
        if text_len = 0
            return unknown_symbol
        var parent_symbol: ref[Symbol]? null
        if k = KindQualifiedName
        {
            let left AstNode.qualified_left_of(name)
            if left = null
                return unknown_symbol
            set parent_symbol: this.get_unresolved_symbol_for_entity_name(left as ref[AstNode])
        }
        if k = KindPropertyAccessExpression
        {
            let e AstNode.expression_of(name)
            if e = null
                return unknown_symbol
            set parent_symbol: this.get_unresolved_symbol_for_entity_name(e as ref[AstNode])
        }
        var path_data Slice[char]()
        set path_data: Checker.unresolved_path(host, parent_symbol, text)
        let found SymbolTable.get(unresolved_symbols, path_data)
        if found <> null
            return found
        let result Symbol.create(host, SymbolFlagsTypeAlias, text)
        Symbol.set_check_flags(result, CheckFlagsUnresolved)
        Symbol.set_parent(result, parent_symbol)
        SymbolTable.set_entry(host, unresolved_symbols, path_data, result)
        let links this.type_alias_link_of(result)
        set links.declared_type: unresolved_type
        result
    }

    ; getSymbolPath's answer for the symbol this call is ABOUT to mint — the
    ; parent's dotted path, a `.`, and the identifier's own text. ★It is written
    ; as one function rather than as getSymbolPath plus a concatenation because
    ; the parent chain of an unresolved symbol is itself unresolved, so the whole
    ; path is a walk over `name_data`/`name_len` pairs with no other producer.
    function unresolved_path(host: ref[Page], parent: ref[Symbol]?, text: Slice[char]) returns Slice[char]
    {
        var total text.length
        var p parent
        while p <> null
        {
            let ps p as ref[Symbol]
            set total: total + Symbol.name_len_of(ps) + 1
            set p: Symbol.parent_of(ps)
        }
        let buf host.allocate((total + 1) as size_t, 1) as pointer[char]
        ; The chain is walked from the LEAF, so the bytes are filled from the END.
        var at total
        set at: at - text.length
        var i 0
        while i < text.length
        {
            set *(buf + at + i): text[i]
            set i: i + 1
        }
        var q parent
        while q <> null
        {
            let qs q as ref[Symbol]
            set at: at - 1
            set *(buf + at): "." as char
            let nl Symbol.name_len_of(qs)
            let nd Symbol.name_of(qs)
            set at: at - nl
            var j 0
            while j < nl
            {
                set *(buf + at + j): nd[j]
                set j: j + 1
            }
            set q: Symbol.parent_of(qs)
        }
        Slice[char](total, buf)
    }

    ; getSymbolFromTypeReference, whole — the symbolNodeLinks memo in front of the
    ; resolution.
    ;
    ; ★★ THE MEMO IS NOT WRITTEN ON A STOP, and that is the difference between a
    ; cache and a lie: a null answer here means *this call could not finish*, and
    ; storing it would make the second visit to the same node answer unknownSymbol
    ; without ever reaching the wall the first one hit.
    procedure get_symbol_from_type_reference(this, node: ref[AstNode]) returns ref[Symbol]?
    {
        let links this.symbol_node_link_of(node)
        if links.resolved_symbol <> null
            return links.resolved_symbol
        ; See SymbolNodeLink.resolution_stopped: the reference's memo is
        ; unconditional, so the resolution runs once per NODE, and a stop may not
        ; turn that into once per VISIT. The MARK moves as a re-run would have moved
        ; it; the log does not, because the stop it stands for is already in there.
        if links.resolution_stopped
        {
            var r 0
            while r < links.stopped_count
            {
                this.replay_stop_mark()
                set r: r + 1
            }
            return null
        }
        let stop_mark this.unported_mark()
        var sym: ref[Symbol]? null
        if this.is_const_type_reference(node)
        {
            let p AstNode.parent_node_of(node)
            if p <> null
            {
                if Checker.is_assertion_expression(p as ref[AstNode])
                    set sym: unknown_symbol
            }
        }
        if sym = null
            set sym: this.resolve_type_reference_name(node, SymbolFlagsType, false)
        if sym = null
        {
            if this.unported_mark() <> stop_mark
            {
                set links.resolution_stopped: true
                set links.stopped_count: this.unported_mark() - stop_mark
            }
            return null
        }
        set links.resolved_symbol: sym
        links.resolved_symbol
    }

    ; getTypeFromTypeReference, whole.
    ;
    ; ★★★ THE `as const` ARM IS A STOP AND THE JSDOC ONE IS TOO, AND THEY ARE
    ; DIFFERENT KINDS OF STOP. `x as const` resolves to `checkExpressionCached` of
    ; the assertion's OPERAND — the expression chapter, reached from a type node,
    ; which is a route this port does not have here.
    ; getIntendedTypeFromJSDocTypeReference is gated on NodeFlagsJSDoc and rewrites
    ; eight capitalised names to intrinsics; it is written rather than stopped,
    ; because every one of its answers is a type this port already mints and its
    ; guard is a flag — see below.
    ; Does an enclosing JSDoc DECLARE this type reference's name with a `@template`
    ; tag? See the stop inside get_type_from_type_reference for why the question is
    ; asked at all. It walks UP to the JSDoc nodes in the parent chain — the same
    ; chain get_conditional_flow_type_of_type stops at — and reads their tag lists.
    function jsdoc_template_would_declare(this, node: ref[AstNode]) returns bool
    {
        let name_node AstNode.type_reference_name_of(node)
        if name_node = null
            return false
        let nm name_node as ref[AstNode]
        if AstNode.kind_of(nm) <> KindIdentifier
            return false
        let want AstNode.identifier_text_of(nm)
        let want_len AstNode.identifier_text_length_of(nm)
        var cur: ref[AstNode]? AstNode.parent_node_of(node)
        while cur <> null
        {
            let n cur as ref[AstNode]
            if AstNode.kind_of(n) = KindJSDoc
            {
                if Checker.jsdoc_tags_declare_template(n, want)
                    return true
            }
            set cur: AstNode.parent_node_of(n)
        }
        false
    }

    function jsdoc_tags_declare_template(doc: ref[AstNode], want: Slice[char]) returns bool
    {
        let tags AstNode.jsdoc_tag_list_of(doc)
        if tags = null
            return false
        let tl tags as ref[Array[ref[AstNode]?]]
        let n tl.get_length() as int
        var i 0
        while i < n
        {
            let tag tl[i]
            set i: i + 1
            if tag = null
                continue
            let t tag as ref[AstNode]
            if AstNode.kind_of(t) <> KindJSDocTemplateTag
                continue
            let tps AstNode.type_parameters_of(t)
            if tps = null
                continue
            let list tps as ref[Array[ref[AstNode]?]]
            let m list.get_length() as int
            var k 0
            while k < m
            {
                let tp list[k]
                set k: k + 1
                if tp = null
                    continue
                let tpn AstNode.name_of(tp as ref[AstNode])
                if tpn = null
                    continue
                let id tpn as ref[AstNode]
                if AstNode.kind_of(id) <> KindIdentifier
                    continue
                if SymbolTable.names_equal(AstNode.identifier_text_of(id), want)
                    return true
            }
        }
        false
    }

    procedure get_type_from_type_reference(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        if this.is_const_type_reference(node)
        {
            let p AstNode.parent_node_of(node)
            if p <> null
            {
                if Checker.is_assertion_expression(p as ref[AstNode])
                {
                    this.record_unported("const-type-reference", 0)
                    return null
                }
            }
        }
        ; ★★★ THE JSDoc `@template` STOP, SLICE 136, AND ITS PREMISE WAS RETIRED BY
        ; SLICE 144 — it is UNHIT at both corpora now (0 of 1 667, 0 of 18 437) and
        ; kept as the report for a `@template` position the reparse does not reach.
        ; The premise read *this port does not declare the type parameters of a
        ; `@template` tag — measured*, and what made it true was the SHARED-CHILD
        ; clone: a name an enclosing `@template` declares was resolved from a node
        ; whose parent chain went up the JSDoc comment, so it walked past the
        ; declaration to whatever the GLOBALS hold — `@template {Array<unknown>}
        ; [Parameters=[]]` reaching the LIB's `Parameters<T>`, whose arity check
        ; then reported a TS2314 the reference does not have. With the deep clone
        ; the reparsed name sits under the alias and resolves to the parameter:
        ; `typedefMultipleTypeParameters` answers 15 of its 16 lines exactly as the
        ; reference does where it used to stop here.
        ;
        ; ★★★ IT WAS INVISIBLE UNTIL THIS SLICE AND THE WALL THAT HID IT WAS
        ; `conditional-type-infer-context` — the lib's own `Parameters<T>` is a
        ; conditional with an `infer`, so resolving the WRONG symbol used to stop
        ; inside it. Porting the inference context removed the stop and the wrong
        ; answer came out the other side; the resolution defect is older than the
        ; slice that made it speak.
        ;
        ; ★ It is asked on the enclosing JSDoc's OWN tags and nothing wider: the
        ; question is whether the name would have been DECLARED here, so a walk that
        ; searched further would refuse references the port answers correctly today.
        if this.jsdoc_template_would_declare(node)
        {
            this.record_unported("jsdoc-template-type-parameter", KindJSDocTemplateTag)
            return null
        }
        let mark this.unported_mark()
        let jd this.get_intended_type_from_jsdoc_type_reference(node)
        if this.unported_mark() <> mark
            return null
        if jd <> null
        {
            set links.resolved_type: jd
            return links.resolved_type
        }
        let sym this.get_symbol_from_type_reference(node)
        if sym = null
            return null
        let t this.get_type_reference_type(node, sym as ref[Symbol])
        if t = null
            return null
        set links.resolved_type: t
        ; The TYPEREF PIN's entry — see TypeRefEvent's header for why the chapter
        ; needs one. It is written only where the function ANSWERS, so the log's
        ; length is the number of type references this port resolved and not the
        ; number it met.
        if record_events
        {
            let ev &TypeRefEvent^host(AstNode.pos_of(node), AstNode.end_of(node), Symbol.flags_of(sym as ref[Symbol]), (t as ref[Type]).id, t)
            typeref_log.add(ev as ref[TypeRefEvent])
        }
        links.resolved_type
    }

    ; getIntendedTypeFromJSDocTypeReference, and the four arms behind an option.
    ;
    ; ★★ THE EIGHT CAPITALISED NAMES ARE INTRINSICS THIS PORT HAS; THE OTHER FOUR
    ; ARE NOT. `Function`/`function` wants globalFunctionType, `array` and
    ; `promise` are behind `!noImplicitAny` — which is FALSE here, so both arms are
    ; dead by the option rather than by the corpus — and `Object` wants the global
    ; Record symbol. The three that are alive report.
    procedure get_intended_type_from_jsdoc_type_reference(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (AstNode.flags_of(node) & NodeFlagsJSDoc) = 0
            return null
        if AstNode.kind_of(node) <> KindTypeReference
            return null
        let nm AstNode.type_reference_name_of(node)
        if nm = null
            return null
        let name nm as ref[AstNode]
        if AstNode.kind_of(name) <> KindIdentifier
            return null
        let d AstNode.identifier_text_of(name)
        var args_len 0
        let args AstNode.type_arguments_of(node)
        if args <> null
            set args_len: (args as ref[Array[ref[AstNode]?]]).get_length() as int
        if Checker.name_bytes_are(d, "String")
        {
            this.check_no_type_arguments(node, null)
            return string_type
        }
        if Checker.name_bytes_are(d, "Number")
        {
            this.check_no_type_arguments(node, null)
            return number_type
        }
        if Checker.name_bytes_are(d, "BigInt")
        {
            this.check_no_type_arguments(node, null)
            return bigint_type
        }
        if Checker.name_bytes_are(d, "Boolean")
        {
            this.check_no_type_arguments(node, null)
            return boolean_type
        }
        if Checker.name_bytes_are(d, "Void")
        {
            this.check_no_type_arguments(node, null)
            return void_type
        }
        if Checker.name_bytes_are(d, "Undefined")
        {
            this.check_no_type_arguments(node, null)
            return undefined_type
        }
        if Checker.name_bytes_are(d, "Null")
        {
            this.check_no_type_arguments(node, null)
            return null_type
        }
        ; ★★★ THE ROW `global-function-type` WAS AN EXPIRED NOTE at all three of
        ; its sites (§3.5eo, third harvest). Its own comment named §3.11 — the LIB
        ; — and the LIB landed; `get_global_function_type` has been in this file
        ; since the strict-function pair, which uses it as their fallback, and
        ; nothing re-read the note. ★A null answer is the lib WITHOUT a `Function`
        ; interface, where the reference's `getGlobalType` hands out
        ; `emptyObjectType` and reports; that is the one thing this port cannot
        ; say here, so it keeps a row of its own rather than the old one's name.
        var is_function_name false
        if Checker.name_bytes_are(d, "Function")
            set is_function_name: true
        if Checker.name_bytes_are(d, "function")
            set is_function_name: true
        if is_function_name
        {
            this.check_no_type_arguments(node, null)
            let ft this.get_global_function_type()
            if ft = null
            {
                this.record_unported("global-function-type-absent", 0)
                return null
            }
            return ft
        }
        ; `array` and `promise` are both `len(typeArgs) == 0 && !noImplicitAny`,
        ; and noImplicitAny is TRUE here — so both conditions are false and the
        ; switch falls through to the tail exactly as the reference's does. The
        ; arms are written as the option's own reading rather than as a report,
        ; which is what create_widening_type does one chapter up.
        ; `array` / `promise` without type arguments outside noImplicitAny (slice 263)
        if (args_len = 0) and (Checker.no_implicit_any() = false)
        {
            if Checker.name_bytes_are(d, "array")
                return this.get_any_array_type()
            if Checker.name_bytes_are(d, "promise")
                return this.create_promise_type(any_type)
        }
        if Checker.name_bytes_are(d, "Object")
        {
            ; The two-argument arm, slice 176 — `@type {Object<K, V>}` becomes
            ; `Record<K, V>`. ★★★THE TAIL IS `anyType` AND NOT A FALL-THROUGH:
            ; a lib without `Record`, and an index type the reference refuses,
            ; both answer `any` rather than continuing down the switch — which is
            ; the one thing the stop could not say, since a stop leaves the
            ; caller to decide and this arm decides.
            if args_len = 2
            {
                let list args as ref[Array[ref[AstNode]?]]
                var rd Slice[char]()
                set rd: Checker.plain_name(host, "Record")
                this.report_checked_global_type_alias("Record", 2)
                let record_symbol this.get_global_type_alias_symbol(rd, 2)
                if this.unported_mark() <> mark
                    return null
                if record_symbol <> null
                {
                    let a0 list[0]
                    let a1 list[1]
                    if a0 = null
                        return any_type
                    if a1 = null
                        return any_type
                    let index_type this.get_type_from_type_node(a0 as ref[AstNode])
                    if this.unported_mark() <> mark
                        return null
                    if index_type <> null
                    {
                        if this.is_valid_index_key_type(index_type as ref[Type])
                        {
                            let value_type this.get_type_from_type_node(a1 as ref[AstNode])
                            if this.unported_mark() <> mark
                                return null
                            let ta this.new_type_list_of(2)
                            ta.add(index_type)
                            ta.add(value_type)
                            return this.get_type_alias_instantiation(record_symbol as ref[Symbol], ta, null)
                        }
                    }
                    if this.unported_mark() <> mark
                        return null
                }
                return any_type
            }
            if Checker.no_implicit_any() = false
            {
                this.check_no_type_arguments(node, null)
                return any_type
            }
        }
        null
    }

    ; ── getTypeReferenceType ────────────────────────────────────────────────
    ;
    ; ★★★ FOUR ARMS AND THE THREE THAT ANSWER ARE MEASURED. Class/Interface (25
    ; arrivals) is the reference construction below; the TYPE PARAMETER and the
    ; other non-generic named types fall to `tryGetDeclaredTypeOfSymbol`, which is
    ; where the slice's 162 arrivals land; the TYPE ALIAS (26) is
    ; getDeclaredTypeOfTypeAlias, a chapter of its own, and the ENUM (17) is
    ; already a stop inside tryGetDeclaredTypeOfSymbol.
    ;
    ; ★★ THE `res != nil` GUARD AND A STOP ARE NOT THE SAME QUESTION, which is why
    ; the mark is taken. `tryGetDeclaredTypeOfSymbol` answers nil for BOTH *the
    ; reference answers nothing here* — a legal answer that getTypeReferenceType
    ; turns into errorType — and *this port could not get there*. The reference's
    ; falling out of its own switch is the first; a recorded stop is the second;
    ; and reading nil as the first when it is the second would INVENT an errorType
    ; where an honest UNPORTED belongs.
    procedure get_type_reference_type(this, node: ref[AstNode], symbol: ref[Symbol]) returns ref[Type]?
    {
        if symbol = unknown_symbol
            return error_type
        let f Symbol.flags_of(symbol)
        if (f & (SymbolFlagsClass | SymbolFlagsInterface)) <> 0
            return this.get_type_from_class_or_interface_reference(node, symbol)
        if (f & SymbolFlagsTypeAlias) <> 0
            return this.get_type_from_type_alias_reference(node, symbol)
        let mark this.unported_mark()
        let res this.try_get_declared_type_of_symbol(symbol)
        if this.unported_mark() <> mark
            return null
        if res <> null
        {
            if this.check_no_type_arguments(node, symbol)
                return this.get_regular_type_of_literal_type(res as ref[Type])
        }
        ; `!!! Resolving values as types for JS` — the reference's own marker, and
        ; the arm below it is its whole body.
        error_type
    }

    ; `c.errorTypes[getAliasKey(alias)]` as a linear scan over (alias symbol,
    ; alias type arguments) — TypeInstantiation's argument, one dimension over: a
    ; hash buys O(1) and a collision question with it, and this list holds one
    ; entry per distinct unresolved name in a unit.
    function find_error_type(this, symbol: ref[Symbol], args: ref[Array[ref[Type]?]]?) returns ref[Type]?
    {
        let n error_types.get_length() as int
        var i 0
        while i < n
        {
            let row error_types[i]
            if row <> null
            {
                let e row as ref[Type]
                if e.alias_symbol = symbol
                {
                    if Checker.type_lists_equal(e.alias_type_arguments, args)
                        return e
                }
            }
            set i: i + 1
        }
        null
    }

    ; `core.Map(node.TypeArguments(), c.getTypeFromTypeNode)`. ★It answers null
    ; for a node with no type arguments, which is the reference's nil slice and
    ; what makes `Widget` and `Widget<T>` two different cache keys.
    procedure type_arguments_from_type_reference_node(this, node: ref[AstNode]) returns ref[Array[ref[Type]?]]?
    {
        let args AstNode.type_arguments_of(node)
        if args = null
            return null
        let list args as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        if n = 0
            return null
        let out &Array[ref[Type]?]^host()
        var i 0
        while i < n
        {
            let a list[i]
            if a = null
                return null
            let t this.get_type_from_type_node(a as ref[AstNode])
            if t = null
                return null
            out.add(t)
            set i: i + 1
        }
        out
    }

    ; ── getTypeFromTypeAliasReference ───────────────────────────────────────
    ;
    ; ★★★ THE `CheckFlagsUnresolved` ARM IS UNREACHABLE IN THIS PORT BY
    ; CONSTRUCTION, and the proof is one function long rather than an estimate.
    ; The ONLY producer of a symbol carrying that bit anywhere in the reference is
    ; `getUnresolvedSymbolForEntityName`, and its two callers here both go through
    ; `resolve_type_reference_name`, whose corresponding line is the
    ; `get-unresolved-symbol` stop. So no symbol reaching this function can carry
    ; it, and writing the arm would need `Type.alias` and the `errorTypes` cache —
    ; two mechanisms whose only reader is an arm nothing can enter. §3.5v's fourth
    ; reason.
    ;
    ; ★★★ THE FORK IS ON `links.typeParameters`, WHICH getDeclaredTypeOfTypeAlias
    ; FILLS — so the call above it is not merely the answer, it is what decides
    ; which half of this function runs. Reading the declaration's own type
    ; parameters instead would be the same list by luck and the wrong question by
    ; construction: the reference asks the LINKS because a merged alias has one
    ; row and several declarations.
    ;
    ; ★★ THE ARITY REPORT IS PRODUCT AND IT IS THE HALF OF THE GENERIC PATH THAT
    ; LANDS. `report_type_argument_arity` already exists (the class/interface
    ; reference wrote it), the comparison in front of it is three lines, and the
    ; instantiation behind it is the stop — so a generic alias whose arguments are
    ; WRONG gets its TS2314/TS2707 in this slice while a generic alias whose
    ; arguments are right does not get its type.
    procedure get_type_from_type_alias_reference(this, node: ref[AstNode], symbol: ref[Symbol]) returns ref[Type]?
    {
        ; ★★★ THE MARK, AND get_type_reference_type's own header is why it is here
        ; rather than a null test: `get_declared_type_of_symbol` turns a nil into
        ; errorType, so it answers the same thing for *the reference answers
        ; nothing* and for *this port could not get there*. Reading the second as
        ; the first invents an errorType where an honest UNPORTED belongs — and
        ; the alias body below CAN stop, on its own annotation.
        ;
        ; ★★★ THE `CheckFlagsUnresolved` ARM IS CODE SINCE SLICE 114 and the note
        ; that stood over this function is what dated it: it proved the arm
        ; unreachable *by construction* from the ONE producer the reference has,
        ; getUnresolvedSymbolForEntityName — and named the two mechanisms the arm
        ; would need, `Type.alias` and the `errorTypes` cache. That producer landed
        ; in this slice, so the proof expired and both mechanisms are here.
        ;
        ; ★★★ WHAT THE CACHE IS FOR IS NOT SPEED, IT IS IDENTITY. The same
        ; unresolved name reached twice must answer the SAME type object, because
        ; every identity comparison downstream is a pointer comparison — which is
        ; the argument getTypeOfInstantiatedSymbol's memo makes one dimension over.
        if (Symbol.check_flags_of(symbol) & CheckFlagsUnresolved) <> 0
        {
            let mark_u this.unported_mark()
            let alias_args this.type_arguments_from_type_reference_node(node)
            if this.unported_mark() <> mark_u
                return null
            let cached this.find_error_type(symbol, alias_args)
            if cached <> null
                return cached
            let e this.new_intrinsic_type(TypeFlagsAny, "error")
            set e.alias_symbol: symbol
            set e.alias_type_arguments: alias_args
            error_types.add(e)
            return e
        }
        let mark this.unported_mark()
        let t this.get_declared_type_of_symbol(symbol)
        if this.unported_mark() <> mark
            return null
        let links this.type_alias_link_of(symbol)
        var tp_count 0
        if links.type_parameters <> null
            set tp_count: (links.type_parameters as ref[Array[ref[Type]?]]).get_length() as int
        if tp_count <> 0
        {
            var num_type_arguments 0
            let args AstNode.type_arguments_of(node)
            if args <> null
                set num_type_arguments: (args as ref[Array[ref[AstNode]?]]).get_length() as int
            let min_count this.get_min_type_argument_count(links.type_parameters as ref[Array[ref[Type]?]])
            var out_of_range false
            if num_type_arguments < min_count
                set out_of_range: true
            if num_type_arguments > tp_count
                set out_of_range: true
            if out_of_range
            {
                ; The reference chooses the message on
                ; `minTypeArgumentCount == len(typeParameters)` and returns
                ; errorType; report_type_argument_arity is that fork and that
                ; return, written once for both callers. ★`is_js` is FALSE here
                ; where the class/interface caller passes the file's own answer:
                ; the reference's alias path has no isJs term at all.
                return this.report_type_argument_arity(node, min_count, tp_count, false, this.symbol_arg(symbol))
            }
            ; ★★★ SLICE 125 WRITES THE REST, and the stop that stood here named
            ; exactly what it was waiting for: *"getTypeAliasInstantiation … needs
            ; instantiateTypeWithAlias, i.e. `Type.alias`"*. That function exists
            ; now, and this is the frontier's largest row by units.
            ;
            ; The local-alias rule is the reference's own and its comment is worth
            ; keeping: a LOCAL alias is not associated with an instantiation of a
            ; top-level one, because the local name may end up in an inferred
            ; return type where it is not accessible.
            let alias_symbol this.get_alias_symbol_for_type_node(node)
            if this.unported_mark() <> mark
                return null
            var new_alias_symbol: ref[Symbol]? null
            if alias_symbol <> null
            {
                var take false
                if this.is_local_type_alias(symbol)
                    set take: true
                if this.is_local_type_alias(alias_symbol as ref[Symbol]) = false
                    set take: true
                if take
                    set new_alias_symbol: alias_symbol
            }
            var alias_type_arguments: ref[Array[ref[Type]?]]? null
            if new_alias_symbol <> null
                set alias_type_arguments: this.append_local_type_parameters_of_class_or_interface_or_type_alias(null, new_alias_symbol as ref[Symbol])
            if new_alias_symbol = null
            {
                ; ast.IsTypeReferenceType — two kinds, inline for the reason
                ; §3.5e gives for a two-arm predicate with one caller.
                var is_type_reference_type false
                if AstNode.kind_of(node) = KindTypeReference
                    set is_type_reference_type: true
                if AstNode.kind_of(node) = KindExpressionWithTypeArguments
                    set is_type_reference_type: true
                if is_type_reference_type
                {
                    let imported this.resolve_type_reference_name(node, SymbolFlagsAlias, true)
                    if this.unported_mark() <> mark
                        return null
                    if imported <> null
                    {
                        if (imported as ref[Symbol]) <> unknown_symbol
                        {
                            let resolved this.resolve_alias(imported as ref[Symbol])
                            if this.unported_mark() <> mark
                                return null
                            if resolved <> null
                            {
                                if (Symbol.flags_of(resolved as ref[Symbol]) & SymbolFlagsTypeAlias) <> 0
                                {
                                    set new_alias_symbol: resolved
                                    set alias_type_arguments: this.get_type_arguments_from_node(node)
                                    if this.unported_mark() <> mark
                                        return null
                                }
                            }
                        }
                    }
                }
            }
            var new_alias: ref[TypeAlias]? null
            if new_alias_symbol <> null
                set new_alias: &TypeAlias^host(new_alias_symbol, alias_type_arguments) as ref[TypeAlias]?
            let type_args this.get_type_arguments_from_node(node)
            if this.unported_mark() <> mark
                return null
            return this.get_type_alias_instantiation(symbol, type_args, new_alias)
        }
        if this.check_no_type_arguments(node, symbol)
            return t
        error_type
    }

    ; isLocalTypeAlias — a type alias declared INSIDE a function.
    function is_local_type_alias(this, symbol: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if Checker.is_type_alias(d as ref[AstNode])
                    return Checker.get_containing_function(d as ref[AstNode]) <> null
            }
            set i: i + 1
        }
        false
    }

    ; getTypeAliasInstantiation — the memoised instantiation of a GENERIC type
    ; alias. ★★★It is what `Partial<T>`, `Record<K, V>` and `Pick<T, K>` ARE: the
    ; alias's declared type (a mapped type) instantiated through a mapper over its
    ; own type parameters, carrying the alias so that the printer answers
    ; `Partial<T>` rather than the structure.
    ;
    ; ★★★ THE INTRINSIC ARM IS THE MINT SITE OF THIS PORT'S ONLY StringMapping
    ; TYPES (slice 171). `Uppercase`, `Lowercase`, `Capitalize`, `Uncapitalize`
    ; and `NoInfer` are declared in the lib with the `intrinsic` marker, so their
    ; declared type is the MARKER and there is nothing to instantiate: the alias
    ; reference is answered here or not at all. Everything below the type-alias
    ; table is skipped for them.
    procedure get_type_alias_instantiation(this, symbol: ref[Symbol], type_arguments: ref[Array[ref[Type]?]]?, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t this.get_declared_type_of_symbol(symbol)
        if this.unported_mark() <> mark
            return null
        if t <> null
        {
            if (t as ref[Type]) = intrinsic_marker_type
            {
                var arg_count 0
                if type_arguments <> null
                    set arg_count: (type_arguments as ref[Array[ref[Type]?]]).get_length() as int
                if arg_count = 1
                {
                    let kind Checker.intrinsic_type_kind(Symbol.name_of(symbol))
                    if kind <> IntrinsicTypeKindUnknown
                    {
                        let args type_arguments as ref[Array[ref[Type]?]]
                        let first args[0]
                        if first = null
                            return null
                        if kind = IntrinsicTypeKindNoInfer
                            return this.get_no_infer_type(first as ref[Type])
                        return this.get_string_mapping_type(symbol, first as ref[Type])
                    }
                }
            }
        }
        let links this.type_alias_link_of(symbol)
        let type_parameters links.type_parameters
        if links.instantiations = null
        {
            let seeded &Array[ref[ObjectInstantiation]?]^host()
            set links.instantiations: seeded
        }
        let rows links.instantiations as ref[Array[ref[ObjectInstantiation]?]]
        let found this.find_instantiation_row(rows, type_arguments, alias)
        if found <> null
            return found
        if type_parameters = null
            return t
        let tps type_parameters as ref[Array[ref[Type]?]]
        let min_count this.get_min_type_argument_count(tps)
        var args type_arguments
        if args = null
            set args: this.new_type_list(null)
        let filled this.fill_missing_type_arguments(args as ref[Array[ref[Type]?]], tps, min_count, false)
        if this.unported_mark() <> mark
            return null
        let mapper this.new_type_mapper(tps, filled)
        let instantiation this.instantiate_type_with_alias(t, mapper as ref[TypeMapper]?, alias)
        if this.unported_mark() <> mark
            return null
        Checker.add_instantiation_row(rows, type_arguments, alias, instantiation)
        instantiation
    }

    ; The alias table's lookup and append. They are `find_object_instantiation` /
    ; `add_object_instantiation` over a list handed in rather than read off a
    ; TYPE, because a type alias link is not a type — the row shape is the same
    ; (see TypeAliasLink's header for why the third key field is unused).
    procedure find_instantiation_row(this, rows: ref[Array[ref[ObjectInstantiation]?]], args: ref[Array[ref[Type]?]]?, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        var asym: ref[Symbol]? null
        var aargs: ref[Array[ref[Type]?]]? null
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set asym: al.symbol
            set aargs: al.type_arguments
        }
        let n rows.get_length() as int
        let chained n >= ObjectRowChainMin
        var ch: ref[HashChain]? null
        var i 0
        if chained
        {
            set ch: this.object_row_chain(rows)
            set i: (ch as ref[HashChain]).first(Checker.type_list_hash(args))
        }
        while (i >= 0) and (i < n)
        {
            let row rows[i]
            if row <> null
            {
                let r row as ref[ObjectInstantiation]
                if r.alias_symbol = asym
                {
                    if Checker.type_lists_equal(r.arguments, args)
                    {
                        if Checker.type_lists_equal(r.alias_type_arguments, aargs)
                            return r.instantiated
                    }
                }
            }
            if chained
                set i: (ch as ref[HashChain]).after(i)
            else
                set i: i + 1
        }
        null
    }

    procedure add_instantiation_row(rows: ref[Array[ref[ObjectInstantiation]?]], args: ref[Array[ref[Type]?]]?, alias: ref[TypeAlias]?, t: ref[Type]?)
    {
        var asym: ref[Symbol]? null
        var aargs: ref[Array[ref[Type]?]]? null
        if alias <> null
        {
            let al alias as ref[TypeAlias]
            set asym: al.symbol
            set aargs: al.type_arguments
        }
        let rows_page Page.get(rows)
        let row &ObjectInstantiation^rows_page(Checker.type_list_hash(args), args, asym, aargs, false, t)
        rows.add(row)
    }

    ; getTypeFromClassOrInterfaceReference, whole.
    ;
    ; ★★★ `isJsImplicitAny` IS CONSTANTLY FALSE AND THAT REMOVES A REPORT RATHER
    ; THAN AN ARM: it is `!noImplicitAny && isJs`, noImplicitAny is TRUE here, so
    ; the arity check always runs and the JS-only *provide these with an extends
    ; tag* pair can never be chosen. Both message forks are written anyway, because
    ; the code they choose between is what a diagnostic IS in this port and the
    ; fork is one comparison. ★What the constant DOES remove is the reference's
    ; permissive `if !isJs { return errorType }`: with isJs false the early return
    ; is unconditional, and writing it as a conditional would be a branch whose
    ; other side no input can take.
    procedure get_type_from_class_or_interface_reference(this, node: ref[AstNode], symbol: ref[Symbol]) returns ref[Type]?
    {
        let merged this.get_merged_symbol(symbol)
        if merged = null
            return null
        ; ★★★ THE MARK, AND THE STAGE-2 ROW THAT FORCED IT IS THE THIRD FACE OF THIS
        ; SLICE'S SECOND FINDING. `get_declared_type_of_class_or_interface` answers a
        ; NON-NULL type when it stops: it stores the half-built type in the links
        ; BEFORE resolving the type parameters — deliberately, so a self-referencing
        ; constraint closes on it instead of running forever — and every one of its
        ; three guards then `return t`. So a stop there hands back a class type with
        ; NO type parameters, and reading that as complete makes `checkNoTypeArguments`
        ; report **TS2315 (*Type is not generic*) about a generic type**. Measured:
        ; one unit of 18 257 at stage 2 and none at stage 1
        ; (`circularTypeArgumentsLocalAndOuterNoCrash1`, where `interface
        ; NumArray<T extends number> extends Array<T>` stops on the globals table
        ; §3.11 names). ★★★**A callee that stops may still answer, and a non-null
        ; answer is not a complete one — only the mark says which.**
        let declared_mark this.unported_mark()
        let dt this.get_declared_type_of_class_or_interface(merged as ref[Symbol])
        if this.unported_mark() <> declared_mark
            return null
        if dt = null
            return null
        let t dt as ref[Type]
        let type_parameters this.local_type_parameters_of(t)
        var tp_count 0
        if type_parameters <> null
            set tp_count: (type_parameters as ref[Array[ref[Type]?]]).get_length() as int
        ; ★★★ THE HALF-BUILT DECLARED TYPE, AND IT IS THE ONE FACE OF THIS SLICE'S
        ; SECOND FINDING THAT NO MARK CAN REACH. `get_declared_type_of_class_or_
        ; interface` MEMOISES: it stores the type in the links before resolving the
        ; type parameters, and its three guards then `return t` — so a stop during
        ; the FIRST visit leaves a class type with no type parameters in the table,
        ; and every later visit gets it back with the mark unmoved. Reading that as
        ; complete makes checkNoTypeArguments report **TS2315 (*Type is not
        ; generic*) about a type whose declaration is generic** — one unit of
        ; 18 257 at stage 2 and none at stage 1
        ; (`circularTypeArgumentsLocalAndOuterNoCrash1`).
        ;
        ; ★★★ SO THE QUESTION IS ASKED OF THE DECLARATION AND NOT OF THE TYPE. The
        ; declaration's type-parameter list is a syntactic fact the binder already
        ; has and no stop can damage; when it disagrees with the built type, what
        ; this port knows is *nothing*, and that is a stop rather than a report.
        ; **A memo carries an incompleteness across the mark that would have
        ; reported it, and the only way out is a second source for the same fact.**
        if tp_count = 0
        {
            if Checker.symbol_declares_type_parameters(symbol)
            {
                this.record_unported("incomplete-declared-type", 0)
                return null
            }
        }
        if tp_count <> 0
        {
            var num_type_arguments 0
            let args AstNode.type_arguments_of(node)
            if args <> null
                set num_type_arguments: (args as ref[Array[ref[AstNode]?]]).get_length() as int
            let mark this.unported_mark()
            let min_count this.get_min_type_argument_count(type_parameters as ref[Array[ref[Type]?]])
            if this.unported_mark() <> mark
                return null
            let is_js Parser.is_in_js_file(node)
            ; ★★★ THE JAVASCRIPT FALL-THROUGH WAS MISSING, AND THE COMMENT THAT USED
            ; TO STAND AT report_type_argument_arity SAID SO WHILE CLAIMING IT COULD
            ; NOT MATTER: *"the JS half is behind the stop above for the one node
            ; kind that can reach it"*. The stop is `missingAugmentsTag`, which is
            ; ExpressionWithTypeArguments ONLY — a plain TypeReference in a JS file
            ; reports and then RUNS ON, and the reference fills the missing
            ; arguments with `any`. `/** @template T */ class C {}` with `/** @param
            ; {C} p */` is `C<any>` upstream and was `any` here. §3.5p from the
            ; inside: a reachability claim that names the wrong condition.
            ; ★`isJsImplicitAny` is NOT the difference — `noImplicitAny` is a strict
            ; -family option and answers TRUE here, so the report is made on both
            ; sides and only the RETURN differs.
            var out_of_range false
            if num_type_arguments < min_count
                set out_of_range: true
            if num_type_arguments > tp_count
                set out_of_range: true
            ; isJsImplicitAny: outside noImplicitAny a JS reference reports nothing
            if is_js and (Checker.no_implicit_any() = false)
                set out_of_range: false
            if out_of_range
            {
                let arity this.report_type_argument_arity(node, min_count, tp_count, is_js, this.type_arg_array_as_generic(t))
                if is_js = false
                    return arity
                if this.unported_mark() <> mark
                    return null
            }
            if AstNode.kind_of(node) = KindTypeReference
            {
                if this.is_deferred_type_reference_node(node, num_type_arguments <> tp_count)
                {
                    ; createDeferredTypeReference, with the reference's own two nils
                    ; for `mapper` and `alias`. WHOLE since slice 159.
                    ;
                    ; ★★★ THE NOTE NAMED TWO SLOTS THAT EXIST — §3.5eo, AND IT IS
                    ; THE SECOND TIME THIS SAME PRODUCER WAS DECLARED ABSENT. It
                    ; read *"the type's `node` and `mapper` slots, which
                    ; TypeData.Reference does not carry"*, and
                    ; `fill_deferred_reference_data` writes exactly those two;
                    ; `create_deferred_type_reference` sits six thousand lines
                    ; above, and its OWN header already records the first such
                    ; expiry — a note written at the instantiation call site while
                    ; the producer was in the file. A premise about a data slot ages
                    ; the same way a premise about a callee does, and the tags scan
                    ; finds neither.
                    return this.create_deferred_type_reference(t, node)
                }
                if this.unported_mark() <> mark
                    return null
            }
            let from_node this.get_type_arguments_from_node(node)
            if from_node = null
                return null
            let local this.fill_missing_type_arguments(from_node, type_parameters as ref[Array[ref[Type]?]], min_count, is_js)
            if local = null
                return null
            let outer this.outer_type_parameters_of(t)
            let all this.new_type_list(outer)
            let loc local as ref[Array[ref[Type]?]]
            let ln loc.get_length() as int
            var i 0
            while i < ln
            {
                all.add(loc[i])
                set i: i + 1
            }
            return this.create_type_reference(t, all, ObjectFlagsFromTypeNode)
        }
        if this.check_no_type_arguments(node, symbol)
            return t
        error_type
    }

    ; Does any declaration of this symbol carry a type-parameter list? The
    ; syntactic half of the question above, over the same five declaration kinds
    ; `append_local_type_parameters_of_class_or_interface_or_type_alias` walks —
    ; which is what makes the two answers comparable rather than merely adjacent.
    function symbol_declares_type_parameters(symbol: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                let k AstNode.kind_of(dn)
                var takes false
                if k = KindInterfaceDeclaration
                    set takes: true
                if k = KindClassDeclaration
                    set takes: true
                if k = KindClassExpression
                    set takes: true
                if k = KindTypeAliasDeclaration
                    set takes: true
                if k = KindJSTypeAliasDeclaration
                    set takes: true
                if takes
                {
                    let tps AstNode.type_parameters_of(dn)
                    if tps <> null
                    {
                        if (tps as ref[Array[ref[AstNode]?]]).get_length() <> 0
                            return true
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    ; The arity report, both message forks, written once because both callers of it
    ; differ only in which comparison brought them here.
    procedure report_type_argument_arity(this, node: ref[AstNode], min_count: int, tp_count: int, is_js: bool, type_name: String) returns ref[Type]?
    {
        let min_text Checker.arg_int(min_count)
        let count_text Checker.arg_int(tp_count)
        ; `missingAugmentsTag` is `isJs && IsExpressionWithTypeArguments(node) &&
        ; !IsJSDocAugmentsTag(node.Parent)`. The third conjunct is the JSDoc tag
        ; chapter; the first two are cheap, so the term is asked in the order that
        ; makes the stop the LAST thing tried.
        if is_js
        {
            if AstNode.kind_of(node) = KindExpressionWithTypeArguments
            {
                ; the third conjunct, `!IsJSDocAugmentsTag(node.Parent)` (slice 258)
                if Checker.kind_or_unknown(AstNode.parent_node_of(node)) <> KindJSDocAugmentsTag
                {
                    if min_count < tp_count
                        this.error_on_node(node, DiagExpected_0_1_type_arguments_provide_these_with_an_extends_tag, type_name, min_text, count_text)
                    else
                        this.error_on_node(node, DiagExpected_0_type_arguments_provide_these_with_an_extends_tag, type_name, min_text, count_text)
                    return error_type
                }
            }
        }
        if min_count < tp_count
            this.error_on_node(node, DiagGeneric_type_0_requires_between_1_and_2_type_arguments, type_name, min_text, count_text)
        else
            this.error_on_node(node, DiagGeneric_type_0_requires_1_type_argument_s, type_name, min_text, count_text)
        ; The reference returns errorType here for a TS file and FALLS THROUGH for a
        ; JS one. ★ Slice 113: the CALLER now makes that fork — the note that used to
        ; stand here said the JS half was covered by the stop above, and the stop is
        ; ExpressionWithTypeArguments only. This function is the REPORT; its answer
        ; is the TS file's.
        error_type
    }

    ; InterfaceType.OuterTypeParameters() — allTypeParameters up to
    ; outerTypeParameterCount. The third slicing accessor, and its reader is the
    ; type-argument list this chapter builds: a type reference supplies arguments
    ; for the LOCAL parameters only, and the outer ones are prepended unchanged.
    procedure outer_type_parameters_of(this, t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when d: Interface
            {
                if d.all_type_parameters = null
                    return null
                if d.outer_type_parameter_count = 0
                    return null
                let all d.all_type_parameters as ref[Array[ref[Type]?]]
                let out this.new_type_list(null)
                var i 0
                while i < d.outer_type_parameter_count
                {
                    out.add(all[i])
                    set i: i + 1
                }
                return out
            }
        null
    }

    ; getTypeArgumentsFromNode — `core.Map(node.TypeArguments(), getTypeFromTypeNode)`.
    procedure get_type_arguments_from_node(this, node: ref[AstNode]) returns ref[Array[ref[Type]?]]?
    {
        let out this.new_type_list(null)
        let args AstNode.type_arguments_of(node)
        if args = null
            return out
        let list args as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            set i: i + 1
            if e = null
                return null
            let t this.get_type_from_type_node(e as ref[AstNode])
            if t = null
                return null
            out.add(t)
        }
        out
    }

    ; checkNoTypeArguments, whole. ★The message's ARGUMENT is the type's name —
    ; symbolToString or DeclarationNameToString — and a diagnostic in this port is
    ; a code and a range, so neither is asked. The `symbol == nil` fork exists only
    ; to choose between them and is therefore not written twice.
    procedure check_no_type_arguments(this, node: ref[AstNode], symbol: ref[Symbol]?) returns bool
    {
        let args AstNode.type_arguments_of(node)
        if args = null
            return true
        if (args as ref[Array[ref[AstNode]?]]).get_length() = 0
            return true
        var type_name String("")
        if symbol <> null
            set type_name: this.symbol_arg(symbol)
        else
            set type_name: this.declaration_name_to_string(AstNode.type_reference_name_of(node))
        this.error_on_node(node, DiagType_0_is_not_generic, type_name)
        false
    }

    ; getMinTypeArgumentCount / hasTypeParameterDefault.
    function get_min_type_argument_count(this, type_parameters: ref[Array[ref[Type]?]]) returns int
    {
        var min_count 0
        let n type_parameters.get_length() as int
        var i 0
        while i < n
        {
            let tp type_parameters[i]
            if tp <> null
            {
                if Checker.has_type_parameter_default(tp as ref[Type]) = false
                    set min_count: i + 1
            }
            set i: i + 1
        }
        min_count
    }

    function has_type_parameter_default(t: ref[Type]) returns bool
    {
        let sym t.symbol
        if sym = null
            return false
        let s sym as ref[Symbol]
        let n Symbol.declaration_count(s)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(s, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                if AstNode.kind_of(dn) = KindTypeParameter
                {
                    if AstNode.type_parameter_default_of(dn) <> null
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; fillMissingTypeArguments, whole — the JS-implicit-any rewrite included since
    ; slice 202 (its stop named is_type_identical_to and empty_object_type as
    ; absent; both had writers by slice 131).
    procedure fill_missing_type_arguments(this, type_arguments: ref[Array[ref[Type]?]], type_parameters: ref[Array[ref[Type]?]], min_count: int, is_js: bool) returns ref[Array[ref[Type]?]]?
    {
        let num_parameters type_parameters.get_length() as int
        if num_parameters = 0
            return this.new_type_list(null)
        let num_arguments type_arguments.get_length() as int
        var fill false
        if is_js
            set fill: true
        if num_arguments < num_parameters
            set fill: true
        if fill = false
            return type_arguments
        let result this.new_type_list(null)
        var i 0
        while i < num_arguments
        {
            if i < num_parameters
                result.add(type_arguments[i])
            set i: i + 1
        }
        ; Map invalid forward references in default types to the error type.
        set i: num_arguments
        while i < num_parameters
        {
            result.add(error_type)
            set i: i + 1
        }
        var base_default unknown_type
        if is_js
            set base_default: any_type
        set i: num_arguments
        while i < num_parameters
        {
            let tp type_parameters[i]
            if tp = null
                return null
            let mark this.unported_mark()
            let dflt this.get_default_from_type_parameter(tp as ref[Type])
            if this.unported_mark() <> mark
                return null
            ; isJavaScriptImplicitAny && defaultType != nil && (isTypeIdenticalTo(
            ; defaultType, unknownType) || isTypeIdenticalTo(defaultType, emptyObjectType))
            ; — the JS default collapses to `any`. ★The stop that stood here named
            ; is_type_identical_to as absent; it has been defined since slice 101.
            var dflt2 dflt
            if is_js
            {
                if dflt <> null
                {
                    let d dflt as ref[Type]
                    var collapse this.is_type_identical_to(d, unknown_type)
                    if collapse = false
                    {
                        if empty_object_type <> null
                            set collapse: this.is_type_identical_to(d, empty_object_type as ref[Type])
                    }
                    if collapse
                        set dflt2: any_type
                }
            }
            if dflt2 = null
                result.put(i as size_t, base_default)
            else
            {
                let m this.new_type_mapper(type_parameters, result)
                let inst this.instantiate_type(dflt2, m)
                if inst = null
                    return null
                result.put(i as size_t, inst)
            }
            set i: i + 1
        }
        result
    }

    ; ── isDeferredTypeReferenceNode and its two helpers ─────────────────────
    ;
    ; ★★ THE PREDICATE DECIDES WHETHER A REFERENCE IS BUILT EAGERLY OR LAZILY, so
    ; getting it wrong in the FALSE direction builds a type the reference defers —
    ; a well-formed wrong answer — and in the TRUE direction it is a stop. It is
    ; therefore transcribed whole, including the arm the reference PANICS on.
    procedure is_deferred_type_reference_node(this, node: ref[AstNode], has_default_type_arguments: bool) returns bool
    {
        if this.get_alias_symbol_for_type_node(node) <> null
            return true
        if Checker.is_resolved_by_type_alias(node) = false
            return false
        let k AstNode.kind_of(node)
        if k = KindArrayType
        {
            let et Checker.array_element_type_node_of(node)
            if et = null
                return false
            return this.may_resolve_type_alias(et as ref[AstNode])
        }
        if k = KindTupleType
        {
            let elements AstNode.type_list_of(node)
            if elements = null
                return false
            let list elements as ref[Array[ref[AstNode]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                set i: i + 1
                if e <> null
                {
                    if this.may_resolve_type_alias(e as ref[AstNode])
                        return true
                }
            }
            return false
        }
        if k = KindTypeReference
        {
            if has_default_type_arguments
                return true
            let args AstNode.type_arguments_of(node)
            if args = null
                return false
            let list args as ref[Array[ref[AstNode]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                set i: i + 1
                if e <> null
                {
                    if this.may_resolve_type_alias(e as ref[AstNode])
                        return true
                }
            }
            return false
        }
        ; "Unhandled case in isDeferredTypeReferenceNode" — the reference panics.
        this.record_unported("is-deferred-type-reference-node", k)
        false
    }

    ; isResolvedByTypeAlias, whole — the walk up through the type constructs that
    ; eagerly resolve their constituents.
    function is_resolved_by_type_alias(node: ref[AstNode]) returns bool
    {
        var n: ref[AstNode]? node
        while n <> null
        {
            let p AstNode.parent_node_of(n as ref[AstNode])
            if p = null
                return false
            let parent p as ref[AstNode]
            let k AstNode.kind_of(parent)
            if k = KindTypeAliasDeclaration
                return true
            if k = KindJSTypeAliasDeclaration
                return true
            var climbs false
            if k = KindParenthesizedType
                set climbs: true
            if k = KindNamedTupleMember
                set climbs: true
            if k = KindTypeReference
                set climbs: true
            if k = KindUnionType
                set climbs: true
            if k = KindIntersectionType
                set climbs: true
            if k = KindIndexedAccessType
                set climbs: true
            if k = KindConditionalType
                set climbs: true
            if k = KindTypeOperator
                set climbs: true
            if k = KindArrayType
                set climbs: true
            if k = KindTupleType
                set climbs: true
            if climbs = false
                return false
            set n: parent
        }
        false
    }

    ; mayResolveTypeAlias, whole.
    ;
    ; ★★★ ITS FIRST ARM CALLS resolveTypeReferenceName AND THAT IS THE REFERENCE'S
    ; OWN SHAPE, not a convenience — the question *does resolving this node
    ; possibly resolve a type alias* is answered by resolving the NAME. So a miss
    ; inside it stops here too, which is why the caller takes a mark.
    procedure may_resolve_type_alias(this, node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindTypeReference
        {
            let sym this.resolve_type_reference_name(node, SymbolFlagsType, false)
            if sym = null
                return false
            return (Symbol.flags_of(sym as ref[Symbol]) & SymbolFlagsTypeAlias) <> 0
        }
        if k = KindTypeQuery
            return true
        if k = KindTypeOperator
        {
            if AstNode.type_operator_operator_of(node) = KindUniqueKeyword
                return false
            let t AstNode.type_of(node)
            if t = null
                return false
            return this.may_resolve_type_alias(t as ref[AstNode])
        }
        if k = KindParenthesizedType
            return this.may_resolve_type_alias_of_type_slot(node)
        if k = KindOptionalType
            return this.may_resolve_type_alias_of_type_slot(node)
        if k = KindNamedTupleMember
            return this.may_resolve_type_alias_of_type_slot(node)
        if k = KindRestType
        {
            let t AstNode.type_of(node)
            if t = null
                return false
            let inner t as ref[AstNode]
            if AstNode.kind_of(inner) <> KindArrayType
                return true
            let et Checker.array_element_type_node_of(inner)
            if et = null
                return false
            return this.may_resolve_type_alias(et as ref[AstNode])
        }
        if k = KindUnionType
            return this.may_resolve_type_alias_of_list(AstNode.type_list_of(node))
        if k = KindIntersectionType
            return this.may_resolve_type_alias_of_list(AstNode.type_list_of(node))
        if k = KindIndexedAccessType
        {
            let ot AstNode.indexed_access_object_type_of(node)
            if ot <> null
            {
                if this.may_resolve_type_alias(ot as ref[AstNode])
                    return true
            }
            let it AstNode.indexed_access_index_type_of(node)
            if it = null
                return false
            return this.may_resolve_type_alias(it as ref[AstNode])
        }
        if k = KindConditionalType
        {
            let ct AstNode.conditional_check_type_of(node)
            if ct <> null
            {
                if this.may_resolve_type_alias(ct as ref[AstNode])
                    return true
            }
            let et AstNode.conditional_extends_type_of(node)
            if et <> null
            {
                if this.may_resolve_type_alias(et as ref[AstNode])
                    return true
            }
            let tt AstNode.conditional_true_type_of(node)
            if tt <> null
            {
                if this.may_resolve_type_alias(tt as ref[AstNode])
                    return true
            }
            let ft AstNode.conditional_false_type_of(node)
            if ft = null
                return false
            return this.may_resolve_type_alias(ft as ref[AstNode])
        }
        false
    }

    procedure may_resolve_type_alias_of_type_slot(this, node: ref[AstNode]) returns bool
    {
        let t AstNode.type_of(node)
        if t = null
            return false
        this.may_resolve_type_alias(t as ref[AstNode])
    }

    procedure may_resolve_type_alias_of_list(this, list: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if list = null
            return false
        let l list as ref[Array[ref[AstNode]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            let e l[i]
            set i: i + 1
            if e <> null
            {
                if this.may_resolve_type_alias(e as ref[AstNode])
                    return true
            }
        }
        false
    }

    ; getConditionalFlowTypeOfType — the substitution walk from a type NODE up to
    ; its enclosing statement.
    ;
    ; ★★★ ITS ONLY EFFECT IS THE CONSTRAINT LIST, so the walk is transcribed and
    ; the two places that would APPEND report instead. That is what makes the port
    ; exact rather than conservative: ending the walk early (or late) changes which
    ; ancestors are examined, and a report at the append is the one point where the
    ; reference's answer stops being `t`.
    ;
    ; ★ `covariant` flips on a PARAMETER parent and is read only by the first arm,
    ; whose guard is `covariant || t is a type variable`. No type this slice makes
    ; is a type variable, so the flag is what decides — and it is transcribed
    ; rather than folded away, because an annotation reached through one parameter
    ; list is one flip.
    procedure get_conditional_flow_type_of_type(this, t: ref[Type], node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        var constraints: ref[Array[ref[Type]?]]? null
        var n: ref[AstNode]? node
        var covariant true
        while n <> null
        {
            let cur n as ref[AstNode]
            if Checker.is_statement(cur)
                break
            if AstNode.kind_of(cur) = KindJSDoc
                break
            let p AstNode.parent_node_of(cur)
            if p = null
                break
            let parent p as ref[AstNode]
            let pk AstNode.kind_of(parent)
            if pk = KindParameter
            {
                if covariant
                    set covariant: false
                else
                    set covariant: true
            }
            var conditional_true false
            if pk = KindConditionalType
            {
                if AstNode.conditional_true_type_of(parent) = cur
                    set conditional_true: true
            }
            var substitutes false
            if conditional_true
            {
                ; "Always substitute on type parameters, regardless of variance,
                ; since even in contravariant positions they may rely on
                ; substituted constraints to be valid"
                if covariant
                    set substitutes: true
                if (t.flags & TypeFlagsTypeVariable) <> 0
                    set substitutes: true
            }
            if substitutes
            {
                ; ★★★ SLICE 136 — THE FIRST APPEND. The stop that stood here
                ; (`get-implied-constraint`) was the largest row of the whole
                ; frontier by EVENTS at stage 1, and what it was waiting for was a
                ; producer for the substitution type rather than a chapter of its
                ; own: getImpliedConstraint is eight lines.
                let implied this.get_implied_constraint(t, AstNode.conditional_type_check_of(parent), AstNode.conditional_type_extends_of(parent))
                if this.unported_mark() <> mark
                    return null
                if implied <> null
                {
                    if constraints = null
                        set constraints: this.new_type_list(null) as ref[Array[ref[Type]?]]?
                    (constraints as ref[Array[ref[Type]?]]).add(implied)
                }
            }
            else
            {
                if (t.flags & TypeFlagsTypeParameter) <> 0
                {
                    if pk = KindMappedType
                    {
                        ; ★★★ THE SECOND APPEND, AND IT IS `${number}`. The arm has
                        ; been transcribed since slice 125 with only the append
                        ; reporting; what it appends is the union of `number` and
                        ; numericStringType, which is why that intrinsic is minted in
                        ; this slice — a homomorphic mapped type over an array or
                        ; tuple constrains its key to the two spellings of an index.
                        if AstNode.mapped_type_name_type_of(parent) = null
                        {
                            if AstNode.type_of(parent) = cur
                            {
                                let mapped_type this.get_type_from_type_node(parent)
                                if this.unported_mark() <> mark
                                    return null
                                if mapped_type <> null
                                {
                                    let mt mapped_type as ref[Type]
                                    let tpm this.get_type_parameter_from_mapped_type(mt)
                                    if this.unported_mark() <> mark
                                        return null
                                    let av this.get_actual_type_variable(t)
                                    if this.unported_mark() <> mark
                                        return null
                                    if tpm = av
                                    {
                                        let tv this.get_homomorphic_type_variable(mt)
                                        if this.unported_mark() <> mark
                                            return null
                                        if tv <> null
                                        {
                                            if this.has_array_or_tuple_type_constraint(tv)
                                            {
                                                if numeric_string_type = null
                                                    return null
                                                let index_union this.get_union_type_pair(number_type, numeric_string_type as ref[Type])
                                                if this.unported_mark() <> mark
                                                    return null
                                                if index_union <> null
                                                {
                                                    if constraints = null
                                                        set constraints: this.new_type_list(null) as ref[Array[ref[Type]?]]?
                                                    (constraints as ref[Array[ref[Type]?]]).add(index_union)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            set n: parent
        }
        if constraints = null
            return t
        let list constraints as ref[Array[ref[Type]?]]
        if (list.get_length() as int) = 0
            return t
        let inter this.get_intersection_type(list)
        if this.unported_mark() <> mark
            return null
        if inter = null
            return null
        this.get_substitution_type(t, inter as ref[Type])
    }

    ; getImpliedConstraint and isUnaryTupleTypeNode (slice 136).
    ;
    ; ★★★ IT IS A TWO-ARM SWITCH AND THE FIRST ARM IS A RECURSION THROUGH A
    ; ONE-ELEMENT TUPLE ON BOTH SIDES. `[T] extends [U] ? …` is how a conditional
    ; is written when the author wants to defeat DISTRIBUTION, and the reference
    ; unwraps both wrappers rather than treating the tuple as the checked type —
    ; so the implied constraint of `T` inside such a conditional is `U`, exactly as
    ; it is in the unwrapped spelling.
    ;
    ; ★ The second arm compares through get_actual_type_variable on BOTH sides,
    ; which is what lets an already-substituted `T` still match its own check node.
    procedure get_implied_constraint(this, t: ref[Type], check_node: ref[AstNode]?, extends_node: ref[AstNode]?) returns ref[Type]?
    {
        if check_node = null
            return null
        if extends_node = null
            return null
        let cn check_node as ref[AstNode]
        let en extends_node as ref[AstNode]
        if Checker.is_unary_tuple_type_node(cn)
        {
            if Checker.is_unary_tuple_type_node(en)
                return this.get_implied_constraint(t, AstNode.child_in_list(AstNode.elements_of(cn), 0), AstNode.child_in_list(AstNode.elements_of(en), 0))
        }
        let mark this.unported_mark()
        let checked this.get_type_from_type_node(cn)
        if this.unported_mark() <> mark
            return null
        if checked = null
            return null
        let actual_checked this.get_actual_type_variable(checked as ref[Type])
        if this.unported_mark() <> mark
            return null
        let actual_t this.get_actual_type_variable(t)
        if this.unported_mark() <> mark
            return null
        if actual_checked <> actual_t
            return null
        this.get_type_from_type_node(en)
    }

    function is_unary_tuple_type_node(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindTupleType
            return false
        AstNode.list_count(AstNode.elements_of(node)) = 1
    }

    ; ── the predicates this chapter needed ───────────────────────────────────

    ; ast.IsCatchClauseVariableDeclarationOrBindingElement.
    function is_catch_clause_variable_declaration_or_binding_element(declaration: ref[AstNode]) returns bool
    {
        let root Binder.get_root_declaration(declaration)
        if root = null
            return false
        let n root as ref[AstNode]
        if AstNode.kind_of(n) <> KindVariableDeclaration
            return false
        Checker.kind_or_unknown(AstNode.parent_node_of(n)) = KindCatchClause
    }

    ; isEmptyArrayLiteral.
    ; isEmptyArrayAssignment — the two shapes that start an evolving array:
    ; `var x = []` and `x = []`. ★The second disjunct excludes a BINDING ELEMENT,
    ; which is the reference's own guard: `let [x] = []` assigns the ELEMENT, not
    ; the array.
    function is_empty_array_assignment(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) = KindVariableDeclaration
        {
            ; ★`init` is a reserved word (root CLAUDE.md) — the parse error it
            ; gives is `expected Binding` at the NAME, which reads like a syntax
            ; slip in the expression.
            let initializer AstNode.initializer_of(node)
            if initializer <> null
            {
                if Checker.is_empty_array_literal(initializer as ref[AstNode])
                    return true
            }
        }
        if AstNode.kind_of(node) = KindBindingElement
            return false
        let parent AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(parent) <> KindBinaryExpression
            return false
        let right AstNode.binary_right_of(parent)
        if right = null
            return false
        Checker.is_empty_array_literal(right as ref[AstNode])
    }

    function is_empty_array_literal(expression: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(expression) <> KindArrayLiteralExpression
            return false
        let elements AstNode.elements_of(expression)
        if elements = null
            return true
        AstNode.list_count(elements) = 0
    }

    ; declarationBelongsToPrivateAmbientMember, and isPrivateWithinAmbient with it.
    ; A method rather than a static because the modifier flags live on the binder.
    function declaration_belongs_to_private_ambient_member(this, declaration: ref[AstNode]) returns bool
    {
        let root Binder.get_root_declaration(declaration)
        if root = null
            return false
        var member root as ref[AstNode]
        if AstNode.kind_of(member) = KindParameter
        {
            let p AstNode.parent_node_of(member)
            if p = null
                return false
            set member: p as ref[AstNode]
        }
        var private_name false
        if b.has_syntactic_modifier(member, ModifierFlagsPrivate)
            set private_name: true
        if AstNode.is_private_identifier_class_element_declaration(member)
            set private_name: true
        if private_name = false
            return false
        (AstNode.flags_of(member) & NodeFlagsAmbient) <> 0
    }

    ; isNullOrUndefined, whole.
    ;
    ; ★★★ SLICE 131: THE IDENTIFIER ARM IS ONE LINE AND THE ROW IN FRONT OF IT WAS
    ; THE FOURTH EXPIRED CLAIM OF THIS SLICE. What stood here read *a name
    ; resolution this port does not have* — written before get_resolved_symbol
    ; existed, and get_resolved_symbol is the function the arm needs and has been
    ; in this file for dozens of slices. 239 units of stage 2 were arriving at the
    ; row, 106 of them with nothing else left. **The row named a capability, and
    ; nothing re-asked whether the capability had arrived.**
    procedure is_null_or_undefined(this, node: ref[AstNode]) returns bool
    {
        let expr Checker.skip_parentheses(node)
        let k AstNode.kind_of(expr)
        if k = KindNullKeyword
            return true
        if k = KindIdentifier
            return this.get_resolved_symbol(expr) = undefined_symbol
        false
    }

    ; ast.SkipParentheses, without the JSDoc-type-assertion exemption: that arm
    ; asks IsJSDocTypeAssertion, whose answer only ever KEEPS more parentheses. It
    ; is named rather than written because its one reader here is the test above,
    ; which reports on the very shape it would preserve.
    function skip_parentheses(node: ref[AstNode]) returns ref[AstNode]
    {
        var n node
        while AstNode.kind_of(n) = KindParenthesizedExpression
        {
            let e AstNode.expression_of(n)
            if e = null
                return n
            set n: e as ref[AstNode]
        }
        n
    }

    ; ast.IsStatement — the two kind lists plus the Block test, transcribed. It is
    ; the TERMINATOR of getConditionalFlowTypeOfType's walk and therefore decides
    ; which ancestors that walk examines at all.
    function is_statement(node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if Checker.is_statement_kind_but_not_declaration_kind(k)
            return true
        if Checker.is_declaration_statement_kind(k)
            return true
        Checker.is_block_statement(node)
    }

    function is_statement_kind_but_not_declaration_kind(k: int) returns bool
    {
        if k = KindBreakStatement
            return true
        if k = KindContinueStatement
            return true
        if k = KindDebuggerStatement
            return true
        if k = KindDoStatement
            return true
        if k = KindExpressionStatement
            return true
        if k = KindEmptyStatement
            return true
        if k = KindForInStatement
            return true
        if k = KindForOfStatement
            return true
        if k = KindForStatement
            return true
        if k = KindIfStatement
            return true
        if k = KindLabeledStatement
            return true
        if k = KindReturnStatement
            return true
        if k = KindSwitchStatement
            return true
        if k = KindThrowStatement
            return true
        if k = KindTryStatement
            return true
        if k = KindVariableStatement
            return true
        if k = KindWhileStatement
            return true
        if k = KindWithStatement
            return true
        k = KindNotEmittedStatement
    }

    function is_declaration_statement_kind(k: int) returns bool
    {
        if k = KindFunctionDeclaration
            return true
        if k = KindMissingDeclaration
            return true
        if k = KindClassDeclaration
            return true
        if k = KindInterfaceDeclaration
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        if k = KindEnumDeclaration
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindImportDeclaration
            return true
        if k = KindJSImportDeclaration
            return true
        if k = KindImportEqualsDeclaration
            return true
        if k = KindExportDeclaration
            return true
        if k = KindExportAssignment
            return true
        k = KindNamespaceExportDeclaration
    }

    ; isBlockStatement — a Block that is neither a try or catch body nor the
    ; Block-like body of a function. Its two parent tests are why IsStatement is
    ; asked of the NODE rather than of the kind.
    function is_block_statement(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindBlock
            return false
        let pk Checker.kind_or_unknown(AstNode.parent_node_of(node))
        if pk = KindTryStatement
            return false
        if pk = KindCatchClause
            return false
        Checker.is_function_block(node) = false
    }

    function is_function_block(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindBlock
            return false
        AstNode.is_function_like(AstNode.parent_node_of(node))
    }

    ; ast.IsCheckJSEnabledForFile. ★★★ ITS FIRST TERM IS THE FIELD THE PARSER USED
    ; TO DROP, and the note it dropped it under named this function as the reader
    ; (parser.scaly, extract_pragmas). checkJs is unset under this harness, so the
    ; second term is false and the whole answer is the directive: a JavaScript file
    ; without `// @ts-check` gets no implicit-any diagnostic at all.
    function is_check_js_enabled_for_file(this) returns bool
    {
        let d AstNode.check_js_directive_of(file)
        if d <> CheckJsDirectiveNone
            return d = CheckJsDirectiveEnabled
        Checker.check_js()
    }

    ; reportImplicitAny, whole but for the two things no instrument compares.
    ;
    ; ★★★ THE MESSAGE ARGUMENTS ARE NOT BUILT, and here that saves a CALL rather
    ; than a paragraph: `typeAsString := c.TypeToString(c.getWidenedType(t))` runs
    ; BEFORE the switch upstream, and the dump's C line is `C pos end code`. Slice
    ; 68 wrote the rule down; this is the first place it changes what the code does.
    ; The `t` parameter is kept because it is the reference's signature and because
    ; the slice that gives this port a message renderer needs it back.
    ;
    ; ★★ noImplicitAny IS TRUE UNDER THIS HARNESS, so every `errorOrSuggestion(c.
    ; noImplicitAny, …)` here is an ERROR and the five SUGGESTION codes (7043,
    ; 7044, 7045, 7047, 7050) are dead. They are named rather than written: this
    ; port has no suggestion list, and the reference routes a suggestion to one
    ; GetDiagnosticsForFile does not return — so writing them would be inventing a
    ; line no instrument could ever see, which is the single failure diagcheck's
    ; subsequence relation exists to catch.
    ;
    ; ★ THE TS7051 BRANCH fires for a parameter of a call signature, a method
    ; signature or a function type whose name reads as a TYPE, and the second
    ; disjunct of that test is resolveName. The FIRST disjunct is decidable without
    ; it (the name is a type keyword) and is still not asked on its own, because a
    ; report has to stand where EITHER disjunct can send the reference and a `||`
    ; cannot be half-evaluated into a different answer.
    ;
    ; ★★★ IT WAS A STOP UNTIL THIS SLICE, UNDER A PREMISE THAT DIED TWO SLICES
    ; AFTER IT WAS WRITTEN. The note read *slice 79's resolver does not unblock it
    ; … this port's resolveName answers a SUBSET of the reference's — it has no
    ; globals table*, and named the exact shape it was waiting for:
    ; `interface I { (Array): void }`, a parameter whose name is a lib TYPE. Slice
    ; 104 built the globals table and slice 113 loaded `lib.es5.d.ts` onto it, so
    ; the subset argument stopped holding — and nothing re-reads a premise (§3.5eo).
    ; The row sat at the head of `frontier.sh` at +65 units for the rest of the port.
    ;
    ; ★★ THE DIRECTION THE OLD NOTE FEARED IS THE ONE THAT STILL DECIDES THE ARM:
    ; a false disjunct does not lose TS7051, it falls through to a DIFFERENT report
    ; (7006 or 7019), so an incomplete resolver INVENTS a line rather than dropping
    ; one — the single direction diagcheck can see. That is why the resolver's own
    ; stop is taken as a stop HERE (the mark around the call) instead of being read
    ; as *not found*.
    procedure report_implicit_any(this, declaration: ref[AstNode], t: ref[Type], widening_kind: int)
    {
        if Parser.is_in_js_file(declaration)
        {
            ; "Only report implicit any errors/suggestions in TS and ts-check JS
            ; files"
            if this.is_check_js_enabled_for_file() = false
                return
        }
        ; `typeAsString := c.TypeToString(c.getWidenedType(t))` — computed here
        ; upstream, before the switch, whether or not an arm reports.
        let type_as_string this.type_arg(this.get_widened_type(t))
        let dk AstNode.kind_of(declaration)
        var code 0
        if dk = KindBinaryExpression
            set code: DiagMember_0_implicitly_has_an_1_type
        if dk = KindPropertyDeclaration
            set code: DiagMember_0_implicitly_has_an_1_type
        if dk = KindPropertySignature
            set code: DiagMember_0_implicitly_has_an_1_type
        if dk = KindParameter
        {
            if Checker.kind_or_unknown(AstNode.name_of(declaration)) = KindIdentifier
            {
                let parent AstNode.parent_node_of(declaration)
                let pk Checker.kind_or_unknown(parent)
                var signature_like false
                if pk = KindCallSignature
                    set signature_like: true
                if pk = KindMethodSignature
                    set signature_like: true
                if pk = KindFunctionType
                    set signature_like: true
                if signature_like
                {
                    if Checker.parameter_index_of(parent as ref[AstNode], declaration) >= 0
                    {
                        let pname AstNode.name_of(declaration) as ref[AstNode]
                        ; scanner.IdentifierToKeywordKind — the reference's
                        ; textToKeyword map, which answers KindUnknown for a name
                        ; that is no keyword where get_identifier_token answers
                        ; KindIdentifier. Neither is a type-node kind (79 and 0
                        ; against the range 183..206 and the eighteen named arms),
                        ; so the two sentinels are the same answer here.
                        var type_named AstNode.is_type_node_kind(get_identifier_token(AstNode.identifier_text_of(pname)))
                        if type_named = false
                        {
                            let rn_mark this.unported_mark()
                            let rn this.resolve_name(declaration, AstNode.identifier_text_of(pname), SymbolFlagsType, 0, true, false)
                            if this.unported_mark() <> rn_mark
                            {
                                this.record_unported("resolve-name", KindParameter)
                                return
                            }
                            if rn <> null
                                set type_named: true
                        }
                        if type_named
                        {
                            var new_name StringBuilder()
                            new_name.append("arg")
                            new_name.append(Checker.parameter_index_of(parent as ref[AstNode], declaration))
                            var type_name StringBuilder()
                            type_name.append(this.declaration_name_to_string(pname))
                            if AstNode.dot_dot_dot_token_of(declaration) <> null
                                type_name.append("[]")
                            if Checker.no_implicit_any()
                                this.error_on_node(declaration, DiagParameter_has_a_name_but_no_type_Did_you_mean_0_Colon_1, new_name.to_string(), type_name.to_string())
                            return
                        }
                    }
                }
            }
            ; every report below is an error only under noImplicitAny — without it
            ; each arm is a suggestion (errorOrSuggestion, the `…better type may be
            ; inferred from usage` messages) or nothing (slice 263)
            if Checker.no_implicit_any() = false
                return
            if AstNode.dot_dot_dot_token_of(declaration) <> null
                set code: DiagRest_parameter_0_implicitly_has_an_any_type
            else
                set code: DiagParameter_0_implicitly_has_an_1_type
        }
        if Checker.no_implicit_any() = false
            return
        if dk = KindBindingElement
            set code: DiagBinding_element_0_implicitly_has_an_1_type
        if Checker.kind_is_function_like_implicit_any(dk)
        {
            if AstNode.name_of(declaration) = null
            {
                if widening_kind = WideningKindGeneratorYield
                    this.error_on_node(declaration, DiagGenerator_implicitly_has_yield_type_0_Consider_supplying_a_return_type_annotation, type_as_string)
                else
                    this.error_on_node(declaration, DiagFunction_expression_which_lacks_return_type_annotation_implicitly_has_an_0_return_type, type_as_string)
                return
            }
            if (AstNode.flags_of(declaration) & NodeFlagsReparsed) <> 0
            {
                this.error_on_node(declaration, DiagThis_overload_implicitly_returns_the_type_0_because_it_lacks_a_return_type_annotation, type_as_string)
                return
            }
            if widening_kind = WideningKindGeneratorYield
                set code: DiagX_0_which_lacks_return_type_annotation_implicitly_has_an_1_yield_type
            else
                set code: DiagX_0_which_lacks_return_type_annotation_implicitly_has_an_1_return_type
        }
        if dk = KindMappedType
        {
            this.error_on_node(declaration, DiagMapped_object_type_implicitly_has_an_any_template_type)
            return
        }
        ; The switch's DEFAULT arm, and it is reached by every kind none of the
        ; labels above named — which is why the variable starts at 0 rather than at
        ; the default code: a kind that IS named and left the code at 0 would be a
        ; missing arm, and this way there is no such shape.
        if code = 0
            set code: DiagVariable_0_implicitly_has_an_1_type
        this.error_on_node(declaration, code, this.declaration_name_to_string(b.get_name_of_declaration(declaration)), type_as_string)
    }

    ; The reference's fifth switch label, as a predicate: the seven function-like
    ; kinds whose implicit `any` is a RETURN type rather than a value type.
    function kind_is_function_like_implicit_any(k: int) returns bool
    {
        if k = KindFunctionDeclaration
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindFunctionExpression
            return true
        k = KindArrowFunction
    }

    ; ── the base constructor type ───────────────────────────────────────────

    ; getBaseTypeVariableOfClass. It answers NULL for the ordinary class, and the
    ; caller tells that apart from a REPORT by comparing is_unported() — this
    ; file's idiom everywhere a legitimate nil and a stop share a return type.
    procedure get_base_type_variable_of_class(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let before this.unported_mark()
        let declared this.get_declared_type_of_class_or_interface(symbol)
        if this.unported_mark() <> before
            return null
        if declared = null
            return null
        let base this.get_base_constructor_type_of_class(declared as ref[Type])
        if this.unported_mark() <> before
            return null
        if base = null
            return null
        let bt base as ref[Type]
        if (bt.flags & TypeFlagsTypeVariable) <> 0
            return bt
        ; `core.Find(baseConstructorType.Types(), t => t.flags&TypeVariable != 0)`.
        ; ★★★ THE NOTE THAT STOOD HERE NAMED NO CALLEE AT ALL and the arm is the
        ; reference's four lines over a constituent list this file has read since
        ; the intersection chapter — it was the frontier's largest row at both
        ; granularities (+29 of 30 arrivals) for want of them. The mixin's static
        ; type is what the two callers want: a class whose base is an INTERSECTION
        ; containing a type variable is a mixin just as one whose base IS the
        ; variable is.
        ;
        ; ★★★ THE WALL WAS HIDING A LOSS THAT IS NOT IN THIS FUNCTION, AND THE
        ; LOSS IS NAMED RATHER THAN LEFT FOR THE NEXT READER. `class C extends
        ; mix(A, B)` — a mixin call returning `T & U` — reaches
        ; checkClassLikeDeclaration's STATIC SIDE check the moment this stop is
        ; gone, and that check answers ASSIGNABLE where the reference reports
        ; TS2417. Thirteen lines reproduce it (the corpus unit is
        ; `declarationEmitForMixinsWithStaticAccessors1`), and three measurements
        ; localise it away from the relation's route and onto the type
        ; `getTypeWithoutSignatures` MINTS:
        ;
        ;   typeof C  <=  staticBaseType (`typeof A & typeof B`)   FALSE, correct
        ;   typeof C  <=  getTypeWithoutSignatures(staticBaseType) TRUE,  wrong
        ;   typeof C  <=  each stripped constituent, `{prototype: A}`
        ;                 and `{prototype: B}` separately           TRUE,  wrong
        ;
        ; while `typeof C <= typeof B` asked from an ORDINARY expression in the
        ; same file answers FALSE on both sides, and `C <= A & B` — the prototype
        ; property's own question — answers FALSE here too. So the stripped
        ; constituent carries the right property (`prototype: B`, measured) and is
        ; still satisfied by a source whose prototype is not related to it: what
        ; get_type_without_signatures builds is not equivalent to what it copied
        ; from. The relation state at the call is clean (maybe stack empty, no
        ; cached row, no maybe hit, no overflow), which is what rules the route
        ; out. **It is a LOSS and not an invention**, so diagcheck stays green and
        ; the arm is worth its 29 units; the defect belongs to
        ; get_type_without_signatures and is a row of its own when someone takes
        ; it.
        if (bt.flags & TypeFlagsIntersection) <> 0
        {
            let ts Checker.intersection_types_of(bt)
            if ts = null
                return null
            let list ts as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                if e <> null
                {
                    let s e as ref[Type]
                    if (s.flags & TypeFlagsTypeVariable) <> 0
                        return s
                }
                set i: i + 1
            }
            return null
        }
        null
    }

    ; getBaseConstructorTypeOfClass.
    ;
    ; ★★★ THE NO-BASE EARLY RETURN IS 97.5 % OF THE CORPUS'S CLASSES and it is
    ; three lines: a class with no `extends` answers undefinedType and memoises
    ; it. Everything below that line — the resolution push, checkExpression on
    ; the base clause, resolveStructuredTypeMembers, the TS2507 report and its
    ; type-parameter related-info — is behind ONE call this port cannot make yet.
    procedure get_base_constructor_type_of_class(this, t: ref[Type]) returns ref[Type]?
    {
        let cached Checker.resolved_base_constructor_type_of(t)
        if cached <> null
            return cached
        let base_type_node Checker.get_base_type_node_of_class(t)
        if base_type_node = null
        {
            Checker.set_resolved_base_constructor_type(t, undefined_type)
            return undefined_type
        }
        if this.push_type_resolution(null, t, null, null, TypeSystemPropertyNameResolvedBaseConstructorType) = false
            return error_type
        ; ★★ THE POP IS OURS RATHER THAN THE REFERENCE'S, and it is here because
        ; record_unported is first-wins but the WALK CONTINUES: an entry left on
        ; the stack by a reporting arm would sit under every later declaration's
        ; cycle search in the same file and could turn a later push into a
        ; spurious cycle. A report is an exit the reference does not have, so the
        ; unwinding it needs is ours to write.
        ; ★★★ SLICE 70 TURNS THIS STOP INTO A CALL, and one shape of it now runs
        ; to the reference's next question: `class C extends null {}`. The null
        ; keyword answers nullWideningType, and the reference's TS2507 guard reads
        ; `baseConstructorType != c.nullWideningType` — so `extends null` is
        ; deliberately NOT a *not a constructor function type* error, which is a
        ; sentence this port could not even ask before the dispatch existed.
        let base_expr AstNode.expression_of(base_type_node)
        if base_expr = null
        {
            ; The reference dereferences `baseTypeNode.Expression()` unconditionally;
            ; an ExpressionWithTypeArguments always has one, so this row is a claim
            ; rather than a hole — it is here for the reason the JsxOpeningElement
            ; arm reports instead of trapping.
            this.pop_type_resolution()
            this.record_unported("base-type-node-without-expression", KindExpressionWithTypeArguments)
            return null
        }
        ; ★★★ NO RE-ENTRY GATE (slice 223): upstream has none. A NESTED ask for the
        ; same class while its base expression is being checked is either a cycle
        ; (pushTypeResolution answers false, errorType) or — under a pinned
        ; resolutionStart, the variance measurement's — a second full evaluation
        ; whose memo the outer call then reads. The bit slice 104 put here (against
        ; doubled diagnostics when the body STOPS, a unit that is unported either
        ; way) reported that second evaluation as a re-entry and lost
        ; `mixinWithBaseDependingOnSelfNoCrash1`.
        let mark this.unported_mark()
        let base_ctor this.check_expression(base_expr as ref[AstNode])
        if base_ctor <> null
        {
            let checked base_ctor as ref[Type]
            if (checked.flags & (TypeFlagsObject | TypeFlagsIntersection)) <> 0
            {
                ; "Resolving the members of a class requires us to resolve the base
                ; class of that class. We force resolution here such that we catch
                ; circularities now." — the RESULT is deliberately dropped.
                let forced this.resolve_structured_type_members(checked)
            }
        }
        if this.pop_type_resolution() = false
        {
            var vd: ref[AstNode]? null
            if t.symbol <> null
                set vd: Symbol.value_declaration_of(t.symbol as ref[Symbol])
            this.error_on_node(vd, DiagX_0_is_referenced_directly_or_indirectly_in_its_own_base_expression, this.symbol_arg(t.symbol))
            if Checker.resolved_base_constructor_type_of(t) = null
                Checker.set_resolved_base_constructor_type(t, error_type)
            return Checker.resolved_base_constructor_type_of(t)
        }
        if this.unported_mark() <> mark
            return null
        if base_ctor = null
            return null
        let bt base_ctor as ref[Type]
        ; `flags&Any == 0 && != nullWideningType && !isConstructorType` — and
        ; `class C extends null {}` is deliberately NOT this error, which is the
        ; middle conjunct.
        var not_a_constructor false
        if (bt.flags & TypeFlagsAny) = 0
        {
            if bt <> null_widening_type
            {
                if this.is_constructor_type(bt) = false
                    set not_a_constructor: true
            }
        }
        if this.unported_mark() <> mark
            return null
        if not_a_constructor
        {
            ; ★ The TYPE-PARAMETER arm's related information
            ; (`Did_you_mean_for_0_to_be_constrained_to_type_new_args_Colon_any_1`)
            ; is not written: no instrument in this package compares a related
            ; info, and the oracle's diagnostic lines carry none. ★★★Its two
            ; ARGUMENTS are computed all the same (slice 189): the constraint's
            ; first construct signature's RETURN type is resolved there, and the
            ; name is then walked — see name_type_for_message.
            let base_name this.type_arg(bt)
            var constrained_declaration: ref[AstNode]? null
            var constrained_symbol_name String("")
            var constrained_return_name String("")
            if (bt.flags & TypeFlagsTypeParameter) <> 0
            {
                let constraint this.get_constraint_from_type_parameter(bt)
                var ctor_return unknown_type
                if constraint <> null
                {
                    let ctor_sigs this.get_signatures_of_type(constraint as ref[Type], SignatureKindConstruct)
                    if Checker.sig_count(ctor_sigs) <> 0
                    {
                        let sig0 (ctor_sigs as ref[Array[ref[Signature]?]])[0]
                        if sig0 <> null
                        {
                            let rt0 this.get_return_type_of_signature(sig0 as ref[Signature])
                            if rt0 <> null
                                set ctor_return: rt0 as ref[Type]
                        }
                    }
                }
                if bt.symbol <> null
                {
                    if Symbol.declaration_count(bt.symbol as ref[Symbol]) <> 0
                    {
                        set constrained_declaration: Symbol.declaration_at(bt.symbol as ref[Symbol], 0)
                        set constrained_symbol_name: this.symbol_arg(bt.symbol as ref[Symbol])
                        set constrained_return_name: this.type_arg(ctor_return)
                    }
                }
            }
            let base_mark this.diagnostic_mark()
            this.error_on_node(base_expr, DiagType_0_is_not_a_constructor_function_type, base_name)
            if constrained_declaration <> null
                this.related_info_since(base_mark, constrained_declaration, DiagDid_you_mean_for_0_to_be_constrained_to_type_new_args_Colon_any_1, constrained_symbol_name, constrained_return_name)
            if Checker.resolved_base_constructor_type_of(t) = null
                Checker.set_resolved_base_constructor_type(t, error_type)
            return Checker.resolved_base_constructor_type_of(t)
        }
        if Checker.resolved_base_constructor_type_of(t) = null
            Checker.set_resolved_base_constructor_type(t, base_ctor)
        Checker.resolved_base_constructor_type_of(t)
    }

    ; getBaseTypeNodeOfClass.
    function get_base_type_node_of_class(t: ref[Type]) returns ref[AstNode]?
    {
        if t.symbol = null
            return null
        let decl Checker.get_class_like_declaration_of_symbol(t.symbol as ref[Symbol])
        if decl = null
            return null
        Checker.get_extends_heritage_clause_element(decl as ref[AstNode])
    }

    ; ast.GetClassLikeDeclarationOfSymbol — Find(symbol.Declarations, IsClassLike).
    function get_class_like_declaration_of_symbol(symbol: ref[Symbol]) returns ref[AstNode]?
    {
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                if Parser.is_class_like_node(dn)
                    return dn
            }
            set i: i + 1
        }
        null
    }

    ; ── getBaseTypes ────────────────────────────────────────────────────────
    ;
    ; ★★ SLICE 85 WROTE THAT THE CLASS ARM WAS *"UNREACHABLE RATHER THAN
    ; UNWRITTEN"* — two callers, both in checkInterfaceDeclaration — AND SLICE 86
    ; GIVES IT A THIRD. resolveObjectTypeMembers asks getBaseTypes about the SOURCE
    ; of every type reference it resolves, and every class's declared type is one,
    ; so the class arm now runs on 274 units of the stage-1 corpus where it used to
    ; run on none. It answers an EMPTY list for all of them, which is the sentence
    ; the arm below is worth: `undefinedType` carries neither Object nor
    ; Intersection nor Any, so a base-less class resolves to no base types and the
    ; caller's inheritance loop is skipped rather than stopped.
    procedure get_base_types(this, t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        if (t.object_flags & (ObjectFlagsClassOrInterface | ObjectFlagsTuple)) = 0
            return null
        if Checker.base_types_resolved_of(t) = false
        {
            if this.push_type_resolution(null, t, null, null, TypeSystemPropertyNameResolvedBaseTypes) = false
                return Checker.resolved_base_types_of(t)
            ; ★★★ THE MARK IS THE COUNTER AND NOT THE FLAG, AND SLICE 85 IS WHERE
            ; THE DIFFERENCE STOPPED BEING FREE. `is_unported()` answers *has this
            ; UNIT stopped*, so a `before`/`after` pair built out of it fires only
            ; while the unit is still silent — and by the time a file's second
            ; interface is checked it usually is not. Measured: for
            ; `interface A { [k: string]: string } interface B extends A {}` the
            ; interface A reports first, so B's resolve_base_types_of_interface
            ; stop was invisible here and this function MEMOISED AN EMPTY BASE-TYPE
            ; LIST for a type that has a base. Nothing failed, because until slice
            ; 85 nothing read the answer; resolve_object_type_members reads it, and
            ; a silently empty list makes it skip every inherited member.
            ; `unported_mark()` is the monotone count and answers *did THIS call
            ; stop*. ★The same pair in the same bool spelling stands at 48 sites in
            ; this file and each is latently the same defect — a sweep of its own,
            ; named here rather than done.
            let before this.unported_mark()
            ; ★★★ THE TUPLE ARM IS CODE SINCE SLICE 115. It used to report, and the
            ; `get-tuple-base-type` tag it filed was a claim about the SLICE and not
            ; about the type: nothing minted a tuple, so nothing arrived here.
            if (t.object_flags & ObjectFlagsTuple) <> 0
            {
                let base this.get_tuple_base_type(t)
                if base = null
                {
                    this.pop_type_resolution()
                    return null
                }
                let one this.new_type_list_of(1)
                one.add(base)
                Checker.mark_base_types_resolved(t)
                Checker.set_resolved_base_types(t, one)
                this.pop_type_resolution()
                return one
            }
            if t.symbol = null
            {
                ; The reference's `default` here is a panic. A report, on this
                ; file's rule.
                this.pop_type_resolution()
                this.record_unported("get-base-types-no-symbol", 0)
                return null
            }
            let sym t.symbol as ref[Symbol]
            let sf Symbol.flags_of(sym)
            if (sf & (SymbolFlagsClass | SymbolFlagsInterface)) = 0
            {
                this.pop_type_resolution()
                this.record_unported("get-base-types-unhandled", 0)
                return null
            }
            if (sf & SymbolFlagsClass) <> 0
            {
                this.resolve_base_types_of_class(t)
                if this.unported_mark() <> before
                {
                    this.pop_type_resolution()
                    return null
                }
            }
            if (sf & SymbolFlagsInterface) <> 0
            {
                this.resolve_base_types_of_interface(t)
                if this.unported_mark() <> before
                {
                    this.pop_type_resolution()
                    return null
                }
            }
            if this.pop_type_resolution() = false
            {
                let dn Symbol.declaration_count(sym)
                var di 0
                while di < dn
                {
                    let d Symbol.declaration_at(sym, di)
                    if d <> null
                    {
                        let dr d as ref[AstNode]
                        var reportable false
                        if AstNode.kind_of(dr) = KindClassDeclaration
                            set reportable: true
                        if AstNode.kind_of(dr) = KindInterfaceDeclaration
                            set reportable: true
                        if reportable
                        {
                            ; reportCircularBaseType — TS2310. ★★★The stop that
                            ; stood here was priced in the wrong currency: it read
                            ; *the printer ports the KEYWORD arms only, so a class
                            ; or interface type has no name to put in the message*,
                            ; and the message ARGUMENT is the one part of a
                            ; diagnostic no yardstick can see — the dump carries
                            ; the CODE and the SPAN. The proof is a sibling: the
                            ; SECOND reportCircularBaseType site, three hundred
                            ; lines below in the base-type resolver, has reported
                            ; this very code through `error_on_node` since it was
                            ; written, and on the four-line probe the reference
                            ; answers 2310 three times where this port answered it
                            ; once and stopped twice.
                            ;
                            ; ★★★ SLICE 184: THE `return null` THAT STOOD HERE WAS
                            ; TWO DEFECTS IN ONE LINE, AND BOTH ARE OVER-REPORTS.
                            ; The reference's loop reports for EVERY reportable
                            ; declaration and then FALLS THROUGH to the two lines
                            ; below — so the early exit (a) reported once where a
                            ; merged interface owes one report per declaration and,
                            ; far worse, (b) skipped `mark_base_types_resolved`, so
                            ; the memo was never set and the NEXT ask re-resolved
                            ; and re-reported. `interface i8 extends i9` /
                            ; `interface i9 extends i8` measured NINE 2310 lines
                            ; against the reference's two. The recognition rule is
                            ; that a memo written AFTER a reporting branch is only
                            ; a memo for the paths that reach it.
                            this.error_on_node(dr, DiagType_0_recursively_references_itself_as_a_base_type, this.type_arg_array_as_generic(t))
                        }
                    }
                    set di: di + 1
                }
            }
            ; `t.objectFlags &^= ObjectFlagsMembersResolved`. Spelled as a
            ; conditional xor because this file has no bitwise complement — and
            ; the reference's comment is the reason the line exists at all: a
            ; circularity in a type-parameter default can leave members half
            ; resolved, and this resets that.
            if (t.object_flags & ObjectFlagsMembersResolved) <> 0
                set t.object_flags: t.object_flags xor ObjectFlagsMembersResolved
            Checker.mark_base_types_resolved(t)
        }
        Checker.resolved_base_types_of(t)
    }

    ; resolveBaseTypesOfClass, WHOLE (slice 127).
    ;
    ; ★★★ THE STOP THAT STOOD HERE WAS §3.5dk: EVERY CALLEE BELOW THE GUARD HAD
    ; SINCE BEEN PORTED. Slice 85's note said a class that DOES extend *"stops one
    ; call earlier, inside getBaseConstructorTypeOfClass at isConstructorType"* —
    ; true then, and slice 124 ported isConstructorType, after which the walk
    ; arrived here and the report was the only thing left in its way.
    ; getTypeFromClassOrInterfaceReference, getInstantiatedConstructorsForTypeArguments,
    ; getReturnTypeOfSignature, getReducedType, isValidBaseType and hasBaseType are
    ; all in the tree; what this function was missing was its own body.
    ;
    ; ★★ THE THREE WAYS TO A BASE TYPE ARE NOT INTERCHANGEABLE and the first is the
    ; one the corpus takes: a base constructor whose SYMBOL is a class with all its
    ; outer type parameters applied is read as a TYPE REFERENCE, which is what gives
    ; `class D extends B<string>` the same argument checking a `B<string>`
    ; annotation gets. The `any` arm is the error-recovery path, and the third —
    ; a class extending a class-like FUNCTION — goes through the construct
    ; signatures and takes the first instantiated one's return type.
    ;
    ; ★ elaborateNeverIntersection builds a diagnostic CHAIN and this port has none
    ; (§3.20): the head is TS2509 and that is the code emitted. The TypeToString
    ; argument of both messages is likewise not carried — a diagnostic here is
    ; (pos, end, code).
    procedure resolve_base_types_of_class(this, t: ref[Type])
    {
        let mark this.unported_mark()
        let base_constructor_type this.get_base_constructor_type_of_class(t)
        if this.unported_mark() <> mark
            return
        if base_constructor_type = null
            return
        let apparent this.get_apparent_type(base_constructor_type as ref[Type])
        if this.unported_mark() <> mark
            return
        if apparent = null
            return
        let base_ctor apparent as ref[Type]
        if (base_ctor.flags & (TypeFlagsObject | TypeFlagsIntersection | TypeFlagsAny)) = 0
            return
        let base_type_node Checker.get_base_type_node_of_class(t)
        var base_type: ref[Type]? null
        ; `originalBaseType` is read only by areAllOuterTypeParametersApplied, and
        ; only when the symbol is a class — so the declared type is an interface
        ; type there and the accessor below has something to slice.
        var reference_path false
        if base_ctor.symbol <> null
        {
            let bsym base_ctor.symbol as ref[Symbol]
            if (Symbol.flags_of(bsym) & SymbolFlagsClass) <> 0
            {
                let original this.get_declared_type_of_symbol(bsym)
                if this.unported_mark() <> mark
                    return
                if original <> null
                {
                    if this.are_all_outer_type_parameters_applied(original as ref[Type])
                        set reference_path: true
                    if this.unported_mark() <> mark
                        return
                }
            }
        }
        if reference_path
        {
            if base_type_node = null
                return
            set base_type: this.get_type_from_class_or_interface_reference(base_type_node as ref[AstNode], base_ctor.symbol as ref[Symbol])
            if this.unported_mark() <> mark
                return
        }
        else
        {
            if (base_ctor.flags & TypeFlagsAny) <> 0
                set base_type: base_ctor
            else
            {
                if base_type_node = null
                    return
                let btn base_type_node as ref[AstNode]
                let args AstNode.type_arguments_of(btn)
                let constructors this.get_instantiated_constructors_for_type_arguments(base_ctor, args, btn)
                if this.unported_mark() <> mark
                    return
                var count 0
                if constructors <> null
                    set count: (constructors as ref[Array[ref[Signature]?]]).get_length() as int
                if count = 0
                {
                    this.error_on_node(AstNode.expression_of(btn), DiagNo_base_constructor_has_the_specified_number_of_type_arguments)
                    return
                }
                let first (constructors as ref[Array[ref[Signature]?]])[0]
                if first = null
                    return
                set base_type: this.get_return_type_of_signature(first as ref[Signature])
                if this.unported_mark() <> mark
                    return
            }
        }
        if base_type = null
            return
        let bt base_type as ref[Type]
        if this.is_error_type(bt)
            return
        let reduced this.get_reduced_type(bt)
        if this.unported_mark() <> mark
            return
        if reduced = null
            return
        let rbt reduced as ref[Type]
        if this.is_valid_base_type(rbt) = false
        {
            if this.unported_mark() <> mark
                return
            var err: ref[AstNode]? null
            if base_type_node <> null
                set err: AstNode.expression_of(base_type_node as ref[AstNode])
            let reduced_name this.type_arg(rbt)
            this.error_on_node(err, DiagBase_constructor_return_type_0_is_not_an_object_type_or_intersection_of_object_types_with_statically_known_members, reduced_name)
            return
        }
        if this.unported_mark() <> mark
            return
        var recursive false
        if t = rbt
            set recursive: true
        if recursive = false
        {
            if this.has_base_type(rbt, t)
                set recursive: true
            if this.unported_mark() <> mark
                return
        }
        if recursive
        {
            var vd: ref[AstNode]? null
            if t.symbol <> null
                set vd: Symbol.value_declaration_of(t.symbol as ref[Symbol])
            let recursive_name this.type_arg(t)
            this.error_on_node(vd, DiagType_0_recursively_references_itself_as_a_base_type, recursive_name)
            return
        }
        let one this.new_type_list_of(1)
        one.add(rbt)
        Checker.set_resolved_base_types(t, one)
    }

    ; areAllOuterTypeParametersApplied. *"An unapplied type parameter has its
    ; symbol still the same as the matching argument symbol. Since parameters are
    ; applied outer-to-inner, only the last outer parameter needs to be checked."*
    procedure are_all_outer_type_parameters_applied(this, t: ref[Type]) returns bool
    {
        let outer this.outer_type_parameters_of(t)
        if outer = null
            return true
        let o outer as ref[Array[ref[Type]?]]
        let n o.get_length() as int
        if n = 0
            return true
        let args this.get_type_arguments(t)
        if args = null
            return true
        let a args as ref[Array[ref[Type]?]]
        if (a.get_length() as int) < n
            return true
        let lp o[n - 1]
        let la a[n - 1]
        if lp = null
            return true
        if la = null
            return true
        let ps (lp as ref[Type]).symbol
        let asym (la as ref[Type]).symbol
        if ps = null
        {
            ; Both nil is the reference's `==` answering true, i.e. NOT applied.
            if asym = null
                return false
            return true
        }
        if asym = null
            return true
        let p1 ps as ref[Symbol]
        let p2 asym as ref[Symbol]
        if p1 = p2
            return false
        true
    }

    ; resolveBaseTypesOfInterface, WHOLE (slice 127). The INNER loop used to be a
    ; stop for a callee — getTypeFromTypeNode's ExpressionWithTypeArguments arm —
    ; that is now an arm rather than a wall.
    ;
    ; ★★ IT APPENDS RATHER THAN REPLACING, and that is the difference from the class
    ; arm two screens up: an interface may extend SEVERAL bases and its declarations
    ; may be MERGED, so the list is accumulated over every declaration of the symbol
    ; and every element of each `extends` clause. A class has exactly one base.
    procedure resolve_base_types_of_interface(this, t: ref[Type])
    {
        if t.symbol = null
            return
        let sym t.symbol as ref[Symbol]
        let n Symbol.declaration_count(sym)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(sym, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                if AstNode.kind_of(dn) = KindInterfaceDeclaration
                {
                    let elems Checker.get_extends_heritage_clause_elements(dn)
                    if elems <> null
                    {
                        let list elems as ref[Array[ref[AstNode]?]]
                        let en list.get_length() as int
                        var j 0
                        while j < en
                        {
                            let node_row list[j]
                            set j: j + 1
                            if node_row = null
                                continue
                            let node node_row as ref[AstNode]
                            let mark this.unported_mark()
                            let raw this.get_type_from_type_node(node)
                            if this.unported_mark() <> mark
                                return
                            if raw = null
                                continue
                            let base this.get_reduced_type(raw as ref[Type])
                            if this.unported_mark() <> mark
                                return
                            if base = null
                                continue
                            let bt base as ref[Type]
                            if this.is_error_type(bt)
                                continue
                            if this.is_valid_base_type(bt) = false
                            {
                                if this.unported_mark() <> mark
                                    return
                                this.error_on_node(node, DiagAn_interface_can_only_extend_an_object_type_or_intersection_of_object_types_with_statically_known_members)
                                continue
                            }
                            if this.unported_mark() <> mark
                                return
                            var recursive false
                            if t = bt
                                set recursive: true
                            if recursive = false
                            {
                                if this.has_base_type(bt, t)
                                    set recursive: true
                                if this.unported_mark() <> mark
                                    return
                            }
                            if recursive
                            {
                                ; reportCircularBaseType — TS2310 on the
                                ; DECLARATION, not on the element.
                                this.error_on_node(dn, DiagType_0_recursively_references_itself_as_a_base_type, this.type_arg_array_as_generic(t))
                                continue
                            }
                            var acc Checker.resolved_base_types_of(t)
                            if acc = null
                            {
                                let fresh this.new_type_list(null)
                                Checker.set_resolved_base_types(t, fresh)
                                set acc: Checker.resolved_base_types_of(t)
                            }
                            if acc <> null
                                (acc as ref[Array[ref[Type]?]]).add(bt)
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; checkInheritedPropertiesAreIdentical, whole. The note that stood here said the
    ; rest of it — *resolveDeclaredMembers, getPropertiesOfType, isPropertyIdenticalTo
    ; and the TS2320 chain* — was *one call deep behind that test*, and by the time
    ; the row was read three of those four had been in this file for slices:
    ; resolve_declared_members since 86, get_properties_of_type since 92,
    ; compare_properties since the relation. What was actually missing is
    ; isPropertyIdenticalTo, which is ONE line over compare_properties.
    ;
    ; ★★★ THE `seen` MAP IS TWO PARALLEL ARRAYS AND THE KEY IS THE SYMBOL'S NAME,
    ; not the table's id. Upstream reads `declaredMembers` by (id, p) and stores
    ; under `p.Name`, and the two differ for every reserved member name — which is
    ; exactly what `isNamedMember` filters out on the way in, so the pair is
    ; consistent by construction. A linear scan is the whole lookup because the
    ; population is the members of ONE interface with at least two bases.
    ;
    ; ★★ THE REPORT IS A CHAIN AND SO ITS CODE IS TS2320, NOT TS2319.
    ; `NewDiagnosticChain(errorInfo, msg)` builds a NEW diagnostic at the chained
    ; one's own loc with `msg` as its head, so what reaches the list is the
    ; interface message at `typeNode` — see Diagnostics' recode_from header.
    procedure check_inherited_properties_are_identical(this, t: ref[Type], type_node: ref[AstNode]?) returns bool
    {
        ; ★ The counter rather than the flag, for get_base_types' reason one call
        ; up: this guard is *did the base resolution stop*, and after the unit's
        ; first report the bool spelling can no longer answer it.
        let before this.unported_mark()
        let base_types this.get_base_types(t)
        if this.unported_mark() <> before
            return false
        var n 0
        if base_types <> null
            set n: (base_types as ref[Array[ref[Type]?]]).get_length() as int
        if n < 2
            return true
        let bases base_types as ref[Array[ref[Type]?]]
        let declared this.resolve_declared_members(t)
        if this.unported_mark() <> before
            return false
        if declared = null
            return false
        let seen_props &Array[ref[Symbol]?]()
        let seen_types &Array[ref[Type]?]^host()
        let members (declared as ref[DeclaredMembers]).members
        let mn SymbolTable.length(members)
        var mi 0
        while mi < mn
        {
            let p SymbolTable.entry_symbol_at(members, mi)
            let id SymbolTable.entry_name_at(members, mi)
            set mi: mi + 1
            if p = null
                continue
            if this.is_named_member(p, id) = false
                continue
            seen_props.add(p)
            seen_types.add(t)
        }
        let this_type Checker.this_type_of(t)
        var identical true
        var bi 0
        while bi < n
        {
            let base bases[bi]
            set bi: bi + 1
            if base = null
                continue
            let b base as ref[Type]
            let widened this.get_type_with_this_argument(b, this_type, false)
            if this.unported_mark() <> before
                return false
            if widened = null
                continue
            let props this.get_properties_of_type(widened as ref[Type])
            if this.unported_mark() <> before
                return false
            if props = null
                continue
            let list props as ref[Array[ref[Symbol]?]]
            let pn list.get_length() as int
            var pi 0
            while pi < pn
            {
                let prop list[pi]
                set pi: pi + 1
                if prop = null
                    continue
                let name Symbol.name_of(prop as ref[Symbol])
                var found -1
                let sn seen_props.get_length() as int
                var si 0
                while si < sn
                {
                    let e seen_props[si]
                    if e <> null
                    {
                        if SymbolTable.names_equal(Symbol.name_of(e as ref[Symbol]), name)
                        {
                            set found: si
                            set si: sn
                        }
                    }
                    if si < sn
                        set si: si + 1
                }
                if found < 0
                {
                    seen_props.add(prop)
                    seen_types.add(b)
                    continue
                }
                let containing seen_types[found]
                if containing = t
                    continue
                let existing seen_props[found]
                if existing = null
                    continue
                let same this.is_property_identical_to(existing as ref[Symbol], prop as ref[Symbol])
                if this.unported_mark() <> before
                    return false
                if same
                    continue
                set identical: false
                let type_name1 this.type_arg(containing)
                let type_name2 this.type_arg(base)
                let interface_name this.type_arg(t)
                this.error_on_node(type_node, DiagInterface_0_cannot_simultaneously_extend_types_1_and_2, interface_name, type_name1, type_name2)
            }
        }
        identical
    }

    ; isPropertyIdenticalTo — `compareProperties(source, target,
    ; compareTypesIdentical) != TernaryFalse`, and the port's compare_properties
    ; already answers the Ternary as a bool.
    procedure is_property_identical_to(this, source_prop: ref[Symbol], target_prop: ref[Symbol]) returns bool
        this.compare_properties(source_prop, target_prop, SignatureComparerIdentical)

    ; ── slice 81: the base constraint of a type parameter ────────────────────
    ;
    ; getBaseConstraintOfType and the nine functions behind it. It is the FIRST of
    ; the three checks checkTypeParameter runs over the type a type-parameter
    ; declaration denotes, and the reference calls it purely to force the
    ; circularity errors out — its answer is DISCARDED at that call site — so what
    ; this chapter produces is a DIAGNOSTIC and not a type.
    ;
    ; ★★★ EIGHT OF computeBaseConstraint's NINE ARMS ARE UNREACHABLE BY
    ; CONSTRUCTION RATHER THAN DEFERRED, AND THAT IS A MEASUREMENT OF THE TYPE
    ; FACTORY RATHER THAN A GUESS. Every type this port holds comes out of
    ; new_intrinsic_type, new_object_type, new_type_parameter or new_literal_type,
    ; and the only flags those four ever set are the eleven intrinsic ones, Object,
    ; TypeParameter and the four literal ones. So UnionOrIntersection, Index,
    ; TemplateLiteral, StringMapping, IndexedAccess, Conditional, Substitution and
    ; the generic tuple cannot be ASKED here — no value carrying those flags
    ; exists. Those arms are left OUT rather than stopped, because a
    ; `record_unported` in a branch nothing can enter is a work-list row that can
    ; never appear, and the work list is this port's product (§3.5be). The arm that
    ; lands is TypeParameter; the TAIL (`return t`) is what answers for an
    ; object-type constraint, and it IS reached — `<T extends { a: number }>` walks
    ; it.
    ;
    ; ★★ getSimplifiedType IS THE IDENTITY HERE, AND IT IS THE SAME MEASUREMENT
    ; FROM THE OTHER SIDE. getResolvedBaseConstraint's one call is
    ; `computeBaseConstraint(c.getSimplifiedType(t, false), …)` and
    ; TypeFlagsSimplifiable is Index|IndexedAccess|Conditional — none of which any
    ; type here carries. The call is therefore written as a comment at its line
    ; rather than as a function whose two arms nothing can enter.
    ;
    ; ★★★ WHAT THE ROW BECOMES, WHICH IS THE HALF A COUNT DOES NOT SHOW. The stop
    ; this chapter retires stood in front of THREE calls: the second one — the
    ; circular DEFAULT — lands with it, and the third is checkTypeAssignableTo,
    ; i.e. the assignability relation, so the row moves rather than closing. But it
    ; moves onto a much smaller population: the reference reaches that call only
    ; when a type parameter has BOTH a constraint and a default.

    ; getBaseConstraintOfType, whole but for isGenericTupleType — `isTupleType(t)
    ; && t.TargetTupleType().combinedFlags&Variadic != 0`, and new_object_type's
    ; Tuple arm reports, so no tuple type exists to ask it about.
    ;
    ; ★★ THE FILTER IS WHAT CONFINES THE TWO SENTINELS TO THIS CHAPTER, and that
    ; is its job rather than a speed-up: a type outside the disjunction answers
    ; nil, and a type inside it answers nil for either sentinel — so no caller
    ; anywhere can come to hold a noConstraintType or a circularConstraintType.
    procedure get_base_constraint_of_type(this, t: ref[Type]) returns ref[Type]?
    {
        ; `… != 0 || isGenericTupleType(t)`: a variadic tuple has a base constraint too —
        ; its variadic elements replaced by theirs (`[...T, ...T]` → `[unknown, unknown]`)
        var constrained (t.flags & (TypeFlagsInstantiableNonPrimitive | TypeFlagsUnionOrIntersection | TypeFlagsTemplateLiteral | TypeFlagsStringMapping | TypeFlagsIndex)) <> 0
        if constrained = false
            set constrained: Checker.is_generic_tuple_type(t)
        if constrained = false
            return null
        let constraint this.get_resolved_base_constraint(t)
        if constraint = null
            return null
        let c constraint as ref[Type]
        if c = no_constraint_type
            return null
        if c = circular_constraint_type
            return null
        c
    }

    ; getResolvedBaseConstraint, whole, and none of its five steps is decoration:
    ; the memo, the resolution frame, the depth limiter, the failed-pop report and
    ; the write-back that never overwrites.
    ;
    ; ★★★ THE REPORT IS THE ONLY REASON THE REFERENCE CALLS THIS FROM
    ; checkTypeParameter AT ALL, and it hangs off pop_type_resolution answering
    ; FALSE — i.e. off the frame this call pushed having been marked by a
    ; RE-ENTRY, which is slice 67's mechanism doing exactly what its header
    ; describes. `<T extends U, U extends T>` is the shape.
    ;
    ; ★★ THE RELATED INFORMATION IS NOT BUILT, and this is the first caller in the
    ; port that has any: the reference attaches *Circularity originates in type at
    ; this location* when `c.currentNode` is neither an ancestor nor a descendant
    ; of the error node. There is no currentNode field here (it is set by the
    ; check-source-element wrapper for tracing) and the yardstick's C line is
    ; `C pos end code`, so the attachment has nothing to write into and nothing to
    ; compare against — the same reading reportImplicitAny's header states for
    ; message ARGUMENTS. error_on_node's note said the first caller that needs the
    ; *Diagnostic back would be the one to give it a return type; it is this one,
    ; and it does not need it.
    ;
    ; ★ A null answer means a STOP happened underneath (get_type_from_type_node
    ; reports for a type node this port cannot resolve). The reference has no such
    ; case — its getTypeFromTypeNode always answers — so the null is propagated
    ; rather than turned into a sentinel, and the memo is left unwritten: a
    ; half-computed answer that got cached would make the SECOND ask disagree with
    ; the first.
    ; getResolvedBaseConstraint's TOP-LEVEL entry — `getResolvedBaseConstraint(t, nil)`:
    ; getBaseConstraintOfType and hasNonCircularBaseConstraint hand the worker an EMPTY
    ; recursion-identity stack, even when they are reached from INSIDE another
    ; base-constraint computation (a relation step under computeBaseConstraint asks
    ; getBaseConstraintOfType again). Upstream threads the stack as a parameter; this port
    ; keeps it on the checker, so an inner top-level ask saw the outer computation's
    ; entries, met the 10-deep exploration limit early and stopped exploring where the
    ; reference went on to depth 15 (slice 214; `excessivelyDeepConditionalTypes`, two
    ; TS2321 the reference does not report). The outer stack is set aside for the inner
    ; ask and restored after it; only get_next_base_constraint (computeBaseConstraint's
    ; own recursion) stays on the inherited stack.
    procedure get_resolved_base_constraint(this, t: ref[Type]) returns ref[Type]?
    {
        if base_constraint_depth = 0
            return this.get_resolved_base_constraint_in_stack(t)
        let saved_stack base_constraint_stack
        let saved_depth base_constraint_depth
        let page Page.get(this)
        let fresh &Array[ref[RecursionId]?]^page()
        set base_constraint_stack: fresh
        set base_constraint_depth: 0
        let r this.get_resolved_base_constraint_in_stack(t)
        set base_constraint_stack: saved_stack
        set base_constraint_depth: saved_depth
        r
    }

    procedure get_resolved_base_constraint_in_stack(this, t: ref[Type]) returns ref[Type]?
    {
        ; `constrained := t.AsConstrainedType(); if constrained == nil { return t }`
        if Checker.is_constrained_type(t) = false
            return t
        let memo Checker.resolved_base_constraint_of(t)
        if memo <> null
            return memo
        if this.push_type_resolution(null, t, null, null, TypeSystemPropertyNameResolvedBaseConstraint) = false
            return circular_constraint_type
        ; "We always explore at least 10 levels of nested constraints. Thereafter,
        ; we continue to explore up to 50 levels of nested constraints provided
        ; there are no 'deeply nested' types on the stack." The reference's own
        ; comment adds that it has no test case reaching 50, so the second bound is
        ; a safety stop.
        let identity_value this.get_recursion_identity(t)
        let identity &RecursionId^host(identity_value.target_symbol, identity_value.target_type, identity_value.target_node)
        var explore false
        if base_constraint_depth < 10
            set explore: true
        if explore = false
        {
            if base_constraint_depth < 50
            {
                if this.stack_has_recursion_identity(identity) = false
                    set explore: true
            }
        }
        var constraint: ref[Type]? null
        var stopped false
        if explore
        {
            let mark this.unported_mark()
            this.push_recursion_identity(identity)
            ; ★ The reference asks computeBaseConstraint about the SIMPLIFIED type
            ; and takes the recursion identity off the original. The note that
            ; stood here — *getSimplifiedType is the identity* — was the type
            ; factory's own measurement in the era when nothing could mint an
            ; IndexedAccess or a Conditional, and it expired long before slice 166
            ; gave the function a body.
            let simplified this.get_simplified_type(t, false)
            if this.unported_mark() <> mark
                set stopped: true
            if stopped = false
            {
                if simplified = null
                    set stopped: true
                else
                {
                    set constraint: this.compute_base_constraint(simplified as ref[Type])
                    if this.unported_mark() <> mark
                        set stopped: true
                }
            }
            this.pop_recursion_identity()
        }
        ; ★★★ THE POP MUST HAPPEN ON EVERY PATH, WHICH IS WHY THE STOP TEST IS
        ; BELOW IT AND NOT BESIDE THE CALL: returning early with a frame still on
        ; c.typeResolutions would make the NEXT unrelated question find a cycle.
        ; And the two conditions are asked in this order because a failed pop is
        ; DEFINITIVE evidence of a re-entry, where a stop only says the answer is
        ; incomplete.
        if this.pop_type_resolution() = false
        {
            if (t.flags & TypeFlagsTypeParameter) <> 0
            {
                let error_node this.get_constraint_declaration(t)
                if error_node <> null
                {
                    let circular_name this.type_arg(t)
                    let circular_mark this.diagnostic_mark()
                    this.error_on_node_or_null(error_node, DiagType_parameter_0_has_a_circular_constraint, circular_name)
                    if current_node <> null
                    {
                        if (Checker.is_node_descendant_of(error_node, current_node) = false) and (Checker.is_node_descendant_of(current_node, error_node) = false)
                            this.related_info_since(circular_mark, current_node, DiagCircularity_originates_in_type_at_this_location)
                    }
                }
            }
            set constraint: circular_constraint_type
            set stopped: false
        }
        ; ★★★ A NULL FROM computeBaseConstraint IS TWO DIFFERENT THINGS AND ONLY
        ; THE MARK TELLS THEM APART: the reference's own nil — which
        ; getNextBaseConstraint answers for a nested constraint that came back
        ; circular, and which must become noConstraintType — and a STOP underneath,
        ; which must be propagated. `unported_mark` is the monotone counter that
        ; exists for exactly this question (`is_unported` answers *has this unit
        ; stopped*, which is already true for most units by the time a type
        ; parameter is checked).
        if stopped
            return null
        if constraint = null
            set constraint: no_constraint_type
        if Checker.resolved_base_constraint_of(t) = null
            Checker.set_resolved_base_constraint(t, constraint as ref[Type])
        constraint
    }

    ; computeBaseConstraint, the one arm this port can enter plus the tail. See the
    ; chapter header for why the other eight are absent rather than stopped.
    procedure compute_base_constraint(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsTypeParameter) <> 0
        {
            let constraint this.get_constraint_from_type_parameter(t)
            ; `if t.AsTypeParameter().isThisType { return constraint }` — the `this`
            ; type's constraint is the class or interface type itself (see
            ; getDeclaredTypeOfClassOrInterface, which writes it) and is not
            ; resolved any further.
            if Checker.is_this_type_of(t)
                return constraint
            return this.get_next_base_constraint(constraint)
        }
        ; ★★★ THE TAIL IS `return t` UPSTREAM AND IT IS REACHED ONLY BY A KIND WITH
        ; NO ARM — an object type, an intrinsic. EIGHT kinds DO have an arm here
        ; (the union/intersection fold, `keyof` answering stringNumberSymbol, the
        ; template literal, the string mapping, the indexed access, the
        ; conditional, the substitution and the generic tuple), and every one of
        ; them is the base-constraint chapter rather than this line. Letting them
        ; fall into the tail answers THE TYPE ITSELF, which is not merely
        ; imprecise: `getBaseConstraintOfType` is called by callers that RECURSE on
        ; its answer, and a constraint that is its own input is an infinite loop.
        ;
        ; ★★★ AND THAT IS MEASURED, NOT ARGUED. Slice 122's
        ; is_literal_of_contextual_type arm is the reference's own recursion
        ; (`return c.isLiteralOfContextualType(candidateType, constraint)`), and
        ; with the tail answering `t` for a CONDITIONAL it hung the suite on
        ; `compiler_inferenceWithNeverSource1` — a parameter typed
        ; `string extends T ? "wide" : "narrow"`. Upstream that conditional's base
        ; constraint is `"wide" | "narrow"`, which terminates in one step.
        ; ★★★ SLICE 133 — FIVE OF THE EIGHT ARMS. What each of them does is the
        ; same shape: ask getNextBaseConstraint of every constituent and REBUILD
        ; the type around the answers, falling back to the widest type the kind
        ; can denote when a constituent has none. The three that stay are named
        ; one by one below rather than under this kind mask, because they stop for
        ; three different reasons.
        if (t.flags & TypeFlagsUnionOrIntersection) <> 0
            return this.compute_base_constraint_of_union_or_intersection(t)
        if (t.flags & TypeFlagsIndex) <> 0
            return this.compute_base_constraint_of_index(t)
        if (t.flags & TypeFlagsTemplateLiteral) <> 0
            return this.compute_base_constraint_of_template_literal(t)
        if (t.flags & TypeFlagsStringMapping) <> 0
        {
            ; ★The `else` half — stringType — could never be taken alone: taking it
            ; when the constraint DID move is a wrong answer rather than a coarse
            ; one, which is why this arm was a stop until the mint existed.
            let target Checker.string_mapping_target_of(t)
            if target = null
                return null
            if t.symbol = null
                return null
            let tt target as ref[Type]
            let constraint this.get_next_base_constraint(tt)
            if constraint <> null
            {
                if (constraint as ref[Type]) <> tt
                    return this.get_string_mapping_type(t.symbol as ref[Symbol], constraint as ref[Type])
            }
            return string_type
        }
        ; ★★★ THE FORK'S CONDITION HAS BEEN ASKABLE SINCE SLICE 136 — the note here
        ; named isMappedTypeGenericIndexedAccess and getMappedTypeModifiers as the
        ; two missing pieces and both landed with the constraint family; §3.5dk.
        ; Only substituteIndexedMappedType was genuinely absent, and it is written
        ; below.
        if (t.flags & TypeFlagsIndexedAccess) <> 0
        {
            let object_type Checker.indexed_access_object_type_of(t)
            let index_type Checker.indexed_access_index_type_of(t)
            if object_type = null
                return null
            if index_type = null
                return null
            let ot object_type as ref[Type]
            let it index_type as ref[Type]
            ; "For indexed access types of the form { [P in K]: E }[X], where K is
            ; non-generic and X is generic, we substitute an instantiation of E
            ; where P is replaced with X."
            if this.is_mapped_type_generic_indexed_access(t)
            {
                let mark this.unported_mark()
                let sub this.substitute_indexed_mapped_type(ot, it)
                if this.unported_mark() <> mark
                    return null
                return this.get_next_base_constraint(sub)
            }
            let mark this.unported_mark()
            let base_object_type this.get_next_base_constraint(ot)
            if this.unported_mark() <> mark
                return null
            let base_index_type this.get_next_base_constraint(it)
            if this.unported_mark() <> mark
                return null
            if base_object_type = null
                return null
            if base_index_type = null
                return null
            let access this.get_indexed_access_type_or_undefined(base_object_type as ref[Type], base_index_type as ref[Type], Checker.indexed_access_flags_of(t), null, null)
            if this.unported_mark() <> mark
                return null
            return this.get_next_base_constraint(access)
        }
        ; ★★★ THE CONDITIONAL ARM'S NOTE NAMED getConstraintFromConditionalType AS
        ; *a chapter of its own*, and that chapter landed with the distributive
        ; constraint; §3.5dk. What the arm adds is the LIMITER, and it is the whole
        ; reason the arm cannot be four lines: a conditional's constraint is
        ; another conditional's input, so the walk needs a budget of its own that
        ; is DECREMENTED on every path out — including the one that answers null.
        if (t.flags & TypeFlagsConditional) <> 0
        {
            if conditional_constraint_depth >= 100
                return null
            set conditional_constraint_depth: conditional_constraint_depth + 1
            let mark this.unported_mark()
            let constraint this.get_constraint_from_conditional_type(t)
            set conditional_constraint_depth: conditional_constraint_depth - 1
            if this.unported_mark() <> mark
                return null
            return this.get_next_base_constraint(constraint)
        }
        if (t.flags & TypeFlagsSubstitution) <> 0
            return this.get_next_base_constraint(this.get_substitution_intersection(t))
        ; `case c.isGenericTupleType(t)` — a KIND test rather than a flag test, and
        ; it stands where the reference puts it: AFTER every flag arm and before
        ; the tail.
        if Checker.is_generic_tuple_type(t)
            return this.compute_base_constraint_of_generic_tuple(t)
        t
    }

    ; computeBaseConstraint's UNION/INTERSECTION arm.
    ;
    ; ★★★ `different` IS THE WHOLE ARM: when no constituent's constraint moved the
    ; answer is the TYPE ITSELF, not a rebuilt union of the same members — which
    ; would be equal by structure and different by identity, and identity is what
    ; every caller that recurses on this answer tests.
    ; ★A constituent with NO constraint sets `different` and is DROPPED, so a
    ; UNION rebuilds only when every member survived (`len == len`) while an
    ; INTERSECTION rebuilds from whatever is left.
    procedure compute_base_constraint_of_union_or_intersection(this, t: ref[Type]) returns ref[Type]?
    {
        ; ★★★ `t.Types()` — the accessor that answers for BOTH payloads. Reaching for
        ; the union-only one here is a silent nil for every intersection, which is
        ; not a stop and not an answer: the caller reads it as *no constraint* and
        ; the wall it replaces was at least honest.
        let types Checker.union_or_intersection_types_of(t)
        if types = null
            return null
        let ts types as ref[Array[ref[Type]?]]
        let n ts.get_length() as int
        let constraints &Array[ref[Type]?]()
        var different false
        var i 0
        while i < n
        {
            let member ts[i]
            if member = null
                return null
            let m member as ref[Type]
            let mark this.unported_mark()
            let constraint this.get_next_base_constraint(m)
            if this.unported_mark() <> mark
                return null
            if constraint = null
                set different: true
            else
            {
                if constraint <> m
                    set different: true
                constraints.add(constraint)
            }
            set i: i + 1
        }
        if different = false
            return t
        let kept constraints.get_length() as int
        if (t.flags & TypeFlagsUnion) <> 0
        {
            if kept = n
                return this.get_union_type(constraints)
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            if kept <> 0
                return this.get_intersection_type(constraints)
        }
        null
    }

    ; computeBaseConstraint's INDEX arm — `keyof T`. ★The mapped-type detour is a
    ; NARROW one: only a generic mapped type WITH a name type and WITHOUT a
    ; `keyof`-constraint declaration answers through its own index type; everything
    ; else, `keyof` over anything at all, is constrained by string | number |
    ; symbol.
    procedure compute_base_constraint_of_index(this, t: ref[Type]) returns ref[Type]?
    {
        let target Checker.index_target_of(t)
        if target <> null
        {
            let mapped_type target as ref[Type]
            if this.is_generic_mapped_type(mapped_type)
            {
                let mark this.unported_mark()
                let name_type this.get_name_type_from_mapped_type(mapped_type)
                if this.unported_mark() <> mark
                    return null
                if name_type <> null
                {
                    if Checker.is_mapped_type_with_keyof_constraint_declaration(mapped_type) = false
                    {
                        let index this.get_index_type_for_mapped_type(mapped_type, IndexFlagsNone)
                        if this.unported_mark() <> mark
                            return null
                        if index = null
                            return null
                        return this.get_next_base_constraint(index as ref[Type])
                    }
                }
            }
        }
        string_number_symbol_type
    }

    ; computeBaseConstraint's TEMPLATE LITERAL arm. ★Unlike the union arm this one
    ; does NOT test whether anything moved: a template literal whose every span has
    ; a constraint is rebuilt over those constraints, and one span without a
    ; constraint collapses the whole type to `string`.
    procedure compute_base_constraint_of_template_literal(this, t: ref[Type]) returns ref[Type]?
    {
        let types Checker.template_literal_types_of(t)
        let texts Checker.template_literal_texts_of(t)
        if types = null
            return null
        if texts = null
            return null
        let ts types as ref[Array[ref[Type]?]]
        let n ts.get_length() as int
        let constraints this.new_type_list(null)
        var i 0
        while i < n
        {
            let member ts[i]
            if member = null
                return null
            let mark this.unported_mark()
            let constraint this.get_next_base_constraint(member as ref[Type])
            if this.unported_mark() <> mark
                return null
            if constraint <> null
                constraints.add(constraint)
            set i: i + 1
        }
        if (constraints.get_length() as int) = n
            return this.get_template_literal_type(texts as ref[Array[ref[String]?]], constraints)
        string_type
    }

    ; computeBaseConstraint's GENERIC TUPLE arm. ★★ THE SUBSTITUTION IS DELIBERATELY
    ; NARROW and the reference says why: a variadic element's constraint is taken
    ; only when it is an array or a NON-generic tuple, "as we want to avoid further
    ; (possibly unbounded) recursion". Every other element is carried through
    ; unchanged.
    procedure compute_base_constraint_of_generic_tuple(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let element_types this.get_element_types(t)
        if this.unported_mark() <> mark
            return null
        if element_types = null
            return null
        let els element_types as ref[Array[ref[Type]?]]
        let target Checker.target_of(t)
        if target = null
            return null
        let tuple_target target as ref[Type]
        let infos Checker.tuple_element_infos_of(tuple_target)
        if infos = null
            return null
        let element_infos infos as ref[Array[ref[TupleElementInfo]?]]
        let n els.get_length() as int
        let new_elements this.new_type_list(null)
        var i 0
        while i < n
        {
            let v els[i]
            if v = null
                return null
            let element v as ref[Type]
            var new_element element
            if (element.flags & TypeFlagsTypeParameter) <> 0
            {
                let info element_infos[i]
                if info <> null
                {
                    if ((info as ref[TupleElementInfo]).flags & ElementFlagsVariadic) <> 0
                    {
                        let constraint this.get_next_base_constraint(element)
                        if this.unported_mark() <> mark
                            return null
                        if constraint <> null
                        {
                            let cs constraint as ref[Type]
                            if cs <> element
                            {
                                if this.every_type_is_non_generic_array_or_tuple(cs)
                                    set new_element: cs
                                if this.unported_mark() <> mark
                                    return null
                            }
                        }
                    }
                }
            }
            new_elements.add(new_element)
            set i: i + 1
        }
        this.create_tuple_type_ex(new_elements, element_infos, Checker.tuple_readonly_of(tuple_target))
    }

    ; `everyType(constraint, n => c.isArrayOrTupleType(n) && !c.isGenericTupleType(n))`
    ; — everyType over a UNION, the predicate itself over anything else.
    procedure every_type_is_non_generic_array_or_tuple(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let ts types as ref[Array[ref[Type]?]]
            let n ts.get_length() as int
            var i 0
            while i < n
            {
                let member ts[i]
                if member = null
                    return false
                if this.is_non_generic_array_or_tuple(member as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        this.is_non_generic_array_or_tuple(t)
    }

    procedure is_non_generic_array_or_tuple(this, t: ref[Type]) returns bool
    {
        if this.is_array_or_tuple_type(t) = false
            return false
        Checker.is_generic_tuple_type(t) = false
    }

    ; getNextBaseConstraint. It is getBaseConstraintOfType's filter without the
    ; flag test — the recursion's own step, which is why the two read alike and are
    ; two functions upstream as well.
    procedure get_next_base_constraint(this, t: ref[Type]?) returns ref[Type]?
    {
        if t = null
            return null
        let constraint this.get_resolved_base_constraint_in_stack(t as ref[Type])
        if constraint = null
            return null
        let c constraint as ref[Type]
        if c = no_constraint_type
            return null
        if c = circular_constraint_type
            return null
        c
    }

    ; `t.AsConstrainedType() != nil`, as a question about the union TAG.
    ;
    ; ★★★ THE ARM THAT SURPRISES IS THE OBJECT ONE, AND GETTING IT WRONG WOULD BE
    ; INVISIBLE. Upstream ConstrainedType is embedded by eight kinds and one of
    ; them is StructuredType — the base of every type WITH MEMBERS — so an object,
    ; union or intersection type is constrained too and does NOT take
    ; getResolvedBaseConstraint's early exit. That is what makes
    ; `<T extends { a: number }>` push a resolution frame and walk into
    ; computeBaseConstraint's tail instead of answering itself one line in; read
    ; the other way, treating an object type as unconstrained would answer the same
    ; TYPE by a different route and only a frame count could tell.
    ;
    ; ★★★ THE MEMO WAS ON THE TYPE PARAMETER ALONE UNTIL SLICE 168, AND THE NOTE
    ; THAT PRICED THAT AT *WORK* WAS WRONG ABOUT THE ANSWER. It read: *the memo slot
    ; lives on the TypeParameter arm alone, so an object type is constrained for
    ; this test and its base constraint is never cached — the cost is WORK and the
    ; answer is identical, and it is bounded by the fact that the tail does not
    ; recurse*. The bound holds for the TAIL and says nothing about the eleven other
    ; arms, which do recurse: an uncached CONDITIONAL is recomputed on every ask,
    ; and an ask that arrives while the first one's resolution frame is still on the
    ; stack makes `push_type_resolution` answer false and the type CIRCULAR — after
    ; which `has_non_circular_base_constraint` is false and
    ; `get_constraint_of_conditional_type` answers nothing at all. Measured on
    ; `distributiveConditionalBaseConstraint`: the reference's constraint for
    ; `FromSchema<Context, Props[Key]>` is `FromSchema<Context, Props[keyof Props]>`
    ; and this port's was NULL, so the relation fell back to `unknown` and invented
    ; a TS2344. The slot is `Type.resolved_base_constraint` now, which is where
    ; upstream's ConstrainedType has it.
    ; ★★★ SIX ARMS WERE MISSING AND THE HOLE ANSWERED THE TYPE ITSELF (slice 122).
    ; ConstrainedType is embedded upstream by StructuredType, TypeParameter,
    ; IndexType, IndexedAccessType, TemplateLiteralType, StringMappingType,
    ; SubstitutionType and ConditionalType — and StructuredType is the base of the
    ; UNION and INTERSECTION arms too, not only of the three object ones. With any
    ; of the six answering FALSE, `get_resolved_base_constraint` takes its
    ; one-line early exit and hands back `t`: *the base constraint of this
    ; conditional is this conditional*.
    ;
    ; ★★★ WHICH IS A WRONG ANSWER AND NOT A CONSERVATIVE ONE, AND IT WAS INVISIBLE
    ; UNTIL A CALLER RECURSED ON IT. Slice 122's is_literal_of_contextual_type arm
    ; is the reference's own recursion on the base constraint; with a conditional
    ; parameter type (`string extends T ? "wide" : "narrow"`) it never terminated,
    ; and because this compiler turns a self tail call into a LOOP the symptom was
    ; a 60-second silence with a THREE-frame backtrace rather than a stack
    ; overflow. **A missing `choose` arm here is a lie about a type, and the tail
    ; of compute_base_constraint is where it now reports.**
    function is_constrained_type(t: ref[Type]) returns bool
    {
        choose t.data
            when tp: TypeParameter
                return true
            when i: Interface
                return true
            when r: Reference
                return true
            when a: Anonymous
                return true
            when ie: InstantiationExpression
                return true
            ; ★ EVERY object kind carries the slot upstream — `StructuredType` embeds
            ; `ConstrainedType` and every ObjectType embeds StructuredType — so a mapped,
            ; reverse-mapped or evolving-array member of a union is ASKED (pushed, explored,
            ; memoized) like the rest; without these three arms the port skipped the ask and
            ; the instantiation counts of the recursive units drifted from the reference's
            ; (slice 215; `recursiveIndexedAccessSimplification`).
            when m: Mapped
                return true
            when rm: ReverseMapped
                return true
            when ea: EvolvingArray
                return true
            when u: Union
                return true
            when x: Intersection
                return true
            when ix: Index
                return true
            when ia: IndexedAccess
                return true
            when tl: TemplateLiteral
                return true
            when sm: StringMapping
                return true
            when sb: Substitution
                return true
            when cd: Conditional
                return true
        false
    }

    ; getRecursionIdentity, WHOLE since slice 160.
    ;
    ; ★★ THE REFERENCE'S COMMENT IS THE WHOLE POINT OF THE SYMBOL ARMS: an object
    ; type is tracked by the symbol it ORIGINATES in, and a type parameter by its
    ; symbol so that every "fresh" instantiation of it shares one identity. The two
    ; EXCLUSIONS in the object arm are live here and named at their line.
    ;
    ; ★★★ THE FOUR ARMS SLICE 160 ADDS ARE TERMINATION, NOT GRANULARITY, and the
    ; note that stood here had it the other way round: it read *the tail
    ; (`asRecursionId(t)`) covers all four, which is why their absence changes the
    ; identity of nothing that exists*. The tail gives every type its OWN identity,
    ; which is the opposite of what these arms are for — a conditional's
    ; instantiations must SHARE one, or `is_deeply_nested_type` can never count two
    ; occurrences of the same origin and an expanding chain runs until the stack
    ; ends. It cost `submodule_compiler_recursiveTupleTypeInference` a SIGSEGV the
    ; moment the reverse-mapped chapter let the walk reach it (`F<T> = null extends
    ; T ? [F<NonNullable<T>>, "null"] : …` through a mapped type), and the tuple arm
    ; is in the same cycle as the conditional one.
    ; ★ A VALUE, not a page object (slice 227): hasMatchingRecursionIdentity asks
    ; for the identity of EVERY stack entry on every isDeeplyNestedType call, and
    ; an allocation per entry per call was the page churn of
    ; `complexRecursiveCollections` (killed at 240 s against the reference's 2 s).
    procedure get_recursion_identity(this, t: ref[Type]) returns RecursionId
    {
        if t.rid_computed
            return RecursionId(t.rid_symbol, t.rid_type, t.rid_node)
        let r this.compute_recursion_identity(t)
        set t.rid_symbol: r.target_symbol
        set t.rid_type: r.target_type
        set t.rid_node: r.target_node
        set t.rid_computed: true
        r
    }

    function compute_recursion_identity(this, t: ref[Type]) returns RecursionId
    {
        var sym: ref[Symbol]? null
        var node: ref[AstNode]? null
        var ty: ref[Type]? null
        if (t.flags & TypeFlagsObject) <> 0
        {
            ; A DEFERRED type reference is tracked through its AST node —
            ; *finer granularity than using their associated target, because each
            ; manifest type reference has a unique AST node*.
            if (t.object_flags & ObjectFlagsReference) <> 0
            {
                let rn Checker.reference_node_of(t)
                if rn <> null
                    return RecursionId(sym, ty, rn)
            }
            ; isObjectOrArrayLiteralType. Both flags are declared and neither is
            ; set by anything this port mints — checkObjectLiteral and
            ; checkArrayLiteral are work-list rows — so the guard is written and
            ; always passes today.
            if (t.object_flags & (ObjectFlagsObjectLiteral | ObjectFlagsArrayLiteral)) = 0
            {
                if t.symbol <> null
                {
                    var excluded false
                    ; "exclude the static sides of classes (since they share their
                    ; symbols with the instance sides)" — and this port HAS those:
                    ; slice 67 mints the static side as an Anonymous type over the
                    ; class's own symbol, so the exclusion is live rather than
                    ; transcribed.
                    if (t.object_flags & ObjectFlagsAnonymous) <> 0
                    {
                        if (Symbol.flags_of(t.symbol as ref[Symbol]) & SymbolFlagsClass) <> 0
                            set excluded: true
                    }
                    ; "and type references that originate in resolution of AST type
                    ; nodes". Nothing here sets the bit (only createTypeReferenceEx
                    ; and the tuple constructors do upstream), so this is the other
                    ; guard that is written and always passes.
                    if (t.object_flags & ObjectFlagsFromTypeNode) <> 0
                        set excluded: true
                    if excluded = false
                        return RecursionId(t.symbol, ty, node)
                }
            }
            ; A TUPLE is tracked by its TARGET, so every instantiation of one
            ; tuple type shares an identity.
            if Checker.is_tuple_type(t)
            {
                if (t.object_flags & ObjectFlagsFromTypeNode) = 0
                    return RecursionId(sym, Checker.get_target_type(t), node)
            }
        }
        ; A type parameter by its symbol, *such that all "fresh" instantiations of
        ; that type parameter have the same recursion identity*.
        if (t.flags & TypeFlagsTypeParameter) <> 0
        {
            if t.symbol <> null
                return RecursionId(t.symbol, ty, node)
        }
        ; An INDEXED ACCESS is *the leftmost object type in a chain of indexed
        ; accesses* — in `A[P1][P2][P3]` it is A.
        if (t.flags & TypeFlagsIndexedAccess) <> 0
        {
            var cur: ref[Type] t
            var walking true
            while walking
            {
                set walking: false
                let obj Checker.indexed_access_object_type_of(cur)
                if obj <> null
                {
                    set cur: obj as ref[Type]
                    if (cur.flags & TypeFlagsIndexedAccess) <> 0
                        set walking: true
                }
            }
            return RecursionId(sym, cur, node)
        }
        ; A CONDITIONAL is its ROOT's node — *the root object represents the
        ; origin of the conditional type*.
        if (t.flags & TypeFlagsConditional) <> 0
        {
            let root Checker.conditional_root_of(t)
            if root <> null
                return RecursionId(sym, ty, (root as ref[ConditionalRoot]).node)
        }
        RecursionId(sym, t, node)
    }

    ; The three operations the reference gets from a slice: `append(stack, id)`,
    ; the caller keeping its own shorter view, and `slices.Contains`. See the
    ; field's note for why a push/pop pair is the same mechanism.
    procedure push_recursion_identity(this, id: ref[RecursionId])
    {
        let st base_constraint_stack as ref[Array[ref[RecursionId]?]]
        if base_constraint_depth < (st.get_length() as int)
            st.put(base_constraint_depth as size_t, id)
        else
            st.add(id)
        set base_constraint_depth: base_constraint_depth + 1
    }

    procedure pop_recursion_identity(this)
        set base_constraint_depth: base_constraint_depth - 1

    function stack_has_recursion_identity(this, id: ref[RecursionId]) returns bool
    {
        let st base_constraint_stack as ref[Array[ref[RecursionId]?]]
        var i 0
        while i < base_constraint_depth
        {
            let row st[i]
            if row <> null
            {
                let r row as ref[RecursionId]
                ; ★ ALL THREE slots, slice 214: upstream's RecursionId is ONE `any` value
                ; and two node identities with different nodes are unequal. Comparing
                ; the symbol and type slots alone made every node identity equal to every
                ; other (both nulls), so past ten levels the exploration stopped on a
                ; false "already on the stack" where the reference went on to depth 32
                ; (`excessivelyDeepConditionalTypes`).
                var same true
                if r.target_symbol <> id.target_symbol
                    set same: false
                if r.target_type <> id.target_type
                    set same: false
                if r.target_node <> id.target_node
                    set same: false
                if same
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; getConstraintOfTypeParameter and hasNonCircularBaseConstraint. The guard is
    ; the reference's and its comment says why the two are separate functions:
    ; *"This is a worker function. Use getConstraintOfTypeParameter which guards
    ; against circular constraints."*
    ;
    ; ★ A null base constraint — a STOP underneath — answers FALSE here, which is
    ; the conservative direction: the caller then treats the parameter as having no
    ; constraint and reports nothing, where inventing one would put a diagnostic
    ; into a unit whose walk is already known to be incomplete.
    procedure get_constraint_of_type_parameter(this, type_parameter: ref[Type]) returns ref[Type]?
    {
        if this.has_non_circular_base_constraint(type_parameter) = false
            return null
        this.get_constraint_from_type_parameter(type_parameter)
    }

    procedure has_non_circular_base_constraint(this, t: ref[Type]) returns bool
    {
        let c this.get_resolved_base_constraint(t)
        if c = null
            return false
        (c as ref[Type]) <> circular_constraint_type
    }

    ; ── slice 136: getConstraintOfType and the CONDITIONAL's two constraints ──
    ;
    ; ★★★ THE DISPATCHER WAS MISSING WHILE ONE OF ITS FOUR ARMS HAD BEEN PORTED
    ; SINCE SLICE 92. Every caller in the tree reached `getConstraintOfTypeParameter`
    ; directly, which is right for a type parameter and silently wrong for the other
    ; three inputs — an indexed access, a conditional and everything else answer
    ; through arms nothing here could ask for.
    procedure get_constraint_of_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsTypeParameter) <> 0
            return this.get_constraint_of_type_parameter(t)
        if (t.flags & TypeFlagsIndexedAccess) <> 0
            return this.get_constraint_of_indexed_access(t)
        if (t.flags & TypeFlagsConditional) <> 0
            return this.get_constraint_of_conditional_type(t)
        this.get_base_constraint_of_type(t)
    }

    ; getConstraintOfIndexedAccess and getConstraintFromIndexedAccess, whole —
    ; the mapped-generic arm is substitute_indexed_mapped_type since slice 202.
    procedure get_constraint_of_indexed_access(this, t: ref[Type]) returns ref[Type]?
    {
        if this.has_non_circular_base_constraint(t) = false
            return null
        this.get_constraint_from_indexed_access(t)
    }

    procedure get_constraint_from_indexed_access(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let object_type Checker.indexed_access_object_type_of(t)
        let index_type Checker.indexed_access_index_type_of(t)
        if object_type = null
            return null
        if index_type = null
            return null
        let ot object_type as ref[Type]
        let it index_type as ref[Type]
        if this.is_mapped_type_generic_indexed_access(t)
            return this.substitute_indexed_mapped_type(ot, it)
        let access_flags Checker.indexed_access_flags_of(t)
        let index_constraint this.get_simplified_type_or_constraint(it)
        if this.unported_mark() <> mark
            return null
        if index_constraint <> null
        {
            if (index_constraint as ref[Type]) <> it
            {
                let indexed_access this.get_indexed_access_type_or_undefined(ot, index_constraint as ref[Type], access_flags, null, null)
                if this.unported_mark() <> mark
                    return null
                if indexed_access <> null
                    return indexed_access
            }
        }
        let object_constraint this.get_simplified_type_or_constraint(ot)
        if this.unported_mark() <> mark
            return null
        if object_constraint <> null
        {
            if (object_constraint as ref[Type]) <> ot
                return this.get_indexed_access_type_or_undefined(object_constraint as ref[Type], it, access_flags, null, null)
        }
        null
    }

    ; getSimplifiedTypeOrConstraint. ★It is the one caller of getSimplifiedType
    ; whose fall-through is the constraint rather than the type, which is what makes
    ; the pair mutually recursive: an indexed access's constraint asks its index's
    ; simplification, and a failure to simplify asks that index's constraint.
    procedure get_simplified_type_or_constraint(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let simplified this.get_simplified_type(t, false)
        if this.unported_mark() <> mark
            return null
        if simplified <> null
        {
            if (simplified as ref[Type]) <> t
                return simplified
        }
        this.get_constraint_of_type(t)
    }

    ; isMappedTypeGenericIndexedAccess — the guard in front of the arm above,
    ; written whole so the report names a shape and not a function.
    procedure is_mapped_type_generic_indexed_access(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsIndexedAccess) = 0
            return false
        let object_type Checker.indexed_access_object_type_of(t)
        let index_type Checker.indexed_access_index_type_of(t)
        if object_type = null
            return false
        if index_type = null
            return false
        let ot object_type as ref[Type]
        if (ot.object_flags & ObjectFlagsMapped) = 0
            return false
        if this.is_generic_mapped_type(ot)
            return false
        if this.is_generic_index_type(index_type as ref[Type]) = false
            return false
        if (Checker.get_mapped_type_modifiers(ot) & MappedTypeModifiersExcludeOptional) <> 0
            return false
        let decl Checker.mapped_declaration_of(ot)
        if decl = null
            return false
        AstNode.mapped_type_name_type_of(decl as ref[AstNode]) = null
    }

    ; substituteIndexedMappedType — *"Given an indexed access on a mapped type of
    ; the form { [P in K]: E }[X], return an instantiation of E where P is replaced
    ; with X. Since this simplification doesn't account for mapped type modifiers,
    ; add 'undefined' to the resulting type if the mapped type includes a '?'
    ; modifier or if the modifiers type indicates that some properties are
    ; optional. If the modifiers type is generic, conservatively estimate
    ; optionality by recursively looking for mapped types that include '?'
    ; modifiers."*
    ;
    ; ★★ THE OPTIONALITY FORK IS A CONSERVATIVE/EXACT PAIR and the test between
    ; them is `isGenericType(objectType)`: a GENERIC mapped type is estimated by
    ; walking its modifiers type, a concrete one is decided exactly by asking
    ; whether any property the index can name is optional. Taking either half
    ; alone is a wrong answer rather than a coarse one, in opposite directions.
    ;
    ; ★ `core.OrElse(target, objectType)` — the template comes from the mapped
    ; type's TARGET when it has one (an instantiated mapped type keeps the
    ; original there) and from the type itself otherwise.
    procedure substitute_indexed_mapped_type(this, object_type: ref[Type], index: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let tp this.get_type_parameter_from_mapped_type(object_type)
        if this.unported_mark() <> mark
            return null
        let mapper this.new_simple_type_mapper(tp, index)
        let template_mapper this.combine_type_mappers(Checker.mapper_of(object_type), mapper)
        var template_source object_type
        let tgt Checker.target_of(object_type)
        if tgt <> null
            set template_source: tgt as ref[Type]
        let template this.get_template_type_from_mapped_type(template_source)
        if this.unported_mark() <> mark
            return null
        let instantiated this.instantiate_type(template, template_mapper)
        if this.unported_mark() <> mark
            return null
        if instantiated = null
            return null
        var is_optional false
        if this.get_mapped_type_optionality(object_type) > 0
            set is_optional: true
        if is_optional = false
        {
            if this.is_generic_type(object_type)
            {
                let modifiers this.get_modifiers_type_from_mapped_type(object_type)
                if this.unported_mark() <> mark
                    return null
                if modifiers <> null
                {
                    if this.get_combined_mapped_type_optionality(modifiers as ref[Type]) > 0
                        set is_optional: true
                }
            }
            else
            {
                if this.could_access_optional_property(object_type, index)
                    set is_optional: true
                if this.unported_mark() <> mark
                    return null
            }
        }
        this.add_optionality_ex(instantiated as ref[Type], true, is_optional)
    }

    ; getMappedTypeOptionality — -1, 0 or 1 for stripped, unchanged and added.
    ; ★It is a FREE function upstream and reads only the modifiers, but this port
    ; spells it as a method because its recursive twin below needs `this`.
    function get_mapped_type_optionality(this, t: ref[Type]) returns int
    {
        let modifiers Checker.get_mapped_type_modifiers(t)
        if (modifiers & MappedTypeModifiersExcludeOptional) <> 0
            return 0 - 1
        if (modifiers & MappedTypeModifiersIncludeOptional) <> 0
            return 1
        0
    }

    ; getCombinedMappedTypeOptionality — *"When a homomorphic mapped type doesn't
    ; modify optionality, recursively consult the optionality of the type being
    ; mapped over to see if it strips or adds optionality. For intersections,
    ; return -1 or 1 when all constituents strip or add optionality, otherwise
    ; return 0."*
    procedure get_combined_mapped_type_optionality(this, t: ref[Type]) returns int
    {
        if (t.object_flags & ObjectFlagsMapped) <> 0
        {
            let optionality this.get_mapped_type_optionality(t)
            if optionality <> 0
                return optionality
            let modifiers this.get_modifiers_type_from_mapped_type(t)
            if modifiers = null
                return 0
            return this.get_combined_mapped_type_optionality(modifiers as ref[Type])
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(t)
            if types = null
                return 0
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            if n = 0
                return 0
            let head list[0]
            if head = null
                return 0
            let optionality this.get_combined_mapped_type_optionality(head as ref[Type])
            var i 1
            while i < n
            {
                let row list[i]
                if row = null
                    return 0
                if this.get_combined_mapped_type_optionality(row as ref[Type]) <> optionality
                    return 0
                set i: i + 1
            }
            return optionality
        }
        0
    }

    ; couldAccessOptionalProperty — the EXACT half of the fork above: is there a
    ; property of the object type that is optional AND whose literal name the index
    ; constraint admits.
    procedure could_access_optional_property(this, object_type: ref[Type], index_type: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        let index_constraint this.get_base_constraint_of_type(index_type)
        if this.unported_mark() <> mark
            return false
        if index_constraint = null
            return false
        let ic index_constraint as ref[Type]
        let props this.get_properties_of_type(object_type)
        if this.unported_mark() <> mark
            return false
        if props = null
            return false
        let list props as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let p row as ref[Symbol]
                if (Symbol.flags_of(p) & SymbolFlagsOptional) <> 0
                {
                    let literal this.get_literal_type_from_property(p, TypeFlagsStringOrNumberLiteralOrUnique, false)
                    if this.unported_mark() <> mark
                        return false
                    if literal <> null
                    {
                        if this.is_type_assignable_to(literal as ref[Type], ic)
                            return true
                        if this.unported_mark() <> mark
                            return false
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    ; getConstraintOfConditionalType, getConstraintFromConditionalType and the two
    ; constraints a conditional has.
    ;
    ; ★★★ THE PAIR IS AN ORDER, NOT A CHOICE: the DISTRIBUTIVE constraint is asked
    ; first and the DEFAULT one is the fallback, so `T extends undefined ? never : T`
    ; answers the union with `undefined` removed rather than the union of the two
    ; branches — which is the whole point of the distributive kludge the reference's
    ; own comment apologises for.
    procedure get_constraint_of_conditional_type(this, t: ref[Type]) returns ref[Type]?
    {
        if this.has_non_circular_base_constraint(t) = false
            return null
        this.get_constraint_from_conditional_type(t)
    }

    procedure get_constraint_from_conditional_type(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let distributive this.get_constraint_of_distributive_conditional_type(t)
        if this.unported_mark() <> mark
            return null
        if distributive <> null
            return distributive
        this.get_default_constraint_of_conditional_type(t)
    }

    ; getDefaultConstraintOfConditionalType. ★★The `any` ELISION is the reference's
    ; own comment and it is not a tidy-up: without it *"a conditional type with a
    ; single branch of type `any` would be assignable to anything"*, so an `any`
    ; branch is treated like `never` here and not like `unknown`.
    procedure get_default_constraint_of_conditional_type(this, t: ref[Type]) returns ref[Type]?
    {
        let existing Checker.conditional_default_constraint_of(t)
        if existing <> null
            return existing
        let mark this.unported_mark()
        let true_constraint this.get_inferred_true_type_from_conditional_type(t)
        if this.unported_mark() <> mark
            return null
        if true_constraint = null
            return null
        let false_constraint this.get_false_type_from_conditional_type(t)
        if this.unported_mark() <> mark
            return null
        if false_constraint = null
            return null
        let tc true_constraint as ref[Type]
        let fc false_constraint as ref[Type]
        var answer: ref[Type]? null
        if Checker.is_type_any(tc)
            set answer: false_constraint
        else
        {
            if Checker.is_type_any(fc)
                set answer: true_constraint
            else
            {
                set answer: this.get_union_type_pair(tc, fc)
                if this.unported_mark() <> mark
                    return null
            }
        }
        if answer = null
            return null
        Checker.set_conditional_default_constraint(t, answer)
        answer
    }

    ; getInferredTrueTypeFromConditionalType — the true branch instantiated with the
    ; COMBINED mapper where there is one, which is the inference context's answer for
    ; an `infer T` in the extends position.
    procedure get_inferred_true_type_from_conditional_type(this, t: ref[Type]) returns ref[Type]?
    {
        let existing Checker.conditional_inferred_true_type_of(t)
        if existing <> null
            return existing
        let combined Checker.conditional_combined_mapper_of(t)
        if combined = null
        {
            let plain this.get_true_type_from_conditional_type(t)
            if plain = null
                return null
            Checker.set_conditional_inferred_true_type(t, plain)
            return plain
        }
        let mark this.unported_mark()
        let root Checker.conditional_root_of(t)
        if root = null
            return null
        let tn AstNode.conditional_type_true_of((root as ref[ConditionalRoot]).node)
        if tn = null
            return null
        let written this.get_type_from_type_node(tn as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if written = null
            return null
        let inst this.instantiate_type(written as ref[Type], combined)
        if this.unported_mark() <> mark
            return null
        if inst = null
            return null
        Checker.set_conditional_inferred_true_type(t, inst)
        inst
    }

    ; getConstraintOfDistributiveConditionalType.
    ;
    ; ★★★ `noConstraintType` IS THE THIRD STATE AND IT IS LOAD-BEARING. The memo
    ; means three things — *not asked* (null), *asked, no constraint*
    ; (noConstraintType) and *asked, here it is* — and collapsing the middle one
    ; into null would recompute a distributive constraint on every ask, which is a
    ; conditional-type instantiation each time.
    ;
    ; ★ The RESTRICTIVE-INSTANTIATION guard is the reference's own and its comment
    ; says why: for such an instantiation every type parameter has been replaced with
    ; `unknown`, so a distributive constraint there *"is going to produce even more
    ; false positive/negative results than the distribute constraint already does"*.
    procedure get_constraint_of_distributive_conditional_type(this, t: ref[Type]) returns ref[Type]?
    {
        let existing Checker.conditional_distributive_constraint_of(t)
        if existing <> null
        {
            if (existing as ref[Type]) = no_constraint_type
                return null
            return existing
        }
        let mark this.unported_mark()
        let root Checker.conditional_root_of(t)
        if root = null
            return null
        let r root as ref[ConditionalRoot]
        let check_type Checker.conditional_check_type_of(t)
        if check_type = null
            return null
        let ct check_type as ref[Type]
        var answer: ref[Type]? null
        ; ★★★ THE SECOND HALF OF THE GUARD IS A BRANCH SINCE SLICE 151, AND THE
        ; NOTE THAT STOOD HERE NAMED THE DAY: it said the disjunct was constant TRUE
        ; because *"getRestrictiveInstantiation has no port, so nothing ever writes
        ; that row"*, and closed with *"the day the restrictive instantiation lands,
        ; this is the line that has to move with it"*. It landed in this slice and
        ; the line moved in the same commit — a closed constant reads exactly like an
        ; open one, which is why it is not left standing.
        ;
        ; ★ `c.cachedTypes[{RestrictiveInstantiation, t.id}] != t` asks whether THIS
        ; type IS its own restrictive instantiation, i.e. whether it is itself a
        ; restrictive instance — and get_restrictive_instantiation's second write is
        ; the only thing that ever makes the answer yes.
        var not_restrictive_instance true
        {
            let row this.find_instantiation_cache_link(t)
            if row <> null
            {
                let cached (row as ref[InstantiationCacheLink]).restrictive
                if cached <> null
                {
                    if (cached as ref[Type]) = t
                        set not_restrictive_instance: false
                }
            }
        }
        if r.is_distributive and not_restrictive_instance
        {
            {
                let simplified this.get_simplified_type(ct, false)
                if this.unported_mark() <> mark
                    return null
                if simplified = null
                    return null
                var constraint simplified
                if (simplified as ref[Type]) = ct
                {
                    set constraint: this.get_constraint_of_type(ct)
                    if this.unported_mark() <> mark
                        return null
                }
                if constraint <> null
                {
                    if (constraint as ref[Type]) <> ct
                    {
                        let mapper this.prepend_type_mapping(r.check_type, constraint as ref[Type], Checker.conditional_mapper_of(t))
                        let instantiated this.get_conditional_type_instantiation(t, mapper, true, null)
                        if this.unported_mark() <> mark
                            return null
                        if instantiated <> null
                        {
                            if ((instantiated as ref[Type]).flags & TypeFlagsNever) = 0
                                set answer: instantiated
                        }
                    }
                }
            }
        }
        if answer = null
        {
            Checker.set_conditional_distributive_constraint(t, no_constraint_type)
            return null
        }
        Checker.set_conditional_distributive_constraint(t, answer)
        answer
    }

    ; getConstraintFromTypeParameter, whole but for the `tp.target` path, which is
    ; the INSTANTIATED type parameter's: it needs instantiateType and a `target`
    ; slot TypeParameterTypeData does not carry, and nothing here instantiates
    ; anything, so the else branch is the whole function.
    ;
    ; ★★ THE `any` REWRITE IS TWO ANSWERS AND ONLY ONE OF THEM IS REACHABLE. The
    ; reference replaces an `any` constraint that is not the error type with
    ; stringNumberSymbolType for a MAPPED type's key and with unknown otherwise —
    ; and the first is a union this port cannot make, so that arm reports while
    ; `<T extends any>` answers unknown. ★The condition reads
    ; `constraintDeclaration.Parent.Parent`, i.e. the constraint node's
    ; grandparent, because the parent is the type-parameter declaration itself.
    ;
    ; ★ The memo is written only when the answer is COMPLETE: a stop underneath
    ; returns without touching `constraint`, so the next ask recomputes rather than
    ; reading a half-answer back.
    procedure get_constraint_from_type_parameter(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsTypeParameter) = 0
            return null
        if Checker.type_parameter_constraint_of(t) = null
        {
            var constraint: ref[Type]? null
            ; ★★★ THE `target` BRANCH IS SLICE 125'S AND IT IS THE FIRST ONE
            ; UPSTREAM. A cloned type parameter — instantiate_anonymous_type's
            ; fresh `P` — has no DECLARATION of its own to read a constraint off;
            ; its constraint is the original's, instantiated through the mapper the
            ; clone was given. Left out, every homomorphic mapped type answers
            ; *unconstrained* for the parameter its whole meaning turns on.
            let clone_target Checker.type_parameter_target_of(t)
            if clone_target <> null
            {
                let mark this.unported_mark()
                let inner this.get_constraint_of_type_parameter(clone_target as ref[Type])
                if this.unported_mark() <> mark
                    return null
                let instantiated this.instantiate_type(inner, Checker.type_parameter_mapper_of(t))
                if this.unported_mark() <> mark
                    return null
                if instantiated = null
                    Checker.set_type_parameter_constraint(t, no_constraint_type)
                if instantiated <> null
                    Checker.set_type_parameter_constraint(t, instantiated as ref[Type])
                let cur0 Checker.type_parameter_constraint_of(t)
                if cur0 = null
                    return null
                if (cur0 as ref[Type]) = no_constraint_type
                    return null
                return cur0
            }
            let decl this.get_constraint_declaration(t)
            if decl = null
                set constraint: this.get_inferred_type_parameter_constraint(t)
            else
            {
                let dn decl as ref[AstNode]
                let ct this.get_type_from_type_node(dn)
                if ct = null
                    return null
                set constraint: ct
                let c ct as ref[Type]
                if (c.flags & TypeFlagsAny) <> 0
                {
                    if this.is_error_type(c) = false
                    {
                        var mapped false
                        let gp AstNode.parent_node_of(dn)
                        if gp <> null
                        {
                            let ggp AstNode.parent_node_of(gp as ref[AstNode])
                            if ggp <> null
                            {
                                if AstNode.kind_of(ggp as ref[AstNode]) = KindMappedType
                                    set mapped: true
                            }
                        }
                        ; ★ Slice 125 fills the mapped arm: the reference answers
                        ; `stringNumberSymbolType` there, which this checker mints
                        ; at startup — the stop that stood here named a type it
                        ; already had.
                        if mapped
                        {
                            if string_number_symbol_type = null
                            {
                                this.record_unported("string-number-symbol-type-unminted", c.flags)
                                return null
                            }
                            set constraint: string_number_symbol_type
                        }
                        if mapped = false
                            set constraint: unknown_type
                    }
                }
            }
            if constraint = null
                set constraint: no_constraint_type
            Checker.set_type_parameter_constraint(t, constraint as ref[Type])
        }
        let cur Checker.type_parameter_constraint_of(t)
        if cur = null
            return null
        if (cur as ref[Type]) = no_constraint_type
            return null
        cur
    }

    ; getConstraintDeclaration, whole: the FIRST declaration of the symbol that is
    ; a type parameter AND carries a constraint.
    function get_constraint_declaration(this, t: ref[Type]) returns ref[AstNode]?
    {
        if t.symbol = null
            return null
        let sym t.symbol as ref[Symbol]
        let n Symbol.declaration_count(sym)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(sym, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                if AstNode.kind_of(dn) = KindTypeParameter
                {
                    let c AstNode.type_parameter_constraint_of(dn)
                    if c <> null
                        return c
                }
            }
            set i: i + 1
        }
        null
    }

    ; The same walk over the DEFAULT slot. The reference writes it inline as a
    ; `core.FirstNonNil` inside getResolvedTypeParameterDefault while giving the
    ; constraint one its own function; the two are the same question about two
    ; slots, and one of them additionally tests the declaration's KIND — which the
    ; inline version gets from FirstNonNil's callback returning nil.
    function get_default_declaration(this, t: ref[Type]) returns ref[AstNode]?
    {
        if t.symbol = null
            return null
        let sym t.symbol as ref[Symbol]
        let n Symbol.declaration_count(sym)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(sym, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                if AstNode.kind_of(dn) = KindTypeParameter
                {
                    let c AstNode.type_parameter_default_of(dn)
                    if c <> null
                        return c
                }
            }
            set i: i + 1
        }
        null
    }

    ; getInferredTypeParameterConstraint, WHOLE (slice 136).
    ;
    ; ★★★ THE NOTE THAT STOOD HERE WAS A LIST OF DIMENSIONS THAT HAD ALL LANDED.
    ; It read: *"the five inference arms behind the guard need getIntersectionType,
    ; stringNumberSymbolType, createArrayType, getTypeParametersForTypeReferenceOr
    ; Import and instantiateType — four dimensions between them — so the guard is
    ; where the stop goes and the arms are not written at all."* The intersection
    ; arrived in slice 121, stringNumberSymbolType with it, the instantiation in 125,
    ; and getTypeParametersForTypeReferenceOrImport has been beside this function all
    ; along. Nothing re-read the sentence and the stop was 20 units at stage 1.
    ;
    ; ★★★ WHAT `infer T` MEANS IS THE WHOLE FUNCTION: an `infer` type parameter has
    ; no constraint of its own, so its constraint is INFERRED from the POSITION it
    ; stands in. `Foo<infer T>` takes it from Foo's own parameter; a rest position
    ; makes it `unknown[]`; a template-literal span makes it `string`; a mapped
    ; type's key makes it `string | number | symbol`. Several declarations of one
    ; `infer T` intersect.
    ;
    ; ★★★ `omitTypeReferences` IS WRITTEN NOW, and the note that said it need not
    ; be — *the reference's second parameter, and its only caller passes false* —
    ; expired the moment the printer's InferTypeNode arm landed: that caller passes
    ; TRUE, and what the flag turns off is the TYPE-REFERENCE arm, so an `infer T`
    ; inside `Foo<infer T>` does not take Foo's parameter's constraint. The pair is
    ; a wrapper plus the flagged worker, this file's spelling for a default
    ; argument everywhere else.
    procedure get_inferred_type_parameter_constraint(this, t: ref[Type]) returns ref[Type]?
        this.get_inferred_type_parameter_constraint_ex(t, false)

    procedure get_inferred_type_parameter_constraint_ex(this, t: ref[Type], omit_type_references: bool) returns ref[Type]?
    {
        if t.symbol = null
            return null
        let mark this.unported_mark()
        let sym t.symbol as ref[Symbol]
        var inferences: ref[Array[ref[Type]?]]? null
        let n Symbol.declaration_count(sym)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(sym, i)
            set i: i + 1
            if d = null
                continue
            let decl d as ref[AstNode]
            let dp AstNode.parent_node_of(decl)
            if dp = null
                continue
            if AstNode.kind_of(dp as ref[AstNode]) <> KindInferType
                continue
            ; "When an 'infer T' declaration is immediately contained in a type
            ; reference node (such as 'Foo<infer T>'), T's constraint is inferred
            ; from the constraint of the corresponding type parameter in 'Foo'. When
            ; multiple 'infer T' declarations are present, we form an intersection of
            ; the inferred constraint types."
            var child dp as ref[AstNode]
            var parent_opt AstNode.parent_node_of(child)
            while parent_opt <> null
            {
                if AstNode.kind_of(parent_opt as ref[AstNode]) <> KindParenthesizedType
                    break
                set child: parent_opt as ref[AstNode]
                set parent_opt: AstNode.parent_node_of(child)
            }
            if parent_opt = null
                continue
            let parent parent_opt as ref[AstNode]
            let pk AstNode.kind_of(parent)
            var inferred: ref[Type]? null
            ; `case IsTypeReferenceNode(parent) && !omitTypeReferences:` — the
            ; printer is the caller that turns this arm off.
            var reference_arm false
            if pk = KindTypeReference
            {
                if omit_type_references = false
                    set reference_arm: true
            }
            if reference_arm
            {
                let type_parameters this.get_type_parameters_for_type_reference_or_import(parent)
                if this.unported_mark() <> mark
                    return null
                if type_parameters <> null
                {
                    let tps type_parameters as ref[Array[ref[Type]?]]
                    let index Checker.index_in_list(AstNode.type_arguments_of(parent), child)
                    if index >= 0
                    {
                        if index < (tps.get_length() as int)
                        {
                            let slot tps[index]
                            if slot <> null
                            {
                                let declared_constraint this.get_constraint_of_type_parameter(slot as ref[Type])
                                if this.unported_mark() <> mark
                                    return null
                                if declared_constraint <> null
                                {
                                    ; "Type parameter constraints can reference other
                                    ; type parameters so constraints need to be
                                    ; instantiated. If instantiation produces the type
                                    ; parameter itself, we discard that inference. For
                                    ; example, in
                                    ;   type Foo<T extends string, U extends T> = [T, U];
                                    ;   type Bar<T> = T extends Foo<infer X, infer X> ? Foo<X, X> : T;
                                    ; the instantiated constraint for U is X, so we
                                    ; discard that inference."
                                    let mapper this.new_deferred_type_mapper(tps, parent)
                                    let instantiated this.instantiate_type(declared_constraint as ref[Type], mapper as ref[TypeMapper]?)
                                    if this.unported_mark() <> mark
                                        return null
                                    if instantiated <> null
                                    {
                                        if (instantiated as ref[Type]) <> t
                                            set inferred: instantiated
                                    }
                                }
                            }
                        }
                    }
                }
            }
            else
            {
                ; The REST arm — three spellings of the same position, and each
                ; denotes `unknown[]`.
                var is_rest false
                if pk = KindParameter
                {
                    if AstNode.dot_dot_dot_token_of(parent) <> null
                        set is_rest: true
                }
                if pk = KindRestType
                    set is_rest: true
                if pk = KindNamedTupleMember
                {
                    if AstNode.dot_dot_dot_token_of(parent) <> null
                        set is_rest: true
                }
                if is_rest
                {
                    set inferred: this.create_array_type(unknown_type)
                    if this.unported_mark() <> mark
                        return null
                }
                else
                {
                    if pk = KindTemplateLiteralTypeSpan
                        set inferred: string_type
                    else
                    {
                        ; A type parameter DECLARATION whose own parent is a mapped
                        ; type — the `[P in K]` position — is constrained to the three
                        ; key types.
                        var is_mapped_key false
                        if pk = KindTypeParameter
                        {
                            let gp AstNode.parent_node_of(parent)
                            if gp <> null
                            {
                                if AstNode.kind_of(gp as ref[AstNode]) = KindMappedType
                                    set is_mapped_key: true
                            }
                        }
                        if is_mapped_key
                            set inferred: string_number_symbol_type
                        else
                        {
                            ; ★★★ THE FIFTH ARM IS THE HOMOMORPHIC-MAPPED-TYPE ONE and
                            ; its guard is seven conjuncts deep: an `infer` inside a
                            ; mapped type that is itself the EXTENDS side of a
                            ; conditional whose CHECK side is another mapped type. What
                            ; it denotes is the check side's own template, instantiated
                            ; so that the check mapped type's key stands for this one's.
                            if pk = KindMappedType
                            {
                                let mapped_body AstNode.type_of(parent)
                                if mapped_body <> null
                                {
                                    if Checker.skip_type_parentheses(mapped_body) = dp
                                    {
                                        let gp AstNode.parent_node_of(parent)
                                        if gp <> null
                                        {
                                            let grand gp as ref[AstNode]
                                            if AstNode.kind_of(grand) = KindConditionalType
                                            {
                                                if AstNode.conditional_type_extends_of(grand) = parent
                                                {
                                                    let check_node AstNode.conditional_type_check_of(grand)
                                                    if check_node <> null
                                                    {
                                                        let cn check_node as ref[AstNode]
                                                        if AstNode.kind_of(cn) = KindMappedType
                                                        {
                                                            let check_body AstNode.type_of(cn)
                                                            if check_body <> null
                                                            {
                                                                set inferred: this.infer_constraint_from_check_mapped_type(cn, check_body as ref[AstNode])
                                                                if this.unported_mark() <> mark
                                                                    return null
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if inferred <> null
            {
                if inferences = null
                    set inferences: this.new_type_list(null) as ref[Array[ref[Type]?]]?
                (inferences as ref[Array[ref[Type]?]]).add(inferred)
            }
        }
        if inferences = null
            return null
        let list inferences as ref[Array[ref[Type]?]]
        if (list.get_length() as int) = 0
            return null
        this.get_intersection_type(list)
    }

    ; The body of the fifth arm above, lifted out for the s178 alloca-pool rule —
    ; a new check inside a function this large must be ONE statement calling a
    ; helper, and the arm needs four locals of its own.
    procedure infer_constraint_from_check_mapped_type(this, check_mapped_type: ref[AstNode], check_body: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let node_type this.get_type_from_type_node(check_body)
        if this.unported_mark() <> mark
            return null
        if node_type = null
            return null
        let tp_node AstNode.mapped_type_parameter_of(check_mapped_type)
        if tp_node = null
            return null
        let tpn tp_node as ref[AstNode]
        let sym this.get_symbol_of_declaration(tpn)
        if this.unported_mark() <> mark
            return null
        if sym = null
            return null
        let source this.get_declared_type_of_type_parameter(sym as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        if source = null
            return null
        ; `core.IfElse(constraint != nil, getTypeFromTypeNode(constraint), stringNumberSymbolType)`
        var target: ref[Type]? string_number_symbol_type
        let constraint_node AstNode.type_parameter_constraint_of(tpn)
        if constraint_node <> null
        {
            set target: this.get_type_from_type_node(constraint_node as ref[AstNode])
            if this.unported_mark() <> mark
                return null
        }
        if target = null
            return null
        let mapper this.new_simple_type_mapper(source, target)
        this.instantiate_type(node_type as ref[Type], mapper as ref[TypeMapper]?)
    }

    ; getEffectiveTypeArgumentAtIndex — the i-th WRITTEN type argument, or the i-th
    ; of the effective list once the defaults have been filled in.
    procedure get_effective_type_argument_at_index(this, node: ref[AstNode], type_parameters: ref[Array[ref[Type]?]], index: int) returns ref[Type]?
    {
        let written AstNode.type_arguments_of(node)
        if index < AstNode.list_count(written)
            return this.get_type_from_type_node(AstNode.child_in_list(written, index) as ref[AstNode])
        let effective this.get_effective_type_arguments(node, type_parameters)
        if effective = null
            return null
        let list effective as ref[Array[ref[Type]?]]
        if index < 0
            return null
        if index >= (list.get_length() as int)
            return null
        list[index]
    }

    ; isErrorType. ★★★ THE SECOND DISJUNCT IS WRITTEN IN SLICE 114 AND THE NOTE
    ; THAT STOOD HERE NAMED ITS OWN EXPIRY: it said `alias` is *"not a slot this
    ; port carries"* and that *"every type that would carry one comes out of a
    ; function that stops"*. Both halves fell the same afternoon —
    ; getTypeFromTypeAliasReference's CheckFlagsUnresolved arm manufactures exactly
    ; those types now.
    ;
    ; ★★★ AND IT IS NOT A COSMETIC WIDENING. The reference's own comment is the
    ; whole design: *"we want those to behave like the errorType"* — so an
    ; alias-carrying `any` must be REFUSED by the 49 sites that ask this question,
    ; and the first one to be measured was the property access, where the isAnyLike
    ; branch answers `apparentType` unless this predicate says otherwise. Without
    ; it `x.id` on an unresolved `Request` came out as `Request` and not as `any` —
    ; a well-formed wrong answer three stage-2 units deep.
    function is_error_type(this, t: ref[Type]) returns bool
    {
        if t = error_type
            return true
        if (t.flags & TypeFlagsAny) = 0
            return false
        t.alias_symbol <> null
    }

    ; getDefaultFromTypeParameter, whole — the same two-sentinel filter
    ; getBaseConstraintOfType applies, over the other slot.
    procedure get_default_from_type_parameter(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsTypeParameter) = 0
            return null
        let d this.get_resolved_type_parameter_default(t)
        if d = null
            return null
        let dt d as ref[Type]
        if dt = no_constraint_type
            return null
        if dt = circular_constraint_type
            return null
        dt
    }

    ; getResolvedTypeParameterDefault, whole but for the `target` path (see
    ; getConstraintFromTypeParameter's note — it is the same instantiated type
    ; parameter).
    ;
    ; ★★★ THE CIRCULARITY HERE IS NOT DETECTED BY THE RESOLUTION STACK, IT IS
    ; DETECTED BY THE SLOT ITSELF, and that is worth reading twice next to
    ; getResolvedBaseConstraint above: this function writes resolvingDefaultType
    ; INTO the memo before computing, so a recursive ask finds the marker there and
    ; overwrites it with circularConstraintType; the outer ask then tests whether
    ; the slot STILL holds the marker before storing the real answer. Two
    ; mechanisms for one job, both the reference's, and the reason they differ is
    ; that only the constraint's needs to report at a specific NODE.
    ;
    ; ★★ THE ONE PLACE THIS PORT MUST ADD A LINE THE REFERENCE HAS NO NEED FOR: a
    ; stop underneath (get_type_from_type_node on the default's type node) leaves
    ; the marker sitting in the memo, and a LATER ask would then read it as a
    ; recursive entry and report a circular default that the reference does not —
    ; an INVENTED diagnostic, the one direction diagcheck catches. So the marker is
    ; cleared on that path and the function answers null, which is "as if never
    ; called".
    procedure get_resolved_type_parameter_default(this, t: ref[Type]) returns ref[Type]?
    {
        let existing Checker.resolved_default_type_of(t)
        if existing = null
        {
            ; ★★★ THE `target` PATH, SLICE 141, AND IT WAS A SILENT WRONG ANSWER
            ; RATHER THAN A GAP. The note above said this function was ported
            ; *"whole but for the `target` path (see getConstraintFromTypeParameter's
            ; note — it is the same instantiated type parameter)"*, and the missing
            ; branch does not stop: an INSTANTIATED type parameter — one
            ; instantiate_signature cloned, carrying a target and a mapper — fell
            ; through to the declaration path and answered the TARGET'S OWN default,
            ; unmapped. Measured on `import("m").then(x => x)`: the port printed
            ; `<TResult1 = T, …>` and `Promise<T>` where the reference prints
            ; `TResult1 = any` and `Promise<any>`, because `Promise<any>.then`'s
            ; TResult1 defaults to `T` in the uninstantiated interface. Slice 141
            ; only made it VISIBLE — the unit was UNPORTED before the
            ; SkipContextSensitive early-out landed (§3.5er).
            let target Checker.type_parameter_target_of(t)
            if target <> null
            {
                let target_default this.get_resolved_type_parameter_default(target as ref[Type])
                if target_default = null
                {
                    Checker.set_resolved_default_type(t, no_constraint_type)
                    return no_constraint_type
                }
                let mapped this.instantiate_type(target_default as ref[Type], Checker.type_parameter_mapper_of(t))
                if mapped = null
                    return null
                Checker.set_resolved_default_type(t, mapped as ref[Type])
                return mapped
            }
            Checker.set_resolved_default_type(t, resolving_default_type)
            var default_type no_constraint_type
            if t.symbol <> null
            {
                let decl this.get_default_declaration(t)
                if decl <> null
                {
                    let dt this.get_type_from_type_node(decl as ref[AstNode])
                    if dt = null
                    {
                        Checker.set_resolved_default_type(t, null)
                        return null
                    }
                    set default_type: dt as ref[Type]
                }
            }
            ; "If we have not been called recursively, set the correct default type."
            let after Checker.resolved_default_type_of(t)
            if after <> null
            {
                if (after as ref[Type]) = resolving_default_type
                    Checker.set_resolved_default_type(t, default_type)
            }
        }
        else
        {
            ; "If we are called recursively for this type parameter, mark the
            ; default as circular."
            if (existing as ref[Type]) = resolving_default_type
                Checker.set_resolved_default_type(t, circular_constraint_type)
        }
        Checker.resolved_default_type_of(t)
    }

    ; The two compilerOptions this slice reads, as functions rather than fields:
    ; there is no options record yet, and a field would claim one exists. Each
    ; answers the DEFAULT, which is what the oracle's stub program sets (it passes
    ; SkipDefaultLibCheck and NoErrorTruncation and nothing else).
    ;
    ; ★★★ strictNullChecks WAS `false` HERE FROM SLICE 47 TO SLICE 52 AND THE
    ; DEFAULT IS `true` — corrected in slice 52, and the shape of the mistake is
    ; worth more than the line. The two options are read through DIFFERENT
    ; accessors and only one of them takes the family default:
    ; `c.strictNullChecks = GetStrictOptionValue(options.StrictNullChecks)`, whose
    ; body is `if value != TSUnknown { return value == TSTrue }; return
    ; options.Strict != TSFalse` — so an UNSET option answers TRUE, because Strict
    ; is unset too and the test is `!= TSFalse` rather than `== TSTrue`. Meanwhile
    ; `c.exactOptionalPropertyTypes = options.ExactOptionalPropertyTypes ==
    ; core.TSTrue` is a plain equality and DOES answer false. Reading "the harness
    ; sets no options" as "every option is off" is therefore wrong for the four
    ; strict-family options (strictNullChecks, strictFunctionTypes, noImplicitAny,
    ; strictBindCallApply) and right for the rest — a third reading of "unset", next
    ; to the two check_signature_declaration meets (a FALSE default that kills a
    ; branch, and a target default at its MAXIMUM that kills a `<` comparison).
    ;
    ; ★★★ IT WAS UNOBSERVABLE, WHICH IS WHY IT SURVIVED SIX SLICES, and the reason
    ; is worth writing down: its one reader is create_widening_type, and a wrong
    ; answer there does not produce a wrong TYPE — it produces two EXTRA types
    ; (a fresh widening intrinsic instead of the non-widening one returned
    ; unchanged), so the type COUNTER and every type ID after undefinedWideningType
    ; shift by two. The dump's T section prints `TypeToString(t)`, a NAME, and
    ; nothing in this suite compares an id or the counter. Correcting it leaves all
    ; five yardsticks byte-identical — which is the same fact from the other side,
    ; and is the checksum this correction carries instead of a gate.
    ; strictNullChecks: the program's option (slice 251). The yardsticks' oracle
    ; runs strict, so the default is true and the emit programs set it from
    ; their configuration (tscaly_dump's two checker_over sites)
    function strict_null_checks() returns bool
        checker_strict_null_checks

    procedure set_strict_null_checks(v: bool)
        set checker_strict_null_checks: v

    function exact_optional_property_types() returns bool
        checker_exact_optional_property_types

    procedure set_exact_optional_property_types(v: bool)
        set checker_exact_optional_property_types: v

    ; ★★ SLICE 69 NEEDS THREE MORE, and they split along exactly the line
    ; strict_null_checks' header draws. noImplicitAny and useUnknownInCatch
    ; Variables are strict-FAMILY options read through GetStrictOptionValue, so an
    ; unset value falls through to `Strict != TSFalse` and both answer TRUE — which
    ; is what makes this slice produce diagnostics at all. checkJs is a plain
    ; equality against TSTrue and answers FALSE, which is why a JavaScript file
    ; without `// @ts-check` gets none of them.
    ;
    ; ★ check_signature_declaration's header already stated noImplicitAny's value
    ; and called the two arms behind it *"live code behind a live option"*; this is
    ; the slice that reads it.
    function no_implicit_any() returns bool
        checker_no_implicit_any

    function use_unknown_in_catch_variables() returns bool
        checker_use_unknown_in_catch_variables

    function check_js() returns bool
        checker_check_js

    function strict_bind_call_apply() returns bool
        checker_strict_bind_call_apply

    function check_js_is_unset() returns bool
        checker_check_js_unset

    ; the program's options into the checker (slice 263)
    procedure set_options(no_implicit_any: bool, no_implicit_this: bool, use_unknown_in_catch_variables: bool, strict_property_initialization: bool, strict_function_types: bool, strict_bind_call_apply: bool, strict_builtin_iterator_return: bool, check_js: int, no_implicit_returns: bool, no_unchecked_indexed_access: bool, no_property_access_from_index_signature: bool)
    {
        set checker_no_implicit_any: no_implicit_any
        set checker_no_implicit_this: no_implicit_this
        set checker_use_unknown_in_catch_variables: use_unknown_in_catch_variables
        set checker_strict_property_initialization: strict_property_initialization
        set checker_strict_function_types: strict_function_types
        set checker_strict_bind_call_apply: strict_bind_call_apply
        set checker_strict_builtin_iterator_return: strict_builtin_iterator_return
        set checker_check_js: check_js = 1
        set checker_check_js_unset: check_js = 2
        set checker_no_property_access_from_index_signature: no_property_access_from_index_signature
        set checker_no_implicit_returns: no_implicit_returns
        set checker_no_unchecked_indexed_access: no_unchecked_indexed_access
    }

    procedure set_no_emit(v: bool)
        set checker_no_emit: v

    procedure set_lib_option_has_dom(v: bool)
        set checker_lib_option_has_dom: v

    procedure set_resolution_options(allow_importing_ts_extensions: bool, allow_arbitrary_extensions: bool, rewrite_relative_import_extensions: bool, no_implicit_any_explicit: bool)
    {
        set checker_allow_importing_ts_extensions: allow_importing_ts_extensions
        set checker_allow_arbitrary_extensions: allow_arbitrary_extensions
        set checker_rewrite_relative_import_extensions: rewrite_relative_import_extensions
        set checker_no_implicit_any_explicit: no_implicit_any_explicit
    }

    ; noImplicitThis — the fourth strict-family option, TRUE for the same reason.
    function no_implicit_this() returns bool
        checker_no_implicit_this

    ; strictPropertyInitialization — the FIFTH, and slice 94's reader is
    ; checkPropertyInitialization. Same derivation as the four above: an unset
    ; strict-family option falls through to `Strict != TSFalse` and answers TRUE, so
    ; the function's whole guard turns on the node's Ambient flag alone.
    ;
    ; ★ It is why the row it gates was worth 296 units at stage 1 rather than none —
    ; the check that stood behind the union wall was LIVE the whole time, which is
    ; what the stop at its call site has said since slice 77.
    function strict_property_initialization() returns bool
        checker_strict_property_initialization

    ; ── slice 94: checkPropertyInitialization ────────────────────────────────
    ;
    ; ★★★ THE HEAD OF THE WORK LIST ON BOTH STAGES SINCE SLICE 77, AND WHAT HELD IT
    ; WAS ONE CALL. Slice 92 built the flow GRAPH and the row stayed; slice 93 built
    ; the WALK and the row stayed; the sentence that stood at the stop named the
    ; reason both times — *"what holds it is `getOptionalType(propType, false)`, the
    ; INITIAL type this caller passes"*. The union chapter above is that call, so
    ; the row is this slice's to close.
    ;
    ; ★★★ AND IT IS THE FIRST PLACE IN THIS PORT WHERE THE CHECKER MINTS AN AST
    ; NODE. isPropertyInitializedInConstructor does not FIND a reference to ask the
    ; flow walk about — there is none in the source — it BUILDS one: `this.p`,
    ; parented to the constructor and carrying the constructor's return flow node,
    ; and then asks what type that reference has where the constructor ends. Slice
    ; 93 predicted the consequence at its own line: *"a property access, an element
    ; access, a qualified name and a meta property cannot arrive [at
    ; isMatchingReference] until that row lands, and §3.5be says the day it lands is
    ; the day they are written"*. This is the day, and the property-access arm is
    ; written; the other three still have no producer.
    ;
    ; ★★ WHAT THE SYNTHETIC NODE OWES, and every slot is read by something: `kind`
    ; and the payload (isMatchingReference's arm and getAccessedPropertyName),
    ; `parent` on BOTH nodes (getControlFlowContainer walks up from the reference,
    ; and getFlowTypeOfReferenceEx's NonNullExpression test reads the parent), and
    ; `flow_node`. ★The NAME node is REUSED rather than copied — the reference
    ; passes `propName` straight into the factory and does not re-parent it either,
    ; so the name's parent stays the property declaration in both.
    ;
    ; ★ The reference's `pos` and `end` are the factory's synthetic -1/-1; here they
    ; are 0/0, because AstNode.alloc hands back raw region memory and every slot is
    ; written explicitly (parser.new_node's note). Nothing reads them: the only
    ; consumer is trace_flow, which is the FLOWPIN instrument, and it prints the
    ; reference's extent rather than comparing it.
    procedure new_synthetic_node(this, kind: int, data: NodeData) returns ref[AstNode]
    {
        set nodes_allocated: nodes_allocated + 1
        let n AstNode.alloc(host)
        set n.kind: kind as i16
        set n.flags: NodeFlagsNone
        set n.pos: 0
        set n.end: 0
        set n.data: data
        set n.parent: null
        set n.symbol: null
        set n.extras: null
        set n.subtree_facts: 0
        set n.link_ordinal: 0
        set n.flow_node: null
        n
    }

    ; ast.FindConstructorDeclaration. ★`NodeIsPresent(member.Body())` is the whole
    ; content of the test beside the kind: an OVERLOAD signature declares a
    ; constructor and initializes nothing, so a class whose only `constructor` has
    ; no body is a class with no constructor for this question.
    function find_constructor_declaration(node: ref[AstNode]) returns ref[AstNode]?
    {
        let members AstNode.member_list_of(node)
        if members = null
            return null
        let ms members as ref[Array[ref[AstNode]?]]
        let n ms.get_length() as int
        var i 0
        while i < n
        {
            let m ms[i]
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if AstNode.kind_of(member) = KindConstructor
            {
                if Binder.node_is_present(AstNode.body_of(member))
                    return member
            }
        }
        null
    }

    ; isPropertyWithoutInitializer.
    function is_property_without_initializer(this, node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindPropertyDeclaration
            return false
        if b.has_syntactic_modifier(node, ModifierFlagsAbstract)
            return false
        let postfix AstNode.postfix_token_of(node)
        if postfix <> null
        {
            if AstNode.kind_of(postfix as ref[AstNode]) = KindExclamationToken
                return false
        }
        AstNode.initializer_of(node) = null
    }

    ; checkPropertyInitialization.
    ;
    ; ★★ ITS GUARD IS `!strictNullChecks || !strictPropertyInitialization ||
    ; Ambient`, and BOTH options answer TRUE under this harness — they are
    ; strict-FAMILY options read through GetStrictOptionValue, so the function is
    ; LIVE. See strict_null_checks' header for the derivation, which is the one that
    ; surprises.
    ;
    ; ★ isPropertyInitializedInStaticBlocks is the sibling this does NOT need: the
    ; loop below skips every STATIC member, and that function's only caller is
    ; getTypeOfVariableOrParameterOrPropertyWorker's static branch.
    procedure check_property_initialization(this, node: ref[AstNode])
    {
        if Checker.strict_null_checks() = false
            return
        if Checker.strict_property_initialization() = false
            return
        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            return
        let constructor Checker.find_constructor_declaration(node)
        let members AstNode.member_list_of(node)
        if members = null
            return
        let ms members as ref[Array[ref[AstNode]?]]
        let count ms.get_length() as int
        var i 0
        while i < count
        {
            let m ms[i]
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if b.has_syntactic_modifier(member, ModifierFlagsAmbient)
                continue
            if b.is_static(member)
                continue
            if this.is_property_without_initializer(member) = false
                continue
            let pn AstNode.name_of(member)
            if pn = null
                continue
            let prop_name pn as ref[AstNode]
            let nk AstNode.kind_of(prop_name)
            var named false
            if nk = KindIdentifier
                set named: true
            if nk = KindPrivateIdentifier
                set named: true
            if nk = KindComputedPropertyName
                set named: true
            if named = false
                continue
            let sym this.symbol_of_declaration(member)
            if sym = null
                continue
            ; ★★★ THE MARK IS TAKEN PER MEMBER AND A STOP IS A `continue`, NOT A
            ; `return`, AND THE DIFFERENCE IS TWO DIAGNOSTICS ON THIS SLICE'S OWN
            ; FIXTURE. The reference's loop asks an independent question about every
            ; member, so a walk that stops on member A says nothing about member B —
            ; abandoning the class would silently trade an honest diagnostic for
            ; another member's unanswerable one. ★What must NOT be traded is the
            ; other direction: where the walk stops, `is_property_initialized_in_
            ; constructor` answers `false`, which is *not initialized* and would
            ; INVENT a TS2564. The mark is what separates the two, and it is the
            ; reason both calls below are bracketed by one rather than tested for
            ; null.
            let mark this.unported_mark()
            let t this.get_type_of_symbol(sym as ref[Symbol])
            if this.unported_mark() <> mark
                continue
            if t = null
                continue
            let ty t as ref[Type]
            if (ty.flags & TypeFlagsAnyOrUnknown) <> 0
                continue
            if Checker.contains_undefined_type(ty)
                continue
            var initialized false
            if constructor <> null
            {
                let ok this.is_property_initialized_in_constructor(prop_name, ty, constructor as ref[AstNode])
                if this.unported_mark() <> mark
                    continue
                set initialized: ok
            }
            if initialized = false
                this.error_on_node(prop_name, DiagProperty_0_has_no_initializer_and_is_not_definitely_assigned_in_the_constructor, this.declaration_name_to_string(prop_name))
        }
    }

    ; isPropertyInitializedInConstructor.
    ;
    ; ★★★ THE COMPUTED-NAME ARM IS WRITTEN IN SLICE 182 AND THE STOP'S REASON HAD
    ; EXPIRED. It read *matching an element access needs
    ; tryGetElementAccessExpressionName, … and a wrong `false` there would make a
    ; real assignment invisible to the walk* — the fork is whole since slice 154,
    ; whose own note calls the entity-name half the frontier's head at the time.
    ; The two arms differ in the NODE they synthesize and in nothing else.
    procedure is_property_initialized_in_constructor(this, prop_name: ref[AstNode], prop_type: ref[Type], constructor: ref[AstNode]) returns bool
    {
        let this_node this.new_synthetic_node(KindThisKeyword, NodeData.Token(TokenData()))
        var reference: ref[AstNode]? null
        if AstNode.kind_of(prop_name) = KindComputedPropertyName
        {
            let arg AstNode.expression_of(prop_name)
            if arg = null
                return false
            set reference: this.new_synthetic_node(KindElementAccessExpression, NodeData.ElementAccessExpression(ElementAccessData(this_node, null, arg as ref[AstNode])))
        }
        else
            set reference: this.new_synthetic_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(this_node, null, prop_name)))
        let rn reference as ref[AstNode]
        set this_node.parent: rn
        set rn.parent: constructor
        set rn.flow_node: AstNode.return_flow_node_of(constructor)
        let initial this.get_optional_type(prop_type, false)
        if initial = null
            return false
        let flow_type this.get_flow_type_of_reference_ex(rn, prop_type, initial, null, null)
        if flow_type = null
            return false
        Checker.contains_undefined_type(flow_type as ref[Type]) = false
    }

    ; ── the union type (slice 94) ───────────────────────────────────────────
    ;
    ; getUnionType / getUnionTypeEx / getUnionTypeWorker and everything they stand
    ; on: the ORDER a constituent list is kept in, the reduction, the interning, and
    ; getOptionalType on top. Slice 93 named this row and named it by a
    ; MEASUREMENT rather than by a histogram — *"nine of this slice's stops are
    ; doors into it"* — and the nine are one room: a branch label unions its
    ; antecedents, a loop label unions them again, getOptionalType unions with
    ; undefined, and so on.
    ;
    ; ★★★ THE ORDER IS THE PRODUCT, NOT THE SET. A union type here is a SORTED,
    ; DEDUPLICATED constituent list, sorted by CompareTypes, and TypeFlags' own
    ; generated header already said why that matters: *the numeric values of
    ; TypeFlags determine the order computed by the CompareTypes function and
    ; therefore the order of constituent types in union types* — so the table this
    ; port generates decides how `string | undefined` PRINTS. The sort is what
    ; makes the interning below a list comparison rather than a set comparison, and
    ; it is what makes `getOptionalType`'s `Types()[0] == undefinedType` test mean
    ; anything.
    ;
    ; ★★★ FOUR REDUCTION STEPS ARE UNREACHABLE HERE AND EACH IS A CONTAINMENT
    ; PROOF WITH A DIFFERENT WITNESS, which is worth more than four stops that
    ; never fire:
    ;   removeStringLiteralsMatchedByTemplateLiterals  — its guard needs
    ;       TemplateLiteral or StringMapping in `includes`, and no type of either
    ;       kind can be MADE here (getTypeFromTypeNode reports for both).
    ;   removeConstrainedTypeVariables — its guard needs
    ;       IncludesConstrainedTypeVariable, which add_type_to_union sets only for
    ;       an INTERSECTION type, and nothing mints one.
    ;   the namedUnions / origin block — see UnionTypeData's header: `includes`
    ;       never carries TypeFlagsUnion, because that bit comes from a
    ;       constituent's `alias` or `origin` and this port has neither.
    ;   the `!strictNullChecks` arm of add_type_to_union — the option is TRUE under
    ;       this harness (strict_null_checks' header has the derivation).
    ; Three of the four are written as GATES WITH REPORTS anyway, on this file's
    ; standing rule for an inert arm; the fourth is written as the reference's
    ; conditional with the option spelled as a constant, which is what
    ; create_widening_type does one chapter up.

    ; newUnionType. Four lines upstream and four here.
    procedure new_union_type(this, object_flags: int, types: ref[Array[ref[Type]?]], origin: ref[Type]?) returns ref[Type]
        this.new_type(TypeFlagsUnion, object_flags, null, TypeData.Union(box_node_data[UnionTypeData](host, UnionTypeData(types, origin))))

    ; UnionType.types and UnionType.origin, as questions about the union TAG —
    ; this file's payload-accessor idiom, and each answers null for an arm that is
    ; not Union where the reference's `AsUnionType()` would panic.
    function union_types_of(t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when d: Union
                return d.types
        null
    }

    ; ── EvolvingArrayType's two payload slots (slice 141) ────────────────────
    ;
    ; ★ Both WRITES go through §3.14's copy/mutate/write-back, because a `when`
    ; binding is a copy and the direct spelling is a silent wrong store. The reads
    ; answer null for a type that is not an evolving array, which is the shape
    ; every other payload reader in this file has.

    function evolving_array_element_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: EvolvingArray
                return d.element_type
        null
    }

    function evolving_array_final_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: EvolvingArray
                return d.final_array_type
        null
    }

    procedure set_evolving_array_element_type(t: ref[Type], v: ref[Type]?)
    {
        choose t.data
            when e: EvolvingArray
            {
                var d e
                set d.element_type: v
                set t.data: TypeData.EvolvingArray(d)
            }
    }

    procedure set_evolving_array_final_type(t: ref[Type], v: ref[Type]?)
    {
        choose t.data
            when e: EvolvingArray
            {
                var d e
                set d.final_array_type: v
                set t.data: TypeData.EvolvingArray(d)
            }
    }

    ; `t.AsInstantiationExpressionType().node`, and its §3.14 setter. ★The write
    ; happens one line after the type is minted, exactly as the evolving array's
    ; does, which is why the arm starts null rather than taking the node through
    ; new_object_type: that function's signature is the reference's.
    function instantiation_expression_node_of(t: ref[Type]) returns ref[AstNode]?
    {
        choose t.data
            when d: InstantiationExpression
                return d.node
        null
    }

    procedure set_instantiation_expression_node(t: ref[Type], v: ref[AstNode]?)
    {
        choose t.data
            when e: InstantiationExpression
            {
                var d e
                set d.node: v
                set t.data: TypeData.InstantiationExpression(d)
            }
    }

    function union_origin_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Union
                return d.origin
        null
    }

    ; ── the order ───────────────────────────────────────────────────────────

    ; getSortOrderFlags. The comment upstream is the whole content: an enum-like
    ; UNIT type sorts as if it were plain `enum`, so all of one enum's members land
    ; together and are then ordered by their symbols.
    function get_sort_order_flags(t: ref[Type]) returns int
    {
        if (t.flags & TypeFlagsEnumLike) <> 0
        {
            if (t.flags & TypeFlagsUnion) = 0
                return TypeFlagsEnum
        }
        t.flags
    }

    ; getTypeNameSymbol.
    ;
    ; ★★★ THE ALIAS ARM IS THE FIRST LINE UPSTREAM AND IT IS WRITTEN SINCE SLICE
    ; 135. The note that stood here said `Type.alias` is not carried; the slot has
    ; been on Type since slice 111 and an ENUM is a union carrying its own symbol
    ; as the alias, so this arm is what orders `E | F` by NAME rather than by the
    ; ids of four interleaved members.
    function get_type_name_symbol(t: ref[Type]) returns ref[Symbol]?
    {
        if t.alias_symbol <> null
            return t.alias_symbol
        if (t.flags & (TypeFlagsTypeParameter | TypeFlagsStringMapping)) <> 0
            return t.symbol
        if (t.object_flags & (ObjectFlagsClassOrInterface | ObjectFlagsReference)) <> 0
            return t.symbol
        null
    }

    ; compareTypeNames. ★It compares the NAMES with strings.Compare and does NOT go
    ; through compareSymbols — two different orders over the same pair, and the
    ; distinction is the reference's: a NAMED type is ordered by its name so that
    ; the printed union reads in name order, while an unnamed one falls through to
    ; the symbol's DECLARATION position below.
    ; ★ It became a METHOD in slice 135: the arm behind the name equality compares
    ; the two ALIAS TYPE ARGUMENT lists, and compare_type_lists is the receiver's.
    procedure compare_type_names(this, t1: ref[Type], t2: ref[Type]) returns int
    {
        let s1 Checker.get_type_name_symbol(t1)
        let s2 Checker.get_type_name_symbol(t2)
        if s1 = s2
        {
            ; "in the case of aliased types, by alias type arguments" — two
            ; instantiations of one alias are told apart by their arguments.
            if t1.alias_symbol <> null
                return this.compare_type_lists(t1.alias_type_arguments, t2.alias_type_arguments)
            return 0
        }
        if s1 = null
            return 1
        if s2 = null
            return 0 - 1
        let a s1 as ref[Symbol]
        let b s2 as ref[Symbol]
        Checker.compare_names(Symbol.name_of(a), Symbol.name_of(b))
    }

    ; compareTypeLists.
    procedure compare_type_lists(this, l1: ref[Array[ref[Type]?]]?, l2: ref[Array[ref[Type]?]]?) returns int
    {
        var n1 0
        if l1 <> null
            set n1: (l1 as ref[Array[ref[Type]?]]).get_length() as int
        var n2 0
        if l2 <> null
            set n2: (l2 as ref[Array[ref[Type]?]]).get_length() as int
        if n1 <> n2
            return n1 - n2
        if n1 = 0
            return 0
        let a l1 as ref[Array[ref[Type]?]]
        let b l2 as ref[Array[ref[Type]?]]
        var i 0
        while i < n1
        {
            let x a[i]
            let y b[i]
            let c this.compare_types(x, y)
            if c <> 0
                return c
            set i: i + 1
        }
        0
    }

    ; compareElementLabels — the label of a tuple element, which is the NAME of the
    ; NamedTupleMember or of the Parameter get_tuple_element_info stored. ★It is
    ; `n.Name()`, not GetNameOfDeclaration (§3.5hr's pair): a labelled element's
    ; declaration IS the member node and its name is an identifier.
    function compare_element_labels(n1: ref[AstNode]?, n2: ref[AstNode]?) returns int
    {
        if n1 = n2
            return 0
        if n1 = null
            return 0 - 1
        if n2 = null
            return 1
        Checker.compare_names(AstNode.identifier_text_of(AstNode.name_of(n1)), AstNode.identifier_text_of(AstNode.name_of(n2)))
    }

    ; compareTupleTypes — the discriminator two tuple TARGETS get instead of a
    ; symbol, and the reason it stands ABOVE the type-argument list: a tuple target
    ; has no symbol at all, so without it `readonly [string]` and `[number, boolean]`
    ; were separated by compare_type_lists, which compares ARITY first and therefore
    ; ordered the one-element tuple before the two-element one in either direction.
    ; The reference orders `readonly` AFTER mutable and only then by arity.
    function compare_tuple_types(t1: ref[Type], t2: ref[Type]) returns int
    {
        if t1 = t2
            return 0
        let ro1 Checker.tuple_readonly_of(t1)
        let ro2 Checker.tuple_readonly_of(t2)
        if ro1 <> ro2
        {
            if ro1
                return 1
            return 0 - 1
        }
        let i1 Checker.tuple_element_infos_of(t1)
        let i2 Checker.tuple_element_infos_of(t2)
        var n1 0
        if i1 <> null
            set n1: (i1 as ref[Array[ref[TupleElementInfo]?]]).get_length() as int
        var n2 0
        if i2 <> null
            set n2: (i2 as ref[Array[ref[TupleElementInfo]?]]).get_length() as int
        if n1 <> n2
            return n1 - n2
        if n1 = 0
            return 0
        let a i1 as ref[Array[ref[TupleElementInfo]?]]
        let b i2 as ref[Array[ref[TupleElementInfo]?]]
        var i 0
        while i < n1
        {
            let x a[i]
            let y b[i]
            if x = null
                return 0
            if y = null
                return 0
            let c (x as ref[TupleElementInfo]).flags - (y as ref[TupleElementInfo]).flags
            if c <> 0
                return c
            set i: i + 1
        }
        ; ★The two loops are the reference's two loops and not one: EVERY flag is
        ; compared before ANY label is, so a difference in the last element's flags
        ; outranks a difference in the first element's label.
        var j 0
        while j < n1
        {
            let x2 a[j]
            let y2 b[j]
            if x2 = null
                return 0
            if y2 = null
                return 0
            let c2 Checker.compare_element_labels((x2 as ref[TupleElementInfo]).labeled_declaration, (y2 as ref[TupleElementInfo]).labeled_declaration)
            if c2 <> 0
                return c2
            set j: j + 1
        }
        0
    }

    ; ★★★ CompareTypes. THE LIST OF ARMS THIS FUNCTION LEFT OUT WAS A CONTAINMENT
    ; CLAIM AND IT EXPIRED ONE PRODUCER AT A TIME. What stood here read *this port
    ; can MAKE a type for six of them, and the other eight are containment rather
    ; than omission — nothing here mints an Intersection, an Index, an
    ; IndexedAccess, a Conditional, a Substitution, a TemplateLiteral, a
    ; StringMapping or a UniqueESSymbol type, so an arm for one could not be
    ; reached by a test* — and every one of those eight has a `new_*` producer in
    ; this file today. Two of them were even answered in the body (slice 135 wrote
    ; the Intersection and the UniqueESSymbol arms) while the header went on
    ; asserting they could not arrive; the other six were genuinely missing, so
    ; every union holding a template literal, a `keyof`, an indexed access, a
    ; conditional, a substitution or an `Uppercase<T>` came out in ID order where
    ; the reference orders by the type's own data. ★Measured on the smallest
    ; witness there is: `` `foo${string}` | `${number}foo` `` printed in source
    ; order here and `` `${number}foo` | `foo${string}` `` in the reference, because
    ; slices.Compare over the TEXTS puts `""` before `"foo"`.
    ;
    ; ★★★ A CONTAINMENT CLAIM IS TRUE ON THE DAY IT IS WRITTEN AND NOTHING MARKS
    ; THE DAY IT STOPS BEING TRUE (§3.5hd). The one thing that would have caught
    ; this is the claim naming its own refuter — which is why the list above is
    ; replaced by arms rather than by a newer list.
    ;
    ; ★★★ THE OBJECT ARM IS THE ONE WITH REAL DEAD SUB-ARMS AND THEY ARE PROVEN
    ; DEAD, not assumed: a TUPLE type is refused by new_object_type (it reports),
    ; and a DEFERRED type reference cannot exist because create_type_reference
    ; always writes resolvedTypeArguments — which is the same fact
    ; get_type_arguments' `get-type-arguments-deferred` stop records from the other
    ; side. `mapper` is not carried at all. So the reference's four-way sub-switch
    ; collapses to: both references, order by the type ARGUMENT lists; one
    ; reference, it comes first; neither, they are two anonymous types with the same
    ; symbol and the same object-type KIND, and the id decides.
    ;
    ; ★ `t1.checker != t2.checker` is a panic upstream and is not written: a
    ; Checker here is built per file and there is one.
    procedure compare_types(this, a: ref[Type]?, b: ref[Type]?) returns int
    {
        if a = b
            return 0
        if a = null
            return 0 - 1
        if b = null
            return 1
        let t1 a as ref[Type]
        let t2 b as ref[Type]
        if t1 = t2
            return 0
        let cf Checker.get_sort_order_flags(t1) - Checker.get_sort_order_flags(t2)
        if cf <> 0
            return cf
        let cn this.compare_type_names(t1, t2)
        if cn <> 0
            return cn
        ; ★★★ SLICE 135: THE ARMS BELOW ARE A `switch` UPSTREAM AND THEY ARE NOT
        ; DISJOINT, so a chain of `if`s is not the same construct. An ENUM LITERAL
        ; carries EnumLiteral AND NumberLiteral (or StringLiteral) at once, and the
        ; reference's Enum arm stands ABOVE the literal arms — written as a chain the
        ; enum arm was simply absent and every union of enum members came out in
        ; VALUE order where the reference orders by the member's DECLARATION
        ; position. Measured: `const enum E { N1 = 1000, N2 = 25 }` printed
        ; `E.N2 | E.N1` against the reference's `E.N1 | E.N2`
        ; (mixedTypeEnumComparison), and `E | F` over two numeric enums came out
        ; `E.a | F.c | E.b | F.d` — the four members interleaved by value.
        ; So each arm here ends AT THE ID TAIL rather than falling into the next.
        ;
        ; The reference's first case is EMPTY — an intrinsic is distinguished by its
        ; id alone — and it is written because it must SHADOW the arms below it:
        ; `booleanType` carries Boolean AND Union.
        if (t1.flags & (TypeFlagsAny | TypeFlagsUnknown | TypeFlagsString | TypeFlagsNumber | TypeFlagsBoolean | TypeFlagsBigInt | TypeFlagsESSymbol | TypeFlagsVoid | TypeFlagsUndefined | TypeFlagsNull | TypeFlagsNever | TypeFlagsNonPrimitive)) <> 0
            return t1.id - t2.id
        if (t1.flags & TypeFlagsObject) <> 0
        {
            let cs this.compare_symbols(t1.symbol, t2.symbol)
            if cs <> 0
                return cs
            let r1 (t1.object_flags & ObjectFlagsReference) <> 0
            let r2 (t2.object_flags & ObjectFlagsReference) <> 0
            if r1
            {
                if r2
                {
                    ; ★★★ THE TUPLE STEP AND THE DEFERRED FORK WERE BOTH MISSING
                    ; (slice 201) and the arm read as if a reference pair were
                    ; always distinguished by its type ARGUMENTS.
                    let g1 Checker.target_of(t1)
                    let g2 Checker.target_of(t2)
                    if g1 <> null
                    {
                        if g2 <> null
                        {
                            let tg1 g1 as ref[Type]
                            let tg2 g2 as ref[Type]
                            if (tg1.object_flags & ObjectFlagsTuple) <> 0
                            {
                                if (tg2.object_flags & ObjectFlagsTuple) <> 0
                                {
                                    let ct Checker.compare_tuple_types(tg1, tg2)
                                    if ct <> 0
                                        return ct
                                }
                            }
                        }
                    }
                    ; "Deferred type references with the same target are ordered by
                    ; the source location of the reference" — and by their MAPPERS
                    ; when the location is the same, which is what tells two
                    ; instantiations of one deferred reference apart. A pair where
                    ; only ONE side carries a node takes this branch too: the
                    ; reference's condition is `r1.node == nil && r2.node == nil`.
                    let nd1 Checker.reference_node_of(t1)
                    let nd2 Checker.reference_node_of(t2)
                    if nd1 = null
                    {
                        if nd2 = null
                        {
                            let ca this.compare_type_lists(Checker.resolved_type_arguments_of(t1), Checker.resolved_type_arguments_of(t2))
                            if ca <> 0
                                return ca
                        }
                    }
                    var deferred true
                    if nd1 = null
                    {
                        if nd2 = null
                            set deferred: false
                    }
                    if deferred
                    {
                        let cnd this.compare_nodes_ex(nd1, nd2)
                        if cnd <> 0
                            return cnd
                        let cm this.compare_type_mappers(Checker.mapper_of(t1), Checker.mapper_of(t2))
                        if cm <> 0
                            return cm
                    }
                }
                if r2 = false
                    return 0 - 1
            }
            if r1 = false
            {
                if r2
                    return 1
                ; "Order unnamed non-reference object types by kind and associated
                ; type mappers." ★ObjectFlagsObjectTypeKindMask is declarable now —
                ; the note beside ObjectFlagsPropagatingFlags said it names two bits
                ; this port had not written down, and all nine are declared today.
                let ck (t1.object_flags & ObjectFlagsObjectTypeKindMask) - (t2.object_flags & ObjectFlagsObjectTypeKindMask)
                if ck <> 0
                    return ck
                let cm2 this.compare_type_mappers(Checker.mapper_of(t1), Checker.mapper_of(t2))
                if cm2 <> 0
                    return cm2
            }
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsUnion) <> 0
        {
            ; ★★★ THE ORIGIN FORK, LIVE SINCE SLICE 135. The note that stood here
            ; said both origins are null and the fork collapses to its first arm;
            ; the intersection cross-product had already been writing one since
            ; slice 121, and this slice adds the denormalized union of named
            ; unions, so all three arms are reachable. `nil` sorts AFTER a
            ; non-nil origin, which is the reference's own asymmetry.
            let o1 Checker.union_origin_of(t1)
            let o2 Checker.union_origin_of(t2)
            if o1 = null
            {
                if o2 = null
                {
                    let cl this.compare_type_lists(Checker.union_types_of(t1), Checker.union_types_of(t2))
                    if cl <> 0
                        return cl
                }
                else
                    return 1
            }
            else
            {
                if o2 = null
                    return 0 - 1
                let co this.compare_types(o1, o2)
                if co <> 0
                    return co
            }
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsIntersection) <> 0
        {
            let cl this.compare_type_lists(Checker.intersection_types_of(t1), Checker.intersection_types_of(t2))
            if cl <> 0
                return cl
            return t1.id - t2.id
        }
        ; ★★★ THE ARM THAT WAS MISSING, and it stands ABOVE the literal arms in the
        ; reference's switch for the reason this function's header now records: an
        ; enum member's type is a literal type as well as an enum one, so reached
        ; through the literal arm it is ordered by its VALUE where the reference
        ; orders it by its symbol's declaration position.
        if (t1.flags & (TypeFlagsEnumLike | TypeFlagsUniqueESSymbol)) <> 0
        {
            let cs this.compare_symbols(t1.symbol, t2.symbol)
            if cs <> 0
                return cs
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsStringLiteral) <> 0
        {
            let cv Checker.compare_names(Checker.literal_text_of(t1), Checker.literal_text_of(t2))
            if cv <> 0
                return cv
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsNumberLiteral) <> 0
        {
            let cv Checker.compare_number_literal_bits(Checker.literal_bits_of(t1), Checker.literal_bits_of(t2))
            if cv <> 0
                return cv
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsBooleanLiteral) <> 0
        {
            let b1 Checker.literal_bool_of(t1)
            let b2 Checker.literal_bool_of(t2)
            if b1 <> b2
            {
                if b1
                    return 1
                return 0 - 1
            }
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsTypeParameter) <> 0
        {
            let cs this.compare_symbols(t1.symbol, t2.symbol)
            if cs <> 0
                return cs
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsIndex) <> 0
        {
            let ct this.compare_types(Checker.index_target_of(t1), Checker.index_target_of(t2))
            if ct <> 0
                return ct
            let cf2 Checker.index_flags_of(t1) - Checker.index_flags_of(t2)
            if cf2 <> 0
                return cf2
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsIndexedAccess) <> 0
        {
            let co this.compare_types(Checker.indexed_access_object_type_of(t1), Checker.indexed_access_object_type_of(t2))
            if co <> 0
                return co
            let ci this.compare_types(Checker.indexed_access_index_type_of(t1), Checker.indexed_access_index_type_of(t2))
            if ci <> 0
                return ci
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsConditional) <> 0
        {
            ; `root.node` is a ConditionalTypeNode upstream and an AstNode here, so
            ; the reference's `.AsNode()` is the identity.
            let r1 Checker.conditional_root_of(t1)
            let r2 Checker.conditional_root_of(t2)
            if r1 <> null
            {
                if r2 <> null
                {
                    let cnd this.compare_nodes_ex((r1 as ref[ConditionalRoot]).node, (r2 as ref[ConditionalRoot]).node)
                    if cnd <> 0
                        return cnd
                }
            }
            let cm this.compare_type_mappers(Checker.conditional_mapper_of(t1), Checker.conditional_mapper_of(t2))
            if cm <> 0
                return cm
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsSubstitution) <> 0
        {
            let cb this.compare_types(Checker.substitution_base_type_of(t1), Checker.substitution_base_type_of(t2))
            if cb <> 0
                return cb
            let cc this.compare_types(Checker.substitution_constraint_of(t1), Checker.substitution_constraint_of(t2))
            if cc <> 0
                return cc
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsTemplateLiteral) <> 0
        {
            let ctx this.compare_text_lists(Checker.template_literal_texts_of(t1), Checker.template_literal_texts_of(t2))
            if ctx <> 0
                return ctx
            let clt this.compare_type_lists(Checker.template_literal_types_of(t1), Checker.template_literal_types_of(t2))
            if clt <> 0
                return clt
            return t1.id - t2.id
        }
        if (t1.flags & TypeFlagsStringMapping) <> 0
        {
            let cm2 this.compare_types(Checker.string_mapping_target_of(t1), Checker.string_mapping_target_of(t2))
            if cm2 <> 0
                return cm2
            return t1.id - t2.id
        }
        ; Fall back to type ids, which is creation order for the built-in types.
        t1.id - t2.id
    }

    ; `slices.Compare(t1.texts, t2.texts)` over two []string — element by element
    ; with strings.Compare, and the SHORTER list first when one is a prefix of the
    ; other. ★That is not compare_type_lists' shape, which compares LENGTHS first:
    ; slices.Compare orders `["a"]` before `["a", ""]` and compare_type_lists would
    ; order by count. The one caller is the template-literal arm.
    function compare_text_lists(this, l1: ref[Array[ref[String]?]]?, l2: ref[Array[ref[String]?]]?) returns int
    {
        var n1 0
        if l1 <> null
            set n1: (l1 as ref[Array[ref[String]?]]).get_length() as int
        var n2 0
        if l2 <> null
            set n2: (l2 as ref[Array[ref[String]?]]).get_length() as int
        var n n1
        if n2 < n
            set n: n2
        var i 0
        while i < n
        {
            let x (l1 as ref[Array[ref[String]?]])[i]
            let y (l2 as ref[Array[ref[String]?]])[i]
            var xs Slice[char]()
            var ys Slice[char]()
            if x <> null
            {
                let xv x as ref[String]
                set xs: Slice[char](xv.get_length(), xv.get_buffer() as pointer[char])
            }
            if y <> null
            {
                let yv y as ref[String]
                set ys: Slice[char](yv.get_length(), yv.get_buffer() as pointer[char])
            }
            let c Checker.compare_names(xs, ys)
            if c <> 0
                return c
            set i: i + 1
        }
        if n1 < n2
            return 0 - 1
        if n1 > n2
            return 1
        0
    }

    ; compareTypeMappers. ★THE KIND ORDERING IS THE REFERENCE'S `iota` AND NOT AN
    ; INVENTION: Unknown 0, Simple 1, Array 2, Merged 3, and every other mapper
    ; upstream inherits TypeMapperBase.Kind, which answers Unknown — so the six
    ; kinds this port carries beyond those three all compare EQUAL to one another
    ; and fall to the caller's id tail, exactly as they do upstream.
    procedure compare_type_mappers(this, m1: ref[TypeMapper]?, m2: ref[TypeMapper]?) returns int
    {
        if m1 = m2
            return 0
        if m1 = null
            return 1
        if m2 = null
            return 0 - 1
        let a m1 as ref[TypeMapper]
        let b m2 as ref[TypeMapper]
        let k1 Checker.type_mapper_kind(a)
        let k2 Checker.type_mapper_kind(b)
        if k1 <> k2
            return k1 - k2
        if k1 = 1
        {
            let cs this.compare_types(Checker.simple_mapper_source_of(a), Checker.simple_mapper_source_of(b))
            if cs <> 0
                return cs
            return this.compare_types(Checker.simple_mapper_target_of(a), Checker.simple_mapper_target_of(b))
        }
        if k1 = 2
        {
            let cs this.compare_type_lists(Checker.array_mapper_sources_of(a), Checker.array_mapper_sources_of(b))
            if cs <> 0
                return cs
            return this.compare_type_lists(Checker.array_mapper_targets_of(a), Checker.array_mapper_targets_of(b))
        }
        if k1 = 3
        {
            let c1 this.compare_type_mappers(Checker.merged_mapper_first_of(a), Checker.merged_mapper_first_of(b))
            if c1 <> 0
                return c1
            return this.compare_type_mappers(Checker.merged_mapper_second_of(a), Checker.merged_mapper_second_of(b))
        }
        0
    }

    function type_mapper_kind(m: ref[TypeMapper]) returns int
    {
        choose m.data
            when d: Simple
                return 1
            when d: Array
                return 2
            when d: Merged
                return 3
        0
    }

    function simple_mapper_source_of(m: ref[TypeMapper]) returns ref[Type]?
    {
        choose m.data
            when d: Simple
                return d.source
        null
    }

    function simple_mapper_target_of(m: ref[TypeMapper]) returns ref[Type]?
    {
        choose m.data
            when d: Simple
                return d.target
        null
    }

    function array_mapper_sources_of(m: ref[TypeMapper]) returns ref[Array[ref[Type]?]]?
    {
        choose m.data
            when d: Array
                return d.sources
        null
    }

    function array_mapper_targets_of(m: ref[TypeMapper]) returns ref[Array[ref[Type]?]]?
    {
        choose m.data
            when d: Array
                return d.targets
        null
    }

    function merged_mapper_first_of(m: ref[TypeMapper]) returns ref[TypeMapper]?
    {
        choose m.data
            when d: Merged
                return d.m1
        null
    }

    function merged_mapper_second_of(m: ref[TypeMapper]) returns ref[TypeMapper]?
    {
        choose m.data
            when d: Merged
                return d.m2
        null
    }

    ; ★★★ cmp.Compare OVER TWO jsnum.Numbers, DONE ON THE BITS, AND THE TWO INPUTS
    ; THE TWO SPELLINGS DISAGREE ABOUT ARE THE TWO A NUMERIC LITERAL CANNOT BE.
    ; A total order on the IEEE-754 bit pattern puts NaN at one end and orders -0
    ; BELOW +0, where cmp.Compare puts NaN FIRST and calls -0 and +0 equal. The
    ; number-literal table's own note has the argument for why neither can arrive:
    ; a NumericLiteral's text is a number the scanner accepted, so jsnum_from_string
    ; of it is neither NaN nor negative zero. For every input this port can reach
    ; the two answers are the same one.
    function compare_number_literal_bits(b1: u64, b2: u64) returns int
    {
        if b1 = b2
            return 0
        let n1 (b1 & 0x8000000000000000) <> 0
        let n2 (b2 & 0x8000000000000000) <> 0
        if n1
        {
            if n2 = false
                return 0 - 1
            ; Both negative: the larger bit pattern is the smaller value.
            if b1 > b2
                return 0 - 1
            return 1
        }
        if n2
            return 1
        if b1 < b2
            return 0 - 1
        1
    }

    ; slices.BinarySearchFunc over a SORTED constituent list. Answers the index at
    ; which `t` belongs and writes whether it is already there.
    ;
    ; ★ Go's contract is the one that matters here and it is not "the index of t":
    ; it is the position of the FIRST element that does not compare less than `t`,
    ; which is where an insert keeps the list sorted whether or not the search hit.
    procedure binary_search_type(this, list: ref[Array[ref[Type]?]], t: ref[Type]?, found: ref[bool]) returns int
    {
        set found: false
        let n list.get_length() as int
        var lo 0
        var hi n
        while lo < hi
        {
            let mid lo + (hi - lo) / 2
            let e list[mid]
            if this.compare_types(e, t) < 0
                set lo: mid + 1
            else
                set hi: mid
        }
        if lo < n
        {
            let e list[lo]
            if this.compare_types(e, t) = 0
                set found: true
        }
        lo
    }

    ; containsType.
    procedure contains_type(this, list: ref[Array[ref[Type]?]], t: ref[Type]?) returns bool
    {
        var found false
        this.binary_search_type(list, t, &found)
        found
    }

    ; ★★ slices.Insert AT AN INDEX, AND SCALY'S Array HAS NO SUCH THING — it grows
    ; at the end and clears, and nothing in between (slice 93 met the same wall from
    ; the other side and answered it with a cons list). The shift is written out:
    ; one `add` to make room and a right-to-left run of `put`. It is O(n) per insert
    ; over a list whose length is the number of constituents of one union.
    procedure insert_type_at(list: ref[Array[ref[Type]?]], index: int, t: ref[Type]?)
    {
        list.add(null)
        var i (list.get_length() as int) - 1
        while i > index
        {
            list.put(i as size_t, list[i - 1])
            set i: i - 1
        }
        list.put(index as size_t, t)
    }

    ; slices.Delete of ONE element, as a rebuild — the same wall as the insert
    ; above, met where the reference shrinks a slice. The survivors are copied into
    ; a fresh list, which is the same answer and the only spelling available.
    procedure type_list_without(this, list: ref[Array[ref[Type]?]], index: int) returns ref[Array[ref[Type]?]]
    {
        let out this.new_type_list(null)
        let n list.get_length() as int
        var i 0
        while i < n
        {
            if i <> index
                out.add(list[i])
            set i: i + 1
        }
        out
    }

    ; ── building the constituent set ────────────────────────────────────────

    ; addTypeToUnion. The reference returns the slice and the flags; here the SET is
    ; a mutable Array the caller owns, so only `includes` is an answer.
    procedure add_type_to_union(this, type_set: ref[Array[ref[Type]?]], includes_in: int, t: ref[Type]) returns int
    {
        var includes includes_in
        let flags t.flags
        ; 'never' is ignored in unions.
        if (flags & TypeFlagsNever) <> 0
            return includes
        set includes: includes | (flags & TypeFlagsIncludesMask)
        if (flags & TypeFlagsInstantiable) <> 0
            set includes: includes | TypeFlagsIncludesInstantiable
        ; See ObjectFlagsIsConstrainedTypeVariable's own note: the first term
        ; settles this for every type this port can mint.
        if (flags & TypeFlagsIntersection) <> 0
        {
            if (t.object_flags & ObjectFlagsIsConstrainedTypeVariable) <> 0
                set includes: includes | TypeFlagsIncludesConstrainedTypeVariable
        }
        if t = wildcard_type
            set includes: includes | TypeFlagsIncludesWildcard
        if this.is_error_type(t)
            set includes: includes | TypeFlagsIncludesError
        ; `!c.strictNullChecks && flags&Nullable != 0` — the option is TRUE under
        ; this harness, so the ELSE is the branch that runs and the widening bit the
        ; other one records is never set. Written as the reference's conditional
        ; with the option spelled as a constant, exactly as create_widening_type is.
        var non_widening false
        if Checker.strict_null_checks() = false
        {
            if (flags & TypeFlagsNullable) <> 0
                set non_widening: true
        }
        if non_widening
        {
            if (t.object_flags & ObjectFlagsContainsWideningType) = 0
                set includes: includes | TypeFlagsIncludesNonWideningType
            return includes
        }
        var found false
        let index this.binary_search_type(type_set, t, &found)
        if found = false
            Checker.insert_type_at(type_set, index, t)
        includes
    }

    ; addTypesToUnion. The `lastType` guard is the reference's own cheap
    ; deduplication of an already-sorted input and is kept: it is what makes
    ; `getUnionType([t, t])` walk the set once.
    procedure add_types_to_union(this, type_set: ref[Array[ref[Type]?]], includes_in: int, types: ref[Array[ref[Type]?]]) returns int
    {
        var includes includes_in
        var last: ref[Type]? null
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                let t e as ref[Type]
                var same false
                if last <> null
                {
                    if (last as ref[Type]) = t
                        set same: true
                }
                if same = false
                {
                    if (t.flags & TypeFlagsUnion) <> 0
                    {
                        ; ★★★ `t.alias != nil || u.origin != nil` MARKS A NAMED
                        ; UNION, AND BOTH HALVES ARE LIVE SINCE SLICE 135. The note
                        ; that stood here said neither can be true because slice
                        ; 111's one alias producer mints an anonymous OBJECT type;
                        ; an ENUM is a union carrying its own symbol as the alias,
                        ; and the intersection cross-product has been writing an
                        ; origin since slice 121. The bit is what makes the
                        ; denormalized-origin block in the worker run, i.e. what
                        ; makes `E | F` print as `E | F` and not as its four
                        ; interleaved members.
                        if t.alias_symbol <> null
                            set includes: includes | TypeFlagsUnion
                        else
                        {
                            if Checker.union_origin_of(t) <> null
                                set includes: includes | TypeFlagsUnion
                        }
                        let sub Checker.union_types_of(t)
                        if sub <> null
                            set includes: this.add_types_to_union(type_set, includes, sub as ref[Array[ref[Type]?]])
                    }
                    else
                        set includes: this.add_type_to_union(type_set, includes, t)
                    set last: t
                }
            }
            set i: i + 1
        }
        includes
    }

    ; addNamedUnions — the unions in the INPUT list that carry a name, collected
    ; without duplicates and in input order.
    ;
    ; ★★★ THE THIRD ARM IS THE RECURSION AND IT IS WHAT KEEPS A NESTED ORIGIN
    ; FLAT. A constituent that is itself a denormalized union contributes ITS
    ; origin's constituents, not itself — so `(A | B) | C` where the left is
    ; already an origin union does not nest a second level, and the count test in
    ; the worker stays a comparison of two flat lengths.
    ;
    ; ★ The second arm's guard is `u.origin != nil && u.origin.flags&Union == 0`:
    ; an origin that is NOT a union is the INTERSECTION cross-product's, and such
    ; a union is named by that origin rather than decomposed.
    procedure add_named_unions(this, seed: ref[Array[ref[Type]?]]?, types: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]
    {
        let out this.new_type_list(seed)
        this.add_named_unions_into(out, types)
        out
    }

    ; ★ The accumulator is a mutable Array the caller owns, so the recursion
    ; APPENDS where the reference re-assigns its slice; that is the same shape
    ; add_types_to_union already has one function up.
    procedure add_named_unions_into(this, out: ref[Array[ref[Type]?]], types: ref[Array[ref[Type]?]])
    {
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                let t e as ref[Type]
                if (t.flags & TypeFlagsUnion) <> 0
                {
                    let org Checker.union_origin_of(t)
                    var named false
                    if t.alias_symbol <> null
                        set named: true
                    else
                    {
                        if org <> null
                        {
                            if ((org as ref[Type]).flags & TypeFlagsUnion) = 0
                                set named: true
                        }
                    }
                    if named
                    {
                        if Checker.type_list_contains(out, t) = false
                            out.add(t)
                    }
                    else
                    {
                        if org <> null
                        {
                            let ot org as ref[Type]
                            if (ot.flags & TypeFlagsUnion) <> 0
                            {
                                let ol Checker.union_types_of(ot)
                                if ol <> null
                                    this.add_named_unions_into(out, ol as ref[Array[ref[Type]?]])
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; ★★★ removeRedundantLiteralTypes, AND THE ONE DIVERGENCE IS THE SHAPE OF THE
    ; LOOP RATHER THAN OF THE ANSWER. Upstream walks BACKWARD and deletes in place,
    ; so a later test sees a list that has already shrunk; here the survivors are
    ; collected in one forward pass. The two agree, and the proof is the ordering
    ; this chapter is built on:
    ;   — every condition but the last reads `includes`, which is FIXED before the
    ;     loop starts, so no deletion can change one;
    ;   — the last one is `isFreshLiteralType(t) && containsType(types, regularType
    ;     of t)`, and a fresh literal type is minted FROM its regular one
    ;     (get_fresh_type_of_literal_type), so its id is larger; the two are equal
    ;     in flags and in value, so CompareTypes separates them by id alone and the
    ;     REGULAR one is always at the lower index. A backward pass therefore never
    ;     deletes a regular type before testing the fresh one that looks for it.
    ;
    ; ★ This is where `literal_regular_type_of` gets its FIRST reader — the slot
    ; slice 71 minted and slice 72 corrected the reader list of, saying in the
    ; record's own header that it had none.
    procedure remove_redundant_literal_types(this, types: ref[Array[ref[Type]?]], includes: int, reduce_void_undefined: bool) returns ref[Array[ref[Type]?]]
    {
        let out this.new_type_list(null)
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            var remove false
            if e <> null
            {
                let t e as ref[Type]
                let flags t.flags
                if (flags & (TypeFlagsStringLiteral | TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) <> 0
                {
                    if (includes & TypeFlagsString) <> 0
                        set remove: true
                }
                if (flags & TypeFlagsNumberLiteral) <> 0
                {
                    if (includes & TypeFlagsNumber) <> 0
                        set remove: true
                }
                if (flags & TypeFlagsBigIntLiteral) <> 0
                {
                    if (includes & TypeFlagsBigInt) <> 0
                        set remove: true
                }
                if (flags & TypeFlagsUniqueESSymbol) <> 0
                {
                    if (includes & TypeFlagsESSymbol) <> 0
                        set remove: true
                }
                if reduce_void_undefined
                {
                    if (flags & TypeFlagsUndefined) <> 0
                    {
                        if (includes & TypeFlagsVoid) <> 0
                            set remove: true
                    }
                }
                if Checker.is_fresh_literal_type(t)
                {
                    if this.contains_type(types, Checker.literal_regular_type_of(t))
                        set remove: true
                }
            }
            if remove = false
                out.add(e)
            set i: i + 1
        }
        out
    }

    ; getUnionTypeFromSortedList. The list is assumed sorted and deduplicated,
    ; which is what add_types_to_union guarantees.
    procedure get_union_type_from_sorted_list(this, types: ref[Array[ref[Type]?]], precomputed_object_flags: int, alias: ref[TypeAlias]?, origin: ref[Type]?) returns ref[Type]?
    {
        let n types.get_length() as int
        if n = 0
            return never_type
        if n = 1
            return types[0]
        let existing this.find_union_type(types, alias, origin)
        if existing <> null
            return existing
        let kept this.new_type_list(types)
        let t this.new_union_type(precomputed_object_flags | Checker.get_propagating_flags_of_types(kept, TypeFlagsNullable), kept, origin)
        Checker.set_type_alias(t, alias)
        ; ★★★ THE ONE LINE THAT MAKES `boolean` A KEYWORD AGAIN. A two-constituent
        ; union of the two boolean literal types carries TypeFlagsBoolean as well as
        ; TypeFlagsUnion, which is why type_to_string's Boolean arm — a keyword arm
        ; standing far above the union arm — catches booleanType before the union
        ; machinery ever sees it. Without it `boolean` would print as
        ; `false | true`, on every declaration in the corpus.
        if n = 2
        {
            let e0 types[0]
            let e1 types[1]
            if e0 <> null
            {
                if e1 <> null
                {
                    if ((e0 as ref[Type]).flags & TypeFlagsBooleanLiteral) <> 0
                    {
                        if ((e1 as ref[Type]).flags & TypeFlagsBooleanLiteral) <> 0
                            set t.flags: t.flags | TypeFlagsBoolean
                    }
                }
            }
        }
        union_types.add(t)
        this.union_type_index(Checker.union_row_hash(t), union_types.get_length() as int)
        t
    }

    ; The intern table's lookup — `c.unionTypes[getUnionKey(types, origin, alias)]`
    ; with the hash replaced by the comparison it stands for. Origin and alias are
    ; out of the key for the reason UnionTypeData's header gives, so the key is the
    ; constituent LIST: same length, same types, same order.
    function find_union_type(this, types: ref[Array[ref[Type]?]], alias: ref[TypeAlias]?, origin: ref[Type]?) returns ref[Type]?
    {
        if union_type_buckets <> null
        {
            let buckets union_type_buckets as ref[Vector[int]]
            let h Checker.union_key_hash(types, origin)
            var slot h & union_type_mask
            while true
            {
                let e buckets.get(slot as size_t)
                if e = null
                    return null
                let idx *e
                if idx = 0
                    return null
                let row union_types[idx - 1]
                if row <> null
                {
                    let u row as ref[Type]
                    if this.union_key_matches(u, types, alias, origin)
                        return u
                }
                set slot: (slot + 1) & union_type_mask
            }
        }
        let count union_types.get_length() as int
        var i 0
        while i < count
        {
            let row union_types[i]
            if row <> null
            {
                let u row as ref[Type]
                if this.union_key_matches(u, types, alias, origin)
                    return u
            }
            set i: i + 1
        }
        null
    }

    ; getUnionKey's four cases as a hash, in union_key_matches' own order. The
    ; accumulator is rel_result_hash's FNV round; the TAG is what keeps the three
    ; origin cases apart from one another and from the origin-free one, exactly as
    ; upstream's `'|'` and `'&'` prefixes do. Two keys that collide cost a probe
    ; and never an answer — union_key_matches decides every hit.
    function union_key_hash(types: ref[Array[ref[Type]?]]?, origin: ref[Type]?) returns int
    {
        var h: u64 14695981039346656037
        var list: ref[Array[ref[Type]?]]? types
        var tag 0
        if origin <> null
        {
            let o origin as ref[Type]
            if (o.flags & TypeFlagsUnion) <> 0
            {
                set tag: 1
                set list: Checker.union_types_of(o)
            }
            else
            {
                if (o.flags & TypeFlagsIntersection) <> 0
                {
                    set tag: 2
                    set list: Checker.intersection_types_of(o)
                }
                else
                {
                    ; The INDEX origin, whose key is the origin's own id AND the
                    ; constituents — *`keyof x` may resolve to multiple WIP values
                    ; while `x` is still resolving*. A fourth origin kind cannot
                    ; arrive (getUnionKey panics), and one that did would land here
                    ; and be told apart by the id.
                    set tag: 3
                    set h: h xor (o.id as u64)
                    set h: h * 1099511628211
                }
            }
        }
        set h: h xor (tag as u64)
        set h: h * 1099511628211
        if list <> null
        {
            let l list as ref[Array[ref[Type]?]]
            let n l.get_length() as int
            var i 0
            while i < n
            {
                let e l[i]
                if e <> null
                {
                    set h: h xor ((e as ref[Type]).id as u64)
                    set h: h * 1099511628211
                }
                set i: i + 1
            }
        }
        ((h >> 1) as int)
    }

    ; The same key taken off a STORED union, which is what files it.
    function union_row_hash(u: ref[Type]) returns int
        Checker.union_key_hash(Checker.union_types_of(u), Checker.union_origin_of(u))

    procedure union_type_index(this, h: int, count: int)
    {
        var cap 0
        if union_type_buckets <> null
            set cap: union_type_mask + 1
        if (count * 4) > (cap * 3)
        {
            var new_cap 16
            while (count * 4) > (new_cap * 3)
                set new_cap: new_cap * 2
            let old_union_type_buckets union_type_buckets
            let v AddressIndex.fresh_buckets(host, new_cap)
            set union_type_buckets: v
            AddressIndex.release_buckets(host, old_union_type_buckets)
            set union_type_mask: new_cap - 1
            var j 0
            while j < count
            {
                let row union_types[j]
                if row <> null
                {
                    let rh Checker.union_row_hash(row as ref[Type])
                    var slot rh & union_type_mask
                    while true
                    {
                        let e v.get(slot as size_t)
                        if e = null
                            break
                        if *e = 0
                        {
                            v.put(slot as size_t, j + 1)
                            break
                        }
                        set slot: (slot + 1) & union_type_mask
                    }
                }
                set j: j + 1
            }
            return
        }
        let buckets union_type_buckets as ref[Vector[int]]
        var slot h & union_type_mask
        while true
        {
            let e buckets.get(slot as size_t)
            if e = null
                return
            if *e = 0
            {
                buckets.put(slot as size_t, count)
                return
            }
            set slot: (slot + 1) & union_type_mask
        }
    }

    ; ★★★ getUnionKey, AND ITS FOUR CASES ARE NOT A REFINEMENT OF ONE — THE ORIGIN
    ; REPLACES THE CONSTITUENT LIST RATHER THAN JOINING IT. Upstream: with no
    ; origin the key is the constituents; with a UNION origin it is `'|'` and the
    ; ORIGIN's constituents and the normalized set is not in the key at all; with
    ; an INTERSECTION origin `'&'` and the same; with an INDEX origin the origin's
    ; own id AND the constituents, because *"`keyof x` may resolve to multiple WIP
    ; values while `x` is still resolving"*.
    ;
    ; ★★★ WRITTEN AS AN IDENTITY TEST ON THE ORIGIN — which is how slice 121 left
    ; it, correctly, while the only producer minted one origin per answer — IT
    ; STOPS INTERNING THE MOMENT THERE ARE TWO. Every `getUnionType([E, F])` builds
    ; a FRESH origin object, so an identity test never matches and the table mints
    ; a new union with a new id at every ask: two `E | F` types that are not the
    ; same type, which is a relation-cache miss and an id-ordered union that moves
    ; under repetition. Found by reading getUnionKey rather than by a red gate.
    function union_key_matches(this, u: ref[Type], types: ref[Array[ref[Type]?]], alias: ref[TypeAlias]?, origin: ref[Type]?) returns bool
    {
        if Checker.type_alias_matches(u, alias) = false
            return false
        let uo Checker.union_origin_of(u)
        if origin = null
        {
            if uo <> null
                return false
            return Checker.type_lists_identical(Checker.union_types_of(u), types)
        }
        if uo = null
            return false
        let o origin as ref[Type]
        let ou uo as ref[Type]
        if (o.flags & TypeFlagsUnion) <> 0
        {
            if (ou.flags & TypeFlagsUnion) = 0
                return false
            return Checker.type_lists_identical(Checker.union_types_of(ou), Checker.union_types_of(o))
        }
        if (o.flags & TypeFlagsIntersection) <> 0
        {
            if (ou.flags & TypeFlagsIntersection) = 0
                return false
            return Checker.type_lists_identical(Checker.intersection_types_of(ou), Checker.intersection_types_of(o))
        }
        if (o.flags & TypeFlagsIndex) <> 0
        {
            if (ou.flags & TypeFlagsIndex) = 0
                return false
            if ou <> o
                return false
            return Checker.type_lists_identical(Checker.union_types_of(u), types)
        }
        ; getUnionKey's `panic("Unhandled case")` — no other origin kind exists.
        false
    }

    ; ★★★ THE LIST COMPARISON IS `type_lists_identical`, WHICH THIS FILE HAS HAD
    ; SINCE SLICE 121 — and writing a second copy of it here was the first thing
    ; this slice did, which is §3.5fo's own rule arriving one slice later: a
    ; duplicate METHOD in one concept compiles and every gate stays green. The
    ; grep that catches it is one line and it is in that section.


    ; ★★★ removeSubtypes FOR REAL, SLICE 135. What stood here was
    ; remove_subtypes_is_identity — the reference's two early exits asked as a
    ; question — and the reason its third branch reported was *"isTypeSubtypeOf,
    ; i.e. the assignability relation under the strict-subtype rules, which is a
    ; dimension of its own"*. That expired: the relation is in this file, and
    ; is_type_strict_subtype_of has been one line over it since slice 112's
    ; getCommonSupertype. The row was the frontier's fifth largest.
    ;
    ; ★★★ THE KEY-PROPERTY SHORT CIRCUIT IS NOT AN OPTIMISATION AND MUST NOT BE
    ; DROPPED. "When constituents have a property by the same name but of a
    ; different unit type, we can quickly disqualify them" — on a discriminated
    ; union of n members that is what turns n² relation calls into n² property
    ; lookups, and the reference's own depth guard is calibrated on it.
    ;
    ; ★ The TYPE PARAMETER arm is a different question from the pairwise one and
    ; `continue`s past it: `T extends A | B` is a subtype of `A | B` and of
    ; neither constituent, so it is compared against the union of all the OTHERS
    ; with itself replaced by `never`.
    ;
    ; ★ Answers null on a stop; the caller separates that from the reference's own
    ; `return nil` (the complexity limit) by the unported mark.
    procedure remove_subtypes(this, types: ref[Array[ref[Type]?]], has_object_types: bool) returns ref[Array[ref[Type]?]]?
    {
        let mark this.unported_mark()
        let n0 types.get_length() as int
        if n0 < 2
            return types
        let cached this.find_subtype_reduction(types)
        if cached <> null
            return cached
        let key this.new_type_list(types)
        var has_empty_object false
        if has_object_types
        {
            var i 0
            while i < n0
            {
                let c types[i]
                if c <> null
                {
                    let ct c as ref[Type]
                    if (ct.flags & TypeFlagsObject) <> 0
                    {
                        if this.is_generic_mapped_type(ct) = false
                        {
                            let sm this.resolve_structured_type_members(ct)
                            if this.unported_mark() <> mark
                                return null
                            if sm <> null
                            {
                                if Checker.is_empty_resolved_type(sm as ref[StructuredMembers])
                                    set has_empty_object: true
                            }
                        }
                    }
                }
                set i: i + 1
            }
        }
        var cur: ref[Array[ref[Type]?]] types
        let length n0
        var i length
        var count 0
        while i > 0
        {
            set i: i - 1
            let sopt cur[i]
            if sopt = null
                continue
            let source sopt as ref[Type]
            var enter has_empty_object
            if (source.flags & TypeFlagsStructuredOrInstantiable) <> 0
                set enter: true
            if enter = false
                continue
            if (source.flags & TypeFlagsTypeParameter) <> 0
            {
                let bc this.get_base_constraint_or_type(source)
                if this.unported_mark() <> mark
                    return null
                var constrained_union false
                if bc <> null
                {
                    if ((bc as ref[Type]).flags & TypeFlagsUnion) <> 0
                        set constrained_union: true
                }
                if constrained_union
                {
                    let others &Array[ref[Type]?]()
                    let m cur.get_length() as int
                    var k 0
                    while k < m
                    {
                        let e cur[k]
                        var same false
                        if e <> null
                        {
                            if (e as ref[Type]) = source
                                set same: true
                        }
                        if same
                            others.add(never_type)
                        else
                            others.add(e)
                        set k: k + 1
                    }
                    let ou this.get_union_type(others)
                    if this.unported_mark() <> mark
                        return null
                    if ou <> null
                    {
                        if this.is_type_related_to(source, ou as ref[Type], RelationStrictSubtype)
                            set cur: this.type_list_without(cur, i)
                        if this.unported_mark() <> mark
                            return null
                    }
                    continue
                }
            }
            ; The first property with a UNIT type, if any.
            var key_property: ref[Symbol]? null
            var key_property_type: ref[Type]? null
            if (source.flags & (TypeFlagsObject | TypeFlagsIntersection | TypeFlagsInstantiableNonPrimitive)) <> 0
            {
                let props this.get_properties_of_type(source)
                if this.unported_mark() <> mark
                    return null
                if props <> null
                {
                    let pl props as ref[Array[ref[Symbol]?]]
                    let pn pl.get_length() as int
                    var pi 0
                    while pi < pn
                    {
                        let popt pl[pi]
                        if popt <> null
                        {
                            let pt this.get_type_of_symbol(popt as ref[Symbol])
                            if this.unported_mark() <> mark
                                return null
                            if pt <> null
                            {
                                if Checker.is_unit_type(pt as ref[Type])
                                {
                                    set key_property: popt
                                    set pi: pn
                                }
                            }
                        }
                        set pi: pi + 1
                    }
                }
            }
            if key_property <> null
            {
                let kt this.get_type_of_symbol(key_property as ref[Symbol])
                if this.unported_mark() <> mark
                    return null
                if kt = null
                    return null
                set key_property_type: this.get_regular_type_of_literal_type(kt as ref[Type])
                if this.unported_mark() <> mark
                    return null
            }
            let m cur.get_length() as int
            var ti 0
            while ti < m
            {
                let topt cur[ti]
                set ti: ti + 1
                if topt = null
                    continue
                let target topt as ref[Type]
                if target = source
                    continue
                if count = 100000
                {
                    ; "After 100000 subtype checks we estimate the remaining amount
                    ; of work" — the reference reports TS2590 at c.currentNode, a
                    ; slot this port does not carry, so the shape is a stop and not
                    ; a diagnostic at the wrong place.
                    let estimated (count / (length - i)) * length
                    if estimated > 1000000
                    {
                        ; TS2590 at c.currentNode, and the SECOND of its two sites
                        ; — the cross-product one is check_cross_product_union.
                        ; ★★★Both stops read *this port has no currentNode*; the
                        ; field has been on the Checker since slice 154. The null
                        ; below is the reference's own `return nil`, and the caller
                        ; turns it into errorType.
                        this.error_on_node(current_node, DiagExpression_produces_a_union_type_that_is_too_complex_to_represent)
                        return null
                    }
                }
                set count: count + 1
                if key_property <> null
                {
                    if (target.flags & (TypeFlagsObject | TypeFlagsIntersection | TypeFlagsInstantiableNonPrimitive)) <> 0
                    {
                        let kp key_property as ref[Symbol]
                        let tp this.get_type_of_property_of_type(target, Symbol.name_of(kp))
                        if this.unported_mark() <> mark
                            return null
                        var disqualified false
                        if tp <> null
                        {
                            let tpt tp as ref[Type]
                            if Checker.is_unit_type(tpt)
                            {
                                let rt this.get_regular_type_of_literal_type(tpt)
                                if this.unported_mark() <> mark
                                    return null
                                if rt <> key_property_type
                                    set disqualified: true
                            }
                        }
                        if disqualified
                            continue
                    }
                }
                var empty_pair false
                if source = empty_object_type
                    set empty_pair: true
                if source = unknown_empty_object_type
                    set empty_pair: true
                if empty_pair
                {
                    if target.symbol <> null
                    {
                        if this.is_empty_anonymous_object_type(target)
                            continue
                        if this.unported_mark() <> mark
                            return null
                    }
                }
                let related this.is_type_related_to(source, target, RelationStrictSubtype)
                if this.unported_mark() <> mark
                    return null
                if related
                {
                    var keep_class false
                    if (Checker.get_target_type(source).object_flags & ObjectFlagsClass) <> 0
                    {
                        if (Checker.get_target_type(target).object_flags & ObjectFlagsClass) <> 0
                        {
                            if this.is_type_derived_from(source, target) = false
                                set keep_class: true
                            if this.unported_mark() <> mark
                                return null
                        }
                    }
                    if keep_class = false
                    {
                        set cur: this.type_list_without(cur, i)
                        set ti: m
                    }
                }
            }
        }
        ; the memo keeps its own copy: `cur` may still be the caller's working list,
        ; which lives in the caller's region
        let row &SubtypeReductionRow^this(key, this.new_type_list(cur)) as ref[SubtypeReductionRow]?
        subtype_reduction_cache.add(row)
        cur
    }

    ; The memo's lookup — the constituent list compared by identity and order, as
    ; find_union_type does for the intern table.
    procedure find_subtype_reduction(this, types: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]?
    {
        let n types.get_length() as int
        let count subtype_reduction_cache.get_length() as int
        let chain subtype_reduction_chain
        while chain.count() < count
        {
            let pending subtype_reduction_cache[chain.count() as size_t]
            var pending_key: ref[Array[ref[Type]?]]? null
            if pending <> null
                set pending_key: (pending as ref[SubtypeReductionRow]).key
            if pending_key = null
                chain.add_blank()
            else
                chain.add(Checker.type_list_hash(pending_key))
        }
        var i chain.first(Checker.type_list_hash(types))
        while i >= 0
        {
            let row subtype_reduction_cache[i]
            if row <> null
            {
                let r row as ref[SubtypeReductionRow]
                let k r.key
                if k <> null
                {
                    let kl k as ref[Array[ref[Type]?]]
                    if (kl.get_length() as int) = n
                    {
                        var same true
                        var j 0
                        while j < n
                        {
                            if kl[j] <> types[j]
                                set same: false
                            set j: j + 1
                        }
                        if same
                            return r.result
                    }
                }
            }
            set i: chain.after(i)
        }
        null
    }

    ; insertType — `binary_search_type` plus `insert_type_at`, which is the pair
    ; add_types_to_union already writes out at its own tail.
    procedure insert_type_sorted(this, list: ref[Array[ref[Type]?]], t: ref[Type])
    {
        var found false
        let index this.binary_search_type(list, t, &found)
        if found = false
            Checker.insert_type_at(list, index, t)
    }

    ; The type VARIABLE half of a constraining intersection: `types[0]` when that
    ; one is the type variable, `types[1]` otherwise. The reference computes the
    ; index three times over the same shape; it is one helper here, and the
    ; PARTNER (the primitive) is the other index.
    function constrained_intersection_part(this, t: ref[Type], want_variable: bool) returns ref[Type]?
    {
        if (t.flags & TypeFlagsIntersection) = 0
            return null
        if (t.object_flags & ObjectFlagsIsConstrainedTypeVariable) = 0
            return null
        let its Checker.intersection_types_of(t)
        if its = null
            return null
        let list its as ref[Array[ref[Type]?]]
        if (list.get_length() as int) <> 2
            return null
        var index 0
        let first list[0]
        if first = null
            return null
        if ((first as ref[Type]).flags & TypeFlagsTypeVariable) = 0
            set index: 1
        if want_variable = false
            set index: 1 - index
        list[index]
    }

    ; removeConstrainedTypeVariables — "if every constituent in the type variable's
    ; constraint is covered by an intersection of the type variable and that
    ; constituent, remove those intersections and substitute the type variable",
    ; which is the reference's own comment and the whole of the function.
    ;
    ; ★★ THE DELETION IS A REBUILD. Upstream walks the list backwards and
    ; `slices.Delete`s; Scaly's Array grows and clears and has nothing in between
    ; (§ the insert_type_at note), so the kept constituents are copied forward in
    ; order — which is the same list, because the removed ones are removed
    ; wherever they sat.
    procedure remove_constrained_type_variables(this, types: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]?
    {
        var current types
        let variables this.new_type_list(null)
        let n current.get_length() as int
        var i 0
        while i < n
        {
            let row current[i]
            set i: i + 1
            if row = null
                continue
            let tv this.constrained_intersection_part(row as ref[Type], true)
            if tv = null
                continue
            if Checker.type_list_contains(variables, tv as ref[Type]) = false
                variables.add(tv)
        }
        let vn variables.get_length() as int
        var vi 0
        while vi < vn
        {
            let vrow variables[vi]
            set vi: vi + 1
            if vrow = null
                continue
            let tv vrow as ref[Type]
            ; The primitive halves of every constraining intersection of THIS type
            ; variable, in the sorted set `containsType` binary-searches.
            let primitives this.new_type_list(null)
            let cn current.get_length() as int
            var ci 0
            while ci < cn
            {
                let row current[ci]
                set ci: ci + 1
                if row = null
                    continue
                let owner this.constrained_intersection_part(row as ref[Type], true)
                if owner = null
                    continue
                if (owner as ref[Type]) <> tv
                    continue
                let prim this.constrained_intersection_part(row as ref[Type], false)
                if prim = null
                    continue
                this.insert_type_sorted(primitives, prim as ref[Type])
            }
            let mark this.unported_mark()
            let constraint this.get_base_constraint_of_type(tv)
            if this.unported_mark() <> mark
                return null
            if constraint = null
            {
                ; The bit is set only where getIntersectionTypeEx found a base
                ; constraint, so a null here is a disagreement between the two and
                ; not a shape: reported rather than read as *not covered*, which
                ; would answer an unreduced union without saying so.
                this.record_unported("remove-constrained-type-variables-no-constraint", tv.flags)
                return null
            }
            if this.every_type_is_contained_in(constraint as ref[Type], primitives) = false
                continue
            let kept this.new_type_list(null)
            set ci: 0
            let kn current.get_length() as int
            while ci < kn
            {
                let row current[ci]
                set ci: ci + 1
                if row = null
                    continue
                let owner this.constrained_intersection_part(row as ref[Type], true)
                var drop false
                if owner <> null
                {
                    if (owner as ref[Type]) = tv
                    {
                        let prim this.constrained_intersection_part(row as ref[Type], false)
                        if prim <> null
                        {
                            if this.contains_type(primitives, prim)
                                set drop: true
                        }
                    }
                }
                if drop = false
                    kept.add(row)
            }
            this.insert_type_sorted(kept, tv)
            set current: kept
        }
        current
    }

    ; `everyType(constraint, func(t) { return containsType(primitives, t) })`.
    procedure every_type_is_contained_in(this, t: ref[Type], list: ref[Array[ref[Type]?]]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.contains_type(list, t)
        let ts Checker.union_types_of(t)
        if ts = null
            return this.contains_type(list, t)
        let cs ts as ref[Array[ref[Type]?]]
        let n cs.get_length() as int
        var i 0
        while i < n
        {
            let row cs[i]
            set i: i + 1
            if row = null
                return false
            if this.contains_type(list, row) = false
                return false
        }
        true
    }

    procedure get_union_type_worker(this, types: ref[Array[ref[Type]?]], union_reduction: int, alias: ref[TypeAlias]?, origin: ref[Type]?) returns ref[Type]?
    {
        ; The working set lives in this routine's region: most calls find the union
        ; already interned, and the table copies the list only when it is new.
        var type_set_value Array[ref[Type]?]()
        var type_set &type_set_value
        var includes this.add_types_to_union(type_set, 0, types)
        if union_reduction <> UnionReductionNone
        {
            if (includes & TypeFlagsAnyOrUnknown) <> 0
            {
                if (includes & TypeFlagsAny) <> 0
                {
                    if (includes & TypeFlagsIncludesWildcard) <> 0
                        return wildcard_type
                    if (includes & TypeFlagsIncludesError) <> 0
                        return error_type
                    return any_type
                }
                return unknown_type
            }
            if (includes & TypeFlagsUndefined) <> 0
            {
                ; If the set holds both undefinedType and missingType, missingType
                ; goes. The two sort adjacently and in that order because they are
                ; two intrinsics with identical flags separated by their ids.
                if (type_set.get_length() as int) >= 2
                {
                    let e0 type_set[0]
                    let e1 type_set[1]
                    var pair false
                    if e0 <> null
                    {
                        if e1 <> null
                        {
                            if (e0 as ref[Type]) = undefined_type
                            {
                                if (e1 as ref[Type]) = missing_type
                                    set pair: true
                            }
                        }
                    }
                    if pair
                        set type_set: this.type_list_without(type_set, 1)
                }
            }
            var reduce false
            if (includes & (TypeFlagsEnum | TypeFlagsLiteral | TypeFlagsUniqueESSymbol | TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) <> 0
                set reduce: true
            if (includes & TypeFlagsVoid) <> 0
            {
                if (includes & TypeFlagsUndefined) <> 0
                    set reduce: true
            }
            if reduce
            {
                var reduce_void_undefined false
                if (union_reduction & UnionReductionSubtype) <> 0
                    set reduce_void_undefined: true
                set type_set: this.remove_redundant_literal_types(type_set, includes, reduce_void_undefined)
            }
            ; removeStringLiteralsMatchedByTemplateLiterals. ★The gate that stood
            ; here read *neither can be minted here, so the report is what will say
            ; the argument has broken* — and it did say so: the row was reached by
            ; five stage-2 units before slice 171, because a TEMPLATE literal has
            ; been mintable since slice 126 and only the string mapping was not.
            if (includes & TypeFlagsStringLiteral) <> 0
            {
                if (includes & (TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) <> 0
                {
                    let pruned this.remove_string_literals_matched_by_template_literals(type_set)
                    if pruned = null
                        return null
                    set type_set: pruned as ref[Array[ref[Type]?]]
                }
            }
            ; removeConstrainedTypeVariables (slice 170). ★★★The note that stood
            ; here read *likewise — it needs an intersection*, borrowing the
            ; argument of the row above it, and the bit it guards is set by
            ; `get_intersection_type_ex`'s own constrained-type-variable arm, which
            ; this port has had since slice 121: the row was reachable and was
            ; reached the moment `get_reduced_type` moved into the printer.
            if (includes & TypeFlagsIncludesConstrainedTypeVariable) <> 0
            {
                let rct this.remove_constrained_type_variables(type_set)
                if rct = null
                    return null
                set type_set: rct as ref[Array[ref[Type]?]]
            }
            ; removeSubtypes — the real one since slice 135; see its own header for
            ; what the stop that stood here was standing on.
            ;
            ; ★★★ ITS `return nil` IS THE COMPLEXITY LIMIT AND IT DOES NOT BECOME
            ; errorType HERE. Reading a null as *the reference's errorType* was the
            ; first draft and it INVENTED four wrong answers on the spot: any null
            ; from inside removeSubtypes that no stop accompanies — a property with
            ; no type, an empty accessor answer — turned an object literal's index
            ; type into `error`, and the four computedPropertyNames units then
            ; reported a TS7005 the reference does not have and printed `any` for a
            ; type it prints in full. The limit itself RECORDS a stop, so every
            ; null here is *no claim* and propagates as one.
            if (union_reduction & UnionReductionSubtype) <> 0
            {
                var has_object false
                if (includes & TypeFlagsObject) <> 0
                    set has_object: true
                ; ★★★ A NULL FROM remove_subtypes MEANS TWO THINGS AND THE MARK
                ; SEPARATES THEM. Upstream's only nil is the subtype-check limit
                ; above, and `if typeSet == nil { return c.errorType }` is what the
                ; caller does with it; here a null may equally be a stop deeper in
                ; propagating, and answering errorType for one of those would claim
                ; a diagnostic the walk never made. The mark is the port's own
                ; discriminator and needs no second channel.
                let subtype_mark this.unported_mark()
                let reduced this.remove_subtypes(type_set, has_object)
                if reduced = null
                {
                    if this.unported_mark() <> subtype_mark
                        return null
                    return error_type
                }
                set type_set: reduced as ref[Array[ref[Type]?]]
            }
            if (type_set.get_length() as int) = 0
            {
                if (includes & TypeFlagsNull) <> 0
                {
                    if (includes & TypeFlagsIncludesNonWideningType) <> 0
                        return null_type
                    return null_widening_type
                }
                if (includes & TypeFlagsUndefined) <> 0
                {
                    if (includes & TypeFlagsIncludesNonWideningType) <> 0
                        return undefined_type
                    return undefined_widening_type
                }
                return never_type
            }
        }
        ; ★★★ THE DENORMALIZED ORIGIN, LIVE SINCE SLICE 135. The note that stood
        ; here called this block unreachable because `includes` never carries
        ; TypeFlagsUnion; both of addTypesToUnion's marks have writers now (an
        ; enum's alias, the intersection cross-product's origin), so the block is
        ; the reference's and is written whole.
        ;
        ; What it BUYS is the union that prints as it was written: `E | F` over two
        ; enums, where the normalized set is the four members interleaved. The
        ; origin is a SECOND union type, never interned and never asked anything
        ; about its members — it exists so the printer, the constituent count and
        ; the comparator can answer about the shape the source named.
        ;
        ; ★ The single-named-union shortcut ABOVE the construction is the
        ; reference's and it is not an optimisation: `getUnionType([E])` where E is
        ; itself the union must answer E, alias and all, rather than a fresh
        ; equal-membered union that has lost the name.
        var origin_out origin
        if origin_out = null
        {
            if (includes & TypeFlagsUnion) <> 0
            {
                let named this.add_named_unions(null, types)
                let named_count named.get_length() as int
                let reduced this.new_type_list(null)
                let set_n type_set.get_length() as int
                var si 0
                while si < set_n
                {
                    let cand type_set[si]
                    var inside false
                    var ni 0
                    while ni < named_count
                    {
                        let u named[ni]
                        if u <> null
                        {
                            let ul Checker.union_types_of(u as ref[Type])
                            if ul <> null
                            {
                                if this.contains_type(ul as ref[Array[ref[Type]?]], cand)
                                    set inside: true
                            }
                        }
                        set ni: ni + 1
                    }
                    if inside = false
                        reduced.add(cand)
                    set si: si + 1
                }
                let reduced_n reduced.get_length() as int
                if alias = null
                {
                    if named_count = 1
                    {
                        if reduced_n = 0
                            return named[0]
                    }
                }
                ; "only when the union was created from one or more named unions
                ; and when there is no overlap between those named unions" — the
                ; count is what proves the second half.
                var named_types_count 0
                var ki 0
                while ki < named_count
                {
                    let u named[ki]
                    if u <> null
                    {
                        let ul Checker.union_types_of(u as ref[Type])
                        if ul <> null
                            set named_types_count: named_types_count + ((ul as ref[Array[ref[Type]?]]).get_length() as int)
                    }
                    set ki: ki + 1
                }
                if (named_types_count + reduced_n) = set_n
                {
                    var mi 0
                    while mi < named_count
                    {
                        let u named[mi]
                        var found false
                        let at this.binary_search_type(reduced, u, &found)
                        if found = false
                            Checker.insert_type_at(reduced, at, u)
                        set mi: mi + 1
                    }
                    set origin_out: this.new_union_type(ObjectFlagsNone, reduced, null) as ref[Type]?
                }
            }
        }
        var object_flags ObjectFlagsNone
        if (includes & TypeFlagsNotPrimitiveUnion) = 0
            set object_flags: ObjectFlagsPrimitiveUnion
        if (includes & TypeFlagsIntersection) <> 0
            set object_flags: object_flags | ObjectFlagsContainsIntersections
        this.get_union_type_from_sorted_list(type_set, object_flags, alias, origin_out)
    }

    ; getUnionTypeEx. ★The two-constituent memo the reference keeps in front of the
    ; worker is not carried and its absence is unobservable — see the union table's
    ; own note for the proof, which is that the worker is a pure function once alias
    ; and origin are out of the picture.
    procedure get_union_type_ex(this, types: ref[Array[ref[Type]?]], union_reduction: int, alias: ref[TypeAlias]?, origin: ref[Type]?) returns ref[Type]?
    {
        let n types.get_length() as int
        if n = 0
            return never_type
        if n = 1
            return types[0]
        this.get_union_type_worker(types, union_reduction, alias, origin)
    }

    procedure get_union_type(this, types: ref[Array[ref[Type]?]]) returns ref[Type]?
        this.get_union_type_ex(types, UnionReductionLiteral, null, null)

    ; getUnionOrIntersectionType (slice 155). ★The reduction argument is honoured
    ; on the UNION side only, which is upstream's own asymmetry and not an
    ; omission: getIntersectionType takes none.
    procedure get_union_or_intersection_type(this, types: ref[Array[ref[Type]?]], is_union: bool, union_reduction: int) returns ref[Type]?
    {
        if is_union
            return this.get_union_type_ex(types, union_reduction, null, null)
        this.get_intersection_type(types)
    }

    ; `c.getUnionType([]*Type{a, b})` — the shape almost every caller in this port
    ; has, written once so a caller is one line rather than four.
    procedure get_union_type_pair(this, a: ref[Type], b: ref[Type]) returns ref[Type]?
    {
        let list &Array[ref[Type]?]()
        list.add(a)
        list.add(b)
        this.get_union_type(list)
    }


    ; ── slice 121: THE INTERSECTION ──────────────────────────────────────────
    ;
    ; getIntersectionTypeEx and its helpers — the union chapter's twin. The two are
    ; deliberately NOT shared: the reference keeps two intern tables, two reduction
    ; ladders and two `addTypesTo*` walks, and the one thing they have in common is
    ; `UnionOrIntersectionType.types`, which is why this port grows a second payload
    ; arm rather than widening the first.
    ;
    ; ★★★ THE ORDER OF THE LADDER IS THE SPECIFICATION. Every early exit reads
    ; `includes`, a mask the walk accumulates, and each answers a DIFFERENT empty
    ; intersection — `never` for two unit types, `never` for a nullable meeting an
    ; object, `unknown` for the empty set, `any`/`wildcard`/`error` for the any
    ; family. Reordering two of them changes which answer a program gets, so the
    ; ladder is transcribed in the reference's sequence and its conditions are left
    ; as written rather than factored into a predicate.
    ;
    ; ★★ WHAT STOPS HERE IS THE ASSIGNABILITY RELATION AND NOTHING ELSE. Three
    ; branches need it — `isTypeStrictSubtypeOf` in the two-constituent constraint
    ; reduction and `isTypeSubtypeOf` in extractRedundantTemplateLiterals — and
    ; that is the relation dimension. They report where the reference computes, so a
    ; program reaching one is an honest UNPORTED rather than a wrong reduction.
    procedure get_intersection_type(this, types: ref[Array[ref[Type]?]]) returns ref[Type]?
        this.get_intersection_type_ex(types, IntersectionFlagsNone, null)

    procedure get_intersection_type_ex(this, types: ref[Array[ref[Type]?]], flags: int, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        var type_set this.new_type_list(null)
        let includes this.add_types_to_intersection(type_set, 0, types)
        if this.unported_mark() <> mark
            return null
        var object_flags ObjectFlagsNone
        if (includes & TypeFlagsNever) <> 0
        {
            if Checker.type_list_contains(type_set, silent_never_type)
                return silent_never_type
            return never_type
        }
        ; The reference's one seven-term disjunction, one term per `if` because each
        ; is a different disjoint-domain pair and a reader has to be able to see
        ; which one fired. `DisjointDomains &^ X` is `& ~X`.
        var empty false
        if Checker.strict_null_checks()
        {
            if (includes & TypeFlagsNullable) <> 0
            {
                if (includes & (TypeFlagsObject | TypeFlagsNonPrimitive | TypeFlagsIncludesEmptyObject)) <> 0
                    set empty: true
            }
        }
        if (includes & TypeFlagsNonPrimitive) <> 0
        {
            if (includes & (TypeFlagsDisjointDomains & ~TypeFlagsNonPrimitive)) <> 0
                set empty: true
        }
        if (includes & TypeFlagsStringLike) <> 0
        {
            if (includes & (TypeFlagsDisjointDomains & ~TypeFlagsStringLike)) <> 0
                set empty: true
        }
        if (includes & TypeFlagsNumberLike) <> 0
        {
            if (includes & (TypeFlagsDisjointDomains & ~TypeFlagsNumberLike)) <> 0
                set empty: true
        }
        if (includes & TypeFlagsBigIntLike) <> 0
        {
            if (includes & (TypeFlagsDisjointDomains & ~TypeFlagsBigIntLike)) <> 0
                set empty: true
        }
        if (includes & TypeFlagsESSymbolLike) <> 0
        {
            if (includes & (TypeFlagsDisjointDomains & ~TypeFlagsESSymbolLike)) <> 0
                set empty: true
        }
        if (includes & TypeFlagsVoidLike) <> 0
        {
            if (includes & (TypeFlagsDisjointDomains & ~TypeFlagsVoidLike)) <> 0
                set empty: true
        }
        if empty
            return never_type
        if (includes & (TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) <> 0
        {
            if (includes & TypeFlagsStringLiteral) <> 0
            {
                var is_empty_set false
                let pruned this.extract_redundant_template_literals(type_set, &is_empty_set)
                if pruned = null
                    return null
                set type_set: pruned as ref[Array[ref[Type]?]]
                if is_empty_set
                    return never_type
            }
        }
        if (includes & TypeFlagsAny) <> 0
        {
            if (includes & TypeFlagsIncludesWildcard) <> 0
                return wildcard_type
            if (includes & TypeFlagsIncludesError) <> 0
                return error_type
            return any_type
        }
        ; `!c.strictNullChecks && includes&Nullable != 0` (slice 254: the emit
        ; programs read the case's strictNullChecks)
        if Checker.strict_null_checks() = false
        {
            if (includes & TypeFlagsNullable) <> 0
            {
                if (includes & TypeFlagsIncludesEmptyObject) <> 0
                    return never_type
                if (includes & TypeFlagsUndefined) <> 0
                    return undefined_type
                return null_type
            }
        }
        var reduce_supertypes false
        if (includes & TypeFlagsString) <> 0
        {
            if (includes & (TypeFlagsStringLiteral | TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) <> 0
                set reduce_supertypes: true
        }
        if (includes & TypeFlagsNumber) <> 0
        {
            if (includes & TypeFlagsNumberLiteral) <> 0
                set reduce_supertypes: true
        }
        if (includes & TypeFlagsBigInt) <> 0
        {
            if (includes & TypeFlagsBigIntLiteral) <> 0
                set reduce_supertypes: true
        }
        if (includes & TypeFlagsESSymbol) <> 0
        {
            if (includes & TypeFlagsUniqueESSymbol) <> 0
                set reduce_supertypes: true
        }
        if (includes & TypeFlagsVoid) <> 0
        {
            if (includes & TypeFlagsUndefined) <> 0
                set reduce_supertypes: true
        }
        if (includes & TypeFlagsIncludesEmptyObject) <> 0
        {
            if (includes & TypeFlagsDefinitelyNonNullable) <> 0
                set reduce_supertypes: true
        }
        if reduce_supertypes
        {
            if (flags & IntersectionFlagsNoSupertypeReduction) = 0
                set type_set: this.remove_redundant_supertypes(type_set, includes)
        }
        if (includes & TypeFlagsIncludesMissingType) <> 0
            Checker.replace_first_type(type_set, undefined_type, missing_type)
        let count type_set.get_length() as int
        if count = 0
            return unknown_type
        if count = 1
            return type_set[0]
        if count = 2
        {
            if (flags & IntersectionFlagsNoConstraintReduction) = 0
            {
                let r this.reduce_two_constituent_intersection(type_set, includes, &object_flags)
                if this.unported_mark() <> mark
                    return null
                if r <> null
                    return r
            }
        }
        let existing this.find_intersection_type(type_set, flags, alias)
        if existing <> null
            return existing
        if (includes & TypeFlagsUnion) <> 0
        {
            let d this.distribute_intersection_over_unions(type_set, types, flags, alias)
            if this.unported_mark() <> mark
                return null
            if d = null
                return null
            this.intern_intersection_type(type_set, flags, d as ref[Type])
            return d
        }
        let made this.new_intersection_type(object_flags | Checker.get_propagating_flags_of_types(types, TypeFlagsNullable), type_set)
        Checker.set_type_alias(made, alias)
        this.intern_intersection_type(type_set, flags, made)
        made
    }

    ; The two-constituent constraint reduction — `T & P`, T a type variable and P a
    ; primitive, the object type or `{}`. It answers a TYPE when the reduction
    ; concludes and null when it does not.
    ;
    ; ★★★ ALL THREE OF ITS ANSWERS COME FROM ONE RELATION, isTypeStrictSubtypeOf,
    ; so the block is ONE stop and not four. What is written is the part in FRONT of
    ; the relation — the shape test that decides whether it is asked at all — and
    ; that test is what keeps an ordinary `A & B` off this path entirely: with no
    ; type variable there is nothing to reduce and nothing to report.
    procedure reduce_two_constituent_intersection(this, type_set: ref[Array[ref[Type]?]], includes: int, out_object_flags: ref[int]) returns ref[Type]?
    {
        let e0 type_set[0]
        let e1 type_set[1]
        if e0 = null
            return null
        if e1 = null
            return null
        var type_var_index 0
        if ((e0 as ref[Type]).flags & TypeFlagsTypeVariable) = 0
            set type_var_index: 1
        let tv type_set[type_var_index]
        let pt type_set[1 - type_var_index]
        if tv = null
            return null
        if pt = null
            return null
        let type_variable tv as ref[Type]
        let primitive_type pt as ref[Type]
        if (type_variable.flags & TypeFlagsTypeVariable) = 0
            return null
        var applies false
        if (primitive_type.flags & (TypeFlagsPrimitive | TypeFlagsNonPrimitive)) <> 0
        {
            if this.is_generic_string_like_type(primitive_type) = false
                set applies: true
        }
        if (includes & TypeFlagsIncludesEmptyObject) <> 0
            set applies: true
        if applies = false
            return null
        let mark this.unported_mark()
        let constraint this.get_base_constraint_of_type(type_variable)
        if this.unported_mark() <> mark
            return null
        if constraint = null
            return null
        let c constraint as ref[Type]
        if this.every_type_is_primitive_or_object_or_empty(c) = false
            return null
        ; "If T's constraint is a subtype of P, simply return T. For example,
        ; given `T extends \"a\" | \"b\"`, the intersection `T & string` reduces to
        ; just T."
        if this.is_type_strict_subtype_of(c, primitive_type)
            return type_variable
        if this.unported_mark() <> mark
            return null
        ; "No constituent of T's constraint is a subtype of P. If P is also not a
        ; subtype of T's constraint, then the constraint and P are unrelated, and
        ; the intersection reduces to never."
        var some_constituent false
        if (c.flags & TypeFlagsUnion) <> 0
        {
            if this.some_type_is_strict_subtype_of(c, primitive_type)
                set some_constituent: true
            if this.unported_mark() <> mark
                return null
        }
        if some_constituent = false
        {
            if this.is_type_strict_subtype_of(primitive_type, c) = false
            {
                if this.unported_mark() <> mark
                    return null
                return never_type
            }
            if this.unported_mark() <> mark
                return null
        }
        ; "Some constituent of T's constraint is a subtype of P, or P is a
        ; subtype of T's constraint. Thus, the intersection further constrains
        ; the type variable." ★★★ THE FLAG IS THE THIRD ANSWER AND IT IS NOT A
        ; TYPE: the reduction concludes NOTHING here and the intersection is
        ; still minted, but it is minted CONSTRAINED, which is what
        ; ObjectFlagsIsConstrainedTypeVariable's own note two hundred lines up is
        ; about. Answering null while writing the out-cell is the only way to say
        ; that in this port's return convention.
        set out_object_flags: ObjectFlagsIsConstrainedTypeVariable
        null
    }

    ; someType with the *strict subtype of this target* predicate — §3.18, one
    ; function per predicate. ★Its caller has already asked the union flag, so the
    ; non-union fall-through the reference's someType has is unreachable from
    ; there; it is written anyway because someType is a general helper and a
    ; special-cased copy of one is how the two drift apart.
    procedure some_type_is_strict_subtype_of(this, t: ref[Type], target: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_type_strict_subtype_of(t, target)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e <> null
            {
                if this.is_type_strict_subtype_of(e as ref[Type], target)
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; The four branches for an intersection that CONTAINS a union — the distributive
    ; half. Each mints a union out of intersections; the last is the cross product.
    procedure distribute_intersection_over_unions(this, type_set_in: ref[Array[ref[Type]?]], types: ref[Array[ref[Type]?]], flags: int, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        var reduced false
        let type_set this.intersect_unions_of_primitive_types(type_set_in, &reduced)
        if reduced
            return this.get_intersection_type_ex(type_set, flags, alias)
        ; `core.Every(typeSet, isUnionWithUndefined)` and its null twin — both strip
        ; ONE constituent out of every union and re-intersect the remainder.
        ;
        ; ★★★ THE ROW WAS AN EXPIRED PREMISE and its wording is what hid the fact:
        ; it said *filterType over a PREDICATE is the union chapter's reduction
        ; rather than this one's*, which is true of the general shape and not of
        ; the two predicates actually asked. `isNotUndefinedType` and
        ; `isNotNullType` are flag tests, so `filterTypes(typeSet, p)` is
        ; filter_type_outside_flags per constituent — a function this file has
        ; carried since the narrowing chapter, and one of the seventeen fixed
        ; predicates its own header says exist INSTEAD of a filter-kind
        ; dispatcher. §3.5hd, the seventh harvest.
        ;
        ; ★★ THE UNDEFINED ARM'S SECOND CONSTITUENT IS NOT ALWAYS `undefined`:
        ; `core.Some(typeSet, containsMissingType)` promotes it to `missing`, which
        ; is the exactOptionalPropertyTypes distinction. It is asked BEFORE the
        ; filter, on the unfiltered set, and reading it after would answer false
        ; for every input — the filter is what removes the constituent it asks
        ; about.
        ;
        ; ★ The inner intersection is built with a NULL alias and the alias rides
        ; the outer union, which is the reference's arrangement and not an
        ; oversight: the name belongs to `A | undefined`, not to `A`.
        if Checker.every_type_is_union_with_undefined(type_set)
        {
            var contained undefined_type
            if this.some_type_contains_missing(type_set)
                set contained: missing_type
            let filtered_u this.filter_types_outside_flags(type_set, TypeFlagsUndefined)
            if filtered_u = null
                return null
            let inner_u this.get_intersection_type_ex(filtered_u as ref[Array[ref[Type]?]], flags, null)
            if inner_u = null
                return null
            let pair_u &Array[ref[Type]?]()
            pair_u.add(inner_u)
            pair_u.add(contained)
            return this.get_union_type_ex(pair_u, UnionReductionLiteral, alias, null)
        }
        if Checker.every_type_is_union_with_null(type_set)
        {
            let filtered_n this.filter_types_outside_flags(type_set, TypeFlagsNull)
            if filtered_n = null
                return null
            let inner_n this.get_intersection_type_ex(filtered_n as ref[Array[ref[Type]?]], flags, null)
            if inner_n = null
                return null
            let pair_n &Array[ref[Type]?]()
            pair_n.add(inner_n)
            pair_n.add(null_type)
            return this.get_union_type_ex(pair_n, UnionReductionLiteral, alias, null)
        }
        let n type_set.get_length() as int
        if n >= 3
        {
            if (types.get_length() as int) > 2
            {
                ; Divide and conquer: A & B & C & D as (A & B) & (C & D). The
                ; reference's own comment is the reason — an intersection of unions
                ; often produces a far smaller union of intersections than the full
                ; cartesian product does, because many pairs reduce to never.
                let middle n / 2
                let left this.type_list_slice(type_set, 0, middle)
                let right this.type_list_slice(type_set, middle, n)
                let li this.get_intersection_type_ex(left, flags, null)
                if li = null
                    return null
                let ri this.get_intersection_type_ex(right, flags, null)
                if ri = null
                    return null
                let pair &Array[ref[Type]?]()
                pair.add(li)
                pair.add(ri)
                return this.get_intersection_type_ex(pair, flags, alias)
            }
        }
        if this.check_cross_product_union(type_set) = false
            return error_type
        let constituents this.get_cross_product_intersections(type_set, flags)
        if constituents = null
            return null
        let list constituents as ref[Array[ref[Type]?]]
        ; ★★★ THE DENORMALIZED ORIGIN, AND IT IS WHY get_union_type_from_sorted_list
        ; CARRIES AN ORIGIN PARAMETER AT ALL. It is attached only when at least one
        ; cross-product constituent is itself an intersection AND the union counts
        ; more constituents than the intersection it came from — i.e. exactly when
        ; printing the union would be wider than printing the intersection.
        var origin: ref[Type]? null
        if Checker.some_type_is_intersection(list)
        {
            if Checker.get_constituent_count_of_types(list) > Checker.get_constituent_count_of_types(type_set)
                set origin: this.new_intersection_type(ObjectFlagsNone, type_set)
        }
        this.get_union_type_ex(list, UnionReductionLiteral, alias, origin)
    }

    ; addTypesToIntersection and addTypeToIntersection. The set is INSERTION-ordered
    ; and deduplicated by IDENTITY (upstream `orderedSet[*Type]` is keyed on the
    ; pointer), which is the one structural difference from the union's walk — that
    ; one keeps its set SORTED, because a union's intern key is its sorted list.
    procedure add_types_to_intersection(this, type_set: ref[Array[ref[Type]?]], includes_in: int, types: ref[Array[ref[Type]?]]) returns int
    {
        var includes includes_in
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e = null
                return includes
            let regular this.get_regular_type_of_literal_type(e as ref[Type])
            if regular = null
                return includes
            set includes: this.add_type_to_intersection(type_set, includes, regular as ref[Type])
            set i: i + 1
        }
        includes
    }

    procedure add_type_to_intersection(this, type_set: ref[Array[ref[Type]?]], includes_in: int, t: ref[Type]) returns int
    {
        var includes includes_in
        let flags t.flags
        if (flags & TypeFlagsIntersection) <> 0
        {
            let sub Checker.union_or_intersection_types_of(t)
            if sub = null
                return includes
            return this.add_types_to_intersection(type_set, includes, sub as ref[Array[ref[Type]?]])
        }
        if this.is_empty_anonymous_object_type(t)
        {
            if (includes & TypeFlagsIncludesEmptyObject) = 0
            {
                set includes: includes | TypeFlagsIncludesEmptyObject
                type_set.add(t)
            }
            return includes
        }
        if (flags & TypeFlagsAnyOrUnknown) <> 0
        {
            if t = wildcard_type
                set includes: includes | TypeFlagsIncludesWildcard
            if this.is_error_type(t)
                set includes: includes | TypeFlagsIncludesError
            return includes | (flags & TypeFlagsIncludesMask)
        }
        ; `c.strictNullChecks || flags&Nullable == 0` — the option is true, so the
        ; branch always runs and the disjunction is not written as a test.
        var candidate t
        if t = missing_type
        {
            set includes: includes | TypeFlagsIncludesMissingType
            set candidate: undefined_type
        }
        if Checker.type_list_contains(type_set, candidate) = false
        {
            if (candidate.flags & TypeFlagsUnit) <> 0
            {
                ; Two distinct unit types: adding NonPrimitive is how the reference
                ; makes the disjoint-domain test above reduce this to never.
                if (includes & TypeFlagsUnit) <> 0
                    set includes: includes | TypeFlagsNonPrimitive
            }
            type_set.add(candidate)
        }
        includes | (flags & TypeFlagsIncludesMask)
    }

    ; removeRedundantSupertypes. Upstream walks BACKWARD and deletes in place; the
    ; survivors are collected in one forward pass here, and the two agree for
    ; removeRedundantLiteralTypes' reason — every condition reads `includes`, which
    ; is fixed before the walk starts, so no deletion can change one.
    procedure remove_redundant_supertypes(this, types: ref[Array[ref[Type]?]], includes: int) returns ref[Array[ref[Type]?]]
    {
        let out this.new_type_list(null)
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                let t e as ref[Type]
                var remove false
                if (t.flags & TypeFlagsString) <> 0
                {
                    if (includes & (TypeFlagsStringLiteral | TypeFlagsTemplateLiteral | TypeFlagsStringMapping)) <> 0
                        set remove: true
                }
                if (t.flags & TypeFlagsNumber) <> 0
                {
                    if (includes & TypeFlagsNumberLiteral) <> 0
                        set remove: true
                }
                if (t.flags & TypeFlagsBigInt) <> 0
                {
                    if (includes & TypeFlagsBigIntLiteral) <> 0
                        set remove: true
                }
                if (t.flags & TypeFlagsESSymbol) <> 0
                {
                    if (includes & TypeFlagsUniqueESSymbol) <> 0
                        set remove: true
                }
                if (t.flags & TypeFlagsVoid) <> 0
                {
                    if (includes & TypeFlagsUndefined) <> 0
                        set remove: true
                }
                if this.is_empty_anonymous_object_type(t)
                {
                    if (includes & TypeFlagsDefinitelyNonNullable) <> 0
                        set remove: true
                }
                if remove = false
                    out.add(t)
            }
            set i: i + 1
        }
        out
    }

    ; intersectUnionsOfPrimitiveTypes. If the list holds more than one union of
    ; primitive types, all but the first are removed and their INTERSECTION replaces
    ; the first — a type is kept when every one of those unions contains it.
    ;
    ; ★ The reference mutates `types` in place and returns it; here the surviving
    ; list is rebuilt, which is the same answer under the Array this port has.
    procedure intersect_unions_of_primitive_types(this, types: ref[Array[ref[Type]?]], out_reduced: ref[bool]) returns ref[Array[ref[Type]?]]
    {
        set out_reduced: false
        let n types.get_length() as int
        var index 0 - 1
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                if Checker.is_primitive_union(e as ref[Type])
                {
                    set index: i
                    set i: n
                }
            }
            set i: i + 1
        }
        if index < 0
            return types
        ; The unions to intersect: the one at `index` plus every later primitive
        ; union, which is also the set removed from the result list.
        let union_types this.new_type_list(null)
        let kept this.new_type_list(null)
        var j 0
        while j < n
        {
            let e types[j]
            if e <> null
            {
                let t e as ref[Type]
                var is_later_union false
                if j > index
                {
                    if (t.object_flags & ObjectFlagsPrimitiveUnion) <> 0
                        set is_later_union: true
                }
                if j = index
                    union_types.add(t)
                if is_later_union
                    union_types.add(t)
                if is_later_union = false
                    kept.add(t)
            }
            set j: j + 1
        }
        if (union_types.get_length() as int) = 1
            return types
        ; For each type in each union, keep it when every union contains it.
        let checked &Array[ref[Type]?]()
        let result this.new_type_list(null)
        let un union_types.get_length() as int
        var u 0
        while u < un
        {
            let ue union_types[u]
            if ue <> null
            {
                let ts Checker.union_types_of(ue as ref[Type])
                if ts <> null
                {
                    let list ts as ref[Array[ref[Type]?]]
                    let tn list.get_length() as int
                    var k 0
                    while k < tn
                    {
                        let te list[k]
                        if te <> null
                        {
                            let t te as ref[Type]
                            var found false
                            let at this.binary_search_type(checked, t, &found)
                            if found = false
                            {
                                Checker.insert_type_at(checked, at, t)
                                if this.each_union_contains(union_types, t)
                                    this.insert_undefined_missing_aware(result, t)
                            }
                        }
                        set k: k + 1
                    }
                }
            }
            set u: u + 1
        }
        let replacement this.get_union_type_from_sorted_list(result, ObjectFlagsPrimitiveUnion, null, null)
        if replacement = null
            return types
        ; Replace the first union with the result, in the list the later unions were
        ; removed from — `kept` already holds it at the same relative position.
        Checker.replace_first_type(kept, types[index], replacement)
        set out_reduced: true
        kept
    }

    ; The `undefinedType`/`missingType` special case of the insert above: the two
    ; sort first, so the reference leans on that to keep only one of them and to
    ; upgrade an undefined already in the result to missing.
    procedure insert_undefined_missing_aware(this, result: ref[Array[ref[Type]?]], t: ref[Type])
    {
        let have result.get_length() as int
        if have <> 0
        {
            let first result[0]
            if first <> null
            {
                if t = undefined_type
                {
                    if (first as ref[Type]) = missing_type
                        return
                }
                if t = missing_type
                {
                    if (first as ref[Type]) = undefined_type
                    {
                        result.put(0 as size_t, missing_type)
                        return
                    }
                }
            }
        }
        var found false
        let at this.binary_search_type(result, t, &found)
        if found = false
            Checker.insert_type_at(result, at, t)
    }

    ; eachUnionContains. A type is matched by an identical type, a literal type
    ; additionally by its corresponding PRIMITIVE, and missingType by undefinedType
    ; and the other way round.
    procedure each_union_contains(this, union_types: ref[Array[ref[Type]?]], t: ref[Type]) returns bool
    {
        let n union_types.get_length() as int
        var i 0
        while i < n
        {
            let ue union_types[i]
            if ue = null
                return false
            let ts Checker.union_types_of(ue as ref[Type])
            if ts = null
                return false
            let types ts as ref[Array[ref[Type]?]]
            if this.contains_type(types, t) = false
            {
                if t = missing_type
                    return this.contains_type(types, undefined_type)
                if t = undefined_type
                    return this.contains_type(types, missing_type)
                var primitive: ref[Type]? null
                if (t.flags & TypeFlagsStringLiteral) <> 0
                    set primitive: string_type
                if (t.flags & (TypeFlagsEnum | TypeFlagsNumberLiteral)) <> 0
                    set primitive: number_type
                if (t.flags & TypeFlagsBigIntLiteral) <> 0
                    set primitive: bigint_type
                if (t.flags & TypeFlagsUniqueESSymbol) <> 0
                    set primitive: es_symbol_type
                if primitive = null
                    return false
                if this.contains_type(types, primitive) = false
                    return false
            }
            set i: i + 1
        }
        true
    }

    ; getCrossProductIntersections — X & (A | B) & (C | D) becomes
    ; X & A & C | X & A & D | X & B & C | X & B & D, with the never constituents
    ; dropped.
    procedure get_cross_product_intersections(this, types: ref[Array[ref[Type]?]], flags: int) returns ref[Array[ref[Type]?]]?
    {
        let count Checker.get_cross_product_union_size(types)
        let n types.get_length() as int
        let out this.new_type_list(null)
        var i 0
        while i < count
        {
            let constituents this.new_type_list(types)
            var m i
            var j n - 1
            while j >= 0
            {
                let e types[j]
                if e = null
                    return null
                let t e as ref[Type]
                if (t.flags & TypeFlagsUnion) <> 0
                {
                    let ts Checker.union_types_of(t)
                    if ts = null
                        return null
                    let source ts as ref[Array[ref[Type]?]]
                    let length source.get_length() as int
                    constituents.put(j as size_t, source[m % length])
                    set m: m / length
                }
                set j: j - 1
            }
            let one this.get_intersection_type_ex(constituents, flags, null)
            if one = null
                return null
            if ((one as ref[Type]).flags & TypeFlagsNever) = 0
                out.add(one)
            set i: i + 1
        }
        out
    }

    ; checkCrossProductUnion and getCrossProductUnionSize. ★The overflow cap the
    ; reference added for Go's wrapping int is kept: the size is a product of
    ; constituent counts and 100 000 is the limit the report names.
    procedure check_cross_product_union(this, types: ref[Array[ref[Type]?]]) returns bool
    {
        let size Checker.get_cross_product_union_size(types)
        if size >= 100000
        {
            ; TS2590, at c.currentNode. ★★★The stop that stood here read *this port
            ; has no currentNode*; the field has been on the Checker since slice
            ; 154 and two limiters above report through it (the conditional-type
            ; tail count and instantiate_type's depth). The corpus does reach this
            ; — a cross product of 100 000 constituents is what
            ; `templateLiteralTypeTooComplex` and `normalizedIntersectionTooComplex`
            ; are named after.
            this.error_on_node(current_node, DiagExpression_produces_a_union_type_that_is_too_complex_to_represent)
            return false
        }
        true
    }

    function get_cross_product_union_size(types: ref[Array[ref[Type]?]]) returns int
    {
        var size 1
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                let t e as ref[Type]
                if (t.flags & TypeFlagsUnion) <> 0
                {
                    let ts Checker.union_types_of(t)
                    if ts <> null
                    {
                        let c (ts as ref[Array[ref[Type]?]]).get_length() as int
                        if c > 0
                        {
                            if size > (2147483647 / c)
                                return 2147483647
                        }
                        set size: size * c
                    }
                }
                if (t.flags & TypeFlagsNever) <> 0
                    return 0
            }
            set i: i + 1
        }
        size
    }

    ; getConstituentCount and getConstituentCountOfTypes — what the origin test
    ; above compares. An ALIASED union or intersection counts as ONE, which is the
    ; line that makes `type P = A | B` print as `P` inside a wider type.
    function get_constituent_count(t: ref[Type]) returns int
    {
        if (t.flags & TypeFlagsUnionOrIntersection) = 0
            return 1
        if t.alias_symbol <> null
            return 1
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let origin Checker.union_origin_of(t)
            if origin <> null
                return Checker.get_constituent_count(origin as ref[Type])
        }
        let ts Checker.union_or_intersection_types_of(t)
        if ts = null
            return 1
        Checker.get_constituent_count_of_types(ts as ref[Array[ref[Type]?]])
    }

    function get_constituent_count_of_types(types: ref[Array[ref[Type]?]]) returns int
    {
        var n 0
        let count types.get_length() as int
        var i 0
        while i < count
        {
            let e types[i]
            if e <> null
                set n: n + Checker.get_constituent_count(e as ref[Type])
            set i: i + 1
        }
        n
    }

    ; isPrimitiveUnion, isIntersectionType and the two isUnionWith* predicates,
    ; each specialised at its one use — §3.9's rule, since none of them can be
    ; written as a shared walk over a predicate value in this language.
    function is_primitive_union(t: ref[Type]) returns bool
        (t.object_flags & ObjectFlagsPrimitiveUnion) <> 0

    function some_type_is_intersection(types: ref[Array[ref[Type]?]]) returns bool
    {
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                if ((e as ref[Type]).flags & TypeFlagsIntersection) <> 0
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; `c.filterTypes(types, predicate)` at the two flag predicates its only two
    ; callers pass — filterType per constituent, into a NEW list.
    ;
    ; ★★★ UPSTREAM REWRITES THE SLICE IN PLACE (`types[i] = c.filterType(...)`)
    ; AND THIS ONE MUST NOT. `typeSet` there is a local the intersection built;
    ; here the same Array is the caller's `type_set`, which the arms below still
    ; read — the divide-and-conquer arm slices it and the cross product walks it —
    ; so an in-place filter would hand a later arm a set that no longer says what
    ; its own predicate answered about. A new list costs one allocation on a path
    ; that is already minting a union.
    procedure filter_types_outside_flags(this, types: ref[Array[ref[Type]?]], mask: int) returns ref[Array[ref[Type]?]]?
    {
        let mark this.unported_mark()
        let n types.get_length() as int
        let out this.new_type_list(null)
        var i 0
        while i < n
        {
            let e types[i]
            if e = null
                return null
            let f this.filter_type_outside_flags(e as ref[Type], mask)
            if this.unported_mark() <> mark
                return null
            if f = null
                return null
            out.add(f)
            set i: i + 1
        }
        out
    }

    ; `core.Some(typeSet, c.containsMissingType)`.
    function some_type_contains_missing(this, types: ref[Array[ref[Type]?]]) returns bool
    {
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let e types[i]
            if e <> null
            {
                if this.contains_missing_type(e as ref[Type])
                    return true
            }
            set i: i + 1
        }
        false
    }

    function every_type_is_union_with_undefined(types: ref[Array[ref[Type]?]]) returns bool
        Checker.every_type_is_union_starting_with(types, TypeFlagsUndefined)

    ; isUnionWithNull: `t.Types()[0].flags&Null != 0 || t.Types()[1].flags&Null != 0` — the FIRST
    ; OR SECOND member, because `undefined` sorts before `null` and `T | null | undefined` reads
    ; `undefined | null | T` by type id (slice 207; `unknownControlFlow`'s `T & {} | null`)
    function every_type_is_union_with_null(types: ref[Array[ref[Type]?]]) returns bool
    {
        let n types.get_length() as int
        if n = 0
            return true
        var i 0
        while i < n
        {
            let e types[i]
            if e = null
                return false
            let t e as ref[Type]
            if (t.flags & TypeFlagsUnion) = 0
                return false
            let ts Checker.union_types_of(t)
            if ts = null
                return false
            let list ts as ref[Array[ref[Type]?]]
            let m list.get_length() as int
            if m = 0
                return false
            var hit false
            let first list[0]
            if first <> null
            {
                if ((first as ref[Type]).flags & TypeFlagsNull) <> 0
                    set hit: true
            }
            if m > 1
            {
                let second list[1]
                if second <> null
                {
                    if ((second as ref[Type]).flags & TypeFlagsNull) <> 0
                        set hit: true
                }
            }
            if hit = false
                return false
            set i: i + 1
        }
        true
    }

    ; `t.flags&Union != 0 && t.Types()[0].flags&<f> != 0` — the FIRST constituent,
    ; which is exact rather than a scan because undefined and null sort in front of
    ; everything but any and unknown.
    function every_type_is_union_starting_with(types: ref[Array[ref[Type]?]], f: int) returns bool
    {
        let n types.get_length() as int
        if n = 0
            return true
        var i 0
        while i < n
        {
            let e types[i]
            if e = null
                return false
            let t e as ref[Type]
            if (t.flags & TypeFlagsUnion) = 0
                return false
            let ts Checker.union_types_of(t)
            if ts = null
                return false
            let list ts as ref[Array[ref[Type]?]]
            if (list.get_length() as int) = 0
                return false
            let first list[0]
            if first = null
                return false
            if ((first as ref[Type]).flags & f) = 0
                return false
            set i: i + 1
        }
        true
    }

    ; IsEmptyAnonymousObjectType and isPrimitiveOrObjectOrEmptyType — the pair the
    ; IncludesEmptyObject bit is decided by. ★The first disjunct asks the RESOLVED
    ; members and the second asks the SYMBOL, and the second is what answers for a
    ; `{}` annotation whose members were never resolved.
    procedure is_empty_anonymous_object_type(this, t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsAnonymous) = 0
            return false
        if (t.object_flags & ObjectFlagsMembersResolved) <> 0
        {
            let sm this.resolve_structured_type_members(t)
            if sm <> null
            {
                if Checker.is_empty_resolved_type(sm as ref[StructuredMembers])
                    return true
            }
        }
        if t.symbol = null
            return false
        let sym t.symbol as ref[Symbol]
        if (Symbol.flags_of(sym) & SymbolFlagsTypeLiteral) = 0
            return false
        let members this.get_members_of_symbol(sym)
        SymbolTable.length(members) = 0
    }

    procedure is_primitive_or_object_or_empty_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & (TypeFlagsPrimitive | TypeFlagsNonPrimitive)) <> 0
            return true
        this.is_empty_anonymous_object_type(t)
    }

    ; `everyType(constraint, c.isPrimitiveOrObjectOrEmptyType)` — the one specialised
    ; everyType this chapter needs. everyType walks a union's constituents and
    ; otherwise asks the type itself.
    procedure every_type_is_primitive_or_object_or_empty(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_primitive_or_object_or_empty_type(t)
        let ts Checker.union_types_of(t)
        if ts = null
            return false
        let list ts as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i]
            if e = null
                return false
            if this.is_primitive_or_object_or_empty_type(e as ref[Type]) = false
                return false
            set i: i + 1
        }
        true
    }

    ; `types[slices.Index(types, from)] = to` — the in-place replacement of the one
    ; slot holding `from`, which two sites of this chapter need.
    procedure replace_first_type(list: ref[Array[ref[Type]?]], from: ref[Type]?, to: ref[Type]?)
    {
        let n list.get_length() as int
        var i 0
        while i < n
        {
            if list[i] = from
            {
                list.put(i as size_t, to)
                return
            }
            set i: i + 1
        }
    }

    ; `types[a:b]` — a fresh list over a half-open range, which the divide-and-
    ; conquer branch needs and Array cannot give as a view.
    procedure type_list_slice(this, list: ref[Array[ref[Type]?]], from: int, to: int) returns ref[Array[ref[Type]?]]
    {
        let out this.new_type_list(null)
        var i from
        while i < to
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    ; newIntersectionType, and the intern table's two halves. The key is
    ; getIntersectionKey(typeSet, flags, alias) — and unlike the union's, its FLAGS
    ; are not derivable from the type, so the table holds an ENTRY rather than a
    ; bare type.
    procedure new_intersection_type(this, object_flags: int, types: ref[Array[ref[Type]?]]) returns ref[Type]
        this.new_type(TypeFlagsIntersection, object_flags, null, TypeData.Intersection(box_node_data[IntersectionTypeData](host, IntersectionTypeData(types))))

    ; an intersection's key as a hash: its key list and its flags
    function intersection_key_hash(types: ref[Array[ref[Type]?]]?, flags: int) returns int
        Checker.type_list_hash(types) xor (flags * 1000003)

    procedure find_intersection_type(this, types: ref[Array[ref[Type]?]], flags: int, alias: ref[TypeAlias]?) returns ref[Type]?
    {
        let n types.get_length() as int
        let count intersection_types.get_length() as int
        let chain intersection_chain
        while chain.count() < count
        {
            let pending intersection_types[chain.count() as size_t]
            if pending = null
                chain.add_blank()
            else
            {
                let pe pending as ref[IntersectionEntry]
                chain.add(Checker.intersection_key_hash(pe.key_types, pe.key_flags))
            }
        }
        var i chain.first(Checker.intersection_key_hash(types, flags))
        while i >= 0
        {
            let row intersection_types[i as size_t]
            if row <> null
            {
                let entry row as ref[IntersectionEntry]
                if entry.key_flags = flags
                {
                    if entry.t <> null
                    {
                        let t entry.t as ref[Type]
                        let ts Checker.union_or_intersection_types_of(t)
                        var same false
                        if ts <> null
                        {
                            let list ts as ref[Array[ref[Type]?]]
                            if (list.get_length() as int) = n
                            {
                                set same: true
                                var j 0
                                while j < n
                                {
                                    if list[j] <> types[j]
                                        set same: false
                                    set j: j + 1
                                }
                            }
                        }
                        ; A DISTRIBUTED result is a union rather than an
                        ; intersection, so its own constituent list is not the key —
                        ; the key list is remembered on the entry instead.
                        if ts = null
                            set same: Checker.type_lists_identical(entry.key_types, types)
                        if same
                        {
                            if Checker.type_alias_matches(t, alias)
                                return t
                        }
                    }
                }
            }
            set i: chain.after(i)
        }
        null
    }

    procedure intern_intersection_type(this, types: ref[Array[ref[Type]?]], flags: int, t: ref[Type])
        intersection_types.add(&IntersectionEntry^host(flags, types, t))

    ; IntersectionType.types, as a question about the tag — and the pair with
    ; union_types_of that the reference spells `AsUnionOrIntersectionType().Types()`.
    function intersection_types_of(t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when d: Intersection
                return d.types
        null
    }

    ; The payload accessors for the five instantiable arms — this file's standing
    ; idiom, each answering null for a type that is not of that kind where the
    ; reference's `As*Type()` would panic.
    ; `slices.Equal(source.texts, target.texts)` — the template literal's literal
    ; spans, byte for byte. ★A String comparison and not an identity one: two
    ; template literal types minted from different nodes carry different String
    ; objects with the same content.
    function template_texts_equal(a: ref[Type], b: ref[Type]) returns bool
    {
        let at Checker.template_literal_texts_of(a)
        let bt Checker.template_literal_texts_of(b)
        if at = null
            return false
        if bt = null
            return false
        let al at as ref[Array[ref[String]?]]
        let bl bt as ref[Array[ref[String]?]]
        let n al.get_length() as int
        if (bl.get_length() as int) <> n
            return false
        var i 0
        while i < n
        {
            let x al[i]
            let y bl[i]
            if x = null
                return false
            if y = null
                return false
            if (x as ref[String]) <> (y as ref[String])
                return false
            set i: i + 1
        }
        true
    }

    function index_target_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Index
                return d.target
        null
    }

    function index_flags_of(t: ref[Type]) returns int
    {
        choose t.data
            when d: Index
                return d.index_flags
        0
    }

    ; `t.AsUniqueESSymbolType().name` — slice 146. ★It answers an EMPTY slice for
    ; every other arm, and every caller has tested TypeFlagsUniqueESSymbol first,
    ; so the empty answer is the reference's refused cast and not a value.
    function unique_es_symbol_name_of(t: ref[Type]) returns Slice[char]
    {
        choose t.data
            when d: UniqueESSymbol
                return d.name
        Slice[char]()
    }

    function indexed_access_object_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: IndexedAccess
                return d.object_type
        null
    }

    function indexed_access_index_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: IndexedAccess
                return d.index_type
        null
