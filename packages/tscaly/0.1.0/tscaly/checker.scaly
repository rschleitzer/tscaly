            {
                this.error_on_node(tag, DiagIt_is_likely_that_you_are_missing_a_comma_to_separate_these_two_template_expressions_They_form_a_tagged_template_expression_which_cannot_be_invoked)
                return this.resolve_error_call(node)
            }
            this.invocation_error(tag, apparent_type as ref[Type], SignatureKindCall)
            return this.resolve_error_call(node)
        }
        this.resolve_call(node, call_signatures, check_mode, SignatureFlagsNone, 0)
    }

    procedure resolve_call(this, node: ref[AstNode], signatures: ref[Array[ref[Signature]?]]?, check_mode: int, call_chain_flags: int, head_code: int) returns ref[Signature]?
    {
        let mark this.unported_mark()
        ; "We already perform checking on the type arguments on the class
        ; declaration itself" — the inner guard's exclusion is the `super` callee.
        ;
        ; ★★★ THE OUTER GUARD IS FOUR DISJUNCTS AND THIS PORT CARRIED ONE, ON A
        ; PREMISE SLICE 152 EXPIRED. The note that stood here read *a bare
        ; `super(...)` stops in check_super_expression long before this* and wrote
        ; only the DECORATOR test, because the other three arrivals were
        ; unreachable when slice 134 wrote it. Slice 152 opened two of them in one
        ; go — resolve_call_expression's super branch and
        ; resolve_instanceof_expression — and the missing `!isSuperCall(node)`
        ; showed up immediately as an INVENTED TS2558 on `super<T>()`: the call's
        ; own type arguments were read and checked for arity against the base
        ; constructor, which the reference deliberately does not do.
        ;
        ; ★★★ **A GUARD WRITTEN WITH ITS UNREACHABLE DISJUNCTS LEFT OUT IS A STOP
        ; WITH NO TAG.** Nothing records it, `frontier.sh` cannot rank it and
        ; `expiredstops.py` cannot see it — the first evidence is a wrong answer in
        ; the slice that opens the route. Write the whole condition and let the
        ; unreachable disjuncts be dead; they cost nothing and they are the only
        ; part of the line that a later slice needs.
        var type_arguments: ref[Array[ref[AstNode]?]]? null
        var reads_type_arguments true
        if AstNode.kind_of(node) = KindDecorator
            set reads_type_arguments: false
        if AstNode.kind_of(node) = KindBinaryExpression
            set reads_type_arguments: false
        if Checker.is_super_call(node)
            set reads_type_arguments: false
        if AstNode.kind_of(node) = KindJsxOpeningFragment
            set reads_type_arguments: false
        if reads_type_arguments
        {
            set type_arguments: AstNode.type_arguments_of(node)
            var checks_them false
            if AstNode.kind_of(node) = KindTaggedTemplateExpression
                set checks_them: true
            if AstNode.is_jsx_opening_like_element(node)
                set checks_them: true
            if Checker.kind_or_unknown(AstNode.expression_of(node)) <> KindSuperKeyword
                set checks_them: true
