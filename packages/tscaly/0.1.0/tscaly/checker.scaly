                continue
            ; the pattern text without its quotes
            let text nd.subslice(1, (nd.length - 1))
            let star slice_index_of_byte(text, ("*" as char) as int)
            if star < 0
                continue
            if star <= longest
                continue
            let prefix text.subslice(0, star as size_t)
            let suffix text.slice_from((star + 1) as size_t)
