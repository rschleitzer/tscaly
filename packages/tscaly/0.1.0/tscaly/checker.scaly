                        return
                    this.apply_mapped_key_callback(ms, ks, lt as ref[Type])
                    if this.unported_mark() <> mark
                        return
                }
                set i: i + 1
            }
        }
        if (t.flags & TypeFlagsAny) <> 0
        {
            this.apply_mapped_key_callback(ms, ks, string_type)
            return
        }
        let infos this.get_index_infos_of_type(t)
        if this.unported_mark() <> mark
            return
        if infos = null
            return
        let ilist infos as ref[Array[ref[IndexInfo]?]]
        let m ilist.get_length() as int
        var j 0
        while j < m
        {
            let row ilist[j]
            if row <> null
            {
                let info row as ref[IndexInfo]
                if info.key_type <> null
                {
                    var take true
                    if strings_only
                    {
                        set take: false
                        if ((info.key_type as ref[Type]).flags & (TypeFlagsString | TypeFlagsTemplateLiteral)) <> 0
                            set take: true
                    }
                    if take
                    {
                        this.apply_mapped_key_callback(ms, ks, info.key_type as ref[Type])
                        if this.unported_mark() <> mark
                            return
                    }
                }
            }
            set j: j + 1
        }
    }

    procedure apply_mapped_key_callback(this, ms: ref[MappedMemberState]?, ks: ref[MappedKeyState]?, key_type: ref[Type])
    {
        if ms <> null
        {
            this.add_member_for_key_type(ms as ref[MappedMemberState], key_type)
            return
        }
        if ks <> null
            this.add_key_for_key_type(ks as ref[MappedKeyState], key_type)
    }

    ; getIndexTypeForMappedType's `addMemberForKeyType` — it collects KEYS where
    ; the member walk collects symbols. ★The `string` → `string | number` step is
    ; the reference's own and its comment names the reason: `keyof` answers
    ; `string | number` for a concrete string index signature, and
    ; getLiteralTypeFromProperties has the same ternary so that the two agree.
    procedure add_key_for_key_type(this, ks: ref[MappedKeyState], key_type: ref[Type])
    {
        let mark this.unported_mark()
        var prop_name_type: ref[Type]? key_type
        if ks.name_type <> null
        {
            let m this.append_type_mapping(Checker.mapper_of(ks.mapped), ks.type_parameter, key_type)
            set prop_name_type: this.instantiate_type(ks.name_type, m as ref[TypeMapper]?)
            if this.unported_mark() <> mark
                return
            if prop_name_type = null
                return
        }
        if ks.widen_string
        {
            if (prop_name_type as ref[Type]) = string_type
            {
                if string_or_number_type = null
                {
                    this.record_unported("string-or-number-type-unminted", 0)
                    return
                }
                ks.keys.add(string_or_number_type)
                return
            }
        }
        ks.keys.add(prop_name_type)
    }

    ; getIndexTypeForMappedType. ★★★THE REFERENCE'S COMMENT IS THE ARGUMENT AND IT
    ; IS WORTH KEEPING: this roughly mirrors resolveMappedTypeMembers, except that
    ; it reports a UNION OF THE KEYS rather than manufacturing the properties —
    ; and it cannot simply answer the constraint type, because that ignores the
    ; `as` remapping and because mapping the constraint directly ignores that a
    ; mapped type maps PROPERTIES and not keys.
    procedure get_index_type_for_mapped_type(this, t: ref[Type], index_flags: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let type_parameter this.get_type_parameter_from_mapped_type(t)
        if this.unported_mark() <> mark
            return null
        let constraint_type this.get_constraint_type_from_mapped_type(t)
        if this.unported_mark() <> mark
            return null
        if constraint_type = null
            return null
        var source t
        let tgt Checker.target_of(t)
        if tgt <> null
            set source: tgt as ref[Type]
        let name_type this.get_name_type_from_mapped_type(source)
        if this.unported_mark() <> mark
            return null
        if name_type = null
        {
            ; No mapping and no filtering — the constraint IS the key type.
            if (index_flags & IndexFlagsNoIndexSignatures) = 0
                return constraint_type
        }
        let keys this.new_type_list(null)
        let ks &MappedKeyState^host(t, type_parameter, name_type, keys, true)
        ; Calling getApparentType on the `T` of a `keyof T` in a GENERIC
        ; constraint can be circular (`T extends { [P in keyof T & string as
        ; Capitalize<P>]: any }`), so the keys are manifested eagerly only when
        ; the constraint is not generic.
        let generic this.is_generic_index_type(constraint_type as ref[Type])
        if this.unported_mark() <> mark
            return null
        if generic
        {
            if Checker.is_mapped_type_with_keyof_constraint_declaration(t)
                return this.get_index_type_for_generic_type(t, index_flags)
            this.for_each_type_add_key(ks, constraint_type as ref[Type])
            if this.unported_mark() <> mark
                return null
        }
        if generic = false
        {
            if Checker.is_mapped_type_with_keyof_constraint_declaration(t)
            {
                let ms this.get_modifiers_type_from_mapped_type(t)
                if this.unported_mark() <> mark
                    return null
                if ms = null
                    return null
                let modifiers_type this.get_apparent_type(ms as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if modifiers_type = null
                    return null
                var strings_only false
                if (index_flags & IndexFlagsStringsOnly) <> 0
                    set strings_only: true
                this.for_each_mapped_type_key(modifiers_type as ref[Type], TypeFlagsStringOrNumberLiteralOrUnique, strings_only, null, ks)
                if this.unported_mark() <> mark
                    return null
            }
            if Checker.is_mapped_type_with_keyof_constraint_declaration(t) = false
            {
                let lower this.get_lower_bound_of_key_type(constraint_type as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if lower = null
                    return null
                this.for_each_type_add_key(ks, lower as ref[Type])
                if this.unported_mark() <> mark
                    return null
            }
        }
        var result this.get_union_type(ks.keys)
        if this.unported_mark() <> mark
            return null
        if result = null
            return null
        if (index_flags & IndexFlagsNoIndexSignatures) <> 0
        {
            set result: this.filter_type_not_any_or_string(result as ref[Type])
            if this.unported_mark() <> mark
                return null
            if result = null
                return null
        }
        ; The constraint is preserved when the manifested list is the same union,
        ; so that its alias and origin survive. ★`getTypeListKey` upstream is a
        ; string of type IDS in order, which is exactly this identity comparison.
        let r result as ref[Type]
        if (r.flags & TypeFlagsUnion) <> 0
        {
            if ((constraint_type as ref[Type]).flags & TypeFlagsUnion) <> 0
            {
                if Checker.type_lists_equal(Checker.union_types_of(r), Checker.union_types_of(constraint_type as ref[Type]))
                    return constraint_type
            }
        }
        result
    }

    procedure for_each_type_add_key(this, ks: ref[MappedKeyState], t: ref[Type])
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            this.add_key_for_key_type(ks, t)
            return
        }
        let types Checker.union_types_of(t)
        if types = null
            return
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let u list[i]
            if u <> null
            {
                this.add_key_for_key_type(ks, u as ref[Type])
                if this.unported_mark() <> mark
                    return
            }
            set i: i + 1
        }
    }

    ; `filterType(t, func(t) { return t.flags&(Any|String) == 0 })` — one
    ; predicate loop, on §3.5e's rule.
    procedure filter_type_not_any_or_string(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) = 0
        {
            if (t.flags & (TypeFlagsAny | TypeFlagsString)) <> 0
                return never_type
            return t
        }
        let mark this.unported_mark()
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let out &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let u list[i]
            if u <> null
            {
                if ((u as ref[Type]).flags & (TypeFlagsAny | TypeFlagsString)) = 0
                    out.add(u)
                else
                    set changed: true
            }
            set i: i + 1
        }
        if changed = false
            return t
        let r this.get_union_type_ex(out, UnionReductionNone, null, null)
        if this.unported_mark() <> mark
            return null
        r
    }

    ; getApparentMappedTypeKeys — `keyof` of a mapped type whose keys were
    ; remapped, used by the relation's index-signature arm.
    procedure get_apparent_mapped_type_keys(this, name_type: ref[Type], target_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let ms this.get_modifiers_type_from_mapped_type(target_type)
        if this.unported_mark() <> mark
            return null
        if ms = null
            return null
        let modifiers_type this.get_apparent_type(ms as ref[Type])
        if this.unported_mark() <> mark
            return null
        if modifiers_type = null
            return null
        let tp this.get_type_parameter_from_mapped_type(target_type)
        if this.unported_mark() <> mark
            return null
        let keys this.new_type_list(null)
        let ks &MappedKeyState^host(target_type, tp, name_type, keys, false)
        this.for_each_mapped_type_key(modifiers_type as ref[Type], TypeFlagsStringOrNumberLiteralOrUnique, false, null, ks)
        if this.unported_mark() <> mark
            return null
        this.get_union_type(ks.keys)
    }

    ; createNormalizedTypeReference, whole since slice 115 — the note that stood
    ; here (*"the tuple arm needs the tuple element info this port does not
    ; build"*) is that slice's own expiry.
    procedure create_normalized_type_reference(this, target: ref[Type], type_arguments: ref[Array[ref[Type]?]]?) returns ref[Type]?
    {
        if (target.object_flags & ObjectFlagsTuple) <> 0
            return this.create_normalized_tuple_type(target, type_arguments)
        this.create_type_reference(target, type_arguments, ObjectFlagsNone)
    }

    ; instantiateList, four times. The reference has ONE generic function and this
    ; port has four copies, on §3.9's rule: a generic over a comparable element
    ; would have to be written against `Array[ref[T]?]` with an identity operator,
    ; and the four element types share no concept that gives one.
    ;
    ; ★★ THE IDENTITY OF THE ANSWER IS THE POINT, not a saving: the caller tests
    ; `mapped == values` to decide whether anything changed at all, and
    ; instantiate_type_worker's Reference arm reads exactly that to answer the type
    ; it was handed rather than mint a fresh reference to the same thing.
    procedure instantiate_types(this, types: ref[Array[ref[Type]?]]?, m: ref[TypeMapper]) returns ref[Array[ref[Type]?]]?
    {
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let mapped this.instantiate_type(list[i], m)
            if this.unported_mark() <> mark
                return null
            if mapped <> list[i]
            {
                let out this.new_type_list(null)
                var j 0
                while j < i
                {
                    out.add(list[j])
                    set j: j + 1
                }
                out.add(mapped)
                set j: i + 1
                while j < n
                {
                    let later this.instantiate_type(list[j], m)
                    if this.unported_mark() <> mark
                        return null
                    out.add(later)
                    set j: j + 1
                }
                return out
            }
            set i: i + 1
        }
        types
    }

    procedure instantiate_symbols(this, symbols: ref[Array[ref[Symbol]?]]?, m: ref[TypeMapper]) returns ref[Array[ref[Symbol]?]]?
    {
        if symbols = null
            return null
        let list symbols as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let mapped this.instantiate_symbol(list[i], m)
            if this.unported_mark() <> mark
                return null
            if mapped <> list[i]
            {
                let out this.new_symbol_list()
                var j 0
                while j < i
                {
                    out.add(list[j])
                    set j: j + 1
                }
                out.add(mapped)
                set j: i + 1
                while j < n
                {
                    let later this.instantiate_symbol(list[j], m)
                    if this.unported_mark() <> mark
                        return null
                    out.add(later)
                    set j: j + 1
                }
                return out
            }
            set i: i + 1
        }
        symbols
    }

    procedure instantiate_signatures(this, signatures: ref[Array[ref[Signature]?]]?, m: ref[TypeMapper]) returns ref[Array[ref[Signature]?]]?
    {
        if signatures = null
            return null
        let list signatures as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let mapped this.instantiate_signature(list[i], m)
            if this.unported_mark() <> mark
                return null
            if mapped <> list[i]
            {
                let out this.new_signature_list()
                var j 0
                while j < i
                {
                    out.add(list[j])
                    set j: j + 1
                }
                out.add(mapped)
                set j: i + 1
                while j < n
                {
                    let later this.instantiate_signature(list[j], m)
                    if this.unported_mark() <> mark
                        return null
                    out.add(later)
                    set j: j + 1
                }
                return out
            }
            set i: i + 1
        }
        signatures
    }

    procedure instantiate_index_infos(this, index_infos: ref[Array[ref[IndexInfo]?]]?, m: ref[TypeMapper]) returns ref[Array[ref[IndexInfo]?]]?
    {
        if index_infos = null
            return null
        let list index_infos as ref[Array[ref[IndexInfo]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let mapped this.instantiate_index_info(list[i], m)
            if this.unported_mark() <> mark
                return null
            if mapped <> list[i]
            {
                let out this.new_index_info_list()
                var j 0
                while j < i
                {
                    out.add(list[j])
                    set j: j + 1
                }
                out.add(mapped)
                set j: i + 1
                while j < n
                {
                    let later this.instantiate_index_info(list[j], m)
                    if this.unported_mark() <> mark
                        return null
                    out.add(later)
                    set j: j + 1
                }
                return out
            }
            set i: i + 1
        }
        index_infos
    }

    ; instantiateSymbol, and its two fast paths are the slice.
    ;
    ; ★★★ THE FIRST ONE IS WHAT MAKES THE CHAPTER REACHABLE: a mapper that maps
    ; nothing but `this` against a member whose declaration is free of `this`
    ; answers the member itself. The second is the reference's own memo-shaped
    ; shortcut — a member whose type is already resolved and cannot contain a type
    ; variable is likewise unaffected.
    ;
    ; ★★★ THE THIRD BRANCH IS THE FIRST TRANSIENT SYMBOL THIS PORT HAS EVER MADE,
    ; and it is what turns get_type_of_symbol's *"not merely unreached,
    ; UNREPRESENTABLE"* into one representable arm out of four. It costs a bit on
    ; Symbol (`check_flags`), two slots on ValueSymbolLink (`target`, `mapper`) and
    ; getTypeOfInstantiatedSymbol; the other three CheckFlags arms still have no
    ; writer and are still left out.
    ;
    ; ★★ `links.nameType` IS THE ONE FIELD THE COPY DOES NOT CARRY, deliberately:
    ; ValueSymbolLink has no such slot, its reader is symbolToString's late-bound
    ; arm, and a slot copied for no reader is §3.5be's claim about the future.
    procedure instantiate_symbol(this, symbol: ref[Symbol]?, m: ref[TypeMapper]?) returns ref[Symbol]?
    {
        if symbol = null
            return null
        let sym symbol as ref[Symbol]
        let links this.value_symbol_link_of(sym)
        if m <> null
        {
            if Checker.type_mapper_maps_this_only(m as ref[TypeMapper])
            {
                if Checker.is_thisless(sym)
                    return symbol
            }
        }
        if links.resolved_type <> null
        {
            let mark this.unported_mark()
            let could this.could_contain_type_variables(links.resolved_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if could = false
            {
                if (Symbol.flags_of(sym) & SymbolFlagsSetAccessor) = 0
                    return symbol
                ; "If we're a setter, check writeType." WHOLE since slice 159 —
                ; the slot the old note called absent had been declared by slice
                ; 127 and `get_write_type_of_symbol` reads it (§3.5eo; the account
                ; is at `get_write_type_of_instantiated_symbol`).
                ;
                ; ★★ THE SLOT IS READ RATHER THAN COMPUTED, which is the reference's
                ; own shape and not a shortcut: the test is *if it is already
                ; resolved and cannot be affected*, so a nil `writeType` means the
                ; question has not been asked and the symbol must be instantiated —
                ; computing it here would force the setter's annotation on a symbol
                ; nothing has asked to write through.
                if links.write_type <> null
                {
                    let could_w this.could_contain_type_variables(links.write_type as ref[Type])
                    if this.unported_mark() <> mark
                        return null
                    if could_w = false
                        return symbol
                }
            }
        }
        ; The already-instantiated branch, slice 139: re-instantiating walks to the
        ; ORIGINAL and composes the two mappers, so the result's target is never a
        ; transient symbol and the mapper chain never grows a link per round.
        var sym_out: ref[Symbol]? symbol
        var m_out: ref[TypeMapper]? m
        if (Symbol.check_flags_of(sym) & CheckFlagsInstantiated) <> 0
        {
            set sym_out: links.target
            if sym_out = null
                return null
            set m_out: this.combine_type_mappers(links.mapper, m)
        }
        ; ★★★ `result.CheckFlags = Instantiated | symbol.CheckFlags&(Readonly|Late|
        ; OptionalParameter|RestParameter)`, and TWO OF THE FOUR ARE LIVE SINCE
        ; SLICE 139. The sentence that stood here called the masked half empty
        ; because *getLateBoundSymbol and createSymbolWithType, neither of which
        ; exists* — both exist, `create_symbol_with_type` writes Readonly and
        ; `get_late_bound_symbol` writes Late, so an instantiated readonly property
        ; was silently losing its readonly bit (§3.5eo). ★★★AND SLICE 155 MADE THE
        ; OTHER TWO LIVE, BY THE SAME CORRECTION ONE STEP OUT: the note said
        ; RestParameter and OptionalParameter are *written only by
        ; getExpandedParameters' tuple expansion*, and
        ; combineUnionOrIntersectionParameters writes both. The mask is upstream's
        ; whole one now. **A claim naming ONE producer is a claim about a set the
        ; note could not enumerate** — the same sentence in
        ; write_parameter_declaration's header expired in the same slice.
        let src sym_out as ref[Symbol]
        let result this.new_symbol(Symbol.flags_of(src), Symbol.name_of(src))
        Symbol.set_check_flags(result, CheckFlagsInstantiated | (Symbol.check_flags_of(src) & (CheckFlagsReadonly | CheckFlagsLate | CheckFlagsOptionalParameter | CheckFlagsRestParameter)))
        Symbol.copy_declarations_from(result, src)
        let result_links this.value_symbol_link_of(result)
        set result_links.target: sym_out
        set result_links.mapper: m_out
        ; ★★★ `resultLinks.nameType = links.nameType` — upstream's LAST line, and it
        ; was missing until slice 183. A late-bound member carries its name in the
        ; nameType slot, not in `Symbol.Name`, so an instantiated one whose slot is
        ; empty prints the internal `\uFFFD@sym@1` spelling of its name as a QUOTED
        ; string where the reference prints `[sym]`. It was invisible for as long as
        ; `property-name-from-unique-symbol` was a stop in front of the only reader;
        ; retiring the stop in this slice published it, which is §3.5hl's pattern a
        ; second time. ★It is `links` and not `result_links.target`'s links: the
        ; already-instantiated branch above may have walked `sym_out` back to the
        ; ORIGINAL symbol, and upstream reads the slot off the symbol it was CALLED
        ; with.
        set result_links.name_type: links.name_type
        result
    }

    ; instantiateSymbolTable. It answers a FRESH table whenever the source is
    ; non-empty, exactly as upstream — even when every entry came back unchanged —
    ; because the caller folds base members into it and must not touch the DECLARED
    ; one.
    ; createInstantiatedSymbolTable — instantiate_symbol_table over a symbol LIST
    ; rather than a table. The two are not one function because the reference's two
    ; are not: the members of an instantiated anonymous type come from
    ; getPropertiesOfObjectType, which answers a list, and its ORDER is what the
    ; resulting table's order is.
    procedure create_instantiated_symbol_table(this, symbols: ref[Array[ref[Symbol]?]]?, m: ref[TypeMapper]) returns ref[SymbolTable]?
    {
        if symbols = null
            return null
        let list symbols as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        if n = 0
            return null
        let out SymbolTable.create(host)
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let sym list[i]
            if sym <> null
            {
                let s sym as ref[Symbol]
                let inst this.instantiate_symbol(sym, m)
                if this.unported_mark() <> mark
                    return null
                SymbolTable.set_entry(host, out, Symbol.name_of(s), inst)
            }
            set i: i + 1
        }
        out
    }

    procedure instantiate_symbol_table(this, symbols: ref[SymbolTable]?, m: ref[TypeMapper]) returns ref[SymbolTable]?
    {
        if symbols = null
            return null
        let n SymbolTable.length(symbols)
        if n = 0
            return null
        let out SymbolTable.create_sized(host, n)
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let sym SymbolTable.entry_symbol_at(symbols, i)
            let nd SymbolTable.entry_name_at(symbols, i)
            ; `if c.isNamedMember(symbol, id)` — the reserved `\xFE` names (the
            ; call, construct and index signature symbols) and the non-value
            ; members are not instantiated. Left out until slice 350: 294 421
            ; symbols too many over the whole of VS Code, each with its link and
            ; its table entry.
            if this.is_named_member(sym, nd)
            {
                let inst this.instantiate_symbol(sym, m)
                if this.unported_mark() <> mark
                    return null
                SymbolTable.set_entry(host, out, nd, inst)
            }
            set i: i + 1
        }
        out
    }

    ; instantiateSignature — `instantiateSignatureEx(sig, m, m == c.permissiveMapper)`.
    ;
    ; ★ Since slice 122 the eraseTypeParameters argument is carried, because
    ; getSignatureInstantiation passes TRUE and that is exactly the value that
    ; skips the fresh-type-parameter branch below. The two older callers pass
    ; false and are unchanged.
    ;
    ; ★★★ AND SINCE SLICE 151 THE ARGUMENT IS THE REFERENCE'S OWN EXPRESSION, where
    ; it had been folded to `false` with the note *"the permissive mapper is a
    ; FunctionTypeMapper this port has no arm for"*. It is a POINTER comparison
    ; against the memoised mapper — see the field's note on why the two are memoised
    ; at all — and its effect is that a signature instantiated PERMISSIVELY loses its
    ; own type parameters instead of getting fresh clones of them, which is what
    ; makes the wildcard comparison decide anything about a generic signature.
    procedure instantiate_signature(this, sig: ref[Signature]?, m: ref[TypeMapper]) returns ref[Signature]?
    {
        var erase false
        if permissive_mapper <> null
        {
            if m = permissive_mapper as ref[TypeMapper]
                set erase: true
        }
        this.instantiate_signature_ex(sig, m, erase)
    }

    ; ★★★ THE FRESH-TYPE-PARAMETER BRANCH IS SLICE 139'S AND IT IS THE STOP THAT
    ; STOOD HERE. The note said *cloneTypeParameter over the fresh set, then
    ; combineTypeMappers — the COMPOSITE mapper arm TypeMapperData's header names as
    ; having no writer. It lands with the arm* — and it does: the arm is written,
    ; the clone existed since slice 125 and `mapper` is the slot its own header
    ; named a caller for.
    ;
    ; ★★★ THE ORDER INSIDE THE BRANCH IS LOAD-BEARING AND UPSTREAM SAYS SO IN A
    ; COMMENT: the clones are minted FIRST, the combined mapper is built over
    ; {original -> clone} SECOND, and the mapper is written back onto every clone
    ; THIRD — so a clone's constraint is instantiated through a mapper that already
    ; knows about all of its siblings. Built in any other order, `<T, U extends T>`
    ; loses the sibling mention.
    procedure instantiate_signature_ex(this, sig: ref[Signature]?, m_in: ref[TypeMapper], erase_type_parameters: bool) returns ref[Signature]?
    {
        if sig = null
            return null
        let s sig as ref[Signature]
        var m: ref[TypeMapper] m_in
        var tpn 0
        if s.type_parameters <> null
            set tpn: (s.type_parameters as ref[Array[ref[Type]?]]).get_length() as int
        if erase_type_parameters
            set tpn: 0
        var fresh_type_parameters: ref[Array[ref[Type]?]]? null
        if tpn <> 0
        {
            let originals s.type_parameters as ref[Array[ref[Type]?]]
            let fresh &Array[ref[Type]?]^host()
            var i 0
            while i < tpn
            {
                let tp originals[i]
                if tp = null
                    return null
                fresh.add(this.clone_type_parameter(tp as ref[Type]) as ref[Type]?)
                set i: i + 1
            }
            set fresh_type_parameters: fresh as ref[Array[ref[Type]?]]?
            let combined this.combine_type_mappers(this.new_type_mapper(s.type_parameters, fresh_type_parameters) as ref[TypeMapper]?, m_in as ref[TypeMapper]?)
            if combined = null
                return null
            set m: combined as ref[TypeMapper]
            set i: 0
            while i < tpn
            {
                let cl fresh[i]
                if cl <> null
                    Checker.set_type_parameter_mapper(cl as ref[Type], m as ref[TypeMapper]?)
                set i: i + 1
            }
        }
        let mark this.unported_mark()
        let this_param this.instantiate_symbol(s.this_parameter, m)
        if this.unported_mark() <> mark
            return null
        let params this.instantiate_symbols(s.parameters, m)
        if this.unported_mark() <> mark
            return null
        let made this.new_signature(s.flags & SignatureFlagsPropagatingFlags, s.declaration, fresh_type_parameters, this_param, params, null, s.min_argument_count)
        set made.target: sig
        set made.mapper: m
        made
    }

    ; instantiateIndexInfo.
    procedure instantiate_index_info(this, info: ref[IndexInfo]?, m: ref[TypeMapper]) returns ref[IndexInfo]?
    {
        if info = null
            return null
        let i info as ref[IndexInfo]
        let mark this.unported_mark()
        let new_value this.instantiate_type(i.value_type, m)
        if this.unported_mark() <> mark
            return null
        if new_value = i.value_type
            return info
        this.new_index_info_ex(i.key_type, new_value, i.is_readonly, i.declaration, i.components)
    }

    ; resolveTypeReferenceMembers.
    ;
    ; ★★★ THE PADDING IS THE WHOLE FUNCTION AND IT IS WHERE THE `this` MAPPER COMES
    ; FROM. `typeParameters` is allTypeParameters — outer, local, and the thisType
    ; last — while `typeArguments` is the resolved list WITHOUT it, so the two differ
    ; in length by exactly one and the padding appends the TYPE ITSELF. The mapper
    ; the caller then builds is `{thisType -> t}` for a non-generic class and
    ; `{T -> arg, …, thisType -> t}` for a generic one.
    procedure resolve_type_reference_members(this, t: ref[Type])
    {
        let target Checker.target_of(t)
        if target = null
        {
            ; The reference dereferences `t.Target()` unguarded; a type carrying
            ; ObjectFlagsReference always has one. A report, on this file's rule
            ; about assertions.
            this.record_unported("resolve-type-reference-members-no-target", t.object_flags)
            return
        }
        let source target as ref[Type]
        let type_parameters Checker.all_type_parameters_of(source)
        let mark this.unported_mark()
        let type_arguments this.get_type_arguments(t)
        if this.unported_mark() <> mark
            return
        var tpn 0
        if type_parameters <> null
            set tpn: (type_parameters as ref[Array[ref[Type]?]]).get_length() as int
        var tan 0
        if type_arguments <> null
            set tan: (type_arguments as ref[Array[ref[Type]?]]).get_length() as int
        var padded: ref[Array[ref[Type]?]]? type_arguments
        if tan = (tpn - 1)
        {
            let combined this.new_type_list(type_arguments)
            let self_argument: ref[Type]? t
            combined.add(self_argument)
            set padded: combined
        }
        this.resolve_object_type_members(t, source, type_parameters, padded)
    }

    ; resolveClassOrInterfaceMembers — one line upstream and one here.
    procedure resolve_class_or_interface_members(this, t: ref[Type])
        this.resolve_object_type_members(t, t, null, null)

    ; getDefaultConstructSignatures, and the base-less branch is the whole
    ; function for every class in this corpus.
    ;
    ; ★★★ IT IS THE SYNTHESIZED `new C(): C` AND IT HAS NO DECLARATION, which is
    ; what makes it portable at all: a class that declares no constructor still
    ; answers one construct signature, and that signature's parameter list is
    ; EMPTY, its return type is the class's instance type and its declaration slot
    ; is nil. Everything a signature normally needs from a node —
    ; getSignatureFromDeclaration, the parameter symbols, the minimum argument
    ; count — is therefore not asked.
    ;
    ; ★★ THE LOOP BELOW IS A STOP AND IT IS REACHED ONLY BY A CLASS THAT EXTENDS
    ; SOMETHING. `baseSignatures` comes from getSignaturesOfType on the base
    ; CONSTRUCTOR type, and get_base_constructor_type_of_class answers
    ; undefinedType for a base-less class — a type with no structured members, so
    ; the list is empty and the first branch takes every class this port can build
    ; today. A class that DOES extend stops one call earlier, inside
    ; get_base_constructor_type_of_class at `is-constructor-type`, so the stop here
    ; is the one that would fire if that one were closed; it is written rather than
    ; left out because the alternative is a function whose only branch looks total.
    ;
    ; ★ `isAbstract` is read even in the base-less branch, and it is the one thing
    ; the branch takes from the declaration: `abstract class C {}` answers a
    ; construct signature flagged Abstract, which is what makes `new C()` an error
    ; rather than a missing signature.
    procedure get_default_construct_signatures(this, class_type: ref[Type]) returns ref[Array[ref[Signature]?]]?
    {
        let mark this.unported_mark()
        let base_constructor_type this.get_base_constructor_type_of_class(class_type)
        if this.unported_mark() <> mark
            return null
        if base_constructor_type = null
            return null
        let base_signatures this.get_signatures_of_type(base_constructor_type as ref[Type], SignatureKindConstruct)
        if this.unported_mark() <> mark
            return null
        var base_count 0
        if base_signatures <> null
            set base_count: (base_signatures as ref[Array[ref[Signature]?]]).get_length() as int
        var declaration: ref[AstNode]? null
        if class_type.symbol <> null
            set declaration: Checker.get_class_like_declaration_of_symbol(class_type.symbol as ref[Symbol])
        var is_abstract false
        if declaration <> null
            set is_abstract: b.has_syntactic_modifier(declaration as ref[AstNode], ModifierFlagsAbstract)
        let local_tps this.local_type_parameters_of(class_type)
        if this.unported_mark() <> mark
            return null
        if base_count = 0
        {
            var flags SignatureFlagsConstruct
            if is_abstract
                set flags: SignatureFlagsConstruct | SignatureFlagsAbstract
            let out this.new_signature_list()
            out.add(this.new_signature(flags, null, local_tps, null, null, class_type, 0))
            return out
        }

        ; ── slice 131: the BASE branch ──────────────────────────────────────
        ;
        ; ★★ EACH BASE CONSTRUCT SIGNATURE BECOMES ONE OF THE CLASS'S OWN, and the
        ; three writes after the clone are what make it the CLASS's: the type
        ; parameters become the class's LOCAL ones, the return type becomes the
        ; class, and Abstract is set or CLEARED from the class's own modifier — the
        ; clearing half matters, because a concrete class extending an abstract one
        ; must not inherit `new` being an error.
        ;
        ; ★ The arity gate admits a JS file unconditionally (`isJavaScript ||`),
        ; which is the reference's own leniency about missing type arguments there.
        let base_type_node Checker.get_base_type_node_of_class(class_type)
        var type_arguments: ref[Array[ref[Type]?]]? null
        if base_type_node <> null
        {
            set type_arguments: this.get_type_arguments_from_node(base_type_node as ref[AstNode])
            if this.unported_mark() <> mark
                return null
        }
        var type_arg_count 0
        if type_arguments <> null
            set type_arg_count: (type_arguments as ref[Array[ref[Type]?]]).get_length() as int
        var is_javascript false
        if declaration <> null
            set is_javascript: Parser.is_in_js_file(declaration as ref[AstNode])
        let bl base_signatures as ref[Array[ref[Signature]?]]
        let result this.new_signature_list()
        var bi 0
        while bi < base_count
        {
            let row bl[bi]
            set bi: bi + 1
            if row = null
                continue
            let base_sig row as ref[Signature]
            var type_param_count 0
            var min_type_argument_count 0
            if base_sig.type_parameters <> null
            {
                let tps base_sig.type_parameters as ref[Array[ref[Type]?]]
                set type_param_count: tps.get_length() as int
                set min_type_argument_count: this.get_min_type_argument_count(tps)
                if this.unported_mark() <> mark
                    return null
            }
            var admitted is_javascript
            if admitted = false
            {
                if type_arg_count >= min_type_argument_count
                {
                    if type_arg_count <= type_param_count
                        set admitted: true
                }
            }
            if admitted = false
                continue
            var sig: ref[Signature]? null
            if type_param_count <> 0
            {
                let tps base_sig.type_parameters as ref[Array[ref[Type]?]]
                var supplied: ref[Array[ref[Type]?]]? type_arguments
                if supplied = null
                    set supplied: this.new_type_list(null)
                let filled this.fill_missing_type_arguments(supplied as ref[Array[ref[Type]?]], tps, min_type_argument_count, is_javascript)
                if this.unported_mark() <> mark
                    return null
                set sig: this.create_signature_instantiation(base_sig, filled)
                if this.unported_mark() <> mark
                    return null
            }
            else
                set sig: this.clone_signature(base_sig)
            if sig = null
                return null
            let made sig as ref[Signature]
            set made.type_parameters: local_tps
            set made.resolved_return_type: class_type
            if is_abstract
                set made.flags: made.flags | SignatureFlagsAbstract
            else
                set made.flags: made.flags & (0 - 1 - SignatureFlagsAbstract)
            result.add(made)
        }
        result
    }

    ; cloneSignature, whole. ★The `composite` slot IS carried since slice 155 —
    ; the note that stood here said *"the day it gets one, this line arrives with
    ; it"*, and this is that day. It matters at exactly one caller:
    ; createUnionSignature clones and then OVERWRITES the slot, so a clone that
    ; dropped it would be right there and wrong everywhere else.
    procedure clone_signature(this, sig: ref[Signature]) returns ref[Signature]
    {
        let made this.new_signature(sig.flags & SignatureFlagsPropagatingFlags, sig.declaration, sig.type_parameters, sig.this_parameter, sig.parameters, null, sig.min_argument_count)
        set made.target: sig.target
        set made.mapper: sig.mapper
        set made.composite: sig.composite
        made
    }

    ; resolveAnonymousTypeMembers. Slice 80 wrote the middle branch, slice 87 the
    ; third, and the FIRST is the one that is still absent — deliberately.
    ;
    ; ★★★ THE FIRST BRANCH IS NOT A STOP AND NOT A HOLE: IT HAS NO SUBJECT. It is
    ; the INSTANTIATED anonymous type, `d.target != nil`, and AnonymousTypeData
    ; carries neither `target` nor `mapper` — because the only writer of those two
    ; slots is getObjectTypeInstantiation, which stops. So the branch is
    ; unreachable by construction rather than unwritten, and adding the two slots
    ; ahead of their writer would be a claim about the future (§3.5be). Slice 86's
    ; stage-2 probe put a number on it: `get-object-type-instantiation` fires on 5
    ; units of 18 185, and none at stage 1.
    ;
    ; ★★ THE MIDDLE BRANCH IS THE TYPE LITERAL AND IT IS THREE CALLS. `{ a: number }`
    ; and `{ (x: number): string }` are one symbol whose members table holds the
    ; properties, the `%FEcall` entry and the `%FEnew` one — so getMembersOfSymbol,
    ; getSignaturesOfSymbol twice and getIndexInfosOfSymbol is the whole branch.
    ;
    ; ★★★ THE THIRD BRANCH IS THE STATIC SIDE OF A CLASS, AND WHAT REACHES IT IS
    ; ONE SYMBOL KIND. The reference calls it *combinations of function, class, enum
    ; and module*, but the stop it replaces fired 422 times over 274 units at stage
    ; 1 with detail 32 — SymbolFlagsClass — and with NO OTHER detail, not once. A
    ; function's static side does not arrive here because getTypeOfSymbol answers a
    ; function type through a different door; an enum's and a module's do not
    ; arrive because their chapters stop earlier. So the four arms below are the
    ; reference's four, one of them is measured live, and the other three are
    ; written because leaving them out would make the live one look like the whole
    ; function.
    procedure resolve_anonymous_type_members(this, t: ref[Type])
    {
        ; ★★★ THE INSTANTIATED BRANCH IS SLICE 125'S AND ITS ABSENCE WAS SILENT.
        ; The header above named it — *"INSTANTIATED through a mapper:
        ; instantiateSymbolTable, instantiateSignatures, instantiateIndexInfos …
        ; that is a chapter of its own and it is this slice's first stop"* — and it
        ; was a stop only in prose: there was no `record_unported` here, so an
        ; instantiated anonymous type fell into the class/module branch below and
        ; came back with the TARGET'S OWN uninstantiated members. Nothing could
        ; mint one before getObjectTypeInstantiation existed, which is why it never
        ; fired; the moment that function landed, `Foo<string>.m` answered
        ; `(a: T) => T[]` — a well-formed wrong type, at stage 2 only, on four
        ; units.
        let target Checker.target_of(t)
        if target <> null
        {
            let tgt target as ref[Type]
            let mapper Checker.mapper_of(t)
            let mark0 this.unported_mark()
            ; Resolved upfront so that a recursive reference sees an empty type.
            this.set_structured_type_members(t, null, null, null, null)
            let props this.get_properties_of_object_type(tgt)
            if this.unported_mark() <> mark0
                return
            var members: ref[SymbolTable]? null
            if mapper <> null
                set members: this.create_instantiated_symbol_table(props, mapper as ref[TypeMapper])
            if this.unported_mark() <> mark0
                return
            let call_sigs this.get_signatures_of_type(tgt, SignatureKindCall)
            if this.unported_mark() <> mark0
                return
            let ctor_sigs this.get_signatures_of_type(tgt, SignatureKindConstruct)
            if this.unported_mark() <> mark0
                return
            let infos this.get_index_infos_of_type(tgt)
            if this.unported_mark() <> mark0
                return
            var call_out: ref[Array[ref[Signature]?]]? call_sigs
            var ctor_out: ref[Array[ref[Signature]?]]? ctor_sigs
            var info_out: ref[Array[ref[IndexInfo]?]]? infos
            if mapper <> null
            {
                let m mapper as ref[TypeMapper]
                set call_out: this.instantiate_signatures(call_sigs, m)
                if this.unported_mark() <> mark0
                    return
                set ctor_out: this.instantiate_signatures(ctor_sigs, m)
                if this.unported_mark() <> mark0
                    return
                set info_out: this.instantiate_index_infos(infos, m)
                if this.unported_mark() <> mark0
                    return
            }
            this.set_structured_type_members(t, members, call_out, ctor_out, info_out)
            return
        }
        if t.symbol = null
        {
            this.record_unported("resolve-anonymous-type-members-no-symbol", t.object_flags)
            return
        }
        let merged this.get_merged_symbol(t.symbol)
        if merged = null
        {
            this.record_unported("resolve-anonymous-type-members-no-symbol", t.object_flags)
            return
        }
        let symbol merged as ref[Symbol]
        let mark this.unported_mark()
        if (Symbol.flags_of(symbol) & SymbolFlagsTypeLiteral) <> 0
        {
            this.set_structured_type_members(t, null, null, null, null)
            let members this.get_members_of_symbol(symbol)
            if this.unported_mark() <> mark
                return
            var cd Slice[char]()
            set cd: Binder.internal_name(host, "call")
            var nd Slice[char]()
            set nd: Binder.internal_name(host, "new")
            var call_symbol: ref[Symbol]? null
            var new_symbol: ref[Symbol]? null
            if members <> null
            {
                set call_symbol: SymbolTable.get(members, cd)
                set new_symbol: SymbolTable.get(members, nd)
            }
            let call_signatures this.get_signatures_of_symbol(call_symbol)
            if this.unported_mark() <> mark
                return
            let construct_signatures this.get_signatures_of_symbol(new_symbol)
            if this.unported_mark() <> mark
                return
            let index_infos this.get_index_infos_of_symbol(symbol)
            if this.unported_mark() <> mark
                return
            this.set_structured_type_members(t, members, call_signatures, construct_signatures, index_infos)
            return
        }

        ; ── combinations of function, class, enum and module ────────────────
        ;
        ; ★★★ globalThis IS THE ONE ARM THAT IS NAMED RATHER THAN WRITTEN, and the
        ; reason is that its subject does not exist here. `c.globalThisSymbol` is
        ; minted by NewChecker and filled by the GLOBAL scope — the lib files and
        ; every `var` at top level of a script — which this port does not build, so
        ; the identity test the reference makes would be false at every arrival and
        ; the varsOnly filter behind it would never run. A test against a symbol
        ; nothing can produce is a claim about the future (§3.5be), so what stands
        ; here is this sentence.
        var members this.get_exports_of_symbol(symbol)
        if this.unported_mark() <> mark
            return

        ; ★★★ `globalThis` IS THE ONE SYMBOL WHOSE EXPORTS ARE FILTERED HERE, and
        ; leaving the filter out is a WRONG ANSWER rather than a missing one.
        ; `global_this_symbol` is minted with `Exports = globals`, so the table
        ; holds every top-level name of every file — `let` and `const` included —
        ; and a block-scoped global is exactly what is NOT a property of
        ; `typeof globalThis`. Without the filter `globalThis.y` for a top-level
        ; `const y` resolves, so the two sites that report TS2339 for it (the
        ; property access in check_property_access_expression_or_qualified_name and
        ; the element access in get_property_type_for_index_type) are never
        ; reached — both were written, and neither could fire. The second half of
        ; the filter drops an ambient VALUE MODULE the same way.
        if symbol = global_this_symbol
        {
            let vars_only SymbolTable.create(host)
            let gt_count SymbolTable.length(members)
            var mi 0
            while mi < gt_count
            {
                let gt_sym SymbolTable.entry_symbol_at(members, mi)
                let gt_name SymbolTable.entry_name_at(members, mi)
                set mi: mi + 1
                if gt_sym = null
                    continue
                let ps gt_sym as ref[Symbol]
                if (Symbol.flags_of(ps) & SymbolFlagsBlockScoped) <> 0
                    continue
                if (Symbol.flags_of(ps) & SymbolFlagsValueModule) <> 0
                {
                    let dn Symbol.declaration_count(ps)
                    if dn <> 0
                    {
                        var every_ambient true
                        var di 0
                        while di < dn
                        {
                            if Binder.is_ambient_module(Symbol.declaration_at(ps, di)) = false
                                set every_ambient: false
                            set di: di + 1
                        }
                        if every_ambient
                            continue
                    }
                }
                SymbolTable.set_entry(host, vars_only, gt_name, gt_sym)
            }
            set members: vars_only
        }

        ; The reference calls setStructuredTypeMembers HERE, before the signatures,
        ; and its own comment says why: a signature may name this very type through
        ; `typeof`, and the half-filled record is what closes that recursion. The
        ; second call at the end of this branch is the reference's three direct
        ; writes to `d.indexInfos`, `d.signatures` and `d.callSignatureCount` — the
        ; same three slots, through the one procedure that owns them.
        var base_constructor_index_info: ref[IndexInfo]? null
        this.set_structured_type_members(t, members, null, null, null)
        if (Symbol.flags_of(symbol) & SymbolFlagsClass) <> 0
        {
            let declared this.get_declared_type_of_class_or_interface(symbol)
            if this.unported_mark() <> mark
                return
            if declared = null
                return
            let base_constructor_type this.get_base_constructor_type_of_class(declared as ref[Type])
            if this.unported_mark() <> mark
                return
            if base_constructor_type = null
                return
            let bct base_constructor_type as ref[Type]
            var inherits false
            if (bct.flags & TypeFlagsObject) <> 0
                set inherits: true
            if (bct.flags & TypeFlagsIntersection) <> 0
                set inherits: true
            if (bct.flags & TypeFlagsTypeVariable) <> 0
                set inherits: true
            if inherits
            {
                ; `members = maps.Clone(members)` — the clone is not decoration.
                ; The table this branch was handed is the SYMBOL's exports table,
                ; and folding the base constructor's statics into it would make
                ; every later reader of that symbol see members it never declared.
                let props this.get_properties_of_type(bct)
                if this.unported_mark() <> mark
                    return
                set members: this.add_inherited_members(this.clone_symbol_table(members), props)
                this.set_structured_type_members(t, members, null, null, null)
            }
            if inherits = false
            {
                if bct = any_type
                    set base_constructor_index_info: any_base_type_index_info
            }
        }

        var index_symbol: ref[Symbol]? null
        if members <> null
        {
            var idd Slice[char]()
            set idd: Binder.internal_name(host, "index")
            set index_symbol: SymbolTable.get(members, idd)
        }
        var index_infos: ref[Array[ref[IndexInfo]?]]? null
        if index_symbol <> null
        {
            set index_infos: this.get_index_infos_of_index_symbol(index_symbol as ref[Symbol], members)
            if this.unported_mark() <> mark
                return
        }
        if index_symbol = null
        {
            let infos this.new_index_info_list()
            if base_constructor_index_info <> null
                infos.add(base_constructor_index_info)
            ; ★★ THE ENUM DISJUNCT IS TWO QUESTIONS AND THE SECOND ONE READS THE
            ; TABLE THIS BRANCH JUST BUILT. `d.properties` is what
            ; set_structured_type_members filled above, so the *some member has a
            ; number-like type* test is asked of the enum's own exports — which is
            ; why the early call is load-bearing for more than the recursion.
            if (Symbol.flags_of(symbol) & SymbolFlagsEnum) <> 0
            {
                var enum_index false
                let declared_enum this.get_declared_type_of_symbol(symbol)
                if this.unported_mark() <> mark
                    return
                if declared_enum <> null
                {
                    if ((declared_enum as ref[Type]).flags & TypeFlagsEnum) <> 0
                        set enum_index: true
                }
                if enum_index = false
                {
                    let sm Checker.structured_members_of(t)
                    if sm <> null
                    {
                        let props (sm as ref[StructuredMembers]).properties
                        if props <> null
                        {
                            let list props as ref[Array[ref[Symbol]?]]
                            let pn list.get_length() as int
                            var i 0
                            while i < pn
                            {
                                let row list[i]
                                set i: i + 1
                                if row = null
                                    continue
                                let pt this.get_type_of_symbol(row as ref[Symbol])
                                if this.unported_mark() <> mark
                                    return
                                if pt = null
                                    continue
                                if ((pt as ref[Type]).flags & TypeFlagsNumberLike) <> 0
                                {
                                    set enum_index: true
                                    set i: pn
                                }
                            }
                        }
                    }
                }
                if enum_index
                    infos.add(enum_number_index_info)
            }
            ; The reference leaves `indexInfos` NIL when nothing was appended, and
            ; the difference is visible: checkIndexConstraints' first line is a
            ; length test, and an empty list would read as *resolved, none* where a
            ; nil reads as *none*. They agree today; answering nil keeps them
            ; agreeing for the reader that tells them apart.
            if infos.get_length() <> 0
                set index_infos: infos
        }

        var call_signatures: ref[Array[ref[Signature]?]]? null
        var construct_signatures: ref[Array[ref[Signature]?]]? null
        var function_like false
        if (Symbol.flags_of(symbol) & SymbolFlagsFunction) <> 0
            set function_like: true
        if (Symbol.flags_of(symbol) & SymbolFlagsMethod) <> 0
            set function_like: true
        if function_like
        {
            set call_signatures: this.get_signatures_of_symbol(symbol)
            if this.unported_mark() <> mark
                return
        }
        if (Symbol.flags_of(symbol) & SymbolFlagsClass) <> 0
        {
            let declared this.get_declared_type_of_class_or_interface(symbol)
            if this.unported_mark() <> mark
                return
            if declared = null
                return
            var ctord Slice[char]()
            set ctord: Binder.internal_name(host, "constructor")
            var ctor_symbol: ref[Symbol]? null
            let own_members Symbol.members_of(symbol)
            if own_members <> null
                set ctor_symbol: SymbolTable.get(own_members, ctord)
            set construct_signatures: this.get_signatures_of_symbol(ctor_symbol)
            if this.unported_mark() <> mark
                return
            var declared_count 0
            if construct_signatures <> null
                set declared_count: (construct_signatures as ref[Array[ref[Signature]?]]).get_length() as int
            if declared_count = 0
            {
                set construct_signatures: this.get_default_construct_signatures(declared as ref[Type])
                if this.unported_mark() <> mark
                    return
            }
        }
        this.set_structured_type_members(t, members, call_signatures, construct_signatures, index_infos)
    }

    ; resolveStructuredTypeMembers, whole — five arms of which one is written.
    ;
    ; ★★★ THE ARM ORDER IS THE REFERENCE'S AND IT DECIDES THE SLICE. Reference is
    ; tested BEFORE ClassOrInterface, and get_declared_type_of_class_or_interface
    ; sets the Reference flag on every class and on every generic or this-using
    ; interface — so what falls through to the ported arm is exactly a non-generic
    ; interface free of `this`. The two facts are in different functions and only
    ; their conjunction says which types this slice covers, which is why the header
    ; states it there rather than here.
    ;
    ; ★ The reference's two `panic("Unhandled case")` defaults are reports here, for
    ; the reason new_object_type's are: a panic would be a claim that the input is
    ; impossible, and this port's answer is that it has not been ported.
    ; resolveStructuredTypeMembers.
    ;
    ; ★★★ THE MARK DELTA AT THE BOTTOM IS SLICE 108'S, AND IT REPAIRS A MEMO THAT
    ; CACHED ITS OWN INCOMPLETENESS — the third table in this file to need that
    ; (check_expression_cached_ex and get_resolved_signature are the other two).
    ; `resolve_anonymous_type_members` writes a HALF-FILLED record before it builds
    ; the signatures, which is the reference's own arrangement and its own comment: a
    ; signature may name this very type through `typeof`, and the half-filled record
    ; is what closes that recursion. Upstream the tables are then always completed.
    ; **Here the very next line can STOP** — `get_base_constructor_type_of_class`
    ; reports `is-constructor-type` — and the procedure returns with
    ; `MembersResolved` SET and the signature tables EMPTY. The second ask then reads
    ; *no construct signatures* with no stop and no mark movement.
    ;
    ; ★★★ IT COST NINE UNITS OF INVENTION AND ONLY STAGE 2 SAW THEM. Slice 108's
    ; `new`-expression tail reports TS2351 when a target has neither construct nor
    ; call signatures, and on those nine units it fired for a CLASS WITH A
    ; CONSTRUCTOR. Stage 1 is green throughout — the shape needs a class whose base
    ; type resolution stops AND a second `new` on the same class — which is slice 64's
    ; rule arriving as a defect rather than as a number.
    ;
    ; ★★ THE LINE IS THE ONE THE FILE ALREADY HAS. `resolve_base_types` clears the
    ; same flag for the reference's own reason (*a circularity in a type-parameter
    ; default can leave members half resolved, and this resets that*); the trigger
    ; here is a STOP rather than a circularity, and the remedy is identical. ★It is
    ; placed in the WRAPPER rather than at each early return because all three
    ; resolve_*_members procedures have the shape and the wrapper is the one place
    ; that sees every one of them.
    ; ── slice 127: the UNION and INTERSECTION member tables ──────────────────
    ;
    ; ★★★ THE MEMBERS TABLE OF A UNION OR INTERSECTION IS EMPTY BY DESIGN, and
    ; that is the reference's own comment: *"The members and properties
    ; collections are empty for union types. To get all properties of a union type
    ; use getPropertiesOfType"*. What these two resolve is the SIGNATURES and the
    ; INDEX INFOS; the properties are synthesized one name at a time by
    ; createUnionOrIntersectionProperty, which is why a union has a property CACHE
    ; and not a property table.

    ; resolveUnionTypeMembers.
    procedure resolve_union_type_members(this, t: ref[Type])
    {
        let mark this.unported_mark()
        let calls this.get_union_signatures(this.signature_lists_of(t, SignatureKindCall))
        if this.unported_mark() <> mark
            return
        var call_signatures calls
        var call_n 0
        if call_signatures <> null
            set call_n: (call_signatures as ref[Array[ref[Signature]?]]).get_length() as int
        if call_n = 0
        {
            set call_signatures: this.get_array_member_call_signatures(t)
            if this.unported_mark() <> mark
                return
        }
        let constructs this.get_union_signatures(this.signature_lists_of(t, SignatureKindConstruct))
        if this.unported_mark() <> mark
            return
        let types Checker.union_or_intersection_types_of(t)
        if types = null
            return
        let infos this.get_union_index_infos(types as ref[Array[ref[Type]?]])
        if this.unported_mark() <> mark
            return
        this.set_structured_type_members(t, null, call_signatures, constructs, infos)
    }

    ; getUnionSignatures, and it is STILL written as the QUESTION its caller asks —
    ; `getUnionSignatures(core.Map(t.Types(), …))` — because the list of lists is
    ; built from the union's constituents at the one place that has them. The
    ; `signature_lists_of` helper below is upstream's `core.Map`, and the fold
    ; itself takes the list of lists so that findMatchingSignatures can walk it.
    ;
    ; ★★★ THE EARLY EXIT IS STILL THE WHOLE FUNCTION ON THE ORDINARY UNION. `if
    ; len(signatureLists[i]) == 0 { return nil }` fires as soon as ONE constituent
    ; has no signature of this kind, and a union of data types has none anywhere.
    ; What slice 155 added is what happens when every constituent DOES have one.
    ;
    ; ★ The globalFunctionType arm substitutes `unknownSignature`, a ONE-element
    ; list — so for that constituent the list is never empty, which is exactly why
    ; the arm exists and why it cannot be folded away.
    procedure signature_lists_of(this, t: ref[Type], kind: int) returns ref[Array[ref[Array[ref[Signature]?]]?]]?
    {
        let types Checker.union_or_intersection_types_of(t)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        if n = 0
            return null
        let mark this.unported_mark()
        let gf this.get_global_function_type()
        if this.unported_mark() <> mark
            return null
        let lists &Array[ref[Array[ref[Signature]?]]?]^host()
        var i 0
        while i < n
        {
            let row list[i]
            if row = null
                return null
            let ct row as ref[Type]
            var is_global_function false
            if kind = SignatureKindCall
            {
                if gf <> null
                {
                    if (gf as ref[Type]) = ct
                        set is_global_function: true
                }
            }
            if is_global_function
            {
                let one &Array[ref[Signature]?]^host()
                let us: ref[Signature]? unknown_signature
                one.add(us)
                let e: ref[Array[ref[Signature]?]]? one
                lists.add(e)
            }
            if is_global_function = false
            {
                let sigs this.get_signatures_of_type(ct, kind)
                if this.unported_mark() <> mark
                    return null
                lists.add(sigs)
            }
            set i: i + 1
        }
        lists
    }

    ; getUnionSignatures, whole (slice 155).
    ;
    ; ★★★ THE SECOND HALF RUNS ONLY WHEN THE FIRST FOUND NOTHING, and its guard is
    ; `countLengthOverOne <= 1` — at most ONE constituent may carry overloads.
    ; Upstream argues it: overloads are conditional, and overloads in several
    ; constituents would need the POWER SET of their combinations, whose ordering
    ; is not obvious. So a single master list is combined pairwise with each other
    ; constituent's FIRST signature, and the fold gives up whole (`results = nil`)
    ; the moment two type-parameter lists disagree.
    procedure get_union_signatures(this, signature_lists: ref[Array[ref[Array[ref[Signature]?]]?]]?) returns ref[Array[ref[Signature]?]]?
    {
        if signature_lists = null
            return null
        let lists signature_lists as ref[Array[ref[Array[ref[Signature]?]]?]]
        let ln lists.get_length() as int
        let mark this.unported_mark()
        var result: ref[Array[ref[Signature]?]]? null
        var index_with_length_over_one 0
        var count_length_over_one 0
        var i 0
        while i < ln
        {
            let row Checker.signature_list_at(lists, i)
            var rn 0
            if row <> null
                set rn: (row as ref[Array[ref[Signature]?]]).get_length() as int
            if rn = 0
                return null
            if rn > 1
            {
                set index_with_length_over_one: i
                set count_length_over_one: count_length_over_one + 1
            }
            let rl row as ref[Array[ref[Signature]?]]
            var j 0
            while j < rn
            {
                let srow rl[j]
                set j: j + 1
                if srow = null
                    continue
                let signature srow as ref[Signature]
                var already false
                if result <> null
                {
                    let m this.find_matching_signature(result, signature, false, false, true)
                    if this.unported_mark() <> mark
                        return null
                    if m <> null
                        set already: true
                }
                if already
                    continue
                let union_signatures this.find_matching_signatures(lists, signature, i)
                if this.unported_mark() <> mark
                    return null
                if union_signatures = null
                    continue
                let us union_signatures as ref[Array[ref[Signature]?]]
                var chosen signature
                if (us.get_length() as int) > 1
                {
                    ; The `this` parameter of the union signature: the FIRST
                    ; constituent that declares one supplies the symbol, and the
                    ; type is the INTERSECTION of every declared one — the same
                    ; contravariant fold the parameters take.
                    var this_parameter signature.this_parameter
                    var first: ref[Symbol]? null
                    let un us.get_length() as int
                    var k 0
                    while k < un
                    {
                        let srow2 us[k]
                        set k: k + 1
                        if srow2 = null
                            continue
                        let sg srow2 as ref[Signature]
                        if sg.this_parameter <> null
                        {
                            if first = null
                                set first: sg.this_parameter
                        }
                    }
                    if first <> null
                    {
                        let this_types &Array[ref[Type]?]()
                        var k2 0
                        while k2 < un
                        {
                            let srow3 us[k2]
                            set k2: k2 + 1
                            if srow3 = null
                                continue
                            let sg2 srow3 as ref[Signature]
                            if sg2.this_parameter = null
                                continue
                            let ty this.get_type_of_symbol(sg2.this_parameter as ref[Symbol])
                            if this.unported_mark() <> mark
                                return null
                            if ty = null
                                continue
                            this_types.add(ty)
                        }
                        let this_type this.get_intersection_type(this_types)
                        if this.unported_mark() <> mark
                            return null
                        set this_parameter: this.create_symbol_with_type(first as ref[Symbol], this_type)
                    }
                    set chosen: this.create_union_signature(signature, us)
                    set chosen.this_parameter: this_parameter
                }
                if result = null
                    set result: &Array[ref[Signature]?]^host()
                let e: ref[Signature]? chosen
                (result as ref[Array[ref[Signature]?]]).add(e)
            }
            set i: i + 1
        }
        var result_n 0
        if result <> null
            set result_n: (result as ref[Array[ref[Signature]?]]).get_length() as int
        if result_n > 0
            return result
        if count_length_over_one > 1
            return result
        let master Checker.signature_list_at(lists, index_with_length_over_one)
        if master = null
            return null
        let ml master as ref[Array[ref[Signature]?]]
        var results: ref[Array[ref[Signature]?]]? this.clone_signature_list(ml)
        var i2 0
        while i2 < ln
        {
            let row Checker.signature_list_at(lists, i2)
            set i2: i2 + 1
            if row = null
                continue
            let rl row as ref[Array[ref[Signature]?]]
            if rl = ml
                continue
            let head rl[0]
            if head = null
                return null
            let signature head as ref[Signature]
            if results = null
                break
            let rs results as ref[Array[ref[Signature]?]]
            var give_up false
            if Checker.type_parameter_count_of_signature(signature) <> 0
            {
                let rn rs.get_length() as int
                var k 0
                while k < rn
                {
                    let srow rs[k]
                    set k: k + 1
                    if srow = null
                        continue
                    let sg srow as ref[Signature]
                    if Checker.type_parameter_count_of_signature(sg) = 0
                        continue
                    if this.compare_type_parameters_identical(signature.type_parameters, sg.type_parameters) = false
                    {
                        set give_up: true
                        break
                    }
                    if this.unported_mark() <> mark
                        return null
                }
            }
            if give_up
            {
                set results: null
                break
            }
            let combined &Array[ref[Signature]?]^host()
            let rn rs.get_length() as int
            var k 0
            while k < rn
            {
                let srow rs[k]
                set k: k + 1
                if srow = null
                    continue
                let made this.combine_union_or_intersection_member_signatures(srow as ref[Signature], signature, true)
                if this.unported_mark() <> mark
                    return null
                if made = null
                    return null
                let e: ref[Signature]? made
                combined.add(e)
            }
            set results: combined
        }
        results
    }

    ; `slices.Clone(masterList)` — a fresh list, because the fold below REPLACES
    ; its rows and the master is a resolved type's own signature list.
    function clone_signature_list(this, src: ref[Array[ref[Signature]?]]) returns ref[Array[ref[Signature]?]]
    {
        let out &Array[ref[Signature]?]^host()
        let n src.get_length() as int
        var i 0
        while i < n
        {
            out.add(src[i])
            set i: i + 1
        }
        out
    }

    ; ── slice 155: the COMBINE family ───────────────────────────────────────
    ;
    ; combineUnionOrIntersectionMemberSignatures, its two halves, and
    ; createUnionSignature. All four exist so that a union or intersection of
    ; OBJECT types can answer a single call signature: `(a: A) => X` and
    ; `(b: B) => Y` intersected is one signature whose parameter is `A | B` —
    ; contravariance, which is why the parameter fold takes `!is_union`.
    ;
    ; ★★★ THE PARAMETER FOLD IS THE OPPOSITE OF THE SIGNATURE FOLD, and reading
    ; `!isUnion` as a transcription slip is the mistake it invites. A value
    ; usable as EITHER signature must accept EITHER parameter type, so a UNION of
    ; signatures INTERSECTS parameters; the `this` parameter takes the same fold
    ; for the same reason, and upstream says so at the line.

    procedure combine_union_or_intersection_member_signatures(this, left: ref[Signature], right: ref[Signature], is_union: bool) returns ref[Signature]?
    {
        let mark this.unported_mark()
        var type_params left.type_parameters
        if Checker.type_parameter_count_of_signature(left) = 0
            set type_params: right.type_parameters
        var param_mapper: ref[TypeMapper]? null
        if Checker.type_parameter_count_of_signature(left) <> 0
        {
            if Checker.type_parameter_count_of_signature(right) <> 0
                set param_mapper: this.new_type_mapper(right.type_parameters, left.type_parameters)
        }
        var flags (left.flags | right.flags) & (SignatureFlagsPropagatingFlags & (0 - 1 - SignatureFlagsHasRestParameter))
        let params this.combine_union_or_intersection_parameters(left, right, param_mapper, is_union)
        if this.unported_mark() <> mark
            return null
        if params = null
            return null
        let plist params as ref[Array[ref[Symbol]?]]
        let pn plist.get_length() as int
        if pn > 0
        {
            let last plist[pn - 1]
            if last <> null
            {
                if (Symbol.check_flags_of(last as ref[Symbol]) & CheckFlagsRestParameter) <> 0
                    set flags: flags | SignatureFlagsHasRestParameter
            }
        }
        let this_param this.combine_union_or_intersection_this_param(left.this_parameter, right.this_parameter, param_mapper, is_union)
        if this.unported_mark() <> mark
            return null
        var min_arg_count left.min_argument_count
        if right.min_argument_count > min_arg_count
            set min_arg_count: right.min_argument_count
        let result this.new_signature(flags, left.declaration, type_params, this_param, plist, null, min_arg_count)
        ; `append(leftSignatures, right)` — a FRESH list, because `leftSignatures`
        ; is the left composite's own slice upstream and appending in place would
        ; edit a signature the file already handed out.
        let sigs &Array[ref[Signature]?]^host()
        var took_left false
        if left.composite <> null
        {
            let lc left.composite as ref[CompositeSignature]
            if lc.is_union
            {
                if lc.signatures <> null
                {
                    let ls lc.signatures as ref[Array[ref[Signature]?]]
                    let ln ls.get_length() as int
                    var i 0
                    while i < ln
                    {
                        sigs.add(ls[i])
                        set i: i + 1
                    }
                    set took_left: true
                }
            }
        }
        if took_left = false
        {
            let l: ref[Signature]? left
            sigs.add(l)
        }
        let r: ref[Signature]? right
        sigs.add(r)
        set result.composite: &CompositeSignature^host(is_union, sigs)
        ; The mapper fork, and its three arms are upstream's own.
        var same_fold false
        if left.composite <> null
        {
            if (left.composite as ref[CompositeSignature]).is_union = is_union
                set same_fold: true
        }
        if param_mapper <> null
        {
            var combined param_mapper
            if same_fold
            {
                if left.mapper <> null
                    set combined: this.combine_type_mappers(left.mapper, param_mapper)
            }
            set result.mapper: combined
        }
        if param_mapper = null
        {
            if same_fold
                set result.mapper: left.mapper
        }
        result
    }

    ; combineUnionOrIntersectionParameters.
    ;
    ; ★★★ `needsExtraRestElement` IS WHAT MAKES THE FOLD TOTAL. If either side has
    ; an effective rest parameter and the LONGER one does not, the combined
    ; signature grows one slot past the longest — otherwise a call with more
    ; arguments than the longer signature declares would lose the rest the shorter
    ; one had.
    procedure combine_union_or_intersection_parameters(this, left: ref[Signature], right: ref[Signature], mapper: ref[TypeMapper]?, is_union: bool) returns ref[Array[ref[Symbol]?]]?
    {
        let mark this.unported_mark()
        let left_count this.get_parameter_count(left)
        let right_count this.get_parameter_count(right)
        if this.unported_mark() <> mark
            return null
        var longest_count left_count
        var longest left
        var shorter right
        if left_count < right_count
        {
            set longest_count: right_count
            set longest: right
            set shorter: left
        }
        var either_has_rest this.has_effective_rest_parameter(left)
        if either_has_rest = false
            set either_has_rest: this.has_effective_rest_parameter(right)
        if this.unported_mark() <> mark
            return null
        var needs_extra_rest false
        if either_has_rest
        {
            if this.has_effective_rest_parameter(longest) = false
                set needs_extra_rest: true
        }
        if this.unported_mark() <> mark
            return null
        let params &Array[ref[Symbol]?]^host()
        var i 0
        while i < longest_count
        {
            var longest_param_type this.try_get_type_at_position(longest, i)
            if this.unported_mark() <> mark
                return null
            if longest = right
            {
                set longest_param_type: this.instantiate_type(longest_param_type, mapper)
                if this.unported_mark() <> mark
                    return null
            }
            if longest_param_type = null
            {
                ; Upstream has no OrElse here — only the SHORTER side gets one — so
                ; a null on this side is a shape the reference does not admit.
                ; Reported rather than coerced, on this file's rule that a claim
                ; about an impossible input is worth a row.
                this.record_unported("combine-parameters-longest-no-type", i)
                return null
            }
            var shorter_param_type this.try_get_type_at_position(shorter, i)
            if this.unported_mark() <> mark
                return null
            if shorter = right
            {
                set shorter_param_type: this.instantiate_type(shorter_param_type, mapper)
                if this.unported_mark() <> mark
                    return null
            }
            if shorter_param_type = null
                set shorter_param_type: unknown_type
            let pair &Array[ref[Type]?]()
            pair.add(longest_param_type)
            pair.add(shorter_param_type)
            var fold_is_union true
            if is_union
                set fold_is_union: false
            let combined this.get_union_or_intersection_type(pair, fold_is_union, UnionReductionLiteral)
            if this.unported_mark() <> mark
                return null
            if combined = null
                return null
            var is_rest_param false
            if either_has_rest
            {
                if needs_extra_rest = false
                {
                    if i = (longest_count - 1)
                        set is_rest_param: true
                }
            }
            let longest_min this.get_min_argument_count(longest)
            let shorter_min this.get_min_argument_count(shorter)
            if this.unported_mark() <> mark
                return null
            var is_optional false
            if i >= longest_min
            {
                if i >= shorter_min
                    set is_optional: true
            }
            var left_name Slice[char]()
            var right_name Slice[char]()
            if i < left_count
            {
                set left_name: this.get_parameter_name_at_position(left, i)
                if this.unported_mark() <> mark
                    return null
            }
            if i < right_count
            {
                set right_name: this.get_parameter_name_at_position(right, i)
                if this.unported_mark() <> mark
                    return null
            }
            var param_name Slice[char]()
            if Checker.text_equals(left_name, right_name)
                set param_name: left_name
            if Checker.text_equals(left_name, right_name) = false
            {
                if (left_name.length as int) = 0
                    set param_name: right_name
                if (left_name.length as int) <> 0
                {
                    if (right_name.length as int) = 0
                        set param_name: left_name
                }
            }
            if (param_name.length as int) = 0
                set param_name: Checker.suffixed_decimal_name(host, Checker.plain_name(host, "arg"), false, i)
            var sym_flags SymbolFlagsFunctionScopedVariable
            if is_optional
            {
                if is_rest_param = false
                    set sym_flags: sym_flags | SymbolFlagsOptional
            }
            var check_flags 0
            if is_rest_param
                set check_flags: CheckFlagsRestParameter
            if is_rest_param = false
            {
                if is_optional
                    set check_flags: CheckFlagsOptionalParameter
            }
            let param_symbol this.new_symbol_ex(sym_flags, param_name, check_flags)
            let links this.value_symbol_link_of(param_symbol)
            if is_rest_param
            {
                let arr this.create_array_type(combined)
                if this.unported_mark() <> mark
                    return null
                set links.resolved_type: arr
            }
            if is_rest_param = false
                set links.resolved_type: combined
            let ps: ref[Symbol]? param_symbol
            params.add(ps)
            set i: i + 1
        }
        if needs_extra_rest
        {
            let rest_symbol this.new_symbol_ex(SymbolFlagsFunctionScopedVariable, Checker.plain_name(host, "args"), CheckFlagsRestParameter)
            let links this.value_symbol_link_of(rest_symbol)
            let tail this.get_type_at_position(shorter, longest_count)
            if this.unported_mark() <> mark
                return null
            var arr this.create_array_type(tail)
            if this.unported_mark() <> mark
                return null
            if shorter = right
            {
                set arr: this.instantiate_type(arr, mapper)
                if this.unported_mark() <> mark
                    return null
            }
            set links.resolved_type: arr
            let rs: ref[Symbol]? rest_symbol
            params.add(rs)
        }
        params
    }

    ; combineUnionOrIntersectionThisParam. ★The two null arms are not symmetric
    ; with the fold: a signature with no `this` parameter combines to the OTHER
    ; one's rather than to none, which upstream calls being permissive when
    ; calling.
    procedure combine_union_or_intersection_this_param(this, left: ref[Symbol]?, right: ref[Symbol]?, mapper: ref[TypeMapper]?, is_union: bool) returns ref[Symbol]?
    {
        if left = null
            return right
        if right = null
            return left
        let l left as ref[Symbol]
        let r right as ref[Symbol]
        let mark this.unported_mark()
        let lt this.get_type_of_symbol(l)
        if this.unported_mark() <> mark
            return null
        let rt this.get_type_of_symbol(r)
        if this.unported_mark() <> mark
            return null
        let irt this.instantiate_type(rt, mapper)
        if this.unported_mark() <> mark
            return null
        if lt = null
            return null
        if irt = null
            return null
        let pair &Array[ref[Type]?]()
        pair.add(lt)
        pair.add(irt)
        var fold_is_union true
        if is_union
            set fold_is_union: false
        let this_type this.get_union_or_intersection_type(pair, fold_is_union, UnionReductionLiteral)
        if this.unported_mark() <> mark
            return null
        this.create_symbol_with_type(l, this_type)
    }

    ; createUnionSignature. ★The two slots it CLEARS are the point: a composite
    ; signature is not an instantiation of anything, so carrying the clone's
    ; `target`/`mapper` would make get_return_type_of_signature take the
    ; instantiated arm and answer the wrong signature's return type.
    procedure create_union_signature(this, sig: ref[Signature], union_signatures: ref[Array[ref[Signature]?]]) returns ref[Signature]
    {
        let result this.clone_signature(sig)
        set result.composite: &CompositeSignature^host(true, union_signatures)
        set result.target: null
        set result.mapper: null
        result
    }

    ; getArrayMemberCallSignatures. ★Its guard is EXACT and rejects at the first
    ; constituent for every union this port meets: each one must be an
    ; INSTANTIATED member of the global Array or ReadonlyArray. The transform
    ; behind it — `(A[] | B[])["member"]` read as `(A | B)[]["member"]` — needs the
    ; instantiation MAPPER of each constituent, and is the stop.
    procedure get_array_member_call_signatures(this, t: ref[Type]) returns ref[Array[ref[Signature]?]]?
    {
        let types Checker.union_or_intersection_types_of(t)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        ; ★ THE MEMBER NAME IS PART OF THE GUARD, not of the transform: every
        ; constituent must be an instantiation of the SAME member of the global
        ; Array or ReadonlyArray. The stop that stood here left the name out
        ; because nothing past the guard used it.
        var member_name Slice[char]()
        var i 0
        while i < n
        {
            let row list[i]
            if row = null
                return null
            let ct row as ref[Type]
            if (ct.object_flags & ObjectFlagsInstantiated) = 0
                return null
            if ct.symbol = null
                return null
            let sym ct.symbol as ref[Symbol]
            let parent Symbol.parent_of(sym)
            if parent = null
                return null
            let ok this.is_array_or_tuple_symbol(parent as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            if ok = false
                return null
            let nm Symbol.name_of(sym)
            if i = 0
                set member_name: nm
            else
            {
                if member_name.length <> nm.length
                    return null
                if Checker.bytes_equal(member_name, 0, nm, 0, nm.length as int) = false
                    return null
            }
            set i: i + 1
        }
        ; "Transform the type from `(A[] | B[])["member"]` to `(A | B)[]["member"]`
        ; (since we pretend array is covariant anyway)."
        ;
        ; ★★★ THE `mapType` IS WRITTEN AS THE LOOP IT IS HERE, AND THE LICENCE IS
        ; THE ONE CALLER. `resolve_union_type_members` is the only route in, so `t`
        ; is a UNION and every constituent is an object type the guard above has
        ; already refused a union for — which is exactly the shape where mapTypeEx
        ; reduces to *map each constituent, union the results with
        ; UnionReductionLiteral*. Writing it as a MapTypeKind arm would buy the
        ; union recursion and the unchanged-identity exit, and neither can be
        ; reached from here.
        let element_types &Array[ref[Type]?]()
        var readonly false
        set i: 0
        while i < n
        {
            let row list[i]
            if row = null
                return null
            let ct row as ref[Type]
            if ct.symbol = null
                return null
            let parent Symbol.parent_of(ct.symbol as ref[Symbol])
            var global_type this.get_global_array_type()
            if this.is_readonly_array_symbol(parent)
            {
                set global_type: this.get_global_readonly_array_type()
                set readonly: true
            }
            if this.unported_mark() <> mark
                return null
            if global_type = null
                return null
            let tps this.interface_type_parameters_of(global_type as ref[Type])
            if tps = null
                return null
            let tp (tps as ref[Array[ref[Type]?]])[0]
            if tp = null
                return null
            let arg this.instantiate_type(tp as ref[Type], Checker.mapper_of(ct))
            if this.unported_mark() <> mark
                return null
            if arg = null
                return null
            element_types.add(arg)
            set i: i + 1
        }
        let element this.get_union_type_ex(element_types, UnionReductionLiteral, null, null)
        if element = null
            return null
        let array_type this.create_array_type_ex(element, readonly)
        if array_type = null
            return null
        let member this.get_type_of_property_of_type(array_type as ref[Type], member_name)
        if this.unported_mark() <> mark
            return null
        if member = null
            return null
        this.get_signatures_of_type(member as ref[Type], SignatureKindCall)
    }

    ; isReadonlyArraySymbol — the half of isArrayOrTupleSymbol that decides WHICH
    ; of the two globals a constituent came from, and therefore whether the array
    ; the transform builds is readonly.
    procedure is_readonly_array_symbol(this, symbol: ref[Symbol]?) returns bool
    {
        if symbol = null
            return false
        let gr this.get_global_readonly_array_type()
        if gr = null
            return false
        let rsym (gr as ref[Type]).symbol
        if rsym = null
            return false
        this.get_symbol_if_same_reference(symbol as ref[Symbol], rsym as ref[Symbol]) <> null
    }

    ; isArrayOrTupleSymbol / isReadonlyArraySymbol. ★The name says *tuple* and the
    ; body says Array or ReadonlyArray — the reference's own naming, kept.
    procedure is_array_or_tuple_symbol(this, symbol: ref[Symbol]) returns bool
    {
        let mark this.unported_mark()
        let ga this.get_global_array_type()
        let gr this.get_global_readonly_array_type()
        if this.unported_mark() <> mark
            return false
        if ga = null
            return false
        if gr = null
            return false
        let asym (ga as ref[Type]).symbol
        let rsym (gr as ref[Type]).symbol
        if asym = null
            return false
        if rsym = null
            return false
        if this.get_symbol_if_same_reference(symbol, asym as ref[Symbol]) <> null
            return true
        this.get_symbol_if_same_reference(symbol, rsym as ref[Symbol]) <> null
    }

    ; getUnionIndexInfos, whole. An index signature survives into the union only
    ; when EVERY constituent has one for the same key type.
    procedure get_union_index_infos(this, types: ref[Array[ref[Type]?]]) returns ref[Array[ref[IndexInfo]?]]?
    {
        let n types.get_length() as int
        if n = 0
            return null
        let first types[0]
        if first = null
            return null
        let mark this.unported_mark()
        let source_infos this.get_index_infos_of_type(first as ref[Type])
        if this.unported_mark() <> mark
            return null
        if source_infos = null
            return null
        let src source_infos as ref[Array[ref[IndexInfo]?]]
        let sn src.get_length() as int
        let out this.new_index_info_list()
        var i 0
        while i < sn
        {
            let row src[i]
            set i: i + 1
            if row = null
                continue
            let info row as ref[IndexInfo]
            if info.key_type = null
                continue
            let key info.key_type as ref[Type]
            var every true
            var readonly false
            let values &Array[ref[Type]?]()
            var j 0
            while j < n
            {
                let crow types[j]
                set j: j + 1
                if crow = null
                {
                    set every: false
                    break
                }
                let ct crow as ref[Type]
                let ci this.get_index_info_of_type(ct, key)
                if this.unported_mark() <> mark
                    return null
                if ci = null
                {
                    set every: false
                    break
                }
                if (ci as ref[IndexInfo]).is_readonly
                    set readonly: true
                let vt this.get_index_type_of_type(ct, key)
                if this.unported_mark() <> mark
                    return null
                values.add(vt)
            }
            if every = false
                continue
            let value this.get_union_type(values)
            if this.unported_mark() <> mark
                return null
            if value = null
                continue
            out.add(this.new_index_info(key, value, readonly, null))
        }
        out
    }

    ; includeMixinType — the return type of the constituent at `index`, intersected
    ; with the return type of the FIRST construct signature of every MIXIN
    ; constituent. ★★The index's own entry is the type PASSED IN and not the one
    ; read back off `types[index]`: the caller has already resolved it, and
    ; upstream places it in the list at exactly that position.
    procedure include_mixin_type(this, t: ref[Type], types: ref[Array[ref[Type]?]], mixin_flags: ref[Array[bool]], index: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let n types.get_length() as int
        let mixed &Array[ref[Type]?]()
        var i 0
        while i < n
        {
            if i = index
                mixed.add(t)
            if i <> index
            {
                var is_mixin false
                if i < (mixin_flags.get_length() as int)
                    set is_mixin: mixin_flags[i]
                if is_mixin
                {
                    let row types[i]
                    if row = null
                        return null
                    let sigs this.get_signatures_of_type(row as ref[Type], SignatureKindConstruct)
                    if this.unported_mark() <> mark
                        return null
                    if sigs = null
                        return null
                    let sl sigs as ref[Array[ref[Signature]?]]
                    if (sl.get_length() as int) = 0
                        return null
                    let first sl[0]
                    if first = null
                        return null
                    let rt this.get_return_type_of_signature(first as ref[Signature])
                    if this.unported_mark() <> mark
                        return null
                    if rt = null
                        return null
                    mixed.add(rt)
                }
            }
            set i: i + 1
        }
        this.get_intersection_type(mixed)
    }

    ; resolveIntersectionTypeMembers, whole since slice 176 — the MIXIN
    ; return-type mixing is the arm that stood as a stop.
    procedure resolve_intersection_type_members(this, t: ref[Type])
    {
        let mark this.unported_mark()
        let types_row Checker.union_or_intersection_types_of(t)
        if types_row = null
            return
        let types types_row as ref[Array[ref[Type]?]]
        let n types.get_length() as int
        let mixin_flags this.find_mixins(types)
        if this.unported_mark() <> mark
            return
        if mixin_flags = null
            return
        let flags mixin_flags as ref[Array[bool]]
        var mixin_count 0
        var f 0
        while f < n
        {
            if f < (flags.get_length() as int)
            {
                if flags[f]
                    set mixin_count: mixin_count + 1
            }
            set f: f + 1
        }
        let call_signatures this.new_signature_list()
        let construct_signatures this.new_signature_list()
        let index_infos this.new_index_info_list()
        var i 0
        while i < n
        {
            let row types[i]
            if row = null
                return
            let ct row as ref[Type]
            var is_mixin false
            if i < (flags.get_length() as int)
                set is_mixin: flags[i]
            if is_mixin = false
            {
                let constructs this.get_signatures_of_type(ct, SignatureKindConstruct)
                if this.unported_mark() <> mark
                    return
                var cn 0
                if constructs <> null
                    set cn: (constructs as ref[Array[ref[Signature]?]]).get_length() as int
                var mix false
                if cn <> 0
                {
                    if mixin_count > 0
                        set mix: true
                }
                if mix
                {
                    ; ★★★ THE MIXIN MIXING, SLICE 176. Each surviving construct
                    ; signature is CLONED and its resolved return type replaced
                    ; by the intersection of its own return type with the return
                    ; type of every MIXIN constituent's first construct
                    ; signature — `{ new(...args: any[]) => A } & { new(s: string)
                    ; => B }` becoming the single `new(s: string) => A & B` the
                    ; reference's own comment names. ★The clone is what keeps the
                    ; constituent's signature list untouched: the return type is
                    ; written into the CLONE's resolved cell, which is upstream's
                    ; `clone.resolvedReturnType = …` verbatim.
                    let mixed this.new_signature_list()
                    let cl constructs as ref[Array[ref[Signature]?]]
                    var ci 0
                    while ci < cn
                    {
                        let crow cl[ci]
                        set ci: ci + 1
                        if crow = null
                            return
                        let csig crow as ref[Signature]
                        let rt this.get_return_type_of_signature(csig)
                        if this.unported_mark() <> mark
                            return
                        if rt = null
                            return
                        let inc this.include_mixin_type(rt as ref[Type], types, flags, i)
                        if this.unported_mark() <> mark
                            return
                        if inc = null
                            return
                        let clone this.clone_signature(csig)
                        set clone.resolved_return_type: inc
                        mixed.add(clone)
                    }
                    this.append_signatures_deduped(construct_signatures, mixed)
                    if this.unported_mark() <> mark
                        return
                }
                if mix = false
                {
                    this.append_signatures_deduped(construct_signatures, constructs)
                    if this.unported_mark() <> mark
                        return
                }
            }
            let calls this.get_signatures_of_type(ct, SignatureKindCall)
            if this.unported_mark() <> mark
                return
            this.append_signatures_deduped(call_signatures, calls)
            if this.unported_mark() <> mark
                return
            let infos this.get_index_infos_of_type(ct)
            if this.unported_mark() <> mark
                return
            if infos <> null
            {
                let ilist infos as ref[Array[ref[IndexInfo]?]]
                let inn ilist.get_length() as int
                var k 0
                while k < inn
                {
                    let irow ilist[k]
                    set k: k + 1
                    if irow = null
                        continue
                    this.append_index_info(index_infos, irow as ref[IndexInfo], false)
                    if this.unported_mark() <> mark
                        return
                }
            }
            set i: i + 1
        }
        this.set_structured_type_members(t, null, call_signatures, construct_signatures, index_infos)
    }

    ; appendSignatures — the reference's DEDUPLICATING append, and it is a
    ; different function from the static `append_signatures` two chapters up: that
    ; one is this port's own concat inside set_structured_type_members, this one is
    ; upstream's and drops a signature identical to one already collected. An
    ; intersection of two types declaring the same method must not get it twice.
    procedure append_signatures_deduped(this, dest: ref[Array[ref[Signature]?]], src: ref[Array[ref[Signature]?]]?)
    {
        if src = null
            return
        let mark this.unported_mark()
        let list src as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let sig row as ref[Signature]
            let dn dest.get_length() as int
            var seen false
            var j 0
            while j < dn
            {
                let drow dest[j]
                set j: j + 1
                if drow = null
                    continue
                if this.compare_signatures_identical(drow as ref[Signature], sig, false, false, false, SignatureComparerIdentical)
                {
                    set seen: true
                    break
                }
                if this.unported_mark() <> mark
                    return
            }
            if seen = false
                dest.add(sig)
        }
    }

    procedure resolve_structured_type_members(this, t: ref[Type]) returns ref[StructuredMembers]?
    {
        if (t.object_flags & ObjectFlagsMembersResolved) = 0
        {
            let resolve_mark this.unported_mark()
            if (t.flags & TypeFlagsObject) <> 0
            {
                if (t.object_flags & ObjectFlagsReference) <> 0
                    this.resolve_type_reference_members(t)
                if (t.object_flags & ObjectFlagsReference) = 0
                {
                    if (t.object_flags & ObjectFlagsClassOrInterface) <> 0
                        this.resolve_class_or_interface_members(t)
                    if (t.object_flags & ObjectFlagsClassOrInterface) = 0
                    {
                        ; ★ Slice 160. The arm stands here, ABOVE Anonymous, because a
                        ; reverse-mapped type carries `ReverseMapped | Anonymous`
                        ; (create_reverse_mapped_type mints it with both) and the
                        ; anonymous resolver would ask it for a symbol it has none of.
                        if (t.object_flags & ObjectFlagsReverseMapped) <> 0
                            this.resolve_reverse_mapped_type_members(t)
                        if (t.object_flags & ObjectFlagsReverseMapped) = 0
                        {
                            if (t.object_flags & ObjectFlagsAnonymous) <> 0
                                this.resolve_anonymous_type_members(t)
                            if (t.object_flags & ObjectFlagsAnonymous) = 0
                            {
                                if (t.object_flags & ObjectFlagsMapped) <> 0
                                    this.resolve_mapped_type_members(t)
                                if (t.object_flags & ObjectFlagsMapped) = 0
                                {
                                    this.record_unported("resolve-structured-type-members-object", t.object_flags)
                                    return null
                                }
                            }
                        }
                    }
                }
            }
            if (t.flags & TypeFlagsObject) = 0
            {
                if (t.flags & TypeFlagsUnion) <> 0
                    this.resolve_union_type_members(t)
                if (t.flags & TypeFlagsUnion) = 0
                {
                    if (t.flags & TypeFlagsIntersection) <> 0
                        this.resolve_intersection_type_members(t)
                    if (t.flags & TypeFlagsIntersection) = 0
                    {
                        this.record_unported("resolve-structured-type-members", t.flags)
                        return null
                    }
                }
                ; The half-filled record must not survive a stop, on the object
                ; arm's own rule three screens down.
                if this.unported_mark() <> resolve_mark
                {
                    if (t.object_flags & ObjectFlagsMembersResolved) <> 0
                        set t.object_flags: t.object_flags xor ObjectFlagsMembersResolved
                    return null
                }
                return Checker.structured_members_of(t)
            }
            ; ★★★ The half-filled record must not survive a stop — see the header.
            if this.unported_mark() <> resolve_mark
            {
                if (t.object_flags & ObjectFlagsMembersResolved) <> 0
                    set t.object_flags: t.object_flags xor ObjectFlagsMembersResolved
                return null
            }
        }
        Checker.structured_members_of(t)
    }

    ; ── slice 127: the SYNTHESIZED PROPERTY of a union or intersection ───────
    ;
    ; ★★★ THIS IS WHAT A PROPERTY ACCESS ON `A | B` ANSWERS, and it is a SYMBOL
    ; THAT DOES NOT EXIST IN ANY DECLARATION. The reference mints one per (type,
    ; name) pair, caches it on the type, and gives it the union or intersection of
    ; the constituents' property types plus a flags word recording what the
    ; constituents disagreed about — which is where `HasNonUniformType`,
    ; `HasLiteralType`, the three accessibility bits and the two Partial bits come
    ; from. Every later question about the property — is it readonly, is it
    ; private in one constituent, does the intersection reduce to never — is a
    ; test on that word.

    ; getPropertyOfUnionOrIntersectionType. The READ-partial filter is the whole
    ; difference from the function below it: a partial property exists for
    ; discriminant identification and must not be visible as a property.
    procedure get_property_of_union_or_intersection_type(this, t: ref[Type], d: Slice[char], skip_object_function_property_augment: bool) returns ref[Symbol]?
    {
        let prop this.get_union_or_intersection_property(t, d, skip_object_function_property_augment)
        if prop = null
            return null
        if (Symbol.check_flags_of(prop as ref[Symbol]) & CheckFlagsReadPartial) <> 0
            return null
        prop
    }

    ; getUnionOrIntersectionProperty — the CACHE, and it is not an optimisation.
    ; ★★★ THE IDENTITY OF THE ANSWER IS OBSERVABLE: `mergedInstantiations`, the
    ; relation's property comparisons and every `prop != singleProp` test compare
    ; SYMBOLS, so answering a fresh symbol each time would make a type unequal to
    ; itself. ★The non-augmented answer is PROPAGATED into the augmented cache
    ; unless it is partial, which is the reference's own line and saves the second
    ; synthesis for every name both spellings agree on.
    procedure get_union_or_intersection_property(this, t: ref[Type], d: Slice[char], skip_object_function_property_augment: bool) returns ref[Symbol]?
    {
        let cache this.union_property_cache_of(t, skip_object_function_property_augment)
        if cache = null
            return null
        let table cache as ref[SymbolTable]
        let hit SymbolTable.get(table, d)
        if hit <> null
            return hit
        let mark this.unported_mark()
        let prop this.create_union_or_intersection_property(t, d, skip_object_function_property_augment)
        if this.unported_mark() <> mark
            return null
        if prop = null
            return null
        let p prop as ref[Symbol]
        SymbolTable.set_entry(host, table, d, p)
        if skip_object_function_property_augment
        {
            if (Symbol.check_flags_of(p) & CheckFlagsPartial) = 0
            {
                let augmented this.union_property_cache_of(t, false)
                if augmented <> null
                {
                    let at augmented as ref[SymbolTable]
                    if SymbolTable.get(at, d) = null
                        SymbolTable.set_entry(host, at, d, p)
                }
            }
        }
        p
    }

    ; `ast.GetSymbolTable(&t.AsUnionOrIntersectionType().propertyCache…)` — the
    ; table is made on first use, which is what GetSymbolTable does.
    procedure union_property_cache_of(this, t: ref[Type], skip_augment: bool) returns ref[SymbolTable]?
    {
        choose t.data
            when u: Union
            {
                var du u
                if skip_augment
                {
                    if du.property_cache_no_augment = null
                    {
                        set du.property_cache_no_augment: SymbolTable.create(host)
                        set t.data: TypeData.Union(du)
                    }
                    return du.property_cache_no_augment
                }
                if du.property_cache = null
                {
                    set du.property_cache: SymbolTable.create(host)
                    set t.data: TypeData.Union(du)
                }
                return du.property_cache
            }
            when x: Intersection
            {
                var di x
                if skip_augment
                {
                    if di.property_cache_no_augment = null
                    {
                        set di.property_cache_no_augment: SymbolTable.create(host)
                        set t.data: TypeData.Intersection(di)
                    }
                    return di.property_cache_no_augment
                }
                if di.property_cache = null
                {
                    set di.property_cache: SymbolTable.create(host)
                    set t.data: TypeData.Intersection(di)
                }
                return di.property_cache
            }
        null
    }

    ; createUnionOrIntersectionProperty, WHOLE — checker.go's second-largest
    ; function at 208 reference lines.
    ;
    ; ★★★ THE WALK ACCUMULATES SIX THINGS AT ONCE and none of them can be split
    ; out: `singleProp` (the first constituent's property, and the answer when no
    ; constituent disagrees), `propSet` (the constituents that DO disagree),
    ; `indexTypes` (the union arm's index-signature stand-ins), `propFlags`, the
    ; CHECK flags and `optionalFlag` — whose direction is opposite for a union
    ; (`|=`, optional if ANY is) and an intersection (`&=`, optional only if ALL
    ; are).
    ;
    ; ★★ `mergedInstantiations` IS NOT A FLAG ABOUT THE WALK BUT ABOUT ONE SYMBOL:
    ; two properties that are instantiations of one another with identical types
    ; are treated as one, and the bit records that the survivor's PARENT has to be
    ; reset — otherwise `('string[] | number[]').length` prints as
    ; `Array<string>.length`.
    ;
    ; ★ The reference's OrderedSet is a list here with a membership scan: a propSet
    ; holds one entry per DISAGREEING constituent, so it is two or three entries
    ; long in every case this corpus produces, and a hash table for that is a table
    ; nothing can measure.
    procedure create_union_or_intersection_property(this, containing_type: ref[Type], d: Slice[char], skip_object_function_property_augment: bool) returns ref[Symbol]?
    {
        let mark this.unported_mark()
        let types_row Checker.union_or_intersection_types_of(containing_type)
        if types_row = null
            return null
        let types types_row as ref[Array[ref[Type]?]]
        let count types.get_length() as int
        var is_union false
        if (containing_type.flags & TypeFlagsUnion) <> 0
            set is_union: true
        var prop_flags SymbolFlagsNone
        var single_prop: ref[Symbol]? null
        let prop_set this.new_symbol_list()
        let index_types &Array[ref[Type]?]()
        var check_flags 0
        var optional_flag 0
        if is_union = false
        {
            set check_flags: CheckFlagsReadonly
