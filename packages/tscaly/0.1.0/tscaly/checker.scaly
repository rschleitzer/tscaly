    ; lists, non-empty. ★It is written as a running INTERSECTION over the first
    ; symbol's list rather than as a set, for the reason prop_set is a list: the
    ; lists are one or two entries long.
    function has_common_declaration(this, symbols: ref[Array[ref[Symbol]?]]) returns bool
    {
        let n symbols.get_length() as int
        var common: ref[Array[ref[AstNode]?]]? null
        var i 0
        while i < n
        {
            let row symbols[i]
            set i: i + 1
            if row = null
                return false
            let sym row as ref[Symbol]
            let dn Symbol.declaration_count(sym)
            if dn = 0
                return false
            if common = null
            {
                let made &Array[ref[AstNode]?]^host()
                let list made as ref[Array[ref[AstNode]?]]
                var k 0
                while k < dn
                {
                    list.add(Symbol.declaration_at(sym, k))
                    set k: k + 1
                }
                set common: list
                continue
            }
            let cur common as ref[Array[ref[AstNode]?]]
            let kept &Array[ref[AstNode]?]^host()
            let next kept as ref[Array[ref[AstNode]?]]
            var c 0
            let cn cur.get_length() as int
            while c < cn
            {
                let drow cur[c]
                set c: c + 1
                if drow = null
                    continue
                let dnode drow as ref[AstNode]
                var found false
                var k2 0
                while k2 < dn
                {
                    let cand Symbol.declaration_at(sym, k2)
                    set k2: k2 + 1
                    if cand = null
                        continue
                    if (cand as ref[AstNode]) = dnode
                    {
                        set found: true
                        break
                    }
                }
                if found
                    next.add(dnode)
            }
            set common: next
            if (next.get_length() as int) = 0
                return false
        }
        if common = null
            return false
        (common as ref[Array[ref[AstNode]?]]).get_length() <> 0
    }

    ; getPropertiesOfUnionOrIntersectionType.
    ;
    ; ★★ THE UNION'S EARLY BREAK IS THE REFERENCE'S OWN and it is not an
    ; optimisation either: *"The properties of a union type are those that are
    ; present in all constituent types, so we only need to check the properties of
    ; the first type without index signature"*.
    procedure get_properties_of_union_or_intersection_type(this, t: ref[Type]) returns ref[Array[ref[Symbol]?]]?
    {
        let cached this.resolved_properties_of(t)
        if cached <> null
            return cached
        let mark this.unported_mark()
        let types_row Checker.union_or_intersection_types_of(t)
        if types_row = null
            return null
        let types types_row as ref[Array[ref[Type]?]]
        let n types.get_length() as int
        let props this.new_symbol_list()
        let checked SymbolTable.create(host)
        var skip false
        if (t.flags & TypeFlagsIntersection) <> 0
            set skip: true
        var i 0
        while i < n
        {
            let row types[i]
            set i: i + 1
            if row = null
                continue
            let current row as ref[Type]
            let list this.get_properties_of_type(current)
            if this.unported_mark() <> mark
                return null
            if list <> null
            {
                let plist list as ref[Array[ref[Symbol]?]]
                let pn plist.get_length() as int
                var k 0
                while k < pn
                {
                    let prow plist[k]
                    set k: k + 1
                    if prow = null
                        continue
                    let prop prow as ref[Symbol]
                    let nd Symbol.name_of(prop)
                    let nl Symbol.name_len_of(prop)
                    if SymbolTable.get(checked, nd) <> null
                        continue
                    SymbolTable.set_entry(host, checked, nd, prop)
                    let combined this.get_property_of_union_or_intersection_type(t, nd, skip)
                    if this.unported_mark() <> mark
                        return null
                    if combined <> null
                        props.add(combined)
                }
