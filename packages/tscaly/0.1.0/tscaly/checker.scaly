                    if candidate.declaration <> null
                        set is_js2: Parser.is_in_js_file(candidate.declaration as ref[AstNode])
                    set check_candidate: this.get_signature_instantiation(candidate, again, is_js2, ctx2.inferred_type_parameters)
                    if this.unported_mark() <> mark
