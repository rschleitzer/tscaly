        ; the language service sets, so has_correct_arity takes it as the constant
        ; false it is here.
        ; the resolution's working state is this routine's
        var state_value CallState(node, args, cands, type_arguments, arg_check_mode, single_non_generic, null, null, null)
        let state &state_value
        ; "the subtype pass is just important for choosing the best signature. So in
        ; the case where there is only one signature, the subtype pass is useless."
        var result: ref[Signature]? null
        if count > 1
        {
            set result: this.choose_overload(state, RelationSubtype)
            if this.unported_mark() <> mark
                return null
        }
        if result = null
        {
            set result: this.choose_overload(state, RelationAssignable)
            if this.unported_mark() <> mark
                return null
        }
        if result <> null
            return result
        ; ── the FAILURE PASS, slice 138 ──────────────────────────────────────
        ;
