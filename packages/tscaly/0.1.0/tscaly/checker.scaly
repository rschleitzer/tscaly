        let md this.resolve_external_module(location, module_reference, DiagThis_JSX_tag_requires_the_module_path_0_to_exist_but_none_could_be_found_Make_sure_you_have_types_for_the_appropriate_package_installed, location, false)
        if this.unported_mark() <> mark
