            if (t.flags & TypeFlagsUnion) <> 0
            {
                let infos this.get_index_infos_of_type(current)
                if this.unported_mark() <> mark
                    return null
                var infos_n 0
                if infos <> null
                    set infos_n: (infos as ref[Array[ref[IndexInfo]?]]).get_length() as int
                if infos_n = 0
                    break
            }
        }
        this.set_resolved_properties(t, props)
        props
    }

    function resolved_properties_of(this, t: ref[Type]) returns ref[Array[ref[Symbol]?]]?
    {
        choose t.data
            when u: Union
                return u.resolved_properties
            when x: Intersection
                return x.resolved_properties
        null
    }

    procedure set_resolved_properties(this, t: ref[Type], props: ref[Array[ref[Symbol]?]]?)
    {
        choose t.data
            when u: Union
            {
                var du u
                set du.resolved_properties: props
                set t.data: TypeData.Union(du)
            }
            when x: Intersection
            {
                var di x
                set di.resolved_properties: props
                set t.data: TypeData.Intersection(di)
            }
    }

    ; getTypeOfSymbolWithDeferredType / getWriteTypeOfSymbolWithDeferredType — the
    ; two readers of the three `deferred_*` slots.
    procedure get_type_of_symbol_with_deferred_type(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.resolved_type <> null
            return links.resolved_type
        if this.value_symbol_extra_read(links).deferred_parent = null
            return null
        if this.value_symbol_extra_read(links).deferred_constituents = null
            return null
        let parent this.value_symbol_extra_read(links).deferred_parent as ref[Type]
        let cs this.value_symbol_extra_read(links).deferred_constituents as ref[Array[ref[Type]?]]
        var t: ref[Type]? null
        if (parent.flags & TypeFlagsUnion) <> 0
            set t: this.get_union_type(cs)
        else
            set t: this.get_intersection_type(cs)
        if t = null
            return null
        set links.resolved_type: t
        links.resolved_type
    }

    procedure get_write_type_of_symbol_with_deferred_type(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.write_type <> null
            return links.write_type
        if this.value_symbol_extra_read(links).deferred_parent = null
            return null
        var wn 0
        if this.value_symbol_extra_read(links).deferred_write_constituents <> null
            set wn: ((this.value_symbol_extra_read(links).deferred_write_constituents as ref[Array[ref[Type]?]]).get_length() as int)
        if wn = 0
        {
            set links.write_type: this.get_type_of_symbol_with_deferred_type(symbol)
            return links.write_type
        }
        let parent this.value_symbol_extra_read(links).deferred_parent as ref[Type]
        let ws this.value_symbol_extra_read(links).deferred_write_constituents as ref[Array[ref[Type]?]]
        var t: ref[Type]? null
        if (parent.flags & TypeFlagsUnion) <> 0
            set t: this.get_union_type(ws)
        else
            set t: this.get_intersection_type(ws)
        if t = null
            return null
        set links.write_type: t
        links.write_type
    }

    ; ── getReducedApparentType and its two halves ────────────────────────────
    ;
    ; ★★★ IT STANDS IN FRONT OF ALL THREE ACCESSORS AND IT IS THE IDENTITY FOR
    ; EVERY TYPE THIS SLICE HANDS THEM, which is a claim that has to be WRITTEN
    ; rather than assumed: an object type is neither a union nor an intersection
    ; (so getReducedType answers it), and it is not instantiable and carries none
    ; of the primitive flags (so getApparentType answers it). Every arm that is not
    ; the identity reports, so the claim is checked by the corpus rather than by a
    ; reading.

    ; getReducedType. Both of its arms need a type kind this port cannot make —
    ; the union arm getReducedUnionType, the intersection arm
    ; getPropertiesOfUnionOrIntersectionType — and nothing here sets either flag,
    ; for the reason get_widened_literal_type's union arm reports rather than loops.
    procedure get_reduced_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) <> 0
        {
            ; ★ The memo is only consulted for a union that CONTAINS an
            ; intersection: nothing else can reduce, so the reference does not
            ; even look.
            if (t.object_flags & ObjectFlagsContainsIntersections) = 0
                return t
            let memo Checker.resolved_reduced_type_of(t)
            if memo <> null
                return memo
            let mark this.unported_mark()
            let reduced this.get_reduced_union_type(t)
            if this.unported_mark() <> mark
                return null
            if reduced = null
                return null
            Checker.set_resolved_reduced_type(t, reduced)
            return reduced
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            if (t.object_flags & ObjectFlagsIsNeverIntersectionComputed) = 0
            {
                set t.object_flags: t.object_flags | ObjectFlagsIsNeverIntersectionComputed
                let mark this.unported_mark()
                let props this.get_properties_of_union_or_intersection_type(t)
                if this.unported_mark() <> mark
                    return null
                if props <> null
                {
                    let list props as ref[Array[ref[Symbol]?]]
                    let n list.get_length() as int
                    var i 0
                    while i < n
                    {
                        let row list[i]
                        set i: i + 1
                        if row = null
                            continue
                        if this.is_never_reduced_property(row as ref[Symbol])
                        {
                            set t.object_flags: t.object_flags | ObjectFlagsIsNeverIntersection
                            break
                        }
                        if this.unported_mark() <> mark
                            return null
                    }
                }
            }
            if (t.object_flags & ObjectFlagsIsNeverIntersection) <> 0
                return never_type
            return t
        }
        t
    }

    ; getReducedUnionType. ★`core.SameMap` answers the SAME slice when nothing
    ; changed, and the identity test on it is what keeps a union that reduces to
    ; itself from being re-interned.
    procedure get_reduced_union_type(this, union_type: ref[Type]) returns ref[Type]?
    {
        let types_row Checker.union_or_intersection_types_of(union_type)
        if types_row = null
            return union_type
        let types types_row as ref[Array[ref[Type]?]]
        let n types.get_length() as int
        let mark this.unported_mark()
        let reduced &Array[ref[Type]?]()
        var same true
        var i 0
        while i < n
        {
            let row types[i]
            set i: i + 1
            if row = null
                return null
            let r this.get_reduced_type(row as ref[Type])
            if this.unported_mark() <> mark
                return null
            if r = null
                return null
            if (r as ref[Type]) <> (row as ref[Type])
                set same: false
            reduced.add(r)
        }
        if same
            return union_type
        let out this.get_union_type(reduced)
        if this.unported_mark() <> mark
            return null
        if out = null
            return null
        let o out as ref[Type]
        if (o.flags & TypeFlagsUnion) <> 0
            Checker.set_resolved_reduced_type(o, o)
        o
    }

    function resolved_reduced_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when u: Union
                return u.resolved_reduced_type
        null
    }

    procedure set_resolved_reduced_type(t: ref[Type], r: ref[Type]?)
    {
        choose t.data
            when u: Union
            {
                var du u
                set du.resolved_reduced_type: r
                set t.data: TypeData.Union(du)
            }
    }

    ; isNeverReducedProperty / isDiscriminantWithNeverType / isConflictingPrivateProperty.
    ;
    ; ★★★ THE MASK IS AN EQUALITY AND NOT A TEST: `CheckFlags &
    ; (NonUniformAndLiteral|HasNeverType) == NonUniformAndLiteral` means BOTH of
    ; the first two bits and NEITHER of the third — *non-uniform types, at least
    ; one a literal, and none `never`*. Writing it as three separate tests is what
    ; a reader would do and it would answer the same thing; writing it as the mask
    ; is what makes it obvious that the third bit is a VETO.
    procedure is_never_reduced_property(this, prop: ref[Symbol]) returns bool
    {
        if this.is_discriminant_with_never_type(prop)
            return true
        Checker.is_conflicting_private_property(prop)
    }

    procedure is_discriminant_with_never_type(this, prop: ref[Symbol]) returns bool
    {
        if (Symbol.flags_of(prop) & SymbolFlagsOptional) <> 0
            return false
        if (Symbol.check_flags_of(prop) & (CheckFlagsNonUniformAndLiteral | CheckFlagsHasNeverType)) <> CheckFlagsNonUniformAndLiteral
            return false
        let mark this.unported_mark()
        let t this.get_type_of_symbol(prop)
        if this.unported_mark() <> mark
            return false
        if t = null
            return false
        ((t as ref[Type]).flags & TypeFlagsNever) <> 0
    }

    function is_conflicting_private_property(prop: ref[Symbol]) returns bool
    {
        if Symbol.value_declaration_of(prop) <> null
            return false
        (Symbol.check_flags_of(prop) & CheckFlagsContainsPrivate) <> 0
    }

    ; getApparentType.
    ;
    ; ★★★ SEVEN OF ITS ELEVEN ARMS END IN A GLOBAL LIB TYPE and are therefore §3.11
    ; and not this slice: globalStringType, globalNumberType, getGlobalBigIntType,
    ; globalBooleanType, getGlobalESSymbolType, emptyObjectType and
    ; stringNumberSymbolType. They are one report between them rather than seven,
    ; because they are one wall.
    ;
    ; ★★ THE INSTANTIABLE ARM IS WRITTEN because getBaseConstraintOfType landed in
    ; slice 81 and `unknownType` exists — so a type parameter constrained to an
    ; object type answers that object type here, exactly as upstream.
    ;
    ; ★★★ THE REFERENCE ARM IS WRITTEN SINCE SLICE 98, and it is the arm the whole
    ; slice is: `getTypeWithThisArgument(t, originalType, false)` re-anchors a class
    ; or interface reference on the `this` argument the constraint came from, which
    ; is what turns slice 97's 1 918 answered `this` expressions into slice 96's
    ; property accesses. It is the SAME function resolve_object_type_members has
    ; called since slice 67 — this arm is a second call site, not a second copy.
    ;
    ; ★ The last arm — `Unknown && !strictNullChecks` — is DEAD under this harness
    ; and not merely unreached: strictNullChecks is a constant TRUE here (see
    ; strict_null_checks' header), so the conjunct can never hold. It is written as
    ; the reference's test rather than folded away.
    procedure get_apparent_type(this, t: ref[Type]) returns ref[Type]?
    {
        var base: ref[Type]? null
        if (t.flags & TypeFlagsInstantiable) <> 0
        {
            let mark this.unported_mark()
            let constraint this.get_base_constraint_of_type(t)
            if this.unported_mark() <> mark
                return null
            if constraint = null
                set base: unknown_type
            if constraint <> null
                set base: constraint
        }
        if base = null
            set base: t
        let ty base as ref[Type]
        if (ty.object_flags & ObjectFlagsMapped) <> 0
            return this.get_apparent_type_of_mapped_type(ty)
        if (ty.object_flags & ObjectFlagsReference) <> 0
        {
            if ty <> t
                return this.get_type_with_this_argument(ty, t, false)
        }
        if (ty.flags & TypeFlagsIntersection) <> 0
            return this.get_apparent_type_of_intersection_type(ty, t)
        ; ── slice 124: the five primitive arms plus the two that need no global ──
        ;
        ; ★★★ THE ROW THAT STOOD HERE WAS ONE STOP FOR SEVEN ARMS, and the reason
        ; it could be is that five of them answer a GLOBAL type: `String`,
        ; `Number`, `BigInt`, `Boolean` and `Symbol` from the lib. §3.11's table
        ; now carries all five, so the arms are the reference's own — and their
        ; ORDER is load-bearing, because a boolean literal is BooleanLike and a
        ; string literal StringLike, and the flags overlap at `never`.
        ;
        ; ★★★ SLICE 154 TOOK THE `global_or_missing` WRAPPER OFF ALL FIVE ARMS.
        ; The paragraph that stood here read *a null from a getter is NOT the same
        ; as a stop: it means the lib has no such global … answering the primitive
        ; unchanged is the wrong answer with no diagnostic* — true about answering
        ; it UNCHANGED, and beside the point, because the reference answers neither
        ; the primitive nor nil: getGlobalType's arity-0 fall-through is
        ; `emptyObjectType`, which is now what the getters answer. See
        ; get_global_object_type's header for the measurement.
        if (ty.flags & TypeFlagsStringLike) <> 0
            return this.get_global_string_type()
        if (ty.flags & TypeFlagsNumberLike) <> 0
            return this.get_global_number_type()
        if (ty.flags & TypeFlagsBigIntLike) <> 0
            return this.get_global_big_int_type()
        if (ty.flags & TypeFlagsBooleanLike) <> 0
            return this.get_global_boolean_type()
        if (ty.flags & TypeFlagsESSymbolLike) <> 0
            return this.get_global_es_symbol_type()
        if (ty.flags & TypeFlagsNonPrimitive) <> 0
            return empty_object_type
        if (ty.flags & TypeFlagsIndex) <> 0
        {
            if string_number_symbol_type = null
            {
                this.record_unported("string-number-symbol-type-unminted", ty.flags)
                return null
            }
            return string_number_symbol_type
        }
        if (ty.flags & TypeFlagsUnknown) <> 0
        {
            if Checker.strict_null_checks() = false
                return empty_object_type
        }
        ty
    }

    ; getReducedApparentType — the reference's own three-call sandwich, with the
    ; comment it carries: getApparentType may answer a non-reduced union or
    ; intersection, so the reduction runs on both sides of it.
    procedure get_reduced_apparent_type(this, t: ref[Type]) returns ref[Type]?
    {
        let a this.get_reduced_type(t)
        if a = null
            return null
        let b2 this.get_apparent_type(a as ref[Type])
        if b2 = null
            return null
        this.get_reduced_type(b2 as ref[Type])
    }

    ; ── the three accessors ──────────────────────────────────────────────────

    procedure get_properties_of_object_type(this, t: ref[Type]) returns ref[Array[ref[Symbol]?]]?
    {
        if (t.flags & TypeFlagsObject) = 0
            return null
        let sm this.resolve_structured_type_members(t)
        if sm = null
            return null
        (sm as ref[StructuredMembers]).properties
    }

    ; getPropertiesOfType. Its union/intersection arm is
    ; getPropertiesOfUnionOrIntersectionType, which needs
    ; getPropertyOfUnionOrIntersectionType and the whole synthesised-property
    ; machinery; nothing here can make either type kind, so the arm reports.
    procedure get_properties_of_type(this, t: ref[Type]) returns ref[Array[ref[Symbol]?]]?
    {
        let reduced this.get_reduced_apparent_type(t)
        if reduced = null
            return null
        let ty reduced as ref[Type]
        if (ty.flags & TypeFlagsUnionOrIntersection) <> 0
            return this.get_properties_of_union_or_intersection_type(ty)
        this.get_properties_of_object_type(ty)
    }

    ; getSignaturesOfStructuredType — the SLICE of one list, which is what the
    ; single `signatures` slot and its count are for.
    procedure get_signatures_of_structured_type(this, t: ref[Type], kind: int) returns ref[Array[ref[Signature]?]]?
    {
        if (t.flags & TypeFlagsStructuredType) = 0
            return null
        let sm this.resolve_structured_type_members(t)
        if sm = null
            return null
        let d sm as ref[StructuredMembers]
        if d.signatures = null
            return null
        if kind = SignatureKindCall
        {
            if d.call_signatures_memo <> null
                return d.call_signatures_memo
        }
        else
        {
            if d.construct_signatures_memo <> null
                return d.construct_signatures_memo
        }
        let all d.signatures as ref[Array[ref[Signature]?]]
        let n all.get_length() as int
        var i 0
        if kind = SignatureKindConstruct
            set i: d.call_signature_count
        var stop n
        if kind = SignatureKindCall
            set stop: d.call_signature_count
        let out &Array[ref[Signature]?]^host((stop - i) as size_t)
        while i < stop
        {
            out.add(all[i])
            set i: i + 1
        }
        if kind = SignatureKindCall
            set d.call_signatures_memo: out
        else
            set d.construct_signatures_memo: out
        out
    }

    procedure get_signatures_of_type(this, t: ref[Type], kind: int) returns ref[Array[ref[Signature]?]]?
    {
        let reduced this.get_reduced_apparent_type(t)
        if reduced = null
            return null
        this.get_signatures_of_structured_type(reduced as ref[Type], kind)
    }

    procedure get_index_infos_of_structured_type(this, t: ref[Type]) returns ref[Array[ref[IndexInfo]?]]?
    {
        if (t.flags & TypeFlagsStructuredType) = 0
            return null
        let sm this.resolve_structured_type_members(t)
        if sm = null
            return null
        (sm as ref[StructuredMembers]).index_infos
    }

    procedure get_index_infos_of_type(this, t: ref[Type]) returns ref[Array[ref[IndexInfo]?]]?
    {
        let reduced this.get_reduced_apparent_type(t)
        if reduced = null
            return null
        this.get_index_infos_of_structured_type(reduced as ref[Type])
    }

    ; getApplicableIndexInfos — `core.Filter(getIndexInfosOfType(t), …)`. ★The
    ; SINGULAR twin two screens up (get_applicable_index_info) answers ONE info and
    ; synthesises an intersection when several apply; this one answers the list, and
    ; the two constraint checks below want every applicable info separately because
    ; each reports on its own declaration.
    procedure get_applicable_index_infos(this, t: ref[Type], key_type: ref[Type]) returns ref[Array[ref[IndexInfo]?]]
    {
        let out this.new_index_info_list()
        let infos this.get_index_infos_of_type(t)
        if infos = null
            return out
        let list infos as ref[Array[ref[IndexInfo]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let info row as ref[IndexInfo]
                let kt info.key_type
                if kt <> null
                {
                    if this.is_applicable_index_type(key_type, kt as ref[Type])
                        out.add(info)
                }
            }
            set i: i + 1
        }
        out
    }

    ; `c.getParentOfSymbol(prop) == t.symbol`, the test both constraint checks make
    ; three times over. ★It is a helper rather than three inline pairs because the
    ; null on either side must NOT compare equal: an unparented symbol and a type
    ; with no symbol are not "declared in the containing type", and `null = null`
    ; would say they were.
    procedure symbol_is_declared_in(this, sym: ref[Symbol]?, owner: ref[Type]) returns bool
    {
        if sym = null
            return false
        if owner.symbol = null
            return false
        let parent this.get_parent_of_symbol(sym as ref[Symbol])
        if parent = null
            return false
        (parent as ref[Symbol]) = (owner.symbol as ref[Symbol])
    }

    ; The same question about an INDEX INFO's declaration — `info.declaration != nil
    ; && c.getParentOfSymbol(c.getSymbolOfDeclaration(info.declaration)) == t.symbol`
    ; — answered as the declaration or null, which is what the caller's `core.OrElse`
    ; chain wants.
    procedure local_index_declaration(this, info: ref[IndexInfo], owner: ref[Type]) returns ref[AstNode]?
    {
        if info.declaration = null
            return null
        let d info.declaration as ref[AstNode]
        if this.symbol_is_declared_in(this.symbol_of_declaration(d), owner) = false
            return null
        d
    }

    ; ── slice 124: checkIndexConstraintForProperty ────────────────────────────
    ;
    ; ★★★ THE WHOLE FUNCTION IS ABOUT WHICH NODE TO REPORT ON, and the type
    ; question is one line at the end. Three candidates are computed —
    ; localPropDeclaration, localIndexDeclaration and the interface declaration —
    ; and where all three are absent the check is SKIPPED rather than reported
    ; elsewhere: the reference's comment says why (property and index signature
    ; inherited from two different base interfaces is legal), and that is the only
    ; reason this port must build the base-type loop rather than report on `t`.
    procedure check_index_constraint_for_property(this, t: ref[Type], prop: ref[Symbol], prop_name_type: ref[Type]?, prop_type: ref[Type]?)
    {
        let declaration Symbol.value_declaration_of(prop)
        var name null as ref[AstNode]?
        if declaration <> null
            set name: this.name_of_declaration(declaration as ref[AstNode])
        if name <> null
        {
            if AstNode.kind_of(name as ref[AstNode]) = KindPrivateIdentifier
                return
        }
        if prop_name_type = null
            return
        if prop_type = null
            return
        let mark this.unported_mark()
        let infos this.get_applicable_index_infos(t, prop_name_type as ref[Type])
        if this.unported_mark() <> mark
            return
        let ni infos.get_length() as int
        if ni = 0
            return
        var interface_declaration null as ref[AstNode]?
        if (t.object_flags & ObjectFlagsInterface) <> 0
        {
            if t.symbol <> null
                set interface_declaration: Checker.get_declaration_of_kind(t.symbol as ref[Symbol], KindInterfaceDeclaration)
        }
        ; `declaration != nil && ast.IsBinaryExpression(declaration) || name != nil
        ; && ast.IsComputedPropertyName(name)` — Go's precedence again: two
        ; disjuncts, each with its own null guard.
        var prop_declaration null as ref[AstNode]?
        if declaration <> null
        {
            if AstNode.kind_of(declaration as ref[AstNode]) = KindBinaryExpression
                set prop_declaration: declaration
        }
        if name <> null
        {
            if AstNode.kind_of(name as ref[AstNode]) = KindComputedPropertyName
                set prop_declaration: declaration
        }
        var local_prop_declaration null as ref[AstNode]?
        if this.symbol_is_declared_in(prop, t)
            set local_prop_declaration: declaration
        var i 0
        while i < ni
        {
            let row infos[i]
            if row <> null
            {
                let info row as ref[IndexInfo]
                var error_node local_prop_declaration
                if error_node = null
                    set error_node: this.local_index_declaration(info, t)
                if error_node = null
                {
                    if interface_declaration <> null
                    {
                        if this.base_carries_both_property_and_index(t, prop, info) = false
                            set error_node: interface_declaration
                    }
                }
                if error_node <> null
                {
                    if info.value_type <> null
                    {
                        let assignable this.is_type_assignable_to(prop_type as ref[Type], info.value_type as ref[Type])
                        if this.unported_mark() <> mark
                            return
                        if assignable = false
                        {
                            let prop_name this.symbol_arg(prop)
                            let prop_type_name this.type_arg(prop_type)
                            let key_name this.type_arg(info.key_type)
                            let value_name this.type_arg(info.value_type)
                            let related_mark this.diagnostic_mark()
                            this.error_on_node(error_node, DiagProperty_0_of_type_1_is_not_assignable_to_2_index_type_3, prop_name, prop_type_name, key_name, value_name)
                            if (prop_declaration <> null) and (error_node <> prop_declaration)
                                this.related_info_since(related_mark, prop_declaration, DiagX_0_is_declared_here, prop_name)
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; `core.Some(c.getBaseTypes(t), func(base) { getPropertyOfObjectType(base,
    ; prop.Name) != nil && getIndexTypeOfType(base, info.keyType) != nil })`.
    procedure base_carries_both_property_and_index(this, t: ref[Type], prop: ref[Symbol], info: ref[IndexInfo]) returns bool
    {
        if info.key_type = null
            return false
        let bases this.get_base_types(t)
        if bases = null
            return false
        let list bases as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let base row as ref[Type]
                if this.get_property_of_object_type(base, Symbol.name_of(prop)) <> null
                {
                    if this.get_index_type_of_type(base, info.key_type as ref[Type]) <> null
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; ── slice 124: checkIndexConstraintForIndexSignature ──────────────────────
    ;
    ; The property check's twin over two index signatures: `{ [k: string]: string;
    ; [k: number]: number }` is TS2413, and the same three-candidate error-node
    ; chain decides where it lands.
    procedure check_index_constraint_for_index_signature(this, t: ref[Type], check_info: ref[IndexInfo])
    {
        if check_info.key_type = null
            return
        let declaration check_info.declaration
        let mark this.unported_mark()
        let infos this.get_applicable_index_infos(t, check_info.key_type as ref[Type])
        if this.unported_mark() <> mark
            return
        let ni infos.get_length() as int
        if ni = 0
            return
        var interface_declaration null as ref[AstNode]?
        if (t.object_flags & ObjectFlagsInterface) <> 0
        {
            if t.symbol <> null
                set interface_declaration: Checker.get_declaration_of_kind(t.symbol as ref[Symbol], KindInterfaceDeclaration)
        }
        var local_check_declaration null as ref[AstNode]?
        if declaration <> null
        {
            let d declaration as ref[AstNode]
            if this.symbol_is_declared_in(this.symbol_of_declaration(d), t)
                set local_check_declaration: d
        }
        var i 0
        while i < ni
        {
            let row infos[i]
            if row <> null
            {
                let info row as ref[IndexInfo]
                if info <> check_info
                {
                    var error_node local_check_declaration
                    if error_node = null
                        set error_node: this.local_index_declaration(info, t)
                    if error_node = null
                    {
                        if interface_declaration <> null
                        {
                            if this.base_carries_both_index_infos(t, check_info, info) = false
                                set error_node: interface_declaration
                        }
                    }
                    if error_node <> null
                    {
                        if check_info.value_type <> null
                        {
                            if info.value_type <> null
                            {
                                let assignable this.is_type_assignable_to(check_info.value_type as ref[Type], info.value_type as ref[Type])
                                if this.unported_mark() <> mark
                                    return
                                if assignable = false
                                {
                                    let name_arg6 this.type_arg(check_info.key_type)
                                    let name_arg7 this.type_arg(check_info.value_type)
                                    let name_arg8 this.type_arg(info.key_type)
                                    let name_arg9 this.type_arg(info.value_type)
                                    this.error_on_node(error_node, DiagX_0_index_type_1_is_not_assignable_to_2_index_type_3, name_arg6, name_arg7, name_arg8, name_arg9)
                                }
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
    }

    ; `core.Some(c.getBaseTypes(t), func(base) { getIndexInfoOfType(base,
    ; checkInfo.keyType) != nil && getIndexTypeOfType(base, info.keyType) != nil })`.
    ; ★The two calls are DIFFERENT functions — an INFO on the left and a TYPE on the
    ; right — and that asymmetry is the reference's, not a slip: the left asks
    ; whether the base declares that index at all, the right what it yields.
    procedure base_carries_both_index_infos(this, t: ref[Type], check_info: ref[IndexInfo], info: ref[IndexInfo]) returns bool
    {
        if check_info.key_type = null
            return false
        if info.key_type = null
            return false
        let bases this.get_base_types(t)
        if bases = null
            return false
        let list bases as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let base row as ref[Type]
                if this.get_index_info_of_type(base, check_info.key_type as ref[Type]) <> null
                {
                    if this.get_index_type_of_type(base, info.key_type as ref[Type]) <> null
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; ── slice 124: checkIndexConstraints, the three loops ─────────────────────
    ;
    ; ★★★ THE ROW THIS CLOSES WAS THE FRONTIER'S SECOND LARGEST BY UNITS COMPLETED
    ; (34 hit, 23 of them blocked by nothing else), and the note that stood here
    ; named its wall exactly: everything below the empty-list guard *reads a type
    ; and compares it*. The three loops are the reference's own and they are not
    ; interchangeable — the first walks the type's RESOLVED properties, the second
    ; the declaration's LATE-BOUND members (whose symbols are not in that table),
    ; and the third pairs the index signatures against each other, only when there
    ; is more than one.
    procedure check_index_constraints(this, t: ref[Type], symbol: ref[Symbol]?, is_static_index: bool)
    {
        let mark this.unported_mark()
        let infos this.get_index_infos_of_type(t)
        if infos = null
            return
        let list infos as ref[Array[ref[IndexInfo]?]]
        let ninfos list.get_length() as int
        if ninfos = 0
            return
        let props this.get_properties_of_object_type(t)
        if props <> null
        {
            let pl props as ref[Array[ref[Symbol]?]]
            let pn pl.get_length() as int
            var pi 0
            while pi < pn
            {
                let row pl[pi]
                if row <> null
                {
                    let prop row as ref[Symbol]
                    ; `!(isStaticIndex && prop.Flags&Prototype != 0)` — the static
                    ; side's `prototype` is not an index-constrained member.
                    var skip false
                    if is_static_index
                    {
                        if (Symbol.flags_of(prop) & SymbolFlagsPrototype) <> 0
                            set skip: true
                    }
                    if skip = false
                    {
                        let name_type this.get_literal_type_from_property(prop, TypeFlagsStringOrNumberLiteralOrUnique, true)
                        let prop_type this.get_non_missing_type_of_symbol(prop)
                        if this.unported_mark() <> mark
                            return
                        this.check_index_constraint_for_property(t, prop, name_type, prop_type)
                        if this.unported_mark() <> mark
                            return
                    }
                }
                set pi: pi + 1
            }
        }
        ; The late-bound half. ★★ `!c.hasBindableName(member)` is the guard, so this
        ; loop runs for a member whose computed name is NOT late-bindable — and its
        ; property name comes from `getTypeOfExpression(member.Name().Expression())`
        ; rather than from the members table, because such a member has no entry
        ; there at all.
        var type_declaration null as ref[AstNode]?
        if symbol <> null
            set type_declaration: Symbol.value_declaration_of(symbol as ref[Symbol])
        if type_declaration <> null
        {
            let td type_declaration as ref[AstNode]
            if Checker.is_class_like(td)
            {
                let members AstNode.member_list_of(td)
                if members <> null
                {
                    let ml members as ref[Array[ref[AstNode]?]]
                    let mn ml.get_length() as int
                    var mi 0
                    while mi < mn
                    {
                        let mrow ml[mi]
                        if mrow <> null
                        {
                            let m mrow as ref[AstNode]
                            if b.is_static(m) = is_static_index
                            {
                                ; hasBindableName CHECKS — its late-bindable arm
                                ; runs checkComputedPropertyName — so the mark is
                                ; read after the call and not inside a branch.
                                let bindable this.has_bindable_name(m)
                                if this.unported_mark() <> mark
                                    return
                                if bindable = false
                                {
                                    let msym this.get_symbol_of_declaration(m)
                                    let mname AstNode.name_of(m)
                                    if msym <> null
                                    {
                                        if mname <> null
                                        {
                                            let nexpr AstNode.expression_of(mname as ref[AstNode])
                                            if nexpr <> null
                                            {
                                                let ms msym as ref[Symbol]
                                                let name_type this.get_type_of_expression(nexpr as ref[AstNode])
                                                let prop_type this.get_non_missing_type_of_symbol(ms)
                                                if this.unported_mark() <> mark
                                                    return
                                                this.check_index_constraint_for_property(t, ms, name_type, prop_type)
                                                if this.unported_mark() <> mark
                                                    return
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        set mi: mi + 1
                    }
                }
            }
        }
        if ninfos > 1
        {
            var ii 0
            while ii < ninfos
            {
                let row list[ii]
                if row <> null
                {
                    this.check_index_constraint_for_index_signature(t, row as ref[IndexInfo])
                    if this.unported_mark() <> mark
                        return
                }
                set ii: ii + 1
            }
        }
    }

    ; ── slice 68: checkFunctionOrConstructorSymbol — the OVERLOAD check ───────
    ;
    ; ★★★ THE FIRST SLICE IN TEN WHOSE PRODUCT IS A DIAGNOSTIC RATHER THAN A TYPE,
    ; and that is the whole argument for taking it before the work list's larger
    ; head. Slice 67 closed with two candidates — `get-type-of-variable-or-parameter-
    ; or-property` 4 695 and this row's 3 807 — and noted that the matched count had
    ; not moved for nine slices because what those slices made was an object type
    ; `type_to_string` cannot print. This function makes no type at all: it walks a
    ; symbol's DECLARATION LIST and reports fifteen distinct codes about the overload
    ; set, so diagcheck goes back to being the positive instrument it was in slices
    ; 48–64 instead of the purely negative one slices 66 and 67 had.
    ;
    ; ★★ IT IS ONE FUNCTION AND TWO CALL SITES, both of which stop here today: the
    ; class arm (checkClassLikeDeclaration, where slice 67 left it) and the function/
    ; method arm (checkFunctionOrMethodDeclaration). The reference has a third,
    ; checkConstructorDeclaration, which sits behind `checkSourceElement(node.Body())`
    ; on a class member and is reached from neither.
    ;
    ; ★★★ WHAT THE SLICE DOES **NOT** DO, and it is the worker's last branch:
    ; `getSignaturesOfSymbol` / `getSignatureFromDeclaration` /
    ; `isImplementationCompatibleWithOverload`, i.e. the assignability comparison
    ; between an implementation signature and each of its overloads (TS2394). That is
    ; the signature dimension and a work-list row of its own; everything in front of
    ; it is syntax over the declaration list.
    ;
    ; ★★★ A MESSAGE ARGUMENT IS NOT COMPARED AND A RELATED-INFO CHAIN IS NOT EITHER.
    ; The reference's C line is `C pos end code` (tests/oracle/types.go), so
    ; `Function_implementation_name_must_be_0`'s name argument and the
    ; `Consider_adding_a_declare_modifier_to_this_class` related diagnostics attached
    ; through SetRelatedInfo are invisible to every instrument this package has. They
    ; are left unbuilt rather than approximated, and named here so that the slice
    ; which gives this port a message renderer finds both sites written down.
    ;
    ; ★★★ AND `c.error(nil, …)` IS NOT A DIAGNOSTIC OF THIS FILE. NewDiagnosticForNode
    ; leaves the file nil when the location is nil, and GetDiagnostics answers
    ; `collection.GetDiagnosticsForFile(sourceFile.FileName())` — so such a report
    ; lands in the GLOBAL list and never appears among the reference's C lines. Five
    ; arms of this family can be handed a nil location (the four that report on
    ; `GetNameOfDeclaration(overload)` alone, and the multiple-constructor loop), and
    ; each goes through error_on_node_or_null, which drops it. Emitting it instead
    ; would be an INVENTED line, which is the one failure diagcheck's subsequence
    ; relation exists to catch.

    ; getCanonicalOverload, the first of the reference's four closures.
    ;
    ; ★★ `overloads` IS `symbol.Declarations` AT EVERY CALL SITE, which is why this
    ; takes the symbol and not a list: the worker passes `declarations` to both
    ; agreement checks, and the per-file group the flag check builds is the whole
    ; list here (see check_flag_agreement_between_overloads for the proof).
    function canonical_overload(symbol: ref[Symbol], implementation: ref[AstNode]?) returns ref[AstNode]?
    {
        let first Symbol.declaration_at(symbol, 0)
        if implementation = null
            return first
        if first = null
            return first
        ; implementationSharesContainerWithFirstOverload
        if AstNode.parent_node_of(implementation) = AstNode.parent_node_of(first)
            return implementation
        first
    }

    ; c.error(location, …) at the five sites where the reference may hand it a nil.
    ;
    ; ★ See the family header: a nil location makes a GLOBAL diagnostic, which
    ; GetDiagnosticsForFile does not return, so the reference's own C lines do not
    ; carry it. Dropping it is the faithful answer and not a leniency.
    procedure error_on_node_or_null(this, n: ref[AstNode]?, code: int)
        this.error_on_node_with(n, code, null)

    procedure error_on_node_or_null_with(this, n: ref[AstNode]?, code: int, args: ref[Array[String]]?)
        this.error_on_node_with(n, code, args)

    ; ast.IsPropertyNameLiteral.
    function is_property_name_literal(k: int) returns bool
    {
        if k = KindIdentifier
            return true
        if k = KindStringLiteral
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindNumericLiteral
            return true
        false
    }

    ; The four kinds `checkFunctionOrConstructorSymbolWorker` accumulates over, and
    ; the same four its two reporting loops re-walk — see the worker's note on why
    ; `functionDeclarations` is a second walk here rather than a list.
    function is_function_or_constructor_declaration(k: int) returns bool
    {
        if k = KindFunctionDeclaration
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindConstructor
            return true
        false
    }

    ; `name.Text() == subsequentName.Text()` for the two arms of
    ; reportImplementationExpectedError that ask it — the private-identifier pair and
    ; the property-name-literal pair.
    ;
    ; ★ The two text accessors are disjoint by kind and neither answers for the
    ; other's kinds, so the dispatch is on the KIND rather than on a null text: an
    ; Identifier's text read through literal_text_of is null, and two nulls would
    ; compare EQUAL — a wrong answer that looks like a right one.
    function name_text_equals(a: ref[AstNode], b: ref[AstNode]) returns bool
    {
        let ka AstNode.kind_of(a)
        var identifier_shaped false
        if ka = KindIdentifier
            set identifier_shaped: true
        if ka = KindPrivateIdentifier
            set identifier_shaped: true
        var data_a Slice[char]()
        var data_b Slice[char]()
        if identifier_shaped
        {
            set data_a: AstNode.identifier_text_of(a)
            set data_b: AstNode.identifier_text_of(b)
        }
        else
        {
            set data_a: AstNode.literal_text_of(a)
            set data_b: AstNode.literal_text_of(b)
        }
        if data_a.data = null
            return false
        if data_b.data = null
            return false
        if data_a.length <> data_b.length
            return false
        var i 0
        while i < data_a.length
        {
            if (data_a[i] as int) <> (data_b[i] as int)
                return false
            set i: i + 1
        }
        true
    }

    ; reportImplementationExpectedError, the third closure. `isConstructor` is its
    ; one capture and becomes a parameter (§3.5e).
    ;
    ; ★★★ THE NODE IT LOOKS AT IS THE **NEXT SIBLING**, found through the parent's
    ; child walk rather than through a statement list, because the two are not the
    ; same list for a class member or an interface member. §3.9d's index pair is what
    ; the reference's ForEachChild visitor becomes here.
    procedure report_implementation_expected_error(this, node: ref[AstNode], is_constructor: bool)
    {
        let name AstNode.name_of(node)
        if name <> null
        {
            if Binder.node_is_missing(name)
                return
        }
        let parent AstNode.parent_node_of(node)
        var subsequent_node: ref[AstNode]? null
        if parent <> null
        {
            let p parent as ref[AstNode]
            let child_total AstNode.child_count(p)
            var i 0
            var seen false
            while i < child_total
            {
                let child AstNode.child_at(p, i)
                if seen
                {
                    set subsequent_node: child
                    set i: child_total
                }
                else
                {
                    if child = node
                        set seen: true
                    set i: i + 1
                }
            }
        }
        ; ★ The reference's own comment is the whole reason for the position test:
        ; extra nodes between overloads that could not be parsed into a valid node
        ; leave a subsequent node that is not really consecutive.
        if subsequent_node <> null
        {
            let s subsequent_node as ref[AstNode]
            if AstNode.pos_of(s) = AstNode.end_of(node)
            {
                if AstNode.kind_of(s) = AstNode.kind_of(node)
                {
                    let subsequent_name AstNode.name_of(s)
                    var error_node: ref[AstNode]? subsequent_name
                    if error_node = null
                        set error_node: s
                    if name <> null
                    {
                        if subsequent_name <> null
                        {
                            let n1 name as ref[AstNode]
                            let n2 subsequent_name as ref[AstNode]
                            let k1 AstNode.kind_of(n1)
                            let k2 AstNode.kind_of(n2)
                            var same_name false
                            if k1 = KindPrivateIdentifier
                            {
                                if k2 = KindPrivateIdentifier
                                    set same_name: Checker.name_text_equals(n1, n2)
                            }
                            ; ★★★ SLICE 124 ANSWERS THE SLICE'S ONE TYPE QUESTION.
                            ; `isTypeIdenticalTo(checkComputedPropertyName(name),
                            ; checkComputedPropertyName(subsequentName))`; the `||`
                            ; short-circuits, so it is asked only when the first
                            ; disjunct answered false and both names are computed.
                            if same_name = false
                            {
                                if k1 = KindComputedPropertyName
                                {
                                    if k2 = KindComputedPropertyName
                                    {
                                        let cm this.unported_mark()
                                        let t1 this.check_computed_property_name(n1)
                                        let t2 this.check_computed_property_name(n2)
                                        if this.unported_mark() <> cm
                                            return
                                        if t1 = null
                                            return
                                        if t2 = null
                                            return
                                        set same_name: this.is_type_identical_to(t1 as ref[Type], t2 as ref[Type])
                                    }
                                }
                            }
                            if same_name = false
                            {
                                if Checker.is_property_name_literal(k1)
                                {
                                    if Checker.is_property_name_literal(k2)
                                        set same_name: Checker.name_text_equals(n1, n2)
                                }
                            }
                            if same_name
                            {
                                ; We can get here in two cases — mixed static and
                                ; instance class members, or something with the same
                                ; name defined before the overload set. Only the first
                                ; reports here; the binder owns the second.
                                var report_error false
                                let nk AstNode.kind_of(node)
                                if nk = KindMethodDeclaration
                                    set report_error: true
                                if nk = KindMethodSignature
                                    set report_error: true
                                if report_error
                                {
                                    if b.is_static(node) = b.is_static(s)
                                        set report_error: false
                                }
                                if report_error
                                {
                                    if b.is_static(node)
                                        this.error_on_node_or_null(error_node, DiagFunction_overload_must_be_static)
                                    else
                                        this.error_on_node_or_null(error_node, DiagFunction_overload_must_not_be_static)
                                }
                                return
                            }
                        }
                    }
                    if Binder.node_is_missing(AstNode.body_of(s)) = false
                    {
                        this.error_on_node_or_null(error_node, DiagFunction_implementation_name_must_be_0, this.declaration_name_to_string(name))
                        return
                    }
                }
            }
        }
        var target: ref[AstNode]? name
        if target = null
            set target: node
        if is_constructor
        {
            this.error_on_node_or_null(target, DiagConstructor_implementation_is_missing)
            return
        }
        ; Report different errors regarding non-consecutive blocks of declarations
        ; depending on whether the node in question is abstract.
        if b.has_syntactic_modifier(node, ModifierFlagsAbstract)
            this.error_on_node_or_null(target, DiagAll_declarations_of_an_abstract_method_must_be_consecutive)
        else
            this.error_on_node_or_null(target, DiagFunction_implementation_is_missing_or_not_immediately_following_the_declaration)
    }

    ; checkFlagAgreementBetweenOverloads, the second closure.
    ;
    ; ★★★ THE PER-SOURCE-FILE GROUPING IS WRITTEN SINCE SLICE 137, AND THE NOTE THAT
    ; STOOD HERE NAMED THE DAY: *"the day this port loads a lib is the day the
    ; grouping has to be written; it is named here so that day finds it."* The lib
    ; arrived in slice 118, but a lib declaration and a unit declaration only reach
    ; ONE symbol once merge_symbol exists — so the trigger is this slice, not that one.
    ;
    ; ★★★ WHAT THE GROUPING BUYS IS EXACTLY THE TWO FLAGS THE REFERENCE'S COMMENTS
    ; NAME: `export` and `declare` may differ ACROSS files (lib.d.ts declares
    ; `function eval(...)` ambient, the unit writes `function eval() {}` non-ambient)
    ; and a module augmentation is *"allowed to add overloads to a non-ambient
    ; function in an implementation file"*. Private/protected and abstract are asked
    ; against the GLOBAL canonical, unchanged — the reference uses `deviation` there
    ; and `deviationInFile` only for the first two, and that asymmetry is the whole
    ; mechanism. Without it `"use strict"; function eval() {}` drew a TS2384 the
    ; reference does not report.
    ;
    ; ★ The reference iterates a Go MAP over the groups, whose order is
    ; nondeterministic — invisible only because the diagnostics are sorted by position
    ; afterwards. This walks the declarations in order and processes each file's group
    ; at its FIRST member, which is one fixed order out of that set.
    procedure check_flag_agreement_between_overloads(this, symbol: ref[Symbol], implementation: ref[AstNode]?, flags_to_check: int, some_overload_flags: int, all_overload_flags: int)
    {
        ; Error if some overloads have a flag that is not shared by all overloads. To
        ; find the deviations, XOR someOverloadFlags with allOverloadFlags.
        let some_but_not_all: int some_overload_flags xor all_overload_flags
        if some_but_not_all = 0
            return
        let canonical Checker.canonical_overload(symbol, implementation)
        if canonical = null
            return
        let canonical_flags this.effective_declaration_flags(canonical as ref[AstNode], flags_to_check)
        let count Symbol.declaration_count(symbol)
        var g 0
        while g < count
        {
            let head Symbol.declaration_at(symbol, g)
            set g: g + 1
            if head = null
                continue
            let hf Checker.source_file_of_node(head as ref[AstNode])
            ; Process each group at its FIRST member: a declaration whose file has
            ; already been seen belongs to a group that has been walked.
            var seen false
            var p 0
            while p < g - 1
            {
                let earlier Symbol.declaration_at(symbol, p)
                if earlier <> null
                {
                    if Checker.source_file_of_node(earlier as ref[AstNode]) = hf
                        set seen: true
                }
                set p: p + 1
            }
            if seen
                continue
            ; The group's own canonical: the implementation when it shares a container
            ; with the group's FIRST overload, else that first overload.
            var group_first: ref[AstNode]? null
            var j 0
            while j < count
            {
                let d Symbol.declaration_at(symbol, j)
                set j: j + 1
                if d = null
                    continue
                if Checker.source_file_of_node(d as ref[AstNode]) <> hf
                    continue
                if group_first = null
                    set group_first: d
            }
            if group_first = null
                continue
            var group_canonical group_first
            if implementation <> null
            {
                if AstNode.parent_node_of(implementation) = AstNode.parent_node_of(group_first)
                    set group_canonical: implementation
            }
            let canonical_flags_for_file this.effective_declaration_flags(group_canonical as ref[AstNode], flags_to_check)
            var i 0
            while i < count
            {
                let overload Symbol.declaration_at(symbol, i)
                set i: i + 1
                if overload = null
                    continue
                let o overload as ref[AstNode]
                if Checker.source_file_of_node(o) <> hf
                    continue
                let own this.effective_declaration_flags(o, flags_to_check)
                let deviation own xor canonical_flags
                let deviation_in_file own xor canonical_flags_for_file
                if (deviation_in_file & ModifierFlagsExport) <> 0
                    this.error_on_node_or_null(this.name_of_declaration(o), DiagOverload_signatures_must_all_be_exported_or_non_exported)
                else
                {
                    if (deviation_in_file & ModifierFlagsAmbient) <> 0
                        this.error_on_node_or_null(this.name_of_declaration(o), DiagOverload_signatures_must_all_be_ambient_or_non_ambient)
                    else
                    {
                        if (deviation & (ModifierFlagsPrivate | ModifierFlagsProtected)) <> 0
                        {
                            var target this.name_of_declaration(o)
                            if target = null
                                set target: o
                            this.error_on_node_or_null(target, DiagOverload_signatures_must_all_be_public_private_or_protected)
                        }
                        else
                        {
                            if (deviation & ModifierFlagsAbstract) <> 0
                                this.error_on_node_or_null(this.name_of_declaration(o), DiagOverload_signatures_must_all_be_abstract_or_non_abstract)
                        }
                    }
                }
            }
        }
    }

    ; checkQuestionTokenAgreementBetweenOverloads, the fourth closure.
    procedure check_question_token_agreement_between_overloads(this, symbol: ref[Symbol], implementation: ref[AstNode]?, some_have_question_token: bool, all_have_question_token: bool)
    {
        if some_have_question_token = all_have_question_token
            return
        let canonical Checker.canonical_overload(symbol, implementation)
        if canonical = null
            return
        let canonical_has_question_token Checker.is_optional_declaration(canonical as ref[AstNode])
        let count Symbol.declaration_count(symbol)
        var i 0
        while i < count
        {
            let d Symbol.declaration_at(symbol, i)
            set i: i + 1
            if d = null
                continue
            let overload d as ref[AstNode]
            if Checker.is_optional_declaration(overload) <> canonical_has_question_token
                this.error_on_node_or_null(this.name_of_declaration(overload), DiagOverload_signatures_must_all_be_optional_or_required)
        }
    }

    ; checkFunctionOrConstructorSymbol — the memo, whole.
    ;
    ; ★★ IT IS THE SECOND READER OF valueSymbolLinks IN THIS PORT AND THE FIRST WHOSE
    ; HIT IS ABOUT REPORTS RATHER THAN ABOUT WORK. Both call sites can reach the same
    ; symbol — a class declaration merged with a function's does — and without the bit
    ; the second visit would emit every diagnostic a second time. diagcheck's relation
    ; is a SUBSEQUENCE, so a duplicated line is a failure and not a leniency.
    procedure check_function_or_constructor_symbol(this, symbol: ref[Symbol])
    {
        let links this.value_symbol_link_of(symbol)
        if links.function_or_constructor_checked
            return
        set links.function_or_constructor_checked: true
        this.check_function_or_constructor_symbol_worker(symbol)
    }

    ; checkFunctionOrConstructorSymbolWorker, whole but for its last branch.
    ;
    ; ★★★ THE ACCUMULATORS ARE THE FUNCTION. Everything the reference reports here is
    ; decided by ONE walk over the declaration list that fills nine of them, and the
    ; walk's own order is what `previousDeclaration` MEANS — so the loop is
    ; transcribed statement for statement rather than reorganised, and the four
    ; reporting blocks after it read only accumulators.
    ;
    ; ★★ `functionDeclarations` IS A SECOND WALK RATHER THAN A LIST, and the
    ; equivalence is exact rather than close: the reference appends exactly the
    ; declarations whose kind is one of the four, in declaration-list order, and the
    ; two loops that read it iterate it in that order. Re-applying the same kind test
    ; over the same list in the same order yields the same sequence — so the list is
    ; the walk, and a heap allocation whose only purpose is to remember a filter is
    ; not built.
    procedure check_function_or_constructor_symbol_worker(this, symbol: ref[Symbol])
    {
        let flags_to_check: int ModifierFlagsExport | ModifierFlagsAmbient | ModifierFlagsPrivate | ModifierFlagsProtected | ModifierFlagsAbstract
        var some_node_flags: int ModifierFlagsNone
        var all_node_flags: int flags_to_check
        var some_have_question_token false
        var all_have_question_token true
        var has_overloads false
        var body_declaration: ref[AstNode]? null
        var last_seen_non_ambient_declaration: ref[AstNode]? null
        var previous_declaration: ref[AstNode]? null
        let count Symbol.declaration_count(symbol)
        let is_constructor (Symbol.flags_of(symbol) & SymbolFlagsConstructor) <> 0
        var duplicate_function_declaration false
        var multiple_constructor_implementation false
        var has_non_ambient_class false
        var i 0
        while i < count
        {
            let d Symbol.declaration_at(symbol, i)
            set i: i + 1
            if d = null
                continue
            let node d as ref[AstNode]
            let in_ambient_context (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            var in_ambient_context_or_interface: bool in_ambient_context
            if in_ambient_context_or_interface = false
            {
                let pk Checker.kind_or_unknown(AstNode.parent_node_of(node))
                if pk = KindInterfaceDeclaration
                    set in_ambient_context_or_interface: true
                if pk = KindTypeLiteral
                    set in_ambient_context_or_interface: true
            }
            ; Check whether declarations are consecutive only if they are
            ; non-ambient: ambient declarations may be interleaved, and mixing
            ; ambient with non-ambient is a separate error already reported.
            if in_ambient_context_or_interface
                set previous_declaration: null
            if Parser.is_class_like_node(node)
            {
                if in_ambient_context = false
                    set has_non_ambient_class: true
            }
            if Checker.is_function_or_constructor_declaration(AstNode.kind_of(node)) = false
                continue
            let current_node_flags this.effective_declaration_flags(node, flags_to_check)
            set some_node_flags: some_node_flags | current_node_flags
            set all_node_flags: all_node_flags & current_node_flags
            let optional Checker.is_optional_declaration(node)
            if optional
                set some_have_question_token: true
            if optional = false
                set all_have_question_token: false
            let body_is_present Binder.node_is_missing(AstNode.body_of(node)) = false
            ; ★★★ THE `else` BELONGS TO THE WHOLE CONJUNCTION AND THE FIRST DRAFT
            ; HUNG IT ON THE LEFT CONJUNCT — slice 124's finding, and it cost TWO
            ; stage-2 units three TS2391. Upstream reads
            ;
            ;   if bodyIsPresent && bodyDeclaration != nil { … }
            ;   else if previousDeclaration != nil && … { report }
            ;
            ; so the FIRST implementation of an overload set — a body present with
            ; no bodyDeclaration recorded yet — takes the ELSE branch and is exactly
            ; the declaration that reports *implementation is missing or not
            ; immediately following the declaration* about its predecessor. Written
            ; as `if body_is_present { if body_declaration <> null … } else { … }`
            ; that declaration falls through both arms in silence.
            var duplicate_body false
            if body_is_present
            {
                if body_declaration <> null
                    set duplicate_body: true
            }
            if duplicate_body
            {
                if is_constructor
                    set multiple_constructor_implementation: true
                else
                    set duplicate_function_declaration: true
            }
            else
            {
                if previous_declaration <> null
                {
                    let prev previous_declaration as ref[AstNode]
                    if AstNode.parent_node_of(prev) = AstNode.parent_node_of(node)
                    {
                        if AstNode.end_of(prev) <> AstNode.pos_of(node)
                        {
                            if (AstNode.flags_of(prev) & NodeFlagsReparsed) = 0
                                this.report_implementation_expected_error(prev, is_constructor)
                        }
                    }
                }
            }
            if body_is_present
            {
                if body_declaration = null
                    set body_declaration: node
            }
            else
                set has_overloads: true
            set previous_declaration: node
            if in_ambient_context_or_interface = false
                set last_seen_non_ambient_declaration: node
        }
        if multiple_constructor_implementation
        {
            var j 0
            while j < count
            {
                let d Symbol.declaration_at(symbol, j)
                set j: j + 1
                if d = null
                    continue
                let declaration d as ref[AstNode]
                if Checker.is_function_or_constructor_declaration(AstNode.kind_of(declaration))
                    this.error_on_node_or_null(declaration, DiagMultiple_constructor_implementations_are_not_allowed)
            }
        }
        if duplicate_function_declaration
        {
            var j 0
            while j < count
            {
                let d Symbol.declaration_at(symbol, j)
                set j: j + 1
                if d = null
                    continue
                let declaration d as ref[AstNode]
                if Checker.is_function_or_constructor_declaration(AstNode.kind_of(declaration))
                {
                    var target this.name_of_declaration(declaration)
                    if target = null
                        set target: declaration
                    this.error_on_node_or_null(target, DiagDuplicate_function_implementation)
                }
            }
        }
        ; ★ The related-info list (`Consider_adding_a_declare_modifier_to_this_class`,
        ; TS6506) is attached to each report rather than reported on its own, and a
        ; related diagnostic is not among the file's C lines — see the family header.
        if has_non_ambient_class
        {
            if is_constructor = false
            {
                if (Symbol.flags_of(symbol) & SymbolFlagsFunction) <> 0
                {
                    var j 0
                    while j < count
                    {
                        let d Symbol.declaration_at(symbol, j)
                        set j: j + 1
                        if d = null
                            continue
                        let declaration d as ref[AstNode]
                        var code 0
                        let dk AstNode.kind_of(declaration)
                        if dk = KindClassDeclaration
                            set code: DiagClass_declaration_cannot_implement_overload_list_for_0
                        if dk = KindFunctionDeclaration
                            set code: DiagFunction_with_bodies_can_only_merge_with_classes_that_are_ambient
                        if code <> 0
                        {
                            var target this.name_of_declaration(declaration)
                            if target = null
                                set target: declaration
                            let related_mark this.diagnostic_mark()
                            this.error_on_node_or_null(target, code, Checker.arg_text(Symbol.name_of(symbol)))
                            ; SetRelatedInfo(relatedDiagnostics): every class declaration
                            var rj 0
                            while rj < count
                            {
                                let rd Symbol.declaration_at(symbol, rj)
                                set rj: rj + 1
                                if rd = null
                                    continue
                                if AstNode.kind_of(rd) = KindClassDeclaration
                                    this.related_info_since(related_mark, rd, DiagConsider_adding_a_declare_modifier_to_this_class)
                            }
                        }
                    }
                }
            }
        }
        ; Abstract methods can't have an implementation — in particular, they don't
        ; need one.
        if last_seen_non_ambient_declaration <> null
        {
            let last last_seen_non_ambient_declaration as ref[AstNode]
            if AstNode.body_of(last) = null
            {
                if b.has_syntactic_modifier(last, ModifierFlagsAbstract) = false
                {
                    if Checker.is_optional_declaration(last) = false
                        this.report_implementation_expected_error(last, is_constructor)
                }
            }
        }
        if has_overloads = false
            return
        this.check_flag_agreement_between_overloads(symbol, body_declaration, flags_to_check, some_node_flags, all_node_flags)
        this.check_question_token_agreement_between_overloads(symbol, body_declaration, some_have_question_token, all_have_question_token)
        if body_declaration = null
            return
        ; ── slice 124: TS2394 ────────────────────────────────────────────────
        ;
        ; ★★★ THE ROW SAID *the signature dimension and a work-list row of their
        ; own*, and that is what this is: getSignaturesOfSymbol was already here
        ; (the duplicate this slice nearly added on top of it is §3.5dm's trap
        ; again), getSignatureFromDeclaration too, and the wall was
        ; isImplementationCompatibleWithOverload over isSignatureAssignableTo over
        ; compareSignaturesRelated — 183 reference lines, ported in this slice.
        ;
        ; ★ The loop BREAKS at the first incompatible overload: the reference
        ; reports one TS2394 per overload SET and not per overload.
        let bd body_declaration as ref[AstNode]
        let sig_mark this.unported_mark()
        let signatures this.get_signatures_of_symbol(symbol)
        if this.unported_mark() <> sig_mark
            return
        if signatures = null
            return
        let body_signature this.get_signature_from_declaration(bd)
        if this.unported_mark() <> sig_mark
            return
        if body_signature = null
            return
        let bs body_signature as ref[Signature]
        let sl signatures as ref[Array[ref[Signature]?]]
        let sn sl.get_length() as int
        var si 0
        while si < sn
        {
            let row sl[si]
            set si: si + 1
            if row = null
                continue
            let signature row as ref[Signature]
            let compatible this.is_implementation_compatible_with_overload(bs, signature)
            if this.unported_mark() <> sig_mark
                return
            if compatible
                continue
            let related_mark this.diagnostic_mark()
            this.error_on_node(signature.declaration, DiagThis_overload_signature_is_not_compatible_with_its_implementation_signature)
            this.related_info_since(related_mark, bd, DiagThe_implementation_signature_is_declared_here)
            return
        }
    }

    ; ── slice 62: the type-MEMBER arms ───────────────────────────────────────
    ;
    ; Slice 61's members walk has been handing PropertySignature and MethodSignature
    ; to this switch ever since it landed — **341 and 81 units of stage 2**, the two
    ; largest destinations of that slice's whole tag arithmetic, and it named them as
    ; the successor rather than taking them. This is that successor.
    ;
    ; ★★★ THE TWO ARMS ARE ONE SLICE BECAUSE THE REFERENCE'S FOUR FUNCTIONS ARE TWO
    ; PAIRS, AND EACH PAIR SHARES ITS WHOLE BODY WITH A CLASS MEMBER.
    ; checkPropertySignature is one report and a call to checkPropertyDeclaration;
    ; the MethodSignature case shares checkMethodDeclaration with the class's method.
    ; So porting the signature half means porting the declaration half, and what
    ; separates them is four `IsPropertyDeclaration`/`IsMethodDeclaration` tests
    ; inside bodies that are otherwise identical.
    ;
    ; ★★★ AND THE CLASS HALF IS INERT, WHICH IS SLICE 60's TYPE-PARAMETER ROW AGAIN.
    ; Nothing walks a class body's members — checkClassDeclaration stops at
    ; checkExportsOnMergedDeclarations — and nothing walks an object literal's
    ; properties, so KindPropertyDeclaration and KindMethodDeclaration cannot reach
    ; this switch today. They are wired all the same, and the table above says
    ; `true` for them, because the table is a claim about which kinds this port
    ; SPEAKS on: leaving them out would make the slice that first walks a class body
    ; report a hole for an arm that exists.
    ;
    ; ★★ WHAT THE PAIR BUYS IS MOSTLY A WALK, exactly as slice 61's arms were. A
    ; property signature's TYPE annotation and a method signature's PARAMETERS and
    ; RETURN type were unreachable until now, so the type surface inside every object
    ; TYPE LITERAL in the corpus is walked for the first time — through
    ; checkVariableLikeDeclaration for the property and through
    ; checkSignatureDeclaration for the method, both of them functions this file has
    ; had since slices 55 and 52.
    ;
    ; ★★★ AND THE TYPE LITERAL IS THE ONLY CONTAINER THAT REACHES THEM, WHICH IS THE
    ; SLICE'S LARGEST SINGLE FACT. An INTERFACE body — the canonical place for a
    ; property signature — is not walked: checkInterfaceDeclaration reports
    ; `get-declared-type-of-symbol` (`check-exports-on-merged-declarations` until
    ; slice 65 ported it, which moved the tag and not the fact) and
    ; `checkSourceElements(node.Members())`
    ; is the LAST statement of that arm, with the whole declared type between them
    ; (getDeclaredTypeOfSymbol, checkInheritedPropertiesAreIdentical, the base-type
    ; assignability loop, checkIndexConstraints). So half of what both grammar
    ; functions below contain is UNREACHABLE — checkGrammarProperty's interface arm
    ; and its mapped-type report, checkGrammarMethod's interface and class arms — and
    ; it is unreachable behind the TYPE SYSTEM rather than behind a missing recursion.
    ; ★It is measured rather than argued: controls-slice62.sh's g19 adds that members
    ; walk as a PREMISE and g20 breaks the interface arm on top of it, which is slice
    ; 61's g26/g27 technique. ★checker_member_container_reach.ts is the fixture that
    ; makes the asymmetry visible from the outside: the same error in both containers,
    ; and only the type literal's is ours.
    ;
    ; ★ WHAT IT DOES NOT DO: the ACCESSOR pair. `case GetAccessor, SetAccessor:
    ; c.checkAccessorDeclaration(node)` is 1 unit of stage 2 and is not a smaller
    ; version of this arm — it brings checkGrammarAccessor, the get/set modifier and
    ; accessibility agreement across the symbol's two declarations, and
    ; checkAllCodePathsInNonVoidFunctionReturnOrThrow. It is named here rather than
    ; guessed at.

    ; checkPropertySignature, whole. One report of its own, and it is about a
    ; spelling the grammar admits anywhere and the language permits only in a class
    ; body: `interface I { #x: number }`.
    procedure check_property_signature(this, node: ref[AstNode])
    {
        if Checker.kind_or_unknown(AstNode.name_of(node)) = KindPrivateIdentifier
            this.error_on_node(node, DiagPrivate_identifiers_are_not_allowed_outside_class_bodies)
        this.check_property_declaration(node)
    }

    ; checkPropertyDeclaration, whole — the shared body of both property arms.
    ;
    ; ★★★ THE GRAMMAR `&&` IS TWO CALLS AND A THIRD BEHIND THEM, and the order is
    ; load-bearing in the way slice 52's was: checkGrammarModifiers runs first and a
    ; report there suppresses checkGrammarProperty, which in turn suppresses the
    ; computed-property-name check. Reading it as three independent checks would
    ; produce up to three diagnostics where the reference produces one.
    ;
    ; ★★ setNodeLinksForPrivateIdentifierScope IS A WRITE WITH NO READER, so it is a
    ; comment and not a report — §3.5ao's shape, and the reader is nameable: it sets
    ; NodeCheckFlagsContainsClassWithPrivateIdentifiers on every enclosing block
    ; scope, and the only thing that reads that flag is checkWeakMapSetCollision,
    ; which this file already stops at (`check-weak-map-set-collision`). So the
    ; write's whole observable effect sits BEHIND an existing report, and a report
    ; here would claim the unit is unmeasured where the reference emits nothing. ★It
    ; also needs a nodeLinks table this port does not have, which is the same
    ; argument from the other side.
    ;
    ; ★ THE ABSTRACT-INITIALIZER REPORT IS PropertyDeclaration-ONLY — the reference
    ; says why at the line (*property signatures already report "initializer not
    ; allowed in ambient context" elsewhere*), and that elsewhere is
    ; checkGrammarProperty's interface and type-literal branches, which this slice
    ; ports. So the test is inert today for the same reason the whole class half is.
    procedure check_property_declaration(this, node: ref[AstNode])
    {
        var reported false
        if this.check_grammar_modifiers(node)
            set reported: true
        if reported = false
        {
            if this.check_grammar_property(node)
                set reported: true
        }
        if reported = false
            this.check_grammar_computed_property_name(AstNode.name_of(node))
        this.check_variable_like_declaration(node)
        this.set_node_links_for_private_identifier_scope(node)
        if AstNode.kind_of(node) = KindPropertyDeclaration
        {
            if b.has_syntactic_modifier(node, ModifierFlagsAbstract)
            {
                if AstNode.initializer_of(node) <> null
                    this.error_on_node(node, DiagProperty_0_cannot_have_an_initializer_because_it_is_marked_abstract, this.declaration_name_to_string(AstNode.name_of(node)))
            }
        }
    }

    ; checkMethodDeclaration, whole — the shared body of the method signature and the
    ; class/object-literal method.
    ;
    ; ★★ THE PRIVATE-NAME REPORT IS THE ONE THAT REACHES A SIGNATURE, and its test is
    ; not the property's. checkPropertySignature asks *is this a property SIGNATURE*
    ; (a syntactic fact) while this one asks *is there a containing CLASS* — an
    ; ancestor walk — because a method with a private name is legal in a class body
    ; and a private name reaches this function from an interface, a type literal and
    ; an object literal alike.
    ;
    ; ★ The asterisk/`constructor` report is MethodDeclaration-only and inert with
    ; the rest of the class half; it is the second of the two places this file
    ; compares an identifier's text against `constructor`.
    procedure check_method_declaration(this, node: ref[AstNode])
    {
        let name AstNode.name_of(node)
        if this.check_grammar_method(node) = false
        {
            this.check_grammar_computed_property_name(name)
            if AstNode.kind_of(node) = KindMethodDeclaration
            {
                if AstNode.asterisk_token_of(node) <> null
                {
                    if Checker.kind_or_unknown(name) = KindIdentifier
                    {
                        if Checker.identifier_text_equals(name, "constructor")
                            this.error_on_node(name, DiagClass_constructor_may_not_be_a_generator)
                    }
                }
            }
        }
        this.check_function_or_method_declaration(node)
        if AstNode.kind_of(node) = KindMethodDeclaration
        {
            if b.has_syntactic_modifier(node, ModifierFlagsAbstract)
            {
                if AstNode.body_of(node) <> null
                    this.error_on_node(node, DiagMethod_0_cannot_have_an_implementation_because_it_is_marked_abstract, this.declaration_name_to_string(AstNode.name_of(node)))
            }
        }
        if Checker.kind_or_unknown(name) = KindPrivateIdentifier
        {
            if Checker.get_containing_class(node) = null
                this.error_on_node(node, DiagPrivate_identifiers_are_not_allowed_outside_class_bodies)
        }
        this.set_node_links_for_private_identifier_scope(node)
    }

    ; ── slice 83: the class's LAST MEMBERS ──────────────────────────────────
    ;
    ; ★★★ THE ROW IS `check <kind>` AND IT IS THE LAST OF checkSourceElementWorker's
    ; SWITCH. Slice 64 wrote *what is left is strays: the accessor pair, the
    ; constructor, the class static block, the enum member, the missing declaration
    ; and the four JSDoc type kinds*, and slice 82's member walk turned three of
    ; those from a sentence into a measurement: `check Constructor` 53 units,
    ; `check GetAccessor` 24, `check SetAccessor` 17, `check ClassStaticBlock` 5.
    ; This slice writes those four arms.
    ;
    ; ★★★ THE CONSTRUCTOR RUNS TO ITS LAST LINE FOR A CLASS WITH NO BASE, and the
    ; first draft of this arm claimed that is every class whose constructor is
    ; reached. It is not — see the note at the test itself, which is the slice's
    ; second finding and the same sentence slice 82 wrote at the walk that feeds
    ; this arm.
    ;
    ; ★★ THE ACCESSOR'S TWO STOPS ARE getTypeOfAccessors AND THE FLOW GRAPH, and
    ; everything else is node-only: three grammar checks, the
    ; `constructor`-named-accessor report and the getter/setter modifier pair behind
    ; hasBindableName. The flow-graph one is the slice's third finding and it is
    ; argued at its own line — a report whose test is a binder flag NOTHING IN THIS
    ; PORT WRITES.

    ; checkClassStaticBlockDeclaration, whole — the reference's two lines, and the
    ; smallest arm in the switch.
    procedure check_class_static_block_declaration(this, node: ref[AstNode])
    {
        this.check_grammar_modifiers(node)
        this.check_each_child_source_element(node)
    }

    ; checkGrammarConstructorTypeParameters, whole.
    ;
    ; ★★ THE SPAN IS THE LIST'S OWN RANGE AND NOT THE NODES', which is why this
    ; needs slice 51's side table: `<T>` on a constructor is reported over the
    ; brackets, and an EMPTY `<>` has pos = end, which is the reference's own fork
    ; — with no element to skip trivia from, the raw position is the answer.
    procedure check_grammar_constructor_type_parameters(this, node: ref[AstNode]) returns bool
    {
        let type_parameters AstNode.type_parameters_of(node)
        if type_parameters = null
            return false
        let tp type_parameters as ref[Array[ref[AstNode]?]]
        var lpos 0
        var lend 0
        if this.list_range_of(tp, &lpos, &lend) = false
        {
            this.record_unported("list-range", 0)
            return false
        }
        var pos lpos
        if lpos <> lend
            set pos: b.skip_trivia_at(lpos)
        this.grammar_error_at_pos(node, pos, lend - pos, DiagType_parameters_cannot_appear_on_a_constructor_declaration)
    }

    ; checkGrammarConstructorTypeAnnotation, whole — three lines.
    procedure check_grammar_constructor_type_annotation(this, node: ref[AstNode]) returns bool
    {
        let t AstNode.type_of(node)
        if t = null
            return false
        this.grammar_error_on_node(t as ref[AstNode], DiagType_annotation_cannot_appear_on_a_constructor_declaration)
    }

    ; classDeclarationExtendsNull, whole.
    ;
    ; ★ The reference's three calls are total; each is an Option here, and a null
    ; from any of them means the question cannot be answered — which is not the
    ; same as *the class extends null*, so false is the answer and the caller reads
    ; is_unported() to tell a legitimate false from a report.
    procedure class_declaration_extends_null(this, class_decl: ref[AstNode]) returns bool
    {
        let class_symbol this.symbol_of_declaration(class_decl)
        if class_symbol = null
            return false
        let class_instance_type this.get_declared_type_of_symbol(class_symbol as ref[Symbol])
        if class_instance_type = null
            return false
        let base_constructor_type this.get_base_constructor_type_of_class(class_instance_type as ref[Type])
        if base_constructor_type = null
            return false
        let bct base_constructor_type as ref[Type]
        bct = null_widening_type
    }

    ; checkConstructorDeclaration, down to classDeclarationExtendsNull.
    procedure check_constructor_declaration(this, node: ref[AstNode])
    {
        ; The reference's own comment: *Grammar check on signature of constructor
        ; and modifier of the constructor is done in checkSignatureDeclaration*.
        this.check_signature_declaration(node)
        ; The `&&` is a suppression and not a conjunction: a type-parameter report
        ; withholds the type-annotation one, so `constructor<T>(): void` gets ONE
        ; diagnostic where two independent checks would give two.
        if this.check_grammar_constructor_type_parameters(node) = false
            this.check_grammar_constructor_type_annotation(node)
        this.check_source_element(AstNode.body_of(node))
        ; getSymbolOfDeclaration is total upstream; this port's answers an Option,
        ; and a constructor the binder gave no symbol has nothing to overload-check.
        let symbol this.symbol_of_declaration(node)
        if symbol <> null
            this.check_function_or_constructor_symbol(symbol as ref[Symbol])
        ; The reference's own comment at the line: *exit early in the case of
        ; signature - super checks are not relevant to them*.
        if Binder.node_is_missing(AstNode.body_of(node))
            return
        let containing_class AstNode.parent_node_of(node)
        if containing_class = null
            return
        ; ★★★ THE FIRST DRAFT OF THIS ARM CLAIMED THIS RETURN IS TAKEN ON EVERY
        ; REACHABLE INPUT, AND IT IS NOT — five stage-1 units walk past it. The
        ; claim was that a constructor is reached only inside a class with no base,
        ; because check_class_like_declaration RETURNS at its own
        ; `class-extends-heritage-clause` stop. It does; what it does not do is stop
        ; its CALLER. `record_unported` marks and does not abort, so
        ; check_class_declaration runs `check_source_elements(node.Members())`
        ; whatever the class arm did — which is the sentence slice 82 wrote fifty
        ; lines above this one, in the note that put that walk there. ★★★**A
        ; `return` inside a callee is not an exit from the walk, and a claim about
        ; reachability read off one is a claim about the wrong frame.**
        if Checker.get_extends_heritage_clause_element(containing_class as ref[AstNode]) = null
            return
        ; ★★★ THE STOP THAT STOOD HERE WAS ARGUED UNREACHABLE, AND THE ARGUMENT
        ; EXPIRED WITHOUT ANYTHING SAYING SO. It read: classDeclarationExtendsNull's
        ; third call, getBaseConstructorTypeOfClass, *reports `is-constructor-type`
        ; for every class that HAS a base*, so everything below it is behind a stop
        ; in the statement above and §3.5ao leaves it unwritten. That was true when
        ; slice 82 wrote it. Slice 120 ported isConstructorType; `is-constructor-type`
        ; has not been a live tag since, and this arm has been REACHED ever since —
        ; 241 units of stage 2 log `find-first-super-call` today.
        ;
        ; ★★★ **A NOTE THAT ARGUES UNREACHABILITY BEHIND ANOTHER STOP IS REFUTED BY
        ; ITS OWN TAG APPEARING ON THE FRONTIER, AND NO INSTRUMENT READS IT.**
        ; `expiredstops.py` reads the note for a callee THIS FILE DEFINES and the tag
        ; for a function defined elsewhere; neither question touches a claim of the
        ; form *nothing can get here*. The refutation is free and already computed:
        ; `frontier.sh`/`stops.sh` list the tag with a hit count, and a hit count
        ; above zero IS the counter-example. Same shape at check_this_before_super,
        ; whose note named the same blocker — §3.5gh.
        ;
        ; ★★ THE MARK IS THE COUNT AND NOT `is_unported()`, and the first draft of
        ; the old stop used the wrong one. `is_unported()` answers *has this UNIT
        ; stopped*; the monotone `unported_mark()` answers *did THIS call stop*. The
        ; distinction survives the stop's removal because the guard below is still
        ; read off it: a classDeclarationExtendsNull that could not answer must not
        ; be taken for a `false`.
        let mark this.unported_mark()
        let class_extends_null this.class_declaration_extends_null(containing_class as ref[AstNode])
        if this.unported_mark() <> mark
            return
        let body AstNode.body_of(node)
        if body = null
            return
        let bd body as ref[AstNode]
        ; "TS 1.0 spec (April 2014): 8.3.2 — Constructors of classes with no extends
        ; clause may not contain super calls, whereas constructors of derived classes
        ; must contain at least one super call somewhere in their function body."
        let super_call Checker.find_first_super_call(bd)
        if super_call = null
        {
            if class_extends_null = false
                this.error_on_node(node, DiagConstructors_for_derived_classes_must_contain_a_super_call)
            return
        }
        let sc super_call as ref[AstNode]
        if class_extends_null
            this.error_on_node(sc, DiagA_constructor_cannot_contain_a_super_call_when_its_class_extends_null)
        ; "A super call must be root-level in a constructor if both of the following
        ; are true: the containing class is a derived class; the constructor declares
        ; parameter properties or the containing class declares instance member
        ; variables with initializers."
        ;
        ; ★ The whole test is short-circuited by emit_standard_class_fields, which is
        ; TRUE on this port's options — so the two `core.Some` walks below are written
        ; and never taken today. They are not §3.5be's case: the reference's gate is
        ; ONE bool and the walks are its operand, not a chapter behind it, and a
        ; `false` in their place would be a claim about the class rather than about
        ; the option.
        var should_be_root_level false
        if emit_standard_class_fields = false
        {
            let members AstNode.member_list_of(containing_class as ref[AstNode])
            if members <> null
            {
                let ms members as ref[Array[ref[AstNode]?]]
                let mn ms.get_length() as int
                var mi 0
                while mi < mn
                {
                    let m ms[mi]
                    if m <> null
                    {
                        if this.is_instance_property_with_initializer_or_private_identifier_property(m as ref[AstNode])
                        {
                            set should_be_root_level: true
                            break
                        }
                    }
                    set mi: mi + 1
                }
            }
            if should_be_root_level = false
            {
                let parameters AstNode.parameters_of(node)
                if parameters <> null
                {
                    let ps parameters as ref[Array[ref[AstNode]?]]
                    let pn ps.get_length() as int
                    var pi 0
                    while pi < pn
                    {
                        let par ps[pi]
                        if par <> null
                        {
                            if b.has_syntactic_modifier(par as ref[AstNode], ModifierFlagsParameterPropertyModifier)
                            {
                                set should_be_root_level: true
                                break
                            }
                        }
                        set pi: pi + 1
                    }
                }
            }
        }
        if should_be_root_level = false
            return
        ; "Until we have better flow analysis, it is an error to place the super call
        ; within any kind of block or conditional. See GH #8277."
        if Checker.super_call_is_root_level_in_constructor(sc, bd) = false
        {
            this.error_on_node(sc, DiagA_super_call_must_be_a_root_level_statement_within_a_constructor_of_a_derived_class_that_contains_initialized_properties_parameter_properties_or_private_identifiers)
            return
        }
        ; The reference's `superCallStatement` loop: the first statement that either
        ; IS the super call or references `super`/`this` decides. ★The two arms are
        ; asymmetric on purpose — a statement that references `super` or `this`
        ; BREAKS without setting the statement, so the report below fires; only an
        ; expression statement whose expression is the super call clears it.
        var has_super_call_statement false
        let statements AstNode.statements_of(bd)
        if statements <> null
        {
            let sts statements as ref[Array[ref[AstNode]?]]
            let sn sts.get_length() as int
            var si 0
            while si < sn
            {
                let st sts[si]
                if st = null
                    break
                let stmt st as ref[AstNode]
                if AstNode.kind_of(stmt) = KindExpressionStatement
                {
                    if Checker.is_super_call(Parser.skip_outer_expressions(AstNode.expression_of(stmt), OEKAll))
                    {
                        set has_super_call_statement: true
                        break
                    }
                }
                if Checker.node_immediately_references_super_or_this(stmt)
                    break
                set si: si + 1
            }
        }
        if has_super_call_statement = false
            this.error_on_node(node, DiagA_super_call_must_be_the_first_statement_in_the_constructor_to_refer_to_super_or_this_when_a_derived_class_contains_initialized_properties_parameter_properties_or_private_identifiers)
    }

    ; isSuperCall. ★It is a CALL whose callee is the keyword, not a node kind: the
    ; parser gives `super(x)` an ordinary CallExpression, and `super.f(x)` is one
    ; too whose expression is the property access — which is why the test reads the
    ; callee rather than asking whether a `super` occurs anywhere in the call.
    function is_super_call(n: ref[AstNode]?) returns bool
    {
        if n = null
            return false
        let node n as ref[AstNode]
        if AstNode.kind_of(node) <> KindCallExpression
            return false
        Checker.kind_or_unknown(AstNode.expression_of(node)) = KindSuperKeyword
    }

    ; findFirstSuperCall. §3.9d: the reference's `visit` closure answers true to
    ; STOP the walk and writes the node into a captured cell; here the recursion
    ; RETURNS the node, which is the same walk without the cell.
    ;
    ; ★ The function-like test is what makes the answer belong to THIS constructor:
    ; a `super()` inside a nested function expression is a different frame's
    ; problem, and the reference refuses to descend into one.
    function find_first_super_call(node: ref[AstNode]) returns ref[AstNode]?
    {
        if Checker.is_super_call(node)
            return node
        if AstNode.is_function_like(node)
            return null
        let n AstNode.child_count(node)
        var i 0
        while i < n
        {
            let child AstNode.child_at(node, i)
            if child <> null
            {
                let found Checker.find_first_super_call(child as ref[AstNode])
                if found <> null
                    return found
            }
            set i: i + 1
        }
        null
    }

    ; isInstancePropertyWithInitializerOrPrivateIdentifierProperty.
    function is_instance_property_with_initializer_or_private_identifier_property(this, n: ref[AstNode]) returns bool
    {
        if AstNode.is_private_identifier_class_element_declaration(n)
            return true
        if AstNode.kind_of(n) <> KindPropertyDeclaration
            return false
        if b.is_static(n)
            return false
        AstNode.initializer_of(n) <> null
    }

    ; superCallIsRootLevelInConstructor. ★The parenthesis walk is on the PARENT and
    ; not on the call: `(super())` is still root-level, and it is the statement that
    ; must be the body's own child.
    function super_call_is_root_level_in_constructor(super_call: ref[AstNode], body: ref[AstNode]) returns bool
    {
        let parent Checker.walk_up_parenthesized_expressions(AstNode.parent_node_of(super_call))
        if parent = null
            return false
        let pp parent as ref[AstNode]
        if AstNode.kind_of(pp) <> KindExpressionStatement
            return false
        let gp AstNode.parent_node_of(pp)
        if gp = null
            return false
        (gp as ref[AstNode]) = body
    }

    ; nodeImmediatelyReferencesSuperOrThis. §3.9d again, and the BLOCK arm is the
    ; one that is not a plain fork: a block whose parent is a constructor, method or
    ; accessor is another frame's `this`, so the walk stops — but a block anywhere
    ; else (an `if`'s consequent, a bare block) FALLS THROUGH to its children rather
    ; than answering false.
    function node_immediately_references_super_or_this(node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindSuperKeyword
            return true
        if k = KindThisKeyword
            return true
        if k = KindArrowFunction
            return false
        if k = KindFunctionDeclaration
            return false
        if k = KindFunctionExpression
            return false
        if k = KindPropertyDeclaration
            return false
        if k = KindBlock
        {
            let pk Checker.kind_or_unknown(AstNode.parent_node_of(node))
            if pk = KindConstructor
                return false
            if pk = KindMethodDeclaration
                return false
            if pk = KindGetAccessor
                return false
            if pk = KindSetAccessor
                return false
        }
        let n AstNode.child_count(node)
        var i 0
        while i < n
        {
            let child AstNode.child_at(node, i)
            if child <> null
            {
                if Checker.node_immediately_references_super_or_this(child as ref[AstNode])
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; getAccessorThisParameter and ast.GetThisParameter, folded into the one
    ; question doesAccessorHaveCorrectParameterCount asks of them. The reference's
    ; own comment is the specification: *a `get` accessor has no parameters or a
    ; single `this` parameter; a `set` accessor has one parameter or a `this`
    ; parameter and one more parameter* — and getAccessorThisParameter answers nil
    ; for a WRONG arity even when a `this` parameter is declared, which is what
    ; makes the disjunction below exact rather than merely sufficient.
    function does_accessor_have_correct_parameter_count(this, accessor: ref[AstNode]) returns bool
    {
        let parameters AstNode.parameters_of(accessor)
        let n AstNode.list_count(parameters)
        var plain 1
        if AstNode.kind_of(accessor) = KindGetAccessor
            set plain: 0
        if n = plain
            return true
        ; getAccessorThisParameter: the arity ONE higher, and a first parameter
        ; that is `this`.
        if n <> plain + 1
            return false
        AstNode.is_this_parameter(AstNode.child_in_list(parameters, 0))
    }

    ; GetSetAccessorValueParameter, whole.
    function get_set_accessor_value_parameter(accessor: ref[AstNode]) returns ref[AstNode]?
    {
        let parameters AstNode.parameters_of(accessor)
        let n AstNode.list_count(parameters)
        if n = 0
            return null
        var i 0
        if n = 2
        {
            if AstNode.is_this_parameter(AstNode.child_in_list(parameters, 0))
                set i: 1
        }
        AstNode.child_in_list(parameters, i)
    }

    ; checkGrammarAccessor, whole.
    ;
    ; ★★ EVERY BRANCH RETURNS, so the function reports AT MOST ONE diagnostic and
    ; the order of the tests is the order of the answers — transcribed as a chain of
    ; early returns rather than folded, because two of the tests overlap (`abstract`
    ; with a body is both *an abstract accessor cannot have an implementation* and,
    ; one branch up, not a missing-body case at all).
    ;
    ; ★ The reference PANICS where GetSetAccessorValueParameter answers nil, on the
    ; strength of the arity check three lines up; this port asks instead, for the
    ; reason the JsxOpeningElement arm reports instead of trapping.
    procedure check_grammar_accessor(this, accessor: ref[AstNode]) returns bool
    {
        let body AstNode.body_of(accessor)
        let parent AstNode.parent_node_of(accessor)
        let pk Checker.kind_or_unknown(parent)
        var in_type_container false
        if pk = KindTypeLiteral
            set in_type_container: true
        if pk = KindInterfaceDeclaration
            set in_type_container: true
        if (AstNode.flags_of(accessor) & NodeFlagsAmbient) = 0
        {
            if in_type_container = false
            {
                if body = null
                {
                    if b.has_syntactic_modifier(accessor, ModifierFlagsAbstract) = false
                        return this.grammar_error_at_pos(accessor, AstNode.end_of(accessor) - 1, 1, DiagX_0_expected, "{")
                }
            }
        }
        if body <> null
        {
            if b.has_syntactic_modifier(accessor, ModifierFlagsAbstract)
                return this.grammar_error_on_node(accessor, DiagAn_abstract_accessor_cannot_have_an_implementation)
            if in_type_container
                return this.grammar_error_on_node(body as ref[AstNode], DiagAn_implementation_cannot_be_declared_in_ambient_contexts)
        }
        let name AstNode.name_of(accessor)
        if AstNode.type_parameters_of(accessor) <> null
            return this.grammar_error_on_node_or_null(name, DiagAn_accessor_cannot_have_type_parameters)
        if this.does_accessor_have_correct_parameter_count(accessor) = false
        {
            var code: int DiagA_set_accessor_must_have_exactly_one_parameter
            if AstNode.kind_of(accessor) = KindGetAccessor
                set code: DiagA_get_accessor_cannot_have_parameters
            return this.grammar_error_on_node_or_null(name, code)
        }
        if AstNode.kind_of(accessor) <> KindSetAccessor
            return false
        if AstNode.type_of(accessor) <> null
            return this.grammar_error_on_node_or_null(name, DiagA_set_accessor_cannot_have_a_return_type_annotation)
        let parameter Checker.get_set_accessor_value_parameter(accessor)
        if parameter = null
            return false
        let p parameter as ref[AstNode]
        let dots AstNode.dot_dot_dot_token_of(p)
        if dots <> null
            return this.grammar_error_on_node(dots as ref[AstNode], DiagA_set_accessor_cannot_have_rest_parameter)
        let question AstNode.question_token_of(p)
        if question <> null
            return this.grammar_error_on_node(question as ref[AstNode], DiagA_set_accessor_cannot_have_an_optional_parameter)
        if AstNode.initializer_of(p) <> null
            return this.grammar_error_on_node_or_null(name, DiagA_set_accessor_parameter_cannot_have_an_initializer)
        false
    }

    ; checkAccessorDeclaration, down to getTypeOfAccessors.
    ;
    ; ★★★ THE GRAMMAR HEAD IS THREE CALLS AND TWO SUPPRESSIONS, the shape
    ; check_property_declaration's header names: a report in
    ; checkGrammarFunctionLikeDeclaration withholds checkGrammarAccessor, and a
    ; report in either withholds the computed-property-name check.
    ;
    ; ★★ THE GETTER'S MISSING-RETURN REPORT IS A BINDER FLAG READ AND NOTHING ELSE,
    ; which is what separates it from the non-void return path slice 82 ported:
    ; NodeFlagsHasImplicitReturn and NodeFlagsHasExplicitReturn are set by the
    ; binder's reachability pass, so `get x() { if (c) return 1 }` is answered
    ; without a control-flow graph. It is the one report of this arm that needs no
    ; type at all.
    procedure check_accessor_declaration(this, node: ref[AstNode])
    {
        if this.check_grammar_function_like_declaration(node) = false
        {
            if this.check_grammar_accessor(node) = false
            {
                let nm AstNode.name_of(node)
                if nm <> null
                    this.check_grammar_computed_property_name(nm as ref[AstNode])
            }
        }
        let name AstNode.name_of(node)
        if Checker.kind_or_unknown(name) = KindIdentifier
        {
            if Checker.identifier_text_equals(name as ref[AstNode], "constructor")
            {
                if Parser.is_class_like_node(AstNode.parent_node_of(node))
                    this.error_on_node(name as ref[AstNode], DiagClass_constructor_may_not_be_an_accessor)
            }
        }
        this.check_decorators(node)
        this.check_signature_declaration(node)
        ; ★★★ TS2378 WAS CFG-BLOCKED AND SLICE 92 UNBLOCKS IT — THIS IS THE
        ; DIAGNOSTIC PRODUCT OF THE BINDER'S FLOW HALF. Its test is `Ambient == 0
        ; && NodeIsPresent(body) && HasImplicitReturn && !HasExplicitReturn`, and
        ; slice 83's note here called that *a BINDER FLAG read, not a control-flow
        ; question* — true of where the flags are READ and false of where they are
        ; WRITTEN. Upstream both bits are set in bindContainer under
        ; `b.currentFlow.Flags & FlowFlagsUnreachable == 0`, so until the binder
        ; built a flow graph they were DECLARED in NodeFlags.scaly and written
        ; nowhere. They are written now, and the flow yardstick's `r` section is
        ; what says so on every unit rather than on this one.
        ;
        ; ★★★ THE WARNING THAT STOOD HERE IS THE REASON THIS SLICE MEASURED THE
        ; SWAP FROM BOTH ENDS, and it is worth keeping: writing the four-term test
        ; against flags nobody sets answers FALSE on every input and loses TS2378
        ; corpus-wide — and **diagcheck compares a SUBSEQUENCE, so a line this port
        ; never emits is invisible to it**. The draft slice 83 caught was green on
        ; all 1 371 units with the report dead. So the arm's control is a LOSS
        ; control (h-, in the battery) and not an invention one.
        if AstNode.kind_of(node) = KindGetAccessor
        {
            if (AstNode.flags_of(node) & NodeFlagsAmbient) = 0
            {
                if Binder.node_is_missing(AstNode.body_of(node)) = false
                {
                    if (AstNode.flags_of(node) & NodeFlagsHasImplicitReturn) <> 0
                    {
                        if (AstNode.flags_of(node) & NodeFlagsHasExplicitReturn) = 0
                        {
                            if name <> null
                                this.error_on_node(name as ref[AstNode], DiagA_get_accessor_must_return_a_value)
                        }
                    }
                }
            }
        }
        ; The reference's own comment is the argument for asking the KIND rather
        ; than hasDynamicName: *do not use hasDynamicName here, because that returns
        ; false for well known symbols* — a `[Symbol.iterator]` accessor must reach
        ; checkComputedPropertyName all the same.
        if Checker.kind_or_unknown(name) = KindComputedPropertyName
            this.check_computed_property_name(name as ref[AstNode])
        ; hasBindableName, in the shape check_function_or_method_declaration uses:
        ; `!HasDynamicName(node) || hasLateBindableName(node)` — ported in slice 124.
        if this.has_bindable_name(node)
            this.check_accessor_declaration_flags(node)
        ; getTypeOfAccessors, ported in slice 112 with the getter-body inference its
        ; third resolution step is. ★The value's one reader here is
        ; checkAllCodePathsInNonVoidFunctionReturnOrThrow, and slice 82's collapse
        ; is what makes the getter arm mean something: the call is a no-op for a
        ; NIL return type and not for an inferred one.
        let acc_mark this.unported_mark()
        let acc_symbol this.get_symbol_of_declaration(node)
        var accessor_return_type: ref[Type]? null
        if acc_symbol <> null
            set accessor_return_type: this.get_type_of_accessors(acc_symbol as ref[Symbol])
        if this.unported_mark() = acc_mark
        {
            if AstNode.kind_of(node) = KindGetAccessor
                this.check_all_code_paths_in_non_void_function_return_or_throw(node, accessor_return_type)
        }
        ; ★ The body walk runs PAST the report, for check_source_elements' reason:
        ; diagcheck compares the C section whether or not the dump is suppressed, so
        ; the statements after the first report are exactly where an invented
        ; diagnostic would hide.
        this.check_source_element(AstNode.body_of(node))
        this.set_node_links_for_private_identifier_scope(node)
    }

    ; The accessibility block of checkAccessorDeclaration, lifted to its own
    ; procedure because it is the whole of what `hasBindableName` guards.
    ;
    ; ★★★ THE ONCE-BIT IS ON THE GETTER AND IT IS WHY BOTH REPORTS FIRE IN PAIRS.
    ; The reference reports on the getter's name AND the setter's for each of its
    ; two findings, and guards the pair with NodeCheckFlagsTypeChecked on the
    ; GETTER's links — so the second of the two accessors to be checked finds the
    ; bit set and says nothing. Without it every pair would report four times.
    ;
    ; ★ The bit is a named field rather than a flags word, which is
    ; declared_type_link_of's `index_signatures_checked` convention: this port
    ; carries no NodeCheckFlags, and the two other readers of that bit upstream ask
    ; it of nodes nothing here hands to this table.
    procedure check_accessor_declaration_flags(this, node: ref[AstNode])
    {
        let symbol this.symbol_of_declaration(node)
        if symbol = null
            return
        let sym symbol as ref[Symbol]
        let getter Checker.declaration_of_kind(sym, KindGetAccessor)
        if getter = null
            return
        let setter Checker.declaration_of_kind(sym, KindSetAccessor)
        if setter = null
            return
        let g getter as ref[AstNode]
        let s setter as ref[AstNode]
        let links this.node_link_of(g)
        if links.type_checked
            return
        set links.type_checked: true
        let gf b.modifier_flags(g)
        let sf b.modifier_flags(s)
        if (gf & ModifierFlagsAbstract) <> (sf & ModifierFlagsAbstract)
        {
            this.error_on_node_or_null(AstNode.name_of(g), DiagAccessors_must_both_be_abstract_or_non_abstract)
            this.error_on_node_or_null(AstNode.name_of(s), DiagAccessors_must_both_be_abstract_or_non_abstract)
        }
        var accessibility_mismatch false
        if (gf & ModifierFlagsProtected) <> 0
        {
            if (sf & (ModifierFlagsProtected | ModifierFlagsPrivate)) = 0
                set accessibility_mismatch: true
        }
        if (gf & ModifierFlagsPrivate) <> 0
        {
            if (sf & ModifierFlagsPrivate) = 0
                set accessibility_mismatch: true
        }
        if accessibility_mismatch
        {
            this.error_on_node_or_null(AstNode.name_of(g), DiagA_get_accessor_must_be_at_least_as_accessible_as_the_setter)
            this.error_on_node_or_null(AstNode.name_of(s), DiagA_get_accessor_must_be_at_least_as_accessible_as_the_setter)
        }
    }

    ; ast.GetContainingClass — `FindAncestor(node.Parent, IsClassLike)`, written out
    ; as the walk it is (§3.9d) and starting at the PARENT, in the shape
    ; get_containing_function above has.
    function get_containing_class(node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        var p AstNode.parent_node_of(node)
        while p <> null
        {
            if Parser.is_class_like_node(p)
                return p
            set p: AstNode.parent_node_of(p)
        }
        null
    }

    ; checkNodeDeferred, whole. The reference's `links.typeChecked` term is the
    ; guard against re-deferring a file that has already been checked once; one
    ; Checker here serves one file and runs once, so the flag can only be false at
    ; every call — written down rather than translated, because a field with one
    ; reachable value is not state.
    ;
    ; ★★★ BUT THE CONTAINER IS A **SET**, AND READING IT AS A LIST IS A
    ; NON-TERMINATION. Upstream `links.deferredNodes` is
    ; `collections.OrderedSet[*ast.Node]` and this is `.Add` — so deferring the same
    ; node twice is a NO-OP. This port had an Array and `.add`, and the drain below
    ; walks by a growing INDEX, so a node whose own deferred check re-defers it
    ; queues itself forever. Measured on `const x = (() => { x; return 'x'; })()`:
    ; the quick-type path checks the arrow, which defers it; the deferred check needs
    ; `x`, whose initializer checks the arrow again; 1 140 000 rounds in six seconds
    ; and no end. **Two stage-2 units did not finish in sixty seconds and that is a
    ; defect class of its own, not a slow answer.**
    ;
    ; ★★ IT WAS LATENT RATHER THAN NEW. Nothing before slice 115 asked for the type
    ; of a call's CALLEE, so no arm could re-enter a deferral from inside one; the
    ; quick path is what made the cycle reachable. A container whose ELEMENT
    ; SEMANTICS differ from the reference's is invisible until something inserts a
    ; duplicate.
    ;
    ; ★ The membership scan is linear over a list that holds type parameters,
    ; object literals and function expressions — tens of entries — which is the same
    ; decision the instantiation and tuple-target caches make (see TypeInstantiation).
    procedure check_node_deferred(this, node: ref[AstNode]?)
    {
        let n deferred_nodes.get_length() as int
        var i 0
        while i < n
        {
            if deferred_nodes[i] = node
                return
            set i: i + 1
        }
        deferred_nodes.add(node)
    }

    ; checkDeferredNodes. Slice 60 is the slice its old header named — *the arm that
    ; first defers a body must find the drain already in place rather than add it
    ; silently* — so the loop is real now and the set is no longer empty by
    ; construction. What it drains is type parameters and nothing else: the
    ; reference's own switch has ten arms and checkNodeDeferred has nine callers, of
    ; which one is ported.
    ;
    ; ★ The reference clears the list after the walk and this port does not need to
    ; (one file, one drain, one Checker), but the clear is kept: it is what makes
    ; the drain idempotent, and a second caller is the ordinary way this function
    ; grows.
    procedure check_deferred_nodes(this)
    {
        var i 0
        while i < deferred_nodes.get_length()
        {
            this.check_deferred_node(deferred_nodes[i])
            set i: i + 1
        }
        deferred_nodes.clear()
    }

    ; checkDeferredNode's switch.
    ;
    ; ★★★ THE SENTENCE THAT STOOD HERE — *the other nine kinds cannot be in the
    ; list, nothing ported calls checkNodeDeferred on them* — HAD BEEN FALSE FOR
    ; ONE SLICE, AND THE COST WAS A CHECK THAT NEVER RAN. Slice 99's object-literal
    ; arm defers a GET or SET accessor (the reference's own handling: the accessor
    ; is deferred and its symbol added to the table unchanged), and this switch had
    ; no accessor arm — so `checkAccessorDeclaration`, a procedure this file has had
    ; since slice 51, was never reached for an object literal's accessor. Nothing
    ; reported it: a deferred node whose arm is missing is a fallthrough, and a
    ; fallthrough is indistinguishable from an arm that answers.
    ;
    ; ★★ THE RULE IT LEAVES: **a `check_node_deferred` call and this switch are one
    ; edit.** The list is the only coupling between them and it carries no type, so
    ; a new deferral compiles, runs and checks nothing.
    ;
    ; ★ What is still a fallthrough, each with the caller it would need:
    ; resolveUntypedCall (the call, new, tagged-template, decorator and JSX-opening
    ; kinds — deferred when overload resolution FAILS, which needs the call
    ; dimension), the two JSX element kinds, checkAssertionDeferred and
    ; `instanceof`. None of them has a writer into the list in this port.
    ;
    ; ★★★ THE VOID ARM IS THIS SLICE'S, AND THE RULE ABOVE IS WHY IT IS HERE AND
    ; NOT ONE COMMIT LATER: check_expression's KindVoidExpression arm calls
    ; check_node_deferred, so the writer and this switch had to move together. The
    ; first draft moved only the writer, and stage 2 answered exactly as this note
    ; predicts — `void foo` silently never checked `foo`, and the module-not-found
    ; report the reference files for it went missing on nine units.
    procedure check_deferred_node(this, node: ref[AstNode]?)
    {
        ; The same two registers checkSourceElement saves, and upstream sets them
        ; here for the same reason: a deferred node is checked long after the
        ; statement that scheduled it, so the limiters must report at IT.
        let save_current_node current_node
        set current_node: node
        set instantiation_count: 0
        this.check_deferred_node_worker(node)
        set current_node: save_current_node
    }

    procedure check_deferred_node_worker(this, node: ref[AstNode]?)
    {
        let k AstNode.kind_of(node)
        if k = KindVoidExpression
        {
            ; `c.checkExpression(node.Expression())` — the operand, at last.
            let operand AstNode.expression_of(node)
            if operand <> null
                this.check_expression(operand as ref[AstNode])
            return
        }
        if k = KindTypeParameter
        {
            this.check_type_parameter_deferred(node)
            return
        }
        ; Slice 124's kind, by the same rule.
        if k = KindClassExpression
        {
            this.check_class_expression_deferred(node as ref[AstNode])
            return
        }
        ; Slice 120's two kinds — see the rule above: a check_node_deferred call
        ; and this switch are ONE edit.
        if k = KindTypeAssertionExpression
        {
            this.check_assertion_deferred(node as ref[AstNode])
            return
        }
        if k = KindAsExpression
        {
            this.check_assertion_deferred(node as ref[AstNode])
            return
        }
        ; Slice 100's four kinds. The reference's switch sends all four to one arm,
        ; and so does this one — the deferred half asks the node's own kind nowhere.
        var function_like false
        if k = KindFunctionExpression
            set function_like: true
        if k = KindArrowFunction
            set function_like: true
        if k = KindMethodDeclaration
            set function_like: true
        if k = KindMethodSignature
            set function_like: true
        if function_like
        {
            this.check_function_expression_or_object_literal_method_deferred(node as ref[AstNode])
            return
        }
        var accessor false
        if k = KindGetAccessor
            set accessor: true
        if k = KindSetAccessor
            set accessor: true
        if accessor
        {
            this.check_accessor_declaration(node as ref[AstNode])
            return
        }
        ; Slice 119's two kinds, and they are the switch's rule arriving as a
        ; number: `check_jsx_element` and `check_jsx_self_closing_element` each
        ; write into the list, so these two arms and those two calls are ONE edit.
        if k = KindJsxElement
        {
            this.check_jsx_element_deferred(node as ref[AstNode])
            return
        }
        if k = KindJsxSelfClosingElement
        {
            this.check_jsx_self_closing_element_deferred(node as ref[AstNode])
            return
        }
        ; ── slice 138's five kinds, and the rule above is why they are here ─────
        ;
        ; ★★★ `get_candidate_for_overload_failure` CALLS check_node_deferred, so
        ; these arms and that one line are ONE edit — and the first draft of the
        ; slice made exactly the mistake this header predicts: the writer landed
        ; without the arm, and stage 1 lost the TS2304 the reference files for
        ; `(() => {})(arguments = 6)` on three units. *"These node kinds are
        ; deferred checked when overload resolution fails. To save on work, we
        ; ensure the arguments are checked just once in a deferred way."*
        var failed_call false
        if k = KindCallExpression
            set failed_call: true
        if k = KindNewExpression
            set failed_call: true
        if k = KindTaggedTemplateExpression
            set failed_call: true
        if k = KindDecorator
            set failed_call: true
        if k = KindJsxOpeningElement
            set failed_call: true
        if failed_call
        {
            let ignored this.resolve_untyped_call(node as ref[AstNode])
            return
        }
        ; The BinaryExpression arm is `instanceof` only, and resolve_untyped_call
        ; keeps a row for it — no writer in this port reaches it.
    }

    ; checkUnusedRenamedBindingElements, over the list checkVariableLikeDeclaration
    ; fills — WRITTEN in slice 182, and what it took was the reference-marking
    ; table its four predecessors' headers named as the wall (`Symbol
    ; .reference_kinds`, filled by resolve_name_worker's isUse branch).
    ;
    ; ★★★ THE DRAIN RUNS WHERE THE OTHER FOUR READERS DO NOT, and that is the
    ; whole reason this one is written and the unused-identifier chapter is not.
    ; `checkSourceFile(ctx, sf, checkUnused)` gates checkUnusedIdentifiers on
    ; `NoUnusedLocals || NoUnusedParameters || collection == &suggestionDiagnostics`
    ; — false for every unit of this harness, which asks GetDiagnostics with
    ; neither option set — while this call sits ABOVE that gate and runs on every
    ; file that is not a declaration file. So the table has exactly one observable
    ; reader here, and it reports an ERROR (TS2842) where the unused family files
    ; suggestions the dump does not carry.
    ;
    ; ★★ THE RELATED INFORMATION IS COMPUTED BY THE REFERENCE AND COMPARED BY
    ; NOTHING: `wrappingDeclaration.Type() == nil` adds a second span advising a
    ; type for the whole parameter, and the dump is `C pos end code`. It is left
    ; out with its condition rather than half-written.
    ;
    ; ★ The reference's debug.Assert — *only parameter declaration should be
    ; checked here* — is an assertion about the WRITER (the list is filled from a
    ; parameter's binding element) and not a branch; a walk that answers null is
    ; skipped rather than reported, which is what an assertion means here.
    ; ── checkUnusedIdentifiers (slice 265) ──────────────────────────────────
    ;
    ; registerForUnusedIdentifiersCheck appends to sourceFileLinks.identifierCheckNodes,
    ; one list per file as upstream (a single list filtered per file at drain time
    ; was quadratic in the program's size). The reports go through reportUnused, which sends a
    ; non-error to the suggestion list: under noUnusedLocals / noUnusedParameters the
    ; report is a diagnostic, otherwise it is dropped (a suggestion is not printed).
    procedure register_for_unused_identifiers_check(this, node: ref[AstNode])
    {
        let sf Checker.source_file_of_node(node)
        if sf = null
            return
        let link this.source_file_link_of(sf as ref[AstNode])
        if link.identifier_check_nodes = null
        {
            let fresh &Array[ref[AstNode]?]^host()
            set link.identifier_check_nodes: fresh
        }
        let list link.identifier_check_nodes as ref[Array[ref[AstNode]?]]
        list.add(node)
    }

    procedure set_report_options(allow_unreachable_code: int, allow_unused_labels: int, no_fallthrough_cases_in_switch: bool, allow_umd_global_access: bool)
    {
        set checker_allow_unreachable_code: allow_unreachable_code
        set checker_allow_unused_labels: allow_unused_labels
        set checker_no_fallthrough_cases_in_switch: no_fallthrough_cases_in_switch
        set checker_allow_umd_global_access: allow_umd_global_access
    }

    procedure set_unused_options(no_unused_locals: bool, no_unused_parameters: bool)
    {
        set checker_no_unused_locals: no_unused_locals
        set checker_no_unused_parameters: no_unused_parameters
    }

    function check_unused_enabled() returns bool
    {
        if checker_no_unused_locals
            return true
        checker_no_unused_parameters
    }

    procedure check_unused_identifiers(this)
    {
        if file = null
            return
        let link this.source_file_link_of(file as ref[AstNode])
        if link.identifier_check_nodes = null
            return
        let nodes link.identifier_check_nodes as ref[Array[ref[AstNode]?]]
        let n nodes.get_length() as int
        var i 0
        while i < n
        {
            let entry nodes[i as size_t]
            set i: i + 1
            if entry = null
                continue
            let node entry as ref[AstNode]
            let k AstNode.kind_of(node)
            if (k = KindClassDeclaration) or (k = KindClassExpression)
            {
                this.check_unused_class_members(node)
                this.check_unused_type_parameters(node)
                continue
            }
            if (k = KindSourceFile) or (k = KindModuleDeclaration) or (k = KindBlock) or (k = KindCaseBlock) or (k = KindForStatement) or (k = KindForInStatement) or (k = KindForOfStatement)
            {
                this.check_unused_locals_and_parameters(node)
                continue
            }
            if (k = KindConstructor) or (k = KindFunctionExpression) or (k = KindFunctionDeclaration) or (k = KindArrowFunction) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
            {
                ; only the implementation reports its parameters, not an overload
                if AstNode.body_of(node) <> null
                    this.check_unused_locals_and_parameters(node)
                this.check_unused_type_parameters(node)
                continue
            }
            if (k = KindMethodSignature) or (k = KindCallSignature) or (k = KindConstructSignature) or (k = KindFunctionType) or (k = KindConstructorType) or (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration) or (k = KindInterfaceDeclaration)
            {
                this.check_unused_type_parameters(node)
                continue
            }
            if k = KindInferType
            {
                this.check_unused_infer_type_parameter(node)
                continue
            }
            ; the reference panics ("Unhandled case in checkUnusedIdentifiers")
            this.record_unported("check-unused-identifiers", k)
        }
    }

    ; reportUnused's condition: the location is neither ambient nor under a parse
    ; error, and unusedIsError(kind) — a suggestion otherwise, which is not printed
    function unused_is_reported(location: ref[AstNode], is_parameter: bool) returns bool
    {
        if (AstNode.flags_of(location) & (NodeFlagsAmbient | NodeFlagsThisNodeOrAnySubNodesHasError)) <> 0
            return false
        if is_parameter
            return checker_no_unused_parameters
        checker_no_unused_locals
    }

    ; reportUnusedVariable: the kind is read off the location above the binding
    ; elements and patterns
    procedure report_unused_variable(this, location: ref[AstNode], diagnostic_node: ref[AstNode], code: int)
        this.report_unused_variable_with(location, diagnostic_node, code, null)

    procedure report_unused_variable(this, location: ref[AstNode], diagnostic_node: ref[AstNode], code: int, a0: String)
    {
        let args this.message_args()
        args.add(a0)
        this.report_unused_variable_with(location, diagnostic_node, code, args)
    }

    procedure report_unused_variable_with(this, location: ref[AstNode], diagnostic_node: ref[AstNode], code: int, args: ref[Array[String]]?)
    {
        var loc: ref[AstNode] location
        repeat
        {
            let lk AstNode.kind_of(loc)
            if (lk <> KindBindingElement) and (AstNode.is_binding_pattern(loc) = false)
                break
            let lp AstNode.parent_node_of(loc)
            if lp = null
                break
            set loc: lp as ref[AstNode]
        }
        if Checker.unused_is_reported(loc, AstNode.kind_of(loc) = KindParameter)
            this.error_on_node_with(diagnostic_node, code, args)
    }

    function is_referenced(this, symbol: ref[Symbol]?) returns bool
    {
        if symbol = null
            return false
        this.reference_kinds_of(symbol as ref[Symbol]) <> 0
    }

    procedure check_unused_class_members(this, node: ref[AstNode])
    {
        let members AstNode.member_list_of(node)
        if members = null
            return
        let ms members as ref[Array[ref[AstNode]?]]
        let n ms.get_length() as int
        var i 0
        while i < n
        {
            let mo ms[i as size_t]
            set i: i + 1
            if mo = null
                continue
            let member mo as ref[AstNode]
            let mk AstNode.kind_of(member)
            if (mk = KindMethodDeclaration) or (mk = KindPropertyDeclaration) or (mk = KindGetAccessor) or (mk = KindSetAccessor)
            {
                if mk = KindSetAccessor
                {
                    let own AstNode.symbol_of(member)
                    if own <> null
                    {
                        ; already reported on the getter
                        if (Symbol.flags_of(own as ref[Symbol]) & SymbolFlagsGetAccessor) <> 0
                            continue
                    }
                }
                let symbol this.get_symbol_of_declaration(member)
                if this.is_referenced(symbol)
                    continue
                var is_private false
                if b.has_syntactic_modifier(member, ModifierFlagsPrivate)
                    set is_private: true
                let mn AstNode.name_of(member)
                if mn <> null
                {
                    if AstNode.is_private_identifier(mn)
                        set is_private: true
                }
                if is_private = false
                    continue
                if (AstNode.flags_of(member) & NodeFlagsAmbient) <> 0
                    continue
                if Checker.unused_is_reported(member, false)
                    this.error_on_node(mn, DiagX_0_is_declared_but_its_value_is_never_read, this.symbol_arg(symbol))
                continue
            }
            if mk = KindConstructor
            {
                let params AstNode.parameters_of(member)
                if params = null
                    continue
                let ps params as ref[Array[ref[AstNode]?]]
                let pn ps.get_length() as int
                var pi 0
                while pi < pn
                {
                    let po ps[pi as size_t]
                    set pi: pi + 1
                    if po = null
                        continue
                    let parameter po as ref[AstNode]
                    if this.is_referenced(AstNode.symbol_of(parameter))
                        continue
                    if b.has_syntactic_modifier(parameter, ModifierFlagsPrivate) = false
                        continue
                    if Checker.unused_is_reported(parameter, false)
                        this.error_on_node(AstNode.name_of(parameter), DiagProperty_0_is_declared_but_its_value_is_never_read, Checker.arg_text(Symbol.name_of(AstNode.symbol_of(parameter) as ref[Symbol])))
                }
            }
            ; an index signature, a semicolon, a static block, a JS type alias: never
            ; private
        }
    }

    ; isIdentifierThatStartsWithUnderscore
    function is_identifier_that_starts_with_underscore(node: ref[AstNode]?) returns bool
    {
        if AstNode.kind_of(node) <> KindIdentifier
            return false
        let text AstNode.identifier_text_of(node)
        if (text.length as int) = 0
            return false
        text[0] = ("_" as char)
    }

    ; importClauseFromImported
    function import_clause_from_imported(node: ref[AstNode]) returns ref[AstNode]?
    {
        let k AstNode.kind_of(node)
        if k = KindImportClause
            return node
        if k = KindNamespaceImport
            return AstNode.parent_node_of(node)
        AstNode.parent_node_of(AstNode.parent_node_of(node))
    }

    procedure check_unused_locals_and_parameters(this, node: ref[AstNode])
    {
        let locals AstNode.locals_of(node)
        let variable_parents &Array[ref[AstNode]?]^host()
        let import_clauses &Array[ref[AstNode]?]^host()
        let imported &Array[ref[AstNode]?]()
        let imported_clause &Array[ref[AstNode]?]()
        let ln SymbolTable.length(locals)
        var li 0
        while li < ln
        {
            let lo SymbolTable.entry_symbol_at(locals, li)
            set li: li + 1
            if lo = null
                continue
            let local lo as ref[Symbol]
            let reference_kinds this.reference_kinds_of(local)
            let flags Symbol.flags_of(local)
            if (flags & SymbolFlagsTypeParameter) <> 0
            {
                if (flags & SymbolFlagsVariable) = 0
                    continue
                if (reference_kinds & SymbolFlagsVariable) <> 0
                    continue
            }
            else
            {
                if reference_kinds <> 0
                    continue
                if Symbol.export_symbol_of(local) <> null
                    continue
                if (flags & SymbolFlagsModuleExports) <> 0
                    continue
            }
            let dn Symbol.declaration_count(local)
            var di 0
            while di < dn
            {
                let dof Symbol.declaration_at(local, di)
                set di: di + 1
                if dof = null
                    continue
                let declaration dof as ref[AstNode]
                let dk AstNode.kind_of(declaration)
                if (dk = KindVariableDeclaration) or (dk = KindParameter) or (dk = KindBindingElement)
                {
                    let root Binder.get_root_declaration(declaration)
                    let rp AstNode.parent_node_of(root)
                    if rp <> null
                    {
                        if Checker.node_list_contains(variable_parents, rp as ref[AstNode]) = false
                            variable_parents.add(rp)
                    }
                    continue
                }
                if (dk = KindImportClause) or (dk = KindImportSpecifier) or (dk = KindNamespaceImport)
                {
                    if Checker.is_identifier_that_starts_with_underscore(AstNode.name_of(declaration)) = false
                    {
                        let clause Checker.import_clause_from_imported(declaration)
                        if clause <> null
                        {
                            if Checker.node_list_contains(import_clauses, clause as ref[AstNode]) = false
                                import_clauses.add(clause)
                            imported.add(declaration)
                            imported_clause.add(clause)
                        }
                    }
                    continue
                }
                if (dk <> KindTypeParameter) and (Binder.is_ambient_module(declaration) = false)
                    this.report_unused_local(declaration, Symbol.name_of(local))
            }
        }
        let vn variable_parents.get_length() as int
        var vi 0
        while vi < vn
        {
            let vp variable_parents[vi as size_t]
            set vi: vi + 1
            if vp = null
                continue
            let declaration vp as ref[AstNode]
            if AstNode.kind_of(declaration) = KindVariableDeclarationList
                this.report_unused_variables(declaration)
            else
                this.report_unused_variable_declarations(AstNode.parameters_of(declaration))
        }
        let cn import_clauses.get_length() as int
        var ci 0
        while ci < cn
        {
            let co import_clauses[ci as size_t]
            set ci: ci + 1
            if co = null
                continue
            let clause co as ref[AstNode]
            let unuseds &Array[ref[AstNode]?]^host()
            let iln imported.get_length() as int
            var ii 0
            while ii < iln
            {
                let ic imported_clause[ii as size_t]
                if ic <> null
                {
                    if (ic as ref[AstNode]) = clause
                        unuseds.add(imported[ii as size_t])
                }
                set ii: ii + 1
            }
            this.report_unused_imports(clause, unuseds)
        }
    }

    function node_list_contains(list: ref[Array[ref[AstNode]?]], node: ref[AstNode]) returns bool
    {
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let e list[i as size_t]
            if e <> null
            {
                if (e as ref[AstNode]) = node
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; reportUnusedLocal
    procedure report_unused_local(this, node: ref[AstNode], name_text: Slice[char])
    {
        var code DiagX_0_is_declared_but_its_value_is_never_read
        if Checker.is_type_declaration(node)
            set code: DiagX_0_is_declared_but_never_used
        if Checker.unused_is_reported(node, false) = false
            return
        let name AstNode.name_of(node)
        if name <> null
            this.error_on_node(name, code, Checker.arg_text(name_text))
        else
            this.error_on_node(node, code, Checker.arg_text(name_text))
    }

    ; reportUnusedVariables
    procedure report_unused_variables(this, node: ref[AstNode])
    {
        let declarations AstNode.variable_declarations_of(node)
        if AstNode.list_count(declarations) > 1
        {
            if this.every_unreferenced_variable_declaration(declarations)
            {
                this.report_unused_variable(node, node, DiagAll_variables_are_unused)
                return
            }
        }
        this.report_unused_variable_declarations(declarations)
    }

    ; reportUnusedBindingElements
    procedure report_unused_binding_elements(this, node: ref[AstNode])
    {
        let declarations AstNode.elements_of(node)
        if AstNode.list_count(declarations) > 1
        {
            if this.every_unreferenced_variable_declaration(declarations)
            {
                this.report_unused_variable(node, node, DiagAll_destructured_elements_are_unused)
                return
            }
        }
        this.report_unused_variable_declarations(declarations)
    }

    procedure every_unreferenced_variable_declaration(this, declarations: ref[Array[ref[AstNode]?]]?) returns bool
    {
        let n AstNode.list_count(declarations)
        var i 0
        while i < n
        {
            let d AstNode.child_in_list(declarations, i)
            set i: i + 1
            if d = null
                continue
            if this.is_unreferenced_variable_declaration(d as ref[AstNode]) = false
                return false
        }
        true
    }

    ; reportUnusedVariableDeclarations
    procedure report_unused_variable_declarations(this, declarations: ref[Array[ref[AstNode]?]]?)
    {
        let n AstNode.list_count(declarations)
        var i 0
        while i < n
        {
            let d AstNode.child_in_list(declarations, i)
            set i: i + 1
            if d = null
                continue
            let declaration d as ref[AstNode]
            let name AstNode.name_of(declaration)
            if name = null
                continue
            if b.is_parameter_property_declaration(declaration)
                continue
            if AstNode.is_this_parameter(declaration)
                continue
            let nm name as ref[AstNode]
            if AstNode.is_binding_pattern(nm)
                this.report_unused_binding_elements(nm)
            else
            {
                if this.is_unreferenced_variable_declaration(declaration)
                    this.report_unused_variable(declaration, nm, DiagX_0_is_declared_but_its_value_is_never_read, Checker.arg_text(AstNode.identifier_text_of(nm)))
            }
        }
    }

    ; isUnreferencedVariableDeclaration
    procedure is_unreferenced_variable_declaration(this, node: ref[AstNode]) returns bool
    {
        let name AstNode.name_of(node)
        if name = null
            return true
        let nm name as ref[AstNode]
        if AstNode.is_binding_pattern(nm)
            return this.every_unreferenced_variable_declaration(AstNode.elements_of(nm))
        let symbol this.get_symbol_of_declaration(node)
        if symbol <> null
        {
            if (this.reference_kinds_of(symbol as ref[Symbol]) & SymbolFlagsVariable) <> 0
                return false
        }
        let k AstNode.kind_of(node)
        let parent AstNode.parent_node_of(node)
        if k = KindBindingElement
        {
            if AstNode.kind_of(parent) = KindObjectBindingPattern
            {
                ; in `{ a, ...b }` `a` is used: it removes a property from `b`
                let elements AstNode.elements_of(parent)
                let en AstNode.list_count(elements)
                if en > 0
                {
                    let last AstNode.child_in_list(elements, en - 1)
                    if last <> null
                    {
                        if (last as ref[AstNode]) <> node
                        {
                            if AstNode.dot_dot_dot_token_of(last) <> null
                                return false
                        }
                    }
                }
            }
        }
        var underscore_exempt false
        if k = KindParameter
            set underscore_exempt: true
        if k = KindVariableDeclaration
        {
            let gk AstNode.kind_of(AstNode.parent_node_of(parent))
            if (gk = KindForInStatement) or (gk = KindForOfStatement)
                set underscore_exempt: true
            if (Binder.combined_node_flags(node) & NodeFlagsUsing) <> 0
                set underscore_exempt: true
        }
        if k = KindBindingElement
        {
            var shorthand false
            if AstNode.kind_of(parent) = KindObjectBindingPattern
            {
                if AstNode.property_name_of(node) = null
                    set shorthand: true
            }
            if shorthand = false
                set underscore_exempt: true
        }
        if underscore_exempt
        {
            if Checker.is_identifier_that_starts_with_underscore(nm)
                return false
        }
        true
    }

    ; reportUnusedImports
    procedure report_unused_imports(this, node: ref[AstNode], unuseds: ref[Array[ref[AstNode]?]])
    {
        var declaration_count 0
        if AstNode.name_of(node) <> null
            set declaration_count: 1
        let named_bindings AstNode.named_bindings_of(node)
        if named_bindings <> null
        {
            if AstNode.kind_of(named_bindings) = KindNamespaceImport
                set declaration_count: declaration_count + 1
            else
                set declaration_count: declaration_count + AstNode.list_count(AstNode.elements_of(named_bindings))
        }
        let un unuseds.get_length() as int
        if declaration_count > 1
        {
            if declaration_count = un
            {
                if Checker.unused_is_reported(node, false)
                    this.error_on_node(AstNode.parent_node_of(node), DiagAll_imports_in_import_declaration_are_unused)
                return
            }
        }
        var i 0
        while i < un
        {
            let u unuseds[i as size_t]
            set i: i + 1
            if u <> null
                this.report_unused_local(u as ref[AstNode], AstNode.identifier_text_of(AstNode.name_of(u as ref[AstNode])))
        }
    }

    ; checkUnusedInferTypeParameter
    procedure check_unused_infer_type_parameter(this, node: ref[AstNode])
    {
        let type_parameter AstNode.infer_type_parameter_of(node)
        if type_parameter = null
            return
        let tp type_parameter as ref[AstNode]
        if this.is_unreferenced_type_parameter(tp)
        {
            if Checker.unused_is_reported(node, true)
                this.error_on_node(AstNode.name_of(tp), DiagX_0_is_declared_but_never_used, Checker.arg_text(AstNode.identifier_text_of(AstNode.name_of(tp))))
        }
    }

    ; checkUnusedTypeParameters
    procedure check_unused_type_parameters(this, node: ref[AstNode])
    {
        let symbol this.get_symbol_of_declaration(node)
        if symbol <> null
        {
            if Checker.all_declarations_in_same_source_file(symbol as ref[Symbol]) = false
                return
        }
        let list AstNode.type_parameters_of(node)
        if list = null
            return
        let n AstNode.list_count(list)
        var all_unreferenced: bool n > 1
        var i 0
        while all_unreferenced and (i < n)
        {
            let tp AstNode.child_in_list(list, i)
            set i: i + 1
            if tp <> null
            {
                if this.is_unreferenced_type_parameter(tp as ref[AstNode]) = false
                    set all_unreferenced: false
            }
        }
        if all_unreferenced
        {
            ; rangeOfTypeParameters: from the `<` to past the `>`
            var lpos 0
            var lend 0
            if AstNode.list_range_of(node, list, &lpos, &lend) = false
            {
                this.record_unported("range-of-type-parameters", AstNode.kind_of(node))
                return
            }
            var stop b.skip_trivia_at(lend) + 1
            let text_length b.trivia.buffer.length as int
            if stop > text_length
                set stop: text_length
            if Checker.unused_is_reported(node, true)
                this.add_diagnostic_direct(lpos - 1, stop, DiagAll_type_parameters_are_unused)
            return
        }
        set i: 0
        while i < n
        {
            let tp AstNode.child_in_list(list, i)
            set i: i + 1
            if tp = null
                continue
            if this.is_unreferenced_type_parameter(tp as ref[AstNode])
            {
                if Checker.unused_is_reported(node, true)
                    this.error_on_node(tp, DiagX_0_is_declared_but_never_used, Checker.arg_text(AstNode.identifier_text_of(AstNode.name_of(tp as ref[AstNode]))))
            }
        }
    }

    ; allDeclarationsInSameSourceFile
    function all_declarations_in_same_source_file(symbol: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(symbol)
        if n <= 1
            return true
        let first Checker.source_file_of_node(Symbol.declaration_at(symbol, 0))
        var i 1
        while i < n
        {
            if Checker.source_file_of_node(Symbol.declaration_at(symbol, i)) <> first
                return false
            set i: i + 1
        }
        true
    }

    ; isUnreferencedTypeParameter
    function is_unreferenced_type_parameter(this, type_parameter: ref[AstNode]) returns bool
    {
        let symbol this.get_merged_symbol(AstNode.symbol_of(type_parameter))
        if symbol <> null
        {
            if (this.reference_kinds_of(symbol as ref[Symbol]) & SymbolFlagsTypeParameter) <> 0
                return false
        }
        Checker.is_identifier_that_starts_with_underscore(AstNode.name_of(type_parameter)) = false
    }

    ; markPropertyAsReferenced — a private member read or called marks its symbol
    procedure mark_property_as_referenced(this, prop: ref[Symbol], node_for_check_write_only: ref[AstNode]?, is_self_type_access: bool)
    {
        if (Symbol.flags_of(prop) & SymbolFlagsClassMember) = 0
            return
        let vd Symbol.value_declaration_of(prop)
        if vd = null
            return
        let decl vd as ref[AstNode]
        var is_private b.has_syntactic_modifier(decl, ModifierFlagsPrivate)
        let dn AstNode.name_of(decl)
        if dn <> null
        {
            if AstNode.is_private_identifier(dn)
                set is_private: true
        }
        if is_private = false
            return
        if node_for_check_write_only <> null
        {
            if Checker.is_write_only_access(node_for_check_write_only as ref[AstNode])
            {
                if (Symbol.flags_of(prop) & SymbolFlagsSetAccessor) = 0
                    return
            }
        }
        if is_self_type_access
        {
            var a node_for_check_write_only
            while a <> null
            {
                if AstNode.is_function_like_declaration(a)
                    break
                set a: AstNode.parent_node_of(a)
            }
            if a <> null
            {
                let asym AstNode.symbol_of(a)
                if asym <> null
                {
                    if (asym as ref[Symbol]) = prop
                        return
                }
            }
        }
        var target: ref[Symbol] prop
        if (Symbol.check_flags_of(prop) & CheckFlagsInstantiated) <> 0
        {
            let t this.value_symbol_link_of(prop).target
            if t <> null
                set target: t as ref[Symbol]
        }
        this.add_reference_kinds(target, SymbolFlagsAll)
    }

    ; isSelfTypeAccess
    procedure is_self_type_access(this, name: ref[AstNode], parent: ref[Symbol]?) returns bool
    {
        if AstNode.kind_of(name) = KindThisKeyword
            return true
        if parent = null
            return false
        if Checker.is_entity_name_expression(name) = false
            return false
        let first Checker.get_first_identifier(name)
        if first = null
            return false
        let resolved this.get_resolved_symbol(first as ref[AstNode])
        (parent as ref[Symbol]) = resolved
    }

    procedure check_unused_renamed_binding_elements(this)
    {
        let n renamed_binding_elements_in_types.get_length() as int
        var i 0
        while i < n
        {
            let node renamed_binding_elements_in_types[i]
            set i: i + 1
            if node = null
                continue
            let nd node as ref[AstNode]
            let symbol this.get_symbol_of_declaration(nd)
            if symbol = null
                continue
            if this.reference_kinds_of(symbol as ref[Symbol]) <> 0
                continue
            let wrapping Checker.walk_up_binding_elements_and_patterns(nd)
            if wrapping = null
                continue
            let property_name_text this.declaration_name_to_string(AstNode.property_name_of(nd))
            let renaming_mark this.diagnostic_mark()
            this.error_on_node(AstNode.name_of(nd), DiagX_0_is_an_unused_renaming_of_1_Did_you_intend_to_use_it_as_a_type_annotation, this.declaration_name_to_string(AstNode.name_of(nd)), property_name_text)
            let wd wrapping as ref[AstNode]
            if (AstNode.type_of(wd) = null) and (this.diagnostic_mark() > renaming_mark)
            {
                ; the entire parameter has no annotation: an empty span at its end
                let args this.message_args()
                args.add(property_name_text)
                let dl diagnostics as ref[DiagnosticList]
                dl.add_related_at(renaming_mark, Checker.source_file_of_node(wd), AstNode.end_of(wd), AstNode.end_of(wd), DiagWe_can_only_write_a_type_for_0_by_adding_a_type_for_the_entire_parameter_here, args)
            }
        }
    }

    ; produceDeferredDiagnostics, over deferredDiagnosticCallbacks. Empty for the
    ; same reason again — addDeferredDiagnostic's callers are all inside arms that
    ; report — and kept for the same reason: a diagnostic that is deferred and
    ; never produced is invisible, so the drain belongs in place from the start.
    procedure add_deferred_check(this, kind: int, node: ref[AstNode]?, t: ref[Type]?, flag: bool)
    {
        if deferred_checks = null
            set this.deferred_checks: &Array[DeferredCheck]^host()
        (deferred_checks as ref[Array[DeferredCheck]]).add(DeferredCheck(kind, node, t, flag))
    }

    ; produceDeferredDiagnostics: the callbacks in the order they were deferred
    ; (a callback may defer another, which runs in the same drain)
    procedure produce_deferred_diagnostics(this)
    {
        if deferred_checks = null
            return
        let list deferred_checks as ref[Array[DeferredCheck]]
        var i 0
        while i < (list.get_length() as int)
        {
            let d list[i as size_t]
            set i: i + 1
            if d.node = null
                continue
            let n d.node as ref[AstNode]
            if d.kind = DeferredCheckKindWeakMapSet
                this.check_weak_map_set_collision(n)
            if d.kind = DeferredCheckKindReflect
                this.check_reflect_collision(n)
            if (d.kind = DeferredCheckKindNotIterable) and (d.t <> null)
                this.report_type_not_iterable_error(n, d.t as ref[Type], d.flag)
        }
        set this.deferred_checks: null
    }

    ; ── slice 65: the merged declarations, and the symbol every arm asks for ──
    ;
    ; ★★★ TWO HEADS, ONE SLICE, BECAUSE ONE OF THEM CALLS THE OTHER. Slice 64 left
    ; `check-exports-on-merged-declarations` at 5 599 units and
    ; `get-symbol-of-declaration` at 5 593 — the two largest rows of the work list,
    ; between them more than half the corpus — and the choice between them is not a
    ; choice: checkExportsOnMergedDeclarations' SECOND line is
    ; `c.getSymbolOfDeclaration(node)`. A slice that took the merged-declaration
    ; head alone would have had to stop inside it at the smaller head, and a slice
    ; that took getSymbolOfDeclaration alone would have moved five arms one line.
    ;
    ; ★★★ AND getSymbolOfDeclaration IS FOUR LINES. The row is 5 593 units deep
    ; because every check that needs a symbol goes through it, not because the
    ; function is large — `node.Symbol()`, then getMergedSymbol of
    ; getLateBoundSymbol. What the row's SIZE measures is how central the question
    ; is, and what the slice buys is therefore mostly in the arms behind it. That is
    ; the §3.5cd shape again read at the head rather than at the walk: **a work-list
    ; row's depth is a claim about how many callers are waiting, never about how
    ; much code the row is.**
    ;
    ; ★★★ THREE OF THE FOUR SITES THAT CARRIED THE `get-symbol-of-declaration` TAG
    ; ARE NOT BLOCKED BY IT, and finding that out is what porting it is for. The tag
    ; was written at the first call into the unported region, which is the file's
    ; convention, and for three of the four sites the very next line is a
    ; DIFFERENT unported function:
    ;
    ;   check_type_parameter          getDeclaredTypeOfTypeParameter
    ;   check_infer_type              nothing — the block behind it is guarded by
    ;                                 `len(symbol.Declarations) > 1`, so the arm
    ;                                 FINISHES for a single-declaration parameter
    ;   check_unused_renamed_...      symbolReferenceLinks.referenceKinds
    ;   check_variable_like_decl...   getTypeOfSymbol, two lines further on
    ;
    ; So one site advances, two are re-tagged with the function that actually stops
    ; them, and one turns out not to be stopped at all. ★It is §3.5ci's finding with
    ; the sign reversed: there, a marker named a blocker that never existed; here,
    ; three markers named a blocker that exists and is not theirs. **A tag placed at
    ; the first unported call is a claim about an ORDER, and the order changes under
    ; it every time a neighbour lands.**

    ; ast.GetDeclarationOfKind — the first declaration of this symbol with that
    ; kind, or null.
    ;
    ; ★ The reference's returns a *ast.Node and its caller compares it with `!=
    ; node`; nothing reads the null case, so the null is the "no such declaration"
    ; answer rather than a hole.
    function declaration_of_kind(s: ref[Symbol]?, kind: int) returns ref[AstNode]?
    {
        let n Symbol.declaration_count(s as ref[Symbol])
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(s as ref[Symbol], i)
            if d <> null
            {
                if AstNode.kind_of(d) = kind
                    return d
            }
            set i: i + 1
        }
        null
    }

    ; getMergedSymbol, whole — AND IT HAS ITS TABLE SINCE SLICE 137.
    ;
    ; ★★★ THE NOTE THAT STOOD HERE WAS A CLAIM WITH A DATE ON IT AND THE DATE HAS
    ; PASSED. It read *"`c.mergedSymbols` is written at exactly two sites in all of
    ; internal/checker — mergeSymbol's `recordMergedSymbol(target, source)` and
    ; cloneSymbol's `recordMergedSymbol(result, symbol)` — and both are reached only
    ; from the GLOBAL merge ... so the map is empty and every lookup misses"*, and it
    ; closed with the sentence this slice is the answer to: *the slice that ports
    ; either one owes this function its table, and the failure mode if it does not is
    ; silent — a lookup that always misses and a table that is never filled are the
    ; same code*. Both writers are here now (merge_symbol and clone_symbol), and the
    ; reason the function was written out rather than folded into its callers is
    ; exactly that it could be given one without moving a single caller.
    ; the row merged_symbols just appended, into its index unless its key is already there
    ; (the scan this index replaces answered the FIRST row for a key)
    procedure merged_symbols_index_last(this)
    {
        let n (merged_symbols.get_length() as int) - 1
        let row merged_symbols[n]
        if row = null
            return
        let r row as ref[MergedSymbolLink]
        let key r.source
        if key = null
            return
        let address (key as ref[Symbol]) as int
        let ix merged_symbols_index
        if ix.find(address) = 0
            ix.insert(address, n)
    }

    ; the row flow_node_reachable just appended, into its index unless its key is already there
    ; (the scan this index replaces answered the FIRST row for a key)
    procedure flow_node_reachable_index_last(this)
    {
        let n (flow_node_reachable.get_length() as int) - 1
        let row flow_node_reachable[n]
        if row = null
            return
        let r row as ref[FlowReachableLink]
        let key r.flow
        if key = null
            return
        let address (key as ref[FlowNode]) as int
        let ix flow_node_reachable_index
        if ix.find(address) = 0
            ix.insert(address, n)
    }

    ; the row flow_node_post_super just appended, into its index unless its key is already there
    ; (the scan this index replaces answered the FIRST row for a key)
    procedure flow_node_post_super_index_last(this)
    {
        let n (flow_node_post_super.get_length() as int) - 1
        let row flow_node_post_super[n]
        if row = null
            return
        let r row as ref[FlowPostSuperLink]
        let key r.flow
        if key = null
            return
        let address (key as ref[FlowNode]) as int
        let ix flow_node_post_super_index
        if ix.find(address) = 0
            ix.insert(address, n)
    }

    ; the row context_free_types just appended, into its index unless its key is already there
    ; (the scan this index replaces answered the FIRST row for a key)
    procedure context_free_types_index_last(this)
    {
        let n (context_free_types.get_length() as int) - 1
        let row context_free_types[n]
        if row = null
            return
        let r row as ref[ContextFreeTypeLink]
        let key r.node
        if key = null
            return
        let address (key as ref[AstNode]) as int
        let ix context_free_types_index
        if ix.find(address) = 0
            ix.insert(address, n)
    }

    ; the row synthetic_expression_links just appended, into its index unless its key is already there
    ; (the scan this index replaces answered the FIRST row for a key)
    procedure synthetic_expression_links_index_last(this)
    {
        let n (synthetic_expression_links.get_length() as int) - 1
        let row synthetic_expression_links[n]
        if row = null
            return
        let r row as ref[SyntheticExpressionLink]
        let key r.node
        if key = null
            return
        let address (key as ref[AstNode]) as int
        let ix synthetic_expression_links_index
        if ix.find(address) = 0
            ix.insert(address, n)
    }

    ; the row instantiation_cache_links just appended, into its index unless its key is already there
    ; (the scan this index replaces answered the FIRST row for a key)
    procedure instantiation_cache_links_index_last(this)
    {
        let n (instantiation_cache_links.get_length() as int) - 1
        let row instantiation_cache_links[n]
        if row = null
            return
        let r row as ref[InstantiationCacheLink]
        let key r.source
        if key = null
            return
        let address (key as ref[Type]) as int
        let ix instantiation_cache_links_index
        if ix.find(address) = 0
            ix.insert(address, n)
    }

    function get_merged_symbol(this, symbol: ref[Symbol]?) returns ref[Symbol]?
    {
        if symbol = null
            return symbol
        let ix merged_symbols_index
        let at ix.find((symbol as ref[Symbol]) as int)
        if at > 0
        {
            let row merged_symbols[at - 1]
            if row <> null
            {
                let r row as ref[MergedSymbolLink]
                return r.target
            }
        }
        symbol
    }

    ; recordMergedSymbol, whole — one line upstream (`c.mergedSymbols[source] =
    ; target`) and a set-or-append here, because the store is a list.
    ;
    ; ★★ THE OVERWRITE IS NOT DECORATION. A symbol can be merged twice — a name
    ; declared in the lib, in the unit and again inside a module augmentation walks
    ; through this table once per merge — and a Go map assignment REPLACES, so an
    ; append-only list would leave the FIRST survivor in front of the scan and hand
    ; back a symbol that has itself since been merged away.
    procedure record_merged_symbol(this, target: ref[Symbol], source: ref[Symbol])
    {
        let ix merged_symbols_index
        let at ix.find(source as int)
        if at > 0
        {
            let row merged_symbols[at - 1]
            if row <> null
            {
                let r row as ref[MergedSymbolLink]
                set r.target: target
                return
            }
        }
        merged_symbols.add(&MergedSymbolLink^host(source, target))
        this.merged_symbols_index_last()
    }

    ; getLateBoundSymbol, whole since slice 129 — the forcing branch included.
    ;
    ; ★★★ IT IS THE THIRD DOOR INTO THE LATE-BINDING TABLE AND THE ONLY ONE WHOSE
    ; ANSWER DOES NOT COME BACK AS A RETURN VALUE. A symbol reaches the second line
    ; only if it is a CLASS MEMBER whose name is the internal `computed` one; the
    ; branch then forces the whole of the PARENT's members or exports table, and
    ; addDeclarationToLateBoundSymbol writes this symbol's row on the way past. So
    ; the function reads `links.late_symbol` after a call that returns something
    ; else entirely — which is exactly why the stop that stood here could not answer
    ; `symbol` instead (§3.5bk: the late-bound symbol is a DIFFERENT symbol).
    ;
    ; ★★ THE `isStatic` TEST IS ON THE DECLARATIONS AND NOT ON THE SYMBOL, so a
    ; member declared both ways — which the grammar allows and the duplicate check
    ; reports — forces the static side. The reference's `core.Some` is the same
    ; either-one-will-do test.
    procedure get_late_bound_symbol(this, symbol: ref[Symbol]) returns ref[Symbol]?
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsClassMember) = 0
            return symbol
        var cd Slice[char]()
        set cd: Binder.internal_name(host, "computed")
        if SymbolTable.names_equal(Symbol.name_of(symbol), cd) = false
            return symbol
        let links this.late_bound_link_of(symbol)
        if links.late_symbol = null
        {
            var bindable false
            var static_side false
            let n Symbol.declaration_count(symbol)
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(symbol, i)
                set i: i + 1
                if d = null
                    continue
                if this.has_late_bindable_name(d as ref[AstNode])
                    set bindable: true
                if b.has_syntactic_modifier(d as ref[AstNode], ModifierFlagsStatic)
                    set static_side: true
            }
            if bindable
            {
                let parent this.get_merged_symbol(Symbol.parent_of(symbol))
                if parent <> null
                {
                    if static_side
                        this.get_exports_of_symbol(parent as ref[Symbol])
                    else
                        this.get_members_of_symbol(parent as ref[Symbol])
                }
            }
        }
        if links.late_symbol = null
            set links.late_symbol: symbol
        links.late_symbol
    }

    ; getSymbolOfDeclaration, whole.
    ;
    ; ★ It answers null for a node the binder gave no symbol, as the reference does
    ; — and every caller in this slice dereferences the result, because the
    ; reference's callers do (`symbol.ExportSymbol`, `symbol.Flags`). Where a null
    ; can arrive the caller says so at its own line; this function does not invent a
    ; symbol to protect them.
    procedure symbol_of_declaration(this, node: ref[AstNode]?) returns ref[Symbol]?
    {
        let symbol AstNode.symbol_of(node)
        if symbol = null
            return null
        this.get_merged_symbol(this.get_late_bound_symbol(symbol))
    }

    ; getEnclosingContainer — FindAncestor from the node's PARENT for a container,
    ; written out as the walk it is (§3.9d).
    ;
    ; ★ It starts at the parent, not at the node, which matters for a
    ; ModuleDeclaration: its own container flags would otherwise answer itself.
    function enclosing_container(node: ref[AstNode]) returns ref[AstNode]?
    {
        var p AstNode.parent_node_of(node)
        while p <> null
        {
            if (Binder.get_container_flags(p) & ContainerFlagsIsContainer) <> 0
                return p
            set p: AstNode.parent_node_of(p)
        }
        null
    }

    ; getEffectiveDeclarationFlags, whole. The combined modifier flags, plus the two
    ; the AMBIENT context adds, masked with what the caller asked about.
    ;
    ; ★★★ THE `flags |= Export` TERM IS WHY AN AMBIENT DECLARATION CAN BE EXPORTED
    ; WITHOUT AN `export` KEYWORD, and it is the one term of this function the
    ; merged-declaration check depends on: inside `declare module "m" { ... }` every
    ; declaration is an export, so two declarations of one name that LOOK like one
    ; local and one export are two exports and do not collide. The condition is four
    ; conjuncts and each one removes a shape — a class or interface MEMBER (where
    ; ambient and export mean nothing), a container that is not an export context, a
    ; declaration that already carries `declare`, and a global-scope augmentation's
    ; body.
    ;
    ; ★ `getCombinedModifierFlagsCached` is the binder's combined_modifier_flags,
    ; extracted from has_combined_modifier in this slice: the predicate cannot serve
    ; a caller that ORs into the value.
    function effective_declaration_flags(this, n: ref[AstNode], flags_to_check: int) returns int
    {
        var flags b.combined_modifier_flags(n)
        if (AstNode.flags_of(n) & NodeFlagsAmbient) <> 0
        {
            let parent AstNode.parent_node_of(n)
            let pk Checker.kind_or_unknown(parent)
            var member_of_class_like false
            if pk = KindInterfaceDeclaration
                set member_of_class_like: true
            if pk = KindClassDeclaration
                set member_of_class_like: true
            if pk = KindClassExpression
                set member_of_class_like: true
            if member_of_class_like = false
            {
                let container Checker.enclosing_container(n)
                if container <> null
                {
                    var global_augmentation_body false
                    if pk = KindModuleBlock
                    {
                        let grandparent AstNode.parent_node_of(parent)
                        if grandparent <> null
                        {
                            if Binder.is_global_scope_augmentation(grandparent)
                                set global_augmentation_body: true
                        }
                    }
                    if (AstNode.flags_of(container) & NodeFlagsExportContext) <> 0
                    {
                        if (flags & ModifierFlagsAmbient) = 0
                        {
                            if global_augmentation_body = false
                                set flags: flags | ModifierFlagsExport
                        }
                    }
                }
                set flags: flags | ModifierFlagsAmbient
            }
        }
        flags & flags_to_check
    }

    ; getDeclarationSpaces, whole but for its ALIAS arm.
    ;
    ; ★★★ THE REFERENCE PANICS ON A KIND IT DOES NOT LIST, so §3.5bk applies with
    ; its usual force: a `return DeclarationSpacesNone` default would be a
    ; well-formed WRONG answer — no space means no intersection means no report —
    ; and the whole check would go quiet for a declaration kind nobody thought of.
    ; The default reports instead, with the kind in the detail, which is how the
    ; histogram would name it.
    ;
    ; ★★★ THE ALIAS ARM IS THE ONE HOLE AND IT IS FOUR KINDS PLUS A FALLTHROUGH.
    ; ImportEqualsDeclaration, NamespaceImport and ImportClause resolve the alias
    ; and OR the spaces of everything the target declares — `c.resolveAlias`, i.e.
    ; the whole of getTargetOfAliasDeclaration, which is the `check-alias-symbol`
    ; row of the work list. The fallthrough from ExportAssignment/BinaryExpression
    ; joins them when the exported expression is an entity name AND the symbol
    ; carries the Alias flag, and the two halves of that test are not equally cheap:
    ; the flag read is ours already, the entity-name test is ported, so the arm can
    ; tell an alias export from a value export and only the alias half stops.
    procedure declaration_spaces(this, node: ref[AstNode]) returns int
    {
        let k AstNode.kind_of(node)

        if k = KindInterfaceDeclaration
            return DeclarationSpacesExportType
        if k = KindTypeAliasDeclaration
            return DeclarationSpacesExportType
        if k = KindJSTypeAliasDeclaration
            return DeclarationSpacesExportType
        if k = KindJSDocTypedefTag
            return DeclarationSpacesExportType
        if k = KindJSDocCallbackTag
            return DeclarationSpacesExportType

        if k = KindModuleDeclaration
        {
            if Binder.is_ambient_module(node)
                return DeclarationSpacesExportNamespace | DeclarationSpacesExportValue
            if b.get_module_instance_state(node) <> ModuleInstanceStateNonInstantiated
                return DeclarationSpacesExportNamespace | DeclarationSpacesExportValue
            return DeclarationSpacesExportNamespace
        }

        if k = KindClassDeclaration
            return DeclarationSpacesExportType | DeclarationSpacesExportValue
        if k = KindEnumDeclaration
            return DeclarationSpacesExportType | DeclarationSpacesExportValue
        if k = KindEnumMember
            return DeclarationSpacesExportType | DeclarationSpacesExportValue

        if k = KindSourceFile
            return DeclarationSpacesExportType | DeclarationSpacesExportValue | DeclarationSpacesExportNamespace

        if k = KindVariableDeclaration
            return DeclarationSpacesExportValue
        if k = KindBindingElement
            return DeclarationSpacesExportValue
        if k = KindFunctionDeclaration
            return DeclarationSpacesExportValue
        if k = KindImportSpecifier
            return DeclarationSpacesExportValue

        if k = KindMethodSignature
            return DeclarationSpacesExportType
        if k = KindPropertySignature
            return DeclarationSpacesExportType

        ; The export-assignment pair, whose `fallthrough` into the alias arm is the
        ; reference's only one in this switch. `!IsEntityNameExpression(expression)
        ; || symbol.Flags&Alias == 0` answers ExportValue and RETURNS; otherwise the
        ; three import kinds' body runs.
        var is_alias_arm false
        if k = KindExportAssignment
            set is_alias_arm: true
        if k = KindBinaryExpression
            set is_alias_arm: true
        if is_alias_arm
        {
            var expression: ref[AstNode]? null
            if k = KindExportAssignment
                set expression: AstNode.expression_of(node)
            else
                set expression: AstNode.binary_right_of(node)
            if expression = null
                return DeclarationSpacesExportValue
            if Binder.is_entity_name_expression(expression) = false
                return DeclarationSpacesExportValue
            let symbol this.symbol_of_declaration(node)
            if symbol = null
                return DeclarationSpacesExportValue
            if (Symbol.flags_of(symbol) & SymbolFlagsAlias) = 0
                return DeclarationSpacesExportValue
            ; The reference FALLS THROUGH into the three alias arms below; the
            ; fall-through is spelled as a call here.
            return this.declaration_spaces_of_alias(node)
        }

        if k = KindImportEqualsDeclaration
            return this.declaration_spaces_of_alias(node)
        if k = KindNamespaceImport
            return this.declaration_spaces_of_alias(node)
        if k = KindImportClause
            return this.declaration_spaces_of_alias(node)

        this.record_unported("declaration-spaces", k)
        DeclarationSpacesNone
    }

    ; The three alias arms of getDeclarationSpaces, which the ExportAssignment arm
    ; falls through into — ANSWERED since slice 110. The union over the alias
    ; TARGET's declarations is what makes `import A = N; export interface A {}` a
    ; legal merge and `import A = V; export class A {}` an illegal one.
    procedure declaration_spaces_of_alias(this, node: ref[AstNode]) returns int
    {
        let symbol this.symbol_of_declaration(node)
        if symbol = null
            return DeclarationSpacesNone
        let target this.resolve_alias(symbol as ref[Symbol])
        if target = null
            return DeclarationSpacesNone
        let t target as ref[Symbol]
        var result DeclarationSpacesNone
        let n Symbol.declaration_count(t)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(t, i)
            set i: i + 1
            if d = null
                continue
            set result: result | this.declaration_spaces(d as ref[AstNode])
        }
        result
    }

    ; checkExportsOnMergedDeclarations, whole — slice 64's largest head.
    ;
    ; ★★★ WHAT IT CHECKS IS A DECLARATION *MERGE*, WHICH IS WHY IT IS A HEAD OF FIVE
    ; ARMS AND NOT A CHECK OF ONE KIND. `interface I {}` twice is one symbol with two
    ; declarations, and so is an interface merged with a namespace, a class with a
    ; namespace, an enum with an enum. The rule is that all declarations of one name
    ; agree on being exported or being local, per SPACE — so the function ORs each
    ; declaration's spaces into one of three accumulators (exported, non-exported,
    ; default-exported) and reports where two of them intersect.
    ;
    ; ★★★ THE FIRST LINE IS `node.LocalSymbol()` AND THE SLOT DID NOT EXIST. See
    ; AstNode.local_symbol and the binder's declare_module_member for the whole of
    ; that: the slot had been refused with §3.5be's rule and a survey that covered
    ; internal/binder only, so *no reader in the whole reference* was a statement
    ; about one package. This function is the reader.
    ;
    ; ★★ THE TWO SYMBOLS ARE ASKED IN THE ORDER THE REFERENCE ASKS THEM, and the
    ; order is the meaning: a node with a LOCAL symbol is a node that is itself
    ; exported (declareModuleMember gave it both halves), so the check runs on it
    ; directly. Only when there is no local symbol does it fall back to the node's
    ; own symbol and ask whether that symbol has an EXPORT — because a
    ; non-exported declaration can still be one of several declarations of a name
    ; another declaration exports, and that is exactly the collision being looked
    ; for. A pure local symbol returns.
    ;
    ; ★ `GetDeclarationOfKind(symbol, node.Kind) != node` is the once-per-list
    ; guard, and it is a NODE identity test rather than a bit: the first declaration
    ; of this kind runs the check and the others return, so a symbol with three
    ; interface declarations reports once per offending declaration rather than
    ; three times over. It needs no side table, which is why this head has none
    ; while its neighbours in the interface and enum arms do.
    ;
    ; ★★ THE MESSAGE ARGUMENTS ARE NOT PORTED, and that is the harness rather than
    ; a shortcut: `scanner.DeclarationNameToString(name)` fills the `{0}` of both
    ; codes, and the oracle's C section is `pos end code` and nothing else, so the
    ; text is invisible to every instrument here. Stated at the site because a
    ; missing argument reads exactly like a forgotten one.
    ; ast.GetNameOfDeclaration, asked of the BINDER — and it is asked rather than
    ; substituted, which is §3.5br's rule at its own site.
    ;
    ; ★★★ `AstNode.name_of` WOULD HAVE BEEN THE NARROWED ACCESSOR AGAIN. The
    ; reporting loop of checkExportsOnMergedDeclarations walks the symbol's
    ; declarations, and getDeclarationSpaces has arms for ExportAssignment and
    ; BinaryExpression — two kinds with NO name slot, whose name is their expression
    ; or their assigned-to left operand. Slice 29 paid for exactly this substitution
    ; once, on `export = x` twice, where the span was eleven characters instead of
    ; one; the difference survives here for the same reason it survived there, so it
    ; is spent up front rather than found by a corpus.
    ;
    ; ★★★ IT USED TO TRANSLATE THE BINDER'S REPORT INTO THE CHECKER'S — *get_name_of
    ; _declaration is a PROCEDURE that reports on the BINDER for the three
    ; GetAssignedName kinds* — AND THAT PREMISE DIED IN SLICE 124, which replaced the
    ; GetAssignedName stop with the walk itself. What was left is `is_unported()`, and
    ; that predicate is a LATCH: it asks whether this binder has stopped ANYWHERE,
    ; the binder still records during the CHECK (get_module_instance_state,
    ; error_range_for_node's rescan arm), and first-wins means the flag never clears.
    ; So after one such record every declaration in the unit answered null here with
    ; `name-of-declaration-assigned` in its place. The binder's own twin is
    ; error_range_for_node; both are fixed in this slice, and §3.5gd is the same
    ; reading one file over.
    procedure name_of_declaration(this, n: ref[AstNode]) returns ref[AstNode]?
        b.get_name_of_declaration(n)

    procedure check_exports_on_merged_declarations(this, node: ref[AstNode])
    {
        var symbol AstNode.local_symbol_of(node)
        if symbol = null
        {
            set symbol: this.symbol_of_declaration(node)
            if symbol = null
                return
            ; ★★★ THIS EARLY RETURN IS A CONDITION AND NOT A SHORTCUT, and the
            ; battery had to reach stage 2 to say so. The reference's comment reads
            ; *this is a pure local symbol (all declarations are non-exported) — no
            ; need to check anything*, which invites the reading that removing it
            ; would only waste a loop over one accumulator and two empties. Control
            ; g04 removes it: silent over 1 202 units, **RED 1 over 17 972**. An
            ; ambient container makes effective_declaration_flags answer Export for
            ; some of a purely local symbol's declarations and not for others, so the
            ; intersection is not empty and the check invents a report.
            if Symbol.export_symbol_of(symbol) = null
                return
        }

        if Checker.declaration_of_kind(symbol, AstNode.kind_of(node)) <> node
            return

        ; ★ Typed rather than `var x DeclarationSpacesNone`: an untyped binding
        ; PEELS its first operand as a type annotation, so a define constant in that
        ; position is read as a TYPE NAME and the initializer disappears.
        var exported_spaces: int DeclarationSpacesNone
        var non_exported_spaces: int DeclarationSpacesNone
        var default_exported_spaces: int DeclarationSpacesNone
        let count Symbol.declaration_count(symbol as ref[Symbol])
        var i 0
        while i < count
        {
            let d Symbol.declaration_at(symbol as ref[Symbol], i)
            if d <> null
            {
                let spaces this.declaration_spaces(d)
                let effective this.effective_declaration_flags(d, ModifierFlagsExport | ModifierFlagsDefault)
                if (effective & ModifierFlagsExport) <> 0
                {
                    if (effective & ModifierFlagsDefault) <> 0
                        set default_exported_spaces: default_exported_spaces | spaces
                    else
                        set exported_spaces: exported_spaces | spaces
                }
                else
                    set non_exported_spaces: non_exported_spaces | spaces
            }
            set i: i + 1
        }

        let non_default_exported_spaces exported_spaces | non_exported_spaces
        let common_exports_and_locals exported_spaces & non_exported_spaces
        let common_default_and_non_default default_exported_spaces & non_default_exported_spaces
        var intersects false
        if common_exports_and_locals <> 0
            set intersects: true
        if common_default_and_non_default <> 0
            set intersects: true
        if intersects = false
            return

        var j 0
        while j < count
        {
            let d Symbol.declaration_at(symbol as ref[Symbol], j)
            if d <> null
            {
                let spaces this.declaration_spaces(d)
                let name this.name_of_declaration(d)
                ; ★★★ THE NULL GUARD IS A DEVIATION THAT CANNOT BE OBSERVED, AND
                ; SAYING WHICH IS THE POINT. The reference calls `c.error(name, …)`
                ; with no guard, and NewDiagnosticForNode on a nil node builds a
                ; diagnostic with a nil FILE and a zero range — which addDiagnostic
                ; keeps, and which `GetDiagnosticsForFile(sourceFile.FileName())`
                ; then never returns, because it is filed under no file name at all.
                ; So the reference emits a report the oracle cannot see and this port
                ; emits none: the same answer through two different mechanisms, which
                ; is exactly the shape that must be written down rather than left to
                ; look like agreement.
                if name <> null
                {
                    if (spaces & common_default_and_non_default) <> 0
                        this.error_on_node(name, DiagMerged_declaration_0_cannot_include_a_default_export_declaration_Consider_adding_a_separate_export_default_0_declaration_instead, this.declaration_name_to_string(name))
                    else
                    {
                        if (spaces & common_exports_and_locals) <> 0
                            this.error_on_node(name, DiagIndividual_declarations_in_merged_declaration_0_must_be_all_exported_or_all_local, this.declaration_name_to_string(name))
                    }
                }
            }
            set j: j + 1
        }
    }

    ; ── the grammar checks ──────────────────────────────────────────────────
    ;
    ; c.hasParseDiagnostics(sourceFile), whole: `len(sourceFile.Diagnostics()) > 0`.
    ; ★ It is the PARSE list and not the JS-SYNTAX one: sf.Diagnostics() does not
    ; include the second list (tscaly_ast.scaly's dump has them as separate
    ; sections for exactly that reason), so a file whose only complaint is a
    ; TS8000-series JS-syntax error still gets its grammar checks.
    function has_parse_diagnostics(this) returns bool
        AstNode.diagnostic_count(file) > 0

    ; grammarErrorOnFirstToken, whole. The span is the FIRST TOKEN at the node's
    ; own pos — not GetErrorRangeForNode, so no declaration name and no
    ; trivia-skip-then-name is involved — which is the same distinction
    ; binder.error_on_first_token draws one phase earlier.
    ;
    ; ★★ THE PARSE-DIAGNOSTIC GUARD IS NOT A TIDINESS PASS. A file that failed to
    ; parse has a tree the grammar checks would read as a stream of violations, so
    ; the reference suppresses ALL of them and answers false — and the caller reads
    ; that false as *no grammar error here*, which is how `checkVariableStatement`'s
    ; `!c.checkGrammarModifiers(node) && …` chain keeps running. A port that
    ; reported anyway would add diagnostics on exactly the units the parser
    ; yardstick already calls broken.
    procedure grammar_error_on_first_token_with(this, n: ref[AstNode]?, code: int, args: ref[Array[String]]?) returns bool
    {
        if this.has_parse_diagnostics_of(n)
            return false
        var start 0
        var stop 0
        Binder.range_of_token_on(this.scanner_for(b), AstNode.pos_of(n as ref[AstNode]), &start, &stop)
        this.add_diagnostic_direct_with(start, stop, code, args)
        true
    }

    ; grammarErrorAtPos, whole — the third of the three reporters, and the one that
    ; reports at a span NO NODE has.
    ;
    ; ★★ IT TAKES NO NODE. Upstream's first parameter is `nodeForSourceFile` and
    ; its only use is `ast.GetSourceFileOfNode(node)`: this checker has exactly one
    ; file and reads it from its own field, so a parameter for it would be a second
    ; thing to keep in step (the same reasoning `has_parse_diagnostics` above
    ; follows, where the reference threads the file and this does not).
    ;
    ; ★ `length` rather than an end, because that is the reference's shape and the
    ; two callers below both pass a literal — `len(",")` and a computed `end-start`.
    ; grammarErrorAtPos(nodeForSourceFile, …): the diagnostic belongs to the
    ; NODE's file, and so does the parse-diagnostic guard (slice 366)
    procedure grammar_error_at_pos_with(this, node_for_file: ref[AstNode]?, start: int, length: int, code: int, args: ref[Array[String]]?) returns bool
    {
        if this.has_parse_diagnostics_of(node_for_file)
            return false
        if node_for_file = null
            this.add_diagnostic_direct_with(start, start + length, code, args)
        else
            this.add_diagnostic_at_node_with(start, start + length, code, node_for_file as ref[AstNode], args)
        true
    }

    ; hasParseDiagnostics(ast.GetSourceFileOfNode(n)); the current file without a node
    function has_parse_diagnostics_of(this, n: ref[AstNode]?) returns bool
    {
        if n = null
            return this.has_parse_diagnostics()
        let sf Checker.source_file_of_node(n)
        if sf = null
            return this.has_parse_diagnostics()
        AstNode.diagnostic_count(sf as ref[AstNode]) > 0
    }

    function first_node_of(list: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        if list = null
            return null
        let l list as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (l.get_length() as int)
        {
            let e l[i as size_t]
            if e <> null
                return e
            set i: i + 1
        }
        null
    }

    ; ── three null-safe readers the grammar checks need ─────────────────────
    ;
    ; ★★ The reference reads `node.Parent.Kind` and `node.Parent.Flags` straight
    ; out of checkGrammarModifiers, six times, because in Go a nil Parent field is
    ; a readable zero — `AstNode.kind_of` here DEREFERENCES. The assumption behind
    ; the reference's spelling is true for every node these checks reach (a bound
    ; declaration has a parent), but an assumption that is true today and crashes
    ; when it stops being true is exactly the shape this port keeps paying for, so
    ; the question is asked instead of assumed. KindUnknown is 0 and matches no
    ; kind test, which is what makes the substitution exact.
    function kind_or_unknown(n: ref[AstNode]?) returns int
    {
        if n = null
            return KindUnknown
        AstNode.kind_of(n)
    }

    function flags_or_none(n: ref[AstNode]?) returns int
    {
        if n = null
            return NodeFlagsNone
        AstNode.flags_of(n)
    }

    function is_ambient_module_or_null(n: ref[AstNode]?) returns bool
    {
        if n = null
            return false
        Binder.is_ambient_module(n)
    }

    ; grammarErrorOnNode, whole:
    ;
    ;   if !c.hasParseDiagnostics(sourceFile) { c.error(node, message); return true }
    ;   return false
    ;
    ; ★★ IT IS NOT grammar_error_on_first_token WITH ANOTHER SPAN. `c.error` goes
    ; through NewDiagnosticForNode, i.e. scanner.GetErrorRangeForNode — the same
    ; function the BINDER's error_on_node uses — so a declaration reports at its
    ; NAME and everything else at its own trivia-skipped start. The distinction is
    ; the one binder.scaly draws between its two reporters, one phase earlier, and
    ; the two sit ten lines apart there for the same reason they do here.
    ;
    ; ★★★ AND THE SPAN MACHINERY IS THE BINDER'S, WHICH IS WHERE SLICE 45's NOTE
    ; SAID THIS BILL WOULD ARRIVE. error_range_for_node's eight deferred arms carry
    ; the line *THE READER THAT EARNS THEM IS THE CHECKER … the checker dimension's
    ; first bill*; this is the caller it named. It answers false on one of those
    ; arms, and then the honest move is to report UNPORTED rather than to invent a
    ; span: a wrong span is a wrong answer that looks like a right one, and the
    ; fifth yardstick compares spans. ★For the kinds this slice reaches the arm
    ; cannot fire — a modifier is a keyword token and the five node kinds are not
    ; on the list — so the report is a guard against the next slice rather than a
    ; live path, which is exactly why it is written now.
    ; ★The parameter is NULLABLE, and the reference is what says so:
    ; `grammarErrorOnNode(node *ast.Node, ...)` takes a nilable pointer, and
    ; `_or_null` below was this file's own admission of it -- a twin that
    ; guarded and forwarded. The guard belongs HERE, where the deref is, and
    ; the twin is now the forwarder. Flow narrowing carries `n` into
    ; error_range_for_node unchanged: the early exit IS the proof.
    procedure grammar_error_on_node_with(this, n: ref[AstNode]?, code: int, args: ref[Array[String]]?) returns bool
    {
        if n = null
            return false
        if this.node_is_in_lib(n)
            return false
        if this.has_parse_diagnostics_of(n)
            return false
        var start 0
        var stop 0
        if this.error_range_in_own_file(n as ref[AstNode], &start, &stop) = false
        {
            this.record_unported("grammar-error-range", AstNode.kind_of(n))
            return false
        }
        this.add_diagnostic_at_node_with(start, stop, code, n as ref[AstNode], args)
        true
    }

    ; grammar_error_on_node's null-safe twin, in error_on_node_or_null's shape and
    ; for the same reason: the reference dereferences `accessor.Name()` at five of
    ; checkGrammarAccessor's reports, and a node that has no name has nothing to
    ; report ON — answering false is what *the check found nothing* means.
    procedure grammar_error_on_node_or_null(this, n: ref[AstNode]?, code: int) returns bool
        this.grammar_error_on_node_with(n, code, null)

    procedure grammar_error_on_node_or_null_with(this, n: ref[AstNode]?, code: int, args: ref[Array[String]]?) returns bool
        this.grammar_error_on_node_with(n, code, args)

    ; c.error, whole: `NewDiagnosticForNode(location, message)` then addDiagnostic.
    ;
    ; ★★ IT IS grammar_error_on_node WITHOUT THE PARSE GUARD, and that one missing
    ; line is the whole difference between the two reporters. A grammar check is
    ; suppressed on a file that failed to parse — its tree would read as a stream
    ; of violations — while a SEMANTIC error is not, because the reference reports
    ; those regardless. So the two cannot share an implementation, and the span
    ; machinery they do share is the binder's error_range_for_node.
    ;
    ; ★ The reference returns the *Diagnostic, for the two callers that attach
    ; related information to it (addTypeOnlyDeclarationRelatedInfo). Neither is in
    ; this slice's prefix, and the yardstick compares no related information —
    ; tscaly_types dumps `C pos end code` — so this answers nothing. The first
    ; caller that needs the value is the one that owes the return type.
    ; Nullable for grammar_error_on_node's reason, one paragraph up: the
    ; reference's `c.error(node, ...)` takes `*ast.Node`, and
    ; error_on_node_or_null was the twin that said so.
    procedure error_on_node_with(this, n: ref[AstNode]?, code: int, args: ref[Array[String]]?)
    {
        if n = null
            return
        if this.node_is_in_lib(n)
            return
        var start 0
        var stop 0
        if this.error_range_in_own_file(n as ref[AstNode], &start, &stop) = false
        {
            this.record_unported("error-range", AstNode.kind_of(n))
            return
        }
        this.add_diagnostic_at_node_with(start, stop, code, n as ref[AstNode], args)
    }

    ; ── checkGrammarModuleElementContext — slice 50's head ───────────────────
    ;
    ; ★★★ SIX LINES, AND IT IS THE HEAD OF SIX ARMS. Slice 49 could take the five
    ; kinds whose arm BEGINS with checkGrammarModifiers and had to leave the
    ; import/export/module family, because this function stands in front of that
    ; call there and may RETURN — porting the modifier check into those arms
    ; without it would have run it where the reference does not.
    ;
    ; ★★ THE RESULT IS NOT THE REPORT'S RESULT, and the distinction is load-bearing
    ; in exactly the case grammar_error_on_first_token exists for. Upstream answers
    ; `!isInAppropriateContext`, so on a file that failed to parse the report is
    ; suppressed and this still answers TRUE — the caller bails out either way,
    ; which is what its comment asks for (*just bail out to avoid cascading
    ; errors*). Answering the report's bool instead would run the whole arm on a
    ; broken tree.
    ;
    ; ★ The three appropriate parents are read null-safely (kind_or_unknown) for
    ; the reason its own note gives: Go reads a nil Parent as a zero and
    ; AstNode.kind_of dereferences.
    procedure check_grammar_module_element_context(this, node: ref[AstNode], code: int) returns bool
    {
        let pk Checker.kind_or_unknown(AstNode.parent_node_of(node))
        var in_appropriate_context false
        if pk = KindSourceFile
            set in_appropriate_context: true
        if pk = KindModuleBlock
            set in_appropriate_context: true
        if pk = KindModuleDeclaration
            set in_appropriate_context: true
        if in_appropriate_context
            return false
        this.grammar_error_on_first_token(node, code)
        true
    }

    ; checkGrammarExportDeclaration, whole. `export type { T }` may not repeat the
    ; `type` on a specifier.
    procedure check_grammar_export_declaration(this, node: ref[AstNode]) returns bool
    {
        if AstNode.is_type_only_of(node) = false
            return false
        let clause AstNode.export_clause_of(node)
        if clause = null
            return false
        if AstNode.kind_of(clause) <> KindNamedExports
            return false
        this.check_grammar_type_only_named_imports_or_exports(clause)
    }

    ; checkGrammarTypeOnlyNamedImportsOrExports. The reference's two branches read
    ; the SAME field (`specifier.IsTypeOnly()`) and differ only in the message, so
    ; the port keeps one read and picks the code — which is the §3.5n test applied
    ; to a branch rather than to a record.
    ;
    ; ★ It reports on the FIRST type-only specifier and returns, so a clause with
    ; two of them answers one diagnostic. That is the reference's `return` inside
    ; the loop and not a dedup.
    ;
    ; ★★ THE IMPORT SIDE IS PORTED AND UNREACHABLE FROM THIS SLICE, which is worth
    ; saying so it does not read as measured: its only caller is
    ; checkGrammarImportClause, which sits behind checkExternalImportOrExportDeclaration
    ; in checkImportDeclaration — the call this slice reports. It goes live with
    ; that one. Ported anyway, because this is ONE function and splitting it by
    ; caller would be a partial port of a function rather than a smaller slice.
    procedure check_grammar_type_only_named_imports_or_exports(this, named_bindings: ref[AstNode]?) returns bool
    {
        let els AstNode.elements_of(named_bindings)
        let n AstNode.list_count(els)
        var i 0
        while i < n
        {
            let specifier AstNode.child_in_list(els, i)
            var code: int DiagThe_type_modifier_cannot_be_used_on_a_named_export_when_export_type_is_used_on_its_export_statement
            if AstNode.kind_of(specifier) = KindImportSpecifier
                set code: DiagThe_type_modifier_cannot_be_used_on_a_named_import_when_import_type_is_used_on_its_import_statement
            if AstNode.is_type_only_of(specifier)
                return this.grammar_error_on_first_token(specifier, code)
            set i: i + 1
        }
        false
    }

    ; shouldCheckErasableSyntax, whole. ★ ErasableSyntaxOnly is unset under this
    ; harness, so this is false everywhere and its two readers carry LIVE code
    ; behind it rather than a report — see the field's note for why that is the
    ; right side of the line.
    function should_check_erasable_syntax(this, node: ref[AstNode]) returns bool
    {
        if erasable_syntax_only = false
            return false
        Parser.is_in_js_file(node) = false
    }

    ; ── the class-like grammar checks — slice 51's head ──────────────────────
    ;
    ; ★★★ THE HEAD IS TWO LINES AND THE BILL IS A SIDE TABLE. checkGrammarClassLikeDeclaration
    ; is `checkGrammarClassDeclarationHeritageClauses || checkGrammarTypeParameterList`,
    ; and BOTH halves report at a span that only a NodeList's own TextRange knows:
    ; `HasTrailingComma()` is `last.End() < list.End()` and an EMPTY bracketed list
    ; reports from `list.Pos()-len("<")` to `SkipTrivia(text, list.End())+len(">")`.
    ; This port's lists are plain Arrays, so §3.5bq's side table — built in slice 24
    ; for three JS-syntax arms of the PARSER — is the mechanism these checks need,
    ; and a Checker holds no Parser. It travels on the SourceFile now, beside the
    ; two diagnostic lists (ast.scaly's ListRange has the argument).
    ;
    ; ★★★ AND IT IS THE FIRST TIME ANY INSTRUMENT IN THIS PACKAGE CAN SEE A LIST'S
    ; RANGE. No yardstick dumps one — §3.5bq says so and that is exactly why the
    ; table was built with its own measurement rather than a test — so until this
    ; slice a wrong row and a right row compared equal everywhere. Three of the
    ; reports below are the first readers that can tell them apart.
    ;
    ; ★★ THE PARSE GUARD IS HOISTED IN FRONT OF EVERY RANGE LOOKUP, and that is an
    ; equivalence rather than a shortcut. Each of these checks computes a span and
    ; then hands it to grammar_error_at_pos, which answers false on a file that
    ; failed to parse; computing the span has no side effects, so testing the guard
    ; first gives the same answer for every input. It buys two things. A MISSING
    ; list — parse_bracketed_list's sentinel, handed out when the opening bracket
    ; was absent — carries no row, and it cannot arrive here: the only way to get
    ; one is a failed parse_expected, which reported. And a missing row is then
    ; reported only where it could have changed an answer.
    procedure list_range_of(this, list: ref[Array[ref[AstNode]?]]?, out_pos: ref[int], out_end: ref[int]) returns bool
    {
        if AstNode.list_range_of(file, list, out_pos, out_end)
            return true
        ; a list of another program file (slice 254): its own file's table
        if program = null
            return false
        let pf program as ref[ProgramFiles]
        var i 0
        while i < pf.count()
        {
            let other pf.file_at(i)
            set i: i + 1
            if other = null
                continue
            if other = file
                continue
            if AstNode.list_range_of(other, list, out_pos, out_end)
                return true
        }
        false
    }

    ; checkGrammarForDisallowedTrailingComma, whole. `list.HasTrailingComma()` is
    ; DERIVED upstream too — `len(Nodes) > 0 && last.End() < list.End()` — so the
    ; row is the only thing this needs that the elements do not already carry.
    ;
    ; ★ The message is a parameter here as it is upstream, because the two callers
    ; pass different ones; the reference's second argument (`list.Nodes[0]`) is the
    ; source-file lookup grammar_error_at_pos does not take.
    procedure check_grammar_for_disallowed_trailing_comma(this, list: ref[Array[ref[AstNode]?]]?, code: int) returns bool
    {
        let n AstNode.list_count(list)
        if n = 0
            return false
        if this.has_parse_diagnostics_of(Checker.first_node_of(list))
            return false
        var lpos 0
        var lend 0
        if this.list_range_of(list, &lpos, &lend) = false
        {
            this.record_unported("list-range", 0)
            return false
        }
        if AstNode.end_of((AstNode.child_in_list(list, n - 1)) as ref[AstNode]) >= lend
            return false
        this.grammar_error_at_pos(Checker.first_node_of(list), lend - 1, 1, code)
    }

    ; checkGrammarTypeParameterList, whole. It fires on a list that EXISTS and is
    ; EMPTY — `class C<> {}`, which parses cleanly, which is the whole reason the
    ; grammar check exists rather than a parse diagnostic.
    ;
    ; ★ `- len("<")` and `+ len(">")` are the reference's own spelling of the two
    ; brackets the list's range sits inside; the trivia skip in between is why the
    ; end cannot be taken from the range directly.
    procedure check_grammar_type_parameter_list(this, type_parameters: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if type_parameters = null
            return false
        if AstNode.list_count(type_parameters) <> 0
            return false
        if this.has_parse_diagnostics_of(Checker.first_node_of(type_parameters))
            return false
        var lpos 0
        var lend 0
        if this.list_range_of(type_parameters, &lpos, &lend) = false
        {
            this.record_unported("list-range", 0)
            return false
        }
        let start lpos - 1
        let stop b.skip_trivia_at(lend) + 1
        this.grammar_error_at_pos(Checker.first_node_of(type_parameters), start, stop - start, DiagType_parameter_list_cannot_be_empty)
    }

    ; checkGrammarForAtLeastOneTypeArgument — the same shape one message along.
    ; Upstream asks GetSourceFileOfNode(node) for the text and the report's file;
    ; this checker has one file and the parameter goes with it.
    procedure check_grammar_for_at_least_one_type_argument(this, type_arguments: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if type_arguments = null
            return false
        if AstNode.list_count(type_arguments) <> 0
            return false
        if this.has_parse_diagnostics_of(Checker.first_node_of(type_arguments))
            return false
        var lpos 0
        var lend 0
        if this.list_range_of(type_arguments, &lpos, &lend) = false
        {
            this.record_unported("list-range", 0)
            return false
        }
        let start lpos - 1
        let stop b.skip_trivia_at(lend) + 1
        this.grammar_error_at_pos(Checker.first_node_of(type_arguments), start, stop - start, DiagType_argument_list_cannot_be_empty)
    }

    ; checkGrammarTypeArguments, whole — the `||` of the two above, in that order.
    procedure check_grammar_type_arguments(this, type_arguments: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if this.check_grammar_for_disallowed_trailing_comma(type_arguments, DiagTrailing_comma_not_allowed)
            return true
        this.check_grammar_for_at_least_one_type_argument(type_arguments)
    }

    ; checkGrammarExpressionWithTypeArguments, whole. Its parameter is upstream's
    ; `Union[ExpressionWithTypeArguments, TypeQuery]`, and type_arguments_of answers
    ; both — which is one of the nine arms slice 30 widened it to (§3.5br).
    procedure check_grammar_expression_with_type_arguments(this, node: ref[AstNode]?) returns bool
    {
        if AstNode.kind_of(node) = KindExpressionWithTypeArguments
        {
            if Checker.kind_or_unknown(AstNode.expression_of(node)) = KindImportKeyword
            {
                if AstNode.type_arguments_of(node) <> null
                    return this.grammar_error_on_node(node, DiagThis_use_of_import_is_invalid_import_calls_can_be_written_but_they_must_have_parentheses_and_cannot_have_type_arguments)
            }
        }
        this.check_grammar_type_arguments(AstNode.type_arguments_of(node))
    }

    ; checkGrammarHeritageClause, whole.
    ;
    ; ★★ THE MESSAGE ARGUMENT IS DROPPED, on checkGrammarModifiers' argument one
    ; screen up: `{0} list cannot be empty` is filled from
    ; scanner.TokenToString(node.Token), a message's CODE does not depend on its
    ; arguments, and the dump is `C pos end code`. TokenToString is therefore still
    ; unported, and the bill for it is named where that note names it.
    ;
    ; ★ The reference reaches `types.Nodes` unguarded after the empty test, so a nil
    ; types would panic there; the guard here is not a divergence but the question
    ; asked instead of assumed — parse_heritage_clause always builds the list, which
    ; is why upstream can write it that way.
    procedure check_grammar_heritage_clause(this, node: ref[AstNode]?) returns bool
    {
        let types AstNode.heritage_clause_types_of(node)
        if this.check_grammar_for_disallowed_trailing_comma(types, DiagTrailing_comma_not_allowed)
            return true
        if types = null
            return false
        if AstNode.list_count(types) = 0
        {
            if this.has_parse_diagnostics_of(node)
                return false
            var lpos 0
            var lend 0
            if this.list_range_of(types, &lpos, &lend) = false
            {
                this.record_unported("list-range", 0)
                return false
            }
            ; grammarErrorAtPos(node, types.Pos(), 0, …) — a ZERO-WIDTH span at the
            ; list's own start, with the reference's own `why not error on the
            ; token?` left standing beside it.
            return this.grammar_error_at_pos(node, lpos, 0, DiagX_0_list_cannot_be_empty, Checker.arg_text(Scanner.token_to_string(AstNode.heritage_clause_token_of(node))))
        }
        var i 0
        let n AstNode.list_count(types)
        while i < n
        {
            if this.check_grammar_expression_with_type_arguments(AstNode.child_in_list(types, i))
                return true
            set i: i + 1
        }
        false
    }

    ; getIdentifierFromEntityNameExpression — the identifier at the END of an
    ; entity-name expression: the name itself, or a property access's `.name`.
    ; Anything else has no identifier and answers nothing.
    function identifier_from_entity_name_expression(node: ref[AstNode]?) returns ref[AstNode]?
    {
        let k Checker.kind_or_unknown(node)
        if k = KindIdentifier
            return node
        if k = KindPropertyAccessExpression
        {
            ; kind_or_unknown answered a real kind, so the node is there — the
            ; unwrap is what that test already proved.
            return AstNode.property_access_name_of(node as ref[AstNode])
        }
        null
    }

    ; The `@augments`/`@extends` half of checkGrammarClassDeclarationHeritageClauses,
    ; asked of the extends clause's SINGLE type node. TS8023 fires when the tag
    ; names a different class than the clause does.
    ;
    ; ★ The message takes three arguments — the tag's own name, the tag's class and
    ; the clause's — and none of them reaches the dump, which carries a code and a
    ; span (slice 68). What the reference's `grammarErrorOnNode(sourceName, …)`
    ; decides here is the SPAN, and that is the identifier inside the tag.
    procedure check_jsdoc_augments_against_extends(this, node: ref[AstNode], target_type: ref[AstNode]?) returns bool
    {
        let docs Parser.eager_jsdoc(p, node)
        if docs = null
            return false
        let list docs as ref[Array[ref[AstNode]?]]
        let count list.get_length() as int
        var i 0
        while i < count
        {
            let jsdoc list[i]
            set i: i + 1
            let tags AstNode.jsdoc_tags_of(jsdoc)
            if tags = null
                continue
            let tl tags as ref[Array[ref[AstNode]?]]
            let tcount tl.get_length() as int
            var j 0
            while j < tcount
            {
                let tag tl[j]
                set j: j + 1
                if Checker.kind_or_unknown(tag) <> KindJSDocAugmentsTag
                    continue
                let source AstNode.jsdoc_class_name_of(tag)
                let target_name Checker.identifier_from_entity_name_expression(AstNode.expression_of(target_type))
                let source_name Checker.identifier_from_entity_name_expression(AstNode.expression_of(source))
                if target_name = null
                    continue
                if source_name = null
                    continue
                if AstNode.identifier_texts_equal(target_name, source_name)
                    continue
                return this.grammar_error_on_node(source_name, DiagJSDoc_0_1_does_not_match_the_extends_2_clause, Checker.arg_text(AstNode.identifier_text_of(AstNode.jsdoc_tag_name_of(tag))), Checker.arg_text(AstNode.identifier_text_of(source_name)), Checker.arg_text(AstNode.identifier_text_of(target_name)))
            }
        }
        false
    }

    ; checkGrammarClassDeclarationHeritageClauses, whole.
    ;
    ; ★★★ THE JSDOC `@augments` WALK USED TO STAND HERE AS AN UNREACHABILITY CLAIM,
    ; AND THE CLAIM WAS FALSE THE DAY IT WAS WRITTEN — the fifth sighting of the
    ; class §3.5p names. It read *check_source_element_worker reports
    ; `check-jsdoc-comments` and RETURNS for any node carrying that flag, one call
    ; before this arm runs*, and check_jsdoc_comment stops for a @link and for
    ; NOTHING else, so no gate has ever stood in front of it. It surfaced the
    ; moment get_type_of_node's extends arm stopped reporting: `jsdocExtendsClause-
    ; Mismatch` completes and is MISSING its TS8023. ★A proof about a gate is only
    ; as good as the gate's own condition, and this one named a function without
    ; reading it — exactly what slice 112 had already written down one screen
    ; further up this file.
    ;
    ; ★★ UPSTREAM PANICS ON A HERITAGE TOKEN THAT IS NEITHER `extends` NOR
    ; `implements`, and the else branch here simply takes the implements reading.
    ; parse_heritage_clause is reached only on one of those two keywords and writes
    ; the token it saw, so the third case does not exist on either side; a trap
    ; would be a claim about a shape the parser cannot build.
    ;
    ; ★ `!c.checkGrammarModifiers(node) && classLikeData.HeritageClauses != nil` is
    ; a short-circuit whose LEFT side is the call, so the modifier check always
    ; runs — the same shape checkImportDeclaration's has, and the reason a class
    ; with no heritage clause at all still reports its modifier errors.
    procedure check_grammar_class_declaration_heritage_clauses(this, node: ref[AstNode]) returns bool
    {
        var seen_extends_clause false
        var seen_implements_clause false
        if this.check_grammar_modifiers(node)
            return false
        let clauses AstNode.heritage_clauses_of(node)
        if clauses = null
            return false
        var i 0
        let n AstNode.list_count(clauses)
        while i < n
        {
            let clause AstNode.child_in_list(clauses, i)
            set i: i + 1
            if AstNode.heritage_clause_token_of(clause) = KindExtendsKeyword
            {
                if seen_extends_clause
                    return this.grammar_error_on_first_token(clause, DiagX_extends_clause_already_seen)
                if seen_implements_clause
                    return this.grammar_error_on_first_token(clause, DiagX_extends_clause_must_precede_implements_clause)
                let types AstNode.heritage_clause_types_of(clause)
                if AstNode.list_count(types) > 1
                    return this.grammar_error_on_first_token(AstNode.child_in_list(types, 1), DiagClasses_can_only_extend_a_single_class)
                if AstNode.list_count(types) > 0
                {
                    if this.check_jsdoc_augments_against_extends(node, AstNode.child_in_list(types, 0))
                        return true
                }
                set seen_extends_clause: true
            }
            else
            {
                if seen_implements_clause
                    return this.grammar_error_on_first_token(clause, DiagX_implements_clause_already_seen)
                set seen_implements_clause: true
            }
            ; The reference DISCARDS this result — it is a statement of its own,
            ; after the extends/implements bookkeeping — so a report inside one
            ; clause does not stop the walk over the rest.
            this.check_grammar_heritage_clause(clause)
        }
        false
    }

    ; checkGrammarClassLikeDeclaration, whole: two calls and an `||`.
    procedure check_grammar_class_like_declaration(this, node: ref[AstNode]) returns bool
    {
        if this.check_grammar_class_declaration_heritage_clauses(node)
            return true
        this.check_grammar_type_parameter_list(AstNode.type_parameters_of(node))
    }

    ; ── slice 57: the interface's grammar head ───────────────────────────────

    ; checkGrammarInterfaceDeclaration, whole. One loop over the heritage clauses,
    ; and it is the smaller half of the class version above: an interface may have
    ; ONE `extends` and no `implements` at all, so there is no
    ; extends-must-precede-implements order to keep and no single-base rule — an
    ; interface's extends clause is allowed several types.
    ;
    ; ★★★ THE CLASS VERSION CALLS checkGrammarModifiers ITSELF AND THIS ONE DOES
    ; NOT, which is why the two heads cannot share a body however alike the loops
    ; look. Upstream's checkGrammarClassDeclarationHeritageClauses opens with
    ; `!c.checkGrammarModifiers(node) && …`; here the modifier check is the
    ; CALLER's line — `if !c.checkGrammarModifiers(node) { c.checkGrammarInterfaceDeclaration(…) }`
    ; — so folding it in would run it twice for the class and put the interface's
    ; heritage report behind a condition it does not have.
    ;
    ; ★★ THE `implements` ARM RETURNS ON THE REPORT'S RESULT, and on a file that
    ; failed to parse that result is FALSE — so the loop walks on into the next
    ; clause rather than stopping. That is the reference's own shape
    ; (`return c.grammarErrorOnFirstToken(...)`, not `report; return true`), and it
    ; is the same distinction check_grammar_module_element_context's header argues
    ; from the other side, where the answer must NOT be the report's.
    ;
    ; ★ Upstream PANICS on a heritage token that is neither `extends` nor
    ; `implements`; the else branch takes the implements reading, for the reason
    ; the class version's header gives — parse_heritage_clause is reached only on
    ; one of those two keywords and writes the token it saw, so the third case does
    ; not exist on either side.
    ;
    ; ★ checkGrammarHeritageClause's result is DISCARDED here as it is in the class
    ; version, and for the same reason: it is a statement of its own after the
    ; extends bookkeeping, so a report inside one clause does not stop the walk.
    procedure check_grammar_interface_declaration(this, node: ref[AstNode]) returns bool
    {
        let clauses AstNode.heritage_clauses_of(node)
        if clauses = null
            return false
        var seen_extends_clause false
        var i 0
        let n AstNode.list_count(clauses)
        while i < n
        {
            let clause AstNode.child_in_list(clauses, i)
            set i: i + 1
            if AstNode.heritage_clause_token_of(clause) = KindExtendsKeyword
            {
                if seen_extends_clause
                    return this.grammar_error_on_first_token(clause, DiagX_extends_clause_already_seen)
                set seen_extends_clause: true
            }
            else
                return this.grammar_error_on_first_token(clause, DiagInterface_declaration_cannot_have_implements_clause)
            this.check_grammar_heritage_clause(clause)
        }
        false
    }

    ; ── slice 52: the function-like grammar checks ───────────────────────────

    ; checkGrammarParameterList, whole. Four of its five reports are about the
    ; REST parameter and the fifth is the optional/required order; every span is a
    ; node this port already has, so nothing here needs the side table the type
    ; parameter list above needs.
    ;
    ; ★★ THE TRAILING-COMMA CALL IS THE ONLY ONE WHOSE RESULT IS DISCARDED, and
    ; that is the reference's own shape: a rest parameter with a trailing comma
    ; reports TS1013 and the walk CONTINUES into the question-mark and initializer
    ; tests of the same parameter, so a `...a?,` yields two diagnostics. Reading
    ; that call as a `return` would drop the second.
    ;
    ; ★★ THE AMBIENT GUARD IS ON THE PARAMETER, NOT ON THE FILE. `parameter.Flags
    ; & NodeFlagsAmbient == 0` — the flag is propagated down from the `declare`, so
    ; in a .d.ts every parameter carries it and the trailing comma is allowed there.
    ; A file-level test would be the same answer for the corpus's declaration files
    ; and a wrong one for a `declare function` in a .ts.
    ;
    ; ★ isOptionalDeclaration is ast.HasQuestionToken, which is
    ; `IsQuestionToken(node.QuestionToken())` — a null test plus a kind test, and
    ; question_token_of already answers null for anything that is not one (its
    ; postfix arm checks the kind). So the second arm's own `parameter.QuestionToken
    ; != nil` is not a second question: it is the same one, re-asked because
    ; upstream's helper took the node and its body wants the token.
    procedure check_grammar_parameter_list(this, parameters: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if parameters = null
            return false
        var seen_optional_parameter false
        let parameter_count AstNode.list_count(parameters)
        var i 0
        while i < parameter_count
        {
            let parameter AstNode.child_in_list(parameters, i)
            let index i
            set i: i + 1
            let dot_dot_dot AstNode.dot_dot_dot_token_of(parameter)
            let question AstNode.question_token_of(parameter)
            let initializer AstNode.initializer_of(parameter)
            if dot_dot_dot <> null
            {
                if index <> parameter_count - 1
                    return this.grammar_error_on_node(dot_dot_dot, DiagA_rest_parameter_must_be_last_in_a_parameter_list)
                if (AstNode.flags_of(parameter as ref[AstNode]) & NodeFlagsAmbient) = 0
                    this.check_grammar_for_disallowed_trailing_comma(parameters, DiagA_rest_parameter_or_binding_pattern_may_not_have_a_trailing_comma)
                if question <> null
                    return this.grammar_error_on_node(question, DiagA_rest_parameter_cannot_be_optional)
                if initializer <> null
                    return this.grammar_error_on_node(AstNode.name_of(parameter), DiagA_rest_parameter_cannot_have_an_initializer)
            }
            else
            {
                if question <> null
                {
                    set seen_optional_parameter: true
                    ; `parameter.QuestionToken.Flags & NodeFlagsReparsed == 0` — a
                    ; REPARSED `?` is the bracketed name of a JSDoc `@param [x]`
                    ; tag, which is not a syntax error to report at. ★It cannot be
                    ; reached from this slice's arm and is ported anyway: a `@param`
                    ; tag puts NodeFlagsHasJSDoc on the function, and
                    ; check_source_element_worker returns on that flag one call
                    ; earlier. So no unit separates the guard from its absence —
                    ; §3.5cv's `@augments` shape, expiring with the same slice.
                    if (AstNode.flags_of(question) & NodeFlagsReparsed) = 0
                    {
                        if initializer <> null
                            return this.grammar_error_on_node(AstNode.name_of(parameter), DiagParameter_cannot_have_question_mark_and_initializer)
                    }
                }
                else
                {
                    if seen_optional_parameter
                    {
                        if initializer = null
                            return this.grammar_error_on_node(AstNode.name_of(parameter), DiagA_required_parameter_cannot_follow_an_optional_parameter)
                    }
                }
            }
        }
        false
    }

    ; checkGrammarArrowFunction, whole (slice 100).
    ;
    ; ★★★ THE NOTE THAT STOOD HERE SAID THIS IS *WHERE THE ECMA LINE MAP WOULD BE
    ; PAID FOR* AND THAT IS NOT WHAT IT COST. The map is a whole chapter — a sorted
    ; table over the file plus a binary search — and this call site does not need
    ; one: it asks whether TWO positions of the SAME token are on different lines,
    ; and `startLine != endLine` is true exactly when a line START falls in
    ; `(pos, end]`. Computing that is a walk over the bytes between them, which for
    ; a `=>` token is its leading trivia. See ecma_lines_differ.
    ;
    ; ★★ THE ARM ORDER IS THE REFERENCE'S AND ITS FIRST REPORT DOES NOT RETURN —
    ; upstream carries a `TODO(danielr): should we return early here?` at exactly
    ; that line, so a file with both defects reports both, in this order. The TODO
    ; is transcribed as behaviour rather than resolved.
    procedure check_grammar_arrow_function(this, node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindArrowFunction
            return false
        let type_parameters AstNode.type_parameters_of(node)
        if type_parameters <> null
        {
            let n AstNode.list_count(type_parameters)
            var has_constraint false
            if n > 0
            {
                let first AstNode.child_in_list(type_parameters, 0)
                if AstNode.type_parameter_constraint_of(first) <> null
                    set has_constraint: true
            }
            var reserved true
            if n > 1
                set reserved: false
            if this.list_has_trailing_comma(type_parameters)
                set reserved: false
            if has_constraint
                set reserved: false
            if reserved
            {
                if is_mts_or_cts_file
                    this.grammar_error_on_node(AstNode.child_in_list(type_parameters, 0), DiagThis_syntax_is_reserved_in_files_with_the_mts_or_cts_extension_Add_a_trailing_comma_or_explicit_constraint)
            }
        }
        let arrow AstNode.equals_greater_than_token_of(node)
        if arrow = null
            return false
        let tok arrow as ref[AstNode]
        if this.ecma_lines_differ(tok, AstNode.pos_of(tok), AstNode.end_of(tok)) = false
            return false
        this.grammar_error_on_node(tok, DiagLine_terminator_not_permitted_before_arrow)
    }

    ; NodeList.HasTrailingComma — `len(Nodes) > 0 && last.End() < list.End()`.
    ; DERIVED upstream too, which is why check_grammar_for_disallowed_trailing_comma
    ; has been computing the same three lines inline since slice 49; this is the
    ; second reader, so the derivation gets a name.
    ;
    ; ★ A list whose RANGE cannot be answered reports through its caller rather
    ; than here, because a `false` and a hole are different claims and this
    ; function's answer feeds a DISJUNCTION where false is the interesting side.
    procedure list_has_trailing_comma(this, list: ref[Array[ref[AstNode]?]]?) returns bool
    {
        let n AstNode.list_count(list)
        if n = 0
            return false
        var lpos 0
        var lend 0
        if this.list_range_of(list, &lpos, &lend) = false
        {
            this.record_unported("list-range", 0)
            return false
        }
        AstNode.end_of((AstNode.child_in_list(list, n - 1)) as ref[AstNode]) < lend
    }

    ; scanner.GetECMALineOfPosition(file, a) != GetECMALineOfPosition(file, b),
    ; evaluated LOCALLY (slice 100).
    ;
    ; ★★★ WHY IT IS NOT THE LINE MAP. `ComputeECMALineStartsSeq` yields the
    ; position after every line break, and `ComputeLineOfPosition` answers the
    ; index of the last start at or before `pos`. So two positions lie on
    ; different lines exactly when at least one line START falls in `(a, b]` —
    ; which is a question about the text between them and about nothing else. The
    ; walk below is the reference's own recurrence restricted to that window, so
    ; it agrees with the map by construction rather than by approximation, and no
    ; table is built for a question asked once per arrow function.
    ;
    ; ★★ THE FOUR BREAK CHARACTERS ARE stringutil.IsLineBreak's AND NOT `\n`:
    ; LF, CR (CRLF counted once, exactly as the reference's `fallthrough` does),
    ; and U+2028 / U+2029, whose UTF-8 encodings are the fixed sequences
    ; `E2 80 A8` and `E2 80 A9`. Testing those three bytes is a fact about UTF-8,
    ; not a shortcut past the decoder.
    ; ★ the text is the NODE's file, as upstream's `GetECMALineOfPosition(file, …)`:
    ; it was the checker's default binder, so in a program another file's bytes at
    ; the same offsets decided, and a line break there reported TS1200 on a
    ; one-line arrow (2026-09-17, three on VS Code)
    procedure ecma_lines_differ(this, node: ref[AstNode], start_pos: int, end_pos: int) returns bool
    {
        if end_pos <= start_pos
            return false
        let text (this.binder_of_node(node)).source_slice(start_pos, end_pos)
        let n text.length as int
        var i 0
        while i < n
        {
            let c (text[i as size_t] as int) & 255
            if c = 13
            {
                ; CR, and a following LF belongs to the same break.
                var q i + 1
                if q < n
                {
                    if ((text[q as size_t] as int) & 255) = 10
                        set q: q + 1
                }
                if start_pos + q <= end_pos
                    return true
                set i: q
                continue
            }
            if c = 10
            {
                if start_pos + i + 1 <= end_pos
                    return true
                set i: i + 1
                continue
            }
            if c = 226
            {
                if i + 2 < n
                {
                    if ((text[(i + 1) as size_t] as int) & 255) = 128
                    {
                        let third (text[(i + 2) as size_t] as int) & 255
                        var is_break false
                        if third = 168
                            set is_break: true
                        if third = 169
                            set is_break: true
                        if is_break
                        {
                            if start_pos + i + 3 <= end_pos
                                return true
                        }
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    ; checkGrammarForUseStrictSimpleParameterList, whole.
    ;
    ; ★★★ THE LANGUAGE-VERSION GATE IS LIVE, AND IT IS THE OPPOSITE READING OF THE
    ; ONE `check-decorators` PARKED ON. That report stands behind an option the
    ; harness leaves UNSET and whose default is FALSE, so the branch is dead; this
    ; gate is `c.languageVersion >= core.ScriptTargetES2016`, and languageVersion is
    ; `compilerOptions.GetEmitScriptTarget()`, which answers
    ; ScriptTargetLatestStandard — ES2025, the HIGHEST standard target — when Target
    ; is unset. So an unset option makes this branch always TAKEN. Reading "the
    ; option is unset" as "the branch is dead" is a wrong answer half the time, and
    ; which half depends on the reference's own default. The same default is what
    ; kills the two checkExternalEmitHelpers calls in check_signature_declaration:
    ; `languageVersion < ES2018` is false at ES2025.
    ;
    ; ★★ THE RELATED INFO IS DROPPED AND THE DIAGNOSTICS ARE NOT. Upstream attaches
    ; `'use strict' directive used here` to each parameter report and
    ; `Non-simple parameter declared here` / `and here` to the directive's, through
    ; AddRelatedInfo — which ast.NewDiagnostic keeps ON the diagnostic rather than in
    ; the list, so no dump reaches it (the same argument check_grammar_modifiers'
    ; header makes about a message's ARGUMENTS). What the dump does see is one TS1346
    ; per non-simple parameter plus one TS1347 on the directive, and that is what
    ; this emits.
    ;
    ; ★ The filter is walked TWICE upstream (once to report on each parameter, once
    ; to attach the related info in index order) and once here, because the second
    ; walk produces nothing this port keeps. `core.Filter` therefore needs no list:
    ; the FIRST non-simple parameter decides whether anything is reported at all, so
    ; the loop counts and reports in one pass and the directive's report follows it.
    procedure check_grammar_for_use_strict_simple_parameter_list(this, node: ref[AstNode]) returns bool
    {
        if language_version < ScriptTargetES2016
            return false
        let body AstNode.body_of(node)
        if body = null
            return false
        if AstNode.kind_of(body) <> KindBlock
            return false
        let use_strict_directive b.find_use_strict_prologue(AstNode.statements_of(body))
        if use_strict_directive = null
            return false
        let parameters AstNode.parameters_of(node)
        if parameters = null
            return false
        var non_simple 0
        var i 0
        let n AstNode.list_count(parameters)
        while i < n
        {
            let parameter AstNode.child_in_list(parameters, i)
            set i: i + 1
            var is_non_simple false
            if AstNode.initializer_of(parameter) <> null
                set is_non_simple: true
            if AstNode.is_binding_pattern(AstNode.name_of(parameter))
                set is_non_simple: true
            if AstNode.dot_dot_dot_token_of(parameter) <> null
                set is_non_simple: true
            if Checker.is_rest_parameter(parameter as ref[AstNode])
                set is_non_simple: true
            if is_non_simple
            {
                set non_simple: non_simple + 1
                let parameter_mark this.diagnostic_mark()
                this.error_on_node(parameter, DiagThis_parameter_is_not_allowed_with_use_strict_directive)
                this.related_info_since(parameter_mark, use_strict_directive, DiagX_use_strict_directive_used_here)
            }
        }
        if non_simple = 0
            return false
        let directive_mark this.diagnostic_mark()
        this.error_on_node(use_strict_directive, DiagX_use_strict_directive_cannot_be_used_with_non_simple_parameter_list)
        var index 0
        var j 0
        while j < n
        {
            let parameter AstNode.child_in_list(parameters, j)
            set j: j + 1
            var is_non_simple false
            if AstNode.initializer_of(parameter) <> null
                set is_non_simple: true
            if AstNode.is_binding_pattern(AstNode.name_of(parameter))
                set is_non_simple: true
            if AstNode.dot_dot_dot_token_of(parameter) <> null
                set is_non_simple: true
            if Checker.is_rest_parameter(parameter as ref[AstNode])
                set is_non_simple: true
            if is_non_simple
            {
                if index = 0
                    this.related_info_since(directive_mark, parameter, DiagNon_simple_parameter_declared_here)
                else
                    this.related_info_since(directive_mark, parameter, DiagX_and_here)
                set index: index + 1
            }
        }
        true
    }

    ; checkGrammarFunctionLikeDeclaration, whole: a five-term `||`, and the longest
    ; chain of grammar checks this port has run end to end (slice 51's
    ; checkGrammarClassLikeDeclaration is two).
    ;
    ; ★ The last term's `ast.IsFunctionLikeDeclaration(node)` guard is what keeps a
    ; CallSignature or a FunctionType — which have no body — out of the use-strict
    ; check; the two kinds that would reach it with a body and are not function-like
    ; DECLARATIONS do not exist.
    procedure check_grammar_function_like_declaration(this, node: ref[AstNode]) returns bool
    {
        if this.check_grammar_modifiers(node)
            return true
        if this.check_grammar_type_parameter_list(AstNode.type_parameters_of(node))
            return true
        if this.check_grammar_parameter_list(AstNode.parameters_of(node))
            return true
        if this.check_grammar_arrow_function(node)
            return true
        if AstNode.is_function_like_declaration(node) = false
            return false
        this.check_grammar_for_use_strict_simple_parameter_list(node)
    }

    ; ── slice 62: the grammar of a type MEMBER ───────────────────────────────
    ;
    ; ★★★ THE ONE TERM NEITHER checkGrammarProperty NOR checkGrammarMethod CAN
    ; ANSWER, AND IT IS THE SAME TERM FIVE TIMES. `isNonBindableDynamicName` is
    ; `ast.IsDynamicName(node) && !c.isLateBindableName(node)`, and the right
    ; conjunct resolves the computed name's EXPRESSION — checkComputedPropertyName
    ; for a `[…]` name, checkExpressionCached for an element access — so it is the
    ; type dimension, one call deep, in a function whose other five reports are
    ; purely syntactic.
    ;
    ; ★★★ THE `&&` SHORT-CIRCUITS, WHICH IS WHY THE REPORT IS NARROW RATHER THAN
    ; PER MEMBER. Every member whose name is a plain identifier, a string, a number
    ; or a computed name over a LITERAL answers false at `IsDynamicName` and asks
    ; nothing — so the hole is exactly `[expr]` with a non-literal expr, which the
    ; binder already decides for its own late-binding (`b.is_dynamic_name`, ported
    ; in slice 30 and read here rather than written again).
    ;
    ; ★★★ AND IT ANSWERS **TRUE**, WHICH IS THE DIRECTION THAT SUPPRESSES. Every
    ; caller reads a true as *I have reported* and stops — so a true costs
    ; diagnostics and a false invents them: `checkGrammarProperty` would go on to
    ; the ambient initializer and the definite-assignment block, `checkGrammarMethod`
    ; to the computed-property-name check and the generator-constructor report, and
    ; diagcheck's relation is a SUBSEQUENCE, which forgives a missing line and fails
    ; on an invented one. §3.5cw's rule read from the other end: where the port
    ; cannot decide, pick the branch that speaks LESS.
    ; ★★★ SLICE 124: isLateBindableName IS PORTED, SO THE FUNCTION ANSWERS. The
    ; note that stood here said `IsEntityNameExpression(expression)` — *the term
    ; that decides whether the report actually fires* — sat behind a stop and the
    ; answer was unknowable; it is knowable now, and the shape below is why the old
    ; §3.5cw compromise (return the branch that speaks LESS) mattered: the honest
    ; answer is FALSE for every late-bindable name, i.e. the report fires on
    ; strictly fewer names than the stop's `true` claimed.
    procedure is_non_bindable_dynamic_name(this, node: ref[AstNode]?) returns bool
    {
        if b.is_dynamic_name(node) = false
            return false
        if this.is_late_bindable_name(node as ref[AstNode])
            return false
        true
    }

    procedure check_grammar_for_invalid_dynamic_name(this, node: ref[AstNode]?, code: int) returns bool
    {
        if this.is_non_bindable_dynamic_name(node) = false
            return false
        let n node as ref[AstNode]
        var expression null as ref[AstNode]?
        if AstNode.kind_of(n) = KindElementAccessExpression
        {
            let arg AstNode.element_access_argument_of(n)
            if arg <> null
                set expression: Checker.skip_parentheses(arg as ref[AstNode])
        }
        else
            set expression: AstNode.expression_of(n)
        if expression = null
            return false
        if Checker.is_entity_name_expression(expression as ref[AstNode])
            return false
        this.grammar_error_on_node(n, code)
    }

    ; checkGrammarComputedPropertyName, whole. Two lines: a kind test that makes the
    ; function a no-op for every name that is not computed, and one report about a
    ; COMMA expression inside the brackets.
    ;
    ; ★ It is NOT the dynamic-name check above and the two must not be confused: this
    ; one is decided by the expression's own kind and reports on the EXPRESSION,
    ; while that one needs the expression's TYPE and reports on the NAME. The
    ; reference calls them from the same `if`, which is what makes the pair look like
    ; one question.
    procedure check_grammar_computed_property_name(this, node: ref[AstNode]?) returns bool
    {
        if Checker.kind_or_unknown(node) <> KindComputedPropertyName
            return false
        let expr AstNode.expression_of(node)
        if Checker.kind_or_unknown(expr) <> KindBinaryExpression
            return false
        if AstNode.binary_operator_kind(expr) <> KindCommaToken
            return false
        this.grammar_error_on_node(expr, DiagA_comma_expression_is_not_allowed_in_a_computed_property_name)
    }

    ; checkGrammarForInvalidQuestionMark and checkGrammarForInvalidExclamationToken,
    ; both whole and both one line: the POSTFIX slot holds a `?` or a `!` and the
    ; caller says which of the two it forbids and with which message. ast.scaly's
    ; question_token_of explains why the slot has to be tested for its kind rather
    ; than read.
    procedure check_grammar_for_invalid_question_mark(this, postfix_token: ref[AstNode]?, code: int) returns bool
    {
        if postfix_token = null
            return false
        if AstNode.kind_of(postfix_token) <> KindQuestionToken
            return false
        this.grammar_error_on_node(postfix_token, code)
    }

    procedure check_grammar_for_invalid_exclamation_token(this, postfix_token: ref[AstNode]?, code: int) returns bool
    {
        if postfix_token = null
            return false
        if AstNode.kind_of(postfix_token) <> KindExclamationToken
            return false
        this.grammar_error_on_node(postfix_token, code)
    }

    ; checkGrammarForGenerator, whole — the `*` of a generator in a place a body
    ; cannot follow.
    ;
    ; ★★★ IT WAS NAMED AND NOT WRITTEN BY SLICE 52, at check_function_declaration's
    ; own header: *checkGrammarForGenerator … follows the line above, so it is not
    ; reached; named here rather than left out so that the slice which retires the
    ; report above finds it already written down*. It is written now for a different
    ; caller — checkGrammarMethod, whose call is in FRONT of every stop — and the
    ; note there still holds unchanged: a function declaration still stops before it.
    ;
    ; ★ The reference reads the asterisk off `node.BodyData()` and panics for a kind
    ; that has none; `asterisk_token_of` answers null for exactly those kinds, so the
    ; nil test and the panic collapse into one null test (§3.5bk).
    procedure check_grammar_for_generator(this, node: ref[AstNode]) returns bool
    {
        let asterisk AstNode.asterisk_token_of(node)
        if asterisk = null
            return false
        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            return this.grammar_error_on_node(asterisk, DiagGenerators_are_not_allowed_in_an_ambient_context)
        if AstNode.body_of(node) <> null
            return false
        this.grammar_error_on_node(asterisk, DiagAn_overload_signature_cannot_be_declared_as_a_generator)
    }

    ; checkGrammarProperty, whole. Its shape is a three-way branch on the PARENT —
    ; a class, an interface, a type literal — and the parent is what decides both
    ; which message a computed name gets and whether an initializer is admitted at
    ; all.
    ;
    ; ★★★ THE FIRST REPORT IS ABOUT A NODE THAT IS NOT THIS ONE, and it is the
    ; reason `member_list_of` exists in ast.scaly today: `{ [K in T]: U; x: number }`
    ; parses as a MAPPED type with a recovery member list, so a property whose
    ; computed name is a binary `in` expression reports on `node.Parent.Members()[0]`
    ; — the first member of the container, which need not be this property. ★It is
    ; the same diagnostic checkGrammarMappedType reports at the same node (slice 61),
    ; and the two are separate paths to it rather than one: that one fires for a
    ; mapped type WITH members, this one for a property whose own name carries the
    ; `in`.
    ;
    ; ★★★ THE TWO `panic`s ARE NOT PORTED AND THE ARGUMENT IS ABOUT THE PARSER, not
    ; about a guess: `!ast.IsPropertySignatureDeclaration(node)` inside the interface
    ; and type-literal branches dies on a PropertyDeclaration there, and neither
    ; container's member production can build one — parseTypeMember has five member
    ; forms and a property DECLARATION is not among them. So the population is empty
    ; and what stands in its place is the initializer report the reference reaches
    ; after it.
    ;
    ; ★★ THE `!` BLOCK IS PropertyDeclaration-ONLY AND IS THEREFORE INERT TODAY, in
    ; the shape slice 60's type-parameter arm was: nothing walks a class's members
    ; yet, so no PropertyDeclaration reaches this function. It is transcribed because
    ; the arm it belongs to is transcribed, and because a definite-assignment
    ; assertion is where a property's postfix slot stops being a `?`.
    ;
    ; ★ `IsAutoAccessorPropertyDeclaration` is `IsPropertyDeclaration && HasAccessorModifier`
    ; — so it is inert for the same reason, and it is the only reader of
    ; ModifierFlagsAccessor in this file.
    procedure check_grammar_property(this, node: ref[AstNode]) returns bool
    {
        let property_name AstNode.name_of(node)
        let parent AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(property_name) = KindComputedPropertyName
        {
            let expr AstNode.expression_of(property_name)
            if Checker.kind_or_unknown(expr) = KindBinaryExpression
            {
                if AstNode.binary_operator_kind(expr) = KindInKeyword
                    return this.grammar_error_on_node(AstNode.child_in_list(AstNode.member_list_of(parent), 0), DiagA_mapped_type_may_not_declare_properties_or_methods)
            }
        }
        let k AstNode.kind_of(node)
        if Parser.is_class_like_node(parent)
        {
            if Checker.kind_or_unknown(property_name) = KindStringLiteral
            {
                if Checker.literal_text_equals(property_name, "constructor")
                    return this.grammar_error_on_node(property_name, DiagClasses_may_not_have_a_field_named_constructor)
            }
            if this.check_grammar_for_invalid_dynamic_name(property_name, DiagA_computed_property_name_in_a_class_property_declaration_must_have_a_simple_literal_type_or_a_unique_symbol_type)
                return true
            if k = KindPropertyDeclaration
            {
                if b.has_syntactic_modifier(node, ModifierFlagsAccessor)
                {
                    if this.check_grammar_for_invalid_question_mark(AstNode.postfix_token_of(node), DiagAn_accessor_property_cannot_be_declared_optional)
                        return true
                }
            }
        }
        else
        {
            let pk Checker.kind_or_unknown(parent)
            if pk = KindInterfaceDeclaration
            {
                if this.check_grammar_for_invalid_dynamic_name(property_name, DiagA_computed_property_name_in_an_interface_must_refer_to_an_expression_whose_type_is_a_literal_type_or_a_unique_symbol_type)
                    return true
                let initializer AstNode.initializer_of(node)
                if initializer <> null
                    return this.grammar_error_on_node(initializer, DiagAn_interface_property_cannot_have_an_initializer)
            }
            if pk = KindTypeLiteral
            {
                if this.check_grammar_for_invalid_dynamic_name(property_name, DiagA_computed_property_name_in_a_type_literal_must_refer_to_an_expression_whose_type_is_a_literal_type_or_a_unique_symbol_type)
                    return true
                let initializer AstNode.initializer_of(node)
                if initializer <> null
                    return this.grammar_error_on_node(initializer, DiagA_type_literal_property_cannot_have_an_initializer)
            }
        }

        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            this.check_ambient_initializer(node)

        if k = KindPropertyDeclaration
        {
            let postfix AstNode.postfix_token_of(node)
            if Checker.kind_or_unknown(postfix) = KindExclamationToken
            {
                if AstNode.initializer_of(node) <> null
                    return this.grammar_error_on_node(postfix, DiagDeclarations_with_initializers_cannot_also_have_definite_assignment_assertions)
                if AstNode.type_of(node) = null
                    return this.grammar_error_on_node(postfix, DiagDeclarations_with_definite_assignment_assertions_must_also_have_type_annotations)
                var out_of_context false
                if Parser.is_class_like_node(parent) = false
                    set out_of_context: true
                if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
                    set out_of_context: true
                if b.is_static(node)
                    set out_of_context: true
                if b.has_syntactic_modifier(node, ModifierFlagsAbstract)
                    set out_of_context: true
                if out_of_context
                    return this.grammar_error_on_node(postfix, DiagA_definite_assignment_assertion_is_not_permitted_in_this_context)
            }
        }

        false
    }

    ; The literal twin of identifier_text_equals — same loop, the other text slot.
    ; ast.scaly's literal_text_of header says why the two cannot be one function.
    function literal_text_equals(n: ref[AstNode]?, s: Slice[char]) returns bool
    {
        if AstNode.literal_text_length_of(n) <> s.length
            return false
        let t AstNode.literal_text_of(n)
        if t.data = null
            return false
        var i 0
        while i < s.length
        {
            if (t[i] as int) <> ((s[i] as char) as int)
                return false
            set i: i + 1
        }
        true
    }

    ; checkGrammarMethod, whole. Its first line is the function-like grammar check
    ; and the rest is a branch on the PARENT, exactly as checkGrammarProperty's is —
    ; and the messages differ per container for the same reason.
    ;
    ; ★★★ THE WHOLE MIDDLE BLOCK IS MethodDeclaration-ONLY AND IS INERT TODAY: an
    ; object literal's methods are reached through checkExpression and a class's
    ; through a members walk, and neither is ported. It is transcribed because the
    ; arm is (slice 60's argument for the type-parameter row), and because one of its
    ; reports is the only place in this file that reports on a `}` that is not
    ; there — `grammarErrorAtPos(node, node.End()-1, len(";"), X_0_expected, "{")`,
    ; a one-character span at the semicolon that stands where a body should be.
    ;
    ; ★★ THE class-like BRANCH ASKS TWO DIFFERENT QUESTIONS AND ONLY ONE OF THEM IS
    ; REACHABLE FROM A SIGNATURE. The ambient half is about a computed name in a
    ; `declare class`, the overload half about a method DECLARATION with no body; a
    ; MethodSignature in a class body is not a thing the parser builds, so what
    ; reaches this function today is the interface and the type-literal branch.
    ;
    ; ★ The reference's own comment on the class-like branch is worth keeping: the
    ; computed-name restriction is technically about property declarations and
    ; accessors too, and it lands here because those two disallow computed names
    ; outright and accessors are refused in ambient contexts anyway.
    procedure check_grammar_method(this, node: ref[AstNode]) returns bool
    {
        if this.check_grammar_function_like_declaration(node)
            return true
        let k AstNode.kind_of(node)
        let parent AstNode.parent_node_of(node)
        let pk Checker.kind_or_unknown(parent)
        if k = KindMethodDeclaration
        {
            if pk = KindObjectLiteralExpression
            {
                ; We only disallow a modifier on a method declaration when it is a
                ; property of an object literal — and `async` alone is admitted, so
                ; the test is on the LIST rather than on the presence of modifiers.
                ; `modifiers != nil && !(len == 1 && Nodes[0] == async)` — and the
                ; test is on the LIST being PRESENT rather than on it being
                ; non-empty, which is the reference's own spelling. The parser
                ; leaves the slot null when there are no modifiers, so the two
                ; readings coincide on every tree it builds; the null test is
                ; transcribed because it is the one the reference makes.
                let modifiers AstNode.modifiers_of(node)
                if modifiers <> null
                {
                    var only_async false
                    if AstNode.list_count(modifiers) = 1
                    {
                        if AstNode.kind_of(AstNode.child_in_list(modifiers, 0)) = KindAsyncKeyword
                            set only_async: true
                    }
                    if only_async = false
                        return this.grammar_error_on_first_token(node, DiagModifiers_cannot_appear_here)
                }
                let postfix AstNode.postfix_token_of(node)
                if this.check_grammar_for_invalid_question_mark(postfix, DiagAn_object_member_cannot_be_declared_optional)
                    return true
                if this.check_grammar_for_invalid_exclamation_token(postfix, DiagA_definite_assignment_assertion_is_not_permitted_in_this_context)
                    return true
                if AstNode.body_of(node) = null
                    return this.grammar_error_at_pos(node, AstNode.end_of(node) - 1, 1, DiagX_0_expected, "{")
            }
            if this.check_grammar_for_generator(node)
                return true
        }
        let name AstNode.name_of(node)
        if Parser.is_class_like_node(parent)
        {
            if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
                return this.check_grammar_for_invalid_dynamic_name(name, DiagA_computed_property_name_in_an_ambient_context_must_refer_to_an_expression_whose_type_is_a_literal_type_or_a_unique_symbol_type)
            if k = KindMethodDeclaration
            {
                if AstNode.body_of(node) = null
                    return this.check_grammar_for_invalid_dynamic_name(name, DiagA_computed_property_name_in_a_method_overload_must_refer_to_an_expression_whose_type_is_a_literal_type_or_a_unique_symbol_type)
            }
            return false
        }
        if pk = KindInterfaceDeclaration
            return this.check_grammar_for_invalid_dynamic_name(name, DiagA_computed_property_name_in_an_interface_must_refer_to_an_expression_whose_type_is_a_literal_type_or_a_unique_symbol_type)
        if pk = KindTypeLiteral
            return this.check_grammar_for_invalid_dynamic_name(name, DiagA_computed_property_name_in_a_type_literal_must_refer_to_an_expression_whose_type_is_a_literal_type_or_a_unique_symbol_type)
        false
    }

    ; ── slice 56: checkGrammarBindingElement ─────────────────────────────────
    ;
    ; Four reports, all of them about the REST element, and the whole function is
    ; behind `node.DotDotDotToken != nil` — so a binding element without a `...`
    ; runs the two tests and answers false, which is what the overwhelming
    ; majority of the corpus's binding elements do.
    ;
    ; ★★★ THE SECOND `if node.DotDotDotToken != nil` IS EQUIVALENT TO FOLDING IT
    ; INTO THE FIRST, AND SAYING SO IS THE POINT. The first draft of this comment
    ; claimed the opposite — that the two blocks must be kept apart or a report
    ; would move — and it is wrong: every path out of the first block that skips
    ; the second is a `return`, so the initializer test is reached in exactly the
    ; same states either way. The two are kept apart because that is the
    ; reference's shape and this is a transcription, NOT because behaviour depends
    ; on it, and control g8 is the row that says so with a number. ★It is worth
    ; the paragraph because §3.5cz's merge lesson makes the opposite reflex
    ; cheap — *a merge is sound only while what lies between is dead* — and here
    ; nothing lies between at all. **The lesson has a converse: a shape that must
    ; be transcribed for fidelity is not thereby a shape that carries a defect.**
    ;
    ; ★★ THE TRAILING-COMMA CHECK'S RESULT IS DISCARDED, exactly as upstream
    ; discards it, and it sits BETWEEN two returning reports — so `[...r,]` inside
    ; a pattern can collect TWO diagnostics (the comma and, if the rest element
    ; also carries a property name, TS2566). Reading the block as a chain would
    ; drop the second, which is checkGrammarParameterList's discarded result
    ; (slice 52) in the same position.
    ;
    ; ★★ THE INITIALIZER REPORT IS grammarErrorAtPos AND ITS SPAN IS THE `=`, one
    ; character at `initializer.Pos() - 1`. That is a span NO NODE has, which is
    ; the reason that reporter exists (§3.5cw) — and the reference's own comment
    ; says so at the line: *Error on equals token which immediately precedes the
    ; initializer*. ★★AND THE SUBTRACTION IS WHITESPACE-INDEPENDENT, which the
    ; first draft of this line got backwards: `Pos()` is the FULL start, i.e. the
    ; END of the previous token, and the previous token IS the `=`, so `Pos() - 1`
    ; is its last character however much space follows. That is what lets the
    ; reference do this arithmetic without a scan;
    ; checker_binding_element_rest_initializer.ts spaces one line out and packs
    ; another to show it.
    ;
    ; ★ `node.Parent.ElementList()` is the parent PATTERN's element list, read
    ; through elements_of, which answers for both binding-pattern kinds. A binding
    ; element's parent is always one of the two, so the null direction is
    ; unreachable rather than tolerated — and list_count/child_in_list answer 0 and
    ; null for it, which makes `node <> last` true and the first report fire, i.e.
    ; the loud direction.
    procedure check_grammar_binding_element(this, node: ref[AstNode]) returns bool
    {
        let dot_dot_dot AstNode.dot_dot_dot_token_of(node)
        if dot_dot_dot <> null
        {
            let elements AstNode.elements_of(AstNode.parent_node_of(node))
            let n AstNode.list_count(elements)
            var last: ref[AstNode]? null
            if n > 0
                set last: AstNode.child_in_list(elements, n - 1)
            if node <> last
                return this.grammar_error_on_node(node, DiagA_rest_element_must_be_last_in_a_destructuring_pattern)
            this.check_grammar_for_disallowed_trailing_comma(elements, DiagA_rest_parameter_or_binding_pattern_may_not_have_a_trailing_comma)
            if AstNode.property_name_of(node) <> null
                return this.grammar_error_on_node(AstNode.name_of(node), DiagA_rest_element_cannot_have_a_property_name)
        }
        if dot_dot_dot <> null
        {
            let initializer AstNode.initializer_of(node)
            if initializer <> null
                return this.grammar_error_at_pos(node, AstNode.pos_of(initializer) - 1, 1, DiagA_rest_element_cannot_have_an_initializer)
        }
        false
    }

    ; ── slice 54: the variable DECLARATION's grammar ─────────────────────────
    ;
    ; checkGrammarVariableDeclaration, whole and COMPLETE except for one term of
    ; checkAmbientInitializer's disjunction, named at its line. Five steps, and
    ; four of them are a `return` of a report, so the order below is the
    ; reference's rather than a convenience.
    ;
    ; ★★★ THE `__esModule` TERM IS REACHABLE, AND WHAT MAKES IT SO IS THE STUB
    ; PROGRAM'S ANSWER RATHER THAN THE REAL COMPILER'S — WHICH CORRECTS A CLAIM
    ; THIS FILE HAS CARRIED SINCE SLICE 49. Two places above say
    ; `program.GetEmitModuleFormatOfFile … the stub program does not have` / `does
    ; not answer`; it HAS it and it answers `core.ModuleKindNone`, i.e. **0**. The
    ; guard is `< core.ModuleKindSystem`, and System is **4**, so the term is
    ; TRUE for every file under this harness. Not merely reachable in principle —
    ; measured on the way in: `export var __esModule = 1` gets TS1216 out of the
    ; reference, and so does `export var [__esModule] = [1]`.
    ;
    ; ★★★ AND THE REAL COMPILER WOULD ANSWER THE OTHER WAY, which is why reading
    ; the reference's implementation instead of the ORACLE would have got this
    ; backwards. `GetEmitModuleFormatOfFile` there is `GetEmitModuleKind()` when
    ; the file's implied format is None — and with `Module` unset that is
    ; `GetEmitScriptTarget()` = ES2025 ⇒ **ModuleKindES2022 = 7**, and `7 < 4` is
    ; false. So this is a FIFTH reading of an unset option to set beside §3.5cw's
    ; three and §3.5cx's fourth, and it is a different KIND of reading: the value
    ; comes from the harness's stub, not from the option's default, and the two
    ; disagree. The rule that falls out of it: **an option's default is read from
    ; the constructor, but a PROGRAM's answer is read from the program the oracle
    ; builds** — tests/oracle/types.go, not internal/compiler/program.go.
    ;
    ; ★★ THE CONJUNCTION IS NOT REORDERED and does not need to be. Because the
    ; first term is a constant true here it is written as the comment it is, with
    ; the value that makes it true, and the two terms that can actually vary are
    ; asked. A port that had reported unported on the program layer would have
    ; buried a live report behind a hole that is not there.
    ;
    ; ★★ THE DEFINITE-ASSIGNMENT TERM IS THE ONE REPORT OF THIS FUNCTION THAT IS
    ; NOT ON THE DECLARATION. `grammarErrorOnNode(node.ExclamationToken, …)` points
    ; at the token, and error_range_for_node has no arm for a token kind, so the
    ; span is the token's own trivia-skipped start — which is what the reference's
    ; TS1263 at the `!` of `let b!: number = 1` measures.
    ;
    ; ★ The three-way message choice collapses to three CODES and no argument, so
    ; §3.5ct's argument applies unchanged: the dump is `C pos end code`.
    procedure check_grammar_variable_declaration(this, node: ref[AstNode]) returns bool
    {
        let node_flags Binder.combined_node_flags(node)
        let block_scope_kind node_flags & NodeFlagsBlockScoped
        let name AstNode.name_of(node)
        if AstNode.is_binding_pattern(name)
        {
            if block_scope_kind = NodeFlagsAwaitUsing
                return this.grammar_error_on_node(node, DiagX_0_declarations_may_not_have_binding_patterns, "await using")
            if block_scope_kind = NodeFlagsUsing
                return this.grammar_error_on_node(node, DiagX_0_declarations_may_not_have_binding_patterns, "using")
        }

        let parent AstNode.parent_node_of(node)
        var grandparent: ref[AstNode]? null
        if parent <> null
            set grandparent: AstNode.parent_node_of(parent)
        let gk Checker.kind_or_unknown(grandparent)
        var in_for_in_or_of false
        if gk = KindForInStatement
            set in_for_in_or_of: true
        if gk = KindForOfStatement
            set in_for_in_or_of: true

        let initializer AstNode.initializer_of(node)
        let type_node AstNode.type_of(node)
        if in_for_in_or_of = false
        {
            if (node_flags & NodeFlagsAmbient) <> 0
            {
                ; The result is DISCARDED here, as it is upstream — the flow past
                ; this point does not depend on it — so an unported report inside
                ; does not stop the three checks below either.
                this.check_ambient_initializer(node)
            }
            else
            {
                if initializer = null
                {
                    if AstNode.is_binding_pattern(name)
                    {
                        if AstNode.is_binding_pattern(parent) = false
                            return this.grammar_error_on_node(node, DiagA_destructuring_declaration_must_have_an_initializer)
                    }
                    if block_scope_kind = NodeFlagsAwaitUsing
                        return this.grammar_error_on_node(node, DiagX_0_declarations_must_be_initialized, "await using")
                    if block_scope_kind = NodeFlagsUsing
                        return this.grammar_error_on_node(node, DiagX_0_declarations_must_be_initialized, "using")
                    if block_scope_kind = NodeFlagsConst
                        return this.grammar_error_on_node(node, DiagX_0_declarations_must_be_initialized, "const")
                }
            }
        }

        let exclamation_token AstNode.exclamation_token_of(node)
        if exclamation_token <> null
        {
            var not_permitted false
            if gk <> KindVariableStatement
                set not_permitted: true
            if type_node = null
                set not_permitted: true
            if initializer <> null
                set not_permitted: true
            if (node_flags & NodeFlagsAmbient) <> 0
                set not_permitted: true
            if not_permitted
            {
                if initializer <> null
                    return this.grammar_error_on_node(exclamation_token, DiagDeclarations_with_initializers_cannot_also_have_definite_assignment_assertions)
                if type_node = null
                    return this.grammar_error_on_node(exclamation_token, DiagDeclarations_with_definite_assignment_assertions_must_also_have_type_annotations)
                return this.grammar_error_on_node(exclamation_token, DiagA_definite_assignment_assertion_is_not_permitted_in_this_context)
            }
        }

        ; `c.program.GetEmitModuleFormatOfFile(sourceFile) < core.ModuleKindSystem`.
        ; The oracle's program answers ModuleKindNone = 0 and System is 4, so the
        ; term is a constant TRUE under this harness — see the header above, and
        ; note that it is the ORACLE's answer and not the real compiler's.
        if grandparent <> null
        {
            if ((AstNode.flags_of(grandparent) & NodeFlagsAmbient) = 0) and (this.file_emit_format_of(Checker.source_file_of_node(node)) < ModuleKindSystem)
            {
                if b.has_syntactic_modifier(grandparent, ModifierFlagsExport)
                {
                    this.check_grammar_for_es_module_marker_in_binding_name(name)
                }
            }
        }

        if block_scope_kind = 0
            return false
        this.check_grammar_name_in_let_or_const_declarations(name)
    }

    ; checkGrammarForEsModuleMarkerInBindingName, whole.
    ;
    ; ★★★ IT RETURNS OUT OF THE LOOP ON THE FIRST ELEMENT THAT HAS A NAME, which
    ; is upstream's `return` inside the `for` and not a `continue` — so a pattern
    ; whose first named element is innocent hides a `__esModule` behind it. That is
    ; transcribed rather than tidied: it is the reference's answer, and the
    ; measurement that fixed the shape of this function is the same probe as the
    ; header's — `export var { __esModule: q } = …` gets NO report, because a
    ; binding element's NAME is `q` and the property name is not asked.
    procedure check_grammar_for_es_module_marker_in_binding_name(this, name: ref[AstNode]?) returns bool
    {
        if name = null
            return false
        if AstNode.kind_of(name) = KindIdentifier
        {
            if Checker.identifier_text_equals(name, "__esModule")
                return this.grammar_error_on_node_skipped_on_no_emit(name, DiagIdentifier_expected_esModule_is_reserved_as_an_exported_marker_when_transforming_ECMAScript_modules)
            return false
        }
        let elements AstNode.elements_of(name)
        var i 0
        let n AstNode.list_count(elements)
        while i < n
        {
            let element AstNode.child_in_list(elements, i)
            set i: i + 1
            let en AstNode.name_of(element)
            if en <> null
                return this.check_grammar_for_es_module_marker_in_binding_name(en)
        }
        false
    }

    ; grammarErrorOnNodeSkippedOnNoEmit, whole. It is grammar_error_on_node plus
    ; `d.SetSkippedOnNoEmit()`, a flag the emitter reads to drop the diagnostic
    ; when nothing is emitted.
    ;
    ; ★★ THE FLAG IS NOT CARRIED, AND THAT IS A MEASUREMENT RATHER THAN A SHRUG.
    ; The oracle prints every line `c.GetDiagnostics` answers, and GetDiagnostics
    ; does not filter on it — so a skipped-on-no-emit diagnostic is in the C
    ; section like any other, which is how the reference's TS1216 was seen at all.
    ; The flag becomes observable on the day something in this repository EMITS,
    ; and until then a field for it would be a field nothing reads.
    procedure grammar_error_on_node_skipped_on_no_emit_with(this, n: ref[AstNode], code: int, args: ref[Array[String]]?) returns bool
    {
        if checker_no_emit
        {
            if this.has_parse_diagnostics_of(n)
                return false
            return true
        }
        this.grammar_error_on_node_with(n, code, args)
    }

    ; errorSkippedOnNoEmit
    procedure error_skipped_on_no_emit_with(this, n: ref[AstNode]?, code: int, args: ref[Array[String]]?)
    {
        if checker_no_emit = false
            this.error_on_node_with(n, code, args)
    }

    ; checkGrammarNameInLetOrConstDeclarations, whole.
    ;
    ; ★★ IT ALWAYS ANSWERS FALSE FOR A PATTERN and true only for a bare `let`, and
    ; the asymmetry is upstream's: the recursion's result is DISCARDED, so a
    ; pattern reports once per offending element and still answers false to its
    ; caller. That is the opposite discipline to the `__esModule` walk above, four
    ; lines away in the reference, and the two are deliberately not unified.
    ;
    ; ★ The text test is against the SPELLING `let`, not against the keyword's
    ; token kind: this position is an identifier by the time the parser is done
    ; with it (`let let = 1` parses), so what is left is a name comparison.
    procedure check_grammar_name_in_let_or_const_declarations(this, name: ref[AstNode]?) returns bool
    {
        if name = null
            return false
        if AstNode.kind_of(name) = KindIdentifier
        {
            if Checker.identifier_text_equals(name, "let")
                return this.grammar_error_on_node(name, DiagX_let_is_not_allowed_to_be_used_as_a_name_in_let_or_const_declarations)
            return false
        }
        let elements AstNode.elements_of(name)
        var i 0
        let n AstNode.list_count(elements)
        while i < n
        {
            let element AstNode.child_in_list(elements, i)
            set i: i + 1
            let en AstNode.name_of(element)
            if en <> null
                this.check_grammar_name_in_let_or_const_declarations(en)
        }
        false
    }

    ; An identifier's stored text against a FIXED ASCII spelling. The reference
    ; writes `name.Text() == "__esModule"`; this port keeps an identifier's text as
    ; (buffer, length) rather than as a String, so the compare is a length test and
    ; a byte loop.
    ;
    ; ★ BYTES rather than runes, and it is exact: both spellings are ASCII, and the
    ; stored text is already the ESCAPE-DECODED value, so `let`
    ; arrives here as `let` and compares equal — which is the reference's answer
    ; too, since it compares the same decoded text.
    function identifier_text_equals(n: ref[AstNode]?, s: Slice[char]) returns bool
    {
        if AstNode.identifier_text_length_of(n) <> s.length
            return false
        let t AstNode.identifier_text_of(n)
        if t.data = null
            return false
        var i 0
        while i < s.length
        {
            if (t[i] as int) <> ((s[i] as char) as int)
                return false
            set i: i + 1
        }
        true
    }

    ; checkAmbientInitializer, whole for the ONE kind this slice reaches. The
    ; reference's switch has three arms (VariableDeclaration, PropertyDeclaration,
    ; PropertySignature) over two accessors each, and both accessors here answer for
    ; all three kinds already (`type_of`, `initializer_of`), so the switch collapses
    ; to nothing.
    ;
    ; ★ The `default: panic` goes with it, and the argument is about the CALLERS
    ; rather than the accessors: this function has exactly three call sites and each
    ; passes one of those three kinds, so the panic's population is empty. It is not
    ; that the accessors could not be handed a fourth kind — they would answer null
    ; and this would return false where the reference dies — it is that nothing
    ; hands them one.
    ;
    ; ★★★ ONE TERM OF THE FIVE-WAY DISJUNCTION NEEDS THE TYPE MACHINERY, AND THE
    ; WHOLE CORPUS REACHES IT ONCE — IN ITS OWN FIXTURE.
    ; `isInitializerSimpleLiteralEnumReference` asks
    ; `checkExpressionCached(expr).flags & EnumLike` — but only for a PROPERTY
    ; ACCESS or an ELEMENT ACCESS, so for every other initializer shape the term is
    ; false without asking anything, and the disjunction is decided by the four
    ; kind tests around it. An ambient const initialized from a property access is
    ; rare enough that `is-initializer-simple-literal-enum-reference` is **1 unit
    ; of 17 863** on stage 2 and that unit is
    ; `checker_variable_ambient_initializer_enum_ref.d.ts` — the fixture IS the
    ; corpus here (§3.5cw's use-strict-prologue shape).
    ;
    ; ★★ IT IS A REPORT AND NOT A `return false`, AND THE BATTERY IS WHY. Guessing
    ; *not an enum reference* agrees with the reference on every unit in reach —
    ; controls-slice54.sh's f13 makes that guess and comes back UNGATED — because no
    ; ambient const in the corpus is initialized from a real enum member. A guess
    ; that no instrument can distinguish from a port is the most expensive kind, so
    ; the term reports. Measured on the way in: `declare namespace P { const g =
    ; N.a }` gets TS1254 out of the reference, so the far side of the hole is real.
    ;
    ; ★★ THE HOLE IS ASKED IN THE PLACE THE ANSWER IS USED, not where the reference
    ; computes it. Upstream evaluates `isInvalidInitializer` eagerly and then throws
    ; it away in the else branch — where the report is TS1039 whatever the
    ; initializer is — so asking it only inside the const-and-untyped branch is the
    ; same answer with one fewer way to be wrong. What that costs is the
    ; checkExpressionCached CALL, which can report at its own sites; those are the
    ; expression dimension and are unported everywhere, so no line of ours moves.
    ;
    ; ★ `isConstOrReadonly` reads `readonly` through the COMBINED modifier flags, so
    ; a `readonly` the grammar has already refused on a variable statement still
    ; sets it — which is why the term is not simplified away for a kind that cannot
    ; carry the modifier legally.
    procedure check_ambient_initializer(this, node: ref[AstNode]) returns bool
    {
        let initializer AstNode.initializer_of(node)
        if initializer = null
            return false
        let type_node AstNode.type_of(node)
        var is_const_or_readonly false
        if this.is_declaration_readonly(node)
            set is_const_or_readonly: true
        if AstNode.kind_of(node) = KindVariableDeclaration
        {
            if this.is_var_const_like(node)
                set is_const_or_readonly: true
        }
        if is_const_or_readonly = false
            return this.grammar_error_on_node(initializer, DiagInitializers_are_not_allowed_in_ambient_contexts)
        if type_node <> null
            return this.grammar_error_on_node(initializer, DiagInitializers_are_not_allowed_in_ambient_contexts)

        if Binder.is_string_or_numeric_literal_like(initializer)
            return false
        if Checker.is_initializer_signed_numeric_literal(initializer)
            return false
        let ik AstNode.kind_of(initializer)
        if ik = KindTrueKeyword
            return false
        if ik = KindFalseKeyword
            return false
        if Checker.is_initializer_bigint_literal_expression(initializer)
            return false
        ; isInitializerSimpleLiteralEnumReference — ANSWERABLE SINCE SLICE 116,
        ; because its whole content is `checkExpressionCached(expr).flags&EnumLike`
        ; and nothing could carry that flag before the enum chapter. It is false
        ; for every initializer that is not one of these two kinds, which is why
        ; the term is asked here and nowhere wider.
        ;
        ; ★★★ THE POLARITY WAS INVERTED HERE UNTIL SLICE 142, AND THE UNIT THAT
        ; WITNESSES IT WAS UNPORTED FOR AN UNRELATED REASON — which is the whole
        ; reason it stood. Every arm above is a term of the reference's
        ; `isInvalidInitializer = !(A || B || C || D || E)`, so a term that HOLDS
        ; means *not invalid* (`return false`, no report) and a term that FAILS
        ; must fall through to the TS1254 below. These two arms did neither: they
        ; RETURNED the term, so an enum reference answered *a grammar error was
        ; reported* and a non-enum property access answered *nothing to report* —
        ; both backwards, and both silent. The fixture
        ; `checker_variable_ambient_initializer_enum_ref.d.ts` is the deferred
        ; witness slice 54 wrote for exactly this line; it turned from UNPORTED
        ; into a two-diagnostic FAIL the moment slice 142 retired the stop that
        ; used to be reached first (§3.5cw's shadowed-by-the-walk shape, from the
        ; other side).
        var simple_enum_reference false
        if ik = KindPropertyAccessExpression
            set simple_enum_reference: this.is_initializer_simple_literal_enum_reference(initializer)
        if ik = KindElementAccessExpression
        {
            if Checker.is_initializer_string_or_number_literal_expression(AstNode.element_access_argument_of(initializer))
            {
                if Parser.is_entity_name_expression(AstNode.expression_of(initializer))
                    set simple_enum_reference: this.is_initializer_simple_literal_enum_reference(initializer)
            }
        }
        if simple_enum_reference
            return false
        this.grammar_error_on_node(initializer, DiagA_const_initializer_in_an_ambient_context_must_be_a_string_or_numeric_literal_or_literal_enum_reference)
    }

    ; isInitializerSimpleLiteralEnumReference's shared tail — the type test both
    ; of its arms end in. It is a `function` and not a term inlined twice because
    ; the element-access arm guards it with two more conditions and the property
    ; one with none.
    procedure is_initializer_simple_literal_enum_reference(this, expr: ref[AstNode]) returns bool
    {
        let t this.check_expression_cached(expr)
        if t = null
            return false
        ((t as ref[Type]).flags & TypeFlagsEnumLike) <> 0
    }

    ; isInitializerStringOrNumberLiteralExpression, whole — the element-access
    ; arm's first guard, and the one place this port needs it by name rather than
    ; as the two tests check_grammar_variable_declaration already writes inline.
    function is_initializer_string_or_number_literal_expression(expr: ref[AstNode]?) returns bool
    {
        if expr = null
            return false
        let e expr as ref[AstNode]
        if Binder.is_string_or_numeric_literal_like(e)
            return true
        Checker.is_initializer_signed_numeric_literal(e)
    }

    ; The second half of isInitializerStringOrNumberLiteralExpression: a PREFIX
    ; MINUS over a numeric literal. It is NOT ast.is_signed_numeric_literal, which
    ; admits a leading `+` as well — this one is minus-only, and a `+1` initializer
    ; in an ambient const IS refused by the reference.
    function is_initializer_signed_numeric_literal(expr: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(expr) <> KindPrefixUnaryExpression
            return false
        if AstNode.prefix_unary_operator_kind(expr) <> KindMinusToken
            return false
        AstNode.kind_of(AstNode.prefix_unary_operand_of(expr)) = KindNumericLiteral
    }

    ; isInitializerBigIntLiteralExpression, whole.
    function is_initializer_bigint_literal_expression(expr: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(expr) = KindBigIntLiteral
            return true
        if AstNode.kind_of(expr) <> KindPrefixUnaryExpression
            return false
        if AstNode.prefix_unary_operator_kind(expr) <> KindMinusToken
            return false
        AstNode.kind_of(AstNode.prefix_unary_operand_of(expr)) = KindBigIntLiteral
    }

    ; isDeclarationReadonly, whole. `GetCombinedModifierFlags` is the binder's
    ; has_combined_modifier — the modifier twin of combined_node_flags, and the two
    ; sit together there because upstream has them as ONE generic over the flag
    ; getter, which Scaly cannot spell (the note at combined_node_flags says so).
    function is_declaration_readonly(this, declaration: ref[AstNode]) returns bool
    {
        if b.has_combined_modifier(declaration, ModifierFlagsReadonly) = false
            return false
        b.is_parameter_property_declaration(declaration) = false
    }

    ; isVarConstLike, whole.
    function is_var_const_like(this, node: ref[AstNode]) returns bool
    {
        let block_scope_kind Binder.combined_node_flags(node) & NodeFlagsBlockScoped
        if block_scope_kind = NodeFlagsConst
            return true
        if block_scope_kind = NodeFlagsUsing
            return true
        block_scope_kind = NodeFlagsAwaitUsing
    }

    ; ── slice 53: the variable declaration list's grammar ────────────────────
    ;
    ; checkGrammarVariableDeclarationList, whole. Five terms, and each is a
    ; `return` — so the first one that reports ends the function, which is what
    ; makes the order below the reference's rather than a convenience.
    ;
    ; ★★★ THE EMPTY-LIST REPORT IS UNREACHABLE FROM THIS SLICE'S ONLY CALLER, AND
    ; SAYING SO IS THE POINT OF WRITING IT. The check fires on a list that EXISTS
    ; and has no elements, and the parser produces exactly one such list —
    ; `parse_variable_declaration_list`'s missing-list branch, for `for (let of X)`
    ; — which reaches this function only through checkForInOrForOfStatement, an arm
    ; this slice does not port. Every other empty declarations list is the
    ; delimited-list parser answering nothing, which means parse_expected reported,
    ; which means has_parse_diagnostics is true and grammar_error_at_pos answers
    ; false. So the term is transcribed, and the two other callers upstream
    ; (checkForStatement and checkGrammarForInOrForOfStatement) are what will
    ; exercise it.
    ;
    ; ★★ THE SPAN NEEDS THE LIST'S OWN RANGE, which is §3.5cv's side table again,
    ; and the missing list had no ROW until this slice. `createMissingList` is
    ; `parseEmptyNodeList` — `newNodeList(NewTextRange(p.nodePos(), p.nodePos()),
    ; nil)` — i.e. a zero-length range at the look-ahead position, and our missing
    ; branch built the Array without recording one. The row is added at the same
    ; point the reference computes it. Nothing in this port could see the
    ; difference before, which is why it had to be added by READING the reference
    ; rather than by a failing unit; the next slice is the first reader.
    ;
    ; ★★ THE AWAIT-USING TAIL IS REACHED BY THE CORPUS — 10 units of stage 2's
    ; 17 855 carry the tag, which is more than the fixture and less than a slice —
    ; AND IT ANSWERS **TRUE**, and the direction
    ; is the argument. checkGrammarAwaitOrAwaitUsing is a chapter of its own — the
    ; module kind, the implied node format of the file, IsInTopLevelContext,
    ; IsEffectiveExternalModule and a related-info attachment — and its result
    ; decides whether checkGrammarForDisallowedBlockScopedVariableStatement runs at
    ; all. Answering FALSE would run a check the reference may skip and could put a
    ; TS1156 where the reference has none, which is the one thing diagcheck can
    ; fail on. Answering true can only make our C section SHORTER, which the
    ; subsequence relation permits by construction. The unit is unported either
    ; way, so the choice costs nothing and removes a way to be wrong.
    procedure check_grammar_variable_declaration_list(this, declaration_list: ref[AstNode]?) returns bool
    {
        if declaration_list = null
            return false
        let declarations AstNode.variable_declarations_of(declaration_list)
        if this.check_grammar_for_disallowed_trailing_comma(declarations, DiagTrailing_comma_not_allowed)
            return true

        if AstNode.list_count(declarations) = 0
        {
            if this.has_parse_diagnostics_of(declaration_list)
                return false
            var lpos 0
            var lend 0
            if this.list_range_of(declarations, &lpos, &lend) = false
            {
                this.record_unported("list-range", KindVariableDeclarationList)
                return false
            }
            return this.grammar_error_at_pos(declaration_list, lpos, lend - lpos, DiagVariable_declaration_list_cannot_be_empty)
        }

        let block_scope_flags AstNode.flags_of(declaration_list) & NodeFlagsBlockScoped
        var is_using false
        if block_scope_flags = NodeFlagsUsing
            set is_using: true
        var is_await_using false
        if block_scope_flags = NodeFlagsAwaitUsing
            set is_await_using: true

        if is_using or is_await_using
        {
            let parent AstNode.parent_node_of(declaration_list)
            if Checker.kind_or_unknown(parent) = KindForInStatement
            {
                if is_using
                    return this.grammar_error_on_node(declaration_list, DiagThe_left_hand_side_of_a_for_in_statement_cannot_be_a_using_declaration)
                return this.grammar_error_on_node(declaration_list, DiagThe_left_hand_side_of_a_for_in_statement_cannot_be_an_await_using_declaration)
            }
            if (AstNode.flags_of(declaration_list) & NodeFlagsAmbient) <> 0
            {
                if is_using
                    return this.grammar_error_on_node(declaration_list, DiagX_using_declarations_are_not_allowed_in_ambient_contexts)
                return this.grammar_error_on_node(declaration_list, DiagX_await_using_declarations_are_not_allowed_in_ambient_contexts)
            }
            if Checker.kind_or_unknown(parent) = KindVariableStatement
            {
                let gk Checker.kind_or_unknown(AstNode.parent_node_of(parent))
                var in_clause false
                if gk = KindCaseClause
                    set in_clause: true
                if gk = KindDefaultClause
                    set in_clause: true
                if in_clause
                {
                    if is_using
                        return this.grammar_error_on_node(declaration_list, DiagX_using_declarations_are_not_allowed_in_case_or_default_clauses_unless_contained_within_a_block)
                    return this.grammar_error_on_node(declaration_list, DiagX_await_using_declarations_are_not_allowed_in_case_or_default_clauses_unless_contained_within_a_block)
                }
            }
        }

        ; ★The row that stood here named check_grammar_await_or_await_using; that
        ; function has been whole since the grammar chapter and its own header
        ; already said the `await using` message pair was *written for the shape and
        ; dead* — this is the caller that makes it live.
        if is_await_using
            return this.check_grammar_await_or_await_using(declaration_list)

        false
    }

    ; checkGrammarForDisallowedBlockScopedVariableStatement, whole, and it is
    ; COMPLETE — nothing behind it is deferred, which is what lets the
    ; VariableStatement arm become the third of the switch's arms to run to its
    ; last line (the EmptyStatement and DebuggerStatement pair are the other two).
    ;
    ; ★★ IT ALWAYS ANSWERS FALSE. The reference's `return false` is not an
    ; oversight: this is the last term of checkVariableStatement's `&&` chain, its
    ; result is discarded, and the report it makes is a SEMANTIC error rather than a
    ; grammar one — `c.error`, not grammarErrorOnNode, so no parse guard. That is
    ; why it goes through error_on_node and why a file that failed to parse still
    ; gets a TS1156.
    ;
    ; ★★★ THE MESSAGE TAKES THE KEYWORD AS AN ARGUMENT AND THE FOUR ARMS COLLAPSE
    ; TO ONE CODE, which is check_grammar_modifiers' argument (§3.5ct) applied to a
    ; four-way switch: the dump is `C pos end code`, `let`/`const`/`using`/`await
    ; using` all produce TS1156, and a keyword string this port cannot print is a
    ; second thing to keep in step for no comparison. What is NOT dropped is
    ; upstream's `default: panic("Unknown BlockScope flag")` — the switch is over a
    ; masked value that is already known non-zero, so a fifth answer means the
    ; BlockScoped mask and the four constants have drifted apart, and the marker
    ; says so rather than reporting a diagnostic that looks right.
    ;
    ; ★★ AND THE MARKER IS UNREACHABLE FOR A REASON THAT IS WORTH WRITING DOWN,
    ; because it is not the usual *no corpus gets here*. The mask is three bits and
    ; the four constants cover 1, 2, 4 and 6 — so 3, 5 and 7 are the panic's
    ; population, and reaching one needs TWO of the bits set at once. The parser
    ; sets exactly one arm per list, and combined_node_flags ORs the list's flags
    ; with the STATEMENT's, which could add a bit if any OTHER flag used bits 0..2
    ; — and none does: NodeFlags.scaly's own header says those three positions are
    ; the variable-declaration aliases and nothing else. So this is a claim about
    ; the FLAG TABLE, and it expires if a flag is ever added at a low bit.
    ;
    ; ★ The combined flags come from the DECLARATION LIST, not from the statement —
    ; `let` sits on the list — and Binder.combined_node_flags walks up from there
    ; through the statement, OR-ing, which is why the same answer arrives whichever
    ; of the two the reference happens to hand it.
    procedure check_grammar_for_disallowed_block_scoped_variable_statement(this, node: ref[AstNode]) returns bool
    {
        if this.container_allows_block_scoped_variable(AstNode.parent_node_of(node))
            return false
        let list AstNode.variable_statement_list_of(node)
        if list = null
            return false
        let block_scope_kind Binder.combined_node_flags(list) & NodeFlagsBlockScoped
        if block_scope_kind = 0
            return false
        var known false
        if block_scope_kind = NodeFlagsLet
            set known: true
        if block_scope_kind = NodeFlagsConst
            set known: true
        if block_scope_kind = NodeFlagsUsing
            set known: true
        if block_scope_kind = NodeFlagsAwaitUsing
            set known: true
        if known = false
        {
            ; ★ The detail is the KIND and deliberately not the flag value, even
            ; though the flag is the interesting datum: tests/triage.py prints that
            ; column as a kind number, and NodeFlagsBlockScoped is 7, which is a
            ; real kind. A marker that reads as a wrong kind is worse than one that
            ; reads as a right one.
            this.record_unported("block-scope-flag-unknown", KindVariableStatement)
            return false
        }
        var keyword String("let")
        if block_scope_kind = NodeFlagsConst
            set keyword: String("const")
        if block_scope_kind = NodeFlagsUsing
            set keyword: String("using")
        if block_scope_kind = NodeFlagsAwaitUsing
            set keyword: String("await using")
        this.error_on_node(node, DiagX_0_declarations_can_only_be_declared_inside_a_block, keyword)
        false
    }

    ; containerAllowsBlockScopedVariable, whole. Seven kinds answer false — the
    ; six loop-and-branch statements whose body may be a single statement, plus
    ; `with` — and a LabeledStatement asks its own parent, which is the recursion
    ; upstream writes.
    ;
    ; ★★★ THIS ONE LINE IS WHAT SUPPRESSES TS1156 ON THE WHOLE CORPUS, and it is
    ; worth stating because the first draft of the control battery got it backwards.
    ; The caller RUNS on every variable statement — it is the last term of a chain
    ; slice 53 completes — so the report is not out of reach because the code is
    ; unexecuted; it is out of reach because every parent in reach (Block,
    ; ModuleBlock, SourceFile) falls through to the permissive answer.
    ; controls-slice53.sh's f10 was written expecting no change from making this
    ; answer false and came back RED 345; f11 gates the kind list itself. What no
    ; control can redden is the RECURSION: it would have to walk up to a refusing
    ; kind, and there is none within reach.
    ;
    ; ★ The parent is read null-safely for kind_or_unknown's reason: a
    ; VariableStatement at the top of a file has a SourceFile parent, but the
    ; recursion's own step can walk off the end of a label chain in a tree the
    ; parser built after an error, and KindUnknown falls out of every arm to the
    ; permissive answer the reference gives an unlisted kind.
    function container_allows_block_scoped_variable(this, parent: ref[AstNode]?) returns bool
    {
        var p parent
        while true
        {
            let k Checker.kind_or_unknown(p)
            if k = KindIfStatement
                return false
            if k = KindDoStatement
                return false
            if k = KindWhileStatement
                return false
            if k = KindWithStatement
                return false
            if k = KindForStatement
                return false
            if k = KindForInStatement
                return false
            if k = KindForOfStatement
                return false
            if k = KindLabeledStatement
            {
                set p: AstNode.parent_node_of(p) as ref[AstNode]
                continue
            }
            return true
        }
        true
    }

    ; ── checkGrammarModifiers ────────────────────────────────────────────────
    ;
    ; ★★★ THE HISTOGRAM NAMED THIS ONE FUNCTION RATHER THAN ELEVEN ARMS. Slice
    ; 48's work list reads VariableStatement 3 940, ClassDeclaration 3 022,
    ; FunctionDeclaration 2 255, ImportDeclaration 1 601, InterfaceDeclaration
    ; 1 342, ModuleDeclaration 1 282, TypeAlias 699 on stage 2 — and
    ; checkGrammarModifiers is the first grammar check of every one of them, so
    ; nothing behind it can be reached without it. 356 lines of grammarchecks.go.
    ;
    ; ★★★ THE MESSAGE ARGUMENTS ARE NOT COMPUTED, AND THAT IS AN ARGUMENT RATHER
    ; THAN A SHORTCUT. Sixteen of the reports below are one of three parameterised
    ; messages — `{0} modifier already seen`, `{0} modifier cannot be used with
    ; {1} modifier`, `{0} modifier must precede {1} modifier` — which upstream
    ; fills from visibilityToString and scanner.TokenToString. A message's CODE
    ; does not depend on its arguments, and the dump is `C pos end code`: two
    ; diagnostics agreeing on those three numbers print identically. That is the
    ; same argument DiagnosticList.sort_by_position makes for stopping its
    ; comparison at the code, and it is why visibilityToString and TokenToString
    ; are not ported here. ★It is also the one thing that would have to change if
    ; a later yardstick compared TEXT — named here so that slice finds the bill
    ; instead of discovering it as a diff.
    ;
    ; ★★★ TWO COMPILER OPTIONS DECIDE WHETHER PARTS OF THIS FUNCTION EXIST AT ALL,
    ; and both are read off the harness the way slice 48 read AllowUnreachableCode.
    ; `c.legacyDecorators` is `ExperimentalDecorators == core.TSTrue` and the
    ; oracle sets neither, so it is FALSE — which makes the accessor-pair decorator
    ; check unreachable and makes NodeCanBeDecorated's parameter arm answer false
    ; before it asks anything. `VerbatimModuleSyntax` is likewise unset, so the
    ; CommonJS top-level-export test is dead. Both are written at their place with
    ; a report behind the option rather than omitted, because an OMITTED step is
    ; invisible and a reported one is not. ★This paragraph used to add *it
    ; additionally needs program.GetEmitModuleFormatOfFile, which the stub program
    ; does not have*, and slice 54 measured that claim false: the oracle's program
    ; answers ModuleKindNone for it, which is a VALUE and not a hole (§3.5cy).
    ; visibilityToString of a visibility keyword's flag
    function visibility_text(mk: int) returns String
    {
        if mk = KindPrivateKeyword
            return String("private")
        if mk = KindProtectedKeyword
            return String("protected")
        String("public")
    }

    function in_out_text(mk: int) returns String
    {
        if mk = KindInKeyword
            return String("in")
        String("out")
    }

    procedure check_grammar_modifiers(this, node: ref[AstNode]?) returns bool
    {
        let mods AstNode.modifiers_of(node)
        if mods = null
            return false
        ; ★★ THE GUARD BELOW ASKS WHETHER *THIS CALL* REPORTED, not whether the
        ; checker has ever reported, and the difference is a whole file. Since
        ; slice 49 the statement loop no longer stops at the first unported arm
        ; (check_source_elements says why), so every statement after the first
        ; arrives here with the flag ALREADY set — and a blanket `is_unported()`
        ; test would return before checking any of them, silently, leaving
        ; diagcheck measuring one statement per unit. Measured on
        ; checker_modifier_already_seen.ts: one line instead of four.
        let unported_before this.unported_mark()
        if this.report_obvious_decorator_errors(node)
            return true
        if this.report_obvious_modifier_errors(node)
            return true
        ; Either reporter may have met a construct this slice does not implement.
        ; Continuing would report the rest of the function's opinion about a node
        ; whose first question was never answered.
        if this.unported_mark() <> unported_before
            return false

        if AstNode.is_this_parameter(node)
            return this.grammar_error_on_first_token(node, DiagNeither_decorators_nor_modifiers_may_be_applied_to_this_parameters)

        ; blockScopeKind — read from the DECLARATION LIST, not from the statement:
        ; `using` and `await using` are flags of the list, and three arms below
        ; report on them.
        var block_scope_kind: int NodeFlagsNone
        if AstNode.kind_of(node) = KindVariableStatement
        {
            let dl AstNode.variable_statement_list_of(node)
            if dl <> null
                set block_scope_kind: AstNode.flags_of(dl) & NodeFlagsBlockScoped
        }

        var last_static: ref[AstNode]? null
        var last_declare: ref[AstNode]? null
        var last_async: ref[AstNode]? null
        var last_override: ref[AstNode]? null
        var first_decorator: ref[AstNode]? null
        var flags: int ModifierFlagsNone
        var saw_export_before_decorators false

        ; The reference's comment, kept because the whole leading/trailing
        ; distinction below is unreadable without it: *We parse decorators and
        ; modifiers in four contiguous chunks: [...leadingDecorators,
        ; ...leadingModifiers, ...trailingDecorators, ...trailingModifiers]. It is
        ; an error to have both leading and trailing decorators.*
        var has_leading_decorators false

        let len mods.get_length() as int
        var i 0
        while i < len
        {
            let modifier mods[i]
            set i: i + 1
            if AstNode.is_decorator(modifier)
            {
                var grandparent: ref[AstNode]? null
                let dparent AstNode.parent_node_of(node)
                if dparent <> null
                    set grandparent: AstNode.parent_node_of(dparent)
                if this.node_can_be_decorated(legacy_decorators, node, dparent, grandparent) = false
                {
                    var overload false
                    if AstNode.kind_of(node) = KindMethodDeclaration
                    {
                        if Binder.node_is_missing(AstNode.body_of(node))
                            set overload: true
                    }
                    if overload
                        return this.grammar_error_on_first_token(node, DiagA_decorator_can_only_decorate_a_method_implementation_not_an_overload)
                    return this.grammar_error_on_first_token(node, DiagDecorators_are_not_valid_here)
                }
                if legacy_decorators
                {
                    ; `else if c.legacyDecorators && (node.Kind == KindGetAccessor
                    ; || node.Kind == KindSetAccessor)`, whose body asks
                    ; GetAllAccessorDeclarationsForDeclaration — the symbol's
                    ; declaration list walked for the get/set PAIR — and reports
                    ; TS1207 on the second of them. Unreachable under this harness
                    ; (the option is unset, see the header), and reported rather
                    ; than dropped so that an options record arriving later turns
                    ; it into a port instead of into a silent wrong answer.
                    if Checker.is_accessor_kind(AstNode.kind_of(node))
                    {
                        ; slice 249: the pair's SECOND accessor (by position) reports
                        ; when the first carries a decorator
                        var other_kind KindSetAccessor
                        if AstNode.kind_of(node) = KindSetAccessor
                            set other_kind: KindGetAccessor
                        let sym this.get_symbol_of_declaration(node)
                        if sym <> null
                        {
                            let other Checker.get_declaration_of_kind(sym as ref[Symbol], other_kind)
                            if other <> null
                            {
                                let on other as ref[AstNode]
                                if AstNode.pos_of(on) < AstNode.pos_of(node as ref[AstNode])
                                {
                                    if Checker.first_decorator_of(on) <> null
                                        return this.grammar_error_on_first_token(node, DiagDecorators_cannot_be_applied_to_multiple_get_Slashset_accessors_of_the_same_name)
                                }
                            }
                        }
                    }
                }

                ; `flags&^(ExportDefault|Decorator) != 0` — *if we've seen any
                ; modifiers aside from `export`, `default`, or another decorator,
                ; then this is an invalid position*. Written as a SUBSET test
                ; because Scaly has no complement in this position and a
                ; complement constant would be a second thing to keep in step:
                ; the difference is non-empty exactly when flags is not a subset.
                if (flags & (ModifierFlagsExportDefault | ModifierFlagsDecorator)) <> flags
                    return this.grammar_error_on_node(modifier, DiagDecorators_are_not_valid_here)

                if has_leading_decorators
                {
                    if (flags & ModifierFlagsModifier) <> 0
                    {
                        ; The reference panics here if firstDecorator is nil — a
                        ; debug assertion, and it holds by construction:
                        ; has_leading_decorators is set only on the iteration that
                        ; also sets first_decorator.
                        ;
                        ; ★ Upstream spells the report out (hasParseDiagnostics,
                        ; c.error, AddRelatedInfo, return true / return false)
                        ; instead of calling grammarErrorOnNode, and the ONLY
                        ; difference is the related info — a second span attached
                        ; to the diagnostic, which ast.NewDiagnostic keeps on the
                        ; diagnostic rather than in the list, so it never reaches
                        ; a dump. What is left is grammarErrorOnNode exactly.
                        if this.has_parse_diagnostics_of(node)
                            return false
                        let decorator_mark this.diagnostic_mark()
                        this.error_on_node(modifier, DiagDecorators_may_not_appear_after_export_or_export_default_if_they_also_appear_before_export)
                        this.related_info_since(decorator_mark, first_decorator, DiagDecorator_used_before_export_here)
                        return true
                    }
                }

                set flags: flags | ModifierFlagsDecorator

                ; if we have not yet seen a modifier, then these are leading
                ; decorators
                if (flags & ModifierFlagsModifier) = 0
                    set has_leading_decorators: true
                else
                {
                    if (flags & ModifierFlagsExport) <> 0
                        set saw_export_before_decorators: true
                }

                if first_decorator = null
                    set first_decorator: modifier
            }
            else
            {
                let mk AstNode.kind_of(modifier)
                let nk AstNode.kind_of(node)
                let parent AstNode.parent_node_of(node)

                ; Three placement tests that run before the switch, in the
                ; reference's order.
                if mk <> KindReadonlyKeyword
                {
                    if nk = KindPropertySignature
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_type_member, Checker.arg_text(Scanner.token_to_string(mk)))
                    if nk = KindMethodSignature
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_type_member, Checker.arg_text(Scanner.token_to_string(mk)))
                    if nk = KindIndexSignature
                    {
                        var index_ok false
                        if mk = KindStaticKeyword
                        {
                            if Parser.is_class_like_node(parent)
                                set index_ok: true
                        }
                        if index_ok = false
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_an_index_signature, Checker.arg_text(Scanner.token_to_string(mk)))
                    }
                }
                var in_out_or_const false
                if mk = KindInKeyword
                    set in_out_or_const: true
                if mk = KindOutKeyword
                    set in_out_or_const: true
                if mk = KindConstKeyword
                    set in_out_or_const: true
                if in_out_or_const = false
                {
                    if nk = KindTypeParameter
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_type_parameter, Checker.arg_text(Scanner.token_to_string(mk)))
                }

                ; NodeFlagsReparsed on the MODIFIER: a modifier the JSDoc reparser
                ; synthesized carries no source order, so every *must precede*
                ; test is skipped for it. Read once, because eleven arms ask it.
                let reparsed (AstNode.flags_of(modifier as ref[AstNode]) & NodeFlagsReparsed) <> 0

                if mk = KindConstKeyword
                {
                    if nk <> KindEnumDeclaration
                    {
                        if nk <> KindTypeParameter
                            return this.grammar_error_on_node(node, DiagA_class_member_cannot_have_the_0_keyword, "const")
                    }
                    if nk = KindTypeParameter
                    {
                        var host_ok false
                        if AstNode.is_function_like_declaration(parent)
                            set host_ok: true
                        if Parser.is_class_like_node(parent)
                            set host_ok: true
                        if Checker.kind_or_unknown(parent) = KindFunctionType
                            set host_ok: true
                        if Checker.kind_or_unknown(parent) = KindConstructorType
                            set host_ok: true
                        if Checker.kind_or_unknown(parent) = KindCallSignature
                            set host_ok: true
                        if Checker.kind_or_unknown(parent) = KindConstructSignature
                            set host_ok: true
                        if Checker.kind_or_unknown(parent) = KindMethodSignature
                            set host_ok: true
                        if host_ok = false
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_can_only_appear_on_a_type_parameter_of_a_function_method_or_class, Checker.arg_text(Scanner.token_to_string(mk)))
                    }
                }

                if mk = KindOverrideKeyword
                {
                    ; The reference's note: *if node.kind === Parameter,
                    ; checkParameter reports an error if it's not a parameter
                    ; property.*
                    if (flags & ModifierFlagsOverride) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, "override")
                    if (flags & ModifierFlagsAmbient) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "override", "declare")
                    if reparsed = false
                    {
                        if (flags & ModifierFlagsReadonly) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "override", "readonly")
                        if (flags & ModifierFlagsAccessor) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "override", "accessor")
                        if (flags & ModifierFlagsAsync) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "override", "async")
                    }
                    set flags: flags | ModifierFlagsOverride
                    set last_override: modifier
                }

                var visibility false
                if mk = KindPublicKeyword
                    set visibility: true
                if mk = KindProtectedKeyword
                    set visibility: true
                if mk = KindPrivateKeyword
                    set visibility: true
                if visibility
                {
                    if (flags & ModifierFlagsAccessibilityModifier) <> 0
                        return this.grammar_error_on_node(modifier, DiagAccessibility_modifier_already_seen)
                    if reparsed = false
                    {
                        if (flags & ModifierFlagsOverride) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, Checker.visibility_text(mk), "override")
                        if (flags & ModifierFlagsStatic) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, Checker.visibility_text(mk), "static")
                        if (flags & ModifierFlagsAccessor) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, Checker.visibility_text(mk), "accessor")
                        if (flags & ModifierFlagsReadonly) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, Checker.visibility_text(mk), "readonly")
                        if (flags & ModifierFlagsAsync) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, Checker.visibility_text(mk), "async")
                    }
                    if Checker.kind_or_unknown(parent) = KindModuleBlock
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_module_or_namespace_element, Checker.visibility_text(mk))
                    if Checker.kind_or_unknown(parent) = KindSourceFile
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_module_or_namespace_element, Checker.visibility_text(mk))
                    ; ★ THE `else` IS LOAD-BEARING AND IS THE ONE ARM OF THIS
                    ; FUNCTION THAT DOES NOT FLATTEN INTO INDEPENDENT TESTS.
                    ; Upstream's chain ends `else if flags&Abstract != 0 { if
                    ; private {…} else if !reparsed {…} } else if
                    ; IsPrivateIdentifierClassElementDeclaration(node) {…}` — so a
                    ; REPARSED non-private accessibility modifier beside `abstract`
                    ; falls out of the chain reporting NOTHING, and in particular
                    ; never reaches the private-identifier test. Every other arm
                    ; here is a run of returns and is equivalent flattened; this
                    ; one is not.
                    if (flags & ModifierFlagsAbstract) <> 0
                    {
                        if mk = KindPrivateKeyword
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, Checker.visibility_text(mk), "abstract")
                        if reparsed = false
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, Checker.visibility_text(mk), "abstract")
                    }
                    else
                    {
                        if AstNode.is_private_identifier_class_element_declaration(node)
                            return this.grammar_error_on_node(modifier, DiagAn_accessibility_modifier_cannot_be_used_with_a_private_identifier)
                    }
                    set flags: flags | AstNode.modifier_to_flag(mk)
                }

                if mk = KindStaticKeyword
                {
                    if (flags & ModifierFlagsStatic) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, "static")
                    if reparsed = false
                    {
                        if (flags & ModifierFlagsReadonly) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "static", "readonly")
                        if (flags & ModifierFlagsAsync) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "static", "async")
                        if (flags & ModifierFlagsAccessor) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "static", "accessor")
                    }
                    if Checker.kind_or_unknown(parent) = KindModuleBlock
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_module_or_namespace_element, "static")
                    if Checker.kind_or_unknown(parent) = KindSourceFile
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_module_or_namespace_element, "static")
                    if nk = KindParameter
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_parameter, "static")
                    if (flags & ModifierFlagsAbstract) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "static", "abstract")
                    if reparsed = false
                    {
                        if (flags & ModifierFlagsOverride) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "static", "override")
                    }
                    set flags: flags | ModifierFlagsStatic
                    set last_static: modifier
                }

                if mk = KindAccessorKeyword
                {
                    if (flags & ModifierFlagsAccessor) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, "accessor")
                    if (flags & ModifierFlagsReadonly) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "accessor", "readonly")
                    if (flags & ModifierFlagsAmbient) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "accessor", "declare")
                    if nk <> KindPropertyDeclaration
                        return this.grammar_error_on_node(modifier, DiagX_accessor_modifier_can_only_appear_on_a_property_declaration)
                    set flags: flags | ModifierFlagsAccessor
                }

                if mk = KindReadonlyKeyword
                {
                    if (flags & ModifierFlagsReadonly) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, "readonly")
                    ; The reference's note again: *if node.kind === Parameter,
                    ; checkParameter reports an error if it's not a parameter
                    ; property* — which is why Parameter is admitted here.
                    var readonly_host false
                    if nk = KindPropertyDeclaration
                        set readonly_host: true
                    if nk = KindPropertySignature
                        set readonly_host: true
                    if nk = KindIndexSignature
                        set readonly_host: true
                    if nk = KindParameter
                        set readonly_host: true
                    if readonly_host = false
                        return this.grammar_error_on_node(modifier, DiagX_readonly_modifier_can_only_appear_on_a_property_declaration_or_index_signature)
                    if (flags & ModifierFlagsAccessor) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "readonly", "accessor")
                    set flags: flags | ModifierFlagsReadonly
                }

                if mk = KindExportKeyword
                {
                    ; The VerbatimModuleSyntax arm. Unset under this harness (see
                    ; the header), which is the whole of the hole — the claim that
                    ; program.GetEmitModuleFormatOfFile is a second one was
                    ; measured false in slice 54 (§3.5cy).
                    ; a top-level `export` on a value declaration of a CommonJS-format
                    ; file under verbatimModuleSyntax (slice 249)
                    if verbatim_module_syntax and ((AstNode.flags_of(node as ref[AstNode]) & NodeFlagsAmbient) = 0) and (nk <> KindTypeAliasDeclaration) and (nk <> KindInterfaceDeclaration) and (nk <> KindModuleDeclaration)
                    {
                        let holder AstNode.parent_node_of(node)
                        if Checker.kind_or_unknown(holder) = KindSourceFile
                        {
                            if this.file_emit_format_of(holder) = ModuleKindCommonJS
                                return this.grammar_error_on_node(modifier, DiagA_top_level_export_modifier_cannot_be_used_on_value_declarations_in_a_CommonJS_module_when_verbatimModuleSyntax_is_enabled)
                        }
                    }
                    if (flags & ModifierFlagsExport) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, "export")
                    if reparsed = false
                    {
                        if (flags & ModifierFlagsAmbient) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "export", "declare")
                        if (flags & ModifierFlagsAbstract) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "export", "abstract")
                        if (flags & ModifierFlagsAsync) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "export", "async")
                    }
                    if Parser.is_class_like_node(parent)
                    {
                        if nk <> KindJSTypeAliasDeclaration
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_class_elements_of_this_kind, "export")
                    }
                    if nk = KindParameter
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_parameter, "export")
                    if block_scope_kind = NodeFlagsUsing
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_using_declaration, "export")
                    if block_scope_kind = NodeFlagsAwaitUsing
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_an_await_using_declaration, "export")
                    set flags: flags | ModifierFlagsExport
                }

                if mk = KindDefaultKeyword
                {
                    var container parent
                    if Checker.kind_or_unknown(parent) <> KindSourceFile
                        set container: AstNode.parent_node_of(parent)
                    var bad_container false
                    if Checker.kind_or_unknown(container) = KindModuleDeclaration
                    {
                        if Checker.is_ambient_module_or_null(container) = false
                            set bad_container: true
                    }
                    if bad_container
                        return this.grammar_error_on_node(modifier, DiagA_default_export_can_only_be_used_in_an_ECMAScript_style_module)
                    if block_scope_kind = NodeFlagsUsing
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_using_declaration, "default")
                    if block_scope_kind = NodeFlagsAwaitUsing
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_an_await_using_declaration, "default")
                    if (flags & ModifierFlagsExport) = 0
                    {
                        if reparsed = false
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "export", "default")
                    }
                    if saw_export_before_decorators
                        return this.grammar_error_on_node(first_decorator, DiagDecorators_are_not_valid_here)
                    set flags: flags | ModifierFlagsDefault
                }

                if mk = KindDeclareKeyword
                {
                    if (flags & ModifierFlagsAmbient) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, "declare")
                    if (flags & ModifierFlagsAsync) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_in_an_ambient_context, "async")
                    if (flags & ModifierFlagsOverride) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_in_an_ambient_context, "override")
                    if Parser.is_class_like_node(parent)
                    {
                        if nk <> KindPropertyDeclaration
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_class_elements_of_this_kind, "declare")
                    }
                    if nk = KindParameter
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_parameter, "declare")
                    if block_scope_kind = NodeFlagsUsing
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_using_declaration, "declare")
                    if block_scope_kind = NodeFlagsAwaitUsing
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_an_await_using_declaration, "declare")
                    if (Checker.flags_or_none(parent) & NodeFlagsAmbient) <> 0
                    {
                        if Checker.kind_or_unknown(parent) = KindModuleBlock
                            return this.grammar_error_on_node(modifier, DiagA_declare_modifier_cannot_be_used_in_an_already_ambient_context)
                    }
                    if AstNode.is_private_identifier_class_element_declaration(node)
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_a_private_identifier, "declare")
                    if (flags & ModifierFlagsAccessor) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "declare", "accessor")
                    set flags: flags | ModifierFlagsAmbient
                    set last_declare: modifier
                }

                if mk = KindAbstractKeyword
                {
                    if (flags & ModifierFlagsAbstract) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, "abstract")
                    var abstract_host false
                    if nk = KindClassDeclaration
                        set abstract_host: true
                    if nk = KindConstructorType
                        set abstract_host: true
                    if abstract_host = false
                    {
                        var member false
                        if nk = KindMethodDeclaration
                            set member: true
                        if nk = KindPropertyDeclaration
                            set member: true
                        if nk = KindGetAccessor
                            set member: true
                        if nk = KindSetAccessor
                            set member: true
                        if member = false
                            return this.grammar_error_on_node(modifier, DiagX_abstract_modifier_can_only_appear_on_a_class_method_or_property_declaration)
                        var in_abstract_class false
                        if Checker.kind_or_unknown(parent) = KindClassDeclaration
                        {
                            if b.has_syntactic_modifier(parent, ModifierFlagsAbstract)
                                set in_abstract_class: true
                        }
                        if in_abstract_class = false
                        {
                            if nk = KindPropertyDeclaration
                                return this.grammar_error_on_node(modifier, DiagAbstract_properties_can_only_appear_within_an_abstract_class)
                            return this.grammar_error_on_node(modifier, DiagAbstract_methods_can_only_appear_within_an_abstract_class)
                        }
                        if (flags & ModifierFlagsStatic) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "static", "abstract")
                        if (flags & ModifierFlagsPrivate) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "private", "abstract")
                        if (flags & ModifierFlagsAsync) <> 0
                        {
                            if last_async <> null
                                return this.grammar_error_on_node(last_async, DiagX_0_modifier_cannot_be_used_with_1_modifier, "async", "abstract")
                        }
                        if reparsed = false
                        {
                            if (flags & ModifierFlagsOverride) <> 0
                                return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "abstract", "override")
                            if (flags & ModifierFlagsAccessor) <> 0
                                return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "abstract", "accessor")
                        }
                    }
                    if AstNode.is_private_identifier(AstNode.name_of(node))
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_a_private_identifier, "abstract")
                    set flags: flags | ModifierFlagsAbstract
                }

                if mk = KindAsyncKeyword
                {
                    if (flags & ModifierFlagsAsync) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, "async")
                    var ambient false
                    if (flags & ModifierFlagsAmbient) <> 0
                        set ambient: true
                    if (Checker.flags_or_none(parent) & NodeFlagsAmbient) <> 0
                        set ambient: true
                    if ambient
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_in_an_ambient_context, "async")
                    if nk = KindParameter
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_appear_on_a_parameter, "async")
                    if (flags & ModifierFlagsAbstract) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_cannot_be_used_with_1_modifier, "async", "abstract")
                    set flags: flags | ModifierFlagsAsync
                    set last_async: modifier
                }

                var in_or_out false
                if mk = KindInKeyword
                    set in_or_out: true
                if mk = KindOutKeyword
                    set in_or_out: true
                if in_or_out
                {
                    var in_out_flag: int ModifierFlagsOut
                    if mk = KindInKeyword
                        set in_out_flag: ModifierFlagsIn
                    ; `node.Kind != TypeParameter || parent != nil && !(…)` — the
                    ; second half is guarded on a non-nil parent, so a type
                    ; parameter with no parent passes.
                    var wrong_host false
                    if nk <> KindTypeParameter
                        set wrong_host: true
                    if parent <> null
                    {
                        var variance_host false
                        if Checker.kind_or_unknown(parent) = KindInterfaceDeclaration
                            set variance_host: true
                        if Parser.is_class_like_node(parent)
                            set variance_host: true
                        if AstNode.is_type_or_js_type_alias_declaration(parent)
                            set variance_host: true
                        if variance_host = false
                            set wrong_host: true
                    }
                    if wrong_host
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_can_only_appear_on_a_type_parameter_of_a_class_interface_or_type_alias, Checker.in_out_text(mk))
                    if (flags & in_out_flag) <> 0
                        return this.grammar_error_on_node(modifier, DiagX_0_modifier_already_seen, Checker.in_out_text(mk))
                    if (in_out_flag & ModifierFlagsIn) <> 0
                    {
                        if (flags & ModifierFlagsOut) <> 0
                            return this.grammar_error_on_node(modifier, DiagX_0_modifier_must_precede_1_modifier, "in", "out")
                    }
                    set flags: flags | in_out_flag
                }
            }
        }

        let nk AstNode.kind_of(node)
        if nk = KindConstructor
        {
            if (flags & ModifierFlagsStatic) <> 0
                return this.grammar_error_on_node(last_static, DiagX_0_modifier_cannot_appear_on_a_constructor_declaration, "static")
            if (flags & ModifierFlagsOverride) <> 0
                return this.grammar_error_on_node(last_override, DiagX_0_modifier_cannot_appear_on_a_constructor_declaration, "override")
            if (flags & ModifierFlagsAsync) <> 0
                return this.grammar_error_on_node(last_async, DiagX_0_modifier_cannot_appear_on_a_constructor_declaration, "async")
            return false
        }
        var import_kind false
        if nk = KindImportDeclaration
            set import_kind: true
        if nk = KindJSImportDeclaration
            set import_kind: true
        if nk = KindImportEqualsDeclaration
            set import_kind: true
        if import_kind
        {
            if (flags & ModifierFlagsAmbient) <> 0
                return this.grammar_error_on_node(last_declare, DiagA_0_modifier_cannot_be_used_with_an_import_declaration, "declare")
        }
        if nk = KindParameter
        {
            if (flags & ModifierFlagsParameterPropertyModifier) <> 0
            {
                if Binder.is_binding_pattern(AstNode.name_of(node))
                    return this.grammar_error_on_node(node, DiagA_parameter_property_may_not_be_declared_using_a_binding_pattern)
                if AstNode.dot_dot_dot_token_of(node) <> null
                    return this.grammar_error_on_node(node, DiagA_parameter_property_cannot_be_declared_using_a_rest_parameter)
            }
        }
        if (flags & ModifierFlagsAsync) <> 0
            return this.check_grammar_async_modifier(node, last_async)
        false
    }

    ; checkGrammarAsyncModifier, whole. Four kinds may carry `async`; everything
    ; else that reached here reports at the modifier.
    procedure check_grammar_async_modifier(this, node: ref[AstNode]?, async_modifier: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindMethodDeclaration
            return false
        if k = KindFunctionDeclaration
            return false
        if k = KindFunctionExpression
            return false
        if k = KindArrowFunction
            return false
        this.grammar_error_on_node(async_modifier, DiagX_0_modifier_cannot_be_used_here, "async")
    }

    ; reportObviousDecoratorErrors / findFirstIllegalDecorator. The pair is the
    ; DECORATOR half of the two questions ast.can_have_illegal_decorators exists
    ; to answer, and the port already carries the predicate (slice 24 wrote it for
    ; checkJSDecoratorSyntax): a node on that list may never carry a decorator, so
    ; the FIRST one it carries is reported wherever it sits.
    procedure report_obvious_decorator_errors(this, node: ref[AstNode]?) returns bool
    {
        let decorator Checker.find_first_illegal_decorator(node)
        if decorator = null
            return false
        this.grammar_error_on_first_token(decorator, DiagDecorators_are_not_valid_here)
    }

    function find_first_illegal_decorator(node: ref[AstNode]?) returns ref[AstNode]?
    {
        if AstNode.can_have_illegal_decorators(node) = false
            return null
        Checker.find_first_decorator(node)
    }

    ; core.Find(node.ModifierNodes(), ast.IsDecorator) and its twin for
    ; ast.IsModifier. Two functions rather than one with a predicate parameter:
    ; Scaly's only escaping-closure form is `return \x: …` (§3.9e), and the port's
    ; standing answer to a callback argument is one function per call shape.
    function find_first_decorator(node: ref[AstNode]?) returns ref[AstNode]?
    {
        let mods AstNode.modifiers_of(node)
        if mods = null
            return null
        let len mods.get_length() as int
        var i 0
        while i < len
        {
            let m mods[i]
            if AstNode.is_decorator(m)
                return m
            set i: i + 1
        }
        null
    }

    function find_first_modifier(node: ref[AstNode]?) returns ref[AstNode]?
    {
        let mods AstNode.modifiers_of(node)
        if mods = null
            return null
        let len mods.get_length() as int
        var i 0
        while i < len
        {
            let m mods[i]
            if Parser.is_modifier_kind(AstNode.kind_of(m))
                return m
            set i: i + 1
        }
        null
    }

    ; reportObviousModifierErrors / findFirstIllegalModifier / findFirstModifierExcept.
    ;
    ; ★★ THE THIRD GROUP OF findFirstIllegalModifier IS A `panic`, AND IT IS
    ; PORTED AS A REPORT. Upstream ends its inner switch with *Unhandled case in
    ; findFirstIllegalModifier* — reachable only for a node kind that carries
    ; modifiers, sits inside neither a module block nor a source file, and is none
    ; of the eight the switch names. None of the five kinds this slice's arms
    ; reach can be that node, so the arm is a guard for the next slice rather than
    ; a live path; a report is what keeps it from becoming a silent `nil`.
    procedure report_obvious_modifier_errors(this, node: ref[AstNode]?) returns bool
    {
        let modifier this.find_first_illegal_modifier(node)
        if modifier = null
            return false
        this.grammar_error_on_first_token(modifier, DiagModifiers_cannot_appear_here)
    }

    function find_first_modifier_except(node: ref[AstNode]?, allowed_modifier: int) returns ref[AstNode]?
    {
        let modifier Checker.find_first_modifier(node)
        if modifier = null
            return null
        if AstNode.kind_of(modifier) = allowed_modifier
            return null
        modifier
    }

    procedure find_first_illegal_modifier(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        let k AstNode.kind_of(node)
        ; Group one: the kinds whose modifiers are all legal here — the accessors,
        ; the members, the module and import/export elements, the two function
        ; expressions, a parameter, a type parameter and a JS type alias.
        if Checker.kind_has_no_illegal_modifier(k)
            return null
        ; Group two: the kinds that may carry NO modifier at all.
        if Checker.kind_admits_no_modifier(k)
            return Checker.find_first_modifier(node)
        ; The default group. A declaration at the top level of a file or of a
        ; namespace body is exempt outright; everything else is judged per kind.
        let parent AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(parent) = KindModuleBlock
            return null
        if Checker.kind_or_unknown(parent) = KindSourceFile
            return null
        if k = KindFunctionDeclaration
            return Checker.find_first_modifier_except(node, KindAsyncKeyword)
        if k = KindClassDeclaration
            return Checker.find_first_modifier_except(node, KindAbstractKeyword)
        if k = KindConstructorType
            return Checker.find_first_modifier_except(node, KindAbstractKeyword)
        if k = KindClassExpression
            return Checker.find_first_modifier(node)
        if k = KindInterfaceDeclaration
            return Checker.find_first_modifier(node)
        if k = KindTypeAliasDeclaration
            return Checker.find_first_modifier(node)
        if k = KindVariableStatement
        {
            let dl AstNode.variable_statement_list_of(node)
            if dl <> null
            {
                if (AstNode.flags_of(dl) & NodeFlagsUsing) <> 0
                    return Checker.find_first_modifier_except(node, KindAwaitKeyword)
            }
            return Checker.find_first_modifier(node)
        }
        if k = KindEnumDeclaration
            return Checker.find_first_modifier_except(node, KindConstKeyword)
        this.record_unported("find-first-illegal-modifier", k)
        null
    }

    function kind_has_no_illegal_modifier(k: int) returns bool
    {
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindConstructor
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindPropertySignature
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindIndexSignature
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindImportDeclaration
            return true
        if k = KindJSImportDeclaration
            return true
        if k = KindImportEqualsDeclaration
            return true
        if k = KindExportDeclaration
            return true
        if k = KindExportAssignment
            return true
        if k = KindFunctionExpression
            return true
        if k = KindArrowFunction
            return true
        if k = KindParameter
            return true
        if k = KindTypeParameter
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        false
    }

    function kind_admits_no_modifier(k: int) returns bool
    {
        if k = KindClassStaticBlockDeclaration
            return true
        if k = KindPropertyAssignment
            return true
        if k = KindShorthandPropertyAssignment
            return true
        if k = KindNamespaceExportDeclaration
            return true
        if k = KindMissingDeclaration
            return true
        false
    }

    ; ast.NodeCanBeDecorated. It lives here rather than in ast.scaly because two
    ; of its five arms ask HasAbstractModifier / HasAmbientModifier, i.e.
    ; Binder.has_syntactic_modifier — a method on the binder, since a node's
    ; modifier flags are computed rather than cached in this port. The checker is
    ; the object that holds a binder.
    ;
    ; ★★★ IT TOOK UPSTREAM'S `useLegacyDecorators` PARAMETER IN SLICE 174, AND
    ; READING THE OPTION DIRECTLY WAS A REAL DIFFERENCE RATHER THAN A SPELLING.
    ; Upstream has two kinds of call site: the grammar and decorator checks pass
    ; `c.legacyDecorators`, and ClassOrConstructorParameterIsDecorated's callers
    ; pass the LITERAL `false`. With the option unset the two agree today, which
    ; is exactly what would have made the difference invisible — and §3.5gg's rule
    ; is that a substitute is invisible where a stop is not.
    function node_can_be_decorated(this, use_legacy: bool, node: ref[AstNode]?, parent: ref[AstNode]?, grandparent: ref[AstNode]?) returns bool
    {
        ; *private names cannot be used with decorators yet* — legacy only.
        if use_legacy
        {
            if AstNode.is_private_identifier(AstNode.name_of(node))
                return false
        }
        let k AstNode.kind_of(node)
        ; class declarations are valid targets
        if k = KindClassDeclaration
            return true
        ; class expressions are valid targets for native decorators
        if k = KindClassExpression
            return use_legacy = false
        ; property declarations are valid if their parent is a class declaration
        if k = KindPropertyDeclaration
        {
            if parent = null
                return false
            if use_legacy
                return Checker.kind_or_unknown(parent) = KindClassDeclaration
            if Parser.is_class_like_node(parent) = false
                return false
            if b.has_syntactic_modifier(node, ModifierFlagsAbstract)
                return false
            return b.has_syntactic_modifier(node, ModifierFlagsAmbient) = false
        }
        ; if this method has a body and its parent is a class declaration, this is
        ; a valid target
        var method_like false
        if k = KindGetAccessor
            set method_like: true
        if k = KindSetAccessor
            set method_like: true
        if k = KindMethodDeclaration
            set method_like: true
        if method_like
        {
            if parent = null
                return false
            if AstNode.body_of(node) = null
                return false
            if use_legacy
                return Checker.kind_or_unknown(parent) = KindClassDeclaration
            return Parser.is_class_like_node(parent)
        }
        if k = KindParameter
        {
            ; The reference's TODO: *ParameterDeclaration decorator support for ES
            ; decorators must wait until it is standardized.* So the whole arm is
            ; legacy-only.
            if use_legacy = false
                return false
            ; "if the parameter's parent has a body and its grandparent is a class
            ; declaration, this is a valid target" (slice 174 — the note that
            ; stopped here named ast.GetThisParameter and the parent's body, and
            ; this file already had both).
            if parent = null
                return false
            let pn parent as ref[AstNode]
            if AstNode.body_of(pn) = null
                return false
            let pk AstNode.kind_of(pn)
            var host_kind pk = KindConstructor
            if pk = KindMethodDeclaration
                set host_kind: true
            if pk = KindSetAccessor
                set host_kind: true
            if host_kind = false
                return false
            if Checker.get_this_parameter(pn) = node
                return false
            if grandparent = null
                return false
            return AstNode.kind_of(grandparent as ref[AstNode]) = KindClassDeclaration
        }
        false
    }
    ; ── the grammar check the file itself gets ───────────────────────────────
    ;
    ; checkGrammarSourceFile, whole:
    ;
    ;   return node.Flags&ast.NodeFlagsAmbient != 0 &&
    ;       c.checkGrammarTopLevelElementsForRequiredDeclareModifier(node)
    ;
    ; ★★★ SLICE 47 DEFERRED THE SECOND HALF ON ONE PREDICATE AND SAID SO, AND
    ; THIS IS THAT BILL PAID. `ast.IsDeclarationNode` is `node.DeclarationData()
    ; != nil` — a property of the node LAYOUT, not a list anyone can read off a
    ; switch — so its note read *a hand-written kind list here would be a silent
    ; wrong answer in both directions: a missing kind drops a TS1046 the reference
    ; reports, an extra one invents a diagnostic where a plain statement stands*.
    ; It is now DERIVED (DeclarationKinds.scaly, generated by closing the
    ; reference's struct-embedding graph over DeclarationBase and verified against
    ; the reference's own DeclarationData()), and the derivation is what shows how
    ; right the deferral was: seven of the fifty-six kinds are ones no reader would
    ; have guessed, BinaryExpression and ObjectLiteralExpression among them.
    procedure check_grammar_source_file(this) returns bool
    {
        if (AstNode.flags_of(file as ref[AstNode]) & NodeFlagsAmbient) = 0
            return false
        this.check_grammar_top_level_elements_for_required_declare_modifier()
    }

    ; ★ The OR is the reference's own, and it is the proof that a VariableStatement
    ; is NOT a declaration node: upstream writes `ast.IsDeclarationNode(decl) ||
    ; decl.Kind == ast.KindVariableStatement`, which would be dead text if the
    ; predicate already admitted it. The derived table agrees — 244 is absent from
    ; it — so the two readings of the reference confirm each other.
    procedure check_grammar_top_level_elements_for_required_declare_modifier(this) returns bool
    {
        let stmts AstNode.statements_of(file)
        let n AstNode.list_count(stmts)
        var i 0
        while i < n
        {
            let decl AstNode.child_in_list(stmts, i)
            var considered AstNode.is_declaration_node(decl)
            if AstNode.kind_of(decl) = KindVariableStatement
                set considered: true
            if considered
            {
                if this.check_grammar_top_level_element_for_required_declare_modifier(decl)
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; checkGrammarTopLevelElementForRequiredDeclareModifier. The reference's own
    ; comment on the grammar it enforces is worth keeping, because the exempt list
    ; below is not derivable from anything else:
    ;
    ;   A declare modifier is required for any top level .d.ts declaration except
    ;   export=, export default, export as namespace, interfaces and imports:
    ;
    ;     DeclarationElement:
    ;        ExportAssignment
    ;        export_opt   InterfaceDeclaration
    ;        export_opt   TypeAliasDeclaration
    ;        export_opt   ImportDeclaration
    ;        export_opt   ExternalImportDeclaration
    ;        export_opt   AmbientDeclaration
    procedure check_grammar_top_level_element_for_required_declare_modifier(this, node: ref[AstNode]?) returns bool
    {
        if Checker.kind_is_exempt_from_declare_modifier(AstNode.kind_of(node))
            return false
        var exempting: int ModifierFlagsAmbient | ModifierFlagsExport | ModifierFlagsDefault
        if b.has_syntactic_modifier(node, exempting)
            return false
        this.grammar_error_on_first_token(node, DiagTop_level_declarations_in_d_ts_files_must_start_with_either_a_declare_or_export_modifier)
    }

    ; The kind half of the condition above, as a function for the reason
    ; ast.scaly's is_kind_with_type_slot_for_part_of_type_node is one.
    function kind_is_exempt_from_declare_modifier(k: int) returns bool
    {
        if k = KindInterfaceDeclaration
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindImportDeclaration
            return true
        if k = KindJSImportDeclaration
            return true
        if k = KindImportEqualsDeclaration
            return true
        if k = KindExportDeclaration
            return true
        if k = KindExportAssignment
            return true
        if k = KindNamespaceExportDeclaration
            return true
        false
    }

    ; ── checkGrammarStatementInAmbientContext ────────────────────────────────
    ;
    ; The whole body of the EmptyStatement and DebuggerStatement arms and the first
    ; line of the ExpressionStatement one, which is why a slice aimed at the
    ; statement histogram starts here.
    ;
    ; ★★ THE ONCE-BIT IS THE POINT OF THE FUNCTION, not bookkeeping around it. The
    ; reference's own comment: *If we are in a block, we only want to really report
    ; an error once to prevent noisiness* — so the bit lives on the BLOCK for the
    ; second diagnostic and on the NODE for the first, and a port that dropped it
    ; would emit one TS1036 per statement of an ambient block instead of one per
    ; block. ★And the bit is set to the RESULT of the report, not unconditionally:
    ; when grammarErrorOnFirstToken is suppressed by a parse diagnostic, nothing is
    ; marked and the next statement asks again — which is the same answer, since
    ; the suppression is a property of the file rather than of the statement.
    ;
    ; ★ The else branch of the reference is an assertion it has commented out
    ; ("we must be parented by a statement ... our parent will have already done
    ; it"), so there is nothing to port there and the function falls through.
    procedure check_grammar_statement_in_ambient_context(this, node: ref[AstNode]) returns bool
    {
        if (AstNode.flags_of(node) & NodeFlagsAmbient) = 0
            return false
        let parent AstNode.parent_node_of(node)
        if this.has_reported_ambient(node) = false
        {
            var in_signature AstNode.is_function_like(parent)
            if Checker.is_accessor_kind(AstNode.kind_of(parent))
                set in_signature: true
            if in_signature
            {
                let reported this.grammar_error_on_first_token(node, DiagAn_implementation_cannot_be_declared_in_ambient_contexts)
                if reported
                    this.mark_reported_ambient(node)
                return reported
            }
        }
        var in_block false
        let pk AstNode.kind_of(parent)
        if pk = KindBlock
            set in_block: true
        if pk = KindModuleBlock
            set in_block: true
        if pk = KindSourceFile
            set in_block: true
        if in_block
        {
            if this.has_reported_ambient(parent) = false
            {
                let reported this.grammar_error_on_first_token(node, DiagStatements_are_not_allowed_in_ambient_contexts)
                if reported
                    this.mark_reported_ambient(parent)
                return reported
            }
        }
        false
    }

    ; ast.IsAccessor, which is two kinds.
    function is_accessor_kind(k: int) returns bool
    {
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        false
    }

    function has_reported_ambient(this, n: ref[AstNode]?) returns bool
    {
        let len reported_ambient.get_length() as int
        var i 0
        while i < len
        {
            if reported_ambient[i] = n
                return true
            set i: i + 1
        }
        false
    }

    procedure mark_reported_ambient(this, n: ref[AstNode]?)
        reported_ambient.add(n)

    ; ── slice 101: the assignability relation, and the half of it that answers
    ;    without recursing ────────────────────────────────────────────────────
    ;
    ; ★★★ THE ROW SLICES 99 AND 100 BOTH NAMED AND NEITHER TOOK. Both closing
    ; paragraphs called `check-type-assignable-to 261` *the largest row that is not
    ; the table* — 2 234 units of stage 2, then 2 783 — and both passed it over with
    ; the same reason: `relater.go` is 5 006 lines of ONE recursive comparison with a
    ; dozen entry points, so it cannot be opened as a dispatch and closed arm by arm
    ; the way the last five chapters were. ★★★What CAN be opened is the half that
    ; answers WITHOUT recursing: `isTypeRelatedTo`'s fast paths and
    ; `isSimpleTypeRelatedTo`, the flag table that decides every comparison between
    ; two types neither of which is structured or instantiable. `var x: number = 1`
    ; is that comparison, and so is `var x: string = 1` — the first unblocks a unit,
    ; the second is TS2322.
    ;
    ; ★★★ ONE GUARD MAKES THE REPORT SAFE, AND IT IS NOT AN ARGUMENT PER ARM. A
    ; relation that answers FALSE is not the same claim as a relation that CANNOT
    ; answer: the reference reaches `false` only after the whole structural
    ; comparison has failed, and this port reaches it after two flag tests. So the
    ; report is emitted only when NOTHING STOPPED under the comparison —
    ; `report_error_results` takes the mark its caller read on entry and returns
    ; without a word when the count has moved. Every unported arm below is therefore
    ; free to be a `record_unported` and fall through: a stop cannot become an
    ; invented diagnostic, and diagcheck's relation — our C section is a SUBSEQUENCE
    ; of the reference's — is exactly the direction an invented line is visible in.
    ;
    ; ★★★ AND THE SECOND HALF OF THE SAFETY IS A CONTAINMENT THAT COSTS NOTHING:
    ; **the report is reachable only when NEITHER side is structured or
    ; instantiable**, because the line above it stops on both. That one fact kills
    ; almost every branch of the reporting machinery at once — `reportErrorResults`'
    ; four switch arms each need Object, JsxAttributes or Intersection;
    ; `reportRelationError`'s type-parameter arm needs TypeParameter or
    ; IndexedAccess; its did-you-mean arm needs a Union target. They are written
    ; where the reference forks and they report rather than being folded away, so
    ; the slice that opens the recursion meets them.
    ;
    ; ★★★ THE ONE PLACE THAT CONTAINMENT DOES **NOT** REACH IS `elaborateError`,
    ; AND FINDING THAT OUT IS WHAT THE ARM LIST BELOW IS FOR. An OBJECT source
    ; against a PRIMITIVE target does not stop — `isRelatedToEx` answers it before
    ; normalization, in a branch of its own — so an object literal, an array
    ; literal and a function expression DO arrive at the elaborator with
    ; `var x: string = {}`. Two of the four arms answer that case themselves (a
    ; primitive target is not elaborated, which is `elaborateObjectLiteral`'s own
    ; first line) and the report is kept; the rest is a row.
    ;
    ; ★★ WHAT IS NOT HERE, each named with what it needs: `recursiveTypeRelatedTo`
    ; and `structuredTypeRelatedTo` (the recursion, with the relation CACHE, the
    ; depth limits and `getRelationKey`), `unionOrIntersectionRelatedTo`,
    ; `hasExcessProperties`, `hasCommonProperties`, the whole ERROR CHAIN and with
    ; it every message that is not the relation's own, `elaborateObjectLiteral` /
    ; `elaborateArrayLiteral` / `elaborateArrowFunction` / `elaborateJsxComponents`,
    ; `isTypeIdenticalTo` (the identity relation's own recursion) and
    ; `getNormalizedType`'s four non-literal arms.
    ;
    ; ★ ONLY `RelationAssignable` IS EVER PASSED, and that is a fact about the
    ; CALLERS rather than about this table — the three sites wired here are all
    ; `checkTypeAssignableToAndOptionallyElaborate`. The relation tests are
    ; transcribed as the reference writes them, on CheckMode's rule: a partial
    ; reading would make the next arm's test read as a new decision rather than as a
    ; transcription.

    ; isTypeRelatedTo, whole.
    ;
    ; ★★★ THE OBJECT/OBJECT CACHE LOOKUP WAS LEFT OUT WITH A PROOF THAT EXPIRED,
    ; AND IT STOOD FOR SEVENTEEN SLICES. It read: *`relation.get(id)` can only
    ; answer what `relation.set` wrote, and the only writer in relater.go is
    ; `recursiveTypeRelatedTo` — the recursion this slice does not have.* That
    ; recursion landed in slice 155 and nothing re-read the argument; the map got
    ; its writer in slice 172 and its absence had been costing a factor of NINETY
    ; on the shapes that ask the relation repeatedly. The lookup here is still not
    ; written, and now for a different and smaller reason: this entry point is
    ; reached before any comparison has been recursed into, so a row can only be
    ; present if `recursive_type_related_to` put it there — and that function asks
    ; first thing. Adding it here would save one call, not one comparison.
    procedure is_type_related_to(this, source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        var s: ref[Type] source
        if Checker.is_fresh_literal_type(s)
        {
            let sr Checker.literal_regular_type_of(s)
            if sr <> null
                set s: sr as ref[Type]
        }
        var t: ref[Type] target
        if Checker.is_fresh_literal_type(t)
        {
            let tr Checker.literal_regular_type_of(t)
            if tr <> null
                set t: tr as ref[Type]
        }
        if s = t
            return true
        if relation <> RelationIdentity
        {
            if relation = RelationComparable
            {
                if (t.flags & TypeFlagsNever) = 0
                {
                    if this.is_simple_type_related_to(t, s, relation)
                        return true
                }
            }
            if this.is_simple_type_related_to(s, t, relation)
                return true
        }
        else
        {
            ; "We have excluded types that may simplify to other forms, so types
            ; must have identical flags."
            if ((s.flags | t.flags) & (TypeFlagsUnionOrIntersection | TypeFlagsIndexedAccess | TypeFlagsConditional | TypeFlagsSubstitution)) = 0
            {
                if s.flags <> t.flags
                    return false
                if (s.flags & TypeFlagsSingleton) <> 0
                    return true
            }
        }
        if (s.flags & TypeFlagsStructuredOrInstantiable) <> 0
            return this.check_type_related_to(s, t, relation, null)
        if (t.flags & TypeFlagsStructuredOrInstantiable) <> 0
            return this.check_type_related_to(s, t, relation, null)
        false
    }

    ; isSimpleTypeRelatedTo, whole, and it is the content of this slice: fifteen
    ; arms over the two flag words, in the reference's order.
    ;
    ; ★★★ THE ORDER IS LOAD-BEARING BECAUSE THE FLAGS ARE NOT DISJOINT, which is
    ; the same sentence type_to_string's header carries one dimension over: an enum
    ; literal is a StringLiteral or a NumberLiteral as well, `boolean` is a Boolean
    ; and its two literals are BooleanLiterals, and `never` answers TRUE as a SOURCE
    ; and FALSE as a target — so the never arm has to sit between them.
    ;
    ; ★★★ THE ERROR REPORTER IS NOT A PARAMETER HERE, AND THE SIX ENUM ARMS ARE WHY.
    ; The reference threads an `ErrorReporter` through this function for exactly one
    ; consumer, `isEnumTypeRelatedTo`, which reports INTO THE CHAIN before the
    ; relation's own message and therefore decides the diagnostic's CODE. Every arm
    ; that needs it — the two enum-symbol arms and the three enum-LITERAL value
    ; comparisons — so the parameter has no reader here and every report inside
    ; is_enum_type_related_to is `errorReporter != nil`, i.e. dead under this
    ; port's one call shape. ★★THE SECOND HALF OF THIS NOTE EXPIRED IN SLICE 116
    ; (§3.5p). It said the enum arms *are unreachable besides: nothing in this port
    ; sets TypeFlagsEnum or TypeFlagsEnumLiteral on a type* — true from slice 72
    ; until the enum chapter, and false the moment create_computed_enum_type and
    ; get_enum_literal_type existed. Both are now live arms with live inputs.
    ; `source.AsLiteralType().value == target.AsLiteralType().value` — a Go `any`
    ; equality over the literal payload, asked at four sites in
    ; isSimpleTypeRelatedTo.
    ;
    ; ★★★ NaN IS NOT EQUAL TO ITSELF HERE AND THAT IS THE OPPOSITE OF
    ; get_enum_literal_type's rule, ten screens up. Go's `==` on an `any` holding a
    ; float64 is IEEE equality, so two NaN-valued enum members are UNRELATED under
    ; this relation — while the literal TABLE deliberately treats them as one key,
    ; because a Go map lookup on NaN misses and upstream keeps a second table for
    ; exactly that. Two rules, one value, and reading either as the other is a
    ; defect no fixture in this corpus can show.
    function literal_values_equal(a: ref[Type], b: ref[Type]) returns bool
    {
        if (a.flags & TypeFlagsNumberLiteral) <> 0
        {
            if (b.flags & TypeFlagsNumberLiteral) = 0
                return false
            let ab Checker.literal_bits_of(a)
            let bb Checker.literal_bits_of(b)
            if jsnum_is_nan(ab)
                return false
            if jsnum_is_nan(bb)
                return false
            return ab = bb
        }
        if (a.flags & TypeFlagsStringLiteral) <> 0
        {
            if (b.flags & TypeFlagsStringLiteral) = 0
                return false
            if Checker.literal_text_length_of(a) <> Checker.literal_text_length_of(b)
                return false
            return Checker.text_equals(Checker.literal_text_of(a), Checker.literal_text_of(b))
        }
        false
    }

    ; `sourceSymbol.Name != targetSymbol.Name` — the NAME test in front of
    ; isEnumTypeRelatedTo, asked null-safely because a type reaching the Enum arm
    ; without a symbol is representable in the type but not producible here.
    function symbol_names_equal(a: ref[Symbol]?, b: ref[Symbol]?) returns bool
    {
        if a = null
            return false
        if b = null
            return false
        let x a as ref[Symbol]
        let y b as ref[Symbol]
        if Symbol.name_len_of(x) <> Symbol.name_len_of(y)
            return false
        Checker.text_equals(Symbol.name_of(x), Symbol.name_of(y))
    }

    ; isEnumTypeRelatedTo, whole but for its MEMO. ★★ THE `enumRelation` CACHE IS
    ; NOT CARRIED and the argument is the one every dropped memo in this file
    ; needs: without an errorReporter this function is PURE — its only writes are
    ; through getEnumMemberValue, which is idempotent behind
    ; NodeCheckFlagsEnumValuesComputed — so the cache changes how long the answer
    ; takes and never what it is. ★It also carries the failed/succeeded
    ; distinction that exists ONLY to let a second call with a reporter re-report,
    ; which is the half this port has no caller for.
    ;
    ; ★ Both loops walk PROPERTIES rather than declarations, so a merged enum is
    ; compared as one symbol table, which is what the whole function is about.
    procedure is_enum_type_related_to(this, source: ref[Symbol]?, target: ref[Symbol]?) returns bool
    {
        if source = null
            return false
        if target = null
            return false
        var source_symbol source as ref[Symbol]
        var target_symbol target as ref[Symbol]
        if (Symbol.flags_of(source_symbol) & SymbolFlagsEnumMember) <> 0
        {
            let p this.get_parent_of_symbol(source_symbol)
            if p = null
                return false
            set source_symbol: p as ref[Symbol]
        }
        if (Symbol.flags_of(target_symbol) & SymbolFlagsEnumMember) <> 0
        {
            let p this.get_parent_of_symbol(target_symbol)
            if p = null
                return false
            set target_symbol: p as ref[Symbol]
        }
        if source_symbol = target_symbol
            return true
        if Checker.symbol_names_equal(source_symbol, target_symbol) = false
            return false
        if (Symbol.flags_of(source_symbol) & SymbolFlagsRegularEnum) = 0
            return false
        if (Symbol.flags_of(target_symbol) & SymbolFlagsRegularEnum) = 0
            return false
        let target_enum_type this.get_type_of_symbol(target_symbol)
        if target_enum_type = null
            return false
        let source_enum_type this.get_type_of_symbol(source_symbol)
        if source_enum_type = null
            return false
        ; ★★★ A NULL PROPERTY LIST IS AN EMPTY ONE: upstream's loop over the
        ; source enum's properties simply does not run, and the line after it is
        ; `enumRelation[key] = Succeeded; return true`. `enum E {}` declared twice
        ; answered NOT related here.
        let props this.get_properties_of_type(source_enum_type as ref[Type])
        if props = null
            return true
        let pl props as ref[Array[ref[Symbol]?]]
        let n pl.get_length() as int
        var i 0
        while i < n
        {
            let sp pl[i]
            if sp <> null
            {
                let source_property sp as ref[Symbol]
                if (Symbol.flags_of(source_property) & SymbolFlagsEnumMember) <> 0
                {
                    let tp this.get_property_of_type(target_enum_type as ref[Type], Symbol.name_of(source_property))
                    if tp = null
                        return false
                    let target_property tp as ref[Symbol]
                    if (Symbol.flags_of(target_property) & SymbolFlagsEnumMember) = 0
                        return false
                    let source_value this.get_enum_member_value(Checker.get_declaration_of_kind(source_property, KindEnumMember))
                    let target_value this.get_enum_member_value(Checker.get_declaration_of_kind(target_property, KindEnumMember))
                    if Checker.eval_values_equal(source_value, target_value) = false
                    {
                        ; "If we have 2 enums with *known* values that differ, they
                        ; are incompatible." Both known ⇒ false; otherwise at least
                        ; one is opaque (an ambient member, or one this port could
                        ; not compute) and is ASSUMED NUMERIC — so the pair is
                        ; incompatible exactly when the other one is a string.
                        if Checker.eval_has_value(source_value)
                        {
                            if Checker.eval_has_value(target_value)
                                return false
                        }
                        if Checker.eval_has_value(source_value)
                        {
                            if source_value.kind = EvalKindString
                                return false
                        }
                        if Checker.eval_has_value(target_value)
                        {
                            if target_value.kind = EvalKindString
                                return false
                        }
                    }
                }
            }
            set i: i + 1
        }
        true
    }

    ; `sourceValue != targetValue` on two evaluator results — Go `any` equality
    ; again, so a NONE is equal only to a NONE and NaN is equal to nothing (see
    ; literal_values_equal's header for why this file has two answers to that).
    function eval_values_equal(a: EvalResult, b: EvalResult) returns bool
    {
        ; ★ The presence question comes FIRST, for eval_has_value's reason: two
        ; no-value results are equal (`nil == nil`) whatever kind they carry, and a
        ; no-value is equal to nothing else — where a bare kind test made the
        ; String-null sentinel equal to the empty string.
        let a_has Checker.eval_has_value(a)
        let b_has Checker.eval_has_value(b)
        if a_has <> b_has
            return false
        if a_has = false
            return true
        if a.kind <> b.kind
            return false
        if a.kind = EvalKindNumber
        {
            if jsnum_is_nan(a.bits)
                return false
            if jsnum_is_nan(b.bits)
                return false
            return a.bits = b.bits
        }
        if a.text.length <> b.text.length
            return false
        Checker.text_equals(a.text, b.text)
    }

    procedure is_simple_type_related_to(this, source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        let s source.flags
        let t target.flags
        if (t & TypeFlagsAny) <> 0
            return true
        if (s & TypeFlagsNever) <> 0
            return true
        if source = wildcard_type
            return true
        if (t & TypeFlagsUnknown) <> 0
        {
            var excluded false
            if relation = RelationStrictSubtype
            {
                if (s & TypeFlagsAny) <> 0
                    set excluded: true
            }
            if excluded = false
                return true
        }
        if (t & TypeFlagsNever) <> 0
            return false
        if (s & TypeFlagsStringLike) <> 0
        {
            if (t & TypeFlagsString) <> 0
                return true
        }
        ; `s&StringLiteral && s&EnumLiteral && t&StringLiteral && !t&EnumLiteral &&
        ; source.value == target.value` — an enum member's literal type against the
        ; plain literal of the same text. The value comparison is a Go `any`
        ; equality over the payload; the arm reports rather than answering, on the
        ; enum rule in the header.
        if (s & (TypeFlagsStringLiteral | TypeFlagsEnumLiteral)) = (TypeFlagsStringLiteral | TypeFlagsEnumLiteral)
        {
            if (t & TypeFlagsStringLiteral) <> 0
            {
                if (t & TypeFlagsEnumLiteral) = 0
                {
                    if Checker.literal_values_equal(source, target)
                        return true
                }
            }
        }
        if (s & TypeFlagsNumberLike) <> 0
        {
            if (t & TypeFlagsNumber) <> 0
                return true
        }
        if (s & (TypeFlagsNumberLiteral | TypeFlagsEnumLiteral)) = (TypeFlagsNumberLiteral | TypeFlagsEnumLiteral)
        {
            if (t & TypeFlagsNumberLiteral) <> 0
            {
                if (t & TypeFlagsEnumLiteral) = 0
                {
                    if Checker.literal_values_equal(source, target)
                        return true
                }
            }
        }
        if (s & TypeFlagsBigIntLike) <> 0
        {
            if (t & TypeFlagsBigInt) <> 0
                return true
        }
        if (s & TypeFlagsBooleanLike) <> 0
        {
            if (t & TypeFlagsBoolean) <> 0
                return true
        }
        if (s & TypeFlagsESSymbolLike) <> 0
        {
            if (t & TypeFlagsESSymbol) <> 0
                return true
        }
        ; The two arms isEnumTypeRelatedTo stands behind: `Enum && Enum && same
        ; symbol NAME && isEnumTypeRelatedTo`, and the EnumLiteral pair below it.
        if (s & TypeFlagsEnum) <> 0
        {
            if (t & TypeFlagsEnum) <> 0
            {
                if Checker.symbol_names_equal(source.symbol, target.symbol)
                {
                    if this.is_enum_type_related_to(source.symbol, target.symbol)
                        return true
                }
            }
        }
        if (s & TypeFlagsEnumLiteral) <> 0
        {
            if (t & TypeFlagsEnumLiteral) <> 0
            {
                if (s & TypeFlagsUnion) <> 0
                {
                    if (t & TypeFlagsUnion) <> 0
                    {
                        if this.is_enum_type_related_to(source.symbol, target.symbol)
                            return true
                    }
                }
                if (s & TypeFlagsLiteral) <> 0
                {
                    if (t & TypeFlagsLiteral) <> 0
                    {
                        if Checker.literal_values_equal(source, target)
                        {
                            if this.is_enum_type_related_to(source.symbol, target.symbol)
                                return true
                        }
                    }
                }
            }
        }
        ; "In non-strictNullChecks mode, `undefined` and `null` are assignable to
        ; anything except `never`. Since unions and intersections may reduce to
        ; `never`, we exclude them here." strictNullChecks is TRUE under this
        ; harness (see strict_null_checks), so the first disjunct of each arm is
        ; dead and the second is the whole test — written as the reference's
        ; conjunction anyway, for the reason that accessor's header gives.
        if (s & TypeFlagsUndefined) <> 0
        {
            if Checker.strict_null_checks() = false
            {
                if (t & TypeFlagsUnionOrIntersection) = 0
                    return true
            }
            if (t & (TypeFlagsUndefined | TypeFlagsVoid)) <> 0
                return true
        }
        if (s & TypeFlagsNull) <> 0
        {
            if Checker.strict_null_checks() = false
            {
                if (t & TypeFlagsUnionOrIntersection) = 0
                    return true
            }
            if (t & TypeFlagsNull) <> 0
                return true
        }
        ; `s&Object && t&NonPrimitive && !(relation == strictSubtype &&
        ; isEmptyAnonymousObjectType(source) && !source.objectFlags&FreshLiteral)`.
        ; ★★★ THE NOTE HERE WAS A REACHABILITY CLAIM AND IT WAS TWICE WRONG: it read
        ; *the negated conjunct needs isEmptyAnonymousObjectType and cannot be
        ; reached: only the strict-subtype relation asks it and nothing passes one* —
        ; the predicate has been in this file since the emptiness chapter, and the
        ; frontier put 17 units on the arm. `is_empty_anonymous_object_type` may stop
        ; inside resolve_structured_type_members, and it is called BARE for the reason
        ; every other predicate in this chapter is: this function answers a bool and
        ; its callers read the mark.
        if (s & TypeFlagsObject) <> 0
        {
            if (t & TypeFlagsNonPrimitive) <> 0
            {
                if relation <> RelationStrictSubtype
                    return true
                var excluded false
                if this.is_empty_anonymous_object_type(source)
                {
                    if (source.object_flags & ObjectFlagsFreshLiteral) = 0
                        set excluded: true
                }
                if excluded = false
                    return true
            }
        }
        var enum_rules false
        if relation = RelationAssignable
            set enum_rules: true
        if relation = RelationComparable
            set enum_rules: true
        if enum_rules
        {
            if (s & TypeFlagsAny) <> 0
                return true
            ; "Type number is assignable to any computed numeric enum type or any
            ; numeric enum literal type, and a numeric literal type is assignable
            ; to any computed numeric enum type or any numeric enum literal type
            ; with a matching value. These rules exist such that enums can be used
            ; for bit-flag purposes."
            if (s & TypeFlagsNumber) <> 0
            {
                if (t & TypeFlagsEnum) <> 0
                    return true
                if (t & (TypeFlagsNumberLiteral | TypeFlagsEnumLiteral)) = (TypeFlagsNumberLiteral | TypeFlagsEnumLiteral)
                    return true
            }
            if (s & TypeFlagsNumberLiteral) <> 0
            {
                if (s & TypeFlagsEnumLiteral) = 0
                {
                    if (t & TypeFlagsEnum) <> 0
                        return true
                    if (t & (TypeFlagsNumberLiteral | TypeFlagsEnumLiteral)) = (TypeFlagsNumberLiteral | TypeFlagsEnumLiteral)
                    {
                        if Checker.literal_values_equal(source, target)
                            return true
                    }
                }
            }
            ; "Anything is assignable to a union containing undefined, null, and
            ; {}" — isUnknownLikeUnionType.
            ;
            ; ★★★ THE NOTE THAT LEFT THIS ARM OUT CARRIED ITS OWN EXPIRY AND
            ; NOBODY READ IT. It licensed the omission with a CONTAINMENT claim —
            ; *its test begins `t.flags&Union`, so a target it could answer TRUE
            ; for is a Union, and every Union stops one line later in
            ; is_type_related_to's structured branch; a false here can cost a unit
            ; its answer and can never cost it a wrong one* — which was true while
            ; the union branch of the relation was a stop and false from the slice
            ; that ported it. Nothing marks the day a containment argument turns
            ; into a wrong answer: the arm was silently inventing TS2322 at
            ; `let x: {} | null | undefined = u` for a `u: unknown`, at
            ; `a = x` into a `{} | null | undefined` for an unconstrained `T`, and
            ; wherever else a NonNullable-shaped source met such a target.
            if this.is_unknown_like_union_type(target)
                return true
        }
        false
    }

    ; isUnknownLikeUnionType. ★The ORDER of the first two constituents is the
    ; test — upstream reads `types[0]` and `types[1]`, not `some` — and it is
    ; sound because a union's constituents are sorted by type id and undefined
    ; and null are minted before anything a source file can write. ★The two
    ; ObjectFlags bits share their positions with two INTERSECTION flags; the
    ; `flags & Union` guard above them is what keeps the sharing safe.
    procedure is_unknown_like_union_type(this, t: ref[Type]) returns bool
    {
        if Checker.strict_null_checks() = false
            return false
        if (t.flags & TypeFlagsUnion) = 0
            return false
        if (t.object_flags & ObjectFlagsIsUnknownLikeUnionComputed) = 0
        {
            set t.object_flags: t.object_flags | ObjectFlagsIsUnknownLikeUnionComputed
            let types Checker.union_types_of(t)
            if types <> null
            {
                let list types as ref[Array[ref[Type]?]]
                if (list.get_length() as int) >= 3
                {
                    let first list[0]
                    let second list[1]
                    if first <> null
                    {
                        if second <> null
                        {
                            if ((first as ref[Type]).flags & TypeFlagsUndefined) <> 0
                            {
                                if ((second as ref[Type]).flags & TypeFlagsNull) <> 0
                                {
                                    if this.some_type_is_empty_anonymous_object(t)
                                        set t.object_flags: t.object_flags | ObjectFlagsIsUnknownLikeUnion
                                }
                            }
                        }
                    }
                }
            }
        }
        (t.object_flags & ObjectFlagsIsUnknownLikeUnion) <> 0
    }

    ; checkTypeRelatedToEx, minus three pieces with no input. The OVERFLOW branch
    ; needs the relation counter and the depth stacks, which belong to the
    ; recursion; the export-links RETRY is guarded by `headMessage != nil` and no
    ; site wired here passes one; and the diagnostic is built from the error CHAIN,
    ; which in this slice never holds more than the relation's own message — so it
    ; is emitted at its line, in report_relation_error, rather than assembled here.
    ; ★The reference's `reportErrors` parameter is `errorNode != nil` at every one
    ; of its own call sites, which is why this port carries the node alone.
    ; ★★★ THE RELATION STATE IS SAVED AND RESTORED HERE, AND THAT IS `getRelater`
    ; / `putRelater` WITH NO POOL. Upstream every top-level comparison takes a
    ; Relater of its own out of a pool and hands it back, so its overflow flag, its
    ; maybe stack and its two depth stacks belong to that ONE comparison; this port
    ; collapsed them onto the checker, where they are shared.
    ;
    ; ★★★ AND THE RELATION RE-ENTERS ITSELF, so sharing them is not a theoretical
    ; hazard: `is_known_property` asks `get_applicable_index_info_for_name`, which
    ; goes through `find_applicable_index_info` to `is_applicable_index_type`, whose
    ; first line is `is_type_assignable_to` — a second top-level comparison started
    ; from inside the first. Without this save the inner one inherits the outer's
    ; in-progress pairs (so a cycle is reported where upstream has none) and its
    ; depth counters (so the 100-frame limit trips early), and `rel_overflow` — set
    ; once, never cleared — would make every later relation in the FILE answer
    ; false. **A field that upstream allocates per call needs the save at the line
    ; where upstream allocates it.**
    procedure check_type_related_to(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?) returns bool
        this.check_type_related_to_ex(source, target, relation, error_node, 0)

    ; the capture (see `relation_capture`) sits on BOTH entries: the elaborating one above and
    ; this direct one, which the `this`-argument check of isSignatureApplicable uses
    procedure check_type_related_to_ex(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, head_code: int) returns bool
    {
        let capture_from diagnostics.length()
        let answer this.check_type_related_to_ex_worker(source, target, relation, error_node, head_code)
        if relation_capture_on
        {
            var ci capture_from
            while ci < diagnostics.length()
            {
                var seen false
                var k 0
                while k < (relation_capture.get_length() as int)
                {
                    if relation_capture[k as size_t] = ci
                        set seen: true
                    set k: k + 1
                }
                if seen = false
                    relation_capture.add(ci)
                set ci: ci + 1
            }
        }
        answer
    }

    procedure check_type_related_to_ex_worker(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, head_code: int) returns bool
    {
        let save_head rel_head_code
        set rel_head_code: head_code
        let save_chain rel_error_chain
        let save_error_node rel_error_node
        set rel_error_chain: null
        set rel_error_node: error_node
        let save_overflow rel_overflow
        let save_maybe rel_maybe_depth
        let save_source rel_source_depth
        let save_target rel_target_depth
        let save_maybe_base rel_maybe_base
        let save_source_base rel_source_base
        let save_target_base rel_target_base
        let save_maybe_hits rel_maybe_hits
        let save_unknown_hits rel_unknown_hits
        let save_expanding rel_expanding_flags
        let save_count rel_relation_count
        let save_nesting rel_related_nesting
        set rel_related_nesting: 0
        set rel_overflow: false
        ; A fresh Relater: its view of the shared arrays starts HERE (see
        ; rel_maybe_base), and its Ternary counters are its own.
        set rel_maybe_base: rel_maybe_depth
        set rel_source_base: rel_source_depth
        set rel_target_base: rel_target_depth
        set rel_expanding_flags: ExpandingFlagsNone
        ; `r.relationCount = (16_000_000 - relation.size()) / 8` — the budget is
        ; what the relation's cache has NOT already spent, so a file whose earlier
        ; comparisons filled the table gets a smaller one. It is saved and restored
        ; with the rest of the relater state for the reason that block's header
        ; gives: this port shares one relater where upstream takes a fresh one.
        set rel_relation_count: (16000000 - rel_result_counts[relation as size_t]) / 8
        let answer this.is_related_to_ex(source, target, relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
        ; ★★★ THE ONE EMISSION, AND IT IS THE WHOLE POINT OF THE CHAIN. Upstream
        ; this is `c.reportDiagnostic(createDiagnosticChainFromErrorChain(...))`
        ; under `else if r.errorChain != nil`, i.e. whenever anything reported —
        ; the chain is written only on a failing level, so the condition is the
        ; failure. Every level under here has PREPENDED, so the head is the
        ; outermost message and the inner ones are links a `D` line cannot show.
        ;
        ; ★★★ AND IT IS AN `else if` UPSTREAM, WHICH IS THE WHOLE OF THE OVERFLOW
        ; ARM'S PLACEMENT. A comparison that overflowed reports the LIMITER's own
        ; message at this node and nothing else: whatever levels underneath it had
        ; already prepended describes a walk that was abandoned, so emitting the
        ; chain as well would report a mismatch the reference never reaches.
        if rel_overflow
        {
            ; `relation.set(id, Failed | <which limiter tripped>)` — *record this
            ; relation as having failed such that we don't attempt the overflowing
            ; operation again*. The bit is what tells a later ask that the row is
            ; the limiter's verdict and not a comparison's.
            var bits RelationComparisonResultStackDepthOverflow
            if rel_relation_count <= 0
                set bits: RelationComparisonResultComplexityOverflow
            var overflow_constrained false
            let overflow_key this.get_relation_key(source, target, IntersectionStateNone, relation = RelationIdentity, false, &overflow_constrained)
            this.rel_result_set(relation, overflow_key, RelationComparisonResultFailed | bits)
            var code DiagExcessive_stack_depth_comparing_types_0_and_1
            if rel_relation_count <= 0
                set code: DiagExcessive_complexity_comparing_types_0_and_1
            ; `if errorNode == nil { errorNode = c.currentNode }` — the limiter
            ; reports even where the caller asked for no message, because a
            ; comparison it abandoned is not an answer about the two types.
            ;
            ; ★★★ AND THIS IS WHERE THE ONE KNOWN DIVERGENCE SITS: ONE REPORT PER
            ; ASK. On `excessivelyDeepConditionalTypes` this arm fires SEVEN times
            ; at the node where the reference reports five (the second node, four,
            ; agrees exactly), so the unit is a `diagcheck` inconsistency it was
            ; not before — printing nothing is a subsequence of anything, and this
            ; port used to print nothing. `infiniteConstraints` carries one report
            ; where the reference emits none. Both units were already FAIL, and
            ; `tools/diagcensus.py --by-unit TS2321` is where the pair is read. What it is NOT: the cached replay above
            ; never fires on that unit (probed by giving it a distinct code, 0 of
            ; 11), and `isTypeRelatedTo`'s object-pair cache probe — the one line
            ; of upstream's that reads this row without reporting, and which this
            ; port does not have — changes the count by NOTHING when added
            ; (measured, then taken back out unshipped). What remains is that this
            ; port ASKS more often, or spends its budget faster for the same work:
            ; it promotes far fewer maybe keys into the cache than upstream does
            ; (the counter at `rel_maybe_hits`, slice 172), so the same comparison
            ; costs it more rows. **A limiter ported faithfully still disagrees
            ; where the thing it limits is not the same size.**
            var at error_node
            if at = null
                set at: current_node
            ; ★ `c.TypeToString(source), c.TypeToString(target)` — the message's two
            ; arguments are PRINTED here upstream, and printing a conditional type reduces
            ; its members' apparent types, which asks and memoizes base constraints the
            ; comparisons that follow then find (slice 214): without the two prints the port
            ; overflowed twice more at the same node (`excessivelyDeepConditionalTypes`).
            let overflow_source this.type_arg(source)
            let overflow_target this.type_arg(target)
            this.error_on_node(at, code, overflow_source, overflow_target)
        }
        if rel_overflow = false
        {
            if rel_error_chain <> null
                this.emit_error_chain()
        }
        set rel_head_code: save_head
        set rel_error_chain: save_chain
        set rel_error_node: save_error_node
        set rel_overflow: save_overflow
        set rel_maybe_depth: save_maybe
        set rel_source_depth: save_source
        set rel_target_depth: save_target
        set rel_maybe_base: save_maybe_base
        set rel_source_base: save_source_base
        set rel_target_base: save_target_base
        set rel_maybe_hits: save_maybe_hits
        set rel_unknown_hits: save_unknown_hits
        set rel_expanding_flags: save_expanding
        set rel_relation_count: save_count
        set rel_related_nesting: save_nesting
        answer
    }

    ; getNormalizedType — the FIXPOINT, at the three of its six arms this port can
    ; take (slice 166). It replaces the two hand-inlined blocks that stood at
    ; is_related_to_ex's head, and it is what closes §3.5gm.
    ;
    ; ★★★ THE `writing` FLAG IS THE WHOLE ASYMMETRY AND IT IS THE REFERENCE'S OWN:
    ; the SOURCE is normalized with false and the TARGET with true. The reference's
    ; comment at the call names the reason for the substitution arm — *resolve
    ; substitution types to either the substitution (on the source side) or the
    ; type variable (on the target side)* — and the same flag now steers every
    ; distribution inside get_simplified_type, where reading a `T[A | B]` yields a
    ; union and writing to one yields an intersection.
    ;
    ; ★★★ THE LOOP IS NOT DECORATION. The three arms feed each other — a
    ; simplification can answer a substitution and a substitution's intersection
    ; can be simplifiable — and upstream runs them to a fixpoint. The straight-line
    ; pair this replaces took each arm at most once, which was the identity on
    ; everything the port could then mint and is not any more.
    ;
    ; ★★★ ALL SIX ARMS SINCE SLICE 202. The three that stood as the IDENTITY —
    ; the generic tuple (getNormalizedTupleType), the deferred reference
    ; (createTypeReference / getSingleBaseForNonAugmentingSubtype) and the
    ; union/intersection normalization (getNormalizedUnionOrIntersectionType) —
    ; were not neutral: `class TypeSymbol extends Symbol {}` normalizes to
    ; `Symbol`, so a `TypeSymbol → Symbol` relation is `source == target` upstream
    ; and never compares the members, where this port compared them, re-inferred
    ; the base method's return type INSIDE its own inference and reported TS2454
    ; twice (`recursiveComplicatedClasses`).
    procedure normalize_relation_operand(this, t: ref[Type], writing: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        var cur t
        var moving true
        while moving
        {
            set moving: false
            var next: ref[Type]? null
            if Checker.is_fresh_literal_type(cur)
                set next: Checker.literal_regular_type_of(cur)
            if next = null
            {
                if (cur.flags & TypeFlagsSubstitution) <> 0
                {
                    if writing
                        set next: Checker.substitution_base_type_of(cur)
                    else
                    {
                        set next: this.get_substitution_intersection(cur)
                        if this.unported_mark() <> mark
                            return null
                    }
                }
            }
            ; ★★★ THE SIMPLIFIABLE ARM IS TAKEN SINCE SLICE 168, AND WHAT HELD IT
            ; BACK WAS TWO DEFECTS ELSEWHERE — the note that stood here was right
            ; that neither cause was in this chapter and wrong about both of them.
            ; It named `varianceComputationNoCrash`'s invented TS2322 as *the
            ; constraint of that conditional*: it was the ERROR CHAIN's missing
            ; UNDO, a defect slice 167 created one slice before the note was read
            ; again (structured_type_related_to). And it named
            ; `distributiveConditionalBaseConstraint`'s invented TS2344 as *the
            ; relation over the resulting union*: it was the base-constraint MEMO,
            ; which lived on the type parameter alone, so a CONDITIONAL's base
            ; constraint was recomputed on every ask and the recomputation
            ; re-entered its own resolution frame and came back CIRCULAR — see
            ; Type.resolved_base_constraint. With both closed the arm is green on
            ; both gates and the wall `relation-over-simplified-type` is gone.
            ; ★It was the row `simplified-indexed-access-mapped-object` carried
            ; from slice 157 and the frontier's head at slice 168 (+44 units).
            if next = null
            {
                if (cur.flags & TypeFlagsSimplifiable) <> 0
                {
                    let simplified this.get_simplified_type(cur, writing)
                    if this.unported_mark() <> mark
                        return null
                    if simplified = null
                        return null
                    set next: simplified
                }
            }
            ; ★★★ getNormalizedUnionOrIntersectionType's FIRST LINE, taken since
            ; slice 170 — `if reduced := getReducedType(t); reduced != t { return
            ; reduced }`. Its whole point is that a REDUCED intersection is `never`
            ; and never is related to everything, so a relation asked about the
            ; unreduced type invents a report: `objectSpread`'s TS2739 was exactly
            ; that, an intersection the printer already answered `never` for. The
            ; SECOND half — `shouldNormalizeIntersection` and its cross-product —
            ; stays out and keeps a row of its own
            ; (`intersectionWithUnionConstraint`), for the reason the header names:
            ; an identity is left out rather than stopped where a stop would take
            ; correct answers out of MATCH.
            if next = null
            {
                if Checker.is_generic_tuple_type(cur)
                {
                    let nt this.get_normalized_tuple_type(cur, writing)
                    if this.unported_mark() <> mark
                        return null
                    if nt = null
                        return null
                    set next: nt
                }
            }
            if next = null
            {
                if (cur.object_flags & ObjectFlagsReference) <> 0
                {
                    if Checker.reference_node_of(cur) <> null
                    {
                        let args this.get_type_arguments(cur)
                        if this.unported_mark() <> mark
                            return null
                        set next: this.create_type_reference(Checker.get_target_type(cur), args, 0)
                    }
                    else
                    {
                        let sb this.get_single_base_for_non_augmenting_subtype(cur)
                        if this.unported_mark() <> mark
                            return null
                        if sb <> null
                            set next: sb
                    }
                }
            }
            if next = null
            {
                if (cur.flags & TypeFlagsUnionOrIntersection) <> 0
                {
                    let nu this.get_normalized_union_or_intersection_type(cur, writing)
                    if this.unported_mark() <> mark
                        return null
                    if nu = null
                        return null
                    set next: nu
                }
            }
            if next <> null
            {
                let n next as ref[Type]
                if n <> cur
                {
                    set cur: n
                    set moving: true
                }
            }
        }
        cur
    }

    ; getNormalizedTupleType — a generic tuple whose SIMPLIFIABLE elements
    ; simplify is rebuilt over the simplified elements.
    procedure get_normalized_tuple_type(this, t: ref[Type], writing: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let elements this.get_element_types(t)
        if this.unported_mark() <> mark
            return null
        if elements = null
            return t
        let el elements as ref[Array[ref[Type]?]]
        let n el.get_length() as int
        let normalized this.new_type_list(null)
        var changed false
        var i 0
        while i < n
        {
            let e el[i]
            var ne e
            if e <> null
            {
                if ((e as ref[Type]).flags & TypeFlagsSimplifiable) <> 0
                {
                    let simplified this.get_simplified_type(e as ref[Type], writing)
                    if this.unported_mark() <> mark
                        return null
                    if simplified = null
                        return null
                    set ne: simplified
                    if simplified <> e
                        set changed: true
                }
            }
            normalized.add(ne)
            set i: i + 1
        }
        if changed = false
            return t
        this.create_normalized_tuple_type(Checker.get_target_type(t), normalized)
    }

    ; getNormalizedUnionOrIntersectionType — the reduced type when reduction
    ; changes it; else an intersection that SHOULD normalize (an instantiable
    ; member beside a nullable or empty one) is rebuilt over its normalized
    ; members: `Partial<T>[K] & ({} | null)` becomes `T[K] & {} | T[K] & null`.
    procedure get_normalized_union_or_intersection_type(this, t: ref[Type], writing: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let reduced this.get_reduced_type(t)
        if this.unported_mark() <> mark
            return null
        if reduced = null
            return null
        if (reduced as ref[Type]) <> t
            return reduced
        if (t.flags & TypeFlagsIntersection) = 0
            return t
        if this.should_normalize_intersection(t) = false
            return t
        let types Checker.union_or_intersection_types_of(t)
        if types = null
            return t
        let tl types as ref[Array[ref[Type]?]]
        let n tl.get_length() as int
        let normalized &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let u tl[i]
            var nu u
            if u <> null
            {
                let nn this.normalize_relation_operand(u as ref[Type], writing)
                if this.unported_mark() <> mark
                    return null
                if nn = null
                    return null
                set nu: nn
                if nn <> u
                    set changed: true
            }
            normalized.add(nu)
            set i: i + 1
        }
        if changed = false
            return t
        this.get_intersection_type(normalized)
    }

    ; shouldNormalizeIntersection — an instantiable member AND a nullable-or-empty
    ; member among the constituents.
    procedure should_normalize_intersection(this, t: ref[Type]) returns bool
    {
        let types Checker.union_or_intersection_types_of(t)
        if types = null
            return false
        let tl types as ref[Array[ref[Type]?]]
        let n tl.get_length() as int
        var has_instantiable false
        var has_nullable_or_empty false
        var i 0
        while i < n
        {
            let u tl[i]
            if u <> null
            {
                let ut u as ref[Type]
                if (ut.flags & TypeFlagsInstantiable) <> 0
                    set has_instantiable: true
                if (ut.flags & TypeFlagsNullable) <> 0
                    set has_nullable_or_empty: true
                if has_nullable_or_empty = false
                {
                    if this.is_empty_anonymous_object_type(ut)
                        set has_nullable_or_empty: true
                }
                if has_instantiable
                {
                    if has_nullable_or_empty
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; Relater.isRelatedToEx — its head, up to the point where the reference decides
    ; between `unionOrIntersectionRelatedTo` and `recursiveTypeRelatedTo`.
    procedure is_related_to_ex(this, original_source: ref[Type], original_target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int, recursion_flags: int) returns bool
    {
        set rel_related_nesting: rel_related_nesting + 1
        let answer this.is_related_to_ex_nested(original_source, original_target, relation, error_node, intersection_state, recursion_flags)
        set rel_related_nesting: rel_related_nesting - 1
        answer
    }

    procedure is_related_to_ex_nested(this, original_source: ref[Type], original_target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int, recursion_flags: int) returns bool
    {
        let mark this.unported_mark()
        if original_source = original_target
            return true
        ; "Before normalization: if `source` is an object type, and `target` is
        ; primitive, skip all the checks we don't need and just return
        ; isSimpleTypeRelatedTo's result."
        if (original_source.flags & TypeFlagsObject) <> 0
        {
            if (original_target.flags & TypeFlagsPrimitive) <> 0
            {
                if relation = RelationComparable
                {
                    if (original_target.flags & TypeFlagsNever) = 0
                    {
                        if this.is_simple_type_related_to(original_target, original_source, relation)
                            return true
                    }
                }
                if this.is_simple_type_related_to(original_source, original_target, relation)
                    return true
                ; ★The reference's own exception, and it is why the reporter takes
                ; both pairs: here it passes the ORIGINALS for both roles, because
                ; there is no normalized pair yet.
                if error_node <> null
                    this.report_error_results(original_source, original_target, original_source, original_target, relation, mark)
                return false
            }
        }
        ; "Normalize the source and target types: turn fresh literal types into
        ; regular literal types, turn deferred type references into regular type
        ; references, simplify indexed access and conditional types, and resolve
        ; substitution types to either the substitution (on the source side) or
        ; the type variable (on the target side)." ★The flag is the reference's:
        ; false for the source, TRUE for the target.
        let normalized_source this.normalize_relation_operand(original_source, false)
        if this.unported_mark() <> mark
            return false
        if normalized_source = null
            return false
        let normalized_target this.normalize_relation_operand(original_target, true)
        if this.unported_mark() <> mark
            return false
        if normalized_target = null
            return false
        let source normalized_source as ref[Type]
        var target: ref[Type] normalized_target as ref[Type]
        if source = target
            return true
        ; ★★★ THE IDENTITY RELATION GOES STRAIGHT INTO THE RECURSION, and this is
        ; slice 117's TS2403 finding closed at its own line: the stop that used to
        ; stand here made `isTypeIdenticalTo` answer *not identical* for any two
        ; STRUCTURED types, and reading that as a `no` reported TS2403 on 37 units
        ; of the stage-2 corpus. It now stops at `properties-identical-to` instead
        ; — one function deeper, where the missing thing actually is. ★The
        ; reference passes `false` for reportErrors and IntersectionStateNone here
        ; and both are the transcription, not a simplification.
        if relation = RelationIdentity
        {
            if source.flags <> target.flags
                return false
            if (source.flags & TypeFlagsSingleton) <> 0
                return true
            return this.recursive_type_related_to(source, target, relation, null, IntersectionStateNone, recursion_flags)
        }
        ; "We fastpath comparing a type parameter to exactly its constraint, as
        ; this is _super_ common." getConstraintOfType is
        ; getConstraintOfTypeParameter for the one flag this arm tests.
        if (source.flags & TypeFlagsTypeParameter) <> 0
        {
            let constraint this.get_constraint_of_type_parameter(source)
            if constraint <> null
            {
                if (constraint as ref[Type]) = target
                    return true
            }
        }
        ; "See if we're relating a definitely non-nullable type to a union that
        ; includes null and/or undefined plus a single non-nullable type. If so,
        ; remove null and/or undefined from the target type."
        if (source.flags & TypeFlagsDefinitelyNonNullable) <> 0
        {
            if (target.flags & TypeFlagsUnion) <> 0
            {
                let types Checker.union_types_of(target)
                if types <> null
                {
                    let list types as ref[Array[ref[Type]?]]
                    let n list.get_length() as int
                    var candidate: ref[Type]? null
                    if n = 2
                    {
                        let t0 list[0]
                        if t0 <> null
                        {
                            if ((t0 as ref[Type]).flags & TypeFlagsNullable) <> 0
                                set candidate: list[1]
                        }
                    }
                    if n = 3
                    {
                        let t0 list[0]
                        let t1 list[1]
                        if t0 <> null
                        {
                            if t1 <> null
                            {
                                if ((t0 as ref[Type]).flags & TypeFlagsNullable) <> 0
                                {
                                    if ((t1 as ref[Type]).flags & TypeFlagsNullable) <> 0
                                        set candidate: list[2]
                                }
                            }
                        }
                    }
                    if candidate <> null
                    {
                        let c candidate as ref[Type]
                        if (c.flags & TypeFlagsNullable) = 0
                        {
                            ; getNormalizedType again, at the same three arms
                            ; and the same WRITING polarity as the head (166).
                            let renormalized this.normalize_relation_operand(c, true)
                            if this.unported_mark() <> mark
                                return false
                            if renormalized = null
                                return false
                            set target: renormalized as ref[Type]
                            if source = target
                                return true
                        }
                    }
                }
            }
        }
        if relation = RelationComparable
        {
            if (target.flags & TypeFlagsNever) = 0
            {
                if this.is_simple_type_related_to(target, source, relation)
                    return true
            }
        }
        if this.is_simple_type_related_to(source, target, relation)
            return true
        var structured false
        if (source.flags & TypeFlagsStructuredOrInstantiable) <> 0
            set structured: true
        if (target.flags & TypeFlagsStructuredOrInstantiable) <> 0
            set structured: true
        if structured
        {
            ; ★★★ THE FORK, AND SLICE 102's CLOSING PARAGRAPH PRICED IT AT THE
            ; WRONG HALF. It read *"the thing that removes all three rows is
            ; `typeRelatedToSomeType`, which needs `recursiveTypeRelatedTo`, the
            ; relation cache and `getRelationKey` under it."* The reference's own
            ; `skipCaching` line is what says otherwise: a comparison whose TARGET
            ; is a union of fewer than four constituents and whose SOURCE is not
            ; structured goes to `unionOrIntersectionRelatedTo` DIRECTLY, past the
            ; cache and past the recursion — and that is exactly the shape
            ; `checkArithmeticOperandType` makes, every time, with `number|bigint`.
            ; The cache is not under this door; it is under the other one.
            let fork_mark this.unported_mark()
            ; isPerformingExcessPropertyChecks, and the call it now guards.
            ;
            ; ★★★ THE RELATION ERROR ON THE NEXT LINE IS WRITTEN SINCE SLICE 167 AND
            ; IT ADDS NOTHING — WHICH IS THE POINT. `reportRelationError` opens its
            ; suppression switch on the chain's HEAD, and the first case is the two
            ; excess-property messages: a relation that failed BECAUSE of an excess
            ; property reports the excess property and nothing else. tsc prints
            ; TS2353 for `let x: {a: number} = {a: 1, b: 2}` and no TS2322 with it.
            ; Until the chain existed the call could not be written at all — a
            ; chain-free reporter would have emitted the TS2322 as a second line,
            ; the one direction a subsequence relation can see — so the port left it
            ; out and relied on the early return for the same answer.
            var excess false
            if (intersection_state & IntersectionStateTarget) = 0
            {
                if Checker.is_object_literal_type(source)
                {
                    if (source.object_flags & ObjectFlagsFreshLiteral) <> 0
                        set excess: true
                }
            }
            if excess
            {
                if this.has_excess_properties(source, target, relation, error_node)
                {
                    if error_node <> null
                        this.report_relation_error(source, target, relation)
                    return this.record_fork(source, target, 0, 0 - 1, fork_mark, false)
                }
            }
            ; isPerformingCommonPropertyChecks — SEVEN conjuncts, of which four are
            ; cheap and decidable here and three are not. ★★★The four are asked
            ; FIRST and each one that is false ends the question, which is what
            ; makes this a containment rather than a stop: a UNION target fails the
            ; fourth outright (`target.flags & (Object|Intersection)` is 0), so the
            ; whole population this slice is named after never reaches the report.
            ; ★What is left needs `globalObjectType` — the globals table, §3.11 —
            ; `isWeakType`, and `hasCommonProperties` with it.
            var common true
            if relation = RelationComparable
            {
                ; isUnitType(source)
                if (source.flags & TypeFlagsUnit) = 0
                    set common: false
            }
            if (intersection_state & IntersectionStateTarget) <> 0
                set common: false
            if (source.flags & (TypeFlagsPrimitive | TypeFlagsObject | TypeFlagsIntersection)) = 0
                set common: false
            if (target.flags & (TypeFlagsObject | TypeFlagsIntersection)) = 0
                set common: false
            ; The three conjuncts slice 102 could not ask, in the reference's order.
            ; ★`source != globalObjectType` is asked through the accessor rather
            ; than against a null, because a lib this port failed to load answers
            ; null and null is not a type any source can BE — so the conjunct holds,
            ; which is the reference's own answer when `Object` is not declared.
            if common
            {
                let got this.get_global_object_type()
                if got <> null
                {
                    if source = (got as ref[Type])
                        set common: false
                }
            }
            if common
            {
                if this.is_weak_type(target) = false
                    set common: false
            }
            if common
            {
                var populated false
                let sprops this.get_properties_of_type(source)
                if sprops <> null
                {
                    if ((sprops as ref[Array[ref[Symbol]?]]).get_length() as int) > 0
                        set populated: true
                }
                if populated = false
                {
                    if this.type_has_call_or_construct_signatures(source)
                        set populated: true
                }
                if populated = false
                    set common: false
            }
            var is_comparing_jsx_attributes false
            if (source.object_flags & ObjectFlagsJsxAttributes) <> 0
                set is_comparing_jsx_attributes: true
            if common
            {
                if this.has_common_properties(source, target, is_comparing_jsx_attributes) = false
                {
                    ; ★★★ TS2559 AND TS2560, WRITTEN SINCE SLICE 167. The fork
                    ; between them asks whether the RETURN TYPE of the source's
                    ; first call or construct signature relates to the target — a
                    ; relation asked from inside a relation, with reportErrors
                    ; FALSE, so it adds nothing to the chain — and on a hit the
                    ; message is *did you mean to CALL it*. It was a stop for as
                    ; long as this port had nowhere to put a message that is not the
                    ; diagnostic's own code: the arm RETURNS without reaching
                    ; report_error_results, so its entry is the chain's head and the
                    ; head is what a `D` line carries.
                    if error_node <> null
                    {
                        var ncp_source_type source
                        if original_source.alias_symbol <> null
                            set ncp_source_type: original_source
                        var ncp_target_type target
                        if original_target.alias_symbol <> null
                            set ncp_target_type: original_target
                        let source_string this.type_arg(ncp_source_type)
                        let target_string this.type_arg(ncp_target_type)
                        let ncp_mark this.unported_mark()
                        var meant_call false
                        let calls this.get_signatures_of_type(source, SignatureKindCall)
                        if calls <> null
                        {
                            let cl calls as ref[Array[ref[Signature]?]]
                            if (cl.get_length() as int) > 0
                            {
                                let sig0 cl[0]
                                if sig0 <> null
                                {
                                    let rt this.get_return_type_of_signature(sig0 as ref[Signature])
                                    if rt <> null
                                    {
                                        if this.is_related_to_ex(rt as ref[Type], target, relation, null, IntersectionStateNone, RecursionFlagsSource)
                                            set meant_call: true
                                    }
                                }
                            }
                        }
                        if meant_call = false
                        {
                            let constructs this.get_signatures_of_type(source, SignatureKindConstruct)
                            if constructs <> null
                            {
                                let kl constructs as ref[Array[ref[Signature]?]]
                                if (kl.get_length() as int) > 0
                                {
                                    let sig0 kl[0]
                                    if sig0 <> null
                                    {
                                        let rt this.get_return_type_of_signature(sig0 as ref[Signature])
                                        if rt <> null
                                        {
                                            if this.is_related_to_ex(rt as ref[Type], target, relation, null, IntersectionStateNone, RecursionFlagsSource)
                                                set meant_call: true
                                        }
                                    }
                                }
                            }
                        }
                        ; ★A stop under either sub-relation leaves the fork
                        ; undecided, and the two codes differ — so the mark decides
                        ; whether anything is reported at all, exactly as every
                        ; other report in this chapter reads it.
                        if this.unported_mark() = ncp_mark
                        {
                            var ncp_code DiagType_0_has_no_properties_in_common_with_type_1
                            if meant_call
                                set ncp_code: DiagValue_of_type_0_has_no_properties_in_common_with_type_1_Did_you_mean_to_call_it
                            this.report_error(ncp_code, source, target, source_string, target_string)
                        }
                    }
                    return this.record_fork(source, target, 1, 0 - 1, fork_mark, false)
                }
            }
            ; traceUnionsOrIntersectionsTooLarge is NOT a row: its first line is
            ; `if r.c.tracer == nil { return }`, this port has no tracer, and a
            ; function whose whole body is behind an absent handle has no behaviour
            ; to port. Named here rather than silently skipped.
            ;
            ; skipCaching, whole. ★Both disjuncts test a union's LENGTH against 4,
            ; and the reference's asymmetry is deliberate — the source side asks
            ; that the target NOT be a union, the target side that the source not
            ; be structured at all.
            var skip_caching false
            if (source.flags & TypeFlagsUnion) <> 0
            {
                if (target.flags & TypeFlagsUnion) = 0
                {
                    let sl Checker.union_types_of(source)
                    if sl <> null
                    {
                        if (((sl as ref[Array[ref[Type]?]]).get_length()) as int) < 4
                            set skip_caching: true
                    }
                }
            }
            if (target.flags & TypeFlagsUnion) <> 0
            {
                if (source.flags & TypeFlagsStructuredOrInstantiable) = 0
                {
                    let tl Checker.union_types_of(target)
                    if tl <> null
                    {
                        if (((tl as ref[Array[ref[Type]?]]).get_length()) as int) < 4
                            set skip_caching: true
                    }
                }
            }
            var result false
            var branch 0 - 1
            if skip_caching
                set result: this.union_or_intersection_related_to(source, target, relation, error_node, intersection_state, &branch)
            else
                set result: this.recursive_type_related_to(source, target, relation, error_node, intersection_state, recursion_flags)
            var route 3
            if skip_caching
                set route: 2
            if this.record_fork(source, target, route, branch, fork_mark, result)
                return true
        }
        ; ★★★ BOTH PAIRS SINCE SLICE 167. The reference hands the reporter the
        ; ORIGINAL pair and the NORMALIZED one and lets it choose between them; the
        ; port passed the normalized pair alone for as long as it made neither of
        ; the two swaps, and it makes the second one now — the alias half stays
        ; absent for `Type.alias`'s reason, the single-base half is written.
        if error_node <> null
            this.report_error_results(original_source, original_target, source, target, relation, mark)
        false
    }

    ; The FORKPIN's entry — see ForkEvent's header. It ANSWERS as well as records,
    ; for record_kind's reason: every exit of the structured branch is one line, so
    ; an exit cannot be added without a row. ★The verdict is 2 whenever anything
    ; stopped under the call, read off the MARK rather than off the answer — a
    ; sub-relation whose own arm gave up returns false, and false-because-unrelated
    ; and false-because-unanswered are the two states this chapter turns on.
    procedure record_fork(this, source: ref[Type], target: ref[Type], route: int, branch: int, mark: int, answer: bool) returns bool
    {
        var verdict 0
        if answer
            set verdict: 1
        if this.unported_mark() <> mark
            set verdict: 2
        if record_events
        {
            let ev &ForkEvent^host(source.flags, target.flags, route, branch, verdict)
            fork_log.add(ev as ref[ForkEvent])
        }
        answer
    }

    ; unionOrIntersectionRelatedTo, whole — the half of the structured fork this
    ; slice ports, and the reason its own comment leads with an ORDER: *"we need to
    ; deconstruct unions before intersections (because unions are always at the
    ; top), and we need to handle 'each' relations before 'some' relations for the
    ; same kind of type."* The four tests below are therefore a CHAIN and not a
    ; switch, and re-ordering any two of them is a different function.
    ;
    ; ★★★ THE THREE INTERSECTION ARMS WERE STOPPED UNDER A PRODUCER PREMISE THAT
    ; HAD EXPIRED — *"`TypeData` has no Intersection arm, so nothing this checker
    ; can mint carries TypeFlagsIntersection"* — which stopped being true at slice
    ; 121, and the arms' own tag counts had been the counter-example for a month
    ; (142 and 87 units at slice 155's stage 2). They are ported here; §3.5gk.
    ; ★The COMPARABLE hoist keeps an argument of its own and it is about the
    ; RELATION rather than about the type: only RelationAssignable is ever passed
    ; today (see the relation table's own note), so the hoist is written for
    ; fidelity and has no input — which is a claim about a CALLER and expires the
    ; day one passes the comparable relation, not a claim about what can be minted.
    ;
    ; ★★ `branch_out` is the FORKPIN's second column and it is an out-cell rather
    ; than a return, because the answer is a bool and the arm that produced it is
    ; the thing no verdict can show — a broken arm and an arm with no input read
    ; identically without it.
    procedure union_or_intersection_related_to(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int, branch_out: ref[int]) returns bool
    {
        if (source.flags & TypeFlagsUnion) <> 0
        {
            if (target.flags & TypeFlagsUnion) <> 0
            {
                ; The two ORIGIN fast paths, and the row is STILL A STOP — but
                ; not for the reason it carried until slice 176.
                ;
                ; ★★★ THE OLD NOTE'S PREMISE HAD EXPIRED AND RETIRING THE ROW WAS
                ; STILL WRONG. It read *"an ALIAS test, which this port does not
                ; carry — `Type.alias` is deliberately absent"*, and both alias
                ; slots have been on `Type` since slice 111 with getUnionType and
                ; getIntersectionType filling them. So slice 176 wrote both arms
                ; from the reference verbatim, and stage 1 went green with 24
                ; stage-2 units unblocked — and `diagcheck` went RED: the unit the
                ; row's largest group is named after, `distributiveConditionalBase
                ; Constraint`, answers an INVENTED TS2344 behind the wall.
                ;
                ; ★★★ WHAT THE WALL IS ACTUALLY HIDING, reduced to three lines and
                ; measured against the parent binary (which reports the same TS2344
                ; on the reduction, with no stop, so the invention is PRE-EXISTING
                ; and the fast paths do not cause it):
                ;
                ;     type J = boolean | { a?: number };
                ;     type P<S extends J> = unknown;
                ;     type R<S extends J> = P<{b: number} & S>;
                ;
                ; An INTERSECTION of an object type and a TYPE VARIABLE, related to
                ; the UNION that is the variable's constraint. The reference is
                ; silent; this port reports. ★Bounded from three sides: the same
                ; intersection against a NON-union constraint relates, the type
                ; variable against its own union constraint relates, and EVERY
                ; CONSTITUENT of the union taken alone as the target is refused by
                ; the reference TOO (`{a?:number}` with TS2559, `boolean` with
                ; TS2344) — so the route upstream takes for the union is not *try
                ; each constituent*, and it is not identified. The forkpin says
                ; this port reaches it at route 3, branch 2.
                ;
                ; ★★★ AND SLICE 180 NAMED IT, so the arms are written. The route
                ; is `getEffectiveConstraintOfIntersection` — the COMBINED
                ; CONSTRAINT retry at structuredTypeRelatedTo's own tail, which
                ; this port did not have because the header there carried the
                ; already-refuted *`TypeData` has no Intersection arm*. With it,
                ; the three-line reduction below the old note is SILENT on both
                ; sides, and `diagcheck` stays at 0 differing with these arms in.
                ; ★What the old note got right is that the wall was load-bearing
                ; for a gate; what it could not know is that the invention was one
                ; missing conjunct away, three hundred lines from the row.
                ;
                ; ★★ THE ALIAS TEST IS `target.alias != nil` / `source.alias != nil`
                ; and this port keeps the alias as TWO slots, so the presence test
                ; is on the SYMBOL — which is the slot every producer writes first
                ; and the one the reference's `alias` pointer stands for.
                let so Checker.union_origin_of(source)
                if so <> null
                {
                    let sot so as ref[Type]
                    if (sot.flags & TypeFlagsIntersection) <> 0
                    {
                        if target.alias_symbol <> null
                        {
                            let sts Checker.union_or_intersection_types_of(sot)
                            if sts <> null
                            {
                                if Checker.type_list_contains(sts as ref[Array[ref[Type]?]], target)
                                {
                                    set branch_out: 6
                                    return true
                                }
                            }
                        }
                    }
                }
                let to Checker.union_origin_of(target)
                if to <> null
                {
                    let tot to as ref[Type]
                    if (tot.flags & TypeFlagsUnion) <> 0
                    {
                        if source.alias_symbol <> null
                        {
                            let tts Checker.union_types_of(tot)
                            if tts <> null
                            {
                                if Checker.type_list_contains(tts as ref[Array[ref[Type]?]], source)
                                {
                                    set branch_out: 7
                                    return true
                                }
                            }
                        }
                    }
                }
            }
            ; `reportErrors && source.flags&Primitive == 0` — this port spells
            ; reportErrors as a non-null error node, so the conjunction is a
            ; narrowing of the node.
            var en: ref[AstNode]? error_node
            if (source.flags & TypeFlagsPrimitive) <> 0
                set en: null
            if relation = RelationComparable
            {
                set branch_out: 0
                return this.some_type_related_to_type(source, target, relation, en, intersection_state)
            }
            set branch_out: 1
            return this.each_type_related_to_type(source, target, relation, en, intersection_state)
        }
        if (target.flags & TypeFlagsUnion) <> 0
        {
            set branch_out: 2
            var en: ref[AstNode]? error_node
            if (source.flags & TypeFlagsPrimitive) <> 0
                set en: null
            if (target.flags & TypeFlagsPrimitive) <> 0
                set en: null
            ; getRegularTypeOfObjectLiteral — the IDENTITY for everything but a
            ; FRESH object literal, and since slice 146 it answers for that one too.
            ; ★The note that stood here read *this is a row with an argument rather
            ; than a row with a count*: the population has already stopped at the
            ; excess-property check one function up unless the target bit of the
            ; intersection state is set. The argument held and the row was still
            ; the frontier's second-largest, which is what a completion count
            ; measures and an arrival count does not (frontier.sh's own header).
            let reg_mark this.unported_mark()
            let reg this.get_regular_type_of_object_literal(source)
            if this.unported_mark() <> reg_mark
                return false
            if reg = null
                return false
            return this.type_related_to_some_type(reg as ref[Type], target, relation, en, intersection_state)
        }
        ; ★★ The intersection state passed on is `IntersectionStateTarget` and NOT
        ; the caller's — the reference writes the constant here, because what the
        ; callee needs to know is that ITS target is a constituent of an
        ; intersection, which is a fact this arm establishes rather than inherits.
        if (target.flags & TypeFlagsIntersection) <> 0
        {
            set branch_out: 3
            return this.type_related_to_each_type(source, target, relation, error_node, IntersectionStateTarget)
        }
        ; "Source is an intersection. For the comparable relation, if the target is
        ; a primitive type we hoist the constraints of all non-primitive types in
        ; the source into a new intersection. We do this because the intersection
        ; may further constrain the constraints of the non-primitive types. For
        ; example, given a type parameter 'T extends 1 | 2', the intersection
        ; 'T & 1' should be reduced to '1' such that it doesn't appear to be
        ; comparable to '2'."
        ;
        ; ★★★ `core.SameMap` IS THE WHOLE HOIST: it answers the INPUT LIST back
        ; when no element moved, and `core.Same` then compares by identity — so
        ; `different` is not a flag to keep but the identity of the list itself.
        ; This port has no SameMap, so the fold carries the flag and the `Same`
        ; test reads it; the two are the same predicate and the flag is the
        ; cheaper half.
        var src source
        if relation = RelationComparable
        {
            if (target.flags & TypeFlagsPrimitive) <> 0
            {
                let types Checker.union_or_intersection_types_of(source)
                if types = null
                {
                    set branch_out: 4
                    this.record_unported("intersection-constraint-hoist-no-list", source.flags)
                    return false
                }
                let list types as ref[Array[ref[Type]?]]
                let n list.get_length() as int
                var different false
                let constraints this.new_type_list(null)
                var i 0
                while i < n
                {
                    let row list[i]
                    if row = null
                    {
                        set branch_out: 4
                        this.record_unported("intersection-constraint-hoist-null-member", source.flags)
                        return false
                    }
                    let t row as ref[Type]
                    var mapped t
                    if (t.flags & TypeFlagsInstantiable) <> 0
                    {
                        let mark this.unported_mark()
                        let constraint this.get_base_constraint_of_type(t)
                        if this.unported_mark() <> mark
                            return false
                        if constraint = null
                            set mapped: unknown_type
                        else
                            set mapped: constraint as ref[Type]
                    }
                    if mapped <> t
                        set different: true
                    constraints.add(mapped)
                    set i: i + 1
                }
                if different
                {
                    let mark this.unported_mark()
                    let hoisted this.get_intersection_type(constraints)
                    if this.unported_mark() <> mark
                        return false
                    if hoisted = null
                        return false
                    let h hoisted as ref[Type]
                    if (h.flags & TypeFlagsNever) <> 0
                    {
                        set branch_out: 4
                        return false
                    }
                    if (h.flags & TypeFlagsIntersection) = 0
                    {
                        set branch_out: 4
                        ; ★ BOTH directions are asked and NEITHER reports: the
                        ; reference passes `false` for reportErrors twice over,
                        ; because a message about the hoisted intersection names a
                        ; type the program never wrote.
                        if this.is_related_to_ex(h, target, relation, null, IntersectionStateNone, RecursionFlagsSource)
                            return true
                        return this.is_related_to_ex(target, h, relation, null, IntersectionStateNone, RecursionFlagsSource)
                    }
                    set src: h
                }
            }
        }
        ; "Check to see if any constituents of the intersection are immediately
        ; related to the target. Don't report errors though. Elaborating on whether
        ; a source constituent is related to the target is not actually useful and
        ; leads to some confusing error messages. Instead, we rely on the caller
        ; checking whether the full intersection viewed as an object is related to
        ; the target."
        set branch_out: 5
        this.some_type_related_to_type(src, target, relation, null, IntersectionStateSource)
    }

    ; someTypeRelatedToType, whole. ★★★Its first line is `source.Types()`, and the
    ; accessor is the one that answers for BOTH payloads: since slice 156 the
    ; INTERSECTION tail of unionOrIntersectionRelatedTo calls this, and the
    ; union-only accessor answers null for one — which is a stop where the
    ; reference has an answer. The note that stood here (*"the intersection caller
    ; is the stop above"*) was true only while that stop was there; it is §3.5gk's
    ; shape read at the moment the producer arrives.
    procedure some_type_related_to_type(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        let st Checker.union_or_intersection_types_of(source)
        if st = null
        {
            this.record_unported("some-type-related-to-type-no-list", source.flags)
            return false
        }
        let source_types st as ref[Array[ref[Type]?]]
        if (source.flags & TypeFlagsUnion) <> 0
        {
            if this.contains_type(source_types, target)
                return true
        }
        let n source_types.get_length() as int
        var i 0
        while i < n
        {
            let t source_types[i]
            if t = null
            {
                this.record_unported("some-type-related-to-type-null-member", source.flags)
                return false
            }
            ; "reportErrors && i == len(sourceTypes)-1" — only the LAST constituent
            ; may report, which is what keeps a union's failure from elaborating
            ; once per member.
            var en: ref[AstNode]? null
            if i = n - 1
                set en: error_node
            if this.is_related_to_ex(t as ref[Type], target, relation, en, intersection_state, RecursionFlagsSource)
                return true
            set i: i + 1
        }
        false
    }

    ; eachTypeRelatedToType, whole — the source-union arm of the assignable
    ; relation, and the one that carries the reference's CORRESPONDENCE fast path:
    ; *"many unions are mappings of one another; in such cases, simply comparing
    ; members at the same index can shortcut the comparison."*
    ;
    ; ★★ `result &= related` IS AN `and` HERE and nothing is lost by it. The
    ; reference accumulates a TERNARY so that a Maybe survives to the recursion's
    ; own bookkeeping; Maybe is produced in exactly one place —
    ; `recursiveTypeRelatedTo` — which is the half of the fork this slice does not
    ; port, so no call below can return one.
    procedure each_type_related_to_type(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        let st Checker.union_types_of(source)
        if st = null
        {
            this.record_unported("each-type-related-to-type-no-list", source.flags)
            return false
        }
        let source_types st as ref[Array[ref[Type]?]]
        let stripped this.get_undefined_stripped_target_if_needed(source, target)
        if stripped = null
            return false
        let stripped_target stripped as ref[Type]
        var stripped_types: ref[Array[ref[Type]?]]? null
        if (stripped_target.flags & TypeFlagsUnion) <> 0
            set stripped_types: Checker.union_types_of(stripped_target)
        let n source_types.get_length() as int
        var i 0
        while i < n
        {
            let sty source_types[i]
            if sty = null
            {
                this.record_unported("each-type-related-to-type-null-member", source.flags)
                return false
            }
            var matched false
            if stripped_types <> null
            {
                let sl stripped_types as ref[Array[ref[Type]?]]
                let m sl.get_length() as int
                ; ★ The `m > 0` guard is this port's and not the reference's: there
                ; `len(sourceTypes)%len(strippedTypes)` would panic on an empty list,
                ; and a union always has at least two constituents, so it cannot fire.
                ; It is written because the modulo is one line below it.
                if m > 0
                {
                    if n >= m
                    {
                        if (n % m) = 0
                        {
                            let corr sl[i % m]
                            if corr = null
                            {
                                this.record_unported("each-type-related-to-type-null-member", stripped_target.flags)
                                return false
                            }
                            if this.is_related_to_ex(sty as ref[Type], corr as ref[Type], relation, null, intersection_state, RecursionFlagsBoth)
                                set matched: true
                        }
                    }
                }
            }
            if matched = false
            {
                if this.is_related_to_ex(sty as ref[Type], target, relation, error_node, intersection_state, RecursionFlagsSource) = false
                    return false
            }
            set i: i + 1
        }
        true
    }

    ; getUndefinedStrippedTargetIfNeeded, WHOLE since slice 159.
    ;
    ; ★★★ THE ROW STOOD ON A PREMISE THE FILE ITSELF REFUTES — §3.5eo. It read
    ; *`extractTypesOfKind` — which is `filterType` over a union, the piece this
    ; port does not carry*, and `filter_type_inside_flags` four thousand lines
    ; above carries the header `extractTypesOfKind` in its own comment. The
    ; guard was transcribed whole and only the helper's call was a stop.
    ;
    ; ★★ THE MASK IS THE REFERENCE'S COMPLEMENT AND IT IS SPELLED AS ITS
    ; NEGATIVE, which is this file's standing idiom for a `&^` (see the
    ; ObjectFlagsMembersResolved reset and the decorator-modifier subset test):
    ; `extractTypesOfKind(target, ^Undefined)` keeps a constituent whose flags are
    ; NOT a subset of Undefined, and `filter_type_outside_flags(target, Undefined)`
    ; keeps one carrying no Undefined bit at all. ★They differ only for a type
    ; carrying Undefined TOGETHER with another flag, and no such type is minted:
    ; `undefinedType` and `missingType` are intrinsics whose flag word is exactly
    ; Undefined. The equivalence is therefore a claim about the PRODUCERS, which is
    ; the shape §3.5gk says to write down rather than to leave to a reader.
    procedure get_undefined_stripped_target_if_needed(this, source: ref[Type], target: ref[Type]) returns ref[Type]?
    {
        if (source.flags & TypeFlagsUnion) = 0
            return target
        if (target.flags & TypeFlagsUnion) = 0
            return target
        let st Checker.union_types_of(source)
        let tt Checker.union_types_of(target)
        if st = null
            return target
        if tt = null
            return target
        let sl st as ref[Array[ref[Type]?]]
        let tl tt as ref[Array[ref[Type]?]]
        if (sl.get_length() as int) = 0
            return target
        if (tl.get_length() as int) = 0
            return target
        let s0 sl[0]
        let t0 tl[0]
        if s0 = null
            return target
        if t0 = null
            return target
        if (((s0 as ref[Type]).flags) & TypeFlagsUndefined) <> 0
            return target
        if (((t0 as ref[Type]).flags) & TypeFlagsUndefined) = 0
            return target
        this.filter_type_outside_flags(target, TypeFlagsUndefined)
    }

    ; typeRelatedToSomeType, whole — the TARGET-union arm, and the one the
    ; arithmetic operand check reaches: `checkArithmeticOperandType` asks whether
    ; its operand is assignable to `number | bigint`, so every call of it arrives
    ; here with a two-constituent primitive union.
    ;
    ; ★★★ THE PRIMITIVE-UNION SHORT CIRCUIT IS THE REFERENCE'S OWN AND IT IS WHAT
    ; MAKES THE POPULATION ANSWER RATHER THAN LOOP: *"when relating a literal type
    ; to a union of primitive types, we know the relation is false unless the union
    ; contains the base primitive type or the literal type in one of its
    ; fresh/regular forms."* It is transcribed whole, exclusions included — the
    ; numeric-literal one for non-subtype relations, and the enum-literal one,
    ; whose comment says why (*identically named enum types are related*).
    procedure type_related_to_some_type(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        ; ★★★ `target.Types()` IS NOT THE UNION'S LIST — it answers for a union,
        ; an INTERSECTION and a template literal alike, and the stop that stood
        ; here asked union_types_of and reported for everything else. The whole
        ; union block below is already flag-gated, so an intersection target fell
        ; through it in the reference and iterated its CONSTITUENTS in the loop at
        ; the foot; here it answered false with a row instead. The intersection is
        ; what the corpus brings (the row's argument was `1 << 28`).
        var tt Checker.union_or_intersection_types_of(target)
        if tt = null
            set tt: Checker.template_literal_types_of(target)
        if tt = null
        {
            this.record_unported("type-related-to-some-type-no-list", target.flags)
            return false
        }
        let target_types tt as ref[Array[ref[Type]?]]
        if (target.flags & TypeFlagsUnion) <> 0
        {
            if this.contains_type(target_types, source)
                return true
            var short_circuit false
            if relation <> RelationComparable
            {
                if (target.object_flags & ObjectFlagsPrimitiveUnion) <> 0
                {
                    if (source.flags & TypeFlagsEnumLiteral) = 0
                    {
                        if (source.flags & (TypeFlagsStringLiteral | TypeFlagsBooleanLiteral | TypeFlagsBigIntLiteral)) <> 0
                            set short_circuit: true
                        if relation = RelationSubtype
                        {
                            if (source.flags & TypeFlagsNumberLiteral) <> 0
                                set short_circuit: true
                        }
                        if relation = RelationStrictSubtype
                        {
                            if (source.flags & TypeFlagsNumberLiteral) <> 0
                                set short_circuit: true
                        }
                    }
                }
            }
            if short_circuit
            {
                ; The literal's OTHER form — fresh against regular. ★Both slots
                ; live on the Literal arm and this port carries the pair, so the
                ; reference's `source == regularType ? freshType : regularType` is
                ; written as it stands.
                var alternate: ref[Type]? Checker.literal_regular_type_of(source)
                if alternate <> null
                {
                    if (alternate as ref[Type]) = source
                        set alternate: Checker.literal_fresh_type_of(source)
                }
                var primitive: ref[Type]? null
                if (source.flags & TypeFlagsStringLiteral) <> 0
                    set primitive: this.string_type
                if (source.flags & TypeFlagsNumberLiteral) <> 0
                    set primitive: this.number_type
                if (source.flags & TypeFlagsBigIntLiteral) <> 0
                    set primitive: this.bigint_type
                if primitive <> null
                {
                    if this.contains_type(target_types, primitive)
                        return true
                }
                if alternate <> null
                {
                    if this.contains_type(target_types, alternate)
                        return true
                }
                return false
            }
            ; getMatchingUnionConstituentForType — the DISCRIMINANT map, and it is
            ; ASKED here rather than refuted. ★★★The stop that stood here enumerated
            ; `computeKeyPropertyNameAndMap`'s three cheap refutations (fewer than
            ; ten constituents, a PRIMITIVE union, fewer than ten object-or-
            ; instantiable constituents) and reported for every union that passed
            ; them — on the premise that the map itself was not in this port. The
            ; whole route has been here since the discriminant chapter:
            ; `get_matching_union_constituent_for_type` is one file-screen below,
            ; with `get_key_property_name`, `compute_key_property_name_and_map`,
            ; `map_types_by_key_property` and `get_constituent_type_for_key_type`
            ; under it, and `find_matching_discriminant_type` already calls it.
            ; The three refutations are that function's own first lines.
            let by_key this.get_matching_union_constituent_for_type(target, source)
            if by_key <> null
            {
                if this.is_related_to_ex(source, by_key as ref[Type], relation, null, intersection_state, RecursionFlagsTarget)
                    return true
            }
        }
        let n target_types.get_length() as int
        var i 0
        while i < n
        {
            let t target_types[i]
            if t = null
            {
                this.record_unported("type-related-to-some-type-null-member", target.flags)
                return false
            }
            if this.is_related_to_ex(source, t as ref[Type], relation, null, intersection_state, RecursionFlagsTarget)
                return true
            set i: i + 1
        }
        ; "Elaborate only if we can find a best matching type in the target union."
        ; getBestMatchingType decides only WHICH constituent the second, REPORTING
        ; comparison is made against — the answer here is `false` either way. It
        ; landed in slice 130 with the rest of relater.go.
        if error_node <> null
        {
            ; isRelatedToSimple — the relation the caller is under, with reporting
            ; off, which is what the reference's function value carries.
            let best this.get_best_matching_type(source, target, relation)
            if best <> null
                this.is_related_to_ex(source, best as ref[Type], relation, error_node, intersection_state, RecursionFlagsTarget)
        }
        false
    }

    ; ══ THE ASSIGNABILITY RECURSION (slice 118) ═══════════════════════════════
    ;
    ; ★★★ WHY THIS CHAPTER AND NOT THE FRONTIER'S HEAD. `frontier.sh` ranked
    ; `has-excess-properties` first under BOTH granularities (+18 / 60 units), and
    ; the row is worth ZERO: removing it and re-sweeping completes not one unit,
    ; because `common-property-check` stands eleven lines further down the SAME
    ; function and `recursive-type-related-to` eleven lines below that. All three
    ; are this one wall, measured — see §3.5fl.
    ;
    ; ★★★ THERE IS NO RELATION CACHE IN THIS PORT AND THE ANSWER DOES NOT NEED
    ; ONE. `recursiveTypeRelatedTo`'s cache is a memo: every row it reads was
    ; computed by the same comparison it is about to run. What the cache is NOT
    ; optional for is the reference's own TERMINATION story — and that story has
    ; three legs, of which the cache is only one: the maybe stack (a comparison
    ; already in progress is assumed to hold), `isDeeplyNestedType` (a chain of
    ; generic instantiations three deep is assumed to expand for ever) and the
    ; 100-frame limit. The other two ARE ported, so a cyclic type terminates here
    ; for the reference's reason and not by luck.
    ;
    ; ★★ Ternary collapses to bool, and the collapse is exact at every reader in
    ; this chapter: `Maybe` is produced only by the cycle and depth guards, every
    ; test in the reference is `!= TernaryFalse`, and `result &= related` over a
    ; set of values that are only ever False or not-False is a conjunction. The one
    ; place upstream tests `== TernaryTrue` is the `keyof` arm, and that arm reports.

    ; getGlobalType at arity ZERO. ★A SECOND function rather than an arity
    ; parameter on `get_global_generic_type`, because the two differ in their
    ; failure VALUE and not only in the number: the generic one answers
    ; `empty_generic_type`, a real type the callers instantiate, and the
    ; non-generic one answers `empty_object_type`.
    ;
    ; ★★★ SLICE 154: THE SENTENCE THAT STOOD HERE WAS A CLAIM ABOUT THE REFERENCE
    ; AND IT WAS WRONG. It read *there is no such stand-in for a non-generic global
    ; — `Object` is either the lib's interface or nothing, and `nothing` has to be
    ; distinguishable*, and getGlobalType's last two lines are
    ; `if arity != 0 { return c.emptyGenericType }; return c.emptyObjectType`: the
    ; stand-in exists, it is the same one the ARITY branch has, and a missing global
    ; is never nil. The cost was measured rather than reasoned about — 60 units of
    ; stage 2 sat on `global-apparent-type`, of which 57 carried TypeFlagsBigInt and
    ; 3 TypeFlagsBigIntLiteral, i.e. every one of them was `getGlobalBigIntType()`
    ; over a lib that declares no `BigInt` (ES5), which upstream answers
    ; emptyObjectType for **with no diagnostic at all**, its resolver being
    ; `getGlobalTypeResolver("BigInt", 0, false /*reportErrors*/)`. A stop was
    ; standing in for the reference's own fallback. ★★The generalisable half is
    ; §3.5gi's one dimension on: a stop can be WRONG rather than absent, and the
    ; sentence that justifies it is the only thing that ever gets read — nobody
    ; re-reads the function it is a claim about.
    ;
    ; ★★★ WHAT report_errors BUYS IS THE ONE THING THIS PORT STILL CANNOT ANSWER.
    ; The three failure shapes upstream reports — TS2318 `Cannot find global type
    ; '0'`, `Global type '0' must have '1' type parameter(s)` and `Global type '0'
    ; must be a class or interface type` — are diagnostics, and a caller that asked
    ; for them gets a stop here instead. The five names that pass `true` (`Object`,
    ; `String`, `Number`, `Boolean` and getGlobalStrictFunctionType's two) are in
    ; every lib this corpus compiles against, so no unit reaches one; the two that
    ; pass `false` (`BigInt`, `Symbol`) are exactly the ones a lib may omit, and for
    ; those the fallback is the whole answer.
    procedure get_global_object_type(this) returns ref[Type]?
    {
        if global_object_type <> null
            return global_object_type
        let d this.get_global_type_zero_arity_ex("Object", SymbolFlagsType, false)
        if d = null
            return null
        set global_object_type: d
        d
    }

    ; getGlobalType's whole body at arity 0 — slice 124 added five more callers
    ; and a sixth copy of twenty lines would have been the shape §3.5dm is about.
    ; ★It does NOT hold the memo: the memo is a FIELD per global, and a helper that
    ; took a cell would need a `ref[ref[Type]?]` out-parameter to write one. The
    ; wrappers hold their own.
    ;
    ; ★★ THE STRUCTURE IS THE REFERENCE'S AND NOT A CHAIN OF EARLY RETURNS: every
    ; failure falls THROUGH to the same `empty_object_type`, and `report_errors`
    ; decides only whether the fall-through is preceded by the diagnostic this port
    ; owes — see get_global_object_type's header for why that is a stop.
    ; ★A null still means *I stopped*, and the one null with no stop of its own is
    ; get_declared_type_of_symbol's, which is left as it was.
    procedure get_global_type_zero_arity_ex(this, name: Slice[char], flags: int, report_errors: bool) returns ref[Type]?
    {
        let symbol this.lookup_globals(name, flags)
        if symbol <> null
        {
            let sym symbol as ref[Symbol]
            if (Symbol.flags_of(sym) & (SymbolFlagsClass | SymbolFlagsInterface)) <> 0
            {
                let mark this.unported_mark()
                let declared this.get_declared_type_of_symbol(sym)
                if this.unported_mark() <> mark
                    return null
                if declared = null
                    return null
                let d declared as ref[Type]
                if Checker.type_parameter_count_of(d) = 0
                    return d
                if report_errors
                    this.error_on_node(Checker.get_global_type_declaration(sym), DiagGlobal_type_0_must_have_1_type_parameter_s)
            }
            else
            {
                if report_errors
                    this.error_on_node(Checker.get_global_type_declaration(sym), DiagGlobal_type_0_must_be_a_class_or_interface_type)
            }
        }
        else
        {
            ; TS2318 through resolveName(nil, …): a diagnostic with NO location, the
            ; program's global list, which no artifact here reads (slice 254)
            if report_errors
                this.add_global_diagnostic(DiagCannot_find_global_type_0, name)
        }
        empty_object_type
    }

    ; getGlobalTypeDeclaration
    function get_global_type_declaration(symbol: ref[Symbol]) returns ref[AstNode]?
    {
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            set i: i + 1
            let k Checker.kind_or_unknown(d)
            if (k = KindClassDeclaration) or (k = KindInterfaceDeclaration) or (k = KindEnumDeclaration) or (k = KindTypeAliasDeclaration)
                return d
        }
        null
    }

    ; initializeChecker's `getGlobalType(name, arity, true)` lines, the report
    ; only: IArguments, Array, Object, Function, the two strict function types
    ; under strictBindCallApply, String, Number, Boolean, RegExp. ★The arity
    ; report (TS2317) needs the declared type and is not ported.
    ; ★★★ "Initialize special types" — initializeChecker's own thirteen lines,
    ; EAGER since slice 291 where this port answered them on first use. The memo
    ; fields and their lazy getters are unchanged; what moves is WHEN each type is
    ; minted, and that is the whole point: `--generateTrace` prints every type in
    ; creation order, ids 63..81 of both baselines are exactly this block, and a
    ; type at the wrong id is every later row wrong (§3.5ky).
    ;
    ; ★`c.globalThisType = getGlobalType("ThisType", 1, false)` is the one line not
    ; written: this port has no `global_this_type` slot and nothing asks for one,
    ; and a field with no reader is a claim about the future rather than a port
    ; (§3.5be). It mints no type for a lib that does not declare `ThisType`, which
    ; is every lib the driver baselines use.
    procedure initialize_global_types(this)
    {
        this.get_global_array_type()
        this.get_global_object_type()
        this.get_global_function_type()
        this.get_global_callable_function_type()
        this.get_global_newable_function_type()
        this.get_global_string_type()
        this.get_global_number_type()
        this.get_global_boolean_type()
        this.get_global_reg_exp_type()
        this.get_any_array_type()
        this.get_auto_array_type()
        this.get_global_readonly_array_type()
        this.get_any_readonly_array_type()
    }

    procedure report_initialize_checker_global_types(this)
    {
        this.report_global_type_presence("IArguments")
        this.report_global_type_presence("Array")
        this.report_global_type_presence("Object")
        this.report_global_type_presence("Function")
        if Checker.strict_bind_call_apply()
        {
            this.report_global_type_presence("CallableFunction")
            this.report_global_type_presence("NewableFunction")
        }
        this.report_global_type_presence("String")
        this.report_global_type_presence("Number")
        this.report_global_type_presence("Boolean")
        this.report_global_type_presence("RegExp")
    }

    procedure report_global_type_presence(this, name: Slice[char])
    {
        let symbol this.lookup_globals(name, SymbolFlagsType)
        if symbol = null
        {
            this.add_global_diagnostic(DiagCannot_find_global_type_0, name)
            return
        }
        let sym symbol as ref[Symbol]
        if (Symbol.flags_of(sym) & (SymbolFlagsClass | SymbolFlagsInterface)) = 0
            this.error_on_node(Checker.get_global_type_declaration(sym), DiagGlobal_type_0_must_be_a_class_or_interface_type)
    }

    ; the REPORT of a memoised reporting resolver — getGlobalTypeResolver(name,
    ; arity, true), getGlobalTypeAliasResolver(name, arity, true) and
    ; getGlobalValueSymbolResolver(name, true) — once per resolver; the answer
    ; comes from the unreporting getter at the call site
    procedure checked_global_first_ask(this, kind: Slice[char], name: Slice[char]) returns bool
    {
        let key StringBuilder^host()
        key.append(kind.data, kind.length)
        key.append(":")
        key.append(name.data, name.length)
        let ks key.to_string()
        let kv slice_copy_on(host, Slice[char](ks.get_length(), ks.get_buffer() as pointer[char]))
        var i: size_t 0
        while i < checked_global_reports.length
        {
            let existing checked_global_reports[i]
            if existing.equals(kv)
                return false
            set i: i + 1
        }
        checked_global_reports.add(kv)
        true
    }

    procedure report_checked_global_type(this, name: Slice[char], arity: int)
    {
        if this.checked_global_first_ask("T", name) = false
            return
        let symbol this.lookup_globals(name, SymbolFlagsType)
        if symbol = null
        {
            this.add_global_diagnostic(DiagCannot_find_global_type_0, name)
            return
        }
        let sym symbol as ref[Symbol]
        if (Symbol.flags_of(sym) & (SymbolFlagsClass | SymbolFlagsInterface)) <> 0
        {
            let mark this.unported_mark()
            let declared this.get_declared_type_of_symbol(sym)
            if this.unported_mark() <> mark
                return
            if declared = null
                return
            if Checker.type_parameter_count_of(declared as ref[Type]) <> arity
                this.error_on_node(Checker.get_global_type_declaration(sym), DiagGlobal_type_0_must_have_1_type_parameter_s)
        }
        else
            this.error_on_node(Checker.get_global_type_declaration(sym), DiagGlobal_type_0_must_be_a_class_or_interface_type)
    }

    procedure report_checked_global_type_alias(this, name: Slice[char], arity: int)
    {
        if this.checked_global_first_ask("A", name) = false
            return
        let symbol this.lookup_globals(name, SymbolFlagsTypeAlias)
        if symbol = null
        {
            this.add_global_diagnostic(DiagCannot_find_global_type_0, name)
            return
        }
        let sym symbol as ref[Symbol]
        let mark this.unported_mark()
        this.get_declared_type_of_symbol(sym)
        if this.unported_mark() <> mark
            return
        let links this.type_alias_link_of(sym)
        var n 0
        if links.type_parameters <> null
            set n: (links.type_parameters as ref[Array[ref[Type]?]]).get_length() as int
        if n <> arity
        {
            var i 0
            while i < Symbol.declaration_count(sym)
            {
                let d Symbol.declaration_at(sym, i)
                set i: i + 1
                if Checker.kind_or_unknown(d) = KindTypeAliasDeclaration
                {
                    this.error_on_node(d, DiagGlobal_type_0_must_have_1_type_parameter_s)
                    return
                }
            }
            this.error_on_node(null, DiagGlobal_type_0_must_have_1_type_parameter_s)
        }
    }

    procedure report_checked_global_value(this, name: Slice[char])
    {
        if this.checked_global_first_ask("V", name) = false
            return
        if this.lookup_globals(name, SymbolFlagsValue) = null
            this.add_global_diagnostic(DiagCannot_find_global_value_0, name)
    }

    ; a locationless diagnostic (slice 254): counted, never printed
    procedure add_global_diagnostic(this, code: int)
    {
        if serialization_level >= 2
            return
        set this.global_diagnostic_count: global_diagnostic_count + 1
        global_diagnostic_codes.add(code)
        global_diagnostic_list.add_direct(0, 0, code)
    }

    procedure add_global_diagnostic(this, code: int, name: Slice[char])
    {
        if serialization_level >= 2
            return
        set this.global_diagnostic_count: global_diagnostic_count + 1
        global_diagnostic_codes.add(code)
        let args this.message_args()
        let h host
        let c0 String^h(name.data as pointer[const_char], name.length as size_t)
        args.add(c0)
        global_diagnostic_list.add_direct_tagged_args(0, 0, code, 0 - 1, args)
    }

    ; The `false` half of the fork, which is what four of this file's six callers
    ; want. ★It is a wrapper rather than a default argument because this language
    ; has none, and the two spellings at the call site are the record of which
    ; upstream resolver each getter is.
    procedure get_global_type_zero_arity(this, name: Slice[char], flags: int) returns ref[Type]?
        this.get_global_type_zero_arity_ex(name, flags, false)

    ; c.globalStringType / globalNumberType / globalBooleanType and the two the
    ; reference asks for through a getter — getApparentType's five primitive arms.
    procedure get_global_string_type(this) returns ref[Type]?
    {
        if global_string_type <> null
            return global_string_type
        let d this.get_global_type_zero_arity_ex("String", SymbolFlagsType, false)
        if d = null
            return null
        set global_string_type: d
        d
    }

    procedure get_global_number_type(this) returns ref[Type]?
    {
        if global_number_type <> null
            return global_number_type
        let d this.get_global_type_zero_arity_ex("Number", SymbolFlagsType, false)
        if d = null
            return null
        set global_number_type: d
        d
    }

    procedure get_global_boolean_type(this) returns ref[Type]?
    {
        if global_boolean_type <> null
            return global_boolean_type
        let d this.get_global_type_zero_arity_ex("Boolean", SymbolFlagsType, false)
        if d = null
            return null
        set global_boolean_type: d
        d
    }

    procedure get_global_big_int_type(this) returns ref[Type]?
    {
        if global_big_int_type <> null
            return global_big_int_type
        let d this.get_global_type_zero_arity("BigInt", SymbolFlagsType)
        if d = null
            return null
        set global_big_int_type: d
        d
    }

    procedure get_global_es_symbol_type(this) returns ref[Type]?
    {
        if global_es_symbol_type <> null
            return global_es_symbol_type
        let d this.get_global_type_zero_arity("Symbol", SymbolFlagsType)
        if d = null
            return null
        set global_es_symbol_type: d
        d
    }

    ; getGlobalImportCallOptionsType — `getGlobalTypeResolver("ImportCallOptions",
    ; 0, false)`, so the NOT-REPORTING half.
    ;
    ; ★★★ THE ROW THAT STOOD IN ITS PLACE READ *a lib type this harness's single
    ; lib does not declare*, and that is true and is not a reason to stop: with
    ; reportErrors false getGlobalType answers `emptyObjectType` for a name the lib
    ; has no declaration of, which is a whole answer and the one every unit with an
    ; `import()` call in it was waiting for. **A global this port cannot find is
    ; not a global this port cannot ANSWER** — the resolver's own tail says so.
    procedure get_global_import_call_options_type(this) returns ref[Type]?
    {
        if global_import_call_options_type_unchecked <> null
            return global_import_call_options_type_unchecked
        let d this.get_global_type_zero_arity("ImportCallOptions", SymbolFlagsType)
        if d = null
            return null
        set global_import_call_options_type_unchecked: d
        d
    }

    ; getIndexTypeOfTypeEx.
    procedure get_index_type_of_type_ex(this, t: ref[Type], key_type: ref[Type], default_type: ref[Type]?) returns ref[Type]?
    {
        let info this.get_index_info_of_type(t, key_type)
        if info = null
            return default_type
        (info as ref[IndexInfo]).value_type
    }

    ; isLateBoundName — the two bytes 0xFE `@` that upstream puts in front of a
    ; computed name it could resolve.
    ;
    ; ★★ THE BYTE IS MASKED AND NOT COMPARED AGAINST −2, because `char`'s
    ; signedness is not the same on every target and ONE seed serves them all: the
    ; signed reading is right on this host and reads 254 on the next one.
    ;
    ; ★★★ AND IT ANSWERS FALSE FOR EVERY NAME THIS PORT CAN MINT, which is a
    ; containment and not a gap: `Binder.internal_name` writes 0xFE followed by a
    ; WORD (`computed`, `missing`, `default`), never 0xFE `@`. Upstream's late-bound
    ; names come from `getLateBoundNameFromType`, which this port has no producer
    ; for. It is written where the reference asks so that the producer's slice finds
    ; both readers — this one and the string-index fallback in isKnownProperty.
    function is_late_bound_name(d: Slice[char]) returns bool
    {
        if d.length < 2
            return false
        if ((d[0] as int) & 255) <> 254
            return false
        (d[1] as int) = 64
    }

    ; isHyphenatedJsxName.
    function is_hyphenated_jsx_name(d: Slice[char]) returns bool
    {
        var i 0
        while i < d.length
        {
            if d[(i as size_t)] = ("-" as char)
                return true
            set i: i + 1
        }
        false
    }

    ; getApplicableIndexInfoForName.
    procedure get_applicable_index_info_for_name(this, t: ref[Type], d: Slice[char]) returns ref[IndexInfo]?
    {
        if Checker.is_late_bound_name(d)
            return this.get_applicable_index_info(t, es_symbol_type)
        this.get_applicable_index_info(t, this.get_string_literal_type(d))
    }

    ; isExcessPropertyCheckTarget, whole.
    ;
    ; ★The Substitution arm is written and has no input — `TypeData` has no
    ; Substitution arm — and the Intersection one is the same sentence, which is
    ; why both fall through to `false` rather than reporting: a type this port
    ; cannot MINT is not a type it fails to answer about.
    ; ★★★ THE SUBSTITUTION AND INTERSECTION ARMS ARRIVED IN SLICE 155, and both had
    ; been left out under the same expired premise as maybe_type_of_kind's — a
    ; substitution type is minted (`new_type(TypeFlagsSubstitution, …)`) and so is
    ; an intersection. ★The intersection arm is `core.Every` where the union arm is
    ; `core.Some`, which is the whole reason they cannot share a loop: an excess
    ; property is an error against `A & B` only if it is one against BOTH.
    function is_excess_property_check_target(t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsObject) <> 0
        {
            if (t.object_flags & ObjectFlagsObjectLiteralPatternWithComputedProperties) = 0
                return true
        }
        if (t.flags & TypeFlagsNonPrimitive) <> 0
            return true
        if (t.flags & TypeFlagsSubstitution) <> 0
        {
            let base Checker.substitution_base_type_of(t)
            if base <> null
            {
                if Checker.is_excess_property_check_target(base as ref[Type])
                    return true
            }
        }
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types <> null
            {
                let list types as ref[Array[ref[Type]?]]
                let n list.get_length() as int
                var i 0
                while i < n
                {
                    let row list[i]
                    if row <> null
                    {
                        if Checker.is_excess_property_check_target(row as ref[Type])
                            return true
                    }
                    set i: i + 1
                }
            }
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.intersection_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return false
                if Checker.is_excess_property_check_target(row as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        false
    }

    ; `filterType(reducedTarget, isExcessPropertyCheckTarget)` — the ERROR TARGET of
    ; hasExcessProperties (slice 210). One predicate loop on §3.5e's rule. ★It is not the
    ; identity on a UNION: `Book | string` reports and SUGGESTS in terms of `Book` alone,
    ; and asked on the union the suggestion lookup finds no properties at all, so the port
    ; answered TS2353 where the reference answers TS2561 (`objectLiteralExcessProperties`).
    procedure filter_type_excess_property_check_target(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) = 0
        {
            if (t.flags & TypeFlagsNever) <> 0
                return t
            if Checker.is_excess_property_check_target(t)
                return t
            return never_type
        }
        let mark this.unported_mark()
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let out &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let u list[i]
            if u <> null
            {
                if Checker.is_excess_property_check_target(u as ref[Type])
                    out.add(u)
                else
                    set changed: true
            }
            set i: i + 1
        }
        if changed = false
            return t
        let r this.get_union_type_ex(out, UnionReductionNone, null, null)
        if this.unported_mark() <> mark
            return null
        r
    }

    ; isKnownProperty, whole.
    ;
    ; ★★ THE THIRD DISJUNCT IS THE ONE WITH THE SURPRISE, and the reference's own
    ; comment carries it: *for backwards compatibility a symbol-named property is
    ; satisfied by a STRING index signature*, which is why a late-bound name asks
    ; `getIndexInfoOfType(t, stringType)` after `getApplicableIndexInfoForName` has
    ; already asked with the symbol key.
    procedure is_known_property(this, target_type: ref[Type], d: Slice[char], is_comparing_jsx_attributes: bool) returns bool
    {
        if (target_type.flags & TypeFlagsObject) <> 0
        {
            if this.get_property_of_object_type(target_type, d) <> null
                return true
            if this.get_applicable_index_info_for_name(target_type, d) <> null
                return true
            if Checker.is_late_bound_name(d)
            {
                if this.get_index_info_of_type(target_type, string_type) <> null
                    return true
            }
            if is_comparing_jsx_attributes
            {
                if Checker.is_hyphenated_jsx_name(d)
                    return true
            }
        }
        ; `if targetType.flags&Substitution != 0 { return isKnownProperty(baseType, …) }` — a
        ; `NoInfer<{ x: string }>` member of a union target knows `x` through its base type;
        ; without the arm every property was an excess property against it (slice 210;
        ; `noInferUnionExcessPropertyCheck1`)
        if (target_type.flags & TypeFlagsSubstitution) <> 0
        {
            let base Checker.substitution_base_type_of(target_type)
            if base = null
                return false
            return this.is_known_property(base as ref[Type], d, is_comparing_jsx_attributes)
        }
        if (target_type.flags & TypeFlagsUnionOrIntersection) <> 0
        {
            if Checker.is_excess_property_check_target(target_type)
            {
                ; `targetType.Types()` — the INTERSECTION half of the read arrived
                ; in slice 155 with the predicate's own arms; it had been
                ; `union_types_of` alone, which is null for an intersection.
                let types Checker.union_or_intersection_types_of(target_type)
                if types <> null
                {
                    let list types as ref[Array[ref[Type]?]]
                    let cnt list.get_length() as int
                    var i 0
                    while i < cnt
                    {
                        let row list[i]
                        if row <> null
                        {
                            if this.is_known_property(row as ref[Type], d, is_comparing_jsx_attributes)
                                return true
                        }
                        set i: i + 1
                    }
                }
            }
        }
        false
    }

    ; isTypeSubsetOf and isTypeSubsetOfUnion.
    procedure is_type_subset_of(this, source: ref[Type]?, target: ref[Type]) returns bool
    {
        if source = null
            return false
        let s source as ref[Type]
        if s = target
            return true
        if (s.flags & TypeFlagsNever) <> 0
            return true
        if (target.flags & TypeFlagsUnion) = 0
            return false
        this.is_type_subset_of_union(s, target)
    }

    procedure is_type_subset_of_union(this, source: ref[Type], target: ref[Type]) returns bool
    {
        let tl Checker.union_types_of(target)
        if tl = null
            return false
        let targets tl as ref[Array[ref[Type]?]]
        if (source.flags & TypeFlagsUnion) <> 0
        {
            let sl Checker.union_types_of(source)
            if sl = null
                return false
            let sources sl as ref[Array[ref[Type]?]]
            let n sources.get_length() as int
            var i 0
            while i < n
            {
                let row sources[i]
                if row = null
                    return false
                if this.contains_type(targets, row as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        ; The EnumLike arm needs getBaseTypeOfEnumLikeType, which slice 116 ported.
        if (source.flags & TypeFlagsEnumLike) <> 0
        {
            let base this.get_base_type_of_enum_like_type(source)
            if base <> null
            {
                if (base as ref[Type]) = target
                    return true
            }
        }
        this.contains_type(targets, source)
    }

    ; shouldCheckAsExcessProperty — the two value declarations and their parent.
    function should_check_as_excess_property(prop: ref[Symbol], container: ref[Symbol]?) returns bool
    {
        if container = null
            return false
        let pvd Symbol.value_declaration_of(prop)
        if pvd = null
            return false
        let cvd Symbol.value_declaration_of(container as ref[Symbol])
        if cvd = null
            return false
        AstNode.parent_node_of(pvd as ref[AstNode]) = cvd
    }

    ; isIgnoredJsxProperty.
    function is_ignored_jsx_property(source: ref[Type], source_prop: ref[Symbol]) returns bool
    {
        if (source.object_flags & ObjectFlagsJsxAttributes) = 0
            return false
        Checker.is_hyphenated_jsx_name(Symbol.name_of(source_prop))
    }

    ; hasExcessProperties, whole — and the two halves it splits into are the two
    ; things this port can and cannot say about a property that is not in the
    ; target.
    ;
    ; ★★★ THE UNION-TARGET HALF HAS NO INPUT AT STAGE 1 AND THAT IS A MEASUREMENT:
    ; every one of the 60 units that reach this function carries target flags
    ; 1048576 exactly — TypeFlagsObject and nothing else — so
    ; `findMatchingDiscriminantType`, `filterPrimitivesIfContainsNonPrimitive`, the
    ; `checkTypes` list and the TS2326 report it feeds are written as one stop
    ; rather than four. The reader who brings a union here finds the fork already
    ; in place.
    ;
    ; ★★ THE SUGGESTION IS A CODE AND NOT AN ARGUMENT, which is the opposite of
    ; report_relation_error's reading and for the opposite reason: TS2561 and
    ; TS2353 are two different diagnostics, so a port that cannot spell the
    ; suggestion cannot choose between them. `get-spelling-suggestion` is therefore
    ; the stop, and it stands exactly where the reference asks — AFTER the four
    ; conditions that decide whether a suggestion is asked for at all, so a
    ; property whose declaration is not inside this literal reports TS2353 with no
    ; suggester in sight.
    procedure has_excess_properties(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?) returns bool
    {
        if Checker.is_excess_property_check_target(target) = false
            return false
        if Checker.no_implicit_any() = false
        {
            if (target.object_flags & ObjectFlagsJSLiteral) <> 0
                return false
        }
        var is_comparing_jsx_attributes false
        if (source.object_flags & ObjectFlagsJsxAttributes) <> 0
            set is_comparing_jsx_attributes: true
        var relaxed false
        if relation = RelationAssignable
            set relaxed: true
        if relation = RelationComparable
            set relaxed: true
        if relaxed
        {
            if this.is_type_subset_of(this.get_global_object_type(), target)
                return false
            if is_comparing_jsx_attributes = false
            {
                if this.is_empty_object_type(target)
                    return false
            }
        }
        ; reducedTarget — the union half, landed in slice 130 with
        ; find_matching_discriminant_type and filter_primitives_if_contains_non_primitive.
        ;
        ; ★★★ THE LINE THAT STOOD HERE SAID `checkTypes` (the reduced target's
        ; `Distributed()`) *HAS NO READER HERE … it is consumed only inside
        ; reportExcessPropertyError's suggestion arm* — AND IT IS NOT (slice 181).
        ; The reference reads it in the loop's SECOND test, sixteen lines below the
        ; isKnownProperty one and outside the `reportErrors` block: a property the
        ; reduced target DOES know, whose type is not related to the same property's
        ; type across the union's constituents, is an excess property too and is
        ; reported as TS2326. Without it every such unit lost a diagnostic, and the
        ; helper that answers the second operand — get_type_of_property_in_types —
        ; sat in this file with no call site at all (`tools/nocaller.py`).
        var reduced_target target
        var check_types: ref[Array[ref[Type]?]]? null
        if (target.flags & TypeFlagsUnion) <> 0
        {
            let union_mark this.unported_mark()
            let by_discriminant this.find_matching_discriminant_type(source, target, relation)
            if this.unported_mark() <> union_mark
                return false
            if by_discriminant <> null
                set reduced_target: by_discriminant as ref[Type]
            if by_discriminant = null
            {
                let filtered this.filter_primitives_if_contains_non_primitive(target)
                if this.unported_mark() <> union_mark
                    return false
                if filtered = null
                    return false
                set reduced_target: filtered as ref[Type]
            }
            ; `checkTypes = reducedTarget.Distributed()` — a union answers its
            ; constituents, `never` answers nothing, anything else answers itself.
            ; It stays NULL outside the union arm, which is what the reference's
            ; `checkTypes != nil` guard below tests.
            if (reduced_target.flags & TypeFlagsNever) <> 0
                set check_types: this.new_type_list(null)
            else
            {
                if (reduced_target.flags & TypeFlagsUnion) <> 0
                    set check_types: Checker.union_types_of(reduced_target)
                else
                {
                    let one this.new_type_list_of(1)
                    one.add(reduced_target)
                    set check_types: one
                }
            }
        }
        let props this.get_properties_of_type(source)
        if props = null
            return false
        let list props as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let prop row as ref[Symbol]
                var check true
                if Checker.should_check_as_excess_property(prop, source.symbol) = false
                    set check: false
                if check
                {
                    if Checker.is_ignored_jsx_property(source, prop)
                        set check: false
                }
                if check
                {
                    let pd Symbol.name_of(prop)
                    let pn Symbol.name_len_of(prop)
                    ; ★★★ A `false` FROM A LOOKUP THAT STOPPED IS NOT *not known*,
                    ; and this is the position where reading it as one would INVENT
                    ; a TS2353 at a property the reference knows about. The mark is
                    ; read around the call and a stop abandons the whole excess
                    ; check — losing the line rather than inventing one, and the
                    ; stop that moved the mark has already named itself.
                    let known_mark this.unported_mark()
                    let known this.is_known_property(reduced_target, pd, is_comparing_jsx_attributes)
                    if this.unported_mark() <> known_mark
                        return false
                    if known = false
                    {
                        if error_node <> null
                            this.report_excess_property(source, reduced_target, prop, error_node as ref[AstNode], is_comparing_jsx_attributes)
                        return true
                    }
                    ; The loop's SECOND test. ★It is asked only under a UNION
                    ; target — `checkTypes` is null otherwise — and it is the
                    ; reference's own reason for distributing: the property is
                    ; known, so it is not excess by NAME, and what disagrees is its
                    ; TYPE across the constituents.
                    if check_types <> null
                    {
                        let ct check_types as ref[Array[ref[Type]?]]
                        let pt this.get_type_of_symbol(prop)
                        if this.unported_mark() <> known_mark
                            return false
                        let across this.get_type_of_property_in_types(ct, pd)
                        if this.unported_mark() <> known_mark
                            return false
                        if (pt <> null) and (across <> null)
                        {
                            let related this.is_related_to_ex(pt as ref[Type], across as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
                            if this.unported_mark() <> known_mark
                                return false
                            ; ★★★ THE REPORT IS NOT WRITTEN AND THAT IS THE
                            ; DIFFERENCE BETWEEN A CHAIN AND A DIAGNOSTIC. Upstream's
                            ; `r.reportError(Types_of_property_0_are_incompatible)`
                            ; PREPENDS to the relater's error chain, so TS2326 comes
                            ; out as a sub-message under the head TS2322 the caller
                            ; reports — `mappedTypeIndexedAccess.errors.txt` shows it
                            ; indented under it, and the yardstick compares
                            ; `C pos end code` lines, where a chained message has
                            ; none. Written as a DIAGNOSTIC it was an INVENTION: that
                            ; unit went MATCH → FAIL with a second `C 292 297 2326`
                            ; beside the reference's single 2322. ★Since slice 288
                            ; it is written as what upstream writes — a CHAIN LINK
                            ; through `report_error`, which carries no code and no
                            ; span of its own — and the verdict is still this
                            ; `return`.
                            if related = false
                            {
                                if error_node <> null
                                    this.report_error(DiagTypes_of_property_0_are_incompatible, null, null, this.symbol_arg(prop))
                                return true
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    ; The report half of hasExcessProperties.
    ;
    ; ★★★ THE JSX BRANCH'S NOTE SAID IT HAS NO INPUT, AND SLICE 162 GAVE IT ONE.
    ; It read *ObjectFlagsJsxAttributes is set by `createJsxAttributesType`, which
    ; is behind `check-jsx-element`* — true when it was written and false since
    ; the JSX chapter's remainder landed; `create_jsx_attributes_type` sets that
    ; flag in this file today, and the suggester the note says the three reports
    ; share is `getSpellingSuggestionForName`, which the ordinary branch has been
    ; calling since slice 142. ★★AND THE STOP WAS WIDER THAN THE FORK IT STOOD
    ; FOR: it fired on `isComparingJsxAttributes`, which upstream reads only in
    ; `isKnownProperty` — the branch here is decided by the ERROR NODE alone.
    ;
    ; ★★★ `errorTarget` IS `filterType(reducedTarget, isExcessPropertyCheckTarget)`,
    ; and the note that stood here called it the identity "by construction" — true of
    ; a NON-union target only. The reduced target of `Book | string` is still the
    ; union, and the reference reports and suggests in terms of `Book` alone
    ; (`filter_type_excess_property_check_target`, slice 210).
    procedure report_excess_property(this, source: ref[Type], target: ref[Type], prop: ref[Symbol], error_node: ref[AstNode], is_comparing_jsx_attributes: bool)
    {
        ; `IsJsxAttributes(errorNode) || IsJsxOpeningLikeElement(errorNode) ||
        ; IsJsxOpeningLikeElement(errorNode.Parent)`. ★JsxAttributes has an
        ; object-literal flag and takes the same assignability check as an ordinary
        ; object literal — upstream's own comment — so the fork exists for the
        ; MESSAGE and not for the check.
        ; `errorTarget := filterType(reducedTarget, isExcessPropertyCheckTarget)` — computed
        ; BEFORE the fork and used by both arms (the message's type and the suggestion's
        ; population). See the helper's note: on a union it is not the identity.
        let et_mark this.unported_mark()
        let et this.filter_type_excess_property_check_target(target)
        if this.unported_mark() <> et_mark
            return
        if et = null
            return
        let error_target et as ref[Type]
        var jsx_report false
        if AstNode.kind_of(error_node) = KindJsxAttributes
            set jsx_report: true
        if AstNode.is_jsx_opening_like_element(error_node)
            set jsx_report: true
        if AstNode.is_jsx_opening_like_element(AstNode.parent_node_of(error_node))
            set jsx_report: true
        if jsx_report
            return this.report_excess_jsx_property(source, error_target, prop, error_node)
        ; The suggestion's four conditions, in the reference's order. Each one that
        ; is false means the reference asks for no suggestion at all, so TS2353 is
        ; the whole answer and nothing is owed. ★The fourth is
        ; `GetSourceFileOfNode(objectLiteralDeclaration) == GetSourceFileOfNode(errorNode)`
        ; and it is not written: a unit is ONE file here, so the two nodes cannot
        ; come from different ones, and the day a unit spans files this line and
        ; every other same-file test move together.
        var may_suggest false
        let pvd Symbol.value_declaration_of(prop)
        if pvd <> null
        {
            if Checker.is_object_literal_element_kind(AstNode.kind_of(pvd as ref[AstNode]))
            {
                let owner source.symbol
                if owner <> null
                {
                    let od Symbol.value_declaration_of(owner as ref[Symbol])
                    if od <> null
                    {
                        if Checker.node_has_ancestor(pvd as ref[AstNode], od as ref[AstNode])
                            set may_suggest: true
                    }
                }
            }
        }
        ; ★★★ THE ERROR NODE MOVES WHETHER OR NOT A SUGGESTION IS FOUND, and the
        ; port used to move it only inside the stop. `r.errorNode = name` stands
        ; ABOVE the identifier test upstream, so a property whose name is a string
        ; or a computed name reports TS2353 AT THE NAME and not at the caller's
        ; node — which is where this reported it before.
        var report_node error_node
        var suggestion: ref[Symbol]? null
        if may_suggest
        {
            let nm AstNode.name_of(pvd as ref[AstNode])
            if nm <> null
            {
                let name nm as ref[AstNode]
                set report_node: name
                if AstNode.kind_of(name) = KindIdentifier
                {
                    let mark this.unported_mark()
                    set suggestion: this.get_suggestion_for_nonexistent_property(AstNode.identifier_text_of(name), error_target)
                    if this.unported_mark() <> mark
                        return
                }
            }
        }
        ; ★★★ `r.errorNode = name` — THE MOVE IS THE REFERENCE'S AND IT NOW HAS
        ; SOMEWHERE TO LAND (slice 167). Upstream this line assigns the Relater's
        ; own error node, so the diagnostic the chain finally emits is at the
        ; property's name; before the chain the port emitted here and the move was
        ; a local variable. It is set whether or not a suggestion was found, which
        ; is the note two paragraphs up.
        set rel_error_node: report_node
        if suggestion <> null
        {
            this.report_error(DiagObject_literal_may_only_specify_known_properties_but_0_does_not_exist_in_type_1_Did_you_mean_to_write_2, source, error_target, this.symbol_arg(prop), this.type_arg(error_target), Checker.arg_text(Symbol.name_of(suggestion as ref[Symbol])))
            return
        }
        this.report_error(DiagObject_literal_may_only_specify_known_properties_and_0_does_not_exist_in_type_1, source, error_target, this.symbol_arg(prop), this.type_arg(error_target))
    }

    ; The JSX half of reportExcessProperty — TS2339 / TS2551 where the object
    ; literal's half reports TS2353 / TS2559.
    ;
    ; ★ The error node moves to the ATTRIBUTE'S NAME only for a real JsxAttribute
    ; declaration: *extraneous children (as in `<NoChild>extra</NoChild>`) do not
    ; pass this check, since `children` is a PropertySignature and not a
    ; JsxAttribute* — upstream's own comment, and the reason the test is on the
    ; KIND rather than on the presence of a declaration. The same-file conjunct
    ; beside it is not written for the reason the object-literal half gives: a
    ; unit is one file here.
    procedure report_excess_jsx_property(this, source: ref[Type], target: ref[Type], prop: ref[Symbol], error_node: ref[AstNode])
    {
        var report_node error_node
        let pvd Symbol.value_declaration_of(prop)
        if pvd <> null
        {
            if AstNode.kind_of(pvd as ref[AstNode]) = KindJsxAttribute
            {
                let nm AstNode.name_of(pvd as ref[AstNode])
                if nm <> null
                    set report_node: nm as ref[AstNode]
            }
        }
        set rel_error_node: report_node
        let prop_name this.symbol_arg(prop)
        let mark this.unported_mark()
        let suggestion this.get_suggested_symbol_for_nonexistent_jsx_attribute(Symbol.name_of(prop), target)
        if this.unported_mark() <> mark
            return
        if suggestion <> null
        {
            this.report_error(DiagProperty_0_does_not_exist_on_type_1_Did_you_mean_2, source, target, prop_name, this.type_arg(target), this.symbol_arg(suggestion))
            return
        }
        this.report_error(DiagProperty_0_does_not_exist_on_type_1, source, target, prop_name, this.type_arg(target))
    }

    ; getSuggestedSymbolForNonexistentJSXAttribute. ★The two JSX-specific renames
    ; are a `switch` on the NAME upstream and two tests here, and they come first:
    ; `for`/`class` are the DOM's reserved-word pair and their answer is exact
    ; rather than spelled-out.
    procedure get_suggested_symbol_for_nonexistent_jsx_attribute(this, name: Slice[char], containing_type: ref[Type]) returns ref[Symbol]?
    {
        let mark this.unported_mark()
        let props this.get_properties_of_type(containing_type)
        if this.unported_mark() <> mark
            return null
        if props = null
            return null
        let list props as ref[Array[ref[Symbol]?]]
        var wanted Slice[char]()
        if Checker.name_is(name, "for")
            set wanted: Binder.internal_name_unprefixed(host, "htmlFor")
        if Checker.name_is(name, "class")
            set wanted: Binder.internal_name_unprefixed(host, "className")
        if wanted.length <> 0
        {
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                if Checker.name_is(Symbol.name_of(row as ref[Symbol]), wanted)
                    return row
            }
        }
        this.get_spelling_suggestion_for_name(name, list, SymbolFlagsValue)
    }

    ; ast.IsObjectLiteralElement — the six kinds, on §3.9b's rule.
    function is_object_literal_element_kind(k: int) returns bool
    {
        if k = KindPropertyAssignment
            return true
        if k = KindShorthandPropertyAssignment
            return true
        if k = KindSpreadAssignment
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindGetAccessor
            return true
        k = KindSetAccessor
    }

    ; ast.FindAncestor(node, func(d) { return d == stop }) — the walk, written out
    ; on §3.9d's rule.
    function node_has_ancestor(node: ref[AstNode], stop: ref[AstNode]) returns bool
    {
        var p: ref[AstNode]? node
        while p <> null
        {
            if (p as ref[AstNode]) = stop
                return true
            set p: AstNode.parent_node_of(p as ref[AstNode])
        }
        false
    }

    ; isWeakType, whole. ★The Substitution and Intersection arms have no input for
    ; `TypeData`'s reason.
    procedure is_weak_type(this, t: ref[Type]) returns bool
    {
        ; ★★★ THE SUBSTITUTION AND INTERSECTION ARMS, SLICE 167 — two of the
        ; reference's four and they were simply absent, so `A2 & B2` (both members
        ; optional) was not a weak type here and the common-property report that
        ; hangs off it never fired. It was invisible while the report itself was a
        ; stop: the unit was UNPORTED either way, and only writing TS2559/TS2560
        ; turned a missing predicate into a missing LINE. Measured on
        ; `nestedExcessPropertyChecking` and `weakType`.
        if (t.flags & TypeFlagsSubstitution) <> 0
        {
            let base Checker.substitution_base_type_of(t)
            if base = null
                return false
            return this.is_weak_type(base as ref[Type])
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let its Checker.intersection_types_of(t)
            if its = null
                return false
            let il its as ref[Array[ref[Type]?]]
            let n il.get_length() as int
            var i 0
            while i < n
            {
                let c il[i]
                if c = null
                    return false
                if this.is_weak_type(c as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        if (t.flags & TypeFlagsObject) = 0
            return false
        let sm this.resolve_structured_type_members(t)
        if sm = null
            return false
        let d sm as ref[StructuredMembers]
        if d.signatures <> null
        {
            if ((d.signatures as ref[Array[ref[Signature]?]]).get_length() as int) <> 0
                return false
        }
        if d.index_infos <> null
        {
            if ((d.index_infos as ref[Array[ref[IndexInfo]?]]).get_length() as int) <> 0
                return false
        }
        if d.properties = null
            return false
        let props d.properties as ref[Array[ref[Symbol]?]]
        let n props.get_length() as int
        if n = 0
            return false
        var i 0
        while i < n
        {
            let row props[i]
            if row = null
                return false
            if (Symbol.flags_of(row as ref[Symbol]) & SymbolFlagsOptional) = 0
                return false
            set i: i + 1
        }
        true
    }

    ; typeRelatedToEachType — a source against EVERY constituent of an
    ; intersection target. Its one caller is the intersection-target arm of
    ; is_related_to_ex.
    procedure type_related_to_each_type(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        let types Checker.union_or_intersection_types_of(target)
        if types = null
            return true
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row = null
                return false
            if this.is_related_to_ex(source, row as ref[Type], relation, error_node, intersection_state, RecursionFlagsTarget) = false
                return false
            set i: i + 1
        }
        true
    }

    ; eachTypeRelatedToSomeType — EVERY constituent of the source finds SOME
    ; constituent of the target. ★It never reports: the reference passes
    ; `false` for reportErrors at its one call, because a per-constituent message
    ; would name a type the program never wrote.
    procedure each_type_related_to_some_type(this, source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        let types Checker.union_or_intersection_types_of(source)
        if types = null
            return true
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row = null
                return false
            if this.type_related_to_some_type(row as ref[Type], target, relation, null, IntersectionStateNone) = false
                return false
            set i: i + 1
        }
        true
    }

    ; isOrHasGenericConditional — a conditional, or an intersection holding one.
    ; ★Its one reader is elaborate_error's guard, which this port answers `false`
    ; for the same reason it answers the conditional arms elsewhere: an
    ; intersection has no TypeData arm here, so the recursive half has no input,
    ; and the direct half is the flag.
    function is_or_has_generic_conditional(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsConditional) <> 0
            return true
        if (t.flags & TypeFlagsIntersection) = 0
            return false
        let types Checker.union_or_intersection_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                if this.is_or_has_generic_conditional(row as ref[Type])
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; isSourceIntersectionNeedingExtraCheck — *the source is an intersection whose
    ; apparent type is structured, and no constituent IS the target or is
    ; non-inferrable*. It gates the optionals-only re-check at the tail of
    ; structuredTypeRelatedTo, whose comment is the reason it exists: a property
    ; mismatched in ONE constituent of a source intersection is otherwise carried
    ; by another.
    procedure is_source_intersection_needing_extra_check(this, source: ref[Type], target: ref[Type]) returns bool
    {
        if (source.flags & TypeFlagsIntersection) = 0
            return false
        let mark this.unported_mark()
        let apparent this.get_apparent_type(source)
        if this.unported_mark() <> mark
            return false
        if apparent = null
            return false
        if (((apparent as ref[Type]).flags) & TypeFlagsStructuredType) = 0
            return false
        let types Checker.union_or_intersection_types_of(source)
        if types = null
            return true
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let t row as ref[Type]
                if t = target
                    return false
                if (t.object_flags & ObjectFlagsNonInferrableType) <> 0
                    return false
            }
            set i: i + 1
        }
        true
    }

    ; getTypeOfPropertyInType / getTypeOfPropertyInTypes — the type a NAME has in
    ; a type, through the apparent type and falling back to the applicable index
    ; signature. Their reader is hasExcessProperties' `checkTypes` arm.
    procedure get_type_of_property_in_type(this, t: ref[Type], name_data: Slice[char]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let apparent this.get_apparent_type(t)
        if this.unported_mark() <> mark
            return null
        if apparent = null
            return null
        let ap apparent as ref[Type]
        var prop: ref[Symbol]? null
        if (ap.flags & TypeFlagsUnionOrIntersection) <> 0
            set prop: this.get_property_of_union_or_intersection_type(ap, name_data, false)
        else
            set prop: this.get_property_of_object_type(ap, name_data)
        if this.unported_mark() <> mark
            return null
        if prop <> null
            return this.get_type_of_symbol(prop as ref[Symbol])
        let info this.get_applicable_index_info_for_name(ap, name_data)
        if this.unported_mark() <> mark
            return null
        if info = null
            return undefined_type
        (info as ref[IndexInfo]).value_type
    }

    procedure get_type_of_property_in_types(this, types: ref[Array[ref[Type]?]], name_data: Slice[char]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let out &Array[ref[Type]?]()
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let row types[i]
            if row <> null
            {
                out.add(this.get_type_of_property_in_type(row as ref[Type], name_data))
                if this.unported_mark() <> mark
                    return null
            }
            set i: i + 1
        }
        this.get_union_type(out)
    }

    ; hasCommonProperties.
    procedure has_common_properties(this, source: ref[Type], target: ref[Type], is_comparing_jsx_attributes: bool) returns bool
    {
        let props this.get_properties_of_type(source)
        if props = null
            return false
        let list props as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let prop row as ref[Symbol]
                if this.is_known_property(target, Symbol.name_of(prop), is_comparing_jsx_attributes)
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; typeHasCallOrConstructSignatures.
    procedure type_has_call_or_construct_signatures(this, t: ref[Type]) returns bool
    {
        let calls this.get_signatures_of_type(t, SignatureKindCall)
        if calls <> null
        {
            if ((calls as ref[Array[ref[Signature]?]]).get_length() as int) <> 0
                return true
        }
        let ctors this.get_signatures_of_type(t, SignatureKindConstruct)
        if ctors = null
            return false
        ((ctors as ref[Array[ref[Signature]?]]).get_length() as int) <> 0
    }

    ; hasMatchingRecursionIdentity. ★The mapped and intersection arms have no
    ; input; what is left is the identity comparison, and it is FIELD-WISE because
    ; `get_recursion_identity` mints a fresh record per call — `RecursionId` is a
    ; pair of slots, not an interned value, which is `stack_has_recursion_identity`'s
    ; reading of the same type one chapter over.
    ; hasMatchingRecursionIdentity — the identity of `t` compared with one already
    ; taken, and since slice 160 it carries the reference's two wrappers: an
    ; INSTANTIATED MAPPED type is unwrapped to its deepest target that has a
    ; symbol, and an INTERSECTION matches when any constituent does.
    ;
    ; ★ The three slots are compared one for one because a RecursionId is a record
    ; here and an interface value upstream: the arms are disjoint (exactly one slot
    ; is ever non-null), so equality on all three is `==` on the interface.
    procedure has_matching_recursion_identity(this, t_in: ref[Type], id: ref[RecursionId]) returns bool
    {
        let t this.get_mapped_target_with_symbol(t_in)
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let list Checker.intersection_types_of(t)
            if list = null
                return false
            let types list as ref[Array[ref[Type]?]]
            let n types.get_length() as int
            var i 0
            while i < n
            {
                let e types[i]
                set i: i + 1
                if e = null
                    continue
                if this.has_matching_recursion_identity(e as ref[Type], id)
                    return true
            }
            return false
        }
        let other this.get_recursion_identity(t)
        if other.target_symbol <> id.target_symbol
            return false
        if other.target_node <> id.target_node
            return false
        other.target_type = id.target_type
    }

    ; getMappedTargetWithSymbol — *unwrap nested homomorphic mapped types and
    ; return the deepest target type that has a symbol*, which is what keeps
    ; `Mapped<{x: Mapped<{x: string}>}>` from looking deeply nested: each
    ; application's identity is its own target object literal's.
    procedure get_mapped_target_with_symbol(this, t_in: ref[Type]) returns ref[Type]
    {
        var t: ref[Type] t_in
        var walking true
        while walking
        {
            set walking: false
            if (t.object_flags & ObjectFlagsInstantiatedMapped) = ObjectFlagsInstantiatedMapped
            {
                let mark this.unported_mark()
                let target this.get_modifiers_type_from_mapped_type(t)
                if this.unported_mark() <> mark
                    return t
                if target <> null
                {
                    let tt target as ref[Type]
                    var has_symbol false
                    if tt.symbol <> null
                        set has_symbol: true
                    if has_symbol = false
                    {
                        if (tt.flags & TypeFlagsIntersection) <> 0
                        {
                            let list Checker.intersection_types_of(tt)
                            if list <> null
                            {
                                let types list as ref[Array[ref[Type]?]]
                                let n types.get_length() as int
                                var i 0
                                while i < n
                                {
                                    let e types[i]
                                    set i: i + 1
                                    if e = null
                                        continue
                                    if (e as ref[Type]).symbol <> null
                                        set has_symbol: true
                                }
                            }
                        }
                    }
                    if has_symbol
                    {
                        set t: tt
                        set walking: true
                    }
                }
            }
        }
        t
    }

    ; isDeeplyNestedType, whole, against ONE of the two stacks — `which` is
    ; RecursionFlagsSource or RecursionFlagsTarget, because a `ref[Array]`
    ; parameter would have to be chosen by the caller anyway and the depth lives
    ; beside the array.
    ;
    ; ★★★ THE `t.id >= lastTypeId` TEST IS NOT AN OPTIMISATION AND THE REFERENCE
    ; SAYS SO: *we only count occurrences with a higher type id than the previous
    ; occurrence, since higher type ids are an indicator of newer instantiations
    ; caused by recursion*. Drop it and a type that merely APPEARS three times in
    ; one comparison — a field of the same interface at three nesting levels — is
    ; declared infinitely expanding and the relation answers Maybe where the
    ; reference answers structurally.
    ; ★ Since slice 122 it chooses the stack and hands the walk to
    ; is_deeply_nested_type_in, because inference has a stack of its own on its own
    ; state and the walk is the same walk.
    procedure is_deeply_nested_type(this, t: ref[Type], which: int, max_depth: int) returns bool
    {
        var stack rel_source_stack
        var depth rel_source_depth
        var base rel_source_base
        if which = RecursionFlagsTarget
        {
            set stack: rel_target_stack
            set depth: rel_target_depth
            set base: rel_target_base
        }
        this.is_deeply_nested_type_in(t, stack, base, depth, max_depth)
    }

    procedure rel_push_maybe(this, s: int, t: int, i_state: int)
    {
        if rel_maybe_depth < (rel_maybe_source.get_length() as int)
        {
            rel_maybe_source.put(rel_maybe_depth as size_t, s)
            rel_maybe_target.put(rel_maybe_depth as size_t, t)
            rel_maybe_state.put(rel_maybe_depth as size_t, i_state)
        }
        if rel_maybe_depth >= (rel_maybe_source.get_length() as int)
        {
            rel_maybe_source.add(s)
            rel_maybe_target.add(t)
            rel_maybe_state.add(i_state)
        }
        set rel_maybe_depth: rel_maybe_depth + 1
    }

    function rel_maybe_has(this, s: int, t: int, i_state: int) returns bool
    {
        var i rel_maybe_base
        while i < rel_maybe_depth
        {
            var same true
            if rel_maybe_source[i] <> s
                set same: false
            if rel_maybe_target[i] <> t
                set same: false
            if rel_maybe_state[i] <> i_state
                set same: false
            if same
                return true
            set i: i + 1
        }
        false
    }

    ; The result cache's two operations, in SymbolTable's own idiom — open
    ; addressing over a power-of-two bucket vector, the rows in a separate Array in
    ; insertion order, the buckets rebuilt whenever the load factor would pass one
    ; half. The hash is FNV-1a over the four key words.
    ;
    ; ★ THE KEY CARRIES THE RELATION, where `rel_maybe_*`'s triple does not: the
    ; maybe stack is unwound inside one comparison and a cached row outlives it, so
    ; a failure under the identity relation must not answer for assignability.
    function rel_result_hash(rel: int, key: int) returns int
    {
        var h: u64 14695981039346656037
        set h: h xor (rel as u64)
        set h: h * 1099511628211
        set h: h xor (key as u64)
        set h: h * 1099511628211
        ((h >> 1) as int)
    }

    ; `relation.get(id)` — 0 where the reference answers RelationComparisonResultNone.
    function rel_result_get(this, rel: int, key: int) returns int
    {
        if rel_result_buckets = null
            return 0
        let buckets rel_result_buckets as ref[Vector[int]]
        var slot Checker.rel_result_hash(rel, key) & rel_result_mask
        while true
        {
            let e buckets.get(slot as size_t)
            if e = null
                return 0
            let idx *e
            if idx = 0
                return 0
            let row rel_result_entries.at(idx - 1)
            if row.key = key
            {
                if (row.rel as int) = rel
                    return row.result as int
            }
            set slot: (slot + 1) & rel_result_mask
        }
        0
    }

    ; `relation.set(id, result)`. An existing row is left alone: a key is written
    ; at most once, because the answer that wrote it is what every later ask reads.
    procedure rel_result_set(this, rel: int, key: int, result: int)
    {
        if this.rel_result_get(rel, key) <> 0
            return
        rel_result_entries.add(RelationCacheRow(key, rel as u8, result as u8))
        ; `relation.size()` — per relation, because the budget is. The five ids
        ; are dense, so the id indexes the counter directly.
        rel_result_counts.put(rel as size_t, rel_result_counts[rel as size_t] + 1)
        let count rel_result_entries.get_length() as int
        var cap 0
        if rel_result_buckets <> null
            set cap: rel_result_mask + 1
        if (count * 4) > (cap * 3)
        {
            var new_cap 8
            while (count * 4) > (new_cap * 3)
                set new_cap: new_cap * 2
            ; Vector[T](len) memsets its buffer, so 0 is the empty marker by
            ; construction — SymbolTable's own note.
            let old_rel_result_buckets rel_result_buckets
            let v AddressIndex.fresh_buckets(host, new_cap)
            set rel_result_buckets: v
            AddressIndex.release_buckets(host, old_rel_result_buckets)
            set rel_result_mask: new_cap - 1
            var j 0
            while j < count
            {
                let row rel_result_entries.at(j)
                var slot Checker.rel_result_hash(row.rel as int, row.key) & rel_result_mask
                while true
                {
                    let e v.get(slot as size_t)
                    if e = null
                        break
                    if *e = 0
                    {
                        v.put(slot as size_t, j + 1)
                        break
                    }
                    set slot: (slot + 1) & rel_result_mask
                }
                set j: j + 1
            }
            return
        }
        let buckets rel_result_buckets as ref[Vector[int]]
        var slot Checker.rel_result_hash(rel, key) & rel_result_mask
        while true
        {
            let e buckets.get(slot as size_t)
            if e = null
                return
            if *e = 0
            {
                buckets.put(slot as size_t, count)
                return
            }
            set slot: (slot + 1) & rel_result_mask
        }
    }

    ; recursiveTypeRelatedTo, WITH the cache since slice 172 — see the field's own
    ; header for the measurement, for the first diagnosis that was wrong, and for
    ; why the maybe COUNTER stands in for the reference's Ternary.
    ;
    ; ★★★ A CACHED FAILURE IS CONSULTED ONLY WHEN NOTHING IS BEING REPORTED, which
    ; is upstream's own condition: with an error node in hand it redoes the
    ; comparison to build the message. A cached SUCCESS is consulted always —
    ; there is no message to rebuild.
    ;
    ; ★★ THE 100-FRAME LIMIT IS ON THE STACK THAT WAS PUSHED, which is the
    ; reference's `len(r.sourceStack) == 100 || len(r.targetStack) == 100` asked
    ; BEFORE either push. Both are asked here for the same reason: a comparison
    ; that pushes only the target can still be the hundredth SOURCE frame of an
    ; outer chain.
    ; ── getRelationKey (slice 216) ─────────────────────────────────────────────
    ;
    ; ★★★ THE KEY OF A COMPARISON IS NOT THE PAIR OF TYPE IDS. Two type REFERENCES whose
    ; arguments are unconstrained type parameters are keyed by the POSITION of each
    ; parameter (`=n`), so `Foo<T>` against `Foo<U>` and `Foo<U>` against `Foo<V>` are ONE
    ; key and the maybe-set answers the second ask from the first. A constrained parameter
    ; keeps its own id and marks the key CONSTRAINED, whose broadest twin (constraints
    ; ignored) is asked of the maybe-set as well. The port keyed the maybe-set and the
    ; result cache on the ids and recursed where the reference stops with Maybe — two
    ; TS2321 the reference does not reach (`excessivelyDeepConditionalTypes`). The key is
    ; a 64-bit FNV over the same byte sequence the reference's keyBuilder writes.
    function rel_key_mix(h: u64, v: int) returns u64
        (h xor (v as u64)) * 1099511628211

    function is_non_deferred_type_reference(t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return false
        Checker.reference_node_of(t) = null
    }

    procedure is_type_reference_with_generic_arguments(this, t: ref[Type]) returns bool
    {
        if Checker.is_non_deferred_type_reference(t) = false
            return false
        let mark this.unported_mark()
        let args this.get_type_arguments(t)
        if this.unported_mark() <> mark
            return false
        if args = null
            return false
        let list args as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let a list[i]
            set i: i + 1
            if a = null
                continue
            let at a as ref[Type]
            if (at.flags & TypeFlagsTypeParameter) <> 0
                return true
            if this.is_type_reference_with_generic_arguments(at)
                return true
        }
        false
    }

    ; writeGenericTypeReferences' inner writeTypeReference; answers `constrained`.
    procedure rel_key_write_reference(this, r: ref[Type], depth: int, ignore_constraints: bool, tps: ref[Array[ref[Type]?]], h: ref[u64]) returns bool
    {
        var constrained false
        let tgt Checker.target_of(r)
        if tgt <> null
            set h: Checker.rel_key_mix(h, (tgt as ref[Type]).id)
        let args Checker.resolved_type_arguments_of(r)
        if args = null
            return false
        let list args as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let a list[i]
            set i: i + 1
            if a = null
                continue
            let t a as ref[Type]
            var written false
            if (t.flags & TypeFlagsTypeParameter) <> 0
            {
                var unconstrained ignore_constraints
                if unconstrained = false
                {
                    if this.get_constraint_of_type_parameter(t) = null
                        set unconstrained: true
                }
                if unconstrained
                {
                    var index 0 - 1
                    let nt tps.get_length() as int
                    var k 0
                    while k < nt
                    {
                        if index < 0
                        {
                            let e tps[k]
                            if e <> null
                            {
                                if (e as ref[Type]) = t
                                    set index: k
                            }
                        }
                        set k: k + 1
                    }
                    if index < 0
                    {
                        set index: nt
                        tps.add(t)
                    }
                    set h: Checker.rel_key_mix(h, 61)
                    set h: Checker.rel_key_mix(h, index)
                    set written: true
                }
                if written = false
                    set constrained: true
            }
            else
            {
                if depth < 4
                {
                    if this.is_type_reference_with_generic_arguments(t)
                    {
                        set h: Checker.rel_key_mix(h, 60)
                        if this.rel_key_write_reference(t, depth + 1, ignore_constraints, tps, h)
                            set constrained: true
                        set h: Checker.rel_key_mix(h, 62)
                        set written: true
                    }
                }
            }
            if written = false
            {
                set h: Checker.rel_key_mix(h, 45)
                set h: Checker.rel_key_mix(h, t.id)
            }
        }
        constrained
    }

    procedure get_relation_key(this, source_in: ref[Type], target_in: ref[Type], i_state: int, is_identity: bool, ignore_constraints: bool, out_constrained: ref[bool]) returns int
    {
        var source source_in
        var target target_in
        if is_identity
        {
            if source.id > target.id
            {
                set source: target_in
                set target: source_in
            }
        }
        var h: u64 14695981039346656037
        set out_constrained: false
        var generic false
        if this.is_type_reference_with_generic_arguments(source)
        {
            if this.is_type_reference_with_generic_arguments(target)
                set generic: true
        }
        if generic
        {
            set h: Checker.rel_key_mix(h, 103)
            let tps this.new_type_list(null)
            var constrained false
            if this.rel_key_write_reference(source, 0, ignore_constraints, tps, &h)
                set constrained: true
            set h: Checker.rel_key_mix(h, 44)
            if this.rel_key_write_reference(target, 0, ignore_constraints, tps, &h)
                set constrained: true
            set out_constrained: constrained
        }
        else
        {
            set h: Checker.rel_key_mix(h, 115)
            set h: Checker.rel_key_mix(h, source.id)
            set h: Checker.rel_key_mix(h, target.id)
        }
        set h: Checker.rel_key_mix(h, i_state)
        (h >> 1) as int
    }

    procedure recursive_type_related_to(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int, recursion_flags: int) returns bool
    {
        if rel_overflow
            return false
        ; ★★★ THE CACHE IS OFF INSIDE THE VARIANCE COMPUTATION, AND THAT IS A
        ; DELIBERATE DIVERGENCE FROM THE REFERENCE WITH A MEASUREMENT UNDER IT.
        ; Upstream caches there too. This port must not, because in that phase its
        ; relation is not a FUNCTION of the cache key: a refuter that recomputed
        ; every cached failure instead of trusting it caught the same key
        ; (assignable, source 183, target 179, state 0) answering FALSE and then
        ; TRUE, with `rel_expanding_flags` 0 both times — so something the key does
        ; not carry moved in between. Upstream additionally pins `resolutionStart`
        ; while it measures variance, which changes what pushTypeResolution calls a
        ; cycle; that is the first place to look when this is picked up again.
        ;
        ; (Slices 172–227 measured three, then one, stage-2 units leaving MATCH
        ; with the cache on in the variance phase; slice 228 found the rows, not
        ; the phase, to be the cause — see the tail of this function.)
        ; The comparison's KEY — see get_relation_key: the maybe-set and the result cache are
        ; keyed on it, never on the pair of ids (slice 216).
        var constrained false
        let key this.get_relation_key(source, target, intersection_state, relation = RelationIdentity, false, &constrained)
        ; ★★★ THE CACHE IS ON INSIDE THE VARIANCE COMPUTATION TOO (slice 228). It
        ; stood off there from slice 172 to 227 because with it on
        ; `varianceMeasurement` left MATCH — and the cause was never the phase but
        ; the ROWS: this frame wrote a subset of upstream's (its own key only, and
        ; only on a definite true), which is harmless while the relation is a
        ; function of its key and wrong inside a measurement, where rows are
        ; provisional and upstream answers later asks from them. The tail below
        ; writes upstream's rows; the guard is gone.
        let cached this.rel_result_get(relation, key)
        if cached <> 0
        {
            ; `r.c.reliabilityFlags |= entry & (ReportsUnmeasurable|ReportsUnreliable)`
            ; — the side channel the row carries, replayed for a comparison that is
            ; not being performed. See the enum's own header for what its absence
            ; cost.
            ; ★★★ THE REDO IS OFF FOR AN OVERFLOW ROW, AND THAT IS WHAT THE BIT
            ; IS FOR. Upstream redoes a cached FAILURE while it is building a
            ; message — *we will do the comparison again to generate an error
            ; message* — but a failure the limiter wrote has no comparison to
            ; redo: running it again would spend the budget again and answer the
            ; same way. So the row is taken, and its message is REPLAYED.
            var answered true
            if error_node <> null
            {
                if (cached & RelationComparisonResultFailed) <> 0
                {
                    if (cached & RelationComparisonResultOverflow) = 0
                        set answered: false
                }
            }
            if answered
            {
                set this.reliability_flags: reliability_flags | (cached & RelationComparisonResultReportsMask)
                if error_node <> null
                {
                    if (cached & RelationComparisonResultOverflow) <> 0
                    {
                        var ocode DiagExcessive_stack_depth_comparing_types_0_and_1
                        if (cached & RelationComparisonResultComplexityOverflow) <> 0
                            set ocode: DiagExcessive_complexity_comparing_types_0_and_1
                        this.report_error(ocode, source, target, this.type_arg(source), this.type_arg(target))
                    }
                }
                return (cached & RelationComparisonResultSucceeded) <> 0
            }
        }
        ; `if r.relationCount <= 0 { r.overflow = true; return TernaryFalse }` —
        ; asked AFTER the cache and BEFORE the maybe stack, which is upstream's
        ; order and not an arbitrary one: a row that is already known costs
        ; nothing and must still answer once the budget is gone, or a file's last
        ; comparisons would all become false.
        if rel_relation_count <= 0
        {
            set rel_overflow: true
            return false
        }
        if this.rel_maybe_has(key, 0, 0)
        {
            ; ★ MAYBE SOURCE ONE OF TWO. Everything above this frame that ends up
            ; TRUE did so under an assumption, and the counter is what says so.
            set rel_maybe_hits: rel_maybe_hits + 1
            return true
        }
        ; *A constrained key indicates that we have type references that reference
        ; constrained type parameters. For such keys we also check against the key we
        ; would have gotten if all type parameters were unconstrained.*
        if constrained
        {
            var broad_constrained false
            let broadest this.get_relation_key(source, target, intersection_state, relation = RelationIdentity, true, &broad_constrained)
            if this.rel_maybe_has(broadest, 0, 0)
            {
                set rel_maybe_hits: rel_maybe_hits + 1
                return true
            }
        }
        if rel_source_depth - rel_source_base = 100
        {
            set rel_overflow: true
            return false
        }
        if rel_target_depth - rel_target_base = 100
        {
            set rel_overflow: true
            return false
        }
        ; `maybeStart := len(r.maybeKeys)` — the keys this frame and its Maybe
        ; children leave on the stack are recorded TOGETHER (slice 228).
        let maybe_start rel_maybe_depth
        this.rel_push_maybe(key, 0, 0)
        let maybe_before rel_maybe_hits
        let unknown_before rel_unknown_hits
        let save_expanding rel_expanding_flags
        ; `saveReliabilityFlags := r.c.reliabilityFlags; r.c.reliabilityFlags = 0`
        ; — what THIS comparison reports has to be separable from what its caller
        ; had already collected, because only this comparison's own share may be
        ; written into its cache row.
        let save_reliability reliability_flags
        set this.reliability_flags: 0
        if (recursion_flags & RecursionFlagsSource) <> 0
        {
            if rel_source_depth < (rel_source_stack.get_length() as int)
                rel_source_stack.put(rel_source_depth as size_t, source)
            if rel_source_depth >= (rel_source_stack.get_length() as int)
                rel_source_stack.add(source)
            set rel_source_depth: rel_source_depth + 1
            if (rel_expanding_flags & ExpandingFlagsSource) = 0
            {
                if this.is_deeply_nested_type(source, RecursionFlagsSource, 3)
                    set rel_expanding_flags: rel_expanding_flags | ExpandingFlagsSource
            }
        }
        if (recursion_flags & RecursionFlagsTarget) <> 0
        {
            if rel_target_depth < (rel_target_stack.get_length() as int)
                rel_target_stack.put(rel_target_depth as size_t, target)
            if rel_target_depth >= (rel_target_stack.get_length() as int)
                rel_target_stack.add(target)
            set rel_target_depth: rel_target_depth + 1
            if (rel_expanding_flags & ExpandingFlagsTarget) = 0
            {
                if this.is_deeply_nested_type(target, RecursionFlagsTarget, 3)
                    set rel_expanding_flags: rel_expanding_flags | ExpandingFlagsTarget
            }
        }
        var result false
        if rel_expanding_flags = ExpandingFlagsBoth
        {
            ; ★ MAYBE SOURCE TWO OF TWO — the depth brake's own Ternary.Maybe.
            set rel_maybe_hits: rel_maybe_hits + 1
            set result: true
        }
        if rel_expanding_flags <> ExpandingFlagsBoth
            set result: this.structured_type_related_to(source, target, relation, error_node, intersection_state)
        if (recursion_flags & RecursionFlagsSource) <> 0
            set rel_source_depth: rel_source_depth - 1
        if (recursion_flags & RecursionFlagsTarget) <> 0
            set rel_target_depth: rel_target_depth - 1
        set rel_expanding_flags: save_expanding
        let propagating reliability_flags & RelationComparisonResultReportsMask
        set this.reliability_flags: reliability_flags | save_reliability
        ; ★★★ UPSTREAM'S FOUR-VALUED TAIL, ported whole in slice 228 (§3.5jc).
        ; The result of this frame is
        ;   False   — `result` false;
        ;   Unknown — a recursive variance sentinel fired below (rel_unknown_hits);
        ;   Maybe   — an assumption was used below (rel_maybe_hits), no Unknown;
        ;   True    — neither counter moved across the subtree.
        ; The counters are RESTORED on a False: a false child contributes nothing
        ; to its parent's Ternary (`&=` stops at the first False, `some` discards
        ; a False), exactly as upstream's discarded Ternary value.
        ;
        ; The maybe stack is NOT popped here as a matter of course. A Maybe leaves
        ; its keys on the stack *"such that when we hit depth zero above, we can
        ; report all of them as successful"*; a True records every key from
        ; maybe_start and truncates; a Maybe at depth 0 does the same; an Unknown
        ; at depth 0 truncates WITHOUT recording; a False truncates and records
        ; only itself as Failed. ★This is what the cache-off-inside-variance
        ; guard of slices 172–227 stood in for: the rows a variance measurement
        ; writes are PROVISIONAL (answered under the `computing` sentinel) and the
        ; reference answers later asks from them, so a port that writes FEWER rows
        ; there answers those asks by recomputing and gets the post-measurement
        ; answer instead (`varianceMeasurement`). Matching the rows, the guard
        ; goes, and with it the exponential re-measurement it cost
        ; (complexRecursiveCollections: >240 s → seconds).
        if result
        {
            var is_unknown false
            if rel_unknown_hits <> unknown_before
                set is_unknown: true
            var is_true false
            if is_unknown = false
            {
                if rel_maybe_hits = maybe_before
                    set is_true: true
            }
            var at_root false
            if rel_source_depth = rel_source_base
            {
                if rel_target_depth = rel_target_base
                    set at_root: true
            }
            if is_true or at_root
            {
                if is_unknown = false
                {
                    var q maybe_start
                    while q < rel_maybe_depth
                    {
                        this.rel_result_set(relation, rel_maybe_source[q], RelationComparisonResultSucceeded | propagating)
                        set rel_relation_count: rel_relation_count - 1
                        set q: q + 1
                    }
                }
                set rel_maybe_depth: maybe_start
            }
            return true
        }
        ; `r.relation.set(id, Failed)` — *when something is false under assumptions
        ; it will also be false without assumptions*.
        ;
        ; ★ NOT under overflow: a false that came out of the depth limiter is not a
        ; fact about the two types, and upstream tags exactly that row with an
        ; Overflow bit rather than a plain failure.
        ; ★★★ RECORDED ON THE WAY OUT OF AN OVERFLOW TOO (slice 216). Upstream's else-branch
        ; has no overflow guard: after the limiter trips, every level unwinds FALSE and
        ; writes its pair as Failed, so the next SILENT ask of any pair on that chain is
        ; answered from the cache at the first level. The guard that stood here left the
        ; chain unrecorded, the next ask walked the whole chain again to the same wall,
        ; and reported TS2321 a second time (`excessivelyDeepConditionalTypes`).
        this.rel_result_set(relation, key, RelationComparisonResultFailed | propagating)
        set rel_relation_count: rel_relation_count - 1
        set rel_maybe_depth: maybe_start
        set rel_maybe_hits: maybe_before
        set rel_unknown_hits: unknown_before
        false
    }

    ; getEffectiveConstraintOfIntersection, whole — the callee of the first of
    ; structuredTypeRelatedTo's three arms, written in slice 180.
    ;
    ; ★★★ IT ARRIVES BECAUSE THE HEADER BELOW CARRIED A PREMISE THAT HAD BEEN
    ; REFUTED IN THIS FILE ALREADY. That header said the three arms *have no
    ; input* because `TypeData` has no Intersection arm — the same sentence
    ; union_or_intersection_related_to's header records as having stopped being
    ; true at slice 121, and records under its own §3.5gk. So the refutation was
    ; written three hundred lines away and this copy of the claim outlived it.
    ; ★★A premise refuted at ONE of its sites stays standing at every other site
    ; that spells it, because nothing links the copies: the grep that finds the
    ; claim is over the WORDS, and the two headers do not share a phrase long
    ; enough for one to have found the other.
    ;
    ; ★The follow loop is bounded by the reference's own argument — *we keep
    ; following constraints as long as we have an instantiable type that is known
    ; not to be circular or infinite (hence we stop on index access types)* — so
    ; the three flags it walks through are the whole of it and an IndexedAccess
    ; ends the walk.
    procedure get_effective_constraint_of_intersection(this, types: ref[Array[ref[Type]?]], target_is_union: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let constraints &Array[ref[Type]?]^host()
        var has_disjoint_domain_type false
        let n types.get_length() as int
        var i 0
        while i < n
        {
            let row types[i]
            set i: i + 1
            if row = null
                return null
            let t row as ref[Type]
            if (t.flags & TypeFlagsInstantiable) <> 0
            {
                var constraint this.get_constraint_of_type(t)
                if this.unported_mark() <> mark
                    return null
                var following true
                while following
                {
                    set following: false
                    if constraint <> null
                    {
                        let c constraint as ref[Type]
                        if (c.flags & (TypeFlagsTypeParameter | TypeFlagsIndex | TypeFlagsConditional)) <> 0
                        {
                            set constraint: this.get_constraint_of_type(c)
                            if this.unported_mark() <> mark
                                return null
                            set following: true
                        }
                    }
                }
                if constraint <> null
                {
                    constraints.add(constraint)
                    ; The type variable itself rides along beside its constraint
                    ; whenever the TARGET is a union — the reference's own note:
                    ; *this way the type param can be compared with itself in the
                    ; target (with the influence of its constraint to match other
                    ; parts)*.
                    if target_is_union
                        constraints.add(t)
                }
            }
            if (t.flags & TypeFlagsInstantiable) = 0
            {
                if (t.flags & TypeFlagsDisjointDomains) <> 0
                    set has_disjoint_domain_type: true
                if (t.flags & TypeFlagsDisjointDomains) = 0
                {
                    if this.is_empty_anonymous_object_type(t)
                        set has_disjoint_domain_type: true
                }
            }
        }
        if constraints.get_length() = 0
            return null
        if target_is_union = false
        {
            if has_disjoint_domain_type = false
                return null
        }
        if has_disjoint_domain_type
        {
            ; "We add any types belong to one of the disjoint domains because they
            ; might cause the final intersection operation to reduce the union
            ; constraints."
            var j 0
            while j < n
            {
                let row2 types[j]
                set j: j + 1
                if row2 = null
                    return null
                let t2 row2 as ref[Type]
                if (t2.flags & TypeFlagsDisjointDomains) <> 0
                    constraints.add(t2)
                if (t2.flags & TypeFlagsDisjointDomains) = 0
                {
                    if this.is_empty_anonymous_object_type(t2)
                        constraints.add(t2)
                }
            }
        }
        ; "The source types were normalized; ensure the result is normalized too."
        let it this.get_intersection_type_ex(constraints, IntersectionFlagsNoConstraintReduction, null)
        if this.unported_mark() <> mark
            return null
        if it = null
            return null
        this.normalize_relation_operand(it as ref[Type], false)
    }

    ; `everyType(constraint, func(c) { return c != source })` — the guard on the
    ; combined-constraint retry, written out because Scaly has no closure value.
    ; ★It is what stops the retry re-asking the question it is the answer to: a
    ; combined constraint that IS the source would re-enter is_related_to_ex with
    ; the identical pair.
    function every_type_differs_from(this, t: ref[Type], other: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return t <> other
        let ts Checker.union_types_of(t)
        if ts = null
            return t <> other
        let cs ts as ref[Array[ref[Type]?]]
        let n cs.get_length() as int
        var i 0
        while i < n
        {
            let row cs[i]
            set i: i + 1
            if row = null
                return false
            if (row as ref[Type]) = other
                return false
        }
        true
    }

    ; structuredTypeRelatedTo — the entry, and since slice 180 its THREE ARMS are
    ; written. The header that stood here said they *have no input* because
    ; `TypeData` has no Intersection arm; that premise expired at slice 121 and the
    ; account is at get_effective_constraint_of_intersection above.
    ;
    ; ★The error-state save/restore around the call is the CHAIN's, and this port
    ; has no chain — see the report containment in properties_related_to.
    ; structuredTypeRelatedTo — the wrapper, and since slice 167 it is not empty:
    ; `saveErrorState` is taken HERE and read inside the worker, where
    ; `reportStructuralErrors` asks whether anything has been added to the chain
    ; since this comparison began.
    ;
    ; ★★ THE SAVED CHAIN IS COMPARED BY DEPTH AND NOT BY IDENTITY, and the two are
    ; the same question at the one place that asks it: between this line and the
    ; test the chain can only have GROWN by prepends or been restored to exactly
    ; this value, so equal depth is equal chain. A depth lives on the node
    ; (ErrorChain's header) so the test is one load.
    ;
    ; ★★★ AND SINCE SLICE 168 THE WRAPPER'S OWN LINE IS WRITTEN TOO —
    ; `if result != TernaryFalse { r.restoreErrorState(saveErrorState) }`. It is not
    ; tidying: the relation emits whenever the chain is NON-EMPTY, so a level that
    ; reported on a route it then abandoned puts a diagnostic on a comparison that
    ; SUCCEEDED. `varianceComputationNoCrash`'s invented TS2322 was exactly that,
    ; and it had been latent since the chain landed one slice earlier because the
    ; only unit that reached it sat behind a stop.
    ; ★The three other restores the reference makes are at the arms that need them
    ; — the generic-mapped TARGET, the distributive conditional and the N×M
    ; signature loop — and each is written beside its arm rather than here.
    ; ★The variance branch's `originalErrorChain` — *we remember the original error
    ; information so we can restore it in case the structural comparison
    ; unexpectedly succeeds* — and the indexed-access branch's shorter-chain
    ; preference are still not written: this port's variance arms stop
    ; (`get-variances`, `get-alias-variances`) and the target-IndexedAccess branch
    ; is not here. They come with the arms that read them.
    procedure structured_type_related_to(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        let save_chain rel_error_chain
        let save_depth Checker.chain_depth(rel_error_chain)
        let saved rel_structural_chain_depth
        let saved_chain rel_structural_chain
        set rel_structural_chain_depth: save_depth
        set rel_structural_chain: save_chain
        var answer this.structured_type_related_to_worker(source, target, relation, error_node, intersection_state)
        set rel_structural_chain_depth: saved
        set rel_structural_chain: saved_chain
        ; ── the three arms, slice 180 ────────────────────────────────────
        ;
        ; All three are `r.relation != r.c.identityRelation`, which is the one
        ; guard they share, and each is written at the polarity the reference
        ; gives it: the first fires only on a FALSE, the other two only on a TRUE.
        if relation <> RelationIdentity
        {
            ; ★★★ ARM ONE — THE COMBINED CONSTRAINT, and it is the route that made
            ; `union-origin-alias` a wall. The reference's own comment: *the
            ; combined constraint of an intersection type is the intersection of
            ; the constraints of the constituents … One is when the target is a
            ; union type.* For `{b: number} & S` against `S`'s union constraint
            ; the port answered FALSE and invented a TS2344 where the reference is
            ; silent; this arm is what it takes instead, and the invention was
            ; PRE-EXISTING rather than caused by the fast paths — which is what
            ; slice 178's reduction had proven against the parent binary without
            ; naming the route. ★A source TYPE PARAMETER counts too, but only
            ; against a union target: a parameter with a union constraint has to
            ; be hoisted into an intersection with itself to be comparable with
            ; itself in the target.
            if answer = false
            {
                var eligible false
                if (source.flags & TypeFlagsIntersection) <> 0
                    set eligible: true
                if (source.flags & TypeFlagsTypeParameter) <> 0
                {
                    if (target.flags & TypeFlagsUnion) <> 0
                        set eligible: true
                }
                if eligible
                {
                    let mark this.unported_mark()
                    var source_types: ref[Array[ref[Type]?]]? null
                    if (source.flags & TypeFlagsIntersection) <> 0
                        set source_types: Checker.union_or_intersection_types_of(source)
                    if (source.flags & TypeFlagsIntersection) = 0
                    {
                        let one &Array[ref[Type]?]^host()
                        one.add(source)
                        set source_types: one
                    }
                    if source_types <> null
                    {
                        var target_is_union false
                        if (target.flags & TypeFlagsUnion) <> 0
                            set target_is_union: true
                        let constraint this.get_effective_constraint_of_intersection(source_types as ref[Array[ref[Type]?]], target_is_union)
                        if this.unported_mark() = mark
                        {
                            if constraint <> null
                            {
                                let c constraint as ref[Type]
                                ; "TODO: Stack errors so we get a pyramid for the
                                ; 'normal' comparison above, _and_ a second for
                                ; this" — the retry reports NOTHING, so the chain
                                ; the failed comparison left is what a caller sees
                                ; if this one fails too.
                                if this.every_type_differs_from(c, source)
                                    set answer: this.is_related_to_ex(c, target, relation, null, intersection_state, RecursionFlagsSource)
                            }
                        }
                    }
                }
            }
            ; ★★★ ARM TWO — THE NESTED EXCESS PROPERTY AND THE NESTED WEAK TYPE,
            ; on a TRUE against an INTERSECTION target. The reference's two
            ; motivating examples are both programs that *should be errors but
            ; aren't without this extra property check*, so the arm can only ever
            ; turn a true into a false.
            ;
            ; ★★★ AND THE TWO ARE ONE `switch` UPSTREAM, so arm three is arm two's
            ; ELSE and may not run when arm two did. `arm_two` therefore records
            ; the CONDITION rather than the outcome — both cases test `result != 0`
            ; against the value arm two would change, and Go evaluates the second
            ; case only when the first was false, i.e. against the unchanged one.
            var arm_two false
            if answer
            {
                if (intersection_state & IntersectionStateTarget) = 0
                {
                    if (target.flags & TypeFlagsIntersection) <> 0
                    {
                        if (source.flags & (TypeFlagsObject | TypeFlagsIntersection)) <> 0
                        {
                            let mark2 this.unported_mark()
                            let generic this.is_generic_object_type(target)
                            if this.unported_mark() = mark2
                            {
                                if generic = false
                                    set arm_two: true
                            }
                        }
                    }
                }
            }
            if arm_two
            {
                set answer: this.properties_related_to(source, target, relation, error_node, false, IntersectionStateNone)
                if answer
                {
                    if Checker.is_object_literal_type(source)
                    {
                        if (source.object_flags & ObjectFlagsFreshLiteral) <> 0
                            set answer: this.index_signatures_related_to(source, target, false, relation, error_node, IntersectionStateNone)
                    }
                }
            }
            ; ★★★ ARM THREE — THE SOURCE INTERSECTION'S OPTIONALS, and it is an
            ; ELSE of arm two upstream (one `switch` with two cases), so it may
            ; not run when arm two did. The reference's example is a mismatched
            ; property that lives in ONE constituent of the source intersection:
            ; `x: { a?: string }` assigned from `y: T & { a: boolean }`.
            ;
            ; ★★★ ITS GUARD WAS ALREADY IN THIS FILE, WITH NO CALLER — and this
            ; slice wrote a second copy before §3.5fp's duplicate grep caught it.
            ; `is_source_intersection_needing_extra_check` sits nine hundred lines
            ; up and its own header says what it is for: *it gates the
            ; optionals-only re-check at the tail of structuredTypeRelatedTo*. So
            ; the header below claimed the three arms had no input while the file
            ; held one arm's guard, written, named after that arm, unreachable.
            if answer
            {
                if arm_two = false
                {
                    let mark3 this.unported_mark()
                    let non_generic this.is_non_generic_object_type(target)
                    if this.unported_mark() = mark3
                    {
                        if non_generic
                        {
                            let arr this.is_array_or_tuple_type(target)
                            if this.unported_mark() = mark3
                            {
                                if arr = false
                                {
                                    let needs this.is_source_intersection_needing_extra_check(source, target)
                                    if this.unported_mark() = mark3
                                    {
                                        if needs
                                            set answer: this.properties_related_to(source, target, relation, error_node, true, intersection_state)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ; ★★★ THE UNDO — `if result != TernaryFalse { r.restoreErrorState(saveErrorState) }`.
        ; A comparison that SUCCEEDS takes back everything it reported on the way.
        if answer
            set rel_error_chain: save_chain
        answer
    }


    ; structuredTypeRelatedToWorker — the object path, and the thirteen arms in
    ; front of it accounted for one by one.
    ;
    ; ★★★ NOTHING IN THIS CHAPTER REPORTS, AND THAT IS A PROOF OFF THE REFERENCE'S
    ; OWN SUPPRESSION SWITCH RATHER THAN A SHORTCUT. Upstream every `reportError`
    ; here APPENDS TO A CHAIN and the relation emits exactly ONE diagnostic, built
    ; in `checkTypeRelatedToEx` from the chain's HEAD — and the head is the LAST
    ; message reported, which is `reportRelationError`'s, because it runs after
    ; everything in here. The five messages that can be the head instead are named
    ; by that function's own switch: the two excess-property ones (which is why
    ; `has_excess_properties` DOES report), the two excessive-* ones and the
    ; readonly-vs-mutable one, and none of the latter three is reported from this
    ; chapter. ★★A dump carries a diagnostic's CODE and SPAN, so a link that is not
    ; the head is invisible in both directions: writing these reports into this
    ; port's chain-free reporter would INVENT a line per property.
    ; typeArgumentsRelatedTo, whole.
    ;
    ; ★★★ THE VARIANCE IS READ POSITIONALLY AND A MISSING ENTRY IS COVARIANT, which
    ; is the reference's documented default for two cases: a recursive measurement
    ; (the empty list) and a `this` type argument, which has no measured variance
    ; at all. So the loop runs over min(len(sources), len(targets)) and asks the
    ; variance list only where it reaches.
    ;
    ; ★★★ THE FOUR VARIANCES ARE FOUR DIFFERENT COMPARISONS AND THE ORDER INSIDE
    ; TWO OF THEM IS DELIBERATE. Bivariant compares CONTRAVARIANTLY first without
    ; reporting and only then covariantly with it; invariant compares covariantly
    ; first and contravariantly second — both so that the error a reader sees comes
    ; out of the covariant check, which is the one that reads like the program. The
    ; port carries the order even though it reports nothing here, because the two
    ; comparisons are not interchangeable when either can stop.
    ;
    ; ★★ AN `Independent` ARGUMENT IS SKIPPED ENTIRELY — the type parameter is not
    ; witnessed anywhere in the generic type, so nothing about the argument can
    ; make the two instantiations differ.
    ; compareTypesIdentical, compareTypesAssignableSimple, compareTypesAssignableWorker
    ; and compareTypesSubtypeOf — the relation under four `TypeComparer` names, one
    ; line each upstream and one line each here. They exist upstream to be PASSED as
    ; a function value (compareSignaturesRelated takes a comparer); this port passes
    ; a comparer TAG instead (SignatureComparer*), so the three that are only ever
    ; passed have no other reader. compare_types_identical does: it is called
    ; directly, from type_arguments_related_to's Unmeasurable arm.
    procedure compare_types_identical(this, source: ref[Type], target: ref[Type]) returns bool
        this.is_type_related_to(source, target, RelationIdentity)

    ; The two reliability mappers, minted rather than memoised: the reference holds
    ; one of each on the Checker, and there is nothing in either to share — the arm
    ; carries a single bool and the mapper's whole product is the flag it sets.
    function new_reliability_mapper(this, unmeasurable: bool) returns ref[TypeMapper]
    {
        let p &TypeMapper^host(TypeMapperData.Reliability(ReliabilityTypeMapperData(unmeasurable)))
        p
    }

    procedure type_arguments_related_to(this, sources: ref[Array[ref[Type]?]]?, targets: ref[Array[ref[Type]?]]?, variances: ref[Array[int]], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        var ns 0
        if sources <> null
            set ns: (sources as ref[Array[ref[Type]?]]).get_length() as int
        var nt 0
        if targets <> null
            set nt: (targets as ref[Array[ref[Type]?]]).get_length() as int
        if ns <> nt
        {
            if relation = RelationIdentity
                return false
        }
        var length ns
        if nt < ns
            set length: nt
        let nv variances.get_length() as int
        var i 0
        while i < length
        {
            var variance_flags VarianceFlagsCovariant
            if i < nv
                set variance_flags: variances[i]
            let variance variance_flags & VarianceFlagsVarianceMask
            if variance <> VarianceFlagsIndependent
            {
                let so (sources as ref[Array[ref[Type]?]])[i]
                let to (targets as ref[Array[ref[Type]?]])[i]
                if so = null
                    return false
                if to = null
                    return false
                let sv so as ref[Type]
                let tv to as ref[Type]
                var related false
                if (variance_flags & VarianceFlagsUnmeasurable) <> 0
                {
                    ; Even an Unmeasurable variance works out without a structural
                    ; check when the two arguments are IDENTICAL — the reference's
                    ; own note, and the reason invariance may not simply be assumed
                    ; (Unmeasurable marks a NON-LINEAR relation, e.g. one tainted by
                    ; a mapped type's `-?`).
                    if relation = RelationIdentity
                        set related: this.is_related_to_ex(sv, tv, relation, null, intersection_state, RecursionFlagsBoth)
                    if relation <> RelationIdentity
                        set related: this.compare_types_identical(sv, tv)
                }
                if (variance_flags & VarianceFlagsUnmeasurable) = 0
                {
                    ; Propagate the unreliable flag. The instantiation's PRODUCT is
                    ; dropped; what it is for is the side effect in the Reliability
                    ; mapper — see type_mapper_map's arm.
                    if in_variance_computation
                    {
                        if (variance_flags & VarianceFlagsUnreliable) <> 0
                            this.instantiate_type(sv, this.new_reliability_mapper(false))
                    }
                    if variance = VarianceFlagsCovariant
                        set related: this.is_related_to_ex(sv, tv, relation, error_node, intersection_state, RecursionFlagsBoth)
                    if variance = VarianceFlagsContravariant
                        set related: this.is_related_to_ex(tv, sv, relation, error_node, intersection_state, RecursionFlagsBoth)
                    if variance = VarianceFlagsBivariant
                    {
                        set related: this.is_related_to_ex(tv, sv, relation, null, intersection_state, RecursionFlagsBoth)
                        if related = false
                            set related: this.is_related_to_ex(sv, tv, relation, error_node, intersection_state, RecursionFlagsBoth)
                    }
                    if variance = VarianceFlagsInvariant
                    {
                        set related: this.is_related_to_ex(sv, tv, relation, error_node, intersection_state, RecursionFlagsBoth)
                        if related
                            set related: this.is_related_to_ex(tv, sv, relation, error_node, intersection_state, RecursionFlagsBoth)
                    }
                }
                if related = false
                    return false
            }
            set i: i + 1
        }
        true
    }

    ; isDistributionDependent — slice 157. Two lines, and the whole reason the
    ; target CONDITIONAL arm may not simply be attempted: a distributive
    ; conditional whose check type parameter appears in either RESULT cannot be
    ; decided branch by branch, because the distribution is what determines the
    ; branches.
    procedure is_distribution_dependent(this, root: ref[ConditionalRoot]) returns bool
    {
        if root.is_distributive = false
            return false
        let true_node AstNode.conditional_type_true_of(root.node)
        if true_node <> null
        {
            if this.is_type_parameter_possibly_referenced(root.check_type, true_node as ref[AstNode])
                return true
        }
        let false_node AstNode.conditional_type_false_of(root.node)
        if false_node = null
            return false
        this.is_type_parameter_possibly_referenced(root.check_type, false_node as ref[AstNode])
    }

    ; intersectTypes — slice 157. The reference's own two-argument shortcut: a nil
    ; operand is the identity, so `intersectTypes(a, nil)` is `a`.
    procedure intersect_types(this, type1: ref[Type]?, type2: ref[Type]?) returns ref[Type]?
    {
        if type1 = null
            return type2
        if type2 = null
            return type1
        let pair &Array[ref[Type]?]()
        pair.add(type1)
        pair.add(type2)
        this.get_intersection_type(pair)
    }

    ; isPartialMappedType — a mapped type that ADDS the optional modifier, which
    ; is what makes an empty object type related to it: `{}` satisfies
    ; `{ [P in K]?: T }` because every property may be absent.
    function is_partial_mapped_type(t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsMapped) = 0
            return false
        (Checker.get_mapped_type_modifiers(t) & MappedTypeModifiersIncludeOptional) <> 0
    }

    ; mappedTypeRelatedTo — the arm the default case takes when BOTH sides are
    ; generic mapped types, slice 157.
    ;
    ; ★★★ THE MODIFIERS DECIDE WHETHER THE COMPARISON HAPPENS AT ALL, and the
    ; three ways they can be related are not the same question: COMPARABLE asks
    ; nothing, IDENTITY asks for the same modifiers, and every other relation asks
    ; that the source be no MORE optional than the target — which is what makes
    ; `{ [P in K]: T }` assignable to `{ [P in K]?: T }` and not the other way.
    ;
    ; ★★★ `instantiateType(constraint, reportUnmeasurableMapper|reportUnreliableMapper)`
    ; IS LOAD-BEARING, AND THE NOTE THAT CALLED IT THE IDENTITY EXPIRED WITH
    ; `create_marker_type`. It read *both workers return their argument untouched
    ; and only raise a reliability flag for the three MARKER types, which this port
    ; never mints* — true when `measure_variance` was a stop and false since it was
    ; written: the markers ARE minted, and this instantiation is the only route by
    ; which a mapped type in a variance measurement raises Unreliable. Without the
    ; bit the variance comes out INVARIANT with nothing saying it is untrustworthy,
    ; `relate_variances` finds no `AllowsStructuralFallback` and answers false, and
    ; the structural comparison that relates the two instantiations never runs —
    ; `ObjectContaining<T>` with `new (sample: Partial<T>): Partial<T>` reported a
    ; TS2322 on both `cfoo = cafoo` and `cafoo = cfoo`.
    ; ★ The product is DROPPED upstream too in all but name: the two workers hand
    ; back their argument. What the call is for is the side effect — see
    ; `type_mapper_map`'s Reliability arm and `type_arguments_related_to`'s second
    ; instantiation, which is written for exactly the same reason.
    ; ★ `< 0` is the UNMEASURABLE side: an optionality below zero is a `-?` mapped
    ; type, whose relation is non-linear rather than merely unmeasured.
    procedure mapped_type_related_to(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?) returns bool
    {
        let mark this.unported_mark()
        var modifiers_related false
        if relation = RelationComparable
            set modifiers_related: true
        ; ★ The three ways are an OR and the reference SHORT-CIRCUITS, so the
        ; optionality is asked only where it decides — it resolves a mapped type's
        ; constraint and could report on its own.
        if modifiers_related = false
        {
            if relation = RelationIdentity
            {
                if Checker.get_mapped_type_modifiers(source) = Checker.get_mapped_type_modifiers(target)
                    set modifiers_related: true
            }
            else
            {
                let so this.get_combined_mapped_type_optionality(source)
                let to this.get_combined_mapped_type_optionality(target)
                if this.unported_mark() <> mark
                    return false
                if so <= to
                    set modifiers_related: true
            }
        }
        if modifiers_related = false
            return false
        let target_constraint this.get_constraint_type_from_mapped_type(target)
        let raw_source_constraint this.get_constraint_type_from_mapped_type(source)
        let source_optionality this.get_combined_mapped_type_optionality(source)
        let source_constraint this.instantiate_type(raw_source_constraint, this.new_reliability_mapper(source_optionality < 0))
        if this.unported_mark() <> mark
            return false
        if target_constraint = null
            return false
        if source_constraint = null
            return false
        if this.is_related_to_ex(target_constraint as ref[Type], source_constraint as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth) = false
            return false
        if this.unported_mark() <> mark
            return false
        let s_param this.get_type_parameter_from_mapped_type(source)
        let t_param this.get_type_parameter_from_mapped_type(target)
        if this.unported_mark() <> mark
            return false
        let mapper this.new_simple_type_mapper(s_param, t_param)
        let s_name this.get_name_type_from_mapped_type(source)
        let t_name this.get_name_type_from_mapped_type(target)
        if this.unported_mark() <> mark
            return false
        ; ★ The two NAME types are instantiated through the same mapper and then
        ; compared by IDENTITY, not by relation: a remapped target's keys must be
        ; the source's keys under the parameter renaming, or the properties do not
        ; correspond at all and the templates are not worth comparing.
        var s_name_inst: ref[Type]? s_name
        if s_name <> null
            set s_name_inst: this.instantiate_type(s_name as ref[Type], mapper)
        var t_name_inst: ref[Type]? t_name
        if t_name <> null
            set t_name_inst: this.instantiate_type(t_name as ref[Type], mapper)
        if this.unported_mark() <> mark
            return false
        if s_name_inst <> t_name_inst
            return false
        let s_template this.get_template_type_from_mapped_type(source)
        let t_template this.get_template_type_from_mapped_type(target)
        if this.unported_mark() <> mark
            return false
        if s_template = null
            return false
        if t_template = null
            return false
        let s_template_inst this.instantiate_type(s_template as ref[Type], mapper)
        if this.unported_mark() <> mark
            return false
        if s_template_inst = null
            return false
        this.is_related_to_ex(s_template_inst as ref[Type], t_template as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
    }

    ; relateVariances, the closure inside structuredTypeRelatedToWorker, lifted
    ; into a function of its own — it is called from two arms (the type reference
    ; and the alias probe) and closes over nothing this port carries.
    ;
    ; ★★★ IT HAS THREE ANSWERS AND NOT TWO, WHICH IS WHY IT IS AN INT. The
    ; reference returns `(Ternary, bool)`: the boolean says whether the variance
    ; comparison DECIDED, and a false there means *fall through to the structural
    ; comparison below*. Collapsing that into a bool would turn every structural
    ; fallback into a `false` answer.
    ;
    ; ★★ THE FALLBACK HAS TWO REASONS AND THEY ARE NOT THE SAME. An `Unmeasurable`
    ; or `Unreliable` type parameter falls back because the measurement itself
    ; cannot be trusted; a COVARIANT `void` argument on the target falls back
    ; because `void` is structurally assignable to nothing, so a type parameter
    ; used only in return positions would refuse every source.
    ;
    ; ★★★ THE `varianceCheckFailed && !(reportErrors && some(invariant))` ARM, AND
    ; THE NOTE THAT ARGUED IT AWAY WAS RIGHT ABOUT THE CHAIN AND WRONG ABOUT THE
    ; ARM. It read *the arm and the error-chain save it guards are the CHAIN's,
    ; which this port does not carry, so the arm's product is the same `false` the
    ; tail already gives* — and what the reference's `false, false` does there is
    ; let the walk GO ON, which is not the same as reporting differently. Two
    ; things happen after it that an early `false` never reaches: the arms BELOW
    ; the alias probe run (the type-reference arm relates `Shape<1>` to
    ; `Shape<1|2>` covariantly and answers TRUE, where the alias's own `in out`
    ; Value is Invariant and fails), and the structural comparison runs for its
    ; elaboration. So the arm is written, and the answer it must NOT give is
    ; *related*: that is the latch — see `RelateVariancesStructuralLatched`.
    ; ★ The `originalErrorChain` half is the caller's here, because in the
    ; reference it is a LOCAL of the worker that the object tail reads; both call
    ; sites save the chain when they take the latched answer.
    procedure relate_variances(this, source_type_arguments: ref[Array[ref[Type]?]]?, target_type_arguments: ref[Array[ref[Type]?]]?, variances: ref[Array[int]], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns int
    {
        if this.type_arguments_related_to(source_type_arguments, target_type_arguments, variances, relation, error_node, intersection_state)
            return RelateVariancesTrue
        let n variances.get_length() as int
        var i 0
        while i < n
        {
            if (variances[i] & VarianceFlagsAllowsStructuralFallback) <> 0
                return RelateVariancesStructural
            set i: i + 1
        }
        if Checker.has_covariant_void_argument(target_type_arguments, variances)
            return RelateVariancesStructural
        if n <> 0
        {
            ; `varianceCheckFailed && !(reportErrors && some(invariant))` — a
            ; non-null error node is this port's reportErrors, and Unmeasured can
            ; never appear here (get_variances answers null for it), so a zero
            ; variance mask is an Invariant the reference measured or an author
            ; wrote `in out`.
            if error_node = null
                return RelateVariancesFalse
            var some_invariant false
            var j 0
            while j < n
            {
                if (variances[j] & VarianceFlagsVarianceMask) = VarianceFlagsInvariant
                    set some_invariant: true
                set j: j + 1
            }
            if some_invariant = false
                return RelateVariancesFalse
            return RelateVariancesStructuralLatched
        }
        RelateVariancesStructural
    }

    procedure structured_type_related_to_worker(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        var src source
        ; `varianceCheckFailed` and `originalErrorChain`, both LOCALS of this
        ; function upstream and both read by the object tail — see
        ; `RelateVariancesStructuralLatched`. They are locals here for the reason
        ; they are there: the worker recurses through `is_related_to_ex`, and a
        ; Checker field would let an inner comparison's failed variance check
        ; decide an outer one's structural success.
        var variance_check_failed false
        var original_chain: ref[ErrorChain]? null
        if relation = RelationIdentity
        {
            ; ★★★ THE IDENTITY HEAD'S SEVEN ARMS, AND THE NOTE THAT STOOD HERE
            ; EXPIRED WITH SLICE 121. It read *"only the first can be minted
            ; here"* — true while an Index, an IndexedAccess, a Conditional, a
            ; Substitution, a TemplateLiteral and a StringMapping had no producer,
            ; and false the moment this slice gave five of them one. The cost of
            ; leaving it was a WRONG ANSWER rather than a stop: the tail below
            ; answers FALSE for anything that is not an object, so two IDENTICAL
            ; conditional types compared as DIFFERENT and
            ; `errorNextVariableOrPropertyDeclarationMustHaveSameType` reported
            ; TS2403 on `type T1 = T extends string ? boolean : number; type T2 =
            ; <the same>; var x: T1; var x: T2` — measured on
            ; `submodule_conformance_types_conditional_conditionalTypes1`, where
            ; the reference reports it for the NEXT function instead.
            ;
            ; ★ `reportErrors` is FALSE in every one of these recursions upstream,
            ; so the error node is dropped: the identity relation's arms never
            ; report and the caller's own message is the whole diagnostic.
            if (src.flags & TypeFlagsUnionOrIntersection) <> 0
            {
                ; Both directions, which is what makes it IDENTITY rather than
                ; mutual assignability: every constituent of each side must find a
                ; partner in the other.
                if this.each_type_related_to_some_type(src, target, relation) = false
                    return false
                return this.each_type_related_to_some_type(target, src, relation)
            }
            if (src.flags & TypeFlagsIndex) <> 0
            {
                let s_t Checker.index_target_of(src)
                let t_t Checker.index_target_of(target)
                if s_t = null
                    return false
                if t_t = null
                    return false
                return this.is_related_to_ex(s_t as ref[Type], t_t as ref[Type], relation, null, intersection_state, RecursionFlagsBoth)
            }
            if (src.flags & TypeFlagsIndexedAccess) <> 0
            {
                let s_o Checker.indexed_access_object_type_of(src)
                let t_o Checker.indexed_access_object_type_of(target)
                let s_i Checker.indexed_access_index_type_of(src)
                let t_i Checker.indexed_access_index_type_of(target)
                if s_o = null
                    return false
                if t_o = null
                    return false
                if s_i = null
                    return false
                if t_i = null
                    return false
                if this.is_related_to_ex(s_o as ref[Type], t_o as ref[Type], relation, null, intersection_state, RecursionFlagsBoth)
                {
                    if this.is_related_to_ex(s_i as ref[Type], t_i as ref[Type], relation, null, intersection_state, RecursionFlagsBoth)
                        return true
                }
                ; The reference FALLS THROUGH to the object tail on a false here,
                ; and the tail's `source.flags&Object == 0` then answers false —
                ; which is this arm's answer too, one line later.
                return false
            }
            if (src.flags & TypeFlagsConditional) <> 0
            {
                let s_root Checker.conditional_root_of(src)
                let t_root Checker.conditional_root_of(target)
                if s_root = null
                    return false
                if t_root = null
                    return false
                if (s_root as ref[ConditionalRoot]).is_distributive <> (t_root as ref[ConditionalRoot]).is_distributive
                    return false
                let s_c Checker.conditional_check_type_of(src)
                let t_c Checker.conditional_check_type_of(target)
                let s_e Checker.conditional_extends_type_of(src)
                let t_e Checker.conditional_extends_type_of(target)
                if s_c = null
                    return false
                if t_c = null
                    return false
                if s_e = null
                    return false
                if t_e = null
                    return false
                if this.is_related_to_ex(s_c as ref[Type], t_c as ref[Type], relation, null, intersection_state, RecursionFlagsBoth) = false
                    return false
                if this.is_related_to_ex(s_e as ref[Type], t_e as ref[Type], relation, null, intersection_state, RecursionFlagsBoth) = false
                    return false
                let identity_mark this.unported_mark()
                let s_true this.get_true_type_from_conditional_type(src)
                let t_true this.get_true_type_from_conditional_type(target)
                let s_false this.get_false_type_from_conditional_type(src)
                let t_false this.get_false_type_from_conditional_type(target)
                if this.unported_mark() <> identity_mark
                    return false
                if s_true = null
                    return false
                if t_true = null
                    return false
                if s_false = null
                    return false
                if t_false = null
                    return false
                if this.is_related_to_ex(s_true as ref[Type], t_true as ref[Type], relation, null, intersection_state, RecursionFlagsBoth) = false
                    return false
                return this.is_related_to_ex(s_false as ref[Type], t_false as ref[Type], relation, null, intersection_state, RecursionFlagsBoth)
            }
            if (src.flags & TypeFlagsSubstitution) <> 0
            {
                let s_b Checker.substitution_base_type_of(src)
                let t_b Checker.substitution_base_type_of(target)
                let s_k Checker.substitution_constraint_of(src)
                let t_k Checker.substitution_constraint_of(target)
                if s_b = null
                    return false
                if t_b = null
                    return false
                if s_k = null
                    return false
                if t_k = null
                    return false
                if this.is_related_to_ex(s_b as ref[Type], t_b as ref[Type], relation, null, intersection_state, RecursionFlagsBoth) = false
                    return false
                return this.is_related_to_ex(s_k as ref[Type], t_k as ref[Type], relation, null, intersection_state, RecursionFlagsBoth)
            }
            if (src.flags & TypeFlagsTemplateLiteral) <> 0
            {
                ; `slices.Equal(texts, texts)` first — the literal spans have to
                ; match exactly before the types are compared position by position.
                if Checker.template_texts_equal(src, target) = false
                    return false
                let s_ty Checker.template_literal_types_of(src)
                let t_ty Checker.template_literal_types_of(target)
                if s_ty = null
                    return false
                if t_ty = null
                    return false
                let sl s_ty as ref[Array[ref[Type]?]]
                let tl t_ty as ref[Array[ref[Type]?]]
                let n sl.get_length() as int
                if (tl.get_length() as int) <> n
                    return false
                var i 0
                while i < n
                {
                    let se sl[i]
                    let te tl[i]
                    if se = null
                        return false
                    if te = null
                        return false
                    if this.is_related_to_ex(se as ref[Type], te as ref[Type], relation, null, intersection_state, RecursionFlagsBoth) = false
                        return false
                    set i: i + 1
                }
                return true
            }
            if (src.flags & TypeFlagsStringMapping) <> 0
            {
                if src.symbol = null
                    return false
                if target.symbol = null
                    return false
                if (src.symbol as ref[Symbol]) <> (target.symbol as ref[Symbol])
                    return false
                let s_m Checker.string_mapping_target_of(src)
                let t_m Checker.string_mapping_target_of(target)
                if s_m = null
                    return false
                if t_m = null
                    return false
                return this.is_related_to_ex(s_m as ref[Type], t_m as ref[Type], relation, null, intersection_state, RecursionFlagsBoth)
            }
            if (src.flags & TypeFlagsObject) = 0
                return false
        }
        if relation <> RelationIdentity
        {
            if (src.flags & TypeFlagsUnionOrIntersection) <> 0
            {
                var branch 0 - 1
                if this.union_or_intersection_related_to(src, target, relation, error_node, intersection_state, &branch)
                    return true
                if (src.flags & (TypeFlagsInstantiable | TypeFlagsIntersection)) = 0
                {
                    if (target.flags & TypeFlagsUnion) = 0
                        return false
                    if (src.flags & TypeFlagsObject) = 0
                        return false
                }
            }
            if (src.flags & TypeFlagsUnionOrIntersection) = 0
            {
                if (target.flags & TypeFlagsUnionOrIntersection) <> 0
                {
                    var branch2 0 - 1
                    if this.union_or_intersection_related_to(src, target, relation, error_node, intersection_state, &branch2)
                        return true
                    if (src.flags & TypeFlagsInstantiable) = 0
                    {
                        if (target.flags & TypeFlagsUnion) = 0
                            return false
                        if (src.flags & TypeFlagsObject) = 0
                            return false
                    }
                }
            }
        }
        ; The ALIAS variance probe. ★Its guard is fully readable here — slice 111
        ; put both alias slots on `Type` — and what it needs next is
        ; `getAliasVariances`, the variance measurement this port has none of.
        if (src.flags & (TypeFlagsObject | TypeFlagsConditional)) <> 0
        {
            if src.alias_symbol <> null
            {
                if src.alias_type_arguments <> null
                {
                    if ((src.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                    {
                        if target.alias_symbol = src.alias_symbol
                        {
                            var probe true
                            if this.is_marker_type(src)
                                set probe: false
                            if this.is_marker_type(target)
                                set probe: false
                            if probe
                            {
                                let variances this.get_alias_variances(src.alias_symbol as ref[Symbol])
                                if variances = null
                                {
                                    this.record_unported("get-alias-variances", src.flags)
                                    return false
                                }
                                let vs variances as ref[Array[int]]
                                if (vs.get_length() as int) = 0
                                {
                                    ; TernaryUnknown — see rel_unknown_hits.
                                    set rel_unknown_hits: rel_unknown_hits + 1
                                    return true
                                }
                                ; fillMissingTypeArguments on both sides (slice 254)
                                let params this.type_alias_link_of(src.alias_symbol as ref[Symbol]).type_parameters
                                var source_types: ref[Array[ref[Type]?]]? null
                                var target_types: ref[Array[ref[Type]?]]? null
                                if params <> null
                                {
                                    let ps params as ref[Array[ref[Type]?]]
                                    let min_params this.get_min_type_argument_count(ps)
                                    let alias_declaration Symbol.value_declaration_of(src.alias_symbol as ref[Symbol])
                                    var in_js false
                                    if alias_declaration <> null
                                        set in_js: ((AstNode.flags_of(alias_declaration as ref[AstNode]) & NodeFlagsJavaScriptFile) <> 0)
                                    var sargs src.alias_type_arguments
                                    if sargs = null
                                        set sargs: this.new_type_list(null)
                                    var targs target.alias_type_arguments
                                    if targs = null
                                        set targs: this.new_type_list(null)
                                    let fill_mark this.unported_mark()
                                    set source_types: this.fill_missing_type_arguments(sargs as ref[Array[ref[Type]?]], ps, min_params, in_js)
                                    set target_types: this.fill_missing_type_arguments(targs as ref[Array[ref[Type]?]], ps, min_params, in_js)
                                    if this.unported_mark() <> fill_mark
                                        return false
                                }
                                let verdict this.relate_variances(source_types, target_types, vs, relation, error_node, intersection_state)
                                if verdict = RelateVariancesTrue
                                    return true
                                if verdict = RelateVariancesFalse
                                    return false
                                ; the Unmeasurable/Unreliable fallback: "we elide the variance-based
                                ; error elaborations" — the chain goes back to the saved one, so the
                                ; structural pass that follows REPORTS (its guard is `chain unchanged`)
                                if verdict = RelateVariancesStructural
                                    set rel_error_chain: rel_structural_chain
                                if verdict = RelateVariancesStructuralLatched
                                {
                                    set variance_check_failed: true
                                    set original_chain: rel_error_chain
                                    set rel_error_chain: rel_structural_chain
                                }
                            }
                        }
                    }
                }
            }
        }
        ; ★★★ THE TWO SINGLE-ELEMENT GENERIC TUPLE ARMS, SLICE 139. The stop that
        ; stood here asked `is_tuple_type` — EVERY tuple — for a pair of arms that
        ; apply to `[...T]` alone, so the whole tuple population of the corpus
        ; arrived at a report about a shape almost none of it had; the element infos
        ; its note named have been on the interface arm since slice 115 (§3.5eo).
        ;
        ; ★ The reference's comment is the rule: for a generic T and a U assignable
        ; to T, `[...U]` is assignable to T, U is assignable to `readonly [...T]`,
        ; and U is assignable to `[...T]` when U is constrained to a MUTABLE array
        ; or tuple. Both arms fall THROUGH on a false rather than answering it —
        ; the reference tests `result != TernaryFalse` and keeps going — which is
        ; why neither writes the negative.
        if Checker.is_single_element_generic_tuple_type(src)
        {
            let s_target Checker.target_of(src)
            var s_readonly false
            if s_target <> null
                set s_readonly: Checker.tuple_readonly_of(s_target as ref[Type])
            if s_readonly = false
            {
                let mark this.unported_mark()
                let args this.get_type_arguments(src)
                if this.unported_mark() <> mark
                    return false
                if args <> null
                {
                    let list args as ref[Array[ref[Type]?]]
                    if (list.get_length() as int) > 0
                    {
                        let a0 list[0]
                        if a0 <> null
                        {
                            if this.is_related_to_ex(a0 as ref[Type], target, relation, null, intersection_state, RecursionFlagsSource)
                                return true
                        }
                    }
                }
            }
        }
        if Checker.is_single_element_generic_tuple_type(target)
        {
            let t_target Checker.target_of(target)
            var admit false
            if t_target <> null
            {
                if Checker.tuple_readonly_of(t_target as ref[Type])
                    set admit: true
            }
            if admit = false
            {
                let mark this.unported_mark()
                let base this.get_base_constraint_or_type(src)
                if this.unported_mark() <> mark
                    return false
                if base <> null
                    set admit: this.is_mutable_array_or_tuple(base as ref[Type])
            }
            if admit
            {
                let mark2 this.unported_mark()
                let args this.get_type_arguments(target)
                if this.unported_mark() <> mark2
                    return false
                if args <> null
                {
                    let list args as ref[Array[ref[Type]?]]
                    if (list.get_length() as int) > 0
                    {
                        let a0 list[0]
                        if a0 <> null
                        {
                            if this.is_related_to_ex(src, a0 as ref[Type], relation, null, IntersectionStateNone, RecursionFlagsTarget)
                                return true
                        }
                    }
                }
            }
        }
        ; The thirteen-arm switch in front of `default`. ★★THE GUARD BELOW WAS ONE
        ; SENTENCE FOR SIX ARMS — *an IndexedAccess, an Index, a Conditional, a
        ; TemplateLiteral, a StringMapping and a mapped type are each a
        ; `get-type-from-type-node` row, so nothing this checker can mint carries
        ; their flags* — and it was asked as one guard *so that the arm which mints
        ; the first of them finds the fork here*. ★★★SLICE 126 IS THAT ARM: the
        ; TEMPLATE LITERAL is minted now, so its own arm is written and the guard
        ; keeps the four that still have no producer.
        ; ★★★ THE TARGET-TYPE-PARAMETER ARM, SLICE 139, AND WHAT IT MOSTLY DOES IS
        ; NOTHING. Both of its halves are conditional — a MAPPED source against the
        ; parameter's own `keyof`, and a comparability carve-out between two type
        ; parameters — so for the 330 units that arrived at the stop standing here
        ; the reference simply falls through to the object tail. The guard was a
        ; report about a shape it never examined.
        if (target.flags & TypeFlagsTypeParameter) <> 0
        {
            ; A source `{ [P in Q]: X }` is related to a target T if `keyof T` is
            ; related to Q and X is related to `T[Q]`. ★The NameType test is the
            ; reference's own: a mapped type with an `as` clause renames its keys,
            ; so its template no longer answers for `T[P]`.
            if (src.object_flags & ObjectFlagsMapped) <> 0
            {
                let decl Checker.mapped_declaration_of(src)
                var plain false
                if decl <> null
                {
                    if AstNode.mapped_type_name_type_of(decl as ref[AstNode]) = null
                        set plain: true
                }
                if plain
                {
                    let mark this.unported_mark()
                    let keyof this.get_index_type(target)
                    let constraint_type this.get_constraint_type_from_mapped_type(src)
                    if this.unported_mark() <> mark
                        return false
                    if keyof <> null
                    {
                        if constraint_type <> null
                        {
                            if this.is_related_to_ex(keyof as ref[Type], constraint_type as ref[Type], relation, null, IntersectionStateNone, RecursionFlagsBoth)
                            {
                                if (Checker.get_mapped_type_modifiers(src) & MappedTypeModifiersIncludeOptional) = 0
                                {
                                    let template this.get_template_type_from_mapped_type(src)
                                    let tp this.get_type_parameter_from_mapped_type(src)
                                    if this.unported_mark() <> mark
                                        return false
                                    if template <> null
                                    {
                                        if tp <> null
                                        {
                                            let indexed this.get_indexed_access_type(target, tp as ref[Type])
                                            if this.unported_mark() <> mark
                                                return false
                                            if indexed <> null
                                            {
                                                if this.is_related_to_ex(template as ref[Type], indexed as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
                                                    return true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            ; ★★★ THE CARVE-OUT IS THE ONE HALF THAT ANSWERS FALSE, and it is a
            ; deliberate restriction rather than a fallback: comparability is mostly
            ; bidirectional, so two unrelated type parameters would otherwise be
            ; comparable in both directions. One extending the other is the only
            ; way through, and the RETURN here — either the constraint's verdict or
            ; false — is what keeps the object tail from re-admitting the pair.
            if relation = RelationComparable
            {
                if (src.flags & TypeFlagsTypeParameter) <> 0
                {
                    let mark this.unported_mark()
                    let constraint this.get_constraint_of_type_parameter(src)
                    if this.unported_mark() <> mark
                        return false
                    if constraint <> null
                    {
                        if Checker.some_type_is_type_parameter(constraint as ref[Type])
                            return this.is_related_to_ex(constraint as ref[Type], target, relation, null, IntersectionStateNone, RecursionFlagsSource)
                    }
                    return false
                }
            }
        }
        if (target.flags & TypeFlagsTemplateLiteral) <> 0
        {
            if (src.flags & TypeFlagsTemplateLiteral) <> 0
            {
                ; ★ The COMPARABLE relation asks only that the two templates are
                ; not definitely unrelated — the placeholders are not compared at
                ; all, which is what makes `` `a${number}` `` comparable to
                ; `` `a${string}` ``.
                if relation = RelationComparable
                {
                    if Checker.template_literal_types_definitely_unrelated(src, target)
                        return false
                    return true
                }
                ; `instantiateType(source, reportUnreliableMapper)`: the RESULT is
                ; discarded, the EFFECT is not — a marker type met inside a placeholder
                ; sets the Unreliable reliability bit the variance probe reads
                ; (`foo-${number}` relates to `foo-${string}` though number is not string)
                this.instantiate_type(src, this.new_reliability_mapper(false))
            }
            ; ★★★ `if isTypeMatchedByTemplateLiteralType(source, target) { return True }` — a
            ; MATCH answers, a miss FALLS THROUGH to the source arms (slice 217): a type
            ; parameter against a template literal goes on to the type-variable arm, which
            ; relates its CONSTRAINT (or `unknown`). The `return` that stood here answered
            ; false for every non-matching source and never reached that arm —
            ; `Mapped5<K>[keyof Mapped5<K>]` against `_${string}` failed where the reference
            ; passes (`mappedTypeConstraints2`).
            let mark_tl this.unported_mark()
            let matched this.is_type_matched_by_template_literal_type(src, target, SignatureComparerRelaterWorker)
            if this.unported_mark() <> mark_tl
                return false
            if matched
                return true
        }
        if (target.flags & TypeFlagsStringMapping) <> 0
        {
            ; ★★★ IT FALLS THROUGH RATHER THAN ANSWERING, and the `return` that
            ; stood here was a different function: upstream's arm reports nothing
            ; when the source is a StringMapping too — that pair is the SOURCE
            ; arm's business — and a non-member source still reaches the default
            ; arm's structural comparison.
            if (src.flags & TypeFlagsStringMapping) = 0
            {
                if this.is_member_of_string_mapping(src, target)
                    return true
            }
        }
        ; ── the target INSTANTIABLE arms, slice 157 ──────────────────────────
        ;
        ; ★★★ EVERY ONE OF THEM FALLS THROUGH, which is why the three stops that
        ; stood here were not merely silent but the wrong SHAPE. Upstream these
        ; are `case` arms of the TARGET switch and the SOURCE switch runs
        ; afterwards on whatever they did not decide, so nothing but a positive
        ; verdict may leave early. The flags are disjoint, so a sequence of `if`s
        ; is the switch.
        if (target.flags & TypeFlagsIndexedAccess) <> 0
        {
            let mark this.unported_mark()
            ; "Relate components directly before falling back to constraint
            ; relationships. A type S[K] is related to a type T[J] if S is related
            ; to T and K is related to J."
            if (src.flags & TypeFlagsIndexedAccess) <> 0
            {
                let so Checker.indexed_access_object_type_of(src)
                let to Checker.indexed_access_object_type_of(target)
                let si Checker.indexed_access_index_type_of(src)
                let ti Checker.indexed_access_index_type_of(target)
                if so <> null
                {
                    if to <> null
                    {
                        if si <> null
                        {
                            if ti <> null
                            {
                                if this.is_related_to_ex(so as ref[Type], to as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
                                {
                                    if this.is_related_to_ex(si as ref[Type], ti as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
                                        return true
                                }
                                if this.unported_mark() <> mark
                                    return false
                            }
                        }
                    }
                }
            }
            ; "A type S is related to a type T[K] if S is related to C, where C is
            ; the base constraint of T[K] for writing." ★The ASSIGNABLE and
            ; COMPARABLE relations only: a subtype question is not answered through
            ; a constraint. ★The error-chain arms upstream guards this with are the
            ; CHAIN's, which this port does not carry (see relate_variances).
            var through_constraint false
            if relation = RelationAssignable
                set through_constraint: true
            if relation = RelationComparable
                set through_constraint: true
            if through_constraint
            {
                let object_type Checker.indexed_access_object_type_of(target)
                let index_type Checker.indexed_access_index_type_of(target)
                if object_type <> null
                {
                    if index_type <> null
                    {
                        let ot object_type as ref[Type]
                        let it index_type as ref[Type]
                        let base_object this.get_base_constraint_or_type(ot)
                        let base_index this.get_base_constraint_or_type(it)
                        if this.unported_mark() <> mark
                            return false
                        if base_object <> null
                        {
                            if base_index <> null
                            {
                                let bo base_object as ref[Type]
                                let bi base_index as ref[Type]
                                if this.is_generic_object_type(bo) = false
                                {
                                    if this.is_generic_index_type(bi) = false
                                    {
                                        var access_flags AccessFlagsWriting
                                        if bo <> ot
                                            set access_flags: access_flags | AccessFlagsNoIndexSignatures
                                        let constraint this.get_indexed_access_type_or_undefined(bo, bi, access_flags, null, null)
                                        if this.unported_mark() <> mark
                                            return false
                                        if constraint <> null
                                        {
                                            if this.is_related_to_ex(src, constraint as ref[Type], relation, error_node, intersection_state, RecursionFlagsTarget)
                                                return true
                                            if this.unported_mark() <> mark
                                                return false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if (target.flags & TypeFlagsIndex) <> 0
        {
            let mark this.unported_mark()
            let target_type_in Checker.index_target_of(target)
            if target_type_in = null
                return false
            let target_type target_type_in as ref[Type]
            ; "A keyof S is related to a keyof T if T is related to S." ★The
            ; direction is reversed on purpose — `keyof` is contravariant in its
            ; operand.
            if (src.flags & TypeFlagsIndex) <> 0
            {
                let src_target Checker.index_target_of(src)
                if src_target <> null
                {
