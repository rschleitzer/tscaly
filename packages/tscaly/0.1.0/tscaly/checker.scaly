    ; ★★★ r.resolveIterationType — THE ONE FIELD THAT IS NOT A LOOKUP, and the whole
    ; difference between the two directions of this chapter. The sync resolver is
    ; `func(t, errorNode) { return t }`; the async one is getAwaitedTypeEx with
    ; TS1320 as its message. So an async iterator's YIELD and RETURN types are
    ; awaited and the type sent to `next` is NOT — getIterationTypesOfMethod's
    ; comment says exactly that at both slots (*the value of `next(value)` is *not*
    ; awaited by async generators* / *the value of `return(value)` *is* awaited*).
    procedure resolver_resolve_iteration_type(this, is_async: bool, t: ref[Type]?, error_node: ref[AstNode]?) returns ref[Type]?
    {
        if is_async = false
            return t
        if t = null
            return null
        this.get_awaited_type_ex(t as ref[Type], error_node, DiagType_of_await_operand_must_either_be_a_valid_promise_or_must_not_contain_a_callable_then_member)
    }

    ; r.mustHaveANextMethodDiagnostic / mustBeAMethodDiagnostic /
    ; mustHaveAValueDiagnostic — three codes, two directions.
    function resolver_must_have_a_next_method_code(is_async: bool) returns int
    {
        if is_async
            return DiagAn_async_iterator_must_have_a_next_method
        DiagAn_iterator_must_have_a_next_method
    }

    function resolver_must_be_a_method_code(is_async: bool) returns int
    {
        if is_async
            return DiagThe_0_property_of_an_async_iterator_must_be_a_method
        DiagThe_0_property_of_an_iterator_must_be_a_method
    }

    function resolver_must_have_a_value_code(is_async: bool) returns int
    {
        if is_async
            return DiagThe_type_returned_by_the_0_method_of_an_async_iterator_must_be_a_promise_for_a_type_with_a_value_property
        DiagThe_type_returned_by_the_0_method_of_an_iterator_must_have_a_value_property
    }

    ; ── IterationTypes: the sentinel, its test, and the three readers ────────

    function no_iteration_types() returns IterationTypes
        IterationTypes(null, null, null)

    function any_iteration_types(this) returns IterationTypes
        IterationTypes(any_type, any_type, any_type)

    ; IterationTypes.hasTypes().
    function iteration_types_has_types(it: IterationTypes) returns bool
    {
        if it.yield_type <> null
            return true
        if it.return_type <> null
            return true
        it.next_type <> null
    }

    ; IterationTypes.getType(kind). ★The reference PANICS on an unhandled kind and
    ; there are only three; the fall-through answers the yield slot rather than
    ; nothing, because a wrong-kind read here would be a caller bug and answering
    ; null would look like *not resolvable*, which is a value this chapter uses.
    function iteration_types_get(it: IterationTypes, kind: int) returns ref[Type]?
    {
        if kind = IterationTypeKindReturn
            return it.return_type
        if kind = IterationTypeKindNext
            return it.next_type
        it.yield_type
    }

    ; combineIterationTypes and getIterationTypeUnion, folded into one walk over
    ; the three slots — the reference writes the union helper three times over one
    ; list and the port's per-predicate convention would need three closures.
    ;
    ; ★★ MapNonNil, NOT Map: a constituent that could not resolve a given kind
    ; contributes NOTHING to that kind's union, and an empty list answers null —
    ; which is the sentinel again, per slot.
    procedure combine_iteration_types(this, rows: ref[Array[IterationTypes]]) returns IterationTypes
    {
        let mark this.unported_mark()
        let n rows.get_length() as int
        let ys &Array[ref[Type]?]^host()
        let rs &Array[ref[Type]?]^host()
        let ns &Array[ref[Type]?]^host()
        var i 0
        while i < n
        {
            let row rows[i]
            set i: i + 1
            if row.yield_type <> null
                ys.add(row.yield_type)
            if row.return_type <> null
                rs.add(row.return_type)
            if row.next_type <> null
                ns.add(row.next_type)
        }
        var y: ref[Type]? null
        var r: ref[Type]? null
        var x: ref[Type]? null
        if ys.get_length() > 0
            set y: this.get_union_type(ys)
        if rs.get_length() > 0
            set r: this.get_union_type(rs)
        if ns.get_length() > 0
            set x: this.get_union_type(ns)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        IterationTypes(y, r, x)
    }

    ; r.getResolvedIterationTypes(yield, return, next) — the fast paths' packer.
    ; ★The NEXT type is NOT resolved: see resolver_resolve_iteration_type.
    ; ★`core.OrElse(resolve(t), t)` and not `resolve(t)`: an async resolver that
    ; cannot await the type answers nil, and the reference keeps the unawaited type
    ; rather than losing the slot.
    procedure resolver_get_resolved_iteration_types(this, is_async: bool, yield_type: ref[Type]?, return_type: ref[Type]?, next_type: ref[Type]?) returns IterationTypes
    {
        let mark this.unported_mark()
        var y this.resolver_resolve_iteration_type(is_async, yield_type, null)
        var r this.resolver_resolve_iteration_type(is_async, return_type, null)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if y = null
            set y: yield_type
        if r = null
            set r: return_type
        IterationTypes(y, r, next_type)
    }

    ; isReferenceToType and isReferenceToSomeType.
    function is_reference_to_type(t: ref[Type]?, target: ref[Type]?) returns bool
    {
        if t = null
            return false
        if target = null
            return false
        let s t as ref[Type]
        if (s.object_flags & ObjectFlagsReference) = 0
            return false
        Checker.target_of(s) = target
    }

    function is_reference_to_some_type(t: ref[Type]?, targets: ref[Array[ref[Type]?]]?) returns bool
    {
        if t = null
            return false
        if targets = null
            return false
        let s t as ref[Type]
        if (s.object_flags & ObjectFlagsReference) = 0
            return false
        let tgt Checker.target_of(s)
        if tgt = null
            return false
        let list targets as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if row = tgt
                return true
        }
        false
    }

    ; ★getBuiltinIteratorReturnType is ALREADY HERE, as `builtin_iterator_return_type`
    ; beside get_declared_type_of_type_alias — slice 113 wrote it for the option's
    ; sake with no caller. This chapter is its first reader, and a second copy under
    ; the reference's own name is exactly §3.5dw's shape, so there is none.

    ; ── c.iterationTypesCache ────────────────────────────────────────────────
    ;
    ; ★NOT a mint-on-miss reader (flow_type_cache_lookup's reason): an absent row
    ; and a row holding the sentinel are different facts here, and only the absent
    ; one means *not computed*. The two are returned through an out-parameter pair.
    ; two addresses and a small int as one chain key
    function key3_hash(a: int, b: int, c: int) returns int
    {
        var h: u64 14695981039346656037
        set h: h xor (a as u64)
        set h: h * 1099511628211
        set h: h xor (b as u64)
        set h: h * 1099511628211
        set h: h xor (c as u64)
        set h: h * 1099511628211
        ((h >> 1) as int)
    }

    procedure iteration_types_cache_lookup(this, t: ref[Type], iteration_use: int, out_hit: ref[bool]) returns IterationTypes
    {
        let key iteration_use & IterationUseCacheFlags
        let len iteration_types_cache.get_length() as int
        let chain iteration_types_cache_chain
        while chain.count() < len
        {
            let pending iteration_types_cache[chain.count() as size_t]
            if pending = null
                chain.add_blank()
            else
                chain.add((pending as ref[IterationTypesLink]).source as int)
        }
        var i chain.first(t as int)
        while i >= 0
        {
            let row iteration_types_cache[i as size_t]
            set i: chain.after(i)
            if row = null
                continue
            let r row as ref[IterationTypesLink]
            if r.source = t
            {
                if r.iteration_use = key
                {
                    set out_hit: true
                    return r.result
                }
            }
        }
        set out_hit: false
        Checker.no_iteration_types()
    }

    procedure iteration_types_cache_put(this, t: ref[Type], iteration_use: int, result: IterationTypes)
        iteration_types_cache.add(&IterationTypesLink^host(t, iteration_use & IterationUseCacheFlags, result))

    ; ── c.cachedTypes[CachedTypeKindAwaitedType] and [...PromisedTypeOfPromise] ─

    procedure awaited_type_link_of(this, t: ref[Type]) returns ref[AwaitedTypeLink]
    {
        let ix awaited_type_links_index
        let at ix.find(t as int)
        if at > 0
        {
            let row awaited_type_links[at - 1]
            if row <> null
                return row as ref[AwaitedTypeLink]
        }
        let fresh &AwaitedTypeLink^host(t)
        awaited_type_links.add(fresh)
        ix.insert(t as int, (awaited_type_links.get_length() as int) - 1)
        fresh
    }

    procedure promised_type_link_of(this, t: ref[Type]) returns ref[PromisedTypeLink]
    {
        let ix promised_type_links_index
        let at ix.find(t as int)
        if at > 0
        {
            let row promised_type_links[at - 1]
            if row <> null
                return row as ref[PromisedTypeLink]
        }
        let fresh &PromisedTypeLink^host(t)
        promised_type_links.add(fresh)
        ix.insert(t as int, (promised_type_links.get_length() as int) - 1)
        fresh
    }

    ; c.awaitedTypeStack — `slices.Contains`, push and pop, over the array-plus-depth
    ; idiom the relation's own stacks use. ★The scan stops at the DEPTH: the array
    ; keeps popped entries and finding one would be a false cycle.
    function awaited_type_stack_contains(this, t: ref[Type]) returns bool
    {
        var i 0
        while i < awaited_type_depth
        {
            let row awaited_type_stack[i]
            set i: i + 1
            if row = t
                return true
        }
        false
    }

    procedure awaited_type_stack_push(this, t: ref[Type])
    {
        if awaited_type_depth < (awaited_type_stack.get_length() as int)
            awaited_type_stack.put(awaited_type_depth as size_t, t)
        if awaited_type_depth >= (awaited_type_stack.get_length() as int)
            awaited_type_stack.add(t)
        set awaited_type_depth: awaited_type_depth + 1
    }

    procedure awaited_type_stack_pop(this)
    {
        if awaited_type_depth > 0
            set awaited_type_depth: awaited_type_depth - 1
    }

    ; ── getIterationTypesOfIterable and its four workers ─────────────────────
    ;
    ; ★★★ THE `diagnosticOutput` PARAMETER IS A DIAGNOSTICS MARK HERE, and that is
    ; a mapping decision rather than an omission (§3.24). Upstream the slow paths
    ; take `diagnosticOutput *[]*ast.Diagnostic` and their caller does one of two
    ; things with what comes back: FLUSH it (`c.addDiagnostic(d)`) when the branch
    ; it came from succeeded, or hang it on the not-iterable error as RELATED INFO
    ; when everything failed. This port's diagnostics carry no related information
    ; — `error_on_node` writes (pos, end, code) and the yardstick compares exactly
    ; those three — so the second reading is a DROP. Both readings are therefore
    ; `diagnostics.length()` before the attempt plus `diagnostics.truncate(mark)`
    ; when it fails, which is the list's own rewind (§3.5i) and needs no buffer.
    ;
    ; ★★ AND THE DEFERRAL IS UNOBSERVABLE HERE, WHICH IS WHY THE TWO
    ; addDeferredDiagnostic CALLS REPORT AT ONCE. The reference defers
    ; reportTypeNotIterableError *"because TypeToString may attempt to resolve
    ; symbols that are already being resolved, possibly causing circularities"* —
    ; a hazard of the MESSAGE, which this port does not render. Diagnostics are
    ; sorted by (pos, end, code) before either side prints them
    ; (DiagnosticList.sort_by_position), so the emission order cannot show, and
    ; produce_deferred_diagnostics stays the empty drain its own comment describes.

    ; getIterationTypesOfIterable, with the cache and the noCache rule.
    ;
    ; ★★★ THE `noCache` RULE IS THE SUBTLE ONE AND IT IS ABOUT REPORTING TWICE. A
    ; cached SENTINEL means *this type is not iterable*, and the first ask that
    ; produced it may have had no error node. When a later ask DOES have one, the
    ; cached miss is ignored so the diagnostic gets produced — and then the fresh
    ; result must NOT be written back, or a third ask would find a row that has
    ; already reported.
    procedure get_iteration_types_of_iterable(this, t_in: ref[Type], iteration_use: int, error_node: ref[AstNode]?) returns IterationTypes
    {
        let mark this.unported_mark()
        let reduced this.get_reduced_type(t_in)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if reduced = null
            return Checker.no_iteration_types()
        let t reduced as ref[Type]
        if Checker.is_type_any(t)
            return this.any_iteration_types()
        var hit false
        let cached this.iteration_types_cache_lookup(t, iteration_use, &hit)
        var no_cache false
        if hit
        {
            if error_node = null
                return cached
            if Checker.iteration_types_has_types(cached)
                return cached
            set no_cache: true
        }
        let result this.get_iteration_types_of_iterable_worker(t, iteration_use, error_node, no_cache)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if no_cache = false
            this.iteration_types_cache_put(t, iteration_use, result)
        result
    }

    ; getIterationTypesOfIterableWorker, whole.
    ;
    ; ★★★ THE ORDER OF THE TWO HALVES IS THE for-await-of RULE and it is not
    ; symmetric. An `AllowsAsyncIterables` use looks for `[Symbol.asyncIterator]`
    ; FIRST; if that misses it falls through to the sync half, and what comes back
    ; from there is passed through getAsyncFromSyncIterationTypes — i.e. awaited.
    ; A use that allows only sync iterables never asks the async half at all. So
    ; `for await (const x of syncIterable)` works and `for (const x of
    ; asyncIterable)` does not, which is the whole observable content of this
    ; function.
    ;
    ; ★★ THE `ForOfFlag` TEST INSIDE THE ASYNC-FAST ARM IS NOT A TYPO. A for-await-of
    ; over a real async iterable ALSO awaits, because the reference's async fast
    ; path grabs the type arguments of `AsyncIterable<T, ...>` raw — the T is
    ; already the awaited element for a `yield*`, but a for-await-of sends
    ; `undefined` and awaits what it receives. The sync half's mirror test is the
    ; plain `AllowsAsyncIterablesFlag`.
    procedure get_iteration_types_of_iterable_worker(this, t: ref[Type], iteration_use: int, error_node: ref[AstNode]?, no_cache: bool) returns IterationTypes
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            let rows &Array[IterationTypes]^host()
            if types <> null
            {
                let list types as ref[Array[ref[Type]?]]
                let n list.get_length() as int
                var i 0
                while i < n
                {
                    let row list[i]
                    set i: i + 1
                    if row = null
                        continue
                    let one this.get_iteration_types_of_iterable_worker(row as ref[Type], iteration_use, null, no_cache)
                    if this.unported_mark() <> mark
                        return Checker.no_iteration_types()
                    if Checker.iteration_types_has_types(one) = false
                    {
                        this.add_deferred_check(DeferredCheckKindNotIterable, error_node, t, (iteration_use & IterationUseAllowsAsyncIterablesFlag) <> 0)
                        return Checker.no_iteration_types()
                    }
                    rows.add(one)
                }
            }
            return this.combine_iteration_types(rows)
        }
        let diag_mark diagnostics.length()
        if (iteration_use & IterationUseAllowsAsyncIterablesFlag) <> 0
        {
            let fast this.get_iteration_types_of_iterable_fast(t, true)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if Checker.iteration_types_has_types(fast)
            {
                if (iteration_use & IterationUseForOfFlag) <> 0
                    return this.get_async_from_sync_iteration_types(fast, error_node)
                return fast
            }
            let slow this.get_iteration_types_of_iterable_slow(t, true, error_node)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if Checker.iteration_types_has_types(slow)
                return slow
        }
        if (iteration_use & IterationUseAllowsSyncIterablesFlag) <> 0
        {
            let fast this.get_iteration_types_of_iterable_fast(t, false)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if Checker.iteration_types_has_types(fast)
            {
                if (iteration_use & IterationUseAllowsAsyncIterablesFlag) <> 0
                    return this.get_async_from_sync_iteration_types(fast, error_node)
                return fast
            }
            let slow this.get_iteration_types_of_iterable_slow(t, false, error_node)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if Checker.iteration_types_has_types(slow)
            {
                if (iteration_use & IterationUseAllowsAsyncIterablesFlag) <> 0
                    return this.get_async_from_sync_iteration_types(slow, error_node)
                return slow
            }
        }
        ; Both halves missed: the buffered reports become RELATED INFO upstream and
        ; are dropped here (see the chapter header), so the list rewinds to the mark
        ; before the one diagnostic that is compared.
        diagnostics.truncate(diag_mark)
        this.add_deferred_check(DeferredCheckKindNotIterable, error_node, t, (iteration_use & IterationUseAllowsAsyncIterablesFlag) <> 0)
        Checker.no_iteration_types()
    }

    ; getIterationTypesOfIterableFast — the four three-parameter globals and the
    ; five one-parameter builtins. ★It is the arm that makes `for (const x of
    ; [1,2,3])` cost one identity test instead of a member resolution: an array
    ; type IS a reference to the global `Array`, whose `[Symbol.iterator]` is an
    ; `ArrayIterator<T>`, and the builtin list catches exactly that.
    procedure get_iteration_types_of_iterable_fast(this, t: ref[Type], is_async: bool) returns IterationTypes
    {
        let mark this.unported_mark()
        let gi this.resolver_get_global_iterable_type(is_async)
        let go this.resolver_get_global_iterator_object_type(is_async)
        let gii this.resolver_get_global_iterable_iterator_type(is_async)
        let gg this.resolver_get_global_generator_type(is_async)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        var known false
        if Checker.is_reference_to_type(t, gi)
            set known: true
        if Checker.is_reference_to_type(t, go)
            set known: true
        if Checker.is_reference_to_type(t, gii)
            set known: true
        if Checker.is_reference_to_type(t, gg)
            set known: true
        if known
        {
            let args this.get_type_arguments(t)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if args = null
                return Checker.no_iteration_types()
            let list args as ref[Array[ref[Type]?]]
            if (list.get_length() as int) < 3
                return Checker.no_iteration_types()
            return this.resolver_get_resolved_iteration_types(is_async, list[0], list[1], list[2])
        }
        let builtins this.resolver_get_global_builtin_iterator_types(is_async)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if Checker.is_reference_to_some_type(t, builtins)
        {
            let args this.get_type_arguments(t)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if args = null
                return Checker.no_iteration_types()
            let list args as ref[Array[ref[Type]?]]
            if (list.get_length() as int) < 1
                return Checker.no_iteration_types()
            let br this.builtin_iterator_return_type()
            return this.resolver_get_resolved_iteration_types(is_async, list[0], br, unknown_type)
        }
        Checker.no_iteration_types()
    }

    ; getIterationTypesOfIterableSlow — the member route: look up
    ; `[Symbol.iterator]`, take the call signatures that need no argument, and ask
    ; the ITERATOR half about the intersection of their return types.
    ;
    ; ★★ `method.Flags & Optional == 0` — an OPTIONAL `[Symbol.iterator]` is not an
    ; iterable at all, and the test is on the SYMBOL, not on the type.
    ; ★★ `getMinArgumentCount(sig) == 0` — a `[Symbol.iterator](x)` that demands an
    ; argument cannot be called by a for-of, and the fall-through reports the
    ; ASSIGNABILITY error against `Iterable` rather than a bespoke message, which is
    ; the reference's own choice at that line.
    procedure get_iteration_types_of_iterable_slow(this, t: ref[Type], is_async: bool, error_node: ref[AstNode]?) returns IterationTypes
    {
        let mark this.unported_mark()
        let sym_name Checker.resolver_iterator_symbol_name(is_async)
        var nb char[JSNUM_MAX_TEXT]
        let nd this.get_property_name_for_known_symbol_name(sym_name, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        let method this.get_property_of_type(t, nd)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if method = null
            return Checker.no_iteration_types()
        let m method as ref[Symbol]
        if (Symbol.flags_of(m) & SymbolFlagsOptional) <> 0
            return Checker.no_iteration_types()
        let method_type this.get_type_of_symbol(m)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if method_type = null
            return Checker.no_iteration_types()
        let mt method_type as ref[Type]
        if Checker.is_type_any(mt)
            return this.any_iteration_types()
        let all this.get_signatures_of_type(mt, SignatureKindCall)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        let valid &Array[ref[Signature]?]()
        var all_count 0
        if all <> null
        {
            let list all as ref[Array[ref[Signature]?]]
            let n list.get_length() as int
            set all_count: n
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let sig row as ref[Signature]
                if this.get_min_argument_count(sig) = 0
                    valid.add(sig)
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
            }
        }
        if valid.get_length() > 0
        {
            ; ★`returns` is a reserved word — §3.19's list — so the accumulator is
            ; `sig_returns`; the parse error it causes reads `expected Binding` and
            ; names neither the word nor the line's own fault.
            let sig_returns &Array[ref[Type]?]^host()
            let vn valid.get_length() as int
            var i 0
            while i < vn
            {
                let row valid[i]
                set i: i + 1
                if row = null
                    continue
                let rt this.get_return_type_of_signature(row as ref[Signature])
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
                sig_returns.add(rt)
            }
            let iterator_type this.get_intersection_type(sig_returns)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if iterator_type = null
                return Checker.no_iteration_types()
            return this.get_iteration_types_of_iterator_worker(iterator_type as ref[Type], is_async, error_node)
        }
        if error_node <> null
        {
            if all_count <> 0
            {
                if is_async
                    this.report_checked_global_type("AsyncIterable", 3)
                else
                    this.report_checked_global_type("Iterable", 3)
                let target this.resolver_get_global_iterable_type(is_async)
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
                if target <> null
                    this.check_type_assignable_to(t, target as ref[Type], error_node, 0)
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
            }
        }
        Checker.no_iteration_types()
    }

    ; getIterationTypesOfIterator and getIterationTypesOfIteratorWorker — the
    ; reference keeps the pair for its NOTE (*you probably don't want to call this
    ; directly*) and both bodies are one line; the entry is the name the two
    ; outside callers use.
    procedure get_iteration_types_of_iterator(this, t: ref[Type], is_async: bool, error_node: ref[AstNode]?) returns IterationTypes
        this.get_iteration_types_of_iterator_worker(t, is_async, error_node)

    procedure get_iteration_types_of_iterator_worker(this, t: ref[Type], is_async: bool, error_node: ref[AstNode]?) returns IterationTypes
    {
        if Checker.is_type_any(t)
            return this.any_iteration_types()
        let mark this.unported_mark()
        let fast this.get_iteration_types_of_iterator_fast(t, is_async)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if Checker.iteration_types_has_types(fast)
            return fast
        this.get_iteration_types_of_iterator_slow(t, is_async, error_node)
    }

    ; getIterationTypesOfIteratorFast. ★It differs from the ITERABLE fast path in
    ; exactly one global — `Iterator` where that one asks `Iterable` — and the
    ; other three plus the builtin list are the same. The reference writes the two
    ; bodies out separately and so does this port: folding them would need a
    ; which-global parameter whose two values are the two functions.
    procedure get_iteration_types_of_iterator_fast(this, t: ref[Type], is_async: bool) returns IterationTypes
    {
        let mark this.unported_mark()
        let gi this.resolver_get_global_iterator_type(is_async)
        let go this.resolver_get_global_iterator_object_type(is_async)
        let gii this.resolver_get_global_iterable_iterator_type(is_async)
        let gg this.resolver_get_global_generator_type(is_async)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        var known false
        if Checker.is_reference_to_type(t, gi)
            set known: true
        if Checker.is_reference_to_type(t, go)
            set known: true
        if Checker.is_reference_to_type(t, gii)
            set known: true
        if Checker.is_reference_to_type(t, gg)
            set known: true
        if known
        {
            let args this.get_type_arguments(t)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if args = null
                return Checker.no_iteration_types()
            let list args as ref[Array[ref[Type]?]]
            if (list.get_length() as int) < 3
                return Checker.no_iteration_types()
            return this.resolver_get_resolved_iteration_types(is_async, list[0], list[1], list[2])
        }
        let builtins this.resolver_get_global_builtin_iterator_types(is_async)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if Checker.is_reference_to_some_type(t, builtins)
        {
            let args this.get_type_arguments(t)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if args = null
                return Checker.no_iteration_types()
            let list args as ref[Array[ref[Type]?]]
            if (list.get_length() as int) < 1
                return Checker.no_iteration_types()
            let br this.builtin_iterator_return_type()
            return this.resolver_get_resolved_iteration_types(is_async, list[0], br, unknown_type)
        }
        Checker.no_iteration_types()
    }

    ; getIterationTypesOfIteratorSlow — `next`, `return` and `throw`, combined.
    procedure get_iteration_types_of_iterator_slow(this, t: ref[Type], is_async: bool, error_node: ref[AstNode]?) returns IterationTypes
    {
        let mark this.unported_mark()
        let rows &Array[IterationTypes]^host()
        let a this.get_iteration_types_of_method(t, is_async, "next", error_node)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        rows.add(a)
        let b this.get_iteration_types_of_method(t, is_async, "return", error_node)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        rows.add(b)
        let c2 this.get_iteration_types_of_method(t, is_async, "throw", error_node)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        rows.add(c2)
        this.combine_iteration_types(rows)
    }

    ; ── getIterationTypesOfMethod — the largest function of the chapter ──────
    ;
    ; What `next`, `return` or `throw` contributes to the three iteration types.
    ; The reference's 102 lines in one piece, because every early exit answers a
    ; different sentinel and splitting them would need the same forks twice.
    ;
    ; ★★★ THE THREE METHODS ARE NOT SYMMETRIC AND THE ASYMMETRIES ARE THE FUNCTION.
    ; `next` is MANDATORY (a missing one is TS2489/TS2519) while a missing `return`
    ; or `throw` contributes nothing; an OPTIONAL `next` counts as absent while an
    ; optional `return` is read through TypeFactsNEUndefinedOrNull; `throw` takes no
    ; parameter into account at all; `next`'s first parameter is the NEXT type
    ; unawaited and `return`'s is a RETURN type that IS awaited.
    ;
    ; ★★★ AND THE GLOBAL-METHOD FAST PATH IS THE ONE ARM WHOSE ABSENCE IS A WRONG
    ; ANSWER RATHER THAN A MISSING ONE. When a type's `next` member derives
    ; exclusively from the global `Iterator`/`Generator` — the reference's own
    ; example is `interface SpecialIterator extends Iterator<number> {}`, which is
    ; NOT a reference to `Iterator` — the iteration types are read off the member's
    ; MAPPER instead of off its signature, and that is what removes the `undefined`
    ; the declared `next(...args: [] | [TNext]): IteratorResult<T, TReturn>` would
    ; otherwise put into the next and return types.
    procedure get_iteration_types_of_method(this, t: ref[Type], is_async: bool, name: Slice[char], error_node: ref[AstNode]?) returns IterationTypes
    {
        let mark this.unported_mark()
        let is_next Checker.name_is(name, "next")
        let is_return Checker.name_is(name, "return")
        let is_throw Checker.name_is(name, "throw")
        let method this.get_property_of_type(t, name)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        ; "Ignore 'return' or 'throw' if they are missing."
        if method = null
        {
            if is_next = false
                return Checker.no_iteration_types()
        }
        var method_type: ref[Type]? null
        if method <> null
        {
            let m method as ref[Symbol]
            var skip false
            if is_next
            {
                if (Symbol.flags_of(m) & SymbolFlagsOptional) <> 0
                    set skip: true
            }
            if skip = false
            {
                let raw this.get_type_of_symbol(m)
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
                if raw <> null
                {
                    if is_next
                        set method_type: raw
                    else
                    {
                        set method_type: this.get_type_with_facts(raw as ref[Type], TypeFactsNEUndefinedOrNull)
                        if this.unported_mark() <> mark
                            return Checker.no_iteration_types()
                    }
                }
            }
        }
        if Checker.is_type_any(method_type)
            return this.any_iteration_types()
        ; "Both async and non-async iterators *must* have a `next` method."
        var sig_count 0
        var sigs: ref[Array[ref[Signature]?]]? null
        if method_type <> null
        {
            set sigs: this.get_signatures_of_type(method_type as ref[Type], SignatureKindCall)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if sigs <> null
                set sig_count: (sigs as ref[Array[ref[Signature]?]]).get_length() as int
        }
        if sig_count = 0
        {
            if error_node <> null
            {
                var code Checker.resolver_must_be_a_method_code(is_async)
                if is_next
                    set code: Checker.resolver_must_have_a_next_method_code(is_async)
                this.error_on_node(error_node, code, Checker.arg_text(name))
            }
            return Checker.no_iteration_types()
        }
        let list sigs as ref[Array[ref[Signature]?]]
        ; The global-method fast path — see the header.
        if sig_count = 1
        {
            let mt method_type as ref[Type]
            if mt.symbol <> null
            {
                let gg this.resolver_get_global_generator_type(is_async)
                let gi this.resolver_get_global_iterator_type(is_async)
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
                ; `globalGeneratorType.symbol.Members[methodName] == methodType.symbol`,
                ; and its Iterator twin behind an `!isGeneratorMethod` guard — the
                ; generator wins where both would match, which is the reference's own
                ; order.
                var owner: ref[Type]? null
                if this.global_type_declares_member(gg, name, mt.symbol)
                    set owner: gg
                if owner = null
                {
                    if this.global_type_declares_member(gi, name, mt.symbol)
                        set owner: gi
                }
                if owner <> null
                {
                    let all Checker.all_type_parameters_of(owner as ref[Type])
                    let m2 Checker.mapper_of(mt)
                    if all <> null
                    {
                        let tps all as ref[Array[ref[Type]?]]
                        ; TypeParameters() is allTypeParameters minus the trailing
                        ; thisType, and the reference indexes 0, 1 and 2 of it.
                        if (tps.get_length() as int) >= 4
                        {
                            let p0 tps[0]
                            let p1 tps[1]
                            let p2 tps[2]
                            var y: ref[Type]? null
                            var r: ref[Type]? null
                            var x: ref[Type]? null
                            if p0 <> null
                                set y: this.instantiate_type(p0 as ref[Type], m2)
                            if p1 <> null
                                set r: this.instantiate_type(p1 as ref[Type], m2)
                            if is_next
                            {
                                if p2 <> null
                                    set x: this.instantiate_type(p2 as ref[Type], m2)
                            }
                            if this.unported_mark() <> mark
                                return Checker.no_iteration_types()
                            return IterationTypes(y, r, x)
                        }
                    }
                }
            }
        }
        ; "Extract the first parameter and return type of each signature."
        let param_types &Array[ref[Type]?]^host()
        let return_types &Array[ref[Type]?]^host()
        var i 0
        while i < sig_count
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let sig row as ref[Signature]
            if is_throw = false
            {
                if Checker.signature_has_parameters(sig)
                {  ; `len(signature.parameters) != 0`
                    let pt this.get_type_at_position(sig, 0)
                    if this.unported_mark() <> mark
                        return Checker.no_iteration_types()
                    param_types.add(pt)
                }
            }
            let rt this.get_return_type_of_signature(sig)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            return_types.add(rt)
        }
        ; "Resolve the *next* or *return* type from the first parameter of a
        ; `next()` or `return()` method, respectively."
        let returns_out &Array[ref[Type]?]^host()
        var next_type: ref[Type]? null
        if is_throw = false
        {
            var method_parameter_type: ref[Type]? unknown_type
            if param_types.get_length() > 0
            {
                set method_parameter_type: this.get_union_type(param_types)
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
            }
            if is_next
                set next_type: method_parameter_type
            if is_return
            {
                var resolved this.resolver_resolve_iteration_type(is_async, method_parameter_type, error_node)
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
                if resolved = null
                    set resolved: any_type
                returns_out.add(resolved)
            }
        }
        ; "Resolve the *yield* and *return* types from the return type of the
        ; method (i.e. `IteratorResult`)"
        var method_return_type: ref[Type]? never_type
        if return_types.get_length() > 0
        {
            set method_return_type: this.get_intersection_type(return_types)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
        }
        var resolved_method_return_type this.resolver_resolve_iteration_type(is_async, method_return_type, error_node)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if resolved_method_return_type = null
            set resolved_method_return_type: any_type
        var yield_type: ref[Type]? null
        let result_types this.get_iteration_types_of_iterator_result(resolved_method_return_type as ref[Type])
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if Checker.iteration_types_has_types(result_types) = false
        {
            if error_node <> null
                this.error_on_node(error_node, Checker.resolver_must_have_a_value_code(is_async), Checker.arg_text(name))
            set yield_type: any_type
            returns_out.add(any_type)
        }
        else
        {
            set yield_type: result_types.yield_type
            returns_out.add(result_types.return_type)
        }
        var combined_return: ref[Type]? null
        if returns_out.get_length() > 0
        {
            set combined_return: this.get_union_type(returns_out)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
        }
        IterationTypes(yield_type, combined_return, next_type)
    }

    ; getIterationTypesOfIteratorResult — what an `IteratorResult`-like type says
    ; about the yield and the return.
    ;
    ; ★★★ THE `done` PROPERTY IS READ AS A TYPE AND NOT AS A VALUE, which is what
    ; makes a union of `IteratorYieldResult | IteratorReturnResult` split correctly:
    ; a constituent whose `done` accepts `false` contributes the YIELD type, one
    ; whose `done` accepts `true` contributes the RETURN type, and a plain
    ; `boolean` does both. ★A MISSING `done` counts as `false` — the ECMAScript
    ; rule the reference quotes — so `{ value: 1 }` is a yield result.
    ;
    ; ★★ THE `voidType` FALLBACK ON THE RETURN SLOT IS THE SPEC'S OWN and it is why
    ; a generator with no `return` statement answers `void` and not `undefined`.
    procedure get_iteration_types_of_iterator_result(this, t: ref[Type]) returns IterationTypes
    {
        if Checker.is_type_any(t)
            return this.any_iteration_types()
        let mark this.unported_mark()
        let gy this.get_global_iterator_yield_result_type()
        let gr this.get_global_iterator_return_result_type()
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if Checker.is_reference_to_type(t, gy)
        {
            let args this.get_type_arguments(t)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if args <> null
            {
                let list args as ref[Array[ref[Type]?]]
                if (list.get_length() as int) >= 1
                    return IterationTypes(list[0], null, null)
            }
            return Checker.no_iteration_types()
        }
        if Checker.is_reference_to_type(t, gr)
        {
            let args this.get_type_arguments(t)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
            if args <> null
            {
                let list args as ref[Array[ref[Type]?]]
                if (list.get_length() as int) >= 1
                    return IterationTypes(null, list[0], null)
            }
            return Checker.no_iteration_types()
        }
        let yield_result this.filter_type_is_iterator_result(t, IterationTypeKindYield)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        var yield_type: ref[Type]? null
        if yield_result <> null
        {
            if (yield_result as ref[Type]) <> never_type
            {
                set yield_type: this.get_type_of_property_of_type(yield_result as ref[Type], "value")
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
            }
        }
        let return_result this.filter_type_is_iterator_result(t, IterationTypeKindReturn)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        var return_type: ref[Type]? null
        if return_result <> null
        {
            if (return_result as ref[Type]) <> never_type
            {
                set return_type: this.get_type_of_property_of_type(return_result as ref[Type], "value")
                if this.unported_mark() <> mark
                    return Checker.no_iteration_types()
            }
        }
        if yield_type = null
        {
            if return_type = null
                return Checker.no_iteration_types()
        }
        var r return_type
        if r = null
            set r: void_type
        IterationTypes(yield_type, r, null)
    }

    ; filterType(t, c.isYieldIteratorResult) / (…, c.isReturnIteratorResult) —
    ; ONE per-predicate filter with the kind as its parameter, because the two
    ; predicates are isIteratorResult's two arguments and nothing else differs.
    procedure filter_type_is_iterator_result(this, t: ref[Type], kind: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            let keep this.is_iterator_result(t, kind)
            if this.unported_mark() <> mark
                return null
            if keep
                return t
            return never_type
        }
        let types Checker.union_types_of(t)
        if types = null
            return never_type
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let kept &Array[ref[Type]?]^host()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let keep this.is_iterator_result(row as ref[Type], kind)
            if this.unported_mark() <> mark
                return null
            if keep
                kept.add(row)
            else
                set changed: true
        }
        if changed = false
            return t
        if kept.get_length() = 0
            return never_type
        this.get_union_type(kept)
    }

    ; isIteratorResult. ★The two callers differ only in which literal is tested for
    ; ASSIGNABILITY to `done`, and the direction is (literal -> done): a `done:
    ; boolean` accepts both, a `done: false` accepts only the yield question.
    procedure is_iterator_result(this, t: ref[Type], kind: int) returns bool
    {
        let mark this.unported_mark()
        var done_type this.get_type_of_property_of_type(t, "done")
        if this.unported_mark() <> mark
            return false
        if done_type = null
            set done_type: false_type
        ; ★`false_type` and `true_type` are NON-OPTIONAL `ref[Type]` fields, so a
        ; `probe = null` test here would be a hard rc-4 and is not written; the
        ; binding is typed so the assignability call needs no unwrap either.
        var probe: ref[Type] false_type
        if kind <> IterationTypeKindYield
            set probe: true_type
        this.is_type_assignable_to(probe, done_type as ref[Type])
    }

    ; ── the two reports ──────────────────────────────────────────────────────

    ; errorAndMaybeSuggestAwait. ★The `maybeMissingAwait` half is RELATED INFO
    ; upstream (TS2773, *Did you forget to use await?*), which this port's
    ; diagnostics do not carry and the yardstick does not compare — so the
    ; parameter is taken, named and not read, because dropping it would make the
    ; two callers look as though they had asked a simpler question.
    procedure error_and_maybe_suggest_await(this, location: ref[AstNode]?, maybe_missing_await: bool, code: int)
    {
        let await_mark this.diagnostic_mark()
        this.error_on_node(location, code)
        if maybe_missing_await
            this.related_info_since(await_mark, location, DiagDid_you_forget_to_use_await)
    }

    procedure error_and_maybe_suggest_await(this, location: ref[AstNode]?, maybe_missing_await: bool, code: int, a0: String)
    {
        let await_mark this.diagnostic_mark()
        this.error_on_node(location, code, a0)
        if maybe_missing_await
            this.related_info_since(await_mark, location, DiagDid_you_forget_to_use_await)
    }

    ; reportTypeNotIterableError, whole.
    ;
    ; ★★ THE `suggestAwait` DISJUNCTION IS ALL ABOUT THE RELATED INFO and therefore
    ; costs nothing here — but its second term calls isTypeAssignableTo against
    ; `AsyncIterable<any, any, any>`, which can REPORT nothing and can still stop.
    ; It is written for the shape and its answer is unread, so the whole term is
    ; left out rather than run for no effect: a relation asked for a suggestion this
    ; port cannot render is work with no observable.
    procedure report_type_not_iterable_error(this, error_node: ref[AstNode]?, t: ref[Type], allow_async_iterables: bool)
    {
        if error_node = null
            return
        var code DiagType_0_must_have_a_Symbol_iterator_method_that_returns_an_iterator
        if allow_async_iterables
            set code: DiagType_0_must_have_a_Symbol_asyncIterator_method_that_returns_an_async_iterator
        let type_name this.type_arg(t)
        this.error_and_maybe_suggest_await(error_node, false, code, type_name)
    }

    ; getIterationDiagnosticDetails. Two out-parameters rather than Go's pair: the
    ; CODE and the maybe-missing-await bit, the second of which only feeds the
    ; related info (see error_and_maybe_suggest_await).
    procedure get_iteration_diagnostic_details(this, iteration_use: int, input_type: ref[Type], allows_strings: bool, out_maybe_await: ref[bool]) returns int
    {
        let mark this.unported_mark()
        let yield_type this.get_iteration_type_of_iterable(iteration_use, IterationTypeKindYield, input_type, null)
        if this.unported_mark() <> mark
        {
            set out_maybe_await: false
            return 0
        }
        if yield_type <> null
        {
            set out_maybe_await: false
            return DiagType_0_can_only_be_iterated_through_when_using_the_downlevelIteration_flag_or_with_a_target_of_es2015_or_higher
        }
        set out_maybe_await: true
        if input_type.symbol <> null
        {
            let s input_type.symbol as ref[Symbol]
            if Checker.is_es2015_or_later_iterable(Symbol.name_of(s))
                return DiagType_0_can_only_be_iterated_through_when_using_the_downlevelIteration_flag_or_with_a_target_of_es2015_or_higher
        }
        if allows_strings
            return DiagType_0_is_not_an_array_type_or_a_string_type
        DiagType_0_is_not_an_array_type
    }

    ; isES2015OrLaterIterable — the ten lib names whose iteration needs ES2015.
    ; ★A `switch` on a STRING in the reference; ten name comparisons here, in the
    ; reference's own order so the list can be diffed against it.
    function is_es2015_or_later_iterable(d: Slice[char]) returns bool
    {
        if Checker.name_is(d, "Float32Array")
            return true
        if Checker.name_is(d, "Float64Array")
            return true
        if Checker.name_is(d, "Int16Array")
            return true
        if Checker.name_is(d, "Int32Array")
            return true
        if Checker.name_is(d, "Int8Array")
            return true
        if Checker.name_is(d, "NodeList")
            return true
        if Checker.name_is(d, "Uint16Array")
            return true
        if Checker.name_is(d, "Uint32Array")
            return true
        if Checker.name_is(d, "Uint8Array")
            return true
        Checker.name_is(d, "Uint8ClampedArray")
    }

    ; `globalX.symbol != nil && globalX.symbol.Members[name] == methodType.symbol`,
    ; the test both arms of the global-method fast path make.
    function global_type_declares_member(this, g: ref[Type]?, name: Slice[char], member: ref[Symbol]?) returns bool
    {
        if g = null
            return false
        if member = null
            return false
        let owner g as ref[Type]
        if owner.symbol = null
            return false
        let found SymbolTable.get(Symbol.members_of(owner.symbol as ref[Symbol]), name)
        if found = null
            return false
        found = member
    }

    ; `len(signature.parameters) != 0`.
    function signature_has_parameters(sig: ref[Signature]) returns bool
    {
        if sig.parameters = null
            return false
        (sig.parameters as ref[Array[ref[Symbol]?]]).get_length() > 0
    }

    ; ── getIteratedTypeOrElementType — the chapter's entry point ─────────────
    ;
    ; What a for-of, a spread, an array destructuring or a `yield*` gets out of its
    ; operand. ★★★ ITS TWO HALVES ARE TWO ERAS OF THE LANGUAGE and the order between
    ; them is the whole function: the ITERABLE protocol is tried first, and only a
    ; target with no `Iterable` in its lib falls through to the ARRAY-LIKE reading
    ; (`arrayType[number]`), which is what `--downlevelIteration` off means. The
    ; string half sits inside the array-like reading because a string is
    ; array-like-of-string and not iterable below ES2015.
    ;
    ; ★★ `iterableExists` IS AN IDENTITY TEST AGAINST empty_generic_type, the
    ; reference's own sentinel for *the lib does not declare it*, and it is passed
    ; as the ERROR NODE of the iterable attempt as well: with no `Iterable` in
    ; scope the iterable attempt must not report, because the array-like half below
    ; is the one that owes the diagnostic.
    procedure check_iterated_type_or_element_type(this, iteration_use: int, input_type: ref[Type], sent_type: ref[Type]?, error_node: ref[AstNode]?) returns ref[Type]?
    {
        if Checker.is_type_any(input_type)
            return input_type
        let mark this.unported_mark()
        let t this.get_iterated_type_or_element_type(iteration_use, input_type, sent_type, error_node, true)
        if this.unported_mark() <> mark
            return null
        if t <> null
            return t
        any_type
    }

    procedure get_iterated_type_or_element_type(this, iteration_use: int, input_type: ref[Type], sent_type: ref[Type]?, error_node: ref[AstNode]?, check_assignability: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let allow_async_iterables (iteration_use & IterationUseAllowsAsyncIterablesFlag) <> 0
        if input_type = never_type
        {
            this.report_type_not_iterable_error(error_node, input_type, allow_async_iterables)
            return null
        }
        let gi this.get_global_iterable_type()
        if this.unported_mark() <> mark
            return null
        var iterable_exists true
        if gi = null
            set iterable_exists: false
        else
        {
            if (gi as ref[Type]) = empty_generic_type
                set iterable_exists: false
        }
        var possible_out_of_bounds false
        if Checker.no_unchecked_indexed_access()
        {
            if (iteration_use & IterationUsePossiblyOutOfBounds) <> 0
                set possible_out_of_bounds: true
        }
        var iterable_or_async iterable_exists
        if allow_async_iterables
            set iterable_or_async: true
        if iterable_or_async
        {
            var iter_error_node: ref[AstNode]? null
            if iterable_exists
                set iter_error_node: error_node
            let iteration_types this.get_iteration_types_of_iterable(input_type, iteration_use, iter_error_node)
            if this.unported_mark() <> mark
                return null
            if check_assignability
            {
                if iteration_types.next_type <> null
                {
                    var code 0
                    if (iteration_use & IterationUseForOfFlag) <> 0
                        set code: DiagCannot_iterate_value_because_the_next_method_of_its_iterator_expects_type_1_but_for_of_will_always_send_0
                    if (iteration_use & IterationUseSpreadFlag) <> 0
                        set code: DiagCannot_iterate_value_because_the_next_method_of_its_iterator_expects_type_1_but_array_spread_will_always_send_0
                    if (iteration_use & IterationUseDestructuringFlag) <> 0
                        set code: DiagCannot_iterate_value_because_the_next_method_of_its_iterator_expects_type_1_but_array_destructuring_will_always_send_0
                    if (iteration_use & IterationUseYieldStarFlag) <> 0
                        set code: DiagCannot_delegate_iteration_to_value_because_the_next_method_of_its_iterator_expects_type_1_but_the_containing_generator_will_always_send_0
                    if code <> 0
                    {
                        if sent_type <> null
                        {
                            this.check_type_assignable_to(sent_type as ref[Type], iteration_types.next_type as ref[Type], error_node, code)
                            if this.unported_mark() <> mark
                                return null
                        }
                    }
                }
            }
            var answered false
            if iteration_types.yield_type <> null
                set answered: true
            if iterable_exists
                set answered: true
            if answered
            {
                if iteration_types.yield_type = null
                    return null
                if possible_out_of_bounds
                    return this.include_undefined_in_index_signature(iteration_types.yield_type)
                return iteration_types.yield_type
            }
        }
        ; ── the ARRAY-LIKE reading, with the string constituents peeled off ──
        var array_type: ref[Type] input_type
        var has_string_constituent false
        if (iteration_use & IterationUseAllowsStringInputFlag) <> 0
        {
            if (input_type.flags & TypeFlagsUnion) <> 0
            {
                ; "After we remove all types that are StringLike, we will know if
                ; there was a string constituent based on whether the result of
                ; filter is a new array."
                ;
                ; ★★★ IT IS NOT filter_type_outside_flags, ALTHOUGH THE PREDICATE IS
                ; THE SAME ONE. That function unions through
                ; get_union_type_from_sorted_list — no reduction — and the reference
                ; here asks for UnionReductionSubtype explicitly. Reusing it would
                ; answer `string[] | number[]` where upstream answers `number[]`
                ; for a subtype pair, silently, at the one call site that decides
                ; what a for-of over `T | string` iterates.
                let types Checker.union_types_of(input_type)
                if types <> null
                {
                    let list types as ref[Array[ref[Type]?]]
                    let n list.get_length() as int
                    let kept &Array[ref[Type]?]^host()
                    var i 0
                    while i < n
                    {
                        let row list[i]
                        set i: i + 1
                        if row = null
                            continue
                        if ((row as ref[Type]).flags & TypeFlagsStringLike) = 0
                            kept.add(row)
                    }
                    if (kept.get_length() as int) <> n
                    {
                        let u this.get_union_type_ex(kept, UnionReductionSubtype, null, null)
                        if this.unported_mark() <> mark
                            return null
                        if u <> null
                            set array_type: u as ref[Type]
                    }
                }
            }
            else
            {
                if (input_type.flags & TypeFlagsStringLike) <> 0
                    set array_type: never_type
            }
            if array_type <> input_type
                set has_string_constituent: true
            if has_string_constituent
            {
                ; "Now that we've removed all the StringLike types, if no
                ; constituents remain, then the entire arrayOrStringType was a
                ; string."
                if (array_type.flags & TypeFlagsNever) <> 0
                {
                    if possible_out_of_bounds
                        return this.include_undefined_in_index_signature(string_type)
                    return string_type
                }
            }
        }
        let array_like this.is_array_like_type(array_type)
        if this.unported_mark() <> mark
            return null
        if array_like = false
        {
            if error_node <> null
            {
                var allows_strings false
                if (iteration_use & IterationUseAllowsStringInputFlag) <> 0
                {
                    if has_string_constituent = false
                        set allows_strings: true
                }
                var maybe_await false
                let code this.get_iteration_diagnostic_details(iteration_use, input_type, allows_strings, &maybe_await)
                if this.unported_mark() <> mark
                    return null
                var suggest false
                if maybe_await
                {
                    let awaited this.get_awaited_type_of_promise(array_type)
                    if this.unported_mark() <> mark
                        return null
                    if awaited <> null
                        set suggest: true
                }
                let array_name this.type_arg(array_type)
                this.error_and_maybe_suggest_await(error_node, suggest, code, array_name)
            }
            if has_string_constituent
            {
                if possible_out_of_bounds
                    return this.include_undefined_in_index_signature(string_type)
                return string_type
            }
            return null
        }
        let array_element_type this.get_index_type_of_type(array_type, number_type)
        if this.unported_mark() <> mark
            return null
        if has_string_constituent
        {
            if array_element_type <> null
            {
                ; "This is just an optimization for the case where
                ; arrayOrStringType is string | string[]"
                if ((array_element_type as ref[Type]).flags & TypeFlagsStringLike) <> 0
                {
                    if Checker.no_unchecked_indexed_access() = false
                        return string_type
                }
                let parts &Array[ref[Type]?]^host()
                parts.add(array_element_type)
                parts.add(string_type)
                if possible_out_of_bounds
                    parts.add(undefined_type)
                return this.get_union_type_ex(parts, UnionReductionSubtype, null, null)
            }
        }
        if (iteration_use & IterationUsePossiblyOutOfBounds) <> 0
            return this.include_undefined_in_index_signature(array_element_type)
        array_element_type
    }

    ; getIterationTypeOfIterable — the one-slot reader over the whole resolution.
    procedure get_iteration_type_of_iterable(this, iteration_use: int, kind: int, input_type: ref[Type], error_node: ref[AstNode]?) returns ref[Type]?
    {
        if Checker.is_type_any(input_type)
            return null
        let mark this.unported_mark()
        let it this.get_iteration_types_of_iterable(input_type, iteration_use, error_node)
        if this.unported_mark() <> mark
            return null
        Checker.iteration_types_get(it, kind)
    }

    ; getIterationTypeOfGeneratorFunctionReturnType and its IterationTypes twin —
    ; what a `Generator<...>`/`AsyncGenerator<...>` annotation says about the
    ; function's yield, return and next types.
    ;
    ; ★★ IT ASKS THE ITERABLE ROUTE FIRST AND THE ITERATOR ROUTE SECOND, which is
    ; how a `function* g(): Iterator<number>` works at all: `Iterator` is not
    ; iterable, so the first attempt answers the sentinel and the second reads the
    ; `next` member.
    procedure get_iteration_type_of_generator_function_return_type(this, kind: int, return_type: ref[Type], is_async_generator: bool) returns ref[Type]?
    {
        if Checker.is_type_any(return_type)
            return null
        let mark this.unported_mark()
        let it this.get_iteration_types_of_generator_function_return_type(return_type, is_async_generator)
        if this.unported_mark() <> mark
            return null
        Checker.iteration_types_get(it, kind)
    }

    procedure get_iteration_types_of_generator_function_return_type(this, t: ref[Type], is_async_generator: bool) returns IterationTypes
    {
        if Checker.is_type_any(t)
            return this.any_iteration_types()
        let mark this.unported_mark()
        var iteration_use IterationUseGeneratorReturnType
        if is_async_generator
            set iteration_use: IterationUseAsyncGeneratorReturnType
        let result this.get_iteration_types_of_iterable(t, iteration_use, null)
        if this.unported_mark() <> mark
            return Checker.no_iteration_types()
        if Checker.iteration_types_has_types(result)
            return result
        this.get_iteration_types_of_iterator(t, is_async_generator, null)
    }

    ; getAsyncFromSyncIterationTypes — what a for-await-of does to a SYNC
    ; iterable's types. ★The `all three are any` early exit is the reference's and
    ; it is not an optimisation: awaiting `any` would mint `Awaited<any>` rows for
    ; nothing.
    procedure get_async_from_sync_iteration_types(this, it: IterationTypes, error_node: ref[AstNode]?) returns IterationTypes
    {
        if Checker.iteration_types_has_types(it) = false
            return it
        var all_any true
        if it.yield_type <> any_type
            set all_any: false
        if it.return_type <> any_type
            set all_any: false
        if it.next_type <> any_type
            set all_any: false
        if all_any
            return it
        let mark this.unported_mark()
        ; "if we're requesting diagnostics, report errors for a missing `Awaited<T>`."
        if error_node <> null
        {
            this.report_checked_global_type_alias("Awaited", 1)
            this.get_global_awaited_symbol()
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
        }
        var y: ref[Type]? null
        var r: ref[Type]? null
        if it.yield_type <> null
        {
            set y: this.get_awaited_type_ex(it.yield_type as ref[Type], error_node, 0)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
        }
        if it.return_type <> null
        {
            set r: this.get_awaited_type_ex(it.return_type as ref[Type], error_node, 0)
            if this.unported_mark() <> mark
                return Checker.no_iteration_types()
        }
        if y = null
            set y: any_type
        if r = null
            set r: any_type
        IterationTypes(y, r, it.next_type)
    }

    ; ── THE AWAITED TYPE ─────────────────────────────────────────────────────
    ;
    ; What `await x` has as its type: x's PROMISED type if x is promise-like,
    ; recursively, and x itself otherwise. The reference's own summary is *"this is
    ; used to reflect the runtime behavior of the `await` keyword"*, and that is the
    ; whole specification — a thenable adopted by a promise resolves through, and a
    ; thenable that is NOT a promise never settles, which is why the last arm of
    ; getAwaitedTypeNoAliasEx is an ERROR rather than an answer.
    ;
    ; ★★★ THE `Awaited<T>` WRAPPER IS A SEPARATE QUESTION FROM THE UNWRAPPING, and
    ; the two are two functions on purpose. getAwaitedTypeNoAlias UNWRAPS; the `Ex`
    ; entry additionally WRAPS a still-generic answer in the lib's `Awaited<T>`
    ; alias, so that `async function f<T>(x: T) { return await x }` answers
    ; `Awaited<T>` and not `T`. Every caller that already knows it will wrap or
    ; instantiate later asks the NoAlias form, which is why there are four names.

    ; checkAwaitedType — the entry that turns a failure into errorType.
    procedure check_awaited_type(this, t: ref[Type], with_alias: bool, error_node: ref[AstNode]?, code: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        var awaited: ref[Type]? null
        if with_alias
            set awaited: this.get_awaited_type_ex(t, error_node, code)
        else
            set awaited: this.get_awaited_type_no_alias_ex(t, error_node, code)
        if this.unported_mark() <> mark
            return null
        if awaited <> null
            return awaited
        error_type
    }

    procedure get_awaited_type(this, t: ref[Type]) returns ref[Type]?
        this.get_awaited_type_ex(t, null, 0)

    procedure get_awaited_type_ex(this, t: ref[Type], error_node: ref[AstNode]?, code: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let awaited this.get_awaited_type_no_alias_ex(t, error_node, code)
        if this.unported_mark() <> mark
            return null
        if awaited = null
            return null
        this.create_awaited_type_if_needed(awaited as ref[Type])
    }

    procedure get_awaited_type_no_alias(this, t: ref[Type]) returns ref[Type]?
        this.get_awaited_type_no_alias_ex(t, null, 0)

    ; getAwaitedTypeNoAliasEx, whole.
    ;
    ; ★★★ THE RECURSION GUARD IS THE FUNCTION'S REASON FOR BEING THIS LONG, and the
    ; reference spends twenty lines of comment on it: a promise whose promised type
    ; is itself, or a mutually recursive pair, passes the PromiseLike test and would
    ; unwrap for ever. `interface BadPromise { then(onfulfilled: (value:
    ; BadPromise) => any, onrejected: (error: any) => any): BadPromise }` is
    ; upstream's own example. Two of the three failure paths report TS1062 (*type is
    ; referenced directly or indirectly in the fulfillment callback of its own then
    ; method*) and the third is the thenable error.
    ;
    ; ★★ THE MEMO IS WRITTEN AT THE END OF EVERY SUCCEEDING ARM AND AT NO FAILURE,
    ; and that asymmetry is load-bearing: a failure REPORTS, so caching it would
    ; suppress the diagnostic on a second ask at a different node.
    procedure get_awaited_type_no_alias_ex(this, t: ref[Type], error_node: ref[AstNode]?, code: int) returns ref[Type]?
    {
        if Checker.is_type_any(t)
            return t
        let mark this.unported_mark()
        ; "If this is already an `Awaited<T>`, just return it. This avoids
        ; `Awaited<Awaited<T>>` in higher-order"
        let already this.is_awaited_type_instantiation(t)
        if this.unported_mark() <> mark
            return null
        if already
            return t
        let link this.awaited_type_link_of(t)
        if link.awaited <> null
            return link.awaited
        ; "For a union, get a union of the awaited types of each constituent."
        if (t.flags & TypeFlagsUnion) <> 0
        {
            if this.awaited_type_stack_contains(t)
            {
                this.error_on_node(error_node, DiagType_is_referenced_directly_or_indirectly_in_the_fulfillment_callback_of_its_own_then_method)
                return null
            }
            this.awaited_type_stack_push(t)
            let mapped this.map_type_to_awaited_type(t, error_node, code)
            this.awaited_type_stack_pop()
            if this.unported_mark() <> mark
                return null
            if mapped = null
                return null
            set link.awaited: mapped
            return mapped
        }
        ; "If `type` is generic and should be wrapped in `Awaited<T>`, return it."
        let needed this.is_awaited_type_needed(t)
        if this.unported_mark() <> mark
            return null
        if needed
        {
            set link.awaited: t
            return t
        }
        var this_type_for_error: ref[Type]? null
        let promised this.get_promised_type_of_promise_ex(t, null, &this_type_for_error)
        if this.unported_mark() <> mark
            return null
        if promised <> null
        {
            let p promised as ref[Type]
            var bad false
            if p = t
                set bad: true
            if this.awaited_type_stack_contains(p)
                set bad: true
            if bad
            {
                ; See the header — a singly- or mutually-recursive promise type.
                this.error_on_node(error_node, DiagType_is_referenced_directly_or_indirectly_in_the_fulfillment_callback_of_its_own_then_method)
                return null
            }
            ; "Keep track of the type we're about to unwrap to avoid bad recursive
            ; promise types."
            this.awaited_type_stack_push(t)
            let awaited this.get_awaited_type_no_alias_ex(p, error_node, code)
            this.awaited_type_stack_pop()
            if this.unported_mark() <> mark
                return null
            if awaited = null
                return null
            set link.awaited: awaited
            return awaited
        }
        ; "The type was not a promise, so it could not be unwrapped any further. As
        ; long as the type does not have a callable "then" property, it is safe to
        ; return the type; otherwise, an error is reported and we return undefined."
        let thenable this.is_thenable_type(t)
        if this.unported_mark() <> mark
            return null
        if thenable
        {
            if error_node <> null
            {
                ; ★★ UPSTREAM THIS IS A DIAGNOSTIC CHAIN — TS2684 (*the this context
                ; of type 0 is not assignable …*) as the head of the caller's own
                ; message — and this port has no chain (§3.20). What is compared is
                ; the (pos, end, code) triple, and the reference's chain reports the
                ; OUTERMOST code at the node, so the caller's `code` is what goes
                ; out; the `thisTypeForError` half is the chain's link and is lost
                ; with it. ★A caller that passes no code (the async-from-sync path)
                ; would report nothing at all upstream either, because a chain with
                ; a nil message and no next is not added. ★★★Its two type NAMES are
                ; walked all the same when the link exists (slice 189) — the link is
                ; built whenever `thisTypeForError != nil`, before the head is put on
                ; top of it; see name_type_for_message.
                if this_type_for_error <> null
                {
                    this.name_type_for_message(t)
                    this.name_type_for_message(this_type_for_error)
                }
                if code <> 0
                    this.error_on_node(error_node, code)
            }
            return null
        }
        set link.awaited: t
        t
    }

    ; mapType(t, func(t) { return c.getAwaitedTypeNoAliasEx(t, errorNode, msg) }) —
    ; one per-predicate map for the reason the filters are per-predicate.
    ; ★★★ IT IS `mapType` AND NOT A HAND-ROLLED UNION WALK, because mapType's own
    ; rules are what make a `never` constituent vanish and a single-constituent
    ; result not re-wrap: reproducing them here would be the second copy of the
    ; only tricky part.
    procedure map_type_to_awaited_type(this, t: ref[Type], error_node: ref[AstNode]?, code: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
            return this.get_awaited_type_no_alias_ex(t, error_node, code)
        let types Checker.union_types_of(t)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]^host()
        var changed false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let one this.get_awaited_type_no_alias_ex(row as ref[Type], error_node, code)
            if this.unported_mark() <> mark
                return null
            ; ★★★ A NIL CONSTITUENT IS SKIPPED, NOT PROPAGATED, and that one line
            ; is the whole of `mapTypeEx`'s `if mapped != nil` — the port returned
            ; null here, so a union with ONE bad-actor promise in it answered
            ; errorType instead of the union of the rest. `T1 = 1 | Promise<T1> |
            ; T1[]`: the reference reports TS1062 on the recursive constituent and
            ; still answers `1 | T1[]`, where this answered `any`
            ; (unresolvableSelfReferencingAwaitedUnion).
            if one = null
                set changed: true
            else
            {
                if (one as ref[Type]) <> row
                    set changed: true
                mapped.add(one)
            }
        }
        if changed = false
            return t
        ; `if len(mappedTypes) == 0 { return nil }` — every constituent dropped.
        if mapped.get_length() = 0
            return null
        this.get_union_type(mapped)
    }

    ; isAwaitedTypeInstantiation — *is this already an `Awaited<T>`?*
    ; ★It asks the ALIAS and not the shape: `Awaited<T>` is a conditional type, and
    ; what identifies it is that its alias symbol is the lib's own with exactly one
    ; type argument.
    procedure is_awaited_type_instantiation(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsConditional) = 0
            return false
        let mark this.unported_mark()
        let sym this.get_global_awaited_symbol()
        if this.unported_mark() <> mark
            return false
        if sym = null
            return false
        if t.alias_symbol = null
            return false
        if (t.alias_symbol as ref[Symbol]) <> (sym as ref[Symbol])
            return false
        if t.alias_type_arguments = null
            return false
        (t.alias_type_arguments as ref[Array[ref[Type]?]]).get_length() = 1
    }

    ; isAwaitedTypeNeeded — *would wrapping this in `Awaited<T>` say anything?*
    ;
    ; ★★★ THE THREE CONDITIONS ARE THE REFERENCE'S OWN LIST and the middle one is
    ; the surprising one: a type variable whose base constraint is `any`, `unknown`,
    ; `{}`, `object` or promise-like needs the wrapper, because such a constraint
    ; does not rule out a promise; a variable constrained to `number` does not.
    procedure is_awaited_type_needed(this, t: ref[Type]) returns bool
    {
        if Checker.is_type_any(t)
            return false
        let mark this.unported_mark()
        let already this.is_awaited_type_instantiation(t)
        if this.unported_mark() <> mark
            return false
        if already
            return false
        ; "We only need `Awaited<T>` if `T` contains possibly non-primitive types."
        let generic this.is_generic_object_type(t)
        if this.unported_mark() <> mark
            return false
        if generic = false
            return false
        let base this.get_base_constraint_of_type(t)
        if this.unported_mark() <> mark
            return false
        if base = null
            return Checker.maybe_type_of_kind(t, TypeFlagsTypeVariable)
        let b base as ref[Type]
        if (b.flags & TypeFlagsAnyOrUnknown) <> 0
            return true
        let empty this.is_empty_object_type(b)
        if this.unported_mark() <> mark
            return false
        if empty
            return true
        this.some_type_is_thenable(b)
    }

    ; someType(t, c.isThenableType) — one per-predicate `someType`.
    procedure some_type_is_thenable(this, t: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
            return this.is_thenable_type(t)
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if this.is_thenable_type(row as ref[Type])
                return true
            if this.unported_mark() <> mark
                return false
        }
        false
    }

    ; createAwaitedTypeIfNeeded and tryCreateAwaitedType.
    procedure create_awaited_type_if_needed(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let needed this.is_awaited_type_needed(t)
        if this.unported_mark() <> mark
            return null
        if needed
        {
            let awaited this.try_create_awaited_type(t)
            if this.unported_mark() <> mark
                return null
            if awaited <> null
                return awaited
        }
        t
    }

    ; ★"Unwrap unions that may contain `Awaited<T>`, otherwise its possible to
    ; manufacture an `Awaited<Awaited<T> | U>` where an `Awaited<T | U>` would
    ; suffice."
    procedure try_create_awaited_type(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        this.report_checked_global_type_alias("Awaited", 1)
        let sym this.get_global_awaited_symbol()
        if this.unported_mark() <> mark
            return null
        if sym = null
            return null
        let inner this.unwrap_awaited_type(t)
        if this.unported_mark() <> mark
            return null
        if inner = null
            return null
        let args &Array[ref[Type]?]^host()
        args.add(inner)
        this.get_type_alias_instantiation(sym as ref[Symbol], args, null)
    }

    ; unwrapAwaitedType — "for a generic `Awaited<T>`, gets `T`".
    procedure unwrap_awaited_type(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return t
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            let mapped &Array[ref[Type]?]^host()
            var changed false
            var i 0
            while i < n
            {
                let row list[i]
                set i: i + 1
                if row = null
                    continue
                let one this.unwrap_awaited_type(row as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if one = null
                    return null
                if (one as ref[Type]) <> row
                    set changed: true
                mapped.add(one)
            }
            if changed = false
                return t
            return this.get_union_type(mapped)
        }
        let already this.is_awaited_type_instantiation(t)
        if this.unported_mark() <> mark
            return null
        if already
        {
            let args t.alias_type_arguments as ref[Array[ref[Type]?]]
            if (args.get_length() as int) >= 1
                return args[0]
        }
        t
    }

    ; isThenableType. ★The PRIMITIVE early exit is the reference's own comment:
    ; *"primitive types cannot be considered "thenable" since they are not
    ; objects"* — a `string` with a `then` in an augmented lib is still not a
    ; promise. ★The `then` property is read through NEUndefinedOrNull, so an
    ; OPTIONAL `then?` counts.
    procedure is_thenable_type(this, t: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        let base this.get_base_constraint_or_type(t)
        if this.unported_mark() <> mark
            return false
        if base = null
            return false
        let primitive this.all_types_assignable_to_kind(base as ref[Type], TypeFlagsPrimitive | TypeFlagsNever)
        if this.unported_mark() <> mark
            return false
        if primitive
            return false
        let then_function this.get_type_of_property_of_type(t, "then")
        if this.unported_mark() <> mark
            return false
        if then_function = null
            return false
        let narrowed this.get_type_with_facts(then_function as ref[Type], TypeFactsNEUndefinedOrNull)
        if this.unported_mark() <> mark
            return false
        if narrowed = null
            return false
        let sigs this.get_signatures_of_type(narrowed as ref[Type], SignatureKindCall)
        if this.unported_mark() <> mark
            return false
        if sigs = null
            return false
        (sigs as ref[Array[ref[Signature]?]]).get_length() > 0
    }

    ; getAwaitedTypeOfPromise and its Ex twin — the PROMISED type, awaited.
    procedure get_awaited_type_of_promise(this, t: ref[Type]) returns ref[Type]?
        this.get_awaited_type_of_promise_ex(t, null, 0)

    procedure get_awaited_type_of_promise_ex(this, t: ref[Type], error_node: ref[AstNode]?, code: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let promised this.get_promised_type_of_promise_ex(t, error_node, null)
        if this.unported_mark() <> mark
            return null
        if promised = null
            return null
        this.get_awaited_type_ex(promised as ref[Type], error_node, code)
    }

    ; getPromisedTypeOfPromise, whole — the `then` member read as a promise.
    ;
    ; ★★★ IT IS THE SHAPE TEST THE WHOLE ASYNC CHAPTER STANDS ON, and it reads FOUR
    ; things in order: a reference to the global `Promise<T>` short-circuits to its
    ; type argument; a primitive is refused outright; `then`'s call signatures are
    ; taken and those whose `this` the receiver does not satisfy are dropped (with
    ; the LAST such `this` kept for the error); and then the FIRST PARAMETER of the
    ; first parameter of `then` — `onfulfilled`'s `value` — is the promised type.
    ;
    ; ★★ THE `thisTypeForErrorOut` OUT-PARAMETER EXISTS FOR ONE CALLER, and that
    ; caller is getAwaitedTypeNoAliasEx's thenable arm, which upstream builds a
    ; TS2684 chain out of it. That chain is not in this port (§3.20), so the value
    ; is written and its reader does nothing with it — the parameter is kept
    ; because dropping it would make this function look as though the reference had
    ; no second answer here.
    procedure get_promised_type_of_promise_ex(this, t: ref[Type], error_node: ref[AstNode]?, this_type_for_error_out: ref[ref[Type]?]?) returns ref[Type]?
    {
        if Checker.is_type_any(t)
            return null
        let mark this.unported_mark()
        let link this.promised_type_link_of(t)
        if link.promised <> null
            return link.promised
        let gp this.get_global_promise_type()
        if this.unported_mark() <> mark
            return null
        if Checker.is_reference_to_type(t, gp)
        {
            let args this.get_type_arguments(t)
            if this.unported_mark() <> mark
                return null
            if args <> null
            {
                let list args as ref[Array[ref[Type]?]]
                if (list.get_length() as int) >= 1
                {
                    set link.promised: list[0]
                    return list[0]
                }
            }
            return null
        }
        ; "primitives with a `{ then() }` won't be unwrapped/adopted."
        let base this.get_base_constraint_or_type(t)
        if this.unported_mark() <> mark
            return null
        if base = null
            return null
        let primitive this.all_types_assignable_to_kind(base as ref[Type], TypeFlagsPrimitive | TypeFlagsNever)
        if this.unported_mark() <> mark
            return null
        if primitive
            return null
        let then_function this.get_type_of_property_of_type(t, "then")
        if this.unported_mark() <> mark
            return null
        if Checker.is_type_any(then_function)
            return null
        var then_count 0
        var then_sigs: ref[Array[ref[Signature]?]]? null
        if then_function <> null
        {
            set then_sigs: this.get_signatures_of_type(then_function as ref[Type], SignatureKindCall)
            if this.unported_mark() <> mark
                return null
            if then_sigs <> null
                set then_count: (then_sigs as ref[Array[ref[Signature]?]]).get_length() as int
        }
        if then_count = 0
        {
            this.error_on_node(error_node, DiagA_promise_must_have_a_then_method)
            return null
        }
        let list then_sigs as ref[Array[ref[Signature]?]]
        var this_type_for_error: ref[Type]? null
        let candidates &Array[ref[Signature]?]()
        var i 0
        while i < then_count
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let sig row as ref[Signature]
            let this_type this.get_this_type_of_signature(sig)
            if this.unported_mark() <> mark
                return null
            var rejected false
            if this_type <> null
            {
                let tt this_type as ref[Type]
                if tt <> void_type
                {
                    let related this.is_type_related_to(t, tt, RelationSubtype)
                    if this.unported_mark() <> mark
                        return null
                    if related = false
                    {
                        set this_type_for_error: this_type
                        set rejected: true
                    }
                }
            }
            if rejected = false
                candidates.add(sig)
        }
        if candidates.get_length() = 0
        {
            if this_type_for_error_out <> null
                set *this_type_for_error_out: this_type_for_error
            if error_node <> null
            {
                let name_arg17 this.type_arg(t)
                let name_arg18 this.type_arg(this_type_for_error)
                this.error_on_node(error_node, DiagThe_this_context_of_type_0_is_not_assignable_to_method_s_this_of_type_1, name_arg17, name_arg18)
            }
            return null
        }
        let first_params &Array[ref[Type]?]^host()
        let cn candidates.get_length() as int
        var j 0
        while j < cn
        {
            let row candidates[j]
            set j: j + 1
            if row = null
                continue
            let pt this.get_type_of_first_parameter_of_signature(row as ref[Signature])
            if this.unported_mark() <> mark
                return null
            first_params.add(pt)
        }
        let onfulfilled_union this.get_union_type(first_params)
        if this.unported_mark() <> mark
            return null
        if onfulfilled_union = null
            return null
        let onfulfilled this.get_type_with_facts(onfulfilled_union as ref[Type], TypeFactsNEUndefinedOrNull)
        if this.unported_mark() <> mark
            return null
        if Checker.is_type_any(onfulfilled)
            return null
        if onfulfilled = null
            return null
        let of_sigs this.get_signatures_of_type(onfulfilled as ref[Type], SignatureKindCall)
        if this.unported_mark() <> mark
            return null
        var of_count 0
        if of_sigs <> null
            set of_count: (of_sigs as ref[Array[ref[Signature]?]]).get_length() as int
        if of_count = 0
        {
            this.error_on_node(error_node, DiagThe_first_parameter_of_the_then_method_of_a_promise_must_be_a_callback)
            return null
        }
        let of_list of_sigs as ref[Array[ref[Signature]?]]
        let values &Array[ref[Type]?]^host()
        var k 0
        while k < of_count
        {
            let row of_list[k]
            set k: k + 1
            if row = null
                continue
            let pt this.get_type_of_first_parameter_of_signature(row as ref[Signature])
            if this.unported_mark() <> mark
                return null
            values.add(pt)
        }
        let result this.get_union_type_ex(values, UnionReductionSubtype, null, null)
        if this.unported_mark() <> mark
            return null
        if result <> null
            set link.promised: result
        result
    }

    ; ── the PROMISE and GENERATOR type constructors ──────────────────────────

    ; createPromiseType. ★`getGlobalPromiseTypeChecked` upstream — the `_Checked`
    ; twin, whose only difference is the TS2318 §3.11 owes; see the globals block.
    ; ★★ THE ARGUMENT IS UNWRAPPED FIRST and the reference says why: *"Unwrap an
    ; `Awaited<T>` to `T` to improve inference"* — without it an async function
    ; returning an `Awaited<U>` would answer `Promise<Awaited<U>>`.
    procedure create_promise_type(this, promised_type: ref[Type]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        this.report_checked_global_type("Promise", 1)
        let g this.get_global_promise_type()
        if this.unported_mark() <> mark
            return null
        if g = null
            return unknown_type
        if (g as ref[Type]) = empty_generic_type
            return unknown_type
        var inner: ref[Type]? unknown_type
        if promised_type <> null
        {
            let unwrapped this.unwrap_awaited_type(promised_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if unwrapped <> null
            {
                let awaited this.get_awaited_type_no_alias(unwrapped as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if awaited <> null
                    set inner: awaited
            }
        }
        let args &Array[ref[Type]?]^host()
        args.add(inner)
        this.create_type_reference(g as ref[Type], args, ObjectFlagsNone)
    }

    procedure create_promise_like_type(this, promised_type: ref[Type]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        this.report_checked_global_type("PromiseLike", 1)
        let g this.get_global_promise_like_type()
        if this.unported_mark() <> mark
            return null
        if g = null
            return unknown_type
        if (g as ref[Type]) = empty_generic_type
            return unknown_type
        var inner: ref[Type]? unknown_type
        if promised_type <> null
        {
            let unwrapped this.unwrap_awaited_type(promised_type as ref[Type])
            if this.unported_mark() <> mark
                return null
            if unwrapped <> null
            {
                let awaited this.get_awaited_type_no_alias(unwrapped as ref[Type])
                if this.unported_mark() <> mark
                    return null
                if awaited <> null
                    set inner: awaited
            }
        }
        let args &Array[ref[Type]?]^host()
        args.add(inner)
        this.create_type_reference(g as ref[Type], args, ObjectFlagsNone)
    }

    ; createPromiseReturnType. ★★ ITS SECOND REPORT IS ABOUT THE CONSTRUCTOR AND
    ; NOT THE TYPE: `getGlobalPromiseConstructorSymbol` is the VALUE `Promise`, and
    ; a lib that declares the interface without the constructor gets TS2705/TS2712
    ; and still answers the type. Under this harness the lib has both, so both arms
    ; are written for their shape.
    procedure create_promise_return_type(this, fn: ref[AstNode], promised_type: ref[Type]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let promise_type this.create_promise_type(promised_type)
        if this.unported_mark() <> mark
            return null
        if promise_type = null
            return null
        if (promise_type as ref[Type]) = unknown_type
        {
            var code DiagAn_async_function_or_method_must_return_a_Promise_Make_sure_you_have_a_declaration_for_Promise_or_include_ES2015_in_your_lib_option
            if AstNode.is_import_call(fn)
                set code: DiagA_dynamic_import_call_returns_a_Promise_Make_sure_you_have_a_declaration_for_Promise_or_include_ES2015_in_your_lib_option
            this.error_on_node(fn, code)
            return error_type
        }
        this.report_checked_global_value("Promise")
        let ctor this.get_global_promise_constructor_symbol()
        if this.unported_mark() <> mark
            return null
        if ctor = null
        {
            var code DiagAn_async_function_or_method_in_ES5_requires_the_Promise_constructor_Make_sure_you_have_a_declaration_for_the_Promise_constructor_or_include_ES2015_in_your_lib_option
            if AstNode.is_import_call(fn)
                set code: DiagA_dynamic_import_call_in_ES5_requires_the_Promise_constructor_Make_sure_you_have_a_declaration_for_the_Promise_constructor_or_include_ES2015_in_your_lib_option
            this.error_on_node(fn, code)
        }
        promise_type
    }

    ; getGlobalPromiseConstructorSymbol — the VALUE `Promise`, the way
    ; get_global_es_symbol_constructor_symbol_or_nil reads the value `Symbol`.
    procedure get_global_promise_constructor_symbol(this) returns ref[Symbol]?
        this.lookup_globals("Promise", SymbolFlagsValue)

    ; createGeneratorType, whole — the type of a `function*`.
    ;
    ; ★★ THE `IterableIterator` FALLBACK IS FOR A LIB WITHOUT `Generator`, and it is
    ; the reason the function cannot be a one-line createTypeFromGenericGlobalType:
    ; a target below ES2015 has neither and then the report is owed on the
    ; `IterableIterator` name (the `_Checked` twin again).
    procedure create_generator_type(this, yield_type_in: ref[Type]?, return_type_in: ref[Type]?, next_type: ref[Type]?, is_async_generator: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let gg this.resolver_get_global_generator_type(is_async_generator)
        if this.unported_mark() <> mark
            return null
        var yield_type this.resolver_resolve_iteration_type(is_async_generator, yield_type_in, null)
        var return_type this.resolver_resolve_iteration_type(is_async_generator, return_type_in, null)
        if this.unported_mark() <> mark
            return null
        if yield_type = null
            set yield_type: unknown_type
        if return_type = null
            set return_type: unknown_type
        let args &Array[ref[Type]?]^host()
        args.add(yield_type)
        args.add(return_type)
        args.add(next_type)
        var absent false
        if gg = null
            set absent: true
        else
        {
            if (gg as ref[Type]) = empty_generic_type
                set absent: true
        }
        if absent
        {
            let gii this.resolver_get_global_iterable_iterator_type(is_async_generator)
            if this.unported_mark() <> mark
                return null
            if gii <> null
            {
                if (gii as ref[Type]) <> empty_generic_type
                    return this.create_type_from_generic_global_type(gii, args)
            }
            ; "The global Generator type doesn't exist, so report an error"
            if is_async_generator
                this.report_checked_global_type("AsyncIterableIterator", 3)
            else
                this.report_checked_global_type("IterableIterator", 3)
            return empty_object_type
        }
        this.create_type_from_generic_global_type(gg, args)
    }

    ; createIterableType.
    procedure create_iterable_type(this, iterated_type: ref[Type]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        this.report_checked_global_type("Iterable", 3)
        let g this.get_global_iterable_type()
        if this.unported_mark() <> mark
            return null
        let args &Array[ref[Type]?]^host()
        args.add(iterated_type)
        args.add(void_type)
        args.add(undefined_type)
        this.create_type_from_generic_global_type(g, args)
    }

    ; checkGeneratorInstantiationAssignabilityToReturnType.
    ;
    ; ★★ ITS COMMENT IS THE WHOLE REASON IT IS NOT `Generator<any,any,any>` AGAINST
    ; THE ANNOTATION: *"interface BadGenerator extends Iterable<number>,
    ; Iterator<string> { }"* would pass such a test, because each half is satisfied
    ; separately. Reading the three iteration types OFF the annotation and building
    ; the generator from them is what catches the disagreement.
    procedure check_generator_instantiation_assignability_to_return_type(this, return_type: ref[Type], function_flags: int, error_node: ref[AstNode]?) returns bool
    {
        let mark this.unported_mark()
        let is_async (function_flags & FunctionFlagsAsync) <> 0
        var y this.get_iteration_type_of_generator_function_return_type(IterationTypeKindYield, return_type, is_async)
        if this.unported_mark() <> mark
            return false
        if y = null
            set y: any_type
        var r this.get_iteration_type_of_generator_function_return_type(IterationTypeKindReturn, return_type, is_async)
        if this.unported_mark() <> mark
            return false
        if r = null
            set r: y
        var x this.get_iteration_type_of_generator_function_return_type(IterationTypeKindNext, return_type, is_async)
        if this.unported_mark() <> mark
            return false
        if x = null
            set x: unknown_type
        let instantiation this.create_generator_type(y, r, x, is_async)
        if this.unported_mark() <> mark
            return false
        if instantiation = null
            return false
        this.check_type_assignable_to(instantiation as ref[Type], return_type, error_node, 0)
    }

    ; getWidenedLiteralLikeTypeForContextualIterationTypeIfNeeded — the generator
    ; twin of the return-type widener already here.
    procedure get_widened_literal_like_type_for_contextual_iteration_type_if_needed(this, t: ref[Type]?, contextual_signature_return_type: ref[Type]?, kind: int, is_async_generator: bool) returns ref[Type]?
    {
        if t = null
            return null
        if Checker.is_unit_type(t as ref[Type]) = false
            return t
        let mark this.unported_mark()
        var contextual_type: ref[Type]? null
        if contextual_signature_return_type <> null
        {
            set contextual_type: this.get_iteration_type_of_generator_function_return_type(kind, contextual_signature_return_type as ref[Type], is_async_generator)
            if this.unported_mark() <> mark
                return null
        }
        this.get_widened_literal_like_type_for_contextual_type(t, contextual_type)
    }

    ; ── the CONTEXTUAL types of this chapter ─────────────────────────────────

    ; getContextualIterationType.
    procedure get_contextual_iteration_type(this, kind: int, function_decl: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let is_async (b.get_function_flags(function_decl) & FunctionFlagsAsync) <> 0
        let contextual this.get_contextual_return_type(function_decl, ContextFlagsNone)
        if this.unported_mark() <> mark
            return null
        if contextual = null
            return null
        this.get_iteration_type_of_generator_function_return_type(kind, contextual as ref[Type], is_async)
    }

    ; getContextualTypeForYieldOperand, whole.
    ;
    ; ★★ THE `yield*` ARM BUILDS A GENERATOR TYPE OUT OF THE CONTEXT and unions the
    ; sync and async forms when the container is an async generator — a `yield*` in
    ; an async generator may delegate to either.
    procedure get_contextual_type_for_yield_operand(this, node: ref[AstNode], context_flags: int) returns ref[Type]?
    {
        let fn Checker.get_containing_function(node)
        if fn = null
            return null
        let f fn as ref[AstNode]
        let mark this.unported_mark()
        let function_flags b.get_function_flags(f)
        var contextual this.get_contextual_return_type(f, context_flags)
        if this.unported_mark() <> mark
            return null
        if contextual = null
            return null
        let is_async_generator (function_flags & FunctionFlagsAsync) <> 0
        let is_yield_star AstNode.asterisk_token_of(node) <> null
        if is_yield_star = false
        {
            if ((contextual as ref[Type]).flags & TypeFlagsUnion) <> 0
            {
                set contextual: this.filter_type_by_generator_return_kind(contextual as ref[Type], IterationTypeKindReturn, is_async_generator)
                if this.unported_mark() <> mark
                    return null
                if contextual = null
                    return null
            }
        }
        if is_yield_star
        {
            let it this.get_iteration_types_of_generator_function_return_type(contextual as ref[Type], is_async_generator)
            if this.unported_mark() <> mark
                return null
            var y it.yield_type
            if y = null
                set y: silent_never_type
            var r this.get_contextual_type(node, context_flags)
            if this.unported_mark() <> mark
                return null
            if r = null
                set r: silent_never_type
            var x it.next_type
            if x = null
                set x: unknown_type
            let sync this.create_generator_type(y, r, x, false)
            if this.unported_mark() <> mark
                return null
            if is_async_generator = false
                return sync
            let async_gen this.create_generator_type(y, r, x, true)
            if this.unported_mark() <> mark
                return null
            let parts &Array[ref[Type]?]^host()
            parts.add(sync)
            parts.add(async_gen)
            return this.get_union_type(parts)
        }
        this.get_iteration_type_of_generator_function_return_type(IterationTypeKindYield, contextual as ref[Type], is_async_generator)
    }

    ; filterType(t, func(t) { return getIterationTypeOfGeneratorFunctionReturnType(
    ; Return, t, isAsyncGenerator) != nil }) — one more per-predicate filter.
    procedure filter_type_by_generator_return_kind(this, t: ref[Type], kind: int, is_async_generator: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            let one this.get_iteration_type_of_generator_function_return_type(kind, t, is_async_generator)
            if this.unported_mark() <> mark
                return null
            if one <> null
                return t
            return never_type
        }
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let kept &Array[ref[Type]?]^host()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let one this.get_iteration_type_of_generator_function_return_type(kind, row as ref[Type], is_async_generator)
            if this.unported_mark() <> mark
                return null
            if one <> null
                kept.add(row)
        }
        if (kept.get_length() as int) = n
            return t
        if kept.get_length() = 0
            return never_type
        this.get_union_type(kept)
    }

    ; getContextualTypeForAwaitOperand. ★The answer is a UNION of the awaited type
    ; and its `PromiseLike` — an `await` operand may be either the value or a
    ; promise for it, which is exactly what the union says.
    procedure get_contextual_type_for_await_operand(this, node: ref[AstNode], context_flags: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let contextual this.get_contextual_type(node, context_flags)
        if this.unported_mark() <> mark
            return null
        if contextual = null
            return null
        let awaited this.get_awaited_type_no_alias(contextual as ref[Type])
        if this.unported_mark() <> mark
            return null
        if awaited = null
            return null
        let like this.create_promise_like_type(awaited)
        if this.unported_mark() <> mark
            return null
        let parts &Array[ref[Type]?]^host()
        parts.add(awaited)
        parts.add(like)
        this.get_union_type(parts)
    }

    ; ── the four EXPRESSION arms ─────────────────────────────────────────────

    ; checkAwaitExpression. ★The `await has no effect` report is a SUGGESTION
    ; (TS80007, `addErrorOrSuggestion(false, …)`), which goes into a second list
    ; the yardstick does not read — so the condition is written and the report is
    ; not, the way the other suggestion sites in this port are.
    procedure check_await_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        this.check_grammar_await_or_await_using(node)
        let operand AstNode.expression_of(node)
        if operand = null
            return error_type
        let operand_type this.check_expression(operand as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if operand_type = null
            return null
        this.check_awaited_type(operand_type as ref[Type], true, node, DiagType_of_await_operand_must_either_be_a_valid_promise_or_must_not_contain_a_callable_then_member)
    }

    ; checkSpreadExpression.
    procedure check_spread_expression(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let operand AstNode.expression_of(node)
        if operand = null
            return error_type
        let t this.check_expression_ex(operand as ref[AstNode], check_mode)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        this.check_iterated_type_or_element_type(IterationUseSpread, t as ref[Type], undefined_type, operand)
    }

    ; checkRightHandSideOfForOf — the row this chapter has carried since slice 69.
    procedure check_right_hand_side_of_for_of(this, statement: ref[AstNode]) returns ref[Type]?
    {
        var iteration_use IterationUseForOf
        if AstNode.for_await_modifier_of(statement) <> null
            set iteration_use: IterationUseForAwaitOf
        let subject AstNode.expression_of(statement)
        if subject = null
            return error_type
        let mark this.unported_mark()
        let t this.check_non_null_expression(subject as ref[AstNode])
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        this.check_iterated_type_or_element_type(iteration_use, t as ref[Type], undefined_type, subject)
    }

    ; checkYieldExpression, whole.
    ;
    ; ★★★ ITS FOUR ANSWERS ARE FOUR DIFFERENT QUESTIONS and the order between them
    ; is the function: a `yield*` answers the delegated iterable's RETURN type; a
    ; plain `yield` in an ANNOTATED generator answers the annotation's NEXT type; in
    ; an unannotated one it answers the CONTEXTUAL next type; and with neither it is
    ; `any` plus TS7057 under noImplicitAny. ★The assignability check in the middle
    ; is skipped without an annotation, and the reference says why: *"there is no
    ; point in doing an assignability check if the function has no explicit return
    ; type because the return type is directly computed from the yield
    ; expressions"*.
    ;
    ; ★The `checkExternalEmitHelpers` call for an async generator below ES2018 is
    ; not written: §3.5cx priced it — the function returns at its own first line
    ; because ImportHelpers is unset — and the arm has no other content.
    procedure check_yield_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        this.check_grammar_yield_expression(node)
        let fn Checker.get_containing_function(node)
        if fn = null
            return any_type
        let f fn as ref[AstNode]
        let mark this.unported_mark()
        let function_flags b.get_function_flags(f)
        if (function_flags & FunctionFlagsGenerator) = 0
        {
            ; "If the user's code is syntactically correct, the func should always
            ; have a star. After all, we are in a yield context."
            return any_type
        }
        let is_async (function_flags & FunctionFlagsAsync) <> 0
        var return_type this.get_return_type_from_annotation(f)
        if this.unported_mark() <> mark
            return null
        if return_type <> null
        {
            if ((return_type as ref[Type]).flags & TypeFlagsUnion) <> 0
            {
                set return_type: this.filter_type_by_generator_instantiation(return_type as ref[Type], function_flags)
                if this.unported_mark() <> mark
                    return null
            }
        }
        var it Checker.no_iteration_types()
        if return_type <> null
        {
            set it: this.get_iteration_types_of_generator_function_return_type(return_type as ref[Type], is_async)
            if this.unported_mark() <> mark
                return null
        }
        var signature_yield_type it.yield_type
        if signature_yield_type = null
            set signature_yield_type: any_type
        var signature_next_type it.next_type
        if signature_next_type = null
            set signature_next_type: any_type
        let operand AstNode.expression_of(node)
        var yield_expression_type: ref[Type]? undefined_widening_type
        if operand <> null
        {
            set yield_expression_type: this.check_expression(operand as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if yield_expression_type = null
                return null
        }
        let yielded_type this.get_yielded_type_of_yield_expression(node, yield_expression_type as ref[Type], signature_next_type as ref[Type], is_async)
        if this.unported_mark() <> mark
            return null
        if return_type <> null
        {
            if yielded_type <> null
            {
                var error_node: ref[AstNode]? operand
                if error_node = null
                    set error_node: node
                this.check_type_assignable_to_and_optionally_elaborate(yielded_type as ref[Type], signature_yield_type as ref[Type], error_node, operand, 0)
                if this.unported_mark() <> mark
                    return null
            }
        }
        if AstNode.asterisk_token_of(node) <> null
        {
            if is_async and (language_version < ScriptTargetES2018)
                this.check_external_emit_helpers(node, ExternalEmitHelpersAwait | ExternalEmitHelpersAsyncDelegator | ExternalEmitHelpersAsyncValues)
            var iteration_use IterationUseYieldStar
            if is_async
                set iteration_use: IterationUseAsyncYieldStar
            let delegated this.get_iteration_type_of_iterable(iteration_use, IterationTypeKindReturn, yield_expression_type as ref[Type], operand)
            if this.unported_mark() <> mark
                return null
            if delegated <> null
                return delegated
            return any_type
        }
        if return_type <> null
        {
            let next this.get_iteration_type_of_generator_function_return_type(IterationTypeKindNext, return_type as ref[Type], is_async)
            if this.unported_mark() <> mark
                return null
            if next <> null
                return next
            return any_type
        }
        let contextual_next this.get_contextual_iteration_type(IterationTypeKindNext, f)
        if this.unported_mark() <> mark
            return null
        if contextual_next <> null
            return contextual_next
        if Checker.no_implicit_any()
        {
            if Checker.expression_result_is_unused(node) = false
            {
                let ct this.get_contextual_type(node, ContextFlagsNone)
                if this.unported_mark() <> mark
                    return null
                var report false
                if ct = null
                    set report: true
                else
                {
                    if Checker.is_type_any(ct)
                        set report: true
                }
                if report
                    this.error_on_node(node, DiagX_yield_expression_implicitly_results_in_an_any_type_because_its_containing_generator_lacks_a_return_type_annotation)
            }
        }
        any_type
    }

    ; filterType(t, func(t) { return checkGeneratorInstantiationAssignabilityToReturn
    ; Type(t, functionFlags, nil) }) — checkYieldExpression's own predicate.
    procedure filter_type_by_generator_instantiation(this, t: ref[Type], function_flags: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            let keep this.check_generator_instantiation_assignability_to_return_type(t, function_flags, null)
            if this.unported_mark() <> mark
                return null
            if keep
                return t
            return never_type
        }
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let kept &Array[ref[Type]?]^host()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let keep this.check_generator_instantiation_assignability_to_return_type(row as ref[Type], function_flags, null)
            if this.unported_mark() <> mark
                return null
            if keep
                kept.add(row)
        }
        if (kept.get_length() as int) = n
            return t
        if kept.get_length() = 0
            return never_type
        this.get_union_type(kept)
    }

    ; getYieldedTypeOfYieldExpression. ★A `yield*` yields everything its operand
    ; yields, so it goes through the iterated-type reading; a plain `yield` yields
    ; its operand. Both are then awaited in an async generator, with two DIFFERENT
    ; codes — TS1322 for the delegated form and TS1321 for the plain one.
    procedure get_yielded_type_of_yield_expression(this, node: ref[AstNode], expression_type: ref[Type], sent_type: ref[Type], is_async: bool) returns ref[Type]?
    {
        let operand AstNode.expression_of(node)
        var error_node: ref[AstNode]? operand
        if error_node = null
            set error_node: node
        let is_yield_star AstNode.asterisk_token_of(node) <> null
        let mark this.unported_mark()
        var yielded_type: ref[Type]? expression_type
        if is_yield_star
        {
            var iteration_use IterationUseYieldStar
            if is_async
                set iteration_use: IterationUseAsyncYieldStar
            set yielded_type: this.check_iterated_type_or_element_type(iteration_use, expression_type, sent_type, error_node)
            if this.unported_mark() <> mark
                return null
            if yielded_type = null
                return null
        }
        if is_async = false
            return yielded_type
        var code DiagType_of_yield_operand_in_an_async_generator_must_either_be_a_valid_promise_or_must_not_contain_a_callable_then_member
        if is_yield_star
            set code: DiagType_of_iterated_elements_of_a_yield_Asterisk_operand_must_either_be_a_valid_promise_or_must_not_contain_a_callable_then_member
        this.get_awaited_type_ex(yielded_type as ref[Type], error_node, code)
    }

    ; ── checkAndAggregateYieldOperandTypes and the walk it needs ─────────────
    ;
    ; ★★★ forEachYieldExpression IS INLINED AS ONE METHOD PER CALL SITE (§3.9e) AND
    ; THERE IS ONE CALL SITE. Upstream it is a generic traversal taking a visitor
    ; that closes over the two accumulators; here the accumulators are the walk's
    ; own parameters, which is the same decision §3.21 records for a closure over
    ; locals — and cheaper, because the walk has exactly one shape to serve.
    ;
    ; ★★★ THE WALK'S THREE PRUNING RULES ARE THE REFERENCE'S AND EACH IS LOAD-BEARING.
    ; (a) A `yield` inside a NESTED function belongs to that function, so a
    ; function-like node is not descended into — except through a COMPUTED PROPERTY
    ; NAME, whose expression is evaluated in the OUTER scope (upstream's own note
    ; says a class's methods are deliberately not included because that would need
    ; descending into the class). (b) A TYPE node holds no expressions to evaluate.
    ; (c) enum / interface / module / type-alias declarations are skipped *"to avoid
    ; the work"*. ★And a `yield`'s own OPERAND is descended into after the visit,
    ; because `yield yield x` is two yields.
    procedure collect_yield_operand_types(this, node: ref[AstNode], check_mode: int, is_async: bool, yield_types: ref[Array[ref[Type]?]], next_types: ref[Array[ref[Type]?]])
    {
        let mark this.unported_mark()
        let k AstNode.kind_of(node)
        if k = KindYieldExpression
        {
            let operand AstNode.expression_of(node)
            var yield_expr_type: ref[Type]? undefined_widening_type
            if operand <> null
            {
                let cm check_mode xor (check_mode & CheckModeSkipGenericFunctions)
                set yield_expr_type: this.check_expression_ex(operand as ref[AstNode], cm)
                if this.unported_mark() <> mark
                    return
                if yield_expr_type = null
                    return
                if this.is_const_context(operand as ref[AstNode])
                {
                    set yield_expr_type: this.get_regular_type_of_literal_type(yield_expr_type as ref[Type])
                    if this.unported_mark() <> mark
                        return
                    if yield_expr_type = null
                        return
                }
            }
            let yielded this.get_yielded_type_of_yield_expression(node, yield_expr_type as ref[Type], any_type, is_async)
            if this.unported_mark() <> mark
                return
            if yielded <> null
                Checker.append_type_if_unique(yield_types, yielded as ref[Type])
            if AstNode.asterisk_token_of(node) <> null
            {
                var iteration_use IterationUseYieldStar
                if is_async
                    set iteration_use: IterationUseAsyncYieldStar
                let it this.get_iteration_types_of_iterable(yield_expr_type as ref[Type], iteration_use, operand)
                if this.unported_mark() <> mark
                    return
                if it.next_type <> null
                    Checker.append_type_if_unique(next_types, it.next_type as ref[Type])
            }
            else
            {
                let ct this.get_contextual_type(node, ContextFlagsNone)
                if this.unported_mark() <> mark
                    return
                if ct <> null
                    Checker.append_type_if_unique(next_types, ct as ref[Type])
            }
            if operand <> null
                this.collect_yield_operand_types(operand as ref[AstNode], check_mode, is_async, yield_types, next_types)
            return
        }
        if k = KindEnumDeclaration
            return
        if k = KindInterfaceDeclaration
            return
        if k = KindModuleDeclaration
            return
        if k = KindTypeAliasDeclaration
            return
        if AstNode.is_function_like(node)
        {
            let name AstNode.name_of(node)
            if name = null
                return
            if AstNode.kind_of(name as ref[AstNode]) <> KindComputedPropertyName
                return
            let inner AstNode.expression_of(name as ref[AstNode])
            if inner = null
                return
            this.collect_yield_operand_types(inner as ref[AstNode], check_mode, is_async, yield_types, next_types)
            return
        }
        if AstNode.is_part_of_type_node(node)
            return
        let n AstNode.child_count(node)
        var i 0
        while i < n
        {
            let child AstNode.child_at(node, i)
            set i: i + 1
            if child = null
                continue
            this.collect_yield_operand_types(child as ref[AstNode], check_mode, is_async, yield_types, next_types)
            if this.unported_mark() <> mark
                return
        }
    }

    ; ★core.AppendIfUnique IS ALREADY HERE as `append_type_if_unique`, and its
    ; parameter is a NON-optional `ref[Type]` — so the null guard is the CALLER's,
    ; which is why the two call sites above test before they append rather than
    ; handing it an Option. A second copy taking the Option is §3.5dw's shape.

    ; checkGrammarYieldExpression.
    procedure check_grammar_yield_expression(this, node: ref[AstNode]) returns bool
    {
        var has_error false
        if (AstNode.flags_of(node) & NodeFlagsYieldContext) = 0
        {
            this.grammar_error_on_first_token(node, DiagA_yield_expression_is_only_allowed_in_a_generator_body)
            set has_error: true
        }
        if Checker.is_in_parameter_initializer_before_containing_function(node)
        {
            this.error_on_node(node, DiagX_yield_expressions_cannot_be_used_in_a_parameter_initializer)
            set has_error: true
        }
        has_error
    }

    ; checkGrammarAwaitOrAwaitUsing, whole.
    ;
    ; ★★ IT IS THE for-await BLOCK OF check_grammar_for_in_or_for_of_statement WITH A
    ; DIFFERENT MESSAGE SET, and the module-kind fallthrough is read the same way —
    ; see that function's header for the derivation, which is not repeated. The one
    ; structural difference is the CLASS-STATIC-BLOCK arm, which here is an `else
    ; if` chain head rather than a separate report: a class static block reports
    ; TS18037 and then asks nothing about the await context.
    ;
    ; ★★★ ALL FOUR MESSAGE PAIRS ARE LIVE SINCE SLICE 143 and the note that stood
    ; here — *both `await using` message pairs are written for the shape and are
    ; dead: the node reaching this function is an AwaitExpression at every ported
    ; call site* — expired the moment checkGrammarVariableDeclarationList's own arm
    ; was wired. The fork is `IsAwaitExpression(node)` and the reference asks it at
    ; every one of the four reports plus the parameter-initializer tail; taking the
    ; await-EXPRESSION half everywhere reported TS1375 where the reference reports
    ; TS2853.
    ; ★The `Did you mean to mark this function as async` related info is not built
    ; (§3.20).
    procedure check_grammar_await_or_await_using(this, node: ref[AstNode]) returns bool
    {
        var has_error false
        let is_await_expression AstNode.kind_of(node) = KindAwaitExpression
        let container Checker.get_containing_function_or_class_static_block(node)
        if Checker.kind_or_unknown(container) = KindClassStaticBlockDeclaration
        {
            ; "NOTE: We report this regardless as to whether there are parse
            ; diagnostics."
            var msg DiagX_await_using_statements_cannot_be_used_inside_a_class_static_block
            if is_await_expression
                set msg: DiagX_await_expression_cannot_be_used_inside_a_class_static_block
            this.error_on_node(node, msg)
            set has_error: true
        }
        else
        {
            if (AstNode.flags_of(node) & NodeFlagsAwaitContext) = 0
            {
                if Binder.is_in_top_level_context(node)
                {
                    if this.has_parse_diagnostics_of(node) = false
                    {
                        if this.is_effective_external_module() = false
                        {
                            var top_msg DiagX_await_using_statements_are_only_allowed_at_the_top_level_of_a_file_when_that_file_is_a_module_but_this_file_has_no_imports_or_exports_Consider_adding_an_empty_export_to_make_this_file_a_module
                            if is_await_expression
                                set top_msg: DiagX_await_expressions_are_only_allowed_at_the_top_level_of_a_file_when_that_file_is_a_module_but_this_file_has_no_imports_or_exports_Consider_adding_an_empty_export_to_make_this_file_a_module
                            this.grammar_error_on_first_token(node, top_msg)
                            set has_error: true
                        }
                        var report_es_target false
                        if Checker.module_kind_reaches_the_node_label(module_kind)
                        {
                            if implied_node_format = ModuleKindCommonJS
                            {
                                this.grammar_error_on_first_token(node, DiagThe_current_file_is_a_CommonJS_module_and_cannot_use_await_at_the_top_level)
                                set has_error: true
                            }
                            else
                            {
                                if language_version < ScriptTargetES2017
                                    set report_es_target: true
                            }
                        }
                        else
                        {
                            if Checker.module_kind_reaches_the_es_label(module_kind)
                            {
                                if language_version < ScriptTargetES2017
                                    set report_es_target: true
                            }
                            else
                                set report_es_target: true
                        }
                        if report_es_target
                        {
                            var es_msg DiagTop_level_await_using_statements_are_only_allowed_when_the_module_option_is_set_to_es2022_esnext_system_node16_node18_node20_nodenext_or_preserve_and_the_target_option_is_set_to_es2017_or_higher
                            if is_await_expression
                                set es_msg: DiagTop_level_await_expressions_are_only_allowed_when_the_module_option_is_set_to_es2022_esnext_system_node16_node18_node20_nodenext_or_preserve_and_the_target_option_is_set_to_es2017_or_higher
                            this.grammar_error_on_first_token(node, es_msg)
                            set has_error: true
                        }
                    }
                }
                else
                {
                    ; "use of 'await' in non-async function"
                    if this.has_parse_diagnostics_of(node) = false
                    {
                        var async_msg DiagX_await_using_statements_are_only_allowed_within_async_functions_and_at_the_top_levels_of_modules
                        if is_await_expression
                            set async_msg: DiagX_await_expressions_are_only_allowed_within_async_functions_and_at_the_top_levels_of_modules
                        let async_mark this.diagnostic_mark()
                        this.grammar_error_on_first_token(node, async_msg)
                        if container <> null
                        {
                            let ct container as ref[AstNode]
                            if (AstNode.kind_of(ct) <> KindConstructor) and (b.has_syntactic_modifier(ct, ModifierFlagsAsync) = false)
                                this.related_info_since(async_mark, ct, DiagDid_you_mean_to_mark_this_function_as_async)
                        }
                        set has_error: true
                    }
                }
            }
        }
        ; ★The tail is the ONE report the reference guards on the await EXPRESSION
        ; rather than forking the message: an `await using` declaration cannot stand
        ; in a parameter initializer at all.
        if is_await_expression
        {
            if Checker.is_in_parameter_initializer_before_containing_function(node)
            {
                this.error_on_node(node, DiagX_await_expressions_cannot_be_used_in_a_parameter_initializer)
                set has_error: true
            }
        }
        has_error
    }

    ; checkAsyncFunctionReturnType, whole — the report an `async function f(): T`
    ; owes when T is not the global `Promise`.
    ;
    ; ★★ ITS FIRST REPORT IS TS1064 AND IT IS A DIFFERENT QUESTION FROM THE AWAITED
    ; ONE: the annotation must be a REFERENCE TO THE GLOBAL Promise, not merely
    ; promise-LIKE, so `async function f(): PromiseLike<number> {}` is an error
    ; even though its awaited type resolves. ★The message names the awaited type as
    ; a suggestion (*Did you mean to write Promise<0>*), which this port does not
    ; render — the code and the span are what is compared.
    procedure check_async_function_return_type(this, node: ref[AstNode], return_type_node: ref[AstNode])
    {
        let mark this.unported_mark()
        let return_type this.get_type_from_type_node(return_type_node)
        if this.unported_mark() <> mark
            return
        if return_type = null
            return
        let rt return_type as ref[Type]
        if this.is_error_type(rt)
            return
        this.report_checked_global_type("Promise", 1)
        let g this.get_global_promise_type()
        if this.unported_mark() <> mark
            return
        var global_present false
        if g <> null
        {
            if (g as ref[Type]) <> empty_generic_type
                set global_present: true
        }
        if global_present
        {
            if Checker.is_reference_to_type(rt, g) = false
            {
                ; "The promise type was not a valid type reference to the global
                ; promise type, so we report an error and return the unknown type."
                ; ★★★The note that stood here read *the suggested type is computed
                ; upstream only to be printed, and the print is what this port does
                ; not have — so it is not asked*. Slice 189 is what retires it: the
                ; awaited type is ASKED for, and naming it is a walk with effects —
                ; see name_type_for_message.
                let awaited this.get_awaited_type_no_alias(rt)
                var promise_arg String("")
                if awaited <> null
                    set promise_arg: this.type_arg(awaited)
                else
                    set promise_arg: this.type_arg(void_type)
                this.error_on_node(return_type_node, DiagThe_return_type_of_an_async_function_or_method_must_be_the_global_Promise_T_type_Did_you_mean_to_write_Promise_0, promise_arg)
                return
            }
        }
        this.check_awaited_type(rt, false, node, DiagThe_return_type_of_an_async_function_must_either_be_a_valid_promise_or_must_not_contain_a_callable_then_member)
    }

    ; expressionResultIsUnused — *is this expression's value thrown away?* The loop
    ; walks OUT through parenthesized expressions and through the right side of a
    ; comma, and answers true at an expression statement, a `void` operand, and a
    ; `for` loop's initializer or incrementor.
    ;
    ; ★★ THE COMMA IS THE ONE ARM THAT IS NOT A SIMPLE PARENT TEST: the LEFT side of
    ; a comma is always unused, and the right side is unused exactly when the comma
    ; itself is — which is why the walk continues rather than answering.
    function expression_result_is_unused(node_in: ref[AstNode]) returns bool
    {
        var node: ref[AstNode] node_in
        while true
        {
            let parent_opt AstNode.parent_node_of(node)
            if parent_opt = null
                return false
            let parent parent_opt as ref[AstNode]
            let pk AstNode.kind_of(parent)
            ; "walk up parenthesized expressions, but keep a pointer to the top-most
            ; parenthesized expression"
            if pk = KindParenthesizedExpression
            {
                set node: parent
                continue
            }
            if pk = KindExpressionStatement
                return true
            if pk = KindVoidExpression
                return true
            if pk = KindForStatement
            {
                if AstNode.initializer_of(parent) = node
                    return true
                if AstNode.for_incrementor_of(parent) = node
                    return true
            }
            if pk = KindBinaryExpression
            {
                let op AstNode.binary_operator_token_of(parent)
                if Checker.kind_or_unknown(op) = KindCommaToken
                {
                    ; "left side of comma is always unused"
                    if AstNode.binary_left_of(parent) = node
                        return true
                    ; "right side of comma is unused if parent is unused"
                    set node: parent
                    continue
                }
            }
            return false
        }
        false
    }

    ; getContextualReturnType's two filterType predicates. ★Both carry the SAME
    ; escape clause — `t.flags&(AnyOrUnknown|Void|InstantiableNonPrimitive) != 0` —
    ; which is what keeps a `void`, an `any` or a bare type variable in the
    ; contextual union whether or not it reads as a generator or a promise.
    procedure filter_type_by_contextual_generator_return(this, t: ref[Type], function_flags: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            let keep this.contextual_generator_return_keeps(t, function_flags)
            if this.unported_mark() <> mark
                return null
            if keep
                return t
            return never_type
        }
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let kept &Array[ref[Type]?]^host()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let keep this.contextual_generator_return_keeps(row as ref[Type], function_flags)
            if this.unported_mark() <> mark
                return null
            if keep
                kept.add(row)
        }
        if (kept.get_length() as int) = n
            return t
        if kept.get_length() = 0
            return never_type
        this.get_union_type(kept)
    }

    procedure contextual_generator_return_keeps(this, t: ref[Type], function_flags: int) returns bool
    {
        if (t.flags & (TypeFlagsAnyOrUnknown | TypeFlagsVoid | TypeFlagsInstantiableNonPrimitive)) <> 0
            return true
        this.check_generator_instantiation_assignability_to_return_type(t, function_flags, null)
    }

    procedure filter_type_by_contextual_async_return(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            let keep this.contextual_async_return_keeps(t)
            if this.unported_mark() <> mark
                return null
            if keep
                return t
            return never_type
        }
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let kept &Array[ref[Type]?]^host()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let keep this.contextual_async_return_keeps(row as ref[Type])
            if this.unported_mark() <> mark
                return null
            if keep
                kept.add(row)
        }
        if (kept.get_length() as int) = n
            return t
        if kept.get_length() = 0
            return never_type
        this.get_union_type(kept)
    }

    procedure contextual_async_return_keeps(this, t: ref[Type]) returns bool
    {
        if (t.flags & (TypeFlagsAnyOrUnknown | TypeFlagsVoid | TypeFlagsInstantiableNonPrimitive)) <> 0
            return true
        let mark this.unported_mark()
        let awaited this.get_awaited_type_of_promise(t)
        if this.unported_mark() <> mark
            return false
        awaited <> null
    }

    ; shouldReportErrorsFromWideningWithContextualSignature, whole — the arm
    ; report_errors_from_widening has stopped at since slice 112.
    ;
    ; ★★ ITS THREE WideningKinds ASK THREE DIFFERENT QUESTIONS OF ONE SIGNATURE:
    ; a FunctionReturn unwraps the contextual return through the generator's return
    ; type or the promise's; a GeneratorYield and a GeneratorNext read the
    ; corresponding iteration type. The answer is then `isGenericType(returnType)`,
    ; i.e. *the contextual type says nothing concrete, so report the widening*.
    procedure should_report_errors_from_widening_with_contextual_signature(this, declaration: ref[AstNode], widening_kind: int) returns bool
    {
        let mark this.unported_mark()
        let signature this.get_contextual_signature_for_function_like_declaration(declaration)
        if this.unported_mark() <> mark
            return false
        if signature = null
            return true
        var return_type this.get_return_type_of_signature(signature as ref[Signature])
        if this.unported_mark() <> mark
            return false
        if return_type = null
            return false
        let flags b.get_function_flags(declaration)
        let is_async (flags & FunctionFlagsAsync) <> 0
        if widening_kind = WideningKindFunctionReturn
        {
            if (flags & FunctionFlagsGenerator) <> 0
            {
                let rit this.get_iteration_type_of_generator_function_return_type(IterationTypeKindReturn, return_type as ref[Type], is_async)
                if this.unported_mark() <> mark
                    return false
                if rit <> null
                    set return_type: rit
            }
            else
            {
                if is_async
                {
                    let awaited this.get_awaited_type_no_alias(return_type as ref[Type])
                    if this.unported_mark() <> mark
                        return false
                    if awaited <> null
                        set return_type: awaited
                }
            }
        }
        if widening_kind = WideningKindGeneratorYield
        {
            let yit this.get_iteration_type_of_generator_function_return_type(IterationTypeKindYield, return_type as ref[Type], is_async)
            if this.unported_mark() <> mark
                return false
            if yit = null
                return true
            set return_type: yit
        }
        if widening_kind = WideningKindGeneratorNext
        {
            let nit this.get_iteration_type_of_generator_function_return_type(IterationTypeKindNext, return_type as ref[Type], is_async)
            if this.unported_mark() <> mark
                return false
            if nit = null
                return true
            set return_type: nit
        }
        let generic this.is_generic_type(return_type as ref[Type])
        if this.unported_mark() <> mark
            return false
        generic
    }
    ; ── the diagnostics, as GetDiagnosticsForFile answers them ──────────────
    ;
    ; ★★★ AND THE ONE THING THIS SLICE OWES THE NEXT ONE IS A SORT IT DOES NOT
    ; WRITE. GetDiagnosticsForFile sorts the collection before answering, so a port
    ; that emitted in DISCOVERY order would differ from the reference as a wrong
    ; SPAN on every line after the first — a difference that reads as a checker
    ; defect and is a missing sort. (tests/checktypes.py checks that invariant on
    ; the oracle's side for exactly this reason, and slice 46's c2 proves it can
    ; fail: 213 findings.) It is NOT written here because no arm of this slice
    ; produces a diagnostic — the list is empty in every unit — and a sort with
    ; nothing to sort is machinery no instrument can reach, which is the shape
    ; §3.5be argues against. The FIRST arm that reports owes it, and what it owes
    ; is written out so it is a transcription rather than a rediscovery:
    ;
    ;   CompareDiagnostics is path, then pos, then end, then code, then the message
    ;   ARGUMENTS and the message chain, and the sort is STABLE. The path is one
    ;   file here. The arguments cannot be compared — this port carries no message
    ;   text — and they cannot MATTER either: two diagnostics agreeing on pos, end
    ;   and code are the same three numbers in the dump, so any order between them
    ;   prints identically. That is the argument for stopping at the code, and it
    ;   is an argument rather than an approximation.
    function diagnostic_count(c: ref[Checker]) returns int
        c.diagnostics.length()

    procedure diagnostic_at(c: ref[Checker], i: int, out_pos: ref[int], out_end: ref[int], out_code: ref[int]) returns bool
        c.diagnostics.at(i, out_pos, out_end, out_code)

    ; the message arguments of the i-th diagnostic, as the dump prints them
    procedure append_diagnostic_args_at(c: ref[Checker], i: int, out: ref[StringBuilder])
        c.diagnostics.append_args_at(i, out)

    ; the program file a diagnostic lies in (slice 269), -1 outside the program
    function diagnostic_file_at(c: ref[Checker], i: int) returns int
        c.diagnostics.file_tag_at(i)

    ; the collection emptied between two files of a program (the dump's per-file
    ; diagnostics, slice 263; the reference collects per file)
    procedure truncate_diagnostics(c: ref[Checker])
        c.diagnostics.truncate(0)

    function global_diagnostic_code_count(c: ref[Checker]) returns int
        c.global_diagnostic_codes.get_length() as int

    function global_diagnostic_code_at(c: ref[Checker], i: int) returns int
        c.global_diagnostic_codes[i as size_t]

    procedure append_global_diagnostic_args_at(c: ref[Checker], i: int, out: ref[StringBuilder])
        c.global_diagnostic_list.append_args_at(i, out)

    ; the i-th diagnostic's message chain, one `M` line per chain line
    procedure append_diagnostic_chain_at(c: ref[Checker], i: int, out: ref[StringBuilder])
        c.diagnostics.append_chain_lines_at(i, out)

    procedure append_global_diagnostic_chain_at(c: ref[Checker], i: int, out: ref[StringBuilder])
        c.global_diagnostic_list.append_chain_lines_at(i, out)

    ; the i-th diagnostic's related information, one `L` line each (its file's name)
    procedure append_diagnostic_related_at(c: ref[Checker], i: int, out: ref[StringBuilder])
        c.append_related_lines(c.diagnostics as ref[DiagnosticList], i, out)

    procedure append_global_diagnostic_related_at(c: ref[Checker], i: int, out: ref[StringBuilder])
        c.append_related_lines(c.global_diagnostic_list, i, out)

    procedure append_related_lines(this, list: ref[DiagnosticList], i: int, out: ref[StringBuilder])
    {
        let r list.related_at(i)
        if r = null
            return
        let infos r as ref[Array[RelatedInfo]]
        var k 0
        while k < (infos.get_length() as int)
        {
            let info infos[k as size_t]
            set k: k + 1
            var path: Slice[char] ""
            if info.file <> null
            {
                ; the program's own name for its file (a program unit's binder keeps a
                ; name its loader does not pin); a lib's binder name otherwise
                var index 0 - 1
                if program <> null
                    set index: (program as ref[ProgramFiles]).index_of_file(info.file)
                if index >= 0
                    set path: (program as ref[ProgramFiles]).path_at(index)
                else
                {
                    let fb this.binder_of_node(info.file)
                    set path: fb.file_name
                }
            }
            DiagnosticList.append_related_line(info, path, out)
        }
    }

    ; createDiagnosticForNode's range in the node's own file, a lib file's included
    procedure related_range_of(this, n: ref[AstNode], out_start: ref[int], out_end: ref[int]) returns bool
    {
        if this.program_index_of_node(n) < 0
        {
            if this.node_is_in_lib(n)
            {
                let eb this.binder_of_node(n)
                return eb.error_range_for_node_on(this.scanner_for(eb), null, n, out_start, out_end)
            }
        }
        this.error_range_in_own_file(n, out_start, out_end)
    }

    ; AddRelatedInfo(createDiagnosticForNode(node, code, args)) on the entry at `index`
    procedure related_info_at(this, index: int, n: ref[AstNode]?, code: int, args: ref[Array[String]]?)
    {
        let list diagnostics as ref[DiagnosticList]
        if (n = null) or (index < 0) or (index >= list.length())
            return
        var start 0
        var stop 0
        if this.related_range_of(n as ref[AstNode], &start, &stop) = false
            return
        list.add_related_at(index, Checker.source_file_of_node(n), start, stop, code, args)
    }

    ; addTypeOnlyDeclarationRelatedInfo on the diagnostic reported since `mark`
    procedure add_type_only_declaration_related_info(this, mark: int, type_only_declaration: ref[AstNode]?, name: String)
    {
        if type_only_declaration = null
            return
        let k AstNode.kind_of(type_only_declaration)
        var code DiagX_0_was_imported_here
        if (k = KindExportSpecifier) or (k = KindExportDeclaration) or (k = KindNamespaceExport)
            set code: DiagX_0_was_exported_here
        this.related_info_since(mark, type_only_declaration, code, name)
    }

    procedure message_args1(this, a0: String) returns ref[Array[String]]
    {
        let args this.message_args()
        args.add(a0)
        args
    }

    ; the diagnostic count before a report, for related_info_since
    function diagnostic_mark(this) returns int
        (diagnostics as ref[DiagnosticList]).length()

    ; AddRelatedInfo(createDiagnosticForNode(node, code, args)) on the diagnostic the
    ; report since `mark` added (nothing when it added none)
    procedure related_info_since(this, mark: int, n: ref[AstNode]?, code: int, args: ref[Array[String]]?)
    {
        let list diagnostics as ref[DiagnosticList]
        if (n = null) or (list.length() <= mark)
            return
        var start 0
        var stop 0
        if this.related_range_of(n as ref[AstNode], &start, &stop) = false
            return
        list.add_related_at(list.length() - 1, Checker.source_file_of_node(n), start, stop, code, args)
    }

    procedure related_info_since(this, mark: int, n: ref[AstNode]?, code: int)
        this.related_info_since(mark, n, code, null)

    procedure related_info_since(this, mark: int, n: ref[AstNode]?, code: int, a0: String)
    {
        let args this.message_args()
        args.add(a0)
        this.related_info_since(mark, n, code, args)
    }

    procedure related_info_since(this, mark: int, n: ref[AstNode]?, code: int, a0: String, a1: String)
    {
        let args this.message_args()
        args.add(a0)
        args.add(a1)
        this.related_info_since(mark, n, code, args)
    }
}
