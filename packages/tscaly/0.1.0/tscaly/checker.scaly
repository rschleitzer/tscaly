    ; ── THE TAGGED TEMPLATE, slice 138 ──────────────────────────────────────
    ;
    ; resolveTaggedTemplateExpression. ★★★It is an ordinary CALL whose argument
    ; list is built rather than written — see get_effective_call_arguments' arm —
    ; so everything below the tag's own type is resolve_call's work.
    ;
    ; ★★ THE ARRAY-LITERAL ARM IS A SUGGESTION AND NOT A TYPE ERROR: `[f`` ``g`` ``]`
    ; parses as ONE tagged template whose tag is another one, and the reference
    ; guesses the author meant a comma (TS2796) rather than reporting that the
    ; first template is not callable.
    procedure resolve_tagged_template_expression(this, node: ref[AstNode], check_mode: int) returns ref[Signature]?
    {
        let mark this.unported_mark()
        let tag_row AstNode.tagged_template_tag_of(node)
        if tag_row = null
            return null
        let tag tag_row as ref[AstNode]
        let tag_type this.check_expression(tag)
        if this.unported_mark() <> mark
            return null
        if tag_type = null
            return null
        let apparent_type this.get_apparent_type(tag_type as ref[Type])
        if this.unported_mark() <> mark
            return null
        if apparent_type = null
            return null
        if this.is_error_type(apparent_type as ref[Type])
            return this.resolve_error_call(node)
        let call_signatures this.get_signatures_of_type(apparent_type as ref[Type], SignatureKindCall)
        if this.unported_mark() <> mark
            return null
        let construct_signatures this.get_signatures_of_type(apparent_type as ref[Type], SignatureKindConstruct)
        if this.unported_mark() <> mark
            return null
        let num_call Checker.sig_count(call_signatures)
        if this.is_untyped_function_call(tag_type as ref[Type], apparent_type as ref[Type], num_call, Checker.sig_count(construct_signatures))
            return this.resolve_untyped_call(node)
        if this.unported_mark() <> mark
            return null
