    ; checkAndReportErrorForMissingPrefix, whole.
    ;
    ; ★ The loop's guard is `location.Parent != nil`, so it stops AT the source
    ; file rather than one step past it; the reference reads the parent inside the
    ; body, which is why the test is on the parent and not on the location.
    procedure check_and_report_error_for_missing_prefix(this, error_location: ref[AstNode]?, nd: Slice[char]) returns bool
    {
        if error_location = null
            return false
        let el error_location as ref[AstNode]
        if AstNode.kind_of(el) <> KindIdentifier
            return false
        if Checker.identifier_text_equals(el, nd) = false
            return false
        if Checker.is_type_reference_identifier(el)
            return false
        if Checker.is_in_type_query(el)
            return false
        let container Binder.get_this_container(el, false, false)
        if container = null
            return false
        var loc container
        while loc <> null
        {
            let l loc as ref[AstNode]
            let parent AstNode.parent_node_of(l)
            if parent = null
                return false
            let pn parent as ref[AstNode]
            if Parser.is_class_like_node(pn)
            {
                let class_symbol this.get_symbol_of_declaration(pn)
                if class_symbol = null
                    return false
                let cs class_symbol as ref[Symbol]
                let mark this.unported_mark()
                let constructor_type this.get_type_of_symbol(cs)
                if this.unported_mark() <> mark
                    return true
                if constructor_type <> null
                {
                    if this.get_property_of_type(constructor_type as ref[Type], nd) <> null
                    {
                        this.error_on_node(el, DiagCannot_find_name_0_Did_you_mean_the_static_member_1_0, Checker.arg_text(nd), this.symbol_arg(cs))
                        return true
                    }
                }
                if l = (container as ref[AstNode])
                {
                    if b.is_static(l) = false
                    {
                        let declared this.get_declared_type_of_symbol(cs)
                        if this.unported_mark() <> mark
                            return true
                        if declared <> null
                        {
                            let instance_type Checker.this_type_of(declared as ref[Type])
                            if instance_type <> null
                            {
                                if this.get_property_of_type(instance_type as ref[Type], nd) <> null
                                {
                                    this.error_on_node(el, DiagCannot_find_name_0_Did_you_mean_the_instance_member_this_0, Checker.arg_text(nd))
                                    return true
                                }
                            }
                        }
                    }
                }
            }
            set loc: parent
        }
        false
    }

    ; getEntityNameForExtendingInterface, whole. Its recursion is a walk UP, so it
    ; is written as one.
    function get_entity_name_for_extending_interface(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var cur node
        while cur <> null
        {
            let c cur as ref[AstNode]
            let k AstNode.kind_of(c)
            if k = KindExpressionWithTypeArguments
            {
                let e AstNode.expression_of(c)
                if Parser.is_entity_name_expression(e)
                    return e
                return null
            }
            if k <> KindIdentifier
            {
                if k <> KindPropertyAccessExpression
                    return null
            }
            set cur: AstNode.parent_node_of(c)
        }
        null
    }

    ; checkAndReportErrorForExtendingInterface, whole.
    procedure check_and_report_error_for_extending_interface(this, error_location: ref[AstNode]?) returns bool
    {
        let expression Checker.get_entity_name_for_extending_interface(error_location)
        if expression = null
            return false
        let mark this.unported_mark()
        let sym this.resolve_entity_name(expression as ref[AstNode], SymbolFlagsInterface, true, false, null)
        if this.unported_mark() <> mark
            return true
        if sym = null
            return false
        this.error_on_node_or_null(error_location, DiagCannot_extend_an_interface_0_Did_you_mean_implements, this.node_text_arg(expression))
        true
    }

    ; checkAndReportErrorForUsingTypeAsNamespace, whole. The reference's
    ; `debug.Assert` on the qualified name's left is dropped with the rest of them.
    procedure check_and_report_error_for_using_type_as_namespace(this, error_location: ref[AstNode]?, nd: Slice[char], meaning: int) returns bool
    {
        if meaning <> SymbolFlagsNamespace
            return false
        if error_location = null
            return false
        let el error_location as ref[AstNode]
        let mark this.unported_mark()
        let symbol this.resolve_symbol(this.resolve_name(el, nd, SymbolFlagsType & ~SymbolFlagsNamespace, 0, false, false))
        if this.unported_mark() <> mark
            return true
        if symbol = null
            return false
        let sy symbol as ref[Symbol]
        let parent AstNode.parent_node_of(el)
        if parent <> null
        {
            let pn parent as ref[AstNode]
            if AstNode.kind_of(pn) = KindQualifiedName
            {
                let right AstNode.qualified_right_of(pn)
                let declared this.get_declared_type_of_symbol(sy)
                if this.unported_mark() <> mark
                    return true
                if declared <> null
                {
                    let prop this.get_property_of_type(declared as ref[Type], AstNode.identifier_text_of(right))
                    if this.unported_mark() <> mark
                        return true
                    if prop <> null
                    {
                        this.error_on_node(pn, DiagCannot_access_0_1_because_0_is_a_type_but_not_a_namespace_Did_you_mean_to_retrieve_the_type_of_the_property_1_in_0_with_0_1, Checker.arg_text(nd), Checker.arg_text(AstNode.identifier_text_of(right)))
                        return true
                    }
                }
            }
        }
        this.error_on_node(el, DiagX_0_only_refers_to_a_type_but_is_being_used_as_a_namespace_here, Checker.arg_text(nd))
        true
    }

    ; checkAndReportErrorForExportingPrimitiveType, whole.
    procedure check_and_report_error_for_exporting_primitive_type(this, error_location: ref[AstNode]?, nd: Slice[char]) returns bool
    {
        if error_location = null
            return false
        if Checker.is_primitive_type_name(nd) = false
            return false
        let parent AstNode.parent_node_of(error_location as ref[AstNode])
        if parent = null
            return false
        if AstNode.kind_of(parent as ref[AstNode]) <> KindExportSpecifier
            return false
        this.error_on_node(error_location as ref[AstNode], DiagCannot_export_0_Only_local_declarations_can_be_exported_from_a_module, Checker.arg_text(nd))
        true
    }

    ; checkAndReportErrorForUsingNamespaceAsTypeOrValue, whole.
    procedure check_and_report_error_for_using_namespace_as_type_or_value(this, error_location: ref[AstNode]?, nd: Slice[char], meaning: int) returns bool
    {
        if error_location = null
            return false
        let el error_location as ref[AstNode]
        let mark this.unported_mark()
        if (meaning & (SymbolFlagsValue & ~SymbolFlagsType)) <> 0
        {
            let symbol this.resolve_symbol(this.resolve_name(el, nd, SymbolFlagsNamespaceModule, 0, false, false))
            if this.unported_mark() <> mark
                return true
            if symbol <> null
            {
                this.error_on_node(el, DiagCannot_use_namespace_0_as_a_value, Checker.arg_text(nd))
                return true
            }
            return false
        }
        if (meaning & (SymbolFlagsType & ~SymbolFlagsValue)) <> 0
        {
            let symbol this.resolve_symbol(this.resolve_name(el, nd, SymbolFlagsModule, 0, false, false))
            if this.unported_mark() <> mark
                return true
            if symbol <> null
            {
                this.error_on_node(el, DiagCannot_use_namespace_0_as_a_type, Checker.arg_text(nd))
                return true
            }
        }
        false
    }

    ; maybeMappedType, whole. The walk up is the reference's `for` with its own
    ; break condition; a null parent ends it the way a SourceFile does.
    procedure maybe_mapped_type(this, node: ref[AstNode], symbol: ref[Symbol]) returns bool
    {
        var cur AstNode.parent_node_of(node)
        while cur <> null
        {
            let c cur as ref[AstNode]
            let k AstNode.kind_of(c)
            if k <> KindComputedPropertyName
            {
                if k <> KindPropertySignature
                    break
            }
            set cur: AstNode.parent_node_of(c)
        }
        if cur = null
            return false
        let n cur as ref[AstNode]
        if AstNode.kind_of(n) <> KindTypeLiteral
            return false
        if AstNode.list_count(AstNode.member_list_of(n)) <> 1
            return false
        let mark this.unported_mark()
        let t this.get_declared_type_of_symbol(symbol)
        if this.unported_mark() <> mark
            return false
        if t = null
            return false
        let ty t as ref[Type]
        if (ty.flags & TypeFlagsUnion) = 0
            return false
        this.all_types_assignable_to_kind_ex(ty, TypeFlagsStringOrNumberLiteral, true)
    }

    ; checkAndReportErrorForUsingTypeAsValue, whole.
    procedure check_and_report_error_for_using_type_as_value(this, error_location: ref[AstNode]?, nd: Slice[char], meaning: int) returns bool
    {
        if (meaning & SymbolFlagsValue) = 0
            return false
        if error_location = null
            return false
        let el error_location as ref[AstNode]
        if Checker.is_primitive_type_name(nd)
        {
            var grandparent: ref[AstNode]? null
            let parent AstNode.parent_node_of(el)
            if parent <> null
                set grandparent: AstNode.parent_node_of(parent as ref[AstNode])
            var in_heritage false
            if grandparent <> null
            {
                let gp grandparent as ref[AstNode]
                if AstNode.parent_node_of(gp) <> null
                {
                    if AstNode.kind_of(gp) = KindHeritageClause
                        set in_heritage: true
                }
            }
            if in_heritage
            {
                let gp grandparent as ref[AstNode]
                let heritage_kind AstNode.heritage_clause_token_of(gp)
                let container AstNode.parent_node_of(gp)
                let container_kind AstNode.kind_of(container as ref[AstNode])
                if container_kind = KindInterfaceDeclaration
                {
                    if heritage_kind = KindExtendsKeyword
                        this.error_on_node(el, DiagAn_interface_cannot_extend_a_primitive_type_like_0_It_can_only_extend_other_named_object_types, Checker.arg_text(nd))
                }
                if Parser.is_class_like_node(container)
                {
                    if heritage_kind = KindExtendsKeyword
                        this.error_on_node(el, DiagA_class_cannot_extend_a_primitive_type_like_0_Classes_can_only_extend_constructable_values, Checker.arg_text(nd))
                    if heritage_kind = KindImplementsKeyword
                        this.error_on_node(el, DiagA_class_cannot_implement_a_primitive_type_like_0_It_can_only_implement_other_named_object_types, Checker.arg_text(nd))
                }
                return true
            }
            this.error_on_node(el, DiagX_0_only_refers_to_a_type_but_is_being_used_as_a_value_here, Checker.arg_text(nd))
            return true
        }
        let mark this.unported_mark()
        let symbol this.resolve_symbol(this.resolve_name(el, nd, SymbolFlagsType & ~SymbolFlagsValue, 0, false, false))
        if this.unported_mark() <> mark
            return true
        if symbol = null
            return false
        let sy symbol as ref[Symbol]
        let all_flags this.get_symbol_flags(sy)
        if this.unported_mark() <> mark
            return true
        if (all_flags & SymbolFlagsValue) <> 0
            return false
        if Checker.is_es2015_or_later_constructor_name(nd)
        {
            this.error_on_node(el, DiagX_0_only_refers_to_a_type_but_is_being_used_as_a_value_here_Do_you_need_to_change_your_target_library_Try_changing_the_lib_compiler_option_to_es2015_or_later, Checker.arg_text(nd))
            return true
        }
        let mapped this.maybe_mapped_type(el, sy)
        if this.unported_mark() <> mark
            return true
        if mapped
        {
            if Checker.name_bytes_are(nd, "K")
                this.error_on_node(el, DiagX_0_only_refers_to_a_type_but_is_being_used_as_a_value_here_Did_you_mean_to_use_1_in_0, Checker.arg_text(nd), "P")
            else
                this.error_on_node(el, DiagX_0_only_refers_to_a_type_but_is_being_used_as_a_value_here_Did_you_mean_to_use_1_in_0, Checker.arg_text(nd), "K")
            return true
        }
        this.error_on_node(el, DiagX_0_only_refers_to_a_type_but_is_being_used_as_a_value_here, Checker.arg_text(nd))
        true
    }

    ; checkAndReportErrorForUsingValueAsType, whole.
    procedure check_and_report_error_for_using_value_as_type(this, error_location: ref[AstNode]?, nd: Slice[char], meaning: int) returns bool
    {
        if (meaning & (SymbolFlagsType & ~SymbolFlagsNamespace)) = 0
            return false
        if error_location = null
            return false
        let el error_location as ref[AstNode]
        let mark this.unported_mark()
        let symbol this.resolve_symbol(this.resolve_name(el, nd, (~SymbolFlagsType) & SymbolFlagsValue, 0, false, false))
        if this.unported_mark() <> mark
            return true
        if symbol = null
            return false
        if (Symbol.flags_of(symbol as ref[Symbol]) & SymbolFlagsNamespace) <> 0
            return false
        this.error_on_node(el, DiagX_0_refers_to_a_value_but_is_being_used_as_a_type_here_Did_you_mean_typeof_0, Checker.arg_text(nd))
        true
    }

    ; ── the spelling suggester ───────────────────────────────────────────────
    ;
    ; getSuggestionForSymbolNameLookup, getSpellingSuggestionForName and
    ; core.GetSpellingSuggestion with its levenshteinWithMax, in one place because
    ; the middle one is three lines of plumbing.
    ;
    ; ★★★ THE ARITHMETIC IS IN TENTHS AND THAT IS A PORT, NOT AN APPROXIMATION.
    ; Upstream's distances are float64 built from three increments — 0.1 for a
    ; case-only substitution, 1 for an insertion or a deletion, 2 for a real
    ; substitution — and the cutoff is `floor(len*0.4)+0.9`. Every one of those is
    ; a multiple of 0.1, so multiplying the whole system by ten makes it exact
    ; INTEGER arithmetic and removes the only floating-point code this port would
    ; own. `float64(len)*0.4` floors to `(len*4)/10` and `float64(len)*0.34`
    ; truncates to `(len*34)/100`: 0.4 and 0.34 are both rounded UP in binary, so
    ; the float product is never below the exact one and the two agree everywhere.
    ; ★The `big` sentinel is `max+1` rather than `max+0.01` for the same reason it
    ; exists at all — it only has to be strictly greater than the cutoff, and no
    ; path through it can produce a result at or below the cutoff.
    ;
    ; ★★★ IT WAS ASCII-ONLY UNDER A STOP UNTIL SLICE 199, AND THE STOP WAS ABOUT A
    ; TABLE THIS PORT COULD SIMPLY HAVE. What stood here read *upstream compares
    ; RUNES and folds with unicode.ToLower; both names here are compared byte by
    ; byte* — true, and the missing half is two Go functions whose tables are
    ; generated in UnicodeCase.scaly now. Both names are decoded to RUNES here and
    ; the folds are Go's own, so a Greek, Myanmar or supplementary-plane identifier
    ; is measured rather than reported.
    ;
    ; ★★★ ONE ASYMMETRY IS UPSTREAM'S AND IS REPRODUCED DELIBERATELY: the LENGTH
    ; tests read `len(candidateName)` — the Go string's BYTE count — against
    ; `len(runeName)`, the name's RUNE count. `GetSpellingSuggestion` converts only
    ; the name up front and asks `len()` of the candidate's string, so a
    ; multi-byte candidate is measured as longer than it reads. It decides which
    ; candidates are considered at all and which take the `< 3` fold path, so a
    ; port that "fixed" it would answer differently.

    ; strings.EqualFold, over two byte slices decoded as they are walked. ★The
    ; ASCII fast path is upstream's own and is not an optimisation here either: it
    ; is what makes `K` and `k` fold equal WITHOUT consulting the orbit, which
    ; would take `k` to KELVIN SIGN first.
    function names_equal_fold(a: Slice[char], b: Slice[char]) returns bool
    {
        var i 0
        var j 0
        while (i < a.length) and (j < b.length)
        {
            var sr Scanner.utf8_decode_in(a, a.length, i)
            set i: i + Scanner.utf8_size_in(a, a.length, i)
            var tr Scanner.utf8_decode_in(b, b.length, j)
            set j: j + Scanner.utf8_size_in(b, b.length, j)
            if sr = tr
                continue
            ; "Make sr < tr to simplify what follows."
            if tr < sr
            {
                let t sr
                set sr: tr
                set tr: t
            }
            if tr < 0x80
            {
                ; "ASCII only, sr/tr must be upper/lower case."
                if (sr >= 65) and (sr <= 90)
                {
                    if tr = (sr + 32)
                        continue
                }
                return false
            }
            ; "General case. SimpleFold(x) returns the next equivalent rune > x
            ; or wraps around to smaller values."
            var r unicode_simple_fold(sr)
            while (r <> sr) and (r < tr)
                set r: unicode_simple_fold(r)
            if r = tr
                continue
            return false
        }
        ; "One string is empty. Are both?"
        if i < a.length
            return false
        j >= b.length
    }

    ; The name decoded to runes — Go's `[]rune(s)`, whose invalid sequences each
    ; become one U+FFFD, which is what utf8_decode_in already answers.
    procedure name_runes(this, d: Slice[char]) returns ref[Vector[int]]
        Checker.name_runes_on(host, d)

    function name_runes_on(host: ref[Page], d: Slice[char]) returns ref[Vector[int]]
    {
        var count 0
        var p 0
        while p < d.length
        {
            set count: count + 1
            set p: p + Scanner.utf8_size_in(d, d.length, p)
        }
        let v Checker.levenshtein_row_on(host, count)
        var k 0
        set p: 0
        while p < d.length
        {
            v.put(k, Scanner.utf8_decode_in(d, d.length, p))
            set k: k + 1
            set p: p + Scanner.utf8_size_in(d, d.length, p)
        }
        v
    }

    ; levenshteinWithMax, in tenths over RUNES. Answers -1 for "worse than max",
    ; which is the reference's own out-of-band answer.
    ;
    ; ★★★ THE ARITHMETIC IS IN TENTHS AND THAT IS A PORT, NOT AN APPROXIMATION —
    ; the argument for it is in this family's header above.
    procedure levenshtein_with_max(this, s1: ref[Vector[int]], n1: int, s2: ref[Vector[int]], n2: int, max_value: int) returns int
        Checker.levenshtein_with_max_on(host, s1, n1, s2, n2, max_value)

    function levenshtein_with_max_on(host: ref[Page], s1: ref[Vector[int]], n1: int, s2: ref[Vector[int]], n2: int, max_value: int) returns int
    {
        let size n2 + 1
        let big max_value + 1
        let prev Checker.levenshtein_row_on(host, size)
        let cur Checker.levenshtein_row_on(host, size)
        var i 0
        while i < size
        {
            prev.put(i, i * 10)
            set i: i + 1
        }
        var row 1
        while row <= n1
        {
            let c1 s1[row - 1]
            ; `max(ceil(i - maxValue), 1)` and `min(floor(maxValue + i), len)`, in
            ; tenths: ceil(a/10) is (a + 9)/10 for a >= 0 and the whole quotient is
            ; negative-safe here because the loop clamps at 1.
            var min_j (row * 10) - max_value
            set min_j: (min_j + 9) / 10
            if min_j < 1
                set min_j: 1
            var max_j (max_value + row * 10) / 10
            if max_j > n2
                set max_j: n2
            var col_min row * 10
            cur.put(0, col_min)
            var j 1
            while j < min_j
            {
                cur.put(j, big)
                set j: j + 1
            }
            set j: min_j
            while j <= max_j
            {
                let c2 s2[j - 1]
                var substitution prev[j - 1] + 20
                if unicode_to_lower(c1) = unicode_to_lower(c2)
                    set substitution: prev[j - 1] + 1
                var dist prev[j - 1]
                if c1 <> c2
                {
                    set dist: prev[j] + 10
                    if cur[j - 1] + 10 < dist
                        set dist: cur[j - 1] + 10
                    if substitution < dist
                        set dist: substitution
                }
                cur.put(j, dist)
                if dist < col_min
                    set col_min: dist
                set j: j + 1
            }
            set j: max_j + 1
            while j <= n2
            {
                cur.put(j, big)
                set j: j + 1
            }
            if col_min > max_value
                return 0 - 1
            var k 0
            while k < size
            {
                let t prev[k]
                prev.put(k, cur[k])
                cur.put(k, t)
                set k: k + 1
            }
            set row: row + 1
        }
        let res prev[n2]
        if res > max_value
            return 0 - 1
        res
    }

    ; The scratch rows — the two levenshtein rows AND the rune buffers name_runes
    ; fills, which are the same allocation. `slices.Grow` upstream reuses one pool
    ; across calls; here a fresh Vector per call is the same answer, and the call
    ; is once per candidate of a name that was not found.
    ; ★A zero-length name asks for a zero-length Vector, which allocates nothing —
    ; the empty-init rule in the root CLAUDE.md — so no caller has to guard it.
    ; ★ The row is built HERE rather than inline in the loop above, and that is the
    ; standing generic-operator defect in the root CLAUDE.md: a generic concept's
    ; `operator []` loses its body when its receiver is CONSTRUCTED in the routine
    ; that subscripts it. A call result is not a construction, and `tools/opzero`
    ; is what says so rather than this comment.
    procedure levenshtein_row(this, size: int) returns ref[Vector[int]]
        Checker.levenshtein_row_on(host, size)

    function levenshtein_row_on(host: ref[Page], size: int) returns ref[Vector[int]]
    {
        return &Vector[int]^host(size as size_t)
    }

    ; getCandidateName, the closure GetSpellingSuggestion is handed. Answers false
    ; when the candidate has no usable name — which is upstream's empty string.
    procedure spelling_candidate_name(this, candidate: ref[Symbol], meaning: int, out_name: ref[Slice[char]]) returns bool
    {
        let d Symbol.name_of(candidate)
        let n Symbol.name_len_of(candidate)
        if n = 0
            return false
        if d.data = null
            return false
        let first (d[0] as int) & 255
        if first = 34
            return false
        if first = 254
            return false
        if (Symbol.flags_of(candidate) & meaning) <> 0
        {
            set out_name.data: d.data
            set out_name.length: n
            return true
        }
        if (Symbol.flags_of(candidate) & SymbolFlagsAlias) <> 0
        {
            let alias this.try_resolve_alias(candidate)
            if alias <> null
            {
                if (Symbol.flags_of(alias as ref[Symbol]) & meaning) <> 0
                {
                    set out_name.data: d.data
                    set out_name.length: n
                    return true
                }
            }
        }
        false
    }

    ; core.GetSpellingSuggestion, over a candidate list this port materialises.
    ; ★`rune_n` is `len(runeName)` and every `cd.length` below is
    ; `len(candidateName)` — upstream's own byte/rune asymmetry, argued at
    ; levenshtein_with_max.
    procedure get_spelling_suggestion_for_name(this, nd: Slice[char], candidates: ref[Array[ref[Symbol]?]], meaning: int) returns ref[Symbol]?
    {
        let rune_name this.name_runes(nd)
        let rune_n rune_name.length as int
        var maximum_length_difference (rune_n * 34) / 100
        if maximum_length_difference < 2
            set maximum_length_difference: 2
        var best_distance ((rune_n * 4) / 10) * 10 + 9
        var best: ref[Symbol]? null
        var has_best false
        let n candidates.get_length() as int
        var i 0
        while i < n
        {
            let c candidates[i]
            set i: i + 1
            if c = null
                continue
            let cand c as ref[Symbol]
            var cd Slice[char]()
            if this.spelling_candidate_name(cand, meaning, &cd) = false
                continue
            var max_len cd.length
            var min_len rune_n
            if rune_n > cd.length
            {
                set max_len: rune_n
                set min_len: cd.length
            }
            if (max_len - min_len) > maximum_length_difference
                continue
            if SymbolTable.names_equal(cd, nd)
                continue
            if cd.length < 3
            {
                if Checker.names_equal_fold(cd, nd) = false
                    continue
            }
            let rune_cand this.name_runes(cd)
            let distance this.levenshtein_with_max(rune_name, rune_n, rune_cand, rune_cand.length as int, best_distance)
            if distance < 0
                continue
            if distance < best_distance
            {
                set best_distance: distance
                set best: cand
                set has_best: true
            }
            else
            {
                if has_best = false
                {
                    set best: cand
                    set has_best: true
                }
                else
                {
                    if this.compare_symbols(cand, best) < 0
                        set best: cand
                }
            }
        }
        best
    }

    ; getSuggestedTypeForNonexistentStringLiteralType and the TYPE flavour of
    ; GetSpellingSuggestion — the reference's ONE generic function, whose symbol
    ; flavour stands above; §3.9's four-copies rule, a fifth time. The two differ in
    ; three places and nowhere else: the candidate's NAME is a string literal type's
    ; text rather than a symbol's, the tie-break is CompareTypes rather than
    ; compareSymbols, and there is no `meaning` filter.
    ;
    ; ★★★ IT IS PORTED BECAUSE THE INTERSECTION MADE IT REACHABLE, AND WITHOUT IT
    ; THE ANSWER IS A WRONG DIAGNOSTIC RATHER THAN A MISSING ONE. Slice 121 measured
    ; that at stage 2: `type T3 = T1 & ("string" | "boolean"); const t3: T3 =
    ; "strong"` used to stop on the intersection type node; with the intersection
    ; answering, the check completes and report_relation_error's `default` fork
    ; emits **TS2322 where the reference emits TS2820**, because the suggestion is
    ; what the reference consults FIRST in that fork. One unit of 18 436
    ; (`submodule_compiler_didYouMeanStringLiteral`).
    procedure get_suggested_type_for_nonexistent_string_literal_type(this, source: ref[Type], target: ref[Type]) returns ref[Type]?
    {
        let types Checker.union_types_of(target)
        if types = null
            return null
        let candidates types as ref[Array[ref[Type]?]]
        let nd Checker.literal_text_of(source)
        let nl Checker.literal_text_length_of(source)
        if nd.data = null
            return null
        let rune_name this.name_runes(nd)
        let rune_n rune_name.length as int
        var maximum_length_difference (rune_n * 34) / 100
        if maximum_length_difference < 2
            set maximum_length_difference: 2
        var best_distance ((rune_n * 4) / 10) * 10 + 9
        var best: ref[Type]? null
        var has_best false
        let n candidates.get_length() as int
        var i 0
        while i < n
        {
            let row candidates[i]
            set i: i + 1
            if row = null
                continue
            let cand row as ref[Type]
            ; `core.FilterSeq(target.Types(), StringLiteral)` — the candidate set.
            if (cand.flags & TypeFlagsStringLiteral) = 0
                continue
            let cd Checker.literal_text_of(cand)
            let cn Checker.literal_text_length_of(cand)
            if cd.data = null
                continue
            if cn = 0
                continue
            var max_len cn
            var min_len rune_n
            if rune_n > cn
            {
                set max_len: rune_n
                set min_len: cn
            }
            if (max_len - min_len) > maximum_length_difference
                continue
            if SymbolTable.names_equal(cd, nd)
                continue
            ; "Only consider candidates less than 3 characters long when they differ
            ; by case."
            if cn < 3
            {
                if Checker.names_equal_fold(cd, nd) = false
                    continue
            }
            let rune_cand this.name_runes(cd)
            let distance this.levenshtein_with_max(rune_name, rune_n, rune_cand, rune_cand.length as int, best_distance)
            if distance < 0
                continue
            if distance < best_distance
            {
                set best_distance: distance
                set best: cand
                set has_best: true
            }
            else
            {
                if has_best = false
                {
                    set best: cand
                    set has_best: true
                }
                else
                {
                    if this.compare_types(cand, best) < 0
                        set best: cand
                }
            }
        }
        best
    }

    ; getPrimitiveTypeAliasSuggestions, minted per call rather than once per
    ; process: it is six symbols, and a `sync.OnceValue` here would be a global
    ; where the reference has a package-level one.
    procedure add_primitive_type_alias_suggestions(this, symbols: ref[SymbolTable], into: ref[Array[ref[Symbol]?]])
    {
        this.add_primitive_alias(symbols, "String", "string", into)
        this.add_primitive_alias(symbols, "Number", "number", into)
        this.add_primitive_alias(symbols, "Boolean", "boolean", into)
        this.add_primitive_alias(symbols, "Object", "object", into)
        this.add_primitive_alias(symbols, "BigInt", "bigint", into)
        this.add_primitive_alias(symbols, "Symbol", "symbol", into)
    }

    procedure add_primitive_alias(this, symbols: ref[SymbolTable], builtin: Slice[char], primitive: Slice[char], into: ref[Array[ref[Symbol]?]])
    {
        var bd Slice[char]()
        set bd: Binder.internal_name_unprefixed(host, builtin)
        if SymbolTable.get(symbols, bd) = null
            return
        var pd Slice[char]()
        set pd: Binder.internal_name_unprefixed(host, primitive)
        let sym Symbol.create(host, SymbolFlagsTypeAlias | SymbolFlagsTransient, pd)
        into.add(sym)
    }

    ; getSuggestionForSymbolNameLookup, whole. It is the `Lookup` field the
    ; suggestion resolver differs in.
    procedure get_suggestion_for_symbol_name_lookup(this, symbols: ref[SymbolTable]?, nd: Slice[char], meaning: int) returns ref[Symbol]?
    {
        if symbols = null
            return null
        let found this.lookup_symbol(symbols, nd, meaning)
        if found <> null
            return found
        let table symbols as ref[SymbolTable]
        let cands &Array[ref[Symbol]?]^host()
        let n SymbolTable.length(table)
        var i 0
        while i < n
        {
            let sym SymbolTable.entry_symbol_at(table, i)
            if sym <> null
                cands.add(sym)
            set i: i + 1
        }
        if (meaning & SymbolFlagsGlobalLookup) <> 0
            this.add_primitive_type_alias_suggestions(table, cands)
        this.get_spelling_suggestion_for_name(nd, cands, meaning)
    }

    ; getSuggestedSymbolForNonexistentModule, whole. ★It is the ONE suggester that
    ; runs over a module's EXPORTS rather than over a scope chain or a type's
    ; properties, and `SymbolFlagsModuleMember` is what keeps a local out of the
    ; answer.
    procedure get_suggested_symbol_for_nonexistent_module(this, name: ref[AstNode], target_module: ref[Symbol]) returns ref[Symbol]?
    {
        let mark this.unported_mark()
        let exports this.get_exports_of_module(target_module)
        if this.unported_mark() <> mark
            return null
        if exports = null
            return null
        let table exports as ref[SymbolTable]
        let cands this.new_symbol_list()
        let n SymbolTable.length(table)
        var i 0
        while i < n
        {
            let sym SymbolTable.entry_symbol_at(table, i)
            if sym <> null
                cands.add(sym)
            set i: i + 1
        }
        this.get_spelling_suggestion_for_name(AstNode.identifier_text_of(name), cands, SymbolFlagsModuleMember)
    }

    ; getSuggestedSymbolForNonexistentSymbol, whole.
    procedure get_suggested_symbol_for_nonexistent_symbol(this, location: ref[AstNode]?, nd: Slice[char], meaning: int) returns ref[Symbol]?
        this.resolve_name_for_suggestion(location, nd, meaning)

    ; isUncheckedJSSuggestion at its ONE call site's arguments, `excludeClasses`
    ; false. Both `excludeClasses &&` conjuncts are then constantly false, so
    ; `suggestionHasNoExtendsOrDecorators` — and with it
    ; GetExtendsHeritageClauseElements and ClassOrConstructorParameterIsDecorated —
    ; has no reader and is left out (§3.5be) rather than written and never asked.
    ; ★`compilerOptions.CheckJs` is unset, so `IsUnknown()` is TRUE and the option
    ; is not a term this port can get wrong; it is written as the constant with the
    ; reading named, the way every other unset option in this file is.
    ; ★★★ `exclude_classes` WAS MISSING AND ONE OF THE TWO CALL SITES PASSES IT
    ; TRUE. Upstream's third parameter suppresses the unchecked-JS suggestion when
    ; the symbol is a plain undecorated class with no `extends` — the shape whose
    ; members really are unknown rather than merely unchecked — and the property
    ; access at check_property_access_expression_or_qualified_name is one of the
    ; two `true` sites. The port called it with the `false` behaviour at both.
    procedure is_unchecked_js_suggestion(this, node: ref[AstNode]?, suggestion: ref[Symbol]?, exclude_classes: bool) returns bool
    {
        let file Checker.source_file_of_node(node)
        if file = null
            return false
        let f file as ref[AstNode]
        if Checker.check_js_is_unset() = false
            return false
        if AstNode.check_js_directive_of(f) <> CheckJsDirectiveNone
            return false
        if Parser.is_in_js_file(f) = false
            return false
        if (AstNode.flags_of(f) & NodeFlagsJsonFile) <> 0
            return false
        var declaration_file: ref[AstNode]? null
        if suggestion <> null
        {
            let first Symbol.declaration_at(suggestion as ref[Symbol], 0)
            if first <> null
                set declaration_file: Checker.source_file_of_node(first)
        }
        if declaration_file <> null
        {
            let df declaration_file as ref[AstNode]
            if df <> f
            {
                if Checker.is_global_source_file(this.binder_of_node(df), df)
                    return false
            }
        }
        if exclude_classes = false
            return true
        ; `!(excludeClasses && suggestion != nil && Class && suggestionHasNoExtendsOrDecorators) &&
        ;  !(node != nil && excludeClasses && this.x && suggestionHasNoExtendsOrDecorators)` —
        ; both terms need the "no extends or decorators" answer TRUE (a plain class; a `this`
        ; access on anything plain). The port had each read inverted, so `this.c` inside a
        ; JS object-literal method stayed a suggestion where upstream reports (slice 207;
        ; `functionExpressionNames`).
        var plain true
        if suggestion <> null
            set plain: this.suggestion_has_no_extends_or_decorators(suggestion as ref[Symbol])
        if plain
        {
            if suggestion <> null
            {
                if (Symbol.flags_of(suggestion as ref[Symbol]) & SymbolFlagsClass) <> 0
                    return false
            }
            if Checker.is_this_property_access_node(node)
                return false
        }
        true
    }

    ; ── slice 174: the ast DECORATOR predicates ──────────────────────────────
    ;
    ; ast.NodeIsDecorated / NodeOrChildIsDecorated / ChildIsDecorated /
    ; ClassOrConstructorParameterIsDecorated. `use_legacy` is a PARAMETER as
    ; upstream has it: the caller here passes the LITERAL `false`, not
    ; `c.legacyDecorators`, and the two are different claims about one value.
    ;
    ; ★★★ TWO OF THE FIVE THE STOP'S NOTE NAMED WERE ALREADY IN THIS FILE, AND
    ; WRITING THEM AGAIN WOULD HAVE BEEN §3.5gg's SUBSTITUTE — found in this
    ; slice's own diff. NodeCanBeDecorated is `node_can_be_decorated` (slice 49,
    ; given the parameter and its last arm here); GetFirstConstructorWithBody is
    ; `find_constructor_declaration` (slice 94) — upstream carries those two names
    ; over ONE body, byte-identical and four lines apart.
    ; ast.HasDecorators. ★A NAME rather than the one-liner it wraps: this port had
    ; written the body out at both of upstream's other reachable call sites, and a
    ; third spelling is §3.5gg's substitute — invisible to every instrument here.
    function has_decorators(this, node: ref[AstNode]) returns bool
        b.has_syntactic_modifier(node, ModifierFlagsDecorator)

    function node_is_decorated(this, use_legacy: bool, node: ref[AstNode], parent: ref[AstNode]?, grandparent: ref[AstNode]?) returns bool
    {
        if this.has_decorators(node) = false
            return false
        this.node_can_be_decorated(use_legacy, node, parent, grandparent)
    }

    function node_or_child_is_decorated(this, use_legacy: bool, node: ref[AstNode], parent: ref[AstNode]?, grandparent: ref[AstNode]?) returns bool
    {
        if this.node_is_decorated(use_legacy, node, parent, grandparent)
            return true
        this.child_is_decorated(use_legacy, node, parent)
    }

    function child_is_decorated(this, use_legacy: bool, node: ref[AstNode], parent: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(node)
        var is_class k = KindClassDeclaration
        if k = KindClassExpression
            set is_class: true
        if is_class
        {
            let members AstNode.member_list_of(node)
            if members = null
                return false
            let ms members as ref[Array[ref[AstNode]?]]
            let n ms.get_length() as int
            var i 0
            while i < n
            {
                let m ms[i]
                set i: i + 1
                if m = null
                    continue
                if this.node_or_child_is_decorated(use_legacy, m as ref[AstNode], node, parent)
                    return true
            }
            return false
        }
        var is_param_bearing k = KindMethodDeclaration
        if k = KindSetAccessor
            set is_param_bearing: true
        if k = KindConstructor
            set is_param_bearing: true
        if is_param_bearing = false
            return false
        let parameters AstNode.parameters_of(node)
        if parameters = null
            return false
        let ps parameters as ref[Array[ref[AstNode]?]]
        let pn ps.get_length() as int
        var j 0
        while j < pn
        {
            let pnode ps[j]
            set j: j + 1
            if pnode = null
                continue
            if this.node_is_decorated(use_legacy, pnode as ref[AstNode], node, parent)
                return true
        }
        false
    }

    function class_or_constructor_parameter_is_decorated(this, use_legacy: bool, node: ref[AstNode]) returns bool
    {
        if this.node_is_decorated(use_legacy, node, null, null)
            return true
        let ctor Checker.find_constructor_declaration(node)
        if ctor = null
            return false
        this.child_is_decorated(use_legacy, ctor as ref[AstNode], node)
    }

    ; The last disjunct of upstream's `suggestionHasNoExtendsOrDecorators`.
    ;
    ; ★ THE DECORATOR TERM STOPPED HERE UNTIL SLICE 174, and its note named the
    ; four ast functions it was missing. They are the block above; the fifth it
    ; named, GetFirstConstructorWithBody, was already here under upstream's other
    ; name for the same body.
    function suggestion_has_no_extends_or_decorators(this, suggestion: ref[Symbol]) returns bool
    {
        let vd Symbol.value_declaration_of(suggestion)
        if vd = null
            return true
        let d vd as ref[AstNode]
        if Checker.is_class_like(d) = false
            return true
        let bases Checker.get_extends_heritage_clause_elements(d)
        if bases <> null
        {
            if (bases as ref[Array[ref[AstNode]?]]).get_length() <> 0
                return true
        }
        this.class_or_constructor_parameter_is_decorated(false, d)
    }

    ; `node != nil && IsPropertyAccessExpression(node) && node.Expression().Kind ==
    ; KindThisKeyword` — the third conjunct's own shape test.
    function is_this_property_access_node(node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if AstNode.kind_of(n) <> KindPropertyAccessExpression
            return false
        let e AstNode.expression_of(n)
        if e = null
            return false
        AstNode.kind_of(e as ref[AstNode]) = KindThisKeyword
    }

    ; onFailedToResolveSymbol, whole.
    ;
    ; ★★★ A FORK THAT STOPPED REPORTS NOTHING AND ENDS THE CHAIN. Every fork below
    ; asks questions — a declared type, a property of a type, a second name
    ; resolution — that can meet a construct this port does not implement, and the
    ; reference's `||` chain would then carry on to the NEXT fork. Carrying on is
    ; the inventing direction: the fork that stopped might have been the one that
    ; returned true. So the mark is read after each of them and a move ends the
    ; procedure with nothing said, which is a LOSS and a legal subsequence.
    procedure on_failed_to_resolve_symbol(this, error_location: ref[AstNode]?, nd: Slice[char], meaning: int, name_not_found_message: int)
    {
        ; ★★★ A CHAIN THAT DOES NOT REACH THE SOURCE FILE IS REPORTED RATHER THAN
        ; ANSWERED, AND SINCE SLICE 144 THE ROW IS EMPTY. It was the frontier's
        ; largest row for as long as `add_deep_clone_reparse` copied the ROOT of a
        ; reparsed type and SHARED its children (§3.5bf): a scope chain IS the
        ; parent chain, so `@template T` + `@typedef {T} Alias` resolved `T`
        ; through the SHARED identifier, whose parent still named the original
        ; JSDocTypeExpression — the walk went up the JSDoc comment instead of into
        ; the alias, where the type parameter is. The clone is the reference's deep
        ; one now and 19 units of the stage-1 corpus stopped hitting this.
        ;
        ; ★★★ IT STAYS, because the clone's arm set is bounded: a kind with no arm
        ; falls back to the root copy, and its shared child arrives here. So this
        ; is the report for a MISSING CLONE ARM — the tag is the one the frontier
        ; will name if a corpus meets a type node the clone does not rebuild.
        ;
        ; ★★★ THE TEST IS THE CHAIN'S TOP AND IT IS EXACT RATHER THAN A HEURISTIC:
        ; every node the reference resolves from is reachable from the SourceFile, so
        ; a chain that ends anywhere else is a node upstream never asked about. It is
        ; also the whole reason the lookup failed — a chain that never reaches the
        ; file cannot reach its locals or the globals table either.
        if Checker.source_file_of_node(error_location) = null
        {
            this.record_unported("jsdoc-reparse-shared-parent", meaning)
            return
        }
        if error_location <> null
        {
            let mark this.unported_mark()
            let parent AstNode.parent_node_of(error_location as ref[AstNode])
            if parent <> null
            {
                if AstNode.kind_of(parent as ref[AstNode]) = KindJSDocLink
                    return
            }
            if this.check_and_report_error_for_missing_prefix(error_location, nd)
                return
            if this.unported_mark() <> mark
                return
            if this.check_and_report_error_for_extending_interface(error_location)
                return
            if this.unported_mark() <> mark
                return
            if this.check_and_report_error_for_using_type_as_namespace(error_location, nd, meaning)
                return
            if this.unported_mark() <> mark
                return
            if this.check_and_report_error_for_exporting_primitive_type(error_location, nd)
                return
            if this.unported_mark() <> mark
                return
            if this.check_and_report_error_for_using_namespace_as_type_or_value(error_location, nd, meaning)
                return
            if this.unported_mark() <> mark
                return
            if this.check_and_report_error_for_using_type_as_value(error_location, nd, meaning)
                return
            if this.unported_mark() <> mark
                return
            if this.check_and_report_error_for_using_value_as_type(error_location, nd, meaning)
                return
            if this.unported_mark() <> mark
                return
        }
        ; "Report missing lib first." The message is the caller's code either way,
        ; so what this branch decides is whether the SUGGESTER is asked at all.
        var declaration_name Checker.arg_text(nd)
        if error_location <> null
        {
            if AstNode.kind_of(error_location as ref[AstNode]) = KindIdentifier
            {
                if SymbolTable.names_equal(AstNode.identifier_text_of(error_location), nd)
                    set declaration_name: this.declaration_name_to_string(error_location)
            }
        }
        if Checker.is_suggested_lib_name(nd)
        {
            this.error_on_node_or_null(error_location, name_not_found_message, declaration_name, Checker.arg_text(FeatureMap.first_lib(nd)))
            return
        }
        let mark this.unported_mark()
        let suggestion this.get_suggested_symbol_for_nonexistent_symbol(error_location, nd, meaning)
        if this.unported_mark() <> mark
            return
        if suggestion <> null
        {
            let sg suggestion as ref[Symbol]
            var is_global_ambient false
            let vd Symbol.value_declaration_of(sg)
            if vd <> null
            {
                if Binder.is_ambient_module(vd as ref[AstNode])
                {
                    if Binder.is_global_scope_augmentation(vd as ref[AstNode])
                        set is_global_ambient: true
                }
            }
            if is_global_ambient = false
            {
                let suggestion_name this.symbol_arg(sg)
                let unchecked_js this.is_unchecked_js_suggestion(error_location, suggestion, false)
                if this.unported_mark() <> mark
                    return
                var code DiagCannot_find_name_0_Did_you_mean_1
                if meaning = SymbolFlagsNamespace
                    set code: DiagCannot_find_namespace_0_Did_you_mean_1
                else
                {
                    if unchecked_js
                        set code: DiagCould_not_find_name_0_Did_you_mean_1
                }
                ; addErrorOrSuggestion(!isUncheckedJS, …): a SUGGESTION never reaches
                ; the C section (suggestion_count's note), so the count is the whole
                ; of that half here.
                if unchecked_js
                    set suggestion_count: suggestion_count + 1
                else
                {
                    let related_mark this.diagnostic_mark()
                    this.error_on_node_or_null(error_location, code, declaration_name, suggestion_name)
                    if vd <> null
                        this.related_info_since(related_mark, vd, DiagX_0_is_declared_here, suggestion_name)
                }
                return
            }
        }
        ; "And then fall back to unspecified 'not found'."
        this.error_on_node_or_null(error_location, name_not_found_message, declaration_name)
    }

    ; ── slice 91: the resolver's reporting half ──────────────────────────────
    ;
    ; getIsDeferredContext, whole. Every term is a node predicate, which is why it
    ; costs nothing beside the two locals it feeds.
    function get_is_deferred_context(this, location: ref[AstNode], last_location: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(location)
        var lambda_like false
        if k = KindArrowFunction
            set lambda_like: true
        if k = KindFunctionExpression
            set lambda_like: true
        if lambda_like = false
        {
            if k = KindTypeQuery
                return true
            var scope_like false
            if AstNode.is_function_like_declaration(location)
                set scope_like: true
            if k = KindPropertyDeclaration
            {
                if b.is_static(location) = false
                    set scope_like: true
            }
            if scope_like = false
                return false
            if last_location = null
                return true
            return last_location <> AstNode.name_of(location)
        }
        if last_location <> null
        {
            if last_location = AstNode.name_of(location)
                return false
        }
        ; "generator functions and async functions are not inlined in control flow
        ; when immediately invoked".
        if AstNode.asterisk_token_of(location) <> null
            return true
        if b.has_syntactic_modifier(location, ModifierFlagsAsync)
            return true
        AstNode.get_immediately_invoked_function_expression(location) = null
    }

    ; compilerOptions.GetIsolatedModules() — `IsolatedModules.IsTrue() ||
    ; VerbatimModuleSyntax.IsTrue()`, the same PAIR preserve_const_enums is derived
    ; from. Both are unset under this harness, so it answers FALSE; it is a
    ; function rather than an omitted term for that record's reason — the day
    ; either option arrives, this is the one line that moves.
    function get_isolated_modules(this) returns bool
    {
        if isolated_modules
            return true
        verbatim_module_syntax
    }

    ; getExportSymbolOfValueSymbolIfExported.
    function get_export_symbol_of_value_symbol_if_exported(this, symbol: ref[Symbol]?) returns ref[Symbol]?
    {
        var s: ref[Symbol]? symbol
        if s <> null
        {
            let sy s as ref[Symbol]
            if (Symbol.flags_of(sy) & SymbolFlagsExportValue) <> 0
            {
                let ex Symbol.export_symbol_of(sy)
                if ex <> null
                    set s: ex
            }
        }
        this.get_merged_symbol(s)
    }

    ; ── slice 107: isBlockScopedNameDeclaredBeforeUse ────────────────────────
    ;
    ; ★★★ THE FUNCTION IS THE TERM THREE REPORTS WAIT ON, AND ALL THREE ARE
    ; NEGATIVE: checkResolvedBlockScopedVariable's TS2448/TS2449/TS2450 and
    ; checkPropertyNotUsedBeforeDeclaration's TS2729/TS2449 fire when it answers
    ; FALSE. So a port that answered `true` everywhere would be silent and a port
    ; that answered `false` everywhere would invent on every block-scoped name in
    ; the corpus — which is why the stop it replaces was a stop and not a default.
    ;
    ; ★★ ITS SHAPE IS A POSITION TEST WITH TWO TAILS. `declaration.Pos() <=
    ; usage.Pos()` splits it: the BEFORE tail asks whether a textually earlier
    ; declaration is nonetheless unusable (a binding element referring to its own
    ; pattern, `var a = a`, a class named inside its own computed key or decorator,
    ; a property read from its own initializer), the AFTER tail whether a textually
    ; later one is nonetheless reachable (the use is deferred into a function, an
    ; instance-property initializer or an export specifier). Neither tail is the
    ; other's complement, and that is the whole reason the reference writes both.

    ; ast.IsBlockScope. The parent is a SECOND argument rather than a hop off the
    ; node, because the Block arm needs it: a function's own body block is not a
    ; block-scope container, so the question is about the PAIR and not about the
    ; node. Written with the reference's kind list in the reference's order.
    function is_block_scope(node: ref[AstNode]?, parent_node: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindSourceFile
            return true
        if k = KindCaseBlock
            return true
        if k = KindCatchClause
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindForStatement
            return true
        if k = KindForInStatement
            return true
        if k = KindForOfStatement
            return true
        if k = KindConstructor
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindFunctionDeclaration
            return true
        if k = KindFunctionExpression
            return true
        if k = KindArrowFunction
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindClassStaticBlockDeclaration
            return true
        if k = KindBlock
            return Checker.is_function_like_or_class_static_block_declaration(parent_node) = false
        false
    }

    ; ast.GetEnclosingBlockScopeContainer — FindAncestor over the node's PARENT, so
    ; a block-scope container is never its own.
    function get_enclosing_block_scope_container(node: ref[AstNode]) returns ref[AstNode]?
    {
        var p AstNode.parent_node_of(node)
        while p <> null
        {
            if Checker.is_block_scope(p, AstNode.parent_node_of(p))
                return p
            set p: AstNode.parent_node_of(p)
        }
        null
    }

    ; isSameScopeDescendentOf — "is `initial` under `parent` without leaving the
    ; scope `stopAt` names".
    ;
    ; ★★ THE FUNCTION TEST IS NOT `is this a function` BUT `is this a function the
    ; code does not immediately run`. An IIFE is transparent here — its body
    ; executes at the declaration's own position — except when it is an async
    ; generator, which is not immediate at all. The composite is tested for OVERLAP
    ; and not for equality, unlike checkSignatureDeclaration's two readings of the
    ; same mask: what is asked is *does this carry either bit*.
    function is_same_scope_descendent_of(this, initial: ref[AstNode], parent: ref[AstNode]?, stop_at: ref[AstNode]?) returns bool
    {
        if parent = null
            return false
        var n: ref[AstNode]? initial
        while n <> null
        {
            let node n as ref[AstNode]
            if node = parent
                return true
            if node = stop_at
                return false
            if AstNode.is_function_like(node)
            {
                if AstNode.get_immediately_invoked_function_expression(node) = null
                    return false
                if (b.get_function_flags(node) & FunctionFlagsAsyncGenerator) <> 0
                    return false
            }
            set n: AstNode.parent_node_of(node)
        }
        false
    }

    ; isImmediatelyUsedInInitializerOfBlockScopedVariable — `let a = a`, and the
    ; for-in/of head, which is the same question asked of the SEQUENCE rather than
    ; of the declaration.
    function is_immediately_used_in_initializer_of_block_scoped_variable(this, declaration: ref[AstNode], usage: ref[AstNode], decl_container: ref[AstNode]?) returns bool
    {
        let grandparent AstNode.parent_node_of(AstNode.parent_node_of(declaration))
        let gk AstNode.kind_of(grandparent)
        var in_statement false
        if gk = KindVariableStatement
            set in_statement: true
        if gk = KindForStatement
            set in_statement: true
        if gk = KindForOfStatement
            set in_statement: true
        if in_statement
        {
            if this.is_same_scope_descendent_of(usage, declaration, decl_container)
                return true
        }
        var for_in_or_of false
        if gk = KindForInStatement
            set for_in_or_of: true
        if gk = KindForOfStatement
            set for_in_or_of: true
        if for_in_or_of = false
            return false
        this.is_same_scope_descendent_of(usage, AstNode.expression_of(grandparent), decl_container)
    }

    ; isPropertyImmediatelyReferencedWithinDeclaration — the ES-standard class
    ; field question: `x = this.x` is illegal, `x: any = () => this.x` is not.
    ;
    ; ★ The loop's own condition is `node != declaration`, so reaching the
    ; declaration is the TRUE exit and not a miss — the walk ran out of deferring
    ; constructs before it left the declaration.
    function is_property_immediately_referenced_within_declaration(this, declaration: ref[AstNode], usage: ref[AstNode], stop_at_any_property_declaration: bool) returns bool
    {
        if AstNode.end_of(usage) > AstNode.end_of(declaration)
            return false
        var n: ref[AstNode]? usage
        while n <> null
        {
            let node n as ref[AstNode]
            if node = declaration
                return true
            let k AstNode.kind_of(node)
            if k = KindArrowFunction
                return false
            if k = KindPropertyDeclaration
            {
                if stop_at_any_property_declaration = false
                    return false
                let np AstNode.parent_node_of(node)
                if AstNode.kind_of(declaration) = KindPropertyDeclaration
                {
                    if np = AstNode.parent_node_of(declaration)
                        return true
                }
                if b.is_parameter_property_declaration(declaration)
                {
                    if np = AstNode.parent_node_of(AstNode.parent_node_of(declaration))
                        return true
                }
                return false
            }
            if k = KindBlock
            {
                let pk AstNode.kind_of(AstNode.parent_node_of(node))
                if pk = KindMethodDeclaration
                    return false
                if pk = KindGetAccessor
                    return false
                if pk = KindSetAccessor
                    return false
            }
            set n: AstNode.parent_node_of(node)
        }
        true
    }

    ; isPropertyInitializedInStaticBlocks.
    ;
    ; ★★★ IT IS THE SAME SYNTHESIS is_property_initialized_in_constructor ALREADY
    ; DOES, and that is why this arm is ported rather than a stop: a `this.x`
    ; property access is built with no source of its own, parented at the static
    ; block and given that block's RETURN flow node, and the flow walk then answers
    ; whether `x` is definitely assigned by the end of it. The only difference from
    ; the constructor twin is the LOOP and its position window — static blocks run
    ; in document order, so only the ones between the class's own start and the
    ; usage count.
    ;
    ; ★ The computed-name arm the constructor twin stops on cannot arise here: the
    ; caller has already narrowed propName to an Identifier or a PrivateIdentifier.
    procedure is_property_initialized_in_static_blocks(this, prop_name: ref[AstNode], prop_type: ref[Type], class_node: ref[AstNode]?, start_pos: int, end_pos: int) returns bool
    {
        let members AstNode.member_list_of(class_node)
        if members = null
            return false
        let ms members as ref[Array[ref[AstNode]?]]
        let count ms.get_length() as int
        var i 0
        while i < count
        {
            let m ms[i]
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if AstNode.kind_of(member) <> KindClassStaticBlockDeclaration
                continue
            let p AstNode.pos_of(member)
            if p < start_pos
                continue
            if p > end_pos
                continue
            let this_node this.new_synthetic_node(KindThisKeyword, NodeData.Token(TokenData()))
            let reference this.new_synthetic_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(this_node, null, prop_name)))
            set this_node.parent: reference
            set reference.parent: member
            set reference.flow_node: AstNode.return_flow_node_of(member)
            let initial this.get_optional_type(prop_type, false)
            if initial = null
                continue
            let flow_type this.get_flow_type_of_reference_ex(reference, prop_type, initial, null, null)
            if flow_type = null
                continue
            if Checker.contains_undefined_type(flow_type as ref[Type]) = false
                return true
        }
        false
    }

    ; The callback of isUsedInFunctionOrInstanceProperty's FindAncestorOrQuit, as
    ; the three-valued answer it is: 0 keep walking, 1 this node answers, 2 quit.
    ;
    ; ★★ A VERDICT RATHER THAN A `continue`, because the reference's callback
    ; RETURNS out of the function arm and the static-block arm without reaching the
    ; property and decorator blocks below them — a `continue` inside one loop body
    ; would read the same and mean the same, but the recursion in the decorator
    ; block needs the callback to be a function anyway (§3.9e).
    procedure used_in_function_or_instance_property_at(this, current: ref[AstNode], usage: ref[AstNode], declaration: ref[AstNode], decl_container: ref[AstNode]?) returns int
    {
        if current = decl_container
            return 2
        if AstNode.is_function_like(current)
        {
            if AstNode.get_immediately_invoked_function_expression(current) = null
                return 1
            return 0
        }
        if AstNode.kind_of(current) = KindClassStaticBlockDeclaration
        {
            if AstNode.pos_of(declaration) < AstNode.pos_of(usage)
                return 1
            return 0
        }
        let parent AstNode.parent_node_of(current)
        if AstNode.kind_of(parent) = KindPropertyDeclaration
        {
            let property_declaration parent as ref[AstNode]
            if AstNode.initializer_of(property_declaration) = current
            {
                if b.is_static(property_declaration)
                {
                    if AstNode.kind_of(declaration) = KindMethodDeclaration
                        return 1
                    if AstNode.kind_of(declaration) = KindPropertyDeclaration
                    {
                        if Checker.get_containing_class(usage) = Checker.get_containing_class(declaration)
                        {
                            let pn AstNode.name_of(declaration)
                            let nk AstNode.kind_of(pn)
                            var named false
                            if nk = KindIdentifier
                                set named: true
                            if nk = KindPrivateIdentifier
                                set named: true
                            if named
                            {
                                let sym this.symbol_of_declaration(declaration)
                                if sym <> null
                                {
                                    let t this.get_type_of_symbol(sym as ref[Symbol])
                                    if t <> null
                                    {
                                        let cls AstNode.parent_node_of(declaration)
                                        if cls <> null
                                        {
                                            if this.is_property_initialized_in_static_blocks(pn as ref[AstNode], t as ref[Type], cls, AstNode.pos_of(cls as ref[AstNode]), AstNode.pos_of(current))
                                                return 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                else
                {
                    var declaration_is_instance_property false
                    if AstNode.kind_of(declaration) = KindPropertyDeclaration
                    {
                        if b.is_static(declaration) = false
                            set declaration_is_instance_property: true
                    }
                    if declaration_is_instance_property = false
                        return 1
                    if Checker.get_containing_class(usage) <> Checker.get_containing_class(declaration)
                        return 1
                }
            }
        }
        if AstNode.is_decorator(parent) = false
            return 0
        let decorator parent as ref[AstNode]
        if AstNode.expression_of(decorator) <> current
            return 0
        let dp AstNode.parent_node_of(decorator)
        let dpk AstNode.kind_of(dp)
        if dpk = KindParameter
        {
            let up AstNode.parent_node_of(AstNode.parent_node_of(dp))
            if up = null
                return 2
            if this.is_used_in_function_or_instance_property(up as ref[AstNode], declaration, decl_container)
                return 1
            return 2
        }
        if dpk = KindMethodDeclaration
        {
            let up AstNode.parent_node_of(dp)
            if up = null
                return 2
            if this.is_used_in_function_or_instance_property(up as ref[AstNode], declaration, decl_container)
                return 1
            return 2
        }
        0
    }

    ; isUsedInFunctionOrInstanceProperty — the deferral test the AFTER tail rests
    ; on, and the one place a decorator's own position is asked about twice.
    procedure is_used_in_function_or_instance_property(this, usage: ref[AstNode], declaration: ref[AstNode], decl_container: ref[AstNode]?) returns bool
    {
        var n: ref[AstNode]? usage
        while n <> null
        {
            let current n as ref[AstNode]
            let verdict this.used_in_function_or_instance_property_at(current, usage, declaration, decl_container)
            if verdict = 2
                return false
            if verdict = 1
                return true
            set n: AstNode.parent_node_of(current)
        }
        false
    }

    ; The break condition of the class-like arm's container walk: has the walk
    ; reached a position INSIDE the class that is nonetheless evaluated as the class
    ; is created — a computed member name, or (outside legacy decorators) a
    ; decorator on the class or on one of its members.
    function class_like_use_boundary(this, container: ref[AstNode], declaration: ref[AstNode]) returns bool
    {
        let parent AstNode.parent_node_of(container)
        if AstNode.kind_of(container) = KindComputedPropertyName
        {
            if AstNode.parent_node_of(parent) = declaration
                return true
        }
        if legacy_decorators
            return false
        if AstNode.is_decorator(container) = false
            return false
        if parent = declaration
            return true
        let pk AstNode.kind_of(parent)
        let grandparent AstNode.parent_node_of(parent)
        if pk = KindMethodDeclaration
            return grandparent = declaration
        if Checker.is_accessor_kind(pk)
            return grandparent = declaration
        if pk = KindPropertyDeclaration
            return grandparent = declaration
        if pk = KindParameter
            return AstNode.parent_node_of(grandparent) = declaration
        false
    }

    ; isBlockScopedNameDeclaredBeforeUse.
    ;
    ; ★★ THE DECLARATION IS NULLABLE HERE AND IS NOT UPSTREAM. The binding-element
    ; arm recurses through `FindAncestorKind(declaration, KindVariableDeclaration)`,
    ; which upstream dereferences without a test — sound there only because a
    ; binding element the resolver reaches always sits under one. A parameter's
    ; binding element does not, so the guard is written and answers TRUE, the
    ; direction that reports nothing (§3.5bk).
    procedure is_block_scoped_name_declared_before_use(this, declaration_in: ref[AstNode]?, usage: ref[AstNode]) returns bool
    {
        if declaration_in = null
            return true
        let declaration declaration_in as ref[AstNode]
        let declaration_file Checker.source_file_of_node(declaration)
        let use_file Checker.source_file_of_node(usage)
        let decl_container Checker.get_enclosing_block_scope_container(declaration)
        if declaration_file <> use_file
            return true
        if (AstNode.flags_of(usage) & NodeFlagsJSDoc) <> 0
            return true
        if Checker.is_in_type_query(usage)
            return true
        if this.is_in_ambient_or_type_node(usage)
            return true
        var declaration_is_before false
        if AstNode.pos_of(declaration) <= AstNode.pos_of(usage)
        {
            set declaration_is_before: true
            ; The reference's second conjunct, negated: an UNINITIALIZED property
            ; read through `this.` is not "declared before" even when it is written
            ; earlier, unless a definite-assignment `!` says so.
            if AstNode.kind_of(declaration) = KindPropertyDeclaration
            {
                let up AstNode.parent_node_of(usage)
                if up <> null
                {
                    if Checker.is_this_property(up as ref[AstNode])
                    {
                        if AstNode.initializer_of(declaration) = null
                        {
                            if AstNode.kind_of(AstNode.postfix_token_of(declaration)) <> KindExclamationToken
                                set declaration_is_before: false
                        }
                    }
                }
            }
        }
        if declaration_is_before
            return this.declared_before_use_before_tail(declaration, usage, decl_container)
        this.declared_before_use_after_tail(declaration, usage, decl_container)
    }

    ; The BEFORE tail — the reference's `switch` under `declaration.Pos() <=
    ; usage.Pos()`, in its order, with `true` for every kind it does not name.
    procedure declared_before_use_before_tail(this, declaration: ref[AstNode], usage: ref[AstNode], decl_container: ref[AstNode]?) returns bool
    {
        let dk AstNode.kind_of(declaration)
        if dk = KindBindingElement
        {
            ; `var [a = b, b = b] = [1, 2]` — both sides are binding elements, so
            ; the question is which pattern each sits in and, within one pattern,
            ; which comes first.
            let error_binding_element Checker.find_ancestor_kind(usage, KindBindingElement)
            if error_binding_element <> null
            {
                let ebe error_binding_element as ref[AstNode]
                if Checker.find_ancestor_kind(ebe, KindBindingElement) <> Checker.find_ancestor_kind(declaration, KindBindingElement)
                    return true
                return AstNode.pos_of(declaration) < AstNode.pos_of(ebe)
            }
            ; `var [a] = a` — the use is outside any pattern, so ask the whole
            ; variable declaration instead.
            return this.is_block_scoped_name_declared_before_use(Checker.find_ancestor_kind(declaration, KindVariableDeclaration), usage)
        }
        if dk = KindVariableDeclaration
            return this.is_immediately_used_in_initializer_of_block_scoped_variable(declaration, usage, decl_container) = false
        if Parser.is_class_like_node(declaration)
            return this.class_declared_before_use(declaration, usage)
        if dk = KindPropertyDeclaration
            return this.is_property_immediately_referenced_within_declaration(declaration, usage, false) = false
        if b.is_parameter_property_declaration(declaration)
        {
            ; `foo = this.bar` is illegal in emitStandardClassFields when bar is a
            ; parameter property.
            if emit_standard_class_fields = false
                return true
            if Checker.get_containing_class(declaration) <> Checker.get_containing_class(usage)
                return true
            return this.is_used_in_function_or_instance_property(usage, declaration, decl_container) = false
        }
        true
    }

    ; The class-like arm of the BEFORE tail: a class name used inside its own
    ; computed key (`class A { static p = "a"; [A.p]() {} }`) or inside a decorator
    ; on it (`@dec(A.x) class A { static x = "x" }`), except from within a function
    ; that is not immediately invoked.
    function class_declared_before_use(this, declaration: ref[AstNode], usage: ref[AstNode]) returns bool
    {
        var container: ref[AstNode]? usage
        var scanning true
        while scanning
        {
            set scanning: false
            if container <> null
            {
                let c container as ref[AstNode]
                if c <> declaration
                {
                    if this.class_like_use_boundary(c, declaration) = false
                    {
                        set container: AstNode.parent_node_of(c)
                        set scanning: true
                    }
                }
            }
        }
        if container = null
            return true
        let cc container as ref[AstNode]
        if cc = declaration
            return true
        if legacy_decorators
            return false
        if AstNode.is_decorator(cc) = false
            return false
        var n: ref[AstNode]? usage
        var walking true
        while walking
        {
            set walking: false
            if n <> null
            {
                let nn n as ref[AstNode]
                if nn <> cc
                {
                    var deferring false
                    if AstNode.is_function_like(nn)
                    {
                        if AstNode.get_immediately_invoked_function_expression(nn) = null
                            set deferring: true
                    }
                    if deferring = false
                    {
                        set n: AstNode.parent_node_of(nn)
                        set walking: true
                    }
                }
            }
        }
        if n = null
            return false
        (n as ref[AstNode]) <> cc
    }

    ; The AFTER tail — a declaration that comes textually later is still legal when
    ; the use is deferred. The reference lists five ways; the first two are
    ; syntactic and the third is isUsedInFunctionOrInstanceProperty.
    procedure declared_before_use_after_tail(this, declaration: ref[AstNode], usage: ref[AstNode], decl_container: ref[AstNode]?) returns bool
    {
        let up AstNode.parent_node_of(usage)
        let upk AstNode.kind_of(up)
        if upk = KindExportSpecifier
            return true
        if upk = KindExportAssignment
        {
            if AstNode.is_export_equals_of(up)
                return true
        }
        ; When resolving symbols for exports the usage location can be the export
        ; site itself.
        if AstNode.kind_of(usage) = KindExportAssignment
        {
            if AstNode.is_export_equals_of(usage)
                return true
        }
        if this.is_used_in_function_or_instance_property(usage, declaration, decl_container) = false
            return false
        if emit_standard_class_fields
        {
            if Checker.get_containing_class(declaration) <> null
            {
                var is_field false
                if AstNode.kind_of(declaration) = KindPropertyDeclaration
                    set is_field: true
                if b.is_parameter_property_declaration(declaration)
                    set is_field: true
                if is_field
                    return this.is_property_immediately_referenced_within_declaration(declaration, usage, true) = false
            }
        }
        true
    }
    ; checkResolvedBlockScopedVariable — whole, and the three reports the walk in
    ; front of it decides.
    ;
    ; ★★★ THE THREE CODES ARE ONE CONDITION READ THROUGH THE SYMBOL'S FLAGS, and the
    ; fourth arm is an OPTION rather than a code: a CONST enum used before its
    ; declaration reports TS2450 only under isolatedModules, which is unset under
    ; this harness — so `get_isolated_modules` is the line that moves the day either
    ; of its two options arrives, exactly as its own header says.
    ;
    ; ★★ THE FIRST GUARD IS AN EARLY *return*, NOT AN ANSWER: a constructor
    ; function — Function|FunctionScopedVariable|Assignment together with Class — is
    ; not block scoped and reaches no report at all.
    ;
    ; ★★ THE REFERENCE PANICS WHERE THIS RETURNS. `core.Find` over the symbol's
    ; declarations cannot fail upstream, because the caller has already asserted the
    ; symbol is block-scoped, a class or an enum; the assertion is not ported, so a
    ; symbol whose declarations do not carry one of the three shapes leaves silently
    ; rather than aborting the unit (§3.5bk).
    ;
    ; ★★★ THE MARK GUARD IS WHAT MAKES THE REPORT HONEST. The walk reaches
    ; getTypeOfSymbol through the static-block arm, and a stop under it means the
    ; answer is not this port's — reporting on it would be an INVENTION, while
    ; staying silent is a LOSS and a loss is a legal subsequence.
    procedure check_resolved_block_scoped_variable(this, result: ref[Symbol], error_location: ref[AstNode])
    {
        let f Symbol.flags_of(result)
        if (f & (SymbolFlagsFunction | SymbolFlagsFunctionScopedVariable | SymbolFlagsAssignment)) <> 0
        {
            if (f & SymbolFlagsClass) <> 0
                return
        }
        var declaration: ref[AstNode]? null
        let n Symbol.declaration_count(result)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(result, i)
            set i: i + 1
            if d = null
                continue
            let dn d as ref[AstNode]
            var block_scoped false
            if b.is_block_or_catch_scoped(dn)
                set block_scoped: true
            if Parser.is_class_like_node(dn)
                set block_scoped: true
            if AstNode.kind_of(dn) = KindEnumDeclaration
                set block_scoped: true
            if block_scoped
            {
                set declaration: dn
                break
            }
        }
        if declaration = null
            return
        let decl declaration as ref[AstNode]
        if (AstNode.flags_of(decl) & NodeFlagsAmbient) <> 0
            return
        let mark this.unported_mark()
        let before this.is_block_scoped_name_declared_before_use(decl, error_location)
        if this.unported_mark() <> mark
            return
        if before
            return
        let declaration_name this.declaration_name_to_string(b.get_name_of_declaration(decl))
        let related_mark this.diagnostic_mark()
        if (f & SymbolFlagsBlockScopedVariable) <> 0
            this.error_on_node(error_location, DiagBlock_scoped_variable_0_used_before_its_declaration, declaration_name)
        else
        {
            if (f & SymbolFlagsClass) <> 0
                this.error_on_node(error_location, DiagClass_0_used_before_its_declaration, declaration_name)
            else
            {
                if (f & SymbolFlagsRegularEnum) <> 0
                    this.error_on_node(error_location, DiagEnum_0_used_before_its_declaration, declaration_name)
                else
                {
                    if this.get_isolated_modules()
                        this.error_on_node(error_location, DiagEnum_0_used_before_its_declaration, declaration_name)
                }
            }
        }
        this.related_info_since(related_mark, decl, DiagX_0_is_declared_here, declaration_name)
    }

    ; onSuccessfullyResolvedSymbol — the third message-gated callback, five blocks
    ; in the reference's order, of which three are written, one is a row and one is
    ; dead behind an option that is written as the reference's test.
    ;
    ; ★★ `errorLocation` IS OPTIONAL IN THE REFERENCE AND DEREFERENCED IN BLOCK 2
    ; ANYWAY. Blocks 1 and 4 test it, block 2 reads `errorLocation.Flags` without
    ; one — which is sound upstream because the only caller that passes nil also
    ; passes a nil message. The guard is written here rather than relied on.
    procedure on_successfully_resolved_symbol(this, error_location: ref[AstNode]?, result: ref[Symbol], meaning: int, last_location: ref[AstNode]?, associated_declaration: ref[AstNode]?, within_deferred_context: bool)
    {
        var is_in_external_module false
        if last_location <> null
        {
            if AstNode.kind_of(last_location as ref[AstNode]) = KindSourceFile
            {
                if this.binder_of_node(last_location).is_external_or_common_js_module()
                    set is_in_external_module: true
            }
        }
        let value_meaning (meaning & SymbolFlagsValue) = SymbolFlagsValue

        ; BLOCK 1 — the block-scoped check. Its guard is a question about the
        ; MEANING that was asked for and not about the symbol: `x` in a value
        ; position asks Value, which contains BlockScopedVariable, so the first
        ; disjunct holds for every caller this port has.
        if error_location <> null
        {
            var asks false
            if (meaning & SymbolFlagsBlockScopedVariable) <> 0
                set asks: true
            if (meaning & (SymbolFlagsClass | SymbolFlagsEnum)) <> 0
            {
                if value_meaning
                    set asks: true
            }
            if asks
            {
                let eol this.get_export_symbol_of_value_symbol_if_exported(result)
                if eol <> null
                {
                    let e eol as ref[Symbol]
                    if (Symbol.flags_of(e) & (SymbolFlagsBlockScopedVariable | SymbolFlagsClass | SymbolFlagsEnum)) <> 0
                        this.check_resolved_block_scoped_variable(e, error_location as ref[AstNode])
                }
            }
        }

        ; BLOCK 2 — TS2686, the UMD global referenced from a module. It is WRITTEN
        ; whole, and the term that looked like a globals-table question is not one:
        ; `IsSourceFile(d) && d.GlobalExports != nil` is asked of a declaration of
        ; THIS file, and the binder's global_exports slot is exactly that field.
        ; ★`AllowUmdGlobalAccess` is unset, so `!= TSTrue` is true and
        ; errorOrSuggestion is an ERROR rather than a suggestion — the reading
        ; strict_null_checks' header calls the plain-equality one.
        if error_location <> null
        {
            let el error_location as ref[AstNode]
            if is_in_external_module
            {
                if value_meaning
                {
                    if (AstNode.flags_of(el) & NodeFlagsJSDoc) = 0
                    {
                        let merged this.get_merged_symbol(result)
                        if merged <> null
                        {
                            let m merged as ref[Symbol]
                            let n Symbol.declaration_count(m)
                            if n > 0
                            {
                                var every true
                                var i 0
                                while i < n
                                {
                                    let d Symbol.declaration_at(m, i)
                                    var ok false
                                    if d <> null
                                    {
                                        let dn d as ref[AstNode]
                                        if AstNode.kind_of(dn) = KindNamespaceExportDeclaration
                                            set ok: true
                                        if AstNode.kind_of(dn) = KindSourceFile
                                        {
                                            if this.binder_of_node(dn).global_exports <> null
                                                set ok: true
                                        }
                                    }
                                    if ok = false
                                        set every: false
                                    set i: i + 1
                                }
                                ; ★★★ THE TEST CAN ONLY BE WRONGLY **TRUE**, AND
                                ; SLICE 110 IS WHAT GAVE IT AN INPUT. It asks
                                ; whether EVERY declaration of the merged symbol is
                                ; a UMD one, and our merged symbol's declaration
                                ; list is a strict SUBSET of upstream's wherever a
                                ; `declare global` block's exports were not merged —
                                ; initialize_checker's augmentation passes, left out
                                ; with the lib. So a declaration that would have
                                ; made `every` false may simply be absent. Measured:
                                ; `declare global { namespace N {} }; export = N;
                                ; export as namespace N;` in a .d.ts reported TS2686
                                ; where the reference reports nothing, because
                                ; upstream's N carries the namespace's
                                ; ModuleDeclaration beside the
                                ; NamespaceExportDeclaration and ours carries only
                                ; the latter.
                                ;
                                ; ★★ IT STOPS ONLY WHERE THE REPORT WAS ABOUT TO BE
                                ; MADE, which is what keeps the guard narrow: an
                                ; `every` that is FALSE is an answer no missing
                                ; declaration can change.
                                if every and (checker_allow_umd_global_access = false)
                                {
                                    if this.file_has_global_augmentation()
                                        this.record_unported("unmerged-global-augmentation", 0)
                                    else
                                        this.error_on_node(el, DiagX_0_refers_to_a_UMD_global_but_the_current_file_is_a_module_Consider_adding_an_import_instead, Checker.arg_text(Symbol.name_of(result)))
                                }
                            }
                        }
                    }
                }
            }
        }

        ; BLOCK 3 — TS2372 and TS2373, the parameter initializer that names itself
        ; or a parameter to its right. Written because the two loop arms that feed
        ; it are (see resolve_name's own note); every term below is a node
        ; comparison or a table read this port already has.
        if associated_declaration <> null
        {
            if within_deferred_context = false
            {
                if value_meaning
                {
                    let ad associated_declaration as ref[AstNode]
                    let late this.get_late_bound_symbol(result)
                    let candidate this.get_merged_symbol(late)
                    let root Binder.get_root_declaration(ad)
                    let own this.symbol_of_declaration(ad)
                    if candidate = own
                        this.error_on_node_or_null(error_location, DiagParameter_0_cannot_reference_itself, this.declaration_name_to_string(AstNode.name_of(ad)))
                    if candidate <> own
                    {
                        if candidate <> null
                        {
                            let cand candidate as ref[Symbol]
                            let vd Symbol.value_declaration_of(cand)
                            if vd <> null
                            {
                                if AstNode.pos_of(vd as ref[AstNode]) > AstNode.pos_of(ad)
                                {
                                    let holder AstNode.parent_node_of(root)
                                    if holder <> null
                                    {
                                        let locals AstNode.locals_of(holder as ref[AstNode])
                                        if locals <> null
                                        {
                                            if this.lookup_symbol(locals, Symbol.name_of(cand), meaning) = candidate
                                                this.error_on_node_or_null(error_location, DiagParameter_0_cannot_reference_identifier_1_declared_after_it, this.declaration_name_to_string(AstNode.name_of(ad)), this.declaration_name_to_string(error_location))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ; BLOCK 4 — TS1361/TS1362, an alias imported or exported with `type` and
        ; used as a value. Slice 114: both halves are here, and the fork between the
        ; two codes is the FIRST one's answer — the KIND of the declaration that
        ; made the alias type-only, not anything about the use site.
        ;
        ; ★ `addTypeOnlyDeclarationRelatedInfo` is deliberately not written: it adds
        ; a RELATED INFO to the diagnostic it is handed, and no dump this package
        ; has compares one (the T section's C lines are code and span).
        if error_location <> null
        {
            if (meaning & SymbolFlagsValue) <> 0
            {
                if (Symbol.flags_of(result) & SymbolFlagsAlias) <> 0
                {
                    if (Symbol.flags_of(result) & SymbolFlagsValue) = 0
                    {
                        let el error_location as ref[AstNode]
                        if this.is_valid_type_only_alias_use_site(el) = false
                        {
                            let tod this.get_type_only_alias_declaration_ex(result, SymbolFlagsValue)
                            if tod <> null
                            {
                                let tk AstNode.kind_of(tod as ref[AstNode])
                                var code DiagX_0_cannot_be_used_as_a_value_because_it_was_imported_using_import_type
                                if tk = KindExportSpecifier
                                    set code: DiagX_0_cannot_be_used_as_a_value_because_it_was_exported_using_export_type
                                if tk = KindExportDeclaration
                                    set code: DiagX_0_cannot_be_used_as_a_value_because_it_was_exported_using_export_type
                                if tk = KindNamespaceExport
                                    set code: DiagX_0_cannot_be_used_as_a_value_because_it_was_exported_using_export_type
                                let type_only_mark this.diagnostic_mark()
                                this.error_on_node(el, code, Checker.arg_text(Symbol.name_of(result)))
                                this.add_type_only_declaration_related_info(type_only_mark, tod, Checker.arg_text(Symbol.name_of(result)))
                            }
                        }
                    }
                }
            }
        }

        ; BLOCK 5 — TS1444, and it is DEAD rather than unreached: the reference
        ; reads `compilerOptions.IsolatedModules` DIRECTLY here (its own comment
        ; says why it is not GetIsolatedModules), and that option is unset. The
        ; test is written so the day it moves this is the line that reports; what
        ; stands behind it is `c.getSymbol(c.globals, …)`, i.e. §3.11 again.
        ; an import that shadows a GLOBAL value used in the file (isolatedModules,
        ; slice 249): the file's non-value symbol of that name names the import
        if isolated_modules and is_in_external_module and value_meaning
        {
            let name Symbol.name_of(result)
            let global this.get_symbol_in_table(globals, name, meaning)
            var is_global false
            if global <> null
            {
                if (global as ref[Symbol]) = result
                    set is_global: true
            }
            if is_global and (Checker.kind_or_unknown(last_location) = KindSourceFile)
            {
                let non_value this.get_symbol_in_table(AstNode.locals_of(last_location), name, 0 - 1 - SymbolFlagsValue)
                if non_value <> null
                {
                    let nv non_value as ref[Symbol]
                    let dn Symbol.declaration_count(nv)
                    var di 0
                    while di < dn
                    {
                        let d Symbol.declaration_at(nv, di)
                        set di: di + 1
                        let dk Checker.kind_or_unknown(d)
                        if (dk = KindImportSpecifier) or (dk = KindImportClause) or (dk = KindNamespaceImport) or (dk = KindImportEqualsDeclaration)
                        {
                            if Checker.is_type_only_import_declaration(d as ref[AstNode]) = false
                                this.error_on_node(d, DiagImport_0_conflicts_with_global_value_used_in_this_file_so_must_be_declared_with_a_type_only_import_when_isolatedModules_is_enabled, Checker.arg_text(name))
                            break
                        }
                    }
                }
            }
        }
    }

    ; isInAmbientOrTypeNode, whole. FindAncestor with a three-kind predicate is
    ; written out as the walk it is (§3.9d) — and it starts AT the node, as
    ; FindAncestor does, which matters for a binding pattern that IS inside a type
    ; literal's member.
    function is_in_ambient_or_type_node(this, node: ref[AstNode]) returns bool
    {
        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            return true
        var p: ref[AstNode]? node
        while p <> null
        {
            let k AstNode.kind_of(p)
            if k = KindInterfaceDeclaration
                return true
            if k = KindTypeAliasDeclaration
                return true
            if k = KindJSTypeAliasDeclaration
                return true
            if k = KindTypeLiteral
                return true
            set p: AstNode.parent_node_of(p)
        }
        false
    }

    ; ── slice 55: the PARAMETER ──────────────────────────────────────────────
    ;
    ; checkParameter, whole except its last term. Its first two lines are the two
    ; functions this port already had — checkGrammarModifiers (slice 49, whose
    ; parameter-property arm has been live and unreached since that slice) and
    ; checkVariableLikeDeclaration (slice 54) — and everything after them is a run
    ; of c.errors over kind tests, which is why the arm is affordable at all.
    ;
    ; ★★★ THE FIRST LINE BUYS THREE DIAGNOSTICS OUT OF A FUNCTION THIS SLICE DID
    ; NOT TOUCH, and the number is measured: checkGrammarModifiers has carried its
    ; `nk = KindParameter` arm since slice 49 and nothing had ever called it on a
    ; parameter, because nothing walked one. Clipping this arm and re-running the
    ; whole of stage 2 through both binaries puts the difference at **+3 TS1090**
    ; on top of the twenty-three this function's own reports answer for. ★A ported
    ; arm no caller reaches is indistinguishable from an unported one until a
    ; caller arrives — §3.5ce's *an arm that is ported is not thereby measured*,
    ; seen from the paying end.
    ;
    ; ★★★ EIGHT REPORTS AND NOT ONE OF THEM IS A GRAMMAR ERROR, which is the
    ; distinction §3.5cw's two reporters exist for and the first arm in this file
    ; where it decides anything at scale. checkParameter calls `c.error`, not
    ; `c.grammarErrorOnNode` — so a file that FAILED TO PARSE still gets every one
    ; of these, where every report of the five grammar functions in front of them
    ; is suppressed. Routing one of them through grammar_error_on_node would be a
    ; missing diagnostic on exactly the broken files the corpus has most of, and it
    ; would look like a port that is merely conservative.
    ;
    ; ★★★ THE LAST TERM IS THE ONE HOLE AND IT IS THE TYPE DIMENSION, asked where
    ; the reference asks it: `hasDotDotDotToken(node) && !IsBindingPattern(name) &&
    ; !c.isTypeAssignableTo(c.getReducedType(c.getTypeOfSymbol(node.Symbol())),
    ; c.anyReadonlyArrayType)`. The two kind tests in front of it are FREE and are
    ; ported, so the report fires only for a rest parameter whose name is not a
    ; pattern — which is what makes the row a measurement of the term rather than
    ; of the statement. ★The reference's own comment says why the second test is
    ; there: a rest parameter with a binding pattern already reported from
    ; checkGrammarParameterList, so this would be a second line on one defect.
    ;
    ; ★★ `paramName` IS COMPUTED ONCE AND ASKED THREE TIMES, and it is empty unless
    ; the name is an IDENTIFIER — so a destructuring parameter answers "" and
    ; cannot be `this`, `new` or `constructor`. Transcribed as a bool plus three
    ; text comparisons rather than as a String, for §3.9a's reason: this port
    ; compares identifier text by bytes and has no reason to materialise one.
    ;
    ; ★★ THE `this`/`new` QUARTET IS FOUR INDEPENDENT `if`s, NOT A CHAIN, and a
    ; parameter can collect two of them: `class C { constructor(this: C) {} }`
    ; reports TS2681 (a constructor cannot have a `this` parameter) and, when it is
    ; not first, TS2680 as well. Reading them as an else-chain would drop the
    ; second, which is the same shape as checkGrammarParameterList's discarded
    ; trailing-comma result one slice back.
    ;
    ; ★ `slices.Index(fn.Parameters(), node) != 0` is a POINTER search, and -1
    ; satisfies `!= 0` as loudly as 1 does. parameter_index_of answers -1 for a
    ; parameter it cannot find in its own function's list, which is unreachable for
    ; a parsed tree and is the reference's answer for it either way.
    procedure check_parameter(this, node: ref[AstNode])
    {
        this.check_grammar_modifiers(node)
        this.check_variable_like_declaration(node)
        let fn Checker.get_containing_function(node)
        let fk Checker.kind_or_unknown(fn)
        let name AstNode.name_of(node)
        var named_identifier false
        if name <> null
        {
            if AstNode.kind_of(name) = KindIdentifier
                set named_identifier: true
        }
        if b.has_syntactic_modifier(node, ModifierFlagsParameterPropertyModifier)
        {
            if this.should_check_erasable_syntax(node)
                this.error_on_node(node, DiagThis_syntax_is_not_allowed_when_erasableSyntaxOnly_is_enabled)
            ; !(IsConstructorDeclaration(fn) && NodeIsPresent(fn.Body())) — an
            ; overload signature has no body, so a parameter property on one is a
            ; report even though the constructor it belongs to has an
            ; implementation somewhere below it.
            var in_constructor_implementation false
            if fk = KindConstructor
            {
                if Binder.node_is_missing(AstNode.body_of(fn)) = false
                    set in_constructor_implementation: true
            }
            if in_constructor_implementation = false
                this.error_on_node(node, DiagA_parameter_property_is_only_allowed_in_a_constructor_implementation)
            ; The span is the NAME here and the node everywhere else in this
            ; function, which is the reference's choice and not a simplification
            ; worth making: `constructor` as a parameter property names a member
            ; that would collide with the class's own constructor.
            if fk = KindConstructor
            {
                if named_identifier
                {
                    if Checker.identifier_text_equals(name, "constructor")
                        this.error_on_node(name, DiagX_constructor_cannot_be_used_as_a_parameter_property_name)
                }
            }
        }
        ; `node.Initializer() == nil && isOptionalDeclaration(node) &&
        ; IsBindingPattern(node.Name()) && fn.Body() != nil` — a `?` on a
        ; destructuring parameter of a function that HAS a body. The last test is
        ; the plain null one, not NodeIsMissing: four lines above it in the
        ; reference the same question is asked the other way, and both are
        ; transcribed as they stand.
        if AstNode.initializer_of(node) = null
        {
            if Checker.is_optional_declaration(node)
            {
                if AstNode.is_binding_pattern(name)
                {
                    if AstNode.body_of(fn) <> null
                        this.error_on_node(node, DiagA_binding_pattern_parameter_cannot_be_optional_in_an_implementation_signature)
                }
            }
        }
        var this_or_new false
        if named_identifier
        {
            if Checker.identifier_text_equals(name, "this")
                set this_or_new: true
            if Checker.identifier_text_equals(name, "new")
                set this_or_new: true
        }
        if this_or_new
        {
            if Checker.parameter_index_of(fn, node) <> 0
                this.error_on_node(node, DiagA_0_parameter_must_be_the_first_parameter, Checker.arg_text(AstNode.identifier_text_of(name)))
            var construct_like false
            if fk = KindConstructor
                set construct_like: true
            if fk = KindConstructSignature
                set construct_like: true
            if fk = KindConstructorType
                set construct_like: true
            if construct_like
                this.error_on_node(node, DiagA_constructor_cannot_have_a_this_parameter)
            if fk = KindArrowFunction
                this.error_on_node(node, DiagAn_arrow_function_cannot_have_a_this_parameter)
            if Checker.is_accessor_kind(fk)
                this.error_on_node(node, DiagX_get_and_set_accessors_cannot_declare_this_parameters)
        }
        ; isTypeAssignableTo(getReducedType(getTypeOfSymbol(node.Symbol())),
        ; anyReadonlyArrayType) — and the symbol is the NODE's own rather than
        ; getSymbolOfDeclaration's, which is the reference's spelling here.
        if AstNode.dot_dot_dot_token_of(node) <> null
        {
            if AstNode.is_binding_pattern(name) = false
            {
                let psym AstNode.symbol_of(node)
                if psym <> null
                {
                    let before_type this.unported_mark()
                    let ptype this.get_type_of_symbol(psym as ref[Symbol])
                    if this.unported_mark() = before_type
                        this.check_rest_parameter_is_array_like(node, ptype)
                }
            }
        }
    }

    ; The rest parameter's TS2370, and it is this slice's third frontier row:
    ; `isTypeAssignableTo(getReducedType(getTypeOfSymbol(sym)), anyReadonlyArrayType)`
    ; was the largest ROW the frontier had after the excess check — 37 units — and
    ; the relation could not answer ONE of its 59 arrivals before the recursion
    ; existed. Every one of them stopped at `common-property-check`.
    ;
    ; ★★ `anyReadonlyArrayType` IS BUILT AT THE CALL AND NOT MEMOISED, unlike the
    ; two array globals: `createTypeFromGenericGlobalType` interns its reference, so
    ; asking twice answers the same type object, and a field would only hide that.
    ;
    ; ★★★ THE MARK IS READ AROUND THE RELATION AND THE STOP IS KEPT. A relation
    ; that could not answer is not a relation that answered `no` — the shape slice
    ; 117 paid for one dimension over — and here the `no` is a REPORT, so reading a
    ; stop as one invents TS2370 on every rest parameter whose type the checker
    ; cannot compare.
    procedure check_rest_parameter_is_array_like(this, node: ref[AstNode], ptype: ref[Type]?)
    {
        if ptype = null
        {
            this.record_unported("is-type-assignable-to", KindParameter)
            return
        }
        let reduced this.get_reduced_type(ptype as ref[Type])
        if reduced = null
        {
            this.record_unported("is-type-assignable-to", KindParameter)
            return
        }
        let args this.new_type_list_of(1)
        args.add(any_type)
        let target this.create_type_from_generic_global_type(this.get_global_readonly_array_type(), args)
        if target = null
        {
            this.record_unported("is-type-assignable-to", KindParameter)
            return
        }
        let mark this.unported_mark()
        let related this.is_type_assignable_to(reduced as ref[Type], target as ref[Type])
        if this.unported_mark() <> mark
            return
        if related = false
            this.error_on_node(node, DiagA_rest_parameter_must_be_of_an_array_type)
    }

    ; checkVariableLikeDeclaration's two `using` arms, folded into one function
    ; because they differ in exactly two places: the extra AsyncDisposable
    ; constituent and the message.
    ;
    ; ★★ THE GUARD IS AN IDENTITY TEST AGAINST `empty_object_type`, which is what
    ; get_global_type_of_arity answers for a global the lib set does not declare.
    ; Under the single lib both `Disposable` and `AsyncDisposable` are absent, so
    ; the guard closes and nothing is reported — the reference's own answer.
    procedure check_using_initializer(this, node: ref[AstNode], initializer: ref[AstNode], initializer_type: ref[Type], is_await: bool)
    {
        let mark this.unported_mark()
        if is_await
            this.report_checked_global_type("AsyncDisposable", 0)
        this.report_checked_global_type("Disposable", 0)
        let disposable this.get_global_type_of_arity("Disposable", 0)
        if this.unported_mark() <> mark
            return
        if disposable = null
            return
        if disposable = empty_object_type
            return
        let constituents &Array[ref[Type]?]()
        var message DiagThe_initializer_of_a_using_declaration_must_be_either_an_object_with_a_Symbol_dispose_method_or_be_null_or_undefined
        if is_await
        {
            let async_disposable this.get_global_type_of_arity("AsyncDisposable", 0)
            if this.unported_mark() <> mark
                return
            if async_disposable = null
                return
            if async_disposable = empty_object_type
                return
            constituents.add(async_disposable)
            set message: DiagThe_initializer_of_an_await_using_declaration_must_be_either_an_object_with_a_Symbol_asyncDispose_or_Symbol_dispose_method_or_be_null_or_undefined
        }
        constituents.add(disposable)
        constituents.add(null_type)
        constituents.add(undefined_type)
        let optional this.get_union_type(constituents)
        if this.unported_mark() <> mark
            return
        if optional = null
            return
        let widened this.widen_type_for_variable_like_declaration(initializer_type, node, false)
        if this.unported_mark() <> mark
            return
        if widened = null
            return
        this.check_type_assignable_to(widened as ref[Type], optional as ref[Type], initializer, message)
    }

    ; ast.GetContainingFunction — `FindAncestor(node.Parent, IsFunctionLike)`,
    ; written out as the walk it is (§3.9d), starting at the PARENT rather than at
    ; the node. For a parameter that is one step; for a binding element inside a
    ; parameter's pattern it is three, which is the population the caller above
    ; shares with checkVariableLikeDeclaration's TS2371.
    function get_containing_function(node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        var p AstNode.parent_node_of(node)
        while p <> null
        {
            if AstNode.is_function_like(p)
                return p
            set p: AstNode.parent_node_of(p)
        }
        null
    }

    ; isOptionalDeclaration, which is ast.HasQuestionToken, which is
    ; `IsQuestionToken(node.QuestionToken())`. The KIND test is transcribed rather
    ; than dropped even though a Parameter's slot can hold nothing else: the
    ; accessor serves four kinds whose slot is a field and everything else through
    ; the POSTFIX slot, and that one also holds a `!` (ast.scaly's question_token_of
    ; says so at the line). ★check_grammar_parameter_list asks the slot directly one
    ; slice back, which is the reference's spelling there — the two are the same
    ; answer for a parameter and different questions in general.
    function is_optional_declaration(node: ref[AstNode]) returns bool
    {
        let q AstNode.question_token_of(node)
        if q = null
            return false
        AstNode.kind_of(q) = KindQuestionToken
    }

    ; slices.Index(fn.Parameters(), node), by IDENTITY. -1 when the list has no
    ; such element, which is what the reference's `!= 0` reads as a report.
    function parameter_index_of(fn: ref[AstNode]?, node: ref[AstNode]) returns int
    {
        let parameters AstNode.parameters_of(fn)
        if parameters = null
            return 0 - 1
        var i 0
        let n AstNode.list_count(parameters)
        while i < n
        {
            if AstNode.child_in_list(parameters, i) = node
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; ── slice 56: the BINDING ELEMENT ────────────────────────────────────────
    ;
    ; checkBindingElement, whole — two lines, and it is the other half of the
    ; function slice 55 ported the first half of. What makes it a slice of its own
    ; rather than a line is what the two lines REACH: checkGrammarBindingElement is
    ; four reports this file has never had a caller for, and
    ; checkVariableLikeDeclaration's binding-element block is the branch slices 54
    ; and 55 could only comment on.
    ;
    ; ★★ THE GRAMMAR RESULT IS DISCARDED, and upstream discards it too — the bool
    ; exists for the `return` spellings inside the function and nothing reads it,
    ; which is the same shape checkVariableDeclaration's first line has one slice
    ; back. It is transcribed as a `function returns bool` all the same, because the
    ; three internal returns ARE the control flow.
    procedure check_binding_element(this, node: ref[AstNode])
    {
        this.check_grammar_binding_element(node)
        this.check_variable_like_declaration(node)
    }

    ; checkTypeNameIsReserved, whole: the eleven predefined type keywords may not
    ; be the name of a user-defined type. It is one switch on the name's TEXT, and
    ; the message is the CALLER's — six call sites in the reference pass six
    ; different ones (interface, type alias, type parameter, import, class, enum),
    ; which is why the code is a parameter here rather than a constant.
    ;
    ; ★★★ THE ELEVEN ARE A SPELLING LIST, NOT A KIND TEST, and that is the whole
    ; reason this reads the identifier's text instead of asking the scanner what
    ; token it was. Every one of `any unknown never number bigint boolean string
    ; symbol void object undefined` is a CONTEXTUAL keyword — `interface any {}`
    ; parses with an Identifier named `any`, not with a keyword token — so a test on
    ; the kind would answer *identifier* for all eleven and report nothing.
    ;
    ; ★★ THE NAME MAY BE ABSENT AND THE REFERENCE DEREFERENCES IT. Upstream writes
    ; `name.Text()` with no null test, on the grounds that every one of its six call
    ; sites passes a declaration name that the parser guarantees — an interface, a
    ; type alias and a type parameter all take one, and a missing one is a parse
    ; error that produces a MISSING identifier node rather than nil. This port
    ; keeps the guard anyway because AstNode.identifier_text_of dereferences and
    ; identifier_text_length_of answers 0 for a missing node, which compares equal
    ; to no spelling in the list — so the guard changes no answer and removes a way
    ; for a later caller to crash. ★It is NOT a place a report is being skipped:
    ; a missing name has no text to be one of the eleven.
    ;
    ; ★ The message ARGUMENT (`name.Text()` again, filling the `{0}`) is not
    ; computed, for check_grammar_modifiers' reason: the dump is `C pos end code`
    ; and a message's code does not depend on its arguments.
    procedure check_type_name_is_reserved(this, name: ref[AstNode]?, code: int)
    {
        if name = null
            return
        var reserved false
        if Checker.identifier_text_equals(name, "any")
            set reserved: true
        if Checker.identifier_text_equals(name, "unknown")
            set reserved: true
        if Checker.identifier_text_equals(name, "never")
            set reserved: true
        if Checker.identifier_text_equals(name, "number")
            set reserved: true
        if Checker.identifier_text_equals(name, "bigint")
            set reserved: true
        if Checker.identifier_text_equals(name, "boolean")
            set reserved: true
        if Checker.identifier_text_equals(name, "string")
            set reserved: true
        if Checker.identifier_text_equals(name, "symbol")
            set reserved: true
        if Checker.identifier_text_equals(name, "void")
            set reserved: true
        if Checker.identifier_text_equals(name, "object")
            set reserved: true
        if Checker.identifier_text_equals(name, "undefined")
            set reserved: true
        if reserved
            this.error_on_node(name, code, Checker.arg_text(AstNode.identifier_text_of(name)))
    }

    ; checkInterfaceDeclaration's first five lines, which is everything up to
    ; checkExportsOnMergedDeclarations.
    ;
    ; ★★★ THE ARM STOPS AT A FUNCTION THE TYPE-ALIAS ARM ALSO STOPS AT, and that
    ; is why the two land in one slice. checkTypeAliasDeclaration's own prefix is
    ; the same three steps in a different ORDER — modifiers, reserved name,
    ; container, checkExportsOnMergedDeclarations — so porting the reserved-name
    ; check for the interface and leaving the alias reporting one call in FRONT of
    ; it would have been a boundary drawn by which arm was being edited.
    ;
    ; ★★★ THE containerAllowsBlockScopedVariable LINE WAS DATED HERE BY SLICE 53
    ; AND THE DATING PAID FOR ITSELF. Its note said the line was one statement
    ; away, that the tag it stood behind was reached only on the MODIFIER-ERROR
    ; path (6 units of 17 855), and that porting it alone would still leave the arm
    ; behind checkGrammarInterfaceDeclaration — all three correct, and this slice
    ; had to re-derive none of it. ★What the note could not say, because the stub's
    ; fork made it unaskable, is the line's OWN population: the `if
    ; !c.checkGrammarModifiers(node)` guards the grammar call and nothing else, so
    ; the container test is the arm's second statement, unconditional, and runs on
    ; every interface. The 6 was the tag's population, not the line's — which is
    ; what "this tag's whole stage-2 row" already said, read at the right level.
    ;
    ; ★★ THE CONTAINER REPORT IS UNREACHABLE ON THIS CORPUS AND IS PORTED ANYWAY,
    ; with the argument container_allows_block_scoped_variable's own header
    ; already carries: every parent an interface can have in reach (SourceFile,
    ; ModuleBlock, Block) falls through to the permissive answer, and the refusing
    ; kinds are the seven loop/if/with statements, whose arms are unported — so
    ; nothing can put an interface under one. It is the same shape slice 53's f10
    ; measured from the other side, and the control battery holds it to a number
    ; rather than to an argument.
    procedure check_interface_declaration(this, node: ref[AstNode])
    {
        if this.check_grammar_modifiers(node) = false
            this.check_grammar_interface_declaration(node)
        if this.container_allows_block_scoped_variable(AstNode.parent_node_of(node)) = false
            this.grammar_error_on_node(node, DiagX_0_declarations_can_only_be_declared_inside_a_block, "interface")
        this.check_type_parameters(AstNode.type_parameters_of(node))
        this.check_type_name_is_reserved(AstNode.name_of(node), DiagInterface_name_cannot_be_0)
        this.check_exports_on_merged_declarations(node)
        ; ★★★ SLICE 66 MOVES THE STOP PAST THE DECLARED TYPE, and what stops the
        ; once-block now is checkInheritedPropertiesAreIdentical — whose first line
        ; is getBaseTypes. ★★★SLICE 77 RETIRES THE SECOND HALF OF THAT NOTE, which
        ; read *"the rest of the arm sits behind that, so it is still one row"*:
        ; only the two checkIndexConstraints calls sit behind it. The reference
        ; LEAVES the once-block and keeps going, and the four statements after it —
        ; checkObjectTypeForDuplicateDeclarations, the extends heritage walk, the
        ; members walk, the duplicate index signatures — are now outside it here too.
        let symbol this.symbol_of_declaration(node)
        if symbol = null
            return
        let sym symbol as ref[Symbol]
        this.check_type_parameter_lists_identical(sym)
        ; ★★★ AND THERE IS NO EARLY EXIT AFTER IT, WHICH SLICE 94 HAD TO REMOVE AND
        ; WHICH IS WORTH MORE THAN THE TWO LINES IT COST. checkTypeParameterLists
        ; Identical is a `procedure`: it reports TS2428 or it stops, and NOTHING
        ; downstream reads a value from it — the reference has no exit between it and
        ; the tail either. The guard that stood here was
        ; `if this.unported_mark() <> unported_before  return`, and **`is_unported()` is
        ; a BOOL — *has this unit stopped at all* — so the guard fired only when this
        ; call was the unit's FIRST stop.** That made the members walk of a merged
        ; interface depend on whether some EARLIER declaration in the same file had
        ; already stopped: it ran while `checkPropertyInitialization` still stopped on
        ; every class, and stopped running the day slice 94 closed that row. Measured:
        ; two TS7010 lost at stage 2, in the two `classWithMultipleBaseClasses` units,
        ; where a class stands before a merged interface.
        ;
        ; ★★★ THE CLASS THIS BELONGS TO IS SLICE 85's — *a marker is about its own
        ; object* — arriving from the far side: a guard built on the sticky FLAG is a
        ; no-op for every unit that has already spoken, so it is dormant until
        ; something removes the earlier stop, and then it wakes up as a LOSS. **A
        ; diagnostic loss is the direction diagcheck's subsequence cannot see**, and
        ; the only instrument that caught this was the old-against-new comparison over
        ; the same corpus. Any slice that CLOSES a row owes that comparison.
        ; ★★★ THE ONCE-BLOCK IS ITS OWN PROCEDURE, AND THAT IS THE WHOLE STRUCTURAL
        ; CONTENT OF THE SLICE ON THIS ARM. Its body returns at five places — every
        ; one a value it cannot compute — and while the block was inline each of
        ; those `return`s took the ARM's tail with it. So the tail was unreachable
        ; for exactly the interfaces that need it most: any interface with an
        ; `extends` clause stops at `resolve-entity-name` inside getDeclaredType
        ; OfSymbol, and TS2499 is a report ABOUT an extends clause. **An early exit
        ; written for one block's own failure silently became an early exit for
        ; everything after it** — which is a shape worth recognising rather than a
        ; defect of that slice: the block only grew a successor here.
        this.check_interface_declaration_once(node, sym)
        ; ★★★ AND WHAT FOLLOWS RUNS WHETHER OR NOT THAT REPORTED, because the
        ; reference has no early exit between them. record_unported marks the unit
        ; and does not abort — this file's convention since slice 52 — and
        ; diagcheck's relation is a subsequence, so a report past a hole is sound.
        ; What the four statements buy: checkObjectTypeForDuplicateDeclarations
        ; (ported since slice 73, and this is its FALSE call site — the flag existed
        ; with no input until now), the extends heritage grammar report TS2499, the
        ; MEMBERS walk, and the duplicate index signatures.
        this.check_object_type_for_duplicate_declarations(node, false)
        ; The extends heritage walk. `IsEntityNameExpression && !IsOptionalChain` is
        ; the reference's condition and the report is on the EXPRESSION, not on the
        ; heritage element.
        let extends_elems Checker.get_extends_heritage_clause_elements(node)
        if extends_elems <> null
        {
            let ee extends_elems as ref[Array[ref[AstNode]?]]
            let en ee.get_length() as int
            var ei 0
            while ei < en
            {
                let he ee[ei]
                set ei: ei + 1
                if he = null
                    continue
                let hn he as ref[AstNode]
                let expr AstNode.expression_of(hn)
                if expr <> null
                {
                    let ex expr as ref[AstNode]
                    var bad false
                    if Binder.is_entity_name_expression(ex) = false
                        set bad: true
                    if Binder.is_optional_chain(ex)
                        set bad: true
                    if bad
                        this.error_on_node(ex, DiagAn_interface_can_only_extend_an_identifier_Slashqualified_name_with_optional_type_arguments)
                }
                this.check_type_reference_node(hn)
            }
        }
        this.check_source_elements(AstNode.member_list_of(node))
        this.check_class_or_interface_for_duplicate_index_signatures(node)
        this.register_for_unused_identifiers_check(node)
    }

    ; checkInterfaceDeclaration's `if !links.interfaceChecked` block, lifted whole.
    ; Its five `return`s are the reference's *"run subsequent checks only if first
    ; set succeeded"* plus this port's four missing values; none of them may reach
    ; the arm's tail, which is why the block is a procedure. See the call site.
    procedure check_interface_declaration_once(this, node: ref[AstNode], sym: ref[Symbol])
    {
        let unported_before this.unported_mark()
        let links this.declared_type_link_of(sym)
        if links.interface_checked = false
        {
            set links.interface_checked: true
            let t this.get_declared_type_of_symbol(sym)
            if this.unported_mark() <> unported_before
                return
            if t = null
                return
            let type_with_this this.get_type_with_this_argument(t as ref[Type], null, false)
            if this.unported_mark() <> unported_before
                return
            ; ★★★ SLICE 67 MOVES THE INTERFACE PAST ITS BASE TYPES, and for every
            ; interface on this corpus that list is EMPTY — all 43 units reaching
            ; here at stage 1 carry no `extends` clause on any declaration. So
            ; checkInheritedPropertiesAreIdentical answers TRUE on its second
            ; line, the assignability loop below runs zero times, and what stops
            ; the arm is checkIndexConstraints — i.e. resolveDeclaredMembers,
            ; which is the members dimension rather than the base one.
            let identical this.check_inherited_properties_are_identical(t as ref[Type], AstNode.name_of(node))
            if this.unported_mark() <> unported_before
                return
            if identical
            {
                let bases this.get_base_types(t as ref[Type])
                if this.unported_mark() <> unported_before
                    return
                ; ── slice 124: TS2430 ────────────────────────────────────────
                ; checkTypeAssignableTo(typeWithThis, getTypeWithThisArgument(
                ; baseType, thisType), name, TS2430) — the head message is what
                ; makes this a CODE and not a TS2322, and it landed in this slice.
                ;
                ; ★★★ THE UNWRAP BELONGS INSIDE THE NULL TEST AND THE FIRST DRAFT
                ; PUT IT OUTSIDE, which is exit 21 on every interface with no
                ; `extends` — a count of 0 does not stop `bases as ref[...]` from
                ; running. It killed a whole batch chunk and surfaced as *our
                ; dumper exited 21* on 180 units of six artifacts each.
                ; ★And the guard SKIPS the loop rather than returning: the
                ; reference's `for _, baseType := range getBaseTypes(t)` over an
                ; empty list falls through to checkIndexConstraints and the
                ; members walk, so a `return` here would drop the whole tail of
                ; the once-block for every interface without an `extends`.
                if bases <> null
                {
                    if type_with_this <> null
                    {
                        let bl bases as ref[Array[ref[Type]?]]
                        let bn bl.get_length() as int
                        let twt type_with_this as ref[Type]
                        var bi 0
                        while bi < bn
                        {
                            let brow bl[bi]
                            set bi: bi + 1
                            if brow = null
                                continue
                            let base_with_this this.get_type_with_this_argument(brow as ref[Type], Checker.this_type_of(t as ref[Type]), false)
                            if this.unported_mark() <> unported_before
                                return
                            if base_with_this = null
                                return
                            this.check_type_assignable_to(twt, base_with_this as ref[Type], AstNode.name_of(node), DiagInterface_0_incorrectly_extends_interface_1)
                            if this.unported_mark() <> unported_before
                                return
                        }
                    }
                }
                ; ★★★ SLICE 85 MAKES THIS A REAL CALL, and the interface is the
                ; container kind the members chapter covers: a non-generic
                ; interface free of `this` gets no ObjectFlagsReference, so
                ; resolveStructuredTypeMembers takes the class-or-interface arm.
                ; What still stops here is a GENERIC interface, one that mentions
                ; `this`, and one whose index signatures give
                ; checkIndexConstraints something to compare.
                if this.unported_mark() = unported_before
                    this.check_index_constraints(t as ref[Type], sym, false)
            }
            ; checkInheritedPropertiesAreIdentical answering FALSE means it
            ; reported, and the reference's `if` has no else — so nothing else
            ; belongs in this block.
        }
    }

    ; getClassOrInterfaceDeclarationsOfSymbol — `core.Filter(symbol.Declarations,
    ; IsClassDeclaration || IsInterfaceDeclaration)`. ★A CLASS EXPRESSION is not on
    ; that list, which is what makes `const C = class<T> {}` merged with an
    ; interface answer one declaration and skip the check.
    procedure get_class_or_interface_declarations_of_symbol(this, symbol: ref[Symbol]) returns ref[Array[ref[AstNode]?]]
    {
        let out this.new_node_list()
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let k AstNode.kind_of(d as ref[AstNode])
                if k = KindClassDeclaration
                    out.add(d)
                if k = KindInterfaceDeclaration
                    out.add(d)
            }
            set i: i + 1
        }
        out
    }

    ; ── slice 124: areTypeParametersIdentical ─────────────────────────────────
    ;
    ; ★★★ THE THIRD PARAMETER IS A FUNC VALUE UPSTREAM AND IT IS A BOOLEAN HERE, per
    ; §3.18's rule. The note that stood here said the func was DROPPED *because
    ; `getTypeParameterDeclarations` has exactly ONE argument at the one call site*
    ; — and slice 179 gave it a SECOND caller with the other closure, checkInferType's
    ; `func(decl) { return []*ast.Node{decl} }`. **A simplification argued from "one
    ; call site" expires the slice that adds the second**, and the shape it expires
    ; into is still not a delegate: the two closures are two compile-time facts, so
    ; the flag names which of them, and `_ex` carries it.
    ;
    ; ★★ EVERY COMPARISON IS ONE-SIDED IN THE SAME DIRECTION, and that is the
    ; reference's own relaxation rather than an omission: a constraint or default
    ; present on the TARGET and absent on the SOURCE is accepted (`constraintNode !=
    ; nil && targetConstraint != nil && …`), because a later interface augmentation
    ; with no constraint is broader and may merge with a narrower one. Reading those
    ; two conjuncts as a null-guard rather than as the rule would make the function
    ; report on legal code.
    procedure are_type_parameters_identical(this, declarations: ref[Array[ref[AstNode]?]], target_parameters: ref[Array[ref[Type]?]]?) returns bool
        this.are_type_parameters_identical_ex(declarations, target_parameters, false)

    ; `declaration_is_the_parameter` is checkInferType's closure: the declaration IS
    ; its own single type-parameter declaration, so the source list is the one node.
    procedure are_type_parameters_identical_ex(this, declarations: ref[Array[ref[AstNode]?]], target_parameters: ref[Array[ref[Type]?]]?, declaration_is_the_parameter: bool) returns bool
    {
        var max_type_argument_count 0
        var min_type_argument_count 0
        if target_parameters <> null
        {
            let tp target_parameters as ref[Array[ref[Type]?]]
            set max_type_argument_count: tp.get_length() as int
            set min_type_argument_count: this.get_min_type_argument_count(tp)
        }
        let dn declarations.get_length() as int
        var di 0
        while di < dn
        {
            let drow declarations[di]
            set di: di + 1
            if drow = null
                continue
            let declaration drow as ref[AstNode]
            let source_parameters AstNode.type_parameters_of(declaration)
            var sn AstNode.list_count(source_parameters)
            if declaration_is_the_parameter
                set sn: 1
            if sn < min_type_argument_count
                return false
            if sn > max_type_argument_count
                return false
            var i 0
            while i < sn
            {
                var source: ref[AstNode]? AstNode.child_in_list(source_parameters, i)
                if declaration_is_the_parameter
                    set source: drow
                set i: i + 1
                if source = null
                    continue
                if target_parameters = null
                    return false
                let target_row (target_parameters as ref[Array[ref[Type]?]])[i - 1]
                if target_row = null
                    return false
                let target target_row as ref[Type]
                let src source as ref[AstNode]
                ; `source.Name().Text() != target.symbol.Name`.
                let sname AstNode.name_of(src)
                if sname = null
                    return false
                if target.symbol = null
                    return false
                let nd AstNode.identifier_text_of(sname)
                let nl AstNode.identifier_text_length_of(sname)
                if Checker.symbol_name_matches(target.symbol as ref[Symbol], nd) = false
                    return false
                let constraint_node AstNode.type_parameter_constraint_of(src)
                let target_constraint this.get_constraint_of_type_parameter(target)
                if constraint_node <> null
                {
                    if target_constraint <> null
                    {
                        let ct this.get_type_from_type_node(constraint_node as ref[AstNode])
                        if ct = null
                            return false
                        if this.is_type_identical_to(ct as ref[Type], target_constraint as ref[Type]) = false
                            return false
                    }
                }
                let default_node AstNode.type_parameter_default_of(src)
                let target_default this.get_default_from_type_parameter(target)
                if default_node <> null
                {
                    if target_default <> null
                    {
                        let dt this.get_type_from_type_node(default_node as ref[AstNode])
                        if dt = null
                            return false
                        if this.is_type_identical_to(dt as ref[Type], target_default as ref[Type]) = false
                            return false
                    }
                }
            }
        }
        true
    }

    ; ── slice 124: checkTypeParameterListsIdentical ───────────────────────────
    ;
    ; ★ The links bit IS set before the report, as the reference sets it — the first
    ; statement inside the block — and the note that used to stand here had it the
    ; other way round for a stop's sake: with the body a stop, setting the bit first
    ; would have made a second ask answer *checked* about a check that never ran.
    ; With the body ported the reference's order is the right one, and the memo is
    ; what keeps a merged interface's TS2428 single.
    procedure check_type_parameter_lists_identical(this, symbol: ref[Symbol])
    {
        if Symbol.declaration_count(symbol) = 1
            return
        let links this.declared_type_link_of(symbol)
        if links.type_parameters_checked
            return
        set links.type_parameters_checked: true
        let declarations this.get_class_or_interface_declarations_of_symbol(symbol)
        if (declarations.get_length() as int) <= 1
            return
        let mark this.unported_mark()
        let t this.get_declared_type_of_symbol(symbol)
        if this.unported_mark() <> mark
            return
        if t = null
            return
        let local this.local_type_parameters_of(t as ref[Type])
        let identical this.are_type_parameters_identical(declarations, local)
        if this.unported_mark() <> mark
            return
        if identical
            return
        let symbol_name this.symbol_arg(symbol)
        let dn declarations.get_length() as int
        var i 0
        while i < dn
        {
            let d declarations[i]
            if d <> null
                this.error_on_node(AstNode.name_of(d as ref[AstNode]), DiagAll_declarations_of_0_must_have_identical_type_parameters, symbol_name)
            set i: i + 1
        }
    }

    ; checkTypeAliasDeclaration's first four lines. The arm serves both
    ; TypeAliasDeclaration and JSTypeAliasDeclaration, as the reference's switch
    ; does — one `case` with two kinds.
    ;
    ; ★★★ ITS ORDER IS NOT THE INTERFACE'S ORDER, AND THE FIRST READING OF WHAT
    ; THAT COSTS WAS WRONG. The alias asks the reserved name BEFORE the container
    ; test; the interface asks it AFTER checkTypeParameters, which is a hole here —
    ; so `interface never<T> {}` was predicted to report nothing while `type
    ; never<T> = T` reported TS2457. Both report. record_unported MARKS the unit
    ; and does not RETURN, so the C section runs on past a hole, which is this
    ; file's convention since slice 52 and is sound because diagcheck's relation is
    ; a subsequence. ★★What the order really moves is the TAG: the generic
    ; interface carries `check-type-parameter` and the generic alias carried
    ; `check-exports-on-merged-declarations`. The two fixtures named after that pair
    ; are the only witness, because no yardstick compares a tag. ★★★SLICE 65 MOVED
    ; THE SECOND HALF OF THAT SENTENCE TO NOTHING: this arm has no stop any more, so
    ; the generic alias carries whatever its own type node reports and a plain one
    ; carries no tag at all. The asymmetry it describes is still real and still what
    ; decides which report a `never` name gets; only the alias side's tag is gone.
    ;
    ; ★ checkTypeParameters was BELOW the stop (upstream computes typeNode and
    ; typeParameters after checkExportsOnMergedDeclarations), which is the other half
    ; of the same asymmetry and the reason the alias arm did not call it. Slice 65
    ; reaches it.
    ;
    ; ★★★ SLICE 65: THIS IS THE WHOLE ARM, AND IT IS THE FIRST DECLARATION ARM OF
    ; THIS FILE THAT NEEDS NO TYPE. Everything below the head is syntax: the type
    ; parameters, the `intrinsic` keyword's two shapes, the type node's own walk.
    ; Nothing here asks for a symbol's type, so nothing stops — and what that costs
    ; is stated rather than celebrated, because a completed arm is only as complete
    ; as the walk below it (`checkSourceElement(typeNode)` reports at ITS own sites,
    ; which is where a `type X = SomeReference` still stops).
    ;
    ; ★★ registerForUnusedIdentifiersCheck IS DELIBERATELY NOT PORTED, at this site
    ; and at every other one this slice reaches, and the argument is §3.5be's with a
    ; measurement rather than a guess: the list's only reader is
    ; checkUnusedIdentifiers, gated in checkSourceFileWorker by `checkUnused :=
    ; NoUnusedLocals.IsTrue() || NoUnusedParameters.IsTrue() || collection ==
    ; &c.suggestionDiagnostics`. Both options are unset under this harness and the
    ; oracle asks GetDiagnostics, whose collection is `c.diagnostics` — so the gate
    ; is false, the reader never runs, and porting the writer would be a list nobody
    ; reads. ★And even with the gate open every report goes through reportUnused,
    ; which sends a non-error to the SUGGESTION list; only NoUnusedLocals set to
    ; TRUE makes one an error. Two independent reasons, both of them the option.
    procedure check_type_alias_declaration(this, node: ref[AstNode])
    {
        this.check_grammar_modifiers(node)
        this.check_type_name_is_reserved(AstNode.name_of(node), DiagType_alias_name_cannot_be_0)
        if this.container_allows_block_scoped_variable(AstNode.parent_node_of(node)) = false
            this.grammar_error_on_node(node, DiagX_0_declarations_can_only_be_declared_inside_a_block, "type")
        this.check_exports_on_merged_declarations(node)

        let type_node AstNode.type_of(node)
        let type_parameters AstNode.type_parameters_of(node)
        this.check_type_parameters(type_parameters)
        if Checker.kind_or_unknown(type_node) = KindIntrinsicKeyword
        {
            if this.type_alias_intrinsic_is_legal(node, type_parameters) = false
                this.error_on_node(type_node, DiagThe_intrinsic_keyword_can_only_be_used_to_declare_compiler_provided_intrinsic_types)
            return
        }
        this.check_source_element(type_node)
        this.register_for_unused_identifiers_check(node)
    }

    ; The negated condition of checkTypeAliasDeclaration's `intrinsic` report, as
    ; its own function because the reference writes it as one `!( … || … )` over two
    ; lines and the report reads backwards at the call site otherwise.
    ;
    ; ★★★ TWO LEGAL SHAPES AND THEY DO NOT OVERLAP: no type parameters and the name
    ; `BuiltinIteratorReturn`, or exactly ONE type parameter and a name in
    ; intrinsicTypeKinds. So `type Uppercase = intrinsic` is an error and so is
    ; `type BuiltinIteratorReturn<T> = intrinsic` — the arity is part of the name's
    ; licence, not a separate check.
    ;
    ; ★★ intrinsicTypeKinds IS FIVE NAMES AND IS PORTED AS THE FIVE, not as a table:
    ; its VALUE (which intrinsic-type kind) is read at three other sites, all of them
    ; inside getStringMappingType and its neighbours, and this caller reads only
    ; `!= IntrinsicTypeKindUnknown` — i.e. membership. A table with no reader for its
    ; values would be §3.5be again. The slice that ports the string-mapping types
    ; brings the values with it.
    function type_alias_intrinsic_is_legal(this, node: ref[AstNode], type_parameters: ref[Array[ref[AstNode]?]]?) returns bool
    {
        let name AstNode.name_of(node)
        let arity AstNode.list_count(type_parameters)
        if arity = 0
            return Checker.identifier_text_equals(name, "BuiltinIteratorReturn")
        if arity <> 1
            return false
        if Checker.identifier_text_equals(name, "Uppercase")
            return true
        if Checker.identifier_text_equals(name, "Lowercase")
            return true
        if Checker.identifier_text_equals(name, "Capitalize")
            return true
        if Checker.identifier_text_equals(name, "Uncapitalize")
            return true
        Checker.identifier_text_equals(name, "NoInfer")
    }

    ; checkEnumDeclaration's first line. Unlike the two above, the result is
    ; DISCARDED here — the reference writes `c.checkGrammarModifiers(node)` on its
    ; own line — so there is one continuation and one tag.
    ;
    ; ★ SLICE 59: the collision head is ported, so the arm walks on to
    ; checkExportsOnMergedDeclarations — and `enum any {}` reports TS2431 on the way,
    ; the enum half of check_type_name_is_reserved's two callers in that head.
    ;
    ; ★★★ SLICE 65 GIVES IT THE MEMBERS WALK, AND THE WALK IS WHY THE ENUM MEMBER
    ; ARM IS IN THIS SLICE. `checkSourceElements(node.Members())` is the line right
    ; after the head, so the moment the head lands every enum's members are handed
    ; to checkSourceElement — and with no EnumMember arm the whole family would have
    ; taken the bare `check` tag, regrowing the row slice 64 emptied and naming the
    ; container's walk as the blocker of the member. checkEnumMember is six lines.
    ; ★It is the §3.5cd rule from the other direction: a container arm's walk is
    ; most of what the arm delivers, so the walk decides which OTHER arm belongs in
    ; the slice.
    ;
    ; ★★ THE ONCE-BIT BLOCK BELOW computeEnumMemberValues IS THE SECOND OBSTACLE AND
    ; IS NAMED HERE RATHER THAN TAGGED: `declaredTypeLinks.Get(enumSymbol).enumChecked`
    ; gates the two const-consistency reports (TS2473, TS2432), and it is a
    ; PER-SYMBOL side table this port has none of — the merged-declaration head one
    ; screen up needs no such table because its once-guard is a node identity test
    ; (GetDeclarationOfKind), which is the difference between "run once per symbol"
    ; and "run on the first declaration". The tag stays on the value computation,
    ; because that is what stops first.
    procedure check_enum_declaration(this, node: ref[AstNode])
    {
        this.check_grammar_modifiers(node)
        this.check_collisions_for_declaration_name(node, AstNode.name_of(node))
        this.check_exports_on_merged_declarations(node)
        this.check_source_elements(AstNode.member_list_of(node))
        if this.should_check_erasable_syntax(node)
        {
            if (AstNode.flags_of(node) & NodeFlagsAmbient) = 0
                this.error_on_node(node, DiagThis_syntax_is_not_allowed_when_erasableSyntaxOnly_is_enabled)
        }
        this.compute_enum_member_values(node)
        ; Spec 2014 §9.3: one enum declaration cannot continue another's automatic
        ; numbering, and only ONE declaration of a merged enum may omit the value
        ; of its first member. ★★ THE ONCE-BIT IS PER SYMBOL AND NOT PER NODE, and
        ; the header two screens up called that *a side table this port has none
        ; of* — it was true when written and false since slice 77 (§3.5p), because
        ; declared_type_links already carries two once-bits of the same shape.
        let enum_symbol this.get_symbol_of_declaration(node)
        if enum_symbol = null
            return
        let es enum_symbol as ref[Symbol]
        let links this.declared_type_link_of(es)
        if links.enum_checked
            return
        set links.enum_checked: true
        let dn Symbol.declaration_count(es)
        if dn > 1
        {
            let enum_is_const this.is_enum_const(node)
            var i 0
            while i < dn
            {
                let decl Symbol.declaration_at(es, i)
                if Checker.kind_or_unknown(decl) = KindEnumDeclaration
                {
                    if this.is_enum_const(decl) <> enum_is_const
                        this.error_on_node(b.get_name_of_declaration(decl), DiagEnum_declarations_must_all_be_const_or_non_const)
                }
                set i: i + 1
            }
        }
        var seen_missing_initial_initializer false
        var j 0
        while j < dn
        {
            let decl Symbol.declaration_at(es, j)
            if Checker.kind_or_unknown(decl) = KindEnumDeclaration
            {
                let members AstNode.member_list_of(decl)
                if members <> null
                {
                    let ml members as ref[Array[ref[AstNode]?]]
                    if (ml.get_length() as int) <> 0
                    {
                        let first ml[0]
                        if first <> null
                        {
                            if AstNode.initializer_of(first as ref[AstNode]) = null
                            {
                                if seen_missing_initial_initializer
                                    this.error_on_node(AstNode.name_of(first as ref[AstNode]), DiagIn_an_enum_with_multiple_declarations_only_one_declaration_can_omit_an_initializer_for_its_first_enum_element)
                                else
                                    set seen_missing_initial_initializer: true
                            }
                        }
                    }
                }
            }
            set j: j + 1
        }
    }

    ; checkEnumMember, whole.
    ;
    ; ★ The private-identifier report is on the NODE and not on the name, which is
    ; the reference's span and reads as a mistake at the call site — `c.error(node,
    ; …)` under `if ast.IsPrivateIdentifier(node.Name())`. Left as it is: the span is
    ; the specification.
    ;
    ; ★★ AN ENUM MEMBER WITH NO INITIALIZER COMPLETES, and that is the only shape of
    ; this arm that does. `enum E { A, B }` is finished here; `enum E { A = 1 }`
    ; stops at check-expression, and the auto-numbering that would give A its value
    ; is not this function's business at all — computeEnumMemberValues does it from
    ; the declaration arm.
    procedure check_enum_member(this, node: ref[AstNode])
    {
        if Checker.kind_or_unknown(AstNode.name_of(node)) = KindPrivateIdentifier
            this.error_on_node(node, DiagAn_enum_member_cannot_be_named_with_a_private_identifier)
        let initializer AstNode.initializer_of(node)
        if initializer <> null
            this.check_expression(initializer as ref[AstNode])
    }

    ; ── slice 116: the ENUM, and the value that is not a type ────────────────
    ;
    ; ★★★ THE CHAPTER IS ONE ANSWER READ THREE WAYS. `enum E { A = 1 }` needs a
    ; VALUE for A (an ECMAScript constant-expression evaluation, which is what
    ; internal/evaluator is), a TYPE for A (an enum literal type keyed on that
    ; value), and a type for E (the union of its members'). Every one of the seven
    ; enum stops this slice closes is downstream of the first: `get-declared-type-of-enum`
    ; cannot answer without a value, `get-type-of-enum-member` cannot answer
    ; without the declared type, and `type-to-string-enum` cannot print without
    ; either. That is why they are one slice and not seven.
    ;
    ; ★★ THE EVALUATOR IS A METHOD FAMILY AND NOT A CLOSURE. Upstream it is
    ; `evaluator.NewEvaluator(c.evaluateEntity, ast.OEKParentheses)`, a function
    ; VALUE built once per checker over one callback and one flag word — and both
    ; arguments are static at the single call site, so §3.5e's rule applies twice
    ; over: the callback becomes a direct call to `evaluate_entity` and the flag
    ; word becomes the literal `OEKParentheses` inside `evaluate`. What is lost is
    ; the reference's ability to build a SECOND evaluator with a different skip
    ; set; nothing upstream does, and the day something does, that argument comes
    ; back as a parameter.

    ; c.enumMemberLinks.Get — node_link_of's idiom, keyed on the member node.
    procedure enum_member_link_of(this, node: ref[AstNode]) returns ref[EnumMemberLink]
    {
        let ix enum_member_links_index
        let at ix.find(node as int)
        if at > 0
        {
            let row enum_member_links[at - 1]
            if row <> null
                return row as ref[EnumMemberLink]
        }
        let made &EnumMemberLink^host(node)
        enum_member_links.add(made)
        ix.insert(node as int, (enum_member_links.get_length() as int) - 1)
        made
    }

    ; ast.IsEnumConst — `GetCombinedModifierFlags(node)&ModifierFlagsConst != 0`,
    ; through the binder's cached form the rest of this file already calls.
    function is_enum_const(this, node: ref[AstNode]?) returns bool
        (b.combined_modifier_flags(node) & ModifierFlagsConst) <> 0

    ; evaluator.NewResult(nil, false, false, false) — the answer five arms of the
    ; evaluator and three of the value computation share.
    function eval_none() returns EvalResult
        EvalResult(EvalKindNone, Slice[char](), 0 as u64, false, false, false)

    function eval_number(bits: u64) returns EvalResult
        EvalResult(EvalKindNumber, Slice[char](), bits, false, false, false)

    ; Bytes on the checker's page, for the two arms that BUILD a string rather
    ; than borrowing one from the parse: `"a" + "b"` and a template. Everything
    ; else in EvalResult points into the source (see the record's note).
    procedure alloc_bytes(this, n: int) returns pointer[char]
        host.allocate((n + 1) as size_t, 1 as size_t) as pointer[char]

    ; ── internal/evaluator/evaluator.go ─────────────────────────────────────
    ;
    ; The closure's body, whole. ★★ THE THREE LOCALS ARE THE POINT of the
    ; reference's shape and are transcribed as locals here: an arm that cannot
    ; produce a VALUE still contributes `resolvedOtherFiles` and
    ; `hasExternalReferences` to the answer, so the fall-through at the foot is
    ; not `nil` — it is nil WITH the flags the arm collected. Reading the tail as
    ; a plain failure is how a cross-file enum reference loses its mark.
    procedure evaluate(this, expr_in: ref[AstNode]?, location: ref[AstNode]?) returns EvalResult
    {
        var is_syntactically_string false
        var resolved_other_files false
        var has_external_references false
        let expr Parser.skip_outer_expressions(expr_in, OEKParentheses)
        if expr = null
            return Checker.eval_none()
        let e expr as ref[AstNode]
        let k AstNode.kind_of(e)

        if k = KindPrefixUnaryExpression
        {
            let result this.evaluate(AstNode.prefix_unary_operand_of(e), location)
            set resolved_other_files: result.resolved_other_files
            set has_external_references: result.has_external_references
            if result.kind = EvalKindNumber
            {
                let op AstNode.prefix_unary_operator_kind(e)
                if op = KindPlusToken
                    return EvalResult(EvalKindNumber, Slice[char](), result.bits, is_syntactically_string, resolved_other_files, has_external_references)
                if op = KindMinusToken
                    return EvalResult(EvalKindNumber, Slice[char](), jsnum_negate_value(result.bits), is_syntactically_string, resolved_other_files, has_external_references)
                if op = KindTildeToken
                    return EvalResult(EvalKindNumber, Slice[char](), jsnum_bitwise_not(result.bits), is_syntactically_string, resolved_other_files, has_external_references)
            }
        }

        if k = KindBinaryExpression
        {
            let left this.evaluate(AstNode.binary_left_of(e), location)
            let right this.evaluate(AstNode.binary_right_of(e), location)
            let op AstNode.binary_operator_kind(e)
            if op = KindPlusToken
            {
                if left.is_syntactically_string
                    set is_syntactically_string: true
                if right.is_syntactically_string
                    set is_syntactically_string: true
            }
            if left.resolved_other_files
                set resolved_other_files: true
            if right.resolved_other_files
                set resolved_other_files: true
            if left.has_external_references
                set has_external_references: true
            if right.has_external_references
                set has_external_references: true
            let left_is_num left.kind = EvalKindNumber
            let right_is_num right.kind = EvalKindNumber
            if left_is_num
            {
                if right_is_num
                {
                    var bits 0 as u64
                    var got false
                    if op = KindBarToken
                    {
                        set bits: jsnum_bitwise_or(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindAmpersandToken
                    {
                        set bits: jsnum_bitwise_and(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindGreaterThanGreaterThanToken
                    {
                        set bits: jsnum_signed_right_shift(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindGreaterThanGreaterThanGreaterThanToken
                    {
                        set bits: jsnum_unsigned_right_shift(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindLessThanLessThanToken
                    {
                        set bits: jsnum_left_shift(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindCaretToken
                    {
                        set bits: jsnum_bitwise_xor(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindAsteriskToken
                    {
                        set bits: jsnum_multiply(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindSlashToken
                    {
                        set bits: jsnum_divide(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindPlusToken
                    {
                        set bits: jsnum_add(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindMinusToken
                    {
                        set bits: jsnum_subtract(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindPercentToken
                    {
                        set bits: jsnum_remainder(left.bits, right.bits)
                        set got: true
                    }
                    if op = KindAsteriskAsteriskToken
                    {
                        set bits: jsnum_exponentiate(left.bits, right.bits)
                        set got: true
                    }
                    if got
                        return EvalResult(EvalKindNumber, Slice[char](), bits, is_syntactically_string, resolved_other_files, has_external_references)
                }
            }
            ; `(leftIsStr || leftIsNum) && (rightIsStr || rightIsNum) && operator == +`
            ; — a number is stringified through jsnum's own ToString, which is what
            ; makes `1 + "a"` the string `1a` rather than a failed evaluation.
            if op = KindPlusToken
            {
                let left_str Checker.eval_has_value(left) and (left.kind = EvalKindString)
                let right_str Checker.eval_has_value(right) and (right.kind = EvalKindString)
                let left_ok left_str or left_is_num
                let right_ok right_str or right_is_num
                if left_ok and right_ok
                    return this.concat_eval_results(left, right, is_syntactically_string, resolved_other_files, has_external_references)
            }
        }

        if k = KindStringLiteral
            return EvalResult(EvalKindString, AstNode.literal_text_of(e), 0 as u64, true, false, false)
        if k = KindNoSubstitutionTemplateLiteral
            return EvalResult(EvalKindString, AstNode.literal_text_of(e), 0 as u64, true, false, false)

        if k = KindTemplateExpression
            return this.evaluate_template_expression(e, location)

        if k = KindNumericLiteral
            return Checker.eval_number(jsnum_from_string(AstNode.literal_text_of(e)))

        if k = KindIdentifier
            return this.evaluate_entity(e, location)

        if k = KindElementAccessExpression
        {
            if Parser.is_entity_name_expression(AstNode.expression_of(e))
                return this.evaluate_entity(e, location)
        }
        if k = KindPropertyAccessExpression
        {
            if Parser.is_entity_name_expression(AstNode.expression_of(e))
                return this.evaluate_entity(e, location)
        }

        EvalResult(EvalKindNone, Slice[char](), 0 as u64, is_syntactically_string, resolved_other_files, has_external_references)
    }

    ; `leftStr + rightStr`, with either side stringified first through jsnum's own
    ; ToString. ★ The result is BUILT, so unlike every other string in this file it
    ; cannot borrow the parse's bytes — it is assembled in a StringBuilder and
    ; copied onto the checker's page, which is what the record's `text` note calls
    ; the one exception.
    procedure concat_eval_results(this, left: EvalResult, right: EvalResult, iss: bool, rof: bool, her: bool) returns EvalResult
    {
        let sb StringBuilder^host()
        Checker.append_eval_value(&sb, left)
        Checker.append_eval_value(&sb, right)
        let s sb.to_string()
        let ln s.get_length() as int
        let out this.alloc_bytes(ln)
        var i 0
        while i < ln
        {
            set *(out + i): s.get(i as size_t) as char
            set i: i + 1
        }
        set *(out + ln): 0 as char
        EvalResult(EvalKindString, Slice[char](ln, out), 0 as u64, iss, rof, her)
    }

    ; evaluator.AnyToString, as an append. ★ Its `bool` and `PseudoBigInt` arms
    ; are not here and cannot be reached: `evaluate` answers a string, a number or
    ; nothing, so the two remaining Go type-switch cases have no producer in this
    ; port or in the reference's enum path (§3.5be — the reader that would earn
    ; them is a second caller of AnyToString, and there is none).
    procedure append_eval_value(out: ref[StringBuilder], r: EvalResult)
    {
        if r.kind = EvalKindNumber
        {
            var nb char[JSNUM_MAX_TEXT]
            let n jsnum_to_string(r.bits, Slice[char](JSNUM_MAX_TEXT as size_t, &nb[0]))
            out.append(&nb[0], n as size_t)
            return
        }
        if r.kind = EvalKindString
            out.append(r.text.data, r.text.length)
    }

    ; A template's HEAD, MIDDLE and TAIL are literal nodes whose cooked text is
    ; what goes into the answer — the same `Text()` the reference reads off them.
    procedure append_literal_text(out: ref[StringBuilder], n: ref[AstNode]?)
    {
        let len AstNode.literal_text_length_of(n)
        if len = 0
            return
        out.append(AstNode.literal_text_of(n).data, AstNode.literal_text_of(n).length)
    }

    ; evaluateTemplateExpression. ★★ ITS `isSyntacticallyString` IS TRUE ON BOTH
    ; EXITS — a template is string SYNTAX whether or not it evaluates — which is
    ; the one place in this chapter where the flag is not inherited from an
    ; operand. ★And the failing exit answers a NULL value with that flag set, not
    ; the operands' flags: the reference writes `Result{nil, true, false, false}`
    ; there, dropping resolvedOtherFiles on purpose.
    ; ★★★ SLICE 131: `Result.Value != nil`, THE ONE TEST FOR *THIS EVALUATION
    ; PRODUCED A VALUE* — AND THE KIND IS NOT IT. A template the evaluator could
    ; not fold answers **EvalKindString with a NULL text**, because the kind is what
    ; carries `is_syntactically_string` and upstream keeps that beside its nil value
    ; (`Result{nil, true, false, false}`). So a `kind <> EvalKindNone` test reads a
    ; no-value sentinel as a value.
    ;
    ; ★★★ IT WAS LIVE IN THREE PLACES AND COST TWO CORPUS UNITS EACH TIME the
    ; template-expression row came down: compute_constant_enum_member_value took the
    ; *has a value* branch for `A = `${BAR}`` and never reported TS18033; the SPAN
    ; test in evaluate_template_expression asked only for EvalKindNone, so a nested
    ; unfoldable template folded to nothing; and the binary `+` arm read the
    ; sentinel as a string operand. **A sentinel that keeps its discriminant is
    ; invisible to a discriminant test** (CLAUDE-lessons.md §3.5ep).
    function eval_has_value(r: EvalResult) returns bool
    {
        if r.kind = EvalKindNumber
            return true
        if r.kind = EvalKindString
            return r.text.data <> null
        false
    }

    procedure evaluate_template_expression(this, expr: ref[AstNode], location: ref[AstNode]?) returns EvalResult
    {
        var resolved_other_files false
        var has_external_references false
        let sb StringBuilder^host()
        let head AstNode.template_head_of(expr)
        Checker.append_literal_text(&sb, head)
        let spans AstNode.template_expression_spans_of(expr)
        if spans = null
            return EvalResult(EvalKindString, Slice[char](), 0 as u64, true, false, false)
        let sl spans as ref[Array[ref[AstNode]?]]
        let n sl.get_length() as int
        var i 0
        while i < n
        {
            let span sl[i]
            let span_result this.evaluate(AstNode.expression_of(span), location)
            if Checker.eval_has_value(span_result) = false
                return EvalResult(EvalKindString, Slice[char](), 0 as u64, true, false, false)
            Checker.append_eval_value(&sb, span_result)
            Checker.append_literal_text(&sb, AstNode.template_span_literal(span))
            if span_result.resolved_other_files
                set resolved_other_files: true
            if span_result.has_external_references
                set has_external_references: true
            set i: i + 1
        }
        let s sb.to_string()
        let ln s.get_length() as int
        let out this.alloc_bytes(ln)
        var w 0
        while w < ln
        {
            set *(out + w): s.get(w as size_t) as char
            set w: w + 1
        }
        set *(out + ln): 0 as char
        EvalResult(EvalKindString, Slice[char](ln, out), 0 as u64, true, resolved_other_files, has_external_references)
    }

    ; evaluateEntity — the callback NewEvaluator is built over, and the only part
    ; of the evaluator that knows what a symbol is.
    ;
    ; ★★ THE `Infinity` / `NaN` ARM IS A GLOBALS QUESTION AND THE REFERENCE SAYS
    ; WHY IN ITS OWN COMMENT: the decision to read the identifier as numeric rests
    ; on the single-file resolution NOT having found a different meaning for the
    ; name. So it is `symbol == getGlobalSymbol(text)` — an identity test against
    ; the lib's own symbol — and it needs the globals table slice 113 built.
    ;
    ; ★ The reference PANICS on any other kind ("Unhandled case in evaluateEntity").
    ; Its two callers are `evaluate`'s Identifier arm and its access arms, so the
    ; unreachable third case is answered with `none` here rather than trapped, for
    ; the reason jsnum_parse_pseudo_big_int's own refusal gives: a trap would be a
    ; claim about the input, where this is a claim about the callers.
    procedure evaluate_entity(this, expr: ref[AstNode], location: ref[AstNode]?) returns EvalResult
    {
        let k AstNode.kind_of(expr)
        if k = KindIdentifier
            return this.evaluate_entity_name(expr, location)
        if k = KindPropertyAccessExpression
            return this.evaluate_entity_name(expr, location)
        if k = KindElementAccessExpression
        {
            let root AstNode.expression_of(expr)
            let arg AstNode.element_access_argument_of(expr)
            if Parser.is_entity_name_expression(root)
            {
                if Parser.is_string_literal_like(arg)
                {
                    let root_symbol this.resolve_entity_name(root as ref[AstNode], SymbolFlagsValue, true, false, null)
                    if root_symbol <> null
                    {
                        let rs root_symbol as ref[Symbol]
                        if (Symbol.flags_of(rs) & SymbolFlagsEnum) <> 0
                        {
                            let member SymbolTable.get(Symbol.exports_of(rs), AstNode.literal_text_of(arg))
                            if member <> null
                            {
                                let ms member as ref[Symbol]
                                if location <> null
                                    return this.evaluate_enum_member(expr, ms, location as ref[AstNode])
                                return this.get_enum_member_value(Symbol.value_declaration_of(ms))
                            }
                        }
                    }
                }
            }
            return Checker.eval_none()
        }
        Checker.eval_none()
    }

    ; The Identifier / PropertyAccessExpression half of evaluateEntity — one Go
    ; `case` with two kinds, split out because the element-access half shares none
    ; of it.
    procedure evaluate_entity_name(this, expr: ref[AstNode], location: ref[AstNode]?) returns EvalResult
    {
        let symbol this.resolve_entity_name(expr, SymbolFlagsValue, true, false, null)
        if symbol = null
            return Checker.eval_none()
        let s symbol as ref[Symbol]
        if AstNode.kind_of(expr) = KindIdentifier
        {
            let data AstNode.identifier_text_of(expr)
            let len AstNode.identifier_text_length_of(expr)
            if AstNode.is_infinity_or_nan_string(data)
            {
                let g this.lookup_globals(data, SymbolFlagsValue)
                if g <> null
                {
                    if (g as ref[Symbol]) = s
                        return Checker.eval_number(jsnum_from_string(data))
                }
            }
        }
        if (Symbol.flags_of(s) & SymbolFlagsEnumMember) <> 0
        {
            if location <> null
                return this.evaluate_enum_member(expr, s, location as ref[AstNode])
            return this.get_enum_member_value(Symbol.value_declaration_of(s))
        }
        if this.is_constant_variable(s)
        {
            let declaration Symbol.value_declaration_of(s)
            if declaration <> null
            {
                let d declaration as ref[AstNode]
                if AstNode.kind_of(d) = KindVariableDeclaration
                {
                    if AstNode.type_of(d) = null
                    {
                        ; `init` is a RESERVED WORD (root CLAUDE.md), so the
                        ; binding cannot carry the reference's own name.
                        let init_expr AstNode.initializer_of(d)
                        if init_expr <> null
                        {
                            var reachable false
                            if location = null
                                set reachable: true
                            else
                            {
                                let loc location as ref[AstNode]
                                if d <> loc
                                {
                                    if this.is_block_scoped_name_declared_before_use(d, loc)
                                        set reachable: true
                                }
                            }
                            if reachable
                            {
                                let result this.evaluate(init_expr, d)
                                ; `ast.GetSourceFileOfNode(location) != ast.GetSourceFileOfNode(declaration)`
                                ; — this port checks ONE file at a time (tests/oracle/types.go's
                                ; header), so the two source files are the same by construction and
                                ; the cross-file arm has no input. It is transcribed anyway, because
                                ; the condition is about the INPUT and not about the port: the day a
                                ; second file is in the program it is the arm that must run.
                                if location <> null
                                {
                                    let loc location as ref[AstNode]
                                    if Checker.source_file_of_node(loc) <> Checker.source_file_of_node(d)
                                        return EvalResult(result.kind, result.text, result.bits, false, true, true)
                                }
                                return EvalResult(result.kind, result.text, result.bits, result.is_syntactically_string, result.resolved_other_files, true)
                            }
                        }
                    }
                }
            }
        }
        Checker.eval_none()
    }

    ; evaluateEnumMember, whole. ★ Both reports name a message with an argument
    ; the yardstick does not compare — tscaly_types dumps `C pos end code` — so
    ; symbolToString is not needed here, which is what makes the arm portable at
    ; all in this slice.
    procedure evaluate_enum_member(this, expr: ref[AstNode], symbol: ref[Symbol], location: ref[AstNode]) returns EvalResult
    {
        let declaration Symbol.value_declaration_of(symbol)
        if declaration = null
        {
            this.error_on_node(expr, DiagProperty_0_is_used_before_being_assigned, this.symbol_arg(symbol))
            return Checker.eval_none()
        }
        let d declaration as ref[AstNode]
        if d = location
        {
            this.error_on_node(expr, DiagProperty_0_is_used_before_being_assigned, this.symbol_arg(symbol))
            return Checker.eval_none()
        }
        if this.is_block_scoped_name_declared_before_use(d, location) = false
        {
            this.error_on_node(expr, DiagA_member_initializer_in_a_enum_declaration_cannot_reference_members_declared_after_it_including_members_defined_in_other_enums)
            return Checker.eval_number(jsnum_from_int(0))
        }
        let value this.get_enum_member_value(d)
        if AstNode.parent_node_of(location) <> AstNode.parent_node_of(d)
            return EvalResult(value.kind, value.text, value.bits, value.is_syntactically_string, value.resolved_other_files, true)
        value
    }

    ; ── the value computation (checker.go's enum block) ─────────────────────

    ; getEnumMemberValue — two lines, and the first is what makes the whole
    ; chapter re-entrant: asking ONE member's value computes the WHOLE enum's,
    ; because an auto-numbered member's value is the previous member's plus one.
    procedure get_enum_member_value(this, node: ref[AstNode]?) returns EvalResult
    {
        if node = null
            return Checker.eval_none()
        let n node as ref[AstNode]
        this.compute_enum_member_values(AstNode.parent_node_of(n))
        this.enum_member_link_of(n).value
    }

    ; computeEnumMemberValues. ★★★ `autoValue *jsnum.Number` IS A POINTER FOR ONE
    ; REASON AND IT IS NOT NULLABILITY OF A NUMBER: nil means *the previous member
    ; was not a numeric constant*, which is the condition that makes the NEXT
    ; member's missing initializer an error. So it is a value plus a PRESENT bit
    ; here, and the bit is what `computeEnumMemberValue` tests.
    procedure compute_enum_member_values(this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        if AstNode.kind_of(n) <> KindEnumDeclaration
            return
        let links this.node_link_of(n)
        if links.enum_values_computed
            return
        set links.enum_values_computed: true
        var auto_value jsnum_from_int(0)
        var auto_present true
        var previous: ref[AstNode]? null
        let members AstNode.member_list_of(n)
        if members = null
            return
        let ml members as ref[Array[ref[AstNode]?]]
        let count ml.get_length() as int
        var i 0
        while i < count
        {
            let member ml[i]
            if member <> null
            {
                let m member as ref[AstNode]
                let result this.compute_enum_member_value(m, auto_value, auto_present, previous)
                let row this.enum_member_link_of(m)
                set row.value: result
                if result.kind = EvalKindNumber
                {
                    set auto_value: jsnum_add(result.bits, jsnum_from_int(1))
                    set auto_present: true
                }
                else
                    set auto_present: false
                set previous: m
            }
            set i: i + 1
        }
    }

    ; computeEnumMemberValue, whole.
    procedure compute_enum_member_value(this, member: ref[AstNode], auto_value: u64, auto_present: bool, previous: ref[AstNode]?) returns EvalResult
    {
        let name AstNode.name_of(member)
        if Checker.is_computed_non_literal_name(name)
            this.error_on_node(name, DiagComputed_property_names_are_not_allowed_in_enums)
        else
        {
            if Checker.kind_or_unknown(name) = KindBigIntLiteral
                this.error_on_node(name, DiagAn_enum_member_cannot_have_a_numeric_name)
            else
            {
                let data AstNode.property_name_text_of(name)
                let len AstNode.property_name_text_length_of(name)
                if Checker.is_numeric_literal_name(data)
                {
                    if AstNode.is_infinity_or_nan_string(data) = false
                        this.error_on_node(name, DiagAn_enum_member_cannot_have_a_numeric_name)
                }
            }
        }
        let initializer AstNode.initializer_of(member)
        if initializer <> null
            return this.compute_constant_enum_member_value(member)
        ; In an ambient NON-CONST enum a member without an initializer is a
        ; COMPUTED member rather than an auto-numbered one — the reference's own
        ; comment, and the reason this test comes before the auto-value one.
        let parent AstNode.parent_node_of(member)
        if parent <> null
        {
            if (AstNode.flags_of(parent as ref[AstNode]) & NodeFlagsAmbient) <> 0
            {
                if this.is_enum_const(parent) = false
                    return Checker.eval_none()
            }
        }
        if auto_present = false
        {
            this.error_on_node(AstNode.name_of(member), DiagEnum_member_must_have_initializer)
            return Checker.eval_none()
        }
        ; The isolatedModules report. ★ Its condition is UNREACHABLE under this
        ; harness — get_isolated_modules answers false, because neither
        ; `isolatedModules` nor `verbatimModuleSyntax` is set by the oracle's stub
        ; program (tests/oracle/types.go) — so it is ported for the day an option
        ; is threaded, and no fixture can gate it (§3.5v: a row with no input).
        if this.get_isolated_modules()
        {
            if previous <> null
            {
                let p previous as ref[AstNode]
                if AstNode.initializer_of(p) <> null
                {
                    let prev_value this.get_enum_member_value(p)
                    if prev_value.kind <> EvalKindNumber
                        this.error_on_node(AstNode.name_of(member), DiagEnum_member_following_a_non_literal_numeric_member_must_have_an_initializer_when_isolatedModules_is_enabled)
                    else
                    {
                        if prev_value.resolved_other_files
                            this.error_on_node(AstNode.name_of(member), DiagEnum_member_following_a_non_literal_numeric_member_must_have_an_initializer_when_isolatedModules_is_enabled)
                    }
                }
            }
        }
        Checker.eval_number(auto_value)
    }

    ; ast.IsComputedNonLiteralName.
    function is_computed_non_literal_name(name: ref[AstNode]?) returns bool
    {
        if Checker.kind_or_unknown(name) <> KindComputedPropertyName
            return false
        Parser.is_string_or_numeric_literal_like(AstNode.expression_of(name)) = false
    }

    ; computeConstantEnumMemberValue, whole. Its four-arm switch is on the RESULT
    ; and not on the member, and the last arm is the one that makes a computed
    ; member a type question at all.
    procedure compute_constant_enum_member_value(this, member: ref[AstNode]) returns EvalResult
    {
        let parent AstNode.parent_node_of(member)
        let is_const_enum this.is_enum_const(parent)
        let initializer AstNode.initializer_of(member)
        let result this.evaluate(initializer, member)
        if Checker.eval_has_value(result)
        {
            if is_const_enum
            {
                if result.kind = EvalKindNumber
                {
                    if jsnum_is_nan(result.bits)
                        this.error_on_node(initializer, DiagX_const_enum_member_initializer_was_evaluated_to_disallowed_value_NaN)
                    else
                    {
                        if jsnum_is_inf(result.bits)
                            this.error_on_node(initializer, DiagX_const_enum_member_initializer_was_evaluated_to_a_non_finite_value)
                    }
                }
            }
            if this.get_isolated_modules()
            {
                if result.kind = EvalKindString
                {
                    if result.is_syntactically_string = false
                    {
                        var member_name StringBuilder()
                        member_name.append(AstNode.identifier_text_of(AstNode.name_of(parent)).data, AstNode.identifier_text_of(AstNode.name_of(parent)).length)
                        member_name.append("." as char)
                        member_name.append(AstNode.identifier_text_of(AstNode.name_of(member)).data, AstNode.identifier_text_of(AstNode.name_of(member)).length)
                        this.error_on_node(initializer, DiagX_0_has_a_string_type_but_must_have_syntactically_recognizable_string_syntax_when_isolatedModules_is_enabled, member_name.to_string())
                    }
                }
            }
            return result
        }
        if is_const_enum
        {
            this.error_on_node(initializer, DiagX_const_enum_member_initializers_must_be_constant_expressions)
            return result
        }
        if parent <> null
        {
            if (AstNode.flags_of(parent as ref[AstNode]) & NodeFlagsAmbient) <> 0
            {
                this.error_on_node(initializer, DiagIn_ambient_enum_declarations_member_initializer_must_be_constant_expression)
                return result
            }
        }
        ; ── slice 124: TS18033 ───────────────────────────────────────────────
        ; `checkTypeAssignableTo(checkExpression(initializer), numberType,
        ; initializer, TS18033)` — a computed enum member's initializer must be a
        ; number, and the head message is the code.
        if initializer <> null
        {
            let mark this.unported_mark()
            let it this.check_expression(initializer as ref[AstNode])
            if this.unported_mark() <> mark
                return result
            if it <> null
                this.check_type_assignable_to(it as ref[Type], number_type, initializer, DiagType_0_is_not_assignable_to_type_1_as_required_for_computed_enum_member_values)
        }
        result
    }

    ; ── the enum's TYPES ────────────────────────────────────────────────────

    ; createComputedEnumType — a literal type PAIR (regular + fresh) carrying
    ; TypeFlagsEnum and no value at all, which is what a member whose initializer
    ; is not a constant expression gets. ★ It is the one producer of TypeFlagsEnum
    ; in this port, and the flag's name is misleading in the reference's own
    ; comment's words: *numeric computed enum member value*.
    procedure create_computed_enum_type(this, symbol: ref[Symbol]?) returns ref[Type]
    {
        let regular this.new_literal_type(TypeFlagsEnum, Slice[char](), 0 as u64, false, false, null)
        set regular.symbol: symbol
        let fresh this.new_literal_type(TypeFlagsEnum, Slice[char](), 0 as u64, false, false, regular)
        set fresh.symbol: symbol
        Checker.set_literal_fresh_type(regular, fresh)
        Checker.set_literal_fresh_type(fresh, fresh)
        regular
    }

    ; getEnumLiteralType. ★★★ THE REFERENCE'S SECOND TABLE IS NOT HERE AND THE
    ; REASON IS THE KEY. Upstream keeps `enumNaNLiteralTypes` beside
    ; `enumLiteralTypes` because a Go map cannot be keyed on NaN — `NaN != NaN`,
    ; so every lookup misses and the cache would mint a type per occurrence. This
    ; port's table is a SCAN with a comparison written by hand, so NaN is asked
    ; about with `jsnum_is_nan` on both sides and hits like any other value; the
    ; two tables collapse into one with no observable difference, because what
    ; upstream's NaN table keys on (the enum symbol) is what this row already
    ; carries. ★It also fixes the thing the split leaves open: two NaNs with
    ; different PAYLOADS (`NaN` and `0/0` are different bit patterns) are one type
    ; here and one type there, for different reasons.
    procedure get_enum_literal_type(this, value: EvalResult, enum_symbol: ref[Symbol]?, symbol: ref[Symbol]?) returns ref[Type]
    {
        var flags TypeFlagsEnumLiteral | TypeFlagsStringLiteral
        if value.kind = EvalKindNumber
            set flags: TypeFlagsEnumLiteral | TypeFlagsNumberLiteral
        let len enum_literal_types.get_length() as int
        var i 0
        while i < len
        {
            let row enum_literal_types[i]
            if row <> null
            {
                let r row as ref[EnumLiteralRow]
                if r.enum_symbol = enum_symbol
                {
                    let t r.t as ref[Type]
                    if (t.flags & TypeFlagsNumberLiteral) <> 0
                    {
                        if value.kind = EvalKindNumber
                        {
                            if Checker.enum_values_equal(Checker.literal_bits_of(t), value.bits)
                                return t
                        }
                    }
                    else
                    {
                        if value.kind = EvalKindString
                        {
                            if Checker.literal_text_length_of(t) = value.text.length
                            {
                                if Checker.text_equals(Checker.literal_text_of(t), value.text)
                                    return t
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
        let t this.new_literal_type(flags, value.text, value.bits, false, false, null)
        set t.symbol: symbol
        enum_literal_types.add(&EnumLiteralRow^host(enum_symbol, t))
        t
    }

    ; Two NUMBER values are the same enum-literal key when their bits agree, or
    ; when both are NaN — see get_enum_literal_type's header for why the second
    ; half is here rather than in a table of its own.
    function enum_values_equal(a: u64, b: u64) returns bool
    {
        if a = b
            return true
        if jsnum_is_nan(a) = false
            return false
        jsnum_is_nan(b)
    }

    ; getDeclaredTypeOfEnum, whole. ★★ THE MEMBER LOOP WRITES TWO PLACES: the
    ; member symbol's OWN declared type (the fresh literal) and the list this
    ; function unions. Skipping the first because the second is what is returned
    ; would leave get_declared_type_of_enum_member with nothing to read — its whole
    ; body is `getDeclaredTypeOfEnum(parent)` followed by a read of that slot.
    procedure get_declared_type_of_enum(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.declared_type_link_of(symbol)
        if links.declared_type <> null
            return links.declared_type
        let member_types &Array[ref[Type]?]()
        let dn Symbol.declaration_count(symbol)
        var di 0
        while di < dn
        {
            let declaration Symbol.declaration_at(symbol, di)
            if Checker.kind_or_unknown(declaration) = KindEnumDeclaration
            {
                let members AstNode.member_list_of(declaration)
                if members <> null
                {
                    let ml members as ref[Array[ref[AstNode]?]]
                    let mn ml.get_length() as int
                    var mi 0
                    while mi < mn
                    {
                        let member ml[mi]
                        if member <> null
                        {
                            let m member as ref[AstNode]
                            ; hasBindableName, ported in slice 124: an enum member
                            ; with a computed name is skipped unless the name is
                            ; late-bindable.
                            if this.has_bindable_name(m)
                            {
                                let member_symbol this.get_symbol_of_declaration(m)
                                let value this.get_enum_member_value(m)
                                var member_type: ref[Type]? null
                                ; ★★★ `value == nil`, and it is eval_has_value and
                                ; NOT a kind test: the template evaluator's
                                ; no-value sentinel keeps EvalKindString, so a
                                ; kind test sent every unfoldable member to
                                ; get_enum_literal_type, where they interned on
                                ; the EMPTY text into ONE type — `Foo.A` for A, C,
                                ; H and J alike, which is exactly what the stage-2
                                ; diff showed.
                                if Checker.eval_has_value(value) = false
                                    set member_type: this.create_computed_enum_type(member_symbol)
                                else
                                    set member_type: this.get_enum_literal_type(value, symbol, member_symbol)
                                let mt member_type as ref[Type]
                                if member_symbol <> null
                                {
                                    let ml2 this.declared_type_link_of(member_symbol as ref[Symbol])
                                    set ml2.declared_type: this.get_fresh_type_of_literal_type(mt)
                                }
                                member_types.add(mt)
                            }
                        }
                        set mi: mi + 1
                    }
                }
            }
            set di: di + 1
        }
        var enum_type: ref[Type]? null
        if (member_types.get_length() as int) <> 0
        {
            ; ★★★ THE ALIAS IS PASSED AND NOT STAMPED, SINCE SLICE 135. The note
            ; that stood here said get_union_type_ex carries no alias parameter and
            ; that writing the alias onto the answer is the same value; it does
            ; carry one, and the two are NOT the same value, in both directions.
            ; getUnionKey hashes the alias, so the reference INTERNS `E` apart from
            ; a bare `E.A | E.B` — stamped afterwards the enum's alias lands on the
            ; shared union and the next request for those constituents gets a type
            ; that calls itself `E`. And the alias has to be in place BEFORE the
            ; union is a constituent of anything: addTypesToUnion reads
            ; `t.alias != nil` to decide that a named union was seen, which is the
            ; whole of the denormalized-origin block.
            let enum_alias &TypeAlias^this(symbol, null) as ref[TypeAlias]?
            set enum_type: this.get_union_type_ex(member_types, UnionReductionLiteral, enum_alias, null)
        }
        else
            set enum_type: this.create_computed_enum_type(symbol)
        if enum_type = null
            return null
        let et enum_type as ref[Type]
        if (et.flags & TypeFlagsUnion) <> 0
        {
            set et.flags: et.flags | TypeFlagsEnumLiteral
            set et.symbol: symbol
        }
        set links.declared_type: et
        et
    }

    ; getDeclaredTypeOfEnumMember. ★ The reference's `if !(links.declaredType !=
    ; nil)` around a call that FILLS the same slot is not a double test: the enum's
    ; own loop writes every member's slot, so the second test asks whether it did.
    procedure get_declared_type_of_enum_member(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.declared_type_link_of(symbol)
        if links.declared_type <> null
            return links.declared_type
        let parent this.get_parent_of_symbol(symbol)
        if parent = null
            return null
        let enum_type this.get_declared_type_of_enum(parent as ref[Symbol])
        if links.declared_type = null
            set links.declared_type: enum_type
        links.declared_type
    }

    ; getTypeOfEnumMember — the VALUE-side memo in front of the declared type,
    ; keyed on the same symbol in a different table (valueSymbolLinks), exactly as
    ; upstream keeps them apart.
    procedure get_type_of_enum_member(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.resolved_type = null
            set links.resolved_type: this.get_declared_type_of_enum_member(symbol)
        links.resolved_type
    }

    ; getBaseTypeOfEnumLikeType — five lines, and it is the enum half of
    ; getBaseTypeOfLiteralType: an enum MEMBER's base is the whole enum.
    procedure get_base_type_of_enum_like_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsEnumLike) = 0
            return t
        if t.symbol = null
            return t
        if (Symbol.flags_of(t.symbol as ref[Symbol]) & SymbolFlagsEnumMember) = 0
            return t
        let parent this.get_parent_of_symbol(t.symbol as ref[Symbol])
        if parent = null
            return t
        this.get_declared_type_of_symbol(parent as ref[Symbol])
    }

    ; ── slice 50: the import/export/module family, and the block it needed ───
    ;
    ; ★★★ THE SLICE IS ONE HEAD AND THE ARMS IT PREFIXES, and the line it stops at
    ; is a FILE rather than a judgement — the same shape slice 49's boundary had,
    ; where the message table decided. Everything these arms call in
    ; grammarchecks.go is ported (the head, checkGrammarModifiers, the export
    ; declaration's type-only check); the first call into a CHECK of checker.go is
    ; where each arm reports. The two exceptions are named because they look like
    ; the line being crossed and are not: `c.error` is a REPORTER, the semantic
    ; twin of grammar_error_on_node, and `shouldCheckErasableSyntax` is a
    ; one-line option read. Neither is a check.
    ;
    ; ★★★ AND THE FIRST THING THIS SLICE HAD TO PAY IS THE MESSAGE TABLE. Slice 49
    ; recorded that this family *is the only one that also needs
    ; gendiagnostics.py's SOURCES to grow*: every one of the six arms names its
    ; illegal-context message in checker.go, which the generator deliberately did
    ; not scrape. It scrapes it now — 337 codes to 947 — on the condition the old
    ; note itself set (*it joins when an arm of checker.go reports*), and widening
    ; it found a defect in the scrape that only that file could show. The
    ; generator's header has it.
    ;
    ; ★★ WHAT THE FAMILY CANNOT DO YET, said plainly: the illegal-context report is
    ; UNREACHABLE. Its condition is a parent that is none of SourceFile,
    ; ModuleBlock or ModuleDeclaration — a `{ import … }` inside a plain block, a
    ; `export = x` inside an `if` body — and while checkBlock is ported for a
    ; block that is a STATEMENT, no arm that CONTAINS a block is (checkIfStatement,
    ; checkFunctionDeclaration, …). So the head runs on every unit of the family
    ; and answers false on every one of them. That is worth a fixture the moment a
    ; containing arm lands, and it is why the corpus is the evidence for the claim
    ; rather than a reading of it.

    ; checkBlock, whole. Two of its three steps are no-ops here for reasons the
    ; file already carries: `flowAnalysisDisabled` is saved and restored around a
    ; call, and there is no flow graph to disable (see the header); and
    ; registerForUnusedIdentifiersCheck is observable only through
    ; checkUnusedIdentifiers, which checkUnused gates off under this harness.
    ;
    ; ★ The grammar check is asked of a KindBlock and NOT of a KindModuleBlock —
    ; that is the reference's own `if node.Kind == ast.KindBlock`, and it is the
    ; whole difference between the two kinds here. A namespace body is not a
    ; statement, so *statements are not allowed in ambient contexts* is not a thing
    ; to say about it.
    procedure check_block(this, node: ref[AstNode])
    {
        if AstNode.kind_of(node) = KindBlock
            this.check_grammar_statement_in_ambient_context(node)
        this.check_source_elements(AstNode.statements_of(node))
        if SymbolTable.length(AstNode.locals_of(node)) > 0
            this.register_for_unused_identifiers_check(node)
    }

    ; checkModuleDeclaration's prefix.
    ;
    ; ★★★ ITS FIRST STEP IS THE RECURSION, and that decides what the histogram
    ; says about a namespace: the body is checked BEFORE the module's own grammar,
    ; so a statement inside it that this port cannot answer is the FIRST report and
    ; therefore the tag (record_unported keeps the first). That is not a loss of
    ; resolution — it is the resolution moving one level down, which is what the
    ; block arm was ported for.
    ;
    ; ★★ THE ORDER OF THE REPORTS IS NOT THE ORDER OF THE LINES, and the sort is
    ; what makes that safe: the body's diagnostics are found before the module's,
    ; while GetDiagnosticsForFile answers a list sorted by position. So a
    ; `declare module M { ; }` whose body reports TS1036 and whose header reports
    ; TS1035 comes out in text order either way.
    ; checkModuleAugmentationElement, whole (slice 129) — what may NOT stand inside
    ; a module augmentation's body.
    ;
    ; ★★★ THE `fallthrough` IS THE ONE THING A TRANSCRIPTION LOSES. Upstream the
    ; ImportEqualsDeclaration arm `break`s for an INTERNAL reference (`import a =
    ; e.x` is allowed) and otherwise falls through to the import arm's report — so
    ; the two arms share one report and differ in one guard, which is written here
    ; as the guard in front of the shared call.
    ;
    ; ★ Both reports are grammar_error_on_first_token, which answers a bool nothing
    ; here reads: the reference discards it too.
    procedure check_module_augmentation_element(this, node: ref[AstNode])
    {
        let k AstNode.kind_of(node)
        if k = KindVariableStatement
        {
            ; "error each individual name in variable statement instead of marking
            ; the entire variable statement"
            let list AstNode.variable_declarations_of(AstNode.variable_statement_list_of(node))
            if list = null
                return
            let decls list as ref[Array[ref[AstNode]?]]
            let n decls.get_length() as int
            var i 0
            while i < n
            {
                let d decls[i]
                set i: i + 1
                if d <> null
                    this.check_module_augmentation_element(d as ref[AstNode])
            }
            return
        }
        if k = KindExportAssignment
        {
            this.grammar_error_on_first_token(node, DiagExports_and_export_assignments_are_not_permitted_in_module_augmentations)
            return
        }
        if k = KindExportDeclaration
        {
            this.grammar_error_on_first_token(node, DiagExports_and_export_assignments_are_not_permitted_in_module_augmentations)
            return
        }
        if k = KindImportEqualsDeclaration
        {
            ; "import a = e.x; in module augmentation is ok, but not
            ; import a = require('fs)"
            if AstNode.import_equals_reference_kind(node) <> KindExternalModuleReference
                return
            this.grammar_error_on_first_token(node, DiagImports_are_not_permitted_in_module_augmentations_Consider_moving_them_to_the_enclosing_external_module)
            return
        }
        if k = KindImportDeclaration
        {
            this.grammar_error_on_first_token(node, DiagImports_are_not_permitted_in_module_augmentations_Consider_moving_them_to_the_enclosing_external_module)
            return
        }
        if k = KindJSImportDeclaration
        {
            this.grammar_error_on_first_token(node, DiagImports_are_not_permitted_in_module_augmentations_Consider_moving_them_to_the_enclosing_external_module)
            return
        }
        var binding false
        if k = KindBindingElement
            set binding: true
        if k = KindVariableDeclaration
            set binding: true
        if binding = false
            return
        let name AstNode.name_of(node)
        if AstNode.is_binding_pattern(name) = false
            return
        let els AstNode.elements_of(name)
        if els = null
            return
        let list els as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let el list[i]
            set i: i + 1
            if el <> null
                this.check_module_augmentation_element(el as ref[AstNode])
        }
    }

    procedure check_module_declaration(this, node: ref[AstNode])
    {
        let body AstNode.body_of(node)
        if body <> null
        {
            this.check_source_element(body)
            if Binder.is_global_scope_augmentation(node) = false
                this.register_for_unused_identifiers_check(node)
        }

        let is_global_augmentation Binder.is_global_scope_augmentation(node)
        var in_ambient_context false
        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            set in_ambient_context: true
        if is_global_augmentation
        {
            if in_ambient_context = false
                this.error_on_node(AstNode.name_of(node), DiagAugmentations_for_the_global_scope_should_have_declare_modifier_unless_they_appear_in_already_ambient_context)
        }

        ; ★ The two illegal-context messages are chosen by whether this is an
        ; AMBIENT EXTERNAL MODULE — `declare module "m"`, a quoted name — rather
        ; than by the ambient flag: `declare namespace N` is ambient and is still a
        ; namespace declaration.
        var context_code: int DiagA_namespace_declaration_is_only_allowed_at_the_top_level_of_a_namespace_or_module
        if Binder.is_ambient_module(node)
            set context_code: DiagAn_ambient_module_declaration_is_only_allowed_at_the_top_level_in_a_file
        if this.check_grammar_module_element_context(node, context_code)
            return

        if this.check_grammar_modifiers(node) = false
        {
            if in_ambient_context = false
            {
                let name AstNode.name_of(node)
                if Checker.kind_or_unknown(name) = KindStringLiteral
                    this.grammar_error_on_node(name, DiagOnly_ambient_modules_can_use_quoted_names)
            }
        }

        ; ★ TWO TAGS, because the identifier branch stops one call earlier than the
        ; string one. `namespace N {}` is stopped by checkCollisionsForDeclarationName
        ; — and the TS1540 module-keyword advice sits BEHIND it, so `module N {}`
        ; cannot report it yet; `declare module "m"` skips that branch entirely and
        ; is stopped by checkExportsOnMergedDeclarations.
        ; ★★ SLICE 59 CLOSED THE FIRST OF THE TWO AND THE TWO BECAME ONE. The
        ; collision head is ported, so the identifier branch runs through it and
        ; reaches the TS1540 advice that sat behind it since slice 50 — `module N
        ; {}` says *use the namespace keyword* — and then both branches meet at
        ; checkExportsOnMergedDeclarations. The keyword is a FIELD on the
        ; declaration (three values: namespace, module, global), so the test is a
        ; field read and not a token position.
        if Checker.kind_or_unknown(AstNode.name_of(node)) = KindIdentifier
        {
            this.check_collisions_for_declaration_name(node, AstNode.name_of(node))
            if AstNode.module_keyword_of(node) = KindModuleKeyword
                this.error_on_node(AstNode.name_of(node), DiagA_namespace_declaration_should_not_be_declared_using_the_module_keyword_Please_use_the_namespace_keyword_instead)
        }
        this.check_exports_on_merged_declarations(node)

        ; ★★★ SLICE 65 TAKES THE WHOLE TAIL, AND IT IS THE LONGEST ARM OF THIS FILE
        ; THAT NEEDS NO TYPE — thirty lines of the reference, seven reports, and the
        ; only thing behind it is checkModuleAugmentationElement. What makes it
        ; portable is that every question it asks is about SYNTAX or about the
        ; symbol's declaration LIST: is this module instantiated, does its name
        ; collide with a class or function declared later, is it an augmentation, is
        ; its parent a global source file.
        let symbol this.symbol_of_declaration(node)
        var value_module false
        if symbol <> null
        {
            if (Symbol.flags_of(symbol) & SymbolFlagsValueModule) <> 0
                set value_module: true
        }
        ; isInstantiatedModule(node, ShouldPreserveConstEnums()). ★The option is
        ; unset under this harness, so the second disjunct — a CONST-ENUM-ONLY module
        ; counting as instantiated — is false without asking, and only
        ; ModuleInstanceStateInstantiated qualifies. It is written as the disjunction
        ; it is rather than as the surviving half, because the two states are
        ; genuinely different answers and a slice that lets `@preserveConstEnums`
        ; through moves the line without touching it.
        var instantiated false
        if value_module
        {
            if in_ambient_context = false
            {
                let module_state b.get_module_instance_state(node)
                if module_state = ModuleInstanceStateInstantiated
                    set instantiated: true
                if this.should_preserve_const_enums()
                {
                    if module_state = ModuleInstanceStateConstEnumOnly
                        set instantiated: true
                }
            }
        }
        if instantiated
        {
            if this.should_check_erasable_syntax(node)
                this.error_on_node(node, DiagThis_syntax_is_not_allowed_when_erasableSyntaxOnly_is_enabled)

            if this.get_isolated_modules() and (this.binder_of_node(node).is_external_module_of() = false)
            {
                let nm AstNode.name_of(node)
                if nm <> null
                    this.error_on_node(nm as ref[AstNode], DiagNamespaces_are_not_allowed_in_global_script_files_when_0_is_enabled_If_this_file_is_not_intended_to_be_a_global_script_set_moduleDetection_to_force_or_add_an_empty_export_statement, this.isolated_modules_like_flag_name())
            }

            ; ★★ THE TWO MERGE-ORDER REPORTS ARE THE ONES THIS TAIL IS FOR. A
            ; namespace may merge with a class or a function, and it must come AFTER
            ; it — `namespace N {} class N {}` is TS2434, and the file-crossing twin
            ; TS2433 cannot fire here because one unit is one file. It is stated as
            ; a reachability fact rather than left out: the comparison is written,
            ; and with one file both source files are the same node, so the `else if`
            ; is what runs.
            if symbol <> null
            {
                if Symbol.declaration_count(symbol) > 1
                {
                    let first Checker.first_non_ambient_class_or_function_declaration(symbol)
                    if first <> null
                    {
                        if Checker.source_file_of_node(node) <> Checker.source_file_of_node(first)
                            this.error_on_node(AstNode.name_of(node), DiagA_namespace_declaration_cannot_be_in_a_different_file_from_a_class_or_function_with_which_it_is_merged)
                        else
                        {
                            if AstNode.pos_of(node) < AstNode.pos_of(first)
                                this.error_on_node(AstNode.name_of(node), DiagA_namespace_declaration_cannot_be_located_prior_to_a_class_or_function_with_which_it_is_merged)
                        }
                    }
                }
            }

            ; The verbatim-module-syntax report, behind the same option every other
            ; site of it is behind (see check_export_assignment's own note).
            ; a top-level `export` on a value declaration of a CommonJS-format file
            ; under verbatimModuleSyntax (slice 249)
            if verbatim_module_syntax
            {
                let holder AstNode.parent_node_of(node)
                if Checker.kind_or_unknown(holder) = KindSourceFile
                {
                    if b.has_syntactic_modifier(node, ModifierFlagsExport) and (this.file_emit_format_of(holder) = ModuleKindCommonJS)
                    {
                        let export_modifier Checker.modifier_of_kind(node, KindExportKeyword)
                        if export_modifier <> null
                            this.error_on_node(export_modifier, DiagA_top_level_export_modifier_cannot_be_used_on_value_declarations_in_a_CommonJS_module_when_verbatimModuleSyntax_is_enabled)
                    }
                }
            }
        }

        if Binder.is_ambient_module(node) = false
            return

        ; ★★★ THE AUGMENTATION BRANCH IS THE ONE HOLE, AND ITS GUARD COLLAPSES TO A
        ; SINGLE TERM HERE. `checkBody := isGlobalAugmentation ||
        ; getSymbolOfDeclaration(node).Flags&Transient != 0`, and the Transient flag
        ; is set by NOTHING in this port: it is the checker's own mark for a symbol
        ; created by cloneSymbol or newSymbol during the global merge, which is the
        ; same pass getMergedSymbol's empty table comes from. So the second disjunct
        ; is false for the same reason and by the same date — see get_merged_symbol.
        ; ★It is written as the disjunction anyway, so that the slice which ports the
        ; merge finds both halves in one place.
        if b.is_module_augmentation_external(node)
        {
            var check_body is_global_augmentation
            if symbol <> null
            {
                if (Symbol.flags_of(symbol) & SymbolFlagsTransient) <> 0
                    set check_body: true
            }
            if check_body
            {
                if body <> null
                {
                    let stmts AstNode.statements_of(body as ref[AstNode])
                    let sn AstNode.list_count(stmts)
                    var si 0
                    while si < sn
                    {
                        let st AstNode.child_in_list(stmts, si)
                        set si: si + 1
                        if st <> null
                            this.check_module_augmentation_element(st as ref[AstNode])
                    }
                }
            }
            return
        }

        ; ★★ THE LAST TWO ARMS DIFFER IN ONE REPORT AND SHARE THE OTHER, which is
        ; the reference's shape and reads as a duplication until the messages are
        ; compared: a global augmentation that is not directly nested in a module is
        ; the same complaint whether its parent is a global source file or a
        ; namespace, while a NON-global ambient module gets *cannot specify relative
        ; module name* in the first case and *cannot be nested* in the second.
        let name AstNode.name_of(node)
        if this.is_global_source_file_node(AstNode.parent_node_of(node))
        {
            if is_global_augmentation
                this.error_on_node(name, DiagAugmentations_for_the_global_scope_can_only_be_directly_nested_in_external_modules_or_ambient_module_declarations)
            else
            {
                if is_external_module_name_relative(AstNode.literal_text_of(name))
                    this.error_on_node(name, DiagAmbient_module_declaration_cannot_specify_relative_module_name)
            }
            return
        }
        if is_global_augmentation
            this.error_on_node(name, DiagAugmentations_for_the_global_scope_can_only_be_directly_nested_in_external_modules_or_ambient_module_declarations)
        else
            this.error_on_node(name, DiagAmbient_modules_cannot_be_nested_in_other_modules_or_namespaces)
    }

    ; getFirstNonAmbientClassOrFunctionDeclaration, whole.
    ;
    ; ★ The `&&` binds tighter than the `||` in the reference's condition, so it is a
    ; CLASS declaration, or a function declaration WITH A BODY — an overload
    ; signature is not something a namespace can be merged after.
    function first_non_ambient_class_or_function_declaration(s: ref[Symbol]) returns ref[AstNode]?
    {
        let count Symbol.declaration_count(s)
        var i 0
        while i < count
        {
            let d Symbol.declaration_at(s, i)
            if d <> null
            {
                var eligible false
                let k AstNode.kind_of(d)
                if k = KindClassDeclaration
                    set eligible: true
                if k = KindFunctionDeclaration
                {
                    if Binder.node_is_missing(AstNode.body_of(d)) = false
                        set eligible: true
                }
                if eligible
                {
                    if (AstNode.flags_of(d) & NodeFlagsAmbient) = 0
                        return d
                }
            }
            set i: i + 1
        }
        null
    }

    ; ★★★ A NODE OF THE **LIB** MAY NOT BE REPORTED ON (slice 137), AND NOTHING BEFORE
    ; THIS SLICE COULD REACH ONE. Upstream a diagnostic is filed against the SOURCE
    ; FILE of the node it names, and the harness asks for `GetDiagnostics(unit)` — so
    ; a report the reference makes on a lib declaration is simply not in the list this
    ; suite compares. Every check this port had run walked the unit's own tree, so the
    ; question never came up; the SYMBOL MERGE is the first chapter that reports on a
    ; symbol it did not walk to, and `class Object {}` in the unit made
    ; reportMergeSymbolError name lib.es5.d.ts's `Object` twice.
    ;
    ; ★★★ IT IS ALSO THE SPAN BUG binder_of_node's header WARNED ABOUT, from the other
    ; side: all three reporters compute their range with `b`, the UNIT's binder, so a
    ; lib node would have been reported at the unit's text under the lib's offsets —
    ; *silently*, exactly as that note says. Suppressing the report closes both.
    ;
    ; ★The test is asked in the SUPPRESSING direction (is this provably the lib?)
    ; rather than as *is this the unit*: a synthesized node with no parent chain
    ; answers null for its file, and dropping its report on that ground would delete
    ; diagnostics this port makes today.
    procedure node_is_in_lib(this, n: ref[AstNode]?) returns bool
    {
        if lib_file = null
            return false
        let sf Checker.source_file_of_node(n)
        if sf = lib_file
            return true
        this.extra_lib_index_of(sf) >= 0
    }

    ; the position of a source file among the extra libs, -1 when it is none
    procedure extra_lib_index_of(this, sf: ref[AstNode]?) returns int
    {
        if (extra_lib_files = null) or (sf = null)
            return 0 - 1
        let efs extra_lib_files as ref[Array[ref[AstNode]?]]
        let n efs.get_length() as int
        if (extra_lib_index = null) or (extra_lib_indexed <> n)
        {
            let idx AddressIndex.create(host)
            var li 0
            while li < n
            {
                let ef efs[li as size_t]
                if ef <> null
                {
                    if idx.find((ef as ref[AstNode]) as int) = 0
                        idx.insert((ef as ref[AstNode]) as int, li)
                }
                set li: li + 1
            }
            set extra_lib_index: idx
            set extra_lib_indexed: n
        }
        let ix extra_lib_index as ref[AddressIndex]
        ix.find((sf as ref[AstNode]) as int) - 1
    }

    ; ast.GetSourceFileOfNode — the walk up to the SourceFile.
    ;
    ; ★★ IT ANSWERS THE SAME NODE FOR EVERY ARGUMENT IN THIS HARNESS, because a unit
    ; is one file, and it is ported anyway: the caller compares two of them, so
    ; folding the comparison to `true` would delete a report's CONDITION rather than
    ; its body, and the deletion becomes wrong on the day a second file arrives
    ; (§3.5bg). The reference reaches the file through a cached pointer on every
    ; node; this port has the parent chain and no such slot, and adding one would be
    ; a field whose only reader is a comparison that cannot fail.
    ; ★★★ THE BINDER THAT READ A NODE'S FILE, AND IT IS THE ONE THING TWO FILES
    ; COST (slice 113). Everything the checker asks a Binder is a question about a
    ; NODE — modifier flags, staticness, function flags — except the three that
    ; read SOURCE TEXT: skip_trivia_at, source_slice and error_range_for_node. Ask
    ; those with the wrong binder and you get the unit's text at the lib's offsets,
    ; silently. Every one of those three is reached from a DIAGNOSTIC or from the
    ; printer, and only the printer can meet a lib node.
    procedure binder_of_node(this, n: ref[AstNode]?) returns ref[Binder]
    {
        if lib_file <> null
        {
            let sf Checker.source_file_of_node(n)
            if sf = lib_file
                return lib_b as ref[Binder]
            let li this.extra_lib_index_of(sf)
            if li >= 0
            {
                let ebs extra_lib_binders as ref[Array[ref[Binder]?]]
                return ebs[li as size_t] as ref[Binder]
            }
        }
        if program <> null
        {
            let pfb program as ref[ProgramFiles]
            let psf Checker.source_file_of_node(n)
            let pbi pfb.index_of_file(psf)
            if pbi >= 0
            {
                let pb pfb.binder_at(pbi)
                if pb <> null
                    return pb as ref[Binder]
            }
        }
        b
    }

    ; ── slice 248: the program ──────────────────────────────────────────────

    ; the index of the unit a node belongs to, -1 for a node of no unit (a
    ; synthesized one, or a lib's)
    function program_index_of_node(this, n: ref[AstNode]?) returns int
    {
        if (program = null) or (n = null)
            return 0 - 1
        let pf program as ref[ProgramFiles]
        pf.index_of_file(Checker.source_file_of_node(n))
    }

    ; getModeForUsageLocation, reduced to what decides the resolver's esm mode:
    ; node16/nodenext only; a `require` call or an `import =` is CommonJS, an
    ; import declaration takes its FILE's format
    function usage_is_esm(this, location: ref[AstNode]?, file_format: int) returns bool
    {
        if (module_resolution_kind <> ModuleResolutionKindNode16) and (module_resolution_kind <> ModuleResolutionKindNodeNext)
            return false
        if location <> null
        {
            if Checker.find_ancestor_kind(location, KindImportEqualsDeclaration) <> null
                return false
            let call Checker.find_ancestor_kind(location, KindCallExpression)
            if call <> null
            {
                if Parser.is_require_call(call, false)
                    return false
            }
        }
        file_format = ModuleKindESNext
    }

    ; the usage location's mode for the resolver's conditions (GetModeForUsageLocation
    ; reduced to the emit syntax): a string literal answers as itself, a declaration
    ; through its specifier; None where nothing decides
    function usage_mode_of(this, location: ref[AstNode]?, file_format: int) returns int
        Checker.usage_mode_in(this.resolution_context(), location, file_format)

    function usage_mode_in(rc: ResolutionContext, location: ref[AstNode]?, file_format: int) returns int
    {
        if location = null
            return ModuleKindNone
        let loc location as ref[AstNode]
        ; resolveExternalModule's context specifier (slice 272)
        var context: ref[AstNode]? null
        let lk AstNode.kind_of(loc)
        let parent AstNode.parent_node_of(loc)
        var named_by_module false
        if Checker.kind_or_unknown(parent) = KindModuleDeclaration
        {
            if AstNode.name_of(parent) = location
                set named_by_module: true
        }
        if (lk = KindStringLiteral) or (lk = KindNoSubstitutionTemplateLiteral) or named_by_module
            set context: loc
        else
        {
            if lk = KindModuleDeclaration
                set context: AstNode.name_of(loc)
            else
            {
                if Checker.is_literal_import_type_node(loc)
                    set context: AstNode.literal_type_inner_of(AstNode.import_type_argument_of(loc))
                else
                    set context: Checker.context_specifier_from_ancestors(loc)
            }
        }
        let ck Checker.kind_or_unknown(context)
        if (ck = KindStringLiteral) or (ck = KindNoSubstitutionTemplateLiteral)
            return Checker.mode_for_usage_location_of(rc, context as ref[AstNode])
        Checker.default_resolution_mode_of(rc, loc)
    }

    ; the ancestor searches: an import call's first argument, an import or export
    ; declaration's specifier, an import-equals' external reference
    function context_specifier_from_ancestors(loc: ref[AstNode]) returns ref[AstNode]?
    {
        let call Checker.find_import_call_ancestor(loc)
        if call <> null
            return AstNode.child_in_list(AstNode.call_arguments_of(call), 0)
        var decl Checker.find_ancestor_kind(loc, KindImportDeclaration)
        if decl = null
            set decl: Checker.find_ancestor_kind(loc, KindJSImportDeclaration)
        if decl <> null
            return AstNode.module_specifier_of(decl)
        let export_decl Checker.find_ancestor_kind(loc, KindExportDeclaration)
        if export_decl <> null
            return AstNode.module_specifier_of(export_decl)
        let equals Checker.find_ancestor_kind(loc, KindImportEqualsDeclaration)
        if equals <> null
        {
            let reference AstNode.module_reference_of(equals)
            if Checker.kind_or_unknown(reference) = KindExternalModuleReference
                return AstNode.expression_of(reference)
        }
        null
    }

    ; importSyntaxAffectsModuleResolution
    function import_syntax_affects_module_resolution(this) returns bool
        Checker.import_syntax_affects(this.resolution_context())

    ; the checker's own inputs to the resolution-mode chain, as the record the
    ; FILE LOADER builds from its options — see ResolutionContext's header
    function resolution_context(this) returns ResolutionContext
        ResolutionContext(program, module_kind, module_resolution_kind, resolve_package_json_exports, resolve_package_json_imports, emit_module_format)

    ; importSyntaxAffectsModuleResolution
    function import_syntax_affects(rc: ResolutionContext) returns bool
    {
        let mr rc.module_resolution_kind
        if (mr >= ModuleResolutionKindNode16) and (mr <= ModuleResolutionKindNodeNext)
            return true
        (rc.resolve_exports <> TristateFalse) or (rc.resolve_imports <> TristateFalse)
    }

    ; getModeForUsageLocation: a type-only import's or an import type's
    ; resolution-mode attribute, then the emit syntax where import syntax affects
    ; module resolution
    function mode_for_usage_location(this, usage: ref[AstNode]) returns int
        Checker.mode_for_usage_location_of(this.resolution_context(), usage)

    ; getModeForUsageLocation
    function mode_for_usage_location_of(rc: ResolutionContext, usage: ref[AstNode]) returns int
    {
        let override Checker.resolution_mode_override_of(usage)
        if override <> ModuleKindNone
            return override
        if Checker.import_syntax_affects(rc) = false
            return ModuleKindNone
        Checker.emit_syntax_for_module_specifier(rc, usage)
    }

    ; getDefaultResolutionModeForFile of the node's file
    function default_resolution_mode_for_node(this, node: ref[AstNode]) returns int
        Checker.default_resolution_mode_of(this.resolution_context(), node)

    ; getDefaultResolutionModeForFile
    function default_resolution_mode_of(rc: ResolutionContext, node: ref[AstNode]) returns int
    {
        if Checker.import_syntax_affects(rc) = false
            return ModuleKindNone
        if rc.files = null
            return ModuleKindNone
        let pf rc.files as ref[ProgramFiles]
        let index pf.index_of_file(Checker.source_file_of_node(node))
        if index < 0
            return ModuleKindNone
        let path pf.path_at(index)
        let package_type pf.package_json_type_at(index)
        Checker.implied_node_format_for_emit_of(path, rc.module_kind, Checker.implied_node_format_for_file(path, package_type), package_type)
    }

    ; isSideEffectImport: an import declaration without a clause
    function is_side_effect_import(node: ref[AstNode]?) returns bool
    {
        let decl Checker.find_ancestor_kind(node, KindImportDeclaration)
        if decl = null
            return false
        AstNode.import_clause_of(decl) = null
    }

    ; outDir/rootDir as absolute paths under the harness root, normalized on the
    ; checker's own page (a driver without a page cannot hand a view in)
    procedure set_program_directories(this, out_dir_option: Slice[char], root_dir_option: Slice[char], current_directory: Slice[char])
    {
        let root current_directory
        if (out_dir_option.length as int) > 0
            set out_dir: get_normalized_absolute_path(host, out_dir_option, root)
        if (root_dir_option.length as int) > 0
            set root_dir: get_normalized_absolute_path(host, root_dir_option, root)
    }

    ; ast.GetImpliedNodeFormatForEmitWorker
    function implied_node_format_for_emit_of(path: Slice[char], emit_module_kind: int, implied: int, package_json_type: Slice[char]) returns int
    {
        if (emit_module_kind >= ModuleKindNode16) and (emit_module_kind <= ModuleKindNodeNext)
            return implied
        if implied = ModuleKindCommonJS
        {
            if package_json_type.equals("commonjs") or path.ends_with(".cjs") or path.ends_with(".cts")
                return ModuleKindCommonJS
        }
        if implied = ModuleKindESNext
        {
            if package_json_type.equals("module") or path.ends_with(".mjs") or path.ends_with(".mts")
                return ModuleKindESNext
        }
        ModuleKindNone
    }

    ; ast.GetImpliedNodeFormatForFile
    function implied_node_format_for_file(path: Slice[char], package_json_type: Slice[char]) returns int
    {
        if path.ends_with(".d.mts") or path.ends_with(".mts") or path.ends_with(".mjs")
            return ModuleKindESNext
        if path.ends_with(".d.cts") or path.ends_with(".cts") or path.ends_with(".cjs")
            return ModuleKindCommonJS
        if path.ends_with(".ts") or path.ends_with(".tsx") or path.ends_with(".js") or path.ends_with(".jsx")
        {
            if package_json_type.equals("module")
                return ModuleKindESNext
            return ModuleKindCommonJS
        }
        ModuleKindNone
    }

    ; the driver's switch between units: the checker's per-file state (the
    ; reference reads them off the SourceFile; this port keeps them as fields)
    ; the lib chain's parsers and paths, so that `select_lib_file` can make the
    ; i-th lib the current file — the reference's program holds its libs in
    ; `SourceFiles()` and `checkSourceFiles` walks them like any other file.
    procedure set_lib_chain(this, parsers: ref[Array[ref[Parser]?]]?, paths: ref[Array[Slice[char]]]?)
    {
        set all_lib_parsers: parsers
        set all_lib_paths: paths
    }

    function lib_chain_count(this) returns int
    {
        if all_lib_paths = null
            return 0
        (all_lib_paths as ref[Array[Slice[char]]]).get_length() as int
    }

    function lib_chain_path(this, i: int) returns Slice[char]
    {
        if all_lib_paths = null
            return Slice[char]()
        (all_lib_paths as ref[Array[Slice[char]]])[i as size_t]
    }

    function lib_chain_binder(this, i: int) returns ref[Binder]?
    {
        if i = 0
            return lib_b
        if extra_lib_binders = null
            return null
        (extra_lib_binders as ref[Array[ref[Binder]?]])[(i - 1) as size_t]
    }

    ; checkSourceFile over the i-th default library. It is select_program_file
    ; with the file taken off the lib chain instead of the program's table, and
    ; the per-file state reset the same way.
    procedure select_lib_file(this, i: int) returns bool
    {
        if all_lib_parsers = null
            return false
        var f: ref[AstNode]? lib_file
        if i > 0
        {
            if extra_lib_files = null
                return false
            let ef extra_lib_files as ref[Array[ref[AstNode]?]]
            set f: ef[(i - 1) as size_t]
        }
        if f = null
            return false
        let bb this.lib_chain_binder(i)
        if bb = null
            return false
        let lp (all_lib_parsers as ref[Array[ref[Parser]?]])[i as size_t]
        if lp = null
            return false
        set file: f
        set b: bb as ref[Binder]
        set p: lp as ref[Parser]
        let path this.lib_chain_path(i)
        let name String^host(path.data as pointer[const_char], path.length)
        set is_declaration_file: is_declaration_file_name(name)
        set is_mts_or_cts_file: file_extension_is_mts_or_cts(name)
        set emit_module_format: ModuleKindNone
        set implied_node_format: Checker.implied_node_format_for_file(path, Slice[char]())
        set implied_node_format_for_emit: Checker.implied_node_format_for_emit_of(path, module_kind, implied_node_format, Slice[char]())
        set renamed_binding_elements_in_types: &Array[ref[AstNode]?]^host()
        set requested_external_emit_helpers: 0
        set external_helpers_module: null
        true
    }

    procedure select_program_file(this, index: int, format: int)
    {
        let pf program as ref[ProgramFiles]
        set file: pf.file_at(index)
        set b: pf.binder_at(index) as ref[Binder]
        set p: pf.parser_at(index) as ref[Parser]
        let path pf.path_at(index)
        let name String^host(path.data as pointer[const_char], path.length)
        set is_declaration_file: is_declaration_file_name(name)
        set is_mts_or_cts_file: file_extension_is_mts_or_cts(name)
        set emit_module_format: format
        ; SourceFileMetaData.ImpliedNodeFormat (slice 271): the extension, else the
        ; nearest package.json's `type`
        set implied_node_format: Checker.implied_node_format_for_file(path, pf.package_json_type_at(index))
        set implied_node_format_for_emit: Checker.implied_node_format_for_emit_of(path, module_kind, implied_node_format, pf.package_json_type_at(index))
        ; `c.renamedBindingElementsInTypes = nil` at checkSourceFile — the list
        ; the per-file constructor's note said would need clearing the day a
        ; checker saw a second file
        set renamed_binding_elements_in_types: &Array[ref[AstNode]?]^host()
        set requested_external_emit_helpers: 0
        set external_helpers_module: null
    }

    ; checkExternalEmitHelpers (slice 249): under importHelpers the `tslib` module
    ; is resolved once per file and each requested helper must be exported by it
    procedure check_external_emit_helpers(this, location: ref[AstNode], helpers: int)
    {
        if import_helpers = false
            return
        if this.is_effective_external_module() = false
            return
        if (AstNode.flags_of(location) & NodeFlagsAmbient) <> 0
            return
        let helpers_module this.resolve_helpers_module(location)
        if helpers_module = null
            return
        let hm helpers_module as ref[Symbol]
        if hm = unknown_symbol
            return
        if (requested_external_emit_helpers & helpers) = helpers
            return
        let unchecked helpers & (0 - 1 - requested_external_emit_helpers)
        var helper 1
        while helper <= ExternalEmitHelpersRewriteRelativeImportExtension
        {
            if (unchecked & helper) <> 0
            {
                let names this.get_helper_names(helper)
                var i 0
                while i < (names.get_length() as int)
                {
                    let name names[i as size_t]
                    set i: i + 1
                    let exports this.get_exports_of_module(hm)
                    let symbol this.resolve_symbol(SymbolTable.get(exports, name))
                    if symbol = null
                        this.error_on_node(location, DiagThis_syntax_requires_an_imported_helper_named_1_which_does_not_exist_in_0_Consider_upgrading_your_version_of_0, "tslib", Checker.arg_text(name))
                    else
                    {
                        if (helper & ExternalEmitHelpersClassPrivateFieldGet) <> 0
                        {
                            if this.has_signature_with_arity_greater_than(symbol as ref[Symbol], 3) = false
                                this.error_on_node(location, DiagThis_syntax_requires_an_imported_helper_named_1_with_2_parameters_which_is_not_compatible_with_the_one_in_0_Consider_upgrading_your_version_of_0, "tslib", Checker.arg_text(name), "4")
                        }
                        if (helper & ExternalEmitHelpersClassPrivateFieldSet) <> 0
                        {
                            if this.has_signature_with_arity_greater_than(symbol as ref[Symbol], 4) = false
                                this.error_on_node(location, DiagThis_syntax_requires_an_imported_helper_named_1_with_2_parameters_which_is_not_compatible_with_the_one_in_0_Consider_upgrading_your_version_of_0, "tslib", Checker.arg_text(name), "5")
                        }
                    }
                }
            }
            set helper: helper * 2
        }
        set requested_external_emit_helpers: requested_external_emit_helpers | helpers
    }

    procedure has_signature_with_arity_greater_than(this, symbol: ref[Symbol], arity: int) returns bool
    {
        let signatures this.get_signatures_of_symbol(symbol)
        if signatures = null
            return false
        let list signatures as ref[Array[ref[Signature]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            let sig list[i as size_t]
            set i: i + 1
            if sig <> null
            {
                if this.get_parameter_count(sig as ref[Signature]) > arity
                    return true
            }
        }
        false
    }

    ; getFirstTransformableStaticClassElement (slice 270)
    function get_first_transformable_static_class_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let transform_decorated (legacy_decorators = false) and (language_version < ScriptTargetLatest) and this.class_or_constructor_parameter_is_decorated(false, node)
        let transform_private (language_version < ScriptTargetES2022) or (language_version < ScriptTargetLatest)
        let transform_initializers emit_standard_class_fields = false
        if (transform_decorated = false) and (transform_private = false)
            return null
        let members AstNode.member_list_of(node)
        let n AstNode.list_count(members)
        var i 0
        while i < n
        {
            let mo AstNode.child_in_list(members, i)
            set i: i + 1
            if mo = null
                continue
            let member mo as ref[AstNode]
            if transform_decorated and this.class_element_or_parameter_is_decorated(member, node)
            {
                let first Checker.find_first_decorator(node)
                if first <> null
                    return first
                return node
            }
            else
            {
                if transform_private
                {
                    if AstNode.kind_of(member) = KindClassStaticBlockDeclaration
                        return member
                    if b.is_static(member)
                    {
                        if AstNode.is_private_identifier_class_element_declaration(member)
                            return member
                        if transform_initializers and (AstNode.kind_of(member) = KindPropertyDeclaration) and (AstNode.initializer_of(member) <> null)
                            return member
                    }
                }
            }
        }
        null
    }

    ; ast.ClassElementOrClassElementParameterIsDecorated(false, node, parent): for an
    ; accessor the first of its get/set pair to carry decorators speaks for both
    function class_element_or_parameter_is_decorated(this, node: ref[AstNode], parent: ref[AstNode]) returns bool
    {
        var parameters: ref[Array[ref[AstNode]?]]? null
        let k AstNode.kind_of(node)
        if (k = KindGetAccessor) or (k = KindSetAccessor)
        {
            var first_decorated: ref[AstNode]? null
            var set_accessor: ref[AstNode]? null
            let name_text AstNode.property_name_text_of(AstNode.name_of(node))
            let node_static b.is_static(node)
            let dynamic b.has_dynamic_name(node)
            let members AstNode.member_list_of(parent)
            let mn AstNode.list_count(members)
            var seen 0
            var mi 0
            while mi < mn
            {
                let mo AstNode.child_in_list(members, mi)
                set mi: mi + 1
                if mo = null
                    continue
                let m mo as ref[AstNode]
                var same false
                if dynamic
                    set same: m = node
                else
                {
                    let mk AstNode.kind_of(m)
                    if ((mk = KindGetAccessor) or (mk = KindSetAccessor)) and (b.is_static(m) = node_static)
                        set same: AstNode.property_name_text_of(AstNode.name_of(m)).equals(name_text)
                }
                if same = false
                    continue
                if AstNode.kind_of(m) = KindSetAccessor
                    set set_accessor: m
                if (seen < 2) and (first_decorated = null) and this.has_decorators(m)
                    set first_decorated: m
                set seen: seen + 1
            }
            if first_decorated = null
                return false
            if (first_decorated as ref[AstNode]) <> node
                return false
            if set_accessor <> null
                set parameters: AstNode.parameters_of(set_accessor)
        }
        else
        {
            if k = KindMethodDeclaration
                set parameters: AstNode.parameters_of(node)
        }
        if this.node_is_decorated(false, node, parent, null)
            return true
        let pn AstNode.list_count(parameters)
        var pi 0
        while pi < pn
        {
            let po AstNode.child_in_list(parameters, pi)
            set pi: pi + 1
            if po = null
                continue
            if AstNode.is_this_parameter(po)
                continue
            if this.node_is_decorated(false, po as ref[AstNode], node, parent)
                return true
        }
        false
    }

    ; checkClassExpressionExternalHelpers: an anonymous class expression that is a
    ; named-evaluation source gets its name through __setFunctionName
    procedure check_class_expression_external_helpers(this, node: ref[AstNode])
    {
        if AstNode.name_of(node) <> null
            return
        var parent AstNode.parent_node_of(node)
        while (parent <> null) and Parser.is_outer_expression(parent, 63)
            set parent: AstNode.parent_node_of(parent)
        if parent = null
            return
        let pn parent as ref[AstNode]
        if Checker.is_named_evaluation_source(pn) = false
            return
        var location: ref[AstNode]? null
        if (legacy_decorators = false) and (language_version < ScriptTargetLatest) and this.class_or_constructor_parameter_is_decorated(false, node)
        {
            set location: node
            let first Checker.find_first_decorator(node)
            if first <> null
                set location: first
        }
        else
            set location: this.get_first_transformable_static_class_element(node)
        if location = null
            return
        let loc location as ref[AstNode]
        this.check_external_emit_helpers(loc, ExternalEmitHelpersSetFunctionName)
        let pk AstNode.kind_of(pn)
        if (pk = KindPropertyAssignment) or (pk = KindPropertyDeclaration) or (pk = KindBindingElement)
        {
            if Checker.kind_or_unknown(AstNode.name_of(pn)) = KindComputedPropertyName
                this.check_external_emit_helpers(loc, ExternalEmitHelpersPropKey)
        }
    }

    ; ast.IsNamedEvaluationSource
    function is_named_evaluation_source(node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindPropertyAssignment
        {
            let name AstNode.name_of(node)
            let nk Checker.kind_or_unknown(name)
            if (nk = KindIdentifier) and Checker.name_bytes_are(AstNode.identifier_text_of(name), "__proto__")
                return false
            if (nk = KindStringLiteral) and Checker.name_bytes_are(AstNode.literal_text_of(name), "__proto__")
                return false
            return true
        }
        if k = KindShorthandPropertyAssignment
            return AstNode.shorthand_object_assignment_initializer_of(node) <> null
        if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement)
        {
            if Checker.kind_or_unknown(AstNode.name_of(node)) <> KindIdentifier
                return false
            if AstNode.initializer_of(node) = null
                return false
            if k = KindVariableDeclaration
                return true
            return AstNode.dot_dot_dot_token_of(node) = null
        }
        if k = KindPropertyDeclaration
            return AstNode.initializer_of(node) <> null
        if k = KindBinaryExpression
        {
            let op AstNode.binary_operator_kind(node)
            if (op = KindEqualsToken) or (op = KindAmpersandAmpersandEqualsToken) or (op = KindBarBarEqualsToken) or (op = KindQuestionQuestionEqualsToken)
                return Checker.kind_or_unknown(AstNode.binary_left_of(node)) = KindIdentifier
            return false
        }
        k = KindExportAssignment
    }

    ; resolveHelpersModule: `tslib` resolved from the file (the location stands in
    ; for the program's synthesized import specifier)
    procedure resolve_helpers_module(this, error_node: ref[AstNode]) returns ref[Symbol]?
    {
        if external_helpers_module <> null
            return external_helpers_module
        var found this.resolve_external_module(error_node, "tslib", DiagThis_syntax_requires_an_imported_helper_but_module_0_cannot_be_found, error_node, false)
        if found = null
            set found: unknown_symbol
        set external_helpers_module: found
        found
    }

    ; getHelperNames
    function get_helper_names(this, helper: int) returns ref[Array[Slice[char]]]
    {
        let names &Array[Slice[char]]^host()
        if helper = ExternalEmitHelpersRest
            names.add("__rest")
        if helper = ExternalEmitHelpersDecorate
        {
            if legacy_decorators
                names.add("__decorate")
            else
            {
                names.add("__esDecorate")
                names.add("__runInitializers")
            }
        }
        if helper = ExternalEmitHelpersMetadata
            names.add("__metadata")
        if helper = ExternalEmitHelpersParam
            names.add("__param")
        if helper = ExternalEmitHelpersAwaiter
            names.add("__awaiter")
        if helper = ExternalEmitHelpersAwait
            names.add("__await")
        if helper = ExternalEmitHelpersAsyncGenerator
            names.add("__asyncGenerator")
        if helper = ExternalEmitHelpersAsyncDelegator
            names.add("__asyncDelegator")
        if helper = ExternalEmitHelpersAsyncValues
            names.add("__asyncValues")
        if helper = ExternalEmitHelpersExportStar
            names.add("__exportStar")
        if helper = ExternalEmitHelpersImportStar
            names.add("__importStar")
        if helper = ExternalEmitHelpersImportDefault
            names.add("__importDefault")
        if helper = ExternalEmitHelpersMakeTemplateObject
            names.add("__makeTemplateObject")
        if helper = ExternalEmitHelpersClassPrivateFieldGet
            names.add("__classPrivateFieldGet")
        if helper = ExternalEmitHelpersClassPrivateFieldSet
            names.add("__classPrivateFieldSet")
        if helper = ExternalEmitHelpersClassPrivateFieldIn
            names.add("__classPrivateFieldIn")
        if helper = ExternalEmitHelpersSetFunctionName
            names.add("__setFunctionName")
        if helper = ExternalEmitHelpersPropKey
            names.add("__propKey")
        if helper = ExternalEmitHelpersAddDisposableResourceAndDisposeResources
        {
            names.add("__addDisposableResource")
            names.add("__disposeResources")
        }
        if helper = ExternalEmitHelpersRewriteRelativeImportExtension
            names.add("__rewriteRelativeImportExtension")
        names
    }


    function source_file_of_node(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var p node
        while p <> null
        {
            if AstNode.kind_of(p) = KindSourceFile
                return p
            set p: AstNode.parent_node_of(p)
        }
        null
    }

    ; checkImportDeclaration's prefix. The arm serves ImportDeclaration and
    ; JSImportDeclaration, as the reference's switch does — one `case` with two
    ; kinds — and the report carries the node's own kind so the histogram keeps
    ; them apart.
    ;
    ; ★ `!c.checkGrammarModifiers(node) && node.Modifiers() != nil` is a
    ; short-circuit whose LEFT side is the call: the check always runs, and the
    ; extra report only follows when it found nothing and there is a modifier
    ; anyway. `An import declaration cannot have modifiers` is therefore about a
    ; LEGAL modifier in an illegal place (`export import x from "m"`), not about a
    ; malformed one.
    procedure check_import_declaration(this, node: ref[AstNode])
    {
        var code: int DiagAn_import_declaration_can_only_be_used_at_the_top_level_of_a_namespace_or_module
        if Parser.is_in_js_file(node)
            set code: DiagAn_import_declaration_can_only_be_used_at_the_top_level_of_a_module
        if this.check_grammar_module_element_context(node, code)
            return
        if this.check_grammar_modifiers(node) = false
        {
            if AstNode.modifiers_of(node) <> null
                this.grammar_error_on_first_token(node, DiagAn_import_declaration_cannot_have_modifiers)
        }

        ; ★★ SLICE 58's CONTINUATION. The two branches inside are the reference's
        ; `if importClause != nil && !checkGrammarImportClause(...)` and its
        ; `else if`, and BOTH of them stop at something this port does not have —
        ; but they stop at different things, so they get different tags. The first
        ; is checkImportBinding (collisions + the alias symbol, i.e. the symbol
        ; table); the second is resolveExternalModuleNameWorker behind an option
        ; that is unset, which is the shape the family's other option branches
        ; already have.
        ;
        ; ★ checkImportAttributes is OUTSIDE the whole thing, on purpose: the
        ; reference calls it unconditionally, so a declaration whose external check
        ; FAILED still gets its attributes checked. That is the one line of this
        ; arm that was already reachable before this slice.
        if this.check_external_import_or_export_declaration(node)
        {
            let import_clause AstNode.import_clause_of(node)
            let module_specifier AstNode.module_specifier_of(node)
            if import_clause = null
            {
                ; ANSWERED since slice 110. The message is the side-effect one and
                ; not TS2307: `import "m"` with nothing bound reports
                ; TS2882 instead, which is why this branch had a tag of its own.
                if no_unchecked_side_effect_imports
                    this.resolve_external_module_name_worker(node, module_specifier, DiagCannot_find_module_or_type_declarations_for_side_effect_import_of_0, false, false)
            }
            ; ★★ SLICE 59's CONTINUATION. Three shapes and three different
            ; answers, which is why the tag could not stay one: a DEFAULT import
            ; hands the clause to checkImportBinding, a NAMESPACE import hands it
            ; the namespace node, and a NAMED import list asks the module RESOLVER
            ; first and visits its specifiers only if the module resolved — which
            ; under this harness it never does, so the loop is unreachable and the
            ; tag names the resolver.
            ;
            ; ★ Everything else in this branch is killed by the emit format being
            ; ModuleKindNone: the two CommonJS emit-helper calls (ImportStar and
            ; ImportDefault, with `needsImportStar` the flag that keeps them
            ; exclusive) and, one option further, the JSON-import error, whose gate
            ; is `Node18 <= moduleKind <= NodeNext` and whose value is ES2022. The
            ; flag is not modelled because neither reader exists.
            var resolved_module_of_clause: ref[Symbol]? null
            if import_clause <> null
            {
                if this.check_grammar_import_clause(import_clause) = false
                {
                    if AstNode.name_of(import_clause) <> null
                        this.check_import_binding(import_clause)
                    var needs_import_star false
                    let named_bindings AstNode.named_bindings_of(import_clause)
                    if (AstNode.name_of(import_clause) <> null) and (named_bindings <> null)
                    {
                        if (AstNode.kind_of(named_bindings) = KindNamespaceImport) and (emit_module_format = ModuleKindCommonJS)
                            set needs_import_star: true
                    }
                    if (AstNode.name_of(import_clause) <> null) and (needs_import_star = false) and (emit_module_format = ModuleKindCommonJS)
                        this.check_external_emit_helpers(node, ExternalEmitHelpersImportDefault)
                    if named_bindings <> null
                    {
                        if AstNode.kind_of(named_bindings) = KindNamespaceImport
                        {
                            this.check_import_binding(named_bindings)
                            if emit_module_format = ModuleKindCommonJS
                                this.check_external_emit_helpers(node, ExternalEmitHelpersImportStar)
                        }
                        else
                        {
                            ; ANSWERED since slice 110 — and the loop it guards is
                            ; entered only when the module RESOLVED, which under
                            ; this harness means an ambient one.
                            let um25 this.unported_mark()
                            let resolved_module this.resolve_external_module_name(node, module_specifier, false)
                            if this.unported_mark() <> um25
                                return
                            set resolved_module_of_clause: resolved_module
                            if resolved_module <> null
                            {
                                let els AstNode.elements_of(named_bindings)
                                let en AstNode.list_count(els)
                                var ei 0
                                while ei < en
                                {
                                    let binding AstNode.child_in_list(els, ei)
                                    set ei: ei + 1
                                    if binding = null
                                        continue
                                    let um26 this.unported_mark()
                                    this.check_import_binding(binding as ref[AstNode])
                                    if this.unported_mark() <> um26
                                        return
                                }
                            }
                        }
                    }
                    ; a JSON file imported into an ECMAScript module without
                    ; `with { type: "json" }` (node18..nodenext)
                    if (Checker.is_type_only_import_or_export_declaration(import_clause) = false) and (module_kind >= ModuleKindNode18) and (module_kind <= ModuleKindNodeNext)
                    {
                        if this.is_only_importable_as_default(module_specifier, resolved_module_of_clause) and (Checker.has_type_json_import_attribute(node) = false)
                            this.error_on_node(module_specifier, DiagImporting_a_JSON_file_into_an_ECMAScript_module_requires_a_type_Colon_json_import_attribute_when_module_is_set_to_0, Checker.module_kind_name(module_kind))
                    }
                }
            }
        }
        this.check_import_attributes(node)
    }

    ; hasTypeJsonImportAttribute
    function has_type_json_import_attribute(node: ref[AstNode]) returns bool
    {
        let attributes AstNode.import_attributes_of(node)
        if attributes = null
            return false
        let list AstNode.import_attribute_list_of(attributes)
        let n AstNode.list_count(list)
        var i 0
        while i < n
        {
            let attr AstNode.child_in_list(list, i)
            set i: i + 1
            if attr = null
                continue
            if Checker.identifier_text_is(AstNode.name_of(attr as ref[AstNode]), "type") = false
                continue
            let value AstNode.import_attribute_value_of(attr as ref[AstNode])
            let vk Checker.kind_or_unknown(value)
            if (vk = KindStringLiteral) or (vk = KindNoSubstitutionTemplateLiteral)
            {
                if Checker.name_bytes_are(AstNode.literal_text_of(value as ref[AstNode]), "json")
                    return true
            }
        }
        false
    }

    ; checkImportEqualsDeclaration's prefix. It shares the import declaration's two
    ; illegal-context messages — the reference passes the same pair — and discards
    ; the modifier check's result, so there is no second modifier report here.
    procedure check_import_equals_declaration(this, node: ref[AstNode])
    {
        var code: int DiagAn_import_declaration_can_only_be_used_at_the_top_level_of_a_namespace_or_module
        if Parser.is_in_js_file(node)
            set code: DiagAn_import_declaration_can_only_be_used_at_the_top_level_of_a_module
        if this.check_grammar_module_element_context(node, code)
            return
        this.check_grammar_modifiers(node)
        if this.should_check_erasable_syntax(node)
        {
            if (AstNode.flags_of(node) & NodeFlagsAmbient) = 0
                this.error_on_node(node, DiagThis_syntax_is_not_allowed_when_erasableSyntaxOnly_is_enabled)
        }
        ; ★★ SLICE 58 CLOSES THE FIRST OF THE TWO TAGS AND LEAVES THE SECOND. The
        ; disjunction is `IsInternalModuleImportEqualsDeclaration(node) ||
        ; checkExternalImportOrExportDeclaration(node)`, and its left side is a
        ; PURE KIND TEST — an internal `import A = B.C` never asks the external
        ; check at all. So the external half is now answered and both roads meet at
        ; checkImportBinding, which is the symbol table.
        ;
        ; ★ The `||` short-circuits, so the external check must not run for an
        ; internal reference. Written as two statements rather than as one `or`,
        ; because a bare `a or b` here would evaluate b for every namespace import
        ; and the call is not free of REPORTS.
        var proceed false
        if AstNode.import_equals_reference_kind(node) <> KindExternalModuleReference
            set proceed: true
        if proceed = false
            set proceed: this.check_external_import_or_export_declaration(node)
        ; ★★★ SLICE 110 CLOSES SLICE 59's PREDICTION AND IT WAS EXACT: *the external
        ; arm reports TS1202 for `import a = require("m")` under an ES module target,
        ; which is what this harness's ES2022 is.* checkAliasSymbol is ported now, so
        ; the arm is reachable and the report is made.
        if proceed = false
            return
        this.check_import_binding(node)
        ; ★★★ NO MARK-GUARD BETWEEN THESE THREE, and the first draft had one: it cost
        ; the TS1202 this arm exists for, because checkAliasSymbol stops on an import
        ; whose module nothing resolves and the guard then returned. The reference's
        ; three statements are INDEPENDENT — record_unported has never aborted a walk
        ; and diagcheck's relation is a SUBSEQUENCE — so a report made after one that
        ; was skipped is sound, which is the convention check_source_elements states.
        this.mark_linked_references(node, ReferenceHintExportImportEquals, null, null)
        if AstNode.import_equals_reference_kind(node) = KindExternalModuleReference
        {
            ; ★ `ES2015 <= moduleKind <= ESNext` is TRUE here (ES2022), so the only
            ; two things that can suppress it are the declaration's own `type`
            ; keyword and an ambient context.
            if module_kind < ModuleKindES2015
                return
            if module_kind > ModuleKindESNext
                return
            if AstNode.is_type_only_of(node)
                return
            if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
                return
            this.grammar_error_on_node(node, DiagImport_assignment_cannot_be_used_when_targeting_ECMAScript_modules_Consider_using_import_Asterisk_as_ns_from_mod_import_a_from_mod_import_d_from_mod_or_another_module_format_instead)
            return
        }
        ; ★★★ THE INTERNAL ARM, SLICE 129 — and the stop's stated reason was not its
        ; blocker (§3.5dk, once more from the outside). It read *the first also needs
        ; checkTypeNameIsReserved's sibling and DeclarationNameToString for its
        ; message*: check_type_name_is_reserved has been in this file since slice 74,
        ; and DeclarationNameToString is a message ARGUMENT — this port's diagnostics
        ; are (pos, end, code) with no arguments at all (§3.20 is the same fact from
        ; the error-chain side), so the renderer the stop was waiting for has no
        ; counterpart to wait for.
        let own this.get_symbol_of_declaration(node)
        var target: ref[Symbol]? null
        if own <> null
            set target: this.resolve_alias(own as ref[Symbol])
        if target <> null
        {
            let tgt target as ref[Symbol]
            if tgt <> unknown_symbol
            {
                let target_flags this.get_symbol_flags(tgt)
                if (target_flags & SymbolFlagsValue) <> 0
                {
                    ; A value target may be HIDDEN by a local of the same name, and
                    ; the test is that the module name resolves to a namespace.
                    let module_name Checker.get_first_identifier(AstNode.module_reference_of(node))
                    if module_name = null
                        this.record_unported("import-equals-internal-target", AstNode.kind_of(node))
                    else
                    {
                        let mn module_name as ref[AstNode]
                        let resolved this.resolve_entity_name(mn, SymbolFlagsValue | SymbolFlagsNamespace, false, false, null)
                        ; ★ The reference dereferences that answer unguarded, so a nil
                        ; there is its PANIC and not a FALSE — reported the way every
                        ; other unreachable panic in this file is, rather than folded
                        ; into the report below (which would invent a TS2437).
                        if resolved = null
                            this.record_unported("import-equals-internal-target", AstNode.kind_of(node))
                        else
                        {
                            if (Symbol.flags_of(resolved as ref[Symbol]) & SymbolFlagsNamespace) = 0
                                this.error_on_node(mn, DiagModule_0_is_hidden_by_a_local_declaration_with_the_same_name, this.declaration_name_to_string(mn))
                        }
                    }
                }
                if (target_flags & SymbolFlagsType) <> 0
                    this.check_type_name_is_reserved(AstNode.name_of(node), DiagImport_name_cannot_be_0)
            }
        }
        if AstNode.is_type_only_of(node)
            this.grammar_error_on_node(node, DiagAn_import_alias_cannot_use_import_type)
    }

    ; checkExportDeclaration's prefix — and the ONE arm of this family that can run
    ; to the END.
    ;
    ; ★★★ `export {}` COMPLETES, and it is the only shape here that does. With no
    ; module specifier the `||` short-circuits, so checkExternalImportOrExportDeclaration
    ; is never asked; with an EMPTY clause the specifier loop has nothing to visit;
    ; the three context bools then permit it at the top level of a file; and
    ; checkImportAttributes returns at its own first line because there is no
    ; `with { … }`. So the check reaches the bottom and the unit's C section becomes
    ; comparable — which is the only way the matched count can move in this slice,
    ; the same argument slice 49 made for why its count could NOT.
    ;
    ; ★★★ SLICE 58 MADE THE SPECIFIER-BEARING HALF REACHABLE, AND THAT TURNED THE
    ; SPECIFIER TEST FROM A SHORTCUT INTO A CONDITION IN TWO PLACES. The reference
    ; asks `ModuleSpecifier == nil` twice — once as the left disjunct of the guard,
    ; and once inside `inAmbientNamespaceDeclaration` — and while the arm returned
    ; at the first of them the second was a tautology, so slice 50 could write "from
    ; here the module specifier is nil" and mean it. It is not nil any more, and the
    ; test had to come back explicitly. **A condition that is true because of where
    ; the code stopped is a condition that expires when the code stops later**, and
    ; the only thing that marks such a line is that somebody wrote down WHY it was
    ; omitted — which slice 50 did.
    ;
    ; ★★ THE SPECIFIER-LOOP TAG MARKS AND NO LONGER RETURNS. checkExportSpecifier is
    ; still the symbol table, but the namespace report BELOW the loop is not, and
    ; with `export { a } from "m"` now reaching the block that report has a
    ; population it never had. record_unported keeps the FIRST tag either way, and
    ; diagcheck's relation is a SUBSEQUENCE, so a report we make after one we skip
    ; is sound — the convention this file has followed since slice 52.
    procedure check_export_declaration(this, node: ref[AstNode])
    {
        var code: int DiagAn_export_declaration_can_only_be_used_at_the_top_level_of_a_namespace_or_module
        if Parser.is_in_js_file(node)
            set code: DiagAn_export_declaration_can_only_be_used_at_the_top_level_of_a_module
        if this.check_grammar_module_element_context(node, code)
            return
        if this.check_grammar_modifiers(node) = false
        {
            if AstNode.modifiers_of(node) <> null
                this.grammar_error_on_first_token(node, DiagAn_export_declaration_cannot_have_modifiers)
        }
        this.check_grammar_export_declaration(node)

        ; The `||`, short-circuiting: with no module specifier the external check
        ; is never asked.
        let module_specifier AstNode.module_specifier_of(node)
        var proceed false
        if module_specifier = null
            set proceed: true
        if proceed = false
            set proceed: this.check_external_import_or_export_declaration(node)
        if proceed = false
        {
            this.check_import_attributes(node)
            return
        }

        let clause AstNode.export_clause_of(node)
        var named false
        if clause <> null
        {
            if AstNode.kind_of(clause) <> KindNamespaceExport
                set named: true
        }
        if named = false
        {
            ; `export * from "m"` and `export * as ns from "m"` — ANSWERED since
            ; slice 110. ★The two emit-helper calls at the end of the branch are
            ; behind `emit_module_format == ModuleKindCommonJS`, and the stub
            ; program answers None.
            let um27 this.unported_mark()
            let module_symbol this.resolve_external_module_name(node, module_specifier, false)
            if this.unported_mark() <> um27
            {
                this.check_import_attributes(node)
                return
            }
            var uses_export_equals false
            if module_symbol <> null
                set uses_export_equals: this.has_export_assignment_symbol(module_symbol as ref[Symbol])
            if uses_export_equals
                this.error_on_node(module_specifier, DiagModule_0_uses_export_and_cannot_be_used_with_export_Asterisk, this.symbol_arg(module_symbol))
            else
            {
                if clause <> null
                {
                    let um28 this.unported_mark()
                    this.check_alias_symbol(clause as ref[AstNode])
                    if this.unported_mark() <> um28
                    {
                        this.check_import_attributes(node)
                        return
                    }
                    this.check_module_export_name(AstNode.name_of(clause), true)
                }
            }
            if emit_module_format = ModuleKindCommonJS
            {
                if clause <> null
                    this.check_external_emit_helpers(node, ExternalEmitHelpersImportStar)
                else
                    this.check_external_emit_helpers(node, ExternalEmitHelpersExportStar)
            }
            this.check_import_attributes(node)
            return
        }

        let els AstNode.elements_of(clause)
        let en AstNode.list_count(els)
        var ei 0
        while ei < en
        {
            let binding AstNode.child_in_list(els, ei)
            set ei: ei + 1
            if binding = null
                continue
            let um29 this.unported_mark()
            this.check_export_specifier(binding as ref[AstNode])
            if this.unported_mark() <> um29
                return
        }

        let parent AstNode.parent_node_of(node)
        let pk Checker.kind_or_unknown(parent)
        var in_ambient_external_module false
        if pk = KindModuleBlock
        {
            if Checker.is_ambient_module_or_null(AstNode.parent_node_of(parent))
                set in_ambient_external_module: true
        }
        var in_ambient_namespace_declaration false
        if in_ambient_external_module = false
        {
            if pk = KindModuleBlock
            {
                if module_specifier = null
                {
                    if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
                        set in_ambient_namespace_declaration: true
                }
            }
        }
        var permitted false
        if pk = KindSourceFile
            set permitted: true
        if in_ambient_external_module
            set permitted: true
        if in_ambient_namespace_declaration
            set permitted: true
        if permitted = false
            this.error_on_node(node, DiagExport_declarations_are_not_permitted_in_a_namespace)

        this.check_import_attributes(node)
    }

    ; checkExportAssignment's prefix.
    ;
    ; ★★ ONE PATH OF IT RETURNS, and it is unreachable today for the reason the
    ; family's header gives: the container walk finds a ModuleDeclaration only for
    ; an `export = x` inside a namespace BODY, and a body's statements are reached
    ; through this slice's own block arm — so the path exists, and the corpus is
    ; what says whether anything takes it.
    ;
    ; ★ `ast.IsExportAssignment(node)` in the modifier condition is always true
    ; here: the reference's switch routes exactly one kind to this arm. Kept as the
    ; reference's structure would read, minus a test that cannot fail.
    procedure check_export_assignment(this, node: ref[AstNode])
    {
        let unported_before this.unported_mark()
        let is_export_equals AstNode.is_export_equals_of(node)
        var code: int DiagA_default_export_must_be_at_the_top_level_of_a_file_or_module_declaration
        if is_export_equals
            set code: DiagAn_export_assignment_must_be_at_the_top_level_of_a_file_or_module_declaration
        if this.check_grammar_module_element_context(node, code)
            return
        if this.should_check_erasable_syntax(node)
        {
            if is_export_equals
            {
                if (AstNode.flags_of(node) & NodeFlagsAmbient) = 0
                    this.error_on_node(node, DiagThis_syntax_is_not_allowed_when_erasableSyntaxOnly_is_enabled)
            }
        }

        var container AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(container) <> KindSourceFile
            set container: AstNode.parent_node_of(container)
        if Checker.kind_or_unknown(container) = KindModuleDeclaration
        {
            if Checker.is_ambient_module_or_null(container) = false
            {
                if is_export_equals
                    this.error_on_node(node, DiagAn_export_assignment_cannot_be_used_in_a_namespace)
                if is_export_equals = false
                    this.error_on_node(node, DiagA_default_export_can_only_be_used_in_an_ECMAScript_style_module)
                return
            }
        }

        if this.check_grammar_modifiers(node) = false
        {
            if AstNode.modifiers_of(node) <> null
                this.grammar_error_on_first_token(node, DiagAn_export_assignment_cannot_have_modifiers)
        }

        ; isIllegalExportDefaultInCJS. VerbatimModuleSyntax stands in front of the
        ; whole conjunction and is unset, so the term is false without asking.
        ; Behind the option rather than omitted, and under the tag slice 49 gave the
        ; same missing machinery. ★What used to stand here added *and it reaches
        ; program.GetEmitModuleFormatOfFile, which the stub program does not have*;
        ; slice 54 measured that and it is false — the oracle's program HAS the
        ; method and answers ModuleKindNone. The option is the whole of the hole.

        ; ★★★ BOTH TAGS ARE ANSWERED SINCE SLICE 110, AND THE FUNCTION NOW RUNS TO
        ; ITS END. `isIllegalExportDefaultInCJS` is false — verbatimModuleSyntax is
        ; unset — so every report inside the identifier branch that reads it, and
        ; every verbatimModuleSyntax and isolatedModules report below it, has no
        ; host; what is left of that branch is the resolution, the reference
        ; marking, and checkExpressionCached for a value.
        var illegal_default_in_cjs false
        if (is_export_equals = false) and ((AstNode.flags_of(node) & NodeFlagsAmbient) = 0) and verbatim_module_syntax and (this.file_emit_format_of(Checker.source_file_of_node(node)) = ModuleKindCommonJS)
            set illegal_default_in_cjs: true
        let e AstNode.expression_of(node)
        if Checker.kind_or_unknown(e) = KindIdentifier
        {
            let id e as ref[AstNode]
            let sym this.get_export_symbol_of_value_symbol_if_exported(this.resolve_entity_name(id, SymbolFlagsAll, true, true, node))
            if this.unported_mark() <> unported_before
                return
            if sym <> null
            {
                this.mark_linked_references(node, ReferenceHintExportAssignment, null, null)
                if this.unported_mark() <> unported_before
                    return
                ; the verbatimModuleSyntax arms (slice 249): an `export =`/`export default`
                ; of a type or a type-only alias is reported, unless it is the illegal
                ; default in a CommonJS-format file (reported elsewhere)
                let ambient (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
                let type_only_declaration this.get_type_only_alias_declaration_ex(sym as ref[Symbol], SymbolFlagsValue)
                if (this.get_symbol_flags(sym as ref[Symbol]) & SymbolFlagsValue) <> 0
                {
                    this.check_expression_cached(id)
                    if (illegal_default_in_cjs = false) and (ambient = false) and verbatim_module_syntax and (type_only_declaration <> null)
                    {
                        if is_export_equals
                            this.error_on_node(id, DiagAn_export_declaration_must_reference_a_real_value_when_verbatimModuleSyntax_is_enabled_but_0_resolves_to_a_type_only_declaration, Checker.arg_text(AstNode.identifier_text_of(id)))
                        else
                            this.error_on_node(id, DiagAn_export_default_must_reference_a_real_value_when_verbatimModuleSyntax_is_enabled_but_0_resolves_to_a_type_only_declaration, Checker.arg_text(AstNode.identifier_text_of(id)))
                    }
                }
                else
                {
                    if (illegal_default_in_cjs = false) and (ambient = false) and verbatim_module_syntax
                    {
                        if is_export_equals
                            this.error_on_node(id, DiagAn_export_declaration_must_reference_a_value_when_verbatimModuleSyntax_is_enabled_but_0_only_refers_to_a_type, Checker.arg_text(AstNode.identifier_text_of(id)))
                        else
                            this.error_on_node(id, DiagAn_export_default_must_reference_a_value_when_verbatimModuleSyntax_is_enabled_but_0_only_refers_to_a_type, Checker.arg_text(AstNode.identifier_text_of(id)))
                    }
                }
                if (illegal_default_in_cjs = false) and (ambient = false) and this.get_isolated_modules() and ((Symbol.flags_of(sym as ref[Symbol]) & SymbolFlagsValue) = 0)
                {
                    let non_local_meanings this.get_symbol_flags_ex(sym as ref[Symbol], false, true)
                    var same_file false
                    if type_only_declaration <> null
                        set same_file: Checker.source_file_of_node(type_only_declaration) = Checker.source_file_of_node(node)
                    if ((Symbol.flags_of(sym as ref[Symbol]) & SymbolFlagsAlias) <> 0) and ((non_local_meanings & SymbolFlagsType) <> 0) and ((non_local_meanings & SymbolFlagsValue) = 0) and (same_file = false)
                    {
                        if is_export_equals
                            this.error_on_node(id, DiagX_0_resolves_to_a_type_and_must_be_marked_type_only_in_this_file_before_re_exporting_when_1_is_enabled_Consider_using_import_type_where_0_is_imported, Checker.arg_text(AstNode.identifier_text_of(id)), this.isolated_modules_like_flag_name())
                        else
                            this.error_on_node(id, DiagX_0_resolves_to_a_type_and_must_be_marked_type_only_in_this_file_before_re_exporting_when_1_is_enabled_Consider_using_export_type_0_as_default, Checker.arg_text(AstNode.identifier_text_of(id)), this.isolated_modules_like_flag_name())
                    }
                    else
                    {
                        if (type_only_declaration <> null) and (same_file = false)
                        {
                            let reexport_mark this.diagnostic_mark()
                            if is_export_equals
                                this.error_on_node(id, DiagX_0_resolves_to_a_type_only_declaration_and_must_be_marked_type_only_in_this_file_before_re_exporting_when_1_is_enabled_Consider_using_import_type_where_0_is_imported, Checker.arg_text(AstNode.identifier_text_of(id)), this.isolated_modules_like_flag_name())
                            else
                                this.error_on_node(id, DiagX_0_resolves_to_a_type_only_declaration_and_must_be_marked_type_only_in_this_file_before_re_exporting_when_1_is_enabled_Consider_using_export_type_0_as_default, Checker.arg_text(AstNode.identifier_text_of(id)), this.isolated_modules_like_flag_name())
                            this.add_type_only_declaration_related_info(reexport_mark, type_only_declaration, Checker.arg_text(AstNode.identifier_text_of(id)))
                        }
                    }
                }
                if this.unported_mark() <> unported_before
                    return
            }
            else
                ; "doesn't resolve, check as expression to mark as error"
                this.check_expression_cached(id)
            if this.unported_mark() <> unported_before
                return
        }
        else
        {
            if e = null
                return
            let export_type this.check_expression_cached(e as ref[AstNode])
            if export_type = null
                return
        }
        if illegal_default_in_cjs
            this.report_verbatim_module_syntax_error(node)
        if container = null
            return
        this.check_external_module_exports(container as ref[AstNode])
        if this.unported_mark() <> unported_before
            return
        ; `node.Type() != nil && node.Kind == KindExportAssignment` — the annotated
        ; form, whose body is the assignability relation.
        if AstNode.type_of(node) <> null
        {
            ; The annotated form: the annotation's type against the expression's.
            let tn AstNode.type_of(node) as ref[AstNode]
            let t this.get_type_from_type_node(tn)
            let expr AstNode.expression_of(node)
            if expr <> null
            {
                let initializer_type this.check_expression_cached(expr as ref[AstNode])
                if t <> null
                {
                    if initializer_type <> null
                        this.check_type_assignable_to_and_optionally_elaborate(initializer_type as ref[Type], t as ref[Type], expr, expr, 0)
                }
            }
        }
        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
        {
            if Binder.is_entity_name_expression(AstNode.expression_of(node)) = false
                this.grammar_error_on_node(AstNode.expression_of(node), DiagThe_expression_of_an_export_assignment_must_be_an_identifier_or_qualified_name_in_an_ambient_context)
        }
        if is_export_equals
        {
            ; ★★★ THE LIVE ONE: module_kind is ES2022, implied_node_format is
            ; ModuleKindNone, so a NON-ambient `export = x` reports TS1203 (None is
            ; not CommonJS) and an ambient one does not (None is not ESNext).
            if module_kind >= ModuleKindES2015
            {
                if module_kind <> ModuleKindPreserve
                {
                    var reports false
                    if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
                    {
                        if implied_node_format_for_emit = ModuleKindESNext
                            set reports: true
                    }
                    else
                    {
                        if implied_node_format_for_emit <> ModuleKindCommonJS
                            set reports: true
                    }
                    if reports
                        this.grammar_error_on_node(node, DiagExport_assignment_cannot_be_used_when_targeting_ECMAScript_modules_Consider_using_export_default_or_another_module_format_instead)
                }
            }
        }
    }

    ; checkImportAttributes, whole (slice 129) — the `with { type: "json" }` clause.
    ;
    ; ★★★ WHAT THE STOP WAS WAITING FOR IS NOW ORDINARY: it read *behind the guard
    ; stands getGlobalImportAttributesTypeChecked, i.e. the global type table and
    ; the assignability relation, so the rest is a dimension rather than a step*.
    ; Slice 128 built `get_global_type_of_arity` for the iteration globals and the
    ; relation has been here since 101, so both halves of that sentence are steps.
    ;
    ; ★★★ THE MODULE KIND DECIDES MOST OF THIS FUNCTION UNDER THIS HARNESS, AND IT
    ; IS WRITTEN AS THE REFERENCE'S TEST RATHER THAN AS ITS ANSWER. ES2022 does NOT
    ; support import attributes (the supported set is node18…nodenext, preserve and
    ; esnext), so every `with` clause in this corpus reports TS2823 and returns
    ; after the assignability check — the CommonJS arm, the type-only arm and the
    ; resolution-mode arm below it are unreachable HERE and not unwritten, which is
    ; a claim with a date on it (§3.5bg): a harness with `module: nodenext` reaches
    ; all three.
    procedure check_import_attributes(this, declaration: ref[AstNode])
    {
        let na AstNode.import_attributes_of(declaration)
        if na = null
            return
        let node na as ref[AstNode]
        this.report_checked_global_type("ImportAttributes", 0)
        let attributes_type this.get_global_type_of_arity("ImportAttributes", 0)
        if attributes_type = null
            return
        if (attributes_type as ref[Type]) <> (empty_object_type as ref[Type])
        {
            let from_node this.get_type_from_import_attributes(node)
            if from_node = null
                return
            let nullable this.get_nullable_type(attributes_type as ref[Type], TypeFlagsUndefined)
            if nullable = null
                return
            this.check_type_assignable_to(from_node as ref[Type], nullable as ref[Type], node, 0)
        }
        let is_type_only Checker.is_exclusively_type_only_import_or_export(declaration)
        let override this.get_resolution_mode_override(node, is_type_only)
        if is_type_only
        {
            if override <> ModuleKindNone
                return
        }
        if Checker.module_kind_supports_import_attributes(module_kind) = false
        {
            this.grammar_error_on_node(node, DiagImport_attributes_are_only_supported_when_the_module_option_is_set_to_esnext_node18_node20_nodenext_or_preserve)
            return
        }
        let specifier this.get_module_specifier_from_node(declaration)
        if specifier <> null
        {
            if this.get_emit_syntax_for_module_specifier_expression(specifier) = ModuleKindCommonJS
            {
                this.grammar_error_on_node(node, DiagImport_attributes_are_not_allowed_on_statements_that_compile_to_CommonJS_require_calls)
                return
            }
        }
        if is_type_only
        {
            this.grammar_error_on_node(node, DiagImport_attributes_cannot_be_used_with_type_only_imports_or_exports)
            return
        }
        if override <> ModuleKindNone
            this.grammar_error_on_node(node, DiagX_resolution_mode_can_only_be_set_for_type_only_imports)
    }

    ; core.ModuleKind.SupportsImportAttributes.
    function module_kind_supports_import_attributes(kind: int) returns bool
    {
        if kind = ModuleKindPreserve
            return true
        if kind = ModuleKindESNext
            return true
        if kind < ModuleKindNode18
            return false
        kind <= ModuleKindNodeNext
    }

    ; ast.IsExclusivelyTypeOnlyImportOrExport — the `type` keyword on the whole
    ; declaration, which for an import lives on the CLAUSE and for an export on the
    ; declaration itself.
    function is_exclusively_type_only_import_or_export(node: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(node)
        if k = KindExportDeclaration
            return AstNode.is_type_only_of(node)
        var has_clause false
        if k = KindImportDeclaration
            set has_clause: true
        if k = KindJSImportDeclaration
            set has_clause: true
        if k = KindJSDocImportTag
            set has_clause: true
        if has_clause = false
            return false
        let clause AstNode.import_clause_of(node)
        if clause = null
            return false
        AstNode.is_type_only_of(clause as ref[AstNode])
    }

    ; getResolutionModeOverride, whole. ★Its `reportErrors` argument is the caller's
    ; `isTypeOnly`, which is why a NON-type-only `with` clause runs the same walk
    ; silently: the answer is still needed for the last report of the function.
    ; `GetResolutionModeOverride()` without its grammar half — the value only
    function resolution_mode_override_quiet(node: ref[AstNode]) returns int
    {
        let list AstNode.import_attribute_list_of(node)
        var n 0
        if list <> null
            set n: (list as ref[Array[ref[AstNode]?]]).get_length() as int
        if n <> 1
            return ModuleKindNone
        let elem (list as ref[Array[ref[AstNode]?]])[0]
        if elem = null
            return ModuleKindNone
        let name AstNode.name_of(elem as ref[AstNode])
        if name = null
            return ModuleKindNone
        if Parser.is_string_literal_like(name) = false
            return ModuleKindNone
        if Checker.name_bytes_are(AstNode.literal_text_of(name), "resolution-mode") = false
            return ModuleKindNone
        let value AstNode.import_attribute_value_of(elem as ref[AstNode])
        if value = null
            return ModuleKindNone
        if Parser.is_string_literal_like(value) = false
            return ModuleKindNone
        let vt AstNode.literal_text_of(value)
        if Checker.name_bytes_are(vt, "import")
            return ModuleKindESNext
        if Checker.name_bytes_are(vt, "require")
            return ModuleKindCommonJS
        ModuleKindNone
    }

    procedure get_resolution_mode_override(this, node: ref[AstNode], report_errors: bool) returns int
    {
        let list AstNode.import_attribute_list_of(node)
        var n 0
        if list <> null
            set n: (list as ref[Array[ref[AstNode]?]]).get_length() as int
        if n <> 1
        {
            if report_errors
                this.grammar_error_on_node(node, DiagType_import_attributes_should_have_exactly_one_key_resolution_mode_with_value_import_or_require)
            return ModuleKindNone
        }
        let elem (list as ref[Array[ref[AstNode]?]])[0]
        if elem = null
            return ModuleKindNone
        let name AstNode.name_of(elem as ref[AstNode])
        if name = null
            return ModuleKindNone
        if Parser.is_string_literal_like(name) = false
            return ModuleKindNone
        if Checker.name_bytes_are(AstNode.literal_text_of(name), "resolution-mode") = false
        {
            if report_errors
                this.grammar_error_on_node(name, DiagX_resolution_mode_is_the_only_valid_key_for_type_import_attributes)
            return ModuleKindNone
        }
        let value AstNode.import_attribute_value_of(elem as ref[AstNode])
        if value = null
            return ModuleKindNone
        if Parser.is_string_literal_like(value) = false
            return ModuleKindNone
        let vt AstNode.literal_text_of(value)
        if Checker.name_bytes_are(vt, "import")
            return ModuleKindESNext
        if Checker.name_bytes_are(vt, "require")
            return ModuleKindCommonJS
        if report_errors
            this.grammar_error_on_node(value, DiagX_resolution_mode_should_be_either_require_or_import)
        ModuleKindNone
    }

    ; getTypeFromImportAttributes — the `with { … }` clause read as an OBJECT TYPE,
    ; one property per attribute with the attribute's value type.
    procedure get_type_from_import_attributes(this, node: ref[AstNode]) returns ref[Type]?
    {
        let links this.type_node_link_of(node)
        if links.resolved_type <> null
            return links.resolved_type
        var sd Slice[char]()
        set sd: Binder.internal_name(host, "importAttributes")
        let symbol this.new_symbol(SymbolFlagsObjectLiteral, sd)
        let members SymbolTable.create(host)
        let list AstNode.import_attribute_list_of(node)
        if list <> null
        {
            let attrs list as ref[Array[ref[AstNode]?]]
            let n attrs.get_length() as int
            var i 0
            while i < n
            {
                let a attrs[i]
                set i: i + 1
                if a = null
                    continue
                let attr a as ref[AstNode]
                let name AstNode.name_of(attr)
                if name = null
                    continue
                let nd AstNode.property_name_text_of(name)
                if nd.data = null
                    continue
                let nl AstNode.property_name_text_length_of(name)
                let member this.new_symbol(SymbolFlagsProperty, nd)
                let v AstNode.import_attribute_value_of(attr)
                if v = null
                    continue
                let vt this.check_expression(v as ref[AstNode])
                if vt = null
                    return null
                let rt this.get_regular_type_of_literal_type(vt as ref[Type])
                if rt = null
                    return null
                set this.value_symbol_link_of(member).resolved_type: rt
                SymbolTable.set_entry(host, members, nd, member)
            }
        }
        let t this.new_anonymous_type(symbol, members, null, null, null)
        if t = null
            return null
        let ty t as ref[Type]
        set ty.object_flags: ty.object_flags | ObjectFlagsObjectLiteral | ObjectFlagsNonInferrableType
        set links.resolved_type: ty
        links.resolved_type
    }

    ; ── slice 58: checkExternalImportOrExportDeclaration ─────────────────────
    ;
    ; ★★★ THE SLICE IS ONE FUNCTION AND IT UNBLOCKS THREE ARMS AT ONCE, which is
    ; what made it the biggest row on slice 57's work list without being the
    ; biggest function: `check-external-import-or-export-declaration` stood at
    ; 1 588 units under ImportDeclaration, 411 under ImportEqualsDeclaration and
    ; 216 under ExportDeclaration. Slice 50 put those three tags there in one
    ; commit and named the boundary it was drawing — *everything these arms call in
    ; grammarchecks.go is ported; the first call into a CHECK of checker.go is
    ; where each arm reports* — so this is the first slice of the family to cross
    ; that line, and it crosses it at the one checker.go function of the six that
    ; needs neither the symbol table nor a type.
    ;
    ; ★★ WHAT IT NEEDS INSTEAD IS A PATH PREDICATE, and that is why tspath grew
    ; three functions rather than the checker growing one: `IsExternalModuleNameRelative`
    ; is asked of a module SPECIFIER, not of a file name, and it is the same
    ; function the module resolver will ask the day that dimension opens.
    ;
    ; ★ Its result is a BOOL and all three callers read it — two as the right
    ; disjunct of an `||` whose left side can skip it entirely. That shape is the
    ; reason the two import arms could not simply be widened in place: the export
    ; arm asks it only when there IS a module specifier, and the import-equals arm
    ; only when the reference is EXTERNAL, so each caller's guard had to be ported
    ; with it.
    procedure check_external_import_or_export_declaration(this, node: ref[AstNode]) returns bool
    {
        let module_name AstNode.get_external_module_name(node)
        if module_name = null
            return false
        if Binder.node_is_missing(module_name)
            return false
        if AstNode.kind_of(module_name) <> KindStringLiteral
        {
            this.error_on_node(module_name, DiagString_literal_expected)
            return false
        }

        let parent AstNode.parent_node_of(node)
        var in_ambient_external_module false
        if Checker.kind_or_unknown(parent) = KindModuleBlock
        {
            if Checker.is_ambient_module_or_null(AstNode.parent_node_of(parent))
                set in_ambient_external_module: true
        }
        if Checker.kind_or_unknown(parent) <> KindSourceFile
        {
            if in_ambient_external_module = false
            {
                ; ★ The message is chosen by the node's KIND and the two are not
                ; each other's negation: an export declaration says *export
                ; declarations are not permitted in a namespace* (TS1194, the same
                ; code the export arm's own tail reports for the no-specifier
                ; case), an import says *import declarations in a namespace cannot
                ; reference a module* (TS1147). The reference's `IfElse` is a
                ; two-arm choice over IsExportDeclaration, so JSImportDeclaration
                ; falls to the import side with ImportDeclaration.
                var code: int DiagImport_declarations_in_a_namespace_cannot_reference_a_module
                if AstNode.kind_of(node) = KindExportDeclaration
                    set code: DiagExport_declarations_are_not_permitted_in_a_namespace
                this.error_on_node(module_name, code)
                return false
            }
        }

        if in_ambient_external_module
        {
            if is_external_module_name_relative(AstNode.literal_text_of(module_name))
            {
                ; ★★ The GUARD is the interesting half and it is a suppression, not
                ; a condition: checkModuleDeclaration has already reported on a
                ; top-level import/export of an external module AUGMENTATION, so
                ; this one is skipped to avoid saying it twice. The reference's own
                ; comment says exactly that, and it is why the test is
                ; `isTopLevelInExternalModuleAugmentation` — a question about the
                ; enclosing module's relationship to its FILE — rather than
                ; anything about this declaration.
                if Checker.is_top_level_in_external_module_augmentation(this.binder_of_node(node), node) = false
                {
                    this.error_on_node(node, DiagImport_or_export_declaration_in_an_ambient_module_declaration_cannot_reference_module_through_relative_module_name)
                    return false
                }
            }
        }

        if AstNode.kind_of(node) <> KindImportEqualsDeclaration
        {
            let attributes AstNode.import_attributes_of(node)
            if attributes <> null
            {
                ; ★ The loop does NOT stop at the first bad value — every attribute
                ; whose value is not a string literal is reported, and the accumulated
                ; flag is the answer. `import x from "m" with { a: 1, b: 2 }` is two
                ; diagnostics, which is what makes a control that returns early
                ; measurable.
                var has_error false
                let attrs AstNode.import_attribute_list_of(attributes)
                let n AstNode.list_count(attrs)
                var i 0
                while i < n
                {
                    let value AstNode.import_attribute_value_of(AstNode.child_in_list(attrs, i))
                    if Checker.kind_or_unknown(value) <> KindStringLiteral
                    {
                        set has_error: true
                        this.error_on_node(value, DiagImport_attribute_values_must_be_string_literal_expressions)
                    }
                    set i: i + 1
                }
                return has_error = false
            }
        }
        true
    }

    ; isTopLevelInExternalModuleAugmentation, whole — three tests and a hop, and
    ; the last of them is the binder's `is_module_augmentation_external`, which
    ; already existed because bind_module_declaration asks the same question.
    ;
    ; ★ It takes the BINDER rather than being a method on it, because the caller is
    ; the checker and the reference's is a free function in checker/utilities.go.
    ; The binder is passed for the one field the answer depends on
    ; (is_external_module), which is a property of the FILE and not of the node.
    function is_top_level_in_external_module_augmentation(b: ref[Binder], node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let parent AstNode.parent_node_of(node)
        if parent = null
            return false
        if AstNode.kind_of(parent) <> KindModuleBlock
            return false
        let grand AstNode.parent_node_of(parent)
        if Checker.is_ambient_module_or_null(grand) = false
            return false
        b.is_module_augmentation_external(grand)
    }

    ; ast.IsGlobalSourceFile, slice 65: a SourceFile that is not an external or
    ; CommonJS module — i.e. a SCRIPT.
    ;
    ; ★ It takes the binder for is_top_level_in_external_module_augmentation's
    ; reason: the second half of the question is a property of the FILE, which the
    ; binder computed once at construction, and not of the node handed in.
    ; ast.IsGlobalSourceFile over the binder of the node's OWN file: a declaration
    ; container in another program file is global by that file's module-ness.
    procedure is_global_source_file_node(this, node: ref[AstNode]?) returns bool
    {
        if Checker.kind_or_unknown(node) <> KindSourceFile
            return false
        this.binder_of_node(node).is_external_or_common_js_module() = false
    }

    function is_global_source_file(b: ref[Binder], node: ref[AstNode]?) returns bool
    {
        if Checker.kind_or_unknown(node) <> KindSourceFile
            return false
        b.is_external_or_common_js_module() = false
    }

    ; checkGrammarImportClause, whole — two arms over the phase modifier, and the
    ; one grammar check of this family slice 50 could not reach.
    ;
    ; ★★★ THE DEFER ARM'S THIRD REPORT IS LIVE BECAUSE THE UNSET `module` OPTION
    ; DERIVES TO ES2022, not because anything sets it — see Checker.module_kind.
    ; `import defer * as ns from "m"` therefore reports TS18060 here, and a reading
    ; of the unset option as ModuleKindNone would have made that line unreachable
    ; while leaving the file compiling and every yardstick green.
    ;
    ; ★ The JSDoc guard on the type arm is the reparser's: a `@import` tag builds
    ; an ImportClause with NodeFlagsJSDoc set, where a default name and named
    ; bindings together are the tag's own syntax rather than a mistake.
    procedure check_grammar_import_clause(this, node: ref[AstNode]) returns bool
    {
        let phase AstNode.import_clause_phase_modifier_of(node)
        let named_bindings AstNode.named_bindings_of(node)
        if phase = KindTypeKeyword
        {
            if (AstNode.flags_of(node) & NodeFlagsJSDoc) = 0
            {
                if AstNode.name_of(node) <> null
                {
                    if named_bindings <> null
                        return this.grammar_error_on_node(node, DiagA_type_only_import_can_specify_a_default_import_or_named_bindings_but_not_both)
                }
            }
            if Checker.kind_or_unknown(named_bindings) = KindNamedImports
                return this.check_grammar_type_only_named_imports_or_exports(named_bindings)
        }
        if phase = KindDeferKeyword
        {
            if AstNode.name_of(node) <> null
                return this.grammar_error_on_node(node, DiagDefault_imports_are_not_allowed_in_a_deferred_import)
            if Checker.kind_or_unknown(named_bindings) = KindNamedImports
                return this.grammar_error_on_node(node, DiagNamed_imports_are_not_allowed_in_a_deferred_import)
            if module_kind <> ModuleKindESNext
            {
                if module_kind <> ModuleKindPreserve
                    return this.grammar_error_on_node(node, DiagDeferred_imports_are_only_supported_when_the_module_flag_is_set_to_esnext_or_preserve)
            }
        }
        false
    }

    ; ── slice 51: the class declaration ─────────────────────────────────────
    ;
    ; ★★★ THE SLICE IS THE HEAD checkGrammarClassLikeDeclaration AND THE ONE ARM
    ; IT PREFIXES, and the line it stops at is the same KIND of line slice 50's
    ; was — a call into a CHECK the port does not have — but it takes three
    ; functions to get there rather than one, because two of them turn out to be
    ; guards. checkClassDeclaration's own prefix is a legacy-decorator report and
    ; the missing-name test; checkClassLikeDeclaration's first line is the head;
    ; and checkDecorators, which follows it, RETURNS at its own first line for
    ; every class that carries no decorator — which is nearly all of them. So the
    ; report lands on checkCollisionsForDeclarationName, a row this column already
    ; has for the module and enum arms.
    ;
    ; ★★ WHAT IT COST IS NOT IN THIS FILE: the head reports at spans only a
    ; NodeList's own range knows, so §3.5bq's side table had to become readable
    ; one phase later. See the class-like grammar checks below check_grammar_modifiers.

    ; checkDecorators, whole (slice 134 — slice 51 ported the guard alone).
    ;
    ; ★★ THE THREE-WAY `||` IS THE COMMON CASE. `!CanHaveDecorators(node) ||
    ; !HasDecorators(node) || !NodeCanBeDecorated(...)` returns for any node
    ; without a decorator, so this function is a no-op for a plain class and the
    ; check continues past it.
    ;
    ; ★★★ THE EMIT-HELPER BRANCH IS TAKEN AND ITS CALLEE IS A NO-OP, which is the
    ; opposite of what slice 51's note guessed and is why the whole function is
    ; here now rather than one line of it. See the slice-134 header below.
    ;
    ; ★ The parent and grandparent are read null-safely, for the reason
    ; kind_or_unknown exists: upstream reads `node.Parent.Parent` straight out of
    ; the call and a nil Parent is a readable zero in Go.
    procedure check_decorators(this, node: ref[AstNode])
    {
        if AstNode.can_have_decorators(node) = false
            return
        if this.has_decorators(node) = false
            return
        let parent AstNode.parent_node_of(node)
        var grandparent: ref[AstNode]? null
        if parent <> null
            set grandparent: AstNode.parent_node_of(parent)
        if this.node_can_be_decorated(legacy_decorators, node, parent, grandparent) = false
            return
        let first_decorator Checker.find_first_decorator(node)
        if first_decorator = null
            return
        let fd first_decorator as ref[AstNode]
        let dk AstNode.kind_of(node)
        if legacy_decorators
        {
            this.check_external_emit_helpers(fd, ExternalEmitHelpersDecorate)
            if dk = KindParameter
                this.check_external_emit_helpers(fd, ExternalEmitHelpersParam)
        }
        else
        {
            if language_version < ScriptTargetLatest
            {
                ; ExternalEmitHelpersESDecorateAndRunInitializers is the Decorate bit
                this.check_external_emit_helpers(fd, ExternalEmitHelpersDecorate)
                if dk = KindClassDeclaration
                {
                    if (AstNode.name_of(node) = null) or (this.get_first_transformable_static_class_element(node) <> null)
                        this.check_external_emit_helpers(fd, ExternalEmitHelpersSetFunctionName)
                }
                else
                {
                    if dk <> KindClassExpression
                    {
                        let dname AstNode.name_of(node)
                        if AstNode.is_private_identifier(dname) and ((dk = KindMethodDeclaration) or (dk = KindGetAccessor) or (dk = KindSetAccessor) or b.is_auto_accessor_property_declaration(node))
                            this.check_external_emit_helpers(fd, ExternalEmitHelpersSetFunctionName)
                        if Checker.kind_or_unknown(dname) = KindComputedPropertyName
                            this.check_external_emit_helpers(fd, ExternalEmitHelpersPropKey)
                    }
                }
            }
        }
        this.mark_linked_references(node, ReferenceHintDecorator, null, null)
        let mark this.unported_mark()
        let mods AstNode.modifiers_of(node)
        if mods = null
            return
        let list mods as ref[Array[ref[AstNode]?]]
        let len list.get_length() as int
        var i 0
        while i < len
        {
            let m list[i]
            set i: i + 1
            if AstNode.is_decorator(m) = false
                continue
            this.check_decorator(m as ref[AstNode])
            if this.unported_mark() <> mark
                return
        }
    }

    ; ── slice 134: THE DECORATOR CHAPTER ─────────────────────────────────────
    ;
    ; ★★★ THE STOP THIS SLICE REMOVES WAS A CLAIM ABOUT AN OPTION AND THE CLAIM
    ; WAS WRONG IN BOTH DIRECTIONS. check_decorators' header said the tag names the
    ; function *"because which one comes first depends on a compiler option that is
    ; not read anywhere yet"*, and both of the option's readings turn out to be
    ; decidable here. `legacyDecorators` is `ExperimentalDecorators == TSTrue` and
    ; the harness leaves it unset, so the ES arm is the live one — but
    ; `languageVersion < LanguageFeatureMinimumTarget.ClassAndClassElementDecorators`
    ; is ES2025 < ESNext, i.e. TRUE, so the branch behind it is TAKEN and not dead.
    ; That is exactly the mistake check_grammar_for_use_strict_simple_parameter_list
    ; already warns about with the sign flipped: an unset option is not a dead
    ; branch, and which half it kills depends on the reference's own default.
    ;
    ; ★★★ WHAT MAKES THE BRANCH HARMLESS ANYWAY IS ITS CALLEE'S FIRST LINE, not the
    ; option: checkExternalEmitHelpers is `if !c.compilerOptions.ImportHelpers
    ; .IsTrue() { return }` and ImportHelpers is unset — the provable no-op this
    ; file has already priced five times. So the arm is written as the condition it
    ; is, with the call named and not made, and getFirstTransformableStaticClassElement
    ; goes with it: it is PURE, its only reader is that call's argument list, and a
    ; pure function computed for a no-op is a no-op.
    ;
    ; ★★ markLinkedReferences' DECORATOR arm is the second such no-op, and its
    ; guard is a DIFFERENT option: markDecoratorAliasReferenced returns at
    ; `EmitDecoratorMetadata.IsFalseOrUnknown()`, which is TRUE for an unset option.
    ; It is written into mark_linked_references rather than left as its tag, so
    ; that the walk continues past it the way the reference's does.
    ;
    ; ★★★ THE CHAPTER IS THEREFORE checkDecorator, AND checkDecorator IS A CALL —
    ; which is why this slice reaches five functions nobody expected in a chapter
    ; named after a modifier: resolve_signature's KindDecorator arm, an ARGUMENT
    ; LIST that has no source text (getEffectiveDecoratorArguments synthesizes one
    ; expression per parameter of the decorator's OWN signature), an ARITY that
    ; comes from the signature rather than from the list, and the ES decorator
    ; context types, which are nine globals and eight constructions over them.

    ; checkSyntheticExpression. ★The SPREAD arm is written and unreachable here:
    ; the only writer of `is_spread` is getEffectiveCallArguments' spread branch,
    ; which is a stop in this port (`get-effective-call-arguments-spread`).
    procedure check_synthetic_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        let link this.synthetic_expression_link_of(node)
        if link = null
        {
            this.record_unported("check-synthetic-expression", AstNode.kind_of(node))
            return null
        }
        let l link as ref[SyntheticExpressionLink]
        let t l.resolved_type
        if t = null
            return null
        if l.is_spread = false
            return t
        this.get_indexed_access_type(t as ref[Type], number_type)
    }

    ; tryCreateTypeReference. ★The guard is what turns a MISSING global into
    ; `unknown` rather than into a reference to emptyGenericType — see the
    ; decorator globals' header for why that failure value is the interesting half
    ; of §3.11's debt.
    procedure try_create_type_reference(this, target: ref[Type]?, type_arguments: ref[Array[ref[Type]?]]?) returns ref[Type]?
    {
        if target = null
            return null
        let tgt target as ref[Type]
        var arg_count 0
        if type_arguments <> null
            set arg_count: (type_arguments as ref[Array[ref[Type]?]]).get_length() as int
        if arg_count <> 0
        {
            if tgt = empty_generic_type
                return unknown_type
        }
        this.create_type_reference(tgt, type_arguments, ObjectFlagsNone)
    }

    ; newParameter and newProperty — one transient symbol carrying a type, and the
    ; only difference is the flag.
    ; ★ The NAME is page-copied through plain_name rather than handed in as a
    ; literal pointer, which is this file's idiom for every synthetic symbol
    ; (get_type_from_import_attributes, create_tuple_type_ex's `length`): a symbol
    ; carries a borrowed `(data, len)` pair, and one whose data points into the
    ; binary rather than into the checker's page is a second lifetime nobody
    ; declared.
    procedure new_parameter(this, word: Slice[char], t: ref[Type]?) returns ref[Symbol]
    {
        var nd Slice[char]()
        set nd: Checker.plain_name(host, word)
        let sym this.new_symbol(SymbolFlagsFunctionScopedVariable, nd)
        set this.value_symbol_link_of(sym).resolved_type: t
        sym
    }

    procedure new_property(this, word: Slice[char], t: ref[Type]?) returns ref[Symbol]
    {
        var nd Slice[char]()
        set nd: Checker.plain_name(host, word)
        let sym this.new_symbol(SymbolFlagsProperty, nd)
        set this.value_symbol_link_of(sym).resolved_type: t
        sym
    }

    ; newCallSignature. ★★ THE SYNTHETIC DECLARATION IS LOAD-BEARING AND IT IS THE
    ; ONE PART OF THIS FUNCTION THAT LOOKS LIKE DECORATION: `c.factory
    ; .NewFunctionTypeNode(nil, nil, NewKeywordTypeNode(KindAnyKeyword))` is read
    ; by getOrCreateTypeFromSignature, which asks the declaration's KIND and treats
    ; a signature with NO declaration as a CONSTRUCT signature (`kind ==
    ; KindUnknown` is one of its four constructor kinds). Drop the node and every
    ; getter/setter function type built here comes out with its call signature in
    ; the construct slot.
    procedure new_call_signature(this, type_parameters: ref[Array[ref[Type]?]]?, this_parameter: ref[Symbol]?, parameters: ref[Array[ref[Symbol]?]]?, return_type: ref[Type]?) returns ref[Signature]
    {
        let any_node this.new_synthetic_node(KindAnyKeyword, NodeData.Token(TokenData()))
        let decl this.new_synthetic_node(KindFunctionType, NodeData.FunctionType(FunctionTypeData(null, null, any_node)))
        var count 0
        if parameters <> null
            set count: (parameters as ref[Array[ref[Symbol]?]]).get_length() as int
        this.new_signature(SignatureFlagsNone, decl, type_parameters, this_parameter, parameters, return_type, count)
    }

    ; getOrCreateTypeFromSignature — "createTypeFromSignature", the isolated
    ; single-signature object type a signature denotes.
    procedure get_or_create_type_from_signature(this, sig: ref[Signature]) returns ref[Type]?
    {
        if sig.isolated_signature_type <> null
            return sig.isolated_signature_type
        var kind KindUnknown
        if sig.declaration <> null
            set kind: AstNode.kind_of(sig.declaration as ref[AstNode])
        ; "If declaration is undefined, it is likely to be the signature of the
        ; default constructor."
        var is_constructor false
        if kind = KindUnknown
            set is_constructor: true
        if kind = KindConstructor
            set is_constructor: true
        if kind = KindConstructSignature
            set is_constructor: true
        if kind = KindConstructorType
            set is_constructor: true
        var sym: ref[Symbol]? null
        if sig.declaration <> null
            set sym: AstNode.symbol_of(sig.declaration as ref[AstNode])
        let t this.new_object_type(ObjectFlagsAnonymous | ObjectFlagsSingleSignatureType, sym)
        if t = null
            return null
        let obj t as ref[Type]
        let sigs this.new_signature_list()
        sigs.add(sig)
        if is_constructor
            this.set_structured_type_members(obj, null, null, sigs, null)
        else
            this.set_structured_type_members(obj, null, sigs, null, null)
        set sig.isolated_signature_type: obj
        obj
    }

    ; newFunctionType, newGetterFunctionType and newSetterFunctionType — the three
    ; wrappers the ES accessor decorators put around their value type.
    procedure new_function_type(this, type_parameters: ref[Array[ref[Type]?]]?, this_parameter: ref[Symbol]?, parameters: ref[Array[ref[Symbol]?]]?, return_type: ref[Type]?) returns ref[Type]?
        this.get_or_create_type_from_signature(this.new_call_signature(type_parameters, this_parameter, parameters, return_type))

    procedure new_getter_function_type(this, t: ref[Type]?) returns ref[Type]?
        this.new_function_type(null, null, null, t)

    procedure new_setter_function_type(this, t: ref[Type]?) returns ref[Type]?
    {
        let value_param this.new_parameter("value", t)
        let params this.new_symbol_list()
        params.add(value_param)
        this.new_function_type(null, null, params, void_type)
    }

    ; ── the nine decorator globals ──────────────────────────────────────────

    procedure get_global_typed_property_descriptor_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("TypedPropertyDescriptor", 1)
        if global_typed_property_descriptor_type <> null
            return global_typed_property_descriptor_type
        let t this.get_global_type_of_arity("TypedPropertyDescriptor", 1)
        set global_typed_property_descriptor_type: t
        t
    }

    ; getGlobalType("ThisType", 1). ★ The reference's field is `globalThisType`,
    ; which is NOT the type of the global `this` — that is `globalThisSymbol`'s
    ; type, a different thing this file also reads. The name here says marker so
    ; the two cannot be confused at a call site.
    procedure get_global_this_marker_type(this) returns ref[Type]?
    {
        if global_this_marker_type <> null
            return global_this_marker_type
        let t this.get_global_type_of_arity("ThisType", 1)
        set global_this_marker_type: t
        t
    }

    procedure get_global_class_decorator_context_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("ClassDecoratorContext", 1)
        if global_class_decorator_context_type <> null
            return global_class_decorator_context_type
        let t this.get_global_type_of_arity("ClassDecoratorContext", 1)
        set global_class_decorator_context_type: t
        t
    }

    procedure get_global_class_method_decorator_context_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("ClassMethodDecoratorContext", 2)
        if global_class_method_decorator_context_type <> null
            return global_class_method_decorator_context_type
        let t this.get_global_type_of_arity("ClassMethodDecoratorContext", 2)
        set global_class_method_decorator_context_type: t
        t
    }

    procedure get_global_class_getter_decorator_context_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("ClassGetterDecoratorContext", 2)
        if global_class_getter_decorator_context_type <> null
            return global_class_getter_decorator_context_type
        let t this.get_global_type_of_arity("ClassGetterDecoratorContext", 2)
        set global_class_getter_decorator_context_type: t
        t
    }

    procedure get_global_class_setter_decorator_context_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("ClassSetterDecoratorContext", 2)
        if global_class_setter_decorator_context_type <> null
            return global_class_setter_decorator_context_type
        let t this.get_global_type_of_arity("ClassSetterDecoratorContext", 2)
        set global_class_setter_decorator_context_type: t
        t
    }

    procedure get_global_class_accessor_decorator_context_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("ClassAccessorDecoratorContext", 2)
        if global_class_accessor_decorator_context_type <> null
            return global_class_accessor_decorator_context_type
        let t this.get_global_type_of_arity("ClassAccessorDecoratorContext", 2)
        set global_class_accessor_decorator_context_type: t
        t
    }

    procedure get_global_class_accessor_decorator_target_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("ClassAccessorDecoratorTarget", 2)
        if global_class_accessor_decorator_target_type <> null
            return global_class_accessor_decorator_target_type
        let t this.get_global_type_of_arity("ClassAccessorDecoratorTarget", 2)
        set global_class_accessor_decorator_target_type: t
        t
    }

    procedure get_global_class_accessor_decorator_result_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("ClassAccessorDecoratorResult", 2)
        if global_class_accessor_decorator_result_type <> null
            return global_class_accessor_decorator_result_type
        let t this.get_global_type_of_arity("ClassAccessorDecoratorResult", 2)
        set global_class_accessor_decorator_result_type: t
        t
    }

    procedure get_global_class_field_decorator_context_type(this) returns ref[Type]?
    {
        this.report_checked_global_type("ClassFieldDecoratorContext", 2)
        if global_class_field_decorator_context_type <> null
            return global_class_field_decorator_context_type
        let t this.get_global_type_of_arity("ClassFieldDecoratorContext", 2)
        set global_class_field_decorator_context_type: t
        t
    }

    ; ── the context types over them ─────────────────────────────────────────

    procedure new_class_decorator_context_type(this, class_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(1)
        args.add(class_type)
        this.try_create_type_reference(this.get_global_class_decorator_context_type(), args)
    }

    procedure new_class_method_decorator_context_type(this, class_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(2)
        args.add(class_type)
        args.add(value_type)
        this.try_create_type_reference(this.get_global_class_method_decorator_context_type(), args)
    }

    procedure new_class_getter_decorator_context_type(this, class_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(2)
        args.add(class_type)
        args.add(value_type)
        this.try_create_type_reference(this.get_global_class_getter_decorator_context_type(), args)
    }

    procedure new_class_setter_decorator_context_type(this, class_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(2)
        args.add(class_type)
        args.add(value_type)
        this.try_create_type_reference(this.get_global_class_setter_decorator_context_type(), args)
    }

    procedure new_class_accessor_decorator_context_type(this, this_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(2)
        args.add(this_type)
        args.add(value_type)
        this.try_create_type_reference(this.get_global_class_accessor_decorator_context_type(), args)
    }

    procedure new_class_field_decorator_context_type(this, this_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(2)
        args.add(this_type)
        args.add(value_type)
        this.try_create_type_reference(this.get_global_class_field_decorator_context_type(), args)
    }

    procedure new_class_accessor_decorator_target_type(this, this_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(2)
        args.add(this_type)
        args.add(value_type)
        this.try_create_type_reference(this.get_global_class_accessor_decorator_target_type(), args)
    }

    procedure new_class_accessor_decorator_result_type(this, this_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(2)
        args.add(this_type)
        args.add(value_type)
        this.try_create_type_reference(this.get_global_class_accessor_decorator_result_type(), args)
    }

    procedure new_class_field_decorator_initializer_mutator_type(this, this_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let this_param this.new_parameter("this", this_type)
        let value_param this.new_parameter("value", value_type)
        let params this.new_symbol_list()
        params.add(value_param)
        this.new_function_type(null, this_param, params, value_type)
    }

    ; getClassMemberDecoratorContextOverrideType — "a type like `{ name: "foo",
    ; private: false, static: true }` that is used to provide member-specific
    ; details that will be intersected with a decorator context type".
    procedure get_class_member_decorator_context_override_type(this, name_type: ref[Type], is_private: bool, is_static: bool) returns ref[Type]?
    {
        let link this.decorator_context_override_link_of(name_type, is_private, is_static)
        if link.override_type <> null
            return link.override_type
        let members SymbolTable.create(host)
        var nd Slice[char]()
        set nd: Checker.plain_name(host, "name")
        SymbolTable.set_entry(host, members, nd, this.new_property("name", name_type))
        var private_value: ref[Type]? false_type
        if is_private
            set private_value: true_type
        var pd Slice[char]()
        set pd: Checker.plain_name(host, "private")
        SymbolTable.set_entry(host, members, pd, this.new_property("private", private_value))
        var static_value: ref[Type]? false_type
        if is_static
            set static_value: true_type
        var sd Slice[char]()
        set sd: Checker.plain_name(host, "static")
        SymbolTable.set_entry(host, members, sd, this.new_property("static", static_value))
        let t this.new_anonymous_type(null, members, null, null, null)
        set link.override_type: t
        t
    }

    ; newClassMemberDecoratorContextTypeForNode. ★The PRIVATE name takes the
    ; string literal of its own text where a public one goes through
    ; getLiteralTypeFromPropertyName — a private name is not a property name and
    ; that helper would ask for a symbol it does not have.
    procedure new_class_member_decorator_context_type_for_node(this, node: ref[AstNode], this_type: ref[Type]?, value_type: ref[Type]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        let is_static b.has_syntactic_modifier(node, ModifierFlagsStatic)
        let name AstNode.name_of(node)
        if name = null
            return null
        let nm name as ref[AstNode]
        let is_private AstNode.kind_of(nm) = KindPrivateIdentifier
        var name_type: ref[Type]? null
        if is_private
        {
            set name_type: this.get_string_literal_type(AstNode.identifier_text_of(nm))
        }
        else
            set name_type: this.get_literal_type_from_property_name(nm)
        if this.unported_mark() <> mark
            return null
        if name_type = null
            return null
        let k AstNode.kind_of(node)
        var context_type: ref[Type]? null
        if k = KindMethodDeclaration
            set context_type: this.new_class_method_decorator_context_type(this_type, value_type)
        else
        {
            if k = KindGetAccessor
                set context_type: this.new_class_getter_decorator_context_type(this_type, value_type)
            else
            {
                if k = KindSetAccessor
                    set context_type: this.new_class_setter_decorator_context_type(this_type, value_type)
                else
                {
                    if k <> KindPropertyDeclaration
                    {
                        ; `panic("Unhandled case in createClassMemberDecoratorContextTypeForNode")`,
                        ; held as a row on this file's rule for the reference's own
                        ; assertions.
                        this.record_unported("class-member-decorator-context-unhandled", k)
                        return null
                    }
                    if b.has_syntactic_modifier(node, ModifierFlagsAccessor)
                        set context_type: this.new_class_accessor_decorator_context_type(this_type, value_type)
                    else
                        set context_type: this.new_class_field_decorator_context_type(this_type, value_type)
                }
            }
        }
        if this.unported_mark() <> mark
            return null
        let override_type this.get_class_member_decorator_context_override_type(name_type as ref[Type], is_private, is_static)
        if this.unported_mark() <> mark
            return null
        if context_type = null
            return null
        if override_type = null
            return null
        let pair &Array[ref[Type]?]()
        pair.add(context_type)
        pair.add(override_type)
        this.get_intersection_type(pair)
    }

    ; ── the LEGACY decorator's signature ────────────────────────────────────
    ;
    ; ★★ IT IS INERT UNDER THIS HARNESS AND IT IS WRITTEN OUT ANYWAY, which is the
    ; shape check_this_in_static_class_field_initializer_in_decorated_class and
    ; check_class_declaration's legacy_decorators branch already have: a branch
    ; written as `if false` reads as dead code somebody should delete, and one
    ; behind the named field reads as the option it is waiting for.

    ; newTypedPropertyDescriptorType.
    procedure new_typed_property_descriptor_type(this, property_type: ref[Type]?) returns ref[Type]?
    {
        let args this.new_type_list_of(1)
        args.add(property_type)
        this.create_type_from_generic_global_type(this.get_global_typed_property_descriptor_type(), args)
    }

    ; getParentTypeOfClassElement — the STATIC side for a static member and the
    ; INSTANCE side for the rest.
    procedure get_parent_type_of_class_element(this, node: ref[AstNode]) returns ref[Type]?
    {
        let parent AstNode.parent_node_of(node)
        if parent = null
            return null
        let class_symbol this.get_symbol_of_node(parent as ref[AstNode])
        if class_symbol = null
            return null
        let sym class_symbol as ref[Symbol]
        if this.declaration_is_static(node)
            return this.get_type_of_symbol(sym)
        this.get_declared_type_of_symbol(sym)
    }

    ; getClassElementPropertyKeyType.
    procedure get_class_element_property_key_type(this, element: ref[AstNode]) returns ref[Type]?
    {
        let name AstNode.name_of(element)
        if name = null
            return null
        let nm name as ref[AstNode]
        let k AstNode.kind_of(nm)
        var plain false
        if k = KindIdentifier
            set plain: true
        if k = KindNumericLiteral
            set plain: true
        if k = KindStringLiteral
            set plain: true
        if plain
            return this.get_string_literal_type(AstNode.property_name_text_of(nm))
        if k = KindComputedPropertyName
        {
            let mark this.unported_mark()
            let name_type this.check_computed_property_name(nm)
            if this.unported_mark() <> mark
                return null
            if name_type = null
                return null
            if this.is_type_assignable_to_kind(name_type as ref[Type], TypeFlagsESSymbolLike)
                return name_type
            return string_type
        }
        this.record_unported("class-element-property-key", k)
        null
    }

    ; getLegacyDecoratorCallSignature (slice 248): the expected signature of an
    ; experimental decorator — `(target)` for a class, `(target, propertyKey,
    ; parameterIndex)` for a parameter, `(target, propertyKey[, descriptor])` for
    ; a member — memoized on the decorated node's signature link
    procedure get_legacy_decorator_call_signature(this, decorator: ref[AstNode]) returns ref[Signature]?
    {
        let parent AstNode.parent_node_of(decorator)
        if parent = null
            return null
        let node parent as ref[AstNode]
        let links this.signature_link_of(node)
        if links.decorator_signature = null
        {
            let mark this.unported_mark()
            set links.decorator_signature: any_signature
            let made this.legacy_decorator_call_signature_worker(node)
            if this.unported_mark() <> mark
            {
                set links.decorator_signature: null
                return null
            }
            if made <> null
                set links.decorator_signature: made
        }
        let ds links.decorator_signature
        if ds = null
            return null
        if (ds as ref[Signature]) = any_signature
            return null
        ds
    }

    procedure legacy_decorator_call_signature_worker(this, node: ref[AstNode]) returns ref[Signature]?
    {
        let k AstNode.kind_of(node)
        if (k = KindClassDeclaration) or (k = KindClassExpression)
        {
            let sym this.get_symbol_of_declaration(node)
            if sym = null
                return null
            let target_type this.get_type_of_symbol(sym as ref[Symbol])
            let params &Array[ref[Symbol]?]^host()
            params.add(this.new_parameter("target", target_type))
            let members &Array[ref[Type]?]^host()
            members.add(target_type)
            members.add(void_type)
            return this.new_call_signature(null, null, params, this.get_union_type(members))
        }
        if k = KindParameter
        {
            let owner_opt AstNode.parent_node_of(node)
            if owner_opt = null
                return null
            let owner owner_opt as ref[AstNode]
            let ok AstNode.kind_of(owner)
            var eligible false
            if ok = KindConstructor
                set eligible: true
            if ok = KindMethodDeclaration
                set eligible: true
            if ok = KindSetAccessor
            {
                let grand AstNode.parent_node_of(owner)
                if grand <> null
                {
                    if Checker.is_class_like(grand as ref[AstNode])
                        set eligible: true
                }
            }
            if eligible = false
                return null
            let this_param Checker.get_this_parameter(owner)
            if this_param <> null
            {
                if (this_param as ref[AstNode]) = node
                    return null
            }
            let ps AstNode.parameters_of(owner)
            if ps = null
                return null
            let pl ps as ref[Array[ref[AstNode]?]]
            var index 0 - 1
            var pi 0
            while pi < (pl.get_length() as int)
            {
                let pp pl[pi as size_t]
                if pp <> null
                {
                    if (pp as ref[AstNode]) = node
                        set index: pi
                }
                set pi: pi + 1
            }
            if index < 0
                return null
            if this_param <> null
                set index: index - 1
            var target_type: ref[Type]? null
            var key_type: ref[Type]? null
            if ok = KindConstructor
            {
                let cls AstNode.parent_node_of(owner)
                let csym this.get_symbol_of_declaration(cls)
                if csym = null
                    return null
                set target_type: this.get_type_of_symbol(csym as ref[Symbol])
                set key_type: undefined_type
            }
            else
            {
                set target_type: this.get_parent_type_of_class_element(owner)
                set key_type: this.get_class_element_property_key_type(owner)
            }
            let index_type this.get_number_literal_type(Checker.number_bits_from_int(index))
            let params &Array[ref[Symbol]?]^host()
            params.add(this.new_parameter("target", target_type))
            params.add(this.new_parameter("propertyKey", key_type))
            params.add(this.new_parameter("parameterIndex", index_type))
            return this.new_call_signature(null, null, params, void_type)
        }
        var member_like false
        if (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindPropertyDeclaration)
            set member_like: true
        if member_like = false
            return null
        let holder AstNode.parent_node_of(node)
        if holder = null
            return null
        if Checker.is_class_like(holder as ref[AstNode]) = false
            return null
        let target_type this.get_parent_type_of_class_element(node)
        let key_type this.get_class_element_property_key_type(node)
        var return_type: ref[Type]? void_type
        if k <> KindPropertyDeclaration
            set return_type: this.new_typed_property_descriptor_type(this.get_type_of_node(node))
        var has_prop_desc k <> KindPropertyDeclaration
        if has_prop_desc = false
            set has_prop_desc: this.binder_of_node(node).has_syntactic_modifier(node, ModifierFlagsAccessor)
        let params &Array[ref[Symbol]?]^host()
        params.add(this.new_parameter("target", target_type))
        params.add(this.new_parameter("propertyKey", key_type))
        if has_prop_desc
            params.add(this.new_parameter("descriptor", this.new_typed_property_descriptor_type(this.get_type_of_node(node))))
        let members &Array[ref[Type]?]^host()
        members.add(return_type)
        members.add(void_type)
        this.new_call_signature(null, null, params, this.get_union_type(members))
    }

    ; getESDecoratorCallSignature. The reference's 80-line comment above it
    ; describes decorator APPLICATION ORDER and the "current / input / output /
    ; final" vocabulary it uses to name the type arguments; it is not transcribed
    ; because none of it is a rule this port applies — what the function does is
    ; pick a context type per member kind and wrap the value type.
    ;
    ; ★★ THE `anySignature` MARKER IS THE MEMO'S THIRD STATE. It is written into
    ; the slot BEFORE the switch and every arm that declines leaves it, so a member
    ; the reference builds no signature for is *asked and answered nothing* rather
    ; than *not asked* — see SignatureLink.decorator_signature.
    ; ★★★ THE MEMO IS DISARMED ON A STOP, WHICH IS WHY THIS IS TWO FUNCTIONS. The
    ; slot is written to `anySignature` before the switch, so a stop anywhere inside
    ; would leave it ARMED and the SECOND ask would translate that marker back to
    ; *no signature* without moving the mark — a wrong answer that costs no report.
    ; The worker's fifteen early exits therefore all mean *the mark moved*, and one
    ; guard here reads it, which is `signature_stopped`'s job one slot up done with a
    ; wrapper instead of a bit.
    procedure get_es_decorator_call_signature(this, decorator: ref[AstNode]) returns ref[Signature]?
    {
        let parent AstNode.parent_node_of(decorator)
        if parent = null
            return null
        let node parent as ref[AstNode]
        let links this.signature_link_of(node)
        let outer_mark this.unported_mark()
        let result this.get_es_decorator_call_signature_worker(decorator, node, links)
        if this.unported_mark() <> outer_mark
        {
            set links.decorator_signature: null
            return null
        }
        result
    }

    procedure get_es_decorator_call_signature_worker(this, decorator: ref[AstNode], node: ref[AstNode], links: ref[SignatureLink]) returns ref[Signature]?
    {
        if links.decorator_signature = null
        {
            let mark this.unported_mark()
            set links.decorator_signature: any_signature
            let k AstNode.kind_of(node)
            var is_class false
            if k = KindClassDeclaration
                set is_class: true
            if k = KindClassExpression
                set is_class: true
            if is_class
            {
                ; "Class decorators have a `context` of
                ; `ClassDecoratorContext<Class>`, where the `Class` type argument
                ; will be the final type of the class after all decorators are
                ; applied."
                let sym this.get_symbol_of_declaration(node)
                if this.unported_mark() <> mark
                    return null
                if sym = null
                    return null
                let target_type this.get_type_of_symbol(sym as ref[Symbol])
                if this.unported_mark() <> mark
                    return null
                let context_type this.new_class_decorator_context_type(target_type)
                if this.unported_mark() <> mark
                    return null
                set links.decorator_signature: this.new_es_decorator_call_signature(target_type, context_type, target_type)
            }
            else
            {
                var is_method_like false
                if k = KindMethodDeclaration
                    set is_method_like: true
                if Checker.is_accessor_kind(k)
                    set is_method_like: true
                if is_method_like
                {
                    if Checker.kind_is_class_like(Checker.kind_or_unknown(AstNode.parent_node_of(node)))
                    {
                        var value_type: ref[Type]? null
                        if k = KindMethodDeclaration
                        {
                            let sig this.get_signature_from_declaration(node)
                            if this.unported_mark() <> mark
                                return null
                            if sig = null
                                return null
                            set value_type: this.get_or_create_type_from_signature(sig as ref[Signature])
                        }
                        else
                            set value_type: this.get_type_of_node(node)
                        if this.unported_mark() <> mark
                            return null
                        let this_type this.decorator_this_type(node)
                        if this.unported_mark() <> mark
                            return null
                        ; "We wrap the input type, if necessary, to match the
                        ; decoration target. For getters this is something like
                        ; `() => inputType`, for setters `(value: inputType) =>
                        ; void` and for methods it is just the input type."
                        var target_type: ref[Type]? value_type
                        if k = KindGetAccessor
                            set target_type: this.new_getter_function_type(value_type)
                        if k = KindSetAccessor
                            set target_type: this.new_setter_function_type(value_type)
                        if this.unported_mark() <> mark
                            return null
                        let context_type this.new_class_member_decorator_context_type_for_node(node, this_type, value_type)
                        if this.unported_mark() <> mark
                            return null
                        set links.decorator_signature: this.new_es_decorator_call_signature(target_type, context_type, target_type)
                    }
                }
                if k = KindPropertyDeclaration
                {
                    if Checker.kind_is_class_like(Checker.kind_or_unknown(AstNode.parent_node_of(node)))
                    {
                        let value_type this.get_type_of_node(node)
                        if this.unported_mark() <> mark
                            return null
                        let this_type this.decorator_this_type(node)
                        if this.unported_mark() <> mark
                            return null
                        let is_auto_accessor b.has_syntactic_modifier(node, ModifierFlagsAccessor)
                        ; "The target of an auto-accessor decorator is a
                        ; `{ get, set }` object; the target of a regular field
                        ; decorator is always `undefined` as it isn't installed
                        ; until it is initialized."
                        var target_type: ref[Type]? undefined_type
                        if is_auto_accessor
                            set target_type: this.new_class_accessor_decorator_target_type(this_type, value_type)
                        ; "For auto-accessors we wrap the output type in a
                        ; `ClassAccessorDecoratorResult<This, In, Out>`; for
                        ; regular fields we wrap it in an initializer mutator."
                        var return_type: ref[Type]? null
                        if is_auto_accessor
                            set return_type: this.new_class_accessor_decorator_result_type(this_type, value_type)
                        else
                            set return_type: this.new_class_field_decorator_initializer_mutator_type(this_type, value_type)
                        if this.unported_mark() <> mark
                            return null
                        let context_type this.new_class_member_decorator_context_type_for_node(node, this_type, value_type)
                        if this.unported_mark() <> mark
                            return null
                        set links.decorator_signature: this.new_es_decorator_call_signature(target_type, context_type, return_type)
                    }
                }
            }
        }
        let sig links.decorator_signature
        if sig = null
            return null
        if (sig as ref[Signature]) = any_signature
            return null
        sig
    }

    ; The `This` type argument of a member decorator's context: the STATIC side
    ; for a static member, the DECLARED (instance) type otherwise. It is the same
    ; two lines in both member arms upstream and is lifted here for that reason.
    procedure decorator_this_type(this, node: ref[AstNode]) returns ref[Type]?
    {
        let parent AstNode.parent_node_of(node)
        if parent = null
            return null
        let sym this.get_symbol_of_declaration(parent as ref[AstNode])
        if sym = null
            return null
        if b.has_syntactic_modifier(node, ModifierFlagsStatic)
            return this.get_type_of_symbol(sym as ref[Symbol])
        this.get_declared_type_of_class_or_interface(sym as ref[Symbol])
    }

    ; newESDecoratorCallSignature — "creates a call signature for an ES decorator".
    procedure new_es_decorator_call_signature(this, target_type: ref[Type]?, context_type: ref[Type]?, non_optional_return_type: ref[Type]?) returns ref[Signature]?
    {
        let target_param this.new_parameter("target", target_type)
        let context_param this.new_parameter("context", context_type)
        let alt &Array[ref[Type]?]()
        alt.add(non_optional_return_type)
        alt.add(void_type)
        let mark this.unported_mark()
        let return_type this.get_union_type(alt)
        if this.unported_mark() <> mark
            return null
        let params this.new_symbol_list()
        params.add(target_param)
        params.add(context_param)
        this.new_call_signature(null, null, params, return_type)
    }

    procedure get_decorator_call_signature(this, decorator: ref[AstNode]) returns ref[Signature]?
    {
        if legacy_decorators
            return this.get_legacy_decorator_call_signature(decorator)
        this.get_es_decorator_call_signature(decorator)
    }

    ; getEffectiveDecoratorArguments — one SYNTHETIC expression per parameter of
    ; the decorator's own call signature, each carrying that parameter's type.
    ;
    ; ★★★ THE ARGUMENTS HAVE NO SOURCE TEXT AND THAT IS THE POINT: a decorator is
    ; written `@d`, the call `d(target, context)` exists only in the emitted code,
    ; so the arguments the checker compares against the decorator's parameters have
    ; to be manufactured from the CONTEXT rather than read off the tree. Every one
    ; of them carries the decorator EXPRESSION's range, which is where a report
    ; about the wrong `target` type lands.
    ;
    ; ★ `panic("Decorator signature not found")` is a row rather than a trap, for
    ; the reason every other reference assertion in this file is.
    procedure get_effective_decorator_arguments(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let expr AstNode.expression_of(node)
        if expr = null
            return null
        let mark this.unported_mark()
        let signature this.get_decorator_call_signature(node)
        if this.unported_mark() <> mark
            return null
        if signature = null
        {
            this.record_unported("decorator-signature-not-found", AstNode.kind_of(node))
            return null
        }
        let sig signature as ref[Signature]
        let args AstNode.new_node_list(host)
        if sig.parameters = null
            return args
        let params sig.parameters as ref[Array[ref[Symbol]?]]
        let n params.get_length() as int
        var i 0
        while i < n
        {
            let row params[i]
            if row = null
                return null
            let t this.get_type_of_symbol(row as ref[Symbol])
            if this.unported_mark() <> mark
                return null
            args.add(this.new_synthetic_expression(expr as ref[AstNode], t, false, null))
            set i: i + 1
        }
        args
    }

    ; getDecoratorArgumentCount. ★The ES arm is `min(max(parameterCount, 1), 2)`:
    ; a decorator is CALLED with two arguments, and a decorator that declares fewer
    ; is checked against what it declares rather than against the call.
    procedure get_decorator_argument_count(this, node: ref[AstNode], signature: ref[Signature]) returns int
    {
        if legacy_decorators
            return this.get_legacy_decorator_argument_count(node, signature)
        var n this.get_parameter_count(signature)
        if n < 1
            set n: 1
        if n > 2
            set n: 2
        n
    }

    ; getLegacyDecoratorArgumentCount (slice 248)
    procedure get_legacy_decorator_argument_count(this, node: ref[AstNode], signature: ref[Signature]) returns int
    {
        let parent AstNode.parent_node_of(node)
        let k Checker.kind_or_unknown(parent)
        if (k = KindClassDeclaration) or (k = KindClassExpression)
            return 1
        if k = KindPropertyDeclaration
        {
            if this.binder_of_node(parent).has_syntactic_modifier(parent as ref[AstNode], ModifierFlagsAccessor)
                return 3
            return 2
        }
        if (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
        {
            var n 0
            if signature.parameters <> null
                set n: (signature.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
            if n <= 2
                return 2
            return 3
        }
        if k = KindParameter
            return 3
        this.record_unported("legacy-decorator-argument-count", k)
        0
    }

    ; isPotentiallyUncalledDecorator — "sometimes we have a decorator that could
    ; accept zero arguments but is receiving too many as part of the decorator
    ; invocation; in those cases a user may have meant to CALL the expression
    ; before using it as a decorator".
    ; ★ The list is NULLABLE for resolve_decorator's recorded reason: `null` from
    ; get_signatures_of_type means EMPTY, and `core.Every` over an empty list is
    ; true, which is exactly why the reference guards on `len(signatures) != 0`
    ; first.
    procedure is_potentially_uncalled_decorator(this, decorator: ref[AstNode], signatures: ref[Array[ref[Signature]?]]?) returns bool
    {
        let mark this.unported_mark()
        if signatures = null
            return false
        let list signatures as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        if n = 0
            return false
        var i 0
        while i < n
        {
            let row list[i]
            if row = null
                return false
            let sig row as ref[Signature]
            if sig.min_argument_count <> 0
                return false
            if Checker.signature_has_rest_parameter(sig)
                return false
            var count 0
            if sig.parameters <> null
                set count: (sig.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
            let wanted this.get_decorator_argument_count(decorator, sig)
            if this.unported_mark() <> mark
                return false
            if count >= wanted
                return false
            set i: i + 1
        }
        true
    }

    ; getDiagnosticHeadMessageForDecoratorResolution — the four TS1238..TS1241.
    procedure get_diagnostic_head_message_for_decorator_resolution(this, node: ref[AstNode]) returns int
    {
        let k Checker.kind_or_unknown(AstNode.parent_node_of(node))
        if k = KindClassDeclaration
            return DiagUnable_to_resolve_signature_of_class_decorator_when_called_as_an_expression
        if k = KindClassExpression
            return DiagUnable_to_resolve_signature_of_class_decorator_when_called_as_an_expression
        if k = KindParameter
            return DiagUnable_to_resolve_signature_of_parameter_decorator_when_called_as_an_expression
        if k = KindPropertyDeclaration
            return DiagUnable_to_resolve_signature_of_property_decorator_when_called_as_an_expression
        if k = KindMethodDeclaration
            return DiagUnable_to_resolve_signature_of_method_decorator_when_called_as_an_expression
        if Checker.is_accessor_kind(k)
            return DiagUnable_to_resolve_signature_of_method_decorator_when_called_as_an_expression
        ; `panic("Unhandled case in getDiagnosticHeadMessageForDecoratorResolution")`.
        this.record_unported("decorator-resolution-head-message", k)
        0
    }

    ; resolveDecorator.
    ;
    ; ★★★ THE ZERO-SIGNATURE REPORT IS A CHAIN UPSTREAM AND ONE LINE HERE, and the
    ; two agree on what the yardstick sees. `NewDiagnosticChain(details, head)`
    ; takes the CHAIN's location and the HEAD's code, the details' location is
    ; `errorTarget` — the decorator's expression, whose parent is the Decorator and
    ; therefore not a CallExpression, so neither invocationErrorDetails' property-
    ; access rewrite nor its get-accessor head can fire — and the dump is
    ; `C pos end code`. So the honest transcription is: report the decorator head's
    ; code at the expression. invocationErrorRecovery is not written, for
    ; invocation_error's own recorded reason.
    procedure resolve_decorator(this, node: ref[AstNode], check_mode: int) returns ref[Signature]?
    {
        let mark this.unported_mark()
        if AstNode.can_have_decorators(AstNode.parent_node_of(node)) = false
            return this.resolve_error_call(node)
        let expr AstNode.expression_of(node)
        if expr = null
            return null
        let e expr as ref[AstNode]
        let func_type this.check_expression(e)
        if this.unported_mark() <> mark
            return null
        if func_type = null
            return null
        let apparent this.get_apparent_type(func_type as ref[Type])
        if this.unported_mark() <> mark
            return null
        if apparent = null
            return null
        let at apparent as ref[Type]
        if this.is_error_type(at)
            return this.resolve_error_call(node)
        ; ★★★ `get_signatures_of_type` ANSWERS NULL FOR *NO SIGNATURES*, NOT FOR
        ; *I STOPPED*, and reading it the other way is what this slice got wrong
        ; first: `dec` declared `any` is not a structured type, so
        ; get_signatures_of_structured_type returns null at its first line — and a
        ; `return null` here made resolve_signature answer null with NOTHING on the
        ; stop log, which get_resolved_signature then latched as
        ; `signature_stopped: true`. Every later ask replayed a stop that was never
        ; recorded, so the enclosing PropertyAssignment's type came out null while
        ; the unit reported nothing: `({ C: @dec class {} })` lost two `T` lines and
        ; read as a FAIL rather than as an unported unit. The mark is the only thing
        ; that says *stopped*; a null from this function is an EMPTY LIST, which is
        ; how every other caller in the file reads it (`if x <> null set count: …`).
        let call_signatures this.get_signatures_of_type(at, SignatureKindCall)
        if this.unported_mark() <> mark
            return null
        var num_call 0
        if call_signatures <> null
            set num_call: (call_signatures as ref[Array[ref[Signature]?]]).get_length() as int
        let construct_signatures this.get_signatures_of_type(at, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return null
        var num_construct 0
        if construct_signatures <> null
            set num_construct: (construct_signatures as ref[Array[ref[Signature]?]]).get_length() as int
        if this.is_untyped_function_call(func_type as ref[Type], at, num_call, num_construct)
            return this.resolve_untyped_call(node)
        if this.is_potentially_uncalled_decorator(node, call_signatures)
        {
            if this.unported_mark() <> mark
                return null
            if Checker.kind_or_unknown(e) <> KindParenthesizedExpression
            {
                this.error_on_node(node, DiagX_0_accepts_too_few_arguments_to_be_used_as_a_decorator_here_Did_you_mean_to_call_it_first_and_write_0, this.node_text_arg(e))
                return this.resolve_error_call(node)
            }
        }
        if this.unported_mark() <> mark
            return null
        let head this.get_diagnostic_head_message_for_decorator_resolution(node)
        if this.unported_mark() <> mark
            return null
        if num_call = 0
        {
            this.error_on_node(e, head)
            return this.resolve_error_call(node)
        }
        let decorator_signature this.get_decorator_call_signature(node)
        if this.unported_mark() <> mark
            return null
        if decorator_signature = null
            return this.resolve_error_call(node)
        this.resolve_call(node, call_signatures, check_mode, SignatureFlagsNone, head)
    }

    ; checkDecorator.
    ;
    ; ★ The `returnType.flags & Any` early exit is what keeps the ordinary
    ; `declare function d(...args: any[]): any` decorator silent: an `any` return
    ; is assignable to anything, so the comparison below would say nothing anyway.
    procedure check_decorator(this, node: ref[AstNode])
    {
        let mark this.unported_mark()
        this.check_grammar_decorator(node)
        let signature this.get_resolved_signature(node, CheckModeNormal)
        if this.unported_mark() <> mark
            return
        if signature = null
            return
        let sig signature as ref[Signature]
        this.check_deprecated_signature(sig, node)
        if this.unported_mark() <> mark
            return
        let return_type this.get_return_type_of_signature(sig)
        if this.unported_mark() <> mark
            return
        if return_type = null
            return
        let rt return_type as ref[Type]
        if (rt.flags & TypeFlagsAny) <> 0
            return
        ; "If we fail to get a signature and return type here, we will have
        ; already reported a grammar error in checkDecorators."
        let decorator_signature this.get_decorator_call_signature(node)
        if this.unported_mark() <> mark
            return
        if decorator_signature = null
            return
        let ds decorator_signature as ref[Signature]
        if ds.resolved_return_type = null
            return
        let expected ds.resolved_return_type as ref[Type]
        let k Checker.kind_or_unknown(AstNode.parent_node_of(node))
        var head 0
        if k = KindClassDeclaration
            set head: DiagDecorator_function_return_type_0_is_not_assignable_to_type_1
        if k = KindClassExpression
            set head: DiagDecorator_function_return_type_0_is_not_assignable_to_type_1
        if k = KindMethodDeclaration
            set head: DiagDecorator_function_return_type_0_is_not_assignable_to_type_1
        if Checker.is_accessor_kind(k)
            set head: DiagDecorator_function_return_type_0_is_not_assignable_to_type_1
        if k = KindParameter
            set head: DiagDecorator_function_return_type_is_0_but_is_expected_to_be_void_or_any
        ; "case KindPropertyDeclaration: if !legacyDecorators { … break }
        ; fallthrough" — a property decorator gets the assignability message under
        ; ES decorators and the void-or-any one under the legacy ones, which is the
        ; only place in this switch where the option changes a MESSAGE.
        if k = KindPropertyDeclaration
        {
            set head: DiagDecorator_function_return_type_0_is_not_assignable_to_type_1
            if legacy_decorators
                set head: DiagDecorator_function_return_type_is_0_but_is_expected_to_be_void_or_any
        }
        if head = 0
        {
            ; `panic("Unhandled case in checkDecorator")`.
            this.record_unported("check-decorator-unhandled", k)
            return
        }
        let expr AstNode.expression_of(node)
        this.check_type_assignable_to(rt, expected, expr, head)
    }

    ; checkGrammarPrivateIdentifierExpression, whole — upstream's grammarchecks.go.
    ;
    ; ★★★ THE THREE REPORTS ARE A CHAIN AND THE FOR-IN GUARD SUPPRESSES THE LAST
    ; TWO, NOT THE FIRST. `for (#x in obj)` is a parse-level shape the reference
    ; lets through here on purpose — the left operand of a for-in is not an
    ; expression node, so without the guard EVERY such head would report TS1451 —
    ; while a private name outside any class body is illegal wherever it stands.
    ;
    ; ★★ TS2304 IS REPORTED ONLY WHERE THE `in` OPERATION IS NOT, and that is not
    ; the same test as is_expression_node's: that arm has already established the
    ; node IS the left operand of an `in`, so `isInOperation` can only be true on
    ; a node that passed the line above. It is transcribed as the reference has it
    ; rather than folded away, because the two conditions are separated by a
    ; report and folding them would move the TS1451.
    procedure check_grammar_private_identifier_expression(this, priv_id: ref[AstNode]) returns bool
    {
        if Checker.get_containing_class(priv_id) = null
            return this.grammar_error_on_node(priv_id, DiagPrivate_identifiers_are_not_allowed_outside_class_bodies)
        let parent AstNode.parent_node_of(priv_id)
        var in_for_in false
        if parent <> null
        {
            if AstNode.kind_of(parent as ref[AstNode]) = KindForInStatement
                set in_for_in: true
        }
        if in_for_in
            return false
        if AstNode.is_expression_node(priv_id) = false
            return this.grammar_error_on_node(priv_id, DiagPrivate_identifiers_are_only_allowed_in_class_bodies_and_may_only_be_used_as_part_of_a_class_member_declaration_property_access_or_on_the_left_hand_side_of_an_in_expression)
        var is_in_operation false
        if parent <> null
        {
            let p parent as ref[AstNode]
            if AstNode.kind_of(p) = KindBinaryExpression
            {
                let op AstNode.binary_operator_token_of(p)
                if op <> null
                {
                    if AstNode.kind_of(op as ref[AstNode]) = KindInKeyword
                        set is_in_operation: true
                }
            }
        }
        if is_in_operation
            return false
        let mark this.unported_mark()
        let sym this.get_symbol_for_private_identifier_expression(priv_id)
        if this.unported_mark() <> mark
            return false
        if sym = null
            return this.grammar_error_on_node(priv_id, DiagCannot_find_name_0, Checker.arg_text(AstNode.identifier_text_of(priv_id)))
        false
    }

    ; checkGrammarDecorator, whole.
    ;
    ; ★★★ THE LOOP IS A DESCENT AND `canHaveCallExpression` IS ITS ONE PIECE OF
    ; STATE: `@a.b.c()` is legal, `@a().b` is not, because a call may appear only
    ; at the OUTERMOST position of a decorator's expression. The flag is cleared by
    ; the first call or member hop and read by the next call, which is the whole
    ; grammar.
    ;
    ; ★★ THE RELATED INFO IS DROPPED AND THE DIAGNOSTIC IS NOT — the same reading
    ; check_grammar_for_use_strict_simple_parameter_list' header makes.
    ; `err.AddRelatedInfo(createDiagnosticForNode(errorNode, Invalid_syntax_in_decorator))`
    ; puts TS1498 ON the TS1497 rather than in the list, so no dump reaches it. The
    ; error node is therefore computed and used only as a FLAG here, and the report
    ; lands on the decorator's expression exactly as upstream's does.
    procedure check_grammar_decorator(this, decorator: ref[AstNode]) returns bool
    {
        if this.has_parse_diagnostics_of(decorator)
            return false
        let expression AstNode.expression_of(decorator)
        if expression = null
            return false
        var node expression as ref[AstNode]
        ; "DecoratorParenthesizedExpression : `(` Expression `)`"
        if AstNode.kind_of(node) = KindParenthesizedExpression
            return false
        var can_have_call_expression true
        var has_error false
        var error_node: ref[AstNode]? null
        repeat
        {
            let k AstNode.kind_of(node)
            ; "Allow TS syntax such as non-null assertions and instantiation
            ; expressions."
            var unwrap false
            if k = KindExpressionWithTypeArguments
                set unwrap: true
            if k = KindNonNullExpression
                set unwrap: true
            if unwrap
            {
                let inner AstNode.expression_of(node)
                if inner = null
                    return false
                set node: inner as ref[AstNode]
                continue
            }
            ; "DecoratorCallExpression : DecoratorMemberExpression Arguments"
            if k = KindCallExpression
            {
                if can_have_call_expression = false
                {
                    set has_error: true
                    set error_node: node
                }
                if AstNode.question_dot_token_of(node) <> null
                {
                    set has_error: true
                    set error_node: AstNode.question_dot_token_of(node)
                }
                let callee AstNode.expression_of(node)
                if callee = null
                    return false
                set node: callee as ref[AstNode]
                set can_have_call_expression: false
                continue
            }
            ; "DecoratorMemberExpression : IdentifierReference |
            ; DecoratorMemberExpression `.` IdentifierName |
            ; DecoratorMemberExpression `.` PrivateIdentifier"
            if k = KindPropertyAccessExpression
            {
                if AstNode.question_dot_token_of(node) <> null
                {
                    set has_error: true
                    set error_node: AstNode.question_dot_token_of(node)
                }
                let receiver AstNode.expression_of(node)
                if receiver = null
                    return false
                set node: receiver as ref[AstNode]
                set can_have_call_expression: false
                continue
            }
            if k <> KindIdentifier
            {
                set has_error: true
                set error_node: node
            }
            break
        }
        if has_error = false
            return false
        let decorator_mark this.diagnostic_mark()
        this.error_on_node(expression, DiagExpression_must_be_enclosed_in_parentheses_to_be_used_as_a_decorator)
        this.related_info_since(decorator_mark, error_node, DiagInvalid_syntax_in_decorator)
        true
    }

    ; markDecoratorAliasReferenced — markLinkedReferences' DECORATOR arm.
    ;
    ; ★★ A PROVABLE NO-OP UNDER THIS HARNESS AND WRITTEN AS ITS OWN FIRST LINE:
    ; `EmitDecoratorMetadata.IsFalseOrUnknown()` is TRUE for an unset option, so
    ; the serialized-metadata walk below it — a checkExternalEmitHelpers call, the
    ; constructor/accessor/method/property/parameter type nodes and
    ; markEntityNameOrEntityExpressionAsReference — is unreachable. It is a
    ; procedure rather than a line in mark_linked_references so that the day an
    ; options record arrives, this is the one body that fills.
    ; markDecoratorAliasReferenced (slice 248): under emitDecoratorMetadata the
    ; type names a decorated member's signature carries are VALUE references —
    ; the alias they resolve through must survive import elision.
    ; ★checkExternalEmitHelpers(Metadata) is a diagnostic about tslib and is not
    ; ported here.
    procedure mark_decorator_alias_referenced(this, node: ref[AstNode])
    {
        if emit_decorator_metadata = false
            return
        let mods AstNode.modifiers_of(node)
        if mods = null
            return
        let ml mods as ref[Array[ref[AstNode]?]]
        var first_decorator: ref[AstNode]? null
        var mi 0
        while mi < (ml.get_length() as int)
        {
            let m ml[mi as size_t]
            set mi: mi + 1
            if (first_decorator = null) and AstNode.is_decorator(m)
                set first_decorator: m
        }
        if first_decorator = null
            return
        this.check_external_emit_helpers(first_decorator as ref[AstNode], ExternalEmitHelpersMetadata)
        let k AstNode.kind_of(node)
        if k = KindClassDeclaration
        {
            let ctor Checker.first_constructor_with_body(node)
            if ctor <> null
                this.mark_decorator_metadata_parameters_as_referenced(AstNode.parameters_of(ctor))
            return
        }
        if (k = KindGetAccessor) or (k = KindSetAccessor)
        {
            var other_kind KindSetAccessor
            if k = KindSetAccessor
                set other_kind: KindGetAccessor
            var annotation this.get_annotated_accessor_type_node(node)
            if annotation = null
            {
                let sym this.get_symbol_of_declaration(node)
                if sym <> null
                {
                    let other Checker.get_declaration_of_kind(sym as ref[Symbol], other_kind)
                    if other <> null
                        set annotation: this.get_annotated_accessor_type_node(other)
                }
            }
            this.mark_decorator_metadata_type_node_as_referenced(annotation)
            return
        }
        if k = KindMethodDeclaration
        {
            this.mark_decorator_metadata_parameters_as_referenced(AstNode.parameters_of(node))
            this.mark_decorator_metadata_type_node_as_referenced(AstNode.type_of(node))
            return
        }
        if k = KindPropertyDeclaration
        {
            this.mark_decorator_metadata_type_node_as_referenced(AstNode.type_of(node))
            return
        }
        if k = KindParameter
        {
            this.mark_decorator_metadata_type_node_as_referenced(this.get_parameter_type_node_for_decorator_check(node))
            ; the containing signature's parameters and return type (its
            ; `design:paramtypes`/`design:returntype` are emitted for a parameter decorator)
            let containing AstNode.parent_node_of(node)
            if containing <> null
            {
                this.mark_decorator_metadata_parameters_as_referenced(AstNode.parameters_of(containing))
                this.mark_decorator_metadata_type_node_as_referenced(AstNode.type_of(containing))
            }
        }
    }

    procedure mark_decorator_metadata_parameters_as_referenced(this, params: ref[Array[ref[AstNode]?]]?)
    {
        if params = null
            return
        let pl params as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (pl.get_length() as int)
        {
            let prm pl[i as size_t]
            set i: i + 1
            if prm <> null
                this.mark_decorator_metadata_type_node_as_referenced(this.get_parameter_type_node_for_decorator_check(prm as ref[AstNode]))
        }
    }

    ; `core.Find(node.ModifierNodes(), m => m.Kind == kind)`
    function modifier_of_kind(node: ref[AstNode], kind: int) returns ref[AstNode]?
    {
        let mods AstNode.modifiers_of(node)
        if mods = null
            return null
        let ml mods as ref[Array[ref[AstNode]?]]
        var mi 0
        while mi < (ml.get_length() as int)
        {
            let m ml[mi as size_t]
            set mi: mi + 1
            if Checker.kind_or_unknown(m) = kind
                return m
        }
        null
    }

    ; `core.Find(node.ModifierNodes(), ast.IsDecorator)`
    function first_decorator_of(node: ref[AstNode]) returns ref[AstNode]?
    {
        let mods AstNode.modifiers_of(node)
        if mods = null
            return null
        let ml mods as ref[Array[ref[AstNode]?]]
        var mi 0
        while mi < (ml.get_length() as int)
        {
            let m ml[mi as size_t]
            set mi: mi + 1
            if AstNode.is_decorator(m)
                return m
        }
        null
    }

    ; `core.Some(node.Members(), HasStaticModifier && IsPrivateIdentifierClassElementDeclaration)`
    function some_member_is_static_private(bd: ref[Binder], node: ref[AstNode]) returns bool
    {
        let members AstNode.member_list_of(node)
        if members = null
            return false
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if m <> null
            {
                if bd.is_static(m) and AstNode.is_private_identifier_class_element_declaration(m)
                    return true
            }
        }
        false
    }

    ; ast.GetFirstConstructorWithBody
    function first_constructor_with_body(node: ref[AstNode]) returns ref[AstNode]?
    {
        let members AstNode.member_list_of(node)
        if members = null
            return null
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if AstNode.kind_of(m) = KindConstructor
            {
                let body AstNode.body_of(m as ref[AstNode])
                if body <> null
                {
                    if Parser.node_is_missing(body) = false
                        return m
                }
            }
        }
        null
    }

    ; getParameterTypeNodeForDecoratorCheck: a rest parameter's element type
    function get_parameter_type_node_for_decorator_check(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let t AstNode.type_of(node)
        if AstNode.dot_dot_dot_token_of(node) <> null
            return Checker.rest_parameter_element_type(t)
        t
    }

    ; ast.GetRestParameterElementType
    function rest_parameter_element_type(node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        let n node as ref[AstNode]
        if n.kind = KindArrayType
            return AstNode.array_element_type_of(n)
        if n.kind = KindTypeReference
        {
            let args AstNode.type_reference_arguments_of(n)
            if args <> null
            {
                let a args as ref[Array[ref[AstNode]?]]
                if a.get_length() > 0
                    return a[0]
            }
        }
        null
    }

    ; markDecoratorMedataDataTypeNodeAsReferenced
    procedure mark_decorator_metadata_type_node_as_referenced(this, node: ref[AstNode]?)
    {
        let entity_name this.get_entity_name_for_decorator_metadata(node)
        if entity_name = null
            return
        if Checker.is_entity_name(entity_name)
            this.mark_entity_name_or_entity_expression_as_reference(entity_name, true)
    }

    ; getEntityNameForDecoratorMetadata
    function get_entity_name_for_decorator_metadata(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        let k AstNode.kind_of(node)
        if (k = KindIntersectionType) or (k = KindUnionType)
            return this.get_entity_name_for_decorator_metadata_from_type_list(AstNode.type_list_of(node as ref[AstNode]))
        if k = KindConditionalType
        {
            let pair &Array[ref[AstNode]?]^host()
            pair.add(AstNode.conditional_true_type_of(node))
            pair.add(AstNode.conditional_false_type_of(node))
            return this.get_entity_name_for_decorator_metadata_from_type_list(pair)
        }
        if (k = KindParenthesizedType) or (k = KindNamedTupleMember)
            return this.get_entity_name_for_decorator_metadata(AstNode.type_of(node))
        if k = KindTypeReference
            return AstNode.type_reference_name_of(node)
        null
    }

    ; getEntityNameForDecoratorMetadataFromTypeList: one common identifier, `never`
    ; skipped, `null`/`undefined` skipped without strictNullChecks
    function get_entity_name_for_decorator_metadata_from_type_list(this, type_nodes: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        if type_nodes = null
            return null
        let list type_nodes as ref[Array[ref[AstNode]?]]
        var common: ref[AstNode]? null
        var i 0
        while i < (list.get_length() as int)
        {
            let tn list[i as size_t]
            set i: i + 1
            if tn = null
                return null
            let t tn as ref[AstNode]
            let k AstNode.kind_of(t)
            if k = KindNeverKeyword
                continue
            if Checker.strict_null_checks() = false
            {
                var elide false
                if k = KindUndefinedKeyword
                    set elide: true
                if k = KindLiteralType
                {
                    if Checker.kind_or_unknown(AstNode.literal_type_inner_of(t)) = KindNullKeyword
                        set elide: true
                }
                if elide
                    continue
            }
            let individual this.get_entity_name_for_decorator_metadata(t)
            if individual = null
                return null
            if common = null
                set common: individual
            else
            {
                let c common as ref[AstNode]
                let ind individual as ref[AstNode]
                if (AstNode.kind_of(c) <> KindIdentifier) or (AstNode.kind_of(ind) <> KindIdentifier)
                    return null
                let ct AstNode.identifier_text_of(c)
                let it AstNode.identifier_text_of(ind)
                if ct.equals(it) = false
                    return null
            }
        }
        common
    }

    ; markEntityNameOrEntityExpressionAsReference
    procedure mark_entity_name_or_entity_expression_as_reference(this, type_name: ref[AstNode]?, for_decorator_metadata: bool)
    {
        if type_name = null
            return
        let root_opt Checker.get_first_identifier(type_name)
        if root_opt = null
            return
        let root_name root_opt as ref[AstNode]
        var meaning SymbolFlagsNamespace | SymbolFlagsAlias
        if AstNode.kind_of(type_name) = KindIdentifier
            set meaning: SymbolFlagsType | SymbolFlagsAlias
        let root_symbol this.resolve_name(root_name, AstNode.identifier_text_of(root_name), meaning, 0, true, false)
        if root_symbol = null
            return
        let rs root_symbol as ref[Symbol]
        if (Symbol.flags_of(rs) & SymbolFlagsAlias) = 0
            return
        var take false
        if this.symbol_is_value(rs)
        {
            if Checker.is_const_enum_or_const_enum_only_module(this.resolve_alias(rs)) = false
            {
                if this.get_type_only_alias_declaration(rs) = null
                    set take: true
            }
        }
        if take
            this.mark_alias_symbol_as_referenced(rs)
        if take = false
        {
            if for_decorator_metadata and this.get_isolated_modules() and (module_kind >= ModuleKindES2015) and (this.symbol_is_value(rs) = false) and (Checker.some_declaration_is_type_only_import_or_export(rs) = false)
            {
                let metadata_mark this.diagnostic_mark()
                this.error_on_node(type_name, DiagA_type_referenced_in_a_decorated_signature_must_be_imported_with_import_type_or_a_namespace_import_when_isolatedModules_and_emitDecoratorMetadata_are_enabled)
                var di 0
                while di < Symbol.declaration_count(rs)
                {
                    let decl Symbol.declaration_at(rs, di)
                    set di: di + 1
                    if decl = null
                        continue
                    if this.is_alias_symbol_declaration(decl as ref[AstNode])
                    {
                        this.related_info_since(metadata_mark, decl, DiagX_0_was_imported_here, Checker.arg_text(AstNode.identifier_text_of(root_name)))
                        break
                    }
                }
            }
        }
    }

    ; ast.FindAncestor(node, ast.IsTypeOnlyImportOrExportDeclaration)
    function find_ancestor_type_only_import_or_export(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var n node
        while n <> null
        {
            let nn n as ref[AstNode]
            if Checker.is_type_only_import_or_export_declaration(nn)
                return nn
            set n: AstNode.parent_node_of(nn)
        }
        null
    }

    ; core.Some(symbol.Declarations, ast.IsTypeOnlyImportOrExportDeclaration)
    function some_declaration_is_type_only_import_or_export(s: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(s)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(s, i)
            set i: i + 1
            if d <> null
            {
                if Checker.is_type_only_import_or_export_declaration(d as ref[AstNode])
                    return true
            }
        }
        false
    }

    ; ── slice 73: checkObjectTypeForDuplicateDeclarations ─────────────────────
    ;
    ; The statement slice 72's histogram named: `check-object-type-for-duplicate-
    ; declarations` was the head of the work list on BOTH stages (128 units at
    ; stage 1, 2 891 at stage 2), and it is one function plus the reporter under
    ; it. What it buys is the class's own duplicate-member family — TS2300 on a
    ; repeated property or on a property that collides with an accessor, TS2699 on
    ; a static member named `prototype`, and TS2804 on a private name used once
    ; statically and once on an instance.
    ;
    ; ★★★ THE THREE MAPS ARE THE FUNCTION, and each one is guarded differently,
    ; which is what makes them three rather than one keyed by a discriminator.
    ; `instanceNames` and `staticNames` hold a KIND (1 property, 2 accessor, 3
    ; already reported) and take an entry only for a symbol with more than one
    ; declaration; `privateNames` holds a BITSET (1 instance, 2 static, 3 both,
    ; reported on arrival) and takes an entry for every private-named member. Two
    ; different value alphabets over the same key type is exactly the same-layout
    ; merge §3.5n rejects. See DuplicateNameEntry for why the storage is a list.
    ;
    ; ★★ THE TWO STATIC QUESTIONS ARE NOT ONE QUESTION, and the reference asks
    ; both, three lines apart. `ast.HasStaticModifier` — the modifier alone — picks
    ; which of the two kind maps a member goes into; `ast.IsStatic` — a class
    ; ELEMENT with that modifier, OR a static block — decides the private name's
    ; bit and the reporter's `isStatic == ast.IsStatic(member)` filter. They differ
    ; on a `static` modifier the parser accepted somewhere that is not a class
    ; element, and folding them would be invisible until it did.
    ;
    ; ★★★ THE WALK OPENS A SECOND WORK-LIST ROW AND ONLY STAGE 2 HAS INPUT FOR IT:
    ; 109 units land on `get-late-bound-symbol`, zero at stage 1. A class member with
    ; a COMPUTED name carries the binder's internal name `__computed`, and
    ; symbol_of_declaration routes such a symbol through get_late_bound_symbol, which
    ; is a deliberate stop of another slice. **A work-list row is not a property of
    ; the function that reports it** — this walk is simply the first caller that ever
    ; asks a computed member for its symbol.
    ;
    ; ★ `checkPrivateNames` is a parameter rather than a constant because the
    ; reference's three call sites disagree: the class passes true, checkTypeLiteral
    ; and checkInterfaceDeclaration pass false. Only the class reaches here in this
    ; slice — the other two arms stop earlier, the interface at check-index-
    ; constraints inside its `interfaceChecked` block — so the false side has no
    ; input yet and the flag is written out rather than folded away.
    ; ── slice 77: the duplicate index signatures ─────────────────────────────
    ;
    ; ★★★ THE HEAD OF BOTH LISTS, AND THE ONLY ONE OF THE FOUR CALLS BEHIND IT THAT
    ; IS NOT A DIMENSION. `check-index-constraints` is 157 firsts and 235 units on
    ; the class arm plus 100 on the interface one, and it stands in front of a
    ; SEQUENCE: checkIndexConstraints twice, checkClassOrInterfaceForDuplicate
    ; IndexSignatures, checkPropertyInitialization. The first two need
    ; getIndexInfosOfType, i.e. resolveStructuredTypeMembers and the whole members
    ; dimension; the fourth needs the CONTROL-FLOW GRAPH (isPropertyInitializedIn
    ; Constructor builds a synthetic `this.p` reference and asks getFlowTypeOf
    ; ReferenceEx). The third needs neither, and it is what this slice ports.
    ;
    ; ★★ SO THE ROW IS SPLIT RATHER THAN CLOSED, and the split is the product: the
    ; stop stays where the reference's first call is, the walk carries on past it —
    ; record_unported does not abort, and checkVariableLikeDeclaration's tail has
    ; had that discipline since slice 70 — and TS2374 now reaches a class or an
    ; interface whose index signatures collide.
    ;
    ; getIndexSymbol, whole. The reference asks `getMembersOfSymbol(symbol)`, which
    ; forks to the LATE-BOUND resolution for a container carrying computed names;
    ; reading `symbol.Members` directly is EXACT for this question rather than an
    ; approximation, because a late-bound member is filed under its computed name
    ; and the entry asked for here is the binder's `%FEindex`, which no late binding
    ; can produce. ★The reference's own loop says the same thing from the other
    ; side: *"Do nothing for late-bound index signatures."*
    ; getIndexSymbol — `c.getMembersOfSymbol(symbol)[InternalSymbolNameIndex]`.
    ;
    ; ★★★ IT READS THE MEMBERS THROUGH THE LATE-BINDING DOOR AND NOT `symbol.Members`
    ; DIRECTLY, and until slice 129 this port read the raw table. That was invisible
    ; for as long as the door stopped: a member whose computed name types as `string`
    ; IMPLIES an index signature and lives in the LATE table, so `{ [k]: string }`
    ; answered `{}` instead of `{ [x: string]: string; }` — the wall's own shape
    ; (§3.5eb), one accessor away from the chapter that removed it.
    procedure get_index_symbol(this, symbol: ref[Symbol]) returns ref[Symbol]?
    {
        let members this.get_members_of_symbol(symbol)
        if members = null
            return null
        var nd Slice[char]()
        set nd: Binder.internal_name(host, "index")
        SymbolTable.get(members, nd)
    }

    ; checkClassOrInterfaceForDuplicateIndexSignatures, whole — the once-guard and
    ; nothing else.
    ;
    ; ★★★ THE ONCE-GUARD IS A LINKS BIT AND NOT A NODE-IDENTITY TEST, and the two are
    ; NOT interchangeable here. checkExportsOnMergedDeclarations' guard is
    ; `node == GetDeclarationOfKind(symbol, kind)` — first declaration OF THAT KIND —
    ; while this one is *run once per SYMBOL*, and a class merged with an interface
    ; reaches this function through two declarations of two different kinds. A node
    ; test would report twice there; the reference's bit reports once. The port has
    ; the table, so it transcribes the bit.
    procedure check_class_or_interface_for_duplicate_index_signatures(this, node: ref[AstNode])
    {
        let symbol this.symbol_of_declaration(node)
        if symbol = null
            return
        let links this.declared_type_link_of(symbol as ref[Symbol])
        if links.index_signatures_checked
            return
        set links.index_signatures_checked: true
        this.check_type_for_duplicate_index_signatures(node)
    }

    ; checkTypeForDuplicateIndexSignatures, whole.
    ;
    ; ★★★ THE REFERENCE GROUPS BY *TYPE, i.e. BY POINTER, AND THE PORT GROUPS BY
    ; `Type.id`, WHICH IS THE SAME QUESTION. Every type this port makes is interned
    ; through a constructor that draws a fresh id, so two ids are equal exactly when
    ; the reference's two pointers are — and an id is comparable where a `ref` is
    ; not. The grouping is a linear scan rather than a map because an index symbol
    ; with more than one declaration has two or three of them; upstream's map is a
    ; map because Go has one.
    ;
    ; ★★ THE ITERATION ORDER OF THAT MAP IS RANDOMISED IN GO AND IT DOES NOT MATTER,
    ; which is worth stating rather than discovering: the diagnostics are sorted by
    ; POSITION before either side prints them (DiagnosticList.sort_by_position,
    ; slice 48), so the report order this loop produces is unobservable.
    ;
    ; ★★★ A TYPE THIS PORT CANNOT MAKE ABANDONS THE FUNCTION RATHER THAN SKIPPING
    ; THE DECLARATION. `[k: string]` and `[k: number]` are the keyword arms of
    ; getTypeFromTypeNode and are ported; anything else records its own stop and
    ; answers null, and a group built out of the SURVIVORS would answer a different
    ; question — two signatures can only be proven distinct when both types are
    ; known. Skipping would LOSE a report, which diagcheck cannot see; abandoning
    ; says so on the work list.
    ;
    ; ★ `Distributed()` is three cases and all three are written: a UNION answers
    ; its constituents (since slice 202), `never` answers the EMPTY list — `[k: never]` contributes
    ; no group at all — and anything else answers the one type. The never arm is
    ; two lines and is written, because leaving it out would silently file a `never`
    ; index under itself and invent TS2374 for a pair the reference lets through.
    procedure check_type_for_duplicate_index_signatures(this, node: ref[AstNode])
    {
        let symbol this.symbol_of_declaration(node)
        if symbol = null
            return
        let index_symbol this.get_index_symbol(symbol as ref[Symbol])
        if index_symbol = null
            return
        let isym index_symbol as ref[Symbol]
        let decl_count Symbol.declaration_count(isym)
        if decl_count <= 1
            return
        let unported_before this.unported_mark()
        ; The two parallel rows: one type id per (type, declaration) pair, and the
        ; declaration it came from. A pair rather than a map, for the reason the
        ; header gives.
        let ids &Array[int]()
        let decls &Array[ref[AstNode]?]^host()
        ; A third row, for the report's own `c.TypeToString(t)` — the name is not
        ; asked until a partner is found, so the TYPE has to survive the loop.
        let key_types &Array[ref[Type]?]^host()
        var i 0
        while i < decl_count
        {
            let d Symbol.declaration_at(isym, i)
            set i: i + 1
            if d = null
                continue
            let dn d as ref[AstNode]
            if AstNode.kind_of(dn) <> KindIndexSignature
                continue
            let params AstNode.parameters_of(dn)
            if params = null
                continue
            let ps params as ref[Array[ref[AstNode]?]]
            if ps.get_length() <> 1
                continue
            let p0 ps[0]
            if p0 = null
                continue
            let pt AstNode.type_of(p0 as ref[AstNode])
            if pt = null
                continue
            let t this.get_type_from_type_node(pt as ref[AstNode])
            if this.unported_mark() <> unported_before
                return
            if t = null
                return
            let ty t as ref[Type]
            ; Distributed(): never contributes nothing, a union each of its
            ; constituents, everything else itself.
            if (ty.flags & TypeFlagsNever) <> 0
                continue
            if (ty.flags & TypeFlagsUnion) <> 0
            {
                ; Distributed(): a union files the declaration once per
                ; constituent (slice 202, `indexSignatures1`).
                let cs Checker.union_types_of(ty)
                if cs <> null
                {
                    let cl cs as ref[Array[ref[Type]?]]
                    let cn cl.get_length() as int
                    var ci 0
                    while ci < cn
                    {
                        let c1 cl[ci]
                        if c1 <> null
                        {
                            let ct c1 as ref[Type]
                            ids.add(ct.id)
                            decls.add(dn)
                            key_types.add(ct)
                        }
                        set ci: ci + 1
                    }
                }
                continue
            }
            ids.add(ty.id)
            decls.add(dn)
            key_types.add(ty)
        }
        ; One report per declaration whose type has a partner, which is the
        ; reference's `for t, declarations := range m { if len(declarations) > 1 }`
        ; turned inside out: same set of reported declarations, no map.
        let n ids.get_length() as int
        var a 0
        while a < n
        {
            let ida ids[a]
            var partners 0
            var bx 0
            while bx < n
            {
                if ids[bx] = ida
                    set partners: partners + 1
                set bx: bx + 1
            }
            if partners > 1
            {
                ; `decls` is the `&Array[…]^host()` cell above, so the element
                ; read is `at(a)` in the TWO-STEP form (a typed binding; a null
                ; test on the borrowed cell itself never loads it). History: while
                ; `decls` was still a `pointer[Array[…]]`, `decls[a]` was pointer
                ; arithmetic with an Array-sized stride, and the deref sweep of
                ; 2026-08-27 wrote exactly that — the two TS2374 reports of every
                ; fixture came out at the same garbage span, six units red on a
                ; SUBSEQUENCE instrument, which is the only reason it was caught.
                let da: ref[AstNode]? decls.at(a)
                if da <> null
                {
                    let kt: ref[Type]? key_types.at(a)
                    let key_name this.type_arg(kt)
                    this.error_on_node(da as ref[AstNode], DiagDuplicate_index_signature_for_type_0, key_name)
                }
            }
            set a: a + 1
        }
    }

    procedure check_object_type_for_duplicate_declarations(this, node: ref[AstNode], check_private_names: bool)
    {
        let members AstNode.member_list_of(node)
        if members = null
            return
        let ms members as ref[Array[ref[AstNode]?]]
        let count ms.get_length() as int
        if count = 0
            return
        let ia &Array[DuplicateNameEntry]^host()
        let sa &Array[DuplicateNameEntry]^host()
        let pa &Array[DuplicateNameEntry]^host()
        let node_in_ambient_context (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
        var i 0
        while i < count
        {
            let m ms[i]
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if AstNode.kind_of(member) = KindConstructor
            {
                ; A parameter property declares a class member without appearing in
                ; the member list, so the constructor's parameters are walked in
                ; the member's place. `is_parameter_property_declaration` reads the
                ; parameter's own PARENT where the reference is handed `member`
                ; explicitly; they are the same node, since the parameter list
                ; being walked is this constructor's.
                let params AstNode.parameters_of(member)
                if params = null
                    continue
                let ps params as ref[Array[ref[AstNode]?]]
                let pn ps.get_length() as int
                var j 0
                while j < pn
                {
                    let p ps[j]
                    set j: j + 1
                    if p = null
                        continue
                    let param p as ref[AstNode]
                    if b.is_parameter_property_declaration(param) = false
                        continue
                    if AstNode.is_binding_pattern(AstNode.name_of(param))
                        continue
                    this.check_property_or_accessor(node, this.symbol_of_declaration(param), 1, false, ia, sa)
                }
                continue
            }
            let symbol this.symbol_of_declaration(member)
            let is_static b.has_syntactic_modifier(member, ModifierFlagsStatic)
            ; In non-ambient contexts, check that static members are not named
            ; 'prototype'.
            if node_in_ambient_context = false
            {
                if is_static
                {
                    if symbol <> null
                    {
                        if Checker.symbol_name_equals(symbol as ref[Symbol], "prototype")
                            this.error_on_node_or_null(AstNode.name_of(member), DiagStatic_property_0_conflicts_with_built_in_property_Function_0_of_constructor_function_1, "prototype", this.symbol_arg(this.get_symbol_of_declaration(node)))
                    }
                }
            }
            ; Check that this object type declaration doesn't contain multiple
            ; declarations of the same property, or accessor and property
            ; declarations with the same name.
            ;
            ; ★ The reference's condition is `IsPropertyDeclaration(member) &&
            ; !HasAccessorModifier(member) || IsPropertySignatureDeclaration(member)`
            ; against `IsAccessor(member) || IsPropertyDeclaration(member) &&
            ; HasAccessorModifier(member)`, i.e. an `accessor` field is an ACCESSOR
            ; and a plain field is a property. Written as nested ifs for the
            ; language guide's reason, and the else-branch is the reference's `else
            ; if` and not a second independent test.
            ;
            ; ★★★ THE MODIFIER TEST IS UNOBSERVABLE AND THE BINDER IS WHY (control
            ; g08, two wrong fixtures). Only ONE kind pair distinguishes the two
            ; readings — accessor against accessor, where the switch falls through
            ; and reports nothing — and the binder never merges that pair: two
            ; `accessor` fields conflict, and so does an `accessor` field beside a
            ; getter, so each keeps its own symbol with ONE declaration and the
            ; guard in check_property_or_accessor stops it. Every shape that DOES
            ; merge (a plain field beside an `accessor` field, either order) reports
            ; under both readings. So this test is here for the reference's sake and
            ; nothing in this suite can go red on it; the symbols yardstick matching
            ; those units is what makes that a claim about the reference.
            ;
            ; ★ KindPropertySignature has no input either: the only caller that
            ; passes a type literal or an interface is behind an earlier stop.
            let mk AstNode.kind_of(member)
            var is_property false
            if mk = KindPropertyDeclaration
            {
                if b.has_syntactic_modifier(member, ModifierFlagsAccessor) = false
                    set is_property: true
            }
            if mk = KindPropertySignature
                set is_property: true
            if is_property
                this.check_property_or_accessor(node, symbol, 1, is_static, ia, sa)
            else
            {
                var is_accessor false
                if Checker.is_accessor_kind(mk)
                    set is_accessor: true
                if mk = KindPropertyDeclaration
                {
                    if b.has_syntactic_modifier(member, ModifierFlagsAccessor)
                        set is_accessor: true
                }
                if is_accessor
                    this.check_property_or_accessor(node, symbol, 2, is_static, ia, sa)
            }
            ; Check that each private identifier is used only for instance members
            ; or only for static members. It is an error for an instance and a
            ; static member to have the same private identifier.
            if check_private_names = false
                continue
            let nm AstNode.name_of(member)
            if nm = null
                continue
            if AstNode.is_private_identifier(nm) = false
                continue
            if symbol = null
            {
                ; The reference dereferences the symbol here and would PANIC; a
                ; private-named class element is always declared, so this reports
                ; rather than trapping (§3.5, the standing answer to a reference
                ; panic) and the histogram says so if the claim is ever false.
                this.record_unported("duplicate-declarations-private-no-symbol", mk)
                continue
            }
            let psym symbol as ref[Symbol]
            let pd Symbol.name_of(psym)
            let pl Symbol.name_len_of(psym)
            var flags Checker.duplicate_name_state(pa, pd)
            if flags = 3
                continue
            var bit 1
            if b.is_static(member)
                set bit: 2
            set flags: flags | bit
            Checker.set_duplicate_name_state(pa, pd, flags)
            if flags = 3
                this.report_duplicate_member_errors(node, pd, false, false, DiagDuplicate_identifier_0_Static_and_instance_elements_cannot_share_the_same_private_name)
        }
    }

    ; checkPropertyOrAccessor, the closure — the two kind maps it captures are
    ; parameters, and `node` with them because the reporter needs it.
    ;
    ; ★★ THE STATE MACHINE IS THREE-VALUED AND ITS THIRD VALUE IS "ALREADY SAID SO".
    ; `state == 0` is the absent key, so the first sighting of a name only records
    ; what KIND it was; the second reports if the pair is property/property or
    ; property/accessor and then writes 3, which no later member can move — two
    ; accessors of the same name are a getter and a setter and are NOT an error,
    ; which is the whole content of `state == 2 && kind != 2`.
    procedure check_property_or_accessor(this, node: ref[AstNode], symbol: ref[Symbol]?, kind: int, is_static: bool, instance_names: ref[Array[DuplicateNameEntry]], static_names: ref[Array[DuplicateNameEntry]])
    {
        if symbol = null
        {
            ; `len(symbol.Declarations)` on a nil symbol PANICS upstream. The
            ; reference itself is of two minds about it — the `prototype` test three
            ; lines above this call site guards with `symbol != nil` and this call
            ; does not — so the assumption is made visible rather than assumed.
            this.record_unported("duplicate-declarations-no-symbol", AstNode.kind_of(node))
            return
        }
        let sym symbol as ref[Symbol]
        if Symbol.declaration_count(sym) <= 1
            return
        var names: ref[Array[DuplicateNameEntry]] instance_names
        if is_static
            set names: static_names
        let d Symbol.name_of(sym)
        let n Symbol.name_len_of(sym)
        let state Checker.duplicate_name_state(names, d)
        if state = 0
        {
            ; On first occurrence just record the kind.
            Checker.set_duplicate_name_state(names, d, kind)
            return
        }
        var report false
        if state = 1
            set report: true
        if state = 2
        {
            if kind <> 2
                set report: true
        }
        if report = false
            return
        ; Error on second property or combination of property and accessor.
        this.report_duplicate_member_errors(node, d, true, is_static, DiagDuplicate_identifier_0)
        ; Record that errors have been reported.
        Checker.set_duplicate_name_state(names, d, 3)
    }

    ; reportDuplicateMemberErrors, whole.
    ;
    ; ★★ IT WALKS THE WHOLE MEMBER LIST AGAIN PER REPORTED NAME, and that is the
    ; reference's shape rather than an oversight: the report has to land on EVERY
    ; declaration of the name, not on the second one, so the diagnostics come out in
    ; member order and a name declared three times collects three. Keeping a list of
    ; the nodes seen so far would answer the same set in the same order only for the
    ; declarations BEFORE the one that tripped the state machine.
    ;
    ; ★ `checkStatic` is false only on the private-name call, where the point is
    ; precisely that a static and an instance member share the name — so the filter
    ; that the two kind maps get from being separate maps has to be switched off.
    procedure report_duplicate_member_errors(this, node: ref[AstNode], name_data: Slice[char], check_static: bool, is_static: bool, code: int)
    {
        let members AstNode.member_list_of(node)
        if members = null
            return
        let ms members as ref[Array[ref[AstNode]?]]
        let count ms.get_length() as int
        var i 0
        while i < count
        {
            let m ms[i]
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if AstNode.kind_of(member) = KindConstructor
            {
                let params AstNode.parameters_of(member)
                if params = null
                    continue
                let ps params as ref[Array[ref[AstNode]?]]
                let pn ps.get_length() as int
                var j 0
                while j < pn
                {
                    let p ps[j]
                    set j: j + 1
                    if p = null
                        continue
                    let param p as ref[AstNode]
                    if b.is_parameter_property_declaration(param) = false
                        continue
                    if AstNode.is_binding_pattern(AstNode.name_of(param))
                        continue
                    let psym this.symbol_of_declaration(param)
                    if psym = null
                    {
                        ; The reference reads `symbol.Name` here without asking, and
                        ; would PANIC — the same shape check_property_or_accessor
                        ; reports rather than trapping, and the third site of it in
                        ; this pair. It is NOT covered by that one: the reporter
                        ; walks every member, including a constructor the outer walk
                        ; has not reached yet.
                        this.record_unported("duplicate-member-errors-no-symbol", AstNode.kind_of(member))
                        continue
                    }
                    if Checker.symbol_name_matches(psym as ref[Symbol], name_data)
                        this.error_on_node_or_null(AstNode.name_of(param), code, this.symbol_arg(psym))
                }
                continue
            }
            let msym this.symbol_of_declaration(member)
            ; ★ THIS guard is the REFERENCE'S own — `symbol != nil && symbol.Name ==
            ; name` — so it is a skip and not a report, unlike the parameter branch
            ; three lines up. The asymmetry is upstream's and is transcribed.
            if msym = null
                continue
            if Checker.symbol_name_matches(msym as ref[Symbol], name_data) = false
                continue
            if check_static
            {
                if is_static <> b.is_static(member)
                    continue
            }
            this.error_on_node_or_null(AstNode.name_of(member), code, this.symbol_arg(msym))
        }
    }

    ; The map read, `names[symbol.Name]`. A name the list does not carry answers 0,
    ; which is what a Go map read of an absent key does.
    function duplicate_name_state(t: ref[Array[DuplicateNameEntry]], d: Slice[char]) returns int
    {
        let len t.get_length() as int
        var i 0
        while i < len
        {
            let e t.at(i)
            if SymbolTable.names_equal(e.name, d)
                return e.state
            set i: i + 1
        }
        0
    }

    ; The map write, `names[symbol.Name] = state`. An existing name is overwritten
    ; in place; a new one is appended.
    procedure set_duplicate_name_state(t: ref[Array[DuplicateNameEntry]], d: Slice[char], s: int)
    {
        let len t.get_length() as int
        var i 0
        while i < len
        {
            let e t.at(i)
            if SymbolTable.names_equal(e.name, d)
            {
                set e.state: s
                return
            }
            set i: i + 1
        }
        t.add(DuplicateNameEntry(d, s))
    }

    ; `symbol.Name == <literal>`, for the one name this slice compares against a
    ; constant. The bytes are not text (§Symbol.name_data), so the comparison is
    ; SymbolTable.names_equal's and not a String's.
    function symbol_name_equals(s: ref[Symbol], lit: Slice[char]) returns bool
    {
        if Symbol.name_len_of(s) <> lit.length
            return false
        let d Symbol.name_of(s)
        if d.data = null
            return false
        var i 0
        while i < lit.length
        {
            if (d[i] as int) <> ((lit[i] as char) as int)
                return false
            set i: i + 1
        }
        true
    }

    ; `symbol.Name == name`, symbol against the reported name's bytes.
    function symbol_name_matches(s: ref[Symbol], d: Slice[char]) returns bool
        SymbolTable.names_equal(Symbol.name_of(s), d)

    ; checkClassLikeDeclaration's prefix — two calls and then the check that stops
    ; it. It is a function of its own rather than folded into the class arm because
    ; the reference has it that way and because checkClassExpression is its second
    ; caller, which is the next slice that reaches this file.
    ;
    ; ★★ SLICE 59's CONTINUATION, and it moves the stop TWO calls on rather than
    ; one: the collision head runs, then checkTypeParameters — which is ported and
    ; whose own report is inside its loop — so a generic class stops at
    ; check-type-parameter and a plain one at checkExportsOnMergedDeclarations.
    ; ★The two reports the head adds here are the class's own: the reserved type
    ; name (`class any {}`) and `class Object {}` under a module format below
    ; ES2015, which is what this harness has.
    ; ── slice 124: checkKindsOfPropertyMemberOverrides ────────────────────────
    ;
    ; ★★★ THE LABELLED `continue basePropertyCheck` IS THE ONE CONTROL SHAPE THIS
    ; LANGUAGE HAS TO SPELL DIFFERENTLY, and it is spelled as a FLAG rather than
    ; with a labelled loop, because the jump crosses a nested loop AND skips the
    ; map write that follows it — `break loop outer` would leave the outer loop
    ; instead of advancing it. The flag is read once, immediately after the inner
    ; loop, which is exactly where the label lands.
    ;
    ; ★★ TWO POPULATIONS, ONE FUNCTION. `derived == base` means the derived class
    ; INHERITED the member without redeclaring it, and the only thing checked there
    ; is the ABSTRACT contract (TS2515 and its five siblings, all collected and
    ; reported at the end, once per derived class). Otherwise the derived class
    ; overrides, and what is checked is the KIND agreement — property against
    ; accessor against method — plus the useDefineForClassFields shadowing report.
    ; The reference's own note says the ASSIGNABILITY of an override is checked
    ; elsewhere (issueMemberSpecificError), which is why nothing here asks a
    ; relation.
    ;
    ; ★ getUseDefineForClassFields() is TRUE under this harness — see
    ; check_class_for_static_property_name_conflicts' header for the measurement —
    ; so the TS2612 block is LIVE here where that function's body is dead.
    procedure check_kinds_of_property_member_overrides(this, t: ref[Type], base_type: ref[Type])
    {
        let mark this.unported_mark()
        let not_implemented this.new_unimplemented_list()
        let base_props this.get_properties_of_type(base_type)
        if this.unported_mark() <> mark
            return
        if base_props = null
            return
        let bl base_props as ref[Array[ref[Symbol]?]]
        let bn bl.get_length() as int
        var bi 0
        while bi < bn
        {
            let brow bl[bi]
            set bi: bi + 1
            if brow = null
                continue
            let base_property brow as ref[Symbol]
            let base_sym this.get_target_symbol(base_property)
            if base_sym = null
                continue
            let base base_sym as ref[Symbol]
            if (Symbol.flags_of(base) & SymbolFlagsPrototype) <> 0
                continue
            let base_symbol this.get_property_of_object_type(t, Symbol.name_of(base))
            if this.unported_mark() <> mark
                return
            if base_symbol = null
                continue
            let derived_sym this.get_target_symbol(base_symbol as ref[Symbol])
            if derived_sym = null
                continue
            let derived derived_sym as ref[Symbol]
            let base_declaration_flags this.get_declaration_modifier_flags_from_symbol(base)
            if derived = base
            {
                ; The derived class inherits the base member without overriding it.
                if (base_declaration_flags & ModifierFlagsAbstract) = 0
                    continue
                if t.symbol = null
                    continue
                let derived_class_decl Checker.get_class_like_declaration_of_symbol(t.symbol as ref[Symbol])
                var declared_abstract false
                if derived_class_decl <> null
                {
                    if (b.combined_modifier_flags(derived_class_decl as ref[AstNode]) & ModifierFlagsAbstract) <> 0
                        set declared_abstract: true
                }
                if declared_abstract
                    continue
                ; *Searches other base types for a declaration that would satisfy
                ; the inherited abstract member* — the class may have more than one
                ; base type through declaration merging with an interface of the
                ; same name.
                var satisfied_elsewhere false
                let others this.get_base_types(t)
                if this.unported_mark() <> mark
                    return
                if others <> null
                {
                    let ol others as ref[Array[ref[Type]?]]
                    let on ol.get_length() as int
                    var oi 0
                    while oi < on
                    {
                        let orow ol[oi]
                        set oi: oi + 1
                        if orow = null
                            continue
                        let other orow as ref[Type]
                        if other = base_type
                            continue
                        let os this.get_property_of_object_type(other, Symbol.name_of(base))
                        if this.unported_mark() <> mark
                            return
                        if os = null
                            continue
                        let ot this.get_target_symbol(os as ref[Symbol])
                        if ot = null
                            continue
                        if base <> (ot as ref[Symbol])
                            set satisfied_elsewhere: true
                    }
                }
                if satisfied_elsewhere
                    continue
                ; `baseTypeName := c.TypeToString(baseType)` /
                ; `typeName := c.TypeToString(t)` — the two names the collected
                ; report carries, named here for the walk (name_type_for_message).
                let base_type_name this.type_arg(base_type)
                let type_name this.type_arg(t)
                let missed_name this.symbol_arg(base_property)
                this.bump_unimplemented(not_implemented, derived_class_decl, base_type_name, type_name, missed_name)
                continue
            }
            ; The derived class OVERRIDES the base member.
            let derived_declaration_flags this.get_declaration_modifier_flags_from_symbol(derived)
            if (base_declaration_flags & ModifierFlagsPrivate) <> 0
                continue
            if (derived_declaration_flags & ModifierFlagsPrivate) <> 0
                continue
            var error_node Symbol.value_declaration_of(derived)
            var name_node null as ref[AstNode]?
            if error_node <> null
                set name_node: this.name_of_declaration(error_node as ref[AstNode])
            if name_node <> null
                set error_node: name_node
            let base_property_flags Symbol.flags_of(base) & SymbolFlagsPropertyOrAccessor
            let derived_property_flags Symbol.flags_of(derived) & SymbolFlagsPropertyOrAccessor
            if base_property_flags <> 0
            {
                if derived_property_flags <> 0
                {
                    ; property/accessor overridden with property/accessor.
                    var exempt (Symbol.check_flags_of(base) & CheckFlagsMapped) <> 0
                    let dvd Symbol.value_declaration_of(derived)
                    if dvd <> null
                    {
                        if AstNode.kind_of(dvd as ref[AstNode]) = KindBinaryExpression
                            set exempt: true
                    }
                    if this.are_properties_abstract_or_interface(base, base_declaration_flags)
                        set exempt: true
                    if exempt
                        continue
                    var overridden_instance_property false
                    if base_property_flags <> SymbolFlagsProperty
                    {
                        if derived_property_flags = SymbolFlagsProperty
                            set overridden_instance_property: true
                    }
                    var overridden_instance_accessor false
                    if base_property_flags = SymbolFlagsProperty
                    {
                        if derived_property_flags <> SymbolFlagsProperty
                            set overridden_instance_accessor: true
                    }
                    if overridden_instance_property
                    {
                        let base_name this.symbol_arg(base)
                        let base_type_name this.type_arg(base_type)
                        let type_name this.type_arg(t)
                        this.error_on_node(error_node, DiagX_0_is_defined_as_an_accessor_in_class_1_but_is_overridden_here_in_2_as_an_instance_property, base_name, base_type_name, type_name)
                        continue
                    }
                    if overridden_instance_accessor
                    {
                        let base_name this.symbol_arg(base)
                        let base_type_name this.type_arg(base_type)
                        let type_name this.type_arg(t)
                        this.error_on_node(error_node, DiagX_0_is_defined_as_a_property_in_class_1_but_is_overridden_here_in_2_as_an_accessor, base_name, base_type_name, type_name)
                        continue
                    }
                    if use_define_for_class_fields
                        this.report_base_property_overwrite(t, base_type, base, derived, base_declaration_flags, derived_declaration_flags, error_node, mark)
                    if this.unported_mark() <> mark
                        return
                    continue
                }
            }
            var error_code 0
            if Checker.is_prototype_property(base)
            {
                if Checker.is_prototype_property(derived)
                    continue
                if (Symbol.flags_of(derived) & SymbolFlagsProperty) <> 0
                    continue
                set error_code: DiagClass_0_defines_instance_member_function_1_but_extended_class_2_defines_it_as_instance_member_accessor
            }
            else
            {
                if (Symbol.flags_of(base) & SymbolFlagsAccessor) <> 0
                    set error_code: DiagClass_0_defines_instance_member_accessor_1_but_extended_class_2_defines_it_as_instance_member_function
                else
                    set error_code: DiagClass_0_defines_instance_member_property_1_but_extended_class_2_defines_it_as_instance_member_function
            }
            let base_type_name this.type_arg(base_type)
            let base_name this.symbol_arg(base)
            let type_name this.type_arg(t)
            this.error_on_node(error_node, error_code, base_type_name, base_name, type_name)
        }
        ; The collected abstract-member reports, one per derived class declaration.
        let un not_implemented.get_length() as int
        var ui 0
        while ui < un
        {
            let row not_implemented[ui]
            set ui: ui + 1
            let node row.error_node
            if node = null
                continue
            let en node as ref[AstNode]
            let is_expression AstNode.kind_of(en) = KindClassExpression
            let names row.missed_names as ref[Array[String]]
            if row.missed_count = 1
            {
                let missed_property names[0]
                if is_expression
                    this.error_on_node(en, DiagNon_abstract_class_expression_does_not_implement_inherited_abstract_member_0_from_class_1, missed_property, row.base_type_name)
                else
                    this.error_on_node(en, DiagNon_abstract_class_0_does_not_implement_inherited_abstract_member_1_from_class_2, row.type_name, missed_property, row.base_type_name)
                continue
            }
            var shown row.missed_count
            if row.missed_count > 5
                set shown: 4
            var missed_text StringBuilder()
            var mi 0
            while mi < shown
            {
                if mi > 0
                    missed_text.append(", ")
                missed_text.append("'" as char)
                missed_text.append(names[mi as size_t])
                missed_text.append("'" as char)
                set mi: mi + 1
            }
            if row.missed_count > 5
            {
                let remaining Checker.arg_int(row.missed_count - 4)
                if is_expression
                    this.error_on_node(en, DiagNon_abstract_class_expression_is_missing_implementations_for_the_following_members_of_0_Colon_1_and_2_more, row.base_type_name, missed_text.to_string(), remaining)
                else
                    this.error_on_node(en, DiagNon_abstract_class_0_is_missing_implementations_for_the_following_members_of_1_Colon_2_and_3_more, row.type_name, row.base_type_name, missed_text.to_string(), remaining)
                continue
            }
            if is_expression
                this.error_on_node(en, DiagNon_abstract_class_expression_is_missing_implementations_for_the_following_members_of_0_Colon_1, row.base_type_name, missed_text.to_string())
            else
                this.error_on_node(en, DiagNon_abstract_class_0_is_missing_implementations_for_the_following_members_of_1_Colon_2, row.type_name, row.base_type_name, missed_text.to_string())
        }
    }

    ; `notImplementedInfo[derivedClassDecl] = MemberInfo{…missedProperties+1}` — the
    ; map write, as an append-or-increment over the list. ★A nil derivedClassDecl is
    ; a REAL key upstream (a class expression whose symbol has no class-like
    ; declaration), so it is kept as one here rather than skipped.
    procedure bump_unimplemented(this, t: ref[Array[UnimplementedMembers]], node: ref[AstNode]?, base_type_name: String, type_name: String, missed_name: String)
    {
        let h host
        let base_copy String^h(base_type_name)
        let type_copy String^h(type_name)
        let missed_copy String^h(missed_name)
        let n t.get_length() as int
        var i 0
        while i < n
        {
            let e t.at(i)
            if e.error_node = node
            {
                set e.missed_count: e.missed_count + 1
                set e.base_type_name: base_copy
                set e.type_name: type_copy
                (e.missed_names as ref[Array[String]]).add(missed_copy)
                return
            }
            set i: i + 1
        }
        var made UnimplementedMembers(node)
        set made.missed_count: 1
        set made.base_type_name: base_copy
        set made.type_name: type_copy
        let names &Array[String]^h()
        names.add(missed_copy)
        set made.missed_names: names
        t.add(made)
    }

    ; The `else if c.compilerOptions.GetUseDefineForClassFields()` arm of the
    ; property/accessor pair — TS2612, *this declaration will overwrite the base
    ; property*. ★It is a function of its own because it is five nested conditions
    ; deep in the reference and the arm above it `continue`s, so folding it inline
    ; would put the whole of it inside one more level of the override loop.
    procedure report_base_property_overwrite(this, t: ref[Type], base_type: ref[Type], base: ref[Symbol], derived: ref[Symbol], base_declaration_flags: int, derived_declaration_flags: int, error_node: ref[AstNode]?, mark: int)
    {
        ; `core.Find(derived.Declarations, IsPropertyDeclaration && Initializer == nil)`
        var uninitialized null as ref[AstNode]?
        var any_ambient false
        let dn Symbol.declaration_count(derived)
        var i 0
        while i < dn
        {
            let d Symbol.declaration_at(derived, i)
            set i: i + 1
            if d = null
                continue
            let node d as ref[AstNode]
            if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
                set any_ambient: true
            if uninitialized <> null
                continue
            if AstNode.kind_of(node) <> KindPropertyDeclaration
                continue
            if AstNode.initializer_of(node) = null
                set uninitialized: node
        }
        if uninitialized = null
            return
        if (Symbol.flags_of(derived) & SymbolFlagsTransient) <> 0
            return
        if (base_declaration_flags & ModifierFlagsAbstract) <> 0
            return
        if (derived_declaration_flags & ModifierFlagsAbstract) <> 0
            return
        if any_ambient
            return
        let u uninitialized as ref[AstNode]
        ; `isExclamationToken(uninitialized.PostfixToken()) || constructor == nil ||
        ; !IsIdentifier(propName) || !strictNullChecks ||
        ; !isPropertyInitializedInConstructor(propName, t, constructor)` — a
        ; DISJUNCTION, so any one of the five reports.
        let postfix AstNode.postfix_token_of(u)
        if Checker.kind_or_unknown(postfix) = KindExclamationToken
        {
            let name_arg25 this.type_arg(base_type)
            this.error_on_node(error_node, DiagProperty_0_will_overwrite_the_base_property_in_1_If_this_is_intentional_add_an_initializer_Otherwise_add_a_declare_modifier_or_remove_the_redundant_declaration, this.symbol_arg(base), name_arg25)
            return
        }
        var constructor null as ref[AstNode]?
        if t.symbol <> null
        {
            let class_decl Checker.get_class_like_declaration_of_symbol(t.symbol as ref[Symbol])
            if class_decl <> null
                set constructor: Checker.find_constructor_declaration(class_decl as ref[AstNode])
        }
        let prop_name AstNode.name_of(u)
        var report false
        if constructor = null
            set report: true
        if Checker.kind_or_unknown(prop_name) <> KindIdentifier
            set report: true
        if Checker.strict_null_checks() = false
            set report: true
        if report = false
        {
            let initialized this.is_property_initialized_in_constructor(prop_name as ref[AstNode], t, constructor as ref[AstNode])
            if this.unported_mark() <> mark
                return
            if initialized = false
                set report: true
        }
        if report
        {
            let name_arg26 this.type_arg(base_type)
            this.error_on_node(error_node, DiagProperty_0_will_overwrite_the_base_property_in_1_If_this_is_intentional_add_an_initializer_Otherwise_add_a_declare_modifier_or_remove_the_redundant_declaration, this.symbol_arg(base), name_arg26)
        }
    }

    ; getTargetSymbol — an INSTANTIATED symbol's flags are not copied from its
    ; target, so the override check must compare the uninstantiated ones. ★It is
    ; what makes `derived == base` a correct *inherited without override* test even
    ; for a generic base.
    procedure get_target_symbol(this, s: ref[Symbol]?) returns ref[Symbol]?
    {
        if s = null
            return null
        let sym s as ref[Symbol]
        if (Symbol.check_flags_of(sym) & CheckFlagsInstantiated) = 0
            return sym
        this.value_symbol_link_of(sym).target
    }

    ; getRestTypeAtPosition / getRestOrAnyTypeAtPosition — the type of the
    ; parameters from `pos` on, as a tuple. Whole since slice 150.
    ;
    ; ★★★ THE `readonly` PARAMETER IS BACK, AND §3.18's NOTE CARRIED ITS OWN EXPIRY
    ; DATE: it was dropped because *the one caller passes false*, which was a
    ; statement about the callers this function had while its tuple arm was a stop.
    ; applyToParameterTypes is the caller that does not — its argument is
    ; `isConstTypeVariable(targetRestType) && !someType(targetRestType,
    ; isMutableArrayLikeType)` — so the parameter came back with the arm it belongs
    ; to. ★An argument dropped for its VALUE at the call sites of the day has to be
    ; re-read whenever a new call site lands, and nothing here does that.
    ;
    ; ★★★ AND THE EMPTY CASE WAS A WRONG ANSWER, LIVE RATHER THAN SHIELDED: for
    ; `length <= 0` the reference answers the EMPTY TUPLE
    ; (`createTupleTypeEx(nil, nil, readonly)`) and this answered `never[]` — a
    ; different type, printed differently, on a line no stop guarded. It is
    ; §3.5ge's shape one line up rather than one function away: the wall below it
    ; kept anything from ever reading the line's answer.
    ;
    ; ★★ THE SYNTHETIC TUPLE'S THREE ELEMENT FLAGS are the parameter list's own
    ; shape: REQUIRED up to the minimum argument count, OPTIONAL past it, and the
    ; rest type itself as the VARIADIC last element. Every element carries the
    ; declaration its LABEL may be read off, which is what makes the printed tuple
    ; say `[kind: 'A', payload: number]` rather than `['A', number]`.
    procedure get_rest_type_at_position(this, source: ref[Signature], pos: int, readonly: bool) returns ref[Type]?
    {
        let mark this.unported_mark()
        let parameter_count this.get_parameter_count(source)
        let min_argument_count this.get_min_argument_count(source)
        let rest_type this.get_effective_rest_type(source)
        if this.unported_mark() <> mark
            return null
        if rest_type <> null
        {
            if pos >= (parameter_count - 1)
            {
                if pos = (parameter_count - 1)
                    return rest_type
                let element this.get_indexed_access_type(rest_type as ref[Type], number_type)
                if element = null
                    return null
                return this.create_array_type(element as ref[Type])
            }
        }
        let length parameter_count - pos
        if length <= 0
            return this.create_tuple_type_ex(null, this.new_tuple_info_list(), readonly)
        let element_types this.new_type_list(null)
        let element_infos this.new_tuple_info_list()
        var i 0
        while i < length
        {
            var flags ElementFlagsRequired
            var variadic false
            if rest_type <> null
            {
                if i >= (length - 1)
                    set variadic: true
            }
            if variadic
            {
                element_types.add(rest_type)
                set flags: ElementFlagsVariadic
            }
            else
            {
                let at this.get_type_at_position(source, i + pos)
                if this.unported_mark() <> mark
                    return null
                element_types.add(at)
                if (i + pos) >= min_argument_count
                    set flags: ElementFlagsOptional
            }
            let labeled this.get_nameable_declaration_at_position(source, i + pos)
            if this.unported_mark() <> mark
                return null
            element_infos.add(&TupleElementInfo^host(flags, labeled))
            set i: i + 1
        }
        this.create_tuple_type_ex(element_types, element_infos, readonly)
    }

    ; getNameableDeclarationAtPosition — the declaration a tuple element's LABEL is
    ; read off, for the parameter at `pos` of a signature.
    ;
    ; ★★ THE REST PARAMETER'S OWN TUPLE IS ASKED FIRST AND ITS LABELS WIN, because
    ; a rest parameter spread from `[kind: 'A', payload: number]` carries the two
    ; names the caller wrote there and not the one name the rest parameter has.
    ; Only when the rest type is NOT a tuple does the rest parameter's own
    ; getParameterNameAtPosition (slice 155) — the NAME twin of
    ; get_nameable_declaration_at_position just below, and it is written beside it
    ; on purpose: the two walk the same rest-parameter/tuple structure and answer
    ; two different things about it, so a change to one is a question about the
    ; other.
    procedure get_parameter_name_at_position(this, signature: ref[Signature], pos: int) returns Slice[char]
    {
        if signature.parameters = null
            return Slice[char]()
        let ps signature.parameters as ref[Array[ref[Symbol]?]]
        var param_count ps.get_length() as int
        if Checker.signature_has_rest_parameter(signature)
            set param_count: param_count - 1
        if pos < param_count
        {
            let p ps[pos]
            if p = null
                return Slice[char]()
            return Symbol.name_of(p as ref[Symbol])
        }
        if param_count >= (ps.get_length() as int)
            return Slice[char]()
        let rest_opt ps[param_count]
        if rest_opt = null
            return Slice[char]()
        let rest_parameter rest_opt as ref[Symbol]
        let mark this.unported_mark()
        let rest_type this.get_type_of_symbol(rest_parameter)
        if this.unported_mark() <> mark
            return Slice[char]()
        if rest_type = null
            return Symbol.name_of(rest_parameter)
        let rt rest_type as ref[Type]
        if Checker.is_tuple_type(rt)
        {
            let target Checker.target_of(rt)
            if target = null
                return Symbol.name_of(rest_parameter)
            let infos Checker.tuple_element_infos_of(target as ref[Type])
            if infos = null
                return Symbol.name_of(rest_parameter)
            let list infos as ref[Array[ref[TupleElementInfo]?]]
            let index pos - param_count
            if index >= (list.get_length() as int)
                return Symbol.name_of(rest_parameter)
            let info list[index]
            if info = null
                return Symbol.name_of(rest_parameter)
            return this.get_tuple_element_label(info as ref[TupleElementInfo], rest_parameter, index)
        }
        Symbol.name_of(rest_parameter)
    }

    ; getTupleElementLabel. ★The third arm's `rootName` is the rest SYMBOL's name
    ; or the literal `arg`, and the result carries the index — so two fixed
    ; elements spread out of one rest parameter get distinct names, which is the
    ; whole reason the function is not just `restParameter.Name`.
    procedure get_tuple_element_label(this, info: ref[TupleElementInfo], rest_symbol: ref[Symbol]?, index: int) returns Slice[char]
    {
        if info.labeled_declaration <> null
            return AstNode.property_name_text_of(AstNode.name_of(info.labeled_declaration))
        if rest_symbol <> null
        {
            let rs rest_symbol as ref[Symbol]
            let decl Symbol.value_declaration_of(rs)
            if decl <> null
            {
                if AstNode.kind_of(decl as ref[AstNode]) = KindParameter
                    return this.get_tuple_element_label_from_binding_element(decl as ref[AstNode], index, info.flags)
            }
        }
        var root Slice[char]()
        if rest_symbol = null
            set root: Checker.plain_name(host, "arg")
        if rest_symbol <> null
            set root: Symbol.name_of(rest_symbol as ref[Symbol])
        Checker.suffixed_decimal_name(host, root, true, index)
    }

    ; getTupleElementLabelFromBindingElement — the destructured rest parameter,
    ; `(...[x, y, ...z]: [number, number, ...number[]]) => …`.
    ;
    ; ★★★ THE TWO `_`-SUFFIX RULES ARE OPPOSITES AND UPSTREAM'S COMMENT EXPLAINS
    ; BOTH. Under a `...` the FIXED elements get a number and the variable one
    ; keeps the bare name; without a `...` the FIXED element keeps the bare name
    ; and a variable one becomes `x_n`. What is preserved either way is the
    ; element's own restness, which is what a caller re-spreading the signature
    ; needs.
    procedure get_tuple_element_label_from_binding_element(this, node: ref[AstNode], index: int, element_flags: int) returns Slice[char]
    {
        let nm AstNode.name_of(node)
        if nm <> null
        {
            let name_node nm as ref[AstNode]
            let k AstNode.kind_of(name_node)
            if k = KindIdentifier
            {
                let name AstNode.identifier_text_of(name_node)
                if AstNode.dot_dot_dot_token_of(node) <> null
                {
                    if (element_flags & ElementFlagsVariable) <> 0
                        return name
                    return Checker.suffixed_decimal_name(host, name, true, index)
                }
                if (element_flags & ElementFlagsFixed) <> 0
                    return name
                return Checker.concat_name(host, name, "_n")
            }
            if k = KindArrayBindingPattern
            {
                if AstNode.dot_dot_dot_token_of(node) <> null
                {
                    let elements AstNode.elements_of(name_node)
                    if elements <> null
                    {
                        let list elements as ref[Array[ref[AstNode]?]]
                        let n list.get_length() as int
                        var last: ref[AstNode]? null
                        if n > 0
                            set last: list[n - 1]
                        var last_is_rest false
                        if last <> null
                        {
                            let le last as ref[AstNode]
                            if AstNode.kind_of(le) = KindBindingElement
                            {
                                if AstNode.dot_dot_dot_token_of(le) <> null
                                    set last_is_rest: true
                            }
                        }
                        var element_count n
                        if last_is_rest
                            set element_count: element_count - 1
                        if index < element_count
                        {
                            let e list[index]
                            if e <> null
                            {
                                let en e as ref[AstNode]
                                if AstNode.kind_of(en) = KindBindingElement
                                    return this.get_tuple_element_label_from_binding_element(en, index, element_flags)
                            }
                        }
                        if index >= element_count
                        {
                            if last_is_rest
                                return this.get_tuple_element_label_from_binding_element(last as ref[AstNode], index - element_count, element_flags)
                        }
                    }
                }
            }
        }
        Checker.suffixed_decimal_name(host, Checker.plain_name(host, "arg"), true, index)
    }

    ; declaration answer for every position past the fixed ones.
    procedure get_nameable_declaration_at_position(this, signature: ref[Signature], pos: int) returns ref[AstNode]?
    {
        if signature.parameters = null
            return null
        let ps signature.parameters as ref[Array[ref[Symbol]?]]
        let has_rest Checker.signature_has_rest_parameter(signature)
        var param_count ps.get_length() as int
        if has_rest
            set param_count: param_count - 1
        if pos < param_count
        {
            let p ps[pos]
            if p = null
                return null
            let decl Symbol.value_declaration_of(p as ref[Symbol])
            if decl = null
                return null
            if Checker.is_valid_declaration_for_tuple_label(decl as ref[AstNode])
                return decl
            return null
        }
        if has_rest = false
            return null
        let rest_opt ps[param_count]
        if rest_opt = null
            return null
        let rest_parameter rest_opt as ref[Symbol]
        let mark this.unported_mark()
        let rest_type this.get_type_of_symbol(rest_parameter)
        if this.unported_mark() <> mark
            return null
        if rest_type = null
            return null
        let rt rest_type as ref[Type]
        if Checker.is_tuple_type(rt)
        {
            let target Checker.target_of(rt)
            if target = null
                return null
            let infos Checker.tuple_element_infos_of(target as ref[Type])
            if infos = null
                return null
            let list infos as ref[Array[ref[TupleElementInfo]?]]
            let index pos - param_count
            if index >= (list.get_length() as int)
                return null
            let info list[index]
            if info = null
                return null
            return (info as ref[TupleElementInfo]).labeled_declaration
        }
        let rest_decl Symbol.value_declaration_of(rest_parameter)
        if rest_decl = null
            return null
        if Checker.is_valid_declaration_for_tuple_label(rest_decl as ref[AstNode])
            return rest_decl
        null
    }

    ; isValidDeclarationForTupleLabel — a named tuple member, or a parameter whose
    ; name is a plain identifier. ★A parameter whose name is a BINDING PATTERN has
    ; no label to lend, which is the whole content of the identifier test.
    function is_valid_declaration_for_tuple_label(d: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(d) = KindNamedTupleMember
            return true
        if AstNode.kind_of(d) <> KindParameter
            return false
        let name AstNode.name_of(d)
        if name = null
            return false
        AstNode.kind_of(name as ref[AstNode]) = KindIdentifier
    }

    procedure get_rest_or_any_type_at_position(this, source: ref[Signature], pos: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let rest_type this.get_rest_type_at_position(source, pos, false)
        if this.unported_mark() <> mark
            return null
        if rest_type = null
            return null
        let element this.get_element_type_of_array_type(rest_type as ref[Type])
        if this.unported_mark() <> mark
            return null
        if element <> null
        {
            if Checker.is_type_any(element as ref[Type])
                return any_type
        }
        rest_type
    }

    ; isInstantiatedGenericParameter — *this parameter's type came from
    ; instantiating a generic one*, which is what excludes it from the callback
    ; co-variance shortcut.
    procedure is_instantiated_generic_parameter(this, signature: ref[Signature], pos: int) returns bool
    {
        if signature.target = null
            return false
        let mark this.unported_mark()
        let t this.try_get_type_at_position(signature.target as ref[Signature], pos)
        if this.unported_mark() <> mark
            return false
        if t = null
            return false
        this.is_generic_type(t as ref[Type])
    }

    ; getNonCircularReturnTypeOfSignature — *if a signature resolution is already
    ; in-flight, skip issuing a circularity error here and just use `any`*.
    procedure get_non_circular_return_type_of_signature(this, sig: ref[Signature]) returns ref[Type]?
    {
        if this.is_resolving_return_type_of_signature(sig)
            return any_type
        this.get_return_type_of_signature(sig)
    }

    ; isTopSignature — `(...args: any[]) => any` and its `never`/`unknown`
    ; variants, which every signature is related to.
    procedure is_top_signature(this, s: ref[Signature]) returns bool
    {
        if Checker.type_parameter_count_of_signature(s) <> 0
            return false
        if s.this_parameter <> null
        {
            let tp this.get_type_of_parameter(s.this_parameter as ref[Symbol])
            if tp = null
                return false
            if Checker.is_type_any(tp as ref[Type]) = false
                return false
        }
        if Checker.param_count(s.parameters) <> 1
            return false
        if Checker.signature_has_rest_parameter(s) = false
            return false
        let p0 (s.parameters as ref[Array[ref[Symbol]?]])[0]
        if p0 = null
            return false
        let mark this.unported_mark()
        let param_type this.get_type_of_parameter(p0 as ref[Symbol])
        if this.unported_mark() <> mark
            return false
        if param_type = null
            return false
        let pt param_type as ref[Type]
        var rest_type pt
        if this.is_array_type(pt)
        {
            let args this.get_type_arguments(pt)
            if this.unported_mark() <> mark
                return false
            if args = null
                return false
            let a0 (args as ref[Array[ref[Type]?]])[0]
            if a0 = null
                return false
            set rest_type: a0 as ref[Type]
        }
        if (rest_type.flags & (TypeFlagsAny | TypeFlagsNever)) = 0
            return false
        let rt this.get_return_type_of_signature(s)
        if this.unported_mark() <> mark
            return false
        if rt = null
            return false
        ((rt as ref[Type]).flags & TypeFlagsAnyOrUnknown) <> 0
    }

    ; `len(signature.parameters)`, which this chapter asks at five places.
    function param_count(a: ref[Array[ref[Symbol]?]]?) returns int
    {
        if a = null
            return 0
        a.get_length() as int
    }

    function type_parameter_count_of_signature(s: ref[Signature]) returns int
    {
        if s.type_parameters = null
            return 0
        (s.type_parameters as ref[Array[ref[Type]?]]).get_length() as int
    }

    ; The `compareTypes` func value, as the two-armed dispatch §3.18 prescribes.
    ; ★The `reportErrors` argument every arm upstream IGNORES is dropped:
    ; `compareTypesAssignable` is `isTypeRelatedTo` and nothing else.
    ; ★★★ SLICE 126 — THE RELATER ARM IS REAL, AND WHAT IT NEEDED WAS NOT A
    ; PARAMETER BUT TWO CELLS. Upstream the comparer is a CLOSURE over the relater
    ; and over `signatureRelatedTo`'s own `intersectionState`; here the flag can
    ; carry neither, so `rel_cur_relation` and `rel_cur_intersection_state` stand
    ; where the closure's captures stood — §3.20's cell, one chapter over. The
    ; stop that used to live here read *the two differ in whether they report*,
    ; which is true and was never the blocker: the relation and the intersection
    ; state were.
    procedure compare_types_by_comparer(this, comparer: int, source: ref[Type], target: ref[Type]) returns bool
        this.compare_types_by_comparer_ex(comparer, source, target, false)

    ; ★`report_errors` is the reference's own third argument to `compareTypes`, and
    ; the node it reports at is the relation's (rel_error_node) — the chain is
    ; module state here, so nothing else has to travel.
    procedure compare_types_by_comparer_ex(this, comparer: int, source: ref[Type], target: ref[Type], report_errors: bool) returns bool
    {
        if report_errors
        {
            if comparer = SignatureComparerRelaterSimple
                return this.is_related_to_ex(source, target, rel_cur_relation, rel_error_node, IntersectionStateNone, RecursionFlagsBoth)
            if comparer = SignatureComparerRelaterWorker
                return this.is_related_to_ex(source, target, rel_cur_relation, rel_error_node, rel_cur_intersection_state, RecursionFlagsBoth)
        }
        if comparer = SignatureComparerAssignable
            return this.is_type_related_to(source, target, RelationAssignable)
        if comparer = SignatureComparerIdentical
            return this.is_type_related_to(source, target, RelationIdentity)
        if comparer = SignatureComparerSubtypeOf
            return this.is_type_related_to(source, target, RelationSubtype)
        if comparer = SignatureComparerRelaterSimple
            return this.is_related_to_ex(source, target, rel_cur_relation, null, IntersectionStateNone, RecursionFlagsBoth)
        if comparer = SignatureComparerTypesEqual
            return source = target
        this.is_related_to_ex(source, target, rel_cur_relation, null, rel_cur_intersection_state, RecursionFlagsBoth)
    }

    ; compareTypePredicateRelatedTo — the type predicate's own half of the return
    ; comparison.
    procedure compare_type_predicate_related_to(this, source: ref[TypePredicate], target: ref[TypePredicate], comparer: int) returns bool
    {
        if source.kind <> target.kind
            return false
        var index_kind source.kind = TypePredicateKindIdentifier
        if source.kind = TypePredicateKindAssertsIdentifier
            set index_kind: true
        if index_kind
        {
            if source.parameter_index <> target.parameter_index
                return false
        }
        ; `source.t == target.t` answers TRUE — including two nils, which is a
        ; predicate pair with no type on either side.
        if source.t = target.t
            return true
        if source.t = null
            return false
        if target.t = null
            return false
        this.compare_types_by_comparer(comparer, source.t as ref[Type], target.t as ref[Type])
    }

    ; ── slice 124: compareSignaturesRelated ───────────────────────────────────
    ;
    ; ★★★ THE LARGEST UNPORTED FUNCTION IN relater.go (183 reference lines), and
    ; what stood on it is `get-signatures-of-symbol` — the frontier's row for
    ; TS2394, *this overload signature is not compatible with its implementation
    ; signature*, which is `isImplementationCompatibleWithOverload` over
    ; `isSignatureAssignableTo` over this.
    ;
    ; ★★★ THREE PARAMETERS OF THE REFERENCE'S SEVEN ARE DROPPED AND EACH FOR A
    ; MEASURED REASON, not for brevity. `reportErrors` and `errorReporter` are
    ; FALSE and nil at the one caller this port has (isSignatureAssignableTo), and
    ; the reporter writes into the relater's error CHAIN, which this port has no
    ; writer for — so every `if reportErrors { errorReporter(...) }` here would be
    ; a call with no callee. `reportUnreliableMarkers` is a TypeMapper: NIL under the
    ; Assignable comparer and the relater's reportUnreliableMapper under the
    ; RelaterWorker one, so the body derives it from `comparer` (the note that said
    ; it was nil at every caller expired with slice 130's reliability mapper).
    ; All three arrive with signatureRelatedTo, the relater's own caller.
    ;
    ; ★★ Ternary collapses to bool on the file's own rule (see check_type_related_to
    ; ex's header): every test upstream is `!= TernaryFalse` and `result &= related`
    ; over values that are only False or not-False is a conjunction.
    procedure compare_signatures_related(this, source_in: ref[Signature], target_in: ref[Signature], check_mode: int, comparer: int) returns bool
        this.compare_signatures_related_ex(source_in, target_in, check_mode, comparer, false)

    procedure compare_signatures_related_ex(this, source_in: ref[Signature], target_in: ref[Signature], check_mode: int, comparer: int, report_errors: bool) returns bool
    {
        ; ★★ THE TWO ARE REBOUND HALFWAY DOWN, WHICH IS WHY THEY ARE LOCALS AND NOT
        ; THE PARAMETERS (slice 145). The generic block below replaces `target` by
        ; its CANONICAL signature and `source` by the instantiation inferred in that
        ; target's context, and everything after it — the parameter loop, the rest
        ; types, the return comparison — reads the REPLACEMENTS. Reading the
        ; parameters there would compare the uninstantiated pair, which is exactly
        ; the answer the stop that stood here avoided giving.
        var source: ref[Signature] source_in
        var target: ref[Signature] target_in
        if source = target
            return true
        let mark this.unported_mark()
        ; The TOP-signature pair. `!(strictTop && isTop(source)) && isTop(target)`
        ; answers TRUE, and with StrictTopSignature set a top SOURCE against a
        ; non-top target answers FALSE.
        var strict_top (check_mode & SignatureCheckModeStrictTopSignature) <> 0
        var source_is_top false
        if strict_top
        {
            set source_is_top: this.is_top_signature(source)
            if this.unported_mark() <> mark
                return false
        }
        var left_guard true
        if strict_top
        {
            if source_is_top
                set left_guard: false
        }
        let target_is_top this.is_top_signature(target)
        if this.unported_mark() <> mark
            return false
        if left_guard
        {
            if target_is_top
                return true
        }
        if strict_top
        {
            if source_is_top
            {
                if target_is_top = false
                    return false
            }
        }
        let target_count this.get_parameter_count(target)
        if this.unported_mark() <> mark
            return false
        var source_has_more_parameters false
        let target_has_rest this.has_effective_rest_parameter(target)
        if this.unported_mark() <> mark
            return false
        if target_has_rest = false
        {
            if (check_mode & SignatureCheckModeStrictArity) <> 0
            {
                let source_has_rest this.has_effective_rest_parameter(source)
                if this.unported_mark() <> mark
                    return false
                if source_has_rest
                    set source_has_more_parameters: true
                else
                {
                    if this.get_parameter_count(source) > target_count
                        set source_has_more_parameters: true
                }
            }
            else
            {
                if this.get_min_argument_count(source) > target_count
                    set source_has_more_parameters: true
            }
            if this.unported_mark() <> mark
                return false
        }
        if source_has_more_parameters
            return false
        ; ★★★ THE GENERIC RE-INSTANTIATION, SLICE 145. The stop that stood here said
        ; the chapter *changes which SIGNATURE is compared and not only the answer*,
        ; and that is literally what the two lines do: the TARGET becomes its
        ; canonical form and the SOURCE becomes the instantiation inferred against
        ; that canonical target, so the rest of the function compares a pair neither
        ; caller passed.
        ;
        ; ★ `compareTypes` travels as the comparer TAG this port already threads, so
        ; the reference's TypeComparer func value needs nothing new here.
        if Checker.type_parameter_count_of_signature(source) <> 0
        {
            if Checker.same_type_parameters(source, target) = false
            {
                let canonical this.get_canonical_signature(target)
                if this.unported_mark() <> mark
                    return false
                if canonical = null
                    return false
                set target: canonical as ref[Signature]
                let instantiated this.instantiate_signature_in_context_of(source, target, null, comparer)
                if this.unported_mark() <> mark
                    return false
                if instantiated = null
                    return false
                set source: instantiated as ref[Signature]
            }
        }
        let source_count this.get_parameter_count(source)
        let source_rest_type this.get_non_array_rest_type(source)
        let target_rest_type this.get_non_array_rest_type(target)
        if this.unported_mark() <> mark
            return false
        ; `instantiateType(sourceRestType ?? targetRestType, reportUnreliableMarkers)`: the
        ; mapper is the relater's reportUnreliableMapper under the RelaterWorker comparer
        ; and nil under the Assignable one (isSignatureAssignableTo), so only the first
        ; comparer marks — a rest parameter of generic tuple type makes the type
        ; parameter's variance UNRELIABLE, which is what lets the structural fallback run
        if comparer = SignatureComparerRelaterWorker
        {
            var rest_marker source_rest_type
            if rest_marker = null
                set rest_marker: target_rest_type
            if rest_marker <> null
                this.instantiate_type(rest_marker as ref[Type], this.new_reliability_mapper(false))
        }
        var kind KindUnknown
        if target.declaration <> null
            set kind: AstNode.kind_of(target.declaration as ref[AstNode])
        var strict_variance false
        if (check_mode & SignatureCheckModeCallback) = 0
        {
            if Checker.strict_function_types()
            {
                if kind <> KindMethodDeclaration
                {
                    if kind <> KindMethodSignature
                    {
                        if kind <> KindConstructor
                            set strict_variance: true
                    }
                }
            }
        }
        var result true
        ; The `this` types. *void sources are assignable to anything*, which is why
        ; a void source this-type skips the comparison entirely.
        let source_this_type this.get_this_type_of_signature(source)
        if this.unported_mark() <> mark
            return false
        if source_this_type <> null
        {
            if (source_this_type as ref[Type]) <> void_type
            {
                let target_this_type this.get_this_type_of_signature(target)
                if this.unported_mark() <> mark
                    return false
                if target_this_type <> null
                {
                    let stt source_this_type as ref[Type]
                    let ttt target_this_type as ref[Type]
                    var related false
                    if strict_variance = false
                        set related: this.compare_types_by_comparer(comparer, stt, ttt)
                    if this.unported_mark() <> mark
                        return false
                    if related = false
                    {
                        set related: this.compare_types_by_comparer(comparer, ttt, stt)
                        if this.unported_mark() <> mark
                            return false
                    }
                    if related = false
                        return false
                }
            }
        }
        var param_count 0
        var rest_index 0 - 1
        if source_rest_type <> null
            set rest_index: 0
        if target_rest_type <> null
            set rest_index: 0
        if rest_index = 0
        {
            set param_count: source_count
            if target_count < param_count
                set param_count: target_count
            set rest_index: param_count - 1
        }
        else
        {
            set param_count: source_count
            if target_count > param_count
                set param_count: target_count
            set rest_index: 0 - 1
        }
        var i 0
        while i < param_count
        {
            var source_type null as ref[Type]?
            var target_type null as ref[Type]?
            if i = rest_index
            {
                set source_type: this.get_rest_or_any_type_at_position(source, i)
                set target_type: this.get_rest_or_any_type_at_position(target, i)
            }
            else
            {
                set source_type: this.try_get_type_at_position(source, i)
                set target_type: this.try_get_type_at_position(target, i)
            }
            if this.unported_mark() <> mark
                return false
            set i: i + 1
            if source_type = null
                continue
            if target_type = null
                continue
            let st source_type as ref[Type]
            let tt target_type as ref[Type]
            var compare true
            if st = tt
            {
                if (check_mode & SignatureCheckModeStrictArity) = 0
                    set compare: false
            }
            if compare = false
                continue
            let pos i - 1
            ; The CALLBACK shortcut, and the reference's comment is the whole
            ; argument: two parameters that are both single-call-signature
            ; function types are CALLBACKS, and a callback parameter is an OUTPUT
            ; position — so relating them co-variantly is enough and keeps
            ; `Promise<T>` co-variant in T.
            var source_sig null as ref[Signature]?
            var target_sig null as ref[Signature]?
            if (check_mode & SignatureCheckModeCallback) = 0
            {
                if this.is_instantiated_generic_parameter(source, pos) = false
                {
                    let nn this.get_non_nullable_type(st)
                    if this.unported_mark() <> mark
                        return false
                    if nn <> null
                        set source_sig: this.get_single_call_signature(nn as ref[Type])
                }
                if this.is_instantiated_generic_parameter(target, pos) = false
                {
                    let nn this.get_non_nullable_type(tt)
                    if this.unported_mark() <> mark
                        return false
                    if nn <> null
                        set target_sig: this.get_single_call_signature(nn as ref[Type])
                }
                if this.unported_mark() <> mark
                    return false
            }
            var callbacks false
            if source_sig <> null
            {
                if target_sig <> null
                {
                    if this.get_type_predicate_of_signature(source_sig as ref[Signature]) = null
                    {
                        if this.get_type_predicate_of_signature(target_sig as ref[Signature]) = null
                        {
                            if this.get_type_facts(st, TypeFactsIsUndefinedOrNull) = this.get_type_facts(tt, TypeFactsIsUndefinedOrNull)
                                set callbacks: true
                        }
                    }
                    if this.unported_mark() <> mark
                        return false
                }
            }
            var related false
            if callbacks
            {
                var inner check_mode & SignatureCheckModeStrictArity
                if strict_variance
                    set inner: inner | SignatureCheckModeStrictCallback
                else
                    set inner: inner | SignatureCheckModeBivariantCallback
                set related: this.compare_signatures_related_ex(target_sig as ref[Signature], source_sig as ref[Signature], inner, comparer, report_errors)
                if this.unported_mark() <> mark
                    return false
            }
            else
            {
                if (check_mode & SignatureCheckModeCallback) = 0
                {
                    if strict_variance = false
                        set related: this.compare_types_by_comparer(comparer, st, tt)
                }
                if this.unported_mark() <> mark
                    return false
                if related = false
                {
                    set related: this.compare_types_by_comparer_ex(comparer, tt, st, report_errors)
                    if this.unported_mark() <> mark
                        return false
                }
            }
            ; *With strict arity, `(x: number | undefined) => void` is a subtype of
            ; `(x?: number | undefined) => void`* — an OPTIONAL target parameter
            ; that the source requires is refused there.
            if related
            {
                if (check_mode & SignatureCheckModeStrictArity) <> 0
                {
                    if pos >= this.get_min_argument_count(source)
                    {
                        if pos < this.get_min_argument_count(target)
                        {
                            if this.compare_types_by_comparer(comparer, st, tt)
                                set related: false
                        }
                    }
                    if this.unported_mark() <> mark
                        return false
                }
            }
            if related = false
            {
                ; `errorReporter(Types_of_parameters_0_and_1_are_incompatible, …)` —
                ; the chain link the signature chapter dropped until slice 294. It is
                ; PREPENDED after the nested relation has reported, so it prints
                ; above what that relation said, which is the baseline's nesting.
                if report_errors
                    this.report_error(DiagTypes_of_parameters_0_and_1_are_incompatible, null, null, Checker.arg_text(this.get_parameter_name_at_position(source, pos)), Checker.arg_text(this.get_parameter_name_at_position(target, pos)))
                return false
            }
        }
        if (check_mode & SignatureCheckModeIgnoreReturnTypes) <> 0
            return result
        let target_return_type this.get_non_circular_return_type_of_signature(target)
        if this.unported_mark() <> mark
            return false
        if target_return_type = null
            return false
        let trt target_return_type as ref[Type]
        if trt = void_type
            return result
        if trt = any_type
            return result
        let source_return_type this.get_non_circular_return_type_of_signature(source)
        if this.unported_mark() <> mark
            return false
        if source_return_type = null
            return false
        let srt source_return_type as ref[Type]
        ; *The following block preserves behavior forbidding boolean returning
        ; functions from being assignable to type guard returning functions.*
        let target_predicate this.get_type_predicate_of_signature(target)
        if this.unported_mark() <> mark
            return false
        if target_predicate <> null
        {
            let source_predicate this.get_type_predicate_of_signature(source)
            if this.unported_mark() <> mark
                return false
            if source_predicate <> null
            {
                let ok this.compare_type_predicate_related_to(source_predicate as ref[TypePredicate], target_predicate as ref[TypePredicate], comparer)
                if this.unported_mark() <> mark
                    return false
                if ok = false
                    return false
                return result
            }
            let tk (target_predicate as ref[TypePredicate]).kind
            if tk = TypePredicateKindIdentifier
                return false
            if tk = TypePredicateKindThis
                return false
            return result
        }
        ; *When relating callback signatures, we still need to relate return types
        ; bi-variantly as otherwise the containing type wouldn't be co-variant.*
        var related false
        if (check_mode & SignatureCheckModeBivariantCallback) <> 0
            set related: this.compare_types_by_comparer(comparer, trt, srt)
        if this.unported_mark() <> mark
            return false
        if related = false
        {
            set related: this.compare_types_by_comparer(comparer, srt, trt)
            if this.unported_mark() <> mark
                return false
        }
        related
    }

    ; `core.Same(source.typeParameters, target.typeParameters)` — the same SLICE,
    ; which for two distinct arrays is element identity over an equal length.
    function same_type_parameters(source: ref[Signature], target: ref[Signature]) returns bool
    {
        let sn Checker.type_parameter_count_of_signature(source)
        let tn Checker.type_parameter_count_of_signature(target)
        if sn <> tn
            return false
        if sn = 0
            return true
        let sl source.type_parameters as ref[Array[ref[Type]?]]
        let tl target.type_parameters as ref[Array[ref[Type]?]]
        var i 0
        while i < sn
        {
            let a sl[i]
            let b2 tl[i]
            if a = null
                return false
            if b2 = null
                return false
            if (a as ref[Type]) <> (b2 as ref[Type])
                return false
            set i: i + 1
        }
        true
    }

    ; isSignatureAssignableTo.
    procedure is_signature_assignable_to(this, source: ref[Signature], target: ref[Signature], ignore_return_types: bool) returns bool
    {
        var mode SignatureCheckModeNone
        if ignore_return_types
            set mode: SignatureCheckModeIgnoreReturnTypes
        this.compare_signatures_related(source, target, mode, SignatureComparerAssignable)
    }

    ; isImplementationCompatibleWithOverload — TS2394's question. ★*First see if
    ; the return types are compatible in either direction*, and only then compare
    ; the parameters with the return types IGNORED, which is why the relation is
    ; asked three times here.
    procedure is_implementation_compatible_with_overload(this, implementation: ref[Signature], overload: ref[Signature]) returns bool
    {
        let mark this.unported_mark()
        let erased_source this.get_erased_signature(implementation)
        let erased_target this.get_erased_signature(overload)
        if this.unported_mark() <> mark
            return false
        if erased_source = null
            return false
        if erased_target = null
            return false
        let es erased_source as ref[Signature]
        let et erased_target as ref[Signature]
        let source_return_type this.get_return_type_of_signature(es)
        let target_return_type this.get_return_type_of_signature(et)
        if this.unported_mark() <> mark
            return false
        if source_return_type = null
            return false
        if target_return_type = null
            return false
        let srt source_return_type as ref[Type]
        let trt target_return_type as ref[Type]
        var compatible trt = void_type
        if compatible = false
        {
            if this.is_type_related_to(trt, srt, RelationAssignable)
                set compatible: true
            else
            {
                if this.is_type_related_to(srt, trt, RelationAssignable)
                    set compatible: true
            }
            if this.unported_mark() <> mark
                return false
        }
        if compatible = false
            return false
        this.is_signature_assignable_to(es, et, true)
    }

    ; getSelectedModifierFlags — `node.ModifierFlags() & flags`.
    function get_selected_modifier_flags(this, node: ref[AstNode], flags: int) returns int
        b.combined_modifier_flags(node) & flags

    ; ── slice 124: typeHasProtectedAccessibleBase ─────────────────────────────
    ;
    ; *A private or protected constructor can only be instantiated within its own
    ; class (or a subclass, for protected)* — this walks the base chain looking for
    ; the declaring class. ★★The INTERSECTION arm skips MIXIN constructors, which is
    ; what `findMixins` is for: an intersection of mixins has no single declaring
    ; class and counting one would make a protected constructor reachable from
    ; anywhere a mixin is applied.
    procedure type_has_protected_accessible_base(this, target: ref[Symbol], t: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        let target_type Checker.get_target_type(t)
        let base_types this.get_base_types(target_type)
        if this.unported_mark() <> mark
            return false
        if base_types = null
            return false
        let list base_types as ref[Array[ref[Type]?]]
        if (list.get_length() as int) = 0
            return false
        let first_row list[0]
        if first_row = null
            return false
        let first_base first_row as ref[Type]
        if (first_base.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(first_base)
            if types = null
                return false
            let tl types as ref[Array[ref[Type]?]]
            let n tl.get_length() as int
            let mixin_flags this.find_mixins(tl)
            if this.unported_mark() <> mark
                return false
            if mixin_flags = null
                return false
            let mf mixin_flags as ref[Array[bool]]
            var i 0
            while i < n
            {
                let row tl[i]
                let is_mixin mf[i]
                set i: i + 1
                if row = null
                    continue
                if is_mixin
                    continue
                let member row as ref[Type]
                if (member.object_flags & (ObjectFlagsClass | ObjectFlagsInterface)) = 0
                    continue
                if member.symbol <> null
                {
                    if (member.symbol as ref[Symbol]) = target
                        return true
                }
                if this.type_has_protected_accessible_base(target, member)
                    return true
                if this.unported_mark() <> mark
                    return false
            }
            return false
        }
        if first_base.symbol <> null
        {
            if (first_base.symbol as ref[Symbol]) = target
                return true
        }
        this.type_has_protected_accessible_base(target, first_base)
    }

    ; findMixins, reduced to the FLAG LIST — its second answer (`mixinCount`) has no
    ; reader here, and its one caller in this slice reads only the flags.
    ;
    ; ★★ THE LAST STEP IS THE POINT: *if every constructor type in the
    ; intersection is a mixin, the FIRST one is not treated as one* — an
    ; intersection made entirely of mixins still has a base, and it is the first.
    procedure find_mixins(this, types: ref[Array[ref[Type]?]]) returns ref[Array[bool]]?
    {
        let mark this.unported_mark()
        let n types.get_length() as int
        let flags &Array[bool]^host()
        let out flags as ref[Array[bool]]
        var constructor_type_count 0
        var mixin_count 0
        var first_mixin_index 0 - 1
        var i 0
        while i < n
        {
            let row types[i]
            var is_mixin false
            if row <> null
            {
                let t row as ref[Type]
                set is_mixin: this.is_mixin_constructor_type(t)
                let sigs this.get_signatures_of_type(t, SignatureKindConstruct)
                if this.unported_mark() <> mark
                    return null
                if sigs <> null
                {
                    if ((sigs as ref[Array[ref[Signature]?]]).get_length() as int) > 0
                        set constructor_type_count: constructor_type_count + 1
                }
            }
            out.add(is_mixin)
            if is_mixin
            {
                if first_mixin_index < 0
                    set first_mixin_index: i
                set mixin_count: mixin_count + 1
            }
            set i: i + 1
        }
        if constructor_type_count > 0
        {
            if constructor_type_count = mixin_count
                out.put(first_mixin_index as size_t, false)
        }
        out
    }

    ; ── slice 124: isConstructorAccessible ────────────────────────────────────
    ;
    ; ★★★ THE ROW IT CLOSES WAS THE FRONTIER'S FOURTH (32 units, 11 of them blocked
    ; by nothing else), and the old note named the four things behind it: this
    ; function, the abstract-class pair (TS2511 twice) and then resolveCall over the
    ; CONSTRUCT signatures. All four land here.
    ;
    ; ★ *Public constructors and constructor functions are always accessible* — the
    ; reference's own comment on the second guard, which is why a non-constructor
    ; declaration (a plain function used with `new`) short-circuits to true.
    procedure is_constructor_accessible(this, node: ref[AstNode], signature: ref[Signature]?) returns bool
    {
        if signature = null
            return true
        let sig signature as ref[Signature]
        if sig.declaration = null
            return true
        let declaration sig.declaration as ref[AstNode]
        let modifiers this.get_selected_modifier_flags(declaration, ModifierFlagsNonPublicAccessibilityModifier)
        if modifiers = 0
            return true
        if AstNode.kind_of(declaration) <> KindConstructor
            return true
        let parent AstNode.parent_node_of(declaration)
        if parent = null
            return true
        let parent_symbol AstNode.symbol_of(parent as ref[AstNode])
        if parent_symbol = null
            return true
        let ps parent_symbol as ref[Symbol]
        let declaring_class_declaration Checker.get_class_like_declaration_of_symbol(ps)
        ; `declaringClass := c.getDeclaredTypeOfSymbol(declaration.Parent.Symbol())`
        ; — computed HERE upstream, ahead of the isNodeWithinClass test, and only
        ; ever read by the two reports below. See name_type_for_message.
        let mark this.unported_mark()
        let declaring_class this.get_declared_type_of_symbol(ps)
        if this.is_node_within_class(node, declaring_class_declaration)
            return true
        let containing_class Checker.get_containing_class(node)
        if containing_class <> null
        {
            if (modifiers & ModifierFlagsProtected) <> 0
            {
                let cs AstNode.symbol_of(containing_class as ref[AstNode])
                if cs <> null
                {
                    let containing_type this.get_declared_type_of_symbol(cs as ref[Symbol])
                    if this.unported_mark() <> mark
                        return false
                    if containing_type <> null
                    {
                        if this.type_has_protected_accessible_base(ps, containing_type as ref[Type])
                            return true
                        if this.unported_mark() <> mark
                            return false
                    }
                }
            }
        }
        if (modifiers & ModifierFlagsPrivate) <> 0
        {
            let name_arg15 this.type_arg(declaring_class)
            this.error_on_node(node, DiagConstructor_of_class_0_is_private_and_only_accessible_within_the_class_declaration, name_arg15)
        }
        if (modifiers & ModifierFlagsProtected) <> 0
        {
            let name_arg16 this.type_arg(declaring_class)
            this.error_on_node(node, DiagConstructor_of_class_0_is_protected_and_only_accessible_within_the_class_declaration, name_arg16)
        }
        false
    }

    ; someSignature — `core.Some` over the signatures. ★The predicate is fixed at
    ; the one call site (`flags & Abstract`), so it is inlined per §3.18 rather than
    ; passed.
    ;
    ; ★★★ THE COMPOSITE DESCENT ARRIVED IN SLICE 155 WITH THE SLOT, and upstream's
    ; shape is an EITHER-OR rather than an extra test: a composite UNION signature
    ; is asked about its MEMBERS and NOT about itself, because its own flags are
    ; the propagated fold and `Abstract` propagates. A composite INTERSECTION falls
    ; through to neither half upstream (`composite != nil && composite.isUnion` is
    ; false, and so is `composite == nil`), which is a shape this port reproduces
    ; rather than repairs.
    function some_signature_is_abstract(this, signatures: ref[Array[ref[Signature]?]]) returns bool
    {
        let n signatures.get_length() as int
        var i 0
        while i < n
        {
            let row signatures[i]
            set i: i + 1
            if row = null
                continue
            let sig row as ref[Signature]
            if sig.composite <> null
            {
                let comp sig.composite as ref[CompositeSignature]
                if comp.is_union
                {
                    if comp.signatures <> null
                    {
                        let inner comp.signatures as ref[Array[ref[Signature]?]]
                        let m inner.get_length() as int
                        var j 0
                        while j < m
                        {
                            let irow inner[j]
                            set j: j + 1
                            if irow = null
                                continue
                            if ((irow as ref[Signature]).flags & SignatureFlagsAbstract) <> 0
                                return true
                        }
                    }
                }
                continue
            }
            if (sig.flags & SignatureFlagsAbstract) <> 0
                return true
        }
        false
    }

    ; isValidBaseType — what `extends` and `implements` will accept. ★The
    ; TYPE-PARAMETER arm recurses on the base CONSTRAINT and then FALLS THROUGH to
    ; the flag test rather than returning it, which is the reference's shape: a `T`
    ; with no constraint is still judged on its own flags.
    procedure is_valid_base_type(this, t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsTypeParameter) <> 0
        {
            let mark this.unported_mark()
            let constraint this.get_base_constraint_of_type(t)
            if this.unported_mark() <> mark
                return false
            if constraint <> null
                return this.is_valid_base_type(constraint as ref[Type])
        }
        if (t.flags & (TypeFlagsObject | TypeFlagsNonPrimitive | TypeFlagsAny)) <> 0
        {
            if this.is_generic_mapped_type(t) = false
                return true
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return false
                if this.is_valid_base_type(row as ref[Type]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        false
    }

    ; isPrototypeProperty — a METHOD, or a synthetic one.
    function is_prototype_property(s: ref[Symbol]) returns bool
    {
        if (Symbol.flags_of(s) & SymbolFlagsMethod) <> 0
            return true
        (Symbol.check_flags_of(s) & CheckFlagsSyntheticMethod) <> 0
    }

    ; arePropertiesAbstractOrInterface / isPropertyAbstractOrInterface — *for
    ; intersection properties this must be true of ANY of the declarations, for
    ; others of ALL of them*, which is the reference's own comment and the reason
    ; the two functions exist rather than one loop.
    ; ★★★ THE ABSTRACT HALF IS A CONJUNCTION AND ONLY ITS FIRST CONJUNCT WAS HERE.
    ; `baseDeclarationFlags&Abstract != 0 && (!IsPropertyDeclaration(d) ||
    ; d.Initializer() == nil)` — an abstract class's INITIALIZED property
    ; declaration is not exempt, and reading the flag alone exempted it.
    function is_property_abstract_or_interface(this, declaration: ref[AstNode], base_declaration_flags: int) returns bool
    {
        let parent AstNode.parent_node_of(declaration)
        if parent <> null
        {
            if AstNode.kind_of(parent as ref[AstNode]) = KindInterfaceDeclaration
                return true
        }
        if (base_declaration_flags & ModifierFlagsAbstract) = 0
            return false
        if AstNode.kind_of(declaration) <> KindPropertyDeclaration
            return true
        AstNode.initializer_of(declaration) = null
    }

    ; ★★★ THE SYNTHETIC FORK IS THE WHOLE POINT OF THERE BEING TWO FUNCTIONS, AND
    ; THE COMMENT ABOVE QUOTED IT WHILE THE BODY DID NOT: `core.Some` for a
    ; SYNTHETIC (intersection) property, `core.Every` for every other. A class
    ; extending a mixin's `TBase & (new (…) => I)` inherits its members as
    ; synthetic intersection properties whose declarations come from both sides,
    ; so the ALL reading refused the exemption the interface half grants and the
    ; accessor override below reported a TS2611 the reference does not
    ; (`accessorsOverrideProperty9`). ★An empty declaration list is Every's TRUE
    ; and Some's FALSE, which is the one place the two loops differ past the fork.
    function are_properties_abstract_or_interface(this, base: ref[Symbol], base_declaration_flags: int) returns bool
    {
        let n Symbol.declaration_count(base)
        let synthetic (Symbol.check_flags_of(base) & CheckFlagsSynthetic) <> 0
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(base, i)
            if d = null
                return false
            let one this.is_property_abstract_or_interface(d as ref[AstNode], base_declaration_flags)
            if synthetic
            {
                if one
                    return true
            }
            else
            {
                if one = false
                    return false
            }
            set i: i + 1
        }
        if synthetic
            return false
        true
    }

    ; checkBaseTypeAccessibility — `class D extends C` where C's constructor is
    ; private, TS2675. ★getFullyQualifiedName is a message ARGUMENT and the dump
    ; carries pos/end/code, so it is not asked.
    procedure check_base_type_accessibility(this, t: ref[Type], node: ref[AstNode])
    {
        let mark this.unported_mark()
        let signatures this.get_signatures_of_type(t, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return
        if signatures = null
            return
        let list signatures as ref[Array[ref[Signature]?]]
        if (list.get_length() as int) = 0
            return
        let first list[0]
        if first = null
            return
        let declaration (first as ref[Signature]).declaration
        if declaration = null
            return
        if (b.combined_modifier_flags(declaration as ref[AstNode]) & ModifierFlagsPrivate) = 0
            return
        if t.symbol = null
            return
        let type_class_declaration Checker.get_class_like_declaration_of_symbol(t.symbol as ref[Symbol])
        if this.is_node_within_class(node, type_class_declaration) = false
            this.error_on_node(node, DiagCannot_extend_a_class_0_Class_constructor_is_marked_as_private, this.fully_qualified_name_arg(t.symbol as ref[Symbol]))
    }

    ; getTypeWithoutSignatures — the STATIC side's assignability is checked against
    ; a base whose construct signatures are removed, because a derived class need
    ; not repeat the base's constructor. ★The intersection arm maps the function
    ; over the members and is written; the object arm's `newObjectType` copy keeps
    ; the members and properties and drops the signatures and index infos.
    procedure get_type_without_signatures(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsObject) <> 0
        {
            let mark this.unported_mark()
            let resolved this.resolve_structured_type_members(t)
            if this.unported_mark() <> mark
                return null
            if resolved = null
                return null
            let d resolved as ref[StructuredMembers]
            var sig_count 0
            if d.signatures <> null
                set sig_count: (d.signatures as ref[Array[ref[Signature]?]]).get_length() as int
            if sig_count = 0
                return t
            let made this.new_object_type(ObjectFlagsAnonymous, t.symbol)
            if made = null
                return null
            let result made as ref[Type]
            ; `result.members = resolved.members; result.properties =
            ; resolved.properties` — the port's setter recomputes the properties
            ; from the members table, which is what getNamedMembers gave the
            ; resolved record in the first place. ★No signatures and no index
            ; infos, which is the whole point of the function.
            this.set_structured_type_members(result, d.members, null, null, null)
            return result
        }
        if (t.flags & TypeFlagsIntersection) <> 0
        {
            let types Checker.union_or_intersection_types_of(t)
            if types = null
                return null
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            let out &Array[ref[Type]?]()
            var i 0
            while i < n
            {
                let row list[i]
                if row = null
                    return null
                let w this.get_type_without_signatures(row as ref[Type])
                if w = null
                    return null
                out.add(w)
                set i: i + 1
            }
            return this.get_intersection_type(out)
        }
        t
    }

    ; getConstructorsForTypeArguments / getInstantiatedConstructorsForTypeArguments
    ; — the construct signatures a given number of type arguments can satisfy, and
    ; then those signatures instantiated with them.
    procedure get_constructors_for_type_arguments(this, t: ref[Type], type_argument_nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[Signature]?]]?
    {
        let mark this.unported_mark()
        let signatures this.get_signatures_of_type(t, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return null
        ; A type with no construct signatures — `any` as a base — answers the
        ; EMPTY list, not a refusal: the class check's `forEach(constructors, …)`
        ; over it is simply empty, and returning null there skipped every check
        ; after it, checkPropertyInitialization included (slice 202,
        ; `classExtendingAny`).
        if signatures = null
            return this.new_signature_list()
        let type_arg_count AstNode.list_count(type_argument_nodes)
        let list signatures as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        let out this.new_signature_list()
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let sig row as ref[Signature]
                let tps sig.type_parameters
                var tp_count 0
                var min_count 0
                if tps <> null
                {
                    let tpl tps as ref[Array[ref[Type]?]]
                    set tp_count: tpl.get_length() as int
                    set min_count: this.get_min_type_argument_count(tpl)
                }
                if type_arg_count >= min_count
                {
                    if type_arg_count <= tp_count
                        out.add(sig)
                }
            }
            set i: i + 1
        }
        out
    }

    procedure get_instantiated_constructors_for_type_arguments(this, t: ref[Type], type_argument_nodes: ref[Array[ref[AstNode]?]]?, location: ref[AstNode]) returns ref[Array[ref[Signature]?]]?
    {
        let mark this.unported_mark()
        let signatures this.get_constructors_for_type_arguments(t, type_argument_nodes)
        if signatures = null
            return null
        let type_arguments this.type_list_from_nodes(type_argument_nodes)
        if type_arguments = null
            return null
        if this.unported_mark() <> mark
            return null
        let args type_arguments as ref[Array[ref[Type]?]]
        let list signatures as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        let out this.new_signature_list()
        let is_js (AstNode.flags_of(location) & NodeFlagsJavaScriptFile) <> 0
        var i 0
        while i < n
        {
            let row list[i]
            if row = null
                return null
            let sig row as ref[Signature]
            var tp_count 0
            if sig.type_parameters <> null
                set tp_count: (sig.type_parameters as ref[Array[ref[Type]?]]).get_length() as int
            if tp_count = 0
                out.add(sig)
            else
            {
                let inst this.get_signature_instantiation(sig, args, is_js, null)
                if inst = null
                    return null
                out.add(inst)
            }
            set i: i + 1
        }
        out
    }

    ; `core.Map(node.TypeArguments(), c.getTypeFromTypeNode)`, which three callers
    ; here want as a list.
    procedure type_list_from_nodes(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[Type]?]]?
    {
        let out this.new_type_list(null)
        let n AstNode.list_count(nodes)
        var i 0
        while i < n
        {
            let node AstNode.child_in_list(nodes, i)
            if node = null
                return null
            let t this.get_type_from_type_node(node as ref[AstNode])
            if t = null
                return null
            out.add(t)
            set i: i + 1
        }
        out
    }

    ; getEffectiveTypeArguments.
    procedure get_effective_type_arguments(this, node: ref[AstNode], type_parameters: ref[Array[ref[Type]?]]) returns ref[Array[ref[Type]?]]?
    {
        let args this.type_list_from_nodes(AstNode.type_arguments_of(node))
        if args = null
            return null
        let is_js (AstNode.flags_of(node) & NodeFlagsJavaScriptFile) <> 0
        this.fill_missing_type_arguments(args as ref[Array[ref[Type]?]], type_parameters, this.get_min_type_argument_count(type_parameters), is_js)
    }

    ; checkTypeArgumentConstraints — TS2344 per argument that misses its
    ; constraint. ★The `result = result && …` chain does NOT short-circuit in Go:
    ; every argument is checked and every failure reported, and the answer is the
    ; conjunction. Writing it as an early return would drop the later reports.
    procedure check_type_argument_constraints(this, node: ref[AstNode], type_parameters: ref[Array[ref[Type]?]]) returns bool
    {
        var type_arguments null as ref[Array[ref[Type]?]]?
        var mapper null as ref[TypeMapper]?
        var result true
        let mark this.unported_mark()
        let n type_parameters.get_length() as int
        var i 0
        while i < n
        {
            let row type_parameters[i]
            if row = null
                return false
            let type_parameter row as ref[Type]
            let constraint this.get_constraint_of_type_parameter(type_parameter)
            if this.unported_mark() <> mark
                return false
            if constraint <> null
            {
                if type_arguments = null
                {
                    set type_arguments: this.get_effective_type_arguments(node, type_parameters)
                    if type_arguments = null
                        return false
                    set mapper: this.new_type_mapper(type_parameters, type_arguments as ref[Array[ref[Type]?]])
                }
                let arg (type_arguments as ref[Array[ref[Type]?]])[i]
                if arg = null
                    return false
                let inst this.instantiate_type(constraint as ref[Type], mapper)
                if inst = null
                    return false
                ; `result = result && checkTypeAssignableTo(…)` SHORT-CIRCUITS: once
                ; one argument has failed its constraint the later ones are not
                ; checked and not reported (slice 202, `typedefMultipleTypeParameters`).
                if result
                {
                    let error_node AstNode.child_in_list(AstNode.type_arguments_of(node), i)
                    let ok this.check_type_assignable_to(arg as ref[Type], inst as ref[Type], error_node, DiagType_0_does_not_satisfy_the_constraint_1)
                    if this.unported_mark() <> mark
                        return false
                    if ok = false
                        set result: false
                }
            }
            set i: i + 1
        }
        result
    }

    ; issueMemberSpecificError — *iterate over all implemented properties and issue
    ; errors on each one which isn't compatible, rather than the class as a whole,
    ; if possible*, which is the reference's own comment and the whole shape.
    ;
    ; ★★★ THE PER-MEMBER REPORT IS A CHAIN UPSTREAM AND A SINGLE LINE HERE, and the
    ; CODE is what makes that exact rather than approximate: the reference wraps the
    ; relation's diagnostics in `Property_0_in_type_1_is_not_assignable_to_the_same_
    ; property_in_base_type_2` (TS2416), which becomes the emitted diagnostic's
    ; code, and the relation's own message becomes a nested child the dump does not
    ; carry. So TS2416 at the member's name is the whole observable product — which
    ; is exactly what a head message gives.
    procedure issue_member_specific_error(this, node: ref[AstNode], type_with_this: ref[Type], base_with_this: ref[Type], broad_code: int)
    {
        var issued_member_error false
        let mark this.unported_mark()
        let members AstNode.member_list_of(node)
        let mn AstNode.list_count(members)
        var i 0
        while i < mn
        {
            let m AstNode.child_in_list(members, i)
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if b.is_static(member)
                continue
            let declared_prop this.get_symbol_of_declaration(member)
            if declared_prop = null
                continue
            let dp declared_prop as ref[Symbol]
            if this.symbol_name_is_computed(dp)
                continue
            let nd Symbol.name_of(dp)
            let nl Symbol.name_len_of(dp)
            let prop this.get_property_of_type(type_with_this, nd)
            let base_prop this.get_property_of_type(base_with_this, nd)
            if this.unported_mark() <> mark
                return
            if prop = null
                continue
            if base_prop = null
                continue
            let pt this.get_type_of_symbol(prop as ref[Symbol])
            let bt this.get_type_of_symbol(base_prop as ref[Symbol])
            if this.unported_mark() <> mark
                return
            if pt = null
                continue
            if bt = null
                continue
            var error_node AstNode.name_of(member)
            if error_node = null
                set error_node: member
            ; `checkTypeAssignableToEx(…, nil /*headMessage*/, &diags)` then ONE TS2416 wrapping
            ; `diags[0]` — the private list is §3.24's mark + truncate, and a HEAD MESSAGE is not
            ; the same thing (the relation would suppress it beside a matching missing-property
            ; row and TS2739 would surface instead; slice 209, `incompatibleTypes`)
            let diag_mark diagnostics.length()
            let ok this.check_type_assignable_to(pt as ref[Type], bt as ref[Type], error_node, 0)
            if this.unported_mark() <> mark
                return
            if ok = false
            {
                let prop_name this.symbol_arg(declared_prop)
                let this_name this.type_arg(type_with_this)
                let base_name this.type_arg(base_with_this)
                let head_args this.message_args()
                head_args.add(prop_name)
                head_args.add(this_name)
                head_args.add(base_name)
                if diagnostics.rehead_since(diag_mark, DiagProperty_0_in_type_1_is_not_assignable_to_the_same_property_in_base_type_2, head_args) = false
                    this.error_on_node_or_null(error_node, DiagProperty_0_in_type_1_is_not_assignable_to_the_same_property_in_base_type_2, prop_name, this_name, base_name)
                set issued_member_error: true
            }
        }
        if issued_member_error
            return
        var error_node AstNode.name_of(node)
        if error_node = null
            set error_node: node
        this.check_type_assignable_to(type_with_this, base_with_this, error_node, broad_code)
    }

    ; `symbol.Name != ast.InternalSymbolNameComputed`, the guard issueMemberSpecific
    ; Error and lateBindMember share.
    procedure symbol_name_is_computed(this, s: ref[Symbol]) returns bool
    {
        var cd Slice[char]()
        set cd: Binder.internal_name(host, "computed")
        SymbolTable.names_equal(Symbol.name_of(s), cd)
    }

    ; ── slice 124: checkClassExpression, checkClassExpressionDeferred ─────────
    ;
    ; ★★★ IT IS checkClassLikeDeclaration's SECOND CALLER, which is what the note
    ; on that function predicted (*"the next slice that reaches this file"*), and
    ; the whole of the class expression is these four lines: the shared declaration
    ; check, a DEFERRED registration for the members, the emit-helper check and the
    ; static side's type.
    ;
    ; ★★ THE MEMBERS ARE NOT CHECKED HERE and that is the deferral, not an
    ; omission: a class expression's members are checked when the deferred queue
    ; drains, because the expression's own type must exist first (a member may
    ; refer to the class). check_deferred_nodes' switch gains the arm.
    ;
    ; ★ checkClassExpressionExternalHelpers is NOT written, per §3.5cx: its whole
    ; body ends in checkExternalEmitHelpers, which this port treats as a no-op —
    ; the helpers are an EMIT concern and neither yardstick can see one. Writing
    ; the walk up the outer expressions to reach a no-op would be two screens that
    ; cannot be wrong and cannot be right (§3.5be).
    procedure check_class_expression(this, node: ref[AstNode]) returns ref[Type]?
    {
        this.check_class_like_declaration(node)
        this.check_node_deferred(node)
        this.check_class_expression_external_helpers(node)
        let symbol this.get_symbol_of_declaration(node)
        if symbol = null
            return null
        this.get_type_of_symbol(symbol as ref[Symbol])
    }

    procedure check_class_expression_deferred(this, node: ref[AstNode])
    {
        this.check_source_elements(AstNode.member_list_of(node))
        this.register_for_unused_identifiers_check(node)
    }

    procedure check_class_like_declaration(this, node: ref[AstNode])
    {
        this.check_grammar_class_like_declaration(node)
        this.check_decorators(node)
        this.check_collisions_for_declaration_name(node, AstNode.name_of(node))
        this.check_type_parameters(AstNode.type_parameters_of(node))
        this.check_exports_on_merged_declarations(node)
        ; ★★★ SLICE 66 MOVES THE STOP ONE LINE, AND THE LINE IT MOVES TO IS THE
        ; OTHER 4 500-UNIT HEAD. checkClassLikeDeclaration reads the declared type,
        ; then `typeWithThis`, then `staticType := c.getTypeOfSymbol(symbol)` — and
        ; a class symbol carries SymbolFlagsClass, which is getTypeOfSymbol's
        ; getTypeOfFuncClassEnumModule arm. The histogram in CLAUDE.md §3.5dl
        ; measured that arm as reaching ZERO units; it reached zero because the
        ; class stopped one statement earlier, which is the same lesson slice 65
        ; wrote about a tag naming an ORDER.
        let symbol this.symbol_of_declaration(node)
        if symbol = null
            return
        let sym symbol as ref[Symbol]
        let unported_before this.unported_mark()
        let class_type this.get_declared_type_of_symbol(sym)
        if this.unported_mark() <> unported_before
            return
        if class_type = null
            return
        let type_with_this this.get_type_with_this_argument(class_type as ref[Type], null, false)
        if this.unported_mark() <> unported_before
            return
        ; ★★★ SLICE 67 MOVES THE CLASS PAST ITS STATIC SIDE. `staticType :=
        ; c.getTypeOfSymbol(symbol)` is getTypeOfFuncClassEnumModule for a class
        ; symbol — the arm §3.5dl's histogram measured as reaching ZERO units,
        ; because the class stopped one statement earlier — and for a class with
        ; no `extends` it is an anonymous object type and nothing else.
        let static_type this.get_type_of_symbol(sym)
        if this.unported_mark() <> unported_before
            return
        ; ★ No early exit after it, for the reason checkInterfaceDeclaration's own
        ; call site states in full: the procedure answers nothing and the reference
        ; has no exit there either. The guards around this one are different — each
        ; of them stands in front of a statement that READS the value above it.
        this.check_type_parameter_lists_identical(sym)
        ; ★★★ SLICE 68 MOVES THE CLASS PAST ITS OVERLOAD CHECK. A class symbol
        ; carries SymbolFlagsClass and its declaration list is what
        ; checkFunctionOrConstructorSymbol walks — a class merged with a function
        ; declaration is exactly the shape TS2814 and TS2813 are about, and the
        ; hasNonAmbientClass block is the only one of the worker's four that a class
        ; symbol can reach on its own.
        this.check_function_or_constructor_symbol(sym)
        if this.unported_mark() <> unported_before
            return
        ; ★★★ SLICE 73 MOVES THE CLASS PAST ITS DUPLICATE-MEMBER CHECK — the head
        ; of the work list on both stages (128 units at stage 1, 2 891 at stage 2).
        ; The class is the only one of the reference's three call sites that passes
        ; checkPrivateNames true, and the only one this port can reach yet.
        this.check_object_type_for_duplicate_declarations(node, true)
        if this.unported_mark() <> unported_before
            return
        ; ★★★ SLICE 74 CROSSES THE HEAD OF THE WORK LIST FOR THE PRICE OF ONE
        ; GUARD. checkClassForStaticPropertyNameConflicts returns at its own first
        ; line under this harness (see use_define_for_class_fields), so the row
        ; slice 73 left at 145 / 2 799 units is inert — and the two paths that row
        ; stood for collapse into one, because the ambient class and the plain one
        ; now arrive at the same next statement.
        let node_in_ambient_context (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
        if node_in_ambient_context = false
        {
            this.check_class_for_static_property_name_conflicts(node)
            if this.unported_mark() <> unported_before
                return
        }
        ; ── slice 124: THE EXTENDS HERITAGE BLOCK ─────────────────────────────
        ;
        ; ★★★ ELEVEN STATEMENTS, AND THE ROW THAT STOOD HERE WAS THE FRONTIER'S
        ; THIRD LARGEST (46 units, 17 of them blocked by nothing else). The note
        ; that stood here named every one of its walls and all of them are gone:
        ; getBaseTypes' class arm, getBaseConstructorTypeOfClass' isConstructorType
        ; stop (slice 120), getApparentType's globals (this slice), the
        ; type-argument constraint loop, checkTypeAssignableTo with a HEAD MESSAGE
        ; (this slice) and checkKindsOfPropertyMemberOverrides (this slice).
        ;
        ; ★★ THE ORDER IS THE ANSWER, and the old note said why it had to stop HERE
        ; rather than one call on: the block runs BEFORE
        ; checkMembersForOverrideModifier, and diagcheck compares a SUBSEQUENCE, so
        ; skipping it to reach the override family would have emitted that family's
        ; lines ahead of these.
        ; typeWithThis and staticType are dereferenced from here on; the reads
        ; above them only tested the MARK, which is a different question.
        if type_with_this = null
            return
        if static_type = null
            return
        let twt type_with_this as ref[Type]
        let sty static_type as ref[Type]
        let base_type_node Checker.get_extends_heritage_clause_element(node)
        if base_type_node <> null
        {
            let btn base_type_node as ref[AstNode]
            let type_argument_nodes AstNode.type_arguments_of(btn)
            this.check_source_elements(type_argument_nodes)
            if this.unported_mark() <> unported_before
                return
            let base_types this.get_base_types(class_type as ref[Type])
            if this.unported_mark() <> unported_before
                return
            var base_count 0
            if base_types <> null
                set base_count: (base_types as ref[Array[ref[Type]?]]).get_length() as int
            if base_count <> 0
            {
                let base_row (base_types as ref[Array[ref[Type]?]])[0]
                if base_row = null
                    return
                let base_type base_row as ref[Type]
                let base_constructor_type this.get_base_constructor_type_of_class(class_type as ref[Type])
                if this.unported_mark() <> unported_before
                    return
                if base_constructor_type = null
                    return
                let bct base_constructor_type as ref[Type]
                let static_base_type this.get_apparent_type(bct)
                if this.unported_mark() <> unported_before
                    return
                if static_base_type = null
                    return
                let sbt static_base_type as ref[Type]
                this.check_base_type_accessibility(sbt, btn)
                if this.unported_mark() <> unported_before
                    return
                this.check_source_element(AstNode.expression_of(btn))
                if this.unported_mark() <> unported_before
                    return
                if AstNode.list_count(type_argument_nodes) <> 0
                {
                    ; `checkSourceElements(baseTypeNode.TypeArguments())` a SECOND
                    ; time — the reference does, and the two calls are not
                    ; idempotent-by-accident: check_source_element memoises nothing,
                    ; so a duplicate report would be a duplicate `C` line. ★It is
                    ; not one, because every arm of the type-node walk is a
                    ; type-node arm and those report through the type they build,
                    ; which IS memoised (typeNodeLinks).
                    this.check_source_elements(type_argument_nodes)
                    if this.unported_mark() <> unported_before
                        return
                    let constructors this.get_constructors_for_type_arguments(sbt, type_argument_nodes)
                    if this.unported_mark() <> unported_before
                        return
                    if constructors <> null
                    {
                        let cl constructors as ref[Array[ref[Signature]?]]
                        let cn cl.get_length() as int
                        var ci 0
                        while ci < cn
                        {
                            let crow cl[ci]
                            set ci: ci + 1
                            if crow = null
                                continue
                            let tps (crow as ref[Signature]).type_parameters
                            if tps = null
                                continue
                            ; `if !checkTypeArgumentConstraints(…) { break }` — the
                            ; loop stops at the FIRST candidate whose constraints
                            ; fail, because every candidate would report the same
                            ; TS2344 on the same node.
                            let ok this.check_type_argument_constraints(btn, tps as ref[Array[ref[Type]?]])
                            if this.unported_mark() <> unported_before
                                return
                            if ok = false
                                set ci: cn
                        }
                    }
                }
                let base_with_this this.get_type_with_this_argument(base_type, Checker.this_type_of(class_type as ref[Type]), false)
                if this.unported_mark() <> unported_before
                    return
                if base_with_this = null
                    return
                let bwt base_with_this as ref[Type]
                let assignable this.check_type_assignable_to(twt, bwt, null, 0)
                if this.unported_mark() <> unported_before
                    return
                if assignable = false
                    this.issue_member_specific_error(node, twt, bwt, DiagClass_0_incorrectly_extends_base_class_1)
                else
                {
                    ; *Report the static side error only when the instance type is
                    ; assignable* — the reference's own comment, and the reason this
                    ; is an else and not a second statement.
                    let without this.get_type_without_signatures(sbt)
                    if this.unported_mark() <> unported_before
                        return
                    if without = null
                        return
                    var error_node AstNode.name_of(node)
                    if error_node = null
                        set error_node: node
                    this.check_type_assignable_to(sty, without as ref[Type], error_node, DiagClass_static_side_0_incorrectly_extends_base_class_static_side_1)
                }
                if this.unported_mark() <> unported_before
                    return
                if (bct.flags & TypeFlagsTypeVariable) <> 0
                {
                    ; The MIXIN pair. `class C extends T` with a type-variable base
                    ; needs a single rest parameter of type any (TS2545), and if it
                    ; has one but the base's construct signatures are abstract, C
                    ; must be abstract too (TS2797).
                    var error_node AstNode.name_of(node)
                    if error_node = null
                        set error_node: node
                    if this.is_mixin_constructor_type(sty) = false
                        this.error_on_node(error_node, DiagA_mixin_class_must_have_a_constructor_with_a_single_rest_parameter_of_type_any)
                    else
                    {
                        let construct_signatures this.get_signatures_of_type(bct, SignatureKindConstruct)
                        if this.unported_mark() <> unported_before
                            return
                        var some_abstract false
                        if construct_signatures <> null
                        {
                            let sl construct_signatures as ref[Array[ref[Signature]?]]
                            let sn sl.get_length() as int
                            var si 0
                            while si < sn
                            {
                                let srow sl[si]
                                if srow <> null
                                {
                                    if ((srow as ref[Signature]).flags & SignatureFlagsAbstract) <> 0
                                        set some_abstract: true
                                }
                                set si: si + 1
                            }
                        }
                        if some_abstract
                        {
                            if (b.combined_modifier_flags(node) & ModifierFlagsAbstract) = 0
                                this.error_on_node(error_node, DiagA_mixin_class_that_extends_from_a_type_variable_containing_an_abstract_construct_signature_must_also_be_declared_abstract)
                        }
                    }
                    if this.unported_mark() <> unported_before
                        return
                }
                ; *When the static base type is a "class-like" constructor function
                ; (but not actually a class), we verify that all instantiated base
                ; constructor signatures return the same type* — the reference's own
                ; comment. TS2510.
                var static_base_is_class false
                if sbt.symbol <> null
                {
                    if (Symbol.flags_of(sbt.symbol as ref[Symbol]) & SymbolFlagsClass) <> 0
                        set static_base_is_class: true
                }
                if static_base_is_class = false
                {
                    if (bct.flags & TypeFlagsTypeVariable) = 0
                    {
                        let constructors this.get_instantiated_constructors_for_type_arguments(sbt, type_argument_nodes, btn)
                        if this.unported_mark() <> unported_before
                            return
                        if constructors = null
                            return
                        let cl constructors as ref[Array[ref[Signature]?]]
                        let cn cl.get_length() as int
                        var every true
                        var ci 0
                        while ci < cn
                        {
                            let crow cl[ci]
                            set ci: ci + 1
                            if crow = null
                                continue
                            let rt this.get_return_type_of_signature(crow as ref[Signature])
                            if this.unported_mark() <> unported_before
                                return
                            if rt = null
                                return
                            if this.is_type_identical_to(rt as ref[Type], base_type) = false
                                set every: false
                        }
                        if this.unported_mark() <> unported_before
                            return
                        if every = false
                            this.error_on_node(AstNode.expression_of(btn), DiagBase_constructors_must_all_have_the_same_return_type)
                    }
                }
                this.check_kinds_of_property_member_overrides(class_type as ref[Type], base_type)
                if this.unported_mark() <> unported_before
                    return
            }
        }
        ; ★★★ SO THE CLASS THIS SLICE CAN FINISH IS THE ONE WITH NO BASE, AND THAT
        ; IS EXACTLY THE CLASS THE OVERRIDE FAMILY HAS SOMETHING TO SAY ABOUT.
        ; checkMemberForOverrideModifier's first branch is the `baseWithThis == nil`
        ; one, and its whole content is TS4112 / TS4121 — *this member cannot have
        ; an override modifier because its containing class does not extend another
        ; class*. The half of that function this port cannot reach is the half a
        ; base type would be needed for, and the caller's stop above is what proves
        ; the reachable half is the only one running.
        this.check_members_for_override_modifier(node, class_type as ref[Type], type_with_this, static_type)
        if this.unported_mark() <> unported_before
            return
        ; ── slice 124: the IMPLEMENTS loop ────────────────────────────────────
        ;
        ; ★ It was a separate row from the extends block *because a class may have
        ; either clause without the other*, and it falls with the same three walls.
        ; ★★The GENERIC diagnostic forks on whether the implemented type's symbol is
        ; a CLASS — `implements` a class is TS2720 with a *did you mean to extend*
        ; hint, an interface TS2420 — and that fork is a CODE, so it is transcribed
        ; rather than folded.
        let impls Checker.get_implements_heritage_clause_elements(node)
        if impls <> null
        {
            let il impls as ref[Array[ref[AstNode]?]]
            let in_ il.get_length() as int
            var ii 0
            while ii < in_
            {
                let irow il[ii]
                set ii: ii + 1
                if irow = null
                    continue
                let type_ref_node irow as ref[AstNode]
                let expr AstNode.expression_of(type_ref_node)
                var bad_expr false
                if expr = null
                    set bad_expr: true
                else
                {
                    if Checker.is_entity_name_expression(expr as ref[AstNode]) = false
                        set bad_expr: true
                    if Binder.is_optional_chain(expr as ref[AstNode])
                        set bad_expr: true
                }
                if bad_expr
                    this.error_on_node(expr, DiagA_class_can_only_implement_an_identifier_Slashqualified_name_with_optional_type_arguments)
                this.check_type_reference_node(type_ref_node)
                if this.unported_mark() <> unported_before
                    return
                let raw this.get_type_from_type_node(type_ref_node)
                if this.unported_mark() <> unported_before
                    return
                if raw = null
                    return
                let reduced this.get_reduced_type(raw as ref[Type])
                if this.unported_mark() <> unported_before
                    return
                if reduced = null
                    return
                let t reduced as ref[Type]
                if t = error_type
                    continue
                if this.is_valid_base_type(t) = false
                {
                    this.error_on_node(type_ref_node, DiagA_class_can_only_implement_an_object_type_or_intersection_of_object_types_with_statically_known_members)
                    if this.unported_mark() <> unported_before
                        return
                    continue
                }
                var generic_code DiagClass_0_incorrectly_implements_interface_1
                if t.symbol <> null
                {
                    if (Symbol.flags_of(t.symbol as ref[Symbol]) & SymbolFlagsClass) <> 0
                        set generic_code: DiagClass_0_incorrectly_implements_class_1_Did_you_mean_to_extend_1_and_inherit_its_members_as_a_subclass
                }
                let base_with_this this.get_type_with_this_argument(t, Checker.this_type_of(class_type as ref[Type]), false)
                if this.unported_mark() <> unported_before
                    return
                if base_with_this = null
                    return
                let bwt base_with_this as ref[Type]
                let assignable this.check_type_assignable_to(twt, bwt, null, 0)
                if this.unported_mark() <> unported_before
                    return
                if assignable = false
                {
                    this.issue_member_specific_error(node, twt, bwt, generic_code)
                    if this.unported_mark() <> unported_before
                        return
                }
                set ii: ii
            }
        }
        ; ★★★ SLICE 77 TOOK THE LAST FOUR CALLS AND STOPPED AT TWO OF THEM WITHOUT
        ; RETURNING; SLICE 85 MAKES THE FIRST TWO REAL CALLS AND THE STOP MOVES
        ; INSIDE THEM. checkIndexConstraints is ported, but a CLASS's instance type
        ; carries ObjectFlagsReference — get_declared_type_of_class_or_interface
        ; gives every class a `this` type — so resolveStructuredTypeMembers takes
        ; the INSTANTIATING arm, and the static side is an anonymous type whose
        ; symbol is a class rather than a type literal. Both are one call deeper
        ; than the row slice 77 left here, and both are the members chapter's own
        ; successor. The two calls are written rather than left as one stop,
        ; because where a walk stops is what the work list measures.
        this.check_index_constraints(class_type as ref[Type], sym, false)
        this.check_index_constraints(static_type as ref[Type], sym, true)
        this.check_class_or_interface_for_duplicate_index_signatures(node)
        ; ★★★ checkPropertyInitialization, AND THE ROW THAT STOOD HERE WAS THE HEAD
        ; OF THE WORK LIST FROM SLICE 77 TO SLICE 94. Three slices named the wall
        ; and the first two named it wrong: the sentence at this line said *"the
        ; flow graph, which this port's binder does not build"* until slice 92 built
        ; it and the row did not move, and slice 93 built the WALK and it did not
        ; move either. What actually held it was `getOptionalType(propType, false)`
        ; — one call, in the union chapter — which is why the tag `flow-graph` was
        ; two walls wearing one name. **A shared tag is a claim that two callers
        ; wait on the same thing; check it before believing it.**
        this.check_property_initialization(node)
    }

    ; ── slice 74a: checkClassForStaticPropertyNameConflicts ──────────────────
    ;
    ; ★★★ THE HEAD OF THE WORK LIST ON BOTH STAGES, AND IT IS INERT. The whole
    ; function is behind `if c.compilerOptions.GetUseDefineForClassFields() {
    ; return }`, and that answers TRUE under this harness — the option is an unset
    ; Tristate, so the reference falls through to `GetEmitScriptTarget() >=
    ; ScriptTargetES2022`, which is ES2025 >= ES2022. The oracle's own
    ; CompilerOptions is built with two unrelated fields and nothing else
    ; (tests/oracle/types.go), so this is not a divergence between the two sides:
    ; the REFERENCE runs no more of this function than we do.
    ;
    ; ★★ WHAT IS BEHIND THE GUARD IS REPORTED RATHER THAN WRITTEN, and the reason
    ; is that an unreachable body cannot be gated (§3.5ao). The loop asks
    ; getEffectivePropertyNameForPropertyNameNode for every static member's name
    ; and reports TS2699 for `name`, `length`, `caller` and `arguments` — the same
    ; message slice 73 already raises for `prototype`, from the other of its two
    ; sites. The computed-name arm of that helper needs tryGetNameFromType over
    ; getTypeOfExpression, so the body is not a five-line port either.
    ;
    ; ★ The row is therefore a claim about the OPTION, and the battery's way of
    ; saying so is to substitute `false` for the field: the report then fires on
    ; every class in the corpus and the tagpin goes red. That is the only
    ; instrument this function has, and it is the honest one.
    procedure check_class_for_static_property_name_conflicts(this, node: ref[AstNode])
    {
        if use_define_for_class_fields
            return
        ; slice 254: the emit programs read useDefineForClassFields, and the body
        ; the guard stood in front of is written
        let members AstNode.member_list_of(node)
        let n AstNode.list_count(members)
        let name_word: Slice[char] "name"
        let length_word: Slice[char] "length"
        let caller_word: Slice[char] "caller"
        let arguments_word: Slice[char] "arguments"
        var i 0
        while i < n
        {
            let mo AstNode.child_in_list(members, i)
            set i: i + 1
            if mo = null
                continue
            let member mo as ref[AstNode]
            let member_name_node AstNode.name_of(member)
            if member_name_node = null
                continue
            let mb this.binder_of_node(member)
            if mb.has_syntactic_modifier(member, ModifierFlagsStatic) = false
                continue
            let mnn member_name_node as ref[AstNode]
            ; getEffectivePropertyNameForPropertyNameNode
            var member_name AstNode.property_name_text_of(mnn)
            if (member_name.data = null) and (mnn.kind = KindComputedPropertyName)
            {
                let expression AstNode.expression_of(mnn)
                if expression <> null
                {
                    let mark this.unported_mark()
                    let et this.get_type_of_expression(expression as ref[AstNode])
                    if this.unported_mark() <> mark
                        return
                    if et <> null
                    {
                        var from_type Slice[char]()
                        if this.try_get_name_from_type(et as ref[Type], &from_type)
                            set member_name: from_type
                    }
                }
            }
            if member_name.data = null
                continue
            var conflicts SymbolTable.names_equal(member_name, name_word)
            if SymbolTable.names_equal(member_name, length_word)
                set conflicts: true
            if SymbolTable.names_equal(member_name, caller_word)
                set conflicts: true
            if SymbolTable.names_equal(member_name, arguments_word)
                set conflicts: true
            if conflicts
                this.error_on_node(mnn, DiagStatic_property_0_conflicts_with_built_in_property_Function_0_of_constructor_function_1, Checker.arg_text(member_name), this.symbol_arg(this.get_symbol_of_declaration(node)))
        }
    }

    ; ── slice 74b: checkMembersForOverrideModifier ───────────────────────────
    ;
    ; ★★★ SLICE 131 WROTE THE `baseWithThis` COMPUTATION, AND WHAT IT REPLACED WAS
    ; THE SECOND EXPIRED UNREACHABILITY CLAIM OF THIS SLICE. The note here read
    ; *the computation is DEAD by the caller's stop … a class reaching this
    ; function has no `extends` clause*, which was true while
    ; check_class_like_declaration stopped at the heritage block and false from
    ; slice 124, which ported that block whole. Measured on the stage-2 frontier:
    ; 784 units were arriving at the row, 126 of them with nothing else left.
    ; **The claim's own last sentence asked for exactly this — *the day the block
    ; above becomes a port this function says what it still owes* — and nothing
    ; came back to read it.**
    ;
    ; ★ The reference guards the index rather than the list: `len(baseTypes) > 0`
    ; and then `core.FirstOrNil`, so a class whose base types resolved to nothing
    ; keeps a nil baseWithThis and the member loop reports the
    ; does-not-extend-another-class message. That is a different answer from
    ; stopping, and it is the answer the reference gives.
    ;
    ; ★ baseStaticType is computed even though nothing reads it on the reachable
    ; path: with no base type node getBaseConstructorTypeOfClass answers
    ; undefinedType and CACHES it on the type, which is a side effect the reference
    ; has at this point in the walk.
    procedure check_members_for_override_modifier(this, node: ref[AstNode], t: ref[Type], type_with_this: ref[Type]?, static_type: ref[Type]?)
    {
        let unported_before this.unported_mark()
        var base_with_this: ref[Type]? null
        if Checker.get_extends_heritage_clause_element(node) <> null
        {
            let base_types this.get_base_types(t)
            if this.unported_mark() <> unported_before
                return
            if base_types <> null
            {
                let bl base_types as ref[Array[ref[Type]?]]
                if bl.get_length() <> 0
                {
                    let first bl[0]
                    if first <> null
                        set base_with_this: this.get_type_with_this_argument(first as ref[Type], Checker.this_type_of(t), false)
                    if this.unported_mark() <> unported_before
                        return
                }
            }
        }
        let base_static_type this.get_base_constructor_type_of_class(t)
        if this.unported_mark() <> unported_before
            return
        let members AstNode.member_list_of(node)
        if members = null
            return
        let ms members as ref[Array[ref[AstNode]?]]
        let count ms.get_length() as int
        var i 0
        while i < count
        {
            let m ms[i]
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if b.has_syntactic_modifier(member, ModifierFlagsAmbient)
                continue
            ; A parameter property declares a class member without appearing in the
            ; member list, so the constructor's parameters stand in for it — the
            ; same substitution slice 73's walk makes, and with the same reading of
            ; is_parameter_property_declaration through the parameter's own parent.
            if AstNode.kind_of(member) = KindConstructor
            {
                let params AstNode.parameters_of(member)
                if params = null
                    continue
                let ps params as ref[Array[ref[AstNode]?]]
                let pn ps.get_length() as int
                var j 0
                while j < pn
                {
                    let p ps[j]
                    set j: j + 1
                    if p = null
                        continue
                    let param p as ref[AstNode]
                    if b.is_parameter_property_declaration(param) = false
                        continue
                    this.check_member_for_override_modifier(node, static_type, base_static_type, base_with_this, t, type_with_this, param)
                    if this.unported_mark() <> unported_before
                        return
                }
                continue
            }
            this.check_member_for_override_modifier(node, static_type, base_static_type, base_with_this, t, type_with_this, member)
            if this.unported_mark() <> unported_before
                return
        }
    }

    ; ── slice 74c: checkMemberForOverrideModifier ────────────────────────────
    ;
    ; ★★★ THE FIRST BRANCH IS THE WHOLE OF THE REACHABLE FUNCTION, AND IT IS THE
    ; SLICE'S PRODUCT. With `baseWithThis == nil` the reference reports on a member
    ; that carries the `override` modifier and returns on one that does not: TS4112
    ; in a TypeScript file, TS4121 in a JavaScript one, *this member cannot have an
    ; override modifier because its containing class does not extend another
    ; class*.
    ;
    ; ★★★ THE SPAN IS `c.error(member, …)` AND THAT IS NOT THE MEMBER'S RANGE —
    ; scanner.GetErrorRangeForNode NARROWS a named declaration to its NAME, for a
    ; fixed LIST of kinds whose own comment upstream reads *"This list is a work in
    ; progress"*. PropertyDeclaration, MethodDeclaration, GetAccessor and
    ; SetAccessor are on it, so a class member reports on its name; **KindParameter
    ; is NOT**, so a parameter property reports over its whole text, modifiers
    ; included. Measured on the fixtures: `foo`, `x`, `s`, `a`, `b` — and
    ; `override readonly x: number`. ★That is why control g18, which substitutes
    ; `AstNode.name_of(member)`, goes red on exactly ONE pin file: the two spellings
    ; coincide everywhere the narrowing list already applies, and the parameter
    ; property is the only place they can disagree.
    ;
    ; ★★ THE JS ARM IS NOT SPECULATIVE. hasOverrideModifier is
    ; HasSyntacticModifier — not the effective, JSDoc-aware form — so what the JS
    ; arm needs is a `.js` unit whose class member is written with the `override`
    ; keyword. The corpus has them, and the two codes differ, so the `isJs` term is
    ; gateable rather than transcribed on faith.
    ;
    ; ★★ EVERYTHING AFTER THE FIRST BRANCH WAS A STOP UNTIL SLICE 161 and the note
    ; read *the dynamic-name arm needs isNonBindableDynamicName, and behind it sit
    ; getPropertyOfType, getSuggestedSymbolForNonexistentClassMember and the whole
    ; noImplicitOverride block*. Three of those four were here already; the fourth
    ; is two lines over getPropertiesOfType and the spelling suggester. The
    ; `no_implicit_override` read is the reference's own
    ; `!memberHasOverrideModifier && !NoImplicitOverride.IsTrue()` return.
    ;
    ; ★★★ THE THREE FALL-THROUGHS ARE NOT ONE. `baseProp == nil` reports only WITH
    ; an override modifier and otherwise ends the function; a base property with NO
    ; declarations ends it too; and the abstract fork's second arm reports only when
    ; the MEMBER is abstract as well — so a member that legally overrides an
    ; abstract method arrives at the end silently.
    procedure check_member_for_override_modifier(this, node: ref[AstNode], static_type: ref[Type]?, base_static_type: ref[Type]?, base_with_this: ref[Type]?, t: ref[Type], type_with_this: ref[Type]?, member: ref[AstNode])
    {
        let is_js Parser.is_in_js_file(node)
        let member_has_override_modifier b.has_syntactic_modifier(member, ModifierFlagsOverride)
        if base_with_this = null
        {
            if member_has_override_modifier
            {
                let name_arg1 this.type_arg(t)
                if is_js
                    this.error_on_node(member, DiagThis_member_cannot_have_a_JSDoc_comment_with_an_override_tag_because_its_containing_class_0_does_not_extend_another_class, name_arg1)
                else
                    this.error_on_node(member, DiagThis_member_cannot_have_an_override_modifier_because_its_containing_class_0_does_not_extend_another_class, name_arg1)
            }
            return
        }
        let mark this.unported_mark()
        ; The dynamic-name arm — five conjuncts, and `member.Symbol()` is the RAW
        ; slot rather than the merged symbol, which is what makes it a test for
        ; *this declaration owns a symbol at all*.
        if member_has_override_modifier
        {
            let raw_symbol AstNode.symbol_of(member)
            if raw_symbol <> null
            {
                if Symbol.value_declaration_of(raw_symbol as ref[Symbol]) <> null
                {
                    if Binder.is_class_element(member)
                    {
                        let nm AstNode.name_of(member)
                        if nm <> null
                        {
                            let dynamic this.is_non_bindable_dynamic_name(nm)
                            if this.unported_mark() <> mark
                                return
                            if dynamic
                            {
                                if is_js
                                    this.error_on_node(member, DiagThis_member_cannot_have_a_JSDoc_comment_with_an_override_tag_because_its_name_is_dynamic)
                                else
                                    this.error_on_node(member, DiagThis_member_cannot_have_an_override_modifier_because_its_name_is_dynamic)
                                return
                            }
                        }
                    }
                }
            }
        }
        if member_has_override_modifier = false
        {
            if no_implicit_override = false
                return
        }
        ; Here we have a base class and also an override modifier, or no override
        ; modifier under noImplicitOverride.
        let symbol this.get_symbol_of_declaration(member)
        if symbol = null
            return
        let s symbol as ref[Symbol]
        let member_is_static b.is_static(member)
        var this_type type_with_this
        if member_is_static
            set this_type: static_type
        if this_type = null
            return
        let prop this.get_property_of_type(this_type as ref[Type], Symbol.name_of(s))
        if this.unported_mark() <> mark
            return
        if prop = null
            return
        var base_type base_with_this
        if member_is_static
            set base_type: base_static_type
        if base_type = null
            return
        let bt base_type as ref[Type]
        let base_prop this.get_property_of_type(bt, Symbol.name_of(s))
        if this.unported_mark() <> mark
            return
        if base_prop = null
        {
            if member_has_override_modifier = false
                return
            let suggestion this.get_suggested_symbol_for_nonexistent_class_member(Symbol.name_of(s), bt)
            if this.unported_mark() <> mark
                return
            if suggestion <> null
            {
                let name_arg2 this.type_arg(base_with_this)
                if is_js
                    this.error_on_node(member, DiagThis_member_cannot_have_a_JSDoc_comment_with_an_override_tag_because_it_is_not_declared_in_the_base_class_0_Did_you_mean_1, name_arg2, this.symbol_arg(suggestion))
                else
                    this.error_on_node(member, DiagThis_member_cannot_have_an_override_modifier_because_it_is_not_declared_in_the_base_class_0_Did_you_mean_1, name_arg2, this.symbol_arg(suggestion))
                return
            }
            let name_arg3 this.type_arg(base_with_this)
            if is_js
                this.error_on_node(member, DiagThis_member_cannot_have_a_JSDoc_comment_with_an_override_tag_because_it_is_not_declared_in_the_base_class_0, name_arg3)
            else
                this.error_on_node(member, DiagThis_member_cannot_have_an_override_modifier_because_it_is_not_declared_in_the_base_class_0, name_arg3)
            return
        }
        let bp base_prop as ref[Symbol]
        let dn Symbol.declaration_count(bp)
        if dn = 0
            return
        if member_has_override_modifier
            return
        if no_implicit_override = false
            return
        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            return
        var base_has_abstract false
        var i 0
        while i < dn
        {
            let d Symbol.declaration_at(bp, i)
            set i: i + 1
            if d = null
                continue
            if b.has_syntactic_modifier(d as ref[AstNode], ModifierFlagsAbstract)
                set base_has_abstract: true
        }
        if base_has_abstract = false
        {
            ; ★ast.IsParameterDeclaration is the KIND test, not "declared inside a
            ; parameter" — a parameter property is the shape it separates.
            let name_arg4 this.type_arg(base_with_this)
            if AstNode.kind_of(member) = KindParameter
            {
                if is_js
                    this.error_on_node(member, DiagThis_parameter_property_must_have_a_JSDoc_comment_with_an_override_tag_because_it_overrides_a_member_in_the_base_class_0, name_arg4)
                else
                    this.error_on_node(member, DiagThis_parameter_property_must_have_an_override_modifier_because_it_overrides_a_member_in_base_class_0, name_arg4)
                return
            }
            if is_js
                this.error_on_node(member, DiagThis_member_must_have_a_JSDoc_comment_with_an_override_tag_because_it_overrides_a_member_in_the_base_class_0, name_arg4)
            else
                this.error_on_node(member, DiagThis_member_must_have_an_override_modifier_because_it_overrides_a_member_in_the_base_class_0, name_arg4)
            return
        }
        if b.has_syntactic_modifier(member, ModifierFlagsAbstract)
        {
            let name_arg5 this.type_arg(base_with_this)
            this.error_on_node(member, DiagThis_member_must_have_an_override_modifier_because_it_overrides_an_abstract_method_that_is_declared_in_the_base_class_0, name_arg5)
        }
    }

    ; getSuggestedSymbolForNonexistentClassMember.
    procedure get_suggested_symbol_for_nonexistent_class_member(this, nd: Slice[char], base_type: ref[Type]) returns ref[Symbol]?
    {
        let props this.get_properties_of_type(base_type)
        if props = null
            return null
        this.get_spelling_suggestion_for_name(nd, props as ref[Array[ref[Symbol]?]], SymbolFlagsClassMember)
    }

    ; checkClassDeclaration's prefix.
    ;
    ; ★★ THE MISSING-NAME REPORT IS THE ONLY DIAGNOSTIC THIS ARM ADDS ON ITS OWN,
    ; and it is about `export default class {}` versus a bare `class {}` at
    ; statement position: the second has no name and no `default` modifier, and the
    ; span is the FIRST TOKEN rather than the error range, so the report is
    ; grammar_error_on_first_token.
    ;
    ; ★ `core.Find(node.ModifierNodes(), ast.IsDecorator)` is computed before the
    ; legacy test upstream and its value is only read inside it, so the order here
    ; is the reference's order with the dead computation left where a report can
    ; stand for it.
    procedure check_class_declaration(this, node: ref[AstNode])
    {
        ; `c.legacyDecorators && firstDecorator != nil && core.Some(node.Members(),
        ; …)` — the class-decorator-with-a-static-private-member report. The option
        ; is unset under this harness (see check_grammar_modifiers' header), so the
        ; branch is dead; it is REPORTED rather than dropped for the reason the
        ; accessor-pair decorator check one screen down is reported — an options
        ; record arriving later turns it into a port instead of a silent wrong
        ; answer. What it needs besides the option is a class-MEMBERS accessor,
        ; which nothing in this port has a live reader for yet.
        if legacy_decorators
        {
            let first_decorator Checker.first_decorator_of(node)
            if first_decorator <> null
            {
                if Checker.some_member_is_static_private(b, node)
                    this.grammar_error_on_node(first_decorator, DiagClass_decorators_can_t_be_used_with_static_private_identifier_Consider_removing_the_experimental_decorator)
            }
        }
        if AstNode.name_of(node) = null
        {
            if b.has_syntactic_modifier(node, ModifierFlagsDefault) = false
                this.grammar_error_on_first_token(node, DiagA_class_declaration_without_the_default_modifier_must_have_a_name)
        }
        this.check_class_like_declaration(node)
        ; ★★★ SLICE 82 MAKES THE MEMBER WALK, AND THE NOTE THAT STOOD HERE WAS THE
        ; SAME MISTAKE SLICE 77 LIFTED OUT OF checkInterfaceDeclaration. It read
        ; *not reached: the call above always reports, so the MEMBERS of a class
        ; stay behind this arm* — and record_unported MARKS AND DOES NOT ABORT, this
        ; file's convention since slice 52, so the reference's next line runs
        ; whatever the class arm did. **An early exit that was never written as one
        ; is harder to see than one that was**: there is no `return` here to notice,
        ; only a line that is missing under a sentence explaining why.
        ;
        ; ★★★ IT WAS FOUND BY A CONTROL THAT CAME BACK SILENT. Slice 82's g15 drops
        ; isPrivateWithinAmbient and predicted an INVENTED TS7010 on an ambient
        ; class's private method; it moved nothing, because nothing in this port
        ; had ever reached a class member's checkFunctionOrMethodDeclaration. **A
        ; fixture that cannot be reached is indistinguishable from a guard that
        ; works** — which is §3.5v's fourth row arriving through the battery rather
        ; than through the corpus.
        ;
        ; ★★ WHAT IT COSTS AND WHAT IT BUYS, measured on stage 1: diagcheck
        ; 264/558 -> 275/575 (+11 units, +17 diagnostics, still a subsequence) and
        ; stop events 7 300 -> 7 999, with two rows appearing that no arm of this
        ; file had ever seen — `check-type-assignable-to 173` (a property
        ; declaration's initializer) at 60 units and `check 177` (the CONSTRUCTOR,
        ; which has no arm in check_source_element_worker at all) at 53.
        this.check_source_elements(AstNode.member_list_of(node))
        this.register_for_unused_identifiers_check(node)
    }

    ; ── slice 59: the collision checks, and one head for four arms ───────────
    ;
    ; ★★★ THE SLICE IS checkCollisionsForDeclarationName, WHICH IS THE FIRST HEAD
    ; OF THIS CHAPTER THAT FOUR INDEPENDENT ARMS STOP AT: the class-like
    ; declaration (3 300 units), the module declaration (341), the enum
    ; declaration, and checkImportBinding, whose own first line it is and behind
    ; which slice 58's 1 506 + 429 stand. Slice 58's work list put the four at
    ; **5 235** units and named what the head needs — needCollisionCheckForIdentifier,
    ; GetDeclarationContainer, GetModuleInstanceState — all three of which were in
    ; reach, and one thing it called a stop.
    ;
    ; ★★★ AND THAT ONE WAS NOT A STOP. *checkClassNameCollisionWithObject (the
    ; global symbol, i.e. a stop)* is a claim read off a NAME: the function is two
    ; terms, `name.Text() == "Object"` and `GetEmitModuleFormatOfFile(...) <
    ; ModuleKindES2015`, and it resolves nothing at all. It is ported whole in this
    ; slice, its report is LIVE, and §3.5ci's rule — *a marker whose stated blocker
    ; never existed* — arrives from the other side: there the marker outlived a
    ; blocker that had gone, here the work list invented one that was never there.
    ; A blocker is a claim about a BODY and must be read in the body.
    ;
    ; ★★★ THREE OF THE FIVE SUB-CHECKS ARE PROVABLY INERT AND TWO ARE LIVE, and
    ; which is which is decided by two constants that do NOT agree — see
    ; Checker.language_version and Checker.emit_module_format. The require/exports
    ; check runs (format None is below ES2015); the global-object check runs to its
    ; last line and cannot report (it needs CommonJS); the Promise check returns at
    ; its first line (ES2025 >= ES2017) and the two recordPotentialCollisionWith…
    ; functions register nothing (ES2025 is not <= ES2021). Each of the three inert
    ; ones is ported as its GUARD plus a report — the shape
    ; check_class_declaration's legacy_decorators branch has — because what stands
    ; behind them is real machinery (the binder's HasAsyncFunctions flag, the
    ; nodeLinks check flags, the deferred-diagnostic queue) and a lowered target
    ; must turn into a port rather than into a silent silence.
    ;
    ; ★★ WHAT THE HEAD BUYS EACH CALLER IS DIFFERENT, AND ONLY ONE OF THE FOUR IS
    ; A PURE RE-LABELLING. The enum and the class-like arm walk on to
    ; checkTypeParameters / checkExportsOnMergedDeclarations, so their rows move to
    ; tags this column already has; the module arm gains a REPORT of its own, the
    ; TS1540 *use the namespace keyword* advice that sat behind this call since
    ; slice 50; the class-like arm gains two, the reserved type name and
    ; `class Object {}`; and checkImportBinding is one line further on, at
    ; checkAliasSymbol.

    ; ast.GetDeclarationContainer. FindAncestor from the ROOT declaration through
    ; the six kinds that are not containers, and then that node's PARENT — so for
    ; `var x = 1` at the top level of a file the answer is the SourceFile, reached
    ; through the declaration, the declaration list and the statement.
    ;
    ; ★ The reference would panic if the walk ran off the top (`FindAncestor(...)
    ; .Parent` on nil); this answers null, and every caller tests the result for
    ; KindSourceFile, which null is not. It cannot happen either way — a SourceFile
    ; is not one of the six — and the difference is one dereference rather than a
    ; behaviour.
    function get_declaration_container(node: ref[AstNode]) returns ref[AstNode]?
    {
        var n Binder.get_root_declaration(node)
        while n <> null
        {
            let k AstNode.kind_of(n)
            var transparent false
            if k = KindVariableDeclaration
                set transparent: true
            if k = KindVariableDeclarationList
                set transparent: true
            if k = KindImportSpecifier
                set transparent: true
            if k = KindNamedImports
                set transparent: true
            if k = KindNamespaceImport
                set transparent: true
            if k = KindImportClause
                set transparent: true
            if transparent = false
                return AstNode.parent_node_of(n)
            set n: AstNode.parent_node_of(n)
        }
        null
    }

    ; ast.IsTypeOnlyImportDeclaration. Four arms, and the two that read a
    ; GRANDparent are the reason it is not one call to is_type_only_of: an
    ; ImportSpecifier is type-only if it says so ITSELF (`import { type A }`) or if
    ; its clause does (`import type { A }`), and the clause is two hops up through
    ; the NamedImports.
    function is_type_only_import_declaration(n: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(n)
        if k = KindImportSpecifier
        {
            if AstNode.is_type_only_of(n)
                return true
            let p AstNode.parent_node_of(n)
            if p = null
                return false
            return AstNode.is_type_only_of(AstNode.parent_node_of(p))
        }
        if k = KindNamespaceImport
            return AstNode.is_type_only_of(AstNode.parent_node_of(n))
        if k = KindImportClause
            return AstNode.is_type_only_of(n)
        if k = KindImportEqualsDeclaration
            return AstNode.is_type_only_of(n)
        false
    }

    ; ast.isTypeOnlyExportDeclaration. The EXPORT half of the disjunction below,
    ; ported although its one reader cannot reach it — need_collision_check_for_identifier
    ; asks the disjunction only for the three IMPORT kinds — because §3.5br's rule
    ; has been paid for six times: an accessor narrowed to the arms its callers are
    ; BELIEVED to reach is the defect that keeps coming back, and the three arms
    ; cost eleven lines.
    ;
    ; ★ The ExportDeclaration arm is the one that is not a plain flag read:
    ; `export type * from "m"` is type-only, `export type { A }` is not — a
    ; specifier list makes the declaration's own flag a statement about its
    ; specifiers rather than about itself.
    function is_type_only_export_declaration(n: ref[AstNode]) returns bool
    {
        let k AstNode.kind_of(n)
        if k = KindExportSpecifier
        {
            if AstNode.is_type_only_of(n)
                return true
            let p AstNode.parent_node_of(n)
            if p = null
                return false
            return AstNode.is_type_only_of(AstNode.parent_node_of(p))
        }
        if k = KindExportDeclaration
        {
            if AstNode.is_type_only_of(n) = false
                return false
            if AstNode.module_specifier_of(n) = null
                return false
            return AstNode.export_clause_of(n) = null
        }
        if k = KindNamespaceExport
            return AstNode.is_type_only_of(AstNode.parent_node_of(n))
        false
    }

    function is_type_only_import_or_export_declaration(n: ref[AstNode]) returns bool
    {
        if Checker.is_type_only_import_declaration(n)
            return true
        Checker.is_type_only_export_declaration(n)
    }

    ; needCollisionCheckForIdentifier, whole. The question is *would a name emitted
    ; by the down-level transform collide with this declaration*, so every arm is a
    ; reason the declaration cannot be reached by an unqualified name at runtime: a
    ; MEMBER is always qualified, an AMBIENT declaration emits nothing, a type-only
    ; import erases, and a parameter of a bodiless OVERLOAD is not emitted at all.
    ;
    ; ★★ THE NAME TEST IS THE FIRST TERM AND IT IS THE CHEAP ONE, which is why the
    ; five callers each pass a literal: the function is asked seven times per
    ; declaration name (require, exports, Object, Promise, WeakMap, WeakSet,
    ; Reflect) and six of those are answered by a length comparison.
    ;
    ; ★ `identifier.Text()` upstream answers for a string literal too, while
    ; identifier_text_equals reads the Identifier payload and answers false for
    ; anything else. No caller can pass a non-identifier — the module arm asks
    ; IsIdentifier of the name before it calls the head, and a class, an enum and an
    ; import binding all take an identifier or nothing — so the two agree
    ; everywhere they are asked, and this note is what stands in for the arm that
    ; would otherwise be written for a name that cannot arrive.
    function need_collision_check_for_identifier(node: ref[AstNode], identifier: ref[AstNode]?, name: Slice[char]) returns bool
    {
        if identifier <> null
        {
            if Checker.identifier_text_equals(identifier, name) = false
                return false
        }
        let k AstNode.kind_of(node)
        if k = KindPropertyDeclaration
            return false
        if k = KindPropertySignature
            return false
        if k = KindMethodDeclaration
            return false
        if k = KindMethodSignature
            return false
        if k = KindGetAccessor
            return false
        if k = KindSetAccessor
            return false
        if k = KindPropertyAssignment
            return false
        if (AstNode.flags_of(node) & NodeFlagsAmbient) <> 0
            return false
        var is_import_form false
        if k = KindImportClause
            set is_import_form: true
        if k = KindImportEqualsDeclaration
            set is_import_form: true
        if k = KindImportSpecifier
            set is_import_form: true
        if is_import_form
        {
            if Checker.is_type_only_import_or_export_declaration(node)
                return false
        }
        let root Binder.get_root_declaration(node)
        if AstNode.kind_of(root) = KindParameter
        {
            if Binder.node_is_missing(AstNode.body_of(AstNode.parent_node_of(root)))
                return false
        }
        true
    }

    ; checkCollisionWithRequireExportsInGeneratedCode, whole — and it is the LIVE
    ; one of the three "generated code" checks, because the emit format under this
    ; harness is ModuleKindNone and None is below ES2015.
    ;
    ; ★★ THE REPORT IS ABOUT THE TOP LEVEL OF A MODULE AND NOTHING ELSE. Both
    ; conditions on the container say so: it must be the SourceFile (so a name
    ; inside a function or a namespace is safe) and the file must be a module (a
    ; script emits no `require`/`exports` of its own). So `export {}; var require =
    ; 1` reports twice over — once for each of the two spellings the down-level
    ; module transform reserves — and the same declaration in a plain script
    ; reports nothing.
    ;
    ; ★ The uninstantiated-module guard is the reference's own comment: `declare
    ; namespace N {}` whose body declares only types emits no object, so its name
    ; cannot collide. It is asked of the NODE rather than of the container, which is
    ; why it reads GetModuleInstanceState and not the ambient flag.
    ;
    ; ★ errorSkippedOnNoEmit is `c.error` plus a FLAG on the diagnostic, and the
    ; flag is invisible to this yardstick: the dump is `C pos end code`, and the
    ; flag is read by the program when deciding which diagnostics survive
    ; `--noEmit`. So error_on_node is the whole of it here, and the difference is
    ; named rather than modelled.
    procedure check_collision_with_require_exports_in_generated_code(this, node: ref[AstNode], name: ref[AstNode]?)
    {
        if emit_module_format >= ModuleKindES2015
            return
        if name = null
            return
        var wanted false
        if Checker.need_collision_check_for_identifier(node, name, "require")
            set wanted: true
        if Checker.need_collision_check_for_identifier(node, name, "exports")
            set wanted: true
        if wanted = false
            return
        if AstNode.kind_of(node) = KindModuleDeclaration
        {
            if b.get_module_instance_state(node) <> ModuleInstanceStateInstantiated
                return
        }
        let parent Checker.get_declaration_container(node)
        if Checker.kind_or_unknown(parent) <> KindSourceFile
            return
        if b.is_external_or_common_js_module() = false
            return
        this.error_skipped_on_no_emit(name, DiagDuplicate_identifier_0_Compiler_reserves_name_1_in_top_level_scope_of_a_module, this.declaration_name_to_string(name), this.declaration_name_to_string(name))
    }

    ; checkCollisionWithGlobalObjectInGeneratedCode, whole. It runs to its last
    ; line on every non-class declaration named `Object` and cannot report: the
    ; last term is `format == ModuleKindCommonJS` and the format is None.
    ;
    ; ★★ IT IS PORTED RATHER THAN REPORTED, which is the opposite decision to the
    ; three inert checks around it, and the difference is what stands behind the
    ; last term: nothing. Every step of this function is ported machinery, so a
    ; CommonJS format arriving later needs no code — while the Promise check would
    ; need a binder flag this port does not set and the two record… functions a
    ; deferred queue that is empty by construction. A report claims *unmeasured*;
    ; this function is measured and answers nothing.
    ;
    ; ★ The IsClassLike exclusion is this check's own and does not appear in the
    ; require/exports one above: a class named `Object` is the business of
    ; checkClassNameCollisionWithObject, which the head calls through the class-like
    ; branch and which has its own message.
    procedure check_collision_with_global_object_in_generated_code(this, node: ref[AstNode], name: ref[AstNode]?)
    {
        if name = null
            return
        if Parser.is_class_like_node(node)
            return
        if Checker.need_collision_check_for_identifier(node, name, "Object") = false
            return
        if AstNode.kind_of(node) = KindModuleDeclaration
        {
            if b.get_module_instance_state(node) <> ModuleInstanceStateInstantiated
                return
        }
        let parent Checker.get_declaration_container(node)
        if Checker.kind_or_unknown(parent) <> KindSourceFile
            return
        if b.is_external_or_common_js_module() = false
            return
        if emit_module_format <> ModuleKindCommonJS
            return
        this.error_skipped_on_no_emit(name, DiagDuplicate_identifier_0_Compiler_reserves_name_1_in_top_level_scope_of_a_module, this.declaration_name_to_string(name), this.declaration_name_to_string(name))
    }

    ; checkCollisionWithGlobalPromiseInGeneratedCode's GUARD, which is the whole of
    ; what is portable here.
    ;
    ; ★★★ WHAT STANDS BEHIND IT IS A DEFERRED FIELD MEETING ITS FIRST READER AND
    ; STILL NOT BECOMING OBSERVABLE — §3.5as from the other side. The report needs
    ; `parent.Flags & NodeFlagsHasAsyncFunctions`, a SourceFile node flag the
    ; binder deliberately does not set (bind_function_declaration and
    ; bind_function_expression each say so, with the argument *no dump here can see
    ; it*). This is the reader those notes asked for — and it sits behind a guard
    ; that ES2025 closes, so the flag stays unobservable and the two binder notes
    ; stay true. That is worth writing down precisely because it looks like the
    ; moment they expire.
    procedure check_collision_with_global_promise_in_generated_code(this, node: ref[AstNode], name: ref[AstNode]?)
    {
        if name = null
            return
        if language_version >= ScriptTargetES2017
            return
        if Checker.need_collision_check_for_identifier(node, name, "Promise") = false
            return
        if AstNode.kind_of(node) = KindModuleDeclaration
        {
            if b.get_module_instance_state(node) <> ModuleInstanceStateInstantiated
                return
        }
        let parent Checker.get_declaration_container(node)
        if Checker.kind_or_unknown(parent) <> KindSourceFile
            return
        let pb this.binder_of_node(parent)
        if pb.is_external_or_common_js_module() = false
            return
        if (AstNode.flags_of(parent as ref[AstNode]) & NodeFlagsHasAsyncFunctions) <> 0
            this.error_skipped_on_no_emit(name, DiagDuplicate_identifier_0_Compiler_reserves_name_1_in_top_level_scope_of_a_module_containing_async_functions, this.declaration_name_to_string(name), this.declaration_name_to_string(name))
    }

    ; recordPotentialCollisionWithWeakMapSetInGeneratedCode's GUARD. Behind it:
    ; addDeferredDiagnostic of checkWeakMapSetCollision, which reads
    ; NodeCheckFlagsContainsClassWithPrivateIdentifiers off the enclosing
    ; block-scope container's nodeLinks — a table this port does not have, filled
    ; by setNodeLinksForPrivateIdentifierScope, which nothing calls yet.
    ;
    ; ★ TWO NAMES, ONE CALL SITE: the reference asks needCollisionCheckForIdentifier
    ; for `WeakMap` and `WeakSet` in one disjunction, so the down-level private-name
    ; transform's two reserved names are one condition.
    procedure record_potential_collision_with_weak_map_set_in_generated_code(this, node: ref[AstNode], name: ref[AstNode])
    {
        if language_version > ScriptTargetES2021
            return
        var wanted false
        if Checker.need_collision_check_for_identifier(node, name, "WeakMap")
            set wanted: true
        if Checker.need_collision_check_for_identifier(node, name, "WeakSet")
            set wanted: true
        if wanted = false
            return
        this.add_deferred_check(DeferredCheckKindWeakMapSet, node, null, false)
    }

    ; checkWeakMapSetCollision
    procedure check_weak_map_set_collision(this, node: ref[AstNode])
    {
        let enclosing_block_scope Checker.get_enclosing_block_scope_container(node)
        if enclosing_block_scope = null
            return
        if this.node_link_of(enclosing_block_scope as ref[AstNode]).contains_class_with_private_identifiers
        {
            let name AstNode.name_of(node)
            if Checker.kind_or_unknown(name) = KindIdentifier
                this.error_skipped_on_no_emit(node, DiagCompiler_reserves_name_0_when_emitting_private_identifier_downlevel, Checker.arg_text(AstNode.identifier_text_of(name)))
        }
    }

    ; setNodeLinksForPrivateIdentifierScope
    procedure set_node_links_for_private_identifier_scope(this, node: ref[AstNode])
    {
        if Checker.kind_or_unknown(AstNode.name_of(node)) <> KindPrivateIdentifier
            return
        if (language_version < ScriptTargetES2022) or (language_version < ScriptTargetLatest) or (use_define_for_class_fields = false)
        {
            var lexical_scope Checker.get_enclosing_block_scope_container(node)
            while lexical_scope <> null
            {
                let ls lexical_scope as ref[AstNode]
                set this.node_link_of(ls).contains_class_with_private_identifiers: true
                set lexical_scope: Checker.get_enclosing_block_scope_container(ls)
            }
        }
    }

    ; recordPotentialCollisionWithReflectInGeneratedCode's GUARD. Behind it,
    ; checkReflectCollision, which reads
    ; NodeCheckFlagsContainsSuperPropertyInStaticInitializer off a class
    ; expression's MEMBERS or off a function expression itself — the same nodeLinks
    ; table as the WeakMap check, filled by a marker this port does not set.
    ;
    ; ★ The null test on the name is INSIDE the conjunction upstream rather than in
    ; front of it, and it is kept in that position because the guard's order is what
    ; a control substitutes; need_collision_check_for_identifier treats a null
    ; identifier as *any name*, which is exactly the reading a missing test would
    ; give it.
    procedure record_potential_collision_with_reflect_in_generated_code(this, node: ref[AstNode], name: ref[AstNode]?)
    {
        if name = null
            return
        if language_version > ScriptTargetES2021
            return
        if Checker.need_collision_check_for_identifier(node, name, "Reflect") = false
            return
        this.add_deferred_check(DeferredCheckKindReflect, node, null, false)
    }

    ; checkReflectCollision
    procedure check_reflect_collision(this, node: ref[AstNode])
    {
        var has_collision false
        if node.kind = KindClassExpression
        {
            let members AstNode.member_list_of(node)
            if members <> null
            {
                let ml members as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (ml.get_length() as int)
                {
                    let m ml[i as size_t]
                    set i: i + 1
                    if m = null
                        continue
                    if this.node_link_of(m as ref[AstNode]).contains_super_property_in_static_initializer
                    {
                        set has_collision: true
                        break
                    }
                }
            }
        }
        else
        {
            if node.kind = KindFunctionExpression
            {
                if this.node_link_of(node).contains_super_property_in_static_initializer
                    set has_collision: true
            }
            else
            {
                let container Checker.get_enclosing_block_scope_container(node)
                if container <> null
                {
                    if this.node_link_of(container as ref[AstNode]).contains_super_property_in_static_initializer
                        set has_collision: true
                }
            }
        }
        if has_collision
        {
            if Checker.kind_or_unknown(AstNode.name_of(node)) = KindIdentifier
                this.error_skipped_on_no_emit(node, DiagDuplicate_identifier_0_Compiler_reserves_name_1_when_emitting_super_references_in_static_initializers, this.declaration_name_to_string(AstNode.name_of(node)), "Reflect")
        }
    }

    ; checkClassNameCollisionWithObject, whole — the two-term function slice 58's
    ; work list called a stop.
    ;
    ; ★★ ITS REPORT IS LIVE AND IT IS THE FORMAT THAT MAKES IT SO: `class Object
    ; {}` reports TS2725 here because the stub program answers ModuleKindNone,
    ; which is below ES2015. Under the option-derived ES2022 the same source would
    ; be silent — see Checker.emit_module_format, where the two flips of this one
    ; constant are set out.
    ;
    ; ★ The message names the module kind (`… with module '{0}'`) and the argument
    ; is c.moduleKind.String(), i.e. the DERIVED ES2022 rather than the file's
    ; format. Arguments are not computed here (the dump is code and span), so the
    ; two values meeting in one report is a curiosity rather than a decision — but
    ; it is the reason the field and the option are kept apart.
    procedure check_class_name_collision_with_object(this, name: ref[AstNode])
    {
        if Checker.identifier_text_equals(name, "Object") = false
            return
        if emit_module_format >= ModuleKindES2015
            return
        this.error_on_node(name, DiagClass_name_cannot_be_Object_when_targeting_ES5_and_above_with_module_0, Checker.module_kind_name(module_kind))
    }

    ; checkCollisionsForDeclarationName, whole.
    ;
    ; ★★ THE NULL TEST IS THE FUNCTION'S FIRST LINE AND IT IS NOT REDUNDANT: three
    ; of the four callers pass `node.Name()` of a node that need not have one —
    ; `export default class {}` has no name, and so has the `class {}` whose own
    ; missing-name report check_class_declaration makes one call earlier.
    ;
    ; ★ The two branches at the bottom are `IsClassLike` and `IsEnumDeclaration`,
    ; which is the whole of the reference's `else if` chain — a module declaration
    ; and an import binding fall through both and are done with the five checks
    ; above.
    procedure check_collisions_for_declaration_name(this, node: ref[AstNode], name: ref[AstNode]?)
    {
        if name = null
            return
        this.check_collision_with_require_exports_in_generated_code(node, name)
        this.check_collision_with_global_object_in_generated_code(node, name)
        this.check_collision_with_global_promise_in_generated_code(node, name)
        this.record_potential_collision_with_weak_map_set_in_generated_code(node, name)
        this.record_potential_collision_with_reflect_in_generated_code(node, name)
        if Parser.is_class_like_node(node)
        {
            this.check_type_name_is_reserved(name, DiagClass_name_cannot_be_0)
            if (AstNode.flags_of(node) & NodeFlagsAmbient) = 0
                this.check_class_name_collision_with_object(name)
            return
        }
        if AstNode.kind_of(node) = KindEnumDeclaration
            this.check_type_name_is_reserved(name, DiagEnum_name_cannot_be_0)
    }

    ; checkImportBinding — the head's fourth caller, and one line long here.
    ;
    ; ★★ THE NODE IS THE BINDING AND NOT THE DECLARATION, which is what makes the
    ; collision checks above ask their kind questions of an ImportClause, a
    ; NamespaceImport or an ImportSpecifier: `import a from "m"` passes the CLAUSE,
    ; `import * as ns from "m"` the namespace import, `import { a } from "m"` each
    ; specifier. Those three kinds are exactly the type-only arm of
    ; need_collision_check_for_identifier, which is why that arm is live code rather
    ; than transcription.
    ;
    ; ★ checkAliasSymbol is the stop: it resolves the alias target and compares its
    ; meaning against the local declaration space, i.e. the symbol table. Behind it
    ; stand checkModuleExportName (the first reading that could tell ES2022 from
    ; None — see Checker.module_kind) and the ImportDefault emit helper, which the
    ; format kills.
    procedure check_import_binding(this, node: ref[AstNode])
    {
        let um30 this.unported_mark()
        this.check_collisions_for_declaration_name(node, AstNode.name_of(node))
        this.check_alias_symbol(node)
        if this.unported_mark() <> um30
            return
        if AstNode.kind_of(node) = KindImportSpecifier
        {
            this.check_module_export_name(AstNode.property_name_of(node), true)
            ; The ImportDefault emit helper is behind `emit_module_format ==
            ; ModuleKindCommonJS`, and the stub program answers None.
            if Checker.module_export_name_is_default(Checker.property_name_or_name_of(node))
            {
                if emit_module_format = ModuleKindCommonJS
                    this.check_external_emit_helpers(node, ExternalEmitHelpersImportDefault)
            }
        }
    }

    ; ── slice 60: the type parameter, the head slice 52 stubbed ───────────────
    ;
    ; ★★★ THE HEAD FOUR ARMS ALREADY CALL, PORTED FROM ITS REPORT INWARDS.
    ; checkTypeParameters was slice 52's boundary and has been the largest
    ; actionable row of the unported column ever since (1 115 at stage 2, read at
    ; KindTypeParameter). Its loop body is four steps, and the fork that decides the
    ; slice is that only ONE of them is the type dimension: checkTypeParameter's
    ; getDeclaredTypeOfTypeParameter. The default-ordering report, the duplicate
    ; report and the grammar half of checkTypeParameter are all reachable without a
    ; type, and two of them need no symbol table either.
    ;
    ; ★★★ THE DUPLICATE-NAME LOOP IS PORTED WHOLE AND IT IS THE FIRST CHECK IN THIS
    ; FILE THAT COMPARES TWO SYMBOLS. It reads `typeParameterDeclarations[j].Symbol()
    ; == node.Symbol()` — `Node.Symbol()`, the slot the BINDER wrote, NOT
    ; getSymbolOfDeclaration — so it needs neither the merge nor the late-bound
    ; lookup that gate every other symbol question in this file. That distinction is
    ; the whole reason the report is live: the same line spelled
    ; getSymbolOfDeclaration two functions away is this slice's stop.
    ;
    ; ★★★ `for j := range i` REPORTS ONCE PER MATCHING PREDECESSOR, NOT ONCE PER
    ; DUPLICATE, and the first reading of that written here was WRONG. `<T, T, T>`
    ; produces THREE diagnostics — one on the second T (j=0) and TWO on the third
    ; (j=0 and j=1), both at the same span — not two. The inner loop has no break
    ; and the outer one no memory, so the count is the number of PAIRS. Measured
    ; against the reference on `checker_type_parameter_duplicate.ts`, which is why
    ; that fixture carries three parameters rather than two: at two, both readings
    ; give the same answer.
    ;
    ; ★★ THE TWO REPORTS OF THIS LOOP BODY HAVE DIFFERENT SPANS, and a fixture
    ; without a modifier or a constraint cannot tell them apart. The ordering report
    ; spans the whole PARAMETER (`c.error(node, …)`) — `in out U` in
    ; `interface I<T = string, in out U>`, modifiers included — while the duplicate
    ; report spans the NAME alone (`c.error(node.Name(), …)`) — the bare `V` of
    ; `V extends number`. Both halves are pinned by
    ; `checker_type_parameter_spans.ts`.
    ;
    ; ★ seenDefault is a STICKY flag over the whole list and the report fires on a
    ; parameter with NO default that FOLLOWS one — `<T = string, U>` reports on `U`.
    ; §3.5k's rule with nothing to translate: the reference's own local, in the
    ; reference's own scope.
    procedure check_type_parameters(this, type_parameters: ref[Array[ref[AstNode]?]]?)
    {
        if type_parameters = null
            return
        let count AstNode.list_count(type_parameters)
        var seen_default false
        var i 0
        while i < count
        {
            let node AstNode.child_in_list(type_parameters, i)
            this.check_type_parameter(node)
            let default_type_node AstNode.type_parameter_default_of(node)
            if default_type_node <> null
            {
                set seen_default: true
                this.check_type_parameters_not_referenced(default_type_node, type_parameters, i)
            }
            else
            {
                if seen_default
                    this.error_on_node(node, DiagRequired_type_parameters_may_not_follow_optional_type_parameters)
            }
            var j 0
            while j < i
            {
                if AstNode.symbol_of(AstNode.child_in_list(type_parameters, j)) = AstNode.symbol_of(node)
                    this.error_on_node(AstNode.name_of(node), DiagDuplicate_identifier_0, this.declaration_name_to_string(AstNode.name_of(node)))
                set j: j + 1
            }
            set i: i + 1
        }
    }

    ; checkTypeParametersNotReferenced, WHOLE since slice 159 — the walk, the
    ; resolution and the comparison against the parameters at and after `index`.
    ;
    ; ★★★ THE FUNCTION IS A FULL CHILD WALK WHOSE BODY DOES NOTHING EXCEPT AT A
    ; TypeReference, so porting it as one report on entry would have claimed a hole
    ; for `<T = string>`, `<T = 1>` and `<T = keyof any>` — none of which reaches
    ; getTypeFromTypeReference at all. §3.5ag's rule (compute WHETHER, not WHICH)
    ; read one level up: the walk decides whether the resolution is ASKED, and the
    ; walk is free.
    ;
    ; ★★ THE REFERENCE'S `visit` RETURNS `node.ForEachChild(visit)` AND THAT VALUE
    ; IS ALWAYS false, so the walk is exhaustive and the early-exit machinery is
    ; dead: a leaf's ForEachChild answers false, and no arm of `visit` returns true
    ; on its own. Ported as a plain recursion rather than as a bool-returning one,
    ; because a return value nothing can be is a shape the next reader has to
    ; disprove.
    ;
    ; ★ The `for i := index; i < len(typeParameters); i++` comparison is against
    ; getSymbolOfDeclaration and NOT against the binder's slot, unlike the
    ; duplicate-name loop in the caller — the two loops sit ten lines apart in the
    ; reference and read the symbol differently, which is why both spellings are
    ; written out here rather than shared.
    ;
    ; ★★★ WHAT STOOD HERE UNTIL SLICE 159 WAS A PRICE, AND A PRICE IS NOT A
    ; REASON. The paragraph argued that checkSourceElement(DefaultType) runs first
    ; and reports for every type kind that can contain a type reference, so the
    ; report is unobservable, and it MEASURED that: *slice 60's g17 replaces this
    ; report with a diagnostic and finds one unit / two diagnostics on stage 1*.
    ; The measurement is right and the conclusion did not follow — a stop is not
    ; priced by the diagnostics it hides but by the UNITS it takes out of the
    ; comparison, and this one was hit by 85 stage-2 units and completed 23. ★The
    ; asymmetry is the lesson: a number from the small corpus can never retire a
    ; wall, because the small corpus is where a wall is cheapest.
    procedure check_type_parameters_not_referenced(this, root: ref[AstNode]?, type_parameters: ref[Array[ref[AstNode]?]], index: int)
    {
        if root = null
            return
        if AstNode.kind_of(root) = KindTypeReference
        {
            ; WHOLE since slice 159.
            ;
            ; ★★★ THE ROW WAS `get_type_from_type_reference`, WHICH THIS FILE
            ; DEFINES — §3.5eo, and the tags scan named it. What kept it standing
            ; is the paragraph above: it prices the report at *one unit / two
            ; diagnostics on stage 1*, which is true and is an argument about the
            ; DIAGNOSTIC, not about the row. At stage 2 the same row is hit by 85
            ; units and completes 23 — a measurement taken on the small corpus
            ; cannot retire a wall on the large one, and nothing here said which
            ; corpus the number came from.
            ;
            ; ★★ THE MARK GUARDS THE COMPARISON AND NOT THE WALK: a type this port
            ; cannot resolve makes the loop unanswerable, so the arm returns rather
            ; than comparing a null symbol against the parameters — but the
            ; RECURSION below still runs, because the reference's `visit` descends
            ; unconditionally and the children are where the next reference sits.
            let mark this.unported_mark()
            let rt this.get_type_from_type_reference(root as ref[AstNode])
            if this.unported_mark() = mark
            {
                if rt <> null
                {
                    let ty rt as ref[Type]
                    if (ty.flags & TypeFlagsTypeParameter) <> 0
                    {
                        if ty.symbol <> null
                        {
                            let want ty.symbol as ref[Symbol]
                            let tp_count type_parameters.get_length() as int
                            var ti index
                            while ti < tp_count
                            {
                                let sym this.get_symbol_of_declaration(type_parameters[ti])
                                if sym <> null
                                {
                                    if (sym as ref[Symbol]) = want
                                        this.error_on_node(root, DiagType_parameter_defaults_can_only_reference_previously_declared_type_parameters)
                                }
                                set ti: ti + 1
                            }
                        }
                    }
                }
            }
        }
        let count AstNode.child_count(root)
        var i 0
        while i < count
        {
            this.check_type_parameters_not_referenced(AstNode.child_at(root, i), type_parameters, index)
            set i: i + 1
        }
    }

    ; checkTypeParameter, whole since slice 81 except its last check.
    ;
    ; ★★★ THE FIRST OF THE THREE REASONS THE LAST LINE IS UNOBSERVABLE EXPIRED WITH
    ; SLICE 81, AND THE OTHER TWO DID NOT — which is why the list is kept rather
    ; than trimmed. As written for slice 60 it read *THE STOP IS UNCONDITIONAL*:
    ; getDeclaredTypeOfTypeParameter runs for every type parameter there is, so the
    ; arm ALWAYS recorded and the deferred registration below it could never be the
    ; first report. That is now FALSE — a type parameter with no constraint and no
    ; default walks the whole arm silently — and it changes nothing, because reasons
    ; (2) and (3) are independent of it. **(2)** Even without the stop it is not
    ; first: the drain runs after every declaration, and all
    ; three container kinds the deferred guard admits report from their own arms —
    ; which is the sentence check_unused_renamed_binding_elements already carries,
    ; *a deferred element does not remove a report from the unit, it hands the unit
    ; to its container's*. **(3)** And the strongest one: `check_source_file` returns
    ; as soon as any statement has reported, and `check_deferred_nodes` sits BELOW
    ; that return — so for a type parameter the drain does not report late, it never
    ; RUNS. The deferred arm is ported anyway, for the reason check_deferred_nodes
    ; was left in place empty in the first place (the arm that first defers has to
    ; find the drain there) and for §3.5cz's f14 reason (not emitting it would claim
    ; the drain is ported). ★Its cost is held to a number rather than to an
    ; argument: slice 60's g14 lifts reason (3) and probes the arm with a
    ; diagnostic — 30 units of stage 1 — g15 opens the guard and reaches 61, and g16
    ; removes the registration and returns to the baseline. ★The successor is named:
    ; lifting that early return for real is a slice of its own, and the reference has
    ; no such exit.
    ;
    ; ★★ checkTypeNameIsReserved IS BELOW THE STOP AND IS PORTED, which is this
    ; file's convention since slice 52 and is sound for the reason it always is:
    ; record_unported MARKS the unit and does not RETURN, and diagcheck's relation
    ; is a SUBSEQUENCE — so skipping the three type reports between the stop and
    ; this one leaves the order intact. `type never<T> {}` and `interface I<any> {}`
    ; therefore report TS2368 today.
    ;
    ; ★★ THE TWO checkSourceElement CALLS ARE WHERE SLICE 60's HISTOGRAM WENT, and
    ; slice 81 reads the same two type nodes a SECOND time for a different purpose.
    ; A constraint or a default that is a KEYWORD type has no arm at all
    ; (kind_has_no_check_arm), so `<T extends string>` walks silently; one that is a
    ; TypeReference or a TypeLiteral lands in the two rows the work list already
    ; names. That is slice 50's *resolution moving one level down* for the third
    ; time. ★And it is why the two halves of this arm cannot be told apart by a
    ; work-list row alone: the SAME tag can now come from the checkSourceElement
    ; walk or from get_type_from_type_node underneath the constraint, which is what
    ; the mark below is for.
    ;
    ; ★ The Expression slot is the parser's recovery for `<T extends 1>` — exactly
    ; one of constraint and expression is ever set — and its report is the FIRST
    ; token of the expression, not the whole of it.
    procedure check_type_parameter(this, node: ref[AstNode]?)
    {
        this.check_grammar_modifiers(node)
        let expr AstNode.type_parameter_expression_of(node)
        if expr <> null
            this.grammar_error_on_first_token(expr, DiagType_expected)
        this.check_source_element(AstNode.type_parameter_constraint_of(node))
        this.check_source_element(AstNode.type_parameter_default_of(node))

        ; typeParameter := c.getDeclaredTypeOfTypeParameter(c.getSymbolOfDeclaration(node))
        ; and the three checks that read it: getBaseConstraintOfType (forced for its
        ; circularity errors), the circular-default report TS2716, and the
        ; constraint/default assignability TS2344 through checkTypeAssignableTo.
        ;
        ; ★★★ SLICE 65 RE-TAGGED IT AND MOVED NOTHING; SLICE 66 ANSWERS IT AND
        ; MOVES ONE LINE, and the two facts belong to the same row.
        ; getDeclaredTypeOfTypeParameter is FOUR lines — it mints a type parameter
        ; and memoises it — so the 1 317 units this row carried were never waiting
        ; on code, they were waiting on the Type payload that slice 66 brings. What
        ; stops the arm now is the FIRST of the three checks that READ the type:
        ; getBaseConstraintOfType, which the reference calls purely to force the
        ; circularity errors out.
        ;
        ; ★ Asking for the type before reporting is what makes the ported function
        ; REACHED — the other caller (appendTypeParameters) is a loop that cannot
        ; run while every generic declaration stops here, so without this line the
        ; four lines would be dead code claiming to be a port (§3.5be).
        ; ★★★ SLICE 81 ANSWERS THE FIRST TWO OF THE THREE CHECKS AND THE STOP MOVES
        ; TO THE THIRD. getBaseConstraintOfType is called for its ERRORS and its
        ; answer discarded — the reference's own comment is *Resolve base constraint
        ; to reveal circularity errors* — and the circular-DEFAULT test beside it is
        ; a slot comparison. What stops the arm now is checkTypeAssignableTo, and it
        ; is reached only when the parameter has BOTH a constraint and a default,
        ; which is why the row shrinks rather than moving intact.
        ;
        ; ★★ THE MARK GUARDS THE TWO REPORTS RATHER THAN THE WALK: a stop underneath
        ; (a constraint whose type node this port cannot resolve) leaves the
        ; constraint unknown, so reporting a circular default or an assignability
        ; failure from there would be a diagnostic derived from an incomplete
        ; answer. The three lines below the block run either way, for the reason the
        ; header gives.
        let tp_symbol this.symbol_of_declaration(node)
        if tp_symbol <> null
        {
            let tp this.get_declared_type_of_type_parameter(tp_symbol as ref[Symbol])
            if tp <> null
            {
                let t tp as ref[Type]
                let mark this.unported_mark()
                let ignored this.get_base_constraint_of_type(t)
                if this.unported_mark() = mark
                {
                    ; `if c.getResolvedTypeParameterDefault(typeParameter) ==
                    ; c.circularConstraintType { c.error(tpNode.DefaultType, …) }`
                    let rd this.get_resolved_type_parameter_default(t)
                    if rd <> null
                    {
                        if (rd as ref[Type]) = circular_constraint_type
                        {
                            let name_arg14 this.type_arg(t)
                            this.error_on_node_or_null(AstNode.type_parameter_default_of(node), DiagType_parameter_0_has_a_circular_default, name_arg14)
                        }
                    }
                    let constraint_type this.get_constraint_of_type_parameter(t)
                    let default_type this.get_default_from_type_parameter(t)
                    if this.unported_mark() = mark
                    {

                        if constraint_type <> null
                        {
                            if default_type <> null
                            {
                                ; ── slice 124: TS2344 ────────────────────────
                                ; checkTypeAssignableTo(defaultType,
                                ; getTypeWithThisArgument(instantiateType(
                                ; constraintType, newSimpleTypeMapper(
                                ; typeParameter, defaultType)), defaultType,
                                ; false), tpNode.DefaultType, TS2344).
                                ;
                                ; ★The mapper is a SINGLE pair, which
                                ; `new_type_mapper` expresses as two one-element
                                ; lists — `newSimpleTypeMapper` upstream is that
                                ; and a fast path, and the fast path is not
                                ; observable.
                                let sources this.new_type_list(null)
                                let targets this.new_type_list(null)
                                sources.add(t)
                                targets.add(default_type)
                                let mapper this.new_type_mapper(sources, targets)
                                let inst this.instantiate_type(constraint_type as ref[Type], mapper)
                                if this.unported_mark() <> mark
                                    return
                                if inst <> null
                                {
                                    let target this.get_type_with_this_argument(inst as ref[Type], default_type, false)
                                    if this.unported_mark() <> mark
                                        return
                                    if target <> null
                                        this.check_type_assignable_to(default_type as ref[Type], target as ref[Type], AstNode.type_parameter_default_of(node), DiagType_0_does_not_satisfy_the_constraint_1)
                                }
                            }
                        }
                    }
                }
            }
        }

        this.check_type_name_is_reserved(AstNode.name_of(node), DiagType_parameter_name_cannot_be_0)
        this.check_node_deferred(node)
    }

    ; getTypeParameterModifiers — the OR of every declaration's modifier flags,
    ; masked to the three that can stand on a type parameter.
    ;
    ; ★★★ IT IS THE WHOLE OF THIS SLICE'S PRODUCT, AND THE PRODUCT IS ALMOST ALWAYS
    ; A ZERO. `in`/`out` is rare — 13 units of 18 317 reach the marker arm at stage
    ; 2 and three of those are this slice's own fixtures — so this function answers
    ; 0 for all but a handful and checkTypeParameterDeferred becomes the no-op the
    ; reference's own guard makes it, which is why a thirty-line chapter closes the
    ; largest row by unit that is neither the lib nor a name resolution.
    ;
    ; ★★★ THE WORD *ALMOST* IS THERE BECAUSE THE FIRST DRAFT LEFT IT OUT AND WAS
    ; WRONG. A grep for `in`/`out` type parameters over the stage-1 corpus read
    ; ZERO and this header said so; the grep swept the submodule's testdata and not
    ; `tests/fixtures`, which is 976 of the 1 295 stage-1 cases and which has held
    ; `type F<in T>` since the parser dimension. **A corpus is where the runner
    ; says it is, and this one is two directories.**
    ;
    ; ★ The mask is asked TWICE and the two are different words: this function
    ; masks In|Out|Const because that is the set a type parameter can carry, and
    ; its caller masks the answer again with In|Out because `const` is not a
    ; variance annotation and owes none of what follows. Const is therefore
    ; computed and dropped here, which is the reference's shape and not an
    ; oversight — the second reader (getTypeParameterFromMappedType's `const`
    ; handling) is what the wider mask is for, and it reports elsewhere.
    ;
    ; ★ A type parameter's symbol can carry several declarations only through a
    ; merge, which for a type parameter means a duplicate — so the loop is a fold
    ; over a list that is one long everywhere this corpus reaches. It is a fold
    ; anyway, because the reference's is and because the one-element case is the
    ; fold's own answer.
    function get_type_parameter_modifiers(this, tp: ref[Type]) returns int
    {
        var flags: int ModifierFlagsNone
        let sym tp.symbol
        if sym <> null
        {
            let s sym as ref[Symbol]
            let n Symbol.declaration_count(s)
            var i 0
            while i < n
            {
                set flags: flags | b.modifier_flags(Symbol.declaration_at(s, i))
                set i: i + 1
            }
        }
        flags & (ModifierFlagsIn | ModifierFlagsOut | ModifierFlagsConst)
    }

    ; checkTypeParameterDeferred, whole.
    ;
    ; ★★★ THE GUARD IS A PURE KIND TEST ON THE PARENT AND IT CLOSES THREE QUARTERS
    ; OF THE FUNCTION. A type parameter of a function, a method, a signature or a
    ; constructor type falls through every arm and the deferred check is a NO-OP for
    ; it — not a hole, the reference's own answer.
    ;
    ; ★★★ AND THE OTHER QUARTER IS CLOSED BY A SECOND ZERO, WHICH IS THE SLICE:
    ; `modifiers != 0` is false for every type parameter either corpus contains, so
    ; an interface's, a class's and a type alias's parameter all fall out here too
    ; and the function answers what the reference answers — nothing. What used to
    ; stand at this line was one unconditional report standing for the variance
    ; machinery behind the `if`, and it was the largest row by unit at stage 2
    ; (1 697) that is neither the lib nor a name resolution.
    ;
    ; ★★ THE HEADER THAT STOOD HERE SAID THIS FUNCTION *DOES NOT EXECUTE TODAY*,
    ; AND IT HAD BEEN FALSE SINCE THE DRAIN LANDED. `interface I<T> { }` — four
    ; tokens — reaches it and reaches nothing else, which is why the row is one of
    ; the few whose UNIT count is close to its event count. A sentence about
    ; reachability expires the moment its caller does, and nothing re-reads it.
    ;
    ; ★★★ THE MARKER ARM WAS A WALL WITH A MEASUREMENT AND IT IS PRODUCT SINCE
    ; SLICE 173. What stood here read *the relation cannot answer about two
    ; references to ONE generic target … stops at `common-property-check`, three
    ; functions before `recursiveTypeRelatedTo`*, and named the three pieces the
    ; day would owe — the marker type PAIR, the set, and the head message TS2636.
    ; The dated half of that is at the arm itself; what is worth keeping here is
    ; the reading it got right: the arm is a COMPARISON and not a report, so it
    ; could not be written before the relation could answer, and the set
    ; (`markerTypes`) had to arrive with its readers rather than with this line.
    ;
    ; ★★ THE TYPE-ALIAS ARM IS PRODUCT AND IT IS SLICE 105's DOING. Its condition
    ; reads the declared type of the alias SYMBOL, which had no answer until the
    ; type-alias chapter landed one slice ago — so TS2637 is a report this port
    ; could not have made and can now.
    ;
    ; ★ The mark guards the alias arm for check_type_parameter's reason: an
    ; errorType that came from a STOP has objectFlags 0 exactly like the errorType a
    ; circular alias produces, and reporting from the first would be a diagnostic
    ; derived from an answer this port never computed. The reference's own
    ; errorType — the circular one — still reports, which is what the guard is
    ; written to keep.
    procedure check_type_parameter_deferred(this, node: ref[AstNode]?)
    {
        let parent AstNode.parent_node_of(node)
        let alias_parent AstNode.is_type_or_js_type_alias_declaration(parent)
        var owes false
        if Checker.kind_or_unknown(parent) = KindInterfaceDeclaration
            set owes: true
        if Parser.is_class_like_node(parent)
            set owes: true
        if alias_parent
            set owes: true
        if owes = false
            return
        ; `typeParameter := c.getDeclaredTypeOfTypeParameter(c.getSymbolOfDeclaration(node))`
        let tp_symbol this.symbol_of_declaration(node)
        if tp_symbol = null
            return
        let tp this.get_declared_type_of_type_parameter(tp_symbol as ref[Symbol])
        if tp = null
            return
        let modifiers this.get_type_parameter_modifiers(tp as ref[Type]) & (ModifierFlagsIn | ModifierFlagsOut)
        if modifiers = 0
            return
        let sym this.symbol_of_declaration(parent)
        if sym = null
            return
        var alias_of_non_object false
        if alias_parent
        {
            let mark this.unported_mark()
            let declared this.get_declared_type_of_symbol(sym as ref[Symbol])
            if this.unported_mark() <> mark
                return
            if declared = null
                return
            let d declared as ref[Type]
            if (d.object_flags & (ObjectFlagsAnonymous | ObjectFlagsMapped)) = 0
                set alias_of_non_object: true
        }
        if alias_of_non_object
        {
            this.error_on_node(node, DiagVariance_annotations_are_only_supported_in_type_aliases_for_object_function_constructor_and_mapped_types)
            return
        }
        ; `modifiers == In || modifiers == Out` — a parameter carrying BOTH is
        ; invariant and owes no comparison, which is the reference's own answer and
        ; not a hole; only one of the two reaches the markers.
        var single false
        if modifiers = ModifierFlagsIn
            set single: true
        if modifiers = ModifierFlagsOut
            set single: true
        if single = false
            return
        ; ── slice 173: the comparison, and the wall's reason had expired ────
        ;
        ; ★★★ THE MARKER ARM IS PRODUCT NOW, AND WHAT LICENSED ITS ABSENCE WAS A
        ; MEASUREMENT OF A TREE THAT NO LONGER EXISTS. The header above said *the
        ; relation cannot answer about two references to ONE generic target … stops
        ; at `common-property-check`, three functions before `recursiveTypeRelatedTo`
        ; where the variance comparison lives*, and named the three pieces the day
        ; would owe: the marker PAIR, the SET, and the head message TS2636. All
        ; three arrived without this line being re-read — `recursiveTypeRelatedTo`
        ; with slice 133's structured chapter, `markerTypes` and `create_marker_type`
        ; with slice 137's variance worker, TS2636 with the head-code parameter
        ; slice 138 gave checkTypeAssignableTo. The note was a claim about somebody
        ; else's line and it expired in three places at once.
        ;
        ; ★★★ THE DIRECTION IS THE ANNOTATION'S AND IT IS THE WHOLE CHECK. `out T`
        ; claims T appears only covariantly, so substituting the SUB marker must be
        ; assignable to substituting the SUPER one; `in T` claims the opposite and
        ; the pair is handed over the other way round. A violation is the reference's
        ; TS2636 at the type parameter's own node.
        ;
        ; ★★ THE MARK GUARDS THE MARKERS AND NOT THE COMPARISON. `create_marker_type`
        ; instantiates the declared type, and an instantiation that stopped is not a
        ; marker — comparing two of those would be a diagnostic derived from an
        ; answer this port never computed. The comparison itself needs no guard
        ; here: check_type_related_to_ex takes its own mark and withholds the report
        ; when the relation could not answer.
        let mark this.unported_mark()
        var lower: ref[Type]? null
        var upper: ref[Type]? null
        if modifiers = ModifierFlagsOut
        {
            set lower: this.create_marker_type(sym as ref[Symbol], tp as ref[Type], this.get_marker_sub_type_for_check())
            set upper: this.create_marker_type(sym as ref[Symbol], tp as ref[Type], this.get_marker_super_type_for_check())
        }
        if modifiers = ModifierFlagsIn
        {
            set lower: this.create_marker_type(sym as ref[Symbol], tp as ref[Type], this.get_marker_super_type_for_check())
            set upper: this.create_marker_type(sym as ref[Symbol], tp as ref[Type], this.get_marker_sub_type_for_check())
        }
        if this.unported_mark() <> mark
            return
        if lower = null
            return
        if upper = null
            return
        ; ★★ THE SAVE/RESTORE IS THE REFERENCE'S AND IT IS THE IDENTITY: upstream
        ; writes `saveVarianceTypeParameter := typeParameter` — the NEW value, not
        ; the old — so the field keeps the last parameter checked rather than being
        ; unwound. Transcribed rather than corrected: the field's only reader is
        ; the node builder's marker naming, which asks it only while one of the two
        ; ForCheck markers is being printed, and those escape no other comparison.
        let save_variance_type_parameter tp
        set this.variance_type_parameter: tp
        this.check_type_assignable_to(lower as ref[Type], upper as ref[Type], node, DiagType_0_is_not_assignable_to_type_1_as_implied_by_variance_annotation)
        set this.variance_type_parameter: save_variance_type_parameter
    }


    ; ── slice 61: the type-node arms of checkSourceElement ───────────────────
    ;
    ; ★★★ THE CHAPTER SLICE 60's TWO RECURSIONS OPENED. checkTypeParameter hands a
    ; constraint and a default to checkSourceElement, and checkSignatureDeclaration
    ; has been handing it a return-type annotation since slice 52 — so the switch's
    ; TYPE half has been reached for nine slices with not one arm written, and its
    ; four biggest rows (`check` at TypeLiteral, TypeReference, UnionType and
    ; ArrayType) stood at 941 units of stage 2 on slice 60's work list. This slice
    ; fills the half: every `case` of checkSourceElementWorker whose node is a TYPE
    ; node, plus the five signature kinds whose case is a call to a function this
    ; port already has.
    ;
    ; ★★★ MOST OF THE CHAPTER IS RECURSION, AND THAT IS WHY IT IS ONE SLICE RATHER
    ; THAN NINETEEN. SIXTEEN of the nineteen cases walk into children — only
    ; ThisType, TypeQuery and TypePredicate do not — and FOUR of the sixteen do
    ; nothing else at all (ArrayType, the Parenthesized/Optional/Rest trio,
    ; TypeOperator and ConditionalType are complete on arrival). The type system
    ; stands behind exactly one line of each of the rest. Porting one arm and
    ; leaving its neighbour would stop a walk in the middle: `(T)[]` needs ArrayType
    ; AND ParenthesizedType, `keyof T[]` needs TypeOperator AND ArrayType, and a
    ; TypeLiteral's members are index signatures and call signatures. The unit of
    ; work here is the CLOSURE of the walk, not the function.
    ;
    ; ★★★ AND THE ARM THAT COSTS NOTHING IS THE ONE WITH THE LARGEST YIELD PER LINE:
    ; `case ConstructorType, FunctionType, CallSignature, ConstructSignature,
    ; IndexSignature: c.checkSignatureDeclaration(node)` is FIVE kinds routed to a
    ; function slice 52 wrote whole. Nothing was missing but the wiring, and the
    ; wiring was missing because no walk reached those kinds until this one.
    ;
    ; ★★ THE SEVEN STOPS ARE ONE DIMENSION UNDER SEVEN NAMES, and they are tagged
    ; per CALL rather than folded, because that is what the reference writes:
    ; checkThisType calls getTypeFromThisTypeNode, checkTypeQuery calls
    ; getTypeFromTypeQueryNode, checkIndexedAccessType calls
    ; getTypeFromIndexedAccessTypeNode, checkTypeLiteral calls
    ; getTypeFromTypeLiteralOrFunctionOrConstructorTypeNode, checkMappedType calls
    ; getTypeFromMappedTypeNode, and the rest call getTypeFromTypeNode. A single
    ; folded tag would read as one function to port and it is a table with a switch
    ; in front of it; seven rows say which entries the corpus actually reaches.

    ; ForEachChild(c.checkSourceElement) — the body of four arms
    ; (ParenthesizedType/OptionalType/RestType, ConditionalType, IndexedAccessType's
    ; first line and checkJSDocType's second), written once. §3.9d's index pair.
    procedure check_each_child_source_element(this, node: ref[AstNode])
    {
        let count AstNode.child_count(node)
        var i 0
        while i < count
        {
            this.check_source_element(AstNode.child_at(node, i))
            set i: i + 1
        }
    }

    ; checkArrayType, whole — one line, and one of the four arms this slice brings
    ; that are COMPLETE on arrival with nothing written down beside them (the others
    ; are the Parenthesized/Optional/Rest trio, TypeOperator and ConditionalType).
    ; Before slice 61 this file had none.
    procedure check_array_type(this, node: ref[AstNode])
        this.check_source_element(AstNode.array_element_type_of(node))

    ; checkUnionOrIntersectionType, WHOLE since slice 94 — two lines, and the second
    ; of them is `getTypeFromTypeNode(node)`, which for a UNION node is now a call.
    ; ★The INTERSECTION half still stops, inside getTypeFromTypeNode's tail and
    ; under its own kind, which is the split the tag was already able to express.
    procedure check_union_or_intersection_type(this, node: ref[AstNode])
    {
        this.check_each_child_source_element(node)
        this.get_type_from_type_node(node)
    }

    ; checkThisType, whole: one call, and since slice 137 it is that call.
    procedure check_this_type(this, node: ref[AstNode])
        this.get_type_from_this_type_node(node)

    ; checkTypeQuery, whole, and likewise entirely its stop. ★getTypeFromTypeQueryNode
    ; resolves the entity name to a symbol and asks for its type, so this row is the
    ; symbol table and the type table at once — which is why it is not folded into
    ; the getTypeFromTypeNode row even though that switch would reach it.
    procedure check_type_query(this, node: ref[AstNode])
        this.get_type_from_type_query_node(node)

    ; checkConditionalType, whole — `node.ForEachChild(c.checkSourceElement)` and
    ; nothing else. ★It is the arm that makes an INFER type reachable: `T extends
    ; infer U ? U : never` walks into the extendsType, which is where the only legal
    ; `infer` lives.
    procedure check_conditional_type(this, node: ref[AstNode])
        this.check_each_child_source_element(node)

    ; checkIndexedAccessType, whose second line is checkIndexedAccessIndexType over
    ; getTypeFromIndexedAccessTypeNode — the index constraint report TS2537 and the
    ; whole of the indexed-access relation.
    procedure check_indexed_access_type(this, node: ref[AstNode])
    {
        this.check_each_child_source_element(node)
        let t this.get_type_from_indexed_access_type_node(node)
        if t = null
            return
        this.check_indexed_access_index_type(t as ref[Type], node)
    }

    ; checkTypeOperator, whole — its grammar check and one recursion, with nothing
    ; behind it. ★The recursion is `node.Type()`, i.e. the operand alone; a
    ; TypeOperatorNode has no other child, so this and a ForEachChild walk coincide
    ; and the reference's spelling is kept.
    procedure check_type_operator(this, node: ref[AstNode])
    {
        this.check_grammar_type_operator_node(node)
        this.check_source_element(AstNode.type_operator_inner_of(node))
    }

    ; checkGrammarTypeOperatorNode, whole — and it is the READER that closes parser
    ; slice 7's faithfulness note (1). Its entire body is a switch on the OPERATOR,
    ; a field this port did not store until this slice; a `keyof` falls through both
    ; arms and reports nothing.
    ;
    ; ★★★ THE `unique` ARM IS FIVE REPORTS AND EVERY ONE OF THEM IS SYNTACTIC —
    ; where the operand is not the `symbol` keyword, and then which DECLARATION the
    ; operator sits in. That is why the whole function is portable in a slice that
    ; owns no type: `unique symbol` is a claim about a declaration's shape, checked
    ; against modifiers and against the parent chain, and the reference asks for a
    ; type nowhere in it.
    ;
    ; ★★ WalkUpParenthesizedTypes CLIMBS THE PARENT CHAIN, and reading it as the
    ; descent through a parenthesized type's INNER slot is the mistake its name
    ; invites: `(unique symbol)` inside a variable declaration has to find the
    ; DECLARATION, so the walk goes up while the node it is standing on is a
    ; parenthesized type. It is spelled out here rather than given an accessor of
    ; its own because it has one caller and the loop is three lines.
    ;
    ; ★ THE SPANS ARE THREE, NOT ONE, and they do not follow the arms: the
    ; wrong-operand report is on the OPERAND, the binding-name report and the
    ; default `not allowed here` are on the OPERATOR NODE, and the const and the two
    ; property reports are on the enclosing declaration's NAME. That is what
    ; checker_type_operator_unique.ts exists to pin, and g09 is the row that moves
    ; one of them into another's place.
    procedure check_grammar_type_operator_node(this, node: ref[AstNode]) returns bool
    {
        let op AstNode.type_operator_operator_of(node)
        if op = KindUniqueKeyword
        {
            let inner_type AstNode.type_operator_inner_of(node)
            if Checker.kind_or_unknown(inner_type) <> KindSymbolKeyword
                return this.grammar_error_on_node(inner_type, DiagX_0_expected, "symbol")
            var parent AstNode.parent_node_of(node)
            while Checker.kind_or_unknown(parent) = KindParenthesizedType
                set parent: AstNode.parent_node_of(parent)
            let pk Checker.kind_or_unknown(parent)
            if pk = KindVariableDeclaration
            {
                if Checker.kind_or_unknown(AstNode.name_of(parent)) <> KindIdentifier
                    return this.grammar_error_on_node(node, DiagX_unique_symbol_types_may_not_be_used_on_a_variable_declaration_with_a_binding_name)
                if Checker.is_variable_declaration_in_variable_statement(parent) = false
                    return this.grammar_error_on_node(node, DiagX_unique_symbol_types_are_only_allowed_on_variables_in_a_variable_statement)
                if (AstNode.flags_of((AstNode.parent_node_of(parent)) as ref[AstNode]) & NodeFlagsConst) = 0
                    return this.grammar_error_on_node(AstNode.name_of(parent), DiagA_variable_whose_type_is_a_unique_symbol_type_must_be_const)
                return false
            }
            if pk = KindPropertyDeclaration
            {
                if b.is_static(parent) = false
                    return this.grammar_error_on_node(AstNode.name_of(parent), DiagA_property_of_a_class_whose_type_is_a_unique_symbol_type_must_be_both_static_and_readonly)
                if b.has_syntactic_modifier(parent, ModifierFlagsReadonly) = false
                    return this.grammar_error_on_node(AstNode.name_of(parent), DiagA_property_of_a_class_whose_type_is_a_unique_symbol_type_must_be_both_static_and_readonly)
                return false
            }
            if pk = KindPropertySignature
            {
                if b.has_syntactic_modifier(parent, ModifierFlagsReadonly) = false
                    return this.grammar_error_on_node(AstNode.name_of(parent), DiagA_property_of_an_interface_or_type_literal_whose_type_is_a_unique_symbol_type_must_be_readonly)
                return false
            }
            return this.grammar_error_on_node(node, DiagX_unique_symbol_types_are_not_allowed_here)
        }
        if op = KindReadonlyKeyword
        {
            let inner_type AstNode.type_operator_inner_of(node)
            let ik Checker.kind_or_unknown(inner_type)
            if ik = KindArrayType
                return false
            if ik = KindTupleType
                return false
            return this.grammar_error_on_first_token(node, DiagX_readonly_type_modifier_is_only_permitted_on_array_and_tuple_literal_types)
        }
        false
    }

    ; isVariableDeclarationInVariableStatement, whole — `IsVariableDeclarationList(
    ; node.Parent) && IsVariableStatement(node.Parent.Parent)`. A declaration of a
    ; `for (const x of …)` head has a list parent and a FOR parent above it, which
    ; is the case the predicate exists to exclude.
    function is_variable_declaration_in_variable_statement(node: ref[AstNode]?) returns bool
    {
        let parent AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(parent) <> KindVariableDeclarationList
            return false
        Checker.kind_or_unknown(AstNode.parent_node_of(parent)) = KindVariableStatement
    }

    ; checkTypeLiteral, whole but for one call.
    ;
    ; ★★★ THE MEMBERS WALK IS WHAT MAKES FIVE SIGNATURE KINDS AND TWO MEMBER KINDS
    ; REACHABLE AT ONCE, and two of them were already ported and unreached: an index
    ; signature's checkGrammarIndexSignature report (slice 52 wrote *no arm of this
    ; slice can reach it*) and a call signature's whole checkSignatureDeclaration.
    ; A property or method signature has no arm here yet and reports its own kind.
    ;
    ; ★★★ SLICE 80 — THE OLD NOTE HERE WAS WRONG ABOUT ITS OWN REASON, AND THE
    ; MISTAKE IS WORTH KEEPING. It read *"the last two are syntactic in their own
    ; bodies but both are entered with `t.symbol`"*, and neither is:
    ; `checkTypeForDuplicateIndexSignatures(node)` and
    ; `checkObjectTypeForDuplicateDeclarations(node, false)` take the NODE. Only
    ; `checkIndexConstraints(t, t.symbol, false)` reads the type, and it is the
    ; members dimension either way. So the three lines behind the stop were never
    ; ONE thing behind it — they were one line that needs a dimension and two that
    ; were already ported (slice 77 and slice 73) and merely unreached. ★A reason
    ; written at a stop is a claim about what is behind it, and it goes stale in
    ; the direction that keeps the stop.
    ;
    ; ★★ THE STOP THEREFORE MOVES TO WHERE THE REFERENCE'S FIRST UNPORTED CALL IS,
    ; which is slice 77's split applied to the third container kind: the tag names
    ; `check-index-constraints` and the walk carries on past it, because
    ; record_unported marks and does not abort.
    procedure check_type_literal(this, node: ref[AstNode])
    {
        this.check_source_elements(AstNode.member_list_of(node))
        ; `t := c.getTypeFromTypeLiteralOrFunctionOrConstructorTypeNode(node)`. The
        ; result is discarded HERE and the call is not: it is the reference's own
        ; line, it primes the node-links memo the T section reads later, and its
        ; alias walk is the one step of this arm that can still report.
        ; ★★★ SLICE 85 READS THE RESULT, and the line above stops discarding it.
        ; A type literal's type is ANONYMOUS with a TypeLiteral symbol, which is
        ; the middle branch of resolveAnonymousTypeMembers and the second of the
        ; two container kinds the members chapter covers.
        let t this.get_type_from_type_literal_or_function_or_constructor_type_node(node)
        if t <> null
        {
            let ty t as ref[Type]
            this.check_index_constraints(ty, ty.symbol, false)
        }
        ; ★ There is no once-guard on this call where the class and the interface
        ; have one: checkClassOrInterfaceForDuplicateIndexSignatures exists because
        ; a merged declaration reaches its container twice, and a type literal is
        ; one node with one symbol that nothing can merge into.
        this.check_type_for_duplicate_index_signatures(node)
        this.check_object_type_for_duplicate_declarations(node, false)
    }

    ; checkTypeReferenceNode, whose three ported steps are its grammar check, the
    ; JSDoc-dot report and the type-argument walk.
    ;
    ; ★★ THE JSDoc-DOT REPORT IS THE ONE PLACE IN THIS FILE THAT RE-SCANS FOR A
    ; TOKEN KIND. `Foo.<T>` is the JSDoc spelling of a type reference, and the
    ; reference recognises it by the GAP: the type name ends before the type
    ; arguments begin, and the token in the gap is scanned to see whether it is a
    ; dot. Anything else in that gap (a comment, a stray token from a recovered
    ; parse) leaves the branch untaken.
    ;
    ; ★ `IsTypeReferenceNode(node) && node.Flags&NodeFlagsJSDoc == 0` is kept whole
    ; although the kind half is TRIVIALLY TRUE on the one route that reaches this
    ; function today — the switch's TypeReference case. It is transcribed rather
    ; than folded away because the reference's own reason for it is a second caller
    ; this port does not have yet (an ExpressionWithTypeArguments reaching
    ; checkTypeReferenceOrImport by another route), and a test dropped because it
    ; happens to hold is a test nobody puts back. The FLAGS half is live: a
    ; reparsed JSDoc type reference carries NodeFlagsJSDoc and must not be told
    ; that JSDoc types belong in comments.
    procedure check_type_reference_node(this, node: ref[AstNode])
    {
        this.check_grammar_type_arguments(AstNode.type_arguments_of(node))
        if AstNode.kind_of(node) = KindTypeReference
        {
            if (AstNode.flags_of(node) & NodeFlagsJSDoc) = 0
            {
                let type_arguments AstNode.type_reference_arguments_of(node)
                if type_arguments <> null
                {
                    let name_end AstNode.end_of((AstNode.type_reference_name_of(node)) as ref[AstNode])
                    ; `sourceFile := ast.GetSourceFileOfNode(node)` (slice 366)
                    let nb this.binder_of_node(node)
                    var lpos 0
                    var lend 0
                    if this.list_range_of(type_arguments, &lpos, &lend)
                    {
                        if name_end <> lpos
                        {
                            if Binder.token_kind_on(this.scanner_for(nb), name_end) = KindDotToken
                                this.grammar_error_at_pos(node, nb.skip_trivia_at(name_end), 1, DiagJSDoc_types_can_only_be_used_inside_documentation_comments)
                        }
                    }
                    else
                        this.record_unported("list-range", 0)
                }
            }
        }
        this.check_source_elements(AstNode.type_arguments_of(node))
        this.check_type_reference_or_import(node)
    }

    ; checkTypeReferenceOrImport, whole — and this is the OTHER producer of the row
    ; slice 95 opened. 1 253 of that row's 1 773 events at stage 1 were this line,
    ; over all 190 of its units, which is why it is written in the same slice as
    ; the dispatcher arm: closing one and leaving the other would move a number and
    ; unblock nothing.
    ;
    ; ★★★ THE DEPRECATION HALF IS AN OMISSION WITH A PROOF, NOT A STOP, AND THE
    ; PROOF IS THE LIST IT WRITES INTO. `addDeprecatedSuggestion` builds a
    ; diagnostic and hands it to `addSuggestionDiagnostic`, which appends to
    ; `c.suggestionDiagnostics` — a SECOND list that `GetDiagnostics` does not
    ; read, so no artifact this suite compares can hold one (the field's own note
    ; at `suggestion_count` says so, and slice 70 is where it was established).
    ; What is written here is therefore the reference's guard and the COUNTER, the
    ; shape §3.5be asks for: the site is provable and the text is not invented.
    ; ★It is NOT the shape §3.5en's finding two warns about — that one is about an
    ; arm whose INPUT cannot arrive, and a deprecated interface is a shape this
    ; corpus can write. What cannot arrive is the OUTPUT.
    procedure check_type_reference_or_import(this, node: ref[AstNode])
    {
        let mark this.unported_mark()
        let t this.get_type_from_type_node(node)
        if this.unported_mark() <> mark
            return
        if t = null
            return
        if this.is_error_type(t as ref[Type])
            return
        var num_args 0
        let args AstNode.type_arguments_of(node)
        if args <> null
            set num_args: (args as ref[Array[ref[AstNode]?]]).get_length() as int
        if num_args <> 0
        {
            let type_parameters this.get_type_parameters_for_type_reference_or_import(node)
            if this.unported_mark() <> mark
                return
            if type_parameters <> null
            {
                if (type_parameters as ref[Array[ref[Type]?]]).get_length() <> 0
                {
                    ; ★★★ checkTypeArgumentConstraints IS CALLED HERE SINCE SLICE
                    ; 136, AND THE CALLEE HAD BEEN PORTED SINCE SLICE 124 — it sits
                    ; 1 700 lines up this file and the CLASS chapter's heritage arm
                    ; has been calling it all along. The note that stood here named
                    ; the three things it *"needs"* — getEffectiveTypeArguments, a
                    ; mapper per parameter and checkTypeAssignableTo — and all three
                    ; came with the callee; nobody re-read the stop after writing it.
                    ; §3.5dk's shape exactly, and it is the second time this slice
                    ; family has found one.
                    ;
                    ; ★ The `type_parameters_have_a_constraint` pre-pass GOES, rather
                    ; than being kept as a fast path: it was the STOP's guard, asked
                    ; once for the whole list to keep the report off an unconstrained
                    ; generic, and the reference's own loop already skips a parameter
                    ; with no constraint.
                    this.check_type_argument_constraints(node, type_parameters as ref[Array[ref[Type]?]])
                    if this.unported_mark() <> mark
                        return
                }
            }
        }
        let symbol this.get_resolved_symbol_or_nil(node)
        if symbol = null
            return
        if this.symbol_has_a_deprecated_type_declaration(symbol as ref[Symbol])
            set suggestion_count: suggestion_count + 1
    }

    ; `core.Some(symbol.Declarations, IsTypeDeclaration(d) && IsDeprecatedDeclaration(d))`.
    procedure symbol_has_a_deprecated_type_declaration(this, symbol: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let dn d as ref[AstNode]
                if Checker.is_type_declaration(dn)
                {
                    if this.is_deprecated_declaration(dn)
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; ast.IsDeprecatedDeclarationWithCachedFlags. ★The COMBINED flags gate the walk
    ; and the walk then finds the node the JSDoc actually hangs on — a variable
    ; declaration's tag is on its STATEMENT — so the two flag reads are different
    ; questions and neither can stand for the other.
    procedure is_deprecated_declaration(this, declaration: ref[AstNode]) returns bool
    {
        if (Binder.combined_node_flags(declaration) & NodeFlagsPossiblyContainsDeprecatedTag) = 0
            return false
        var n: ref[AstNode]? declaration
        while n <> null
        {
            let cur n as ref[AstNode]
            if (AstNode.flags_of(cur) & NodeFlagsPossiblyContainsDeprecatedTag) <> 0
                return this.jsdoc_deprecated_tag_of(cur) <> null
            set n: AstNode.parent_node_of(cur)
        }
        false
    }

    ; ast.GetJSDocDeprecatedTag — the node's JSDoc trees, and the first `@deprecated`
    ; tag in any of them. The side table is the parser's, and it is the same one the
    ; third yardstick's dump reads.
    procedure jsdoc_deprecated_tag_of(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let docs Parser.jsdoc_for_node(p, node)
        if docs = null
            return null
        let list docs as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let doc list[i]
            set i: i + 1
            if doc = null
                continue
            let tags AstNode.jsdoc_tag_list_of(doc as ref[AstNode])
            if tags = null
                continue
            let tl tags as ref[Array[ref[AstNode]?]]
            let tn tl.get_length() as int
            var k 0
            while k < tn
            {
                let tag tl[k]
                set k: k + 1
                if tag <> null
                {
                    if AstNode.kind_of(tag as ref[AstNode]) = KindJSDocDeprecatedTag
                        return tag
                }
            }
        }
        null
    }

    ; getTypeParametersForTypeReferenceOrImport + getTypeParametersForTypeAndSymbol.
    ; ★The TYPE-ALIAS arm reads `typeAliasLinks.typeParameters`, which this port
    ; does not carry — and it cannot be reached from here anyway, because a type
    ; alias reference stops one chapter earlier (getTypeReferenceType's own arm).
    ; It is a stop rather than an omission for exactly that reason: the day the
    ; alias chapter lands, this arm has input.
    procedure get_type_parameters_for_type_reference_or_import(this, node: ref[AstNode]) returns ref[Array[ref[Type]?]]?
    {
        let mark this.unported_mark()
        let t this.get_type_from_type_node(node)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        let ty t as ref[Type]
        if this.is_error_type(ty)
            return null
        let symbol this.get_resolved_symbol_or_nil(node)
        if symbol = null
            return null
        let s symbol as ref[Symbol]
        ; ★★★ THE ALIAS ARM IS TWO LINES AND ITS STOP WAS THE LARGEST ROW OF THE
        ; STAGE-1 FRONTIER BY UNITS (23). The note that stood here predicted its own
        ; expiry in as many words: *"typeAliasLinks.typeParameters … this port does
        ; not carry — and it cannot be reached from here anyway, because a type alias
        ; reference stops one chapter earlier … the day the alias chapter lands, this
        ; arm has input"*. The alias chapter landed in slice 105 and the slot has been
        ; on TypeAliasLink since; nothing re-read the line.
        ;
        ; ★ `len(typeParameters) != 0` and not merely non-nil: an alias with no type
        ; parameters falls THROUGH to the ObjectFlagsReference arm below rather than
        ; answering an empty list, which is the reference's own `if` and not a
        ; tidy-up.
        if (Symbol.flags_of(s) & SymbolFlagsTypeAlias) <> 0
        {
            let link this.type_alias_link_of(s)
            let tps link.type_parameters
            if tps <> null
            {
                if ((tps as ref[Array[ref[Type]?]]).get_length() as int) <> 0
                    return tps
            }
        }
        if (ty.object_flags & ObjectFlagsReference) <> 0
        {
            let target Checker.target_of(ty)
            if target = null
                return null
            return this.local_type_parameters_of(target as ref[Type])
        }
        null
    }

    ; checkTypeArgumentConstraints' guard, asked once for the whole list rather
    ; than per parameter — the reference's loop skips a parameter with no
    ; constraint and does nothing else, so a list of unconstrained parameters is a
    ; loop with an empty body.
    procedure type_parameters_have_a_constraint(this, type_parameters: ref[Array[ref[Type]?]]) returns bool
    {
        let n type_parameters.get_length() as int
        var i 0
        while i < n
        {
            let tp type_parameters[i]
            if tp <> null
            {
                let mark this.unported_mark()
                let c this.get_constraint_of_type_parameter(tp as ref[Type])
                if this.unported_mark() <> mark
                    return false
                if c <> null
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; checkImportType, whose first line is a recursion into the module specifier —
    ; a LiteralType, which has no arm at all, so the walk is silent — and whose
    ; other two are stops.
    procedure check_import_type(this, node: ref[AstNode])
    {
        this.check_source_element(AstNode.import_type_argument_of(node))
        ; ★★★ THE STOP HERE WAS AN EXPIRED NOTE (slice 137). It read *"getResolutionMode
        ; Override with reportErrors ... checkImportAttributes reports the same
        ; dimension from the declaration side"* — and that second sentence was the
        ; whole answer: the function it named has been ported since, called by
        ; check_import_attributes, so this arm was one line away the whole time.
        if AstNode.import_type_attributes_of(node) <> null
            this.get_resolution_mode_override(AstNode.import_type_attributes_of(node) as ref[AstNode], true)
        this.check_type_reference_or_import(node)
    }

    ; checkNamedTupleMember, whole but for its last line. Its three grammar reports
    ; are pure shape questions about the member's own tokens.
    ;
    ; ★ The first reports on the MEMBER and the other two on its TYPE, which is the
    ; distinction `[...a?: T]` against `[a: ...T]` needs: the optional-and-rest
    ; report is about the member's two tokens, and the other two are about a type
    ; that carries a marker belonging on the name.
    procedure check_named_tuple_member(this, node: ref[AstNode])
    {
        let type_node AstNode.type_of(node)
        if AstNode.dot_dot_dot_token_of(node) <> null
        {
            if AstNode.question_token_of(node) <> null
                this.grammar_error_on_node(node, DiagA_tuple_member_cannot_be_both_optional_and_rest)
        }
        let tk Checker.kind_or_unknown(type_node)
        if tk = KindOptionalType
            this.grammar_error_on_node(type_node, DiagA_labeled_tuple_element_is_declared_as_optional_with_a_question_mark_after_the_name_and_before_the_colon_rather_than_after_the_type)
        if tk = KindRestType
            this.grammar_error_on_node(type_node, DiagA_labeled_tuple_element_is_declared_as_rest_with_a_before_the_name_rather_than_before_the_type)
        this.check_source_element(type_node)
        this.get_type_from_type_node(node)
    }

    ; getArrayElementTypeNode, whole. It is a SYNTACTIC question — *does this type
    ; node spell an array* — and answering it needs no type, which is what lets
    ; getTupleElementFlags tell a `...T[]` REST element from a `...T` VARIADIC one
    ; in a slice that owns no type system.
    function array_element_type_node_of(n: ref[AstNode]?) returns ref[AstNode]?
    {
        let k Checker.kind_or_unknown(n)
        if k = KindParenthesizedType
            return Checker.array_element_type_node_of(AstNode.parenthesized_type_inner_of(n))
        if k = KindArrayType
            return AstNode.array_element_type_of(n)
        if k = KindTupleType
        {
            let elements AstNode.elements_of(n)
            if AstNode.list_count(elements) <> 1
                return null
            let e AstNode.child_in_list(elements, 0)
            let ek AstNode.kind_of(e)
            if ek = KindRestType
                return Checker.array_element_type_node_of(AstNode.rest_type_inner_of(e))
            if ek = KindNamedTupleMember
            {
                if AstNode.dot_dot_dot_token_of(e) <> null
                    return Checker.array_element_type_node_of(AstNode.type_of(e))
            }
            return null
        }
        null
    }

    ; getTupleElementFlags, whole.
    function get_tuple_element_flags(node: ref[AstNode]?) returns int
    {
        let k AstNode.kind_of(node)
        if k = KindOptionalType
            return ElementFlagsOptional
        if k = KindRestType
        {
            if Checker.array_element_type_node_of(AstNode.rest_type_inner_of(node)) <> null
                return ElementFlagsRest
            return ElementFlagsVariadic
        }
        if k = KindNamedTupleMember
        {
            if AstNode.question_token_of(node) <> null
                return ElementFlagsOptional
            if AstNode.dot_dot_dot_token_of(node) <> null
            {
                if Checker.array_element_type_node_of(AstNode.type_of(node)) <> null
                    return ElementFlagsRest
                return ElementFlagsVariadic
            }
            return ElementFlagsRequired
        }
        ElementFlagsRequired
    }

    ; checkTupleType, whose ordering loop is ported and whose VARIADIC arm is where
    ; it stops.
    ;
    ; ★★★ THE STOP HAS TO END THE LOOP, NOT SKIP AN ELEMENT, AND THAT IS THE ONLY
    ; PLACE IN THIS SLICE WHERE THE SHAPE OF THE ABSENCE MATTERS. A variadic element
    ; is the one case whose FLAGS depend on a type: the reference resolves it, errors
    ; and BREAKs when it is not array-like, and otherwise sets ElementFlagsRest on
    ; it — so `seenRestElement` after a variadic element is a fact this port cannot
    ; know. Emitting the loop's later reports anyway would put a diagnostic where the
    ; reference has none, which is the one thing diagcheck can fail on. Stopping the
    ; loop keeps our lines a SUBSET of the reference's, which is the relation it
    ; asserts.
    ;
    ; ★ The recursion and the final stop are BELOW the loop and run either way:
    ; checkSourceElements is unconditional in the reference too, and skipping it
    ; would hide every element's own arm behind a tuple.
    procedure check_tuple_type(this, node: ref[AstNode])
    {
        let elements AstNode.elements_of(node)
        let count AstNode.list_count(elements)
        var seen_optional_element false
        var seen_rest_element false
        var i 0
        while i < count
        {
            let e AstNode.child_in_list(elements, i)
            var flags Checker.get_tuple_element_flags(e)
            if (flags & ElementFlagsVariadic) <> 0
            {
                ; ★ SLICE 137 — the variadic element's own type, which is what the
                ; stop here was waiting for. ★★The `break` on a non-array-like type is
                ; the reference's and it is load-bearing for the report ORDER: the
                ; loop's later grammar checks are suppressed once this one has fired,
                ; and this port's diagnostics are a SUBSEQUENCE of the reference's.
                if e = null
                    break
                let mark this.unported_mark()
                let vt this.try_get_type_from_type_node(e as ref[AstNode])
                if this.unported_mark() <> mark
                    break
                if vt = null
                    break
                let vtt vt as ref[Type]
                ; ★★★ THE MARK IS ASKED AROUND `isArrayLikeType` AND NOT ONLY AROUND
                ; THE TYPE, AND WITHOUT THAT THE ARM REPORTS A DIAGNOSTIC THE
                ; REFERENCE DOES NOT. The test's second term is
                ; `isTypeAssignableTo(t, readonly any[])`, and for a type parameter
                ; whose constraint is a TUPLE the relation stops here
                ; (`single-element-generic-tuple`) and answers FALSE — which reads
                ; exactly like *not array-like*. `[...string[], ...T]` with `T extends
                ; [string]` drew a TS2574 on four stage-1 units; with `T extends
                ; string[]`, where the relation is complete, it draws none.
                ; ★★A PREDICATE THAT STOPS ANSWERS ITS OWN FALSE, and every report
                ; behind one owes this check.
                let arraylike this.is_array_like_type(vtt)
                if this.unported_mark() <> mark
                    break
                if arraylike = false
                {
                    this.error_on_node(e, DiagA_rest_element_type_must_be_an_array_type)
                    break
                }
                ; ★★★ THE COMBINED FLAGS ARE THE TARGET'S (§3.5he) — asking
                ; `vtt` answered ElementFlagsNone for every tuple, so `[...T]`
                ; with `T` a tuple carrying a rest element never picked up the
                ; Rest flag and the two grammar reports below could not fire.
                var rest_like this.is_array_type(vtt)
                if Checker.is_tuple_type(vtt)
                {
                    let vtarget Checker.target_of(vtt)
                    if vtarget <> null
                    {
                        if (Checker.tuple_combined_flags_of(vtarget as ref[Type]) & ElementFlagsRest) <> 0
                            set rest_like: true
                    }
                }
                if this.unported_mark() <> mark
                    break
                if rest_like
                    set flags: flags | ElementFlagsRest
            }
            if (flags & ElementFlagsRest) <> 0
            {
                if seen_rest_element
                {
                    this.grammar_error_on_node(e, DiagA_rest_element_cannot_follow_another_rest_element)
                    break
                }
                set seen_rest_element: true
            }
            else
            {
                if (flags & ElementFlagsOptional) <> 0
                {
                    if seen_rest_element
                    {
                        this.grammar_error_on_node(e, DiagAn_optional_element_cannot_follow_a_rest_element)
                        break
                    }
                    set seen_optional_element: true
                }
                else
                {
                    if (flags & ElementFlagsRequired) <> 0
                    {
                        if seen_optional_element
                        {
                            this.grammar_error_on_node(e, DiagA_required_element_cannot_follow_an_optional_element)
                            break
                        }
                    }
                }
            }
            set i: i + 1
        }
        this.check_source_elements(elements)
        this.get_type_from_type_node(node)
    }

    ; checkTemplateLiteralType, whole since slice 126. ★The loop is written in the
    ; reference's own order — recurse, resolve, check — so a span's own subtree
    ; speaks before this line does.
    ;
    ; ★★ THE PER-SPAN CHECK IS AGAINST THE TEMPLATE CONSTRAINT AND IT REPORTS: the
    ; reference asks `checkTypeAssignableTo(type, templateConstraintType, span.Type)`
    ; with TS2322's default head, so it is one of the few grammar-shaped checks that
    ; goes through the relation.
    procedure check_template_literal_type(this, node: ref[AstNode])
    {
        let spans AstNode.template_literal_type_spans_of(node)
        let count AstNode.list_count(spans)
        var i 0
        while i < count
        {
            let span AstNode.child_in_list(spans, i)
            let st AstNode.template_literal_type_span_type_of(span)
            this.check_source_element(st)
            if st <> null
            {
                let t this.get_type_from_type_node(st as ref[AstNode])
                if t <> null
                {
                    let tc this.get_template_constraint_type()
                    if tc <> null
                        this.check_type_assignable_to(t as ref[Type], tc as ref[Type], st, 0)
                }
            }
            set i: i + 1
        }
        this.get_type_from_type_node(node)
    }

    ; checkMappedType, whose grammar check and three recursions are ported.
    ;
    ; ★★ THE TYPE PARAMETER OF A MAPPED TYPE IS THE SECOND CALLER THAT MAKES
    ; checkSourceElement's TypeParameter ARM LIVE, and slice 60 predicted exactly
    ; this: it wrote the arm INERT, with the note that *the first slice that does
    ; walk into one — checkMappedType's own type parameter, or an InferType's —
    ; would report a hole for an arm that exists*. Both of those callers are in this
    ; slice.
    ;
    ; ★ `if mappedTypeNode.Type == nil { c.reportImplicitAny(...) }` is BELOW the
    ; three recursions and above the stop; it needs the any type and the widening
    ; machinery, and it is unreachable in front of getTypeFromMappedTypeNode anyway.
    procedure check_mapped_type(this, node: ref[AstNode])
    {
        this.check_grammar_mapped_type(node)
        this.check_source_element(AstNode.mapped_type_parameter_of(node))
        this.check_source_element(AstNode.mapped_type_name_type_of(node))
        this.check_source_element(AstNode.type_of(node))
        ; ★★★ THIS LINE WAS MISSING AND THE REPORT WAS LOST. `if mappedTypeNode.Type
        ; == nil { c.reportImplicitAny(node, c.anyType, WideningKindNormal) }` stands
        ; between the recursion and the stop upstream, and report_implicit_any's
        ; MappedType label — TS7039, three lines with no guard beyond noImplicitAny —
        ; has been ported since slice 69 with nothing to feed it. **A dropped call is
        ; silent in both halves: no diagnostic, and no row saying one is owed.** It is
        ; slice 82's because the slice's other half is the same shape from the other
        ; side — a reader of report_implicit_any that had no writer.
        if AstNode.type_of(node) = null
            this.report_implicit_any(node, any_type, WideningKindNormal)
        ; ★★★ THE STOP THAT STOOD HERE HAD EXPIRED SINCE SLICE 125, which ported
        ; getTypeFromMappedTypeNode and the four lazily-filled slots whole. The tag
        ; named a function this file defines — `expiredstops.py tags` is what says
        ; so, and §3.5fx is why that mode exists. The tail below is the reference's
        ; own three lines: the mapped type's KEY must be a string, a number or a
        ; symbol, asked at the NAME TYPE when there is one and at the type
        ; parameter's CONSTRAINT when there is not.
        let mark this.unported_mark()
        let t this.get_type_from_mapped_type_node(node)
        if this.unported_mark() <> mark
            return
        if t = null
            return
        if string_number_symbol_type = null
        {
            this.record_unported("string-number-symbol-type-unminted", KindMappedType)
            return
        }
        let sns string_number_symbol_type as ref[Type]
        let name_type this.get_name_type_from_mapped_type(t as ref[Type])
        if this.unported_mark() <> mark
            return
        if name_type <> null
        {
            this.check_type_assignable_to(name_type as ref[Type], sns, AstNode.mapped_type_name_type_of(node), 0)
            return
        }
        let constraint this.get_constraint_type_from_mapped_type(t as ref[Type])
        if this.unported_mark() <> mark
            return
        if constraint = null
            return
        ; ★ The reference reaches through `mappedTypeNode.TypeParameter
        ; .AsTypeParameterDeclaration().Constraint`, and a mapped type without one
        ; is a parse error the grammar check above already owns — so a null error
        ; node here reports the failure without a span rather than not at all.
        this.check_type_assignable_to(constraint as ref[Type], sns, AstNode.type_parameter_constraint_of(AstNode.mapped_type_parameter_of(node)), 0)
    }

    ; checkGrammarMappedType, whole — a mapped type's member list is the parser's
    ; recovery slot and any entry in it is an error.
    procedure check_grammar_mapped_type(this, node: ref[AstNode]) returns bool
    {
        let members AstNode.member_list_of(node)
        if AstNode.list_count(members) = 0
            return false
        this.grammar_error_on_node(AstNode.child_in_list(members, 0), DiagA_mapped_type_may_not_declare_properties_or_methods)
    }

    ; checkInferType, whose grammar report and recursion are ported and whose
    ; identical-constraints check is the stop.
    ;
    ; ★★★ THE GRAMMAR REPORT IS AN ANCESTOR WALK AND ITS PREDICATE IS ABOUT THE
    ; PARENT, NOT THE NODE. FindAncestor starts AT the node and asks of each step
    ; whether ITS parent is a conditional type whose extendsType is that step — so
    ; `T extends (infer U) ? …` is legal, because the walk climbs out of the
    ; parenthesized type and finds the relation one level up. Reading the predicate
    ; as *my parent is a conditional type* would reject it.
    ;
    ; ★ The stop is `len(symbol.Declarations) > 1`, i.e. a SECOND `infer U` with the
    ; same name — so the check is inert for every well-formed conditional type and
    ; the report stands for a shape the corpus barely contains. It is
    ; getSymbolOfDeclaration all the same, and that is the tag.
    procedure check_infer_type(this, node: ref[AstNode])
    {
        this.check_infer_type_worker(node)
        this.register_for_unused_identifiers_check(node)
    }

    procedure check_infer_type_worker(this, node: ref[AstNode])
    {
        var n: ref[AstNode]? node
        var found false
        while n <> null
        {
            let parent AstNode.parent_node_of(n)
            if Checker.kind_or_unknown(parent) = KindConditionalType
            {
                if AstNode.conditional_extends_type_of(parent) = n
                {
                    set found: true
                    break
                }
            }
            set n: parent
        }
        if found = false
            this.grammar_error_on_node(node, DiagX_infer_declarations_are_only_permitted_in_the_extends_clause_of_a_conditional_type)
        let type_parameter AstNode.infer_type_parameter_of(node)
        this.check_source_element(type_parameter)

        ; ★★★ SLICE 65: THIS ARM WAS NOT BLOCKED AT ALL, and the guard is why. The
        ; reference asks getSymbolOfDeclaration for the inferred type parameter and
        ; then `if len(symbol.Declarations) > 1` — so the whole
        ; declaredTypeLinks/areTypeParametersIdentical block behind it belongs to an
        ; `infer T` whose T is declared TWICE, which is the shape
        ; `T extends infer U ? infer U : never` has and almost nothing else does.
        ; With one declaration the function finishes at
        ; registerForUnusedIdentifiersCheck, which is not ported for the reason
        ; check_type_alias_declaration's header gives. ★It is the sharpest of the
        ; four sites the head's tag named: three of them were re-pointed at the
        ; function that really stops them and this one had nothing to point at.
        let symbol this.symbol_of_declaration(type_parameter)
        if symbol = null
            return
        if Symbol.declaration_count(symbol) <= 1
            return
        ; ★★★ SLICE 179 WRITES THE BLOCK, AND EVERY PIECE OF IT WAS ALREADY HERE:
        ; the once-bit is declared_type_links' `type_parameters_checked`, the
        ; comparison is are_type_parameters_identical (slice 124) and the target is
        ; get_declared_type_of_type_parameter. **The row named the last of the three
        ; and the note above named getSymbolOfDeclaration, which is CALLED four
        ; lines up** — the tag and its note had drifted onto two different absent
        ; things, neither of them absent.
        ;
        ; ★ The bit is set BEFORE the report, as check_type_parameter_lists_identical
        ; sets it and for its reason: the memo is what keeps a doubly declared
        ; `infer U` reporting once.
        let sym symbol as ref[Symbol]
        let links this.declared_type_link_of(sym)
        if links.type_parameters_checked
            return
        set links.type_parameters_checked: true
        let mark this.unported_mark()
        let tp this.get_declared_type_of_type_parameter(sym)
        if this.unported_mark() <> mark
            return
        if tp = null
            return
        let targets this.new_type_list_of(1)
        targets.add(tp)
        let declarations this.get_type_parameter_declarations_of_symbol(sym)
        let identical this.are_type_parameters_identical_ex(declarations, targets, true)
        if this.unported_mark() <> mark
            return
        if identical
            return
        let symbol_name this.symbol_arg(sym)
        let dn declarations.get_length() as int
        var di 0
        while di < dn
        {
            let d declarations[di]
            if d <> null
                this.error_on_node(AstNode.name_of(d as ref[AstNode]), DiagAll_declarations_of_0_must_have_identical_constraints, symbol_name)
            set di: di + 1
        }
    }

    ; getDeclarationsOfKind(symbol, KindTypeParameter) — checkInferType's one
    ; caller. ★It is get_class_or_interface_declarations_of_symbol's shape with one
    ; kind instead of two, and a shared kind-taking helper would be that function's
    ; second parameter for a single reader.
    procedure get_type_parameter_declarations_of_symbol(this, symbol: ref[Symbol]) returns ref[Array[ref[AstNode]?]]
    {
        let out this.new_node_list()
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if AstNode.kind_of(d as ref[AstNode]) = KindTypeParameter
                    out.add(d)
            }
            set i: i + 1
        }
        out
    }

    ; getTypePredicateParent, whole — a kind test on the parent plus the identity
    ; test that the predicate IS that parent's return type annotation.
    function type_predicate_parent_of(node: ref[AstNode]) returns ref[AstNode]?
    {
        let parent AstNode.parent_node_of(node)
        let pk Checker.kind_or_unknown(parent)
        var eligible false
        if pk = KindArrowFunction
            set eligible: true
        if pk = KindCallSignature
            set eligible: true
        if pk = KindFunctionDeclaration
            set eligible: true
        if pk = KindFunctionExpression
            set eligible: true
        if pk = KindFunctionType
            set eligible: true
        if pk = KindMethodDeclaration
            set eligible: true
        if pk = KindMethodSignature
            set eligible: true
        if eligible = false
            return null
        if AstNode.type_of(parent) <> node
            return null
        parent
    }

    ; checkTypePredicate, whose first report is ported and whose second line is the
    ; stop.
    ;
    ; ★★ THE REPORT IS THE ONE THIS ARM CAN REACH AND IT IS A `c.error`, NOT A
    ; GRAMMAR ERROR — so it survives a file with parse diagnostics, and a predicate
    ; written where the grammar allows the syntax but the semantics do not (`let x:
    ; a is string`) reports here rather than in the parser.
    ;
    ; ★ Everything below it — the parameter-index checks, the rest-parameter report
    ; and the assignability of the predicate's type to its parameter's — used to
    ; stand behind getSignatureFromDeclaration. Slice 84 moves the stop ONE call
    ; along, to getTypePredicateOfSignature: the signature is built and its
    ; `resolved_type_predicate` slot is the one Signature does not carry, because
    ; createTypePredicateFromTypePredicateNode is what fills it and that needs the
    ; predicate's TYPE. ★The row is worth moving even though the chapter behind it
    ; is one function: everything the reference reports here reads
    ; `typePredicate.parameterIndex`, so a stop naming the signature named the
    ; wrong wall.
    procedure check_type_predicate(this, node: ref[AstNode])
    {
        let mark this.unported_mark()
        let parent Checker.type_predicate_parent_of(node)
        if parent = null
        {
            this.error_on_node(node, DiagA_type_predicate_is_only_allowed_in_return_type_position_for_functions_and_methods)
            return
        }
        let signature this.get_signature_from_declaration(parent as ref[AstNode])
        if signature = null
            return
        let sig signature as ref[Signature]
        let predicate this.get_type_predicate_of_signature(sig)
        if this.unported_mark() <> mark
            return
        if predicate = null
            return
        let pd predicate as ref[TypePredicate]
        this.check_source_element(AstNode.type_of(node))
        if this.unported_mark() <> mark
            return
        let parameter_name AstNode.type_predicate_parameter_name_of(node)
        ; A `this` predicate names no parameter, so neither half below applies.
        if pd.kind = TypePredicateKindThis
            return
        if pd.kind = TypePredicateKindAssertsThis
            return
        if pd.parameter_index >= 0
        {
            var param_count 0
            if sig.parameters <> null
                set param_count: (sig.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
            var rest_named false
            if Checker.signature_has_rest_parameter(sig)
            {
                if pd.parameter_index = (param_count - 1)
                    set rest_named: true
            }
            if rest_named
            {
                this.error_on_node(parameter_name, DiagA_type_predicate_cannot_reference_a_rest_parameter)
                return
            }
            if pd.t = null
                return
            if sig.parameters = null
                return
            let row (sig.parameters as ref[Array[ref[Symbol]?]])[pd.parameter_index]
            if row = null
                return
            let param_type this.get_type_of_symbol(row as ref[Symbol])
            if this.unported_mark() <> mark
                return
            if param_type = null
                return
            ; The reference runs the relation into a PRIVATE diagnostic list (no head
            ; message) and, when it fails, adds ONE diagnostic: TS2677 at the first
            ; captured diagnostic's node with that diagnostic chained under it. A head
            ; message is NOT the same thing — the relation's `reportRelationError`
            ; SUPPRESSES a head whose names match the missing-property row before it,
            ; and the reader then saw TS2741 where the reference says TS2677. §3.24's
            ; mark-and-truncate is the private list.
            let diag_mark diagnostics.length()
            if this.check_type_assignable_to(pd.t as ref[Type], param_type as ref[Type], AstNode.type_of(node), 0) = false
            {
                if diagnostics.rehead_since(diag_mark, DiagA_type_predicate_s_type_must_be_assignable_to_its_parameter_s_type, null) = false
                    this.error_on_node_or_null(AstNode.type_of(node), DiagA_type_predicate_s_type_must_be_assignable_to_its_parameter_s_type)
            }
            return
        }
        ; parameterIndex < 0 — the name matched no parameter. It may still be an
        ; element of a BINDING PATTERN, which has its own message (TS1230); only if
        ; it is nowhere at all is it TS1225.
        if parameter_name = null
            return
        let pn parameter_name as ref[AstNode]
        let params AstNode.parameters_of(parent)
        let n AstNode.list_count(params)
        var i 0
        var reported false
        while i < n
        {
            let param AstNode.child_in_list(params, i)
            set i: i + 1
            let name AstNode.name_of(param)
            if name = null
                continue
            if AstNode.is_binding_pattern(name) = false
                continue
            if this.type_predicate_variable_is_declared_in_binding_pattern(name as ref[AstNode], pn, pd.parameter_name)
            {
                set reported: true
                set i: n
            }
        }
        if reported = false
            this.error_on_node(pn, DiagCannot_find_parameter_0, Checker.arg_text(pd.parameter_name))
    }

    ; checkIfTypePredicateVariableIsDeclaredInBindingPattern, whole — recursive
    ; over nested patterns, and it REPORTS on the way out rather than answering
    ; where the element is.
    procedure type_predicate_variable_is_declared_in_binding_pattern(this, pattern: ref[AstNode], predicate_variable_node: ref[AstNode], name_data: Slice[char]) returns bool
    {
        let elements AstNode.elements_of(pattern)
        let n AstNode.list_count(elements)
        var i 0
        while i < n
        {
            let element AstNode.child_in_list(elements, i)
            set i: i + 1
            let name AstNode.name_of(element)
            if name = null
                continue
            let nm name as ref[AstNode]
            if AstNode.kind_of(nm) = KindIdentifier
            {
                if SymbolTable.names_equal(AstNode.identifier_text_of(nm), name_data)
                {
                    this.error_on_node(predicate_variable_node, DiagA_type_predicate_cannot_reference_element_0_in_a_binding_pattern, Checker.arg_text(name_data))
                    return true
                }
            }
            if AstNode.is_binding_pattern(nm)
            {
                if this.type_predicate_variable_is_declared_in_binding_pattern(nm, predicate_variable_node, name_data)
                    return true
            }
        }
        false
    }

    ; checkJSDocType, whole but for the half of checkJSDocTypeIsInJsFile that needs
    ; a type string.
    procedure check_jsdoc_type(this, node: ref[AstNode])
    {
        this.check_jsdoc_type_is_in_js_file(node)
        this.check_each_child_source_element(node)
    }

    ; checkJSDocTypeIsInJsFile, split at the one line that needs a type.
    ;
    ; ★★★ THE TWO HALVES REPORT DIFFERENT THINGS AND ONLY ONE OF THEM IS A TYPE
    ; QUESTION. A `?T` or `T!` in a .ts file gets a message that QUOTES the type it
    ; would have meant (`'?' at the start of a type is not valid TypeScript syntax.
    ; Did you mean to write 'T | null'?`), so it needs getTypeFromTypeNode and
    ; TypeToString and stops here; a `*` or a JSDoc type literal gets the plain
    ; TS8020 and is complete. ★And the whole function is a NO-OP in a JavaScript
    ; file, which is where these kinds normally live — so the ported half is exactly
    ; the case that is an error.
    procedure check_jsdoc_type_is_in_js_file(this, node: ref[AstNode])
    {
        if Parser.is_in_js_file(node)
            return
        let k AstNode.kind_of(node)
        var jsdoc_wrapper false
        if k = KindJSDocNonNullableType
            set jsdoc_wrapper: true
        if k = KindJSDocNullableType
            set jsdoc_wrapper: true
        if jsdoc_wrapper
        {
            ; ★★★ SLICE 137, AND THE OLD NOTE OVER-STATED WHAT THIS ARM NEEDS. It read
            ; *"gets a message that QUOTES the type it would have meant ... so it needs
            ; getTypeFromTypeNode and TypeToString and stops here"*. The two message
            ; ARGUMENTS — the token and the printed type — are exactly what §3.20 drops
            ; here: a diagnostic is (pos, end, code). Which of the two CODES is chosen
            ; depends on `postfix` alone, a comparison of two POSITIONS, so the report
            ; never needed either half.
            ;
            ; ★★ The type is still computed and thrown away, because computing it is
            ; not free of REPORTS: getTypeFromTypeNode walks the annotation and
            ; whatever it says there, the reference says too.
            let inner AstNode.type_of(node)
            if inner <> null
                this.get_type_from_type_node(inner as ref[AstNode])
            var code DiagX_0_at_the_start_of_a_type_is_not_valid_TypeScript_syntax_Did_you_mean_to_write_1
            if inner <> null
            {
                if AstNode.pos_of(node) = AstNode.pos_of(inner as ref[AstNode])
                    set code: DiagX_0_at_the_end_of_a_type_is_not_valid_TypeScript_syntax_Did_you_mean_to_write_1
            }
            var token_text String("?")
            if k = KindJSDocNonNullableType
                set token_text: String("!")
            var shown_type: ref[Type]? null
            if inner <> null
            {
                set shown_type: this.get_type_from_type_node(inner as ref[AstNode])
                if (k = KindJSDocNullableType) and (shown_type <> null)
                {
                    let st shown_type as ref[Type]
                    if (st <> never_type) and (st <> void_type)
                    {
                        var null_flags TypeFlagsNullable
                        if code = DiagX_0_at_the_end_of_a_type_is_not_valid_TypeScript_syntax_Did_you_mean_to_write_1
                            set null_flags: TypeFlagsUndefined
                        set shown_type: this.get_nullable_type(st, null_flags)
                    }
                }
            }
            this.grammar_error_on_node(node, code, token_text, this.type_arg(shown_type))
            return
        }
        this.grammar_error_on_node(node, DiagJSDoc_types_can_only_be_used_inside_documentation_comments)
    }

    ; ── slice 52: the function declaration ───────────────────────────────────

    ; The six kinds whose checkSignatureDeclaration grammar arm is
    ; checkGrammarFunctionLikeDeclaration — the reference's own `case` list, kept
    ; as a list because the seventh (KindIndexSignature) has a DIFFERENT check and
    ; every other kind that reaches that switch has none.
    function kind_has_function_like_grammar_check(k: int) returns bool
    {
        if k = KindFunctionType
            return true
        if k = KindFunctionDeclaration
            return true
        if k = KindConstructorType
            return true
        if k = KindCallSignature
            return true
        if k = KindConstructor
            return true
        if k = KindConstructSignature
            return true
        false
    }

    ; checkSignatureDeclaration, whole, with three of its steps written down rather
    ; than ported and each saying which kind of absence it is.
    ; ast.GetNextJSDocCommentLocation — the eight parent kinds a JSDoc comment is
    ; allowed to sit on for a child, plus the first declaration of a
    ; VariableDeclarationList.
    function get_next_jsdoc_comment_location(node: ref[AstNode]) returns ref[AstNode]?
    {
        let parent_opt AstNode.parent_node_of(node)
        if parent_opt = null
            return null
        let parent parent_opt as ref[AstNode]
        let pk AstNode.kind_of(parent)
        if pk = KindPropertyAssignment
            return parent
        if pk = KindExportAssignment
            return parent
        if pk = KindPropertyDeclaration
            return parent
        if pk = KindVariableDeclaration
            return parent
        if pk = KindSatisfiesExpression
            return parent
        if pk = KindReturnStatement
            return parent
        if pk = KindVariableStatement
            return parent
        if pk = KindExpressionStatement
            return parent
        if pk = KindVariableDeclarationList
        {
            if AstNode.child_in_list(AstNode.variable_declarations_of(parent), 0) = node
                return parent
        }
        null
    }

    ; getAllJSDocTags, whole: the tag list of the LAST JSDoc comment of the first
    ; location that carries one. ★A comment with no tags does not end the walk —
    ; the reference `continue`s there — and a node that IS inside a JSDoc has none.
    function get_all_jsdoc_tags(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        if (AstNode.flags_of(node) & NodeFlagsJSDoc) <> 0
            return null
        var cur: ref[AstNode]? node
        while cur <> null
        {
            let c cur as ref[AstNode]
            let docs Parser.eager_jsdoc(p, c)
            if docs <> null
            {
                let list docs as ref[Array[ref[AstNode]?]]
                let n list.get_length() as int
                if n <> 0
                {
                    let t AstNode.jsdoc_tags_of(list[n - 1])
                    if t <> null
                        return t
                }
            }
            set cur: Checker.get_next_jsdoc_comment_location(c)
        }
        null
    }

    ; The `jsdocParameters` filter — a @param tag whose name is not an EMPTY
    ; identifier. It decides membership AND therefore the INDEX both branches
    ; below compare against the parameter list, which is why it is one predicate
    ; rather than a test written twice.
    function jsdoc_parameter_tag_counts(tag: ref[AstNode]?) returns bool
    {
        if tag = null
            return false
        if AstNode.kind_of(tag as ref[AstNode]) <> KindJSDocParameterTag
            return false
        let nm AstNode.jsdoc_param_name_of(tag)
        if Checker.kind_or_unknown(nm) = KindIdentifier
        {
            if AstNode.identifier_text_length_of(nm) = 0
                return false
        }
        true
    }

    ; excludedParameters — the indices whose PARAMETER is a binding pattern.
    function parameter_at_is_binding_pattern(params: ref[Array[ref[AstNode]?]]?, index: int) returns bool
    {
        if index >= AstNode.list_count(params)
            return false
        AstNode.is_binding_pattern(AstNode.name_of(AstNode.child_in_list(params, index)))
    }

    ; checkUnmatchedJSDocParameters, whole — the row slice 112 opened and priced
    ; (*containsArgumentsReference … and isArrayType*), both of which are here now.
    ;
    ; ★★★ THE TWO SETS ARE COUNTED RATHER THAN COLLECTED. Upstream builds a
    ; `[]*ast.Node` of the surviving tags, a Set of parameter names and a Set of
    ; excluded indices; what the two branches read from them is a COUNT, an INDEX
    ; and the LAST tag, so the filter is a predicate and the two membership tests
    ; are the linear scans they were in the gate this replaces. The lists are a
    ; signature's parameters, not a corpus.
    ;
    ; ★★ THE `arguments` BRANCH IS `isJs`-ONLY AND THE OTHER ONE IS NOT — the
    ; qualified-name report is `isJs`-gated literally and the ordinary one through
    ; errorOrSuggestion(isJs, …), which files a SUGGESTION in a TypeScript file:
    ; a list the oracle's C section does not carry, so in a .ts unit this function
    ; can put no line in the dump either way.
    procedure check_unmatched_jsdoc_parameters(this, node: ref[AstNode])
    {
        let tags0 this.get_all_jsdoc_tags(node)
        if tags0 = null
            return
        let tags tags0 as ref[Array[ref[AstNode]?]]
        let n tags.get_length() as int
        let params AstNode.parameters_of(node)
        var count 0
        var last: ref[AstNode]? null
        var i 0
        while i < n
        {
            let tag tags[i]
            set i: i + 1
            if Checker.jsdoc_parameter_tag_counts(tag) = false
                continue
            set count: count + 1
            set last: tag
        }
        if count = 0
            return
        let is_js Parser.is_in_js_file(node)
        let mark this.unported_mark()
        let has_arguments this.contains_arguments_reference(node)
        if this.unported_mark() <> mark
            return
        if has_arguments
        {
            ; The `arguments` advice, TS8029 — and every one of its five guards is
            ; a RETURN where the ordinary branch `continue`s, because the branch
            ; looks at the LAST tag alone.
            if is_js = false
                return
            let lt last as ref[AstNode]
            let nm AstNode.jsdoc_param_name_of(lt)
            if Checker.kind_or_unknown(nm) <> KindIdentifier
                return
            if Checker.parameter_at_is_binding_pattern(params, count - 1)
                return
            if Checker.parameter_names_hold(params, nm as ref[AstNode])
                return
            let te AstNode.jsdoc_type_expression_of(lt)
            if te = null
                return
            let tn AstNode.jsdoc_type_expression_inner_of(te)
            if tn = null
                return
            let t this.get_type_from_type_node(tn as ref[AstNode])
            if this.unported_mark() <> mark
                return
            if t = null
                return
            if this.is_array_type(t as ref[Type])
                return
            this.error_on_node(nm, DiagJSDoc_param_tag_has_name_0_but_there_is_no_parameter_with_that_name_It_would_match_arguments_if_it_had_an_array_type, Checker.arg_text(AstNode.identifier_text_of(nm)))
            return
        }
        var index 0
        set i: 0
        while i < n
        {
            let tag tags[i]
            set i: i + 1
            if Checker.jsdoc_parameter_tag_counts(tag) = false
                continue
            let tg tag as ref[AstNode]
            let idx index
            set index: index + 1
            let nm AstNode.jsdoc_param_name_of(tg)
            if Checker.parameter_at_is_binding_pattern(params, idx)
                continue
            var matched false
            if Checker.kind_or_unknown(nm) = KindIdentifier
            {
                if Checker.parameter_names_hold(params, nm as ref[AstNode])
                    set matched: true
            }
            if matched
                continue
            if Checker.kind_or_unknown(nm) = KindQualifiedName
            {
                if is_js
                    this.error_on_node(nm, DiagQualified_name_0_is_not_allowed_without_a_leading_param_object_1, this.entity_name_arg(nm as ref[AstNode]), this.entity_name_arg(AstNode.qualified_left_of(nm) as ref[AstNode]))
            }
            else
            {
                if AstNode.jsdoc_param_is_name_first(tg) = false
                {
                    if is_js
                        this.error_on_node(nm, DiagJSDoc_param_tag_has_name_0_but_there_is_no_parameter_with_that_name, Checker.arg_text(AstNode.identifier_text_of(nm)))
                }
            }
        }
    }

    ; containsArgumentsReference — *does this body mention `arguments`?*, asked of
    ; the body and not of the signature.
    ;
    ; ★ The reference memoizes the answer per node in cachedArgumentsReferenced.
    ; The cache is left out because the one caller asks once per signature
    ; declaration and the walk stops at every nested lexical environment; a memo
    ; with one reader per key is a table, not a saving.
    procedure contains_arguments_reference(this, node: ref[AstNode]) returns bool
    {
        let body AstNode.body_of(node)
        if body = null
            return false
        this.arguments_reference_visit(body)
    }

    ; The visitor, lifted out of the walk for §3.9d's reason — the callback does
    ; not survive, so the walk and its visitor are one function.
    ;
    ; ★★ THE FOUR MEMBER KINDS FALL THROUGH WHERE THE NAME IS NOT COMPUTED, and
    ; that is not a no-op: the fall-through reaches
    ; node_starts_new_lexical_environment, which answers TRUE for a method and an
    ; accessor, so the arm reads *a computed name is the one part of a member
    ; declaration that is evaluated in the enclosing environment*.
    procedure arguments_reference_visit(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        let k AstNode.kind_of(n)
        if k = KindIdentifier
        {
            if Checker.identifier_text_is(n, "arguments") = false
                return false
            let mark this.unported_mark()
            let sym this.get_resolved_symbol(n)
            if this.unported_mark() <> mark
                return false
            return sym = arguments_symbol
        }
        var member false
        if k = KindPropertyDeclaration
            set member: true
        if k = KindMethodDeclaration
            set member: true
        if k = KindGetAccessor
            set member: true
        if k = KindSetAccessor
            set member: true
        if member
        {
            let nm AstNode.name_of(n)
            if Checker.kind_or_unknown(nm) = KindComputedPropertyName
                return this.arguments_reference_visit(nm)
        }
        if k = KindPropertyAccessExpression
            return this.arguments_reference_visit(AstNode.expression_of(n))
        if k = KindElementAccessExpression
            return this.arguments_reference_visit(AstNode.expression_of(n))
        if k = KindPropertyAssignment
            return this.arguments_reference_visit(AstNode.initializer_of(n))
        if Checker.node_starts_new_lexical_environment(k)
            return false
        if AstNode.is_part_of_type_node(n)
            return false
        let cn AstNode.child_count(n)
        var i 0
        while i < cn
        {
            if this.arguments_reference_visit(AstNode.child_at(n, i))
                return true
            set i: i + 1
        }
        false
    }

    ; nodeStartsNewLexicalEnvironment, whole.
    function node_starts_new_lexical_environment(k: int) returns bool
    {
        if k = KindConstructor
            return true
        if k = KindFunctionExpression
            return true
        if k = KindFunctionDeclaration
            return true
        if k = KindArrowFunction
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindSourceFile
            return true
        false
    }

    function parameter_names_hold(params: ref[Array[ref[AstNode]?]]?, name: ref[AstNode]) returns bool
    {
        let n AstNode.list_count(params)
        var i 0
        while i < n
        {
            let p AstNode.child_in_list(params, i)
            let pname AstNode.name_of(p)
            if Checker.kind_or_unknown(pname) = KindIdentifier
            {
                if Checker.compare_names(AstNode.identifier_text_of(pname), AstNode.identifier_text_of(name)) = 0
                    return true
            }
            set i: i + 1
        }
        false
    }

    procedure check_signature_declaration(this, node: ref[AstNode])
    {
        this.check_signature_declaration_worker(node)
        if AstNode.kind_of(node) <> KindIndexSignature
            this.register_for_unused_identifiers_check(node)
    }

    procedure check_signature_declaration_worker(this, node: ref[AstNode])
    {
        let k AstNode.kind_of(node)
        if k = KindIndexSignature
        {
            ; checkGrammarIndexSignature — the parameter-count, modifier, name,
            ; type-annotation and return-type checks of `[k: string]: T`. ★Slice 52
            ; called it unreachable, slice 61's checkTypeLiteral was the arm that
            ; reached it, and slice 120 writes it.
            let reported this.check_grammar_index_signature(node)
        }
        else
        {
            if Checker.kind_has_function_like_grammar_check(k)
                this.check_grammar_function_like_declaration(node)
        }

        let function_flags b.get_function_flags(node)

        ; the async helpers below their feature's minimum target (slice 270)
        if (function_flags & FunctionFlagsInvalid) = 0
        {
            if ((function_flags & FunctionFlagsAsyncGenerator) = FunctionFlagsAsyncGenerator) and (language_version < ScriptTargetES2018)
                this.check_external_emit_helpers(node, ExternalEmitHelpersAwait | ExternalEmitHelpersAsyncGenerator)
            if ((function_flags & FunctionFlagsAsyncGenerator) = FunctionFlagsAsync) and (language_version < ScriptTargetES2017)
                this.check_external_emit_helpers(node, ExternalEmitHelpersAwaiter)
        }

        this.check_type_parameters(AstNode.type_parameters_of(node))

        ; checkUnmatchedJSDocParameters.
        ;
        ; ★★★ THE UNREACHABILITY PROOF THAT STOOD HERE WAS FALSE, AND SLICE 112 IS
        ; WHERE IT SHOWED. It rested on *check_source_element_worker reports
        ; `check-jsdoc-comments` and RETURNS for any node that [carries JSDoc]* —
        ; check_jsdoc_comment stops for a @link and for NOTHING else, so no gate has
        ; ever stood in front of this call. What hid it is that every unit reaching
        ; it stopped LATER, inside getReturnTypeFromBody; with that wall gone
        ; `conformance_jsdoc_jsdocParamTag` completes and is missing two TS8024
        ; lines. **A proof about a GATE is only as good as the gate's own
        ; condition** (§3.5p), and this one named a function without reading it.
        ;
        ; ★★ WHAT WAS BEHIND IT was containsArgumentsReference — a walk that
        ; resolves every identifier against c.argumentsSymbol — and isArrayType,
        ; i.e. the global `Array`. Both are here, and the call is UNGATED like the
        ; reference's: the JS scoping the stop carried belongs inside the function,
        ; where the two reports carry it.
        this.check_unmatched_jsdoc_parameters(node)

        this.check_source_elements(AstNode.parameters_of(node))

        let return_type_node AstNode.type_of(node)
        if return_type_node <> null
            this.check_source_element(return_type_node)

        ; `if c.noImplicitAny && returnTypeNode == nil` — a switch with arms for
        ; ConstructSignature and CallSignature only.
        ;
        ; ★★★ ITS NOTE READ *no kind this slice reaches can report there* AND THAT
        ; WAS ALREADY WRONG WHEN IT WAS WRITTEN — slice 109 found it at stage 2. The
        ; corpus holds ConstructSignatures and this check visits them; what it did
        ; not hold was a COMPARISON, because every unit with one stopped at
        ; `type-of-node` and its whole types artifact was UNPORTED. Three units
        ; (`ParameterList13`, `parserParameterList13`,
        ; `noImplicitAnyForwardReferencedInterface`) were missing TS7013 in silence.
        ; ★★What makes the arms cheap is that neither resolves a type: the test is
        ; the ABSENCE of an annotation, so it needs nothing this port lacks.
        ; ★noImplicitAny is TRUE under this harness, not false: it is a
        ; strict-FAMILY option, so an unset value falls through to `Strict !=
        ; TSFalse` (strict_null_checks' header has the three readings of "unset"
        ; this slice met).
        if Checker.no_implicit_any()
        {
            if return_type_node = null
            {
                if k = KindConstructSignature
                    this.error_on_node(node, DiagConstruct_signature_which_lacks_return_type_annotation_implicitly_has_an_any_return_type)
                if k = KindCallSignature
                    this.error_on_node(node, DiagCall_signature_which_lacks_return_type_annotation_implicitly_has_an_any_return_type)
            }
        }

        if return_type_node <> null
        {
            ; Two type checks on the annotation, and the flag tests are
            ; EQUALITY tests against a composite (FunctionFlags.scaly's header says
            ; why): a generator that is not invalid, and an async function that is
            ; not a generator. Both resolve the annotation through
            ; getTypeFromTypeNode, so both report — separately, because the second
            ; is also the whole of checkAsyncFunctionReturnType and the two arrive
            ; in different slices.
            let mark2 this.unported_mark()
            if (function_flags & (FunctionFlagsInvalid | FunctionFlagsGenerator)) = FunctionFlagsGenerator
            {
                let rt this.get_type_from_type_node(return_type_node as ref[AstNode])
                if this.unported_mark() <> mark2
                    return
                if rt = null
                    return
                if (rt as ref[Type]) = void_type
                    this.error_on_node(return_type_node, DiagA_generator_cannot_have_a_void_type_annotation)
                else
                    this.check_generator_instantiation_assignability_to_return_type(rt as ref[Type], function_flags, return_type_node)
                if this.unported_mark() <> mark2
                    return
            }
            else
            {
                if (function_flags & FunctionFlagsAsyncGenerator) = FunctionFlagsAsync
                {
                    this.check_async_function_return_type(node, return_type_node as ref[AstNode])
                    if this.unported_mark() <> mark2
                        return
                }
            }
        }

    }

    ; checkFunctionOrMethodDeclaration's prefix — two calls, and the third thing it
    ; does is where this slice stops.
    ;
    ; ★★★ THE SYMBOL CHECK RUNS FOR EVERY FUNCTION DECLARATION, NOT FOR SOME, and
    ; that is why the report is unconditional rather than behind the guard the
    ; reference writes. `c.hasBindableName(node)` is `!ast.HasDynamicName(node) ||
    ; c.hasLateBindableName(node)`, and HasDynamicName is `name != nil &&
    ; IsDynamicName(name)` — a computed or late-bound name. A function
    ; declaration's name is an Identifier or absent, so the left disjunct is TRUE
    ; on every one of them and checkFunctionOrConstructorSymbol is reached. Writing
    ; the guard and reporting inside it would suggest a shape the corpus does not
    ; contain.
    ;
    ; ★★★ WHAT STANDS BEHIND IT IS THE BODY, AND THAT IS THE SUCCESSOR. The
    ; reference's next line is `c.checkSourceElement(node.Body())` — a Block, an arm
    ; this port HAS since slice 50 — so the whole statement population of every
    ; function in the corpus is one report away. It is deliberately not taken here:
    ; the rule this column is built on (slice 49) is that the ported prefix runs up
    ; to the first thing the slice does not implement and the report NAMES that
    ; thing, and reaching past checkFunctionOrConstructorSymbol to pick up a later
    ; step would make the tag a statement about what was convenient. The bill for
    ; the successor is that one function: the symbol's declaration list walked for a
    ; duplicate implementation, an overload without one, and the modifier/abstract
    ; agreement across declarations.
    ;
    ; ★ Between the two lies `functionFlags := ast.GetFunctionFlags(node)`, whose
    ; readers are all behind the symbol check, and the computed-property-name arm —
    ; `if node.Name() != nil && ast.IsComputedPropertyName(node.Name())`.
    ;
    ; ★★★ THAT ARM WENT LIVE IN SLICE 62 AND THE SENTENCE THAT STOOD HERE HAD
    ; PREDICTED IT: it read *belongs to this function's OTHER caller: a method's
    ; name can be `[Symbol.x]`, a function declaration's cannot* — and the other
    ; caller is checkMethodDeclaration, which this file now has. So the report is
    ; here rather than in the method arm, at the reference's own line, and it is
    ; unreachable for the FunctionDeclaration caller for exactly the reason the old
    ; sentence gave. Nothing about a function declaration's tag moves.
    ; ── slice 100: the function expression, the arrow function and the ──────
    ; ── object-literal method ───────────────────────────────────────────────
    ;
    ; checkFunctionExpressionOrObjectLiteralMethod, whole.
    ;
    ; ★★★ THE ANSWER IS THE SYMBOL'S TYPE AND NOT ANYTHING THIS FUNCTION BUILDS,
    ; which is what makes the chapter openable at all: getTypeOfSymbol reaches
    ; getTypeOfFuncClassEnumModule, an arm this port has had since slice 65, so
    ; the anonymous type with its call signature already exists. What this
    ; function adds is the CHECKING — the grammar half, the contextual half and
    ; the deferred body — and none of it is on the path to the answer.
    ;
    ; ★★ THE SkipContextSensitive BLOCK IS A GATE WITH NO INPUT AND IT REPORTS
    ; RATHER THAN BEING LEFT OUT (§3.5v). CheckMode's own note says only Normal is
    ; ever passed in this port, so the whole early-out — the contextFreeTypes
    ; memo, the return-only signature and anyFunctionType, none of which this file
    ; mints — is unreachable. A slice that gives CheckMode a second writer meets a
    ; report here instead of a silently skipped branch.
    procedure check_function_expression_or_object_literal_method(this, node: ref[AstNode], check_mode: int) returns ref[Type]?
    {
        let k AstNode.kind_of(node)
        this.check_node_deferred(node)
        if k = KindFunctionExpression
            this.check_collisions_for_declaration_name(node, AstNode.name_of(node))
        ; ★★★ THE SkipContextSensitive EARLY-OUT, SLICE 141, AND THE NOTE THAT
        ; STOOD HERE HAD EXPIRED. It read *"the SkipContextSensitive block is a GATE
        ; WITH NO INPUT and it reports rather than being left out (§3.5v). CheckMode's
        ; own note says only Normal is ever passed in this port, so the whole
        ; early-out — the contextFreeTypes memo, the return-only signature and
        ; anyFunctionType, none of which this file mints — is unreachable. A slice
        ; that gives CheckMode a second writer meets a report here instead of a
        ; silently skipped branch."* Slices 108 and 138 gave it two (the call's
        ; argument check and infer_type_arguments) and slice 141 a third
        ; (get_context_free_type_of_expression), and the row was the LARGEST on the
        ; frontier — 258 units — with nothing pointing back at the sentence that
        ; explained it away. §3.5eo, and §3.5dk for the shape.
        ;
        ; ★★★ THE ANSWER IS A TYPE WITH ONE SIGNATURE AND NOTHING BUT A RETURN, which
        ; is what the reference's comment means by *skip parameters, return signature
        ; with return type that retains noncontextual parts so inferences can still
        ; be drawn in an early stage*: the parameters are what would need a contextual
        ; type, the return type is not, so the return type is computed FROM THE BODY
        ; and hung on an otherwise empty signature marked non-inferrable.
        ;
        ; ★★ AND THE THREE GUARDS IN FRONT OF IT ARE WHAT KEEP IT RARE. An annotated
        ; return type or a context-sensitive PARAMETER answers plain anyFunctionType;
        ; so does a function with no contextual signature, and so does one whose
        ; contextual return type cannot contain a type variable — the reference's own
        ; *there is no possibility we'll make inferences from the return type*.
        if (check_mode & CheckModeSkipContextSensitive) <> 0
        {
            if this.is_context_sensitive(node)
            {
                let mark this.unported_mark()
                var answered false
                var answer: ref[Type]? null
                if AstNode.type_of(node) = null
                {
                    if Checker.has_context_sensitive_parameters(node) = false
                    {
                        let contextual this.get_contextual_signature(node)
                        if this.unported_mark() <> mark
                            return null
                        if contextual <> null
                        {
                            let ret this.get_return_type_of_signature(contextual as ref[Signature])
                            if this.unported_mark() <> mark
                                return null
                            if ret <> null
                            {
                                if this.could_contain_type_variables(ret as ref[Type])
                                {
                                    let cached this.context_free_type_lookup(node)
                                    if cached <> null
                                        return cached
                                    let return_type this.get_return_type_from_body(node, check_mode)
                                    if this.unported_mark() <> mark
                                        return null
                                    if return_type = null
                                        return null
                                    let return_only this.new_signature(SignatureFlagsIsNonInferrable, null, null, null, null, return_type, 0)
                                    let sigs &Array[ref[Signature]?]^host()
                                    sigs.add(return_only)
                                    let made this.new_anonymous_type(AstNode.symbol_of(node), null, sigs, null, null)
                                    if made = null
                                        return null
                                    let return_only_type made as ref[Type]
                                    set return_only_type.object_flags: return_only_type.object_flags | ObjectFlagsNonInferrableType
                                    this.context_free_type_put(node, return_only_type)
                                    set answered: true
                                    set answer: return_only_type
                                }
                            }
                        }
                    }
                }
                if answered
                    return answer
                return any_function_type
            }
        }
        ; Grammar checking. ★The generator check is guarded by BOTH conjuncts and
        ; the second is a kind test: an arrow function cannot be a generator, and
        ; an object-literal method's asterisk is checked by checkGrammarMethod on
        ; the way in.
        let has_grammar_error this.check_grammar_function_like_declaration(node)
        if has_grammar_error = false
        {
            if k = KindFunctionExpression
                this.check_grammar_for_generator(node)
        }
        ; ★The note that stood here — *the same stop
        ; check_function_or_method_declaration carries* — deferred a function this
        ; file has had since the contextual-signature chapter;
        ; get_contextual_call_signature is at its own name above, and the row was
        ; two call sites of it and nothing else (slice 158, §3.5eo).
        this.report_wrong_full_signature_arity(node)
        let mark this.unported_mark()
        set fn_pin_arm: 0
        set fn_pin_ctxsig: 0
        this.contextually_check_function_expression_or_object_literal_method(node, check_mode)
        if this.unported_mark() <> mark
        {
            this.record_fn(node, k, 0)
            return null
        }
        let symbol this.symbol_of_declaration(node)
        if symbol = null
        {
            this.record_fn(node, k, 0)
            this.record_unported("function-expression-symbol", k)
            return null
        }
        let answer this.get_type_of_symbol(symbol as ref[Symbol])
        if answer = null
        {
            this.record_fn(node, k, 0)
            return null
        }
        this.record_fn(node, k, (answer as ref[Type]).id)
        answer
    }

    ; The FNPIN's entry — see FnEvent's header.
    ;
    ; ★★★ IT IS WRITTEN WHERE THE CHAPTER DECIDES AND NOT WHERE IT ANSWERS, WHICH
    ; IS THE OPPOSITE OF ObjLitEvent's RULE AND WAS MEASURED INTO PLACE. The first
    ; draft recorded only on the answering path, and the `ctxsig` column then read
    ; **0 on every row of every fixture** — because a contextual signature that IS
    ; found sends the function to getReturnTypeFromBody, which stops, so the one
    ; population the column exists to separate could never reach the log. A pin
    ; whose most interesting column is a constant is slice 99's finding seven; the
    ; difference here is that it had a fix. `type_id` is 0 on a row that did not
    ; answer, which is what keeps the two readings apart.
    procedure record_fn(this, node: ref[AstNode], k: int, type_id: int)
    {
        var sensitive 0
        if this.is_context_sensitive(node)
            set sensitive: 1
        if record_events
        {
            let ev &FnEvent^host(AstNode.pos_of(node), k, sensitive, fn_pin_ctxsig, fn_pin_arm, type_id)
            fn_log.add(ev as ref[FnEvent])
        }
    }

    ; contextuallyCheckFunctionExpressionOrObjectLiteralMethod, whole.
    ;
    ; ★★★ THE REFERENCE ASKS ITS OWN GUARD TWICE AND BOTH TESTS ARE KEPT. Its
    ; comment is the reason: *obtaining the contextual type may recursively get
    ; back to here during overload resolution of the call*, so the flag can have
    ; been set by the recursion between the two reads. The second test is the one
    ; that matters and the first is the cheap one; collapsing them would be a
    ; behaviour change the day a call site re-enters.
    ;
    ; ★★ THE CONTEXT-CHECKED BIT IS ONE NAMED BOOLEAN ON NodeLink, which is that
    ; record's own convention — NodeCheckFlags has thirty bits upstream and this
    ; port carries the two it has readers for.
    procedure contextually_check_function_expression_or_object_literal_method(this, node: ref[AstNode], check_mode: int)
    {
        let links this.node_link_of(node)
        if links.context_checked
            return
        let mark this.unported_mark()
        let contextual_signature this.get_contextual_signature(node)
        if this.unported_mark() <> mark
            return
        if contextual_signature <> null
            set fn_pin_ctxsig: 1
        if links.context_checked
            return
        set links.context_checked: true
        let symbol this.symbol_of_declaration(node)
        if symbol = null
        {
            this.record_unported("function-expression-symbol", AstNode.kind_of(node))
            return
        }
        let fn_type this.get_type_of_symbol(symbol as ref[Symbol])
        if this.unported_mark() <> mark
            return
        if fn_type = null
            return
        let sigs this.get_signatures_of_type(fn_type as ref[Type], SignatureKindCall)
        if this.unported_mark() <> mark
            return
        var signature: ref[Signature]? null
        if sigs <> null
        {
            let ss sigs as ref[Array[ref[Signature]?]]
            if ss.get_length() > 0
                set signature: ss[0]
        }
        if signature = null
            return
        let sig signature as ref[Signature]
        if this.is_context_sensitive(node)
        {
            if contextual_signature <> null
            {
                ; ★★★ THE INFERENCE BLOCK IS WHOLE SINCE SLICE 164, AND THE NOTE
                ; THAT COLLAPSED IT TO ITS LAST LINE HAD EXPIRED. It read *"`get
                ; InferenceContext` scans c.inferenceContextInfos, a STACK whose only
                ; writer is pushInferenceContext inside call-signature inference — a
                ; chapter this port has not opened — so it answers nil at every
                ; arrival here; and `checkMode&Inferential` is the same bit
                ; CheckMode's own note says has no writer"* — both premises died with
                ; slice 138's inference, and nothing pointed back at the sentence.
                ; ★The first draft REPORTED here instead, which was wrong in the
                ; expensive direction; the collapse that replaced it was wrong in the
                ; SILENT direction, which is worse.
                ;
                ; ★★★ IT IS WHERE A CONTEXT-SENSITIVE PARAMETER MEETS THE FIRST
                ; ROUND'S INFERENCES, and the two-line repro is
                ; `declare function f<T extends {a: string}>(x: {b: (p: T) => string}): number`
                ; called as `f({ b: (p) => p.a })`. Round two of chooseOverload
                ; re-checks the argument against the UNINSTANTIATED `(p: T) => string`
                ; — the reference does the same — so `p` is fixed HERE, once, by
                ; NodeCheckFlagsContextChecked, and the only thing that puts
                ; `{ a: string }` on it rather than `T` is instantiating the
                ; contextual signature through the inference context's mapper.
                ; Collapsed, `p` came out `T` and the contra-inference of `T` from
                ; `T` then made the type argument `T` as well.
                set fn_pin_arm: 2
                let inference_context this.get_inference_context(node)
                if this.unported_mark() <> mark
                    return
                var instantiated_contextual_signature: ref[Signature]? null
                if (check_mode & CheckModeInferential) <> 0
                {
                    if inference_context <> null
                    {
                        let ictx inference_context as ref[InferenceContext]
                        this.infer_from_annotated_parameters_and_return(sig, contextual_signature as ref[Signature], ictx)
                        if this.unported_mark() <> mark
                            return
                        ; "A rest parameter whose type is a bare type PARAMETER is
                        ; the one shape that must be instantiated through the
                        ; NON-FIXING mapper" — reading it here may not fix an
                        ; inference the caller is still making.
                        let rest_type this.get_effective_rest_type(contextual_signature as ref[Signature])
                        if this.unported_mark() <> mark
                            return
                        if rest_type <> null
                        {
                            if ((rest_type as ref[Type]).flags & TypeFlagsTypeParameter) <> 0
                            {
                                if ictx.non_fixing_mapper <> null
                                {
                                    set instantiated_contextual_signature: this.instantiate_signature(contextual_signature, ictx.non_fixing_mapper as ref[TypeMapper])
                                    if this.unported_mark() <> mark
                                        return
                                }
                            }
                        }
                    }
                }
                if instantiated_contextual_signature = null
                {
                    set instantiated_contextual_signature: contextual_signature
                    if inference_context <> null
                    {
                        let ictx2 inference_context as ref[InferenceContext]
                        if ictx2.mapper <> null
                        {
                            set instantiated_contextual_signature: this.instantiate_signature(contextual_signature, ictx2.mapper as ref[TypeMapper])
                            if this.unported_mark() <> mark
                                return
                        }
                    }
                }
                if instantiated_contextual_signature = null
                    return
                this.assign_contextual_parameter_types(sig, instantiated_contextual_signature as ref[Signature])
                if this.unported_mark() <> mark
                    return
            }
            else
            {
                ; "Force resolution of all parameter types such that the absence of
                ; a contextual type is consistently reflected."
                set fn_pin_arm: 1
                this.assign_non_contextual_parameter_types(sig)
                if this.unported_mark() <> mark
                    return
            }
        }
        else
        {
            if contextual_signature <> null
            {
                if AstNode.type_parameters_of(node) = null
                {
                    var context_params 0
                    if (contextual_signature as ref[Signature]).parameters <> null
                        set context_params: ((contextual_signature as ref[Signature]).parameters as ref[Array[ref[Symbol]?]]).get_length() as int
                    var own_params 0
                    let ps AstNode.parameters_of(node)
                    if ps <> null
                        set own_params: (ps as ref[Array[ref[AstNode]?]]).get_length() as int
                    if context_params > own_params
                    {
                        ; The arity fork's whole body is `getInferenceContext` and,
                        ; under CheckModeInferential, inferFromAnnotatedParameters
                        ; AndReturn — written out with the block above, on the same
                        ; expiry. ★The pin arm stays, because a battery cannot
                        ; otherwise tell "entered and empty" from "not entered".
                        set fn_pin_arm: 3
                        if (check_mode & CheckModeInferential) <> 0
                        {
                            let arity_context this.get_inference_context(node)
                            if this.unported_mark() <> mark
                                return
                            if arity_context <> null
                            {
                                this.infer_from_annotated_parameters_and_return(sig, contextual_signature as ref[Signature], arity_context as ref[InferenceContext])
                                if this.unported_mark() <> mark
                                    return
                            }
                        }
                    }
                }
            }
        }
        if contextual_signature <> null
        {
            let ann this.get_return_type_from_annotation(node)
            if this.unported_mark() <> mark
                return
            if ann = null
            {
                if sig.resolved_return_type = null
                {
                    ; getReturnTypeFromBody — the wall slice 100 left standing in
                    ; its own middle, and slice 112's chapter. ★The memo is written
                    ; through the reference's own second test: the call can resolve
                    ; the slot on its way, and overwriting it would replace a
                    ; memoised answer with a recomputed one.
                    let rt this.get_return_type_from_body(node, check_mode)
                    if this.unported_mark() <> mark
                        return
                    if sig.resolved_return_type = null
                        set sig.resolved_return_type: rt
                }
            }
        }
        this.check_signature_declaration(node)
    }

    ; inferFromAnnotatedParametersAndReturn — the ANNOTATED half of a
    ; context-sensitive function's parameters: `f((x: string) => x)` infers from the
    ; ANNOTATION `string` into the contextual parameter's position, and the same for
    ; an annotated return type. It is the reference's counterpart to
    ; assign_contextual_parameter_types, which runs the other direction.
    ;
    ; ★It reads `sig`'s parameter DECLARATIONS rather than their types, because an
    ; unannotated parameter is exactly the one this must NOT infer from.
    procedure infer_from_annotated_parameters_and_return(this, sig: ref[Signature], context: ref[Signature], inference_context: ref[InferenceContext])
    {
        let mark this.unported_mark()
        if sig.parameters <> null
        {
            let params sig.parameters as ref[Array[ref[Symbol]?]]
            var n params.get_length() as int
            if Checker.signature_has_rest_parameter(sig)
                set n: n - 1
            var i 0
            while i < n
            {
                let ps params[i]
                set i: i + 1
                if ps = null
                    continue
                let vd Symbol.value_declaration_of(ps as ref[Symbol])
                if vd = null
                    continue
                let declaration vd as ref[AstNode]
                let type_node AstNode.type_of(declaration)
                if type_node = null
                    continue
                let declared this.get_type_from_type_node(type_node as ref[AstNode])
                if this.unported_mark() <> mark
                    return
                if declared = null
                    return
                let source this.add_optionality_ex(declared as ref[Type], false, Checker.is_optional_declaration(declaration))
                if this.unported_mark() <> mark
                    return
                if source = null
                    return
                let target this.get_type_at_position(context, i - 1)
                if this.unported_mark() <> mark
                    return
                if target = null
                    return
                this.infer_types(inference_context.inferences, source, target, InferencePriorityNone, false)
                if this.unported_mark() <> mark
                    return
            }
        }
        if sig.declaration = null
            return
        let return_type_node AstNode.type_of(sig.declaration as ref[AstNode])
        if return_type_node = null
            return
        let source this.get_type_from_type_node(return_type_node as ref[AstNode])
        if this.unported_mark() <> mark
            return
        if source = null
            return
        let target this.get_return_type_of_signature(context)
        if this.unported_mark() <> mark
            return
        if target = null
            return
        this.infer_types(inference_context.inferences, source, target, InferencePriorityNone, false)
    }

    ; getContextualSignature. "Return the contextual signature for a given
    ; expression node. A contextual type provides a contextual signature if it has
    ; a single call signature and if that call signature is non-generic."
    ;
    ; ★★★ THE UNION ARM IS WHOLE SINCE SLICE 174, AND THE NOTE THAT STOPPED IT
    ; NAMED A DIMENSION RATHER THAN A CALLEE — *compareSignaturesIdentical is the
    ; RELATION dimension … where this chapter ends*. That function has stood since
    ; slice 145 and create_union_signature arrived with getUnionSignatures in 155.
    procedure get_contextual_signature(this, node: ref[AstNode]) returns ref[Signature]?
    {
        let mark this.unported_mark()
        let t this.get_apparent_type_of_contextual_type(node, ContextFlagsSignature)
        if this.unported_mark() <> mark
            return null
        if t = null
            return null
        let ct t as ref[Type]
        if (ct.flags & TypeFlagsUnion) = 0
            return this.get_contextual_call_signature(ct, node)
        let types Checker.union_types_of(ct)
        if types = null
            return null
        let ts types as ref[Array[ref[Type]?]]
        let signature_list Array[ref[Signature]?]^host()
        var i 0
        while i < ts.get_length()
        {
            let current ts[i]
            if current <> null
            {
                let sig this.get_contextual_call_signature(current as ref[Type], node)
                if this.unported_mark() <> mark
                    return null
                if sig <> null
                {
                    if signature_list.get_length() <> 0
                    {
                        let firsts signature_list[0]
                        if firsts = null
                            return null
                        ; "Signatures aren't identical, do not use"
                        if this.compare_signatures_identical(firsts as ref[Signature], sig as ref[Signature], false, true, true, SignatureComparerIdentical) = false
                            return null
                        if this.unported_mark() <> mark
                            return null
                    }
                    ; "Use this signature for contextual union signature"
                    signature_list.add(sig)
                }
            }
            set i: i + 1
        }
        let n signature_list.get_length()
        if n = 0
            return null
        let head signature_list[0]
        if head = null
            return null
        if n = 1
            return head
        ; "Result is union of signatures collected (return type is union of return
        ; types of this signature set)"
        this.create_union_signature(head as ref[Signature], signature_list)
    }

    ; getContextualCallSignature: "If the given type is an object or union type
    ; with a single signature, and if that signature has at least as many
    ; parameters as the given function, return the signature. Otherwise return
    ; undefined."
    procedure get_contextual_call_signature(this, t: ref[Type], node: ref[AstNode]) returns ref[Signature]?
    {
        let mark this.unported_mark()
        let signatures this.get_signatures_of_type(t, SignatureKindCall)
        if this.unported_mark() <> mark
            return null
        if signatures = null
            return null
        let ss signatures as ref[Array[ref[Signature]?]]
        var only: ref[Signature]? null
        var applicable 0
        var i 0
        while i < ss.get_length()
        {
            let s ss[i]
            if s <> null
            {
                let smaller this.is_arity_smaller(s as ref[Signature], node)
                if this.unported_mark() <> mark
                    return null
                if smaller = false
                {
                    set only: s
                    set applicable: applicable + 1
                }
            }
            set i: i + 1
        }
        if applicable = 1
            return only
        if applicable = 0
            return null
        ; getIntersectedSignatures over the applicable signatures (slice 174). The
        ; set is rebuilt rather than carried through the loop above, because the
        ; one-signature case is the overwhelmingly common one and it needs no list.
        let applicable_list Array[ref[Signature]?]^host()
        var j 0
        while j < ss.get_length()
        {
            let s2 ss[j]
            set j: j + 1
            if s2 = null
                continue
            if this.is_arity_smaller(s2 as ref[Signature], node)
                continue
            if this.unported_mark() <> mark
                return null
            applicable_list.add(s2)
        }
        this.get_intersected_signatures(applicable_list)
    }

    ; getIntersectedSignatures. ★noImplicitAny is TRUE under this harness, so the
    ; fold is live whenever the applicable count is not one.
    ;
    ; ★★★ THE NOTE THAT STOPPED IT NAMED *the relation dimension again*, and both
    ; halves had landed — compare_type_parameters_identical (slice 145) and
    ; combine_union_or_intersection_member_signatures (slice 155).
    ;
    ; ★ `combined = sig` is upstream's and is not `combined = null`: a list may
    ; hold one signature twice, and folding it into itself builds a composite over
    ; a pair of identical members.
    procedure get_intersected_signatures(this, signatures: ref[Array[ref[Signature]?]]) returns ref[Signature]?
    {
        if Checker.no_implicit_any() = false
            return null
        let mark this.unported_mark()
        var combined: ref[Signature]? null
        var i 0
        while i < signatures.get_length()
        {
            let sig signatures[i]
            set i: i + 1
            if sig = null
                continue
            if combined = null
            {
                set combined: sig
                continue
            }
            if combined = sig
                continue
            if this.compare_type_parameters_identical((combined as ref[Signature]).type_parameters, (sig as ref[Signature]).type_parameters) = false
                return null
            if this.unported_mark() <> mark
                return null
            set combined: this.combine_union_or_intersection_member_signatures(combined as ref[Signature], sig as ref[Signature], false)
            if this.unported_mark() <> mark
                return null
            if combined = null
                return null
        }
        combined
    }

    ; The two identical `FullSignature` blocks of checkFunctionOrMethodDeclaration
    ; and checkFunctionExpressionOrObjectLiteralMethod, as one routine because the
    ; reference's two copies are the same five lines. ★The report sits on the
    ; FULLSIGNATURE node and not on the function, which is why no other caller can
    ; produce it: a JSDoc `@type` tag is the only thing that puts one there.
    procedure report_wrong_full_signature_arity(this, node: ref[AstNode])
    {
        let full AstNode.full_signature_of(node)
        if full = null
            return
        let fs full as ref[AstNode]
        let mark this.unported_mark()
        let t this.get_type_from_type_node(fs)
        if this.unported_mark() <> mark
            return
        if t = null
            return
        let signature this.get_contextual_call_signature(t as ref[Type], node)
        if this.unported_mark() <> mark
            return
        if signature = null
            this.error_on_node(fs, DiagA_JSDoc_type_tag_on_a_function_must_have_a_signature_with_the_correct_number_of_arguments)
    }

    ; isAritySmaller: "If the contextual signature has fewer parameters than the
    ; function expression, do not use it."
    procedure is_arity_smaller(this, signature: ref[Signature], target: ref[AstNode]) returns bool
    {
        let params AstNode.parameters_of(target)
        var count 0
        var target_parameter_count 0
        if params <> null
        {
            let ps params as ref[Array[ref[AstNode]?]]
            set count: ps.get_length() as int
            while target_parameter_count < count
            {
                let p ps[target_parameter_count]
                if p = null
                    break
                let param p as ref[AstNode]
                if AstNode.initializer_of(param) <> null
                    break
                if AstNode.question_token_of(param) <> null
                    break
                if AstNode.dot_dot_dot_token_of(param) <> null
                    break
                set target_parameter_count: target_parameter_count + 1
            }
            if count <> 0
            {
                if AstNode.is_this_parameter(ps[0])
                    set target_parameter_count: target_parameter_count - 1
            }
        }
        let mark this.unported_mark()
        let rest this.has_effective_rest_parameter(signature)
        if this.unported_mark() <> mark
            return false
        if rest
            return false
        let pc this.get_parameter_count(signature)
        if this.unported_mark() <> mark
            return false
        pc < target_parameter_count
    }

    ; signatureHasRestParameter, one line.
    function signature_has_rest_parameter(sig: ref[Signature]) returns bool
        (sig.flags & SignatureFlagsHasRestParameter) <> 0

    ; getParameterCount and hasEffectiveRestParameter, whose tuple halves are
    ; UNREACHABLE rather than unwritten and say so at their line: nothing in this
    ; port mints a tuple type (is_tuple_type's own header records that the tuple
    ; bit has no writer), so a rest parameter's type is never one and the
    ; TargetTupleType() reads behind the test have no input. The report is what
    ; makes that a claim the tuple slice will meet rather than a silence.
    procedure get_parameter_count(this, signature: ref[Signature]) returns int
    {
        var length 0
        if signature.parameters <> null
            set length: (signature.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
        if Checker.signature_has_rest_parameter(signature)
        {
            let last (signature.parameters as ref[Array[ref[Symbol]?]])[length - 1]
            if last <> null
            {
                let rest_type this.get_type_of_symbol(last as ref[Symbol])
                if rest_type <> null
                {
                    if Checker.is_tuple_type(rest_type as ref[Type])
                    {
                        ; `length + fixedLength - IfElse(combinedFlags&Variable != 0,
                        ; 0, 1)`: a rest parameter typed as a tuple contributes its
                        ; FIXED elements in place of itself, and it keeps its own
                        ; slot only when the tuple still has a variable tail.
                        let tgt Checker.target_of(rest_type as ref[Type]) as ref[Type]
                        var adjust 1
                        if (Checker.tuple_combined_flags_of(tgt) & ElementFlagsVariable) <> 0
                            set adjust: 0
                        return length + Checker.tuple_fixed_length_of(tgt) - adjust
                    }
                }
            }
        }
        length
    }

    procedure has_effective_rest_parameter(this, signature: ref[Signature]) returns bool
    {
        if Checker.signature_has_rest_parameter(signature) = false
            return false
        var length 0
        if signature.parameters <> null
            set length: (signature.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
        let last (signature.parameters as ref[Array[ref[Symbol]?]])[length - 1]
        if last = null
            return true
        let rest_type this.get_type_of_symbol(last as ref[Symbol])
        if rest_type = null
            return true
        if Checker.is_tuple_type(rest_type as ref[Type]) = false
            return true
        ; `!isTupleType(restType) || combinedFlags&Variable != 0` — a tuple rest
        ; parameter is an effective rest parameter only while the tuple itself has a
        ; variable tail.
        let tgt Checker.target_of(rest_type as ref[Type]) as ref[Type]
        (Checker.tuple_combined_flags_of(tgt) & ElementFlagsVariable) <> 0
    }


    ; ── slice 108: the arity accessors ──────────────────────────────────────
    ;
    ; getMinArgumentCountEx, getTypeAtPosition/tryGetTypeAtPosition and the rest
    ; pair, all four of them beside get_parameter_count because they read the same
    ; three things: the parameter list, the rest flag and the tuple that is not
    ; there.

    ; getMinArgumentCountEx with `MinArgumentCountFlagsNone`, which is what both of
    ; its callers here pass.
    ;
    ; ★★★ ITS MEMO IS THE SIGNATURE'S OWN FIELD AND THE SENTINEL IS −1, which is why
    ; `resolved_min_argument_count` has been on the Signature record since slice 86
    ; with no reader: this is the reader. ★★And the memo is written only on the path
    ; that ANSWERS — every stop returns before the write, because a memo filled from
    ; an incomplete walk is the one shape `unported_mark` cannot see afterwards
    ; (get_resolved_signature's header makes the same point in a links table).
    ;
    ; ★★ THE `voidIsNonOptional` HALF IS DROPPED AND THAT IS A CLAIM ABOUT THE
    ; CALLERS, not about the flag: with the flag set the reference SKIPS the memo and
    ; returns before the void loop, and the only site that passes it is
    ; getMinTypeArgumentCount's neighbour in the signature-relation code, which this
    ; port does not reach.
    ;
    ; ★ The untyped-JS-signature arm returns 0 without touching the memo, exactly as
    ; upstream — a signature flagged IsUntypedSignatureInJSFile has no arity at all.
    ; Nothing in this port sets that flag yet, so the arm is the reference's line and
    ; not a live branch.
    procedure get_min_argument_count(this, signature: ref[Signature]) returns int
    {
        if signature.resolved_min_argument_count <> (0 - 1)
            return signature.resolved_min_argument_count
        let mark this.unported_mark()
        var min_argument_count 0 - 1
        if Checker.signature_has_rest_parameter(signature)
        {
            var length 0
            if signature.parameters <> null
                set length: (signature.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
            let last (signature.parameters as ref[Array[ref[Symbol]?]])[length - 1]
            if last <> null
            {
                let rest_type this.get_type_of_symbol(last as ref[Symbol])
                if this.unported_mark() <> mark
                    return 0
                if rest_type <> null
                {
                    if Checker.is_tuple_type(rest_type as ref[Type])
                    {
                        ; FindIndex over the element infos for the first NON-required
                        ; element; where there is none the required count is the
                        ; tuple's fixedLength. ★A required count of ZERO leaves
                        ; minArgumentCount at −1, which is the sentinel the block
                        ; below reads — so the `> 0` test is not a shortcut.
                        let tgt Checker.target_of(rest_type as ref[Type]) as ref[Type]
                        let arity Checker.tuple_arity_of(tgt)
                        var first_optional (0 - 1)
                        var ti 0
                        while ti < arity
                        {
                            if first_optional < 0
                            {
                                if (Checker.tuple_element_flags_at(tgt, ti) & ElementFlagsRequired) = 0
                                    set first_optional: ti
                            }
                            set ti: ti + 1
                        }
                        var required_count first_optional
                        if first_optional < 0
                            set required_count: Checker.tuple_fixed_length_of(tgt)
                        if required_count > 0
                            set min_argument_count: length - 1 + required_count
                    }
                }
            }
        }
        if min_argument_count = (0 - 1)
        {
            if (signature.flags & SignatureFlagsIsUntypedSignatureInJSFile) <> 0
                return 0
            set min_argument_count: signature.min_argument_count
        }
        var i min_argument_count - 1
        while i >= 0
        {
            let t this.get_type_at_position(signature, i)
            if this.unported_mark() <> mark
                return 0
            if t = null
                return 0
            if Checker.some_type_accepts_void(t as ref[Type]) = false
                break
            set min_argument_count: i
            set i: i - 1
        }
        set signature.resolved_min_argument_count: min_argument_count
        min_argument_count
    }

    ; someType over `acceptsVoid`, which is the predicate both of this pair's readers
    ; want. ★It is spelled as `someType` and not as `filterType(...).flags & Never`
    ; — hasCorrectArity's own spelling — because the two coincide exactly (a filter
    ; that keeps nothing answers NEVER) and only one of them needs a union type to be
    ; BUILT.
    function some_type_accepts_void(t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return (t.flags & TypeFlagsVoid) <> 0
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        var i 0
        while i < list.get_length()
        {
            let c list[i]
            if c <> null
            {
                if ((c as ref[Type]).flags & TypeFlagsVoid) <> 0
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; getTypeAtPosition and tryGetTypeAtPosition. ★★The `any` fallback is the
    ; reference's and it is load-bearing for the void loop above: a position past the
    ; parameter list answers `any`, which is not void, which ends the loop.
    procedure get_type_at_position(this, signature: ref[Signature], pos: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let t this.try_get_type_at_position(signature, pos)
        if this.unported_mark() <> mark
            return null
        if t <> null
            return t
        any_type
    }


    ; getEffectiveRestType and getNonArrayRestType.
    ;
    ; ★★★ THE `any` AND ARRAY PATHS CANNOT ANSWER NON-NIL IN THIS PORT AND BOTH
    ; REASONS ARE THE LIB. getEffectiveRestType turns an `any` rest parameter into
    ; `anyArrayType`, which is createArrayType over `globalArrayType`;
    ; getNonArrayRestType then asks `isArrayType`, whose whole body is an identity
    ; test against globalArrayType and globalReadonlyArrayType. Both are §3.11.
    ; ★★ THE TUPLE ARM IS THE ONE THAT IS FREE OF THAT and it is written (slice
    ; 161): it answers through sliceTupleType, which mints a tuple rather than
    ; asking for `Array`. ★★hasCorrectArity gets its rest answer from
    ; has_effective_rest_parameter, which needs no lib type either, so arity is
    ; decided for such a signature whatever this function answers.
    procedure get_effective_rest_type(this, signature: ref[Signature]) returns ref[Type]?
    {
        if Checker.signature_has_rest_parameter(signature) = false
            return null
        var length 0
        if signature.parameters <> null
            set length: (signature.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
        let last (signature.parameters as ref[Array[ref[Symbol]?]])[length - 1]
        if last = null
            return null
        let mark this.unported_mark()
        let rest_type this.get_type_of_symbol(last as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        if rest_type = null
            return null
        let rt rest_type as ref[Type]
        if Checker.is_tuple_type(rt)
        {
            ; ★★ THE TUPLE ARM NEEDS NO LIB TYPE, which is why it can stand where
            ; the two below cannot: sliceTupleType answers a TUPLE, and a tuple
            ; whose combined flags carry no VARIABLE element has no effective rest
            ; type at all.
            let target Checker.target_of(rt)
            if target = null
                return null
            let tgt target as ref[Type]
            if (Checker.tuple_combined_flags_of(tgt) & ElementFlagsVariable) = 0
                return null
            return this.slice_tuple_type(rt, Checker.tuple_fixed_length_of(tgt), 0)
        }
        if Checker.is_type_any(rt)
            return this.get_any_array_type()
        rt
    }

    procedure get_non_array_rest_type(this, signature: ref[Signature]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let rest_type this.get_effective_rest_type(signature)
        if this.unported_mark() <> mark
            return null
        if rest_type = null
            return null
        let rt rest_type as ref[Type]
        ; `restType != nil && !c.isArrayType(restType) && !IsTypeAny(restType)`.
        ; ★The third conjunct cannot fire through get_effective_rest_type — an `any`
        ; rest type comes back as anyArrayType, which IS an array type — so the
        ; second one decides. Written as the reference's test all the same.
        if this.is_array_type(rt)
            return null
        if Checker.is_type_any(rt)
            return null
        rt
    }

    ; assignContextualParameterTypes, whole but two branches.
    ;
    ; ★★ THE TYPE-PARAMETER ARM IS A WRITE INTO THE SIGNATURE AND ITS GUARD IS A
    ; MEMO: a signature that already carries type parameters has had a contextual
    ; inference performed and cached on it, so the second visit returns rather
    ; than overwriting. The reference's comment says exactly that.
    ;
    ; ★ The `this` parameter arm mints a TRANSIENT symbol through
    ; createSymbolWithType, which is the second producer of one in this file
    ; (instantiate_symbol is the first) — so CheckFlags is a bit here rather than
    ; a claim, exactly as Symbol's own note records.
    procedure assign_contextual_parameter_types(this, sig: ref[Signature], context: ref[Signature])
    {
        let mark this.unported_mark()
        if context.type_parameters <> null
        {
            if (context.type_parameters as ref[Array[ref[Type]?]]).get_length() > 0
            {
                if sig.type_parameters <> null
                {
                    if (sig.type_parameters as ref[Array[ref[Type]?]]).get_length() > 0
                        return
                }
                set sig.type_parameters: context.type_parameters
            }
        }
        if context.this_parameter <> null
        {
            let ctx_this context.this_parameter as ref[Symbol]
            var assign false
            if sig.this_parameter = null
            {
                set assign: true
                set sig.this_parameter: this.create_symbol_with_type(ctx_this, null)
            }
            else
            {
                let vd Symbol.value_declaration_of(sig.this_parameter as ref[Symbol])
                if vd <> null
                {
                    if AstNode.type_of(vd as ref[AstNode]) = null
                        set assign: true
                }
            }
            if assign
            {
                let ct this.get_type_of_symbol(ctx_this)
                if this.unported_mark() <> mark
                    return
                this.assign_parameter_type(sig.this_parameter as ref[Symbol], ct)
                if this.unported_mark() <> mark
                    return
            }
        }
        if sig.parameters = null
            return
        let ps sig.parameters as ref[Array[ref[Symbol]?]]
        var length ps.get_length() as int
        if Checker.signature_has_rest_parameter(sig)
            set length: length - 1
        var i 0
        while i < length
        {
            let p ps[i]
            if p = null
                return
            let parameter p as ref[Symbol]
            let declaration Symbol.value_declaration_of(parameter)
            var annotated true
            if declaration = null
                set annotated: false
            else
            {
                if AstNode.type_of(declaration as ref[AstNode]) = null
                    set annotated: false
            }
            if annotated = false
            {
                var t this.try_get_type_at_position(context, i)
                if this.unported_mark() <> mark
                    return
                ; ★★★ THE DEFAULT-VALUE ARM'S NOTE NAMED THREE CALLEES AS THE WALL —
                ; *checkDeclarationInitializer, isTypeAssignableTo and
                ; widenTypeInferredFromInitializer — the RELATION dimension* — and all
                ; three have been in this file for slices. The relation's `no` here is
                ; not a report but a type CHOICE, so a stop read as `no` would WIDEN a
                ; contextual parameter type instead of inventing a diagnostic; the mark
                ; is read for that reason rather than for a message's.
                if t <> null
                {
                    if declaration <> null
                    {
                        if AstNode.initializer_of(declaration as ref[AstNode]) <> null
                        {
                            let init_type this.check_declaration_initializer(declaration as ref[AstNode], CheckModeNormal, null)
                            if this.unported_mark() <> mark
                                return
                            if init_type = null
                                return
                            var widened: ref[Type]? init_type
                            let assignable this.is_type_assignable_to(init_type as ref[Type], t as ref[Type])
                            if this.unported_mark() <> mark
                                return
                            if assignable = false
                            {
                                set widened: this.widen_type_inferred_from_initializer(declaration as ref[AstNode], init_type)
                                if this.unported_mark() <> mark
                                    return
                                if widened = null
                                    return
                                let back this.is_type_assignable_to(t as ref[Type], widened as ref[Type])
                                if this.unported_mark() <> mark
                                    return
                                if back
                                    set t: widened
                            }
                        }
                    }
                }
                this.assign_parameter_type(parameter, t)
                if this.unported_mark() <> mark
                    return
            }
            set i: i + 1
        }
        if Checker.signature_has_rest_parameter(sig) = false
            return
        ; "parameter might be a transient symbol generated by use of `arguments` in
        ; the function body" — and getRestTypeAtPosition behind the guard is the
        ; synthetic tuple, whole since slice 150. ★`false` for readonly is the
        ; reference's own argument here and not a dropped one; the caller that
        ; computes it is applyToParameterTypes.
        let last ps[(ps.get_length() as int) - 1]
        if last = null
            return
        let lp last as ref[Symbol]
        let vd Symbol.value_declaration_of(lp)
        var wanted false
        if vd <> null
        {
            if AstNode.type_of(vd as ref[AstNode]) = null
                set wanted: true
        }
        else
        {
            if (Symbol.check_flags_of(lp) & CheckFlagsDeferredType) <> 0
                set wanted: true
        }
        if wanted
        {
            let contextual this.get_rest_type_at_position(context, length, false)
            if this.unported_mark() <> mark
                return
            this.assign_parameter_type(lp, contextual)
        }
    }

    ; createSymbolWithType, whole.
    procedure create_symbol_with_type(this, source: ref[Symbol], t: ref[Type]?) returns ref[Symbol]
    {
        let symbol this.new_symbol_ex(Symbol.flags_of(source), Symbol.name_of(source), Symbol.check_flags_of(source) & CheckFlagsReadonly)
        ; The reference's three copies — Declarations, Parent and
        ; ValueDeclaration — are the three this procedure already makes.
        Symbol.copy_declarations_from(symbol, source)
        let links this.value_symbol_link_of(symbol)
        set links.resolved_type: t
        set links.target: source
        ; ★★★ THE FOURTH COPY WAS MISSING UNTIL SLICE 135, AND IT IS THE ONE THAT
        ; CARRIES A NAME THE SOURCE CANNOT SPELL. `links.nameType` is what
        ; write_property_name_of_symbol's own nameType arm reads, so without it
        ; getWidenedTypeOfObjectLiteral's fresh symbols lose it and a computed
        ; NEGATIVE numeric name comes out as a string: measured, the object
        ; literal itself printed `{ [-1]: {} }` and the widened type of the
        ; variable holding it printed `{ "-1": {} }`, in the same dump, two lines
        ; apart (computedPropertyNamesDeclarationEmit6). ★It surfaced only when
        ; slice 135's union work took those units past their first wall — a
        ; dropped line in a ported function produces no row on any frontier.
        set links.name_type: this.value_symbol_link_of(source).name_type
        symbol
    }

    ; assignNonContextualParameterTypes, whole — and it is the arm this corpus
    ; almost always takes, because a function expression with no contextual type
    ; is the ordinary shape.
    ;
    ; ★★★ IT IS NOT A NO-OP AND THAT IS THE POINT OF THE `nil` IT PASSES:
    ; assignParameterType with no contextual type falls to getWidenedTypeFor
    ; VariableLikeDeclaration WITH reportErrors — which is where TS7006 (*parameter
    ; implicitly has an any type*) comes from. The reference's own comment says
    ; the call exists to force that resolution, so skipping it would lose a
    ; diagnostic rather than save work.
    procedure assign_non_contextual_parameter_types(this, signature: ref[Signature])
    {
        let mark this.unported_mark()
        if signature.this_parameter <> null
        {
            this.assign_parameter_type(signature.this_parameter as ref[Symbol], null)
            if this.unported_mark() <> mark
                return
        }
        if signature.parameters = null
            return
        let ps signature.parameters as ref[Array[ref[Symbol]?]]
        var i 0
        while i < ps.get_length()
        {
            let p ps[i]
            if p <> null
            {
                this.assign_parameter_type(p as ref[Symbol], null)
                if this.unported_mark() <> mark
                    return
            }
            set i: i + 1
        }
    }

    ; assignParameterType, ported down to its two tails.
    ;
    ; ★★ THE BINDING-PATTERN TAIL IS A CHAPTER AND NOT A LINE: assignBinding
    ; ElementTypes walks the pattern and writes a resolved type per element, and
    ; getTypeFromBindingPattern is the fallback behind it. A parameter whose name
    ; is an identifier — every parameter this corpus's function expressions have
    ; but a handful — never reaches it.
    procedure assign_parameter_type(this, parameter: ref[Symbol], contextual_type: ref[Type]?)
    {
        let links this.value_symbol_link_of(parameter)
        if links.resolved_type <> null
            return
        let mark this.unported_mark()
        let declaration Symbol.value_declaration_of(parameter)
        var t contextual_type
        if t = null
        {
            if declaration <> null
                set t: this.get_widened_type_for_variable_like_declaration(declaration as ref[AstNode], true)
            else
                set t: this.get_type_of_symbol(parameter)
            if this.unported_mark() <> mark
                return
        }
        if t = null
            return
        var optional false
        if declaration <> null
        {
            let d declaration as ref[AstNode]
            if AstNode.initializer_of(d) = null
            {
                if Checker.is_optional_declaration(d)
                    set optional: true
            }
        }
        let widened this.add_optionality_ex(t as ref[Type], false, optional)
        if this.unported_mark() <> mark
            return
        if widened = null
            return
        set links.resolved_type: widened
        if declaration = null
            return
        let name AstNode.name_of(declaration as ref[AstNode])
        if Checker.kind_or_unknown(name) = KindIdentifier
            return
        if name = null
            return
        ; "if inference didn't come up with anything but unknown, fall back to the
        ; binding pattern if present."
        var resolved: ref[Type]? links.resolved_type
        if resolved <> null
        {
            if (resolved as ref[Type]) = unknown_type
            {
                let from_pattern this.get_type_from_binding_pattern(name as ref[AstNode], false, false)
                if this.unported_mark() <> mark
                    return
                set links.resolved_type: from_pattern
                set resolved: from_pattern
            }
        }
        if resolved = null
            return
        this.assign_binding_element_types(name as ref[AstNode], resolved as ref[Type])
    }

    ; assignBindingElementTypes. "When contextual typing assigns a type to a
    ; parameter that contains a binding pattern, we also need to push the
    ; destructured type into the contained binding elements."
    ;
    ; ★★★ IT WRITES `resolvedType` DIRECTLY AND DOES NOT GO THROUGH
    ; get_type_of_symbol: the element's type is being IMPOSED by the context, so
    ; asking the symbol for its own type here would either re-derive it from the
    ; declaration — which is what the contextual type is overriding — or reenter
    ; this very routine. ★A nested pattern recurses with the element's own type,
    ; which is why the write happens only at an IDENTIFIER leaf.
    procedure assign_binding_element_types(this, pattern: ref[AstNode], parent_type: ref[Type])
    {
        let elements AstNode.elements_of(pattern)
        if elements = null
            return
        let list elements as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let element row as ref[AstNode]
            let name AstNode.name_of(element)
            if name = null
                continue
            let nm name as ref[AstNode]
            let t this.get_binding_element_type_from_parent_type(element, parent_type, false)
            if this.unported_mark() <> mark
                return
            if AstNode.kind_of(nm) = KindIdentifier
            {
                let symbol this.get_symbol_of_declaration(element)
                if this.unported_mark() <> mark
                    return
                if symbol = null
                    continue
                set this.value_symbol_link_of(symbol as ref[Symbol]).resolved_type: t
                continue
            }
            if t = null
                continue
            this.assign_binding_element_types(nm, t as ref[Type])
        }
    }

    ; checkFunctionExpressionOrObjectLiteralMethodDeferred, whole.
    ;
    ; ★★★ THIS IS WHERE THE SLICE'S PRODUCT IS. Everything above answers a type;
    ; this walks the BODY, and the body of a function expression or an arrow has
    ; never been visited by this port before. The `getReturnTypeOfSignature` call
    ; in front of it is made for its ERRORS — the reference's own comment says so
    ; — and it stops in this port at get-return-type-from-body; the walk continues
    ; past that stop deliberately, because the reference ignores the result too
    ; and because a unit that has already stopped makes no claim either way.
    ;
    ; ★★ THE EXPRESSION-BODY ARM IS PORTED TO ITS FIRST CALL AND NO FURTHER:
    ; checkExpression on the body IS the arrow function's product, and
    ; unwrapReturnType/checkReturnExpression behind the annotation are the
    ; return-type chapter.
    procedure check_function_expression_or_object_literal_method_deferred(this, node: ref[AstNode])
    {
        let mark this.unported_mark()
        let return_type this.get_return_type_from_annotation(node)
        if this.unported_mark() = mark
            this.check_all_code_paths_in_non_void_function_return_or_throw(node, return_type)
        let body_opt AstNode.body_of(node)
        if body_opt = null
            return
        let body body_opt as ref[AstNode]
        if AstNode.type_of(node) = null
        {
            let sig this.get_signature_from_declaration(node)
            if sig <> null
                this.get_return_type_of_signature(sig as ref[Signature])
        }
        if AstNode.kind_of(body) = KindBlock
        {
            this.check_source_element(body)
            return
        }
        let expr_mark this.unported_mark()
        let expr_type this.check_expression(body)
        if this.unported_mark() <> expr_mark
            return
        if return_type = null
            return
        ; "we need to check assignability of the awaited type of the expression
        ; body against the promised type of its return type annotation" — the
        ; reference's own comment for why unwrapReturnType stands here.
        let function_flags b.get_function_flags(node)
        let promised this.unwrap_return_type(return_type as ref[Type], function_flags, node)
        if this.unported_mark() <> expr_mark
            return
        if promised = null
            return
        this.check_return_expression(node, promised as ref[Type], body, body, expr_type, false)
    }

    procedure check_function_or_method_declaration(this, node: ref[AstNode])
    {
        this.check_decorators(node)
        this.check_signature_declaration(node)
        ; `functionFlags := ast.GetFunctionFlags(node)` at the reference's own line.
        ; The note above predicted its readers were *all behind the symbol check*;
        ; slice 82 is where they arrive — the generator fork of unwrapReturnType and
        ; the generator half of the implicit-any block at the tail.
        let function_flags b.get_function_flags(node)
        ; The reference's comment at the line is the whole argument for asking the
        ; kind rather than hasDynamicName: *do not use hasDynamicName here, because
        ; that returns false for well known symbols* — `[Symbol.iterator]() {}` is
        ; a computed name whose expression IS late-bindable, and it must reach
        ; checkComputedPropertyName all the same.
        let name AstNode.name_of(node)
        if Checker.kind_or_unknown(name) = KindComputedPropertyName
            this.check_computed_property_name(name as ref[AstNode])
        ; ★★★ SLICE 68 PORTS THE GUARD THE OLD REPORT STOOD IN FRONT OF, and the
        ; guard is why the report above was unconditional while this one is not.
        ; `hasBindableName` is `!HasDynamicName(node) || hasLateBindableName(node)`:
        ; a function declaration's name is an Identifier or absent, so the left
        ; disjunct is true on every one of them — but a METHOD reaches this function
        ; too, and `[expr]() {}` with a non-literal expr is the shape that needs
        ; isLateBindableName, i.e. checkComputedPropertyName. That is the same stop
        ; check_grammar_for_invalid_dynamic_name reaches, and it is asked here in the
        ; reference's own order.
        if this.has_bindable_name(node)
        {
            let symbol this.symbol_of_declaration(node)
            if symbol <> null
            {
                let sym symbol as ref[Symbol]
                ; ★★ THE TWO CALLS ARE TWO SYMBOLS AND THE REFERENCE'S COMMENT SAYS
                ; WHY: the LOCAL symbol carries the declarations as written, and the
                ; EXPORT symbol is what makes the modifiers of all exported
                ; declarations agree. `localSymbol` is the node's own when it has one
                ; and the declaration symbol otherwise.
                var local_symbol AstNode.local_symbol_of(node)
                if local_symbol = null
                    set local_symbol: sym
                ; ★ The JavaScript guard is the reference's, with its own reason: a JS
                ; file does no semantic analysis, so redeclaring a function there is
                ; not a duplicate. 151 of this corpus's units are JS or JSX, so the
                ; guard is live rather than decorative.
                if (AstNode.flags_of(node) & NodeFlagsJavaScriptFile) = 0
                    this.check_function_or_constructor_symbol(local_symbol as ref[Symbol])
                if Symbol.has_parent(sym)
                    this.check_function_or_constructor_symbol(sym)
            }
        }
        ; ★★★ AND THIS IS WHERE THIS PORT FIRST WALKS INTO A FUNCTION BODY. There is
        ; no unported step between the symbol check and `checkSourceElement(body)` —
        ; the arm the body needs (Block) has been in this file since slice 50 — so
        ; stopping here would mean inventing a report that names a function this port
        ; HAS, which is the one thing the unported column may never say. It is
        ; measured rather than assumed: 15 of the 42 function units of stage 1 move
        ; past this line into the expression and variable-type rows, and it adds ONE
        ; diagnostic over the corpus, still a subsequence.
        ;
        ; ★★★ IT ALSO RETIRES A PREMISE FOUR EARLIER SLICES ARGUED FROM. Slice 63's
        ; g15/g19/g16/g17 bounded that slice's whole unreachability to the single fact
        ; that *nothing in this port walks into a function body*; from here on that
        ; sentence is false, and the rows it justified are reachable. See §3.5dn.
        ;
        ; ★ The walk is UNCONDITIONAL — a report does not stop it — for the reason
        ; check_source_elements gives at its own loop: diagcheck compares the C
        ; section of every unit whether or not the dump is suppressed, so the
        ; statements after the first report are exactly where an invented diagnostic
        ; would hide.
        this.check_source_element(AstNode.body_of(node))
        ; ★★★ THE ARGUMENT IS EVALUATED FIRST AND IT IS THE HALF THAT CAN STOP.
        ; `getReturnTypeFromAnnotation(node)` reaches getTypeFromTypeNode for a
        ; function that HAS a return annotation, so `f(): Foo` stops in the type-node
        ; table exactly as its own checkSourceElement walk already did — the row
        ; gains events and no unit. A function with NO annotation cannot stop here at
        ; all, and that is the population this slice releases.
        ; ★★★ THE MARK IS TAKEN HERE AND NOT AT THE TOP OF THE PROCEDURE, and the
        ; first draft of this slice took it at the top and MEASURED ZERO. Everything
        ; above can stop — the signature walk, the computed name, the body — so a
        ; procedure-wide mark reads *somebody stopped* as *the annotation stopped* and
        ; skips the chapter for every function whose body contains an unported
        ; expression, which is most of them. **A mark is a claim about ONE call, and
        ; it has to be taken beside that call.**
        let ret_mark this.unported_mark()
        let return_type this.get_return_type_from_annotation(node)
        if this.unported_mark() = ret_mark
            this.check_all_code_paths_in_non_void_function_return_or_throw(node, return_type)
        this.report_wrong_full_signature_arity(node)
        ; ★★★ TS7010 IS A LIVE REPORT AND ITS ARM HAS BEEN PORTED SINCE SLICE 69 WITH
        ; NOTHING TO FEED IT. report_implicit_any's function-like label answers for
        ; seven kinds; its only call site until now was the PARAMETER of a signature,
        ; so the whole return-type half of that switch — 7010, 7011, 7012 — had a
        ; reader and no input. The guard is a MISSING BODY, i.e. an overload signature
        ; or an ambient declaration without a return type, which is the ordinary shape
        ; of a `.d.ts` and of every overload set. ★§3.5be read forwards, and it costs
        ; one call.
        ;
        ; ★★★ AND WHAT LICENSES THIS BLOCK IS THE CHAPTER, NOT THE COLLAPSE — A
        ; DISTINCTION THE BATTERY HAD TO MAKE (g14/g02). These two blocks are OUTSIDE
        ; the call and record_unported does not abort, so they would report even if
        ; the chapter above stopped on every input; what kept them out of this file
        ; until now is slice 49's prefix rule — *the ported prefix runs up to the
        ; first thing the slice does not implement and the report NAMES that thing* —
        ; and the stop that named it is the one this slice retires. **The collapse
        ; buys the ROW; the two blocks buy the DIAGNOSTIC; the same slice owes both,
        ; and only the second is visible to diagcheck.**
        if AstNode.type_of(node) = null
        {
            let body AstNode.body_of(node)
            if Binder.node_is_missing(body)
            {
                if this.is_private_within_ambient(node) = false
                    this.report_implicit_any(node, any_type, WideningKindNormal)
            }
            ; "A generator with a body and no type annotation can still cause errors"
            ; — getReturnTypeOfSignature(getSignatureFromDeclaration(node)), i.e. the
            ; signatures dimension, and the row this column already carries from the
            ; return statement and the set accessor.
            if (function_flags & FunctionFlagsGenerator) <> 0
            {
                if Binder.node_is_missing(body) = false
                {
                    ; The reference discards the answer; the CALL is the statement,
                    ; and what it is there for is the diagnostics on the way. Slice
                    ; 84 makes the first half of it real and the row moves to the
                    ; second — a generator with a body and no annotation is exactly
                    ; the shape getReturnTypeFromBody serves.
                    let gsig this.get_signature_from_declaration(node)
                    if gsig <> null
                        this.get_return_type_of_signature(gsig as ref[Signature])
                }
            }
        }
    }

    ; checkFunctionDeclaration, whole — and it is whole for the FIRST time here.
    ;
    ; ★★★ ITS TWO MISSING LINES WERE NAMED BY SLICE 52 AND HANDED TO *the slice which
    ; retires the report above*. That slice is this one, and both callees have been
    ; sitting in this file with a caller of their own ever since —
    ; checkGrammarForGenerator arrived in slice 52 for checkGrammarMethod,
    ; checkCollisionsForDeclarationName in slice 59 for the class, enum and module
    ; arms. So the two lines cost nothing but the call, which is what a named-and-
    ; not-written line is worth when its slice arrives. ★They run whether or not the
    ; chapter above stopped, which is slice 77's split rather than a new rule:
    ; record_unported marks and does not abort.
    procedure check_function_declaration(this, node: ref[AstNode])
    {
        this.check_function_or_method_declaration(node)
        this.check_grammar_for_generator(node)
        this.check_collisions_for_declaration_name(node, AstNode.name_of(node))
    }

    ; ── slice 82: the non-void return path ───────────────────────────────────
    ;
    ; checkAllCodePathsInNonVoidFunctionReturnOrThrow, getReturnTypeFromAnnotation
    ; and unwrapReturnType — the three functions the work list's LARGEST row has
    ; stood in front of since slice 63.
    ;
    ; ★★★ SLICE 77 MEASURED THIS ROW AS CFG-BLOCKED AND THAT IS TRUE OF HALF OF IT.
    ; Its sentence — *the return-annotation chapter is CFG-blocked and not
    ; type-node-blocked, which the row's name suggests and is not true* — was read
    ; off `functionHasImplicitReturn`, which is `EndFlowNode` + `isReachableFlowNode`.
    ; ★That half is ANSWERED since slice 93 and the row is closed; what follows is
    ; the reasoning that was already true of the other half. What it did not ask is what that
    ; answer is FOR: every one of the switch's first three cases is guarded by
    ; `t != nil`, and the fourth by `NoImplicitReturns == TSTrue`. **So for a
    ; function with NO return annotation the CFG question is asked for a value that
    ; cannot change the answer, and the whole call is observably a no-op.** ★A reason
    ; written at a stop is a claim about what is behind it and it goes stale in the
    ; direction that keeps the stop (slice 80) — this one was a claim about the
    ; ANNOTATED case wearing the name of the whole row.
    ;
    ; ★★★ AND THE SLICE'S DIAGNOSTIC IS BOUGHT BY THE TWO BLOCKS BEHIND THE CALL,
    ; NOT BY THE COLLAPSE — which is a distinction the battery had to make and the
    ; first draft of this header got wrong. The second block is `reportImplicitAny(
    ; node, anyType, WideningKindNormal)` for a declaration with no return type and
    ; no body, and that function's function-like label has been ported since slice 69
    ; with no input at all — its one caller was a signature's PARAMETER — so TS7010,
    ; TS7011 and TS7012 were a reader without a writer (§3.5be read forwards). The
    ; blocks sit OUTSIDE the call and record_unported does not abort, so they would
    ; report even with the chapter fully stopped; what kept them out of this file is
    ; slice 49's prefix rule, and the stop it named is what this slice retires.
    ; **One slice owes both halves — the row and the report — and each is visible to
    ; a different instrument.**
    ;
    ; ★★ THE ROW SPLITS RATHER THAN CLOSING, and the two halves are told apart by one
    ; syntactic bit. `f(): number { }` computes its type, fails the void/any/undefined
    ; early return and stops at `flow-graph` — the row slice 77 named for the two
    ; chapters that share it — while `f() { }`, `f(): void { }` and every
    ; MethodSignature walk out of the chapter. **The unannotated function is the
    ; common case and it is the one the flow graph never had anything to say about.**

    ; The THIRD reading of an unset option, next to the two strict_null_checks'
    ; header records: `c.compilerOptions.NoImplicitReturns == core.TSTrue` is a plain
    ; equality and NOT a GetStrictOptionValue read, so an unset option answers FALSE
    ; here where the four strict-family ones answer TRUE. That single fact is what
    ; makes the collapse above sound rather than convenient, and it is asserted
    ; rather than assumed: the caller STOPS if this ever answers true.
    function no_implicit_returns() returns bool
        checker_no_implicit_returns

    ; maybeTypeOfKind, WHOLE since slice 94.
    ;
    ; ★★★ THIS IS THE ONE PLACE WHERE THE UNION CHAPTER BROKE A CONTAINMENT PROOF
    ; WRITTEN IN A DIFFERENT CHAPTER, AND ONLY STAGE 2 CAUGHT IT. The note that
    ; stood here said the recursion *"CANNOT BE ENTERED AND IS LEFT OUT RATHER THAN
    ; STOPPED ... the only flags [the four factories] ever set are the eleven
    ; intrinsic ones, Object, TypeParameter and the four literal ones;
    ; `TypeFlagsUnionOrIntersection` is not among them"*. Every word of that was
    ; true when it was written, and slice 94 adds a fifth factory. What it cost:
    ; `function f(): number | void {}` — checkAllCodePathsInNonVoidFunctionReturn
    ; OrThrow's guard is `maybeTypeOfKind(t, Void)`, so with the recursion missing
    ; the union answered NO and the function INVENTED a TS2355 the reference does
    ; not have. **Three units of 18 249, none of the 1 479 at stage 1** — slice 64's
    ; *iterate at stage 1 and confirm at stage 2 once* earning its rule again, and
    ; the reduction is `union_maybe_void.ts`, so stage 1 covers it from here.
    ;
    ; ★★★ THE LESSON IS NOT ABOUT UNIONS. A containment proof is a claim about what
    ; the port can BUILD, and it is invalidated by a slice that builds something new
    ; — in a file the new slice never opens. **A left-out arm and a stopped arm are
    ; the same code until the day the input arrives, and then one of them reports
    ; and the other one answers.** The `record_unported`-in-an-unenterable-branch
    ; argument the old note made is still right; what it needed beside it was a
    ; GREP for its own premise, which is what this slice ran (five sites, four of
    ; them gates with reports and this one).
    ;
    ; ★★★ AND THE SENTENCE THAT FOLLOWED WAS THE SAME DEFECT ONE LEVEL DOWN —
    ; SLICE 155. It read *"The Intersection half of the recursion still has no
    ; input — nothing mints an intersection type"*, which stopped being true at
    ; slice 121 and was CORRECTED AT ANOTHER SITE in slice 131 (get_widened_type's
    ; own note says so in as many words) without anyone grepping for the rest of
    ; it. Under the false premise the arm was written but reads `union_types_of`,
    ; which answers null for an Intersection — so the walk this note claims is
    ; "written with the union half" has never once run on one, and the function
    ; answered FALSE for every intersection. It is the arm ABOVE that made this the
    ; expensive kind: the seven other sites carrying the same premise all stop, and
    ; a stop is a row on the frontier; this one ANSWERS.
    ;
    ; ★★ AND THE GREP THAT SHOULD HAVE FOUND IT DID NOT, for a reason worth
    ; keeping: the premise is split across two comment LINES (*"nothing mints an"*
    ; / *"intersection type"*), and every scan in this apparatus is line-oriented.
    function maybe_type_of_kind(t: ref[Type], kind: int) returns bool
    {
        if (t.flags & kind) <> 0
            return true
        if (t.flags & TypeFlagsUnionOrIntersection) <> 0
        {
            let ts Checker.union_or_intersection_types_of(t)
            if ts = null
                return false
            let list ts as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let e list[i]
                set i: i + 1
                if e = null
                    continue
                if Checker.maybe_type_of_kind(e as ref[Type], kind)
                    return true
            }
        }
        false
    }

    ; unwrapReturnType. The reference takes no node; `fn` is carried here for the
    ; stop's DETAIL column and is read for nothing else.
    ;
    ; ★★ ITS TWO STOPS ARE TWO DIMENSIONS AND NEITHER OF THEM IS THE FLOW GRAPH. A
    ; generator's return type is unwrapped through getIterationTypeOfGeneratorFunction
    ; ReturnType and an async one through getAwaitedTypeNoAlias, so
    ; `async function f(): Promise<void>` cannot reach the void early return its plain
    ; sibling takes — those units belong to the iteration/awaited dimension and not to
    ; this chapter. ★The generator test is asked FIRST because an async generator is
    ; both, and the reference resolves the overlap that way.
    ;
    ; ★★★ UPSTREAM THIS FUNCTION IS TOTAL, AND THAT IS WHAT LICENSES THE CALLER'S
    ; `t == nil` TEST. The generator arm answers errorType when the iteration type is
    ; nil, the async arm ORs errorType in, and the tail is the argument itself — so
    ; there, `t == nil` holds exactly when `returnType == nil`. Here a stop adds a
    ; SECOND way to answer nil, which is why the caller compares the mark before it
    ; reads the answer: without that, a stopped async function would take the
    ; unannotated collapse and the row would name the wrong chapter.
    procedure unwrap_return_type(this, return_type: ref[Type], function_flags: int, fn: ref[AstNode]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let is_async (function_flags & FunctionFlagsAsync) <> 0
        if (function_flags & FunctionFlagsGenerator) <> 0
        {
            let rit this.get_iteration_type_of_generator_function_return_type(IterationTypeKindReturn, return_type, is_async)
            if this.unported_mark() <> mark
                return null
            if rit = null
                return error_type
            if is_async = false
                return rit
            let unwrapped this.unwrap_awaited_type(rit as ref[Type])
            if this.unported_mark() <> mark
                return null
            if unwrapped = null
                return null
            return this.get_awaited_type_no_alias(unwrapped as ref[Type])
        }
        if is_async
        {
            let awaited this.get_awaited_type_no_alias(return_type)
            if this.unported_mark() <> mark
                return null
            if awaited <> null
                return awaited
            return error_type
        }
        return_type
    }

    ; ── slice 112: the inferred return type ──────────────────────────────────
    ;
    ; getReturnTypeFromBody, checkAndAggregateReturnExpressionTypes and the
    ; widening chain the answer goes through. It is the frontier's first row by
    ; either aggregation — 184+144+113+46 arrivals over 227 units, at
    ; FunctionDeclaration, ArrowFunction, FunctionExpression and MethodDeclaration
    ; — and it is the reason a body with no return annotation has never had a type
    ; in this port: `getReturnTypeOfSignature`'s default arm ends here.
    ;
    ; ★★★ THE ASYNC AND GENERATOR HALVES ARE TWO OTHER DIMENSIONS AND EVERY ONE OF
    ; THEIR ARMS IS A STOP. An async function's body type goes through
    ; checkAwaitedType/unwrapAwaitedType and its answer is wrapped by
    ; createPromiseType, which needs the global `Promise` — i.e. the lib (§3.11); a
    ; generator's needs checkAndAggregateYieldOperandTypes, getIntersectionType and
    ; createGeneratorType. Neither is a piece of THIS chapter that was left out:
    ; they are the awaited and the iteration dimensions, which unwrap_return_type's
    ; own header already separates from this one.
    ;
    ; ★★★ THE LITERAL WIDENING IS DECIDED BY `isUnitType` AND THAT IS WHY A UNION
    ; OF TWO RETURNS IS NOT WIDENED. `function f() { return 1 }` answers `number`
    ; and `function f() { return 1; return "s" }` answers `"s" | 1` — the second is
    ; not a unit type, so the contextual-widening block is skipped whole and the
    ; literals survive. That is the reference's own shape and it reads like a
    ; defect until the two are put side by side, which is what the fixture does.

    ; someType at the ONE predicate the empty-return arm calls it with (§3.9e's
    ; rule, and some_type_accepts_void is the sibling this follows).
    function some_type_is_undefined(t: ref[Type]) returns bool
    {
        if (t.flags & TypeFlagsUnion) = 0
            return (t.flags & TypeFlagsUndefined) <> 0
        let types Checker.union_types_of(t)
        if types = null
            return false
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let c list[i]
            if c <> null
            {
                if ((c as ref[Type]).flags & TypeFlagsUndefined) <> 0
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; isUnitType. ★TypeFlagsUnit carries Undefined and Null, so `return null` and
    ; `return undefined` take the contextual-widening block too — and come out
    ; unchanged, because getWidenedLiteralType has no arm for either.
    function is_unit_type(t: ref[Type]) returns bool
        (t.flags & TypeFlagsUnit) <> 0

    ; getWidenedUniqueESSymbolType. ★TypeFlagsUniqueESSymbol is set only by
    ; getESSymbolLikeTypeForNode, which no ported arm calls (report_implicit_any's
    ; header records the same zero), so the first arm has no input at all — and the
    ; UNION arm has plenty, because `return true` widens to `boolean` and boolean
    ; IS a union here.
    ;
    ; ★★ mapType IS WRITTEN INTO THE FUNCTION AND NOT BESIDE IT, which is §3.9e's
    ; rule at the shape that makes it easiest: the reference's `f` is this function,
    ; so the callback and its walk are one recursion. ★The `origin` block is
    ; skipped — nothing writes UnionTypeData.origin (its own header) — and the
    ; `changed` flag is the reference's own: an unchanged map answers the ORIGINAL
    ; union rather than an equal one.
    procedure get_widened_unique_es_symbol_type(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUniqueESSymbol) <> 0
            return es_symbol_type
        if (t.flags & TypeFlagsUnion) = 0
            return t
        let types Checker.union_types_of(t)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let mapped &Array[ref[Type]?]()
        var changed false
        var i 0
        while i < n
        {
            let c list[i]
            if c = null
                return null
            let m this.get_widened_unique_es_symbol_type(c as ref[Type])
            if m = null
                return null
            if m <> c
                set changed: true
            mapped.add(m)
            set i: i + 1
        }
        if changed = false
            return t
        this.get_union_type_ex(mapped, UnionReductionLiteral, null, null)
    }


    ; getWidenedLiteralLikeTypeForContextualReturnTypeIfNeeded. ★The async arm is
    ; GetPromisedTypeOfPromise — the same expired premise the property-suggestion
    ; site carried: the note called it *the lib's `Promise` again* and the function
    ; that reads it is whole in this file.
    ;
    ; ★ A nil promised type is the reference's own answer for a return annotation
    ; that is not a promise, and it is the SAME value the no-contextual-type arm
    ; uses, so it needs no arm of its own.
    procedure get_widened_literal_like_type_for_contextual_return_type_if_needed(this, t: ref[Type]?, contextual_signature_return_type: ref[Type]?, is_async: bool) returns ref[Type]?
    {
        if t = null
            return null
        let ty t as ref[Type]
        if Checker.is_unit_type(ty) = false
            return ty
        let mark this.unported_mark()
        var contextual_type: ref[Type]? null
        if contextual_signature_return_type <> null
        {
            if is_async
            {
                set contextual_type: this.get_promised_type_of_promise_ex(contextual_signature_return_type as ref[Type], null, null)
                if this.unported_mark() <> mark
                    return null
            }
            else
                set contextual_type: contextual_signature_return_type
        }
        this.get_widened_literal_like_type_for_contextual_type(ty, contextual_type)
    }

    ; getContextualSignatureForFunctionLikeDeclaration, whole.
    procedure get_contextual_signature_for_function_like_declaration(this, node: ref[AstNode]) returns ref[Signature]?
    {
        var contextual false
        if Checker.is_function_expression_or_arrow_function(node)
            set contextual: true
        if Checker.is_object_literal_method(node)
            set contextual: true
        if contextual = false
            return null
        this.get_contextual_signature(node)
    }

    ; isResolvingReturnTypeOfSignature. ★★The first disjunct is written since slice
    ; 155: a COMPOSITE signature's return type is a fold of its members', so a
    ; member that is mid-resolution makes the composite mid-resolution too — and
    ; the composite itself never enters the resolution stack, so the second
    ; disjunct alone would answer false for it.
    procedure is_resolving_return_type_of_signature(this, signature: ref[Signature]) returns bool
    {
        if signature.composite <> null
        {
            let comp signature.composite as ref[CompositeSignature]
            if comp.signatures <> null
            {
                let inner comp.signatures as ref[Array[ref[Signature]?]]
                let n inner.get_length() as int
                var i 0
                while i < n
                {
                    let row inner[i]
                    set i: i + 1
                    if row = null
                        continue
                    if this.is_resolving_return_type_of_signature(row as ref[Signature])
                        return true
                }
            }
        }
        if signature.resolved_return_type <> null
            return false
        this.find_resolution_cycle_start_index(null, null, signature, null, TypeSystemPropertyNameResolvedReturnType) >= 0
    }

    ; getContextualReturnType. ★Its two filterType arms are the generator and async
    ; dimensions again — the predicates ask getIterationTypeOfGeneratorFunction
    ; ReturnType and getAwaitedTypeOfPromise — so they are one stop each, at the
    ; flag that selects them.
    procedure get_contextual_return_type(this, function_decl: ref[AstNode], context_flags: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let annotated this.get_return_type_from_annotation(function_decl)
        if this.unported_mark() <> mark
            return null
        if annotated <> null
            return annotated
        let signature this.get_contextual_signature_for_function_like_declaration(function_decl)
        if this.unported_mark() <> mark
            return null
        if signature <> null
        {
            if this.is_resolving_return_type_of_signature(signature as ref[Signature]) = false
            {
                let rt this.get_return_type_of_signature(signature as ref[Signature])
                if this.unported_mark() <> mark
                    return null
                let flags b.get_function_flags(function_decl)
                if (flags & FunctionFlagsGenerator) <> 0
                    return this.filter_type_by_contextual_generator_return(rt as ref[Type], flags)
                if (flags & FunctionFlagsAsync) <> 0
                    return this.filter_type_by_contextual_async_return(rt as ref[Type])
                return rt
            }
        }
        let iife AstNode.get_immediately_invoked_function_expression(function_decl)
        if iife <> null
            return this.get_contextual_type(iife as ref[AstNode], context_flags)
        null
    }

    ; reportErrorsFromWidening, WHOLE — and it retires the stop
    ; widen_type_for_variable_like_declaration has carried since slice 69.
    ;
    ; ★★ ITS GUARD IS ObjectFlagsContainsWideningType AND THAT BIT STILL HAS ONE
    ; PRODUCER: create_widening_type answers the NON-widening type under
    ; strictNullChecks, so `null` and `undefined` in expression position do not
    ; carry it — what does is the undefinedWideningType intrinsic itself, which
    ; reaches a caller here only through an omitted element or an implicit any.
    procedure report_errors_from_widening(this, declaration: ref[AstNode], t: ref[Type], widening_kind: int)
    {
        if Checker.no_implicit_any() = false
            return
        if (t.object_flags & ObjectFlagsContainsWideningType) = 0
            return
        var report false
        if widening_kind = WideningKindNormal
            set report: true
        else
        {
            if AstNode.is_function_like_declaration(declaration)
            {
                let mark2 this.unported_mark()
                let should this.should_report_errors_from_widening_with_contextual_signature(declaration, widening_kind)
                if this.unported_mark() <> mark2
                    return
                if should
                    set report: true
            }
        }
        if report = false
            return
        if this.report_widening_errors_in_type(t)
            return
        this.report_implicit_any(declaration, t, widening_kind)
    }

    ; reportWideningErrorsInType (slice 254: the tuple and object-literal arms, which
    ; the emit programs reach once strictNullChecks is the case's option). ★ Go's
    ; `errorReported = errorReported || f(s)` stops calling after the first report;
    ; the object-literal arm OVERWRITES per property, as the reference does.
    procedure report_widening_errors_in_type(this, t: ref[Type]) returns bool
    {
        var error_reported false
        if (t.object_flags & ObjectFlagsContainsWideningType) = 0
            return false
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types = null
                return false
            let list types as ref[Array[ref[Type]?]]
            let n list.get_length() as int
            var i 0
