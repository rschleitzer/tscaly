                        this.error_on_node(getter as ref[AstNode], DiagX_0_implicitly_has_return_type_any_because_it_does_not_have_a_return_type_annotation_and_is_referenced_directly_or_indirectly_in_one_of_its_return_expressions, this.symbol_arg(symbol))
                }
            }
            set t: any_type
        }
        if links.resolved_type = null
            set links.resolved_type: t
        links.resolved_type
