    function conditional_root_of(t: ref[Type]) returns ref[ConditionalRoot]?
    {
        choose t.data
            when d: Conditional
                return d.root
        null
    }

    function conditional_check_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Conditional
                return d.check_type
