    ; getResolvedSymbolOrNil — the slot WITHOUT the resolution, which is what makes
    ; it a different function: it answers null for a node nothing has resolved yet.
    ; Its reader is the member access chapter (`parentSymbol`), which is why it
    ; lands with the table rather than with its caller.
    procedure get_resolved_symbol_or_nil(this, node: ref[AstNode]) returns ref[Symbol]?
        this.symbol_node_link_of(node).resolved_symbol

    ; c.signatureLinks.Get(declaration) — the same mint-on-miss reader a fifth
    ; time (slice 84).
    procedure signature_link_of(this, node: ref[AstNode]) returns ref[SignatureLink]
    {
        let ord this.node_local_of(node)
        while (signature_links.get_length() as int) <= ord
            signature_links.add(null)
        let row signature_links[ord as size_t]
        if row <> null
            return row as ref[SignatureLink]
        let made &SignatureLink^host()
        signature_links.put(ord as size_t, made)
        made
    }

    ; ── getTypeOfSymbol ─────────────────────────────────────────────────────
    ;
    ; The dispatch, whole — and porting it is what SPLITS the work list's largest
    ; row into the questions the reference actually asks. Until this slice the
    ; three call sites all reported one tag, `get-type-of-symbol`, and §3.5dl had
    ; to build a throwaway instrument to say which arm each unit needed; the tag
    ; says it now.
    ;
    ; getTypeOfInstantiatedSymbol, slice 86. The memo is the reference's own and it
    ; is load-bearing rather than an optimisation: an instantiated property is
    ; asked for its type by every reader of the members table, and a second ask
    ; that answered a second type object would break every identity comparison
    ; downstream.
    procedure get_type_of_instantiated_symbol(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.resolved_type <> null
            return links.resolved_type
        if links.target = null
        {
            ; A symbol carrying CheckFlagsInstantiated always has one; the only
            ; writer sets both in the same three lines. A report, on this file's
            ; rule about assertions.
            this.record_unported("instantiated-symbol-no-target", Symbol.check_flags_of(symbol))
            return null
        }
        let mark this.unported_mark()
        let inner this.get_type_of_symbol(links.target as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        if inner = null
            return null
        let mapped this.instantiate_type(inner, links.mapper)
        if this.unported_mark() <> mark
            return null
        set links.resolved_type: mapped
        mapped
    }

    ; getWriteTypeOfInstantiatedSymbol — the WRITE twin of the function above, and
    ; it is written beside it rather than beside its caller because the two are one
    ; shape: the same links, the same mapper, `getWriteTypeOfSymbol` where the read
    ; side asks `getTypeOfSymbol`, and the memo in `write_type` instead of
    ; `resolved_type`.
    ;
    ; ★★★ THE SETTER'S WRITE TYPE IS WHAT SLICE 159 CLOSED, AND IT WAS TWO ROWS
    ; IN TWO FUNCTIONS WITH ONE PREMISE — §3.5eo. `instantiate_symbol` said *"The
    ; setter's second question is `links.writeType`, the slot ValueSymbolLink's
    ; header names with getWriteTypeOfSymbol as its reader. Neither exists"*, and
    ; slice 127 had already declared the slot (its own header says so, five lines
    ; from the note) while `get_write_type_of_symbol` had been in the file since
    ; before that. The only thing genuinely absent was these seven lines.
    procedure get_write_type_of_instantiated_symbol(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.write_type <> null
            return links.write_type
        if links.target = null
        {
            ; The same assertion the read twin reports: CheckFlagsInstantiated and
            ; `target` are written in one place, three lines apart.
            this.record_unported("instantiated-symbol-no-target", Symbol.check_flags_of(symbol))
            return null
        }
        let mark this.unported_mark()
        let inner this.get_write_type_of_symbol(links.target as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        if inner = null
            return null
        let mapped this.instantiate_type(inner, links.mapper)
        if this.unported_mark() <> mark
            return null
        set links.write_type: mapped
        mapped
    }

    ; ★★★ ONE OF THE FOUR CheckFlags ARMS IS WRITTEN SINCE SLICE 86 AND THE OTHER
    ; THREE ARE STILL LEFT OUT, which is the note that used to stand here with its
    ; premise corrected rather than deleted. It said all four were *"not merely
    ; unreached, UNREPRESENTABLE — this port has no CheckFlags at all, because
    ; nothing in it creates a TRANSIENT symbol"*; instantiate_symbol creates one,
    ; so Instantiated is representable and is dispatched. DeferredType, Mapped and
    ; ReverseMapped still have no writer and are still left out rather than
    ; reported: a report is a promise that an input can reach the line.
    procedure get_type_of_symbol(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        ; ★★★ THE DEFERRED ARM, AND ITS FUNCTION HAS BEEN IN THIS FILE SINCE SLICE
        ; 127 — what was missing was the DISPATCH. `get_type_of_symbol_with_
        ; deferred_type` was written with the three `deferred_*` link slots and
        ; reached only from get_write_type_of_symbol's own deferred arm, so a
        ; synthesized union or intersection property — which carries
        ; SymbolFlagsProperty and no declaration — fell through the flag chain
        ; below to the worker's `debug.Assert(symbol.ValueDeclaration != nil)`.
        ; It stands FIRST because that is where the reference's chain has it and
        ; because every later test would claim the symbol.
        if (Symbol.check_flags_of(symbol) & CheckFlagsDeferredType) <> 0
            return this.get_type_of_symbol_with_deferred_type(symbol)
        if (Symbol.check_flags_of(symbol) & CheckFlagsInstantiated) <> 0
            return this.get_type_of_instantiated_symbol(symbol)
        ; ★ The MAPPED arm, slice 125 — it stands where the reference's chain puts
        ; it, before every symbol-FLAG test, because a synthesized mapped property
        ; carries SymbolFlagsProperty as well and the flag chain below would take
        ; it to the declaration it does not have.
        if (Symbol.check_flags_of(symbol) & CheckFlagsMapped) <> 0
            return this.get_type_of_mapped_symbol(symbol)
        ; ★ The REVERSE-MAPPED arm, slice 160 — beside the mapped one and for the
        ; same reason: a synthesized reverse-mapped property carries
        ; SymbolFlagsProperty and has no declaration of its own.
        if (Symbol.check_flags_of(symbol) & CheckFlagsReverseMapped) <> 0
            return this.get_type_of_reverse_mapped_symbol(symbol)
        let f Symbol.flags_of(symbol)
        if (f & SymbolFlagsAccessor) <> 0
            return this.get_type_of_accessors(symbol)
        if (f & (SymbolFlagsVariable | SymbolFlagsProperty)) <> 0
            return this.get_type_of_variable_or_parameter_or_property(symbol)
        if (f & (SymbolFlagsFunction | SymbolFlagsMethod | SymbolFlagsClass | SymbolFlagsEnum | SymbolFlagsValueModule)) <> 0
            return this.get_type_of_func_class_enum_module(symbol)
        if (f & SymbolFlagsEnumMember) <> 0
            return this.get_type_of_enum_member(symbol)
        if (f & SymbolFlagsAlias) <> 0
            return this.get_type_of_alias(symbol)
        ; The reference falls out of the chain answering errorType, which is an
        ; ANSWER rather than a hole — so it does not report, exactly as
        ; try_get_declared_type_of_symbol's tail does not.
        error_type
    }

    ; ── slice 114: the alias's type ─────────────────────────────────────────
    ;
    ; getTypeOfAlias, whole. Every helper it needs was already here — resolveAlias,
    ; getDeclarationOfAliasSymbol, getTargetOfAliasDeclaration, getSymbolFlags and
    ; the resolution stack — which is why the chapter this stop named is not the
    ; work: what the stop was hiding is the WALL BEHIND it, and that wall is one
    ; line of initializeChecker (see its own note).
    ;
    ; ★★★ THE `exportSymbol` COMPUTATION IS DEAD EXCEPT ON THE CIRCULAR PATH and it
    ; is still evaluated EAGERLY, because getTargetOfAliasDeclaration REPORTS: it is
    ; the TS2307 for an unresolvable specifier, and moving it inside the popped
    ; branch would drop that report on every non-circular alias. The reference's
    ; statement order is the diagnostic order here, not a style.
    procedure get_type_of_alias(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.resolved_type <> null
            return links.resolved_type
        if this.push_type_resolution(symbol, null, null, null, TypeSystemPropertyNameType) = false
            return error_type
        let mark this.unported_mark()
        let target_symbol this.resolve_alias(symbol)
        var export_symbol: ref[Symbol]? null
        let decl this.get_declaration_of_alias_symbol(symbol)
        if decl <> null
            set export_symbol: this.get_target_of_alias_declaration(decl as ref[AstNode])
        if this.unported_mark() <> mark
        {
            this.pop_type_resolution_defensively()
            return null
        }
        if target_symbol = null
        {
            this.pop_type_resolution_defensively()
            return null
        }
        if links.resolved_type = null
        {
            let ts target_symbol as ref[Symbol]
            if (this.get_symbol_flags(ts) & SymbolFlagsValue) <> 0
            {
                let t this.get_type_of_symbol(ts)
                if this.unported_mark() <> mark
                {
                    this.pop_type_resolution_defensively()
                    return null
                }
                set links.resolved_type: t
            }
            else
                set links.resolved_type: error_type
        }
        if this.pop_type_resolution() = false
        {
            var reported symbol
            if export_symbol <> null
                set reported: export_symbol as ref[Symbol]
            let ignored this.report_circularity_error(reported)
            if links.resolved_type = null
                set links.resolved_type: error_type
            return links.resolved_type
        }
        links.resolved_type
    }

    ; getTypeOfFuncClassEnumModule. The memo is the whole function, and its hit is
    ; OBSERVABLE here (see value_symbol_links' note) — which is what makes this
    ; the first links table in this port that earns its keep.
    ; ── slice 112: getTypeOfAccessors ────────────────────────────────────────
    ;
    ; The accessor's own type, which get_type_of_symbol has reported at since
    ; slice 67. Its THIRD resolution step is getReturnTypeFromBody — a getter with
    ; a body and no return annotation is the same shape a function declaration is
    ; — which is why it lands with that chapter and not before it.
    ;
    ; ★★★ THE FIVE MESSAGE ARGUMENTS COST NOTHING, and that is a property of this
    ; port rather than of the slice: a diagnostic here is a CODE and a RANGE
    ; (check_no_type_arguments' header states the rule), so the symbolToString
    ; calls the reference threads through all five reports are not asked. The two
    ; errorOrSuggestion calls are ERRORS because noImplicitAny is TRUE under this
    ; harness.
    procedure get_type_of_accessors(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let links this.value_symbol_link_of(symbol)
        if links.resolved_type <> null
            return links.resolved_type
        if this.push_type_resolution(symbol, null, null, null, TypeSystemPropertyNameType) = false
            return error_type
        let mark this.unported_mark()
        let getter Checker.get_declaration_of_kind(symbol, KindGetAccessor)
        let setter Checker.get_declaration_of_kind(symbol, KindSetAccessor)
        let accessor this.find_auto_accessor_declaration(symbol)
        ; "We try to resolve a getter type annotation, a setter type annotation, or
        ; a getter function body return type inference, in that order."
        var t this.get_annotated_accessor_type(getter)
        if this.unported_mark() <> mark
        {
            this.pop_type_resolution_defensively()
            return null
        }
        if t = null
        {
            set t: this.get_annotated_accessor_type(setter)
            if this.unported_mark() <> mark
            {
                this.pop_type_resolution_defensively()
                return null
            }
        }
        if t = null
        {
            set t: this.get_annotated_accessor_type(accessor)
            if this.unported_mark() <> mark
            {
                this.pop_type_resolution_defensively()
                return null
            }
        }
        if t = null
        {
            if getter <> null
            {
                if AstNode.body_of(getter as ref[AstNode]) <> null
                {
                    set t: this.get_return_type_from_body(getter as ref[AstNode], CheckModeNormal)
                    if this.unported_mark() <> mark
                    {
                        this.pop_type_resolution_defensively()
                        return null
                    }
                }
            }
        }
        if t = null
        {
            if accessor <> null
