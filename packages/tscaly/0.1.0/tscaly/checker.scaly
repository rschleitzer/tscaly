        ; ★★★ THE `else if` CHAIN IS NOT A CHAIN OF `if`s AND THE SETTER ARM PROVES
        ; IT: a symbol with BOTH a getter and a setter, neither annotated, reports
        ; TS7032 and NOT TS7033. `reported` is what carries the reference's
        ; else-if here, because a `switch` with no subject is an ORDERED chain
        ; (§3.5u) and this one has side effects in every arm.
        if this.pop_type_resolution() = false
        {
            var circ: ref[AstNode]? null
            if this.get_annotated_accessor_type_node(getter) <> null
                set circ: getter
            if circ = null
            {
                if this.get_annotated_accessor_type_node(setter) <> null
                    set circ: setter
            }
            if circ = null
            {
                ; The reference reports on the SETTER in the accessor arm too, and
                ; that is transcribed rather than corrected — see §3.5v.
                if this.get_annotated_accessor_type_node(accessor) <> null
                    set circ: setter
