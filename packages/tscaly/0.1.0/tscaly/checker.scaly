    function conditional_false_type_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Conditional
                return d.resolved_false_type
        null
    }

    ; d.combinedMapper — the inference context's mapper merged with the caller's,
    ; which a conditional carries only when its extends clause has an `infer`.
    function conditional_combined_mapper_of(t: ref[Type]) returns ref[TypeMapper]?
    {
        choose t.data
            when d: Conditional
                return d.combined_mapper
        null
    }

    function conditional_mapper_of(t: ref[Type]) returns ref[TypeMapper]?
    {
        choose t.data
            when d: Conditional
                return d.mapper
        null
    }

    ; The two branch memos, written through this file's copy/mutate/write-back
    ; idiom — a `when` binding is a COPY, so the arm goes back whole.
    procedure set_conditional_true_type(t: ref[Type], v: ref[Type]?)
    {
        choose t.data
            when c: Conditional
            {
                var d c
                set d.resolved_true_type: v
                set t.data: TypeData.Conditional(d)
            }
    }

    ; The three constraint memos of slice 136, in the shape the two above use.
    function conditional_default_constraint_of(t: ref[Type]) returns ref[Type]?
    {
        choose t.data
            when d: Conditional
                return d.resolved_default_constraint
        null
    }

