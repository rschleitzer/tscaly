        let np type_parameters.get_length() as int
        var given AstNode.list_count(type_argument_nodes)
        if given > np
            set given: np
        let result this.new_type_list(null)
        var i 0
        while i < given
        {
            let n AstNode.child_in_list(type_argument_nodes, i)
            set i: i + 1
            if n = null
                return null
            let t this.get_type_from_type_node(n as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if t = null
                return null
            result.add(t)
        }
        while (result.get_length() as int) < np
        {
            let row type_parameters[result.get_length() as int]
            if row = null
                return null
            let tp row as ref[Type]
            var t this.get_default_from_type_parameter(tp)
