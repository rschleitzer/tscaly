    function indexed_access_flags_of(t: ref[Type]) returns int
    {
        choose t.data
            when d: IndexedAccess
                return d.access_flags
        0
    }

    function template_literal_types_of(t: ref[Type]) returns ref[Array[ref[Type]?]]?
    {
        choose t.data
            when d: TemplateLiteral
                return d.types
        null
