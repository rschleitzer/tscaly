    ; r.iteratorSymbolName — `"iterator"` or `"asyncIterator"`, the well-known
    ; symbol whose property getIterationTypesOfIterableSlow looks up.
    function resolver_iterator_symbol_name(is_async: bool) returns Slice[char]
    {
