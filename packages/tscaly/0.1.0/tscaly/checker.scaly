            if first = null
                return null
            set single_non_generic: true
            if (first as ref[Signature]).type_parameters <> null
            {
                if ((first as ref[Signature]).type_parameters as ref[Array[ref[Type]?]]).get_length() <> 0
                    set single_non_generic: false
            }
        }
        ; ★★★ THE TWO PASSES ARE NOT A RETRY. `argCheckMode` is SkipContextSensitive
        ; whenever any argument is context-sensitive, and the first inference pass
        ; then runs WITHOUT those arguments — so a context-sensitive arrow does not
        ; have to be checked before the type parameter it depends on is inferred.
        ; Only if that pass succeeds are the skipped arguments included and the
        ; inference redone. Collapsing the two makes `foo(x => x.length)` circular.
        ; ★The reference excludes a DECORATOR from the argCheckMode question as
        ; well, and slice 134 made that reachable: a decorator's arguments are
        ; SYNTHETIC expressions, none of which is context-sensitive, so the test
        ; answers false for one either way.
        var arg_check_mode CheckModeNormal
        if single_non_generic = false
        {
