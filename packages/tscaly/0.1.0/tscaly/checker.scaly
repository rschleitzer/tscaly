    ; getGlobalAwaitedSymbol / getGlobalAwaitedSymbolOrNil — the `Awaited<T>` type
    ; ALIAS symbol. ★Two names upstream, one lookup here: they differ only in the
    ; TS2318 §3.11 owes. ★The memo needs a SECOND field because the answer may
    ; legitimately be null (a lib without `Awaited`), so a null field cannot mean
    ; *not asked yet* — the shape get_global_array_type's header says the array
    ; memos deliberately avoid.
    procedure get_global_awaited_symbol(this) returns ref[Symbol]?
    {
        if global_awaited_symbol_asked
            return global_awaited_symbol
        let mark this.unported_mark()
        let s this.get_global_type_alias_symbol("Awaited", 1)
        if this.unported_mark() <> mark
            return null
        set global_awaited_symbol: s
        set global_awaited_symbol_asked: true
        s
    }

    ; getGlobalExtractSymbol, in get_global_awaited_symbol's shape.
    procedure get_global_extract_symbol(this) returns ref[Symbol]?
    {
        if global_extract_symbol_asked
            return global_extract_symbol
        let mark this.unported_mark()
        this.report_checked_global_type_alias("Extract", 2)
        let s this.get_global_type_alias_symbol("Extract", 2)
        if this.unported_mark() <> mark
            return null
        set global_extract_symbol: s
        set global_extract_symbol_asked: true
        s
    }

    ; getExtractStringType — `Extract<T, string>`, and `string` where the lib has
    ; no `Extract` alias. ★The fallback is the reference's own and not a stop: it
    ; is what the reference answers, not what it does when something is missing.
    procedure get_extract_string_type(this, t: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let alias this.get_global_extract_symbol()
        if this.unported_mark() <> mark
            return null
        if alias = null
            return string_type
        let args this.new_type_list_of(2)
        args.add(t)
        args.add(string_type)
        this.get_type_alias_instantiation(alias as ref[Symbol], args, null)
    }

