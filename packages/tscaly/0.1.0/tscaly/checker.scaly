        if location <> null
            set links: this.jsx_element_link_of(location as ref[AstNode])
        if links <> null
        {
            let l links as ref[JsxElementLink]
            if l.jsx_namespace <> null
            {
                if (l.jsx_namespace as ref[Symbol]) <> unknown_symbol
                    return l.jsx_namespace
            }
        }
        var asked_and_missed false
        if links <> null
        {
            let l links as ref[JsxElementLink]
            if l.jsx_namespace <> null
            {
                if (l.jsx_namespace as ref[Symbol]) = unknown_symbol
                    set asked_and_missed: true
            }
        }
        if asked_and_missed = false
        {
            let mark this.unported_mark()
            var resolved_namespace this.get_jsx_namespace_container_for_implicit_import(location)
            if this.unported_mark() <> mark
                return null
            if resolved_namespace <> null
            {
                if (resolved_namespace as ref[Symbol]) = unknown_symbol
                    set resolved_namespace: null
            }
            if resolved_namespace = null
            {
                var ns_data Slice[char]()
                if this.get_jsx_namespace(location, &ns_data) = false
                    return null
                set resolved_namespace: this.resolve_name(location, ns_data, SymbolFlagsNamespace, 0, false, false)
                if this.unported_mark() <> mark
                    return null
            }
            if resolved_namespace <> null
            {
                let outer this.resolve_symbol(resolved_namespace)
                if this.unported_mark() <> mark
                    return null
                if outer <> null
                {
                    let exports this.get_exports_of_symbol(outer as ref[Symbol])
                    if this.unported_mark() <> mark
                        return null
                    var stopped false
                    let found this.lookup_in_table(exports, "JSX", SymbolFlagsNamespace, &stopped, false)
                    if stopped
                        return null
                    let candidate this.resolve_symbol(found)
                    if this.unported_mark() <> mark
                        return null
                    if candidate <> null
                    {
                        if (candidate as ref[Symbol]) <> unknown_symbol
                        {
