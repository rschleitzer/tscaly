        ; c.undefinedSymbol and c.globalThisSymbol, minted in NewChecker in the same
        ; run as the two above. The globals table is made here too, because
        ; globalThis's exports slot IS it and the seeding line below writes the
        ; symbol into it — three statements the reference spells at three different
        ; points of NewChecker for no reason this port can reproduce.
        var undefined_data Slice[char]()
        set undefined_data: Binder.internal_name_unprefixed(host, "undefined")
        set c.undefined_symbol: Symbol.create(host, SymbolFlagsProperty | SymbolFlagsTransient, undefined_data)
        var global_this_data Slice[char]()
        set global_this_data: Binder.internal_name_unprefixed(host, "globalThis")
        let gts Symbol.create(host, SymbolFlagsModule | SymbolFlagsTransient, global_this_data)
        Symbol.set_check_flags(gts, CheckFlagsReadonly)
        set c.global_this_symbol: gts
        let g SymbolTable.create(host)
        set c.globals: g
        Symbol.set_exports(gts, g)
        SymbolTable.set_entry(host, g, global_this_data, gts)
