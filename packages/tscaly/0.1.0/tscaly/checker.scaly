                    if s_check = null
                        return false
                    if t_check = null
                        return false
                    var checks_related false
                    if this.is_related_to_ex(s_check as ref[Type], t_check as ref[Type], relation, null, IntersectionStateNone, RecursionFlagsBoth)
                        set checks_related: true
                    if checks_related = false
                    {
                        if this.is_related_to_ex(t_check as ref[Type], s_check as ref[Type], relation, null, IntersectionStateNone, RecursionFlagsBoth)
                            set checks_related: true
                    }
                    if this.unported_mark() <> mark
                        return false
                    if checks_related
                    {
                        let s_true this.get_true_type_from_conditional_type(src)
                        let t_true this.get_true_type_from_conditional_type(target)
                        if this.unported_mark() <> mark
                            return false
                        if s_true = null
                            return false
                        if t_true = null
                            return false
                        let s_true_inst this.instantiate_type(s_true as ref[Type], mapper)
                        if this.unported_mark() <> mark
                            return false
                        if s_true_inst = null
                            return false
                        var branches this.is_related_to_ex(s_true_inst as ref[Type], t_true as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
                        if this.unported_mark() <> mark
                            return false
                        if branches
                        {
                            let s_false this.get_false_type_from_conditional_type(src)
                            let t_false this.get_false_type_from_conditional_type(target)
                            if this.unported_mark() <> mark
                                return false
                            if s_false = null
                                return false
                            if t_false = null
                                return false
                            set branches: this.is_related_to_ex(s_false as ref[Type], t_false as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
                            if this.unported_mark() <> mark
                                return false
                        }
                        if branches
                            return true
                    }
                }
                if this.unported_mark() <> mark
                    return false
            }
            ; "Conditionals can be related to one another via normal constraint,
            ; as, eg, `A extends B ? O : never` should be assignable to `O` when
            ; `O` is a conditional."
            let default_constraint this.get_default_constraint_of_conditional_type(src)
            if this.unported_mark() <> mark
                return false
            if default_constraint <> null
            {
                if this.is_related_to_ex(default_constraint as ref[Type], target, relation, error_node, IntersectionStateNone, RecursionFlagsSource)
                    return true
                if this.unported_mark() <> mark
                    return false
            }
            ; "Conditionals aren't related to one another via DISTRIBUTIVE
            ; constraint as it is much too inaccurate and allows way more
            ; assignments than are desirable" — so the distributive route is open
            ; only when the target is not itself a conditional.
            if (target.flags & TypeFlagsConditional) = 0
            {
                if this.has_non_circular_base_constraint(src)
                {
                    if this.unported_mark() <> mark
                        return false
                    let distributive this.get_constraint_of_distributive_conditional_type(src)
                    if this.unported_mark() <> mark
                        return false
                    if distributive <> null
                    {
                        ; ★★★ `r.restoreErrorState(saveErrorState)` — the default
                        ; constraint has just failed and REPORTED, and this second
                        ; route must be judged on its own. Until slice 167 the note
                        ; here read *the restore upstream is the CHAIN's and this
                        ; port carries none*, which was true when it was written and
                        ; false one slice later.
                        set rel_error_chain: rel_structural_chain
                        if this.is_related_to_ex(distributive as ref[Type], target, relation, error_node, IntersectionStateNone, RecursionFlagsSource)
                            return true
                        if this.unported_mark() <> mark
                            return false
                    }
                }
            }
        }
        if (src.flags & TypeFlagsTemplateLiteral) <> 0
        {
            if (target.flags & TypeFlagsObject) = 0
            {
                set source_arm_taken: true
                ; A template literal source against a NON-template target goes
                ; through its base constraint — `` `a${string}` `` is a `string`.
                ; ★The `constraint <> src` test is the reference's and it is what
                ; keeps a template literal whose constraint is itself from
                ; recursing.
                if (target.flags & TypeFlagsTemplateLiteral) = 0
                {
                    let mark this.unported_mark()
                    let constraint this.get_base_constraint_of_type(src)
                    if this.unported_mark() <> mark
                        return false
                    if constraint <> null
                    {
                        if (constraint as ref[Type]) <> src
                        {
                            if this.is_related_to_ex(constraint as ref[Type], target, relation, error_node, IntersectionStateNone, RecursionFlagsSource)
                                return true
                            if this.unported_mark() <> mark
                                return false
                        }
                    }
                }
            }
        }
        if (src.flags & TypeFlagsStringMapping) <> 0
        {
            set source_arm_taken: true
            let mark this.unported_mark()
            if (target.flags & TypeFlagsStringMapping) <> 0
            {
                ; Two string mappings relate only through the SAME intrinsic —
                ; `Uppercase<T>` is not related to `Lowercase<T>` — and then it is
                ; their operands that are compared.
                if src.symbol <> target.symbol
                    return false
                let s_t Checker.string_mapping_target_of(src)
                let t_t Checker.string_mapping_target_of(target)
                if s_t = null
                    return false
                if t_t = null
                    return false
                if this.is_related_to_ex(s_t as ref[Type], t_t as ref[Type], relation, error_node, IntersectionStateNone, RecursionFlagsBoth)
                    return true
                if this.unported_mark() <> mark
                    return false
            }
            else
            {
                let constraint this.get_base_constraint_of_type(src)
                if this.unported_mark() <> mark
                    return false
                if constraint <> null
                {
                    if this.is_related_to_ex(constraint as ref[Type], target, relation, error_node, IntersectionStateNone, RecursionFlagsSource)
                        return true
                    if this.unported_mark() <> mark
                        return false
                }
            }
        }
        ; ── the `default` arm ────────────────────────────────────────────────
        ;
        ; ★ Its two MAPPED guards are code since slice 157, because the target
        ; mapped arm above no longer reports: an empty object type against a
        ; PARTIAL mapped type, and a generic-mapped pair, reach here for real.
        ; "An empty object type is related to any mapped type that includes a
        ; '?' modifier" — every property of the target may be absent.
        if source_arm_taken
            return false
        var partial_mapped false
        if relation <> RelationSubtype
        {
            if relation <> RelationStrictSubtype
            {
                if Checker.is_partial_mapped_type(target)
                    set partial_mapped: true
            }
        }
        if partial_mapped
        {
            let mark this.unported_mark()
            let empty this.is_empty_object_type(src)
            if this.unported_mark() <> mark
                return false
            if empty
                return true
        }
        ; ★★★ THE GENERIC MAPPED TARGET ANSWERS HERE OR NOT AT ALL. The `return`
        ; is the reference's: a mapped type has no properties to compare
        ; structurally, so falling through would ask the object tail a question
        ; about a type whose members cannot be resolved.
        if this.is_generic_mapped_type(target)
        {
            if this.is_generic_mapped_type(src)
            {
                if this.mapped_type_related_to(src, target, relation, error_node)
                    return true
            }
            return false
        }
        var source_is_primitive false
        if (src.flags & TypeFlagsPrimitive) <> 0
            set source_is_primitive: true
        if relation <> RelationIdentity
        {
            let ap this.get_apparent_type(src)
            if ap = null
                return false
            set src: ap as ref[Type]
        }
        else
        {
            ; The IDENTITY relation does not take an apparent type, and a generic
            ; mapped source has nothing to be identical to structurally.
            if this.is_generic_mapped_type(src)
                return false
        }
        ; Two references to the SAME generic target — `Array<string>` against
        ; `Array<any>`. ★isMarkerType is FALSE by construction: the two marker
        ; types exist only to measure variance and this port measures none.
        if (src.object_flags & ObjectFlagsReference) <> 0
        {
            if (target.object_flags & ObjectFlagsReference) <> 0
            {
                var same_target false
                if Checker.target_of(src) = Checker.target_of(target)
                    set same_target: true
                if Checker.is_tuple_type(src)
                    set same_target: false
                if this.is_marker_type(src)
                    set same_target: false
                if this.is_marker_type(target)
                    set same_target: false
                if same_target
                {
                    if this.is_empty_array_literal_type(src)
                        return true
                    let tgt Checker.target_of(src)
                    if tgt = null
                        return false
                    let variances this.get_variances(tgt as ref[Type])
                    if variances = null
                    {
                        this.record_unported("get-variances", src.object_flags)
                        return false
                    }
                    let vs variances as ref[Array[int]]
                    ; TernaryUnknown for a RECURSIVE getVariances — the empty list.
                    ; The reference's own comment: it measures variance only from
                    ; occurrences that are not nested in recursive instantiations,
                    ; and Maybe is truthy, so the bool port answers `true` —
                    ; ★ counted as an UNKNOWN (slice 228, see rel_unknown_hits),
                    ; which no frame above records.
                    if (vs.get_length() as int) = 0
                    {
                        set rel_unknown_hits: rel_unknown_hits + 1
                        return true
                    }
                    let verdict this.relate_variances(this.get_type_arguments(src), this.get_type_arguments(target), vs, relation, error_node, intersection_state)
                    if verdict = RelateVariancesTrue
                        return true
                    if verdict = RelateVariancesFalse
                        return false
                    if verdict = RelateVariancesStructural
                        set rel_error_chain: rel_structural_chain
                    if verdict = RelateVariancesStructuralLatched
                    {
                        set variance_check_failed: true
                        set original_chain: rel_error_chain
                        set rel_error_chain: rel_structural_chain
                    }
                }
            }
        }
        ; A readonly array target with an array-or-tuple source — the arm the rest
        ; parameter's `T assignable to ReadonlyArray<any>` takes, since `Array` and
        ; `ReadonlyArray` are different targets and the arm above does not fire.
        if this.is_array_type(target)
        {
            ; `isReadonlyArrayType(target) && everyType(source, isArrayOrTupleType) ||
            ; everyType(source, isMutableTupleType)` — EVERY constituent of a union
            ; source, which is what a homomorphic mapped type over a union of tuples
            ; becomes at its apparent type (slice 202,
            ; `restParamUsingMappedTypeOverUnionConstraint`); and the second
            ; disjunct, a mutable-tuple source against a mutable array target, which
            ; was not written at all.
            var arrayish false
            if this.is_readonly_array_type(target)
            {
                if this.every_type_is_array_or_tuple(src)
                    set arrayish: true
            }
            if arrayish = false
            {
                if this.every_type_is_mutable_tuple(src)
                    set arrayish: true
            }
            if arrayish
            {
                if relation = RelationIdentity
                    return false
                let se this.get_index_type_of_type_ex(src, number_type, any_type)
                let te this.get_index_type_of_type_ex(target, number_type, any_type)
                if se = null
                    return false
                if te = null
                    return false
                ; ★★★ THE ERROR NODE IS NOT FORWARDED, and this is the report
                ; containment turned into code — see the header. The reference
                ; passes `reportErrors` down and every level APPENDS to one
                ; chain that is emitted once; this port emits at the line, so
                ; forwarding makes a failing comparison report ONCE PER LEVEL.
                ; Measured on `relation_source_optional_property.ts`: THREE
                ; TS2322 at one span where the reference has one.
                return this.is_related_to_ex(se as ref[Type], te as ref[Type], relation, null, intersection_state, RecursionFlagsBoth)
            }
        }
        ; The fresh empty-object target under the two subtype relations.
        ; `case isGenericTupleType(source) && isTupleType(target) && !isGenericTupleType(target)`:
        ; a variadic source (`[...T, ...T]`) relates to a fixed tuple through its BASE
        ; CONSTRAINT (`[unknown, unknown]` for `T extends [unknown]`); without the arm the
        ; element loop meets a variadic element against a required one and fails
        ; (slice 209; `variadicTuples1`'s `ft16`)
        if Checker.is_generic_tuple_type(src)
        {
            if Checker.is_tuple_type(target)
            {
                if Checker.is_generic_tuple_type(target) = false
                {
                    let gmark this.unported_mark()
                    let constraint this.get_base_constraint_or_type(src)
                    if this.unported_mark() <> gmark
                        return false
                    if constraint <> null
                    {
                        if (constraint as ref[Type]) <> src
                            return this.is_related_to_ex(constraint as ref[Type], target, relation, error_node, intersection_state, RecursionFlagsSource)
                    }
                }
            }
        }
        var subtypeish false
        if relation = RelationSubtype
            set subtypeish: true
        if relation = RelationStrictSubtype
            set subtypeish: true
        if subtypeish
        {
            if this.is_empty_object_type(target)
            {
                if (target.object_flags & ObjectFlagsFreshLiteral) <> 0
                {
                    if this.is_empty_object_type(src) = false
                        return false
                }
            }
        }
        ; The structural comparison.
        ;
        ; ★★★ `reportStructuralErrors` IS A THIRD CONDITION AND SLICE 167 IS WHERE
        ; IT GOT A READER. Upstream it is
        ; `reportErrors && r.errorChain == saveErrorState.errorChain && !sourceIsPrimitive`
        ; — *report structural errors only if we haven't reported any errors yet* —
        ; and the port passed the error node down on the first conjunct alone,
        ; because with no chain the middle one had nothing to compare. It has a
        ; reader now: reportUnmatchedProperty writes into the chain from inside
        ; properties_related_to, so a level that has ALREADY reported must not let
        ; the property walk add a second entry under its own.
        ;
        ; ★★★ AND IT IS MEASURED NEUTRAL ON THIS CORPUS RATHER THAN ASSUMED USEFUL:
        ; with the middle conjunct removed, stage 2 answers 17167 / 1038 / 6 / 232
        ; and **not one of the 18 444 units changes verdict**. So no level here
        ; currently reports before the property walk runs. It stands because it is
        ; the reference's own line and because a chain that HAS grown is exactly
        ; what the next writer in this chapter would produce — an arm with no input
        ; today, said rather than assumed.
        var structural_node: ref[AstNode]? null
        if error_node <> null
        {
            if source_is_primitive = false
            {
                if Checker.chain_depth(rel_error_chain) = rel_structural_chain_depth
                    set structural_node: error_node
            }
        }
        if (src.flags & (TypeFlagsObject | TypeFlagsIntersection)) <> 0
        {
            if (target.flags & TypeFlagsObject) <> 0
            {
                if this.properties_related_to(src, target, relation, structural_node, false, intersection_state) = false
                    return false
                if this.signatures_related_to(src, target, SignatureKindCall, relation, structural_node, intersection_state) = false
                    return false
                if this.signatures_related_to(src, target, SignatureKindConstruct, relation, structural_node, intersection_state) = false
                    return false
                if this.index_signatures_related_to(src, target, source_is_primitive, relation, structural_node, intersection_state) = false
                    return false
                ; ★★★ `if !varianceCheckFailed { return result }` — the latch, and
                ; it is the only place a SUCCEEDING comparison answers false. A
                ; failed invariant variance check ran the structural comparison for
                ; its elaboration alone; the answer was decided above.
                if variance_check_failed = false
                    return true
                if original_chain <> null
                    set rel_error_chain: original_chain
                else
                {
                    if rel_error_chain = null
                        set rel_error_chain: rel_structural_chain
                }
            }
        }
        ; typeRelatedToDiscriminatedType — an object source against a union target,
        ; which needs `extractTypesOfKind` and the discriminant walk.
        if (src.flags & (TypeFlagsObject | TypeFlagsIntersection)) <> 0
        {
            if (target.flags & TypeFlagsUnion) <> 0
                return this.type_related_to_discriminated_type(src, target, relation, intersection_state)
        }
        false
    }

    ; getUnmatchedProperty, at the one argument shape its two callers here use
    ; (`matchDiscriminantProperties` is false at both, and the list-collecting
    ; variant belongs to the discriminated-union walk).
    ;
    ; ★★★ A LOOKUP THAT STOPPED IS NOT A PROPERTY THAT IS MISSING. This function's
    ; whole product is *the target has a property the source does not*, so reading
    ; a null lookup as a MISS is the shape §3.5's `lookup_in_table` finding names,
    ; one relation over. The mark decides, and a stop answers *no unmatched
    ; property*: the relation goes on to the property loop, the mark already says
    ; the unit is unanswered, and no line is invented. ★The stop it used to name —
    ; `global-object-property-augment`, the lib lookup behind every name absent
    ; from a members table — is gone since slice 127; the rule is not, because
    ; every lookup below can still stop for another reason.
    procedure get_unmatched_property(this, source: ref[Type], target: ref[Type], require_optional_properties: bool) returns ref[Symbol]?
        this.get_unmatched_property_ex(source, target, require_optional_properties, false)

    ; ★★★ `match_discriminant_properties` IS THE ARM SLICE 130 ADDED, AND ITS
    ; ABSENCE WAS A WRONG ANSWER RATHER THAN A WALL. `types_definitely_unrelated`
    ; — the inference chapter's fast refutation — passes TRUE at its FIRST call
    ; and false at its second, and the whole point of the asymmetry is that a
    ; matching property NAME with a disagreeing LITERAL type is as good a
    ; refutation as a missing property. Dropping the arm made the first call
    ; answer the second's question, so `{ kind: "a" }` against `{ kind: "b" }`
    ; was *not definitely unrelated* and the inference went on to relate them.
    ;
    ; ★ `isStaticPrivateIdentifierProperty` is the reference's own TODO — a skip
    ; that exists because static private fields are not modelled there either —
    ; and it is transcribed rather than dropped, because it is a skip and dropping
    ; a skip adds candidates.
    ;
    ; ★ `CheckFlagsPartial` is set only by `getPropertyOfUnionOrIntersectionType`'s
    ; partial-union arm; the flag exists here, so the test is written.
    procedure get_unmatched_property_ex(this, source: ref[Type], target: ref[Type], require_optional_properties: bool, match_discriminant_properties: bool) returns ref[Symbol]?
    {
        let props this.get_properties_of_type(target)
        if props = null
            return null
        let list props as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let tp row as ref[Symbol]
                var ask require_optional_properties
                if ask = false
                {
                    if (Symbol.flags_of(tp) & SymbolFlagsOptional) = 0
                    {
                        if (Symbol.check_flags_of(tp) & CheckFlagsPartial) = 0
                            set ask: true
                    }
                }
                if this.is_static_private_identifier_property(tp)
                    set ask: false
                if ask
                {
                    let mark this.unported_mark()
                    let sp this.get_property_of_type(source, Symbol.name_of(tp))
                    if this.unported_mark() <> mark
                        return null
                    if sp = null
                        return tp
                    if match_discriminant_properties
                    {
                        if this.discriminant_property_disagrees(source, sp as ref[Symbol], tp)
                            return tp
                        if this.unported_mark() <> mark
                            return null
                    }
                }
            }
            set i: i + 1
        }
        null
    }

    ; The `matchDiscriminantProperties` arm's body — *the target's property has a
    ; UNIT type and the source's is neither `any` nor the same literal*. It is a
    ; function of its own for the s178 alloca-pool rule.
    procedure discriminant_property_disagrees(this, source: ref[Type], source_prop: ref[Symbol], target_prop: ref[Symbol]) returns bool
    {
        let mark this.unported_mark()
        let tt this.get_type_of_symbol(target_prop)
        if this.unported_mark() <> mark
            return false
        if tt = null
            return false
        if (((tt as ref[Type]).flags) & TypeFlagsUnit) = 0
            return false
        let st this.get_type_of_symbol(source_prop)
        if this.unported_mark() <> mark
            return false
        if st = null
            return false
        if (((st as ref[Type]).flags) & TypeFlagsAny) <> 0
            return false
        let sr this.get_regular_type_of_literal_type(st as ref[Type])
        let tr this.get_regular_type_of_literal_type(tt as ref[Type])
        if sr = null
            return false
        if tr = null
            return false
        (sr as ref[Type]) <> (tr as ref[Type])
    }

    ; getUnmatchedProperties — the COUNTING twin of the walk above
    ; (`getUnmatchedPropertiesWorker` with a non-nil propsOut). It answers the
    ; count rather than the list, because reportUnmatchedProperty's only questions
    ; of it are `len(props) == 1` and `len(props) > 5`.
    ;
    ; ★ `matchDiscriminantProperties` is FALSE at this call site and its arm is the
    ; discriminated-union chapter's, so the walk below is the requireOptional half
    ; alone. A stop under the property lookup is reported as a count of -1, which
    ; the caller reads as *do not report* rather than as a number.
    procedure get_unmatched_property_count(this, source: ref[Type], target: ref[Type], require_optional_properties: bool) returns int
    {
        let mark this.unported_mark()
        let props this.get_properties_of_type(target)
        if this.unported_mark() <> mark
            return 0 - 1
        if props = null
            return 0
        let list props as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        var count 0
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let tp row as ref[Symbol]
                var ask require_optional_properties
                if ask = false
                {
                    if (Symbol.flags_of(tp) & SymbolFlagsOptional) = 0
                        set ask: true
                }
                if ask
                {
                    let sp this.get_property_of_type(source, Symbol.name_of(tp))
                    if this.unported_mark() <> mark
                        return 0 - 1
                    if sp = null
                        set count: count + 1
                }
            }
            set i: i + 1
        }
        count
    }

    ; shouldReportUnmatchedPropertyError, whole. *"target has similar signature
    ; kinds to source, still focus on the unmatched property"* — a source that is
    ; all signatures and no properties is a FUNCTION, and blaming a missing
    ; property on it is the wrong message unless the target wants the same kind of
    ; signature.
    procedure should_report_unmatched_property_error(this, source: ref[Type], target: ref[Type], out_ok: ref[bool]) returns bool
    {
        let mark this.unported_mark()
        let scalls this.get_signatures_of_structured_type(source, SignatureKindCall)
        let sconstructs this.get_signatures_of_structured_type(source, SignatureKindConstruct)
        let sprops this.get_properties_of_object_type(source)
        if this.unported_mark() <> mark
            return false
        var call_n 0
        if scalls <> null
            set call_n: (scalls as ref[Array[ref[Signature]?]]).get_length() as int
        var construct_n 0
        if sconstructs <> null
            set construct_n: (sconstructs as ref[Array[ref[Signature]?]]).get_length() as int
        var prop_n 0
        if sprops <> null
            set prop_n: (sprops as ref[Array[ref[Symbol]?]]).get_length() as int
        if prop_n <> 0
        {
            set out_ok: true
            return true
        }
        if call_n = 0
        {
            if construct_n = 0
            {
                set out_ok: true
                return true
            }
        }
        let tcalls this.get_signatures_of_type(target, SignatureKindCall)
        let tconstructs this.get_signatures_of_type(target, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return false
        var tcall_n 0
        if tcalls <> null
            set tcall_n: (tcalls as ref[Array[ref[Signature]?]]).get_length() as int
        var tconstruct_n 0
        if tconstructs <> null
            set tconstruct_n: (tconstructs as ref[Array[ref[Signature]?]]).get_length() as int
        var similar false
        if tcall_n <> 0
        {
            if call_n <> 0
                set similar: true
        }
        if tconstruct_n <> 0
        {
            if construct_n <> 0
                set similar: true
        }
        set out_ok: similar
        true
    }

    ; reportUnmatchedProperty — the two arms this port can carry.
    ;
    ; ★★★ IT DOES NOT EMIT; IT REPORTS INTO THE CHAIN, which since slice 167 is the
    ; reference's own `reportError` and no longer a cell standing in for one. The
    ; code becomes the diagnostic's only where reportRelationError then suppresses
    ; its own message — the pair recorded on the entry is what that fork's
    ; `chain_args_match` asks about — and where it does not, the outer message
    ; prepends over it and this one becomes an invisible link.
    ;
    ; ★★ THE PRIVATE-IDENTIFIER ARM IS NOT WRITTEN: it needs
    ; binder.GetSymbolNameForPrivateIdentifier — the mangled `__#<id>@<name>` key
    ; whose ID half is the reference's process-wide symbol counter — and this port
    ; has no such key. It is guarded down to its input (a `#name` VALUE DECLARATION
    ; on the unmatched property AND a CLASS source), so everything else passes
    ; through rather than stopping.
    ;
    ; ★ tryElaborateArrayLikeErrors is asked with reportErrors FALSE and answers
    ; TRUE for a source that is neither a tuple nor a readonly array against a
    ; target that is not a tuple — the ordinary object pair — which is why the
    ; MULTI-property arm is live and not a decoration.
    procedure report_unmatched_property(this, source: ref[Type], target: ref[Type], unmatched: ref[Symbol], require_optional_properties: bool)
    {
        let vd Symbol.value_declaration_of(unmatched)
        if vd <> null
        {
            let nm AstNode.name_of(vd as ref[AstNode])
            if nm <> null
            {
                if AstNode.kind_of(nm as ref[AstNode]) = KindPrivateIdentifier
                {
                    if source.symbol <> null
                    {
                        if (Symbol.flags_of(source.symbol as ref[Symbol]) & SymbolFlagsClass) <> 0
                        {
                            ; The mangled `__#<id>@<name>` key, and the ID is READ
                            ; rather than minted for lookup_symbol_for_private_
                            ; identifier_declaration's reason. A source class whose
                            ; id is still 0 declares no private member, so the
                            ; lookup below cannot hit and falling through to the
                            ; ordinary report is what upstream does on a miss.
                            let ss source.symbol as ref[Symbol]
                            if ss.id <> 0
                            {
                                let key Binder.private_identifier_name(Page.get(this), ss.id, AstNode.identifier_text_of(nm))
                                let mark this.unported_mark()
                                let other this.get_property_of_type(source, key)
                                ; A stop under the lookup must not fall through to
                                ; the ordinary report: the answer it would carry is
                                ; unknown, and reporting on an unknown answer is an
                                ; INVENTED diagnostic rather than a missing one.
                                if this.unported_mark() <> mark
                                    return
                                if other <> null
                                {
                                    this.report_error(DiagProperty_0_in_type_1_refers_to_a_different_member_that_cannot_be_accessed_from_within_type_2, source, target, Checker.arg_text(AstNode.identifier_text_of(nm)), this.symbol_arg(source.symbol), this.symbol_arg(target.symbol))
                                    return
                                }
                            }
                        }
                    }
                }
            }
        }
        let count this.get_unmatched_property_count(source, target, require_optional_properties)
        if count < 0
            return
        let unmatched_mark this.unported_mark()
        let unmatched_props &Array[ref[Symbol]?]^host()
        this.collect_unmatched_properties(source, target, require_optional_properties, unmatched_props)
        if this.unported_mark() <> unmatched_mark
            return
        if count = 1
        {
            let names_source this.type_display_arg(source)
            let names_target this.type_display_arg(target)
            var source_type names_source
            var target_type names_target
            if names_source = names_target
            {
                set source_type: this.type_name_for_error_display(source)
                set target_type: this.type_name_for_error_display(target)
            }
            let prop_name this.symbol_arg(unmatched)
            this.report_error(DiagProperty_0_is_missing_in_type_1_but_required_in_type_2, source, target, prop_name, source_type, target_type)
            let unmatched_symbol unmatched as ref[Symbol]
            let first_declaration Symbol.declaration_at(unmatched_symbol, 0)
            if first_declaration <> null
            {
                let related_args this.message_args()
                related_args.add(prop_name)
                this.relater_related_info(first_declaration, DiagX_0_is_declared_here, related_args)
            }
            return
        }
        if this.try_elaborate_array_like_errors(source, target) = false
            return
        let names_source this.type_display_arg(source)
        let names_target this.type_display_arg(target)
        var source_type names_source
        var target_type names_target
        if names_source = names_target
        {
            set source_type: this.type_name_for_error_display(source)
            set target_type: this.type_name_for_error_display(target)
        }
        var prop_names StringBuilder()
        var shown unmatched_props.get_length() as int
        if shown > 5
            set shown: 4
        var pi 0
        while pi < shown
        {
            if pi > 0
                prop_names.append(", ")
            let pe unmatched_props[pi as size_t]
            prop_names.append(this.symbol_arg(pe))
            set pi: pi + 1
        }
        if (unmatched_props.get_length() as int) > 5
        {
            this.report_error(DiagType_0_is_missing_the_following_properties_from_type_1_Colon_2_and_3_more, source, target, source_type, target_type, prop_names.to_string(), Checker.arg_int((unmatched_props.get_length() as int) - 4))
            return
        }
        this.report_error(DiagType_0_is_missing_the_following_properties_from_type_1_Colon_2, source, target, source_type, target_type, prop_names.to_string())
    }

    ; tryElaborateArrayLikeErrors with reportErrors FALSE — the BOOL alone. Its two
    ; REPORTING arms are `try_elaborate_array_like_errors_reporting`, which
    ; report_error_results calls; nothing is emitted here and nothing stops: this is
    ; the same walk with the two `if reportErrors` blocks removed, exactly as the
    ; reference runs it from reportUnmatchedProperty.
    procedure try_elaborate_array_like_errors(this, source: ref[Type], target: ref[Type]) returns bool
    {
        if Checker.is_tuple_type(source)
        {
            if Checker.tuple_readonly_of(Checker.get_target_type(source))
            {
                if this.is_mutable_array_or_tuple(target)
                    return false
            }
            return this.is_array_or_tuple_type(target)
        }
        if this.is_readonly_array_type(source)
        {
            if this.is_mutable_array_or_tuple(target)
                return false
        }
        if Checker.is_tuple_type(target)
            return this.is_array_type(source)
        true
    }

    ; isArrayOrTupleType / isMutableArrayOrTuple.
    procedure is_mutable_array_or_tuple(this, t: ref[Type]) returns bool
    {
        if this.is_array_type(t)
        {
            if this.is_readonly_array_type(t) = false
                return true
        }
        if Checker.is_tuple_type(t)
        {
            if Checker.tuple_readonly_of(Checker.get_target_type(t)) = false
                return true
        }
        false
    }

    ; propertiesIdenticalTo — the identity relation's property half.
    ;
    ; ★★★ `excludeProperties` AND ITS SET ARE NOT PORTED HERE, AND THE REASON IS
    ; THE CALLERS' rather than an omission: the set is non-empty at exactly ONE
    ; call site upstream, typeRelatedToDiscriminatedType's, and that function runs
    ; for the assignable and comparable relations only — the identity relation
    ; never reaches it. So on this path the set is empty at all three call sites
    ; and `excludeProperties` is the identity. It comes back with the
    ; discriminated-union chapter, where its set has a writer.
    ;
    ; ★ Both sides must be Object: the identity of two unions is
    ; `eachTypeRelatedToSomeType`'s question, not this one's.
    procedure properties_identical_to(this, source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        if (source.flags & TypeFlagsObject) = 0
            return false
        if (target.flags & TypeFlagsObject) = 0
            return false
        let mark this.unported_mark()
        let sprops this.get_properties_of_object_type(source)
        let tprops this.get_properties_of_object_type(target)
        if this.unported_mark() <> mark
            return false
        var sn 0
        if sprops <> null
            set sn: (sprops as ref[Array[ref[Symbol]?]]).get_length() as int
        var tn 0
        if tprops <> null
            set tn: (tprops as ref[Array[ref[Symbol]?]]).get_length() as int
        if sn <> tn
            return false
        if sn = 0
            return true
        let slist sprops as ref[Array[ref[Symbol]?]]
        let save_relation rel_cur_relation
        set rel_cur_relation: relation
        var answer true
        var i 0
        while i < sn
        {
            let row slist[i]
            if row = null
                set answer: false
            if answer
            {
                let sp row as ref[Symbol]
                let tp this.get_property_of_object_type(target, Symbol.name_of(sp))
                if this.unported_mark() <> mark
                    set answer: false
                else
                {
                    if tp = null
                        set answer: false
                    else
                    {
                        if this.compare_properties(sp, tp as ref[Symbol], SignatureComparerRelaterSimple) = false
                            set answer: false
                    }
                }
            }
            if answer = false
                break
            set i: i + 1
        }
        set rel_cur_relation: save_relation
        answer
    }

    ; compareProperties — two members are identical when they are PUBLIC with the
    ; same name, optionality and type, or NON-PUBLIC and originating in the same
    ; declaration with the same type. ★The accessibility fork is exclusive: the
    ; optionality is compared only for the public pair, because a private pair
    ; that shares a declaration shares its optionality by construction.
    procedure compare_properties(this, source_prop: ref[Symbol], target_prop: ref[Symbol], comparer: int) returns bool
    {
        if source_prop = target_prop
            return true
        let mark this.unported_mark()
        let sa this.get_declaration_modifier_flags_from_symbol(source_prop) & ModifierFlagsNonPublicAccessibilityModifier
        let ta this.get_declaration_modifier_flags_from_symbol(target_prop) & ModifierFlagsNonPublicAccessibilityModifier
        if this.unported_mark() <> mark
            return false
        if sa <> ta
            return false
        if sa <> 0
        {
            if this.get_target_symbol(source_prop) <> this.get_target_symbol(target_prop)
                return false
        }
        else
        {
            if (Symbol.flags_of(source_prop) & SymbolFlagsOptional) <> (Symbol.flags_of(target_prop) & SymbolFlagsOptional)
                return false
        }
        if this.is_readonly_symbol(source_prop) <> this.is_readonly_symbol(target_prop)
            return false
        let st this.get_non_missing_type_of_symbol(source_prop)
        let tt this.get_non_missing_type_of_symbol(target_prop)
        if this.unported_mark() <> mark
            return false
        if st = null
            return false
        if tt = null
            return false
        this.compare_types_by_comparer(comparer, st as ref[Type], tt as ref[Type])
    }

    ; propertiesRelatedTo — the object half. See the worker's header for why not
    ; one of its eleven reports is written.
    ; ── slice 130: the BEST MATCH in a union target ─────────────────────────
    ;
    ; getBestMatchingType and its five finders. Its whole job is to pick the ONE
    ; constituent of a failing union target that an error should be elaborated
    ; against — `typeRelatedToSomeType` calls it only under `reportErrors`, after
    ; every constituent has already answered false.
    ;
    ; ★★★ THE ORDER OF THE FIVE IS THE ANSWER, NOT AN OPTIMISATION: the
    ; discriminant first (an exact tag match), then a reference to the SAME
    ; generic target or the same alias, then the non-array-like constituent for an
    ; object literal, then a constituent with the same kind of signature, and only
    ; then the one whose KEYS overlap most. Each is more specific than the next,
    ; and re-ordering them changes which line a user reads.
    ;
    ; ★ It is also `hasExcessProperties`' reduction (through
    ; find_matching_discriminant_type), where a wrong pick is a wrong REPORT and
    ; not a wrong relation.
    procedure get_best_matching_type(this, source: ref[Type], target: ref[Type], comparer_relation: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let by_discriminant this.find_matching_discriminant_type(source, target, comparer_relation)
        if this.unported_mark() <> mark
            return null
        if by_discriminant <> null
            return by_discriminant
        let by_reference this.find_matching_type_reference_or_type_alias_reference(source, target)
        if by_reference <> null
            return by_reference
        let by_literal this.find_best_type_for_object_literal(source, target)
        if this.unported_mark() <> mark
            return null
        if by_literal <> null
            return by_literal
        let by_call this.find_best_type_for_invokable(source, target, SignatureKindCall)
        if this.unported_mark() <> mark
            return null
        if by_call <> null
            return by_call
        let by_construct this.find_best_type_for_invokable(source, target, SignatureKindConstruct)
        if this.unported_mark() <> mark
            return null
        if by_construct <> null
            return by_construct
        this.find_most_overlappy_type(source, target)
    }

    ; findMatchingTypeReferenceOrTypeAliasReference — the same generic TARGET, or
    ; the same alias symbol. The two `overlapObjFlags` tests are one bitwise AND
    ; of the two sides' object flags, which is what makes each arm ask that BOTH
    ; sides are of that kind.
    function find_matching_type_reference_or_type_alias_reference(this, source: ref[Type], union_target: ref[Type]) returns ref[Type]?
    {
        if (source.object_flags & (ObjectFlagsReference | ObjectFlagsAnonymous)) = 0
            return null
        if (union_target.flags & TypeFlagsUnion) = 0
            return null
        let types Checker.union_types_of(union_target)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let t row as ref[Type]
            if (t.flags & TypeFlagsObject) = 0
                continue
            let overlap source.object_flags & t.object_flags
            if (overlap & ObjectFlagsReference) <> 0
            {
                if Checker.target_of(source) = Checker.target_of(t)
                    return t
            }
            if (overlap & ObjectFlagsAnonymous) <> 0
            {
                if source.alias_symbol <> null
                {
                    if t.alias_symbol <> null
                    {
                        if source.alias_symbol = t.alias_symbol
                            return t
                    }
                }
            }
        }
        null
    }

    ; findBestTypeForInvokable — *the source is callable, so blame a constituent
    ; that is callable too*.
    procedure find_best_type_for_invokable(this, source: ref[Type], union_target: ref[Type], kind: int) returns ref[Type]?
    {
        let mark this.unported_mark()
        let sigs this.get_signatures_of_type(source, kind)
        if this.unported_mark() <> mark
            return null
        if sigs = null
            return null
        if ((sigs as ref[Array[ref[Signature]?]]).get_length() as int) = 0
            return null
        let types Checker.union_types_of(union_target)
        if types = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let tsigs this.get_signatures_of_type(row as ref[Type], kind)
            if this.unported_mark() <> mark
                return null
            if tsigs = null
                continue
            if ((tsigs as ref[Array[ref[Signature]?]]).get_length() as int) <> 0
                return row
        }
        null
    }

    ; findBestTypeForObjectLiteral — an object literal against a union that has an
    ; ARRAY-LIKE constituent: blame the one that is not array-like, because the
    ; array-like one's message would be about a length that was never written.
    procedure find_best_type_for_object_literal(this, source: ref[Type], union_target: ref[Type]) returns ref[Type]?
    {
        if (source.object_flags & ObjectFlagsObjectLiteral) = 0
            return null
        let types Checker.union_types_of(union_target)
        if types = null
            return null
        let mark this.unported_mark()
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var some_array_like false
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                if this.is_array_like_type(row as ref[Type])
                    set some_array_like: true
            }
            if this.unported_mark() <> mark
                return null
            set i: i + 1
        }
        if some_array_like = false
            return null
        set i: 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                if this.is_array_like_type(row as ref[Type]) = false
                    return row
                if this.unported_mark() <> mark
                    return null
            }
            set i: i + 1
        }
        null
    }

    ; findMostOverlappyType — the constituent whose KEY SET overlaps the source's
    ; most, measured as `keyof source & keyof target`.
    ;
    ; ★★★ AN OVERLAP THAT IS ITSELF AN `Index` TYPE IS A PERFECT MATCH AND RETURNS
    ; AT ONCE — that is the reference's own comment, and it is the only early exit
    ; here. Everything else counts UNIT constituents, because an overlap that is a
    ; union of index types means two generic mapped types were being compared and
    ; the count would measure nothing.
    procedure find_most_overlappy_type(this, source: ref[Type], union_target: ref[Type]) returns ref[Type]?
    {
        if (source.flags & (TypeFlagsPrimitive | TypeFlagsInstantiablePrimitive)) <> 0
            return null
        let types Checker.union_types_of(union_target)
        if types = null
            return null
        let mark this.unported_mark()
        let source_keys this.get_index_type(source)
        if this.unported_mark() <> mark
            return null
        if source_keys = null
            return null
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var best: ref[Type]? null
        var matching_count 0
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let t row as ref[Type]
            if (t.flags & (TypeFlagsPrimitive | TypeFlagsInstantiablePrimitive)) <> 0
                continue
            let target_keys this.get_index_type(t)
            if this.unported_mark() <> mark
                return null
            if target_keys = null
                continue
            let pair &Array[ref[Type]?]()
            pair.add(source_keys)
            pair.add(target_keys)
            let overlap this.get_intersection_type(pair)
            if this.unported_mark() <> mark
                return null
            if overlap = null
                continue
            let ov overlap as ref[Type]
            if (ov.flags & TypeFlagsIndex) <> 0
                return t
            var length 0
            if Checker.is_unit_type(ov)
                set length: 1
            if (ov.flags & TypeFlagsUnion) <> 0
                set length: Checker.count_unit_constituents(ov)
            if length <> 0
            {
                if length >= matching_count
                {
                    set best: t
                    set matching_count: length
                }
            }
        }
        best
    }

    function count_unit_constituents(t: ref[Type]) returns int
    {
        let types Checker.union_types_of(t)
        if types = null
            return 0
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        var count 0
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                if Checker.is_unit_type(row as ref[Type])
                    set count: count + 1
            }
            set i: i + 1
        }
        count
    }

    ; ── slice 130: the DISCRIMINATION WALK ──────────────────────────────────
    ;
    ; discriminateTypeByDiscriminableItems, whole, and it is the routine BOTH
    ; discriminated chapters end in — the relation's `findMatchingDiscriminantType`
    ; and checker.go's contextual-type discrimination
    ; (`discriminateContextualTypeByObjectMembers`, still a stop).
    ;
    ; ★★★ THE THREE-STATE `include` IS THE ALGORITHM AND A BOOLEAN CANNOT CARRY IT.
    ; Per discriminant property the walk marks every constituent whose value does
    ; NOT match as Maybe, and only if SOME constituent matched are the Maybes
    ; turned into False — otherwise they all revert to True. That is what makes an
    ; erroneous discriminator (one no constituent carries) harmless rather than
    ; fatal: without the revert the set would empty out and the answer would be
    ; `never`. So the three values stay three values here even though the rest of
    ; this chapter collapses Ternary to bool.
    ;
    ; ★★ THE DISCRIMINATOR IS A RECORD RATHER THAN AN INTERFACE, and the arm it
    ; carries is the reference's `TypeDiscriminator`: a property list plus the
    ; relation to ask with. checker.go's implementation reads a JSX/object-literal
    ; member instead and arrives with its own chapter — the tag is what will tell
    ; them apart, on the union arm's convention.
    ; ★★★ SLICE 146 GENERALISED THE SIGNATURE and the note above is what said it
    ; would: the walk now takes the DISCRIMINATOR rather than a property list and
    ; a relation, because checker.go's implementation reads a member's INITIALIZER
    ; where the relation's reads a source property's TYPE. The three-state vector,
    ; the revert rule and the UnionReductionNone tail are untouched.
    procedure discriminate_type_by_discriminable_items(this, target: ref[Type], d: ref[Discriminator]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let types Checker.union_types_of(target)
        if types = null
            return target
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        ; The three-state vector, sized to the union up front so every slot can be
        ; written by index rather than appended in order.
        let keep_set &Array[int]()
        var i 0
        while i < n
        {
            keep_set.add(DiscriminateFalse)
            set i: i + 1
        }
        set i: 0
        while i < n
        {
            let row list[i]
            var keep DiscriminateFalse
            if row <> null
            {
                let t row as ref[Type]
                if (t.flags & TypeFlagsPrimitive) = 0
                {
                    let reduced this.get_reduced_type(t)
                    if this.unported_mark() <> mark
                        return target
                    if reduced <> null
                    {
                        if ((reduced as ref[Type]).flags & TypeFlagsNever) = 0
                            set keep: DiscriminateTrue
                    }
                }
            }
            keep_set.put(i as size_t, keep)
            set i: i + 1
        }
        let pn Checker.discriminator_length(d)
        var pi 0
        while pi < pn
        {
            let dname this.discriminator_name_at(d, pi)
            let at pi
            set pi: pi + 1
            if dname.data = null
                continue
            var matched false
            set i: 0
            while i < n
            {
                let cur keep_set[i]
                if cur <> DiscriminateFalse
                {
                    let row list[i]
                    if row <> null
                    {
                        let target_type this.get_type_of_property_or_index_signature_of_type(row as ref[Type], dname)
                        if this.unported_mark() <> mark
                            return target
                        if target_type <> null
                        {
                            if this.discriminator_matches_at(d, at, target_type as ref[Type])
                                set matched: true
                            else
                                keep_set.put(i as size_t, DiscriminateMaybe)
                            if this.unported_mark() <> mark
                                return target
                        }
                    }
                }
                set i: i + 1
            }
            set i: 0
            while i < n
            {
                let cur keep_set[i]
                if cur = DiscriminateMaybe
                {
                    if matched
                        keep_set.put(i as size_t, DiscriminateFalse)
                    else
                        keep_set.put(i as size_t, DiscriminateTrue)
                }
                set i: i + 1
            }
        }
        var any_excluded false
        set i: 0
        while i < n
        {
            let cur keep_set[i]
            if cur = DiscriminateFalse
                set any_excluded: true
            set i: i + 1
        }
        if any_excluded = false
            return target
        let kept &Array[ref[Type]?]()
        set i: 0
        while i < n
        {
            let cur keep_set[i]
            if cur = DiscriminateTrue
                kept.add(list[i])
            set i: i + 1
        }
        ; UnionReductionNone — the filtered set is a SUBSET of a union that has
        ; already been reduced, so reducing again could collapse a constituent the
        ; caller is about to compare against.
        let filtered this.get_union_type_ex(kept, UnionReductionNone, null, null)
        if this.unported_mark() <> mark
            return target
        if filtered = null
            return target
        if (((filtered as ref[Type]).flags) & TypeFlagsNever) <> 0
            return target
        filtered
    }

    ; TypeDiscriminator.len.
    function discriminator_length(d: ref[Discriminator]) returns int
    {
        if d.kind = DiscriminatorKindRelation
        {
            if d.props = null
                return 0
            return (d.props as ref[Array[ref[Symbol]?]]).get_length() as int
        }
        var n 0
        if d.nodes <> null
            set n: (d.nodes as ref[Array[ref[AstNode]?]]).get_length() as int
        if d.members <> null
            set n: n + ((d.members as ref[Array[ref[Symbol]?]]).get_length() as int)
        n
    }

    ; TypeDiscriminator.name. ★An EMPTY answer means *no name at this index*, which
    ; the walk skips — the reference cannot reach that state (its lists hold no
    ; nils) and this port's Arrays are of optionals, so the skip is the null arm.
    function discriminator_name_at(this, d: ref[Discriminator], index: int) returns Slice[char]
    {
        if d.kind = DiscriminatorKindRelation
        {
            if d.props = null
                return Slice[char]()
            let row (d.props as ref[Array[ref[Symbol]?]])[index]
            if row = null
                return Slice[char]()
            return Symbol.name_of(row as ref[Symbol])
        }
        var node_count 0
        if d.nodes <> null
            set node_count: (d.nodes as ref[Array[ref[AstNode]?]]).get_length() as int
        if index < node_count
        {
            let pn (d.nodes as ref[Array[ref[AstNode]?]])[index]
            if pn = null
                return Slice[char]()
            let sym AstNode.symbol_of(pn as ref[AstNode])
            if sym = null
                return Slice[char]()
            return Symbol.name_of(sym as ref[Symbol])
        }
        if d.members = null
            return Slice[char]()
        let m (d.members as ref[Array[ref[Symbol]?]])[index - node_count]
        if m = null
            return Slice[char]()
        Symbol.name_of(m as ref[Symbol])
    }

    ; TypeDiscriminator.matches — *some constituent of the SOURCE value's type is
    ; related to the target's value for this property*.
    ;
    ; ★★ THE TWO FORMS DIFFER ONLY IN WHERE THE SOURCE TYPE COMES FROM and in
    ; WHICH RELATION is asked, and the second half is not a detail: the relation
    ; form asks the relation the caller was under, while checker.go's asks
    ; `isTypeAssignableTo` flat — so ASSIGNABLE is written here rather than
    ; forwarded, which is §3.5ga's rule (a comparer that defaults silently is the
    ; bug the tag exists to prevent).
    procedure discriminator_matches_at(this, d: ref[Discriminator], index: int, t: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        var source_type: ref[Type]? null
        var relation RelationAssignable
        if d.kind = DiscriminatorKindRelation
        {
            set relation: d.comparer_relation
            if d.props = null
                return false
            let row (d.props as ref[Array[ref[Symbol]?]])[index]
            if row = null
                return false
            set source_type: this.get_type_of_symbol(row as ref[Symbol])
            if this.unported_mark() <> mark
                return false
        }
        else
        {
            var node_count 0
            if d.nodes <> null
                set node_count: (d.nodes as ref[Array[ref[AstNode]?]]).get_length() as int
            if index < node_count
            {
                let pn (d.nodes as ref[Array[ref[AstNode]?]])[index]
                if pn = null
                    return false
                let prop pn as ref[AstNode]
                let pk AstNode.kind_of(prop)
                if pk = KindPropertyAssignment
                    set source_type: this.discriminator_initializer_type(prop)
                else
                {
                    if pk = KindJsxAttribute
                        set source_type: this.discriminator_initializer_type(prop)
                    else
                    {
                        ; The SHORTHAND property assignment — the reference reads
                        ; the NAME as an expression, which is the identifier's own
                        ; type. ★A shorthand assignment always HAS a name; the
                        ; guard is the declaration's honesty and not a claim about
                        ; the population.
                        let pname AstNode.name_of(prop)
                        if pname = null
                            return false
                        set source_type: this.get_context_free_type_of_expression(pname as ref[AstNode])
                    }
                }
                if this.unported_mark() <> mark
                    return false
            }
            else
                ; A discriminant the literal does NOT carry: its value is
                ; `undefined`, which is what excludes a constituent that requires
                ; the property.
                set source_type: undefined_type
        }
        if source_type = null
            return false
        let parts this.distributed_types(source_type as ref[Type])
        let n parts.get_length() as int
        var i 0
        while i < n
        {
            let row parts[i]
            if row <> null
            {
                if this.is_related_to_ex(row as ref[Type], t, relation, null, IntersectionStateNone, RecursionFlagsBoth)
                    return true
                if this.unported_mark() <> mark
                    return false
            }
            set i: i + 1
        }
        false
    }

    ; The initializer half of the two member forms. ★A JsxAttribute with NO
    ; initializer is `true` — the reference's own comment — and that is the one
    ; place the two forms genuinely differ from a property assignment, whose
    ; initializer is always there.
    procedure discriminator_initializer_type(this, prop: ref[AstNode]) returns ref[Type]?
    {
        ; `init` is a reserved word here — check_jsx_attribute's own note names
        ; the family — so the binding is `initial`.
        let initial AstNode.initializer_of(prop)
        if initial = null
        {
            if AstNode.kind_of(prop) = KindJsxAttribute
                return true_type
            return null
        }
        this.get_context_free_type_of_expression(initial as ref[AstNode])
    }

    ; isPossiblyDiscriminantValue, whole. ★The reference's comment is the reason
    ; the list is closed rather than a predicate: *we limit the kinds of
    ; expressions we check to those that don't depend on their contextual type in
    ; order not to cause recursive (and possibly infinite) invocations of
    ; getContextualType.*
    function is_possibly_discriminant_value(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        let k AstNode.kind_of(n)
        if k = KindStringLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindTemplateExpression
            return true
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        if k = KindNullKeyword
            return true
        if k = KindIdentifier
            return true
        if k = KindUndefinedKeyword
            return true
        if k = KindPropertyAccessExpression
            return this.is_possibly_discriminant_value(AstNode.expression_of(n))
        if k = KindParenthesizedExpression
            return this.is_possibly_discriminant_value(AstNode.expression_of(n))
        if k = KindJsxExpression
        {
            if AstNode.expression_of(n) = null
                return true
            return this.is_possibly_discriminant_value(AstNode.expression_of(n))
        }
        false
    }

    ; findMatchingDiscriminantType — the union constituent a source object matches,
    ; by the KEY property first (the O(1) map) and by the discriminant walk after.
    ;
    ; ★ The reference's comment asks that this be kept in step with
    ; `getApparentTypeOfContextualType`, whose discriminating half is still a stop
    ; (`discriminate-contextual-type`); the two share this function's tail, which
    ; is the reason the comment exists.
    procedure find_matching_discriminant_type(this, source: ref[Type], target: ref[Type], comparer_relation: int) returns ref[Type]?
    {
        if (target.flags & TypeFlagsUnion) = 0
            return null
        if (source.flags & (TypeFlagsIntersection | TypeFlagsObject)) = 0
            return null
        let mark this.unported_mark()
        let by_key this.get_matching_union_constituent_for_type(target, source)
        if this.unported_mark() <> mark
            return null
        if by_key <> null
            return by_key
        let sprops this.get_properties_of_type(source)
        if this.unported_mark() <> mark
            return null
        let discriminants this.find_discriminant_properties(sprops, target)
        if this.unported_mark() <> mark
            return null
        if discriminants = null
            return null
        let props discriminants as ref[Array[ref[Symbol]?]]
        if (props.get_length() as int) = 0
            return null
        let d &Discriminator^host(DiscriminatorKindRelation, props, comparer_relation, null, null)
        let discriminated this.discriminate_type_by_discriminable_items(target, d)
        if discriminated = null
            return null
        if (discriminated as ref[Type]) = target
            return null
        discriminated
    }

    ; ── slice 146: THE DISCRIMINATED CONTEXTUAL TYPE ────────────────────────
    ;
    ; ★★★ WHY THIS CHAPTER LANDS WITH getRegularTypeOfObjectLiteral, AND IT IS A
    ; MEASUREMENT RATHER THAN A GROUPING. Porting the relater's
    ; `typeRelatedToSomeType(getRegularTypeOfObjectLiteral(source), …)` took the
    ; `regular-type-of-object-literal` stop off the union arm — and one unit,
    ; `compiler_missingDiscriminants`, then reported SIX invented TS2322 on the
    ; property names of three object literals that are correct TypeScript. The
    ; wrong answer was not new: the unit stops at `discriminate-contextual-type`,
    ; so its literals never got the contextual constituent and their types were
    ; already wrong — the relater's stop was the only thing between that and
    ; diagcheck (§3.5eb: a wall hides wrong answers too, and this one hid one for
    ; sixteen slices). ★★A stop that shields a wrong answer may not be kept once
    ; its own callee answers: a `record_unported` there would be a claim that a
    ; function which HAS no stop stopped.
    ;
    ; discriminateContextualTypeByObjectMembers, whole.
    procedure discriminate_contextual_type_by_object_members(this, node: ref[AstNode], contextual_type: ref[Type]) returns ref[Type]?
    {
        let cached this.discriminated_contextual_type_link_of(node, contextual_type)
        if cached <> null
            return (cached as ref[DiscriminatedContextualTypeLink]).discriminated
        let mark this.unported_mark()
        var discriminated this.get_matching_union_constituent_for_object_literal(contextual_type, node)
        if this.unported_mark() <> mark
            return null
        if discriminated = null
        {
            let props this.collect_object_literal_discriminant_properties(node, contextual_type, false)
            if this.unported_mark() <> mark
                return null
            if props = null
                return null
            let members this.collect_discriminant_members(node, contextual_type, Slice[char](), null)
            if this.unported_mark() <> mark
                return null
            if members = null
                return null
            let d &Discriminator^host(DiscriminatorKindObjectLiteral, null, RelationAssignable, props, members)
            set discriminated: this.discriminate_type_by_discriminable_items(contextual_type, d)
            if this.unported_mark() <> mark
                return null
        }
        if discriminated = null
            return null
        let row &DiscriminatedContextualTypeLink^host(node, contextual_type, discriminated)
        discriminated_contextual_type_links.add(row)
        discriminated
    }

    ; discriminateContextualTypeByJSXAttributes, whole (jsx.go).
    ;
    ; ★★ THE ONE TERM THAT IS NOT THE OBJECT-LITERAL ONE is the children
    ; exemption: the children property is not a discriminant when the ELEMENT has
    ; semantic children, because those fill it without an attribute. Everything
    ; else is the same two filters.
    procedure discriminate_contextual_type_by_jsx_attributes(this, node: ref[AstNode], contextual_type: ref[Type]) returns ref[Type]?
    {
        let cached this.discriminated_contextual_type_link_of(node, contextual_type)
        if cached <> null
            return (cached as ref[DiscriminatedContextualTypeLink]).discriminated
        let mark this.unported_mark()
        var children_name Slice[char]()
        var stopped false
        let ns this.get_jsx_namespace_at(node)
        if this.unported_mark() <> mark
            return null
        if this.get_jsx_element_children_property_name(ns, &children_name, &stopped) = false
            set children_name: Slice[char]()
        if stopped
            return null
        if this.unported_mark() <> mark
            return null
        let props this.collect_object_literal_discriminant_properties(node, contextual_type, true)
        if this.unported_mark() <> mark
            return null
        if props = null
            return null
        let members this.collect_discriminant_members(node, contextual_type, children_name, AstNode.parent_node_of(AstNode.parent_node_of(node)))
        if this.unported_mark() <> mark
            return null
        if members = null
            return null
        let d &Discriminator^host(DiscriminatorKindObjectLiteral, null, RelationAssignable, props, members)
        let discriminated this.discriminate_type_by_discriminable_items(contextual_type, d)
        if this.unported_mark() <> mark
            return null
        if discriminated = null
            return null
        let row &DiscriminatedContextualTypeLink^host(node, contextual_type, discriminated)
        discriminated_contextual_type_links.add(row)
        discriminated
    }

    ; The first `core.Filter` of both functions above. ★The JSX form differs by
    ; ONE conjunct — an attribute with no initializer passes, because its value is
    ; `true` — so it is a flag rather than a second copy.
    procedure collect_object_literal_discriminant_properties(this, node: ref[AstNode], contextual_type: ref[Type], jsx: bool) returns ref[Array[ref[AstNode]?]]?
    {
        let mark this.unported_mark()
        let out &Array[ref[AstNode]?]^host()
        let properties AstNode.properties_of(node)
        let count AstNode.list_count(properties)
        var i 0
        while i < count
        {
            let row AstNode.child_in_list(properties, i)
            set i: i + 1
            if row = null
                continue
            let prop row as ref[AstNode]
            let sym AstNode.symbol_of(prop)
            if sym = null
                continue
            let name Symbol.name_of(sym as ref[Symbol])
            let pk AstNode.kind_of(prop)
            var eligible false
            if jsx
            {
                if pk = KindJsxAttribute
                {
                    if AstNode.initializer_of(prop) = null
                        set eligible: true
                    else
                    {
                        if this.is_possibly_discriminant_value(AstNode.initializer_of(prop))
                            set eligible: true
                    }
                }
            }
            else
            {
                if pk = KindPropertyAssignment
                {
                    if this.is_possibly_discriminant_value(AstNode.initializer_of(prop))
                        set eligible: true
                }
                if pk = KindShorthandPropertyAssignment
                    set eligible: true
            }
            if eligible = false
                continue
            if this.is_discriminant_property(contextual_type, name) = false
                continue
            if this.unported_mark() <> mark
                return null
            out.add(prop)
        }
        out
    }

    ; The second `core.Filter` of both — the contextual type's OPTIONAL properties
    ; the literal does not carry. ★`children_name` and `element` are the JSX
    ; exemption and are empty/null for an object literal, which is how one
    ; function serves both without a flag.
    procedure collect_discriminant_members(this, node: ref[AstNode], contextual_type: ref[Type], children_name: Slice[char], element: ref[AstNode]?) returns ref[Array[ref[Symbol]?]]?
    {
        let mark this.unported_mark()
        let out &Array[ref[Symbol]?]^host()
        let node_symbol AstNode.symbol_of(node)
        if node_symbol = null
            return out
        let members_table Symbol.members_of(node_symbol as ref[Symbol])
        let props this.get_properties_of_type(contextual_type)
        if this.unported_mark() <> mark
            return null
        if props = null
            return out
        let list props as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let sm row as ref[Symbol]
            if (Symbol.flags_of(sm) & SymbolFlagsOptional) = 0
                continue
            let name Symbol.name_of(sm)
            if element <> null
            {
                if children_name.data <> null
                {
                    if SymbolTable.names_equal(name, children_name)
                    {
                        if AstNode.kind_of(element as ref[AstNode]) = KindJsxElement
                        {
                            ; `len(GetSemanticJsxChildren(element.Children().Nodes)) != 0`
                            ; — the COUNT reader ast.scaly already carries. ★NOT
                            ; parent_has_semantic_jsx_children: that one takes the
                            ; OPENING element and climbs, and here the element is
                            ; already in hand.
                            if AstNode.semantic_jsx_child_count(AstNode.jsx_children_of(element as ref[AstNode])) <> 0
                                continue
                        }
                    }
                }
            }
            if SymbolTable.get(members_table, name) <> null
                continue
            if this.is_discriminant_property(contextual_type, name) = false
                continue
            if this.unported_mark() <> mark
                return null
            out.add(sm)
        }
        out
    }

    ; getMatchingUnionConstituentForObjectLiteral — the KEY-property route, the
    ; object-literal twin of get_matching_union_constituent_for_type.
    procedure get_matching_union_constituent_for_object_literal(this, union_type: ref[Type], node: ref[AstNode]) returns ref[Type]?
    {
        var key_data Slice[char]()
        if this.get_key_property_name(union_type, &key_data) = false
            return null
        if key_data.data = null
            return null
        let mark this.unported_mark()
        let properties AstNode.properties_of(node)
        let count AstNode.list_count(properties)
        var i 0
        while i < count
        {
            let row AstNode.child_in_list(properties, i)
            set i: i + 1
            if row = null
                continue
            let prop row as ref[AstNode]
            if AstNode.kind_of(prop) <> KindPropertyAssignment
                continue
            let sym AstNode.symbol_of(prop)
            if sym = null
                continue
            if SymbolTable.names_equal(Symbol.name_of(sym as ref[Symbol]), key_data) = false
                continue
            if this.is_possibly_discriminant_value(AstNode.initializer_of(prop)) = false
                continue
            let initial AstNode.initializer_of(prop)
            if initial = null
                continue
            let prop_type this.get_context_free_type_of_expression(initial as ref[AstNode])
            if this.unported_mark() <> mark
                return null
            if prop_type = null
                return null
            return this.get_constituent_type_for_key_type(union_type, prop_type as ref[Type])
        }
        null
    }

    ; getMatchingUnionConstituentForType — the key-property route, whole.
    procedure get_matching_union_constituent_for_type(this, union_type: ref[Type], t: ref[Type]) returns ref[Type]?
    {
        var key_data Slice[char]()
        if this.get_key_property_name(union_type, &key_data) = false
            return null
        let prop_type this.get_type_of_property_of_type(t, key_data)
        if prop_type = null
            return null
        this.get_constituent_type_for_key_type(union_type, prop_type as ref[Type])
    }

    ; filterPrimitivesIfContainsNonPrimitive — `filterType(u, isNonPrimitiveType)`
    ; under a guard, and the guard is what keeps it the identity for every union
    ; that has no `object` constituent.
    procedure filter_primitives_if_contains_non_primitive(this, union_type: ref[Type]) returns ref[Type]?
    {
        if Checker.maybe_type_of_kind(union_type, TypeFlagsNonPrimitive) = false
            return union_type
        let result this.filter_type_outside_flags(union_type, TypeFlagsPrimitive)
        if result = null
            return union_type
        if (((result as ref[Type]).flags) & TypeFlagsNever) <> 0
            return union_type
        result
    }

    ; ── slice 130: the DISCRIMINATED-UNION relation ─────────────────────────
    ;
    ; typeRelatedToDiscriminatedType, whole, and it is the one comparison in the
    ; relation that is not structural.
    ;
    ; ★★★ WHAT IT DOES, IN ONE SENTENCE: an object source against a UNION target
    ; is related when every COMBINATION of the source's discriminant property
    ; values matches at least one constituent of the union, and the matched
    ; constituents' remaining properties relate structurally. `{ kind: "a" | "b",
    ; v: number }` against `{ kind: "a", v: number } | { kind: "b", v: number }`
    ; is the shape: neither constituent takes the source on its own, and the
    ; ordinary property loop therefore answers false.
    ;
    ; ★★★ THE COMBINATION LIMIT OF 25 IS A CORRECTNESS CONDITION AND NOT A BUDGET.
    ; The cartesian product is built EAGERLY, so past the limit the reference
    ; answers `false` — a real answer that a program can depend on, not a
    ; timeout — and the port must answer it at the same threshold or diverge on
    ; exactly the inputs written to sit near it.
    ;
    ; ★ Its two `Ternary` folds are `&=` over a boolean here for the reason the
    ; rest of this chapter is a boolean: this port carries no Maybe.
    procedure type_related_to_discriminated_type(this, source: ref[Type], target: ref[Type], relation: int, intersection_state: int) returns bool
    {
        let mark this.unported_mark()
        let source_properties this.get_properties_of_type(source)
        if this.unported_mark() <> mark
            return false
        let filtered this.find_discriminant_properties(source_properties, target)
        if this.unported_mark() <> mark
            return false
        if filtered = null
            return false
        let props filtered as ref[Array[ref[Symbol]?]]
        let np props.get_length() as int
        if np = 0
            return false
        ; The combination count, computed BEFORE any allocation — the reference's
        ; own reason, and the reason the loop is separate from the one below.
        var num_combinations 1
        var i 0
        while i < np
        {
            let row props[i]
            if row = null
                return false
            let pt this.get_non_missing_type_of_symbol(row as ref[Symbol])
            if pt = null
                return false
            set num_combinations: num_combinations * (this.distributed_types(pt as ref[Type]).get_length() as int)
            if num_combinations > 25
                return false
            if num_combinations = 0
                return false
            set i: i + 1
        }
        ; The per-property discriminant type lists, and the excluded-property set,
        ; which is the same walk.
        let discriminant_types &Array[ref[Array[ref[Type]?]]?]^host()
        set i: 0
        while i < np
        {
            let row props[i]
            if row = null
                return false
            let pt this.get_non_missing_type_of_symbol(row as ref[Symbol])
            if pt = null
                return false
            discriminant_types.add(this.distributed_types(pt as ref[Type]))
            set i: i + 1
        }
        let target_types Checker.union_types_of(target)
        if target_types = null
            return false
        let tlist target_types as ref[Array[ref[Type]?]]
        let tn tlist.get_length() as int
        let matching &Array[ref[Type]?]^host()
        var combination_index 0
        while combination_index < num_combinations
        {
            var has_match false
            var ti 0
            while ti < tn
            {
                let trow tlist[ti]
                set ti: ti + 1
                if trow = null
                    continue
                let t trow as ref[Type]
                var all_related true
                var pi 0
                while pi < np
                {
                    let srow props[pi]
                    if srow = null
                    {
                        set all_related: false
                        set pi: np
                        continue
                    }
                    let sp srow as ref[Symbol]
                    let tp this.get_property_of_type(t, Symbol.name_of(sp))
                    if this.unported_mark() <> mark
                        return false
                    if tp = null
                    {
                        set all_related: false
                        set pi: np
                        continue
                    }
                    let tps tp as ref[Symbol]
                    if tps = sp
                    {
                        set pi: pi + 1
                        continue
                    }
                    ; The combination's entry for THIS property — the cartesian
                    ; product read positionally rather than materialised, which is
                    ; the same product: index `combination_index` picks
                    ; `n % length` at each position walking from the last to the
                    ; first, exactly as the reference builds its rows.
                    let pick Checker.combination_entry(discriminant_types, combination_index, pi)
                    if pick = null
                    {
                        set all_related: false
                        set pi: np
                        continue
                    }
                    var skip_optional false
                    if Checker.strict_null_checks()
                        set skip_optional: true
                    if relation = RelationComparable
                        set skip_optional: true
                    if this.property_related_to_ex(source, target, sp, tps, relation, null, IntersectionStateNone, pick, true, skip_optional) = false
                    {
                        set all_related: false
                        set pi: np
                        continue
                    }
                    set pi: pi + 1
                }
                if all_related
                {
                    if Checker.type_list_contains(matching, t) = false
                        matching.add(t)
                    set has_match: true
                }
            }
            if has_match = false
                return false
            set combination_index: combination_index + 1
        }
        ; The remaining, non-discriminant properties of each match.
        let mn matching.get_length() as int
        var mi 0
        while mi < mn
        {
            let mrow matching[mi]
            set mi: mi + 1
            if mrow = null
                continue
            let t mrow as ref[Type]
            if this.properties_related_to_ex(source, t, relation, null, false, IntersectionStateNone, props) = false
                return false
            if this.signatures_related_to(source, t, SignatureKindCall, relation, null, IntersectionStateNone) = false
                return false
            if this.signatures_related_to(source, t, SignatureKindConstruct, relation, null, IntersectionStateNone) = false
                return false
            var both_tuples false
            if Checker.is_tuple_type(source)
            {
                if Checker.is_tuple_type(t)
                    set both_tuples: true
            }
            if both_tuples = false
            {
                if this.index_signatures_related_to(source, t, false, relation, null, IntersectionStateNone) = false
                    return false
            }
        }
        true
    }

    ; The cartesian product's entry, read rather than materialised — see the
    ; caller. `n` walks from the LAST position to the first, dividing out each
    ; position's length as it goes, which is the reference's own inner loop.
    function combination_entry(lists: ref[Array[ref[Array[ref[Type]?]]?]], index: int, position: int) returns ref[Type]?
    {
        var n index
        let count lists.get_length() as int
        var j count - 1
        while j >= 0
        {
            let row lists[j]
            if row = null
                return null
            let list row as ref[Array[ref[Type]?]]
            let length list.get_length() as int
            if length = 0
                return null
            if j = position
                return list[n % length]
            set n: n / length
            set j: j - 1
        }
        null
    }

    ; The `excludedProperties` membership test — a `collections.Set[string]`
    ; upstream, a name comparison over the source-property list here.
    ; `excludedProperties.Has(strconv.Itoa(sourcePosition))`: does the list carry a symbol
    ; whose name is exactly the decimal spelling of `index`
    function symbol_list_has_index(list: ref[Array[ref[Symbol]?]], index: int) returns bool
    {
        let n list.get_length() as int
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            if Checker.name_as_index(Symbol.name_of(row as ref[Symbol])) = index
                return true
        }
        false
    }

    ; the value of a name made of decimal digits only (no sign, no leading zero unless it
    ; is "0" itself), -1 for anything else
    function name_as_index(name: Slice[char]) returns int
    {
        let n name.length as int
        if n = 0
            return 0 - 1
        if n > 1
        {
            if name[0] = ("0" as char)
                return 0 - 1
        }
        var value 0
        var i 0
        while i < n
        {
            let c name[i] as int
            if c < (("0" as char) as int)
                return 0 - 1
            if c > (("9" as char) as int)
                return 0 - 1
            set value: value * 10 + (c - (("0" as char) as int))
            set i: i + 1
        }
        value
    }

    function symbol_list_contains_name(list: ref[Array[ref[Symbol]?]]?, sym: ref[Symbol]) returns bool
    {
        if list = null
            return false
        let l list as ref[Array[ref[Symbol]?]]
        let n l.get_length() as int
        var i 0
        while i < n
        {
            let row l[i]
            if row <> null
            {
                let s row as ref[Symbol]
                if Checker.symbol_name_matches(s, Symbol.name_of(sym))
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; findDiscriminantProperties — the source properties the TARGET union treats
    ; as discriminants. `isDiscriminantProperty` is already here (it is the flow
    ; chapter's), so this is its list form.
    procedure find_discriminant_properties(this, source_properties: ref[Array[ref[Symbol]?]]?, target: ref[Type]) returns ref[Array[ref[Symbol]?]]?
    {
        if source_properties = null
            return null
        let list source_properties as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        let out &Array[ref[Symbol]?]^host()
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let sp row as ref[Symbol]
                if this.is_discriminant_property(target, Symbol.name_of(sp))
                    out.add(sp)
            }
            set i: i + 1
        }
        out
    }

    ; propertiesRelatedTo's ARRAY-OR-TUPLE-source half against a tuple target.
    ;
    ; ★It is a function of its own rather than a block because the reference's arm
    ; RETURNS from four places before the per-position loop, and inlining it would
    ; put four early exits inside a function that already has the ordinary property
    ; walk below them.
    ;
    ; ★★`excluded_properties` is not threaded in: upstream's `canExcludeDiscriminants`
    ; is `excludedProperties.Len() != 0`, and the only caller that passes a non-empty
    ; set is type_related_to_discriminated_type, whose source is an object literal
    ; and never an array or a tuple.
    procedure tuple_properties_related_to(this, source: ref[Type], target: ref[Type], tt: ref[Type], relation: int, error_node: ref[AstNode]?, intersection_state: int, excluded_properties: ref[Array[ref[Symbol]?]]?) returns bool
    {
        let mark this.unported_mark()
        let source_is_tuple Checker.is_tuple_type(source)
        var source_tt: ref[Type]? null
        if source_is_tuple
        {
            set source_tt: Checker.target_of(source)
            if source_tt = null
                return false
        }
        ; A readonly source cannot satisfy a mutable tuple target.
        if Checker.tuple_readonly_of(tt) = false
        {
            var readonly_source this.is_readonly_array_type(source)
            if source_is_tuple
            {
                if Checker.tuple_readonly_of(source_tt as ref[Type])
                    set readonly_source: true
            }
            if this.unported_mark() <> mark
                return false
            if readonly_source
                return false
        }
        let source_arity Checker.get_type_reference_arity(source)
        let target_arity Checker.get_type_reference_arity(target)
        var source_rest true
        var source_min_length 0
        if source_is_tuple
        {
            let stt source_tt as ref[Type]
            set source_rest: (Checker.tuple_combined_flags_of(stt) & ElementFlagsRest) <> 0
            set source_min_length: Checker.tuple_min_length_of(stt)
        }
        let target_has_rest_element (Checker.tuple_combined_flags_of(tt) & ElementFlagsVariable) <> 0
        let target_min_length Checker.tuple_min_length_of(tt)
        if source_rest = false
        {
            if source_arity < target_min_length
                return false
        }
        if target_has_rest_element = false
        {
            if target_arity < source_min_length
                return false
            var too_many source_rest
            if target_arity < source_arity
                set too_many: true
            if too_many
                return false
        }
        let source_args this.get_type_arguments(source)
        if this.unported_mark() <> mark
            return false
        let target_args this.get_type_arguments(target)
        if this.unported_mark() <> mark
            return false
        if source_args = null
            return false
        if target_args = null
            return false
        let sargs source_args as ref[Array[ref[Type]?]]
        let targs target_args as ref[Array[ref[Type]?]]
        let target_start_count Checker.get_start_element_count(tt, ElementFlagsNonRest)
        let target_end_count Checker.get_end_element_count(tt, ElementFlagsNonRest)
        let target_infos Checker.tuple_element_infos_of(tt)
        if target_infos = null
            return false
        let tinfos target_infos as ref[Array[ref[TupleElementInfo]?]]
        var source_infos: ref[Array[ref[TupleElementInfo]?]]? null
        if source_is_tuple
        {
            let si Checker.tuple_element_infos_of(source_tt as ref[Type])
            if si = null
                return false
            set source_infos: si
        }
        ; `canExcludeDiscriminants := excludedProperties.Len() != 0` — the discriminated-union
        ; walk hands the discriminant positions in, and a tuple's discriminants are its
        ; ELEMENTS ("0", "1", …), excluded by position until a variable-length element
        var can_exclude false
        if excluded_properties <> null
        {
            if ((excluded_properties as ref[Array[ref[Symbol]?]]).get_length() as int) <> 0
                set can_exclude: true
        }
        var sp 0
        while sp < source_arity
        {
            var source_flags ElementFlagsRest
            if source_is_tuple
                set source_flags: Checker.tuple_info_flags_at(source_infos as ref[Array[ref[TupleElementInfo]?]], sp)
            let sp_from_end source_arity - 1 - sp
            var tp sp
            if target_has_rest_element
            {
                if sp >= target_start_count
                {
                    var back sp_from_end
                    if target_end_count < back
                        set back: target_end_count
                    set tp: target_arity - 1 - back
                }
            }
            var target_flags 0
            if tp >= 0
                set target_flags: Checker.tuple_info_flags_at(tinfos, tp)
            ; A variadic target element needs a variadic source element; a variadic
            ; SOURCE element needs a variable-length target one; a required target
            ; element needs a required source one.
            if (target_flags & ElementFlagsVariadic) <> 0
            {
                if (source_flags & ElementFlagsVariadic) = 0
                    return false
            }
            if (source_flags & ElementFlagsVariadic) <> 0
            {
                if (target_flags & ElementFlagsVariable) = 0
                    return false
            }
            if (target_flags & ElementFlagsRequired) <> 0
            {
                if (source_flags & ElementFlagsRequired) = 0
                    return false
            }
            if can_exclude
            {
                if (source_flags & ElementFlagsVariable) <> 0
                    set can_exclude: false
                if (target_flags & ElementFlagsVariable) <> 0
                    set can_exclude: false
                if can_exclude
                {
                    if Checker.symbol_list_has_index(excluded_properties as ref[Array[ref[Symbol]?]], sp)
                    {
                        set sp: sp + 1
                        continue
                    }
                }
            }
            if sp >= (sargs.get_length() as int)
                return false
            if tp < 0
                return false
            if tp >= (targs.get_length() as int)
                return false
            let sa sargs[sp]
            let ta targs[tp]
            if sa = null
                return false
            if ta = null
                return false
            let source_type this.remove_missing_type(sa as ref[Type], (source_flags & target_flags & ElementFlagsOptional) <> 0)
            if this.unported_mark() <> mark
                return false
            if source_type = null
                return false
            var target_check: ref[Type]? null
            var spread false
            if (source_flags & ElementFlagsVariadic) <> 0
            {
                if (target_flags & ElementFlagsRest) <> 0
                    set spread: true
            }
            if spread
                set target_check: this.create_array_type(ta as ref[Type])
            else
                set target_check: this.remove_missing_type(ta as ref[Type], (target_flags & ElementFlagsOptional) <> 0)
            if this.unported_mark() <> mark
                return false
            if target_check = null
                return false
            if this.is_related_to_ex(source_type as ref[Type], target_check as ref[Type], relation, error_node, intersection_state, RecursionFlagsBoth) = false
                return false
            if this.unported_mark() <> mark
                return false
            set sp: sp + 1
        }
        true
    }

    ; ★★★ `excluded_properties` AND `property_related_to`'s TYPE OVERRIDE ARE THE
    ; DISCRIMINATED WALK'S TWO ADDITIONS, and both were dropped from the earlier
    ; signature because the walk was a stop. The reference passes an EMPTY SET and
    ; a nil callback at every other call site, so both are null here for everyone
    ; but type_related_to_discriminated_type — and the exclusion is by NAME, which
    ; is what the upstream `collections.Set[string]` is.
    procedure properties_related_to(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, optionals_only: bool, intersection_state: int) returns bool
        this.properties_related_to_ex(source, target, relation, error_node, optionals_only, intersection_state, null)

    procedure properties_related_to_ex(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, optionals_only: bool, intersection_state: int, excluded_properties: ref[Array[ref[Symbol]?]]?) returns bool
    {
        ; propertiesIdenticalTo, ported in slice 126. ★★★It was slice 117's TS2403
        ; wall and the stop stood here rather than in is_related_to_ex, which is
        ; what made it findable: the stop named the thing that was missing rather
        ; than the door it came through.
        if relation = RelationIdentity
            return this.properties_identical_to(source, target, relation)
        ; ── the TUPLE-target arm, slice 143 ─────────────────────────────
        ;
        ; ★★★ NONE OF ITS EIGHT `reportError` CALLS IS PORTED AND THAT IS THE
        ; DESIGN, not an omission: `Relater.reportError` accumulates into the
        ; message CHAIN, which `checkTypeRelatedTo` turns into ONE diagnostic at
        ; the end under the OUTER code. The three unmatched-property codes are the
        ; only chain entries this port has a reader for (`rel_unmatched_code`), and
        ; none of these eight is one of them — see the field's own note and §3.24.
        ;
        ; ★★ THE POSITION MAPPING IS THE CHAPTER. A target with a variable-length
        ; element matches the source's LEADING elements head-on and its TRAILING
        ; ones from the end, so a source position past the target's fixed head is
        ; measured backwards — which is how `[a, ...b[], c]` accepts a source of
        ; any arity between the two fixed counts.
        if Checker.is_tuple_type(target)
        {
            let tuple_target Checker.target_of(target)
            if tuple_target = null
                return false
            let tt tuple_target as ref[Type]
            if this.is_array_or_tuple_type(source)
                return this.tuple_properties_related_to(source, target, tt, relation, error_node, intersection_state, excluded_properties)
            ; A non-array source against a target with a rest or variadic element
            ; is unrelated outright; a FIXED tuple target falls through to the
            ; ordinary property walk, which is how `{0: A, length: 1}` relates.
            if (Checker.tuple_combined_flags_of(tt) & ElementFlagsVariable) <> 0
                return false
        }
        var require_optional_properties false
        var subtypeish false
        if relation = RelationSubtype
            set subtypeish: true
        if relation = RelationStrictSubtype
            set subtypeish: true
        if subtypeish
        {
            set require_optional_properties: true
            if Checker.is_object_literal_type(source)
                set require_optional_properties: false
            if this.is_empty_array_literal_type(source)
                set require_optional_properties: false
            if Checker.is_tuple_type(source)
                set require_optional_properties: false
        }
        let unmatched this.get_unmatched_property(source, target, require_optional_properties)
        if unmatched <> null
        {
            ; `if reportErrors && shouldReportUnmatchedPropertyError` — and the
            ; recording is worth nothing without the error node, because the
            ; suppression fork it feeds runs only where a report is emitted.
            if error_node <> null
            {
                var ok false
                if this.should_report_unmatched_property_error(source, target, &ok)
                {
                    if ok
                        this.report_unmatched_property(source, target, unmatched as ref[Symbol], require_optional_properties)
                }
            }
            return false
        }
        ; The object-literal TARGET arm: a source property the target does not
        ; declare at all.
        if Checker.is_object_literal_type(target)
        {
            ; ★★★ A NULL LIST IS AN EMPTY ONE HERE, AND READING IT AS A FAILURE
            ; MADE `let o = {}` UNRELATED TO ITS OWN WIDENED TYPE. The three list
            ; accessors — get_properties_of_type, get_signatures_of_type,
            ; get_index_infos_of_type — all end in a slot of `StructuredMembers`
            ; that is NULL when the type has none of that member kind, so their
            ; null carries two meanings and only the MARK separates them. It is
            ; §3.5's *a nil that means two things*, in the one chapter where every
            ; reader is a loop that must run zero times.
            let sprops this.get_properties_of_type(source)
            if sprops <> null
            {
                let slist sprops as ref[Array[ref[Symbol]?]]
                let sn slist.get_length() as int
                var si 0
                while si < sn
                {
                    let row slist[si]
                    if row <> null
                    {
                        let sp row as ref[Symbol]
                        let mark this.unported_mark()
                        let found this.get_property_of_object_type(target, Symbol.name_of(sp))
                        if this.unported_mark() <> mark
                            return false
                        if found = null
                            return false
                    }
                    set si: si + 1
                }
            }
        }
        let props this.get_properties_of_type(target)
        if props = null
            return true
        let list props as ref[Array[ref[Symbol]?]]
        let n list.get_length() as int
        ; numericNamesOnly needs a tuple on BOTH sides and both are reported above.
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let tp row as ref[Symbol]
                var ask true
                if (Symbol.flags_of(tp) & SymbolFlagsPrototype) <> 0
                    set ask: false
                if Checker.symbol_list_contains_name(excluded_properties, tp)
                    set ask: false
                if optionals_only
                {
                    if (Symbol.flags_of(tp) & SymbolFlagsOptional) = 0
                        set ask: false
                }
                if ask
                {
                    let mark this.unported_mark()
                    let sp this.get_property_of_type(source, Symbol.name_of(tp))
                    if this.unported_mark() <> mark
                        return false
                    if sp <> null
                    {
                        if (sp as ref[Symbol]) <> tp
                        {
                            if this.property_related_to(source, target, sp as ref[Symbol], tp, relation, error_node, intersection_state) = false
                                return false
                        }
                    }
                }
            }
            set i: i + 1
        }
        true
    }

    ; propertyRelatedTo — the three visibility arms, the readonly rule and the
    ; optionality rule. Report-free for the worker's reason.
    procedure property_related_to(this, source: ref[Type], target: ref[Type], source_prop: ref[Symbol], target_prop: ref[Symbol], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
        this.property_related_to_ex(source, target, source_prop, target_prop, relation, error_node, intersection_state, null, false, false)

    ; ★★★ `source_type_override` IS THE `getTypeOfSourceProperty` CALLBACK, and it
    ; is the whole reason the discriminated walk can ask a question the ordinary
    ; relation cannot: *is the source property related to the target's, IN THE
    ; CONTEXT OF ONE DISCRIMINANT TYPE* — the combination's entry, not the source
    ; property's own (possibly union) type. Every other caller passes nil and gets
    ; get_non_missing_type_of_symbol, which is what the callback defaults to.
    ;
    ; ★ `skip_optional` is the reference's last argument, true exactly for the
    ; discriminated walk under strictNullChecks or the comparable relation. It
    ; short-circuits the optionality rule at the tail, which would otherwise
    ; refuse a match on a property the combination has already pinned.
    procedure property_related_to_ex(this, source: ref[Type], target: ref[Type], source_prop: ref[Symbol], target_prop: ref[Symbol], relation: int, error_node: ref[AstNode]?, intersection_state: int, source_type_override: ref[Type]?, has_override: bool, skip_optional: bool) returns bool
    {
        let source_flags this.get_declaration_modifier_flags_from_symbol(source_prop)
        let target_flags this.get_declaration_modifier_flags_from_symbol(target_prop)
        var private_side false
        if (source_flags & ModifierFlagsPrivate) <> 0
            set private_side: true
        if (target_flags & ModifierFlagsPrivate) <> 0
            set private_side: true
        if private_side
        {
            if Symbol.value_declaration_of(source_prop) <> Symbol.value_declaration_of(target_prop)
                return false
        }
        ; ★★★ THE TWO PROTECTED ARMS ARE AN `else if` CHAIN UPSTREAM, AND THE
        ; DIFFERENCE WAS INVISIBLE UNTIL SLICE 174. While the first arm was a stop
        ; it always returned, so the second could not be reached with a protected
        ; TARGET; written as two flat `if`s it then fired on every valid override
        ; whose source is protected too — `class C2 extends C1` with `protected f`
        ; on both became TS2415. A guard's reachability is part of what a stop
        ; hides (§3.5gc's rule, one level down).
        if private_side = false
        {
            if (target_flags & ModifierFlagsProtected) <> 0
            {
                ; isValidOverrideOf (slice 174). The note that stopped here named
                ; getDeclaringClass and the class-derivation walk as missing; both
                ; had landed with is_class_derived_from_declaring_classes, which is
                ; the same walk one predicate over.
                if this.is_valid_override_of(source_prop, target_prop) = false
                    return false
            }
            if (target_flags & ModifierFlagsProtected) = 0
            {
                if (source_flags & ModifierFlagsProtected) <> 0
                    return false
            }
        }
        if relation = RelationStrictSubtype
        {
            if this.is_readonly_symbol(source_prop)
            {
                if this.is_readonly_symbol(target_prop) = false
                    return false
            }
        }
        if this.is_property_symbol_type_related_ex(source_prop, target_prop, relation, error_node, intersection_state, source_type_override, has_override) = false
        {
            if error_node <> null
                this.report_error(DiagTypes_of_property_0_are_incompatible, null, null, this.symbol_arg(target_prop))
            return false
        }
        ; The comparable relation is lenient about an optional source property;
        ; every other relation is not.
        if skip_optional
            return true
        if relation = RelationComparable
            return true
        if (Symbol.flags_of(source_prop) & SymbolFlagsOptional) = 0
            return true
        if (Symbol.flags_of(target_prop) & SymbolFlagsClassMember) = 0
            return true
        if (Symbol.flags_of(target_prop) & SymbolFlagsOptional) <> 0
            return true
        if error_node <> null
            this.report_error(DiagProperty_0_is_optional_in_type_1_but_required_in_type_2, source, target, this.symbol_arg(target_prop), this.type_arg(source), this.type_arg(target))
        false
    }

    ; isPropertySymbolTypeRelated.
    ;
    ; ★`targetIsOptional` needs CheckFlagsPartial, which is set only by
    ; `getPropertyOfUnionOrIntersectionType` — unported — so it is false here and
    ; `addOptionalityEx` is called with the reference's other two arguments
    ; unchanged rather than dropped, because the call is what documents which two.
    procedure is_property_symbol_type_related(this, source_prop: ref[Symbol], target_prop: ref[Symbol], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
        this.is_property_symbol_type_related_ex(source_prop, target_prop, relation, error_node, intersection_state, null, false)

    procedure is_property_symbol_type_related_ex(this, source_prop: ref[Symbol], target_prop: ref[Symbol], relation: int, error_node: ref[AstNode]?, intersection_state: int, source_type_override: ref[Type]?, has_override: bool) returns bool
    {
        let tmt this.get_non_missing_type_of_symbol(target_prop)
        if tmt = null
            return false
        let effective_target this.add_optionality_ex(tmt as ref[Type], false, false)
        if effective_target = null
            return false
        let et effective_target as ref[Type]
        var any_mask TypeFlagsAnyOrUnknown
        if relation = RelationStrictSubtype
            set any_mask: TypeFlagsAny
        if (et.flags & any_mask) <> 0
            return true
        var est: ref[Type]? null
        if has_override
            set est: source_type_override
        if has_override = false
            set est: this.get_non_missing_type_of_symbol(source_prop)
        if est = null
            return false
        ; ★The error node IS forwarded since slice 288, as upstream forwards
        ; `reportErrors`: the row under `Types of property '0' are incompatible`
        ; is the nested relation's own report, and without it the chain stops one
        ; level short of what a baseline prints.
        this.is_related_to_ex(est as ref[Type], et, relation, error_node, intersection_state, RecursionFlagsBoth)
    }

    ; ── slice 126: the SIGNATURE relation ───────────────────────────────
    ;
    ; signaturesRelatedTo, whole but for the two `anyFunctionType` tests, which
    ; have no input: this port mints no such marker.
    ;
    ; ★★★ THE THREE ARMS ARE A DISPATCH ON HOW THE TWO LISTS LINE UP, not three
    ; different relations. The PAIRWISE arm is two instantiations of ONE anonymous
    ; type, or two references to one target, where the reference erases the type
    ; parameters because they are known to be the same and compares position by
    ; position; the SINGLE arm is the ordinary function-to-function case and erases
    ; only for the comparable relation; the N×M arm is the overload matrix. ★The
    ; empty-target reading the stub carried is still exactly right and is now the
    ; loop running zero times rather than a special case.
    ;
    ; ★★★ EVERY REPORT IN THIS CHAPTER IS A CHAIN LINK AND IS DROPPED, on the
    ; worker's rule: `Relater.reportError` appends to `errorInfo` and
    ; report_relation_error emits ONE diagnostic whose CODE is the head, so a link
    ; carries neither a code nor a span of its own and is invisible in a dump in
    ; both directions. That covers all three of this chapter's — *Cannot assign an
    ; abstract constructor type to a non-abstract constructor type*, *Cannot assign
    ; a 0 constructor type to a 1 constructor type* and *Type 0 provides no match
    ; for the signature 1*. ★★★`getErrorState`/`restoreErrorState` and
    ; `shouldElaborateErrors` DO NOT drop out of the N×M arm, and the note that said
    ; they did — *all three are chain plumbing and this port has no chain* — expired
    ; at slice 167. A target signature that matches its SECOND source candidate
    ; leaves the first one's report standing, and the relation emits on a non-empty
    ; chain whatever its verdict; the two are written in the loop.
    procedure signatures_related_to(this, source: ref[Type], target: ref[Type], kind: int, relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        if relation = RelationIdentity
            return this.signatures_identical_to(source, target, kind, relation)
        ; ★★★ THE TWO WILDCARD LINES ARE HERE SINCE SLICE 164, AND WHAT MADE THEM
        ; SAFE WAS THE OTHER DOOR RATHER THAN ANYTHING IN THIS FUNCTION. The note
        ; that stood here priced their omission at **28 stage-2 units MATCH → FAIL**
        ; (slice 159, bisected to the FIRST line) and named the cause exactly:
        ; *the missing line was COMPENSATING FOR A MISSING CHAPTER* — upstream
        ; RE-DERIVES a skipped context-sensitive argument in `chooseOverload`'s
        ; second round, and this port could not. It closed the note with **"the line
        ; comes back the day the second round re-derives a context-sensitive
        ; argument — the same day `skipped-generic-function-marker` closes"**, and
        ; that is this slice: the marker's arm, this pair, and
        ; `contextually_check_function_expression_or_object_literal_method`'s
        ; inference block, which is where the re-derivation actually happens.
        ;
        ; ★★★ AND THE 28 WERE NOT A PROPERTY OF THIS LINE. Measured again with the
        ; marker minted and the re-derivation written, the pair costs NOTHING and
        ; the three rows move together (+92 units at stage 2). ★A price measured on
        ; a tree missing the other half of one chapter is a price for THAT TREE —
        ; slice 159 said so in its own words and the number still read as a
        ; property of the line.
        ;
        ; "With respect to signatures, the anyFunctionType wildcard is a subtype of
        ; every other function type."
        if source = any_function_type
            return true
        if target = any_function_type
            return false
        let mark this.unported_mark()
        let ss this.get_signatures_of_type(source, kind)
        let ts this.get_signatures_of_type(target, kind)
        if this.unported_mark() <> mark
            return false
        var sn 0
        if ss <> null
            set sn: (ss as ref[Array[ref[Signature]?]]).get_length() as int
        var tn 0
        if ts <> null
            set tn: (ts as ref[Array[ref[Signature]?]]).get_length() as int
        if tn = 0
            return true
        let tlist ts as ref[Array[ref[Signature]?]]
        ; The abstract-constructor rule and the constructor visibilities, both of
        ; which need BOTH lists non-empty.
        if kind = SignatureKindConstruct
        {
            if sn <> 0
            {
                let s0row (ss as ref[Array[ref[Signature]?]])[0]
                let t0row tlist[0]
                if s0row <> null
                {
                    if t0row <> null
                    {
                        let s0 s0row as ref[Signature]
                        let t0 t0row as ref[Signature]
                        if (s0.flags & SignatureFlagsAbstract) <> 0
                        {
                            if (t0.flags & SignatureFlagsAbstract) = 0
                                return false
                        }
                        if this.constructor_visibilities_are_compatible(s0, t0) = false
                            return false
                    }
                }
            }
        }
        ; ★ Two instantiations of one anonymous type (typically a METHOD's type), or
        ; two references to one generic target.
        var pairwise false
        if (source.object_flags & ObjectFlagsInstantiated) <> 0
        {
            if (target.object_flags & ObjectFlagsInstantiated) <> 0
            {
                if source.symbol = target.symbol
                    set pairwise: true
            }
        }
        if pairwise = false
        {
            if (source.object_flags & ObjectFlagsReference) <> 0
            {
                if (target.object_flags & ObjectFlagsReference) <> 0
                {
                    if Checker.target_of(source) = Checker.target_of(target)
                        set pairwise: true
                }
            }
        }
        if pairwise
        {
            ; ★★ The reference indexes the SOURCE list with the TARGET's index and
            ; relies on the two being parallel — a shorter source list is an
            ; out-of-range PANIC there, so it cannot arise. Here it would be an
            ; exit 15, which takes the unit's six dumps with it, so the shape is
            ; marked unanswered instead of trapped or silently answered false.
            if sn < tn
            {
                this.record_unported("signatures-related-pairwise-arity", tn)
                return false
            }
            let slist ss as ref[Array[ref[Signature]?]]
            var i 0
            while i < tn
            {
                let srow slist[i]
                let trow tlist[i]
                if srow = null
                    return false
                if trow = null
                    return false
                if this.signature_related_to(srow as ref[Signature], trow as ref[Signature], true, relation, error_node, intersection_state) = false
                    return false
                set i: i + 1
            }
            return true
        }
        if sn = 1
        {
            if tn = 1
            {
                let srow (ss as ref[Array[ref[Signature]?]])[0]
                let trow tlist[0]
                if srow = null
                    return false
                if trow = null
                    return false
                ; For a single signature the type parameters are erased only for
                ; the comparable relation; otherwise a generic source is
                ; instantiated in the target's context, which is
                ; compare_signatures_related's own stop.
                var erase_generics false
                if relation = RelationComparable
                    set erase_generics: true
                return this.signature_related_to(srow as ref[Signature], trow as ref[Signature], erase_generics, relation, error_node, intersection_state)
            }
        }
        ; The N×M matrix: every target signature needs SOME source signature.
        var ti 0
        while ti < tn
        {
            let trow tlist[ti]
            if trow = null
                return false
            let t trow as ref[Signature]
            ; ★★★ THE PER-TARGET ERROR STATE, SLICE 168 — `saveErrorState` is taken
            ; INSIDE this loop upstream and restored on the source that matches, so
            ; the failed attempts in front of it leave nothing behind. The other
            ; half, `shouldElaborateErrors`, is the reference's *only elaborate
            ; errors from the first failure*: every later source is compared with no
            ; error node at all.
            let save_chain rel_error_chain
            var elaborate error_node
            var matched false
            var si 0
            while si < sn
            {
                let srow (ss as ref[Array[ref[Signature]?]])[si]
                if srow <> null
                {
                    if this.signature_related_to(srow as ref[Signature], t, true, relation, elaborate, intersection_state)
                        set matched: true
                }
                if matched
                {
                    set rel_error_chain: save_chain
                    break
                }
                set elaborate: null
                set si: si + 1
            }
            if matched = false
                return false
            set ti: ti + 1
        }
        true
    }

    ; constructorVisibilitiesAreCompatible, whole. Its report is a chain link and
    ; drops with `visibilityToString`, which existed only to name the two
    ; accessibilities in that message.
    function constructor_visibilities_are_compatible(this, source_signature: ref[Signature], target_signature: ref[Signature]) returns bool
    {
        if source_signature.declaration = null
            return true
        if target_signature.declaration = null
            return true
        ; ★ `node.ModifierFlags()` is the UNCOMBINED reading — see
        ; are_declaration_flags_identical's note.
        let sa b.modifier_flags(source_signature.declaration as ref[AstNode]) & ModifierFlagsNonPublicAccessibilityModifier
        let ta b.modifier_flags(target_signature.declaration as ref[AstNode]) & ModifierFlagsNonPublicAccessibilityModifier
        ; Public, protected and private are all assignable to private.
        if ta = ModifierFlagsPrivate
            return true
        ; Public and protected are assignable to protected.
        if ta = ModifierFlagsProtected
        {
            if sa <> ModifierFlagsPrivate
                return true
        }
        ; Only public is assignable to public.
        if ta <> ModifierFlagsProtected
        {
            if sa = 0
                return true
        }
        false
    }

    ; signatureRelatedTo — the check mode off the relation, the erasure, and the
    ; comparer. ★The reference builds a CLOSURE over the relation and over its own
    ; `intersectionState` here; the two cells carry both, which is what
    ; signature_related_to_core saves and restores.
    procedure signature_related_to(this, source: ref[Signature], target: ref[Signature], erase: bool, relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        var check_mode SignatureCheckModeNone
        if relation = RelationSubtype
            set check_mode: SignatureCheckModeStrictTopSignature
        if relation = RelationStrictSubtype
            set check_mode: SignatureCheckModeStrictTopSignature | SignatureCheckModeStrictArity
        if erase
        {
            let es this.get_erased_signature(source)
            if es = null
                return false
            let et this.get_erased_signature(target)
            if et = null
                return false
            return this.signature_related_to_core(es as ref[Signature], et as ref[Signature], check_mode, relation, intersection_state)
        }
        this.signature_related_to_core(source, target, check_mode, relation, intersection_state)
    }

    ; The call itself, split off so the erased and the unerased pair reach ONE
    ; save/restore of the two cells rather than two copies of it.
    procedure signature_related_to_core(this, source: ref[Signature], target: ref[Signature], check_mode: int, relation: int, intersection_state: int) returns bool
    {
        let save_relation rel_cur_relation
        let save_state rel_cur_intersection_state
        set rel_cur_relation: relation
        set rel_cur_intersection_state: intersection_state
        let answer this.compare_signatures_related_ex(source, target, check_mode, SignatureComparerRelaterWorker, rel_error_node <> null)
        set rel_cur_relation: save_relation
        set rel_cur_intersection_state: save_state
        answer
    }

    ; signaturesIdenticalTo — the identity relation's signature half. ★Its comparer
    ; is `isRelatedToSimple`, the relater's recursion at IntersectionStateNone, so
    ; the relation travels in the cell and the intersection state does not.
    procedure signatures_identical_to(this, source: ref[Type], target: ref[Type], kind: int, relation: int) returns bool
    {
        let mark this.unported_mark()
        let ss this.get_signatures_of_type(source, kind)
        let ts this.get_signatures_of_type(target, kind)
        if this.unported_mark() <> mark
            return false
        var sn 0
        if ss <> null
            set sn: (ss as ref[Array[ref[Signature]?]]).get_length() as int
        var tn 0
        if ts <> null
            set tn: (ts as ref[Array[ref[Signature]?]]).get_length() as int
        if sn <> tn
            return false
        if sn = 0
            return true
        let slist ss as ref[Array[ref[Signature]?]]
        let tlist ts as ref[Array[ref[Signature]?]]
        let save_relation rel_cur_relation
        set rel_cur_relation: relation
        var answer true
        var i 0
        while i < sn
        {
            let srow slist[i]
            let trow tlist[i]
            if srow = null
                set answer: false
            if trow = null
                set answer: false
            if answer
            {
                if this.compare_signatures_identical(srow as ref[Signature], trow as ref[Signature], false, false, false, SignatureComparerRelaterSimple) = false
                    set answer: false
            }
            if answer = false
                break
            set i: i + 1
        }
        set rel_cur_relation: save_relation
        answer
    }

    ; isMatchingSignature — the required/optional/rest arity match, and the
    ; partial one, which asks only that the target need no fewer arguments.
    procedure is_matching_signature(this, source: ref[Signature], target: ref[Signature], partial_match: bool) returns bool
    {
        let spc this.get_parameter_count(source)
        let tpc this.get_parameter_count(target)
        let smin this.get_min_argument_count(source)
        let tmin this.get_min_argument_count(target)
        let srest this.has_effective_rest_parameter(source)
        let trest this.has_effective_rest_parameter(target)
        if spc = tpc
        {
            if smin = tmin
            {
                if srest = trest
                    return true
            }
        }
        if partial_match
        {
            if smin <= tmin
                return true
        }
        false
    }

    ; getConstraintOrUnknownFromTypeParameter / getDefaultOrUnknownFromTypeParameter
    ; — the two `?? unknownType` readings compareSignaturesIdentical needs so that
    ; a parameter with no constraint compares equal to another with none.
    procedure get_constraint_or_unknown_from_type_parameter(this, t: ref[Type]) returns ref[Type]?
    {
        let r this.get_constraint_from_type_parameter(t)
        if r <> null
            return r
        unknown_type
    }

    procedure get_default_or_unknown_from_type_parameter(this, t: ref[Type]) returns ref[Type]?
    {
        let r this.get_default_from_type_parameter(t)
        if r <> null
            return r
        unknown_type
    }

    ; typePredicateKindsMatch, whole.
    function type_predicate_kinds_match(a: ref[TypePredicate], b: ref[TypePredicate]) returns bool
    {
        if a.kind <> b.kind
            return false
        a.parameter_index = b.parameter_index
    }

    ; getUnionOrIntersectionTypePredicate (slice 155) — the composite signature's
    ; own type predicate.
    ;
    ; ★★★ IT ANSWERS nil ON THE FIRST DISAGREEMENT, and there are three ways to
    ; disagree: a constituent with NO predicate, a predicate of a different KIND or
    ; parameter POSITION, and an ASSERTION (`asserts x is T`), which upstream
    ; excludes by name — a composite assertion would claim something no
    ; constituent claims.
    ;
    ; ★★ THE ONE TOLERATED ABSENCE IS A `false` RETURN, and only in a UNION.
    ; `(x: unknown) => x is T` unioned with `(x: unknown) => false` is still a
    ; guard, because the second arm never narrows. The test is against BOTH false
    ; types — the fresh literal and its regular twin — which is why the reference
    ; asks twice.
    procedure get_union_or_intersection_type_predicate(this, signatures: ref[Array[ref[Signature]?]]?, is_union: bool) returns ref[TypePredicate]?
    {
        if signatures = null
            return null
        let list signatures as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        var last: ref[TypePredicate]? null
        let types &Array[ref[Type]?]()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let sig row as ref[Signature]
            let pred this.get_type_predicate_of_signature(sig)
            if this.unported_mark() <> mark
                return null
            if pred = null
            {
                var return_type: ref[Type]? null
                if is_union
                {
                    set return_type: this.get_return_type_of_signature(sig)
                    if this.unported_mark() <> mark
                        return null
                }
                if return_type = false_type
                    continue
                if return_type = regular_false_type
                    continue
                return null
            }
            let p pred as ref[TypePredicate]
            var kind_ok false
            if p.kind = TypePredicateKindThis
                set kind_ok: true
            if p.kind = TypePredicateKindIdentifier
                set kind_ok: true
            if kind_ok = false
                return null
            if last <> null
            {
                if Checker.type_predicate_kinds_match(last as ref[TypePredicate], p) = false
                    return null
            }
            set last: p
            types.add(p.t)
        }
        if last = null
            return null
        let l last as ref[TypePredicate]
        let composite_type this.get_union_or_intersection_type(types, is_union, UnionReductionLiteral)
        if this.unported_mark() <> mark
            return null
        &TypePredicate^host(l.kind, l.parameter_index, l.parameter_name, composite_type)
    }

    ; compareTypePredicatesIdentical. ★Its `source == target` arm answers TRUE for
    ; two nils as well, which is a predicate pair with no type on either side —
    ; the same reading compare_type_predicate_related_to's note records.
    procedure compare_type_predicates_identical(this, source: ref[TypePredicate]?, target: ref[TypePredicate]?, comparer: int) returns bool
    {
        if source = null
            return false
        if target = null
            return false
        let s source as ref[TypePredicate]
        let t target as ref[TypePredicate]
        if Checker.type_predicate_kinds_match(s, t) = false
            return false
        if s.t = t.t
            return true
        if s.t = null
            return false
        if t.t = null
            return false
        this.compare_types_by_comparer(comparer, s.t as ref[Type], t.t as ref[Type])
    }

    ; compareTypeParametersIdentical (slice 155). ★It does NOT compare defaults,
    ; and the reference argues why at the line: the default is an inference
    ; fallback, so combining two intelligently would need to know whether the
    ; parameter is used co- or contravariantly, and picking the first works.
    ; ★★The mapper runs from the TARGET's parameters onto the SOURCE's, so
    ; `<T, U extends T>` and `<A, B extends A>` compare equal.
    procedure compare_type_parameters_identical(this, source_params: ref[Array[ref[Type]?]]?, target_params: ref[Array[ref[Type]?]]?) returns bool
    {
        var sn 0
        if source_params <> null
            set sn: (source_params as ref[Array[ref[Type]?]]).get_length() as int
        var tn 0
        if target_params <> null
            set tn: (target_params as ref[Array[ref[Type]?]]).get_length() as int
        if sn <> tn
            return false
        if sn = 0
            return true
        let sps source_params as ref[Array[ref[Type]?]]
        let tps target_params as ref[Array[ref[Type]?]]
        let mark this.unported_mark()
        let mapper this.new_type_mapper(target_params, source_params)
        var i 0
        while i < sn
        {
            let srow sps[i]
            let trow tps[i]
            if srow = null
                return false
            if trow = null
                return false
            let sp srow as ref[Type]
            let tp trow as ref[Type]
            if sp <> tp
            {
                let sc this.get_constraint_or_unknown_from_type_parameter(sp)
                let tc this.get_constraint_or_unknown_from_type_parameter(tp)
                if this.unported_mark() <> mark
                    return false
                if sc = null
                    return false
                if tc = null
                    return false
                let itc this.instantiate_type(tc, mapper)
                if this.unported_mark() <> mark
                    return false
                if itc = null
                    return false
                if this.is_type_identical_to(sc as ref[Type], itc as ref[Type]) = false
                    return false
                if this.unported_mark() <> mark
                    return false
            }
            set i: i + 1
        }
        true
    }

    ; findMatchingSignature (slice 155) — the FIRST signature of a list that is
    ; identical to the given one. ★`partialMatch` picks the comparer as well as
    ; loosening isMatchingSignature, which is why the two travel together.
    procedure find_matching_signature(this, signature_list: ref[Array[ref[Signature]?]]?, signature: ref[Signature], partial_match: bool, ignore_this_types: bool, ignore_return_types: bool) returns ref[Signature]?
    {
        if signature_list = null
            return null
        var comparer SignatureComparerIdentical
        if partial_match
            set comparer: SignatureComparerSubtypeOf
        let list signature_list as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        let mark this.unported_mark()
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let cand row as ref[Signature]
            if this.compare_signatures_identical(cand, signature, partial_match, ignore_this_types, ignore_return_types, comparer)
                return cand
            if this.unported_mark() <> mark
                return null
        }
        null
    }

    ; findMatchingSignatures.
    ;
    ; ★★★ THE GENERIC HALF AND THE NON-GENERIC HALF ARE TWO DIFFERENT RELATIONS.
    ; A generic signature demands an EXACT match in every other list and is
    ; collected only from list 0 — so a union of two generic overloads answers one
    ; signature or none. A non-generic one is allowed a match with EXCESS
    ; parameters (the second, partial call) and a different return type, and the
    ; answer is one match per list.
    ;
    ; ★ `core.AppendIfUnique` is why a signature matched by two lists is collected
    ; once: the fold that follows unions RESULT TYPES over the collected set, and a
    ; duplicate would union a type with itself.
    procedure find_matching_signatures(this, signature_lists: ref[Array[ref[Array[ref[Signature]?]]?]], signature: ref[Signature], list_index: int) returns ref[Array[ref[Signature]?]]?
    {
        let ln signature_lists.get_length() as int
        let mark this.unported_mark()
        if Checker.type_parameter_count_of_signature(signature) <> 0
        {
            if list_index > 0
                return null
            var i 1
            while i < ln
            {
                let m this.find_matching_signature(Checker.signature_list_at(signature_lists, i), signature, false, false, false)
                if this.unported_mark() <> mark
                    return null
                if m = null
                    return null
                set i: i + 1
            }
            let one &Array[ref[Signature]?]^host()
            let sg: ref[Signature]? signature
            one.add(sg)
            return one
        }
        let result &Array[ref[Signature]?]^host()
        var i 0
        while i < ln
        {
            var found: ref[Signature]? null
            if i = list_index
                set found: signature
            if i <> list_index
            {
                set found: this.find_matching_signature(Checker.signature_list_at(signature_lists, i), signature, false, false, true)
                if this.unported_mark() <> mark
                    return null
                if found = null
                {
                    set found: this.find_matching_signature(Checker.signature_list_at(signature_lists, i), signature, true, false, true)
                    if this.unported_mark() <> mark
                        return null
                }
            }
            if found = null
                return null
            let m found as ref[Signature]
            let rn result.get_length() as int
            var seen false
            var j 0
            while j < rn
            {
                let row result[j]
                set j: j + 1
                if row = null
                    continue
                if (row as ref[Signature]) = m
                {
                    set seen: true
                    break
                }
            }
            if seen = false
            {
                let e: ref[Signature]? m
                result.add(e)
            }
            set i: i + 1
        }
        result
    }

    ; `signatureLists[i]` — one row of the list-of-lists, peeled once so the two
    ; call sites above read as the reference does.
    function signature_list_at(lists: ref[Array[ref[Array[ref[Signature]?]]?]], index: int) returns ref[Array[ref[Signature]?]]?
    {
        let row lists[index]
        if row = null
            return null
        row
    }

    ; compareSignaturesIdentical, split at the one line that REASSIGNS `source`:
    ; the generic arm instantiates it with the target's type parameters and
    ; continues, so the continuation is a tail helper rather than a rebound
    ; parameter.
    procedure compare_signatures_identical(this, source: ref[Signature], target: ref[Signature], partial_match: bool, ignore_this_types: bool, ignore_return_types: bool, comparer: int) returns bool
    {
        if source = target
            return true
        let mark this.unported_mark()
        if this.is_matching_signature(source, target, partial_match) = false
            return false
        if this.unported_mark() <> mark
            return false
        let stpc Checker.type_parameter_count_of_signature(source)
        let ttpc Checker.type_parameter_count_of_signature(target)
        if stpc <> ttpc
            return false
        if ttpc = 0
            return this.compare_signatures_identical_tail(source, target, ignore_this_types, ignore_return_types, comparer)
        ; The type parameters' CONSTRAINTS and DEFAULTS must match, read through a
        ; mapper from the source's parameters onto the target's.
        let mapper this.new_type_mapper(source.type_parameters, target.type_parameters)
        let sps source.type_parameters as ref[Array[ref[Type]?]]
        let tps target.type_parameters as ref[Array[ref[Type]?]]
        var i 0
        while i < ttpc
        {
            let srow sps[i]
            let trow tps[i]
            if srow = null
                return false
            if trow = null
                return false
            let sp srow as ref[Type]
            let tp trow as ref[Type]
            var ok false
            if sp = tp
                set ok: true
            if ok = false
            {
                let sc this.get_constraint_or_unknown_from_type_parameter(sp)
                let tc this.get_constraint_or_unknown_from_type_parameter(tp)
                if this.unported_mark() <> mark
                    return false
                if sc <> null
                {
                    if tc <> null
                    {
                        let isc this.instantiate_type(sc as ref[Type], mapper)
                        if isc <> null
                        {
                            if this.compare_types_by_comparer(comparer, isc as ref[Type], tc as ref[Type])
                            {
                                let sd this.get_default_or_unknown_from_type_parameter(sp)
                                let td this.get_default_or_unknown_from_type_parameter(tp)
                                if this.unported_mark() <> mark
                                    return false
                                if sd <> null
                                {
                                    if td <> null
                                    {
                                        let isd this.instantiate_type(sd as ref[Type], mapper)
                                        if isd <> null
                                        {
                                            if this.compare_types_by_comparer(comparer, isd as ref[Type], td as ref[Type])
                                                set ok: true
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if ok = false
                return false
            set i: i + 1
        }
        let inst this.instantiate_signature_ex(source, mapper, true)
        if inst = null
            return false
        this.compare_signatures_identical_tail(inst as ref[Signature], target, ignore_this_types, ignore_return_types, comparer)
    }

    ; The rest of compareSignaturesIdentical: the `this` types, the parameter
    ; positions and the return. ★The parameter comparison is written in the
    ; reference's own order — `compareTypes(t, s)`, target first — because a
    ; comparer need not be symmetric.
    procedure compare_signatures_identical_tail(this, source: ref[Signature], target: ref[Signature], ignore_this_types: bool, ignore_return_types: bool, comparer: int) returns bool
    {
        let mark this.unported_mark()
        if ignore_this_types = false
        {
            let stt this.get_this_type_of_signature(source)
            if this.unported_mark() <> mark
                return false
            if stt <> null
            {
                let ttt this.get_this_type_of_signature(target)
                if this.unported_mark() <> mark
                    return false
                if ttt <> null
                {
                    if this.compare_types_by_comparer(comparer, stt as ref[Type], ttt as ref[Type]) = false
                        return false
                }
            }
        }
        let count this.get_parameter_count(target)
        if this.unported_mark() <> mark
            return false
        var i 0
        while i < count
        {
            let sat this.get_type_at_position(source, i)
            let tat this.get_type_at_position(target, i)
            if this.unported_mark() <> mark
                return false
            if sat = null
                return false
            if tat = null
                return false
            if this.compare_types_by_comparer(comparer, tat as ref[Type], sat as ref[Type]) = false
                return false
            set i: i + 1
        }
        if ignore_return_types
            return true
        let sp this.get_type_predicate_of_signature(source)
        let tp this.get_type_predicate_of_signature(target)
        if this.unported_mark() <> mark
            return false
        var have_predicate false
        if sp <> null
            set have_predicate: true
        if tp <> null
            set have_predicate: true
        if have_predicate
            return this.compare_type_predicates_identical(sp, tp, comparer)
        let sr this.get_return_type_of_signature(source)
        let tr this.get_return_type_of_signature(target)
        if this.unported_mark() <> mark
            return false
        if sr = null
            return false
        if tr = null
            return false
        this.compare_types_by_comparer(comparer, sr as ref[Type], tr as ref[Type])
    }

    ; ── slice 126: the INDEX-SIGNATURE relation ─────────────────────────
    ;
    ; indexSignaturesRelatedTo, whole. ★The stub's reading holds unchanged — the
    ; body is one loop over the TARGET's index infos with `result` seeded True, so
    ; a target with none is True — and the loop now runs.
    ;
    ; ★★ THE FIRST ARM IS THE `any` INDEX SIGNATURE'S LICENCE: as long as the
    ; target has a STRING index whose value type is `any`, and the relation is not
    ; the strict subtype one, every index info of the target is satisfied without
    ; looking at the source at all. It is what makes `{}` assignable to
    ; `{ [k: string]: any }`.
    procedure index_signatures_related_to(this, source: ref[Type], target: ref[Type], source_is_primitive: bool, relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        if relation = RelationIdentity
            return this.index_signatures_identical_to(source, target)
        let mark this.unported_mark()
        let infos this.get_index_infos_of_type(target)
        if this.unported_mark() <> mark
            return false
        if infos = null
            return true
        let list infos as ref[Array[ref[IndexInfo]?]]
        let n list.get_length() as int
        if n = 0
            return true
        ; `core.Some(indexInfos, info.keyType == stringType)`.
        var target_has_string_index false
        var i 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                if (row as ref[IndexInfo]).key_type = string_type
                    set target_has_string_index: true
            }
            set i: i + 1
        }
        set i: 0
        while i < n
        {
            let row list[i]
            if row <> null
            {
                let ti row as ref[IndexInfo]
                if ti.value_type = null
                    return false
                let tv ti.value_type as ref[Type]
                var decided false
                if relation <> RelationStrictSubtype
                {
                    if source_is_primitive = false
                    {
                        if target_has_string_index
                        {
                            if (tv.flags & TypeFlagsAny) <> 0
                                set decided: true
                        }
                    }
                }
                if decided = false
                {
                    var generic_mapped false
                    if this.is_generic_mapped_type(source)
                    {
                        if target_has_string_index
                            set generic_mapped: true
                    }
                    if generic_mapped
                    {
                        let tt this.get_template_type_from_mapped_type(source)
                        if this.unported_mark() <> mark
                            return false
                        if tt = null
                            return false
                        if this.is_related_to_ex(tt as ref[Type], tv, relation, error_node, IntersectionStateNone, RecursionFlagsBoth) = false
                            return false
                    }
                    else
                    {
                        if this.type_related_to_index_info(source, ti, relation, error_node, intersection_state) = false
                            return false
                    }
                }
            }
            set i: i + 1
        }
        true
    }

    ; typeRelatedToIndexInfo. ★Its report — *Index signature for type 0 is missing
    ; in type 1* — is a chain link and drops for signatures_related_to's reason.
    ;
    ; ★★ THE SECOND ARM'S THREE CONDITIONS ARE WHAT KEEPS `{ [x: string]: xxx }` A
    ; STRICT SUBTYPE OF `{}` AND NOT THE OTHER WAY ROUND: an intersection
    ; constituent never counts as having an INFERRED index signature, and under the
    ; strict subtype relation only a fresh object literal does.
    procedure type_related_to_index_info(this, source: ref[Type], target_info: ref[IndexInfo], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        let mark this.unported_mark()
        if target_info.key_type = null
            return false
        let source_info this.get_applicable_index_info(source, target_info.key_type as ref[Type])
        if this.unported_mark() <> mark
            return false
        if source_info <> null
            return this.index_info_related_to(source_info as ref[IndexInfo], target_info, relation, error_node, intersection_state)
        if (intersection_state & IntersectionStateSource) = 0
        {
            var fresh_or_lenient false
            if relation <> RelationStrictSubtype
                set fresh_or_lenient: true
            if (source.object_flags & ObjectFlagsFreshLiteral) <> 0
                set fresh_or_lenient: true
            if fresh_or_lenient
            {
                if this.is_object_type_with_inferable_index(source)
                    return this.members_related_to_index_info(source, target_info, relation, error_node, intersection_state)
                if this.unported_mark() <> mark
                    return false
            }
        }
        false
    }

    ; membersRelatedToIndexInfo — the source's own PROPERTIES against the target's
    ; index signature, then its own index infos. ★The `exactOptionalPropertyTypes`
    ; fork decides whether an optional property's `undefined` is stripped before
    ; the comparison; a NUMBER key never strips it.
    ;
    ; ★ THE INTERSECTION SOURCE was this function's one stop until slice 127; it
    ; needed getPropertiesOfUnionOrIntersectionType, which is now here.
    procedure members_related_to_index_info(this, source: ref[Type], target_info: ref[IndexInfo], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        let mark this.unported_mark()
        if target_info.key_type = null
            return false
        if target_info.value_type = null
            return false
        let key_type target_info.key_type as ref[Type]
        let value_type target_info.value_type as ref[Type]
        var props: ref[Array[ref[Symbol]?]]? null
        if (source.flags & TypeFlagsIntersection) <> 0
            set props: this.get_properties_of_union_or_intersection_type(source)
        else
            set props: this.get_properties_of_object_type(source)
        if this.unported_mark() <> mark
            return false
        if props <> null
        {
            let plist props as ref[Array[ref[Symbol]?]]
            let pn plist.get_length() as int
            var i 0
            while i < pn
            {
                let row plist[i]
                if row <> null
                {
                    let prop row as ref[Symbol]
                    ; Ignored JSX and symbol-named members are skipped.
                    if Checker.is_ignored_jsx_property(source, prop) = false
                    {
                        let lit this.get_literal_type_from_property(prop, TypeFlagsStringOrNumberLiteralOrUnique, false)
                        if this.unported_mark() <> mark
                            return false
                        if lit = null
                            return false
                        if this.is_applicable_index_type(lit as ref[Type], key_type)
                        {
                            let prop_type this.get_non_missing_type_of_symbol(prop)
                            if this.unported_mark() <> mark
                                return false
                            if prop_type = null
                                return false
                            let pt prop_type as ref[Type]
                            var keep true
                            if Checker.exact_optional_property_types() = false
                            {
                                if (pt.flags & TypeFlagsUndefined) = 0
                                {
                                    if key_type <> number_type
                                    {
                                        if (Symbol.flags_of(prop) & SymbolFlagsOptional) <> 0
                                            set keep: false
                                    }
                                }
                            }
                            if keep
                            {
                                if this.is_related_to_ex(pt, value_type, relation, error_node, intersection_state, RecursionFlagsBoth) = false
                                    return false
                            }
                            else
                            {
                                let stripped this.get_type_with_facts(pt, TypeFactsNEUndefined)
                                if this.unported_mark() <> mark
                                    return false
                                if stripped = null
                                    return false
                                if this.is_related_to_ex(stripped as ref[Type], value_type, relation, error_node, intersection_state, RecursionFlagsBoth) = false
                                    return false
                            }
                        }
                    }
                }
                set i: i + 1
            }
        }
        let infos this.get_index_infos_of_type(source)
        if this.unported_mark() <> mark
            return false
        if infos = null
            return true
        let ilist infos as ref[Array[ref[IndexInfo]?]]
        let inn ilist.get_length() as int
        var j 0
        while j < inn
        {
            let row ilist[j]
            if row <> null
            {
                let info row as ref[IndexInfo]
                if info.key_type = null
                    return false
                if this.is_applicable_index_type(info.key_type as ref[Type], key_type)
                {
                    if this.index_info_related_to(info, target_info, relation, error_node, intersection_state) = false
                        return false
                }
            }
            set j: j + 1
        }
        true
    }

    ; indexInfoRelatedTo — the value types, and its two reports are links.
    procedure index_info_related_to(this, source_info: ref[IndexInfo], target_info: ref[IndexInfo], relation: int, error_node: ref[AstNode]?, intersection_state: int) returns bool
    {
        if source_info.value_type = null
            return false
        if target_info.value_type = null
            return false
        this.is_related_to_ex(source_info.value_type as ref[Type], target_info.value_type as ref[Type], relation, error_node, intersection_state, RecursionFlagsBoth)
    }

    ; indexSignaturesIdenticalTo. ★It asks for the source's index info AT THE
    ; TARGET'S KEY TYPE — getIndexInfoOfType, an exact key match, not the
    ; applicable one — and it compares `isReadonly` as well, which is the one place
    ; in the relation where a modifier is part of identity.
    procedure index_signatures_identical_to(this, source: ref[Type], target: ref[Type]) returns bool
    {
        let mark this.unported_mark()
        let sinfos this.get_index_infos_of_type(source)
        let tinfos this.get_index_infos_of_type(target)
        if this.unported_mark() <> mark
            return false
        var sn 0
        if sinfos <> null
            set sn: (sinfos as ref[Array[ref[IndexInfo]?]]).get_length() as int
        var tn 0
        if tinfos <> null
            set tn: (tinfos as ref[Array[ref[IndexInfo]?]]).get_length() as int
        if sn <> tn
            return false
        if tn = 0
            return true
        let tlist tinfos as ref[Array[ref[IndexInfo]?]]
        var i 0
        while i < tn
        {
            let row tlist[i]
            if row = null
                return false
            let ti row as ref[IndexInfo]
            if ti.key_type = null
                return false
            if ti.value_type = null
                return false
            let si this.get_index_info_of_type(source, ti.key_type as ref[Type])
            if this.unported_mark() <> mark
                return false
            if si = null
                return false
            let s_info si as ref[IndexInfo]
            if s_info.value_type = null
                return false
            if this.is_related_to_ex(s_info.value_type as ref[Type], ti.value_type as ref[Type], RelationIdentity, null, IntersectionStateNone, RecursionFlagsBoth) = false
                return false
            if s_info.is_readonly <> ti.is_readonly
                return false
            set i: i + 1
        }
        true
    }

    ; reportErrorResults, whole — and it is four containment proofs and one call.
    ;
    ; ★★★ THE MARK IS THE PARAMETER THAT MATTERS. Its caller read it before the
    ; comparison began; a report behind a stop would be a diagnostic derived from
    ; an incomplete answer, and on a SUBSEQUENCE relation an invented line is the
    ; one direction that fails. Every unported arm in this chapter is a
    ; `record_unported` that falls through precisely because this line exists.
    ;
    ; ★★★ TWO OF THE SIX CONTAINMENTS BELOW EXPIRED WITH SLICE 118 AND THE REASON
    ; IS ONE SENTENCE: they were licensed by *the structured branch stops*, and it
    ; does not any more. `tryElaborateArrayLikeErrors` needs Object on BOTH sides,
    ; which is now the ordinary way into this function, and its message —
    ; `The_type_0_is_readonly_and_cannot_be_assigned_to_the_mutable_type_1` — is one
    ; of the five that `reportRelationError`'s suppression switch names, so it is a
    ; chain HEAD and not a link: unported, it is a LOST CODE and not an invisible
    ; one. It is written below as the narrow stop its two report conditions
    ; describe. ★The Object-type arm is the other half of the expiry and it needs
    ; nothing: `globalObjectType` exists since this slice, so the arm can fire —
    ; but its message is a link that `reportRelationError` prepends TS2322 on top
    ; of, and a dump carries the code and the span, so it is invisible in both
    ; directions and is named here rather than written.
    ;
    ; ★★ THE OTHER FOUR HAVE NO INPUT, each for its own reason and each written
    ; where the reference forks: the JSX arm needs ObjectFlagsJsxAttributes and
    ; `globalObjectType`, the JSX arm needs ObjectFlagsJsxAttributes and
    ; `getJsxType`, and the never-intersection arm needs an Intersection, which is
    ; structured. ★`getSingleBaseForNonAugmentingSubtype` and the type ALIAS test
    ; above them decide only WHICH type is NAMED — the reference's `source =
    ; originalSource` — and both are answers about an object: the first reads
    ; ObjectFlagsReference and the second a slot this port does not carry (see
    ; type_to_string's own note). The names decide the CODE only through the
    ; equality below, and both would move the two names together.
    ;
    ; ★ The trailing `This_type_parameter_might_need_an_extends_0_constraint` is
    ; RELATED INFORMATION on the diagnostic this function is about to emit, not a
    ; diagnostic of its own — the dump carries pos, end and code, so it cannot be
    ; seen here in either direction, and its guard needs a TypeParameter source
    ; besides.
    procedure report_error_results(this, original_source: ref[Type], original_target: ref[Type], source: ref[Type], target: ref[Type], relation: int, mark: int)
    {
        if this.unported_mark() <> mark
            return
        ; ★★★ THE LATCH IS GONE (slice 167). Slices 121–166 stood a `rel_reported`
        ; bool here so that only the FIRST level to arrive reported, which is the
        ; INNERMOST — and the reference prints the OUTERMOST: `reportError`
        ; PREPENDS and the diagnostic is built from the chain's HEAD, so the code
        ; that survives is the last one added, unless that level suppresses itself
        ; on the head already there. Both halves are now real, so every level
        ; reports and the switch at the end of `report_relation_error` decides.
        ;
        ; ★★★ THE SHAPE THE STOP STOOD IN FRONT OF, and it is the one four lines
        ; measure: a target INTERSECTION puts a second level between the inner
        ; missing-property message and the outer one, so
        ; `type B = {children: string} & {locale: string}` with
        ; `const q: B = {locale: 'en'}` is TS2322 upstream and was TS2741 here,
        ; while the same target spelled as ONE object literal type is TS2741 on
        ; both sides. It was walled by `is-reducible-intersection` until slice 166
        ; and by the latch until this one.
        ;
        ; ★★★ `sourceHasBase` / `targetHasBase` — the reference's own first four
        ; lines, and note WHAT they swap in: not the base, the ORIGINAL. The
        ; predicate asks whether the original adds nothing to its single base, and
        ; where it does not the report speaks about the pre-normalization type. The
        ; alias half of each disjunct is absent for `Type.alias`'s reason (see
        ; Type's note). ★The port has had the predicate since slice 127, as a test
        ; inside the suppression fork; the swap itself was never made, which is why
        ; that test had to exist at all — `report_relation_error`'s note explains
        ; the unit that measured it.
        var rep_source source
        var rep_target target
        ; `if originalSource.alias != nil || sourceHasBase { source = originalSource }` — the
        ; ALIASED original is what the outer message names (`NumberToNumber`), where the rows
        ; below it were reported on the normalized type (`NumberTo<number>`); the two names
        ; differ, and that difference is what keeps the outer TS2322 from being suppressed
        let sbase this.get_single_base_for_non_augmenting_subtype(original_source)
        if this.unported_mark() <> mark
            return
        if sbase <> null
            set rep_source: original_source
        if original_source.alias_symbol <> null
            set rep_source: original_source
        let tbase this.get_single_base_for_non_augmenting_subtype(original_target)
        if this.unported_mark() <> mark
            return
        if tbase <> null
            set rep_target: original_target
        if original_target.alias_symbol <> null
            set rep_target: original_target
        ; ★★★ THE ERROR TYPE IS A GUARD ONE LEVEL UP, AND IT COST TWO INVENTED
        ; LINES TO FIND. The mark says *nothing stopped inside this comparison*; it
        ; cannot say *the types handed in are the ones the reference would have
        ; computed*, because the stop that degraded one of them happened while the
        ; expression was being checked, before this call. `error_type` is where that
        ; shows: it carries TypeFlagsAny, so it answers TRUE against everything —
        ; **except a `never` target, where the arm four lines into
        ; isSimpleTypeRelatedTo answers FALSE before the `s&Any` arm is reached.**
        ; ★★★Measured, and it is the whole difference between a green stage 2 and a
        ; red one: `let t: never = x` in a narrowed else-branch, twice in 18 293
        ; units, where the reference narrows `x` to never and this port answers the
        ; error type. **Both invented a TS2322 the reference does not have, which is
        ; the one direction a SUBSEQUENCE relation can see.**
        ; ★It suppresses the REPORT and not the answer: an error type still relates
        ; to everything it relates to, exactly as upstream, because that arm is the
        ; reference's own and is not about this port's precision.
        if this.is_error_type(source)
        {
            this.record_unported("error-type-relation", target.flags)
            return
        }
        if this.is_error_type(target)
        {
            this.record_unported("error-type-relation", source.flags)
            return
        }
        ; ★★★ tryElaborateArrayLikeErrors' TWO REPORTING ARMS, WRITTEN SINCE SLICE
        ; 167. The bool half has been in the file since slice 127 (it steers
        ; reportUnmatchedProperty's multi-property arm); what was owed was the two
        ; `if reportErrors` blocks inside it, and they were a stop because this port
        ; had nowhere to put a message that is not the diagnostic's own code. In the
        ; chain they are two ordinary entries under whatever reportRelationError
        ; adds next. ★The arms are the reference's, in its order: a TUPLE source
        ; against a non-tuple target reports the arity or the tuple-ness, and a
        ; READONLY array source against a MUTABLE array target reports TS4104.
        if (rep_source.flags & TypeFlagsObject) <> 0
        {
            if (rep_target.flags & TypeFlagsObject) <> 0
                this.try_elaborate_array_like_errors_reporting(rep_source, rep_target)
        }
        if this.unported_mark() <> mark
            return
        ; ── the four-arm switch, and it is EXCLUSIVE ────────────────────────
        ;
        ; tryElaborateErrorsForPrimitivesAndObjects — *'0' is a primitive, but '1'
        ; is a wrapper object* — whose whole test is an identity comparison against
        ; the five global wrapper types (String, Number, Boolean, BigInt, Symbol).
        ; ★★It is FALSE here by construction rather than by assumption: a wrapper
        ; type can only be reached through the globals table, and this port has none
        ; — the name `String` in a type position is the `resolve-name-not-found` row
        ; (§3.11), so no type this checker can mint is one of the five. What the arm
        ; still costs is the SWITCH: taking it means the three below do not run.
        ;
        ; ★★★ THE `globalObjectType` ARM IS THE SAME ABSENCE FROM THE OTHER SIDE and
        ; it is written, because `get_global_object_type` answers null rather than
        ; stopping: *The 'Object' type is assignable to very few other types* is a
        ; report about a source that IS the global `Object`, and where the lib did
        ; not declare one the conjunct is false and nothing is owed.
        ;
        ; ★★★ THE JSX-ATTRIBUTES ARM ANSWERS BY RETURNING RATHER THAN BY A MESSAGE,
        ; and it is written rather than stopped because a stop there is not neutral:
        ; the arm is reached with a missing-property message ALREADY in the chain,
        ; so giving up leaves that line standing as the diagnostic while the
        ; reference prints the outer TS2322 over it. Measured on
        ; `jsxFunctionTypeChildren`, the one unit `diagcheck` reddened when the arm
        ; was a stop. ★The suppression is the reference's own: a target intersection
        ; that CONTAINS `IntrinsicAttributes` or `IntrinsicClassAttributes` is the
        ; JSX machinery's own wrapper and its failure is reported elsewhere; any
        ; other intersection falls through to the message below, which is why the
        ; arm is armed by the CONDITION and returns only on the containment.
        ; ★A `getJsxType` that answers null is the reference's `errorType` here —
        ; both make the conjunct false — so the fall-through is the same answer.
        ;
        ; ★★ THE NEVER-INTERSECTION ARM has no input: its condition reads
        ; ObjectFlagsIsNeverIntersection off `originalTarget`, and nothing in this
        ; port sets that bit (getIntersectionTypeEx's reduction is where upstream
        ; does). Named here rather than silently skipped.
        var armed false
        if (rep_source.flags & TypeFlagsObject) <> 0
        {
            if (rep_target.flags & TypeFlagsPrimitive) <> 0
                set armed: true
        }
        if armed = false
        {
            if rep_source.symbol <> null
            {
                if (rep_source.flags & TypeFlagsObject) <> 0
                {
                    let got this.get_global_object_type()
                    if got <> null
                    {
                        if rep_source = (got as ref[Type])
                        {
                            set armed: true
                            this.report_error(DiagThe_Object_type_is_assignable_to_very_few_other_types_Did_you_mean_to_use_the_any_type_instead, rep_source, rep_target)
                        }
                    }
                }
            }
        }
        if armed = false
        {
            if (rep_source.object_flags & ObjectFlagsJsxAttributes) <> 0
            {
                if (rep_target.flags & TypeFlagsIntersection) <> 0
                {
                    set armed: true
                    let ia this.get_jsx_type("IntrinsicAttributes", rel_error_node)
                    let ica this.get_jsx_type("IntrinsicClassAttributes", rel_error_node)
                    if this.unported_mark() <> mark
                        return
                    var contains false
                    if ia <> null
                    {
                        if ica <> null
                        {
                            if this.is_error_type(ia as ref[Type]) = false
                            {
                                if this.is_error_type(ica as ref[Type]) = false
                                {
                                    let its Checker.intersection_types_of(rep_target)
                                    if its <> null
                                    {
                                        let il its as ref[Array[ref[Type]?]]
                                        let n il.get_length() as int
                                        var i 0
                                        while i < n
                                        {
                                            let c il[i]
                                            if c <> null
                                            {
                                                if (c as ref[Type]) = (ia as ref[Type])
                                                    set contains: true
                                                if (c as ref[Type]) = (ica as ref[Type])
                                                    set contains: true
                                            }
                                            set i: i + 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if contains
                        return
                }
            }
        }
        this.report_relation_error(rep_source, rep_target, relation)
        ; the `might need an extends` related info: a TYPE PARAMETER source with a
        ; declaration and no constraint
        if ((rep_source.flags & TypeFlagsTypeParameter) = 0) or (rep_source.symbol = null)
            return
        let first_declaration Symbol.declaration_at(rep_source.symbol as ref[Symbol], 0)
        if first_declaration = null
            return
        let extends_mark this.unported_mark()
        let constraint this.get_constraint_of_type(rep_source)
        if (this.unported_mark() <> extends_mark) or (constraint <> null)
            return
        let synthetic this.clone_type_parameter(rep_source)
        let instantiated this.instantiate_type(rep_target, this.new_simple_type_mapper(rep_source, synthetic))
        if (this.unported_mark() <> extends_mark) or (instantiated = null)
            return
        Checker.set_type_parameter_constraint(synthetic, instantiated as ref[Type])
        let non_circular this.has_non_circular_base_constraint(synthetic)
        if (this.unported_mark() <> extends_mark) or (non_circular = false)
            return
        let related_args this.message_args()
        related_args.add(this.type_arg(rep_target))
        this.relater_related_info(first_declaration, DiagThis_type_parameter_might_need_an_extends_0_constraint, related_args)
    }

    ; tryElaborateArrayLikeErrors' report half — the two `if reportErrors` blocks
    ; the bool version above leaves out, and they report the SAME message (TS4104,
    ; *the type '0' is readonly and cannot be assigned to the mutable type '1'*) at
    ; two conditions. ★It answers nothing: the bool is the caller's question and
    ; reportUnmatchedProperty asks it separately, exactly as the reference runs the
    ; same walk twice with the flag flipped. ★★The two `return false` that follow
    ; each report are the BOOL's, not a control decision of this half — every other
    ; path through the reference's function reports nothing at all, so the walk
    ; below stops where the reference's reporting does.
    procedure try_elaborate_array_like_errors_reporting(this, source: ref[Type], target: ref[Type])
    {
        if Checker.is_tuple_type(source)
        {
            if Checker.tuple_readonly_of(Checker.get_target_type(source))
            {
                if this.is_mutable_array_or_tuple(target)
                    this.report_error(DiagThe_type_0_is_readonly_and_cannot_be_assigned_to_the_mutable_type_1, source, target, this.type_arg(source), this.type_arg(target))
            }
            return
        }
        if this.is_readonly_array_type(source)
        {
            if this.is_mutable_array_or_tuple(target)
                this.report_error(DiagThe_type_0_is_readonly_and_cannot_be_assigned_to_the_mutable_type_1, source, target, this.type_arg(source), this.type_arg(target))
        }
    }

    ; reportRelationError, down to the message it selects.
    ;
    ; ★★★ THE GENERALIZATION IS AN ARGUMENT AND NOT A CODE, so it is not written.
    ; The reference replaces a literal source by its base type for the message's
    ; first `{0}` (`Type '1' is not assignable to type 'string'` reads better as
    ; `Type 'number' is …`), and the dump carries pos, end and code — the same
    ; reading check_assignment_operator's headMessage note makes one dimension over.
    ; What the NAMES do decide is the TS2719 fork, and that one is transcribed.
    ;
    ; ★★ THREE ARMS WITH NO INPUT: the type-parameter target (TypeParameter and
    ; IndexedAccess are both Instantiable, and this function is reached only when
    ; neither side is), `exactOptionalPropertyTypes` (a plain equality against
    ; TSTrue — false under this harness, see the accessor), and the
    ; string-literal-to-UNION suggestion (a Union target is structured). ★And the
    ; four-way suppression switch on `getChainMessage(0)` reads a chain that is
    ; EMPTY: nothing in this slice appends to it before this point, which is what
    ; the enum arms' stops buy.
    ; getSingleBaseForNonAugmentingSubtype — *a reference to a class or interface
    ; that adds NOTHING to its single base*. Its one reader upstream is
    ; reportErrorResults, where it decides which of the two sources the report
    ; speaks about, and that is why this port needs it (see the suppression fork).
    ;
    ; ★★ THE CACHE IS THE `IdenticalBaseTypeCalculated` BIT AND IT IS NOT CARRIED:
    ; upstream memoises the answer on a cachedTypes map keyed by type id, and this
    ; port has no such map. The walk is `getBaseTypes` plus a members count, both
    ; of which are themselves memoised, so re-asking is cheap — but a NEGATIVE
    ; answer is re-derived each time, which is the whole cost.
    procedure get_single_base_for_non_augmenting_subtype(this, t: ref[Type]) returns ref[Type]?
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return null
        let target Checker.get_target_type(t)
        if (target.object_flags & ObjectFlagsClassOrInterface) = 0
            return null
        let mark this.unported_mark()
        if (target.object_flags & ObjectFlagsClass) <> 0
        {
            ; *"A base type expression may circularly reference the class itself,
            ; so we only check for base types specified as simple qualified
            ; names."*
            let btn Checker.get_base_type_node_of_class(target)
            if btn <> null
            {
                let e AstNode.expression_of(btn as ref[AstNode])
                if e = null
                    return null
                let k AstNode.kind_of(e as ref[AstNode])
                if k <> KindIdentifier
                {
                    if k <> KindPropertyAccessExpression
                        return null
                }
            }
        }
        let bases this.get_base_types(target)
        if this.unported_mark() <> mark
            return null
        if bases = null
            return null
        let blist bases as ref[Array[ref[Type]?]]
        if (blist.get_length() as int) <> 1
            return null
        if t.symbol = null
            return null
        let members this.get_members_of_symbol(t.symbol as ref[Symbol])
        if this.unported_mark() <> mark
            return null
        ; *"If the interface has any members, they may subtype members in the base,
        ; so we should do a full structural comparison."*
        if SymbolTable.length(members) <> 0
            return null
        let base0 blist[0]
        if base0 = null
            return null
        let tp_count Checker.type_parameter_count_of(target)
        var instantiated_base: ref[Type] base0 as ref[Type]
        let args this.get_type_arguments(t)
        if this.unported_mark() <> mark
            return null
        var arg_count 0
        if args <> null
            set arg_count: (args as ref[Array[ref[Type]?]]).get_length() as int
        if tp_count <> 0
        {
            ; instantiateType(bases[0], newTypeMapper(typeParameters, getTypeArguments(t)[:len(typeParameters)]))
            let tps this.interface_type_parameters_of(target)
            let head this.new_type_list(null)
            var i 0
            while i < tp_count
            {
                if i < arg_count
                    head.add((args as ref[Array[ref[Type]?]])[i])
                set i: i + 1
            }
            let inst this.instantiate_type(base0 as ref[Type], this.new_type_mapper(tps, head))
            if this.unported_mark() <> mark
                return null
            if inst = null
                return null
            set instantiated_base: inst as ref[Type]
        }
        if arg_count > tp_count
        {
            ; getTypeWithThisArgument(instantiatedBase, last type argument)
            let with_this this.get_type_with_this_argument(instantiated_base, (args as ref[Array[ref[Type]?]])[arg_count - 1], false)
            if this.unported_mark() <> mark
                return null
            if with_this = null
                return null
            set instantiated_base: with_this as ref[Type]
        }
        instantiated_base
    }

    ; ── the ERROR CHAIN's five primitives (slice 167) ───────────────────────
    ;
    ; `Relater.reportError`, minus the transform at its head. Upstream that head
    ; rewrites a `Types of property '0' are incompatible` entry into a dotted or a
    ; return-type message by reading the two entries under it — and this port has
    ; no writer for that message nor for any of the four it looks for (2202–2205),
    ; which are exactly the four the reference marks `elidedInCompatibilityPyramid`.
    ; The structured chapter reports nothing at all (see its own header), so the
    ; whole transform has no input here and the function is its last line.
    procedure report_error(this, code: int, arg_source: ref[Type]?, arg_target: ref[Type]?)
        this.report_error_with(code, arg_source, arg_target, null)

    procedure report_error(this, code: int, arg_source: ref[Type]?, arg_target: ref[Type]?, a0: String)
    {
        let args this.message_args()
        let h host
        let c0 String^h(a0)
        args.add(c0)
        this.report_error_with(code, arg_source, arg_target, args)
    }

    procedure report_error(this, code: int, arg_source: ref[Type]?, arg_target: ref[Type]?, a0: String, a1: String)
    {
        let args this.message_args()
        let h host
        let c0 String^h(a0)
        args.add(c0)
        let c1 String^h(a1)
        args.add(c1)
        this.report_error_with(code, arg_source, arg_target, args)
    }

    procedure report_error(this, code: int, arg_source: ref[Type]?, arg_target: ref[Type]?, a0: String, a1: String, a2: String)
    {
        let args this.message_args()
        let h host
        let c0 String^h(a0)
        args.add(c0)
        let c1 String^h(a1)
        args.add(c1)
        let c2 String^h(a2)
        args.add(c2)
        this.report_error_with(code, arg_source, arg_target, args)
    }

    procedure report_error(this, code: int, arg_source: ref[Type]?, arg_target: ref[Type]?, a0: String, a1: String, a2: String, a3: String)
    {
        let args this.message_args()
        let h host
        let c0 String^h(a0)
        args.add(c0)
        let c1 String^h(a1)
        args.add(c1)
        let c2 String^h(a2)
        args.add(c2)
        let c3 String^h(a3)
        args.add(c3)
        this.report_error_with(code, arg_source, arg_target, args)
    }

    ; getPropertyNameArg — a QUOTED property name is an INDEX, so `'a-b'` joins a
    ; dotted name as `["a-b"]` and not as `.'a-b'`.
    function property_name_arg(s: String) returns String
    {
        var quoted false
        if s.starts_with("\"")
            set quoted: true
        if s.starts_with("'")
            set quoted: true
        if s.starts_with("\`")
            set quoted: true
        if quoted = false
            return s
        var sb StringBuilder()
        sb.append("[")
        sb.append(s)
        sb.append("]")
        sb.to_string()
    }

    function text_is_new_at(t: String, pos: size_t) returns bool
    {
        if (pos + 4) > t.get_length()
            return false
        if t.get(pos) <> 110
            return false
        if t.get(pos + 1) <> 101
            return false
        if t.get(pos + 2) <> 119
            return false
        t.get(pos + 3) = 32
    }

    ; addToDottedName — `head` joined onto `tail`, which may itself already be a
    ; call or a construction (`new x()`), in which case the head goes INSIDE the
    ; `(` / `new ` prefix the tail carries.
    function add_to_dotted_name(h: String, t: String) returns String
    {
        var head h
        if head.starts_with("new ")
        {
            var hb StringBuilder()
            hb.append("(")
            hb.append(head)
            hb.append(")")
            set head: hb.to_string()
        }
        var pos: size_t 0
        let n t.get_length()
        var scanning true
        while scanning
        {
            set scanning: false
            if pos < n
            {
                if t.get(pos) = 40
                {
                    set pos: pos + 1
                    set scanning: true
                }
            }
            if scanning = false
            {
                if Checker.text_is_new_at(t, pos)
                {
                    set pos: pos + 4
                    set scanning: true
                }
            }
        }
        let prefix t.substring(0, pos)
        let suffix t.substring(pos, n - pos)
        var sb StringBuilder()
        sb.append(prefix)
        sb.append(head)
        if suffix.starts_with("[") = false
            sb.append(".")
        sb.append(suffix)
        sb.to_string()
    }

    ; ★★★ THE HEAD TRANSFORM HAS INPUT SINCE SLICE 288, and the note above
    ; `report_error` that said it had none expired with the property chapter's
    ; reports: `Types of property '0' are incompatible` is written again, so a
    ; chain can carry one over a signature-return-type row (which collapses into
    ; ONE `The types returned by 'x()' …`) or over a second property row (which
    ; collapses into ONE `The types of 'x.y' …`). The four messages the first
    ; fork looks for are exactly the four `elided_in_compatibility_pyramid`
    ; names — the elision is what makes the collapse necessary rather than
    ; cosmetic, because an un-collapsed chain would print a head nobody may see.
    procedure report_error_with(this, code: int, arg_source: ref[Type]?, arg_target: ref[Type]?, args: ref[Array[String]]?)
    {
        if code = DiagTypes_of_property_0_are_incompatible
        {
            this.report_property_error(code, arg_source, arg_target, args)
            return
        }
        this.chain_error(code, arg_source, arg_target, args)
    }

    procedure report_property_error(this, code: int, arg_source: ref[Type]?, arg_target: ref[Type]?, args: ref[Array[String]]?)
    {
        ; Suppress if next message is an excess property error
        let top this.get_chain_message(0)
        if top = DiagObject_literal_may_only_specify_known_properties_and_0_does_not_exist_in_type_1
            return
        if top = DiagObject_literal_may_only_specify_known_properties_but_0_does_not_exist_in_type_1_Did_you_mean_to_write_2
            return
        if args = null
        {
            this.chain_error(code, arg_source, arg_target, args)
            return
        }
        let a args as ref[Array[String]]
        if (a.get_length() as int) = 0
        {
            this.chain_error(code, arg_source, arg_target, args)
            return
        }
        var msg code
        let h host
        ; a property incompatibility followed by a signature return-type one is
        ; ONE return-type message for `x()`, `new x()`, `x(...)` or `new x(...)`
        let under this.get_chain_message(1)
        var parens 0
        var constructed false
        if under = DiagCall_signatures_with_no_arguments_have_incompatible_return_types_0_and_1
            set parens: 1
        if under = DiagConstruct_signatures_with_no_arguments_have_incompatible_return_types_0_and_1
        {
            set parens: 1
            set constructed: true
        }
        if under = DiagCall_signature_return_types_0_and_1_are_incompatible
            set parens: 2
        if under = DiagConstruct_signature_return_types_0_and_1_are_incompatible
        {
            set parens: 2
            set constructed: true
        }
        if parens <> 0
        {
            var sb StringBuilder()
            if constructed
                sb.append("new ")
            sb.append(Checker.property_name_arg(a[0]))
            if parens = 1
                sb.append("()")
            if parens = 2
                sb.append("(...)")
            a.put(0, String^h(sb.to_string()))
            set msg: DiagThe_types_returned_by_0_are_incompatible_between_these_types
            let e0 rel_error_chain as ref[ErrorChain]
            let e1 e0.next as ref[ErrorChain]
            set rel_error_chain: e1.next
        }
        ; a property incompatibility followed by a second one is ONE message for
        ; the dotted name
        let under2 this.get_chain_message(1)
        var dotted false
        if under2 = DiagTypes_of_property_0_are_incompatible
            set dotted: true
        if under2 = DiagThe_types_of_0_are_incompatible_between_these_types
            set dotted: true
        if under2 = DiagThe_types_returned_by_0_are_incompatible_between_these_types
            set dotted: true
        if dotted
        {
            let head Checker.property_name_arg(a[0])
            let e0 rel_error_chain as ref[ErrorChain]
            let e1 e0.next as ref[ErrorChain]
            var tail String("")
            if e1.args <> null
            {
                let ta e1.args as ref[Array[String]]
                if (ta.get_length() as int) > 0
                    set tail: Checker.property_name_arg(ta[0])
            }
            let joined Checker.add_to_dotted_name(head, tail)
            set rel_error_chain: e1.next
            if msg = DiagTypes_of_property_0_are_incompatible
                set msg: DiagThe_types_of_0_are_incompatible_between_these_types
            let na this.message_args()
            na.add(String^h(joined))
            this.report_error_with(msg, null, null, na)
            return
        }
        this.chain_error(msg, arg_source, arg_target, args)
    }

    procedure chain_error(this, code: int, arg_source: ref[Type]?, arg_target: ref[Type]?, args: ref[Array[String]]?)
    {
        var d 1
        if rel_error_chain <> null
            set d: (rel_error_chain as ref[ErrorChain]).depth + 1
        var inherited: ref[RelatedNode]? null
        if rel_error_chain <> null
            set inherited: (rel_error_chain as ref[ErrorChain]).related
        let e &ErrorChain^host(rel_error_chain, code, arg_source, arg_target, d, args, inherited)
        set rel_error_chain: e
    }

    ; getChainMessage — 0 for a chain that is shorter than the index, which is the
    ; reference's nil and reads the same at every one of its switches.
    function get_chain_message(this, index: int) returns int
    {
        var e rel_error_chain
        var i index
        while e <> null
        {
            let n e as ref[ErrorChain]
            if i = 0
                return n.code
            set e: n.next
            set i: i - 1
        }
        0
    }

    ; chainArgsMatch, at the two shapes its callers use: `null` is the wildcard the
    ; reference spells with a nil argument, and the pair is compared by IDENTITY —
    ; see ErrorChain's header for why this port does not print the names.
    ; chainArgsMatch compares the message ARGUMENTS, which are the printed type NAMES
    ; (`getTypeNamesForErrorDisplay`): two different type objects with one name match
    ; (the normalized source a row was reported on and the aliased original the outer
    ; report names), and one object under two names does not — so the test is on the
    ; printed form, identity only as the shortcut (slice 207; `objectTypeWithStringAndNumberIndexSignatureToAny`).
    procedure chain_args_match(this, arg_source: ref[Type]?, arg_target: ref[Type]?) returns bool
    {
        if rel_error_chain = null
            return false
        let n rel_error_chain as ref[ErrorChain]
        if arg_source <> null
        {
            if n.arg_source = null
                return false
            if this.types_print_alike(n.arg_source as ref[Type], arg_source as ref[Type]) = false
                return false
        }
        if arg_target <> null
        {
            if n.arg_target = null
                return false
            if this.types_print_alike(n.arg_target as ref[Type], arg_target as ref[Type]) = false
                return false
        }
        true
    }

    procedure types_print_alike(this, a: ref[Type], b: ref[Type]) returns bool
    {
        if a = b
            return true
        let sa StringBuilder^host()
        if this.type_to_string_serialized(a, &sa) = false
            return false
        let sb StringBuilder^host()
        if this.type_to_string_serialized(b, &sb) = false
            return false
        sa.to_string() = sb.to_string()
    }

    ; chainDepth, read off the node — see ErrorChain's header.
    function chain_depth(chain: ref[ErrorChain]?) returns int
    {
        if chain = null
            return 0
        (chain as ref[ErrorChain]).depth
    }

    ; createDiagnosticChainFromErrorChain, at what a `D <pos> <end> <code>` line can
    ; carry: the HEAD after the elision, emitted at `rel_error_node`. The links
    ; under it become the diagnostic's message chain upstream and are invisible in
    ; both directions here.
    ;
    ; ★★ THE ELISION LOOP IS WRITTEN THOUGH IT HAS NO INPUT. The four messages
    ; `elidedInCompatibilityPyramid` selects are the signature-return-type ones
    ; 2202–2205, which only `signaturesRelatedTo` reports and this port's structured
    ; chapter does not — so the loop is the identity today. It stands because the
    ; day one of them is written the elision is not a line anybody would think to
    ; add, and a head that must not be printed is a WRONG CODE rather than a missing
    ; one.
    ; `r.relatedInfo = append(r.relatedInfo, createDiagnosticForNode(n, code, args))`
    procedure relater_related_info(this, n: ref[AstNode]?, code: int, args: ref[Array[String]]?)
    {
        if (n = null) or (rel_error_chain = null)
            return
        var start 0
        var stop 0
        if this.related_range_of(n as ref[AstNode], &start, &stop) = false
            return
        let head rel_error_chain as ref[ErrorChain]
        let h host
        let copied DiagnosticList.copy_args(h, args)
        set head.related: &RelatedNode^h(head.related, Checker.source_file_of_node(n), start, stop, code, copied)
    }

    ; the relatedInfo list onto the diagnostic at `index`, oldest first
    procedure attach_related_nodes(this, index: int, list: ref[RelatedNode]?)
    {
        if list = null
            return
        let h host
        let ordered &Array[ref[RelatedNode]]^h()
        var e list
        while e <> null
        {
            let n e as ref[RelatedNode]
            ordered.add(n)
            set e: n.next
        }
        let dl diagnostics as ref[DiagnosticList]
        var i (ordered.get_length() as int) - 1
        while i >= 0
        {
            let n ordered[i as size_t]
            dl.add_related_at(index, n.file, n.pos, n.end, n.code, n.args)
            set i: i - 1
        }
    }

    procedure emit_error_chain(this)
    {
        var e rel_error_chain
        while e <> null
        {
            let n e as ref[ErrorChain]
            if Checker.elided_in_compatibility_pyramid(n.code) = false
            {
                ; createDiagnosticChainFromErrorChain: the first message not elided is
                ; the head, each later one nests one level under the one before it
                let dl diagnostics as ref[DiagnosticList]
                let before dl.length()
                this.error_on_node_with(rel_error_node, n.code, n.args)
                if dl.length() > before
                {
                    this.attach_related_nodes(before, (rel_error_chain as ref[ErrorChain]).related)
                    var level 1
                    var rest n.next
                    while rest <> null
                    {
                        let r rest as ref[ErrorChain]
                        if Checker.elided_in_compatibility_pyramid(r.code) = false
                        {
                            dl.add_chain_line_at(before, level, r.code, r.args)
                            set level: level + 1
                        }
                        set rest: r.next
                    }
                }
                return
            }
            set e: n.next
        }
    }

    function elided_in_compatibility_pyramid(code: int) returns bool
    {
        if code = DiagCall_signature_return_types_0_and_1_are_incompatible
            return true
        if code = DiagConstruct_signature_return_types_0_and_1_are_incompatible
            return true
        if code = DiagCall_signatures_with_no_arguments_have_incompatible_return_types_0_and_1
            return true
        code = DiagConstruct_signatures_with_no_arguments_have_incompatible_return_types_0_and_1
    }

    ; isConversionOrInterfaceImplementationMessage — the six heads that keep their
    ; own code even when a missing-property message sits in front of them.
    function is_conversion_or_interface_implementation_message(code: int) returns bool
    {
        if code = DiagClass_0_incorrectly_implements_interface_1
            return true
        if code = DiagClass_0_incorrectly_implements_class_1_Did_you_mean_to_extend_1_and_inherit_its_members_as_a_subclass
            return true
        if code = DiagConversion_of_type_0_to_type_1_may_be_a_mistake_because_neither_type_sufficiently_overlaps_with_the_other_If_this_was_intentional_convert_the_expression_to_unknown_first
            return true
        if code = DiagIts_instance_type_0_is_not_a_valid_JSX_element
            return true
        if code = DiagIts_return_type_0_is_not_a_valid_JSX_element
            return true
        code = DiagIts_element_type_0_is_not_a_valid_JSX_element
    }

    procedure report_relation_error(this, source: ref[Type], target: ref[Type], relation: int)
    {
        ; ★★★ `getTypeNamesForErrorDisplay(source, target)` IS THE REFERENCE'S FIRST
        ; LINE AND IT IS NOT DECORATION — see name_type_for_message. Naming a type
        ; walks it, and walking an anonymous object type resolves its members and
        ; every member signature's RETURN type, which is how the reference re-enters
        ; getReturnTypeOfSignature while one is still resolving and makes
        ; popTypeResolution answer false. Without it a circular return type is
        ; computed to the end and TS7023 is never spoken. The two names are thrown
        ; away here; the same-name fork below asks for them again because it needs
        ; the STRINGS, and its own stop is about the string and not about the walk.
        ; getTypeNamesForErrorDisplay, then the generalized source name
        let names_source this.type_display_arg(source)
        let names_target this.type_display_arg(target)
        var source_type names_source
        var target_type names_target
        if names_source = names_target
        {
            set source_type: this.type_name_for_error_display(source)
            set target_type: this.type_name_for_error_display(target)
        }
        var generalized_source_type source_type
        if (target.flags & TypeFlagsNever) = 0
        {
            if Checker.is_literal_type(source)
            {
                if this.type_could_have_top_level_singleton_types(target) = false
                {
                    let generalized this.get_base_type_of_literal_type(source)
                    if generalized <> null
                        set generalized_source_type: this.type_name_for_error_display(generalized as ref[Type])
                }
            }
        }
        ; ★★★ THE TYPE-PARAMETER TARGET FORK, SLICE 294, AND THE NOTE BELOW CALLED
        ; IT AN ARM WITH NO INPUT. Its reason — *TypeParameter and IndexedAccess
        ; are both Instantiable, and this function is reached only when neither
        ; side is* — is refuted by the reference's own baseline: the bigger
        ; `--generateTrace` case ends its chain with *'U' could be instantiated
        ; with an arbitrary type which could be unrelated to 'number'*, on a target
        ; that is exactly a type parameter. ★The default arm CLEARS the chain
        ; (`r.errorChain = nil // Only report this error once`), which is the one
        ; place in the relation that does.
        var generalized_source source
        if (target.flags & TypeFlagsNever) = 0
        {
            if Checker.is_literal_type(source)
            {
                if this.type_could_have_top_level_singleton_types(target) = false
                {
                    let g2 this.get_base_type_of_literal_type(source)
                    if g2 <> null
                        set generalized_source: g2 as ref[Type]
                }
            }
        }
        var target_flags target.flags
        if (target.flags & TypeFlagsIndexedAccess) <> 0
        {
            if (source.flags & TypeFlagsIndexedAccess) = 0
            {
                let obj Checker.indexed_access_object_type_of(target)
                if obj <> null
                    set target_flags: (obj as ref[Type]).flags
            }
        }
        if (target_flags & TypeFlagsTypeParameter) <> 0
        {
            var is_marker false
            if target = this.get_marker_super_type_for_check()
                set is_marker: true
            if target = this.get_marker_sub_type_for_check()
                set is_marker: true
            if is_marker = false
            {
                let constraint this.get_base_constraint_of_type(target)
                var armed_tp false
                if constraint <> null
                {
                    let c constraint as ref[Type]
                    if this.is_type_assignable_to(generalized_source, c)
                    {
                        set armed_tp: true
                        this.report_error(DiagX_0_is_assignable_to_the_constraint_of_type_1_but_1_could_be_instantiated_with_a_different_subtype_of_constraint_2, source, target, generalized_source_type, target_type, this.type_arg(c))
                    }
                    if armed_tp = false
                    {
                        if this.is_type_assignable_to(source, c)
                        {
                            set armed_tp: true
                            this.report_error(DiagX_0_is_assignable_to_the_constraint_of_type_1_but_1_could_be_instantiated_with_a_different_subtype_of_constraint_2, source, target, source_type, target_type, this.type_arg(c))
                        }
                    }
                }
                if armed_tp = false
                {
                    set rel_error_chain: null
                    this.report_error(DiagX_0_could_be_instantiated_with_an_arbitrary_type_which_could_be_unrelated_to_1, source, target, target_type, generalized_source_type)
                }
            }
        }

        ; ★★★ THE ORDER IS THE REFERENCE'S SINCE SLICE 167, AND IT USED TO BE
        ; INVERTED. `switch r.getChainMessage(0)` is the LAST thing this function
        ; does: the message is chosen first — head, comparable, TS2719, suggestion,
        ; TS2322 — and only then does the chain get a veto, so the head code is an
        ; INPUT to the suppression and not a way past it. The port ran the
        ; suppression fork FIRST and emitted the chain's message from inside it,
        ; which is the same answer wherever exactly one level reports and a
        ; different one wherever two do.
        ;
        ; ★★ THREE ARMS WITH NO INPUT, unchanged from slice 124: the type-parameter
        ; target (TypeParameter and IndexedAccess are both Instantiable, and this
        ; function is reached only when neither side is), `exactOptionalPropertyTypes`
        ; (a plain equality against TSTrue — false under this harness), and the
        ; generalization of a literal source, which changes the printed name and
        ; never the code.
        var code 0
        if (rel_head_code <> 0) and (rel_related_nesting <= 1)
            set code: rel_head_code
        if code = 0
        {
            if relation = RelationComparable
                set code: DiagType_0_is_not_comparable_to_type_1
        }
        if code = 0
        {
            ; getTypeNamesForErrorDisplay and the TS2719 fork it feeds. Its
            ; context-sensitive branch prints the type in the scope of its symbol's
            ; value declaration, which changes a NAME's qualification and not the
            ; fork; the port's type_to_string is the plain TypeToString both
            ; branches fall back to.
            ;
            ; ★★★ THE TWO NAMES ARE ASKED FOR ONLY WHEN BOTH TYPES CARRY A SYMBOL,
            ; AND THAT CONDITION IS THE MESSAGE'S OWN: *two different types with
            ; this name exist but they are unrelated* is a claim about DECLARED
            ; types, and a type with no symbol has no name to collide with — an
            ; intrinsic prints its keyword, a literal prints its value, and neither
            ; can equal the other side unless the two types are the same type, which
            ; the relation answered TRUE for three functions ago. ★★What the
            ; condition BUYS is the whole object-source population: `type_to_string`
            ; reports on an anonymous object type, so asking it unconditionally
            ; would turn every `var x: string = {}` — the one shape the
            ; object/primitive branch above exists for — into a row instead of the
            ; TS2322 the reference emits there.
            var same_name false
            if source.symbol <> null
            {
                if target.symbol <> null
                {
                    let sb_source StringBuilder^host()
                    if this.type_to_string_serialized(source, sb_source) = false
                    {
                        this.record_unported("type-to-string-for-error-display", source.flags)
                        return
                    }
                    let sb_target StringBuilder^host()
                    if this.type_to_string_serialized(target, sb_target) = false
                    {
                        this.record_unported("type-to-string-for-error-display", target.flags)
                        return
                    }
                    let source_name sb_source.to_string()
                    let target_name sb_target.to_string()
                    if source_name = target_name
                        set same_name: true
                }
            }
            if same_name
            {
                ; ★★★ `Type_0_is_not_assignable_to_type_1_Two_different_types_with
                ; _this_name_exist_but_they_are_unrelated`, TS2719 — and the note
                ; that stood here read *"only if the FULLY QUALIFIED names are equal
                ; too, which is getTypeNameForErrorDisplay and a printer flag this
                ; port does not carry."* Slice 183 carries it:
                ; getTypeNameForErrorDisplay is `typeToStringEx(t, nil,
                ; UseFullyQualifiedType)`, and that flag is the one the collision
                ; pass sets on itself.
                ;
                ; ★★★ THE TEST IS THE REPLACEMENT AND NOT AN EXTRA CONDITION.
                ; `getTypeNamesForErrorDisplay` REPLACES both names with the
                ; qualified ones whenever the plain ones agree, and TS2719's
                ; condition upstream is `sourceType == targetType` on the names that
                ; came out of it. So two types in different namespaces that print
                ; the same bare name fall THROUGH to the ordinary TS2322 — which is
                ; the whole point of the message: it exists to say *these two really
                ; are different types with one name*, and a qualifier that tells
                ; them apart is the evidence that they are not.
                let saved printer_fully_qualified
                let saved_yield printer_yield_module_symbol
                set printer_fully_qualified: true
                set printer_yield_module_symbol: true
                set printer_chain_dropped_container: false
                let qs StringBuilder^host()
                let ok_s this.type_to_string_serialized(source, &qs)
                let qt StringBuilder^host()
                var ok_t false
                if ok_s
                    set ok_t: this.type_to_string_serialized(target, &qt)
                let dropped printer_chain_dropped_container
                set printer_fully_qualified: saved
                set printer_yield_module_symbol: saved_yield
                if ok_s = false
                {
                    this.record_unported("type-to-string-for-error-display", source.flags)
                    return
                }
                if ok_t = false
                {
                    this.record_unported("type-to-string-for-error-display", target.flags)
                    return
                }
                ; ★ getTypeNameForErrorDisplay prints with UseFullyQualifiedType and
                ; WITHOUT UseAliasDefinedOutsideCurrentScope, so lookupSymbolChain
                ; YIELDS a module root there (`import("./f").DiagnosticCategory`)
                ; where the ordinary print drops it. This port's chain drops the
                ; module and marks the drop; a marked drop is a name that would have
                ; carried its module specifier upstream, and two such names cannot
                ; agree unless the types are one — so a drop takes the plain message
                ; (slice 226, `enumAssignmentCompat6`'s module unit; the specifier
                ; text itself is not written).
                var same_name (qs.to_string() = qt.to_string())
                if dropped
                    set same_name: false
                if same_name
                {
                    ; ★★★ EQUAL QUALIFIED NAMES DECIDE TS2719 ONLY WHERE THE
                    ; QUALIFICATION WAS COMPLETE. `enumAssignmentCompat6@f.ts` has a
                    ; module-EXPORTED `DiagnosticCategory` and a second one LOCAL to
                    ; an arrow function; the chain declines to name an external
                    ; module container, so both print `DiagnosticCategory` and the
                    ; equality is an artefact of the drop rather than a fact about
                    ; the types. The reference emits TS2322 there. **An equality is
                    ; only evidence when both sides could have differed.**
                    ; ★ A container DROPPED from the chain is the reference's own rule
                    ; (getSymbolChain answers nothing for a module parent that is not
                    ; the end of the chain, slice 221), and getTypeNamesForErrorDisplay
                    ; compares the two strings and nothing else: equal names after
                    ; full qualification are the "two different types with this name"
                    ; message (slice 226; the guard that reported here priced
                    ; `enumAssignmentCompat6`'s module unit).
                    this.report_error(DiagType_0_is_not_assignable_to_type_1_Two_different_types_with_this_name_exist_but_they_are_unrelated, source, target, generalized_source_type, target_type)
                    return
                }
            }
            if Checker.exact_optional_property_types()
            {
                if this.has_exact_optional_unassignable_properties(source, target)
                    set code: DiagType_0_is_not_assignable_to_type_1_with_exactOptionalPropertyTypes_Colon_true_Consider_adding_undefined_to_the_types_of_the_target_s_properties
            }
        }
        if code = 0
        {
            ; ★★★ THE SUGGESTION IS CONSULTED BEFORE TS2322 AND NOT AFTER IT — the
            ; reference's `default` fork asks it first and RETURNS on a hit, so a
            ; missing suggestion is not a missing extra message but a WRONG code. It
            ; became reachable with slice 121's intersection; see the function's own
            ; header for the unit that measured it.
            if (source.flags & TypeFlagsStringLiteral) <> 0
            {
                if (target.flags & TypeFlagsUnion) <> 0
                {
                    let mark this.unported_mark()
                    let suggested this.get_suggested_type_for_nonexistent_string_literal_type(source, target)
                    if this.unported_mark() <> mark
                        return
                    if suggested <> null
                    {
                        this.report_error(DiagType_0_is_not_assignable_to_type_1_Did_you_mean_2, source, target, generalized_source_type, target_type, this.type_arg(suggested))
                        return
                    }
                }
            }
            set code: DiagType_0_is_not_assignable_to_type_1
        }
        else
        {
            if (code = DiagArgument_of_type_0_is_not_assignable_to_parameter_of_type_1) and Checker.exact_optional_property_types()
            {
                if this.has_exact_optional_unassignable_properties(source, target)
                    set code: DiagArgument_of_type_0_is_not_assignable_to_parameter_of_type_1_with_exactOptionalPropertyTypes_Colon_true_Consider_adding_undefined_to_the_types_of_the_target_s_properties
            }
        }
        ; ── the suppression switch on the chain's HEAD ──────────────────────
        ;
        ; ★★★ IT IS A VETO AND NOT A SELECTION. Every arm RETURNS without adding
        ; anything, which leaves whatever the chain already holds as the head — so
        ; a suppressed level prints the INNER message and an unsuppressed one prints
        ; its own over it. That second half is what the
        ; `relation-error-outer-level-message` stop stood in for until this slice:
        ; the latch it guarded kept the inner message unconditionally.
        ;
        ; ★★ THE EXCESSIVE-* AND READONLY ARM HAS NO INPUT — nothing in this port
        ; reports any of those three — and it is written for the same reason the
        ; elision loop is: an arm that must suppress and does not is a WRONG CODE.
        ;
        ; ★★ THE TWO MISSING-PROPERTY ARMS COLLAPSE TO ONE `chain_args_match` HERE.
        ; Upstream they differ only in which argument POSITIONS carry the pair
        ; (TS2741 spells the property first, TS2739/TS2740 the types), and this
        ; port's chain entry carries the pair itself rather than a printed argument
        ; list — see ErrorChain's header.
        let headmsg this.get_chain_message(0)
        if headmsg = DiagObject_literal_may_only_specify_known_properties_and_0_does_not_exist_in_type_1
            return
        if headmsg = DiagObject_literal_may_only_specify_known_properties_but_0_does_not_exist_in_type_1_Did_you_mean_to_write_2
            return
        if headmsg = DiagExcessive_complexity_comparing_types_0_and_1
        {
            if this.chain_args_match(source, target)
                return
        }
        if headmsg = DiagExcessive_stack_depth_comparing_types_0_and_1
        {
            if this.chain_args_match(source, target)
                return
        }
        if headmsg = DiagThe_type_0_is_readonly_and_cannot_be_assigned_to_the_mutable_type_1
        {
            if this.chain_args_match(source, target)
                return
        }
        var missing false
        if headmsg = DiagProperty_0_is_missing_in_type_1_but_required_in_type_2
            set missing: true
        if headmsg = DiagType_0_is_missing_the_following_properties_from_type_1_Colon_2
            set missing: true
        if headmsg = DiagType_0_is_missing_the_following_properties_from_type_1_Colon_2_and_3_more
            set missing: true
        if missing
        {
            if Checker.is_conversion_or_interface_implementation_message(code) = false
            {
                ; ★★★ `chainArgsMatch` COMPARES THE PRINTED NAMES and this port
                ; compares the TYPES, which is not the same question: a source that
                ; adds nothing to its single base is reported under the BASE's name,
                ; so the chain's args and reportRelationError's disagree while the
                ; types are identical. Measured on `privateNamesUnique-4`, where
                ; `interface A2 extends A1 {}` against a class with a private member
                ; is TS2322 upstream and was TS2741 here. The predicate is the one
                ; reportErrorResults itself uses to decide which source the report
                ; speaks about — and since slice 167 that swap has HAPPENED before
                ; this line runs, so the test is only owed for a source whose swap
                ; reportErrorResults could not make.
                var renamed false
                let single this.get_single_base_for_non_augmenting_subtype(source)
                if single <> null
                    set renamed: true
                if renamed = false
                {
                    if this.chain_args_match(source, target)
                        return
                }
            }
        }
        this.report_error(code, source, target, generalized_source_type, target_type)
    }

    ; checkTypeAssignableToAndOptionallyElaborate and the relation-general function
    ; behind it, both whole.
    ;
    ; ★★★ THE EARLY-OUT IS THE POINT OF THE PAIR AND IT IS WHERE THIS SLICE'S UNITS
    ; COME FROM: `isTypeRelatedTo` answers first and a TRUE returns before any
    ; error node is consulted, so an assignment that HOLDS costs one flag test and
    ; leaves no trace. The stop that used to stand at these three call sites is
    ; replaced by an answer, not by a smaller stop.
    procedure check_type_assignable_to_and_optionally_elaborate(this, source: ref[Type], target: ref[Type], error_node: ref[AstNode]?, expr: ref[AstNode]?, head_code: int) returns bool
        this.check_type_related_to_and_optionally_elaborate(source, target, RelationAssignable, error_node, expr, head_code)

    ; checkTypeAssignableTo — the plain entry, no elaboration, with a head message.
    ; ★It is NOT the `AndOptionallyElaborate` pair above: the elaborators walk an
    ; EXPRESSION and this caller has none, which is why the reference keeps the two
    ; functions apart and why the class heritage checks call this one.
    procedure check_type_assignable_to(this, source: ref[Type], target: ref[Type], error_node: ref[AstNode]?, head_code: int) returns bool
        this.check_type_related_to_ex(source, target, RelationAssignable, error_node, head_code)

    ; ★★★ THE HEAD REACHED THIS PAIR IN SLICE 138, and it is not decoration: the
    ; ARGUMENT comparison hands down `Argument of type 0 is not assignable to
    ; parameter of type 1` (TS2345), which is the code every failed call reports.
    ; Without it the same comparison answers the RELATION's own TS2322 — the right
    ; span with the wrong code, which is exactly what the pre-slice tree did on
    ; `fixtures_callres_argument_relation`. ★It also repaired a site that had been
    ; wrong since slice 133: `satisfies` passes TS1360 upstream and the port passed
    ; nothing, because at the time nothing could carry it.
    procedure check_type_related_to_and_optionally_elaborate(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, expr: ref[AstNode]?, head_code: int) returns bool
    {
        let capture_from diagnostics.length()
        let answer this.check_type_related_to_and_optionally_elaborate_worker(source, target, relation, error_node, expr, head_code)
        if relation_capture_on
        {
            var ci capture_from
            while ci < diagnostics.length()
            {
                var seen false
                var k 0
                while k < (relation_capture.get_length() as int)
                {
                    if relation_capture[k as size_t] = ci
                        set seen: true
                    set k: k + 1
                }
                if seen = false
                    relation_capture.add(ci)
                set ci: ci + 1
            }
        }
        answer
    }

    procedure check_type_related_to_and_optionally_elaborate_worker(this, source: ref[Type], target: ref[Type], relation: int, error_node: ref[AstNode]?, expr: ref[AstNode]?, head_code: int) returns bool
    {
        let mark this.unported_mark()
        let related this.is_type_related_to(source, target, relation)
        if related
        {
            this.record_relation(error_node, source, target, 1)
            return true
        }
        ; A relation that could not answer is not a relation that answered false;
        ; the reference has no such state and this port has to say so here, because
        ; the two lines below would otherwise elaborate and report on it.
        if this.unported_mark() <> mark
        {
            this.record_relation(error_node, source, target, 2)
            return false
        }
        if error_node = null
        {
            this.record_relation(error_node, source, target, 0)
            return false
        }
        if this.elaborate_error(expr, source, target, relation, head_code)
        {
            this.record_relation(error_node, source, target, 0)
            return false
        }
        ; ★★★ AND THE SAME QUESTION AGAIN, FOR THE ELABORATOR. It is asked twice
        ; rather than once because the two answers mean different things and the
        ; second one is the load-bearing half: `report_error_results`' own guard
        ; reads a mark taken INSIDE the comparison, so a stop raised out here — an
        ; object literal the elaborator cannot walk — would be invisible to it.
        if this.unported_mark() <> mark
        {
            this.record_relation(error_node, source, target, 2)
            return false
        }
        let answered this.check_type_related_to_ex(source, target, relation, error_node, head_code)
        var verdict 0
        if this.unported_mark() <> mark
            set verdict: 2
        this.record_relation(error_node, source, target, verdict)
        answered
    }

    ; The RELPIN's entry — see RelEvent's header. ★The position is the ERROR
    ; NODE's, which is what a `C` line would carry, so a row and a diagnostic line
    ; up; a call with no error node writes -1 rather than being left out, because
    ; the sites that pass none are the ones whose answer is read instead of
    ; reported and a pin that dropped them would under-count the chapter.
    procedure record_relation(this, error_node: ref[AstNode]?, source: ref[Type], target: ref[Type], verdict: int)
    {
        var pos 0 - 1
        if error_node <> null
            set pos: AstNode.pos_of(error_node as ref[AstNode])
        if record_events
        {
            let ev &RelEvent^host(pos, source.flags, target.flags, verdict)
            rel_log.add(ev as ref[RelEvent])
        }
    }

    ; ── isTypeAssignableToKind and what stands under it (slice 102) ─────────
    ;
    ; ★★★ TEN LINES ON TOP OF SLICE 101, AND THE REASON THEY ARE A CHAPTER OF THEIR
    ; OWN IS THE POPULATION: `is-type-assignable-to-kind` was the third-largest
    ; EVENT row of the whole stage-2 histogram (16 287 arrivals over 416 units)
    ; while the function it names is a flag test and nine disjuncts. Every one of
    ; the nine ends in `isTypeAssignableTo` — the relation slice 101 wrote — so this
    ; slice adds no comparison machinery at all; it adds the question the binary
    ; expression's arithmetic and `+` arms are written over.
    ;
    ; ★★ THE THREE TARGETS THE DISJUNCTS NAME AND THIS PORT DOES NOT MINT are
    ; stringOrNumberType and friends' neighbours, not these: `numberType`,
    ; `bigintType`, `stringType`, `voidType`, `neverType`, `nullType`,
    ; `undefinedType`, `esSymbolType` and `nonPrimitiveType` all exist, and
    ; `booleanType` is an Option for the union worker's reason. So the table is
    ; transcribed whole rather than in the part the corpus feeds.

    ; isTypeAssignableTo — the named relation, and it is the only spelling the nine
    ; disjuncts below use.
    procedure is_type_assignable_to(this, source: ref[Type], target: ref[Type]) returns bool
        this.is_type_related_to(source, target, RelationAssignable)

    procedure is_type_assignable_to_kind(this, source: ref[Type], kind: int) returns bool
        this.is_type_assignable_to_kind_ex(source, kind, false)

    ; isTypeAssignableToKindEx, whole.
    ;
    ; ★★★ THE FAST PATH IS NOT AN OPTIMISATION AND IT IS WHERE MOST OF THE 16 287
    ; ARRIVALS ARE ANSWERED: `source.flags & kind` is a claim that the source
    ; ALREADY carries one of the asked-for bits, which for `1 + 1` (NumberLiteral
    ; against NumberLike) is the whole question. The relation is reached only where
    ; the two flag words do not overlap.
    ;
    ; ★★ THE STRICT ARM IS THE ONE THING `isTypeAssignableToKind` CANNOT SAY, and
    ; the `+` arm is why it exists: `any + any` must NOT answer number, so a strict
    ; caller refuses AnyOrUnknown, void, undefined and null BEFORE the disjuncts —
    ; where the non-strict caller lets `any` through the very first `t&Any` arm of
    ; is_simple_type_related_to. The two callers are one line apart in the reference
    ; and answer differently on the commonest input there is.
    ;
    ; ★ The disjuncts are transcribed in the reference's order and the order is not
    ; load-bearing here (they are disjoint tests against one `kind` word), but a
    ; reordering would change which comparison a stop is attributed to, and the
    ; stop log is how this chapter is read.
    procedure is_type_assignable_to_kind_ex(this, source: ref[Type], kind: int, strict: bool) returns bool
    {
        let mark this.unported_mark()
        var strict_bit 0
        if strict
            set strict_bit: 1
        if (source.flags & kind) <> 0
            return this.record_kind(source, kind, strict_bit, 0, mark, true)
        if strict
        {
            if (source.flags & (TypeFlagsAnyOrUnknown | TypeFlagsVoid | TypeFlagsUndefined | TypeFlagsNull)) <> 0
                return this.record_kind(source, kind, strict_bit, 1, mark, false)
        }
        if (kind & TypeFlagsNumberLike) <> 0
        {
            if this.is_type_assignable_to(source, number_type)
                return this.record_kind(source, kind, strict_bit, 2, mark, true)
        }
        if (kind & TypeFlagsBigIntLike) <> 0
        {
            if this.is_type_assignable_to(source, bigint_type)
                return this.record_kind(source, kind, strict_bit, 3, mark, true)
        }
        if (kind & TypeFlagsStringLike) <> 0
        {
            if this.is_type_assignable_to(source, string_type)
                return this.record_kind(source, kind, strict_bit, 4, mark, true)
        }
        if (kind & TypeFlagsBooleanLike) <> 0
        {
            ; ★ booleanType is the one target of the nine that is an Option, and a
            ; null there is not a "no": it is the union worker having stopped while
            ; minting the type, which is a state the reference has no room for. The
            ; row says so rather than answering false — see the field's own note.
            if boolean_type = null
                this.record_unported("boolean-type-unminted", kind)
            else
            {
                if this.is_type_assignable_to(source, boolean_type as ref[Type])
                    return this.record_kind(source, kind, strict_bit, 5, mark, true)
            }
        }
        if (kind & TypeFlagsVoid) <> 0
        {
            if this.is_type_assignable_to(source, void_type)
                return this.record_kind(source, kind, strict_bit, 6, mark, true)
        }
        if (kind & TypeFlagsNever) <> 0
        {
            if this.is_type_assignable_to(source, never_type)
                return this.record_kind(source, kind, strict_bit, 7, mark, true)
        }
        if (kind & TypeFlagsNull) <> 0
        {
            if this.is_type_assignable_to(source, null_type)
                return this.record_kind(source, kind, strict_bit, 8, mark, true)
        }
        if (kind & TypeFlagsUndefined) <> 0
        {
            if this.is_type_assignable_to(source, undefined_type)
                return this.record_kind(source, kind, strict_bit, 9, mark, true)
        }
        if (kind & TypeFlagsESSymbol) <> 0
        {
            if this.is_type_assignable_to(source, es_symbol_type)
                return this.record_kind(source, kind, strict_bit, 10, mark, true)
        }
        if (kind & TypeFlagsNonPrimitive) <> 0
        {
            if this.is_type_assignable_to(source, non_primitive_type)
                return this.record_kind(source, kind, strict_bit, 11, mark, true)
        }
        this.record_kind(source, kind, strict_bit, 12, mark, false)
    }

    ; The KINDPIN's entry — see KindEvent's header. It ANSWERS as well as records,
    ; so that every exit of the function above is one line and no exit can be added
    ; without a row. ★The verdict is 2 whenever anything stopped under the call,
    ; which is read off the mark rather than from the answer: a disjunct whose
    ; relation gave up returns false, and false-because-unrelated and
    ; false-because-unanswered are the two states this whole chapter turns on.
    procedure record_kind(this, source: ref[Type], kind: int, strict_bit: int, arm: int, mark: int, answer: bool) returns bool
    {
        var verdict 0
        if answer
            set verdict: 1
        if this.unported_mark() <> mark
            set verdict: 2
        if record_events
        {
            let ev &KindEvent^host(source.flags, kind, strict_bit, arm, verdict)
            kind_log.add(ev as ref[KindEvent])
        }
        answer
    }

    ; bothAreBigIntLike, whole — the arithmetic arm's second fork and the
    ; `isRelated` callback its report is handed.
    procedure both_are_big_int_like(this, left: ref[Type], right: ref[Type]) returns bool
    {
        if this.is_type_assignable_to_kind(left, TypeFlagsBigIntLike) = false
            return false
        this.is_type_assignable_to_kind(right, TypeFlagsBigIntLike)
    }

    ; checkArithmeticOperandType — TS2362 and TS2363, and the first two reports in
    ; this port whose whole content is one relation.
    ;
    ; ★★★ THE AWAIT HALF IS DROPPED AND THE ANSWER IS NOT, which is the rule
    ; check_this_expression's TS7041 note states from its own side: `isAwaitValid`
    ; decides only whether `Did_you_forget_to_use_await` is ATTACHED as related
    ; information, and AddRelatedInfo keeps a second span ON the diagnostic rather
    ; than in the list — tscaly_types dumps `C pos end code`, so no yardstick can
    ; see one in either direction. ★★What makes it a decision rather than a saving
    ; is the WALK: `getAwaitedTypeOfPromise` would run getAwaitedType over a
    ; promise's type argument, which this port cannot do, and a stop there would
    ; take the unit out of the comparison for a span nothing compares. The
    ; parameter is therefore not carried at all — a parameter with no reader is the
    ; shape this file is organized against.
    procedure check_arithmetic_operand_type(this, operand: ref[AstNode], t: ref[Type], diagnostic: int) returns bool
    {
        if number_or_bigint_type = null
        {
            this.record_unported("number-or-bigint-type-unminted", diagnostic)
            return false
        }
        ; ★★★ THE ERROR-TYPE GUARD IS RETIRED (slice 146) AND IT IS RETIRED BY
        ; MEASUREMENT, WHICH IS THE ONLY THING THAT COULD RETIRE IT. What stood
        ; here was slice 101's finding one: *`error_type` carries TypeFlagsAny, and
        ; the assignable block's `s&Any` arm answers TRUE against every target, so
        ; an operand whose type this port could not compute comes back ASSIGNABLE
        ; — which opens the `ok` gate and runs checkReferenceExpression on it.
        ; Measured: `++(S + S)` over an unresolved `S` collected a TS2357 where the
        ; reference reports TS2356, twice in 18 304 units and NOT ONCE at stage 1.*
        ;
        ; ★★★ THE ROW IT LEFT BEHIND WAS THE FRONTIER'S HEAD (+75 units / 114
        ; hits) and it was not a chapter: there is no absent callee at this line —
        ; the port had ANSWERED and the answer was the reference's own `errorType`.
        ; The row's price was therefore the price of a DEFENCE, and forty-five
        ; slices of type work is what expires a defence. Re-measured with the
        ; guard removed, on this slice's tree: stage 1 **1460 of 1667** against
        ; 1454 with it, diagcheck 1666 consistent / **0 differing** either way (one
        ; diagnostic more, and consistent); stage 2 **14 388 of 18 437** against
        ; 14 303, unported 3 881 against 3 966, UNEXPLAINED **161 either way** and
        ; the failure LISTS identical — so −85 unported = +85 matched + 0 new
        ; failures, which is §3.5er's arithmetic exactly.
        ;
        ; ★★ THE LESSON IS NOT *the guard was wrong*, it is **a conservative
        ; refusal is a MEASUREMENT and it ages the way an unreachability claim
        ; does** (§3.5eo, one polarity over): slice 101 measured a real invented
        ; report, and the two units that carried it now compute their operand's
        ; type. Nothing here re-derives that — the numbers above are the whole
        ; argument, and they are the numbers to re-run if this ever comes back.
        let mark this.unported_mark()
        if this.is_type_assignable_to(t, number_or_bigint_type as ref[Type])
            return true
        ; ★★★ A COMPARISON THAT STOPPED IS NOT A COMPARISON THAT ANSWERED FALSE,
        ; and this is the second place in the port where that distinction is the
        ; difference between a report and an INVENTED one (slice 101's finding one,
        ; arriving as a rule). The `false` is returned either way, which suppresses
        ; the assignment tail — the conservative direction: a lost TS2364 is a
        ; direction diagcheck cannot see, an invented TS2362 is the one it can.
        if this.unported_mark() <> mark
            return false
        this.error_on_node(operand, diagnostic)
        false
    }

    ; reportOperatorError — TS2365 and, for the equality group, TS2367.
    ;
    ; ★★★ EVERYTHING IT COMPUTES BEFORE THE REPORT DECIDES THE MESSAGE'S ARGUMENTS
    ; AND NOTHING ELSE, and that is a measurement of the artifact rather than a
    ; convenience: `wouldWorkWithAwait` selects between `c.error` and the same error
    ; with a related-info span attached, and `getBaseTypesIfUnrelated` chooses which
    ; two type NAMES are printed into `{1}` and `{2}`. The C section carries pos,
    ; end and code. So the fork this function really has is the one on the OPERATOR,
    ; and that one is transcribed.
    ;
    ; ★★ THE `isRelated` CALLBACK IS NOT A PARAMETER HERE FOR THE SAME REASON THE
    ; ERROR REPORTER IS NOT ONE IN is_simple_type_related_to: its only two readers
    ; are the two halves just named. The arithmetic arm's caller still EVALUATES
    ; both_are_big_int_like where the reference does, because that call is what
    ; chooses the arm — it is passed to the report and dropped, not skipped.
    ; the reference's `isRelated` func value as a tag (§3.18): 0 nil, 1 bothAreBigIntLike,
    ; 2 the `+` arm's close-enough kinds, 3 the relational compatibility, 4 equality comparable
    procedure operator_types_related(this, related_kind: int, left: ref[Type], right: ref[Type]) returns bool
    {
        if related_kind = 1
            return this.both_are_big_int_like(left, right)
        if related_kind = 2
        {
            let close TypeFlagsNumberLike | TypeFlagsBigIntLike | TypeFlagsStringLike | TypeFlagsAnyOrUnknown
            if this.is_type_assignable_to_kind(left, close) = false
                return false
            return this.is_type_assignable_to_kind(right, close)
        }
        if related_kind = 3
            return this.relational_operands_are_compatible(left, right)
        if related_kind = 4
        {
            if this.is_type_equality_comparable_to(left, right)
                return true
            return this.is_type_equality_comparable_to(right, left)
        }
        false
    }

    procedure report_operator_error(this, left_type: ref[Type], op_kind: int, right_type: ref[Type], error_node: ref[AstNode]?, related_kind: int)
    {
        var would_work_with_await false
        if related_kind <> 0
        {
            let awaited_left this.get_awaited_type_no_alias(left_type)
            let awaited_right this.get_awaited_type_no_alias(right_type)
            if awaited_left <> null
            {
                if awaited_right <> null
                {
                    var same (awaited_left as ref[Type]) = left_type
                    if same
                        set same: (awaited_right as ref[Type]) = right_type
                    if same = false
                        set would_work_with_await: this.operator_types_related(related_kind, awaited_left as ref[Type], awaited_right as ref[Type])
                }
            }
        }
        var effective_left left_type
        var effective_right right_type
        if would_work_with_await = false
        {
            if related_kind <> 0
            {
                let left_base this.get_base_type_of_literal_type(left_type)
                let right_base this.get_base_type_of_literal_type(right_type)
                if left_base <> null
                {
                    if right_base <> null
                    {
                        if this.operator_types_related(related_kind, left_base as ref[Type], right_base as ref[Type]) = false
                        {
                            set effective_left: left_base as ref[Type]
                            set effective_right: right_base as ref[Type]
                        }
                    }
                }
            }
        }
        let names_left this.type_display_arg(effective_left)
        let names_right this.type_display_arg(effective_right)
        var left_str names_left
        var right_str names_right
        if names_left = names_right
        {
            set left_str: this.type_name_for_error_display(effective_left)
            set right_str: this.type_name_for_error_display(effective_right)
        }
        var equality false
        if op_kind = KindEqualsEqualsEqualsToken
            set equality: true
        if op_kind = KindEqualsEqualsToken
            set equality: true
        if op_kind = KindExclamationEqualsEqualsToken
            set equality: true
        if op_kind = KindExclamationEqualsToken
            set equality: true
        if equality
        {
            this.error_on_node_or_null(error_node, DiagThis_comparison_appears_to_be_unintentional_because_the_types_0_and_1_have_no_overlap, left_str, right_str)
            return
        }
        this.error_on_node_or_null(error_node, DiagOperator_0_cannot_be_applied_to_types_1_and_2, Checker.arg_text(Scanner.token_to_string(op_kind)), left_str, right_str)
    }

    ; elaborateDidYouMeanToCallOrConstruct — *you wrote the FUNCTION where its
    ; RESULT was expected*.
    ;
    ; ★★★ ITS CONDITION IS THE MESSAGE: some call (or construct) signature of the
    ; source has a return type that IS related to the target, and neither `any`
    ; nor `never` — the two that relate to everything and would make the note fire
    ; for every failing call. Only then is the relation re-asked WITH the error
    ; node, so the ordinary TS2322 is emitted at the expression and the note is
    ; attached to it.
    ;
    ; ★★ THE NOTE ITSELF IS RELATED INFORMATION and therefore outside what a dump
    ; carries — see the family header. What is observable is the diagnostic it
    ; decorates, and that is this function's own `check_type_related_to`.
    procedure elaborate_did_you_mean_to_call_or_construct(this, node: ref[AstNode], source: ref[Type], target: ref[Type], relation: int, kind: int, head_code: int) returns bool
    {
        let mark this.unported_mark()
        let sigs this.get_signatures_of_type(source, kind)
        if this.unported_mark() <> mark
            return false
        if sigs = null
            return false
        let list sigs as ref[Array[ref[Signature]?]]
        let n list.get_length() as int
        var some false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let rt this.get_return_type_of_signature(row as ref[Signature])
            if this.unported_mark() <> mark
                return false
            if rt = null
                continue
            let r rt as ref[Type]
            if (r.flags & (TypeFlagsAny | TypeFlagsNever)) <> 0
                continue
            if this.check_type_related_to(r, target, relation, null)
                set some: true
            if this.unported_mark() <> mark
                return false
        }
        if some = false
            return false
        ; The relation is re-asked at the NODE, which is what emits the line the
        ; note would decorate — and it is asked WITH THE HEAD (slice 138), because
        ; the reference passes `headMessage` here too and then keeps the resulting
        ; diagnostic: `reportDiagnostic(diags[0].AddRelatedInfo(…))`. Only the
        ; related info is dropped. `false` here means it reported.
        let call_mark this.diagnostic_mark()
        if this.check_type_related_to_ex(source, target, relation, node, head_code) = false
        {
            var call_code DiagDid_you_mean_to_call_this_expression
            if kind = SignatureKindConstruct
                set call_code: DiagDid_you_mean_to_use_new_with_this_expression
            this.related_info_at(call_mark, node, call_code, null)
            return true
        }
        false
    }

    ; ── slice 130: the ERROR ELABORATION ────────────────────────────────────
    ;
    ; elaborateObjectLiteral / elaborateArrayLiteral / elaborateArrowFunction and
    ; the elaborateElement they all end in.
    ;
    ; ★★★ THE CHAPTER'S WHOLE PRODUCT IS *WHERE* THE DIAGNOSTIC LANDS, and that is
    ; exactly what a dump can see. `var x: { a: string } = { a: 1 }` without it is
    ; one TS2322 spanning the WHOLE literal; with it the relation is re-asked per
    ; property and the TS2322 lands on the `1`. So this is not an elaboration in
    ; the decorative sense — it moves a span, and a span is compared.
    ;
    ; ★★★ THE `diagnosticOutput` LIST IS NOT PORTED AND THE REASON IS THIS PORT'S
    ; STANDING CONTAINMENT: upstream every elaborator COLLECTS its diagnostics and
    ; the caller decides whether to emit them, because the collected diagnostic is
    ; then decorated with RELATED INFO (*the expected type comes from property 0*).
    ; A dump carries pos, end and code — related info is invisible in both
    ; directions — so the collection's only observable product is the emission
    ; itself, which this port does at the line. What IS carried is the reference's
    ; own control: `len(diags) == 0` decides the return, and that is the boolean
    ; `check_type_related_to_ex` already answers.
    ;
    ; ★★ THE RETURN VALUE IS AN OR-FOLD AND NOT AN EARLY EXIT: every property of an
    ; object literal is elaborated, so one bad property does not hide the next.
    procedure elaborate_object_literal(this, node: ref[AstNode], source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        if (target.flags & (TypeFlagsPrimitive | TypeFlagsNever)) <> 0
            return false
        let mark this.unported_mark()
        let props AstNode.properties_of(node)
        if props = null
            return false
        let list props as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        var reported false
        var i 0
        while i < n
        {
            let row list[i]
            set i: i + 1
            if row = null
                continue
            let prop row as ref[AstNode]
            let pk AstNode.kind_of(prop)
            if pk = KindSpreadAssignment
                continue
            let sym this.get_symbol_of_declaration(prop)
            if this.unported_mark() <> mark
                return reported
            if sym = null
                continue
            let name_type this.get_literal_type_from_property(sym as ref[Symbol], TypeFlagsStringOrNumberLiteralOrUnique, false)
            if this.unported_mark() <> mark
                return reported
            if name_type = null
                continue
            let nt name_type as ref[Type]
            if (nt.flags & TypeFlagsNever) <> 0
                continue
            let prop_name AstNode.name_of(prop)
            if prop_name = null
                continue
            var elaborated false
            var handled false
            if pk = KindSetAccessor
                set handled: true
            if pk = KindGetAccessor
                set handled: true
            if pk = KindMethodDeclaration
                set handled: true
            if pk = KindShorthandPropertyAssignment
                set handled: true
            if handled
                set elaborated: this.elaborate_element(source, target, relation, prop_name as ref[AstNode], null, nt, 0, 0, null)
            if pk = KindPropertyAssignment
            {
                ; The computed-name message, which replaces the relation's own
                ; TS2322 head where the property name is not a literal.
                var message 0
                if Checker.is_computed_non_literal_name(prop_name as ref[AstNode])
                    set message: DiagType_of_computed_property_s_value_is_0_which_is_not_assignable_to_type_1
                set elaborated: this.elaborate_element(source, target, relation, prop_name as ref[AstNode], AstNode.initializer_of(prop), nt, message, 0, null)
                set handled: true
            }
            if elaborated
                set reported: true
            if this.unported_mark() <> mark
                return reported
        }
        reported
    }

    ; elaborateArrayLiteral, whole.
    ;
    ; ★★★ THE RE-CHECK IN ITS HEAD IS THE FUNCTION. A `[1, "a"]` written against a
    ; tuple target has been checked WITHOUT that context and widened to
    ; `(string | number)[]`, which has no per-index property to elaborate against;
    ; so the literal is re-checked with the target pushed as the contextual type
    ; and `ForceTuple`, and only the tuple that comes back can be walked. A port
    ; that skipped the re-check would elaborate nothing for exactly the inputs the
    ; function exists for.
    procedure elaborate_array_literal(this, node: ref[AstNode], source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        if (target.flags & (TypeFlagsPrimitive | TypeFlagsNever)) <> 0
            return false
        let mark this.unported_mark()
        var src source
        if this.is_tuple_like_type(src) = false
        {
            this.push_contextual_type(node, target, false)
            let rechecked this.check_array_literal(node, CheckModeContextual | CheckModeForceTuple)
            this.pop_contextual_type()
            if this.unported_mark() <> mark
                return false
            if rechecked = null
                return false
            set src: rechecked as ref[Type]
            if this.is_tuple_like_type(src) = false
                return false
        }
        let elements AstNode.elements_of(node)
        if elements = null
            return false
        let list elements as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        let target_is_tuple_like this.is_tuple_like_type(target)
        var reported false
        var i 0
        while i < n
        {
            let row list[i]
            let index i
            set i: i + 1
            if row = null
                continue
            let element row as ref[AstNode]
            if AstNode.kind_of(element) = KindOmittedExpression
                continue
            if target_is_tuple_like
            {
                ; `getPropertyOfType(target, index.String())` — a tuple target with
                ; no member at this index has nothing to elaborate against, which
                ; is the arity error's job and not this one's.
                if this.tuple_has_index_property(target, index) = false
                    continue
                if this.unported_mark() <> mark
                    return reported
            }
            let name_type this.get_number_literal_type(Checker.number_bits_from_int(index))
            let check_node this.get_effective_check_node(element)
            if this.elaborate_element(src, target, relation, check_node, check_node, name_type, 0, 0, null)
                set reported: true
            if this.unported_mark() <> mark
                return reported
        }
        reported
    }

    ; `getPropertyOfType(target, jsnum.Number(i).String())` — the index rendered as
    ; a decimal NAME, which is what a tuple's members are keyed by.
    procedure tuple_has_index_property(this, target: ref[Type], index: int) returns bool
    {
        var buf u8[24]
        let len Checker.render_decimal(Slice[char](24 as size_t, &buf[0] as pointer[char]), index)
        let prop this.get_property_of_type(target, Slice[char](len, &buf[0] as pointer[char]))
        prop <> null
    }

    procedure render_decimal(out: Slice[char], value: int) returns int
    {
        if value = 0
        {
            out.put(0, "0" as char)
            return 1
        }
        var digits u8[24]
        let d &digits[0] as pointer[u8]
        var v value
        var n 0
        while v > 0
        {
            set *(d + n): ((v % 10) + 48) as u8
            set v: v / 10
            set n: n + 1
        }
        var i 0
        while i < n
        {
            out.put(i, (*(d + (n - 1 - i)) as char))
            set i: i + 1
        }
        n
    }

    ; elaborateElement — the routine every elaborator ends in.
    ;
    ; ★★★ IT ASKS THE RELATION TWICE AND THE SECOND ASK IS THE ONE THAT REPORTS.
    ; First without an error node, to find out whether this element is the problem
    ; at all; then, if it is, either RECURSIVELY through elaborate_error (so a
    ; nested literal narrows the span further) or with the element as the error
    ; node. That is why an element which relates fine costs nothing.
    ;
    ; ★★ `specificSource` IS THE EXPRESSION'S OWN TYPE, not the indexed access —
    ; `checkExpressionForMutableLocationWithContextualType` re-checks the initializer
    ; under the target property's type — and when the two DISAGREE the reference
    ; asks a second time with the indexed access, so that an expression whose
    ; contextual re-check happens to succeed still reports.
    ;
    ; ★ The `diagnosticFactory` parameter has one caller upstream (the JSX text
    ; child's dynamic message) and that chapter is elsewhere; it is not a
    ; parameter here for §3.5be's reason.
    ; ★★★ `text_child_code` IS THE REFERENCE'S `createDiagnostic` FUNC VALUE, AND IT
    ; COLLAPSES TO A CODE BECAUSE OF WHAT A DIAGNOSTIC IS HERE. Upstream the field
    ; is `func(prop *ast.Node) *ast.Diagnostic`, and its ONE producer builds
    ; `NewDiagnosticForNode(prop, <message>, tagName, childrenPropName,
    ; typeToString(childrenTargetType))` — a closure over three INTERPOLATION
    ; arguments and nothing else. This port's diagnostics carry a code and a span
    ; (the yardstick's own `C pos end code`), so the three captures have no reader
    ; and the func value is a code plus the `prop` the caller already passes:
    ; §3.18's tag with the tag left implicit, 0 meaning *no custom diagnostic*.
    procedure elaborate_element(this, source: ref[Type], target: ref[Type], relation: int, prop: ref[AstNode], next: ref[AstNode]?, name_type: ref[Type], error_code: int, text_child_code: int, text_child_args: ref[Array[String]]?) returns bool
    {
        let mark this.unported_mark()
        let target_prop_type this.get_best_match_indexed_access_type_or_undefined(source, target, name_type)
        if this.unported_mark() <> mark
            return false
        if target_prop_type = null
            return false
        var tpt target_prop_type as ref[Type]
        ; "Don't elaborate on indexes on generic variables."
        if (tpt.flags & TypeFlagsIndexedAccess) <> 0
            return false
        let source_prop_type this.get_indexed_access_type_or_undefined(source, name_type, AccessFlagsNone, null, null)
        if this.unported_mark() <> mark
            return false
        if source_prop_type = null
            return false
        var spt source_prop_type as ref[Type]
        if this.check_type_related_to(spt, tpt, relation, null)
            return false
        if this.unported_mark() <> mark
            return false
        if next <> null
        {
            if this.elaborate_error(next, spt, tpt, relation, 0)
                return true
            if this.unported_mark() <> mark
                return false
        }
        var specific_source spt
        if next <> null
        {
            let checked this.check_expression_for_mutable_location_with_contextual_type(next as ref[AstNode], spt)
            if this.unported_mark() <> mark
                return false
            if checked = null
                return false
            set specific_source: checked as ref[Type]
        }
        let element_mark this.diagnostic_mark()
        ; "Use the custom diagnostic factory if provided (e.g., for JSX text
        ; children with dynamic error messages)" — and it comes FIRST, ahead of the
        ; exactOptional fork and of the general report below.
        if text_child_code <> 0
        {
            this.error_on_node_with(prop, text_child_code, text_child_args)
            this.elaborate_element_related_info(element_mark, source, target, name_type)
            return true
        }
        ; The exactOptionalPropertyTypes fork — its own message, and the option is
        ; unset in this harness, so the arm is written and constant-false.
        if Checker.exact_optional_property_types()
        {
            if this.is_exact_optional_property_mismatch(specific_source, tpt)
            {
                this.error_on_node(prop, DiagType_0_is_not_assignable_to_type_1_with_exactOptionalPropertyTypes_Colon_true_Consider_adding_undefined_to_the_type_of_the_target)
                this.elaborate_element_related_info(element_mark, source, target, name_type)
                return true
            }
            if this.unported_mark() <> mark
                return false
        }
        ; removeMissingType on both sides, gated on the two OPTIONALITIES — a
        ; target property that is optional carries the missing type, and comparing
        ; against it would report about `undefined` rather than about the value.
        var name_buf u8[64]
        let name_data this.get_property_name_from_index(name_type, null, Slice[char](64 as size_t, &name_buf[0] as pointer[char]))
        if this.unported_mark() <> mark
            return false
        var target_is_optional false
        var source_is_optional false
        if name_data.data <> null
        {
            let tp this.get_property_of_type(target, name_data)
            if this.unported_mark() <> mark
                return false
            if tp <> null
            {
                if (Symbol.flags_of(tp as ref[Symbol]) & SymbolFlagsOptional) <> 0
                    set target_is_optional: true
            }
            let sp this.get_property_of_type(source, name_data)
            if this.unported_mark() <> mark
                return false
            if sp <> null
            {
                if (Symbol.flags_of(sp as ref[Symbol]) & SymbolFlagsOptional) <> 0
                    set source_is_optional: true
            }
        }
        let tpt2 this.remove_missing_type(tpt, target_is_optional)
        if tpt2 = null
            return false
        set tpt: tpt2 as ref[Type]
        var both_optional false
        if target_is_optional
        {
            if source_is_optional
                set both_optional: true
        }
        let spt2 this.remove_missing_type(spt, both_optional)
        if spt2 = null
            return false
        set spt: spt2 as ref[Type]
        let result this.check_type_related_to_ex(specific_source, tpt, relation, prop, error_code)
        if this.unported_mark() <> mark
            return false
        var reported true
        if result
        {
            ; "If for whatever reason the expression type doesn't yield an error,
            ; make sure we still issue an error on the sourcePropType."
            set reported: false
            if specific_source <> spt
            {
                if this.check_type_related_to_ex(spt, tpt, relation, prop, error_code) = false
                    set reported: true
            }
        }
        if reported
            this.elaborate_element_related_info(element_mark, source, target, name_type)
        reported
    }

    ; elaborateElement's related information on the diagnostic it reported: the
    ; index signature, else the property (or the type) the expected type comes from,
    ; neither from a default library file
    procedure elaborate_element_related_info(this, element_mark: int, source: ref[Type], target: ref[Type], name_type: ref[Type])
    {
        let dl diagnostics as ref[DiagnosticList]
        if dl.length() <= element_mark
            return
        let index element_mark
        let mark this.unported_mark()
        var property_name: Slice[char] ""
        var target_prop: ref[Symbol]? null
        if Checker.is_type_usable_as_property_name(name_type)
        {
            var name_buf u8[64]
            let name_data this.get_property_name_from_index(name_type, null, Slice[char](64 as size_t, &name_buf[0] as pointer[char]))
            if this.unported_mark() <> mark
                return
            if name_data.data <> null
            {
                set property_name: this.copy_name_to_page(name_data)
                set target_prop: this.get_property_of_type(target, property_name)
                if this.unported_mark() <> mark
                    return
            }
        }
        var issued false
        if target_prop = null
        {
            let info this.get_applicable_index_info(target, name_type)
            if this.unported_mark() <> mark
                return
            if info <> null
            {
                let decl (info as ref[IndexInfo]).declaration
                if decl <> null
                {
                    if this.node_is_in_lib(decl as ref[AstNode]) = false
                    {
                        set issued: true
                        this.related_info_at(index, decl, DiagThe_expected_type_comes_from_this_index_signature, null)
                    }
                }
            }
        }
        if issued
            return
        var target_node: ref[AstNode]? null
        if target_prop <> null
            set target_node: Symbol.declaration_at(target_prop as ref[Symbol], 0)
        if (target_node = null) and (target.symbol <> null)
            set target_node: Symbol.declaration_at(target.symbol as ref[Symbol], 0)
        if target_node = null
            return
        var name_arg Checker.arg_text(property_name)
        if ((property_name.length as int) = 0) or ((name_type.flags & TypeFlagsUniqueESSymbol) <> 0)
            set name_arg: this.type_arg(name_type)
        if this.node_is_in_lib(target_node as ref[AstNode])
            return
        let args this.message_args()
        args.add(name_arg)
        args.add(this.type_arg(target))
        this.related_info_at(index, target_node, DiagThe_expected_type_comes_from_property_0_which_is_declared_here_on_type_1, args)
    }

    ; getBestMatchIndexedAccessTypeOrUndefined — the target property's type, and
    ; for a UNION target the one BEST MATCHING constituent's, so that an
    ; elaboration against `A | B` reports about the constituent the source was
    ; trying to be.
    procedure get_best_match_indexed_access_type_or_undefined(this, source: ref[Type], target: ref[Type], name_type: ref[Type]) returns ref[Type]?
    {
        let mark this.unported_mark()
        let idx this.get_indexed_access_type_or_undefined(target, name_type, AccessFlagsNone, null, null)
        if this.unported_mark() <> mark
            return null
        if idx <> null
            return idx
        if (target.flags & TypeFlagsUnion) = 0
            return null
        let best this.get_best_matching_type(source, target, RelationAssignable)
        if this.unported_mark() <> mark
            return null
        if best = null
            return null
        this.get_indexed_access_type_or_undefined(best as ref[Type], name_type, AccessFlagsNone, null, null)
    }

    procedure check_expression_for_mutable_location_with_contextual_type(this, next: ref[AstNode], source_prop_type: ref[Type]) returns ref[Type]?
    {
        this.push_contextual_type(next, source_prop_type, false)
        let result this.check_expression_for_mutable_location(next, CheckModeContextual)
        this.pop_contextual_type()
        result
    }

    ; isExactOptionalPropertyMismatch — *the source carries `undefined` where the
    ; target, under exactOptionalPropertyTypes, carries the MISSING type instead*.
    ; The option is unset in this harness, so the predicate has no live caller; it
    ; is written because its caller's fork is.
    ; len(getExactOptionalUnassignableProperties(source, target)) != 0
    procedure has_exact_optional_unassignable_properties(this, source: ref[Type], target: ref[Type]) returns bool
    {
        if Checker.is_tuple_type(source) and Checker.is_tuple_type(target)
            return false
        let props this.get_properties_of_type(target)
        var i 0
        while i < Checker.symbol_count(props)
        {
            let row (props as ref[Array[ref[Symbol]?]])[i]
            set i: i + 1
            if row = null
                continue
            let tps row as ref[Symbol]
            let st this.get_type_of_property_of_type(source, Symbol.name_of(tps))
            let tt this.get_type_of_symbol(tps)
            if (st <> null) and (tt <> null)
            {
                if this.is_exact_optional_property_mismatch(st as ref[Type], tt as ref[Type])
                    return true
            }
        }
        false
    }

    function is_exact_optional_property_mismatch(this, source: ref[Type], target: ref[Type]) returns bool
    {
        if Checker.maybe_type_of_kind(source, TypeFlagsUndefined) = false
            return false
        this.contains_missing_type(target)
    }

    ; elaborateArrowFunction — the RETURN EXPRESSION of a concise arrow, and only
    ; that: a block body has no single expression to blame, and an annotated
    ; parameter means the mismatch is the annotation's rather than the body's.
    procedure elaborate_arrow_function(this, node: ref[AstNode], source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        let body AstNode.body_of(node)
        if body = null
            return false
        if AstNode.kind_of(body as ref[AstNode]) = KindBlock
            return false
        let params AstNode.parameters_of(node)
        if params <> null
        {
            let plist params as ref[Array[ref[AstNode]?]]
            let pn plist.get_length() as int
            var pi 0
            while pi < pn
            {
                let prow plist[pi]
                if prow <> null
                {
                    if AstNode.type_of(prow as ref[AstNode]) <> null
                        return false
                }
                set pi: pi + 1
            }
        }
        let mark this.unported_mark()
        let source_sig this.get_single_call_signature(source)
        if this.unported_mark() <> mark
            return false
        if source_sig = null
            return false
        let target_signatures this.get_signatures_of_type(target, SignatureKindCall)
        if this.unported_mark() <> mark
            return false
        if target_signatures = null
            return false
        let tsigs target_signatures as ref[Array[ref[Signature]?]]
        let tn tsigs.get_length() as int
        if tn = 0
            return false
        let source_return this.get_return_type_of_signature(source_sig as ref[Signature])
        if this.unported_mark() <> mark
            return false
        if source_return = null
            return false
        let return_types &Array[ref[Type]?]()
        var i 0
        while i < tn
        {
            let row tsigs[i]
            if row <> null
            {
                let rt this.get_return_type_of_signature(row as ref[Signature])
                if this.unported_mark() <> mark
                    return false
                return_types.add(rt)
            }
            set i: i + 1
        }
        let target_return this.get_union_type(return_types)
        if this.unported_mark() <> mark
            return false
        if target_return = null
            return false
        let sr source_return as ref[Type]
        let tr target_return as ref[Type]
        if this.check_type_related_to(sr, tr, relation, null)
            return false
        if this.unported_mark() <> mark
            return false
        if this.elaborate_error(body, sr, tr, relation, 0)
            return true
        if this.unported_mark() <> mark
            return false
        ; The tail: report on the return expression itself.
        let arrow_mark this.diagnostic_mark()
        let failed this.check_type_related_to(sr, tr, relation, body) = false
        if (failed = false) or (this.diagnostic_mark() <= arrow_mark)
            return failed
        if target.symbol <> null
            this.related_info_at(arrow_mark, Symbol.declaration_at(target.symbol as ref[Symbol], 0), DiagThe_expected_type_comes_from_the_return_type_of_this_signature, null)
        if (b.get_function_flags(node) & FunctionFlagsAsync) = 0
        {
            let then_type this.get_type_of_property_of_type(sr, "then")
            if (this.unported_mark() = mark) and (then_type = null)
            {
                let promise this.create_promise_type(sr)
                if (this.unported_mark() = mark) and (promise <> null)
                {
                    if this.check_type_related_to(promise as ref[Type], tr, relation, null)
                        this.related_info_at(arrow_mark, node, DiagDid_you_mean_to_mark_this_function_as_async, null)
                }
            }
        }
        failed
    }

    ; elaborateError, whole.
    ;
    ; ★★★ ITS FOUR ELABORATING ARMS HAVE NO INPUT AND THE PROOF IS ONE SENTENCE:
    ; an object literal, an array literal, an arrow function and a JSX attributes
    ; list all have an OBJECT type, `source` IS that expression's type, and this
    ; function is reached only after is_type_related_to answered without stopping —
    ; which for an Object source it cannot, because the structured branch stops.
    ; They are written as reports rather than left out, so the slice that opens the
    ; recursion meets them at the reference's own fork.
    ;
    ; ★★ `elaborateDidYouMeanToCallOrConstruct` IS LEFT OUT WITH A VERIFIED
    ; CONTAINMENT, and it is the one claim in this chapter that rests on lib.d.ts
    ; rather than on this port. It asks whether the SOURCE has a call or construct
    ; signature whose return type is related to the target; `getSignaturesOfType`
    ; answers through the APPARENT type, which for every non-structured source is a
    ; global wrapper interface — and none of String, Number, Boolean, BigInt,
    ; Symbol, Object or Function-less `void`/`null`/`undefined` declares a call or
    ; a construct signature at the INSTANCE side (checked in the pinned submodule's
    ; own lib.es5.d.ts). ★The second half of this note — *the port could not ask the
    ; question if it wanted to: get_apparent_type reports `global-apparent-type` for
    ; exactly those flags* — expired in slice 154, which gave those five arms the
    ; reference's own answer; the containment above never rested on it.
    ;
    ; ★ `isOrHasGenericConditional(target)` needs Conditional or an Intersection
    ; holding one, both structured; and `compilerOptions.NoCheck` is unset, which
    ; is the plain-equality reading of an unset option (§3.5cw).
    procedure elaborate_error(this, node: ref[AstNode]?, source: ref[Type], target: ref[Type], relation: int, head_code: int) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        ; elaborateDidYouMeanToCallOrConstruct, asked twice (Construct, then Call)
        ; and confined to the one source shape that can answer: it reports at the
        ; EXPRESSION's span where the fall-through below reports at the error
        ; node's, so a wrong answer here is a wrong SPAN and not a missing note.
        ; ★★A non-structured source cannot answer — getSignaturesOfType goes
        ; through the apparent type, which is a global wrapper interface, and none
        ; of String, Number, Boolean, BigInt, Symbol and Object declares a call or
        ; a construct signature on its instance side (read in the pinned
        ; submodule's own src/lib/es5.d.ts). ★★★An OBJECT source can, and this port
        ; can ask it: what it cannot do is the second half — whether the signature's
        ; RETURN type is related to the target — so the row stands for the whole
        ; arm the moment a signature exists.
        if (source.flags & TypeFlagsObject) <> 0
        {
            if this.elaborate_did_you_mean_to_call_or_construct(n, source, target, relation, SignatureKindConstruct, head_code)
                return true
            if this.elaborate_did_you_mean_to_call_or_construct(n, source, target, relation, SignatureKindCall, head_code)
                return true
        }
        let k AstNode.kind_of(n)
        if k = KindAsExpression
        {
            ; The reference FALLS THROUGH to the parenthesized arm for a const
            ; assertion and breaks out of the switch otherwise.
            if Checker.is_const_assertion(n) = false
                return false
            return this.elaborate_error(AstNode.expression_of(n), source, target, relation, head_code)
        }
        if k = KindJsxExpression
            return this.elaborate_error(AstNode.expression_of(n), source, target, relation, head_code)
        if k = KindParenthesizedExpression
            return this.elaborate_error(AstNode.expression_of(n), source, target, relation, head_code)
        if k = KindBinaryExpression
        {
            let op AstNode.binary_operator_kind(n)
            if op = KindEqualsToken
                return this.elaborate_error(AstNode.binary_right_of(n), source, target, relation, head_code)
            if op = KindCommaToken
                return this.elaborate_error(AstNode.binary_right_of(n), source, target, relation, head_code)
            return false
        }
        if k = KindObjectLiteralExpression
            return this.elaborate_object_literal(n, source, target, relation)
        if k = KindArrayLiteralExpression
            return this.elaborate_array_literal(n, source, target, relation)
        if k = KindArrowFunction
            return this.elaborate_arrow_function(n, source, target, relation)
        if k = KindJsxAttributes
            return this.elaborate_jsx_components(n, source, target, relation)
        false
    }

    ; ── elaborateJsxComponents and the CHILDREN elaboration (slice 162) ──────
    ;
    ; jsx.go's own elaborator, and it is the only arm of `elaborateError` whose
    ; input is not an expression: a JsxAttributes node's PROPERTIES elaborate like
    ; an object literal's, and then the containing element's CHILDREN elaborate
    ; against whatever the children property's type turned out to be.
    ;
    ; ★★★ THE TWO HALVES ANSWER DIFFERENT QUESTIONS AND ONLY THE SECOND IS JSX-
    ; SPECIFIC. The attribute half is `elaborate_element` per property, skipping a
    ; spread and a hyphenated name (neither can be a property of the target); the
    ; children half asks whether the target's children slot wants ONE child or a
    ; sequence, and reports an ARITY message where the source cannot be related at
    ; all. That second question is why the row was 38 units: nothing else in the
    ; checker produces TS2745 or TS2746.
    procedure elaborate_jsx_components(this, node: ref[AstNode], source: ref[Type], target: ref[Type], relation: int) returns bool
    {
        let mark this.unported_mark()
        var reported false
        let props AstNode.properties_of(node)
        if props <> null
        {
            let list props as ref[Array[ref[AstNode]?]]
            let n list.get_length() as int
            var i 0
            while i < n
            {
                let prop list[i]
                set i: i + 1
                if prop = null
                    continue
                let pn prop as ref[AstNode]
                if AstNode.kind_of(pn) = KindJsxSpreadAttribute
                    continue
                let name AstNode.name_of(pn)
                if name = null
                    continue
                var nd Slice[char]()
                if Checker.jsx_tag_name_text(this.host, name as ref[AstNode], &nd) = false
                    continue
                if Checker.is_hyphenated_jsx_name(nd)
                    continue
                let name_type this.get_string_literal_type(nd)
                if (name_type.flags & TypeFlagsNever) <> 0
                    continue
                if this.elaborate_element(source, target, relation, name as ref[AstNode], AstNode.initializer_of(pn), name_type, 0, 0, null)
                    set reported: true
                if this.unported_mark() <> mark
                    return reported
            }
        }
        ; The children half runs only for an OPENING element inside a JsxElement —
        ; a self-closing element has no children and a fragment is not this shape.
        let parent AstNode.parent_node_of(node)
        if Checker.kind_or_unknown(parent) <> KindJsxOpeningElement
            return reported
        let containing AstNode.parent_node_of(parent as ref[AstNode])
        if Checker.kind_or_unknown(containing) <> KindJsxElement
            return reported
        let element containing as ref[AstNode]
        let ns this.get_jsx_namespace_at(node)
        if this.unported_mark() <> mark
            return reported
        var children_prop Slice[char]()
        var stopped false
        let has_children_name this.get_jsx_element_children_property_name(ns, &children_prop, &stopped)
        if stopped
            return reported
        ; "if childrenPropName == InternalSymbolNameMissing { childrenPropName =
        ; \"children\" }" — the DEFAULT, and the empty-string state keeps its own
        ; meaning: only MISSING falls back.
        if has_children_name = false
            set children_prop: "children"
        let children_name_type this.get_string_literal_type(children_prop)
        let children_target_type this.get_indexed_access_type(target, children_name_type)
        if this.unported_mark() <> mark
            return reported
        if children_target_type = null
            return reported
        let ctt children_target_type as ref[Type]
        let kids AstNode.jsx_children_of(element)
        let valid_count AstNode.semantic_jsx_child_count(kids)
        if valid_count = 0
            return reported
        ; ★★★ THE PREDICATE PAIR IS CHOSEN BY WHETHER `Iterable` EXISTS AT ALL, and
        ; the two choices are not interchangeable: with a global Iterable the split
        ; is *assignable to Iterable<any>* / *not*, without one it is *array or
        ; tuple like* / *not*. `filter_type_by_jsx_children_kind` is §3.18's tag
        ; over the four, because a predicate cannot travel as a value here.
        let iterable_type this.get_global_iterable_type()
        if this.unported_mark() <> mark
            return reported
        var array_like: ref[Type]? null
        var non_array_like: ref[Type]? null
        var have_iterable false
        if iterable_type <> null
        {
            if empty_generic_type = null
                set have_iterable: true
            else
            {
                if (iterable_type as ref[Type]) <> empty_generic_type as ref[Type]
                    set have_iterable: true
            }
        }
        if have_iterable
        {
            let any_iterable this.create_iterable_type(any_type)
            if this.unported_mark() <> mark
                return reported
            if any_iterable = null
                return reported
            set array_like: this.filter_type_by_jsx_children_kind(ctt, JsxChildFilterAssignable, any_iterable)
            if this.unported_mark() <> mark
                return reported
            set non_array_like: this.filter_type_by_jsx_children_kind(ctt, JsxChildFilterNotAssignable, any_iterable)
            if this.unported_mark() <> mark
                return reported
        }
        else
        {
            set array_like: this.filter_type_by_jsx_children_kind(ctt, JsxChildFilterArrayLike, null)
            if this.unported_mark() <> mark
                return reported
            set non_array_like: this.filter_type_by_jsx_children_kind(ctt, JsxChildFilterNotArrayLike, null)
            if this.unported_mark() <> mark
                return reported
        }
        if array_like = null
            return reported
        if non_array_like = null
            return reported
        let alp array_like as ref[Type]
        let nalp non_array_like as ref[Type]
        ; getInvalidTextualChildDiagnostic is a memoised CLOSURE upstream; here its
        ; whole product is a code (see elaborate_element's own note), so the memo
        ; has nothing to hold and the code is passed straight down.
        let opening AstNode.jsx_element_opening_of(element)
        let tag_for_error AstNode.jsx_tag_name_of(opening)
        if valid_count > 1
        {
            if alp <> never_type
            {
                let child_types this.check_jsx_children(element, CheckModeNormal)
                if this.unported_mark() <> mark
                    return reported
                let real_source this.create_tuple_type(child_types)
                if this.unported_mark() <> mark
                    return reported
                if real_source = null
                    return reported
                let elements this.generate_jsx_children(element, tag_for_error, children_prop, ctt)
                if this.elaborate_iterable_or_array_like_target_elementwise(elements, real_source as ref[Type], alp, relation)
                    set reported: true
                if this.unported_mark() <> mark
                    return reported
                return reported
            }
            ; "arity mismatch"
            let src_children this.get_indexed_access_type(source, children_name_type)
            if this.unported_mark() <> mark
                return reported
            if src_children = null
                return reported
            ; ★★★ THIS GUARD IS WHERE THE THIRTEEN REVEALED FAILURES ENTER, AND THE
            ; DIVERGENCE IS NOT IN THIS FUNCTION — probed 2026-09-09 on
            ; `compiler/jsxChildrenIndividualErrorElaborations`. With no `children`
            ; attribute on the element, `source` has no such property, so this
            ; indexed access answers `error_type` (TypeFlagsAny) and
            ; `is_type_related_to` answers TRUE under RelationAssignable — the
            ; source-Any arm of `is_simple_type_related_to`, which is the
            ; reference's own line. The report is therefore skipped and the caller's
            ; general TS2741 comes out, where the reference emits TS2746 TWICE.
            ; ★A probe confirmed the branch SELECTION is right (valid_count and the
            ; never-ness of both filtered parts are what the reference's conditions
            ; compute); what is not established is why the reference's guard answers
            ; the other way with an Any source. **The double emission is the lead**:
            ; §3.5gh(5)'s shape, one visit at check time and one at walk time, which
            ; would mean the reference reaches this line twice and at least once
            ; under a relation whose source-Any arm does not fire.
            if this.is_type_related_to(src_children as ref[Type], ctt, relation) = false
            {
                let name_arg22 this.type_arg(ctt)
                ; ★★★ TWICE, AND IT IS AN UPSTREAM DEFECT REPRODUCED ON PURPOSE. The reference
                ; writes `diag := c.error(…)` and then `c.reportDiagnostic(diag,
                ; diagnosticOutput)` — and `c.error` has ALREADY called addDiagnostic, so with
                ; the nil diagnosticOutput the elaboration passes, the same diagnostic is
                ; appended a SECOND time. jsx.go:345 and jsx.go:358 are the only two sites in
                ; the reference with that shape; every other reporter builds the diagnostic
                ; with NewDiagnosticForNode and reports it once. The yardstick compares the
                ; reference's C lines, so this port emits it twice to MATCH. ★The message
                ; ARGUMENTS are evaluated once, which is why name_type_for_message stays above
                ; the pair rather than beside each call (§3.5hs).
                this.error_on_node_or_null(tag_for_error, DiagThis_JSX_tag_s_0_prop_expects_a_single_child_of_type_1_but_multiple_children_were_provided, Checker.arg_text(children_prop), name_arg22)
                this.error_on_node_or_null(tag_for_error, DiagThis_JSX_tag_s_0_prop_expects_a_single_child_of_type_1_but_multiple_children_were_provided, Checker.arg_text(children_prop), name_arg22)
                set reported: true
            }
            if this.unported_mark() <> mark
                return reported
            return reported
        }
        if nalp <> never_type
        {
            let child AstNode.semantic_jsx_child_at(kids, 0)
            if child = null
                return reported
            var error_node: ref[AstNode]? null
            var inner: ref[AstNode]? null
            var text_code 0
            Checker.elaboration_element_for_jsx_child(child as ref[AstNode], &error_node, &inner, &text_code)
            if error_node <> null
            {
                var text_args: ref[Array[String]]? null
                if text_code <> 0
                    set text_args: this.jsx_text_child_args(tag_for_error, children_prop, ctt)
                if this.elaborate_element(source, target, relation, error_node as ref[AstNode], inner, children_name_type, 0, text_code, text_args)
                    set reported: true
                if this.unported_mark() <> mark
                    return reported
            }
            return reported
        }
        ; "arity mismatch", the other direction
        let src_children this.get_indexed_access_type(source, children_name_type)
        if this.unported_mark() <> mark
            return reported
        if src_children = null
            return reported
        if this.is_type_related_to(src_children as ref[Type], ctt, relation) = false
        {
            let name_arg23 this.type_arg(ctt)
            ; Twice, for the reason the pair in the branch above carries: the reference's
            ; `c.error` + `c.reportDiagnostic(diag, nil)` appends one diagnostic twice
            ; (jsx.go:358).
            this.error_on_node_or_null(tag_for_error, DiagThis_JSX_tag_s_0_prop_expects_type_1_which_requires_multiple_children_but_only_a_single_child_was_provided, Checker.arg_text(children_prop), name_arg23)
            this.error_on_node_or_null(tag_for_error, DiagThis_JSX_tag_s_0_prop_expects_type_1_which_requires_multiple_children_but_only_a_single_child_was_provided, Checker.arg_text(children_prop), name_arg23)
            set reported: true
        }
        reported
    }

    ; filterType at the four predicates elaborateJsxComponents needs — §3.18's tag
    ; beside the twenty other fixed-predicate filters of this file. ★The `origin`
    ; branch is not written, for filter_type_outside_flags' reason (read its note
    ; before "fixing" any of them).
    procedure filter_type_by_jsx_children_kind(this, t: ref[Type], kind: int, any_iterable: ref[Type]?) returns ref[Type]?
    {
        let mark this.unported_mark()
        if (t.flags & TypeFlagsUnion) = 0
        {
            ; ★The `Never` disjunct comes FIRST, as it does upstream
            ; (`t.flags&TypeFlagsNever != 0 || f(t)`): `never` is its own answer
            ; without asking the predicate.
            if (t.flags & TypeFlagsNever) <> 0
                return t
            let keep this.jsx_children_filter_admits(t, kind, any_iterable)
            if this.unported_mark() <> mark
                return null
            if keep
                return t
            return never_type
        }
        let types Checker.union_types_of(t)
        if types = null
            return t
        let list types as ref[Array[ref[Type]?]]
        let n list.get_length() as int
        let out this.new_type_list(null)
        var changed false
        var i 0
        while i < n
        {
            let u list[i]
            if u <> null
            {
                let keep this.jsx_children_filter_admits(u as ref[Type], kind, any_iterable)
                if this.unported_mark() <> mark
                    return null
                if keep
                    out.add(u)
                else
                    set changed: true
