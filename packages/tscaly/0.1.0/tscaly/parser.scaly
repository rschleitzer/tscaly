; The reference's jsdocScannerInfo — what the scanner noticed about the JSDoc
; comment preceding the token the parser is about to consume. It is captured at
; the START of a construct, because by the time the node is finished the token
; carrying the flags is long gone.
; The reference's ParsingContext, for the lists these slices parse — the
; comma-delimited ones, the two UNDELIMITED ones a class body is made of, and
; since slice 13c the source file's own statement list.
;
; ★★★ THEY ARE BIT POSITIONS AGAIN, which is what slice 13c bought. Upstream
; keeps `parsingContexts`, a SET of the lists currently open, and consults it
; during error recovery: when a list cannot make sense of the token it is
; looking at, `isInSomeParsingContext` asks every OPEN list whether that token
; would start an element of ITS kind or terminate it — if one says yes, the
; inner list gives up so the outer one can have the token, and if none does, the
; token is skipped and the inner list tries again. That is the whole of the
; reference's list recovery, and it is why a stray `}` closes the construct it
; belongs to instead of eating the rest of the file.
;
; The numbering is still ours, because it is the SET membership that matters and
; not the values; what changed is that the numbers now have to be dense and
; below PCCount, since is_in_some_parsing_context iterates them.
;
; ★ Add an entry only when the list it names is actually parsed — an unreachable
; arm of is_list_element/is_list_terminator is an untested transcription of a
; table that is easy to get subtly wrong, and now it would also be a bit that
; can never be set. The reference's six remaining contexts (the three JSX ones,
; the two JSDoc ones, PCRestProperties) are exactly the lists this port does not
; parse.
define PCTypeArguments:       int 0
define PCTypeParameters:      int 1
define PCTupleElementTypes:   int 2
define PCParameters:          int 3
define PCArgumentExpressions: int 4
define PCArrayLiteralMembers: int 5
define PCObjectLiteralMembers: int 6
define PCClassMembers:        int 7
define PCHeritageClauses:     int 8
define PCHeritageClauseElement: int 9
define PCTypeMembers:         int 10
define PCEnumMembers:         int 11
define PCBlockStatements:     int 12
define PCImportOrExportSpecifiers: int 13
define PCImportAttributes:    int 14
define PCSwitchClauses:       int 15
define PCSwitchClauseStatements: int 16
define PCVariableDeclarations: int 17
define PCObjectBindingElements: int 18
define PCArrayBindingElements: int 19
define PCSourceElements:      int 20

; Slice 23. The six argument names processPragmasIntoFields reads off a
; `<reference>` directive. They are an internal id rather than the reference's
; map key because the store here is a flat array of triples — see
; extract_pragmas, which also says why an argument named none of these is
; parsed and then dropped.
define PragmaArgTypes:          int 0
define PragmaArgLib:            int 1
define PragmaArgPath:           int 2
define PragmaArgResolutionMode: int 3
define PragmaArgPreserve:       int 4
define PragmaArgNoDefaultLib:   int 5

; Slice 20. PCJsxChildren is the odd one: parse_jsx_children does NOT go through
; parse_list — it has its own loop, because every child needs a JSX RE-SCAN
; before it can be recognised. The context is still entered, and that is what it
; is for: is_in_some_parsing_context asks every OPEN list about the token an inner
; list has choked on, so a `</` inside a nested construct terminates the child
; list rather than being skipped.
define PCJsxAttributes:       int 21
define PCJsxChildren:         int 22

; Slice 21. PCJSDocComment is entered by parse_jsdoc_comment and by nothing
; else: no list is parsed under it. What it is FOR is the same thing
; PCJsxChildren is for — is_in_some_parsing_context asks every OPEN list about a
; token an inner list has choked on, and this context answers `true`
; UNCONDITIONALLY (the reference's `case PCJSDocComment: return true` in
; isListElement). So while a JSDoc comment is being parsed, an inner list gives
; up rather than skipping a token, which keeps a malformed type inside a comment
; from eating the rest of it.
define PCJSDocComment:        int 23

; The reference's PCCount — the loop bound of is_in_some_parsing_context, which
; is the only reason the values have to be dense.
define PCCount:               int 24

; The reference's `jsdocState` — the four states parseJSDocCommentWorker and
; parseTagComments run on. It IS the grammar of a comment: which states admit a
; tag, and which of the two SCANNERS the next token comes from.
define JSDOC_STATE_BEGINNING_OF_LINE: int 0
define JSDOC_STATE_SAW_ASTERISK:      int 1
define JSDOC_STATE_SAVING_COMMENTS:   int 2
define JSDOC_STATE_SAVING_BACKTICKS:  int 3

; The reference's `propertyLikeParse` — a BIT SET, and it has to stay one:
; tryParseChildTag tests `target & t` with a `t` that carries two bits for
; `@param`, so a plain enum would not express the question.
define PROPERTY_LIKE_PROPERTY:           int 1
define PROPERTY_LIKE_PARAMETER:          int 2
define PROPERTY_LIKE_CALLBACK_PARAMETER: int 4

; parseJSDocLinkPrefix's answer. The reference returns `(string, bool)` and the
; string is immediately compared against three literals to select a node kind,
; so the closed value set travels as an int here (§3.6).
define JSDOC_LINK_NONE:  int 0
define JSDOC_LINK_LINK:  int 1
define JSDOC_LINK_CODE:  int 2
define JSDOC_LINK_PLAIN: int 3

; ── operator precedence, ported from internal/ast/precedence.go ─────────────
;
; The reference declares these with `iota`, so the VALUES are an artifact of the
; declaration order and only their ORDER is meaningful — which is why they are
; written out here rather than derived. Two of them are aliases rather than
; positions of their own (Coalesce IS LogicalOR), exactly as upstream has it.
;
; Invalid is -1 and is lower than every real precedence, which is what makes
; parseBinaryExpressionRest stop on a token that is not a binary operator: the
; loop's test is `newPrecedence > precedence`, and Lowest is 0.
define OperatorPrecedenceComma:          int 0
define OperatorPrecedenceSpread:         int 1
define OperatorPrecedenceYield:          int 2
define OperatorPrecedenceAssignment:     int 3
define OperatorPrecedenceConditional:    int 4
define OperatorPrecedenceLogicalOR:      int 5
define OperatorPrecedenceLogicalAND:     int 6
define OperatorPrecedenceBitwiseOR:      int 7
define OperatorPrecedenceBitwiseXOR:     int 8
define OperatorPrecedenceBitwiseAND:     int 9
define OperatorPrecedenceEquality:       int 10
define OperatorPrecedenceRelational:     int 11
define OperatorPrecedenceShift:          int 12
define OperatorPrecedenceAdditive:       int 13
define OperatorPrecedenceMultiplicative: int 14
define OperatorPrecedenceExponentiation: int 15
define OperatorPrecedenceUnary:          int 16
define OperatorPrecedenceUpdate:         int 17
define OperatorPrecedenceLeftHandSide:   int 18
define OperatorPrecedenceOptionalChain:  int 19
define OperatorPrecedenceMember:         int 20
define OperatorPrecedencePrimary:        int 21
define OperatorPrecedenceParentheses:    int 22

define OperatorPrecedenceLowest:   int OperatorPrecedenceComma
define OperatorPrecedenceHighest:  int OperatorPrecedenceParentheses
define OperatorPrecedenceCoalesce: int OperatorPrecedenceLogicalOR
define OperatorPrecedenceInvalid:  int 0 - 1

; The reference's core.Tristate, for the one question that needs three answers:
; does a `(`, `<` or `async` start an arrow function? TRUE parses one without
; further ado, FALSE never does, and UNKNOWN speculates — and the three are not
; collapsible, because UNKNOWN is the case that must be able to change its mind.
define TristateFalse:   int 0
define TristateTrue:    int 1
define TristateUnknown: int 2

; The reference's ParseFlags — the signature context a parameter list and a
; function body are parsed in. Only the three this slice can REACH are declared:
; ParseFlagsJSDoc belongs to the JSDoc parser, and ParseFlagsIgnoreMissingOpenBrace
; is set at exactly one call site (an arrow function's body), which is unported.
define ParseFlagsNone:  int 0
define ParseFlagsYield: int 1 << 0
define ParseFlagsAwait: int 1 << 1
define ParseFlagsType:  int 1 << 2

; The reference's 1 << 3 is ParseFlagsJSDoc, which this port does not have; the
; number is kept so the two tables can be read against each other.
;
; ★ It arrives with slice 13c because it is a RECOVERY flag: an arrow function
; whose body starts without its `{` — `a =>` NL `let v = 0;` NL `}` — is parsed
; as a block anyway, so that the next `}` does not preemptively close whatever
; contains it. The reference's own comment says the body will still error, which
; is exactly why the flag could not exist before this slice: with no diagnostics
; there was nothing for it to be the recovery half of.
define ParseFlagsIgnoreMissingOpenBrace: int 1 << 4

define JsdocInfoNone:         int 0
define JsdocInfoHasJsdoc:     int 1 << 0
define JsdocInfoHasDeprecated: int 1 << 1
define JsdocInfoHasSeeOrLink: int 1 << 2

; The reference's ParserState (mark/rewind). It saves the scanner's block plus
; the parser's own speculative state.
;
; ★★★ It ALSO saves the unported record since slice 5, which REVERSES the
; decision §3.9e recorded — and the reason is that the reference's own `rewind`
; TRUNCATES p.diagnostics back to the saved length. A speculation that reported
; errors and was then discarded reports NOTHING upstream. Our `unported` stands
; in for those diagnostics, so it has to have their lifetime; keeping it sticky
; made a discarded speculation poison the whole parse.
;
; That is not a corner case. `a << b` puts the expression ladder into
; tryParseTypeArgumentsInExpression, which parses `<b>` as a type-parameter list,
; fails to find a comma, and throws the whole thing away — upstream with its
; diagnostics, here with an unported record that used to survive. A shift
; operator was unparsable.
;
; ★★ What §3.9e was actually protecting is a DIFFERENT question, and it now has
; its own channel rather than a different rewind. Two records, and which one a
; site writes says what its report MEANS:
;
;   unported      the reference would have emitted a DIAGNOSTIC here. Rewound
;                 with the speculation that produced it, exactly as
;                 p.diagnostics is. Almost every site.
;   unanswerable  this port cannot ANSWER a question whose answer the caller is
;                 about to use. NOT rewound, because the answer travels out of
;                 the speculation even though the parse does not.
;                 `skip_parameter_start` is the only site, and the whole of
;                 §3.9e is about it: answering `false` there would route
;                 `([a]: T) => U` down the parenthesized-type path and build a
;                 tree nobody has checked.
;
; Getting it backwards is silent in both directions: `unported` where the answer
; escapes lets a wrong tree through, and `unanswerable` where the reference
; discards over-reports a construct this port can in fact parse.
; ★ One row of the list-range side table — see `list_ranges` on the Parser for
; why the range lives beside the list rather than in it. Three fields and no
; methods; the search is on the Parser, which owns the table.
define ListRange
(
    list: pointer[Array[pointer[AstNode]]]
    pos: int
    end: int
)
{
    init(l: pointer[Array[pointer[AstNode]]], p: int, e: int)
    {
        set list: l
        set pos: p
        set end: e
    }
}

define ParserState
(
    scanner_state: ScannerState
    context_flags: int

    ; The reference's `p.diagnostics` — and its `p.hasParseError`, which lives on
    ; The reference's `diagnosticsLen` and `hasParseError`, both saved and both
    ; restored — `rewind` does `p.diagnostics = p.diagnostics[0:diagnosticsLen]`.
    ; Since slice 13b these ARE the reference's two fields rather than a stand-in
    ; for them; §3.5i is the account of what stood here before and why its
    ; lifetime had to be this one all along.
    diagnostics_len: int
    diagnostics_has_error: bool

    ; The reference's `jsDiagnosticsLen`, restored exactly as the other length
    ; is. It is a SECOND list because checkJSSyntax's diagnostics never reach
    ; sf.Diagnostics() (see js_diagnostics on the Parser) — and it is in
    ; ParserState because the reference put it there: a speculation that read a
    ; type annotation in a JavaScript file and was thrown away must not leave the
    ; complaint about it behind.
    js_diagnostics_len: int

    ; The reference's `jsdocInfosLen`, restored the same way the diagnostics are:
    ; a speculation that parsed a JSDoc comment and was thrown away must not
    ; leave the documented node in the side table. `reparseList` is deliberately
    ; NOT here — the reference's ParserState does not carry it either.
    jsdoc_infos_len: int

    statement_has_await_identifier: bool
    unported_pos: int
    unported_tag: pointer[const_char]
    unported_detail: int
)
{
    init(ss: ScannerState, cf: int, dl: int, dhe: bool, jdl: int, jil: int, hai: bool, up: int, ut: pointer[const_char], ud: int)
    {
        set scanner_state: ss
        set context_flags: cf
        set diagnostics_len: dl
        set diagnostics_has_error: dhe
        set js_diagnostics_len: jdl
        set jsdoc_infos_len: jil
        set statement_has_await_identifier: hai
        set unported_pos: up
        set unported_tag: ut
        set unported_detail: ud
    }
}

define Parser
(
    host: pointer[Page]
    scanner: pointer[Scanner]
    token: int
    context_flags: int

    ; The reference's `p.diagnostics` — and its `p.hasParseError`, which lives on
    ; the LIST rather than here because the SCANNER is the other writer. See
    ; Diagnostics.scaly's header: upstream installs an error CALLBACK on the
    ; scanner whose whole body is an append to this list, so the list is what a
    ; closure would have captured, and the flag it also sets belongs with it.
    diagnostics: pointer[DiagnosticList]

    ; ★★★ The reference's `p.jsDiagnostics` — a SECOND list, and the reason it is
    ; second is the whole of why slice 24 needed a new dump section.
    ; `checkJSSyntax` reports TypeScript-only syntax found in a JavaScript file
    ; (`Type annotations can only be used in TypeScript files` and its eighteen
    ; neighbours), and finishSourceFile hands those to `SetJSDiagnostics`, which
    ; `sf.Diagnostics()` does NOT include. So they are not a subset of the list
    ; above and cannot be merged into it: merging would put them in the D section,
    ; where the reference has none, and every JavaScript unit would diverge.
    ;
    ; ★ It is written through `add_direct` exclusively — `jsErrorAtRange` does a
    ; raw `append`, with neither the DEDUP nor `hasParseError`. Both omissions are
    ; the reference's: two JS complaints at one position are two complaints (a
    ; parameter with a `?` AND a type annotation is the shape), and a JS complaint
    ; is not a parse error, so it must not stamp ThisNodeHasError on the node
    ; finish_node closes next.
    js_diagnostics: pointer[DiagnosticList]

    ; ★★★ The RANGE of a node list, for the three lists a diagnostic can point at.
    ;
    ; The reference's NodeList carries its own TextRange and this port's lists are
    ; plain arrays — ast.scaly's new_node_list says so, and says that nothing read
    ; a list's extent. checkJSSyntax reads three: a type-PARAMETER list, a
    ; type-ARGUMENT list and a parameter's MODIFIER list are each reported at the
    ; LIST's range, not at any node's.
    ;
    ; ★ It cannot be derived from the elements, and that was measured rather than
    ; assumed: over the 111 JavaScript units of the stage-1 corpus the range a
    ; list carries differs from (first element pos, last element end) for 15 of 15
    ; type-parameter lists and 2 of 105 modifier lists. A bracketed list's range
    ; starts INSIDE the `<` and ends at the full start of the `>`, so it includes
    ; the trivia before the bracket and any trailing comma, and a list the JSDoc
    ; reparser synthesized has a range from the TAG.
    ;
    ; A side table rather than a range on every list, because the type
    ; `pointer[Array[pointer[AstNode]]]` occurs 209 times across the two files and
    ; changing it would rewrite both to make three spans exact. The key is the
    ; list POINTER: `new_node_list` allocates fresh memory every time, so a key is
    ; unique for the life of the parse and a REWIND needs no truncation — a
    ; discarded list's entry is unreachable rather than wrong. Searched from the
    ; most recent end, because the list being asked about was just built.
    list_ranges: pointer[Array[ListRange]]

    ; ★★★ The reference's `missingListNodes` SENTINEL, and it is a sentinel here
    ; for the same reason it is one there: a list that is EMPTY and a list that is
    ; MISSING are different facts, and exactly one place reads the difference —
    ; typeHasArrowFunctionBlockingParseError, which refuses to commit to an arrow
    ; function whose return type is a function type with no parameter list.
    ;
    ; Upstream distinguishes them by ADDRESS (`&list.Nodes[:1][0] == &missingListNodes[:1][0]`),
    ; and so does this: one empty Array allocated once, handed out by
    ; create_missing_list, compared by pointer. Nothing ever adds to a list it has
    ; been given, here or upstream, which is what makes one instance enough.
    missing_list: pointer[Array[pointer[AstNode]]]

    ; The reference's `p.parsingContexts` — the SET of lists currently open, one
    ; bit per ParsingContext. Saved and restored around every list, exactly as
    ; upstream does it, because the question it answers is about the ENCLOSING
    ; lists: see the ParsingContext block above and
    ; abort_parsing_list_or_move_to_next_token.
    parsing_contexts: int

    ; Position of the first construct this slice does not implement, or -1,
    ; plus WHAT it was: a short tag and the token kind it applied to.
    ;
    ; NOT part of the reference. The position alone was the first draft and it
    ; is not enough to plan by — 316 cases reporting a byte offset says how many
    ; are left, never which construct to port next. With the tag the runner's
    ; unported column becomes a histogram, and the next slice is READ off it
    ; rather than guessed.
    ;
    ; It also carries the SCANNER's own omission up: a scan that could not
    ; proceed makes every span after it meaningless, so the parser must not
    ; report a tree built on one.
    unported_pos: int
    unported_tag: pointer[const_char]
    unported_detail: int

    ; The second record — "this port cannot ANSWER this question" — which a
    ; rewind does NOT restore, because the answer leaves the speculation even
    ; though the parse does not. One site writes it; see the ParserState header
    ; and `unanswerable_bool`.
    unanswerable_pos: int
    unanswerable_tag: pointer[const_char]
    unanswerable_detail: int

    ; The await context a parameter list was entered FROM. The reference reads
    ; it out of a closure — parseParametersWorker captures it before it changes
    ; the context flags, and the per-element callback uses it for the parameter's
    ; DECORATORS, which are parsed in the outer context while the rest of the
    ; parameter is parsed in the function's.
    ;
    ; Here the list's element callback is a static arm of parse_list_element
    ; (§3.9d/§3.9e — a func value that would have to escape becomes a method or,
    ; as here, a piece of state), so the captured value travels as a field. It is
    ; live only for the duration of one parse_delimited_list(PCParameters) call
    ; and is saved and restored around it, exactly as a capture would be.
    parameter_outer_await_context: bool

    ; parseParametersWorker's `flags&ParseFlagsType == 0`, travelling the same way
    ; and for the same reason (§3.5k). The reference's parameter callback reads it
    ; out of the closure to decide whether the parameter gets checkJSSyntax at all
    ; — a parameter of a TYPE never does, because a type's parameters are
    ; TypeScript syntax by construction and the file's JS-ness is not what decides
    ; whether they may be there. True everywhere else.
    parameter_check_js: bool

    ; parseParametersWorker's `allowAmbiguity`, travelling the same way and for
    ; the same reason: the element callback is a static arm of parse_list_element
    ; (§3.9d/§3.9e), so what the reference closes over has to be state here. It
    ; is false only inside the speculative half of an arrow-function parse.
    parameter_allow_ambiguity: bool

    ; Which of the two specifier parsers PCImportOrExportSpecifiers dispatches
    ; to. The reference passes the func VALUE to parseBracketedList —
    ; parseImportSpecifier for `import { a }`, parseExportSpecifier for
    ; `export { a }` — over ONE parsing context, and §3.5e is exactly this
    ; case: both call sites are static, so the value carries no information a
    ; flag does not. Set immediately before the call and restored after it, as
    ; the two parameter-list fields above are; a specifier list cannot nest, so
    ; the discipline is cheap insurance rather than a live hazard.
    specifier_is_import: bool

    ; parseVariableDeclarationList's `allowExclamation`, travelling the same way
    ; and for the same reason (§3.5k): the reference selects between
    ; parseVariableDeclaration and parseVariableDeclarationAllowExclamation with
    ; a func value handed to parseDelimitedList, and parse_list_element
    ; dispatches statically on the parsing CONTEXT — so there is no parameter to
    ; put it in. False only inside a for-statement initializer, where a
    ; definite-assignment `!` on a loop variable is meaningless.
    variable_declaration_allow_exclamation: bool

    ; The reference's `notParenthesizedArrow` — the set of token positions at
    ; which a speculative arrow-function parse has already failed, so the same
    ; text is never speculated over twice. It is a pure MEMO: the reference adds
    ; to it only where the parse answered nil, and re-running would answer nil
    ; again. Carried anyway, because without it a run of nested parentheses
    ; re-speculates at every level.
    not_parenthesized_arrow: pointer[Array[int]]

    ; The reference's `statementHasAwaitIdentifier`: did the TOP-LEVEL statement
    ; now being parsed contain an identifier literally named `await`, outside any
    ; await context? Upstream uses it to decide which statements to RE-PARSE with
    ; AwaitContext on, after the whole file has been parsed once
    ; (reparseTopLevelAwait), which slice 15 ported — through slice 14 this port
    ; had the detection alone and reported the construct here. It is saved and
    ; restored by mark/rewind, exactly as the reference saves it.
    statement_has_await_identifier: bool

    ; ... and the file-level half of it: the reference's `possibleAwaitSpans`,
    ; which is what it re-parses. A flat list of INDICES into the top-level
    ; statement list, paired — [start, end) per span — and MERGED when the next
    ; recording statement is the one after the last, so a run of them is one
    ; span rather than several. Through slice 14 this was a bool, because the
    ; port had the detection and not the reparse; the pairs are what
    ; reparse_top_level_await walks.
    possible_await_spans: pointer[Array[int]]

    ; parseToplevelStatement's parameter `i`, travelling as state for the reason
    ; §3.5k gives: the reference hands parseListIndex a func value taking the
    ; index, and parse_list_element dispatches statically on the parsing CONTEXT,
    ; so there is nowhere but a field to put it. Written by parse_list for
    ; PCSourceElements only — the one context the reference uses parseListIndex
    ; for — and read by parse_top_level_statement BEFORE it parses anything,
    ; because a nested list would otherwise overwrite it mid-statement.
    top_level_statement_index: int

    ; The reference's `isDeclarationFile`, which it derives in the worker from
    ; `p.opts.FileName`. Here the NAME is not carried and the ANSWER is, because
    ; the name is asked exactly one question and asked it once — §3.5q's rule,
    ; and the safe direction besides: a String field on a page-hosted struct is a
    ; lifetime question, and this one would be paid on every parse to keep a
    ; value read at its start.
    is_declaration_file: bool

    ; ★★★ The reference's `p.sourceFlags` — flags that belong to the FILE and are
    ; discovered while parsing something deep inside it. Two bits reach it, both
    ; from the import expression and the import type:
    ; PossiblyContainsDynamicImport and PossiblyContainsImportMeta. They are OR'd
    ; into the SourceFile node at the end (`result.Flags |= p.sourceFlags` in
    ; finishSourceFile) and into no other node, which is why they cannot travel as
    ; a CONTEXT flag: finish_node ORs those into every node it finishes.
    ;
    ; ★★★ A rewind does NOT restore this, and that is the reference's own shape
    ; rather than an omission — ParserState carries eight fields and this is not
    ; one of them. So a speculation that consumed an `import(` and was thrown
    ; away still leaves the file marked, and the flag genuinely says "possibly
    ; contains", which is what makes that sound. §3.5i's rule read from the other
    ; side: give a mechanism the reference's lifetime, and here the reference's
    ; lifetime is the whole parse.
    source_flags: int

    ; ★★★ The reference's `p.scriptKind`, and slice 19 is the first slice for
    ; which a parse has more than one of them. It is an ARGUMENT to
    ; ParseSourceFile upstream — never derived inside the parser — because the
    ; caller may know a kind the file's name does not imply (an in-memory
    ; document, a `--jsx` override). What it decides here is three things at
    ; once: the initial CONTEXT FLAGS (JavaScriptFile, and JsonFile besides),
    ; the scanner's LANGUAGE VARIANT, and which of the two GRAMMARS the entry
    ; point dispatches to.
    script_kind: int

    ; ★★★ The reference's `languageVariant core.LanguageVariant`, and slice 20 is
    ; what gives the PARSER a copy of what slice 19 gave the scanner. It is read
    ; at four places, all of them about `<`: the update expression (a JSX element
    ; is a primary expression), the simple unary (`+<foo>bar` must not be a type
    ; assertion), the arrow-function tristate (a `<` there is a type parameter
    ; list only under a much narrower test), and the type-assertion assert.
    ;
    ; A bool for the reason the scanner's is one: the reference's enum has two
    ; members and every read is `== LanguageVariantJSX`.
    language_variant_jsx: bool

    ; The reference's `p.hasDeprecatedTag`, set by parse_tag when it meets
    ; `@deprecated` and read — and CLEARED — by with_jsdoc, which turns it into
    ; NodeFlagsPossiblyContainsDeprecatedTag on the documented node. It is a
    ; field rather than a return value because the tag can sit at any depth of
    ; the comment and the reader is two routines above it.
    has_deprecated_tag: bool

    ; ── the JSDoc reparser's state (slice 22) ───────────────────────────────
    ;
    ; `reparse_list` is the reference's own: a tag that becomes a DECLARATION is
    ; parked here and parse_list flushes it into the enclosing list before the
    ; statement whose comment produced it.
    reparse_list: pointer[Array[pointer[AstNode]]]

    ; The reference's `jsdocInfos`, which finishSourceFile turns into a map from
    ; node to JSDoc list. Two parallel arrays, because there is no map here and
    ; the table is small — one entry per DOCUMENTED node, not per node. It is
    ; read by jsdoc_for_node for a JavaScript file, where the reference reads its
    ; cache rather than re-deriving: the reparser puts entries in it for nodes
    ; that have no comment ranges of their own (a synthesized parameter carrying
    ; its @param tag's text), and no re-derivation can produce those.
    ; The two arrays are the storage and `jsdoc_infos_len` is the LENGTH — a
    ; rewind has to shorten the table (the reference slices it) and `Array` has no
    ; truncate, so an entry past the length is dead storage waiting to be
    ; overwritten. Every reader and the writer go through the length.
    jsdoc_info_nodes: pointer[Array[pointer[AstNode]]]
    jsdoc_info_lists: pointer[Array[pointer[Array[pointer[AstNode]]]]]
    jsdoc_infos_len: int

    ; The reference's parse RESULT, kept so that a caller which needs the parser
    ; afterwards can have both. Slice 21 is the first such caller: the JSDoc
    ; yardstick walks the tree and asks the parser to parse a comment per node,
    ; which is exactly what Node.JSDoc(file) does upstream.
    result_file: pointer[AstNode]
)
{
    init(host: pointer[Page], scanner: pointer[Scanner])
    {
        set this.host: host
        set this.scanner: scanner
        set this.token: KindUnknown
        set this.context_flags: NodeFlagsNone
        set this.parsing_contexts: 0
        set this.missing_list: AstNode.new_node_list(host)
        let dl host.allocate(sizeof DiagnosticList, alignof DiagnosticList) as pointer[DiagnosticList]
        set *dl: DiagnosticList(host)
        set this.diagnostics: dl
        let jdl host.allocate(sizeof DiagnosticList, alignof DiagnosticList) as pointer[DiagnosticList]
        set *jdl: DiagnosticList(host)
        set this.js_diagnostics: jdl
        let lr host.allocate(sizeof Array[ListRange], alignof Array[ListRange]) as pointer[Array[ListRange]]
        set *lr: Array[ListRange]()
        set this.list_ranges: lr
        set this.parameter_outer_await_context: false
        set this.parameter_allow_ambiguity: true
        set this.parameter_check_js: true
        set this.specifier_is_import: true
        set this.variable_declaration_allow_exclamation: true
        set this.not_parenthesized_arrow: null
        set this.statement_has_await_identifier: false
        let pas host.allocate(sizeof Array[int], alignof Array[int]) as pointer[Array[int]]
        set *pas: Array[int]()
        set this.possible_await_spans: pas
        set this.top_level_statement_index: 0
        set this.is_declaration_file: false
        set this.source_flags: NodeFlagsNone
        set this.script_kind: ScriptKindTS
        set this.language_variant_jsx: false
        set this.has_deprecated_tag: false
        set this.reparse_list: AstNode.new_node_list(host)
        let jin host.allocate(sizeof Array[pointer[AstNode]], alignof Array[pointer[AstNode]]) as pointer[Array[pointer[AstNode]]]
        set *jin: Array[pointer[AstNode]]()
        set this.jsdoc_info_nodes: jin
        let jil host.allocate(sizeof Array[pointer[Array[pointer[AstNode]]]], alignof Array[pointer[Array[pointer[AstNode]]]]) as pointer[Array[pointer[Array[pointer[AstNode]]]]]
        set *jil: Array[pointer[Array[pointer[AstNode]]]]()
        set this.jsdoc_info_lists: jil
        set this.jsdoc_infos_len: 0
        set this.result_file: null
        set this.unported_pos: 0 - 1
        set this.unported_tag: null
        set this.unported_detail: 0
        set this.unanswerable_pos: 0 - 1
        set this.unanswerable_tag: null
        set this.unanswerable_detail: 0
    }

    ; ── the entry point ─────────────────────────────────────────────────────
    ;
    ; A concept STATIC taking the page explicitly: a user program calling a
    ; cross-package free function with a concept-pointer parameter fails
    ; resolution, while a static resolves (root CLAUDE.md). `out_unported`
    ; receives the unported position, or -1 — an out-parameter of scalar type,
    ; which is the safe direction (an out-parameter carrying a String-bearing
    ; struct is the live dangling class in this repo).
    ;
    ; The result is the SourceFile node, or null when nothing could be parsed.
    ; A non-negative `out_unported` invalidates the tree: read it FIRST.
    ;
    ; `file_name` is the reference's `opts.FileName`, and it is here for the one
    ; thing the parser does with it: a `.d.ts` name makes the whole file AMBIENT
    ; before a single token is read. It is answered here rather than carried,
    ; because it is asked once — see the `is_declaration_file` field.
    function parse(host: pointer[Page], file_name: String, source: String, script_kind: int, out_unported: pointer[int], out_tag: pointer[pointer[const_char]], out_detail: pointer[int]) returns pointer[AstNode]
    {
        let p parse_ex(host, file_name, source, script_kind, out_unported, out_tag, out_detail)
        p.result_file
    }

    ; ★ Slice 21 split this out of `parse` and changed nothing about it. The
    ; JSDoc yardstick needs the PARSER after the parse — a TS file's JSDoc is
    ; parsed on demand, per node, exactly as Node.JSDoc(file) does upstream — so
    ; the parser has to survive the call and the tree has to be reachable from
    ; it. `parse` stays the one-line entry point every other caller uses.
    function parse_ex(host: pointer[Page], file_name: String, source: String, script_kind: int, out_unported: pointer[int], out_tag: pointer[pointer[const_char]], out_detail: pointer[int]) returns pointer[Parser]
    {
        let sc host.allocate(sizeof Scanner, alignof Scanner) as pointer[Scanner]
        set *sc: Scanner(source)

        let p host.allocate(sizeof Parser, alignof Parser) as pointer[Parser]
        set *p: Parser(host, sc)
        set p.script_kind: script_kind
        set p.is_declaration_file: is_declaration_file_name(file_name)

        ; initializeState's context-flag switch, transcribed whole although only
        ; two of its three arms are reachable from this port's callers. The JSON
        ; arm sets TWO bits, and JavaScriptFile is not a mistake in it: a JSON
        ; document is JavaScript syntax with a smaller grammar, and both bits are
        ; CONTEXT flags, so finish_node stamps every node of the file with them.
        ; That is what makes the kind visible to the yardstick at all.
        if script_kind = ScriptKindJSON
            set p.context_flags: NodeFlagsJavaScriptFile | NodeFlagsJsonFile
        if script_kind = ScriptKindJS
            set p.context_flags: NodeFlagsJavaScriptFile
        if script_kind = ScriptKindJSX
            set p.context_flags: NodeFlagsJavaScriptFile

        ; The reference's `p.scanner.SetOnError(p.scanError)`, and it has to be
        ; here rather than in either constructor: the scanner is built first, so
        ; it cannot take the list as an argument any more than upstream's scanner
        ; can take the callback. Diagnostics.scaly's header has the argument for
        ; why a shared list is what that callback becomes.
        sc.set_diagnostics(p.diagnostics)

        ; initializeState's last line, and the one whose ANSWER is a surprise:
        ; getLanguageVariant says JSX for ScriptKindJSON. See the scanner's
        ; `jsx_variant`. The parser keeps the same answer for itself — upstream's
        ; `p.languageVariant = getLanguageVariant(p.scriptKind)` is one line
        ; ABOVE the setter, and the two must not be allowed to disagree.
        set p.language_variant_jsx: language_variant_is_jsx(script_kind)
        sc.set_language_variant_jsx(language_variant_is_jsx(script_kind))

        ; ★ ParseSourceFile's own body, which is three lines: advance to the
        ; first token, then dispatch on the kind. The next_token used to sit at
        ; the top of parse_source_file, where the reference does NOT have it —
        ; it belongs before the branch, because parse_json_text needs the first
        ; token just as much and reads `p.token` in its very first test.
        p.next_token()

        var file null as pointer[AstNode]
        if script_kind = ScriptKindJSON
            set file: p.parse_json_text()
        else
            set file: p.parse_source_file()

        set *out_unported: p.unported_at()
        set *out_tag: p.unported_tag_at()
        set *out_detail: p.unported_detail_at()
        set p.result_file: file
        p
    }

    ; The tree a parse_ex call produced. A concept STATIC for the reason
    ; parse_ex is one: the caller is a program root.
    function source_file_of(p: pointer[Parser]) returns pointer[AstNode]
        p.result_file

    ; ★★★ The script kind this port implements for a given file name — and since
    ; slice 22 there is no clamp left: it is the reference's own
    ; `core.GetScriptKindFromFileName`, whole. Exported as a concept STATIC
    ; because the callers are program roots: a cross-package module-level
    ; constant is not readable from one, and §3.5a's rule is to export the
    ; QUESTION.
    ;
    ; The clamp that stood here through slice 21 sent `.js` and `.jsx` to the
    ; TypeScript and TSX kinds, and its reason was exact: ScriptKindJS and
    ; ScriptKindJSX carry NodeFlagsJavaScriptFile, which turns on the JSDoc
    ; REPARSE — JSDoc is not a comment in a JavaScript file, it is the type
    ; syntax — and a port without the reparser would have been compared against a
    ; parse it could not produce. Slice 22 built the reparser, so the clamp is the
    ; claim it was waiting to stop making.
    ;
    ;   .json                → ScriptKindJSON, the second grammar (slice 19)
    ;   .tsx                 → ScriptKindTSX,  the JSX grammar (slice 20)
    ;   .jsx                 → ScriptKindJSX,  the same grammar with the
    ;                                          JavaScript bit on (slice 22)
    ;   .js, .cjs, .mjs      → ScriptKindJS    (slice 22)
    ;   everything else      → ScriptKindTS
    ;
    ; ★ What is NOT ported and is reachable from here is checkJSSyntax, whose
    ; diagnostics the reference routes to a SEPARATE list (SetJSDiagnostics) that
    ; sf.Diagnostics() does not include — so neither yardstick can see one, in
    ; either direction. That is stated rather than left to be noticed, because a
    ; distinction the dump hides hides every bug in it: a fourth section in the
    ; ast dump is what would make it visible, and it is the next slice's question
    ; rather than this one's.
    function supported_script_kind(file_name: String) returns int
        script_kind_from_file_name(file_name)

    ; The same question one step further, for the caller that has a SCANNER and
    ; no parser — the token yardstick. `getLanguageVariant` applied to the
    ; CLAMPED kind, and the order is load-bearing: asked of the raw kind, a `.js`
    ; unit would answer JSX (upstream's own table says so) while the parse of the
    ; same unit runs as TypeScript, and the two yardsticks would scan one file
    ; two ways.
    function script_kind_is_jsx_variant(file_name: String) returns bool
        language_variant_is_jsx(supported_script_kind(file_name))

    ; The two records fold here, and the DIAGNOSTIC one wins when both are set:
    ; it is the report that stopped the parse that is standing now, while an
    ; unanswerable one may have been left behind by a speculation whose text was
    ; then parsed another way. Either one alone stops the parse.
    function unported_at(this) returns int
    {
        if unported_pos >= 0
            return unported_pos
        unanswerable_pos
    }

    function unported_tag_at(this) returns pointer[const_char]
    {
        if unported_pos >= 0
            return unported_tag
        unanswerable_tag
    }

    function unported_detail_at(this) returns int
    {
        if unported_pos >= 0
            return unported_detail
        unanswerable_detail
    }

    ; Record the first unported construct and answer null, so a bail-out is one
    ; statement at the call site: `return this.unported("tag", token)`.
    ;
    ; `tag` names the construct, `detail` is the token kind it applied to (0
    ; where the kind adds nothing). Only the FIRST is kept — everything after it
    ; is parsed in a state the port already knows is wrong.
    procedure unported(this, tag: pointer[const_char], detail: int) returns pointer[AstNode]
    {
        if unported_pos < 0
        {
            set unported_pos: scanner.token_full_start()
            set unported_tag: tag
            set unported_detail: detail
        }
        null
    }

    function is_unported(this) returns bool
    {
        if unported_pos >= 0
            return true
        unanswerable_pos >= 0
    }

    ; ── node construction ───────────────────────────────────────────────────

    procedure new_node(this, kind: int, data: NodeData) returns pointer[AstNode]
    {
        let n AstNode.alloc(host)
        set n.kind: kind
        set n.flags: NodeFlagsNone
        set n.pos: 0
        set n.end: 0
        set n.data: data
        ; The three binder slots start EMPTY, and they are set here rather than by
        ; an `init` because AstNode.alloc hands back raw region memory — a data
        ; class with no init zero-fills only when it is CONSTRUCTED, and nothing
        ; here constructs one. Leave one out and the binder reads stack garbage as
        ; a symbol pointer.
        set n.parent: null
        set n.symbol: null
        set n.locals: null
        n
    }

    ; The reference's finishNode: the node's range is [pos, nodePos()), where
    ; nodePos() is the FULL start of the token the parser is now looking at —
    ; i.e. the end of the last token consumed. The context flags join here,
    ; which is what makes them a property of where a node was parsed.
    procedure finish_node(this, n: pointer[AstNode], pos: int) returns pointer[AstNode]
    {
        if n = null
            return null
        set n.pos: pos
        set n.end: this.node_pos()
        set n.flags: n.flags | context_flags
        if diagnostics.has_error
        {
            set n.flags: n.flags | NodeFlagsThisNodeHasError
            set diagnostics.has_error: false
        }
        this.override_parent_in_immediate_children(n)
        n
    }

    ; The reference's finishNodeWithEnd: the same thing with the end given rather
    ; than taken from the scanner. Its callers are the ones that SYNTHESIZE a node
    ; at a position the parser has already left — slice 20's jsx recovery places a
    ; zero-width closing tag at the end of a child list — so `node_pos()` would
    ; answer the wrong place.
    procedure finish_node_with_end(this, n: pointer[AstNode], pos: int, end: int) returns pointer[AstNode]
    {
        if n = null
            return null
        set n.pos: pos
        set n.end: end
        set n.flags: n.flags | context_flags
        if diagnostics.has_error
        {
            set n.flags: n.flags | NodeFlagsThisNodeHasError
            set diagnostics.has_error: false
        }
        this.override_parent_in_immediate_children(n)
        n
    }

    ; The reference's overrideParentInImmediateChildren, and the name is its
    ; argument: a child's `parent` is written by the finishNode of whatever node
    ; ends up owning it, so a node that was parsed speculatively under one owner and
    ; attached to another gets OVERWRITTEN rather than keeping the first answer.
    ; Upstream does it with a visitor closure over p.currentParent; here the
    ; children come back as an index pair (§3.9d), so the loop is plain and no
    ; parser state is needed.
    ;
    ; ★ It runs on EVERY finished node, exactly as the reference's does — this is
    ; the whole mechanism, not a fixup — and it visits the same children the parser
    ; yardstick walks, because it asks the same child_at.
    procedure override_parent_in_immediate_children(this, n: pointer[AstNode])
    {
        var i 0
        while true
        {
            let c AstNode.child_at(n, i)
            if c = null
                return
            set c.parent: n
            set i: i + 1
        }
    }

    ; ── token plumbing ──────────────────────────────────────────────────────

    function node_pos(this) returns int
        scanner.token_full_start()

    function has_preceding_line_break(this) returns bool
        scanner.has_preceding_line_break()

    ; ── JSDoc ───────────────────────────────────────────────────────────────
    ;
    ; Only the CHEAP half of the reference's withJSDoc is ported, and that is
    ; the half a .ts file takes: for a non-JavaScript file the reference sets
    ; HasJSDoc (and PossiblyContainsDeprecatedTag) from a text scan the scanner
    ; already did, and defers the actual JSDoc parse to first access. It parses
    ; eagerly in exactly one case — the comment contains @see or @link, which
    ; the unused-identifier check needs — and that eager parse is unported, so
    ; it is reported rather than skipped.

    function jsdoc_scanner_info(this) returns int
    {
        if scanner.has_preceding_jsdoc_comment() = false
            return JsdocInfoNone
        var info JsdocInfoHasJsdoc
        if scanner.has_preceding_jsdoc_with_deprecated_tag()
            set info: info | JsdocInfoHasDeprecated
        if scanner.has_preceding_jsdoc_with_see_or_link()
            set info: info | JsdocInfoHasSeeOrLink
        info
    }

    ; Answers the node, so a caller can end with `this.with_jsdoc(result, jsdoc)`,
    ; or null when the eager path is reached.
    ; ★★★ Slice 21 turned the last line of this into the real thing. For a TS or
    ; TSX file the reference DEFERS the JSDoc parse — it sets the two flags from
    ; the scanner's cheap text scan and stops — with one exception: a comment
    ; containing `@see` or `@link` is parsed EAGERLY, because the unused-identifier
    ; check needs those references before anything asks a node for its JSDoc.
    ;
    ; ★ What the eager parse produces goes into a side table upstream
    ; (jsdocInfos) and its diagnostics are discarded for a TS file, so on this
    ; side it is observationally a no-op for the TREE — and it is run anyway,
    ; for two reasons that are not cosmetic. It is what the reference does, and
    ; the difference between "runs and is discarded" and "does not run" is a
    ; SCANNER-state question: parse_jsdoc_comment moves the end, the position,
    ; the token and the context flags and puts them all back, so running it here
    ; is the only thing that exercises that restore on the main parse path.
    ; `has_deprecated_tag` is the one answer that does reach the tree.
    ;
    ; ★★★ Slice 22 filled in the last line of it: for a JAVASCRIPT file there is
    ; no deferral at all — every comment is parsed here, the result is kept in the
    ; side table (`jsdoc_infos`), and reparse_tags turns the tags into syntax.
    ; That is what `.js` means in this compiler, and it is the reason the flag is
    ; set AFTER the parse on that path rather than before it: a comment that
    ; produces no JSDoc node leaves the node undocumented.
    procedure with_jsdoc(this, n: pointer[AstNode], info: int) returns pointer[AstNode]
    {
        if n = null
            return null
        if (info & JsdocInfoHasJsdoc) = 0
            return n
        if this.is_java_script() = false
        {
            set n.flags: n.flags | NodeFlagsHasJSDoc
            if (info & JsdocInfoHasDeprecated) <> 0
                set n.flags: n.flags | NodeFlagsPossiblyContainsDeprecatedTag
            if (info & JsdocInfoHasSeeOrLink) = 0
                return n
        }

        set has_deprecated_tag: false
        let jsdoc this.parse_jsdoc_comments_of(n)
        if jsdoc <> null
        {
            if (n.flags & NodeFlagsHasJSDoc) = 0
                set n.flags: n.flags | NodeFlagsHasJSDoc
            if has_deprecated_tag
            {
                set has_deprecated_tag: false
                set n.flags: n.flags | NodeFlagsPossiblyContainsDeprecatedTag
            }
            if this.is_java_script()
                this.reparse_tags(n, jsdoc)
            this.add_jsdoc_info(n, jsdoc)
        }
        n
    }

    ; The reference's isJavaScript(): the SCRIPT KIND, not the context flag. A
    ; JSON file carries NodeFlagsJavaScriptFile too and is not one of these.
    function is_java_script(this) returns bool
        (script_kind = ScriptKindJS) or (script_kind = ScriptKindJSX)

    procedure next_token(this) returns int
    {
        if is_keyword(token)
        {
            if scanner.has_unicode_escape() or scanner.has_extended_unicode_escape()
                this.parse_error_at_current_token(DiagKeywords_cannot_contain_escape_characters)
        }
        this.next_token_without_check()
    }

    ; The reference's nextTokenWithoutCheck — the same scan without the
    ; escaped-keyword check above. The split is load-bearing rather than
    ; cosmetic: an identifier NAME may legally BE a keyword (`a.default`, `type`
    ; used as a variable name), and createIdentifier advances through THIS
    ; entry point, so routing it through next_token would report unported for a
    ; construct the reference accepts without a word.
    ;
    ; Our own two carry-ups stay on this side, because they are about the scan
    ; itself and every caller needs them.
    procedure next_token_without_check(this) returns int
    {
        set token: scanner.scan()

        ; ★★★ The scan-fault STAND-IN that stood here through slice 12 is gone
        ; (slice 13b). It tested the token FLAGS — Unterminated, and IsInvalid
        ; with the four template-literal kinds exempt — and turned either into one
        ; `unported` report, because the port emitted no diagnostics and a parser
        ; that recovers from an error without producing the error is a parser
        ; whose tree cannot be compared.
        ;
        ; The scanner now REPORTS, through the diagnostic list it shares with this
        ; parser, so there is nothing left to stand in for: a scan error arrives as
        ; a diagnostic at the position the reference puts it, and `finish_node`
        ; stamps NodeFlagsThisNodeHasError from the flag the same append sets.
        ;
        ; ★★ And the exemption that used to live here is now STRUCTURAL, which is
        ; the better port and was §3.5z's whole point. Scan() calls
        ; scanTemplateAndSetTokenValue(shouldEmitInvalidEscapeError = FALSE) while
        ; ReScanTemplateToken passes `!isTaggedTemplate`, so an invalid escape in a
        ; template is reported by the re-scan and only when the template is
        ; untagged — `` t`\u` `` is legal and reaches the tag function as raw
        ; text. That is a PARAMETER threaded down to scan_escape_sequence, not a
        ; kind test at the token; Unterminated was never exempt, because
        ; scanTemplateAndSetTokenValue reports it unconditionally on the very call
        ; that suppresses the escape errors.

        ; Carry the scanner's own omission up. Every span after an unscannable
        ; construct is meaningless, so the tree must not be reported.
        if scanner.unported_at() >= 0
        {
            if unported_pos < 0
            {
                set unported_pos: scanner.unported_at()
                set unported_tag: "scanner"
                set unported_detail: 0
            }
        }
        token
    }

    procedure parse_optional(this, kind: int) returns bool
    {
        if token = kind
        {
            this.next_token()
            return true
        }
        false
    }

    ; ── the error route ─────────────────────────────────────────────────────
    ;
    ; The reference's four reporting helpers, which are one function plus three
    ; ways of naming a range:
    ;
    ;     parseErrorAt(pos, end, msg)        → parseErrorAtRange
    ;     parseErrorAtCurrentToken(msg)      → parseErrorAtRange(TokenRange())
    ;     parseErrorAtRange(loc, msg)        → the dedup + hasParseError
    ;     scanError(msg, pos, length)        → parseErrorAtRange — the scanner's,
    ;                                          which reaches the same list
    ;                                          through Diagnostics.scaly rather
    ;                                          than through a closure (§3.5ad)
    ;
    ; The dedup and `has_error` live on the LIST, because the scanner is the
    ; other writer; Diagnostics.scaly's header has that argument. What is left
    ; here is the RANGE, and the three spellings differ only in that:
    ; `parse_error_at_current_token` spans [token_start, token_end) — the token
    ; WITHOUT its leading trivia — while `parse_error_at` is given both ends and
    ; is the one every zero-width report uses.
    ;
    ; ★ No MESSAGE and no ARGUMENTS. The yardstick compares a code and a span;
    ; the reference's messages carry `{0}` arguments (a token spelling, an
    ; identifier's text) that exist to be printed and never to be compared, so
    ; the sites below pass a code where upstream passes a message plus args.
    ; TESTPLAN.md says so where it lists what the dump format hides.
    procedure parse_error_at_range(this, pos: int, end: int, code: int)
        diagnostics.add(pos, end, code)

    procedure parse_error_at(this, pos: int, end: int, code: int)
        this.parse_error_at_range(pos, end, code)

    procedure parse_error_at_current_token(this, code: int)
        this.parse_error_at_range(scanner.token_start(), scanner.token_end(), code)

    ; skipRangeTrivia — a node's recorded POS is its full start, leading trivia
    ; included, so a diagnostic aimed at a node has to be moved to the first real
    ; character or it points at the blank line above it. `end` is untouched.
    ; The walk itself is in the scanner, where the text is.
    procedure skip_range_trivia_pos(this, pos: int) returns int
        scanner.skip_trivia_at(pos)

    ; The reference's parseExpected/parseExpectedWithoutAdvancing/
    ; parseExpectedWithDiagnostic. Reports "'x' expected" and CONTINUES — which
    ; is the whole of this slice in one function: through slice 12 a failed
    ; expectation was where the port stopped, and 124 call sites wrote
    ; `if this.parse_expected(X) = false  return null` around it. The reference
    ; DISCARDS the result at nearly all of them, so they are bare statements now.
    ;
    ; `code = 0` is the reference's `message == nil`. Zero is not a diagnostic
    ; number, so it needs no separate flag.
    procedure parse_expected(this, kind: int) returns bool
        this.parse_expected_with_diagnostic(kind, 0, true)

    procedure parse_expected_without_advancing(this, kind: int) returns bool
        this.parse_expected_with_diagnostic(kind, 0, false)

    procedure parse_expected_with_diagnostic(this, kind: int, code: int, should_advance: bool) returns bool
    {
        if token = kind
        {
            if should_advance
                this.next_token()
            return true
        }
        if code = 0
            this.parse_error_at_current_token(DiagX_0_expected)
        else
            this.parse_error_at_current_token(code)
        false
    }

    ; parseExpectedMatchingBrackets. The reference attaches RELATED INFO naming
    ; the opening token's position — `lastError.AddRelatedInfo(...)` — and
    ; related info hangs off a diagnostic rather than being appended to the list,
    ; so it never reaches the dump (Diagnostics.scaly's header says so). What is
    ; observable is the one X_0_expected, and the two parameters the related info
    ; needs are carried anyway so the shape stays the reference's.
    procedure parse_expected_matching_brackets(this, open_kind: int, close_kind: int, open_parsed: bool, open_position: int)
    {
        if token = close_kind
            this.next_token()
        else
            this.parse_error_at_current_token(DiagX_0_expected)
    }

    procedure parse_token_node(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let k token
        this.next_token()
        this.finish_node(this.new_node(k, NodeData.Token(TokenData())), pos)
    }

    procedure parse_optional_token(this, kind: int) returns pointer[AstNode]
    {
        if token = kind
            return this.parse_token_node()
        null
    }

    ; ── kind predicates, ported from internal/ast/utilities.go ──────────────
    ;
    ; Each is a >= / <= against a CONTIGUOUS run of the Kind table, which is why
    ; that table's declaration order is load-bearing (see Kind.scaly).

    function is_keyword(k: int) returns bool
        (k >= KindFirstKeyword) and (k <= KindLastKeyword)

    ; The reference's isTemplateLiteralKind — NoSubstitutionTemplateLiteral,
    ; TemplateHead, TemplateMiddle, TemplateTail, one contiguous run. It is the
    ; group the scan loop declines to report escape errors for; see
    ; next_token_without_check for why that is a group and not a flag.
    function is_template_literal_like(k: int) returns bool
        (k >= KindFirstTemplateToken) and (k <= KindLastTemplateToken)

    ; The reference's isIdentifier(). ★ The yield/await arms were OMITTED through
    ; slice 3 with the note that neither context could be entered — and slice 4
    ; is what makes them reachable: `function*` enters the yield context and an
    ; `async function` the await context, both through the signature flags. They
    ; are not decoration, either: inside a generator `yield` stops being a name,
    ; so a parameter called `yield` parses one way in `function f(yield)` and
    ; another in `function* f(yield)`.
    function is_identifier(this) returns bool
    {
        if token = KindIdentifier
            return true
        if token = KindYieldKeyword
        {
            if this.in_yield_context()
                return false
        }
        if token = KindAwaitKeyword
        {
            if this.in_await_context()
                return false
        }
        token > KindLastReservedWord
    }

    ; The reference's own comment: `let await` / `let yield` in those contexts
    ; are allowed HERE and rejected in the binder, so this one has no context
    ; arms and is not an oversight.
    function is_binding_identifier(this) returns bool
    {
        if token = KindIdentifier
            return true
        token > KindLastReservedWord
    }

    ; isBindingIdentifierOrPrivateIdentifierOrPattern — what a variable
    ; declaration may START with. A private identifier is admitted in order to
    ; be REFUSED: parseIdentifierOrPatternWithDiagnostic reports "private
    ; identifiers are not allowed in variable declarations" (18029) one level
    ; down and then consumes the `#name` as though it had been a name.
    ;
    ; ★★ Slice 12's note here filed that arm as INDISTINGUISHABLE — §3.5v's
    ; third row — because with it `var #x = 1` stopped at `binding-identifier`
    ; and without it at `list-element`, both unported, and the runner does not
    ; compare tags. Slice 13c expires that: WITH the arm the file parses and
    ; carries 18029, WITHOUT it the list gives up at the `#` and the diagnostic
    ; is the variable-declaration context's own. Two different diagnostics on a
    ; comparable file, which is a real red.
    function is_binding_identifier_or_private_identifier_or_pattern(this) returns bool
    {
        if token = KindOpenBraceToken
            return true
        if token = KindOpenBracketToken
            return true
        if token = KindPrivateIdentifier
            return true
        this.is_binding_identifier()
    }

    function in_yield_context(this) returns bool
        (context_flags & NodeFlagsYieldContext) <> 0

    function in_await_context(this) returns bool
        (context_flags & NodeFlagsAwaitContext) <> 0

    ; ── the list-range side table (slice 24) ────────────────────────────────
    ;
    ; `p.newNodeList(core.NewTextRange(pos, p.nodePos()), nodes)` on the reference
    ; side; here the list is built first and its range recorded beside it. Every
    ; caller that has a range to record calls this at the point the reference
    ; passes the TextRange, so the two are the same expression in two shapes.

    procedure record_list_range(this, list: pointer[Array[pointer[AstNode]]], pos: int, end: int)
    {
        if list = null
            return
        list_ranges.add(ListRange(list, pos, end))
    }

    ; Answers false when the list has no recorded range, which is not an error:
    ; the JSDoc reparser synthesizes lists without going through the routines
    ; above, and every reader of a range first asks whether ANY element of the
    ; list is un-reparsed — which a wholly synthesized list has none of. Reading
    ; a range that was never recorded would therefore be a defect elsewhere, so
    ; the caller reports nothing rather than guessing a span.
    function list_range(this, list: pointer[Array[pointer[AstNode]]], out_pos: pointer[int], out_end: pointer[int]) returns bool
    {
        if list = null
            return false
        var i list_ranges.get_length() as int
        while i > 0
        {
            set i: i - 1
            let r *(list_ranges.get_buffer() + i)
            if r.list = list
            {
                set *out_pos: r.pos
                set *out_end: r.end
                return true
            }
        }
        false
    }

    ; ── speculation ─────────────────────────────────────────────────────────

    function mark(this) returns ParserState
        ParserState(scanner.mark(), context_flags, diagnostics.length(), diagnostics.has_error, js_diagnostics.length(), jsdoc_infos_len, statement_has_await_identifier, unported_pos, unported_tag, unported_detail)

    ; ★ The unported record is restored HERE, with everything else — the
    ; reference truncates p.diagnostics at exactly this point. See the ParserState
    ; header; the one report that must outlive a rewind goes to the separate
    ; `unanswerable` record instead, which this deliberately does not touch.
    procedure rewind(this, saved: ParserState)
    {
        scanner.rewind(saved.scanner_state)
        set token: scanner.token()
        set context_flags: saved.context_flags
        diagnostics.truncate(saved.diagnostics_len)
        set diagnostics.has_error: saved.diagnostics_has_error
        js_diagnostics.truncate(saved.js_diagnostics_len)
        set jsdoc_infos_len: saved.jsdoc_infos_len
        set statement_has_await_identifier: saved.statement_has_await_identifier
        set unported_pos: saved.unported_pos
        set unported_tag: saved.unported_tag
        set unported_detail: saved.unported_detail
    }

    ; lookAhead(nextTokenIsBindingIdentifierOrStartOfDestructuring), inlined —
    ; see the header for why the callback does not survive the port.
    procedure is_let_declaration(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r this.is_binding_identifier()
        if r = false
        {
            if token = KindOpenBraceToken
                set r: true
        }
        if r = false
        {
            if token = KindOpenBracketToken
                set r: true
        }
        this.rewind(saved)
        r
    }

    ; ── the source file ─────────────────────────────────────────────────────

    procedure parse_source_file(this) returns pointer[AstNode]
    {
        ; ★★★ The worker's own first two lines, and they are the whole of what a
        ; file's NAME does to its parse:
        ;
        ;     isDeclarationFile := tspath.IsDeclarationFileName(p.opts.FileName)
        ;     if isDeclarationFile { p.contextFlags |= ast.NodeFlagsAmbient }
        ;
        ; A CONTEXT flag, so finish_node ORs it into every node of the file
        ; including the SourceFile itself — which is why nothing else here has to
        ; know about declaration files. The `declare` modifier sets the same bit
        ; over the declaration it heads (parse_declaration), and the two compose:
        ; that path saves and restores context_flags, so a `declare` inside a
        ; .d.ts restores to a value that already carries the bit.
        ;
        ; Measured over the 56 declaration units the corpus splits into: with the
        ; flag they match the reference exactly, and without it EVERY one of them
        ; differs — by this bit, on the nodes that are not individually declared,
        ; and by nothing else.
        if is_declaration_file
            set context_flags: context_flags | NodeFlagsAmbient

        ; ★ The `p.nextToken()` that used to stand here has moved UP into
        ; `parse`, where the reference keeps it: ParseSourceFile advances and
        ; THEN dispatches, so both grammars start on the first real token.
        let pos this.node_pos()

        ; ★★★ The file's statements are a LIST like any other since slice 13c —
        ; parseListIndex(PCSourceElements, parseToplevelStatement) — where
        ; through slice 12 this was a hand-written `while token <> EndOfFile`
        ; loop. Two things came with the change, and only the second is visible
        ; here: the loop stops on is_list_terminator (end of file) rather than on
        ; the token, and PCSourceElements joins `parsing_contexts`, which is what
        ; lets a broken construct deeper in the file ask whether the top level
        ; could use the token it is stuck on. Without that bit set the recovery
        ; has nothing to fall back to and every unrecognised token at any depth
        ; would be skipped rather than ending the construct that is broken.
        let statements this.parse_list(PCSourceElements)
        if statements = null
            return null

        let end_jsdoc this.jsdoc_scanner_info()
        let eof this.parse_token_node()
        if this.with_jsdoc(eof, end_jsdoc) = null
            return null

        ; ★★★ parseSourceFileWorker's `if len(p.reparseList) != 0` (slice 22), and
        ; the one thing it can still hold at this point is what the END-OF-FILE
        ; token's own comment produced: parse_list flushed everything else into
        ; the statement list as it went, and the eof's with_jsdoc runs after that
        ; list is closed. A file ending in a bare `/** @typedef {T} X */` is the
        ; shape, and the corpus has two of them.
        if (reparse_list.get_length() as int) <> 0
        {
            var ri 0
            let rn reparse_list.get_length() as int
            while ri < rn
            {
                statements.add(*(reparse_list.get_buffer() + ri))
                set ri: ri + 1
            }
            set reparse_list: AstNode.new_node_list(host)
        }

        ; ★ The FIRST SourceFile is built and finished whatever happens next, and
        ; that is not bookkeeping. finish_node CONSUMES `diagnostics.has_error` —
        ; it stamps ThisNodeHasError and clears the flag — so a port that skipped
        ; this node when it is about to reparse would carry a stale flag into the
        ; reparse and stamp it on a node the reference does not. The reference
        ; builds it too, and for its own additional reason: finishSourceFile
        ; computes the external-module indicator the decision below reads.
        let file this.finish_node(this.new_node(KindSourceFile, NodeData.SourceFile(SourceFileData(statements, eof, diagnostics, this.js_diagnostics_for_file()))), pos)
        if file = null
            return null

        ; finishSourceFile's `result.Flags |= p.sourceFlags`, on the FILE node and
        ; on no other — see the source_flags field. It has to happen HERE rather
        ; than after the reparse decision, because the decision READS the flag:
        ; the external-module indicator's last arm walks the tree for
        ; `import.meta` and only bothers when PossiblyContainsImportMeta is set.
        set file.flags: file.flags | source_flags

        ; finishSourceFile's pragma pass. ★★★ It runs on the reparse result TOO,
        ; and the diagnostics are APPENDED — processPragmasIntoFields resets the
        ; SourceFile's directive lists at its top and never touches p.diagnostics
        ; — so a file carrying both a top-level await and a bad `<reference>`
        ; reports that reference TWICE. Faithful, and pinned by the fixture.
        this.process_pragmas()

        ; Now the whole file is in hand, which is when the reference decides
        ; whether to re-parse — see parse_top_level_statement.
        ; !result.IsDeclarationFile && ExternalModuleIndicator != nil &&
        ; len(possibleAwaitSpans) > 0 — all three, and the first was written into
        ; the comment at file_is_external_module four slices before there was a
        ; declaration file to test it against (§3.5p). A .d.ts is never
        ; re-parsed, so a declaration file keeps the tree it already has.
        let span_count possible_await_spans.get_length() as int
        if span_count > 0
        {
            if is_declaration_file = false
            {
                if external_module_indicator(file, statements)
                {
                    let reparsed this.reparse_top_level_await(statements)
                    if reparsed = null
                        return null
                    ; NewSourceFile(..., newNodeList(sourceFile.Statements.Loc,
                    ; statements), sourceFile.EndOfFileToken), finished at the
                    ; same `pos` as the first — a fresh node over a new statement
                    ; list and the SAME end-of-file token. The list's own extent
                    ; is the one thing not carried, because this port keeps no
                    ; NodeList range and the walk visits a list's ELEMENTS
                    ; (ast.scaly's new_node_list says so). The `end` is right
                    ; regardless: the last rewind put the scanner back at the end
                    ; of the file, so node_pos() answers what it answered above.
                    let reparsed_file this.finish_node(this.new_node(KindSourceFile, NodeData.SourceFile(SourceFileData(reparsed, eof, diagnostics, this.js_diagnostics_for_file()))), pos)
                    if reparsed_file = null
                        return null
                    ; finishSourceFile runs a SECOND time on the reparse result,
                    ; so the flag is applied again — and it is read again rather
                    ; than copied, because the second pass may have set a bit the
                    ; first did not (an `import.meta` inside a statement the
                    ; reparse rewrote).
                    set reparsed_file.flags: reparsed_file.flags | source_flags
                    this.process_pragmas()
                    return reparsed_file
                }
            }
        }
        file
    }

    ; ── the second grammar (parser slice 19) ────────────────────────────────
    ;
    ; ★★★ parseJSONText. A `.json` file is not parsed by the routine above with a
    ; flag set — it gets its OWN entry point, a different grammar, reached from
    ; ParseSourceFile before parseSourceFileWorker is ever called. Reading the two
    ; side by side is the whole slice: this one has no statement list, no
    ; declarations and no recovery loop; what it has is a single VALUE, wrapped
    ; in an ExpressionStatement so the SourceFile shape stays the same.
    ;
    ; The value's grammar is the ordinary JavaScript one — parse_object_literal_
    ; expression and parse_array_literal_expression are the same routines an
    ; expression uses — and JSON-ness is enforced AFTERWARDS, by a validating
    ; walk over the finished tree (validate_json_value). So `{"a": a + 1}` parses
    ; into a real BinaryExpression and is then reported as error 1328. That is
    ; not an economy of the reference's: it is what lets the JSON parse produce a
    ; TREE for a tsconfig with a comment, a trailing comma or a single-quoted
    ; key, which is the whole point of the kind existing.
    ;
    ; ★ The ERROR RECOVERY arm is the one worth reading twice. Several top-level
    ; values in one file (`1 2 3`) are collected and wrapped in a SYNTHESIZED
    ; ArrayLiteralExpression that no bracket in the source produced, and only the
    ; FIRST of them reports `Unexpected_token` — reported inside the loop, before
    ; the second value is parsed, which is what puts it in front of anything that
    ; value reports.
    procedure parse_json_text(this) returns pointer[AstNode]
    {
        let pos this.node_pos()

        var statements null as pointer[Array[pointer[AstNode]]]
        var eof null as pointer[AstNode]

        if token = KindEndOfFile
        {
            ; An EMPTY document: an empty statement list and the EOF token read
            ; as a plain token node, NOT through parse_expected_token. The
            ; difference is observable — the other arm reports `'' expected` when
            ; the file does not end where the value does, and this arm has
            ; nothing to expect.
            set statements: AstNode.new_node_list(host)
            set eof: this.parse_token_node()
        }
        else
        {
            ; The reference's `var expressions any` — one expression, or a slice
            ; of them once a second has been found. A list here, with the
            ; single/multiple distinction read off its LENGTH, which is the same
            ; two states without the dynamic type.
            let expressions AstNode.new_node_list(host)

            while token <> KindEndOfFile
            {
                var expression null as pointer[AstNode]

                if token = KindOpenBracketToken
                    set expression: this.parse_array_literal_expression()
                else
                {
                    ; true / false / null are TOKEN nodes, not literals — the
                    ; keyword IS the value, so there is nothing to build.
                    var is_keyword_value false
                    if token = KindTrueKeyword
                        set is_keyword_value: true
                    if token = KindFalseKeyword
                        set is_keyword_value: true
                    if token = KindNullKeyword
                        set is_keyword_value: true

                    if is_keyword_value
                        set expression: this.parse_token_node()
                    else
                    {
                        if token = KindMinusToken
                        {
                            ; `-1` is a value; `-` followed by anything else — or
                            ; by a number that turns out to be a KEY — is not,
                            ; and the fallback is the object literal, which is
                            ; what produces the diagnostics for a malformed
                            ; document.
                            if this.look_ahead_next_token_is_numeric_literal_not_followed_by_colon()
                                set expression: this.parse_prefix_unary_expression()
                            else
                                set expression: this.parse_object_literal_expression()
                        }
                        else
                        {
                            var is_literal_value false
                            if token = KindNumericLiteral
                                set is_literal_value: true
                            if token = KindStringLiteral
                                set is_literal_value: true

                            ; ★ The reference's `fallthrough`. A string or number
                            ; FOLLOWED BY A COLON is a property name, so the
                            ; document is an object literal written without its
                            ; braces — falling through to the default arm is how
                            ; `"a": 1` at top level gets parsed and reported as
                            ; one.
                            var took false
                            if is_literal_value
                            {
                                if this.look_ahead_next_token_is_not_colon()
                                {
                                    set expression: this.parse_literal_expression(token)
                                    set took: true
                                }
                            }
                            if took = false
                                set expression: this.parse_object_literal_expression()
                        }
                    }
                }

                if expression = null
                    return null

                let first (expressions.get_length() as int) = 0
                expressions.add(expression)
                if first
                {
                    if token <> KindEndOfFile
                        this.parse_error_at_current_token(DiagUnexpected_token)
                }
            }

            var value null as pointer[AstNode]
            if (expressions.get_length() as int) > 1
                set value: this.finish_node(this.new_node(KindArrayLiteralExpression, NodeData.ArrayLiteralExpression(ElementListData(expressions))), pos)
            else
                set value: *(expressions.get_buffer())
            if value = null
                return null

            let statement this.finish_node(this.new_node(KindExpressionStatement, NodeData.ExpressionStatement(ExpressionStatementData(value))), pos)
            if statement = null
                return null
            set statements: AstNode.new_node_list(host)
            statements.add(statement)

            set eof: this.parse_expected_token(KindEndOfFile)
        }

        let file this.finish_node(this.new_node(KindSourceFile, NodeData.SourceFile(SourceFileData(statements, eof, diagnostics, this.js_diagnostics_for_file()))), pos)
        if file = null
            return null

        ; The validating walk runs on the FINISHED tree and before
        ; finishSourceFile, which is the reference's order and matters for the
        ; diagnostic sequence: everything the parse reported comes first, then
        ; the JSON-ness complaints in tree order.
        if (statements.get_length() as int) > 0
        {
            let st *(statements.get_buffer())
            choose st.data
                when e: ExpressionStatement
                    this.validate_json_value(e.expression)
        }

        ; finishSourceFile's `result.Flags |= p.sourceFlags`, exactly as the
        ; other grammar does it. NOT dead: a property VALUE is parsed by the
        ; ordinary expression grammar, so `{"a": import("m")}` reaches the
        ; dynamic-import arm and marks the file.
        set file.flags: file.flags | source_flags

        ; finishSourceFile's pragma pass, which the JSON grammar reaches too:
        ; parseJSONText ends in the same finishSourceFile call. A `.json` file
        ; whose first line is a `///` comment therefore gets the same directive
        ; diagnostics — which is the reference's behaviour and not obviously the
        ; intended one, so it is stated rather than quietly narrowed.
        this.process_pragmas()
        file
    }

    ; validateJsonValue. Answers nothing: it either finds the value acceptable or
    ; appends a diagnostic, and the two recursive arms (object, array) do the
    ; same for what they contain.
    ;
    ; ★ The reference's `break` — the PrefixUnaryExpression arm's escape when the
    ; operator is not a minus or the operand is not a number — leaves the switch
    ; and falls to the report at the bottom, which is why that arm is written
    ; here as "return when acceptable" rather than as "report when not".
    procedure validate_json_value(this, value_expression: pointer[AstNode])
    {
        if value_expression = null
            return

        let k value_expression.kind

        if k = KindTrueKeyword
            return
        if k = KindFalseKeyword
            return
        if k = KindNullKeyword
            return
        if k = KindNumericLiteral
            return

        if k = KindStringLiteral
        {
            if is_double_quoted_string(value_expression) = false
                this.report_json_error(value_expression, DiagString_literal_with_double_quotes_expected)
            return
        }

        if k = KindObjectLiteralExpression
        {
            this.validate_json_object_literal(value_expression)
            return
        }

        if k = KindArrayLiteralExpression
        {
            var elements null as pointer[Array[pointer[AstNode]]]
            choose value_expression.data
                when a: ArrayLiteralExpression
                    set elements: a.elements
            if elements <> null
            {
                var i 0
                let n elements.get_length() as int
                while i < n
                {
                    this.validate_json_value(*(elements.get_buffer() + i))
                    set i: i + 1
                }
            }
            return
        }

        if k = KindPrefixUnaryExpression
        {
            var negative_number false
            choose value_expression.data
                when pu: PrefixUnaryExpression
                {
                    if pu.operator_kind = KindMinusToken
                    {
                        if pu.operand <> null
                        {
                            if pu.operand.kind = KindNumericLiteral
                                set negative_number: true
                        }
                    }
                }
            if negative_number
                return
        }

        this.report_json_error(value_expression, DiagProperty_value_can_only_be_string_literal_numeric_literal_true_false_null_object_literal_or_array_literal)
    }

    ; validateJsonObjectLiteral. Two complaints per property and they are
    ; independent: an element that is not a PropertyAssignment at all (a spread,
    ; a shorthand, a method) is reported and SKIPPED, while a property with a
    ; name that is not a double-quoted string is reported and its value still
    ; validated.
    procedure validate_json_object_literal(this, n: pointer[AstNode])
    {
        var properties null as pointer[Array[pointer[AstNode]]]
        choose n.data
            when o: ObjectLiteralExpression
                set properties: o.elements
        if properties = null
            return

        var i 0
        let count properties.get_length() as int
        while i < count
        {
            let element *(properties.get_buffer() + i)
            set i: i + 1

            if element.kind <> KindPropertyAssignment
            {
                this.report_json_error(element, DiagProperty_assignment_expected)
                continue
            }

            choose element.data
                when pa: PropertyAssignment
                {
                    if pa.name <> null
                    {
                        if is_double_quoted_string(pa.name) = false
                            this.report_json_error(pa.name, DiagString_literal_with_double_quotes_expected)
                    }
                    this.validate_json_value(pa.initializer)
                }
        }
    }

    ; getErrorSpanForNode + the append, which is where the JSON route differs
    ; from every other diagnostic in this port and the difference is deliberate.
    ;
    ; ★★★ A RAW APPEND. validateJsonValue writes `p.diagnostics = append(...)`
    ; directly rather than going through parseErrorAtRange, so it gets neither
    ; the DEDUP nor `hasParseError`. Both matter: a JSON complaint at the same
    ; position as the last parse error would be swallowed by the dedup, and the
    ; validation runs AFTER the SourceFile node is finished, so a has_error set
    ; here would be stamped on whatever node a later parse finishes — there is
    ; none, but the reference's shape is the one that stays right when that
    ; changes.
    ;
    ; ★ The POS is trivia-skipped and the END is not: a diagnostic aimed at a
    ; node points at its first real character, and a node's recorded pos is its
    ; full start.
    procedure report_json_error(this, n: pointer[AstNode], code: int)
        diagnostics.add_direct(this.skip_range_trivia_pos(n.pos), n.end, code)

    ; isDoubleQuotedString: a string literal whose SingleQuote flag is clear.
    ; Both halves are load-bearing — a non-string name (`{a: 1}`) is not a
    ; double-quoted string either, which is how an identifier key gets error
    ; 1327 — and the flag is the field slice 19 added to LiteralData for exactly
    ; this reader.
    function is_double_quoted_string(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if n.kind <> KindStringLiteral
            return false
        choose n.data
            when lit: StringLiteral
                return (lit.token_flags & TokenFlagsSingleQuote) = 0
        false
    }

    ; ★★★ reparseTopLevelAwait — the reference's SECOND PASS over the statement
    ; list, and the last construct in this port with a route behind it.
    ;
    ; The problem it solves: `await` is an identifier in a script and an operator
    ; in a module, and whether a file is a module is not known until the whole
    ; file has been read (an `export` anywhere decides it). So the reference
    ; parses once with AwaitContext off, notes which top-level statements used
    ; `await` as a name, and then — if the file turned out to be a module —
    ; re-parses exactly those statements with the flag on. `const foo = await {
    ; bar: 42 }` is an identifier followed by an object literal on the first pass
    ; and an AwaitExpression on the second: a different TREE, not a different
    ; flag, which is why the detection alone could never have matched.
    ;
    ; Three things travel together and each is easy to drop:
    ;
    ;   the STATEMENTS   copied through unchanged outside the spans, re-parsed
    ;                    inside them
    ;   the DIAGNOSTICS  re-sliced, not re-run: the ones reported over a copied
    ;                    range are copied with it, the ones over a re-parsed
    ;                    range are DISCARDED and replaced by whatever the second
    ;                    pass reports
    ;   the SCANNER      rewound after each span, so the file ends where it ended
    ;
    ; Answers the new statement list, or null if the reparse met something this
    ; port cannot handle (which the first pass, by definition, did not).
    procedure reparse_top_level_await(this, source_statements: pointer[Array[pointer[AstNode]]]) returns pointer[Array[pointer[AstNode]]]
    {
        let statements AstNode.new_node_list(host)

        ; savedParseDiagnostics := p.diagnostics; p.diagnostics = []
        ; See Diagnostics.snapshot for why this is a copy-and-truncate rather
        ; than a second list: the scanner holds a pointer to this one.
        let saved diagnostics.snapshot(host)
        diagnostics.truncate(0)

        let n_statements source_statements.get_length() as int
        let n_spans possible_await_spans.get_length() as int
        var after_await_statement 0
        var i 0
        while i < n_spans
        {
            let next_await_statement *(possible_await_spans.get_buffer() + i)

            ; Everything between the last span and this one is kept as parsed.
            let prev_statement *(source_statements.get_buffer() + after_await_statement)
            let next_statement *(source_statements.get_buffer() + next_await_statement)
            var k after_await_statement
            while k < next_await_statement
            {
                statements.add(*(source_statements.get_buffer() + k))
                set k: k + 1
            }
            this.copy_saved_diagnostics(saved, prev_statement.pos, next_statement.pos, true)

            var state this.mark()
            set context_flags: context_flags | NodeFlagsAwaitContext
            scanner.reset_pos(next_statement.pos)
            this.next_token()

            set after_await_statement: *(possible_await_spans.get_buffer() + (i + 1))
            while token <> KindEndOfFile
            {
                let start_pos scanner.token_full_start()
                let statement this.parse_statement()
                if statement = null
                    return null
                statements.add(statement)
                ; ★ The zero-progress guard, the same one parse_list rests on: a
                ; statement that consumed nothing would spin here forever.
                if start_pos = scanner.token_full_start()
                    this.next_token()

                if after_await_statement < n_statements
                {
                    ; ★★ The span is bounded by the END of the last statement it
                    ; covered, never by a count — because the second pass does not
                    ; have to agree with the first about where statements divide.
                    ; `await {x}` is TWO statements on the first pass and ONE on
                    ; the second, so landing exactly on that end means done, and
                    ; overshooting it means this re-parse has eaten into the next
                    ; span, which is then absorbed rather than re-parsed again.
                    let last_await_statement *(source_statements.get_buffer() + (after_await_statement - 1))
                    if statement.end = last_await_statement.end
                        break
                    if statement.end > last_await_statement.end
                    {
                        set i: i + 2
                        if i < n_spans
                            set after_await_statement: *(possible_await_spans.get_buffer() + (i + 1))
                        else
                            set after_await_statement: n_statements
                    }
                }
            }

            ; state.diagnosticsLen = len(p.diagnostics); p.rewind(state)
            ;
            ; ★★★ A rewind that KEEPS what the speculation reported, which is the
            ; opposite of every other rewind in this file — the mark is being used
            ; to restore the scanner and the context flags, not to discard a
            ; branch. Raising the saved length to the current one is the
            ; reference's own way of saying so, and the unported record is raised
            ; with it for exactly the reason §3.5i gives: that record has the
            ; DIAGNOSTICS' lifetime, so wherever they survive a rewind it must
            ; too. Restoring it here would silently un-report a construct the
            ; second pass just met and the first never reached.
            set state.diagnostics_len: diagnostics.length()
            set state.unported_pos: unported_pos
            set state.unported_tag: unported_tag
            set state.unported_detail: unported_detail
            this.rewind(state)

            set i: i + 2
        }

        ; ... and everything after the last span, statements and diagnostics
        ; alike, with no upper bound to stop at.
        if after_await_statement < n_statements
        {
            let prev_statement *(source_statements.get_buffer() + after_await_statement)
            var k after_await_statement
            while k < n_statements
            {
                statements.add(*(source_statements.get_buffer() + k))
                set k: k + 1
            }
            this.copy_saved_diagnostics(saved, prev_statement.pos, 0, false)
        }

        statements
    }

    ; The reference's two FindIndex calls over the saved list, which pick the
    ; diagnostics belonging to a copied range: from the first whose position
    ; reaches `from_pos`, up to (excluding) the first at-or-after that one whose
    ; position reaches `to_pos`. With `bounded` false there is no upper bound and
    ; the rest of the list is copied.
    ;
    ; ★ Ported as a scan rather than as two searches because the list is in
    ; position order and short; what is NOT collapsed is the two-stage shape —
    ; the upper bound is sought FROM the lower one, so a diagnostic before
    ; `from_pos` can never end the range even if it is at-or-after `to_pos`.
    procedure copy_saved_diagnostics(this, saved: pointer[Array[Diagnostic]], from_pos: int, to_pos: int, bounded: bool)
    {
        let n saved.get_length() as int
        var i 0
        var started false
        while i < n
        {
            let d *(saved.get_buffer() + i)
            if started = false
            {
                if d.pos >= from_pos
                    set started: true
            }
            if started
            {
                if bounded
                {
                    if d.pos >= to_pos
                        return
                }
                diagnostics.add_direct(d.pos, d.end, d.code)
            }
            set i: i + 1
        }
    }

    ; ★★★ parseToplevelStatement — the RECORDING half of the top-level-await
    ; reparse, whose acting half is reparse_top_level_await above.
    ;
    ; Upstream parses the file ONCE, notes which top-level statements used
    ; `await` as an identifier while not in an await context, and then RE-PARSES
    ; exactly those statements with AwaitContext on (reparseTopLevelAwait) —
    ; re-positioning the scanner, re-slicing the diagnostics, and replacing the
    ; statements in place.
    ;
    ; ★ Slice 5 ported the DETECTION alone and reported the construct, on the
    ; argument that detection is what decides whether the tree this port produced
    ; is the tree the reference produced — when the answer is yes, every node of
    ; that statement carries AwaitContext upstream and none of them do here. That
    ; was right, and it is worth knowing how it was found: the difference DID
    ; surface as an unexplained failure on two corpus cases, the moment member
    ; access started parsing and `M.await(1)` became reachable. Slice 15 makes
    ; the record act instead of report.
    procedure parse_top_level_statement(this) returns pointer[AstNode]
    {
        ; ★ Read the index FIRST, because parse_list publishes it just before
        ; this call and parse_statement below opens lists of its own. It is
        ; belt-and-braces rather than a live hazard, and the distinction is
        ; measured rather than assumed: parse_list writes the field only for
        ; PCSourceElements, and that context has exactly ONE call site (this
        ; file's parse_source_file), so no nested list can reach the write. The
        ; reference has the index as a parameter and cannot make the mistake at
        ; all; a field can, the day a second source-element list appears.
        var i top_level_statement_index
        set statement_has_await_identifier: false
        let statement this.parse_statement()
        if statement = null
            return null

        ; ★★★ The reference's `i += len(p.reparseList)`, ported in slice 22 —
        ; see the note below, which said this term was zero at every call and was
        ; right until the reparser existed. It is the JSDoc declarations THIS
        ; statement produced, which parse_list is about to insert AHEAD of it, so
        ; the statement's own index in the finished list is that much higher. The
        ; span it records is an index into that list and the re-parse seeks to
        ; the statement it names; off by one, the scanner is repositioned inside
        ; the comment that produced the insertion and the file is parsed twice
        ; from two different places.
        set i: i + (reparse_list.get_length() as int)

        ; possibleAwaitSpans, whole:
        ;
        ;     if len(spans) == 0 || spans[len(spans)-1] != i {
        ;         spans = append(spans, i, i+1)
        ;     } else {
        ;         spans[len(spans)-1] = i + 1
        ;     }
        ;
        ; i.e. EXTEND the open span when this statement directly follows the last
        ; recorded one, and start a new pair otherwise. The reference's own
        ; `i += len(p.reparseList)` is ported since slice 22 and sits above,
        ; right after the parse. Through slice 21 it was deliberately dropped —
        ; reparseList holds the nodes a JSDoc `@typedef` inserts ahead of a
        ; statement, this port had no reparser, and the term was zero at every
        ; call — which is exactly the shape of claim that expires when the thing
        ; it is about gets built. It cost three corpus units.
        ;
        ; ★★ The MERGE is ported and is UNGATED, and the verdict is the one slice
        ; 8 called a REDUNDANCY IN THE REFERENCE rather than any of §3.5v's four
        ; rows: splitting a merged run into one span per statement produces the
        ; same tree and the same diagnostics, because the OVERSHOOT branch in
        ; reparse_top_level_await already absorbs a following span whenever a
        ; re-parse eats past its own. Measured on both shapes that looked likely
        ; — consecutive plain recorders, and a recorder whose re-parse absorbs
        ; the statement after it — and they converge. Ported anyway, because the
        ; reference has it; recorded so the next reader does not spend an hour
        ; building a fixture for it. What could still separate the two, and what
        ; I did not manage to construct, is a first re-parse that absorbs a LATER
        ; member of the same merged run while a subsequent statement ends exactly
        ; on an earlier boundary — so this row is carried by the argument, not by
        ; the suite, and it says so.
        if statement_has_await_identifier
        {
            if (statement.flags & NodeFlagsAwaitContext) = 0
            {
                let spans possible_await_spans
                let n spans.get_length() as int
                var extended false
                if n > 0
                {
                    if *(spans.get_buffer() + (n - 1)) = i
                    {
                        spans.put((n - 1) as size_t, i + 1)
                        set extended: true
                    }
                }
                if extended = false
                {
                    spans.add(i)
                    spans.add(i + 1)
                }
            }
        }
        statement
    }

    ; ★★★ The reparse runs only for an external MODULE:
    ;
    ;     !result.IsDeclarationFile && result.ExternalModuleIndicator != nil
    ;                                && len(p.possibleAwaitSpans) > 0
    ;
    ; and the indicator is `isAnExternalModuleIndicatorNode` over the top-level
    ; statements: an export modifier, an import declaration, an export
    ; assignment, an export declaration, an `import x = require(…)`, or an
    ; `import.meta` anywhere in the tree.
    ;
    ; ★★★ THIS FUNCTION IS WHERE SLICE 8 PAID §3.5l. Through slice 7 it tested
    ; the export MODIFIER and nothing else, and the comment standing here said
    ; so with a reason: "every one of those but the FIRST is a construct this
    ; slice reports as unported, so a file that parsed to the end can only be a
    ; module by the export-modifier arm". That reason was true and it EXPIRED
    ; the moment import and export declarations started parsing — three of the
    ; five remaining arms are exactly what this slice built. A condition whose
    ; correctness rests on another part of the port being incomplete has to be
    ; re-read by the slice that completes it.
    ;
    ; (`IsDeclarationFile` is the `.d.ts` name test; the pinned corpus has no
    ; such case, as the oracle's own header records.)
    ;
    ; The detection itself was NOT in the first version of this check, and the
    ; control that found it is worth keeping in mind: removing it altogether
    ; turned two corpus cases red and the fixture MATCHED — which can only mean
    ; the fixture was being reported for something the reference does not do. It
    ; had no export, so it was never a module.
    ; ★★★ AND SINCE SLICE 28 IT IS NOT THE WHOLE INDICATOR — see
    ; external_module_indicator below. `isFileProbablyExternalModule` is one arm
    ; of `getExternalModuleIndicator`, which the reference calls from
    ; finishSourceFile and stores on the file; every reader — the reparse
    ; condition here, and the binder's IsExternalModule — reads the STORED
    ; indicator and not this function. The difference is the JSON arm, and it
    ; became load-bearing when the binder started naming module symbols.
    function file_is_external_module(file: pointer[AstNode], statements: pointer[Array[pointer[AstNode]]]) returns bool
    {
        if statements = null
            return false
        let len statements.get_length() as int
        var i 0
        while i < len
        {
            if statement_is_external_module_indicator(*(statements.get_buffer() + i))
                return true
            set i: i + 1
        }
        ; getImportMetaIfNecessary — the arm the comment above named as the one
        ; still absent, and slice 18 is the slice it said would own it.
        import_meta_if_necessary(file)
    }

    ; getExternalModuleIndicator, and it is the function every reader of "is this
    ; file a module" actually asks — the reference computes it once in
    ; finishSourceFile and stores the NODE on the SourceFile; this port answers
    ; the question instead of storing the node (§3.5q), so the arms are here.
    ;
    ;   1. a JSON file is NEVER an external module, whatever its statements say
    ;   2. isFileProbablyExternalModule (the function above)
    ;   3. a DECLARATION file stops here — the two arms below are for
    ;      implementation files only
    ;   4. opts.JSX: a JSX tag makes the file a module, under
    ;      jsx: react-jsx / react-jsxdev
    ;   5. opts.Force: under moduleDetection force/auto every file is one
    ;
    ; ★ Arms 4 and 5 are NOT ported and cannot be reached from anything this port
    ; has: both are decided by `ExternalModuleIndicatorOptions`, which
    ; GetExternalModuleIndicatorOptions derives from the COMPILER OPTIONS, and
    ; this port has no compiler options — the reference's own oracle builds
    ; SourceFileParseOptions with that struct zeroed, so both are false on the
    ; other side of every yardstick too. The slice that ports tsconfig owns them;
    ; until then arm 3 is unreachable as well, since with 4 and 5 off a
    ; declaration file's answer is `false` either way (which is why it is written
    ; as a comment rather than as an `if` that cannot change an answer).
    ;
    ; ★★ Arm 1 is the load-bearing one and it is why this function exists at all:
    ; JSON is the ONE script kind whose statements can satisfy arm 2 — a
    ; `package.json` body is an object literal, not an export — while the
    ; reference still refuses it modulehood, and the binder's JSON arm depends on
    ; the refusal. `IsJsonSourceFile` asks the file's SCRIPT KIND upstream; the
    ; equivalent here is the JsonFile context flag the parser stamps on every node
    ; of a JSON parse.
    function external_module_indicator(file: pointer[AstNode], statements: pointer[Array[pointer[AstNode]]]) returns bool
    {
        if file = null
            return false
        if (AstNode.flags_of(file) & NodeFlagsJsonFile) <> 0
            return false
        file_is_external_module(file, statements)
    }

    ; getImportMetaIfNecessary. The GUARD is the whole point of the reference's
    ; own comment on it: a full tree walk is what finding `import.meta` costs, so
    ; the flag exists to skip it, and the parser sets that flag exactly where it
    ; builds the node. Answering the question without the flag would be correct
    ; and would walk every tree; answering it with the flag and no node would be
    ; the flag lying, which is why it says POSSIBLY contains.
    function import_meta_if_necessary(file: pointer[AstNode]) returns bool
    {
        if file = null
            return false
        if (file.flags & NodeFlagsPossiblyContainsImportMeta) = 0
            return false
        find_import_meta(file)
    }

    ; findChildNode(root, IsImportMeta), which checks the ROOT first and then
    ; recurses through ForEachChild. The reference answers the NODE and this
    ; answers whether there is one, because the only caller asks `!= nil` — the
    ; indicator node itself is stored on the SourceFile upstream and nothing in
    ; this port reads it (§3.5q: carry the ANSWER, not the value, where the value
    ; is asked one question).
    function find_import_meta(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if is_import_meta(n)
            return true
        var i 0
        var c AstNode.child_at(n, i)
        while c <> null
        {
            if find_import_meta(c)
                return true
            set i: i + 1
            set c: AstNode.child_at(n, i)
        }
        false
    }

    ; IsImportMeta: a MetaProperty built from the `import` keyword whose name is
    ; literally `meta`. BOTH halves need a field this port added for them —
    ; the keyword token (slice 18) and the identifier's text (slice 17) — which
    ; is why the arm could not be written earlier even though the walk could:
    ; without the keyword `new.target` answers yes, and without the text
    ; `import.anything` does.
    function is_import_meta(n: pointer[AstNode]) returns bool
    {
        if n.kind <> KindMetaProperty
            return false
        choose n.data
            when mp: MetaProperty
            {
                if mp.keyword_token <> KindImportKeyword
                    return false
                if mp.name = null
                    return false
                choose mp.name.data
                    when id: Identifier
                        return text_matches(id.text, id.text_len, "meta")
                return false
            }
        false
    }

    ; isAnExternalModuleIndicatorNode, arm for arm — the five STATEMENT arms.
    ;
    ; ★ The reference's indicator has a sixth arm which is not a statement test at
    ; all: `import.meta` ANYWHERE in the tree, found by a walk under the
    ; PossiblyContainsImportMeta flag. It stood here as absent through four
    ; slices, with a claim dated to "the slice that ports the import EXPRESSION",
    ; and slice 18 is that slice — it lives at import_meta_if_necessary, called
    ; from file_is_external_module after this loop, exactly where
    ; isFileProbablyExternalModule calls it.
    function statement_is_external_module_indicator(n: pointer[AstNode]) returns bool
    {
        if statement_has_export_modifier(n)
            return true
        let k AstNode.kind_of(n)
        if k = KindImportDeclaration
            return true
        if k = KindExportAssignment
            return true
        if k = KindExportDeclaration
            return true
        ; ★ An import EQUALS declaration counts only when its module reference
        ; is `require("…")`: `import A = B.C` is an alias inside this file and
        ; says nothing about the file being a module.
        if k = KindImportEqualsDeclaration
            return AstNode.import_equals_reference_kind(n) = KindExternalModuleReference
        false
    }

    ; ast.HasSyntacticModifier(node, ModifierFlagsExport), asked of the node's
    ; own children: a modifier is an ordinary Token node here, and the three
    ; declaration forms this slice builds all carry theirs as leading children.
    function statement_has_export_modifier(n: pointer[AstNode]) returns bool
    {
        var i 0
        while true
        {
            let c AstNode.child_at(n, i)
            if c = null
                break
            if AstNode.kind_of(c) = KindExportKeyword
                return true
            set i: i + 1
        }
        false
    }

    ; ── statements ──────────────────────────────────────────────────────────
    ;
    ; The reference's parseStatement switch, arm for arm. The arms this slice
    ; does not implement are named individually rather than caught by a default,
    ; so that adding one is a matter of removing it from the list below.

    procedure parse_statement(this) returns pointer[AstNode]
    {
        if token = KindSemicolonToken
            return this.parse_empty_statement()

        if token = KindOpenBraceToken
            return this.parse_block()

        if token = KindVarKeyword
            return this.parse_variable_statement(this.node_pos(), this.jsdoc_scanner_info(), null)

        if token = KindLetKeyword
        {
            ; In ES6 `let` starts a lexical declaration only when an identifier,
            ; `{` or `[` follows; otherwise it is an ordinary identifier and the
            ; reference falls through to the expression statement.
            if this.is_let_declaration()
                return this.parse_variable_statement(this.node_pos(), this.jsdoc_scanner_info(), null)
        }

        ; ★ `await using x = f()` and `using x = f()` are DECLARATIONS; a bare
        ; `await e;` and a bare `using;` are expression statements. Both arms
        ; fall through when the look-ahead says no, exactly as the reference's
        ; switch does — and both were on the unported list until parser slice 5,
        ; because until the ladder landed the fall-through had nowhere to go.
        if token = KindAwaitKeyword
        {
            if this.is_await_using_declaration()
                return this.parse_variable_statement(this.node_pos(), this.jsdoc_scanner_info(), null)
        }

        if token = KindUsingKeyword
        {
            if this.is_using_declaration()
                return this.parse_variable_statement(this.node_pos(), this.jsdoc_scanner_info(), null)
        }

        if token = KindFunctionKeyword
            return this.parse_function_declaration(this.node_pos(), this.jsdoc_scanner_info(), null)

        if token = KindClassKeyword
            return this.parse_class_declaration(this.node_pos(), this.jsdoc_scanner_info(), null)

        if token = KindIfKeyword
            return this.parse_if_statement()

        if token = KindReturnKeyword
            return this.parse_return_statement()

        ; ── slice 9: the loop and branch statements ─────────────────────────
        ;
        ; In the reference's own order, which is also the order this port's
        ; `if` run has to keep only in the sense that the tests are disjoint —
        ; each is one token kind (§3.9b: a run of independent `if`s that return
        ; nests no planner levels, where a forty-arm `else if` chain nests forty).
        if token = KindDoKeyword
            return this.parse_do_statement()
        if token = KindWhileKeyword
            return this.parse_while_statement()
        if token = KindForKeyword
            return this.parse_for_or_for_in_or_for_of_statement()
        if token = KindContinueKeyword
            return this.parse_continue_statement()
        if token = KindBreakKeyword
            return this.parse_break_statement()
        if token = KindWithKeyword
            return this.parse_with_statement()
        if token = KindSwitchKeyword
            return this.parse_switch_statement()
        if token = KindThrowKeyword
            return this.parse_throw_statement()

        ; ★ THREE tokens, one arm — `case KindTryKeyword, KindCatchKeyword,
        ; KindFinallyKeyword: return p.parseTryStatement()`. A statement starting
        ; with `catch` or `finally` is an error, and the reference routes it here
        ; deliberately ("so that we may gracefully parse them and error later"):
        ; parseTryStatement's own parseExpected(try) is what names it, and since
        ; slice 13c it does, so the recovery is the reference's whole. Slice 12
        ; measured the route as UNGATED for want of a diagnostic — both paths
        ; ended in one report at the same token — which is exactly what changed.
        if token = KindTryKeyword
            return this.parse_try_statement()
        if token = KindCatchKeyword
            return this.parse_try_statement()
        if token = KindFinallyKeyword
            return this.parse_try_statement()

        if token = KindDebuggerKeyword
            return this.parse_debugger_statement()

        ; ★ A leading `@` routes to parse_declaration, exactly as the reference's
        ; own case does, and parse_modifiers is where the decorator is parsed.
        ; Slice 8 and earlier short-circuited it here instead, under a tag of its
        ; own; routing it makes the port's control flow the reference's AND
        ; merged the four cases that reported `statement @` into the `decorator
        ; @` row of the histogram, where they belonged — they are one construct,
        ; and two rows for it was an artefact of the short cut.
        if token = KindAtToken
            return this.parse_declaration()

        ; The reference's last switch group: a contextual keyword that MAY start
        ; a declaration and may equally be an ordinary identifier. Only the
        ; look-ahead can tell (`type` is a variable name as often as it is a type
        ; alias), which is why this is a question and not a token test.
        if statement_start_is_declaration_keyword(token)
        {
            if this.is_start_of_declaration()
                return this.parse_declaration()
        }

        this.parse_expression_or_labeled_statement()
    }

    ; The keywords that route to parseDeclaration when isStartOfDeclaration says
    ; so. Being on this list is not a verdict: every one of them is a legal
    ; identifier, so the look-ahead decides.
    ;
    ; It is a table rather than a run of `if`s in parse_statement for the §3.9b
    ; reason — eighteen arms sharing ONE consequent, where the arms above each
    ; have their own. Its twin, `statement_start_is_unported`, is gone with
    ; slice 9: every token that was on it now has a destination.
    function statement_start_is_declaration_keyword(k: int) returns bool
    {
        if k = KindAsyncKeyword
            return true
        if k = KindInterfaceKeyword
            return true
        if k = KindTypeKeyword
            return true
        if k = KindModuleKeyword
            return true
        if k = KindNamespaceKeyword
            return true
        if k = KindDeclareKeyword
            return true
        if k = KindConstKeyword
            return true
        if k = KindEnumKeyword
            return true
        if k = KindExportKeyword
            return true
        if k = KindImportKeyword
            return true
        if k = KindPrivateKeyword
            return true
        if k = KindProtectedKeyword
            return true
        if k = KindPublicKeyword
            return true
        if k = KindAbstractKeyword
            return true
        if k = KindAccessorKeyword
            return true
        if k = KindStaticKeyword
            return true
        if k = KindReadonlyKeyword
            return true
        if k = KindGlobalKeyword
            return true
        false
    }

    ; ── the declaration router ──────────────────────────────────────────────
    ;
    ; Every declaration form goes through here, because every one of them can
    ; carry modifiers and the modifiers are parsed before anyone knows what they
    ; modify. Only the variable-statement arm is ported; the rest report
    ; themselves, so this slice buys the ROUTE rather than the destinations —
    ; which is the point, since the route is what the 49 % of corpus cases
    ; blocked on `export`, `const` and `declare` were stopped by.

    procedure parse_declaration(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers(true, false, false)
        if this.is_unported()
            return null

        ; `declare` makes the whole declaration ambient, and the flag reaches
        ; the modifier nodes too — they were finished before the context flag
        ; was set, so they are marked by hand, exactly as the reference does.
        if has_modifier(modifiers, KindDeclareKeyword)
        {
            let len modifiers.get_length() as int
            var i 0
            while i < len
            {
                let m *(modifiers.get_buffer() + i)
                set m.flags: m.flags | NodeFlagsAmbient
                set i: i + 1
            }
            let saved context_flags
            set context_flags: context_flags | NodeFlagsAmbient
            let result this.parse_declaration_worker(pos, jsdoc, modifiers)
            set context_flags: saved
            return result
        }

        this.parse_declaration_worker(pos, jsdoc, modifiers)
    }

    ; The reference keeps a ModifierList carrying a precomputed ModifierFlags
    ; bit set; here the list is a plain Array of Token nodes and the question is
    ; asked of it directly. Same answer — ModifiersToFlags is a fold over exactly
    ; these kinds — and it keeps the port from needing a second flag table whose
    ; only job is to mirror the Kind table.
    function has_modifier(modifiers: pointer[Array[pointer[AstNode]]], kind: int) returns bool
    {
        if modifiers = null
            return false
        let len modifiers.get_length() as int
        var i 0
        while i < len
        {
            let m *(modifiers.get_buffer() + i)
            if AstNode.kind_of(m) = kind
                return true
            set i: i + 1
        }
        false
    }

    procedure parse_declaration_worker(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        if token = KindVarKeyword
            return this.parse_variable_statement(pos, jsdoc, modifiers)
        if token = KindLetKeyword
            return this.parse_variable_statement(pos, jsdoc, modifiers)
        if token = KindConstKeyword
            return this.parse_variable_statement(pos, jsdoc, modifiers)
        if token = KindUsingKeyword
            return this.parse_variable_statement(pos, jsdoc, modifiers)
        if token = KindFunctionKeyword
            return this.parse_function_declaration(pos, jsdoc, modifiers)
        if token = KindTypeKeyword
            return this.parse_type_alias_declaration(pos, jsdoc, modifiers)
        if token = KindClassKeyword
            return this.parse_class_declaration(pos, jsdoc, modifiers)
        if token = KindInterfaceKeyword
            return this.parse_interface_declaration(pos, jsdoc, modifiers)
        if token = KindEnumKeyword
            return this.parse_enum_declaration(pos, jsdoc, modifiers)
        ; The reference gives these three one case arm, and so does the routine
        ; they call: `global`, `module` and `namespace` all produce a
        ; KindModuleDeclaration and differ only in the keyword it records.
        if token = KindGlobalKeyword
            return this.parse_module_declaration(pos, jsdoc, modifiers)
        if token = KindModuleKeyword
            return this.parse_module_declaration(pos, jsdoc, modifiers)
        if token = KindNamespaceKeyword
            return this.parse_module_declaration(pos, jsdoc, modifiers)

        if token = KindImportKeyword
            return this.parse_import_declaration_or_import_equals_declaration(pos, jsdoc, modifiers)

        ; The export arm is the one that decides between four productions on
        ; the token AFTER the keyword, which is why it consumes it here rather
        ; than in the routines below.
        if token = KindExportKeyword
        {
            this.next_token()
            if token = KindDefaultKeyword
                return this.parse_export_assignment(pos, jsdoc, modifiers)
            if token = KindEqualsToken
                return this.parse_export_assignment(pos, jsdoc, modifiers)
            if token = KindAsKeyword
                return this.parse_namespace_export_declaration(pos, jsdoc, modifiers)
            return this.parse_export_declaration(pos, jsdoc, modifiers)
        }

        ; ★★★ `export await using x = f()` — an `await using` declaration
        ; carrying MODIFIERS. It stood here as a deliberately absent arm on the
        ; argument that "no corpus case reaches it", and stage 2 reaches it: the
        ; unported report never fired, because the modifier list is non-null on
        ; this path, so the fallthrough below produced a MissingDeclaration for
        ; the `export` plus a second statement for the rest — rc 0, one
        ; diagnostic, and a tree the reference makes ONE VariableStatement of.
        ; ★ The lesson is about the SHAPE of the note rather than the arm:
        ; an omission whose escape hatch is unreachable is not an omission, it is
        ; a wrong answer with a comment above it (§3.5bn).
        if token = KindAwaitKeyword
        {
            if this.is_await_using_declaration()
                return this.parse_variable_statement(pos, jsdoc, modifiers)
        }

        if modifiers = null
            return this.unported("declaration", token)

        ; The reference's own fallthrough: decorators and/or modifiers promised a
        ; declaration that never arrived, so report where it should have started
        ; and leave an incomplete one behind for recovery and error reporting.
        ; With NO modifiers the reference PANICS instead — isStartOfDeclaration
        ; promised one — and a panic is not something to reproduce, which is what
        ; the unported report above stands in for.
        let zero this.node_pos()
        this.parse_error_at(zero, zero, DiagDeclaration_expected)
        this.finish_node(this.new_node(KindMissingDeclaration, NodeData.MissingDeclaration(ElementListData(modifiers))), pos)
    }

    ; ════ MODIFIERS AND DECORATORS (slices 2 and 12) ════════════════════════
    ;
    ; parseModifiersEx. Answers the list, or null when there is none — the
    ; reference returns a nil ModifierList in that case and ForEachChild then
    ; visits no modifier at all, which is what keeps `var x;` a one-child
    ; statement.
    ;
    ; ── the DECORATOR, slice 12 ─────────────────────────────────────────────
    ;
    ; The last construct the unported histogram named: ten corpus cases, all
    ; ten bought. It is four small pieces and none of them is a route —
    ; parse_decorator and parse_decorator_expression below, the two-run
    ; bookkeeping in the loop, and parse_decorated_expression down at the class
    ; family (the `@` arm of the primary expression).
    ;
    ; ★ Four call sites pass allow_decorators = true, which is the reference's
    ; count exactly: the declaration router, the class member, the parameter and
    ; the object-literal element. The FOURTH is dead in the reference too and is
    ; ported as written rather than dropped — isListElement(PCObjectLiteralMembers)
    ; admits `[`, `*`, `...`, `.` and a literal property name, and `@` is none
    ; of them, so the literal ends before parseObjectLiteralElement is ever
    ; asked. A control that turns that one to false changes nothing, and the
    ; reason it changes nothing is a fact about the reference (§3.5v, the
    ; "unreachable" row), not a gap in the fixtures.

    ; ★ A DECORATOR IS AN ELEMENT OF THIS LIST, not a slot of its own on the
    ; node that carries it. That is the reference's shape — one ModifierList
    ; holding both, with `Node.Decorators()` a FILTER over it — and it is why
    ; slice 12 added no field to any carrying record.
    ;
    ; The three booleans are the reference's, and they encode one rule the
    ; comment there states and the code enforces: decorators may appear in TWO
    ; runs (`[...leadingDecorators, ...leadingModifiers, ...trailingDecorators,
    ; ...trailingModifiers]`) but not in three. Once a modifier has followed a
    ; TRAILING decorator, `hasTrailingModifier` shuts the decorator arm off for
    ; good, and the loop ends at the next `@` because try_parse_modifier answers
    ; nothing for it. Having both runs at once is illegal and is left to the
    ; CHECKER — the parser builds the list and says nothing, so `export @dec
    ; class C {}` parses here exactly as it does upstream.
    procedure parse_modifiers(this, allow_decorators: bool, permit_const_as_modifier: bool, stop_on_start_of_class_static_block: bool) returns pointer[Array[pointer[AstNode]]]
    {
        ; parseModifiersEx's `pos := p.nodePos()`, which becomes the modifier
        ; list's range start. checkJSSyntax reports a parameter's modifiers at the
        ; LIST's range, so this one is read (see record_list_range).
        let pos this.node_pos()
        let list AstNode.new_node_list(host)
        var has_leading_modifier false
        var has_trailing_decorator false
        var has_trailing_modifier false
        var has_static_modifier false

        while true
        {
            var took_decorator false
            if allow_decorators
            {
                if token = KindAtToken
                {
                    if has_trailing_modifier = false
                    {
                        let d this.parse_decorator()
                        if d = null
                            return null
                        list.add(d)
                        if has_leading_modifier
                            set has_trailing_decorator: true
                        set took_decorator: true
                    }
                }
            }

            if took_decorator = false
            {
                let m this.try_parse_modifier(has_static_modifier, permit_const_as_modifier, stop_on_start_of_class_static_block)
                if m = null
                    break
                if AstNode.kind_of(m) = KindStaticKeyword
                    set has_static_modifier: true
                list.add(m)
                if has_trailing_decorator
                    set has_trailing_modifier: true
                else
                    set has_leading_modifier: true
            }
        }

        if list.get_length() as int = 0
            return null
        this.record_list_range(list, pos, this.node_pos())
        list
    }

    ; parseDecorator. The `@` is consumed, then a LEFT-HAND-SIDE expression —
    ; not an assignment expression: `@a.b.c()` is the whole of what a decorator
    ; may be, which is what keeps `@a = b` from parsing.
    ;
    ; ★ The context flag is restored BEFORE finish_node, because doInContext
    ; returns before the node is built. So the Decorator node itself does NOT
    ; carry DecoratorContext while every node of its expression does — a
    ; one-line ordering the yardstick can see, and a control is aimed at it.
    procedure parse_decorator(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindAtToken)

        let saved context_flags
        this.set_context_flags(NodeFlagsDecoratorContext, true)
        let expression this.parse_decorator_expression()
        set context_flags: saved
        if expression = null
            return null

        this.finish_node(this.new_node(KindDecorator, NodeData.Decorator(WrappedTypeData(expression))), pos)
    }

    ; parseDecoratorExpression. `@await` inside an [Await] context is disallowed
    ; and, in the reference's words, "can cause parsing to go off the rails" — so
    ; it reports Expression_expected, takes the `await` as the identifier it
    ; cannot be, steps over it and carries on through the member and call rests.
    ; That recovery is why the arm exists at all, and it is only portable now.
    procedure parse_decorator_expression(this) returns pointer[AstNode]
    {
        if this.in_await_context()
        {
            if token = KindAwaitKeyword
            {
                let pos this.node_pos()
                let await_expression this.parse_identifier_with_diagnostic(DiagExpression_expected, 0)
                if await_expression = null
                    return null
                this.next_token()
                let member_expression this.parse_member_expression_rest(pos, await_expression, true)
                if member_expression = null
                    return null
                return this.parse_call_expression_rest(pos, member_expression)
            }
        }
        this.parse_left_hand_side_expression_or_higher()
    }

    procedure try_parse_modifier(this, has_seen_static_modifier: bool, permit_const_as_modifier: bool, stop_on_start_of_class_static_block: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let kind token

        if token = KindConstKeyword
        {
            if permit_const_as_modifier
            {
                ; Any following modifier must be on the same line, so that a
                ; standalone `const` declaration is not mistaken for one.
                if this.look_ahead_next_token_is_on_same_line_and_can_follow_modifier() = false
                    return null
                this.next_token()
                return this.finish_node(this.new_node(kind, NodeData.Token(TokenData())), pos)
            }
        }

        if stop_on_start_of_class_static_block
        {
            if token = KindStaticKeyword
            {
                if this.look_ahead_next_token_is_open_brace()
                    return null
            }
        }

        if has_seen_static_modifier
        {
            if token = KindStaticKeyword
                return null
        }

        if this.parse_any_contextual_modifier() = false
            return null

        this.finish_node(this.new_node(kind, NodeData.Token(TokenData())), pos)
    }

    procedure parse_any_contextual_modifier(this) returns bool
    {
        let saved this.mark()
        if is_modifier_kind(token)
        {
            if this.next_token_can_follow_modifier()
                return true
        }
        this.rewind(saved)
        false
    }

    procedure next_token_can_follow_modifier(this) returns bool
    {
        ; `const` is a modifier only in `const enum`.
        if token = KindConstKeyword
            return this.next_token() = KindEnumKeyword

        if token = KindExportKeyword
        {
            this.next_token()
            if token = KindDefaultKeyword
                return this.look_ahead_next_token_can_follow_default_keyword()
            if token = KindTypeKeyword
                return this.look_ahead_next_token_can_follow_export_modifier()
            return this.can_follow_export_modifier()
        }

        if token = KindDefaultKeyword
            return this.next_token_can_follow_default_keyword()

        if token = KindStaticKeyword
        {
            this.next_token()
            return this.can_follow_modifier()
        }

        if token = KindGetKeyword
        {
            this.next_token()
            return this.can_follow_get_or_set_keyword()
        }
        if token = KindSetKeyword
        {
            this.next_token()
            return this.can_follow_get_or_set_keyword()
        }

        this.next_token_is_on_same_line_and_can_follow_modifier()
    }

    procedure next_token_can_follow_default_keyword(this) returns bool
    {
        this.next_token()
        if token = KindClassKeyword
            return true
        if token = KindFunctionKeyword
            return true
        if token = KindInterfaceKeyword
            return true
        if token = KindAtToken
            return true
        if token = KindAbstractKeyword
            return this.look_ahead_next_token_is_class_keyword_on_same_line()
        if token = KindAsyncKeyword
            return this.look_ahead_next_token_is_function_keyword_on_same_line()
        false
    }

    procedure next_token_can_follow_export_modifier(this) returns bool
    {
        this.next_token()
        this.can_follow_export_modifier()
    }

    function can_follow_export_modifier(this) returns bool
    {
        if token = KindAtToken
            return true
        if token = KindAsteriskToken
            return false
        if token = KindAsKeyword
            return false
        if token = KindOpenBraceToken
            return false
        this.can_follow_modifier()
    }

    function can_follow_modifier(this) returns bool
    {
        if token = KindOpenBracketToken
            return true
        if token = KindOpenBraceToken
            return true
        if token = KindAsteriskToken
            return true
        if token = KindDotDotDotToken
            return true
        this.is_literal_property_name()
    }

    function can_follow_get_or_set_keyword(this) returns bool
    {
        if token = KindOpenBracketToken
            return true
        this.is_literal_property_name()
    }

    procedure next_token_is_on_same_line_and_can_follow_modifier(this) returns bool
    {
        this.next_token()
        if this.has_preceding_line_break()
            return false
        this.can_follow_modifier()
    }

    function is_literal_property_name(this) returns bool
    {
        if token_is_identifier_or_keyword(token)
            return true
        if token = KindStringLiteral
            return true
        if token = KindNumericLiteral
            return true
        token = KindBigIntLiteral
    }

    ; Ported from internal/parser/utilities.go: identifiers and every keyword sit
    ; ABOVE KindIdentifier in one contiguous run, so the test is a single >=.
    function token_is_identifier_or_keyword(k: int) returns bool
        k >= KindIdentifier

    ; ast.IsModifierKind.
    function is_modifier_kind(k: int) returns bool
    {
        if k = KindAbstractKeyword
            return true
        if k = KindAccessorKeyword
            return true
        if k = KindAsyncKeyword
            return true
        if k = KindConstKeyword
            return true
        if k = KindDeclareKeyword
            return true
        if k = KindDefaultKeyword
            return true
        if k = KindExportKeyword
            return true
        if k = KindInKeyword
            return true
        if k = KindPrivateKeyword
            return true
        if k = KindProtectedKeyword
            return true
        if k = KindPublicKeyword
            return true
        if k = KindReadonlyKeyword
            return true
        if k = KindOutKeyword
            return true
        if k = KindOverrideKeyword
            return true
        k = KindStaticKeyword
    }

    ; ── isStartOfDeclaration ────────────────────────────────────────────────
    ;
    ; The one question that decides whether a contextual keyword starts a
    ; declaration or is just a name. It is a look-ahead LOOP: `export declare
    ; const` walks three tokens before it can answer.

    procedure is_start_of_declaration(this) returns bool
    {
        let saved this.mark()
        let r this.scan_start_of_declaration()
        this.rewind(saved)
        r
    }

    procedure scan_start_of_declaration(this) returns bool
    {
        while true
        {
            if token = KindVarKeyword
                return true
            if token = KindLetKeyword
                return true
            if token = KindConstKeyword
                return true
            if token = KindFunctionKeyword
                return true
            if token = KindClassKeyword
                return true
            if token = KindEnumKeyword
                return true

            if token = KindUsingKeyword
                return this.is_using_declaration()
            if token = KindAwaitKeyword
                return this.is_await_using_declaration()

            ; `declare`, `module`, `namespace`, `interface` and `type` are all
            ; legal identifiers — but an identifier cannot be followed by another
            ; identifier on the SAME LINE, and that is what tells the two apart.
            if token = KindInterfaceKeyword
                return this.next_token_is_identifier_on_same_line()
            if token = KindTypeKeyword
                return this.next_token_is_identifier_on_same_line()
            if token = KindDeferKeyword
                return this.next_token_is_identifier_on_same_line()

            if token = KindModuleKeyword
                return this.next_token_is_identifier_or_string_literal_on_same_line()
            if token = KindNamespaceKeyword
                return this.next_token_is_identifier_or_string_literal_on_same_line()

            if token = KindGlobalKeyword
            {
                this.next_token()
                if token = KindOpenBraceToken
                    return true
                if token = KindIdentifier
                    return true
                return token = KindExportKeyword
            }

            if token = KindImportKeyword
            {
                this.next_token()
                if token = KindDeferKeyword
                    return true
                if token = KindStringLiteral
                    return true
                if token = KindAsteriskToken
                    return true
                if token = KindOpenBraceToken
                    return true
                return token_is_identifier_or_keyword(token)
            }

            if token = KindExportKeyword
            {
                this.next_token()
                if token = KindEqualsToken
                    return true
                if token = KindAsteriskToken
                    return true
                if token = KindOpenBraceToken
                    return true
                if token = KindDefaultKeyword
                    return true
                if token = KindAsKeyword
                    return true
                if token = KindAtToken
                    return true
                if token = KindTypeKeyword
                {
                    this.next_token()
                    if token = KindAsteriskToken
                        return true
                    if token = KindOpenBraceToken
                        return true
                    if this.is_identifier()
                        return this.has_preceding_line_break() = false
                    return false
                }
                continue
            }

            if token = KindStaticKeyword
            {
                this.next_token()
                continue
            }

            ; The modifier keywords, which loop: ASI applies to each of them, and
            ; `declare type` commits to a type alias regardless.
            if this.token_is_loopable_modifier()
            {
                let previous token
                this.next_token()
                if this.has_preceding_line_break()
                    return false
                if previous = KindDeclareKeyword
                {
                    if token = KindTypeKeyword
                        return true
                }
                continue
            }

            return false
        }
        false
    }

    function token_is_loopable_modifier(this) returns bool
    {
        if token = KindAbstractKeyword
            return true
        if token = KindAccessorKeyword
            return true
        if token = KindAsyncKeyword
            return true
        if token = KindDeclareKeyword
            return true
        if token = KindPrivateKeyword
            return true
        if token = KindProtectedKeyword
            return true
        if token = KindPublicKeyword
            return true
        token = KindReadonlyKeyword
    }

    procedure next_token_is_identifier_on_same_line(this) returns bool
    {
        this.next_token()
        if this.is_identifier() = false
            return false
        this.has_preceding_line_break() = false
    }

    procedure next_token_is_identifier_or_string_literal_on_same_line(this) returns bool
    {
        this.next_token()
        var ok this.is_identifier()
        if ok = false
        {
            if token = KindStringLiteral
                set ok: true
        }
        if ok = false
            return false
        this.has_preceding_line_break() = false
    }

    procedure is_using_declaration(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_binding_identifier_or_start_of_destructuring_on_same_line(false)
        this.rewind(saved)
        r
    }

    procedure is_await_using_declaration(this) returns bool
    {
        let saved this.mark()
        var r false
        if this.next_token() = KindUsingKeyword
            set r: this.next_token_is_binding_identifier_or_start_of_destructuring_on_same_line(false)
        this.rewind(saved)
        r
    }

    procedure next_token_is_binding_identifier_or_start_of_destructuring_on_same_line(this, disallow_of: bool) returns bool
    {
        this.next_token()
        if disallow_of
        {
            if token = KindOfKeyword
                return this.look_ahead_next_token_is_equals_or_semicolon_or_colon_token()
        }
        var ok this.is_binding_identifier()
        if ok = false
        {
            if token = KindOpenBraceToken
                set ok: true
        }
        if ok = false
            return false
        this.has_preceding_line_break() = false
    }

    ; ── the look-ahead wrappers ─────────────────────────────────────────────
    ;
    ; One per call site, each marking and rewinding around a single question.
    ; See CLAUDE.md §3.9e for why the reference's `lookAhead(callback)` does not
    ; survive as a callback.

    ; parseJSONText's two, both `lookAhead(func(p) bool { ... })` upstream.
    ;
    ; ★ Go's `&&` short-circuits, so the SECOND next_token must not run when the
    ; first answered something other than a numeric literal — a rewind would put
    ; it back either way, but the reference's callback stops there and a port
    ; that always advanced twice would be reading a different question.
    procedure look_ahead_next_token_is_numeric_literal_not_followed_by_colon(this) returns bool
    {
        let saved this.mark()
        var r this.next_token() = KindNumericLiteral
        if r
            set r: this.next_token() <> KindColonToken
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_not_colon(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() <> KindColonToken
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_open_brace(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() = KindOpenBraceToken
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_class_keyword_on_same_line(this) returns bool
    {
        let saved this.mark()
        var r this.next_token() = KindClassKeyword
        if r
            set r: this.has_preceding_line_break() = false
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_function_keyword_on_same_line(this) returns bool
    {
        let saved this.mark()
        var r this.next_token() = KindFunctionKeyword
        if r
            set r: this.has_preceding_line_break() = false
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_can_follow_default_keyword(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_can_follow_default_keyword()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_can_follow_export_modifier(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_can_follow_export_modifier()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_on_same_line_and_can_follow_modifier(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_on_same_line_and_can_follow_modifier()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_equals_or_semicolon_or_colon_token(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r token = KindEqualsToken
        if r = false
        {
            if token = KindSemicolonToken
                set r: true
        }
        if r = false
        {
            if token = KindColonToken
                set r: true
        }
        this.rewind(saved)
        r
    }

    procedure parse_empty_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindSemicolonToken)
        let result this.finish_node(this.new_node(KindEmptyStatement, NodeData.EmptyStatement(EmptyStatementData())), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_block(this) returns pointer[AstNode]
        this.parse_block_ex(false, 0)

    ; ★★★ Three things landed here with slice 13c, and the hand-written loop this
    ; replaces had all three folded into "stop and report".
    ;
    ; (a) The statements are a LIST — parse_list(PCBlockStatements) — so the
    ;     block joins `parsing_contexts` and a broken statement inside it can
    ;     ask whether the block, or anything outside it, could use the token.
    ; (b) `ignore_missing_open_brace` parses the body EVEN WITH NO `{`, which is
    ;     the arrow-function recovery ParseFlagsIgnoreMissingOpenBrace exists
    ;     for; without the open brace and without the flag the reference builds a
    ;     Block over a MISSING list, which is an empty one here.
    ; (c) The `=` arm, which is a diagnostic about what the user probably meant:
    ;     a block followed by `=` is most likely a destructuring assignment that
    ;     needed parentheses. It reports and CONSUMES the `=`, so the enclosing
    ;     statement list does not see it and report again.
    procedure parse_block_ex(this, ignore_missing_open_brace: bool, code: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let open_brace_position scanner.token_start()
        let open_brace_parsed this.parse_expected_with_diagnostic(KindOpenBraceToken, code, true)

        var parse_body open_brace_parsed
        if ignore_missing_open_brace
            set parse_body: true
        if parse_body = false
        {
            ; No brace and no licence to go on: a Block over a MISSING list —
            ; the sentinel, not a fresh empty one, because that is what the
            ; reference builds here and the two are a distinction it keeps.
            let empty this.finish_node(this.new_node(KindBlock, NodeData.Block(BlockData(this.create_missing_list()))), pos)
            return this.with_jsdoc(empty, jsdoc)
        }

        let statements this.parse_list(PCBlockStatements)
        if statements = null
            return null
        this.parse_expected_matching_brackets(KindOpenBraceToken, KindCloseBraceToken, open_brace_parsed, open_brace_position)

        let result this.finish_node(this.new_node(KindBlock, NodeData.Block(BlockData(statements))), pos)
        let with_doc this.with_jsdoc(result, jsdoc)
        if with_doc = null
            return null
        if token = KindEqualsToken
        {
            this.parse_error_at_current_token(DiagDeclaration_or_statement_expected_This_follows_a_block_of_statements_so_if_you_intended_to_write_a_destructuring_assignment_you_might_need_to_wrap_the_whole_assignment_in_parentheses)
            this.next_token()
        }
        with_doc
    }

    ; ── the two statements a function BODY needs ────────────────────────────
    ;
    ; They land with slice 4 rather than with the statement spine because that is
    ; when they became reachable: before a function declaration parsed, no
    ; `return` in the corpus was ever looked at, and the unported histogram said
    ; so — `return` and `if` were absent from it entirely and went straight to
    ; third and fourth place the moment function bodies started parsing.
    ;
    ; ★ The reference's parseExpectedMatchingBrackets(`(`, `)`, …) is a
    ; parse_expected here: its whole extra job is to attach a "the parser
    ; expected to find a `)` to match the `(` here" note to a diagnostic, and on
    ; the path where the bracket IS there the two are the same call.

    procedure parse_if_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindIfKeyword)
        let open_paren_position scanner.token_start()
        let open_paren_parsed this.parse_expected(KindOpenParenToken)
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        this.parse_expected_matching_brackets(KindOpenParenToken, KindCloseParenToken, open_paren_parsed, open_paren_position)

        let then_statement this.parse_statement()
        if then_statement = null
            return null

        var else_statement null as pointer[AstNode]
        if this.parse_optional(KindElseKeyword)
        {
            set else_statement: this.parse_statement()
            if else_statement = null
                return null
        }

        let result this.finish_node(this.new_node(KindIfStatement, NodeData.IfStatement(IfStatementData(expression, then_statement, else_statement))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_return_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindReturnKeyword)

        ; A bare `return;` — or a `return` that ASI ends — carries no expression.
        var expression null as pointer[AstNode]
        if this.can_parse_semicolon() = false
        {
            set expression: this.parse_expression_allow_in()
            if expression = null
                return null
        }

        this.parse_semicolon()

        let result this.finish_node(this.new_node(KindReturnStatement, NodeData.ReturnStatement(ReturnStatementData(expression))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; THE LOOP AND BRANCH STATEMENTS — parser slice 9
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; The remaining arms of parseStatement, which the slice-8 histogram named as
    ; 20.7 % of corpus first blockers across six tags. Unlike every slice since
    ; the second, these are SIX independent ports rather than one route — nothing
    ; here is shared machinery, which is why the row looked bigger than it is.
    ;
    ; ★ What they DO share is the `for` head, and it is the reason this row was
    ; taken before the three smaller ones: DisallowInContext is set nowhere else
    ; in the language, so until the for statement parsed, three claims in this
    ; port rested on its absence — parse_variable_declaration_list's two
    ; (see there) and parse_list_element's note that the difference between the
    ; array-literal and argument-expression element contexts "only shows inside a
    ; `for` initializer or a decorator, and both of those are unported, so no
    ; case in this suite can see it". §3.5p: a claim resting on another part of
    ; the port being incomplete has an expiry date, and this slice owns all
    ; three. It also makes slice 7's one UNREACHABLE control reachable — the enum
    ; member's DisallowIn clear — which is what parser_for_disallow_in_enum.ts
    ; is for.
    ;
    ; ★ The reference's parseExpectedMatchingBrackets(`(`, `)`, …) is a
    ; parse_expected here, for the reason parse_if_statement already records: its
    ; whole extra job is to attach a "the parser expected to find a `)` to match
    ; the `(` here" note to a diagnostic, and on the path where the bracket IS
    ; there the two calls are the same.

    ; ★ statement BEFORE expression, both in the parse and in the walk: `do`
    ; runs its body before it evaluates its condition. See DoStatementData.
    procedure parse_do_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindDoKeyword)
        let statement this.parse_statement()
        if statement = null
            return null
        this.parse_expected(KindWhileKeyword)
        let open_paren_position scanner.token_start()
        let open_paren_parsed this.parse_expected(KindOpenParenToken)
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        this.parse_expected_matching_brackets(KindOpenParenToken, KindCloseParenToken, open_paren_parsed, open_paren_position)

        ; ★ An OPTIONAL semicolon, not parse_semicolon — and the reference
        ; carries the es-discuss thread that decided it: `do;while(0)x` has a
        ; semicolon inserted before `x`, which the spec prohibited and "consensus
        ; reality" allowed. So a missing one here is not even an ASI question,
        ; and this is the one statement in the family that cannot report a
        ; missing-semicolon diagnostic.
        this.parse_optional(KindSemicolonToken)

        let result this.finish_node(this.new_node(KindDoStatement, NodeData.DoStatement(DoStatementData(statement, expression))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_while_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindWhileKeyword)
        let open_paren_position scanner.token_start()
        let open_paren_parsed this.parse_expected(KindOpenParenToken)
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        this.parse_expected_matching_brackets(KindOpenParenToken, KindCloseParenToken, open_paren_parsed, open_paren_position)
        let statement this.parse_statement()
        if statement = null
            return null

        let result this.finish_node(this.new_node(KindWhileStatement, NodeData.WhileStatement(ControlledStatementData(expression, statement))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ★★★ parseForOrForInOrForOfStatement — three statement kinds out of one
    ; head, and the SELECTION is a Go `switch` over boolean cases whose
    ; short-circuiting is load-bearing:
    ;
    ;     case awaitToken != nil && p.parseExpected(Of) || awaitToken == nil && p.parseOptional(Of):
    ;
    ; With an `await` present the `of` is REQUIRED — parseExpected reports a
    ; diagnostic when it is missing AND ANSWERS FALSE, so the head falls through
    ; to `in` and then to the three-part form — and without one it is merely
    ; optional, which lets the same head fall through without a word.
    procedure parse_for_or_for_in_or_for_of_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindForKeyword)
        let await_token this.parse_optional_token(KindAwaitKeyword)
        this.parse_expected(KindOpenParenToken)

        var initializer null as pointer[AstNode]
        if token <> KindSemicolonToken
        {
            ; `var`, `let` and `const` always start a declaration list here;
            ; `using` and `await using` are contextual and need the look-ahead,
            ; the first of them with disallowOf ON so that `for (using of x)`
            ; reads `of` as the keyword. The reference's comment on the second
            ; arm — "this one is meant to allow of" — is why the two differ.
            var is_declaration false
            if token = KindVarKeyword
                set is_declaration: true
            if token = KindLetKeyword
                set is_declaration: true
            if token = KindConstKeyword
                set is_declaration: true
            if is_declaration = false
            {
                if token = KindUsingKeyword
                    set is_declaration: this.is_using_declaration_in_for_initializer()
            }
            if is_declaration = false
            {
                if token = KindAwaitKeyword
                    set is_declaration: this.is_await_using_declaration()
            }

            if is_declaration
                set initializer: this.parse_variable_declaration_list(true)
            else
            {
                ; doInContext(DisallowInContext, TRUE, parseExpression) — the one
                ; place in the language that SETS that flag on an expression, so
                ; `for (a in b;;)` cannot read `in` as an operator.
                let saved context_flags
                this.set_context_flags(NodeFlagsDisallowInContext, true)
                set initializer: this.parse_expression()
                set context_flags: saved
            }
            if initializer = null
                return null
        }

        ; ★★★ The chain, with its short-circuiting intact. With an `await`
        ; present the `of` is REQUIRED — and "required" means parse_expected
        ; REPORTS and answers FALSE, so the arm is not taken and the head falls
        ; through to `in` and then to the three-part form. That recovery is the
        ; whole of §3.5u and it is only reachable now: through slice 12 the same
        ; call reported unported and nothing fell through.
        var is_of false
        if await_token <> null
            set is_of: this.parse_expected(KindOfKeyword)
        else
            set is_of: this.parse_optional(KindOfKeyword)

        if is_of
        {
            ; doInContext(DisallowInContext, FALSE, …) — and note it is ONE
            ; assignment expression, not parse_expression: `for (x of a, b)`
            ; iterates over `a` and the comma is a syntax error.
            let saved context_flags
            this.set_context_flags(NodeFlagsDisallowInContext, false)
            let expression this.parse_assignment_expression_or_higher()
            set context_flags: saved
            if expression = null
                return null
            this.parse_expected(KindCloseParenToken)
            let statement this.parse_statement()
            if statement = null
                return null
            let result this.finish_node(this.new_node(KindForOfStatement, NodeData.ForOfStatement(ForInOrOfStatementData(await_token, initializer, expression, statement))), pos)
            return this.with_jsdoc(result, jsdoc)
        }

        if this.parse_optional(KindInKeyword)
        {
            let expression this.parse_expression_allow_in()
            if expression = null
                return null
            this.parse_expected(KindCloseParenToken)
            let statement this.parse_statement()
            if statement = null
                return null
            ; ★ The await modifier is passed as NULL here, not as await_token —
            ; the reference does the same, and it is not reachable rather than
            ; wrong: an `await` forces the `of` arm above or a diagnostic.
            let result this.finish_node(this.new_node(KindForInStatement, NodeData.ForInStatement(ForInOrOfStatementData(null, initializer, expression, statement))), pos)
            return this.with_jsdoc(result, jsdoc)
        }

        ; The three-part form. Both `;` are required and both bounds optional,
        ; which is what `for (;;) ;` is.
        this.parse_expected(KindSemicolonToken)
        var condition null as pointer[AstNode]
        if token <> KindSemicolonToken
        {
            if token <> KindCloseParenToken
            {
                set condition: this.parse_expression_allow_in()
                if condition = null
                    return null
            }
        }
        this.parse_expected(KindSemicolonToken)
        var incrementor null as pointer[AstNode]
        if token <> KindCloseParenToken
        {
            set incrementor: this.parse_expression_allow_in()
            if incrementor = null
                return null
        }
        this.parse_expected(KindCloseParenToken)
        let statement this.parse_statement()
        if statement = null
            return null

        let result this.finish_node(this.new_node(KindForStatement, NodeData.ForStatement(ForStatementData(initializer, condition, incrementor, statement))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; parseBreakStatement and parseContinueStatement — two routines with
    ; identical bodies and different kinds, kept as two here rather than folded
    ; behind a kind parameter. The reason is mechanical and worth stating: the
    ; union ARM is what selects the payload record and the child_at case, and an
    ; arm cannot travel in a variable — one shared routine would have to pick an
    ; arm anyway, leaving the other's `when` dead in ast.scaly.
    ;
    ; ★ The label is OPTIONAL, so a null answer from
    ; parse_identifier_unless_at_semicolon is not a failure and the STATE has to
    ; be asked instead. That is §3.5h: where null is a legitimate answer, the
    ; caller tests is_unported(), never the result.
    procedure parse_break_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindBreakKeyword)
        let label_id this.parse_identifier_unless_at_semicolon()
        if this.is_unported()
            return null
        this.parse_semicolon()

        let result this.finish_node(this.new_node(KindBreakStatement, NodeData.BreakStatement(BreakOrContinueStatementData(label_id))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_continue_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindContinueKeyword)
        let label_id this.parse_identifier_unless_at_semicolon()
        if this.is_unported()
            return null
        this.parse_semicolon()

        let result this.finish_node(this.new_node(KindContinueStatement, NodeData.ContinueStatement(BreakOrContinueStatementData(label_id))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_with_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindWithKeyword)
        let open_paren_position scanner.token_start()
        let open_paren_parsed this.parse_expected(KindOpenParenToken)
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        this.parse_expected_matching_brackets(KindOpenParenToken, KindCloseParenToken, open_paren_parsed, open_paren_position)

        ; ★ doInContext(InWithStatement, true, parseStatement) — the flag is
        ; observable in the DUMP, not just in what parses: every node of the
        ; controlled statement carries 1 << 24. Measured against the reference on
        ; `with (x) y;`.
        let saved context_flags
        this.set_context_flags(NodeFlagsInWithStatement, true)
        let statement this.parse_statement()
        set context_flags: saved
        if statement = null
            return null

        let result this.finish_node(this.new_node(KindWithStatement, NodeData.WithStatement(ControlledStatementData(expression, statement))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_switch_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindSwitchKeyword)
        this.parse_expected(KindOpenParenToken)
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        this.parse_expected(KindCloseParenToken)
        let case_block this.parse_case_block()
        if case_block = null
            return null

        let result this.finish_node(this.new_node(KindSwitchStatement, NodeData.SwitchStatement(SwitchStatementData(expression, case_block))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_case_block(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindOpenBraceToken)
        let clauses this.parse_list(PCSwitchClauses)
        if clauses = null
            return null
        this.parse_expected(KindCloseBraceToken)

        let result this.finish_node(this.new_node(KindCaseBlock, NodeData.CaseBlock(ElementListData(clauses))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_case_or_default_clause(this) returns pointer[AstNode]
    {
        if token = KindCaseKeyword
            return this.parse_case_clause()
        this.parse_default_clause()
    }

    procedure parse_case_clause(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindCaseKeyword)
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        this.parse_expected(KindColonToken)
        let statements this.parse_list(PCSwitchClauseStatements)
        if statements = null
            return null

        let result this.finish_node(this.new_node(KindCaseClause, NodeData.CaseClause(CaseOrDefaultClauseData(expression, statements))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_default_clause(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindDefaultKeyword)
        this.parse_expected(KindColonToken)
        let statements this.parse_list(PCSwitchClauseStatements)
        if statements = null
            return null

        let result this.finish_node(this.new_node(KindDefaultClause, NodeData.DefaultClause(CaseOrDefaultClauseData(null, statements))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ★★★ `throw` is the one statement in this family whose no-expression path is
    ; not an error. The grammar is `throw [no LineTerminator here] Expression;`,
    ; and the reference does NOT call parseExpression after a line break —
    ; because that would consume the expression on the following line — it
    ; synthesizes a zero-width MISSING identifier and reports nothing, leaving
    ; the complaint to the grammar walker. So `throw` NL `x;` is TWO statements
    ; here, and the first of them has a child of width 0.
    procedure parse_throw_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindThrowKeyword)

        var expression null as pointer[AstNode]
        if this.has_preceding_line_break()
            set expression: this.create_missing_identifier()
        else
            set expression: this.parse_expression_allow_in()
        if expression = null
            return null

        ; try_parse_semicolon, not parse_semicolon: the fallback is
        ; parseErrorForMissingSemicolonAfter, which guesses at the EXPRESSION
        ; rather than reporting a bare missing semicolon.
        if this.try_parse_semicolon() = false
            this.parse_error_for_missing_semicolon_after(expression)

        let result this.finish_node(this.new_node(KindThrowStatement, NodeData.ThrowStatement(ExpressionStatementData(expression))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_try_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindTryKeyword)
        let try_block this.parse_block()
        if try_block = null
            return null

        var catch_clause null as pointer[AstNode]
        if token = KindCatchKeyword
        {
            set catch_clause: this.parse_catch_clause()
            if catch_clause = null
                return null
        }

        ; ★ "If we don't have a catch clause, then we must have a finally
        ; clause. Try to parse one out no matter what." — so the absence of a
        ; catch makes `finally` REQUIRED, and parse_expected is what reports its
        ; absence.
        ;
        ; ★★★ The MESSAGE is its own — TS1472, *'catch' or 'finally' expected* —
        ; and the line that stood here said the generic TS1005 would do, because
        ; "both are diagnostics, so both stop this port at the same token". The
        ; yardstick compares the CODE, not whether a parse stopped: `try { };`
        ; came out 1005 against the reference's 1472. §3.5bn.
        var finally_block null as pointer[AstNode]
        var want_finally false
        if catch_clause = null
            set want_finally: true
        if token = KindFinallyKeyword
            set want_finally: true
        if want_finally
        {
            this.parse_expected_with_diagnostic(KindFinallyKeyword, DiagX_catch_or_finally_expected, true)
            set finally_block: this.parse_block()
            if finally_block = null
                return null
        }

        let result this.finish_node(this.new_node(KindTryStatement, NodeData.TryStatement(TryStatementData(try_block, catch_clause, finally_block))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ★ NO jsdoc — parseCatchClause is the one clause-shaped node in the
    ; reference whose routine does not call withJSDoc, while every statement
    ; around it does. Ported as written; see CatchClauseData.
    ;
    ; ★ The binding is OPTIONAL as a whole (`catch { }` is ES2019) and its
    ; declaration is parsed with parseVariableDeclaration, i.e. the
    ; NO-exclamation form — which is what the field default must not be. It is
    ; true here, so the `!` would be accepted; the reference accepts it too,
    ; because parseVariableDeclaration is the allowExclamation=FALSE entry point.
    procedure parse_catch_clause(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindCatchKeyword)

        var variable_declaration null as pointer[AstNode]
        if this.parse_optional(KindOpenParenToken)
        {
            let saved_allow variable_declaration_allow_exclamation
            set variable_declaration_allow_exclamation: false
            set variable_declaration: this.parse_variable_declaration()
            set variable_declaration_allow_exclamation: saved_allow
            if variable_declaration = null
                return null
            this.parse_expected(KindCloseParenToken)
        }

        let block this.parse_block()
        if block = null
            return null

        this.finish_node(this.new_node(KindCatchClause, NodeData.CatchClause(CatchClauseData(variable_declaration, block))), pos)
    }

    ; ★ A `Token` payload, not a record of its own: DebuggerStatement carries no
    ; field and no child, so the KIND is the whole node. See ast.scaly's header.
    procedure parse_debugger_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindDebuggerKeyword)
        this.parse_semicolon()

        let result this.finish_node(this.new_node(KindDebuggerStatement, NodeData.Token(TokenData())), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_variable_statement(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let list this.parse_variable_declaration_list(false)
        if list = null
            return null
        this.parse_semicolon()
        let result this.finish_node(this.new_node(KindVariableStatement, NodeData.VariableStatement(VariableStatementData(modifiers, list))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; ★★★ `in_for_statement_initializer` is what slice 9 had to add, and BOTH of
    ; the notes it replaces were §3.5p claims — true when written, expired by the
    ; slice that made the for statement parse. One said the `for (let of X)`
    ; empty-list shape "cannot be reached from here"; the other said the list is
    ; "always parsed with allowExclamation … the only caller that passes false is
    ; the for-statement initializer, which is unported". That caller exists now.
    procedure parse_variable_declaration_list(this, in_for_statement_initializer: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()

        var flags NodeFlagsNone
        if token = KindLetKeyword
            set flags: NodeFlagsLet
        if token = KindConstKeyword
            set flags: NodeFlagsConst
        if token = KindUsingKeyword
            set flags: NodeFlagsUsing

        ; `await using` consumes TWO keywords and carries both bits. The
        ; reference's arm can also fall out of the switch without setting a flag
        ; — that is its `break`, reached when the look-ahead says this is not a
        ; declaration after all — but every caller has already asked the same
        ; question, so that path cannot be entered.
        if token = KindAwaitKeyword
        {
            set flags: NodeFlagsAwaitUsing
            this.next_token()
        }

        this.next_token()

        ; ★ `for (let of X)` — the user meant `of` as the keyword, and `of` is a
        ; legal identifier, so only a look-ahead can tell. The reference answers
        ; with createMissingList(): an EMPTY declaration list, after which the
        ; for statement reads `of` as the keyword and the CHECKER reports the
        ; empty list. Measured against the reference: the list node is present,
        ; spans `let` alone, carries NodeFlagsLet and has no children.
        var declarations null as pointer[Array[pointer[AstNode]]]
        var missing false
        if token = KindOfKeyword
        {
            if this.look_ahead_next_is_identifier_and_close_paren()
                set missing: true
        }
        if missing
            set declarations: AstNode.new_node_list(host)
        else
        {
            ; The two things the for initializer changes, and each is visible in
            ; the FLAGS the yardstick compares rather than only in what parses:
            ; DisallowIn is SET for the duration (so `for (var x = a in b;;)`
            ; does not read `in` as an operator, and every node of the list
            ; carries 1 << 10), and the element parser is the one that does NOT
            ; accept a `!` — a definite-assignment assertion is meaningless on a
            ; loop variable.
            ;
            ; The flag travels as parser STATE rather than as an argument for the
            ; §3.5k reason: parse_list_element dispatches statically on the
            ; parsing context, so what the reference passes as a func value has
            ; nowhere else to live. Saved and restored around the one call, as
            ; the three fields beside it are.
            let saved_flags context_flags
            let saved_allow variable_declaration_allow_exclamation
            this.set_context_flags(NodeFlagsDisallowInContext, in_for_statement_initializer)
            set variable_declaration_allow_exclamation: in_for_statement_initializer = false
            set declarations: this.parse_delimited_list(PCVariableDeclarations)
            set variable_declaration_allow_exclamation: saved_allow
            set context_flags: saved_flags
            if declarations = null
                return null
        }

        let n this.new_node(KindVariableDeclarationList, NodeData.VariableDeclarationList(VariableDeclarationListData(declarations)))
        set n.flags: n.flags | flags
        this.finish_node(n, pos)
    }

    procedure parse_variable_declaration(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()

        let name this.parse_identifier_or_pattern_with_diagnostic(DiagPrivate_identifiers_are_not_allowed_in_variable_declarations)
        if name = null
            return null

        ; parseVariableDeclarationWorker's allowExclamation, which is false in a
        ; for-statement initializer and true everywhere else. The reference also
        ; requires the NAME to be an Identifier — a `!` after a binding pattern
        ; is not an exclamation token — and since slice 10 that guard is REACHED
        ; rather than merely ported: `var [a]! = x` is the shape it decides, and
        ; it decides it by KIND, so the pattern falls through with no
        ; exclamation slot.
        var exclamation_token null as pointer[AstNode]
        if variable_declaration_allow_exclamation
        {
            if AstNode.kind_of(name) = KindIdentifier
            {
                if token = KindExclamationToken
                {
                    if this.has_preceding_line_break() = false
                    {
                        set exclamation_token: this.parse_token_node()
                        if exclamation_token = null
                            return null
                    }
                }
            }
        }

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }

        var initializer null as pointer[AstNode]
        if token <> KindInKeyword
        {
            if token <> KindOfKeyword
            {
                if this.parse_optional(KindEqualsToken)
                {
                    set initializer: this.parse_assignment_expression_or_higher()
                    if initializer = null
                        return null
                }
            }
        }

        let result this.finish_node(this.new_node(KindVariableDeclaration, NodeData.VariableDeclaration(VariableDeclarationData(name, exclamation_token, type_node, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; ── binding patterns (parser slice 10) ──────────────────────────────────
    ;
    ; parseIdentifierOrPattern and the four routines under it. Three call sites
    ; reach them — a variable declaration (the catch clause's binding included,
    ; which routes through the same one), a parameter's name, and
    ; skip_parameter_start's look-ahead — and they are the same three the
    ; reference has.
    ;
    ; ★ The reference threads a DIAGNOSTIC MESSAGE through here
    ; (parseIdentifierOrPatternWithDiagnostic), and its two callers pass
    ; different ones: "private identifiers are not allowed in variable
    ; declarations" (18029) and "private identifiers cannot be used as
    ; parameters" (18009). It was left out through slice 12 with the §3.5q
    ; argument written down — the only thing it could change was WHICH
    ; diagnostic a private identifier gets, and a private identifier was refused
    ; one level down as unported either way. That is a §3.5p claim, and slice
    ; 13c is its expiry: the two codes are now the whole difference between
    ; `var #x` and `function f(#x)`.
    procedure parse_identifier_or_pattern(this) returns pointer[AstNode]
        this.parse_identifier_or_pattern_with_diagnostic(0)

    procedure parse_identifier_or_pattern_with_diagnostic(this, private_code: int) returns pointer[AstNode]
    {
        if token = KindOpenBracketToken
            return this.parse_array_binding_pattern()
        if token = KindOpenBraceToken
            return this.parse_object_binding_pattern()
        this.parse_binding_identifier_with_diagnostic(private_code)
    }

    procedure parse_array_binding_pattern(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindOpenBracketToken)
        ; ★ The DisallowIn clear, and since slice 9 it is REACHABLE: a `for` head
        ; is the only thing in the language that sets the flag, so
        ; `for (var [a = b in c] = x;;)` is the shape that needs the `in` inside
        ; the initializer to stay an operator. Saved and restored around the
        ; list, exactly as the reference brackets it.
        let saved_flags context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let elements this.parse_delimited_list(PCArrayBindingElements)
        set context_flags: saved_flags
        if elements = null
            return null
        this.parse_expected(KindCloseBracketToken)
        this.finish_node(this.new_node(KindArrayBindingPattern, NodeData.ArrayBindingPattern(ElementListData(elements))), pos)
    }

    ; ★ An ELISION — the hole in `[, a]` — is a BindingElement with all four
    ; slots null, spanning nothing. Not an OmittedExpression: that is what an
    ; array LITERAL's hole is, and the two grammars give the same text two
    ; different node kinds. The reference's guard is `token != CommaToken`, so
    ; the element is built either way and only its contents depend on it.
    procedure parse_array_binding_element(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var dot_dot_dot_token null as pointer[AstNode]
        var name null as pointer[AstNode]
        var initializer null as pointer[AstNode]
        if token <> KindCommaToken
        {
            set dot_dot_dot_token: this.parse_optional_token(KindDotDotDotToken)
            if this.is_unported()
                return null
            set name: this.parse_identifier_or_pattern()
            if name = null
                return null
            set initializer: this.parse_initializer()
            if this.is_unported()
                return null
        }
        this.finish_node(this.new_node(KindBindingElement, NodeData.BindingElement(BindingElementData(dot_dot_dot_token, null, name, initializer))), pos)
    }

    procedure parse_object_binding_pattern(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindOpenBraceToken)
        let saved_flags context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let elements this.parse_delimited_list(PCObjectBindingElements)
        set context_flags: saved_flags
        if elements = null
            return null
        this.parse_expected(KindCloseBraceToken)
        this.finish_node(this.new_node(KindObjectBindingPattern, NodeData.ObjectBindingPattern(ElementListData(elements))), pos)
    }

    ; ★ `tokenIsIdentifier` is captured BEFORE the property name is parsed — the
    ; same shape as the object literal's shorthand test, and load-bearing for the
    ; same reason: after parse_property_name the token is whatever FOLLOWS the
    ; name, so asking then answers a different question. `{ a }` is shorthand
    ; (the property name becomes the NAME and the propertyName slot goes empty);
    ; `{ "a": b }` and `{ a: b }` both take the colon path.
    procedure parse_object_binding_element(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let dot_dot_dot_token this.parse_optional_token(KindDotDotDotToken)
        if this.is_unported()
            return null
        let token_is_identifier this.is_binding_identifier()
        var property_name this.parse_property_name()
        if property_name = null
            return null
        var name null as pointer[AstNode]
        var shorthand false
        if token_is_identifier
        {
            if token <> KindColonToken
                set shorthand: true
        }
        if shorthand
        {
            set name: property_name
            set property_name: null
        }
        else
        {
            this.parse_expected(KindColonToken)
            set name: this.parse_identifier_or_pattern()
            if name = null
                return null
        }
        let initializer this.parse_initializer()
        if this.is_unported()
            return null
        this.finish_node(this.new_node(KindBindingElement, NodeData.BindingElement(BindingElementData(dot_dot_dot_token, property_name, name, initializer))), pos)
    }

    ; ── identifiers ─────────────────────────────────────────────────────────
    ;
    ; The reference's createIdentifierWithDiagnostic and its three callers. They
    ; differ ONLY in the question they ask before building the node, which is
    ; why they are one function plus three one-liners here as well:
    ;
    ;   parseIdentifier      isIdentifier()               — a real identifier
    ;   parseIdentifierName  tokenIsIdentifierOrKeyword() — a NAME, keywords included
    ;   parseBindingIdentifier isBindingIdentifier()
    ;
    ; Every `false` answer leads into the reference's diagnostic arms, and since
    ; slice 13c they are ported rather than reported: three of them (a caller's
    ; own message, a reserved word, the generic "Identifier expected") report and
    ; synthesize a MISSING identifier — an empty name at a zero-width range — and
    ; the fourth, a PRIVATE identifier, reports and then parses the `#name` as
    ; though it had been a name all along.
    ;
    ; ★ The two message parameters were left out through slice 12 with the
    ; §3.5q argument written down ("ask what the mechanism is FOR"): the only
    ; thing they could change was WHICH diagnostic a private identifier gets, and
    ; nothing emitted one. That is a §3.5p claim with an expiry date and this is
    ; the slice it expires on — `let #x` and `function f(#x)` differ by exactly
    ; those two codes.
    ;
    ; `code = 0` is the reference's `message == nil`, as in parse_expected.

    procedure create_identifier(this, ok: bool) returns pointer[AstNode]
        this.create_identifier_with_diagnostic(ok, 0, 0)

    procedure create_identifier_with_diagnostic(this, ok: bool, code: int, private_code: int) returns pointer[AstNode]
    {
        if ok
        {
            ; ★★★ The token's START, not its FULL start, when a JSDoc margin
            ; asterisk was skipped in front of it — the reference's own branch,
            ; and the ONLY reader of TokenFlagsPrecedingJSDocLeadingAsterisks.
            ; Inside `{{` NL ` *   a: string }}` the `*` and the spaces around it
            ; are trivia to the type parser, so an identifier that took its full
            ; start would begin at the line break and swallow the margin.
            var pos this.node_pos()
            if scanner.has_preceding_jsdoc_leading_asterisks()
                set pos: scanner.token_start()

            ; The reference's newIdentifier sets statementHasAwaitIdentifier when
            ; the identifier's TEXT is "await". This asks the token KIND, and
            ; the two are the same question even now that the text is at hand:
            ; the keyword lookup runs on the DECODED value, so an escaped
            ; `await` scans as KindAwaitKeyword as well (§3.5q). Left as the
            ; kind because that is the fact, not because the text is missing.
            if token = KindAwaitKeyword
                set statement_has_await_identifier: true

            ; The reference's `text := p.scanner.TokenValue()` — read BEFORE the
            ; token is advanced, which is the whole reason it is a local there
            ; and a local here. The interning is not ported: it is a cache over
            ; a shared string table and changes no answer.
            let text scanner.token_value()
            let text_len scanner.token_value_length()
            this.next_token_without_check()
            return this.finish_node(this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData(text, text_len))), pos)
        }

        ; A private identifier is REFUSED here and then consumed: the reference
        ; reports and falls into createIdentifier(true), which builds an ordinary
        ; Identifier node out of the `#name` token. So the tree keeps its shape
        ; and only the diagnostic says what was wrong.
        if token = KindPrivateIdentifier
        {
            if private_code = 0
                this.parse_error_at_current_token(DiagPrivate_identifiers_are_not_allowed_outside_class_bodies)
            else
                this.parse_error_at_current_token(private_code)
            return this.create_identifier(true)
        }

        ; ★ At END OF FILE the report is a ZERO-WIDTH range at the full start
        ; rather than the token's own range, and the reference says why: "only for
        ; end of file because the error gets reported incorrectly on embedded
        ; script tags". EOF's token range is empty anyway, but its START is the
        ; scan position while the full start is before the trivia — so the two
        ; spellings differ by the whole run of whitespace at the end of a file.
        let report_at_current_position token = KindEndOfFile
        let zero this.node_pos()
        if code <> 0
        {
            if report_at_current_position
                this.parse_error_at(zero, zero, code)
            else
                this.parse_error_at_current_token(code)
        }
        else
        {
            if is_reserved_word(token)
            {
                ; The message takes the word's TEXT as its argument; the code and
                ; the span are what is compared, so the text is not carried.
                if report_at_current_position
                    this.parse_error_at(zero, zero, DiagIdentifier_expected_0_is_a_reserved_word_that_cannot_be_used_here)
                else
                    this.parse_error_at_current_token(DiagIdentifier_expected_0_is_a_reserved_word_that_cannot_be_used_here)
            }
            else
            {
                if report_at_current_position
                    this.parse_error_at(zero, zero, DiagIdentifier_expected)
                else
                    this.parse_error_at_current_token(DiagIdentifier_expected)
            }
        }
        this.create_missing_identifier()
    }

    function is_reserved_word(k: int) returns bool
        (k >= KindFirstReservedWord) and (k <= KindLastReservedWord)

    ; `#name`. A leaf, like Identifier — the reference interns its text and
    ; nothing else. It arrives with the class slice because a private name only
    ; exists inside a class body; every other position that accepts one accepts
    ; it in order to REFUSE it.
    procedure parse_private_identifier(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let text scanner.token_value()
        let text_len scanner.token_value_length()
        this.next_token()
        this.finish_node(this.new_node(KindPrivateIdentifier, NodeData.PrivateIdentifier(IdentifierData(text, text_len))), pos)
    }

    procedure parse_identifier(this) returns pointer[AstNode]
        this.parse_identifier_with_diagnostic(0, 0)

    procedure parse_identifier_with_diagnostic(this, code: int, private_code: int) returns pointer[AstNode]
        this.create_identifier_with_diagnostic(this.is_identifier(), code, private_code)

    ; ★★★ createMissingIdentifier — and it is NOT one of the diagnostic arms
    ; create_identifier's header describes, which is why it is a function of its
    ; own rather than a branch of that one. `throw` on a line of its own is
    ; LEGAL as far as the parser is concerned: the reference synthesizes a
    ; zero-width identifier, reports nothing, and leaves the grammar walker to
    ; complain. Measured against the reference on `throw` NL `x;` — the
    ; ThrowStatement spans `throw` alone and carries an Identifier of width 0.
    ;
    ; No token is consumed and statement_has_await_identifier is not touched: the
    ; reference's newIdentifier sets that from the identifier's TEXT, and this
    ; one's text is empty.
    procedure create_missing_identifier(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.finish_node(this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData(null, 0))), pos)
    }

    ; parseIdentifierUnlessAtSemicolon — the optional label of `break` and
    ; `continue`. `break;` and a `break` that ASI ends carry none.
    procedure parse_identifier_unless_at_semicolon(this) returns pointer[AstNode]
    {
        if this.can_parse_semicolon()
            return null
        this.parse_identifier()
    }

    procedure parse_identifier_name(this) returns pointer[AstNode]
        this.parse_identifier_name_with_diagnostic(0)

    procedure parse_identifier_name_with_diagnostic(this, code: int) returns pointer[AstNode]
        this.create_identifier_with_diagnostic(token_is_identifier_or_keyword(token), code, 0)

    ; ★★★ Slice 20. Same identifier, one extra REPORT: a JSX tag name, attribute
    ; name or namespace half may not be spelled with a unicode escape. The
    ; identifier is still built — the report is additive, so `<a\u0062>` parses as
    ; the tag `ab` and carries 17021 — which is what makes this the third
    ; parameter of parse_right_side_of_dot rather than a refusal.
    ;
    ; Both flags are asked because the two spellings are separate bits: `\u0062`
    ; sets UnicodeEscape and `\u{62}` sets ExtendedUnicodeEscape.
    procedure parse_identifier_name_error_on_unicode_escape_sequence(this) returns pointer[AstNode]
    {
        var escaped scanner.has_unicode_escape()
        if scanner.has_extended_unicode_escape()
            set escaped: true
        if escaped
            this.parse_error_at_current_token(DiagUnicode_escape_sequence_cannot_appear_here)
        this.create_identifier(token_is_identifier_or_keyword(token))
    }

    ; ★ A BINDING named `await` does not count towards the top-level-await
    ; reparse — `let await = 1` declares a variable, it does not use one — so the
    ; flag is saved and restored around it. Three more sites do the same
    ; (parse_property_name, parse_function_block, parse_right_side_of_dot's
    ; identifier-only branch); every other one belongs to a declaration form this
    ; slice reports as unported anyway.
    ;
    ; ★ The save/restore wraps the WHOLE call, the failing path included — which
    ; matters now that the failing path builds a node: a private identifier is
    ; consumed through create_identifier(true) from in there, and its token is
    ; not KindAwaitKeyword, so nothing would be set either way. The reference
    ; puts the restore after the call for the same reason it puts the save
    ; before it, and the two orders are only distinguishable through a shape
    ; that does not exist.
    procedure parse_binding_identifier(this) returns pointer[AstNode]
        this.parse_binding_identifier_with_diagnostic(0)

    procedure parse_binding_identifier_with_diagnostic(this, private_code: int) returns pointer[AstNode]
    {
        let saved_await_identifier statement_has_await_identifier
        let id this.create_identifier_with_diagnostic(this.is_binding_identifier(), 0, private_code)
        set statement_has_await_identifier: saved_await_identifier
        id
    }

    ; The reference's canParseSemicolon/tryParseSemicolon/parseSemicolon —
    ; automatic semicolon insertion.
    ;
    ; ★★★ parseSemicolon's RESULT is discarded at every one of the reference's
    ; fifteen call sites, and reading it is how slice 13c broke five corpus units
    ; before a single control was written: seventeen callers here said
    ; `if this.parse_semicolon() = false  return null`, which was right while the
    ; fallback stopped the port and became "answer no tree, report nothing" the
    ; moment it started reporting instead. The dumper prints that as
    ; `UNPORTED 0 no-tree 0` — an honest-looking report of a construct nobody
    ; built, for a defect in this port. **A guard that reads the result of
    ; something that has stopped failing is invisible in both directions.**
    ;
    ; The two halves are split apart since slice 4, because a caller needs the
    ; QUESTION on its own: a body-less overload signature is exactly
    ; "a function head that can_parse_semicolon()".
    function can_parse_semicolon(this) returns bool
    {
        if token = KindSemicolonToken
            return true
        if token = KindCloseBraceToken
            return true
        if token = KindEndOfFile
            return true
        this.has_preceding_line_break()
    }

    ; tryParseSemicolon. Split out of parse_semicolon with slice 6, because the
    ; property declaration needs the try WITHOUT the report: reaching the end of
    ; a property with no semicolon is one of four diagnostics there, and which
    ; one depends on what preceded it.
    procedure try_parse_semicolon(this) returns bool
    {
        if this.can_parse_semicolon() = false
            return false
        ; Consume it only if it was written; ASI inserts nothing.
        if token = KindSemicolonToken
            this.next_token()
        true
    }

    procedure parse_semicolon(this) returns bool
    {
        if this.try_parse_semicolon()
            return true
        this.parse_expected(KindSemicolonToken)
    }

    procedure parse_expression_or_labeled_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var jsdoc this.jsdoc_scanner_info()

        ; ★ The reference clears HasJSDoc again when the expression started with
        ; `(`, and the question has to be asked BEFORE the expression is parsed —
        ; by then the token is long gone. Slice 4's note here said the arm could
        ; not run because a parenthesized expression was unported; slice 5 makes
        ; it reachable, and it is one of the few places where a flag depends on
        ; how the expression STARTED rather than on what it turned out to be.
        let has_paren token = KindOpenParenToken

        let expression this.parse_expression()
        if expression = null
            return null

        ; ★ A labeled statement is recognised AFTER the fact — the reference's
        ; own comment says so: rather than looking ahead for `Identifier :`, it
        ; parses an expression and then asks whether it turned out to be a bare
        ; identifier followed by a colon. It joins this slice because `break
        ; outer` is the only reason a label exists, so porting the loops without
        ; it would leave the canonical shape unported.
        if AstNode.kind_of(expression) = KindIdentifier
        {
            if this.parse_optional(KindColonToken)
            {
                let statement this.parse_statement()
                if statement = null
                    return null
                let labeled this.finish_node(this.new_node(KindLabeledStatement, NodeData.LabeledStatement(LabeledStatementData(expression, statement))), pos)
                return this.with_jsdoc(labeled, jsdoc)
            }
        }

        ; parseErrorForMissingSemicolonAfter, not parse_semicolon, for the same
        ; reason as in `throw`: a bare identifier statement with no semicolon is
        ; almost always a keyword the parser did not recognise.
        if this.try_parse_semicolon() = false
            this.parse_error_for_missing_semicolon_after(expression)

        let result this.finish_node(this.new_node(KindExpressionStatement, NodeData.ExpressionStatement(ExpressionStatementData(expression))), pos)
        if has_paren
            set jsdoc: jsdoc & ~JsdocInfoHasJsdoc
        this.with_jsdoc(result, jsdoc)
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; EXPRESSIONS — parser slice 5
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; The reference's ladder, top to bottom:
    ;
    ;   parseExpression                     the comma operator
    ;   parseAssignmentExpressionOrHigher   yield, arrow functions, assignment
    ;   parseConditionalExpressionRest      ? :
    ;   parseBinaryExpressionOrHigher       precedence climbing, `as`/`satisfies`
    ;   parseUnaryExpressionOrHigher        + - ~ ! delete typeof void await <T>
    ;   parseUpdateExpression               ++ -- , prefix and postfix
    ;   parseLeftHandSideExpressionOrHigher calls, super, import
    ;   parseMemberExpressionOrHigher       . [] ! ?. <T>
    ;   parsePrimaryExpression              the leaves and the bracketed forms
    ;
    ; The slice was read off the unported histogram, where the two expression
    ; tags together were 40.1 % of first blockers against 17.8 % for the next
    ; one — and unlike slices 2, 3 and 4 there is no cheaper sub-slice inside
    ; it: `.`, `(`, `[`, `{` and `as` all end in parseMemberExpressionOrHigher
    ; or parseBinaryExpressionOrHigher, so the ladder is indivisible in a way
    ; the declaration router and the type surface were not.
    ;
    ; ── What is NOT ported, each because it is the head of another slice ────
    ;
    ;   (template expressions and tagged templates were this list's first
    ;    entry and landed with slice 11 — see the TEMPLATES banner)
    ;   (decorators / `@expr` were the last entry here to name a slice and
    ;    landed with slice 12 — parse_decorated_expression, which is the one
    ;    place a class EXPRESSION carries modifiers)
    ;   regular expression literals      they need ReScanSlashToken
    ;   class expressions                the class slice
    ;   private identifiers `#x`         they need a node and an intern table
    ;   (`import(…)` and `import.meta` were this list's longest-standing entry —
    ;    "both set SOURCE FILE flags this port does not model" — and landed with
    ;    slice 18, which is where the file's own flags arrived; see the arm in
    ;    parse_left_hand_side_expression_or_higher)
    ;   object literal methods and       they are parseMethodDeclaration and
    ;     accessors                      parseAccessorDeclaration, i.e. the class
    ;                                    member slice under another name
    ;   binding patterns `[a]` `{a}`     unchanged from slice 4, and now reached
    ;                                    from one more direction: `({x}) => …`
    ;
    ; ── Three faithfulness notes ────────────────────────────────────────────
    ;
    ; (1) More reference nodes carry a field the dump cannot see: the OPERATOR of
    ;     a PrefixUnaryExpression and a PostfixUnaryExpression, and the
    ;     `MultiLine` flag of an array or object literal. They are not stored, and
    ;     that is a gap rather than a saving — see ast.scaly.
    ;
    ;     ★★★ The keyword of a MetaProperty WAS on this list and is stored since
    ;     slice 18, and how it left is the transferable part (§3.5as): the reader
    ;     that made it observable was not the yardstick but the PORT — the
    ;     external-module indicator's `IsImportMeta` arm, which decides whether
    ;     the file is a module, which decides whether slice 15's reparse runs,
    ;     which changes the TREE. An invisible field two mechanisms from a visible
    ;     one. Read the rest of this list as fields waiting for such a reader.
    ;
    ; (2) `checkJSSyntax`, which the reference calls on most of these nodes,
    ;     returns immediately unless the node is in a JavaScript file. This port
    ;     never sets NodeFlagsJavaScriptFile, so it is work that provably does
    ;     nothing here rather than work that was skipped.
    ;
    ; (3) `typeHasArrowFunctionBlockingParseError` is PORTED since slice 13c. The
    ;     note here said it was constantly false because a missing node is only
    ;     ever produced after a diagnostic and a diagnostic was already unported
    ;     — a §3.5p claim, and this is the slice that expired it. It reads the
    ;     missing-LIST sentinel, which is why create_missing_list has one.

    procedure parse_expression(this) returns pointer[AstNode]
    {
        ; The decorator context is cleared for the whole expression: a decorator
        ; is unambiguous while it is being parsed, and its own `[` must not be
        ; read as an element access (see parse_member_expression_rest).
        let saved context_flags
        this.set_context_flags(NodeFlagsDecoratorContext, false)

        let pos this.node_pos()
        var expr this.parse_assignment_expression_or_higher()
        if expr = null
            return null

        while true
        {
            let operator_token this.parse_optional_token(KindCommaToken)
            if this.is_unported()
                return null
            if operator_token = null
                break
            let right this.parse_assignment_expression_or_higher()
            if right = null
                return null
            set expr: this.make_binary_expression(expr, operator_token, right, pos)
            if expr = null
                return null
        }

        set context_flags: saved
        expr
    }

    ; doInContext(DisallowIn, false, parseExpression) — the shape every
    ; parenthesized head and every `return` operand is parsed in, where a bare
    ; `in` is an ordinary relational operator again.
    procedure parse_expression_allow_in(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let result this.parse_expression()
        set context_flags: saved
        result
    }

    ; The same wrapper around ONE assignment expression: an object literal's
    ; initializer and a shorthand property's are parsed this way.
    procedure parse_assignment_expression_allow_in(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let result this.parse_assignment_expression_or_higher()
        set context_flags: saved
        result
    }

    procedure parse_assignment_expression_or_higher(this) returns pointer[AstNode]
        this.parse_assignment_expression_or_higher_worker(true)

    ; ★ `allow_return_type_in_arrow_function` threads through the whole ladder
    ; and looks like a flag that could be dropped. It cannot: it is what tells
    ; `x ? (a): b => c : d` apart from an arrow function with a return type, and
    ; the only place it is FALSE is the true-branch of a conditional expression.
    procedure parse_assignment_expression_or_higher_worker(this, allow_return_type: bool) returns pointer[AstNode]
    {
        if this.is_yield_expression()
            return this.parse_yield_expression()
        if this.is_unported()
            return null

        ; Productions 4 and 5 — an arrow function. It is neither a
        ; LeftHandSideExpression nor the start of a ConditionalExpression, so a
        ; successful parse ends the question here.
        let arrow this.try_parse_parenthesized_arrow_function_expression(allow_return_type)
        if this.is_unported()
            return null
        if arrow <> null
            return arrow

        let async_arrow this.try_parse_async_simple_arrow_function_expression(allow_return_type)
        if this.is_unported()
            return null
        if async_arrow <> null
            return async_arrow

        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let expr this.parse_binary_expression_or_higher(OperatorPrecedenceLowest)
        if expr = null
            return null

        ; `x => …`. The single un-parenthesized parameter is not looked ahead
        ; for; it is recognised AFTERWARDS, from an expression that turned out to
        ; be one identifier followed by an arrow.
        if AstNode.kind_of(expr) = KindIdentifier
        {
            if token = KindEqualsGreaterThanToken
                return this.parse_simple_arrow_function_expression(pos, expr, allow_return_type, jsdoc, null)
        }

        ; Productions 2 and 3 — assignment. The re-scan is what merges `>` `>`
        ; `=` into `>>=`; without it every shift-assignment would read as a
        ; comparison.
        var is_assignment false
        if is_left_hand_side_expression_kind(AstNode.kind_of(expr))
        {
            if is_assignment_operator(this.re_scan_greater_than_token())
                set is_assignment: true
        }
        if is_assignment
        {
            let operator_token this.parse_token_node()
            if operator_token = null
                return null
            let right this.parse_assignment_expression_or_higher_worker(allow_return_type)
            if right = null
                return null
            return this.make_binary_expression(expr, operator_token, right, pos)
        }

        this.parse_conditional_expression_rest(expr, pos, allow_return_type)
    }

    procedure make_binary_expression(this, left: pointer[AstNode], operator_token: pointer[AstNode], right: pointer[AstNode], pos: int) returns pointer[AstNode]
        this.finish_node(this.new_node(KindBinaryExpression, NodeData.BinaryExpression(BinaryExpressionData(null, left, null, operator_token, right))), pos)

    ; ── yield ───────────────────────────────────────────────────────────────

    procedure is_yield_expression(this) returns bool
    {
        if token <> KindYieldKeyword
            return false
        if this.in_yield_context()
            return true
        ; Outside a generator `yield` is an ordinary identifier — `yield(foo)` is
        ; a call. The reference's heuristic is that a name or a literal directly
        ; after it cannot be anything but a yield operand.
        this.look_ahead_next_token_is_identifier_or_keyword_or_literal_on_same_line()
    }

    procedure parse_yield_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()

        var takes_operand false
        if this.has_preceding_line_break() = false
        {
            if token = KindAsteriskToken
                set takes_operand: true
            if this.is_start_of_expression()
                set takes_operand: true
        }

        var asterisk_token null as pointer[AstNode]
        var expression null as pointer[AstNode]
        if takes_operand
        {
            set asterisk_token: this.parse_optional_token(KindAsteriskToken)
            if this.is_unported()
                return null
            set expression: this.parse_assignment_expression_or_higher()
            if expression = null
                return null
        }

        this.finish_node(this.new_node(KindYieldExpression, NodeData.YieldExpression(YieldExpressionData(asterisk_token, expression))), pos)
    }

    ; ── the conditional operator ────────────────────────────────────────────

    procedure parse_conditional_expression_rest(this, left_operand: pointer[AstNode], pos: int, allow_return_type: bool) returns pointer[AstNode]
    {
        let question_token this.parse_optional_token(KindQuestionToken)
        if this.is_unported()
            return null
        if question_token = null
            return left_operand

        ; `in` is allowed in the true branch and NOT re-allowed in the false one
        ; — the reference is explicit that this asymmetry is deliberate.
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let true_expression this.parse_assignment_expression_or_higher_worker(false)
        set context_flags: saved
        if true_expression = null
            return null

        ; The `:` may be MISSING, in which case parse_expected_token reports and
        ; synthesizes one — and then the false branch is a MISSING IDENTIFIER
        ; rather than a parsed expression. That distinction is what
        ; node_is_missing answers, and it is observable: parsing an expression
        ; there would report Expression_expected a SECOND time at the same place
        ; and stamp ThisNodeHasError on the branch the reference leaves clean.
        let colon_token this.parse_expected_token(KindColonToken)
        if colon_token = null
            return null

        var false_expression null as pointer[AstNode]
        if node_is_missing(colon_token) = false
            set false_expression: this.parse_assignment_expression_or_higher_worker(allow_return_type)
        else
            set false_expression: this.create_missing_identifier()
        if false_expression = null
            return null

        this.finish_node(this.new_node(KindConditionalExpression, NodeData.ConditionalExpression(ConditionalExpressionData(left_operand, question_token, true_expression, colon_token, false_expression))), pos)
    }

    ; ── binary operators ────────────────────────────────────────────────────

    procedure parse_binary_expression_or_higher(this, precedence: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let left_operand this.parse_unary_expression_or_higher()
        if left_operand = null
            return null
        this.parse_binary_expression_rest(precedence, left_operand, pos)
    }

    ; Precedence climbing, transcribed with the reference's own two rules: a
    ; left-associative operator is taken when its precedence is strictly HIGHER
    ; than the caller's, and `**` — the only right-associative one — when it is
    ; higher OR EQUAL.
    procedure parse_binary_expression_rest(this, precedence: int, start_operand: pointer[AstNode], pos: int) returns pointer[AstNode]
    {
        var left_operand start_operand
        var last_operand start_operand

        while true
        {
            let op this.re_scan_greater_than_token()
            let new_precedence get_binary_operator_precedence(op)

            var consume false
            if op = KindAsteriskAsteriskToken
                set consume: new_precedence >= precedence
            else
                set consume: new_precedence > precedence
            if consume = false
                break

            ; `for (a in b)` — inside the initializer, `in` is not an operator.
            if op = KindInKeyword
            {
                if this.in_disallow_in_context()
                    break
            }

            var is_type_operator false
            if op = KindAsKeyword
                set is_type_operator: true
            if op = KindSatisfiesKeyword
                set is_type_operator: true

            if is_type_operator
            {
                ; ASI: `var x = foo` / `as (Bar)` on the next line is an
                ; initialized variable followed by a CALL to something named
                ; `as`, not a type assertion.
                if this.has_preceding_line_break()
                    break
                this.next_token()

                ; `a ## b as T` may not swallow an operator binding tighter than
                ; `##`, because that would make the `as` impossible to erase
                ; without changing the meaning.
                var last_precedence OperatorPrecedenceHighest
                if AstNode.kind_of(last_operand) = KindBinaryExpression
                    set last_precedence: get_binary_operator_precedence(AstNode.binary_operator_kind(last_operand))

                let type_node this.parse_type()
                if type_node = null
                    return null

                var kind KindAsExpression
                if op = KindSatisfiesKeyword
                    set kind: KindSatisfiesExpression
                var n null as pointer[AstNode]
                if op = KindSatisfiesKeyword
                    set n: this.new_node(kind, NodeData.SatisfiesExpression(AsExpressionData(left_operand, type_node)))
                else
                    set n: this.new_node(kind, NodeData.AsExpression(AsExpressionData(left_operand, type_node)))
                set left_operand: this.finish_node(n, AstNode.pos_of(left_operand))
                if left_operand = null
                    return null
                ; makeAsExpression / makeSatisfiesExpression both wrap their
                ; finishNode in checkJSSyntax; the two are inlined here (see the
                ; kind selection above), so one call covers both.
                this.check_js_syntax(left_operand)

                if get_binary_operator_precedence(this.re_scan_greater_than_token()) > last_precedence
                    break
            }
            else
            {
                let operator_token this.parse_token_node()
                if operator_token = null
                    return null
                let right this.parse_binary_expression_or_higher(new_precedence)
                if right = null
                    return null
                set left_operand: this.make_binary_expression(left_operand, operator_token, right, pos)
                if left_operand = null
                    return null
                set last_operand: left_operand
            }
        }

        left_operand
    }

    ; ast.GetBinaryOperatorPrecedence. Every arm is the reference's; the answer
    ; for anything else is Invalid, which is what stops the climb.
    function get_binary_operator_precedence(k: int) returns int
    {
        if k = KindQuestionQuestionToken
            return OperatorPrecedenceCoalesce
        if k = KindBarBarToken
            return OperatorPrecedenceLogicalOR
        if k = KindAmpersandAmpersandToken
            return OperatorPrecedenceLogicalAND
        if k = KindBarToken
            return OperatorPrecedenceBitwiseOR
        if k = KindCaretToken
            return OperatorPrecedenceBitwiseXOR
        if k = KindAmpersandToken
            return OperatorPrecedenceBitwiseAND
        if k = KindEqualsEqualsToken
            return OperatorPrecedenceEquality
        if k = KindExclamationEqualsToken
            return OperatorPrecedenceEquality
        if k = KindEqualsEqualsEqualsToken
            return OperatorPrecedenceEquality
        if k = KindExclamationEqualsEqualsToken
            return OperatorPrecedenceEquality
        if k = KindLessThanToken
            return OperatorPrecedenceRelational
        if k = KindGreaterThanToken
            return OperatorPrecedenceRelational
        if k = KindLessThanEqualsToken
            return OperatorPrecedenceRelational
        if k = KindGreaterThanEqualsToken
            return OperatorPrecedenceRelational
        if k = KindInstanceOfKeyword
            return OperatorPrecedenceRelational
        if k = KindInKeyword
            return OperatorPrecedenceRelational
        if k = KindAsKeyword
            return OperatorPrecedenceRelational
        if k = KindSatisfiesKeyword
            return OperatorPrecedenceRelational
        if k = KindLessThanLessThanToken
            return OperatorPrecedenceShift
        if k = KindGreaterThanGreaterThanToken
            return OperatorPrecedenceShift
        if k = KindGreaterThanGreaterThanGreaterThanToken
            return OperatorPrecedenceShift
        if k = KindPlusToken
            return OperatorPrecedenceAdditive
        if k = KindMinusToken
            return OperatorPrecedenceAdditive
        if k = KindAsteriskToken
            return OperatorPrecedenceMultiplicative
        if k = KindSlashToken
            return OperatorPrecedenceMultiplicative
        if k = KindPercentToken
            return OperatorPrecedenceMultiplicative
        if k = KindAsteriskAsteriskToken
            return OperatorPrecedenceExponentiation
        OperatorPrecedenceInvalid
    }

    ; ast.IsAssignmentOperator. The sixteen assignment operators are one
    ; CONTIGUOUS run of the Kind table (63..78), which is why this is a range
    ; test and the reference's enumeration is not transcribed — the same
    ; property the keyword and binary-operator tests rest on.
    function is_assignment_operator(k: int) returns bool
        (k >= KindFirstAssignment) and (k <= KindLastAssignment)

    ; ast.isLeftHandSideExpressionKind.
    ;
    ; ★★★ THE THREE JSX KINDS WERE MISSING FOR THIRTEEN SLICES, on a reason that
    ; expired with slice 20 and that nobody's grep was aimed at: *the JSX kinds
    ; are in the reference's list and are left out here for the same reason the
    ; JSX parser is — neither side selects that language variant.* Both sides
    ; have selected it since slice 20 (§3.5p, paid in the direction it usually is:
    ; the slice that lifts a condition owns every claim resting on it, and this
    ; one was three slices late). It is a REAL parse difference, not a
    ; classification detail: `<div/> = x` in a .tsx unit takes the assignment
    ; production upstream and did not here, so the tree differed —
    ; fixtures/parser_jsx_assignment_lhs.tsx is 29 lines of ast diff without
    ; these three lines.
    ;
    ; ★ It was found from the OTHER end: slice 33's binder arms are the second
    ; and third caller this function has ever had (IsDestructuringAssignment and
    ; checkStrictModeBinaryExpression), and reading it before calling it is what
    ; turned up the sentence.
    function is_left_hand_side_expression_kind(k: int) returns bool
    {
        if k = KindPropertyAccessExpression
            return true
        if k = KindElementAccessExpression
            return true
        if k = KindNewExpression
            return true
        if k = KindCallExpression
            return true
        if k = KindJsxElement
            return true
        if k = KindJsxSelfClosingElement
            return true
        if k = KindJsxFragment
            return true
        if k = KindTaggedTemplateExpression
            return true
        if k = KindArrayLiteralExpression
            return true
        if k = KindParenthesizedExpression
            return true
        if k = KindObjectLiteralExpression
            return true
        if k = KindClassExpression
            return true
        if k = KindFunctionExpression
            return true
        if k = KindIdentifier
            return true
        if k = KindPrivateIdentifier
            return true
        if k = KindRegularExpressionLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindStringLiteral
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindTemplateExpression
            return true
        if k = KindFalseKeyword
            return true
        if k = KindNullKeyword
            return true
        if k = KindThisKeyword
            return true
        if k = KindTrueKeyword
            return true
        if k = KindSuperKeyword
            return true
        if k = KindNonNullExpression
            return true
        if k = KindExpressionWithTypeArguments
            return true
        if k = KindMetaProperty
            return true
        if k = KindImportKeyword
            return true
        k = KindMissingDeclaration
    }

    ; ── unary and update ────────────────────────────────────────────────────

    procedure parse_unary_expression_or_higher(this) returns pointer[AstNode]
    {
        if this.is_update_expression()
        {
            let pos this.node_pos()
            let update_expression this.parse_update_expression()
            if update_expression = null
                return null
            ; `a ** b` — the exponent binds to the UPDATE expression, so the
            ; climb is re-entered here rather than one level up.
            if token = KindAsteriskAsteriskToken
                return this.parse_binary_expression_rest(get_binary_operator_precedence(token), update_expression, pos)
            return update_expression
        }

        let simple this.parse_simple_unary_expression()
        if simple = null
            return null
        ; `-a ** b` is a grammar error, and the reference REPORTS it and then
        ; parses the expression anyway — so the tree is the same either way and
        ; only the diagnostic differs. Two messages, chosen by whether the
        ; left-hand side is a type assertion; the operator's spelling is the
        ; other one's argument and is not compared.
        if token = KindAsteriskAsteriskToken
        {
            let err_pos this.skip_range_trivia_pos(simple.pos)
            let err_end simple.end
            if simple.kind = KindTypeAssertionExpression
                this.parse_error_at(err_pos, err_end, DiagA_type_assertion_expression_is_not_allowed_in_the_left_hand_side_of_an_exponentiation_expression_Consider_enclosing_the_expression_in_parentheses)
            else
                this.parse_error_at(err_pos, err_end, DiagAn_unary_expression_with_the_0_operator_is_not_allowed_in_the_left_hand_side_of_an_exponentiation_expression_Consider_enclosing_the_expression_in_parentheses)
        }
        simple
    }

    function is_update_expression(this) returns bool
    {
        if token = KindPlusToken
            return false
        if token = KindMinusToken
            return false
        if token = KindTildeToken
            return false
        if token = KindExclamationToken
            return false
        if token = KindDeleteKeyword
            return false
        if token = KindTypeOfKeyword
            return false
        if token = KindVoidKeyword
            return false
        if token = KindAwaitKeyword
            return false
        ; `<` is an update expression only under the JSX variant, where it opens
        ; an element; without it the `<` opens a type assertion, which is a unary
        ; form. Slice 20 made this the variant question the reference asks —
        ; before it, the answer was hardcoded to the Standard variant's.
        if token = KindLessThanToken
            return language_variant_jsx
        true
    }

    procedure parse_update_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()

        var is_prefix false
        if token = KindPlusPlusToken
            set is_prefix: true
        if token = KindMinusMinusToken
            set is_prefix: true
        if is_prefix
        {
            ; The operator is the token we are ON — read before it is consumed,
            ; which is the reference's `p.token` argument to
            ; NewPrefixUnaryExpression. `op`, never `operator`: §3.5d.
            let op token
            this.next_token()
            let operand this.parse_left_hand_side_expression_or_higher()
            if operand = null
                return null
            return this.finish_node(this.new_node(KindPrefixUnaryExpression, NodeData.PrefixUnaryExpression(PrefixUnaryExpressionData(op, operand))), pos)
        }

        ; The reference's `else if` on the branch above: a JSX element is part of
        ; primaryExpression, so this is where `<div/>` enters the grammar. The
        ; lookahead is what keeps `a < b` a comparison — under the JSX variant a
        ; `<` followed by anything that is not a name or `>` is still an operator.
        if language_variant_jsx
        {
            if token = KindLessThanToken
            {
                if this.look_ahead_next_token_is_identifier_or_keyword_or_greater_than()
                    return this.parse_jsx_element_or_self_closing_element_or_fragment(true, 0 - 1, null, false)
            }
        }

        let expression this.parse_left_hand_side_expression_or_higher()
        if expression = null
            return null

        var is_postfix false
        if token = KindPlusPlusToken
            set is_postfix: true
        if token = KindMinusMinusToken
            set is_postfix: true
        if is_postfix
        {
            ; ASI: a `++` on the NEXT line belongs to the next statement.
            if this.has_preceding_line_break() = false
            {
                this.next_token()
                return this.finish_node(this.new_node(KindPostfixUnaryExpression, NodeData.PostfixUnaryExpression(WrappedTypeData(expression))), pos)
            }
        }

        expression
    }

    ; ── the JSX grammar ─────────────────────────────────────────────────────
    ;
    ; Slice 20. Sixteen parse routines and three scanner drivers, and the shape
    ; to hold on to is that LAST part: this grammar is the one place where the
    ; parser tokenizes. Every routine that finishes a tag ends by choosing
    ; between `next_token()` and `scan_jsx_text()` — the same source position,
    ; two different tokenizations — because whether what follows is document text
    ; or an expression is a question only the parser can answer. So the ordinary
    ; scan loop is bypassed here, and the token yardstick, which calls scan() in a
    ; loop, cannot see any of this. The parse yardstick is the only witness.

    procedure parse_jsx_element_or_self_closing_element_or_fragment(this, in_expression_context: bool, top_invalid_node_position: int, opening_tag: pointer[AstNode], must_be_unary: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let opening this.parse_jsx_opening_or_self_closing_element_or_opening_fragment(in_expression_context)
        if opening = null
            return null

        var result null as pointer[AstNode]

        if opening.kind = KindJsxOpeningElement
        {
            var children_end 0
            var children this.parse_jsx_children(opening, &children_end)
            var closing_element null as pointer[AstNode]

            ; core.LastOrNil.
            var last_child null as pointer[AstNode]
            if children <> null
            {
                let n children.get_length() as int
                if n > 0
                    set last_child: *(children.get_buffer() + (n - 1))
            }

            ; ★★★ THE RESTRUCTURING PATH: `<div>(...<span>...</div>)`. The inner
            ; `<span>` was never closed, so it consumed its PARENT's `</div>` as
            ; its own closing tag; parse_jsx_children stopped right there for
            ; exactly this reason. The repair hands the `</div>` back to the outer
            ; element and gives the inner one a zero-width MISSING closing tag at
            ; the end of its own children — so the tree is `(<div>(...<span>...</>)</div>)`
            ; and nothing is reported here, because the parent's own mismatch test
            ; will report it.
            var restructured false
            if last_child <> null
            {
                if last_child.kind = KindJsxElement
                {
                    let lc_open AstNode.jsx_element_opening_of(last_child)
                    let lc_close AstNode.jsx_element_closing_of(last_child)
                    if not AstNode.tag_names_are_equivalent(AstNode.jsx_tag_name_of(lc_open), AstNode.jsx_tag_name_of(lc_close))
                    {
                        if AstNode.tag_names_are_equivalent(AstNode.jsx_tag_name_of(opening), AstNode.jsx_tag_name_of(lc_close))
                            set restructured: true
                    }
                }
            }

            if restructured
            {
                ; The reference's `lastChild.Children().End()` — the extent of the
                ; INNER element's own child list, which is why JsxElementData
                ; carries it (see that record).
                let end AstNode.jsx_element_children_end_of(last_child)
                let missing_identifier this.finish_node_with_end(this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData(null, 0))), end, end)
                let new_closing_element this.finish_node_with_end(this.new_node(KindJsxClosingElement, NodeData.JsxClosingElement(WrappedTypeData(missing_identifier))), end, end)
                let lc_open AstNode.jsx_element_opening_of(last_child)
                let new_last this.finish_node_with_end(this.new_node(KindJsxElement, NodeData.JsxElement(JsxElementData(lc_open, AstNode.jsx_element_children_of(last_child), new_closing_element, end))), lc_open.pos, end)
                ; `append(children.Nodes[0:len-1], newLast)` — the same list with
                ; its last element replaced, which an Array does in place.
                children.put((children.get_length() - 1 as size_t), new_last)
                ; The reference REPLACES the list here, with a range whose end is
                ; `newLast.End()` — so the outer element's own children_end moves
                ; too. ★ It is UNOBSERVABLE, and the argument is short enough to
                ; keep: the only reader of children_end is this same restructure,
                ; on a LAST CHILD whose tags MISMATCH, and a restructured element
                ; always ends up with matching tags (its closing tag is the one the
                ; condition just proved equal to its opening tag). So a restructured
                ; element can never trigger its parent's restructure. Kept faithful
                ; rather than left to differ.
                set children_end: end
                set closing_element: AstNode.jsx_element_closing_of(last_child)
            }
            else
            {
                set closing_element: this.parse_jsx_closing_element(opening, in_expression_context)
                if closing_element = null
                    return null
                if not AstNode.tag_names_are_equivalent(AstNode.jsx_tag_name_of(opening), AstNode.jsx_tag_name_of(closing_element))
                {
                    ; Which of the two tags carries the report depends on whose
                    ; fault it is: if the CLOSING tag matches our PARENT's opening
                    ; tag, then it is our opening tag that is unclosed, so the
                    ; report goes there.
                    var blame_opening false
                    if opening_tag <> null
                    {
                        if opening_tag.kind = KindJsxOpeningElement
                        {
                            if AstNode.tag_names_are_equivalent(AstNode.jsx_tag_name_of(closing_element), AstNode.jsx_tag_name_of(opening_tag))
                                set blame_opening: true
                        }
                    }
                    ; The message takes the tag's TEXT as its argument; the code
                    ; and the span are what the yardstick compares, so the text is
                    ; not carried (the same reading create_identifier is under).
                    if blame_opening
                    {
                        let tn AstNode.jsx_tag_name_of(opening)
                        this.parse_error_at(tn.pos, tn.end, DiagJSX_element_0_has_no_corresponding_closing_tag)
                    }
                    else
                    {
                        let tn AstNode.jsx_tag_name_of(closing_element)
                        this.parse_error_at(tn.pos, tn.end, DiagExpected_corresponding_JSX_closing_tag_for_0)
                    }
                }
            }
            set result: this.finish_node(this.new_node(KindJsxElement, NodeData.JsxElement(JsxElementData(opening, children, closing_element, children_end))), pos)
        }
        else
        {
            if opening.kind = KindJsxOpeningFragment
            {
                var children_end 0
                let children this.parse_jsx_children(opening, &children_end)
                let closing this.parse_jsx_closing_fragment(in_expression_context)
                if closing = null
                    return null
                set result: this.finish_node(this.new_node(KindJsxFragment, NodeData.JsxFragment(JsxFragmentData(opening, children, closing))), pos)
            }
            else
            {
                ; KindJsxSelfClosingElement — nothing else to do.
                set result: opening
            }
        }
        if result = null
            return null

        ; ★★ `<div></div><div></div>` in an expression context. The second `<` is
        ; not an operator anything could use, so rather than leaving the rest as
        ; garbage the reference SPECULATIVELY parses another element and wraps the
        ; two in a synthetic comma BinaryExpression, whose only purpose is to keep
        ; the formatter and the error message sane. The operator token is
        ; zero-width, at the second element's own start.
        if must_be_unary
            return result
        if in_expression_context = false
            return result
        if token <> KindLessThanToken
            return result

        var top_bad_pos top_invalid_node_position
        if top_bad_pos < 0
            set top_bad_pos: result.pos
        let invalid_element this.parse_jsx_element_or_self_closing_element_or_fragment(true, top_bad_pos, null, false)
        if invalid_element = null
            return null
        ; ★★★ NOT finish_node_with_end. The reference builds this token with the
        ; FACTORY and assigns its Loc directly —
        ;
        ;     operatorToken := p.factory.NewToken(ast.KindCommaToken)
        ;     operatorToken.Loc = core.NewTextRange(invalidElement.Pos(), …)
        ;
        ; — so it never passes through finishNode and picks up neither the
        ; CONTEXT FLAGS nor ThisNodeHasError. In a `.jsx` unit ours therefore
        ; carried NodeFlagsJavaScriptFile (1<<16) where the reference's carries
        ; nothing: same kind, same zero-width span, one bit apart. §3.5bo.
        let operator_token this.new_node(KindCommaToken, NodeData.Token(TokenData()))
        set operator_token.pos: invalid_element.pos
        set operator_token.end: invalid_element.pos
        this.parse_error_at(this.skip_range_trivia_pos(top_bad_pos), invalid_element.end, DiagJSX_expressions_must_have_one_parent_element)
        ; ★ The reference's NewBinaryExpression takes FIVE arguments — modifiers
        ; and a typeNode besides — and this port's record has the three slots that
        ; ForEachChild visits, because the other two exist for the JSDoc reparser
        ; (§3.5n's rule applied to a node that HAS extra slots this port does not
        ; keep). Passing five here is what the very first draft did, and it is
        ; worth the line: rather than a diagnostic it fell through to the
        ; positional-tuple path and CRASHED the emitter (see §3.5ay).
        this.finish_node(this.new_node(KindBinaryExpression, NodeData.BinaryExpression(BinaryExpressionData(null, result, null, operator_token, invalid_element))), pos)
    }

    ; The reference's parseJsxChildren, and it is NOT a parse_list call: every
    ; child has to be preceded by a JSX RE-SCAN, because the token the ordinary
    ; scanner left behind is the wrong tokenization of this position. The context
    ; is still entered — see PCJsxChildren.
    ;
    ; `out_end` is the reference's NodeList TextRange end, handed back because a
    ; JsxElement stores it (§3.6's out-parameter answer for a multi-return, and
    ; the scalar direction, which is the safe one).
    procedure parse_jsx_children(this, opening_tag: pointer[AstNode], out_end: pointer[int]) returns pointer[Array[pointer[AstNode]]]
    {
        let saved_contexts parsing_contexts
        set parsing_contexts: parsing_contexts | (1 << PCJsxChildren)

        let list AstNode.new_node_list(host)
        repeat
        {
            let current_token this.re_scan_jsx_token(true)
            let child this.parse_jsx_child(opening_tag, current_token)
            if child = null
                break
            list.add(child)

            ; Stop after a MISMATCHED child, so the `</div>` it wrongly took can
            ; be reattached one level up — the restructuring path in the caller.
            if opening_tag.kind = KindJsxOpeningElement
            {
                if child.kind = KindJsxElement
                {
                    let c_open AstNode.jsx_element_opening_of(child)
                    let c_close AstNode.jsx_element_closing_of(child)
                    if not AstNode.tag_names_are_equivalent(AstNode.jsx_tag_name_of(c_open), AstNode.jsx_tag_name_of(c_close))
                    {
                        if AstNode.tag_names_are_equivalent(AstNode.jsx_tag_name_of(opening_tag), AstNode.jsx_tag_name_of(c_close))
                            break
                    }
                }
            }
        }

        set parsing_contexts: saved_contexts
        ; The reference's `newNodeList(NewTextRange(pos, p.nodePos()), list)`. Only
        ; the END is handed back: the list's POS has no reader here, while its end
        ; has exactly one (see JsxElementData.children_end).
        set *out_end: this.node_pos()
        list
    }

    procedure parse_jsx_child(this, opening_tag: pointer[AstNode], tok: int) returns pointer[AstNode]
    {
        if tok = KindEndOfFile
        {
            ; ★ The report goes at the TAG that lacks a closing element, not at
            ; the end of the file, which the reference calls useless — and for an
            ; element it covers only the tag NAME.
            if opening_tag.kind = KindJsxOpeningFragment
                this.parse_error_at(opening_tag.pos, opening_tag.end, DiagJSX_fragment_has_no_corresponding_closing_tag)
            else
            {
                let tag AstNode.jsx_tag_name_of(opening_tag)
                var start this.skip_range_trivia_pos(tag.pos)
                if tag.end < start
                    set start: tag.end
                this.parse_error_at(start, tag.end, DiagJSX_element_0_has_no_corresponding_closing_tag)
            }
            return null
        }
        if tok = KindLessThanSlashToken
            return null
        if tok = KindConflictMarkerTrivia
            return null
        if tok = KindJsxText
            return this.parse_jsx_text()
        if tok = KindJsxTextAllWhiteSpaces
            return this.parse_jsx_text()
        if tok = KindOpenBraceToken
            return this.parse_jsx_expression(false)
        if tok = KindLessThanToken
            return this.parse_jsx_element_or_self_closing_element_or_fragment(false, 0 - 1, opening_tag, false)
        ; The reference PANICS here, and a panic is not something to reproduce —
        ; the established answer in this port is an unported report, which
        ; invalidates the tree rather than letting a wrong one through. It is
        ; unreachable rather than lenient: re_scan_jsx_token can answer only
        ; EndOfFile, LessThanSlash, ConflictMarkerTrivia, JsxText,
        ; JsxTextAllWhiteSpaces, LessThan and OpenBrace, and all seven have an arm
        ; above.
        this.unported("jsx-child-token", tok)
    }

    procedure parse_jsx_text(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        ; ★ The node is built BEFORE the scan advances, because both of its
        ; inputs — the text and whether the token was the all-whitespace kind —
        ; belong to the token the parser is on. The kind stored is JsxText for
        ; BOTH tokens; see JsxTextData.
        let all_whitespace token = KindJsxTextAllWhiteSpaces
        let result this.new_node(KindJsxText, NodeData.JsxText(JsxTextData(all_whitespace)))
        this.scan_jsx_text()
        this.finish_node(result, pos)
    }

    procedure parse_jsx_expression(this, in_expression_context: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindOpenBraceToken) = false
            return null

        var dot_dot_dot_token null as pointer[AstNode]
        var expression null as pointer[AstNode]
        if token <> KindCloseBraceToken
        {
            ; `{...children}` is a spread only in CHILD position; in an attribute
            ; value the braces are just a delimiter.
            if in_expression_context = false
                set dot_dot_dot_token: this.parse_optional_token(KindDotDotDotToken)
            ; Only an AssignmentExpression is valid per the JSX spec; the
            ; reference reads a comma sequence anyway so the grammar checker can
            ; give a better message.
            set expression: this.parse_expression()
            if expression = null
                return null
        }

        ; ★★ The two exits differ in TOKENIZATION, not in what they accept: in an
        ; expression context the `}` is consumed by the ordinary scanner, and in a
        ; child context it must be followed by JSX text.
        if in_expression_context
            this.parse_expected(KindCloseBraceToken)
        else
        {
            if this.parse_expected_without_advancing(KindCloseBraceToken)
                this.scan_jsx_text()
        }
        this.finish_node(this.new_node(KindJsxExpression, NodeData.JsxExpression(JsxExpressionData(dot_dot_dot_token, expression))), pos)
    }

    ; ── the three scanner drivers ───────────────────────────────────────────
    ;
    ; Each is the reference's own one-line wrapper: ask the scanner for a
    ; DIFFERENT tokenization of the position it is already at, and keep the
    ; answer in p.token.

    procedure scan_jsx_text(this) returns int
    {
        set token: scanner.scan_jsx_token()
        token
    }

    procedure scan_jsx_identifier(this) returns int
    {
        set token: scanner.scan_jsx_identifier()
        token
    }

    procedure scan_jsx_attribute_value(this) returns int
    {
        set token: scanner.scan_jsx_attribute_value()
        token
    }

    procedure re_scan_jsx_token(this, allow_multiline: bool) returns int
    {
        set token: scanner.re_scan_jsx_token(allow_multiline)
        token
    }

    procedure parse_jsx_closing_element(this, open: pointer[AstNode], in_expression_context: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindLessThanSlashToken)
        let tag_name this.parse_jsx_element_name()
        if tag_name = null
            return null
        if this.parse_expected_with_diagnostic(KindGreaterThanToken, 0, false)
        {
            ; ★ The scanner is advanced BY HAND, and which way depends on whether
            ; more JSX follows: a closing tag that matches its own opening tag and
            ; is not at the top of an expression is inside another element, so what
            ; comes next is that element's text.
            var as_text false
            if in_expression_context = false
            {
                if AstNode.tag_names_are_equivalent(AstNode.jsx_tag_name_of(open), tag_name)
                    set as_text: true
            }
            if as_text
                this.scan_jsx_text()
            else
                this.next_token()
        }
        this.finish_node(this.new_node(KindJsxClosingElement, NodeData.JsxClosingElement(WrappedTypeData(tag_name))), pos)
    }

    procedure parse_jsx_opening_or_self_closing_element_or_opening_fragment(this, in_expression_context: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindLessThanToken)

        if token = KindGreaterThanToken
        {
            ; `<>` — the opening fragment. The scan_jsx_text is the same decision
            ; the closing `>` of a tag makes below.
            this.scan_jsx_text()
            return this.finish_node(this.new_node(KindJsxOpeningFragment, NodeData.Token(TokenData())), pos)
        }

        let tag_name this.parse_jsx_element_name()
        if tag_name = null
            return null

        ; ★ Type arguments on a tag (`<Foo<T> …>`) are TypeScript only: in a
        ; JavaScript file the `<` after the name is not read as a type argument
        ; list at all. This is asked of the CONTEXT flag rather than of the script
        ; kind, which is the reference's own spelling.
        var type_arguments null as pointer[Array[pointer[AstNode]]]
        if (context_flags & NodeFlagsJavaScriptFile) = 0
            set type_arguments: this.parse_type_arguments()

        let attributes this.parse_jsx_attributes()
        if attributes = null
            return null

        if token = KindGreaterThanToken
        {
            ; The tag closes, so what follows is document text — scanned as JSX so
            ; that a character like `#` is content and not a scan error.
            this.scan_jsx_text()
            return this.finish_node(this.new_node(KindJsxOpeningElement, NodeData.JsxOpeningElement(JsxOpeningElementData(tag_name, type_arguments, attributes))), pos)
        }

        this.parse_expected(KindSlashToken)
        if this.parse_expected_without_advancing(KindGreaterThanToken)
        {
            if in_expression_context
                this.next_token()
            else
                this.scan_jsx_text()
        }
        this.finish_node(this.new_node(KindJsxSelfClosingElement, NodeData.JsxSelfClosingElement(JsxOpeningElementData(tag_name, type_arguments, attributes))), pos)
    }

    ; A tag name is `a`, `a.b.c`, `this` or `a:b` — deliberately NOT
    ; parse_left_hand_side_expression_or_higher, which would read `class` and
    ; `function` as keywords.
    procedure parse_jsx_element_name(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let initial_expression this.parse_jsx_tag_name()
        if initial_expression = null
            return null
        ; `a:b.c` is invalid syntax: once a NAMESPACED name is read the dot is not
        ; even looked for, so that parse_jsx_attribute reports the `:` instead.
        if initial_expression.kind = KindJsxNamespacedName
            return initial_expression

        var expression initial_expression
        while this.parse_optional(KindDotToken)
        {
            ; ★ FALSE for the unicode-escape parameter, and this is the only
            ; caller in the whole reference that passes it — see
            ; parse_right_side_of_dot.
            let right this.parse_right_side_of_dot(true, false, false)
            if right = null
                return null
            set expression: this.finish_node(this.new_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(expression, null, right))), pos)
        }
        expression
    }

    procedure parse_jsx_tag_name(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.scan_jsx_identifier()
        ; Read BEFORE the identifier is consumed: `<this>` is a keyword
        ; expression, not an identifier named `this`.
        let is_this token = KindThisKeyword
        let tag_name this.parse_identifier_name_error_on_unicode_escape_sequence()
        if tag_name = null
            return null
        if this.parse_optional(KindColonToken)
        {
            this.scan_jsx_identifier()
            let second this.parse_identifier_name_error_on_unicode_escape_sequence()
            if second = null
                return null
            return this.finish_node(this.new_node(KindJsxNamespacedName, NodeData.JsxNamespacedName(JsxNamespacedNameData(tag_name, second))), pos)
        }
        if is_this
            return this.finish_node(this.new_node(KindThisKeyword, NodeData.Token(TokenData())), pos)
        tag_name
    }

    procedure parse_jsx_attributes(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let list this.parse_list(PCJsxAttributes)
        if list = null
            return null
        this.finish_node(this.new_node(KindJsxAttributes, NodeData.JsxAttributes(ElementListData(list))), pos)
    }

    procedure parse_jsx_attribute(this) returns pointer[AstNode]
    {
        if token = KindOpenBraceToken
            return this.parse_jsx_spread_attribute()
        let pos this.node_pos()
        let name this.parse_jsx_attribute_name()
        if name = null
            return null
        let value this.parse_jsx_attribute_value()
        this.finish_node(this.new_node(KindJsxAttribute, NodeData.JsxAttribute(JsxAttributeData(name, value))), pos)
    }

    procedure parse_jsx_spread_attribute(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindOpenBraceToken)
        this.parse_expected(KindDotDotDotToken)
        let expression this.parse_expression()
        if expression = null
            return null
        this.parse_expected(KindCloseBraceToken)
        this.finish_node(this.new_node(KindJsxSpreadAttribute, NodeData.JsxSpreadAttribute(WrappedTypeData(expression))), pos)
    }

    procedure parse_jsx_attribute_name(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.scan_jsx_identifier()
        let attr_name this.parse_identifier_name_error_on_unicode_escape_sequence()
        if attr_name = null
            return null
        if this.parse_optional(KindColonToken)
        {
            this.scan_jsx_identifier()
            let second this.parse_identifier_name_error_on_unicode_escape_sequence()
            if second = null
                return null
            return this.finish_node(this.new_node(KindJsxNamespacedName, NodeData.JsxNamespacedName(JsxNamespacedNameData(attr_name, second))), pos)
        }
        attr_name
    }

    ; Answers NULL for a valueless attribute (`<a disabled/>`), which is a real
    ; null in the reference too and is what the Initializer slot being Optional
    ; means.
    procedure parse_jsx_attribute_value(this) returns pointer[AstNode]
    {
        if token <> KindEqualsToken
            return null
        ; ★ The scanner is asked for the value's tokenization, and a STRING is the
        ; one it answers itself — as a JSX attribute string, where a backslash is
        ; ordinary and a newline does not terminate.
        if this.scan_jsx_attribute_value() = KindStringLiteral
            return this.parse_literal_expression(KindStringLiteral)
        if token = KindOpenBraceToken
            return this.parse_jsx_expression(true)
        if token = KindLessThanToken
            return this.parse_jsx_element_or_self_closing_element_or_fragment(true, 0 - 1, null, false)
        this.parse_error_at_current_token(DiagX_or_JSX_element_expected)
        null
    }

    procedure parse_jsx_closing_fragment(this, in_expression_context: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindLessThanSlashToken)
        if this.parse_expected_with_diagnostic(KindGreaterThanToken, DiagExpected_corresponding_closing_tag_for_JSX_fragment, false)
        {
            if in_expression_context
                this.next_token()
            else
                this.scan_jsx_text()
        }
        this.finish_node(this.new_node(KindJsxClosingFragment, NodeData.Token(TokenData())), pos)
    }

    ; ── the look-aheads this slice adds ─────────────────────────────────────

    procedure look_ahead_next_token_is_slash(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_slash()
        this.rewind(saved)
        r
    }

    procedure next_token_is_slash(this) returns bool
    {
        this.next_token()
        token = KindSlashToken
    }

    procedure look_ahead_next_token_is_identifier_or_keyword_or_greater_than(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_identifier_or_keyword_or_greater_than()
        this.rewind(saved)
        r
    }

    procedure next_token_is_identifier_or_keyword_or_greater_than(this) returns bool
    {
        this.next_token()
        if token = KindGreaterThanToken
            return true
        token_is_identifier_or_keyword(token)
    }

    ; The JSX override of the arrow-function tristate. Under the JSX variant a
    ; `<` after which a type parameter list could stand is almost always an
    ; element, so the reference demands one of three much narrower shapes:
    ; `<T extends …>` (but not `<T extends =`, `>` or `/`, which are element
    ; syntax), `<T,` or `<T =`.
    procedure look_ahead_is_arrow_function_in_jsx(this) returns bool
    {
        let saved this.mark()
        let r this.is_arrow_function_in_jsx()
        this.rewind(saved)
        r
    }

    procedure is_arrow_function_in_jsx(this) returns bool
    {
        this.parse_optional(KindConstKeyword)
        let third this.next_token()
        if third = KindExtendsKeyword
        {
            let fourth this.next_token()
            if fourth = KindEqualsToken
                return false
            if fourth = KindGreaterThanToken
                return false
            if fourth = KindSlashToken
                return false
            return true
        }
        if third = KindCommaToken
            return true
        third = KindEqualsToken
    }

    procedure parse_simple_unary_expression(this) returns pointer[AstNode]
    {
        if token = KindPlusToken
            return this.parse_prefix_unary_expression()
        if token = KindMinusToken
            return this.parse_prefix_unary_expression()
        if token = KindTildeToken
            return this.parse_prefix_unary_expression()
        if token = KindExclamationToken
            return this.parse_prefix_unary_expression()

        if token = KindDeleteKeyword
            return this.parse_keyword_unary_expression(KindDeleteExpression)
        if token = KindTypeOfKeyword
            return this.parse_keyword_unary_expression(KindTypeOfExpression)
        if token = KindVoidKeyword
            return this.parse_keyword_unary_expression(KindVoidExpression)

        ; ★ Just as in parse_update_expression, a `<` under the JSX variant is an
        ; element and never a type assertion — the reference's comment names the
        ; shape it protects, `+ <foo> bar`. `must_be_unary` is TRUE here and only
        ; here: the recovery at the end of the jsx routine builds a BINARY
        ; expression, which is not a valid UnaryExpression and would break the
        ; caller, so this call forbids it.
        if token = KindLessThanToken
        {
            if language_variant_jsx
                return this.parse_jsx_element_or_self_closing_element_or_fragment(true, 0 - 1, null, true)
            return this.parse_type_assertion()
        }

        if token = KindAwaitKeyword
        {
            if this.is_await_expression()
                return this.parse_keyword_unary_expression(KindAwaitExpression)
        }

        this.parse_update_expression()
    }

    procedure parse_prefix_unary_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let op token
        this.next_token()
        let operand this.parse_simple_unary_expression()
        if operand = null
            return null
        this.finish_node(this.new_node(KindPrefixUnaryExpression, NodeData.PrefixUnaryExpression(PrefixUnaryExpressionData(op, operand))), pos)
    }

    ; parseDeleteExpression / parseTypeOfExpression / parseVoidExpression /
    ; parseAwaitExpression are four copies of one body in the reference, and the
    ; only thing that differs is the node kind. Kept as one function with the
    ; kind as an argument, which is the same grouping WrappedTypeData makes on
    ; the ast side.
    procedure parse_keyword_unary_expression(this, kind: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        let operand this.parse_simple_unary_expression()
        if operand = null
            return null
        var n null as pointer[AstNode]
        if kind = KindDeleteExpression
            set n: this.new_node(kind, NodeData.DeleteExpression(WrappedTypeData(operand)))
        if kind = KindTypeOfExpression
            set n: this.new_node(kind, NodeData.TypeOfExpression(WrappedTypeData(operand)))
        if kind = KindVoidExpression
            set n: this.new_node(kind, NodeData.VoidExpression(WrappedTypeData(operand)))
        if kind = KindAwaitExpression
            set n: this.new_node(kind, NodeData.AwaitExpression(WrappedTypeData(operand)))
        this.finish_node(n, pos)
    }

    procedure is_await_expression(this) returns bool
    {
        if token <> KindAwaitKeyword
            return false
        if this.in_await_context()
            return true
        ; The same heuristic as `yield`: outside an async function `await` is an
        ; ordinary name, and only a name or a literal right after it settles the
        ; question.
        this.look_ahead_next_token_is_identifier_or_keyword_or_literal_on_same_line()
    }

    ; `<T>x`. The TYPE comes first here — the opposite of `x as T` — which is
    ; why the two do not share a record on the ast side.
    ; ★ The reference opens this with a debug.Assert that the language variant is
    ; NOT JSX — "type assertions should never be parsed in JSX; they should be
    ; parsed as comparisons or JSX elements/fragments". It is not ported for the
    ; reason no other assert in this file is: an assertion is a claim about the
    ; two callers, and both of them now ask the variant question before they get
    ; here (parse_simple_unary_expression and, through is_update_expression,
    ; parse_unary_expression_or_higher).
    procedure parse_type_assertion(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindLessThanToken)
        let type_node this.parse_type()
        if type_node = null
            return null
        this.parse_expected(KindGreaterThanToken)
        let expression this.parse_simple_unary_expression()
        if expression = null
            return null
        this.finish_node(this.new_node(KindTypeAssertionExpression, NodeData.TypeAssertionExpression(TypeAssertionData(type_node, expression))), pos)
    }

    ; ── the left-hand side ──────────────────────────────────────────────────

    procedure parse_left_hand_side_expression_or_higher(this) returns pointer[AstNode]
    {
        let pos this.node_pos()

        var expression null as pointer[AstNode]
        if token = KindImportKeyword
        {
            ; ★ The look-ahead is what keeps `import * as x from "m"` a
            ; STATEMENT: the keyword is only an expression when a `(` or a `<`
            ; follows it, and the reference's comment names exactly that hazard.
            if this.look_ahead_next_token_is_open_paren_or_less_than()
            {
                set source_flags: source_flags | NodeFlagsPossiblyContainsDynamicImport
                ; The node is the KEYWORD alone — parse_call_expression_rest below
                ; reads the `(…)` and builds the CallExpression over it, which is
                ; why `import("m")` is a call whose callee is an ImportKeyword
                ; node rather than a node kind of its own.
                set expression: this.parse_token_node()
            }
            else
            {
                if this.look_ahead_next_token_is_dot()
                {
                    ; `import.<name>` — a MetaProperty. Both tokens are consumed
                    ; here rather than through parse_expected, exactly as the
                    ; reference does it: whatever follows the dot is read as an
                    ; identifier NAME, so `import.anything` parses and the
                    ; checker is the one that refuses a name that is not `meta`.
                    this.next_token()
                    this.next_token()
                    let meta_name this.parse_identifier_name()
                    if meta_name = null
                        return null
                    let mp this.finish_node(this.new_node(KindMetaProperty, NodeData.MetaProperty(MetaPropertyData(KindImportKeyword, meta_name))), pos)
                    if mp = null
                        return null
                    set expression: mp

                    ; ★★★ `import.defer(…)` is a dynamic import, not an
                    ; `import.meta`, and the two flags are different bits — so
                    ; the WORD decides, and only when a call or a type-argument
                    ; list follows it. Everything else marks the file as
                    ; possibly containing `import.meta`, INCLUDING a misspelled
                    ; `import.metal`: the flag only gates the walk that then
                    ; asks the precise question (is_import_meta), so a false
                    ; positive here costs a walk and never an answer.
                    ;
                    ; ★ The reference asks `expression.Text() == "defer"`, i.e.
                    ; the DECODED name — not the token kind. `defer` is a
                    ; contextual keyword and the import DECLARATION reads it as
                    ; one (see the IMPORTS banner's TEXT question), but here the
                    ; name went through parse_identifier_name, which accepts any
                    ; keyword as a name, so the kind was already spent. The
                    ; stored text from slice 17 is what answers it.
                    if meta_property_name_is_defer(meta_name)
                    {
                        if token = KindOpenParenToken
                            set source_flags: source_flags | NodeFlagsPossiblyContainsDynamicImport
                        else
                        {
                            if token = KindLessThanToken
                                set source_flags: source_flags | NodeFlagsPossiblyContainsDynamicImport
                        }
                    }
                    else
                        set source_flags: source_flags | NodeFlagsPossiblyContainsImportMeta
                }
                else
                    set expression: this.parse_member_expression_or_higher()
            }
        }
        else
        {
            if token = KindSuperKeyword
                set expression: this.parse_super_expression()
            else
                set expression: this.parse_member_expression_or_higher()
        }
        if expression = null
            return null

        this.parse_call_expression_rest(pos, expression)
    }

    ; The reference's `expression.Text() == "defer"`, where `expression` is the
    ; finished MetaProperty and `Node.Text()` on one of those is
    ; `Name().Text()` — so this asks the name, which is the same question one
    ; hop earlier. Kept as its own function because the shape recurs
    ; (is_import_meta asks the same pair) and because a bare `choose` inline
    ; would put two nested chooses in the middle of the arm.
    function meta_property_name_is_defer(name: pointer[AstNode]) returns bool
    {
        if name = null
            return false
        choose name.data
            when id: Identifier
                return text_matches(id.text, id.text_len, "defer")
        false
    }

    procedure parse_super_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let expression this.parse_token_node()
        if expression = null
            return null

        ; `super<T>()` — the type arguments are PARSED and then refused, and the
        ; node is wrapped in an ExpressionWithTypeArguments unless a template
        ; follows. Slice 12 stopped here and over-reported on a `super < x`
        ; comparison, which the speculative parse answers null for; that is no
        ; longer necessary.
        var expr expression
        if token = KindLessThanToken
        {
            let start_pos this.node_pos()
            let type_arguments this.try_parse_type_arguments_in_expression()
            if this.is_unported()
                return null
            if type_arguments <> null
            {
                this.parse_error_at(start_pos, this.node_pos(), DiagX_super_may_not_use_type_arguments)
                if this.is_template_start_of_tagged_template() = false
                {
                    set expr: this.finish_node(this.new_node(KindExpressionWithTypeArguments, NodeData.ExpressionWithTypeArguments(ExpressionWithTypeArgumentsData(expr, type_arguments))), pos)
                    if expr = null
                        return null
                }
            }
        }

        if token = KindOpenParenToken
            return expr
        if token = KindDotToken
            return expr
        if token = KindOpenBracketToken
            return expr

        ; Anything else: report, then parse a `.`'s right-hand side anyway so the
        ; recovery has a member access to hang the rest of the chain on. A
        ; private name will never work with `super`, but that is the checker's
        ; complaint, not this one's.
        this.parse_error_at_current_token(DiagX_super_must_be_followed_by_an_argument_list_or_member_access)
        let name this.parse_right_side_of_dot(true, true, true)
        if name = null
            return null
        this.finish_node(this.new_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(expr, null, name))), pos)
    }

    procedure parse_member_expression_or_higher(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let expression this.parse_primary_expression()
        if expression = null
            return null
        this.parse_member_expression_rest(pos, expression, true)
    }

    procedure parse_member_expression_rest(this, pos: int, start_expression: pointer[AstNode], allow_optional_chain: bool) returns pointer[AstNode]
    {
        var expression start_expression

        while true
        {
            var question_dot_token null as pointer[AstNode]
            var is_property_access false
            var took_chain false

            if allow_optional_chain
            {
                if this.is_start_of_optional_property_or_element_access_chain()
                {
                    set took_chain: true
                    set question_dot_token: this.parse_expected_token(KindQuestionDotToken)
                    if question_dot_token = null
                        return null
                    set is_property_access: token_is_identifier_or_keyword(token)
                }
            }
            if took_chain = false
                set is_property_access: this.parse_optional(KindDotToken)
            if this.is_unported()
                return null

            if is_property_access
            {
                set expression: this.parse_property_access_expression_rest(pos, expression, question_dot_token)
                if expression = null
                    return null
                continue
            }

            ; In a decorator context a `[` opens a computed property name, not an
            ; element access — unless a `?.` said otherwise.
            var allow_element false
            if question_dot_token <> null
                set allow_element: true
            else
            {
                if this.in_decorator_context() = false
                    set allow_element: true
            }
            if allow_element
            {
                if this.parse_optional(KindOpenBracketToken)
                {
                    set expression: this.parse_element_access_expression_rest(pos, expression, question_dot_token)
                    if expression = null
                        return null
                    continue
                }
            }

            if this.is_template_start_of_tagged_template()
            {
                ; ★ `` f<T>`x` `` arrived here as an ExpressionWithTypeArguments,
                ; and the tagged template absorbs it back into ONE node — the
                ; same fold parse_call_expression_rest does for `f<T>(x)`, which
                ; is why the type arguments are read off the node rather than
                ; re-parsed. A `?.` blocks the fold: `` f?.<T>`x` `` keeps its
                ; own question-dot token and the arguments were never wrapped.
                var tag expression
                var tag_type_arguments null as pointer[Array[pointer[AstNode]]]
                if question_dot_token = null
                {
                    if AstNode.kind_of(expression) = KindExpressionWithTypeArguments
                    {
                        set tag_type_arguments: AstNode.type_arguments_of(expression)
                        set tag: AstNode.child_at(expression, 0)
                        if tag = null
                            return null
                    }
                }
                set expression: this.parse_tagged_template_rest(pos, tag, question_dot_token, tag_type_arguments)
                if expression = null
                    return null
                continue
            }

            if question_dot_token = null
            {
                if token = KindExclamationToken
                {
                    if this.has_preceding_line_break() = false
                    {
                        this.next_token()
                        set expression: this.check_js_syntax(this.finish_node(this.new_node(KindNonNullExpression, NodeData.NonNullExpression(WrappedTypeData(expression))), pos))
                        if expression = null
                            return null
                        continue
                    }
                }

                let type_arguments this.try_parse_type_arguments_in_expression()
                if this.is_unported()
                    return null
                if type_arguments <> null
                {
                    set expression: this.finish_node(this.new_node(KindExpressionWithTypeArguments, NodeData.ExpressionWithTypeArguments(ExpressionWithTypeArgumentsData(expression, type_arguments))), pos)
                    if expression = null
                        return null
                    continue
                }
            }

            return expression
        }

        expression
    }

    procedure is_start_of_optional_property_or_element_access_chain(this) returns bool
    {
        if token <> KindQuestionDotToken
            return false
        this.look_ahead_next_token_is_identifier_or_keyword_or_open_bracket_or_template()
    }

    procedure parse_property_access_expression_rest(this, pos: int, expression: pointer[AstNode], question_dot_token: pointer[AstNode]) returns pointer[AstNode]
    {
        let name this.parse_right_side_of_dot(true, true, true)
        if name = null
            return null

        var is_optional_chain false
        if question_dot_token <> null
            set is_optional_chain: true
        else
            set is_optional_chain: this.try_reparse_optional_chain(expression)

        ; `a?.#x` — an optional chain may not contain a private name. Reported,
        ; and the node is built anyway, so only the diagnostic differs. The span
        ; is the NAME's, trivia skipped.
        if is_optional_chain
        {
            if name.kind = KindPrivateIdentifier
                this.parse_error_at_range(this.skip_range_trivia_pos(name.pos), name.end, DiagAn_optional_chain_cannot_contain_private_identifiers)
        }

        ; `f<T>.x` — an instantiation expression cannot be followed by a property
        ; access. ★ The span is the TYPE ARGUMENT LIST's, widened by one on each
        ; side so it covers the angle brackets — the reference builds it as
        ; [list.Pos()-1, skipTrivia(list.End())+1). Our node lists carry no range
        ; of their own (tests/oracle/ast.go names that as one of the things the
        ; dump cannot see), so the two brackets are derived from the ELEMENTS:
        ; the `<` sits before the first element's text and the `>` after the
        ; last element's end.
        if expression.kind = KindExpressionWithTypeArguments
        {
            let ta AstNode.type_arguments_of(expression)
            if ta <> null
            {
                let n_args ta.get_length() as int
                if n_args > 0
                {
                    let first *(ta.get_buffer() + 0)
                    let last *(ta.get_buffer() + (n_args - 1))
                    this.parse_error_at_range(first.pos - 1, this.skip_range_trivia_pos(last.end) + 1, DiagAn_instantiation_expression_cannot_be_followed_by_a_property_access)
                }
            }
        }

        let n this.new_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(expression, question_dot_token, name)))
        if is_optional_chain
            set n.flags: n.flags | NodeFlagsOptionalChain
        this.finish_node(n, pos)
    }

    procedure parse_element_access_expression_rest(this, pos: int, expression: pointer[AstNode], question_dot_token: pointer[AstNode]) returns pointer[AstNode]
    {
        ; `a[]` — an element access needs an argument, so the reference reports
        ; and puts a zero-width identifier in the slot.
        var argument_expression null as pointer[AstNode]
        if token = KindCloseBracketToken
        {
            let zero this.node_pos()
            this.parse_error_at(zero, zero, DiagAn_element_access_expression_should_take_an_argument)
            set argument_expression: this.create_missing_identifier()
        }
        else
            set argument_expression: this.parse_expression_allow_in()
        if argument_expression = null
            return null
        this.parse_expected(KindCloseBracketToken)

        var is_optional_chain false
        if question_dot_token <> null
            set is_optional_chain: true
        else
            set is_optional_chain: this.try_reparse_optional_chain(expression)

        let n this.new_node(KindElementAccessExpression, NodeData.ElementAccessExpression(ElementAccessData(expression, question_dot_token, argument_expression)))
        if is_optional_chain
            set n.flags: n.flags | NodeFlagsOptionalChain
        this.finish_node(n, pos)
    }

    ; ★ An optional chain survives a `!`: in `a?.b!.c` the non-null expression
    ; sits BETWEEN the two links, and the flag has to be pushed down through it
    ; so that `.c` knows it is still in the chain. That is what this walk does,
    ; and it MUTATES nodes that were already finished — the one place in the
    ; parser where a node's flags change after finish_node.
    procedure try_reparse_optional_chain(this, start_node: pointer[AstNode]) returns bool
    {
        if (start_node.flags & NodeFlagsOptionalChain) <> 0
            return true
        if AstNode.kind_of(start_node) <> KindNonNullExpression
            return false

        var expr AstNode.child_at(start_node, 0)
        while true
        {
            if expr = null
                return false
            if AstNode.kind_of(expr) <> KindNonNullExpression
                break
            if (expr.flags & NodeFlagsOptionalChain) <> 0
                break
            set expr: AstNode.child_at(expr, 0)
        }
        if expr = null
            return false
        if (expr.flags & NodeFlagsOptionalChain) = 0
            return false

        var n start_node
        while AstNode.kind_of(n) = KindNonNullExpression
        {
            set n.flags: n.flags | NodeFlagsOptionalChain
            set n: AstNode.child_at(n, 0)
            if n = null
                break
        }
        true
    }

    procedure parse_call_expression_rest(this, pos: int, start_expression: pointer[AstNode]) returns pointer[AstNode]
    {
        var expression start_expression

        while true
        {
            set expression: this.parse_member_expression_rest(pos, expression, true)
            if expression = null
                return null

            var type_arguments null as pointer[Array[pointer[AstNode]]]
            let question_dot_token this.parse_optional_token(KindQuestionDotToken)
            if this.is_unported()
                return null
            if question_dot_token <> null
            {
                set type_arguments: this.try_parse_type_arguments_in_expression()
                if this.is_unported()
                    return null
                ; `` f?.<T>`x` ``. No absorption here — the question-dot path
                ; never wrapped anything — so the arguments go straight in.
                if this.is_template_start_of_tagged_template()
                {
                    set expression: this.parse_tagged_template_rest(pos, expression, question_dot_token, type_arguments)
                    if expression = null
                        return null
                    continue
                }
            }

            var is_call false
            if type_arguments <> null
                set is_call: true
            if token = KindOpenParenToken
                set is_call: true

            if is_call
            {
                ; `f<T>(x)` came through parse_member_expression_rest as an
                ; ExpressionWithTypeArguments; the call absorbs it back into one
                ; CallExpression, which is why the type arguments are read off
                ; the node rather than re-parsed.
                if question_dot_token = null
                {
                    if AstNode.kind_of(expression) = KindExpressionWithTypeArguments
                    {
                        set type_arguments: AstNode.type_arguments_of(expression)
                        set expression: AstNode.child_at(expression, 0)
                        if expression = null
                            return null
                    }
                }

                let argument_list this.parse_argument_list()
                if argument_list = null
                    return null

                var is_optional_chain false
                if question_dot_token <> null
                    set is_optional_chain: true
                else
                    set is_optional_chain: this.try_reparse_optional_chain(expression)

                let n this.new_node(KindCallExpression, NodeData.CallExpression(CallExpressionData(expression, question_dot_token, type_arguments, argument_list)))
                if is_optional_chain
                    set n.flags: n.flags | NodeFlagsOptionalChain
                set expression: this.check_js_syntax(this.finish_node(n, pos))
                if expression = null
                    return null
                continue
            }

            ; A `?.` that led nowhere: report "Identifier expected" and build a
            ; property access onto a missing name, so the chain still has a
            ; shape. Then the loop ends either way.
            if question_dot_token <> null
            {
                this.parse_error_at_current_token(DiagIdentifier_expected)
                let missing_name this.create_missing_identifier()
                if missing_name = null
                    return null
                let n this.new_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(expression, question_dot_token, missing_name)))
                set n.flags: n.flags | NodeFlagsOptionalChain
                set expression: this.finish_node(n, pos)
                if expression = null
                    return null
            }

            break
        }

        expression
    }

    procedure parse_argument_list(this) returns pointer[Array[pointer[AstNode]]]
    {
        this.parse_expected(KindOpenParenToken)
        let list this.parse_delimited_list(PCArgumentExpressions)
        if list = null
            return null
        this.parse_expected(KindCloseParenToken)
        list
    }

    ; doInContext(DisallowIn|DecoratorContext, false, …) — an argument is parsed
    ; with `in` allowed and outside any decorator.
    procedure parse_argument_expression(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext | NodeFlagsDecoratorContext, false)
        let result this.parse_argument_or_array_literal_element()
        set context_flags: saved
        result
    }

    procedure parse_argument_or_array_literal_element(this) returns pointer[AstNode]
    {
        if token = KindDotDotDotToken
            return this.parse_spread_element()
        ; An ELISION — `[, 1]` — is a zero-width OmittedExpression sitting where
        ; the missing element would have been. It has no fields and no children,
        ; so it is a Token whose kind says what it is.
        if token = KindCommaToken
            return this.finish_node(this.new_node(KindOmittedExpression, NodeData.Token(TokenData())), this.node_pos())
        this.parse_assignment_expression_or_higher()
    }

    procedure parse_spread_element(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindDotDotDotToken)
        let expression this.parse_assignment_expression_or_higher()
        if expression = null
            return null
        this.finish_node(this.new_node(KindSpreadElement, NodeData.SpreadElement(WrappedTypeData(expression))), pos)
    }

    function is_template_start_of_tagged_template(this) returns bool
    {
        if token = KindNoSubstitutionTemplateLiteral
            return true
        token = KindTemplateHead
    }

    ; ── type arguments in an expression ─────────────────────────────────────
    ;
    ; ★★★ This is the function that forced the unported record to be rewindable.
    ; `a << b` reaches it — `<<` passes the precondition — and it then
    ; parses `<b>` as a type-parameter list, fails to find a comma, and throws
    ; the whole thing away. In the reference the diagnostics go with it; here the
    ; unported record has to, or a shift operator would be unparsable.
    ;
    ; The reference also refuses to run in a JavaScript file, where `<` is
    ; unambiguously a comparison. This port never sets NodeFlagsJavaScriptFile,
    ; so that half of the precondition is constantly false and is left out.
    procedure try_parse_type_arguments_in_expression(this) returns pointer[Array[pointer[AstNode]]]
    {
        ; ★★★ "TypeArguments must not be parsed in JavaScript files to avoid
        ; ambiguity with binary operators." — the reference's own first line, and
        ; it is not an optimisation: in a `.js`/`.jsx` file `Foo<number>()` is
        ; two RELATIONAL comparisons and a parenthesized expression, which is
        ; what JavaScript means by those characters. Without the test the file's
        ; grammar quietly became TypeScript's for this one production. The flag
        ; is the CONTEXT flag rather than is_java_script(), because a `.json`
        ; unit carries it too and its grammar has no type arguments either.
        if (context_flags & NodeFlagsJavaScriptFile) <> 0
            return null

        var eligible false
        if token = KindLessThanToken
            set eligible: true
        if token = KindLessThanLessThanToken
            set eligible: true
        if eligible = false
            return null

        let saved this.mark()
        var result null as pointer[Array[pointer[AstNode]]]

        if this.re_scan_less_than_token() = KindLessThanToken
        {
            this.next_token()
            let type_arguments this.parse_delimited_list(PCTypeArguments)
            if type_arguments <> null
            {
                ; Without the closing `>` it was never a type argument list.
                if this.re_scan_greater_than_token() = KindGreaterThanToken
                {
                    this.next_token()
                    ; `f<number>(42)` is a call; `a < b > c` is two comparisons.
                    ; What follows decides, and only that.
                    if this.can_follow_type_arguments_in_expression()
                        set result: type_arguments
                }
            }
        }

        if result <> null
            return result
        this.rewind(saved)
        null
    }

    procedure can_follow_type_arguments_in_expression(this) returns bool
    {
        if token = KindOpenParenToken
            return true
        if token = KindNoSubstitutionTemplateLiteral
            return true
        if token = KindTemplateHead
            return true
        ; A list followed by `<` never makes sense; followed by `>` it is
        ; ambiguous with a re-scanned `>>`; and here `+` and `-` are unary.
        if token = KindLessThanToken
            return false
        if token = KindGreaterThanToken
            return false
        if token = KindPlusToken
            return false
        if token = KindMinusToken
            return false
        if this.has_preceding_line_break()
            return true
        if this.is_binary_operator()
            return true
        this.is_start_of_expression() = false
    }

    function is_binary_operator(this) returns bool
    {
        if this.in_disallow_in_context()
        {
            if token = KindInKeyword
                return false
        }
        get_binary_operator_precedence(token) <> OperatorPrecedenceInvalid
    }

    ; ── primary expressions ─────────────────────────────────────────────────

    procedure parse_primary_expression(this) returns pointer[AstNode]
    {
        if token = KindNoSubstitutionTemplateLiteral
        {
            ; The reference re-scans an INVALID template here so the escape
            ; errors are reported: the scan loop passes
            ; shouldEmitInvalidEscapeError = false, so nothing was said the
            ; first time and this pass is where it gets said.
            ;
            ; ★★★ IT IS REACHED AND IT IS WHAT PRODUCES THE DIAGNOSTIC — the
            ; note that stood here called it UNREACHABLE, on the argument that a
            ; token carrying ContainsInvalidEscape had already been reported as
            ; `scan-error` one token earlier. That mechanism went away with slice
            ; 13c (next_token_without_check's own comment says so), and the claim
            ; outlived it: measured, `` `\01` `` answers TS1487 at 9..12 from
            ; HERE and from nowhere else, and the fixtures
            ; parser_template_untagged_escape / _head_escape are what see it.
            ; ★★ A claim of unreachability expires with the mechanism it rests on
            ; (§3.5bn), and this one outlived its by eleven slices.
            if (scanner.token_flags() & TokenFlagsIsInvalid) <> 0
            {
                this.re_scan_template_token(false)
                if this.is_unported()
                    return null
            }
            return this.parse_literal_expression(KindNoSubstitutionTemplateLiteral)
        }
        if token = KindNumericLiteral
            return this.parse_literal_expression(KindNumericLiteral)
        if token = KindBigIntLiteral
            return this.parse_literal_expression(KindBigIntLiteral)
        if token = KindStringLiteral
            return this.parse_literal_expression(KindStringLiteral)

        if token = KindThisKeyword
            return this.parse_token_node()
        if token = KindSuperKeyword
            return this.parse_token_node()
        if token = KindNullKeyword
            return this.parse_token_node()
        if token = KindTrueKeyword
            return this.parse_token_node()
        if token = KindFalseKeyword
            return this.parse_token_node()

        if token = KindOpenParenToken
            return this.parse_parenthesized_expression()
        if token = KindOpenBracketToken
            return this.parse_array_literal_expression()
        if token = KindOpenBraceToken
            return this.parse_object_literal_expression()

        ; An ASYNC ARROW function was already handled above; what is left is
        ; `async function`, and a bare `async` that is an ordinary name. The
        ; reference falls THROUGH to the identifier case for the second, which is
        ; why this arm cannot be an unconditional return.
        if token = KindAsyncKeyword
        {
            if this.look_ahead_next_token_is_function_keyword_on_same_line()
                return this.parse_function_expression()
        }

        if token = KindAtToken
            return this.parse_decorated_expression()
        if token = KindClassKeyword
            return this.parse_class_expression()
        if token = KindFunctionKeyword
            return this.parse_function_expression()
        if token = KindNewKeyword
            return this.parse_new_expression_or_new_dot_target()

        ; A `/` here opens a regular expression — slice 16. The re-scan is what
        ; turns the division sign into a literal; see the scanner for why the
        ; token stream alone cannot decide it.
        ;
        ; ★ The reference writes this arm as a conditional and falls THROUGH to
        ; its "Expression expected" diagnostic when the re-scan answers something
        ; else, so the port keeps the same shape — but the else is not reachable
        ; from here and saying so is worth more than a faithful-looking guard:
        ; ReScanSlashToken converts whenever the current token is one of these
        ; two, and this arm is entered only then. What the shape buys is that a
        ; later caller with a weaker precondition inherits the right structure.
        if (token = KindSlashToken) or (token = KindSlashEqualsToken)
        {
            if this.re_scan_slash_token() = KindRegularExpressionLiteral
                return this.parse_literal_expression(KindRegularExpressionLiteral)
        }

        if token = KindTemplateHead
            return this.parse_template_expression(false)
        ; `#field in obj` — the only expression position a private name may
        ; appear in, and the reference does not check that here: it builds the
        ; node and lets the checker refuse every other use.
        if token = KindPrivateIdentifier
            return this.parse_private_identifier()

        if this.is_identifier()
            return this.parse_identifier()

        ; The fallback: "Expression expected", and a missing identifier so the
        ; slot the caller is filling has something in it.
        this.parse_identifier_with_diagnostic(DiagExpression_expected, 0)
    }

    procedure parse_parenthesized_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        this.parse_expected(KindOpenParenToken)
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        this.parse_expected(KindCloseParenToken)
        let result this.finish_node(this.new_node(KindParenthesizedExpression, NodeData.ParenthesizedExpression(WrappedTypeData(expression))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_array_literal_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindOpenBracketToken)
        let elements this.parse_delimited_list(PCArrayLiteralMembers)
        if elements = null
            return null
        this.parse_expected(KindCloseBracketToken)
        this.finish_node(this.new_node(KindArrayLiteralExpression, NodeData.ArrayLiteralExpression(ElementListData(elements))), pos)
    }

    procedure parse_object_literal_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindOpenBraceToken)
        let properties this.parse_delimited_list(PCObjectLiteralMembers)
        if properties = null
            return null
        this.parse_expected(KindCloseBraceToken)
        this.finish_node(this.new_node(KindObjectLiteralExpression, NodeData.ObjectLiteralExpression(ElementListData(properties))), pos)
    }

    procedure parse_object_literal_element(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()

        if this.parse_optional(KindDotDotDotToken)
        {
            let spread this.parse_assignment_expression_or_higher()
            if spread = null
                return null
            let spread_result this.finish_node(this.new_node(KindSpreadAssignment, NodeData.SpreadAssignment(WrappedTypeData(spread))), pos)
            return this.with_jsdoc(spread_result, jsdoc)
        }

        let modifiers this.parse_modifiers(true, false, false)
        if this.is_unported()
            return null

        ; `get x() {}` / `set x(v) {}` are parseAccessorDeclaration — the same
        ; entry point a class member uses, reached from the object literal.
        if this.parse_contextual_modifier(KindGetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindGetAccessor, ParseFlagsNone)
        if this.parse_contextual_modifier(KindSetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindSetAccessor, ParseFlagsNone)

        let asterisk_token this.parse_optional_token(KindAsteriskToken)
        if this.is_unported()
            return null

        ; ★ Asked BEFORE the name is parsed, and it decides shorthand-ness. A
        ; keyword property name (`{ default: 1 }`) is a name and NOT an
        ; identifier, so it can never be shorthand — which is exactly what this
        ; captures and what re-asking afterwards would lose.
        let token_is_identifier this.is_identifier()

        let name this.parse_property_name()
        if name = null
            return null

        var postfix_token this.parse_optional_token(KindQuestionToken)
        if postfix_token = null
            set postfix_token: this.parse_optional_token(KindExclamationToken)
        if this.is_unported()
            return null

        var is_method false
        if asterisk_token <> null
            set is_method: true
        if token = KindOpenParenToken
            set is_method: true
        if token = KindLessThanToken
            set is_method: true
        if is_method
            return this.parse_method_declaration(pos, jsdoc, modifiers, asterisk_token, name, postfix_token, 0)

        var is_shorthand false
        if token_is_identifier
        {
            if token <> KindColonToken
                set is_shorthand: true
        }

        if is_shorthand
        {
            ; `{ a = 1 }` — the CoverInitializedName production, which is only
            ; legal as a destructuring pattern and is reported by the checker,
            ; not here.
            let equals_token this.parse_optional_token(KindEqualsToken)
            if this.is_unported()
                return null
            var object_assignment_initializer null as pointer[AstNode]
            if equals_token <> null
            {
                set object_assignment_initializer: this.parse_assignment_expression_allow_in()
                if object_assignment_initializer = null
                    return null
            }
            let short_result this.finish_node(this.new_node(KindShorthandPropertyAssignment, NodeData.ShorthandPropertyAssignment(ShorthandPropertyAssignmentData(modifiers, name, postfix_token, null, equals_token, object_assignment_initializer))), pos)
            return this.with_jsdoc(short_result, jsdoc)
        }

        this.parse_expected(KindColonToken)
        let initializer this.parse_assignment_expression_allow_in()
        if initializer = null
            return null
        let result this.finish_node(this.new_node(KindPropertyAssignment, NodeData.PropertyAssignment(PropertyAssignmentData(modifiers, name, postfix_token, null, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_property_name(this) returns pointer[AstNode]
    {
        let saved_await_identifier statement_has_await_identifier
        let prop this.parse_property_name_worker(true)
        set statement_has_await_identifier: saved_await_identifier
        prop
    }

    procedure parse_property_name_worker(this, allow_computed_property_names: bool) returns pointer[AstNode]
    {
        if token = KindStringLiteral
            return this.parse_literal_expression(KindStringLiteral)
        if token = KindNumericLiteral
            return this.parse_literal_expression(KindNumericLiteral)
        if token = KindBigIntLiteral
            return this.parse_literal_expression(KindBigIntLiteral)
        if allow_computed_property_names
        {
            if token = KindOpenBracketToken
                return this.parse_computed_property_name()
        }
        if token = KindPrivateIdentifier
            return this.parse_private_identifier()
        this.parse_identifier_name()
    }

    procedure parse_computed_property_name(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindOpenBracketToken)
        ; A full expression, comma operator included — the grammar allows only an
        ; assignment expression and the grammar CHECKER reports the difference.
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        this.parse_expected(KindCloseBracketToken)
        this.finish_node(this.new_node(KindComputedPropertyName, NodeData.ComputedPropertyName(WrappedTypeData(expression))), pos)
    }

    procedure parse_contextual_modifier(this, k: int) returns bool
    {
        let saved this.mark()
        if token = k
        {
            if this.next_token_can_follow_modifier()
                return true
        }
        this.rewind(saved)
        false
    }

    ; ── the function expression ─────────────────────────────────────────────

    procedure parse_function_expression(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDecoratorContext, false)

        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers(false, false, false)
        if this.is_unported()
            return null
        this.parse_expected(KindFunctionKeyword)

        let asterisk_token this.parse_optional_token(KindAsteriskToken)
        if this.is_unported()
            return null

        var signature_flags ParseFlagsNone
        if asterisk_token <> null
            set signature_flags: signature_flags | ParseFlagsYield
        let is_async has_modifier(modifiers, KindAsyncKeyword)
        if is_async
            set signature_flags: signature_flags | ParseFlagsAwait

        ; ★ The NAME is parsed inside the yield/await context the signature
        ; declares — not outside it, as the parameters' context is. That is why
        ; `function* yield() {}` is an error while `function yield() {}` is not,
        ; and it is a separate save/restore from the one around the whole
        ; function.
        let name_saved context_flags
        if asterisk_token <> null
            this.set_context_flags(NodeFlagsYieldContext, true)
        if is_async
            this.set_context_flags(NodeFlagsAwaitContext, true)
        var name null as pointer[AstNode]
        if this.is_binding_identifier()
        {
            set name: this.parse_binding_identifier()
            if name = null
                return null
        }
        set context_flags: name_saved

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(signature_flags)
        if parameters = null
            return null

        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        ; A function EXPRESSION always has a body — there is no overload form —
        ; so this is parse_function_block, not parse_function_block_or_semicolon.
        let body this.parse_function_block(signature_flags)
        set context_flags: saved
        if body = null
            return null

        let result this.finish_node(this.new_node(KindFunctionExpression, NodeData.FunctionExpression(FunctionExpressionData(modifiers, asterisk_token, name, type_parameters, parameters, return_type, null, body))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; ── new ─────────────────────────────────────────────────────────────────

    procedure parse_new_expression_or_new_dot_target(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindNewKeyword)

        ; `new.target`. ★ The keyword token IS stored since slice 18 — it is what
        ; tells this node from `import.meta`, and the external-module indicator
        ; asks exactly that (is_import_meta). Before it, the two were the same
        ; node with the same children and only their SOURCE told them apart,
        ; which is a distinction the yardstick cannot see either.
        if this.parse_optional(KindDotToken)
        {
            let meta_name this.parse_identifier_name()
            if meta_name = null
                return null
            return this.finish_node(this.new_node(KindMetaProperty, NodeData.MetaProperty(MetaPropertyData(KindNewKeyword, meta_name))), pos)
        }

        ; ★ allowOptionalChain is FALSE here: `new a?.b()` is invalid, and the
        ; reference reports it below rather than parsing a chain.
        let expression_pos this.node_pos()
        let primary this.parse_primary_expression()
        if primary = null
            return null
        var expression this.parse_member_expression_rest(expression_pos, primary, false)
        if expression = null
            return null

        var type_arguments null as pointer[Array[pointer[AstNode]]]
        if AstNode.kind_of(expression) = KindExpressionWithTypeArguments
        {
            set type_arguments: AstNode.type_arguments_of(expression)
            set expression: AstNode.child_at(expression, 0)
            if expression = null
                return null
        }

        ; `new a?.b()` is invalid; the message quotes the expression's text,
        ; which is not compared.
        if token = KindQuestionDotToken
            this.parse_error_at_current_token(DiagInvalid_optional_chain_from_new_expression_Did_you_mean_to_call_0)

        var argument_list null as pointer[Array[pointer[AstNode]]]
        if token = KindOpenParenToken
        {
            set argument_list: this.parse_argument_list()
            if argument_list = null
                return null
        }

        this.check_js_syntax(this.finish_node(this.new_node(KindNewExpression, NodeData.NewExpression(NewExpressionData(expression, type_arguments, argument_list))), pos))
    }

    ; ── arrow functions ─────────────────────────────────────────────────────
    ;
    ; ★★★ The most expensive shape in the ladder, and the reason is that a
    ; parameter LIST and a parenthesized EXPRESSION are the same text until the
    ; `=>` arrives: `(x = 10)`, `(x, y)` and `a ? (b): c` all read as signatures.
    ; The reference answers with a TRISTATE and speculates on the UNKNOWN half —
    ; and a speculation that is thrown away takes its diagnostics with it, which
    ; is what the rewound unported record models (see ParserState).
    ;
    ; ★ One consequence for this port specifically: `({x}) => …` and `([x]) => …`
    ; are UNKNOWN, so the speculative parse runs, and it walks straight into a
    ; binding pattern — unported. `({ x: 1 })` therefore reports unported even
    ; though the parenthesized object literal it turns out to be is perfectly
    ; parsable here. That over-reports, which is the direction to err in, and it
    ; closes with the binding-pattern slice.

    procedure try_parse_parenthesized_arrow_function_expression(this, allow_return_type: bool) returns pointer[AstNode]
    {
        let tristate this.is_parenthesized_arrow_function_expression()
        if this.is_unported()
            return null
        if tristate = TristateFalse
            return null

        ; Definitely an arrow: parse it without requiring a following `=>`, so
        ; that the diagnostics land where the user's error is.
        if tristate = TristateTrue
            return this.parse_parenthesized_arrow_function_expression(true, true)

        let saved this.mark()
        let result this.parse_possible_parenthesized_arrow_function_expression(allow_return_type)
        if result = null
            this.rewind(saved)
        result
    }

    procedure is_parenthesized_arrow_function_expression(this) returns int
    {
        var probe false
        if token = KindOpenParenToken
            set probe: true
        if token = KindLessThanToken
            set probe: true
        if token = KindAsyncKeyword
            set probe: true
        if probe
        {
            let saved this.mark()
            let r this.next_is_parenthesized_arrow_function_expression()
            this.rewind(saved)
            return r
        }
        ; A standalone `=>` is the reference's error-recovery tweak: it is what
        ; the user most likely meant to write.
        if token = KindEqualsGreaterThanToken
            return TristateTrue
        TristateFalse
    }

    procedure next_is_parenthesized_arrow_function_expression(this) returns int
    {
        if token = KindAsyncKeyword
        {
            this.next_token()
            if this.has_preceding_line_break()
                return TristateFalse
            var opens false
            if token = KindOpenParenToken
                set opens: true
            if token = KindLessThanToken
                set opens: true
            if opens = false
                return TristateFalse
        }

        let first token
        let second this.next_token()

        if first = KindOpenParenToken
        {
            if second = KindCloseParenToken
            {
                ; "() =>", "(): " and "() {". The last is not an arrow function,
                ; but it is probably what was meant.
                let third this.next_token()
                if third = KindEqualsGreaterThanToken
                    return TristateTrue
                if third = KindColonToken
                    return TristateTrue
                if third = KindOpenBraceToken
                    return TristateTrue
                return TristateFalse
            }

            ; "([" and "({" may start a binding pattern — or an expression.
            if second = KindOpenBracketToken
                return TristateUnknown
            if second = KindOpenBraceToken
                return TristateUnknown

            ; "(..." is a rest parameter and nothing else.
            if second = KindDotDotDotToken
                return TristateTrue

            ; "(xxx yyy" with xxx a modifier is not legal, and is treated as a
            ; lambda so the error message can say so.
            var modifier_start false
            if is_modifier_kind(second)
            {
                if second <> KindAsyncKeyword
                {
                    if this.look_ahead_next_token_is_identifier()
                        set modifier_start: true
                }
            }
            if modifier_start
            {
                if this.next_token() = KindAsKeyword
                    return TristateFalse
                return TristateTrue
            }

            ; `(this` is not a valid parameter name and is parsed as one anyway,
            ; so that the error is semantic rather than syntactic.
            var name_start this.is_identifier()
            if name_start = false
            {
                if second = KindThisKeyword
                    set name_start: true
            }
            if name_start = false
                return TristateFalse

            let third this.next_token()
            if third = KindColonToken
                return TristateTrue
            if third = KindQuestionToken
            {
                this.next_token()
                if token = KindColonToken
                    return TristateTrue
                if token = KindCommaToken
                    return TristateTrue
                if token = KindEqualsToken
                    return TristateTrue
                if token = KindCloseParenToken
                    return TristateTrue
                return TristateFalse
            }
            if third = KindCommaToken
                return TristateUnknown
            if third = KindEqualsToken
                return TristateUnknown
            if third = KindCloseParenToken
                return TristateUnknown
            return TristateFalse
        }

        ; `first` is `<`, a generic arrow function's type parameter list.
        var generic_start this.is_identifier()
        if generic_start = false
        {
            if token = KindConstKeyword
                set generic_start: true
        }
        if generic_start = false
            return TristateFalse

        ; ★★★ The JSX override, ported in slice 20. Under the JSX variant a `<`
        ; followed by a name is an ELEMENT far more often than a type parameter
        ; list, so the answer is not Unknown-and-try-both — it is decided here, and
        ; the shapes that decide it for the arrow function are narrow:
        ; `<T extends …>` (but not with `=`, `>` or `/` after `extends`, all three
        ; of which are element syntax), `<T,` and `<T =`. Anything else is FALSE,
        ; not Unknown — under this variant the speculative parse must not run,
        ; because the `<` belongs to the element grammar.
        if language_variant_jsx
        {
            if this.look_ahead_is_arrow_function_in_jsx()
                return TristateTrue
            return TristateFalse
        }
        TristateUnknown
    }

    procedure parse_possible_parenthesized_arrow_function_expression(this, allow_return_type: bool) returns pointer[AstNode]
    {
        let token_pos scanner.token_start()
        if this.not_parenthesized_arrow_has(token_pos)
            return null
        let result this.parse_parenthesized_arrow_function_expression(false, allow_return_type)
        if result = null
            this.not_parenthesized_arrow_add(token_pos)
        result
    }

    function not_parenthesized_arrow_has(this, pos: int) returns bool
    {
        if not_parenthesized_arrow = null
            return false
        let a not_parenthesized_arrow
        let len a.get_length() as int
        var i 0
        while i < len
        {
            if *(a.get_buffer() + i) = pos
                return true
            set i: i + 1
        }
        false
    }

    procedure not_parenthesized_arrow_add(this, pos: int)
    {
        if not_parenthesized_arrow = null
        {
            let fresh host.allocate(sizeof Array[int], alignof Array[int]) as pointer[Array[int]]
            set *fresh: Array[int]()
            set not_parenthesized_arrow: fresh
        }
        let a not_parenthesized_arrow
        a.add(pos)
    }

    ; ast.NodeIsMissing — a node the parser synthesized rather than read. Zero
    ; width is the test, and the two guards matter: a negative position is not a
    ; real range, and the end-of-file token is legitimately zero width.
    function node_is_missing(n: pointer[AstNode]) returns bool
    {
        if n = null
            return true
        if n.pos <> n.end
            return false
        if n.pos < 0
            return false
        n.kind <> KindEndOfFile
    }

    ; typeHasArrowFunctionBlockingParseError. Asked of a speculative arrow
    ; function's RETURN TYPE: if the type itself only parsed by way of a
    ; synthesized node, the signature proves nothing and the speculation must not
    ; commit. `a ? (b): (function() {})` is the shape it exists for — a JSDoc
    ; function type, which this port does not have.
    ;
    ; ★ Measured, and the pair is the honest report: making it always answer TRUE
    ; is RED 3, so the CALL SITE is live and three cases reach it; never
    ; consulting it at all is UNGATED, so on this corpus it is never true. The
    ; constructor-type route that could make it true here (`new => c`, whose
    ; parameter list is missing) is masked one line later by the `=>`/`{` test,
    ; which refuses the speculation for a different reason. §3.5v's second row,
    ; owned by the JSDoc slice; fixtures/parser_arrow_missing_param_list.ts
    ; carries the coverage and says the same thing.
    function type_has_arrow_function_blocking_parse_error(this, node: pointer[AstNode]) returns bool
    {
        if node = null
            return false
        choose node.data
            when tr: TypeReference
                return node_is_missing(tr.type_name)
            when ft: FunctionType
            {
                if this.is_missing_node_list(ft.parameters)
                    return true
                return this.type_has_arrow_function_blocking_parse_error(ft.type_node)
            }
            when ct: ConstructorType
            {
                if this.is_missing_node_list(ct.parameters)
                    return true
                return this.type_has_arrow_function_blocking_parse_error(ct.type_node)
            }
            when pt: ParenthesizedType
                return this.type_has_arrow_function_blocking_parse_error(pt.inner)
        false
    }

    procedure parse_parenthesized_arrow_function_expression(this, allow_ambiguity: bool, allow_return_type: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers_for_arrow_function()
        if this.is_unported()
            return null
        var is_async false
        if modifiers <> null
            set is_async: true
        var signature_flags ParseFlagsNone
        if is_async
            set signature_flags: ParseFlagsAwait

        ; An arrow function is never a generator, so there is no yield flag.
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null

        ; ★ A missing `(` splits by allowAmbiguity: on the speculative side it
        ; means "not an arrow" and the caller rewinds (which discards the
        ; diagnostic parse_expected just wrote — §3.5i); on the committed side
        ; the arrow is built over a MISSING parameter list, which is not the same
        ; as an empty one. See create_missing_list.
        var parameters null as pointer[Array[pointer[AstNode]]]
        if this.parse_expected(KindOpenParenToken) = false
        {
            if allow_ambiguity = false
                return null
            set parameters: this.create_missing_list()
        }
        else
        {
            set parameters: this.parse_parameters_worker(signature_flags, allow_ambiguity)
            if parameters = null
                return null
            if this.parse_expected(KindCloseParenToken) = false
            {
                if allow_ambiguity = false
                    return null
            }
        }

        ; Asked BEFORE the return type is parsed — by then the `:` is consumed.
        let has_return_colon token = KindColonToken
        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
            ; ★★ A return type that is ITSELF half-parsed must not commit the
            ; speculation — `a ? (b): (function() {})` is the shape, where the
            ; return type parses as a parenthesized function type whose own
            ; parameter list is missing. Reachable only now that a missing list
            ; is a thing this port can build.
            if allow_ambiguity = false
            {
                if this.type_has_arrow_function_blocking_parse_error(return_type)
                    return null
            }
        }

        ; Parsing a signature is not enough: "(x = 10)", "(x,y)" and "a ? (b): c"
        ; are all valid signatures and none of them is an arrow function. One
        ; token of look-ahead settles it.
        if allow_ambiguity = false
        {
            var commits false
            if token = KindEqualsGreaterThanToken
                set commits: true
            if token = KindOpenBraceToken
                set commits: true
            if commits = false
                return null
        }

        ; ★ The `=>` may be MISSING and the arrow is built anyway — with a
        ; synthesized token and, when the last token was neither `=>` nor `{`, an
        ; IDENTIFIER as the body rather than an expression. Slice 12's note here
        ; said parse_expected_token stops instead, "which means that past this
        ; point the token WAS `=>`"; that is no longer true, and `last_token` is
        ; what the reference uses to tell the two apart.
        let last_token token
        let equals_greater_than_token this.parse_expected_token(KindEqualsGreaterThanToken)
        if equals_greater_than_token = null
            return null
        var body null as pointer[AstNode]
        var had_arrow_or_brace false
        if last_token = KindEqualsGreaterThanToken
            set had_arrow_or_brace: true
        if last_token = KindOpenBraceToken
            set had_arrow_or_brace: true
        if had_arrow_or_brace
            set body: this.parse_arrow_function_expression_body(is_async, allow_return_type)
        else
            set body: this.parse_identifier()
        if body = null
            return null

        ; `x ? y => ({ y }) : z => ({ z })`. In the true branch of a conditional
        ; a `:` ends the expression, so a return type may not be consumed there
        ; unless a SECOND colon follows.
        if allow_return_type = false
        {
            if has_return_colon
            {
                if token <> KindColonToken
                    return null
            }
        }

        let result this.finish_node(this.new_node(KindArrowFunction, NodeData.ArrowFunction(ArrowFunctionData(modifiers, type_parameters, parameters, return_type, null, equals_greater_than_token, body))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    procedure parse_modifiers_for_arrow_function(this) returns pointer[Array[pointer[AstNode]]]
    {
        if token <> KindAsyncKeyword
            return null
        let pos this.node_pos()
        this.next_token()
        let m this.finish_node(this.new_node(KindAsyncKeyword, NodeData.Token(TokenData())), pos)
        if m = null
            return null
        let list AstNode.new_node_list(host)
        list.add(m)
        ; `p.newModifierList(modifier.Loc, ...)` — this list's range IS the one
        ; modifier's, not a span computed from the token stream.
        this.record_list_range(list, m.pos, m.end)
        list
    }

    procedure parse_arrow_function_expression_body(this, is_async: bool, allow_return_type: bool) returns pointer[AstNode]
    {
        if token = KindOpenBraceToken
        {
            var block_flags ParseFlagsNone
            if is_async
                set block_flags: ParseFlagsAwait
            return this.parse_function_block(block_flags)
        }

        ; A plain STATEMENT after the arrow means the opening brace was probably
        ; forgotten. The reference recovers with ParseFlagsIgnoreMissingOpenBrace,
        ; which always reports.
        var looks_like_a_block false
        if token <> KindSemicolonToken
        {
            if token <> KindFunctionKeyword
            {
                if token <> KindClassKeyword
                {
                    if this.is_start_of_statement()
                    {
                        if this.is_start_of_expression_statement() = false
                            set looks_like_a_block: true
                    }
                }
            }
        }
        if looks_like_a_block
        {
            var recover_flags ParseFlagsIgnoreMissingOpenBrace
            if is_async
                set recover_flags: recover_flags | ParseFlagsAwait
            return this.parse_function_block(recover_flags)
        }

        let saved context_flags
        this.set_context_flags(NodeFlagsAwaitContext, is_async)
        this.set_context_flags(NodeFlagsYieldContext, false)
        let node this.parse_assignment_expression_or_higher_worker(allow_return_type)
        set context_flags: saved
        node
    }

    function is_start_of_expression_statement(this) returns bool
    {
        ; None of `{`, `function`, `class` or `@` can start an expression
        ; statement, per the grammar.
        if token = KindOpenBraceToken
            return false
        if token = KindFunctionKeyword
            return false
        if token = KindClassKeyword
            return false
        if token = KindAtToken
            return false
        this.is_start_of_expression()
    }

    ; ── the async simple arrow function ─────────────────────────────────────

    procedure try_parse_async_simple_arrow_function_expression(this, allow_return_type: bool) returns pointer[AstNode]
    {
        if token <> KindAsyncKeyword
            return null
        if this.look_ahead_next_is_un_parenthesized_async_arrow_function() = false
            return null
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let async_modifier this.parse_modifiers_for_arrow_function()
        if this.is_unported()
            return null
        let expr this.parse_binary_expression_or_higher(OperatorPrecedenceLowest)
        if expr = null
            return null
        this.parse_simple_arrow_function_expression(pos, expr, allow_return_type, jsdoc, async_modifier)
    }

    ; ★ This look-ahead PARSES — it runs the whole binary ladder to see whether
    ; what follows `async` is one identifier and an arrow — so anything it
    ; reports is thrown away with it, which the rewind now does.
    procedure look_ahead_next_is_un_parenthesized_async_arrow_function(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_un_parenthesized_async_arrow_function()
        this.rewind(saved)
        r
    }

    procedure next_is_un_parenthesized_async_arrow_function(this) returns bool
    {
        if token <> KindAsyncKeyword
            return false
        this.next_token()
        ; `async => x` is a plain arrow function whose parameter is named async.
        if this.has_preceding_line_break()
            return false
        if token = KindEqualsGreaterThanToken
            return false
        let expr this.parse_binary_expression_or_higher(OperatorPrecedenceLowest)
        if expr = null
            return false
        if this.has_preceding_line_break()
            return false
        if AstNode.kind_of(expr) <> KindIdentifier
            return false
        token = KindEqualsGreaterThanToken
    }

    procedure parse_simple_arrow_function_expression(this, pos: int, identifier: pointer[AstNode], allow_return_type: bool, jsdoc: int, async_modifier: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        ; The single parameter is SYNTHESIZED around the identifier that was
        ; already parsed, and it starts where that identifier does — not where
        ; the arrow function does, which differs whenever an `async` precedes it.
        let parameter this.finish_node(this.new_node(KindParameter, NodeData.Parameter(ParameterData(null, null, identifier, null, null, null))), AstNode.pos_of(identifier))
        if parameter = null
            return null
        let parameters AstNode.new_node_list(host)
        parameters.add(parameter)

        let equals_greater_than_token this.parse_expected_token(KindEqualsGreaterThanToken)
        if equals_greater_than_token = null
            return null

        var is_async false
        if async_modifier <> null
            set is_async: true
        let body this.parse_arrow_function_expression_body(is_async, allow_return_type)
        if body = null
            return null

        let result this.finish_node(this.new_node(KindArrowFunction, NodeData.ArrowFunction(ArrowFunctionData(async_modifier, null, parameters, null, null, equals_greater_than_token, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ── the expression-start predicates ─────────────────────────────────────

    procedure is_start_of_expression(this) returns bool
    {
        if this.is_start_of_left_hand_side_expression()
            return true
        ; `yield` and `await` always start an expression: either they are names,
        ; or they are keywords and started a yield/await expression.
        if unary_expression_start_token(token)
            return true
        ; Error tolerance: a leading binary operator is taken as the start of an
        ; expression, so that a missing left operand is one diagnostic rather
        ; than a cascade.
        if this.is_binary_operator()
            return true
        this.is_identifier()
    }

    function unary_expression_start_token(k: int) returns bool
    {
        if k = KindPlusToken
            return true
        if k = KindMinusToken
            return true
        if k = KindTildeToken
            return true
        if k = KindExclamationToken
            return true
        if k = KindDeleteKeyword
            return true
        if k = KindTypeOfKeyword
            return true
        if k = KindVoidKeyword
            return true
        if k = KindPlusPlusToken
            return true
        if k = KindMinusMinusToken
            return true
        if k = KindLessThanToken
            return true
        if k = KindAwaitKeyword
            return true
        if k = KindYieldKeyword
            return true
        if k = KindPrivateIdentifier
            return true
        k = KindAtToken
    }

    procedure is_start_of_left_hand_side_expression(this) returns bool
    {
        if left_hand_side_start_token(token)
            return true
        if token = KindImportKeyword
            return this.look_ahead_next_token_is_open_paren_or_less_than_or_dot()
        this.is_identifier()
    }

    function left_hand_side_start_token(k: int) returns bool
    {
        if k = KindThisKeyword
            return true
        if k = KindSuperKeyword
            return true
        if k = KindNullKeyword
            return true
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindStringLiteral
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindTemplateHead
            return true
        if k = KindOpenParenToken
            return true
        if k = KindOpenBracketToken
            return true
        if k = KindOpenBraceToken
            return true
        if k = KindFunctionKeyword
            return true
        if k = KindClassKeyword
            return true
        if k = KindNewKeyword
            return true
        if k = KindSlashToken
            return true
        if k = KindSlashEqualsToken
            return true
        k = KindIdentifier
    }

    ; isStartOfStatement. Its only caller in this slice is the arrow function's
    ; body, which asks whether a missing `{` is the likelier reading — but it is
    ; the reference's own statement predicate and the statement-list contexts
    ; will want it too.
    procedure is_start_of_statement(this) returns bool
    {
        if statement_start_token(token)
            return true
        if token = KindImportKeyword
        {
            if this.is_start_of_declaration()
                return true
            return this.look_ahead_next_token_is_open_paren_or_less_than_or_dot()
        }
        if token = KindConstKeyword
            return this.is_start_of_declaration()
        if token = KindExportKeyword
            return this.is_start_of_declaration()
        ; When these do not start a declaration they are an identifier in an
        ; expression statement, which is still a statement.
        if contextual_statement_start_token(token)
            return true
        ; ... and these may instead be the start of a CLASS MEMBER, which is not
        ; a statement — so an identifier directly after one says "member".
        if class_member_start_token(token)
        {
            if this.is_start_of_declaration()
                return true
            return this.look_ahead_next_token_is_identifier_or_keyword_on_same_line() = false
        }
        this.is_start_of_expression()
    }

    function statement_start_token(k: int) returns bool
    {
        if k = KindAtToken
            return true
        if k = KindSemicolonToken
            return true
        if k = KindOpenBraceToken
            return true
        if k = KindVarKeyword
            return true
        if k = KindLetKeyword
            return true
        if k = KindUsingKeyword
            return true
        if k = KindFunctionKeyword
            return true
        if k = KindClassKeyword
            return true
        if k = KindEnumKeyword
            return true
        if k = KindIfKeyword
            return true
        if k = KindDoKeyword
            return true
        if k = KindWhileKeyword
            return true
        if k = KindForKeyword
            return true
        if k = KindContinueKeyword
            return true
        if k = KindBreakKeyword
            return true
        if k = KindReturnKeyword
            return true
        if k = KindWithKeyword
            return true
        if k = KindSwitchKeyword
            return true
        if k = KindThrowKeyword
            return true
        if k = KindTryKeyword
            return true
        if k = KindDebuggerKeyword
            return true
        ; `catch` and `finally` do not really start a statement; the reference
        ; says they do so that they parse and are reported later.
        if k = KindCatchKeyword
            return true
        k = KindFinallyKeyword
    }

    function contextual_statement_start_token(k: int) returns bool
    {
        if k = KindAsyncKeyword
            return true
        if k = KindDeclareKeyword
            return true
        if k = KindInterfaceKeyword
            return true
        if k = KindModuleKeyword
            return true
        if k = KindNamespaceKeyword
            return true
        if k = KindTypeKeyword
            return true
        if k = KindGlobalKeyword
            return true
        k = KindDeferKeyword
    }

    function class_member_start_token(k: int) returns bool
    {
        if k = KindAccessorKeyword
            return true
        if k = KindPublicKeyword
            return true
        if k = KindPrivateKeyword
            return true
        if k = KindProtectedKeyword
            return true
        if k = KindStaticKeyword
            return true
        k = KindReadonlyKeyword
    }

    ; ── the look-ahead wrappers for the ladder ──────────────────────────────

    procedure look_ahead_next_token_is_open_paren_or_less_than(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r token = KindOpenParenToken
        if r = false
        {
            if token = KindLessThanToken
                set r: true
        }
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_open_paren_or_less_than_or_dot(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r token = KindOpenParenToken
        if r = false
        {
            if token = KindLessThanToken
                set r: true
        }
        if r = false
        {
            if token = KindDotToken
                set r: true
        }
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_dot(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() = KindDotToken
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_identifier(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        let r this.is_identifier()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_identifier_or_keyword_or_literal_on_same_line(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_identifier_or_keyword_or_literal_on_same_line()
        this.rewind(saved)
        r
    }

    procedure next_token_is_identifier_or_keyword_or_literal_on_same_line(this) returns bool
    {
        this.next_token()
        var ok token_is_identifier_or_keyword(token)
        if ok = false
        {
            if token = KindNumericLiteral
                set ok: true
        }
        if ok = false
        {
            if token = KindBigIntLiteral
                set ok: true
        }
        if ok = false
        {
            if token = KindStringLiteral
                set ok: true
        }
        if ok = false
            return false
        this.has_preceding_line_break() = false
    }

    procedure look_ahead_next_token_is_identifier_or_keyword_or_open_bracket_or_template(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r token_is_identifier_or_keyword(token)
        if r = false
        {
            if token = KindOpenBracketToken
                set r: true
        }
        if r = false
        {
            if this.is_template_start_of_tagged_template()
                set r: true
        }
        this.rewind(saved)
        r
    }

    ; parseExpectedToken — the first of the two MISSING-NODE factories. When the
    ; expected token is absent the reference reports "'x' expected" and
    ; synthesizes a token of that kind at the current position, so the node it
    ; was going to build has its slot filled and the walk carries on.
    ;
    ; ★ The synthesized node is ZERO WIDTH and its position is node_pos(), i.e.
    ; the FULL start of the token that is actually there — leading trivia
    ; included — which is not the same place as the diagnostic, whose range is
    ; the token WITHOUT its trivia. Two ranges, two questions: where the missing
    ; thing would have gone, and what the user has to look at.
    procedure parse_expected_token(this, kind: int) returns pointer[AstNode]
    {
        let t this.parse_optional_token(kind)
        if t <> null
            return t
        this.parse_error_at_current_token(DiagX_0_expected)
        this.finish_node(this.new_node(kind, NodeData.Token(TokenData())), this.node_pos())
    }

    function in_disallow_in_context(this) returns bool
        (context_flags & NodeFlagsDisallowInContext) <> 0

    function in_decorator_context(this) returns bool
        (context_flags & NodeFlagsDecoratorContext) <> 0

    procedure parse_literal_expression(this, kind: int) returns pointer[AstNode]
    {
        let pos this.node_pos()

        ; ★★★ READ BEFORE THE TOKEN MOVES. The reference takes TokenValue() and
        ; TokenFlags() at the top of this function and hands them to the factory
        ; at the bottom; ours advances first, so both have to be captured here or
        ; they are the NEXT token's. Since slice 31 the TEXT is captured too, and
        ; it is the same pair a stored identifier's is — see LiteralData for the
        ; reader that earned it.
        ;
        ; ★ The `intern` parameter is not ported: it puts the text through a
        ; shared string table, which is a cache and changes no answer — the same
        ; treatment createIdentifier's interning gets.
        ;
        ; Each factory masks with its own composite, and that is transcribed
        ; rather than folded into one: NumericLiteral and BigIntLiteral share
        ; TokenFlagsNumericLiteralFlags upstream and the other two do not.
        let flags scanner.token_flags()
        let text scanner.token_value()
        let text_len scanner.token_value_length()

        this.next_token()

        if kind = KindNumericLiteral
            return this.finish_node(this.new_node(kind, NodeData.NumericLiteral(LiteralData(text, text_len, flags & TokenFlagsNumericLiteralFlags))), pos)
        if kind = KindBigIntLiteral
            return this.finish_node(this.new_node(kind, NodeData.BigIntLiteral(LiteralData(text, text_len, flags & TokenFlagsNumericLiteralFlags))), pos)
        if kind = KindNoSubstitutionTemplateLiteral
            return this.finish_node(this.new_node(kind, NodeData.NoSubstitutionTemplateLiteral(LiteralData(text, text_len, flags & TokenFlagsTemplateLiteralLikeFlags))), pos)
        if kind = KindRegularExpressionLiteral
            return this.finish_node(this.new_node(kind, NodeData.RegularExpressionLiteral(LiteralData(text, text_len, flags & TokenFlagsRegularExpressionLiteralFlags))), pos)
        this.finish_node(this.new_node(kind, NodeData.StringLiteral(LiteralData(text, text_len, flags & TokenFlagsStringLiteralFlags))), pos)
    }

    ; ── templates in expression position — parser slice 11 ──────────────────
    ;
    ; The head, the middle/tail and the seam that rewinds a `}` are in the TYPE
    ; section, where the reference keeps them, because both faces share them.
    ; What is here is the two nodes only an expression can build.

    procedure parse_template_expression(this, is_tagged_template: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let head this.parse_template_head(is_tagged_template)
        if head = null
            return null
        let spans this.parse_template_spans(is_tagged_template)
        if spans = null
            return null
        this.finish_node(this.new_node(KindTemplateExpression, NodeData.TemplateExpression(TemplateLiteralData(head, spans))), pos)
    }

    procedure parse_template_spans(this, is_tagged_template: bool) returns pointer[Array[pointer[AstNode]]]
    {
        let list AstNode.new_node_list(host)
        while true
        {
            let span this.parse_template_span(is_tagged_template)
            if span = null
                return null
            list.add(span)
            if AstNode.kind_of(AstNode.template_span_literal(span)) <> KindTemplateMiddle
                break
        }
        list
    }

    ; ★ parseExpressionAllowIn, not parseExpression: a substitution is bracketed
    ; by `${` and `}`, so an `in` inside it is unambiguous even when the template
    ; itself sits in a `for` initializer. Dropping the AllowIn would make
    ; `for (x = `${a in b}`;;) ;` a different tree.
    procedure parse_template_span(this, is_tagged_template: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        let literal this.parse_literal_of_template_span(is_tagged_template)
        if literal = null
            return null
        this.finish_node(this.new_node(KindTemplateSpan, NodeData.TemplateSpan(TemplateSpanData(expression, literal))), pos)
    }

    ; ★★ The NoSubstitutionTemplateLiteral arm re-scans UNCONDITIONALLY, and the
    ; asymmetry against parse_template_head — which re-scans only for an invalid
    ; token — is the whole point of the parameter. A tagged template's raw text
    ; is handed to the tag function verbatim, so `` t`\unicode` `` is legal;
    ; re-scanning with is_tagged_template says "read this again, and this time do
    ; not call an invalid escape an error". The kinds, spans and flags are the
    ; same either way, so in this port the call is inert — see the scanner's
    ; re_scan_template_token for the over-report that inertness costs.
    ;
    ; ★★★ The reference follows this with unparseExpressionWithTypeArguments, which
    ; rewrites `.Parent` back-pointers so the absorbed nodes no longer claim an
    ; ExpressionWithTypeArguments parent. The note that stood here — "this port keeps
    ; no parent pointers, so it is a genuine no-op" — EXPIRED with slice 27, which
    ; ported Parent, and this is §3.5p's rule paid in the direction it is usually
    ; paid: the slice that lifts a condition owns every comment resting on it. It is
    ; STILL a no-op, for a different reason: the absorbed expression and type
    ; arguments are children of the node this returns, and our finish_node writes
    ; the parents of a finished node's immediate children — which is precisely what
    ; the reference's helper does by hand.
    procedure parse_tagged_template_rest(this, pos: int, tag: pointer[AstNode], question_dot_token: pointer[AstNode], type_arguments: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        var template null as pointer[AstNode]
        if token = KindNoSubstitutionTemplateLiteral
        {
            this.re_scan_template_token(true)
            if this.is_unported()
                return null
            set template: this.parse_literal_expression(KindNoSubstitutionTemplateLiteral)
        }
        else
            set template: this.parse_template_expression(true)
        if template = null
            return null

        ; ★ A direct FLAG read on the tag, not try_reparse_optional_chain — the
        ; two neighbouring rests (property access, element access) use the
        ; reparse and this one does not, which is the reference's own
        ; distinction and not an abbreviation of it.
        var is_optional_chain false
        if question_dot_token <> null
            set is_optional_chain: true
        else
        {
            if (tag.flags & NodeFlagsOptionalChain) <> 0
                set is_optional_chain: true
        }

        let n this.new_node(KindTaggedTemplateExpression, NodeData.TaggedTemplateExpression(TaggedTemplateData(tag, question_dot_token, type_arguments, template)))
        if is_optional_chain
            set n.flags: n.flags | NodeFlagsOptionalChain
        this.check_js_syntax(this.finish_node(n, pos))
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; TYPES — parser slice 3
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; The reference's "// TYPES" section, ported as one unit because it IS one:
    ; a type alias, a function signature, an interface member and a variable's
    ; `: T` all call the same parseType, and none of them can be built before it
    ; exists. `type X = …` is its smallest consumer, which is why it is the
    ; declaration this slice adds.
    ;
    ; ── The ladder, top to bottom ───────────────────────────────────────────
    ;
    ;   parseType                    conditional type  (T extends U ? X : Y)
    ;   parseUnionTypeOrHigher       A | B
    ;   parseIntersectionTypeOrHigher A & B
    ;   parseTypeOperatorOrHigher    keyof / unique / readonly / infer
    ;   parsePostfixTypeOrHigher     T[]  T[K]  T!  T?
    ;   parseNonArrayType            the leaves and the bracketed forms
    ;
    ; ── What is NOT ported, each because it is the head of another slice ────
    ;
    ;   (function and constructor types were this list's first entry and landed
    ;    with slice 4 — see the SIGNATURES banner)
    ;   the object type literal `{ … }`  it needs parseTypeMember — which is the
    ;                                    interface-member slice, and a mapped
    ;                                    type shares the tag because both stop
    ;                                    at the same `{`
    ;   (`import(…)` types were this list's entry for the import machinery and
    ;    landed with slice 18 — see parse_import_type below, which is in the
    ;    import slice's company rather than here because what held it up was the
    ;    SOURCE FILE flag, not the type ladder)
    ;   (template literal types were this list's entry for ReScanTemplateToken
    ;    and landed with slice 11 — see the TEMPLATES block below)
    ;   the JSDoc prefix forms `*`, `??` they need two more re-scan entry points
    ;
    ; ── Three faithfulness notes, each one a thing that is easy to lose ─────
    ;
    ; (1) Some reference nodes carry a field the dump cannot see — the OPERATOR
    ;     of a TypeOperatorNode and the operator of a PrefixUnaryExpression. They
    ;     are not stored here, and that is a real gap rather than a saving: the
    ;     yardstick compares kind, range and flags, so it would not notice one
    ;     being wrong. Stated so that the slice which first READS such a field
    ;     knows to add it.
    ;
    ;     ★ The `IsTypeOf` flag of an ImportTypeNode was the third entry and IS
    ;     stored since slice 18 — not because a reader arrived (none has; the
    ;     reader would be the checker) but because without it `typeof import("m")`
    ;     and `import("m")` are the same node, which is the argument
    ;     ImportEqualsDeclarationData's `is_type_only` already carries. It is the
    ;     §3.5ao report and one of slice 18's three UNGATED controls.
    ;
    ; (2) The reference's list parsing goes through parsing CONTEXTS with a
    ;     per-context element predicate, terminator predicate and token-skipping
    ;     recovery. The three contexts this slice needs are ported literally
    ;     (is_list_element / is_list_terminator); the recovery is not, because
    ;     it only runs after a diagnostic, and a diagnostic is already unported.
    ;
    ; (3) ★ THIS PARAGRAPH WAS TRUE WHEN SLICE 3 WROTE IT AND SLICE 5 REVERSED
    ;     IT; it is corrected here rather than deleted, because the reasoning it
    ;     records is the reasoning the `unanswerable` record now carries alone.
    ;     It said `unported` is STICKY and a speculation does not undo it, so a
    ;     look-ahead walking into an unported construct stops the whole parse
    ;     even where the reference would discard the branch — over-reporting,
    ;     which is the direction this harness errs in. What slice 5 measured is
    ;     that the reference's own `rewind` TRUNCATES its diagnostics, so a
    ;     discarded speculation reports nothing upstream and a sticky record
    ;     made `a << b` unparsable. Since then a rewind restores `unported` and
    ;     only `unanswerable` — one site, skip_parameter_start — survives one.
    ;     See the ParserState header, where the argument lives.

    ; ── context flags ───────────────────────────────────────────────────────
    ;
    ; setContextFlags. Go's `&^=` is AND-NOT, and Scaly spells it `& ~` — the
    ; unary complement exists (CLAUDE.md §3.5f).

    procedure set_context_flags(this, flags: int, value: bool)
    {
        if value
            set context_flags: context_flags | flags
        else
            set context_flags: context_flags & ~flags
    }

    function in_disallow_conditional_types_context(this) returns bool
        (context_flags & NodeFlagsDisallowConditionalTypesContext) <> 0

    ; ── the entry points ────────────────────────────────────────────────────

    procedure parse_type_annotation(this) returns pointer[AstNode]
    {
        if this.parse_optional(KindColonToken)
            return this.parse_type()
        null
    }

    procedure parse_type(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsTypeExcludesFlags, false)
        let result this.parse_type_worker()
        set context_flags: saved
        result
    }

    ; doInContext(p, flags, value, (*Parser).parseType) — the only shape of
    ; doInContext this slice needs, spelled out because it takes a func value.
    procedure parse_type_in_context(this, flags: int, value: bool) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(flags, value)
        let result this.parse_type()
        set context_flags: saved
        result
    }

    procedure parse_type_worker(this) returns pointer[AstNode]
    {
        if this.is_start_of_function_type_or_constructor_type()
            return this.parse_function_or_constructor_type()

        let pos this.node_pos()
        let type_node this.parse_union_type_or_higher()
        if type_node = null
            return null

        if this.in_disallow_conditional_types_context()
            return type_node
        if this.has_preceding_line_break()
            return type_node
        if this.parse_optional(KindExtendsKeyword) = false
            return type_node

        ; The type following `extends` may not itself be conditional; the two
        ; branches may.
        let extends_type this.parse_type_in_context(NodeFlagsDisallowConditionalTypesContext, true)
        if extends_type = null
            return null
        this.parse_expected(KindQuestionToken)
        let true_type this.parse_type_in_context(NodeFlagsDisallowConditionalTypesContext, false)
        if true_type = null
            return null
        this.parse_expected(KindColonToken)
        let false_type this.parse_type_in_context(NodeFlagsDisallowConditionalTypesContext, false)
        if false_type = null
            return null

        this.finish_node(this.new_node(KindConditionalType, NodeData.ConditionalType(ConditionalTypeData(type_node, extends_type, true_type, false_type))), pos)
    }

    ; ── union and intersection ──────────────────────────────────────────────
    ;
    ; The reference passes the constituent parser down as a func value; here the
    ; `is_union` flag selects it. Both constituents are known statically, and a
    ; callback is the shape the escape checker rejects (§3.9e).

    procedure parse_union_type_or_higher(this) returns pointer[AstNode]
        this.parse_union_or_intersection_type(KindBarToken, true)

    procedure parse_intersection_type_or_higher(this) returns pointer[AstNode]
        this.parse_union_or_intersection_type(KindAmpersandToken, false)

    procedure parse_constituent_type(this, is_union: bool) returns pointer[AstNode]
    {
        if is_union
            return this.parse_intersection_type_or_higher()
        this.parse_type_operator_or_higher()
    }

    ; parseFunctionOrConstructorTypeToError. The reference parses the function
    ; type and then reports that it must be parenthesized here; the node and the
    ; diagnostic are both unported, so the whole arm is.
    ; ★ A function or constructor type is not allowed DIRECTLY in a union or an
    ; intersection — `A | () => B` has to be parenthesized. The reference parses
    ; it anyway and issues one of FOUR messages, chosen by the node's kind and by
    ; which of the two operators we are under, so the tree is the same and only
    ; the diagnostic differs. The span is the whole type node, trivia included:
    ; the reference passes `typeNode.Loc` rather than skipRangeTrivia of it.
    procedure parse_function_or_constructor_type_to_error(this, is_union: bool) returns pointer[AstNode]
    {
        if this.is_start_of_function_type_or_constructor_type()
        {
            let type_node this.parse_function_or_constructor_type()
            if type_node = null
                return null
            var code DiagConstructor_type_notation_must_be_parenthesized_when_used_in_an_intersection_type
            if type_node.kind = KindFunctionType
            {
                if is_union
                    set code: DiagFunction_type_notation_must_be_parenthesized_when_used_in_a_union_type
                else
                    set code: DiagFunction_type_notation_must_be_parenthesized_when_used_in_an_intersection_type
            }
            else
            {
                if is_union
                    set code: DiagConstructor_type_notation_must_be_parenthesized_when_used_in_a_union_type
            }
            this.parse_error_at_range(type_node.pos, type_node.end, code)
            return type_node
        }
        this.parse_constituent_type(is_union)
    }

    procedure parse_union_or_intersection_type(this, op: int, is_union: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let has_leading_operator this.parse_optional(op)

        var type_node null as pointer[AstNode]
        if has_leading_operator
            set type_node: this.parse_function_or_constructor_type_to_error(is_union)
        else
            set type_node: this.parse_constituent_type(is_union)
        if type_node = null
            return null

        ; A LEADING operator makes it a union/intersection node even with one
        ; constituent — `type A = | B` is a UnionType of one.
        var is_list has_leading_operator
        if token = op
            set is_list: true
        if is_list = false
            return type_node

        let types AstNode.new_node_list(host)
        types.add(type_node)
        while this.parse_optional(op)
        {
            let t this.parse_function_or_constructor_type_to_error(is_union)
            if t = null
                return null
            types.add(t)
        }

        var n null as pointer[AstNode]
        if is_union
            set n: this.new_node(KindUnionType, NodeData.UnionType(TypeListData(types)))
        else
            set n: this.new_node(KindIntersectionType, NodeData.IntersectionType(TypeListData(types)))
        this.finish_node(n, pos)
    }

    ; ── type operators ──────────────────────────────────────────────────────

    procedure parse_type_operator_or_higher(this) returns pointer[AstNode]
    {
        if token = KindKeyOfKeyword
            return this.parse_type_operator(token)
        if token = KindUniqueKeyword
            return this.parse_type_operator(token)
        if token = KindReadonlyKeyword
            return this.parse_type_operator(token)
        if token = KindInferKeyword
            return this.parse_infer_type()
        this.parse_postfix_type_in_context()
    }

    procedure parse_postfix_type_in_context(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowConditionalTypesContext, false)
        let result this.parse_postfix_type_or_higher()
        set context_flags: saved
        result
    }

    ; The reference's TypeOperatorNode stores WHICH operator; see faithfulness
    ; note (1) — nothing reads it yet and the dump cannot see it.
    procedure parse_type_operator(this, op: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(op)
        let inner this.parse_type_operator_or_higher()
        if inner = null
            return null
        this.finish_node(this.new_node(KindTypeOperator, NodeData.TypeOperator(WrappedTypeData(inner))), pos)
    }

    procedure parse_infer_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindInferKeyword)
        let tp this.parse_type_parameter_of_infer_type()
        if tp = null
            return null
        this.finish_node(this.new_node(KindInferType, NodeData.InferType(WrappedTypeData(tp))), pos)
    }

    procedure parse_type_parameter_of_infer_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let name this.parse_identifier()
        if name = null
            return null
        let constraint this.try_parse_constraint_of_infer_type()
        if this.is_unported()
            return null
        this.finish_node(this.new_node(KindTypeParameter, NodeData.TypeParameter(TypeParameterData(null, name, constraint, null, null))), pos)
    }

    ; `infer T extends U` is a constraint — unless a `?` follows, in which case
    ; the `extends` belonged to an enclosing conditional type and the whole
    ; speculation is rewound.
    procedure try_parse_constraint_of_infer_type(this) returns pointer[AstNode]
    {
        let saved this.mark()
        if this.parse_optional(KindExtendsKeyword)
        {
            let constraint this.parse_type_in_context(NodeFlagsDisallowConditionalTypesContext, true)
            if constraint = null
                return null
            if this.in_disallow_conditional_types_context()
                return constraint
            if token <> KindQuestionToken
                return constraint
        }
        ; The reference PARSED a type here and is throwing it away, diagnostics
        ; included — which is what the rewind does now. See ParserState.
        this.rewind(saved)
        null
    }

    ; ── postfix ─────────────────────────────────────────────────────────────

    procedure parse_postfix_type_or_higher(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var type_node this.parse_non_array_type()
        if type_node = null
            return null

        while this.has_preceding_line_break() = false
        {
            if token = KindExclamationToken
            {
                this.next_token()
                set type_node: this.finish_node(this.new_node(KindJSDocNonNullableType, NodeData.JSDocNonNullableType(WrappedTypeData(type_node))), pos)
                continue
            }

            if token = KindQuestionToken
            {
                ; `T ? X : Y` — the `?` opens a conditional type's true branch
                ; and does NOT make T nullable. A type following it is what
                ; tells the two apart, and it is the whole reason this arm looks
                ; ahead instead of testing a token.
                if this.look_ahead_next_is_start_of_type()
                    return type_node
                this.next_token()
                set type_node: this.finish_node(this.new_node(KindJSDocNullableType, NodeData.JSDocNullableType(WrappedTypeData(type_node))), pos)
                continue
            }

            if token = KindOpenBracketToken
            {
                this.parse_expected(KindOpenBracketToken)
                if this.is_start_of_type(false)
                {
                    let index_type this.parse_type()
                    if index_type = null
                        return null
                    this.parse_expected(KindCloseBracketToken)
                    set type_node: this.finish_node(this.new_node(KindIndexedAccessType, NodeData.IndexedAccessType(IndexedAccessTypeData(type_node, index_type))), pos)
                    continue
                }
                this.parse_expected(KindCloseBracketToken)
                set type_node: this.finish_node(this.new_node(KindArrayType, NodeData.ArrayType(WrappedTypeData(type_node))), pos)
                continue
            }

            return type_node
        }
        type_node
    }

    ; ── the leaves ──────────────────────────────────────────────────────────

    procedure parse_non_array_type(this) returns pointer[AstNode]
    {
        if keyword_type_start(token)
        {
            ; A keyword type followed by a dot is a dotted type REFERENCE
            ; (`string.Foo`), so the keyword is parsed and, on seeing the dot,
            ; put back.
            let saved this.mark()
            let kw this.parse_keyword_type_node()
            if token <> KindDotToken
                return kw
            this.rewind(saved)
            return this.parse_type_reference()
        }

        ; The JSDoc PREFIX forms. `*=` and `??` are ONE token to the ordinary
        ; scanner and TWO to this grammar, so each needs a re-scan first — slice
        ; 21 supplied both, and they are the last two entry points of the ReScan
        ; family. The reference reaches the arm below by FALLING THROUGH from the
        ; re-scan case into the plain one; here the re-scan sets the token and the
        ; call is repeated, which is the same program.
        if token = KindAsteriskEqualsToken
        {
            scanner.re_scan_asterisk_equals_token()
            return this.parse_jsdoc_all_type()
        }
        if token = KindAsteriskToken
            return this.parse_jsdoc_all_type()
        if token = KindQuestionQuestionToken
        {
            scanner.re_scan_question_token()
            return this.parse_jsdoc_nullable_type()
        }
        if token = KindQuestionToken
            return this.parse_jsdoc_nullable_type()
        if token = KindExclamationToken
            return this.parse_jsdoc_non_nullable_type()

        if literal_type_start(token)
            return this.parse_literal_type_node(false)

        if token = KindMinusToken
        {
            if this.look_ahead_next_token_is_numeric_or_bigint_literal()
                return this.parse_literal_type_node(true)
            return this.parse_type_reference()
        }

        ; `void` is a keyword type with no dotted fallback — there is no
        ; `void.Foo`.
        if token = KindVoidKeyword
            return this.parse_keyword_type_node()

        if token = KindThisKeyword
        {
            let this_keyword this.parse_this_type_node()
            if this_keyword = null
                return null
            if token = KindIsKeyword
            {
                if this.has_preceding_line_break() = false
                    return this.parse_this_type_predicate(this_keyword)
            }
            return this_keyword
        }

        if token = KindTypeOfKeyword
        {
            if this.look_ahead_next_is_start_of_type_of_import_type()
                return this.parse_import_type()
            return this.parse_type_query()
        }

        ; `{` opens an object type literal or a mapped type, and only this
        ; look-ahead separates them. Both landed with slice 7; while they were
        ; unported they shared one tag, for the reason the histogram bore out —
        ; they are one slice.
        if token = KindOpenBraceToken
        {
            if this.look_ahead_next_is_start_of_mapped_type()
                return this.parse_mapped_type()
            return this.parse_type_literal()
        }

        if token = KindOpenBracketToken
            return this.parse_tuple_type()
        if token = KindOpenParenToken
            return this.parse_parenthesized_type()
        if token = KindImportKeyword
            return this.parse_import_type()

        if token = KindAssertsKeyword
        {
            if this.look_ahead_next_token_is_identifier_or_keyword_on_same_line()
                return this.parse_asserts_type_predicate()
            return this.parse_type_reference()
        }

        if token = KindTemplateHead
            return this.parse_template_type()

        this.parse_type_reference()
    }

    ; The ten keyword types that fall back to a dotted type reference. `void` is
    ; deliberately not among them — see parse_non_array_type.
    function keyword_type_start(k: int) returns bool
    {
        if k = KindAnyKeyword
            return true
        if k = KindUnknownKeyword
            return true
        if k = KindStringKeyword
            return true
        if k = KindNumberKeyword
            return true
        if k = KindBigIntKeyword
            return true
        if k = KindSymbolKeyword
            return true
        if k = KindBooleanKeyword
            return true
        if k = KindUndefinedKeyword
            return true
        if k = KindNeverKeyword
            return true
        k = KindObjectKeyword
    }

    function literal_type_start(k: int) returns bool
    {
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindStringLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        k = KindNullKeyword
    }

    function keyword_literal(k: int) returns bool
    {
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        k = KindNullKeyword
    }

    ; parseKeywordTypeNode. Identical in shape to parseTokenNode — a keyword
    ; type is a node whose KIND is the keyword and which has no children, which
    ; is why ast.scaly gives it no record of its own — and kept under its own
    ; name because the reference has two and a reader looking at the type side
    ; should find it there.
    procedure parse_keyword_type_node(this) returns pointer[AstNode]
        this.parse_token_node()

    procedure parse_this_type_node(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        this.finish_node(this.new_node(KindThisType, NodeData.Token(TokenData())), pos)
    }

    ; `this is T`. The node starts where the `this` did, not at the `is`.
    procedure parse_this_type_predicate(this, lhs: pointer[AstNode]) returns pointer[AstNode]
    {
        this.next_token()
        let t this.parse_type()
        if t = null
            return null
        this.finish_node(this.new_node(KindTypePredicate, NodeData.TypePredicate(TypePredicateData(null, lhs, t))), AstNode.pos_of(lhs))
    }

    ; `asserts x`, `asserts x is T`, `asserts this is T`.
    procedure parse_asserts_type_predicate(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        ; parseExpectedToken. Its missing-token recovery is unreachable in
        ; practice — the look-ahead in parse_non_array_type is what routed us
        ; here, so the `asserts` is known present — but the call is the
        ; reference's and now behaves like it.
        let asserts_modifier this.parse_expected_token(KindAssertsKeyword)
        if asserts_modifier = null
            return null

        var parameter_name null as pointer[AstNode]
        if token = KindThisKeyword
            set parameter_name: this.parse_this_type_node()
        else
            set parameter_name: this.parse_identifier()
        if parameter_name = null
            return null

        var type_node null as pointer[AstNode]
        if this.parse_optional(KindIsKeyword)
        {
            set type_node: this.parse_type()
            if type_node = null
                return null
        }

        this.finish_node(this.new_node(KindTypePredicate, NodeData.TypePredicate(TypePredicateData(asserts_modifier, parameter_name, type_node))), pos)
    }

    ; ── templates — parser slice 11 ─────────────────────────────────────────
    ;
    ; A template literal is ONE construct with three faces, and the reference
    ; keeps them in two places for a reason worth preserving: the head, the
    ; middle/tail and the span-terminating loop are SHARED, so they sit here
    ; with the type side, while parse_template_expression and
    ; parse_tagged_template_rest sit with the expressions. Grouping all of it
    ; into one block would read better and against the reference worse.
    ;
    ; ★ What makes the family one slice is the scanner: `` `a${x}b${y}c` `` is
    ; scanned as TemplateHead, then — only because the PARSER asks — a
    ; TemplateMiddle and a TemplateTail rewound out of the `}` tokens that
    ; closed each substitution. All three of this slice's histogram tags
    ; (template-literal-type, template-expression, tagged-template) were waiting
    ; on that one entry point.

    procedure parse_template_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let head this.parse_template_head(false)
        if head = null
            return null
        let spans this.parse_template_type_spans()
        if spans = null
            return null
        this.finish_node(this.new_node(KindTemplateLiteralType, NodeData.TemplateLiteralType(TemplateLiteralData(head, spans))), pos)
    }

    ; ★ The invalid-escape re-scan here is the reference's, and — as at
    ; parse_primary_expression, which carries the account — it is REACHED: it is
    ; what re-reads the head's text with errors reported, since the scan loop
    ; suppressed them. The "UNREACHABLE, the diagnostics slice owns it" note that
    ; stood here was true before slice 13c and false after it.
    ;
    ; ★★ And the TAGGED case is the whole reason the test is nested: `` t`\u` ``
    ; is legal and reaches the tag function as raw text, so only an untagged
    ; template is re-read. That asymmetry is the reference's parameter, not a
    ; kind test at the token — see next_token_without_check.
    procedure parse_template_head(this, is_tagged_template: bool) returns pointer[AstNode]
    {
        if is_tagged_template = false
        {
            if (scanner.token_flags() & TokenFlagsIsInvalid) <> 0
            {
                this.re_scan_template_token(false)
                if this.is_unported()
                    return null
            }
        }
        let pos this.node_pos()
        let n this.new_node(KindTemplateHead, NodeData.TemplateHead(LiteralData(scanner.token_value(), scanner.token_value_length(), scanner.token_flags() & TokenFlagsTemplateLiteralLikeFlags)))
        this.next_token()
        this.finish_node(n, pos)
    }

    ; getTemplateLiteralRawText is not ported, and slice 31 SHARPENED the reason
    ; rather than removing it: the text field now exists, so the old argument
    ; ("ast.scaly stores no literal text yet") has expired — what stands is that
    ; the RAW text has no reader here at all. It is the SOURCE slice rather than
    ; the decoded value, its readers are the checker and the emitter, and no name,
    ; span or diagnostic this port produces is a function of it (§3.5be). The
    ; slice that gives it a reader adds the field beside `text`.

    procedure parse_template_type_spans(this) returns pointer[Array[pointer[AstNode]]]
    {
        let list AstNode.new_node_list(host)
        while true
        {
            let span this.parse_template_type_span()
            if span = null
                return null
            list.add(span)
            ; A Middle means another substitution follows; a Tail ends the
            ; template. There is no other way out of this loop, which is why
            ; parse_literal_of_template_span must never answer a third kind.
            if AstNode.kind_of(AstNode.template_span_literal(span)) <> KindTemplateMiddle
                break
        }
        list
    }

    procedure parse_template_type_span(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let type_node this.parse_type()
        if type_node = null
            return null
        let literal this.parse_literal_of_template_span(false)
        if literal = null
            return null
        this.finish_node(this.new_node(KindTemplateLiteralTypeSpan, NodeData.TemplateLiteralTypeSpan(TemplateSpanData(type_node, literal))), pos)
    }

    ; The seam of the whole family: the substitution's expression (or type) has
    ; just been parsed and the current token is the `}` that closes it — which
    ; is also the first character of the template's next chunk. Undo the scan
    ; and read it as a Middle or a Tail.
    ;
    ; ★ The `}` test is what keeps a substitution that is not closed by one from
    ; being re-scanned as template text: `` `x${y;z}` `` would otherwise read
    ; `;z}` as the tail and complete a tree the reference does not have. When it
    ; is absent the reference reports and synthesizes an empty TemplateTail, so
    ; the span loop still terminates.
    procedure parse_literal_of_template_span(this, is_tagged_template: bool) returns pointer[AstNode]
    {
        if token = KindCloseBraceToken
        {
            this.re_scan_template_token(is_tagged_template)
            if this.is_unported()
                return null
            return this.parse_template_middle_or_tail()
        }
        this.parse_error_at_current_token(DiagX_0_expected)
        ; A SYNTHESIZED tail — the reference builds it with TokenFlagsNone, not
        ; with the flags of whatever token is standing here.
        this.finish_node(this.new_node(KindTemplateTail, NodeData.TemplateTail(LiteralData(null, 0, TokenFlagsNone))), this.node_pos())
    }

    procedure parse_template_middle_or_tail(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let flags scanner.token_flags() & TokenFlagsTemplateLiteralLikeFlags
        let text scanner.token_value()
        let text_len scanner.token_value_length()
        var n null as pointer[AstNode]
        if token = KindTemplateMiddle
            set n: this.new_node(KindTemplateMiddle, NodeData.TemplateMiddle(LiteralData(text, text_len, flags)))
        else
            set n: this.new_node(KindTemplateTail, NodeData.TemplateTail(LiteralData(text, text_len, flags)))
        this.next_token()
        this.finish_node(n, pos)
    }

    procedure parse_jsdoc_nullable_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        let inner this.parse_type_operator_or_higher()
        if inner = null
            return null
        this.finish_node(this.new_node(KindJSDocNullableType, NodeData.JSDocNullableType(WrappedTypeData(inner))), pos)
    }

    procedure parse_jsdoc_non_nullable_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        let inner this.parse_type_operator_or_higher()
        if inner = null
            return null
        this.finish_node(this.new_node(KindJSDocNonNullableType, NodeData.JSDocNonNullableType(WrappedTypeData(inner))), pos)
    }

    ; A literal type wraps the literal EXPRESSION, so `-1` is three nodes deep:
    ; LiteralType > PrefixUnaryExpression > NumericLiteral, all three sharing
    ; the same start.
    procedure parse_literal_type_node(this, negative: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if negative
            this.next_token()

        var expression null as pointer[AstNode]
        if keyword_literal(token)
            set expression: this.parse_token_node()
        else
            set expression: this.parse_literal_expression(token)
        if expression = null
            return null

        if negative
            set expression: this.finish_node(this.new_node(KindPrefixUnaryExpression, NodeData.PrefixUnaryExpression(PrefixUnaryExpressionData(KindMinusToken, expression))), pos)

        this.finish_node(this.new_node(KindLiteralType, NodeData.LiteralType(WrappedTypeData(expression))), pos)
    }

    ; ── type references and entity names ────────────────────────────────────

    procedure parse_type_reference(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let name this.parse_entity_name_of_type_reference()
        if name = null
            return null
        let args this.parse_type_arguments_of_type_reference()
        if this.is_unported()
            return null
        this.finish_node(this.new_node(KindTypeReference, NodeData.TypeReference(TypeReferenceData(name, args))), pos)
    }

    ; parseEntityNameOfTypeReference — `parseEntityName(true, Type_expected)`.
    ;
    ; ★★★ The DIAGNOSTIC is what distinguishes it from the bare call, and this
    ; port did not carry the parameter until slice 18: `type A = ;` reported
    ; Identifier_expected (1003) where the reference says Type_expected (1110).
    ; A wrong code, not an over-report, and invisible to the corpus — it was
    ; found by a slice-18 fixture (`type B = import(;`), because a qualifier is
    ; the reference's fourth caller of this routine and the third to want the
    ; message. Two call sites take it; the other two pass none, exactly as
    ; upstream's four do.
    procedure parse_entity_name_of_type_reference(this) returns pointer[AstNode]
        this.parse_entity_name_with_diagnostic(true, DiagType_expected)

    procedure parse_entity_name(this, allow_reserved_words: bool) returns pointer[AstNode]
        this.parse_entity_name_with_diagnostic(allow_reserved_words, 0)

    procedure parse_entity_name_with_diagnostic(this, allow_reserved_words: bool, code: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var entity null as pointer[AstNode]
        if allow_reserved_words
            set entity: this.parse_identifier_name_with_diagnostic(code)
        else
            set entity: this.parse_identifier_with_diagnostic(code, 0)
        if entity = null
            return null

        while this.parse_optional(KindDotToken)
        {
            ; `a.<T>` is a JSDoc-style generic. The reference leaves the dot
            ; consumed and stops here, reporting the gap in the checker.
            if token = KindLessThanToken
                break
            let right this.parse_right_side_of_dot(allow_reserved_words, false, true)
            if right = null
                return null
            set entity: this.finish_node(this.new_node(KindQualifiedName, NodeData.QualifiedName(QualifiedNameData(entity, right))), pos)
        }
        entity
    }

    ; ★★★ `allow_unicode_escape_sequence_in_identifier_name` arrived with slice
    ; 20 and is the §3.5ar shape from the other side: the reference has carried
    ; the parameter all along, every caller before this slice passes TRUE, and
    ; the port had folded it into the `true` branch. parseJsxElementName is the
    ; one caller that passes false, and it is the whole reason
    ; `<a.\u0062>` reports 17021 upstream and reported nothing here.
    procedure parse_right_side_of_dot(this, allow_identifier_names: bool, allow_private_identifiers: bool, allow_unicode_escape_in_name: bool) returns pointer[AstNode]
    {
        ; ★ The ASI guard: `name.` at the end of a line followed by an identifier
        ; on the NEXT line is two statements, not one member access. The report
        ; goes right after the DOT rather than at the next token, and the
        ; reference says why — the next token may well be a perfectly good
        ; identifier, so pointing at it would be confusing.
        if this.has_preceding_line_break()
        {
            if token_is_identifier_or_keyword(token)
            {
                if this.look_ahead_next_token_is_identifier_or_keyword_on_same_line()
                {
                    let zero this.node_pos()
                    this.parse_error_at(zero, zero, DiagIdentifier_expected)
                    return this.create_missing_identifier()
                }
            }
        }
        ; ★ The private name is CONSUMED either way and only then refused, so the
        ; token stream advances identically and only the tree and the diagnostic
        ; differ. An entity name (`ns.#x` in a type) is the caller that says no.
        if token = KindPrivateIdentifier
        {
            let private_name this.parse_private_identifier()
            if allow_private_identifiers
                return private_name
            let zero this.node_pos()
            this.parse_error_at(zero, zero, DiagIdentifier_expected)
            return this.create_missing_identifier()
        }
        ; ★ Only the identifier-NAME branch lets an `await` count. `a.await` is a
        ; use of the name and reaches the reparse; a dotted ENTITY name in a type
        ; does not, which is why the other branch puts the flag back.
        if allow_identifier_names
        {
            if allow_unicode_escape_in_name
                return this.parse_identifier_name()
            return this.parse_identifier_name_error_on_unicode_escape_sequence()
        }
        let saved_await_identifier statement_has_await_identifier
        let id this.parse_identifier()
        set statement_has_await_identifier: saved_await_identifier
        id
    }

    ; ── type arguments ──────────────────────────────────────────────────────
    ;
    ; ★ The re-scan is what makes `Foo<<T>() => void>` parse at all: the scan
    ; merged the two `<` into one token, and only the parser knows it is reading
    ; a type. The CLOSING side needs no such thing — the scanner never merges
    ; `>`, precisely so `Array<Array<string>>` can close twice.

    procedure re_scan_less_than_token(this) returns int
    {
        set token: scanner.re_scan_less_than_token()
        token
    }

    ; The other direction, and the ladder's: the scan never merges `>`, so
    ; parseBinaryExpressionRest asks for `>=`, `>>`, `>>>`, `>>=` and `>>>=`
    ; before EVERY operator test. See the scanner's own comment for why the
    ; asymmetry is deliberate.
    procedure re_scan_greater_than_token(this) returns int
    {
        set token: scanner.re_scan_greater_than_token()
        token
    }

    ; The fourth, slice 16's: a `/` is a division sign until the parser says it
    ; is standing where an expression begins. The scanner has the whole account;
    ; what belongs here is that this wrapper needs neither of the two things its
    ; template sibling below carries — the scanner reports the one diagnostic it
    ; can produce (an unterminated literal) through the shared list since 13b,
    ; and nothing in the re-scan is unported, so there is no scanner record to
    ; raise.
    procedure re_scan_slash_token(this) returns int
    {
        set token: scanner.re_scan_slash_token()
        token
    }

    ; The third one, slice 11's: a `}` that closes a substitution is the first
    ; character of the template's next chunk, and only the parser knows that.
    ;
    ; ★★★ It carries a check its two siblings do not need, and leaving it out is
    ; a silent wrong tree rather than a missing report. next_token_without_check
    ; is where this port turns a scanner fault into an unported record — and a
    ; re-scan does not go through it, because it re-reads a token that has
    ; already been scanned. So `` `a${b}\01` `` and `` `a${b}c `` would come out
    ; of the re-scan carrying ContainsInvalidEscape and Unterminated, the
    ; reference would emit a diagnostic for each, and this port would answer a
    ; complete tree with nothing on it. The same test, applied at the same
    ; moment, is what keeps the stand-in consistent.
    procedure re_scan_template_token(this, is_tagged_template: bool) returns int
    {
        set token: scanner.re_scan_template_token(is_tagged_template)

        ; ★★ The stand-in that stood here through slice 12 is gone (13b): it
        ; tested the token flags and reported one `unported`, because the port had
        ; no diagnostics and a re-scan does not pass through
        ; next_token_without_check. The scanner now reports at the re-scan itself,
        ; and WHICH errors it reports is decided by the argument this function
        ; already had — `!is_tagged_template` is shouldEmitInvalidEscapeError, so
        ; a tagged template's raw text may hold `\u` and `\x` without a word
        ; said, while Unterminated is reported on every call. §3.5z is the account
        ; of how that asymmetry was found; the port of it is now the parameter
        ; rather than a test beside it.
        if scanner.unported_at() >= 0
        {
            if unported_pos < 0
            {
                set unported_pos: scanner.unported_at()
                set unported_tag: "scanner"
                set unported_detail: 0
            }
        }
        token
    }

    procedure parse_type_arguments_of_type_reference(this) returns pointer[Array[pointer[AstNode]]]
    {
        if this.has_preceding_line_break()
            return null
        if this.re_scan_less_than_token() <> KindLessThanToken
            return null
        this.parse_type_arguments()
    }

    procedure parse_type_arguments(this) returns pointer[Array[pointer[AstNode]]]
    {
        if token <> KindLessThanToken
            return null
        this.parse_bracketed_list(PCTypeArguments, KindLessThanToken, KindGreaterThanToken)
    }

    procedure parse_type_query(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindTypeOfKeyword)
        let entity_name this.parse_entity_name(true)
        if entity_name = null
            return null

        ; ASI, so the NEXT line's `<` cannot be read as this query's type
        ; arguments.
        var type_arguments null as pointer[Array[pointer[AstNode]]]
        if this.has_preceding_line_break() = false
        {
            set type_arguments: this.parse_type_arguments()
            if this.is_unported()
                return null
        }

        this.finish_node(this.new_node(KindTypeQuery, NodeData.TypeQuery(TypeQueryData(entity_name, type_arguments))), pos)
    }

    ; ── the import type (parser slice 18) ───────────────────────────────────
    ;
    ; `import("m")`, `typeof import("m")`, `import("m").A<T>` and
    ; `import("m", { with: { type: "json" } })`. It is the reference's
    ; parseImportType, and it is in THIS slice rather than in slice 3 with the
    ; rest of the type ladder for the reason both `import-type` sites gave: it
    ; sets a flag on the SOURCE FILE, and nothing carried one until now.
    ;
    ; ★ Everything under it already existed. parse_import_attributes has been
    ; here since slice 8 and has carried `skip_keyword` unused since then, with
    ; a comment naming THIS routine as the one true caller — a §3.5p claim with
    ; an expiry date, and this is where it expires: the `with`/`assert` keyword
    ; and its colon are read HERE, because inside `import(…)` the attribute
    ; clause is `, with: { … }` and not `with { … }`.
    procedure parse_import_type(this) returns pointer[AstNode]
    {
        set source_flags: source_flags | NodeFlagsPossiblyContainsDynamicImport
        let pos this.node_pos()
        let is_type_of this.parse_optional(KindTypeOfKeyword)
        this.parse_expected(KindImportKeyword)
        this.parse_expected(KindOpenParenToken)
        let argument this.parse_type()
        if argument = null
            return null

        var attributes null as pointer[AstNode]
        if this.parse_optional(KindCommaToken)
        {
            this.parse_expected(KindOpenBraceToken)
            ; ★ The keyword is captured BEFORE it is consumed, because it is what
            ; the ImportAttributes node stores — and the reference passes the
            ; token it FOUND, even on the arm where it found neither word: an
            ; `import("m", { oops: … })` builds an ImportAttributes whose token is
            ; whatever stood there. Transcribed rather than tidied.
            let current token
            if token = KindWithKeyword
                this.next_token()
            else
            {
                if token = KindAssertKeyword
                {
                    this.parse_error_at_current_token(DiagImport_assertions_have_been_replaced_by_import_attributes_Use_with_instead_of_assert)
                    this.next_token()
                }
                else
                    this.parse_error_at_current_token(DiagX_0_expected)
            }
            this.parse_expected(KindColonToken)
            set attributes: this.parse_import_attributes(current, true)
            if attributes = null
                return null
            this.parse_optional(KindCommaToken)
            ; The reference follows a missing `}` with RELATED INFORMATION pointing
            ; back at the `{`. Not ported, and stated rather than silent: the
            ; yardstick compares a diagnostic's code and span, so a related note
            ; is invisible to it either way — the same reading
            ; parse_import_attributes already carries for its own copy of this.
            this.parse_expected(KindCloseBraceToken)
        }
        this.parse_expected(KindCloseParenToken)

        var qualifier null as pointer[AstNode]
        if this.parse_optional(KindDotToken)
        {
            set qualifier: this.parse_entity_name_of_type_reference()
            if qualifier = null
                return null
        }
        let type_arguments this.parse_type_arguments_of_type_reference()
        if this.is_unported()
            return null

        this.finish_node(this.new_node(KindImportType, NodeData.ImportType(ImportTypeData(is_type_of, argument, attributes, qualifier, type_arguments))), pos)
    }

    ; ── tuples ──────────────────────────────────────────────────────────────

    procedure parse_tuple_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let elements this.parse_bracketed_list(PCTupleElementTypes, KindOpenBracketToken, KindCloseBracketToken)
        if elements = null
            return null
        this.finish_node(this.new_node(KindTupleType, NodeData.TupleType(TypeListData(elements))), pos)
    }

    procedure parse_tuple_element_name_or_tuple_element_type(this) returns pointer[AstNode]
    {
        if this.look_ahead_scan_start_of_named_tuple_element()
        {
            let pos this.node_pos()
            let jsdoc this.jsdoc_scanner_info()
            let dot_dot_dot_token this.parse_optional_token(KindDotDotDotToken)
            let name this.parse_identifier_name()
            if name = null
                return null
            let question_token this.parse_optional_token(KindQuestionToken)
            this.parse_expected(KindColonToken)
            let type_node this.parse_tuple_element_type()
            if type_node = null
                return null
            let result this.finish_node(this.new_node(KindNamedTupleMember, NodeData.NamedTupleMember(NamedTupleMemberData(dot_dot_dot_token, name, question_token, type_node))), pos)
            return this.with_jsdoc(result, jsdoc)
        }
        this.parse_tuple_element_type()
    }

    procedure scan_start_of_named_tuple_element(this) returns bool
    {
        if token = KindDotDotDotToken
        {
            if token_is_identifier_or_keyword(this.next_token()) = false
                return false
            return this.next_token_is_colon_or_question_colon()
        }
        if token_is_identifier_or_keyword(token) = false
            return false
        this.next_token_is_colon_or_question_colon()
    }

    procedure next_token_is_colon_or_question_colon(this) returns bool
    {
        if this.next_token() = KindColonToken
            return true
        if token <> KindQuestionToken
            return false
        this.next_token() = KindColonToken
    }

    procedure parse_tuple_element_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_optional(KindDotDotDotToken)
        {
            let rest this.parse_type()
            if rest = null
                return null
            return this.finish_node(this.new_node(KindRestType, NodeData.RestType(WrappedTypeData(rest))), pos)
        }

        let type_node this.parse_type()
        if type_node = null
            return null

        ; `[T?]`. The postfix `?` already built a JSDocNullableType, and what
        ; distinguishes the tuple's optional element from the JSDoc PREFIX form
        ; is where the node starts: a suffix `?` leaves the wrapper starting at
        ; its inner type, a prefix `?` starts one token earlier. The node is
        ; rebuilt rather than retagged, carrying flags and range over — exactly
        ; what the reference does.
        if AstNode.kind_of(type_node) <> KindJSDocNullableType
            return type_node
        let inner AstNode.child_at(type_node, 0)
        if inner = null
            return type_node
        if AstNode.pos_of(type_node) <> AstNode.pos_of(inner)
            return type_node

        let n this.new_node(KindOptionalType, NodeData.OptionalType(WrappedTypeData(inner)))
        set n.flags: type_node.flags
        set n.pos: type_node.pos
        set n.end: type_node.end
        ; ★★★ THE REFERENCE'S `typeNode.Type().Parent = node`, and this is the ONE
        ; of its four explicit re-parent sites that is not covered by our
        ; finish_node. The node above is built by a bare factory — it takes the
        ; inner type's range rather than the scanner's, so nothing finishes it —
        ; and `override_parent_in_immediate_children` runs only from finish_node.
        ; Without this line the inner type keeps the JSDocNullableType it was
        ; parsed under as its parent: a stale answer, invisible in every dump,
        ; and exactly the kind of thing the binder reads.
        ;
        ; ★ The other three sites (parser.go:609 the reparsed source file, :4766-4789
        ; the JSX restructure, :5750 unparseExpressionWithTypeArguments) are covered,
        ; because this port builds each of those nodes THROUGH finish_node where the
        ; reference uses a bare factory — so the parents are already written and the
        ; reference's own loops are what our finish_node does. Checked site by site
        ; rather than assumed.
        set inner.parent: n
        n
    }

    procedure parse_parenthesized_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindOpenParenToken)
        let inner this.parse_type()
        if inner = null
            return null
        this.parse_expected(KindCloseParenToken)
        this.finish_node(this.new_node(KindParenthesizedType, NodeData.ParenthesizedType(WrappedTypeData(inner))), pos)
    }

    ; ── type parameters ─────────────────────────────────────────────────────

    procedure parse_type_parameters(this) returns pointer[Array[pointer[AstNode]]]
    {
        if token <> KindLessThanToken
            return null
        this.parse_bracketed_list(PCTypeParameters, KindLessThanToken, KindGreaterThanToken)
    }

    procedure parse_type_parameter(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let modifiers this.parse_modifiers(false, true, false)
        if this.is_unported()
            return null
        let name this.parse_identifier()
        if name = null
            return null

        var constraint null as pointer[AstNode]
        var expression null as pointer[AstNode]
        if this.parse_optional(KindExtendsKeyword)
        {
            ; ★ A constraint written as an EXPRESSION (`<T extends "">`) is
            ; common enough that the reference recovers from it: it parses the
            ; expression into a slot of its own so that the rest of the list
            ; still reads, and lets the CHECKER say a type was needed. Note it
            ; calls parseUnaryExpressionOrHigher and not parseExpression, and the
            ; reference says why — `<T extends "">` must not consume the `>`.
            if this.is_start_of_type(false)
                set constraint: this.parse_type()
            else
            {
                if this.is_start_of_expression() = false
                    set constraint: this.parse_type()
                else
                {
                    set expression: this.parse_unary_expression_or_higher()
                    if expression = null
                        return null
                }
            }
            if constraint = null
            {
                if expression = null
                    return null
            }
        }

        var default_type null as pointer[AstNode]
        if this.parse_optional(KindEqualsToken)
        {
            set default_type: this.parse_type()
            if default_type = null
                return null
        }

        this.finish_node(this.new_node(KindTypeParameter, NodeData.TypeParameter(TypeParameterData(modifiers, name, constraint, expression, default_type))), pos)
    }

    ; ── the declaration ─────────────────────────────────────────────────────

    procedure parse_type_alias_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        this.parse_expected(KindTypeKeyword)
        ; Reported and CONTINUED, so the tree is the same and only the
        ; diagnostic differs — which is exactly the case slice 12 could not
        ; paper over and had to stop at.
        if this.has_preceding_line_break()
            this.parse_error_at_current_token(DiagLine_break_not_permitted_here)

        let name this.parse_identifier()
        if name = null
            return null
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        this.parse_expected(KindEqualsToken)

        ; `type X = intrinsic` is a keyword type; `type X = intrinsic.Y` is an
        ; ordinary reference to something named `intrinsic`.
        var type_node null as pointer[AstNode]
        if token = KindIntrinsicKeyword
        {
            if this.look_ahead_next_is_not_dot()
                set type_node: this.parse_keyword_type_node()
        }
        if type_node = null
            set type_node: this.parse_type()
        if type_node = null
            return null

        this.parse_semicolon()

        let result this.finish_node(this.new_node(KindTypeAliasDeclaration, NodeData.TypeAliasDeclaration(TypeAliasDeclarationData(modifiers, name, type_parameters, type_node))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; SIGNATURES — parser slice 4
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; parseParameters and everything that cannot exist without it. The slice was
    ; chosen off the unported histogram, and by the same DEPENDENCY argument that
    ; chose the type surface before it: `function` was the largest single entry,
    ; but the thing five of those entries are actually waiting on is the
    ; parameter list — a function declaration, a function TYPE, a constructor
    ; type, a method signature and a call signature all call parseParameters, and
    ; only one of them has the word "function" in its tag.
    ;
    ; ── What is here ────────────────────────────────────────────────────────
    ;
    ;   parseParameters / parseParametersWorker / parseParameterEx
    ;   parseNameOfParameter
    ;   parseReturnType / shouldParseReturnType / parseTypeOrTypePredicate
    ;   parseFunctionDeclaration
    ;   parseFunctionBlockOrSemicolon / parseFunctionBlock
    ;   parseFunctionOrConstructorType / parseModifiersForConstructorType
    ;
    ; ── and what is deliberately not, each with its reason ──────────────────
    ;
    ; ★ `allowAmbiguity`. parseParametersWorker takes it, and every call this
    ;   slice can reach passes TRUE — the only `false` comes from the arrow
    ;   function's speculative re-parse, which is unported. The parameter is left
    ;   out rather than carried: its arm answers a NULL parameter mid-list, which
    ;   this port's list loop reads as failure, so porting it untested would put
    ;   a wrong reading of null into the one place it cannot be noticed.
    ;
    ; ★ The ParseFlagsType arm of parseFunctionBlockOrSemicolon (a signature in a
    ;   type literal, terminated by a comma) — its callers are parseTypeMember
    ;   and the accessor, both of which are the interface-member slice.
    ;
    ; ★ checkJSSyntax, which the reference calls on every parameter and on the
    ;   function declaration. It returns immediately unless the node carries
    ;   NodeFlagsJavaScriptFile, and this port never sets that flag (the corpus is
    ;   .ts and the file name decides). So it is not skipped work — it is work
    ;   that provably does nothing here, and a port of it would be a body that
    ;   cannot be reached.

    ; ── parameters ──────────────────────────────────────────────────────────

    procedure parse_parameters(this, flags: int) returns pointer[Array[pointer[AstNode]]]
    {
        if this.parse_expected(KindOpenParenToken)
        {
            let parameters this.parse_parameters_worker(flags, true)
            if parameters = null
                return null
            this.parse_expected(KindCloseParenToken)
            return parameters
        }
        this.create_missing_list()
    }

    procedure parse_parameters_worker(this, flags: int, allow_ambiguity: bool) returns pointer[Array[pointer[AstNode]]]
    {
        ; Captured BEFORE the flags move — this is the context the parameter's
        ; decorators belong to. See the field's comment for why it travels as
        ; state rather than in a closure. `allow_ambiguity` rides along for the
        ; same reason.
        let saved_outer parameter_outer_await_context
        let saved_ambiguity parameter_allow_ambiguity
        let saved_check_js parameter_check_js
        set parameter_outer_await_context: this.in_await_context()
        set parameter_allow_ambiguity: allow_ambiguity
        set parameter_check_js: (flags & ParseFlagsType) = 0

        let saved context_flags
        this.set_context_flags(NodeFlagsYieldContext, (flags & ParseFlagsYield) <> 0)
        this.set_context_flags(NodeFlagsAwaitContext, (flags & ParseFlagsAwait) <> 0)
        let parameters this.parse_delimited_list(PCParameters)
        set context_flags: saved
        set parameter_outer_await_context: saved_outer
        set parameter_allow_ambiguity: saved_ambiguity
        set parameter_check_js: saved_check_js
        parameters
    }

    procedure parse_parameter_ex(this, in_outer_await_context: bool, allow_ambiguity: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()

        let saved context_flags
        this.set_context_flags(NodeFlagsAwaitContext, in_outer_await_context)
        let modifiers this.parse_modifiers(true, false, false)
        set context_flags: saved
        if this.is_unported()
            return null

        ; A `this` parameter. It takes no dot-dot-dot, no `?` and no initializer,
        ; and its name is built through createIdentifier directly — `this` is a
        ; reserved word, so parse_identifier would refuse it.
        if token = KindThisKeyword
        {
            let this_name this.create_identifier(true)
            if this_name = null
                return null

            var this_type null as pointer[AstNode]
            if token = KindColonToken
            {
                set this_type: this.parse_type_annotation()
                if this_type = null
                    return null
            }

            ; Reported and the node built anyway, so the tree is the same and
            ; only the diagnostic differs. ★ The span is the FIRST modifier's
            ; whole range, trivia included — the reference passes
            ; `modifiers.Nodes[0].Loc` with no skipRangeTrivia.
            if modifiers <> null
            {
                if (modifiers.get_length() as int) > 0
                {
                    let first_modifier *(modifiers.get_buffer() + 0)
                    this.parse_error_at_range(first_modifier.pos, first_modifier.end, DiagNeither_decorators_nor_modifiers_may_be_applied_to_this_parameters)
                }
            }

            let this_result this.finish_node(this.new_node(KindParameter, NodeData.Parameter(ParameterData(modifiers, null, this_name, null, this_type, null))), pos)
            return this.with_jsdoc(this_result, jsdoc)
        }

        let dot_dot_dot_token this.parse_optional_token(KindDotDotDotToken)
        if this.is_unported()
            return null

        ; ★ The speculative half of an arrow-function parse. Answering NULL here
        ; is not a failure — it is "this text is not a parameter list", and the
        ; caller rewinds. It is the only path on which a null element of a
        ; delimited list means something other than "the port stopped", which is
        ; why parse_parenthesized_arrow_function_expression is careful to
        ; distinguish the two by is_unported() rather than by the result.
        if allow_ambiguity = false
        {
            if this.is_parameter_name_start() = false
                return null
        }

        let name this.parse_name_of_parameter(modifiers)
        if name = null
            return null

        let question_token this.parse_optional_token(KindQuestionToken)
        if this.is_unported()
            return null

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }

        var initializer null as pointer[AstNode]
        if this.parse_optional(KindEqualsToken)
        {
            set initializer: this.parse_assignment_expression_or_higher()
            if initializer = null
                return null
        }

        let result this.finish_node(this.new_node(KindParameter, NodeData.Parameter(ParameterData(modifiers, dot_dot_dot_token, name, question_token, type_node, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; isParameterNameStart. The reference is deliberately permissive here —
    ; isBindingIdentifier rather than isIdentifier — because refusing `await` or
    ; `yield` during a speculative parse produces far more follow-on errors than
    ; letting the function parse and complaining later.
    function is_parameter_name_start(this) returns bool
    {
        if this.is_binding_identifier()
            return true
        if token = KindOpenBracketToken
            return true
        token = KindOpenBraceToken
    }

    procedure parse_name_of_parameter(this, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let name this.parse_identifier_or_pattern_with_diagnostic(DiagPrivate_identifiers_cannot_be_used_as_parameters)
        if name = null
            return null

        ; ★★ The recovery arm, which slice 12's comment here said "cannot be
        ; reached from here" because a MISSING name was a diagnostic and
        ; therefore unported. It is reachable now, and it is the anti-hang guard
        ; the reference wrote it as: `'use strict'` + `function foo(static)`
        ; makes isParameter("static") true through isModifier, `static` is not a
        ; legal identifier in strict mode, so the name comes back zero-width with
        ; the token unmoved and the enclosing list would spin "till the end of
        ; time (or OOM)". Advancing one token is what breaks it.
        ;
        ; ★ It is not the only guard against that spin — parse_delimited_list's
        ; own zero-progress test would also fire — but it is the one that keeps
        ; the reference's TREE, since it advances before the element is finished
        ; rather than after the list gave up on it.
        if name.end = name.pos
        {
            if modifiers = null
            {
                if is_modifier_kind(token)
                    this.next_token()
            }
        }
        name
    }

    ; ── the return type ─────────────────────────────────────────────────────

    procedure parse_return_type(this, return_token: int, is_type: bool) returns pointer[AstNode]
    {
        if this.should_parse_return_type(return_token, is_type) = false
            return null
        ; doInContext(DisallowConditionalTypes, false, parseTypeOrTypePredicate).
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowConditionalTypesContext, false)
        let result this.parse_type_or_type_predicate()
        set context_flags: saved
        result
    }

    procedure should_parse_return_type(this, return_token: int, is_type: bool) returns bool
    {
        if return_token = KindEqualsGreaterThanToken
        {
            ; ★ The result is DISCARDED and the answer is unconditionally true —
            ; the reference reports a missing `=>` and parses the return type
            ; anyway. Slice 12 read the result because parse_expected stopped;
            ; reading it now would skip the return type on the error path.
            this.parse_expected(return_token)
            return true
        }
        if this.parse_optional(KindColonToken)
            return true
        ; The reference's third arm: `is_type` and a `=>` where a `:` was meant,
        ; which it says is easy to get backwards in a type context. It reports
        ; "':' expected", consumes the arrow and parses the type anyway. Both
        ; callers in this slice pass is_type FALSE, so it stays unexercised —
        ; but it is ported rather than omitted, because a silent `false` here
        ; would send the first caller that passes true down the
        ; no-return-type path.
        if is_type
        {
            if token = KindEqualsGreaterThanToken
            {
                this.parse_error_at_current_token(DiagX_0_expected)
                this.next_token()
                return true
            }
        }
        false
    }

    ; `x is T` — a type predicate on a plain parameter name. `this is T` has its
    ; own entry point in the type parser, since `this` is not an identifier.
    procedure parse_type_or_type_predicate(this) returns pointer[AstNode]
    {
        if this.is_identifier()
        {
            let saved this.mark()
            let pos this.node_pos()
            let id this.parse_identifier()
            if id = null
                return null
            if token = KindIsKeyword
            {
                if this.has_preceding_line_break() = false
                {
                    this.next_token()
                    let t this.parse_type()
                    if t = null
                        return null
                    return this.finish_node(this.new_node(KindTypePredicate, NodeData.TypePredicate(TypePredicateData(null, id, t))), pos)
                }
            }
            this.rewind(saved)
        }
        this.parse_type()
    }

    ; ── the function declaration ────────────────────────────────────────────
    ;
    ; ★ context_flags is saved once and restored at the SINGLE exit, exactly as
    ; the reference does. Every early return between the two is an unported
    ; bail-out — each of the calls there answers null only after reporting — and
    ; the parse is over at that point, so there is nothing left to restore for.

    procedure parse_function_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        this.parse_expected(KindFunctionKeyword)

        let asterisk_token this.parse_optional_token(KindAsteriskToken)
        if this.is_unported()
            return null

        ; `export default function () {}` is the one form with no name. The
        ; reference reads ModifierFlagsDefault off the precomputed flag set; the
        ; list is asked directly here (see has_modifier).
        var want_name true
        if has_modifier(modifiers, KindDefaultKeyword)
        {
            if this.is_binding_identifier() = false
                set want_name: false
        }
        var name null as pointer[AstNode]
        if want_name
        {
            set name: this.parse_binding_identifier()
            if name = null
                return null
        }

        ; The signature flags decide the yield/await context the PARAMETERS and
        ; the BODY are parsed in, which is what makes `yield` a name in one
        ; function and a keyword in the next.
        var signature_flags ParseFlagsNone
        if asterisk_token <> null
            set signature_flags: signature_flags | ParseFlagsYield
        if has_modifier(modifiers, KindAsyncKeyword)
            set signature_flags: signature_flags | ParseFlagsAwait

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null

        let saved context_flags
        if has_modifier(modifiers, KindExportKeyword)
            this.set_context_flags(NodeFlagsAwaitContext, true)

        let parameters this.parse_parameters(signature_flags)
        if parameters = null
            return null

        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        ; NULL here is a legitimate answer — an overload signature has no body —
        ; so the test is is_unported(), not the result. Same shape as the
        ; optional type-parameter list above.
        let body this.parse_function_block_or_semicolon_ex(signature_flags, DiagX_or_expected)
        set context_flags: saved
        if this.is_unported()
            return null

        let result this.finish_node(this.new_node(KindFunctionDeclaration, NodeData.FunctionDeclaration(FunctionDeclarationData(modifiers, asterisk_token, name, type_parameters, parameters, return_type, null, body))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; Answers the body, or null for a body-less overload signature. See above.
    procedure parse_function_block_or_semicolon(this, flags: int) returns pointer[AstNode]
        this.parse_function_block_or_semicolon_ex(flags, 0)

    procedure parse_function_block_or_semicolon_ex(this, flags: int, code: int) returns pointer[AstNode]
    {
        if token <> KindOpenBraceToken
        {
            ; ★ The ParseFlagsType arm, which slice 4 left out because its only
            ; callers are the two this slice builds. A signature member is
            ; terminated by a COMMA as readily as by a semicolon, so it cannot
            ; go through can_parse_semicolon — `interface I { get a(), b: T }`
            ; would stop at the comma.
            if (flags & ParseFlagsType) <> 0
            {
                this.parse_type_member_semicolon()
                return null
            }
            if this.can_parse_semicolon()
            {
                this.parse_semicolon()
                return null
            }
        }
        this.parse_function_block_ex(flags, code)
    }

    procedure parse_function_block(this, flags: int) returns pointer[AstNode]
        this.parse_function_block_ex(flags, 0)

    procedure parse_function_block_ex(this, flags: int, code: int) returns pointer[AstNode]
    {
        let saved context_flags
        ; An `await` used as a name INSIDE a function body says nothing about the
        ; enclosing top-level statement, so the flag is put back on the way out.
        let saved_await_identifier statement_has_await_identifier
        this.set_context_flags(NodeFlagsYieldContext, (flags & ParseFlagsYield) <> 0)
        this.set_context_flags(NodeFlagsAwaitContext, (flags & ParseFlagsAwait) <> 0)
        ; A function expression or arrow function may itself be parsed in a
        ; decorator context; its BODY never is.
        this.set_context_flags(NodeFlagsDecoratorContext, false)
        let block this.parse_block_ex((flags & ParseFlagsIgnoreMissingOpenBrace) <> 0, code)
        set context_flags: saved
        set statement_has_await_identifier: saved_await_identifier
        block
    }

    ; ── the function and constructor TYPES ──────────────────────────────────

    procedure parse_function_or_constructor_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers_for_constructor_type()
        if this.is_unported()
            return null
        ; The reference asserts that modifiers imply a constructor type; the
        ; assertion holds by construction, since the only modifier accepted above
        ; is `abstract` and isStartOfFunctionOrConstructorType only admits it
        ; when `new` follows.
        let is_constructor_type this.parse_optional(KindNewKeyword)

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(ParseFlagsType)
        if parameters = null
            return null
        let return_type this.parse_return_type(KindEqualsGreaterThanToken, false)
        if return_type = null
            return null

        var result null as pointer[AstNode]
        if is_constructor_type
            set result: this.new_node(KindConstructorType, NodeData.ConstructorType(ConstructorTypeData(modifiers, type_parameters, parameters, return_type)))
        else
            set result: this.new_node(KindFunctionType, NodeData.FunctionType(FunctionTypeData(type_parameters, parameters, return_type)))

        this.with_jsdoc(this.finish_node(result, pos), jsdoc)
    }

    procedure parse_modifiers_for_constructor_type(this) returns pointer[Array[pointer[AstNode]]]
    {
        if token <> KindAbstractKeyword
            return null
        let pos this.node_pos()
        let kind token
        this.next_token()
        let m this.finish_node(this.new_node(kind, NodeData.Token(TokenData())), pos)
        if m = null
            return null
        let list AstNode.new_node_list(host)
        list.add(m)
        ; `p.newModifierList(modifier.Loc, ...)`, as above.
        this.record_list_range(list, m.pos, m.end)
        list
    }

    ; ════ CLASSES (parser slice 6) ══════════════════════════════════════════
    ;
    ; The class DECLARATION, the class EXPRESSION, the heritage clauses and the
    ; six member forms — method, property, constructor, get/set accessor, static
    ; block, index signature. Three of those entry points are shared with the
    ; object literal, which is why `{ get x() {} }` and `{ m() {} }` land with
    ; this slice too and not with the ladder that reaches them.
    ;
    ; ★ The reference's checkJSSyntax calls are omitted throughout, and the
    ; omission is total rather than partial: every one of them is guarded by
    ; NodeFlagsJavaScriptFile, which is set from the file's EXTENSION, and every
    ; case in this corpus is `.ts`. When a `.js` case first appears the guard —
    ; not the calls — is what has to be ported first, so writing the calls now
    ; would be writing code no test can reach and no reader can check.

    procedure parse_class_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
        this.parse_class_declaration_or_expression(pos, jsdoc, modifiers, KindClassDeclaration)

    ; A class expression reached through the `class` arm of the primary
    ; expression carries no modifiers, because nothing there has parsed any.
    ;
    ; ★ It is NOT true that a class expression never carries modifiers, and the
    ; comment that stood here said so until slice 12 — a §3.5p claim resting on
    ; the decorator being unported, expiring on the slice that built it. The `@`
    ; arm below reaches the same routine WITH a list.
    procedure parse_class_expression(this) returns pointer[AstNode]
        this.parse_class_declaration_or_expression(this.node_pos(), this.jsdoc_scanner_info(), null, KindClassExpression)

    ; parseDecoratedExpression — the `@` arm of the primary expression, i.e. a
    ; decorated class EXPRESSION (`(@dec class {})`, `x = @dec class C {}`).
    ;
    ; The other exit builds a MissingDeclaration and reports Expression_expected:
    ; decorators that decorate nothing, which is the same situation as
    ; parse_declaration_worker's fallthrough (modifiers with nothing behind
    ; them) and now builds the same node.
    procedure parse_decorated_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers(true, false, false)
        if this.is_unported()
            return null
        if token = KindClassKeyword
            return this.parse_class_declaration_or_expression(pos, jsdoc, modifiers, KindClassExpression)
        ; Decorators that decorate nothing: report where the expression should
        ; have been and leave a MissingDeclaration carrying them, so the walk has
        ; the modifier list it just parsed.
        let zero this.node_pos()
        this.parse_error_at(zero, zero, DiagExpression_expected)
        this.finish_node(this.new_node(KindMissingDeclaration, NodeData.MissingDeclaration(ElementListData(modifiers))), pos)
    }

    procedure parse_class_declaration_or_expression(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], kind: int) returns pointer[AstNode]
    {
        let saved context_flags
        let saved_await_identifier statement_has_await_identifier

        this.parse_expected(KindClassKeyword)

        ; The name is read BEFORE the export modifier's await context is
        ; established, and deliberately so: the reference lets `class await {}`
        ; parse and reports the grammar error in the checker.
        let name this.parse_name_of_class_declaration_or_expression()
        if this.is_unported()
            return null

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null

        if has_modifier(modifiers, KindExportKeyword)
            this.set_context_flags(NodeFlagsAwaitContext, true)

        let heritage_clauses this.parse_heritage_clauses()
        if this.is_unported()
            return null

        ; ★★★ THE `{` IS A BRANCH — see §3.5bi, which is where the sentence that
        ; used to stand here ("entering it costs nothing, because the first token
        ; is then a terminator or the recovery's business") was measured false.
        ; `var class;` enters the list and eats the `;` as a SemicolonClassElement.
        var members null as pointer[Array[pointer[AstNode]]]
        if this.parse_expected(KindOpenBraceToken)
        {
            set members: this.parse_list(PCClassMembers)
            if members = null
                return null
            this.parse_expected(KindCloseBraceToken)
        }
        else
            set members: this.create_missing_list()

        set context_flags: saved

        ; ★ An `await` used as a name inside an AMBIENT class body says nothing
        ; about the enclosing top-level statement, so the flag is put back — the
        ; same shape parse_function_block uses for a function body, and one more
        ; of the sites §3.5l names.
        if has_modifier(modifiers, KindDeclareKeyword)
            set statement_has_await_identifier: saved_await_identifier

        var result null as pointer[AstNode]
        if kind = KindClassDeclaration
            set result: this.new_node(KindClassDeclaration, NodeData.ClassDeclaration(ClassLikeData(modifiers, name, type_parameters, heritage_clauses, members)))
        else
            set result: this.new_node(KindClassExpression, NodeData.ClassExpression(ClassLikeData(modifiers, name, type_parameters, heritage_clauses, members)))

        this.with_jsdoc(this.finish_node(result, pos), jsdoc)

        ; ★★★ The one call site with a GUARD of its own, and with a second call
        ; behind it. The reference asks `result.Flags&JavaScriptFile != 0` before
        ; entering — which checkJSSyntax asks again, so the guard buys nothing on
        ; its own — because it also walks the `extends` clauses and checks each
        ; TYPE. Those are ExpressionWithTypeArguments nodes, and nothing else
        ; reaches them: parse_heritage_clause checks the CLAUSE, whose own arm is
        ; about `implements`, and the type-ARGUMENT arm is what this loop is for.
        ; `class C extends Base<T> {}` in a JavaScript file is the shape.
        if (AstNode.flags_of(result) & NodeFlagsJavaScriptFile) <> 0
        {
            this.check_js_syntax(result)
            if heritage_clauses <> null
            {
                var ci 0
                let cn heritage_clauses.get_length() as int
                while ci < cn
                {
                    let clause *(heritage_clauses.get_buffer() + ci)
                    if AstNode.heritage_clause_token_of(clause) = KindExtendsKeyword
                    {
                        let types AstNode.heritage_clause_types_of(clause)
                        if types <> null
                        {
                            var ti 0
                            let tn types.get_length() as int
                            while ti < tn
                            {
                                this.check_js_syntax(*(types.get_buffer() + ti))
                                set ti: ti + 1
                            }
                        }
                    }
                    set ci: ci + 1
                }
            }
        }
        result
    }

    ; ★ `implements` is a FUTURE RESERVED WORD, not a keyword, so `class
    ; implements {}` is genuinely ambiguous: a class NAMED `implements`, or an
    ; anonymous class whose heritage clause starts right here. Only what follows
    ; the word separates them, which is why this is a look-ahead and not a token
    ; test. A null answer is the legitimate "this class has no name".
    procedure parse_name_of_class_declaration_or_expression(this) returns pointer[AstNode]
    {
        if this.is_binding_identifier()
        {
            if this.is_implements_clause() = false
            {
                ; create_identifier records `await` used as a name; a class NAME
                ; is a declaration rather than a use, so the record is put back.
                let saved_await_identifier statement_has_await_identifier
                let id this.create_identifier(true)
                set statement_has_await_identifier: saved_await_identifier
                return id
            }
        }
        null
    }

    procedure is_implements_clause(this) returns bool
    {
        if token <> KindImplementsKeyword
            return false
        this.look_ahead_next_token_is_identifier_or_keyword()
    }

    ; ── the heritage clauses ────────────────────────────────────────────────

    procedure parse_heritage_clauses(this) returns pointer[Array[pointer[AstNode]]]
    {
        if this.is_heritage_clause() = false
            return null
        this.parse_list(PCHeritageClauses)
    }

    function is_heritage_clause(this) returns bool
    {
        if token = KindExtendsKeyword
            return true
        token = KindImplementsKeyword
    }

    procedure parse_heritage_clause(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        ; The keyword is a FIELD of the clause, not a child — see the record.
        let clause_token token
        this.next_token()
        let types this.parse_delimited_list(PCHeritageClauseElement)
        if types = null
            return null
        this.check_js_syntax(this.finish_node(this.new_node(KindHeritageClause, NodeData.HeritageClause(HeritageClauseData(clause_token, types))), pos))
    }

    procedure parse_expression_with_type_arguments(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let expression this.parse_left_hand_side_expression_or_higher()
        if expression = null
            return null
        ; The ladder already folds `Base<T>` into an ExpressionWithTypeArguments
        ; on its way up; the reference hands that back rather than wrapping it a
        ; second time.
        if AstNode.kind_of(expression) = KindExpressionWithTypeArguments
            return expression
        let type_arguments this.parse_type_arguments()
        if this.is_unported()
            return null
        this.finish_node(this.new_node(KindExpressionWithTypeArguments, NodeData.ExpressionWithTypeArguments(ExpressionWithTypeArgumentsData(expression, type_arguments))), pos)
    }

    ; `extends` / `implements` followed by something that can START an
    ; expression is a NEW clause, not an element of the one being read — which
    ; is what stops `extends A implements B` from parsing `implements` as a base
    ; type named `implements`.
    procedure is_heritage_clause_extends_or_implements_keyword(this) returns bool
    {
        if this.is_heritage_clause() = false
            return false
        this.look_ahead_next_is_start_of_expression()
    }

    procedure next_is_start_of_expression(this) returns bool
    {
        this.next_token()
        this.is_start_of_expression()
    }

    procedure look_ahead_next_is_start_of_expression(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_start_of_expression()
        this.rewind(saved)
        r
    }

    ; `extends {}` — an object TYPE would be a strange base, so the reference
    ; only takes it as one when what follows says the class body has not started
    ; yet.
    procedure is_valid_heritage_clause_object_literal(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_valid_heritage_clause_object_literal()
        this.rewind(saved)
        r
    }

    procedure next_is_valid_heritage_clause_object_literal(this) returns bool
    {
        this.next_token()
        if token <> KindCloseBraceToken
            return true
        this.next_token()
        if token = KindCommaToken
            return true
        if token = KindOpenBraceToken
            return true
        if token = KindExtendsKeyword
            return true
        token = KindImplementsKeyword
    }

    ; ── the class members ───────────────────────────────────────────────────

    procedure parse_class_element(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()

        ; A stray `;` between members is an element in its own right — ES6 says
        ; so — and it carries nothing but its kind, which is why it is a Token
        ; node (see the ast header).
        if token = KindSemicolonToken
        {
            this.next_token()
            let semi this.finish_node(this.new_node(KindSemicolonClassElement, NodeData.Token(TokenData())), pos)
            return this.with_jsdoc(semi, jsdoc)
        }

        let modifiers this.parse_modifiers(true, true, true)
        if this.is_unported()
            return null

        ; `static { … }` — the static initialization block. try_parse_modifier
        ; refuses to consume `static` in front of a `{` for exactly this test,
        ; which is what its stop_on_start_of_class_static_block flag is.
        if token = KindStaticKeyword
        {
            if this.look_ahead_next_token_is_open_brace()
                return this.parse_class_static_block_declaration(pos, jsdoc, modifiers)
        }

        if this.parse_contextual_modifier(KindGetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindGetAccessor, ParseFlagsNone)
        if this.parse_contextual_modifier(KindSetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindSetAccessor, ParseFlagsNone)

        var maybe_constructor false
        if token = KindConstructorKeyword
            set maybe_constructor: true
        if token = KindStringLiteral
            set maybe_constructor: true
        if maybe_constructor
        {
            let ctor this.try_parse_constructor_declaration(pos, jsdoc, modifiers)
            if ctor <> null
                return ctor
            if this.is_unported()
                return null
        }

        ; ★ Asked AFTER the constructor attempt and BEFORE the name, because `[`
        ; starts an index signature AND a computed property name and only the
        ; look-ahead separates them. The reference notes the ordering at this
        ; exact line; it is not incidental.
        if this.is_index_signature()
            return this.check_js_syntax(this.parse_index_signature_declaration(pos, jsdoc, modifiers))
        if this.is_unported()
            return null

        if class_element_name_start(token)
        {
            ; `declare` makes the member ambient, and the flag reaches the
            ; modifier NODES too — they were finished before the context flag was
            ; set. Same shape as parse_declaration's.
            if has_modifier(modifiers, KindDeclareKeyword)
            {
                let len modifiers.get_length() as int
                var i 0
                while i < len
                {
                    let m *(modifiers.get_buffer() + i)
                    set m.flags: m.flags | NodeFlagsAmbient
                    set i: i + 1
                }
                let saved context_flags
                set context_flags: context_flags | NodeFlagsAmbient
                let ambient this.parse_property_or_method_declaration(pos, jsdoc, modifiers)
                set context_flags: saved
                return ambient
            }
            return this.parse_property_or_method_declaration(pos, jsdoc, modifiers)
        }

        ; Two reference arms. With modifiers it reports Declaration_expected and
        ; treats this as a PROPERTY declaration whose name is missing; with none
        ; it PANICS, because isListElement promised a member starts here — and a
        ; panic is not something to reproduce, so that half stays an unported
        ; report.
        if modifiers = null
            return this.unported("class-element", token)
        let zero this.node_pos()
        this.parse_error_at(zero, zero, DiagDeclaration_expected)
        let missing_name this.create_missing_identifier()
        if missing_name = null
            return null
        this.parse_property_declaration(pos, jsdoc, modifiers, missing_name, null)
    }

    ; The token kinds parseClassElement will take as the start of a property or
    ; method NAME. Written as a function for the reason the header gives: a run
    ; of tests nests no planner levels where a chain nests one per arm.
    function class_element_name_start(k: int) returns bool
    {
        ; Identifiers, every keyword and the private `#name` all sit above
        ; KindIdentifier in one contiguous run.
        if token_is_identifier_or_keyword(k)
            return true
        if k = KindStringLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindAsteriskToken
            return true
        k = KindOpenBracketToken
    }

    ; ast.IsClassMemberModifier — the accessibility modifiers plus `readonly`,
    ; `override`, `static` and `accessor`. ★ NOT the same list as
    ; class_member_start_token far above, which is isStartOfStatement's arm set:
    ; that one asks "could this word begin a class member", this one asks "is
    ; this word one a class member may carry", and `override` is in exactly one
    ; of the two.
    function is_class_member_modifier(k: int) returns bool
    {
        if k = KindPublicKeyword
            return true
        if k = KindPrivateKeyword
            return true
        if k = KindProtectedKeyword
            return true
        if k = KindReadonlyKeyword
            return true
        if k = KindOverrideKeyword
            return true
        if k = KindStaticKeyword
            return true
        k = KindAccessorKeyword
    }

    procedure look_ahead_scan_class_member_start(this) returns bool
    {
        let saved this.mark()
        let r this.scan_class_member_start()
        this.rewind(saved)
        r
    }

    ; isListElement(PCClassMembers). It walks the modifiers and then asks what
    ; follows, because a word like `public` is both a modifier and a legal
    ; member NAME — `class C { public }` declares a field called `public`.
    procedure scan_class_member_start(this) returns bool
    {
        var id_token KindUnknown

        ; A decorator can only be starting a member.
        if token = KindAtToken
            return true

        ; Eat the modifiers, holding on to the LAST one in case it turns out to
        ; be the name.
        while is_modifier_kind(token)
        {
            set id_token: token
            ; A modifier only a class MEMBER can carry settles it, whatever
            ; follows — which is what gives the reference a good error for
            ; `export public …`.
            if is_class_member_modifier(id_token)
                return true
            this.next_token()
        }

        if token = KindAsteriskToken
            return true

        ; The first property-like token after the modifiers, if there is one.
        if this.is_literal_property_name()
        {
            set id_token: token
            this.next_token()
        }

        ; An index signature and a computed property name both start here, and
        ; both are members.
        if token = KindOpenBracketToken
            return true

        if id_token = KindUnknown
            return false

        ; A non-keyword name is a member outright, and so are the two accessor
        ; words.
        if is_keyword(id_token) = false
            return true
        if id_token = KindGetKeyword
            return true
        if id_token = KindSetKeyword
            return true

        ; A keyword used as a name only counts if what follows can only continue
        ; a member: a parameter list, a type argument list, `!`, `:`, `=` or `?`.
        if token = KindOpenParenToken
            return true
        if token = KindLessThanToken
            return true
        if token = KindExclamationToken
            return true
        if token = KindColonToken
            return true
        if token = KindEqualsToken
            return true
        if token = KindQuestionToken
            return true

        ; ... or a semicolon, a `}`, end-of-file, or a line break that inserts
        ; one — all of which end a declaration.
        this.can_parse_semicolon()
    }

    procedure parse_class_static_block_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        ; ★ The `static` token node is BUILT AND DISCARDED by the reference, so
        ; it is neither a modifier nor a child — a static block's only children
        ; are its modifiers and its body.
        if this.parse_expected_token(KindStaticKeyword) = null
            return null
        let body this.parse_class_static_block_body()
        if body = null
            return null
        let result this.finish_node(this.new_node(KindClassStaticBlockDeclaration, NodeData.ClassStaticBlockDeclaration(ClassStaticBlockDeclarationData(modifiers, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; A static block is always an await context and never a yield context,
    ; whatever encloses it.
    procedure parse_class_static_block_body(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsYieldContext, false)
        this.set_context_flags(NodeFlagsAwaitContext, true)
        let body this.parse_block()
        set context_flags: saved
        body
    }

    ; ★ The mark/rewind is for the STRING form ALONE. A bare `constructor`
    ; keyword commits outright — `class C { constructor = 1 }` really is parsed
    ; as a constructor upstream, with a synthesized empty body and two
    ; diagnostics, which is why this port reports it rather than falling back to
    ; a property. What the speculation exists for is `class C { "other"() {} }`,
    ; where the string is a member NAME and nothing may have been consumed.
    procedure try_parse_constructor_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let saved this.mark()

        var is_constructor false
        if token = KindConstructorKeyword
            set is_constructor: true
        if token = KindStringLiteral
        {
            ; The reference's `p.scanner.TokenValue() == "constructor"`. Slice 17
            ; gave the scanner the decoded value, so this is now the reference's
            ; own test rather than a comparison against the SOURCE text — which
            ; was the port's stand-in and could not answer `"\constructor"`, a
            ; spelling that really does decode to `constructor` because an
            ; unrecognized escape yields the character itself.
            if scanner.token_value_equals("constructor")
            {
                if this.look_ahead_next_token_is_open_paren()
                    set is_constructor: true
            }
        }

        if is_constructor = false
        {
            this.rewind(saved)
            return null
        }

        this.next_token()
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(ParseFlagsNone)
        if parameters = null
            return null

        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        ; Null is a legitimate answer — an overload signature has no body — so
        ; the test is is_unported(), not the result (§3.5h).
        let body this.parse_function_block_or_semicolon_ex(ParseFlagsNone, DiagX_or_expected)
        if this.is_unported()
            return null

        let result this.finish_node(this.new_node(KindConstructor, NodeData.ConstructorDeclaration(ConstructorDeclarationData(modifiers, type_parameters, parameters, return_type, null, body))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    procedure parse_property_or_method_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let asterisk_token this.parse_optional_token(KindAsteriskToken)
        if this.is_unported()
            return null
        let name this.parse_property_name()
        if name = null
            return null
        ; Not legal by the grammar; the reference parses it anyway and reports it
        ; in the grammar checker.
        let question_token this.parse_optional_token(KindQuestionToken)
        if this.is_unported()
            return null

        var is_method false
        if asterisk_token <> null
            set is_method: true
        if token = KindOpenParenToken
            set is_method: true
        if token = KindLessThanToken
            set is_method: true
        if is_method
            return this.parse_method_declaration(pos, jsdoc, modifiers, asterisk_token, name, question_token, DiagX_or_expected)

        this.parse_property_declaration(pos, jsdoc, modifiers, name, question_token)
    }

    ; Shared with the object literal — `{ *gen() {} }` and `class C { *gen() {} }`
    ; build the same node through the same path.
    ; ★ `code` is the reference's diagnosticMessage, and its two callers differ:
    ; a CLASS member passes "'{' or ';' expected" (1144) while an OBJECT LITERAL
    ; method passes nil and takes parse_block's generic "'{' expected". Same
    ; routine, two messages, and only the class one is reachable without a body.
    procedure parse_method_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], asterisk_token: pointer[AstNode], name: pointer[AstNode], postfix_token: pointer[AstNode], code: int) returns pointer[AstNode]
    {
        var signature_flags ParseFlagsNone
        if asterisk_token <> null
            set signature_flags: signature_flags | ParseFlagsYield
        if has_modifier(modifiers, KindAsyncKeyword)
            set signature_flags: signature_flags | ParseFlagsAwait

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(signature_flags)
        if parameters = null
            return null

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_return_type(KindColonToken, false)
            if type_node = null
                return null
        }

        let body this.parse_function_block_or_semicolon_ex(signature_flags, code)
        if this.is_unported()
            return null

        let result this.finish_node(this.new_node(KindMethodDeclaration, NodeData.MethodDeclaration(MethodDeclarationData(modifiers, asterisk_token, name, postfix_token, type_parameters, parameters, type_node, null, body))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    procedure parse_property_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], name: pointer[AstNode], question_token: pointer[AstNode]) returns pointer[AstNode]
    {
        ; ONE postfix slot holds either the `?` or the `!`, never both — and the
        ; `!` is refused across a line break, which is what keeps `x` NL `!y`
        ; from becoming a definite-assignment assertion.
        var postfix_token question_token
        if postfix_token = null
        {
            if this.has_preceding_line_break() = false
            {
                set postfix_token: this.parse_optional_token(KindExclamationToken)
                if this.is_unported()
                    return null
            }
        }

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }

        ; The initializer is parsed outside yield, await and DisallowIn — a class
        ; body's field initializer is its own scope for all three.
        let saved context_flags
        this.set_context_flags(NodeFlagsYieldContext, false)
        this.set_context_flags(NodeFlagsAwaitContext, false)
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let initializer this.parse_initializer()
        set context_flags: saved
        if this.is_unported()
            return null

        this.parse_semicolon_after_property_name(name, type_node, initializer)

        let result this.finish_node(this.new_node(KindPropertyDeclaration, NodeData.PropertyDeclaration(PropertyDeclarationData(modifiers, name, postfix_token, type_node, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; parseSemicolonAfterPropertyName — FIVE diagnostics for one missing
    ; semicolon, and which one you get says what the parser thinks you meant.
    ; Slice 12 stopped at all of them, so `name` and `initializer` were not
    ; carried; they are what CHOOSES the message, so they are carried now.
    ;
    ; The `(` arm CONSUMES the token and the `@` arm does not — a decorator
    ; after the name is a misplacement the enclosing member list can still
    ; recover from, while a call in a type annotation is not.
    procedure parse_semicolon_after_property_name(this, name: pointer[AstNode], type_node: pointer[AstNode], initializer: pointer[AstNode]) returns bool
    {
        if token = KindAtToken
        {
            if this.has_preceding_line_break() = false
            {
                this.parse_error_at_current_token(DiagDecorators_must_precede_the_name_and_all_keywords_of_property_declarations)
                return true
            }
        }
        if token = KindOpenParenToken
        {
            this.parse_error_at_current_token(DiagCannot_start_a_function_call_in_a_type_annotation)
            this.next_token()
            return true
        }
        if type_node <> null
        {
            if this.can_parse_semicolon() = false
            {
                if initializer <> null
                    this.parse_error_at_current_token(DiagX_0_expected)
                else
                    this.parse_error_at_current_token(DiagExpected_for_property_initializer)
                return true
            }
        }
        if this.try_parse_semicolon()
            return true
        if initializer <> null
        {
            this.parse_error_at_current_token(DiagX_0_expected)
            return true
        }
        this.parse_error_for_missing_semicolon_after(name)
    }

    ; parseErrorForMissingSemicolonAfter — the message that guesses what the
    ; user was writing. It is the one site in the parser that needs an
    ; IDENTIFIER'S TEXT, which ast.scaly deliberately does not store (see
    ; CLAUDE.md 3.5q), so the text is read back out of the SOURCE: a node's
    ; range is [pos, end) with pos the full start, and skipping its trivia
    ; gives exactly the token's own bytes.
    ;
    ; That is not quite the reference's node.Text(), which is the scanner's
    ; DECODED token value: an escaped spelling reads as "type" upstream and as
    ; its raw eleven bytes here, so an escaped keyword written where a
    ; semicolon was missing takes the generic arm instead of its own. Recorded
    ; rather than worked around: the field that would fix it is the one 3.5q
    ; defers, and the shape needs an escape AND a missing semicolon.
    procedure parse_error_for_missing_semicolon_after(this, node: pointer[AstNode]) returns bool
    {
        if node = null
        {
            this.parse_error_at_current_token(DiagX_0_expected)
            return true
        }

        ; A tagged TEMPLATE gets a message of its own, because that is what
        ; `module ` + backtick-M1-backtick + ` {` parses as: `module` tagging a
        ; template. The span is the TEMPLATE's, not the whole expression's.
        if node.kind = KindTaggedTemplateExpression
        {
            choose node.data
                when tt: TaggedTemplateExpression
                {
                    if tt.template <> null
                        this.parse_error_at_range(this.skip_range_trivia_pos(tt.template.pos), tt.template.end, DiagModule_declaration_names_may_only_use_or_quoted_strings)
                }
            return true
        }

        ; Anything that is not a bare identifier has no text to guess from —
        ; the reference's `expressionText` stays empty for every other kind.
        if node.kind <> KindIdentifier
        {
            this.parse_error_at_current_token(DiagX_0_expected)
            return true
        }

        ; ★★★ The reference's `expressionText = node.Text()`, and since slice 17
        ; that is what this reads. It used to read the bytes back out of the
        ; SOURCE, which is the same string for every identifier without an
        ; escape and a different one for `\u0063onstx` — so an escaped spelling
        ; took the generic arm where the reference takes the keyword's own, and
        ; the diagnostic came out 1434 where the reference says 1435. That
        ; residue is what the stored text closes.
        var text null as pointer[char]
        var text_len 0
        choose node.data
            when id: Identifier
            {
                set text: id.text
                set text_len: id.text_len
            }

        ; The SPAN is still the source's: a diagnostic points at what was
        ; written, not at what it decodes to.
        let text_pos this.skip_range_trivia_pos(node.pos)
        if text_len = 0
        {
            ; A MISSING identifier — empty text, the reference's
            ; `expressionText == ""`.
            this.parse_error_at_current_token(DiagX_0_expected)
            return true
        }

        ; Some known keywords are likely signs of syntax being used improperly.
        if text_matches(text, text_len, "const")
        {
            this.parse_error_at(text_pos, node.end, DiagVariable_declaration_not_allowed_at_this_location)
            return true
        }
        if text_matches(text, text_len, "let")
        {
            this.parse_error_at(text_pos, node.end, DiagVariable_declaration_not_allowed_at_this_location)
            return true
        }
        if text_matches(text, text_len, "var")
        {
            this.parse_error_at(text_pos, node.end, DiagVariable_declaration_not_allowed_at_this_location)
            return true
        }
        ; `declare` says nothing: a declared node that failed to parse has
        ; already emitted a diagnostic of its own.
        if text_matches(text, text_len, "declare")
            return true
        if text_matches(text, text_len, "interface")
        {
            this.parse_error_for_invalid_name(DiagInterface_name_cannot_be_0, DiagInterface_must_be_given_a_name, KindOpenBraceToken)
            return true
        }
        if text_matches(text, text_len, "is")
        {
            ; The end is the CURRENT token's start, not the node's — the span
            ; covers the predicate that was written where it may not be.
            this.parse_error_at(text_pos, scanner.token_start(), DiagA_type_predicate_is_only_allowed_in_return_type_position_for_functions_and_methods)
            return true
        }
        if text_matches(text, text_len, "module")
        {
            this.parse_error_for_invalid_name(DiagNamespace_name_cannot_be_0, DiagNamespace_must_be_given_a_name, KindOpenBraceToken)
            return true
        }
        if text_matches(text, text_len, "namespace")
        {
            this.parse_error_for_invalid_name(DiagNamespace_name_cannot_be_0, DiagNamespace_must_be_given_a_name, KindOpenBraceToken)
            return true
        }
        if text_matches(text, text_len, "type")
        {
            this.parse_error_for_invalid_name(DiagType_alias_name_cannot_be_0, DiagType_alias_must_be_given_a_name, KindEqualsToken)
            return true
        }

        ; The user may instead have misspelled a keyword, or forgotten the space
        ; after one. Both answers are a SUGGESTION, and the message that carries
        ; one is a different CODE from the one that does not — so this is not a
        ; message-argument question the yardstick could ignore.
        if this.has_keyword_suggestion(text, text_len)
        {
            this.parse_error_at(text_pos, node.end, DiagUnknown_keyword_or_identifier_Did_you_mean_0)
            return true
        }
        ; An unknown TOKEN has its own diagnostic from the scanner.
        if token = KindUnknown
            return true
        this.parse_error_at(text_pos, node.end, DiagUnexpected_keyword_or_identifier)
        true
    }

    ; parseErrorForInvalidName — `interface {` has a BLANK name and `interface 1`
    ; a bad one, and the two get different messages. The bad-name message takes
    ; the offending token's text as its argument, which is not compared.
    procedure parse_error_for_invalid_name(this, name_code: int, blank_code: int, token_if_blank_name: int)
    {
        if token = token_if_blank_name
            this.parse_error_at_current_token(blank_code)
        else
            this.parse_error_at_current_token(name_code)
    }

    ; ── the keyword spell-checker ───────────────────────────────────────────
    ;
    ; core.GetSpellingSuggestion plus parser.getSpaceSuggestion. It is ported
    ; rather than skipped because the two of them choose a CODE and not just a
    ; message argument: with a suggestion the diagnostic is
    ; Unknown_keyword_or_identifier_Did_you_mean_0 (1435), without one it is
    ; Unexpected_keyword_or_identifier (1434). Leaving it out would emit 1434
    ; where the reference emits 1435, which is a wrong answer rather than an
    ; over-report — the one direction this harness exists to prevent.
    ;
    ; Only WHETHER there is a suggestion is computed, never WHICH — the
    ; suggestion itself is a message argument and the dump does not carry one.
    ; That is not a shortcut so much as the reason the rest of the reference's
    ; machinery can be left out: the shrinking `bestDistance` and the
    ; lexicographic tie-break exist to SELECT among candidates, and both are
    ; invisible to a boolean. The equivalence is exact rather than approximate —
    ; bestDistance only ever shrinks, so a candidate that clears the INITIAL
    ; threshold clears the running one at the moment it is tested, and a
    ; candidate that clears none clears neither.
    function has_keyword_suggestion(this, text: pointer[char], text_len: int) returns bool
    {
        if this.has_spelling_suggestion(text, text_len)
            return true
        this.has_space_suggestion(text, text_len)
    }

    ; The reference compares Go strings; here a name is a pointer and a length
    ; and a keyword is a C literal, so the comparison is spelled out. It is the
    ; scanner's old `text_equals` asked of an arbitrary buffer rather than of
    ; the source — which is the whole of what slice 17 changed about this
    ; family, and why that one is gone with the source reads it served.
    function text_matches(text: pointer[char], text_len: int, word: pointer[const_char]) returns bool
    {
        var i: int 0
        while i < text_len
        {
            let w *(word + i) as int
            if w = 0
                return false
            if (*(text + i) as int) <> w
                return false
            set i: i + 1
        }
        (*(word + i) as int) = 0
    }

    ; ... and the same question about a PREFIX, which is what getSpaceSuggestion
    ; asks: does the name BEGIN with this keyword.
    function text_starts_with(text: pointer[char], text_len: int, word: pointer[const_char], word_len: int) returns bool
    {
        if word_len > text_len
            return false
        var i: int 0
        while i < word_len
        {
            if (*(text + i) as int) <> (*(word + i) as int)
                return false
            set i: i + 1
        }
        true
    }

    ; getSpaceSuggestion — the identifier begins with a keyword and is more than
    ; two characters longer than it, so the user probably left out a space.
    ; The reference measures in BYTES on both sides, and so does this.
    function has_space_suggestion(this, text: pointer[char], text_len: int) returns bool
    {
        var i 0
        while i < KEYWORD_SUGGESTION_COUNT
        {
            let kl viable_keyword_suggestion_length(i)
            if text_len > (kl + 2)
            {
                if text_starts_with(text, text_len, viable_keyword_suggestion(i), kl)
                    return true
            }
            set i: i + 1
        }
        false
    }

    function has_spelling_suggestion(this, text: pointer[char], text_len: int) returns bool
    {
        ; The name as CODE POINTS — the reference's `[]rune(name)`, and the
        ; distinction is load-bearing twice over: the distance is computed per
        ; character, while the LENGTH FILTER compares a rune count against a
        ; candidate's BYTE length, because Go's `len` means different things on
        ; the two sides. Ported as written.
        ;
        ; The buffer is bounded by the answer rather than by a guess: a candidate
        ; is at most eleven characters, and at seventeen runes the length filter
        ; (max(2, int(n*0.34)) = 5) already rejects every one of them, so a
        ; longer name has no suggestion without looking.
        var name int[20]
        var name_len 0
        var p 0
        while p < text_len
        {
            if name_len >= 17
                return false
            set name[name_len]: scanner.utf8_decode_in(text, text_len, p)
            set name_len: name_len + 1
            set p: p + scanner.utf8_size_in(text, text_len, p)
        }
        if name_len = 0
            return false

        var maximum_length_difference 2
        let scaled (((name_len as double) * 0.34) as int)
        if scaled > 2
            set maximum_length_difference: scaled
        let best_distance ((((name_len as double) * 0.4) as int) as double) + 0.9

        var ci 0
        while ci < KEYWORD_SUGGESTION_COUNT
        {
            let cand viable_keyword_suggestion(ci)
            let cand_len viable_keyword_suggestion_length(ci)
            var max_len cand_len
            if name_len > max_len
                set max_len: name_len
            var min_len cand_len
            if name_len < min_len
                set min_len: name_len
            if (max_len - min_len) <= maximum_length_difference
            {
                ; A candidate identical to the name is not a suggestion. The
                ; reference's next guard — candidates under three characters are
                ; only considered when they differ by CASE — cannot fire, because
                ; GetViableKeywordSuggestions filters those out at the source.
                if name_matches_ascii(&name[0], name_len, cand, cand_len) = false
                {
                    if levenshtein_with_max(&name[0], name_len, cand, cand_len, best_distance) >= 0.0
                        return true
                }
            }
            set ci: ci + 1
        }
        false
    }

    function name_matches_ascii(name: pointer[int], name_len: int, cand: pointer[const_char], cand_len: int) returns bool
    {
        if name_len <> cand_len
            return false
        var i 0
        while i < name_len
        {
            if *(name + i) <> (*(cand + i) as int)
                return false
            set i: i + 1
        }
        true
    }

    ; core.levenshteinWithMax, ported with its weights intact: a substitution
    ; between two characters that differ only by CASE costs 0.1, any other
    ; substitution costs 2, and an insertion or deletion costs 1. Answers -1
    ; where the reference answers "undefined" — the whole column exceeded the
    ; budget, so no later column can rescue it.
    ;
    ; The two row buffers are stack arrays swapped by POINTER, which is the
    ; reference's `previous, current = current, previous`. Sized for the longest
    ; candidate plus one; the candidate set is the keyword table, whose longest
    ; entry is eleven characters.
    function levenshtein_with_max(s1: pointer[int], n1: int, s2: pointer[const_char], n2: int, max_value: double) returns double
    {
        var buf_a double[16]
        var buf_b double[16]
        var previous: pointer[double] &buf_a[0]
        var current: pointer[double] &buf_b[0]
        let big max_value + 0.01

        var k 0
        while k <= n2
        {
            set *(previous + k): k as double
            set k: k + 1
        }

        var i 1
        while i <= n1
        {
            let c1 *(s1 + (i - 1))
            var min_j ceil_to_int((i as double) - max_value)
            if min_j < 1
                set min_j: 1
            var max_j floor_to_int(max_value + (i as double))
            if max_j > n2
                set max_j: n2
            var col_min i as double
            set *(current + 0): col_min

            var j 1
            while j < min_j
            {
                set *(current + j): big
                set j: j + 1
            }
            set j: min_j
            while j <= max_j
            {
                let c2 *(s2 + (j - 1)) as int
                var substitution_distance *(previous + (j - 1)) + 2.0
                if ascii_to_lower(c1) = ascii_to_lower(c2)
                    set substitution_distance: *(previous + (j - 1)) + 0.1
                var dist *(previous + (j - 1))
                if c1 <> c2
                {
                    set dist: *(previous + j) + 1.0
                    let insert *(current + (j - 1)) + 1.0
                    if insert < dist
                        set dist: insert
                    if substitution_distance < dist
                        set dist: substitution_distance
                }
                set *(current + j): dist
                if dist < col_min
                    set col_min: dist
                set j: j + 1
            }
            set j: max_j + 1
            while j <= n2
            {
                set *(current + j): big
                set j: j + 1
            }

            ; Everything in this column is over budget and columns only grow.
            if col_min > max_value
                return 0.0 - 1.0

            let t previous
            set previous: current
            set current: t
            set i: i + 1
        }

        let res *(previous + n2)
        if res > max_value
            return 0.0 - 1.0
        res
    }

    ; unicode.ToLower, ASCII only. Every candidate is an all-lowercase ASCII
    ; keyword, so a fold can only matter when a character of the NAME lowercases
    ; INTO an ASCII letter — and U+212A KELVIN SIGN is the only code point in
    ; Unicode that does. That one character is where this differs from the
    ; reference, and it differs by making one substitution cost 2 instead of 0.1.
    function ascii_to_lower(c: int) returns int
    {
        if c >= ("A" as char) as int
        {
            if c <= ("Z" as char) as int
                return c + 32
        }
        c
    }

    ; math.Ceil / math.Floor, to int. A cast TRUNCATES toward zero, which is
    ; floor for a non-negative value and ceil for a negative one — and both call
    ; sites can be negative, so neither is a cast on its own.
    function ceil_to_int(x: double) returns int
    {
        let t (x as int)
        if (t as double) < x
            return t + 1
        t
    }

    function floor_to_int(x: double) returns int
    {
        let t (x as int)
        if (t as double) > x
            return t - 1
        t
    }

    procedure parse_initializer(this) returns pointer[AstNode]
    {
        if this.parse_optional(KindEqualsToken) = false
            return null
        this.parse_assignment_expression_or_higher()
    }

    ; Shared with the object literal, exactly as parse_method_declaration is.
    ; `flags` is ParseFlagsNone at every call site this port has; the reference
    ; passes ParseFlagsType from the interface-member slice, which is why the
    ; parameter is here rather than inlined.
    procedure parse_accessor_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], kind: int, flags: int) returns pointer[AstNode]
    {
        let name this.parse_property_name()
        if name = null
            return null
        ; A getter with type parameters, or a setter with a return type, is a
        ; grammar error the CHECKER reports — both are parsed here, and keeping
        ; them is what lets it.
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(ParseFlagsNone)
        if parameters = null
            return null

        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        let body this.parse_function_block_or_semicolon(flags)
        if this.is_unported()
            return null

        var result null as pointer[AstNode]
        if kind = KindGetAccessor
            set result: this.new_node(KindGetAccessor, NodeData.GetAccessorDeclaration(AccessorDeclarationData(modifiers, name, type_parameters, parameters, return_type, null, body)))
        else
            set result: this.new_node(KindSetAccessor, NodeData.SetAccessorDeclaration(AccessorDeclarationData(modifiers, name, type_parameters, parameters, return_type, null, body)))

        this.with_jsdoc(this.finish_node(result, pos), jsdoc)

        ; ★ Guarded by `flags&ParseFlagsType == 0`, i.e. an accessor in a class
        ; body is checked and one in a TYPE is not — the same guard the parameter
        ; list carries, and for the same reason: a type's accessors and parameters
        ; are TypeScript syntax by construction, and the file's own JS-ness is not
        ; what decides whether they may be there.
        if (flags & ParseFlagsType) = 0
            this.check_js_syntax(result)
        result
    }

    ; ── the index signature ─────────────────────────────────────────────────

    procedure is_index_signature(this) returns bool
    {
        if token <> KindOpenBracketToken
            return false
        this.look_ahead_next_is_unambiguously_index_signature()
    }

    procedure look_ahead_next_is_unambiguously_index_signature(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_unambiguously_index_signature()
        this.rewind(saved)
        r
    }

    ; The only WELL-FORMED sequence is `[id:`; everything else this admits is
    ; the reference's error recovery, ported because the answer decides which
    ; production is entered and a narrower one would route a broken index
    ; signature into a computed property name.
    procedure next_is_unambiguously_index_signature(this) returns bool
    {
        this.next_token()
        if token = KindDotDotDotToken
            return true
        if token = KindCloseBracketToken
            return true

        let leading_modifier is_modifier_kind(token)
        if leading_modifier
        {
            this.next_token()
            if this.is_identifier()
                return true
        }
        if leading_modifier = false
        {
            if this.is_identifier() = false
                return false
            this.next_token()
        }

        ; A colon is a well-formed indexer; a comma cannot be a computed property
        ; name, since a comma expression is not allowed in one.
        if token = KindColonToken
            return true
        if token = KindCommaToken
            return true
        ; A `?` could still be a conditional expression in a computed property
        ; name, so one more token decides.
        if token <> KindQuestionToken
            return false
        this.next_token()
        if token = KindColonToken
            return true
        if token = KindCommaToken
            return true
        token = KindCloseBracketToken
    }

    procedure parse_index_signature_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        ; parseParameter, not parseParameterEx: an index signature's parameter is
        ; read with NO outer await context and ambiguity allowed. Both travel as
        ; parser state here (§3.5g/§3.5k), so both are set and put back.
        ;
        ; ★★★ And a THIRD thing travels the same way since slice 24, for a reason
        ; the other two do not have: the reference passes `parseParameter` as the
        ; element function HERE and a CLOSURE at parseParametersWorker, and only
        ; the closure calls checkJSSyntax. So the difference between the two
        ; element functions is not just their arguments — one of them checks and
        ; one does not — and this port has ONE `parse_list_element(PCParameters)`
        ; arm serving both. Measured, not reasoned about after the fact: with the
        ; flag left true, `[k: string]: number` inside a `.js` file reported its
        ; `string` as a type annotation and the reference reported nothing
        ; (fixture parser_jsdoc_reparse_signature_host).
        let saved_outer parameter_outer_await_context
        let saved_ambiguity parameter_allow_ambiguity
        let saved_check_js parameter_check_js
        set parameter_outer_await_context: false
        set parameter_allow_ambiguity: true
        set parameter_check_js: false
        let parameters this.parse_bracketed_list(PCParameters, KindOpenBracketToken, KindCloseBracketToken)
        set parameter_outer_await_context: saved_outer
        set parameter_allow_ambiguity: saved_ambiguity
        set parameter_check_js: saved_check_js
        if parameters = null
            return null

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }

        this.parse_type_member_semicolon()

        let result this.finish_node(this.new_node(KindIndexSignature, NodeData.IndexSignatureDeclaration(IndexSignatureDeclarationData(modifiers, parameters, type_node, null))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; A type member may be separated by a comma OR by a (possibly inserted)
    ; semicolon.
    procedure parse_type_member_semicolon(this) returns bool
    {
        if this.parse_optional(KindCommaToken)
            return true
        this.parse_semicolon()
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; TYPE MEMBERS — parser slice 7
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; ★★★ THE SLICE IS ONE PRODUCTION SEEN FROM TWO PLACES. An interface BODY
    ; and an object TYPE LITERAL both call parseObjectTypeMembers, which calls
    ; parseTypeMember — so the unported histogram's top two corpus rows,
    ; `interface`/`namespace`/`enum` at 26.4 % and the object type literal `{`
    ; at 18.1 %, are not competing candidates. Together they are 44.5 % of
    ; corpus first blockers, the largest slice the histogram has ever named,
    ; and slice 3 predicted it in as many words ("the `{` row was two slices
    ; under one character; the type half is still the interface-member slice").
    ;
    ; ── What is here ────────────────────────────────────────────────────────
    ;
    ;   parseTypeMember and its five member forms
    ;     parseSignatureMember       (call and construct signatures)
    ;     parseAccessorDeclaration   (already built by slice 6, with the
    ;                                 ParseFlagsType arm it was waiting for)
    ;     parseIndexSignatureDeclaration        (likewise slice 6)
    ;     parsePropertyOrMethodSignature
    ;   parseObjectTypeMembers / parseTypeLiteral
    ;   parseMappedType / parseMappedTypeParameter — because the `{` arm of
    ;     parseNonArrayType dispatches to one or the other, and building only
    ;     half of that arm would leave the tag naming a construct that is now
    ;     two different things
    ;   parseInterfaceDeclaration
    ;   parseEnumDeclaration / parseEnumMember
    ;   parseModuleDeclaration and the three routines under it
    ;
    ; ── and what is deliberately not ────────────────────────────────────────
    ;
    ; ★ `import(…)` types and import/export DECLARATIONS. `import` and `export`
    ;   are 19.2 % of corpus first blockers between them and are a slice of
    ;   their own; nothing here needs them. (The declarations landed with slice 8
    ;   and the types with slice 18 — recorded here because the sentence was a
    ;   statement about THIS slice's scope and is still an accurate one.)
    ;
    ; ★ checkJSSyntax, for the reason slice 4 recorded: it returns immediately
    ;   unless the node carries NodeFlagsJavaScriptFile, which this port never
    ;   sets.

    ; ── the list-element predicate ──────────────────────────────────────────

    procedure look_ahead_scan_type_member_start(this) returns bool
    {
        let saved this.mark()
        let r this.scan_type_member_start()
        this.rewind(saved)
        r
    }

    ; scanTypeMemberStart. `id_token` is not "an identifier was seen" — it is
    ; "something property-LIKE was seen", and a modifier keyword sets it too,
    ; because `readonly` alone is a legal property name. That is why the final
    ; test is on what FOLLOWS rather than on what was consumed.
    procedure scan_type_member_start(this) returns bool
    {
        ; A signature member starts here and needs no name at all.
        if token = KindOpenParenToken
            return true
        if token = KindLessThanToken
            return true
        if token = KindGetKeyword
            return true
        if token = KindSetKeyword
            return true

        var id_token false
        while is_modifier_kind(token)
        {
            set id_token: true
            this.next_token()
        }

        ; An index signature and a computed property name both start with `[`.
        if token = KindOpenBracketToken
            return true

        if this.is_literal_property_name()
        {
            set id_token: true
            this.next_token()
        }

        if id_token
        {
            if token = KindOpenParenToken
                return true
            if token = KindLessThanToken
                return true
            if token = KindQuestionToken
                return true
            if token = KindColonToken
                return true
            if token = KindCommaToken
                return true
            return this.can_parse_semicolon()
        }
        false
    }

    ; ── the member router ───────────────────────────────────────────────────

    procedure parse_type_member(this) returns pointer[AstNode]
    {
        if token = KindOpenParenToken
            return this.parse_signature_member(KindCallSignature)
        if token = KindLessThanToken
            return this.parse_signature_member(KindCallSignature)
        if token = KindNewKeyword
        {
            ; `new` is also a legal property name, so only what follows
            ; separates a construct signature from a property called `new`.
            if this.look_ahead_next_token_is_open_paren_or_less_than()
                return this.parse_signature_member(KindConstructSignature)
        }

        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers(false, false, false)
        if this.is_unported()
            return null

        if this.parse_contextual_modifier(KindGetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindGetAccessor, ParseFlagsType)
        if this.parse_contextual_modifier(KindSetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindSetAccessor, ParseFlagsType)
        if this.is_index_signature()
            return this.parse_index_signature_declaration(pos, jsdoc, modifiers)
        this.parse_property_or_method_signature(pos, jsdoc, modifiers)
    }

    ; CallSignature and ConstructSignature. The `new` is CONSUMED rather than
    ; kept: the reference stores no token for it and the node's own kind is
    ; what tells the two apart.
    procedure parse_signature_member(this, kind: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        if kind = KindConstructSignature
        {
            this.parse_expected(KindNewKeyword)
        }

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(ParseFlagsType)
        if parameters = null
            return null

        ; ★ Called UNCONDITIONALLY, and the failure test is is_unported() rather
        ; than a null result — a signature with no return type is legitimate
        ; (§3.5h), and the `=>`-where-a-`:`-was-meant arm of
        ; should_parse_return_type only reports itself through that flag.
        let type_node this.parse_return_type(KindColonToken, true)
        if this.is_unported()
            return null

        ; The separator is consumed BEFORE finish_node, so the node's end
        ; covers it. Order, not tidiness — reversing the two lines moves every
        ; signature member's end and the dump says so.
        this.parse_type_member_semicolon()

        var result null as pointer[AstNode]
        if kind = KindCallSignature
            set result: this.new_node(KindCallSignature, NodeData.CallSignature(SignatureDeclarationData(type_parameters, parameters, type_node, null)))
        else
            set result: this.new_node(KindConstructSignature, NodeData.ConstructSignature(SignatureDeclarationData(type_parameters, parameters, type_node, null)))

        this.with_jsdoc(this.finish_node(result, pos), jsdoc)
    }

    procedure parse_property_or_method_signature(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let name this.parse_property_name()
        if name = null
            return null
        let question_token this.parse_optional_token(KindQuestionToken)

        var is_method false
        if token = KindOpenParenToken
            set is_method: true
        if token = KindLessThanToken
            set is_method: true

        var result null as pointer[AstNode]
        if is_method
        {
            ; Method signatures do not exist in expression contexts, so they
            ; carry neither [Yield] nor [Await] — which is why nothing is saved
            ; and restored around this branch.
            let type_parameters this.parse_type_parameters()
            if this.is_unported()
                return null
            let parameters this.parse_parameters(ParseFlagsType)
            if parameters = null
                return null
            let return_type this.parse_return_type(KindColonToken, true)
            if this.is_unported()
                return null
            set result: this.new_node(KindMethodSignature, NodeData.MethodSignature(MethodSignatureData(modifiers, name, question_token, type_parameters, parameters, return_type, null)))
        }
        else
        {
            var type_node null as pointer[AstNode]
            if token = KindColonToken
            {
                set type_node: this.parse_type_annotation()
                if type_node = null
                    return null
            }

            ; ★ A type-literal or interface property cannot HAVE an
            ; initializer. One is parsed anyway, so that the CHECKER can report
            ; it — dropping this would make `interface I { a = 1 }` a parse
            ; failure where the reference produces a tree.
            var initializer null as pointer[AstNode]
            if token = KindEqualsToken
            {
                set initializer: this.parse_initializer()
                if initializer = null
                    return null
            }
            set result: this.new_node(KindPropertySignature, NodeData.PropertySignature(PropertyDeclarationData(modifiers, name, question_token, type_node, initializer)))
        }

        this.parse_type_member_semicolon()
        this.with_jsdoc(this.finish_node(result, pos), jsdoc)
    }

    ; ── the object type literal ─────────────────────────────────────────────

    procedure parse_object_type_members(this) returns pointer[Array[pointer[AstNode]]]
    {
        ; ★ The `{` is a BRANCH here too (§3.5bi): `interface Foo.I1 { }` must
        ; leave the interface at `Foo` and read `.I1` as an expression statement.
        if this.parse_expected(KindOpenBraceToken) = false
            return this.create_missing_list()
        let members this.parse_list(PCTypeMembers)
        if members = null
            return null
        this.parse_expected(KindCloseBraceToken)
        members
    }

    procedure parse_type_literal(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let members this.parse_object_type_members()
        if members = null
            return null
        this.finish_node(this.new_node(KindTypeLiteral, NodeData.TypeLiteral(TypeLiteralData(members))), pos)
    }

    ; ── the mapped type ─────────────────────────────────────────────────────
    ;
    ; `{ [K in T]: U }`. It shares the `{` with the type literal, and only this
    ; look-ahead separates them.

    procedure look_ahead_next_is_start_of_mapped_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_start_of_mapped_type()
        this.rewind(saved)
        r
    }

    procedure next_is_start_of_mapped_type(this) returns bool
    {
        this.next_token()
        if token = KindPlusToken
            return this.next_token() = KindReadonlyKeyword
        if token = KindMinusToken
            return this.next_token() = KindReadonlyKeyword
        if token = KindReadonlyKeyword
            this.next_token()
        ; The reference's `&&` chain, and its SHORT-CIRCUIT is load-bearing:
        ; without a `[` here nothing further is consumed, so a plain type
        ; literal is not scanned past by the look-ahead that rejected it.
        if token <> KindOpenBracketToken
            return false
        if this.next_token_is_identifier() = false
            return false
        this.next_token() = KindInKeyword
    }

    procedure next_token_is_identifier(this) returns bool
    {
        this.next_token()
        this.is_identifier()
    }

    procedure parse_mapped_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindOpenBraceToken)

        ; `readonly`, `+readonly` or `-readonly`. The token node is built from
        ; whichever of the three was seen, and a `+`/`-` then REQUIRES the
        ; `readonly` after it.
        var readonly_token null as pointer[AstNode]
        var has_readonly false
        if token = KindReadonlyKeyword
            set has_readonly: true
        if token = KindPlusToken
            set has_readonly: true
        if token = KindMinusToken
            set has_readonly: true
        if has_readonly
        {
            set readonly_token: this.parse_token_node()
            if AstNode.kind_of(readonly_token) <> KindReadonlyKeyword
            {
                this.parse_expected(KindReadonlyKeyword)
            }
        }

        this.parse_expected(KindOpenBracketToken)
        let type_parameter this.parse_mapped_type_parameter()
        if type_parameter = null
            return null

        var name_type null as pointer[AstNode]
        if this.parse_optional(KindAsKeyword)
        {
            set name_type: this.parse_type()
            if name_type = null
                return null
        }
        this.parse_expected(KindCloseBracketToken)

        ; `?`, `+?` or `-?`, read exactly as the readonly token above.
        var question_token null as pointer[AstNode]
        var has_question false
        if token = KindQuestionToken
            set has_question: true
        if token = KindPlusToken
            set has_question: true
        if token = KindMinusToken
            set has_question: true
        if has_question
        {
            set question_token: this.parse_token_node()
            if AstNode.kind_of(question_token) <> KindQuestionToken
            {
                this.parse_expected(KindQuestionToken)
            }
        }

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }
        this.parse_semicolon()

        ; ★ A mapped type has a MEMBER LIST after its one mapped member. It is
        ; always empty in well-formed source — the grammar allows nothing there
        ; — and the reference parses one anyway so that `{ [K in T]: U; a: V }`
        ; produces a tree the checker can complain about.
        let members this.parse_list(PCTypeMembers)
        if members = null
            return null
        this.parse_expected(KindCloseBraceToken)

        this.finish_node(this.new_node(KindMappedType, NodeData.MappedType(MappedTypeData(readonly_token, type_parameter, name_type, question_token, type_node, members))), pos)
    }

    ; The mapped type's `K in T` is a TypeParameter node whose CONSTRAINT is the
    ; type after `in` — not a node of its own.
    procedure parse_mapped_type_parameter(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let name this.parse_identifier_name()
        if name = null
            return null
        this.parse_expected(KindInKeyword)
        let type_node this.parse_type()
        if type_node = null
            return null
        this.finish_node(this.new_node(KindTypeParameter, NodeData.TypeParameter(TypeParameterData(null, name, type_node, null, null))), pos)
    }

    ; ── the interface declaration ───────────────────────────────────────────

    procedure parse_interface_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        this.parse_expected(KindInterfaceKeyword)
        let name this.parse_identifier()
        if name = null
            return null
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let heritage_clauses this.parse_heritage_clauses()
        if this.is_unported()
            return null
        let members this.parse_object_type_members()
        if members = null
            return null

        ; ★ No await-context handling and no statement_has_await_identifier
        ; save/restore, unlike the class, the enum and the module. That is the
        ; reference, not an omission: parseInterfaceDeclaration has neither, and
        ; it cannot need them — an interface body holds only types, and the
        ; three sites that DO save the flag each hold a statement or an
        ; initializer that could use `await` as a name.
        let result this.finish_node(this.new_node(KindInterfaceDeclaration, NodeData.InterfaceDeclaration(ClassLikeData(modifiers, name, type_parameters, heritage_clauses, members))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; ── the enum declaration ────────────────────────────────────────────────

    procedure parse_enum_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let saved_await_identifier statement_has_await_identifier
        this.parse_expected(KindEnumKeyword)
        let name this.parse_identifier()
        if name = null
            return null

        ; ★★★ THE `{` IS A BRANCH, not an expectation — see §3.5bi. With the
        ; brace missing the reference hands the node the MISSING-list sentinel
        ; and does not enter the member list at all, so `enum void {}` yields an
        ; EnumDeclaration that ENDS at the keyword and lets `void {}` re-parse as
        ; a statement.
        var members null as pointer[Array[pointer[AstNode]]]
        if this.parse_expected(KindOpenBraceToken)
        {
            let saved context_flags
            this.set_context_flags(NodeFlagsYieldContext, false)
            this.set_context_flags(NodeFlagsAwaitContext, false)
            set members: this.parse_delimited_list(PCEnumMembers)
            set context_flags: saved
            if members = null
                return null
            this.parse_expected(KindCloseBraceToken)
        }
        else
            set members: this.create_missing_list()

        let result this.with_jsdoc(this.finish_node(this.new_node(KindEnumDeclaration, NodeData.EnumDeclaration(EnumDeclarationData(modifiers, name, members))), pos), jsdoc)
        this.check_js_syntax(result)
        ; An `await` used as a name inside an enum body says nothing about the
        ; enclosing top-level statement — one more of the sites §3.5l names.
        set statement_has_await_identifier: saved_await_identifier
        result
    }

    procedure parse_enum_member(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let name this.parse_property_name()
        if name = null
            return null

        ; doInContext(DisallowIn, false, parseInitializer). A null initializer
        ; is the ordinary `enum E { A, B }`, so the failure test is
        ; is_unported() rather than the result.
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let initializer this.parse_initializer()
        set context_flags: saved
        if this.is_unported()
            return null

        let result this.finish_node(this.new_node(KindEnumMember, NodeData.EnumMember(EnumMemberData(name, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ── the module and namespace declarations ───────────────────────────────
    ;
    ; `namespace A {}`, `module A {}`, `declare module "x" {}` and
    ; `declare global {}` are ONE node kind — KindModuleDeclaration — and the
    ; word that declared it rides as a field.

    procedure parse_module_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        var keyword: int KindModuleKeyword
        if token = KindGlobalKeyword
            return this.parse_ambient_external_module_declaration(pos, jsdoc, modifiers)
        if this.parse_optional(KindNamespaceKeyword)
            set keyword: KindNamespaceKeyword
        else
        {
            this.parse_expected(KindModuleKeyword)
            ; `module "foo" { … }` names an EXTERNAL module, which is a
            ; different production from `module Foo { … }`.
            if token = KindStringLiteral
                return this.parse_ambient_external_module_declaration(pos, jsdoc, modifiers)
        }
        this.parse_module_or_namespace_declaration(pos, jsdoc, modifiers, false, keyword)
    }

    procedure parse_ambient_external_module_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let saved_await_identifier statement_has_await_identifier
        var name null as pointer[AstNode]
        var keyword: int KindModuleKeyword
        if token = KindGlobalKeyword
        {
            ; `global` is parsed as the NAME of the global scope augmentation,
            ; not as a keyword token.
            set name: this.parse_identifier()
            set keyword: KindGlobalKeyword
        }
        else
            set name: this.parse_literal_expression(KindStringLiteral)
        if name = null
            return null

        var body null as pointer[AstNode]
        if token = KindOpenBraceToken
        {
            set body: this.parse_module_block()
            if body = null
                return null
        }
        else
        {
            this.parse_semicolon()
        }

        let result this.with_jsdoc(this.finish_node(this.new_node(KindModuleDeclaration, NodeData.ModuleDeclaration(ModuleDeclarationData(modifiers, keyword, name, body))), pos), jsdoc)
        set statement_has_await_identifier: saved_await_identifier
        result
    }

    procedure parse_module_block(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        ; The `{` is a BRANCH (§3.5bi).
        var statements null as pointer[Array[pointer[AstNode]]]
        if this.parse_expected(KindOpenBraceToken)
        {
            set statements: this.parse_list(PCBlockStatements)
            if statements = null
                return null
            this.parse_expected(KindCloseBraceToken)
        }
        else
            set statements: this.create_missing_list()
        this.finish_node(this.new_node(KindModuleBlock, NodeData.ModuleBlock(BlockData(statements))), pos)
    }

    procedure parse_module_or_namespace_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], nested: bool, keyword: int) returns pointer[AstNode]
    {
        let saved_await_identifier statement_has_await_identifier
        var name null as pointer[AstNode]
        if nested
            set name: this.parse_identifier_name()
        else
            set name: this.parse_identifier()
        if name = null
            return null

        var body null as pointer[AstNode]
        if this.parse_optional(KindDotToken)
        {
            ; ★★ `namespace A.B {}` IS `namespace A { export namespace B {} }`,
            ; and the reference SYNTHESIZES that `export`: a zero-width token at
            ; the current position, flagged Reparsed. It is a real child and the
            ; dump shows it, so three things are exact here — it is built at
            ; nodePos() with pos = end, its flags are ASSIGNED rather than or'ed
            ; (it never goes through finish_node, so the context flags must NOT
            ; join), and the nested declaration starts at that same position
            ; rather than at the dot.
            let nested_pos this.node_pos()
            let implicit_export this.new_node(KindExportKeyword, NodeData.Token(TokenData()))
            set implicit_export.pos: nested_pos
            set implicit_export.end: nested_pos
            set implicit_export.flags: NodeFlagsReparsed
            let implicit_modifiers AstNode.new_node_list(host)
            implicit_modifiers.add(implicit_export)
            set body: this.parse_module_or_namespace_declaration(nested_pos, 0, implicit_modifiers, true, keyword)
        }
        else
            set body: this.parse_module_block()
        if body = null
            return null

        let result this.with_jsdoc(this.finish_node(this.new_node(KindModuleDeclaration, NodeData.ModuleDeclaration(ModuleDeclarationData(modifiers, keyword, name, body))), pos), jsdoc)
        this.check_js_syntax(result)
        set statement_has_await_identifier: saved_await_identifier
        result
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; IMPORTS AND EXPORTS — parser slice 8
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; parseDeclarationWorker's last two arms, and with them the router is
    ; complete. They are ONE slice rather than two adjacent histogram rows
    ; (`export` 21.3 %, `import` 19.9 %, 41.2 % of corpus first blockers
    ; between them): parseImportOrExportSpecifier builds `{ a as b }` for both
    ; sides, parseModuleSpecifier reads the `"mod"` for both, and
    ; parseImportAttributes reads the `with { … }` for both. Building one of
    ; them would have built most of the other.
    ;
    ; ── What is here ────────────────────────────────────────────────────────
    ;
    ;   parseImportDeclarationOrImportEqualsDeclaration and everything under it
    ;     parseImportEqualsDeclaration / parseModuleReference /
    ;       parseExternalModuleReference
    ;     tryParseImportClause / parseImportClause / parseNamespaceImport /
    ;       parseNamedImports / parseImportSpecifier
    ;     parseModuleSpecifier
    ;     tryParseImportAttributes / parseImportAttributes / parseImportAttribute
    ;   parseExportAssignment, parseNamespaceExportDeclaration
    ;   parseExportDeclaration / parseNamespaceExport / parseNamedExports /
    ;       parseExportSpecifier
    ;   parseImportOrExportSpecifier / parseModuleExportName, shared by both
    ;
    ; ── and what is deliberately not ────────────────────────────────────────
    ;
    ; ★ `import(…)` TYPES and the import EXPRESSION (`import.meta`,
    ;   `import("m")`) — LANDED WITH SLICE 18, and this entry is kept because its
    ;   reasoning is what decided that slice's SHAPE. It said the two "share the
    ;   keyword and nothing else: both set flags on the SOURCE FILE node, which
    ;   this port does not model". The first half turned out to be wrong and the
    ;   second is exactly why they are ONE slice: the shared flag IS the
    ;   mechanism, so building either meant building it, and then the other cost
    ;   a routine. parse_import_type also became the caller that
    ;   parse_import_attributes' unused `skip_keyword` had been waiting for
    ;   (§3.5ar), which is where the parameter's own §3.5p claim expired.
    ;
    ;   (The `assert { … }` form of import attributes was the third entry here
    ;   through slice 12 and is ported: the reference reports
    ;   Import_assertions_have_been_replaced_by_import_attributes and parses the
    ;   clause anyway, which slice 13c does too.)
    ;
    ; ── The TEXT question, and how it is answered without any text ──────────
    ;
    ; ★★★ The reference asks `identifier.Text() == "type"` and `== "defer"` in
    ; three places here, and this port asks the token KIND instead: `type` and
    ; `defer` are CONTEXTUAL KEYWORDS, so the scanner has already mapped exactly
    ; those two spellings — and no others — to KindTypeKeyword and
    ; KindDeferKeyword. The token kind CAPTURED BEFORE the identifier is parsed
    ; IS the text test, not an approximation of it.
    ;
    ; ★ Slice 17 stored the text and did NOT change these, which is the
    ; interesting half: the keyword lookup runs on the DECODED value, so an
    ; escaped `\u0074ype` maps to KindTypeKeyword exactly as the reference's
    ; node text reads "type". The kind and the text agree on every input, so
    ; there was never a residue here — see §3.5q, whose condition arrived and
    ; left this answer standing.

    procedure parse_import_declaration_or_import_equals_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        this.parse_expected(KindImportKeyword)
        let after_import_pos this.node_pos()

        ; ★ The whole head of an import is parsed in the OUTER await context —
        ; the reference's comment says it reports the grammar error in the
        ; checker instead — so whatever `await`-as-a-name it saw is put back
        ; before the statement's own record is decided.
        let saved_await_identifier statement_has_await_identifier

        var identifier null as pointer[AstNode]
        var identifier_kind: int KindUnknown
        if this.is_identifier()
        {
            set identifier_kind: token
            set identifier: this.parse_identifier()
            if identifier = null
                return null
        }

        ; `import type X from "m"` / `import defer * as ns from "m"`: the word
        ; just parsed as an identifier turns out to be a PHASE MODIFIER, and
        ; the name — if there is one at all — is the next word.
        var phase_modifier: int KindUnknown
        var is_phase false
        if identifier_kind = KindTypeKeyword
        {
            if this.import_type_phase_follows()
            {
                set phase_modifier: KindTypeKeyword
                set is_phase: true
            }
        }
        if identifier_kind = KindDeferKeyword
        {
            if this.import_defer_phase_follows()
            {
                set phase_modifier: KindDeferKeyword
                set is_phase: true
            }
        }
        if is_phase
        {
            ; The name is OPTIONAL after a phase modifier (`import type * as ns
            ; from "m"` has none), so the failure test is is_unported().
            set identifier: null
            if this.is_identifier()
            {
                set identifier: this.parse_identifier()
                if identifier = null
                    return null
            }
        }

        ; `import A = …` — a name, nothing that commits to an import
        ; DECLARATION after it, and no `defer` phase.
        var take_import_equals false
        if identifier <> null
        {
            if token_after_imported_identifier_definitely_produces_import_declaration(token) = false
            {
                if phase_modifier <> KindDeferKeyword
                    set take_import_equals: true
            }
        }
        if take_import_equals
        {
            let is_type_only phase_modifier = KindTypeKeyword
            let import_equals this.check_js_syntax(this.parse_import_equals_declaration(pos, jsdoc, modifiers, identifier, is_type_only))
            set statement_has_await_identifier: saved_await_identifier
            return import_equals
        }

        ; A null clause is `import "m";`, which is legitimate — the failure
        ; test is the flag, not the result (§3.5h).
        let import_clause this.try_parse_import_clause(identifier, after_import_pos, phase_modifier, false)
        if this.is_unported()
            return null
        set statement_has_await_identifier: saved_await_identifier

        let module_specifier this.parse_module_specifier()
        if module_specifier = null
            return null
        ; ... and a null attributes clause is the ordinary import.
        let attributes this.try_parse_import_attributes()
        if this.is_unported()
            return null
        this.parse_semicolon()

        let result this.finish_node(this.new_node(KindImportDeclaration, NodeData.ImportDeclaration(ImportDeclarationData(modifiers, import_clause, module_specifier, attributes))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; The `type` test's two remaining halves, minus the text comparison the
    ; caller has already made. Split out because the reference writes it as one
    ; three-line boolean, and a boolean that long is exactly where a port loses
    ; a clause without noticing.
    procedure import_type_phase_follows(this) returns bool
    {
        ; `import type from "m"` is a DEFAULT import named `type`; only what
        ; follows the `from` can say which reading is meant.
        if token = KindFromKeyword
        {
            if this.is_identifier() = false
                return false
            if this.look_ahead_next_token_is_from_keyword_or_equals_token() = false
                return false
        }
        if this.is_identifier()
            return true
        token_after_import_definitely_produces_import_declaration(token)
    }

    procedure import_defer_phase_follows(this) returns bool
    {
        ; `import defer from "m"` — a default import named `defer` — versus
        ; `import defer from from "m"`, where the first `from` is the name.
        if token = KindFromKeyword
            return this.look_ahead_next_token_is_token_string_literal() = false
        if token = KindCommaToken
            return false
        token <> KindEqualsToken
    }

    procedure next_token_is_from_keyword_or_equals_token(this) returns bool
    {
        this.next_token()
        if token = KindFromKeyword
            return true
        token = KindEqualsToken
    }

    procedure look_ahead_next_token_is_from_keyword_or_equals_token(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_from_keyword_or_equals_token()
        this.rewind(saved)
        r
    }

    procedure next_token_is_token_string_literal(this) returns bool
    {
        this.next_token() = KindStringLiteral
    }

    procedure look_ahead_next_token_is_token_string_literal(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_token_string_literal()
        this.rewind(saved)
        r
    }

    ; In `import ___`, these two say what the token can no longer be. A `*` or
    ; a `{` cannot be a name, so an import DECLARATION is certain; a `,` or a
    ; `from` after a name means the name was an imported binding rather than
    ; the left-hand side of an `import x = …`.
    function token_after_import_definitely_produces_import_declaration(k: int) returns bool
    {
        if k = KindAsteriskToken
            return true
        k = KindOpenBraceToken
    }

    function token_after_imported_identifier_definitely_produces_import_declaration(k: int) returns bool
    {
        if k = KindCommaToken
            return true
        k = KindFromKeyword
    }

    procedure parse_import_equals_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], identifier: pointer[AstNode], is_type_only: bool) returns pointer[AstNode]
    {
        this.parse_expected(KindEqualsToken)
        let module_reference this.parse_module_reference()
        if module_reference = null
            return null
        this.parse_semicolon()
        let result this.finish_node(this.new_node(KindImportEqualsDeclaration, NodeData.ImportEqualsDeclaration(ImportEqualsDeclarationData(modifiers, is_type_only, identifier, module_reference))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_module_reference(this) returns pointer[AstNode]
    {
        ; `require` is a contextual keyword, so it is a legal name too:
        ; `import A = require` is an alias and only the `(` separates them.
        if token = KindRequireKeyword
        {
            if this.look_ahead_next_token_is_open_paren()
                return this.parse_external_module_reference()
        }
        this.parse_entity_name(false)
    }

    procedure parse_external_module_reference(this) returns pointer[AstNode]
    {
        ; ★ This restore is a REDUNDANCY in the reference, ported because the
        ; reference has it and measured so that the next reader does not spend
        ; an hour trying to gate it: the only route here is
        ; parse_import_equals_declaration, and its caller restores the same
        ; field again on return, so removing this line changes nothing on any
        ; case. Unreachable-in-effect, not uncovered — the distinction slice 7
        ; drew for the enum member's DisallowIn clear.
        let saved_await_identifier statement_has_await_identifier
        let pos this.node_pos()
        this.parse_expected(KindRequireKeyword)
        this.parse_expected(KindOpenParenToken)
        let expression this.parse_module_specifier()
        if expression = null
            return null
        this.parse_expected(KindCloseParenToken)
        let result this.finish_node(this.new_node(KindExternalModuleReference, NodeData.ExternalModuleReference(WrappedTypeData(expression))), pos)
        set statement_has_await_identifier: saved_await_identifier
        result
    }

    ; ★ The grammar allows a string literal and nothing else. The reference
    ; parses an arbitrary EXPRESSION anyway and lets the checker say so — so
    ; `import x from y;` produces a tree here rather than a parse failure, and
    ; dropping that would be a different parser, not a smaller one.
    ;
    ; (The reference additionally INTERNS the literal's text; this port keeps
    ; no text, so there is nothing to intern.)
    procedure parse_module_specifier(this) returns pointer[AstNode]
    {
        if token = KindStringLiteral
            return this.parse_literal_expression(KindStringLiteral)
        this.parse_expression()
    }

    ; ★ The reference's skipJSDocLeadingAsterisks parameter is dropped: it is
    ; true only where the JSDoc parser calls in, and false at the one call site
    ; on the parse path. Left out rather than carried as a parameter that can
    ; never be anything but false — the same treatment
    ; ParseFlagsIgnoreMissingOpenBrace gets at the top of this file.
    ; ★★★ Slice 21 gave both of these the reference's fourth parameter, and it is
    ; the §3.5ar shape from the side that leaves nothing to grep: every caller up
    ; to slice 20 passes it as FALSE, so it had been folded away, and
    ; `parseImportTag` is the one caller in the whole reference that passes true.
    ; An `@import` tag's clause may be written across the lines of a JSDoc
    ; comment, so the margin asterisks have to become trivia for the length of
    ; the clause and for nothing else.
    procedure try_parse_import_clause(this, identifier: pointer[AstNode], pos: int, phase_modifier: int, skip_jsdoc_leading_asterisks: bool) returns pointer[AstNode]
    {
        var has_clause false
        if identifier <> null
            set has_clause: true
        if token = KindAsteriskToken
            set has_clause: true
        if token = KindOpenBraceToken
            set has_clause: true
        if has_clause = false
            return null

        let import_clause this.parse_import_clause(identifier, pos, phase_modifier, skip_jsdoc_leading_asterisks)
        if import_clause = null
            return null
        this.parse_expected(KindFromKeyword)
        import_clause
    }

    procedure parse_import_clause(this, identifier: pointer[AstNode], pos: int, phase_modifier: int, skip_jsdoc_leading_asterisks: bool) returns pointer[AstNode]
    {
        let saved_await_identifier statement_has_await_identifier
        var named_bindings null as pointer[AstNode]

        ; `identifier == nil || p.parseOptional(Comma)`, and the SHORT-CIRCUIT
        ; is load-bearing: with no default binding there is no comma to
        ; consume, and consuming one would eat the `,` of something else.
        var parse_bindings false
        if identifier = null
            set parse_bindings: true
        else
        {
            if this.parse_optional(KindCommaToken)
                set parse_bindings: true
        }
        if parse_bindings
        {
            if skip_jsdoc_leading_asterisks
                scanner.set_skip_jsdoc_leading_asterisks(true)
            if token = KindAsteriskToken
                set named_bindings: this.parse_namespace_import()
            else
                set named_bindings: this.parse_named_imports()
            if skip_jsdoc_leading_asterisks
                scanner.set_skip_jsdoc_leading_asterisks(false)
            if named_bindings = null
                return null
        }

        let result this.finish_node(this.new_node(KindImportClause, NodeData.ImportClause(ImportClauseData(phase_modifier, identifier, named_bindings))), pos)
        set statement_has_await_identifier: saved_await_identifier
        result
    }

    procedure parse_namespace_import(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.parse_expected(KindAsteriskToken)
        this.parse_expected(KindAsKeyword)
        let name this.parse_identifier()
        if name = null
            return null
        this.finish_node(this.new_node(KindNamespaceImport, NodeData.NamespaceImport(WrappedTypeData(name))), pos)
    }

    procedure parse_named_imports(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let saved specifier_is_import
        set specifier_is_import: true
        let imports this.parse_bracketed_list(PCImportOrExportSpecifiers, KindOpenBraceToken, KindCloseBraceToken)
        set specifier_is_import: saved
        if imports = null
            return null
        this.finish_node(this.new_node(KindNamedImports, NodeData.NamedImports(ElementListData(imports))), pos)
    }

    procedure parse_import_specifier(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var is_type_only false
        var property_name null as pointer[AstNode]
        let name this.parse_import_or_export_specifier(KindImportSpecifier, &is_type_only, &property_name)
        if name = null
            return null

        ; ★ An import specifier's NAME is the binding it introduces, so it must
        ; be an identifier: `import { "a" } from "m"` is legal ES only with an
        ; `as`. Report at the offending name's own span, and put a zero-width
        ; identifier in its place — note the synthesized node is finished at the
        ; REFUSED name's pos, not at the current position, so it sits where the
        ; binding would have been. (The property-name half may be a string
        ; literal, and parse_import_or_export_specifier has already allowed it.)
        var identifier_name name
        if name.kind <> KindIdentifier
        {
            this.parse_error_at_range(this.skip_range_trivia_pos(name.pos), name.end, DiagIdentifier_expected)
            set identifier_name: this.finish_node(this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData(null, 0))), name.pos)
            if identifier_name = null
                return null
        }

        this.check_js_syntax(this.finish_node(this.new_node(KindImportSpecifier, NodeData.ImportSpecifier(ImportOrExportSpecifierData(is_type_only, property_name, identifier_name))), pos))
    }

    ; ★★★ parseImportOrExportSpecifier, and the four readings of `type` are the
    ; whole of it. The reference's own table, which is the clearest statement
    ; of why this cannot be simplified:
    ;
    ;   import { type }              isTypeOnly false  name type
    ;   import { type as }           isTypeOnly TRUE   name as
    ;   import { type as as }        isTypeOnly false  name as    property type
    ;   import { type as as as }     isTypeOnly TRUE   name as    property as
    ;
    ; The two answers this port cannot return through a `return` — the type-only
    ; flag and the property name — travel as out-parameters. Both are scalars
    ; or pointers, which is the safe direction: an out-parameter carrying a
    ; String-bearing struct is the live dangling class in this repo.
    procedure parse_import_or_export_specifier(this, kind: int, out_is_type_only: pointer[bool], out_property_name: pointer[pointer[AstNode]]) returns pointer[AstNode]
    {
        set *out_is_type_only: false
        set *out_property_name: null

        var can_parse_as_keyword true
        let disallow_keywords kind = KindImportSpecifier
        var name_ok true

        ; The kind BEFORE the name is parsed — the text test again.
        let first_kind token
        var name null as pointer[AstNode]
        set name: this.parse_module_export_name(disallow_keywords, &name_ok)
        if name = null
            return null

        if first_kind = KindTypeKeyword
        {
            if token = KindAsKeyword
            {
                let first_as this.parse_identifier_name()
                if first_as = null
                    return null
                if token = KindAsKeyword
                {
                    let second_as this.parse_identifier_name()
                    if second_as = null
                        return null
                    if this.can_parse_module_export_name()
                    {
                        ; { type as as something }
                        set *out_is_type_only: true
                        set *out_property_name: first_as
                        set name: this.parse_module_export_name(disallow_keywords, &name_ok)
                        if name = null
                            return null
                        set can_parse_as_keyword: false
                    }
                    else
                    {
                        ; { type as as }
                        set *out_property_name: name
                        set name: second_as
                        set can_parse_as_keyword: false
                    }
                }
                else
                {
                    if this.can_parse_module_export_name()
                    {
                        ; { type as something }
                        set *out_property_name: name
                        set can_parse_as_keyword: false
                        set name: this.parse_module_export_name(disallow_keywords, &name_ok)
                        if name = null
                            return null
                    }
                    else
                    {
                        ; { type as }
                        set *out_is_type_only: true
                        set name: first_as
                    }
                }
            }
            else
            {
                if this.can_parse_module_export_name()
                {
                    ; { type something }
                    set *out_is_type_only: true
                    set name: this.parse_module_export_name(disallow_keywords, &name_ok)
                    if name = null
                        return null
                }
            }
        }

        if can_parse_as_keyword
        {
            if token = KindAsKeyword
            {
                set *out_property_name: name
                this.parse_expected(KindAsKeyword)
                set name: this.parse_module_export_name(disallow_keywords, &name_ok)
                if name = null
                    return null
            }
        }

        ; parseErrorAtRange(Identifier_expected). Reported HERE, where the
        ; reference reports it, and not where it was noticed — see
        ; parse_module_export_name for why the difference is observable: the
        ; refused name is the one the LAST parse_module_export_name answered,
        ; which an `as` can replace.
        if name_ok = false
            this.parse_error_at_range(this.skip_range_trivia_pos(name.pos), name.end, DiagIdentifier_expected)
        name
    }

    function can_parse_module_export_name(this) returns bool
    {
        if token_is_identifier_or_keyword(token)
            return true
        token = KindStringLiteral
    }

    procedure parse_module_export_name(this, disallow_keywords: bool, out_ok: pointer[bool]) returns pointer[AstNode]
    {
        ; ★ `nameOk` is ASSIGNED at every call in the reference, never
        ; accumulated — so a name refused here and then demoted to a PROPERTY
        ; name by a following `as` leaves no error behind. `import { if as x }`
        ; is legal for exactly that reason, and a flag that only ever went
        ; false would refuse it.
        set *out_ok: true

        ; An "arbitrary module namespace identifier" — `export { x as "a-b" }`.
        if token = KindStringLiteral
            return this.parse_literal_expression(KindStringLiteral)

        ; An import specifier's name binds, so a reserved word is refused
        ; there; an export specifier's does not, and may be one.
        if disallow_keywords
        {
            if is_keyword(token)
            {
                if this.is_identifier() = false
                    set *out_ok: false
            }
        }
        this.parse_identifier_name()
    }

    ; ── import attributes ───────────────────────────────────────────────────

    procedure try_parse_import_attributes(this) returns pointer[AstNode]
    {
        if token = KindWithKeyword
            return this.parse_import_attributes(KindWithKeyword, false)
        if token = KindAssertKeyword
        {
            ; The deprecated spelling: reported, and the clause parsed anyway.
            ; A line break before it makes it an ordinary identifier instead,
            ; and then there are no attributes at all.
            if this.has_preceding_line_break() = false
            {
                this.parse_error_at_current_token(DiagImport_assertions_have_been_replaced_by_import_attributes_Use_with_instead_of_assert)
                return this.parse_import_attributes(KindAssertKeyword, false)
            }
        }
        null
    }

    ; `skip_keyword` is the reference's, and it is false at both call sites in
    ; this slice. The true one is `parseImportTypeNode` — the `import("m", {
    ; with: { … } })` TYPE, which reads the keyword and the colon itself before
    ; handing the brace over — and that node is unported. Kept as a parameter
    ; because it is the reference's shape and the routine reads correctly with
    ; it; contrast skipJSDocLeadingAsterisks above, which was dropped because
    ; carrying it would have meant carrying its BEHAVIOUR too.
    procedure parse_import_attributes(this, tok: int, skip_keyword: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if skip_keyword = false
        {
            this.parse_expected(tok)
        }
        ; ★★★ THE `{` IS A BRANCH, not an expectation — and slice 18 is what made
        ; that observable. When it is missing, the reference does NOT parse a
        ; list: it hands the node the MISSING-list sentinel and carries on, so the
        ; ImportAttributes node comes out EMPTY at pos = end and the text after it
        ; is read as statements. This port parsed the list either way, which is
        ; the same tree for every caller slice 8 had — `with { … }` after a module
        ; specifier, where a missing `{` needs the recovery to reach a statement
        ; boundary anyway — and a DIFFERENT tree for parse_import_type's caller,
        ; where the brace was already consumed one level up:
        ; `import("m", { oops: 1 })` reads `oops: 1` as an attribute here and as a
        ; LABELED STATEMENT upstream. Measured against the reference before it was
        ; written; the fixture is parser_import_type_no_keyword.ts.
        ;
        ; ★ The reference also attaches RELATED INFORMATION to a missing `}`,
        ; pointing back at the `{`. Not ported, and stated rather than silent: the
        ; yardstick compares a diagnostic's code and span and cannot see a related
        ; note, so this is a gap no measurement here can close.
        var elements null as pointer[Array[pointer[AstNode]]]
        if this.parse_expected(KindOpenBraceToken)
        {
            set elements: this.parse_delimited_list(PCImportAttributes)
            if elements = null
                return null
            this.parse_expected(KindCloseBraceToken)
        }
        else
            set elements: this.create_missing_list()
        this.finish_node(this.new_node(KindImportAttributes, NodeData.ImportAttributes(ImportAttributesData(tok, elements))), pos)
    }

    procedure parse_import_attribute(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var name null as pointer[AstNode]
        if token_is_identifier_or_keyword(token)
            set name: this.parse_identifier_name()
        else
        {
            if token = KindStringLiteral
                set name: this.parse_literal_expression(KindStringLiteral)
        }
        ; ★ The colon is expected only when a NAME was read; with no name the
        ; reference reports Identifier_or_string_literal_expected instead and
        ; goes straight to the value, so there is exactly one diagnostic.
        if name = null
            this.parse_error_at_current_token(DiagIdentifier_or_string_literal_expected)
        else
            this.parse_expected(KindColonToken)
        let value this.parse_assignment_expression_or_higher()
        if value = null
            return null
        this.finish_node(this.new_node(KindImportAttribute, NodeData.ImportAttribute(ImportAttributeData(name, value))), pos)
    }

    ; isImportAttributeName. The same test can_parse_module_export_name makes,
    ; under the reference's other name for it — kept as two functions because
    ; they answer two different questions that happen to agree, and collapsing
    ; them would put one list context's predicate in the other's routine.
    function is_import_attribute_name(this) returns bool
    {
        if token_is_identifier_or_keyword(token)
            return true
        token = KindStringLiteral
    }

    ; ── the export declarations ─────────────────────────────────────────────

    procedure parse_export_assignment(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let saved context_flags
        let saved_await_identifier statement_has_await_identifier
        this.set_context_flags(NodeFlagsAwaitContext, true)

        var is_export_equals false
        if this.parse_optional(KindEqualsToken)
            set is_export_equals: true
        else
        {
            this.parse_expected(KindDefaultKeyword)
        }

        let expression this.parse_assignment_expression_or_higher()
        if expression = null
            return null
        this.parse_semicolon()

        ; ★ The flags are restored BEFORE finish_node, which is where they join
        ; the node — so the ExportAssignment itself does NOT carry AwaitContext
        ; while everything parsed inside it does. Swapping these two lines
        ; changes one flag on one node, and the dump says so.
        set context_flags: saved
        set statement_has_await_identifier: saved_await_identifier
        let result this.finish_node(this.new_node(KindExportAssignment, NodeData.ExportAssignment(ExportAssignmentData(modifiers, is_export_equals, null, expression))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; `export as namespace N;` — a UMD global declaration. The reference
    ; attaches the modifiers although the node may not have any, so that the
    ; grammar checker can report them.
    procedure parse_namespace_export_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        this.parse_expected(KindAsKeyword)
        this.parse_expected(KindNamespaceKeyword)
        let saved_await_identifier statement_has_await_identifier
        let name this.parse_identifier()
        if name = null
            return null
        set statement_has_await_identifier: saved_await_identifier
        this.parse_semicolon()
        let result this.finish_node(this.new_node(KindNamespaceExportDeclaration, NodeData.NamespaceExportDeclaration(NamespaceExportDeclarationData(modifiers, name))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_export_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let saved context_flags
        let saved_await_identifier statement_has_await_identifier
        this.set_context_flags(NodeFlagsAwaitContext, true)

        var export_clause null as pointer[AstNode]
        var module_specifier null as pointer[AstNode]
        var attributes null as pointer[AstNode]
        let is_type_only this.parse_optional(KindTypeKeyword)

        ; The namespace export's own position is taken BEFORE the `*`, so
        ; `export * as ns from "m"` gives the NamespaceExport a range that
        ; starts at the asterisk rather than at the `as`.
        let namespace_export_pos this.node_pos()
        if this.parse_optional(KindAsteriskToken)
        {
            if this.parse_optional(KindAsKeyword)
            {
                set export_clause: this.parse_namespace_export(namespace_export_pos)
                if export_clause = null
                    return null
            }
            this.parse_expected(KindFromKeyword)
            set module_specifier: this.parse_module_specifier()
            if module_specifier = null
                return null
        }
        else
        {
            set export_clause: this.parse_named_exports()
            if export_clause = null
                return null

            ; ★ A missing `from` is common enough to be worth recovering from,
            ; and the reference's rule is that a STRING LITERAL on the same
            ; line commits to a module specifier anyway — which is what keeps
            ; `export { from "mod";` reporting one error rather than parsing as
            ; something else entirely.
            var has_from false
            if token = KindFromKeyword
                set has_from: true
            if token = KindStringLiteral
            {
                if this.has_preceding_line_break() = false
                    set has_from: true
            }
            if has_from
            {
                this.parse_expected(KindFromKeyword)
                set module_specifier: this.parse_module_specifier()
                if module_specifier = null
                    return null
            }
        }

        ; Attributes only after a module specifier — `export { a } with { … }`
        ; has nothing to attach them to.
        if module_specifier <> null
        {
            var has_attributes false
            if token = KindWithKeyword
                set has_attributes: true
            if token = KindAssertKeyword
                set has_attributes: true
            if has_attributes
            {
                if this.has_preceding_line_break() = false
                {
                    if token = KindAssertKeyword
                        this.parse_error_at_current_token(DiagImport_assertions_have_been_replaced_by_import_attributes_Use_with_instead_of_assert)
                    set attributes: this.parse_import_attributes(token, false)
                    if attributes = null
                        return null
                }
            }
        }

        this.parse_semicolon()

        ; Restored before finish_node, exactly as in parse_export_assignment
        ; and for the same reason.
        set context_flags: saved
        set statement_has_await_identifier: saved_await_identifier
        let result this.finish_node(this.new_node(KindExportDeclaration, NodeData.ExportDeclaration(ExportDeclarationData(modifiers, is_type_only, export_clause, module_specifier, attributes))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; ★ The reference discards this call's `nameOk` (`exportName, _ :=`), and
    ; that is sound rather than sloppy: keywords are ALLOWED here, and only the
    ; disallowing side can answer false.
    procedure parse_namespace_export(this, pos: int) returns pointer[AstNode]
    {
        var ok true
        let export_name this.parse_module_export_name(false, &ok)
        if export_name = null
            return null
        this.finish_node(this.new_node(KindNamespaceExport, NodeData.NamespaceExport(WrappedTypeData(export_name))), pos)
    }

    procedure parse_named_exports(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let saved specifier_is_import
        set specifier_is_import: false
        let exports this.parse_bracketed_list(PCImportOrExportSpecifiers, KindOpenBraceToken, KindCloseBraceToken)
        set specifier_is_import: saved
        if exports = null
            return null
        this.finish_node(this.new_node(KindNamedExports, NodeData.NamedExports(ElementListData(exports))), pos)
    }

    ; ★ The export specifier carries JSDoc and the import specifier does not —
    ; the reference's two routines differ in exactly that and in the kind, and
    ; this port keeps the difference rather than folding them into one.
    procedure parse_export_specifier(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        var is_type_only false
        var property_name null as pointer[AstNode]
        let name this.parse_import_or_export_specifier(KindExportSpecifier, &is_type_only, &property_name)
        if name = null
            return null
        let result this.finish_node(this.new_node(KindExportSpecifier, NodeData.ExportSpecifier(ImportOrExportSpecifierData(is_type_only, property_name, name))), pos)
        this.with_jsdoc(result, jsdoc)
        this.check_js_syntax(result)
    }

    ; ── the two look-aheads this slice adds ─────────────────────────────────

    procedure look_ahead_next_token_is_identifier_or_keyword(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_identifier_or_keyword()
        this.rewind(saved)
        r
    }

    procedure next_token_is_identifier_or_keyword(this) returns bool
    {
        this.next_token()
        token_is_identifier_or_keyword(token)
    }

    procedure look_ahead_next_token_is_open_paren(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_open_paren()
        this.rewind(saved)
        r
    }

    ; nextIsIdentifierAndCloseParen — the `for (let of X)` question. Go's `&&`
    ; short-circuits, so the second nextToken() must not run when the first
    ; answer is no.
    procedure look_ahead_next_is_identifier_and_close_paren(this) returns bool
    {
        let saved this.mark()
        var r false
        if this.next_token_is_identifier()
            set r: this.next_token() = KindCloseParenToken
        this.rewind(saved)
        r
    }

    ; isUsingDeclaration's for-head twin: the same question with disallowOf ON,
    ; so that `for (using of x)` reads `of` as the keyword rather than as the
    ; declared name. The await arm of the same head needs no twin — the
    ; reference's nextIsUsingKeywordThenBindingIdentifier… is character for
    ; character what isAwaitUsingDeclaration already asks.
    procedure is_using_declaration_in_for_initializer(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_binding_identifier_or_start_of_destructuring_on_same_line(true)
        this.rewind(saved)
        r
    }

    procedure next_token_is_open_paren(this) returns bool
    {
        this.next_token()
        token = KindOpenParenToken
    }

    ; ── lists, and the RECOVERY that makes them lists ───────────────────────
    ;
    ; parseList / parseDelimitedList / parseBracketedList, with the error
    ; recovery slice 13c added. Through slice 12 the recovery was the one thing
    ; deliberately left out, on the argument that "recovery only runs after a
    ; diagnostic, and a diagnostic is already an unported report" — which was
    ; true and which this slice retires along with the premise.
    ;
    ; A list may legitimately come back EMPTY — `Foo<>` is a type reference with
    ; zero type arguments, and the reference builds an empty NodeList for it —
    ; so an empty Array here is a result, not a failure. Failure is null, and
    ; null now means only one thing: an element parser met a construct this port
    ; does not implement and said so.

    ; ★ createMissingList — the reference's answer when the OPENING token was
    ; absent. It is an empty list carrying a marker (`missingListNodes`) that
    ; later passes read; ForEachChild visits a list's ELEMENTS, of which there
    ; are none, so for this yardstick the marker is invisible and an empty list
    ; is the whole of it.
    procedure parse_bracketed_list(this, ctx: int, opening: int, closing: int) returns pointer[Array[pointer[AstNode]]]
    {
        if this.parse_expected(opening)
        {
            let list this.parse_delimited_list(ctx)
            if list = null
                return null
            this.parse_expected(closing)
            return list
        }
        this.create_missing_list()
    }

    procedure create_missing_list(this) returns pointer[Array[pointer[AstNode]]]
        missing_list

    ; isMissingNodeList — pointer identity against the sentinel, exactly as the
    ; reference compares backing-array identity.
    function is_missing_node_list(this, list: pointer[Array[pointer[AstNode]]]) returns bool
    {
        if list = null
            return false
        list = missing_list
    }

    ; parseList — the UNDELIMITED form, for the lists a class body, a block and
    ; the source file are made of. No commas: an element either starts here or
    ; the list ends, and what sits in between is recovered from rather than
    ; punctuated.
    procedure parse_list(this, ctx: int) returns pointer[Array[pointer[AstNode]]]
    {
        let saved_contexts parsing_contexts
        set parsing_contexts: parsing_contexts | (1 << ctx)

        ; ★★★ parseListIndex's reparse plumbing (slice 22), and EVERY list in the
        ; parser is part of it. A tag that becomes a declaration is parked in
        ; `reparse_list` while the element it documents is being parsed, and is
        ; flushed into THIS list immediately after — before the element, which is
        ; what puts a `@typedef`'s type alias ahead of the statement it
        ; documented. The saved outer list is what makes the nesting work: an
        ; alias or an import produced inside a list that cannot hold a
        ; declaration (a class body, an object literal) is propagated OUTWARDS
        ; instead, to the nearest list that can.
        let outer_reparse_list reparse_list
        set reparse_list: AstNode.new_node_list(host)

        let list AstNode.new_node_list(host)
        var failed false
        while this.is_list_terminator(ctx) = false
        {
            if this.is_list_element(ctx, false)
            {
                ; parseListIndex's `parseElement(p, len(list))`. The reference has
                ; two entry points — parseList and parseListIndex — and uses the
                ; indexed one for PCSourceElements alone; one loop carries both
                ; here, with the index published only for that context so a
                ; nested block cannot overwrite the top level's. See the
                ; top_level_statement_index field (§3.5k).
                if ctx = PCSourceElements
                    set top_level_statement_index: list.get_length() as int
                let element this.parse_list_element(ctx)
                if element = null
                {
                    set failed: true
                    break
                }
                if (reparse_list.get_length() as int) <> 0
                {
                    var ri 0
                    let rn reparse_list.get_length() as int
                    while ri < rn
                    {
                        let e *(reparse_list.get_buffer() + ri)
                        set ri: ri + 1
                        var outwards false
                        if (e.kind = KindJSTypeAliasDeclaration) or (e.kind = KindJSImportDeclaration)
                        {
                            if (ctx <> PCSourceElements) and (ctx <> PCBlockStatements)
                                set outwards: true
                        }
                        if outwards
                            outer_reparse_list.add(e)
                        else
                            list.add(e)
                    }
                    set reparse_list: AstNode.new_node_list(host)
                }
                list.add(element)
            }
            else
            {
                if this.abort_parsing_list_or_move_to_next_token(ctx)
                    break
            }
        }
        set reparse_list: outer_reparse_list
        set parsing_contexts: saved_contexts
        if failed
            return null
        list
    }

    procedure parse_delimited_list(this, ctx: int) returns pointer[Array[pointer[AstNode]]]
    {
        ; The reference's `pos := p.nodePos()`, taken before a single element is
        ; read. It is the list's RANGE start — see record_list_range — and for a
        ; bracketed list it is the full start of the token AFTER the opening
        ; bracket, since parse_bracketed_list has already consumed that.
        let pos this.node_pos()
        let saved_contexts parsing_contexts
        set parsing_contexts: parsing_contexts | (1 << ctx)
        let list AstNode.new_node_list(host)
        var failed false
        var stop false
        while stop = false
        {
            if this.is_list_element(ctx, false)
            {
                let start_pos this.node_pos()
                let element this.parse_list_element(ctx)
                if element = null
                {
                    set failed: true
                    set stop: true
                }
                else
                {
                    list.add(element)
                    if this.parse_optional(KindCommaToken) = false
                    {
                        if this.is_list_terminator(ctx)
                            set stop: true
                        else
                        {
                            ; No comma and no terminator. The reference parses a
                            ; comma out anyway so the message is a good one —
                            ; except in an enum, which has a message of its own.
                            if ctx = PCEnumMembers
                            {
                                if token <> KindCommaToken
                                    this.parse_error_at_current_token(DiagAn_enum_member_name_must_be_followed_by_a_or)
                                else
                                    this.parse_expected(KindCommaToken)
                            }
                            else
                                this.parse_expected(KindCommaToken)

                            ; ★ A SEMICOLON used as a separator is skipped in the
                            ; two contexts where people write one — an object
                            ; literal and an import-attributes clause — so that
                            ; one mistake does not cascade into a diagnostic per
                            ; remaining member. The error above has already been
                            ; reported; this only gets the parser back on track.
                            var semicolon_context false
                            if ctx = PCObjectLiteralMembers
                                set semicolon_context: true
                            if ctx = PCImportAttributes
                                set semicolon_context: true
                            if semicolon_context
                            {
                                if token = KindSemicolonToken
                                {
                                    if this.has_preceding_line_break() = false
                                        this.next_token()
                                }
                            }

                            ; ★★ The zero-progress guard, and it is not a
                            ; belt-and-braces addition: is_list_element said yes
                            ; and the element parser consumed NOTHING, which
                            ; happens where a speculative parenthesized
                            ; expression is being read as a parameter list, or
                            ; where a modifier keyword is refused as a parameter
                            ; name. Without the extra token this loop does not
                            ; terminate.
                            if start_pos = this.node_pos()
                                this.next_token()
                        }
                    }
                }
            }
            else
            {
                if this.is_list_terminator(ctx)
                    set stop: true
                else
                {
                    if this.abort_parsing_list_or_move_to_next_token(ctx)
                        set stop: true
                }
            }
        }
        set parsing_contexts: saved_contexts
        if failed
            return null
        ; `p.newNodeList(core.NewTextRange(pos, p.nodePos()), ...)`. The END is
        ; taken HERE, before parse_bracketed_list consumes the closing token, so
        ; it is that token's full start — the trivia before the bracket and any
        ; trailing comma included. That is what makes the range undeliverable
        ; from the elements.
        this.record_list_range(list, pos, this.node_pos())
        list
    }

    ; ── the recovery proper ─────────────────────────────────────────────────
    ;
    ; abortParsingListOrMoveToNextToken. The list is looking at a token that
    ; starts no element of its own kind: report what THIS list wanted, then ask
    ; whether any ENCLOSING list could use the token. If one could, give up so
    ; that it gets it; if none could, the token belongs to nobody, so skip it and
    ; let this list try again.
    ;
    ; ★ Answering "should I abort" rather than "did I abort" is the reference's
    ; own shape and it is the load-bearing half: a `}` inside a broken class body
    ; must close the class rather than be skipped, and the only thing that knows
    ; is the enclosing list.
    procedure abort_parsing_list_or_move_to_next_token(this, ctx: int) returns bool
    {
        this.parsing_context_errors(ctx)
        if this.is_in_some_parsing_context()
            return true
        this.next_token()
        false
    }

    ; isInSomeParsingContext — true if the current token is an element or a
    ; terminator of ANY open list.
    ;
    ; ★ The element question is asked with in_error_recovery TRUE, which is the
    ; whole reason is_list_element takes that parameter: three of its arms
    ; tighten up under it (see there). The reference asserts that at least one
    ; context is open; here the source file's own list is opened first and is
    ; never closed while parsing, so the set is never empty either.
    procedure is_in_some_parsing_context(this) returns bool
    {
        var k 0
        while k < PCCount
        {
            if (parsing_contexts & (1 << k)) <> 0
            {
                if this.is_list_element(k, true)
                    return true
                if this.is_list_terminator(k)
                    return true
            }
            set k: k + 1
        }
        false
    }

    ; parsingContextErrors — what each list says when it cannot use the token it
    ; is looking at. Eighteen arms, one per context this port opens; the
    ; reference's remaining six belong to the JSX and JSDoc lists it does not.
    ;
    ; ★ Two arms ask a question about the TOKEN rather than about the list, and
    ; both are the same question: a KEYWORD in a name position gets a message
    ; naming it (`'0' is not allowed as a variable declaration name` / `… as a
    ; parameter name`), anything else gets the generic one. The message argument
    ; is the keyword's spelling, which is not compared; the CODE is.
    procedure parsing_context_errors(this, ctx: int)
    {
        if ctx = PCSourceElements
        {
            if token = KindDefaultKeyword
                this.parse_error_at_current_token(DiagX_0_expected)
            else
                this.parse_error_at_current_token(DiagDeclaration_or_statement_expected)
            return
        }
        if ctx = PCBlockStatements
        {
            this.parse_error_at_current_token(DiagDeclaration_or_statement_expected)
            return
        }
        if ctx = PCSwitchClauses
        {
            this.parse_error_at_current_token(DiagX_case_or_default_expected)
            return
        }
        if ctx = PCSwitchClauseStatements
        {
            this.parse_error_at_current_token(DiagStatement_expected)
            return
        }
        if ctx = PCTypeMembers
        {
            this.parse_error_at_current_token(DiagProperty_or_signature_expected)
            return
        }
        if ctx = PCClassMembers
        {
            this.parse_error_at_current_token(DiagUnexpected_token_A_constructor_method_accessor_or_property_was_expected)
            return
        }
        if ctx = PCEnumMembers
        {
            this.parse_error_at_current_token(DiagEnum_member_expected)
            return
        }
        if ctx = PCHeritageClauseElement
        {
            this.parse_error_at_current_token(DiagExpression_expected)
            return
        }
        if ctx = PCVariableDeclarations
        {
            if is_keyword(token)
                this.parse_error_at_current_token(DiagX_0_is_not_allowed_as_a_variable_declaration_name)
            else
                this.parse_error_at_current_token(DiagVariable_declaration_expected)
            return
        }
        if ctx = PCObjectBindingElements
        {
            this.parse_error_at_current_token(DiagProperty_destructuring_pattern_expected)
            return
        }
        if ctx = PCArrayBindingElements
        {
            this.parse_error_at_current_token(DiagArray_element_destructuring_pattern_expected)
            return
        }
        if ctx = PCArgumentExpressions
        {
            this.parse_error_at_current_token(DiagArgument_expression_expected)
            return
        }
        if ctx = PCObjectLiteralMembers
        {
            this.parse_error_at_current_token(DiagProperty_assignment_expected)
            return
        }
        if ctx = PCArrayLiteralMembers
        {
            this.parse_error_at_current_token(DiagExpression_or_comma_expected)
            return
        }
        if ctx = PCParameters
        {
            if is_keyword(token)
                this.parse_error_at_current_token(DiagX_0_is_not_allowed_as_a_parameter_name)
            else
                this.parse_error_at_current_token(DiagParameter_declaration_expected)
            return
        }
        if ctx = PCTypeParameters
        {
            this.parse_error_at_current_token(DiagType_parameter_declaration_expected)
            return
        }
        if ctx = PCTypeArguments
        {
            this.parse_error_at_current_token(DiagType_argument_expected)
            return
        }
        if ctx = PCTupleElementTypes
        {
            this.parse_error_at_current_token(DiagType_expected)
            return
        }
        if ctx = PCHeritageClauses
        {
            this.parse_error_at_current_token(DiagUnexpected_token_expected)
            return
        }
        if ctx = PCImportOrExportSpecifiers
        {
            ; `import { from "mod"` again, from the reporting side: the list
            ; predicate bails on that shape so that the message can be "'}'
            ; expected" rather than something further on.
            if token = KindFromKeyword
                this.parse_error_at_current_token(DiagX_0_expected)
            else
                this.parse_error_at_current_token(DiagIdentifier_expected)
            return
        }
        if ctx = PCImportAttributes
        {
            this.parse_error_at_current_token(DiagIdentifier_or_string_literal_expected)
            return
        }
        ; Slice 20. Both JSX contexts share Identifier_expected upstream, in one
        ; arm together with PCJSDocComment.
        if ctx = PCJsxAttributes
        {
            this.parse_error_at_current_token(DiagIdentifier_expected)
            return
        }
        if ctx = PCJsxChildren
        {
            this.parse_error_at_current_token(DiagIdentifier_expected)
            return
        }
        ; Slice 21. PCJSDocComment shares that same arm upstream — unreachable in
        ; practice, since no list is parsed under it (see the constant), and
        ; ported because the reference has it.
        if ctx = PCJSDocComment
            this.parse_error_at_current_token(DiagIdentifier_expected)
    }

    procedure parse_list_element(this, ctx: int) returns pointer[AstNode]
    {
        if ctx = PCTypeParameters
            return this.parse_type_parameter()
        if ctx = PCTupleElementTypes
            return this.parse_tuple_element_name_or_tuple_element_type()
        if ctx = PCParameters
        {
            ; The reference's parameter callback, whole:
            ;
            ;     parameter := p.parseParameterEx(inAwaitContext, allowAmbiguity)
            ;     if parameter != nil && flags&ParseFlagsType == 0 {
            ;         p.checkJSSyntax(parameter)
            ;     }
            ;     return parameter
            let parameter this.parse_parameter_ex(parameter_outer_await_context, parameter_allow_ambiguity)
            if parameter <> null
            {
                if parameter_check_js
                    this.check_js_syntax(parameter)
            }
            return parameter
        }
        if ctx = PCArgumentExpressions
            return this.parse_argument_expression()
        ; ★ An ARRAY literal's element is NOT wrapped in the argument context:
        ; the reference passes parseArgumentOrArrayLiteralElement directly here
        ; and parseArgumentExpression there, and the wrapper CLEARS DisallowIn
        ; and DecoratorContext while the array path inherits both. Both therefore
        ; allow `in` at the top level — the difference only shows inside a `for`
        ; initializer or inside a decorator.
        ;
        ; ★ BOTH halves of that are now live, and each was a §3.5p claim that
        ; expired on the slice which built the construct: slice 9 made the `for`
        ; half reachable (parser_for_disallow_in_array) and slice 12 the
        ; decorator half (parser_decorator_array_element — `@[1]`'s element
        ; carries DecoratorContext, `@d([1])`'s does not). Routing this arm
        ; through parse_argument_expression is RED on exactly those two.
        if ctx = PCArrayLiteralMembers
            return this.parse_argument_or_array_literal_element()
        if ctx = PCObjectLiteralMembers
            return this.parse_object_literal_element()
        if ctx = PCClassMembers
            return this.parse_class_element()
        if ctx = PCHeritageClauses
            return this.parse_heritage_clause()
        if ctx = PCHeritageClauseElement
            return this.parse_expression_with_type_arguments()
        if ctx = PCTypeMembers
            return this.parse_type_member()
        if ctx = PCEnumMembers
            return this.parse_enum_member()
        if ctx = PCSourceElements
            return this.parse_top_level_statement()
        if ctx = PCBlockStatements
            return this.parse_statement()
        if ctx = PCSwitchClauses
            return this.parse_case_or_default_clause()
        if ctx = PCSwitchClauseStatements
            return this.parse_statement()
        ; ★ ONE reference context, TWO element parsers again —
        ; parseVariableDeclaration and parseVariableDeclarationAllowExclamation
        ; — and the same §3.5e/§3.5k answer: the flag is what a static arm can
        ; read. See the field's comment for why it is a field.
        if ctx = PCVariableDeclarations
            return this.parse_variable_declaration()
        ; ★ ONE reference context, TWO element parsers — parseImportSpecifier
        ; and parseExportSpecifier — which upstream passes as a func value.
        ; §3.5e: both call sites are static, so the value carries no
        ; information the flag does not, and the flag is what a static arm can
        ; read. The context stays one, as it is upstream.
        if ctx = PCImportOrExportSpecifiers
        {
            if specifier_is_import
                return this.parse_import_specifier()
            return this.parse_export_specifier()
        }
        if ctx = PCImportAttributes
            return this.parse_import_attribute()
        if ctx = PCArrayBindingElements
            return this.parse_array_binding_element()
        if ctx = PCObjectBindingElements
            return this.parse_object_binding_element()
        ; Slice 20. PCJsxChildren has NO arm here, and its absence is the fact:
        ; parse_jsx_children does not go through parse_list at all, because every
        ; child has to be preceded by a JSX re-scan. The context exists for
        ; is_in_some_parsing_context; see the constant's comment.
        if ctx = PCJsxAttributes
            return this.parse_jsx_attribute()
        this.parse_type()
    }

    ; ★★★ `in_error_recovery` is slice 13c's addition and it is not decoration:
    ; three arms TIGHTEN under it, and each says the same thing in its own way —
    ; during recovery a list must be harder to convince, or it will claim a token
    ; that belongs to whatever is broken around it. A `;` stops being an empty
    ; statement and stops being a class member (both are "almost always used for
    ; statements", so a stray one in a broken class must not read as a member and
    ; close it), and a heritage-clause element narrows from any left-hand-side
    ; expression to a plain identifier, so that `this` is not taken for a base
    ; type while the parser is lost.
    procedure is_list_element(this, ctx: int, in_error_recovery: bool) returns bool
    {
        ; PCSourceElements, PCBlockStatements and PCSwitchClauseStatements share
        ; one arm upstream; the two below join it.
        if ctx = PCSourceElements
        {
            if token = KindSemicolonToken
            {
                if in_error_recovery
                    return false
            }
            return this.is_start_of_statement()
        }
        if ctx = PCParameters
            return this.is_start_of_parameter(false)
        if ctx = PCTypeParameters
        {
            ; `in` and `const` are variance/modifier keywords on a type
            ; parameter, so a list can start with either.
            if token = KindInKeyword
                return true
            if token = KindConstKeyword
                return true
            return this.is_identifier()
        }
        if ctx = PCObjectLiteralMembers
        {
            ; `[`, `*` and `...` really do start a member; the lone `.` does not,
            ; and is admitted so that a half-typed `{ a. }` does not close the
            ; literal (the reference names the completion test it is for).
            if token = KindOpenBracketToken
                return true
            if token = KindAsteriskToken
                return true
            if token = KindDotDotDotToken
                return true
            if token = KindDotToken
                return true
            return this.is_literal_property_name()
        }
        if ctx = PCArrayLiteralMembers
        {
            ; A comma is an ELISION and therefore an element; the `.` is the
            ; same completion tolerance as above.
            if token = KindCommaToken
                return true
            if token = KindDotToken
                return true
            if token = KindDotDotDotToken
                return true
            return this.is_start_of_expression()
        }
        if ctx = PCArgumentExpressions
        {
            if token = KindDotDotDotToken
                return true
            return this.is_start_of_expression()
        }
        if ctx = PCClassMembers
        {
            ; ES6 allows a bare `;` as a class element, and the reference refuses
            ; it during error RECOVERY so that a stray semicolon in a broken class
            ; does not read as a member. Slice 12's note here said "this port has
            ; no recovery, so the question never arises" — a §3.5p claim, and
            ; slice 13c is where it expires.
            if this.look_ahead_scan_class_member_start()
                return true
            if in_error_recovery
                return false
            return token = KindSemicolonToken
        }
        if ctx = PCHeritageClauses
            return this.is_heritage_clause()
        if ctx = PCHeritageClauseElement
        {
            ; `{ … }` is only a base type when what follows says the class body
            ; has not started yet — otherwise `extends {}` would eat the body.
            if token = KindOpenBraceToken
                return this.is_valid_heritage_clause_object_literal()
            ; ★★ Tightened during recovery: an identifier, not any left-hand-side
            ; expression, so that `this` is not read as a base type while the
            ; parser is lost.
            ;
            ; ★ It is UNREACHABLE IN EFFECT, and the argument is worth keeping
            ; because it is about is_in_some_parsing_context rather than about
            ; heritage clauses: PCSourceElements is open for the whole parse and
            ; its own recovery arm answers `is_start_of_statement()`, which is
            ; true for every token that starts a left-hand-side expression. So
            ; the disjunction already says yes wherever this arm could add one,
            ; and the single token where PCSourceElements says NO — a `;` — is
            ; not a left-hand-side start either, so both readings of this arm
            ; answer false there. Measured: dropping the tightening is UNGATED.
            ; Ported anyway, because the reference has it and because the
            ; masking is a property of the CONTEXT SET, not of this predicate.
            if in_error_recovery
            {
                if this.is_identifier() = false
                    return false
                return this.is_heritage_clause_extends_or_implements_keyword() = false
            }
            if this.is_start_of_left_hand_side_expression() = false
                return false
            return this.is_heritage_clause_extends_or_implements_keyword() = false
        }
        if ctx = PCTypeMembers
            return this.look_ahead_scan_type_member_start()
        if ctx = PCEnumMembers
        {
            ; A computed property name is admitted, which technically also lets
            ; an indexer in — the reference names that as a candidate for
            ; better error reporting rather than a rule.
            if token = KindOpenBracketToken
                return true
            return this.is_literal_property_name()
        }
        if ctx = PCBlockStatements
        {
            if token = KindSemicolonToken
            {
                if in_error_recovery
                    return false
            }
            return this.is_start_of_statement()
        }
        if ctx = PCSwitchClauseStatements
        {
            if token = KindSemicolonToken
            {
                if in_error_recovery
                    return false
            }
            return this.is_start_of_statement()
        }
        if ctx = PCSwitchClauses
        {
            if token = KindCaseKeyword
                return true
            return token = KindDefaultKeyword
        }
        if ctx = PCVariableDeclarations
            return this.is_binding_identifier_or_private_identifier_or_pattern()
        if ctx = PCImportOrExportSpecifiers
        {
            ; ★ `import { from "mod"` — an unterminated clause where the `from`
            ; was meant as the keyword. Bailing out here rather than reading
            ; `from` as a specifier is what lets the reference say "'}'
            ; expected" instead of a worse error further on.
            if token = KindFromKeyword
            {
                if this.look_ahead_next_token_is_token_string_literal()
                    return false
            }
            ; A string literal is an "arbitrary module namespace identifier".
            if token = KindStringLiteral
                return true
            return token_is_identifier_or_keyword(token)
        }
        if ctx = PCImportAttributes
            return this.is_import_attribute_name()
        ; ★ An object pattern's element may start with `[` — a COMPUTED property
        ; name, `{ [k]: v }` — which is why this is not the same predicate as the
        ; array pattern's below, where `[` is a nested pattern and arrives through
        ; is_binding_identifier_or_private_identifier_or_pattern instead.
        if ctx = PCObjectBindingElements
        {
            if token = KindOpenBracketToken
                return true
            if token = KindDotDotDotToken
                return true
            return this.is_literal_property_name()
        }
        ; ★ A COMMA is an element here, because a hole is an element: `[, a]` has
        ; two of them. Same reading PCArrayLiteralMembers is under, and the
        ; element parsers differ in what they BUILD for it (a zero-width
        ; BindingElement against an OmittedExpression), not in whether they build
        ; one.
        if ctx = PCArrayBindingElements
        {
            if token = KindCommaToken
                return true
            if token = KindDotDotDotToken
                return true
            return this.is_binding_identifier_or_private_identifier_or_pattern()
        }
        ; Slice 20. An attribute starts with a name or with `{` (a spread); a
        ; CHILD is anything at all, which is the reference's own `return true` and
        ; is why the child list needs a terminator rather than a start test.
        if ctx = PCJsxAttributes
        {
            if token_is_identifier_or_keyword(token)
                return true
            return token = KindOpenBraceToken
        }
        if ctx = PCJsxChildren
            return true
        ; ★★★ Slice 21. PCJSDocComment answers TRUE unconditionally, which is the
        ; reference's own arm — and it is the whole POINT of entering the context:
        ; is_in_some_parsing_context asks `is_list_element(k, true)` of every open
        ; list BEFORE it asks `is_list_terminator(k)`, so while a JSDoc comment is
        ; being parsed the disjunction already says yes on every token, and an
        ; inner list gives up rather than skipping one. Same shape as PCJsxChildren
        ; one line above, and the same reason its terminator arm cannot be gated.
        if ctx = PCJSDocComment
            return true
        ; PCTypeArguments and PCTupleElementTypes share one arm upstream too.
        if token = KindCommaToken
            return true
        this.is_start_of_type(false)
    }

    procedure is_list_terminator(this, ctx: int) returns bool
    {
        if token = KindEndOfFile
            return true
        if ctx = PCObjectLiteralMembers
            return token = KindCloseBraceToken
        if ctx = PCArrayLiteralMembers
            return token = KindCloseBracketToken
        if ctx = PCArgumentExpressions
        {
            ; `;` is there for error recovery, and is ported for the same reason
            ; the recovery tokens below are: leaving it out would loop where the
            ; reference stops.
            if token = KindCloseParenToken
                return true
            return token = KindSemicolonToken
        }
        if ctx = PCTypeParameters
        {
            ; Everything but `>` is there for error recovery, and is ported
            ; because leaving it out would loop where the reference stops.
            if token = KindGreaterThanToken
                return true
            if token = KindOpenParenToken
                return true
            if token = KindOpenBraceToken
                return true
            if token = KindExtendsKeyword
                return true
            return token = KindImplementsKeyword
        }
        if ctx = PCTupleElementTypes
            return token = KindCloseBracketToken
        if ctx = PCClassMembers
            return token = KindCloseBraceToken
        if ctx = PCHeritageClauses
        {
            ; `{` ends the clause LIST because it starts the class body; `}` is
            ; there for error recovery.
            if token = KindOpenBraceToken
                return true
            return token = KindCloseBraceToken
        }
        if ctx = PCHeritageClauseElement
        {
            if token = KindOpenBraceToken
                return true
            if token = KindExtendsKeyword
                return true
            return token = KindImplementsKeyword
        }
        if ctx = PCParameters
        {
            ; `]` is here for an index signature's parameter list, and — like the
            ; recovery tokens on PCTypeParameters — it is ported because leaving
            ; it out would loop where the reference stops.
            if token = KindCloseParenToken
                return true
            return token = KindCloseBracketToken
        }
        ; The contexts that live inside braces. They share one arm upstream,
        ; together with PCClassMembers above.
        if ctx = PCTypeMembers
            return token = KindCloseBraceToken
        if ctx = PCEnumMembers
            return token = KindCloseBraceToken
        if ctx = PCBlockStatements
            return token = KindCloseBraceToken
        if ctx = PCImportOrExportSpecifiers
            return token = KindCloseBraceToken
        if ctx = PCImportAttributes
            return token = KindCloseBraceToken
        if ctx = PCSwitchClauses
            return token = KindCloseBraceToken
        ; The object pattern joins the brace group above; the array pattern
        ; joins PCArrayLiteralMembers and PCTupleElementTypes at `]`.
        if ctx = PCObjectBindingElements
            return token = KindCloseBraceToken
        if ctx = PCArrayBindingElements
            return token = KindCloseBracketToken
        ; A clause's statement list ends at the NEXT clause as well as at the
        ; block's `}` — which is the whole reason switch clauses need a context
        ; of their own rather than reusing PCBlockStatements.
        if ctx = PCSwitchClauseStatements
        {
            if token = KindCloseBraceToken
                return true
            if token = KindCaseKeyword
                return true
            return token = KindDefaultKeyword
        }
        ; ★ A variable declaration list ends where a semicolon COULD go — ASI
        ; included — and, in a for head, at `in` and `of`. The `=>` arm is the
        ; reference's error-recovery tweak (an arrow function here will not
        ; resynchronize) and is ported for the same reason the recovery tokens on
        ; PCTypeParameters are: leaving it out would loop where the reference
        ; stops.
        if ctx = PCVariableDeclarations
        {
            if this.can_parse_semicolon()
                return true
            if token = KindInKeyword
                return true
            if token = KindOfKeyword
                return true
            return token = KindEqualsGreaterThanToken
        }
        ; ★ The source file's own list has NO terminator but end of file — the
        ; reference's switch has no PCSourceElements arm at all, so it falls to
        ; the `return false` at the bottom. Here the bottom is PCTypeArguments's
        ; arm, so the arm has to be written out; without it a top-level comma
        ; would end the file. Same reasoning as the two PCSourceElements arms in
        ; is_list_element: a shared fall-through in Go is a distinct arm here.
        if ctx = PCSourceElements
            return false
        ; Slice 20. The attribute list ends at `>` or at `/` — the two ways a tag
        ; can close. A CHILD list ends at `</`, which is asked as `<` plus a
        ; LOOKAHEAD rather than as the LessThanSlash token, because this predicate
        ; is also reached from is_in_some_parsing_context with an ordinary token in
        ; hand, where the JSX re-scan has not run.
        if ctx = PCJsxAttributes
        {
            if token = KindGreaterThanToken
                return true
            return token = KindSlashToken
        }
        if ctx = PCJsxChildren
        {
            if token <> KindLessThanToken
                return false
            return this.look_ahead_next_token_is_slash()
        }
        ; PCTypeArguments: anything but a comma ends the list.
        token <> KindCommaToken
    }

    ; ── the type-position predicates ────────────────────────────────────────

    procedure is_start_of_type(this, in_start_of_parameter: bool) returns bool
    {
        if type_start_token(token)
            return true
        if token = KindFunctionKeyword
            return in_start_of_parameter = false
        if token = KindMinusToken
        {
            if in_start_of_parameter
                return false
            return this.look_ahead_next_token_is_numeric_or_bigint_literal()
        }
        if token = KindOpenParenToken
        {
            ; `(` is only a type start if what follows could be a parameter list
            ; or a type — otherwise `(1)` would read as one.
            if in_start_of_parameter
                return false
            return this.look_ahead_next_is_parenthesized_or_function_type()
        }
        this.is_identifier()
    }

    ; The unconditional arm of isStartOfType, transcribed from the reference's
    ; case list. A run of independent tests rather than a chain — the same
    ; reason the scan switch is one (see the header).
    function type_start_token(k: int) returns bool
    {
        if k = KindAnyKeyword
            return true
        if k = KindUnknownKeyword
            return true
        if k = KindStringKeyword
            return true
        if k = KindNumberKeyword
            return true
        if k = KindBigIntKeyword
            return true
        if k = KindBooleanKeyword
            return true
        if k = KindReadonlyKeyword
            return true
        if k = KindSymbolKeyword
            return true
        if k = KindUniqueKeyword
            return true
        if k = KindVoidKeyword
            return true
        if k = KindUndefinedKeyword
            return true
        if k = KindNullKeyword
            return true
        if k = KindThisKeyword
            return true
        if k = KindTypeOfKeyword
            return true
        if k = KindNeverKeyword
            return true
        if k = KindOpenBraceToken
            return true
        if k = KindOpenBracketToken
            return true
        if k = KindLessThanToken
            return true
        if k = KindBarToken
            return true
        if k = KindAmpersandToken
            return true
        if k = KindNewKeyword
            return true
        if k = KindStringLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        if k = KindObjectKeyword
            return true
        if k = KindAsteriskToken
            return true
        if k = KindQuestionToken
            return true
        if k = KindExclamationToken
            return true
        if k = KindDotDotDotToken
            return true
        if k = KindInferKeyword
            return true
        if k = KindImportKeyword
            return true
        if k = KindAssertsKeyword
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        k = KindTemplateHead
    }

    procedure is_start_of_parameter(this, is_jsdoc_parameter: bool) returns bool
    {
        if token = KindDotDotDotToken
            return true
        if this.is_binding_identifier_or_private_identifier_or_pattern()
            return true
        if is_modifier_kind(token)
            return true
        if token = KindAtToken
            return true
        this.is_start_of_type(is_jsdoc_parameter = false)
    }

    function is_binding_identifier_or_private_identifier_or_pattern(this) returns bool
    {
        if token = KindOpenBraceToken
            return true
        if token = KindOpenBracketToken
            return true
        if token = KindPrivateIdentifier
            return true
        this.is_binding_identifier()
    }

    procedure is_start_of_function_type_or_constructor_type(this) returns bool
    {
        if token = KindLessThanToken
            return true
        if token = KindOpenParenToken
            return this.look_ahead_next_is_unambiguously_start_of_function_type()
        if token = KindNewKeyword
            return true
        if token = KindAbstractKeyword
            return this.look_ahead_next_token_is_new_keyword()
        false
    }

    procedure next_is_unambiguously_start_of_function_type(this) returns bool
    {
        this.next_token()
        if token = KindCloseParenToken
            return true
        if token = KindDotDotDotToken
            return true
        if this.skip_parameter_start()
        {
            if token = KindColonToken
                return true
            if token = KindCommaToken
                return true
            if token = KindQuestionToken
                return true
            if token = KindEqualsToken
                return true
            if token = KindCloseParenToken
                return this.next_token() = KindEqualsGreaterThanToken
        }
        false
    }

    procedure skip_parameter_start(this) returns bool
    {
        if is_modifier_kind(token)
            this.parse_modifiers(false, false, false)
        this.parse_optional(KindDotDotDotToken)
        if this.is_identifier()
        {
            this.next_token()
            return true
        }
        if token = KindThisKeyword
        {
            this.next_token()
            return true
        }
        if token = KindOpenBracketToken
            return this.skip_binding_pattern()
        if token = KindOpenBraceToken
            return this.skip_binding_pattern()
        false
    }

    ; skipParameterStart's binding-pattern arm: "return true if we can parse an
    ; array or object binding pattern with no errors", which the reference asks
    ; as `previousErrorCount == len(p.diagnostics)` across the parse. This port's
    ; stand-in for that list is the `unported` record — §3.5i gives it the
    ; reference's LIFETIME for exactly this reason — so the port is the same
    ; before/after comparison over the records we keep.
    ;
    ; ★★★ But the two are not the same PREDICATE, and that is why a recorded
    ; report answers `unanswerable` here rather than `false`. Our record fires
    ; for two reasons: a construct the reference DIAGNOSES, where `false` is
    ; right, and one it parses perfectly well that this port has not built, where
    ; `false` is a quiet wrong answer — it would route `([a]: T) => U` down the
    ; parenthesized-type path and build a tree nobody has checked. Nothing at
    ; this site can tell the two apart, so it reports; over-reporting is the
    ; direction this harness exists to err in. §3.9e.
    ;
    ; ★ This is still the ONE site whose report must outlive a rewind, which is
    ; the whole reason there are two records: every caller is a look-ahead, so a
    ; rewindable report would be erased the moment the ANSWER was handed back and
    ; used. What slice 10 changes is how OFTEN it fires — a clean pattern now
    ; answers `true`, and only a pattern that hits something unported reports.
    ;
    ; ★ Both records are compared, not just `unported`: the recursion can reach
    ; this very function again (`{ a = ([b]: T) => c }`), and a nested
    ; `unanswerable` is a report about this parse too.
    ; ★★★ Slice 13c makes the reference's own test AVAILABLE — it counts its
    ; diagnostics before and after — and that does NOT retire the two records
    ; above it, which is the half worth reading. §3.5w says a port's stand-in can
    ; match a mechanism's lifetime and still not match its MEANING: a construct
    ; this port has not built leaves no diagnostic at all, so the count would
    ; answer "clean" for a parse that never happened. The count is therefore the
    ; LAST test here, not the only one.
    procedure skip_binding_pattern(this) returns bool
    {
        let before_unported unported_pos
        let before_unanswerable unanswerable_pos
        let before_diagnostics diagnostics.length()
        this.parse_identifier_or_pattern()
        if unported_pos <> before_unported
            return this.unanswerable_bool("binding-pattern")
        if unanswerable_pos <> before_unanswerable
            return false
        diagnostics.length() = before_diagnostics
    }

    ; ... and the same again for the record a rewind does not restore.
    procedure unanswerable_bool(this, tag: pointer[const_char]) returns bool
    {
        if unanswerable_pos < 0
        {
            set unanswerable_pos: scanner.token_full_start()
            set unanswerable_tag: tag
            set unanswerable_detail: token
        }
        false
    }

    procedure next_is_start_of_type(this) returns bool
    {
        this.next_token()
        this.is_start_of_type(false)
    }

    procedure next_token_is_numeric_or_bigint_literal(this) returns bool
    {
        this.next_token()
        if token = KindNumericLiteral
            return true
        token = KindBigIntLiteral
    }

    procedure next_is_parenthesized_or_function_type(this) returns bool
    {
        this.next_token()
        if token = KindCloseParenToken
            return true
        if this.is_start_of_parameter(false)
            return true
        this.is_start_of_type(false)
    }

    procedure next_is_start_of_type_of_import_type(this) returns bool
    {
        this.next_token()
        token = KindImportKeyword
    }

    procedure next_token_is_identifier_or_keyword_on_same_line(this) returns bool
    {
        if token_is_identifier_or_keyword(this.next_token()) = false
            return false
        this.has_preceding_line_break() = false
    }

    ; ── the look-ahead wrappers for the type surface ────────────────────────
    ;
    ; One per call site, as in §3.9e. They are mechanical, and that is the
    ; point: the mark/rewind pair is the part that must never be forgotten.

    procedure look_ahead_next_is_start_of_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_start_of_type()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_numeric_or_bigint_literal(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_numeric_or_bigint_literal()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_is_parenthesized_or_function_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_parenthesized_or_function_type()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_is_unambiguously_start_of_function_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_unambiguously_start_of_function_type()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_new_keyword(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() = KindNewKeyword
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_is_start_of_type_of_import_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_start_of_type_of_import_type()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_identifier_or_keyword_on_same_line(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_identifier_or_keyword_on_same_line()
        this.rewind(saved)
        r
    }

    procedure look_ahead_scan_start_of_named_tuple_element(this) returns bool
    {
        let saved this.mark()
        let r this.scan_start_of_named_tuple_element()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_is_not_dot(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() <> KindDotToken
        this.rewind(saved)
        r
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; TYPESCRIPT-ONLY SYNTAX IN A JAVASCRIPT FILE — slice 24
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; ★★★ THE REFERENCE ROUTES THESE DIAGNOSTICS TO A SECOND LIST, and that is
    ; the whole reason this slice needed a new section in the ast dump before it
    ; could be written at all. `checkJSSyntax` reports `Type annotations can only
    ; be used in TypeScript files` and its eighteen neighbours into
    ; `p.jsDiagnostics`, which finishSourceFile hands to `SetJSDiagnostics` — and
    ; `sf.Diagnostics()` does not include it. So with the old two-section dump a
    ; port producing NONE of them and a port producing WRONG ones compared exactly
    ; equal, in both directions: the hidden-distinction failure mode this suite is
    ; organized against, which is why the note that stood in run.sh and in §3.5
    ; named the section as the prerequisite rather than the calls.
    ;
    ; ★★ Every call site is a bare statement even where the reference writes
    ; `return p.checkJSSyntax(p.finishNode(...))`: the function answers its own
    ; argument, so the value is the node either way, and a bare call is one
    ; statement instead of a wrapped expression at thirty sites. The RESULT arm is
    ; kept for the two sites that genuinely read it back.
    ;
    ; ★ The MESSAGE ARGUMENTS are not carried, as everywhere else in this port:
    ; the four `{0} declarations can only be used in TypeScript files` sites differ
    ; only in the word they print (`interface`, `enum`, `import type`, …) and share
    ; one code. `scanner.TokenToString` therefore stays unported — the one thing
    ; the reference needs it for here is that word.

    ; jsErrorAtRange. A RAW append: neither the dedup nor `hasParseError`. Both
    ; omissions are the reference's own and both matter — a parameter with a `?`
    ; AND a type annotation reports twice at overlapping positions, and a JS
    ; complaint is not a parse error, so it must not stamp ThisNodeHasError on
    ; whatever node finish_node closes next. The POS is trivia-skipped and the END
    ; is not, exactly as report_json_error does it.
    ; finishSourceFile's last statement, which is a GUARD:
    ;
    ;     if ast.IsInJSFile(node) {
    ;         result.SetJSDiagnostics(attachFileToDiagnostics(p.jsDiagnostics, result))
    ;     }
    ;
    ; ★ The guard is unobservable and is ported anyway. checkJSSyntax's own first
    ; test is the same one — a node without NodeFlagsJavaScriptFile returns
    ; immediately — so for any other file the list is empty and handing it over
    ; would print nothing either way. What the guard buys is that the DISTINCTION
    ; between "not a JavaScript file" and "a JavaScript file with nothing to
    ; report" survives into the tree, which is the shape that stays right if a
    ; later slice ever appends from outside checkJSSyntax.
    ;
    ; The question is asked of the CONTEXT flags rather than of the finished node,
    ; because the node is being constructed in the expression this feeds. They are
    ; the same bit: JavaScriptFile is a context flag set once in initializeState
    ; from the script kind, and finish_node stamps it onto every node of the file.
    function js_diagnostics_for_file(this) returns pointer[DiagnosticList]
    {
        if (context_flags & NodeFlagsJavaScriptFile) = 0
            return null
        js_diagnostics
    }

    procedure js_error_at_range(this, pos: int, end: int, code: int)
        js_diagnostics.add_direct(this.skip_range_trivia_pos(pos), end, code)

    ; core.Some(list.Nodes, func(n) { n.Flags&Reparsed == 0 }) — asked of a
    ; type-parameter and a type-argument list. It is what keeps a `@template T`
    ; comment in a JavaScript file from being reported as TypeScript syntax: the
    ; JSDoc reparser synthesized that list, so every element carries Reparsed and
    ; the list is not the author's.
    function list_has_unreparsed(this, list: pointer[Array[pointer[AstNode]]]) returns bool
    {
        if list = null
            return false
        var i 0
        let n list.get_length() as int
        while i < n
        {
            let e *(list.get_buffer() + i)
            if e <> null
            {
                if (AstNode.flags_of(e) & NodeFlagsReparsed) = 0
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; core.Some(node.ModifierNodes(), ast.IsModifier) — a parameter carrying a
    ; real modifier (`constructor(private x)`), as against one carrying only
    ; decorators, which are legal in a JavaScript file and are checked separately.
    function list_has_modifier(this, list: pointer[Array[pointer[AstNode]]]) returns bool
    {
        if list = null
            return false
        var i 0
        let n list.get_length() as int
        while i < n
        {
            let e *(list.get_buffer() + i)
            if e <> null
            {
                if is_modifier_kind(AstNode.kind_of(e))
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; core.FindIndex over a modifier list, for the three questions
    ; checkJSDecoratorSyntax asks by INDEX rather than by presence: where the
    ; first decorator is, where `export` is, where `default` is. The order of the
    ; three is the diagnostic, so an index is not an implementation detail here.
    function first_index_of_kind(this, list: pointer[Array[pointer[AstNode]]], kind: int) returns int
    {
        if list = null
            return 0 - 1
        var i 0
        let n list.get_length() as int
        while i < n
        {
            let e *(list.get_buffer() + i)
            if e <> null
            {
                if AstNode.kind_of(e) = kind
                    return i
            }
            set i: i + 1
        }
        0 - 1
    }

    ; checkJSDecoratorSyntax. Two questions, and the FIRST one decides which:
    ; a node that may not carry a decorator at all reports one wherever it sits,
    ; while a node that may carry one reports only a decorator in the wrong PLACE
    ; — before `export` with another after it, or between `export` and `default`.
    ;
    ; ★ The `export`-ordering arm builds its diagnostic with RELATED INFO
    ; (`Decorator used before export here`), which the reference attaches to the
    ; diagnostic rather than appending to the list — so it never reaches the dump,
    ; exactly as parseExpectedMatchingBrackets' related info never reaches the D
    ; section. The port therefore appends the one diagnostic and the related
    ; information is the one thing about this function that is deliberately not
    ; carried; it is a MESSAGE, and no message is carried here.
    procedure check_js_decorator_syntax(this, n: pointer[AstNode])
    {
        let modifiers AstNode.modifiers_of(n)
        if modifiers = null
            return
        if (modifiers.get_length() as int) = 0
            return

        if AstNode.can_have_illegal_decorators(n)
        {
            var i 0
            let count modifiers.get_length() as int
            while i < count
            {
                let m *(modifiers.get_buffer() + i)
                if AstNode.is_decorator(m)
                {
                    this.js_error_at_range(m.pos, m.end, DiagDecorators_are_not_valid_here)
                    return
                }
                set i: i + 1
            }
            return
        }

        if AstNode.can_have_decorators(n) = false
            return
        let decorator_index this.first_index_of_kind(modifiers, KindDecorator)
        if decorator_index < 0
            return
        if AstNode.kind_of(n) <> KindClassDeclaration
            return
        let export_index this.first_index_of_kind(modifiers, KindExportKeyword)
        if export_index < 0
            return
        let default_index this.first_index_of_kind(modifiers, KindDefaultKeyword)

        if decorator_index > export_index
        {
            ; A decorator between `export` and `default`.
            if default_index >= 0
            {
                if decorator_index < default_index
                {
                    let d *(modifiers.get_buffer() + decorator_index)
                    this.js_error_at_range(d.pos, d.end, DiagDecorators_are_not_valid_here)
                }
            }
            return
        }

        ; A decorator BEFORE `export`, and another one after it — the reference
        ; searches forward from the export keyword for the trailing decorator and
        ; reports at THAT one, with the leading one as related information.
        var trailing 0 - 1
        var j export_index
        let count2 modifiers.get_length() as int
        while j < count2
        {
            if trailing < 0
            {
                let m *(modifiers.get_buffer() + j)
                if AstNode.is_decorator(m)
                    set trailing: j
            }
            set j: j + 1
        }
        if trailing >= 0
        {
            let t *(modifiers.get_buffer() + trailing)
            this.js_error_at_range(t.pos, t.end, DiagDecorators_may_not_appear_after_export_or_export_default_if_they_also_appear_before_export)
        }
    }

    ; checkJSSyntax itself. Two switches with a `fallthrough` each, which become
    ; flat kind tests here — the fallthrough is why {Parameter,
    ; PropertyDeclaration, MethodDeclaration} run the question-token test AND the
    ; signature/annotation test, and why the nine function-and-class kinds run the
    ; type-parameter test AND the modifier loop.
    procedure check_js_syntax(this, n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return n
        ; The guard, and it is three conditions: the node must belong to a
        ; JavaScript file, must not be part of a JSDoc comment's own tree, and must
        ; not have been synthesized by the reparser. The last two are why a
        ; `@type {number}` annotation is not reported as a type annotation.
        if (AstNode.flags_of(n) & NodeFlagsJavaScriptFile) = 0
            return n
        if (AstNode.flags_of(n) & (NodeFlagsJSDoc | NodeFlagsReparsed)) <> 0
            return n

        let k AstNode.kind_of(n)

        ; ── the first switch ────────────────────────────────────────────────
        var question_host false
        if k = KindParameter
            set question_host: true
        if k = KindPropertyDeclaration
            set question_host: true
        if k = KindMethodDeclaration
            set question_host: true
        if question_host
        {
            let q AstNode.question_token_of(n)
            if q <> null
            {
                if (AstNode.flags_of(q) & NodeFlagsReparsed) = 0
                {
                    if AstNode.is_question_token(q)
                        this.js_error_at_range(q.pos, q.end, DiagThe_0_modifier_can_only_be_used_in_TypeScript_files)
                }
            }
        }

        ; ... and the arm it falls through into. `Signature declarations` is the
        ; body-less form (`function f();`) and takes precedence over the return
        ; type; anything else complains about the ANNOTATION, at the annotation's
        ; own range.
        var signature_host question_host
        if k = KindMethodSignature
            set signature_host: true
        if k = KindConstructor
            set signature_host: true
        if k = KindGetAccessor
            set signature_host: true
        if k = KindSetAccessor
            set signature_host: true
        if k = KindFunctionExpression
            set signature_host: true
        if k = KindFunctionDeclaration
            set signature_host: true
        if k = KindArrowFunction
            set signature_host: true
        if k = KindVariableDeclaration
            set signature_host: true
        if k = KindIndexSignature
            set signature_host: true
        if signature_host
        {
            var reported false
            if AstNode.is_function_like(n)
            {
                if AstNode.body_of(n) = null
                {
                    this.js_error_at_range(n.pos, n.end, DiagSignature_declarations_can_only_be_used_in_TypeScript_files)
                    set reported: true
                }
            }
            if reported = false
            {
                let t AstNode.type_of(n)
                if t <> null
                {
                    if (AstNode.flags_of(t) & NodeFlagsReparsed) = 0
                        this.js_error_at_range(t.pos, t.end, DiagType_annotations_can_only_be_used_in_TypeScript_files)
                }
            }
        }

        if k = KindImportDeclaration
        {
            let clause AstNode.import_clause_of(n)
            if clause <> null
            {
                if AstNode.is_type_only_of(clause)
                    this.js_error_at_range(n.pos, n.end, DiagX_0_declarations_can_only_be_used_in_TypeScript_files)
            }
        }

        if k = KindExportDeclaration
        {
            if AstNode.is_type_only_of(n)
                this.js_error_at_range(n.pos, n.end, DiagX_0_declarations_can_only_be_used_in_TypeScript_files)
        }

        if k = KindImportSpecifier
        {
            if AstNode.is_type_only_of(n)
                this.js_error_at_range(n.pos, n.end, DiagX_0_declarations_can_only_be_used_in_TypeScript_files)
        }

        if k = KindExportSpecifier
        {
            if AstNode.is_type_only_of(n)
                this.js_error_at_range(n.pos, n.end, DiagX_0_declarations_can_only_be_used_in_TypeScript_files)
        }

        if k = KindImportEqualsDeclaration
            this.js_error_at_range(n.pos, n.end, DiagX_import_can_only_be_used_in_TypeScript_files)

        if k = KindExportAssignment
        {
            if AstNode.is_export_equals_of(n)
                this.js_error_at_range(n.pos, n.end, DiagX_export_can_only_be_used_in_TypeScript_files)
        }

        if k = KindHeritageClause
        {
            if AstNode.heritage_clause_token_of(n) = KindImplementsKeyword
                this.js_error_at_range(n.pos, n.end, DiagX_implements_clauses_can_only_be_used_in_TypeScript_files)
        }

        ; The four declaration kinds that are reported at their NAME rather than
        ; at the whole node.
        var name_reported 0
        if k = KindInterfaceDeclaration
            set name_reported: DiagX_0_declarations_can_only_be_used_in_TypeScript_files
        if k = KindModuleDeclaration
            set name_reported: DiagX_0_declarations_can_only_be_used_in_TypeScript_files
        if k = KindTypeAliasDeclaration
            set name_reported: DiagType_aliases_can_only_be_used_in_TypeScript_files
        if k = KindEnumDeclaration
            set name_reported: DiagX_0_declarations_can_only_be_used_in_TypeScript_files
        if name_reported <> 0
        {
            let name AstNode.name_of(n)
            if name <> null
                this.js_error_at_range(name.pos, name.end, name_reported)
        }

        if k = KindNonNullExpression
            this.js_error_at_range(n.pos, n.end, DiagNon_null_assertions_can_only_be_used_in_TypeScript_files)

        if k = KindAsExpression
        {
            let t AstNode.type_of(n)
            if t <> null
                this.js_error_at_range(t.pos, t.end, DiagType_assertion_expressions_can_only_be_used_in_TypeScript_files)
        }

        if k = KindSatisfiesExpression
        {
            let t AstNode.type_of(n)
            if t <> null
                this.js_error_at_range(t.pos, t.end, DiagType_satisfaction_expressions_can_only_be_used_in_TypeScript_files)
        }

        ; Decorator PLACEMENT, unconditionally — the reference calls it between the
        ; two switches and not from an arm of either.
        this.check_js_decorator_syntax(n)

        ; ── the second switch: type parameters, type arguments, modifiers ────
        var type_param_host false
        if k = KindClassDeclaration
            set type_param_host: true
        if k = KindClassExpression
            set type_param_host: true
        if k = KindMethodDeclaration
            set type_param_host: true
        if k = KindConstructor
            set type_param_host: true
        if k = KindGetAccessor
            set type_param_host: true
        if k = KindSetAccessor
            set type_param_host: true
        if k = KindFunctionExpression
            set type_param_host: true
        if k = KindFunctionDeclaration
            set type_param_host: true
        if k = KindArrowFunction
            set type_param_host: true
        if type_param_host
        {
            let tps AstNode.type_parameters_of(n)
            if this.list_has_unreparsed(tps)
            {
                var lpos 0
                var lend 0
                if this.list_range(tps, &lpos, &lend)
                    this.js_error_at_range(lpos, lend, DiagType_parameter_declarations_can_only_be_used_in_TypeScript_files)
            }
        }

        ; ... and the arm it falls through into: every modifier that is not a
        ; decorator and is not one of the five JavaScript may carry.
        var modifier_host type_param_host
        if k = KindVariableStatement
            set modifier_host: true
        if k = KindPropertyDeclaration
            set modifier_host: true
        if modifier_host
        {
            let mods AstNode.modifiers_of(n)
            if mods <> null
            {
                var i 0
                let count mods.get_length() as int
                while i < count
                {
                    let m *(mods.get_buffer() + i)
                    if m <> null
                    {
                        if (AstNode.flags_of(m) & NodeFlagsReparsed) = 0
                        {
                            let mk AstNode.kind_of(m)
                            if mk <> KindDecorator
                            {
                                if (AstNode.modifier_to_flag(mk) & ModifierFlagsJavaScript) = 0
                                    this.js_error_at_range(m.pos, m.end, DiagThe_0_modifier_can_only_be_used_in_TypeScript_files)
                            }
                        }
                    }
                    set i: i + 1
                }
            }
        }

        if k = KindParameter
        {
            let mods AstNode.modifiers_of(n)
            if this.list_has_modifier(mods)
            {
                var lpos 0
                var lend 0
                if this.list_range(mods, &lpos, &lend)
                    this.js_error_at_range(lpos, lend, DiagParameter_modifiers_can_only_be_used_in_TypeScript_files)
            }
        }

        var type_arg_host false
        if k = KindCallExpression
            set type_arg_host: true
        if k = KindNewExpression
            set type_arg_host: true
        if k = KindExpressionWithTypeArguments
            set type_arg_host: true
        if k = KindJsxSelfClosingElement
            set type_arg_host: true
        if k = KindJsxOpeningElement
            set type_arg_host: true
        if k = KindTaggedTemplateExpression
            set type_arg_host: true
        if type_arg_host
        {
            let tas AstNode.type_arguments_of(n)
            if this.list_has_unreparsed(tas)
            {
                var lpos 0
                var lend 0
                if this.list_range(tas, &lpos, &lend)
                    this.js_error_at_range(lpos, lend, DiagType_arguments_can_only_be_used_in_TypeScript_files)
            }
        }

        n
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; JSDOC — slice 21, ported from the reference's internal/parser/jsdoc.go
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; ★★★ THE THIRD GRAMMAR, AND THE THIRD YARDSTICK WITH IT. What a JSDoc
    ; comment produces is NOT in the tree the parser yardstick walks: the
    ; reference hangs it off the documented node through a side table
    ; (jsdocCache), reachable only through Node.JSDoc(file) — and for a TS/TSX
    ; file it does not parse it during ParseSourceFile at all, only on the first
    ; such access. So a JSDoc defect is invisible to both existing yardsticks in
    ; BOTH directions: a port producing no JSDoc and a port producing a wrong
    ; tree compare exactly equal there. tests/oracle/jsdoc.go is what makes this
    ; slice measurable, and building it was the first thing this slice did.
    ;
    ; ── What is different about this grammar ────────────────────────────────
    ;
    ; (1) The SCANNER RUNS ON A TRUNCATED TEXT. parse_jsdoc_comment sets the
    ;     scanner's end to just before the closing `*/`, so the delimiter is
    ;     end-of-file to everything inside and no routine has to test for it.
    ;     Nothing else in this port moves the end.
    ;
    ; (2) WHITESPACE AND NEWLINES ARE TOKENS. The comment's LAYOUT is grammar
    ;     here — the margin decides where a tag's comment ends — so scan() is
    ;     not used at all inside a comment; scan_jsdoc_token is.
    ;
    ; (3) ... except where it IS. Every type is parsed by the ORDINARY type
    ;     parser, entered through parse_jsdoc_type, which is why the scanner
    ;     needs skip_jsdoc_leading_asterisks: a type written across two lines
    ;     of a comment must not see the margin's `*` as an operator.
    ;
    ; (4) The COMMENT TEXT is accumulated as a list of source RANGES, and its
    ;     lengths are load-bearing even though its bytes are never stored:
    ;     `indent` counts them, `margin` is compared against `indent`, and the
    ;     margin decides which whitespace becomes part of a comment. So this
    ;     port carries the accumulation faithfully and drops only the bytes.
    ;     See the JSDocText arm in ast.scaly for why the bytes are dropped.
    ;
    ; (5) The reference reuses three SLICE BUFFERS across parses
    ;     (jsdocCommentsSpace, jsdocTagCommentsSpace, jsdocTagCommentsPartsSpace)
    ;     and one of them carries a comment asking whether the routine can call
    ;     itself. That is allocation reuse for a garbage collector; under RBMM a
    ;     fresh accumulator per invocation costs a bump and dies with the region,
    ;     so the buffers are NOT ported and the reentrancy question does not
    ;     arise. This is the one place the port is deliberately simpler than the
    ;     reference, and it is simpler because the memory model is different.

    ; ── the comment accumulator ─────────────────────────────────────────────
    ;
    ; The reference's `comments []string`. Every part is a slice of the SOURCE —
    ; a token's text, a token's value, or a suffix of one — so a pair of
    ; absolute offsets is the faithful representation and no bytes are copied.
    ;
    ; The array holds start and end INTERLEAVED and the live count travels as an
    ; ordinary local, because the operations the reference performs on the slice
    ; are `append`, truncate-to-n and drop-leading-k, and Array offers `add`,
    ; `put` and `clear` but no truncation. Keeping the count outside makes
    ; truncation free and re-pushing after one a `put` rather than an `add`.

    procedure cparts_new(this) returns pointer[Array[int]]
    {
        let a host.allocate(sizeof Array[int], alignof Array[int]) as pointer[Array[int]]
        set *a: Array[int]()
        a
    }

    procedure cparts_push(this, a: pointer[Array[int]], count: int, s: int, e: int) returns int
    {
        let n a.get_length() as int
        if (count * 2) < n
        {
            a.put((count * 2) as size_t, s)
            a.put(((count * 2) + 1) as size_t, e)
        }
        else
        {
            a.add(s)
            a.add(e)
        }
        count + 1
    }

    function cparts_start(a: pointer[Array[int]], i: int) returns int
        *(a.get_buffer() + (i * 2))

    function cparts_end(a: pointer[Array[int]], i: int) returns int
        *(a.get_buffer() + ((i * 2) + 1))

    procedure cparts_set_end(this, a: pointer[Array[int]], i: int, e: int)
        a.put(((i * 2) + 1) as size_t, e)

    ; The reference's `strings.TrimRightFunc(s, stringutil.IsWhiteSpaceLike)`,
    ; answering the new END rather than a new string. Decoding backwards is what
    ; makes a multi-byte separator (U+2028) trim as one character.
    function trim_end_of(this, s: int, e: int) returns int
    {
        var p e
        while p > s
        {
            let c scanner.utf8_decode_last_before(p)
            if not Scanner.is_white_space_like(c)
                return p
            set p: p - scanner.utf8_last_size_before(p)
        }
        s
    }

    ; The final trim of the whole comment uses Go's `unicode.IsSpace`, NOT
    ; IsWhiteSpaceLike — a wider set that includes U+0085 and the Unicode space
    ; categories but NOT U+FEFF, which IsWhiteSpaceSingleLine does include. The
    ; two differ on exactly two code points and the reference uses each of them
    ; once, so both are carried rather than unified.
    function is_unicode_space(c: int) returns bool
    {
        if (c = 9) or (c = 10) or (c = 11) or (c = 12) or (c = 13) or (c = 32)
            return true
        if (c = 0x0085) or (c = 0x00A0) or (c = 0x1680)
            return true
        if (c >= 0x2000) and (c <= 0x200A)
            return true
        if (c = 0x2028) or (c = 0x2029) or (c = 0x202F) or (c = 0x205F)
            return true
        c = 0x3000
    }

    function trim_end_unicode_space_of(this, s: int, e: int) returns int
    {
        var p e
        while p > s
        {
            let c scanner.utf8_decode_last_before(p)
            if not is_unicode_space(c)
                return p
            set p: p - scanner.utf8_last_size_before(p)
        }
        s
    }

    ; removeTrailingWhitespace. Trims the last non-empty part and drops every
    ; all-whitespace part after it; answers the new COUNT.
    procedure cparts_remove_trailing_whitespace(this, a: pointer[Array[int]], first: int, count: int) returns int
    {
        var stop count
        var i count - 1
        while i >= first
        {
            let s cparts_start(a, i)
            let trimmed this.trim_end_of(s, cparts_end(a, i))
            if trimmed = s
                set stop: i
            else
            {
                this.cparts_set_end(a, i, trimmed)
                return stop
            }
            set i: i - 1
        }
        stop
    }

    ; removeLeadingNewlines — `strings.TrimLeft(comments[i], "\r\n") == ""`, so
    ; a part of SPACES is not empty here and is not dropped. Answers the new
    ; FIRST index.
    procedure cparts_remove_leading_newlines(this, a: pointer[Array[int]], first: int, count: int) returns int
    {
        var i first
        while i < count
        {
            var p cparts_start(a, i)
            let e cparts_end(a, i)
            while p < e
            {
                let c scanner.byte_at(p)
                if (c <> 13) and (c <> 10)
                    break
                set p: p + 1
            }
            if p < e
                return i
            set i: i + 1
        }
        i
    }

    ; ── comment ranges ──────────────────────────────────────────────────────
    ;
    ; The reference's scanner.GetLeadingCommentRanges / GetTrailingCommentRanges,
    ; which it exposes as an ITERATOR (`iter.Seq[ast.CommentRange]`) and consumes
    ; in a `for … range`. Here the ranges are appended to a caller-supplied array
    ; instead: an iterator in Go is a closure, and Scaly's only escaping-closure
    ; form is `return \x: …` (§3.9d, the same substitution ForEachChild took).
    ;
    ; ★ The reference's CommentRange carries a KIND and a `HasTrailingNewLine`
    ; flag besides the range. Neither is stored, because the only consumer this
    ; port has is get_jsdoc_comment_ranges, whose filter reads Pos and End alone
    ; — a §3.5ao omission with its reader named: the flag's readers are the
    ; emitter's comment writer and the language service's formatter.
    ;
    ; ★★ `collecting` starts FALSE for a leading scan and true for a trailing
    ; one, and that is the whole difference between them: a trailing comment is
    ; one that follows a token on the SAME LINE, so the scan stops at the first
    ; line break; a leading scan skips whatever precedes the first line break and
    ; only starts collecting after it. Both stop at the first character that is
    ; neither whitespace nor a comment.
    procedure collect_comment_ranges(this, from: int, trailing: bool, out: pointer[Array[int]])
    {
        var pending_pos 0
        var pending_end 0
        var has_pending false
        var collecting trailing
        var pos from
        if pos = 0
        {
            set collecting: true
            ; ★★★ The SHEBANG, and it is the one line of this routine that is
            ; easy to leave out and reachable in one shape: `#!/usr/bin/env node`
            ; followed by a JSDoc comment and the statement it documents. That
            ; statement's POS is 0 — a node's position is its FULL start — so the
            ; walk begins on the `#`, which is neither whitespace nor a comment
            ; and ends the scan before the comment is seen. The whole comment then
            ; vanishes, silently and only in a file that has a shebang.
            ;
            ; The reference reaches it through isShebangTrivia/scanShebangTrivia,
            ; which it PANICS on at any position but 0; here the test is the
            ; `pos = 0` this block is already inside.
            if scanner.byte_at(0) = ("#" as char) as int
            {
                if scanner.byte_at(1) = ("!" as char) as int
                {
                    set pos: 2
                    while pos < scanner.source_end()
                    {
                        if Scanner.is_line_break_rune(scanner.utf8_decode_at(pos))
                            break
                        set pos: pos + scanner.utf8_size_at(pos)
                    }
                }
            }
        }

        let limit scanner.source_end()
        repeat
        {
            if pos < 0
                break
            if pos >= limit
                break
            let ch scanner.utf8_decode_at(pos)
            let sz scanner.utf8_size_at(pos)

            if (ch = 13) or (ch = 10)
            {
                if ch = 13
                {
                    if scanner.byte_at(pos + 1) = 10
                        set pos: pos + 1
                }
                set pos: pos + 1
                if trailing
                    break
                set collecting: true
                continue
            }

            if (ch = 9) or (ch = 11) or (ch = 12) or (ch = 32)
            {
                set pos: pos + 1
                continue
            }

            if ch = ("/" as char) as int
            {
                let next scanner.byte_at(pos + 1)
                if (next <> (("/" as char) as int)) and (next <> (("*" as char) as int))
                    break
                let start_pos pos
                set pos: pos + 2
                if next = ("/" as char) as int
                {
                    while pos < limit
                    {
                        if Scanner.is_line_break_rune(scanner.utf8_decode_at(pos))
                            break
                        set pos: pos + scanner.utf8_size_at(pos)
                    }
                }
                else
                {
                    ; `strings.Index(text[pos:], "*/")`, and the reference runs
                    ; to the END of the text when there is none — an unterminated
                    ; block comment swallows the rest of the file.
                    var p pos
                    var found 0 - 1
                    while (p + 1) < limit
                    {
                        if scanner.byte_at(p) = ("*" as char) as int
                        {
                            if scanner.byte_at(p + 1) = ("/" as char) as int
                            {
                                set found: p + 2
                                break
                            }
                        }
                        set p: p + 1
                    }
                    if found >= 0
                        set pos: found
                    else
                        set pos: limit
                }

                if collecting
                {
                    if has_pending
                    {
                        out.add(pending_pos)
                        out.add(pending_end)
                    }
                    set pending_pos: start_pos
                    set pending_end: pos
                    set has_pending: true
                }
                continue
            }

            ; A non-ASCII whitespace character — the reference's default arm.
            if ch > 127
            {
                if Scanner.is_white_space_like(ch)
                {
                    set pos: pos + sz
                    continue
                }
            }
            break
        }

        if has_pending
        {
            out.add(pending_pos)
            out.add(pending_end)
        }
    }

    ; The reference's GetJSDocCommentRanges. Seven node kinds take their JSDoc
    ; from the TRAILING comments of the position before them as well as from the
    ; leading ones — a parameter documented as `/** the x */ x` is the shape —
    ; and the trailing scan comes FIRST, which is the order the ranges end up in.
    ;
    ; The filter is the reference's, and each clause is a real case: a comment
    ; that reaches past the node's own end is not its documentation, `/**/` is
    ; not JSDoc (four characters, and the fourth must not be `/`), and a comment
    ; must open with `/**`.
    procedure get_jsdoc_comment_ranges(this, n: pointer[AstNode], out: pointer[Array[int]])
    {
        let pos AstNode.pos_of(n)
        let k AstNode.kind_of(n)
        var trailing_too false
        if k = KindParameter
            set trailing_too: true
        if k = KindTypeParameter
            set trailing_too: true
        if k = KindFunctionExpression
            set trailing_too: true
        if k = KindArrowFunction
            set trailing_too: true
        if k = KindParenthesizedExpression
            set trailing_too: true
        if k = KindVariableDeclaration
            set trailing_too: true
        if k = KindExportSpecifier
            set trailing_too: true

        let raw this.cparts_new()
        if trailing_too
            this.collect_comment_ranges(pos, true, raw)
        this.collect_comment_ranges(pos, false, raw)

        let node_end AstNode.end_of(n)
        let count (raw.get_length() as int) / 2
        var i 0
        while i < count
        {
            let s *(raw.get_buffer() + (i * 2))
            let e *(raw.get_buffer() + ((i * 2) + 1))
            set i: i + 1
            if e > node_end
                continue
            if (e - s) < 4
                continue
            if scanner.byte_at(s + 1) <> ("*" as char) as int
                continue
            if scanner.byte_at(s + 2) <> ("*" as char) as int
                continue
            if scanner.byte_at(s + 3) = ("/" as char) as int
                continue
            out.add(s)
            out.add(e)
        }
    }

    ; ── the comment pragmas ─────────────────────────────────────────────────
    ;
    ; ★★★ getCommentPragmas + extractPragmas + processPragmasIntoFields, and the
    ; only thing a parser yardstick can see of them is TWO DIAGNOSTICS: TS1084
    ; for a triple-slash `<reference>` whose arguments name none of types/lib/
    ; path/no-default-lib, and TS1453 for a `resolution-mode` that is neither
    ; `require` nor `import`. Everything else a pragma does is a FIELD on the
    ; SourceFile — ReferencedFiles, TypeReferenceDirectives, LibReferenceDirectives,
    ; CheckJsDirective — whose readers are the program builder (which files to
    ; pull in), the emitter and the checker, none of which this port has.
    ;
    ; ★ Stated omissions, each with its reader, per §3.5ao:
    ;   · the three FileReference lists and CheckJsDirective are not STORED. They
    ;     are computed exactly far enough to decide which arm of the switch a
    ;     pragma takes, because that decision is what produces the diagnostics.
    ;   · the MULTI-LINE arm of extractPragmas — `@jsx`, `@jsxfrag`,
    ;     `@jsximportsource`, `@jsxruntime` inside a `/* */` — is not ported. It
    ;     produces no diagnostic in any input and its only readers are the
    ;     emitter's JSX factory selection and the checker's jsxImportSource, so
    ;     porting it would be forty lines nothing in this repository can measure
    ;     in either direction.
    ;   · an argument whose name is none of the six the switch reads is not kept.
    ;     The reference puts it in the map and never looks it up, and the default
    ;     arm asks only about types/lib/path/no-default-lib — so `foo="bar"` gets
    ;     TS1084 either way. It still has to be PARSED, because the loop only
    ;     stops on a name that is empty or on a missing `=` or quote.
    ;
    ; ★★ The pragma scan reads the LEADING comment ranges of position 0, so it
    ; stops at the first thing that is neither whitespace nor a comment: a
    ; `/// <reference …>` below the first statement is not a pragma at all.
    procedure process_pragmas(this)
    {
        let ranges this.cparts_new()
        this.collect_comment_ranges(0, false, ranges)
        let count (ranges.get_length() as int) / 2
        var i 0
        while i < count
        {
            let s *(ranges.get_buffer() + (i * 2))
            let e *(ranges.get_buffer() + ((i * 2) + 1))
            set i: i + 1
            this.extract_pragmas(s, e)
        }
    }

    ; extractPragmas' single-line arm, and then the `reference` arm of
    ; processPragmasIntoFields on what it found. The reference keeps the two
    ; apart because it collects every pragma of the file before processing any;
    ; here each comment yields at most one pragma and the comments arrive in
    ; order, so processing per comment leaves the diagnostics in the same
    ; sequence. The one behaviour that split would buy is CheckJsDirective's
    ; "last of check/nocheck wins", which nothing here reads.
    ;
    ; ★ `pos += 10` rather than `pos += len(tagName) + 1` is the reference's own
    ; line, and it is safe for the same reason there: the branch is only reached
    ; when the name IS `reference`, i.e. when nine characters follow the `<`.
    procedure extract_pragmas(this, comment_pos: int, comment_end: int)
    {
        ; A single-line comment only. The KIND the reference stores on a comment
        ; range is derivable from the two bytes that open it, which is why
        ; collect_comment_ranges does not carry one.
        if scanner.byte_at(comment_pos + 1) <> ("/" as char) as int
            return

        var pos comment_pos + 2
        let triple_slash this.pragma_match(pos, comment_end, "/")
        if triple_slash
            set pos: pos + 1
        set pos: this.pragma_skip_blanks(pos, comment_end)

        if triple_slash and this.pragma_match(pos, comment_end, "<")
        {
            let tag_end this.pragma_extract_name(pos + 1, comment_end)
            if this.pragma_name_is(pos + 1, tag_end, "reference") = false
                return
            set pos: pos + 10

            ; The six argument names the switch below reads, as a flat table of
            ; (id, value_pos, value_end) triples. An id already present is
            ; OVERWRITTEN, because the reference's store is a map.
            let args this.cparts_new()
            repeat
            {
                set pos: this.pragma_skip_blanks(pos, comment_end)
                if this.pragma_match(pos, comment_end, "/>")
                    break
                let name_end this.pragma_extract_name(pos, comment_end)
                if name_end = pos
                    break
                let id this.pragma_arg_id(pos, name_end)
                set pos: this.pragma_skip_blanks(name_end, comment_end)
                if this.pragma_match(pos, comment_end, "=") = false
                    break
                set pos: this.pragma_skip_blanks(pos + 1, comment_end)
                let value_end this.pragma_extract_quoted_string(pos, comment_end)
                if value_end < 0
                    break
                if id >= 0
                    this.pragma_arg_set(args, id, pos + 1, value_end)
                set pos: value_end + 1
            }

            this.process_reference_pragma(comment_pos, comment_end, args)
            return
        }

        ; `@ts-check` / `@ts-nocheck`. Recognised and then dropped: the field it
        ; sets is CheckJsDirective, whose reader is the checker.
        if this.pragma_match(pos, comment_end, "@")
            return
    }

    ; processPragmasIntoFields' `reference` arm. Its four cases are ORDERED and
    ; the order is load-bearing: `no-default-lib="true"` swallows the directive
    ; whatever else it carries, and `types` beats `lib` beats `path`. Only the
    ; last case and the resolution-mode parse produce anything visible here.
    procedure process_reference_pragma(this, comment_pos: int, comment_end: int, args: pointer[Array[int]])
    {
        if this.pragma_arg_value_is(args, PragmaArgNoDefaultLib, "true")
            return
        if this.pragma_arg_find(args, PragmaArgTypes) >= 0
        {
            let rm this.pragma_arg_find(args, PragmaArgResolutionMode)
            if rm >= 0
                this.parse_resolution_mode(*(args.get_buffer() + rm + 1), *(args.get_buffer() + rm + 2))
            return
        }
        if this.pragma_arg_find(args, PragmaArgLib) >= 0
            return
        if this.pragma_arg_find(args, PragmaArgPath) >= 0
            return
        this.parse_error_at_range(comment_pos, comment_end, DiagInvalid_reference_directive_syntax)
    }

    ; parseResolutionMode. The RESULT — a module kind — has no reader in this
    ; port; the diagnostic is the whole of what is left.
    procedure parse_resolution_mode(this, value_pos: int, value_end: int)
    {
        if this.pragma_text_is(value_pos, value_end, "import")
            return
        if this.pragma_text_is(value_pos, value_end, "require")
            return
        this.parse_error_at(value_pos, value_end, DiagX_resolution_mode_should_be_either_require_or_import)
    }

    ; `strings.HasPrefix(text[pos:], s)`. Past the end is false rather than a
    ; panic, which is the one place Go's slice would have raised instead.
    function pragma_match(this, pos: int, limit: int, lit: pointer[const_char]) returns bool
    {
        var i 0
        repeat
        {
            let c *(lit + i) as int
            if c = 0
                return true
            if (pos + i) >= limit
                return false
            if scanner.byte_at(pos + i) <> c
                return false
            set i: i + 1
        }
        true
    }

    function pragma_skip_blanks(this, pos: int, limit: int) returns int
    {
        var p pos
        while p < limit
        {
            let c scanner.byte_at(p)
            if (c <> (" " as char) as int) and (c <> ("\t" as char) as int)
                return p
            set p: p + 1
        }
        p
    }

    ; extractName — letters and `-`, and the reference lowercases the result, so
    ; every comparison against it below is case-insensitive.
    function pragma_extract_name(this, pos: int, limit: int) returns int
    {
        var p pos
        while p < limit
        {
            let c scanner.byte_at(p)
            var ok false
            if (c >= (("A" as char) as int)) and (c <= (("Z" as char) as int))
                set ok: true
            if (c >= (("a" as char) as int)) and (c <= (("z" as char) as int))
                set ok: true
            if c = ("-" as char) as int
                set ok: true
            if ok = false
                return p
            set p: p + 1
        }
        p
    }

    ; extractQuotedString. Answers the position of the CLOSING quote, or -1 when
    ; there is no opening quote or the string is never closed — the second is
    ; what `path="missingquote.ts />` is, and it is why that line ends up with an
    ; empty argument map and TS1084.
    function pragma_extract_quoted_string(this, pos: int, limit: int) returns int
    {
        if pos >= limit
            return 0 - 1
        let quote scanner.byte_at(pos)
        if (quote <> (("'" as char) as int)) and (quote <> (("\"" as char) as int))
            return 0 - 1
        var p pos + 1
        while p < limit
        {
            if scanner.byte_at(p) = quote
                return p
            set p: p + 1
        }
        0 - 1
    }

    ; A name in the source, compared against an ASCII literal case-INSENSITIVELY
    ; (the reference lowercases the name it extracted).
    function pragma_name_is(this, pos: int, end: int, lit: pointer[const_char]) returns bool
    {
        var i 0
        while (pos + i) < end
        {
            let c *(lit + i) as int
            if c = 0
                return false
            var b scanner.byte_at(pos + i)
            if (b >= (("A" as char) as int)) and (b <= (("Z" as char) as int))
                set b: b + 32
            if b <> c
                return false
            set i: i + 1
        }
        (*(lit + i) as int) = 0
    }

    ; A VALUE in the source, compared exactly — a quoted string is not a name and
    ; the reference does not fold its case.
    function pragma_text_is(this, pos: int, end: int, lit: pointer[const_char]) returns bool
    {
        var i 0
        while (pos + i) < end
        {
            let c *(lit + i) as int
            if c = 0
                return false
            if scanner.byte_at(pos + i) <> c
                return false
            set i: i + 1
        }
        (*(lit + i) as int) = 0
    }

    function pragma_arg_id(this, pos: int, end: int) returns int
    {
        if this.pragma_name_is(pos, end, "types")
            return PragmaArgTypes
        if this.pragma_name_is(pos, end, "lib")
            return PragmaArgLib
        if this.pragma_name_is(pos, end, "path")
            return PragmaArgPath
        if this.pragma_name_is(pos, end, "resolution-mode")
            return PragmaArgResolutionMode
        if this.pragma_name_is(pos, end, "preserve")
            return PragmaArgPreserve
        if this.pragma_name_is(pos, end, "no-default-lib")
            return PragmaArgNoDefaultLib
        0 - 1
    }

    ; The index of an argument's triple, or -1.
    function pragma_arg_find(this, args: pointer[Array[int]], id: int) returns int
    {
        let n args.get_length() as int
        var i 0
        while i < n
        {
            if *(args.get_buffer() + i) = id
                return i
            set i: i + 3
        }
        0 - 1
    }

    ; args[name] = value — an existing entry is replaced, because the store is a
    ; map and `<reference path="a" path="b" />` names one file.
    procedure pragma_arg_set(this, args: pointer[Array[int]], id: int, value_pos: int, value_end: int)
    {
        let at this.pragma_arg_find(args, id)
        if at >= 0
        {
            args.put((at + 1) as size_t, value_pos)
            args.put((at + 2) as size_t, value_end)
            return
        }
        args.add(id)
        args.add(value_pos)
        args.add(value_end)
    }

    function pragma_arg_value_is(this, args: pointer[Array[int]], id: int, lit: pointer[const_char]) returns bool
    {
        let at this.pragma_arg_find(args, id)
        if at < 0
            return false
        this.pragma_text_is(*(args.get_buffer() + at + 1), *(args.get_buffer() + at + 2), lit)
    }

    ; ── the JSDoc token helpers ─────────────────────────────────────────────

    procedure next_token_jsdoc(this) returns int
    {
        set token: scanner.scan_jsdoc_token()
        token
    }

    procedure next_jsdoc_comment_text_token(this, in_backticks: bool) returns int
    {
        set token: scanner.scan_jsdoc_comment_text_token(in_backticks)
        token
    }

    procedure parse_expected_jsdoc(this, kind: int) returns bool
    {
        if token = kind
        {
            this.next_token_jsdoc()
            return true
        }
        ; The reference PANICS on a kind that is neither a keyword nor
        ; punctuation ("Invalid JSDoc kind"), which is unreachable for the call
        ; sites this port has; the report below is the ordinary one.
        this.parse_error_at_current_token(DiagX_0_expected)
        false
    }

    procedure parse_optional_jsdoc(this, t: int) returns bool
    {
        if token = t
        {
            this.next_token_jsdoc()
            return true
        }
        false
    }

    ; ★★★ THE ORDINARY parse_token_node, NOT A JSDOC ONE — and the reference has
    ; no JSDoc variant of it at all. That is not an oversight there and it is the
    ; only place in this grammar where the ORDINARY scanner is deliberately used
    ; to leave a JSDoc token: `p.parseTokenNode()` advances with `nextToken()`,
    ; which SKIPS TRIVIA, so the token after a consumed backtick has its full
    ; start at the whitespace rather than past it — and that full start is what
    ; the following tag comment begins at.
    ;
    ; Measured, on `` @param `d` markdown-quoted ``: with a JSDoc-scanning
    ; variant the whitespace becomes a token of its own, skip_whitespace_or_asterisk
    ; consumes it, and the JSDocText starts ONE BYTE LATE. It is the only
    ; difference the whole fixture produces, which is why it needed a fixture —
    ; no corpus unit has a backquoted @param name.
    procedure parse_optional_token_jsdoc(this, kind: int) returns pointer[AstNode]
    {
        if token = kind
            return this.parse_token_node()
        null
    }

    procedure parse_expected_token_jsdoc(this, kind: int) returns pointer[AstNode]
    {
        let optional this.parse_optional_token_jsdoc(kind)
        if optional <> null
            return optional
        this.parse_error_at_current_token(DiagX_0_expected)
        this.finish_node(this.new_node(kind, NodeData.Token(TokenData())), this.node_pos())
    }

    ; ── the type grammar inside a comment ───────────────────────────────────

    ; parseJSDocType. The ORDINARY type parser runs here — that is the point of
    ; the routine — with two things around it: the scanner is told to eat a
    ; leading `*` per line, so a type may be written across the comment's
    ; margin, and a trailing `=` makes the whole thing OPTIONAL, which is the
    ; Closure spelling `{string=}`.
    procedure parse_jsdoc_type(this) returns pointer[AstNode]
    {
        scanner.set_skip_jsdoc_leading_asterisks(true)
        let pos this.node_pos()

        let has_dot_dot_dot this.parse_optional(KindDotDotDotToken)
        var t this.parse_type_or_type_predicate()
        scanner.set_skip_jsdoc_leading_asterisks(false)
        if has_dot_dot_dot
            set t: this.finish_node(this.new_node(KindJSDocVariadicType, NodeData.JSDocVariadicType(WrappedTypeData(t))), pos)
        if token = KindEqualsToken
        {
            this.next_token()
            return this.finish_node(this.new_node(KindJSDocOptionalType, NodeData.JSDocOptionalType(WrappedTypeData(t))), pos)
        }
        t
    }

    ; parseJSDocAllType — the bare `*`, which is Closure's "any".
    procedure parse_jsdoc_all_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        this.finish_node(this.new_node(KindJSDocAllType, NodeData.JSDocAllType(TokenData())), pos)
    }

    ; parseJSDocTypeExpression. `mayOmitBraces` is true for the two tags whose
    ; type may be written bare (`@type string`, `@this Foo`) and false
    ; everywhere else, where a missing `{` is reported.
    ;
    ; ★ The JSDoc CONTEXT FLAG is set around the type and not around the whole
    ; comment: it is what makes `?` and `!` prefix operators and what
    ; parse_non_array_type tests. finish_node stamps it onto every node built
    ; inside, which is how the flag reaches the yardstick.
    procedure parse_jsdoc_type_expression(this, may_omit_braces: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var has_brace false
        if may_omit_braces
            set has_brace: this.parse_optional(KindOpenBraceToken)
        else
            set has_brace: this.parse_expected(KindOpenBraceToken)
        let saved context_flags
        this.set_context_flags(NodeFlagsJSDoc, true)
        let t this.parse_jsdoc_type()
        set context_flags: saved
        if has_brace
            this.parse_expected_jsdoc(KindCloseBraceToken)
        this.finish_node(this.new_node(KindJSDocTypeExpression, NodeData.JSDocTypeExpression(WrappedTypeData(t))), pos)
    }

    ; parseJSDocNameReference — `@see {Foo.bar}`. The ResetPos is the reference's
    ; and is load-bearing: the name was read with the ORDINARY scanner (through
    ; parse_jsdoc_link_name's parse_identifier_name), so the scan has to be put
    ; back to the token's full start and re-read as a JSDoc token before the
    ; caller's comment loop continues.
    procedure parse_jsdoc_name_reference(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let has_brace this.parse_optional(KindOpenBraceToken)
        let entity_name this.parse_jsdoc_link_name()
        if has_brace
            this.parse_expected_jsdoc(KindCloseBraceToken)
        scanner.reset_pos(scanner.token_full_start())
        this.next_token_jsdoc()
        this.finish_node(this.new_node(KindJSDocNameReference, NodeData.JSDocNameReference(WrappedTypeData(entity_name))), pos)
    }

    ; ── the comment ─────────────────────────────────────────────────────────

    ; parseJSDocComment. The SAVE-AND-RESTORE around it is the whole of the
    ; routine's outer half, and every field it touches is one the inner parse
    ; will disturb: the scanner's END (truncated to just before `*/`), its whole
    ; state, the token, the context flags, the parsing contexts, and the
    ; diagnostics accumulated inside.
    ;
    ; ★★★ THE DIAGNOSTICS ARE DISCARDED for a TS file and MOVED to a separate
    ; list for a JS one. That is not a shortcut: the reference does exactly this,
    ; and it is why the third yardstick compares SPANS and not diagnostics — a
    ; JSDoc parse error has no observable code anywhere the port can compare it.
    ; This port drops them rather than keeping a second list, and says so here:
    ; the list would have no reader, and its reader arrives with the checker.
    procedure parse_jsdoc_comment(this, parent: pointer[AstNode], start: int, comment_end: int, full_start: int) returns pointer[AstNode]
    {
        var e comment_end
        if e = 0 - 1
            set e: scanner.source_end()

        ; isJSDocLikeText — the caller has already filtered on it, but the
        ; reference re-asks and answers nil rather than trapping.
        if (e - start) < 4
            return null
        if scanner.byte_at(start + 1) <> ("*" as char) as int
            return null
        if scanner.byte_at(start + 2) <> ("*" as char) as int
            return null
        if scanner.byte_at(start + 3) = ("/" as char) as int
            return null

        let saved_end scanner.source_end()
        let saved_parsing_contexts parsing_contexts
        let saved this.mark()
        let saved_diagnostics_len diagnostics.length()

        ; The initial indent is `start + 4` — past `/** ` — measured from the
        ; beginning of the LINE the comment opens on. The `+ 1` in the reference
        ; is what makes "no newline before start" answer 0 rather than -1.
        var line_start 0
        var p start - 1
        while p >= 0
        {
            if scanner.byte_at(p) = 10
            {
                set line_start: p + 1
                break
            }
            set p: p - 1
        }
        let initial_indent (start + 4) - line_start

        ; -2 for the trailing `*/`: inside the comment the delimiter is the end
        ; of the text, so nothing has to test for it.
        scanner.set_end(e - 2)
        this.set_context_flags(NodeFlagsJSDoc, true)
        set parsing_contexts: parsing_contexts | (1 << PCJSDocComment)
        scanner.reset_pos(start + 3)

        let comment this.parse_jsdoc_comment_worker(start, e, full_start, initial_indent)

        diagnostics.truncate(saved_diagnostics_len)
        scanner.set_end(saved_end)
        set parsing_contexts: saved_parsing_contexts
        this.rewind(saved)
        comment
    }

    ; parseJSDocCommentWorker — the state machine that turns a comment into a
    ; JSDoc node: prose becomes JSDocText, `{@link X}` becomes a node of its own,
    ; and an `@` at the start of a line hands over to parse_tag.
    ;
    ; ★★★ THE `state` VARIABLE IS THE GRAMMAR. BeginningOfLine admits a tag;
    ; SawAsterisk is what a margin `*` leaves behind and still admits one;
    ; SavingComments and SavingBackticks do not, and they also switch the
    ; SCANNER — a comment run is read by scan_jsdoc_comment_text_token and
    ; everything else by scan_jsdoc_token. The reference PANICS if whitespace
    ; arrives while saving, because the text scanner would have eaten it.
    procedure parse_jsdoc_comment_worker(this, start: int, comment_end: int, full_start: int, initial_indent: int) returns pointer[AstNode]
    {
        var indent initial_indent
        let tags AstNode.new_node_list(host)
        var tags_pos 0 - 1
        var tags_end 0 - 1
        var state JSDOC_STATE_SAW_ASTERISK
        var backtick_count 0
        var in_fenced_code_block false
        let comment_parts AstNode.new_node_list(host)
        let comments this.cparts_new()
        var ccount 0
        var cfirst 0
        var comments_pos 0 - 1
        var link_end start
        var margin 0 - 1

        this.next_token_jsdoc()
        while this.parse_optional_jsdoc(KindWhitespaceTrivia)
            ; the reference's empty `for` body
            0
        if this.parse_optional_jsdoc(KindNewLineTrivia)
        {
            set state: JSDOC_STATE_BEGINNING_OF_LINE
            set indent: 0
        }

        repeat
        {
            ; Three or more consecutive backticks toggle a fenced code block, and
            ; the count is closed out by the first token that is not a backtick.
            if token <> KindBacktickToken
            {
                if backtick_count > 0
                {
                    if backtick_count >= 3
                        set in_fenced_code_block: not in_fenced_code_block
                    set backtick_count: 0
                }
            }

            var handled false

            if token = KindEndOfFile
                break

            if token = KindAtToken
            {
                set handled: true
                var is_tag true
                if in_fenced_code_block
                    set is_tag: false
                if not scanner.can_follow_jsdoc_at()
                    set is_tag: false
                if not is_tag
                {
                    if in_fenced_code_block
                        set state: JSDOC_STATE_SAVING_BACKTICKS
                    else
                        set state: JSDOC_STATE_SAVING_COMMENTS
                    if margin = 0 - 1
                        set margin: indent
                    set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                    set indent: indent + (scanner.token_end() - scanner.token_start())
                }
                else
                {
                    set ccount: this.cparts_remove_trailing_whitespace(comments, cfirst, ccount)
                    if comments_pos = 0 - 1
                        set comments_pos: this.node_pos()
                    let tag this.parse_tag(tags, indent)
                    if tags_pos = 0 - 1
                        set tags_pos: AstNode.pos_of(tag)
                    tags.add(tag)
                    set tags_end: AstNode.end_of(tag)
                    ; A tag runs to the end of the line, EXCEPT the last one —
                    ; and real comments break that rule, so this "beginning of
                    ; line" is not always one. The reference says so here.
                    set state: JSDOC_STATE_BEGINNING_OF_LINE
                    set margin: 0 - 1
                }
            }

            if (not handled) and (token = KindNewLineTrivia)
            {
                set handled: true
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set state: JSDOC_STATE_BEGINNING_OF_LINE
                set indent: 0
            }

            if (not handled) and (token = KindAsteriskToken)
            {
                set handled: true
                let width scanner.token_end() - scanner.token_start()
                if state = JSDOC_STATE_SAW_ASTERISK
                {
                    ; A second asterisk on a line ends any chance of a tag.
                    set state: JSDOC_STATE_SAVING_COMMENTS
                    if margin = 0 - 1
                        set margin: indent
                    set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                    set indent: indent + width
                }
                else
                {
                    ; The first asterisk on a line is the margin and is ignored.
                    set state: JSDOC_STATE_SAW_ASTERISK
                    set indent: indent + width
                }
            }

            if (not handled) and (token = KindWhitespaceTrivia)
            {
                set handled: true
                let ws_start scanner.token_start()
                let ws_end scanner.token_end()
                let width ws_end - ws_start
                if margin > (0 - 1)
                {
                    if (indent + width) > margin
                    {
                        var existing margin - indent
                        if existing < 0
                            set existing: existing + width
                        if existing < 0
                            set existing: 0
                        set ccount: this.cparts_push(comments, ccount, ws_start + existing, ws_end)
                    }
                }
                set indent: indent + width
            }

            if (not handled) and (token = KindJSDocCommentTextToken)
            {
                set handled: true
                if state <> JSDOC_STATE_SAVING_BACKTICKS
                {
                    if in_fenced_code_block
                        set state: JSDOC_STATE_SAVING_BACKTICKS
                    else
                        set state: JSDOC_STATE_SAVING_COMMENTS
                }
                if margin = 0 - 1
                    set margin: indent
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set indent: indent + (scanner.token_end() - scanner.token_start())
            }

            if (not handled) and (token = KindBacktickToken)
            {
                set handled: true
                set backtick_count: backtick_count + 1
                if state = JSDOC_STATE_SAVING_BACKTICKS
                    set state: JSDOC_STATE_SAVING_COMMENTS
                else
                    set state: JSDOC_STATE_SAVING_BACKTICKS
                if margin = 0 - 1
                    set margin: indent
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set indent: indent + (scanner.token_end() - scanner.token_start())
            }

            if (not handled) and (token = KindOpenBraceToken)
            {
                if in_fenced_code_block
                {
                    set handled: true
                    set state: JSDOC_STATE_SAVING_BACKTICKS
                    if margin = 0 - 1
                        set margin: indent
                    set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                    set indent: indent + (scanner.token_end() - scanner.token_start())
                }
                else
                {
                    set state: JSDOC_STATE_SAVING_COMMENTS
                    let comment_end_pos scanner.token_full_start()
                    let link_start scanner.token_end() - 1
                    let link this.parse_jsdoc_link(link_start)
                    if link <> null
                    {
                        set handled: true
                        if link_end = start
                            set cfirst: this.cparts_remove_leading_newlines(comments, cfirst, ccount)
                        let jsdoc_text this.finish_node_with_end(this.new_node(KindJSDocText, NodeData.JSDocText(TokenData())), link_end, comment_end_pos)
                        comment_parts.add(jsdoc_text)
                        comment_parts.add(link)
                        set cfirst: 0
                        set ccount: 0
                        set link_end: scanner.token_end()
                    }
                    ; else: the reference FALLS THROUGH to the default arm.
                }
            }

            if not handled
            {
                if state <> JSDOC_STATE_SAVING_BACKTICKS
                {
                    if in_fenced_code_block
                        set state: JSDOC_STATE_SAVING_BACKTICKS
                    else
                        set state: JSDOC_STATE_SAVING_COMMENTS
                }
                if margin = 0 - 1
                    set margin: indent
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set indent: indent + (scanner.token_end() - scanner.token_start())
            }

            if (state = JSDOC_STATE_SAVING_COMMENTS) or (state = JSDOC_STATE_SAVING_BACKTICKS)
                this.next_jsdoc_comment_text_token(state = JSDOC_STATE_SAVING_BACKTICKS)
            else
                this.next_token_jsdoc()
        }

        if comments_pos = 0 - 1
            set comments_pos: scanner.token_full_start()

        if ccount > cfirst
        {
            ; The reference trims the LAST part with unicode.IsSpace here, which
            ; is a wider set than the IsWhiteSpaceLike used everywhere else — the
            ; two differ on exactly two code points and it uses each of them once.
            ;
            ; ★ It is INERT in this port and is carried anyway: the trim shortens
            ; a comment PART, nothing reads a part after this line, and the text
            ; node's own span is (link_end, comments_pos), which no part
            ; contributes to. Ported because the reference has it, stated because
            ; a computation whose result nobody reads is otherwise a puzzle — and
            ; it stops being inert the day a JSDocText stores its text (§3.5ao).
            let last ccount - 1
            this.cparts_set_end(comments, last, this.trim_end_unicode_space_of(cparts_start(comments, last), cparts_end(comments, last)))
            let jsdoc_text this.finish_node_with_end(this.new_node(KindJSDocText, NodeData.JSDocText(TokenData())), link_end, comments_pos)
            comment_parts.add(jsdoc_text)
        }

        var tags_list null as pointer[Array[pointer[AstNode]]]
        if tags_pos <> 0 - 1
            set tags_list: tags

        this.finish_node_with_end(this.new_node(KindJSDoc, NodeData.JSDoc(JSDocData(comment_parts, tags_list))), full_start, comment_end)
    }

    ; ── whitespace skipping ─────────────────────────────────────────────────

    ; isNextNonwhitespaceTokenEndOfFile. INFINITE lookahead, as the reference's
    ; own comment says: there can be any number of newlines before the end.
    procedure is_next_nonwhitespace_token_end_of_file(this) returns bool
    {
        repeat
        {
            this.next_token_jsdoc()
            if token = KindEndOfFile
                return true
            if token = KindWhitespaceTrivia
                continue
            if token = KindNewLineTrivia
                continue
            return false
        }
        false
    }

    procedure look_ahead_is_next_nonwhitespace_token_end_of_file(this) returns bool
    {
        let saved this.mark()
        let r this.is_next_nonwhitespace_token_end_of_file()
        this.rewind(saved)
        r
    }

    ; skipWhitespace. The look-ahead is what keeps the whitespace before the end
    ; of a comment OUT of every node's range — a node that ended at the `*/`
    ; would be a different tree.
    procedure skip_whitespace(this)
    {
        if (token = KindWhitespaceTrivia) or (token = KindNewLineTrivia)
        {
            if this.look_ahead_is_next_nonwhitespace_token_end_of_file()
                return
        }
        while (token = KindWhitespaceTrivia) or (token = KindNewLineTrivia)
            this.next_token_jsdoc()
    }

    ; skipWhitespaceOrAsterisk. Answers the INDENT TEXT — the run of whitespace
    ; and margin asterisks after the LAST line break — as a source range, or an
    ; empty one when no line break was crossed.
    ;
    ; ★ The reference builds it with `strings.Join(indents, "")` over the tokens
    ; it collected, and those tokens are CONSECUTIVE (nothing is trivia inside a
    ; JSDoc comment), so the join is exactly the source span from the first kept
    ; token to the last. That is what makes a pair of offsets faithful here and
    ; not an approximation.
    procedure skip_whitespace_or_asterisk(this, out_start: pointer[int], out_end: pointer[int])
    {
        set *out_start: 0
        set *out_end: 0
        if (token = KindWhitespaceTrivia) or (token = KindNewLineTrivia)
        {
            if this.look_ahead_is_next_nonwhitespace_token_end_of_file()
                return
        }

        var preceding_line_break scanner.has_preceding_line_break()
        var seen_line_break false
        var run_start 0 - 1
        var run_end 0
        repeat
        {
            var take false
            if preceding_line_break
            {
                if token = KindAsteriskToken
                    set take: true
            }
            if token = KindWhitespaceTrivia
                set take: true
            if token = KindNewLineTrivia
                set take: true
            if not take
                break

            if run_start < 0
                set run_start: scanner.token_start()
            set run_end: scanner.token_end()

            if token = KindNewLineTrivia
            {
                set preceding_line_break: true
                set seen_line_break: true
                set run_start: 0 - 1
                set run_end: 0
            }
            else
            {
                if token = KindAsteriskToken
                    set preceding_line_break: false
            }
            this.next_token_jsdoc()
        }

        if seen_line_break
        {
            if run_start >= 0
            {
                set *out_start: run_start
                set *out_end: run_end
            }
        }
    }

    ; ── the tag dispatcher ──────────────────────────────────────────────────

    ; parseTag. The reference's `switch tagName.Text()`, and the arms are
    ; independent `if`s that return for the reason mapping decision (2) gives:
    ; an `else if` chain nests one planner level per arm.
    ;
    ; ★ The six SIMPLE tags take a KIND where the reference passes a factory
    ; CLOSURE (§3.5e): every call site is static, so the func value carries no
    ; information the kind does not.
    procedure parse_tag(this, tags: pointer[Array[pointer[AstNode]]], margin: int) returns pointer[AstNode]
    {
        let start scanner.token_start()
        this.next_token_jsdoc()

        let tag_name this.parse_jsdoc_identifier_name(DiagIdentifier_expected)
        var it_start 0
        var it_end 0
        this.skip_whitespace_or_asterisk(&it_start, &it_end)

        if AstNode.text_is(tag_name, "implements")
            return this.parse_implements_or_augments_tag(KindJSDocImplementsTag, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "augments")
            return this.parse_implements_or_augments_tag(KindJSDocAugmentsTag, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "extends")
            return this.parse_implements_or_augments_tag(KindJSDocAugmentsTag, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "public")
            return this.parse_simple_tag(KindJSDocPublicTag, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "private")
            return this.parse_simple_tag(KindJSDocPrivateTag, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "protected")
            return this.parse_simple_tag(KindJSDocProtectedTag, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "readonly")
            return this.parse_simple_tag(KindJSDocReadonlyTag, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "override")
            return this.parse_simple_tag(KindJSDocOverrideTag, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "deprecated")
        {
            set has_deprecated_tag: true
            return this.parse_simple_tag(KindJSDocDeprecatedTag, start, tag_name, margin, it_start, it_end)
        }
        if AstNode.text_is(tag_name, "this")
            return this.parse_this_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "arg")
            return this.parse_parameter_or_property_tag(start, tag_name, PROPERTY_LIKE_PARAMETER, margin)
        if AstNode.text_is(tag_name, "argument")
            return this.parse_parameter_or_property_tag(start, tag_name, PROPERTY_LIKE_PARAMETER, margin)
        if AstNode.text_is(tag_name, "param")
            return this.parse_parameter_or_property_tag(start, tag_name, PROPERTY_LIKE_PARAMETER, margin)
        if AstNode.text_is(tag_name, "return")
            return this.parse_return_tag(tags, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "returns")
            return this.parse_return_tag(tags, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "template")
            return this.parse_template_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "type")
            return this.parse_type_tag(tags, start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "typedef")
            return this.parse_typedef_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "callback")
            return this.parse_callback_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "overload")
            return this.parse_overload_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "satisfies")
            return this.parse_satisfies_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "see")
            return this.parse_see_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "exception")
            return this.parse_throws_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "throws")
            return this.parse_throws_tag(start, tag_name, margin, it_start, it_end)
        if AstNode.text_is(tag_name, "import")
            return this.parse_import_tag(start, tag_name, margin, it_start, it_end)

        this.parse_unknown_tag(start, tag_name, margin, it_start, it_end)
    }

    ; parseTrailingTagComments. `margin += end - pos` only when there is NO
    ; indent text, which is the reference's way of saying "the tag's own text
    ; counts towards the margin when the tag did not start a fresh line".
    procedure parse_trailing_tag_comments(this, pos: int, tag_end: int, margin: int, it_start: int, it_end: int) returns pointer[Array[pointer[AstNode]]]
    {
        var m margin
        let it_len it_end - it_start
        if it_len = 0
            set m: m + (tag_end - pos)
        var im_start 0
        var im_end 0
        if m < it_len
        {
            set im_start: it_start + m
            set im_end: it_end
        }
        ; The initial margin is a non-nil string here even when it is EMPTY, and
        ; parse_tag_comments distinguishes the two — see its `has_initial_margin`.
        this.parse_tag_comments(m, true, im_start, im_end)
    }

    ; parseTagComments — the same state machine as the comment worker, over the
    ; text that FOLLOWS a tag. It differs in three places and each one is a real
    ; difference rather than a duplication: an `@` here ENDS the comment (and the
    ; scanner is reset so the caller sees the `@` again), the newline arm does
    ; not go through pushComment so the margin survives a line break, and a
    ; leading margin asterisk starts recording on the NEXT token rather than
    ; immediately.
    procedure parse_tag_comments(this, initial_indent: int, has_initial_margin: bool, im_start: int, im_end: int) returns pointer[Array[pointer[AstNode]]]
    {
        var indent initial_indent
        let comments_pos this.node_pos()
        let comments this.cparts_new()
        var ccount 0
        var cfirst 0
        let parts AstNode.new_node_list(host)
        var link_end 0 - 1
        var state JSDOC_STATE_BEGINNING_OF_LINE
        var backtick_count 0
        var in_fenced_code_block false
        var margin 0 - 1

        if has_initial_margin
        {
            if im_end > im_start
            {
                set margin: indent
                set ccount: this.cparts_push(comments, ccount, im_start, im_end)
                set indent: indent + (im_end - im_start)
            }
            set state: JSDOC_STATE_SAW_ASTERISK
        }

        var tok token
        repeat
        {
            if tok <> KindBacktickToken
            {
                if backtick_count > 0
                {
                    if backtick_count >= 3
                        set in_fenced_code_block: not in_fenced_code_block
                    set backtick_count: 0
                }
            }

            if tok = KindEndOfFile
                break

            var handled false

            if tok = KindNewLineTrivia
            {
                set handled: true
                ; NOT pushComment: the margin must not move across a line break.
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set state: JSDOC_STATE_BEGINNING_OF_LINE
                set indent: 0
            }

            if (not handled) and (tok = KindAtToken)
            {
                set handled: true
                var ends_comment false
                if not in_fenced_code_block
                {
                    if scanner.can_follow_jsdoc_at()
                        set ends_comment: true
                }
                if ends_comment
                {
                    scanner.reset_pos(scanner.token_end() - 1)
                    break
                }
                if in_fenced_code_block
                    set state: JSDOC_STATE_SAVING_BACKTICKS
                else
                    set state: JSDOC_STATE_SAVING_COMMENTS
                if margin = 0 - 1
                    set margin: indent
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set indent: indent + (scanner.token_end() - scanner.token_start())
            }

            if (not handled) and (tok = KindWhitespaceTrivia)
            {
                set handled: true
                let ws_start scanner.token_start()
                let ws_end scanner.token_end()
                let width ws_end - ws_start
                if margin > (0 - 1)
                {
                    if (indent + width) > margin
                    {
                        var cut margin - indent
                        if cut < 0
                            set cut: 0
                        set ccount: this.cparts_push(comments, ccount, ws_start + cut, ws_end)
                        if in_fenced_code_block
                            set state: JSDOC_STATE_SAVING_BACKTICKS
                        else
                            set state: JSDOC_STATE_SAVING_COMMENTS
                    }
                }
                set indent: indent + width
            }

            if (not handled) and (tok = KindOpenBraceToken)
            {
                if in_fenced_code_block
                {
                    set handled: true
                    set state: JSDOC_STATE_SAVING_BACKTICKS
                    if margin = 0 - 1
                        set margin: indent
                    set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                    set indent: indent + (scanner.token_end() - scanner.token_start())
                }
                else
                {
                    set handled: true
                    set state: JSDOC_STATE_SAVING_COMMENTS
                    let comment_end scanner.token_full_start()
                    let link_start scanner.token_end() - 1
                    let link this.parse_jsdoc_link(link_start)
                    if link <> null
                    {
                        var comment_start comments_pos
                        if link_end > (0 - 1)
                            set comment_start: link_end
                        let text this.finish_node_with_end(this.new_node(KindJSDocText, NodeData.JSDocText(TokenData())), comment_start, comment_end)
                        parts.add(text)
                        parts.add(link)
                        set cfirst: 0
                        set ccount: 0
                        set link_end: scanner.token_end()
                    }
                    else
                    {
                        if margin = 0 - 1
                            set margin: indent
                        set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                        set indent: indent + (scanner.token_end() - scanner.token_start())
                    }
                }
            }

            if (not handled) and (tok = KindBacktickToken)
            {
                set handled: true
                set backtick_count: backtick_count + 1
                if state = JSDOC_STATE_SAVING_BACKTICKS
                    set state: JSDOC_STATE_SAVING_COMMENTS
                else
                    set state: JSDOC_STATE_SAVING_BACKTICKS
                if margin = 0 - 1
                    set margin: indent
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set indent: indent + (scanner.token_end() - scanner.token_start())
            }

            if (not handled) and (tok = KindJSDocCommentTextToken)
            {
                set handled: true
                if state <> JSDOC_STATE_SAVING_BACKTICKS
                {
                    if in_fenced_code_block
                        set state: JSDOC_STATE_SAVING_BACKTICKS
                    else
                        set state: JSDOC_STATE_SAVING_COMMENTS
                }
                if margin = 0 - 1
                    set margin: indent
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set indent: indent + (scanner.token_end() - scanner.token_start())
            }

            if (not handled) and (tok = KindAsteriskToken)
            {
                if state = JSDOC_STATE_BEGINNING_OF_LINE
                {
                    set handled: true
                    ; A leading asterisk starts recording on the NEXT token.
                    set state: JSDOC_STATE_SAW_ASTERISK
                    set indent: indent + 1
                }
                ; else: the reference FALLS THROUGH and records the `*`.
            }

            if not handled
            {
                if state <> JSDOC_STATE_SAVING_BACKTICKS
                {
                    if in_fenced_code_block
                        set state: JSDOC_STATE_SAVING_BACKTICKS
                    else
                        set state: JSDOC_STATE_SAVING_COMMENTS
                }
                if margin = 0 - 1
                    set margin: indent
                set ccount: this.cparts_push(comments, ccount, scanner.token_start(), scanner.token_end())
                set indent: indent + (scanner.token_end() - scanner.token_start())
            }

            if (state = JSDOC_STATE_SAVING_COMMENTS) or (state = JSDOC_STATE_SAVING_BACKTICKS)
                set tok: this.next_jsdoc_comment_text_token(state = JSDOC_STATE_SAVING_BACKTICKS)
            else
                set tok: this.next_token_jsdoc()
        }

        set cfirst: this.cparts_remove_leading_newlines(comments, cfirst, ccount)
        set ccount: this.cparts_remove_trailing_whitespace(comments, cfirst, ccount)
        if ccount > cfirst
        {
            var comment_start comments_pos
            if link_end > (0 - 1)
                set comment_start: link_end
            let text this.finish_node(this.new_node(KindJSDocText, NodeData.JSDocText(TokenData())), comment_start)
            parts.add(text)
        }

        if (parts.get_length() as int) > 0
            return parts
        null
    }

    ; ── inline links ────────────────────────────────────────────────────────

    ; parseJSDocLink — `{@link Foo}`, `{@linkcode Foo}`, `{@linkplain Foo}`.
    ; Answers null when the brace did not open one, and the caller then treats
    ; the `{` as ordinary text.
    procedure parse_jsdoc_link(this, start: int) returns pointer[AstNode]
    {
        let saved this.mark()
        let link_type this.parse_jsdoc_link_prefix()
        if link_type = JSDOC_LINK_NONE
        {
            this.rewind(saved)
            return null
        }
        this.next_token_jsdoc()
        ; Start at the token after the link tag, then skip whitespace.
        this.skip_whitespace()
        let name this.parse_jsdoc_link_name()
        while (token <> KindCloseBraceToken) and (token <> KindNewLineTrivia) and (token <> KindEndOfFile)
            this.next_token_jsdoc()

        var kind KindJSDocLinkPlain
        if link_type = JSDOC_LINK_LINK
            set kind: KindJSDocLink
        if link_type = JSDOC_LINK_CODE
            set kind: KindJSDocLinkCode

        var data NodeData.JSDocLinkPlain(WrappedTypeData(name))
        if kind = KindJSDocLink
            set data: NodeData.JSDocLink(WrappedTypeData(name))
        if kind = KindJSDocLinkCode
            set data: NodeData.JSDocLinkCode(WrappedTypeData(name))
        this.finish_node_with_end(this.new_node(kind, data), start, scanner.token_end())
    }

    ; parseJSDocLinkName. The name is read with the ORDINARY parser — a dotted
    ; entity name, and then any number of `#`-separated halves, which is how
    ; `{@link Foo#bar}` reaches a private member.
    procedure parse_jsdoc_link_name(this) returns pointer[AstNode]
    {
        if not token_is_identifier_or_keyword(token)
            return null
        let pos this.node_pos()
        var name this.parse_identifier_name()
        while this.parse_optional(KindDotToken)
        {
            var right null as pointer[AstNode]
            if token = KindPrivateIdentifier
                set right: this.create_missing_identifier()
            else
                set right: this.parse_identifier_name()
            set name: this.finish_node(this.new_node(KindQualifiedName, NodeData.QualifiedName(QualifiedNameData(name, right))), pos)
        }
        while token = KindPrivateIdentifier
        {
            scanner.re_scan_hash_token()
            this.next_token_jsdoc()
            set name: this.finish_node(this.new_node(KindQualifiedName, NodeData.QualifiedName(QualifiedNameData(name, this.parse_identifier()))), pos)
        }
        name
    }

    ; parseJSDocLinkPrefix, plus isJSDocLinkTag folded into it. The reference
    ; answers `(string, bool)`; here it is one int, because the string's only
    ; use is to select one of three node kinds (§3.6 — a multi-return whose
    ; value set is closed).
    procedure parse_jsdoc_link_prefix(this) returns int
    {
        var ignore_start 0
        var ignore_end 0
        this.skip_whitespace_or_asterisk(&ignore_start, &ignore_end)
        if token <> KindOpenBraceToken
            return JSDOC_LINK_NONE
        if this.next_token_jsdoc() <> KindAtToken
            return JSDOC_LINK_NONE
        if not token_is_identifier_or_keyword(this.next_token_jsdoc())
            return JSDOC_LINK_NONE
        if scanner.token_value_equals("link")
            return JSDOC_LINK_LINK
        if scanner.token_value_equals("linkcode")
            return JSDOC_LINK_CODE
        if scanner.token_value_equals("linkplain")
            return JSDOC_LINK_PLAIN
        JSDOC_LINK_NONE
    }

    ; ── the individual tags ─────────────────────────────────────────────────

    procedure parse_unknown_tag(this, start: int, tag_name: pointer[AstNode], indent: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), indent, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocUnknownTag, NodeData.JSDocUnknownTag(JSDocTagData(tag_name, comment))), start)
    }

    ; The six SIMPLE tags. The reference passes a factory closure; here the KIND
    ; is the parameter (§3.5e).
    procedure parse_simple_tag(this, kind: int, start: int, tag_name: pointer[AstNode], margin: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), margin, it_start, it_end)
        let d JSDocTagData(tag_name, comment)
        if kind = KindJSDocPublicTag
            return this.finish_node(this.new_node(kind, NodeData.JSDocPublicTag(d)), start)
        if kind = KindJSDocPrivateTag
            return this.finish_node(this.new_node(kind, NodeData.JSDocPrivateTag(d)), start)
        if kind = KindJSDocProtectedTag
            return this.finish_node(this.new_node(kind, NodeData.JSDocProtectedTag(d)), start)
        if kind = KindJSDocReadonlyTag
            return this.finish_node(this.new_node(kind, NodeData.JSDocReadonlyTag(d)), start)
        if kind = KindJSDocOverrideTag
            return this.finish_node(this.new_node(kind, NodeData.JSDocOverrideTag(d)), start)
        this.finish_node(this.new_node(kind, NodeData.JSDocDeprecatedTag(d)), start)
    }

    ; tryParseTypeExpression — a type is present only if a `{` follows.
    procedure try_parse_type_expression(this) returns pointer[AstNode]
    {
        var ignore_start 0
        var ignore_end 0
        this.skip_whitespace_or_asterisk(&ignore_start, &ignore_end)
        if token = KindOpenBraceToken
            return this.parse_jsdoc_type_expression(false)
        null
    }

    ; parseBracketNameInPropertyAndParamTag — `[foo]`, `foo`, `[foo.bar]`,
    ; `` `foo` `` (a markdown-quoted name, which is not legal JSDoc and occurs
    ; in the wild), and `[foo = 42]` with a default the reference parses and
    ; throws away.
    procedure parse_bracket_name_in_property_and_param_tag(this, target: int, out_bracketed: pointer[bool]) returns pointer[AstNode]
    {
        let is_bracketed this.parse_optional_jsdoc(KindOpenBracketToken)
        set *out_bracketed: is_bracketed
        if is_bracketed
            this.skip_whitespace()
        let is_backquoted this.parse_optional_jsdoc(KindBacktickToken)
        var code DiagIdentifier_expected
        if target = PROPERTY_LIKE_PARAMETER
            set code: 0
        let name this.parse_jsdoc_entity_name(code)
        if is_backquoted
            this.parse_expected_token_jsdoc(KindBacktickToken)
        if is_bracketed
        {
            this.skip_whitespace()
            if this.parse_optional_token(KindEqualsToken) <> null
                this.parse_expression()
            this.parse_expected(KindCloseBracketToken)
        }
        name
    }

    ; isObjectOrObjectArrayTypeReference — `Object`, `Object[]`, and any depth of
    ; array around one. It is what decides whether a @param or a @typedef may
    ; carry NESTED property tags.
    function is_object_or_object_array_type_reference(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        let k AstNode.kind_of(n)
        if k = KindObjectKeyword
            return true
        if k = KindArrayType
            return is_object_or_object_array_type_reference(AstNode.array_element_type_of(n))
        if k <> KindTypeReference
            return false
        let name AstNode.type_reference_name_of(n)
        if AstNode.kind_of(name) <> KindIdentifier
            return false
        if not AstNode.text_is(name, "Object")
            return false
        AstNode.type_reference_arguments_of(n) = null
    }

    ; parseParameterOrPropertyTag — @param, @arg, @argument, @prop, @property.
    ;
    ; ★★★ THE ORDER OF NAME AND TYPE IS PART OF THE NODE. `@param {T} x` has the
    ; type first and `@param x {T}` the name first, and `is_name_first` is what
    ; child_at reads to decide the visit order — see ast.scaly.
    ;
    ; ★ The look-ahead in the middle is the reference's, and it is subtle: after
    ; a NAME-first tag, a `{` could be either a type or the start of an inline
    ; `{@link}` in the comment. The look-ahead asks parse_jsdoc_link_prefix and
    ; takes the type only if it is NOT a link.
    procedure parse_parameter_or_property_tag(this, start: int, tag_name: pointer[AstNode], target: int, indent: int) returns pointer[AstNode]
    {
        var type_expression this.try_parse_type_expression()
        var is_name_first type_expression = null
        var ignore_start 0
        var ignore_end 0
        this.skip_whitespace_or_asterisk(&ignore_start, &ignore_end)

        var is_bracketed false
        let name this.parse_bracket_name_in_property_and_param_tag(target, &is_bracketed)
        var it_start 0
        var it_end 0
        this.skip_whitespace_or_asterisk(&it_start, &it_end)

        if is_name_first
        {
            let saved this.mark()
            let is_link this.parse_jsdoc_link_prefix() <> JSDOC_LINK_NONE
            this.rewind(saved)
            if not is_link
                set type_expression: this.try_parse_type_expression()
        }

        let comment this.parse_trailing_tag_comments(start, this.node_pos(), indent, it_start, it_end)

        let nested this.parse_nested_type_literal(type_expression, name, target, indent)
        if nested <> null
        {
            set type_expression: nested
            set is_name_first: true
        }

        var kind KindJSDocParameterTag
        if target = PROPERTY_LIKE_PROPERTY
            set kind: KindJSDocPropertyTag
        this.finish_node(this.new_node(kind, NodeData.JSDocParameterOrPropertyTag(JSDocParameterOrPropertyTagData(tag_name, name, is_bracketed, type_expression, is_name_first, comment))), start)
    }

    ; parseNestedTypeLiteral — the child @param/@property tags that document the
    ; members of an `Object` parameter. Answers a synthesized JSDocTypeExpression
    ; wrapping a JSDocTypeLiteral, or null when there were no children.
    procedure parse_nested_type_literal(this, type_expression: pointer[AstNode], name: pointer[AstNode], target: int, indent: int) returns pointer[AstNode]
    {
        if type_expression = null
            return null
        let inner AstNode.jsdoc_type_expression_inner_of(type_expression)
        if not is_object_or_object_array_type_reference(inner)
            return null

        let pos this.node_pos()
        let children AstNode.new_node_list(host)
        var any false
        repeat
        {
            let saved this.mark()
            let child this.parse_child_parameter_or_property_tag(target, indent, name)
            if child = null
            {
                this.rewind(saved)
                break
            }
            let ck AstNode.kind_of(child)
            if (ck = KindJSDocParameterTag) or (ck = KindJSDocPropertyTag)
            {
                children.add(child)
                set any: true
            }
            else
            {
                if ck = KindJSDocTemplateTag
                {
                    let tn AstNode.jsdoc_tag_name_of(child)
                    this.parse_error_at_range(AstNode.pos_of(tn), AstNode.end_of(tn), DiagA_JSDoc_template_tag_may_not_follow_a_typedef_callback_or_overload_tag)
                }
            }
        }
        if not any
            return null
        let is_array AstNode.kind_of(inner) = KindArrayType
        let literal this.finish_node(this.new_node(KindJSDocTypeLiteral, NodeData.JSDocTypeLiteral(JSDocTypeLiteralData(children, is_array))), pos)
        this.finish_node(this.new_node(KindJSDocTypeExpression, NodeData.JSDocTypeExpression(WrappedTypeData(literal))), pos)
    }

    ; The reference reports a DUPLICATE @return / @type against the tags already
    ; parsed in this comment. `core.Some(previousTags, ast.IsJSDocReturnTag)` —
    ; a linear scan over the list the worker is building.
    function tags_contain_kind(tags: pointer[Array[pointer[AstNode]]], kind: int) returns bool
    {
        if tags = null
            return false
        let n tags.get_length() as int
        var i 0
        while i < n
        {
            if AstNode.kind_of(*(tags.get_buffer() + i)) = kind
                return true
            set i: i + 1
        }
        false
    }

    procedure parse_return_tag(this, previous_tags: pointer[Array[pointer[AstNode]]], start: int, tag_name: pointer[AstNode], indent: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        if tags_contain_kind(previous_tags, KindJSDocReturnTag)
            this.parse_error_at(AstNode.pos_of(tag_name), scanner.token_start(), DiagX_0_tag_already_specified)
        let type_expression this.try_parse_type_expression()
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), indent, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocReturnTag, NodeData.JSDocReturnTag(JSDocOneSlotTagData(tag_name, type_expression, comment))), start)
    }

    ; `indent = -1` skips the trailing comments, which is how a @type nested in
    ; a @typedef is parsed.
    procedure parse_type_tag(this, previous_tags: pointer[Array[pointer[AstNode]]], start: int, tag_name: pointer[AstNode], indent: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        if tags_contain_kind(previous_tags, KindJSDocTypeTag)
            this.parse_error_at(AstNode.pos_of(tag_name), scanner.token_start(), DiagX_0_tag_already_specified)
        let type_expression this.parse_jsdoc_type_expression(true)
        var comment null as pointer[Array[pointer[AstNode]]]
        if indent <> 0 - 1
            set comment: this.parse_trailing_tag_comments(start, this.node_pos(), indent, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocTypeTag, NodeData.JSDocTypeTag(JSDocOneSlotTagData(tag_name, type_expression, comment))), start)
    }

    ; parseSeeTag. The `://` test is the reference's and it is the reason this
    ; routine reads the SOURCE: `@see http://x` must not read `http` as a name
    ; reference.
    procedure parse_see_tag(this, start: int, tag_name: pointer[AstNode], indent: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        var has_name_reference false
        if this.is_identifier()
        {
            let e scanner.token_end()
            var is_url false
            if scanner.byte_at(e) = (":" as char) as int
            {
                if scanner.byte_at(e + 1) = ("/" as char) as int
                {
                    if scanner.byte_at(e + 2) = ("/" as char) as int
                        set is_url: true
                }
            }
            if not is_url
                set has_name_reference: true
        }
        if token = KindOpenBraceToken
        {
            if this.look_ahead_next_token_is_identifier_or_keyword()
                set has_name_reference: true
        }
        var name_expression null as pointer[AstNode]
        if has_name_reference
            set name_expression: this.parse_jsdoc_name_reference()
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), indent, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocSeeTag, NodeData.JSDocSeeTag(JSDocOneSlotTagData(tag_name, name_expression, comment))), start)
    }

    ; ★ ONE routine where the reference has TWO — parseImplementsTag and
    ; parseAugmentsTag — because their bodies are identical apart from the node
    ; KIND, and this port has one call site per kind. It is §3.5e's argument
    ; applied to a pair of named functions rather than to a func VALUE: the thing
    ; that varies carries no information a constant does not. The three tag names
    ; are still three arms in parse_tag, which is where a reader checks them
    ; against the reference's switch.
    procedure parse_implements_or_augments_tag(this, kind: int, start: int, tag_name: pointer[AstNode], margin: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        let class_name this.parse_expression_with_type_arguments_for_augments()
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), margin, it_start, it_end)
        let d JSDocOneSlotTagData(tag_name, class_name, comment)
        if kind = KindJSDocImplementsTag
            return this.finish_node(this.new_node(kind, NodeData.JSDocImplementsTag(d)), start)
        this.finish_node(this.new_node(kind, NodeData.JSDocAugmentsTag(d)), start)
    }

    procedure parse_satisfies_tag(this, start: int, tag_name: pointer[AstNode], margin: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        let type_expression this.parse_jsdoc_type_expression(false)
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), margin, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocSatisfiesTag, NodeData.JSDocSatisfiesTag(JSDocOneSlotTagData(tag_name, type_expression, comment))), start)
    }

    procedure parse_throws_tag(this, start: int, tag_name: pointer[AstNode], margin: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        let type_expression this.try_parse_type_expression()
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), margin, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocThrowsTag, NodeData.JSDocThrowsTag(JSDocOneSlotTagData(tag_name, type_expression, comment))), start)
    }

    procedure parse_this_tag(this, start: int, tag_name: pointer[AstNode], margin: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        let type_expression this.parse_jsdoc_type_expression(true)
        this.skip_whitespace()
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), margin, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocThisTag, NodeData.JSDocThisTag(JSDocOneSlotTagData(tag_name, type_expression, comment))), start)
    }

    ; parseImportTag — `@import { x } from "m"`, the JSDoc spelling of an import
    ; declaration. It reuses the ordinary import machinery, which is why the
    ; skip-asterisk flag is passed down: the clause may cross a line.
    procedure parse_import_tag(this, start: int, tag_name: pointer[AstNode], margin: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        let after_import_tag_pos scanner.token_full_start()
        var identifier null as pointer[AstNode]
        if this.is_identifier()
            set identifier: this.parse_identifier()
        let import_clause this.try_parse_import_clause(identifier, after_import_tag_pos, KindTypeKeyword, true)
        let module_specifier this.parse_module_specifier()
        let attributes this.try_parse_import_attributes()
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), margin, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocImportTag, NodeData.JSDocImportTag(JSDocImportTagData(tag_name, import_clause, module_specifier, attributes, comment))), start)
    }

    procedure parse_expression_with_type_arguments_for_augments(this) returns pointer[AstNode]
    {
        let used_brace this.parse_optional(KindOpenBraceToken)
        let pos this.node_pos()
        let expression this.parse_property_access_entity_name_expression()
        scanner.set_skip_jsdoc_leading_asterisks(true)
        let type_arguments this.parse_type_arguments()
        scanner.set_skip_jsdoc_leading_asterisks(false)
        let node this.finish_node(this.new_node(KindExpressionWithTypeArguments, NodeData.ExpressionWithTypeArguments(ExpressionWithTypeArgumentsData(expression, type_arguments))), pos)
        if used_brace
        {
            this.skip_whitespace()
            this.parse_expected(KindCloseBraceToken)
        }
        node
    }

    procedure parse_property_access_entity_name_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var node this.parse_jsdoc_identifier_name(DiagIdentifier_expected)
        while this.parse_optional(KindDotToken)
        {
            let name this.parse_jsdoc_identifier_name(DiagIdentifier_expected)
            set node: this.finish_node(this.new_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(node, null, name))), pos)
        }
        node
    }

    ; ── @typedef, @callback, @overload and the child tags ───────────────────

    ; parseJSDocTypeNameWithNamespace — `@typedef {…} Foo.Bar.Baz`, which builds
    ; a chain of NAMESPACE declarations rather than a qualified name. The two
    ; flags it sets are the reference's and neither has a reader in this port
    ; (§3.5ao): NestedNamespace and IdentifierIsInJSDocNamespace are both read by
    ; the binder.
    procedure parse_jsdoc_type_name_with_namespace(this, nested: bool) returns pointer[AstNode]
    {
        let start scanner.token_start()
        if not token_is_identifier_or_keyword(token)
            return null
        let type_name_or_namespace_name this.parse_jsdoc_identifier_name(0)
        if this.parse_optional_jsdoc(KindDotToken)
        {
            let body this.parse_jsdoc_type_name_with_namespace(true)
            let n this.new_node(KindModuleDeclaration, NodeData.ModuleDeclaration(ModuleDeclarationData(null, KindNamespaceKeyword, type_name_or_namespace_name, body)))
            if nested
                set n.flags: n.flags | NodeFlagsNestedNamespace
            return this.finish_node(n, start)
        }
        if nested
            set type_name_or_namespace_name.flags: type_name_or_namespace_name.flags | NodeFlagsIdentifierIsInJSDocNamespace
        type_name_or_namespace_name
    }

    ; parseTypedefTag. The longest routine in this grammar, and the reason is the
    ; END: a typedef's extent depends on which of five things it turned out to
    ; have — nested children, a comment, a name, a type, or only the tag name —
    ; and the reference works through them in that order.
    procedure parse_typedef_tag(this, start: int, tag_name: pointer[AstNode], indent: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        var type_expression this.try_parse_type_expression()
        var ignore_start 0
        var ignore_end 0
        this.skip_whitespace_or_asterisk(&ignore_start, &ignore_end)
        var full_name this.parse_jsdoc_type_name_with_namespace(false)
        if full_name = null
            set full_name: this.parse_jsdoc_identifier_name(DiagIdentifier_expected)
        this.skip_whitespace()
        var comment this.parse_tag_comments(indent, false, 0, 0)

        var end 0 - 1
        var has_children false
        var consider_children false
        if type_expression = null
            set consider_children: true
        else
        {
            if is_object_or_object_array_type_reference(AstNode.jsdoc_type_expression_inner_of(type_expression))
                set consider_children: true
        }

        if consider_children
        {
            var child_type_tag null as pointer[AstNode]
            let property_tags AstNode.new_node_list(host)
            repeat
            {
                let saved this.mark()
                let child this.parse_child_property_tag(indent)
                if child = null
                {
                    this.rewind(saved)
                    break
                }
                set has_children: true
                let ck AstNode.kind_of(child)
                if ck = KindJSDocTemplateTag
                {
                    let tn AstNode.jsdoc_tag_name_of(child)
                    this.parse_error_at_range(AstNode.pos_of(tn), AstNode.end_of(tn), DiagA_JSDoc_template_tag_may_not_follow_a_typedef_callback_or_overload_tag)
                }
                else
                {
                    if ck = KindJSDocTypeTag
                    {
                        if child_type_tag = null
                            set child_type_tag: child
                        else
                        {
                            ; The reference attaches RELATED INFO here naming the
                            ; first @type; related info never reaches the dump
                            ; (Diagnostics.scaly's header), so only the report is
                            ; carried.
                            this.parse_error_at_current_token(DiagA_JSDoc_typedef_comment_may_not_contain_multiple_type_tags)
                        }
                    }
                    else
                        property_tags.add(child)
                }
            }
            if has_children
            {
                var is_array_type false
                if type_expression <> null
                {
                    if AstNode.kind_of(AstNode.jsdoc_type_expression_inner_of(type_expression)) = KindArrayType
                        set is_array_type: true
                }
                var use_child false
                if child_type_tag <> null
                {
                    let cte AstNode.jsdoc_type_tag_expression_of(child_type_tag)
                    if cte <> null
                    {
                        if not is_object_or_object_array_type_reference(AstNode.jsdoc_type_expression_inner_of(cte))
                        {
                            set type_expression: cte
                            set use_child: true
                        }
                    }
                }
                if not use_child
                {
                    ; ★ The reference's own comment says this differs from Strada
                    ; and prevents a crash: with no property tags the literal
                    ; starts at the TAG rather than at a child that is not there.
                    var pos start
                    if (property_tags.get_length() as int) > 0
                        set pos: AstNode.pos_of(*(property_tags.get_buffer()))
                    set type_expression: this.finish_node(this.new_node(KindJSDocTypeLiteral, NodeData.JSDocTypeLiteral(JSDocTypeLiteralData(property_tags, is_array_type))), pos)
                }
                set end: AstNode.end_of(type_expression)
            }
        }

        if end = 0 - 1
        {
            if has_children and (type_expression <> null)
                set end: AstNode.end_of(type_expression)
            else
            {
                if comment <> null
                    set end: this.node_pos()
                else
                {
                    if full_name <> null
                        set end: AstNode.end_of(full_name)
                    else
                    {
                        if type_expression <> null
                            set end: AstNode.end_of(type_expression)
                        else
                            set end: AstNode.end_of(tag_name)
                    }
                }
            }
        }

        if comment = null
            set comment: this.parse_trailing_tag_comments(start, end, indent, it_start, it_end)

        this.finish_node_with_end(this.new_node(KindJSDocTypedefTag, NodeData.JSDocTypedefTag(JSDocNamedTagData(tag_name, type_expression, full_name, comment))), start, end)
    }

    procedure parse_callback_tag_parameters(this, indent: int) returns pointer[Array[pointer[AstNode]]]
    {
        let parameters AstNode.new_node_list(host)
        repeat
        {
            let saved this.mark()
            let child this.parse_child_parameter_or_property_tag(PROPERTY_LIKE_CALLBACK_PARAMETER, indent, null)
            if child = null
            {
                this.rewind(saved)
                break
            }
            if AstNode.kind_of(child) = KindJSDocTemplateTag
            {
                let tn AstNode.jsdoc_tag_name_of(child)
                this.parse_error_at_range(AstNode.pos_of(tn), AstNode.end_of(tn), DiagA_JSDoc_template_tag_may_not_follow_a_typedef_callback_or_overload_tag)
            }
            else
                parameters.add(child)
        }
        parameters
    }

    ; parseJSDocSignature. The RETURN tag becomes the signature's TYPE slot, and
    ; the rewind is the point of the routine: an `@` that turned out not to be a
    ; @return belongs to whatever comes next, so the speculation is undone.
    procedure parse_jsdoc_signature(this, start: int, indent: int) returns pointer[AstNode]
    {
        let parameters this.parse_callback_tag_parameters(indent)
        var return_tag null as pointer[AstNode]
        let saved this.mark()
        if this.parse_optional_jsdoc(KindAtToken)
        {
            let tag this.parse_tag(null, indent)
            if AstNode.kind_of(tag) = KindJSDocReturnTag
                set return_tag: tag
        }
        if return_tag = null
            this.rewind(saved)
        this.finish_node(this.new_node(KindJSDocSignature, NodeData.JSDocSignature(JSDocSignatureData(null, parameters, return_tag))), start)
    }

    procedure parse_callback_tag(this, start: int, tag_name: pointer[AstNode], indent: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        var full_name this.parse_jsdoc_type_name_with_namespace(false)
        if full_name = null
            set full_name: this.parse_jsdoc_identifier_name(DiagIdentifier_expected)
        this.skip_whitespace()
        var comment this.parse_tag_comments(indent, false, 0, 0)
        let type_expression this.parse_jsdoc_signature(this.node_pos(), indent)
        if comment = null
            set comment: this.parse_trailing_tag_comments(start, this.node_pos(), indent, it_start, it_end)
        var end AstNode.end_of(type_expression)
        if comment <> null
            set end: this.node_pos()
        this.finish_node_with_end(this.new_node(KindJSDocCallbackTag, NodeData.JSDocCallbackTag(JSDocNamedTagData(tag_name, type_expression, full_name, comment))), start, end)
    }

    procedure parse_overload_tag(this, start: int, tag_name: pointer[AstNode], indent: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        this.skip_whitespace()
        var comment this.parse_tag_comments(indent, false, 0, 0)
        let type_expression this.parse_jsdoc_signature(start, indent)
        if comment = null
            set comment: this.parse_trailing_tag_comments(start, this.node_pos(), indent, it_start, it_end)
        var end AstNode.end_of(type_expression)
        if comment <> null
            set end: this.node_pos()
        this.finish_node_with_end(this.new_node(KindJSDocOverloadTag, NodeData.JSDocOverloadTag(JSDocOneSlotTagData(tag_name, type_expression, comment))), start, end)
    }

    ; textsEqual — two entity names are the same name. The loop walks both down
    ; their qualified halves in lockstep and stops when either is a bare
    ; identifier.
    function jsdoc_texts_equal(a0: pointer[AstNode], b0: pointer[AstNode]) returns bool
    {
        var a a0
        var b b0
        while (AstNode.kind_of(a) <> KindIdentifier) or (AstNode.kind_of(b) <> KindIdentifier)
        {
            if AstNode.kind_of(a) = KindIdentifier
                return false
            if AstNode.kind_of(b) = KindIdentifier
                return false
            if not AstNode.identifier_texts_equal(AstNode.qualified_right_of(a), AstNode.qualified_right_of(b))
                return false
            set a: AstNode.qualified_left_of(a)
            set b: AstNode.qualified_left_of(b)
        }
        AstNode.identifier_texts_equal(a, b)
    }

    procedure parse_child_property_tag(this, indent: int) returns pointer[AstNode]
        this.parse_child_parameter_or_property_tag(PROPERTY_LIKE_PROPERTY, indent, null)

    ; parseChildParameterOrPropertyTag — the scan that finds the NEXT child tag.
    ; It is a token loop rather than a parse: it walks forward until it finds an
    ; `@` that may start a tag, and the two flags decide whether one may.
    ;
    ; ★ A child whose name is not a member of the parent's — `@param o.x` under
    ; `@param o` — ends the run, which is what the name comparison is for.
    procedure parse_child_parameter_or_property_tag(this, target: int, indent: int, name: pointer[AstNode]) returns pointer[AstNode]
    {
        var can_parse_tag true
        var seen_asterisk false
        repeat
        {
            let t this.next_token_jsdoc()
            if t = KindAtToken
            {
                var ok can_parse_tag
                if ok
                {
                    if not scanner.can_follow_jsdoc_at()
                        set ok: false
                }
                if ok
                {
                    let child this.try_parse_child_tag(target, indent)
                    if child <> null
                    {
                        if name <> null
                        {
                            let ck AstNode.kind_of(child)
                            if (ck = KindJSDocParameterTag) or (ck = KindJSDocPropertyTag)
                            {
                                let cn AstNode.jsdoc_param_name_of(child)
                                if AstNode.kind_of(cn) = KindIdentifier
                                    return null
                                if not jsdoc_texts_equal(name, AstNode.qualified_left_of(cn))
                                    return null
                            }
                        }
                    }
                    return child
                }
                set seen_asterisk: false
            }
            if t = KindNewLineTrivia
            {
                set can_parse_tag: true
                set seen_asterisk: false
            }
            if t = KindAsteriskToken
            {
                if seen_asterisk
                    set can_parse_tag: false
                set seen_asterisk: true
            }
            if t = KindIdentifier
                set can_parse_tag: false
            if t = KindEndOfFile
                return null
        }
        null
    }

    procedure try_parse_child_tag(this, target: int, indent: int) returns pointer[AstNode]
    {
        let start scanner.token_full_start()
        this.next_token_jsdoc()

        let tag_name this.parse_jsdoc_identifier_name(DiagIdentifier_expected)
        var it_start 0
        var it_end 0
        this.skip_whitespace_or_asterisk(&it_start, &it_end)

        var t 0
        if AstNode.text_is(tag_name, "type")
        {
            if target = PROPERTY_LIKE_PROPERTY
                return this.parse_type_tag(null, start, tag_name, 0 - 1, 0, 0)
            return null
        }
        if AstNode.text_is(tag_name, "prop")
            set t: PROPERTY_LIKE_PROPERTY
        if AstNode.text_is(tag_name, "property")
            set t: PROPERTY_LIKE_PROPERTY
        if AstNode.text_is(tag_name, "arg")
            set t: PROPERTY_LIKE_PARAMETER | PROPERTY_LIKE_CALLBACK_PARAMETER
        if AstNode.text_is(tag_name, "argument")
            set t: PROPERTY_LIKE_PARAMETER | PROPERTY_LIKE_CALLBACK_PARAMETER
        if AstNode.text_is(tag_name, "param")
            set t: PROPERTY_LIKE_PARAMETER | PROPERTY_LIKE_CALLBACK_PARAMETER
        if AstNode.text_is(tag_name, "template")
            return this.parse_template_tag(start, tag_name, indent, it_start, it_end)
        if AstNode.text_is(tag_name, "this")
            return this.parse_this_tag(start, tag_name, indent, it_start, it_end)
        if t = 0
            return null
        if (target & t) = 0
            return null
        this.parse_parameter_or_property_tag(start, tag_name, target, indent)
    }

    ; ── @template ───────────────────────────────────────────────────────────

    procedure parse_template_tag_type_parameter(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let is_bracketed this.parse_optional_jsdoc(KindOpenBracketToken)
        if is_bracketed
            this.skip_whitespace()

        let modifiers this.parse_modifiers(false, true, false)
        let name this.parse_jsdoc_identifier_name(DiagUnexpected_token_A_type_parameter_name_was_expected_without_curly_braces)
        var default_type null as pointer[AstNode]
        if is_bracketed
        {
            this.skip_whitespace()
            this.parse_expected(KindEqualsToken)
            let saved context_flags
            this.set_context_flags(NodeFlagsJSDoc, true)
            set default_type: this.parse_jsdoc_type()
            set context_flags: saved
            this.parse_expected(KindCloseBracketToken)
        }

        if node_is_missing(name)
            return null
        this.finish_node(this.new_node(KindTypeParameter, NodeData.TypeParameter(TypeParameterData(modifiers, name, null, null, default_type))), pos)
    }

    procedure parse_template_tag_type_parameters(this) returns pointer[Array[pointer[AstNode]]]
    {
        let type_parameters AstNode.new_node_list(host)
        var more true
        while more
        {
            this.skip_whitespace()
            let node this.parse_template_tag_type_parameter()
            if node <> null
                type_parameters.add(node)
            var ignore_start 0
            var ignore_end 0
            this.skip_whitespace_or_asterisk(&ignore_start, &ignore_end)
            set more: this.parse_optional_jsdoc(KindCommaToken)
        }
        type_parameters
    }

    procedure parse_template_tag(this, start: int, tag_name: pointer[AstNode], indent: int, it_start: int, it_end: int) returns pointer[AstNode]
    {
        var constraint null as pointer[AstNode]
        if token = KindOpenBraceToken
            set constraint: this.parse_jsdoc_type_expression(false)
        let type_parameters this.parse_template_tag_type_parameters()
        let comment this.parse_trailing_tag_comments(start, this.node_pos(), indent, it_start, it_end)
        this.finish_node(this.new_node(KindJSDocTemplateTag, NodeData.JSDocTemplateTag(JSDocTemplateTagData(tag_name, constraint, type_parameters, comment))), start)
    }

    ; ── names ───────────────────────────────────────────────────────────────

    ; parseJSDocEntityName. `y[]` is accepted as an entity name and the brackets
    ; are dropped — the reference's own comment says it is not worth enforcing
    ; the Closure rule that would require them.
    procedure parse_jsdoc_entity_name(this, code: int) returns pointer[AstNode]
    {
        var entity this.parse_jsdoc_identifier_name(code)
        if this.parse_optional(KindOpenBracketToken)
            this.parse_expected(KindCloseBracketToken)
        while this.parse_optional(KindDotToken)
        {
            let name this.parse_jsdoc_identifier_name(DiagIdentifier_expected)
            if this.parse_optional(KindOpenBracketToken)
                this.parse_expected(KindCloseBracketToken)
            let pos AstNode.pos_of(entity)
            set entity: this.finish_node(this.new_node(KindQualifiedName, NodeData.QualifiedName(QualifiedNameData(entity, name))), pos)
        }
        entity
    }

    ; parseJSDocIdentifierName. `code = 0` is the reference's `nil` message, and
    ; then a RESERVED WORD gets its own report instead — which is the one place
    ; the two differ.
    procedure parse_jsdoc_identifier_name(this, code: int) returns pointer[AstNode]
    {
        if not token_is_identifier_or_keyword(token)
        {
            if code <> 0
                this.parse_error_at_current_token(code)
            else
            {
                if is_reserved_word(token)
                    this.parse_error_at_current_token(DiagIdentifier_expected_0_is_a_reserved_word_that_cannot_be_used_here)
            }
            return this.finish_node(this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData(null, 0))), this.node_pos())
        }
        let pos scanner.token_start()
        let end scanner.token_end()
        let text scanner.token_value()
        let text_len scanner.token_value_length()
        this.next_token_jsdoc()
        this.finish_node_with_end(this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData(text, text_len))), pos, end)
    }


    ; ── the JSDoc REPARSER (slice 22) ───────────────────────────────────────
    ;
    ; internal/parser/reparser.go, and it is what `.js` means. For a JavaScript
    ; file JSDoc is not a comment that documents the code — it IS the type
    ; syntax, so `@typedef` has to become a type alias in the statement list and
    ; `@param {T} x` has to put a type annotation on a parameter that has none.
    ; The reference does that in one pass, hanging off with_jsdoc, and splits it
    ; in two:
    ;
    ;   reparse_unhosted   a tag that becomes a NEW declaration (@typedef,
    ;                      @callback, @import, @overload) — it goes into
    ;                      `reparse_list` and parse_list flushes it into the
    ;                      enclosing statement list, BEFORE the statement the
    ;                      comment documented.
    ;   reparse_hosted     a tag that MUTATES the node it documents (@type,
    ;                      @satisfies, @template, @param, @this, @return, the
    ;                      five modifier tags, @implements, @augments).
    ;
    ; ★★★ THE MUTATING HALF IS WHY THE AST GREW SLOTS THIS SLICE. Nothing the
    ; grammar can write fills FunctionDeclaration.full_signature,
    ; BinaryExpression.type_node, PropertyAssignment.type_node,
    ; ShorthandPropertyAssignment.type_node or ExportAssignment.type_node — every
    ; one of them exists for a tag, and every earlier slice's record comment said
    ; so and named the place in the child order. They are filled here.
    ;
    ; ★★★ CLONING: the reference deep-clones every node it lifts out of the JSDoc
    ; tree into the statement tree (`DeepCloneReparse`), and THIS PORT CLONES THE
    ; ROOT ONLY, sharing the children. The argument is what the two yardsticks
    ; compare. A deep clone preserves kind, pos and end and copies flags; only the
    ; clone's ROOT gains NodeFlagsReparsed, never its children. So a root copy
    ; with shared children produces the identical dump on the parser yardstick,
    ; and the original subtree — which the JSDoc yardstick still walks — is
    ; untouched, because the only node written to is the fresh root.
    ;
    ; The condition under which that stops being true is exact and worth writing
    ; down: a mutation reaching a SHARED child. Read against the reference, every
    ; write after a clone lands on the clone's own root (the `@import` arm's
    ; phase modifier is the only one), and every deeper node the reparse needs is
    ; SYNTHESIZED rather than cloned. If a later slice adds a write that reaches
    ; into a clone's subtree, this decision has to be revisited — the symptom
    ; would be a JSDoc-yardstick failure on a unit whose parser yardstick passed.
    ;
    ; ★ The reference additionally keeps `reparsedClones`, sorted, on the
    ; SourceFile, for the binder's benefit (a symbol is attached to the reparsed
    ; node, not to the JSDoc node). Nothing here reads it and neither yardstick
    ; can see it, so it is not carried — stated rather than silently dropped.

    ; finishReparsedNode. The flags are ASSIGNED, not OR'd: a synthesized node
    ; carries the context it was made in plus Reparsed and nothing else.
    ;
    ; ★★★ THE THIRD LINE — overrideParentInImmediateChildren — WAS MISSING UNTIL
    ; SLICE 50, AND NO DUMP COULD SEE IT. `parent` is not in the token stream, not
    ; in the tree walk (which compares depth, kind, pos, end and flags) and not on a
    ; symbol, so a synthesized node whose children still name the JSDoc node they
    ; were parsed under compared exactly equal on all four earlier yardsticks. The
    ; reader that found it is the CHECKER: `@typedef {T} A.B.MyType` builds nested
    ; ModuleDeclarations, checkGrammarModuleElementContext asks the inner one for
    ; its parent's kind, and with the line missing the answer was neither
    ; SourceFile nor ModuleBlock nor ModuleDeclaration — so the port INVENTED a
    ; TS1235 the reference does not report, on one unit of the stage-1 corpus.
    ;
    ; ★★ Re-parenting is safe here for the reason §3.5bf gives about the clone: the
    ; immediate children of a reparsed node are either freshly SYNTHESIZED or the
    ; ROOT of an add_deep_clone_reparse, never a node the JSDoc tree still owns. So
    ; this steals nothing, which is the question the deep clone's own note asks and
    ; leaves open for whoever adds a write into a clone's subtree.
    ;
    ; ★ The reference's sibling `finishMutatedNode` — the same call alone, at 22
    ; sites in reparser.go, after a node's children have been REPLACED in place —
    ; is a separate question and is NOT answered here: this port's reparser reaches
    ; those sites differently, and a blind port of a re-parenting loop is how a
    ; parent gets stolen. It is a marker rather than a gap, and the instrument that
    ; would show it is the one that showed this: a checker arm reading a parent.
    procedure finish_reparsed_node(this, n: pointer[AstNode], location: pointer[AstNode])
    {
        if n = null
            return
        if location = null
            return
        set n.flags: context_flags | NodeFlagsReparsed
        set n.pos: location.pos
        set n.end: location.end
        this.override_parent_in_immediate_children(n)
    }

    ; DeepCloneReparse, as the root copy §3.5be argues for. `*c: *n` copies the
    ; whole node INCLUDING the union payload by value, so the children are the
    ; originals and only the new root is ours to write.
    ; ★★★ `SetParentInChildren(node)` — which the reference's DeepCloneReparse calls
    ; right after the clone — is deliberately NOT done here, and slice 27 is where
    ; that became a decision rather than an absence. The reference's deep clone
    ; copies the CHILDREN too, so re-parenting them to the clone is free; this port
    ; copies the root and SHARES the children (see the note above, §3.5bf), so the
    ; same call would STEAL every child's parent from the original node. The clone
    ; carries the original's own `parent` with it, and gets a correct one as soon as
    ; whatever attaches it is finished. What remains is a shared child whose parent
    ; still names the original — the same kind and range, so every predicate the
    ; binder asks of a parent answers the same; stated here because it is a
    ; divergence and not an oversight.
    procedure add_deep_clone_reparse(this, n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        let c AstNode.alloc(host)
        set *c: *n
        set c.flags: c.flags | NodeFlagsReparsed
        c
    }

    ; addTransformedReparse — a node the reparse INVENTED to stand for one whose
    ; text is not a valid identifier. It takes the original's range and carries
    ; the extra bit that says the literal was rewritten.
    procedure add_transformed_reparse(this, new_n: pointer[AstNode], old: pointer[AstNode]) returns pointer[AstNode]
    {
        this.finish_reparsed_node(new_n, old)
        if new_n <> null
            set new_n.flags: new_n.flags | NodeFlagsReparserTransformedLiteral
        new_n
    }

    ; ── the small helpers ───────────────────────────────────────────────────

    ; scanner.IsValidIdentifier over an identifier node's stored TEXT. The
    ; reference iterates over RUNES, so the bytes have to be decoded — the
    ; scanner's own decoder does it, over the value buffer rather than the source.
    function is_valid_identifier_text(this, n: pointer[AstNode]) returns bool
    {
        let t AstNode.identifier_text_of(n)
        let len AstNode.identifier_text_length_of(n)
        if len = 0
            return false
        if t = null
            return false
        var i 0
        var first true
        while i < len
        {
            let cp scanner.utf8_decode_in(t, len, i)
            if first
            {
                if Scanner.is_identifier_start(cp) = false
                    return false
            }
            else
            {
                if Scanner.is_identifier_part(cp) = false
                    return false
            }
            set first: false
            set i: i + scanner.utf8_size_in(t, len, i)
        }
        true
    }

    ; checkNonIdentifierName: an identifier whose text is not one gets
    ; `Identifier expected` — at the character BEFORE it when the name is missing
    ; and therefore zero-width.
    procedure check_non_identifier_name(this, name: pointer[AstNode]) returns pointer[AstNode]
    {
        if name = null
            return null
        if name.kind <> KindIdentifier
            return name
        if this.is_valid_identifier_text(name)
            return name
        var p name.pos
        var e name.end
        if p = e
        {
            set p: p - 1
            set e: name.pos
        }
        this.parse_error_at(p, e, DiagIdentifier_expected)
        name
    }

    ; A synthesized identifier with text this port has to own: the bytes are
    ; copied onto the parse page, because a C string literal is not a
    ; `pointer[char]` the node can keep and the sanitizer builds its text a byte
    ; at a time anyway.
    ; ★★★ The range is left UNDEFINED, which is what the reference's factory
    ; leaves on a node nobody finishes — and the two callers differ on exactly
    ; that. `reparseJSDocSignature`'s `this` identifier is given the tag's range
    ; and the reparsed flags explicitly, one line after it is built;
    ; `reparseHosted`'s `this` identifier is NOT, so it reaches the tree at
    ; (-1, -1) with no flags while the PARAMETER around it carries the tag name's
    ; range. Both are in the dump, so a `new_node`'s default 0,0 is wrong for one
    ; of them — the fixture parser_jsdoc_reparse_signature_host.ts is what says so.
    procedure new_synthesized_identifier(this, bytes: pointer[char], len: int) returns pointer[AstNode]
    {
        let n this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData(bytes, len)))
        set n.pos: 0 - 1
        set n.end: 0 - 1
        n
    }

    procedure copy_bytes_to_page(this, src: pointer[const_char], len: int) returns pointer[char]
    {
        let b host.allocate(len + 1, 1) as pointer[char]
        var i 0
        while i < len
        {
            set *(b + i): *(src + i)
            set i: i + 1
        }
        set *(b + len): 0 as char
        b
    }

    ; createExportModifier — one `export` keyword in a one-element modifier list,
    ; both taking the location node's range.
    procedure create_export_modifier(this, location: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        let m this.new_node(KindExportKeyword, NodeData.Token(TokenData()))
        this.finish_reparsed_node(m, location)
        let l AstNode.new_node_list(host)
        l.add(m)
        l
    }

    ; makeNewCast: `e as T` for a @type tag, `e satisfies T` for @satisfies. The
    ; range is the EXPRESSION's — the cast is invisible in the text.
    procedure make_new_cast(this, t: pointer[AstNode], e: pointer[AstNode], is_assertion: bool) returns pointer[AstNode]
    {
        var n null as pointer[AstNode]
        if is_assertion
            set n: this.new_node(KindAsExpression, NodeData.AsExpression(AsExpressionData(e, t)))
        else
            set n: this.new_node(KindSatisfiesExpression, NodeData.SatisfiesExpression(AsExpressionData(e, t)))
        this.finish_node_with_end(n, e.pos, e.end)
    }

    ; skipSatisfiesExpressions.
    function skip_satisfies_expressions(n: pointer[AstNode]) returns pointer[AstNode]
    {
        var x n
        while x <> null
        {
            if x.kind <> KindSatisfiesExpression
                return x
            set x: AstNode.expression_of(x)
        }
        x
    }

    ; IsFunctionLikeKind, WHOLE — the seven declaration kinds plus the seven
    ; signature ones.
    ;
    ; ★ It was first written narrowed to the declarations, on the argument that
    ; getFunctionLikeHost is only ever handed a statement or an initializer
    ; expression and a signature cannot be either. That is true of everything the
    ; switch REACHES THROUGH — but not of its default arm, where `fun` stays the
    ; documented node itself, and a `.js` file may perfectly well contain an
    ; `interface` whose member carries a `@type` tag. A narrowing that holds for
    ; every path but one is a divergence with a comment on it; the seven extra
    ; lines are cheaper than the comment.
    function is_function_like_node(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        let k n.kind
        if k = KindFunctionDeclaration
            return true
        if k = KindFunctionExpression
            return true
        if k = KindArrowFunction
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindConstructor
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindMethodSignature
            return true
        if k = KindCallSignature
            return true
        if k = KindConstructSignature
            return true
        if k = KindIndexSignature
            return true
        if k = KindFunctionType
            return true
        if k = KindConstructorType
            return true
        k = KindJSDocSignature
    }

    ; IsAssignmentExpression(node, false) — a binary `=` (or a compound
    ; assignment) whose left side IS A VALID TARGET. The reference's
    ; GetRightMostAssignedExpression walks the RIGHT side of a run of them.
    ;
    ; ★ The left-hand-side test is the second conjunct and is not decoration:
    ; without it the walk crosses `1 = f()` and answers the call rather than the
    ; assignment, which is a different function-like host.
    function is_assignment_expression_node(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if n.kind <> KindBinaryExpression
            return false
        if is_assignment_operator(AstNode.binary_operator_kind(n)) = false
            return false
        let left AstNode.binary_left_of(n)
        if left = null
            return false
        is_left_hand_side_expression_kind(left.kind)
    }

    function get_right_most_assigned_expression(n: pointer[AstNode]) returns pointer[AstNode]
    {
        var x n
        while is_assignment_expression_node(x)
            set x: AstNode.binary_right_of(x)
        x
    }

    ; getFunctionLikeHost: from the node a comment documents, find the function
    ; the tag is really about.
    function get_function_like_host(host_node: pointer[AstNode]) returns pointer[AstNode]
    {
        if host_node = null
            return null
        var fun host_node
        let k host_node.kind
        if k = KindVariableStatement
        {
            let dl AstNode.variable_statement_list_of(host_node)
            let ds AstNode.variable_declarations_of(dl)
            if ds <> null
            {
                if (ds.get_length() as int) <> 0
                    set fun: AstNode.initializer_of(*(ds.get_buffer()))
                else
                    set fun: null
            }
            else
                set fun: null
        }
        if (k = KindPropertyAssignment) or (k = KindPropertyDeclaration)
            set fun: AstNode.initializer_of(host_node)
        if (k = KindExportAssignment) or (k = KindReturnStatement)
            set fun: AstNode.expression_of(host_node)
        if k = KindExpressionStatement
            set fun: get_right_most_assigned_expression(AstNode.expression_of(host_node))
        set fun: skip_satisfies_expressions(fun)
        if is_function_like_node(fun)
            return fun
        null
    }

    ; getClassLikeData, as the one question the reparser asks of it.
    function is_class_like_node(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        (n.kind = KindClassDeclaration) or (n.kind = KindClassExpression)
    }

    ; getInnermostNameOfJSDocNamespace: for `A.B.C` the name parses as nested
    ; ModuleDeclarations, and the alias is named after the innermost one.
    function get_innermost_name_of_jsdoc_namespace(full_name: pointer[AstNode]) returns pointer[AstNode]
    {
        if full_name = null
            return null
        var x full_name
        while x.kind = KindModuleDeclaration
        {
            let body AstNode.body_of(x)
            if body = null
                return AstNode.name_of(x)
            set x: body
        }
        x
    }

    ; wrapInJSDocNamespace: `@typedef {T} A.B.C` declares C inside namespace B
    ; inside namespace A. Every INNER namespace is exported so the dotted access
    ; works from outside; the outermost is not, because the binder decides that
    ; one (IsImplicitlyExportedJSDocDeclaration).
    procedure wrap_in_jsdoc_namespace(this, full_name: pointer[AstNode], statement: pointer[AstNode], nested: bool) returns pointer[AstNode]
    {
        if full_name = null
            return statement
        if full_name.kind <> KindModuleDeclaration
            return statement
        let wrapped this.wrap_in_jsdoc_namespace(AstNode.body_of(full_name), statement, true)
        let inner AstNode.new_node_list(host)
        inner.add(wrapped)
        let block this.new_node(KindModuleBlock, NodeData.ModuleBlock(BlockData(inner)))
        this.finish_reparsed_node(block, full_name)
        var modifiers null as pointer[Array[pointer[AstNode]]]
        if nested
            set modifiers: this.create_export_modifier(full_name)
        let name this.add_deep_clone_reparse(AstNode.name_of(full_name))
        let result this.new_node(KindModuleDeclaration, NodeData.ModuleDeclaration(ModuleDeclarationData(modifiers, KindNamespaceKeyword, name, block)))
        this.finish_reparsed_node(result, full_name)
        result
    }

    ; makeQuestionIfOptional: `[x]` or `{T=}` on the tag becomes a `?` on the
    ; parameter or property it produces.
    procedure make_question_if_optional(this, tag: pointer[AstNode]) returns pointer[AstNode]
    {
        var optional AstNode.jsdoc_param_is_bracketed(tag)
        if optional = false
        {
            let te AstNode.jsdoc_type_expression_of(tag)
            if te <> null
            {
                let inner AstNode.jsdoc_type_expression_inner_of(te)
                if inner <> null
                {
                    if inner.kind = KindJSDocOptionalType
                        set optional: true
                }
            }
        }
        if optional = false
            return null
        let q this.new_node(KindQuestionToken, NodeData.Token(TokenData()))
        this.finish_reparsed_node(q, tag)
        q
    }

    ; ── the jsdoc side table ────────────────────────────────────────────────
    ;
    ; The reference's `jsdocInfos`, which finishSourceFile turns into a map. Two
    ; parallel arrays here, and the LOOKUP answers the LAST match — which is the
    ; map's own semantics, since a later `result[parent] = jsDocs` overwrites an
    ; earlier one.
    procedure add_jsdoc_info(this, parent: pointer[AstNode], docs: pointer[Array[pointer[AstNode]]])
    {
        if jsdoc_infos_len < (jsdoc_info_nodes.get_length() as int)
        {
            jsdoc_info_nodes.put(jsdoc_infos_len as size_t, parent)
            jsdoc_info_lists.put(jsdoc_infos_len as size_t, docs)
        }
        else
        {
            jsdoc_info_nodes.add(parent)
            jsdoc_info_lists.add(docs)
        }
        set jsdoc_infos_len: jsdoc_infos_len + 1
    }

    function lookup_jsdoc_info(this, n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        var i jsdoc_infos_len - 1
        while i >= 0
        {
            if *(jsdoc_info_nodes.get_buffer() + i) = n
                return *(jsdoc_info_lists.get_buffer() + i)
            set i: i - 1
        }
        null
    }

    ; reparseJSDocComment: a synthesized parameter or property inherits the
    ; tag's own comment as a JSDoc of its own.
    procedure reparse_jsdoc_comment(this, n: pointer[AstNode], tag: pointer[AstNode])
    {
        if n = null
            return
        let comment AstNode.jsdoc_tag_comment_of(tag)
        if comment = null
            return
        let new_comment AstNode.new_node_list(host)
        var i 0
        let c comment.get_length() as int
        while i < c
        {
            new_comment.add(this.add_deep_clone_reparse(*(comment.get_buffer() + i)))
            set i: i + 1
        }
        let doc this.new_node(KindJSDoc, NodeData.JSDoc(JSDocData(new_comment, null)))
        this.finish_reparsed_node(doc, tag)
        let l AstNode.new_node_list(host)
        l.add(doc)
        this.add_jsdoc_info(n, l)
        set n.flags: n.flags | NodeFlagsHasJSDoc
    }

    ; gatherTypeParameters: every `@template` of ONE comment becomes the type
    ; parameter list of whatever the comment declares. The first template tag's
    ; constraint applies to its first parameter alone, which is why that one is
    ; rebuilt and the rest are cloned.
    procedure gather_type_parameters(this, j: pointer[AstNode], typedef_or_callback: bool) returns pointer[Array[pointer[AstNode]]]
    {
        let tags AstNode.jsdoc_tags_of(j)
        if tags = null
            return null
        var out null as pointer[Array[pointer[AstNode]]]
        var pos 0 - 1
        var end_pos 0 - 1
        var first_template true
        var i 0
        let n tags.get_length() as int
        while i < n
        {
            let tag *(tags.get_buffer() + i)
            set i: i + 1
            if typedef_or_callback = false
            {
                if (tag.kind = KindJSDocTypedefTag) or (tag.kind = KindJSDocCallbackTag)
                    return null
            }
            if tag.kind <> KindJSDocTemplateTag
                continue
            if first_template
            {
                set pos: tag.pos
                set first_template: false
            }
            set end_pos: tag.end
            let constraint AstNode.jsdoc_template_constraint_of(tag)
            var first_type_parameter true
            let tps AstNode.type_parameters_of(tag)
            if tps <> null
            {
                var k 0
                let tn tps.get_length() as int
                while k < tn
                {
                    let tp *(tps.get_buffer() + k)
                    set k: k + 1
                    var reparse null as pointer[AstNode]
                    if (constraint <> null) and first_type_parameter
                    {
                        let mods this.clone_modifier_list(AstNode.modifiers_of(tp))
                        let nm this.add_deep_clone_reparse(this.check_non_identifier_name(AstNode.name_of(tp)))
                        let cn this.add_deep_clone_reparse(AstNode.jsdoc_type_expression_inner_of(constraint))
                        let dt this.add_deep_clone_reparse(AstNode.type_parameter_default_of(tp))
                        set reparse: this.new_node(KindTypeParameter, NodeData.TypeParameter(TypeParameterData(mods, nm, cn, null, dt)))
                        this.finish_reparsed_node(reparse, tp)
                    }
                    else
                        set reparse: this.add_deep_clone_reparse(tp)
                    if out = null
                        set out: AstNode.new_node_list(host)
                    out.add(reparse)
                    set first_type_parameter: false
                }
            }
        }
        if out = null
            return null
        if (out.get_length() as int) = 0
            return null
        out
    }

    ; ★★★ DeepCloneReparseModifiers, and the one thing that separates it from
    ; DeepCloneReparse is that it does NOT stamp NodeFlagsReparsed:
    ;
    ;     func DeepCloneReparse(node)      { … ; node.Flags |= NodeFlagsReparsed }
    ;     func DeepCloneReparseModifiers(m) { return visitor.VisitModifiers(m) }
    ;
    ; The bit is put on the CLONE ROOT, and a modifier list has no root — its
    ; elements are visited, not adopted. Routing each element through
    ; add_deep_clone_reparse gave every one of them the flag, so `@template
    ; {string} const T` produced a ConstKeyword carrying 1<<3 where the
    ; reference's carries none. The tree, the spans and the kinds all agree;
    ; §3.5bo, and §3.5bf's point about a clone being an IDENTITY claim seen from
    ; the flag side.
    procedure clone_modifier_list(this, m: pointer[Array[pointer[AstNode]]]) returns pointer[Array[pointer[AstNode]]]
    {
        if m = null
            return null
        let l AstNode.new_node_list(host)
        var i 0
        let n m.get_length() as int
        while i < n
        {
            let src *(m.get_buffer() + i)
            let c AstNode.alloc(host)
            set *c: *src
            l.add(c)
            set i: i + 1
        }
        l
    }

    ; ── reparseJSDocTypeLiteral ─────────────────────────────────────────────
    ;
    ; A `@typedef` whose type is written as a run of `@property` tags becomes a
    ; TYPE LITERAL — and an array of one when the tag said `Object[]`. Anything
    ; else is simply the type, cloned.
    procedure reparse_jsdoc_type_literal(this, t: pointer[AstNode]) returns pointer[AstNode]
    {
        if t = null
            return null
        if t.kind <> KindJSDocTypeLiteral
            return this.add_deep_clone_reparse(t)

        let is_array AstNode.jsdoc_type_literal_is_array(t)
        let props AstNode.new_node_list(host)
        let tags AstNode.jsdoc_type_literal_tags_of(t)
        if tags <> null
        {
            var i 0
            let n tags.get_length() as int
            while i < n
            {
                let prop *(tags.get_buffer() + i)
                set i: i + 1
                if prop.kind <> KindJSDocPropertyTag
                {
                    if prop.kind <> KindJSDocParameterTag
                        continue
                }
                var name AstNode.name_of(prop)
                if name <> null
                {
                    if name.kind = KindQualifiedName
                        set name: AstNode.qualified_right_of(name)
                }
                if name <> null
                {
                    if name.kind = KindIdentifier
                    {
                        if this.is_valid_identifier_text(name) = false
                        {
                            ; The reference turns an unusable property name into a
                            ; STRING literal — `{ "a-b": T }` is writable where
                            ; `a-b` is not.
                            ;
                            ; ★ Slice 31: the literal carries the IDENTIFIER's
                            ; text (`NewStringLiteral(name.AsIdentifier().Text,
                            ; TokenFlagsNone)`), which is the one synthesized
                            ; literal in this port whose text is not a token
                            ; value — it has no token.
                            let s this.new_node(KindStringLiteral, NodeData.StringLiteral(LiteralData(AstNode.identifier_text_of(name), AstNode.identifier_text_length_of(name), TokenFlagsNone)))
                            set name: this.add_transformed_reparse(s, name)
                        }
                        else
                            set name: this.add_deep_clone_reparse(name)
                    }
                    else
                        set name: this.add_deep_clone_reparse(name)
                }
                let q this.make_question_if_optional(prop)
                let property this.new_node(KindPropertySignature, NodeData.PropertySignature(PropertyDeclarationData(null, name, q, null, null)))
                let pte AstNode.jsdoc_type_expression_of(prop)
                if pte <> null
                    AstNode.set_type(property, this.reparse_jsdoc_type_literal(AstNode.jsdoc_type_expression_inner_of(pte)))
                this.finish_reparsed_node(property, prop)
                props.add(property)
                this.reparse_jsdoc_comment(property, prop)
            }
        }
        var r this.new_node(KindTypeLiteral, NodeData.TypeLiteral(TypeLiteralData(props)))
        if is_array
        {
            this.finish_reparsed_node(r, t)
            set r: this.new_node(KindArrayType, NodeData.ArrayType(WrappedTypeData(r)))
        }
        this.finish_reparsed_node(r, t)
        r
    }

    ; ── reparseJSDocSignature ───────────────────────────────────────────────
    ;
    ; The shape shared by `@callback` (which declares a function TYPE) and
    ; `@overload` (which declares another signature of the function it documents).
    ; `fun` is what the signature is built AFTER — the documented declaration for
    ; @overload, the tag itself for @callback.
    procedure reparse_jsdoc_signature(this, js_signature: pointer[AstNode], fun: pointer[AstNode], jsdoc: pointer[AstNode], tag: pointer[AstNode], modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        var signature null as pointer[AstNode]
        let cloned_modifiers this.clone_modifier_list(modifiers)
        let fk fun.kind
        if fk = KindFunctionDeclaration
            set signature: this.new_node(KindFunctionDeclaration, NodeData.FunctionDeclaration(FunctionDeclarationData(cloned_modifiers, null, this.add_deep_clone_reparse(this.check_non_identifier_name(AstNode.name_of(fun))), null, null, null, null, null)))
        else
        {
            if fk = KindMethodDeclaration
                set signature: this.new_node(KindMethodDeclaration, NodeData.MethodDeclaration(MethodDeclarationData(cloned_modifiers, null, this.add_deep_clone_reparse(this.check_non_identifier_name(AstNode.name_of(fun))), null, null, null, null, null, null)))
            else
            {
                if fk = KindConstructor
                    set signature: this.new_node(KindConstructor, NodeData.ConstructorDeclaration(ConstructorDeclarationData(cloned_modifiers, null, null, null, null, null)))
                else
                {
                    if fk = KindJSDocCallbackTag
                    {
                        ; ★ NewKeywordTypeNode is never finished — the factory
                        ; leaves its range UNDEFINED, which the reference spells
                        ; (-1, -1) — and it survives unfinished only when the
                        ; callback declares no `@returns`, since a return type
                        ; overwrites the slot outright. The dump compares the
                        ; range, so the placeholder has to carry the reference's.
                        let any_kw this.new_node(KindAnyKeyword, NodeData.Token(TokenData()))
                        set any_kw.pos: 0 - 1
                        set any_kw.end: 0 - 1
                        set signature: this.new_node(KindFunctionType, NodeData.FunctionType(FunctionTypeData(null, null, any_kw)))
                    }
                    else
                        return this.unported("jsdoc-reparse-signature-host", fk)
                }
            }
        }

        if tag.kind <> KindJSDocCallbackTag
            AstNode.set_type_parameters(signature, this.gather_type_parameters(jsdoc, false))

        let parameters AstNode.new_node_list(host)
        let sig_params AstNode.parameters_of(js_signature)
        if sig_params <> null
        {
            var pi 0
            let pn sig_params.get_length() as int
            while pi < pn
            {
                let param *(sig_params.get_buffer() + pi)
                let index pi
                set pi: pi + 1
                var parameter null as pointer[AstNode]
                if param.kind = KindJSDocThisTag
                {
                    let bytes this.copy_bytes_to_page("this", 4)
                    let this_ident this.new_synthesized_identifier(bytes, 4)
                    set this_ident.pos: param.pos
                    set this_ident.end: param.end
                    set this_ident.flags: context_flags | NodeFlagsReparsed
                    set parameter: this.new_node(KindParameter, NodeData.Parameter(ParameterData(null, null, this_ident, null, null, null)))
                    let te AstNode.jsdoc_type_expression_of(param)
                    if te <> null
                        AstNode.set_type(parameter, this.add_deep_clone_reparse(AstNode.jsdoc_type_expression_inner_of(te)))
                }
                else
                {
                    if param.kind = KindJSDocParameterTag
                        set parameter: this.reparse_jsdoc_signature_parameter(param, index)
                    else
                    {
                        if param.kind = KindJSDocPropertyTag
                            set parameter: this.reparse_jsdoc_signature_parameter(param, index)
                    }
                }
                ; ★ A sub-property tag (`@param x.y`) is SKIPPED — it describes a
                ; property of another parameter, not a parameter of its own — and
                ; the skip leaves `parameter` null, which is the reference's own
                ; `continue`.
                if parameter = null
                    continue
                this.finish_reparsed_node(parameter, param)
                parameters.add(parameter)
                this.reparse_jsdoc_comment(parameter, param)
            }
        }
        AstNode.set_parameters(signature, parameters)

        let ret AstNode.jsdoc_signature_type_of(js_signature)
        if ret <> null
        {
            let rte AstNode.jsdoc_type_expression_of(ret)
            if rte <> null
                AstNode.set_type(signature, this.add_deep_clone_reparse(AstNode.jsdoc_type_expression_inner_of(rte)))
        }
        var loc js_signature
        if tag.kind = KindJSDocOverloadTag
            set loc: AstNode.jsdoc_tag_name_of(tag)
        this.finish_reparsed_node(signature, loc)
        signature
    }

    ; The @param/@property arm of the loop above, split out because it is long
    ; and because the sub-property skip has to answer null to its caller.
    procedure reparse_jsdoc_signature_parameter(this, param: pointer[AstNode], index: int) returns pointer[AstNode]
    {
        let raw_name AstNode.name_of(param)
        if raw_name <> null
        {
            if raw_name.kind = KindQualifiedName
                return null
        }
        var dot_dot_dot null as pointer[AstNode]
        var param_type null as pointer[AstNode]
        let te AstNode.jsdoc_type_expression_of(param)
        if te <> null
        {
            let inner AstNode.jsdoc_type_expression_inner_of(te)
            if inner <> null
            {
                if inner.kind = KindJSDocVariadicType
                {
                    set dot_dot_dot: this.new_node(KindDotDotDotToken, NodeData.Token(TokenData()))
                    this.finish_reparsed_node(dot_dot_dot, param)
                    set param_type: this.reparse_jsdoc_type_literal(AstNode.jsdoc_variadic_inner_of(inner))
                }
                else
                    set param_type: this.reparse_jsdoc_type_literal(inner)
            }
        }
        var name raw_name
        if name <> null
        {
            if name.kind = KindIdentifier
            {
                if this.is_valid_identifier_text(name) = false
                    set name: this.sanitize_parameter_name(name, index)
                else
                    set name: this.add_deep_clone_reparse(name)
            }
            else
                set name: this.add_deep_clone_reparse(name)
        }
        let q this.make_question_if_optional(param)
        this.new_node(KindParameter, NodeData.Parameter(ParameterData(null, dot_dot_dot, name, q, param_type, null)))
    }

    ; The reference's in-place rewrite of a `@param` name that is not a valid
    ; identifier: every bad code point becomes `_`, and a name that empties out
    ; entirely becomes `_<index>` so the emitter has something to write.
    procedure sanitize_parameter_name(this, name: pointer[AstNode], index: int) returns pointer[AstNode]
    {
        let t AstNode.identifier_text_of(name)
        let len AstNode.identifier_text_length_of(name)
        let out host.allocate(len + 24, 1) as pointer[char]
        var n 0
        var i 0
        var first true
        while i < len
        {
            let cp scanner.utf8_decode_in(t, len, i)
            let sz scanner.utf8_size_in(t, len, i)
            var ok false
            if first
                set ok: Scanner.is_identifier_start(cp)
            else
                set ok: Scanner.is_identifier_part(cp)
            if ok
            {
                var k 0
                while k < sz
                {
                    set *(out + n): *(t + i + k)
                    set n: n + 1
                    set k: k + 1
                }
            }
            else
            {
                set *(out + n): "_" as char
                set n: n + 1
            }
            set first: false
            set i: i + sz
        }
        if n = 0
        {
            set *(out + n): "_" as char
            set n: n + 1
            set n: n + write_decimal(out + n, index)
        }
        set *(out + n): 0 as char
        this.add_transformed_reparse(this.new_synthesized_identifier(out, n), name)
    }

    ; strconv.Itoa for a non-negative index, written into a buffer. Answers how
    ; many bytes it wrote.
    function write_decimal(out: pointer[char], v: int) returns int
    {
        if v = 0
        {
            set *out: "0" as char
            return 1
        }
        var digits: int 0
        var x v
        while x > 0
        {
            set digits: digits + 1
            set x: x / 10
        }
        var i digits
        var y v
        while i > 0
        {
            set i: i - 1
            set *(out + i): (("0" as char as int) + (y % 10)) as char
            set y: y / 10
        }
        digits
    }

    ; ── GetAssignmentDeclarationKind ────────────────────────────────────────
    ;
    ; ★★★ SLICE 33 GENERALISED THIS AND THE PARAGRAPH IT REPLACES IS WORTH
    ; KEEPING AS A RECORD, because it is §3.5p in all three of its shapes at
    ; once. It used to read: *the reference answers a JSDeclarationKind; both
    ; readers here compare it against `None` and nothing else, so this answers
    ; the BOOLEAN and says so — and only the KindBinaryExpression arm is ported,
    ; because the CallExpression arm and the whole IsBindableStaticNameExpression
    ; family under it are unreachable from here.* Every word of that was true of
    ; the JSDoc reparser, which is what asked it; the binder's two heads ask the
    ; same function for the KIND, in a TS file as well as a JS one, and about a
    ; CALL as well as an assignment. So the boolean, the JS-file assumption and
    ; the missing arm all expired together, and the two reparser call sites now
    ; ask `<> JSDeclarationKindNone`, which is what the reference writes at
    ; exactly those two sites (reparser.go:372 and :443).
    function is_access_expression(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        (n.kind = KindPropertyAccessExpression) or (n.kind = KindElementAccessExpression)
    }

    function is_string_or_numeric_literal_like(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if n.kind = KindStringLiteral
            return true
        if n.kind = KindNoSubstitutionTemplateLiteral
            return true
        n.kind = KindNumericLiteral
    }

    ; ast.IsStringLiteralLike — the same two kinds without the numeric one.
    function is_string_literal_like(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if n.kind = KindStringLiteral
            return true
        n.kind = KindNoSubstitutionTemplateLiteral
    }

    function skip_parentheses(n: pointer[AstNode]) returns pointer[AstNode]
    {
        var x n
        while x <> null
        {
            if x.kind <> KindParenthesizedExpression
                return x
            set x: AstNode.expression_of(x)
        }
        x
    }

    ; GetElementOrPropertyAccessName — the NAME of an access expression, or null
    ; when it has none that can be used as one.
    function get_element_or_property_access_name(n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        if n.kind = KindPropertyAccessExpression
        {
            let nm AstNode.property_access_name_of(n)
            if nm = null
                return null
            if nm.kind = KindIdentifier
                return nm
            return null
        }
        if n.kind = KindElementAccessExpression
        {
            let arg skip_parentheses(AstNode.element_access_argument_of(n))
            if is_string_or_numeric_literal_like(arg)
                return arg
            return null
        }
        null
    }

    function is_module_identifier(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if n.kind <> KindIdentifier
            return false
        AstNode.text_is(n, "module")
    }

    function is_exports_identifier(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if n.kind <> KindIdentifier
            return false
        AstNode.text_is(n, "exports")
    }

    function is_module_exports_access_expression(n: pointer[AstNode]) returns bool
    {
        if is_access_expression(n) = false
            return false
        if is_module_identifier(AstNode.expression_of(n)) = false
            return false
        let name get_element_or_property_access_name(n)
        if name = null
            return false
        AstNode.text_is(name, "exports")
    }

    ; ast.IsEntityNameExpressionEx. `allow_js` admits two more spellings — a bare
    ; `this`, and an element access whose argument is a string or numeric literal
    ; — and the flag is the CALLER's file, not a property of the node: the same
    ; `a["b"].c` is an entity name inside a JavaScript file and is not inside a
    ; TypeScript one.
    ;
    ; ★ It carried the flag as its NAME (`is_entity_name_expression_js`) while its
    ; only caller ran in a JS file. The binder's copy of the same recursion —
    ; Binder.is_entity_name_expression, allowJS false — was the other half of that
    ; split, and slice 33 needs both readings from one place, so the flag is a
    ; parameter and there is one copy. §3.5e: where the reference has one
    ; function, keep one here.
    function is_entity_name_expression_ex(n: pointer[AstNode], allow_js: bool) returns bool
    {
        if n = null
            return false
        if n.kind = KindIdentifier
            return true
        if n.kind = KindPropertyAccessExpression
        {
            let nm AstNode.property_access_name_of(n)
            if nm = null
                return false
            if nm.kind <> KindIdentifier
                return false
            return is_entity_name_expression_ex(AstNode.expression_of(n), allow_js)
        }
        if allow_js = false
            return false
        if n.kind = KindThisKeyword
            return true
        if n.kind = KindElementAccessExpression
        {
            if is_string_or_numeric_literal_like(AstNode.element_access_argument_of(n)) = false
                return false
            return is_entity_name_expression_ex(AstNode.expression_of(n), allow_js)
        }
        false
    }

    ; ast.IsEntityNameExpression: the Ex form with allowJS FALSE.
    function is_entity_name_expression(n: pointer[AstNode]) returns bool
        is_entity_name_expression_ex(n, false)

    ; ast.IsInJSFile — a NODE flag, so it is asked of the node the reference asks
    ; it of. GetAssignmentDeclarationKind asks it of `bin.Left` in one place and
    ; of the call node in the other; both are transcribed rather than folded into
    ; one question about the file, because the reparser SYNTHESIZES nodes and the
    ; flag is what says which file they came from.
    function is_in_js_file(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        (n.flags & NodeFlagsJavaScriptFile) <> 0
    }

    ; ast.IsLiteralLikeElementAccess.
    function is_literal_like_element_access(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if n.kind <> KindElementAccessExpression
            return false
        is_string_or_numeric_literal_like(AstNode.element_access_argument_of(n))
    }

    ; ast.IsBindableStaticNameExpression / …AccessExpression / …ElementAccess-
    ; Expression — one mutual recursion, three entry points, ported whole because
    ; upstream is three functions that call each other and splitting the cycle
    ; would mean deciding which of them is "the" one.
    ;
    ; `exclude_this` is threaded exactly as written: it is FALSE only at the
    ; outermost call and TRUE at every recursive one, which is what makes
    ; `this.a.b` bindable while `a.this.b` is not — and the one caller here
    ; (IsBindableObjectDefinePropertyCall) passes TRUE even at the top, because
    ; `Object.defineProperty(this, …)` is not a static name.
    function is_bindable_static_name_expression(n: pointer[AstNode], exclude_this: bool) returns bool
    {
        if is_entity_name_expression(n)
            return true
        is_bindable_static_access_expression(n, exclude_this)
    }

    function is_bindable_static_access_expression(n: pointer[AstNode], exclude_this: bool) returns bool
    {
        if n = null
            return false
        if n.kind = KindPropertyAccessExpression
        {
            let inner AstNode.expression_of(n)
            if exclude_this = false
            {
                if inner <> null
                {
                    if inner.kind = KindThisKeyword
                        return true
                }
            }
            let nm AstNode.property_access_name_of(n)
            if nm <> null
            {
                if nm.kind = KindIdentifier
                {
                    if is_bindable_static_name_expression(inner, true)
                        return true
                }
            }
        }
        is_bindable_static_element_access_expression(n, exclude_this)
    }

    function is_bindable_static_element_access_expression(n: pointer[AstNode], exclude_this: bool) returns bool
    {
        if is_literal_like_element_access(n) = false
            return false
        let inner AstNode.expression_of(n)
        if exclude_this = false
        {
            if inner <> null
            {
                if inner.kind = KindThisKeyword
                    return true
            }
        }
        if is_entity_name_expression(inner)
            return true
        is_bindable_static_access_expression(inner, true)
    }

    ; ast.IsBindableObjectDefinePropertyCall: exactly `Object.defineProperty(x,
    ; "name", descriptor)` — three arguments, the callee spelled out as a
    ; property access of the identifier `Object`, and a literal property name.
    ; The FIRST argument decides between the two ObjectDefineProperty kinds and
    ; is read by the caller.
    function is_bindable_object_define_property_call(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        if n.kind <> KindCallExpression
            return false
        let args AstNode.call_arguments_of(n)
        if args = null
            return false
        if args.get_length() <> 3
            return false
        let expr AstNode.expression_of(n)
        if expr = null
            return false
        if expr.kind <> KindPropertyAccessExpression
            return false
        let obj AstNode.expression_of(expr)
        if obj = null
            return false
        if obj.kind <> KindIdentifier
            return false
        if AstNode.text_is(obj, "Object") = false
            return false
        let nm AstNode.property_access_name_of(expr)
        if nm = null
            return false
        if AstNode.text_is(nm, "defineProperty") = false
            return false
        if is_string_or_numeric_literal_like(*(args.get_buffer() + 1)) = false
            return false
        is_bindable_static_name_expression(*(args.get_buffer() + 0), true)
    }

    ; ast.GetAssignmentDeclarationKind, whole. Two arms; `None` for everything
    ; else, including every assignment that is not one of these five shapes.
    ;
    ; ★★★ THE `Property` ARM IS OUTSIDE THE JS TEST, and that one line is why
    ; this classifier belongs to the binder rather than to the JSDoc reparser:
    ; `f.x = 1` in a TypeScript file is an expando declaration upstream, so a
    ; port that answered `None` for every TS file would silently claim agreement
    ; on exactly the units where the reference declares an extra symbol.
    function get_assignment_declaration_kind(n: pointer[AstNode]) returns int
    {
        if n = null
            return JSDeclarationKindNone
        if n.kind = KindBinaryExpression
        {
            if AstNode.binary_operator_kind(n) <> KindEqualsToken
                return JSDeclarationKindNone
            let left AstNode.binary_left_of(n)
            if is_access_expression(left) = false
                return JSDeclarationKindNone
            let inner AstNode.expression_of(left)
            if is_in_js_file(left)
            {
                if is_module_exports_access_expression(left)
                {
                    if is_exports_identifier(AstNode.binary_right_of(n)) = false
                        return JSDeclarationKindModuleExports
                }
                if is_module_exports_access_expression(inner) or is_exports_identifier(inner)
                {
                    if get_element_or_property_access_name(left) <> null
                        return JSDeclarationKindExportsProperty
                }
                if inner <> null
                {
                    if inner.kind = KindThisKeyword
                        return JSDeclarationKindThisProperty
                }
            }
            if left.kind = KindPropertyAccessExpression
            {
                if is_entity_name_expression_ex(inner, is_in_js_file(left))
                {
                    let nm AstNode.property_access_name_of(left)
                    if nm <> null
                    {
                        if nm.kind = KindIdentifier
                            return JSDeclarationKindProperty
                    }
                }
            }
            if left.kind = KindElementAccessExpression
            {
                if is_entity_name_expression_ex(inner, is_in_js_file(left))
                    return JSDeclarationKindProperty
            }
            return JSDeclarationKindNone
        }
        if n.kind = KindCallExpression
        {
            if is_in_js_file(n) = false
                return JSDeclarationKindNone
            if is_bindable_object_define_property_call(n) = false
                return JSDeclarationKindNone
            let args AstNode.call_arguments_of(n)
            let entity_name *(args.get_buffer() + 0)
            if is_exports_identifier(entity_name)
                return JSDeclarationKindObjectDefinePropertyExports
            if is_module_exports_access_expression(entity_name)
                return JSDeclarationKindObjectDefinePropertyExports
            return JSDeclarationKindObjectDefinePropertyValue
        }
        JSDeclarationKindNone
    }

    ; ast.IsRequireCall. The reference's second parameter asks whether the one
    ; argument must be a string literal; both callers this port has pass FALSE,
    ; and the parameter is kept rather than folded away because the reference's
    ; other callers pass TRUE and §3.5ar's lesson is that a signature narrowed to
    ; today's callers costs more the second time.
    function is_require_call(n: pointer[AstNode], require_string_literal_like_argument: bool) returns bool
    {
        if n = null
            return false
        if n.kind <> KindCallExpression
            return false
        let expr AstNode.expression_of(n)
        if expr = null
            return false
        if expr.kind <> KindIdentifier
            return false
        if AstNode.text_is(expr, "require") = false
            return false
        let args AstNode.call_arguments_of(n)
        if args = null
            return false
        if args.get_length() <> 1
            return false
        if require_string_literal_like_argument = false
            return true
        is_string_literal_like(*(args.get_buffer() + 0))
    }

    ; HasSamePropertyAccessName.
    function has_same_property_access_name(a: pointer[AstNode], b: pointer[AstNode]) returns bool
    {
        if a = null
            return false
        if b = null
            return false
        if (a.kind = KindIdentifier) and (b.kind = KindIdentifier)
        {
            let at AstNode.identifier_text_of(a)
            let al AstNode.identifier_text_length_of(a)
            let bt AstNode.identifier_text_of(b)
            let bl AstNode.identifier_text_length_of(b)
            if al <> bl
                return false
            var i 0
            while i < al
            {
                if *(at + i) <> *(bt + i)
                    return false
                set i: i + 1
            }
            return true
        }
        if (a.kind = KindPropertyAccessExpression) and (b.kind = KindPropertyAccessExpression)
        {
            if has_same_property_access_name(AstNode.property_access_name_of(a), AstNode.property_access_name_of(b)) = false
                return false
            return has_same_property_access_name(AstNode.expression_of(a), AstNode.expression_of(b))
        }
        false
    }

    ; findMatchingParameter: the tag's own index among the comment's @param tags
    ; decides the match when the names do not — which is what makes
    ; `@param {T}` with no name at all reach the right parameter.
    procedure find_matching_parameter(this, fun: pointer[AstNode], parameter_tag: pointer[AstNode], jsdoc: pointer[AstNode]) returns pointer[AstNode]
    {
        var tag_index 0 - 1
        var param_count 0 - 1
        let tags AstNode.jsdoc_tags_of(jsdoc)
        if tags <> null
        {
            var i 0
            let n tags.get_length() as int
            while i < n
            {
                let tag *(tags.get_buffer() + i)
                set i: i + 1
                if tag.kind = KindJSDocParameterTag
                {
                    set param_count: param_count + 1
                    if tag = parameter_tag
                    {
                        set tag_index: param_count
                        break
                    }
                }
            }
        }
        let params AstNode.parameters_of(fun)
        if params = null
            return null
        let tag_name AstNode.name_of(parameter_tag)
        var pi 0
        let pn params.get_length() as int
        while pi < pn
        {
            let parameter *(params.get_buffer() + pi)
            let index pi
            set pi: pi + 1
            let pname AstNode.name_of(parameter)
            if pname = null
                continue
            if pname.kind = KindIdentifier
            {
                if tag_name <> null
                {
                    if tag_name.kind = KindIdentifier
                    {
                        if has_same_property_access_name(pname, tag_name)
                            return parameter
                        if index = tag_index
                        {
                            if AstNode.identifier_text_length_of(tag_name) = 0
                                return parameter
                        }
                    }
                }
            }
            else
            {
                if index = tag_index
                    return parameter
            }
        }
        null
    }

    ; ── reparseTags and the two halves ──────────────────────────────────────

    procedure reparse_tags(this, parent: pointer[AstNode], jsdoc: pointer[Array[pointer[AstNode]]])
    {
        if jsdoc = null
            return
        let n jsdoc.get_length() as int
        var i 0
        while i < n
        {
            let j *(jsdoc.get_buffer() + i)
            let is_last i = (n - 1)
            set i: i + 1
            let tags AstNode.jsdoc_tags_of(j)
            if tags = null
                continue
            var k 0
            let tn tags.get_length() as int
            while k < tn
            {
                let tag *(tags.get_buffer() + k)
                set k: k + 1
                this.reparse_unhosted(tag, parent, j)
                if is_last
                    this.reparse_hosted(tag, parent, j)
            }
        }
    }

    ; A tag that becomes a declaration of its own.
    procedure reparse_unhosted(this, tag: pointer[AstNode], parent: pointer[AstNode], jsdoc: pointer[AstNode])
    {
        let tk tag.kind

        if (tk = KindJSDocTypedefTag) or (tk = KindJSDocCallbackTag)
        {
            let type_expression AstNode.jsdoc_type_expression_of(tag)
            if type_expression = null
                return
            let full_name AstNode.name_of(tag)
            var modifiers null as pointer[Array[pointer[AstNode]]]
            if full_name <> null
            {
                if full_name.kind = KindModuleDeclaration
                    set modifiers: this.create_export_modifier(tag)
            }
            ; ★★★ The two arms are merged because everything else about them is
            ; the same, and this ONE line is what the merge nearly swallowed: the
            ; reference applies checkNonIdentifierName to the @typedef name and
            ; NOT to the @callback name. A `@callback c-d` therefore reports
            ; nothing where a `@typedef {T} a-b` reports `Identifier expected`,
            ; and the difference is a diagnostic — which is the half of the ast
            ; dump that is easiest to add by accident. Fixture:
            ; parser_jsdoc_reparse_callback_name.ts.
            var raw_alias_name get_innermost_name_of_jsdoc_namespace(full_name)
            if tk = KindJSDocTypedefTag
                set raw_alias_name: this.check_non_identifier_name(raw_alias_name)
            let alias_name this.add_deep_clone_reparse(raw_alias_name)
            var t null as pointer[AstNode]
            if tk = KindJSDocCallbackTag
                set t: this.reparse_jsdoc_signature(type_expression, tag, jsdoc, tag, null)
            else
            {
                if type_expression.kind = KindJSDocTypeExpression
                    set t: this.add_deep_clone_reparse(AstNode.jsdoc_type_expression_inner_of(type_expression))
                else
                {
                    if type_expression.kind = KindJSDocTypeLiteral
                        set t: this.reparse_jsdoc_type_literal(type_expression)
                    else
                    {
                        this.unported("jsdoc-typedef-type-expression", type_expression.kind)
                        return
                    }
                }
            }
            let type_alias this.new_node(KindJSTypeAliasDeclaration, NodeData.JSTypeAliasDeclaration(TypeAliasDeclarationData(modifiers, alias_name, null, t)))
            AstNode.set_type_parameters(type_alias, this.gather_type_parameters(jsdoc, true))
            this.finish_reparsed_node(type_alias, tag)
            let docs AstNode.new_node_list(host)
            docs.add(jsdoc)
            this.add_jsdoc_info(type_alias, docs)
            set type_alias.flags: type_alias.flags | NodeFlagsHasJSDoc
            reparse_list.add(this.wrap_in_jsdoc_namespace(full_name, type_alias, false))
            return
        }

        if tk = KindJSDocImportTag
        {
            let clause AstNode.jsdoc_import_clause_of(tag)
            if clause = null
                return
            let import_clause this.add_deep_clone_reparse(clause)
            AstNode.set_import_clause_phase_modifier(import_clause, KindTypeKeyword)
            ; ★ The reference passes `importTag.Modifiers()` here and a
            ; JSDocImportTag has no Modifiers slot — Node.Modifiers() answers nil
            ; for that kind — so the argument is always nil and this port does not
            ; carry the field at all.
            let decl this.new_node(KindJSImportDeclaration, NodeData.JSImportDeclaration(ImportDeclarationData(null, import_clause, this.add_deep_clone_reparse(AstNode.jsdoc_import_specifier_of(tag)), this.add_deep_clone_reparse(AstNode.jsdoc_import_attributes_of(tag)))))
            this.finish_reparsed_node(decl, tag)
            reparse_list.add(decl)
            return
        }

        if tk = KindJSDocOverloadTag
        {
            ; An overload signature is created only for a function, method or
            ; constructor declaration, and never inside an object literal — where
            ; those kinds are not class-like members at all.
            let pk parent.kind
            var ok false
            if pk = KindFunctionDeclaration
                set ok: true
            if pk = KindMethodDeclaration
                set ok: true
            if pk = KindConstructor
                set ok: true
            if ok = false
                return
            if (parsing_contexts & (1 << PCObjectLiteralMembers)) <> 0
                return
            let te AstNode.jsdoc_type_expression_of(tag)
            reparse_list.add(this.reparse_jsdoc_signature(te, parent, jsdoc, tag, AstNode.modifiers_of(parent)))
        }
    }

    ; A tag that mutates the node it documents.
    procedure reparse_hosted(this, tag: pointer[AstNode], parent: pointer[AstNode], jsdoc: pointer[AstNode])
    {
        let tk tag.kind

        if tk = KindJSDocTypeTag
        {
            if this.reparse_type_tag_on_host(tag, parent)
                return
            let fun get_function_like_host(parent)
            if fun = null
                return
            let te AstNode.jsdoc_type_expression_of(tag)
            if te = null
                return
            if AstNode.type_parameters_of(fun) <> null
                return
            if AstNode.type_of(fun) <> null
                return
            let params AstNode.parameters_of(fun)
            if params <> null
            {
                var i 0
                let n params.get_length() as int
                while i < n
                {
                    if AstNode.type_of(*(params.get_buffer() + i)) <> null
                        return
                    set i: i + 1
                }
            }
            AstNode.set_full_signature(fun, this.add_deep_clone_reparse(AstNode.jsdoc_type_expression_inner_of(te)))
            return
        }

        if tk = KindJSDocSatisfiesTag
        {
            this.reparse_satisfies_tag(tag, parent)
            return
        }

        if tk = KindJSDocTemplateTag
        {
            let fun get_function_like_host(parent)
            if fun <> null
            {
                if AstNode.type_parameters_of(fun) = null
                {
                    if AstNode.full_signature_of(fun) = null
                        AstNode.set_type_parameters(fun, this.gather_type_parameters(jsdoc, false))
                }
                return
            }
            if is_class_like_node(parent)
            {
                if AstNode.type_parameters_of(parent) = null
                    AstNode.set_type_parameters(parent, this.gather_type_parameters(jsdoc, false))
            }
            return
        }

        if tk = KindJSDocParameterTag
        {
            let fun get_function_like_host(parent)
            if fun = null
                return
            if AstNode.full_signature_of(fun) <> null
                return
            let param this.find_matching_parameter(fun, tag, jsdoc)
            if param = null
                return
            let te AstNode.jsdoc_type_expression_of(tag)
            if AstNode.type_of(param) = null
            {
                if te <> null
                    AstNode.set_type(param, this.reparse_jsdoc_type_literal(AstNode.jsdoc_type_expression_inner_of(te)))
            }
            if AstNode.parameter_question_token_of(param) = null
                AstNode.set_parameter_question_token(param, this.make_question_if_optional(tag))
            return
        }

        if tk = KindJSDocThisTag
        {
            let fun get_function_like_host(parent)
            if fun = null
                return
            let params AstNode.parameters_of(fun)
            var has_this false
            if params <> null
            {
                if (params.get_length() as int) <> 0
                {
                    let first_name AstNode.name_of(*(params.get_buffer()))
                    if first_name <> null
                    {
                        if first_name.kind = KindThisKeyword
                            set has_this: true
                        if first_name.kind = KindIdentifier
                        {
                            if AstNode.text_is(first_name, "this")
                                set has_this: true
                        }
                    }
                }
            }
            if has_this
                return
            let bytes this.copy_bytes_to_page("this", 4)
            let ident this.new_synthesized_identifier(bytes, 4)
            let this_param this.new_node(KindParameter, NodeData.Parameter(ParameterData(null, null, ident, null, null, null)))
            let te AstNode.jsdoc_type_expression_of(tag)
            if te <> null
                AstNode.set_type(this_param, this.add_deep_clone_reparse(AstNode.jsdoc_type_expression_inner_of(te)))
            this.finish_reparsed_node(this_param, AstNode.jsdoc_tag_name_of(tag))
            let new_params AstNode.new_node_list(host)
            new_params.add(this_param)
            if params <> null
            {
                var i 0
                let n params.get_length() as int
                while i < n
                {
                    new_params.add(*(params.get_buffer() + i))
                    set i: i + 1
                }
            }
            AstNode.set_parameters(fun, new_params)
            return
        }

        if tk = KindJSDocReturnTag
        {
            let fun get_function_like_host(parent)
            if fun = null
                return
            if AstNode.full_signature_of(fun) <> null
                return
            if AstNode.type_of(fun) <> null
                return
            let te AstNode.jsdoc_type_expression_of(tag)
            if te = null
                return
            AstNode.set_type(fun, this.add_deep_clone_reparse(AstNode.jsdoc_type_expression_inner_of(te)))
            return
        }

        if is_jsdoc_modifier_tag(tk)
        {
            this.reparse_modifier_tag(tag, parent)
            return
        }

        if tk = KindJSDocImplementsTag
        {
            this.reparse_implements_tag(tag, parent)
            return
        }

        if tk = KindJSDocAugmentsTag
            this.reparse_augments_tag(tag, parent)
    }

    ; The @type tag's HOSTED arms — the switch over the documented node's kind.
    ; Answers whether the tag was consumed, so the caller can fall through to the
    ; function-like host the reference falls through to.
    procedure reparse_type_tag_on_host(this, tag: pointer[AstNode], parent: pointer[AstNode]) returns bool
    {
        let te AstNode.jsdoc_type_expression_of(tag)
        if te = null
            return false
        let inner AstNode.jsdoc_type_expression_inner_of(te)
        let pk parent.kind

        if pk = KindVariableStatement
        {
            let ds AstNode.variable_declarations_of(AstNode.variable_statement_list_of(parent))
            if ds = null
                return false
            var i 0
            let n ds.get_length() as int
            while i < n
            {
                let d *(ds.get_buffer() + i)
                set i: i + 1
                if AstNode.type_of(d) = null
                {
                    AstNode.set_type(d, this.add_deep_clone_reparse(inner))
                    return true
                }
            }
            return false
        }

        var direct false
        if pk = KindVariableDeclaration
            set direct: true
        if pk = KindExportAssignment
            set direct: true
        if pk = KindPropertyDeclaration
            set direct: true
        if pk = KindPropertyAssignment
            set direct: true
        if pk = KindShorthandPropertyAssignment
            set direct: true
        if pk = KindGetAccessor
            set direct: true
        if direct
        {
            if AstNode.type_of(parent) <> null
                return false
            AstNode.set_type(parent, this.add_deep_clone_reparse(inner))
            return true
        }

        if pk = KindParameter
        {
            if AstNode.type_of(parent) <> null
                return false
            AstNode.set_type(parent, this.reparse_jsdoc_type_literal(inner))
            return true
        }

        if pk = KindExpressionStatement
        {
            let bin AstNode.expression_of(parent)
            if bin = null
                return false
            if bin.kind <> KindBinaryExpression
                return false
            if get_assignment_declaration_kind(bin) = JSDeclarationKindNone
                return false
            AstNode.set_type(bin, this.add_deep_clone_reparse(inner))
            return true
        }

        if (pk = KindReturnStatement) or (pk = KindParenthesizedExpression)
        {
            let e AstNode.expression_of(parent)
            if e = null
                return false
            AstNode.set_expression(parent, this.make_new_cast(this.add_deep_clone_reparse(inner), e, true))
            return true
        }

        false
    }

    procedure reparse_satisfies_tag(this, tag: pointer[AstNode], parent: pointer[AstNode])
    {
        let te AstNode.jsdoc_type_expression_of(tag)
        if te = null
            return
        let inner AstNode.jsdoc_type_expression_inner_of(te)
        let pk parent.kind

        if pk = KindVariableStatement
        {
            let ds AstNode.variable_declarations_of(AstNode.variable_statement_list_of(parent))
            if ds = null
                return
            var i 0
            let n ds.get_length() as int
            while i < n
            {
                let d *(ds.get_buffer() + i)
                set i: i + 1
                let initializer AstNode.initializer_of(d)
                if initializer <> null
                {
                    AstNode.set_initializer(d, this.make_new_cast(this.add_deep_clone_reparse(inner), initializer, false))
                    break
                }
            }
            return
        }

        var direct false
        if pk = KindVariableDeclaration
            set direct: true
        if pk = KindPropertyDeclaration
            set direct: true
        if pk = KindPropertyAssignment
            set direct: true
        if direct
        {
            let initializer AstNode.initializer_of(parent)
            if initializer = null
                return
            AstNode.set_initializer(parent, this.make_new_cast(this.add_deep_clone_reparse(inner), initializer, false))
            return
        }

        if pk = KindShorthandPropertyAssignment
        {
            let initializer AstNode.shorthand_object_assignment_initializer_of(parent)
            if initializer = null
                return
            AstNode.set_shorthand_object_assignment_initializer(parent, this.make_new_cast(this.add_deep_clone_reparse(inner), initializer, false))
            return
        }

        var expr_host false
        if pk = KindReturnStatement
            set expr_host: true
        if pk = KindParenthesizedExpression
            set expr_host: true
        if pk = KindExportAssignment
            set expr_host: true
        if expr_host
        {
            let e AstNode.expression_of(parent)
            if e = null
                return
            AstNode.set_expression(parent, this.make_new_cast(this.add_deep_clone_reparse(inner), e, false))
            return
        }

        if pk = KindExpressionStatement
        {
            let bin AstNode.expression_of(parent)
            if bin = null
                return
            if bin.kind <> KindBinaryExpression
                return
            if get_assignment_declaration_kind(bin) = JSDeclarationKindNone
                return
            AstNode.set_binary_right(bin, this.make_new_cast(this.add_deep_clone_reparse(inner), AstNode.binary_right_of(bin), false))
        }
    }

    ; @readonly / @private / @public / @protected / @override become real
    ; modifiers on the member they document.
    function is_jsdoc_modifier_tag(k: int) returns bool
    {
        if k = KindJSDocReadonlyTag
            return true
        if k = KindJSDocPrivateTag
            return true
        if k = KindJSDocPublicTag
            return true
        if k = KindJSDocProtectedTag
            return true
        k = KindJSDocOverrideTag
    }

    procedure reparse_modifier_tag(this, tag: pointer[AstNode], parent_in: pointer[AstNode])
    {
        var parent parent_in
        if parent.kind = KindExpressionStatement
            set parent: AstNode.expression_of(parent)
        if parent = null
            return
        let pk parent.kind

        var accessor_like false
        if pk = KindMethodDeclaration
            set accessor_like: true
        if pk = KindGetAccessor
            set accessor_like: true
        if pk = KindSetAccessor
            set accessor_like: true
        if accessor_like
        {
            ; ★ In an object literal these are not class-like members, so a JSDoc
            ; modifier is not a modifier there and reparsing it would produce a
            ; grammar error the reference does not (upstream issue #4437).
            if (parsing_contexts & (1 << PCObjectLiteralMembers)) <> 0
                return
        }
        else
        {
            var member false
            if pk = KindPropertyDeclaration
                set member: true
            if pk = KindConstructor
                set member: true
            if pk = KindBinaryExpression
                set member: true
            if member = false
                return
        }

        var keyword KindUnknown
        if tag.kind = KindJSDocReadonlyTag
            set keyword: KindReadonlyKeyword
        if tag.kind = KindJSDocPrivateTag
            set keyword: KindPrivateKeyword
        if tag.kind = KindJSDocPublicTag
            set keyword: KindPublicKeyword
        if tag.kind = KindJSDocProtectedTag
            set keyword: KindProtectedKeyword
        if tag.kind = KindJSDocOverrideTag
            set keyword: KindOverrideKeyword

        let modifier this.new_node(keyword, NodeData.Token(TokenData()))
        this.finish_reparsed_node(modifier, tag)
        let existing AstNode.modifiers_of(parent)
        let nodes AstNode.new_node_list(host)
        if existing <> null
        {
            var i 0
            let n existing.get_length() as int
            while i < n
            {
                nodes.add(*(existing.get_buffer() + i))
                set i: i + 1
            }
        }
        nodes.add(modifier)
        AstNode.set_modifiers(parent, nodes)
    }

    procedure reparse_implements_tag(this, tag: pointer[AstNode], parent: pointer[AstNode])
    {
        if is_class_like_node(parent) = false
            return
        let class_name AstNode.jsdoc_class_name_of(tag)
        if class_name = null
            return
        let clauses AstNode.class_heritage_clauses_of(parent)
        if clauses <> null
        {
            var i 0
            let n clauses.get_length() as int
            while i < n
            {
                let c *(clauses.get_buffer() + i)
                set i: i + 1
                if AstNode.heritage_clause_token_of(c) = KindImplementsKeyword
                {
                    let types AstNode.heritage_clause_types_of(c)
                    if types <> null
                    {
                        types.add(this.add_deep_clone_reparse(class_name))
                        return
                    }
                }
            }
        }
        let types_list AstNode.new_node_list(host)
        types_list.add(this.add_deep_clone_reparse(class_name))
        let clause this.new_node(KindHeritageClause, NodeData.HeritageClause(HeritageClauseData(KindImplementsKeyword, types_list)))
        this.finish_reparsed_node(clause, class_name)
        if clauses = null
        {
            let hs AstNode.new_node_list(host)
            hs.add(clause)
            AstNode.set_class_heritage_clauses(parent, hs)
        }
        else
            clauses.add(clause)
    }

    ; @augments {Base<T>} fills in the type arguments of an `extends Base` the
    ; source wrote without any — and only when the two name the same base.
    procedure reparse_augments_tag(this, tag: pointer[AstNode], parent: pointer[AstNode])
    {
        if is_class_like_node(parent) = false
            return
        let clauses AstNode.class_heritage_clauses_of(parent)
        if clauses = null
            return
        var i 0
        let n clauses.get_length() as int
        while i < n
        {
            let c *(clauses.get_buffer() + i)
            set i: i + 1
            if AstNode.heritage_clause_token_of(c) <> KindExtendsKeyword
                continue
            let types AstNode.heritage_clause_types_of(c)
            if types = null
                continue
            if (types.get_length() as int) <> 1
                continue
            let target *(types.get_buffer())
            let source AstNode.jsdoc_class_name_of(tag)
            if source = null
                continue
            if has_same_property_access_name(AstNode.expression_of(target), AstNode.expression_of(source)) = false
                continue
            if AstNode.type_arguments_of(target) <> null
                continue
            let src_args AstNode.type_arguments_of(source)
            if src_args = null
                continue
            let new_args AstNode.new_node_list(host)
            var k 0
            let m src_args.get_length() as int
            while k < m
            {
                new_args.add(this.add_deep_clone_reparse(*(src_args.get_buffer() + k)))
                set k: k + 1
            }
            AstNode.set_expression_type_arguments(target, new_args)
        }
    }

    ; ── the entry points ────────────────────────────────────────────────────

    ; parseJSDocForNode — the LAZY parse a TS/TSX file defers to. The reference
    ; runs it on a fresh parser out of a pool and throws its diagnostics away;
    ; here it runs on the parser that produced the tree, which is the same thing
    ; with one region instead of a pool, and parse_jsdoc_comment already restores
    ; every field it touches.
    procedure parse_jsdoc_for_node(this, n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        ; ★★★ The HasJSDoc test is the reference's `Node.JSDoc(file)`'s FIRST
        ; line and it is not an optimisation: without it every node re-derives
        ; the comment ranges of the position it starts at, and a node that
        ; shares its start with a documented one — a SourceFile with its first
        ; statement, a VariableStatement with its declaration list — answers
        ; that statement's JSDoc as its own.
        if (AstNode.flags_of(n) & NodeFlagsHasJSDoc) = 0
            return null

        ; ★★★ Node.JSDoc(file)'s second test, and slice 22 is what makes it more
        ; than one branch: `if file.hasLazyJSDoc { return file.resolveJSDoc(node) }
        ; return file.jsdocCache[node]`. finishSourceFile sets hasLazyJSDoc for a
        ; NON-JavaScript file only, so a `.js` unit answers out of the table the
        ; parse filled — and it has to, because the reparser puts entries there
        ; for nodes with no comment ranges of their own: a synthesized parameter
        ; carrying its @param tag's text starts nowhere near the comment.
        if this.is_java_script()
            return this.lookup_jsdoc_info(n)

        ; ★★★ THE LAZY PARSE RUNS ON A FRESH PARSER, and that is a statement
        ; about the CONTEXT FLAGS rather than about allocation. resolveJSDoc
        ; calls `p := getParser()` + `p.initializeState(...)`, so the only bits
        ; standing when the comment is parsed are the ones the SCRIPT KIND puts
        ; there — `parseSourceFileWorker`'s `contextFlags |= NodeFlagsAmbient`
        ; for a `.d.ts` never ran on it. Reusing this parser leaks that bit into
        ; every JSDoc node of every declaration file: 1<<22 where the reference
        ; has 1<<22 alone. Three units of the stage-2 corpus, and invisible to a
        ; dump that prints kinds and spans only (§3.5bj).
        ;
        ; Only the flags are reset, not the parser: parse_jsdoc_comment already
        ; saves and restores the source text, the token, the scanner mark, the
        ; parsing contexts and the diagnostic length, which is the rest of what a
        ; fresh instance would give.
        ;
        ; ★★★ AND THE CACHE IS ASKED FIRST, which is the same fact from the other
        ; side. resolveJSDoc's own first act is a cache lookup, and a NON-JS file
        ; does have entries in that cache: with_jsdoc falls THROUGH to an eager
        ; parse when the comment carries @see or @link, and those nodes were made
        ; while the file's flags were standing — so the reference answers them
        ; WITH Ambient. Re-deriving instead would strip a bit the reference keeps,
        ; i.e. the very defect above in the opposite direction, and the fixture
        ; carries both halves for that reason.
        let cached this.lookup_jsdoc_info(n)
        if cached <> null
            return cached

        let saved context_flags
        set context_flags: this.initial_context_flags()
        let result this.parse_jsdoc_comments_of(n)
        set context_flags: saved
        result
    }

    ; initializeState's context-flag switch, as a function, because the lazy
    ; JSDoc accessor above needs the value a FRESH parser would start from.
    function initial_context_flags(this) returns int
    {
        if script_kind = ScriptKindJSON
            return NodeFlagsJavaScriptFile | NodeFlagsJsonFile
        if script_kind = ScriptKindJS
            return NodeFlagsJavaScriptFile
        if script_kind = ScriptKindJSX
            return NodeFlagsJavaScriptFile
        NodeFlagsNone
    }

    ; The same walk without the flag gate. with_jsdoc needs it for a JavaScript
    ; file, where the flag is set only AFTER a comment has parsed — the gate above
    ; belongs to the ACCESSOR, which is asked about a node whose parse is over.
    procedure parse_jsdoc_comments_of(this, n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        let ranges this.cparts_new()
        this.get_jsdoc_comment_ranges(n, ranges)
        let count (ranges.get_length() as int) / 2
        if count = 0
            return null
        let jsdoc AstNode.new_node_list(host)
        var pos AstNode.pos_of(n)
        var i 0
        while i < count
        {
            let s *(ranges.get_buffer() + (i * 2))
            let e *(ranges.get_buffer() + ((i * 2) + 1))
            let parsed this.parse_jsdoc_comment(n, s, e, pos)
            if parsed <> null
            {
                jsdoc.add(parsed)
                set pos: AstNode.end_of(parsed)
            }
            set i: i + 1
        }
        if (jsdoc.get_length() as int) = 0
            return null
        jsdoc
    }

    ; The program-facing form. A concept STATIC taking the parser explicitly,
    ; because a user program calling a cross-package method on a concept pointer
    ; does not resolve while a static does (root CLAUDE.md).
    function jsdoc_for_node(p: pointer[Parser], n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
        p.parse_jsdoc_for_node(n)
}
