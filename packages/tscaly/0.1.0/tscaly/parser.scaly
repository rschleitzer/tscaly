; SPDX-License-Identifier: Apache-2.0
;
; parser — ported from the reference's internal/parser/parser.go.
;
; SLICES 1–6. The spine, the declaration router, the TYPE surface, the
; SIGNATURE, the EXPRESSION ladder and the CLASS family. Anything outside them reports its own
; POSITION as unported rather than building a plausible tree that quietly
; disagrees with the reference — the same mechanism the scanner carries, and for
; the same reason.
;
; ── What is parsed ──────────────────────────────────────────────────────────
;
;   slice 1  SourceFile, EndOfFile
;            EmptyStatement, Block, ExpressionStatement
;            VariableStatement / VariableDeclarationList / VariableDeclaration
;            Identifier, NumericLiteral, BigIntLiteral, StringLiteral, and the
;            keyword expressions this / super / null / true / false
;   slice 2  modifiers and the declaration ROUTER — every declaration form goes
;            through parse_declaration, because modifiers are parsed before
;            anyone knows what they modify
;   slice 3  the type parser (see the TYPES banner far below), the type ALIAS
;            declaration, and `: T` type annotations
;   slice 4  the SIGNATURE (see the SIGNATURES banner): parameter lists, return
;            types and type predicates, the function declaration, and the
;            function and constructor TYPES the type parser was waiting on
;   slice 5  the EXPRESSION ladder (see the EXPRESSIONS banner), and with it
;            three things that only became REACHABLE once expressions parsed:
;            `await`/`using` at statement start (both fall through to an
;            expression statement when the look-ahead says no declaration), the
;            HasJSDoc clear on a `(`-headed expression statement, and the
;            top-level-await REPARSE condition — the reference's second pass
;            over statements that used `await` as a name in a module
;   slice 6  the CLASS family (see the CLASSES banner): the declaration and the
;            expression, the heritage clauses, and the six member forms —
;            method, property, constructor, get/set accessor, static block,
;            index signature. Three of those entry points are SHARED with the
;            object literal, so `{ m() {} }` and `{ get p() {} }` land here too;
;            and the private name `#x` comes with them, because a private name
;            exists only inside a class body
;
; ── What it deliberately does not, each stated rather than left to be noticed ─
;
; ★ DIAGNOSTICS. The reference emits TS1xxx parse errors, and the yardstick
;   compares their code and span. These slices emit NONE — and so any path that
;   WOULD emit one reports unported instead. That is the honest boundary: a
;   parser that recovers from an error without producing the error is a parser
;   whose tree cannot be compared, and one that invents a code is worse. It also
;   means NodeFlagsThisNodeHasError is never set here, because it cannot be
;   reached without a diagnostic first.
;
;   ★★ It also has a consequence for the negative controls: because the port
;   bails at every point the reference would RECOVER at, most ways of breaking
;   it on purpose surface as an extra UNPORTED rather than as a wrong tree. The
;   controls that can actually go red are the ones that change the shape of a
;   tree that still completes — child ORDER, node KIND, a range. Both kinds are
;   real (unported is not a pass), but they are not equally strong, and
;   CLAUDE.md's control table says which each one is.
;
; ★ THE CLASS FAMILY IS IN (slice 6), and what is left is one surface with two
;   names. `interface`, `namespace` and `enum` are 26.4 % of corpus first
;   blockers and the object TYPE literal another 18.1 % — but an interface BODY
;   and a type literal are the same production (parseTypeMember), so those two
;   rows are ONE slice and together they are 44.5 %. After them come the
;   `export`/`import` declarations at 19.2 % and the diagnostics slice, which
;   shows up as `semicolon KindColonToken` at 10.4 %. What the ladder itself
;   still omits is named at the EXPRESSIONS banner, one line per construct.
;
; ★ ERROR RECOVERY. The reference parses lists through parsing CONTEXTS with
;   per-context element and terminator predicates and a token-skipping recovery.
;   The statement loops here are the well-formed path only, and the three type
;   list contexts port the two predicates but not the recovery. That is not a
;   shortcut that changes results: recovery only runs after a diagnostic, and a
;   diagnostic is already an unported report.
;
; ── Three mapping decisions, all for CLAUDE.md §3 ───────────────────────────
;
; (1) `lookAhead(callback)` becomes a method per call site that marks, scans and
;     rewinds inline. Go passes a func value; Scaly's only escaping-closure form
;     is `return \x: …`, and a speculation helper taking a callback is exactly
;     the shape the escape checker exists to reject. The saved block is
;     ScannerState — which is the whole reason the scanner keeps one (§3.5).
;
; (2) The reference's `switch p.token` becomes a run of INDEPENDENT `if` blocks
;     that return, never an `else if` chain: a chain nests one planner level per
;     arm at roughly 110 KB of planner stack per arm under the bootstrap stages,
;     and this switch has about forty. The arms are disjoint by construction —
;     each tests the same token against a distinct kind — so the two are exactly
;     equivalent here. Same reasoning as the scanner's, one level up.
;
; (3) `unported` has TWO records since slice 5, because the reference's `rewind`
;     truncates its diagnostics and ours has to have the same lifetime. Which
;     record a site writes says what its report means — see the ParserState
;     header, which is where the argument lives.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use tscaly.scanner.Scanner
use tscaly.scanner.ScannerState
use tscaly.ast.AstNode
use tscaly.ast.NodeData
use tscaly.ast.TokenData
use tscaly.ast.IdentifierData
use tscaly.ast.LiteralData
use tscaly.ast.EmptyStatementData
use tscaly.ast.SourceFileData
use tscaly.ast.BlockData
use tscaly.ast.ExpressionStatementData
use tscaly.ast.VariableStatementData
use tscaly.ast.VariableDeclarationListData
use tscaly.ast.VariableDeclarationData
use tscaly.ast.ReturnStatementData
use tscaly.ast.IfStatementData
use tscaly.ast.WrappedTypeData
use tscaly.ast.TypeListData
use tscaly.ast.QualifiedNameData
use tscaly.ast.TypeReferenceData
use tscaly.ast.TypeQueryData
use tscaly.ast.IndexedAccessTypeData
use tscaly.ast.ConditionalTypeData
use tscaly.ast.TypePredicateData
use tscaly.ast.NamedTupleMemberData
use tscaly.ast.TypeParameterData
use tscaly.ast.TypeAliasDeclarationData
use tscaly.ast.ParameterData
use tscaly.ast.FunctionDeclarationData
use tscaly.ast.FunctionTypeData
use tscaly.ast.ConstructorTypeData
use tscaly.ast.BinaryExpressionData
use tscaly.ast.ConditionalExpressionData
use tscaly.ast.YieldExpressionData
use tscaly.ast.AsExpressionData
use tscaly.ast.TypeAssertionData
use tscaly.ast.PropertyAccessData
use tscaly.ast.ElementAccessData
use tscaly.ast.CallExpressionData
use tscaly.ast.NewExpressionData
use tscaly.ast.ExpressionWithTypeArgumentsData
use tscaly.ast.ElementListData
use tscaly.ast.ArrowFunctionData
use tscaly.ast.FunctionExpressionData
use tscaly.ast.PropertyAssignmentData
use tscaly.ast.ShorthandPropertyAssignmentData
use tscaly.ast.ClassLikeData
use tscaly.ast.HeritageClauseData
use tscaly.ast.MethodDeclarationData
use tscaly.ast.PropertyDeclarationData
use tscaly.ast.ConstructorDeclarationData
use tscaly.ast.AccessorDeclarationData
use tscaly.ast.ClassStaticBlockDeclarationData
use tscaly.ast.IndexSignatureDeclarationData

; The reference's jsdocScannerInfo — what the scanner noticed about the JSDoc
; comment preceding the token the parser is about to consume. It is captured at
; the START of a construct, because by the time the node is finished the token
; carrying the flags is long gone.
; The reference's ParsingContext, for the lists these slices parse — the
; comma-delimited ones and, since slice 6, the two UNDELIMITED ones a class
; body is made of. Upstream uses these as BIT POSITIONS in `parsingContexts`, a set it
; consults during error recovery to decide whether an enclosing list could
; consume the token it is stuck on. This slice has no recovery, so the values
; are plain tags and the numbering is ours. Add an entry only when the list it
; names is actually parsed — an unreachable arm of isListElement/isListTerminator
; is an untested transcription of a table that is easy to get subtly wrong.
define PCTypeArguments:       int 0
define PCTypeParameters:      int 1
define PCTupleElementTypes:   int 2
define PCParameters:          int 3
define PCArgumentExpressions: int 4
define PCArrayLiteralMembers: int 5
define PCObjectLiteralMembers: int 6
define PCClassMembers:        int 7
define PCHeritageClauses:     int 8
define PCHeritageClauseElement: int 9

; ── operator precedence, ported from internal/ast/precedence.go ─────────────
;
; The reference declares these with `iota`, so the VALUES are an artifact of the
; declaration order and only their ORDER is meaningful — which is why they are
; written out here rather than derived. Two of them are aliases rather than
; positions of their own (Coalesce IS LogicalOR), exactly as upstream has it.
;
; Invalid is -1 and is lower than every real precedence, which is what makes
; parseBinaryExpressionRest stop on a token that is not a binary operator: the
; loop's test is `newPrecedence > precedence`, and Lowest is 0.
define OperatorPrecedenceComma:          int 0
define OperatorPrecedenceSpread:         int 1
define OperatorPrecedenceYield:          int 2
define OperatorPrecedenceAssignment:     int 3
define OperatorPrecedenceConditional:    int 4
define OperatorPrecedenceLogicalOR:      int 5
define OperatorPrecedenceLogicalAND:     int 6
define OperatorPrecedenceBitwiseOR:      int 7
define OperatorPrecedenceBitwiseXOR:     int 8
define OperatorPrecedenceBitwiseAND:     int 9
define OperatorPrecedenceEquality:       int 10
define OperatorPrecedenceRelational:     int 11
define OperatorPrecedenceShift:          int 12
define OperatorPrecedenceAdditive:       int 13
define OperatorPrecedenceMultiplicative: int 14
define OperatorPrecedenceExponentiation: int 15
define OperatorPrecedenceUnary:          int 16
define OperatorPrecedenceUpdate:         int 17
define OperatorPrecedenceLeftHandSide:   int 18
define OperatorPrecedenceOptionalChain:  int 19
define OperatorPrecedenceMember:         int 20
define OperatorPrecedencePrimary:        int 21
define OperatorPrecedenceParentheses:    int 22

define OperatorPrecedenceLowest:   int OperatorPrecedenceComma
define OperatorPrecedenceHighest:  int OperatorPrecedenceParentheses
define OperatorPrecedenceCoalesce: int OperatorPrecedenceLogicalOR
define OperatorPrecedenceInvalid:  int 0 - 1

; The reference's core.Tristate, for the one question that needs three answers:
; does a `(`, `<` or `async` start an arrow function? TRUE parses one without
; further ado, FALSE never does, and UNKNOWN speculates — and the three are not
; collapsible, because UNKNOWN is the case that must be able to change its mind.
define TristateFalse:   int 0
define TristateTrue:    int 1
define TristateUnknown: int 2

; The reference's ParseFlags — the signature context a parameter list and a
; function body are parsed in. Only the three this slice can REACH are declared:
; ParseFlagsJSDoc belongs to the JSDoc parser, and ParseFlagsIgnoreMissingOpenBrace
; is set at exactly one call site (an arrow function's body), which is unported.
define ParseFlagsNone:  int 0
define ParseFlagsYield: int 1 << 0
define ParseFlagsAwait: int 1 << 1
define ParseFlagsType:  int 1 << 2

define JsdocInfoNone:         int 0
define JsdocInfoHasJsdoc:     int 1 << 0
define JsdocInfoHasDeprecated: int 1 << 1
define JsdocInfoHasSeeOrLink: int 1 << 2

; The reference's ParserState (mark/rewind). It saves the scanner's block plus
; the parser's own speculative state.
;
; ★★★ It ALSO saves the unported record since slice 5, which REVERSES the
; decision §3.9e recorded — and the reason is that the reference's own `rewind`
; TRUNCATES p.diagnostics back to the saved length. A speculation that reported
; errors and was then discarded reports NOTHING upstream. Our `unported` stands
; in for those diagnostics, so it has to have their lifetime; keeping it sticky
; made a discarded speculation poison the whole parse.
;
; That is not a corner case. `a << b` puts the expression ladder into
; tryParseTypeArgumentsInExpression, which parses `<b>` as a type-parameter list,
; fails to find a comma, and throws the whole thing away — upstream with its
; diagnostics, here with an unported record that used to survive. A shift
; operator was unparsable.
;
; ★★ What §3.9e was actually protecting is a DIFFERENT question, and it now has
; its own channel rather than a different rewind. Two records, and which one a
; site writes says what its report MEANS:
;
;   unported      the reference would have emitted a DIAGNOSTIC here. Rewound
;                 with the speculation that produced it, exactly as
;                 p.diagnostics is. Almost every site.
;   unanswerable  this port cannot ANSWER a question whose answer the caller is
;                 about to use. NOT rewound, because the answer travels out of
;                 the speculation even though the parse does not.
;                 `skip_parameter_start` is the only site, and the whole of
;                 §3.9e is about it: answering `false` there would route
;                 `([a]: T) => U` down the parenthesized-type path and build a
;                 tree nobody has checked.
;
; Getting it backwards is silent in both directions: `unported` where the answer
; escapes lets a wrong tree through, and `unanswerable` where the reference
; discards over-reports a construct this port can in fact parse.
define ParserState
(
    scanner_state: ScannerState
    context_flags: int
    has_parse_error: bool
    statement_has_await_identifier: bool
    unported_pos: int
    unported_tag: pointer[const_char]
    unported_detail: int
)
{
    init(ss: ScannerState, cf: int, hpe: bool, hai: bool, up: int, ut: pointer[const_char], ud: int)
    {
        set scanner_state: ss
        set context_flags: cf
        set has_parse_error: hpe
        set statement_has_await_identifier: hai
        set unported_pos: up
        set unported_tag: ut
        set unported_detail: ud
    }
}

define Parser
(
    host: pointer[Page]
    scanner: pointer[Scanner]
    token: int
    context_flags: int
    has_parse_error: bool

    ; Position of the first construct this slice does not implement, or -1,
    ; plus WHAT it was: a short tag and the token kind it applied to.
    ;
    ; NOT part of the reference. The position alone was the first draft and it
    ; is not enough to plan by — 316 cases reporting a byte offset says how many
    ; are left, never which construct to port next. With the tag the runner's
    ; unported column becomes a histogram, and the next slice is READ off it
    ; rather than guessed.
    ;
    ; It also carries the SCANNER's own omission up: a scan that could not
    ; proceed makes every span after it meaningless, so the parser must not
    ; report a tree built on one.
    unported_pos: int
    unported_tag: pointer[const_char]
    unported_detail: int

    ; The second record — "this port cannot ANSWER this question" — which a
    ; rewind does NOT restore, because the answer leaves the speculation even
    ; though the parse does not. One site writes it; see the ParserState header
    ; and `unanswerable_bool`.
    unanswerable_pos: int
    unanswerable_tag: pointer[const_char]
    unanswerable_detail: int

    ; The await context a parameter list was entered FROM. The reference reads
    ; it out of a closure — parseParametersWorker captures it before it changes
    ; the context flags, and the per-element callback uses it for the parameter's
    ; DECORATORS, which are parsed in the outer context while the rest of the
    ; parameter is parsed in the function's.
    ;
    ; Here the list's element callback is a static arm of parse_list_element
    ; (§3.9d/§3.9e — a func value that would have to escape becomes a method or,
    ; as here, a piece of state), so the captured value travels as a field. It is
    ; live only for the duration of one parse_delimited_list(PCParameters) call
    ; and is saved and restored around it, exactly as a capture would be.
    parameter_outer_await_context: bool

    ; parseParametersWorker's `allowAmbiguity`, travelling the same way and for
    ; the same reason: the element callback is a static arm of parse_list_element
    ; (§3.9d/§3.9e), so what the reference closes over has to be state here. It
    ; is false only inside the speculative half of an arrow-function parse.
    parameter_allow_ambiguity: bool

    ; The reference's `notParenthesizedArrow` — the set of token positions at
    ; which a speculative arrow-function parse has already failed, so the same
    ; text is never speculated over twice. It is a pure MEMO: the reference adds
    ; to it only where the parse answered nil, and re-running would answer nil
    ; again. Carried anyway, because without it a run of nested parentheses
    ; re-speculates at every level.
    not_parenthesized_arrow: pointer[Array[int]]

    ; The reference's `statementHasAwaitIdentifier`: did the TOP-LEVEL statement
    ; now being parsed contain an identifier literally named `await`, outside any
    ; await context? Upstream uses it to decide which statements to RE-PARSE with
    ; AwaitContext on, after the whole file has been parsed once
    ; (reparseTopLevelAwait). This port has the detection and not the reparse, so
    ; a statement that would be re-parsed is reported as unported instead — see
    ; parse_source_file. It is saved and restored by mark/rewind, exactly as the
    ; reference saves it.
    statement_has_await_identifier: bool

    ; ... and the file-level half of it: did ANY top-level statement record such
    ; a span? The reference keeps the spans themselves (possibleAwaitSpans),
    ; because it re-parses exactly those statements; this port only has to know
    ; that there was one.
    has_possible_await_span: bool
)
{
    init(host: pointer[Page], scanner: pointer[Scanner])
    {
        set this.host: host
        set this.scanner: scanner
        set this.token: KindUnknown
        set this.context_flags: NodeFlagsNone
        set this.has_parse_error: false
        set this.parameter_outer_await_context: false
        set this.parameter_allow_ambiguity: true
        set this.not_parenthesized_arrow: null
        set this.statement_has_await_identifier: false
        set this.has_possible_await_span: false
        set this.unported_pos: 0 - 1
        set this.unported_tag: null
        set this.unported_detail: 0
        set this.unanswerable_pos: 0 - 1
        set this.unanswerable_tag: null
        set this.unanswerable_detail: 0
    }

    ; ── the entry point ─────────────────────────────────────────────────────
    ;
    ; A concept STATIC taking the page explicitly: a user program calling a
    ; cross-package free function with a concept-pointer parameter fails
    ; resolution, while a static resolves (root CLAUDE.md). `out_unported`
    ; receives the unported position, or -1 — an out-parameter of scalar type,
    ; which is the safe direction (an out-parameter carrying a String-bearing
    ; struct is the live dangling class in this repo).
    ;
    ; The result is the SourceFile node, or null when nothing could be parsed.
    ; A non-negative `out_unported` invalidates the tree: read it FIRST.
    function parse(host: pointer[Page], source: String, out_unported: pointer[int], out_tag: pointer[pointer[const_char]], out_detail: pointer[int]) returns pointer[AstNode]
    {
        let sc host.allocate(sizeof Scanner, alignof Scanner) as pointer[Scanner]
        set *sc: Scanner(source)

        let p host.allocate(sizeof Parser, alignof Parser) as pointer[Parser]
        set *p: Parser(host, sc)

        let file p.parse_source_file()
        set *out_unported: p.unported_at()
        set *out_tag: p.unported_tag_at()
        set *out_detail: p.unported_detail_at()
        file
    }

    ; The two records fold here, and the DIAGNOSTIC one wins when both are set:
    ; it is the report that stopped the parse that is standing now, while an
    ; unanswerable one may have been left behind by a speculation whose text was
    ; then parsed another way. Either one alone stops the parse.
    function unported_at(this) returns int
    {
        if unported_pos >= 0
            return unported_pos
        unanswerable_pos
    }

    function unported_tag_at(this) returns pointer[const_char]
    {
        if unported_pos >= 0
            return unported_tag
        unanswerable_tag
    }

    function unported_detail_at(this) returns int
    {
        if unported_pos >= 0
            return unported_detail
        unanswerable_detail
    }

    ; Record the first unported construct and answer null, so a bail-out is one
    ; statement at the call site: `return this.unported("tag", token)`.
    ;
    ; `tag` names the construct, `detail` is the token kind it applied to (0
    ; where the kind adds nothing). Only the FIRST is kept — everything after it
    ; is parsed in a state the port already knows is wrong.
    procedure unported(this, tag: pointer[const_char], detail: int) returns pointer[AstNode]
    {
        if unported_pos < 0
        {
            set unported_pos: scanner.token_full_start()
            set unported_tag: tag
            set unported_detail: detail
        }
        null
    }

    function is_unported(this) returns bool
    {
        if unported_pos >= 0
            return true
        unanswerable_pos >= 0
    }

    ; ── node construction ───────────────────────────────────────────────────

    procedure new_node(this, kind: int, data: NodeData) returns pointer[AstNode]
    {
        let n AstNode.alloc(host)
        set n.kind: kind
        set n.flags: NodeFlagsNone
        set n.pos: 0
        set n.end: 0
        set n.data: data
        n
    }

    ; The reference's finishNode: the node's range is [pos, nodePos()), where
    ; nodePos() is the FULL start of the token the parser is now looking at —
    ; i.e. the end of the last token consumed. The context flags join here,
    ; which is what makes them a property of where a node was parsed.
    procedure finish_node(this, n: pointer[AstNode], pos: int) returns pointer[AstNode]
    {
        if n = null
            return null
        set n.pos: pos
        set n.end: this.node_pos()
        set n.flags: n.flags | context_flags
        if has_parse_error
        {
            set n.flags: n.flags | NodeFlagsThisNodeHasError
            set has_parse_error: false
        }
        n
    }

    ; ── token plumbing ──────────────────────────────────────────────────────

    function node_pos(this) returns int
        scanner.token_full_start()

    function has_preceding_line_break(this) returns bool
        scanner.has_preceding_line_break()

    ; ── JSDoc ───────────────────────────────────────────────────────────────
    ;
    ; Only the CHEAP half of the reference's withJSDoc is ported, and that is
    ; the half a .ts file takes: for a non-JavaScript file the reference sets
    ; HasJSDoc (and PossiblyContainsDeprecatedTag) from a text scan the scanner
    ; already did, and defers the actual JSDoc parse to first access. It parses
    ; eagerly in exactly one case — the comment contains @see or @link, which
    ; the unused-identifier check needs — and that eager parse is unported, so
    ; it is reported rather than skipped.

    function jsdoc_scanner_info(this) returns int
    {
        if scanner.has_preceding_jsdoc_comment() = false
            return JsdocInfoNone
        var info JsdocInfoHasJsdoc
        if scanner.has_preceding_jsdoc_with_deprecated_tag()
            set info: info | JsdocInfoHasDeprecated
        if scanner.has_preceding_jsdoc_with_see_or_link()
            set info: info | JsdocInfoHasSeeOrLink
        info
    }

    ; Answers the node, so a caller can end with `this.with_jsdoc(result, jsdoc)`,
    ; or null when the eager path is reached.
    procedure with_jsdoc(this, n: pointer[AstNode], info: int) returns pointer[AstNode]
    {
        if n = null
            return null
        if (info & JsdocInfoHasJsdoc) = 0
            return n
        set n.flags: n.flags | NodeFlagsHasJSDoc
        if (info & JsdocInfoHasDeprecated) <> 0
            set n.flags: n.flags | NodeFlagsPossiblyContainsDeprecatedTag
        if (info & JsdocInfoHasSeeOrLink) <> 0
            return this.unported("jsdoc-see-or-link", 0)
        n
    }

    procedure next_token(this) returns int
    {
        ; The reference reports Keywords_cannot_contain_escape_characters here.
        ; A diagnostic is unported, and swallowing it would produce a tree the
        ; reference disagrees with while looking perfectly well-formed.
        if is_keyword(token)
        {
            if scanner.has_unicode_escape() or scanner.has_extended_unicode_escape()
                this.unported("keyword-escape", token)
        }
        this.next_token_without_check()
    }

    ; The reference's nextTokenWithoutCheck — the same scan without the
    ; escaped-keyword check above. The split is load-bearing rather than
    ; cosmetic: an identifier NAME may legally BE a keyword (`a.default`, `type`
    ; used as a variable name), and createIdentifier advances through THIS
    ; entry point, so routing it through next_token would report unported for a
    ; construct the reference accepts without a word.
    ;
    ; Our own two carry-ups stay on this side, because they are about the scan
    ; itself and every caller needs them.
    procedure next_token_without_check(this) returns int
    {
        set token: scanner.scan()

        ; ★ A token the SCANNER found fault with means the reference emitted a
        ; diagnostic — `"unterminated` reports Unterminated_string_literal and
        ; marks the node ThisNodeHasError. This slice has no diagnostics, so such
        ; a token is where the port stops.
        ;
        ; The test is the token FLAGS, and it is deliberately PARTIAL: our
        ; scanner sets a flag at the string, template, escape and numeric error
        ; sites, but the reference also reports where no flag is set at all — an
        ; unterminated block comment, a missing hex digit after `0x`, an invalid
        ; character, a conflict marker. Those are not covered here and they are
        ; not hidden either: with no diagnostic on our side they come out as an
        ; UNEXPLAINED difference, never as a silent match. The complete answer is
        ; the scanner error hook, which belongs with the diagnostics slice —
        ; this test is the conservative stand-in until then, and it errs only
        ; towards reporting MORE unported, never fewer.
        if (scanner.token_flags() & (TokenFlagsIsInvalid | TokenFlagsUnterminated)) <> 0
            this.unported("scan-error", token)

        ; ... and the half that sets no flag at all, through the scanner's own
        ; error position. Today that is the merge-conflict marker (which is
        ; TRIVIA) and the bare `#` — in both cases the token stream is identical
        ; and only the tree differs.
        if scanner.first_error_at() >= 0
            this.unported("scan-error", token)

        ; Carry the scanner's own omission up. Every span after an unscannable
        ; construct is meaningless, so the tree must not be reported.
        if scanner.unported_at() >= 0
        {
            if unported_pos < 0
            {
                set unported_pos: scanner.unported_at()
                set unported_tag: "scanner"
                set unported_detail: 0
            }
        }
        token
    }

    procedure parse_optional(this, kind: int) returns bool
    {
        if token = kind
        {
            this.next_token()
            return true
        }
        false
    }

    ; The reference reports "'x' expected" and CONTINUES. This slice has no
    ; diagnostics, so a failed expectation is where the port stops.
    procedure parse_expected(this, kind: int) returns bool
    {
        if token = kind
        {
            this.next_token()
            return true
        }
        this.unported("expected", kind)
        false
    }

    procedure parse_token_node(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let k token
        this.next_token()
        this.finish_node(this.new_node(k, NodeData.Token(TokenData())), pos)
    }

    procedure parse_optional_token(this, kind: int) returns pointer[AstNode]
    {
        if token = kind
            return this.parse_token_node()
        null
    }

    ; ── kind predicates, ported from internal/ast/utilities.go ──────────────
    ;
    ; Each is a >= / <= against a CONTIGUOUS run of the Kind table, which is why
    ; that table's declaration order is load-bearing (see Kind.scaly).

    function is_keyword(k: int) returns bool
        (k >= KindFirstKeyword) and (k <= KindLastKeyword)

    ; The reference's isIdentifier(). ★ The yield/await arms were OMITTED through
    ; slice 3 with the note that neither context could be entered — and slice 4
    ; is what makes them reachable: `function*` enters the yield context and an
    ; `async function` the await context, both through the signature flags. They
    ; are not decoration, either: inside a generator `yield` stops being a name,
    ; so a parameter called `yield` parses one way in `function f(yield)` and
    ; another in `function* f(yield)`.
    function is_identifier(this) returns bool
    {
        if token = KindIdentifier
            return true
        if token = KindYieldKeyword
        {
            if this.in_yield_context()
                return false
        }
        if token = KindAwaitKeyword
        {
            if this.in_await_context()
                return false
        }
        token > KindLastReservedWord
    }

    ; The reference's own comment: `let await` / `let yield` in those contexts
    ; are allowed HERE and rejected in the binder, so this one has no context
    ; arms and is not an oversight.
    function is_binding_identifier(this) returns bool
    {
        if token = KindIdentifier
            return true
        token > KindLastReservedWord
    }

    function in_yield_context(this) returns bool
        (context_flags & NodeFlagsYieldContext) <> 0

    function in_await_context(this) returns bool
        (context_flags & NodeFlagsAwaitContext) <> 0

    ; ── speculation ─────────────────────────────────────────────────────────

    function mark(this) returns ParserState
        ParserState(scanner.mark(), context_flags, has_parse_error, statement_has_await_identifier, unported_pos, unported_tag, unported_detail)

    ; ★ The unported record is restored HERE, with everything else — the
    ; reference truncates p.diagnostics at exactly this point. See the ParserState
    ; header; the one report that must outlive a rewind goes to the separate
    ; `unanswerable` record instead, which this deliberately does not touch.
    procedure rewind(this, saved: ParserState)
    {
        scanner.rewind(saved.scanner_state)
        set token: scanner.token()
        set context_flags: saved.context_flags
        set has_parse_error: saved.has_parse_error
        set statement_has_await_identifier: saved.statement_has_await_identifier
        set unported_pos: saved.unported_pos
        set unported_tag: saved.unported_tag
        set unported_detail: saved.unported_detail
    }

    ; lookAhead(nextTokenIsBindingIdentifierOrStartOfDestructuring), inlined —
    ; see the header for why the callback does not survive the port.
    procedure is_let_declaration(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r this.is_binding_identifier()
        if r = false
        {
            if token = KindOpenBraceToken
                set r: true
        }
        if r = false
        {
            if token = KindOpenBracketToken
                set r: true
        }
        this.rewind(saved)
        r
    }

    ; ── the source file ─────────────────────────────────────────────────────

    procedure parse_source_file(this) returns pointer[AstNode]
    {
        this.next_token()

        let pos this.node_pos()
        let statements AstNode.new_node_list(host)

        while token <> KindEndOfFile
        {
            if this.is_unported()
                return null
            let s this.parse_top_level_statement()
            if s = null
                return null
            statements.add(s)
        }

        if this.is_unported()
            return null

        ; Now the whole file is in hand, which is when the reference decides
        ; whether to re-parse — see parse_top_level_statement.
        if has_possible_await_span
        {
            if file_is_external_module(statements)
                return this.unported("toplevel-await-reparse", 0)
        }

        let end_jsdoc this.jsdoc_scanner_info()
        let eof this.parse_token_node()
        if this.with_jsdoc(eof, end_jsdoc) = null
            return null

        this.finish_node(this.new_node(KindSourceFile, NodeData.SourceFile(SourceFileData(statements, eof))), pos)
    }

    ; ★★★ parseToplevelStatement, minus the half this port does not have.
    ;
    ; Upstream parses the file ONCE, notes which top-level statements used
    ; `await` as an identifier while not in an await context, and then RE-PARSES
    ; exactly those statements with AwaitContext on (reparseTopLevelAwait) —
    ; re-positioning the scanner, re-slicing the diagnostics, and replacing the
    ; statements in place. It is a second pass over the source, and it is a slice
    ; of its own.
    ;
    ; The DETECTION half is ported, because it is what decides whether the tree
    ; this port produced is the tree the reference produced: when the answer is
    ; yes, every node of that statement carries AwaitContext on the reference's
    ; side and none of them do here. So the condition is reported rather than the
    ; difference being left to surface as an unexplained failure — which is
    ; exactly how it DID surface, on two corpus cases, the moment member access
    ; started parsing and `M.await(1)` became reachable.
    procedure parse_top_level_statement(this) returns pointer[AstNode]
    {
        set statement_has_await_identifier: false
        let statement this.parse_statement()
        if statement = null
            return null
        ; The reference records a SPAN here (possibleAwaitSpans) and does nothing
        ; with it yet; whether it re-parses is decided at the end of the file.
        if statement_has_await_identifier
        {
            if (statement.flags & NodeFlagsAwaitContext) = 0
                set has_possible_await_span: true
        }
        statement
    }

    ; ★★★ The reparse runs only for an external MODULE:
    ;
    ;     !result.IsDeclarationFile && result.ExternalModuleIndicator != nil
    ;                                && len(p.possibleAwaitSpans) > 0
    ;
    ; and the indicator is `isAnExternalModuleIndicatorNode` over the top-level
    ; statements: an export modifier, an import declaration, an export
    ; assignment, an export declaration, an `import x = require(…)`, or an
    ; `import.meta` anywhere in the tree.
    ;
    ; ★ Every one of those but the FIRST is a construct this slice reports as
    ; unported, so a file that parsed to the end can only be a module by the
    ; export-modifier arm — which is why one test suffices here and is not a
    ; simplification. (`IsDeclarationFile` is the `.d.ts` name test; the pinned
    ; corpus has no such case, as the oracle's own header records.)
    ;
    ; This condition was NOT in the first version of this check, and the control
    ; that found it is worth keeping in mind: removing the detection altogether
    ; turned two corpus cases red and the fixture MATCHED — which can only mean
    ; the fixture was being reported for something the reference does not do. It
    ; had no export, so it was never a module.
    function file_is_external_module(statements: pointer[Array[pointer[AstNode]]]) returns bool
    {
        if statements = null
            return false
        let len statements.get_length() as int
        var i 0
        while i < len
        {
            if statement_has_export_modifier(*(statements.get_buffer() + i))
                return true
            set i: i + 1
        }
        false
    }

    ; ast.HasSyntacticModifier(node, ModifierFlagsExport), asked of the node's
    ; own children: a modifier is an ordinary Token node here, and the three
    ; declaration forms this slice builds all carry theirs as leading children.
    function statement_has_export_modifier(n: pointer[AstNode]) returns bool
    {
        var i 0
        while true
        {
            let c AstNode.child_at(n, i)
            if c = null
                break
            if AstNode.kind_of(c) = KindExportKeyword
                return true
            set i: i + 1
        }
        false
    }

    ; ── statements ──────────────────────────────────────────────────────────
    ;
    ; The reference's parseStatement switch, arm for arm. The arms this slice
    ; does not implement are named individually rather than caught by a default,
    ; so that adding one is a matter of removing it from the list below.

    procedure parse_statement(this) returns pointer[AstNode]
    {
        if token = KindSemicolonToken
            return this.parse_empty_statement()

        if token = KindOpenBraceToken
            return this.parse_block()

        if token = KindVarKeyword
            return this.parse_variable_statement(this.node_pos(), this.jsdoc_scanner_info(), null)

        if token = KindLetKeyword
        {
            ; In ES6 `let` starts a lexical declaration only when an identifier,
            ; `{` or `[` follows; otherwise it is an ordinary identifier and the
            ; reference falls through to the expression statement.
            if this.is_let_declaration()
                return this.parse_variable_statement(this.node_pos(), this.jsdoc_scanner_info(), null)
        }

        ; ★ `await using x = f()` and `using x = f()` are DECLARATIONS; a bare
        ; `await e;` and a bare `using;` are expression statements. Both arms
        ; fall through when the look-ahead says no, exactly as the reference's
        ; switch does — and both were on the unported list until parser slice 5,
        ; because until the ladder landed the fall-through had nowhere to go.
        if token = KindAwaitKeyword
        {
            if this.is_await_using_declaration()
                return this.parse_variable_statement(this.node_pos(), this.jsdoc_scanner_info(), null)
        }

        if token = KindUsingKeyword
        {
            if this.is_using_declaration()
                return this.parse_variable_statement(this.node_pos(), this.jsdoc_scanner_info(), null)
        }

        if token = KindFunctionKeyword
            return this.parse_function_declaration(this.node_pos(), this.jsdoc_scanner_info(), null)

        if token = KindClassKeyword
            return this.parse_class_declaration(this.node_pos(), this.jsdoc_scanner_info(), null)

        if token = KindIfKeyword
            return this.parse_if_statement()

        if token = KindReturnKeyword
            return this.parse_return_statement()

        if statement_start_is_unported(token)
            return this.unported("statement", token)

        ; The reference's last switch group: a contextual keyword that MAY start
        ; a declaration and may equally be an ordinary identifier. Only the
        ; look-ahead can tell (`type` is a variable name as often as it is a type
        ; alias), which is why this is a question and not a token test.
        if statement_start_is_declaration_keyword(token)
        {
            if this.is_start_of_declaration()
                return this.parse_declaration()
        }

        this.parse_expression_or_labeled_statement()
    }

    ; The arms of the reference's parseStatement that this slice does not have.
    ; Split in two for the reason the header gives — a forty-arm `else if` chain
    ; nests forty planner levels; a run of independent tests nests none.
    function statement_start_is_unported(k: int) returns bool
    {
        ; ... reached through parseStatement's own cases. `await` and `using`
        ; used to be here and are not any more: parse_statement routes them the
        ; way the reference does, to a variable statement or to an expression
        ; statement, and neither is unported since slice 5. `class` left the list
        ; with slice 6.
        if k = KindDoKeyword
            return true
        if k = KindWhileKeyword
            return true
        if k = KindForKeyword
            return true
        if k = KindContinueKeyword
            return true
        if k = KindBreakKeyword
            return true
        if k = KindWithKeyword
            return true
        if k = KindSwitchKeyword
            return true
        if k = KindThrowKeyword
            return true
        if k = KindTryKeyword
            return true
        if k = KindCatchKeyword
            return true
        if k = KindFinallyKeyword
            return true
        if k = KindDebuggerKeyword
            return true
        ; A decorator starts parseDeclaration in the reference; the decorator
        ; itself is unported, so the whole shape is.
        if k = KindAtToken
            return true
        false
    }

    ; ... and the keywords that route to parseDeclaration when
    ; isStartOfDeclaration says so. Being on this list is not a verdict: every
    ; one of them is a legal identifier, so the look-ahead decides.
    function statement_start_is_declaration_keyword(k: int) returns bool
    {
        if k = KindAsyncKeyword
            return true
        if k = KindInterfaceKeyword
            return true
        if k = KindTypeKeyword
            return true
        if k = KindModuleKeyword
            return true
        if k = KindNamespaceKeyword
            return true
        if k = KindDeclareKeyword
            return true
        if k = KindConstKeyword
            return true
        if k = KindEnumKeyword
            return true
        if k = KindExportKeyword
            return true
        if k = KindImportKeyword
            return true
        if k = KindPrivateKeyword
            return true
        if k = KindProtectedKeyword
            return true
        if k = KindPublicKeyword
            return true
        if k = KindAbstractKeyword
            return true
        if k = KindAccessorKeyword
            return true
        if k = KindStaticKeyword
            return true
        if k = KindReadonlyKeyword
            return true
        if k = KindGlobalKeyword
            return true
        false
    }

    ; ── the declaration router ──────────────────────────────────────────────
    ;
    ; Every declaration form goes through here, because every one of them can
    ; carry modifiers and the modifiers are parsed before anyone knows what they
    ; modify. Only the variable-statement arm is ported; the rest report
    ; themselves, so this slice buys the ROUTE rather than the destinations —
    ; which is the point, since the route is what the 49 % of corpus cases
    ; blocked on `export`, `const` and `declare` were stopped by.

    procedure parse_declaration(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers(true, false, false)
        if this.is_unported()
            return null

        ; `declare` makes the whole declaration ambient, and the flag reaches
        ; the modifier nodes too — they were finished before the context flag
        ; was set, so they are marked by hand, exactly as the reference does.
        if has_modifier(modifiers, KindDeclareKeyword)
        {
            let len modifiers.get_length() as int
            var i 0
            while i < len
            {
                let m *(modifiers.get_buffer() + i)
                set m.flags: m.flags | NodeFlagsAmbient
                set i: i + 1
            }
            let saved context_flags
            set context_flags: context_flags | NodeFlagsAmbient
            let result this.parse_declaration_worker(pos, jsdoc, modifiers)
            set context_flags: saved
            return result
        }

        this.parse_declaration_worker(pos, jsdoc, modifiers)
    }

    ; The reference keeps a ModifierList carrying a precomputed ModifierFlags
    ; bit set; here the list is a plain Array of Token nodes and the question is
    ; asked of it directly. Same answer — ModifiersToFlags is a fold over exactly
    ; these kinds — and it keeps the port from needing a second flag table whose
    ; only job is to mirror the Kind table.
    function has_modifier(modifiers: pointer[Array[pointer[AstNode]]], kind: int) returns bool
    {
        if modifiers = null
            return false
        let len modifiers.get_length() as int
        var i 0
        while i < len
        {
            let m *(modifiers.get_buffer() + i)
            if AstNode.kind_of(m) = kind
                return true
            set i: i + 1
        }
        false
    }

    procedure parse_declaration_worker(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        if token = KindVarKeyword
            return this.parse_variable_statement(pos, jsdoc, modifiers)
        if token = KindLetKeyword
            return this.parse_variable_statement(pos, jsdoc, modifiers)
        if token = KindConstKeyword
            return this.parse_variable_statement(pos, jsdoc, modifiers)
        if token = KindUsingKeyword
            return this.parse_variable_statement(pos, jsdoc, modifiers)
        if token = KindFunctionKeyword
            return this.parse_function_declaration(pos, jsdoc, modifiers)
        if token = KindTypeKeyword
            return this.parse_type_alias_declaration(pos, jsdoc, modifiers)
        if token = KindClassKeyword
            return this.parse_class_declaration(pos, jsdoc, modifiers)

        ; The reference's remaining arms. Each is a whole declaration form and a
        ; slice of its own; the tag says which one stopped the case, so the
        ; unported histogram keeps naming the next one to build.
        ;
        ; The reference's own fallthrough — modifiers with no declaration behind
        ; them — reports Declaration_expected and synthesizes a
        ; MissingDeclaration. That is a diagnostic, so it is unported too, and
        ; the same tag covers it.
        this.unported("declaration", token)
    }

    ; ── modifiers ───────────────────────────────────────────────────────────
    ;
    ; parseModifiersEx. Answers the list, or null when there is none — the
    ; reference returns a nil ModifierList in that case and ForEachChild then
    ; visits no modifier at all, which is what keeps `var x;` a one-child
    ; statement.

    procedure parse_modifiers(this, allow_decorators: bool, permit_const_as_modifier: bool, stop_on_start_of_class_static_block: bool) returns pointer[Array[pointer[AstNode]]]
    {
        let list AstNode.new_node_list(host)
        var has_static_modifier false

        while true
        {
            ; A decorator is a leading `@expr`, and its expression is the whole
            ; left-hand-side ladder. Unported.
            if allow_decorators
            {
                if token = KindAtToken
                {
                    this.unported("decorator", token)
                    return null
                }
            }

            let m this.try_parse_modifier(has_static_modifier, permit_const_as_modifier, stop_on_start_of_class_static_block)
            if m = null
                break
            if AstNode.kind_of(m) = KindStaticKeyword
                set has_static_modifier: true
            list.add(m)
        }

        if list.get_length() as int = 0
            return null
        list
    }

    procedure try_parse_modifier(this, has_seen_static_modifier: bool, permit_const_as_modifier: bool, stop_on_start_of_class_static_block: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let kind token

        if token = KindConstKeyword
        {
            if permit_const_as_modifier
            {
                ; Any following modifier must be on the same line, so that a
                ; standalone `const` declaration is not mistaken for one.
                if this.look_ahead_next_token_is_on_same_line_and_can_follow_modifier() = false
                    return null
                this.next_token()
                return this.finish_node(this.new_node(kind, NodeData.Token(TokenData())), pos)
            }
        }

        if stop_on_start_of_class_static_block
        {
            if token = KindStaticKeyword
            {
                if this.look_ahead_next_token_is_open_brace()
                    return null
            }
        }

        if has_seen_static_modifier
        {
            if token = KindStaticKeyword
                return null
        }

        if this.parse_any_contextual_modifier() = false
            return null

        this.finish_node(this.new_node(kind, NodeData.Token(TokenData())), pos)
    }

    procedure parse_any_contextual_modifier(this) returns bool
    {
        let saved this.mark()
        if is_modifier_kind(token)
        {
            if this.next_token_can_follow_modifier()
                return true
        }
        this.rewind(saved)
        false
    }

    procedure next_token_can_follow_modifier(this) returns bool
    {
        ; `const` is a modifier only in `const enum`.
        if token = KindConstKeyword
            return this.next_token() = KindEnumKeyword

        if token = KindExportKeyword
        {
            this.next_token()
            if token = KindDefaultKeyword
                return this.look_ahead_next_token_can_follow_default_keyword()
            if token = KindTypeKeyword
                return this.look_ahead_next_token_can_follow_export_modifier()
            return this.can_follow_export_modifier()
        }

        if token = KindDefaultKeyword
            return this.next_token_can_follow_default_keyword()

        if token = KindStaticKeyword
        {
            this.next_token()
            return this.can_follow_modifier()
        }

        if token = KindGetKeyword
        {
            this.next_token()
            return this.can_follow_get_or_set_keyword()
        }
        if token = KindSetKeyword
        {
            this.next_token()
            return this.can_follow_get_or_set_keyword()
        }

        this.next_token_is_on_same_line_and_can_follow_modifier()
    }

    procedure next_token_can_follow_default_keyword(this) returns bool
    {
        this.next_token()
        if token = KindClassKeyword
            return true
        if token = KindFunctionKeyword
            return true
        if token = KindInterfaceKeyword
            return true
        if token = KindAtToken
            return true
        if token = KindAbstractKeyword
            return this.look_ahead_next_token_is_class_keyword_on_same_line()
        if token = KindAsyncKeyword
            return this.look_ahead_next_token_is_function_keyword_on_same_line()
        false
    }

    procedure next_token_can_follow_export_modifier(this) returns bool
    {
        this.next_token()
        this.can_follow_export_modifier()
    }

    function can_follow_export_modifier(this) returns bool
    {
        if token = KindAtToken
            return true
        if token = KindAsteriskToken
            return false
        if token = KindAsKeyword
            return false
        if token = KindOpenBraceToken
            return false
        this.can_follow_modifier()
    }

    function can_follow_modifier(this) returns bool
    {
        if token = KindOpenBracketToken
            return true
        if token = KindOpenBraceToken
            return true
        if token = KindAsteriskToken
            return true
        if token = KindDotDotDotToken
            return true
        this.is_literal_property_name()
    }

    function can_follow_get_or_set_keyword(this) returns bool
    {
        if token = KindOpenBracketToken
            return true
        this.is_literal_property_name()
    }

    procedure next_token_is_on_same_line_and_can_follow_modifier(this) returns bool
    {
        this.next_token()
        if this.has_preceding_line_break()
            return false
        this.can_follow_modifier()
    }

    function is_literal_property_name(this) returns bool
    {
        if token_is_identifier_or_keyword(token)
            return true
        if token = KindStringLiteral
            return true
        if token = KindNumericLiteral
            return true
        token = KindBigIntLiteral
    }

    ; Ported from internal/parser/utilities.go: identifiers and every keyword sit
    ; ABOVE KindIdentifier in one contiguous run, so the test is a single >=.
    function token_is_identifier_or_keyword(k: int) returns bool
        k >= KindIdentifier

    ; ast.IsModifierKind.
    function is_modifier_kind(k: int) returns bool
    {
        if k = KindAbstractKeyword
            return true
        if k = KindAccessorKeyword
            return true
        if k = KindAsyncKeyword
            return true
        if k = KindConstKeyword
            return true
        if k = KindDeclareKeyword
            return true
        if k = KindDefaultKeyword
            return true
        if k = KindExportKeyword
            return true
        if k = KindInKeyword
            return true
        if k = KindPrivateKeyword
            return true
        if k = KindProtectedKeyword
            return true
        if k = KindPublicKeyword
            return true
        if k = KindReadonlyKeyword
            return true
        if k = KindOutKeyword
            return true
        if k = KindOverrideKeyword
            return true
        k = KindStaticKeyword
    }

    ; ── isStartOfDeclaration ────────────────────────────────────────────────
    ;
    ; The one question that decides whether a contextual keyword starts a
    ; declaration or is just a name. It is a look-ahead LOOP: `export declare
    ; const` walks three tokens before it can answer.

    procedure is_start_of_declaration(this) returns bool
    {
        let saved this.mark()
        let r this.scan_start_of_declaration()
        this.rewind(saved)
        r
    }

    procedure scan_start_of_declaration(this) returns bool
    {
        while true
        {
            if token = KindVarKeyword
                return true
            if token = KindLetKeyword
                return true
            if token = KindConstKeyword
                return true
            if token = KindFunctionKeyword
                return true
            if token = KindClassKeyword
                return true
            if token = KindEnumKeyword
                return true

            if token = KindUsingKeyword
                return this.is_using_declaration()
            if token = KindAwaitKeyword
                return this.is_await_using_declaration()

            ; `declare`, `module`, `namespace`, `interface` and `type` are all
            ; legal identifiers — but an identifier cannot be followed by another
            ; identifier on the SAME LINE, and that is what tells the two apart.
            if token = KindInterfaceKeyword
                return this.next_token_is_identifier_on_same_line()
            if token = KindTypeKeyword
                return this.next_token_is_identifier_on_same_line()
            if token = KindDeferKeyword
                return this.next_token_is_identifier_on_same_line()

            if token = KindModuleKeyword
                return this.next_token_is_identifier_or_string_literal_on_same_line()
            if token = KindNamespaceKeyword
                return this.next_token_is_identifier_or_string_literal_on_same_line()

            if token = KindGlobalKeyword
            {
                this.next_token()
                if token = KindOpenBraceToken
                    return true
                if token = KindIdentifier
                    return true
                return token = KindExportKeyword
            }

            if token = KindImportKeyword
            {
                this.next_token()
                if token = KindDeferKeyword
                    return true
                if token = KindStringLiteral
                    return true
                if token = KindAsteriskToken
                    return true
                if token = KindOpenBraceToken
                    return true
                return token_is_identifier_or_keyword(token)
            }

            if token = KindExportKeyword
            {
                this.next_token()
                if token = KindEqualsToken
                    return true
                if token = KindAsteriskToken
                    return true
                if token = KindOpenBraceToken
                    return true
                if token = KindDefaultKeyword
                    return true
                if token = KindAsKeyword
                    return true
                if token = KindAtToken
                    return true
                if token = KindTypeKeyword
                {
                    this.next_token()
                    if token = KindAsteriskToken
                        return true
                    if token = KindOpenBraceToken
                        return true
                    if this.is_identifier()
                        return this.has_preceding_line_break() = false
                    return false
                }
                continue
            }

            if token = KindStaticKeyword
            {
                this.next_token()
                continue
            }

            ; The modifier keywords, which loop: ASI applies to each of them, and
            ; `declare type` commits to a type alias regardless.
            if this.token_is_loopable_modifier()
            {
                let previous token
                this.next_token()
                if this.has_preceding_line_break()
                    return false
                if previous = KindDeclareKeyword
                {
                    if token = KindTypeKeyword
                        return true
                }
                continue
            }

            return false
        }
        false
    }

    function token_is_loopable_modifier(this) returns bool
    {
        if token = KindAbstractKeyword
            return true
        if token = KindAccessorKeyword
            return true
        if token = KindAsyncKeyword
            return true
        if token = KindDeclareKeyword
            return true
        if token = KindPrivateKeyword
            return true
        if token = KindProtectedKeyword
            return true
        if token = KindPublicKeyword
            return true
        token = KindReadonlyKeyword
    }

    procedure next_token_is_identifier_on_same_line(this) returns bool
    {
        this.next_token()
        if this.is_identifier() = false
            return false
        this.has_preceding_line_break() = false
    }

    procedure next_token_is_identifier_or_string_literal_on_same_line(this) returns bool
    {
        this.next_token()
        var ok this.is_identifier()
        if ok = false
        {
            if token = KindStringLiteral
                set ok: true
        }
        if ok = false
            return false
        this.has_preceding_line_break() = false
    }

    procedure is_using_declaration(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_binding_identifier_or_start_of_destructuring_on_same_line(false)
        this.rewind(saved)
        r
    }

    procedure is_await_using_declaration(this) returns bool
    {
        let saved this.mark()
        var r false
        if this.next_token() = KindUsingKeyword
            set r: this.next_token_is_binding_identifier_or_start_of_destructuring_on_same_line(false)
        this.rewind(saved)
        r
    }

    procedure next_token_is_binding_identifier_or_start_of_destructuring_on_same_line(this, disallow_of: bool) returns bool
    {
        this.next_token()
        if disallow_of
        {
            if token = KindOfKeyword
                return this.look_ahead_next_token_is_equals_or_semicolon_or_colon_token()
        }
        var ok this.is_binding_identifier()
        if ok = false
        {
            if token = KindOpenBraceToken
                set ok: true
        }
        if ok = false
            return false
        this.has_preceding_line_break() = false
    }

    ; ── the look-ahead wrappers ─────────────────────────────────────────────
    ;
    ; One per call site, each marking and rewinding around a single question.
    ; See CLAUDE.md §3.9e for why the reference's `lookAhead(callback)` does not
    ; survive as a callback.

    procedure look_ahead_next_token_is_open_brace(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() = KindOpenBraceToken
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_class_keyword_on_same_line(this) returns bool
    {
        let saved this.mark()
        var r this.next_token() = KindClassKeyword
        if r
            set r: this.has_preceding_line_break() = false
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_function_keyword_on_same_line(this) returns bool
    {
        let saved this.mark()
        var r this.next_token() = KindFunctionKeyword
        if r
            set r: this.has_preceding_line_break() = false
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_can_follow_default_keyword(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_can_follow_default_keyword()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_can_follow_export_modifier(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_can_follow_export_modifier()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_on_same_line_and_can_follow_modifier(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_on_same_line_and_can_follow_modifier()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_equals_or_semicolon_or_colon_token(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r token = KindEqualsToken
        if r = false
        {
            if token = KindSemicolonToken
                set r: true
        }
        if r = false
        {
            if token = KindColonToken
                set r: true
        }
        this.rewind(saved)
        r
    }

    procedure parse_empty_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        if this.parse_expected(KindSemicolonToken) = false
            return null
        let result this.finish_node(this.new_node(KindEmptyStatement, NodeData.EmptyStatement(EmptyStatementData())), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_block(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        if this.parse_expected(KindOpenBraceToken) = false
            return null

        let statements AstNode.new_node_list(host)
        while true
        {
            if token = KindCloseBraceToken
                break
            if token = KindEndOfFile
                break
            if this.is_unported()
                return null
            let s this.parse_statement()
            if s = null
                return null
            statements.add(s)
        }

        if this.parse_expected(KindCloseBraceToken) = false
            return null

        let result this.finish_node(this.new_node(KindBlock, NodeData.Block(BlockData(statements))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ── the two statements a function BODY needs ────────────────────────────
    ;
    ; They land with slice 4 rather than with the statement spine because that is
    ; when they became reachable: before a function declaration parsed, no
    ; `return` in the corpus was ever looked at, and the unported histogram said
    ; so — `return` and `if` were absent from it entirely and went straight to
    ; third and fourth place the moment function bodies started parsing.
    ;
    ; ★ The reference's parseExpectedMatchingBrackets(`(`, `)`, …) is a
    ; parse_expected here: its whole extra job is to attach a "the parser
    ; expected to find a `)` to match the `(` here" note to a diagnostic, and on
    ; the path where the bracket IS there the two are the same call.

    procedure parse_if_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        if this.parse_expected(KindIfKeyword) = false
            return null
        if this.parse_expected(KindOpenParenToken) = false
            return null
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        if this.parse_expected(KindCloseParenToken) = false
            return null

        let then_statement this.parse_statement()
        if then_statement = null
            return null

        var else_statement null as pointer[AstNode]
        if this.parse_optional(KindElseKeyword)
        {
            set else_statement: this.parse_statement()
            if else_statement = null
                return null
        }

        let result this.finish_node(this.new_node(KindIfStatement, NodeData.IfStatement(IfStatementData(expression, then_statement, else_statement))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_return_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        if this.parse_expected(KindReturnKeyword) = false
            return null

        ; A bare `return;` — or a `return` that ASI ends — carries no expression.
        var expression null as pointer[AstNode]
        if this.can_parse_semicolon() = false
        {
            set expression: this.parse_expression_allow_in()
            if expression = null
                return null
        }

        if this.parse_semicolon() = false
            return null

        let result this.finish_node(this.new_node(KindReturnStatement, NodeData.ReturnStatement(ReturnStatementData(expression))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_variable_statement(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let list this.parse_variable_declaration_list()
        if list = null
            return null
        if this.parse_semicolon() = false
            return null
        let result this.finish_node(this.new_node(KindVariableStatement, NodeData.VariableStatement(VariableStatementData(modifiers, list))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_variable_declaration_list(this) returns pointer[AstNode]
    {
        let pos this.node_pos()

        var flags NodeFlagsNone
        if token = KindLetKeyword
            set flags: NodeFlagsLet
        if token = KindConstKeyword
            set flags: NodeFlagsConst
        if token = KindUsingKeyword
            set flags: NodeFlagsUsing

        ; `await using` consumes TWO keywords and carries both bits. The
        ; reference's arm can also fall out of the switch without setting a flag
        ; — that is its `break`, reached when the look-ahead says this is not a
        ; declaration after all — but parse_statement is the only caller here and
        ; it has already asked the same question, so that path cannot be entered.
        if token = KindAwaitKeyword
        {
            set flags: NodeFlagsAwaitUsing
            this.next_token()
        }

        this.next_token()

        ; The reference's `for (let of X)` look-ahead produces an EMPTY
        ; declaration list; the for statement is unported, so the shape cannot
        ; be reached from here.
        let declarations AstNode.new_node_list(host)
        while true
        {
            if this.is_unported()
                return null
            let d this.parse_variable_declaration()
            if d = null
                return null
            declarations.add(d)
            if token <> KindCommaToken
                break
            this.next_token()
        }

        let n this.new_node(KindVariableDeclarationList, NodeData.VariableDeclarationList(VariableDeclarationListData(declarations)))
        set n.flags: n.flags | flags
        this.finish_node(n, pos)
    }

    procedure parse_variable_declaration(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()

        ; parseIdentifierOrPattern: `[` and `{` start a binding pattern, which is
        ; unported.
        if token = KindOpenBracketToken
            return this.unported("binding-pattern", token)
        if token = KindOpenBraceToken
            return this.unported("binding-pattern", token)

        let name this.parse_binding_identifier()
        if name = null
            return null

        ; The declaration list is always parsed with allowExclamation here — the
        ; only caller that passes false is the for-statement initializer, which
        ; is unported.
        var exclamation_token null as pointer[AstNode]
        if token = KindExclamationToken
        {
            if this.has_preceding_line_break() = false
            {
                set exclamation_token: this.parse_token_node()
                if exclamation_token = null
                    return null
            }
        }

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }

        var initializer null as pointer[AstNode]
        if token <> KindInKeyword
        {
            if token <> KindOfKeyword
            {
                if this.parse_optional(KindEqualsToken)
                {
                    set initializer: this.parse_assignment_expression_or_higher()
                    if initializer = null
                        return null
                }
            }
        }

        let result this.finish_node(this.new_node(KindVariableDeclaration, NodeData.VariableDeclaration(VariableDeclarationData(name, exclamation_token, type_node, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ── identifiers ─────────────────────────────────────────────────────────
    ;
    ; The reference's createIdentifierWithDiagnostic and its three callers. They
    ; differ ONLY in the question they ask before building the node, which is
    ; why they are one function plus three one-liners here as well:
    ;
    ;   parseIdentifier      isIdentifier()               — a real identifier
    ;   parseIdentifierName  tokenIsIdentifierOrKeyword() — a NAME, keywords included
    ;   parseBindingIdentifier isBindingIdentifier()
    ;
    ; Every `false` answer leads into the reference's diagnostic arms (a
    ; reserved word, a private identifier, "Identifier expected"), each of which
    ; also synthesizes a MISSING identifier — a node with an empty name and a
    ; zero-width range. So a false answer is where the port stops.

    procedure create_identifier(this, ok: bool) returns pointer[AstNode]
    {
        if ok = false
            return this.unported("identifier-expected", token)
        let pos this.node_pos()

        ; The reference's newIdentifier sets statementHasAwaitIdentifier when the
        ; identifier's TEXT is "await". Our scanner keeps no tokenValue, and it
        ; does not need to: the two are the same question, because an escaped
        ; `await` still scans as KindAwaitKeyword (with the escape flag) and
        ; next_token already reports THAT as unported.
        if token = KindAwaitKeyword
            set statement_has_await_identifier: true

        ; The reference takes scanner.TokenValue() here and interns it. Our
        ; scanner keeps no tokenValue yet, and no node in this slice reads one.
        this.next_token_without_check()
        this.finish_node(this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData())), pos)
    }

    ; `#name`. A leaf, like Identifier — the reference interns its text and
    ; nothing else. It arrives with the class slice because a private name only
    ; exists inside a class body; every other position that accepts one accepts
    ; it in order to REFUSE it.
    procedure parse_private_identifier(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        this.finish_node(this.new_node(KindPrivateIdentifier, NodeData.PrivateIdentifier(IdentifierData())), pos)
    }

    procedure parse_identifier(this) returns pointer[AstNode]
        this.create_identifier(this.is_identifier())

    procedure parse_identifier_name(this) returns pointer[AstNode]
        this.create_identifier(token_is_identifier_or_keyword(token))

    ; ★ A BINDING named `await` does not count towards the top-level-await
    ; reparse — `let await = 1` declares a variable, it does not use one — so the
    ; flag is saved and restored around it. Three more sites do the same
    ; (parse_property_name, parse_function_block, parse_right_side_of_dot's
    ; identifier-only branch); every other one belongs to a declaration form this
    ; slice reports as unported anyway.
    procedure parse_binding_identifier(this) returns pointer[AstNode]
    {
        ; Its own tag rather than create_identifier's: the histogram is the
        ; planning instrument, and "a binding position wanted a name" and "a
        ; type position wanted a name" are different work.
        if this.is_binding_identifier() = false
            return this.unported("binding-identifier", token)
        let saved_await_identifier statement_has_await_identifier
        let id this.create_identifier(true)
        set statement_has_await_identifier: saved_await_identifier
        id
    }

    ; The reference's canParseSemicolon/tryParseSemicolon/parseSemicolon —
    ; automatic semicolon insertion. parseSemicolon's fallback reports a
    ; diagnostic, so it is the unported edge here.
    ;
    ; The two halves are split apart since slice 4, because a caller needs the
    ; QUESTION on its own: a body-less overload signature is exactly
    ; "a function head that can_parse_semicolon()".
    function can_parse_semicolon(this) returns bool
    {
        if token = KindSemicolonToken
            return true
        if token = KindCloseBraceToken
            return true
        if token = KindEndOfFile
            return true
        this.has_preceding_line_break()
    }

    ; tryParseSemicolon. Split out of parse_semicolon with slice 6, because the
    ; property declaration needs the try WITHOUT the report: reaching the end of
    ; a property with no semicolon is one of four diagnostics there, and which
    ; one depends on what preceded it.
    procedure try_parse_semicolon(this) returns bool
    {
        if this.can_parse_semicolon() = false
            return false
        ; Consume it only if it was written; ASI inserts nothing.
        if token = KindSemicolonToken
            this.next_token()
        true
    }

    procedure parse_semicolon(this) returns bool
    {
        if this.try_parse_semicolon()
            return true
        this.unported("semicolon", token)
        false
    }

    procedure parse_expression_or_labeled_statement(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var jsdoc this.jsdoc_scanner_info()

        ; ★ The reference clears HasJSDoc again when the expression started with
        ; `(`, and the question has to be asked BEFORE the expression is parsed —
        ; by then the token is long gone. Slice 4's note here said the arm could
        ; not run because a parenthesized expression was unported; slice 5 makes
        ; it reachable, and it is one of the few places where a flag depends on
        ; how the expression STARTED rather than on what it turned out to be.
        let has_paren token = KindOpenParenToken

        let expression this.parse_expression()
        if expression = null
            return null

        ; A labeled statement is `Identifier :` — unported, since its body is a
        ; statement and the label node is not in this slice.
        if AstNode.kind_of(expression) = KindIdentifier
        {
            if token = KindColonToken
                return this.unported("labeled-statement", token)
        }

        if this.parse_semicolon() = false
            return null

        let result this.finish_node(this.new_node(KindExpressionStatement, NodeData.ExpressionStatement(ExpressionStatementData(expression))), pos)
        if has_paren
            set jsdoc: jsdoc & ~JsdocInfoHasJsdoc
        this.with_jsdoc(result, jsdoc)
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; EXPRESSIONS — parser slice 5
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; The reference's ladder, top to bottom:
    ;
    ;   parseExpression                     the comma operator
    ;   parseAssignmentExpressionOrHigher   yield, arrow functions, assignment
    ;   parseConditionalExpressionRest      ? :
    ;   parseBinaryExpressionOrHigher       precedence climbing, `as`/`satisfies`
    ;   parseUnaryExpressionOrHigher        + - ~ ! delete typeof void await <T>
    ;   parseUpdateExpression               ++ -- , prefix and postfix
    ;   parseLeftHandSideExpressionOrHigher calls, super, import
    ;   parseMemberExpressionOrHigher       . [] ! ?. <T>
    ;   parsePrimaryExpression              the leaves and the bracketed forms
    ;
    ; The slice was read off the unported histogram, where the two expression
    ; tags together were 40.1 % of first blockers against 17.8 % for the next
    ; one — and unlike slices 2, 3 and 4 there is no cheaper sub-slice inside
    ; it: `.`, `(`, `[`, `{` and `as` all end in parseMemberExpressionOrHigher
    ; or parseBinaryExpressionOrHigher, so the ladder is indivisible in a way
    ; the declaration router and the type surface were not.
    ;
    ; ── What is NOT ported, each because it is the head of another slice ────
    ;
    ;   template expressions and tagged  they need ReScanTemplateToken
    ;     templates
    ;   regular expression literals      they need ReScanSlashToken
    ;   class expressions                the class slice
    ;   decorators / `@expr`             the decorator slice (also a modifier)
    ;   private identifiers `#x`         they need a node and an intern table
    ;   `import(…)` and `import.meta`    both set SOURCE FILE flags
    ;                                    (PossiblyContainsDynamicImport /
    ;                                    …ImportMeta), which this port does not
    ;                                    model — so parsing them would produce a
    ;                                    SourceFile whose flags disagree, which
    ;                                    the yardstick compares
    ;   object literal methods and       they are parseMethodDeclaration and
    ;     accessors                      parseAccessorDeclaration, i.e. the class
    ;                                    member slice under another name
    ;   binding patterns `[a]` `{a}`     unchanged from slice 4, and now reached
    ;                                    from one more direction: `({x}) => …`
    ;
    ; ── Three faithfulness notes ────────────────────────────────────────────
    ;
    ; (1) More reference nodes carry a field the dump cannot see: the OPERATOR of
    ;     a PrefixUnaryExpression and a PostfixUnaryExpression, the keyword of a
    ;     MetaProperty, the `MultiLine` flag of an array or object literal. They
    ;     are not stored, and that is a gap rather than a saving — see ast.scaly.
    ;
    ; (2) `checkJSSyntax`, which the reference calls on most of these nodes,
    ;     returns immediately unless the node is in a JavaScript file. This port
    ;     never sets NodeFlagsJavaScriptFile, so it is work that provably does
    ;     nothing here rather than work that was skipped.
    ;
    ; (3) `typeHasArrowFunctionBlockingParseError`, which the reference consults
    ;     before committing to a speculative arrow function, asks whether the
    ;     return type contains a MISSING node. A missing node is only ever
    ;     produced after a diagnostic, and a diagnostic is already unported here,
    ;     so the predicate is constantly false and is left out.

    procedure parse_expression(this) returns pointer[AstNode]
    {
        ; The decorator context is cleared for the whole expression: a decorator
        ; is unambiguous while it is being parsed, and its own `[` must not be
        ; read as an element access (see parse_member_expression_rest).
        let saved context_flags
        this.set_context_flags(NodeFlagsDecoratorContext, false)

        let pos this.node_pos()
        var expr this.parse_assignment_expression_or_higher()
        if expr = null
            return null

        while true
        {
            let operator_token this.parse_optional_token(KindCommaToken)
            if this.is_unported()
                return null
            if operator_token = null
                break
            let right this.parse_assignment_expression_or_higher()
            if right = null
                return null
            set expr: this.make_binary_expression(expr, operator_token, right, pos)
            if expr = null
                return null
        }

        set context_flags: saved
        expr
    }

    ; doInContext(DisallowIn, false, parseExpression) — the shape every
    ; parenthesized head and every `return` operand is parsed in, where a bare
    ; `in` is an ordinary relational operator again.
    procedure parse_expression_allow_in(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let result this.parse_expression()
        set context_flags: saved
        result
    }

    ; The same wrapper around ONE assignment expression: an object literal's
    ; initializer and a shorthand property's are parsed this way.
    procedure parse_assignment_expression_allow_in(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let result this.parse_assignment_expression_or_higher()
        set context_flags: saved
        result
    }

    procedure parse_assignment_expression_or_higher(this) returns pointer[AstNode]
        this.parse_assignment_expression_or_higher_worker(true)

    ; ★ `allow_return_type_in_arrow_function` threads through the whole ladder
    ; and looks like a flag that could be dropped. It cannot: it is what tells
    ; `x ? (a): b => c : d` apart from an arrow function with a return type, and
    ; the only place it is FALSE is the true-branch of a conditional expression.
    procedure parse_assignment_expression_or_higher_worker(this, allow_return_type: bool) returns pointer[AstNode]
    {
        if this.is_yield_expression()
            return this.parse_yield_expression()
        if this.is_unported()
            return null

        ; Productions 4 and 5 — an arrow function. It is neither a
        ; LeftHandSideExpression nor the start of a ConditionalExpression, so a
        ; successful parse ends the question here.
        let arrow this.try_parse_parenthesized_arrow_function_expression(allow_return_type)
        if this.is_unported()
            return null
        if arrow <> null
            return arrow

        let async_arrow this.try_parse_async_simple_arrow_function_expression(allow_return_type)
        if this.is_unported()
            return null
        if async_arrow <> null
            return async_arrow

        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let expr this.parse_binary_expression_or_higher(OperatorPrecedenceLowest)
        if expr = null
            return null

        ; `x => …`. The single un-parenthesized parameter is not looked ahead
        ; for; it is recognised AFTERWARDS, from an expression that turned out to
        ; be one identifier followed by an arrow.
        if AstNode.kind_of(expr) = KindIdentifier
        {
            if token = KindEqualsGreaterThanToken
                return this.parse_simple_arrow_function_expression(pos, expr, allow_return_type, jsdoc, null)
        }

        ; Productions 2 and 3 — assignment. The re-scan is what merges `>` `>`
        ; `=` into `>>=`; without it every shift-assignment would read as a
        ; comparison.
        var is_assignment false
        if is_left_hand_side_expression_kind(AstNode.kind_of(expr))
        {
            if is_assignment_operator(this.re_scan_greater_than_token())
                set is_assignment: true
        }
        if is_assignment
        {
            let operator_token this.parse_token_node()
            if operator_token = null
                return null
            let right this.parse_assignment_expression_or_higher_worker(allow_return_type)
            if right = null
                return null
            return this.make_binary_expression(expr, operator_token, right, pos)
        }

        this.parse_conditional_expression_rest(expr, pos, allow_return_type)
    }

    procedure make_binary_expression(this, left: pointer[AstNode], operator_token: pointer[AstNode], right: pointer[AstNode], pos: int) returns pointer[AstNode]
        this.finish_node(this.new_node(KindBinaryExpression, NodeData.BinaryExpression(BinaryExpressionData(left, operator_token, right))), pos)

    ; ── yield ───────────────────────────────────────────────────────────────

    procedure is_yield_expression(this) returns bool
    {
        if token <> KindYieldKeyword
            return false
        if this.in_yield_context()
            return true
        ; Outside a generator `yield` is an ordinary identifier — `yield(foo)` is
        ; a call. The reference's heuristic is that a name or a literal directly
        ; after it cannot be anything but a yield operand.
        this.look_ahead_next_token_is_identifier_or_keyword_or_literal_on_same_line()
    }

    procedure parse_yield_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()

        var takes_operand false
        if this.has_preceding_line_break() = false
        {
            if token = KindAsteriskToken
                set takes_operand: true
            if this.is_start_of_expression()
                set takes_operand: true
        }

        var asterisk_token null as pointer[AstNode]
        var expression null as pointer[AstNode]
        if takes_operand
        {
            set asterisk_token: this.parse_optional_token(KindAsteriskToken)
            if this.is_unported()
                return null
            set expression: this.parse_assignment_expression_or_higher()
            if expression = null
                return null
        }

        this.finish_node(this.new_node(KindYieldExpression, NodeData.YieldExpression(YieldExpressionData(asterisk_token, expression))), pos)
    }

    ; ── the conditional operator ────────────────────────────────────────────

    procedure parse_conditional_expression_rest(this, left_operand: pointer[AstNode], pos: int, allow_return_type: bool) returns pointer[AstNode]
    {
        let question_token this.parse_optional_token(KindQuestionToken)
        if this.is_unported()
            return null
        if question_token = null
            return left_operand

        ; `in` is allowed in the true branch and NOT re-allowed in the false one
        ; — the reference is explicit that this asymmetry is deliberate.
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let true_expression this.parse_assignment_expression_or_higher_worker(false)
        set context_flags: saved
        if true_expression = null
            return null

        ; The reference continues with a MISSING identifier when the `:` is not
        ; there; that is a diagnostic, so parse_expected_token stops instead.
        let colon_token this.parse_expected_token(KindColonToken)
        if colon_token = null
            return null

        let false_expression this.parse_assignment_expression_or_higher_worker(allow_return_type)
        if false_expression = null
            return null

        this.finish_node(this.new_node(KindConditionalExpression, NodeData.ConditionalExpression(ConditionalExpressionData(left_operand, question_token, true_expression, colon_token, false_expression))), pos)
    }

    ; ── binary operators ────────────────────────────────────────────────────

    procedure parse_binary_expression_or_higher(this, precedence: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let left_operand this.parse_unary_expression_or_higher()
        if left_operand = null
            return null
        this.parse_binary_expression_rest(precedence, left_operand, pos)
    }

    ; Precedence climbing, transcribed with the reference's own two rules: a
    ; left-associative operator is taken when its precedence is strictly HIGHER
    ; than the caller's, and `**` — the only right-associative one — when it is
    ; higher OR EQUAL.
    procedure parse_binary_expression_rest(this, precedence: int, start_operand: pointer[AstNode], pos: int) returns pointer[AstNode]
    {
        var left_operand start_operand
        var last_operand start_operand

        while true
        {
            let op this.re_scan_greater_than_token()
            let new_precedence get_binary_operator_precedence(op)

            var consume false
            if op = KindAsteriskAsteriskToken
                set consume: new_precedence >= precedence
            else
                set consume: new_precedence > precedence
            if consume = false
                break

            ; `for (a in b)` — inside the initializer, `in` is not an operator.
            if op = KindInKeyword
            {
                if this.in_disallow_in_context()
                    break
            }

            var is_type_operator false
            if op = KindAsKeyword
                set is_type_operator: true
            if op = KindSatisfiesKeyword
                set is_type_operator: true

            if is_type_operator
            {
                ; ASI: `var x = foo` / `as (Bar)` on the next line is an
                ; initialized variable followed by a CALL to something named
                ; `as`, not a type assertion.
                if this.has_preceding_line_break()
                    break
                this.next_token()

                ; `a ## b as T` may not swallow an operator binding tighter than
                ; `##`, because that would make the `as` impossible to erase
                ; without changing the meaning.
                var last_precedence OperatorPrecedenceHighest
                if AstNode.kind_of(last_operand) = KindBinaryExpression
                    set last_precedence: get_binary_operator_precedence(AstNode.binary_operator_kind(last_operand))

                let type_node this.parse_type()
                if type_node = null
                    return null

                var kind KindAsExpression
                if op = KindSatisfiesKeyword
                    set kind: KindSatisfiesExpression
                var n null as pointer[AstNode]
                if op = KindSatisfiesKeyword
                    set n: this.new_node(kind, NodeData.SatisfiesExpression(AsExpressionData(left_operand, type_node)))
                else
                    set n: this.new_node(kind, NodeData.AsExpression(AsExpressionData(left_operand, type_node)))
                set left_operand: this.finish_node(n, AstNode.pos_of(left_operand))
                if left_operand = null
                    return null

                if get_binary_operator_precedence(this.re_scan_greater_than_token()) > last_precedence
                    break
            }
            else
            {
                let operator_token this.parse_token_node()
                if operator_token = null
                    return null
                let right this.parse_binary_expression_or_higher(new_precedence)
                if right = null
                    return null
                set left_operand: this.make_binary_expression(left_operand, operator_token, right, pos)
                if left_operand = null
                    return null
                set last_operand: left_operand
            }
        }

        left_operand
    }

    ; ast.GetBinaryOperatorPrecedence. Every arm is the reference's; the answer
    ; for anything else is Invalid, which is what stops the climb.
    function get_binary_operator_precedence(k: int) returns int
    {
        if k = KindQuestionQuestionToken
            return OperatorPrecedenceCoalesce
        if k = KindBarBarToken
            return OperatorPrecedenceLogicalOR
        if k = KindAmpersandAmpersandToken
            return OperatorPrecedenceLogicalAND
        if k = KindBarToken
            return OperatorPrecedenceBitwiseOR
        if k = KindCaretToken
            return OperatorPrecedenceBitwiseXOR
        if k = KindAmpersandToken
            return OperatorPrecedenceBitwiseAND
        if k = KindEqualsEqualsToken
            return OperatorPrecedenceEquality
        if k = KindExclamationEqualsToken
            return OperatorPrecedenceEquality
        if k = KindEqualsEqualsEqualsToken
            return OperatorPrecedenceEquality
        if k = KindExclamationEqualsEqualsToken
            return OperatorPrecedenceEquality
        if k = KindLessThanToken
            return OperatorPrecedenceRelational
        if k = KindGreaterThanToken
            return OperatorPrecedenceRelational
        if k = KindLessThanEqualsToken
            return OperatorPrecedenceRelational
        if k = KindGreaterThanEqualsToken
            return OperatorPrecedenceRelational
        if k = KindInstanceOfKeyword
            return OperatorPrecedenceRelational
        if k = KindInKeyword
            return OperatorPrecedenceRelational
        if k = KindAsKeyword
            return OperatorPrecedenceRelational
        if k = KindSatisfiesKeyword
            return OperatorPrecedenceRelational
        if k = KindLessThanLessThanToken
            return OperatorPrecedenceShift
        if k = KindGreaterThanGreaterThanToken
            return OperatorPrecedenceShift
        if k = KindGreaterThanGreaterThanGreaterThanToken
            return OperatorPrecedenceShift
        if k = KindPlusToken
            return OperatorPrecedenceAdditive
        if k = KindMinusToken
            return OperatorPrecedenceAdditive
        if k = KindAsteriskToken
            return OperatorPrecedenceMultiplicative
        if k = KindSlashToken
            return OperatorPrecedenceMultiplicative
        if k = KindPercentToken
            return OperatorPrecedenceMultiplicative
        if k = KindAsteriskAsteriskToken
            return OperatorPrecedenceExponentiation
        OperatorPrecedenceInvalid
    }

    ; ast.IsAssignmentOperator. The sixteen assignment operators are one
    ; CONTIGUOUS run of the Kind table (63..78), which is why this is a range
    ; test and the reference's enumeration is not transcribed — the same
    ; property the keyword and binary-operator tests rest on.
    function is_assignment_operator(k: int) returns bool
        (k >= KindFirstAssignment) and (k <= KindLastAssignment)

    ; ast.isLeftHandSideExpressionKind. The JSX kinds are in the reference's
    ; list and are left out here for the same reason the JSX parser is: neither
    ; side selects that language variant.
    function is_left_hand_side_expression_kind(k: int) returns bool
    {
        if k = KindPropertyAccessExpression
            return true
        if k = KindElementAccessExpression
            return true
        if k = KindNewExpression
            return true
        if k = KindCallExpression
            return true
        if k = KindTaggedTemplateExpression
            return true
        if k = KindArrayLiteralExpression
            return true
        if k = KindParenthesizedExpression
            return true
        if k = KindObjectLiteralExpression
            return true
        if k = KindClassExpression
            return true
        if k = KindFunctionExpression
            return true
        if k = KindIdentifier
            return true
        if k = KindPrivateIdentifier
            return true
        if k = KindRegularExpressionLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindStringLiteral
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindTemplateExpression
            return true
        if k = KindFalseKeyword
            return true
        if k = KindNullKeyword
            return true
        if k = KindThisKeyword
            return true
        if k = KindTrueKeyword
            return true
        if k = KindSuperKeyword
            return true
        if k = KindNonNullExpression
            return true
        if k = KindExpressionWithTypeArguments
            return true
        if k = KindMetaProperty
            return true
        if k = KindImportKeyword
            return true
        k = KindMissingDeclaration
    }

    ; ── unary and update ────────────────────────────────────────────────────

    procedure parse_unary_expression_or_higher(this) returns pointer[AstNode]
    {
        if this.is_update_expression()
        {
            let pos this.node_pos()
            let update_expression this.parse_update_expression()
            if update_expression = null
                return null
            ; `a ** b` — the exponent binds to the UPDATE expression, so the
            ; climb is re-entered here rather than one level up.
            if token = KindAsteriskAsteriskToken
                return this.parse_binary_expression_rest(get_binary_operator_precedence(token), update_expression, pos)
            return update_expression
        }

        let simple this.parse_simple_unary_expression()
        if simple = null
            return null
        ; `-a ** b` is a grammar error the reference reports and then parses
        ; anyway. A diagnostic, hence unported.
        if token = KindAsteriskAsteriskToken
            return this.unported("unary-exponentiation", token)
        simple
    }

    function is_update_expression(this) returns bool
    {
        if token = KindPlusToken
            return false
        if token = KindMinusToken
            return false
        if token = KindTildeToken
            return false
        if token = KindExclamationToken
            return false
        if token = KindDeleteKeyword
            return false
        if token = KindTypeOfKeyword
            return false
        if token = KindVoidKeyword
            return false
        if token = KindAwaitKeyword
            return false
        ; `<` is an update expression only under the JSX variant, where it opens
        ; an element. Here it opens a type assertion, which is a unary form.
        if token = KindLessThanToken
            return false
        true
    }

    procedure parse_update_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()

        var is_prefix false
        if token = KindPlusPlusToken
            set is_prefix: true
        if token = KindMinusMinusToken
            set is_prefix: true
        if is_prefix
        {
            this.next_token()
            let operand this.parse_left_hand_side_expression_or_higher()
            if operand = null
                return null
            return this.finish_node(this.new_node(KindPrefixUnaryExpression, NodeData.PrefixUnaryExpression(WrappedTypeData(operand))), pos)
        }

        let expression this.parse_left_hand_side_expression_or_higher()
        if expression = null
            return null

        var is_postfix false
        if token = KindPlusPlusToken
            set is_postfix: true
        if token = KindMinusMinusToken
            set is_postfix: true
        if is_postfix
        {
            ; ASI: a `++` on the NEXT line belongs to the next statement.
            if this.has_preceding_line_break() = false
            {
                this.next_token()
                return this.finish_node(this.new_node(KindPostfixUnaryExpression, NodeData.PostfixUnaryExpression(WrappedTypeData(expression))), pos)
            }
        }

        expression
    }

    procedure parse_simple_unary_expression(this) returns pointer[AstNode]
    {
        if token = KindPlusToken
            return this.parse_prefix_unary_expression()
        if token = KindMinusToken
            return this.parse_prefix_unary_expression()
        if token = KindTildeToken
            return this.parse_prefix_unary_expression()
        if token = KindExclamationToken
            return this.parse_prefix_unary_expression()

        if token = KindDeleteKeyword
            return this.parse_keyword_unary_expression(KindDeleteExpression)
        if token = KindTypeOfKeyword
            return this.parse_keyword_unary_expression(KindTypeOfExpression)
        if token = KindVoidKeyword
            return this.parse_keyword_unary_expression(KindVoidExpression)

        if token = KindLessThanToken
            return this.parse_type_assertion()

        if token = KindAwaitKeyword
        {
            if this.is_await_expression()
                return this.parse_keyword_unary_expression(KindAwaitExpression)
        }

        this.parse_update_expression()
    }

    procedure parse_prefix_unary_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        let operand this.parse_simple_unary_expression()
        if operand = null
            return null
        this.finish_node(this.new_node(KindPrefixUnaryExpression, NodeData.PrefixUnaryExpression(WrappedTypeData(operand))), pos)
    }

    ; parseDeleteExpression / parseTypeOfExpression / parseVoidExpression /
    ; parseAwaitExpression are four copies of one body in the reference, and the
    ; only thing that differs is the node kind. Kept as one function with the
    ; kind as an argument, which is the same grouping WrappedTypeData makes on
    ; the ast side.
    procedure parse_keyword_unary_expression(this, kind: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        let operand this.parse_simple_unary_expression()
        if operand = null
            return null
        var n null as pointer[AstNode]
        if kind = KindDeleteExpression
            set n: this.new_node(kind, NodeData.DeleteExpression(WrappedTypeData(operand)))
        if kind = KindTypeOfExpression
            set n: this.new_node(kind, NodeData.TypeOfExpression(WrappedTypeData(operand)))
        if kind = KindVoidExpression
            set n: this.new_node(kind, NodeData.VoidExpression(WrappedTypeData(operand)))
        if kind = KindAwaitExpression
            set n: this.new_node(kind, NodeData.AwaitExpression(WrappedTypeData(operand)))
        this.finish_node(n, pos)
    }

    procedure is_await_expression(this) returns bool
    {
        if token <> KindAwaitKeyword
            return false
        if this.in_await_context()
            return true
        ; The same heuristic as `yield`: outside an async function `await` is an
        ; ordinary name, and only a name or a literal right after it settles the
        ; question.
        this.look_ahead_next_token_is_identifier_or_keyword_or_literal_on_same_line()
    }

    ; `<T>x`. The TYPE comes first here — the opposite of `x as T` — which is
    ; why the two do not share a record on the ast side.
    procedure parse_type_assertion(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindLessThanToken) = false
            return null
        let type_node this.parse_type()
        if type_node = null
            return null
        if this.parse_expected(KindGreaterThanToken) = false
            return null
        let expression this.parse_simple_unary_expression()
        if expression = null
            return null
        this.finish_node(this.new_node(KindTypeAssertionExpression, NodeData.TypeAssertionExpression(TypeAssertionData(type_node, expression))), pos)
    }

    ; ── the left-hand side ──────────────────────────────────────────────────

    procedure parse_left_hand_side_expression_or_higher(this) returns pointer[AstNode]
    {
        let pos this.node_pos()

        var expression null as pointer[AstNode]
        if token = KindImportKeyword
        {
            ; Both `import(…)` and `import.meta` set a flag on the SOURCE FILE,
            ; which this port does not model — so parsing them would produce a
            ; file node whose flags disagree with the reference's, which is
            ; exactly what the yardstick compares. Reported rather than parsed.
            if this.look_ahead_next_token_is_open_paren_or_less_than()
                return this.unported("import-expression", token)
            if this.look_ahead_next_token_is_dot()
                return this.unported("import-expression", token)
            set expression: this.parse_member_expression_or_higher()
        }
        else
        {
            if token = KindSuperKeyword
                set expression: this.parse_super_expression()
            else
                set expression: this.parse_member_expression_or_higher()
        }
        if expression = null
            return null

        this.parse_call_expression_rest(pos, expression)
    }

    procedure parse_super_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let expression this.parse_token_node()
        if expression = null
            return null

        ; `super<T>()` — the reference parses the type arguments and then reports
        ; that super may not have any. A diagnostic, so it stops here. This
        ; over-reports for a `super < x` comparison, which is not a shape any
        ; real program has, and over-reporting is the direction this harness
        ; errs in.
        if token = KindLessThanToken
            return this.unported("super-type-arguments", token)

        if token = KindOpenParenToken
            return expression
        if token = KindDotToken
            return expression
        if token = KindOpenBracketToken
            return expression

        ; Anything else is the reference's "super must be followed by an
        ; argument list or member access" diagnostic.
        this.unported("super-must-be-followed", token)
    }

    procedure parse_member_expression_or_higher(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let expression this.parse_primary_expression()
        if expression = null
            return null
        this.parse_member_expression_rest(pos, expression, true)
    }

    procedure parse_member_expression_rest(this, pos: int, start_expression: pointer[AstNode], allow_optional_chain: bool) returns pointer[AstNode]
    {
        var expression start_expression

        while true
        {
            var question_dot_token null as pointer[AstNode]
            var is_property_access false
            var took_chain false

            if allow_optional_chain
            {
                if this.is_start_of_optional_property_or_element_access_chain()
                {
                    set took_chain: true
                    set question_dot_token: this.parse_expected_token(KindQuestionDotToken)
                    if question_dot_token = null
                        return null
                    set is_property_access: token_is_identifier_or_keyword(token)
                }
            }
            if took_chain = false
                set is_property_access: this.parse_optional(KindDotToken)
            if this.is_unported()
                return null

            if is_property_access
            {
                set expression: this.parse_property_access_expression_rest(pos, expression, question_dot_token)
                if expression = null
                    return null
                continue
            }

            ; In a decorator context a `[` opens a computed property name, not an
            ; element access — unless a `?.` said otherwise.
            var allow_element false
            if question_dot_token <> null
                set allow_element: true
            else
            {
                if this.in_decorator_context() = false
                    set allow_element: true
            }
            if allow_element
            {
                if this.parse_optional(KindOpenBracketToken)
                {
                    set expression: this.parse_element_access_expression_rest(pos, expression, question_dot_token)
                    if expression = null
                        return null
                    continue
                }
            }

            if this.is_template_start_of_tagged_template()
                return this.unported("tagged-template", token)

            if question_dot_token = null
            {
                if token = KindExclamationToken
                {
                    if this.has_preceding_line_break() = false
                    {
                        this.next_token()
                        set expression: this.finish_node(this.new_node(KindNonNullExpression, NodeData.NonNullExpression(WrappedTypeData(expression))), pos)
                        if expression = null
                            return null
                        continue
                    }
                }

                let type_arguments this.try_parse_type_arguments_in_expression()
                if this.is_unported()
                    return null
                if type_arguments <> null
                {
                    set expression: this.finish_node(this.new_node(KindExpressionWithTypeArguments, NodeData.ExpressionWithTypeArguments(ExpressionWithTypeArgumentsData(expression, type_arguments))), pos)
                    if expression = null
                        return null
                    continue
                }
            }

            return expression
        }

        expression
    }

    procedure is_start_of_optional_property_or_element_access_chain(this) returns bool
    {
        if token <> KindQuestionDotToken
            return false
        this.look_ahead_next_token_is_identifier_or_keyword_or_open_bracket_or_template()
    }

    procedure parse_property_access_expression_rest(this, pos: int, expression: pointer[AstNode], question_dot_token: pointer[AstNode]) returns pointer[AstNode]
    {
        let name this.parse_right_side_of_dot(true, true)
        if name = null
            return null

        var is_optional_chain false
        if question_dot_token <> null
            set is_optional_chain: true
        else
            set is_optional_chain: this.try_reparse_optional_chain(expression)

        ; `a?.#x` — the reference reports that an optional chain may not contain
        ; a private name, and builds the node anyway, so only the diagnostic
        ; differs.
        if is_optional_chain
        {
            if AstNode.kind_of(name) = KindPrivateIdentifier
                return this.unported("optional-chain-private-name", token)
        }

        ; `f<T>.x` — an instantiation expression cannot be followed by a property
        ; access, which the reference reports.
        if AstNode.kind_of(expression) = KindExpressionWithTypeArguments
            return this.unported("instantiation-property-access", token)

        let n this.new_node(KindPropertyAccessExpression, NodeData.PropertyAccessExpression(PropertyAccessData(expression, question_dot_token, name)))
        if is_optional_chain
            set n.flags: n.flags | NodeFlagsOptionalChain
        this.finish_node(n, pos)
    }

    procedure parse_element_access_expression_rest(this, pos: int, expression: pointer[AstNode], question_dot_token: pointer[AstNode]) returns pointer[AstNode]
    {
        ; `a[]` — the reference reports that an element access needs an argument
        ; and synthesizes a missing identifier.
        if token = KindCloseBracketToken
            return this.unported("empty-element-access", token)

        let argument_expression this.parse_expression_allow_in()
        if argument_expression = null
            return null
        if this.parse_expected(KindCloseBracketToken) = false
            return null

        var is_optional_chain false
        if question_dot_token <> null
            set is_optional_chain: true
        else
            set is_optional_chain: this.try_reparse_optional_chain(expression)

        let n this.new_node(KindElementAccessExpression, NodeData.ElementAccessExpression(ElementAccessData(expression, question_dot_token, argument_expression)))
        if is_optional_chain
            set n.flags: n.flags | NodeFlagsOptionalChain
        this.finish_node(n, pos)
    }

    ; ★ An optional chain survives a `!`: in `a?.b!.c` the non-null expression
    ; sits BETWEEN the two links, and the flag has to be pushed down through it
    ; so that `.c` knows it is still in the chain. That is what this walk does,
    ; and it MUTATES nodes that were already finished — the one place in the
    ; parser where a node's flags change after finish_node.
    procedure try_reparse_optional_chain(this, start_node: pointer[AstNode]) returns bool
    {
        if (start_node.flags & NodeFlagsOptionalChain) <> 0
            return true
        if AstNode.kind_of(start_node) <> KindNonNullExpression
            return false

        var expr AstNode.child_at(start_node, 0)
        while true
        {
            if expr = null
                return false
            if AstNode.kind_of(expr) <> KindNonNullExpression
                break
            if (expr.flags & NodeFlagsOptionalChain) <> 0
                break
            set expr: AstNode.child_at(expr, 0)
        }
        if expr = null
            return false
        if (expr.flags & NodeFlagsOptionalChain) = 0
            return false

        var n start_node
        while AstNode.kind_of(n) = KindNonNullExpression
        {
            set n.flags: n.flags | NodeFlagsOptionalChain
            set n: AstNode.child_at(n, 0)
            if n = null
                break
        }
        true
    }

    procedure parse_call_expression_rest(this, pos: int, start_expression: pointer[AstNode]) returns pointer[AstNode]
    {
        var expression start_expression

        while true
        {
            set expression: this.parse_member_expression_rest(pos, expression, true)
            if expression = null
                return null

            var type_arguments null as pointer[Array[pointer[AstNode]]]
            let question_dot_token this.parse_optional_token(KindQuestionDotToken)
            if this.is_unported()
                return null
            if question_dot_token <> null
            {
                set type_arguments: this.try_parse_type_arguments_in_expression()
                if this.is_unported()
                    return null
                if this.is_template_start_of_tagged_template()
                    return this.unported("tagged-template", token)
            }

            var is_call false
            if type_arguments <> null
                set is_call: true
            if token = KindOpenParenToken
                set is_call: true

            if is_call
            {
                ; `f<T>(x)` came through parse_member_expression_rest as an
                ; ExpressionWithTypeArguments; the call absorbs it back into one
                ; CallExpression, which is why the type arguments are read off
                ; the node rather than re-parsed.
                if question_dot_token = null
                {
                    if AstNode.kind_of(expression) = KindExpressionWithTypeArguments
                    {
                        set type_arguments: AstNode.type_arguments_of(expression)
                        set expression: AstNode.child_at(expression, 0)
                        if expression = null
                            return null
                    }
                }

                let argument_list this.parse_argument_list()
                if argument_list = null
                    return null

                var is_optional_chain false
                if question_dot_token <> null
                    set is_optional_chain: true
                else
                    set is_optional_chain: this.try_reparse_optional_chain(expression)

                let n this.new_node(KindCallExpression, NodeData.CallExpression(CallExpressionData(expression, question_dot_token, type_arguments, argument_list)))
                if is_optional_chain
                    set n.flags: n.flags | NodeFlagsOptionalChain
                set expression: this.finish_node(n, pos)
                if expression = null
                    return null
                continue
            }

            ; A `?.` that led nowhere: the reference reports "Identifier expected"
            ; and builds a property access onto a missing name.
            if question_dot_token <> null
                return this.unported("optional-chain-identifier", token)

            break
        }

        expression
    }

    procedure parse_argument_list(this) returns pointer[Array[pointer[AstNode]]]
    {
        if this.parse_expected(KindOpenParenToken) = false
            return null
        let list this.parse_delimited_list(PCArgumentExpressions)
        if list = null
            return null
        if this.parse_expected(KindCloseParenToken) = false
            return null
        list
    }

    ; doInContext(DisallowIn|DecoratorContext, false, …) — an argument is parsed
    ; with `in` allowed and outside any decorator.
    procedure parse_argument_expression(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowInContext | NodeFlagsDecoratorContext, false)
        let result this.parse_argument_or_array_literal_element()
        set context_flags: saved
        result
    }

    procedure parse_argument_or_array_literal_element(this) returns pointer[AstNode]
    {
        if token = KindDotDotDotToken
            return this.parse_spread_element()
        ; An ELISION — `[, 1]` — is a zero-width OmittedExpression sitting where
        ; the missing element would have been. It has no fields and no children,
        ; so it is a Token whose kind says what it is.
        if token = KindCommaToken
            return this.finish_node(this.new_node(KindOmittedExpression, NodeData.Token(TokenData())), this.node_pos())
        this.parse_assignment_expression_or_higher()
    }

    procedure parse_spread_element(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindDotDotDotToken) = false
            return null
        let expression this.parse_assignment_expression_or_higher()
        if expression = null
            return null
        this.finish_node(this.new_node(KindSpreadElement, NodeData.SpreadElement(WrappedTypeData(expression))), pos)
    }

    function is_template_start_of_tagged_template(this) returns bool
    {
        if token = KindNoSubstitutionTemplateLiteral
            return true
        token = KindTemplateHead
    }

    ; ── type arguments in an expression ─────────────────────────────────────
    ;
    ; ★★★ This is the function that forced the unported record to be rewindable.
    ; `a << b` reaches it — `<<` passes the precondition — and it then
    ; parses `<b>` as a type-parameter list, fails to find a comma, and throws
    ; the whole thing away. In the reference the diagnostics go with it; here the
    ; unported record has to, or a shift operator would be unparsable.
    ;
    ; The reference also refuses to run in a JavaScript file, where `<` is
    ; unambiguously a comparison. This port never sets NodeFlagsJavaScriptFile,
    ; so that half of the precondition is constantly false and is left out.
    procedure try_parse_type_arguments_in_expression(this) returns pointer[Array[pointer[AstNode]]]
    {
        var eligible false
        if token = KindLessThanToken
            set eligible: true
        if token = KindLessThanLessThanToken
            set eligible: true
        if eligible = false
            return null

        let saved this.mark()
        var result null as pointer[Array[pointer[AstNode]]]

        if this.re_scan_less_than_token() = KindLessThanToken
        {
            this.next_token()
            let type_arguments this.parse_delimited_list(PCTypeArguments)
            if type_arguments <> null
            {
                ; Without the closing `>` it was never a type argument list.
                if this.re_scan_greater_than_token() = KindGreaterThanToken
                {
                    this.next_token()
                    ; `f<number>(42)` is a call; `a < b > c` is two comparisons.
                    ; What follows decides, and only that.
                    if this.can_follow_type_arguments_in_expression()
                        set result: type_arguments
                }
            }
        }

        if result <> null
            return result
        this.rewind(saved)
        null
    }

    procedure can_follow_type_arguments_in_expression(this) returns bool
    {
        if token = KindOpenParenToken
            return true
        if token = KindNoSubstitutionTemplateLiteral
            return true
        if token = KindTemplateHead
            return true
        ; A list followed by `<` never makes sense; followed by `>` it is
        ; ambiguous with a re-scanned `>>`; and here `+` and `-` are unary.
        if token = KindLessThanToken
            return false
        if token = KindGreaterThanToken
            return false
        if token = KindPlusToken
            return false
        if token = KindMinusToken
            return false
        if this.has_preceding_line_break()
            return true
        if this.is_binary_operator()
            return true
        this.is_start_of_expression() = false
    }

    function is_binary_operator(this) returns bool
    {
        if this.in_disallow_in_context()
        {
            if token = KindInKeyword
                return false
        }
        get_binary_operator_precedence(token) <> OperatorPrecedenceInvalid
    }

    ; ── primary expressions ─────────────────────────────────────────────────

    procedure parse_primary_expression(this) returns pointer[AstNode]
    {
        if token = KindNoSubstitutionTemplateLiteral
        {
            ; An invalid template is re-scanned by the reference, which needs
            ; ReScanTemplateToken.
            if (scanner.token_flags() & TokenFlagsIsInvalid) <> 0
                return this.unported("template-rescan", token)
            return this.parse_literal_expression(KindNoSubstitutionTemplateLiteral)
        }
        if token = KindNumericLiteral
            return this.parse_literal_expression(KindNumericLiteral)
        if token = KindBigIntLiteral
            return this.parse_literal_expression(KindBigIntLiteral)
        if token = KindStringLiteral
            return this.parse_literal_expression(KindStringLiteral)

        if token = KindThisKeyword
            return this.parse_token_node()
        if token = KindSuperKeyword
            return this.parse_token_node()
        if token = KindNullKeyword
            return this.parse_token_node()
        if token = KindTrueKeyword
            return this.parse_token_node()
        if token = KindFalseKeyword
            return this.parse_token_node()

        if token = KindOpenParenToken
            return this.parse_parenthesized_expression()
        if token = KindOpenBracketToken
            return this.parse_array_literal_expression()
        if token = KindOpenBraceToken
            return this.parse_object_literal_expression()

        ; An ASYNC ARROW function was already handled above; what is left is
        ; `async function`, and a bare `async` that is an ordinary name. The
        ; reference falls THROUGH to the identifier case for the second, which is
        ; why this arm cannot be an unconditional return.
        if token = KindAsyncKeyword
        {
            if this.look_ahead_next_token_is_function_keyword_on_same_line()
                return this.parse_function_expression()
        }

        if token = KindAtToken
            return this.unported("decorated-expression", token)
        if token = KindClassKeyword
            return this.parse_class_expression()
        if token = KindFunctionKeyword
            return this.parse_function_expression()
        if token = KindNewKeyword
            return this.parse_new_expression_or_new_dot_target()

        ; A `/` here is a regular expression, which needs ReScanSlashToken. The
        ; reference falls through to its "Expression expected" diagnostic when
        ; the re-scan says otherwise — also unported, so one tag covers both.
        if token = KindSlashToken
            return this.unported("regular-expression", token)
        if token = KindSlashEqualsToken
            return this.unported("regular-expression", token)

        if token = KindTemplateHead
            return this.unported("template-expression", token)
        ; `#field in obj` — the only expression position a private name may
        ; appear in, and the reference does not check that here: it builds the
        ; node and lets the checker refuse every other use.
        if token = KindPrivateIdentifier
            return this.parse_private_identifier()

        if this.is_identifier()
            return this.parse_identifier()

        ; The reference's fallback reports "Expression expected" and synthesizes
        ; a missing identifier.
        this.unported("primary-expression", token)
    }

    procedure parse_parenthesized_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        if this.parse_expected(KindOpenParenToken) = false
            return null
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        if this.parse_expected(KindCloseParenToken) = false
            return null
        let result this.finish_node(this.new_node(KindParenthesizedExpression, NodeData.ParenthesizedExpression(WrappedTypeData(expression))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_array_literal_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindOpenBracketToken) = false
            return null
        let elements this.parse_delimited_list(PCArrayLiteralMembers)
        if elements = null
            return null
        if this.parse_expected(KindCloseBracketToken) = false
            return null
        this.finish_node(this.new_node(KindArrayLiteralExpression, NodeData.ArrayLiteralExpression(ElementListData(elements))), pos)
    }

    procedure parse_object_literal_expression(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindOpenBraceToken) = false
            return null
        let properties this.parse_delimited_list(PCObjectLiteralMembers)
        if properties = null
            return null
        if this.parse_expected(KindCloseBraceToken) = false
            return null
        this.finish_node(this.new_node(KindObjectLiteralExpression, NodeData.ObjectLiteralExpression(ElementListData(properties))), pos)
    }

    procedure parse_object_literal_element(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()

        if this.parse_optional(KindDotDotDotToken)
        {
            let spread this.parse_assignment_expression_or_higher()
            if spread = null
                return null
            let spread_result this.finish_node(this.new_node(KindSpreadAssignment, NodeData.SpreadAssignment(WrappedTypeData(spread))), pos)
            return this.with_jsdoc(spread_result, jsdoc)
        }

        let modifiers this.parse_modifiers(true, false, false)
        if this.is_unported()
            return null

        ; `get x() {}` / `set x(v) {}` are parseAccessorDeclaration — the same
        ; entry point a class member uses, reached from the object literal.
        if this.parse_contextual_modifier(KindGetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindGetAccessor, ParseFlagsNone)
        if this.parse_contextual_modifier(KindSetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindSetAccessor, ParseFlagsNone)

        let asterisk_token this.parse_optional_token(KindAsteriskToken)
        if this.is_unported()
            return null

        ; ★ Asked BEFORE the name is parsed, and it decides shorthand-ness. A
        ; keyword property name (`{ default: 1 }`) is a name and NOT an
        ; identifier, so it can never be shorthand — which is exactly what this
        ; captures and what re-asking afterwards would lose.
        let token_is_identifier this.is_identifier()

        let name this.parse_property_name()
        if name = null
            return null

        var postfix_token this.parse_optional_token(KindQuestionToken)
        if postfix_token = null
            set postfix_token: this.parse_optional_token(KindExclamationToken)
        if this.is_unported()
            return null

        var is_method false
        if asterisk_token <> null
            set is_method: true
        if token = KindOpenParenToken
            set is_method: true
        if token = KindLessThanToken
            set is_method: true
        if is_method
            return this.parse_method_declaration(pos, jsdoc, modifiers, asterisk_token, name, postfix_token)

        var is_shorthand false
        if token_is_identifier
        {
            if token <> KindColonToken
                set is_shorthand: true
        }

        if is_shorthand
        {
            ; `{ a = 1 }` — the CoverInitializedName production, which is only
            ; legal as a destructuring pattern and is reported by the checker,
            ; not here.
            let equals_token this.parse_optional_token(KindEqualsToken)
            if this.is_unported()
                return null
            var object_assignment_initializer null as pointer[AstNode]
            if equals_token <> null
            {
                set object_assignment_initializer: this.parse_assignment_expression_allow_in()
                if object_assignment_initializer = null
                    return null
            }
            let short_result this.finish_node(this.new_node(KindShorthandPropertyAssignment, NodeData.ShorthandPropertyAssignment(ShorthandPropertyAssignmentData(modifiers, name, postfix_token, equals_token, object_assignment_initializer))), pos)
            return this.with_jsdoc(short_result, jsdoc)
        }

        if this.parse_expected(KindColonToken) = false
            return null
        let initializer this.parse_assignment_expression_allow_in()
        if initializer = null
            return null
        let result this.finish_node(this.new_node(KindPropertyAssignment, NodeData.PropertyAssignment(PropertyAssignmentData(modifiers, name, postfix_token, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_property_name(this) returns pointer[AstNode]
    {
        let saved_await_identifier statement_has_await_identifier
        let prop this.parse_property_name_worker(true)
        set statement_has_await_identifier: saved_await_identifier
        prop
    }

    procedure parse_property_name_worker(this, allow_computed_property_names: bool) returns pointer[AstNode]
    {
        if token = KindStringLiteral
            return this.parse_literal_expression(KindStringLiteral)
        if token = KindNumericLiteral
            return this.parse_literal_expression(KindNumericLiteral)
        if token = KindBigIntLiteral
            return this.parse_literal_expression(KindBigIntLiteral)
        if allow_computed_property_names
        {
            if token = KindOpenBracketToken
                return this.parse_computed_property_name()
        }
        if token = KindPrivateIdentifier
            return this.parse_private_identifier()
        this.parse_identifier_name()
    }

    procedure parse_computed_property_name(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindOpenBracketToken) = false
            return null
        ; A full expression, comma operator included — the grammar allows only an
        ; assignment expression and the grammar CHECKER reports the difference.
        let expression this.parse_expression_allow_in()
        if expression = null
            return null
        if this.parse_expected(KindCloseBracketToken) = false
            return null
        this.finish_node(this.new_node(KindComputedPropertyName, NodeData.ComputedPropertyName(WrappedTypeData(expression))), pos)
    }

    procedure parse_contextual_modifier(this, k: int) returns bool
    {
        let saved this.mark()
        if token = k
        {
            if this.next_token_can_follow_modifier()
                return true
        }
        this.rewind(saved)
        false
    }

    ; ── the function expression ─────────────────────────────────────────────

    procedure parse_function_expression(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDecoratorContext, false)

        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers(false, false, false)
        if this.is_unported()
            return null
        if this.parse_expected(KindFunctionKeyword) = false
            return null

        let asterisk_token this.parse_optional_token(KindAsteriskToken)
        if this.is_unported()
            return null

        var signature_flags ParseFlagsNone
        if asterisk_token <> null
            set signature_flags: signature_flags | ParseFlagsYield
        let is_async has_modifier(modifiers, KindAsyncKeyword)
        if is_async
            set signature_flags: signature_flags | ParseFlagsAwait

        ; ★ The NAME is parsed inside the yield/await context the signature
        ; declares — not outside it, as the parameters' context is. That is why
        ; `function* yield() {}` is an error while `function yield() {}` is not,
        ; and it is a separate save/restore from the one around the whole
        ; function.
        let name_saved context_flags
        if asterisk_token <> null
            this.set_context_flags(NodeFlagsYieldContext, true)
        if is_async
            this.set_context_flags(NodeFlagsAwaitContext, true)
        var name null as pointer[AstNode]
        if this.is_binding_identifier()
        {
            set name: this.parse_binding_identifier()
            if name = null
                return null
        }
        set context_flags: name_saved

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(signature_flags)
        if parameters = null
            return null

        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        ; A function EXPRESSION always has a body — there is no overload form —
        ; so this is parse_function_block, not parse_function_block_or_semicolon.
        let body this.parse_function_block(signature_flags)
        set context_flags: saved
        if body = null
            return null

        let result this.finish_node(this.new_node(KindFunctionExpression, NodeData.FunctionExpression(FunctionExpressionData(modifiers, asterisk_token, name, type_parameters, parameters, return_type, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ── new ─────────────────────────────────────────────────────────────────

    procedure parse_new_expression_or_new_dot_target(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindNewKeyword) = false
            return null

        ; `new.target`. The reference's MetaProperty additionally stores WHICH
        ; keyword it was built from, a field the dump cannot see.
        if this.parse_optional(KindDotToken)
        {
            let meta_name this.parse_identifier_name()
            if meta_name = null
                return null
            return this.finish_node(this.new_node(KindMetaProperty, NodeData.MetaProperty(WrappedTypeData(meta_name))), pos)
        }

        ; ★ allowOptionalChain is FALSE here: `new a?.b()` is invalid, and the
        ; reference reports it below rather than parsing a chain.
        let expression_pos this.node_pos()
        let primary this.parse_primary_expression()
        if primary = null
            return null
        var expression this.parse_member_expression_rest(expression_pos, primary, false)
        if expression = null
            return null

        var type_arguments null as pointer[Array[pointer[AstNode]]]
        if AstNode.kind_of(expression) = KindExpressionWithTypeArguments
        {
            set type_arguments: AstNode.type_arguments_of(expression)
            set expression: AstNode.child_at(expression, 0)
            if expression = null
                return null
        }

        if token = KindQuestionDotToken
            return this.unported("new-optional-chain", token)

        var argument_list null as pointer[Array[pointer[AstNode]]]
        if token = KindOpenParenToken
        {
            set argument_list: this.parse_argument_list()
            if argument_list = null
                return null
        }

        this.finish_node(this.new_node(KindNewExpression, NodeData.NewExpression(NewExpressionData(expression, type_arguments, argument_list))), pos)
    }

    ; ── arrow functions ─────────────────────────────────────────────────────
    ;
    ; ★★★ The most expensive shape in the ladder, and the reason is that a
    ; parameter LIST and a parenthesized EXPRESSION are the same text until the
    ; `=>` arrives: `(x = 10)`, `(x, y)` and `a ? (b): c` all read as signatures.
    ; The reference answers with a TRISTATE and speculates on the UNKNOWN half —
    ; and a speculation that is thrown away takes its diagnostics with it, which
    ; is what the rewound unported record models (see ParserState).
    ;
    ; ★ One consequence for this port specifically: `({x}) => …` and `([x]) => …`
    ; are UNKNOWN, so the speculative parse runs, and it walks straight into a
    ; binding pattern — unported. `({ x: 1 })` therefore reports unported even
    ; though the parenthesized object literal it turns out to be is perfectly
    ; parsable here. That over-reports, which is the direction to err in, and it
    ; closes with the binding-pattern slice.

    procedure try_parse_parenthesized_arrow_function_expression(this, allow_return_type: bool) returns pointer[AstNode]
    {
        let tristate this.is_parenthesized_arrow_function_expression()
        if this.is_unported()
            return null
        if tristate = TristateFalse
            return null

        ; Definitely an arrow: parse it without requiring a following `=>`, so
        ; that the diagnostics land where the user's error is.
        if tristate = TristateTrue
            return this.parse_parenthesized_arrow_function_expression(true, true)

        let saved this.mark()
        let result this.parse_possible_parenthesized_arrow_function_expression(allow_return_type)
        if result = null
            this.rewind(saved)
        result
    }

    procedure is_parenthesized_arrow_function_expression(this) returns int
    {
        var probe false
        if token = KindOpenParenToken
            set probe: true
        if token = KindLessThanToken
            set probe: true
        if token = KindAsyncKeyword
            set probe: true
        if probe
        {
            let saved this.mark()
            let r this.next_is_parenthesized_arrow_function_expression()
            this.rewind(saved)
            return r
        }
        ; A standalone `=>` is the reference's error-recovery tweak: it is what
        ; the user most likely meant to write.
        if token = KindEqualsGreaterThanToken
            return TristateTrue
        TristateFalse
    }

    procedure next_is_parenthesized_arrow_function_expression(this) returns int
    {
        if token = KindAsyncKeyword
        {
            this.next_token()
            if this.has_preceding_line_break()
                return TristateFalse
            var opens false
            if token = KindOpenParenToken
                set opens: true
            if token = KindLessThanToken
                set opens: true
            if opens = false
                return TristateFalse
        }

        let first token
        let second this.next_token()

        if first = KindOpenParenToken
        {
            if second = KindCloseParenToken
            {
                ; "() =>", "(): " and "() {". The last is not an arrow function,
                ; but it is probably what was meant.
                let third this.next_token()
                if third = KindEqualsGreaterThanToken
                    return TristateTrue
                if third = KindColonToken
                    return TristateTrue
                if third = KindOpenBraceToken
                    return TristateTrue
                return TristateFalse
            }

            ; "([" and "({" may start a binding pattern — or an expression.
            if second = KindOpenBracketToken
                return TristateUnknown
            if second = KindOpenBraceToken
                return TristateUnknown

            ; "(..." is a rest parameter and nothing else.
            if second = KindDotDotDotToken
                return TristateTrue

            ; "(xxx yyy" with xxx a modifier is not legal, and is treated as a
            ; lambda so the error message can say so.
            var modifier_start false
            if is_modifier_kind(second)
            {
                if second <> KindAsyncKeyword
                {
                    if this.look_ahead_next_token_is_identifier()
                        set modifier_start: true
                }
            }
            if modifier_start
            {
                if this.next_token() = KindAsKeyword
                    return TristateFalse
                return TristateTrue
            }

            ; `(this` is not a valid parameter name and is parsed as one anyway,
            ; so that the error is semantic rather than syntactic.
            var name_start this.is_identifier()
            if name_start = false
            {
                if second = KindThisKeyword
                    set name_start: true
            }
            if name_start = false
                return TristateFalse

            let third this.next_token()
            if third = KindColonToken
                return TristateTrue
            if third = KindQuestionToken
            {
                this.next_token()
                if token = KindColonToken
                    return TristateTrue
                if token = KindCommaToken
                    return TristateTrue
                if token = KindEqualsToken
                    return TristateTrue
                if token = KindCloseParenToken
                    return TristateTrue
                return TristateFalse
            }
            if third = KindCommaToken
                return TristateUnknown
            if third = KindEqualsToken
                return TristateUnknown
            if third = KindCloseParenToken
                return TristateUnknown
            return TristateFalse
        }

        ; `first` is `<`, a generic arrow function's type parameter list. The
        ; reference's JSX override belongs to the JSX variant, which is not
        ; selected here.
        var generic_start this.is_identifier()
        if generic_start = false
        {
            if token = KindConstKeyword
                set generic_start: true
        }
        if generic_start = false
            return TristateFalse
        TristateUnknown
    }

    procedure parse_possible_parenthesized_arrow_function_expression(this, allow_return_type: bool) returns pointer[AstNode]
    {
        let token_pos scanner.token_start()
        if this.not_parenthesized_arrow_has(token_pos)
            return null
        let result this.parse_parenthesized_arrow_function_expression(false, allow_return_type)
        if result = null
            this.not_parenthesized_arrow_add(token_pos)
        result
    }

    function not_parenthesized_arrow_has(this, pos: int) returns bool
    {
        if not_parenthesized_arrow = null
            return false
        let a not_parenthesized_arrow
        let len a.get_length() as int
        var i 0
        while i < len
        {
            if *(a.get_buffer() + i) = pos
                return true
            set i: i + 1
        }
        false
    }

    procedure not_parenthesized_arrow_add(this, pos: int)
    {
        if not_parenthesized_arrow = null
        {
            let fresh host.allocate(sizeof Array[int], alignof Array[int]) as pointer[Array[int]]
            set *fresh: Array[int]()
            set not_parenthesized_arrow: fresh
        }
        let a not_parenthesized_arrow
        a.add(pos)
    }

    procedure parse_parenthesized_arrow_function_expression(this, allow_ambiguity: bool, allow_return_type: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers_for_arrow_function()
        if this.is_unported()
            return null
        var is_async false
        if modifiers <> null
            set is_async: true
        var signature_flags ParseFlagsNone
        if is_async
            set signature_flags: ParseFlagsAwait

        ; An arrow function is never a generator, so there is no yield flag.
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null

        ; A missing `(` is a diagnostic on the allowAmbiguity side and a clean
        ; "not an arrow" on the other; parse_expected already recorded the first,
        ; and the caller's rewind discards it for the second.
        if this.parse_expected(KindOpenParenToken) = false
            return null

        let parameters this.parse_parameters_worker(signature_flags, allow_ambiguity)
        if parameters = null
            return null
        if this.parse_expected(KindCloseParenToken) = false
            return null

        ; Asked BEFORE the return type is parsed — by then the `:` is consumed.
        let has_return_colon token = KindColonToken
        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        ; Parsing a signature is not enough: "(x = 10)", "(x,y)" and "a ? (b): c"
        ; are all valid signatures and none of them is an arrow function. One
        ; token of look-ahead settles it.
        if allow_ambiguity = false
        {
            var commits false
            if token = KindEqualsGreaterThanToken
                set commits: true
            if token = KindOpenBraceToken
                set commits: true
            if commits = false
                return null
        }

        ; The reference also accepts a `{` here, synthesizing a MISSING `=>` for
        ; the error case and parsing an IDENTIFIER as the body when neither is
        ; present. Both are diagnostics, so parse_expected_token stops instead —
        ; which means that past this point the token WAS `=>`.
        let equals_greater_than_token this.parse_expected_token(KindEqualsGreaterThanToken)
        if equals_greater_than_token = null
            return null
        let body this.parse_arrow_function_expression_body(is_async, allow_return_type)
        if body = null
            return null

        ; `x ? y => ({ y }) : z => ({ z })`. In the true branch of a conditional
        ; a `:` ends the expression, so a return type may not be consumed there
        ; unless a SECOND colon follows.
        if allow_return_type = false
        {
            if has_return_colon
            {
                if token <> KindColonToken
                    return null
            }
        }

        let result this.finish_node(this.new_node(KindArrowFunction, NodeData.ArrowFunction(ArrowFunctionData(modifiers, type_parameters, parameters, return_type, equals_greater_than_token, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_modifiers_for_arrow_function(this) returns pointer[Array[pointer[AstNode]]]
    {
        if token <> KindAsyncKeyword
            return null
        let pos this.node_pos()
        this.next_token()
        let m this.finish_node(this.new_node(KindAsyncKeyword, NodeData.Token(TokenData())), pos)
        if m = null
            return null
        let list AstNode.new_node_list(host)
        list.add(m)
        list
    }

    procedure parse_arrow_function_expression_body(this, is_async: bool, allow_return_type: bool) returns pointer[AstNode]
    {
        if token = KindOpenBraceToken
        {
            var block_flags ParseFlagsNone
            if is_async
                set block_flags: ParseFlagsAwait
            return this.parse_function_block(block_flags)
        }

        ; A plain STATEMENT after the arrow means the opening brace was probably
        ; forgotten. The reference recovers with ParseFlagsIgnoreMissingOpenBrace,
        ; which always reports.
        var looks_like_a_block false
        if token <> KindSemicolonToken
        {
            if token <> KindFunctionKeyword
            {
                if token <> KindClassKeyword
                {
                    if this.is_start_of_statement()
                    {
                        if this.is_start_of_expression_statement() = false
                            set looks_like_a_block: true
                    }
                }
            }
        }
        if looks_like_a_block
            return this.unported("arrow-body-missing-brace", token)

        let saved context_flags
        this.set_context_flags(NodeFlagsAwaitContext, is_async)
        this.set_context_flags(NodeFlagsYieldContext, false)
        let node this.parse_assignment_expression_or_higher_worker(allow_return_type)
        set context_flags: saved
        node
    }

    function is_start_of_expression_statement(this) returns bool
    {
        ; None of `{`, `function`, `class` or `@` can start an expression
        ; statement, per the grammar.
        if token = KindOpenBraceToken
            return false
        if token = KindFunctionKeyword
            return false
        if token = KindClassKeyword
            return false
        if token = KindAtToken
            return false
        this.is_start_of_expression()
    }

    ; ── the async simple arrow function ─────────────────────────────────────

    procedure try_parse_async_simple_arrow_function_expression(this, allow_return_type: bool) returns pointer[AstNode]
    {
        if token <> KindAsyncKeyword
            return null
        if this.look_ahead_next_is_un_parenthesized_async_arrow_function() = false
            return null
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let async_modifier this.parse_modifiers_for_arrow_function()
        if this.is_unported()
            return null
        let expr this.parse_binary_expression_or_higher(OperatorPrecedenceLowest)
        if expr = null
            return null
        this.parse_simple_arrow_function_expression(pos, expr, allow_return_type, jsdoc, async_modifier)
    }

    ; ★ This look-ahead PARSES — it runs the whole binary ladder to see whether
    ; what follows `async` is one identifier and an arrow — so anything it
    ; reports is thrown away with it, which the rewind now does.
    procedure look_ahead_next_is_un_parenthesized_async_arrow_function(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_un_parenthesized_async_arrow_function()
        this.rewind(saved)
        r
    }

    procedure next_is_un_parenthesized_async_arrow_function(this) returns bool
    {
        if token <> KindAsyncKeyword
            return false
        this.next_token()
        ; `async => x` is a plain arrow function whose parameter is named async.
        if this.has_preceding_line_break()
            return false
        if token = KindEqualsGreaterThanToken
            return false
        let expr this.parse_binary_expression_or_higher(OperatorPrecedenceLowest)
        if expr = null
            return false
        if this.has_preceding_line_break()
            return false
        if AstNode.kind_of(expr) <> KindIdentifier
            return false
        token = KindEqualsGreaterThanToken
    }

    procedure parse_simple_arrow_function_expression(this, pos: int, identifier: pointer[AstNode], allow_return_type: bool, jsdoc: int, async_modifier: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        ; The single parameter is SYNTHESIZED around the identifier that was
        ; already parsed, and it starts where that identifier does — not where
        ; the arrow function does, which differs whenever an `async` precedes it.
        let parameter this.finish_node(this.new_node(KindParameter, NodeData.Parameter(ParameterData(null, null, identifier, null, null, null))), AstNode.pos_of(identifier))
        if parameter = null
            return null
        let parameters AstNode.new_node_list(host)
        parameters.add(parameter)

        let equals_greater_than_token this.parse_expected_token(KindEqualsGreaterThanToken)
        if equals_greater_than_token = null
            return null

        var is_async false
        if async_modifier <> null
            set is_async: true
        let body this.parse_arrow_function_expression_body(is_async, allow_return_type)
        if body = null
            return null

        let result this.finish_node(this.new_node(KindArrowFunction, NodeData.ArrowFunction(ArrowFunctionData(async_modifier, null, parameters, null, equals_greater_than_token, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ── the expression-start predicates ─────────────────────────────────────

    procedure is_start_of_expression(this) returns bool
    {
        if this.is_start_of_left_hand_side_expression()
            return true
        ; `yield` and `await` always start an expression: either they are names,
        ; or they are keywords and started a yield/await expression.
        if unary_expression_start_token(token)
            return true
        ; Error tolerance: a leading binary operator is taken as the start of an
        ; expression, so that a missing left operand is one diagnostic rather
        ; than a cascade.
        if this.is_binary_operator()
            return true
        this.is_identifier()
    }

    function unary_expression_start_token(k: int) returns bool
    {
        if k = KindPlusToken
            return true
        if k = KindMinusToken
            return true
        if k = KindTildeToken
            return true
        if k = KindExclamationToken
            return true
        if k = KindDeleteKeyword
            return true
        if k = KindTypeOfKeyword
            return true
        if k = KindVoidKeyword
            return true
        if k = KindPlusPlusToken
            return true
        if k = KindMinusMinusToken
            return true
        if k = KindLessThanToken
            return true
        if k = KindAwaitKeyword
            return true
        if k = KindYieldKeyword
            return true
        if k = KindPrivateIdentifier
            return true
        k = KindAtToken
    }

    procedure is_start_of_left_hand_side_expression(this) returns bool
    {
        if left_hand_side_start_token(token)
            return true
        if token = KindImportKeyword
            return this.look_ahead_next_token_is_open_paren_or_less_than_or_dot()
        this.is_identifier()
    }

    function left_hand_side_start_token(k: int) returns bool
    {
        if k = KindThisKeyword
            return true
        if k = KindSuperKeyword
            return true
        if k = KindNullKeyword
            return true
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindStringLiteral
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindTemplateHead
            return true
        if k = KindOpenParenToken
            return true
        if k = KindOpenBracketToken
            return true
        if k = KindOpenBraceToken
            return true
        if k = KindFunctionKeyword
            return true
        if k = KindClassKeyword
            return true
        if k = KindNewKeyword
            return true
        if k = KindSlashToken
            return true
        if k = KindSlashEqualsToken
            return true
        k = KindIdentifier
    }

    ; isStartOfStatement. Its only caller in this slice is the arrow function's
    ; body, which asks whether a missing `{` is the likelier reading — but it is
    ; the reference's own statement predicate and the statement-list contexts
    ; will want it too.
    procedure is_start_of_statement(this) returns bool
    {
        if statement_start_token(token)
            return true
        if token = KindImportKeyword
        {
            if this.is_start_of_declaration()
                return true
            return this.look_ahead_next_token_is_open_paren_or_less_than_or_dot()
        }
        if token = KindConstKeyword
            return this.is_start_of_declaration()
        if token = KindExportKeyword
            return this.is_start_of_declaration()
        ; When these do not start a declaration they are an identifier in an
        ; expression statement, which is still a statement.
        if contextual_statement_start_token(token)
            return true
        ; ... and these may instead be the start of a CLASS MEMBER, which is not
        ; a statement — so an identifier directly after one says "member".
        if class_member_start_token(token)
        {
            if this.is_start_of_declaration()
                return true
            return this.look_ahead_next_token_is_identifier_or_keyword_on_same_line() = false
        }
        this.is_start_of_expression()
    }

    function statement_start_token(k: int) returns bool
    {
        if k = KindAtToken
            return true
        if k = KindSemicolonToken
            return true
        if k = KindOpenBraceToken
            return true
        if k = KindVarKeyword
            return true
        if k = KindLetKeyword
            return true
        if k = KindUsingKeyword
            return true
        if k = KindFunctionKeyword
            return true
        if k = KindClassKeyword
            return true
        if k = KindEnumKeyword
            return true
        if k = KindIfKeyword
            return true
        if k = KindDoKeyword
            return true
        if k = KindWhileKeyword
            return true
        if k = KindForKeyword
            return true
        if k = KindContinueKeyword
            return true
        if k = KindBreakKeyword
            return true
        if k = KindReturnKeyword
            return true
        if k = KindWithKeyword
            return true
        if k = KindSwitchKeyword
            return true
        if k = KindThrowKeyword
            return true
        if k = KindTryKeyword
            return true
        if k = KindDebuggerKeyword
            return true
        ; `catch` and `finally` do not really start a statement; the reference
        ; says they do so that they parse and are reported later.
        if k = KindCatchKeyword
            return true
        k = KindFinallyKeyword
    }

    function contextual_statement_start_token(k: int) returns bool
    {
        if k = KindAsyncKeyword
            return true
        if k = KindDeclareKeyword
            return true
        if k = KindInterfaceKeyword
            return true
        if k = KindModuleKeyword
            return true
        if k = KindNamespaceKeyword
            return true
        if k = KindTypeKeyword
            return true
        if k = KindGlobalKeyword
            return true
        k = KindDeferKeyword
    }

    function class_member_start_token(k: int) returns bool
    {
        if k = KindAccessorKeyword
            return true
        if k = KindPublicKeyword
            return true
        if k = KindPrivateKeyword
            return true
        if k = KindProtectedKeyword
            return true
        if k = KindStaticKeyword
            return true
        k = KindReadonlyKeyword
    }

    ; ── the look-ahead wrappers for the ladder ──────────────────────────────

    procedure look_ahead_next_token_is_open_paren_or_less_than(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r token = KindOpenParenToken
        if r = false
        {
            if token = KindLessThanToken
                set r: true
        }
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_open_paren_or_less_than_or_dot(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r token = KindOpenParenToken
        if r = false
        {
            if token = KindLessThanToken
                set r: true
        }
        if r = false
        {
            if token = KindDotToken
                set r: true
        }
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_dot(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() = KindDotToken
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_identifier(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        let r this.is_identifier()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_identifier_or_keyword_or_literal_on_same_line(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_identifier_or_keyword_or_literal_on_same_line()
        this.rewind(saved)
        r
    }

    procedure next_token_is_identifier_or_keyword_or_literal_on_same_line(this) returns bool
    {
        this.next_token()
        var ok token_is_identifier_or_keyword(token)
        if ok = false
        {
            if token = KindNumericLiteral
                set ok: true
        }
        if ok = false
        {
            if token = KindBigIntLiteral
                set ok: true
        }
        if ok = false
        {
            if token = KindStringLiteral
                set ok: true
        }
        if ok = false
            return false
        this.has_preceding_line_break() = false
    }

    procedure look_ahead_next_token_is_identifier_or_keyword_or_open_bracket_or_template(this) returns bool
    {
        let saved this.mark()
        this.next_token()
        var r token_is_identifier_or_keyword(token)
        if r = false
        {
            if token = KindOpenBracketToken
                set r: true
        }
        if r = false
        {
            if this.is_template_start_of_tagged_template()
                set r: true
        }
        this.rewind(saved)
        r
    }

    ; parseExpectedToken. The reference synthesizes a MISSING token when the
    ; expected one is absent, which is always preceded by a diagnostic — so the
    ; absent case is where this port stops.
    procedure parse_expected_token(this, kind: int) returns pointer[AstNode]
    {
        if token = kind
            return this.parse_token_node()
        this.unported("expected-token", kind)
        null
    }

    function in_disallow_in_context(this) returns bool
        (context_flags & NodeFlagsDisallowInContext) <> 0

    function in_decorator_context(this) returns bool
        (context_flags & NodeFlagsDecoratorContext) <> 0

    procedure parse_literal_expression(this, kind: int) returns pointer[AstNode]
    {
        let pos this.node_pos()

        ; The reference takes TokenValue() and the token flags here; the flags
        ; ride on the token rather than on the node, and no node in this slice
        ; reads either.
        this.next_token()

        if kind = KindNumericLiteral
            return this.finish_node(this.new_node(kind, NodeData.NumericLiteral(LiteralData())), pos)
        if kind = KindBigIntLiteral
            return this.finish_node(this.new_node(kind, NodeData.BigIntLiteral(LiteralData())), pos)
        if kind = KindNoSubstitutionTemplateLiteral
            return this.finish_node(this.new_node(kind, NodeData.NoSubstitutionTemplateLiteral(LiteralData())), pos)
        this.finish_node(this.new_node(kind, NodeData.StringLiteral(LiteralData())), pos)
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; TYPES — parser slice 3
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; The reference's "// TYPES" section, ported as one unit because it IS one:
    ; a type alias, a function signature, an interface member and a variable's
    ; `: T` all call the same parseType, and none of them can be built before it
    ; exists. `type X = …` is its smallest consumer, which is why it is the
    ; declaration this slice adds.
    ;
    ; ── The ladder, top to bottom ───────────────────────────────────────────
    ;
    ;   parseType                    conditional type  (T extends U ? X : Y)
    ;   parseUnionTypeOrHigher       A | B
    ;   parseIntersectionTypeOrHigher A & B
    ;   parseTypeOperatorOrHigher    keyof / unique / readonly / infer
    ;   parsePostfixTypeOrHigher     T[]  T[K]  T!  T?
    ;   parseNonArrayType            the leaves and the bracketed forms
    ;
    ; ── What is NOT ported, each because it is the head of another slice ────
    ;
    ;   (function and constructor types were this list's first entry and landed
    ;    with slice 4 — see the SIGNATURES banner)
    ;   the object type literal `{ … }`  it needs parseTypeMember — which is the
    ;                                    interface-member slice, and a mapped
    ;                                    type shares the tag because both stop
    ;                                    at the same `{`
    ;   `import(…)` types                they need the import machinery
    ;   template literal types           they need ReScanTemplateToken
    ;   the JSDoc prefix forms `*`, `??` they need two more re-scan entry points
    ;
    ; ── Three faithfulness notes, each one a thing that is easy to lose ─────
    ;
    ; (1) Some reference nodes carry a field the dump cannot see — the OPERATOR
    ;     of a TypeOperatorNode, the operator of a PrefixUnaryExpression, the
    ;     `IsTypeOf` flag of an ImportTypeNode. They are not stored here, and
    ;     that is a real gap rather than a saving: the yardstick compares kind,
    ;     range and flags, so it would not notice one being wrong. Stated so
    ;     that the slice which first READS such a field knows to add it.
    ;
    ; (2) The reference's list parsing goes through parsing CONTEXTS with a
    ;     per-context element predicate, terminator predicate and token-skipping
    ;     recovery. The three contexts this slice needs are ported literally
    ;     (is_list_element / is_list_terminator); the recovery is not, because
    ;     it only runs after a diagnostic, and a diagnostic is already unported.
    ;
    ; (3) `unported` is STICKY and speculation does NOT undo it (§3.9e). So a
    ;     look-ahead that walks into an unported construct stops the whole parse
    ;     even if the reference would have discarded that branch. That
    ;     over-reports and never under-reports, which is the direction this
    ;     harness is built to err in.

    ; ── context flags ───────────────────────────────────────────────────────
    ;
    ; setContextFlags. Go's `&^=` is AND-NOT, and Scaly spells it `& ~` — the
    ; unary complement exists (CLAUDE.md §3.5f).

    procedure set_context_flags(this, flags: int, value: bool)
    {
        if value
            set context_flags: context_flags | flags
        else
            set context_flags: context_flags & ~flags
    }

    function in_disallow_conditional_types_context(this) returns bool
        (context_flags & NodeFlagsDisallowConditionalTypesContext) <> 0

    ; ── the entry points ────────────────────────────────────────────────────

    procedure parse_type_annotation(this) returns pointer[AstNode]
    {
        if this.parse_optional(KindColonToken)
            return this.parse_type()
        null
    }

    procedure parse_type(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsTypeExcludesFlags, false)
        let result this.parse_type_worker()
        set context_flags: saved
        result
    }

    ; doInContext(p, flags, value, (*Parser).parseType) — the only shape of
    ; doInContext this slice needs, spelled out because it takes a func value.
    procedure parse_type_in_context(this, flags: int, value: bool) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(flags, value)
        let result this.parse_type()
        set context_flags: saved
        result
    }

    procedure parse_type_worker(this) returns pointer[AstNode]
    {
        if this.is_start_of_function_type_or_constructor_type()
            return this.parse_function_or_constructor_type()

        let pos this.node_pos()
        let type_node this.parse_union_type_or_higher()
        if type_node = null
            return null

        if this.in_disallow_conditional_types_context()
            return type_node
        if this.has_preceding_line_break()
            return type_node
        if this.parse_optional(KindExtendsKeyword) = false
            return type_node

        ; The type following `extends` may not itself be conditional; the two
        ; branches may.
        let extends_type this.parse_type_in_context(NodeFlagsDisallowConditionalTypesContext, true)
        if extends_type = null
            return null
        if this.parse_expected(KindQuestionToken) = false
            return null
        let true_type this.parse_type_in_context(NodeFlagsDisallowConditionalTypesContext, false)
        if true_type = null
            return null
        if this.parse_expected(KindColonToken) = false
            return null
        let false_type this.parse_type_in_context(NodeFlagsDisallowConditionalTypesContext, false)
        if false_type = null
            return null

        this.finish_node(this.new_node(KindConditionalType, NodeData.ConditionalType(ConditionalTypeData(type_node, extends_type, true_type, false_type))), pos)
    }

    ; ── union and intersection ──────────────────────────────────────────────
    ;
    ; The reference passes the constituent parser down as a func value; here the
    ; `is_union` flag selects it. Both constituents are known statically, and a
    ; callback is the shape the escape checker rejects (§3.9e).

    procedure parse_union_type_or_higher(this) returns pointer[AstNode]
        this.parse_union_or_intersection_type(KindBarToken, true)

    procedure parse_intersection_type_or_higher(this) returns pointer[AstNode]
        this.parse_union_or_intersection_type(KindAmpersandToken, false)

    procedure parse_constituent_type(this, is_union: bool) returns pointer[AstNode]
    {
        if is_union
            return this.parse_intersection_type_or_higher()
        this.parse_type_operator_or_higher()
    }

    ; parseFunctionOrConstructorTypeToError. The reference parses the function
    ; type and then reports that it must be parenthesized here; the node and the
    ; diagnostic are both unported, so the whole arm is.
    procedure parse_function_or_constructor_type_to_error(this, is_union: bool) returns pointer[AstNode]
    {
        if this.is_start_of_function_type_or_constructor_type()
            return this.unported("function-type", token)
        this.parse_constituent_type(is_union)
    }

    procedure parse_union_or_intersection_type(this, op: int, is_union: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let has_leading_operator this.parse_optional(op)

        var type_node null as pointer[AstNode]
        if has_leading_operator
            set type_node: this.parse_function_or_constructor_type_to_error(is_union)
        else
            set type_node: this.parse_constituent_type(is_union)
        if type_node = null
            return null

        ; A LEADING operator makes it a union/intersection node even with one
        ; constituent — `type A = | B` is a UnionType of one.
        var is_list has_leading_operator
        if token = op
            set is_list: true
        if is_list = false
            return type_node

        let types AstNode.new_node_list(host)
        types.add(type_node)
        while this.parse_optional(op)
        {
            let t this.parse_function_or_constructor_type_to_error(is_union)
            if t = null
                return null
            types.add(t)
        }

        var n null as pointer[AstNode]
        if is_union
            set n: this.new_node(KindUnionType, NodeData.UnionType(TypeListData(types)))
        else
            set n: this.new_node(KindIntersectionType, NodeData.IntersectionType(TypeListData(types)))
        this.finish_node(n, pos)
    }

    ; ── type operators ──────────────────────────────────────────────────────

    procedure parse_type_operator_or_higher(this) returns pointer[AstNode]
    {
        if token = KindKeyOfKeyword
            return this.parse_type_operator(token)
        if token = KindUniqueKeyword
            return this.parse_type_operator(token)
        if token = KindReadonlyKeyword
            return this.parse_type_operator(token)
        if token = KindInferKeyword
            return this.parse_infer_type()
        this.parse_postfix_type_in_context()
    }

    procedure parse_postfix_type_in_context(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowConditionalTypesContext, false)
        let result this.parse_postfix_type_or_higher()
        set context_flags: saved
        result
    }

    ; The reference's TypeOperatorNode stores WHICH operator; see faithfulness
    ; note (1) — nothing reads it yet and the dump cannot see it.
    procedure parse_type_operator(this, op: int) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(op) = false
            return null
        let inner this.parse_type_operator_or_higher()
        if inner = null
            return null
        this.finish_node(this.new_node(KindTypeOperator, NodeData.TypeOperator(WrappedTypeData(inner))), pos)
    }

    procedure parse_infer_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindInferKeyword) = false
            return null
        let tp this.parse_type_parameter_of_infer_type()
        if tp = null
            return null
        this.finish_node(this.new_node(KindInferType, NodeData.InferType(WrappedTypeData(tp))), pos)
    }

    procedure parse_type_parameter_of_infer_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let name this.parse_identifier()
        if name = null
            return null
        let constraint this.try_parse_constraint_of_infer_type()
        if this.is_unported()
            return null
        this.finish_node(this.new_node(KindTypeParameter, NodeData.TypeParameter(TypeParameterData(null, name, constraint, null, null))), pos)
    }

    ; `infer T extends U` is a constraint — unless a `?` follows, in which case
    ; the `extends` belonged to an enclosing conditional type and the whole
    ; speculation is rewound.
    procedure try_parse_constraint_of_infer_type(this) returns pointer[AstNode]
    {
        let saved this.mark()
        if this.parse_optional(KindExtendsKeyword)
        {
            let constraint this.parse_type_in_context(NodeFlagsDisallowConditionalTypesContext, true)
            if constraint = null
                return null
            if this.in_disallow_conditional_types_context()
                return constraint
            if token <> KindQuestionToken
                return constraint
        }
        ; The reference PARSED a type here and is throwing it away, diagnostics
        ; included — which is what the rewind does now. See ParserState.
        this.rewind(saved)
        null
    }

    ; ── postfix ─────────────────────────────────────────────────────────────

    procedure parse_postfix_type_or_higher(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var type_node this.parse_non_array_type()
        if type_node = null
            return null

        while this.has_preceding_line_break() = false
        {
            if token = KindExclamationToken
            {
                this.next_token()
                set type_node: this.finish_node(this.new_node(KindJSDocNonNullableType, NodeData.JSDocNonNullableType(WrappedTypeData(type_node))), pos)
                continue
            }

            if token = KindQuestionToken
            {
                ; `T ? X : Y` — the `?` opens a conditional type's true branch
                ; and does NOT make T nullable. A type following it is what
                ; tells the two apart, and it is the whole reason this arm looks
                ; ahead instead of testing a token.
                if this.look_ahead_next_is_start_of_type()
                    return type_node
                this.next_token()
                set type_node: this.finish_node(this.new_node(KindJSDocNullableType, NodeData.JSDocNullableType(WrappedTypeData(type_node))), pos)
                continue
            }

            if token = KindOpenBracketToken
            {
                if this.parse_expected(KindOpenBracketToken) = false
                    return null
                if this.is_start_of_type(false)
                {
                    let index_type this.parse_type()
                    if index_type = null
                        return null
                    if this.parse_expected(KindCloseBracketToken) = false
                        return null
                    set type_node: this.finish_node(this.new_node(KindIndexedAccessType, NodeData.IndexedAccessType(IndexedAccessTypeData(type_node, index_type))), pos)
                    continue
                }
                if this.parse_expected(KindCloseBracketToken) = false
                    return null
                set type_node: this.finish_node(this.new_node(KindArrayType, NodeData.ArrayType(WrappedTypeData(type_node))), pos)
                continue
            }

            return type_node
        }
        type_node
    }

    ; ── the leaves ──────────────────────────────────────────────────────────

    procedure parse_non_array_type(this) returns pointer[AstNode]
    {
        if keyword_type_start(token)
        {
            ; A keyword type followed by a dot is a dotted type REFERENCE
            ; (`string.Foo`), so the keyword is parsed and, on seeing the dot,
            ; put back.
            let saved this.mark()
            let kw this.parse_keyword_type_node()
            if token <> KindDotToken
                return kw
            this.rewind(saved)
            return this.parse_type_reference()
        }

        ; The JSDoc PREFIX forms. `*=` and `??` additionally need a re-scan
        ; entry point the scanner does not have yet.
        if token = KindAsteriskEqualsToken
            return this.unported("jsdoc-all-type", token)
        if token = KindAsteriskToken
            return this.unported("jsdoc-all-type", token)
        if token = KindQuestionQuestionToken
            return this.unported("jsdoc-nullable-type", token)
        if token = KindQuestionToken
            return this.parse_jsdoc_nullable_type()
        if token = KindExclamationToken
            return this.parse_jsdoc_non_nullable_type()

        if literal_type_start(token)
            return this.parse_literal_type_node(false)

        if token = KindMinusToken
        {
            if this.look_ahead_next_token_is_numeric_or_bigint_literal()
                return this.parse_literal_type_node(true)
            return this.parse_type_reference()
        }

        ; `void` is a keyword type with no dotted fallback — there is no
        ; `void.Foo`.
        if token = KindVoidKeyword
            return this.parse_keyword_type_node()

        if token = KindThisKeyword
        {
            let this_keyword this.parse_this_type_node()
            if this_keyword = null
                return null
            if token = KindIsKeyword
            {
                if this.has_preceding_line_break() = false
                    return this.parse_this_type_predicate(this_keyword)
            }
            return this_keyword
        }

        if token = KindTypeOfKeyword
        {
            if this.look_ahead_next_is_start_of_type_of_import_type()
                return this.unported("import-type", token)
            return this.parse_type_query()
        }

        ; `{` opens an object type literal or a mapped type. Both are unported
        ; and they share the tag: telling them apart costs a look-ahead whose
        ; answer changes nothing here, and the histogram entry would be split
        ; between two constructs that are one slice.
        if token = KindOpenBraceToken
            return this.unported("type-literal", token)

        if token = KindOpenBracketToken
            return this.parse_tuple_type()
        if token = KindOpenParenToken
            return this.parse_parenthesized_type()
        if token = KindImportKeyword
            return this.unported("import-type", token)

        if token = KindAssertsKeyword
        {
            if this.look_ahead_next_token_is_identifier_or_keyword_on_same_line()
                return this.parse_asserts_type_predicate()
            return this.parse_type_reference()
        }

        if token = KindTemplateHead
            return this.unported("template-literal-type", token)

        this.parse_type_reference()
    }

    ; The ten keyword types that fall back to a dotted type reference. `void` is
    ; deliberately not among them — see parse_non_array_type.
    function keyword_type_start(k: int) returns bool
    {
        if k = KindAnyKeyword
            return true
        if k = KindUnknownKeyword
            return true
        if k = KindStringKeyword
            return true
        if k = KindNumberKeyword
            return true
        if k = KindBigIntKeyword
            return true
        if k = KindSymbolKeyword
            return true
        if k = KindBooleanKeyword
            return true
        if k = KindUndefinedKeyword
            return true
        if k = KindNeverKeyword
            return true
        k = KindObjectKeyword
    }

    function literal_type_start(k: int) returns bool
    {
        if k = KindNoSubstitutionTemplateLiteral
            return true
        if k = KindStringLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        k = KindNullKeyword
    }

    function keyword_literal(k: int) returns bool
    {
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        k = KindNullKeyword
    }

    ; parseKeywordTypeNode. Identical in shape to parseTokenNode — a keyword
    ; type is a node whose KIND is the keyword and which has no children, which
    ; is why ast.scaly gives it no record of its own — and kept under its own
    ; name because the reference has two and a reader looking at the type side
    ; should find it there.
    procedure parse_keyword_type_node(this) returns pointer[AstNode]
        this.parse_token_node()

    procedure parse_this_type_node(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        this.finish_node(this.new_node(KindThisType, NodeData.Token(TokenData())), pos)
    }

    ; `this is T`. The node starts where the `this` did, not at the `is`.
    procedure parse_this_type_predicate(this, lhs: pointer[AstNode]) returns pointer[AstNode]
    {
        this.next_token()
        let t this.parse_type()
        if t = null
            return null
        this.finish_node(this.new_node(KindTypePredicate, NodeData.TypePredicate(TypePredicateData(null, lhs, t))), AstNode.pos_of(lhs))
    }

    ; `asserts x`, `asserts x is T`, `asserts this is T`.
    procedure parse_asserts_type_predicate(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        ; parseExpectedToken. Its missing-token recovery cannot run: the
        ; look-ahead in parse_non_array_type is what routed us here, so the
        ; `asserts` is known present.
        let asserts_modifier this.parse_optional_token(KindAssertsKeyword)
        if asserts_modifier = null
            return this.unported("expected", KindAssertsKeyword)

        var parameter_name null as pointer[AstNode]
        if token = KindThisKeyword
            set parameter_name: this.parse_this_type_node()
        else
            set parameter_name: this.parse_identifier()
        if parameter_name = null
            return null

        var type_node null as pointer[AstNode]
        if this.parse_optional(KindIsKeyword)
        {
            set type_node: this.parse_type()
            if type_node = null
                return null
        }

        this.finish_node(this.new_node(KindTypePredicate, NodeData.TypePredicate(TypePredicateData(asserts_modifier, parameter_name, type_node))), pos)
    }

    procedure parse_jsdoc_nullable_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        let inner this.parse_type_operator_or_higher()
        if inner = null
            return null
        this.finish_node(this.new_node(KindJSDocNullableType, NodeData.JSDocNullableType(WrappedTypeData(inner))), pos)
    }

    procedure parse_jsdoc_non_nullable_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        this.next_token()
        let inner this.parse_type_operator_or_higher()
        if inner = null
            return null
        this.finish_node(this.new_node(KindJSDocNonNullableType, NodeData.JSDocNonNullableType(WrappedTypeData(inner))), pos)
    }

    ; A literal type wraps the literal EXPRESSION, so `-1` is three nodes deep:
    ; LiteralType > PrefixUnaryExpression > NumericLiteral, all three sharing
    ; the same start.
    procedure parse_literal_type_node(this, negative: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if negative
            this.next_token()

        var expression null as pointer[AstNode]
        if keyword_literal(token)
            set expression: this.parse_token_node()
        else
            set expression: this.parse_literal_expression(token)
        if expression = null
            return null

        if negative
            set expression: this.finish_node(this.new_node(KindPrefixUnaryExpression, NodeData.PrefixUnaryExpression(WrappedTypeData(expression))), pos)

        this.finish_node(this.new_node(KindLiteralType, NodeData.LiteralType(WrappedTypeData(expression))), pos)
    }

    ; ── type references and entity names ────────────────────────────────────

    procedure parse_type_reference(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let name this.parse_entity_name(true)
        if name = null
            return null
        let args this.parse_type_arguments_of_type_reference()
        if this.is_unported()
            return null
        this.finish_node(this.new_node(KindTypeReference, NodeData.TypeReference(TypeReferenceData(name, args))), pos)
    }

    procedure parse_entity_name(this, allow_reserved_words: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        var entity null as pointer[AstNode]
        if allow_reserved_words
            set entity: this.parse_identifier_name()
        else
            set entity: this.parse_identifier()
        if entity = null
            return null

        while this.parse_optional(KindDotToken)
        {
            ; `a.<T>` is a JSDoc-style generic. The reference leaves the dot
            ; consumed and stops here, reporting the gap in the checker.
            if token = KindLessThanToken
                break
            let right this.parse_right_side_of_dot(allow_reserved_words, false)
            if right = null
                return null
            set entity: this.finish_node(this.new_node(KindQualifiedName, NodeData.QualifiedName(QualifiedNameData(entity, right))), pos)
        }
        entity
    }

    procedure parse_right_side_of_dot(this, allow_identifier_names: bool, allow_private_identifiers: bool) returns pointer[AstNode]
    {
        ; The reference's ASI guard: `name.` at the end of a line followed by an
        ; identifier on the NEXT line is two statements, not one member access,
        ; so it reports Identifier_expected right after the dot and synthesizes
        ; a missing identifier. Diagnostic plus missing node — unported.
        if this.has_preceding_line_break()
        {
            if token_is_identifier_or_keyword(token)
            {
                if this.look_ahead_next_token_is_identifier_or_keyword_on_same_line()
                    return this.unported("missing-identifier", token)
            }
        }
        ; ★ The node is BUILT either way and only then refused — which matters,
        ; because the refusing arm also synthesizes a missing identifier, i.e. it
        ; is a diagnostic and therefore the port's edge. An entity name
        ; (`ns.#x` in a type) is the caller that says no.
        if token = KindPrivateIdentifier
        {
            let private_name this.parse_private_identifier()
            if allow_private_identifiers
                return private_name
            return this.unported("private-identifier", token)
        }
        ; ★ Only the identifier-NAME branch lets an `await` count. `a.await` is a
        ; use of the name and reaches the reparse; a dotted ENTITY name in a type
        ; does not, which is why the other branch puts the flag back.
        if allow_identifier_names
            return this.parse_identifier_name()
        let saved_await_identifier statement_has_await_identifier
        let id this.parse_identifier()
        set statement_has_await_identifier: saved_await_identifier
        id
    }

    ; ── type arguments ──────────────────────────────────────────────────────
    ;
    ; ★ The re-scan is what makes `Foo<<T>() => void>` parse at all: the scan
    ; merged the two `<` into one token, and only the parser knows it is reading
    ; a type. The CLOSING side needs no such thing — the scanner never merges
    ; `>`, precisely so `Array<Array<string>>` can close twice.

    procedure re_scan_less_than_token(this) returns int
    {
        set token: scanner.re_scan_less_than_token()
        token
    }

    ; The other direction, and the ladder's: the scan never merges `>`, so
    ; parseBinaryExpressionRest asks for `>=`, `>>`, `>>>`, `>>=` and `>>>=`
    ; before EVERY operator test. See the scanner's own comment for why the
    ; asymmetry is deliberate.
    procedure re_scan_greater_than_token(this) returns int
    {
        set token: scanner.re_scan_greater_than_token()
        token
    }

    procedure parse_type_arguments_of_type_reference(this) returns pointer[Array[pointer[AstNode]]]
    {
        if this.has_preceding_line_break()
            return null
        if this.re_scan_less_than_token() <> KindLessThanToken
            return null
        this.parse_type_arguments()
    }

    procedure parse_type_arguments(this) returns pointer[Array[pointer[AstNode]]]
    {
        if token <> KindLessThanToken
            return null
        this.parse_bracketed_list(PCTypeArguments, KindLessThanToken, KindGreaterThanToken)
    }

    procedure parse_type_query(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindTypeOfKeyword) = false
            return null
        let entity_name this.parse_entity_name(true)
        if entity_name = null
            return null

        ; ASI, so the NEXT line's `<` cannot be read as this query's type
        ; arguments.
        var type_arguments null as pointer[Array[pointer[AstNode]]]
        if this.has_preceding_line_break() = false
        {
            set type_arguments: this.parse_type_arguments()
            if this.is_unported()
                return null
        }

        this.finish_node(this.new_node(KindTypeQuery, NodeData.TypeQuery(TypeQueryData(entity_name, type_arguments))), pos)
    }

    ; ── tuples ──────────────────────────────────────────────────────────────

    procedure parse_tuple_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let elements this.parse_bracketed_list(PCTupleElementTypes, KindOpenBracketToken, KindCloseBracketToken)
        if elements = null
            return null
        this.finish_node(this.new_node(KindTupleType, NodeData.TupleType(TypeListData(elements))), pos)
    }

    procedure parse_tuple_element_name_or_tuple_element_type(this) returns pointer[AstNode]
    {
        if this.look_ahead_scan_start_of_named_tuple_element()
        {
            let pos this.node_pos()
            let jsdoc this.jsdoc_scanner_info()
            let dot_dot_dot_token this.parse_optional_token(KindDotDotDotToken)
            let name this.parse_identifier_name()
            if name = null
                return null
            let question_token this.parse_optional_token(KindQuestionToken)
            if this.parse_expected(KindColonToken) = false
                return null
            let type_node this.parse_tuple_element_type()
            if type_node = null
                return null
            let result this.finish_node(this.new_node(KindNamedTupleMember, NodeData.NamedTupleMember(NamedTupleMemberData(dot_dot_dot_token, name, question_token, type_node))), pos)
            return this.with_jsdoc(result, jsdoc)
        }
        this.parse_tuple_element_type()
    }

    procedure scan_start_of_named_tuple_element(this) returns bool
    {
        if token = KindDotDotDotToken
        {
            if token_is_identifier_or_keyword(this.next_token()) = false
                return false
            return this.next_token_is_colon_or_question_colon()
        }
        if token_is_identifier_or_keyword(token) = false
            return false
        this.next_token_is_colon_or_question_colon()
    }

    procedure next_token_is_colon_or_question_colon(this) returns bool
    {
        if this.next_token() = KindColonToken
            return true
        if token <> KindQuestionToken
            return false
        this.next_token() = KindColonToken
    }

    procedure parse_tuple_element_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_optional(KindDotDotDotToken)
        {
            let rest this.parse_type()
            if rest = null
                return null
            return this.finish_node(this.new_node(KindRestType, NodeData.RestType(WrappedTypeData(rest))), pos)
        }

        let type_node this.parse_type()
        if type_node = null
            return null

        ; `[T?]`. The postfix `?` already built a JSDocNullableType, and what
        ; distinguishes the tuple's optional element from the JSDoc PREFIX form
        ; is where the node starts: a suffix `?` leaves the wrapper starting at
        ; its inner type, a prefix `?` starts one token earlier. The node is
        ; rebuilt rather than retagged, carrying flags and range over — exactly
        ; what the reference does.
        if AstNode.kind_of(type_node) <> KindJSDocNullableType
            return type_node
        let inner AstNode.child_at(type_node, 0)
        if inner = null
            return type_node
        if AstNode.pos_of(type_node) <> AstNode.pos_of(inner)
            return type_node

        let n this.new_node(KindOptionalType, NodeData.OptionalType(WrappedTypeData(inner)))
        set n.flags: type_node.flags
        set n.pos: type_node.pos
        set n.end: type_node.end
        n
    }

    procedure parse_parenthesized_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        if this.parse_expected(KindOpenParenToken) = false
            return null
        let inner this.parse_type()
        if inner = null
            return null
        if this.parse_expected(KindCloseParenToken) = false
            return null
        this.finish_node(this.new_node(KindParenthesizedType, NodeData.ParenthesizedType(WrappedTypeData(inner))), pos)
    }

    ; ── type parameters ─────────────────────────────────────────────────────

    procedure parse_type_parameters(this) returns pointer[Array[pointer[AstNode]]]
    {
        if token <> KindLessThanToken
            return null
        this.parse_bracketed_list(PCTypeParameters, KindLessThanToken, KindGreaterThanToken)
    }

    procedure parse_type_parameter(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let modifiers this.parse_modifiers(false, true, false)
        if this.is_unported()
            return null
        let name this.parse_identifier()
        if name = null
            return null

        var constraint null as pointer[AstNode]
        if this.parse_optional(KindExtendsKeyword)
        {
            ; The reference recovers from a constraint written as an EXPRESSION
            ; (`<T extends "">`) by parsing one and reporting that a type was
            ; expected. That needs the expression ladder AND a diagnostic, so it
            ; is unported — and the test is inverted here on purpose: the
            ; reference also takes the TYPE path when the text starts neither a
            ; type nor an expression, so stopping on "does not start a type"
            ; over-reports and never under-reports.
            if this.is_start_of_type(false) = false
                return this.unported("type-parameter-constraint-expression", token)
            set constraint: this.parse_type()
            if constraint = null
                return null
        }

        var default_type null as pointer[AstNode]
        if this.parse_optional(KindEqualsToken)
        {
            set default_type: this.parse_type()
            if default_type = null
                return null
        }

        this.finish_node(this.new_node(KindTypeParameter, NodeData.TypeParameter(TypeParameterData(modifiers, name, constraint, null, default_type))), pos)
    }

    ; ── the declaration ─────────────────────────────────────────────────────

    procedure parse_type_alias_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        if this.parse_expected(KindTypeKeyword) = false
            return null
        ; The reference reports Line_break_not_permitted_here and CONTINUES, so
        ; the tree is the same and only the diagnostic differs — which is
        ; exactly the case this port must not paper over.
        if this.has_preceding_line_break()
            return this.unported("line-break-after-type", token)

        let name this.parse_identifier()
        if name = null
            return null
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        if this.parse_expected(KindEqualsToken) = false
            return null

        ; `type X = intrinsic` is a keyword type; `type X = intrinsic.Y` is an
        ; ordinary reference to something named `intrinsic`.
        var type_node null as pointer[AstNode]
        if token = KindIntrinsicKeyword
        {
            if this.look_ahead_next_is_not_dot()
                set type_node: this.parse_keyword_type_node()
        }
        if type_node = null
            set type_node: this.parse_type()
        if type_node = null
            return null

        if this.parse_semicolon() = false
            return null

        let result this.finish_node(this.new_node(KindTypeAliasDeclaration, NodeData.TypeAliasDeclaration(TypeAliasDeclarationData(modifiers, name, type_parameters, type_node))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; ════════════════════════════════════════════════════════════════════════
    ; SIGNATURES — parser slice 4
    ; ════════════════════════════════════════════════════════════════════════
    ;
    ; parseParameters and everything that cannot exist without it. The slice was
    ; chosen off the unported histogram, and by the same DEPENDENCY argument that
    ; chose the type surface before it: `function` was the largest single entry,
    ; but the thing five of those entries are actually waiting on is the
    ; parameter list — a function declaration, a function TYPE, a constructor
    ; type, a method signature and a call signature all call parseParameters, and
    ; only one of them has the word "function" in its tag.
    ;
    ; ── What is here ────────────────────────────────────────────────────────
    ;
    ;   parseParameters / parseParametersWorker / parseParameterEx
    ;   parseNameOfParameter
    ;   parseReturnType / shouldParseReturnType / parseTypeOrTypePredicate
    ;   parseFunctionDeclaration
    ;   parseFunctionBlockOrSemicolon / parseFunctionBlock
    ;   parseFunctionOrConstructorType / parseModifiersForConstructorType
    ;
    ; ── and what is deliberately not, each with its reason ──────────────────
    ;
    ; ★ `allowAmbiguity`. parseParametersWorker takes it, and every call this
    ;   slice can reach passes TRUE — the only `false` comes from the arrow
    ;   function's speculative re-parse, which is unported. The parameter is left
    ;   out rather than carried: its arm answers a NULL parameter mid-list, which
    ;   this port's list loop reads as failure, so porting it untested would put
    ;   a wrong reading of null into the one place it cannot be noticed.
    ;
    ; ★ The ParseFlagsType arm of parseFunctionBlockOrSemicolon (a signature in a
    ;   type literal, terminated by a comma) — its callers are parseTypeMember
    ;   and the accessor, both of which are the interface-member slice.
    ;
    ; ★ checkJSSyntax, which the reference calls on every parameter and on the
    ;   function declaration. It returns immediately unless the node carries
    ;   NodeFlagsJavaScriptFile, and this port never sets that flag (the corpus is
    ;   .ts and the file name decides). So it is not skipped work — it is work
    ;   that provably does nothing here, and a port of it would be a body that
    ;   cannot be reached.

    ; ── parameters ──────────────────────────────────────────────────────────

    procedure parse_parameters(this, flags: int) returns pointer[Array[pointer[AstNode]]]
    {
        ; The reference answers createMissingList() when the `(` is missing; that
        ; is preceded by a diagnostic, so it is the unported edge here.
        if this.parse_expected(KindOpenParenToken) = false
            return null
        let parameters this.parse_parameters_worker(flags, true)
        if parameters = null
            return null
        if this.parse_expected(KindCloseParenToken) = false
            return null
        parameters
    }

    procedure parse_parameters_worker(this, flags: int, allow_ambiguity: bool) returns pointer[Array[pointer[AstNode]]]
    {
        ; Captured BEFORE the flags move — this is the context the parameter's
        ; decorators belong to. See the field's comment for why it travels as
        ; state rather than in a closure. `allow_ambiguity` rides along for the
        ; same reason.
        let saved_outer parameter_outer_await_context
        let saved_ambiguity parameter_allow_ambiguity
        set parameter_outer_await_context: this.in_await_context()
        set parameter_allow_ambiguity: allow_ambiguity

        let saved context_flags
        this.set_context_flags(NodeFlagsYieldContext, (flags & ParseFlagsYield) <> 0)
        this.set_context_flags(NodeFlagsAwaitContext, (flags & ParseFlagsAwait) <> 0)
        let parameters this.parse_delimited_list(PCParameters)
        set context_flags: saved
        set parameter_outer_await_context: saved_outer
        set parameter_allow_ambiguity: saved_ambiguity
        parameters
    }

    procedure parse_parameter_ex(this, in_outer_await_context: bool, allow_ambiguity: bool) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()

        let saved context_flags
        this.set_context_flags(NodeFlagsAwaitContext, in_outer_await_context)
        let modifiers this.parse_modifiers(true, false, false)
        set context_flags: saved
        if this.is_unported()
            return null

        ; A `this` parameter. It takes no dot-dot-dot, no `?` and no initializer,
        ; and its name is built through createIdentifier directly — `this` is a
        ; reserved word, so parse_identifier would refuse it.
        if token = KindThisKeyword
        {
            let this_name this.create_identifier(true)
            if this_name = null
                return null

            var this_type null as pointer[AstNode]
            if token = KindColonToken
            {
                set this_type: this.parse_type_annotation()
                if this_type = null
                    return null
            }

            ; The reference reports Neither_decorators_nor_modifiers_may_be_applied_to_this_parameters
            ; and builds the node anyway, so the tree is the same and only the
            ; diagnostic differs — which is the case this port must not paper
            ; over.
            if modifiers <> null
                return this.unported("this-parameter-modifiers", token)

            let this_result this.finish_node(this.new_node(KindParameter, NodeData.Parameter(ParameterData(modifiers, null, this_name, null, this_type, null))), pos)
            return this.with_jsdoc(this_result, jsdoc)
        }

        let dot_dot_dot_token this.parse_optional_token(KindDotDotDotToken)
        if this.is_unported()
            return null

        ; ★ The speculative half of an arrow-function parse. Answering NULL here
        ; is not a failure — it is "this text is not a parameter list", and the
        ; caller rewinds. It is the only path on which a null element of a
        ; delimited list means something other than "the port stopped", which is
        ; why parse_parenthesized_arrow_function_expression is careful to
        ; distinguish the two by is_unported() rather than by the result.
        if allow_ambiguity = false
        {
            if this.is_parameter_name_start() = false
                return null
        }

        let name this.parse_name_of_parameter(modifiers)
        if name = null
            return null

        let question_token this.parse_optional_token(KindQuestionToken)
        if this.is_unported()
            return null

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }

        var initializer null as pointer[AstNode]
        if this.parse_optional(KindEqualsToken)
        {
            set initializer: this.parse_assignment_expression_or_higher()
            if initializer = null
                return null
        }

        let result this.finish_node(this.new_node(KindParameter, NodeData.Parameter(ParameterData(modifiers, dot_dot_dot_token, name, question_token, type_node, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; isParameterNameStart. The reference is deliberately permissive here —
    ; isBindingIdentifier rather than isIdentifier — because refusing `await` or
    ; `yield` during a speculative parse produces far more follow-on errors than
    ; letting the function parse and complaining later.
    function is_parameter_name_start(this) returns bool
    {
        if this.is_binding_identifier()
            return true
        if token = KindOpenBracketToken
            return true
        token = KindOpenBraceToken
    }

    procedure parse_name_of_parameter(this, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        ; parseIdentifierOrPattern: `[` and `{` start a binding pattern.
        if token = KindOpenBracketToken
            return this.unported("binding-pattern", token)
        if token = KindOpenBraceToken
            return this.unported("binding-pattern", token)

        ; The reference follows this with a recovery arm for a name that came
        ; back MISSING (zero-width) while the token is still a modifier keyword —
        ; `function foo(static)` in strict mode — where it advances one token so
        ; the enclosing list cannot spin forever. A missing name is a diagnostic
        ; and therefore already unported, so the arm cannot be reached from here;
        ; note that its PURPOSE, not looping, is served instead by
        ; parse_binding_identifier reporting and the list aborting.
        this.parse_binding_identifier()
    }

    ; ── the return type ─────────────────────────────────────────────────────

    procedure parse_return_type(this, return_token: int, is_type: bool) returns pointer[AstNode]
    {
        if this.should_parse_return_type(return_token, is_type) = false
            return null
        ; doInContext(DisallowConditionalTypes, false, parseTypeOrTypePredicate).
        let saved context_flags
        this.set_context_flags(NodeFlagsDisallowConditionalTypesContext, false)
        let result this.parse_type_or_type_predicate()
        set context_flags: saved
        result
    }

    procedure should_parse_return_type(this, return_token: int, is_type: bool) returns bool
    {
        if return_token = KindEqualsGreaterThanToken
        {
            if this.parse_expected(return_token) = false
                return false
            return true
        }
        if this.parse_optional(KindColonToken)
            return true
        ; The reference's third arm: `is_type` and a `=>` where a `:` was meant.
        ; It reports "':' expected", consumes the arrow and parses the type
        ; anyway — a diagnostic, hence unported. Both callers in this slice pass
        ; is_type FALSE, so the arm is unreachable today; it is written out
        ; rather than omitted because the next caller (a method signature) is the
        ; one that passes true, and a silent `false` here would send it down the
        ; no-return-type path.
        if is_type
        {
            if token = KindEqualsGreaterThanToken
                return this.unported_bool("return-type-arrow")
        }
        false
    }

    ; `x is T` — a type predicate on a plain parameter name. `this is T` has its
    ; own entry point in the type parser, since `this` is not an identifier.
    procedure parse_type_or_type_predicate(this) returns pointer[AstNode]
    {
        if this.is_identifier()
        {
            let saved this.mark()
            let pos this.node_pos()
            let id this.parse_identifier()
            if id = null
                return null
            if token = KindIsKeyword
            {
                if this.has_preceding_line_break() = false
                {
                    this.next_token()
                    let t this.parse_type()
                    if t = null
                        return null
                    return this.finish_node(this.new_node(KindTypePredicate, NodeData.TypePredicate(TypePredicateData(null, id, t))), pos)
                }
            }
            this.rewind(saved)
        }
        this.parse_type()
    }

    ; ── the function declaration ────────────────────────────────────────────
    ;
    ; ★ context_flags is saved once and restored at the SINGLE exit, exactly as
    ; the reference does. Every early return between the two is an unported
    ; bail-out — each of the calls there answers null only after reporting — and
    ; the parse is over at that point, so there is nothing left to restore for.

    procedure parse_function_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        if this.parse_expected(KindFunctionKeyword) = false
            return null

        let asterisk_token this.parse_optional_token(KindAsteriskToken)
        if this.is_unported()
            return null

        ; `export default function () {}` is the one form with no name. The
        ; reference reads ModifierFlagsDefault off the precomputed flag set; the
        ; list is asked directly here (see has_modifier).
        var want_name true
        if has_modifier(modifiers, KindDefaultKeyword)
        {
            if this.is_binding_identifier() = false
                set want_name: false
        }
        var name null as pointer[AstNode]
        if want_name
        {
            set name: this.parse_binding_identifier()
            if name = null
                return null
        }

        ; The signature flags decide the yield/await context the PARAMETERS and
        ; the BODY are parsed in, which is what makes `yield` a name in one
        ; function and a keyword in the next.
        var signature_flags ParseFlagsNone
        if asterisk_token <> null
            set signature_flags: signature_flags | ParseFlagsYield
        if has_modifier(modifiers, KindAsyncKeyword)
            set signature_flags: signature_flags | ParseFlagsAwait

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null

        let saved context_flags
        if has_modifier(modifiers, KindExportKeyword)
            this.set_context_flags(NodeFlagsAwaitContext, true)

        let parameters this.parse_parameters(signature_flags)
        if parameters = null
            return null

        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        ; NULL here is a legitimate answer — an overload signature has no body —
        ; so the test is is_unported(), not the result. Same shape as the
        ; optional type-parameter list above.
        let body this.parse_function_block_or_semicolon(signature_flags)
        set context_flags: saved
        if this.is_unported()
            return null

        let result this.finish_node(this.new_node(KindFunctionDeclaration, NodeData.FunctionDeclaration(FunctionDeclarationData(modifiers, asterisk_token, name, type_parameters, parameters, return_type, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; Answers the body, or null for a body-less overload signature. See above.
    procedure parse_function_block_or_semicolon(this, flags: int) returns pointer[AstNode]
    {
        if token <> KindOpenBraceToken
        {
            if this.can_parse_semicolon()
            {
                this.parse_semicolon()
                return null
            }
        }
        this.parse_function_block(flags)
    }

    procedure parse_function_block(this, flags: int) returns pointer[AstNode]
    {
        let saved context_flags
        ; An `await` used as a name INSIDE a function body says nothing about the
        ; enclosing top-level statement, so the flag is put back on the way out.
        let saved_await_identifier statement_has_await_identifier
        this.set_context_flags(NodeFlagsYieldContext, (flags & ParseFlagsYield) <> 0)
        this.set_context_flags(NodeFlagsAwaitContext, (flags & ParseFlagsAwait) <> 0)
        ; A function expression or arrow function may itself be parsed in a
        ; decorator context; its BODY never is.
        this.set_context_flags(NodeFlagsDecoratorContext, false)
        let block this.parse_block()
        set context_flags: saved
        set statement_has_await_identifier: saved_await_identifier
        block
    }

    ; ── the function and constructor TYPES ──────────────────────────────────

    procedure parse_function_or_constructor_type(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()
        let modifiers this.parse_modifiers_for_constructor_type()
        if this.is_unported()
            return null
        ; The reference asserts that modifiers imply a constructor type; the
        ; assertion holds by construction, since the only modifier accepted above
        ; is `abstract` and isStartOfFunctionOrConstructorType only admits it
        ; when `new` follows.
        let is_constructor_type this.parse_optional(KindNewKeyword)

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(ParseFlagsType)
        if parameters = null
            return null
        let return_type this.parse_return_type(KindEqualsGreaterThanToken, false)
        if return_type = null
            return null

        var result null as pointer[AstNode]
        if is_constructor_type
            set result: this.new_node(KindConstructorType, NodeData.ConstructorType(ConstructorTypeData(modifiers, type_parameters, parameters, return_type)))
        else
            set result: this.new_node(KindFunctionType, NodeData.FunctionType(FunctionTypeData(type_parameters, parameters, return_type)))

        this.with_jsdoc(this.finish_node(result, pos), jsdoc)
    }

    procedure parse_modifiers_for_constructor_type(this) returns pointer[Array[pointer[AstNode]]]
    {
        if token <> KindAbstractKeyword
            return null
        let pos this.node_pos()
        let kind token
        this.next_token()
        let m this.finish_node(this.new_node(kind, NodeData.Token(TokenData())), pos)
        if m = null
            return null
        let list AstNode.new_node_list(host)
        list.add(m)
        list
    }

    ; ════ CLASSES (parser slice 6) ══════════════════════════════════════════
    ;
    ; The class DECLARATION, the class EXPRESSION, the heritage clauses and the
    ; six member forms — method, property, constructor, get/set accessor, static
    ; block, index signature. Three of those entry points are shared with the
    ; object literal, which is why `{ get x() {} }` and `{ m() {} }` land with
    ; this slice too and not with the ladder that reaches them.
    ;
    ; ★ The reference's checkJSSyntax calls are omitted throughout, and the
    ; omission is total rather than partial: every one of them is guarded by
    ; NodeFlagsJavaScriptFile, which is set from the file's EXTENSION, and every
    ; case in this corpus is `.ts`. When a `.js` case first appears the guard —
    ; not the calls — is what has to be ported first, so writing the calls now
    ; would be writing code no test can reach and no reader can check.

    procedure parse_class_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
        this.parse_class_declaration_or_expression(pos, jsdoc, modifiers, KindClassDeclaration)

    ; A class EXPRESSION never carries modifiers: it is reached from
    ; parsePrimaryExpression, where nothing has parsed any.
    procedure parse_class_expression(this) returns pointer[AstNode]
        this.parse_class_declaration_or_expression(this.node_pos(), this.jsdoc_scanner_info(), null, KindClassExpression)

    procedure parse_class_declaration_or_expression(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], kind: int) returns pointer[AstNode]
    {
        let saved context_flags
        let saved_await_identifier statement_has_await_identifier

        if this.parse_expected(KindClassKeyword) = false
            return null

        ; The name is read BEFORE the export modifier's await context is
        ; established, and deliberately so: the reference lets `class await {}`
        ; parse and reports the grammar error in the checker.
        let name this.parse_name_of_class_declaration_or_expression()
        if this.is_unported()
            return null

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null

        if has_modifier(modifiers, KindExportKeyword)
            this.set_context_flags(NodeFlagsAwaitContext, true)

        let heritage_clauses this.parse_heritage_clauses()
        if this.is_unported()
            return null

        ; A missing `{` is a diagnostic — the reference synthesizes an empty
        ; member list and carries on — so it is where this port stops.
        if this.parse_expected(KindOpenBraceToken) = false
            return null
        let members this.parse_list(PCClassMembers)
        if members = null
            return null
        if this.parse_expected(KindCloseBraceToken) = false
            return null

        set context_flags: saved

        ; ★ An `await` used as a name inside an AMBIENT class body says nothing
        ; about the enclosing top-level statement, so the flag is put back — the
        ; same shape parse_function_block uses for a function body, and one more
        ; of the sites §3.5l names.
        if has_modifier(modifiers, KindDeclareKeyword)
            set statement_has_await_identifier: saved_await_identifier

        var result null as pointer[AstNode]
        if kind = KindClassDeclaration
            set result: this.new_node(KindClassDeclaration, NodeData.ClassDeclaration(ClassLikeData(modifiers, name, type_parameters, heritage_clauses, members)))
        else
            set result: this.new_node(KindClassExpression, NodeData.ClassExpression(ClassLikeData(modifiers, name, type_parameters, heritage_clauses, members)))

        this.with_jsdoc(this.finish_node(result, pos), jsdoc)
    }

    ; ★ `implements` is a FUTURE RESERVED WORD, not a keyword, so `class
    ; implements {}` is genuinely ambiguous: a class NAMED `implements`, or an
    ; anonymous class whose heritage clause starts right here. Only what follows
    ; the word separates them, which is why this is a look-ahead and not a token
    ; test. A null answer is the legitimate "this class has no name".
    procedure parse_name_of_class_declaration_or_expression(this) returns pointer[AstNode]
    {
        if this.is_binding_identifier()
        {
            if this.is_implements_clause() = false
            {
                ; create_identifier records `await` used as a name; a class NAME
                ; is a declaration rather than a use, so the record is put back.
                let saved_await_identifier statement_has_await_identifier
                let id this.create_identifier(true)
                set statement_has_await_identifier: saved_await_identifier
                return id
            }
        }
        null
    }

    procedure is_implements_clause(this) returns bool
    {
        if token <> KindImplementsKeyword
            return false
        this.look_ahead_next_token_is_identifier_or_keyword()
    }

    ; ── the heritage clauses ────────────────────────────────────────────────

    procedure parse_heritage_clauses(this) returns pointer[Array[pointer[AstNode]]]
    {
        if this.is_heritage_clause() = false
            return null
        this.parse_list(PCHeritageClauses)
    }

    function is_heritage_clause(this) returns bool
    {
        if token = KindExtendsKeyword
            return true
        token = KindImplementsKeyword
    }

    procedure parse_heritage_clause(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        ; The keyword is a FIELD of the clause, not a child — see the record.
        let clause_token token
        this.next_token()
        let types this.parse_delimited_list(PCHeritageClauseElement)
        if types = null
            return null
        this.finish_node(this.new_node(KindHeritageClause, NodeData.HeritageClause(HeritageClauseData(clause_token, types))), pos)
    }

    procedure parse_expression_with_type_arguments(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let expression this.parse_left_hand_side_expression_or_higher()
        if expression = null
            return null
        ; The ladder already folds `Base<T>` into an ExpressionWithTypeArguments
        ; on its way up; the reference hands that back rather than wrapping it a
        ; second time.
        if AstNode.kind_of(expression) = KindExpressionWithTypeArguments
            return expression
        let type_arguments this.parse_type_arguments()
        if this.is_unported()
            return null
        this.finish_node(this.new_node(KindExpressionWithTypeArguments, NodeData.ExpressionWithTypeArguments(ExpressionWithTypeArgumentsData(expression, type_arguments))), pos)
    }

    ; `extends` / `implements` followed by something that can START an
    ; expression is a NEW clause, not an element of the one being read — which
    ; is what stops `extends A implements B` from parsing `implements` as a base
    ; type named `implements`.
    procedure is_heritage_clause_extends_or_implements_keyword(this) returns bool
    {
        if this.is_heritage_clause() = false
            return false
        this.look_ahead_next_is_start_of_expression()
    }

    procedure next_is_start_of_expression(this) returns bool
    {
        this.next_token()
        this.is_start_of_expression()
    }

    procedure look_ahead_next_is_start_of_expression(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_start_of_expression()
        this.rewind(saved)
        r
    }

    ; `extends {}` — an object TYPE would be a strange base, so the reference
    ; only takes it as one when what follows says the class body has not started
    ; yet.
    procedure is_valid_heritage_clause_object_literal(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_valid_heritage_clause_object_literal()
        this.rewind(saved)
        r
    }

    procedure next_is_valid_heritage_clause_object_literal(this) returns bool
    {
        this.next_token()
        if token <> KindCloseBraceToken
            return true
        this.next_token()
        if token = KindCommaToken
            return true
        if token = KindOpenBraceToken
            return true
        if token = KindExtendsKeyword
            return true
        token = KindImplementsKeyword
    }

    ; ── the class members ───────────────────────────────────────────────────

    procedure parse_class_element(this) returns pointer[AstNode]
    {
        let pos this.node_pos()
        let jsdoc this.jsdoc_scanner_info()

        ; A stray `;` between members is an element in its own right — ES6 says
        ; so — and it carries nothing but its kind, which is why it is a Token
        ; node (see the ast header).
        if token = KindSemicolonToken
        {
            this.next_token()
            let semi this.finish_node(this.new_node(KindSemicolonClassElement, NodeData.Token(TokenData())), pos)
            return this.with_jsdoc(semi, jsdoc)
        }

        let modifiers this.parse_modifiers(true, true, true)
        if this.is_unported()
            return null

        ; `static { … }` — the static initialization block. try_parse_modifier
        ; refuses to consume `static` in front of a `{` for exactly this test,
        ; which is what its stop_on_start_of_class_static_block flag is.
        if token = KindStaticKeyword
        {
            if this.look_ahead_next_token_is_open_brace()
                return this.parse_class_static_block_declaration(pos, jsdoc, modifiers)
        }

        if this.parse_contextual_modifier(KindGetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindGetAccessor, ParseFlagsNone)
        if this.parse_contextual_modifier(KindSetKeyword)
            return this.parse_accessor_declaration(pos, jsdoc, modifiers, KindSetAccessor, ParseFlagsNone)

        var maybe_constructor false
        if token = KindConstructorKeyword
            set maybe_constructor: true
        if token = KindStringLiteral
            set maybe_constructor: true
        if maybe_constructor
        {
            let ctor this.try_parse_constructor_declaration(pos, jsdoc, modifiers)
            if ctor <> null
                return ctor
            if this.is_unported()
                return null
        }

        ; ★ Asked AFTER the constructor attempt and BEFORE the name, because `[`
        ; starts an index signature AND a computed property name and only the
        ; look-ahead separates them. The reference notes the ordering at this
        ; exact line; it is not incidental.
        if this.is_index_signature()
            return this.parse_index_signature_declaration(pos, jsdoc, modifiers)
        if this.is_unported()
            return null

        if class_element_name_start(token)
        {
            ; `declare` makes the member ambient, and the flag reaches the
            ; modifier NODES too — they were finished before the context flag was
            ; set. Same shape as parse_declaration's.
            if has_modifier(modifiers, KindDeclareKeyword)
            {
                let len modifiers.get_length() as int
                var i 0
                while i < len
                {
                    let m *(modifiers.get_buffer() + i)
                    set m.flags: m.flags | NodeFlagsAmbient
                    set i: i + 1
                }
                let saved context_flags
                set context_flags: context_flags | NodeFlagsAmbient
                let ambient this.parse_property_or_method_declaration(pos, jsdoc, modifiers)
                set context_flags: saved
                return ambient
            }
            return this.parse_property_or_method_declaration(pos, jsdoc, modifiers)
        }

        ; Two reference arms, both unported. With modifiers it reports
        ; Declaration_expected and builds a property with a MISSING name; with
        ; none it PANICS, because isListElement promised a member starts here —
        ; and a panic is not something to reproduce.
        this.unported("class-element", token)
    }

    ; The token kinds parseClassElement will take as the start of a property or
    ; method NAME. Written as a function for the reason the header gives: a run
    ; of tests nests no planner levels where a chain nests one per arm.
    function class_element_name_start(k: int) returns bool
    {
        ; Identifiers, every keyword and the private `#name` all sit above
        ; KindIdentifier in one contiguous run.
        if token_is_identifier_or_keyword(k)
            return true
        if k = KindStringLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindAsteriskToken
            return true
        k = KindOpenBracketToken
    }

    ; ast.IsClassMemberModifier — the accessibility modifiers plus `readonly`,
    ; `override`, `static` and `accessor`. ★ NOT the same list as
    ; class_member_start_token far above, which is isStartOfStatement's arm set:
    ; that one asks "could this word begin a class member", this one asks "is
    ; this word one a class member may carry", and `override` is in exactly one
    ; of the two.
    function is_class_member_modifier(k: int) returns bool
    {
        if k = KindPublicKeyword
            return true
        if k = KindPrivateKeyword
            return true
        if k = KindProtectedKeyword
            return true
        if k = KindReadonlyKeyword
            return true
        if k = KindOverrideKeyword
            return true
        if k = KindStaticKeyword
            return true
        k = KindAccessorKeyword
    }

    procedure look_ahead_scan_class_member_start(this) returns bool
    {
        let saved this.mark()
        let r this.scan_class_member_start()
        this.rewind(saved)
        r
    }

    ; isListElement(PCClassMembers). It walks the modifiers and then asks what
    ; follows, because a word like `public` is both a modifier and a legal
    ; member NAME — `class C { public }` declares a field called `public`.
    procedure scan_class_member_start(this) returns bool
    {
        var id_token KindUnknown

        ; A decorator can only be starting a member.
        if token = KindAtToken
            return true

        ; Eat the modifiers, holding on to the LAST one in case it turns out to
        ; be the name.
        while is_modifier_kind(token)
        {
            set id_token: token
            ; A modifier only a class MEMBER can carry settles it, whatever
            ; follows — which is what gives the reference a good error for
            ; `export public …`.
            if is_class_member_modifier(id_token)
                return true
            this.next_token()
        }

        if token = KindAsteriskToken
            return true

        ; The first property-like token after the modifiers, if there is one.
        if this.is_literal_property_name()
        {
            set id_token: token
            this.next_token()
        }

        ; An index signature and a computed property name both start here, and
        ; both are members.
        if token = KindOpenBracketToken
            return true

        if id_token = KindUnknown
            return false

        ; A non-keyword name is a member outright, and so are the two accessor
        ; words.
        if is_keyword(id_token) = false
            return true
        if id_token = KindGetKeyword
            return true
        if id_token = KindSetKeyword
            return true

        ; A keyword used as a name only counts if what follows can only continue
        ; a member: a parameter list, a type argument list, `!`, `:`, `=` or `?`.
        if token = KindOpenParenToken
            return true
        if token = KindLessThanToken
            return true
        if token = KindExclamationToken
            return true
        if token = KindColonToken
            return true
        if token = KindEqualsToken
            return true
        if token = KindQuestionToken
            return true

        ; ... or a semicolon, a `}`, end-of-file, or a line break that inserts
        ; one — all of which end a declaration.
        this.can_parse_semicolon()
    }

    procedure parse_class_static_block_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        ; ★ The `static` token node is BUILT AND DISCARDED by the reference, so
        ; it is neither a modifier nor a child — a static block's only children
        ; are its modifiers and its body.
        if this.parse_expected_token(KindStaticKeyword) = null
            return null
        let body this.parse_class_static_block_body()
        if body = null
            return null
        let result this.finish_node(this.new_node(KindClassStaticBlockDeclaration, NodeData.ClassStaticBlockDeclaration(ClassStaticBlockDeclarationData(modifiers, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; A static block is always an await context and never a yield context,
    ; whatever encloses it.
    procedure parse_class_static_block_body(this) returns pointer[AstNode]
    {
        let saved context_flags
        this.set_context_flags(NodeFlagsYieldContext, false)
        this.set_context_flags(NodeFlagsAwaitContext, true)
        let body this.parse_block()
        set context_flags: saved
        body
    }

    ; ★ The mark/rewind is for the STRING form ALONE. A bare `constructor`
    ; keyword commits outright — `class C { constructor = 1 }` really is parsed
    ; as a constructor upstream, with a synthesized empty body and two
    ; diagnostics, which is why this port reports it rather than falling back to
    ; a property. What the speculation exists for is `class C { "other"() {} }`,
    ; where the string is a member NAME and nothing may have been consumed.
    procedure try_parse_constructor_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let saved this.mark()

        var is_constructor false
        if token = KindConstructorKeyword
            set is_constructor: true
        if token = KindStringLiteral
        {
            ; ★ The reference compares the DECODED value; this port keeps no
            ; tokenValue, so it compares the SOURCE TEXT, which is the same
            ; string exactly when the literal carries no backslash. With one it
            ; is a question this port cannot ANSWER — `"\constructor"` really
            ; does decode to `constructor`, an unrecognized escape yielding the
            ; character itself — and the ANSWER leaves the speculation even
            ; though the parse does not, which is what makes it unanswerable
            ; rather than unported (§3.5i).
            if scanner.token_text_has_backslash()
                this.unanswerable_bool("string-literal-value")
            if scanner.token_text_equals("\"constructor\"")
            {
                if this.look_ahead_next_token_is_open_paren()
                    set is_constructor: true
            }
        }

        if is_constructor = false
        {
            this.rewind(saved)
            return null
        }

        this.next_token()
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(ParseFlagsNone)
        if parameters = null
            return null

        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        ; Null is a legitimate answer — an overload signature has no body — so
        ; the test is is_unported(), not the result (§3.5h).
        let body this.parse_function_block_or_semicolon(ParseFlagsNone)
        if this.is_unported()
            return null

        let result this.finish_node(this.new_node(KindConstructor, NodeData.ConstructorDeclaration(ConstructorDeclarationData(modifiers, type_parameters, parameters, return_type, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_property_or_method_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        let asterisk_token this.parse_optional_token(KindAsteriskToken)
        if this.is_unported()
            return null
        let name this.parse_property_name()
        if name = null
            return null
        ; Not legal by the grammar; the reference parses it anyway and reports it
        ; in the grammar checker.
        let question_token this.parse_optional_token(KindQuestionToken)
        if this.is_unported()
            return null

        var is_method false
        if asterisk_token <> null
            set is_method: true
        if token = KindOpenParenToken
            set is_method: true
        if token = KindLessThanToken
            set is_method: true
        if is_method
            return this.parse_method_declaration(pos, jsdoc, modifiers, asterisk_token, name, question_token)

        this.parse_property_declaration(pos, jsdoc, modifiers, name, question_token)
    }

    ; Shared with the object literal — `{ *gen() {} }` and `class C { *gen() {} }`
    ; build the same node through the same path.
    procedure parse_method_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], asterisk_token: pointer[AstNode], name: pointer[AstNode], postfix_token: pointer[AstNode]) returns pointer[AstNode]
    {
        var signature_flags ParseFlagsNone
        if asterisk_token <> null
            set signature_flags: signature_flags | ParseFlagsYield
        if has_modifier(modifiers, KindAsyncKeyword)
            set signature_flags: signature_flags | ParseFlagsAwait

        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(signature_flags)
        if parameters = null
            return null

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_return_type(KindColonToken, false)
            if type_node = null
                return null
        }

        let body this.parse_function_block_or_semicolon(signature_flags)
        if this.is_unported()
            return null

        let result this.finish_node(this.new_node(KindMethodDeclaration, NodeData.MethodDeclaration(MethodDeclarationData(modifiers, asterisk_token, name, postfix_token, type_parameters, parameters, type_node, body))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    procedure parse_property_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], name: pointer[AstNode], question_token: pointer[AstNode]) returns pointer[AstNode]
    {
        ; ONE postfix slot holds either the `?` or the `!`, never both — and the
        ; `!` is refused across a line break, which is what keeps `x` NL `!y`
        ; from becoming a definite-assignment assertion.
        var postfix_token question_token
        if postfix_token = null
        {
            if this.has_preceding_line_break() = false
            {
                set postfix_token: this.parse_optional_token(KindExclamationToken)
                if this.is_unported()
                    return null
            }
        }

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }

        ; The initializer is parsed outside yield, await and DisallowIn — a class
        ; body's field initializer is its own scope for all three.
        let saved context_flags
        this.set_context_flags(NodeFlagsYieldContext, false)
        this.set_context_flags(NodeFlagsAwaitContext, false)
        this.set_context_flags(NodeFlagsDisallowInContext, false)
        let initializer this.parse_initializer()
        set context_flags: saved
        if this.is_unported()
            return null

        if this.parse_semicolon_after_property_name(type_node) = false
            return null

        let result this.finish_node(this.new_node(KindPropertyDeclaration, NodeData.PropertyDeclaration(PropertyDeclarationData(modifiers, name, postfix_token, type_node, initializer))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; Every arm of the reference's parseSemicolonAfterPropertyName but the one
    ; that succeeds is a diagnostic, so this is the succeeding arm plus three
    ; reports. The reference's `name` and `initializer` arguments only choose
    ; WHICH message, so they are not carried.
    procedure parse_semicolon_after_property_name(this, type_node: pointer[AstNode]) returns bool
    {
        if token = KindAtToken
        {
            if this.has_preceding_line_break() = false
                return this.unported_bool("property-decorator-after-name")
        }
        if token = KindOpenParenToken
            return this.unported_bool("property-call-in-type")
        if type_node <> null
        {
            if this.can_parse_semicolon() = false
                return this.unported_bool("property-semicolon")
        }
        if this.try_parse_semicolon()
            return true
        this.unported_bool("property-semicolon")
    }

    procedure parse_initializer(this) returns pointer[AstNode]
    {
        if this.parse_optional(KindEqualsToken) = false
            return null
        this.parse_assignment_expression_or_higher()
    }

    ; Shared with the object literal, exactly as parse_method_declaration is.
    ; `flags` is ParseFlagsNone at every call site this port has; the reference
    ; passes ParseFlagsType from the interface-member slice, which is why the
    ; parameter is here rather than inlined.
    procedure parse_accessor_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]], kind: int, flags: int) returns pointer[AstNode]
    {
        let name this.parse_property_name()
        if name = null
            return null
        ; A getter with type parameters, or a setter with a return type, is a
        ; grammar error the CHECKER reports — both are parsed here, and keeping
        ; them is what lets it.
        let type_parameters this.parse_type_parameters()
        if this.is_unported()
            return null
        let parameters this.parse_parameters(ParseFlagsNone)
        if parameters = null
            return null

        var return_type null as pointer[AstNode]
        if token = KindColonToken
        {
            set return_type: this.parse_return_type(KindColonToken, false)
            if return_type = null
                return null
        }

        let body this.parse_function_block_or_semicolon(flags)
        if this.is_unported()
            return null

        var result null as pointer[AstNode]
        if kind = KindGetAccessor
            set result: this.new_node(KindGetAccessor, NodeData.GetAccessorDeclaration(AccessorDeclarationData(modifiers, name, type_parameters, parameters, return_type, body)))
        else
            set result: this.new_node(KindSetAccessor, NodeData.SetAccessorDeclaration(AccessorDeclarationData(modifiers, name, type_parameters, parameters, return_type, body)))

        this.with_jsdoc(this.finish_node(result, pos), jsdoc)
    }

    ; ── the index signature ─────────────────────────────────────────────────

    procedure is_index_signature(this) returns bool
    {
        if token <> KindOpenBracketToken
            return false
        this.look_ahead_next_is_unambiguously_index_signature()
    }

    procedure look_ahead_next_is_unambiguously_index_signature(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_unambiguously_index_signature()
        this.rewind(saved)
        r
    }

    ; The only WELL-FORMED sequence is `[id:`; everything else this admits is
    ; the reference's error recovery, ported because the answer decides which
    ; production is entered and a narrower one would route a broken index
    ; signature into a computed property name.
    procedure next_is_unambiguously_index_signature(this) returns bool
    {
        this.next_token()
        if token = KindDotDotDotToken
            return true
        if token = KindCloseBracketToken
            return true

        let leading_modifier is_modifier_kind(token)
        if leading_modifier
        {
            this.next_token()
            if this.is_identifier()
                return true
        }
        if leading_modifier = false
        {
            if this.is_identifier() = false
                return false
            this.next_token()
        }

        ; A colon is a well-formed indexer; a comma cannot be a computed property
        ; name, since a comma expression is not allowed in one.
        if token = KindColonToken
            return true
        if token = KindCommaToken
            return true
        ; A `?` could still be a conditional expression in a computed property
        ; name, so one more token decides.
        if token <> KindQuestionToken
            return false
        this.next_token()
        if token = KindColonToken
            return true
        if token = KindCommaToken
            return true
        token = KindCloseBracketToken
    }

    procedure parse_index_signature_declaration(this, pos: int, jsdoc: int, modifiers: pointer[Array[pointer[AstNode]]]) returns pointer[AstNode]
    {
        ; parseParameter, not parseParameterEx: an index signature's parameter is
        ; read with NO outer await context and ambiguity allowed. Both travel as
        ; parser state here (§3.5g/§3.5k), so both are set and put back.
        let saved_outer parameter_outer_await_context
        let saved_ambiguity parameter_allow_ambiguity
        set parameter_outer_await_context: false
        set parameter_allow_ambiguity: true
        let parameters this.parse_bracketed_list(PCParameters, KindOpenBracketToken, KindCloseBracketToken)
        set parameter_outer_await_context: saved_outer
        set parameter_allow_ambiguity: saved_ambiguity
        if parameters = null
            return null

        var type_node null as pointer[AstNode]
        if token = KindColonToken
        {
            set type_node: this.parse_type_annotation()
            if type_node = null
                return null
        }

        if this.parse_type_member_semicolon() = false
            return null

        let result this.finish_node(this.new_node(KindIndexSignature, NodeData.IndexSignatureDeclaration(IndexSignatureDeclarationData(modifiers, parameters, type_node))), pos)
        this.with_jsdoc(result, jsdoc)
    }

    ; A type member may be separated by a comma OR by a (possibly inserted)
    ; semicolon.
    procedure parse_type_member_semicolon(this) returns bool
    {
        if this.parse_optional(KindCommaToken)
            return true
        this.parse_semicolon()
    }

    ; ── the two look-aheads this slice adds ─────────────────────────────────

    procedure look_ahead_next_token_is_identifier_or_keyword(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_identifier_or_keyword()
        this.rewind(saved)
        r
    }

    procedure next_token_is_identifier_or_keyword(this) returns bool
    {
        this.next_token()
        token_is_identifier_or_keyword(token)
    }

    procedure look_ahead_next_token_is_open_paren(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_open_paren()
        this.rewind(saved)
        r
    }

    procedure next_token_is_open_paren(this) returns bool
    {
        this.next_token()
        token = KindOpenParenToken
    }

    ; ── delimited lists ─────────────────────────────────────────────────────
    ;
    ; parseBracketedList / parseDelimitedList for the three contexts above. The
    ; element and terminator predicates are the reference's, arm for arm; the
    ; recovery is not, because it runs only after a diagnostic.
    ;
    ; A list may legitimately come back EMPTY — `Foo<>` is a type reference with
    ; zero type arguments, and the reference builds an empty NodeList for it —
    ; so an empty Array here is a result, not a failure. Failure is null.

    procedure parse_bracketed_list(this, ctx: int, opening: int, closing: int) returns pointer[Array[pointer[AstNode]]]
    {
        if this.parse_expected(opening) = false
            return null
        let list this.parse_delimited_list(ctx)
        if list = null
            return null
        if this.parse_expected(closing) = false
            return null
        list
    }

    ; parseList — the UNDELIMITED form, added with slice 6 for the two lists a
    ; class body is made of. No commas: an element either starts here or the
    ; list ends, and there is nothing in between to recover from.
    procedure parse_list(this, ctx: int) returns pointer[Array[pointer[AstNode]]]
    {
        let list AstNode.new_node_list(host)
        while this.is_list_terminator(ctx) = false
        {
            if this.is_list_element(ctx) = false
            {
                ; abortParsingListOrMoveToNextToken — a diagnostic on either
                ; path, so this is where the port stops rather than skipping a
                ; token the way the reference does.
                this.unported("list-element", token)
                return null
            }
            let element this.parse_list_element(ctx)
            if element = null
                return null
            list.add(element)
        }
        list
    }

    procedure parse_delimited_list(this, ctx: int) returns pointer[Array[pointer[AstNode]]]
    {
        let list AstNode.new_node_list(host)
        while true
        {
            if this.is_list_element(ctx)
            {
                let element this.parse_list_element(ctx)
                if element = null
                    return null
                list.add(element)
                if this.parse_optional(KindCommaToken)
                    continue
                if this.is_list_terminator(ctx)
                    break
                ; Neither continued nor terminated: the reference reports
                ; "',' expected" and recovers.
                this.unported("list-comma", token)
                return null
            }
            if this.is_list_terminator(ctx)
                break
            ; abortParsingListOrMoveToNextToken — a diagnostic on either path.
            this.unported("list-element", token)
            return null
        }
        list
    }

    procedure parse_list_element(this, ctx: int) returns pointer[AstNode]
    {
        if ctx = PCTypeParameters
            return this.parse_type_parameter()
        if ctx = PCTupleElementTypes
            return this.parse_tuple_element_name_or_tuple_element_type()
        if ctx = PCParameters
            return this.parse_parameter_ex(parameter_outer_await_context, parameter_allow_ambiguity)
        if ctx = PCArgumentExpressions
            return this.parse_argument_expression()
        ; ★ An ARRAY literal's element is NOT wrapped in the argument context:
        ; the reference passes parseArgumentOrArrayLiteralElement directly here
        ; and parseArgumentExpression there, and the wrapper CLEARS DisallowIn
        ; and DecoratorContext while the array path inherits both. Both therefore
        ; allow `in` at the top level — the difference only shows inside a `for`
        ; initializer or a decorator, and both of those are unported, so no case
        ; in this suite can see it. Ported as written rather than collapsed,
        ; because the difference becomes real with the first of those slices.
        if ctx = PCArrayLiteralMembers
            return this.parse_argument_or_array_literal_element()
        if ctx = PCObjectLiteralMembers
            return this.parse_object_literal_element()
        if ctx = PCClassMembers
            return this.parse_class_element()
        if ctx = PCHeritageClauses
            return this.parse_heritage_clause()
        if ctx = PCHeritageClauseElement
            return this.parse_expression_with_type_arguments()
        this.parse_type()
    }

    procedure is_list_element(this, ctx: int) returns bool
    {
        if ctx = PCParameters
            return this.is_start_of_parameter(false)
        if ctx = PCTypeParameters
        {
            ; `in` and `const` are variance/modifier keywords on a type
            ; parameter, so a list can start with either.
            if token = KindInKeyword
                return true
            if token = KindConstKeyword
                return true
            return this.is_identifier()
        }
        if ctx = PCObjectLiteralMembers
        {
            ; `[`, `*` and `...` really do start a member; the lone `.` does not,
            ; and is admitted so that a half-typed `{ a. }` does not close the
            ; literal (the reference names the completion test it is for).
            if token = KindOpenBracketToken
                return true
            if token = KindAsteriskToken
                return true
            if token = KindDotDotDotToken
                return true
            if token = KindDotToken
                return true
            return this.is_literal_property_name()
        }
        if ctx = PCArrayLiteralMembers
        {
            ; A comma is an ELISION and therefore an element; the `.` is the
            ; same completion tolerance as above.
            if token = KindCommaToken
                return true
            if token = KindDotToken
                return true
            if token = KindDotDotDotToken
                return true
            return this.is_start_of_expression()
        }
        if ctx = PCArgumentExpressions
        {
            if token = KindDotDotDotToken
                return true
            return this.is_start_of_expression()
        }
        if ctx = PCClassMembers
        {
            ; ES6 allows a bare `;` as a class element. The reference refuses it
            ; during error RECOVERY, so that a stray semicolon in a broken class
            ; does not read as a member; this port has no recovery, so the
            ; question never arises.
            if this.look_ahead_scan_class_member_start()
                return true
            return token = KindSemicolonToken
        }
        if ctx = PCHeritageClauses
            return this.is_heritage_clause()
        if ctx = PCHeritageClauseElement
        {
            ; `{ … }` is only a base type when what follows says the class body
            ; has not started yet — otherwise `extends {}` would eat the body.
            if token = KindOpenBraceToken
                return this.is_valid_heritage_clause_object_literal()
            if this.is_start_of_left_hand_side_expression() = false
                return false
            return this.is_heritage_clause_extends_or_implements_keyword() = false
        }
        ; PCTypeArguments and PCTupleElementTypes share one arm upstream too.
        if token = KindCommaToken
            return true
        this.is_start_of_type(false)
    }

    procedure is_list_terminator(this, ctx: int) returns bool
    {
        if token = KindEndOfFile
            return true
        if ctx = PCObjectLiteralMembers
            return token = KindCloseBraceToken
        if ctx = PCArrayLiteralMembers
            return token = KindCloseBracketToken
        if ctx = PCArgumentExpressions
        {
            ; `;` is there for error recovery, and is ported for the same reason
            ; the recovery tokens below are: leaving it out would loop where the
            ; reference stops.
            if token = KindCloseParenToken
                return true
            return token = KindSemicolonToken
        }
        if ctx = PCTypeParameters
        {
            ; Everything but `>` is there for error recovery, and is ported
            ; because leaving it out would loop where the reference stops.
            if token = KindGreaterThanToken
                return true
            if token = KindOpenParenToken
                return true
            if token = KindOpenBraceToken
                return true
            if token = KindExtendsKeyword
                return true
            return token = KindImplementsKeyword
        }
        if ctx = PCTupleElementTypes
            return token = KindCloseBracketToken
        if ctx = PCClassMembers
            return token = KindCloseBraceToken
        if ctx = PCHeritageClauses
        {
            ; `{` ends the clause LIST because it starts the class body; `}` is
            ; there for error recovery.
            if token = KindOpenBraceToken
                return true
            return token = KindCloseBraceToken
        }
        if ctx = PCHeritageClauseElement
        {
            if token = KindOpenBraceToken
                return true
            if token = KindExtendsKeyword
                return true
            return token = KindImplementsKeyword
        }
        if ctx = PCParameters
        {
            ; `]` is here for an index signature's parameter list, and — like the
            ; recovery tokens on PCTypeParameters — it is ported because leaving
            ; it out would loop where the reference stops.
            if token = KindCloseParenToken
                return true
            return token = KindCloseBracketToken
        }
        ; PCTypeArguments: anything but a comma ends the list.
        token <> KindCommaToken
    }

    ; ── the type-position predicates ────────────────────────────────────────

    procedure is_start_of_type(this, in_start_of_parameter: bool) returns bool
    {
        if type_start_token(token)
            return true
        if token = KindFunctionKeyword
            return in_start_of_parameter = false
        if token = KindMinusToken
        {
            if in_start_of_parameter
                return false
            return this.look_ahead_next_token_is_numeric_or_bigint_literal()
        }
        if token = KindOpenParenToken
        {
            ; `(` is only a type start if what follows could be a parameter list
            ; or a type — otherwise `(1)` would read as one.
            if in_start_of_parameter
                return false
            return this.look_ahead_next_is_parenthesized_or_function_type()
        }
        this.is_identifier()
    }

    ; The unconditional arm of isStartOfType, transcribed from the reference's
    ; case list. A run of independent tests rather than a chain — the same
    ; reason the scan switch is one (see the header).
    function type_start_token(k: int) returns bool
    {
        if k = KindAnyKeyword
            return true
        if k = KindUnknownKeyword
            return true
        if k = KindStringKeyword
            return true
        if k = KindNumberKeyword
            return true
        if k = KindBigIntKeyword
            return true
        if k = KindBooleanKeyword
            return true
        if k = KindReadonlyKeyword
            return true
        if k = KindSymbolKeyword
            return true
        if k = KindUniqueKeyword
            return true
        if k = KindVoidKeyword
            return true
        if k = KindUndefinedKeyword
            return true
        if k = KindNullKeyword
            return true
        if k = KindThisKeyword
            return true
        if k = KindTypeOfKeyword
            return true
        if k = KindNeverKeyword
            return true
        if k = KindOpenBraceToken
            return true
        if k = KindOpenBracketToken
            return true
        if k = KindLessThanToken
            return true
        if k = KindBarToken
            return true
        if k = KindAmpersandToken
            return true
        if k = KindNewKeyword
            return true
        if k = KindStringLiteral
            return true
        if k = KindNumericLiteral
            return true
        if k = KindBigIntLiteral
            return true
        if k = KindTrueKeyword
            return true
        if k = KindFalseKeyword
            return true
        if k = KindObjectKeyword
            return true
        if k = KindAsteriskToken
            return true
        if k = KindQuestionToken
            return true
        if k = KindExclamationToken
            return true
        if k = KindDotDotDotToken
            return true
        if k = KindInferKeyword
            return true
        if k = KindImportKeyword
            return true
        if k = KindAssertsKeyword
            return true
        if k = KindNoSubstitutionTemplateLiteral
            return true
        k = KindTemplateHead
    }

    procedure is_start_of_parameter(this, is_jsdoc_parameter: bool) returns bool
    {
        if token = KindDotDotDotToken
            return true
        if this.is_binding_identifier_or_private_identifier_or_pattern()
            return true
        if is_modifier_kind(token)
            return true
        if token = KindAtToken
            return true
        this.is_start_of_type(is_jsdoc_parameter = false)
    }

    function is_binding_identifier_or_private_identifier_or_pattern(this) returns bool
    {
        if token = KindOpenBraceToken
            return true
        if token = KindOpenBracketToken
            return true
        if token = KindPrivateIdentifier
            return true
        this.is_binding_identifier()
    }

    procedure is_start_of_function_type_or_constructor_type(this) returns bool
    {
        if token = KindLessThanToken
            return true
        if token = KindOpenParenToken
            return this.look_ahead_next_is_unambiguously_start_of_function_type()
        if token = KindNewKeyword
            return true
        if token = KindAbstractKeyword
            return this.look_ahead_next_token_is_new_keyword()
        false
    }

    procedure next_is_unambiguously_start_of_function_type(this) returns bool
    {
        this.next_token()
        if token = KindCloseParenToken
            return true
        if token = KindDotDotDotToken
            return true
        if this.skip_parameter_start()
        {
            if token = KindColonToken
                return true
            if token = KindCommaToken
                return true
            if token = KindQuestionToken
                return true
            if token = KindEqualsToken
                return true
            if token = KindCloseParenToken
                return this.next_token() = KindEqualsGreaterThanToken
        }
        false
    }

    procedure skip_parameter_start(this) returns bool
    {
        if is_modifier_kind(token)
            this.parse_modifiers(false, false, false)
        this.parse_optional(KindDotDotDotToken)
        if this.is_identifier()
        {
            this.next_token()
            return true
        }
        if token = KindThisKeyword
        {
            this.next_token()
            return true
        }
        ; ★★★ The reference answers "yes, if the binding pattern parses without a
        ; diagnostic". Both halves are unported, and answering `false` instead
        ; would be worse than reporting: it would send `([a]: T) => U` down the
        ; parenthesized-type path and build a tree nobody checked.
        ;
        ; This is the ONE site whose report has to outlive a rewind, and it is
        ; the whole reason there are two records — every caller here is a
        ; look-ahead, so a rewindable report would be erased the moment the
        ; ANSWER was handed back and used. See the ParserState header.
        if token = KindOpenBracketToken
            return this.unanswerable_bool("binding-pattern")
        if token = KindOpenBraceToken
            return this.unanswerable_bool("binding-pattern")
        false
    }

    ; unported() answers a node; a predicate needs the same record with a bool.
    procedure unported_bool(this, tag: pointer[const_char]) returns bool
    {
        this.unported(tag, token)
        false
    }

    ; ... and the same again for the record a rewind does not restore.
    procedure unanswerable_bool(this, tag: pointer[const_char]) returns bool
    {
        if unanswerable_pos < 0
        {
            set unanswerable_pos: scanner.token_full_start()
            set unanswerable_tag: tag
            set unanswerable_detail: token
        }
        false
    }

    procedure next_is_start_of_type(this) returns bool
    {
        this.next_token()
        this.is_start_of_type(false)
    }

    procedure next_token_is_numeric_or_bigint_literal(this) returns bool
    {
        this.next_token()
        if token = KindNumericLiteral
            return true
        token = KindBigIntLiteral
    }

    procedure next_is_parenthesized_or_function_type(this) returns bool
    {
        this.next_token()
        if token = KindCloseParenToken
            return true
        if this.is_start_of_parameter(false)
            return true
        this.is_start_of_type(false)
    }

    procedure next_is_start_of_type_of_import_type(this) returns bool
    {
        this.next_token()
        token = KindImportKeyword
    }

    procedure next_token_is_identifier_or_keyword_on_same_line(this) returns bool
    {
        if token_is_identifier_or_keyword(this.next_token()) = false
            return false
        this.has_preceding_line_break() = false
    }

    ; ── the look-ahead wrappers for the type surface ────────────────────────
    ;
    ; One per call site, as in §3.9e. They are mechanical, and that is the
    ; point: the mark/rewind pair is the part that must never be forgotten.

    procedure look_ahead_next_is_start_of_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_start_of_type()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_numeric_or_bigint_literal(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_numeric_or_bigint_literal()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_is_parenthesized_or_function_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_parenthesized_or_function_type()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_is_unambiguously_start_of_function_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_unambiguously_start_of_function_type()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_new_keyword(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() = KindNewKeyword
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_is_start_of_type_of_import_type(this) returns bool
    {
        let saved this.mark()
        let r this.next_is_start_of_type_of_import_type()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_token_is_identifier_or_keyword_on_same_line(this) returns bool
    {
        let saved this.mark()
        let r this.next_token_is_identifier_or_keyword_on_same_line()
        this.rewind(saved)
        r
    }

    procedure look_ahead_scan_start_of_named_tuple_element(this) returns bool
    {
        let saved this.mark()
        let r this.scan_start_of_named_tuple_element()
        this.rewind(saved)
        r
    }

    procedure look_ahead_next_is_not_dot(this) returns bool
    {
        let saved this.mark()
        let r this.next_token() <> KindDotToken
        this.rewind(saved)
        r
    }
}
