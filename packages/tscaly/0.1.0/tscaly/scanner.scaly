; SPDX-License-Identifier: Apache-2.0
;
; scanner — ported from the reference's internal/scanner/scanner.go.
;
; SLICES 1-3, and SLICE 25 closed it. Everything reachable from Scan() is
; ported: trivia, comments, punctuation, identifiers (ASCII, Unicode and
; unicode-escaped), keywords, all numeric and string literal forms, templates,
; private names, the shebang, and merge-conflict trivia. Every re-scan entry
; point has a caller (slices 3, 5, 11, 16, 20, 21); what is NOT ported is named
; at `unported_pos` below, and it is one construct — the comment DIRECTIVES,
; which are not tokens.
;
; ★★★ THAT SENTENCE STOOD HERE FROM SLICE 3 AND WAS FALSE UNTIL SLICE 25. One
; byte of scan_number reported `unported` for any non-ASCII character after a
; numeric literal, and corpus stage 2 hit it twice with a NO-BREAK SPACE. The
; account is at `unported_pos`; what belongs here is that a summary line at the
; top of a file is exactly where such a claim survives, because nothing reads it
; against the code.
;
; `unported_pos` stays because the mechanism is worth keeping, not because it
; has a caller — it has none: an omission should report its own POSITION at
; runtime rather than emit a plausible token stream that quietly disagrees with
; the reference.
;
; ── Three things measured rather than assumed, because getting any of them wrong
; ── would have been silent:
;
; (1) `char()` answers a BYTE, not a decoded rune. The reference writes
;     `rune(s.text[s.pos])`, which takes one byte and widens it — every case
;     label in its switch is ASCII, and only the default arm decodes UTF-8. A
;     port that "helpfully" decodes here would change how many positions a
;     multi-byte character advances and desynchronize every span after it.
;
; (2) Scaly's `char` does NOT sign-extend: byte 0xC3 widens to 195, not -61
;     (measured). That is what makes the reference's -1 EOF sentinel portable —
;     with sign extension, a byte >= 0x80 would collide with it.
;
; (3) The dispatch is a run of INDEPENDENT `if` blocks that return, not an
;     `else if` chain. A chain nests one planner level per arm at roughly 110 KB
;     of planner stack per arm under the unoptimized bootstrap stages (root
;     CLAUDE.md), and this switch has about forty arms. Independent ifs are also
;     exactly equivalent here: the reference's arms are disjoint by construction,
;     since each tests the same `ch` against a distinct literal.
;
; ── The `tokenValue` arrived with slice 17 and is a pointer and a length; see
; ScannerState for why that pair is the faithful shape and not a shortcut. Every
; kind whose value is decided by SLICING or by ESCAPE DECODING answers it —
; identifiers and keywords (a keyword is looked up on the DECODED text, which is
; why `\u0063onst` is `const`), private names, string literals, template chunks,
; the regular expression. ★ Since slice 44 the NUMERIC literal answers it too,
; and it is the one kind whose value is a CONVERSION rather than a span: the
; ECMAScript Number-to-String of the parsed double, through tscaly/jsnum.scaly.
; The BigInt literal is now the only kind still holding a stand-in — see
; set_bigint_token_value, which names the reader that would earn the port.

use scaly.containers.String
use tscaly.Diagnostics.DiagnosticList

; The reference's mergeConflictMarkerLength — len("<<<<<<<"). It was three
; inline 7s with a comment until slice 13b needed it as a diagnostic's LENGTH as
; well as a scan bound, at which point naming it stopped being tidiness.
define MERGE_CONFLICT_MARKER_LENGTH: int 7

; The reference embeds this in Scanner so Mark()/Rewind() can save and restore
; the whole mutable block as one value (the parser speculates in JSDoc). Go's
; embedding also promotes the fields, which is why the reference writes `s.pos`;
; here it is a named field, so the save/restore intent is visible at every use
; instead of only at Mark(). Our own compiler's lexer arrived at the same shape
; independently (`LexerState` in scalyc/compiler/lexer.scaly), which is a decent
; sign it is the right one.
define ScannerState
(
    pos: int
    full_start_pos: int
    token_start: int
    token: int
    token_flags: int

    ; The reference's `tokenValue string` — the token's PARSED value, which is
    ; its source text only when no escape decoded to something else. Go's string
    ; IS a pointer and a length, and `s.text[a:b]` shares the source bytes
    ; without copying, so the pair below is the faithful shape rather than a
    ; representation choice: a value that happens to be a slice of the source
    ; costs nothing, and only a DECODED one is built.
    ;
    ; ★ It sits in ScannerState, not in Scanner, because the reference puts it
    ; there — Mark()/Rewind() save and restore it with everything else, and that
    ; is load-bearing: try_parse_constructor_declaration rewinds and its caller
    ; then reads the same string literal's value WITHOUT re-scanning.
    ;
    ; ★ The bytes are never mutated once written, which is what makes the
    ; struct COPY the whole of the save.
    token_value: pointer[char]
    token_value_len: int
)
{
    init(p: int, fsp: int, ts: int, tk: int, tf: int, tv: pointer[char], tvl: int)
    {
        set pos: p
        set full_start_pos: fsp
        set token_start: ts
        set token: tk
        set token_flags: tf
        set token_value: tv
        set token_value_len: tvl
    }
}

define Scanner
(
    buffer: pointer[char]
    end: int
    skip_trivia: bool

    ; Position of the first construct this slice does not implement, or -1.
    ; NOT part of the reference — it exists so an incomplete port reports its own
    ; incompleteness instead of emitting a well-formed wrong answer.
    ;
    ; ★★★ SINCE SLICE 25 IT HAS NO CALL SITE AT ALL, and the sentence that stood
    ; here — "nothing reachable from scan() is unported any more, so this stays
    ; at -1 over the whole corpus" — was FALSE while it stood, which is why the
    ; wording is now a grep and not a claim. Corpus stage 2 reached the one that
    ; was left, twice: scan_number read the byte after a numeric literal and
    ; reported anything >= 128 unported, so a NO-BREAK SPACE after a number
    ; stopped the scan. It is ported (see the trailing-name check there).
    ;
    ; ★★ The other three call sites were DEAD, each reading a failure channel
    ; that could not fail: scan_escape_sequence answered a `bool` that was always
    ; true, and scan_string's `false` and scan_template's `-1` came only from it.
    ; All three channels are retired with this slice — a hatch that cannot fire
    ; over a construct that is in fact ported is the §3.5bn class from its
    ; flattering side, since nothing ever looks wrong.
    ;
    ; ★ The MECHANISM stays, unused, and that is a decision rather than an
    ; oversight: the token yardstick has no other way to say "this stream is not
    ; a comparison" (tscaly_tokens prints UNPORTED off `unported_at`), and one
    ; construct of this file's own reference is still not ported — the COMMENT
    ; DIRECTIVES below. The day something needs it, the site and the record land
    ; in one commit.
    ;
    ; ★★★ Slice 21 emptied the list that stood here. What it named —
    ; ReScanAsteriskEqualsToken, ReScanQuestionToken and JSDoc leading-asterisk
    ; skipping — is built and has a caller, and the JSDoc token grammar
    ; (scan_jsdoc_token, scan_jsdoc_comment_text_token, can_follow_jsdoc_at) came
    ; with it. What is left is COMMENT DIRECTIVES (`@ts-ignore`, collected into a
    ; list and never a token), which nothing in this port reads.
    ;
    ; ReScanLessThanToken is ported — parser slice 3 gave it its first caller —
    ; ReScanGreaterThanToken since slice 5, which is the ladder's,
    ; ReScanTemplateToken since slice 11, which is the template family's, and
    ; ReScanSlashToken since slice 16, which is the regular expression's. That
    ; leaves no non-JSDoc re-scan unported.
    ;
    ; ★ The four JSX token scanners (ScanJsxToken, ReScanJsxToken,
    ; ScanJsxIdentifier, ScanJsxAttributeValue) landed in slice 20, together with
    ; the grammar that calls them; slice 19 had already ported the language
    ; VARIANT, because ScriptKindJSON selects it (see `jsx_variant`). Note that
    ; ReScanJsxAttributeValue still has no caller: the reference uses it from the
    ; language service, not from the parser.
    unported_pos: int

    ; The reference's ERROR CALLBACK, and since slice 13b it is the real thing
    ; rather than a stand-in.
    ;
    ; Upstream installs one — `p.scanner.SetOnError(p.scanError)` — whose entire
    ; body appends to the parser's diagnostic list. So the callback becomes a
    ; POINTER TO THAT LIST, shared with the parser: Scaly's only escaping-closure
    ; form is `return \x: …`, and a back-pointer to the Parser would be a cycle
    ; across modules the scanner is declared before. Diagnostics.scaly's header
    ; has the argument, including why the list rather than the parser owns
    ; `has_error`.
    ;
    ; NULL until the parser hands one over, exactly as `onError` is nil until
    ; SetOnError — and the scanner yardstick runs it that way, since a token dump
    ; has nowhere to put a diagnostic. `error_at` therefore guards, which is the
    ; reference's own `if s.onError != nil`.
    ;
    ; ★ What this REPLACED is worth knowing, because the shape of the stand-in
    ; explains three ★-comments elsewhere in this file: it used to be a single
    ; `error_pos`, "where did the scan first find fault", which the parser turned
    ; into one `unported` report. That was narrow on purpose — only the sites
    ; setting NO token flag used it, because the parser tested
    ; IsInvalid|Unterminated on the token itself — and it could not express a
    ; SPAN, a CODE, or more than one error. The conflict-marker fixture needs
    ; four.
    diagnostics: ref[DiagnosticList]?

    ; ── the value sink ──────────────────────────────────────────────────────
    ;
    ; The reference builds a decoded token value with a `strings.Builder` local
    ; to whichever routine is scanning. Here it is three fields on the scanner,
    ; for one reason: `scan_escape_sequence` is the routine that knows what an
    ; escape DECODES to, and it is called from two loops that build a value and
    ; from one pass that does not, so the sink has to reach it without becoming
    ; a parameter on every arm.
    ;
    ; ★ While `value_buffer` is null every `value_put_*` is a NO-OP, and that is
    ; the whole mechanism: the pass that only measures positions runs the same
    ; code with the sink unarmed, exactly as the reference's callers discard the
    ; string scanEscapeSequence returns.
    ;
    ; TRANSIENT, so NOT part of ScannerState: it is armed and committed inside
    ; one scan, and what a mark must carry is the committed value, which lives
    ; in the state.
    value_buffer: pointer[char]
    value_capacity: int
    value_length: int

    ; ★★★ The reference's `languageVariant core.LanguageVariant`, set by the
    ; parser from the SCRIPT KIND (`getLanguageVariant`) and read at exactly one
    ; place in Scan(): a `<` followed by `/` is ONE token under the JSX variant.
    ;
    ; A bool rather than an int, because the reference's enum has exactly two
    ; members and every read of it in the scanner is `== LanguageVariantJSX`. The
    ; inverse of §3.5j: a tristate is not a boolean with a third name, and a
    ; two-state enum is not an int with one value spare.
    ;
    ; ★★★ AND THE SURPRISE THIS SLICE PAID FOR: `getLanguageVariant` answers JSX
    ; for ScriptKindJSON as well as for the three JSX kinds. So a `.json` file is
    ; scanned under the JSX variant — the port would have got `</` wrong in the
    ; one file class where nobody would think to look for a JSX rule.
    jsx_variant: bool

    ; ★★★ The reference's `skipJSDocLeadingAsterisks int`, and a COUNTER rather
    ; than a flag because the reference makes it one — SetSkipJSDocLeadingAsterisks
    ; adds +1 or -1, so a nested enable/disable pair puts it back where it was
    ; instead of clearing an outer one. Two callers nest in practice: the JSDoc
    ; type expression turns it on around a type, and an `@import` tag's clause
    ; turns it on again inside that.
    ;
    ; What it buys is one arm of Scan(): while it is non-zero, the FIRST `*` on a
    ; line is trivia rather than an AsteriskToken, so a type written across
    ; several lines of a JSDoc comment scans as though the margin were not there.
    ; It is 0 outside JSDoc and the arm is inert then, which is why the port could
    ; carry the comment saying so through twenty slices.
    skip_jsdoc_leading_asterisks: int

    state: ScannerState
)
{
    init(source: String)
    {
        set buffer: source.get_buffer()
        set end: source.length() as int
        set skip_trivia: true
        set unported_pos: 0 - 1
        set diagnostics: null
        set value_buffer: null
        set value_capacity: 0
        set value_length: 0
        set jsx_variant: false
        set skip_jsdoc_leading_asterisks: 0
        set state: ScannerState(0, 0, 0, KindUnknown, TokenFlagsNone, null, 0)
    }

    ; ── character access ────────────────────────────────────────────────────
    ; Both answer -1 past the end, exactly as the reference does.

    function char(this) returns int
    {
        if state.pos < end
            return *(buffer + state.pos) as int
        0 - 1
    }

    function char_at(this, offset: int) returns int
    {
        let p state.pos + offset
        if p < end
            return *(buffer + p) as int
        0 - 1
    }

    function is_digit(c: int) returns bool
        (c >= ("0" as char) as int) and (c <= ("9" as char) as int)

    function is_line_break(c: int) returns bool
        (c = ("\n" as char) as int) or (c = ("\r" as char) as int)

    ; An identifier's first byte, ASCII fast path only (reference: scanIdentifier).
    function is_ident_start_ascii(c: int) returns bool
    {
        if (c >= ("a" as char) as int) and (c <= ("z" as char) as int)
            return true
        if (c >= ("A" as char) as int) and (c <= ("Z" as char) as int)
            return true
        if c = ("_" as char) as int
            return true
        c = ("$" as char) as int
    }

    function is_ident_part_ascii(c: int) returns bool
    {
        if is_ident_start_ascii(c)
            return true
        is_digit(c)
    }

    ; ── accessors ───────────────────────────────────────────────────────────
    ;
    ; These mirror the reference's Token()/TokenStart()/TokenEnd()/TokenFlags()/
    ; TokenFullStart(), and porting them is not decoration: reaching into
    ; `scanner.state.token_start` from another package is `Emitter: member not
    ; found: ScannerState.token_start`, exit 16 — a by-value struct nested in a
    ; struct is not laid out in a root that never declared it. So the shape the
    ; reference already had is also the shape that works here.

    function token(this) returns int
        state.token

    function token_start(this) returns int
        state.token_start

    ; The reference's TokenEnd() is the scan position — a token ends where the
    ; scanner stopped.
    function token_end(this) returns int
        state.pos

    function token_full_start(this) returns int
        state.full_start_pos

    function token_flags(this) returns int
        state.token_flags

    ; ── the current token's VALUE ───────────────────────────────────────────
    ;
    ; The reference's TokenValue(). Two accessors rather than one because a Go
    ; string is a pointer and a length and Scaly has no such pair as a value —
    ; see ScannerState for why the pair, and not a String, is the faithful
    ; shape.
    ;
    ; ★ What stood here until slice 17 was `token_text_equals` /
    ; `token_text_has_backslash`, a pair that answered questions about the
    ; SOURCE text and left the caller to establish that text and value coincide.
    ; They are gone with the field they stood in for: the one caller asked
    ; whether a string literal reads `constructor`, and that question now has its
    ; own answer.

    function token_value(this) returns pointer[char]
        state.token_value

    function token_value_length(this) returns int
        state.token_value_len

    ; The reference's `p.scanner.TokenValue() == "constructor"`, spelled against
    ; a C string because that is what a literal is here.
    function token_value_equals(this, t: pointer[const_char]) returns bool
    {
        var i: int 0
        while i < state.token_value_len
        {
            let c *(t + i) as int
            if c = 0
                return false
            if (*(state.token_value + i) as int) <> c
                return false
            set i: i + 1
        }
        (*(t + i) as int) = 0
    }

    ; ── writing a value ─────────────────────────────────────────────────────
    ;
    ; `s.tokenValue = s.text[start:stop]` — a Go slice, so no copy.
    procedure set_token_value_range(this, start: int, stop: int)
    {
        set state.token_value: buffer + start
        set state.token_value_len: stop - start
    }

    ; Arm the sink. `hint` is what the caller can prove about the length; the
    ; buffer grows if it is wrong, so a caller that cannot know may guess.
    ;
    ; ★ Where the caller CAN prove it, the hint is exact, and the proof is worth
    ; stating because it is the same one in every case: a decoded escape is
    ; never longer than its source. The shortest escape that decodes to anything
    ; is `\uXXXX` — six bytes for at most three — `\u{10FFFF}` is ten for four,
    ; `\xDD` four for one, `\n` two for one, and an escaped multi-byte
    ; character is its own bytes plus the backslash. So the decoded value of a
    ; token never exceeds its source span.
    procedure value_begin(this, hint: int)
    {
        var n hint
        if n < 8
            set n: 8
        let s String^this(n as size_t)
        set value_buffer: s.get_buffer()
        set value_capacity: n
        set value_length: 0
    }

    ; Hand the sink's bytes to the token value and disarm it.
    procedure value_commit(this)
    {
        set state.token_value: value_buffer
        set state.token_value_len: value_length
        set value_buffer: null
        set value_capacity: 0
        set value_length: 0
    }

    ; Hand a run of bytes the caller computed — as opposed to a run it copied out
    ; of the source — to the token value. Its callers are the numeric arms, whose
    ; value is a CONVERSION of the source and not a slice of it.
    procedure set_token_value_copy(this, src: pointer[char], n: int)
    {
        this.value_begin(n)
        var i 0
        while i < n
        {
            this.value_put_byte(*(src + i) as int)
            set i: i + 1
        }
        this.value_commit()
    }

    ; Grow to at least `need` bytes. A page cannot resize in place, so this
    ; allocates and copies — which is why the hint exists and why every caller
    ; that can compute the exact length does.
    procedure value_reserve(this, need: int)
    {
        if need <= value_capacity
            return
        var n value_capacity * 2
        while n < need
            set n: n * 2
        let s String^this(n as size_t)
        let b s.get_buffer()
        var i: int 0
        while i < value_length
        {
            set *(b + i): *(value_buffer + i)
            set i: i + 1
        }
        set value_buffer: b
        set value_capacity: n
    }

    ; Every one of these is a NO-OP while the sink is unarmed — see the field.
    procedure value_put_byte(this, b: int)
    {
        if value_buffer = null
            return
        this.value_reserve(value_length + 1)
        set *(value_buffer + value_length): b as char
        set value_length: value_length + 1
    }

    procedure value_put_range(this, start: int, stop: int)
    {
        if value_buffer = null
            return
        this.value_reserve(value_length + (stop - start))
        var i start
        while i < stop
        {
            set *(value_buffer + value_length): *(buffer + i)
            set value_length: value_length + 1
            set i: i + 1
        }
    }

    ; Go's `string(rune)` for a code point, and stringutil.EncodeJSStringRune for
    ; a lone surrogate — which is the SAME encoding, three bytes ED A0..BF
    ; 80..BF, because the reference spells out what Go's conversion refuses to
    ; do rather than choosing a different one. So one plain UTF-8 encoder covers
    ; both, and the surrogate case needs no arm.
    procedure value_put_codepoint(this, cp: int)
    {
        if value_buffer = null
            return
        if cp < 0x80
        {
            this.value_put_byte(cp)
            return
        }
        if cp < 0x800
        {
            this.value_put_byte(0xC0 | (cp >> 6))
            this.value_put_byte(0x80 | (cp & 0x3F))
            return
        }
        if cp < 0x10000
        {
            this.value_put_byte(0xE0 | (cp >> 12))
            this.value_put_byte(0x80 | ((cp >> 6) & 0x3F))
            this.value_put_byte(0x80 | (cp & 0x3F))
            return
        }
        this.value_put_byte(0xF0 | (cp >> 18))
        this.value_put_byte(0x80 | ((cp >> 12) & 0x3F))
        this.value_put_byte(0x80 | ((cp >> 6) & 0x3F))
        this.value_put_byte(0x80 | (cp & 0x3F))
    }

    ; How many bytes value_put_codepoint would write — the length half of the
    ; encoder above, for the one caller that needs the count without the bytes
    ; (scan_identifier_parts_length).
    ;
    ; ★ It agrees with Go's `sb.WriteRune` on every code point INCLUDING a lone
    ; surrogate, where the two do not write the same bytes: Go substitutes
    ; U+FFFD and the encoder above spells the surrogate out, and both are three
    ; bytes. So a length computed here is the reference's length even on the one
    ; input where the values differ. Keep the two branch ladders identical.
    function utf8_encoded_size(cp: int) returns int
    {
        if cp < 0x80
            return 1
        if cp < 0x800
            return 2
        if cp < 0x10000
            return 3
        4
    }

    ; Arm the sink at the first byte a literal's body cannot simply share with
    ; the source, back-filling the plain run that came before it.
    ;
    ; ★ LAZY, and that is the reference's own shape rather than an optimization
    ; bolted on: scanString returns the source slice outright when the body holds
    ; no backslash and only reaches for a strings.Builder otherwise, so a literal
    ; without escapes allocates nothing on either side. Doing it eagerly would
    ; also need a capacity nobody can compute — the body's end is not known until
    ; the loop finds it.
    procedure value_arm(this, chunk_start: int)
    {
        if value_buffer = null
            this.value_begin((state.pos - chunk_start) + 16)
        this.value_put_range(chunk_start, state.pos)
    }

    ; ── a numeric literal's VALUE ───────────────────────────────────────────
    ;
    ; ★★★ IT IS NORMALIZED, NOT SLICED, and slice 44 is where this port started
    ; doing it. Every numeric arm of the reference ends in
    ; `jsnum.FromString(s.tokenValue).String()`, the ECMAScript Number-to-String
    ; over the parsed double, so `0x1F` is `31`, `1e-2` is `0.01`, `1_000` is
    ; `1000`, `1.` is `1` and `9223372036854775807` is `9223372036854776000` —
    ; the value of a numeric literal is a floating-point question and not a
    ; lexical one. Through slice 43 the raw slice was stored instead, a stand-in
    ; with the reference's LIFETIME and not its MEANING (§3.5i); what made it
    ; expire is that a literal's text became a SYMBOL NAME. See tscaly/jsnum.scaly.
    ;
    ; ★★ THE VALUE IS SET INSIDE scan_number AND NOT AFTER IT, which is where the
    ; reference sets it and is not a matter of taste: `1.5n` and `1e2n` are
    ; refused as bigints and RETURN with pos past the `n`, so a value taken from
    ; the token's whole span afterwards would carry a suffix the reference's
    ; never saw. The `.5` arm of scan() set no value at all before this slice —
    ; unobservable then, and `{ .5: 1 }` is a declaration name now.

    ; The reference's tokenValue for a plain numeric literal, before jsnum:
    ; `s.text[start:end]`, or the digit runs concatenated when the literal
    ; carries a separator.
    ;
    ; ★★ Upstream builds that concatenation out of the pieces scanNumberFragment
    ; returned (fixedPart, fractionalPart, the exponent preamble and its digits);
    ; here it is the same SOURCE RANGE with the `_` bytes dropped, so the
    ; separator is removed at the same STAGE as the reference's and the two
    ; strings differ only in what else the pieces left out. They differ in exactly
    ; two shapes, both of them inside this branch, and in neither as a VALUE: the
    ; reference's fixedPart omits a LEADING ZERO (it comes from scanDigits, which
    ; starts after the `0`) and decimal.set ignores leading zeros anyway; and it
    ; drops the `.` of an EMPTY fraction while decimal.set tracks the point rather
    ; than the digits. An empty exponent is not a third: `end` was never advanced
    ; past the `e`, so it is outside this range on both sides.
    ;
    ; ★★ THIS IS THE ONLY REMOVAL, and the arrangement invites the opposite guess.
    ; `decimal.set` has a separator arm of its own — the one carrying "readFloat
    ; already checked underscores" — so it looks as though a `_` handed through
    ; would be dropped there anyway. It would not: `FromString` walks the runes
    ; first and `isNumberRune` does not admit `_`, so a value still carrying one
    ; answers NaN. Slice 44's c8 is RED 1 on exactly that, and c9 — which takes
    ; decimal.set's arm away instead — is UNGATED on the four yardsticks AND on
    ; numcheck.sh, the only other instrument that could reach it.
    procedure set_numeric_raw_value(this, start: int, stop: int)
    {
        if (state.token_flags & TokenFlagsContainsSeparator) = 0
        {
            this.set_token_value_range(start, stop)
            return
        }
        this.value_begin(stop - start)
        var i start
        while i < stop
        {
            if (*(buffer + i) as int) <> (("_" as char) as int)
                this.value_put_byte(*(buffer + i) as int)
            set i: i + 1
        }
        this.value_commit()
    }

    ; The reference's `s.tokenValue = "0x" + digits` and its two siblings. The
    ; marker is spelled LOWER CASE whatever the source wrote, and `digits` is
    ; what the digit scan accepted — so separators are dropped and an empty run
    ; becomes "0", which is the reference's own recovery after its "digit
    ; expected" diagnostic.
    ;
    ; ★ The hex arm upstream reuses the raw source text when it already IS
    ; `0x`+digits, through a cache keyed on the digits. That is allocation reuse
    ; and the two branches produce the same CONTENT — `0X1F` takes the other one
    ; and comes out `0x1F` either way — so one construction covers both, and the
    ; cache itself is a garbage collector's economy that a bump dying with the
    ; file's region does not need (§3.5bc's argument for the three reuse
    ; buffers).
    procedure set_radix_raw_value(this, marker: int, dstart: int, dstop: int, empty: bool)
    {
        this.value_begin((dstop - dstart) + 4)
        this.value_put_byte(("0" as char) as int)
        this.value_put_byte(marker)
        if empty
            this.value_put_byte(("0" as char) as int)
        else
        {
            var i dstart
            while i < dstop
            {
                if (*(buffer + i) as int) <> (("_" as char) as int)
                    this.value_put_byte(*(buffer + i) as int)
                set i: i + 1
            }
        }
        this.value_commit()
    }

    ; The legacy octal arm's own value: `strconv.FormatInt(ParseInt(digits, 8,
    ; 64), 10)`, which is NOT routed through jsnum — the arm returns before every
    ; other one reaches it.
    ;
    ; ★ The DROPPED error is the reference's (`val, _ :=`): ParseInt answers
    ; MaxInt64 on overflow and the arm keeps that value, so `0` followed by
    ; twenty-two 7s is named 9223372036854775807. Transcribed rather than
    ; corrected — this port has no licence to be more right than the scanner it
    ; is compared against.
    procedure set_octal_token_value(this, dstart: int, dstop: int)
    {
        let maxint 0x7FFFFFFFFFFFFFFF as u64
        var v: u64 0
        var over false
        var i dstart
        while i < dstop
        {
            let d ((*(buffer + i) as int) - (("0" as char) as int)) as u64
            if not over
            {
                if v > ((maxint - d) / (8 as u64))
                    set over: true
                else
                    set v: (v * (8 as u64)) + d
            }
            set i: i + 1
        }
        if over
            set v: maxint
        var out char[JSNUM_MAX_TEXT]
        let n jsnum_format_uint(v, &out[0])
        this.set_token_value_copy(&out[0], n)
    }

    ; `s.tokenValue = jsnum.FromString(s.tokenValue).String()`.
    ;
    ; ★ The identity test is the reference's own — `if tokenValue == s.tokenValue
    ; { tokenValue = s.tokenValue }`, inside its number cache — and here it buys
    ; the same thing without the map: a plain decimal integer, which is almost
    ; every numeric literal there is, keeps pointing into the source and
    ; allocates nothing.
    procedure normalize_numeric_token_value(this)
    {
        var out char[JSNUM_MAX_TEXT]
        let n jsnum_to_string(jsnum_from_string(state.token_value, state.token_value_len), &out[0])
        if n = state.token_value_len
        {
            var i 0
            while i < n
            {
                if (*(state.token_value + i) as int) <> (out[i] as int)
                    break
                set i: i + 1
            }
            if i = n
                return
        }
        this.set_token_value_copy(&out[0], n)
    }

    ; ★★ A BIGINT LITERAL'S VALUE IS THE ONE STAND-IN LEFT HERE, and it is
    ; narrower than the one slice 44 retired rather than a survival of it. The
    ; reference appends `"n"` and, for a BINARY or OCTAL specifier only, replaces
    ; the digits with `jsnum.ParsePseudoBigInt`'s decimal — a routine of its own
    ; over a digit string, with no double in it. Nothing in this port reads the
    ; value: `IsPropertyNameLiteral` admits Identifier, StringLiteral,
    ; NoSubstitutionTemplateLiteral and NumericLiteral and not BigIntLiteral, so a
    ; bigint is never a declaration NAME, and the parser stores the text into a
    ; node field no yardstick compares. What would earn the port is the CHECKER's
    ; bigint literal type, which is where the reference reads it. The source slice
    ; is stored meanwhile — the same lifetime, and the same span the whole token
    ; had before this slice.
    procedure set_bigint_token_value(this)
        this.set_token_value_range(state.token_start, state.pos)

    ; Close a literal body: the source slice when the sink was never armed, the
    ; sink's bytes plus the last plain run when it was.
    procedure value_finish_body(this, content_start: int, chunk_start: int, stop: int)
    {
        if value_buffer = null
        {
            this.set_token_value_range(content_start, stop)
            return
        }
        this.value_put_range(chunk_start, stop)
        this.value_commit()
    }

    ; The first position this slice could not scan, or -1.
    function unported_at(this) returns int
        unported_pos

    ; The reference's SetOnError. Called once, right after construction, by the
    ; parser that owns the list — the scanner is built first, so this cannot be a
    ; constructor argument any more than upstream's callback can.
    procedure set_diagnostics(this, d: ref[DiagnosticList])
        set diagnostics: d

    ; The reference's SetLanguageVariant, called by the parser out of
    ; initializeState — `p.scanner.SetLanguageVariant(p.languageVariant)`, one
    ; line below SetOnError, and for the same reason a setter rather than a
    ; constructor argument. NOT part of ScannerState: a mark saves scan
    ; POSITION, and the variant is a property of the file being scanned.
    procedure set_language_variant_jsx(this, v: bool)
        set jsx_variant: v

    ; The reference's two reporting helpers:
    ;
    ;     func (s *Scanner) error(d *Message)  { s.errorAt(d, s.pos, 0) }
    ;     func (s *Scanner) errorAt(d *Message, pos int, length int) {
    ;         if s.onError != nil { s.onError(d, pos, length, args...) }
    ;     }
    ;
    ; ★ `error` reports a ZERO-LENGTH span at the CURRENT position, which is not
    ; a detail: an unterminated string answers `D 13 13`, the empty range at the
    ; line break, and a port that spanned the literal instead would differ on
    ; every such case. The length is added to the pos to make the end, so the two
    ; helpers are one function with a default.
    procedure error(this, code: int)
        this.error_at(code, state.pos, 0)

    procedure error_at(this, code: int, pos: int, length: int)
    {
        if diagnostics <> null
            diagnostics.add(pos, pos + length, code)
    }

    ; True once scan() has answered end-of-file.
    ;
    ; This exists because a module-level `define` constant of one package is NOT
    ; visible from another (root CLAUDE.md: export the VALUE behind an entry
    ; point, never a cross-package constant) — and that includes a program root,
    ; where `k = KindEndOfFile` is a hard `unknown identifier` even with the
    ; `use` the diagnostic suggests. Every caller outside this package needs the
    ; question answered rather than the constant exported, so the question is
    ; what is exported. The alternative — writing the literal 1 at each call
    ; site — is the same magic number the Kind file exists to abolish.
    function at_eof(this) returns bool
        state.token = KindEndOfFile

    ; The reference's HasPrecedingLineBreak() — the parser asks it for automatic
    ; semicolon insertion and for the "no line break here" restrictions.
    ;
    ; ★ The parentheses are load-bearing: `&` binds WEAKER than `=` in Scaly
    ; (5 against 6), so `flags & F <> 0` would parse as `flags & (F <> 0)`.
    function has_preceding_line_break(this) returns bool
        (state.token_flags & TokenFlagsPrecedingLineBreak) <> 0

    function has_unicode_escape(this) returns bool
        (state.token_flags & TokenFlagsUnicodeEscape) <> 0

    function has_extended_unicode_escape(this) returns bool
        (state.token_flags & TokenFlagsExtendedUnicodeEscape) <> 0

    ; The three JSDoc questions the parser asks of the token it is about to
    ; consume. The scanner already records all of them while skipping trivia;
    ; these are the reference's HasPrecedingJSDocComment(),
    ; HasPrecedingJSDocWithDeprecatedTag() and HasPrecedingJSDocWithSeeOrLink().
    function has_preceding_jsdoc_comment(this) returns bool
        (state.token_flags & TokenFlagsPrecedingJSDocComment) <> 0

    ; ★★★ The reference's HasPrecedingJSDocLeadingAsterisks, and its ONE reader is
    ; the reason the flag exists at all: createIdentifier takes the token's START
    ; rather than its FULL start when a margin `*` was skipped in front of it.
    ; Without that, an identifier written after a JSDoc margin swallows the
    ; margin into its own range — `{{\n *   a: string}}` gives the property name
    ; a pos of 15 where the reference says 21. Slice 21 shipped the flag and the
    ; scan arm a day before the reader; see create_identifier_with_diagnostic.
    function has_preceding_jsdoc_leading_asterisks(this) returns bool
        (state.token_flags & TokenFlagsPrecedingJSDocLeadingAsterisks) <> 0

    function has_preceding_jsdoc_with_deprecated_tag(this) returns bool
        (state.token_flags & TokenFlagsPrecedingJSDocWithDeprecated) <> 0

    function has_preceding_jsdoc_with_see_or_link(this) returns bool
        (state.token_flags & TokenFlagsPrecedingJSDocWithSeeOrLink) <> 0

    ; ── speculation ─────────────────────────────────────────────────────────
    ;
    ; Mark()/Rewind() are the whole reason the mutable block is one named value
    ; (CLAUDE.md §3.5): the parser looks ahead by saving the block, scanning on,
    ; and putting it back. Everything the scan mutates lives in ScannerState, so
    ; restoring it is exact — `buffer`, `end` and `skip_trivia` never move.
    ;
    ; `unported_pos` is deliberately NOT restored. It records that this port met
    ; a construct it cannot scan, which stays true whether or not the parser
    ; keeps the speculative branch — un-setting it would hide the omission at
    ; exactly the moment it was found.
    function mark(this) returns ScannerState
        state

    procedure rewind(this, saved: ScannerState)
        set state: saved

    ; ResetPos — move the scan to an arbitrary position, whole:
    ;
    ;     s.pos = pos; s.fullStartPos = pos; s.tokenStart = pos
    ;
    ; ★ It is NOT a rewind, and the difference is the point. A rewind restores a
    ; state that was OBSERVED, so `token` and `token_flags` still describe the
    ; token the parser is holding; this jumps to a position nobody has scanned,
    ; so those two are left stale ON PURPOSE and the caller owes an immediate
    ; next_token() before reading either. The reference leaves them alone here
    ; too and has ResetTokenState for the other half of the question — not
    ; ported, because nothing asks it.
    ;
    ; One caller: reparse_top_level_await, which re-reads a statement it has
    ; already parsed once, this time with AwaitContext set.
    procedure reset_pos(this, pos: int)
    {
        set state.pos: pos
        set state.full_start_pos: pos
        set state.token_start: pos
    }

    ; ── UTF-8 ───────────────────────────────────────────────────────────────
    ;
    ; The reference reaches for `charAndSize()` — a decoded rune plus its byte
    ; length — in exactly the places where a non-ASCII character can change the
    ; answer: inside both comment bodies, in the default arm of the scan switch,
    ; and after a backslash. Everywhere else it stays byte-wise, and so do we.
    ;
    ; Go returns (RuneError, 1) for an INVALID sequence and (RuneError, 3) for a
    ; correctly encoded U+FFFD, and the reference's binary-file check compares
    ; against RuneError without distinguishing the two. That quirk is ported: a
    ; file containing a literal U+FFFD is declared binary. It is the reference's
    ; behaviour, and diverging silently would be worse than reproducing it.
    ;
    ; Split into two pure functions rather than one returning a pair: Scaly
    ; returns a single value, and a hidden "last size" field is state that can go
    ; stale. Re-reading the lead byte costs nothing.

    ; Byte length of the sequence at p — 1 for an invalid one, which is exactly
    ; how Go resynchronizes. The accept ranges reject overlong forms, the
    ; surrogate block and anything past U+10FFFF.
    ; ── UTF-8, over an arbitrary buffer ─────────────────────────────────────
    ;
    ; The pair below reads a rune at an offset into `base`, bounded by `limit`.
    ; They grew that pair of parameters in slice 17: the keyword spell-checker
    ; used to read the identifier out of the SOURCE and now reads the node's
    ; stored TEXT, which is a decoded value living somewhere else entirely. The
    ; `_at` forms are the same question asked of the source and are unchanged.
    function utf8_size_in(this, base: pointer[char], limit: int, p: int) returns int
    {
        if p >= limit
            return 1
        let b0 *(base + p) as int
        if b0 < 0x80
            return 1
        if b0 < 0xC2
            return 1
        var need: int 0
        var lo: int 0x80
        var hi: int 0xBF
        if b0 <= 0xDF
            set need: 1
        else
        {
            if b0 <= 0xEF
            {
                set need: 2
                if b0 = 0xE0
                    set lo: 0xA0
                if b0 = 0xED
                    set hi: 0x9F
            }
            else
            {
                if b0 > 0xF4
                    return 1
                set need: 3
                if b0 = 0xF0
                    set lo: 0x90
                if b0 = 0xF4
                    set hi: 0x8F
            }
        }
        if p + need >= limit
            return 1
        let c1 *(base + p + 1) as int
        if (c1 < lo) or (c1 > hi)
            return 1
        var i: int 2
        while i <= need
        {
            let c *(base + p + i) as int
            if (c < 0x80) or (c > 0xBF)
                return 1
            set i: i + 1
        }
        need + 1
    }

    function utf8_size_at(this, p: int) returns int
        this.utf8_size_in(buffer, end, p)

    function utf8_decode_in(this, base: pointer[char], limit: int, p: int) returns int
    {
        let n this.utf8_size_in(base, limit, p)
        if p >= limit
            return 0 - 1
        let b0 *(base + p) as int
        if n = 1
        {
            if b0 < 0x80
                return b0
            ; An invalid sequence decodes to U+FFFD, as Go's RuneError does.
            return 0xFFFD
        }
        var cp: int 0
        if n = 2
            set cp: b0 & 0x1F
        else
        {
            if n = 3
                set cp: b0 & 0x0F
            else
                set cp: b0 & 0x07
        }
        var i: int 1
        while i < n
        {
            set cp: (cp << 6) | ((*(base + p + i) as int) & 0x3F)
            set i: i + 1
        }
        cp
    }

    function utf8_decode_at(this, p: int) returns int
        this.utf8_decode_in(buffer, end, p)

    ; ── character classes over decoded runes ────────────────────────────────

    ; The reference's IsLineBreak: LF, CR, and the two ECMAScript separators.
    ; NOTE it is NOT the same predicate the string scanner uses — that one
    ; compares bytes against '\n' and '\r' only, so U+2028 inside a string
    ; literal is an ordinary character. Do not unify them.
    function is_line_break_rune(c: int) returns bool
    {
        if (c = 10) or (c = 13)
            return true
        (c = 0x2028) or (c = 0x2029)
    }

    ; The reference's IsWhiteSpaceSingleLine. U+0085 (next line) is in here and
    ; deliberately NOT in the line-break set — it is Zs, and ECMAScript's line
    ; terminator table does not list it.
    function is_white_space_single_line(c: int) returns bool
    {
        if (c = 32) or (c = 9) or (c = 11) or (c = 12)
            return true
        if (c = 0x0085) or (c = 0x00A0) or (c = 0x1680)
            return true
        if (c >= 0x2000) and (c <= 0x200A)
            return true
        if (c = 0x202F) or (c = 0x205F) or (c = 0x3000)
            return true
        c = 0xFEFF
    }

    ; The reference's stringutil.IsWhiteSpaceLike — the single-line set plus the
    ; line terminators. Both halves are above; this is the union, named because
    ; upstream names it, and its one caller is the trailing trim of
    ; re_scan_slash_token.
    function is_white_space_like(c: int) returns bool
    {
        if is_white_space_single_line(c)
            return true
        is_line_break_rune(c)
    }

    ; ── digit classification ────────────────────────────────────────────────

    function is_octal_digit(c: int) returns bool
        (c >= ("0" as char) as int) and (c <= ("7" as char) as int)

    function is_hex_digit(c: int) returns bool
    {
        if is_digit(c)
            return true
        if (c >= ("a" as char) as int) and (c <= ("f" as char) as int)
            return true
        (c >= ("A" as char) as int) and (c <= ("F" as char) as int)
    }

    function hex_digit_value(c: int) returns int
    {
        if is_digit(c)
            return c - (("0" as char) as int)
        if (c >= ("a" as char) as int) and (c <= ("f" as char) as int)
            return (c - (("a" as char) as int)) + 10
        (c - (("A" as char) as int)) + 10
    }

    ; True when every digit in [from, to) is an octal digit. The reference
    ; computes this inside scanDigits and returns it alongside the text; splitting
    ; it out keeps scan_digits single-valued instead of hiding a second result in
    ; a field.
    function all_octal(this, from: int, to: int) returns bool
    {
        var i: int from
        while i < to
        {
            if not is_octal_digit(*(buffer + i) as int)
                return false
            set i: i + 1
        }
        true
    }

    ; The reference parses hex text with strconv.ParseInt(_, 16, 32) and IGNORES
    ; the error, so an overflowing sequence yields MaxInt32 — which is above
    ; 0x10FFFF and therefore rejected as an invalid extended escape. Clamping
    ; preserves exactly that outcome without needing the same overflow value.
    function hex_value(this, from: int, to: int) returns int
    {
        var v: int 0
        var i: int from
        while i < to
        {
            let c *(buffer + i) as int
            if is_hex_digit(c)
            {
                set v: (v * 16) + hex_digit_value(c)
                if v > 0x7FFFFFFF
                    set v: 0x7FFFFFFF
            }
            set i: i + 1
        }
        v
    }

    function is_high_surrogate(c: int) returns bool
        (c >= 0xD800) and (c <= 0xDBFF)

    function is_low_surrogate(c: int) returns bool
        (c >= 0xDC00) and (c <= 0xDFFF)

    ; ── numeric literals ────────────────────────────────────────────────────

    ; The reference's scanHexDigits, minus the string it builds: answers how many
    ; HEX DIGITS were consumed (separators excluded) so the caller can apply its
    ; `digitCount < minCount` test. NOTE that on that failure the reference does
    ; NOT rewind — pos stays where the scan stopped — so neither does this.
    procedure scan_hex_digits(this, min_count: int, scan_many: bool, can_sep: bool) returns int
    {
        var digit_count: int 0
        var allow_sep: bool false
        var prev_sep: bool false
        while (digit_count < min_count) or scan_many
        {
            let c this.char()
            if is_hex_digit(c)
            {
                set allow_sep: can_sep
                set prev_sep: false
                set digit_count: digit_count + 1
            }
            else
            {
                if not (can_sep and (c = ("_" as char) as int))
                    break
                ; The reference's separator arms here differ from
                ; scan_number_fragment's: they set ContainsSeparator and then only
                ; REPORT — no ContainsInvalidSeparator. Do not "unify" the two.
                set state.token_flags: state.token_flags | TokenFlagsContainsSeparator
                if allow_sep
                {
                    set allow_sep: false
                    set prev_sep: true
                }
                else
                {
                    if prev_sep
                        this.error_at(DiagMultiple_consecutive_numeric_separators_are_not_permitted, state.pos, 1)
                    else
                        this.error_at(DiagNumeric_separators_are_not_allowed_here, state.pos, 1)
                }
            }
            set state.pos: state.pos + 1
        }
        ; A TRAILING separator is reported at the character before the cursor.
        if prev_sep
            this.error_at(DiagNumeric_separators_are_not_allowed_here, state.pos - 1, 1)
        digit_count
    }

    ; The reference's scanNumberFragment, minus the string: answers how many
    ; DIGITS were consumed, which is exactly its emptiness test — `result` only
    ; ever receives text after digits have been seen, so zero digits means the
    ; empty string.
    procedure scan_number_fragment(this) returns int
    {
        var digits: int 0
        var allow_sep: bool false
        var prev_sep: bool false
        repeat
        {
            let before state.pos
            while is_digit(this.char())
                set state.pos: state.pos + 1
            if state.pos > before
            {
                set digits: digits + (state.pos - before)
                set allow_sep: true
                set prev_sep: false
            }
            if this.char() <> ("_" as char) as int
                break
            set state.token_flags: state.token_flags | TokenFlagsContainsSeparator
            if allow_sep
            {
                set allow_sep: false
                set prev_sep: true
            }
            else
            {
                ; The FLAG is unconditional in the reference; the two messages
                ; under it differ on isPreviousTokenSeparator.
                set state.token_flags: state.token_flags | TokenFlagsContainsInvalidSeparator
                if prev_sep
                    this.error_at(DiagMultiple_consecutive_numeric_separators_are_not_permitted, state.pos, 1)
                else
                    this.error_at(DiagNumeric_separators_are_not_allowed_here, state.pos, 1)
            }
            set state.pos: state.pos + 1
        }
        if prev_sep
        {
            set state.token_flags: state.token_flags | TokenFlagsContainsInvalidSeparator
            this.error_at(DiagNumeric_separators_are_not_allowed_here, state.pos - 1, 1)
        }
        digits
    }

    procedure scan_digits(this) returns int
    {
        let start state.pos
        while is_digit(this.char())
            set state.pos: state.pos + 1
        state.pos - start
    }

    procedure scan_binary_or_octal_digits(this, base: int) returns int
    {
        var digits: int 0
        var allow_sep: bool false
        var prev_sep: bool false
        repeat
        {
            let c this.char()
            if is_digit(c) and ((c - (("0" as char) as int)) < base)
            {
                set digits: digits + 1
                set allow_sep: true
                set prev_sep: false
            }
            else
            {
                if c <> ("_" as char) as int
                    break
                set state.token_flags: state.token_flags | TokenFlagsContainsSeparator
                if allow_sep
                {
                    set allow_sep: false
                    set prev_sep: true
                }
                else
                {
                    if prev_sep
                        this.error_at(DiagMultiple_consecutive_numeric_separators_are_not_permitted, state.pos, 1)
                    else
                        this.error_at(DiagNumeric_separators_are_not_allowed_here, state.pos, 1)
                }
            }
            set state.pos: state.pos + 1
        }
        if prev_sep
            this.error_at(DiagNumeric_separators_are_not_allowed_here, state.pos - 1, 1)
        digits
    }

    ; scanBigIntSuffix, both arms. The `n` takes the bigint stand-in above; the
    ; other arm is where a HEX, BINARY or OCTAL literal — and a plain integer
    ; with no fraction and no exponent — gets its value normalized, which is why
    ; the three radix arms of scan() do not call jsnum themselves.
    procedure scan_big_int_suffix(this) returns int
    {
        if this.char() = ("n" as char) as int
        {
            set state.pos: state.pos + 1
            this.set_bigint_token_value()
            return KindBigIntLiteral
        }
        this.normalize_numeric_token_value()
        KindNumericLiteral
    }

    ; The reference's scanIdentifierParts, for the caller that needs its LENGTH
    ; and not its text: scan_number's trailing-name check.
    ;
    ; ★★★ IT IS THE SECOND PORT OF ONE REFERENCE ROUTINE, and the split is what
    ; §3.9d/§3.9e prescribes for a routine whose two call sites want two
    ; different ANSWERS out of it. `scanIdentifierParts` returns a string; the
    ; JSX scanner appends that string to the token value, which is
    ; scan_identifier_parts_into_sink, and scan_number reads only `len(id)` and
    ; throws the text away — it REWINDS pos over the whole run, so no consumer
    ; of a value exists on this path at all. Routing this call through the sink
    ; instead would arm a value buffer inside a numeric scan, whose value is set
    ; from a source RANGE after scan_number returns; the two would have to be
    ; kept from meeting for no gain.
    ;
    ; ★★ The length is the DECODED byte count, because Go's is: an escape
    ; contributes the UTF-8 length of the rune it decodes to (`sb.WriteRune`),
    ; not the six or more source bytes it was written with. Its one reader tests
    ; `= 1`, and that test is only ever reached when the first SOURCE byte is a
    ; literal `n`, so exactness beyond "one, or more than one" is unobservable
    ; here — it is written this way because the reference's is, not because a
    ; fixture can tell.
    ;
    ; ★ The walk itself is observable in two ways that have nothing to do with
    ; the length: scan_unicode_escape sets UnicodeEscape or
    ; ExtendedUnicodeEscape ON THE NUMERIC TOKEN, and pos decides the span of
    ; the diagnostic the caller reports. Both are compared — see
    ; number_trailing_name.ts.
    procedure scan_identifier_parts_length(this) returns int
    {
        var len: int 0
        repeat
        {
            let c this.utf8_decode_at(state.pos)
            if is_identifier_part(c)
            {
                let size this.utf8_size_at(state.pos)
                set state.pos: state.pos + size
                set len: len + size
                continue
            }
            if c = ("\\" as char) as int
            {
                let esc this.peek_unicode_escape()
                if esc >= 0
                {
                    if is_identifier_part(esc)
                    {
                        let cp this.scan_unicode_escape(true)
                        set len: len + utf8_encoded_size(cp)
                        continue
                    }
                }
            }
            break
        }
        len
    }

    procedure scan_number(this) returns int
    {
        let start state.pos

        if this.char() = ("0" as char) as int
        {
            set state.pos: state.pos + 1
            if this.char() = ("_" as char) as int
            {
                ; `0_` — the separator is rejected outright and the whole literal
                ; is re-scanned from the start as an ordinary fragment. The
                ; report comes FIRST, at the `_`, i.e. before pos is rewound.
                set state.token_flags: state.token_flags | TokenFlagsContainsSeparator | TokenFlagsContainsInvalidSeparator
                this.error_at(DiagNumeric_separators_are_not_allowed_here, state.pos, 1)
                set state.pos: start
                this.scan_number_fragment()
            }
            else
            {
                let dstart state.pos
                let n this.scan_digits()
                ; n = 0 is a bare `0`, which continues into the fraction and
                ; exponent below.
                if n > 0
                {
                    if this.all_octal(dstart, state.pos)
                    {
                        ; A legacy octal literal (`0777`). Reported, and the
                        ; scan RETURNS here, so no fraction or exponent is read
                        ; afterwards — `077.5` is the octal 077 followed by `.5`,
                        ; not a decimal.
                        ;
                        ; The span reaches back over a preceding MINUS, because
                        ; the message suggests `-0o…` as the replacement and the
                        ; sign is part of what has to be rewritten. `state.token`
                        ; is still the PREVIOUS token here — it is assigned after
                        ; the scan — which is what makes that test possible.
                        this.set_octal_token_value(dstart, state.pos)
                        set state.token_flags: state.token_flags | TokenFlagsOctal
                        var octal_start start
                        if state.token = KindMinusToken
                            set octal_start: octal_start - 1
                        this.error_at(DiagOctal_literals_are_not_allowed_Use_the_syntax_0, octal_start, state.pos - octal_start)
                        return KindNumericLiteral
                    }
                    set state.token_flags: state.token_flags | TokenFlagsContainsLeadingZero
                }
            }
        }
        else
            this.scan_number_fragment()

        let fixed_part_end state.pos

        if this.char() = ("." as char) as int
        {
            set state.pos: state.pos + 1
            this.scan_number_fragment()
        }

        var end_pos: int state.pos

        if (this.char() = ("E" as char) as int) or (this.char() = ("e" as char) as int)
        {
            set state.pos: state.pos + 1
            set state.token_flags: state.token_flags | TokenFlagsScientific
            if (this.char() = ("+" as char) as int) or (this.char() = ("-" as char) as int)
                set state.pos: state.pos + 1
            let e this.scan_number_fragment()
            if e = 0
                this.error(DiagDigit_expected)
            else
                set end_pos: state.pos
        }

        ; The reference's tokenValue, over the span the EXPONENT decided: an `e`
        ; with no digits after it left end_pos where it was, so the `e` is not
        ; part of the value even though it is part of the token.
        this.set_numeric_raw_value(start, end_pos)

        ; A leading-zero decimal reports and returns before the trailing-name
        ; check below can move pos.
        if (state.token_flags & TokenFlagsContainsLeadingZero) <> 0
        {
            this.error_at(DiagDecimals_with_leading_zeros_are_not_allowed, start, state.pos - start)
            this.normalize_numeric_token_value()
            return KindNumericLiteral
        }

        var result: int KindNumericLiteral
        if fixed_part_end = state.pos
            set result: this.scan_big_int_suffix()
        else
            this.normalize_numeric_token_value()

        ; A name immediately after a numeric literal is an error, and the
        ; reference RESTORES pos so the name is scanned as its own token — except
        ; on two bigint-specific paths, where it returns with pos past the name.
        ; Both are observable in the token stream, so both are ported.
        ;
        ; ★★★ THE CHARACTER IS DECODED HERE, and this is the ONE arm of scan()
        ; that does — see the file header's note (1), which says a port that
        ; "helpfully" decodes desynchronizes every later span. This is not that:
        ; the reference itself asks `charAndSize()` at this single position,
        ; because the question is whether an IDENTIFIER starts, and identifier
        ; start is a property of a rune. Through slice 24 this read the raw byte
        ; and reported `unported` for anything >= 128, under a header note
        ; claiming nothing reachable from scan() was unported any more — the
        ; class §3.5bn names, an omission with an explanation over it, and stage
        ; 2 reached it twice with a NO-BREAK SPACE after a number, which is not
        ; an identifier start and which the reference simply skips as trivia.
        let after this.utf8_decode_at(state.pos)
        if is_identifier_start(after)
        {
            let id_start state.pos
            let id_len this.scan_identifier_parts_length()
            if (result <> KindBigIntLiteral) and (id_len = 1)
            {
                if (*(buffer + id_start) as int) = ("n" as char) as int
                {
                    ; `1e2n` and `1.5n`: both RETURN with pos past the `n`, so
                    ; the suffix is part of the literal's text even though the
                    ; literal is refused.
                    if (state.token_flags & TokenFlagsScientific) <> 0
                    {
                        this.error_at(DiagA_bigint_literal_cannot_use_exponential_notation, start, state.pos - start)
                        return result
                    }
                    if fixed_part_end < id_start
                    {
                        this.error_at(DiagA_bigint_literal_must_be_an_integer, start, state.pos - start)
                        return result
                    }
                }
            }
            this.error_at(DiagAn_identifier_or_keyword_cannot_immediately_follow_a_numeric_literal, id_start, state.pos - id_start)
            set state.pos: id_start
        }
        result
    }

    ; ── escape sequences ────────────────────────────────────────────────────
    ;
    ; The reference takes an EscapeSequenceScanningFlags parameter. Slice 13b
    ; carries the one bit of it that SELECTS anything here — ReportErrors — as a
    ; plain `report_errors` bool, because under our two callers' flag constants
    ; every other bit is fixed: a string literal passes `String | ReportErrors`
    ; and a template passes `String` plus ReportErrors only from an untagged
    ; re-scan, so RegularExpression, AnyUnicodeMode and AtomEscape are always
    ; clear and AllowExtendedUnicodeEscape is always satisfied. Every branch
    ; those would select is therefore unreachable, which is why the regex arms of
    ; the reference's switch are absent rather than stubbed; they come back with
    ; ReScanSlashToken.
    ;
    ; ★ The bool is not a simplification of a flag word — it is the flag word
    ; restricted to its reachable domain, and the day the regex scanner lands it
    ; becomes the flags again.
    ;
    ; No decoded value is produced — see the file header. What is ported is the
    ; extent, the flags and now the DIAGNOSTICS.

    procedure scan_unicode_escape(this, report_errors: bool) returns int
    {
        set state.pos: state.pos + 2
        let start state.pos
        let extended this.char() = ("{" as char) as int

        var hstart: int state.pos
        var n: int 0
        if extended
        {
            set state.pos: state.pos + 1
            set hstart: state.pos
            set n: this.scan_hex_digits(1, true, false)
        }
        else
        {
            set state.token_flags: state.token_flags | TokenFlagsUnicodeEscape
            set n: this.scan_hex_digits(4, false, false)
        }

        if n = 0
        {
            set state.token_flags: state.token_flags | TokenFlagsContainsInvalidEscape
            if report_errors
                this.error(DiagHexadecimal_digit_expected)
            return 0 - 1
        }
        ; scan_hex_digits does not rewind on a short count, and neither does the
        ; reference — but the non-extended form demands exactly 4.
        ;
        ; ★ Both of these are the reference's ONE `hexDigits == ""` arm: its
        ; scanHexDigits(4, false, false) answers the empty string when it cannot
        ; get four, where ours answers the count it did get. So both report the
        ; same Hexadecimal_digit_expected, and splitting them is our shape, not a
        ; second condition.
        if (not extended) and (n < 4)
        {
            set state.token_flags: state.token_flags | TokenFlagsContainsInvalidEscape
            if report_errors
                this.error(DiagHexadecimal_digit_expected)
            return 0 - 1
        }

        let hex_val this.hex_value(hstart, state.pos)

        if extended
        {
            var invalid: bool false
            if hex_val > 0x10FFFF
            {
                ; ★ start+1 and pos-start-1: the span is the digits INSIDE the
                ; braces, not the escape. The +1 skips the `{`.
                if report_errors
                    this.error_at(DiagAn_extended_Unicode_escape_value_must_be_between_0x0_and_0x10FFFF_inclusive, start + 1, state.pos - start - 1)
                set invalid: true
            }
            if state.pos >= end
            {
                if report_errors
                    this.error(DiagUnexpected_end_of_text)
                set invalid: true
            }
            else
            {
                ; Read the closing brace BEFORE consuming it — testing char()
                ; again afterwards would be testing the character past it.
                if this.char() = ("}" as char) as int
                    set state.pos: state.pos + 1
                else
                {
                    if report_errors
                        this.error(DiagUnterminated_Unicode_escape_sequence)
                    set invalid: true
                }
            }
            if invalid
            {
                set state.token_flags: state.token_flags | TokenFlagsContainsInvalidEscape
                return 0 - 1
            }
            set state.token_flags: state.token_flags | TokenFlagsExtendedUnicodeEscape
        }
        hex_val
    }

    ; Speculative: consumes a following \uXXXX only when it is a low surrogate,
    ; and restores BOTH pos and the flags otherwise — the reference suppresses
    ; diagnostics here for the same reason, since the caller re-scans.
    procedure scan_low_surrogate_escape(this, high: int) returns int
    {
        if this.char() <> ("\\" as char) as int
            return 0 - 1
        if this.char_at(1) <> ("u" as char) as int
            return 0 - 1
        let saved_pos state.pos
        let saved_flags state.token_flags
        let low this.scan_unicode_escape(false)
        if is_low_surrogate(low)
            return low
        set state.pos: saved_pos
        set state.token_flags: saved_flags
        0 - 1
    }

    ; The digits of a legacy octal escape, read back for its VALUE. The
    ; reference's strconv.ParseInt(text[start+1:pos], 8, 32).
    function octal_value(this, start: int, stop: int) returns int
    {
        var v: int 0
        var i start
        while i < stop
        {
            set v: (v * 8) + ((*(buffer + i) as int) - (("0" as char) as int))
            set i: i + 1
        }
        v
    }

    ; `report_errors` is the reference's ReportInvalidEscapeErrors bit; see
    ; scan_unicode_escape above for why one bool covers the flag word here.
    ;
    ; ★★★ Since slice 17 this also WRITES the escape's decoded bytes into the
    ; value sink, which is what the reference's `return "…"` does — its
    ; scanEscapeSequence returns a string and every arm of it is a decoded
    ; value. Until the sink existed those returns had nowhere to go, so the arms
    ; that differ only in what they DECODE TO were folded into one ("any other
    ; escaped ASCII character stands for itself"). ★ That fold was correct for
    ; positions and wrong for values, and the two it hid are the ones a reader
    ; would least expect: `\n` is the letter n and must decode to a LINE FEED,
    ; and a backslash followed by an actual line terminator is a line
    ; CONTINUATION and must decode to nothing at all. Both are the reference's
    ; own arms and both are back.
    ;
    ; ★★★ IT ANSWERS NOTHING, and it used to answer a `bool` that was ALWAYS
    ; TRUE. The reference's returns a string and cannot fail; the bool was this
    ; port's own stand-in from the slices before the value sink existed, and its
    ; three readers each turned a `false` into an `unported` report — a hatch
    ; that could not fire, over a construct that was in fact ported. That is the
    ; §3.5bn class exactly, and the direction it fails in is the flattering one:
    ; the reports were unreachable, so nothing ever looked wrong. Retired in
    ; slice 25 with the last reachable `unported` of this file. The proof is a
    ; grep — no `return false` occurs between this line and the routine's end.
    procedure scan_escape_sequence(this, report_errors: bool)
    {
        let start state.pos
        set state.pos: state.pos + 1
        let ch this.char()
        if ch < 0
        {
            ; ★ UNCONDITIONAL in the reference — this `s.error` sits ABOVE the
            ; flags test, so a backslash at end of text reports even in a tagged
            ; template where every escape error below is suppressed.
            this.error(DiagUnexpected_end_of_text)
            return
        }
        set state.pos: state.pos + 1

        ; \0 not followed by a digit is the NUL escape and nothing more.
        if ch = ("0" as char) as int
        {
            if not is_digit(this.char())
            {
                this.value_put_byte(0)
                return
            }
        }

        ; Legacy octal escapes. `\0`-`\3` admit two more octal digits (the
        ; reference reaches the '4'..'7' arm by fallthrough), `\4`-`\7` only one.
        ;
        ; ★ The VALUE differs between the two flag settings, and that is the
        ; reference's own asymmetry rather than a shortcut: with errors reported
        ; the arm answers the DECODED character, without them it answers the raw
        ; source of the escape. So a tagged template keeps `\47` and a string
        ; literal turns it into `'`.
        if (ch >= ("0" as char) as int) and (ch <= ("3" as char) as int)
        {
            if is_octal_digit(this.char())
                set state.pos: state.pos + 1
            if is_octal_digit(this.char())
                set state.pos: state.pos + 1
            set state.token_flags: state.token_flags | TokenFlagsContainsInvalidEscape
            if report_errors
            {
                this.error_at(DiagOctal_escape_sequences_are_not_allowed_Use_the_syntax_0, start, state.pos - start)
                this.value_put_codepoint(this.octal_value(start + 1, state.pos))
            }
            else
                this.value_put_range(start, state.pos)
            return
        }
        if (ch >= ("4" as char) as int) and (ch <= ("7" as char) as int)
        {
            if is_octal_digit(this.char())
                set state.pos: state.pos + 1
            set state.token_flags: state.token_flags | TokenFlagsContainsInvalidEscape
            if report_errors
            {
                this.error_at(DiagOctal_escape_sequences_are_not_allowed_Use_the_syntax_0, start, state.pos - start)
                this.value_put_codepoint(this.octal_value(start + 1, state.pos))
            }
            else
                this.value_put_range(start, state.pos)
            return
        }
        if (ch = ("8" as char) as int) or (ch = ("9" as char) as int)
        {
            set state.token_flags: state.token_flags | TokenFlagsContainsInvalidEscape
            if report_errors
            {
                this.error_at(DiagEscape_sequence_0_is_not_allowed, start, state.pos - start)
                this.value_put_byte(ch)
            }
            else
                this.value_put_range(start, state.pos)
            return
        }

        ; \x followed by exactly two hex digits.
        if ch = ("x" as char) as int
        {
            while state.pos < start + 4
            {
                if not is_hex_digit(this.char())
                {
                    set state.token_flags: state.token_flags | TokenFlagsContainsInvalidEscape
                    if report_errors
                        this.error(DiagHexadecimal_digit_expected)
                    this.value_put_range(start, state.pos)
                    return
                }
                set state.pos: state.pos + 1
            }
            set state.token_flags: state.token_flags | TokenFlagsHexEscape
            this.value_put_codepoint(this.hex_value(start + 2, state.pos))
            return
        }

        if ch = ("u" as char) as int
        {
            ; scan_unicode_escape re-reads the `\u`, so back up over both bytes.
            set state.pos: state.pos - 2
            let cp this.scan_unicode_escape(report_errors)
            if cp < 0
            {
                this.value_put_range(start, state.pos)
                return
            }
            ; ★ A high surrogate escape followed by a low one is ONE code point
            ; in a string literal, exactly as the adjacent UTF-16 code units
            ; would be in a JavaScript string. A lone surrogate survives as its
            ; own three UTF-8 bytes — see value_put_codepoint for why that needs
            ; no arm of its own.
            if is_high_surrogate(cp)
            {
                let low this.scan_low_surrogate_escape(cp)
                if low >= 0
                {
                    this.value_put_codepoint(0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00))
                    return
                }
            }
            this.value_put_codepoint(cp)
            return
        }

        ; The named single-character escapes. Each is one line in the reference
        ; and each is a VALUE — the position is the same for all of them, which
        ; is why they read as one arm until the sink existed.
        if ch = ("b" as char) as int
        {
            this.value_put_byte(8)
            return
        }
        if ch = ("t" as char) as int
        {
            this.value_put_byte(9)
            return
        }
        if ch = ("n" as char) as int
        {
            this.value_put_byte(10)
            return
        }
        if ch = ("v" as char) as int
        {
            this.value_put_byte(11)
            return
        }
        if ch = ("f" as char) as int
        {
            this.value_put_byte(12)
            return
        }
        if ch = ("r" as char) as int
        {
            this.value_put_byte(13)
            return
        }

        ; A line continuation: backslash then a line terminator sequence, which
        ; "is interpreted to be the empty code unit sequence". <CR><LF> counts as
        ; ONE terminator, which is what the inner test is for.
        if ch = ("\r" as char) as int
        {
            if this.char() = ("\n" as char) as int
                set state.pos: state.pos + 1
            return
        }
        if ch = ("\n" as char) as int
            return

        ; An escaped MULTI-BYTE character. The reference backs up over the
        ; single-byte advance and re-advances by the rune's real size; guessing
        ; one byte here would shift every span that follows.
        if ch >= 128
        {
            set state.pos: state.pos - 1
            let cp this.utf8_decode_at(state.pos)
            set state.pos: state.pos + this.utf8_size_at(state.pos)
            ; U+2028 and U+2029 are line terminators, so escaping one is a line
            ; continuation like the two above and decodes to nothing.
            if (cp = 0x2028) or (cp = 0x2029)
                return
            this.value_put_codepoint(cp)
            return
        }

        ; Any other escaped ASCII character stands for itself — `\'`, `\"`,
        ; `\\`, `\``, and everything unlisted.
        this.value_put_byte(ch)
    }

    ; ── identifiers ─────────────────────────────────────────────────────────

    ; The reference's IsIdentifierStart / IsIdentifierPart. The ASCII half is
    ; spelled out and only a byte >= 0x80 reaches the tables, which is the
    ; reference's own arrangement (`ch >= utf8.RuneSelf && IsUnicode...`).
    function is_identifier_start(c: int) returns bool
    {
        if is_ident_start_ascii(c)
            return true
        if c < 128
            return false
        is_unicode_identifier_start(c)
    }

    ; ★ The reference has a SECOND form of this, `IsIdentifierPartEx(ch, variant)`,
    ; which admits `-` and `:` under the JSX variant — and it is deliberately NOT
    ; ported, because nothing in the SCANNER calls it: `scanIdentifierParts` uses
    ; the plain predicate, and the JSX rule is carried by ScanJsxIdentifier's own
    ; `-` arm and by the parser's `parse_optional(KindColonToken)`. Its one caller
    ; upstream is `IsIdentifierText`, a language-service utility. Stated here
    ; because ScanJsxIdentifier's comment names both characters and reads like an
    ; instruction to widen this function.
    function is_identifier_part(c: int) returns bool
    {
        ; isWordCharacter || '$' — letters, digits, underscore, dollar.
        if is_ident_part_ascii(c)
            return true
        if c < 128
            return false
        is_unicode_identifier_part(c)
    }

    ; The reference's peekUnicodeEscape: scan a `\uXXXX` WITHOUT keeping any of
    ; it — neither the position nor the flags — so the caller can decide whether
    ; it is an identifier before committing.
    procedure peek_unicode_escape(this) returns int
    {
        if this.char_at(1) <> ("u" as char) as int
            return 0 - 1
        let saved_pos state.pos
        let saved_flags state.token_flags
        let cp this.scan_unicode_escape(false)
        set state.pos: saved_pos
        set state.token_flags: saved_flags
        cp
    }

    ; The reference's scanIdentifier(prefixLength). The prefix exists for `#`: a
    ; private name is one token whose text INCLUDES the `#`, scanned by stepping
    ; over it and starting there.
    ;
    ; Answers 1 for a plain identifier — its value is exactly the source bytes
    ; [start, pos), and it SETS it, which is the reference's own
    ; `s.tokenValue = s.text[start:s.pos]` — 2 for one that ends at a backslash
    ; and therefore has a DECODED value that differs from its source, which the
    ; caller gets by running scan_identifier_decoded, and 0 for "not an
    ; identifier", with pos left at start + prefixLength as the reference leaves
    ; it and with no value set (the reference leaves tokenValue alone too, and
    ; its one caller assigns `"#"` over it).
    procedure scan_identifier(this, prefix_len: int) returns int
    {
        let start state.pos
        set state.pos: state.pos + prefix_len
        let c0 this.char()
        if is_ident_start_ascii(c0)
        {
            set state.pos: state.pos + 1
            while is_ident_part_ascii(this.char())
                set state.pos: state.pos + 1
            let after this.char()
            ; The ASCII fast path holds while the next byte is ASCII and not a
            ; backslash; otherwise the reference rewinds and redoes the whole
            ; identifier through the unicode tables.
            if (after < 128) and (after <> ("\\" as char) as int)
            {
                this.set_token_value_range(start, state.pos)
                return 1
            }
            set state.pos: start + prefix_len
        }

        let cp this.utf8_decode_at(state.pos)
        if not is_identifier_start(cp)
            return 0

        var c: int cp
        var sz: int this.utf8_size_at(state.pos)
        repeat
        {
            set state.pos: state.pos + sz
            set c: this.utf8_decode_at(state.pos)
            set sz: this.utf8_size_at(state.pos)
            if not is_identifier_part(c)
                break
        }
        if c = ("\\" as char) as int
            return 2
        this.set_token_value_range(start, state.pos)
        1
    }

    ; Re-scan an identifier from `start` while DECODING it, and answer the Kind
    ; its decoded text maps to. The decoded text is left as the token VALUE,
    ; which is what the reference's
    ; `s.tokenValue = string(s.scanUnicodeEscape(true)) + s.scanIdentifierParts()`
    ; leaves behind before it asks GetIdentifierToken.
    ;
    ; ★ This exists because the keyword lookup is over the DECODED value, not the
    ; source: `const` is the keyword `const`. Nothing that reads raw source
    ; bytes can see that.
    ;
    ; Two passes rather than one, deliberately. The plain case — every identifier
    ; in almost every file — then costs nothing at all, and only an identifier
    ; that actually contains an escape is scanned twice. The escape flags are set
    ; by OR, so setting them again on the second pass changes nothing.
    ;
    ; ★ The decode buffer used to be SIXTEEN BYTES, sized by the keyword guard —
    ; a decoded identifier longer than the table's longest keyword cannot be a
    ; keyword whatever its bytes are, so only the LENGTH had to keep counting.
    ; Slice 17 removed that ceiling with the reason for it: the bytes past it are
    ; the identifier's VALUE and a node stores them now, so the sink is sized to
    ; the source span instead (see value_begin for why that bound is exact where
    ; the caller knows the end, and why growing is correct where it does not).
    ; `prefix_len` is scan_identifier's, and it carries the same fact: a private
    ; name's value INCLUDES its `#`, so the byte before `start` is copied
    ; verbatim ahead of the decode — which is literally the reference's
    ; `s.tokenValue = "#" + string(...) + s.scanIdentifierParts()`.
    procedure scan_identifier_decoded(this, start: int, prefix_len: int) returns int
    {
        ; The two callers that reach here after scan_identifier already know the
        ; end, and for them this is the exact length. The two that come off a
        ; leading backslash do not, and pass 0 — value_begin grows.
        let hint (state.pos - start) + prefix_len
        set state.pos: start
        this.value_begin(hint)
        this.value_put_range(start - prefix_len, start)
        var first: bool true

        repeat
        {
            var cp: int 0 - 1

            if this.char() = ("\\" as char) as int
            {
                let esc this.peek_unicode_escape()
                if esc < 0
                    break
                if first
                {
                    if not is_identifier_start(esc)
                        break
                }
                else
                {
                    if not is_identifier_part(esc)
                        break
                }
                ; Commit the escape for real — this is the call that sets the
                ; UnicodeEscape / ContainsInvalidEscape flags.
                set cp: this.scan_unicode_escape(true)
            }
            else
            {
                let c this.utf8_decode_at(state.pos)
                if first
                {
                    if not is_identifier_start(c)
                        break
                }
                else
                {
                    if not is_identifier_part(c)
                        break
                }
                set cp: c
                set state.pos: state.pos + this.utf8_size_at(state.pos)
            }

            set first: false
            this.value_put_codepoint(cp)
        }

        this.value_commit()
        get_identifier_token(state.token_value, state.token_value_len)
    }

    ; ── merge-conflict markers ──────────────────────────────────────────────
    ;
    ; `<<<<<<<`, `|||||||`, `=======` and `>>>>>>>` at the start of a line are
    ; TRIVIA, not operators. Reachable straight from the scan loop, and no case
    ; in the corpus contains one — so leaving it out would have been a divergence
    ; that stayed green forever. That is exactly the class this port is organized
    ; against, which is why it is here rather than on a list.

    ; Decode the LAST rune of buffer[0, limit), or -1. Go's
    ; DecodeLastRuneInString scans back at most four bytes for a lead byte and
    ; answers RuneError when it finds none.
    function utf8_decode_last_before(this, limit: int) returns int
    {
        if limit <= 0
            return 0 - 1
        let last *(buffer + limit - 1) as int
        if last < 0x80
            return last
        var back: int 1
        while back <= 4
        {
            let p limit - back
            if p < 0
                return 0xFFFD
            let b *(buffer + p) as int
            if b >= 0xC0
            {
                if this.utf8_size_at(p) = back
                    return this.utf8_decode_at(p)
                return 0xFFFD
            }
            if b < 0x80
                return 0xFFFD
            set back: back + 1
        }
        0xFFFD
    }

    ; The SIZE of that same last rune. Go's DecodeLastRuneInString answers the
    ; PAIR (rune, size) and Scaly answers a multi-return with an out-parameter or
    ; a sibling (§3.6); a sibling here, because the older caller wants only the
    ; rune. The two share one back-scan by shape and MUST move together — an
    ; invalid tail is (RuneError, 1) upstream, so every refusal below answers 1.
    function utf8_last_size_before(this, limit: int) returns int
    {
        if limit <= 0
            return 1
        let last *(buffer + limit - 1) as int
        if last < 0x80
            return 1
        var back: int 1
        while back <= 4
        {
            let p limit - back
            if p < 0
                return 1
            let b *(buffer + p) as int
            if b >= 0xC0
            {
                if this.utf8_size_at(p) = back
                    return back
                return 1
            }
            if b < 0x80
                return 1
            set back: back + 1
        }
        1
    }

    function is_conflict_marker(this, pos: int) returns bool
    {
        ; Fast reject: a marker is one byte repeated seven times, so a differing
        ; second byte settles it without the line-start work.
        if pos + 1 >= end
            return false
        let ch *(buffer + pos) as int
        if (*(buffer + pos + 1) as int) <> ch
            return false

        var at_line_start: bool false
        if pos = 0
            set at_line_start: true
        else
            set at_line_start: is_line_break(*(buffer + pos - 1) as int)
        ; The reference's second chance, ported as written. Note it inspects the
        ; rune ending at pos-3, not at pos-1.
        if not at_line_start
        {
            if pos >= 2
                set at_line_start: is_line_break_rune(this.utf8_decode_last_before(pos - 2))
        }
        if not at_line_start
            return false

        ; 7 = len("<<<<<<<") = MERGE_CONFLICT_MARKER_LENGTH. Deliberately still
        ; the literal: the named constant does not survive here — see the note at
        ; the define.
        if (pos + 7) >= end
            return false
        var i: int 0
        while i < 7
        {
            if (*(buffer + pos + i) as int) <> ch
                return false
            set i: i + 1
        }
        if ch = ("=" as char) as int
            return true
        (*(buffer + pos + 7) as int) = 32
    }

    ; Answers the position just past the marker's trivia.
    procedure scan_conflict_marker(this, pos_in: int) returns int
    {
        var p: int pos_in
        let ch this.utf8_decode_at(p)

        if (ch = ("<" as char) as int) or (ch = (">" as char) as int)
        {
            ; A `<<<<<<<` or `>>>>>>>` marker swallows the rest of its line.
            var c: int ch
            var sz: int this.utf8_size_at(p)
            while (p < end) and (not is_line_break_rune(c))
            {
                set p: p + sz
                set c: this.utf8_decode_at(p)
                set sz: this.utf8_size_at(p)
            }
            return p
        }

        ; A `|||||||` or `=======` marker swallows everything up to the next
        ; `=======` or `>>>>>>>`.
        while p < end
        {
            let cur *(buffer + p) as int
            if (cur = ("=" as char) as int) or (cur = (">" as char) as int)
            {
                if cur <> ch
                {
                    if this.is_conflict_marker(p)
                        break
                }
            }
            set p: p + 1
        }
        p
    }

    ; ── SkipTrivia, the standalone one ──────────────────────────────────────
    ;
    ; The reference's `scanner.SkipTrivia(text, pos)` is a FREE function over the
    ; source text, not a method on a scanner: the parser calls it to move a
    ; node's recorded POSITION — which is its full start, trivia included — to
    ; the first real character, so that a diagnostic points at the construct
    ; rather than at the blank line above it. Nine parser sites need it.
    ;
    ; It lives here because the text does, and it does NOT touch scanner state:
    ; it takes a position and answers one. Everything in the reference's option
    ; struct is off for this form (StopAfterLineBreak, InJSDoc, StopAtComments),
    ; and `canConsumeStar` is a function of InJSDoc alone, so the `*` arm is
    ; unreachable here and is left out rather than written as dead code.
    ;
    ; The name is `skip_trivia_AT` because this scanner already has a FIELD
    ; called `skip_trivia` — the reference's own `skipTrivia` flag, whether the
    ; scan loop swallows trivia or emits tokens for it. Calling the method
    ; `skip_trivia` COMPILES: the call resolves to the field and answers its
    ; boolean widened to an int, so every diagnostic in this slice pointed at
    ; offset 0 instead of at the construct. Loud only because eight fixtures
    ; compare a span; a field and a method of the same name are not a collision
    ; the compiler will mention.
    procedure skip_trivia_at(this, pos_in: int) returns int
    {
        var p: int pos_in
        if p < 0
            return p
        while p < end
        {
            let ch this.utf8_decode_at(p)
            let sz this.utf8_size_at(p)

            if ch = 13
            {
                ; CRLF counts once.
                if p + 1 < end
                {
                    if (*(buffer + p + 1) as int) = 10
                        set p: p + 1
                }
                set p: p + 1
                continue
            }
            if ch = 10
            {
                set p: p + 1
                continue
            }
            if (ch = 9) or (ch = 11)
            {
                set p: p + 1
                continue
            }
            if (ch = 12) or (ch = 32)
            {
                set p: p + 1
                continue
            }

            if ch = ("/" as char) as int
            {
                if p + 1 < end
                {
                    if (*(buffer + p + 1) as int) = ("/" as char) as int
                    {
                        set p: p + 2
                        while p < end
                        {
                            if is_line_break_rune(this.utf8_decode_at(p))
                                break
                            set p: p + this.utf8_size_at(p)
                        }
                        continue
                    }
                    if (*(buffer + p + 1) as int) = ("*" as char) as int
                    {
                        set p: p + 2
                        while p < end
                        {
                            if (*(buffer + p) as int) = ("*" as char) as int
                            {
                                if p + 1 < end
                                {
                                    if (*(buffer + p + 1) as int) = ("/" as char) as int
                                    {
                                        set p: p + 2
                                        break
                                    }
                                }
                            }
                            set p: p + this.utf8_size_at(p)
                        }
                        continue
                    }
                }
                return p
            }

            ; A merge-conflict marker is trivia here, and REPORTS NOTHING: the
            ; reference passes a nil error callback to scanConflictMarkerTrivia
            ; from this path. The scan loop's own arm is the one that reports.
            var marker_start false
            if ch = ("<" as char) as int
                set marker_start: true
            if ch = ("|" as char) as int
                set marker_start: true
            if ch = ("=" as char) as int
                set marker_start: true
            if ch = (">" as char) as int
                set marker_start: true
            if marker_start
            {
                if this.is_conflict_marker(p)
                {
                    set p: this.scan_conflict_marker(p)
                    continue
                }
                return p
            }

            ; The shebang, and only at offset 0 — the same rule the scan loop
            ; applies.
            if ch = ("#" as char) as int
            {
                if p = 0
                {
                    if p + 1 < end
                    {
                        if (*(buffer + p + 1) as int) = ("!" as char) as int
                        {
                            set p: p + 2
                            while p < end
                            {
                                if is_line_break_rune(this.utf8_decode_at(p))
                                    break
                                set p: p + this.utf8_size_at(p)
                            }
                            continue
                        }
                    }
                }
                return p
            }

            ; IsWhiteSpaceLike above the ASCII range: the single-line set plus
            ; the two line separators, which is_line_break_rune covers.
            if ch > 127
            {
                var space false
                if is_white_space_single_line(ch)
                    set space: true
                if is_line_break_rune(ch)
                    set space: true
                if space
                {
                    set p: p + sz
                    continue
                }
            }
            return p
        }
        p
    }

    ; The four characters a marker can start with all have their own arm in the
    ; scan loop, and each begins with this check.
    procedure conflict_marker_token(this) returns int
    {
        ; ★ The reference reports Merge_conflict_marker_encountered here, through
        ; its scanner error callback, and then treats the marker as trivia. The
        ; TOKEN STREAM is therefore identical either way — which is why the
        ; scanner yardstick has been green on the conflict-marker fixture from
        ; the start — and the parse TREE is not: the reference marks the enclosing
        ; statements ThisNodeHasError.
        ;
        ; ★★ FOUR diagnostics, one per marker, each spanning the marker's seven
        ; characters — `scanConflictMarkerTrivia` reports
        ; (pos, mergeConflictMarkerLength) on entry, before it consumes anything.
        ; The stand-in this replaced could record only the FIRST position and had
        ; no length, so this site is the one that proves the widening was needed
        ; rather than tidy: the fixture demands D 13 20, D 39 46, D 66 73,
        ; D 87 94.
        this.error_at(DiagMerge_conflict_marker_encountered, state.pos, MERGE_CONFLICT_MARKER_LENGTH)
        set state.pos: this.scan_conflict_marker(state.pos)
        if skip_trivia
            return 0 - 1
        set state.token: KindConflictMarkerTrivia
        KindConflictMarkerTrivia
    }

    ; The reference's scanInvalidCharacter: consume ONE character — a whole
    ; multi-byte one — and answer KindUnknown.
    procedure scan_invalid_character(this) returns int
    {
        this.error_at(DiagInvalid_character, state.pos, this.utf8_size_at(state.pos))
        set state.pos: state.pos + this.utf8_size_at(state.pos)
        set state.token: KindUnknown
        KindUnknown
    }

    ; ── template literals ───────────────────────────────────────────────────
    ;
    ; The reference's scanTemplateAndSetTokenValue. Called from the scan loop it
    ; always starts on a backtick, so it answers NoSubstitutionTemplateLiteral or
    ; TemplateHead; the Middle/Tail pair comes from re_scan_template_token, which
    ; rewinds onto the `}` that closed a substitution — that is the whole reason
    ; `started_with_backtick` is a variable rather than an assumption.
    ;
    ; ★★ `report_errors` is the reference's shouldEmitInvalidEscapeError, and
    ; where it comes FROM is the whole of CLAUDE.md §3.5z: Scan() passes FALSE
    ; outright, ReScanTemplateToken passes `!isTaggedTemplate`. So an invalid
    ; escape in a template is reported by the re-scan and only when the template
    ; is untagged — `` t`\u` `` is legal and reaches the tag function as raw
    ; text — while the same escape in a STRING reports at scan time, because
    ; scan_string passes the flag unconditionally. Two flags, one function,
    ; opposite answers.
    ;
    ; Unterminated is NOT under the parameter: the reference reports it on every
    ; call, including the very call that suppresses the escape errors.
    ;
    ; Answers the Kind, or -1 when an escape inside it is not ported.
    procedure scan_template(this, report_errors: bool) returns int
    {
        let started_with_backtick this.char() = ("\`" as char) as int
        set state.pos: state.pos + 1

        let content_start state.pos
        var chunk_start content_start

        repeat
        {
            let ch this.char()

            if (ch < 0) or (ch = ("\`" as char) as int)
            {
                this.value_finish_body(content_start, chunk_start, state.pos)
                if ch = ("\`" as char) as int
                    set state.pos: state.pos + 1
                else
                {
                    set state.token_flags: state.token_flags | TokenFlagsUnterminated
                    this.error(DiagUnterminated_template_literal)
                }
                if started_with_backtick
                    return KindNoSubstitutionTemplateLiteral
                return KindTemplateTail
            }

            if (ch = ("$" as char) as int) and (this.char_at(1) = ("{" as char) as int)
            {
                this.value_finish_body(content_start, chunk_start, state.pos)
                set state.pos: state.pos + 2
                if started_with_backtick
                    return KindTemplateHead
                return KindTemplateMiddle
            }

            if ch = ("\\" as char) as int
            {
                ; Same escape scanner as the string literal. The reference passes
                ; a different flag set here — ReportErrors is clear on the scan
                ; loop's call and set on the parser's re-scan of a NON-tagged
                ; template — but that selects diagnostics only: the position and
                ; ContainsInvalidEscape are the same either way, which is why the
                ; parameter IS carried since slice 13b, and this is where it
                ; matters: the scan loop passes false, an untagged re-scan passes
                ; true. See the note at scan_template.
                ;
                ; ★ Since slice 17 it selects one more thing, and it is a VALUE
                ; rather than a diagnostic: the legacy-octal arms answer the
                ; decoded character when errors are reported and the raw escape
                ; text when they are not. So a TAGGED template's chunk keeps
                ; `\47` where a string literal turns it into `'` — which is the
                ; reference's own arrangement and the reason its cooked text can
                ; be nonsense while the raw text is what the tag function reads.
                this.value_arm(chunk_start)
                this.scan_escape_sequence(report_errors)
                set chunk_start: state.pos
                continue
            }

            ; <CR> and <CR><LF> normalize to <LF> in a template VALUE — the
            ; reference cites ECMAScript 11.8.6.1 for it. It is a value-only
            ; rule: the position is the same either way, which is why it was one
            ; comment and no code until the value existed.
            if ch = ("\r" as char) as int
            {
                this.value_arm(chunk_start)
                set state.pos: state.pos + 1
                if this.char() = ("\n" as char) as int
                    set state.pos: state.pos + 1
                this.value_put_byte(10)
                set chunk_start: state.pos
                continue
            }

            set state.pos: state.pos + 1
        }
    }

    ; ── string literals ─────────────────────────────────────────────────────
    ;
    ; The reference has a fast path that finds the closing quote with one
    ; IndexByte and takes the whole span when it contains no backslash and no
    ; line break. It is a pure optimization — the loop below reaches the same
    ; position and the same flags in every case, including the empty string and
    ; the unterminated one — so only the loop is ported. Add the fast path when
    ; a measurement asks for it, not before.

    ; The reference's scanString(jsxAttributeString bool), and the parameter is
    ; not a convenience: under it a backslash is an ORDINARY character and a
    ; line break does NOT terminate the literal, so `title="a\\b"` keeps its
    ; backslash and an attribute value may span lines. Both of the reference's
    ; two `&& !jsxAttributeString` guards are below, at the arms they belong to.
    ;
    ; ★ The fast path the reference has above the loop (an IndexByte for the
    ; closing quote, taken when the body holds no escape and no newline, or
    ; unconditionally under jsxAttributeString) is an optimisation over the same
    ; loop and answers the same value — it is deliberately not ported, and the
    ; note is here so its absence is not read as a divergence.
    ;
    ; ★ It answers NOTHING, for the reason scan_escape_sequence does: its only
    ; `false` came from that routine's, which could not happen. Slice 25.
    procedure scan_string(this, jsx_attribute: bool)
    {
        let quote this.char()
        if quote = ("'" as char) as int
            set state.token_flags: state.token_flags | TokenFlagsSingleQuote
        set state.pos: state.pos + 1

        ; The body — the reference's `start`, and the beginning of the token
        ; VALUE, which is the literal without its quotes.
        let content_start state.pos
        var chunk_start content_start

        repeat
        {
            let ch this.char()
            if ch < 0
            {
                set state.token_flags: state.token_flags | TokenFlagsUnterminated
                this.error(DiagUnterminated_string_literal)
                this.value_finish_body(content_start, chunk_start, state.pos)
                return
            }
            if ch = quote
            {
                this.value_finish_body(content_start, chunk_start, state.pos)
                set state.pos: state.pos + 1
                return
            }
            if (ch = ("\\" as char) as int) and (not jsx_attribute)
            {
                ; A string literal always scans with ReportErrors set — that is
                ; the whole asymmetry with a template (§3.5z). It is also why the
                ; value has to be built in ONE pass: the octal arms answer a
                ; DIFFERENT value under the two settings, so a second decoding
                ; pass with errors suppressed would build the tagged-template
                ; value for a string.
                this.value_arm(chunk_start)
                this.scan_escape_sequence(true)
                set chunk_start: state.pos
                continue
            }
            if is_line_break(ch) and (not jsx_attribute)
            {
                set state.token_flags: state.token_flags | TokenFlagsUnterminated
                this.error(DiagUnterminated_string_literal)
                this.value_finish_body(content_start, chunk_start, state.pos)
                return
            }
            set state.pos: state.pos + 1
        }
    }

    ; ── JSDoc tag detection ─────────────────────────────────────────────────
    ;
    ; The reference's hasJSDocTag/scanJSDocCommentForTags. This is NOT JSDoc
    ; parsing — it is a byte scan over the comment that answers two questions
    ; (does it carry @deprecated; does it carry @see/@link) and sets two flags
    ; on the token that FOLLOWS the comment. Small, self-contained and exact, so
    ; it is ported rather than deferred with the rest of the JSDoc machinery.
    ;
    ; Note the flags land on the next token: token_flags is cleared once per
    ; scan() call, not once per loop iteration, so a comment consumed as trivia
    ; leaves its marks behind. That is what makes a JSDoc comment observable at
    ; all when skip_trivia is on.

    ; The reference's hasJSDocTag for ONE tag: `text` starts just past the `@`,
    ; and the tag must be followed by the comment's end or a delimiter.
    function jsdoc_tag_at(buf: pointer[char], from: int, limit: int, tag: pointer[const_char], taglen: int) returns bool
    {
        if from + taglen > limit
            return false
        var i: int 0
        while i < taglen
        {
            if (*(buf + from + i) as int) <> (*(tag + i) as int)
                return false
            set i: i + 1
        }
        if from + taglen = limit
            return true
        let c *(buf + from + taglen) as int
        if (c = 32) or (c = 9) or (c = 10) or (c = 13)
            return true
        if c = ("}" as char) as int
            return true
        c = ("*" as char) as int
    }

    procedure scan_jsdoc_for_tags(this, start: int, limit: int)
    {
        let both TokenFlagsPrecedingJSDocWithDeprecated | TokenFlagsPrecedingJSDocWithSeeOrLink
        var p: int start
        repeat
        {
            var at: int 0 - 1
            var i: int p
            while i < limit
            {
                if (*(buffer + i) as int) = ("@" as char) as int
                {
                    set at: i
                    break
                }
                set i: i + 1
            }
            if at < 0
                return
            set p: at + 1

            ; NOTE the parentheses around every flag test. `&` has precedence 5
            ; and `=` has 6, so `flags & F = 0` parses as `flags & (F = 0)` —
            ; the root CLAUDE.md records the same trap for `xor`.
            if (state.token_flags & TokenFlagsPrecedingJSDocWithDeprecated) = 0
            {
                if jsdoc_tag_at(buffer, p, limit, "deprecated", 10)
                    set state.token_flags: state.token_flags | TokenFlagsPrecedingJSDocWithDeprecated
            }

            if (state.token_flags & TokenFlagsPrecedingJSDocWithSeeOrLink) = 0
            {
                var seen: bool false
                if jsdoc_tag_at(buffer, p, limit, "see", 3)
                    set seen: true
                if jsdoc_tag_at(buffer, p, limit, "link", 4)
                    set seen: true
                if jsdoc_tag_at(buffer, p, limit, "linkcode", 8)
                    set seen: true
                if jsdoc_tag_at(buffer, p, limit, "linkplain", 9)
                    set seen: true
                if seen
                    set state.token_flags: state.token_flags | TokenFlagsPrecedingJSDocWithSeeOrLink
            }

            if (state.token_flags & both) = both
                return
        }
    }

    ; ── the token this slice cannot produce ─────────────────────────────────

    procedure unported(this) returns int
    {
        if unported_pos < 0
            set unported_pos: state.pos
        set state.token: KindUnknown
        KindUnknown
    }

    ; ── the scan loop ───────────────────────────────────────────────────────
    ;
    ; Structured as the reference's: set the full start, clear the flags, then
    ; loop — trivia that is being skipped `continue`s, everything else returns.

    procedure scan(this) returns int
    {
        set state.full_start_pos: state.pos
        set state.token_flags: TokenFlagsNone

        repeat
        {
            let ch this.char()
            set state.token_start: state.pos

            ; end of file
            if ch < 0
            {
                set state.token: KindEndOfFile
                return KindEndOfFile
            }

            ; ── trivia ──────────────────────────────────────────────────────

            ; horizontal whitespace: tab, vertical tab, form feed, space
            if (ch = 9) or (ch = 11) or (ch = 12) or (ch = 32)
            {
                set state.pos: state.pos + 1
                if skip_trivia
                    continue
                while true
                {
                    let c2 this.char()
                    if not ((c2 = 9) or (c2 = 11) or (c2 = 12) or (c2 = 32))
                        break
                    set state.pos: state.pos + 1
                }
                set state.token: KindWhitespaceTrivia
                return KindWhitespaceTrivia
            }

            ; line breaks. The flag is set BEFORE the skip test, because it
            ; describes the token that follows and must survive skipping.
            if is_line_break(ch)
            {
                set state.token_flags: state.token_flags | TokenFlagsPrecedingLineBreak
                if skip_trivia
                {
                    set state.pos: state.pos + 1
                    ; The reference collapses the whole following run of spaces
                    ; and \t..\r here in one pass.
                    while true
                    {
                        let c2 this.char()
                        if not ((c2 = 32) or ((c2 >= 9) and (c2 <= 13)))
                            break
                        set state.pos: state.pos + 1
                    }
                    continue
                }
                if (ch = ("\r" as char) as int) and (this.char_at(1) = ("\n" as char) as int)
                    set state.pos: state.pos + 2
                if not ((ch = ("\r" as char) as int) and (this.char_at(1) = ("\n" as char) as int))
                    set state.pos: state.pos + 1
                set state.token: KindNewLineTrivia
                return KindNewLineTrivia
            }

            ; ── comments, and the slash operators that share the character ──

            if ch = ("/" as char) as int
            {
                ; single-line comment
                if this.char_at(1) = ("/" as char) as int
                {
                    set state.pos: state.pos + 2
                    while true
                    {
                        if state.pos >= end
                            break
                        ; Decoded, not byte-wise: U+2028 and U+2029 END a
                        ; single-line comment, and a byte scan would run past
                        ; them to the next LF.
                        let sz this.utf8_size_at(state.pos)
                        if is_line_break_rune(this.utf8_decode_at(state.pos))
                            break
                        set state.pos: state.pos + sz
                    }
                    if skip_trivia
                        continue
                    set state.token: KindSingleLineCommentTrivia
                    return KindSingleLineCommentTrivia
                }

                ; multi-line comment
                if this.char_at(1) = ("*" as char) as int
                {
                    set state.pos: state.pos + 2
                    ; `/**` opens JSDoc — but `/**/` does not, which is why the
                    ; reference tests the character AFTER the second asterisk.
                    let is_jsdoc (this.char() = ("*" as char) as int) and (this.char_at(1) <> ("/" as char) as int)
                    var closed: bool false
                    while true
                    {
                        if state.pos >= end
                            break
                        if (this.char() = ("*" as char) as int) and (this.char_at(1) = ("/" as char) as int)
                        {
                            set state.pos: state.pos + 2
                            set closed: true
                            break
                        }
                        ; Decoded: U+2028 inside a block comment sets
                        ; PrecedingLineBreak on the token that follows the
                        ; comment, which a byte scan cannot see.
                        let cp this.utf8_decode_at(state.pos)
                        set state.pos: state.pos + this.utf8_size_at(state.pos)
                        if is_line_break_rune(cp)
                            set state.token_flags: state.token_flags | TokenFlagsPrecedingLineBreak
                    }
                    if is_jsdoc
                    {
                        set state.token_flags: state.token_flags | TokenFlagsPrecedingJSDocComment
                        this.scan_jsdoc_for_tags(state.token_start, state.pos)
                    }
                    ; ★★★ BEFORE the skip_trivia test, and that is the whole
                    ; reason the diagnostic exists: with skip_trivia on — which
                    ; is every parse — the `continue` below discards the comment
                    ; and nothing downstream ever learns it was open. The
                    ; comment that stood here described this placement and the
                    ; call itself was never written, so `/*CHECK#1/` parsed
                    ; without a word where the reference reports TS1010 and
                    ; stamps ThisNodeHasError on the token that follows.
                    if not closed
                        this.error(DiagAsterisk_Slash_expected)
                    if skip_trivia
                        continue
                    if not closed
                        set state.token_flags: state.token_flags | TokenFlagsUnterminated
                    set state.token: KindMultiLineCommentTrivia
                    return KindMultiLineCommentTrivia
                }

                if this.char_at(1) = ("=" as char) as int
                {
                    set state.pos: state.pos + 2
                    set state.token: KindSlashEqualsToken
                    return KindSlashEqualsToken
                }
                set state.pos: state.pos + 1
                set state.token: KindSlashToken
                return KindSlashToken
            }

            ; ── one-character punctuation ───────────────────────────────────

            if ch = ("(" as char) as int
                return this.punct1(KindOpenParenToken)
            if ch = (")" as char) as int
                return this.punct1(KindCloseParenToken)
            if ch = ("[" as char) as int
                return this.punct1(KindOpenBracketToken)
            if ch = ("]" as char) as int
                return this.punct1(KindCloseBracketToken)
            if ch = ("{" as char) as int
                return this.punct1(KindOpenBraceToken)
            if ch = ("}" as char) as int
                return this.punct1(KindCloseBraceToken)
            if ch = (";" as char) as int
                return this.punct1(KindSemicolonToken)
            if ch = ("," as char) as int
                return this.punct1(KindCommaToken)
            if ch = (":" as char) as int
                return this.punct1(KindColonToken)
            if ch = ("~" as char) as int
                return this.punct1(KindTildeToken)
            if ch = ("@" as char) as int
                return this.punct1(KindAtToken)

            ; `>` is deliberately NOT extended to >>, >>=, >= and friends. The
            ; reference emits a bare KindGreaterThanToken and lets the parser
            ; re-scan, because a generic argument list closes with `>` and the
            ; scanner cannot know whether `>>` is a shift or two closers.
            if ch = (">" as char) as int
            {
                if this.char_at(1) = (">" as char) as int
                {
                    if this.is_conflict_marker(state.pos)
                    {
                        let t this.conflict_marker_token()
                        if t < 0
                            continue
                        return t
                    }
                }
                return this.punct1(KindGreaterThanToken)
            }

            ; ── multi-character punctuation ─────────────────────────────────

            if ch = ("!" as char) as int
            {
                if this.char_at(1) = ("=" as char) as int
                {
                    if this.char_at(2) = ("=" as char) as int
                        return this.punctn(3, KindExclamationEqualsEqualsToken)
                    return this.punctn(2, KindExclamationEqualsToken)
                }
                return this.punct1(KindExclamationToken)
            }

            if ch = ("%" as char) as int
            {
                if this.char_at(1) = ("=" as char) as int
                    return this.punctn(2, KindPercentEqualsToken)
                return this.punct1(KindPercentToken)
            }

            if ch = ("&" as char) as int
            {
                if this.char_at(1) = ("&" as char) as int
                {
                    if this.char_at(2) = ("=" as char) as int
                        return this.punctn(3, KindAmpersandAmpersandEqualsToken)
                    return this.punctn(2, KindAmpersandAmpersandToken)
                }
                if this.char_at(1) = ("=" as char) as int
                    return this.punctn(2, KindAmpersandEqualsToken)
                return this.punct1(KindAmpersandToken)
            }

            if ch = ("|" as char) as int
            {
                if this.char_at(1) = ("|" as char) as int
                {
                    if this.is_conflict_marker(state.pos)
                    {
                        let t this.conflict_marker_token()
                        if t < 0
                            continue
                        return t
                    }
                    if this.char_at(2) = ("=" as char) as int
                        return this.punctn(3, KindBarBarEqualsToken)
                    return this.punctn(2, KindBarBarToken)
                }
                if this.char_at(1) = ("=" as char) as int
                    return this.punctn(2, KindBarEqualsToken)
                return this.punct1(KindBarToken)
            }

            if ch = ("^" as char) as int
            {
                if this.char_at(1) = ("=" as char) as int
                    return this.punctn(2, KindCaretEqualsToken)
                return this.punct1(KindCaretToken)
            }

            if ch = ("*" as char) as int
            {
                if this.char_at(1) = ("=" as char) as int
                    return this.punctn(2, KindAsteriskEqualsToken)
                if this.char_at(1) = ("*" as char) as int
                {
                    if this.char_at(2) = ("=" as char) as int
                        return this.punctn(3, KindAsteriskAsteriskEqualsToken)
                    return this.punctn(2, KindAsteriskAsteriskToken)
                }
                ; ★ The JSDoc leading-asterisk arm, whose caller slice 21
                ; supplied. It is the ONE place in Scan() that consumes a
                ; character and produces no token: the first `*` after a line
                ; break, while a JSDoc type is being scanned, is the comment's
                ; margin and not an operator. The flag makes it the first one
                ; only — a second `*` on the same line is a real token.
                set state.pos: state.pos + 1
                if skip_jsdoc_leading_asterisks <> 0
                {
                    if (state.token_flags & TokenFlagsPrecedingJSDocLeadingAsterisks) = 0
                    {
                        if (state.token_flags & TokenFlagsPrecedingLineBreak) <> 0
                        {
                            set state.token_flags: state.token_flags | TokenFlagsPrecedingJSDocLeadingAsterisks
                            continue
                        }
                    }
                }
                set state.token: KindAsteriskToken
                return KindAsteriskToken
            }

            if ch = ("+" as char) as int
            {
                if this.char_at(1) = ("=" as char) as int
                    return this.punctn(2, KindPlusEqualsToken)
                if this.char_at(1) = ("+" as char) as int
                    return this.punctn(2, KindPlusPlusToken)
                return this.punct1(KindPlusToken)
            }

            if ch = ("-" as char) as int
            {
                if this.char_at(1) = ("=" as char) as int
                    return this.punctn(2, KindMinusEqualsToken)
                if this.char_at(1) = ("-" as char) as int
                    return this.punctn(2, KindMinusMinusToken)
                return this.punct1(KindMinusToken)
            }

            if ch = ("." as char) as int
            {
                ; `.5` is a numeric literal, and scan_number handles it from the
                ; dot: its leading-zero branch does not fire, the fragment scan
                ; consumes nothing, and the fraction branch takes over.
                if is_digit(this.char_at(1))
                {
                    let k this.scan_number()
                    set state.token: k
                    return k
                }
                if (this.char_at(1) = ("." as char) as int) and (this.char_at(2) = ("." as char) as int)
                    return this.punctn(3, KindDotDotDotToken)
                return this.punct1(KindDotToken)
            }

            if ch = ("<" as char) as int
            {
                if this.char_at(1) = ("<" as char) as int
                {
                    if this.is_conflict_marker(state.pos)
                    {
                        let t this.conflict_marker_token()
                        if t < 0
                            continue
                        return t
                    }
                    if this.char_at(2) = ("=" as char) as int
                        return this.punctn(3, KindLessThanLessThanEqualsToken)
                    return this.punctn(2, KindLessThanLessThanToken)
                }
                if this.char_at(1) = ("=" as char) as int
                    return this.punctn(2, KindLessThanEqualsToken)
                ; The one place the LANGUAGE VARIANT reaches Scan(). The `*`
                ; test keeps `</*` a `<` followed by a comment rather than a
                ; closing-tag token — the reference's own third clause.
                if jsx_variant
                {
                    if this.char_at(1) = ("/" as char) as int
                        if this.char_at(2) <> ("*" as char) as int
                            return this.punctn(2, KindLessThanSlashToken)
                }
                return this.punct1(KindLessThanToken)
            }

            if ch = ("=" as char) as int
            {
                if this.char_at(1) = ("=" as char) as int
                {
                    if this.is_conflict_marker(state.pos)
                    {
                        let t this.conflict_marker_token()
                        if t < 0
                            continue
                        return t
                    }
                    if this.char_at(2) = ("=" as char) as int
                        return this.punctn(3, KindEqualsEqualsEqualsToken)
                    return this.punctn(2, KindEqualsEqualsToken)
                }
                if this.char_at(1) = (">" as char) as int
                    return this.punctn(2, KindEqualsGreaterThanToken)
                return this.punct1(KindEqualsToken)
            }

            if ch = ("?" as char) as int
            {
                if (this.char_at(1) = ("." as char) as int) and (not is_digit(this.char_at(2)))
                    return this.punctn(2, KindQuestionDotToken)
                if this.char_at(1) = ("?" as char) as int
                {
                    if this.char_at(2) = ("=" as char) as int
                        return this.punctn(3, KindQuestionQuestionEqualsToken)
                    return this.punctn(2, KindQuestionQuestionToken)
                }
                return this.punct1(KindQuestionToken)
            }

            ; ── numeric literals ────────────────────────────────────────────

            if ch = ("0" as char) as int
            {
                let c1 this.char_at(1)

                if (c1 = ("X" as char) as int) or (c1 = ("x" as char) as int)
                {
                    set state.pos: state.pos + 2
                    let dstart state.pos
                    let nd this.scan_hex_digits(1, true, true)
                    if nd = 0
                        this.error(DiagHexadecimal_digit_expected)
                    this.set_radix_raw_value(("x" as char) as int, dstart, state.pos, nd = 0)
                    set state.token_flags: state.token_flags | TokenFlagsHexSpecifier
                    let k this.scan_big_int_suffix()
                    set state.token: k
                    return k
                }

                if (c1 = ("B" as char) as int) or (c1 = ("b" as char) as int)
                {
                    set state.pos: state.pos + 2
                    let dstart state.pos
                    let nd this.scan_binary_or_octal_digits(2)
                    if nd = 0
                        this.error(DiagBinary_digit_expected)
                    this.set_radix_raw_value(("b" as char) as int, dstart, state.pos, nd = 0)
                    set state.token_flags: state.token_flags | TokenFlagsBinarySpecifier
                    let k this.scan_big_int_suffix()
                    set state.token: k
                    return k
                }

                if (c1 = ("O" as char) as int) or (c1 = ("o" as char) as int)
                {
                    set state.pos: state.pos + 2
                    let dstart state.pos
                    let nd this.scan_binary_or_octal_digits(8)
                    if nd = 0
                        this.error(DiagOctal_digit_expected)
                    this.set_radix_raw_value(("o" as char) as int, dstart, state.pos, nd = 0)
                    set state.token_flags: state.token_flags | TokenFlagsOctalSpecifier
                    let k this.scan_big_int_suffix()
                    set state.token: k
                    return k
                }

                ; The reference falls through from '0' into the '1'..'9' arm.
                let k this.scan_number()
                set state.token: k
                return k
            }

            if is_digit(ch)
            {
                let k this.scan_number()
                set state.token: k
                return k
            }

            ; ── string literals ─────────────────────────────────────────────

            if (ch = ("\"" as char) as int) or (ch = ("'" as char) as int)
            {
                this.scan_string(false)
                set state.token: KindStringLiteral
                return KindStringLiteral
            }

            ; ── identifiers and keywords, ASCII fast path ───────────────────

            if is_ident_start_ascii(ch)
            {
                let start state.pos
                let r this.scan_identifier(0)
                var k: int KindIdentifier
                if r = 2
                    set k: this.scan_identifier_decoded(start, 0)
                else
                    set k: get_identifier_token(state.token_value, state.token_value_len)
                set state.token: k
                return k
            }

            ; ── template literals ───────────────────────────────────────────

            if ch = ("\`" as char) as int
            {
                let k this.scan_template(false)
                set state.token: k
                return k
            }

            ; ── private names and the shebang ───────────────────────────────

            if ch = ("#" as char) as int
            {
                if this.char_at(1) = ("!" as char) as int
                {
                    if state.pos = 0
                    {
                        ; A shebang, and only at offset 0. It is trivia: skipped
                        ; whole, with no token of its own.
                        set state.pos: state.pos + 2
                        while state.pos < end
                        {
                            if is_line_break_rune(this.utf8_decode_at(state.pos))
                                break
                            set state.pos: state.pos + this.utf8_size_at(state.pos)
                        }
                        continue
                    }
                    ; `#!` anywhere else is an error and consumes ONE character.
                    ; The diagnostic spans BOTH characters even though only one is
                    ; consumed.
                    this.error_at(DiagX_can_only_be_used_at_the_start_of_a_file, state.pos, 2)
                    set state.pos: state.pos + 1
                    set state.token: KindUnknown
                    return KindUnknown
                }

                ; `#\` opens a private name written with a unicode escape. The
                ; Kind is fixed either way, so the decoded scan runs only for its
                ; POSITION and flags — no keyword can be spelled `#…`.
                if this.char_at(1) = ("\\" as char) as int
                {
                    set state.pos: state.pos + 1
                    let cp this.peek_unicode_escape()
                    if (cp >= 0) and is_identifier_start(cp)
                    {
                        this.scan_identifier_decoded(state.pos, 1)
                        set state.token: KindPrivateIdentifier
                        return KindPrivateIdentifier
                    }
                    set state.pos: state.pos - 1
                }

                ; Whether or not a name follows, the token is a private
                ; identifier — a bare `#` is one that spans just the `#`.
                let r this.scan_identifier(1)
                if r = 2
                    this.scan_identifier_decoded(state.token_start + 1, 1)
                ; ★ ... but the reference reports Invalid_character for that bare
                ; one, through the error CALLBACK and with no token flag, so the
                ; token stream is identical and only the tree differs. It became
                ; load-bearing with parser slice 6, when the private name started
                ; parsing and `private_names.ts` stopped being unported for the
                ; other reason. Same shape as the conflict marker below.
                ;
                ; ★ The span is the `#` itself, one character. The reference
                ; writes `errorAt(Invalid_character, s.pos-1, 1)` and that reads
                ; like the character BEFORE — it is not: `scanIdentifier` does
                ; `s.pos += prefixLength` first and leaves pos there when it
                ; fails, so s.pos-1 is the `#`. Written here as `token_start`,
                ; which IS the `#` and does not depend on where our own
                ; scan_identifier leaves the cursor on failure. Measured against
                ; the fixture: D 54 55.
                ; ... and with it the reference's `s.tokenValue = "#"`, which is
                ; the one place a value is written on a FAILED identifier scan.
                ; It is the `#` itself, so the source has it and no decode is
                ; needed.
                if r = 0
                {
                    this.error_at(DiagInvalid_character, state.token_start, 1)
                    this.set_token_value_range(state.token_start, state.token_start + 1)
                }
                set state.token: KindPrivateIdentifier
                return KindPrivateIdentifier
            }

            ; ── a backslash at top level ────────────────────────────────────
            ;
            ; Either it opens an identifier written with a unicode escape, or it
            ; is simply an invalid character. Only peeking can tell, which is why
            ; peek_unicode_escape restores both position and flags.

            if ch = ("\\" as char) as int
            {
                let cp this.peek_unicode_escape()
                if (cp >= 0) and is_identifier_start(cp)
                {
                    let k this.scan_identifier_decoded(state.pos, 0)
                    set state.token: k
                    return k
                }
                return this.scan_invalid_character()
            }

            ; ── the default arm ─────────────────────────────────────────────
            ;
            ; The reference tries scanIdentifier FIRST here, before any of the
            ; rune classes below, so a non-ASCII identifier start wins over
            ; everything else. That ordering is reproduced rather than
            ; approximated.

            if ch >= 128
            {
                let id_start state.pos
                let r this.scan_identifier(0)
                if r > 0
                {
                    var k: int KindIdentifier
                    if r = 2
                        set k: this.scan_identifier_decoded(id_start, 0)
                    else
                        set k: get_identifier_token(state.token_value, state.token_value_len)
                    set state.token: k
                    return k
                }

                let cp this.utf8_decode_at(state.pos)
                let sz this.utf8_size_at(state.pos)

                ; Go returns RuneError for an invalid sequence, and the reference
                ; compares against it without telling that apart from a genuine
                ; U+FFFD — so both mean "binary file" and swallow the rest.
                if cp = 0xFFFD
                {
                    ; ★ Position 0 and length 0 — the diagnostic is about the
                    ; FILE, not about the byte that gave it away.
                    this.error_at(DiagFile_appears_to_be_binary, 0, 0)
                    set state.pos: end
                    set state.token: KindNonTextFileMarkerTrivia
                    return KindNonTextFileMarkerTrivia
                }

                if is_white_space_single_line(cp)
                {
                    set state.pos: state.pos + sz
                    ; U+0085 continues even when trivia is NOT being skipped —
                    ; the reference singles it out.
                    if (cp = 0x0085) or skip_trivia
                        continue
                    while true
                    {
                        let c2 this.utf8_decode_at(state.pos)
                        if not is_white_space_single_line(c2)
                            break
                        set state.pos: state.pos + this.utf8_size_at(state.pos)
                    }
                    set state.token: KindWhitespaceTrivia
                    return KindWhitespaceTrivia
                }

                if is_line_break_rune(cp)
                {
                    set state.token_flags: state.token_flags | TokenFlagsPrecedingLineBreak
                    set state.pos: state.pos + sz
                    continue
                }
            }

            ; A non-ASCII character that is neither an identifier, nor
            ; whitespace, nor a line terminator.
            return this.scan_invalid_character()
        }
    }

    ; ── re-scan ─────────────────────────────────────────────────────────────
    ;
    ; The reference's ReScanLessThanToken. A generic argument list opens with
    ; `<`, and `Foo<<T>() => void>` starts with a token the scan already merged
    ; into `<<` — so the PARSER, which is the only side that knows it is reading
    ; a type, asks for the merge to be undone. Splitting is exact: the token
    ; starts at token_start, and one character of it is the `<` we want.
    ;
    ; ★ Its counterpart ReScanGreaterThanToken runs the OTHER direction, and
    ; that asymmetry is the whole design: the scan never merges `>` at all (see
    ; the `>` arm above), precisely so that `Array<Array<string>>` closes twice —
    ; so the parser has to ASK when it wants `>>`, `>>>`, `>=`, `>>=` or `>>>=`.
    ; Its first caller arrives with parser slice 5: parseBinaryExpressionRest
    ; calls it before EVERY operator test, which is why `a >= b` and `a >> b`
    ; cannot parse without it while `a <= b` always could.
    procedure re_scan_less_than_token(this) returns int
    {
        if state.token = KindLessThanLessThanToken
        {
            set state.pos: state.token_start + 1
            set state.token: KindLessThanToken
        }
        state.token
    }

    procedure re_scan_greater_than_token(this) returns int
    {
        if state.token = KindGreaterThanToken
            this.re_scan_greater_than_token_inner()
        state.token
    }

    ; The reference's ReScanTemplateToken. Its shape is the plainest of the
    ; three — rewind to the token's start and scan it again as a template — but
    ; what it is FOR is the least obvious, and both of its callers ask a
    ; different question.
    ;
    ; A `}` and a template Middle/Tail begin with the same character, and only
    ; the parser knows which it is looking at: inside `${ … }` the brace closes
    ; the substitution, so the text after it resumes the template. scan() has
    ; already answered CloseBraceToken; this undoes that and reads the rest of
    ; the template instead. That is the caller `parse_literal_of_template_span`.
    ;
    ; ★ The `is_tagged_template` parameter selects DIAGNOSTICS and nothing else,
    ; and it is the reason our scan_template still takes no such argument. The
    ; reference passes `!isTaggedTemplate` as shouldEmitInvalidEscapeError,
    ; because an invalid escape is legal in a TAGGED template — `` t`\unicode` ``
    ; reaches the tag function as raw text — and a grammar error anywhere else.
    ; The FLAG (ContainsInvalidEscape) is set either way; only the error is
    ; suppressed. So the positions, the kinds and the token flags this port
    ; compares are identical for both values, and the parameter is carried here
    ; solely so the two call sites read against the reference.
    ;
    ; ★★ Its one observable consequence is an OVER-REPORT this port accepts and
    ; the diagnostics slice owns: next_token_without_check treats
    ; ContainsInvalidEscape as "the reference emitted a diagnostic here", which
    ; is true for every template except a tagged one. So `` t`\01` `` is reported
    ; unported where the reference says nothing. More unported, never a wrong
    ; tree — the direction §3.9e asks for.
    procedure re_scan_template_token(this, is_tagged_template: bool) returns int
    {
        set state.pos: state.token_start
        let k this.scan_template(not is_tagged_template)
        set state.token: k
        k
    }

    ; The reference's ReScanSlashToken — parser slice 16, and the last re-scan
    ; entry point outside JSDoc.
    ;
    ; A `/` opens a division operator or a regular expression, and nothing in the
    ; token stream decides which: `a / b` and `/a/g` differ only in what preceded
    ; them. So scan() always answers SlashToken (or SlashEqualsToken for `/=`)
    ; and the parser asks for the re-read at the one place a regular expression
    ; may begin — parsePrimaryExpression.
    ;
    ; ★★★ THE REFERENCE'S `reportErrors` PARAMETER IS NOT PORTED, AND WHICH
    ; CALLER SETS IT IS THE REASON. Upstream it is variadic and false by default:
    ; the parser calls `ReScanSlashToken()`, the CHECKER calls it with `true`.
    ; Under the flag the body additionally runs `regExpParser` — a second grammar
    ; of about a thousand lines that validates the pattern and its flags — and
    ; those diagnostics belong to the checking pass, not to the parse. This port
    ; has a parser, so the parameter would carry one value at its one call site;
    ; it is left out rather than carried false, and this note is what stands in
    ; for it. What comes back with the checker is the branch AND its parameter.
    ;
    ; ★★ Two reads here are BYTE reads although this scanner decodes runes
    ; everywhere else, and both are ported as bytes on purpose: `ch :=
    ; rune(s.text[p])` in the two scanning loops widens ONE BYTE, so U+2028 does
    ; not terminate a regular expression body the way it terminates a line
    ; elsewhere, and no `/` can hide inside a multi-byte character (every
    ; continuation byte is >= 0x80). The trailing-trim loop below decodes
    ; properly. The asymmetry is upstream's, not a simplification.
    ;
    ; ★ The `namedCaptureGroups` arm of the first loop is deliberately ABSENT,
    ; and the argument is checkable rather than a judgement: the variable has
    ; exactly one reader — the `regExpParser` built inside the `shouldReportErrors`
    ; branch (`grep -rn namedCaptureGroups internal/scanner` answers regexp.go:391
    ; and nothing else) — and the arm assigns nothing besides it. So omitting it
    ; is observationally identical for every caller this port has. It returns
    ; with the branch that reads it.
    procedure re_scan_slash_token(this) returns int
    {
        if (state.token <> KindSlashToken) and (state.token <> KindSlashEqualsToken)
            return state.token

        ; Pass one: find the end of the body, so that the flags after it are
        ; reachable. A `/` inside a character class does not close the literal —
        ; but NESTED classes are deliberately not tracked here, or `/[[]/` would
        ; consume past its own closing slash. The reference's comment cites the
        ; specification section; what matters is that the shape is kept.
        let start_of_body state.token_start + 1
        var p: int start_of_body
        var in_escape: bool false
        var in_character_class: bool false
        while true
        {
            ; End of file or a line break: unterminated. Report and keep what we
            ; have — which is what makes the recovery pass below reachable.
            if p >= end
            {
                set state.token_flags: state.token_flags | TokenFlagsUnterminated
                break
            }
            let ch *(buffer + p) as int
            if is_line_break_rune(ch)
            {
                set state.token_flags: state.token_flags | TokenFlagsUnterminated
                break
            }

            ; The escape arm comes FIRST and swallows whatever follows — that
            ; ordering is the reference's switch, and it is what makes `/\//` one
            ; literal. Below it every arm tests a distinct character, so they are
            ; independent `if`s ending in `continue` rather than a nested chain
            ; (§3.9b).
            if in_escape
            {
                set in_escape: false
                set p: p + 1
                continue
            }
            if (ch = ("/" as char) as int) and (not in_character_class)
                break
            if ch = ("[" as char) as int
                set in_character_class: true
            if ch = ("\\" as char) as int
                set in_escape: true
            if ch = ("]" as char) as int
                set in_character_class: false
            set p: p + 1
        }

        let end_of_body p
        if (state.token_flags & TokenFlagsUnterminated) <> 0
        {
            ; Pass two, RECOVERY. The literal is invalid either way, so the
            ; reference guesses its extent from the nearest unbalanced bracket —
            ; and here it DOES count nested character classes, because this is a
            ; best guess rather than a grammar. A `{n,m}` quantifier suppresses
            ; the group arms, so a `}` inside one does not end the guess.
            set p: start_of_body
            set in_escape: false
            var character_class_depth: int 0
            var in_decimal_quantifier: bool false
            var group_depth: int 0
            while p < end_of_body
            {
                let ch *(buffer + p) as int
                if in_escape
                {
                    set in_escape: false
                    set p: p + 1
                    continue
                }
                if ch = ("\\" as char) as int
                {
                    set in_escape: true
                    set p: p + 1
                    continue
                }
                if ch = ("[" as char) as int
                {
                    set character_class_depth: character_class_depth + 1
                    set p: p + 1
                    continue
                }
                if (ch = ("]" as char) as int) and (character_class_depth <> 0)
                {
                    set character_class_depth: character_class_depth - 1
                    set p: p + 1
                    continue
                }
                if character_class_depth = 0
                {
                    if ch = ("{" as char) as int
                    {
                        set in_decimal_quantifier: true
                        set p: p + 1
                        continue
                    }
                    if (ch = ("}" as char) as int) and in_decimal_quantifier
                    {
                        set in_decimal_quantifier: false
                        set p: p + 1
                        continue
                    }
                    if not in_decimal_quantifier
                    {
                        if ch = ("(" as char) as int
                        {
                            set group_depth: group_depth + 1
                            set p: p + 1
                            continue
                        }
                        if (ch = (")" as char) as int) and (group_depth <> 0)
                        {
                            set group_depth: group_depth - 1
                            set p: p + 1
                            continue
                        }
                        ; An unbalanced closer outside a character class: this
                        ; position is the guessed end.
                        if (ch = (")" as char) as int) or (ch = ("]" as char) as int) or (ch = ("}" as char) as int)
                            break
                    }
                }
                set p: p + 1
            }

            ; Whitespace and semicolons at the end are unlikely to belong to the
            ; expression. This loop DECODES — it is the one place in this routine
            ; that does — so the step back is the rune's own size.
            while p > start_of_body
            {
                let ch this.utf8_decode_last_before(p)
                if not is_white_space_like(ch)
                {
                    if ch <> (";" as char) as int
                        break
                }
                set p: p - this.utf8_last_size_before(p)
            }
            this.error_at(DiagUnterminated_regular_expression_literal, state.token_start, p - state.token_start)
        }
        else
        {
            ; Consume the closing slash, then the flags. Validating them is the
            ; `reportErrors` half (see the header note); what is left is finding
            ; where they END.
            ;
            ; ★ The RuneError test is kept for fidelity and is MEASURED
            ; redundant, which is worth stating so nobody deletes it as dead or
            ; trusts it as load-bearing: the only rune the decode can answer that
            ; is not literally in the text is U+FFFD, and UnicodeId's last
            ; identifier-part range ends at 0xFFDC — so `is_identifier_part`
            ; refuses it anyway and the two guards are extensionally equal. A
            ; control that removes it is UNGATED even with a fixture that puts an
            ; invalid byte exactly where a flag would go (slice 16, row 13:
            ; indistinguishable, not uncovered).
            set p: p + 1
            while p < end
            {
                let ch this.utf8_decode_at(p)
                if ch = 0xFFFD
                    break
                if not is_identifier_part(ch)
                    break
                set p: p + this.utf8_size_at(p)
            }
        }

        set state.pos: p
        ; The reference's `s.tokenValue = s.text[s.tokenStart:s.pos]` — a regular
        ; expression's value is its whole source including both slashes and the
        ; flags, so it is a slice and needs no decode.
        this.set_token_value_range(state.token_start, state.pos)
        set state.token: KindRegularExpressionLiteral
        state.token
    }

    ; ── the JSX token scanners ──────────────────────────────────────────────
    ;
    ; Four entry points the ordinary scan loop never reaches: the parser calls
    ; them, and it calls them because JSX has no trivia. Inside an element's
    ; children every byte belongs to the document, so the text between two tags
    ; cannot be produced by a scanner that skips whitespace — it has to be asked
    ; for as one token, and that is what ScanJsxToken is.
    ;
    ; ★★★ THE PARSER DRIVES THE LEXER HERE, WHICH IS THE WHOLE SHAPE OF THIS
    ; GRAMMAR. Every one of the reference's jsx parse routines that finishes a
    ; tag ends by choosing between `p.nextToken()` and `p.scanJsxText()` — the
    ; same position, two different tokenizations, decided by whether what
    ; follows is JSX content or an expression. So a JSX bug shows up as a token
    ; stream, and the token yardstick cannot see any of it: it calls Scan() in a
    ; loop and nothing in this block.

    ; tokenIsIdentifierOrKeyword, which lives in the parser's utilities upstream
    ; and is needed here too — ScanJsxIdentifier only extends a token that is
    ; already a name.
    function token_is_identifier_or_keyword_kind(k: int) returns bool
        k >= KindIdentifier

    ; Copy `len` bytes from an arbitrary pointer into the sink. The other
    ; value_put_* read from `buffer`, i.e. from the SOURCE; this one exists
    ; because ScanJsxIdentifier appends to a value that may itself already be a
    ; decoded sink buffer rather than a slice of the source.
    procedure value_put_pointer(this, p: pointer[char], len: int)
    {
        if value_buffer = null
            return
        this.value_reserve(value_length + len)
        var i: int 0
        while i < len
        {
            set *(value_buffer + value_length): *(p + i)
            set value_length: value_length + 1
            set i: i + 1
        }
    }

    procedure scan_jsx_token(this) returns int
        this.scan_jsx_token_ex(true)

    ; The reference's ReScanJsxToken: back to the FULL START and scan again as
    ; JSX. parseJsxChildren calls it before every child, which is what makes the
    ; ordinary token the parser already looked at harmless — the `<` it fetched
    ; through Scan() is thrown away and the same position is read under the JSX
    ; rules.
    procedure re_scan_jsx_token(this, allow_multiline: bool) returns int
    {
        set state.pos: state.full_start_pos
        set state.token_start: state.full_start_pos
        set state.token: this.scan_jsx_token_ex(allow_multiline)
        state.token
    }

    procedure scan_jsx_token_ex(this, allow_multiline: bool) returns int
    {
        set state.full_start_pos: state.pos
        set state.token_start: state.pos

        let ch this.char()
        if ch < 0
        {
            set state.token: KindEndOfFile
            return state.token
        }
        if ch = ("<" as char) as int
        {
            if this.char_at(1) = ("/" as char) as int
            {
                set state.pos: state.pos + 2
                set state.token: KindLessThanSlashToken
                return state.token
            }
            set state.pos: state.pos + 1
            set state.token: KindLessThanToken
            return state.token
        }
        if ch = ("{" as char) as int
        {
            set state.pos: state.pos + 1
            set state.token: KindOpenBraceToken
            return state.token
        }

        ; ── the text arm ────────────────────────────────────────────────────
        ;
        ; `firstNonWhitespace` is a THREE-VALUED cursor and the reference says so
        ; in a comment rather than in a type: 0 means "only whitespace so far and
        ; no line break", -1 means "a line break came before any content", and
        ; anything positive is the position of the last non-whitespace byte. The
        ; -1 is the answer the caller wants — it selects JsxTextAllWhiteSpaces —
        ; so this is the §3.5j shape with the tristate spelled as an int because
        ; the third state carries a POSITION in the other two.
        var first_non_whitespace: int 0
        repeat
        {
            ; The reference's charAndSize, whose size is 0 at the end of the
            ; text; that is its EOF test and it comes before the `{` one.
            if state.pos >= end
                break
            let c this.utf8_decode_at(state.pos)
            let sz this.utf8_size_at(state.pos)
            if c = ("{" as char) as int
                break
            if c = ("<" as char) as int
            {
                ; A merge-conflict marker inside JSX children is a TOKEN here,
                ; not trivia — the parser's jsx child switch has an arm for it
                ; that ends the child list. So this cannot route through
                ; conflict_marker_token, which answers -1 while skip_trivia is
                ; on; it is the reference's own three lines.
                if this.is_conflict_marker(state.pos)
                {
                    this.error_at(DiagMerge_conflict_marker_encountered, state.pos, MERGE_CONFLICT_MARKER_LENGTH)
                    set state.pos: this.scan_conflict_marker(state.pos)
                    set state.token: KindConflictMarkerTrivia
                    return state.token
                }
                break
            }
            ; Two characters that are legal in JSX text and almost always a
            ; mistake. Both are REPORTED and then consumed, so the text token
            ; still covers them.
            if c = (">" as char) as int
                this.error_at(DiagUnexpected_token_Did_you_mean_or_gt, state.pos, 1)
            else
            {
                if c = ("}" as char) as int
                    this.error_at(DiagUnexpected_token_Did_you_mean_or_rbrace, state.pos, 1)
            }

            ; The reference's three-armed chain, and it must stay a CHAIN: the
            ; second arm's `firstNonWhitespace > 0` and the third's assignment
            ; are only reachable because the first one took the value away
            ; (§3.5u).
            if is_line_break_rune(c) and (first_non_whitespace = 0)
                set first_non_whitespace: 0 - 1
            else if (not allow_multiline) and is_line_break_rune(c) and (first_non_whitespace > 0)
                break
            else if not is_white_space_like(c)
                set first_non_whitespace: state.pos

            set state.pos: state.pos + sz
        }

        ; From the FULL START, not from token_start — they are equal here, and
        ; the reference's spelling is the one kept because ReScanJsxToken is what
        ; makes them equal.
        this.set_token_value_range(state.full_start_pos, state.pos)
        set state.token: KindJsxText
        if first_non_whitespace = 0 - 1
            set state.token: KindJsxTextAllWhiteSpaces
        state.token
    }

    ; The reference's ScanJsxIdentifier, whose own comment is the thing to keep
    ; in view: it MUTATES the visible token without advancing to a new one. The
    ; parser has already scanned an identifier or keyword through Scan(); this
    ; extends it over any `-` and over whatever more identifier parts follow, so
    ; `data-foo` is ONE name. Only the value and pos may be read afterwards.
    procedure scan_jsx_identifier(this) returns int
    {
        if not token_is_identifier_or_keyword_kind(state.token)
            return state.token

        ; `s.tokenValue += …` — so the sink starts armed with what is already
        ; there. The base may point into the source or into an earlier sink
        ; buffer, which is why value_put_pointer exists.
        let base state.token_value
        let base_len state.token_value_len
        this.value_begin(base_len + 16)
        this.value_put_pointer(base, base_len)

        repeat
        {
            let ch this.char()
            if ch < 0
                break
            if ch = ("-" as char) as int
            {
                this.value_put_byte(("-" as char) as int)
                set state.pos: state.pos + 1
                continue
            }
            let old_pos state.pos
            this.scan_identifier_parts_into_sink()
            if state.pos = old_pos
                break
        }

        this.value_commit()
        set state.token: get_identifier_token(state.token_value, state.token_value_len)
        state.token
    }

    ; The reference's scanIdentifierParts, appending into the ARMED sink instead
    ; of returning a string. It is a distinct routine from scan_identifier and
    ; from scan_identifier_decoded although all three walk identifier parts,
    ; because this one starts in the middle of a token and must not touch
    ; token_start, the token kind or the flags of what came before.
    ;
    ; ★ And it is the TWIN of scan_identifier_parts_length (slice 25), which ports
    ; the same reference routine for the caller that wants `len(id)` and throws
    ; the text away. The argument for two of them is written there; what belongs
    ; here is that a change to the WALK — an arm, a predicate, the escape test —
    ; has to be made in both, because the reference has one copy of it.
    procedure scan_identifier_parts_into_sink(this)
    {
        var chunk_start state.pos
        repeat
        {
            let c this.utf8_decode_at(state.pos)
            if is_identifier_part(c)
            {
                set state.pos: state.pos + this.utf8_size_at(state.pos)
                continue
            }
            if c = ("\\" as char) as int
            {
                let esc this.peek_unicode_escape()
                if esc >= 0
                {
                    if is_identifier_part(esc)
                    {
                        this.value_put_range(chunk_start, state.pos)
                        let cp this.scan_unicode_escape(true)
                        this.value_put_codepoint(cp)
                        set chunk_start: state.pos
                        continue
                    }
                }
            }
            break
        }
        this.value_put_range(chunk_start, state.pos)
    }

    ; The reference's ScanJsxAttributeValue. Two things about it are the port:
    ; the value after `=` is scanned as a JSX attribute STRING (no escape
    ; decoding, no newline termination — see scan_string), and anything that is
    ; not a quote falls through to the ORDINARY scan, which is how `{expr}` and
    ; a bare `<` after `=` reach the parser at all.
    procedure scan_jsx_attribute_value(this) returns int
    {
        set state.full_start_pos: state.pos
        ; The whitespace between `=` and the value is skipped HERE rather than
        ; being trivia, so token_start lands on the opening quote.
        repeat
        {
            if state.pos >= end
                break
            let c this.utf8_decode_at(state.pos)
            if not is_white_space_like(c)
                break
            set state.pos: state.pos + this.utf8_size_at(state.pos)
        }
        set state.token_start: state.pos

        let ch this.char()
        if (ch = ("\"" as char) as int) or (ch = ("'" as char) as int)
        {
            ; ★ The token flags are NOT cleared, and that is the reference: only
            ; Scan() clears them, so a string literal reached through this entry
            ; point INHERITS the flags of the `=` token before it and scan_string
            ; ORs SingleQuote onto them. Clearing them here reads as tidier and
            ; would be a divergence — the same is true of scan_jsx_token_ex above.
            this.scan_string(true)
            set state.token: KindStringLiteral
            return state.token
        }
        this.scan()
    }

    ; ── JSDoc ───────────────────────────────────────────────────────────────
    ;
    ; ★★★ SLICE 21, AND THE SHAPE IS SLICE 20'S ALL OVER AGAIN (§3.5az): these
    ; entry points are called by the PARSER, at positions the ordinary scan loop
    ; has already tokenized differently, so the token yardstick reaches none of
    ; them. What is NEW here, and has no precedent in any earlier slice, is that
    ; the parser also moves the scanner's END — a JSDoc comment is parsed with
    ; the source text TRUNCATED to just before its `*/`, so that the closing
    ; delimiter is end-of-file to everything inside. That is the reference's own
    ; `p.sourceText = p.sourceText[:end-2]`, and it is why `set_end` exists.

    ; The reference's SetText, minus the text: the buffer never changes here
    ; (every truncation is a PREFIX of the same source), so only `end` moves.
    ;
    ; ★ It CLEARS the state, exactly as SetText does — and that is safe only
    ; because every caller has already Mark()ed and rewinds afterwards. A
    ; set_end that preserved the state would read as more careful and would put
    ; the port one step out of line with the reference at the one place the
    ; reference is deliberately destructive.
    procedure set_end(this, e: int)
    {
        set end: e
        set state: ScannerState(0, 0, 0, KindUnknown, TokenFlagsNone, null, 0)
    }

    function source_end(this) returns int
        end

    ; A byte of the SOURCE by absolute position, for the two questions the
    ; parser asks of the text itself rather than of a token: is this comment
    ; `/**`-like, and where did the line containing it begin. Both are reads
    ; before `end`, so the truncation above cannot be seen through this.
    function byte_at(this, p: int) returns int
    {
        if p < 0
            return 0 - 1
        if p >= end
            return 0 - 1
        *(buffer + p) as int
    }

    ; The reference's SetSkipJSDocLeadingAsterisks — see the field.
    procedure set_skip_jsdoc_leading_asterisks(this, skip: bool)
    {
        if skip
            set skip_jsdoc_leading_asterisks: skip_jsdoc_leading_asterisks + 1
        else
            set skip_jsdoc_leading_asterisks: skip_jsdoc_leading_asterisks - 1
    }

    ; The reference's CanFollowJSDocAt: the scanner sits just past an `@`, and
    ; the question is whether a TAG can start here. Whitespace, a line break and
    ; the end of the comment all answer yes — the reference's comment says why,
    ; and it is not a grammar rule: an incomplete tag has to remain a tag so that
    ; code completion can offer names for it.
    function can_follow_jsdoc_at(this) returns bool
    {
        if state.pos >= end
            return true
        let ch this.utf8_decode_at(state.pos)
        if is_identifier_start(ch)
            return true
        if is_white_space_single_line(ch)
            return true
        is_line_break_rune(ch)
    }

    ; The reference's ScanJSDocCommentTextToken. It scans a RUN of comment text
    ; and stops at the four things that are not text: a line break, a backtick,
    ; a `{` (which may open an inline `{@link}`), and an `@` that could start a
    ; tag.
    ;
    ; ★★★ The `@` test is three conditions and every one of them is load-bearing:
    ; inside backticks an `@` is never a tag; elsewhere it is one only when the
    ; character BEFORE it is single-line whitespace and the character AFTER it
    ; starts an identifier. So `a@b` in prose stays prose, and so does an email
    ; address. The "before" read is a DECODE BACKWARDS over the text already
    ; consumed, which is the one place in this scanner that needs one.
    ;
    ; ★★ When the run turns out to be EMPTY the reference does not answer an
    ; empty text token — it delegates to ScanJSDocToken, which is what turns the
    ; stopping character into a token of its own. That delegation is the whole
    ; reason the comment loop can be written as one switch.
    procedure scan_jsdoc_comment_text_token(this, in_backticks: bool) returns int
    {
        set state.full_start_pos: state.pos
        set state.token_flags: TokenFlagsNone
        if state.pos >= end
        {
            set state.token: KindEndOfFile
            return state.token
        }
        set state.token_start: state.pos

        repeat
        {
            if state.pos >= end
                break
            let ch this.utf8_decode_at(state.pos)
            let sz this.utf8_size_at(state.pos)
            if is_line_break_rune(ch)
                break
            if ch = ("\`" as char) as int
                break
            if not in_backticks
            {
                if ch = ("{" as char) as int
                    break
                if ch = ("@" as char) as int
                {
                    let previous this.utf8_decode_last_before(state.pos)
                    if is_white_space_single_line(previous)
                    {
                        let next this.utf8_decode_at(state.pos + sz)
                        if is_identifier_start(next)
                            break
                    }
                }
            }
            set state.pos: state.pos + sz
        }

        if state.pos = state.token_start
            return this.scan_jsdoc_token()

        this.set_token_value_range(state.token_start, state.pos)
        set state.token: KindJSDocCommentTextToken
        state.token
    }

    ; The reference's ScanJSDocToken — the token grammar INSIDE a JSDoc comment,
    ; which is a different grammar from the one Scan() implements rather than a
    ; mode of it. Whitespace and newlines are TOKENS here, not trivia, because
    ; the comment's layout is what decides where a tag ends; `*` is a token
    ; because the margin is; and there are no operators at all beyond the
    ; punctuation a type or a name can contain.
    ;
    ; ★ It never reports a diagnostic, which is also the reference: an unknown
    ; character answers KindUnknown and the parser decides what to do with it.
    procedure scan_jsdoc_token(this) returns int
    {
        set state.full_start_pos: state.pos
        set state.token_flags: TokenFlagsNone
        if state.pos >= end
        {
            set state.token: KindEndOfFile
            return state.token
        }

        set state.token_start: state.pos
        let ch this.utf8_decode_at(state.pos)
        let sz this.utf8_size_at(state.pos)
        set state.pos: state.pos + sz

        ; horizontal whitespace: tab, vertical tab, form feed, space
        if (ch = 9) or (ch = 11) or (ch = 12) or (ch = 32)
        {
            repeat
            {
                if state.pos >= end
                    break
                let c2 this.utf8_decode_at(state.pos)
                if not is_white_space_single_line(c2)
                    break
                set state.pos: state.pos + this.utf8_size_at(state.pos)
            }
            set state.token: KindWhitespaceTrivia
            return state.token
        }

        ; ★ `\r\n` is ONE newline token, which is the reference's fallthrough
        ; from the '\r' arm into the '\n' one.
        if (ch = 13) or (ch = 10)
        {
            if ch = 13
            {
                if this.char() = 10
                    set state.pos: state.pos + 1
            }
            set state.token_flags: state.token_flags | TokenFlagsPrecedingLineBreak
            set state.token: KindNewLineTrivia
            return state.token
        }

        if ch = ("@" as char) as int
            return this.jsdoc_punct(KindAtToken)
        if ch = ("*" as char) as int
            return this.jsdoc_punct(KindAsteriskToken)
        if ch = ("{" as char) as int
            return this.jsdoc_punct(KindOpenBraceToken)
        if ch = ("}" as char) as int
            return this.jsdoc_punct(KindCloseBraceToken)
        if ch = ("[" as char) as int
            return this.jsdoc_punct(KindOpenBracketToken)
        if ch = ("]" as char) as int
            return this.jsdoc_punct(KindCloseBracketToken)
        if ch = ("(" as char) as int
            return this.jsdoc_punct(KindOpenParenToken)
        if ch = (")" as char) as int
            return this.jsdoc_punct(KindCloseParenToken)
        if ch = ("<" as char) as int
            return this.jsdoc_punct(KindLessThanToken)
        if ch = (">" as char) as int
            return this.jsdoc_punct(KindGreaterThanToken)
        if ch = ("=" as char) as int
            return this.jsdoc_punct(KindEqualsToken)
        if ch = ("," as char) as int
            return this.jsdoc_punct(KindCommaToken)
        if ch = ("." as char) as int
            return this.jsdoc_punct(KindDotToken)
        if ch = ("\`" as char) as int
            return this.jsdoc_punct(KindBacktickToken)
        if ch = ("#" as char) as int
            return this.jsdoc_punct(KindHashToken)

        ; A backslash is an identifier only if it opens a `\uXXXX` that decodes
        ; to an identifier start; anything else is one Unknown character. The
        ; position is stepped BACK first, because the escape scanner re-reads the
        ; backslash.
        if ch = ("\\" as char) as int
        {
            set state.pos: state.pos - 1
            let cp this.peek_unicode_escape()
            if cp >= 0
            {
                if is_identifier_start(cp)
                {
                    set state.token: this.scan_identifier_decoded(state.pos, 0)
                    return state.token
                }
            }
            set state.pos: state.pos + 1
            set state.token: KindUnknown
            return state.token
        }

        if is_identifier_start(ch)
        {
            ; ★★★ A HYPHEN IS AN IDENTIFIER PART HERE and nowhere else in this
            ; scanner, which is what makes `@ts-ignore` and `@my-tag` single
            ; names. It is the reference's `!IsIdentifierPart(char) && char != '-'`.
            var c: int ch
            repeat
            {
                if state.pos >= end
                    break
                set c: this.utf8_decode_at(state.pos)
                if not is_identifier_part(c)
                {
                    if c <> ("-" as char) as int
                        break
                }
                set state.pos: state.pos + this.utf8_size_at(state.pos)
            }
            ; ★ The reference appends scanIdentifierParts() when the run stopped
            ; at a backslash, i.e. an escape in the MIDDLE of a JSDoc name. That
            ; is scan_identifier_decoded's job here, and it re-reads from the
            ; start — the two-pass arrangement scan_identifier already uses, for
            ; the same reason: the plain case costs nothing.
            if c = ("\\" as char) as int
            {
                set state.token: this.scan_identifier_decoded(state.token_start, 0)
                return state.token
            }
            this.set_token_value_range(state.token_start, state.pos)
            set state.token: get_identifier_token(state.token_value, state.token_value_len)
            return state.token
        }

        set state.token: KindUnknown
        state.token
    }

    ; One line per punctuation arm above. The position is already past the
    ; character, so this only names the token.
    procedure jsdoc_punct(this, k: int) returns int
    {
        set state.token: k
        k
    }

    ; The reference's ReScanAsteriskEqualsToken. `*=` is one token to Scan() and
    ; two to the JSDoc type grammar, where `@type {*=}` is the ALL type followed
    ; by an optional marker. Re-read as a bare `=`, with the position moved back
    ; over the `*` the caller has already consumed as the all-type.
    procedure re_scan_asterisk_equals_token(this) returns int
    {
        set state.pos: state.token_start + 1
        set state.token: KindEqualsToken
        state.token
    }

    ; The reference's ReScanHashToken. A `#` is a PRIVATE IDENTIFIER to the
    ; ordinary scanner — one token covering `#name` — and two tokens to the JSDoc
    ; link grammar, where `{@link Foo#bar}` names a member. Re-read as a bare
    ; `#`, leaving `bar` to the next scan.
    ;
    ; ★ The GUARD is the reference's and is not decoration: outside a private
    ; identifier the routine answers the current token unchanged, so a caller may
    ; ask it of anything. Its one caller here tests the kind first anyway.
    ;
    ; ★★★ THIS ROUTINE WAS MISSING FOR AN AFTERNOON AND NOTHING SAID SO — and
    ; the COMPILER now says so, since 2026-08-19. Its call site is
    ; `scanner.re_scan_hash_token()`, a member call on a POINTER-typed FIELD, and
    ; the compiler used to DROP such a call when the member did not exist: rc 0,
    ; no diagnostic, no call in the emitted body — while the identical call on a
    ; PARAMETER was `Emitter: member not found`, exit 16. The pointer was the
    ; distinction, not the field; the fix is in Planner.resolve_member_access#
    ; and the gate is tests/regress/xfail_member_call_on_pointer_field.scaly. The
    ; comm(1) audit of every `scanner.x` in parser.scaly against every member
    ; declared here is therefore no longer the only thing standing between this
    ; class and a lost afternoon — it is still cheaper than a build, because it
    ; answers for every name at once where the compiler stops at the first.
    procedure re_scan_hash_token(this) returns int
    {
        if state.token = KindPrivateIdentifier
        {
            set state.pos: state.token_start + 1
            set state.token: KindHashToken
        }
        state.token
    }

    ; The reference's ReScanQuestionToken. `??` is one token to Scan() and two to
    ; the JSDoc type grammar, where `??foo` is a nullable type whose inner type is
    ; itself nullable.
    procedure re_scan_question_token(this) returns int
    {
        set state.pos: state.token_start + 1
        set state.token: KindQuestionToken
        state.token
    }

    ; Split out exactly as the reference splits it, so the nesting reads against
    ; reScanGreaterThanTokenInner rather than against a flattened rewrite. The
    ; position is reset to one past the `>` first, so char()/char_at() below
    ; index the characters FOLLOWING it.
    procedure re_scan_greater_than_token_inner(this)
    {
        set state.pos: state.token_start + 1
        if this.char() = (">" as char) as int
        {
            if this.char_at(1) = (">" as char) as int
            {
                if this.char_at(2) = ("=" as char) as int
                {
                    set state.pos: state.pos + 3
                    set state.token: KindGreaterThanGreaterThanGreaterThanEqualsToken
                    return
                }
                set state.pos: state.pos + 2
                set state.token: KindGreaterThanGreaterThanGreaterThanToken
                return
            }
            if this.char_at(1) = ("=" as char) as int
            {
                set state.pos: state.pos + 2
                set state.token: KindGreaterThanGreaterThanEqualsToken
                return
            }
            set state.pos: state.pos + 1
            set state.token: KindGreaterThanGreaterThanToken
            return
        }
        if this.char() = ("=" as char) as int
        {
            set state.pos: state.pos + 1
            set state.token: KindGreaterThanEqualsToken
        }
    }

    ; Consume n bytes and answer the token. Split out so the forty punctuation
    ; arms above stay one line each and can be read against the reference's
    ; switch without scrolling.
    procedure punct1(this, k: int) returns int
    {
        set state.pos: state.pos + 1
        set state.token: k
        k
    }

    procedure punctn(this, n: int, k: int) returns int
    {
        set state.pos: state.pos + n
        set state.token: k
        k
    }
}
