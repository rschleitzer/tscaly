use tscaly.emitter.Emitter
use tscaly.execute.Execute
use tscaly.execute.Reporter
use tscaly.execute.CompileOutcome

; upToDateStatusType, in the reference's order
define UpToDateConfigFileNotFound: int 0
define UpToDateBuildErrors: int 1
define UpToDateUpstreamErrors: int 2
define UpToDateUpToDate: int 3
define UpToDateWithUpstreamTypes: int 4
define UpToDateWithInputFileText: int 5
define UpToDateInputFileMissing: int 6
define UpToDateOutputMissing: int 7
define UpToDateInputFileNewer: int 8
define UpToDateOutOfDateBuildInfoWithPendingEmit: int 9
define UpToDateOutOfDateBuildInfoWithErrors: int 10
define UpToDateOutOfDateOptions: int 11
define UpToDateOutOfDateRoots: int 12
define UpToDateTsVersionOutputOfDate: int 13
define UpToDateForceBuild: int 14
define UpToDateSolution: int 15

define BuildKindNone: int 0
define BuildKindPseudo: int 1
define BuildKindProgram: int 2

; upToDateStatus: the kind and its data — a file name (`name`), an input and an
; output name (`input`, `output`), or the newest input and oldest output with
; their times (`has_times`)
define BuildStatus
(
    kind: int
    name: Slice[char]
    input: Slice[char]
    output: Slice[char]
    has_names: bool
    input_time: int
    output_time: int
    has_times: bool
    ; upstreamErrors.refHasUpstreamErrors (the reference is `name`)
    ref_has_upstream_errors: bool
)
{
    function simple(host: ref[Page], kind: int) returns ref[BuildStatus]
        &BuildStatus^host(kind, Slice[char](), Slice[char](), Slice[char](), false, 0, 0, false, false)

    function named(host: ref[Page], kind: int, name: Slice[char]) returns ref[BuildStatus]
        &BuildStatus^host(kind, name, Slice[char](), Slice[char](), false, 0, 0, false, false)

    function input_output(host: ref[Page], kind: int, input: Slice[char], output: Slice[char]) returns ref[BuildStatus]
        &BuildStatus^host(kind, Slice[char](), input, output, true, 0, 0, false, false)

    function upstream_errors(host: ref[Page], ref_path: Slice[char], ref_has_upstream_errors: bool) returns ref[BuildStatus]
        &BuildStatus^host(UpToDateUpstreamErrors, ref_path, Slice[char](), Slice[char](), false, 0, 0, false, ref_has_upstream_errors)

    function is_pseudo_build(this) returns bool
        (kind = UpToDateWithUpstreamTypes) or (kind = UpToDateWithInputFileText)

    function is_error(this) returns bool
        (kind = UpToDateConfigFileNotFound) or (kind = UpToDateBuildErrors) or (kind = UpToDateUpstreamErrors)
}

; buildInfoEntry
define BuildInfoEntry (info: ref[JsonValue]?  path: Slice[char]  mtime: int  dts_time: int  has_dts_time: bool)

; BuildTask with its taskResult
define BuildTask
(
    config: Slice[char]
    ; the resolved project (null: the config file was not found)
    resolved: ref[TsParsedCommandLine]?
    config_text: Slice[char]
    config_diagnostics: ref[Array[ref[DriverDiagnostic]]]
    status: ref[BuildStatus]?
    build_info_entry: ref[BuildInfoEntry]?
    errors: ref[Array[ref[DriverDiagnostic]]]
    builder: ref[StringBuilder]
    exit_status: int
    program: ref[IncProgram]?
    build_kind: int
    files_to_delete: ref[Array[Slice[char]]]
    ; upStream: the upstream tasks and the index of their reference
    upstream: ref[Array[int]]
    upstream_ref_index: ref[Array[int]]
    ; watch mode: whether the task still has to be looked at this cycle, whether it
    ; was created by the first graph, whether its config changed, the tasks that
    ; reference it, and the package.json lookups its last program or build info made
    pending: bool
    is_initial_cycle: bool
    dirty: bool
    downstream: ref[Array[int]]
    package_jsons: ref[Array[Slice[char]]]
)

define Orchestrator
(
    host: ref[Page]
    sys: ref[ExecSystem]
    cl: ref[ParsedCommandLine]
    tasks: ref[Array[ref[BuildTask]]]
    ; the graph's order (task indices) and its circularity errors
    order: ref[Array[int]]
    graph_errors: ref[Array[ref[DriverDiagnostic]]]
    ; host.resolvedReferences
    resolved_references: ref[Array[ref[ResolvedReference]]]
    mtimes: ref[PathMap[int]]
    verbose: bool
    dry: bool
    force: bool
    clean: bool
    ; watch mode and its watch manager
    watch: bool
    wm: ref[WatchManager]
)
{
    ; tscBuildCompilation
    procedure compile(mutable sys: ref[ExecSystem], mutable cl: ref[ParsedCommandLine]) returns int io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables
    {
        let host sys.host
        let r Execute.reporter(sys, cl.options)
        if cl.errors.get_length() > 0
        {
            Execute.report_all(sys, r, cl.errors)
            return ExitStatusDiagnosticsPresent_OutputsSkipped
        }
        if cl.options.tristate_of("help") = 1
        {
            Help.print_version(sys)
            Help.print_build_help(sys, Execute.default_is_pretty(sys))
            return ExitStatusSuccess
        }
        let o &Orchestrator^host(host, sys, cl, &Array[ref[BuildTask]]^host(), &Array[int]^host(), &Array[ref[DriverDiagnostic]]^host(), &Array[ref[ResolvedReference]]^host(), IncSnapshot.int_map(host), CommandLine.raw_true(cl.raw, "verbose"), CommandLine.raw_true(cl.raw, "dry"), CommandLine.raw_true(cl.raw, "force"), CommandLine.raw_true(cl.raw, "clean"), cl.options.tristate_of("watch") = 1, WatchManager.create(host, sys))
        let status o.start()
        if o.watch
            set sys.build_watcher: o
        status
    }

    procedure relative_file_name(mutable this, mutable file_name: Slice[char]) returns Slice[char]
    {
        if is_rooted_disk_path(file_name) = false
            return file_name
        let relative get_relative_path_to_directory_or_url(host, sys.cwd, file_name, false, sys.cwd)
        if is_rooted_disk_path(relative)
            return file_name
        relative
    }

    ; Orchestrator.Start; ExitStatusNotImplemented after a stop
    procedure start(mutable this) returns int io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables
    {
        if watch
            WatchManager.write_watch_status(sys, cl.options, DiagStarting_compilation_in_watch_mode, null)
        if this.generate_graph(null) = false
            return ExitStatusNotImplemented
        let status this.build_or_clean()
        if (sys.stop_tag.length as int) > 0
            return ExitStatusNotImplemented
        if watch
        {
            this.update_watch()
            wm.reconcile_watches(this.compute_desired_watches())
        }
        status
    }

    ; GenerateGraph: a task per project and per reference (reusing the old tasks a
    ; watch cycle passes), then the order; false after a stop
    procedure generate_graph(mutable this, old_tasks: ref[Array[ref[BuildTask]]]?) returns bool io
    {
        let roots &Array[Slice[char]]^host()
        var i 0
        while i < (cl.file_names.get_length() as int)
        {
            let project cl.file_names[i as size_t]
            set i: i + 1
            roots.add(ConfigFiles.config_of_reference(host, get_normalized_absolute_path(host, project, sys.cwd)))
        }
        if this.create_build_tasks(roots, old_tasks) = false
            return false
        let completed &Array[int]^host()
        let analyzing &Array[int]^host()
        let stack &Array[Slice[char]]^host()
        var r 0
        while r < (roots.get_length() as int)
        {
            this.setup_build_task(roots[r as size_t], 0 - 1, false, completed, analyzing, stack)
            set r: r + 1
        }
        true
    }

    function task_index_of(this, config: Slice[char]) returns int
    {
        var k 0
        while k < (tasks.get_length() as int)
        {
            let existing tasks[k as size_t]
            if existing.config.equals(config)
                return k
            set k: k + 1
        }
        0 - 1
    }

    ; createBuildTasks; false after a stop
    procedure create_build_tasks(mutable this, mutable configs: ref[Array[Slice[char]]], old_tasks: ref[Array[ref[BuildTask]]]?) returns bool io
    {
        var i 0
        while i < (configs.get_length() as int)
        {
            let config configs[i as size_t]
            set i: i + 1
            if this.task_index_of(config) >= 0
                continue
            var reused: ref[BuildTask]? null
            var carried: ref[BuildInfoEntry]? null
            if old_tasks <> null
            {
                let old_list old_tasks as ref[Array[ref[BuildTask]]]
                var o 0
                while o < (old_list.get_length() as int)
                {
                    let existing old_list[o as size_t]
                    set o: o + 1
                    if existing.config.equals(config)
                    {
                        if existing.dirty
                            set carried: existing.build_info_entry
                        else
                            set reused: existing
                        break
                    }
                }
            }
            var task_opt reused
            if task_opt = null
            {
                let made &BuildTask^host(config, null, Slice[char](), &Array[ref[DriverDiagnostic]]^host(), null, null, &Array[ref[DriverDiagnostic]]^host(), &StringBuilder^host(), ExitStatusSuccess, null, BuildKindNone, &Array[Slice[char]]^host(), &Array[int]^host(), &Array[int]^host(), true, old_tasks = null, false, &Array[int]^host(), &Array[Slice[char]]^host())
                set made.build_info_entry: carried
                set task_opt: made
            }
            let task task_opt as ref[BuildTask]
            set task.upstream: &Array[int]^host()
            set task.upstream_ref_index: &Array[int]^host()
            set task.downstream: &Array[int]^host()
            tasks.add(task)
            let resolved this.resolved_project_reference(config)
            if resolved = null
                return false
            let rr resolved as ref[ResolvedReference]
            set task.resolved: rr.parsed
            set task.config_text: rr.text
            set task.config_diagnostics: rr.diagnostics
            if rr.parsed <> null
            {
                let parsed rr.parsed as ref[TsParsedCommandLine]
                if parsed.references <> null
                {
                    let refs parsed.references as ref[Array[ProjectReference]]
                    let children &Array[Slice[char]]^host()
                    var c 0
                    while c < (refs.get_length() as int)
                    {
                        let child_reference refs[c as size_t]
                        children.add(ConfigFiles.config_of_reference(host, child_reference.path))
                        set c: c + 1
                    }
                    if this.create_build_tasks(children, old_tasks) = false
                        return false
                }
            }
        }
        true
    }

    ; host.GetResolvedProjectReference: parsed once, the clock read around it; null
    ; after a stop
    procedure resolved_project_reference(mutable this, mutable config: Slice[char]) returns ref[ResolvedReference]? io
    {
        var i 0
        while i < (resolved_references.get_length() as int)
        {
            let known resolved_references[i as size_t]
            if known.config.equals(config)
                return known
            set i: i + 1
        }
        sys.now()
        let made ConfigFiles.resolve(sys, config, cl.options, cl.raw)
        sys.now()
        if made = null
            return null
        let r made as ref[ResolvedReference]
        resolved_references.add(r)
        r
    }

    ; setupBuildTask: upstream first, then the task into the order
    procedure setup_build_task(mutable this, config: Slice[char], downstream: int, in_circular_context: bool, mutable completed: ref[Array[int]], mutable analyzing: ref[Array[int]], mutable stack: ref[Array[Slice[char]]]) returns int
    {
        let index this.task_index_of(config)
        if index < 0
            return index
        let task tasks[index as size_t]
        if ExecSystem.contains_int(completed, index)
        {
            if watch and (downstream >= 0)
                task.downstream.add(downstream)
            return index
        }
        if ExecSystem.contains_int(analyzing, index)
        {
            if in_circular_context = false
            {
                var sb StringBuilder()
                var k 0
                while k < (stack.get_length() as int)
                {
                    if k > 0
                        sb.append("\n")
                    let entry stack[k as size_t]
                    sb.append(entry.data, entry.length)
                    set k: k + 1
                }
                let joined String^host(sb.to_string())
                let none: Slice[char] ""
                graph_errors.add(&DriverDiagnostic^host(none, none, 0, 0, DiagProject_references_may_not_form_a_circular_graph_Cycle_detected_Colon_0, this.args1(Slice[char](joined.get_length(), joined.get_buffer() as pointer[char])), null, null))
            }
            return 0 - 1
        }
        analyzing.add(index)
        stack.add(config)
        if task.resolved <> null
        {
            let parsed task.resolved as ref[TsParsedCommandLine]
            if parsed.references <> null
            {
                let refs parsed.references as ref[Array[ProjectReference]]
                var r 0
                while r < (refs.get_length() as int)
                {
                    let reference refs[r as size_t]
                    let upstream this.setup_build_task(ConfigFiles.config_of_reference(host, reference.path), index, in_circular_context or reference.circular, completed, analyzing, stack)
                    if upstream >= 0
                    {
                        task.upstream.add(upstream)
                        task.upstream_ref_index.add(r)
                    }
                    set r: r + 1
                }
            }
        }
        ExecSystem.pop_slice(host, stack)
        completed.add(index)
        order.add(index)
        if watch and (downstream >= 0)
            task.downstream.add(downstream)
        index
    }

    ; buildOrClean; the exit status
    procedure build_or_clean(mutable this) returns int io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables
    {
        if (clean = false) and verbose
        {
            var sb StringBuilder()
            var i 0
            while i < (order.get_length() as int)
            {
                let task tasks[order[i as size_t] as size_t]
                let name this.relative_file_name(task.config)
                sb.append("\r\n    * ")
                sb.append(name.data, name.length)
                set i: i + 1
            }
            let joined String^host(sb.to_string())
            this.report_status(sys.output, DiagProjects_in_this_build_Colon_0, CommandLine.args1(host, Slice[char](joined.get_length(), joined.get_buffer() as pointer[char])))
        }
        var status ExitStatusSuccess
        let errors &Array[ref[DriverDiagnostic]]^host()
        let files_to_delete &Array[Slice[char]]^host()
        if graph_errors.get_length() > 0
        {
            set status: ExitStatusProjectReferenceCycle_OutputsSkipped
            var g 0
            while g < (graph_errors.get_length() as int)
            {
                let d graph_errors[g as size_t]
                Execute.report(sys, Execute.reporter(sys, cl.options), d)
                errors.add(d)
                set g: g + 1
            }
        }
        var k 0
        let task_count order.get_length() as int
        while (k < task_count) and (graph_errors.get_length() = 0)
        {
            let task tasks[order[k as size_t] as size_t]
            set k: k + 1
            ; a fresh taskResult
            set task.builder: &StringBuilder^host()
            set task.exit_status: ExitStatusSuccess
            set task.build_kind: BuildKindNone
            set task.files_to_delete: &Array[Slice[char]]^host()
            if clean
                this.clean_project(task)
            else
            {
                if this.build_project(task) = false
                    return ExitStatusNotImplemented
            }
            ; BuildTask.report
            var e 0
            while e < (task.errors.get_length() as int)
            {
                errors.add(task.errors[e as size_t])
                set e: e + 1
            }
            let text task.builder.to_string()
            sys.output.append(text)
            if task.exit_status > status
                set status: task.exit_status
            if task.build_kind = BuildKindProgram
                (task.program as ref[IncProgram]).baseline(sys.programs)
            var d 0
            while d < (task.files_to_delete.get_length() as int)
            {
                files_to_delete.add(task.files_to_delete[d as size_t])
                set d: d + 1
            }
        }
        ; orchestratorResult.report
        if watch
            WatchManager.write_error_count(sys, cl.options, errors.get_length() as int)
        else
        {
            if Execute.should_be_pretty(sys, cl.options)
                DiagnosticWriter.write_error_summary(host, sys.output, errors, sys.cwd, "\n")
        }
        if files_to_delete.get_length() > 0
        {
            var sb StringBuilder()
            var f 0
            while f < (files_to_delete.get_length() as int)
            {
                let file files_to_delete[f as size_t]
                sb.append("\r\n * ")
                sb.append(file.data, file.length)
                set f: f + 1
            }
            let joined String^host(sb.to_string())
            this.report_status(sys.output, DiagA_non_dry_build_would_delete_the_following_files_Colon_0, CommandLine.args1(host, Slice[char](joined.get_length(), joined.get_buffer() as pointer[char])))
        }
        status
    }

    ; CreateBuilderStatusReporter: the harness's markers around the time and the
    ; flattened message, then two newlines
    procedure report_status(mutable this, mutable out: ref[StringBuilder], code: int, args: ref[Array[String]]?)
    {
        if cl.options.tristate_of("quiet") = 1
            return
        out.append("!!! Build Status Report Start\n")
        sys.now()
        let none: Slice[char] ""
        let d &DriverDiagnostic^host(none, none, 0, 0, code, args, null, null)
        if Execute.should_be_pretty(sys, cl.options)
        {
            out.append("[")
            out.append("[90m")
            out.append("12:00:00 AM")
            out.append("[0m")
            out.append("] ")
        }
        else
            out.append("12:00:00 AM - ")
        DiagnosticWriter.write_flattened_message(out, d, "\n")
        out.append("\n\n")
        out.append("!!! Build Status Report End\n")
    }

    procedure report_task_diagnostic(mutable this, mutable task: ref[BuildTask], mutable d: ref[DriverDiagnostic])
    {
        task.errors.add(d)
        let saved sys.output
        set sys.output: task.builder
        Execute.report(sys, Execute.reporter(sys, cl.options), d)
        set sys.output: saved
    }

    ; host.GetMTime through the cache: 0 for a missing file
    procedure mtime_of(mutable this, file: Slice[char]) returns int
    {
        let k mtimes.slot_of(file)
        if k >= 0
            return mtimes.value_at(k)
        var t 0
        let i sys.find_index(file)
        if i >= 0
        {
            let entry sys.files[i as size_t]
            if entry <> null
                set t: (entry as ref[VfsFile]).mtime
        }
        mtimes.store(slice_copy_on(host, file), t)
        t
    }

    ; host.SetMTime (Chtimes)
    procedure set_mtime(mutable this, file: Slice[char], t: int)
    {
        let i sys.find_index(file)
        if i < 0
            return
        let entry sys.files[i as size_t]
        if entry = null
            return
        let file_entry entry as ref[VfsFile]
        set file_entry.mtime: t
    }

    ; ── BuildTask.buildProject ───────────────────────────────────────────────

    procedure build_project(mutable this, mutable task: ref[BuildTask]) returns bool io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables
    {
        if task.pending
        {
            set task.status: this.up_to_date_status(task)
            if (sys.stop_tag.length as int) > 0
                return false
            this.report_up_to_date_status(task)
            if this.handle_status_that_doesnt_require_build(task) = false
            {
                if this.compile_and_emit(task) = false
                    return false
                this.update_downstream(task)
            }
            else
            {
                if task.resolved <> null
                {
                    var i 0
                    while i < (task.config_diagnostics.get_length() as int)
                    {
                        this.report_task_diagnostic(task, task.config_diagnostics[i as size_t])
                        set i: i + 1
                    }
                }
                if task.errors.get_length() > 0
                    set task.exit_status: ExitStatusDiagnosticsPresent_OutputsSkipped
            }
        }
        else
        {
            if task.errors.get_length() > 0
            {
                this.report_up_to_date_status(task)
                ; reported again, not added again
                let saved sys.output
                set sys.output: task.builder
                var e 0
                while e < (task.errors.get_length() as int)
                {
                    Execute.report(sys, Execute.reporter(sys, cl.options), task.errors[e as size_t])
                    set e: e + 1
                }
                set sys.output: saved
            }
        }
        ; unblockDownstream
        set task.pending: false
        set task.is_initial_cycle: false
        true
    }

    ; updateDownstream: a rebuilt project marks the projects referencing it pending,
    ; their up-to-date status moved by whether its declaration files changed
    procedure update_downstream(mutable this, task: ref[BuildTask])
    {
        if task.is_initial_cycle
            return
        let status task.status as ref[BuildStatus]
        if CommandLine.raw_true(cl.raw, "stopBuildOnErrors") and status.is_error()
            return
        var changed_dts false
        if task.program <> null
            set changed_dts: (task.program as ref[IncProgram]).snapshot.has_changed_dts_file
        let own_path Watcher.to_path_of(sys, task.config)
        var i 0
        while i < (task.downstream.get_length() as int)
        {
            let ds tasks[task.downstream[i as size_t] as size_t]
            set i: i + 1
            if ds.status <> null
            {
                let ds_status ds.status as ref[BuildStatus]
                var kind ds_status.kind
                if kind = UpToDateUpToDate
                {
                    if changed_dts = false
                        set ds.status: &BuildStatus^host(UpToDateWithUpstreamTypes, ds_status.name, ds_status.input, ds_status.output, ds_status.has_names, ds_status.input_time, ds_status.output_time, ds_status.has_times, false)
                    else
                        set kind: UpToDateWithUpstreamTypes
                }
                if (kind = UpToDateWithUpstreamTypes) or (kind = UpToDateWithInputFileText)
                {
                    if changed_dts
                        set ds.status: BuildStatus.input_output(host, UpToDateInputFileNewer, task.config, Orchestrator.oldest_output_file_name(ds_status))
                }
                if kind = UpToDateUpstreamErrors
                {
                    let ref_config ConfigFiles.config_of_reference(host, ds_status.name)
                    let ref_path Watcher.to_path_of(sys, ref_config)
                    if ref_path.equals(own_path)
                        this.reset_status(ds)
                }
            }
            set ds.pending: true
        }
    }

    ; upToDateStatus.oldestOutputFileName
    function oldest_output_file_name(status: ref[BuildStatus]) returns Slice[char]
    {
        if status.has_times or status.has_names
            return status.output
        status.name
    }

    ; BuildTask.resetStatus
    procedure reset_status(this, mutable task: ref[BuildTask])
    {
        set task.status: null
        set task.pending: true
        set task.errors: &Array[ref[DriverDiagnostic]]^host()
    }

    ; BuildTask.resetConfig: the config parsed again on the next graph
    procedure reset_config(mutable this, mutable task: ref[BuildTask])
    {
        set task.dirty: true
        let kept &Array[ref[ResolvedReference]]^host()
        var i 0
        while i < (resolved_references.get_length() as int)
        {
            let known resolved_references[i as size_t]
            set i: i + 1
            if known.config.equals(task.config) = false
                kept.add(known)
        }
        set this.resolved_references: kept
    }

    procedure task_status(mutable this, mutable task: ref[BuildTask], code: int, args: ref[Array[String]]?)
        this.report_status(task.builder, code, args)

    procedure args1(mutable this, a: Slice[char]) returns ref[Array[String]]
        CommandLine.args1(host, a)

    procedure args2(mutable this, a: Slice[char], b: Slice[char]) returns ref[Array[String]]
        CommandLine.args2(host, a, String(b.data as pointer[const_char], b.length))

    procedure args3(mutable this, mutable a: Slice[char], mutable b: Slice[char], c: Slice[char]) returns ref[Array[String]]
    {
        let list CommandLine.args2(host, a, String(b.data as pointer[const_char], b.length))
        list.add(String^host(c.data as pointer[const_char], c.length))
        list
    }

    ; handleStatusThatDoesntRequireBuild
    procedure handle_status_that_doesnt_require_build(mutable this, mutable task: ref[BuildTask]) returns bool
    {
        let status task.status as ref[BuildStatus]
        let kind status.kind
        if kind = UpToDateUpToDate
        {
            if dry
                this.task_status(task, DiagProject_0_is_up_to_date, this.args1(task.config))
            return true
        }
        if kind = UpToDateUpstreamErrors
        {
            if verbose
            {
                if status.ref_has_upstream_errors
                    this.task_status(task, DiagSkipping_build_of_project_0_because_its_dependency_1_was_not_built, this.args2(this.relative_file_name(task.config), this.relative_file_name(status.name)))
                else
                    this.task_status(task, DiagSkipping_build_of_project_0_because_its_dependency_1_has_errors, this.args2(this.relative_file_name(task.config), this.relative_file_name(status.name)))
            }
            return true
        }
        if kind = UpToDateSolution
            return true
        if kind = UpToDateConfigFileNotFound
        {
            let none: Slice[char] ""
            this.report_task_diagnostic(task, &DriverDiagnostic^host(none, none, 0, 0, DiagFile_0_not_found, this.args1(task.config), null, null))
            return true
        }
        if status.is_pseudo_build()
        {
            if dry
            {
                this.task_status(task, DiagA_non_dry_build_would_update_timestamps_for_output_of_project_0, this.args1(task.config))
                set task.status: BuildStatus.simple(host, UpToDateUpToDate)
                return true
            }
            this.update_time_stamps(task, null, DiagUpdating_output_timestamps_of_project_0)
            set task.status: &BuildStatus^host(UpToDateUpToDate, status.name, status.input, status.output, status.has_names, status.input_time, status.output_time, status.has_times, false)
            set task.build_kind: BuildKindPseudo
            return true
        }
        if dry
        {
            this.task_status(task, DiagA_non_dry_build_would_build_project_0, this.args1(task.config))
            set task.status: BuildStatus.simple(host, UpToDateUpToDate)
            return true
        }
        false
    }

    ; compileAndEmit; false after a stop
    procedure compile_and_emit(mutable this, mutable task: ref[BuildTask]) returns bool io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables
    {
        let resolved task.resolved as ref[TsParsedCommandLine]
        set task.errors: &Array[ref[DriverDiagnostic]]^host()
        if verbose
            this.task_status(task, DiagBuilding_project_0, this.args1(this.relative_file_name(task.config)))
        let options resolved.options
        if Execute.unported_compile_options(sys, options)
            return false
        let program DriverProgram.create(host, sys, options, resolved.file_names, task.config, task.config_text, task.config_diagnostics)
        set program.root_config: resolved
        set program.known_references: resolved_references
        set program.reference_options: cl.options
        set program.reference_raw: cl.raw
        sys.now()
        var old: ref[IncSnapshot]? null
        if force = false
            set old: ToSnapshot.read(host, program)
        sys.now()
        sys.now()
        set sys.trace_target: task.builder
        let loaded program.load()
        set sys.trace_target: null
        if loaded = false
            return false
        sys.now()
        sys.now()
        let created IncProgram.create(host, program, old)
        if created = null
            return false
        let ip created as ref[IncProgram]
        set ip.build_mode: true
        set task.program: ip
        sys.now()
        let saved sys.output
        set sys.output: task.builder
        let outcome_opt Execute.emit_and_report_incremental(sys, ip, Execute.reporter(sys, cl.options), false, task.errors, mtimes)
        set sys.output: saved
        if outcome_opt = null
            return false
        let outcome outcome_opt as ref[CompileOutcome]
        if ip.build_info_emitted
            this.on_build_info_emit(task, ip)
        set task.package_jsons: this.package_json_lookup_paths(ip)
        set task.exit_status: outcome.status
        let no_emit_on_error options.tristate_of("noEmitOnError") = 1
        let status_kind (task.status as ref[BuildStatus]).kind
        if ((no_emit_on_error = false) or (outcome.diagnostics.get_length() = 0)) and ((outcome.emitted_files.get_length() > 0) or (status_kind <> UpToDateOutOfDateBuildInfoWithErrors))
            this.update_time_stamps(task, outcome.emitted_files, DiagUpdating_unchanged_output_timestamps_of_project_0)
        set task.build_kind: BuildKindProgram
        if (outcome.status = ExitStatusDiagnosticsPresent_OutputsSkipped) or (outcome.status = ExitStatusDiagnosticsPresent_OutputsGenerated)
            set task.status: BuildStatus.simple(host, UpToDateBuildErrors)
        else
        {
            var oldest Slice[char]()
            if outcome.emitted_files.get_length() > 0
                set oldest: outcome.emitted_files[0]
            else
            {
                let outputs this.output_file_names(task)
                if outputs.get_length() > 0
                    set oldest: outputs[0]
            }
            set task.status: BuildStatus.named(host, UpToDateUpToDate, oldest)
        }
        true
    }

    ; onBuildInfoEmit: the entry the task keeps
    procedure on_build_info_emit(mutable this, mutable task: ref[BuildTask], mutable ip: ref[IncProgram])
    {
        var dts_time 0
        var has_dts_time false
        if ip.build_info_dts_changed
        {
            set dts_time: ip.build_info_time
            set has_dts_time: true
        }
        else
        {
            if task.build_info_entry <> null
            {
                let old task.build_info_entry as ref[BuildInfoEntry]
                set dts_time: old.dts_time
                set has_dts_time: old.has_dts_time
            }
        }
        let file_name IncProgram.build_info_file_name(host, ip.program)
        set task.build_info_entry: &BuildInfoEntry^host(ip.build_info_json, file_name, ip.build_info_time, dts_time, has_dts_time)
    }

    function can_update_js_dts_output_timestamps(this, task: ref[BuildTask]) returns bool
    {
        let options (task.resolved as ref[TsParsedCommandLine]).options
        (options.tristate_of("noEmit") <> 1) and (IncOptions.is_incremental(options) = false)
    }

    ; updateTimeStamps
    procedure update_time_stamps(mutable this, mutable task: ref[BuildTask], emitted: ref[Array[Slice[char]]]?, verbose_message: int)
    {
        let resolved task.resolved as ref[TsParsedCommandLine]
        let build_info_name IncProgram.build_info_file_name_of(host, resolved.options, task.config, sys.cwd)
        let now sys.now()
        var reported false
        let files &Array[Slice[char]]^host()
        if this.can_update_js_dts_output_timestamps(task)
        {
            let outputs this.output_file_names(task)
            var i 0
            while i < (outputs.get_length() as int)
            {
                files.add(outputs[i as size_t])
                set i: i + 1
            }
        }
        files.add(build_info_name)
        var k 0
        while k < (files.get_length() as int)
        {
            let file files[k as size_t]
            set k: k + 1
            if emitted <> null
            {
                if ExecSystem.contains(emitted as ref[Array[Slice[char]]], file)
                    continue
            }
            if (reported = false) and verbose
            {
                this.task_status(task, verbose_message, this.args1(this.relative_file_name(task.config)))
                set reported: true
            }
            if sys.find_index(file) >= 0
            {
                this.set_mtime(file, now)
                if file.equals(build_info_name)
                {
                    if task.build_info_entry <> null
                    {
                        let entry task.build_info_entry as ref[BuildInfoEntry]
                        set entry.mtime: now
                    }
                }
            }
        }
    }

    ; ParsedCommandLine.GetOutputFileNames
    procedure output_file_names(mutable this, task: ref[BuildTask]) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        let resolved task.resolved as ref[TsParsedCommandLine]
        let options resolved.options
        var i 0
        while i < (resolved.file_names.get_length() as int)
        {
            let file get_normalized_absolute_path(host, resolved.file_names[i as size_t], sys.cwd)
            set i: i + 1
            if is_declaration_file_name_of(file)
                continue
            let is_json file.ends_with(".json")
            if options.tristate_of("emitDeclarationOnly") <> 1
            {
                let js this.output_path(task, file, this.js_extension(options, file), options.text_of("outDir"))
                if (is_json = false) or (js.equals(file) = false)
                {
                    out.add(js)
                    if (is_json = false) and (options.tristate_of("sourceMap") = 1)
                        out.add(join_slices(host, js, ".map"))
                }
            }
            if is_json
                continue
            if IncOptions.emit_declarations(options)
            {
                var dir options.text_of("declarationDir")
                if (dir.length as int) = 0
                    set dir: options.text_of("outDir")
                let dts this.output_path(task, file, this.dts_extension(file), dir)
                out.add(dts)
                if options.tristate_of("declarationMap") = 1
                    out.add(join_slices(host, dts, ".map"))
            }
        }
        out
    }

    function js_extension(this, options: ref[TsOptions], file: Slice[char]) returns Slice[char]
    {
        if file.ends_with(".json")
            return ".json"
        if file.ends_with(".tsx") or file.ends_with(".jsx")
        {
            let jsx options.text_of("jsx")
            if jsx.equals("preserve")
                return ".jsx"
        }
        if file.ends_with(".mts") or file.ends_with(".mjs")
            return ".mjs"
        if file.ends_with(".cts") or file.ends_with(".cjs")
            return ".cjs"
        ".js"
    }

    function dts_extension(this, file: Slice[char]) returns Slice[char]
    {
        if file.ends_with(".mts") or file.ends_with(".mjs")
            return ".d.mts"
        if file.ends_with(".cts") or file.ends_with(".cjs")
            return ".d.cts"
        ".d.ts"
    }

    ; getOutputPathWithoutChangingExtension + ChangeExtension: under the output
    ; directory relative to the common source directory (rootDir, else the config's
    ; directory)
    procedure output_path(mutable this, task: ref[BuildTask], file: Slice[char], ext: Slice[char], out_dir: Slice[char]) returns Slice[char]
    {
        let options (task.resolved as ref[TsParsedCommandLine]).options
        var path file
        if (out_dir.length as int) > 0
        {
            var common options.text_of("rootDir")
            if (common.length as int) = 0
                set common: get_directory_path(host, task.config)
            else
                set common: get_normalized_absolute_path(host, common, sys.cwd)
            let new_dir get_normalized_absolute_path(host, out_dir, sys.cwd)
            set path: Emitter.source_file_path_in_new_dir(host, file, new_dir, sys.cwd, common)
        }
        let without path.subslice(0, remove_file_extension(path) as size_t)
        join_slices(host, without, ext)
    }

    ; loadOrStoreBuildInfo
    procedure load_build_info(mutable this, mutable task: ref[BuildTask], build_info_path: Slice[char]) returns ref[BuildInfoEntry] io
    {
        if task.build_info_entry <> null
        {
            let existing task.build_info_entry as ref[BuildInfoEntry]
            if existing.path.equals(build_info_path)
                return existing
        }
        var info: ref[JsonValue]? null
        var text Slice[char]()
        if sys.read_file(build_info_path, &text)
            set info: JsonParser.parse(host, text)
        var mtime 0
        if info <> null
            set mtime: this.mtime_of(build_info_path)
        let entry &BuildInfoEntry^host(info, build_info_path, mtime, 0, false)
        set task.build_info_entry: entry
        entry
    }

    ; getUpToDateStatus
    procedure up_to_date_status(mutable this, mutable task: ref[BuildTask]) returns ref[BuildStatus] io
    {
        if task.status <> null
            return task.status as ref[BuildStatus]
        if task.resolved = null
            return BuildStatus.simple(host, UpToDateConfigFileNotFound)
        let resolved task.resolved as ref[TsParsedCommandLine]
        let options resolved.options
        if (resolved.file_names.get_length() = 0) and (resolved.references <> null)
            return BuildStatus.simple(host, UpToDateSolution)
        let refs_opt resolved.references
        var u 0
        while u < (task.upstream.get_length() as int)
        {
            let upstream_task tasks[task.upstream[u as size_t] as size_t]
            if CommandLine.raw_true(cl.raw, "stopBuildOnErrors") and (upstream_task.status <> null)
            {
                let upstream_status upstream_task.status as ref[BuildStatus]
                if upstream_status.is_error()
                {
                    let refs refs_opt as ref[Array[ProjectReference]]
                    let upstream_reference refs[task.upstream_ref_index[u as size_t] as size_t]
                    return BuildStatus.upstream_errors(host, upstream_reference.path, upstream_status.kind = UpToDateUpstreamErrors)
                }
            }
            set u: u + 1
        }
        if force
            return BuildStatus.simple(host, UpToDateForceBuild)
        let build_info_path IncProgram.build_info_file_name_of(host, options, task.config, sys.cwd)
        let build_info_directory get_directory_path(host, build_info_path)
        let entry this.load_build_info(task, build_info_path)
        if entry.info = null
            return BuildStatus.named(host, UpToDateOutputMissing, build_info_path)
        let info entry.info as ref[JsonValue]
        let version info.string_of("version")
        if version.equals("7.0.0-dev") = false
            return BuildStatus.named(host, UpToDateTsVersionOutputOfDate, version)
        let no_check options.tristate_of("noCheck") = 1
        if JsonText.member_bool(info, "errors") or ((no_check = false) and (JsonText.member_bool(info, "semanticErrors") or JsonText.member_bool(info, "checkPending")))
            return BuildStatus.named(host, UpToDateOutOfDateBuildInfoWithErrors, build_info_path)
        let file_names info.get("fileNames")
        var is_incremental_info false
        if file_names <> null
            set is_incremental_info: (file_names as ref[JsonValue]).size() > 0
        if IncOptions.is_incremental(options)
        {
            if is_incremental_info = false
                return BuildStatus.named(host, UpToDateOutOfDateOptions, build_info_path)
            if (IncOptions.emit_declarations(options) and (info.get("emitDiagnosticsPerFile") <> null)) or ((no_check = false) and ((info.get("changeFileSet") <> null) or (info.get("semanticDiagnosticsPerFile") <> null)))
                return BuildStatus.named(host, UpToDateOutOfDateBuildInfoWithErrors, build_info_path)
            if (options.tristate_of("noEmit") <> 1) and ((info.get("changeFileSet") <> null) or (info.get("affectedFilesPendingEmit") <> null))
                return BuildStatus.named(host, UpToDateOutOfDateBuildInfoWithPendingEmit, build_info_path)
            if this.is_emit_pending(options, info)
                return BuildStatus.named(host, UpToDateOutOfDateOptions, build_info_path)
        }
        var input_text_unchanged false
        var oldest_output_file build_info_path
        var oldest_output_time entry.mtime
        var newest_input_file Slice[char]()
        var newest_input_time 0
        let seen_roots &Array[Slice[char]]^host()
        let resolved_roots &Array[Slice[char]]^host()
        let roots this.build_info_roots(info, build_info_directory, resolved_roots)
        var i 0
        while i < (resolved.file_names.get_length() as int)
        {
            let input_file resolved.file_names[i as size_t]
            set i: i + 1
            let input_path get_normalized_absolute_path(host, input_file, sys.cwd)
            let input_time this.mtime_of(input_path)
            if input_time = 0
                return BuildStatus.named(host, UpToDateInputFileMissing, input_file)
            if input_time > oldest_output_time
            {
                var matched false
                if is_incremental_info
                {
                    var resolved_input input_path
                    let version_text this.root_file_version(info, roots, resolved_roots, input_path, build_info_directory, &resolved_input)
                    if (version_text.length as int) > 0
                    {
                        var text Slice[char]()
                        if sys.read_file(resolved_input, &text)
                        {
                            let current IncOptions.compute_hash(host, text, true)
                            if current.equals(version_text)
                            {
                                set matched: true
                                set input_text_unchanged: true
                            }
                        }
                    }
                }
                if matched = false
                    return BuildStatus.input_output(host, UpToDateInputFileNewer, input_file, build_info_path)
            }
            if input_time > newest_input_time
            {
                set newest_input_file: input_file
                set newest_input_time: input_time
            }
            seen_roots.add(input_path)
        }
        var r 0
        while r < (roots.get_length() as int)
        {
            let root roots[r as size_t]
            if ExecSystem.contains(seen_roots, root) = false
                return BuildStatus.input_output(host, UpToDateOutOfDateRoots, root, build_info_path)
            set r: r + 1
        }
        if is_incremental_info
        {
            let infos info.get("fileInfos")
            let names file_names as ref[JsonValue]
            if infos <> null
            {
                let iv infos as ref[JsonValue]
                var f 0
                while f < iv.size()
                {
                    let name (names.value_at(f) as ref[JsonValue]).text
                    let file_info iv.value_at(f) as ref[JsonValue]
                    set f: f + 1
                    if (get_root_length(name) = 0) and (path_is_relative(name) = false)
                        continue
                    let input_file get_normalized_absolute_path(host, name, build_info_directory)
                    if ExecSystem.contains(seen_roots, input_file) or ExecSystem.contains(resolved_roots, input_file)
                        continue
                    let input_time this.mtime_of(input_file)
                    if input_time = 0
                        return BuildStatus.named(host, UpToDateInputFileMissing, input_file)
                    if input_time > oldest_output_time
                    {
                        var version_text Slice[char]()
                        if file_info.kind = JsonKindString
                            set version_text: file_info.text
                        else
                            set version_text: file_info.string_of("version")
                        var current Slice[char]()
                        if (version_text.length as int) > 0
                        {
                            var text Slice[char]()
                            if sys.read_file(input_file, &text)
                                set current: IncOptions.compute_hash(host, text, true)
                        }
                        if ((version_text.length as int) = 0) or (version_text.equals(current) = false)
                            return BuildStatus.input_output(host, UpToDateInputFileNewer, input_file, build_info_path)
                        set input_text_unchanged: true
                    }
                }
            }
        }
        if IncOptions.is_incremental(options) = false
        {
            let outputs this.output_file_names(task)
            var o 0
            while o < (outputs.get_length() as int)
            {
                let output_file outputs[o as size_t]
                set o: o + 1
                let output_time this.mtime_of(output_file)
                if output_time = 0
                    return BuildStatus.named(host, UpToDateOutputMissing, output_file)
                if output_time < newest_input_time
                    return BuildStatus.input_output(host, UpToDateInputFileNewer, newest_input_file, output_file)
                if output_time < oldest_output_time
                {
                    set oldest_output_file: output_file
                    set oldest_output_time: output_time
                }
            }
        }
        var ref_dts_unchanged false
        var up 0
        while up < (task.upstream.get_length() as int)
        {
            let upstream_task tasks[task.upstream[up as size_t] as size_t]
            let ref_index task.upstream_ref_index[up as size_t]
            set up: up + 1
            if upstream_task.status = null
                continue
            let upstream_status upstream_task.status as ref[BuildStatus]
            if upstream_status.kind = UpToDateSolution
                continue
            if upstream_status.has_times and (upstream_status.input_time <> 0) and (upstream_status.input_time < oldest_output_time)
                continue
            let refs refs_opt as ref[Array[ProjectReference]]
            let upstream_reference refs[ref_index as size_t]
            if this.has_conflicting_build_info(task, upstream_task)
                return BuildStatus.input_output(host, UpToDateInputFileNewer, upstream_reference.path, oldest_output_file)
            let newest_dts this.latest_changed_dts_mtime(upstream_task)
            if (newest_dts <> 0) and (newest_dts < oldest_output_time)
            {
                set ref_dts_unchanged: true
                continue
            }
            return BuildStatus.input_output(host, UpToDateInputFileNewer, upstream_reference.path, oldest_output_file)
        }
        let config_time this.mtime_of(task.config)
        if config_time > oldest_output_time
            return BuildStatus.input_output(host, UpToDateInputFileNewer, task.config, oldest_output_file)
        var x 0
        while x < (resolved.extended_files.get_length() as int)
        {
            let extended_config resolved.extended_files[x as size_t]
            set x: x + 1
            if this.mtime_of(extended_config) > oldest_output_time
                return BuildStatus.input_output(host, UpToDateInputFileNewer, extended_config, oldest_output_file)
        }
        let package_jsons info.get("packageJsons")
        if package_jsons <> null
        {
            let pv package_jsons as ref[JsonValue]
            var p 0
            while p < pv.size()
            {
                let package_json get_normalized_absolute_path(host, (pv.value_at(p) as ref[JsonValue]).text, build_info_directory)
                set p: p + 1
                let t this.mtime_of(package_json)
                if t = 0
                    return BuildStatus.named(host, UpToDateInputFileMissing, package_json)
                if t > oldest_output_time
                    return BuildStatus.input_output(host, UpToDateInputFileNewer, package_json, oldest_output_file)
            }
        }
        let missing info.get("missingPackageJsons")
        if missing <> null
        {
            let mv missing as ref[JsonValue]
            var m 0
            while m < mv.size()
            {
                let package_json get_normalized_absolute_path(host, (mv.value_at(m) as ref[JsonValue]).text, build_info_directory)
                set m: m + 1
                if this.mtime_of(package_json) <> 0
                    return BuildStatus.input_output(host, UpToDateInputFileNewer, package_json, oldest_output_file)
            }
        }
        set task.package_jsons: this.build_info_package_jsons(info, build_info_directory)
        var kind UpToDateUpToDate
        if input_text_unchanged
            set kind: UpToDateWithInputFileText
        if ref_dts_unchanged
            set kind: UpToDateWithUpstreamTypes
        &BuildStatus^host(kind, Slice[char](), newest_input_file, oldest_output_file, false, newest_input_time, oldest_output_time, true, false)
    }

    ; hasConflictingBuildInfo
    function has_conflicting_build_info(this, task: ref[BuildTask], upstream: ref[BuildTask]) returns bool
    {
        if (task.build_info_entry = null) or (upstream.build_info_entry = null)
            return false
        let a task.build_info_entry as ref[BuildInfoEntry]
        let b upstream.build_info_entry as ref[BuildInfoEntry]
        a.path.equals(b.path)
    }

    ; getLatestChangedDtsMTime
    procedure latest_changed_dts_mtime(mutable this, mutable task: ref[BuildTask]) returns int
    {
        if task.build_info_entry = null
            return 0
        let entry task.build_info_entry as ref[BuildInfoEntry]
        if entry.has_dts_time
            return entry.dts_time
        var t 0
        if entry.info <> null
        {
            let latest (entry.info as ref[JsonValue]).string_of("latestChangedDtsFile")
            if (latest.length as int) > 0
                set t: this.mtime_of(get_normalized_absolute_path(host, latest, get_directory_path(host, entry.path)))
        }
        set entry.dts_time: t
        set entry.has_dts_time: true
        t
    }

    ; BuildInfo.IsEmitPending
    function is_emit_pending(this, options: ref[TsOptions], info: ref[JsonValue]) returns bool
    {
        let no_emit options.tristate_of("noEmit") = 1
        if (no_emit = false) or IncOptions.emit_declarations(options)
        {
            var old_kind 1
            let old_options info.get("options")
            if old_options <> null
            {
                let o old_options as ref[JsonValue]
                if JsonText.member_bool(o, "sourceMap")
                    set old_kind: old_kind | 2
                if JsonText.member_bool(o, "inlineSourceMap")
                    set old_kind: old_kind | 4
                if JsonText.member_bool(o, "declaration") or JsonText.member_bool(o, "composite")
                    set old_kind: old_kind | 24
                if JsonText.member_bool(o, "declarationMap")
                    set old_kind: old_kind | 32
                if JsonText.member_bool(o, "emitDeclarationOnly")
                    set old_kind: old_kind & 56
            }
            var pending IncOptions.pending_emit_kind(IncOptions.file_emit_kind(options), old_kind)
            if no_emit
                set pending: pending & 8
            return pending <> 0
        }
        false
    }

    ; GetBuildInfoRootInfoReader: the roots (resolved roots mapped back to their
    ; root through resolvedRoot) and, beside each, the resolved file, as absolute
    ; paths in the build info's order
    procedure build_info_roots(mutable this, info: ref[JsonValue], directory: Slice[char], mutable out_resolved: ref[Array[Slice[char]]]) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        let root info.get("root")
        if root = null
            return out
        let names info.get("fileNames")
        let rv root as ref[JsonValue]
        var i 0
        while i < rv.size()
        {
            let entry rv.value_at(i) as ref[JsonValue]
            set i: i + 1
            if entry.kind = JsonKindString
            {
                let path get_normalized_absolute_path(host, entry.text, directory)
                out.add(path)
                out_resolved.add(path)
                continue
            }
            if names = null
                continue
            var start 0
            var stop 0
            if entry.kind = JsonKindNumber
            {
                set start: JsonText.int_of(entry)
                set stop: start
            }
            else
            {
                set start: JsonText.int_of(entry.value_at(0))
                set stop: JsonText.int_of(entry.value_at(1))
            }
            var id start
            while id <= stop
            {
                let resolved this.build_info_file_path(info, id, directory)
                out.add(this.root_of_resolved(info, id, directory, resolved))
                out_resolved.add(resolved)
                set id: id + 1
            }
        }
        out
    }

    procedure build_info_file_path(mutable this, info: ref[JsonValue], id: int, directory: Slice[char]) returns Slice[char]
    {
        let names info.get("fileNames")
        if names = null
            return ""
        let nv names as ref[JsonValue]
        if (id < 1) or (id > nv.size())
            return ""
        let name (nv.value_at(id - 1) as ref[JsonValue]).text
        get_normalized_absolute_path(host, name, directory)
    }

    procedure root_of_resolved(mutable this, info: ref[JsonValue], id: int, directory: Slice[char], resolved: Slice[char]) returns Slice[char]
    {
        let pairs info.get("resolvedRoot")
        if pairs = null
            return resolved
        let pv pairs as ref[JsonValue]
        var i 0
        while i < pv.size()
        {
            let pair pv.value_at(i) as ref[JsonValue]
            if JsonText.int_of(pair.value_at(0)) = id
                return this.build_info_file_path(info, JsonText.int_of(pair.value_at(1)), directory)
            set i: i + 1
        }
        resolved
    }

    ; GetBuildInfoFileInfo's version for a root, the file it read through the cell
    procedure root_file_version(mutable this, info: ref[JsonValue], roots: ref[Array[Slice[char]]], resolved_roots: ref[Array[Slice[char]]], input_path: Slice[char], directory: Slice[char], mutable out_resolved: ref[Slice[char]]) returns Slice[char]
    {
        let infos info.get("fileInfos")
        if infos = null
            return ""
        var k 0
        while k < (roots.get_length() as int)
        {
            let root roots[k as size_t]
            let resolved resolved_roots[k as size_t]
            if root.equals(input_path) or resolved.equals(input_path)
            {
                set out_resolved.data: resolved.data
                set out_resolved.length: resolved.length
                let names info.get("fileNames") as ref[JsonValue]
                let iv infos as ref[JsonValue]
                var f 0
                while (f < names.size()) and (f < iv.size())
                {
                    if this.build_info_file_path(info, f + 1, directory).equals(resolved)
                    {
                        let file_info iv.value_at(f) as ref[JsonValue]
                        if file_info.kind = JsonKindString
                            return file_info.text
                        return file_info.string_of("version")
                    }
                    set f: f + 1
                }
                return ""
            }
            set k: k + 1
        }
        ""
    }

    ; reportUpToDateStatus
    procedure report_up_to_date_status(mutable this, mutable task: ref[BuildTask])
    {
        if verbose = false
            return
        let status task.status as ref[BuildStatus]
        let config this.relative_file_name(task.config)
        let kind status.kind
        if kind = UpToDateConfigFileNotFound
            this.task_status(task, DiagProject_0_is_out_of_date_because_config_file_does_not_exist, this.args1(config))
        if kind = UpToDateUpstreamErrors
        {
            if status.ref_has_upstream_errors
                this.task_status(task, DiagProject_0_can_t_be_built_because_its_dependency_1_was_not_built, this.args2(config, this.relative_file_name(status.name)))
            else
                this.task_status(task, DiagProject_0_can_t_be_built_because_its_dependency_1_has_errors, this.args2(config, this.relative_file_name(status.name)))
        }
        if kind = UpToDateBuildErrors
            this.task_status(task, DiagProject_0_is_out_of_date_because_it_has_errors, this.args1(config))
        if kind = UpToDateUpToDate
        {
            if status.has_times
                this.task_status(task, DiagProject_0_is_up_to_date_because_newest_input_1_is_older_than_output_2, this.args3(config, this.relative_file_name(status.input), this.relative_file_name(status.output)))
        }
        if kind = UpToDateWithUpstreamTypes
            this.task_status(task, DiagProject_0_is_up_to_date_with_d_ts_files_from_its_dependencies, this.args1(config))
        if kind = UpToDateWithInputFileText
            this.task_status(task, DiagProject_0_is_up_to_date_but_needs_to_update_timestamps_of_output_files_that_are_older_than_input_files, this.args1(config))
        if kind = UpToDateInputFileMissing
            this.task_status(task, DiagProject_0_is_out_of_date_because_input_1_does_not_exist, this.args2(config, this.relative_file_name(status.name)))
        if kind = UpToDateOutputMissing
            this.task_status(task, DiagProject_0_is_out_of_date_because_output_file_1_does_not_exist, this.args2(config, this.relative_file_name(status.name)))
        if kind = UpToDateInputFileNewer
            this.task_status(task, DiagProject_0_is_out_of_date_because_output_1_is_older_than_input_2, this.args3(config, this.relative_file_name(status.output), this.relative_file_name(status.input)))
        if kind = UpToDateOutOfDateBuildInfoWithPendingEmit
            this.task_status(task, DiagProject_0_is_out_of_date_because_buildinfo_file_1_indicates_that_some_of_the_changes_were_not_emitted, this.args2(config, this.relative_file_name(status.name)))
        if kind = UpToDateOutOfDateBuildInfoWithErrors
            this.task_status(task, DiagProject_0_is_out_of_date_because_buildinfo_file_1_indicates_that_program_needs_to_report_errors, this.args2(config, this.relative_file_name(status.name)))
        if kind = UpToDateOutOfDateOptions
            this.task_status(task, DiagProject_0_is_out_of_date_because_buildinfo_file_1_indicates_there_is_change_in_compilerOptions, this.args2(config, this.relative_file_name(status.name)))
        if kind = UpToDateOutOfDateRoots
            this.task_status(task, DiagProject_0_is_out_of_date_because_buildinfo_file_1_indicates_that_file_2_was_root_file_of_compilation_but_not_any_more, this.args3(config, this.relative_file_name(status.output), this.relative_file_name(status.input)))
        if kind = UpToDateTsVersionOutputOfDate
            this.task_status(task, DiagProject_0_is_out_of_date_because_output_for_it_was_generated_with_version_1_that_differs_with_current_version_2, this.args3(config, this.relative_file_name(status.name), "7.0.0-dev"))
        if kind = UpToDateForceBuild
            this.task_status(task, DiagProject_0_is_being_forcibly_rebuilt, this.args1(config))
    }

    ; ── watch mode (Orchestrator.Watch, DoCycle) ─────────────────────────────

    ; incremental.Program.PackageJsonLookupPaths: sorted, deduplicated, a found one
    ; through its realpath
    procedure package_json_lookup_paths(mutable this, mutable ip: ref[IncProgram]) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        if (ip.program.config_path.length as int) = 0
            return out
        let pfiles ip.program.pf
        var i 0
        while i < (pfiles.package_json_lookups.get_length() as int)
        {
            let path pfiles.package_json_lookups[i as size_t]
            let exists pfiles.package_json_found[i as size_t]
            set i: i + 1
            var package_json path
            if exists or pfiles.directory_exists(get_directory_path(host, path))
                set package_json: pfiles.real_path(path)
            if ExecSystem.contains(out, package_json) = false
                IncSort.insert_sorted(out, package_json)
        }
        out
    }

    ; BuildInfo.GetPackageJsons then GetMissingPackageJsons
    procedure build_info_package_jsons(mutable this, info: ref[JsonValue], directory: Slice[char]) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        this.add_build_info_paths(out, info, "packageJsons", directory)
        this.add_build_info_paths(out, info, "missingPackageJsons", directory)
        out
    }

    procedure add_build_info_paths(mutable this, mutable out: ref[Array[Slice[char]]], info: ref[JsonValue], field: Slice[char], directory: Slice[char])
    {
        let list info.get(field)
        if list = null
            return
        let lv list as ref[JsonValue]
        var i 0
        while i < lv.size()
        {
            let item lv.value_at(i) as ref[JsonValue]
            set i: i + 1
            out.add(get_normalized_absolute_path(host, item.text, directory))
        }
    }

    ; resolveBuildInfoFileName
    procedure resolve_build_info_file_name(mutable this, file_name: Slice[char], build_info_dir: Slice[char]) returns Slice[char]
    {
        if (path_is_relative(file_name) = false) and (is_rooted_disk_path(file_name) = false)
            return combine_paths(host, sys.default_library_path, file_name)
        get_normalized_absolute_path(host, file_name, build_info_dir)
    }

    ; the build info's file names, resolved
    procedure build_info_file_names(mutable this, task: ref[BuildTask]) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        if task.build_info_entry = null
            return out
        let entry task.build_info_entry as ref[BuildInfoEntry]
        if entry.info = null
            return out
        let info entry.info as ref[JsonValue]
        let names info.get("fileNames")
        if names = null
            return out
        let directory get_directory_path(host, entry.path)
        let nv names as ref[JsonValue]
        var i 0
        while i < nv.size()
        {
            let item nv.value_at(i) as ref[JsonValue]
            set i: i + 1
            out.add(this.resolve_build_info_file_name(item.text, directory))
        }
        out
    }

    ; updateWatch: a fresh modification-time cache keeping the outputs' times
    procedure update_watch(mutable this)
    {
        let old_cache mtimes
        set this.mtimes: IncSnapshot.int_map(host)
        var k 0
        while k < (order.get_length() as int)
        {
            let task tasks[order[k as size_t] as size_t]
            set k: k + 1
            if task.resolved = null
                continue
            if this.can_update_js_dts_output_timestamps(task) = false
                continue
            let outputs this.output_file_names(task)
            var o 0
            while o < (outputs.get_length() as int)
            {
                let output outputs[o as size_t]
                set o: o + 1
                let slot old_cache.slot_of(output)
                if slot >= 0
                    mtimes.store(output, old_cache.value_at(slot))
            }
        }
    }

    ; a map keyed by directory: added non-recursive unless covered (addWatchDir)
    procedure add_watch_dir(mutable this, mutable desired: ref[Array[WatchedDir]], dir: Slice[char])
    {
        if WatchManager.is_dir_covered_by_watch(sys, desired, dir)
            return
        if WatchManager.can_watch_directory(host, dir) = false
            return
        let at WatchManager.index_of_dir(desired, dir)
        if at >= 0
            desired.put(at as size_t, WatchedDir(dir, false))
        else
            desired.add(WatchedDir(dir, false))
    }

    ; addPackageJsonWatchDirs
    procedure add_package_json_watch_dirs(mutable this, mutable desired: ref[Array[WatchedDir]], package_json: Slice[char])
    {
        let dir get_directory_path(host, package_json)
        let dirs &Array[Slice[char]]^host()
        dirs.add(dir)
        var found_node_modules false
        var current dir
        repeat
        {
            let parent get_directory_path(host, current)
            if ((parent.length as int) = 0) or parent.equals(current)
                break
            dirs.add(parent)
            let base get_base_file_name(host, parent)
            if base.equals("node_modules")
            {
                set found_node_modules: true
                let grandparent get_directory_path(host, parent)
                if ((grandparent.length as int) > 0) and (grandparent.equals(parent) = false)
                    dirs.add(grandparent)
                break
            }
            set current: parent
        }
        if found_node_modules = false
        {
            this.add_watch_dir(desired, dir)
            return
        }
        var i 0
        while i < (dirs.get_length() as int)
        {
            this.add_watch_dir(desired, dirs[i as size_t])
            set i: i + 1
        }
    }

    ; computeDesiredWatches
    procedure compute_desired_watches(mutable this) returns ref[Array[WatchedDir]]
    {
        let desired &Array[WatchedDir]^host()
        let pf Watcher.system_files(sys)
        var k 0
        while k < (order.get_length() as int)
        {
            let task tasks[order[k as size_t] as size_t]
            set k: k + 1
            let real_config_dir pf.real_path(get_directory_path(host, task.config))
            if WatchManager.index_of_dir(desired, real_config_dir) < 0
                desired.add(WatchedDir(real_config_dir, false))
            if task.resolved = null
                continue
            let resolved task.resolved as ref[TsParsedCommandLine]
            var e 0
            while e < (resolved.extended_files.get_length() as int)
            {
                let dir get_directory_path(host, pf.real_path(resolved.extended_files[e as size_t]))
                set e: e + 1
                if WatchManager.index_of_dir(desired, dir) < 0
                    desired.add(WatchedDir(dir, false))
            }
            let wildcards Watcher.wildcard_directories_of(sys, resolved)
            var w 0
            while w < (wildcards.get_length() as int)
            {
                let wd wildcards[w as size_t]
                set w: w + 1
                let real_dir pf.real_path(wd.dir)
                let at WatchManager.index_of_dir(desired, real_dir)
                if at >= 0
                {
                    let existing desired[at as size_t]
                    desired.put(at as size_t, WatchedDir(real_dir, existing.recursive or wd.recursive))
                }
                else
                    desired.add(WatchedDir(real_dir, wd.recursive))
            }
            var f 0
            while f < (resolved.file_names.get_length() as int)
            {
                let absolute get_normalized_absolute_path(host, resolved.file_names[f as size_t], sys.cwd)
                set f: f + 1
                this.add_watch_dir(desired, get_directory_path(host, absolute))
            }
            if task.build_info_entry <> null
            {
                let entry task.build_info_entry as ref[BuildInfoEntry]
                if entry.info <> null
                {
                    let roots &Array[Slice[char]]^host()
                    var r 0
                    while r < (resolved.file_names.get_length() as int)
                    {
                        roots.add(Watcher.to_path_of(sys, resolved.file_names[r as size_t]))
                        set r: r + 1
                    }
                    let names this.build_info_file_names(task)
                    var n 0
                    while n < (names.get_length() as int)
                    {
                        let absolute pf.real_path(names[n as size_t])
                        set n: n + 1
                        if ExecSystem.contains(roots, Watcher.to_path_of(sys, absolute))
                            continue
                        this.add_watch_dir(desired, get_directory_path(host, absolute))
                    }
                    let lookups this.build_info_package_jsons(entry.info as ref[JsonValue], get_directory_path(host, entry.path))
                    var l 0
                    while l < (lookups.get_length() as int)
                    {
                        this.add_package_json_watch_dirs(desired, lookups[l as size_t])
                        set l: l + 1
                    }
                }
            }
            var p 0
            while p < (task.package_jsons.get_length() as int)
            {
                this.add_package_json_watch_dirs(desired, task.package_jsons[p as size_t])
                set p: p + 1
            }
        }
        wm.resolve_desired_dirs(desired)
    }

    ; Orchestrator.DoCycle; false after a stop
    procedure do_cycle(mutable this) returns bool io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables
    {
        let deleted wm.changed_deleted
        let changed_paths wm.drain_events()
        if changed_paths.get_length() = 0
            return true
        var needs_config_update false
        var needs_update false
        this.check_tasks_for_event_changes(changed_paths, deleted, &needs_config_update, &needs_update)
        if needs_update = false
            return true
        WatchManager.write_watch_status(sys, cl.options, DiagFile_change_detected_Starting_incremental_compilation, null)
        if needs_config_update
        {
            ; GenerateGraphReusingOldTasks
            let old_tasks tasks
            set this.tasks: &Array[ref[BuildTask]]^host()
            set this.order: &Array[int]^host()
            set this.graph_errors: &Array[ref[DriverDiagnostic]]^host()
            if this.generate_graph(old_tasks) = false
                return false
        }
        this.build_or_clean()
        if (sys.stop_tag.length as int) > 0
            return false
        this.update_watch()
        wm.reconcile_watches(this.compute_desired_watches())
        true
    }

    ; packageJsonLookupChanged
    procedure package_json_lookup_changed(mutable this, package_json: Slice[char], normalized: ref[Array[Slice[char]]], deleted: ref[Array[bool]]) returns bool
    {
        let package_json_path Watcher.to_path_of(sys, package_json)
        if ExecSystem.contains(normalized, package_json_path)
            return true
        var i 0
        while i < (normalized.get_length() as int)
        {
            let changed normalized[i as size_t]
            let is_deleted deleted[i as size_t]
            set i: i + 1
            if is_deleted
            {
                if WatchManager.contains_path(sys, changed, package_json_path)
                    return true
            }
        }
        false
    }

    ; checkTasksForEventChanges
    procedure check_tasks_for_event_changes(mutable this, changed_paths: ref[Array[Slice[char]]], deleted: ref[Array[bool]], mutable needs_config_update: ref[bool], mutable needs_update: ref[bool])
    {
        let normalized &Array[Slice[char]]^host()
        var c 0
        while c < (changed_paths.get_length() as int)
        {
            normalized.add(Watcher.to_path_of(sys, changed_paths[c as size_t]))
            set c: c + 1
        }
        var k 0
        while k < (order.get_length() as int)
        {
            let task tasks[order[k as size_t] as size_t]
            set k: k + 1
            if ExecSystem.contains(normalized, Watcher.to_path_of(sys, task.config))
            {
                this.reset_config(task)
                set needs_config_update: true
                set needs_update: true
                continue
            }
            if task.resolved = null
                continue
            let resolved task.resolved as ref[TsParsedCommandLine]
            var config_changed false
            var e 0
            while e < (resolved.extended_files.get_length() as int)
            {
                let extended resolved.extended_files[e as size_t]
                set e: e + 1
                if ExecSystem.contains(normalized, Watcher.to_path_of(sys, extended))
                {
                    this.reset_config(task)
                    set needs_config_update: true
                    set needs_update: true
                    set config_changed: true
                    break
                }
            }
            if config_changed
                continue
            var root_changed false
            let roots &Array[Slice[char]]^host()
            var f 0
            while f < (resolved.file_names.get_length() as int)
            {
                let fp Watcher.to_path_of(sys, resolved.file_names[f as size_t])
                set f: f + 1
                roots.add(fp)
                if root_changed = false
                {
                    if ExecSystem.contains(normalized, fp)
                    {
                        this.reset_status(task)
                        set needs_update: true
                        set root_changed: true
                    }
                }
            }
            if root_changed = false
            {
                if task.build_info_entry <> null
                {
                    let entry task.build_info_entry as ref[BuildInfoEntry]
                    if entry.info <> null
                    {
                        let names this.build_info_file_names(task)
                        var n 0
                        while n < (names.get_length() as int)
                        {
                            let fp Watcher.to_path_of(sys, names[n as size_t])
                            set n: n + 1
                            if ExecSystem.contains(roots, fp)
                                continue
                            if ExecSystem.contains(normalized, fp)
                            {
                                this.reset_status(task)
                                set needs_update: true
                                break
                            }
                        }
                        let directory get_directory_path(host, entry.path)
                        let info entry.info as ref[JsonValue]
                        let found &Array[Slice[char]]^host()
                        this.add_build_info_paths(found, info, "packageJsons", directory)
                        var p 0
                        while p < (found.get_length() as int)
                        {
                            if this.package_json_lookup_changed(found[p as size_t], normalized, deleted)
                            {
                                this.reset_status(task)
                                set needs_update: true
                                break
                            }
                            set p: p + 1
                        }
                        let missing &Array[Slice[char]]^host()
                        this.add_build_info_paths(missing, info, "missingPackageJsons", directory)
                        var m 0
                        while m < (missing.get_length() as int)
                        {
                            if this.package_json_lookup_changed(missing[m as size_t], normalized, deleted)
                            {
                                this.reset_status(task)
                                set needs_update: true
                                break
                            }
                            set m: m + 1
                        }
                    }
                }
                var j 0
                while j < (task.package_jsons.get_length() as int)
                {
                    if this.package_json_lookup_changed(task.package_jsons[j as size_t], normalized, deleted)
                    {
                        this.reset_status(task)
                        set needs_update: true
                        break
                    }
                    set j: j + 1
                }
            }
            ; ReloadFileNamesOfParsedCommandLine
            let tp TsConfigParser.create(host, Watcher.system_files(sys), sys.cwd)
            let names_now tp.get_file_names_from_config_specs(resolved.files_specs, resolved.include_specs, resolved.exclude_specs, resolved.base_path, resolved.options)
            if Orchestrator.same_names(resolved.file_names, names_now) = false
            {
                let reloaded &TsParsedCommandLine^host(resolved.options, names_now, resolved.references, resolved.reference_ranges, resolved.files_specs, resolved.files_specs_raw, resolved.include_specs, resolved.include_specs_raw, resolved.is_default_include, resolved.base_path, resolved.exclude_specs, resolved.compile_on_save, resolved.extended_files)
                this.store_reloaded(task, reloaded)
                set task.resolved: reloaded
                this.reset_status(task)
                set needs_update: true
            }
        }
        if needs_update = false
        {
            var i 0
            while i < (changed_paths.get_length() as int)
            {
                let event_path changed_paths[i as size_t]
                set i: i + 1
                if sys.directory_exists(event_path) = false
                    continue
                if wm.is_path_under_watch(event_path) = false
                    continue
                var t 0
                while t < (order.get_length() as int)
                {
                    this.reset_status(tasks[order[t as size_t] as size_t])
                    set t: t + 1
                }
                set needs_update: true
                break
            }
        }
    }

    function same_names(a: ref[Array[Slice[char]]], b: ref[Array[Slice[char]]]) returns bool
    {
        if a.get_length() <> b.get_length()
            return false
        var i 0
        while i < (a.get_length() as int)
        {
            let x a[i as size_t]
            let y b[i as size_t]
            if x.equals(y) = false
                return false
            set i: i + 1
        }
        true
    }

    ; host.resolvedReferences.store: the reloaded config replaces the cached one
    procedure store_reloaded(mutable this, task: ref[BuildTask], reloaded: ref[TsParsedCommandLine])
    {
        var i 0
        while i < (resolved_references.get_length() as int)
        {
            let known resolved_references[i as size_t]
            if known.config.equals(task.config)
            {
                resolved_references.put(i as size_t, &ResolvedReference^host(known.config, reloaded, known.text, known.diagnostics, &Array[int]^host()))
                return
            }
            set i: i + 1
        }
    }

    ; ── BuildTask.cleanProject ───────────────────────────────────────────────

    procedure clean_project(mutable this, mutable task: ref[BuildTask])
    {
        if task.resolved = null
        {
            let none: Slice[char] ""
            this.report_task_diagnostic(task, &DriverDiagnostic^host(none, none, 0, 0, DiagFile_0_not_found, this.args1(task.config), null, null))
            set task.exit_status: ExitStatusDiagnosticsPresent_OutputsSkipped
            return
        }
        let resolved task.resolved as ref[TsParsedCommandLine]
        let inputs &Array[Slice[char]]^host()
        var i 0
        while i < (resolved.file_names.get_length() as int)
        {
            inputs.add(get_normalized_absolute_path(host, resolved.file_names[i as size_t], sys.cwd))
            set i: i + 1
        }
        let outputs this.output_file_names(task)
        var o 0
        while o < (outputs.get_length() as int)
        {
            this.clean_project_output(task, outputs[o as size_t], inputs)
            set o: o + 1
        }
        this.clean_project_output(task, IncProgram.build_info_file_name_of(host, resolved.options, task.config, sys.cwd), inputs)
    }

    procedure clean_project_output(mutable this, mutable task: ref[BuildTask], output_file: Slice[char], inputs: ref[Array[Slice[char]]])
    {
        if ExecSystem.contains(inputs, output_file)
            return
        if sys.file_exists(output_file)
        {
            if dry = false
                sys.remove_file(output_file)
            else
                task.files_to_delete.add(output_file)
        }
    }
}
