; SPDX-License-Identifier: Apache-2.0
;
; ModifierFlags — one bit per modifier keyword, ported from the reference's
; internal/ast/modifierflags.go.
;
; Hand-ported for the reasons NodeFlags.scaly gives: upstream writes that file by
; hand, it is short, and its composites read better spelled out than derived. The
; composites stay SYMBOLIC — a module-level `define` initializer folds constant
; identifiers as well as literals — so a changed bit position cannot leave a
; stale composite behind.
;
; ★ WHAT IS HERE AND WHY, because a table nothing reads is a table nobody checks
; (the rule tools/gendiagnostics.py is built on): slice 24 needs exactly one
; question answered — `ModifierToFlag(kind) & ModifierFlagsJavaScript == 0`, the
; test checkJSSyntax applies to every modifier on a declaration in a JavaScript
; file. The individual bits and that one composite are what the question is made
; of. The reference's remaining composites are the BINDER's and the CHECKER's and
; are not carried; a later slice that needs one adds it with its reason, which is
; a one-line edit.
;
; ★ It is NOT narrowed to the five kinds the composite names, although that would
; answer the same question over the same inputs. `ModifierToFlag` is a reference
; FUNCTION with a reference NAME, the next reader of a JS-syntax arm will look for
; it, and the equivalence argument §3.5ag admits is worth making only where the
; port would otherwise have to carry machinery it cannot use — a fifteen-arm
; lookup is not that.
;
; Upstream declares this uint32. Here it is int (i64); nothing compares the type,
; and the bit POSITIONS are exact.

define ModifierFlagsNone:      int 0

; Syntactic/JSDoc modifiers.
define ModifierFlagsPublic:    int 1 << 0   ; property/method
define ModifierFlagsPrivate:   int 1 << 1   ; property/method
define ModifierFlagsProtected: int 1 << 2   ; property/method
define ModifierFlagsReadonly:  int 1 << 3   ; property/method
define ModifierFlagsOverride:  int 1 << 4   ; override method

; Syntactic-only modifiers.
define ModifierFlagsExport:    int 1 << 5   ; declarations
define ModifierFlagsAbstract:  int 1 << 6   ; class/method/construct signature
define ModifierFlagsAmbient:   int 1 << 7   ; declarations (the `declare` keyword)
define ModifierFlagsStatic:    int 1 << 8   ; property/method
define ModifierFlagsAccessor:  int 1 << 9   ; property
define ModifierFlagsAsync:     int 1 << 10  ; property/method/function
define ModifierFlagsDefault:   int 1 << 11  ; function/class (export default)
define ModifierFlagsConst:     int 1 << 12  ; const enum
define ModifierFlagsIn:        int 1 << 13  ; contravariance modifier
define ModifierFlagsOut:       int 1 << 14  ; covariance modifier
define ModifierFlagsDecorator: int 1 << 15  ; contains a decorator

; ★ The set a JavaScript file may carry. Everything else — `public`, `readonly`,
; `abstract`, `declare`, `const` on an enum, `in`/`out` — is TypeScript-only and
; is what checkJSSyntax reports at the modifier's own range.
define ModifierFlagsJavaScript: int ModifierFlagsExport | ModifierFlagsStatic | ModifierFlagsAccessor | ModifierFlagsAsync | ModifierFlagsDefault

; ── slice 49: the JSDoc-only bit and the four composites checkGrammarModifiers
;    is written in terms of ─────────────────────────────────────────────────
;
; ★ `Deprecated` is carried although nothing SETS it here, because it is a member
; of ModifierFlagsAll and therefore of ModifierFlagsModifier, and a composite that
; silently omits a member is the class this file's header warns about. Its only
; writer upstream is the JSDoc modifier cache, which this port does not compute —
; so the bit is always clear and the composites below are exact either way. The
; five cache-only JSDoc bits (23..27) and the two computed-flag bits (28, 29) are
; NOT carried: they are not members of ModifierFlagsAll.
define ModifierFlagsDeprecated: int 1 << 16  ; @deprecated tag (JSDoc-only)

define ModifierFlagsAccessibilityModifier: int ModifierFlagsPublic | ModifierFlagsPrivate | ModifierFlagsProtected

; The reference's comment: *accessibility modifiers and `readonly` can be attached
; to a parameter in a constructor to make it a property* — and `override` with
; them.
define ModifierFlagsParameterPropertyModifier: int ModifierFlagsAccessibilityModifier | ModifierFlagsReadonly | ModifierFlagsOverride

define ModifierFlagsExportDefault: int ModifierFlagsExport | ModifierFlagsDefault

define ModifierFlagsAll: int ModifierFlagsExport | ModifierFlagsAmbient | ModifierFlagsPublic | ModifierFlagsPrivate | ModifierFlagsProtected | ModifierFlagsStatic | ModifierFlagsReadonly | ModifierFlagsAbstract | ModifierFlagsAccessor | ModifierFlagsAsync | ModifierFlagsDefault | ModifierFlagsConst | ModifierFlagsDeprecated | ModifierFlagsOverride | ModifierFlagsIn | ModifierFlagsOut | ModifierFlagsDecorator

; ★ Upstream writes this `ModifierFlagsAll & ^ModifierFlagsDecorator`. It is
; SPELLED OUT here rather than derived, and the reason is the language rather than
; taste: a module-level constant initializer folds only when every operator sits
; on ONE precedence level (root CLAUDE.md, *Module-level globals*), so mixing `&`
; with a complement is a hard rc-4 diagnostic and not a silently wrong value. The
; list is therefore ModifierFlagsAll's, minus Decorator, in the same order — which
; is what makes the omission checkable by eye against the line above.
define ModifierFlagsModifier: int ModifierFlagsExport | ModifierFlagsAmbient | ModifierFlagsPublic | ModifierFlagsPrivate | ModifierFlagsProtected | ModifierFlagsStatic | ModifierFlagsReadonly | ModifierFlagsAbstract | ModifierFlagsAccessor | ModifierFlagsAsync | ModifierFlagsDefault | ModifierFlagsConst | ModifierFlagsDeprecated | ModifierFlagsOverride | ModifierFlagsIn | ModifierFlagsOut
