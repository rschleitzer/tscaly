    source_map: bool
    inline_source_map: bool
    inline_sources: bool
    omit_brace_source_map_positions: bool
    only_print_jsdoc_style: bool
    never_ascii_escape: bool
    preserve_source_newlines: bool
    terminate_unterminated_literals: bool
)
{
    function defaults() returns PrinterOptions
        PrinterOptions(false, NewLineKindNone, false, ScriptTargetNone, false, false, false, false, false, false, false, false)

    ; core.NewLineKind.GetNewLineCharacter
    function new_line_character(this) returns Slice[char]
    {
        if new_line = NewLineKindCRLF
            return "\r\n"
        "\n"
    }
}

; The five things the printer reads off `*ast.SourceFile` (§3.40), plus the
; parser's identifier table, which the emitter fills from the tree.
define SourceFileInfo
(
    node: ref[AstNode]
    file_name: Slice[char]
    text: Slice[char]
    line_starts: ref[Array[int]]
    is_declaration_file: bool
    script_kind: int
    identifiers: ref[Array[Slice[char]]]?
)
{
    ; `sourceFile.Identifiers[name]`
    function has_identifier(this, name: Slice[char]) returns bool
    {
        if identifiers = null
            return false
        NameGenerator.names_contain(identifiers as ref[Array[Slice[char]]], name)
    }
}

; STOP (sourcemap chapter): the generator's three entry points count their
; calls and write nothing. The printer never reaches them without a generator,
; and the JS-only yardstick never hands it one.
define SourceMapGenerator
(
    host: ref[Page]
    unported_calls: int
)
{
    function create(host: ref[Page]) returns ref[SourceMapGenerator]
        &SourceMapGenerator^host(host, 0)

    procedure add_source(this, file_name: Slice[char]) returns int
    {
        set unported_calls: unported_calls + 1
        0
    }

    procedure set_source_content(this, index: int, text: Slice[char])
        set unported_calls: unported_calls + 1

    procedure add_source_mapping(this, generated_line: int, generated_character: int, source_index: int, source_line: int, source_character: int)
        set unported_calls: unported_calls + 1
}

define DetachedCommentsInfo
(
    node_pos: int
    detached_comment_end_pos: int
)

; commentState — by VALUE with a presence bit (the reference hands out arena
; pointers and nil for "no state").
define CommentState
(
    present: bool
    emit_flags: int
    comment_range: TextRange
    container_pos: int
    container_end: int
    declaration_list_container_end: int
)
{
    function none() returns CommentState
        CommentState(false, 0, TextRange.undefined_range(), 0 - 1, 0 - 1, 0 - 1)

    function blank() returns CommentState
        CommentState(true, 0, TextRange.undefined_range(), 0 - 1, 0 - 1, 0 - 1)
}

define SourceMapState
(
    present: bool
    emit_flags: int
    source_map_range: TextRange
    has_token_source_map_range: bool
)
{
    function none() returns SourceMapState
        SourceMapState(false, 0, TextRange.undefined_range(), false)
}

define PrinterState
(
    comment: CommentState
    source_map: SourceMapState
)
{
    function none() returns PrinterState
        PrinterState(CommentState.none(), SourceMapState.none())
}

; uniqueHelperNames: name → identifier node
define NameNode
(
    name: Slice[char]
    node: ref[AstNode]
)

; IdToSymbol: identifier node → symbol
define NodeSymbol
(
    node: ref[AstNode]
    symbol: ref[Symbol]
)

define Printer
(
    host: ref[Page]
    options: PrinterOptions
    handlers_tag: int
    has_global_name_tag: int
    context: ref[EmitContext]
    current_source_file: ref[SourceFileInfo]?
    unique_helper_names: ref[Array[NameNode]]?
    external_helpers_module_name: ref[AstNode]?
    next_list_element_pos: int
    writer: ref[TextWriter]?
    own_writer: ref[TextWriter]?
    write_kind: int
    source_maps_disabled: bool
    source_map_generator: ref[SourceMapGenerator]?
    source_map_source: ref[SourceFileInfo]?
    source_map_source_index: int
    source_map_source_is_json: bool
    source_map_line_char_cache: ref[LineCharacterCache]?
    most_recent_source_map_source: ref[SourceFileInfo]?
    most_recent_source_map_source_index: int
    container_pos: int
    container_end: int
    declaration_list_container_end: int
    detached_comments_info: ref[Array[DetachedCommentsInfo]]
    detached_depth: int
    comments_disabled: bool
    in_extends: bool
    name_generator: ref[NameGenerator]
    id_to_symbol: ref[Array[NodeSymbol]]?
    unported_count: int
    unported_tag: Slice[char]
    unported_detail: int
)
{
    function slice_of(s: String) returns Slice[char]
        Slice[char](s.get_length() as int, s.get_buffer() as pointer[char])

    procedure append_hex_upper(b: ref[StringBuilder], value: int)
    {
        var digits u8[16]
        var n 0
        var v value
        if v = 0
        {
            b.append("0" as char)
            return
        }
        while v > 0
        {
            set digits[n]: (v & 15) as u8
            set v: v >> 4
            set n: n + 1
        }
        while n > 0
        {
            set n: n - 1
            let d digits[n] as int
            if d < 10
                b.append((48 + d) as char)
            else
                b.append((55 + d) as char)
        }
    }

    procedure encode_jsx_character_entity(b: ref[StringBuilder], char_code: int)
    {
        b.append("&#x")
        Printer.append_hex_upper(b, char_code)
        b.append(";" as char)
    }

    procedure encode_utf16_escape_sequence(b: ref[StringBuilder], char_code: int)
    {
        b.append("\\u")
        var width 0
        var v char_code
        while v > 0
        {
            set width: width + 1
            set v: v >> 4
        }
        if width = 0
            set width: 1
        while width < 4
        {
            b.append("0" as char)
            set width: width + 1
        }
        Printer.append_hex_upper(b, char_code)
    }

    ; stringutil.DecodeJSStringRune's size: this port's texts are WTF-8, where a
    ; lone surrogate is a three-byte sequence utf8_decode_in already yields as its
    ; code point, so the scanner's decoder is the JS-string decoder.
    procedure append_escaped_rune(b: ref[StringBuilder], ch: int, quote_char: int, flags: int, s: Slice[char], i: int, size: int, out_size: ref[int])
    {
        set out_size: size
        let n s.length as int
        if (flags & LiteralTextFlagsJsxAttributeEscape) <> 0
        {
            if ch = 0
            {
                b.append("&#0;")
                return
            }
            if ch = 34
            {
                b.append("&quot;")
                return
            }
            if ch = 39
            {
                b.append("&apos;")
                return
            }
            Printer.encode_jsx_character_entity(b, ch)
            return
        }
        if ch = 13
        {
            if quote_char = QuoteCharBacktick
            {
                if i + 1 < n
                {
                    if ((s[(i + 1) as size_t] as int) & 255) = 10
                    {
                        set out_size: size + 1
                        b.append("\\r\\n")
                        return
                    }
                }
            }
        }
        if ch > 0xFFFF
        {
            let c ch - 0x10000
            Printer.encode_utf16_escape_sequence(b, ((c & 0xFFC00) >> 10) + 0xD800)
            Printer.encode_utf16_escape_sequence(b, (c & 0x3FF) + 0xDC00)
            return
        }
        if (ch >= 0xD800) and (ch <= 0xDFFF)
        {
            Printer.encode_utf16_escape_sequence(b, ch)
            return
        }
        if ch = 0
        {
            var digit_follows false
            if i + 1 < n
            {
                if Scanner.is_digit((s[(i + 1) as size_t] as int) & 255)
                    set digit_follows: true
            }
            if digit_follows
                b.append("\\x00")
            else
                b.append("\\0")
            return
        }
        if ch = 9
        {
            b.append("\\t")
            return
        }
        if ch = 11
        {
            b.append("\\v")
            return
        }
        if ch = 12
        {
            b.append("\\f")
            return
        }
        if ch = 8
        {
            b.append("\\b")
            return
        }
        if ch = 13
        {
            b.append("\\r")
            return
        }
        if ch = 10
        {
            b.append("\\n")
            return
        }
        if ch = 92
        {
            b.append("\\\\")
            return
        }
        if ch = 34
        {
            b.append("\\\"")
            return
        }
        if ch = 39
        {
            b.append("\\'")
            return
        }
        if ch = 96
        {
            b.append("\\\`")
            return
        }
        if ch = 36
        {
            b.append("\\$")
            return
        }
        if ch = 0x2028
        {
            b.append("\\u2028")
            return
        }
        if ch = 0x2029
        {
            b.append("\\u2029")
            return
        }
        if ch = 0x85
        {
            b.append("\\u0085")
            return
        }
        Printer.encode_utf16_escape_sequence(b, ch)
    }

    ; escapeStringWorker — ECMA-262's Quote, augmented; does not add the quotes.
    procedure escape_string_worker(s: Slice[char], quote_char: int, flags: int, b: ref[StringBuilder])
    {
        let n s.length as int
        var pos 0
        var i 0
        while i < n
        {
            let ch Scanner.utf8_decode_in(s, n, i)
            var size Scanner.utf8_size_in(s, n, i)
            var escape false
            if (ch >= 0xD800) and (ch <= 0xDFFF)
                set escape: true
            if ch = 0xFFFD
            {
                if size = 1
                    set escape: true
            }
            if ch = 92
            {
                if (flags & LiteralTextFlagsJsxAttributeEscape) = 0
                    set escape: true
            }
            else
            {
                if ch = 36
                {
                    if quote_char = QuoteCharBacktick
                    {
                        if i + 1 < n
                        {
                            if ((s[(i + 1) as size_t] as int) & 255) = ("{" as char) as int
                                set escape: true
                        }
                    }
                }
                else
                {
                    var listed false
                    if (ch = quote_char) or (ch = 0x2028) or (ch = 0x2029) or (ch = 0x85) or (ch = 13)
                        set listed: true
                    if listed
                        set escape: true
                    else
                    {
                        if ch = 10
                        {
                            if quote_char <> QuoteCharBacktick
                                set escape: true
                        }
                        else
                        {
                            if ch <= 0x1F
                                set escape: true
                            if (flags & LiteralTextFlagsNeverAsciiEscape) = 0
                            {
                                if ch > 0x7F
                                    set escape: true
                            }
                        }
                    }
                }
            }
            if escape
            {
                if pos < i
                {
                    let run s.subslice(pos as size_t, i as size_t)
                    b.append(run.data, run.length)
                }
                var used size
                Printer.append_escaped_rune(b, ch, quote_char, flags, s, i, size, &used)
                set size: used
                set pos: i + size
            }
            set i: i + size
        }
        if pos < i
        {
            let tail s.slice_from(pos as size_t)
            b.append(tail.data, tail.length)
        }
    }

    function escape_string(host: ref[Page], s: Slice[char], quote_char: int) returns String
    {
        let b StringBuilder^host()
        Printer.escape_string_worker(s, quote_char, LiteralTextFlagsNeverAsciiEscape, &b)
        b.to_string()
    }

    function escape_non_ascii_string(host: ref[Page], s: Slice[char], quote_char: int) returns String
    {
        let b StringBuilder^host()
        Printer.escape_string_worker(s, quote_char, LiteralTextFlagsNone, &b)
        b.to_string()
    }

    function escape_jsx_attribute_string(host: ref[Page], s: Slice[char], quote_char: int) returns String
    {
        let b StringBuilder^host()
        Printer.escape_string_worker(s, quote_char, LiteralTextFlagsJsxAttributeEscape | LiteralTextFlagsNeverAsciiEscape, &b)
        b.to_string()
    }

    ; canUseOriginalText: a synthesized node, a parentless node and (when asked to
    ; terminate) an unterminated literal have no usable source text; a numeric
    ; literal's invalid or separator-bearing text neither.
    function can_use_original_text(node: ref[AstNode], flags: int) returns bool
    {
        if AstNode.pos_of(node) < 0
            return false
        if AstNode.parent_node_of(node) = null
            return false
        if (flags & LiteralTextFlagsTerminateUnterminatedLiterals) <> 0
        {
            if AstNode.is_unterminated_literal(node)
                return false
        }
        let kind AstNode.kind_of(node)
        if kind = KindNumericLiteral
        {
            let token_flags AstNode.numeric_token_flags_of(node)
            if (token_flags & TokenFlagsIsInvalid) <> 0
                return false
            if (token_flags & TokenFlagsContainsSeparator) <> 0
                return (flags & LiteralTextFlagsAllowNumericSeparator) <> 0
        }
        kind <> KindBigIntLiteral
    }

    ; scanner.GetTextOfNodeFromSourceText (scanner/utilities.go), placed here
    ; because the scanner module is declared before ast and cannot name a node.
    function get_text_of_node_from_source_text(host: ref[Page], source_text: Slice[char], node: ref[AstNode], include_trivia: bool) returns Slice[char]
    {
        if Binder.node_is_missing(node)
            return ""
        var pos AstNode.pos_of(node)
        if include_trivia = false
            set pos: Scanner.skip_trivia(source_text, pos)
        let text source_text.subslice(pos as size_t, AstNode.end_of(node) as size_t)
        if (AstNode.flags_of(node) & NodeFlagsReparserTransformedLiteral) <> 0
        {
            let kind AstNode.kind_of(node)
            if kind = KindStringLiteral
            {
                let b StringBuilder^host()
                var q QuoteCharDoubleQuote
                if (AstNode.string_token_flags_of(node) & TokenFlagsSingleQuote) <> 0
                    set q: QuoteCharSingleQuote
                b.append(q as char)
                b.append(text.data, text.length)
                b.append(q as char)
                return Printer.slice_of(b.to_string())
            }
            if kind = KindIdentifier
                return AstNode.identifier_text_of(node)
        }
        text
    }

    ; getLiteralText. `has_source` stands for the reference's non-nil sourceFile:
    ; with it and a usable original, the text between the node's trimmed start and
    ; its end; without, the canonical form — a quoted, escaped string, a template
    ; part in its delimiters, a number's own text.
    ; ★ The template arm's `rawText` is a field this port's template nodes do not
    ; carry (their LiteralData is the cooked text and the token flags); every
    ; template node the parser makes has original text, and a SYNTHESIZED one is
    ; a transformer's — recorded for that chapter. Here the cooked text is
    ; escaped as the reference does when rawText is empty.
    function get_literal_text(host: ref[Page], node: ref[AstNode], source_text: Slice[char], has_source: bool, flags: int) returns Slice[char]
    {
        if has_source
        {
            if Printer.can_use_original_text(node, flags)
                return Printer.get_text_of_node_from_source_text(host, source_text, node, false)
        }
        let kind AstNode.kind_of(node)
        if kind = KindStringLiteral
        {
            let b StringBuilder^host()
            var q QuoteCharDoubleQuote
            if (AstNode.string_token_flags_of(node) & TokenFlagsSingleQuote) <> 0
                set q: QuoteCharSingleQuote
            b.append(q as char)
            Printer.escape_string_worker(AstNode.literal_text_of(node), q, flags, &b)
            b.append(q as char)
            return Printer.slice_of(b.to_string())
        }
        var template false
        if (kind = KindNoSubstitutionTemplateLiteral) or (kind = KindTemplateHead)
            set template: true
        if (kind = KindTemplateMiddle) or (kind = KindTemplateTail)
            set template: true
        if template
        {
            let b StringBuilder^host()
            if (kind = KindNoSubstitutionTemplateLiteral) or (kind = KindTemplateHead)
                b.append(96 as char)
            else
                b.append("}" as char)
            Printer.escape_string_worker(AstNode.literal_text_of(node), QuoteCharBacktick, flags, &b)
            if (kind = KindNoSubstitutionTemplateLiteral) or (kind = KindTemplateTail)
                b.append(96 as char)
            else
                b.append("${")
            return Printer.slice_of(b.to_string())
        }
        if (kind = KindNumericLiteral) or (kind = KindBigIntLiteral)
            return AstNode.literal_text_of(node)
        if kind = KindRegularExpressionLiteral
        {
            if (flags & LiteralTextFlagsTerminateUnterminatedLiterals) <> 0
            {
                if AstNode.is_unterminated_literal(node)
                {
                    let text AstNode.literal_text_of(node)
                    let b StringBuilder^host()
                    b.append(text.data, text.length)
                    var ends_in_backslash false
                    if (text.length as int) > 0
                    {
                        if ((text[(text.length as int - 1) as size_t] as int) & 255) = 92
                            set ends_in_backslash: true
                    }
                    if ends_in_backslash
                        b.append(" /")
                    else
                        b.append("/")
                    return Printer.slice_of(b.to_string())
                }
            }
            return AstNode.literal_text_of(node)
        }
        ""
    }

    ; ── the line helpers, over a source text and its ECMA line map ──

    function range_is_on_single_line(r: TextRange, text: Slice[char], line_starts: ref[Array[int]]) returns bool
        Printer.range_start_is_on_same_line_as_range_end(r, r, text, line_starts)

    function range_start_positions_are_on_same_line(r1: TextRange, r2: TextRange, text: Slice[char], line_starts: ref[Array[int]]) returns bool
        Printer.positions_are_on_same_line(Printer.get_start_position_of_range(r1, text, false), Printer.get_start_position_of_range(r2, text, false), line_starts)

    function range_end_positions_are_on_same_line(r1: TextRange, r2: TextRange, line_starts: ref[Array[int]]) returns bool
        Printer.positions_are_on_same_line(r1.end, r2.end, line_starts)

    function range_start_is_on_same_line_as_range_end(r1: TextRange, r2: TextRange, text: Slice[char], line_starts: ref[Array[int]]) returns bool
        Printer.positions_are_on_same_line(Printer.get_start_position_of_range(r1, text, false), r2.end, line_starts)

    function range_end_is_on_same_line_as_range_start(r1: TextRange, r2: TextRange, text: Slice[char], line_starts: ref[Array[int]]) returns bool
        Printer.positions_are_on_same_line(r1.end, Printer.get_start_position_of_range(r2, text, false), line_starts)

    function get_start_position_of_range(r: TextRange, text: Slice[char], include_comments: bool) returns int
    {
        if r.pos < 0
            return 0 - 1
        Scanner.skip_trivia_ex(text, r.pos, false, include_comments, false)
    }

    function positions_are_on_same_line(pos1: int, pos2: int, line_starts: ref[Array[int]]) returns bool
        Printer.get_lines_between_positions(line_starts, pos1, pos2) = 0

    function get_lines_between_positions(line_starts: ref[Array[int]], pos1: int, pos2: int) returns int
    {
        if pos1 = pos2
            return 0
        var lower pos1
        if pos2 < pos1
            set lower: pos2
        let is_negative lower = pos2
        var upper pos2
        if is_negative
            set upper: pos1
        let lower_line Scanner.compute_line_of_position(line_starts, lower)
        let upper_line lower_line + Scanner.compute_line_of_position_from(line_starts, lower_line, upper)
        if is_negative
            return lower_line - upper_line
        upper_line - lower_line
    }

    function get_lines_between_range_end_and_range_start(r1: TextRange, r2: TextRange, text: Slice[char], line_starts: ref[Array[int]], include_second_range_comments: bool) returns int
    {
        let range2_start Printer.get_start_position_of_range(r2, text, include_second_range_comments)
        Printer.get_lines_between_positions(line_starts, r1.end, range2_start)
    }

    function get_lines_between_position_and_preceding_non_whitespace_character(pos: int, stop_pos: int, text: Slice[char], line_starts: ref[Array[int]], include_comments: bool) returns int
    {
        let start_pos Scanner.skip_trivia_ex(text, pos, false, include_comments, false)
        let prev_pos Printer.get_previous_non_whitespace_position(start_pos, stop_pos, text)
        var from stop_pos
        if prev_pos >= 0
            set from: prev_pos
        Printer.get_lines_between_positions(line_starts, from, start_pos)
    }

    function get_lines_between_position_and_next_non_whitespace_character(pos: int, stop_pos: int, text: Slice[char], line_starts: ref[Array[int]], include_comments: bool) returns int
    {
        let next_pos Scanner.skip_trivia_ex(text, pos, false, include_comments, false)
        var to next_pos
        if stop_pos < next_pos
            set to: stop_pos
        Printer.get_lines_between_positions(line_starts, pos, to)
    }

    ; getPreviousNonWhitespacePosition — a byte walk, as the reference's.
    function get_previous_non_whitespace_position(pos_in: int, stop_pos: int, text: Slice[char]) returns int
    {
        var pos pos_in
        while pos >= stop_pos
        {
            if Scanner.is_white_space_like((text[pos as size_t] as int) & 255) = false
                return pos
            set pos: pos - 1
        }
        0 - 1
    }

    ; canHaveDecorators
    function can_have_decorators(node: ref[AstNode]) returns bool
    {
        let kind AstNode.kind_of(node)
        if (kind = KindParameter) or (kind = KindPropertyDeclaration) or (kind = KindMethodDeclaration)
            return true
        if (kind = KindGetAccessor) or (kind = KindSetAccessor)
            return true
        (kind = KindClassExpression) or (kind = KindClassDeclaration)
    }

    ; skipSynthesizedParentheses
    function skip_synthesized_parentheses(node_in: ref[AstNode]) returns ref[AstNode]
    {
        var node node_in
        while true
        {
            if AstNode.kind_of(node) <> KindParenthesizedExpression
                return node
            if AstNode.pos_of(node) >= 0
                return node
            let inner AstNode.expression_of(node)
            if inner = null
                return node
            set node: inner as ref[AstNode]
        }
        node
    }

    function is_new_expression_without_arguments(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindNewExpression
            return false
        AstNode.call_arguments_of(node) = null
    }

    function skip_partially_emitted_expressions(node_in: ref[AstNode]) returns ref[AstNode]
    {
        var node node_in
        while AstNode.kind_of(node) = KindPartiallyEmittedExpression
        {
            let inner AstNode.expression_of(node)
            if inner = null
                return node
            set node: inner as ref[AstNode]
        }
        node
    }

    function is_binary_operation(node_in: ref[AstNode], token: int) returns bool
    {
        let node Printer.skip_partially_emitted_expressions(node_in)
        if AstNode.kind_of(node) <> KindBinaryExpression
            return false
        let op AstNode.binary_operator_token_of(node)
        if op = null
            return false
        AstNode.kind_of(op) = token
    }

    function mixing_binary_operators_requires_parentheses(a: int, b: int) returns bool
    {
        if a = KindQuestionQuestionToken
            return (b = KindAmpersandAmpersandToken) or (b = KindBarBarToken)
        if b = KindQuestionQuestionToken
            return (a = KindAmpersandAmpersandToken) or (a = KindBarBarToken)
        false
    }

    function is_immediately_invoked_function_expression_or_arrow_function(node_in: ref[AstNode]) returns bool
    {
        var node Printer.skip_partially_emitted_expressions(node_in)
        if AstNode.kind_of(node) <> KindCallExpression
            return false
        let callee AstNode.expression_of(node)
        if callee = null
            return false
        set node: Printer.skip_partially_emitted_expressions(callee as ref[AstNode])
        (AstNode.kind_of(node) = KindFunctionExpression) or (AstNode.kind_of(node) = KindArrowFunction)
    }

    ; ── generated names ──

    function has_leading_hash(text: Slice[char]) returns bool
    {
        if (text.length as int) = 0
            return false
        ((text[0 as size_t] as int) & 255) = ("#" as char) as int
    }

    function remove_leading_hash(text: Slice[char]) returns Slice[char]
    {
        if Printer.has_leading_hash(text)
            return text.slice_from(1 as size_t)
        text
    }

    procedure append_without_leading_hash(b: ref[StringBuilder], text: Slice[char])
    {
        let t Printer.remove_leading_hash(text)
        b.append(t.data, t.length)
    }

    function format_generated_name(host: ref[Page], private_name: bool, prefix: Slice[char], base: Slice[char], suffix: Slice[char]) returns String
    {
        let b StringBuilder^host()
        if private_name
            b.append("#" as char)
        Printer.append_without_leading_hash(&b, prefix)
        Printer.append_without_leading_hash(&b, base)
        Printer.append_without_leading_hash(&b, suffix)
        b.to_string()
    }

    function is_ascii_word_character(ch: int) returns bool
    {
        if Scanner.is_ascii_letter(ch)
            return true
        if Scanner.is_digit(ch)
            return true
        ch = ("_" as char) as int
    }

    ; makeIdentifierFromModuleName — over the base file name, bytewise.
    function make_identifier_from_module_name(host: ref[Page], module_name: Slice[char]) returns String
    {
        let name Printer.base_file_name_of(module_name)
        let b StringBuilder^host()
        let n name.length as int
        var pos 0
        while pos < n
        {
            let ch (name[pos as size_t] as int) & 255
            var written false
            if pos = 0
            {
                if Scanner.is_digit(ch)
                {
                    b.append("_" as char)
                    written: true
                }
            }
            if written = false
            {
                if Printer.is_ascii_word_character(ch) = false
                    b.append("_" as char)
                else
                    b.append(ch as char)
            }
            else
                b.append(ch as char)
            set pos: pos + 1
        }
        b.to_string()
    }

    ; tspath.GetBaseFileName's slash arm: the text after the last separator.
    function base_file_name_of(path: Slice[char]) returns Slice[char]
    {
        let n path.length as int
        var i n
        while i > 0
        {
            let c (path[(i - 1) as size_t] as int) & 255
            if (c = ("/" as char) as int) or (c = 92)
                break
            set i: i - 1
        }
        path.slice_from(i as size_t)
    }

    ; ── the triple-slash matcher, over a text and a cursor ──

    procedure skip_white_space_single_line(text: Slice[char], pos: ref[int])
    {
        let n text.length as int
        while pos < n
        {
            let ch Scanner.utf8_decode_in(text, n, pos)
            if Scanner.is_white_space_single_line(ch) = false
                break
            set pos: pos + Scanner.utf8_size_in(text, n, pos)
        }
    }

    function match_white_space_single_line(text: Slice[char], pos: ref[int]) returns bool
    {
        let start_pos pos
        Printer.skip_white_space_single_line(text, pos)
        pos <> start_pos
    }

    function match_rune(text: Slice[char], pos: ref[int], expected: int) returns bool
    {
        let n text.length as int
        if pos >= n
            return false
        let ch Scanner.utf8_decode_in(text, n, pos)
        if ch = expected
        {
            set pos: pos + Scanner.utf8_size_in(text, n, pos)
            return true
        }
        false
    }

    function match_string(text: Slice[char], pos: ref[int], expected: Slice[char]) returns bool
    {
        var text_pos pos
        let n text.length as int
        let m expected.length as int
        var expected_pos 0
        while expected_pos < m
        {
            if text_pos >= n
                return false
            let expected_rune Scanner.utf8_decode_in(expected, m, expected_pos)
            let expected_size Scanner.utf8_size_in(expected, m, expected_pos)
            if Printer.match_rune(text, &text_pos, expected_rune) = false
                return false
            set expected_pos: expected_pos + expected_size
        }
        set pos: text_pos
        true
    }

    function match_quoted_string(text: Slice[char], pos: ref[int]) returns bool
    {
        var text_pos pos
        var quote_char 0
        if Printer.match_rune(text, &text_pos, 39)
            set quote_char: 39
        else
        {
            if Printer.match_rune(text, &text_pos, 34)
                set quote_char: 34
            else
                return false
        }
        let n text.length as int
        while text_pos < n
        {
            let ch Scanner.utf8_decode_in(text, n, text_pos)
            set text_pos: text_pos + Scanner.utf8_size_in(text, n, text_pos)
            if ch = quote_char
            {
                set pos: text_pos
                return true
            }
        }
        false
    }

    function index_of_slash_greater(text: Slice[char], from: int) returns int
    {
        let n text.length as int
        var i from
        while i + 1 < n
        {
            if ((text[i as size_t] as int) & 255) = ("/" as char) as int
            {
                if ((text[(i + 1) as size_t] as int) & 255) = (">" as char) as int
                    return i
            }
            set i: i + 1
        }
        0 - 1
    }

    ; IsRecognizedTripleSlashComment: `/// <reference path|types|lib|no-default-lib="…" />`,
    ; `/// <amd-dependency path="…" />`, `/// <amd-module />`.
    function is_recognized_triple_slash_comment(source: Slice[char], comment: CommentRange) returns bool
    {
        if comment.kind <> KindSingleLineCommentTrivia
            return false
        if comment.len() <= 2
            return false
        if ((source[(comment.pos + 1) as size_t] as int) & 255) <> ("/" as char) as int
            return false
        if ((source[(comment.pos + 2) as size_t] as int) & 255) <> ("/" as char) as int
            return false
        let text source.subslice((comment.pos + 3) as size_t, comment.end as size_t)
        var pos 0
        Printer.skip_white_space_single_line(text, &pos)
        if Printer.match_rune(text, &pos, ("<" as char) as int) = false
            return false
        if Printer.match_string(text, &pos, "reference")
        {
            if Printer.match_white_space_single_line(text, &pos) = false
                return false
            var attr false
            if Printer.match_string(text, &pos, "path")
                set attr: true
            if attr = false
            {
                if Printer.match_string(text, &pos, "types")
                    set attr: true
            }
            if attr = false
            {
                if Printer.match_string(text, &pos, "lib")
                    set attr: true
            }
            if attr = false
            {
                if Printer.match_string(text, &pos, "no-default-lib")
                    set attr: true
            }
            if attr = false
                return false
            Printer.skip_white_space_single_line(text, &pos)
            if Printer.match_rune(text, &pos, ("=" as char) as int) = false
                return false
            Printer.skip_white_space_single_line(text, &pos)
            if Printer.match_quoted_string(text, &pos) = false
                return false
        }
        else
        {
            if Printer.match_string(text, &pos, "amd-dependency")
            {
                if Printer.match_white_space_single_line(text, &pos) = false
                    return false
                if Printer.match_string(text, &pos, "path") = false
                    return false
                Printer.skip_white_space_single_line(text, &pos)
                if Printer.match_rune(text, &pos, ("=" as char) as int) = false
                    return false
                Printer.skip_white_space_single_line(text, &pos)
                if Printer.match_quoted_string(text, &pos) = false
                    return false
            }
            else
            {
                if Printer.match_string(text, &pos, "amd-module")
                    Printer.skip_white_space_single_line(text, &pos)
                else
                    return false
            }
        }
        Printer.index_of_slash_greater(text, pos) >= 0
    }

    function is_jsdoc_like_text(text: Slice[char], comment: CommentRange) returns bool
    {
        if comment.kind <> KindMultiLineCommentTrivia
            return false
        if comment.len() < 5
            return false
        if ((text[(comment.pos + 2) as size_t] as int) & 255) <> ("*" as char) as int
            return false
        ((text[(comment.pos + 3) as size_t] as int) & 255) <> ("/" as char) as int
    }

    function is_pinned_comment(text: Slice[char], comment: CommentRange) returns bool
    {
        if comment.kind <> KindMultiLineCommentTrivia
            return false
        if comment.len() <= 5
            return false
        ((text[(comment.pos + 2) as size_t] as int) & 255) = ("!" as char) as int
    }

    ; calculateIndent — a tab goes to the next tab stop, a space counts one.
    function calculate_indent(text: Slice[char], pos_in: int, stop: int) returns int
    {
        var current_line_indent 0
        let indent_size TextWriter.get_default_indent_size()
        let n text.length as int
        var pos pos_in
        while pos < stop
        {
            let ch Scanner.utf8_decode_in(text, n, pos)
            if Scanner.is_white_space_single_line(ch) = false
                break
            if ch = 9
                set current_line_indent: current_line_indent + (indent_size - (current_line_indent % indent_size))
            else
                set current_line_indent: current_line_indent + 1
            set pos: pos + Scanner.utf8_size_in(text, n, pos)
        }
        current_line_indent
    }

    ; findSpanEnd is generic over a test func; each caller writes its loop (§3.18).

    ; ── the three utilities that read the emit context (deferred from slice 230) ──

    ; siblingNodePositionsAreComparable: consecutive members of one node array.
    function sibling_node_positions_are_comparable(context: ref[EmitContext], previous_in: ref[AstNode], next_in: ref[AstNode]) returns bool
    {
        if next_in.pos < previous_in.end
            return false
        let previous_node context.most_original(previous_in) as ref[AstNode]
        let next_node context.most_original(next_in) as ref[AstNode]
        let parent previous_node.parent
        if parent = null
            return false
        if parent <> next_node.parent
            return false
        let parent_node_array Printer.get_containing_node_array(previous_node)
        if parent_node_array = null
            return false
        let list parent_node_array as ref[Array[ref[AstNode]?]]
        var prev_index 0 - 1
        var next_index 0 - 1
        var i 0
        while i < (list.get_length() as int)
        {
            if list[i as size_t] = previous_node
                set prev_index: i
            if list[i as size_t] = next_node
                set next_index: i
            set i: i + 1
        }
        if prev_index < 0
            return false
        next_index = prev_index + 1
    }

    ; getContainingNodeArray: the list the node sits in, by the node's kind and
    ; then its parent's. The JSDoc-tag arm is the reference's own TODO.
    function get_containing_node_array(node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let parent_opt node.parent
        if parent_opt = null
            return null
        let parent parent_opt as ref[AstNode]
        let k node.kind
        let pk parent.kind
        if k = KindTypeParameter
        {
            if AstNode.is_function_like(parent) or (pk = KindClassDeclaration) or (pk = KindClassExpression) or (pk = KindInterfaceDeclaration) or AstNode.is_type_or_js_type_alias_declaration(parent)
                return AstNode.type_parameters_of(parent)
            return null
        }
        if k = KindParameter
            return AstNode.parameters_of(parent)
        if k = KindTemplateLiteralTypeSpan
            return AstNode.template_literal_type_spans_of(parent)
        if k = KindTemplateSpan
            return AstNode.template_expression_spans_of(parent)
        if k = KindDecorator
        {
            if Printer.can_have_decorators(parent)
                return AstNode.modifiers_of(parent)
            return null
        }
        if k = KindHeritageClause
            return AstNode.heritage_clauses_of(parent)
        if (pk = KindTypeLiteral) or (pk = KindInterfaceDeclaration)
        {
            if Printer.is_type_element_kind(k)
                return Printer.member_list_of(parent)
        }
        if (pk = KindUnionType) or (pk = KindIntersectionType)
            return AstNode.type_list_of(parent)
        if (pk = KindArrayLiteralExpression) or (pk = KindTupleType) or (pk = KindNamedImports) or (pk = KindNamedExports)
            return AstNode.elements_of(parent)
        if (pk = KindObjectLiteralExpression) or (pk = KindJsxAttributes)
            return AstNode.properties_of(parent)
        if (pk = KindCallExpression) or (pk = KindNewExpression)
        {
            if AstNode.is_type_node_kind(k)
                return AstNode.type_arguments_of(parent)
            if AstNode.expression_of(parent) <> node
                return AstNode.call_arguments_of(parent)
            return null
        }
        if (pk = KindJsxElement) or (pk = KindJsxFragment)
        {
            if Printer.is_jsx_child_kind(k)
                return AstNode.jsx_children_of(parent)
        }
        if (pk = KindJsxOpeningElement) or (pk = KindJsxSelfClosingElement)
        {
            if AstNode.is_type_node_kind(k)
                return AstNode.type_arguments_of(parent)
        }
        if (pk = KindBlock) or (pk = KindModuleBlock) or (pk = KindCaseClause) or (pk = KindDefaultClause)
            return AstNode.statements_of(parent)
        if pk = KindCaseBlock
            return AstNode.case_clauses_of(parent)
        if (pk = KindClassDeclaration) or (pk = KindClassExpression)
        {
            if Binder.is_class_element(node)
                return Printer.member_list_of(parent)
        }
        if pk = KindEnumDeclaration
        {
            if k = KindEnumMember
                return Printer.member_list_of(parent)
        }
        if pk = KindSourceFile
        {
            if Checker.is_statement(node)
                return AstNode.statements_of(parent)
        }
        if Printer.is_modifier_kind(k)
            return AstNode.modifiers_of(parent)
        null
    }

    ; Node.MemberList: the six kinds that carry a member list.
    function member_list_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when c: ClassDeclaration return c.members
            when c: ClassExpression return c.members
            when c: InterfaceDeclaration return c.members
            when e: EnumDeclaration return e.members
            when t: TypeLiteral return t.members
            when m: MappedType return m.members
            else return null
    }

    function is_type_element_kind(k: int) returns bool
    {
        if (k = KindCallSignature) or (k = KindConstructSignature) or (k = KindPropertySignature)
            return true
        if (k = KindMethodSignature) or (k = KindIndexSignature) or (k = KindGetAccessor) or (k = KindSetAccessor)
            return true
        k = KindNotEmittedTypeElement
    }

    function is_jsx_child_kind(k: int) returns bool
    {
        if (k = KindJsxElement) or (k = KindJsxExpression) or (k = KindJsxSelfClosingElement)
            return true
        (k = KindJsxText) or (k = KindJsxFragment)
    }

    function is_modifier_kind(k: int) returns bool
        AstNode.modifier_to_flag(k) <> ModifierFlagsNone

    function original_nodes_have_same_parent(context: ref[EmitContext], node_a_in: ref[AstNode], node_b_in: ref[AstNode]) returns bool
    {
        let node_a context.most_original(node_a_in) as ref[AstNode]
        if node_a.parent = null
            return false
        let node_b context.most_original(node_b_in) as ref[AstNode]
        node_a.parent = node_b.parent
    }

    ; ═══ printer.go (slice 233) — the printer proper ═══

    ; NewPrinter. The name generator is built first and handed the printer once
    ; the printer exists (its two callbacks, §3.18).
    function create(host: ref[Page], options: PrinterOptions, context_in: ref[EmitContext]?) returns ref[Printer]
    {
        var ctx: ref[EmitContext]? context_in
        if ctx = null
            set ctx: EmitContext.create(host, null)
        let c ctx as ref[EmitContext]
        let ng NameGenerator.create(host, c, null)
        let dci &Array[DetachedCommentsInfo]^host()
        let no_tag: Slice[char] ""
        let p &Printer^host(host, options, HandlersTagNone, HasGlobalNameTagNone, c, null, null, null, 0, null, null, WriteKindNone, false, null, null, 0 - 1, false, null, null, 0 - 1, 0 - 1, 0 - 1, 0 - 1, dci, 0, options.remove_comments, false, ng, null, 0, no_tag, 0)
        set ng.printer: p
        p
    }

    ; The stop channel, the checker's shape: a count, the first tag and detail.
    procedure record_unported(this, tag: Slice[char], detail: int)
    {
        if unported_count = 0
        {
            set this.unported_tag: tag
            set this.unported_detail: detail
        }
        set this.unported_count: unported_count + 1
    }

    ; The per-kind emitters of slices 234/235 meet here until they land.
    procedure emit_unported(this, node: ref[AstNode])
        this.record_unported("emit-kind", node.kind)

    function the_writer(this) returns ref[TextWriter]
        writer as ref[TextWriter]

    function file_text(this) returns Slice[char]
        (current_source_file as ref[SourceFileInfo]).text

    function file_lines(this) returns ref[Array[int]]
        (current_source_file as ref[SourceFileInfo]).line_starts

    ; ast.GetSourceFileOfNode(node) as a SourceFileInfo: the current file when
    ; the node lies in it, else nothing (a single-file emit has no other).
    function source_info_of(this, node: ref[AstNode]) returns ref[SourceFileInfo]?
    {
        if current_source_file = null
            return null
        let csf current_source_file as ref[SourceFileInfo]
        if Checker.source_file_of_node(node) = csf.node
            return csf
        null
    }

    ; ── small statics the reference gets from ast/stringutil ──

    function position_is_synthesized(pos: int) returns bool
        pos < 0

    function node_is_synthesized(node: ref[AstNode]) returns bool
        (node.pos < 0) or (node.end < 0)

    function is_keyword_kind(k: int) returns bool
        (k >= KindFirstKeyword) and (k <= KindLastKeyword)

    function is_punctuation_kind(k: int) returns bool
        (k >= KindFirstPunctuation) and (k <= KindLastPunctuation)

    function is_jsdoc_kind(k: int) returns bool
        (k >= KindFirstJSDocNode) and (k <= KindLastJSDocNode)

    function is_member_name_kind(k: int) returns bool
        (k = KindIdentifier) or (k = KindPrivateIdentifier)

    ; unicode.IsSpace — Go's `strings.TrimSpace` predicate, not the scanner's.
    function is_go_space(ch: int) returns bool
    {
        if (ch = 32) or (ch = 9) or (ch = 10) or (ch = 11) or (ch = 12) or (ch = 13)
            return true
        if (ch = 133) or (ch = 160) or (ch = 5760)
            return true
        if (ch >= 8192) and (ch <= 8202)
            return true
        if (ch = 8232) or (ch = 8233) or (ch = 8239) or (ch = 8287) or (ch = 12288)
            return true
        false
    }

    ; strings.TrimSpace
    function trim_space(text: Slice[char]) returns Slice[char]
    {
        let n text.length as int
        var start 0
        while start < n
        {
            let ch Scanner.utf8_decode_in(text, n, start)
            if Printer.is_go_space(ch) = false
                break
            set start: start + Scanner.utf8_size_in(text, n, start)
        }
        var end n
        while end > start
        {
            var p end - 1
            while (p > start) and (((text[p as size_t] as int) & 192) = 128)
                set p: p - 1
            let ch Scanner.utf8_decode_in(text, n, p)
            if Printer.is_go_space(ch) = false
                break
            set end: p
        }
        text.subslice(start as size_t, end as size_t)
    }

    ; stringutil.SplitLines
    function split_lines(host: ref[Page], text: Slice[char]) returns ref[Array[Slice[char]]]
    {
        let lines &Array[Slice[char]]^host()
        let n text.length as int
        var start 0
        var pos 0
        while pos < n
        {
            let c text[pos as size_t] as int
            if c = 13
            {
                if (pos + 1 < n) and ((text[(pos + 1) as size_t] as int) = 10)
                {
                    lines.add(text.subslice(start as size_t, pos as size_t))
                    set pos: pos + 2
                    set start: pos
                    continue
                }
                lines.add(text.subslice(start as size_t, pos as size_t))
                set pos: pos + 1
                set start: pos
                continue
            }
            if c = 10
            {
                lines.add(text.subslice(start as size_t, pos as size_t))
                set pos: pos + 1
                set start: pos
                continue
            }
            set pos: pos + 1
        }
        if start < n
            lines.add(text.subslice(start as size_t, n as size_t))
        lines
    }

    ; stringutil.GuessIndentation
    function guess_indentation(lines: ref[Array[Slice[char]]]) returns int
    {
        var indentation 1073741823
        var li 0
        while li < (lines.get_length() as int)
        {
            let line lines[li as size_t]
            set li: li + 1
            let n line.length as int
            if n = 0
                continue
            var i 0
            while (i < n) and (i < indentation)
            {
                let ch Scanner.utf8_decode_in(line, n, i)
                if Scanner.is_white_space_like(ch) = false
                    break
                set i: i + Scanner.utf8_size_in(line, n, i)
            }
            if i < indentation
                set indentation: i
            if indentation = 0
                return 0
        }
        if indentation = 1073741823
            return 0
        indentation
    }

    ; Node.Text() for the kinds the printer asks it of.
    function text_of_node(host: ref[Page], node: ref[AstNode]) returns Slice[char]
    {
        let k node.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
            return AstNode.identifier_text_of(node)
        if k = KindJsxNamespacedName
        {
            let b StringBuilder^host()
            let ns AstNode.identifier_text_of(AstNode.namespaced_namespace_of(node))
            b.append(ns.data, ns.length)
            b.append(":" as char)
            let nm AstNode.identifier_text_of(AstNode.namespaced_name_of(node))
            b.append(nm.data, nm.length)
            return Printer.slice_of(b.to_string())
        }
        AstNode.literal_text_of(node)
    }

    ; greatestEnd over one node and over one range (the two shapes it is called with)
    function greatest_end_node(end: int, node: ref[AstNode]?) returns int
    {
        if node = null
            return end
        let n node as ref[AstNode]
        if end < n.end
            return n.end
        end
    }

    function greatest_end_range(end: int, r: TextRange) returns int
    {
        if end < r.end
            return r.end
        end
    }

    function get_opening_bracket(this, format: int) returns Slice[char]
    {
        let b format & LFBracketsMask
        if b = LFBraces
            return "{"
        if b = LFParenthesis
            return "("
        if b = LFAngleBrackets
            return "<"
        if b = LFSquareBrackets
            return "["
        ; the reference PANICS ("Unexpected bracket")
        this.record_unported("list-format-bracket", b)
        ""
    }

    function get_closing_bracket(this, format: int) returns Slice[char]
    {
        let b format & LFBracketsMask
        if b = LFBraces
            return "}"
        if b = LFParenthesis
            return ")"
        if b = LFAngleBrackets
            return ">"
        if b = LFSquareBrackets
            return "]"
        this.record_unported("list-format-bracket", b)
        ""
    }

    ; ── the two text accessors ──

    procedure get_literal_text_of_node(this, node: ref[AstNode], source: ref[SourceFileInfo]?, flags_in: int) returns Slice[char]
    {
        var flags flags_in
        if node.kind = KindStringLiteral
        {
            let text_source_node context.text_source(node)
            if text_source_node <> null
            {
                let tsn text_source_node as ref[AstNode]
                var text: Slice[char] ""
                let k tsn.kind
                if k = KindNumericLiteral
                    set text: AstNode.literal_text_of(tsn)
                else
                {
                    if (k = KindIdentifier) or (k = KindPrivateIdentifier) or (k = KindJsxNamespacedName)
                        set text: this.get_text_of_node(tsn, false)
                    else
                        return this.get_literal_text_of_node(tsn, this.source_info_of(tsn), flags)
                }
                let b StringBuilder^host()
                b.append(34 as char)
                if (flags & LiteralTextFlagsJsxAttributeEscape) <> 0
                    b.append(Printer.escape_jsx_attribute_string(host, text, QuoteCharDoubleQuote))
                else
                {
                    if ((flags & LiteralTextFlagsNeverAsciiEscape) <> 0) or ((context.emit_flags(node) & EFNoAsciiEscaping) <> 0)
                        b.append(Printer.escape_string(host, text, QuoteCharDoubleQuote))
                    else
                        b.append(Printer.escape_non_ascii_string(host, text, QuoteCharDoubleQuote))
                }
                b.append(34 as char)
                return Printer.slice_of(b.to_string())
            }
        }
        if (context.emit_flags(node) & EFNoAsciiEscaping) <> 0
            set flags: flags | LiteralTextFlagsNeverAsciiEscape
        if options.target >= ScriptTargetES2021
            set flags: flags | LiteralTextFlagsAllowNumericSeparator
        var src: ref[SourceFileInfo]? source
        if src = null
            set src: current_source_file
        if src = null
        {
            let no_text: Slice[char] ""
            return Printer.get_literal_text(host, node, no_text, false, flags)
        }
        let s src as ref[SourceFileInfo]
        Printer.get_literal_text(host, node, s.text, true, flags)
    }

    ; `node` is an Identifier, PrivateIdentifier, literal or JsxNamespacedName
    procedure get_text_of_node(this, node: ref[AstNode], include_trivia: bool) returns Slice[char]
    {
        let k node.kind
        if Printer.is_member_name_kind(k) and (context.get_auto_generate_info(node) <> null)
            return name_generator.generate_name(node)
        if k = KindStringLiteral
        {
            let tsn context.text_source(node)
            if tsn <> null
                return this.get_text_of_node(tsn as ref[AstNode], include_trivia)
        }
        let can_use_source_file (current_source_file <> null) and (node.parent <> null) and (Printer.node_is_synthesized(node) = false)
        if (k = KindIdentifier) or (k = KindPrivateIdentifier) or (k = KindJsxNamespacedName)
        {
            if can_use_source_file = false
                return Printer.text_of_node(host, node)
            let csf current_source_file as ref[SourceFileInfo]
            if Checker.source_file_of_node(node) <> context.most_original(csf.node)
                return Printer.text_of_node(host, node)
        }
        else
        {
            if (k = KindStringLiteral) or (k = KindNumericLiteral) or (k = KindBigIntLiteral) or (k = KindNoSubstitutionTemplateLiteral) or (k = KindTemplateHead) or (k = KindTemplateMiddle) or (k = KindTemplateTail)
                return this.get_literal_text_of_node(node, null, LiteralTextFlagsNone)
            ; the reference PANICS ("unexpected node")
            this.record_unported("get-text-of-node-kind", k)
            return Printer.text_of_node(host, node)
        }
        let csf current_source_file as ref[SourceFileInfo]
        Printer.get_text_of_node_from_source_text(host, csf.text, node, include_trivia)
    }

    ; ── low-level writing ──

    procedure write_as(this, text: Slice[char], write_kind_in: int)
    {
        let w this.the_writer()
        if write_kind_in = WriteKindNone
            w.write(text)
        else
        {
            if write_kind_in = WriteKindParameter
                this.write_parameter(text)
            else
            {
                if write_kind_in = WriteKindKeyword
                    this.write_keyword(text)
                else
                {
                    if write_kind_in = WriteKindOperator
                        this.write_operator(text)
                    else
                    {
                        if write_kind_in = WriteKindProperty
                            this.write_property(text)
                        else
                        {
                            if write_kind_in = WriteKindPunctuation
                                this.write_punctuation(text)
                            else
                            {
                                if write_kind_in = WriteKindStringLiteral
                                    w.write_string_literal(text)
                                else
                                {
                                    if write_kind_in = WriteKindComment
                                        this.write_comment(text)
                                    else
                                    {
                                        if write_kind_in = WriteKindLiteral
                                            this.write_literal(text)
                                        else
                                            this.record_unported("write-kind", write_kind_in)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    procedure write(this, text: Slice[char])
        this.write_as(text, write_kind)

    procedure set_write_kind(this, kind: int) returns int
    {
        let previous write_kind
        set this.write_kind: kind
        previous
    }

    procedure write_symbol(this, text: Slice[char], opt_symbol: ref[Symbol]?)
    {
        if opt_symbol = null
            this.write(text)
        else
            this.the_writer().write_symbol(text)
    }

    procedure write_literal(this, text: Slice[char])
        this.the_writer().write_literal(text)

    procedure write_punctuation(this, text: Slice[char])
        this.the_writer().write_punctuation(text)

    procedure write_operator(this, text: Slice[char])
        this.the_writer().write_operator(text)

    procedure write_keyword(this, text: Slice[char])
        this.the_writer().write_keyword(text)

    procedure write_property(this, text: Slice[char])
        this.the_writer().write_property(text)

    procedure write_parameter(this, text: Slice[char])
        this.the_writer().write_parameter(text)

    procedure write_comment(this, text: Slice[char])
        this.the_writer().write_comment(text)

    procedure write_space(this)
    {
        let w this.the_writer()
        w.write_space(" ")
    }

    procedure write_line(this)
        this.the_writer().write_line()

    procedure write_line_repeat(this, count: int)
    {
        var i 0
        while i < count
        {
            this.write_line()
            set i: i + 1
        }
    }

    procedure write_lines(this, text: Slice[char])
    {
        let lines Printer.split_lines(host, text)
        let indentation Printer.guess_indentation(lines)
        var i 0
        while i < (lines.get_length() as int)
        {
            var line lines[i as size_t]
            if indentation > 0
                set line: line.slice_from(indentation as size_t)
            if (line.length as int) > 0
            {
                this.write_line()
                this.write(line)
            }
            set i: i + 1
        }
    }

    procedure write_trailing_semicolon(this)
    {
        let w this.the_writer()
        w.write_trailing_semicolon(";")
    }

    procedure increase_indent(this)
        this.the_writer().increase_indent()

    procedure decrease_indent(this)
        this.the_writer().decrease_indent()

    procedure increase_indent_if(this, indent_requested: bool)
    {
        if indent_requested
            this.increase_indent()
    }

    procedure decrease_indent_if(this, indent_requested: bool)
    {
        if indent_requested
            this.decrease_indent()
    }

    procedure write_line_or_space(this, parent_node: ref[AstNode], prev_child_node: ref[AstNode], next_child_node: ref[AstNode])
    {
        if this.should_emit_on_single_line(parent_node)
        {
            this.write_space()
            return
        }
        if options.preserve_source_newlines
        {
            let lines this.get_lines_between_nodes(parent_node, prev_child_node, next_child_node)
            if lines > 0
                this.write_line_repeat(lines)
            else
                this.write_space()
            return
        }
        this.write_line()
    }

    procedure write_lines_and_indent(this, line_count: int, write_space_if_not_indenting: bool)
    {
        if line_count > 0
        {
            this.increase_indent()
            this.write_line_repeat(line_count)
            return
        }
        if write_space_if_not_indenting
            this.write_space()
    }

    procedure write_line_separators_and_indent_before(this, node: ref[AstNode], parent: ref[AstNode]) returns bool
    {
        if options.preserve_source_newlines
        {
            let leading_newlines this.get_leading_line_terminator_count(parent, node, LFNone)
            if leading_newlines > 0
            {
                this.write_lines_and_indent(leading_newlines, false)
                return true
            }
        }
        false
    }

    procedure write_line_separators_after(this, node: ref[AstNode], parent: ref[AstNode])
    {
        if options.preserve_source_newlines
        {
            let trailing_newlines this.get_closing_line_terminator_count(parent, node, LFNone, TextRange.undefined_range())
            if trailing_newlines > 0
                this.write_line_repeat(trailing_newlines)
        }
    }

    ; ── line terminators ──

    procedure get_lines_between_nodes(this, parent_in: ref[AstNode], node1_in: ref[AstNode], node2_in: ref[AstNode]) returns int
    {
        if this.should_elide_indentation(parent_in)
            return 0
        let parent Printer.skip_synthesized_parentheses(parent_in)
        let node1 Printer.skip_synthesized_parentheses(node1_in)
        let node2 Printer.skip_synthesized_parentheses(node2_in)
        if this.should_emit_on_new_line(node2, LFNone)
            return 1
        if (current_source_file <> null) and (Printer.node_is_synthesized(parent) = false) and (Printer.node_is_synthesized(node1) = false) and (Printer.node_is_synthesized(node2) = false)
        {
            if options.preserve_source_newlines
                return this.get_effective_lines_between_ranges(TextRange.of_node(node1), TextRange.of_node(node2))
            let csf current_source_file as ref[SourceFileInfo]
            if Printer.range_end_is_on_same_line_as_range_start(TextRange.of_node(node1), TextRange.of_node(node2), csf.text, csf.line_starts)
                return 0
            return 1
        }
        0
    }

    ; getEffectiveLines, once per line-difference shape (§3.18): comments
    ; included first, then without them when that read 0.
    procedure get_effective_lines_between_ranges(this, r1: TextRange, r2: TextRange) returns int
    {
        let csf current_source_file as ref[SourceFileInfo]
        let lines Printer.get_lines_between_range_end_and_range_start(r1, r2, csf.text, csf.line_starts, true)
        if lines = 0
            return Printer.get_lines_between_range_end_and_range_start(r1, r2, csf.text, csf.line_starts, false)
        lines
    }

    procedure get_effective_lines_preceding(this, pos: int, stop_pos: int) returns int
    {
        let csf current_source_file as ref[SourceFileInfo]
        let lines Printer.get_lines_between_position_and_preceding_non_whitespace_character(pos, stop_pos, csf.text, csf.line_starts, true)
        if lines = 0
            return Printer.get_lines_between_position_and_preceding_non_whitespace_character(pos, stop_pos, csf.text, csf.line_starts, false)
        lines
    }

    procedure get_effective_lines_next(this, pos: int, stop_pos: int) returns int
    {
        let csf current_source_file as ref[SourceFileInfo]
        let lines Printer.get_lines_between_position_and_next_non_whitespace_character(pos, stop_pos, csf.text, csf.line_starts, true)
        if lines = 0
            return Printer.get_lines_between_position_and_next_non_whitespace_character(pos, stop_pos, csf.text, csf.line_starts, false)
        lines
    }

    procedure get_leading_line_terminator_count(this, parent_node: ref[AstNode]?, first_child: ref[AstNode]?, format: int) returns int
    {
        if ((format & LFPreserveLines) <> 0) or options.preserve_source_newlines
        {
            if (format & LFPreferNewLine) <> 0
                return 1
            if first_child = null
            {
                if parent_node = null
                    return 0
                if current_source_file <> null
                {
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_is_on_single_line(TextRange.of_node(parent_node as ref[AstNode]), csf.text, csf.line_starts)
                        return 0
                }
                return 1
            }
            let fc first_child as ref[AstNode]
            if (next_list_element_pos > 0) and (fc.pos = next_list_element_pos)
                return 0
            if fc.kind = KindJsxText
                return 0
            if (current_source_file <> null) and (parent_node <> null)
            {
                let pn parent_node as ref[AstNode]
                if (Printer.position_is_synthesized(pn.pos) = false) and (Printer.node_is_synthesized(fc) = false) and (fc.parent = null)
                {
                    if options.preserve_source_newlines
                        return this.get_effective_lines_preceding(fc.pos, pn.pos)
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_start_positions_are_on_same_line(TextRange.of_node(pn), TextRange.of_node(fc), csf.text, csf.line_starts)
                        return 0
                    return 1
                }
            }
            if this.should_emit_on_new_line(fc, format)
                return 1
        }
        if (format & LFMultiLine) <> 0
            return 1
        0
    }

    procedure get_separating_line_terminator_count(this, previous_node: ref[AstNode]?, next_node: ref[AstNode]?, format: int) returns int
    {
        if ((format & LFPreserveLines) <> 0) or options.preserve_source_newlines
        {
            if (previous_node = null) or (next_node = null)
                return 0
            let prev previous_node as ref[AstNode]
            let next next_node as ref[AstNode]
            if next.kind = KindJsxText
                return 0
            if (current_source_file <> null) and (Printer.node_is_synthesized(prev) = false) and (Printer.node_is_synthesized(next) = false)
            {
                if options.preserve_source_newlines and Printer.sibling_node_positions_are_comparable(context, prev, next)
                    return this.get_effective_lines_between_ranges(TextRange.of_node(prev), TextRange.of_node(next))
                if (options.preserve_source_newlines = false) and Printer.original_nodes_have_same_parent(context, prev, next)
                {
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_end_is_on_same_line_as_range_start(TextRange.of_node(prev), TextRange.of_node(next), csf.text, csf.line_starts)
                        return 0
                    return 1
                }
                if (format & LFPreferNewLine) <> 0
                    return 1
                return 0
            }
            if this.should_emit_on_new_line(prev, format) or this.should_emit_on_new_line(next, format)
                return 1
        }
        else
        {
            if next_node <> null
            {
                if this.should_emit_on_new_line(next_node as ref[AstNode], LFNone)
                    return 1
            }
        }
        if (format & LFMultiLine) <> 0
            return 1
        0
    }

    procedure get_closing_line_terminator_count(this, parent_node: ref[AstNode]?, last_child: ref[AstNode]?, format: int, children_text_range: TextRange) returns int
    {
        if ((format & LFPreserveLines) <> 0) or options.preserve_source_newlines
        {
            if (format & LFPreferNewLine) <> 0
                return 1
            if last_child = null
            {
                if parent_node = null
                    return 0
                if current_source_file <> null
                {
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_is_on_single_line(TextRange.of_node(parent_node as ref[AstNode]), csf.text, csf.line_starts)
                        return 0
                }
                return 1
            }
            let lc last_child as ref[AstNode]
            if (current_source_file <> null) and (parent_node <> null)
            {
                let pn parent_node as ref[AstNode]
                if (Printer.position_is_synthesized(pn.pos) = false) and (Printer.node_is_synthesized(lc) = false) and ((lc.parent = null) or (lc.parent = pn))
                {
                    if options.preserve_source_newlines
                    {
                        let end Printer.greatest_end_range(lc.end, children_text_range)
                        return this.get_effective_lines_next(end, pn.end)
                    }
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_end_positions_are_on_same_line(TextRange.of_node(pn), TextRange.of_node(lc), csf.line_starts)
                        return 0
                    return 1
                }
            }
            if this.should_emit_on_new_line(lc, format)
                return 1
        }
        if ((format & LFMultiLine) <> 0) and ((format & LFNoTrailingNewLine) = 0)
            return 1
        0
    }

    ; ── comment text ──

    procedure write_comment_range(this, comment: CommentRange)
    {
        if current_source_file = null
            return
        let csf current_source_file as ref[SourceFileInfo]
        this.write_comment_range_worker(csf.text, csf.line_starts, comment.kind, comment.pos, comment.end)
    }

    procedure write_comment_range_worker(this, text: Slice[char], line_map: ref[Array[int]]?, kind: int, loc_pos: int, loc_end: int)
    {
        let w this.the_writer()
        if kind <> KindMultiLineCommentTrivia
        {
            ; Single line comment of style //....
            this.write_comment(text.subslice(loc_pos as size_t, loc_end as size_t))
            return
        }
        let lm line_map as ref[Array[int]]
        let indent_size TextWriter.get_default_indent_size()
        let first_line Scanner.compute_line_of_position(lm, loc_pos)
        let line_count lm.get_length() as int
        var first_comment_line_indent 0 - 1
        var pos loc_pos
        var current_line first_line
        while pos < loc_end
        {
            var next_line_start 0
            if current_line + 1 = line_count
                set next_line_start: (text.length as int) + 1
            else
                set next_line_start: lm[(current_line + 1) as size_t]
            if pos <> loc_pos
            {
                ; not the first line: write the spaces that keep the alignment
                if first_comment_line_indent = 0 - 1
                    set first_comment_line_indent: Printer.calculate_indent(text, lm[first_line as size_t], loc_pos)
                let current_writer_indent_spacing w.get_indent() * indent_size
                let spaces_to_emit (current_writer_indent_spacing - first_comment_line_indent) + Printer.calculate_indent(text, pos, next_line_start)
                if spaces_to_emit > 0
                {
                    var number_of_single_spaces_to_emit spaces_to_emit % indent_size
                    ; getIndentString((spaces - singles) / size, size): that many indent units of spaces, raw
                    var k spaces_to_emit - number_of_single_spaces_to_emit
                    while k > 0
                    {
                        w.raw_write(" ")
                        set k: k - 1
                    }
                    while number_of_single_spaces_to_emit > 0
                    {
                        w.raw_write(" ")
                        set number_of_single_spaces_to_emit: number_of_single_spaces_to_emit - 1
                    }
                }
                else
                    w.raw_write("")
            }
            ; the comment line text
            var end loc_end
            if next_line_start < end
                set end: next_line_start
            var scan pos
            while scan < end
            {
                let size Scanner.utf8_size_in(text, end, scan)
                let ch Scanner.utf8_decode_in(text, end, scan)
                if Scanner.is_line_break(ch)
                {
                    set end: scan
                    break
                }
                set scan: scan + size
            }
            let current_line_text Printer.trim_space(text.subslice(pos as size_t, end as size_t))
            if (current_line_text.length as int) > 0
            {
                this.write_comment(current_line_text)
                if end <> loc_end
                    this.write_line()
            }
            else
                w.write_line_force(true)
            set pos: next_line_start
            set current_line: current_line + 1
        }
    }

    ; ── custom emit behavior (EmitNode, EmitFlags) ──

    function should_emit_comments(this, node: ref[AstNode]) returns bool
        (comments_disabled = false) and (current_source_file <> null) and (node.kind <> KindSourceFile)

    function should_write_comment(this, comment: CommentRange) returns bool
    {
        if options.only_print_jsdoc_style = false
            return true
        if current_source_file = null
            return false
        let csf current_source_file as ref[SourceFileInfo]
        if Printer.is_jsdoc_like_text(csf.text, comment)
            return true
        Printer.is_pinned_comment(csf.text, comment)
    }

    function should_emit_indented(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFIndented) <> 0

    function should_elide_indentation(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFNoIndentation) <> 0

    function should_emit_on_single_line(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFSingleLine) <> 0

    function should_emit_on_multiple_lines(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFMultiLine) <> 0

    procedure should_emit_block_function_body_on_single_line(this, body: ref[AstNode]) returns bool
    {
        if this.should_emit_on_single_line(body)
            return true
        if AstNode.multi_line_of(body)
            return false
        if (Printer.node_is_synthesized(body) = false) and (current_source_file <> null)
        {
            let csf current_source_file as ref[SourceFileInfo]
            if Printer.range_is_on_single_line(TextRange.of_node(body), csf.text, csf.line_starts) = false
                return false
        }
        let statements AstNode.statements_of(body)
        var first: ref[AstNode]? null
        var last: ref[AstNode]? null
        var n 0
        if statements <> null
        {
            let st statements as ref[Array[ref[AstNode]?]]
            set n: st.get_length() as int
            if n > 0
            {
                set first: st[0]
                set last: st[(n - 1) as size_t]
            }
        }
        var list_pos 0 - 1
        var list_end 0 - 1
        this.list_range(statements, &list_pos, &list_end)
        if this.get_leading_line_terminator_count(body, first, LFPreserveLines) > 0
            return false
        if this.get_closing_line_terminator_count(body, last, LFPreserveLines, TextRange(list_pos, list_end)) > 0
            return false
        var previous_statement: ref[AstNode]? null
        var i 0
        while i < n
        {
            let st statements as ref[Array[ref[AstNode]?]]
            let statement st[i as size_t]
            if this.get_separating_line_terminator_count(previous_statement, statement, LFPreserveLines) > 0
                return false
            set previous_statement: statement
            set i: i + 1
        }
        true
    }

    function should_emit_on_new_line(this, node: ref[AstNode], format: int) returns bool
    {
        if (context.emit_flags(node) & EFStartOnNewLine) <> 0
            return true
        (format & LFPreferNewLine) <> 0
    }

    function should_emit_source_maps(this, node: ref[AstNode]) returns bool
        (source_maps_disabled = false) and (source_map_source <> null) and (node.kind <> KindSourceFile) and (Checker.is_in_json_file(node) = false)

    function should_emit_token_source_maps(this, token: int, pos: int, context_node: ref[AstNode], flags: int) returns bool
    {
        if (flags & TefNoSourceMaps) <> 0
            return false
        if this.should_emit_source_maps(context_node) = false
            return false
        if options.omit_brace_source_map_positions
            return false
        (token = KindOpenBraceToken) or (token = KindCloseBraceToken)
    }

    function should_emit_leading_comments(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFNoLeadingComments) = 0

    function should_emit_trailing_comments(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFNoTrailingComments) = 0

    function should_emit_nested_comments(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFNoNestedComments) = 0

    function should_emit_detached_comments(this, node: ref[AstNode]) returns bool
    {
        if node.kind <> KindSourceFile
            return true
        let statements AstNode.statements_of(node)
        if statements = null
            return true
        let st statements as ref[Array[ref[AstNode]?]]
        if (st.get_length() as int) = 0
            return true
        let first st[0]
        if EmitContext.is_prologue_directive(first) = false
            return true
        Printer.node_is_synthesized(first as ref[AstNode])
    }

    function has_comments_at_position(this, pos: int) returns bool
    {
        if current_source_file = null
            return false
        let csf current_source_file as ref[SourceFileInfo]
        if (Scanner.get_trailing_comment_ranges(host, csf.text, pos + 1).get_length() as int) > 0
            return true
        (Scanner.get_leading_comment_ranges(host, csf.text, pos + 1).get_length() as int) > 0
    }

    function should_emit_indirect_call(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFIndirectCall) <> 0

    function should_allow_trailing_comma(this, node: ref[AstNode], list: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if current_source_file = null
            return false
        let csf current_source_file as ref[SourceFileInfo]
        if csf.script_kind = ScriptKindJSON
            return false
        let k node.kind
        if k = KindObjectLiteralExpression
            return true
        if (k = KindArrayLiteralExpression) or (k = KindArrowFunction) or (k = KindConstructor) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration) or (k = KindFunctionType) or (k = KindConstructorType) or (k = KindCallSignature) or (k = KindConstructSignature) or (k = KindTaggedTemplateExpression) or (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern) or (k = KindNamedImports) or (k = KindNamedExports) or (k = KindImportAttributes)
            return true
        if (k = KindClassExpression) or (k = KindClassDeclaration) or (k = KindInterfaceDeclaration)
            return list = AstNode.type_parameters_of(node)
        if (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindMethodDeclaration)
            return true
        if (k = KindCallExpression) or (k = KindNewExpression)
            return true
        false
    }

    ; ── tokens and keywords ──

    procedure write_token_text(this, token: int, write_kind_in: int, pos: int) returns int
    {
        let token_string Scanner.token_to_string(token)
        this.write_as(token_string, write_kind_in)
        if Printer.position_is_synthesized(pos)
            return pos
        pos + (token_string.length as int)
    }

    procedure emit_token(this, token: int, pos: int, write_kind_in: int, context_node: ref[AstNode]) returns int
        this.emit_token_ex(token, pos, write_kind_in, context_node, TefNone)

    procedure emit_token_ex(this, token: int, pos_in: int, write_kind_in: int, context_node: ref[AstNode], flags: int) returns int
    {
        var pos pos_in
        let state this.enter_token(token, &pos, context_node, flags)
        set pos: this.write_token_text(token, write_kind_in, pos)
        this.exit_token(token, pos, context_node, state)
        pos
    }

    procedure emit_keyword_node(this, node: ref[AstNode]?)
        this.emit_keyword_node_ex(node, TefNone)

    procedure emit_keyword_node_ex(this, node: ref[AstNode]?, flags: int)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let state this.enter_token_node(n, flags)
        this.write_token_text(n.kind, WriteKindKeyword, n.pos)
        this.exit_token_node(n, state)
    }

    procedure emit_punctuation_node(this, node: ref[AstNode]?)
        this.emit_punctuation_node_ex(node, TefNone)

    procedure emit_punctuation_node_ex(this, node: ref[AstNode]?, flags: int)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let state this.enter_token_node(n, flags)
        this.write_token_text(n.kind, WriteKindPunctuation, n.pos)
        this.exit_token_node(n, state)
    }

    procedure emit_token_node(this, node: ref[AstNode]?)
        this.emit_token_node_ex(node, TefNone)

    procedure emit_token_node_ex(this, node: ref[AstNode]?, flags: int)
    {
        if node = null
            return
        let n node as ref[AstNode]
        if Printer.is_keyword_kind(n.kind)
        {
            this.emit_keyword_node_ex(node, flags)
            return
        }
        if Printer.is_punctuation_kind(n.kind)
        {
            this.emit_punctuation_node_ex(node, flags)
            return
        }
        ; the reference PANICS ("unexpected TokenNode")
        this.record_unported("emit-token-node-kind", n.kind)
    }

    ; ── literals ──

    procedure emit_literal(this, node: ref[AstNode], flags_in: int)
    {
        var flags flags_in
        if options.never_ascii_escape
            set flags: flags | LiteralTextFlagsNeverAsciiEscape
        if options.terminate_unterminated_literals
            set flags: flags | LiteralTextFlagsTerminateUnterminatedLiterals
        let text this.get_literal_text_of_node(node, null, flags)
        ; Quick info expects every literal through writeStringLiteral
        this.the_writer().write_string_literal(text)
    }

    procedure emit_literal_node(this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_literal(node, LiteralTextFlagsNone)
        this.exit_node(node, state)
    }

    procedure emit_numeric_literal(this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_big_int_literal(this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_string_literal(this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_no_substitution_template_literal(this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_regular_expression_literal(this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_template_head(this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_template_middle(this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_template_tail(this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_template_middle_tail(this, node: ref[AstNode])
    {
        if node.kind = KindTemplateMiddle
            this.emit_template_middle(node)
        else
        {
            if node.kind = KindTemplateTail
                this.emit_template_tail(node)
        }
    }

    ; ── names ──

    procedure emit_identifier_text(this, node: ref[AstNode])
    {
        let text this.get_text_of_node(node, false)
        if id_to_symbol <> null
        {
            let table id_to_symbol as ref[Array[NodeSymbol]]
            var i 0
            while i < (table.get_length() as int)
            {
                let e table[i as size_t]
                if e.node = node
                {
                    this.write_symbol(text, e.symbol)
                    return
                }
                set i: i + 1
            }
        }
        this.write(text)
    }

    procedure emit_identifier_name(this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_identifier_text(node)
        this.exit_node(node, state)
    }

    procedure emit_identifier_name_node(this, node: ref[AstNode]?)
    {
        if node = null
            return
        this.emit_identifier_name(node as ref[AstNode])
    }

    procedure get_unique_helper_name(this, name: Slice[char]) returns ref[AstNode]
    {
        let table unique_helper_names as ref[Array[NameNode]]
        var i 0
        while i < (table.get_length() as int)
        {
            let e table[i as size_t]
            if e.name.equals(name)
                return context.the_factory().clone(e.node)
            set i: i + 1
        }
        let no_affix: Slice[char] ""
        let helper_name context.the_factory().new_unique_name_ex(name, GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic, no_affix, no_affix)
        this.generate_name(helper_name)
        table.add(NameNode(name, helper_name))
        helper_name
    }

    procedure emit_identifier_reference(this, node_in: ref[AstNode])
    {
        var node node_in
        if ((external_helpers_module_name <> null) or (unique_helper_names <> null)) and ((context.emit_flags(node) & EFHelperName) <> 0)
        {
            if external_helpers_module_name <> null
            {
                ; Substitute `__helper` with `tslib_1.__helper`
                let f context.the_factory()
                let helper f.new_property_access_expression(f.clone(external_helpers_module_name as ref[AstNode]), null, f.clone(node), NodeFlagsNone)
                context.assign_comment_and_source_map_ranges(helper, node)
                this.emit_property_access_expression(helper)
                return
            }
            if unique_helper_names <> null
            {
                ; Substitute `__helper` with `__helper_1` if there is a conflict in an ES module.
                let helper_name this.get_unique_helper_name(AstNode.identifier_text_of(node))
                context.assign_comment_and_source_map_ranges(helper_name, node)
                set node: helper_name
            }
        }
        let state this.enter_node(node)
        this.emit_identifier_text(node)
        this.exit_node(node, state)
    }

    procedure emit_binding_identifier(this, node_in: ref[AstNode])
    {
        var node node_in
        if (unique_helper_names <> null) and ((context.emit_flags(node) & EFHelperName) <> 0)
        {
            let helper_name this.get_unique_helper_name(AstNode.identifier_text_of(node))
            context.assign_comment_and_source_map_ranges(helper_name, node)
            set node: helper_name
        }
        let state this.enter_node(node)
        this.emit_identifier_text(node)
        this.exit_node(node, state)
    }

    procedure emit_label_identifier(this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_identifier_text(node)
        this.exit_node(node, state)
    }

    procedure emit_private_identifier(this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write(this.get_text_of_node(node, false))
        this.exit_node(node, state)
    }

    procedure emit_qualified_name(this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_entity_name(AstNode.qualified_left_of(node) as ref[AstNode])
        this.write_punctuation(".")
        this.emit_identifier_name(AstNode.qualified_right_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_computed_property_name(this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("[")
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceDisallowComma)
        this.write_punctuation("]")
        this.exit_node(node, state)
    }

    procedure emit_entity_name(this, node: ref[AstNode])
    {
        let k node.kind
        if k = KindIdentifier
        {
            this.emit_identifier_reference(node)
            return
        }
        if k = KindQualifiedName
        {
            this.emit_qualified_name(node)
            return
        }
        if k = KindPropertyAccessExpression
        {
            ; TypeQuery nodes may carry a PropertyAccessExpression as exprName (typeof foo.x)
            this.emit_expression(node, OperatorPrecedenceDisallowComma)
            return
        }
        ; the reference PANICS ("unexpected EntityName")
        this.record_unported("emit-entity-name-kind", k)
    }

    procedure emit_binding_name(this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let k n.kind
        if k = KindIdentifier
        {
            this.emit_binding_identifier(n)
            return
        }
        if k = KindObjectBindingPattern
        {
            this.emit_object_binding_pattern(n)
            return
        }
        if k = KindArrayBindingPattern
        {
            this.emit_array_binding_pattern(n)
            return
        }
        this.record_unported("emit-binding-name-kind", k)
    }

    procedure emit_property_name(this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let saved_write_kind write_kind
        set this.write_kind: WriteKindProperty
        let k n.kind
        if k = KindIdentifier
            this.emit_identifier_name(n)
        else
        {
            if k = KindPrivateIdentifier
                this.emit_private_identifier(n)
            else
            {
                if k = KindStringLiteral
                    this.emit_string_literal(n)
                else
                {
                    if k = KindNoSubstitutionTemplateLiteral
                        this.emit_no_substitution_template_literal(n)
                    else
                    {
                        if k = KindNumericLiteral
                            this.emit_numeric_literal(n)
                        else
                        {
                            if k = KindBigIntLiteral
                                this.emit_big_int_literal(n)
                            else
                            {
                                if k = KindComputedPropertyName
                                    this.emit_computed_property_name(n)
                                else
                                    this.record_unported("emit-property-name-kind", k)
                            }
                        }
                    }
                }
            }
        }
        set this.write_kind: saved_write_kind
    }

    procedure emit_member_name(this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        if n.kind = KindIdentifier
        {
            this.emit_identifier_name(n)
            return
        }
        if n.kind = KindPrivateIdentifier
        {
            this.emit_private_identifier(n)
            return
        }
        this.record_unported("emit-member-name-kind", n.kind)
    }

    ; ModuleName: a binding identifier or a string literal
    procedure emit_module_name(this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        if n.kind = KindIdentifier
        {
            this.emit_binding_identifier(n)
            return
        }
        if n.kind = KindStringLiteral
        {
            this.emit_string_literal(n)
            return
        }
        this.record_unported("emit-module-name-kind", n.kind)
    }

    ; ModuleExportName, ImportAttributeName and a NESTED module name all read
    ; the identifier as a NAME, not a binding.
    procedure emit_identifier_or_string_literal_name(this, node: ref[AstNode]?, site: Slice[char])
    {
        if node = null
            return
        let n node as ref[AstNode]
        if n.kind = KindIdentifier
        {
            this.emit_identifier_name(n)
            return
        }
        if n.kind = KindStringLiteral
        {
            this.emit_string_literal(n)
            return
        }
        this.record_unported(site, n.kind)
    }

    procedure emit_module_export_name(this, node: ref[AstNode]?)
        this.emit_identifier_or_string_literal_name(node, "emit-module-export-name-kind")

    procedure emit_import_attribute_name(this, node: ref[AstNode])
        this.emit_identifier_or_string_literal_name(node, "emit-import-attribute-name-kind")

    procedure emit_nested_module_name(this, node: ref[AstNode]?)
        this.emit_identifier_or_string_literal_name(node, "emit-nested-module-name-kind")

    ; ── lists ──

    ; NodeList.Pos()/End() off the file's list-range table: (-1, -1) for a
    ; list the table does not know (a synthesized one).
    function list_range(this, list: ref[Array[ref[AstNode]?]]?, out_pos: ref[int], out_end: ref[int])
    {
        set out_pos: 0 - 1
        set out_end: 0 - 1
        if (list = null) or (current_source_file = null)
            return
        let csf current_source_file as ref[SourceFileInfo]
        AstNode.list_range_of(csf.node, list, out_pos, out_end)
    }

    procedure emit_list(this, emit_tag: int, parent_node: ref[AstNode]?, children: ref[Array[ref[AstNode]?]]?, format_in: int)
    {
        var format format_in
        if parent_node <> null
        {
            if this.should_emit_on_multiple_lines(parent_node as ref[AstNode])
                set format: format | LFPreferNewLine | LFIndented
        }
        this.emit_list_range(emit_tag, parent_node, children, format, 0 - 1, 0 - 1)
    }

    procedure emit_list_range(this, emit_tag: int, parent_node: ref[AstNode]?, children: ref[Array[ref[AstNode]?]]?, format: int, start_in: int, count_in: int)
    {
        let is_nil children = null
        var length 0
        if is_nil = false
            set length: (children as ref[Array[ref[AstNode]?]]).get_length() as int
        var start start_in
        if start < 0
            set start: 0
        var count count_in
        if count < 0
            set count: length - start
        if is_nil and ((format & LFOptionalIfNil) <> 0)
            return
        let is_empty is_nil or (start >= length) or (count <= 0)
        if is_empty and ((format & LFOptionalIfEmpty) <> 0)
        {
            this.on_before_emit_node_list(children)
            this.on_after_emit_node_list(children)
            return
        }
        var list_pos 0 - 1
        var list_end 0 - 1
        this.list_range(children, &list_pos, &list_end)
        if (format & LFBracketsMask) <> 0
        {
            this.write_punctuation(this.get_opening_bracket(format))
            if is_empty and (is_nil = false)
                this.emit_trailing_comments(list_pos, CommentSeparatorBefore)
        }
        this.on_before_emit_node_list(children)
        if is_empty
        {
            ; a line terminator if the parent node was multi-line
            var single_line_parent false
            if parent_node = null
                set single_line_parent: true
            else
            {
                if current_source_file <> null
                {
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_is_on_single_line(TextRange.of_node(parent_node as ref[AstNode]), csf.text, csf.line_starts)
                        set single_line_parent: true
                }
            }
            if ((format & LFMultiLine) <> 0) and ((options.preserve_source_newlines and single_line_parent) = false)
                this.write_line()
            else
            {
                if ((format & LFSpaceBetweenBraces) <> 0) and ((format & LFNoSpaceIfEmpty) = 0)
                    this.write_space()
            }
        }
        else
        {
            var end start + count
            if length < end
                set end: length
            let ch children as ref[Array[ref[AstNode]?]]
            this.emit_list_items(emit_tag, parent_node, ch, start, end, format, this.has_trailing_comma(parent_node as ref[AstNode], ch), TextRange(list_pos, list_end))
        }
        this.on_after_emit_node_list(children)
        if (format & LFBracketsMask) <> 0
        {
            if is_empty and (is_nil = false)
                this.emit_leading_comments(list_end, false)
            this.write_punctuation(this.get_closing_bracket(format))
        }
    }

    ; NodeList.HasTrailingComma() is unreliable on transformed nodes; look at the
    ; respective list on the original node first.
    procedure has_trailing_comma(this, parent_node: ref[AstNode], children: ref[Array[ref[AstNode]?]]) returns bool
    {
        let f context.the_factory()
        if f.list_has_trailing_comma(children) = false
            return false
        let original_parent context.most_original(parent_node) as ref[AstNode]
        if original_parent = parent_node
            return true
        if original_parent.kind <> parent_node.kind
            return false
        var original_list: ref[Array[ref[AstNode]?]]? children
        let k original_parent.kind
        if k = KindObjectLiteralExpression
            set original_list: AstNode.properties_of(original_parent)
        else
        {
            if (k = KindArrayLiteralExpression) or (k = KindNamedImports) or (k = KindNamedExports)
                set original_list: AstNode.elements_of(original_parent)
            else
            {
                if (k = KindCallExpression) or (k = KindNewExpression)
                {
                    if children = AstNode.type_arguments_of(parent_node)
                        set original_list: AstNode.type_arguments_of(original_parent)
                    else
                    {
                        if children = AstNode.call_arguments_of(parent_node)
                            set original_list: AstNode.call_arguments_of(original_parent)
                    }
                }
                else
                {
                    if (k = KindConstructor) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindArrowFunction) or (k = KindFunctionType) or (k = KindConstructorType) or (k = KindCallSignature) or (k = KindConstructSignature)
                    {
                        if children = AstNode.type_parameters_of(parent_node)
                            set original_list: AstNode.type_parameters_of(original_parent)
                        else
                        {
                            if children = AstNode.parameters_of(parent_node)
                                set original_list: AstNode.parameters_of(original_parent)
                        }
                    }
                    else
                    {
                        if (k = KindClassDeclaration) or (k = KindClassExpression) or (k = KindInterfaceDeclaration) or (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration)
                        {
                            if children = AstNode.type_parameters_of(parent_node)
                                set original_list: AstNode.type_parameters_of(original_parent)
                        }
                        else
                        {
                            if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern)
                            {
                                if children = AstNode.elements_of(parent_node)
                                    set original_list: AstNode.elements_of(original_parent)
                            }
                            else
                            {
                                if k = KindImportAttributes
                                    set original_list: Printer.import_attributes_elements_of(original_parent)
                            }
                        }
                    }
                }
            }
        }
        if original_list <> null
            return f.list_has_trailing_comma(original_list)
        false
    }

    procedure write_delimiter(this, format: int)
    {
        let d format & LFDelimitersMask
        if d = LFCommaDelimited
        {
            this.write_punctuation(",")
            return
        }
        if d = LFBarDelimited
        {
            this.write_space()
            this.write_punctuation("|")
            return
        }
        if d = LFAsteriskDelimited
        {
            this.write_space()
            this.write_punctuation("*")
            this.write_space()
            return
        }
        if d = LFAmpersandDelimited
        {
            this.write_space()
            this.write_punctuation("&")
        }
    }

    ; Emits a list without brackets or raising events: children[from, to).
    procedure emit_list_items(this, emit_tag: int, parent_node: ref[AstNode]?, children: ref[Array[ref[AstNode]?]], from: int, to: int, format: int, has_trailing_comma: bool, children_text_range: TextRange)
    {
        let may_emit_intervening_comments (format & LFNoInterveningComments) = 0
        var should_emit_intervening_comments may_emit_intervening_comments
        var leading_line_terminator_count 0
        if to > from
            set leading_line_terminator_count: this.get_leading_line_terminator_count(parent_node, children[from as size_t], format)
        if leading_line_terminator_count > 0
        {
            this.write_line_repeat(leading_line_terminator_count)
            set should_emit_intervening_comments: false
        }
        else
        {
            if (format & LFSpaceBetweenBraces) <> 0
                this.write_space()
        }
        if (format & LFIndented) <> 0
            this.increase_indent()
        let parent_end Printer.greatest_end_node(0 - 1, parent_node)
        var previous_sibling: ref[AstNode]? null
        var should_decrease_indent_after_emit false
        var i from
        while i < to
        {
            let child children[i as size_t] as ref[AstNode]
            set i: i + 1
            if (format & LFAsteriskDelimited) <> 0
            {
                ; always write JSDoc in the format "\n *"
                this.write_line()
                this.write_delimiter(format)
            }
            else
            {
                if previous_sibling <> null
                {
                    let prev previous_sibling as ref[AstNode]
                    if ((format & LFDelimitersMask) <> 0) and (prev.end <> parent_end)
                    {
                        if (comments_disabled = false) and this.should_emit_trailing_comments(prev)
                            this.emit_leading_comments(prev.end, false)
                    }
                    this.write_delimiter(format)
                    let separating_line_terminator_count this.get_separating_line_terminator_count(previous_sibling, child, format)
                    if separating_line_terminator_count > 0
                    {
                        ; a synthesized node in a single-line list that starts on a new line indents
                        if (format & (LFLinesMask | LFIndented)) = LFSingleLine
                        {
                            this.increase_indent()
                            set should_decrease_indent_after_emit: true
                        }
                        if should_emit_intervening_comments and ((format & LFDelimitersMask) <> 0) and (Printer.position_is_synthesized(child.pos) = false) and this.should_emit_leading_comments(child)
                        {
                            let comment_range context.comment_range(child)
                            this.emit_trailing_comments_of_position(comment_range.pos, (format & LFSpaceBetweenSiblings) <> 0, true)
                        }
                        this.write_line_repeat(separating_line_terminator_count)
                        set should_emit_intervening_comments: false
                    }
                    else
                    {
                        if (format & LFSpaceBetweenSiblings) <> 0
                            this.write_space()
                    }
                }
            }
            ; this child
            if should_emit_intervening_comments and this.should_emit_leading_comments(child)
            {
                let comment_range context.comment_range(child)
                this.emit_trailing_comments_of_position(comment_range.pos, false, false)
            }
            else
                set should_emit_intervening_comments: may_emit_intervening_comments
            set this.next_list_element_pos: child.pos
            this.emit_tagged(emit_tag, child)
            if should_decrease_indent_after_emit
            {
                this.decrease_indent()
                set should_decrease_indent_after_emit: false
            }
            set previous_sibling: child
        }
        ; a trailing comma, if requested
        var skip_trailing_comments comments_disabled
        if previous_sibling <> null
        {
            if this.should_emit_trailing_comments(previous_sibling as ref[AstNode]) = false
                set skip_trailing_comments: true
        }
        let emit_trailing_comma has_trailing_comma and ((format & LFAllowTrailingComma) <> 0) and ((format & LFCommaDelimited) <> 0)
        if emit_trailing_comma
        {
            if (previous_sibling <> null) and (skip_trailing_comments = false)
            {
                let prev previous_sibling as ref[AstNode]
                this.emit_token(KindCommaToken, prev.end, WriteKindPunctuation, prev)
            }
            else
                this.write_punctuation(",")
        }
        ; the trailing comment of the last element
        if previous_sibling <> null
        {
            let prev previous_sibling as ref[AstNode]
            if (parent_end <> prev.end) and ((format & LFDelimitersMask) <> 0) and (skip_trailing_comments = false)
            {
                var comments_pos prev.end
                if emit_trailing_comma and (children_text_range.end > 0)
                    set comments_pos: children_text_range.end
                this.emit_leading_comments(comments_pos, false)
            }
        }
        if (format & LFIndented) <> 0
            this.decrease_indent()
        var last: ref[AstNode]? null
        if to > from
            set last: children[(to - 1) as size_t]
        let closing_line_terminator_count this.get_closing_line_terminator_count(parent_node, last, format, children_text_range)
        if closing_line_terminator_count > 0
            this.write_line_repeat(closing_line_terminator_count)
        else
        {
            if (format & (LFSpaceAfterList | LFSpaceBetweenBraces)) <> 0
                this.write_space()
        }
    }

    ; The `emit func(p, node)` of a list, by tag (§3.18). The tags arrive with
    ; the emitters that use them (slices 234/235); an unknown tag is a said stop.
    procedure emit_tagged(this, emit_tag: int, node: ref[AstNode])
        this.record_unported("emit-list-tag", emit_tag)

    ; ── general ──

    procedure emit(this, node: ref[AstNode], file: ref[SourceFileInfo]?) returns String
    {
        if own_writer = null
            set this.own_writer: TextWriter.create(host, options.new_line_character(), 0)
        let w own_writer as ref[TextWriter]
        this.write_node(node, file, w, null)
        let text w.to_string()
        w.clear(host)
        text
    }

    procedure emit_source_file_text(this, file: ref[SourceFileInfo]) returns String
        this.emit(file.node, file)

    procedure set_source_file(this, file: ref[SourceFileInfo]?)
    {
        set this.current_source_file: file
        set this.unique_helper_names: null
        set this.external_helpers_module_name: null
        if file <> null
        {
            let f file as ref[SourceFileInfo]
            let mo context.most_original(f.node) as ref[AstNode]
            if (context.emit_flags(mo) & EFExternalHelpers) <> 0
                set this.unique_helper_names: &Array[NameNode]^host()
            set this.external_helpers_module_name: context.get_external_helpers_module_name(f.node)
            this.set_source_map_source(f)
        }
    }

    ; Printer.Write
    procedure write_node(this, node: ref[AstNode], file: ref[SourceFileInfo]?, writer_in: ref[TextWriter], source_map_generator_in: ref[SourceMapGenerator]?)
    {
        let saved_current_source_file current_source_file
        let saved_writer writer
        let saved_unique_helper_names unique_helper_names
        let saved_source_maps_disabled source_maps_disabled
        let saved_source_map_generator source_map_generator
        let saved_source_map_source source_map_source
        let saved_source_map_source_index source_map_source_index
        let saved_source_map_line_char_cache source_map_line_char_cache
        set this.source_maps_disabled: source_map_generator_in = null
        set this.source_map_generator: source_map_generator_in
        set this.source_map_source: null
        set this.source_map_source_index: 0 - 1
        set this.source_map_line_char_cache: null
        this.set_source_file(file)
        set this.writer: writer_in
        writer_in.clear(host)
        this.write_node_by_kind(node)
        set this.current_source_file: saved_current_source_file
        set this.writer: saved_writer
        set this.unique_helper_names: saved_unique_helper_names
        set this.source_maps_disabled: saved_source_maps_disabled
        set this.source_map_generator: saved_source_map_generator
        set this.source_map_source: saved_source_map_source
        set this.source_map_source_index: saved_source_map_source_index
        set this.source_map_line_char_cache: saved_source_map_line_char_cache
    }

    ; Write's switch. GENERATED-LIKE: one arm per kind the reference lists, in
    ; its order; the arms whose emitter has not landed reach `emit_unported`
    ; through their stub.
    procedure write_node_by_kind(this, node: ref[AstNode])
    {
        let k node.kind
        if k = KindTemplateHead { this.emit_template_head(node)  return }
        if k = KindTemplateMiddle { this.emit_template_middle(node)  return }
        if k = KindTemplateTail { this.emit_template_tail(node)  return }
        if k = KindIdentifier { this.emit_identifier_name(node)  return }
        if k = KindPrivateIdentifier { this.emit_private_identifier(node)  return }
        if k = KindQualifiedName { this.emit_qualified_name(node)  return }
        if k = KindComputedPropertyName { this.emit_computed_property_name(node)  return }
        if k = KindTypeParameter { this.emit_type_parameter(node)  return }
        if k = KindParameter { this.emit_parameter(node)  return }
        if k = KindDecorator { this.emit_decorator(node)  return }
        if k = KindPropertySignature { this.emit_property_signature(node)  return }
        if k = KindPropertyDeclaration { this.emit_property_declaration(node)  return }
        if k = KindMethodSignature { this.emit_method_signature(node)  return }
        if k = KindMethodDeclaration { this.emit_method_declaration(node)  return }
        if k = KindClassStaticBlockDeclaration { this.emit_class_static_block_declaration(node)  return }
        if k = KindConstructor { this.emit_constructor(node)  return }
        if k = KindGetAccessor { this.emit_get_accessor_declaration(node)  return }
        if k = KindSetAccessor { this.emit_set_accessor_declaration(node)  return }
        if k = KindCallSignature { this.emit_call_signature(node)  return }
        if k = KindConstructSignature { this.emit_construct_signature(node)  return }
        if k = KindIndexSignature { this.emit_index_signature(node)  return }
        if k = KindObjectBindingPattern { this.emit_object_binding_pattern(node)  return }
        if k = KindArrayBindingPattern { this.emit_array_binding_pattern(node)  return }
        if k = KindBindingElement { this.emit_binding_element(node)  return }
        if k = KindTemplateSpan { this.emit_template_span(node)  return }
        if k = KindSemicolonClassElement { this.emit_semicolon_class_element(node)  return }
        if k = KindVariableDeclaration { this.emit_variable_declaration(node)  return }
        if k = KindVariableDeclarationList { this.emit_variable_declaration_list(node)  return }
        if k = KindModuleBlock { this.emit_module_block(node)  return }
        if k = KindCaseBlock { this.emit_case_block(node)  return }
        if k = KindImportClause { this.emit_import_clause(node)  return }
        if k = KindNamespaceImport { this.emit_namespace_import(node)  return }
        if k = KindNamespaceExport { this.emit_namespace_export(node)  return }
        if k = KindNamedImports { this.emit_named_imports(node)  return }
        if k = KindImportSpecifier { this.emit_import_specifier(node)  return }
        if k = KindNamedExports { this.emit_named_exports(node)  return }
        if k = KindExportSpecifier { this.emit_export_specifier(node)  return }
        if k = KindImportAttributes { this.emit_import_attributes(node)  return }
        if k = KindImportAttribute { this.emit_import_attribute(node)  return }
        if k = KindExternalModuleReference { this.emit_external_module_reference(node)  return }
        if k = KindJsxText { this.emit_jsx_text(node)  return }
        if k = KindJsxOpeningElement { this.emit_jsx_opening_element(node)  return }
        if k = KindJsxOpeningFragment { this.emit_jsx_opening_fragment(node)  return }
        if k = KindJsxClosingElement { this.emit_jsx_closing_element(node)  return }
        if k = KindJsxClosingFragment { this.emit_jsx_closing_fragment(node)  return }
        if k = KindJsxAttribute { this.emit_jsx_attribute(node)  return }
        if k = KindJsxAttributes { this.emit_jsx_attributes(node)  return }
        if k = KindJsxSpreadAttribute { this.emit_jsx_spread_attribute(node)  return }
        if k = KindJsxExpression { this.emit_jsx_expression(node)  return }
        if k = KindJsxNamespacedName { this.emit_jsx_namespaced_name(node)  return }
        if k = KindCaseClause { this.emit_case_clause(node)  return }
        if k = KindDefaultClause { this.emit_default_clause(node)  return }
        if k = KindHeritageClause { this.emit_heritage_clause(node)  return }
        if k = KindCatchClause { this.emit_catch_clause(node)  return }
        if k = KindPropertyAssignment { this.emit_property_assignment(node)  return }
        if k = KindShorthandPropertyAssignment { this.emit_shorthand_property_assignment(node)  return }
        if k = KindSpreadAssignment { this.emit_spread_assignment(node)  return }
        if k = KindEnumMember { this.emit_enum_member(node)  return }
        if k = KindSourceFile { this.emit_source_file(node)  return }
        if k = KindNotEmittedTypeElement { this.emit_not_emitted_type_element(node)  return }
        if AstNode.is_type_node_kind(k) { this.emit_type_node_outside_extends(node)  return }
        if Checker.is_statement(node) { this.emit_statement(node)  return }
        if AstNode.is_expression_node(node) { this.emit_expression(node, OperatorPrecedenceLowest)  return }
        if Printer.is_keyword_kind(k) { this.emit_keyword_node(node)  return }
        if Printer.is_punctuation_kind(k) { this.emit_punctuation_node(node)  return }
        if Printer.is_jsdoc_kind(k) { this.emit_jsdoc_node(node)  return }
        ; the reference PANICS ("unhandled Node")
        this.record_unported("write-node-kind", k)
    }

    ; ── comments ──

    procedure emit_comments_before_node(this, node: ref[AstNode]) returns CommentState
    {
        if this.should_emit_comments(node) = false
            return CommentState.none()
        let emit_flags context.emit_flags(node)
        let comment_range context.comment_range(node)
        let saved_container_pos container_pos
        let saved_container_end container_end
        let saved_declaration_list_container_end declaration_list_container_end
        this.emit_leading_comments_of_node(node, emit_flags, comment_range)
        this.emit_leading_synthetic_comments_of_node(node, emit_flags)
        if (emit_flags & EFNoNestedComments) <> 0
            set this.comments_disabled: true
        CommentState(true, emit_flags, comment_range, saved_container_pos, saved_container_end, saved_declaration_list_container_end)
    }

    procedure emit_comments_after_node(this, node: ref[AstNode], state: CommentState)
    {
        if state.present = false
            return
        let emit_flags state.emit_flags
        if (emit_flags & EFNoNestedComments) <> 0
            set this.comments_disabled: false
        this.emit_trailing_synthetic_comments_of_node(node, emit_flags)
        this.emit_trailing_comments_of_node(node, emit_flags, state.comment_range, state.container_pos, state.container_end, state.declaration_list_container_end)
        ; comments of an erased type annotation
        let type_node context.get_type_node(node)
        if type_node <> null
            this.emit_trailing_comments_of_node(node, emit_flags, TextRange.of_node(type_node as ref[AstNode]), state.container_pos, state.container_end, state.declaration_list_container_end)
    }

    ; `pos` is in/out: the token position after trivia.
    procedure emit_comments_before_token(this, token: int, pos: ref[int], context_node: ref[AstNode], flags: int) returns CommentState
    {
        if ((flags & TefNoComments) <> 0) or comments_disabled
        {
            ; still skip trivia so the returned pos identifies the token
            if (current_source_file <> null) and (Printer.position_is_synthesized(pos) = false)
                set pos: Scanner.skip_trivia(this.file_text(), pos)
            return CommentState.none()
        }
        let start_pos pos
        if current_source_file <> null
            set pos: Scanner.skip_trivia(this.file_text(), start_pos)
        let node context.parse_node(context_node)
        var is_similar_node false
        if node <> null
        {
            if (node as ref[AstNode]).kind = context_node.kind
                set is_similar_node: true
        }
        if is_similar_node = false
            return CommentState.none()
        if context_node.pos <> start_pos
        {
            let indent_leading (flags & TefIndentLeadingComments) <> 0
            var needs_indent false
            if indent_leading and (current_source_file <> null)
            {
                if Printer.positions_are_on_same_line(start_pos, pos, this.file_lines()) = false
                    set needs_indent: true
            }
            this.increase_indent_if(needs_indent)
            this.emit_leading_comments(start_pos, false)
            this.decrease_indent_if(needs_indent)
        }
        CommentState.blank()
    }

    procedure emit_comments_after_token(this, token: int, pos: int, context_node: ref[AstNode], state: CommentState)
    {
        if state.present = false
            return
        if context_node.end <> pos
        {
            var separator CommentSeparatorBefore
            if context_node.kind = KindJsxExpression
                set separator: CommentSeparatorNone
            this.emit_trailing_comments(pos, separator)
        }
    }

    procedure emit_detached_comments_before_statement_list(this, node: ref[AstNode], detached_range: TextRange) returns CommentState
    {
        if this.should_emit_detached_comments(node) = false
            return CommentState.none()
        let emit_flags context.emit_flags(node)
        let saved_container_pos container_pos
        let saved_container_end container_end
        let saved_declaration_list_container_end declaration_list_container_end
        let skip_leading_comments Printer.position_is_synthesized(detached_range.pos) or ((emit_flags & EFNoLeadingComments) <> 0)
        if skip_leading_comments = false
            this.emit_detached_comments_and_update_comments_info(detached_range)
        if (emit_flags & EFNoNestedComments) <> 0
            set this.comments_disabled: true
        CommentState(true, emit_flags, detached_range, saved_container_pos, saved_container_end, saved_declaration_list_container_end)
    }

    procedure emit_detached_comments_after_statement_list(this, node: ref[AstNode], detached_range: TextRange, state: CommentState)
    {
        if state.present = false
            return
        let emit_flags state.emit_flags
        let skip_trailing_comments comments_disabled or Printer.position_is_synthesized(detached_range.end) or ((emit_flags & EFNoTrailingComments) <> 0)
        if skip_trailing_comments = false
        {
            let has_written_comment this.emit_leading_comments(detached_range.end, false)
            if has_written_comment and (this.the_writer().is_at_start_of_line() = false)
                this.write_line()
        }
    }

    procedure emit_leading_comments_of_node(this, node: ref[AstNode], emit_flags: int, comment_range: TextRange)
    {
        let pos comment_range.pos
        let end comment_range.end
        if ((Printer.position_is_synthesized(pos) = false) or (Printer.position_is_synthesized(end) = false)) and (pos <> end)
        {
            ; JsxText is checked explicitly: under jsx "preserve" nothing transforms it
            let skip_leading_comments Printer.position_is_synthesized(pos) or ((emit_flags & EFNoLeadingComments) <> 0) or (node.kind = KindJsxText)
            let skip_trailing_comments Printer.position_is_synthesized(end) or ((emit_flags & EFNoTrailingComments) <> 0) or (node.kind = KindJsxText)
            if skip_leading_comments = false
                this.emit_leading_comments(pos, node.kind = KindNotEmittedStatement)
            if (skip_leading_comments = false) or ((pos >= 0) and ((emit_flags & EFNoLeadingComments) <> 0))
                set this.container_pos: pos
            if (skip_trailing_comments = false) or ((end >= 0) and ((emit_flags & EFNoTrailingComments) <> 0))
            {
                set this.container_end: end
                ; the last declaration list container's end, against a down-level binding pattern
                if node.kind = KindVariableDeclarationList
                    set this.declaration_list_container_end: end
            }
        }
    }

    procedure emit_trailing_comments_of_node(this, node: ref[AstNode], emit_flags: int, comment_range: TextRange, saved_container_pos: int, saved_container_end: int, saved_declaration_list_container_end: int)
    {
        let pos comment_range.pos
        let end comment_range.end
        let skip_trailing_comments (end < 0) or ((emit_flags & EFNoTrailingComments) <> 0) or (node.kind = KindJsxText)
        if ((Printer.position_is_synthesized(pos) = false) or (Printer.position_is_synthesized(end) = false)) and (pos <> end)
        {
            set this.container_pos: saved_container_pos
            set this.container_end: saved_container_end
            set this.declaration_list_container_end: saved_declaration_list_container_end
            if (skip_trailing_comments = false) and (node.kind <> KindNotEmittedStatement)
                this.emit_trailing_comments(end, CommentSeparatorBefore)
        }
    }

    procedure emit_leading_synthetic_comments_of_node(this, node: ref[AstNode], emit_flags: int)
    {
        if (emit_flags & EFNoLeadingComments) <> 0
            return
        let synth context.get_synthetic_leading_comments(node)
        if synth = null
            return
        let list synth as ref[Array[SynthesizedComment]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.emit_leading_synthesized_comment(list[i as size_t])
            set i: i + 1
        }
    }

    procedure emit_leading_synthesized_comment(this, comment: SynthesizedComment)
    {
        let w this.the_writer()
        if comment.has_leading_new_line or (comment.kind = KindSingleLineCommentTrivia)
            w.write_line()
        this.write_synthesized_comment(comment)
        if comment.has_trailing_new_line or (comment.kind = KindSingleLineCommentTrivia)
            w.write_line()
        else
            w.write_space(" ")
    }

    procedure emit_trailing_synthetic_comments_of_node(this, node: ref[AstNode], emit_flags: int)
    {
        if (emit_flags & EFNoTrailingComments) <> 0
            return
        let synth context.get_synthetic_trailing_comments(node)
        if synth = null
            return
        let list synth as ref[Array[SynthesizedComment]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.emit_trailing_synthesized_comment(list[i as size_t])
            set i: i + 1
        }
    }

    procedure emit_trailing_synthesized_comment(this, comment: SynthesizedComment)
    {
        let w this.the_writer()
        if w.is_at_start_of_line() = false
            w.write_space(" ")
        this.write_synthesized_comment(comment)
        if comment.has_trailing_new_line
            w.write_line()
    }

    function format_synthesized_comment(host: ref[Page], comment: SynthesizedComment) returns String
    {
        let b StringBuilder^host()
        if comment.kind = KindMultiLineCommentTrivia
        {
            b.append("/*")
            b.append(comment.text.data, comment.text.length)
            b.append("*/")
            return b.to_string()
        }
        b.append("//")
        b.append(comment.text.data, comment.text.length)
        b.to_string()
    }

    procedure write_synthesized_comment(this, comment: SynthesizedComment)
    {
        let text Printer.slice_of(Printer.format_synthesized_comment(host, comment))
        var line_map: ref[Array[int]]? null
        if comment.kind = KindMultiLineCommentTrivia
            set line_map: Printer.compute_ecma_line_starts(host, text)
        this.write_comment_range_worker(text, line_map, comment.kind, 0, text.length as int)
    }

    procedure emit_leading_comments(this, pos_in: int, elided: bool) returns bool
    {
        ; only when the container's pos does not match: the container emits those
        if comments_disabled or (current_source_file = null) or Printer.position_is_synthesized(pos_in) or (pos_in = container_pos)
            return false
        let csf current_source_file as ref[SourceFileInfo]
        var triple_slash TristateUnknown
        if elided = false
        {
            if (pos_in = 0) and csf.is_declaration_file
                set triple_slash: TristateFalse
        }
        else
        {
            ; a node not emitted in JS drops every comment but a triple-slash at the top of the file
            if pos_in = 0
                set triple_slash: TristateTrue
            else
                return false
        }
        var pos pos_in
        ; skip detached comments
        if detached_depth > 0
        {
            let info detached_comments_info[(detached_depth - 1) as size_t]
            if info.node_pos = pos
            {
                set this.detached_depth: detached_depth - 1
                set pos: info.detached_comment_end_pos
            }
        }
        let all Scanner.get_leading_comment_ranges(host, csf.text, pos)
        let comments &Array[CommentRange]^host()
        var i 0
        while i < (all.get_length() as int)
        {
            let c all[i as size_t]
            if this.should_write_comment(c) and this.should_emit_comment_if_triple_slash(c, triple_slash)
                comments.add(c)
            set i: i + 1
        }
        if (comments.get_length() as int) > 0
        {
            let first comments[0]
            if this.should_emit_new_line_before_leading_comment_of_position(pos, first.pos)
                this.write_line()
        }
        ; leading comments are /*leading comment1*/space/*leading comment*/space
        this.emit_comments(comments, CommentSeparatorAfter)
    }

    function should_emit_comment_if_triple_slash(this, comment: CommentRange, triple_slash: int) returns bool
    {
        if triple_slash = TristateTrue
            return this.is_triple_slash_comment(comment)
        if triple_slash = TristateFalse
            return this.is_triple_slash_comment(comment) = false
        true
    }

    ; a new line when the leading comments start on a different line than the node
    function should_emit_new_line_before_leading_comment_of_position(this, pos: int, comment_pos: int) returns bool
    {
        if current_source_file = null
            return false
        if pos = comment_pos
            return false
        let lines this.file_lines()
        Scanner.compute_line_of_position(lines, pos) <> Scanner.compute_line_of_position(lines, comment_pos)
    }

    procedure emit_leading_comments_of_position(this, pos: int)
    {
        if comments_disabled or (pos = 0 - 1)
            return
        this.emit_leading_comments(pos, false)
    }

    procedure emit_trailing_comments(this, pos: int, comment_separator: int)
    {
        if comments_disabled or (current_source_file = null)
            return
        ; only when the container's end does not match: the container emits those
        if (container_end <> 0 - 1) and ((pos = container_end) or (pos = declaration_list_container_end))
            return
        let all Scanner.get_trailing_comment_ranges(host, this.file_text(), pos)
        let comments &Array[CommentRange]^host()
        var i 0
        while i < (all.get_length() as int)
        {
            let c all[i as size_t]
            if this.should_write_comment(c)
                comments.add(c)
            set i: i + 1
        }
        ; trailing comments are space/*trailing comment1*/space/*trailing comment2*/
        this.emit_comments(comments, comment_separator)
    }

    procedure emit_trailing_comments_of_position(this, pos: int, prefix_space: bool, force_no_newline: bool)
    {
        if comments_disabled or (current_source_file = null)
            return
        if (container_end <> 0 - 1) and ((pos = container_end) or (pos = declaration_list_container_end))
            return
        let comments Scanner.get_trailing_comment_ranges(host, this.file_text(), pos)
        var i 0
        while i < (comments.get_length() as int)
        {
            let comment comments[i as size_t]
            set i: i + 1
            if prefix_space
            {
                if this.should_write_comment(comment) = false
                    continue
                if this.the_writer().is_at_start_of_line() = false
                    this.write_space()
                this.emit_comment(comment)
                if comment.has_trailing_new_line
                    this.write_line()
                continue
            }
            this.emit_comment(comment)
            if force_no_newline
            {
                if comment.kind = KindSingleLineCommentTrivia
                    this.write_line()
            }
            else
            {
                if comment.has_trailing_new_line
                    this.write_line()
                else
                    this.write_space()
            }
        }
    }

    procedure emit_detached_comments_and_update_comments_info(this, text_range: TextRange)
    {
        if current_source_file = null
            return
        var node_pos 0
        var end_pos 0
        if this.emit_detached_comments(text_range, &node_pos, &end_pos)
        {
            ; push
            if detached_depth < (detached_comments_info.get_length() as int)
                detached_comments_info.put(detached_depth as size_t, DetachedCommentsInfo(node_pos, end_pos))
            else
                detached_comments_info.add(DetachedCommentsInfo(node_pos, end_pos))
            set this.detached_depth: detached_depth + 1
        }
    }

    ; The copyright-header rule: leading comments with no blank line between
    ; them, followed by at least one blank line before the node.
    procedure emit_detached_comments(this, text_range: TextRange, out_node_pos: ref[int], out_end_pos: ref[int]) returns bool
    {
        if current_source_file = null
            return false
        let csf current_source_file as ref[SourceFileInfo]
        let text csf.text
        let line_map csf.line_starts
        var leading_comments: ref[Array[CommentRange]]? null
        if comments_disabled
        {
            ; removeComments: only a pinned comment at the top of the file
            if text_range.pos = 0
            {
                let all Scanner.get_leading_comment_ranges(host, text, text_range.pos)
                let pinned &Array[CommentRange]^host()
                var i 0
                while i < (all.get_length() as int)
                {
                    let c all[i as size_t]
                    if Printer.is_pinned_comment(text, c)
                        pinned.add(c)
                    set i: i + 1
                }
                set leading_comments: pinned
            }
        }
        else
            set leading_comments: Scanner.get_leading_comment_ranges(host, text, text_range.pos)
        if leading_comments = null
            return false
        let lc leading_comments as ref[Array[CommentRange]]
        if (lc.get_length() as int) = 0
            return false
        let detached_comments &Array[CommentRange]^host()
        var last_comment_end 0
        var i 0
        while i < (lc.get_length() as int)
        {
            let comment lc[i as size_t]
            if i > 0
            {
                let last_comment_line Scanner.compute_line_of_position(line_map, last_comment_end)
                let comment_line Scanner.compute_line_of_position(line_map, comment.pos)
                if comment_line >= last_comment_line + 2
                    break
            }
            detached_comments.add(comment)
            set last_comment_end: comment.end
            set i: i + 1
        }
        let n detached_comments.get_length() as int
        if n = 0
            return false
        let last_detached detached_comments[(n - 1) as size_t]
        let last_comment_line Scanner.compute_line_of_position(line_map, last_detached.end)
        let node_line Scanner.compute_line_of_position(line_map, Scanner.skip_trivia(text, text_range.pos))
        if node_line < last_comment_line + 2
            return false
        ; valid detached comments: those that should be written
        let comments_to_emit &Array[CommentRange]^host()
        var j 0
        while j < n
        {
            let c detached_comments[j as size_t]
            if this.should_write_comment(c)
                comments_to_emit.add(c)
            set j: j + 1
        }
        if (comments_to_emit.get_length() as int) > 0
        {
            let first comments_to_emit[0]
            if this.should_emit_new_line_before_leading_comment_of_position(text_range.pos, first.pos)
                this.write_line()
            this.emit_comments(comments_to_emit, CommentSeparatorAfter)
        }
        set out_node_pos: text_range.pos
        set out_end_pos: last_detached.end
        true
    }

    procedure emit_comments(this, comments: ref[Array[CommentRange]], comment_separator: int) returns bool
    {
        var intervening_separator false
        if (comments.get_length() as int) = 0
            return false
        if comment_separator = CommentSeparatorBefore
            this.write_space()
        var i 0
        while i < (comments.get_length() as int)
        {
            let comment comments[i as size_t]
            set i: i + 1
            if intervening_separator
            {
                this.write_space()
                set intervening_separator: false
            }
            this.emit_comment(comment)
            if (comment.kind = KindSingleLineCommentTrivia) or (comment.has_trailing_new_line and (comment_separator <> CommentSeparatorNone))
                this.write_line()
            else
                set intervening_separator: comment_separator <> CommentSeparatorNone
        }
        if intervening_separator and (comment_separator = CommentSeparatorAfter)
            this.write_space()
        true
    }

    procedure emit_comment(this, comment: CommentRange)
    {
        this.emit_pos(comment.pos)
        this.write_comment_range(comment)
        this.emit_pos(comment.end)
    }

    function is_triple_slash_comment(this, comment: CommentRange) returns bool
    {
        if current_source_file = null
            return false
        Printer.is_recognized_triple_slash_comment(this.file_text(), comment)
    }

    ; ── source maps ──

    procedure set_source_map_source(this, source: ref[SourceFileInfo])
    {
        if source_maps_disabled
            return
        set this.source_map_source: source
        set this.source_map_line_char_cache: LineCharacterCache.create(host, source.line_starts, source.text)
        if most_recent_source_map_source = source
        {
            set this.source_map_source_index: most_recent_source_map_source_index
            return
        }
        set this.source_map_source_is_json: source.file_name.ends_with(".json")
        if source_map_source_is_json
            return
        let gen source_map_generator as ref[SourceMapGenerator]
        set this.source_map_source_index: gen.add_source(source.file_name)
        if options.inline_sources
            gen.set_source_content(source_map_source_index, source.text)
        set this.most_recent_source_map_source: source
        set this.most_recent_source_map_source_index: source_map_source_index
    }

    procedure emit_pos(this, pos: int)
    {
        if source_maps_disabled or (source_map_source = null) or (source_map_generator = null) or source_map_source_is_json or Printer.position_is_synthesized(pos)
            return
        let cache source_map_line_char_cache as ref[LineCharacterCache]
        var source_line 0
        var source_character 0
        cache.get_line_and_character(pos, &source_line, &source_character)
        let gen source_map_generator as ref[SourceMapGenerator]
        let w this.the_writer()
        gen.add_source_mapping(w.get_line(), w.get_column(), source_map_source_index, source_line, source_character)
    }

    procedure emit_source_pos(this, source: ref[SourceFileInfo]?, pos: int)
    {
        if source <> source_map_source
        {
            let saved_source_map_source source_map_source
            let saved_source_map_source_index source_map_source_index
            let saved_source_map_line_char_cache source_map_line_char_cache
            if source <> null
                this.set_source_map_source(source as ref[SourceFileInfo])
            this.emit_pos(pos)
            set this.source_map_source: saved_source_map_source
            set this.source_map_source_index: saved_source_map_source_index
            set this.source_map_line_char_cache: saved_source_map_line_char_cache
            return
        }
        this.emit_pos(pos)
    }

    procedure emit_source_maps_before_node(this, node: ref[AstNode]) returns SourceMapState
    {
        if this.should_emit_source_maps(node) = false
            return SourceMapState.none()
        let emit_flags context.emit_flags(node)
        let loc context.source_map_range(node)
        if (node.kind <> KindNotEmittedStatement) and ((emit_flags & EFNoLeadingSourceMap) = 0) and (current_source_file <> null) and (Printer.position_is_synthesized(loc.pos) = false)
            this.emit_source_pos(source_map_source, Scanner.skip_trivia(this.file_text(), loc.pos))
        if (emit_flags & EFNoNestedSourceMaps) <> 0
            set this.source_maps_disabled: true
        SourceMapState(true, emit_flags, loc, false)
    }

    procedure emit_source_maps_after_node(this, node: ref[AstNode], previous_state: SourceMapState)
    {
        if previous_state.present = false
            return
        let emit_flags previous_state.emit_flags
        let loc previous_state.source_map_range
        if (emit_flags & EFNoNestedSourceMaps) <> 0
            set this.source_maps_disabled: false
        if (node.kind <> KindNotEmittedStatement) and ((emit_flags & EFNoTrailingSourceMap) = 0) and (Printer.position_is_synthesized(loc.end) = false)
            this.emit_source_pos(source_map_source, loc.end)
    }

    procedure emit_source_maps_before_token(this, token: int, pos_in: int, context_node: ref[AstNode], flags: int) returns SourceMapState
    {
        if this.should_emit_token_source_maps(token, pos_in, context_node, flags) = false
            return SourceMapState.none()
        let emit_flags context.emit_flags(context_node)
        var loc TextRange.undefined_range()
        let has_loc context.token_source_map_range(context_node, token, &loc)
        var pos pos_in
        if has_loc
            set pos: loc.pos
        if (pos >= 0) and (current_source_file <> null)
            set pos: Scanner.skip_trivia(this.file_text(), pos)
        if ((emit_flags & EFNoTokenLeadingSourceMaps) = 0) and (pos >= 0)
            this.emit_source_pos(source_map_source, pos)
        SourceMapState(true, emit_flags, loc, has_loc)
    }

    procedure emit_source_maps_after_token(this, token: int, pos_in: int, context_node: ref[AstNode], previous_state: SourceMapState)
    {
        if previous_state.present = false
            return
        let emit_flags previous_state.emit_flags
        let loc previous_state.source_map_range
        if (emit_flags & EFNoTokenTrailingSourceMaps) = 0
        {
            var pos pos_in
            if previous_state.has_token_source_map_range
                set pos: loc.end
            if pos >= 0
                this.emit_source_pos(source_map_source, pos)
        }
    }

    ; ── name generation ──

    function should_reuse_temp_variable_scope(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        (context.emit_flags(node as ref[AstNode]) & EFReuseTempVariableScope) <> 0
    }

    procedure push_name_generation_scope(this, node: ref[AstNode]?)
        name_generator.push_scope(this.should_reuse_temp_variable_scope(node))

    procedure pop_name_generation_scope(this, node: ref[AstNode]?)
        name_generator.pop_scope(this.should_reuse_temp_variable_scope(node))

    procedure generate_all_names(this, nodes: ref[Array[ref[AstNode]?]]?)
    {
        if nodes = null
            return
        let list nodes as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.generate_names(list[i as size_t])
            set i: i + 1
        }
    }

    function import_attributes_elements_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when ia: ImportAttributes return ia.attributes
            else return null
    }

    ; core.ComputeECMALineStarts: the ECMAScript line terminators (CR LF, CR,
    ; LF, U+2028, U+2029), the start of every line and of the trailing one.
    function compute_ecma_line_starts(host: ref[Page], text: Slice[char]) returns ref[Array[int]]
    {
        let result &Array[int]^host()
        let n text.length as int
        var pos 0
        var line_start 0
        while pos < n
        {
            let b text[pos as size_t] as int
            if b < 128
            {
                set pos: pos + 1
                if b = 13
                {
                    if (pos < n) and ((text[pos as size_t] as int) = 10)
                        set pos: pos + 1
                    result.add(line_start)
                    set line_start: pos
                }
                else
                {
                    if b = 10
                    {
                        result.add(line_start)
                        set line_start: pos
                    }
                }
            }
            else
            {
                let size Scanner.utf8_size_in(text, n, pos)
                let ch Scanner.utf8_decode_in(text, n, pos)
                set pos: pos + size
                if (ch = 8232) or (ch = 8233)
                {
                    result.add(line_start)
                    set line_start: pos
                }
            }
        }
        result.add(line_start)
        result
    }

    ; the four child accessors the walk needs that ast.scaly does not export
    function case_block_clauses_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when cb: CaseBlock return cb.elements
            else return null
    }

    function catch_variable_declaration_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when cc: CatchClause return cc.variable_declaration
            else return null
    }

    function catch_block_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when cc: CatchClause return cc.block
            else return null
    }

    function declaration_list_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when vs: VariableStatement return vs.declaration_list
            else return null
    }

    function declarations_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when vl: VariableDeclarationList return vl.declarations
            else return null
    }

    procedure generate_names(this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let k n.kind
        if (k = KindBlock) or (k = KindCaseClause) or (k = KindDefaultClause)
        {
            this.generate_all_names(AstNode.statements_of(n))
            return
        }
        if (k = KindLabeledStatement) or (k = KindWithStatement) or (k = KindDoStatement) or (k = KindWhileStatement)
        {
            this.generate_names(AstNode.statement_of(n))
            return
        }
        if k = KindIfStatement
        {
            this.generate_names(AstNode.then_statement_of(n))
            this.generate_names(AstNode.else_statement_of(n))
            return
        }
        if (k = KindForStatement) or (k = KindForOfStatement) or (k = KindForInStatement)
        {
            this.generate_names(AstNode.initializer_of(n))
            this.generate_names(AstNode.statement_of(n))
            return
        }
        if k = KindSwitchStatement
        {
            this.generate_names(AstNode.case_block_of(n))
            return
        }
        if k = KindCaseBlock
        {
            this.generate_all_names(Printer.case_block_clauses_of(n))
            return
        }
        if k = KindTryStatement
        {
            this.generate_names(AstNode.try_block_of(n))
            this.generate_names(AstNode.catch_clause_of(n))
            this.generate_names(AstNode.finally_block_of(n))
            return
        }
        if k = KindCatchClause
        {
            this.generate_names(Printer.catch_variable_declaration_of(n))
            this.generate_names(Printer.catch_block_of(n))
            return
        }
        if k = KindVariableStatement
        {
            this.generate_names(Printer.declaration_list_of(n))
            return
        }
        if k = KindVariableDeclarationList
        {
            this.generate_all_names(Printer.declarations_of(n))
            return
        }
        if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindClassDeclaration)
        {
            this.generate_name_if_needed(AstNode.name_of(n))
            return
        }
        if k = KindFunctionDeclaration
        {
            this.generate_name_if_needed(AstNode.name_of(n))
            if this.should_reuse_temp_variable_scope(n)
            {
                this.generate_all_names(AstNode.parameters_of(n))
                this.generate_names(AstNode.body_of(n))
            }
            return
        }
        if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern)
        {
            this.generate_all_names(AstNode.elements_of(n))
            return
        }
        if (k = KindImportDeclaration) or (k = KindJSImportDeclaration)
        {
            this.generate_names(AstNode.import_clause_of(n))
            return
        }
        if k = KindImportClause
        {
            this.generate_name_if_needed(AstNode.name_of(n))
            this.generate_names(AstNode.named_bindings_of(n))
            return
        }
        if (k = KindNamespaceImport) or (k = KindNamespaceExport)
        {
            this.generate_name_if_needed(AstNode.name_of(n))
            return
        }
        if k = KindNamedImports
        {
            this.generate_all_names(AstNode.elements_of(n))
            return
        }
        if k = KindImportSpecifier
        {
            let property_name AstNode.property_name_of(n)
            if property_name <> null
                this.generate_name_if_needed(property_name)
            else
                this.generate_name_if_needed(AstNode.name_of(n))
        }
    }

    procedure generate_all_member_names(this, nodes: ref[Array[ref[AstNode]?]]?)
    {
        if nodes = null
            return
        let list nodes as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.generate_member_names(list[i as size_t])
            set i: i + 1
        }
    }

    procedure generate_member_names(this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let k n.kind
        if (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment) or (k = KindPropertyDeclaration) or (k = KindPropertySignature) or (k = KindMethodDeclaration) or (k = KindMethodSignature) or (k = KindGetAccessor) or (k = KindSetAccessor)
            this.generate_name_if_needed(AstNode.name_of(n))
    }

    procedure generate_name_if_needed(this, name: ref[AstNode]?)
    {
        if name = null
            return
        let n name as ref[AstNode]
        if Printer.is_member_name_kind(n.kind)
        {
            this.generate_name(n)
            return
        }
        if AstNode.is_binding_pattern(n)
            this.generate_names(n)
    }

    ; the text of a generated identifier or private identifier, computed for its side effect
    procedure generate_name(this, name: ref[AstNode])
        name_generator.generate_name(name)

    ; whether a name is unique globally or within the current file
    function is_file_level_unique_name_in_current_file(this, name: Slice[char], private_name: bool) returns bool
    {
        if current_source_file = null
            return true
        ; IsFileLevelUniqueName(file, name, hasGlobalName)
        if this.has_global_name(name)
            return false
        (current_source_file as ref[SourceFileInfo]).has_identifier(name) = false
    }

    ; PrintHandlers.HasGlobalName: nil until the emitter installs the checker's
    ; answer, and a nil callback means "no global check" (§3.18).
    function has_global_name(this, name: Slice[char]) returns bool
        false

    procedure make_file_level_optimistic_unique_name(this, name: Slice[char]) returns Slice[char]
        name_generator.make_file_level_optimistic_unique_name(name)

    ; ── the six PrintHandlers hooks (no handler installed yet) ──

    procedure on_before_emit_node(this, node: ref[AstNode]?)
    {
    }

    procedure on_after_emit_node(this, node: ref[AstNode]?)
    {
    }

    procedure on_before_emit_node_list(this, nodes: ref[Array[ref[AstNode]?]]?)
    {
    }

    procedure on_after_emit_node_list(this, nodes: ref[Array[ref[AstNode]?]]?)
    {
    }

    procedure on_before_emit_token(this, node: ref[AstNode]?)
    {
    }

    procedure on_after_emit_token(this, node: ref[AstNode]?)
    {
    }

    ; ── scoped operations ──

    procedure enter_node(this, node: ref[AstNode]) returns PrinterState
    {
        this.on_before_emit_node(node)
        let comment this.emit_comments_before_node(node)
        let source_map this.emit_source_maps_before_node(node)
        PrinterState(comment, source_map)
    }

    procedure exit_node(this, node: ref[AstNode], previous_state: PrinterState)
    {
        this.emit_source_maps_after_node(node, previous_state.source_map)
        this.emit_comments_after_node(node, previous_state.comment)
        this.on_after_emit_node(node)
    }

    procedure enter_token_node(this, node: ref[AstNode], flags: int) returns PrinterState
    {
        this.on_before_emit_token(node)
        var comment CommentState.none()
        var source_map SourceMapState.none()
        if (flags & TefNoComments) = 0
            set comment: this.emit_comments_before_node(node)
        if (flags & TefNoSourceMaps) = 0
            set source_map: this.emit_source_maps_before_node(node)
        PrinterState(comment, source_map)
    }

    procedure exit_token_node(this, node: ref[AstNode], previous_state: PrinterState)
    {
        this.emit_source_maps_after_node(node, previous_state.source_map)
        this.emit_comments_after_node(node, previous_state.comment)
        this.on_after_emit_token(node)
    }

    ; `pos` is in/out (the reference returns the pair)
    procedure enter_token(this, token: int, pos: ref[int], context_node: ref[AstNode], flags: int) returns PrinterState
    {
        let comment this.emit_comments_before_token(token, pos, context_node, flags)
        let source_map this.emit_source_maps_before_token(token, pos, context_node, flags)
        PrinterState(comment, source_map)
    }

    procedure exit_token(this, token: int, pos: int, context_node: ref[AstNode], previous_state: PrinterState)
    {
        this.emit_source_maps_after_token(token, pos, context_node, previous_state.source_map)
        this.emit_comments_after_token(token, pos, context_node, previous_state.comment)
    }

    ; ── the per-kind emitters of slices 234/235: said stops ──

    procedure emit_type_parameter(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_parameter(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_decorator(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_property_signature(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_property_declaration(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_method_signature(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_method_declaration(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_class_static_block_declaration(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_constructor(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_get_accessor_declaration(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_set_accessor_declaration(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_call_signature(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_construct_signature(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_index_signature(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_object_binding_pattern(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_array_binding_pattern(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_binding_element(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_template_span(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_semicolon_class_element(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_variable_declaration(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_variable_declaration_list(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_module_block(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_case_block(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_import_clause(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_namespace_import(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_namespace_export(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_named_imports(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_import_specifier(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_named_exports(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_export_specifier(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_import_attributes(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_import_attribute(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_external_module_reference(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_text(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_opening_element(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_opening_fragment(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_closing_element(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_closing_fragment(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_attribute(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_attributes(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_spread_attribute(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_expression(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsx_namespaced_name(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_case_clause(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_default_clause(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_heritage_clause(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_catch_clause(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_property_assignment(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_shorthand_property_assignment(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_spread_assignment(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_enum_member(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_source_file(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_not_emitted_type_element(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_type_node_outside_extends(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_statement(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_jsdoc_node(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_property_access_expression(this, node: ref[AstNode])
        this.emit_unported(node)

    procedure emit_expression(this, node: ref[AstNode], precedence: int)
        this.emit_unported(node)

}

; lineCharacterCache — line and UTF-16 character of a byte position, cached for
; monotone positions (the source-map emit). Over a text and its line map.
define LineCharacterCache
(
    line_map: ref[Array[int]]
    text: Slice[char]
    cached_line: int
    cached_pos: int
    cached_char: int
    has_cached: bool
)
{
    function create(host: ref[Page], line_map: ref[Array[int]], text: Slice[char]) returns ref[LineCharacterCache]
        &LineCharacterCache^host(line_map, text, 0, 0, 0, false)

    function utf16_len_between(s: Slice[char], from: int, to: int) returns int
        TextWriter.utf16_len_of(s, from, to)

    procedure get_line_and_character(this, pos: int, out_line: ref[int], out_character: ref[int])
    {
        let line Scanner.compute_line_of_position(line_map, pos)
        let line_start line_map[line as size_t]
        var end_pos pos
        if (text.length as int) < end_pos
            set end_pos: text.length as int
        var character 0
        var incremental false
        if has_cached
        {
            if line = cached_line
            {
                if end_pos >= cached_pos
                    set incremental: true
            }
        }
        if incremental
            set character: cached_char + LineCharacterCache.utf16_len_between(text, cached_pos, end_pos)
        else
            set character: LineCharacterCache.utf16_len_between(text, line_start, end_pos)
        let cached character
        set character: character + (pos - end_pos)
        set this.cached_line: line
        set this.cached_pos: end_pos
        set this.cached_char: cached
        set this.has_cached: true
        set out_line: line
        set out_character: character
    }
}

; ── helpers.go ──────────────────────────────────────────────────────────────
;
; EmitHelper. `priority` is -1 where the reference's pointer is nil; `text_kind`
; is 0 for a fixed text and 1 / 2 for the two scoped helpers whose text is a
; CALLBACK over makeUniqueName (async-super, advanced-async-super) — the printer
; renders those at the emit site (§3.18). The helpers are singletons in the
; reference; here they are made once per emit by `EmitHelpers.create`, so the
; identity comparisons the reference makes hold within one emit.
define EmitHelper
(
    name: Slice[char]
    scoped: bool
    text: Slice[char]
    text_kind: int
    priority: int
    dependencies: ref[Array[ref[EmitHelper]?]]?
    import_name: Slice[char]
)
{
    function make(host: ref[Page], name: Slice[char], scoped: bool, text: Slice[char], text_kind: int, priority: int, import_name: Slice[char]) returns ref[EmitHelper]
        &EmitHelper^host(name, scoped, text, text_kind, priority, null, import_name)

    ; compareEmitHelpers
    function compare(x: ref[EmitHelper], y: ref[EmitHelper]) returns int
    {
        if x = y
            return 0
        if x.priority = y.priority
            return 0
        if x.priority < 0
            return 1
        if y.priority < 0
            return 0 - 1
        x.priority - y.priority
    }
}

define EmitHelpers
(
    decorate_helper: ref[EmitHelper]
    metadata_helper: ref[EmitHelper]
    param_helper: ref[EmitHelper]
    add_disposable_resource_helper: ref[EmitHelper]
    dispose_resources_helper: ref[EmitHelper]
    class_private_field_get_helper: ref[EmitHelper]
    class_private_field_set_helper: ref[EmitHelper]
    class_private_field_in_helper: ref[EmitHelper]
    await_helper: ref[EmitHelper]
    async_generator_helper: ref[EmitHelper]
    async_delegator_helper: ref[EmitHelper]
    async_values_helper: ref[EmitHelper]
    rest_helper: ref[EmitHelper]
    awaiter_helper: ref[EmitHelper]
    async_super_helper: ref[EmitHelper]
    advanced_async_super_helper: ref[EmitHelper]
    es_decorate_helper: ref[EmitHelper]
    run_initializers_helper: ref[EmitHelper]
    make_template_object_helper: ref[EmitHelper]
    prop_key_helper: ref[EmitHelper]
    set_function_name_helper: ref[EmitHelper]
    create_binding_helper: ref[EmitHelper]
    set_module_default_helper: ref[EmitHelper]
    import_star_helper: ref[EmitHelper]
    import_default_helper: ref[EmitHelper]
    export_star_helper: ref[EmitHelper]
    rewrite_relative_import_extensions_helper: ref[EmitHelper]
)
{
    function create(host: ref[Page]) returns ref[EmitHelpers]
    {
        let decorate_helper EmitHelper.make(host, "typescript:decorate", false, "", 0, 2, "__decorate")
        let metadata_helper EmitHelper.make(host, "typescript:metadata", false, "", 0, 3, "__metadata")
        let param_helper EmitHelper.make(host, "typescript:param", false, "", 0, 4, "__param")
        let add_disposable_resource_helper EmitHelper.make(host, "typescript:addDisposableResource", false, "", 0, -1, "__addDisposableResource")
        let dispose_resources_helper EmitHelper.make(host, "typescript:disposeResources", false, "", 0, -1, "__disposeResources")
        let class_private_field_get_helper EmitHelper.make(host, "typescript:classPrivateFieldGet", false, "", 0, -1, "__classPrivateFieldGet")
        let class_private_field_set_helper EmitHelper.make(host, "typescript:classPrivateFieldSet", false, "", 0, -1, "__classPrivateFieldSet")
        let class_private_field_in_helper EmitHelper.make(host, "typescript:classPrivateFieldIn", false, "", 0, -1, "__classPrivateFieldIn")
        let await_helper EmitHelper.make(host, "typescript:await", false, "var __await = (this && this.__await) || function (v) { return this instanceof __await ? (this.v = v, this) : new __await(v); }", 0, -1, "__await")
        let async_generator_helper EmitHelper.make(host, "typescript:asyncGenerator", false, "", 0, -1, "__asyncGenerator")
        let async_delegator_helper EmitHelper.make(host, "typescript:asyncDelegator", false, "", 0, -1, "__asyncDelegator")
        let async_values_helper EmitHelper.make(host, "typescript:asyncValues", false, "", 0, -1, "__asyncValues")
        let rest_helper EmitHelper.make(host, "typescript:rest", false, "", 0, -1, "__rest")
        let awaiter_helper EmitHelper.make(host, "typescript:awaiter", false, "", 0, 5, "__awaiter")
        let async_super_helper EmitHelper.make(host, "typescript:async-super", true, "", 1, -1, "")
        let advanced_async_super_helper EmitHelper.make(host, "typescript:advanced-async-super", true, "", 2, -1, "")
        let es_decorate_helper EmitHelper.make(host, "typescript:esDecorate", false, "", 0, 2, "__esDecorate")
        let run_initializers_helper EmitHelper.make(host, "typescript:runInitializers", false, "", 0, 2, "__runInitializers")
        let make_template_object_helper EmitHelper.make(host, "typescript:makeTemplateObject", false, "", 0, 0, "__makeTemplateObject")
        let prop_key_helper EmitHelper.make(host, "typescript:propKey", false, "", 0, -1, "__propKey")
        let set_function_name_helper EmitHelper.make(host, "typescript:setFunctionName", false, "", 0, -1, "__setFunctionName")
        let create_binding_helper EmitHelper.make(host, "typescript:commonjscreatebinding", false, "", 0, 1, "__createBinding")
        let set_module_default_helper EmitHelper.make(host, "typescript:commonjscreatevalue", false, "", 0, 1, "__setModuleDefault")
        let import_star_helper EmitHelper.make(host, "typescript:commonjsimportstar", false, "", 0, 2, "__importStar")
        let import_default_helper EmitHelper.make(host, "typescript:commonjsimportdefault", false, "", 0, -1, "__importDefault")
        let export_star_helper EmitHelper.make(host, "typescript:export-star", false, "", 0, 2, "__exportStar")
        let rewrite_relative_import_extensions_helper EmitHelper.make(host, "typescript:rewriteRelativeImportExtensions", false, "", 0, -1, "__rewriteRelativeImportExtension")
        let async_generator_helper_deps &Array[ref[EmitHelper]?]^host()
        async_generator_helper_deps.add(await_helper)
        set async_generator_helper.dependencies: async_generator_helper_deps
        let async_delegator_helper_deps &Array[ref[EmitHelper]?]^host()
        async_delegator_helper_deps.add(await_helper)
        set async_delegator_helper.dependencies: async_delegator_helper_deps
        let import_star_helper_deps &Array[ref[EmitHelper]?]^host()
        import_star_helper_deps.add(create_binding_helper)
        import_star_helper_deps.add(set_module_default_helper)
        set import_star_helper.dependencies: import_star_helper_deps
        let export_star_helper_deps &Array[ref[EmitHelper]?]^host()
        export_star_helper_deps.add(create_binding_helper)
        set export_star_helper.dependencies: export_star_helper_deps
        &EmitHelpers^host(decorate_helper, metadata_helper, param_helper, add_disposable_resource_helper, dispose_resources_helper, class_private_field_get_helper, class_private_field_set_helper, class_private_field_in_helper, await_helper, async_generator_helper, async_delegator_helper, async_values_helper, rest_helper, awaiter_helper, async_super_helper, advanced_async_super_helper, es_decorate_helper, run_initializers_helper, make_template_object_helper, prop_key_helper, set_function_name_helper, create_binding_helper, set_module_default_helper, import_star_helper, import_default_helper, export_star_helper, rewrite_relative_import_extensions_helper)
    }
}

; ── emitcontext.go (slice 232) ─────────────────────────────────────────────
;
; ★ IDENTITY. Every context has an id from a module counter, and a node's
; `emit_index` belongs to the context whose id it carries (AstNode's three emit
; slots): the reference pools and RESETS contexts, and a reset here is a new id,
; so a node's row from an earlier emit is not a row. The reference's six per-node
; maps (emitNodes, autoGenerate, textSource, original, assignedName, classThis)
; are ONE row per node here — `original` on the node itself, the other five as
; slots of EmitNode — because every one of them is keyed by the node and lives
; exactly as long as the context.
;
; ★ The `Visit` and hook FUNC VALUES the context hands a visitor are tags on the
; visitor (§3.18): `HooksTagEmitContext` routes the five hook methods here.
mutable next_emit_context_id: int 1
mutable next_auto_generate_id: int 0

; The hook tags of NodeVisitor (§3.39): declared HERE because printer precedes
; factory in module order and a constant is only visible from the module that
; declares it or a later one.
define HooksTagNone: int 0
define HooksTagEmitContext: int 1
define HooksTagDeepClone: int 2

define EnvironmentFlagsNone: int 0
define EnvironmentFlagsInParameters: int 1 << 0
define EnvironmentFlagsVariablesHoistedInParameters: int 1 << 1

define EmitNodeFlagsHasCommentRange: int 1 << 0
define EmitNodeFlagsHasSourceMapRange: int 1 << 1

; A synthesized comment: kind, a location (-1, -1 when synthetic), the two
; line-break flags and the text.
define SynthesizedComment
(
    kind: int
    pos: int
    end: int
    has_leading_new_line: bool
    has_trailing_new_line: bool
    text: Slice[char]
)

define TokenSourceMapRange
(
    kind: int
    pos: int
    end: int
)

define AutoGenerateInfo
(
    flags: int
    id: int
    prefix: Slice[char]
    suffix: Slice[char]
    node: ref[AstNode]?
)

; AutoGenerateOptions: the reference passes a struct by value; here three
; arguments (flags, prefix, suffix) at every call, because a record of two
; views and an int is what the struct is.

; emitNode plus the four per-node maps that share its lifetime.
define EmitNode
(
    flags: int
    emit_flags: int
    comment_pos: int
    comment_end: int
    source_map_pos: int
    source_map_end: int
    token_source_map_ranges: ref[Array[TokenSourceMapRange]]?
    helpers: ref[Array[ref[EmitHelper]?]]?
    external_helpers_module_name: ref[AstNode]?
    leading_comments: ref[Array[SynthesizedComment]]?
    trailing_comments: ref[Array[SynthesizedComment]]?
    type_node: ref[AstNode]?
    auto_generate: ref[AutoGenerateInfo]?
    text_source: ref[AstNode]?
    assigned_name: ref[AstNode]?
    class_this: ref[AstNode]?
)

define VarScope
(
    variables: ref[Array[ref[AstNode]?]]
    functions: ref[Array[ref[AstNode]?]]
    flags: int
    initialization_statements: ref[Array[ref[AstNode]?]]
)

define EmitContext
(
    host: ref[Page]
    id: int
    factory: ref[NodeFactory]?
    emit_nodes: ref[Array[ref[EmitNode]?]]
    var_scope_stack: ref[Array[ref[VarScope]?]]
    let_scope_stack: ref[Array[ref[VarScope]?]]
    ; The two stacks' DEPTHS: the Array has no pop (a push past the depth
    ; overwrites the slot a pop left behind).
    var_scope_depth: int
    let_scope_depth: int
    emit_helpers: ref[Array[ref[EmitHelper]?]]
    helpers: ref[EmitHelpers]
)
{
    function create(host: ref[Page], list_ranges: ref[Array[ListRange]]?) returns ref[EmitContext]
    {
        let rows &Array[ref[EmitNode]?]^host()
        let vs &Array[ref[VarScope]?]^host()
        let ls &Array[ref[VarScope]?]^host()
        let hs &Array[ref[EmitHelper]?]^host()
        let c &EmitContext^host(host, next_emit_context_id, null, rows, vs, ls, 0, 0, hs, EmitHelpers.create(host))
        set next_emit_context_id: next_emit_context_id + 1
        set c.factory: NodeFactory.create(host, c, list_ranges)
        c
    }

    ; Reset: a new identity (every row of the old one is unreachable by it),
    ; empty stacks, the factory kept.
    procedure reset(this)
    {
        set this.id: next_emit_context_id
        set next_emit_context_id: next_emit_context_id + 1
        set this.emit_nodes: &Array[ref[EmitNode]?]^host()
        set this.var_scope_stack: &Array[ref[VarScope]?]^host()
        set this.let_scope_stack: &Array[ref[VarScope]?]^host()
        set this.var_scope_depth: 0
        set this.let_scope_depth: 0
        set this.emit_helpers: &Array[ref[EmitHelper]?]^host()
    }

    function the_factory(this) returns ref[NodeFactory]
        factory as ref[NodeFactory]

    ; nextAutoGenerateId — the reference's process-wide counter, a module global here.
    procedure next_auto_id(this) returns int
    {
        set next_auto_generate_id: next_auto_generate_id + 1
        next_auto_generate_id
    }

    ; ── the factory hooks ──

    procedure on_create(this, node: ref[AstNode])
        set node.flags: node.flags | NodeFlagsSynthesized

    procedure on_update(this, updated: ref[AstNode], original: ref[AstNode])
        this.set_original(updated, original)

    ; onClone: the original, and a COPY of an auto-generated name's info onto
    ; the clone (a clone of a generated identifier is the same generated name).
    procedure on_clone(this, updated: ref[AstNode], original: ref[AstNode])
    {
        this.set_original(updated, original)
        let k updated.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
        {
            let row this.try_get_emit_node(original)
            if row <> null
            {
                let info (row as ref[EmitNode]).auto_generate
                if info <> null
                {
                    let src info as ref[AutoGenerateInfo]
                    let copy &AutoGenerateInfo^host(src.flags, src.id, src.prefix, src.suffix, src.node)
                    set this.get_emit_node(updated).auto_generate: copy
                }
            }
        }
    }

    ; ── the emit-node rows ──

    function try_get_emit_node(this, node: ref[AstNode]) returns ref[EmitNode]?
    {
        if node.emit_context_id <> id
            return null
        if node.emit_index <= 0
            return null
        emit_nodes[(node.emit_index - 1) as size_t]
    }

    procedure get_emit_node(this, node: ref[AstNode]) returns ref[EmitNode]
    {
        let existing this.try_get_emit_node(node)
        if existing <> null
            return existing as ref[EmitNode]
        let row &EmitNode^host(0, EFNone, 0, 0, 0, 0, null, null, null, null, null, null, null, null, null, null)
        emit_nodes.add(row)
        set node.emit_index: emit_nodes.get_length() as int
        set node.emit_context_id: id
        row
    }

    function has_emit_node(this, node: ref[AstNode]) returns bool
        this.try_get_emit_node(node) <> null

    ; emitNode.copyFrom: the flags, both ranges, the token ranges, the helpers
    ; and the external helpers name — not the comments, not the type node.
    procedure copy_emit_node(this, to: ref[EmitNode], from: ref[EmitNode])
    {
        set to.flags: from.flags
        set to.emit_flags: from.emit_flags
        set to.comment_pos: from.comment_pos
        set to.comment_end: from.comment_end
        set to.source_map_pos: from.source_map_pos
        set to.source_map_end: from.source_map_end
        set to.token_source_map_ranges: null
        if from.token_source_map_ranges <> null
        {
            let src from.token_source_map_ranges as ref[Array[TokenSourceMapRange]]
            let copy &Array[TokenSourceMapRange]^host()
            var i 0
            while i < (src.get_length() as int)
            {
                copy.add(src[i as size_t])
                set i: i + 1
            }
            set to.token_source_map_ranges: copy
        }
        set to.helpers: null
        if from.helpers <> null
        {
            let src from.helpers as ref[Array[ref[EmitHelper]?]]
            let copy &Array[ref[EmitHelper]?]^host()
            var i 0
            while i < (src.get_length() as int)
            {
                copy.add(src[i as size_t])
                set i: i + 1
            }
            set to.helpers: copy
        }
        set to.external_helpers_module_name: from.external_helpers_module_name
    }

    ; ── the original chain ──

    procedure set_original(this, node: ref[AstNode], original: ref[AstNode])
        this.set_original_ex(node, original, false)

    procedure unset_original(this, node: ref[AstNode])
        set node.original: null

    ; SetOriginalEx. A first setting also copies the original's emit node; a
    ; second, different one without allowOverwrite is the reference's panic and
    ; this port's no-op (the first stands).
    procedure set_original_ex(this, node: ref[AstNode], original: ref[AstNode], allow_overwrite: bool)
    {
        if node.original = null
        {
            set node.original: original
            let row this.try_get_emit_node(original)
            if row <> null
                this.copy_emit_node(this.get_emit_node(node), row as ref[EmitNode])
            return
        }
        if allow_overwrite
            set node.original: original
    }

    function original(this, node: ref[AstNode]) returns ref[AstNode]?
        node.original

    function most_original(this, node_in: ref[AstNode]?) returns ref[AstNode]?
    {
        if node_in = null
            return null
        var node node_in as ref[AstNode]
        var original node.original
        while original <> null
        {
            set node: original as ref[AstNode]
            set original: node.original
        }
        node
    }

    ; ParseNode: the most original node when it is a parse-tree node.
    function parse_node(this, node_in: ref[AstNode]?) returns ref[AstNode]?
    {
        let node this.most_original(node_in)
        if node = null
            return null
        if ((node as ref[AstNode]).flags & NodeFlagsSynthesized) <> 0
            return null
        node
    }

    ; ── the variable and lexical environments ──

    function new_scope(this) returns ref[VarScope]
    {
        let vars &Array[ref[AstNode]?]^host()
        let fns &Array[ref[AstNode]?]^host()
        let inits &Array[ref[AstNode]?]^host()
        &VarScope^host(vars, fns, EnvironmentFlagsNone, inits)
    }

    function peek_var_scope(this) returns ref[VarScope]?
    {
        if var_scope_depth = 0
            return null
        var_scope_stack[(var_scope_depth - 1) as size_t]
    }

    function peek_let_scope(this) returns ref[VarScope]?
    {
        if let_scope_depth = 0
            return null
        let_scope_stack[(let_scope_depth - 1) as size_t]
    }

    procedure push_var_scope(this)
    {
        let scope this.new_scope()
        if var_scope_depth < (var_scope_stack.get_length() as int)
            var_scope_stack.put(var_scope_depth as size_t, scope)
        else
            var_scope_stack.add(scope)
        set this.var_scope_depth: var_scope_depth + 1
    }

    procedure push_let_scope(this)
    {
        let scope this.new_scope()
        if let_scope_depth < (let_scope_stack.get_length() as int)
            let_scope_stack.put(let_scope_depth as size_t, scope)
        else
            let_scope_stack.add(scope)
        set this.let_scope_depth: let_scope_depth + 1
    }

    procedure pop_var_scope(this) returns ref[VarScope]
    {
        set this.var_scope_depth: var_scope_depth - 1
        var_scope_stack[var_scope_depth as size_t] as ref[VarScope]
    }

    procedure pop_let_scope(this) returns ref[VarScope]
    {
        set this.let_scope_depth: let_scope_depth - 1
        let_scope_stack[let_scope_depth as size_t] as ref[VarScope]
    }

    procedure start_variable_environment(this)
    {
        this.push_var_scope()
        this.start_lexical_environment()
    }

    ; EndVariableEnvironment: the hoisted functions, then one `var` statement
    ; over the hoisted variables (a custom prologue), then the initialization
    ; statements, then the lexical environment's.
    procedure end_variable_environment(this) returns ref[Array[ref[AstNode]?]]
    {
        let scope this.pop_var_scope()
        let statements &Array[ref[AstNode]?]^host()
        var i 0
        while i < (scope.functions.get_length() as int)
        {
            statements.add(scope.functions[i as size_t])
            set i: i + 1
        }
        if (scope.variables.get_length() as int) > 0
        {
            let f this.the_factory()
            let var_decl_list f.new_variable_declaration_list(scope.variables, NodeFlagsNone)
            let var_statement f.new_variable_statement(null, var_decl_list)
            this.set_emit_flags(var_statement, EFCustomPrologue)
            statements.add(var_statement)
        }
        set i: 0
        while i < (scope.initialization_statements.get_length() as int)
        {
            statements.add(scope.initialization_statements[i as size_t])
            set i: i + 1
        }
        let lexical this.end_lexical_environment()
        set i: 0
        while i < (lexical.get_length() as int)
        {
            statements.add(lexical[i as size_t])
            set i: i + 1
        }
        statements
    }

    ; EndAndMergeVariableEnvironment(List): the statements with the environment's
    ; declarations merged in; the list keeps its extent when nothing changed.
    procedure end_and_merge_variable_environment(this, statements: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        var changed false
        let result this.merge_environment(statements, this.end_variable_environment(), &changed)
        if changed
            return this.the_factory().new_node_list_like(result as ref[Array[ref[AstNode]?]], statements)
        statements
    }

    procedure add_variable_declaration(this, name: ref[AstNode])
    {
        let f this.the_factory()
        let var_decl f.new_variable_declaration(name, null, null, null)
        this.set_emit_flags(var_decl, EFNoNestedSourceMaps)
        let scope this.peek_var_scope() as ref[VarScope]
        scope.variables.add(var_decl)
        if (scope.flags & EnvironmentFlagsInParameters) <> 0
            set scope.flags: scope.flags | EnvironmentFlagsVariablesHoistedInParameters
    }

    procedure add_hoisted_function_declaration(this, node: ref[AstNode])
    {
        this.set_emit_flags(node, EFCustomPrologue)
        let scope this.peek_var_scope() as ref[VarScope]
        scope.functions.add(node)
    }

    procedure start_lexical_environment(this)
        this.push_let_scope()

    procedure end_lexical_environment(this) returns ref[Array[ref[AstNode]?]]
    {
        let scope this.pop_let_scope()
        let statements &Array[ref[AstNode]?]^host()
        if (scope.variables.get_length() as int) > 0
        {
            let f this.the_factory()
            let var_decl_list f.new_variable_declaration_list(scope.variables, NodeFlagsLet)
            let var_statement f.new_variable_statement(null, var_decl_list)
            this.set_emit_flags(var_statement, EFCustomPrologue)
            statements.add(var_statement)
        }
        statements
    }

    procedure end_and_merge_lexical_environment(this, statements: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        var changed false
        let result this.merge_environment(statements, this.end_lexical_environment(), &changed)
        if changed
            return this.the_factory().new_node_list_like(result as ref[Array[ref[AstNode]?]], statements)
        statements
    }

    procedure add_lexical_declaration(this, name: ref[AstNode])
    {
        let f this.the_factory()
        let var_decl f.new_variable_declaration(name, null, null, null)
        this.set_emit_flags(var_decl, EFNoNestedSourceMaps)
        let scope this.peek_let_scope() as ref[VarScope]
        scope.variables.add(var_decl)
    }

    procedure merge_environment_list(this, statements: ref[Array[ref[AstNode]?]]?, declarations: ref[Array[ref[AstNode]?]]) returns ref[Array[ref[AstNode]?]]?
    {
        var changed false
        let result this.merge_environment(statements, declarations, &changed)
        if changed
            return this.the_factory().new_node_list_like(result as ref[Array[ref[AstNode]?]], statements)
        statements
    }

    ; findSpanEnd over the four prologue predicates (§3.18: one loop per test).
    function span_end_prologue(this, list: ref[Array[ref[AstNode]?]], start: int) returns int
    {
        var i start
        while i < (list.get_length() as int)
        {
            if EmitContext.is_prologue_directive(list[i as size_t]) = false
                break
            set i: i + 1
        }
        i
    }

    function span_end_hoisted_function(this, list: ref[Array[ref[AstNode]?]], start: int) returns int
    {
        var i start
        while i < (list.get_length() as int)
        {
            if this.is_hoisted_function(list[i as size_t]) = false
                break
            set i: i + 1
        }
        i
    }

    function span_end_hoisted_variable(this, list: ref[Array[ref[AstNode]?]], start: int) returns int
    {
        var i start
        while i < (list.get_length() as int)
        {
            if this.is_hoisted_variable_statement(list[i as size_t]) = false
                break
            set i: i + 1
        }
        i
    }

    function span_end_custom_prologue(this, list: ref[Array[ref[AstNode]?]], start: int) returns int
    {
        var i start
        while i < (list.get_length() as int)
        {
            if this.is_custom_prologue(list[i as size_t]) = false
                break
            set i: i + 1
        }
        i
    }

    ; core.Splice(left, at, 0, items...) — an insertion; the Array has no insert
    ; (§3.27): a fresh Array.
    function splice_in(this, left: ref[Array[ref[AstNode]?]], at: int, items: ref[Array[ref[AstNode]?]], from: int, to: int) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        var i 0
        while i < at
        {
            out.add(left[i as size_t])
            set i: i + 1
        }
        var k from
        while k < to
        {
            out.add(items[k as size_t])
            set k: k + 1
        }
        while i < (left.get_length() as int)
        {
            out.add(left[i as size_t])
            set i: i + 1
        }
        out
    }

    ; mergeEnvironment: the declarations are a standard prologue, then hoisted
    ; functions, then hoisted variables, then custom prologues, each merged
    ; behind the statements' own run of that kind; a standard prologue already
    ; present is not repeated.
    procedure merge_environment(this, statements_in: ref[Array[ref[AstNode]?]]?, declarations: ref[Array[ref[AstNode]?]], changed: ref[bool]) returns ref[Array[ref[AstNode]?]]?
    {
        set changed: false
        if (declarations.get_length() as int) = 0
            return statements_in
        var statements: ref[Array[ref[AstNode]?]] &Array[ref[AstNode]?]^host()
        if statements_in <> null
            set statements: statements_in as ref[Array[ref[AstNode]?]]
        let left_standard_prologue_end this.span_end_prologue(statements, 0)
        let left_hoisted_functions_end this.span_end_hoisted_function(statements, left_standard_prologue_end)
        let left_hoisted_variables_end this.span_end_hoisted_variable(statements, left_hoisted_functions_end)
        let right_standard_prologue_end this.span_end_prologue(declarations, 0)
        let right_hoisted_functions_end this.span_end_hoisted_function(declarations, right_standard_prologue_end)
        let right_hoisted_variables_end this.span_end_hoisted_variable(declarations, right_hoisted_functions_end)
        let right_custom_prologue_end this.span_end_custom_prologue(declarations, right_hoisted_variables_end)
        var left statements
        if right_custom_prologue_end > right_hoisted_variables_end
        {
            set left: this.splice_in(left, left_hoisted_variables_end, declarations, right_hoisted_variables_end, right_custom_prologue_end)
            set changed: true
        }
        if right_hoisted_variables_end > right_hoisted_functions_end
        {
            set left: this.splice_in(left, left_hoisted_functions_end, declarations, right_hoisted_functions_end, right_hoisted_variables_end)
            set changed: true
        }
        if right_hoisted_functions_end > right_standard_prologue_end
        {
            set left: this.splice_in(left, left_standard_prologue_end, declarations, right_standard_prologue_end, right_hoisted_functions_end)
            set changed: true
        }
        if right_standard_prologue_end > 0
        {
            if left_standard_prologue_end = 0
            {
                set left: this.splice_in(left, 0, declarations, 0, right_standard_prologue_end)
                set changed: true
            }
            else
            {
                var i right_standard_prologue_end - 1
                while i >= 0
                {
                    let right_prologue declarations[i as size_t]
                    if right_prologue <> null
                    {
                        let text EmitContext.prologue_text(right_prologue as ref[AstNode])
                        var present false
                        var k 0
                        while k < left_standard_prologue_end
                        {
                            let lp statements[k as size_t]
                            if lp <> null
                            {
                                if EmitContext.prologue_text(lp as ref[AstNode]) = text
                                    set present: true
                            }
                            set k: k + 1
                        }
                        if present = false
                        {
                            let one &Array[ref[AstNode]?]^host()
                            one.add(right_prologue)
                            set left: this.splice_in(left, 0, one, 0, 1)
                            set changed: true
                        }
                    }
                    set i: i - 1
                }
            }
        }
        left
    }

    function prologue_text(statement: ref[AstNode]) returns Slice[char]
    {
        let e AstNode.expression_of(statement)
        if e = null
            return ""
        AstNode.literal_text_of(e)
    }

    function is_prologue_directive(node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if n.kind <> KindExpressionStatement
            return false
        let e AstNode.expression_of(n)
        if e = null
            return false
        (e as ref[AstNode]).kind = KindStringLiteral
    }

    function is_custom_prologue(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        (this.emit_flags(node as ref[AstNode]) & EFCustomPrologue) <> 0
    }

    function is_hoisted_function(this, node: ref[AstNode]?) returns bool
    {
        if this.is_custom_prologue(node) = false
            return false
        (node as ref[AstNode]).kind = KindFunctionDeclaration
    }

    function is_hoisted_variable(decl: ref[AstNode]?) returns bool
    {
        if decl = null
            return false
        let name AstNode.name_of(decl)
        if name = null
            return false
        if (name as ref[AstNode]).kind <> KindIdentifier
            return false
        AstNode.initializer_of(decl) = null
    }

    function is_hoisted_variable_statement(this, node: ref[AstNode]?) returns bool
    {
        if this.is_custom_prologue(node) = false
            return false
        let n node as ref[AstNode]
        if n.kind <> KindVariableStatement
            return false
        let list AstNode.variable_statement_list_of(n)
        if list = null
            return false
        let decls AstNode.variable_declarations_of(list)
        if decls = null
            return true
        let ds decls as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ds.get_length() as int)
        {
            if EmitContext.is_hoisted_variable(ds[i as size_t]) = false
                return false
            set i: i + 1
        }
        true
    }

    ; ── generated names ──

    function has_auto_generate_info(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let row this.try_get_emit_node(node as ref[AstNode])
        if row = null
            return false
        (row as ref[EmitNode]).auto_generate <> null
    }

    function get_auto_generate_info(this, name: ref[AstNode]?) returns ref[AutoGenerateInfo]?
    {
        if name = null
            return null
        let row this.try_get_emit_node(name as ref[AstNode])
        if row = null
            return null
        (row as ref[EmitNode]).auto_generate
    }

    procedure set_auto_generate_info(this, name: ref[AstNode], info: ref[AutoGenerateInfo])
        set this.get_emit_node(name).auto_generate: info

    function get_node_for_generated_name(this, name: ref[AstNode]) returns ref[AstNode]
    {
        let info this.get_auto_generate_info(name)
        if info <> null
        {
            let ag info as ref[AutoGenerateInfo]
            if (ag.flags & GeneratedIdentifierFlagsKindMask) = GeneratedIdentifierFlagsNode
            {
                if ag.node <> null
                    return this.get_node_for_generated_name_worker(ag.node as ref[AstNode], ag.id)
            }
        }
        name
    }

    function get_node_for_generated_name_worker(this, node_in: ref[AstNode], auto_generate_id: int) returns ref[AstNode]
    {
        var node node_in
        var original this.original(node)
        while original <> null
        {
            set node: original as ref[AstNode]
            if (node.kind = KindIdentifier) or (node.kind = KindPrivateIdentifier)
            {
                let info this.get_auto_generate_info(node)
                var stop false
                if info = null
                    set stop: true
                else
                {
                    let ag info as ref[AutoGenerateInfo]
                    if (ag.flags & GeneratedIdentifierFlagsKindMask) = GeneratedIdentifierFlagsNode
                    {
                        if ag.id <> auto_generate_id
                            set stop: true
                    }
                }
                if stop
                    break
                let ag info as ref[AutoGenerateInfo]
                if (ag.flags & GeneratedIdentifierFlagsKindMask) = GeneratedIdentifierFlagsNode
                {
                    set original: ag.node
                    continue
                }
            }
            set original: this.original(node)
        }
        node
    }

    ; ── the emit-node accessors ──

    function emit_flags(this, node: ref[AstNode]) returns int
    {
        let row this.try_get_emit_node(node)
        if row = null
            return EFNone
        (row as ref[EmitNode]).emit_flags
    }

    procedure set_emit_flags(this, node: ref[AstNode], flags: int)
        set this.get_emit_node(node).emit_flags: flags

    procedure add_emit_flags(this, node: ref[AstNode], flags: int)
    {
        let row this.get_emit_node(node)
        set row.emit_flags: row.emit_flags | flags
    }

    function comment_range(this, node: ref[AstNode]) returns TextRange
    {
        let row this.try_get_emit_node(node)
        if row <> null
        {
            let r row as ref[EmitNode]
            if (r.flags & EmitNodeFlagsHasCommentRange) <> 0
                return TextRange(r.comment_pos, r.comment_end)
        }
        TextRange(node.pos, node.end)
    }

    procedure set_comment_range(this, node: ref[AstNode], loc: TextRange)
    {
        let row this.get_emit_node(node)
        set row.comment_pos: loc.pos
        set row.comment_end: loc.end
        set row.flags: row.flags | EmitNodeFlagsHasCommentRange
    }

    procedure assign_comment_range(this, to: ref[AstNode], from: ref[AstNode])
        this.set_comment_range(to, this.comment_range(from))

    function source_map_range(this, node: ref[AstNode]) returns TextRange
    {
        let row this.try_get_emit_node(node)
        if row <> null
        {
            let r row as ref[EmitNode]
            if (r.flags & EmitNodeFlagsHasSourceMapRange) <> 0
                return TextRange(r.source_map_pos, r.source_map_end)
        }
        TextRange(node.pos, node.end)
    }

    procedure set_source_map_range(this, node: ref[AstNode], loc: TextRange)
    {
        let row this.get_emit_node(node)
        set row.source_map_pos: loc.pos
        set row.source_map_end: loc.end
        set row.flags: row.flags | EmitNodeFlagsHasSourceMapRange
    }

    procedure assign_source_map_range(this, to: ref[AstNode], from: ref[AstNode])
        this.set_source_map_range(to, this.source_map_range(from))

    procedure assign_comment_and_source_map_ranges(this, to: ref[AstNode], from: ref[AstNode])
    {
        let cr this.comment_range(from)
        let smr this.source_map_range(from)
        let row this.get_emit_node(to)
        set row.comment_pos: cr.pos
        set row.comment_end: cr.end
        set row.source_map_pos: smr.pos
        set row.source_map_end: smr.end
        set row.flags: row.flags | EmitNodeFlagsHasCommentRange | EmitNodeFlagsHasSourceMapRange
    }

    ; TokenSourceMapRange: (range, found) as an out parameter.
    function token_source_map_range(this, node: ref[AstNode], kind: int, out: ref[TextRange]) returns bool
    {
        let row this.try_get_emit_node(node)
        if row = null
            return false
        let r row as ref[EmitNode]
        if r.token_source_map_ranges = null
            return false
        let ranges r.token_source_map_ranges as ref[Array[TokenSourceMapRange]]
        var i 0
        while i < (ranges.get_length() as int)
        {
            let e ranges[i as size_t]
            if e.kind = kind
            {
                set out: TextRange(e.pos, e.end)
                return true
            }
            set i: i + 1
        }
        false
    }

    procedure set_token_source_map_range(this, node: ref[AstNode], kind: int, loc: TextRange)
    {
        let row this.get_emit_node(node)
        if row.token_source_map_ranges = null
            set row.token_source_map_ranges: &Array[TokenSourceMapRange]^host()
        let ranges row.token_source_map_ranges as ref[Array[TokenSourceMapRange]]
        var i 0
        while i < (ranges.get_length() as int)
        {
            let r ranges[i as size_t]
            if r.kind = kind
            {
                ranges.put(i as size_t, TokenSourceMapRange(kind, loc.pos, loc.end))
                return
            }
            set i: i + 1
        }
        ranges.add(TokenSourceMapRange(kind, loc.pos, loc.end))
    }

    function assigned_name(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).assigned_name
    }

    procedure set_assigned_name(this, node: ref[AstNode], name: ref[AstNode]?)
        set this.get_emit_node(node).assigned_name: name

    function text_source(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).text_source
    }

    procedure set_text_source(this, node: ref[AstNode], source: ref[AstNode]?)
        set this.get_emit_node(node).text_source: source

    function class_this(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).class_this
    }

    procedure set_class_this(this, node: ref[AstNode], class_this: ref[AstNode]?)
        set this.get_emit_node(node).class_this: class_this

    ; ── emit helpers ──

    function helper_list_contains(list: ref[Array[ref[EmitHelper]?]], h: ref[EmitHelper]) returns bool
    {
        var i 0
        while i < (list.get_length() as int)
        {
            if list[i as size_t] = h
                return true
            set i: i + 1
        }
        false
    }

    ; RequestEmitHelper: the dependencies first, then the helper, each once (the
    ; reference's ordered set). A scoped helper cannot be requested.
    procedure request_emit_helper(this, helper: ref[EmitHelper])
    {
        if helper.scoped
            return
        if helper.dependencies <> null
        {
            let deps helper.dependencies as ref[Array[ref[EmitHelper]?]]
            var i 0
            while i < (deps.get_length() as int)
            {
                let d deps[i as size_t]
                if d <> null
                    this.request_emit_helper(d as ref[EmitHelper])
                set i: i + 1
            }
        }
        if EmitContext.helper_list_contains(emit_helpers, helper) = false
            emit_helpers.add(helper)
    }

    ; ReadEmitHelpers: the requested helpers in order, and the set cleared.
    procedure read_emit_helpers(this) returns ref[Array[ref[EmitHelper]?]]
    {
        let out emit_helpers
        set this.emit_helpers: &Array[ref[EmitHelper]?]^host()
        out
    }

    procedure add_emit_helper(this, node: ref[AstNode], helper: ref[EmitHelper])
    {
        let row this.get_emit_node(node)
        if row.helpers = null
            set row.helpers: &Array[ref[EmitHelper]?]^host()
        let list row.helpers as ref[Array[ref[EmitHelper]?]]
        if EmitContext.helper_list_contains(list, helper) = false
            list.add(helper)
    }

    ; MoveEmitHelpers(source, target, predicate): the predicate is a tag (§3.18)
    ; — 0 moves every helper, 1 the unscoped ones — each caller names its arm.
    procedure move_emit_helpers(this, source: ref[AstNode], target: ref[AstNode], predicate: int)
    {
        let src_row this.try_get_emit_node(source)
        if src_row = null
            return
        let sr src_row as ref[EmitNode]
        if sr.helpers = null
            return
        let src sr.helpers as ref[Array[ref[EmitHelper]?]]
        if (src.get_length() as int) = 0
            return
        let target_row this.get_emit_node(target)
        if target_row.helpers = null
            set target_row.helpers: &Array[ref[EmitHelper]?]^host()
        let dst target_row.helpers as ref[Array[ref[EmitHelper]?]]
        let kept &Array[ref[EmitHelper]?]^host()
        var i 0
        while i < (src.get_length() as int)
        {
            let h src[i as size_t]
            var moves false
            if h <> null
            {
                if predicate = 0
                    set moves: true
                if predicate = 1
                {
                    if (h as ref[EmitHelper]).scoped = false
                        set moves: true
                }
            }
            if moves
            {
                if EmitContext.helper_list_contains(dst, h as ref[EmitHelper]) = false
                    dst.add(h)
            }
            else
                kept.add(h)
            set i: i + 1
        }
        set sr.helpers: kept
    }

    function get_emit_helpers(this, node: ref[AstNode]) returns ref[Array[ref[EmitHelper]?]]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).helpers
    }

    function get_external_helpers_module_name(this, file: ref[AstNode]) returns ref[AstNode]?
    {
        let parse_node this.parse_node(file)
        if parse_node = null
            return null
        let row this.try_get_emit_node(parse_node as ref[AstNode])
        if row = null
            return null
        (row as ref[EmitNode]).external_helpers_module_name
    }

    procedure set_external_helpers_module_name(this, file: ref[AstNode], name: ref[AstNode]?)
    {
        let parse_node this.parse_node(file)
        if parse_node = null
            return
        set this.get_emit_node(parse_node as ref[AstNode]).external_helpers_module_name: name
    }

    function has_recorded_external_helpers(this, file: ref[AstNode]) returns bool
    {
        let parse_node this.parse_node(file)
        if parse_node = null
            return false
        let row this.try_get_emit_node(parse_node as ref[AstNode])
        if row = null
            return false
        let r row as ref[EmitNode]
        if r.external_helpers_module_name <> null
            return true
        (r.emit_flags & EFExternalHelpers) <> 0
    }

    function is_call_to_helper(this, first_segment: ref[AstNode], helper_name: Slice[char]) returns bool
    {
        if first_segment.kind <> KindCallExpression
            return false
        let callee AstNode.expression_of(first_segment)
        if callee = null
            return false
        let c callee as ref[AstNode]
        if c.kind <> KindIdentifier
            return false
        if (this.emit_flags(c) & EFHelperName) = 0
            return false
        AstNode.identifier_text_of(c) = helper_name
    }

    ; ── the visitor hooks ──

    function new_node_visitor(this, visit_tag: int) returns ref[NodeVisitor]
    {
        let v NodeVisitor.create(host, this.the_factory(), visit_tag, HooksTagEmitContext)
        set v.context: this
        v
    }

    procedure visit_variable_environment(this, nodes: ref[Array[ref[AstNode]?]]?, visitor: ref[NodeVisitor]) returns ref[Array[ref[AstNode]?]]?
    {
        this.start_variable_environment()
        this.end_and_merge_variable_environment(visitor.visit_nodes(nodes))
    }

    procedure visit_parameters(this, nodes_in: ref[Array[ref[AstNode]?]]?, visitor: ref[NodeVisitor]) returns ref[Array[ref[AstNode]?]]?
    {
        this.start_variable_environment()
        let scope this.peek_var_scope() as ref[VarScope]
        let old_flags scope.flags
        set scope.flags: scope.flags | EnvironmentFlagsInParameters
        var nodes visitor.visit_nodes(nodes_in)
        if (scope.flags & EnvironmentFlagsVariablesHoistedInParameters) <> 0
            set nodes: this.add_default_value_assignments_if_needed(nodes)
        set scope.flags: old_flags
        nodes
    }

    procedure add_default_value_assignments_if_needed(this, node_list: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        if node_list = null
            return node_list
        let nodes node_list as ref[Array[ref[AstNode]?]]
        var result: ref[Array[ref[AstNode]?]]? null
        var i 0
        while i < (nodes.get_length() as int)
        {
            let parameter nodes[i as size_t]
            if parameter <> null
            {
                let updated this.add_default_value_assignment_if_needed(parameter as ref[AstNode])
                if updated <> parameter
                {
                    if result = null
                    {
                        let copy &Array[ref[AstNode]?]^host()
                        var k 0
                        while k < (nodes.get_length() as int)
                        {
                            copy.add(nodes[k as size_t])
                            set k: k + 1
                        }
                        set result: copy
                    }
                    (result as ref[Array[ref[AstNode]?]]).put(i as size_t, updated)
                }
            }
            set i: i + 1
        }
        if result <> null
            return this.the_factory().new_node_list_like(result as ref[Array[ref[AstNode]?]], node_list)
        node_list
    }

    procedure add_default_value_assignment_if_needed(this, parameter: ref[AstNode]) returns ref[AstNode]
    {
        if AstNode.dot_dot_dot_token_of(parameter) <> null
            return parameter
        let name AstNode.name_of(parameter)
        if name <> null
        {
            let nk (name as ref[AstNode]).kind
            if (nk = KindObjectBindingPattern) or (nk = KindArrayBindingPattern)
                return this.add_default_value_assignment_for_binding_pattern(parameter)
        }
        let initializer AstNode.initializer_of(parameter)
        if initializer <> null
            return this.add_default_value_assignment_for_initializer(parameter, name as ref[AstNode], initializer as ref[AstNode])
        parameter
    }

    procedure add_default_value_assignment_for_binding_pattern(this, parameter: ref[AstNode]) returns ref[AstNode]
    {
        let f this.the_factory()
        var init_node: ref[AstNode]? null
        let initializer AstNode.initializer_of(parameter)
        if initializer <> null
        {
            set init_node: f.new_conditional_expression(
                f.new_strict_equality_expression(f.new_generated_name_for_node(parameter), f.new_void_zero_expression()),
                f.new_token(KindQuestionToken),
                initializer,
                f.new_token(KindColonToken),
                f.new_generated_name_for_node(parameter))
        }
        else
            set init_node: f.new_generated_name_for_node(parameter)
        let decls &Array[ref[AstNode]?]^host()
        decls.add(f.new_variable_declaration(AstNode.name_of(parameter), null, AstNode.type_of(parameter), init_node))
        this.add_initialization_statement(f.new_variable_statement(null, f.new_variable_declaration_list(decls, NodeFlagsNone)))
        f.update_parameter_declaration(parameter, AstNode.modifiers_of(parameter), AstNode.dot_dot_dot_token_of(parameter), f.new_generated_name_for_node(parameter), AstNode.parameter_question_token_of(parameter), AstNode.type_of(parameter), null)
    }

    procedure add_default_value_assignment_for_initializer(this, parameter: ref[AstNode], name: ref[AstNode], initializer: ref[AstNode]) returns ref[AstNode]
    {
        let f this.the_factory()
        this.add_emit_flags(initializer, EFNoSourceMap | EFNoComments)
        let name_clone f.clone(name)
        this.add_emit_flags(name_clone, EFNoSourceMap)
        let init_assignment f.new_assignment_expression(name_clone, initializer)
        set init_assignment.pos: parameter.pos
        set init_assignment.end: parameter.end
        this.add_emit_flags(init_assignment, EFNoComments)
        let stmts &Array[ref[AstNode]?]^host()
        stmts.add(f.new_expression_statement(init_assignment))
        let init_block f.new_block(stmts, false)
        set init_block.pos: parameter.pos
        set init_block.end: parameter.end
        this.add_emit_flags(init_block, EFSingleLine | EFNoTrailingSourceMap | EFNoTokenSourceMaps | EFNoComments)
        this.add_initialization_statement(f.new_if_statement(f.new_type_check(f.clone(name), "undefined"), init_block, null))
        f.update_parameter_declaration(parameter, AstNode.modifiers_of(parameter), AstNode.dot_dot_dot_token_of(parameter), name, AstNode.parameter_question_token_of(parameter), AstNode.type_of(parameter), null)
    }

    procedure add_initialization_statement(this, node: ref[AstNode])
    {
        let scope this.peek_var_scope() as ref[VarScope]
        this.add_emit_flags(node, EFCustomPrologue)
        scope.initialization_statements.add(node)
    }

    ; VisitFunctionBody: the body visited, then the variable environment's
    ; declarations merged in — a block gets them merged, an expression body
    ; becomes a block over `return`, no body becomes a block of them.
    procedure visit_function_body(this, node: ref[AstNode]?, visitor: ref[NodeVisitor]) returns ref[AstNode]?
    {
        let updated visitor.visit_node(node)
        let declarations this.end_variable_environment()
        if (declarations.get_length() as int) = 0
            return updated
        let f this.the_factory()
        if updated = null
            return f.new_block(declarations, true)
        let u updated as ref[AstNode]
        if u.kind <> KindBlock
        {
            let one &Array[ref[AstNode]?]^host()
            one.add(f.new_return_statement(u))
            var changed false
            let statements this.merge_environment(one, declarations, &changed)
            return f.new_block(statements as ref[Array[ref[AstNode]?]], false)
        }
        f.update_block(u, this.merge_environment_list(AstNode.statements_of(u), declarations), AstNode.multi_line_of(u))
    }

    procedure visit_iteration_body(this, body: ref[AstNode]?, visitor: ref[NodeVisitor]) returns ref[AstNode]?
    {
        if body = null
            return null
        this.start_lexical_environment()
        let updated this.visit_embedded_statement(body, visitor)
        let statements this.end_lexical_environment()
        if updated = null
            return null
        let u updated as ref[AstNode]
        if (statements.get_length() as int) > 0
        {
            let f this.the_factory()
            if u.kind = KindBlock
            {
                let inner AstNode.statements_of(u)
                if inner <> null
                {
                    let il inner as ref[Array[ref[AstNode]?]]
                    var i 0
                    while i < (il.get_length() as int)
                    {
                        statements.add(il[i as size_t])
                        set i: i + 1
                    }
                }
                let list f.new_node_list_like(statements, inner)
                return f.update_block(u, list, AstNode.multi_line_of(u))
            }
            statements.add(u)
            return f.new_block(statements, true)
        }
        updated
    }

    ; VisitEmbeddedStatement: a dropped or not-emitted statement becomes an
    ; empty statement at the original's location, with its comments.
    procedure visit_embedded_statement(this, node: ref[AstNode]?, visitor: ref[NodeVisitor]) returns ref[AstNode]?
    {
        if node = null
            return null
        let n node as ref[AstNode]
        let embedded visitor.visit_embedded_statement(node)
        var missing embedded = null
        if missing = false
        {
            if (embedded as ref[AstNode]).kind = KindNotEmittedStatement
                set missing: true
        }
        if missing
        {
            let empty this.the_factory().new_empty_statement()
            set empty.pos: n.pos
            set empty.end: n.end
            this.set_original(empty, n)
            this.assign_comment_range(empty, n)
            return empty
        }
        embedded
    }

    ; ── synthetic comments and the type node ──

    procedure set_synthetic_leading_comments(this, node: ref[AstNode], comments: ref[Array[SynthesizedComment]]?) returns ref[AstNode]
    {
        set this.get_emit_node(node).leading_comments: comments
        node
    }

    procedure add_synthetic_leading_comment(this, node: ref[AstNode], kind: int, text: Slice[char], has_trailing_new_line: bool) returns ref[AstNode]
    {
        let row this.get_emit_node(node)
        if row.leading_comments = null
            set row.leading_comments: &Array[SynthesizedComment]^host()
        (row.leading_comments as ref[Array[SynthesizedComment]]).add(SynthesizedComment(kind, 0 - 1, 0 - 1, false, has_trailing_new_line, text))
        node
    }

    function get_synthetic_leading_comments(this, node: ref[AstNode]) returns ref[Array[SynthesizedComment]]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).leading_comments
    }

    procedure set_synthetic_trailing_comments(this, node: ref[AstNode], comments: ref[Array[SynthesizedComment]]?) returns ref[AstNode]
    {
        set this.get_emit_node(node).trailing_comments: comments
        node
    }

    procedure add_synthetic_trailing_comment(this, node: ref[AstNode], kind: int, text: Slice[char], has_trailing_new_line: bool) returns ref[AstNode]
    {
        let row this.get_emit_node(node)
        if row.trailing_comments = null
            set row.trailing_comments: &Array[SynthesizedComment]^host()
        (row.trailing_comments as ref[Array[SynthesizedComment]]).add(SynthesizedComment(kind, 0 - 1, 0 - 1, false, has_trailing_new_line, text))
        node
    }

    function get_synthetic_trailing_comments(this, node: ref[AstNode]) returns ref[Array[SynthesizedComment]]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).trailing_comments
    }

    procedure set_type_node(this, node: ref[AstNode], type_node: ref[AstNode]?)
        set this.get_emit_node(node).type_node: type_node

    function get_type_node(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).type_node
    }

    procedure new_not_emitted_statement(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let statement this.the_factory().new_not_emitted_statement()
        set statement.pos: node.pos
        set statement.end: node.end
        this.set_original(statement, node)
        this.assign_comment_range(statement, node)
        statement
    }
}

; ── namegenerator.go (slice 232) ────────────────────────────────────────────
;
; The reference's two callbacks are the Printer's `isFileLevelUniqueNameInCurrentFile`
; and `getTextOfNode`; here `printer` is that printer (null in the tests that make
; a bare generator), asked through the two methods printer.go's slice gives it.
; The reference keys its caches by node id; this port has no node ids, so the
; per-node caches are lists of (node, name) pairs — a file's generated names are
; few. Names are page-hosted views (`Printer.slice_of` over a builder's product).
define TempFlagsAuto: int 0
define TempFlagsCountMask: int 0x0FFFFFFF
define TempFlagsI: int 0x10000000

define NamedFlags
(
    key: Slice[char]
    flags: int
)

define NodeName
(
    node: ref[AstNode]
    name: Slice[char]
)

define IdName
(
    id: int
    name: Slice[char]
)

define NameGenerationScope
(
    next: ref[NameGenerationScope]?
    temp_flags: int
    formatted_name_temp_flags: ref[Array[NamedFlags]]
    reserved_names: ref[Array[Slice[char]]]
)

define NameGenerator
(
    host: ref[Page]
    context: ref[EmitContext]?
    printer: ref[Printer]?
    node_to_generated_name: ref[Array[NodeName]]
    node_to_generated_private_name: ref[Array[NodeName]]
    auto_generated_id_to_generated_name: ref[Array[IdName]]
    name_generation_scope: ref[NameGenerationScope]?
    private_name_generation_scope: ref[NameGenerationScope]?
    generated_names: ref[Array[Slice[char]]]
)
{
    function create(host: ref[Page], context: ref[EmitContext]?, printer: ref[Printer]?) returns ref[NameGenerator]
    {
        let a &Array[NodeName]^host()
        let b &Array[NodeName]^host()
        let c &Array[IdName]^host()
        let g &Array[Slice[char]]^host()
        &NameGenerator^host(host, context, printer, a, b, c, null, null, g)
    }

    function new_scope(this, next: ref[NameGenerationScope]?) returns ref[NameGenerationScope]
    {
        let f &Array[NamedFlags]^host()
        let r &Array[Slice[char]]^host()
        &NameGenerationScope^host(next, TempFlagsAuto, f, r)
    }

    procedure push_scope(this, reuse_temp_variable_scope: bool)
    {
        set this.private_name_generation_scope: this.new_scope(private_name_generation_scope)
        if reuse_temp_variable_scope = false
            set this.name_generation_scope: this.new_scope(name_generation_scope)
    }

    procedure pop_scope(this, reuse_temp_variable_scope: bool)
    {
        if private_name_generation_scope <> null
            set this.private_name_generation_scope: (private_name_generation_scope as ref[NameGenerationScope]).next
        if reuse_temp_variable_scope = false
        {
            if name_generation_scope <> null
                set this.name_generation_scope: (name_generation_scope as ref[NameGenerationScope]).next
        }
    }

    function scope_of(this, private_name: bool) returns ref[NameGenerationScope]?
    {
        if private_name
            return private_name_generation_scope
        name_generation_scope
    }

    ; `*scope = &nameGenerationScope{}` — a missing scope is made on first write.
    procedure ensure_scope(this, private_name: bool) returns ref[NameGenerationScope]
    {
        let existing this.scope_of(private_name)
        if existing <> null
            return existing as ref[NameGenerationScope]
        let made this.new_scope(null)
        if private_name
            set this.private_name_generation_scope: made
        else
            set this.name_generation_scope: made
        made
    }

    function get_temp_flags(this, private_name: bool) returns int
    {
        let scope this.scope_of(private_name)
        if scope = null
            return TempFlagsAuto
        (scope as ref[NameGenerationScope]).temp_flags
    }

    procedure set_temp_flags(this, private_name: bool, flags: int)
        set this.ensure_scope(private_name).temp_flags: flags

    function get_temp_flags_for_formatted_name(this, private_name: bool, key: Slice[char]) returns int
    {
        let scope this.scope_of(private_name)
        if scope = null
            return TempFlagsAuto
        let list (scope as ref[NameGenerationScope]).formatted_name_temp_flags
        var i 0
        while i < (list.get_length() as int)
        {
            let e list[i as size_t]
            if e.key = key
                return e.flags
            set i: i + 1
        }
        TempFlagsAuto
    }

    procedure set_temp_flags_for_formatted_name(this, private_name: bool, key: Slice[char], flags: int)
    {
        let scope this.ensure_scope(private_name)
        let list scope.formatted_name_temp_flags
        var i 0
        while i < (list.get_length() as int)
        {
            let e list[i as size_t]
            if e.key = key
            {
                list.put(i as size_t, NamedFlags(key, flags))
                return
            }
            set i: i + 1
        }
        list.add(NamedFlags(key, flags))
    }

    function names_contain(list: ref[Array[Slice[char]]], name: Slice[char]) returns bool
    {
        var i 0
        while i < (list.get_length() as int)
        {
            if list[i as size_t] = name
                return true
            set i: i + 1
        }
        false
    }

    ; reserveName. The unscoped, non-temp arm goes into the file-wide set —
    ; the reference's own note: matches Strada, and is incorrect.
    procedure reserve_name(this, name: Slice[char], private_name: bool, scoped: bool, temp: bool)
    {
        let scope this.ensure_scope(private_name)
        if private_name or scoped
        {
            scope.reserved_names.add(name)
            return
        }
        if temp = false
            generated_names.add(name)
    }

    ; The two callbacks the printer installs (`GetTextOfNode`,
    ; `IsFileLevelUniqueNameInCurrentFile`): the printer itself when there is
    ; one (§3.18), else the reference's nil-callback arms — the node's own
    ; text, and "unique".
    function get_text_of_node(this, node: ref[AstNode]) returns Slice[char]
    {
        if printer <> null
            return (printer as ref[Printer]).get_text_of_node(node, false)
        if node.kind = KindIdentifier
            return AstNode.identifier_text_of(node)
        if node.kind = KindPrivateIdentifier
            return AstNode.identifier_text_of(node)
        AstNode.literal_text_of(node)
    }

    function is_file_level_unique_name_in_current_file(this, name: Slice[char], private_name: bool) returns bool
    {
        if printer = null
            return true
        (printer as ref[Printer]).is_file_level_unique_name_in_current_file(name, private_name)
    }

    function has_file_level_check(this) returns bool
        printer <> null

    ; GenerateName: the name of an auto-generated identifier — computed once
    ; per generated node, or per auto-generate id.
    procedure generate_name(this, name: ref[AstNode]) returns Slice[char]
    {
        if context <> null
        {
            let ctx context as ref[EmitContext]
            let info ctx.get_auto_generate_info(name)
            if info <> null
            {
                let ag info as ref[AutoGenerateInfo]
                if (ag.flags & GeneratedIdentifierFlagsKindMask) = GeneratedIdentifierFlagsNode
                    return this.generate_name_for_node_cached(ctx.get_node_for_generated_name(name), name.kind = KindPrivateIdentifier, ag.flags, ag.prefix, ag.suffix)
                var i 0
                while i < (auto_generated_id_to_generated_name.get_length() as int)
                {
                    let e auto_generated_id_to_generated_name[i as size_t]
                    if e.id = ag.id
                        return e.name
                    set i: i + 1
                }
                let generated this.make_name(name)
                auto_generated_id_to_generated_name.add(IdName(ag.id, generated))
                return generated
            }
        }
        this.get_text_of_node(name)
    }

    procedure generate_name_for_node_cached(this, node: ref[AstNode], private_name: bool, flags: int, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        var cache node_to_generated_name
        if private_name
            set cache: node_to_generated_private_name
        var i 0
        while i < (cache.get_length() as int)
        {
            let e cache[i as size_t]
            if e.node = node
                return e.name
            set i: i + 1
        }
        let name this.generate_name_for_node(node, private_name, flags, prefix, suffix)
        cache.add(NodeName(node, name))
        name
    }

    procedure generate_name_for_node(this, node: ref[AstNode], private_name: bool, flags: int, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        let k node.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
            return this.make_unique_name(this.get_text_of_node(node), false, (flags & GeneratedIdentifierFlagsOptimistic) <> 0, (flags & GeneratedIdentifierFlagsReservedInNestedScopes) <> 0, private_name, prefix, suffix)
        if (k = KindModuleDeclaration) or (k = KindEnumDeclaration)
            return this.generate_name_for_module_or_enum(node)
        if (k = KindImportDeclaration) or (k = KindJSImportDeclaration) or (k = KindExportDeclaration)
            return this.generate_name_for_import_or_export_declaration(node)
        if (k = KindFunctionDeclaration) or (k = KindClassDeclaration)
        {
            let name AstNode.name_of(node)
            if name <> null
                return this.generate_name_for_node(name as ref[AstNode], false, flags, "", "")
            return this.generate_name_for_export_default()
        }
        if k = KindExportAssignment
            return this.generate_name_for_export_default()
        if k = KindClassExpression
            return this.generate_name_for_class_expression()
        if (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
            return this.generate_name_for_method_or_accessor(node, private_name, prefix, suffix)
        if k = KindComputedPropertyName
            return this.make_temp_variable_name(TempFlagsAuto, true, private_name, prefix, suffix)
        this.make_temp_variable_name(TempFlagsAuto, false, private_name, prefix, suffix)
    }

    procedure generate_name_for_module_or_enum(this, node: ref[AstNode]) returns Slice[char]
    {
        let name this.get_text_of_node(AstNode.name_of(node) as ref[AstNode])
        if NameGenerator.is_unique_local_name(name, node)
            return name
        this.make_unique_name(name, false, false, false, false, "", "")
    }

    procedure generate_name_for_import_or_export_declaration(this, node: ref[AstNode]) returns Slice[char]
    {
        let expr AstNode.get_external_module_name(node)
        var base_name: Slice[char] "module"
        if expr <> null
        {
            if (expr as ref[AstNode]).kind = KindStringLiteral
                set base_name: Printer.slice_of(Printer.make_identifier_from_module_name(host, AstNode.literal_text_of(expr)))
        }
        this.make_unique_name(base_name, false, false, false, false, "", "")
    }

    procedure generate_name_for_export_default(this) returns Slice[char]
        this.make_unique_name("default", false, false, false, false, "", "")

    procedure generate_name_for_class_expression(this) returns Slice[char]
        this.make_unique_name("class", false, false, false, false, "", "")

    procedure generate_name_for_method_or_accessor(this, node: ref[AstNode], private_name: bool, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        let name AstNode.name_of(node)
        if name <> null
        {
            if (name as ref[AstNode]).kind = KindIdentifier
                return this.generate_name_for_node_cached(name as ref[AstNode], private_name, GeneratedIdentifierFlagsNone, prefix, suffix)
        }
        this.make_temp_variable_name(TempFlagsAuto, false, private_name, prefix, suffix)
    }

    ; makeName: an Auto/Loop/Unique generated identifier's name.
    procedure make_name(this, name: ref[AstNode]) returns Slice[char]
    {
        if context <> null
        {
            let info (context as ref[EmitContext]).get_auto_generate_info(name)
            if info <> null
            {
                let ag info as ref[AutoGenerateInfo]
                let kind ag.flags & GeneratedIdentifierFlagsKindMask
                let reserved (ag.flags & GeneratedIdentifierFlagsReservedInNestedScopes) <> 0
                if kind = GeneratedIdentifierFlagsAuto
                    return this.make_temp_variable_name(TempFlagsAuto, reserved, name.kind = KindPrivateIdentifier, ag.prefix, ag.suffix)
                if kind = GeneratedIdentifierFlagsLoop
                    return this.make_temp_variable_name(TempFlagsI, reserved, false, ag.prefix, ag.suffix)
                if kind = GeneratedIdentifierFlagsUnique
                    return this.make_unique_name(AstNode.identifier_text_of(name), (ag.flags & GeneratedIdentifierFlagsFileLevel) <> 0, (ag.flags & GeneratedIdentifierFlagsOptimistic) <> 0, reserved, name.kind = KindPrivateIdentifier, ag.prefix, ag.suffix)
            }
        }
        this.get_text_of_node(name)
    }

    function temp_name_of(this, count: int) returns Slice[char]
    {
        let b StringBuilder^host()
        b.append("_" as char)
        if count < 26
            b.append((97 + count) as char)
        else
            b.append(count - 26)
        Printer.slice_of(b.to_string())
    }

    ; makeTempVariableName: `_a` … `_z`, then `_0` …, skipping `_i` and `_n`
    ; (counts 8 and 13); a loop variable prefers `_i` once per scope.
    procedure make_temp_variable_name(this, flags: int, reserved_in_nested_scopes: bool, private_name: bool, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        var temp_flags TempFlagsAuto
        var key: Slice[char] ""
        var simple ((prefix.length as int) = 0) and ((suffix.length as int) = 0)
        if simple
            set temp_flags: this.get_temp_flags(private_name)
        else
        {
            set key: Printer.slice_of(Printer.format_generated_name(host, private_name, prefix, "", suffix))
            if private_name
            {
                if Printer.has_leading_hash(key) = false
                {
                    let b StringBuilder^host()
                    b.append("#" as char)
                    b.append(key.data, key.length)
                    set key: Printer.slice_of(b.to_string())
                }
            }
            set temp_flags: this.get_temp_flags_for_formatted_name(private_name, key)
        }
        if flags <> 0
        {
            if (temp_flags & flags) = 0
            {
                let full_name Printer.slice_of(Printer.format_generated_name(host, private_name, prefix, "_i", suffix))
                if this.is_unique_name(full_name, private_name)
                {
                    set temp_flags: temp_flags | flags
                    this.reserve_name(full_name, private_name, reserved_in_nested_scopes, true)
                    if simple
                        this.set_temp_flags(private_name, temp_flags)
                    else
                        this.set_temp_flags_for_formatted_name(private_name, key, temp_flags)
                    return full_name
                }
            }
        }
        while true
        {
            let count temp_flags & TempFlagsCountMask
            set temp_flags: temp_flags + 1
            if (count <> 8) and (count <> 13)
            {
                let name this.temp_name_of(count)
                let full_name Printer.slice_of(Printer.format_generated_name(host, private_name, prefix, name, suffix))
                if this.is_unique_name(full_name, private_name)
                {
                    this.reserve_name(full_name, private_name, reserved_in_nested_scopes, true)
                    if simple
                        this.set_temp_flags(private_name, temp_flags)
                    else
                        this.set_temp_flags_for_formatted_name(private_name, key, temp_flags)
                    return full_name
                }
            }
        }
        ""
    }

    ; makeUniqueName: `base`, or `base_1`, `base_2`, …; `file_level` is the
    ; reference's checkFn being the file-level callback.
    procedure make_unique_name(this, base_name_in: Slice[char], file_level: bool, optimistic: bool, scoped: bool, private_name: bool, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        var base_name Printer.remove_leading_hash(base_name_in)
        if optimistic
        {
            let full_name Printer.slice_of(Printer.format_generated_name(host, private_name, prefix, base_name, suffix))
            if this.check_unique_name(full_name, private_name, file_level)
            {
                this.reserve_name(full_name, private_name, scoped, false)
                return full_name
            }
        }
        var ends_in_underscore false
        if (base_name.length as int) > 0
        {
            if ((base_name[(base_name.length as int - 1) as size_t] as int) & 255) = ("_" as char) as int
                set ends_in_underscore: true
        }
        if ends_in_underscore = false
        {
            let b StringBuilder^host()
            b.append(base_name.data, base_name.length)
            b.append("_" as char)
            set base_name: Printer.slice_of(b.to_string())
        }
        var i 1
        while true
        {
            let b StringBuilder^host()
            b.append(base_name.data, base_name.length)
            b.append(i)
            let full_name Printer.slice_of(Printer.format_generated_name(host, private_name, prefix, Printer.slice_of(b.to_string()), suffix))
            if this.check_unique_name(full_name, private_name, file_level)
            {
                this.reserve_name(full_name, private_name, scoped, false)
                return full_name
            }
            set i: i + 1
        }
        ""
    }

    procedure make_file_level_optimistic_unique_name(this, name: Slice[char]) returns Slice[char]
        this.make_unique_name(name, true, true, false, false, "", "")

    function check_unique_name(this, name: Slice[char], private_name: bool, file_level: bool) returns bool
    {
        if file_level
            return this.is_file_level_unique_name_in_current_file(name, private_name)
        this.is_unique_name(name, private_name)
    }

    ; isUniqueLocalName: no local of a VALUE, export-value or alias meaning under
    ; the container carries the name. The reference walks the binder's
    ; NextContainer chain restricted to the container's descendants; this port
    ; has no such chain and walks the container's subtree for every node that
    ; holds locals, which is the same set.
    function is_unique_local_name(name: Slice[char], container: ref[AstNode]) returns bool
        NameGenerator.no_local_named(name, container)

    function no_local_named(name: Slice[char], node: ref[AstNode]) returns bool
    {
        let locals AstNode.locals_of(node)
        if locals <> null
        {
            let local SymbolTable.get(locals, name)
            if local <> null
            {
                if ((local as ref[Symbol]).flags & (SymbolFlagsValue | SymbolFlagsExportValue | SymbolFlagsAlias)) <> 0
                    return false
            }
        }
        var i 0
        while true
        {
            let c AstNode.child_at(node, i)
            if c = null
                break
            if NameGenerator.no_local_named(name, c as ref[AstNode]) = false
                return false
            set i: i + 1
        }
        true
    }

    function is_unique_name(this, name: Slice[char], private_name: bool) returns bool
    {
        if this.is_file_level_unique_name_in_current_file(name, private_name) = false
            return false
        this.is_reserved_name(name, private_name) = false
    }

    function is_reserved_name(this, name: Slice[char], private_name: bool) returns bool
    {
        if NameGenerator.names_contain(generated_names, name)
            return true
        var scope this.scope_of(private_name)
        while scope <> null
        {
            let sc scope as ref[NameGenerationScope]
            if NameGenerator.names_contain(sc.reserved_names, name)
                return true
            set scope: sc.next
        }
        false
    }
}
