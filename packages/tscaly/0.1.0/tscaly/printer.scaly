define LFJsxElementOrFragmentChildren: int 262144  ; LFSingleLine | LFNoInterveningComments
define LFJsxElementAttributes: int 262656  ; LFSingleLine | LFSpaceBetweenSiblings | LFNoInterveningComments
define LFCaseOrDefaultClauseStatements: int 163969  ; LFIndented | LFMultiLine | LFNoTrailingNewLine | LFOptionalIfEmpty
define LFHeritageClauseTypes: int 528  ; LFCommaDelimited | LFSpaceBetweenSiblings | LFSingleLine
define LFSourceFileStatements: int 131073  ; LFMultiLine | LFNoTrailingNewLine
define LFDecorators: int 2146305  ; LFMultiLine | LFOptional | LFSpaceAfterList
define LFTypeArguments: int 53776  ; LFCommaDelimited | LFSpaceBetweenSiblings | LFSingleLine | LFAngleBrackets | LFOptional
define LFTypeParameters: int 53776  ; LFCommaDelimited | LFSpaceBetweenSiblings | LFSingleLine | LFAngleBrackets | LFOptional
define LFParameters: int 2576  ; LFCommaDelimited | LFSpaceBetweenSiblings | LFSingleLine | LFParenthesis
define LFSingleArrowParameter: int 528  ; LFCommaDelimited | LFSpaceBetweenSiblings | LFSingleLine
define LFIndexSignatureParameters: int 8848  ; LFCommaDelimited | LFSpaceBetweenSiblings | LFSingleLine | LFIndented | LFSquareBrackets
define LFJSDocComment: int 33  ; LFMultiLine | LFAsteriskDelimited

define PrinterOptions
(
    remove_comments: bool
    new_line: int
    no_emit_helpers: bool
    target: int
    source_map: bool
    inline_source_map: bool
    inline_sources: bool
    omit_brace_source_map_positions: bool
    only_print_jsdoc_style: bool
    never_ascii_escape: bool
    preserve_source_newlines: bool
    terminate_unterminated_literals: bool
)
{
    function defaults() returns PrinterOptions
        PrinterOptions(false, NewLineKindNone, false, ScriptTargetNone, false, false, false, false, false, false, false, false)

    ; core.NewLineKind.GetNewLineCharacter
    function new_line_character(this) returns Slice[char]
    {
        if new_line = NewLineKindCRLF
            return "\r\n"
        "\n"
    }
}

; The five things the printer reads off `*ast.SourceFile` (§3.40), plus the
; parser's identifier table, which the emitter fills from the tree.
define SourceFileInfo
(
    node: ref[AstNode]
    file_name: Slice[char]
    text: Slice[char]
    line_starts: ref[Array[int]]
    is_declaration_file: bool
    script_kind: int
    is_external_module: bool
    identifiers: ref[Array[Slice[char]]]?
    ; whether a null `identifiers` is collected on the first question (the
    ; program's emit) or stays the empty set (the case harness's file info)
    collect_identifiers: bool
)
{
    ; `sourceFile.Identifiers[name]`. The set is collected on the first question
    ; (slice 331): only the emitter's name generation asks, and collecting it for
    ; every file of a --noEmit program was ~200 MB on ganz VS Code
    procedure has_identifier(mutable this, name: Slice[char]) returns bool
    {
        if identifiers = null
        {
            if collect_identifiers = false
                return false
            let pg Page.get(this)
            let ids &Array[Slice[char]]^pg()
            Emitter.collect_identifiers(pg, node, ids)
            set identifiers: ids
        }
        NameGenerator.names_contain(identifiers as ref[Array[Slice[char]]], name)
    }
}

; sourcemap.Generator: the printer's mappings, the JSON the emitter writes as a
; map file or inlines as a data URL
define SourceMapGenerator
(
    host: ref[Page]
    unported_calls: int
    file: Slice[char]
    source_root: Slice[char]
    sources_directory_path: Slice[char]
    current_directory: Slice[char]
    raw_sources: ref[Array[Slice[char]]]
    sources: ref[Array[Slice[char]]]
    sources_content: ref[Array[Slice[char]]]
    has_sources_content: bool
    mappings: ref[StringBuilder]
    last_generated_line: int
    last_generated_character: int
    last_source_index: int
    last_source_line: int
    last_source_character: int
    last_name_index: int
    has_last: bool
    pending_generated_line: int
    pending_generated_character: int
    pending_source_index: int
    pending_source_line: int
    pending_source_character: int
    pending_name_index: int
    has_pending: bool
    has_pending_source: bool
    has_pending_name: bool
)
{
    ; sourcemap.NewGenerator(file, sourceRoot, sourcesDirectoryPath, options) — the
    ; names table stays empty (the printer never adds one) and the JSON leaves it `[]`
    function create(host: ref[Page], file: Slice[char], source_root: Slice[char], sources_directory_path: Slice[char], current_directory: Slice[char]) returns ref[SourceMapGenerator]
        &SourceMapGenerator^host(host, 0, file, source_root, sources_directory_path, current_directory, &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), false, StringBuilder^host(), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0, 0, 0, false, false, false)

    ; AddSource: the file relative to the sources directory, once per file
    procedure add_source(mutable this, mutable file_name: Slice[char]) returns int
    {
        let source get_relative_path_to_directory_or_url(host, sources_directory_path, file_name, true, current_directory)
        var i 0
        while i < (sources.get_length() as int)
        {
            let existing sources[i as size_t]
            if existing.equals(source)
                return i
            set i: i + 1
        }
        sources.add(source)
        raw_sources.add(file_name)
        sources.get_length() as int - 1
    }

    procedure set_source_content(mutable this, index: int, text: Slice[char])
    {
        if (index < 0) or (index >= (sources.get_length() as int))
            return
        while (sources_content.get_length() as int) <= index
            sources_content.add(Slice[char]())
        sources_content.put(index as size_t, text)
        set this.has_sources_content: true
    }

    function is_new_generated_position(this, generated_line: int, generated_character: int) returns bool
    {
        if has_pending = false
            return true
        (pending_generated_line <> generated_line) or (pending_generated_character <> generated_character)
    }

    function is_backtracking_source_position(this, source_index: int, source_line: int, source_character: int) returns bool
    {
        if (source_index < 0) or (source_line < 0) or (source_character < 0)
            return false
        if pending_source_index <> source_index
            return false
        if pending_source_line > source_line
            return true
        (pending_source_line = source_line) and (pending_source_character > source_character)
    }

    function should_commit_mapping(this) returns bool
    {
        if has_pending = false
            return false
        if has_last = false
            return true
        (last_generated_line <> pending_generated_line) or (last_generated_character <> pending_generated_character) or (last_source_index <> pending_source_index) or (last_source_line <> pending_source_line) or (last_source_character <> pending_source_character) or (last_name_index <> pending_name_index)
    }

    function base64_format_encode(value: int) returns char
    {
        if value < 26
            return (("A" as char) as int + value) as char
        if value < 52
            return (("a" as char) as int + value - 26) as char
        if value < 62
            return (("0" as char) as int + value - 52) as char
        if value = 62
            return "+" as char
        "/" as char
    }

    procedure append_base64_vlq(mutable this, in_value: int)
    {
        var value in_value
        if value < 0
            set value: ((0 - value) << 1) + 1
        else
            set value: value << 1
        while true
        {
            var current_digit value & 31
            set value: value >> 5
            if value > 0
                set current_digit: current_digit | 32
            mappings.append(SourceMapGenerator.base64_format_encode(current_digit))
            if value <= 0
                break
        }
    }

    procedure commit_pending_mapping(mutable this)
    {
        if this.should_commit_mapping() = false
            return
        if last_generated_line < pending_generated_line
        {
            while true
            {
                mappings.append(";" as char)
                set this.last_generated_line: last_generated_line + 1
                if last_generated_line >= pending_generated_line
                    break
            }
            set this.last_generated_character: 0
        }
        else
        {
            if has_last
                mappings.append("," as char)
        }
        this.append_base64_vlq(pending_generated_character - last_generated_character)
        set this.last_generated_character: pending_generated_character
        if has_pending_source
        {
            this.append_base64_vlq(pending_source_index - last_source_index)
            set this.last_source_index: pending_source_index
            this.append_base64_vlq(pending_source_line - last_source_line)
            set this.last_source_line: pending_source_line
            this.append_base64_vlq(pending_source_character - last_source_character)
            set this.last_source_character: pending_source_character
            if has_pending_name
            {
                this.append_base64_vlq(pending_name_index - last_name_index)
                set this.last_name_index: pending_name_index
            }
        }
        set this.has_last: true
    }

    procedure add_mapping(mutable this, generated_line: int, generated_character: int, source_index: int, source_line: int, source_character: int, name_index: int)
    {
        if this.is_new_generated_position(generated_line, generated_character) or this.is_backtracking_source_position(source_index, source_line, source_character)
        {
            this.commit_pending_mapping()
            set this.pending_generated_line: generated_line
            set this.pending_generated_character: generated_character
            set this.has_pending_source: false
            set this.has_pending_name: false
            set this.has_pending: true
        }
        if (source_index >= 0) and (source_line >= 0) and (source_character >= 0)
        {
            set this.pending_source_index: source_index
            set this.pending_source_line: source_line
            set this.pending_source_character: source_character
            set this.has_pending_source: true
            if name_index >= 0
            {
                set this.pending_name_index: name_index
                set this.has_pending_name: true
            }
        }
    }

    procedure add_generated_mapping(mutable this, generated_line: int, generated_character: int)
    {
        if (generated_line < pending_generated_line) or (generated_character < 0)
            return
        this.add_mapping(generated_line, generated_character, 0 - 1, 0 - 1, 0 - 1, 0 - 1)
    }

    procedure add_source_mapping(mutable this, generated_line: int, generated_character: int, source_index: int, source_line: int, source_character: int)
    {
        if (generated_line < pending_generated_line) or (generated_character < 0)
            return
        if (source_index < 0) or (source_index >= (sources.get_length() as int)) or (source_line < 0) or (source_character < 0)
            return
        this.add_mapping(generated_line, generated_character, source_index, source_line, source_character, 0 - 1)
    }

    ; a JSON string: `"` `\` and the control characters escaped (go-json-experiment's
    ; default: no HTML escaping)
    procedure append_json_string(mutable sb: ref[StringBuilder], s: Slice[char])
    {
        let hex: Slice[char] "0123456789abcdef"
        sb.append("\"" as char)
        var i 0
        while i < (s.length as int)
        {
            let c (s[i as size_t] as int) & 255
            if c = ("\"" as char) as int
                sb.append("\\\"")
            else
            {
                if c = ("\\" as char) as int
                    sb.append("\\\\")
                else
                {
                    if c = 10
                        sb.append("\\n")
                    else
                    {
                        if c = 13
                            sb.append("\\r")
                        else
                        {
                            if c = 9
                                sb.append("\\t")
                            else
                            {
                                if c < 32
                                {
                                    sb.append("\\u00")
                                    sb.append(hex[(c >> 4) as size_t])
                                    sb.append(hex[(c & 15) as size_t])
                                }
                                else
                                    sb.append(c as char)
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
        sb.append("\"" as char)
    }

    ; RawSourceMap as JSON, in the reference's field order
    procedure to_json(mutable this) returns String
    {
        this.commit_pending_mapping()
        let sb StringBuilder^host()
        sb.append("{\"version\":3,\"file\":")
        SourceMapGenerator.append_json_string(sb, file)
        sb.append(",\"sourceRoot\":")
        SourceMapGenerator.append_json_string(sb, source_root)
        sb.append(",\"sources\":[")
        var i 0
        while i < (sources.get_length() as int)
        {
            if i > 0
                sb.append("," as char)
            SourceMapGenerator.append_json_string(sb, sources[i as size_t])
            set i: i + 1
        }
        sb.append("],\"names\":[],\"mappings\":")
        let m mappings.to_string()
        SourceMapGenerator.append_json_string(sb, Slice[char](m.get_length() as int, m.get_buffer() as pointer[char]))
        if has_sources_content
        {
            sb.append(",\"sourcesContent\":[")
            var j 0
            while j < (sources_content.get_length() as int)
            {
                if j > 0
                    sb.append("," as char)
                SourceMapGenerator.append_json_string(sb, sources_content[j as size_t])
                set j: j + 1
            }
            sb.append("]" as char)
        }
        sb.append("}" as char)
        sb.to_string()
    }

    ; Base64DataURL: `data:application/json;base64,` + the JSON, standard alphabet, padded
    procedure base64_data_url(mutable this) returns String
    {
        let data this.to_json()
        let n data.get_length() as int
        let bytes Slice[char](n as size_t, data.get_buffer() as pointer[char])
        let sb StringBuilder^host()
        sb.append("data:application/json;base64,")
        var i 0
        while i < n
        {
            let b0 (bytes[i as size_t] as int) & 255
            var b1 0
            var b2 0
            if (i + 1) < n
                set b1: (bytes[(i + 1) as size_t] as int) & 255
            if (i + 2) < n
                set b2: (bytes[(i + 2) as size_t] as int) & 255
            let triple (b0 << 16) | (b1 << 8) | b2
            sb.append(SourceMapGenerator.base64_format_encode((triple >> 18) & 63))
            sb.append(SourceMapGenerator.base64_format_encode((triple >> 12) & 63))
            if (i + 1) < n
                sb.append(SourceMapGenerator.base64_format_encode((triple >> 6) & 63))
            else
                sb.append("=" as char)
            if (i + 2) < n
                sb.append(SourceMapGenerator.base64_format_encode(triple & 63))
            else
                sb.append("=" as char)
            set i: i + 3
        }
        sb.to_string()
    }
}

define DetachedCommentsInfo
(
    node_pos: int
    detached_comment_end_pos: int
)

; commentState — by VALUE with a presence bit (the reference hands out arena
; pointers and nil for "no state").
define CommentState
(
    present: bool
    emit_flags: int
    comment_range: TextRange
    container_pos: int
    container_end: int
    declaration_list_container_end: int
)
{
    function none() returns CommentState
        CommentState(false, 0, TextRange.undefined_range(), 0 - 1, 0 - 1, 0 - 1)

    function blank() returns CommentState
        CommentState(true, 0, TextRange.undefined_range(), 0 - 1, 0 - 1, 0 - 1)
}

define SourceMapState
(
    present: bool
    emit_flags: int
    source_map_range: TextRange
    has_token_source_map_range: bool
)
{
    function none() returns SourceMapState
        SourceMapState(false, 0, TextRange.undefined_range(), false)
}

define PrinterState
(
    comment: CommentState
    source_map: SourceMapState
)
{
    function none() returns PrinterState
        PrinterState(CommentState.none(), SourceMapState.none())
}

; uniqueHelperNames: name → identifier node
define NameNode
(
    name: Slice[char]
    node: ref[AstNode]
)

; IdToSymbol: identifier node → symbol
define NodeSymbol
(
    node: ref[AstNode]
    symbol: ref[Symbol]
)

define Printer
(
    host: ref[Page]
    options: PrinterOptions
    handlers_tag: int
    has_global_name_tag: int
    context: ref[EmitContext]
    current_source_file: ref[SourceFileInfo]?
    unique_helper_names: ref[Array[NameNode]]?
    external_helpers_module_name: ref[AstNode]?
    next_list_element_pos: int
    writer: ref[TextWriter]?
    own_writer: ref[TextWriter]?
    write_kind: int
    source_maps_disabled: bool
    source_map_generator: ref[SourceMapGenerator]?
    source_map_source: ref[SourceFileInfo]?
    source_map_source_index: int
    source_map_source_is_json: bool
    source_map_line_char_cache: ref[LineCharacterCache]?
    most_recent_source_map_source: ref[SourceFileInfo]?
    most_recent_source_map_source_index: int
    container_pos: int
    container_end: int
    declaration_list_container_end: int
    detached_comments_info: ref[Array[DetachedCommentsInfo]]
    detached_depth: int
    comments_disabled: bool
    in_extends: bool
    name_generator: ref[NameGenerator]
    id_to_symbol: ref[Array[NodeSymbol]]?
    unported_count: int
    unported_tag: Slice[char]
    unported_detail: int
    ; the declaration output's `path` directive names, one per preserved `path`
    ; reference in order, an empty name for one the program does not hold (slice
    ; 256: getReferencedFiles, computed by the emitter that knows the output path)
    dts_reference_names: ref[Array[Slice[char]]]?
)
{
    function slice_of(s: String) returns Slice[char]
        Slice[char](s.get_length() as int, s.get_buffer() as pointer[char])

    ; ★★★ A VIEW OF A TEMPORARY STRING DOES NOT SURVIVE THE ROUTINE THAT MADE IT.
    ; `b.to_string()` constructs its String on the CALLER page — the calling
    ; routine's own region — so `slice_of(b.to_string())` RETURNED or STORED is a
    ; view into memory that dies with the return (measured: 90 of 90 bytes wrong
    ; after the next allocations; a returned String VALUE survives, a slice of
    ; it does not — §3.5ji). This copies the bytes onto `host` first.
    function slice_on(host: ref[Page], s: String) returns Slice[char]
    {
        let copy String^host(s.get_buffer() as pointer[const_char], s.get_length())
        Slice[char](copy.get_length() as int, copy.get_buffer() as pointer[char])
    }

    procedure append_hex_upper(mutable b: ref[StringBuilder], value: int)
    {
        var digits u8[16]
        var n 0
        var v value
        if v = 0
        {
            b.append("0" as char)
            return
        }
        while v > 0
        {
            set digits[n]: (v & 15) as u8
            set v: v >> 4
            set n: n + 1
        }
        while n > 0
        {
            set n: n - 1
            let d digits[n] as int
            if d < 10
                b.append((48 + d) as char)
            else
                b.append((55 + d) as char)
        }
    }

    procedure encode_jsx_character_entity(mutable b: ref[StringBuilder], char_code: int)
    {
        b.append("&#x")
        Printer.append_hex_upper(b, char_code)
        b.append(";" as char)
    }

    procedure encode_utf16_escape_sequence(mutable b: ref[StringBuilder], char_code: int)
    {
        b.append("\\u")
        var width 0
        var v char_code
        while v > 0
        {
            set width: width + 1
            set v: v >> 4
        }
        if width = 0
            set width: 1
        while width < 4
        {
            b.append("0" as char)
            set width: width + 1
        }
        Printer.append_hex_upper(b, char_code)
    }

    ; stringutil.DecodeJSStringRune's size: this port's texts are WTF-8, where a
    ; lone surrogate is a three-byte sequence utf8_decode_in already yields as its
    ; code point, so the scanner's decoder is the JS-string decoder.
    procedure append_escaped_rune(mutable b: ref[StringBuilder], ch: int, quote_char: int, flags: int, s: Slice[char], i: int, size: int, mutable out_size: ref[int])
    {
        set out_size: size
        let n s.length as int
        if (flags & LiteralTextFlagsJsxAttributeEscape) <> 0
        {
            if ch = 0
            {
                b.append("&#0;")
                return
            }
            if ch = 34
            {
                b.append("&quot;")
                return
            }
            if ch = 39
            {
                b.append("&apos;")
                return
            }
            Printer.encode_jsx_character_entity(b, ch)
            return
        }
        if ch = 13
        {
            if quote_char = QuoteCharBacktick
            {
                if i + 1 < n
                {
                    if ((s[(i + 1) as size_t] as int) & 255) = 10
                    {
                        set out_size: size + 1
                        b.append("\\r\\n")
                        return
                    }
                }
            }
        }
        if ch > 0xFFFF
        {
            let c ch - 0x10000
            Printer.encode_utf16_escape_sequence(b, ((c & 0xFFC00) >> 10) + 0xD800)
            Printer.encode_utf16_escape_sequence(b, (c & 0x3FF) + 0xDC00)
            return
        }
        if (ch >= 0xD800) and (ch <= 0xDFFF)
        {
            Printer.encode_utf16_escape_sequence(b, ch)
            return
        }
        if ch = 0
        {
            var digit_follows false
            if i + 1 < n
            {
                if Scanner.is_digit((s[(i + 1) as size_t] as int) & 255)
                    set digit_follows: true
            }
            if digit_follows
                b.append("\\x00")
            else
                b.append("\\0")
            return
        }
        if ch = 9
        {
            b.append("\\t")
            return
        }
        if ch = 11
        {
            b.append("\\v")
            return
        }
        if ch = 12
        {
            b.append("\\f")
            return
        }
        if ch = 8
        {
            b.append("\\b")
            return
        }
        if ch = 13
        {
            b.append("\\r")
            return
        }
        if ch = 10
        {
            b.append("\\n")
            return
        }
        if ch = 92
        {
            b.append("\\\\")
            return
        }
        if ch = 34
        {
            b.append("\\\"")
            return
        }
        if ch = 39
        {
            b.append("\\'")
            return
        }
        if ch = 96
        {
            b.append("\\\`")
            return
        }
        if ch = 36
        {
            b.append("\\$")
            return
        }
        if ch = 0x2028
        {
            b.append("\\u2028")
            return
        }
        if ch = 0x2029
        {
            b.append("\\u2029")
            return
        }
        if ch = 0x85
        {
            b.append("\\u0085")
            return
        }
        Printer.encode_utf16_escape_sequence(b, ch)
    }

    ; escapeStringWorker — ECMA-262's Quote, augmented; does not add the quotes.
    procedure escape_string_worker(s: Slice[char], quote_char: int, flags: int, mutable b: ref[StringBuilder])
    {
        let n s.length as int
        var pos 0
        var i 0
        while i < n
        {
            let ch Scanner.utf8_decode_in(s, n, i)
            var size Scanner.utf8_size_in(s, n, i)
            var escape false
            if (ch >= 0xD800) and (ch <= 0xDFFF)
                set escape: true
            if ch = 0xFFFD
            {
                if size = 1
                    set escape: true
            }
            if ch = 92
            {
                if (flags & LiteralTextFlagsJsxAttributeEscape) = 0
                    set escape: true
            }
            else
            {
                if ch = 36
                {
                    if quote_char = QuoteCharBacktick
                    {
                        if i + 1 < n
                        {
                            if ((s[(i + 1) as size_t] as int) & 255) = ("{" as char) as int
                                set escape: true
                        }
                    }
                }
                else
                {
                    var listed false
                    if (ch = quote_char) or (ch = 0x2028) or (ch = 0x2029) or (ch = 0x85) or (ch = 13)
                        set listed: true
                    if listed
                        set escape: true
                    else
                    {
                        if ch = 10
                        {
                            if quote_char <> QuoteCharBacktick
                                set escape: true
                        }
                        else
                        {
                            if ch <= 0x1F
                                set escape: true
                            if (flags & LiteralTextFlagsNeverAsciiEscape) = 0
                            {
                                if ch > 0x7F
                                    set escape: true
                            }
                        }
                    }
                }
            }
            if escape
            {
                if pos < i
                {
                    let run s.subslice(pos as size_t, i as size_t)
                    b.append(run.data, run.length)
                }
                var used size
                Printer.append_escaped_rune(b, ch, quote_char, flags, s, i, size, &used)
                set size: used
                set pos: i + size
            }
            set i: i + size
        }
        if pos < i
        {
            let tail s.slice_from(pos as size_t)
            b.append(tail.data, tail.length)
        }
    }

    function escape_string(host: ref[Page], s: Slice[char], quote_char: int) returns String
    {
        let b StringBuilder^host()
        Printer.escape_string_worker(s, quote_char, LiteralTextFlagsNeverAsciiEscape, &b)
        b.to_string()
    }

    function escape_non_ascii_string(host: ref[Page], s: Slice[char], quote_char: int) returns String
    {
        let b StringBuilder^host()
        Printer.escape_string_worker(s, quote_char, LiteralTextFlagsNone, &b)
        b.to_string()
    }

    function escape_jsx_attribute_string(host: ref[Page], s: Slice[char], quote_char: int) returns String
    {
        let b StringBuilder^host()
        Printer.escape_string_worker(s, quote_char, LiteralTextFlagsJsxAttributeEscape | LiteralTextFlagsNeverAsciiEscape, &b)
        b.to_string()
    }

    ; canUseOriginalText: a synthesized node, a parentless node and (when asked to
    ; terminate) an unterminated literal have no usable source text; a numeric
    ; literal's invalid or separator-bearing text neither.
    function can_use_original_text(node: ref[AstNode], flags: int) returns bool
    {
        if AstNode.pos_of(node) < 0
            return false
        if AstNode.parent_node_of(node) = null
            return false
        if (flags & LiteralTextFlagsTerminateUnterminatedLiterals) <> 0
        {
            if AstNode.is_unterminated_literal(node)
                return false
        }
        let kind AstNode.kind_of(node)
        if kind = KindNumericLiteral
        {
            let token_flags AstNode.numeric_token_flags_of(node)
            if (token_flags & TokenFlagsIsInvalid) <> 0
                return false
            if (token_flags & TokenFlagsContainsSeparator) <> 0
                return (flags & LiteralTextFlagsAllowNumericSeparator) <> 0
        }
        kind <> KindBigIntLiteral
    }

    ; scanner.GetTextOfNodeFromSourceText (scanner/utilities.go), placed here
    ; because the scanner module is declared before ast and cannot name a node.
    function get_text_of_node_from_source_text(host: ref[Page], source_text: Slice[char], node: ref[AstNode], include_trivia: bool) returns Slice[char]
    {
        if Binder.node_is_missing(node)
            return ""
        var pos AstNode.pos_of(node)
        if include_trivia = false
            set pos: Scanner.skip_trivia(source_text, pos)
        let text source_text.subslice(pos as size_t, AstNode.end_of(node) as size_t)
        if (AstNode.flags_of(node) & NodeFlagsReparserTransformedLiteral) <> 0
        {
            let kind AstNode.kind_of(node)
            if kind = KindStringLiteral
            {
                let b StringBuilder^host()
                var q QuoteCharDoubleQuote
                if (AstNode.string_token_flags_of(node) & TokenFlagsSingleQuote) <> 0
                    set q: QuoteCharSingleQuote
                b.append(q as char)
                b.append(text.data, text.length)
                b.append(q as char)
                return Printer.slice_on(host, b.to_string())
            }
            if kind = KindIdentifier
                return AstNode.identifier_text_of(node)
        }
        text
    }

    ; getLiteralText. `has_source` stands for the reference's non-nil sourceFile:
    ; with it and a usable original, the text between the node's trimmed start and
    ; its end; without, the canonical form — a quoted, escaped string, a template
    ; part in its delimiters, a number's own text.
    ; ★ The template arm's `rawText` is a field this port's template nodes do not
    ; carry (their LiteralData is the cooked text and the token flags); every
    ; template node the parser makes has original text, and a SYNTHESIZED one is
    ; a transformer's — recorded for that chapter. Here the cooked text is
    ; escaped as the reference does when rawText is empty.
    function get_literal_text(host: ref[Page], node: ref[AstNode], source_text: Slice[char], has_source: bool, flags: int) returns Slice[char]
    {
        if has_source
        {
            if Printer.can_use_original_text(node, flags)
                return Printer.get_text_of_node_from_source_text(host, source_text, node, false)
        }
        let kind AstNode.kind_of(node)
        if kind = KindStringLiteral
        {
            let b StringBuilder^host()
            var q QuoteCharDoubleQuote
            if (AstNode.string_token_flags_of(node) & TokenFlagsSingleQuote) <> 0
                set q: QuoteCharSingleQuote
            b.append(q as char)
            Printer.escape_string_worker(AstNode.literal_text_of(node), q, flags, &b)
            b.append(q as char)
            return Printer.slice_on(host, b.to_string())
        }
        var template false
        if (kind = KindNoSubstitutionTemplateLiteral) or (kind = KindTemplateHead)
            set template: true
        if (kind = KindTemplateMiddle) or (kind = KindTemplateTail)
            set template: true
        if template
        {
            let b StringBuilder^host()
            if (kind = KindNoSubstitutionTemplateLiteral) or (kind = KindTemplateHead)
                b.append(96 as char)
            else
                b.append("}" as char)
            Printer.escape_string_worker(AstNode.literal_text_of(node), QuoteCharBacktick, flags, &b)
            if (kind = KindNoSubstitutionTemplateLiteral) or (kind = KindTemplateTail)
                b.append(96 as char)
            else
                b.append("${")
            return Printer.slice_on(host, b.to_string())
        }
        if (kind = KindNumericLiteral) or (kind = KindBigIntLiteral)
            return AstNode.literal_text_of(node)
        if kind = KindRegularExpressionLiteral
        {
            if (flags & LiteralTextFlagsTerminateUnterminatedLiterals) <> 0
            {
                if AstNode.is_unterminated_literal(node)
                {
                    let text AstNode.literal_text_of(node)
                    let b StringBuilder^host()
                    b.append(text.data, text.length)
                    var ends_in_backslash false
                    if (text.length as int) > 0
                    {
                        if ((text[(text.length as int - 1) as size_t] as int) & 255) = 92
                            set ends_in_backslash: true
                    }
                    if ends_in_backslash
                        b.append(" /")
                    else
                        b.append("/")
                    return Printer.slice_on(host, b.to_string())
                }
            }
            return AstNode.literal_text_of(node)
        }
        ""
    }

    ; ── the line helpers, over a source text and its ECMA line map ──

    function range_is_on_single_line(r: TextRange, text: Slice[char], line_starts: ref[Array[int]]) returns bool
        Printer.range_start_is_on_same_line_as_range_end(r, r, text, line_starts)

    function range_start_positions_are_on_same_line(r1: TextRange, r2: TextRange, text: Slice[char], line_starts: ref[Array[int]]) returns bool
        Printer.positions_are_on_same_line(Printer.get_start_position_of_range(r1, text, false), Printer.get_start_position_of_range(r2, text, false), line_starts)

    function range_end_positions_are_on_same_line(r1: TextRange, r2: TextRange, line_starts: ref[Array[int]]) returns bool
        Printer.positions_are_on_same_line(r1.end, r2.end, line_starts)

    function range_start_is_on_same_line_as_range_end(r1: TextRange, r2: TextRange, text: Slice[char], line_starts: ref[Array[int]]) returns bool
        Printer.positions_are_on_same_line(Printer.get_start_position_of_range(r1, text, false), r2.end, line_starts)

    function range_end_is_on_same_line_as_range_start(r1: TextRange, r2: TextRange, text: Slice[char], line_starts: ref[Array[int]]) returns bool
        Printer.positions_are_on_same_line(r1.end, Printer.get_start_position_of_range(r2, text, false), line_starts)

    function get_start_position_of_range(r: TextRange, text: Slice[char], include_comments: bool) returns int
    {
        if r.pos < 0
            return 0 - 1
        Scanner.skip_trivia_ex(text, r.pos, false, include_comments, false)
    }

    function positions_are_on_same_line(pos1: int, pos2: int, line_starts: ref[Array[int]]) returns bool
        Printer.get_lines_between_positions(line_starts, pos1, pos2) = 0

    function get_lines_between_positions(line_starts: ref[Array[int]], pos1: int, pos2: int) returns int
    {
        if pos1 = pos2
            return 0
        var lower pos1
        if pos2 < pos1
            set lower: pos2
        let is_negative lower = pos2
        var upper pos2
        if is_negative
            set upper: pos1
        let lower_line Scanner.compute_line_of_position(line_starts, lower)
        let upper_line lower_line + Scanner.compute_line_of_position_from(line_starts, lower_line, upper)
        if is_negative
            return lower_line - upper_line
        upper_line - lower_line
    }

    function get_lines_between_range_end_and_range_start(r1: TextRange, r2: TextRange, text: Slice[char], line_starts: ref[Array[int]], include_second_range_comments: bool) returns int
    {
        let range2_start Printer.get_start_position_of_range(r2, text, include_second_range_comments)
        Printer.get_lines_between_positions(line_starts, r1.end, range2_start)
    }

    function get_lines_between_position_and_preceding_non_whitespace_character(pos: int, stop_pos: int, text: Slice[char], line_starts: ref[Array[int]], include_comments: bool) returns int
    {
        let start_pos Scanner.skip_trivia_ex(text, pos, false, include_comments, false)
        let prev_pos Printer.get_previous_non_whitespace_position(start_pos, stop_pos, text)
        var from stop_pos
        if prev_pos >= 0
            set from: prev_pos
        Printer.get_lines_between_positions(line_starts, from, start_pos)
    }

    function get_lines_between_position_and_next_non_whitespace_character(pos: int, stop_pos: int, text: Slice[char], line_starts: ref[Array[int]], include_comments: bool) returns int
    {
        let next_pos Scanner.skip_trivia_ex(text, pos, false, include_comments, false)
        var to next_pos
        if stop_pos < next_pos
            set to: stop_pos
        Printer.get_lines_between_positions(line_starts, pos, to)
    }

    ; getPreviousNonWhitespacePosition — a byte walk, as the reference's.
    function get_previous_non_whitespace_position(pos_in: int, stop_pos: int, text: Slice[char]) returns int
    {
        var pos pos_in
        while pos >= stop_pos
        {
            if Scanner.is_white_space_like((text[pos as size_t] as int) & 255) = false
                return pos
            set pos: pos - 1
        }
        0 - 1
    }

    ; canHaveDecorators
    function can_have_decorators(node: ref[AstNode]) returns bool
    {
        let kind AstNode.kind_of(node)
        if (kind = KindParameter) or (kind = KindPropertyDeclaration) or (kind = KindMethodDeclaration)
            return true
        if (kind = KindGetAccessor) or (kind = KindSetAccessor)
            return true
        (kind = KindClassExpression) or (kind = KindClassDeclaration)
    }

    ; skipSynthesizedParentheses
    function skip_synthesized_parentheses(node_in: ref[AstNode]) returns ref[AstNode]
    {
        var node node_in
        while true
        {
            if AstNode.kind_of(node) <> KindParenthesizedExpression
                return node
            if AstNode.pos_of(node) >= 0
                return node
            let inner AstNode.expression_of(node)
            if inner = null
                return node
            set node: inner as ref[AstNode]
        }
        node
    }

    function is_new_expression_without_arguments(node: ref[AstNode]) returns bool
    {
        if AstNode.kind_of(node) <> KindNewExpression
            return false
        AstNode.call_arguments_of(node) = null
    }

    function skip_partially_emitted_expressions(node_in: ref[AstNode]) returns ref[AstNode]
    {
        var node node_in
        while AstNode.kind_of(node) = KindPartiallyEmittedExpression
        {
            ; the wrapped expression is the arm's `inner` (ast.scaly's
            ; `expression_of` does not reach PartiallyEmittedExpression — §3.5jh)
            let inner Printer.wrapped_inner_of(node)
            if inner = null
                return node
            set node: inner as ref[AstNode]
        }
        node
    }

    function is_binary_operation(node_in: ref[AstNode], token: int) returns bool
    {
        let node Printer.skip_partially_emitted_expressions(node_in)
        if AstNode.kind_of(node) <> KindBinaryExpression
            return false
        let op AstNode.binary_operator_token_of(node)
        if op = null
            return false
        AstNode.kind_of(op) = token
    }

    function mixing_binary_operators_requires_parentheses(a: int, b: int) returns bool
    {
        if a = KindQuestionQuestionToken
            return (b = KindAmpersandAmpersandToken) or (b = KindBarBarToken)
        if b = KindQuestionQuestionToken
            return (a = KindAmpersandAmpersandToken) or (a = KindBarBarToken)
        false
    }

    function is_immediately_invoked_function_expression_or_arrow_function(node_in: ref[AstNode]) returns bool
    {
        var node Printer.skip_partially_emitted_expressions(node_in)
        if AstNode.kind_of(node) <> KindCallExpression
            return false
        let callee AstNode.expression_of(node)
        if callee = null
            return false
        set node: Printer.skip_partially_emitted_expressions(callee as ref[AstNode])
        (AstNode.kind_of(node) = KindFunctionExpression) or (AstNode.kind_of(node) = KindArrowFunction)
    }

    ; ── generated names ──

    function has_leading_hash(text: Slice[char]) returns bool
    {
        if (text.length as int) = 0
            return false
        ((text[0 as size_t] as int) & 255) = ("#" as char) as int
    }

    function remove_leading_hash(text: Slice[char]) returns Slice[char]
    {
        if Printer.has_leading_hash(text)
            return text.slice_from(1 as size_t)
        text
    }

    procedure append_without_leading_hash(mutable b: ref[StringBuilder], text: Slice[char])
    {
        let t Printer.remove_leading_hash(text)
        b.append(t.data, t.length)
    }

    function format_generated_name(host: ref[Page], private_name: bool, prefix: Slice[char], base: Slice[char], suffix: Slice[char]) returns String
    {
        let b StringBuilder^host()
        if private_name
            b.append("#" as char)
        Printer.append_without_leading_hash(&b, prefix)
        Printer.append_without_leading_hash(&b, base)
        Printer.append_without_leading_hash(&b, suffix)
        b.to_string()
    }

    function is_ascii_word_character(ch: int) returns bool
    {
        if Scanner.is_ascii_letter(ch)
            return true
        if Scanner.is_digit(ch)
            return true
        ch = ("_" as char) as int
    }

    ; makeIdentifierFromModuleName — over the base file name, bytewise.
    function make_identifier_from_module_name(host: ref[Page], module_name: Slice[char]) returns String
    {
        let name Printer.base_file_name_of(module_name)
        let b StringBuilder^host()
        let n name.length as int
        var pos 0
        while pos < n
        {
            let ch (name[pos as size_t] as int) & 255
            var written false
            if pos = 0
            {
                if Scanner.is_digit(ch)
                {
                    b.append("_" as char)
                    written: true
                }
            }
            if written = false
            {
                if Printer.is_ascii_word_character(ch) = false
                    b.append("_" as char)
                else
                    b.append(ch as char)
            }
            else
                b.append(ch as char)
            set pos: pos + 1
        }
        b.to_string()
    }

    ; tspath.GetBaseFileName's slash arm: the text after the last separator.
    function base_file_name_of(path: Slice[char]) returns Slice[char]
    {
        let n path.length as int
        var i n
        while i > 0
        {
            let c (path[(i - 1) as size_t] as int) & 255
            if (c = ("/" as char) as int) or (c = 92)
                break
            set i: i - 1
        }
        path.slice_from(i as size_t)
    }

    ; ── the triple-slash matcher, over a text and a cursor ──

    procedure skip_white_space_single_line(text: Slice[char], mutable pos: ref[int])
    {
        let n text.length as int
        while pos < n
        {
            let ch Scanner.utf8_decode_in(text, n, pos)
            if Scanner.is_white_space_single_line(ch) = false
                break
            set pos: pos + Scanner.utf8_size_in(text, n, pos)
        }
    }

    procedure match_white_space_single_line(text: Slice[char], mutable pos: ref[int]) returns bool
    {
        ; ★ typed: an untyped `let start_pos pos` ALIASES the out-parameter and the
        ; comparison below never held — every `/// <reference>` directive was dropped
        let start_pos: int pos
        Printer.skip_white_space_single_line(text, pos)
        pos <> start_pos
    }

    procedure match_rune(text: Slice[char], mutable pos: ref[int], expected: int) returns bool
    {
        let n text.length as int
        if pos >= n
            return false
        let ch Scanner.utf8_decode_in(text, n, pos)
        if ch = expected
        {
            set pos: pos + Scanner.utf8_size_in(text, n, pos)
            return true
        }
        false
    }

    procedure match_string(text: Slice[char], mutable pos: ref[int], expected: Slice[char]) returns bool
    {
        var text_pos: int pos
        let n text.length as int
        let m expected.length as int
        var expected_pos 0
        while expected_pos < m
        {
            if text_pos >= n
                return false
            let expected_rune Scanner.utf8_decode_in(expected, m, expected_pos)
            let expected_size Scanner.utf8_size_in(expected, m, expected_pos)
            if Printer.match_rune(text, &text_pos, expected_rune) = false
                return false
            set expected_pos: expected_pos + expected_size
        }
        set pos: text_pos
        true
    }

    procedure match_quoted_string(text: Slice[char], mutable pos: ref[int]) returns bool
    {
        var text_pos: int pos
        var quote_char 0
        if Printer.match_rune(text, &text_pos, 39)
            set quote_char: 39
        else
        {
            if Printer.match_rune(text, &text_pos, 34)
                set quote_char: 34
            else
                return false
        }
        let n text.length as int
        while text_pos < n
        {
            let ch Scanner.utf8_decode_in(text, n, text_pos)
            set text_pos: text_pos + Scanner.utf8_size_in(text, n, text_pos)
            if ch = quote_char
            {
                set pos: text_pos
                return true
            }
        }
        false
    }

    function index_of_slash_greater(text: Slice[char], from: int) returns int
    {
        let n text.length as int
        var i from
        while i + 1 < n
        {
            if ((text[i as size_t] as int) & 255) = ("/" as char) as int
            {
                if ((text[(i + 1) as size_t] as int) & 255) = (">" as char) as int
                    return i
            }
            set i: i + 1
        }
        0 - 1
    }

    ; IsRecognizedTripleSlashComment: `/// <reference path|types|lib|no-default-lib="…" />`,
    ; `/// <amd-dependency path="…" />`, `/// <amd-module />`.
    function is_recognized_triple_slash_comment(source: Slice[char], comment: CommentRange) returns bool
    {
        if comment.kind <> KindSingleLineCommentTrivia
            return false
        if comment.len() <= 2
            return false
        if ((source[(comment.pos + 1) as size_t] as int) & 255) <> ("/" as char) as int
            return false
        if ((source[(comment.pos + 2) as size_t] as int) & 255) <> ("/" as char) as int
            return false
        let text source.subslice((comment.pos + 3) as size_t, comment.end as size_t)
        var pos 0
        Printer.skip_white_space_single_line(text, &pos)
        if Printer.match_rune(text, &pos, ("<" as char) as int) = false
            return false
        if Printer.match_string(text, &pos, "reference")
        {
            if Printer.match_white_space_single_line(text, &pos) = false
                return false
            var attr false
            if Printer.match_string(text, &pos, "path")
                set attr: true
            if attr = false
            {
                if Printer.match_string(text, &pos, "types")
                    set attr: true
            }
            if attr = false
            {
                if Printer.match_string(text, &pos, "lib")
                    set attr: true
            }
            if attr = false
            {
                if Printer.match_string(text, &pos, "no-default-lib")
                    set attr: true
            }
            if attr = false
                return false
            Printer.skip_white_space_single_line(text, &pos)
            if Printer.match_rune(text, &pos, ("=" as char) as int) = false
                return false
            Printer.skip_white_space_single_line(text, &pos)
            if Printer.match_quoted_string(text, &pos) = false
                return false
        }
        else
        {
            if Printer.match_string(text, &pos, "amd-dependency")
            {
                if Printer.match_white_space_single_line(text, &pos) = false
                    return false
                if Printer.match_string(text, &pos, "path") = false
                    return false
                Printer.skip_white_space_single_line(text, &pos)
                if Printer.match_rune(text, &pos, ("=" as char) as int) = false
                    return false
                Printer.skip_white_space_single_line(text, &pos)
                if Printer.match_quoted_string(text, &pos) = false
                    return false
            }
            else
            {
                if Printer.match_string(text, &pos, "amd-module")
                    Printer.skip_white_space_single_line(text, &pos)
                else
                    return false
            }
        }
        Printer.index_of_slash_greater(text, pos) >= 0
    }

    function is_jsdoc_like_text(text: Slice[char], comment: CommentRange) returns bool
    {
        if comment.kind <> KindMultiLineCommentTrivia
            return false
        if comment.len() < 5
            return false
        if ((text[(comment.pos + 2) as size_t] as int) & 255) <> ("*" as char) as int
            return false
        ((text[(comment.pos + 3) as size_t] as int) & 255) <> ("/" as char) as int
    }

    function is_pinned_comment(text: Slice[char], comment: CommentRange) returns bool
    {
        if comment.kind <> KindMultiLineCommentTrivia
            return false
        if comment.len() <= 5
            return false
        ((text[(comment.pos + 2) as size_t] as int) & 255) = ("!" as char) as int
    }

    ; calculateIndent — a tab goes to the next tab stop, a space counts one.
    function calculate_indent(text: Slice[char], pos_in: int, stop: int) returns int
    {
        var current_line_indent 0
        let indent_size TextWriter.get_default_indent_size()
        let n text.length as int
        var pos pos_in
        while pos < stop
        {
            let ch Scanner.utf8_decode_in(text, n, pos)
            if Scanner.is_white_space_single_line(ch) = false
                break
            if ch = 9
                set current_line_indent: current_line_indent + (indent_size - (current_line_indent % indent_size))
            else
                set current_line_indent: current_line_indent + 1
            set pos: pos + Scanner.utf8_size_in(text, n, pos)
        }
        current_line_indent
    }

    ; findSpanEnd is generic over a test func; each caller writes its loop (§3.18).

    ; ── the three utilities that read the emit context (deferred from slice 230) ──

    ; siblingNodePositionsAreComparable: consecutive members of one node array.
    function sibling_node_positions_are_comparable(context: ref[EmitContext], previous_in: ref[AstNode], next_in: ref[AstNode]) returns bool
    {
        if next_in.pos < previous_in.end
            return false
        let previous_node context.most_original(previous_in) as ref[AstNode]
        let next_node context.most_original(next_in) as ref[AstNode]
        let parent previous_node.parent
        if parent = null
            return false
        if parent <> next_node.parent
            return false
        let parent_node_array Printer.get_containing_node_array(previous_node)
        if parent_node_array = null
            return false
        let list parent_node_array as ref[Array[ref[AstNode]?]]
        var prev_index 0 - 1
        var next_index 0 - 1
        var i 0
        while i < (list.get_length() as int)
        {
            if list[i as size_t] = previous_node
                set prev_index: i
            if list[i as size_t] = next_node
                set next_index: i
            set i: i + 1
        }
        if prev_index < 0
            return false
        next_index = prev_index + 1
    }

    ; getContainingNodeArray: the list the node sits in, by the node's kind and
    ; then its parent's. The JSDoc-tag arm is the reference's own TODO.
    function get_containing_node_array(node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let parent_opt node.parent
        if parent_opt = null
            return null
        let parent parent_opt as ref[AstNode]
        let k node.kind
        let pk parent.kind
        if k = KindTypeParameter
        {
            if AstNode.is_function_like(parent) or (pk = KindClassDeclaration) or (pk = KindClassExpression) or (pk = KindInterfaceDeclaration) or AstNode.is_type_or_js_type_alias_declaration(parent)
                return AstNode.type_parameters_of(parent)
            return null
        }
        if k = KindParameter
            return AstNode.parameters_of(parent)
        if k = KindTemplateLiteralTypeSpan
            return AstNode.template_literal_type_spans_of(parent)
        if k = KindTemplateSpan
            return AstNode.template_expression_spans_of(parent)
        if k = KindDecorator
        {
            if Printer.can_have_decorators(parent)
                return AstNode.modifiers_of(parent)
            return null
        }
        if k = KindHeritageClause
            return AstNode.heritage_clauses_of(parent)
        if (pk = KindTypeLiteral) or (pk = KindInterfaceDeclaration)
        {
            if Printer.is_type_element_kind(k)
                return Printer.member_list_of(parent)
        }
        if (pk = KindUnionType) or (pk = KindIntersectionType)
            return AstNode.type_list_of(parent)
        if (pk = KindArrayLiteralExpression) or (pk = KindTupleType) or (pk = KindNamedImports) or (pk = KindNamedExports)
            return AstNode.elements_of(parent)
        if (pk = KindObjectLiteralExpression) or (pk = KindJsxAttributes)
            return AstNode.properties_of(parent)
        if (pk = KindCallExpression) or (pk = KindNewExpression)
        {
            if AstNode.is_type_node_kind(k)
                return AstNode.type_arguments_of(parent)
            if AstNode.expression_of(parent) <> node
                return AstNode.call_arguments_of(parent)
            return null
        }
        if (pk = KindJsxElement) or (pk = KindJsxFragment)
        {
            if Printer.is_jsx_child_kind(k)
                return AstNode.jsx_children_of(parent)
        }
        if (pk = KindJsxOpeningElement) or (pk = KindJsxSelfClosingElement)
        {
            if AstNode.is_type_node_kind(k)
                return AstNode.type_arguments_of(parent)
        }
        if (pk = KindBlock) or (pk = KindModuleBlock) or (pk = KindCaseClause) or (pk = KindDefaultClause)
            return AstNode.statements_of(parent)
        if pk = KindCaseBlock
            return AstNode.case_clauses_of(parent)
        if (pk = KindClassDeclaration) or (pk = KindClassExpression)
        {
            if Binder.is_class_element(node)
                return Printer.member_list_of(parent)
        }
        if pk = KindEnumDeclaration
        {
            if k = KindEnumMember
                return Printer.member_list_of(parent)
        }
        if pk = KindSourceFile
        {
            if Checker.is_statement(node)
                return AstNode.statements_of(parent)
        }
        if Printer.is_modifier_kind(k)
            return AstNode.modifiers_of(parent)
        null
    }

    ; Node.MemberList: the six kinds that carry a member list.
    function member_list_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when c: ClassDeclaration
                return c.members
            when c: ClassExpression
                return c.members
            when c: InterfaceDeclaration
                return c.members
            when e: EnumDeclaration
                return e.members
            when t: TypeLiteral
                return t.members
            when m: MappedType
                return m.members
        null
    }

    function is_type_element_kind(k: int) returns bool
    {
        if (k = KindCallSignature) or (k = KindConstructSignature) or (k = KindPropertySignature)
            return true
        if (k = KindMethodSignature) or (k = KindIndexSignature) or (k = KindGetAccessor) or (k = KindSetAccessor)
            return true
        k = KindNotEmittedTypeElement
    }

    function is_jsx_child_kind(k: int) returns bool
    {
        if (k = KindJsxElement) or (k = KindJsxExpression) or (k = KindJsxSelfClosingElement)
            return true
        (k = KindJsxText) or (k = KindJsxFragment)
    }

    function is_modifier_kind(k: int) returns bool
        AstNode.modifier_to_flag(k) <> ModifierFlagsNone

    function original_nodes_have_same_parent(context: ref[EmitContext], node_a_in: ref[AstNode], node_b_in: ref[AstNode]) returns bool
    {
        let node_a context.most_original(node_a_in) as ref[AstNode]
        if node_a.parent = null
            return false
        let node_b context.most_original(node_b_in) as ref[AstNode]
        node_a.parent = node_b.parent
    }

    ; ═══ printer.go (slice 233) — the printer proper ═══

    ; NewPrinter. The name generator is built first and handed the printer once
    ; the printer exists (its two callbacks, §3.18).
    procedure create(host: ref[Page], options: PrinterOptions, mutable context_in: ref[EmitContext]?) returns ref[Printer]
    {
        var ctx: ref[EmitContext]? context_in
        if ctx = null
            set ctx: EmitContext.create(host, null)
        let c ctx as ref[EmitContext]
        let ng NameGenerator.create(host, c, null)
        let dci &Array[DetachedCommentsInfo]^host()
        let no_tag: Slice[char] ""
        let p &Printer^host(host, options, HandlersTagNone, HasGlobalNameTagNone, c, null, null, null, 0, null, null, WriteKindNone, false, null, null, 0 - 1, false, null, null, 0 - 1, 0 - 1, 0 - 1, 0 - 1, dci, 0, options.remove_comments, false, ng, null, 0, no_tag, 0, null)
        set ng.printer: p
        p
    }

    ; The stop channel, the checker's shape: a count, the first tag and detail.
    procedure record_unported(mutable this, tag: Slice[char], detail: int)
    {
        if unported_count = 0
        {
            set this.unported_tag: tag
            set this.unported_detail: detail
        }
        set this.unported_count: unported_count + 1
    }

    ; The per-kind emitters of slices 234/235 meet here until they land.
    procedure emit_unported(mutable this, node: ref[AstNode])
        this.record_unported("emit-kind", node.kind)

    function the_writer(this) returns ref[TextWriter]
        writer as ref[TextWriter]

    function file_text(this) returns Slice[char]
        (current_source_file as ref[SourceFileInfo]).text

    function file_lines(this) returns ref[Array[int]]
        (current_source_file as ref[SourceFileInfo]).line_starts

    ; ast.GetSourceFileOfNode(node) as a SourceFileInfo: the current file when
    ; the node lies in it, else nothing (a single-file emit has no other).
    function source_info_of(this, node: ref[AstNode]) returns ref[SourceFileInfo]?
    {
        if current_source_file = null
            return null
        let csf current_source_file as ref[SourceFileInfo]
        if Checker.source_file_of_node(node) = csf.node
            return csf
        null
    }

    ; ── small statics the reference gets from ast/stringutil ──

    function position_is_synthesized(pos: int) returns bool
        pos < 0

    function node_is_synthesized(node: ref[AstNode]) returns bool
        (node.pos < 0) or (node.end < 0)

    function is_keyword_kind(k: int) returns bool
        (k >= KindFirstKeyword) and (k <= KindLastKeyword)

    function is_punctuation_kind(k: int) returns bool
        (k >= KindFirstPunctuation) and (k <= KindLastPunctuation)

    function is_jsdoc_kind(k: int) returns bool
        (k >= KindFirstJSDocNode) and (k <= KindLastJSDocNode)

    function is_member_name_kind(k: int) returns bool
        (k = KindIdentifier) or (k = KindPrivateIdentifier)

    ; unicode.IsSpace — Go's `strings.TrimSpace` predicate, not the scanner's.
    function is_go_space(ch: int) returns bool
    {
        if (ch = 32) or (ch = 9) or (ch = 10) or (ch = 11) or (ch = 12) or (ch = 13)
            return true
        if (ch = 133) or (ch = 160) or (ch = 5760)
            return true
        if (ch >= 8192) and (ch <= 8202)
            return true
        if (ch = 8232) or (ch = 8233) or (ch = 8239) or (ch = 8287) or (ch = 12288)
            return true
        false
    }

    ; strings.TrimSpace
    function trim_space(text: Slice[char]) returns Slice[char]
    {
        let n text.length as int
        var start 0
        while start < n
        {
            let ch Scanner.utf8_decode_in(text, n, start)
            if Printer.is_go_space(ch) = false
                break
            set start: start + Scanner.utf8_size_in(text, n, start)
        }
        var end n
        while end > start
        {
            var p end - 1
            while (p > start) and (((text[p as size_t] as int) & 192) = 128)
                set p: p - 1
            let ch Scanner.utf8_decode_in(text, n, p)
            if Printer.is_go_space(ch) = false
                break
            set end: p
        }
        text.subslice(start as size_t, end as size_t)
    }

    ; stringutil.SplitLines
    function split_lines(host: ref[Page], text: Slice[char]) returns ref[Array[Slice[char]]]
    {
        let lines &Array[Slice[char]]^host()
        let n text.length as int
        var start 0
        var pos 0
        while pos < n
        {
            let c text[pos as size_t] as int
            if c = 13
            {
                if (pos + 1 < n) and ((text[(pos + 1) as size_t] as int) = 10)
                {
                    lines.add(text.subslice(start as size_t, pos as size_t))
                    set pos: pos + 2
                    set start: pos
                    continue
                }
                lines.add(text.subslice(start as size_t, pos as size_t))
                set pos: pos + 1
                set start: pos
                continue
            }
            if c = 10
            {
                lines.add(text.subslice(start as size_t, pos as size_t))
                set pos: pos + 1
                set start: pos
                continue
            }
            set pos: pos + 1
        }
        if start < n
            lines.add(text.subslice(start as size_t, n as size_t))
        lines
    }

    ; stringutil.GuessIndentation
    function guess_indentation(lines: ref[Array[Slice[char]]]) returns int
    {
        var indentation 1073741823
        var li 0
        while li < (lines.get_length() as int)
        {
            let line lines[li as size_t]
            set li: li + 1
            let n line.length as int
            if n = 0
                continue
            var i 0
            while (i < n) and (i < indentation)
            {
                let ch Scanner.utf8_decode_in(line, n, i)
                if Scanner.is_white_space_like(ch) = false
                    break
                set i: i + Scanner.utf8_size_in(line, n, i)
            }
            if i < indentation
                set indentation: i
            if indentation = 0
                return 0
        }
        if indentation = 1073741823
            return 0
        indentation
    }

    ; Node.Text() for the kinds the printer asks it of.
    function text_of_node(host: ref[Page], node: ref[AstNode]) returns Slice[char]
    {
        let k node.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
            return AstNode.identifier_text_of(node)
        if k = KindJsxNamespacedName
        {
            let b StringBuilder^host()
            let ns AstNode.identifier_text_of(AstNode.namespaced_namespace_of(node))
            b.append(ns.data, ns.length)
            b.append(":" as char)
            let nm AstNode.identifier_text_of(AstNode.namespaced_name_of(node))
            b.append(nm.data, nm.length)
            return Printer.slice_on(host, b.to_string())
        }
        AstNode.literal_text_of(node)
    }

    ; greatestEnd over one node and over one range (the two shapes it is called with)
    function greatest_end_node(end: int, node: ref[AstNode]?) returns int
    {
        if node = null
            return end
        let n node as ref[AstNode]
        if end < n.end
            return n.end
        end
    }

    function greatest_end_range(end: int, r: TextRange) returns int
    {
        if end < r.end
            return r.end
        end
    }

    procedure get_opening_bracket(mutable this, format: int) returns Slice[char]
    {
        let b format & LFBracketsMask
        if b = LFBraces
            return "{"
        if b = LFParenthesis
            return "("
        if b = LFAngleBrackets
            return "<"
        if b = LFSquareBrackets
            return "["
        ; the reference PANICS ("Unexpected bracket")
        this.record_unported("list-format-bracket", b)
        ""
    }

    procedure get_closing_bracket(mutable this, format: int) returns Slice[char]
    {
        let b format & LFBracketsMask
        if b = LFBraces
            return "}"
        if b = LFParenthesis
            return ")"
        if b = LFAngleBrackets
            return ">"
        if b = LFSquareBrackets
            return "]"
        this.record_unported("list-format-bracket", b)
        ""
    }

    ; ── the two text accessors ──

    procedure get_literal_text_of_node(mutable this, node: ref[AstNode], source: ref[SourceFileInfo]?, flags_in: int) returns Slice[char]
    {
        var flags flags_in
        if node.kind = KindStringLiteral
        {
            let text_source_node context.text_source(node)
            if text_source_node <> null
            {
                let tsn text_source_node as ref[AstNode]
                var text: Slice[char] ""
                let k tsn.kind
                if k = KindNumericLiteral
                    set text: AstNode.literal_text_of(tsn)
                else
                {
                    if (k = KindIdentifier) or (k = KindPrivateIdentifier) or (k = KindJsxNamespacedName)
                        set text: this.get_text_of_node(tsn, false)
                    else
                        return this.get_literal_text_of_node(tsn, this.source_info_of(tsn), flags)
                }
                let b StringBuilder^host()
                b.append(34 as char)
                if (flags & LiteralTextFlagsJsxAttributeEscape) <> 0
                    b.append(Printer.escape_jsx_attribute_string(host, text, QuoteCharDoubleQuote))
                else
                {
                    if ((flags & LiteralTextFlagsNeverAsciiEscape) <> 0) or ((context.emit_flags(node) & EFNoAsciiEscaping) <> 0)
                        b.append(Printer.escape_string(host, text, QuoteCharDoubleQuote))
                    else
                        b.append(Printer.escape_non_ascii_string(host, text, QuoteCharDoubleQuote))
                }
                b.append(34 as char)
                return Printer.slice_on(host, b.to_string())
            }
        }
        if (context.emit_flags(node) & EFNoAsciiEscaping) <> 0
            set flags: flags | LiteralTextFlagsNeverAsciiEscape
        if options.target >= ScriptTargetES2021
            set flags: flags | LiteralTextFlagsAllowNumericSeparator
        var src: ref[SourceFileInfo]? source
        if src = null
            set src: current_source_file
        if src = null
        {
            let no_text: Slice[char] ""
            return Printer.get_literal_text(host, node, no_text, false, flags)
        }
        let s src as ref[SourceFileInfo]
        Printer.get_literal_text(host, node, s.text, true, flags)
    }

    ; `node` is an Identifier, PrivateIdentifier, literal or JsxNamespacedName
    procedure get_text_of_node(mutable this, node: ref[AstNode], include_trivia: bool) returns Slice[char]
    {
        let k node.kind
        if Printer.is_member_name_kind(k) and (context.get_auto_generate_info(node) <> null)
            return name_generator.generate_name(node)
        if k = KindStringLiteral
        {
            let tsn context.text_source(node)
            if tsn <> null
                return this.get_text_of_node(tsn as ref[AstNode], include_trivia)
        }
        let can_use_source_file (current_source_file <> null) and (node.parent <> null) and (Printer.node_is_synthesized(node) = false)
        if (k = KindIdentifier) or (k = KindPrivateIdentifier) or (k = KindJsxNamespacedName)
        {
            if can_use_source_file = false
                return Printer.text_of_node(host, node)
            let csf current_source_file as ref[SourceFileInfo]
            if Checker.source_file_of_node(node) <> context.most_original(csf.node)
                return Printer.text_of_node(host, node)
        }
        else
        {
            if (k = KindStringLiteral) or (k = KindNumericLiteral) or (k = KindBigIntLiteral) or (k = KindNoSubstitutionTemplateLiteral) or (k = KindTemplateHead) or (k = KindTemplateMiddle) or (k = KindTemplateTail)
                return this.get_literal_text_of_node(node, null, LiteralTextFlagsNone)
            ; the reference PANICS ("unexpected node")
            this.record_unported("get-text-of-node-kind", k)
            return Printer.text_of_node(host, node)
        }
        let csf current_source_file as ref[SourceFileInfo]
        Printer.get_text_of_node_from_source_text(host, csf.text, node, include_trivia)
    }

    ; ── low-level writing ──

    procedure write_as(mutable this, text: Slice[char], write_kind_in: int)
    {
        let w this.the_writer()
        if write_kind_in = WriteKindNone
            w.write(text)
        else
        {
            if write_kind_in = WriteKindParameter
                this.write_parameter(text)
            else
            {
                if write_kind_in = WriteKindKeyword
                    this.write_keyword(text)
                else
                {
                    if write_kind_in = WriteKindOperator
                        this.write_operator(text)
                    else
                    {
                        if write_kind_in = WriteKindProperty
                            this.write_property(text)
                        else
                        {
                            if write_kind_in = WriteKindPunctuation
                                this.write_punctuation(text)
                            else
                            {
                                if write_kind_in = WriteKindStringLiteral
                                    w.write_string_literal(text)
                                else
                                {
                                    if write_kind_in = WriteKindComment
                                        this.write_comment(text)
                                    else
                                    {
                                        if write_kind_in = WriteKindLiteral
                                            this.write_literal(text)
                                        else
                                            this.record_unported("write-kind", write_kind_in)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    procedure write(mutable this, text: Slice[char])
        this.write_as(text, write_kind)

    procedure set_write_kind(mutable this, kind: int) returns int
    {
        let previous write_kind
        set this.write_kind: kind
        previous
    }

    procedure write_symbol(mutable this, text: Slice[char], opt_symbol: ref[Symbol]?)
    {
        if opt_symbol = null
            this.write(text)
        else
            this.the_writer().write_symbol(text)
    }

    procedure write_literal(mutable this, text: Slice[char])
        this.the_writer().write_literal(text)

    procedure write_punctuation(mutable this, text: Slice[char])
        this.the_writer().write_punctuation(text)

    procedure write_operator(mutable this, text: Slice[char])
        this.the_writer().write_operator(text)

    procedure write_keyword(mutable this, text: Slice[char])
        this.the_writer().write_keyword(text)

    procedure write_property(mutable this, text: Slice[char])
        this.the_writer().write_property(text)

    procedure write_parameter(mutable this, text: Slice[char])
        this.the_writer().write_parameter(text)

    procedure write_comment(mutable this, text: Slice[char])
        this.the_writer().write_comment(text)

    procedure write_space(mutable this)
    {
        let w this.the_writer()
        w.write_space(" ")
    }

    procedure write_line(mutable this)
        this.the_writer().write_line()

    procedure write_line_repeat(mutable this, count: int)
    {
        var i 0
        while i < count
        {
            this.write_line()
            set i: i + 1
        }
    }

    procedure write_lines(mutable this, text: Slice[char])
    {
        let lines Printer.split_lines(host, text)
        let indentation Printer.guess_indentation(lines)
        var i 0
        while i < (lines.get_length() as int)
        {
            var line lines[i as size_t]
            if indentation > 0
                set line: line.slice_from(indentation as size_t)
            if (line.length as int) > 0
            {
                this.write_line()
                this.write(line)
            }
            set i: i + 1
        }
    }

    procedure write_trailing_semicolon(mutable this)
    {
        let w this.the_writer()
        w.write_trailing_semicolon(";")
    }

    procedure increase_indent(mutable this)
        this.the_writer().increase_indent()

    procedure decrease_indent(mutable this)
        this.the_writer().decrease_indent()

    procedure increase_indent_if(mutable this, indent_requested: bool)
    {
        if indent_requested
            this.increase_indent()
    }

    procedure decrease_indent_if(mutable this, indent_requested: bool)
    {
        if indent_requested
            this.decrease_indent()
    }

    procedure write_line_or_space(mutable this, parent_node: ref[AstNode], prev_child_node: ref[AstNode], next_child_node: ref[AstNode])
    {
        if this.should_emit_on_single_line(parent_node)
        {
            this.write_space()
            return
        }
        if options.preserve_source_newlines
        {
            let lines this.get_lines_between_nodes(parent_node, prev_child_node, next_child_node)
            if lines > 0
                this.write_line_repeat(lines)
            else
                this.write_space()
            return
        }
        this.write_line()
    }

    procedure write_lines_and_indent(mutable this, line_count: int, write_space_if_not_indenting: bool)
    {
        if line_count > 0
        {
            this.increase_indent()
            this.write_line_repeat(line_count)
            return
        }
        if write_space_if_not_indenting
            this.write_space()
    }

    procedure write_line_separators_and_indent_before(mutable this, node: ref[AstNode], parent: ref[AstNode]) returns bool
    {
        if options.preserve_source_newlines
        {
            let leading_newlines this.get_leading_line_terminator_count(parent, node, LFNone)
            if leading_newlines > 0
            {
                this.write_lines_and_indent(leading_newlines, false)
                return true
            }
        }
        false
    }

    procedure write_line_separators_after(mutable this, node: ref[AstNode], parent: ref[AstNode])
    {
        if options.preserve_source_newlines
        {
            let trailing_newlines this.get_closing_line_terminator_count(parent, node, LFNone, TextRange.undefined_range())
            if trailing_newlines > 0
                this.write_line_repeat(trailing_newlines)
        }
    }

    ; ── line terminators ──

    procedure get_lines_between_nodes(this, parent_in: ref[AstNode], node1_in: ref[AstNode], node2_in: ref[AstNode]) returns int
    {
        if this.should_elide_indentation(parent_in)
            return 0
        let parent Printer.skip_synthesized_parentheses(parent_in)
        let node1 Printer.skip_synthesized_parentheses(node1_in)
        let node2 Printer.skip_synthesized_parentheses(node2_in)
        if this.should_emit_on_new_line(node2, LFNone)
            return 1
        if (current_source_file <> null) and (Printer.node_is_synthesized(parent) = false) and (Printer.node_is_synthesized(node1) = false) and (Printer.node_is_synthesized(node2) = false)
        {
            if options.preserve_source_newlines
                return this.get_effective_lines_between_ranges(TextRange.of_node(node1), TextRange.of_node(node2))
            let csf current_source_file as ref[SourceFileInfo]
            if Printer.range_end_is_on_same_line_as_range_start(TextRange.of_node(node1), TextRange.of_node(node2), csf.text, csf.line_starts)
                return 0
            return 1
        }
        0
    }

    ; getEffectiveLines, once per line-difference shape (§3.18): comments
    ; included first, then without them when that read 0.
    procedure get_effective_lines_between_ranges(this, r1: TextRange, r2: TextRange) returns int
    {
        let csf current_source_file as ref[SourceFileInfo]
        let lines Printer.get_lines_between_range_end_and_range_start(r1, r2, csf.text, csf.line_starts, true)
        if lines = 0
            return Printer.get_lines_between_range_end_and_range_start(r1, r2, csf.text, csf.line_starts, false)
        lines
    }

    procedure get_effective_lines_preceding(this, pos: int, stop_pos: int) returns int
    {
        let csf current_source_file as ref[SourceFileInfo]
        let lines Printer.get_lines_between_position_and_preceding_non_whitespace_character(pos, stop_pos, csf.text, csf.line_starts, true)
        if lines = 0
            return Printer.get_lines_between_position_and_preceding_non_whitespace_character(pos, stop_pos, csf.text, csf.line_starts, false)
        lines
    }

    procedure get_effective_lines_next(this, pos: int, stop_pos: int) returns int
    {
        let csf current_source_file as ref[SourceFileInfo]
        let lines Printer.get_lines_between_position_and_next_non_whitespace_character(pos, stop_pos, csf.text, csf.line_starts, true)
        if lines = 0
            return Printer.get_lines_between_position_and_next_non_whitespace_character(pos, stop_pos, csf.text, csf.line_starts, false)
        lines
    }

    procedure get_leading_line_terminator_count(this, parent_node: ref[AstNode]?, first_child: ref[AstNode]?, format: int) returns int
    {
        if ((format & LFPreserveLines) <> 0) or options.preserve_source_newlines
        {
            if (format & LFPreferNewLine) <> 0
                return 1
            if first_child = null
            {
                if parent_node = null
                    return 0
                if current_source_file <> null
                {
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_is_on_single_line(TextRange.of_node(parent_node as ref[AstNode]), csf.text, csf.line_starts)
                        return 0
                }
                return 1
            }
            let fc first_child as ref[AstNode]
            if (next_list_element_pos > 0) and (fc.pos = next_list_element_pos)
                return 0
            if fc.kind = KindJsxText
                return 0
            if (current_source_file <> null) and (parent_node <> null)
            {
                let pn parent_node as ref[AstNode]
                if (Printer.position_is_synthesized(pn.pos) = false) and (Printer.node_is_synthesized(fc) = false) and (fc.parent = null)
                {
                    if options.preserve_source_newlines
                        return this.get_effective_lines_preceding(fc.pos, pn.pos)
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_start_positions_are_on_same_line(TextRange.of_node(pn), TextRange.of_node(fc), csf.text, csf.line_starts)
                        return 0
                    return 1
                }
            }
            if this.should_emit_on_new_line(fc, format)
                return 1
        }
        if (format & LFMultiLine) <> 0
            return 1
        0
    }

    procedure get_separating_line_terminator_count(this, previous_node: ref[AstNode]?, next_node: ref[AstNode]?, format: int) returns int
    {
        if ((format & LFPreserveLines) <> 0) or options.preserve_source_newlines
        {
            if (previous_node = null) or (next_node = null)
                return 0
            let prev previous_node as ref[AstNode]
            let next next_node as ref[AstNode]
            if next.kind = KindJsxText
                return 0
            if (current_source_file <> null) and (Printer.node_is_synthesized(prev) = false) and (Printer.node_is_synthesized(next) = false)
            {
                if options.preserve_source_newlines and Printer.sibling_node_positions_are_comparable(context, prev, next)
                    return this.get_effective_lines_between_ranges(TextRange.of_node(prev), TextRange.of_node(next))
                if (options.preserve_source_newlines = false) and Printer.original_nodes_have_same_parent(context, prev, next)
                {
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_end_is_on_same_line_as_range_start(TextRange.of_node(prev), TextRange.of_node(next), csf.text, csf.line_starts)
                        return 0
                    return 1
                }
                if (format & LFPreferNewLine) <> 0
                    return 1
                return 0
            }
            if this.should_emit_on_new_line(prev, format) or this.should_emit_on_new_line(next, format)
                return 1
        }
        else
        {
            if next_node <> null
            {
                if this.should_emit_on_new_line(next_node as ref[AstNode], LFNone)
                    return 1
            }
        }
        if (format & LFMultiLine) <> 0
            return 1
        0
    }

    procedure get_closing_line_terminator_count(this, parent_node: ref[AstNode]?, last_child: ref[AstNode]?, format: int, children_text_range: TextRange) returns int
    {
        if ((format & LFPreserveLines) <> 0) or options.preserve_source_newlines
        {
            if (format & LFPreferNewLine) <> 0
                return 1
            if last_child = null
            {
                if parent_node = null
                    return 0
                if current_source_file <> null
                {
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_is_on_single_line(TextRange.of_node(parent_node as ref[AstNode]), csf.text, csf.line_starts)
                        return 0
                }
                return 1
            }
            let lc last_child as ref[AstNode]
            if (current_source_file <> null) and (parent_node <> null)
            {
                let pn parent_node as ref[AstNode]
                if (Printer.position_is_synthesized(pn.pos) = false) and (Printer.node_is_synthesized(lc) = false) and ((lc.parent = null) or (lc.parent = pn))
                {
                    if options.preserve_source_newlines
                    {
                        let end Printer.greatest_end_range(lc.end, children_text_range)
                        return this.get_effective_lines_next(end, pn.end)
                    }
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_end_positions_are_on_same_line(TextRange.of_node(pn), TextRange.of_node(lc), csf.line_starts)
                        return 0
                    return 1
                }
            }
            if this.should_emit_on_new_line(lc, format)
                return 1
        }
        if ((format & LFMultiLine) <> 0) and ((format & LFNoTrailingNewLine) = 0)
            return 1
        0
    }

    ; ── comment text ──

    procedure write_comment_range(mutable this, comment: CommentRange)
    {
        if current_source_file = null
            return
        let csf current_source_file as ref[SourceFileInfo]
        this.write_comment_range_worker(csf.text, csf.line_starts, comment.kind, comment.pos, comment.end)
    }

    procedure write_comment_range_worker(mutable this, text: Slice[char], line_map: ref[Array[int]]?, kind: int, loc_pos: int, loc_end: int)
    {
        let w this.the_writer()
        if kind <> KindMultiLineCommentTrivia
        {
            ; Single line comment of style //....
            this.write_comment(text.subslice(loc_pos as size_t, loc_end as size_t))
            return
        }
        let lm line_map as ref[Array[int]]
        let indent_size TextWriter.get_default_indent_size()
        let first_line Scanner.compute_line_of_position(lm, loc_pos)
        let line_count lm.get_length() as int
        var first_comment_line_indent 0 - 1
        var pos loc_pos
        var current_line first_line
        while pos < loc_end
        {
            var next_line_start 0
            if current_line + 1 = line_count
                set next_line_start: (text.length as int) + 1
            else
                set next_line_start: lm[(current_line + 1) as size_t]
            if pos <> loc_pos
            {
                ; not the first line: write the spaces that keep the alignment
                if first_comment_line_indent = 0 - 1
                    set first_comment_line_indent: Printer.calculate_indent(text, lm[first_line as size_t], loc_pos)
                let current_writer_indent_spacing w.get_indent() * indent_size
                let spaces_to_emit (current_writer_indent_spacing - first_comment_line_indent) + Printer.calculate_indent(text, pos, next_line_start)
                if spaces_to_emit > 0
                {
                    var number_of_single_spaces_to_emit spaces_to_emit % indent_size
                    ; getIndentString((spaces - singles) / size, size): that many indent units of spaces, raw
                    var k spaces_to_emit - number_of_single_spaces_to_emit
                    while k > 0
                    {
                        w.raw_write(" ")
                        set k: k - 1
                    }
                    while number_of_single_spaces_to_emit > 0
                    {
                        w.raw_write(" ")
                        set number_of_single_spaces_to_emit: number_of_single_spaces_to_emit - 1
                    }
                }
                else
                    w.raw_write("")
            }
            ; the comment line text
            var end loc_end
            if next_line_start < end
                set end: next_line_start
            var scan pos
            while scan < end
            {
                let size Scanner.utf8_size_in(text, end, scan)
                let ch Scanner.utf8_decode_in(text, end, scan)
                if Scanner.is_line_break(ch)
                {
                    set end: scan
                    break
                }
                set scan: scan + size
            }
            let current_line_text Printer.trim_space(text.subslice(pos as size_t, end as size_t))
            if (current_line_text.length as int) > 0
            {
                this.write_comment(current_line_text)
                if end <> loc_end
                    this.write_line()
            }
            else
                w.write_line_force(true)
            set pos: next_line_start
            set current_line: current_line + 1
        }
    }

    ; ── custom emit behavior (EmitNode, EmitFlags) ──

    function should_emit_comments(this, node: ref[AstNode]) returns bool
        (comments_disabled = false) and (current_source_file <> null) and (node.kind <> KindSourceFile)

    function should_write_comment(this, comment: CommentRange) returns bool
    {
        if options.only_print_jsdoc_style = false
            return true
        if current_source_file = null
            return false
        let csf current_source_file as ref[SourceFileInfo]
        if Printer.is_jsdoc_like_text(csf.text, comment)
            return true
        Printer.is_pinned_comment(csf.text, comment)
    }

    function should_emit_indented(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFIndented) <> 0

    function should_elide_indentation(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFNoIndentation) <> 0

    function should_emit_on_single_line(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFSingleLine) <> 0

    function should_emit_on_multiple_lines(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFMultiLine) <> 0

    procedure should_emit_block_function_body_on_single_line(mutable this, body: ref[AstNode]) returns bool
    {
        if this.should_emit_on_single_line(body)
            return true
        if AstNode.multi_line_of(body)
            return false
        if (Printer.node_is_synthesized(body) = false) and (current_source_file <> null)
        {
            let csf current_source_file as ref[SourceFileInfo]
            if Printer.range_is_on_single_line(TextRange.of_node(body), csf.text, csf.line_starts) = false
                return false
        }
        let statements AstNode.statements_of(body)
        var first: ref[AstNode]? null
        var last: ref[AstNode]? null
        var n 0
        if statements <> null
        {
            let st statements as ref[Array[ref[AstNode]?]]
            set n: st.get_length() as int
            if n > 0
            {
                set first: st[0]
                set last: st[(n - 1) as size_t]
            }
        }
        var list_pos 0 - 1
        var list_end 0 - 1
        this.list_range(statements, &list_pos, &list_end)
        if this.get_leading_line_terminator_count(body, first, LFPreserveLines) > 0
            return false
        if this.get_closing_line_terminator_count(body, last, LFPreserveLines, TextRange(list_pos, list_end)) > 0
            return false
        var previous_statement: ref[AstNode]? null
        var i 0
        while i < n
        {
            let st statements as ref[Array[ref[AstNode]?]]
            let statement st[i as size_t]
            if this.get_separating_line_terminator_count(previous_statement, statement, LFPreserveLines) > 0
                return false
            set previous_statement: statement
            set i: i + 1
        }
        true
    }

    function should_emit_on_new_line(this, node: ref[AstNode], format: int) returns bool
    {
        if (context.emit_flags(node) & EFStartOnNewLine) <> 0
            return true
        (format & LFPreferNewLine) <> 0
    }

    function should_emit_source_maps(this, node: ref[AstNode]) returns bool
        (source_maps_disabled = false) and (source_map_source <> null) and (node.kind <> KindSourceFile) and (Checker.is_in_json_file(node) = false)

    function should_emit_token_source_maps(this, token: int, pos: int, context_node: ref[AstNode], flags: int) returns bool
    {
        if (flags & TefNoSourceMaps) <> 0
            return false
        if this.should_emit_source_maps(context_node) = false
            return false
        if options.omit_brace_source_map_positions
            return false
        (token = KindOpenBraceToken) or (token = KindCloseBraceToken)
    }

    function should_emit_leading_comments(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFNoLeadingComments) = 0

    function should_emit_trailing_comments(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFNoTrailingComments) = 0

    function should_emit_nested_comments(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFNoNestedComments) = 0

    function should_emit_detached_comments(this, node: ref[AstNode]) returns bool
    {
        if node.kind <> KindSourceFile
            return true
        let statements AstNode.statements_of(node)
        if statements = null
            return true
        let st statements as ref[Array[ref[AstNode]?]]
        if (st.get_length() as int) = 0
            return true
        let first st[0]
        if EmitContext.is_prologue_directive(first) = false
            return true
        Printer.node_is_synthesized(first as ref[AstNode])
    }

    procedure has_comments_at_position(mutable this, pos: int) returns bool
    {
        if current_source_file = null
            return false
        let csf current_source_file as ref[SourceFileInfo]
        if (Scanner.get_trailing_comment_ranges(host, csf.text, pos + 1).get_length() as int) > 0
            return true
        (Scanner.get_leading_comment_ranges(host, csf.text, pos + 1).get_length() as int) > 0
    }

    function should_emit_indirect_call(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFIndirectCall) <> 0

    function should_allow_trailing_comma(this, node: ref[AstNode], list: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if current_source_file = null
            return false
        let csf current_source_file as ref[SourceFileInfo]
        if csf.script_kind = ScriptKindJSON
            return false
        let k node.kind
        if k = KindObjectLiteralExpression
            return true
        if (k = KindArrayLiteralExpression) or (k = KindArrowFunction) or (k = KindConstructor) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration) or (k = KindFunctionType) or (k = KindConstructorType) or (k = KindCallSignature) or (k = KindConstructSignature) or (k = KindTaggedTemplateExpression) or (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern) or (k = KindNamedImports) or (k = KindNamedExports) or (k = KindImportAttributes)
            return true
        if (k = KindClassExpression) or (k = KindClassDeclaration) or (k = KindInterfaceDeclaration)
            return list = AstNode.type_parameters_of(node)
        if (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindMethodDeclaration)
            return true
        if (k = KindCallExpression) or (k = KindNewExpression)
            return true
        false
    }

    ; ── tokens and keywords ──

    procedure write_token_text(mutable this, token: int, write_kind_in: int, pos: int) returns int
    {
        let token_string Scanner.token_to_string(token)
        this.write_as(token_string, write_kind_in)
        if Printer.position_is_synthesized(pos)
            return pos
        pos + (token_string.length as int)
    }

    procedure emit_token(mutable this, token: int, pos: int, write_kind_in: int, context_node: ref[AstNode]) returns int
        this.emit_token_ex(token, pos, write_kind_in, context_node, TefNone)

    procedure emit_token_ex(mutable this, token: int, pos_in: int, write_kind_in: int, context_node: ref[AstNode], flags: int) returns int
    {
        var pos pos_in
        let state this.enter_token(token, &pos, context_node, flags)
        set pos: this.write_token_text(token, write_kind_in, pos)
        this.exit_token(token, pos, context_node, state)
        pos
    }

    procedure emit_keyword_node(mutable this, node: ref[AstNode]?)
        this.emit_keyword_node_ex(node, TefNone)

    procedure emit_keyword_node_ex(mutable this, node: ref[AstNode]?, flags: int)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let state this.enter_token_node(n, flags)
        this.write_token_text(n.kind, WriteKindKeyword, n.pos)
        this.exit_token_node(n, state)
    }

    procedure emit_punctuation_node(mutable this, node: ref[AstNode]?)
        this.emit_punctuation_node_ex(node, TefNone)

    procedure emit_punctuation_node_ex(mutable this, node: ref[AstNode]?, flags: int)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let state this.enter_token_node(n, flags)
        this.write_token_text(n.kind, WriteKindPunctuation, n.pos)
        this.exit_token_node(n, state)
    }

    procedure emit_token_node(mutable this, node: ref[AstNode]?)
        this.emit_token_node_ex(node, TefNone)

    procedure emit_token_node_ex(mutable this, node: ref[AstNode]?, flags: int)
    {
        if node = null
            return
        let n node as ref[AstNode]
        if Printer.is_keyword_kind(n.kind)
        {
            this.emit_keyword_node_ex(node, flags)
            return
        }
        if Printer.is_punctuation_kind(n.kind)
        {
            this.emit_punctuation_node_ex(node, flags)
            return
        }
        ; the reference PANICS ("unexpected TokenNode")
        this.record_unported("emit-token-node-kind", n.kind)
    }

    ; ── literals ──

    procedure emit_literal(mutable this, node: ref[AstNode], flags_in: int)
    {
        var flags flags_in
        if options.never_ascii_escape
            set flags: flags | LiteralTextFlagsNeverAsciiEscape
        if options.terminate_unterminated_literals
            set flags: flags | LiteralTextFlagsTerminateUnterminatedLiterals
        let text this.get_literal_text_of_node(node, null, flags)
        ; Quick info expects every literal through writeStringLiteral
        this.the_writer().write_string_literal(text)
    }

    procedure emit_literal_node(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_literal(node, LiteralTextFlagsNone)
        this.exit_node(node, state)
    }

    procedure emit_numeric_literal(mutable this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_big_int_literal(mutable this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_string_literal(mutable this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_no_substitution_template_literal(mutable this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_regular_expression_literal(mutable this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_template_head(mutable this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_template_middle(mutable this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_template_tail(mutable this, node: ref[AstNode])
        this.emit_literal_node(node)

    procedure emit_template_middle_tail(mutable this, node: ref[AstNode])
    {
        if node.kind = KindTemplateMiddle
            this.emit_template_middle(node)
        else
        {
            if node.kind = KindTemplateTail
                this.emit_template_tail(node)
        }
    }

    ; ── names ──

    procedure emit_identifier_text(mutable this, node: ref[AstNode])
    {
        let text this.get_text_of_node(node, false)
        if id_to_symbol <> null
        {
            let table id_to_symbol as ref[Array[NodeSymbol]]
            var i 0
            while i < (table.get_length() as int)
            {
                let e table[i as size_t]
                if e.node = node
                {
                    this.write_symbol(text, e.symbol)
                    return
                }
                set i: i + 1
            }
        }
        this.write(text)
    }

    procedure emit_identifier_name(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_identifier_text(node)
        this.exit_node(node, state)
    }

    procedure emit_identifier_name_node(mutable this, node: ref[AstNode]?)
    {
        if node = null
            return
        this.emit_identifier_name(node as ref[AstNode])
    }

    procedure get_unique_helper_name(mutable this, mutable name: Slice[char]) returns ref[AstNode]
    {
        let table unique_helper_names as ref[Array[NameNode]]
        var i 0
        while i < (table.get_length() as int)
        {
            let e table[i as size_t]
            if e.name.equals(name)
                return context.the_factory().clone(e.node)
            set i: i + 1
        }
        let no_affix: Slice[char] ""
        let helper_name context.the_factory().new_unique_name_ex(name, GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic, no_affix, no_affix)
        this.generate_name(helper_name)
        table.add(NameNode(name, helper_name))
        helper_name
    }

    procedure emit_identifier_reference(mutable this, mutable node_in: ref[AstNode])
    {
        var node node_in
        if ((external_helpers_module_name <> null) or (unique_helper_names <> null)) and ((context.emit_flags(node) & EFHelperName) <> 0)
        {
            if external_helpers_module_name <> null
            {
                ; Substitute `__helper` with `tslib_1.__helper`
                let f context.the_factory()
                let helper f.new_property_access_expression(f.clone(external_helpers_module_name as ref[AstNode]), null, f.clone(node), NodeFlagsNone)
                context.assign_comment_and_source_map_ranges(helper, node)
                this.emit_property_access_expression(helper)
                return
            }
            if unique_helper_names <> null
            {
                ; Substitute `__helper` with `__helper_1` if there is a conflict in an ES module.
                let helper_name this.get_unique_helper_name(AstNode.identifier_text_of(node))
                context.assign_comment_and_source_map_ranges(helper_name, node)
                set node: helper_name
            }
        }
        let state this.enter_node(node)
        this.emit_identifier_text(node)
        this.exit_node(node, state)
    }

    procedure emit_binding_identifier(mutable this, mutable node_in: ref[AstNode])
    {
        var node node_in
        if (unique_helper_names <> null) and ((context.emit_flags(node) & EFHelperName) <> 0)
        {
            let helper_name this.get_unique_helper_name(AstNode.identifier_text_of(node))
            context.assign_comment_and_source_map_ranges(helper_name, node)
            set node: helper_name
        }
        let state this.enter_node(node)
        this.emit_identifier_text(node)
        this.exit_node(node, state)
    }

    procedure emit_label_identifier(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_identifier_text(node)
        this.exit_node(node, state)
    }

    procedure emit_private_identifier(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write(this.get_text_of_node(node, false))
        this.exit_node(node, state)
    }

    procedure emit_qualified_name(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_entity_name(AstNode.qualified_left_of(node) as ref[AstNode])
        this.write_punctuation(".")
        this.emit_identifier_name(AstNode.qualified_right_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_computed_property_name(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("[")
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceDisallowComma)
        this.write_punctuation("]")
        this.exit_node(node, state)
    }

    procedure emit_entity_name(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindIdentifier
        {
            this.emit_identifier_reference(node)
            return
        }
        if k = KindQualifiedName
        {
            this.emit_qualified_name(node)
            return
        }
        if k = KindPropertyAccessExpression
        {
            ; TypeQuery nodes may carry a PropertyAccessExpression as exprName (typeof foo.x)
            this.emit_expression(node, OperatorPrecedenceDisallowComma)
            return
        }
        ; the reference PANICS ("unexpected EntityName")
        this.record_unported("emit-entity-name-kind", k)
    }

    procedure emit_binding_name(mutable this, mutable node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let k n.kind
        if k = KindIdentifier
        {
            this.emit_binding_identifier(n)
            return
        }
        if k = KindObjectBindingPattern
        {
            this.emit_object_binding_pattern(n)
            return
        }
        if k = KindArrayBindingPattern
        {
            this.emit_array_binding_pattern(n)
            return
        }
        this.record_unported("emit-binding-name-kind", k)
    }

    procedure emit_property_name(mutable this, mutable node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let saved_write_kind write_kind
        set this.write_kind: WriteKindProperty
        let k n.kind
        if k = KindIdentifier
            this.emit_identifier_name(n)
        else
        {
            if k = KindPrivateIdentifier
                this.emit_private_identifier(n)
            else
            {
                if k = KindStringLiteral
                    this.emit_string_literal(n)
                else
                {
                    if k = KindNoSubstitutionTemplateLiteral
                        this.emit_no_substitution_template_literal(n)
                    else
                    {
                        if k = KindNumericLiteral
                            this.emit_numeric_literal(n)
                        else
                        {
                            if k = KindBigIntLiteral
                                this.emit_big_int_literal(n)
                            else
                            {
                                if k = KindComputedPropertyName
                                    this.emit_computed_property_name(n)
                                else
                                    this.record_unported("emit-property-name-kind", k)
                            }
                        }
                    }
                }
            }
        }
        set this.write_kind: saved_write_kind
    }

    procedure emit_member_name(mutable this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        if n.kind = KindIdentifier
        {
            this.emit_identifier_name(n)
            return
        }
        if n.kind = KindPrivateIdentifier
        {
            this.emit_private_identifier(n)
            return
        }
        this.record_unported("emit-member-name-kind", n.kind)
    }

    ; ModuleName: a binding identifier or a string literal
    procedure emit_module_name(mutable this, mutable node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        if n.kind = KindIdentifier
        {
            this.emit_binding_identifier(n)
            return
        }
        if n.kind = KindStringLiteral
        {
            this.emit_string_literal(n)
            return
        }
        this.record_unported("emit-module-name-kind", n.kind)
    }

    ; ModuleExportName, ImportAttributeName and a NESTED module name all read
    ; the identifier as a NAME, not a binding.
    procedure emit_identifier_or_string_literal_name(mutable this, node: ref[AstNode]?, site: Slice[char])
    {
        if node = null
            return
        let n node as ref[AstNode]
        if n.kind = KindIdentifier
        {
            this.emit_identifier_name(n)
            return
        }
        if n.kind = KindStringLiteral
        {
            this.emit_string_literal(n)
            return
        }
        this.record_unported(site, n.kind)
    }

    procedure emit_module_export_name(mutable this, node: ref[AstNode]?)
        this.emit_identifier_or_string_literal_name(node, "emit-module-export-name-kind")

    procedure emit_import_attribute_name(mutable this, node: ref[AstNode])
        this.emit_identifier_or_string_literal_name(node, "emit-import-attribute-name-kind")

    procedure emit_nested_module_name(mutable this, node: ref[AstNode]?)
        this.emit_identifier_or_string_literal_name(node, "emit-nested-module-name-kind")

    ; ── lists ──

    ; NodeList.Pos()/End() off the file's list-range table: (-1, -1) for a
    ; list the table does not know (a synthesized one).
    procedure list_range(mutable this, list: ref[Array[ref[AstNode]?]]?, mutable out_pos: ref[int], mutable out_end: ref[int])
    {
        set out_pos: 0 - 1
        set out_end: 0 - 1
        if (list = null) or (current_source_file = null)
            return
        let csf current_source_file as ref[SourceFileInfo]
        AstNode.list_range_of(csf.node, list, out_pos, out_end)
    }

    procedure emit_list(mutable this, emit_tag: int, parent_node: ref[AstNode]?, mutable children: ref[Array[ref[AstNode]?]]?, format_in: int)
    {
        var format format_in
        if parent_node <> null
        {
            if this.should_emit_on_multiple_lines(parent_node as ref[AstNode])
                set format: format | LFPreferNewLine | LFIndented
        }
        this.emit_list_range(emit_tag, parent_node, children, format, 0 - 1, 0 - 1)
    }

    procedure emit_list_range(mutable this, emit_tag: int, parent_node: ref[AstNode]?, mutable children: ref[Array[ref[AstNode]?]]?, format: int, start_in: int, count_in: int)
    {
        let is_nil children = null
        var length 0
        if is_nil = false
            set length: (children as ref[Array[ref[AstNode]?]]).get_length() as int
        var start start_in
        if start < 0
            set start: 0
        var count count_in
        if count < 0
            set count: length - start
        if is_nil and ((format & LFOptionalIfNil) <> 0)
            return
        let is_empty is_nil or (start >= length) or (count <= 0)
        if is_empty and ((format & LFOptionalIfEmpty) <> 0)
        {
            this.on_before_emit_node_list(children)
            this.on_after_emit_node_list(children)
            return
        }
        var list_pos 0 - 1
        var list_end 0 - 1
        this.list_range(children, &list_pos, &list_end)
        if (format & LFBracketsMask) <> 0
        {
            this.write_punctuation(this.get_opening_bracket(format))
            if is_empty and (is_nil = false)
                this.emit_trailing_comments(list_pos, CommentSeparatorBefore)
        }
        this.on_before_emit_node_list(children)
        if is_empty
        {
            ; a line terminator if the parent node was multi-line
            var single_line_parent false
            if parent_node = null
                set single_line_parent: true
            else
            {
                if current_source_file <> null
                {
                    let csf current_source_file as ref[SourceFileInfo]
                    if Printer.range_is_on_single_line(TextRange.of_node(parent_node as ref[AstNode]), csf.text, csf.line_starts)
                        set single_line_parent: true
                }
            }
            if ((format & LFMultiLine) <> 0) and ((options.preserve_source_newlines and single_line_parent) = false)
                this.write_line()
            else
            {
                if ((format & LFSpaceBetweenBraces) <> 0) and ((format & LFNoSpaceIfEmpty) = 0)
                    this.write_space()
            }
        }
        else
        {
            var end start + count
            if length < end
                set end: length
            let ch children as ref[Array[ref[AstNode]?]]
            this.emit_list_items(emit_tag, parent_node, ch, start, end, format, this.has_trailing_comma(parent_node as ref[AstNode], ch), TextRange(list_pos, list_end))
        }
        this.on_after_emit_node_list(children)
        if (format & LFBracketsMask) <> 0
        {
            if is_empty and (is_nil = false)
                this.emit_leading_comments(list_end, false)
            this.write_punctuation(this.get_closing_bracket(format))
        }
    }

    ; NodeList.HasTrailingComma() is unreliable on transformed nodes; look at the
    ; respective list on the original node first.
    procedure has_trailing_comma(this, parent_node: ref[AstNode], children: ref[Array[ref[AstNode]?]]) returns bool
    {
        let f context.the_factory()
        if f.list_has_trailing_comma(children) = false
            return false
        let original_parent context.most_original(parent_node) as ref[AstNode]
        if original_parent = parent_node
            return true
        if original_parent.kind <> parent_node.kind
            return false
        var original_list: ref[Array[ref[AstNode]?]]? children
        let k original_parent.kind
        if k = KindObjectLiteralExpression
            set original_list: AstNode.properties_of(original_parent)
        else
        {
            if (k = KindArrayLiteralExpression) or (k = KindNamedImports) or (k = KindNamedExports)
                set original_list: AstNode.elements_of(original_parent)
            else
            {
                if (k = KindCallExpression) or (k = KindNewExpression)
                {
                    if children = AstNode.type_arguments_of(parent_node)
                        set original_list: AstNode.type_arguments_of(original_parent)
                    else
                    {
                        if children = AstNode.call_arguments_of(parent_node)
                            set original_list: AstNode.call_arguments_of(original_parent)
                    }
                }
                else
                {
                    if (k = KindConstructor) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindArrowFunction) or (k = KindFunctionType) or (k = KindConstructorType) or (k = KindCallSignature) or (k = KindConstructSignature)
                    {
                        if children = AstNode.type_parameters_of(parent_node)
                            set original_list: AstNode.type_parameters_of(original_parent)
                        else
                        {
                            if children = AstNode.parameters_of(parent_node)
                                set original_list: AstNode.parameters_of(original_parent)
                        }
                    }
                    else
                    {
                        if (k = KindClassDeclaration) or (k = KindClassExpression) or (k = KindInterfaceDeclaration) or (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration)
                        {
                            if children = AstNode.type_parameters_of(parent_node)
                                set original_list: AstNode.type_parameters_of(original_parent)
                        }
                        else
                        {
                            if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern)
                            {
                                if children = AstNode.elements_of(parent_node)
                                    set original_list: AstNode.elements_of(original_parent)
                            }
                            else
                            {
                                if k = KindImportAttributes
                                    set original_list: Printer.import_attributes_elements_of(original_parent)
                            }
                        }
                    }
                }
            }
        }
        if original_list <> null
            return f.list_has_trailing_comma(original_list)
        false
    }

    procedure write_delimiter(mutable this, format: int)
    {
        let d format & LFDelimitersMask
        if d = LFCommaDelimited
        {
            this.write_punctuation(",")
            return
        }
        if d = LFBarDelimited
        {
            this.write_space()
            this.write_punctuation("|")
            return
        }
        if d = LFAsteriskDelimited
        {
            this.write_space()
            this.write_punctuation("*")
            this.write_space()
            return
        }
        if d = LFAmpersandDelimited
        {
            this.write_space()
            this.write_punctuation("&")
        }
    }

    ; Emits a list without brackets or raising events: children[from, to).
    procedure emit_list_items(mutable this, emit_tag: int, parent_node: ref[AstNode]?, mutable children: ref[Array[ref[AstNode]?]], from: int, to: int, format: int, has_trailing_comma: bool, children_text_range: TextRange)
    {
        let may_emit_intervening_comments (format & LFNoInterveningComments) = 0
        var should_emit_intervening_comments may_emit_intervening_comments
        var leading_line_terminator_count 0
        if to > from
            set leading_line_terminator_count: this.get_leading_line_terminator_count(parent_node, children[from as size_t], format)
        if leading_line_terminator_count > 0
        {
            this.write_line_repeat(leading_line_terminator_count)
            set should_emit_intervening_comments: false
        }
        else
        {
            if (format & LFSpaceBetweenBraces) <> 0
                this.write_space()
        }
        if (format & LFIndented) <> 0
            this.increase_indent()
        let parent_end Printer.greatest_end_node(0 - 1, parent_node)
        var previous_sibling: ref[AstNode]? null
        var should_decrease_indent_after_emit false
        var i from
        while i < to
        {
            let child children[i as size_t] as ref[AstNode]
            set i: i + 1
            if (format & LFAsteriskDelimited) <> 0
            {
                ; always write JSDoc in the format "\n *"
                this.write_line()
                this.write_delimiter(format)
            }
            else
            {
                if previous_sibling <> null
                {
                    let prev previous_sibling as ref[AstNode]
                    if ((format & LFDelimitersMask) <> 0) and (prev.end <> parent_end)
                    {
                        if (comments_disabled = false) and this.should_emit_trailing_comments(prev)
                            this.emit_leading_comments(prev.end, false)
                    }
                    this.write_delimiter(format)
                    let separating_line_terminator_count this.get_separating_line_terminator_count(previous_sibling, child, format)
                    if separating_line_terminator_count > 0
                    {
                        ; a synthesized node in a single-line list that starts on a new line indents
                        if (format & (LFLinesMask | LFIndented)) = LFSingleLine
                        {
                            this.increase_indent()
                            set should_decrease_indent_after_emit: true
                        }
                        if should_emit_intervening_comments and ((format & LFDelimitersMask) <> 0) and (Printer.position_is_synthesized(child.pos) = false) and this.should_emit_leading_comments(child)
                        {
                            let comment_range context.comment_range(child)
                            this.emit_trailing_comments_of_position(comment_range.pos, (format & LFSpaceBetweenSiblings) <> 0, true)
                        }
                        this.write_line_repeat(separating_line_terminator_count)
                        set should_emit_intervening_comments: false
                    }
                    else
                    {
                        if (format & LFSpaceBetweenSiblings) <> 0
                            this.write_space()
                    }
                }
            }
            ; this child
            if should_emit_intervening_comments and this.should_emit_leading_comments(child)
            {
                let comment_range context.comment_range(child)
                this.emit_trailing_comments_of_position(comment_range.pos, false, false)
            }
            else
                set should_emit_intervening_comments: may_emit_intervening_comments
            set this.next_list_element_pos: child.pos
            this.emit_tagged(emit_tag, child)
            if should_decrease_indent_after_emit
            {
                this.decrease_indent()
                set should_decrease_indent_after_emit: false
            }
            set previous_sibling: child
        }
        ; a trailing comma, if requested
        var skip_trailing_comments comments_disabled
        if previous_sibling <> null
        {
            if this.should_emit_trailing_comments(previous_sibling as ref[AstNode]) = false
                set skip_trailing_comments: true
        }
        let emit_trailing_comma has_trailing_comma and ((format & LFAllowTrailingComma) <> 0) and ((format & LFCommaDelimited) <> 0)
        if emit_trailing_comma
        {
            if (previous_sibling <> null) and (skip_trailing_comments = false)
            {
                let prev previous_sibling as ref[AstNode]
                this.emit_token(KindCommaToken, prev.end, WriteKindPunctuation, prev)
            }
            else
                this.write_punctuation(",")
        }
        ; the trailing comment of the last element
        if previous_sibling <> null
        {
            let prev previous_sibling as ref[AstNode]
            if (parent_end <> prev.end) and ((format & LFDelimitersMask) <> 0) and (skip_trailing_comments = false)
            {
                var comments_pos prev.end
                if emit_trailing_comma and (children_text_range.end > 0)
                    set comments_pos: children_text_range.end as i32
                this.emit_leading_comments(comments_pos, false)
            }
        }
        if (format & LFIndented) <> 0
            this.decrease_indent()
        var last: ref[AstNode]? null
        if to > from
            set last: children[(to - 1) as size_t]
        let closing_line_terminator_count this.get_closing_line_terminator_count(parent_node, last, format, children_text_range)
        if closing_line_terminator_count > 0
            this.write_line_repeat(closing_line_terminator_count)
        else
        {
            if (format & (LFSpaceAfterList | LFSpaceBetweenBraces)) <> 0
                this.write_space()
        }
    }

    ; The `emit func(p, node)` of a list, by tag (§3.18). The tags arrive with
    ; the emitters that use them (slices 234/235); an unknown tag is a said stop.
    procedure emit_tagged(mutable this, emit_tag: int, mutable node: ref[AstNode])
    {
        if emit_tag = EmitTagKeywordNode
        {
            this.emit_keyword_node(node)
            return
        }
        if emit_tag = EmitTagModifierLike
        {
            this.emit_modifier_like(node)
            return
        }
        if emit_tag = EmitTagTypeParameterDeclarationNode
        {
            this.emit_type_parameter_declaration_node(node)
            return
        }
        if emit_tag = EmitTagParameterDeclarationNode
        {
            this.emit_parameter_declaration_node(node)
            return
        }
        if emit_tag = EmitTagStatement
        {
            this.emit_statement(node)
            return
        }
        if emit_tag = EmitTagTypeElement
        {
            this.emit_type_element(node)
            return
        }
        if emit_tag = EmitTagTupleElementType
        {
            this.emit_tuple_element_type(node)
            return
        }
        if emit_tag = EmitTagUnionTypeConstituent
        {
            this.emit_union_type_constituent(node)
            return
        }
        if emit_tag = EmitTagIntersectionTypeConstituent
        {
            this.emit_intersection_type_constituent(node)
            return
        }
        if emit_tag = EmitTagTemplateTypeSpanNode
        {
            this.emit_template_type_span_node(node)
            return
        }
        if emit_tag = EmitTagImportAttributeNode
        {
            this.emit_import_attribute_node(node)
            return
        }
        if emit_tag = EmitTagBindingElementNode
        {
            this.emit_binding_element_node(node)
            return
        }
        if emit_tag = EmitTagArrayLiteralExpressionElement
        {
            this.emit_array_literal_expression_element(node)
            return
        }
        if emit_tag = EmitTagObjectLiteralElement
        {
            this.emit_object_literal_element(node)
            return
        }
        if emit_tag = EmitTagArgument
        {
            this.emit_argument(node)
            return
        }
        if emit_tag = EmitTagTemplateSpanNode
        {
            this.emit_template_span_node(node)
            return
        }
        if emit_tag = EmitTagHeritageClauseNode
        {
            this.emit_heritage_clause_node(node)
            return
        }
        if emit_tag = EmitTagClassElement
        {
            this.emit_class_element(node)
            return
        }
        if emit_tag = EmitTagCaseOrDefaultClauseNode
        {
            this.emit_case_or_default_clause_node(node)
            return
        }
        if emit_tag = EmitTagJsxChild
        {
            this.emit_jsx_child(node)
            return
        }
        if emit_tag = EmitTagJsxAttributeLike
        {
            this.emit_jsx_attribute_like(node)
            return
        }
        if emit_tag = EmitTagEnumMemberNode
        {
            this.emit_enum_member_node(node)
            return
        }
        if emit_tag = EmitTagImportSpecifierNode
        {
            this.emit_import_specifier_node(node)
            return
        }
        if emit_tag = EmitTagExportSpecifierNode
        {
            this.emit_export_specifier_node(node)
            return
        }
        if emit_tag = EmitTagVariableDeclarationNode
        {
            this.emit_variable_declaration_node(node)
            return
        }
        if emit_tag = EmitTagExpressionWithTypeArgumentsNode
        {
            this.emit_expression_with_type_arguments_node(node)
            return
        }
        this.record_unported("emit-list-tag", emit_tag)
    }

    ; ── general ──

    procedure emit(mutable this, mutable node: ref[AstNode], mutable file: ref[SourceFileInfo]?) returns String
    {
        if own_writer = null
            set this.own_writer: TextWriter.create(host, options.new_line_character(), 0)
        let w own_writer as ref[TextWriter]
        this.write_node(node, file, w, null)
        let text w.to_string()
        w.clear(host)
        text
    }

    procedure emit_source_file_text(mutable this, mutable file: ref[SourceFileInfo]) returns String
        this.emit(file.node, file)

    procedure set_source_file(mutable this, mutable file: ref[SourceFileInfo]?)
    {
        set this.current_source_file: file
        set this.unique_helper_names: null
        set this.external_helpers_module_name: null
        if file <> null
        {
            let f file as ref[SourceFileInfo]
            let mo context.most_original(f.node) as ref[AstNode]
            if (context.emit_flags(mo) & EFExternalHelpers) <> 0
                set this.unique_helper_names: &Array[NameNode]^host()
            set this.external_helpers_module_name: context.get_external_helpers_module_name(f.node)
            this.set_source_map_source(f)
        }
    }

    ; Printer.Write
    procedure write_node(mutable this, mutable node: ref[AstNode], mutable file: ref[SourceFileInfo]?, mutable writer_in: ref[TextWriter], source_map_generator_in: ref[SourceMapGenerator]?)
    {
        let saved_current_source_file current_source_file
        let saved_writer writer
        let saved_unique_helper_names unique_helper_names
        let saved_source_maps_disabled source_maps_disabled
        let saved_source_map_generator source_map_generator
        let saved_source_map_source source_map_source
        let saved_source_map_source_index source_map_source_index
        let saved_source_map_line_char_cache source_map_line_char_cache
        set this.source_maps_disabled: source_map_generator_in = null
        set this.source_map_generator: source_map_generator_in
        set this.source_map_source: null
        set this.source_map_source_index: 0 - 1
        set this.source_map_line_char_cache: null
        this.set_source_file(file)
        set this.writer: writer_in
        writer_in.clear(host)
        this.write_node_by_kind(node)
        set this.current_source_file: saved_current_source_file
        set this.writer: saved_writer
        set this.unique_helper_names: saved_unique_helper_names
        set this.source_maps_disabled: saved_source_maps_disabled
        set this.source_map_generator: saved_source_map_generator
        set this.source_map_source: saved_source_map_source
        set this.source_map_source_index: saved_source_map_source_index
        set this.source_map_line_char_cache: saved_source_map_line_char_cache
    }

    ; Write's switch. GENERATED-LIKE: one arm per kind the reference lists, in
    ; its order; the arms whose emitter has not landed reach `emit_unported`
    ; through their stub.
    procedure write_node_by_kind(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindTemplateHead
        {
            this.emit_template_head(node)
            return
        }
        if k = KindTemplateMiddle
        {
            this.emit_template_middle(node)
            return
        }
        if k = KindTemplateTail
        {
            this.emit_template_tail(node)
            return
        }
        if k = KindIdentifier
        {
            this.emit_identifier_name(node)
            return
        }
        if k = KindPrivateIdentifier
        {
            this.emit_private_identifier(node)
            return
        }
        if k = KindQualifiedName
        {
            this.emit_qualified_name(node)
            return
        }
        if k = KindComputedPropertyName
        {
            this.emit_computed_property_name(node)
            return
        }
        if k = KindTypeParameter
        {
            this.emit_type_parameter(node)
            return
        }
        if k = KindParameter
        {
            this.emit_parameter(node)
            return
        }
        if k = KindDecorator
        {
            this.emit_decorator(node)
            return
        }
        if k = KindPropertySignature
        {
            this.emit_property_signature(node)
            return
        }
        if k = KindPropertyDeclaration
        {
            this.emit_property_declaration(node)
            return
        }
        if k = KindMethodSignature
        {
            this.emit_method_signature(node)
            return
        }
        if k = KindMethodDeclaration
        {
            this.emit_method_declaration(node)
            return
        }
        if k = KindClassStaticBlockDeclaration
        {
            this.emit_class_static_block_declaration(node)
            return
        }
        if k = KindConstructor
        {
            this.emit_constructor(node)
            return
        }
        if k = KindGetAccessor
        {
            this.emit_get_accessor_declaration(node)
            return
        }
        if k = KindSetAccessor
        {
            this.emit_set_accessor_declaration(node)
            return
        }
        if k = KindCallSignature
        {
            this.emit_call_signature(node)
            return
        }
        if k = KindConstructSignature
        {
            this.emit_construct_signature(node)
            return
        }
        if k = KindIndexSignature
        {
            this.emit_index_signature(node)
            return
        }
        if k = KindObjectBindingPattern
        {
            this.emit_object_binding_pattern(node)
            return
        }
        if k = KindArrayBindingPattern
        {
            this.emit_array_binding_pattern(node)
            return
        }
        if k = KindBindingElement
        {
            this.emit_binding_element(node)
            return
        }
        if k = KindTemplateSpan
        {
            this.emit_template_span(node)
            return
        }
        if k = KindSemicolonClassElement
        {
            this.emit_semicolon_class_element(node)
            return
        }
        if k = KindVariableDeclaration
        {
            this.emit_variable_declaration(node)
            return
        }
        if k = KindVariableDeclarationList
        {
            this.emit_variable_declaration_list(node)
            return
        }
        if k = KindModuleBlock
        {
            this.emit_module_block(node)
            return
        }
        if k = KindCaseBlock
        {
            this.emit_case_block(node)
            return
        }
        if k = KindImportClause
        {
            this.emit_import_clause(node)
            return
        }
        if k = KindNamespaceImport
        {
            this.emit_namespace_import(node)
            return
        }
        if k = KindNamespaceExport
        {
            this.emit_namespace_export(node)
            return
        }
        if k = KindNamedImports
        {
            this.emit_named_imports(node)
            return
        }
        if k = KindImportSpecifier
        {
            this.emit_import_specifier(node)
            return
        }
        if k = KindNamedExports
        {
            this.emit_named_exports(node)
            return
        }
        if k = KindExportSpecifier
        {
            this.emit_export_specifier(node)
            return
        }
        if k = KindImportAttributes
        {
            this.emit_import_attributes(node)
            return
        }
        if k = KindImportAttribute
        {
            this.emit_import_attribute(node)
            return
        }
        if k = KindExternalModuleReference
        {
            this.emit_external_module_reference(node)
            return
        }
        if k = KindJsxText
        {
            this.emit_jsx_text(node)
            return
        }
        if k = KindJsxOpeningElement
        {
            this.emit_jsx_opening_element(node)
            return
        }
        if k = KindJsxOpeningFragment
        {
            this.emit_jsx_opening_fragment(node)
            return
        }
        if k = KindJsxClosingElement
        {
            this.emit_jsx_closing_element(node)
            return
        }
        if k = KindJsxClosingFragment
        {
            this.emit_jsx_closing_fragment(node)
            return
        }
        if k = KindJsxAttribute
        {
            this.emit_jsx_attribute(node)
            return
        }
        if k = KindJsxAttributes
        {
            this.emit_jsx_attributes(node)
            return
        }
        if k = KindJsxSpreadAttribute
        {
            this.emit_jsx_spread_attribute(node)
            return
        }
        if k = KindJsxExpression
        {
            this.emit_jsx_expression(node)
            return
        }
        if k = KindJsxNamespacedName
        {
            this.emit_jsx_namespaced_name(node)
            return
        }
        if k = KindCaseClause
        {
            this.emit_case_clause(node)
            return
        }
        if k = KindDefaultClause
        {
            this.emit_default_clause(node)
            return
        }
        if k = KindHeritageClause
        {
            this.emit_heritage_clause(node)
            return
        }
        if k = KindCatchClause
        {
            this.emit_catch_clause(node)
            return
        }
        if k = KindPropertyAssignment
        {
            this.emit_property_assignment(node)
            return
        }
        if k = KindShorthandPropertyAssignment
        {
            this.emit_shorthand_property_assignment(node)
            return
        }
        if k = KindSpreadAssignment
        {
            this.emit_spread_assignment(node)
            return
        }
        if k = KindEnumMember
        {
            this.emit_enum_member(node)
            return
        }
        if k = KindSourceFile
        {
            this.emit_source_file(node)
            return
        }
        if k = KindNotEmittedTypeElement
        {
            this.emit_not_emitted_type_element(node)
            return
        }
        if AstNode.is_type_node_kind(k)
        {
            this.emit_type_node_outside_extends(node)
            return
        }
        if Checker.is_statement(node)
        {
            this.emit_statement(node)
            return
        }
        if AstNode.is_expression_node(node)
        {
            this.emit_expression(node, OperatorPrecedenceLowest)
            return
        }
        if Printer.is_keyword_kind(k)
        {
            this.emit_keyword_node(node)
            return
        }
        if Printer.is_punctuation_kind(k)
        {
            this.emit_punctuation_node(node)
            return
        }
        if Printer.is_jsdoc_kind(k)
        {
            this.emit_jsdoc_node(node)
            return
        }
        ; the reference PANICS ("unhandled Node")
        this.record_unported("write-node-kind", k)
    }

    ; ── comments ──

    procedure emit_comments_before_node(mutable this, node: ref[AstNode]) returns CommentState
    {
        if this.should_emit_comments(node) = false
            return CommentState.none()
        let emit_flags context.emit_flags(node)
        let comment_range context.comment_range(node)
        let saved_container_pos container_pos
        let saved_container_end container_end
        let saved_declaration_list_container_end declaration_list_container_end
        this.emit_leading_comments_of_node(node, emit_flags, comment_range)
        this.emit_leading_synthetic_comments_of_node(node, emit_flags)
        if (emit_flags & EFNoNestedComments) <> 0
            set this.comments_disabled: true
        CommentState(true, emit_flags, comment_range, saved_container_pos, saved_container_end, saved_declaration_list_container_end)
    }

    procedure emit_comments_after_node(mutable this, node: ref[AstNode], state: CommentState)
    {
        if state.present = false
            return
        let emit_flags state.emit_flags
        if (emit_flags & EFNoNestedComments) <> 0
            set this.comments_disabled: false
        this.emit_trailing_synthetic_comments_of_node(node, emit_flags)
        this.emit_trailing_comments_of_node(node, emit_flags, state.comment_range, state.container_pos, state.container_end, state.declaration_list_container_end)
        ; comments of an erased type annotation
        let type_node context.get_type_node(node)
        if type_node <> null
            this.emit_trailing_comments_of_node(node, emit_flags, TextRange.of_node(type_node as ref[AstNode]), state.container_pos, state.container_end, state.declaration_list_container_end)
    }

    ; `pos` is in/out: the token position after trivia.
    procedure emit_comments_before_token(mutable this, token: int, mutable pos: ref[int], context_node: ref[AstNode], flags: int) returns CommentState
    {
        if ((flags & TefNoComments) <> 0) or comments_disabled
        {
            ; still skip trivia so the returned pos identifies the token
            if (current_source_file <> null) and (Printer.position_is_synthesized(pos) = false)
                set pos: Scanner.skip_trivia(this.file_text(), pos)
            return CommentState.none()
        }
        ; ★ a TYPED binding: `let start_pos pos` would ALIAS the out-parameter
        ; and read the skipped position after the store below (root CLAUDE.md)
        let start_pos: int pos
        if current_source_file <> null
            set pos: Scanner.skip_trivia(this.file_text(), start_pos)
        let node context.parse_node(context_node)
        var is_similar_node false
        if node <> null
        {
            if (node as ref[AstNode]).kind = context_node.kind
                set is_similar_node: true
        }
        if is_similar_node = false
            return CommentState.none()
        if context_node.pos <> start_pos
        {
            let indent_leading (flags & TefIndentLeadingComments) <> 0
            var needs_indent false
            if indent_leading and (current_source_file <> null)
            {
                if Printer.positions_are_on_same_line(start_pos, pos, this.file_lines()) = false
                    set needs_indent: true
            }
            this.increase_indent_if(needs_indent)
            this.emit_leading_comments(start_pos, false)
            this.decrease_indent_if(needs_indent)
        }
        CommentState.blank()
    }

    procedure emit_comments_after_token(mutable this, token: int, pos: int, context_node: ref[AstNode], state: CommentState)
    {
        if state.present = false
            return
        if context_node.end <> pos
        {
            var separator CommentSeparatorBefore
            if context_node.kind = KindJsxExpression
                set separator: CommentSeparatorNone
            this.emit_trailing_comments(pos, separator)
        }
    }

    procedure emit_detached_comments_before_statement_list(mutable this, node: ref[AstNode], detached_range: TextRange) returns CommentState
    {
        if this.should_emit_detached_comments(node) = false
            return CommentState.none()
        let emit_flags context.emit_flags(node)
        let saved_container_pos container_pos
        let saved_container_end container_end
        let saved_declaration_list_container_end declaration_list_container_end
        let skip_leading_comments Printer.position_is_synthesized(detached_range.pos) or ((emit_flags & EFNoLeadingComments) <> 0)
        if skip_leading_comments = false
            this.emit_detached_comments_and_update_comments_info(detached_range)
        if (emit_flags & EFNoNestedComments) <> 0
            set this.comments_disabled: true
        CommentState(true, emit_flags, detached_range, saved_container_pos, saved_container_end, saved_declaration_list_container_end)
    }

    procedure emit_detached_comments_after_statement_list(mutable this, node: ref[AstNode], detached_range: TextRange, state: CommentState)
    {
        if state.present = false
            return
        let emit_flags state.emit_flags
        let skip_trailing_comments comments_disabled or Printer.position_is_synthesized(detached_range.end) or ((emit_flags & EFNoTrailingComments) <> 0)
        if skip_trailing_comments = false
        {
            let has_written_comment this.emit_leading_comments(detached_range.end, false)
            if has_written_comment and (this.the_writer().is_at_start_of_line() = false)
                this.write_line()
        }
    }

    procedure emit_leading_comments_of_node(mutable this, node: ref[AstNode], emit_flags: int, comment_range: TextRange)
    {
        let pos comment_range.pos
        let end comment_range.end
        if ((Printer.position_is_synthesized(pos) = false) or (Printer.position_is_synthesized(end) = false)) and (pos <> end)
        {
            ; JsxText is checked explicitly: under jsx "preserve" nothing transforms it
            let skip_leading_comments Printer.position_is_synthesized(pos) or ((emit_flags & EFNoLeadingComments) <> 0) or (node.kind = KindJsxText)
            let skip_trailing_comments Printer.position_is_synthesized(end) or ((emit_flags & EFNoTrailingComments) <> 0) or (node.kind = KindJsxText)
            if skip_leading_comments = false
                this.emit_leading_comments(pos, node.kind = KindNotEmittedStatement)
            if (skip_leading_comments = false) or ((pos >= 0) and ((emit_flags & EFNoLeadingComments) <> 0))
                set this.container_pos: pos
            if (skip_trailing_comments = false) or ((end >= 0) and ((emit_flags & EFNoTrailingComments) <> 0))
            {
                set this.container_end: end
                ; the last declaration list container's end, against a down-level binding pattern
                if node.kind = KindVariableDeclarationList
                    set this.declaration_list_container_end: end
            }
        }
    }

    procedure emit_trailing_comments_of_node(mutable this, node: ref[AstNode], emit_flags: int, comment_range: TextRange, saved_container_pos: int, saved_container_end: int, saved_declaration_list_container_end: int)
    {
        let pos comment_range.pos
        let end comment_range.end
        let skip_trailing_comments (end < 0) or ((emit_flags & EFNoTrailingComments) <> 0) or (node.kind = KindJsxText)
        if ((Printer.position_is_synthesized(pos) = false) or (Printer.position_is_synthesized(end) = false)) and (pos <> end)
        {
            set this.container_pos: saved_container_pos
            set this.container_end: saved_container_end
            set this.declaration_list_container_end: saved_declaration_list_container_end
            if (skip_trailing_comments = false) and (node.kind <> KindNotEmittedStatement)
                this.emit_trailing_comments(end, CommentSeparatorBefore)
        }
    }

    procedure emit_leading_synthetic_comments_of_node(mutable this, node: ref[AstNode], emit_flags: int)
    {
        if (emit_flags & EFNoLeadingComments) <> 0
            return
        let synth context.get_synthetic_leading_comments(node)
        if synth = null
            return
        let list synth as ref[Array[SynthesizedComment]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.emit_leading_synthesized_comment(list[i as size_t])
            set i: i + 1
        }
    }

    procedure emit_leading_synthesized_comment(mutable this, comment: SynthesizedComment)
    {
        let w this.the_writer()
        if comment.has_leading_new_line or (comment.kind = KindSingleLineCommentTrivia)
            w.write_line()
        this.write_synthesized_comment(comment)
        if comment.has_trailing_new_line or (comment.kind = KindSingleLineCommentTrivia)
            w.write_line()
        else
            w.write_space(" ")
    }

    procedure emit_trailing_synthetic_comments_of_node(mutable this, node: ref[AstNode], emit_flags: int)
    {
        if (emit_flags & EFNoTrailingComments) <> 0
            return
        let synth context.get_synthetic_trailing_comments(node)
        if synth = null
            return
        let list synth as ref[Array[SynthesizedComment]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.emit_trailing_synthesized_comment(list[i as size_t])
            set i: i + 1
        }
    }

    procedure emit_trailing_synthesized_comment(mutable this, comment: SynthesizedComment)
    {
        let w this.the_writer()
        if w.is_at_start_of_line() = false
            w.write_space(" ")
        this.write_synthesized_comment(comment)
        if comment.has_trailing_new_line
            w.write_line()
    }

    function format_synthesized_comment(host: ref[Page], comment: SynthesizedComment) returns String
    {
        let b StringBuilder^host()
        if comment.kind = KindMultiLineCommentTrivia
        {
            b.append("/*")
            b.append(comment.text.data, comment.text.length)
            b.append("*/")
            return b.to_string()
        }
        b.append("//")
        b.append(comment.text.data, comment.text.length)
        b.to_string()
    }

    procedure write_synthesized_comment(mutable this, comment: SynthesizedComment)
    {
        let text Printer.slice_of(Printer.format_synthesized_comment(host, comment))
        var line_map: ref[Array[int]]? null
        if comment.kind = KindMultiLineCommentTrivia
            set line_map: Printer.compute_ecma_line_starts(host, text)
        this.write_comment_range_worker(text, line_map, comment.kind, 0, text.length as int)
    }

    procedure emit_leading_comments(mutable this, pos_in: int, elided: bool) returns bool
    {
        ; only when the container's pos does not match: the container emits those
        if comments_disabled or (current_source_file = null) or Printer.position_is_synthesized(pos_in) or (pos_in = container_pos)
            return false
        let csf current_source_file as ref[SourceFileInfo]
        var triple_slash TristateUnknown
        if elided = false
        {
            if (pos_in = 0) and csf.is_declaration_file
                set triple_slash: TristateFalse
        }
        else
        {
            ; a node not emitted in JS drops every comment but a triple-slash at the top of the file
            if pos_in = 0
                set triple_slash: TristateTrue
            else
                return false
        }
        var pos pos_in
        ; skip detached comments
        if detached_depth > 0
        {
            let info detached_comments_info[(detached_depth - 1) as size_t]
            if info.node_pos = pos
            {
                set this.detached_depth: detached_depth - 1
                set pos: info.detached_comment_end_pos
            }
        }
        let all Scanner.get_leading_comment_ranges(host, csf.text, pos)
        let comments &Array[CommentRange]^host()
        var i 0
        while i < (all.get_length() as int)
        {
            let c all[i as size_t]
            if this.should_write_comment(c) and this.should_emit_comment_if_triple_slash(c, triple_slash)
                comments.add(c)
            set i: i + 1
        }
        if (comments.get_length() as int) > 0
        {
            let first comments[0]
            if this.should_emit_new_line_before_leading_comment_of_position(pos, first.pos)
                this.write_line()
        }
        ; leading comments are /*leading comment1*/space/*leading comment*/space
        this.emit_comments(comments, CommentSeparatorAfter)
    }

    function should_emit_comment_if_triple_slash(this, comment: CommentRange, triple_slash: int) returns bool
    {
        if triple_slash = TristateTrue
            return this.is_triple_slash_comment(comment)
        if triple_slash = TristateFalse
            return this.is_triple_slash_comment(comment) = false
        true
    }

    ; a new line when the leading comments start on a different line than the node
    function should_emit_new_line_before_leading_comment_of_position(this, pos: int, comment_pos: int) returns bool
    {
        if current_source_file = null
            return false
        if pos = comment_pos
            return false
        let lines this.file_lines()
        Scanner.compute_line_of_position(lines, pos) <> Scanner.compute_line_of_position(lines, comment_pos)
    }

    procedure emit_leading_comments_of_position(mutable this, pos: int)
    {
        if comments_disabled or (pos = 0 - 1)
            return
        this.emit_leading_comments(pos, false)
    }

    procedure emit_trailing_comments(mutable this, pos: int, comment_separator: int)
    {
        if comments_disabled or (current_source_file = null)
            return
        ; only when the container's end does not match: the container emits those
        if (container_end <> 0 - 1) and ((pos = container_end) or (pos = declaration_list_container_end))
            return
        let all Scanner.get_trailing_comment_ranges(host, this.file_text(), pos)
        let comments &Array[CommentRange]^host()
        var i 0
        while i < (all.get_length() as int)
        {
            let c all[i as size_t]
            if this.should_write_comment(c)
                comments.add(c)
            set i: i + 1
        }
        ; trailing comments are space/*trailing comment1*/space/*trailing comment2*/
        this.emit_comments(comments, comment_separator)
    }

    procedure emit_trailing_comments_of_position(mutable this, pos: int, prefix_space: bool, force_no_newline: bool)
    {
        if comments_disabled or (current_source_file = null)
            return
        if (container_end <> 0 - 1) and ((pos = container_end) or (pos = declaration_list_container_end))
            return
        let comments Scanner.get_trailing_comment_ranges(host, this.file_text(), pos)
        var i 0
        while i < (comments.get_length() as int)
        {
            let comment comments[i as size_t]
            set i: i + 1
            if prefix_space
            {
                if this.should_write_comment(comment) = false
                    continue
                if this.the_writer().is_at_start_of_line() = false
                    this.write_space()
                this.emit_comment(comment)
                if comment.has_trailing_new_line
                    this.write_line()
                continue
            }
            this.emit_comment(comment)
            if force_no_newline
            {
                if comment.kind = KindSingleLineCommentTrivia
                    this.write_line()
            }
            else
            {
                if comment.has_trailing_new_line
                    this.write_line()
                else
                    this.write_space()
            }
        }
    }

    procedure emit_detached_comments_and_update_comments_info(mutable this, text_range: TextRange)
    {
        if current_source_file = null
            return
        var node_pos 0
        var end_pos 0
        if this.emit_detached_comments(text_range, &node_pos, &end_pos)
        {
            ; push
            if detached_depth < (detached_comments_info.get_length() as int)
                detached_comments_info.put(detached_depth as size_t, DetachedCommentsInfo(node_pos, end_pos))
            else
                detached_comments_info.add(DetachedCommentsInfo(node_pos, end_pos))
            set this.detached_depth: detached_depth + 1
        }
    }

    ; The copyright-header rule: leading comments with no blank line between
    ; them, followed by at least one blank line before the node.
    procedure emit_detached_comments(mutable this, text_range: TextRange, mutable out_node_pos: ref[int], mutable out_end_pos: ref[int]) returns bool
    {
        if current_source_file = null
            return false
        let csf current_source_file as ref[SourceFileInfo]
        let text csf.text
        let line_map csf.line_starts
        var leading_comments: ref[Array[CommentRange]]? null
        if comments_disabled
        {
            ; removeComments: only a pinned comment at the top of the file
            if text_range.pos = 0
            {
                let all Scanner.get_leading_comment_ranges(host, text, text_range.pos)
                let pinned &Array[CommentRange]^host()
                var i 0
                while i < (all.get_length() as int)
                {
                    let c all[i as size_t]
                    if Printer.is_pinned_comment(text, c)
                        pinned.add(c)
                    set i: i + 1
                }
                set leading_comments: pinned
            }
        }
        else
            set leading_comments: Scanner.get_leading_comment_ranges(host, text, text_range.pos)
        if leading_comments = null
            return false
        let lc leading_comments as ref[Array[CommentRange]]
        if (lc.get_length() as int) = 0
            return false
        let detached_comments &Array[CommentRange]^host()
        var last_comment_end 0
        var i 0
        while i < (lc.get_length() as int)
        {
            let comment lc[i as size_t]
            if i > 0
            {
                let last_comment_line Scanner.compute_line_of_position(line_map, last_comment_end)
                let comment_line Scanner.compute_line_of_position(line_map, comment.pos)
                if comment_line >= last_comment_line + 2
                    break
            }
            detached_comments.add(comment)
            set last_comment_end: comment.end
            set i: i + 1
        }
        let n detached_comments.get_length() as int
        if n = 0
            return false
        let last_detached detached_comments[(n - 1) as size_t]
        let last_comment_line Scanner.compute_line_of_position(line_map, last_detached.end)
        let node_line Scanner.compute_line_of_position(line_map, Scanner.skip_trivia(text, text_range.pos))
        if node_line < last_comment_line + 2
            return false
        ; valid detached comments: those that should be written
        let comments_to_emit &Array[CommentRange]^host()
        var j 0
        while j < n
        {
            let c detached_comments[j as size_t]
            if this.should_write_comment(c)
                comments_to_emit.add(c)
            set j: j + 1
        }
        if (comments_to_emit.get_length() as int) > 0
        {
            let first comments_to_emit[0]
            if this.should_emit_new_line_before_leading_comment_of_position(text_range.pos, first.pos)
                this.write_line()
            this.emit_comments(comments_to_emit, CommentSeparatorAfter)
        }
        set out_node_pos: text_range.pos
        set out_end_pos: last_detached.end
        true
    }

    procedure emit_comments(mutable this, comments: ref[Array[CommentRange]], comment_separator: int) returns bool
    {
        var intervening_separator false
        if (comments.get_length() as int) = 0
            return false
        if comment_separator = CommentSeparatorBefore
            this.write_space()
        var i 0
        while i < (comments.get_length() as int)
        {
            let comment comments[i as size_t]
            set i: i + 1
            if intervening_separator
            {
                this.write_space()
                set intervening_separator: false
            }
            this.emit_comment(comment)
            if (comment.kind = KindSingleLineCommentTrivia) or (comment.has_trailing_new_line and (comment_separator <> CommentSeparatorNone))
                this.write_line()
            else
                set intervening_separator: comment_separator <> CommentSeparatorNone
        }
        if intervening_separator and (comment_separator = CommentSeparatorAfter)
            this.write_space()
        true
    }

    procedure emit_comment(mutable this, comment: CommentRange)
    {
        this.emit_pos(comment.pos)
        this.write_comment_range(comment)
        this.emit_pos(comment.end)
    }

    function is_triple_slash_comment(this, comment: CommentRange) returns bool
    {
        if current_source_file = null
            return false
        Printer.is_recognized_triple_slash_comment(this.file_text(), comment)
    }

    ; ── source maps ──

    procedure set_source_map_source(mutable this, mutable source: ref[SourceFileInfo])
    {
        if source_maps_disabled
            return
        set this.source_map_source: source
        set this.source_map_line_char_cache: LineCharacterCache.create(host, source.line_starts, source.text)
        if most_recent_source_map_source = source
        {
            set this.source_map_source_index: most_recent_source_map_source_index
            return
        }
        set this.source_map_source_is_json: source.file_name.ends_with(".json")
        if source_map_source_is_json
            return
        let gen source_map_generator as ref[SourceMapGenerator]
        set this.source_map_source_index: gen.add_source(source.file_name)
        if options.inline_sources
            gen.set_source_content(source_map_source_index, source.text)
        set this.most_recent_source_map_source: source
        set this.most_recent_source_map_source_index: source_map_source_index
    }

    procedure emit_pos(mutable this, pos: int)
    {
        if source_maps_disabled or (source_map_source = null) or (source_map_generator = null) or source_map_source_is_json or Printer.position_is_synthesized(pos)
            return
        let cache source_map_line_char_cache as ref[LineCharacterCache]
        var source_line 0
        var source_character 0
        cache.get_line_and_character(pos, &source_line, &source_character)
        let gen source_map_generator as ref[SourceMapGenerator]
        let w this.the_writer()
        gen.add_source_mapping(w.get_line(), w.get_column(), source_map_source_index, source_line, source_character)
    }

    procedure emit_source_pos(mutable this, mutable source: ref[SourceFileInfo]?, pos: int)
    {
        if source <> source_map_source
        {
            let saved_source_map_source source_map_source
            let saved_source_map_source_index source_map_source_index
            let saved_source_map_line_char_cache source_map_line_char_cache
            if source <> null
                this.set_source_map_source(source as ref[SourceFileInfo])
            this.emit_pos(pos)
            set this.source_map_source: saved_source_map_source
            set this.source_map_source_index: saved_source_map_source_index
            set this.source_map_line_char_cache: saved_source_map_line_char_cache
            return
        }
        this.emit_pos(pos)
    }

    procedure emit_source_maps_before_node(mutable this, node: ref[AstNode]) returns SourceMapState
    {
        if this.should_emit_source_maps(node) = false
            return SourceMapState.none()
        let emit_flags context.emit_flags(node)
        let loc context.source_map_range(node)
        if (node.kind <> KindNotEmittedStatement) and ((emit_flags & EFNoLeadingSourceMap) = 0) and (current_source_file <> null) and (Printer.position_is_synthesized(loc.pos) = false)
            this.emit_source_pos(source_map_source, Scanner.skip_trivia(this.file_text(), loc.pos))
        if (emit_flags & EFNoNestedSourceMaps) <> 0
            set this.source_maps_disabled: true
        SourceMapState(true, emit_flags, loc, false)
    }

    procedure emit_source_maps_after_node(mutable this, node: ref[AstNode], previous_state: SourceMapState)
    {
        if previous_state.present = false
            return
        let emit_flags previous_state.emit_flags
        let loc previous_state.source_map_range
        if (emit_flags & EFNoNestedSourceMaps) <> 0
            set this.source_maps_disabled: false
        if (node.kind <> KindNotEmittedStatement) and ((emit_flags & EFNoTrailingSourceMap) = 0) and (Printer.position_is_synthesized(loc.end) = false)
            this.emit_source_pos(source_map_source, loc.end)
    }

    procedure emit_source_maps_before_token(mutable this, token: int, pos_in: int, context_node: ref[AstNode], flags: int) returns SourceMapState
    {
        if this.should_emit_token_source_maps(token, pos_in, context_node, flags) = false
            return SourceMapState.none()
        let emit_flags context.emit_flags(context_node)
        var loc TextRange.undefined_range()
        let has_loc context.token_source_map_range(context_node, token, &loc)
        var pos pos_in
        if has_loc
            set pos: loc.pos
        if (pos >= 0) and (current_source_file <> null)
            set pos: Scanner.skip_trivia(this.file_text(), pos)
        if ((emit_flags & EFNoTokenLeadingSourceMaps) = 0) and (pos >= 0)
            this.emit_source_pos(source_map_source, pos)
        SourceMapState(true, emit_flags, loc, has_loc)
    }

    procedure emit_source_maps_after_token(mutable this, token: int, pos_in: int, context_node: ref[AstNode], previous_state: SourceMapState)
    {
        if previous_state.present = false
            return
        let emit_flags previous_state.emit_flags
        let loc previous_state.source_map_range
        if (emit_flags & EFNoTokenTrailingSourceMaps) = 0
        {
            var pos pos_in
            if previous_state.has_token_source_map_range
                set pos: loc.end
            if pos >= 0
                this.emit_source_pos(source_map_source, pos)
        }
    }

    ; ── name generation ──

    function should_reuse_temp_variable_scope(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        (context.emit_flags(node as ref[AstNode]) & EFReuseTempVariableScope) <> 0
    }

    procedure push_name_generation_scope(mutable this, node: ref[AstNode]?)
        name_generator.push_scope(this.should_reuse_temp_variable_scope(node))

    procedure pop_name_generation_scope(mutable this, node: ref[AstNode]?)
        name_generator.pop_scope(this.should_reuse_temp_variable_scope(node))

    procedure generate_all_names(mutable this, nodes: ref[Array[ref[AstNode]?]]?)
    {
        if nodes = null
            return
        let list nodes as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.generate_names(list[i as size_t])
            set i: i + 1
        }
    }

    function import_attributes_elements_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when ia: ImportAttributes
                return ia.attributes
        null
    }

    ; core.ComputeECMALineStarts: the ECMAScript line terminators (CR LF, CR,
    ; LF, U+2028, U+2029), the start of every line and of the trailing one.
    function compute_ecma_line_starts(host: ref[Page], text: Slice[char]) returns ref[Array[int]]
    {
        let result &Array[int]^host()
        let n text.length as int
        var pos 0
        var line_start 0
        while pos < n
        {
            let b text[pos as size_t] as int
            if b < 128
            {
                set pos: pos + 1
                if b = 13
                {
                    if (pos < n) and ((text[pos as size_t] as int) = 10)
                        set pos: pos + 1
                    result.add(line_start)
                    set line_start: pos
                }
                else
                {
                    if b = 10
                    {
                        result.add(line_start)
                        set line_start: pos
                    }
                }
            }
            else
            {
                let size Scanner.utf8_size_in(text, n, pos)
                let ch Scanner.utf8_decode_in(text, n, pos)
                set pos: pos + size
                if (ch = 8232) or (ch = 8233)
                {
                    result.add(line_start)
                    set line_start: pos
                }
            }
        }
        result.add(line_start)
        result
    }

    ; the four child accessors the walk needs that ast.scaly does not export
    function case_block_clauses_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when cb: CaseBlock
                return cb.elements
        null
    }

    function catch_variable_declaration_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when cc: CatchClause
                return cc.variable_declaration
        null
    }

    function catch_block_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when cc: CatchClause
                return cc.block
        null
    }

    function declaration_list_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when vs: VariableStatement
                return vs.declaration_list
        null
    }

    function declarations_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when vl: VariableDeclarationList
                return vl.declarations
        null
    }

    procedure generate_names(mutable this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let k n.kind
        if (k = KindBlock) or (k = KindCaseClause) or (k = KindDefaultClause)
        {
            this.generate_all_names(AstNode.statements_of(n))
            return
        }
        if (k = KindLabeledStatement) or (k = KindWithStatement) or (k = KindDoStatement) or (k = KindWhileStatement)
        {
            this.generate_names(AstNode.statement_of(n))
            return
        }
        if k = KindIfStatement
        {
            this.generate_names(AstNode.then_statement_of(n))
            this.generate_names(AstNode.else_statement_of(n))
            return
        }
        if (k = KindForStatement) or (k = KindForOfStatement) or (k = KindForInStatement)
        {
            this.generate_names(AstNode.initializer_of(n))
            this.generate_names(AstNode.statement_of(n))
            return
        }
        if k = KindSwitchStatement
        {
            this.generate_names(AstNode.case_block_of(n))
            return
        }
        if k = KindCaseBlock
        {
            this.generate_all_names(Printer.case_block_clauses_of(n))
            return
        }
        if k = KindTryStatement
        {
            this.generate_names(AstNode.try_block_of(n))
            this.generate_names(AstNode.catch_clause_of(n))
            this.generate_names(AstNode.finally_block_of(n))
            return
        }
        if k = KindCatchClause
        {
            this.generate_names(Printer.catch_variable_declaration_of(n))
            this.generate_names(Printer.catch_block_of(n))
            return
        }
        if k = KindVariableStatement
        {
            this.generate_names(Printer.declaration_list_of(n))
            return
        }
        if k = KindVariableDeclarationList
        {
            this.generate_all_names(Printer.declarations_of(n))
            return
        }
        if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindClassDeclaration)
        {
            this.generate_name_if_needed(Printer.declaration_name_of(n))
            return
        }
        if k = KindFunctionDeclaration
        {
            this.generate_name_if_needed(Printer.declaration_name_of(n))
            if this.should_reuse_temp_variable_scope(n)
            {
                this.generate_all_names(AstNode.parameters_of(n))
                this.generate_names(AstNode.body_of(n))
            }
            return
        }
        if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern)
        {
            this.generate_all_names(AstNode.elements_of(n))
            return
        }
        if (k = KindImportDeclaration) or (k = KindJSImportDeclaration)
        {
            this.generate_names(AstNode.import_clause_of(n))
            return
        }
        if k = KindImportClause
        {
            this.generate_name_if_needed(Printer.declaration_name_of(n))
            this.generate_names(AstNode.named_bindings_of(n))
            return
        }
        if (k = KindNamespaceImport) or (k = KindNamespaceExport)
        {
            this.generate_name_if_needed(Printer.declaration_name_of(n))
            return
        }
        if k = KindNamedImports
        {
            this.generate_all_names(AstNode.elements_of(n))
            return
        }
        if k = KindImportSpecifier
        {
            let property_name AstNode.property_name_of(n)
            if property_name <> null
                this.generate_name_if_needed(property_name)
            else
                this.generate_name_if_needed(Printer.declaration_name_of(n))
        }
    }

    procedure generate_all_member_names(mutable this, nodes: ref[Array[ref[AstNode]?]]?)
    {
        if nodes = null
            return
        let list nodes as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.generate_member_names(list[i as size_t])
            set i: i + 1
        }
    }

    procedure generate_member_names(mutable this, node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        let k n.kind
        if (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment) or (k = KindPropertyDeclaration) or (k = KindPropertySignature) or (k = KindMethodDeclaration) or (k = KindMethodSignature) or (k = KindGetAccessor) or (k = KindSetAccessor)
            this.generate_name_if_needed(Printer.declaration_name_of(n))
    }

    procedure generate_name_if_needed(mutable this, name: ref[AstNode]?)
    {
        if name = null
            return
        let n name as ref[AstNode]
        if Printer.is_member_name_kind(n.kind)
        {
            this.generate_name(n)
            return
        }
        if AstNode.is_binding_pattern(n)
            this.generate_names(n)
    }

    ; the text of a generated identifier or private identifier, computed for its side effect
    procedure generate_name(mutable this, name: ref[AstNode])
        name_generator.generate_name(name)

    ; whether a name is unique globally or within the current file
    procedure is_file_level_unique_name_in_current_file(mutable this, name: Slice[char], private_name: bool) returns bool
    {
        if current_source_file = null
            return true
        ; IsFileLevelUniqueName(file, name, hasGlobalName)
        if this.has_global_name(name)
            return false
        (current_source_file as ref[SourceFileInfo]).has_identifier(name) = false
    }

    ; PrintHandlers.HasGlobalName: nil until the emitter installs the checker's
    ; answer, and a nil callback means "no global check" (§3.18).
    function has_global_name(this, name: Slice[char]) returns bool
        false

    procedure make_file_level_optimistic_unique_name(mutable this, name: Slice[char]) returns Slice[char]
        name_generator.make_file_level_optimistic_unique_name(name)

    ; ── the six PrintHandlers hooks (no handler installed yet) ──

    procedure on_before_emit_node(this, node: ref[AstNode]?)
    {
    }

    procedure on_after_emit_node(this, node: ref[AstNode]?)
    {
    }

    procedure on_before_emit_node_list(this, nodes: ref[Array[ref[AstNode]?]]?)
    {
    }

    procedure on_after_emit_node_list(this, nodes: ref[Array[ref[AstNode]?]]?)
    {
    }

    procedure on_before_emit_token(this, node: ref[AstNode]?)
    {
    }

    procedure on_after_emit_token(this, node: ref[AstNode]?)
    {
    }

    ; ── scoped operations ──

    procedure enter_node(mutable this, node: ref[AstNode]) returns PrinterState
    {
        this.on_before_emit_node(node)
        let comment this.emit_comments_before_node(node)
        let source_map this.emit_source_maps_before_node(node)
        PrinterState(comment, source_map)
    }

    procedure exit_node(mutable this, node: ref[AstNode], previous_state: PrinterState)
    {
        this.emit_source_maps_after_node(node, previous_state.source_map)
        this.emit_comments_after_node(node, previous_state.comment)
        this.on_after_emit_node(node)
    }

    procedure enter_token_node(mutable this, node: ref[AstNode], flags: int) returns PrinterState
    {
        this.on_before_emit_token(node)
        var comment CommentState.none()
        var source_map SourceMapState.none()
        if (flags & TefNoComments) = 0
            set comment: this.emit_comments_before_node(node)
        if (flags & TefNoSourceMaps) = 0
            set source_map: this.emit_source_maps_before_node(node)
        PrinterState(comment, source_map)
    }

    procedure exit_token_node(mutable this, node: ref[AstNode], previous_state: PrinterState)
    {
        this.emit_source_maps_after_node(node, previous_state.source_map)
        this.emit_comments_after_node(node, previous_state.comment)
        this.on_after_emit_token(node)
    }

    ; `pos` is in/out (the reference returns the pair)
    procedure enter_token(mutable this, token: int, mutable pos: ref[int], context_node: ref[AstNode], flags: int) returns PrinterState
    {
        let comment this.emit_comments_before_token(token, pos, context_node, flags)
        let source_map this.emit_source_maps_before_token(token, pos, context_node, flags)
        PrinterState(comment, source_map)
    }

    procedure exit_token(mutable this, token: int, pos: int, context_node: ref[AstNode], previous_state: PrinterState)
    {
        this.emit_source_maps_after_token(token, pos, context_node, previous_state.source_map)
        this.emit_comments_after_token(token, pos, context_node, previous_state.comment)
    }


    ; ═══ printer.go (slice 234): signature elements, type members, types, expressions ═══

    ; ── Node.Name() and Node.Modifiers(), COMPLETE (ast.scaly's `name_of` and
    ; `modifiers_of` carry only the arms the checker asked for) ──

    function declaration_name_of(n: ref[AstNode]?) returns ref[AstNode]?
    {
        if n = null
            return null
        choose (n as ref[AstNode]).data
            when d: VariableDeclaration
                return d.name
            when d: Parameter
                return d.name
            when d: PropertyDeclaration
                return d.name
            when d: PropertySignature
                return d.name
            when d: PropertyAssignment
                return d.name
            when d: ShorthandPropertyAssignment
                return d.name
            when d: FunctionDeclaration
                return d.name
            when d: FunctionExpression
                return d.name
            when d: MethodDeclaration
                return d.name
            when d: MethodSignature
                return d.name
            when d: GetAccessorDeclaration
                return d.name
            when d: SetAccessorDeclaration
                return d.name
            when d: ClassDeclaration
                return d.name
            when d: ClassExpression
                return d.name
            when d: InterfaceDeclaration
                return d.name
            when d: EnumDeclaration
                return d.name
            when d: EnumMember
                return d.name
            when d: ModuleDeclaration
                return d.name
            when d: TypeParameter
                return d.name
            when d: JSTypeAliasDeclaration
                return d.name
            when d: TypeAliasDeclaration
                return d.name
            when d: BindingElement
                return d.name
            when d: ImportClause
                return d.name
            when d: NamespaceImport
                return d.inner
            when d: NamespaceExport
                return d.inner
            when d: ImportSpecifier
                return d.name
            when d: ExportSpecifier
                return d.name
            when d: ImportEqualsDeclaration
                return d.name
            when d: NamespaceExportDeclaration
                return d.name
            when d: ImportAttribute
                return d.name
            when d: JsxAttribute
                return d.name
            when d: JsxNamespacedName
                return d.name
            when d: MetaProperty
                return d.name
            when d: NamedTupleMember
                return d.name
            when d: PropertyAccessExpression
                return d.name
        null
    }

    function modifier_list_of(n: ref[AstNode]?) returns ref[Array[ref[AstNode]?]]?
    {
        if n = null
            return null
        choose (n as ref[AstNode]).data
            when d: FunctionDeclaration
                return d.modifiers
            when d: FunctionExpression
                return d.modifiers
            when d: ArrowFunction
                return d.modifiers
            when d: MethodDeclaration
                return d.modifiers
            when d: MethodSignature
                return d.modifiers
            when d: ConstructorDeclaration
                return d.modifiers
            when d: GetAccessorDeclaration
                return d.modifiers
            when d: SetAccessorDeclaration
                return d.modifiers
            when d: PropertyDeclaration
                return d.modifiers
            when d: PropertySignature
                return d.modifiers
            when d: PropertyAssignment
                return d.modifiers
            when d: ShorthandPropertyAssignment
                return d.modifiers
            when d: IndexSignatureDeclaration
                return d.modifiers
            when d: ClassStaticBlockDeclaration
                return d.modifiers
            when d: ClassDeclaration
                return d.modifiers
            when d: ClassExpression
                return d.modifiers
            when d: InterfaceDeclaration
                return d.modifiers
            when d: EnumDeclaration
                return d.modifiers
            when d: ModuleDeclaration
                return d.modifiers
            when d: JSTypeAliasDeclaration
                return d.modifiers
            when d: TypeAliasDeclaration
                return d.modifiers
            when d: TypeParameter
                return d.modifiers
            when d: Parameter
                return d.modifiers
            when d: ConstructorType
                return d.modifiers
            when d: VariableStatement
                return d.modifiers
            when d: ImportDeclaration
                return d.modifiers
            when d: ImportEqualsDeclaration
                return d.modifiers
            when d: ExportDeclaration
                return d.modifiers
            when d: ExportAssignment
                return d.modifiers
            when d: NamespaceExportDeclaration
                return d.modifiers
            when d: BinaryExpression
                return d.modifiers
        null
    }

    ; FunctionLikeData().Type
    function return_type_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when d: FunctionDeclaration
                return d.type_node
            when d: FunctionExpression
                return d.type_node
            when d: ArrowFunction
                return d.type_node
            when d: MethodDeclaration
                return d.type_node
            when d: MethodSignature
                return d.type_node
            when d: ConstructorDeclaration
                return d.type_node
            when d: GetAccessorDeclaration
                return d.type_node
            when d: SetAccessorDeclaration
                return d.type_node
            when d: CallSignature
                return d.type_node
            when d: ConstructSignature
                return d.type_node
            when d: IndexSignatureDeclaration
                return d.type_node
            when d: FunctionType
                return d.type_node
            when d: ConstructorType
                return d.type_node
        null
    }

    function wrapped_inner_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when d: Decorator
                return d.inner
            when d: PartiallyEmittedExpression
                return d.inner
            when d: JSDocNullableType
                return d.inner
            when d: JSDocNonNullableType
                return d.inner
            when d: JSDocOptionalType
                return d.inner
            when d: JSDocVariadicType
                return d.inner
        null
    }

    function template_span_literal_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when d: TemplateSpan
                return d.literal
            when d: TemplateLiteralTypeSpan
                return d.literal
        null
    }

    function prefix_unary_operator_of(n: ref[AstNode]) returns int
    {
        choose n.data
            when d: PrefixUnaryExpression
                return d.operator_kind
        KindUnknown
    }

    function static_block_body_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when d: ClassStaticBlockDeclaration
                return d.body
        null
    }

    function is_literal_kind(k: int) returns bool
        (k >= KindFirstLiteralToken) and (k <= KindLastLiteralToken)

    ; ast.GetLeftmostExpression, with the PartiallyEmittedExpression arm the
    ; checker's twin lacks (§3.5jh) — the eraser's assertions become one, and
    ; an expression statement starting with `({...} as T)` must keep its parens
    function get_leftmost_expression(node_in: ref[AstNode], stop_at_call_expressions: bool) returns ref[AstNode]
    {
        var node node_in
        while true
        {
            let k node.kind
            if k = KindPostfixUnaryExpression
            {
                set node: AstNode.postfix_unary_operand_of(node) as ref[AstNode]
                continue
            }
            if k = KindBinaryExpression
            {
                set node: AstNode.binary_left_of(node) as ref[AstNode]
                continue
            }
            if k = KindConditionalExpression
            {
                set node: AstNode.conditional_condition_of(node) as ref[AstNode]
                continue
            }
            if k = KindTaggedTemplateExpression
            {
                set node: AstNode.tagged_template_tag_of(node) as ref[AstNode]
                continue
            }
            if k = KindCallExpression
            {
                if stop_at_call_expressions
                    return node
                set node: AstNode.expression_of(node) as ref[AstNode]
                continue
            }
            if (k = KindAsExpression) or (k = KindElementAccessExpression) or (k = KindNonNullExpression) or (k = KindSatisfiesExpression)
            {
                set node: AstNode.expression_of(node) as ref[AstNode]
                continue
            }
            if k = KindPropertyAccessExpression
            {
                set node: AstNode.property_access_expression_of(node) as ref[AstNode]
                continue
            }
            if k = KindPartiallyEmittedExpression
            {
                set node: Printer.wrapped_inner_of(node) as ref[AstNode]
                continue
            }
            return node
        }
        node
    }

    procedure greatest_end_list(mutable this, end: int, list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return end
        var pos 0 - 1
        var list_end 0 - 1
        this.list_range(list, &pos, &list_end)
        if end < list_end
            return list_end
        end
    }

    function slice_contains_byte(s: Slice[char], b: int) returns bool
    {
        var i 0
        while i < (s.length as int)
        {
            if (s[i as size_t] as int) = b
                return true
            set i: i + 1
        }
        false
    }

    ; ── ast/precedence.go ──

    function get_operator(expression: ref[AstNode]) returns int
    {
        let k expression.kind
        if k = KindBinaryExpression
            return AstNode.kind_of(AstNode.binary_operator_token_of(expression))
        if k = KindPrefixUnaryExpression
            return Printer.prefix_unary_operator_of(expression)
        if k = KindPostfixUnaryExpression
            return AstNode.postfix_unary_operator_of(expression)
        k
    }

    function get_expression_precedence(expression: ref[AstNode]) returns int
    {
        let op Printer.get_operator(expression)
        var new_without_arguments false
        var optional_chain false
        if (expression.kind = KindNewExpression) and (AstNode.call_arguments_of(expression) = null)
            set new_without_arguments: true
        else
        {
            if Binder.is_optional_chain(expression)
                set optional_chain: true
        }
        Printer.get_operator_precedence(expression.kind, op, new_without_arguments, optional_chain)
    }

    function get_operator_precedence(node_kind: int, operator_kind: int, new_without_arguments: bool, optional_chain: bool) returns int
    {
        let k node_kind
        if k = KindSpreadElement
            return OperatorPrecedenceSpread
        if k = KindYieldExpression
            return OperatorPrecedenceYield
        if k = KindArrowFunction
            return OperatorPrecedenceAssignment
        if k = KindConditionalExpression
            return OperatorPrecedenceConditional
        if k = KindBinaryExpression
        {
            let o operator_kind
            if o = KindCommaToken
                return OperatorPrecedenceComma
            if (o = KindEqualsToken) or (o = KindPlusEqualsToken) or (o = KindMinusEqualsToken) or (o = KindAsteriskAsteriskEqualsToken) or (o = KindAsteriskEqualsToken) or (o = KindSlashEqualsToken) or (o = KindPercentEqualsToken) or (o = KindLessThanLessThanEqualsToken) or (o = KindGreaterThanGreaterThanEqualsToken) or (o = KindGreaterThanGreaterThanGreaterThanEqualsToken) or (o = KindAmpersandEqualsToken) or (o = KindCaretEqualsToken) or (o = KindBarEqualsToken) or (o = KindBarBarEqualsToken) or (o = KindAmpersandAmpersandEqualsToken) or (o = KindQuestionQuestionEqualsToken)
                return OperatorPrecedenceAssignment
            return Parser.get_binary_operator_precedence(o)
        }
        if (k = KindTypeAssertionExpression) or (k = KindNonNullExpression) or (k = KindPrefixUnaryExpression) or (k = KindTypeOfExpression) or (k = KindVoidExpression) or (k = KindDeleteExpression) or (k = KindAwaitExpression)
            return OperatorPrecedenceUnary
        if k = KindPostfixUnaryExpression
            return OperatorPrecedenceUpdate
        if (k = KindPropertyAccessExpression) or (k = KindElementAccessExpression) or (k = KindCallExpression)
        {
            if optional_chain
                return OperatorPrecedenceOptionalChain
            return OperatorPrecedenceMember
        }
        if k = KindNewExpression
        {
            if new_without_arguments
                return OperatorPrecedenceLeftHandSide
            return OperatorPrecedenceMember
        }
        if (k = KindTaggedTemplateExpression) or (k = KindMetaProperty) or (k = KindExpressionWithTypeArguments)
            return OperatorPrecedenceMember
        if (k = KindAsExpression) or (k = KindSatisfiesExpression)
            return OperatorPrecedenceRelational
        if (k = KindThisKeyword) or (k = KindSuperKeyword) or (k = KindImportKeyword) or (k = KindIdentifier) or (k = KindPrivateIdentifier) or (k = KindNullKeyword) or (k = KindTrueKeyword) or (k = KindFalseKeyword) or (k = KindNumericLiteral) or (k = KindBigIntLiteral) or (k = KindStringLiteral) or (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression) or (k = KindFunctionExpression) or (k = KindClassExpression) or (k = KindRegularExpressionLiteral) or (k = KindNoSubstitutionTemplateLiteral) or (k = KindTemplateExpression) or (k = KindOmittedExpression) or (k = KindJsxElement) or (k = KindJsxSelfClosingElement) or (k = KindJsxFragment) or (k = KindMissingDeclaration)
            return OperatorPrecedencePrimary
        if k = KindParenthesizedExpression
            return OperatorPrecedenceParentheses
        OperatorPrecedenceInvalid
    }

    procedure get_type_node_precedence(mutable this, n: ref[AstNode]) returns int
    {
        let k n.kind
        if k = KindConditionalType
            return TypePrecedenceConditional
        if (k = KindJSDocOptionalType) or (k = KindJSDocVariadicType)
            return TypePrecedenceJSDoc
        if (k = KindFunctionType) or (k = KindConstructorType)
            return TypePrecedenceFunction
        if k = KindUnionType
            return TypePrecedenceUnion
        if k = KindIntersectionType
            return TypePrecedenceIntersection
        if k = KindTypeOperator
            return TypePrecedenceTypeOperator
        if k = KindInferType
        {
            if AstNode.type_parameter_constraint_of(AstNode.infer_type_parameter_of(n)) <> null
                return TypePrecedenceFunction
            return TypePrecedenceTypeOperator
        }
        if (k = KindIndexedAccessType) or (k = KindArrayType) or (k = KindOptionalType)
            return TypePrecedencePostfix
        if k = KindTypeQuery
            return TypePrecedenceTypeOperator
        if (k = KindAnyKeyword) or (k = KindUnknownKeyword) or (k = KindStringKeyword) or (k = KindNumberKeyword) or (k = KindBigIntKeyword) or (k = KindSymbolKeyword) or (k = KindBooleanKeyword) or (k = KindUndefinedKeyword) or (k = KindNeverKeyword) or (k = KindObjectKeyword) or (k = KindIntrinsicKeyword) or (k = KindVoidKeyword) or (k = KindJSDocAllType) or (k = KindJSDocNullableType) or (k = KindJSDocNonNullableType) or (k = KindLiteralType) or (k = KindTypePredicate) or (k = KindTypeReference) or (k = KindTypeLiteral) or (k = KindTupleType) or (k = KindRestType) or (k = KindParenthesizedType) or (k = KindThisType) or (k = KindMappedType) or (k = KindNamedTupleMember) or (k = KindTemplateLiteralType) or (k = KindImportType) or (k = KindPropertyAccessExpression) or (k = KindExpressionWithTypeArguments)
            return TypePrecedenceNonArray
        ; the reference PANICS ("unhandled TypeNode")
        this.record_unported("type-node-precedence-kind", k)
        TypePrecedenceNonArray
    }

    ; ── signature elements ──

    procedure emit_modifier_list(mutable this, parent_node: ref[AstNode], mutable modifiers: ref[Array[ref[AstNode]?]]?, allow_decorators: bool) returns int
    {
        if modifiers = null
            return parent_node.pos
        let list modifiers as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        if n = 0
            return parent_node.pos
        var all_modifiers true
        var all_decorators true
        var i 0
        while i < n
        {
            if AstNode.is_decorator(list[i as size_t])
                set all_modifiers: false
            else
                set all_decorators: false
            set i: i + 1
        }
        if all_modifiers
            this.emit_list(EmitTagKeywordNode, parent_node, modifiers, LFModifiers)
        else
        {
            if all_decorators
            {
                if allow_decorators = false
                    return parent_node.pos
                this.emit_list(EmitTagModifierLike, parent_node, modifiers, LFDecorators)
            }
            else
            {
                this.on_before_emit_node_list(modifiers)
                ; contiguous chunks of `Modifier` or `Decorator`, each formatted its own way
                ; (0 none, 1 modifiers, 2 decorators)
                var last_mode 0
                var mode 0
                var start 0
                var pos 0
                var list_pos 0 - 1
                var list_end 0 - 1
                this.list_range(modifiers, &list_pos, &list_end)
                while start < n
                {
                    while pos < n
                    {
                        if AstNode.is_decorator(list[pos as size_t])
                            set mode: 2
                        else
                            set mode: 1
                        if last_mode = 0
                            set last_mode: mode
                        else
                        {
                            if mode <> last_mode
                                break
                        }
                        set pos: pos + 1
                    }
                    var r_pos 0 - 1
                    var r_end 0 - 1
                    if start = 0
                        set r_pos: list_pos
                    if pos = n - 1
                        set r_end: list_end
                    if allow_decorators or (last_mode = 1)
                    {
                        var format LFDecorators
                        if last_mode = 1
                            set format: LFModifiers
                        this.emit_list_items(EmitTagModifierLike, parent_node, list, start, pos, format, false, TextRange(r_pos, r_end))
                    }
                    set start: pos
                    set last_mode: mode
                    set pos: pos + 1
                }
                this.on_after_emit_node_list(modifiers)
            }
        }
        Printer.greatest_end_node(parent_node.pos, list[(n - 1) as size_t])
    }

    procedure emit_type_parameter(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        let constraint AstNode.type_parameter_constraint_of(node)
        if constraint <> null
        {
            this.write_space()
            this.write_keyword("extends")
            this.write_space()
            this.emit_type_node_outside_extends(constraint as ref[AstNode])
        }
        let default_type AstNode.type_parameter_default_of(node)
        if default_type <> null
        {
            this.write_space()
            this.write_operator("=")
            this.write_space()
            this.emit_type_node_outside_extends(default_type as ref[AstNode])
        }
        this.exit_node(node, state)
    }

    ; QuickInfo may put type ARGUMENTS in a type parameter list
    procedure emit_type_parameter_declaration_node(mutable this, mutable node: ref[AstNode])
    {
        if node.kind = KindTypeParameter
            this.emit_type_parameter(node)
        else
            this.emit_type_argument(node)
    }

    procedure emit_parameter_name(mutable this, mutable node: ref[AstNode]?)
    {
        let saved_write_kind write_kind
        set this.write_kind: WriteKindParameter
        this.emit_binding_name(node)
        set this.write_kind: saved_write_kind
    }

    procedure emit_parameter(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), true)
        this.emit_token_node(AstNode.dot_dot_dot_token_of(node))
        this.emit_parameter_name(Printer.declaration_name_of(node))
        this.emit_token_node(AstNode.parameter_question_token_of(node))
        this.emit_type_annotation(AstNode.type_of(node))
        ; the parser can make a parameter with JUST an initializer: the comment
        ; position falls back to any present child
        var pos node.pos
        set pos: (Printer.greatest_end_node(pos, AstNode.type_of(node))) as i32
        set pos: (Printer.greatest_end_node(pos, AstNode.parameter_question_token_of(node))) as i32
        set pos: (Printer.greatest_end_node(pos, Printer.declaration_name_of(node))) as i32
        set pos: (this.greatest_end_list(pos, Printer.modifier_list_of(node))) as i32
        this.emit_initializer(AstNode.initializer_of(node), pos, node)
        this.exit_node(node, state)
    }

    procedure emit_parameter_declaration_node(mutable this, mutable node: ref[AstNode])
        this.emit_parameter(node)

    procedure emit_decorator(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("@")
        this.emit_expression(Printer.wrapped_inner_of(node) as ref[AstNode], OperatorPrecedenceLeftHandSide)
        this.exit_node(node, state)
    }

    procedure emit_modifier_like(mutable this, mutable node: ref[AstNode])
    {
        if AstNode.is_decorator(node)
        {
            this.emit_decorator(node)
            return
        }
        if Printer.is_modifier_kind(node.kind)
        {
            this.emit_keyword_node(node)
            return
        }
        this.record_unported("emit-modifier-like-kind", node.kind)
    }

    procedure emit_type_parameters(mutable this, parent_node: ref[AstNode], mutable nodes: ref[Array[ref[AstNode]?]]?)
    {
        if nodes = null
            return
        var format LFTypeParameters
        if parent_node.kind = KindArrowFunction
            set format: format | LFAllowTrailingComma
        this.emit_list(EmitTagTypeParameterDeclarationNode, parent_node, nodes, format)
    }

    procedure emit_type_annotation(mutable this, mutable node: ref[AstNode]?)
    {
        if node = null
            return
        this.write_punctuation(":")
        this.write_space()
        this.emit_type_node_outside_extends(node as ref[AstNode])
    }

    procedure emit_initializer(mutable this, mutable node: ref[AstNode]?, equal_token_pos: int, context_node: ref[AstNode])
    {
        if node = null
            return
        this.write_space()
        this.emit_token(KindEqualsToken, equal_token_pos, WriteKindOperator, context_node)
        this.write_space()
        this.emit_expression(node as ref[AstNode], OperatorPrecedenceDisallowComma)
    }

    procedure emit_parameters(mutable this, parent_node: ref[AstNode], mutable parameters: ref[Array[ref[AstNode]?]]?)
    {
        this.generate_all_names(parameters)
        this.emit_list(EmitTagParameterDeclarationNode, parent_node, parameters, LFParameters)
    }

    ; only an arrow function with a single plain identifier parameter
    procedure can_emit_simple_arrow_head(this, parent_node: ref[AstNode], parameters: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if parent_node.kind <> KindArrowFunction
            return false
        if parameters = null
            return false
        let list parameters as ref[Array[ref[AstNode]?]]
        if (list.get_length() as int) <> 1
            return false
        let parameter list[0] as ref[AstNode]
        if parameter.pos <> parent_node.pos
            return false
        if AstNode.type_parameters_of(parent_node) <> null
            return false
        if Printer.return_type_of(parent_node) <> null
            return false
        let parent_modifiers Printer.modifier_list_of(parent_node)
        if parent_modifiers <> null
        {
            if ((parent_modifiers as ref[Array[ref[AstNode]?]]).get_length() as int) > 0
                return false
        }
        if context.the_factory().list_has_trailing_comma(parameters)
            return false
        if Printer.modifier_list_of(parameter) <> null
            return false
        if AstNode.dot_dot_dot_token_of(parameter) <> null
            return false
        if AstNode.parameter_question_token_of(parameter) <> null
            return false
        if AstNode.type_of(parameter) <> null
            return false
        if AstNode.initializer_of(parameter) <> null
            return false
        AstNode.kind_of(Printer.declaration_name_of(parameter)) = KindIdentifier
    }

    procedure emit_parameters_for_arrow(mutable this, parent_node: ref[AstNode], mutable parameters: ref[Array[ref[AstNode]?]]?)
    {
        if this.can_emit_simple_arrow_head(parent_node, parameters)
        {
            this.generate_all_names(parameters)
            this.emit_list(EmitTagParameterDeclarationNode, parent_node, parameters, LFSingleArrowParameter)
            return
        }
        this.emit_parameters(parent_node, parameters)
    }

    procedure emit_parameters_for_index_signature(mutable this, parent_node: ref[AstNode], mutable parameters: ref[Array[ref[AstNode]?]]?)
    {
        this.generate_all_names(parameters)
        this.emit_list(EmitTagParameterDeclarationNode, parent_node, parameters, LFIndexSignatureParameters)
    }

    procedure emit_signature(mutable this, mutable node: ref[AstNode])
    {
        this.emit_type_parameters(node, AstNode.type_parameters_of(node))
        this.emit_parameters(node, AstNode.parameters_of(node))
        this.emit_type_annotation(Printer.return_type_of(node))
    }

    procedure emit_function_body(mutable this, mutable body: ref[AstNode])
    {
        context.add_emit_flags(body, EFNoSourceMap)
        ; only the notification hooks for the body block, not the comment pipeline
        this.on_before_emit_node(body)
        this.generate_names(body)
        this.write_punctuation("{")
        this.increase_indent()
        let statements AstNode.statements_of(body)
        var sp 0 - 1
        var se 0 - 1
        this.list_range(statements, &sp, &se)
        let detached_state this.emit_detached_comments_before_statement_list(body, TextRange(sp, se))
        let statement_offset this.emit_prologue_directives(statements)
        let w this.the_writer()
        let pos w.get_text_pos()
        this.emit_helpers(body)
        let pos_after w.get_text_pos()
        if this.should_emit_block_function_body_on_single_line(body) and (statement_offset = 0) and (pos = pos_after)
        {
            this.decrease_indent()
            this.emit_list_range(EmitTagStatement, body, statements, LFSingleLineFunctionBodyStatements, statement_offset, 0 - 1)
            this.increase_indent()
        }
        else
            this.emit_list_range(EmitTagStatement, body, statements, LFMultiLineFunctionBodyStatements, statement_offset, 0 - 1)
        this.emit_detached_comments_after_statement_list(body, TextRange(sp, se), detached_state)
        this.decrease_indent()
        this.emit_token_ex(KindCloseBraceToken, se, WriteKindPunctuation, body, TefNoComments)
        this.on_after_emit_node(body)
    }

    procedure emit_function_body_node(mutable this, mutable node: ref[AstNode]?)
    {
        if node = null
        {
            this.write_trailing_semicolon()
            return
        }
        this.write_space()
        this.emit_function_body(node as ref[AstNode])
    }

    ; emitPrologueDirectives: the leading directives, each on its own line;
    ; answers the index of the first statement that is not one.
    procedure emit_prologue_directives(mutable this, mutable statements: ref[Array[ref[AstNode]?]]?) returns int
    {
        if statements = null
            return 0
        let list statements as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            let statement list[i as size_t]
            if EmitContext.is_prologue_directive(statement) = false
                return i
            this.write_line()
            this.emit_statement(statement as ref[AstNode])
            set i: i + 1
        }
        list.get_length() as int
    }

    ; the two scoped helpers whose text is a CALLBACK over makeUniqueName (§3.18)
    procedure helper_callback_text(mutable this, text_kind: int) returns Slice[char]
    {
        let b StringBuilder^host()
        let unique this.make_file_level_optimistic_unique_name("_superIndex")
        if text_kind = 1
        {
            b.append("\nconst ")
            b.append(unique.data, unique.length)
            b.append(" = name => super[name];")
            return Printer.slice_on(host, b.to_string())
        }
        b.append("\nconst ")
        b.append(unique.data, unique.length)
        b.append(" = (function (geti, seti) {\n")
        b.append("    const cache = Object.create(null);\n")
        b.append("    return name => cache[name] || (cache[name] = { get value() { return geti(name); }, set value(v) { seti(name, v); } });\n")
        b.append("})(name => super[name], (name, value) => super[name] = value);")
        Printer.slice_on(host, b.to_string())
    }

    procedure emit_helpers(mutable this, node: ref[AstNode]) returns bool
    {
        var helpers_emitted false
        var should_skip options.no_emit_helpers
        if current_source_file <> null
        {
            if context.has_recorded_external_helpers((current_source_file as ref[SourceFileInfo]).node)
                set should_skip: true
        }
        let hs context.get_emit_helpers(node)
        if hs = null
            return false
        let source hs as ref[Array[ref[EmitHelper]?]]
        let n source.get_length() as int
        if n = 0
            return false
        ; slices.Clone + SortStableFunc(compareEmitHelpers): an insertion sort is stable
        let helpers &Array[ref[EmitHelper]?]^host()
        var i 0
        while i < n
        {
            helpers.add(source[i as size_t])
            set i: i + 1
        }
        set i: 1
        while i < n
        {
            let current helpers[i as size_t]
            var j i - 1
            while j >= 0
            {
                let left helpers[j as size_t]
                if EmitHelper.compare(left as ref[EmitHelper], current as ref[EmitHelper]) <= 0
                    break
                helpers.put((j + 1) as size_t, left)
                set j: j - 1
            }
            helpers.put((j + 1) as size_t, current)
            set i: i + 1
        }
        set i: 0
        while i < n
        {
            let helper helpers[i as size_t] as ref[EmitHelper]
            set i: i + 1
            if (helper.scoped = false) and should_skip
                continue
            if helper.text_kind <> 0
                this.write_lines(this.helper_callback_text(helper.text_kind))
            else
                this.write_lines(helper.text)
            set helpers_emitted: true
        }
        helpers_emitted
    }

    ; ── type members ──

    procedure emit_property_signature(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.emit_property_name(Printer.declaration_name_of(node))
        this.emit_token_node(AstNode.postfix_token_of(node))
        this.emit_type_annotation(AstNode.type_of(node))
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_property_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), true)
        this.emit_property_name(Printer.declaration_name_of(node))
        this.emit_token_node(AstNode.postfix_token_of(node))
        this.emit_type_annotation(AstNode.type_of(node))
        var pos (Printer.declaration_name_of(node) as ref[AstNode]).end
        set pos: (Printer.greatest_end_node(pos, AstNode.type_of(node))) as i32
        set pos: (Printer.greatest_end_node(pos, AstNode.postfix_token_of(node))) as i32
        this.emit_initializer(AstNode.initializer_of(node), pos, node)
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_method_signature(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.emit_property_name(Printer.declaration_name_of(node))
        this.emit_token_node(AstNode.postfix_token_of(node))
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_signature(node)
        this.write_trailing_semicolon()
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_method_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), true)
        this.emit_token_node(AstNode.asterisk_token_of(node))
        this.emit_property_name(Printer.declaration_name_of(node))
        this.emit_token_node(AstNode.postfix_token_of(node))
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_signature(node)
        this.emit_function_body_node(AstNode.body_of(node))
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_class_static_block_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_keyword("static")
        this.push_name_generation_scope(node)
        this.emit_function_body_node(Printer.static_block_body_of(node))
        this.pop_name_generation_scope(node)
        this.exit_node(node, state)
    }

    procedure emit_constructor(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.write_keyword("constructor")
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_signature(node)
        this.emit_function_body_node(AstNode.body_of(node))
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_accessor_declaration(mutable this, token: int, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let pos this.emit_modifier_list(node, Printer.modifier_list_of(node), true)
        this.emit_token(token, pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_property_name(Printer.declaration_name_of(node))
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_signature(node)
        this.emit_function_body_node(AstNode.body_of(node))
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_get_accessor_declaration(mutable this, mutable node: ref[AstNode])
        this.emit_accessor_declaration(KindGetKeyword, node)

    procedure emit_set_accessor_declaration(mutable this, mutable node: ref[AstNode])
        this.emit_accessor_declaration(KindSetKeyword, node)

    procedure emit_call_signature(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_signature(node)
        this.write_trailing_semicolon()
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_construct_signature(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_keyword("new")
        this.write_space()
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_signature(node)
        this.write_trailing_semicolon()
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_index_signature(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_parameters_for_index_signature(node, AstNode.parameters_of(node))
        this.emit_type_annotation(Printer.return_type_of(node))
        this.write_trailing_semicolon()
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_class_element(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindPropertyDeclaration
        {
            this.emit_property_declaration(node)
            return
        }
        if k = KindMethodDeclaration
        {
            this.emit_method_declaration(node)
            return
        }
        if k = KindClassStaticBlockDeclaration
        {
            this.emit_class_static_block_declaration(node)
            return
        }
        if k = KindConstructor
        {
            this.emit_constructor(node)
            return
        }
        if k = KindGetAccessor
        {
            this.emit_get_accessor_declaration(node)
            return
        }
        if k = KindSetAccessor
        {
            this.emit_set_accessor_declaration(node)
            return
        }
        if k = KindIndexSignature
        {
            this.emit_index_signature(node)
            return
        }
        if k = KindSemicolonClassElement
        {
            this.emit_semicolon_class_element(node)
            return
        }
        if k = KindNotEmittedStatement
        {
            this.emit_not_emitted_statement(node)
            return
        }
        if k = KindJSTypeAliasDeclaration
        {
            this.emit_type_alias_declaration(node)
            return
        }
        this.record_unported("emit-class-element-kind", k)
    }

    procedure emit_type_element(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindPropertySignature
        {
            this.emit_property_signature(node)
            return
        }
        if k = KindMethodSignature
        {
            this.emit_method_signature(node)
            return
        }
        if k = KindCallSignature
        {
            this.emit_call_signature(node)
            return
        }
        if k = KindConstructSignature
        {
            this.emit_construct_signature(node)
            return
        }
        if k = KindGetAccessor
        {
            this.emit_get_accessor_declaration(node)
            return
        }
        if k = KindSetAccessor
        {
            this.emit_set_accessor_declaration(node)
            return
        }
        if k = KindIndexSignature
        {
            this.emit_index_signature(node)
            return
        }
        if k = KindNotEmittedTypeElement
        {
            this.emit_not_emitted_type_element(node)
            return
        }
        this.record_unported("emit-type-element-kind", k)
    }

    procedure emit_object_literal_element(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindPropertyAssignment
        {
            this.emit_property_assignment(node)
            return
        }
        if k = KindShorthandPropertyAssignment
        {
            this.emit_shorthand_property_assignment(node)
            return
        }
        if k = KindSpreadAssignment
        {
            this.emit_spread_assignment(node)
            return
        }
        if k = KindMethodDeclaration
        {
            this.emit_method_declaration(node)
            return
        }
        if k = KindGetAccessor
        {
            this.emit_get_accessor_declaration(node)
            return
        }
        if k = KindSetAccessor
        {
            this.emit_set_accessor_declaration(node)
            return
        }
        this.record_unported("emit-object-literal-element-kind", k)
    }

    ; ── types ──

    procedure emit_keyword_type_node(mutable this, node: ref[AstNode])
        this.emit_keyword_node(node)

    procedure emit_type_predicate_parameter_name(mutable this, mutable node: ref[AstNode])
    {
        if node.kind = KindIdentifier
        {
            this.emit_identifier_reference(node)
            return
        }
        if node.kind = KindThisType
        {
            this.emit_this_type(node)
            return
        }
        this.record_unported("emit-type-predicate-parameter-name-kind", node.kind)
    }

    procedure emit_type_predicate(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let asserts AstNode.type_predicate_asserts_modifier_of(node)
        if asserts <> null
        {
            this.emit_token_node(asserts)
            this.write_space()
        }
        this.emit_type_predicate_parameter_name(AstNode.type_predicate_parameter_name_of(node) as ref[AstNode])
        let t AstNode.type_of(node)
        if t <> null
        {
            this.write_space()
            this.write_keyword("is")
            this.write_space()
            this.emit_type_node_outside_extends(t as ref[AstNode])
        }
        this.exit_node(node, state)
    }

    procedure emit_type_argument(mutable this, mutable node: ref[AstNode])
        this.emit_type_node_outside_extends(node)

    procedure emit_type_arguments(mutable this, parent_node: ref[AstNode], mutable nodes: ref[Array[ref[AstNode]?]]?)
    {
        if nodes = null
            return
        this.emit_list(EmitTagTypeParameterDeclarationNode, parent_node, nodes, LFTypeArguments)
    }

    procedure emit_type_reference(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_entity_name(AstNode.type_reference_name_of(node) as ref[AstNode])
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        this.exit_node(node, state)
    }

    ; the return type of a FunctionType or ConstructorType, arrow included
    procedure emit_return_type(mutable this, mutable node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        this.write_punctuation("=>")
        this.write_space()
        var parenthesize_infer false
        if in_extends and (n.kind = KindInferType)
        {
            ; in the `extends` clause of a ConditionalType, `infer U extends V` in a
            ; return type must be parenthesized or `? W : X` parses into the return type
            if AstNode.type_parameter_constraint_of(AstNode.infer_type_parameter_of(n)) <> null
                set parenthesize_infer: true
        }
        if parenthesize_infer
            this.emit_type_node_preserving_extends(n, TypePrecedenceNonArray)
        else
            this.emit_type_node_preserving_extends(n, TypePrecedenceConditional)
    }

    procedure emit_function_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_type_parameters(node, AstNode.type_parameters_of(node))
        this.emit_parameters(node, AstNode.parameters_of(node))
        this.write_space()
        this.emit_return_type(Printer.return_type_of(node))
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_constructor_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.write_keyword("new")
        this.write_space()
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_type_parameters(node, AstNode.type_parameters_of(node))
        this.emit_parameters(node, AstNode.parameters_of(node))
        this.write_space()
        this.emit_return_type(Printer.return_type_of(node))
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_type_query(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_keyword("typeof")
        this.write_space()
        this.emit_entity_name(AstNode.type_query_expr_name_of(node) as ref[AstNode])
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        this.exit_node(node, state)
    }

    procedure emit_type_literal(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.push_name_generation_scope(node)
        let members Printer.member_list_of(node)
        this.generate_all_member_names(members)
        this.write_punctuation("{")
        var flags LFMultiLineTypeLiteralMembers
        if this.should_emit_on_single_line(node)
            set flags: LFSingleLineTypeLiteralMembers
        this.emit_list(EmitTagTypeElement, node, members, flags | LFNoSpaceIfEmpty)
        this.write_punctuation("}")
        this.pop_name_generation_scope(node)
        this.exit_node(node, state)
    }

    procedure emit_array_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_postfix_type_operand(AstNode.array_element_type_of(node) as ref[AstNode], node)
        this.write_punctuation("[")
        this.write_punctuation("]")
        this.exit_node(node, state)
    }

    ; the operand of a postfix type: a PARSED `typeof X` operand keeps its
    ; spelling (`typeof C[K]`, not `(typeof C)[K]`), a synthesized one is
    ; parenthesized as the factory would
    procedure emit_postfix_type_operand(mutable this, mutable operand: ref[AstNode], parent: ref[AstNode])
    {
        if ((parent.flags & NodeFlagsSynthesized) = 0) and (operand.kind = KindTypeQuery)
        {
            this.emit_type_node(operand, TypePrecedenceTypeOperator)
            return
        }
        this.emit_type_node(operand, TypePrecedencePostfix)
    }

    procedure emit_tuple_element_type(mutable this, mutable node: ref[AstNode])
        this.emit_type_node_outside_extends(node)

    procedure emit_tuple_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindOpenBracketToken, node.pos, WriteKindPunctuation, node)
        var flags LFMultiLineTupleTypeElements
        if this.should_emit_on_single_line(node)
            set flags: LFSingleLineTupleTypeElements
        let elements AstNode.type_list_of(node)
        this.emit_list(EmitTagTupleElementType, node, elements, flags | LFNoSpaceIfEmpty)
        var ep 0 - 1
        var ee 0 - 1
        this.list_range(elements, &ep, &ee)
        this.emit_token(KindCloseBracketToken, ee, WriteKindPunctuation, node)
        this.exit_node(node, state)
    }

    procedure emit_rest_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("...")
        this.emit_type_node_outside_extends(AstNode.rest_type_inner_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_optional_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_postfix_type_operand(AstNode.optional_type_inner_of(node) as ref[AstNode], node)
        this.write_punctuation("?")
        this.exit_node(node, state)
    }

    procedure emit_named_tuple_member(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_punctuation_node(AstNode.named_tuple_member_dotdotdot_of(node))
        let name Printer.declaration_name_of(node) as ref[AstNode]
        this.emit_identifier_name(name)
        let question AstNode.named_tuple_member_question_token_of(node)
        this.emit_punctuation_node(question)
        this.emit_token(KindColonToken, Printer.greatest_end_node(name.end, question), WriteKindPunctuation, node)
        this.write_space()
        this.emit_type_node_outside_extends(AstNode.type_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_union_type_constituent(mutable this, mutable node: ref[AstNode])
        this.emit_type_node(node, TypePrecedenceTypeOperator)

    procedure emit_union_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_list(EmitTagUnionTypeConstituent, node, AstNode.type_list_of(node), LFUnionTypeConstituents)
        this.exit_node(node, state)
    }

    procedure emit_intersection_type_constituent(mutable this, mutable node: ref[AstNode])
        this.emit_type_node(node, TypePrecedenceTypeOperator)

    procedure emit_intersection_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_list(EmitTagIntersectionTypeConstituent, node, AstNode.type_list_of(node), LFIntersectionTypeConstituents)
        this.exit_node(node, state)
    }

    procedure emit_conditional_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_type_node(AstNode.conditional_type_check_of(node) as ref[AstNode], TypePrecedenceUnion)
        this.write_space()
        this.write_keyword("extends")
        this.write_space()
        this.emit_type_node_in_extends(AstNode.conditional_type_extends_of(node) as ref[AstNode])
        this.write_space()
        this.write_punctuation("?")
        this.write_space()
        this.emit_type_node_outside_extends(AstNode.conditional_type_true_of(node) as ref[AstNode])
        this.write_space()
        this.write_punctuation(":")
        this.write_space()
        this.emit_type_node_outside_extends(AstNode.conditional_type_false_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_infer_type_parameter(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        let constraint AstNode.type_parameter_constraint_of(node)
        if constraint <> null
        {
            this.write_space()
            this.write_keyword("extends")
            this.write_space()
            this.emit_type_node_in_extends(constraint as ref[AstNode])
        }
        this.exit_node(node, state)
    }

    procedure emit_infer_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_keyword("infer")
        this.write_space()
        this.emit_infer_type_parameter(AstNode.infer_type_parameter_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_parenthesized_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("(")
        this.emit_type_node_outside_extends(AstNode.parenthesized_type_inner_of(node) as ref[AstNode])
        this.write_punctuation(")")
        this.exit_node(node, state)
    }

    procedure emit_this_type(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_keyword("this")
        this.exit_node(node, state)
    }

    procedure emit_type_operator(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let op AstNode.type_operator_operator_of(node)
        this.emit_token(op, node.pos, WriteKindKeyword, node)
        this.write_space()
        var precedence TypePrecedenceTypeOperator
        if op = KindReadonlyKeyword
            set precedence: TypePrecedencePostfix
        this.emit_type_node(AstNode.type_operator_inner_of(node) as ref[AstNode], precedence)
        this.exit_node(node, state)
    }

    procedure emit_indexed_access_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_postfix_type_operand(AstNode.indexed_access_object_type_of(node) as ref[AstNode], node)
        this.write_punctuation("[")
        this.emit_type_node_outside_extends(AstNode.indexed_access_index_type_of(node) as ref[AstNode])
        this.write_punctuation("]")
        this.exit_node(node, state)
    }

    procedure emit_mapped_type_parameter(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        this.write_space()
        this.write_keyword("in")
        this.write_space()
        this.emit_type_node_outside_extends(AstNode.type_parameter_constraint_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_mapped_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let single_line this.should_emit_on_single_line(node)
        this.write_punctuation("{")
        if single_line
            this.write_space()
        else
        {
            this.write_line()
            this.increase_indent()
        }
        let readonly_token AstNode.mapped_type_readonly_token_of(node)
        if readonly_token <> null
        {
            this.emit_token_node(readonly_token)
            if (readonly_token as ref[AstNode]).kind <> KindReadonlyKeyword
                this.write_keyword("readonly")
            this.write_space()
        }
        this.write_punctuation("[")
        this.emit_mapped_type_parameter(AstNode.mapped_type_parameter_of(node) as ref[AstNode])
        let name_type AstNode.mapped_type_name_type_of(node)
        if name_type <> null
        {
            this.write_space()
            this.write_keyword("as")
            this.write_space()
            this.emit_type_node_outside_extends(name_type as ref[AstNode])
        }
        this.write_punctuation("]")
        let question_token AstNode.question_token_of(node)
        if question_token <> null
        {
            this.emit_punctuation_node(question_token)
            if (question_token as ref[AstNode]).kind <> KindQuestionToken
                this.write_punctuation("?")
        }
        this.write_punctuation(":")
        this.write_space()
        this.emit_type_node_outside_extends(AstNode.type_of(node) as ref[AstNode])
        this.write_trailing_semicolon()
        let members Printer.member_list_of(node)
        if members <> null
        {
            if ((members as ref[Array[ref[AstNode]?]]).get_length() as int) > 0
            {
                if single_line
                    this.write_space()
                else
                    this.write_line()
                this.emit_list(EmitTagTypeElement, node, members, LFPreserveLines)
            }
        }
        if single_line
            this.write_space()
        else
        {
            this.write_line()
            this.decrease_indent()
        }
        this.write_punctuation("}")
        this.exit_node(node, state)
    }

    procedure emit_literal_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_expression(AstNode.literal_type_inner_of(node) as ref[AstNode], OperatorPrecedenceComma)
        this.exit_node(node, state)
    }

    procedure emit_template_type_span(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_type_node_outside_extends(AstNode.template_literal_type_span_type_of(node) as ref[AstNode])
        this.emit_template_middle_tail(Printer.template_span_literal_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_template_type_span_node(mutable this, mutable node: ref[AstNode])
        this.emit_template_type_span(node)

    procedure emit_template_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_template_head(AstNode.template_head_of(node) as ref[AstNode])
        this.emit_list(EmitTagTemplateTypeSpanNode, node, AstNode.template_literal_type_spans_of(node), LFTemplateExpressionSpans)
        this.exit_node(node, state)
    }

    procedure emit_import_type_node_attributes(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("{")
        this.write_space()
        if AstNode.import_attributes_token_of(node) = KindAssertKeyword
            this.write_keyword("assert")
        else
            this.write_keyword("with")
        this.write_punctuation(":")
        this.write_space()
        this.emit_list(EmitTagImportAttributeNode, node, AstNode.import_attribute_list_of(node), LFImportAttributes)
        this.write_space()
        this.write_punctuation("}")
        this.exit_node(node, state)
    }

    procedure emit_import_type_node(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        if AstNode.import_type_is_type_of(node)
        {
            this.write_keyword("typeof")
            this.write_space()
        }
        this.write_keyword("import")
        this.write_punctuation("(")
        this.emit_type_node_outside_extends(AstNode.import_type_argument_of(node) as ref[AstNode])
        let attributes AstNode.import_type_attributes_of(node)
        if attributes <> null
        {
            this.write_punctuation(",")
            this.write_space()
            this.emit_import_type_node_attributes(attributes as ref[AstNode])
        }
        this.write_punctuation(")")
        let qualifier AstNode.import_type_qualifier_of(node)
        if qualifier <> null
        {
            this.write_punctuation(".")
            this.emit_entity_name(qualifier as ref[AstNode])
        }
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        this.exit_node(node, state)
    }

    ; a type node in the `extends` clause of a ConditionalType
    procedure emit_type_node_in_extends(mutable this, mutable node: ref[AstNode])
    {
        let saved_in_extends in_extends
        set this.in_extends: true
        this.emit_type_node_preserving_extends(node, TypePrecedenceConditional)
        set this.in_extends: saved_in_extends
    }

    ; a type node NOT in the `extends` clause of a ConditionalType or InferType
    procedure emit_type_node_outside_extends(mutable this, mutable node: ref[AstNode])
    {
        let saved_in_extends in_extends
        set this.in_extends: false
        this.emit_type_node_preserving_extends(node, TypePrecedenceConditional)
        set this.in_extends: saved_in_extends
    }

    procedure emit_type_node_preserving_extends(mutable this, mutable node: ref[AstNode], precedence: int)
        this.emit_type_node(node, precedence)

    procedure emit_type_node(mutable this, mutable node: ref[AstNode], precedence_in: int)
    {
        var precedence precedence_in
        ; in the `extends` clause of a ConditionalType or InferType a ConditionalType is parenthesized
        if in_extends and (precedence <= TypePrecedenceConditional)
            set precedence: TypePrecedenceFunction
        let saved_in_extends in_extends
        let parens this.get_type_node_precedence(node) < precedence
        if parens
        {
            set this.in_extends: false
            this.write_punctuation("(")
        }
        let k node.kind
        if (k = KindAnyKeyword) or (k = KindUnknownKeyword) or (k = KindNumberKeyword) or (k = KindBigIntKeyword) or (k = KindObjectKeyword) or (k = KindBooleanKeyword) or (k = KindStringKeyword) or (k = KindSymbolKeyword) or (k = KindVoidKeyword) or (k = KindUndefinedKeyword) or (k = KindNeverKeyword) or (k = KindIntrinsicKeyword)
            this.emit_keyword_type_node(node)
        else
            this.emit_type_node_by_kind(node, k)
        if parens
            this.write_punctuation(")")
        set this.in_extends: saved_in_extends
    }

    procedure emit_type_node_by_kind(mutable this, mutable node: ref[AstNode], k: int)
    {
        if k = KindTypePredicate
        {
            this.emit_type_predicate(node)
            return
        }
        if k = KindTypeReference
        {
            this.emit_type_reference(node)
            return
        }
        if k = KindFunctionType
        {
            this.emit_function_type(node)
            return
        }
        if k = KindConstructorType
        {
            this.emit_constructor_type(node)
            return
        }
        if k = KindTypeQuery
        {
            this.emit_type_query(node)
            return
        }
        if k = KindTypeLiteral
        {
            this.emit_type_literal(node)
            return
        }
        if k = KindArrayType
        {
            this.emit_array_type(node)
            return
        }
        if k = KindTupleType
        {
            this.emit_tuple_type(node)
            return
        }
        if k = KindOptionalType
        {
            this.emit_optional_type(node)
            return
        }
        if k = KindRestType
        {
            this.emit_rest_type(node)
            return
        }
        if k = KindUnionType
        {
            this.emit_union_type(node)
            return
        }
        if k = KindIntersectionType
        {
            this.emit_intersection_type(node)
            return
        }
        if k = KindConditionalType
        {
            this.emit_conditional_type(node)
            return
        }
        if k = KindInferType
        {
            this.emit_infer_type(node)
            return
        }
        if k = KindParenthesizedType
        {
            this.emit_parenthesized_type(node)
            return
        }
        if k = KindThisType
        {
            this.emit_this_type(node)
            return
        }
        if k = KindTypeOperator
        {
            this.emit_type_operator(node)
            return
        }
        if k = KindIndexedAccessType
        {
            this.emit_indexed_access_type(node)
            return
        }
        if k = KindMappedType
        {
            this.emit_mapped_type(node)
            return
        }
        if k = KindLiteralType
        {
            this.emit_literal_type(node)
            return
        }
        if k = KindNamedTupleMember
        {
            this.emit_named_tuple_member(node)
            return
        }
        if k = KindTemplateLiteralType
        {
            this.emit_template_type(node)
            return
        }
        if k = KindTemplateLiteralTypeSpan
        {
            this.emit_template_type_span(node)
            return
        }
        if k = KindImportType
        {
            this.emit_import_type_node(node)
            return
        }
        ; pseudo-types such as `f<T>.C`
        if k = KindPropertyAccessExpression
        {
            this.emit_property_access_expression(node)
            return
        }
        if k = KindExpressionWithTypeArguments
        {
            this.emit_expression_with_type_arguments(node)
            return
        }
        if k = KindJSDocAllType
        {
            this.emit_jsdoc_all_type(node)
            return
        }
        if k = KindJSDocNonNullableType
        {
            this.emit_jsdoc_non_nullable_type(node)
            return
        }
        if k = KindJSDocNullableType
        {
            this.emit_jsdoc_nullable_type(node)
            return
        }
        if k = KindJSDocOptionalType
        {
            this.emit_jsdoc_optional_type(node)
            return
        }
        if k = KindJSDocVariadicType
        {
            this.emit_jsdoc_variadic_type(node)
            return
        }
        ; the reference PANICS ("unhandled TypeNode")
        this.record_unported("emit-type-node-kind", k)
    }

    ; ── binding patterns ──

    procedure emit_object_binding_pattern(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("{")
        this.emit_list(EmitTagBindingElementNode, node, AstNode.elements_of(node), LFObjectBindingPatternElements)
        this.write_punctuation("}")
        this.exit_node(node, state)
    }

    procedure emit_array_binding_pattern(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("[")
        this.emit_list(EmitTagBindingElementNode, node, AstNode.elements_of(node), LFArrayBindingPatternElements)
        this.write_punctuation("]")
        this.exit_node(node, state)
    }

    procedure emit_binding_element(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token_node(AstNode.dot_dot_dot_token_of(node))
        let property_name AstNode.property_name_of(node)
        if property_name <> null
        {
            this.emit_property_name(property_name)
            this.write_punctuation(":")
            this.write_space()
        }
        ; an elision is a BindingElement with nil members
        let name Printer.declaration_name_of(node)
        if name <> null
        {
            this.emit_binding_name(name)
            this.emit_initializer(AstNode.initializer_of(node), (name as ref[AstNode]).end, node)
        }
        this.exit_node(node, state)
    }

    procedure emit_binding_element_node(mutable this, mutable node: ref[AstNode])
        this.emit_binding_element(node)

    procedure emit_jsdoc_all_type(mutable this, node: ref[AstNode])
        this.emit_keyword_node(node)

    procedure emit_jsdoc_non_nullable_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("!")
        this.emit_type_node(Printer.wrapped_inner_of(node) as ref[AstNode], TypePrecedenceNonArray)
        this.exit_node(node, state)
    }

    procedure emit_jsdoc_nullable_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("?")
        this.emit_type_node(Printer.wrapped_inner_of(node) as ref[AstNode], TypePrecedenceNonArray)
        this.exit_node(node, state)
    }

    procedure emit_jsdoc_optional_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_type_node(Printer.wrapped_inner_of(node) as ref[AstNode], TypePrecedenceJSDoc)
        this.write_punctuation("=")
        this.exit_node(node, state)
    }

    procedure emit_jsdoc_variadic_type(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("...")
        this.emit_type_node(Printer.wrapped_inner_of(node) as ref[AstNode], TypePrecedenceJSDoc)
        this.exit_node(node, state)
    }

    ; ── expressions ──

    procedure emit_keyword_expression(mutable this, node: ref[AstNode])
        this.emit_keyword_node(node)

    procedure emit_array_literal_expression_element(mutable this, mutable node: ref[AstNode])
        this.emit_expression(node, OperatorPrecedenceSpread)

    procedure emit_array_literal_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        var format LFArrayLiteralExpressionElements
        if AstNode.multi_line_of(node)
            set format: format | LFPreferNewLine
        this.emit_list(EmitTagArrayLiteralExpressionElement, node, AstNode.elements_of(node), format)
        this.exit_node(node, state)
    }

    procedure emit_object_literal_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        let properties AstNode.properties_of(node)
        this.generate_all_member_names(properties)
        var format LFObjectLiteralExpressionProperties
        if AstNode.multi_line_of(node)
            set format: format | LFPreferNewLine
        if this.should_allow_trailing_comma(node, properties)
            set format: format | LFAllowTrailingComma
        this.emit_list(EmitTagObjectLiteralElement, node, properties, format)
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    ; 1..toString is a valid property access: a dot after a numeric literal that
    ; will print verbatim without a dot or exponent
    procedure may_need_dot_dot_for_property_access(mutable this, expression_in: ref[AstNode]) returns bool
    {
        let expression Printer.skip_partially_emitted_expressions(expression_in)
        if expression.kind <> KindNumericLiteral
            return false
        let text this.get_literal_text_of_node(expression, null, LiteralTextFlagsNeverAsciiEscape)
        if (AstNode.numeric_token_flags_of(expression) & TokenFlagsWithSpecifier) <> 0
            return false
        if Printer.slice_contains_byte(text, 46)
            return false
        if Printer.slice_contains_byte(text, 69)
            return false
        Printer.slice_contains_byte(text, 101) = false
    }

    procedure emit_property_access_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let expression AstNode.property_access_expression_of(node) as ref[AstNode]
        let name AstNode.property_access_name_of(node) as ref[AstNode]
        var precedence OperatorPrecedenceMember
        if Binder.is_optional_chain(node)
            set precedence: OperatorPrecedenceOptionalChain
        this.emit_expression(expression, precedence)
        let question_dot_token AstNode.question_dot_token_of(node)
        var token: ref[AstNode]? question_dot_token
        if token = null
        {
            let dot context.the_factory().new_token(KindDotToken)
            set dot.pos: expression.end
            set dot.end: name.pos
            context.add_emit_flags(dot, EFNoSourceMap)
            set token: dot
        }
        let tk token as ref[AstNode]
        let lines_before_dot this.get_lines_between_nodes(node, expression, tk)
        this.write_line_repeat(lines_before_dot)
        this.increase_indent_if(lines_before_dot > 0)
        var should_emit_dot_dot false
        if tk.kind <> KindQuestionDotToken
        {
            if this.may_need_dot_dot_for_property_access(expression)
            {
                let w this.the_writer()
                if (w.has_trailing_comment() = false) and (w.has_trailing_whitespace() = false)
                    set should_emit_dot_dot: true
            }
        }
        if should_emit_dot_dot
            this.write_punctuation(".")
        if question_dot_token <> null
            this.emit_token_node(question_dot_token)
        else
            this.emit_token(KindDotToken, expression.end, WriteKindPunctuation, node)
        let lines_after_dot this.get_lines_between_nodes(node, tk, name)
        this.write_line_repeat(lines_after_dot)
        this.increase_indent_if(lines_after_dot > 0)
        this.emit_member_name(name)
        this.decrease_indent_if(lines_after_dot > 0)
        this.decrease_indent_if(lines_before_dot > 0)
        this.exit_node(node, state)
    }

    procedure emit_element_access_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let expression AstNode.expression_of(node) as ref[AstNode]
        var precedence OperatorPrecedenceMember
        if Binder.is_optional_chain(node)
            set precedence: OperatorPrecedenceOptionalChain
        this.emit_expression(expression, precedence)
        let question_dot_token AstNode.question_dot_token_of(node)
        this.emit_token_node(question_dot_token)
        var pos Printer.greatest_end_node(0 - 1, expression)
        set pos: Printer.greatest_end_node(pos, question_dot_token)
        this.emit_token(KindOpenBracketToken, pos, WriteKindPunctuation, node)
        let argument AstNode.element_access_argument_of(node) as ref[AstNode]
        this.emit_expression(argument, OperatorPrecedenceComma)
        this.emit_token(KindCloseBracketToken, argument.end, WriteKindPunctuation, node)
        this.exit_node(node, state)
    }

    procedure emit_argument(mutable this, mutable node: ref[AstNode])
        this.emit_expression(node, OperatorPrecedenceSpread)

    procedure emit_callee(mutable this, mutable callee: ref[AstNode], parent_node: ref[AstNode])
    {
        if this.should_emit_indirect_call(parent_node)
        {
            this.write_punctuation("(")
            this.write_literal("0")
            this.write_punctuation(",")
            this.write_space()
            this.emit_expression(callee, OperatorPrecedenceComma)
            this.write_punctuation(")")
            return
        }
        if (parent_node.kind = KindCallExpression) and Printer.is_new_expression_without_arguments(Printer.skip_partially_emitted_expressions(callee))
        {
            ; `(new C)()`, not `new C()`
            this.emit_expression(callee, OperatorPrecedenceParentheses)
            return
        }
        var precedence OperatorPrecedenceMember
        if Binder.is_optional_chain(parent_node)
            set precedence: OperatorPrecedenceOptionalChain
        this.emit_expression(callee, precedence)
    }

    procedure emit_call_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_callee(AstNode.expression_of(node) as ref[AstNode], node)
        this.emit_token_node(AstNode.question_dot_token_of(node))
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        this.emit_list(EmitTagArgument, node, AstNode.call_arguments_of(node), LFCallExpressionArguments)
        this.exit_node(node, state)
    }

    procedure emit_new_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindNewKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        let expression AstNode.expression_of(node) as ref[AstNode]
        if Printer.skip_partially_emitted_expressions(expression).kind = KindCallExpression
        {
            ; `new (C())`, not `new C()`
            this.emit_expression(expression, OperatorPrecedenceParentheses)
        }
        else
            this.emit_expression(expression, OperatorPrecedenceMember)
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        this.emit_list(EmitTagArgument, node, AstNode.call_arguments_of(node), LFNewExpressionArguments)
        this.exit_node(node, state)
    }

    procedure emit_template_literal(mutable this, mutable node: ref[AstNode])
    {
        if node.kind = KindNoSubstitutionTemplateLiteral
        {
            this.emit_no_substitution_template_literal(node)
            return
        }
        if node.kind = KindTemplateExpression
        {
            this.emit_template_expression(node)
            return
        }
        this.record_unported("emit-template-literal-kind", node.kind)
    }

    procedure emit_tagged_template_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_callee(AstNode.tagged_template_tag_of(node) as ref[AstNode], node)
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        this.write_space()
        this.emit_template_literal(AstNode.tagged_template_template_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_type_assertion_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("<")
        this.emit_type_node_outside_extends(AstNode.type_of(node) as ref[AstNode])
        this.write_punctuation(">")
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceUpdate)
        this.exit_node(node, state)
    }

    procedure emit_parenthesized_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let open_paren_pos this.emit_token(KindOpenParenToken, node.pos, WriteKindPunctuation, node)
        let expression AstNode.expression_of(node)
        var indented false
        if expression <> null
            set indented: this.write_line_separators_and_indent_before(expression as ref[AstNode], node)
        if expression <> null
        {
            this.emit_expression(expression as ref[AstNode], OperatorPrecedenceComma)
            this.write_line_separators_after(expression as ref[AstNode], node)
        }
        this.decrease_indent_if(indented)
        var close_paren_pos open_paren_pos
        if expression <> null
            set close_paren_pos: (expression as ref[AstNode]).end
        this.emit_token(KindCloseParenToken, close_paren_pos, WriteKindPunctuation, node)
        this.exit_node(node, state)
    }

    procedure emit_function_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let name Printer.declaration_name_of(node)
        this.generate_name_if_needed(name)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.write_keyword("function")
        this.emit_token_node(AstNode.asterisk_token_of(node))
        this.write_space()
        this.emit_identifier_name_node(name)
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_signature(node)
        this.emit_function_body_node(AstNode.body_of(node))
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_concise_body(mutable this, mutable node: ref[AstNode])
    {
        if node.kind = KindBlock
        {
            this.emit_function_body(node)
            return
        }
        let leftmost Printer.get_leftmost_expression(node, false)
        if leftmost.kind = KindObjectLiteralExpression
        {
            ; parenthesized AFTER any leading PartiallyEmittedExpression comments,
            ; as the factory's parenthesizeConciseBodyOfArrowFunction would
            let paren context.the_factory().new_parenthesized_expression(node)
            set paren.pos: node.pos
            set paren.end: node.end
            this.emit_expression(paren, OperatorPrecedenceLowest)
            return
        }
        this.emit_expression(node, OperatorPrecedenceYield)
    }

    procedure emit_arrow_function(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_type_parameters(node, AstNode.type_parameters_of(node))
        this.emit_parameters_for_arrow(node, AstNode.parameters_of(node))
        this.emit_type_annotation(Printer.return_type_of(node))
        this.write_space()
        this.emit_token_node(AstNode.equals_greater_than_token_of(node))
        this.write_space()
        this.emit_concise_body(AstNode.body_of(node) as ref[AstNode])
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_unary_keyword_expression(mutable this, mutable node: ref[AstNode], keyword: int)
    {
        let state this.enter_node(node)
        this.emit_token(keyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceUnary)
        this.exit_node(node, state)
    }

    procedure emit_delete_expression(mutable this, mutable node: ref[AstNode])
        this.emit_unary_keyword_expression(node, KindDeleteKeyword)

    procedure emit_type_of_expression(mutable this, mutable node: ref[AstNode])
        this.emit_unary_keyword_expression(node, KindTypeOfKeyword)

    procedure emit_void_expression(mutable this, mutable node: ref[AstNode])
        this.emit_unary_keyword_expression(node, KindVoidKeyword)

    procedure emit_await_expression(mutable this, mutable node: ref[AstNode])
        this.emit_unary_keyword_expression(node, KindAwaitKeyword)

    procedure emit_prefix_unary_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let op Printer.prefix_unary_operator_of(node)
        let operand AstNode.prefix_unary_operand_of(node) as ref[AstNode]
        this.emit_token(op, node.pos, WriteKindOperator, node)
        ; a space between `+`/`-` and an inner `+`/`++` (`-`/`--`): without it
        ; `+(+1)` reads as a prefix increment
        if operand.kind = KindPrefixUnaryExpression
        {
            let inner Printer.prefix_unary_operator_of(operand)
            if ((op = KindPlusToken) and ((inner = KindPlusToken) or (inner = KindPlusPlusToken))) or ((op = KindMinusToken) and ((inner = KindMinusToken) or (inner = KindMinusMinusToken)))
                this.write_space()
        }
        this.emit_expression(operand, OperatorPrecedenceUnary)
        this.exit_node(node, state)
    }

    procedure emit_postfix_unary_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let operand AstNode.postfix_unary_operand_of(node) as ref[AstNode]
        this.emit_expression(operand, OperatorPrecedenceLeftHandSide)
        this.emit_token(AstNode.postfix_unary_operator_of(node), operand.end, WriteKindOperator, node)
        this.exit_node(node, state)
    }

    ; whether an expression is a homogeneous set of literals or binary plus
    ; expressions of one literal kind (the right operand of a `+` then needs no parens)
    procedure get_literal_kind_of_binary_plus_operand(this, node_in: ref[AstNode]) returns int
    {
        let node Printer.skip_partially_emitted_expressions(node_in)
        if Printer.is_literal_kind(node.kind)
            return node.kind
        if node.kind = KindBinaryExpression
        {
            if AstNode.kind_of(AstNode.binary_operator_token_of(node)) = KindPlusToken
            {
                let left_kind this.get_literal_kind_of_binary_plus_operand(AstNode.binary_left_of(node) as ref[AstNode])
                var literal_kind KindUnknown
                if Printer.is_literal_kind(left_kind) and (left_kind = this.get_literal_kind_of_binary_plus_operand(AstNode.binary_right_of(node) as ref[AstNode]))
                    set literal_kind: left_kind
                return literal_kind
            }
        }
        KindUnknown
    }

    procedure get_binary_expression_precedence(mutable this, node: ref[AstNode], mutable out_left: ref[int], mutable out_right: ref[int])
    {
        let precedence Printer.get_expression_precedence(node)
        set out_left: precedence
        set out_right: precedence
        let op AstNode.kind_of(AstNode.binary_operator_token_of(node))
        if precedence = OperatorPrecedenceComma
            return
        if precedence = OperatorPrecedenceAssignment
        {
            ; right-associative
            set out_left: OperatorPrecedenceConditional
            set out_right: OperatorPrecedenceYield
            return
        }
        if precedence = OperatorPrecedenceLogicalOR
        {
            set out_right: OperatorPrecedenceLogicalAND
            return
        }
        if precedence = OperatorPrecedenceLogicalAND
        {
            set out_right: OperatorPrecedenceBitwiseOR
            return
        }
        if (precedence = OperatorPrecedenceBitwiseOR) or (precedence = OperatorPrecedenceBitwiseXOR) or (precedence = OperatorPrecedenceBitwiseAND)
            return
        if precedence = OperatorPrecedenceEquality
        {
            set out_right: OperatorPrecedenceRelational
            return
        }
        if precedence = OperatorPrecedenceRelational
        {
            set out_right: OperatorPrecedenceShift
            return
        }
        if precedence = OperatorPrecedenceShift
        {
            set out_right: OperatorPrecedenceAdditive
            return
        }
        if precedence = OperatorPrecedenceAdditive
        {
            let right AstNode.binary_right_of(node) as ref[AstNode]
            if (op = KindPlusToken) and Printer.is_binary_operation(right, KindPlusToken)
            {
                let left_kind this.get_literal_kind_of_binary_plus_operand(AstNode.binary_left_of(node) as ref[AstNode])
                if Printer.is_literal_kind(left_kind) and (left_kind = this.get_literal_kind_of_binary_plus_operand(right))
                    return
            }
            set out_right: OperatorPrecedenceMultiplicative
            return
        }
        if precedence = OperatorPrecedenceMultiplicative
        {
            if (op = KindAsteriskToken) and Printer.is_binary_operation(AstNode.binary_right_of(node) as ref[AstNode], KindAsteriskToken)
                return
            set out_right: OperatorPrecedenceExponentiation
            return
        }
        if precedence = OperatorPrecedenceExponentiation
        {
            ; right-associative
            set out_left: OperatorPrecedenceUpdate
            return
        }
        ; the reference PANICS ("unhandled precedence")
        this.record_unported("binary-expression-precedence", precedence)
    }

    procedure emit_binary_expression(mutable this, mutable node: ref[AstNode])
    {
        var left_prec 0
        var right_prec 0
        this.get_binary_expression_precedence(node, &left_prec, &right_prec)
        let left AstNode.binary_left_of(node) as ref[AstNode]
        let right AstNode.binary_right_of(node) as ref[AstNode]
        let operator_token AstNode.binary_operator_token_of(node) as ref[AstNode]
        let emitted_left Printer.skip_partially_emitted_expressions(left)
        if Printer.node_is_synthesized(emitted_left) and (emitted_left.kind = KindBinaryExpression) and Printer.mixing_binary_operators_requires_parentheses(operator_token.kind, AstNode.kind_of(AstNode.binary_operator_token_of(emitted_left)))
            set left_prec: OperatorPrecedenceHighest
        let emitted_right Printer.skip_partially_emitted_expressions(right)
        if Printer.node_is_synthesized(emitted_right) and (emitted_right.kind = KindBinaryExpression) and Printer.mixing_binary_operators_requires_parentheses(operator_token.kind, AstNode.kind_of(AstNode.binary_operator_token_of(emitted_right)))
            set right_prec: OperatorPrecedenceHighest
        let state this.enter_node(node)
        this.emit_expression(left, left_prec)
        let lines_before_operator this.get_lines_between_nodes(node, left, operator_token)
        let lines_after_operator this.get_lines_between_nodes(node, operator_token, right)
        this.write_lines_and_indent(lines_before_operator, operator_token.kind <> KindCommaToken)
        this.emit_token_node_ex(operator_token, TefNoSourceMaps)
        ; a space before the comment starts
        this.write_lines_and_indent(lines_after_operator, true)
        this.emit_expression(right, right_prec)
        this.decrease_indent_if(lines_after_operator > 0)
        this.decrease_indent_if(lines_before_operator > 0)
        this.exit_node(node, state)
    }

    procedure emit_short_circuit_expression(mutable this, mutable node: ref[AstNode])
    {
        if Printer.is_binary_operation(Printer.skip_partially_emitted_expressions(node), KindQuestionQuestionToken)
            this.emit_expression(node, OperatorPrecedenceCoalesce)
        else
            this.emit_expression(node, OperatorPrecedenceLogicalOR)
    }

    procedure emit_conditional_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let condition AstNode.conditional_condition_of(node) as ref[AstNode]
        let question_token AstNode.question_token_of(node) as ref[AstNode]
        let when_true AstNode.conditional_when_true_of(node) as ref[AstNode]
        let colon_token AstNode.colon_token_of(node) as ref[AstNode]
        let when_false AstNode.conditional_when_false_of(node) as ref[AstNode]
        let lines_before_question this.get_lines_between_nodes(node, condition, question_token)
        let lines_after_question this.get_lines_between_nodes(node, question_token, when_true)
        let lines_before_colon this.get_lines_between_nodes(node, when_true, colon_token)
        let lines_after_colon this.get_lines_between_nodes(node, colon_token, when_false)
        this.emit_short_circuit_expression(condition)
        this.write_lines_and_indent(lines_before_question, true)
        this.emit_punctuation_node(question_token)
        this.write_lines_and_indent(lines_after_question, true)
        this.emit_expression(when_true, OperatorPrecedenceYield)
        this.decrease_indent_if(lines_after_question > 0)
        this.decrease_indent_if(lines_before_question > 0)
        this.write_lines_and_indent(lines_before_colon, true)
        this.emit_punctuation_node(colon_token)
        this.write_lines_and_indent(lines_after_colon, true)
        this.emit_expression(when_false, OperatorPrecedenceYield)
        this.decrease_indent_if(lines_after_colon > 0)
        this.decrease_indent_if(lines_before_colon > 0)
        this.exit_node(node, state)
    }

    procedure emit_template_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_template_head(AstNode.template_head_of(node) as ref[AstNode])
        this.emit_list(EmitTagTemplateSpanNode, node, AstNode.template_expression_spans_of(node), LFTemplateExpressionSpans)
        this.exit_node(node, state)
    }

    procedure emit_yield_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindYieldKeyword, node.pos, WriteKindKeyword, node)
        this.emit_punctuation_node(AstNode.asterisk_token_of(node))
        let expression AstNode.expression_of(node)
        if expression <> null
        {
            this.write_space()
            this.emit_expression_no_asi(expression as ref[AstNode], OperatorPrecedenceDisallowComma)
        }
        this.exit_node(node, state)
    }

    procedure emit_spread_element(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindDotDotDotToken, node.pos, WriteKindPunctuation, node)
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceDisallowComma)
        this.exit_node(node, state)
    }

    procedure emit_class_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let name Printer.declaration_name_of(node)
        this.generate_name_if_needed(name)
        let pos this.emit_modifier_list(node, Printer.modifier_list_of(node), true)
        this.emit_token(KindClassKeyword, pos, WriteKindKeyword, node)
        if name <> null
        {
            this.write_space()
            this.emit_identifier_name(name as ref[AstNode])
        }
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.emit_type_parameters(node, AstNode.type_parameters_of(node))
        this.emit_list(EmitTagHeritageClauseNode, node, AstNode.heritage_clauses_of(node), LFClassHeritageClauses)
        this.write_space()
        this.write_punctuation("{")
        this.push_name_generation_scope(node)
        let members Printer.member_list_of(node)
        this.generate_all_member_names(members)
        this.emit_list(EmitTagClassElement, node, members, LFClassMembers)
        this.pop_name_generation_scope(node)
        this.write_punctuation("}")
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_omitted_expression(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.exit_node(node, state)
    }

    procedure emit_expression_with_type_arguments(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceMember)
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        this.exit_node(node, state)
    }

    procedure emit_expression_with_type_arguments_node(mutable this, mutable node: ref[AstNode])
        this.emit_expression_with_type_arguments(node)

    procedure emit_as_or_satisfies_expression(mutable this, mutable node: ref[AstNode], keyword: Slice[char])
    {
        let state this.enter_node(node)
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceRelational)
        this.write_space()
        this.write_keyword(keyword)
        this.write_space()
        this.emit_type_node_outside_extends(AstNode.type_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_as_expression(mutable this, mutable node: ref[AstNode])
        this.emit_as_or_satisfies_expression(node, "as")

    procedure emit_satisfies_expression(mutable this, mutable node: ref[AstNode])
        this.emit_as_or_satisfies_expression(node, "satisfies")

    procedure emit_non_null_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceMember)
        this.write_operator("!")
        this.exit_node(node, state)
    }

    procedure emit_meta_property(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(AstNode.meta_property_keyword_token_of(node), node.pos, WriteKindPunctuation, node)
        this.write_punctuation(".")
        this.emit_identifier_name(Printer.declaration_name_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    ; nested partially-emitted expressions print their parens once: a stack of
    ; (node, state) pairs, unwound after the innermost expression
    procedure emit_partially_emitted_expression(mutable this, mutable node_in: ref[AstNode])
    {
        let nodes &Array[ref[AstNode]?]^host()
        let states &Array[PrinterState]^host()
        var node node_in
        var descending true
        while descending
        {
            let state this.enter_node(node)
            let emit_flags context.emit_flags(node)
            let inner Printer.wrapped_inner_of(node) as ref[AstNode]
            if ((emit_flags & EFNoLeadingComments) = 0) and (node.pos <> inner.pos)
                this.emit_trailing_comments_of_position(inner.pos, false, false)
            nodes.add(node)
            states.add(state)
            if inner.kind <> KindPartiallyEmittedExpression
                set descending: false
            else
                set node: inner
        }
        this.emit_expression(Printer.wrapped_inner_of(node) as ref[AstNode], OperatorPrecedenceLowest)
        var i nodes.get_length() as int
        while i > 0
        {
            set i: i - 1
            let entry nodes[i as size_t] as ref[AstNode]
            let emit_flags context.emit_flags(node)
            let inner Printer.wrapped_inner_of(node) as ref[AstNode]
            if ((emit_flags & EFNoTrailingComments) = 0) and (node.end <> inner.end)
                this.emit_leading_comments_of_position(inner.end)
            this.exit_node(node, states[i as size_t])
            set node: entry
        }
    }

    function comment_will_emit_new_line(comment: CommentRange) returns bool
        (comment.kind = KindSingleLineCommentTrivia) or comment.has_trailing_new_line

    function synthetic_comment_will_emit_new_line(comment: SynthesizedComment) returns bool
        (comment.kind = KindSingleLineCommentTrivia) or comment.has_trailing_new_line

    procedure will_emit_leading_new_line(mutable this, node: ref[AstNode]) returns bool
    {
        if current_source_file = null
            return false
        var has_leading_comment_ranges false
        var has_new_line_comment false
        let leading Scanner.get_leading_comment_ranges(host, this.file_text(), node.pos)
        var i 0
        while i < (leading.get_length() as int)
        {
            set has_leading_comment_ranges: true
            if Printer.comment_will_emit_new_line(leading[i as size_t])
                set has_new_line_comment: true
            set i: i + 1
        }
        if has_leading_comment_ranges
        {
            let parse_node context.parse_node(node)
            if parse_node <> null
            {
                if AstNode.kind_of((parse_node as ref[AstNode]).parent) = KindParenthesizedExpression
                    return true
            }
        }
        if has_new_line_comment
            return true
        let synth context.get_synthetic_leading_comments(node)
        if synth <> null
        {
            let list synth as ref[Array[SynthesizedComment]]
            var j 0
            while j < (list.get_length() as int)
            {
                if Printer.synthetic_comment_will_emit_new_line(list[j as size_t])
                    return true
                set j: j + 1
            }
        }
        if node.kind = KindPartiallyEmittedExpression
        {
            let inner Printer.wrapped_inner_of(node) as ref[AstNode]
            if node.pos <> inner.pos
            {
                let trailing Scanner.get_trailing_comment_ranges(host, this.file_text(), inner.pos)
                var t 0
                while t < (trailing.get_length() as int)
                {
                    if Printer.comment_will_emit_new_line(trailing[t as size_t])
                        return true
                    set t: t + 1
                }
            }
            return this.will_emit_leading_new_line(inner)
        }
        false
    }

    ; parenthesize an expression whose leading comment would put a line
    ; separator between the node and its parent (ASI)
    procedure parenthesize_expression_for_no_asi(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]
    {
        if comments_disabled
            return node
        let f context.the_factory()
        let k node.kind
        if k = KindPartiallyEmittedExpression
        {
            let inner Printer.wrapped_inner_of(node) as ref[AstNode]
            if this.will_emit_leading_new_line(node)
            {
                let parse_node context.parse_node(node)
                if parse_node <> null
                {
                    let pn parse_node as ref[AstNode]
                    if pn.kind = KindParenthesizedExpression
                    {
                        ; the original was parenthesized: restore it, comments and source maps with it
                        let parens f.new_parenthesized_expression(inner)
                        context.set_original(parens, node)
                        set parens.pos: pn.pos
                        set parens.end: pn.end
                        return parens
                    }
                }
                return f.new_parenthesized_expression(node)
            }
            return f.update_partially_emitted_expression(node, this.parenthesize_expression_for_no_asi(inner))
        }
        if k = KindPropertyAccessExpression
            return f.update_property_access_expression(node, this.parenthesize_expression_for_no_asi(AstNode.property_access_expression_of(node) as ref[AstNode]), AstNode.question_dot_token_of(node), AstNode.property_access_name_of(node), node.flags)
        if k = KindElementAccessExpression
            return f.update_element_access_expression(node, this.parenthesize_expression_for_no_asi(AstNode.expression_of(node) as ref[AstNode]), AstNode.question_dot_token_of(node), AstNode.element_access_argument_of(node), node.flags)
        if k = KindCallExpression
            return f.update_call_expression(node, this.parenthesize_expression_for_no_asi(AstNode.expression_of(node) as ref[AstNode]), AstNode.question_dot_token_of(node), AstNode.type_arguments_of(node), AstNode.call_arguments_of(node), node.flags)
        if k = KindTaggedTemplateExpression
            return f.update_tagged_template_expression(node, this.parenthesize_expression_for_no_asi(AstNode.tagged_template_tag_of(node) as ref[AstNode]), AstNode.question_dot_token_of(node), AstNode.type_arguments_of(node), AstNode.tagged_template_template_of(node), node.flags)
        if k = KindPostfixUnaryExpression
            return f.update_postfix_unary_expression(node, this.parenthesize_expression_for_no_asi(AstNode.postfix_unary_operand_of(node) as ref[AstNode]), AstNode.postfix_unary_operator_of(node))
        if k = KindBinaryExpression
            return f.update_binary_expression(node, Printer.modifier_list_of(node), this.parenthesize_expression_for_no_asi(AstNode.binary_left_of(node) as ref[AstNode]), AstNode.binary_type_of(node), AstNode.binary_operator_token_of(node), AstNode.binary_right_of(node))
        if k = KindConditionalExpression
            return f.update_conditional_expression(node, this.parenthesize_expression_for_no_asi(AstNode.conditional_condition_of(node) as ref[AstNode]), AstNode.question_token_of(node), AstNode.conditional_when_true_of(node), AstNode.colon_token_of(node), AstNode.conditional_when_false_of(node))
        if k = KindAsExpression
            return f.update_as_expression(node, this.parenthesize_expression_for_no_asi(AstNode.expression_of(node) as ref[AstNode]), AstNode.type_of(node))
        if k = KindSatisfiesExpression
            return f.update_satisfies_expression(node, this.parenthesize_expression_for_no_asi(AstNode.expression_of(node) as ref[AstNode]), AstNode.type_of(node))
        if k = KindNonNullExpression
            return f.update_non_null_expression(node, this.parenthesize_expression_for_no_asi(AstNode.expression_of(node) as ref[AstNode]), node.flags)
        node
    }

    procedure emit_expression_no_asi(mutable this, mutable node: ref[AstNode], precedence: int)
        this.emit_expression(this.parenthesize_expression_for_no_asi(node), precedence)

    procedure emit_expression(mutable this, mutable node: ref[AstNode], precedence: int)
    {
        let parens Printer.get_expression_precedence(Printer.skip_partially_emitted_expressions(node)) < precedence
        if parens
            this.write_punctuation("(")
        this.emit_expression_by_kind(node, node.kind)
        if parens
            this.write_punctuation(")")
    }

    procedure emit_expression_by_kind(mutable this, mutable node: ref[AstNode], k: int)
    {
        if (k = KindTrueKeyword) or (k = KindFalseKeyword) or (k = KindNullKeyword)
        {
            this.emit_token_node(node)
            return
        }
        if (k = KindThisKeyword) or (k = KindSuperKeyword) or (k = KindImportKeyword)
        {
            this.emit_keyword_expression(node)
            return
        }
        if k = KindNumericLiteral
        {
            this.emit_numeric_literal(node)
            return
        }
        if k = KindBigIntLiteral
        {
            this.emit_big_int_literal(node)
            return
        }
        if k = KindStringLiteral
        {
            this.emit_string_literal(node)
            return
        }
        if k = KindRegularExpressionLiteral
        {
            this.emit_regular_expression_literal(node)
            return
        }
        if k = KindNoSubstitutionTemplateLiteral
        {
            this.emit_no_substitution_template_literal(node)
            return
        }
        if k = KindIdentifier
        {
            this.emit_identifier_reference(node)
            return
        }
        if k = KindPrivateIdentifier
        {
            this.emit_private_identifier(node)
            return
        }
        if k = KindArrayLiteralExpression
        {
            this.emit_array_literal_expression(node)
            return
        }
        if k = KindObjectLiteralExpression
        {
            this.emit_object_literal_expression(node)
            return
        }
        if k = KindPropertyAccessExpression
        {
            this.emit_property_access_expression(node)
            return
        }
        if k = KindElementAccessExpression
        {
            this.emit_element_access_expression(node)
            return
        }
        if k = KindCallExpression
        {
            this.emit_call_expression(node)
            return
        }
        if k = KindNewExpression
        {
            this.emit_new_expression(node)
            return
        }
        if k = KindTaggedTemplateExpression
        {
            this.emit_tagged_template_expression(node)
            return
        }
        if k = KindTypeAssertionExpression
        {
            this.emit_type_assertion_expression(node)
            return
        }
        if k = KindParenthesizedExpression
        {
            this.emit_parenthesized_expression(node)
            return
        }
        if k = KindFunctionExpression
        {
            this.emit_function_expression(node)
            return
        }
        if k = KindArrowFunction
        {
            this.emit_arrow_function(node)
            return
        }
        if k = KindDeleteExpression
        {
            this.emit_delete_expression(node)
            return
        }
        if k = KindTypeOfExpression
        {
            this.emit_type_of_expression(node)
            return
        }
        if k = KindVoidExpression
        {
            this.emit_void_expression(node)
            return
        }
        if k = KindAwaitExpression
        {
            this.emit_await_expression(node)
            return
        }
        if k = KindPrefixUnaryExpression
        {
            this.emit_prefix_unary_expression(node)
            return
        }
        if k = KindPostfixUnaryExpression
        {
            this.emit_postfix_unary_expression(node)
            return
        }
        if k = KindBinaryExpression
        {
            this.emit_binary_expression(node)
            return
        }
        if k = KindConditionalExpression
        {
            this.emit_conditional_expression(node)
            return
        }
        if k = KindTemplateExpression
        {
            this.emit_template_expression(node)
            return
        }
        if k = KindYieldExpression
        {
            this.emit_yield_expression(node)
            return
        }
        if k = KindSpreadElement
        {
            this.emit_spread_element(node)
            return
        }
        if k = KindClassExpression
        {
            this.emit_class_expression(node)
            return
        }
        if k = KindOmittedExpression
        {
            this.emit_omitted_expression(node)
            return
        }
        if k = KindAsExpression
        {
            this.emit_as_expression(node)
            return
        }
        if k = KindNonNullExpression
        {
            this.emit_non_null_expression(node)
            return
        }
        if k = KindExpressionWithTypeArguments
        {
            this.emit_expression_with_type_arguments(node)
            return
        }
        if k = KindSatisfiesExpression
        {
            this.emit_satisfies_expression(node)
            return
        }
        if k = KindMetaProperty
        {
            this.emit_meta_property(node)
            return
        }
        if k = KindMissingDeclaration
        {
            return
        }
        if k = KindJsxElement
        {
            this.emit_jsx_element(node)
            return
        }
        if k = KindJsxSelfClosingElement
        {
            this.emit_jsx_self_closing_element(node)
            return
        }
        if k = KindJsxFragment
        {
            this.emit_jsx_fragment(node)
            return
        }
        if k = KindNotEmittedStatement
        {
            return
        }
        if k = KindPartiallyEmittedExpression
        {
            this.emit_partially_emitted_expression(node)
            return
        }
        ; SyntheticExpression, SyntaxList and SyntheticReferenceExpression are
        ; never printed (the reference PANICS), and so is any other kind
        this.record_unported("emit-expression-kind", k)
    }

    ; ── misc ──

    procedure emit_template_span(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_expression(AstNode.expression_of(node) as ref[AstNode], OperatorPrecedenceComma)
        this.emit_template_middle_tail(Printer.template_span_literal_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_template_span_node(mutable this, mutable node: ref[AstNode])
        this.emit_template_span(node)

    procedure emit_semicolon_class_element(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }


    procedure emit_heritage_clause_node(mutable this, mutable node: ref[AstNode])
        this.emit_heritage_clause(node)

    procedure emit_import_attribute_node(mutable this, mutable node: ref[AstNode])
        this.emit_import_attribute(node)







    ; ═══ printer.go (slice 235): statements, declarations, modules, JSX, clauses, the source file ═══

    ; the statement-level `expression` and `statement` children ast.scaly's
    ; generic accessors do not reach
    function statement_expression_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when d: ExpressionStatement
                return d.expression
            when d: ThrowStatement
                return d.expression
            when d: ReturnStatement
                return d.expression
            when d: IfStatement
                return d.expression
            when d: WhileStatement
                return d.expression
            when d: WithStatement
                return d.expression
            when d: DoStatement
                return d.expression
            when d: SwitchStatement
                return d.expression
            when d: CaseClause
                return d.expression
            when d: ForInStatement
                return d.expression
            when d: ForOfStatement
                return d.expression
            when d: JsxExpression
                return d.expression
            when d: ExportAssignment
                return d.expression
            when d: JsxSpreadAttribute
                return d.inner
            when d: ExternalModuleReference
                return d.inner
        null
    }

    function statement_body_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when d: LabeledStatement
                return d.statement
            when d: WhileStatement
                return d.statement
            when d: WithStatement
                return d.statement
            when d: DoStatement
                return d.statement
            when d: ForStatement
                return d.statement
            when d: ForInStatement
                return d.statement
            when d: ForOfStatement
                return d.statement
        null
    }

    function specifier_is_type_only_of(n: ref[AstNode]) returns bool
    {
        choose n.data
            when d: ImportSpecifier
                return d.is_type_only
            when d: ExportSpecifier
                return d.is_type_only
        false
    }

    function module_body_of(n: ref[AstNode]) returns ref[AstNode]?
    {
        choose n.data
            when d: ModuleDeclaration
                return d.body
        null
    }

    ; ── statements ──

    function is_empty_block(this, block: ref[AstNode], statements: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if statements <> null
        {
            if ((statements as ref[Array[ref[AstNode]?]]).get_length() as int) <> 0
                return false
        }
        if current_source_file = null
            return true
        let csf current_source_file as ref[SourceFileInfo]
        Printer.range_end_is_on_same_line_as_range_start(TextRange.of_node(block), TextRange.of_node(block), csf.text, csf.line_starts)
    }

    procedure emit_block(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.generate_names(node)
        this.emit_token(KindOpenBraceToken, node.pos, WriteKindPunctuation, node)
        let statements AstNode.statements_of(node)
        var format LFMultiLineBlockStatements
        if ((AstNode.multi_line_of(node) = false) and this.is_empty_block(node, statements)) or this.should_emit_on_single_line(node)
            set format: LFSingleLineBlockStatements
        this.emit_list(EmitTagStatement, node, statements, format)
        var sp 0 - 1
        var se 0 - 1
        this.list_range(statements, &sp, &se)
        ; ★ A MISSING statement list is the parser's one shared sentinel, so it
        ; carries no range of its own (the reference gives each missing list the
        ; range [nodePos, nodePos) at the site). A block finished at that same
        ; position, so the block's END is exactly the list's end — and it is what
        ; the trailing-comment scan after the `}` has to start from (a `try { };
        ; // comment` printed the comment inside the missing finally block but
        ; not after its brace until this fallback, slice 236).
        if se < 0
        {
            ; only the EMPTY missing list takes the block's end: a list a
            ; transformer rebuilt carries no range (the reference's NewNodeList has
            ; none) and its brace takes no comments, as the reference's does
            ; (slice 250 — a namespace's trailing `/** */` was printed inside)
            var sn 0
            if statements <> null
                set sn: (statements as ref[Array[ref[AstNode]?]]).get_length() as int
            if sn = 0
                set se: node.end
        }
        var flags TefNone
        if (format & LFMultiLine) <> 0
            set flags: TefIndentLeadingComments
        this.emit_token_ex(KindCloseBraceToken, se, WriteKindPunctuation, node, flags)
        this.exit_node(node, state)
    }

    procedure emit_variable_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.emit_variable_declaration_list(Printer.declaration_list_of(node) as ref[AstNode])
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    ; an EMBEDDED empty statement is significant: a trailing-semicolon-omitting
    ; writer may not elide it
    procedure emit_empty_statement(mutable this, node: ref[AstNode], is_embedded_statement: bool)
    {
        let state this.enter_node(node)
        if is_embedded_statement
            this.write_punctuation(";")
        else
            this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_expression_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        var is_json false
        if current_source_file <> null
        {
            if (current_source_file as ref[SourceFileInfo]).script_kind = ScriptKindJSON
                set is_json: true
        }
        if is_json
            this.emit_expression(expression, OperatorPrecedenceComma)
        else
        {
            if Printer.is_immediately_invoked_function_expression_or_arrow_function(expression)
                this.emit_iife_with_parenthesized_callee(expression)
            else
            {
                let leftmost_kind Printer.get_leftmost_expression(expression, false).kind
                if (leftmost_kind = KindFunctionExpression) or (leftmost_kind = KindObjectLiteralExpression)
                    this.emit_expression(expression, OperatorPrecedenceParentheses)
                else
                    this.emit_expression(expression, OperatorPrecedenceComma)
            }
        }
        ; the semicolon: in a non-JSON file, or for a synthesized expression in a JSON one
        if (is_json = false) or Printer.node_is_synthesized(expression)
            this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    ; an IIFE: parens around the CALLEE only — `(function () { })()`
    procedure emit_iife_with_parenthesized_callee(mutable this, mutable node: ref[AstNode])
    {
        let call Printer.skip_partially_emitted_expressions(node)
        let state this.enter_node(call)
        this.write_punctuation("(")
        this.emit_expression(AstNode.expression_of(call) as ref[AstNode], OperatorPrecedenceLowest)
        this.write_punctuation(")")
        this.emit_token_node(AstNode.question_dot_token_of(call))
        this.emit_type_arguments(call, AstNode.type_arguments_of(call))
        this.emit_list(EmitTagArgument, call, AstNode.call_arguments_of(call), LFCallExpressionArguments)
        this.exit_node(call, state)
    }

    procedure emit_if_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let pos this.emit_token(KindIfKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_token(KindOpenParenToken, pos, WriteKindPunctuation, node)
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        this.emit_expression(expression, OperatorPrecedenceLowest)
        this.emit_token(KindCloseParenToken, expression.end, WriteKindPunctuation, node)
        let then_statement AstNode.then_statement_of(node) as ref[AstNode]
        this.emit_embedded_statement(node, then_statement)
        let else_statement AstNode.else_statement_of(node)
        if else_statement <> null
        {
            let es else_statement as ref[AstNode]
            this.write_line_or_space(node, then_statement, es)
            this.emit_token(KindElseKeyword, then_statement.end, WriteKindKeyword, node)
            if es.kind = KindIfStatement
            {
                this.write_space()
                this.emit_if_statement(es)
            }
            else
                this.emit_embedded_statement(node, es)
        }
        this.exit_node(node, state)
    }

    procedure emit_while_clause(mutable this, node: ref[AstNode], mutable expression: ref[AstNode], start_pos: int)
    {
        let pos this.emit_token(KindWhileKeyword, start_pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_token(KindOpenParenToken, pos, WriteKindPunctuation, node)
        this.emit_expression(expression, OperatorPrecedenceLowest)
        this.emit_token(KindCloseParenToken, expression.end, WriteKindPunctuation, node)
    }

    procedure emit_do_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindDoKeyword, node.pos, WriteKindKeyword, node)
        let statement Printer.statement_body_of(node) as ref[AstNode]
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        this.emit_embedded_statement(node, statement)
        if (statement.kind = KindBlock) and (options.preserve_source_newlines = false)
            this.write_space()
        else
            this.write_line_or_space(node, statement, expression)
        this.emit_while_clause(node, expression, statement.end)
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_while_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_while_clause(node, Printer.statement_expression_of(node) as ref[AstNode], node.pos)
        this.emit_embedded_statement(node, Printer.statement_body_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_for_initializer(mutable this, mutable node: ref[AstNode])
    {
        if node.kind = KindVariableDeclarationList
            this.emit_variable_declaration_list(node)
        else
            this.emit_expression(node, OperatorPrecedenceLowest)
    }

    procedure emit_for_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        var pos this.emit_token(KindForKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        set pos: this.emit_token(KindOpenParenToken, pos, WriteKindPunctuation, node)
        let initializer AstNode.initializer_of(node)
        if initializer <> null
        {
            this.emit_for_initializer(initializer as ref[AstNode])
            set pos: (initializer as ref[AstNode]).end
        }
        set pos: this.emit_token(KindSemicolonToken, pos, WriteKindPunctuation, node)
        let condition AstNode.for_condition_of(node)
        if condition <> null
        {
            this.write_space()
            this.emit_expression(condition as ref[AstNode], OperatorPrecedenceLowest)
            set pos: (condition as ref[AstNode]).end
        }
        set pos: this.emit_token(KindSemicolonToken, pos, WriteKindPunctuation, node)
        let incrementor AstNode.for_incrementor_of(node)
        if incrementor <> null
        {
            this.write_space()
            this.emit_expression(incrementor as ref[AstNode], OperatorPrecedenceLowest)
            set pos: (incrementor as ref[AstNode]).end
        }
        this.emit_token(KindCloseParenToken, pos, WriteKindPunctuation, node)
        this.emit_embedded_statement(node, Printer.statement_body_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_for_in_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let pos this.emit_token(KindForKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_token(KindOpenParenToken, pos, WriteKindPunctuation, node)
        let initializer AstNode.initializer_of(node) as ref[AstNode]
        this.emit_for_initializer(initializer)
        this.write_space()
        this.emit_token(KindInKeyword, initializer.end, WriteKindKeyword, node)
        this.write_space()
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        this.emit_expression(expression, OperatorPrecedenceLowest)
        this.emit_token(KindCloseParenToken, expression.end, WriteKindPunctuation, node)
        this.emit_embedded_statement(node, Printer.statement_body_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_for_of_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let open_paren_pos this.emit_token(KindForKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        let await_modifier AstNode.for_await_modifier_of(node)
        if await_modifier <> null
        {
            this.emit_keyword_node(await_modifier)
            this.write_space()
        }
        this.emit_token(KindOpenParenToken, open_paren_pos, WriteKindPunctuation, node)
        let initializer AstNode.initializer_of(node) as ref[AstNode]
        this.emit_for_initializer(initializer)
        this.write_space()
        this.emit_token(KindOfKeyword, initializer.end, WriteKindKeyword, node)
        this.write_space()
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        this.emit_expression(expression, OperatorPrecedenceLowest)
        this.emit_token(KindCloseParenToken, expression.end, WriteKindPunctuation, node)
        this.emit_embedded_statement(node, Printer.statement_body_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_break_or_continue_statement(mutable this, node: ref[AstNode], keyword: int)
    {
        let state this.enter_node(node)
        this.emit_token(keyword, node.pos, WriteKindKeyword, node)
        let label_node AstNode.label_name_of(node)
        if label_node <> null
        {
            this.write_space()
            this.emit_label_identifier(label_node as ref[AstNode])
        }
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_continue_statement(mutable this, node: ref[AstNode])
        this.emit_break_or_continue_statement(node, KindContinueKeyword)

    procedure emit_break_statement(mutable this, node: ref[AstNode])
        this.emit_break_or_continue_statement(node, KindBreakKeyword)

    procedure emit_return_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindReturnKeyword, node.pos, WriteKindKeyword, node)
        let expression Printer.statement_expression_of(node)
        if expression <> null
        {
            this.write_space()
            this.emit_expression_no_asi(expression as ref[AstNode], OperatorPrecedenceLowest)
        }
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_with_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let pos this.emit_token(KindWithKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_token(KindOpenParenToken, pos, WriteKindPunctuation, node)
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        this.emit_expression(expression, OperatorPrecedenceLowest)
        this.emit_token(KindCloseParenToken, expression.end, WriteKindPunctuation, node)
        this.emit_embedded_statement(node, Printer.statement_body_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_switch_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let pos this.emit_token(KindSwitchKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_token(KindOpenParenToken, pos, WriteKindPunctuation, node)
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        this.emit_expression(expression, OperatorPrecedenceLowest)
        this.emit_token(KindCloseParenToken, expression.end, WriteKindPunctuation, node)
        this.write_space()
        this.emit_case_block(AstNode.case_block_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_labeled_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let label_node AstNode.label_name_of(node) as ref[AstNode]
        this.emit_label_identifier(label_node)
        this.emit_token(KindColonToken, label_node.end, WriteKindPunctuation, node)
        ; writeSpace + emitStatement rather than emitEmbeddedStatement (the reference's TODO)
        this.write_space()
        this.emit_statement(Printer.statement_body_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_throw_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindThrowKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_expression_no_asi(Printer.statement_expression_of(node) as ref[AstNode], OperatorPrecedenceLowest)
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_try_statement(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindTryKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        let try_block AstNode.try_block_of(node) as ref[AstNode]
        this.emit_block(try_block)
        let catch_clause AstNode.catch_clause_of(node)
        if catch_clause <> null
        {
            this.write_line_or_space(node, try_block, catch_clause as ref[AstNode])
            this.emit_catch_clause(catch_clause as ref[AstNode])
        }
        let finally_block AstNode.finally_block_of(node)
        if finally_block <> null
        {
            var before try_block
            if catch_clause <> null
                set before: catch_clause as ref[AstNode]
            this.write_line_or_space(node, before, finally_block as ref[AstNode])
            this.emit_token(KindFinallyKeyword, before.end, WriteKindKeyword, node)
            this.write_space()
            this.emit_block(finally_block as ref[AstNode])
        }
        this.exit_node(node, state)
    }

    procedure emit_debugger_statement(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindDebuggerKeyword, node.pos, WriteKindKeyword, node)
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_not_emitted_statement(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.exit_node(node, state)
    }

    procedure emit_not_emitted_type_element(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.exit_node(node, state)
    }

    ; ── declarations ──

    procedure emit_variable_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let name Printer.declaration_name_of(node) as ref[AstNode]
        this.emit_binding_name(name)
        this.emit_punctuation_node(AstNode.exclamation_token_of(node))
        this.emit_type_annotation(AstNode.type_of(node))
        var pos name.end
        set pos: (Printer.greatest_end_node(pos, AstNode.type_of(node))) as i32
        set pos: (Printer.greatest_end_node(pos, context.get_type_node(name))) as i32
        this.emit_initializer(AstNode.initializer_of(node), pos, node)
        this.exit_node(node, state)
    }

    procedure emit_variable_declaration_node(mutable this, mutable node: ref[AstNode])
        this.emit_variable_declaration(node)

    procedure emit_variable_declaration_list(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let scoped node.flags & NodeFlagsBlockScoped
        if scoped = NodeFlagsLet
            this.write_keyword("let")
        else
        {
            if scoped = NodeFlagsConst
                this.write_keyword("const")
            else
            {
                if scoped = NodeFlagsUsing
                    this.write_keyword("using")
                else
                {
                    if scoped = NodeFlagsAwaitUsing
                    {
                        this.write_keyword("await")
                        this.write_space()
                        this.write_keyword("using")
                    }
                    else
                        this.write_keyword("var")
                }
            }
        }
        this.write_space()
        this.emit_list(EmitTagVariableDeclarationNode, node, Printer.declarations_of(node), LFVariableDeclarationList)
        this.exit_node(node, state)
    }

    procedure emit_function_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let name Printer.declaration_name_of(node)
        this.generate_name_if_needed(name)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.write_keyword("function")
        this.emit_token_node(AstNode.asterisk_token_of(node))
        this.write_space()
        if name <> null
            this.emit_identifier_name(name as ref[AstNode])
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.push_name_generation_scope(node)
        this.emit_signature(node)
        this.emit_function_body_node(AstNode.body_of(node))
        this.pop_name_generation_scope(node)
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_class_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let name Printer.declaration_name_of(node)
        this.generate_name_if_needed(name)
        let pos this.emit_modifier_list(node, Printer.modifier_list_of(node), true)
        this.emit_token(KindClassKeyword, pos, WriteKindKeyword, node)
        if name <> null
        {
            this.write_space()
            this.emit_identifier_name(name as ref[AstNode])
        }
        let indented this.should_emit_indented(node)
        this.increase_indent_if(indented)
        this.emit_type_parameters(node, AstNode.type_parameters_of(node))
        this.emit_list(EmitTagHeritageClauseNode, node, AstNode.heritage_clauses_of(node), LFClassHeritageClauses)
        this.write_space()
        this.write_punctuation("{")
        this.push_name_generation_scope(node)
        let members Printer.member_list_of(node)
        this.generate_all_member_names(members)
        this.emit_list(EmitTagClassElement, node, members, LFClassMembers)
        this.pop_name_generation_scope(node)
        this.write_punctuation("}")
        this.decrease_indent_if(indented)
        this.exit_node(node, state)
    }

    procedure emit_interface_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.write_keyword("interface")
        this.write_space()
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        this.emit_type_parameters(node, AstNode.type_parameters_of(node))
        this.emit_list(EmitTagHeritageClauseNode, node, AstNode.heritage_clauses_of(node), LFHeritageClauses)
        this.write_space()
        this.write_punctuation("{")
        this.push_name_generation_scope(node)
        let members Printer.member_list_of(node)
        this.generate_all_member_names(members)
        this.emit_list(EmitTagTypeElement, node, members, LFInterfaceMembers)
        this.pop_name_generation_scope(node)
        this.write_punctuation("}")
        this.exit_node(node, state)
    }

    procedure emit_type_alias_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.write_keyword("type")
        this.write_space()
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        this.emit_type_parameters(node, AstNode.type_parameters_of(node))
        this.write_space()
        this.write_punctuation("=")
        this.write_space()
        this.emit_type_node_outside_extends(AstNode.type_of(node) as ref[AstNode])
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_enum_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.write_keyword("enum")
        this.write_space()
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        this.write_space()
        this.write_punctuation("{")
        this.emit_list(EmitTagEnumMemberNode, node, Printer.member_list_of(node), LFEnumMembers)
        this.write_punctuation("}")
        this.exit_node(node, state)
    }

    procedure emit_module_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        let keyword AstNode.module_keyword_of(node)
        if keyword <> KindGlobalKeyword
        {
            if keyword = KindNamespaceKeyword
                this.write_keyword("namespace")
            else
                this.write_keyword("module")
            this.write_space()
        }
        this.emit_module_name(Printer.declaration_name_of(node))
        var body Printer.module_body_of(node)
        while body <> null
        {
            let b body as ref[AstNode]
            if b.kind <> KindModuleDeclaration
                break
            this.write_punctuation(".")
            this.emit_nested_module_name(Printer.declaration_name_of(b))
            set body: Printer.module_body_of(b)
        }
        if body = null
            this.write_trailing_semicolon()
        else
        {
            this.write_space()
            this.emit_module_block(body as ref[AstNode])
        }
        this.exit_node(node, state)
    }

    procedure emit_module_block(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.generate_names(node)
        this.emit_token(KindOpenBraceToken, node.pos, WriteKindPunctuation, node)
        let statements AstNode.statements_of(node)
        var format LFMultiLineBlockStatements
        if this.is_empty_block(node, statements) or this.should_emit_on_single_line(node)
            set format: LFSingleLineBlockStatements
        this.emit_list(EmitTagStatement, node, statements, format)
        var sp 0 - 1
        var se 0 - 1
        this.list_range(statements, &sp, &se)
        ; ★ A MISSING statement list is the parser's one shared sentinel, so it
        ; carries no range of its own (the reference gives each missing list the
        ; range [nodePos, nodePos) at the site). A block finished at that same
        ; position, so the block's END is exactly the list's end — and it is what
        ; the trailing-comment scan after the `}` has to start from (a `try { };
        ; // comment` printed the comment inside the missing finally block but
        ; not after its brace until this fallback, slice 236).
        if se < 0
        {
            ; only the EMPTY missing list takes the block's end: a list a
            ; transformer rebuilt carries no range (the reference's NewNodeList has
            ; none) and its brace takes no comments, as the reference's does
            ; (slice 250 — a namespace's trailing `/** */` was printed inside)
            var sn 0
            if statements <> null
                set sn: (statements as ref[Array[ref[AstNode]?]]).get_length() as int
            if sn = 0
                set se: node.end
        }
        var flags TefNone
        if (format & LFMultiLine) <> 0
            set flags: TefIndentLeadingComments
        this.emit_token_ex(KindCloseBraceToken, se, WriteKindPunctuation, node, flags)
        this.exit_node(node, state)
    }

    procedure emit_case_block(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindOpenBraceToken, node.pos, WriteKindPunctuation, node)
        let clauses Printer.case_block_clauses_of(node)
        this.emit_list(EmitTagCaseOrDefaultClauseNode, node, clauses, LFCaseBlockClauses)
        var cp 0 - 1
        var ce 0 - 1
        this.list_range(clauses, &cp, &ce)
        if ce < 0
        {
            var cn 0
            if clauses <> null
                set cn: (clauses as ref[Array[ref[AstNode]?]]).get_length() as int
            if cn = 0
                set ce: node.end
        }
        this.emit_token_ex(KindCloseBraceToken, ce, WriteKindPunctuation, node, TefIndentLeadingComments)
        this.exit_node(node, state)
    }

    procedure emit_import_equals_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        let pos this.emit_token(KindImportKeyword, this.greatest_end_list(node.pos, Printer.modifier_list_of(node)), WriteKindKeyword, node)
        this.write_space()
        if AstNode.is_type_only_of(node)
        {
            this.emit_token(KindTypeKeyword, pos, WriteKindKeyword, node)
            this.write_space()
        }
        let name Printer.declaration_name_of(node) as ref[AstNode]
        this.emit_binding_identifier(name)
        this.write_space()
        this.emit_token(KindEqualsToken, name.end, WriteKindPunctuation, node)
        this.write_space()
        this.emit_module_reference(AstNode.module_reference_of(node) as ref[AstNode])
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_module_reference(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindIdentifier
        {
            this.emit_identifier_reference(node)
            return
        }
        if k = KindQualifiedName
        {
            this.emit_qualified_name(node)
            return
        }
        if k = KindExternalModuleReference
        {
            this.emit_external_module_reference(node)
            return
        }
        this.record_unported("emit-module-reference-kind", k)
    }

    procedure emit_import_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        this.emit_token(KindImportKeyword, this.greatest_end_list(node.pos, Printer.modifier_list_of(node)), WriteKindKeyword, node)
        this.write_space()
        let import_clause AstNode.import_clause_of(node)
        if import_clause <> null
        {
            let ic import_clause as ref[AstNode]
            this.emit_import_clause(ic)
            this.write_space()
            this.emit_token(KindFromKeyword, ic.end, WriteKindKeyword, node)
            this.write_space()
        }
        this.emit_expression(AstNode.module_specifier_of(node) as ref[AstNode], OperatorPrecedenceLowest)
        let attributes AstNode.import_attributes_of(node)
        if attributes <> null
        {
            this.write_space()
            this.emit_import_attributes(attributes as ref[AstNode])
        }
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_import_clause(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let phase_modifier AstNode.import_clause_phase_modifier_of(node)
        if phase_modifier <> KindUnknown
        {
            this.emit_token(phase_modifier, node.pos, WriteKindKeyword, node)
            this.write_space()
        }
        let name Printer.declaration_name_of(node)
        let named_bindings AstNode.named_bindings_of(node)
        if name <> null
        {
            let n name as ref[AstNode]
            this.emit_binding_identifier(n)
            if named_bindings <> null
            {
                this.emit_token(KindCommaToken, n.end, WriteKindPunctuation, node)
                this.write_space()
            }
        }
        this.emit_named_import_bindings(named_bindings)
        this.exit_node(node, state)
    }

    procedure emit_namespace_import(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let pos this.emit_token(KindAsteriskToken, node.pos, WriteKindPunctuation, node)
        this.write_space()
        this.emit_token(KindAsKeyword, pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_named_imports(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("{")
        this.emit_list(EmitTagImportSpecifierNode, node, AstNode.elements_of(node), LFNamedImportsOrExportsElements)
        this.write_punctuation("}")
        this.exit_node(node, state)
    }

    procedure emit_named_import_bindings(mutable this, mutable node: ref[AstNode]?)
    {
        if node = null
            return
        let n node as ref[AstNode]
        if n.kind = KindNamespaceImport
        {
            this.emit_namespace_import(n)
            return
        }
        if n.kind = KindNamedImports
        {
            this.emit_named_imports(n)
            return
        }
        this.record_unported("emit-named-import-bindings-kind", n.kind)
    }

    procedure emit_import_specifier(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        if Printer.specifier_is_type_only_of(node)
        {
            this.write_keyword("type")
            this.write_space()
        }
        let property_name AstNode.property_name_of(node)
        if property_name <> null
        {
            this.emit_module_export_name(property_name)
            this.write_space()
            this.emit_token(KindAsKeyword, (property_name as ref[AstNode]).end, WriteKindKeyword, node)
            this.write_space()
        }
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_import_specifier_node(mutable this, mutable node: ref[AstNode])
        this.emit_import_specifier(node)

    procedure emit_export_assignment(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let next_pos this.emit_token(KindExportKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        let is_export_equals AstNode.is_export_equals_of(node)
        if is_export_equals
            this.emit_token(KindEqualsToken, next_pos, WriteKindOperator, node)
        else
            this.emit_token(KindDefaultKeyword, next_pos, WriteKindKeyword, node)
        this.write_space()
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        if is_export_equals
            this.emit_expression(expression, OperatorPrecedenceAssignment)
        else
        {
            ; `class` and `function` expressions are parenthesized against the declarations
            let leftmost_kind Printer.get_leftmost_expression(expression, false).kind
            if (leftmost_kind = KindClassExpression) or (leftmost_kind = KindFunctionExpression)
                this.emit_expression(expression, OperatorPrecedenceParentheses)
            else
                this.emit_expression(expression, OperatorPrecedenceAssignment)
        }
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_export_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_modifier_list(node, Printer.modifier_list_of(node), false)
        var pos this.emit_token(KindExportKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        if AstNode.is_type_only_of(node)
        {
            set pos: this.emit_token(KindTypeKeyword, pos, WriteKindKeyword, node)
            this.write_space()
        }
        let export_clause AstNode.export_clause_of(node)
        if export_clause <> null
            this.emit_named_export_bindings(export_clause as ref[AstNode])
        else
            set pos: this.emit_token(KindAsteriskToken, pos, WriteKindPunctuation, node)
        let module_specifier AstNode.module_specifier_of(node)
        if module_specifier <> null
        {
            this.write_space()
            this.emit_token(KindFromKeyword, Printer.greatest_end_node(pos, export_clause), WriteKindKeyword, node)
            this.write_space()
            this.emit_expression(module_specifier as ref[AstNode], OperatorPrecedenceLowest)
        }
        let attributes AstNode.import_attributes_of(node)
        if attributes <> null
        {
            this.write_space()
            this.emit_import_attributes(attributes as ref[AstNode])
        }
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_import_attributes(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(AstNode.import_attributes_token_of(node), node.pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_list(EmitTagImportAttributeNode, node, AstNode.import_attribute_list_of(node), LFImportAttributes)
        this.exit_node(node, state)
    }

    procedure emit_import_attribute(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_import_attribute_name(Printer.declaration_name_of(node) as ref[AstNode])
        this.write_punctuation(":")
        this.write_space()
        let value AstNode.import_attribute_value_of(node) as ref[AstNode]
        if (context.emit_flags(value) & EFNoLeadingComments) = 0
        {
            let comment_range context.comment_range(value)
            this.emit_trailing_comments(comment_range.pos, CommentSeparatorAfter)
        }
        this.emit_expression(value, OperatorPrecedenceDisallowComma)
        this.exit_node(node, state)
    }

    procedure emit_namespace_export_declaration(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        var pos this.emit_token(KindExportKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        set pos: this.emit_token(KindAsKeyword, pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_token(KindNamespaceKeyword, pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_binding_identifier(Printer.declaration_name_of(node) as ref[AstNode])
        this.write_trailing_semicolon()
        this.exit_node(node, state)
    }

    procedure emit_namespace_export(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        let pos this.emit_token(KindAsteriskToken, node.pos, WriteKindPunctuation, node)
        this.write_space()
        this.emit_token(KindAsKeyword, pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_module_export_name(Printer.declaration_name_of(node))
        this.exit_node(node, state)
    }

    procedure emit_named_exports(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("{")
        this.emit_list(EmitTagExportSpecifierNode, node, AstNode.elements_of(node), LFNamedImportsOrExportsElements)
        this.write_punctuation("}")
        this.exit_node(node, state)
    }

    procedure emit_named_export_bindings(mutable this, mutable node: ref[AstNode])
    {
        if node.kind = KindNamespaceExport
        {
            this.emit_namespace_export(node)
            return
        }
        if node.kind = KindNamedExports
        {
            this.emit_named_exports(node)
            return
        }
        this.record_unported("emit-named-export-bindings-kind", node.kind)
    }

    procedure emit_export_specifier(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        if Printer.specifier_is_type_only_of(node)
        {
            this.write_keyword("type")
            this.write_space()
        }
        let property_name AstNode.property_name_of(node)
        if property_name <> null
        {
            this.emit_module_export_name(property_name)
            this.write_space()
            this.emit_token(KindAsKeyword, (property_name as ref[AstNode]).end, WriteKindKeyword, node)
            this.write_space()
        }
        this.emit_module_export_name(Printer.declaration_name_of(node))
        this.exit_node(node, state)
    }

    procedure emit_export_specifier_node(mutable this, node: ref[AstNode])
        this.emit_export_specifier(node)

    procedure emit_embedded_statement(mutable this, parent_node: ref[AstNode], mutable node: ref[AstNode])
    {
        var inline node.kind = KindBlock
        if this.should_emit_on_single_line(parent_node)
            set inline: true
        if options.preserve_source_newlines
        {
            if this.get_leading_line_terminator_count(parent_node, node, LFNone) = 0
                set inline: true
        }
        if inline
        {
            this.write_space()
            this.emit_statement(node)
            return
        }
        this.write_line()
        this.increase_indent()
        if node.kind = KindEmptyStatement
            this.emit_empty_statement(node, true)
        else
            this.emit_statement(node)
        this.decrease_indent()
    }

    procedure emit_statement(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindBlock
        {
            this.emit_block(node)
            return
        }
        if k = KindEmptyStatement
        {
            this.emit_empty_statement(node, false)
            return
        }
        if k = KindVariableStatement
        {
            this.emit_variable_statement(node)
            return
        }
        if k = KindExpressionStatement
        {
            this.emit_expression_statement(node)
            return
        }
        if k = KindIfStatement
        {
            this.emit_if_statement(node)
            return
        }
        if k = KindDoStatement
        {
            this.emit_do_statement(node)
            return
        }
        if k = KindWhileStatement
        {
            this.emit_while_statement(node)
            return
        }
        if k = KindForStatement
        {
            this.emit_for_statement(node)
            return
        }
        if k = KindForInStatement
        {
            this.emit_for_in_statement(node)
            return
        }
        if k = KindForOfStatement
        {
            this.emit_for_of_statement(node)
            return
        }
        if k = KindContinueStatement
        {
            this.emit_continue_statement(node)
            return
        }
        if k = KindBreakStatement
        {
            this.emit_break_statement(node)
            return
        }
        if k = KindReturnStatement
        {
            this.emit_return_statement(node)
            return
        }
        if k = KindWithStatement
        {
            this.emit_with_statement(node)
            return
        }
        if k = KindSwitchStatement
        {
            this.emit_switch_statement(node)
            return
        }
        if k = KindLabeledStatement
        {
            this.emit_labeled_statement(node)
            return
        }
        if k = KindThrowStatement
        {
            this.emit_throw_statement(node)
            return
        }
        if k = KindTryStatement
        {
            this.emit_try_statement(node)
            return
        }
        if k = KindDebuggerStatement
        {
            this.emit_debugger_statement(node)
            return
        }
        if k = KindNotEmittedStatement
        {
            this.emit_not_emitted_statement(node)
            return
        }
        if k = KindFunctionDeclaration
        {
            this.emit_function_declaration(node)
            return
        }
        if k = KindClassDeclaration
        {
            this.emit_class_declaration(node)
            return
        }
        if k = KindInterfaceDeclaration
        {
            this.emit_interface_declaration(node)
            return
        }
        if (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration)
        {
            this.emit_type_alias_declaration(node)
            return
        }
        if k = KindEnumDeclaration
        {
            this.emit_enum_declaration(node)
            return
        }
        if k = KindModuleDeclaration
        {
            this.emit_module_declaration(node)
            return
        }
        if k = KindMissingDeclaration
        {
            return
        }
        if k = KindNamespaceExportDeclaration
        {
            this.emit_namespace_export_declaration(node)
            return
        }
        if k = KindImportEqualsDeclaration
        {
            this.emit_import_equals_declaration(node)
            return
        }
        if k = KindImportDeclaration
        {
            this.emit_import_declaration(node)
            return
        }
        if k = KindExportAssignment
        {
            this.emit_export_assignment(node)
            return
        }
        if k = KindExportDeclaration
        {
            this.emit_export_declaration(node)
            return
        }
        ; the reference PANICS ("unhandled statement")
        this.record_unported("emit-statement-kind", k)
    }

    ; ── module references ──

    procedure emit_external_module_reference(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_keyword("require")
        this.write_punctuation("(")
        this.emit_expression(Printer.statement_expression_of(node) as ref[AstNode], OperatorPrecedenceDisallowComma)
        this.write_punctuation(")")
        this.exit_node(node, state)
    }

    ; ── JSX ──

    procedure emit_jsx_element(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_jsx_opening_element(AstNode.jsx_element_opening_of(node) as ref[AstNode])
        this.emit_list(EmitTagJsxChild, node, AstNode.jsx_children_of(node), LFJsxElementOrFragmentChildren)
        this.emit_jsx_closing_element(AstNode.jsx_element_closing_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_jsx_self_closing_element(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("<")
        this.emit_jsx_tag_name(AstNode.jsx_tag_name_of(node) as ref[AstNode])
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        this.write_space()
        this.emit_jsx_attributes(AstNode.jsx_attributes_of(node) as ref[AstNode])
        this.write_punctuation("/>")
        this.exit_node(node, state)
    }

    procedure emit_jsx_fragment(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_jsx_opening_fragment(AstNode.jsx_fragment_opening_of(node) as ref[AstNode])
        this.emit_list(EmitTagJsxChild, node, AstNode.jsx_children_of(node), LFJsxElementOrFragmentChildren)
        this.emit_jsx_closing_fragment(AstNode.jsx_fragment_closing_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_jsx_opening_element(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("<")
        let tag_name AstNode.jsx_tag_name_of(node) as ref[AstNode]
        let indented this.write_line_separators_and_indent_before(tag_name, node)
        this.emit_jsx_tag_name(tag_name)
        this.emit_type_arguments(node, AstNode.type_arguments_of(node))
        let attributes AstNode.jsx_attributes_of(node) as ref[AstNode]
        let properties AstNode.properties_of(attributes)
        if properties <> null
        {
            if ((properties as ref[Array[ref[AstNode]?]]).get_length() as int) > 0
                this.write_space()
        }
        this.emit_jsx_attributes(attributes)
        this.write_line_separators_after(attributes, node)
        this.decrease_indent_if(indented)
        this.write_punctuation(">")
        this.exit_node(node, state)
    }

    procedure emit_jsx_closing_element(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("</")
        this.emit_jsx_tag_name(AstNode.jsx_tag_name_of(node) as ref[AstNode])
        this.write_punctuation(">")
        this.exit_node(node, state)
    }

    procedure emit_jsx_opening_fragment(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("<")
        this.write_punctuation(">")
        this.exit_node(node, state)
    }

    procedure emit_jsx_closing_fragment(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("</")
        this.write_punctuation(">")
        this.exit_node(node, state)
    }

    procedure emit_jsx_text(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_literal(AstNode.jsx_text_text_of(node))
        this.exit_node(node, state)
    }

    procedure emit_jsx_attributes(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_list(EmitTagJsxAttributeLike, node, AstNode.properties_of(node), LFJsxElementAttributes)
        this.exit_node(node, state)
    }

    procedure emit_jsx_attribute(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_jsx_attribute_name(Printer.declaration_name_of(node) as ref[AstNode])
        let initializer AstNode.initializer_of(node)
        if initializer <> null
        {
            this.write_punctuation("=")
            this.emit_jsx_attribute_value(initializer as ref[AstNode])
        }
        this.exit_node(node, state)
    }

    procedure emit_jsx_spread_attribute(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_punctuation("{...")
        this.emit_expression(Printer.statement_expression_of(node) as ref[AstNode], OperatorPrecedenceLowest)
        this.write_punctuation("}")
        this.exit_node(node, state)
    }

    procedure emit_jsx_attribute_like(mutable this, mutable node: ref[AstNode])
    {
        if node.kind = KindJsxAttribute
        {
            this.emit_jsx_attribute(node)
            return
        }
        if node.kind = KindJsxSpreadAttribute
        {
            this.emit_jsx_spread_attribute(node)
            return
        }
        this.record_unported("emit-jsx-attribute-like-kind", node.kind)
    }

    procedure emit_jsx_expression(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let expression Printer.statement_expression_of(node)
        ; an empty expression is kept when it carries comments
        var emit_it expression <> null
        if (emit_it = false) and (comments_disabled = false) and (Printer.node_is_synthesized(node) = false) and this.has_comments_at_position(node.pos)
            set emit_it: true
        if emit_it
        {
            var indented false
            if (current_source_file <> null) and (Printer.node_is_synthesized(node) = false)
            {
                if Printer.get_lines_between_positions(this.file_lines(), node.pos, node.end) <> 0
                    set indented: true
            }
            this.increase_indent_if(indented)
            let end this.emit_token(KindOpenBraceToken, node.pos, WriteKindPunctuation, node)
            let dot_dot_dot_token AstNode.dot_dot_dot_token_of(node)
            this.emit_token_node(dot_dot_dot_token)
            if expression <> null
                this.emit_expression(expression as ref[AstNode], OperatorPrecedenceDisallowComma)
            var close_pos Printer.greatest_end_node(end, expression)
            set close_pos: Printer.greatest_end_node(close_pos, dot_dot_dot_token)
            this.emit_token(KindCloseBraceToken, close_pos, WriteKindPunctuation, node)
            this.decrease_indent_if(indented)
        }
        this.exit_node(node, state)
    }

    procedure emit_jsx_namespaced_name(mutable this, node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_identifier_name(AstNode.namespaced_namespace_of(node) as ref[AstNode])
        this.write_punctuation(":")
        this.emit_identifier_name(AstNode.namespaced_name_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    procedure emit_jsx_child(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindJsxText
        {
            this.emit_jsx_text(node)
            return
        }
        if k = KindJsxExpression
        {
            this.emit_jsx_expression(node)
            return
        }
        if k = KindJsxElement
        {
            this.emit_jsx_element(node)
            return
        }
        if k = KindJsxSelfClosingElement
        {
            this.emit_jsx_self_closing_element(node)
            return
        }
        if k = KindJsxFragment
        {
            this.emit_jsx_fragment(node)
            return
        }
        this.record_unported("emit-jsx-child-kind", k)
    }

    procedure emit_jsx_tag_name(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindIdentifier
        {
            this.emit_identifier_reference(node)
            return
        }
        if k = KindThisKeyword
        {
            this.emit_keyword_expression(node)
            return
        }
        if k = KindJsxNamespacedName
        {
            this.emit_jsx_namespaced_name(node)
            return
        }
        if k = KindPropertyAccessExpression
        {
            this.emit_property_access_expression(node)
            return
        }
        this.record_unported("emit-jsx-tag-name-kind", k)
    }

    procedure emit_jsx_attribute_name(mutable this, node: ref[AstNode])
    {
        if node.kind = KindIdentifier
        {
            this.emit_identifier_name(node)
            return
        }
        if node.kind = KindJsxNamespacedName
        {
            this.emit_jsx_namespaced_name(node)
            return
        }
        this.record_unported("emit-jsx-attribute-name-kind", node.kind)
    }

    procedure emit_jsx_attribute_value(mutable this, mutable node: ref[AstNode])
    {
        let k node.kind
        if k = KindStringLiteral
        {
            this.emit_string_literal(node)
            return
        }
        if k = KindJsxExpression
        {
            this.emit_jsx_expression(node)
            return
        }
        if k = KindJsxElement
        {
            this.emit_jsx_element(node)
            return
        }
        if k = KindJsxSelfClosingElement
        {
            this.emit_jsx_self_closing_element(node)
            return
        }
        if k = KindJsxFragment
        {
            this.emit_jsx_fragment(node)
            return
        }
        this.emit_expression(node, OperatorPrecedenceLowest)
    }

    ; ── clauses ──

    procedure emit_case_or_default_clause_statements(mutable this, mutable node: ref[AstNode], colon_pos: int)
    {
        let statements AstNode.statements_of(node)
        var n 0
        var first: ref[AstNode]? null
        if statements <> null
        {
            let st statements as ref[Array[ref[AstNode]?]]
            set n: st.get_length() as int
            if n > 0
                set first: st[0]
        }
        ; a synthesized node counts as being on the same line
        var emit_as_single_statement false
        if n = 1
        {
            let f first as ref[AstNode]
            if (current_source_file = null) or Printer.node_is_synthesized(node) or Printer.node_is_synthesized(f)
                set emit_as_single_statement: true
            else
            {
                let csf current_source_file as ref[SourceFileInfo]
                if Printer.range_start_positions_are_on_same_line(TextRange.of_node(node), TextRange.of_node(f), csf.text, csf.line_starts)
                    set emit_as_single_statement: true
            }
        }
        var format LFCaseOrDefaultClauseStatements
        if emit_as_single_statement
        {
            ; the colon WITHOUT comments, or the statement list would repeat them
            this.write_token_text(KindColonToken, WriteKindPunctuation, colon_pos)
            this.write_space()
            set format: format & (0 - 1 - (LFMultiLine | LFIndented))
        }
        else
            this.emit_token(KindColonToken, colon_pos, WriteKindPunctuation, node)
        this.emit_list(EmitTagStatement, node, statements, format)
    }

    procedure emit_case_clause(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_token(KindCaseKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        let expression Printer.statement_expression_of(node) as ref[AstNode]
        this.emit_expression(expression, OperatorPrecedenceLowest)
        this.emit_case_or_default_clause_statements(node, expression.end)
        this.exit_node(node, state)
    }

    procedure emit_default_clause(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let pos this.emit_token(KindDefaultKeyword, node.pos, WriteKindKeyword, node)
        this.emit_case_or_default_clause_statements(node, pos)
        this.exit_node(node, state)
    }

    procedure emit_case_or_default_clause_node(mutable this, mutable node: ref[AstNode])
    {
        if node.kind = KindCaseClause
        {
            this.emit_case_clause(node)
            return
        }
        if node.kind = KindDefaultClause
        {
            this.emit_default_clause(node)
            return
        }
        this.record_unported("emit-case-or-default-clause-kind", node.kind)
    }

    procedure emit_heritage_clause(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.write_space()
        this.emit_token(AstNode.heritage_clause_token_of(node), node.pos, WriteKindKeyword, node)
        this.write_space()
        this.emit_list(EmitTagExpressionWithTypeArgumentsNode, node, AstNode.heritage_clause_types_of(node), LFHeritageClauseTypes)
        this.exit_node(node, state)
    }

    procedure emit_catch_clause(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let open_paren_pos this.emit_token(KindCatchKeyword, node.pos, WriteKindKeyword, node)
        this.write_space()
        let variable_declaration Printer.catch_variable_declaration_of(node)
        if variable_declaration <> null
        {
            let vd variable_declaration as ref[AstNode]
            this.emit_token(KindOpenParenToken, open_paren_pos, WriteKindPunctuation, node)
            this.emit_variable_declaration(vd)
            this.emit_token(KindCloseParenToken, vd.end, WriteKindPunctuation, node)
            this.write_space()
        }
        this.emit_block(Printer.catch_block_of(node) as ref[AstNode])
        this.exit_node(node, state)
    }

    ; ── property assignments ──

    procedure emit_property_assignment(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_property_name(Printer.declaration_name_of(node))
        this.write_punctuation(":")
        this.write_space()
        ; `id: /*comment1*/ () => void`: comment1 is a TRAILING comment of the
        ; previous node, not a leading one of the initializer
        let initializer AstNode.initializer_of(node) as ref[AstNode]
        if (context.emit_flags(initializer) & EFNoLeadingComments) = 0
        {
            let comment_range context.comment_range(initializer)
            this.emit_trailing_comments(comment_range.pos, CommentSeparatorAfter)
        }
        this.emit_expression(initializer, OperatorPrecedenceDisallowComma)
        this.exit_node(node, state)
    }

    procedure emit_shorthand_property_assignment(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        this.emit_property_name(Printer.declaration_name_of(node))
        let initializer AstNode.shorthand_object_assignment_initializer_of(node)
        if initializer <> null
        {
            this.write_space()
            this.write_punctuation("=")
            this.write_space()
            this.emit_expression(initializer as ref[AstNode], OperatorPrecedenceDisallowComma)
        }
        this.exit_node(node, state)
    }

    procedure emit_spread_assignment(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let expression AstNode.expression_of(node)
        if expression <> null
        {
            this.emit_token(KindDotDotDotToken, node.pos, WriteKindPunctuation, node)
            this.emit_expression(expression as ref[AstNode], OperatorPrecedenceDisallowComma)
        }
        this.exit_node(node, state)
    }

    ; ── enum ──

    procedure emit_enum_member(mutable this, mutable node: ref[AstNode])
    {
        let state this.enter_node(node)
        let name Printer.declaration_name_of(node) as ref[AstNode]
        this.emit_property_name(name)
        this.emit_initializer(AstNode.initializer_of(node), name.end, node)
        this.exit_node(node, state)
    }

    procedure emit_enum_member_node(mutable this, mutable node: ref[AstNode])
        this.emit_enum_member(node)

    ; ── JSDoc ──

    ; the reference PANICS ("not implemented")
    procedure emit_jsdoc_node(mutable this, node: ref[AstNode])
        this.record_unported("emit-jsdoc-node", node.kind)

    ; ── top-level ──

    procedure emit_shebang_if_needed(mutable this, node: ref[AstNode])
    {
        if Printer.node_is_synthesized(node)
            return
        let shebang Scanner.get_shebang(this.file_text())
        if (shebang.length as int) > 0
        {
            this.write_comment(shebang)
            this.write_line()
        }
    }

    procedure emit_source_file(mutable this, mutable node: ref[AstNode])
    {
        ; the reference sets currentSourceFile to the node; here the emitter has
        ; handed the file's record to write_node already (§3.40)
        if current_source_file = null
        {
            this.record_unported("emit-source-file-without-info", 0)
            return
        }
        let csf current_source_file as ref[SourceFileInfo]
        let saved_comments_disabled comments_disabled
        this.write_line()
        this.push_name_generation_scope(node)
        let statements AstNode.statements_of(node)
        this.generate_all_names(statements)
        var sp 0 - 1
        var se 0 - 1
        this.list_range(statements, &sp, &se)
        var index 0
        var state CommentState.none()
        if csf.script_kind <> ScriptKindJSON
        {
            this.emit_shebang_if_needed(node)
            set index: this.emit_prologue_directives(statements)
            if this.the_writer().is_at_start_of_line() = false
                this.write_line()
            set state: this.emit_detached_comments_before_statement_list(node, TextRange(sp, se))
            this.emit_helpers(node)
            if csf.is_declaration_file
                this.emit_triple_slash_directives(node)
        }
        else
            set state: this.emit_detached_comments_before_statement_list(node, TextRange(sp, se))
        this.emit_list_range(EmitTagStatement, node, statements, LFMultiLine, index, 0 - 1)
        this.pop_name_generation_scope(node)
        this.emit_detached_comments_after_statement_list(node, TextRange(sp, se), state)
        set this.comments_disabled: saved_comments_disabled
    }

    ; STOP: a declaration file's `/// <reference ...>` directives — the file's
    ; reference lists are not on SourceFileInfo yet, and the JS emit never
    ; prints a declaration file. Counted, never silent.
    ; emitTripleSlashDirectives (slice 250): the `path`, `types` and `lib`
    ; directives of a DECLARATION file — the ones the transformer keeps, which
    ; are exactly the `preserve="true"` ones the parser records
    ; (PreservedReference), in the reference's kind order. ★A `path` directive
    ; is rewritten by EXTENSION (`b.ts` → `b.d.ts`): the reference resolves the
    ; referenced file and takes its declaration output path relative to this
    ; output's directory, which coincides for a sibling file and differs under
    ; an outDir or a rootDir; the resolution is the program chapter's.
    procedure emit_triple_slash_directives(mutable this, node: ref[AstNode])
    {
        let refs AstNode.preserved_references_of(node)
        if refs = null
            return
        let list refs as ref[Array[PreservedReference]]
        var kind 0
        var path_index 0
        while kind < 3
        {
            var i 0
            while i < (list.get_length() as int)
            {
                let r list[i as size_t]
                var skip false
                var rewritten: Slice[char] ""
                var have_rewritten false
                if (r.kind = kind) and (kind = 0)
                {
                    if dts_reference_names <> null
                    {
                        let rn dts_reference_names as ref[Array[Slice[char]]]
                        if path_index < (rn.get_length() as int)
                        {
                            set rewritten: rn[path_index as size_t]
                            set have_rewritten: true
                            if rewritten.length = 0
                                set skip: true
                        }
                    }
                    set path_index: path_index + 1
                }
                if skip
                {
                    set i: i + 1
                    continue
                }
                if r.kind = kind
                {
                    let sb StringBuilder^host()
                    sb.append("/// <reference ")
                    if kind = 0
                        sb.append("path")
                    if kind = 1
                        sb.append("types")
                    if kind = 2
                        sb.append("lib")
                    sb.append("=\"")
                    var name r.name
                    if kind = 0
                    {
                        if have_rewritten
                            set name: rewritten
                        else
                            set name: Printer.declaration_path_name(host, name)
                    }
                    sb.append(name.data, name.length as size_t)
                    sb.append("\" ")
                    if r.resolution_mode = 1
                        sb.append("resolution-mode=\"import\" ")
                    if r.resolution_mode = 2
                        sb.append("resolution-mode=\"require\" ")
                    sb.append("preserve=\"true\" />")
                    this.write_comment(Printer.slice_on(host, sb.to_string()))
                    this.write_line()
                }
                set i: i + 1
            }
            set kind: kind + 1
        }
    }

    ; a referenced source's declaration output name, by extension
    function declaration_path_name(host: ref[Page], name_in: Slice[char]) returns Slice[char]
    {
        ; the reference's relative path carries no `./`
        var name name_in
        if name.starts_with("./")
            set name: name.slice_from(2)
        if name.ends_with(".d.ts") or name.ends_with(".d.mts") or name.ends_with(".d.cts")
            return name
        var ext: Slice[char] ".d.ts"
        var cut 0
        if name.ends_with(".tsx")
            set cut: 4
        if name.ends_with(".ts")
            set cut: 3
        if name.ends_with(".mts")
        {
            set cut: 4
            let dmts: Slice[char] ".d.mts"
            set ext: dmts
        }
        if name.ends_with(".cts")
        {
            set cut: 4
            let dcts: Slice[char] ".d.cts"
            set ext: dcts
        }
        if cut = 0
            return name
        let sb StringBuilder^host()
        sb.append(name.data, (name.length - cut) as size_t)
        sb.append(ext.data, ext.length as size_t)
        Printer.slice_on(host, sb.to_string())
    }




























































}

; lineCharacterCache — line and UTF-16 character of a byte position, cached for
; monotone positions (the source-map emit). Over a text and its line map.
define LineCharacterCache
(
    line_map: ref[Array[int]]
    text: Slice[char]
    cached_line: int
    cached_pos: int
    cached_char: int
    has_cached: bool
)
{
    function create(host: ref[Page], line_map: ref[Array[int]], text: Slice[char]) returns ref[LineCharacterCache]
        &LineCharacterCache^host(line_map, text, 0, 0, 0, false)

    function utf16_len_between(s: Slice[char], from: int, to: int) returns int
        TextWriter.utf16_len_of(s, from, to)

    procedure get_line_and_character(mutable this, pos: int, mutable out_line: ref[int], mutable out_character: ref[int])
    {
        let line Scanner.compute_line_of_position(line_map, pos)
        let line_start line_map[line as size_t]
        var end_pos pos
        if (text.length as int) < end_pos
            set end_pos: text.length as int
        var character 0
        var incremental false
        if has_cached
        {
            if line = cached_line
            {
                if end_pos >= cached_pos
                    set incremental: true
            }
        }
        if incremental
            set character: cached_char + LineCharacterCache.utf16_len_between(text, cached_pos, end_pos)
        else
            set character: LineCharacterCache.utf16_len_between(text, line_start, end_pos)
        let cached character
        set character: character + (pos - end_pos)
        set this.cached_line: line
        set this.cached_pos: end_pos
        set this.cached_char: cached
        set this.has_cached: true
        set out_line: line
        set out_character: character
    }
}

; ── helpers.go ──────────────────────────────────────────────────────────────
;
; EmitHelper. `priority` is -1 where the reference's pointer is nil; `text_kind`
; is 0 for a fixed text and 1 / 2 for the two scoped helpers whose text is a
; CALLBACK over makeUniqueName (async-super, advanced-async-super) — the printer
; renders those at the emit site (§3.18). The helpers are singletons in the
; reference; here they are made once per emit by `EmitHelpers.create`, so the
; identity comparisons the reference makes hold within one emit.
define EmitHelper
(
    name: Slice[char]
    scoped: bool
    text: Slice[char]
    text_kind: int
    priority: int
    dependencies: ref[Array[ref[EmitHelper]?]]?
    import_name: Slice[char]
)
{
    function make(host: ref[Page], name: Slice[char], scoped: bool, text: Slice[char], text_kind: int, priority: int, import_name: Slice[char]) returns ref[EmitHelper]
        &EmitHelper^host(name, scoped, text, text_kind, priority, null, import_name)

    ; compareEmitHelpers
    function compare(x: ref[EmitHelper], y: ref[EmitHelper]) returns int
    {
        if x = y
            return 0
        if x.priority = y.priority
            return 0
        if x.priority < 0
            return 1
        if y.priority < 0
            return 0 - 1
        x.priority - y.priority
    }
}

define EmitHelpers
(
    decorate_helper: ref[EmitHelper]
    metadata_helper: ref[EmitHelper]
    param_helper: ref[EmitHelper]
    add_disposable_resource_helper: ref[EmitHelper]
    dispose_resources_helper: ref[EmitHelper]
    class_private_field_get_helper: ref[EmitHelper]
    class_private_field_set_helper: ref[EmitHelper]
    class_private_field_in_helper: ref[EmitHelper]
    await_helper: ref[EmitHelper]
    async_generator_helper: ref[EmitHelper]
    async_delegator_helper: ref[EmitHelper]
    async_values_helper: ref[EmitHelper]
    rest_helper: ref[EmitHelper]
    awaiter_helper: ref[EmitHelper]
    async_super_helper: ref[EmitHelper]
    advanced_async_super_helper: ref[EmitHelper]
    es_decorate_helper: ref[EmitHelper]
    run_initializers_helper: ref[EmitHelper]
    make_template_object_helper: ref[EmitHelper]
    prop_key_helper: ref[EmitHelper]
    set_function_name_helper: ref[EmitHelper]
    create_binding_helper: ref[EmitHelper]
    set_module_default_helper: ref[EmitHelper]
    import_star_helper: ref[EmitHelper]
    import_default_helper: ref[EmitHelper]
    export_star_helper: ref[EmitHelper]
    rewrite_relative_import_extensions_helper: ref[EmitHelper]
)
{
    function create(host: ref[Page]) returns ref[EmitHelpers]
    {
        let decorate_helper EmitHelper.make(host, "typescript:decorate", false, "var __decorate = (this && this.__decorate) || function (decorators, target, key, desc) {\n    var c = arguments.length, r = c < 3 ? target : desc === null ? desc = Object.getOwnPropertyDescriptor(target, key) : desc, d;\n    if (typeof Reflect === \"object\" && typeof Reflect.decorate === \"function\") r = Reflect.decorate(decorators, target, key, desc);\n    else for (var i = decorators.length - 1; i >= 0; i--) if (d = decorators[i]) r = (c < 3 ? d(r) : c > 3 ? d(target, key, r) : d(target, key)) || r;\n    return c > 3 && r && Object.defineProperty(target, key, r), r;\n};", 0, 2, "__decorate")
        let metadata_helper EmitHelper.make(host, "typescript:metadata", false, "var __metadata = (this && this.__metadata) || function (k, v) {\n    if (typeof Reflect === \"object\" && typeof Reflect.metadata === \"function\") return Reflect.metadata(k, v);\n};", 0, 3, "__metadata")
