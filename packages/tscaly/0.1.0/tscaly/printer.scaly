; ── emitcontext.go (slice 232) ─────────────────────────────────────────────
;
; ★ IDENTITY. Every context has an id from a module counter, and a node's
; `emit_index` belongs to the context whose id it carries (AstNode's three emit
; slots): the reference pools and RESETS contexts, and a reset here is a new id,
; so a node's row from an earlier emit is not a row. The reference's six per-node
; maps (emitNodes, autoGenerate, textSource, original, assignedName, classThis)
; are ONE row per node here — `original` on the node itself, the other five as
; slots of EmitNode — because every one of them is keyed by the node and lives
; exactly as long as the context.
;
; ★ The `Visit` and hook FUNC VALUES the context hands a visitor are tags on the
; visitor (§3.18): `HooksTagEmitContext` routes the five hook methods here.
; Process-wide ID cells, handed out atomically: an emit context's identity and
; the reference's `nextAutoGenerateId` (an atomic.Uint32 upstream).
shared atomic next_emit_context_id: u64 1
shared atomic next_auto_generate_id: u64 0

; The hook tags of NodeVisitor (§3.39): declared HERE because printer precedes
; factory in module order and a constant is only visible from the module that
; declares it or a later one.
define HooksTagNone: int 0
define HooksTagEmitContext: int 1
define HooksTagDeepClone: int 2

define EnvironmentFlagsNone: int 0
define EnvironmentFlagsInParameters: int 1 << 0
define EnvironmentFlagsVariablesHoistedInParameters: int 1 << 1

define EmitNodeFlagsHasCommentRange: int 1 << 0
define EmitNodeFlagsHasSourceMapRange: int 1 << 1

; A synthesized comment: kind, a location (-1, -1 when synthetic), the two
; line-break flags and the text.
define SynthesizedComment
(
    kind: int
    pos: int
    end: int
    has_leading_new_line: bool
    has_trailing_new_line: bool
    text: Slice[char]
)

define TokenSourceMapRange
(
    kind: int
    pos: int
    end: int
)

define AutoGenerateInfo
(
    flags: int
    id: int
    prefix: Slice[char]
    suffix: Slice[char]
    node: ref[AstNode]?
)

; AutoGenerateOptions: the reference passes a struct by value; here three
; arguments (flags, prefix, suffix) at every call, because a record of two
; views and an int is what the struct is.

; emitNode plus the four per-node maps that share its lifetime.
define EmitNode
(
    flags: int
    emit_flags: int
    comment_pos: int
    comment_end: int
    source_map_pos: int
    source_map_end: int
    token_source_map_ranges: ref[Array[TokenSourceMapRange]]?
    helpers: ref[Array[ref[EmitHelper]?]]?
    external_helpers_module_name: ref[AstNode]?
    leading_comments: ref[Array[SynthesizedComment]]?
    trailing_comments: ref[Array[SynthesizedComment]]?
    type_node: ref[AstNode]?
    auto_generate: ref[AutoGenerateInfo]?
    text_source: ref[AstNode]?
    assigned_name: ref[AstNode]?
    class_this: ref[AstNode]?
)

define VarScope
(
    variables: ref[Array[ref[AstNode]?]]
    functions: ref[Array[ref[AstNode]?]]
    flags: int
    initialization_statements: ref[Array[ref[AstNode]?]]
)

define EmitContext
(
    host: ref[Page]
    id: int
    factory: ref[NodeFactory]?
    emit_nodes: ref[Array[ref[EmitNode]?]]
    var_scope_stack: ref[Array[ref[VarScope]?]]
    let_scope_stack: ref[Array[ref[VarScope]?]]
    ; The two stacks' DEPTHS: the Array has no pop (a push past the depth
    ; overwrites the slot a pop left behind).
    var_scope_depth: int
    let_scope_depth: int
    emit_helpers: ref[Array[ref[EmitHelper]?]]
    helpers: ref[EmitHelpers]
)
{
    procedure create(host: ref[Page], list_ranges: ref[Array[ListRange]]?) returns ref[EmitContext]
    {
        let rows &Array[ref[EmitNode]?]^host()
        let vs &Array[ref[VarScope]?]^host()
        let ls &Array[ref[VarScope]?]^host()
        let hs &Array[ref[EmitHelper]?]^host()
        let id scaly_atomic_add_u64(&next_emit_context_id, 1 as u64) as int
        let c &EmitContext^host(host, id, null, rows, vs, ls, 0, 0, hs, EmitHelpers.create(host))
        set c.factory: NodeFactory.create(host, c, list_ranges)
        c
    }

    ; Reset: a new identity (every row of the old one is unreachable by it),
    ; empty stacks, the factory kept.
    procedure reset(mutable this)
    {
        set this.id: scaly_atomic_add_u64(&next_emit_context_id, 1 as u64) as int
        set this.emit_nodes: &Array[ref[EmitNode]?]^host()
        set this.var_scope_stack: &Array[ref[VarScope]?]^host()
        set this.let_scope_stack: &Array[ref[VarScope]?]^host()
        set this.var_scope_depth: 0
        set this.let_scope_depth: 0
        set this.emit_helpers: &Array[ref[EmitHelper]?]^host()
    }

    function the_factory(this) returns ref[NodeFactory]
        factory as ref[NodeFactory]

    ; nextAutoGenerateId.Add(1) — the reference's process-wide counter.
    procedure next_auto_id(this) returns int
        (scaly_atomic_add_u64(&next_auto_generate_id, 1 as u64) + (1 as u64)) as int

    ; ── the factory hooks ──

    procedure on_create(this, mutable node: ref[AstNode])
        set node.flags: node.flags | NodeFlagsSynthesized

    procedure on_update(mutable this, mutable updated: ref[AstNode], original: ref[AstNode])
        this.set_original(updated, original)

    ; onClone: the original, and a COPY of an auto-generated name's info onto
    ; the clone (a clone of a generated identifier is the same generated name).
    procedure on_clone(mutable this, mutable updated: ref[AstNode], original: ref[AstNode])
    {
        this.set_original(updated, original)
        let k updated.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
        {
            let row this.try_get_emit_node(original)
            if row <> null
            {
                let info (row as ref[EmitNode]).auto_generate
                if info <> null
                {
                    let src info as ref[AutoGenerateInfo]
                    let copy &AutoGenerateInfo^host(src.flags, src.id, src.prefix, src.suffix, src.node)
                    set this.get_emit_node(updated).auto_generate: copy
                }
            }
        }
    }

    ; ── the emit-node rows ──

    function try_get_emit_node(this, node: ref[AstNode]) returns ref[EmitNode]?
    {
        if AstNode.emit_context_id_of(node) <> id
            return null
        let index AstNode.emit_index_of(node)
        if index <= 0
            return null
        emit_nodes[(index - 1) as size_t]
    }

    procedure get_emit_node(mutable this, mutable node: ref[AstNode]) returns ref[EmitNode]
    {
        let existing this.try_get_emit_node(node)
        if existing <> null
            return existing as ref[EmitNode]
        let row &EmitNode^host(0, EFNone, 0, 0, 0, 0, null, null, null, null, null, null, null, null, null, null)
        emit_nodes.add(row)
        AstNode.set_emit_slot(node, emit_nodes.get_length() as int, id)
        row
    }

    function has_emit_node(this, node: ref[AstNode]) returns bool
        this.try_get_emit_node(node) <> null

    ; emitNode.copyFrom: the flags, both ranges, the token ranges, the helpers
    ; and the external helpers name — not the comments, not the type node.
    procedure copy_emit_node(this, mutable to: ref[EmitNode], from: ref[EmitNode])
    {
        set to.flags: from.flags
        set to.emit_flags: from.emit_flags
        set to.comment_pos: from.comment_pos
        set to.comment_end: from.comment_end
        set to.source_map_pos: from.source_map_pos
        set to.source_map_end: from.source_map_end
        set to.token_source_map_ranges: null
        if from.token_source_map_ranges <> null
        {
            let src from.token_source_map_ranges as ref[Array[TokenSourceMapRange]]
            let copy &Array[TokenSourceMapRange]^host()
            var i 0
            while i < (src.get_length() as int)
            {
                copy.add(src[i as size_t])
                set i: i + 1
            }
            set to.token_source_map_ranges: copy
        }
        set to.helpers: null
        if from.helpers <> null
        {
            let src from.helpers as ref[Array[ref[EmitHelper]?]]
            let copy &Array[ref[EmitHelper]?]^host()
            var i 0
            while i < (src.get_length() as int)
            {
                copy.add(src[i as size_t])
                set i: i + 1
            }
            set to.helpers: copy
        }
        set to.external_helpers_module_name: from.external_helpers_module_name
    }

    ; ── the original chain ──

    procedure set_original(mutable this, mutable node: ref[AstNode], original: ref[AstNode])
        this.set_original_ex(node, original, false)

    procedure unset_original(this, mutable node: ref[AstNode])
        AstNode.set_original(node, null)

    ; SetOriginalEx. A first setting also copies the original's emit node; a
    ; second, different one without allowOverwrite is the reference's panic and
    ; this port's no-op (the first stands).
    procedure set_original_ex(mutable this, mutable node: ref[AstNode], original: ref[AstNode], allow_overwrite: bool)
    {
        if AstNode.original_of(node) = null
        {
            AstNode.set_original(node, original)
            let row this.try_get_emit_node(original)
            if row <> null
                this.copy_emit_node(this.get_emit_node(node), row as ref[EmitNode])
            return
        }
        if allow_overwrite
            AstNode.set_original(node, original)
    }

    function original(this, node: ref[AstNode]) returns ref[AstNode]?
        AstNode.original_of(node)

    function most_original(this, node_in: ref[AstNode]?) returns ref[AstNode]?
    {
        if node_in = null
            return null
        var node node_in as ref[AstNode]
        var original AstNode.original_of(node)
        while original <> null
        {
            set node: original as ref[AstNode]
            set original: AstNode.original_of(node)
        }
        node
    }

    ; ParseNode: the most original node when it is a parse-tree node.
    function parse_node(this, node_in: ref[AstNode]?) returns ref[AstNode]?
    {
        let node this.most_original(node_in)
        if node = null
            return null
        if ((node as ref[AstNode]).flags & NodeFlagsSynthesized) <> 0
            return null
        node
    }

    ; ── the variable and lexical environments ──

    function new_scope(this) returns ref[VarScope]
    {
        let vars &Array[ref[AstNode]?]^host()
        let fns &Array[ref[AstNode]?]^host()
        let inits &Array[ref[AstNode]?]^host()
        &VarScope^host(vars, fns, EnvironmentFlagsNone, inits)
    }

    function peek_var_scope(this) returns ref[VarScope]?
    {
        if var_scope_depth = 0
            return null
        var_scope_stack[(var_scope_depth - 1) as size_t]
    }

    function peek_let_scope(this) returns ref[VarScope]?
    {
        if let_scope_depth = 0
            return null
        let_scope_stack[(let_scope_depth - 1) as size_t]
    }

    procedure push_var_scope(mutable this)
    {
        let scope this.new_scope()
        if var_scope_depth < (var_scope_stack.get_length() as int)
            var_scope_stack.put(var_scope_depth as size_t, scope)
        else
            var_scope_stack.add(scope)
        set this.var_scope_depth: var_scope_depth + 1
    }

    procedure push_let_scope(mutable this)
    {
        let scope this.new_scope()
        if let_scope_depth < (let_scope_stack.get_length() as int)
            let_scope_stack.put(let_scope_depth as size_t, scope)
        else
            let_scope_stack.add(scope)
        set this.let_scope_depth: let_scope_depth + 1
    }

    procedure pop_var_scope(mutable this) returns ref[VarScope]
    {
        set this.var_scope_depth: var_scope_depth - 1
        var_scope_stack[var_scope_depth as size_t] as ref[VarScope]
    }

    procedure pop_let_scope(mutable this) returns ref[VarScope]
    {
        set this.let_scope_depth: let_scope_depth - 1
        let_scope_stack[let_scope_depth as size_t] as ref[VarScope]
    }

    procedure start_variable_environment(mutable this)
    {
        this.push_var_scope()
        this.start_lexical_environment()
    }

    ; EndVariableEnvironment: the hoisted functions, then one `var` statement
    ; over the hoisted variables (a custom prologue), then the initialization
    ; statements, then the lexical environment's.
    procedure end_variable_environment(mutable this) returns ref[Array[ref[AstNode]?]]
    {
        let scope this.pop_var_scope()
        let statements &Array[ref[AstNode]?]^host()
        var i 0
        while i < (scope.functions.get_length() as int)
        {
            statements.add(scope.functions[i as size_t])
            set i: i + 1
        }
        if (scope.variables.get_length() as int) > 0
        {
            let f this.the_factory()
            let var_decl_list f.new_variable_declaration_list(scope.variables, NodeFlagsNone)
            let var_statement f.new_variable_statement(null, var_decl_list)
            this.set_emit_flags(var_statement, EFCustomPrologue)
            statements.add(var_statement)
        }
        set i: 0
        while i < (scope.initialization_statements.get_length() as int)
        {
            statements.add(scope.initialization_statements[i as size_t])
            set i: i + 1
        }
        let lexical this.end_lexical_environment()
        set i: 0
        while i < (lexical.get_length() as int)
        {
            statements.add(lexical[i as size_t])
            set i: i + 1
        }
        statements
    }

    ; EndAndMergeVariableEnvironment(List): the statements with the environment's
    ; declarations merged in; the list keeps its extent when nothing changed.
    procedure end_and_merge_variable_environment(mutable this, statements: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        var changed false
        let result this.merge_environment(statements, this.end_variable_environment(), &changed)
        if changed
            return this.the_factory().new_node_list_like(result as ref[Array[ref[AstNode]?]], statements)
        statements
    }

    procedure add_variable_declaration(mutable this, mutable name: ref[AstNode])
    {
        let f this.the_factory()
        let var_decl f.new_variable_declaration(name, null, null, null)
        this.set_emit_flags(var_decl, EFNoNestedSourceMaps)
        let scope this.peek_var_scope() as ref[VarScope]
        scope.variables.add(var_decl)
        if (scope.flags & EnvironmentFlagsInParameters) <> 0
            set scope.flags: scope.flags | EnvironmentFlagsVariablesHoistedInParameters
    }

    procedure add_hoisted_function_declaration(mutable this, mutable node: ref[AstNode])
    {
        this.set_emit_flags(node, EFCustomPrologue)
        let scope this.peek_var_scope() as ref[VarScope]
        scope.functions.add(node)
    }

    procedure start_lexical_environment(mutable this)
        this.push_let_scope()

    procedure end_lexical_environment(mutable this) returns ref[Array[ref[AstNode]?]]
    {
        let scope this.pop_let_scope()
        let statements &Array[ref[AstNode]?]^host()
        if (scope.variables.get_length() as int) > 0
        {
            let f this.the_factory()
            let var_decl_list f.new_variable_declaration_list(scope.variables, NodeFlagsLet)
            let var_statement f.new_variable_statement(null, var_decl_list)
            this.set_emit_flags(var_statement, EFCustomPrologue)
            statements.add(var_statement)
        }
        statements
    }

    procedure end_and_merge_lexical_environment(mutable this, statements: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        var changed false
        let result this.merge_environment(statements, this.end_lexical_environment(), &changed)
        if changed
            return this.the_factory().new_node_list_like(result as ref[Array[ref[AstNode]?]], statements)
        statements
    }

    procedure add_lexical_declaration(mutable this, mutable name: ref[AstNode])
    {
        let f this.the_factory()
        let var_decl f.new_variable_declaration(name, null, null, null)
        this.set_emit_flags(var_decl, EFNoNestedSourceMaps)
        let scope this.peek_let_scope() as ref[VarScope]
        scope.variables.add(var_decl)
    }

    procedure merge_environment_list(mutable this, statements: ref[Array[ref[AstNode]?]]?, declarations: ref[Array[ref[AstNode]?]]) returns ref[Array[ref[AstNode]?]]?
    {
        var changed false
        let result this.merge_environment(statements, declarations, &changed)
        if changed
            return this.the_factory().new_node_list_like(result as ref[Array[ref[AstNode]?]], statements)
        statements
    }

    ; findSpanEnd over the four prologue predicates (§3.18: one loop per test).
    function span_end_prologue(this, list: ref[Array[ref[AstNode]?]], start: int) returns int
    {
        var i start
        while i < (list.get_length() as int)
        {
            if EmitContext.is_prologue_directive(list[i as size_t]) = false
                break
            set i: i + 1
        }
        i
    }

    function span_end_hoisted_function(this, list: ref[Array[ref[AstNode]?]], start: int) returns int
    {
        var i start
        while i < (list.get_length() as int)
        {
            if this.is_hoisted_function(list[i as size_t]) = false
                break
            set i: i + 1
        }
        i
    }

    function span_end_hoisted_variable(this, list: ref[Array[ref[AstNode]?]], start: int) returns int
    {
        var i start
        while i < (list.get_length() as int)
        {
            if this.is_hoisted_variable_statement(list[i as size_t]) = false
                break
            set i: i + 1
        }
        i
    }

    function span_end_custom_prologue(this, list: ref[Array[ref[AstNode]?]], start: int) returns int
    {
        var i start
        while i < (list.get_length() as int)
        {
            if this.is_custom_prologue(list[i as size_t]) = false
                break
            set i: i + 1
        }
        i
    }

    ; core.Splice(left, at, 0, items...) — an insertion; the Array has no insert
    ; (§3.27): a fresh Array.
    function splice_in(this, left: ref[Array[ref[AstNode]?]], at: int, items: ref[Array[ref[AstNode]?]], from: int, to: int) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        var i 0
        while i < at
        {
            out.add(left[i as size_t])
            set i: i + 1
        }
        var k from
        while k < to
        {
            out.add(items[k as size_t])
            set k: k + 1
        }
        while i < (left.get_length() as int)
        {
            out.add(left[i as size_t])
            set i: i + 1
        }
        out
    }

    ; mergeEnvironment: the declarations are a standard prologue, then hoisted
    ; functions, then hoisted variables, then custom prologues, each merged
    ; behind the statements' own run of that kind; a standard prologue already
    ; present is not repeated.
    procedure merge_environment(this, statements_in: ref[Array[ref[AstNode]?]]?, declarations: ref[Array[ref[AstNode]?]], mutable changed: ref[bool]) returns ref[Array[ref[AstNode]?]]?
    {
        set changed: false
        if (declarations.get_length() as int) = 0
            return statements_in
        var statements: ref[Array[ref[AstNode]?]] &Array[ref[AstNode]?]^host()
        if statements_in <> null
            set statements: statements_in as ref[Array[ref[AstNode]?]]
        let left_standard_prologue_end this.span_end_prologue(statements, 0)
        let left_hoisted_functions_end this.span_end_hoisted_function(statements, left_standard_prologue_end)
        let left_hoisted_variables_end this.span_end_hoisted_variable(statements, left_hoisted_functions_end)
        let right_standard_prologue_end this.span_end_prologue(declarations, 0)
        let right_hoisted_functions_end this.span_end_hoisted_function(declarations, right_standard_prologue_end)
        let right_hoisted_variables_end this.span_end_hoisted_variable(declarations, right_hoisted_functions_end)
        let right_custom_prologue_end this.span_end_custom_prologue(declarations, right_hoisted_variables_end)
        var left statements
        if right_custom_prologue_end > right_hoisted_variables_end
        {
            set left: this.splice_in(left, left_hoisted_variables_end, declarations, right_hoisted_variables_end, right_custom_prologue_end)
            set changed: true
        }
        if right_hoisted_variables_end > right_hoisted_functions_end
        {
            set left: this.splice_in(left, left_hoisted_functions_end, declarations, right_hoisted_functions_end, right_hoisted_variables_end)
            set changed: true
        }
        if right_hoisted_functions_end > right_standard_prologue_end
        {
            set left: this.splice_in(left, left_standard_prologue_end, declarations, right_standard_prologue_end, right_hoisted_functions_end)
            set changed: true
        }
        if right_standard_prologue_end > 0
        {
            if left_standard_prologue_end = 0
            {
                set left: this.splice_in(left, 0, declarations, 0, right_standard_prologue_end)
                set changed: true
            }
            else
            {
                var i right_standard_prologue_end - 1
                while i >= 0
                {
                    let right_prologue declarations[i as size_t]
                    if right_prologue <> null
                    {
                        let text EmitContext.prologue_text(right_prologue as ref[AstNode])
                        var present false
                        var k 0
                        while k < left_standard_prologue_end
                        {
                            let lp statements[k as size_t]
                            if lp <> null
                            {
                                if EmitContext.prologue_text(lp as ref[AstNode]) = text
                                    set present: true
                            }
                            set k: k + 1
                        }
                        if present = false
                        {
                            let one &Array[ref[AstNode]?]^host()
                            one.add(right_prologue)
                            set left: this.splice_in(left, 0, one, 0, 1)
                            set changed: true
                        }
                    }
                    set i: i - 1
                }
            }
        }
        left
    }

    function prologue_text(statement: ref[AstNode]) returns Slice[char]
    {
        let e Printer.statement_expression_of(statement)
        if e = null
            return ""
        AstNode.literal_text_of(e)
    }

    function is_prologue_directive(node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if n.kind <> KindExpressionStatement
            return false
        let e Printer.statement_expression_of(n)
        if e = null
            return false
        (e as ref[AstNode]).kind = KindStringLiteral
    }

    function is_custom_prologue(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        (this.emit_flags(node as ref[AstNode]) & EFCustomPrologue) <> 0
    }

    function is_hoisted_function(this, node: ref[AstNode]?) returns bool
    {
        if this.is_custom_prologue(node) = false
            return false
        (node as ref[AstNode]).kind = KindFunctionDeclaration
    }

    function is_hoisted_variable(decl: ref[AstNode]?) returns bool
    {
        if decl = null
            return false
        let name AstNode.name_of(decl)
        if name = null
            return false
        if (name as ref[AstNode]).kind <> KindIdentifier
            return false
        AstNode.initializer_of(decl) = null
    }

    function is_hoisted_variable_statement(this, node: ref[AstNode]?) returns bool
    {
        if this.is_custom_prologue(node) = false
            return false
        let n node as ref[AstNode]
        if n.kind <> KindVariableStatement
            return false
        let list AstNode.variable_statement_list_of(n)
        if list = null
            return false
        let decls AstNode.variable_declarations_of(list)
        if decls = null
            return true
        let ds decls as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ds.get_length() as int)
        {
            if EmitContext.is_hoisted_variable(ds[i as size_t]) = false
                return false
            set i: i + 1
        }
        true
    }

    ; ── generated names ──

    function has_auto_generate_info(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let row this.try_get_emit_node(node as ref[AstNode])
        if row = null
            return false
        (row as ref[EmitNode]).auto_generate <> null
    }

    function get_auto_generate_info(this, name: ref[AstNode]?) returns ref[AutoGenerateInfo]?
    {
        if name = null
            return null
        let row this.try_get_emit_node(name as ref[AstNode])
        if row = null
            return null
        (row as ref[EmitNode]).auto_generate
    }

    procedure set_auto_generate_info(mutable this, mutable name: ref[AstNode], info: ref[AutoGenerateInfo])
        set this.get_emit_node(name).auto_generate: info

    function get_node_for_generated_name(this, name: ref[AstNode]) returns ref[AstNode]
    {
        let info this.get_auto_generate_info(name)
        if info <> null
        {
            let ag info as ref[AutoGenerateInfo]
            if (ag.flags & GeneratedIdentifierFlagsKindMask) = GeneratedIdentifierFlagsNode
            {
                if ag.node <> null
                    return this.get_node_for_generated_name_worker(ag.node as ref[AstNode], ag.id)
            }
        }
        name
    }

    function get_node_for_generated_name_worker(this, node_in: ref[AstNode], auto_generate_id: int) returns ref[AstNode]
    {
        var node node_in
        var original this.original(node)
        while original <> null
        {
            set node: original as ref[AstNode]
            if (node.kind = KindIdentifier) or (node.kind = KindPrivateIdentifier)
            {
                let info this.get_auto_generate_info(node)
                var stop false
                if info = null
                    set stop: true
                else
                {
                    let ag info as ref[AutoGenerateInfo]
                    if (ag.flags & GeneratedIdentifierFlagsKindMask) = GeneratedIdentifierFlagsNode
                    {
                        if ag.id <> auto_generate_id
                            set stop: true
                    }
                }
                if stop
                    break
                let ag info as ref[AutoGenerateInfo]
                if (ag.flags & GeneratedIdentifierFlagsKindMask) = GeneratedIdentifierFlagsNode
                {
                    set original: ag.node
                    continue
                }
            }
            set original: this.original(node)
        }
        node
    }

    ; ── the emit-node accessors ──

    function emit_flags(this, node: ref[AstNode]) returns int
    {
        let row this.try_get_emit_node(node)
        if row = null
            return EFNone
        (row as ref[EmitNode]).emit_flags
    }

    procedure set_emit_flags(mutable this, mutable node: ref[AstNode], flags: int)
        set this.get_emit_node(node).emit_flags: flags

    procedure add_emit_flags(mutable this, mutable node: ref[AstNode], flags: int)
    {
        let row this.get_emit_node(node)
        set row.emit_flags: row.emit_flags | flags
    }

    function comment_range(this, node: ref[AstNode]) returns TextRange
    {
        let row this.try_get_emit_node(node)
        if row <> null
        {
            let r row as ref[EmitNode]
            if (r.flags & EmitNodeFlagsHasCommentRange) <> 0
                return TextRange(r.comment_pos, r.comment_end)
        }
        TextRange(node.pos, node.end)
    }

    procedure set_comment_range(mutable this, mutable node: ref[AstNode], loc: TextRange)
    {
        let row this.get_emit_node(node)
        set row.comment_pos: loc.pos
        set row.comment_end: loc.end
        set row.flags: row.flags | EmitNodeFlagsHasCommentRange
    }

    procedure assign_comment_range(mutable this, mutable to: ref[AstNode], from: ref[AstNode])
        this.set_comment_range(to, this.comment_range(from))

    function source_map_range(this, node: ref[AstNode]) returns TextRange
    {
        let row this.try_get_emit_node(node)
        if row <> null
        {
            let r row as ref[EmitNode]
            if (r.flags & EmitNodeFlagsHasSourceMapRange) <> 0
                return TextRange(r.source_map_pos, r.source_map_end)
        }
        TextRange(node.pos, node.end)
    }

    procedure set_source_map_range(mutable this, mutable node: ref[AstNode], loc: TextRange)
    {
        let row this.get_emit_node(node)
        set row.source_map_pos: loc.pos
        set row.source_map_end: loc.end
        set row.flags: row.flags | EmitNodeFlagsHasSourceMapRange
    }

    procedure assign_source_map_range(mutable this, mutable to: ref[AstNode], from: ref[AstNode])
        this.set_source_map_range(to, this.source_map_range(from))

    procedure assign_comment_and_source_map_ranges(mutable this, mutable to: ref[AstNode], from: ref[AstNode])
    {
        let cr this.comment_range(from)
        let smr this.source_map_range(from)
        let row this.get_emit_node(to)
        set row.comment_pos: cr.pos
        set row.comment_end: cr.end
        set row.source_map_pos: smr.pos
        set row.source_map_end: smr.end
        set row.flags: row.flags | EmitNodeFlagsHasCommentRange | EmitNodeFlagsHasSourceMapRange
    }

    ; TokenSourceMapRange: (range, found) as an out parameter.
    procedure token_source_map_range(this, node: ref[AstNode], kind: int, mutable out: ref[TextRange]) returns bool
    {
        let row this.try_get_emit_node(node)
        if row = null
            return false
        let r row as ref[EmitNode]
        if r.token_source_map_ranges = null
            return false
        let ranges r.token_source_map_ranges as ref[Array[TokenSourceMapRange]]
        var i 0
        while i < (ranges.get_length() as int)
        {
            let e ranges[i as size_t]
            if e.kind = kind
            {
                set out: TextRange(e.pos, e.end)
                return true
            }
            set i: i + 1
        }
        false
    }

    procedure set_token_source_map_range(mutable this, mutable node: ref[AstNode], kind: int, loc: TextRange)
    {
        let row this.get_emit_node(node)
        if row.token_source_map_ranges = null
            set row.token_source_map_ranges: &Array[TokenSourceMapRange]^host()
        let ranges row.token_source_map_ranges as ref[Array[TokenSourceMapRange]]
        var i 0
        while i < (ranges.get_length() as int)
        {
            let r ranges[i as size_t]
            if r.kind = kind
            {
                ranges.put(i as size_t, TokenSourceMapRange(kind, loc.pos, loc.end))
                return
            }
            set i: i + 1
        }
        ranges.add(TokenSourceMapRange(kind, loc.pos, loc.end))
    }

    function assigned_name(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).assigned_name
    }

    procedure set_assigned_name(mutable this, mutable node: ref[AstNode], name: ref[AstNode]?)
        set this.get_emit_node(node).assigned_name: name

    function text_source(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).text_source
    }

    procedure set_text_source(mutable this, mutable node: ref[AstNode], source: ref[AstNode]?)
        set this.get_emit_node(node).text_source: source

    function class_this(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).class_this
    }

    procedure set_class_this(mutable this, mutable node: ref[AstNode], class_this: ref[AstNode]?)
        set this.get_emit_node(node).class_this: class_this

    ; ── emit helpers ──

    function helper_list_contains(list: ref[Array[ref[EmitHelper]?]], h: ref[EmitHelper]) returns bool
    {
        var i 0
        while i < (list.get_length() as int)
        {
            if list[i as size_t] = h
                return true
            set i: i + 1
        }
        false
    }

    ; RequestEmitHelper: the dependencies first, then the helper, each once (the
    ; reference's ordered set). A scoped helper cannot be requested.
    procedure request_emit_helper(mutable this, helper: ref[EmitHelper])
    {
        if helper.scoped
            return
        if helper.dependencies <> null
        {
            let deps helper.dependencies as ref[Array[ref[EmitHelper]?]]
            var i 0
            while i < (deps.get_length() as int)
            {
                let d deps[i as size_t]
                if d <> null
                    this.request_emit_helper(d as ref[EmitHelper])
                set i: i + 1
            }
        }
        if EmitContext.helper_list_contains(emit_helpers, helper) = false
            emit_helpers.add(helper)
    }

    ; ReadEmitHelpers: the requested helpers in order, and the set cleared.
    procedure read_emit_helpers(mutable this) returns ref[Array[ref[EmitHelper]?]]
    {
        let out emit_helpers
        set this.emit_helpers: &Array[ref[EmitHelper]?]^host()
        out
    }

    procedure add_emit_helper(mutable this, mutable node: ref[AstNode], helper: ref[EmitHelper])
    {
        let row this.get_emit_node(node)
        if row.helpers = null
            set row.helpers: &Array[ref[EmitHelper]?]^host()
        let list row.helpers as ref[Array[ref[EmitHelper]?]]
        if EmitContext.helper_list_contains(list, helper) = false
            list.add(helper)
    }

    ; MoveEmitHelpers(source, target, predicate): the predicate is a tag (§3.18)
    ; — 0 moves every helper, 1 the unscoped ones — each caller names its arm.
    procedure move_emit_helpers(mutable this, mutable source: ref[AstNode], mutable target: ref[AstNode], predicate: int)
    {
        let src_row this.try_get_emit_node(source)
        if src_row = null
            return
        let sr src_row as ref[EmitNode]
        if sr.helpers = null
            return
        let src sr.helpers as ref[Array[ref[EmitHelper]?]]
        if (src.get_length() as int) = 0
            return
        let target_row this.get_emit_node(target)
        if target_row.helpers = null
            set target_row.helpers: &Array[ref[EmitHelper]?]^host()
        let dst target_row.helpers as ref[Array[ref[EmitHelper]?]]
        let kept &Array[ref[EmitHelper]?]^host()
        var i 0
        while i < (src.get_length() as int)
        {
            let h src[i as size_t]
            var moves false
            if h <> null
            {
                if predicate = 0
                    set moves: true
                if predicate = 1
                {
                    if (h as ref[EmitHelper]).scoped = false
                        set moves: true
                }
            }
            if moves
            {
                if EmitContext.helper_list_contains(dst, h as ref[EmitHelper]) = false
                    dst.add(h)
            }
            else
                kept.add(h)
            set i: i + 1
        }
        set sr.helpers: kept
    }

    function get_emit_helpers(this, node: ref[AstNode]) returns ref[Array[ref[EmitHelper]?]]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).helpers
    }

    function get_external_helpers_module_name(this, file: ref[AstNode]) returns ref[AstNode]?
    {
        let parse_node this.parse_node(file)
        if parse_node = null
            return null
        let row this.try_get_emit_node(parse_node as ref[AstNode])
        if row = null
            return null
        (row as ref[EmitNode]).external_helpers_module_name
    }

    procedure set_external_helpers_module_name(mutable this, mutable file: ref[AstNode], name: ref[AstNode]?)
    {
        let parse_node this.parse_node(file)
        if parse_node = null
            return
        set this.get_emit_node(parse_node as ref[AstNode]).external_helpers_module_name: name
    }

    function has_recorded_external_helpers(this, file: ref[AstNode]) returns bool
    {
        let parse_node this.parse_node(file)
        if parse_node = null
            return false
        let row this.try_get_emit_node(parse_node as ref[AstNode])
        if row = null
            return false
        let r row as ref[EmitNode]
        if r.external_helpers_module_name <> null
            return true
        (r.emit_flags & EFExternalHelpers) <> 0
    }

    function is_call_to_helper(this, first_segment: ref[AstNode], helper_name: Slice[char]) returns bool
    {
        if first_segment.kind <> KindCallExpression
            return false
        let callee AstNode.expression_of(first_segment)
        if callee = null
            return false
        let c callee as ref[AstNode]
        if c.kind <> KindIdentifier
            return false
        if (this.emit_flags(c) & EFHelperName) = 0
            return false
        AstNode.identifier_text_of(c).equals(helper_name)
    }

    ; ── the visitor hooks ──

    procedure new_node_visitor(mutable this, visit_tag: int) returns ref[NodeVisitor]
    {
        let v NodeVisitor.create(host, this.the_factory(), visit_tag, HooksTagEmitContext)
        set v.context: this
        v
    }

    procedure visit_variable_environment(mutable this, mutable nodes: ref[Array[ref[AstNode]?]]?, mutable visitor: ref[NodeVisitor]) returns ref[Array[ref[AstNode]?]]? io
    {
        this.start_variable_environment()
        this.end_and_merge_variable_environment(visitor.visit_nodes(nodes))
    }

    procedure visit_parameters(mutable this, mutable nodes_in: ref[Array[ref[AstNode]?]]?, mutable visitor: ref[NodeVisitor]) returns ref[Array[ref[AstNode]?]]? io
    {
        this.start_variable_environment()
        let scope this.peek_var_scope() as ref[VarScope]
        let old_flags scope.flags
        set scope.flags: scope.flags | EnvironmentFlagsInParameters
        var nodes visitor.visit_nodes(nodes_in)
        if (scope.flags & EnvironmentFlagsVariablesHoistedInParameters) <> 0
            set nodes: this.add_default_value_assignments_if_needed(nodes)
        set scope.flags: old_flags
        nodes
    }

    procedure add_default_value_assignments_if_needed(mutable this, mutable node_list: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        if node_list = null
            return node_list
        let nodes node_list as ref[Array[ref[AstNode]?]]
        var result: ref[Array[ref[AstNode]?]]? null
        var i 0
        while i < (nodes.get_length() as int)
        {
            let parameter nodes[i as size_t]
            if parameter <> null
            {
                let updated this.add_default_value_assignment_if_needed(parameter as ref[AstNode])
                if updated <> parameter
                {
                    if result = null
                    {
                        let copy &Array[ref[AstNode]?]^host()
                        var k 0
                        while k < (nodes.get_length() as int)
                        {
                            copy.add(nodes[k as size_t])
                            set k: k + 1
                        }
                        set result: copy
                    }
                    (result as ref[Array[ref[AstNode]?]]).put(i as size_t, updated)
                }
            }
            set i: i + 1
        }
        if result <> null
            return this.the_factory().new_node_list_like(result as ref[Array[ref[AstNode]?]], node_list)
        node_list
    }

    procedure add_default_value_assignment_if_needed(mutable this, mutable parameter: ref[AstNode]) returns ref[AstNode]
    {
        if AstNode.dot_dot_dot_token_of(parameter) <> null
            return parameter
        let name AstNode.name_of(parameter)
        if name <> null
        {
            let nk (name as ref[AstNode]).kind
            if (nk = KindObjectBindingPattern) or (nk = KindArrayBindingPattern)
                return this.add_default_value_assignment_for_binding_pattern(parameter)
        }
        let initializer AstNode.initializer_of(parameter)
        if initializer <> null
            return this.add_default_value_assignment_for_initializer(parameter, name as ref[AstNode], initializer as ref[AstNode])
        parameter
    }

    procedure add_default_value_assignment_for_binding_pattern(mutable this, mutable parameter: ref[AstNode]) returns ref[AstNode]
    {
        let f this.the_factory()
        var init_node: ref[AstNode]? null
        let initializer AstNode.initializer_of(parameter)
        if initializer <> null
        {
            set init_node: f.new_conditional_expression(
                f.new_strict_equality_expression(f.new_generated_name_for_node(parameter), f.new_void_zero_expression()),
                f.new_token(KindQuestionToken),
                initializer,
                f.new_token(KindColonToken),
                f.new_generated_name_for_node(parameter))
        }
        else
            set init_node: f.new_generated_name_for_node(parameter)
        let decls &Array[ref[AstNode]?]^host()
        decls.add(f.new_variable_declaration(AstNode.name_of(parameter), null, AstNode.type_of(parameter), init_node))
        this.add_initialization_statement(f.new_variable_statement(null, f.new_variable_declaration_list(decls, NodeFlagsNone)))
        f.update_parameter_declaration(parameter, AstNode.modifiers_of(parameter), AstNode.dot_dot_dot_token_of(parameter), f.new_generated_name_for_node(parameter), AstNode.parameter_question_token_of(parameter), AstNode.type_of(parameter), null)
    }

    procedure add_default_value_assignment_for_initializer(mutable this, mutable parameter: ref[AstNode], mutable name: ref[AstNode], mutable initializer: ref[AstNode]) returns ref[AstNode]
    {
        let f this.the_factory()
        this.add_emit_flags(initializer, EFNoSourceMap | EFNoComments)
        let name_clone f.clone(name)
        this.add_emit_flags(name_clone, EFNoSourceMap)
        let init_assignment f.new_assignment_expression(name_clone, initializer)
        set init_assignment.pos: parameter.pos
        set init_assignment.end: parameter.end
        this.add_emit_flags(init_assignment, EFNoComments)
        let stmts &Array[ref[AstNode]?]^host()
        stmts.add(f.new_expression_statement(init_assignment))
        let init_block f.new_block(stmts, false)
        set init_block.pos: parameter.pos
        set init_block.end: parameter.end
        this.add_emit_flags(init_block, EFSingleLine | EFNoTrailingSourceMap | EFNoTokenSourceMaps | EFNoComments)
        this.add_initialization_statement(f.new_if_statement(f.new_type_check(f.clone(name), "undefined"), init_block, null))
        f.update_parameter_declaration(parameter, AstNode.modifiers_of(parameter), AstNode.dot_dot_dot_token_of(parameter), name, AstNode.parameter_question_token_of(parameter), AstNode.type_of(parameter), null)
    }

    procedure add_initialization_statement(mutable this, mutable node: ref[AstNode])
    {
        let scope this.peek_var_scope() as ref[VarScope]
        this.add_emit_flags(node, EFCustomPrologue)
        scope.initialization_statements.add(node)
    }

    ; VisitFunctionBody: the body visited, then the variable environment's
    ; declarations merged in — a block gets them merged, an expression body
    ; becomes a block over `return`, no body becomes a block of them.
    procedure visit_function_body(mutable this, mutable node: ref[AstNode]?, mutable visitor: ref[NodeVisitor]) returns ref[AstNode]? io
    {
        let updated visitor.visit_node(node)
        let declarations this.end_variable_environment()
        if (declarations.get_length() as int) = 0
            return updated
        let f this.the_factory()
        if updated = null
            return f.new_block(declarations, true)
        let u updated as ref[AstNode]
        if u.kind <> KindBlock
        {
            let one &Array[ref[AstNode]?]^host()
            one.add(f.new_return_statement(u))
            var changed false
            let statements this.merge_environment(one, declarations, &changed)
            return f.new_block(statements as ref[Array[ref[AstNode]?]], false)
        }
        f.update_block(u, this.merge_environment_list(AstNode.statements_of(u), declarations), AstNode.multi_line_of(u))
    }

    procedure visit_iteration_body(mutable this, mutable body: ref[AstNode]?, mutable visitor: ref[NodeVisitor]) returns ref[AstNode]? io
    {
        if body = null
            return null
        this.start_lexical_environment()
        let updated this.visit_embedded_statement(body, visitor)
        let statements this.end_lexical_environment()
        if updated = null
            return null
        let u updated as ref[AstNode]
        if (statements.get_length() as int) > 0
        {
            let f this.the_factory()
            if u.kind = KindBlock
            {
                let inner AstNode.statements_of(u)
                if inner <> null
                {
                    let il inner as ref[Array[ref[AstNode]?]]
                    var i 0
                    while i < (il.get_length() as int)
                    {
                        statements.add(il[i as size_t])
                        set i: i + 1
                    }
                }
                let list f.new_node_list_like(statements, inner)
                return f.update_block(u, list, AstNode.multi_line_of(u))
            }
            statements.add(u)
            return f.new_block(statements, true)
        }
        updated
    }

    ; VisitEmbeddedStatement: a dropped or not-emitted statement becomes an
    ; empty statement at the original's location, with its comments.
    procedure visit_embedded_statement(mutable this, mutable node: ref[AstNode]?, mutable visitor: ref[NodeVisitor]) returns ref[AstNode]? io
    {
        if node = null
            return null
        let n node as ref[AstNode]
        let embedded visitor.visit_embedded_statement(node)
        var missing embedded = null
        if missing = false
        {
            if (embedded as ref[AstNode]).kind = KindNotEmittedStatement
                set missing: true
        }
        if missing
        {
            let empty this.the_factory().new_empty_statement()
            set empty.pos: n.pos
            set empty.end: n.end
            this.set_original(empty, n)
            this.assign_comment_range(empty, n)
            return empty
        }
        embedded
    }

    ; ── synthetic comments and the type node ──

    procedure set_synthetic_leading_comments(mutable this, mutable node: ref[AstNode], comments: ref[Array[SynthesizedComment]]?) returns ref[AstNode]
    {
        set this.get_emit_node(node).leading_comments: comments
        node
    }

    procedure add_synthetic_leading_comment(mutable this, mutable node: ref[AstNode], kind: int, text: Slice[char], has_trailing_new_line: bool) returns ref[AstNode]
    {
        let row this.get_emit_node(node)
        if row.leading_comments = null
            set row.leading_comments: &Array[SynthesizedComment]^host()
        (row.leading_comments as ref[Array[SynthesizedComment]]).add(SynthesizedComment(kind, 0 - 1, 0 - 1, false, has_trailing_new_line, text))
        node
    }

    function get_synthetic_leading_comments(this, node: ref[AstNode]) returns ref[Array[SynthesizedComment]]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).leading_comments
    }

    procedure set_synthetic_trailing_comments(mutable this, mutable node: ref[AstNode], comments: ref[Array[SynthesizedComment]]?) returns ref[AstNode]
    {
        set this.get_emit_node(node).trailing_comments: comments
        node
    }

    procedure add_synthetic_trailing_comment(mutable this, mutable node: ref[AstNode], kind: int, text: Slice[char], has_trailing_new_line: bool) returns ref[AstNode]
    {
        let row this.get_emit_node(node)
        if row.trailing_comments = null
            set row.trailing_comments: &Array[SynthesizedComment]^host()
        (row.trailing_comments as ref[Array[SynthesizedComment]]).add(SynthesizedComment(kind, 0 - 1, 0 - 1, false, has_trailing_new_line, text))
        node
    }

    function get_synthetic_trailing_comments(this, node: ref[AstNode]) returns ref[Array[SynthesizedComment]]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).trailing_comments
    }

    procedure set_type_node(mutable this, mutable node: ref[AstNode], type_node: ref[AstNode]?)
        set this.get_emit_node(node).type_node: type_node

    function get_type_node(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let row this.try_get_emit_node(node)
        if row = null
            return null
        (row as ref[EmitNode]).type_node
    }

    procedure new_not_emitted_statement(mutable this, node: ref[AstNode]) returns ref[AstNode]
    {
        let statement this.the_factory().new_not_emitted_statement()
        set statement.pos: node.pos
        set statement.end: node.end
        this.set_original(statement, node)
        this.assign_comment_range(statement, node)
        statement
    }
}

; ── namegenerator.go (slice 232) ────────────────────────────────────────────
;
; The reference's two callbacks are the Printer's `isFileLevelUniqueNameInCurrentFile`
; and `getTextOfNode`; here `printer` is that printer (null in the tests that make
; a bare generator), asked through the two methods printer.go's slice gives it.
; The reference keys its caches by node id; this port has no node ids, so the
; per-node caches are lists of (node, name) pairs — a file's generated names are
; few. Names are page-hosted views (`Printer.slice_of` over a builder's product).
define TempFlagsAuto: int 0
define TempFlagsCountMask: int 0x0FFFFFFF
define TempFlagsI: int 0x10000000

define NamedFlags
(
    key: Slice[char]
    flags: int
)

define NodeName
(
    node: ref[AstNode]
    name: Slice[char]
)

define IdName
(
    id: int
    name: Slice[char]
)

define NameGenerationScope
(
    next: ref[NameGenerationScope]?
    temp_flags: int
    formatted_name_temp_flags: ref[Array[NamedFlags]]
    reserved_names: ref[Array[Slice[char]]]
)

define NameGenerator
(
    host: ref[Page]
    context: ref[EmitContext]?
    printer: ref[Printer]?
    node_to_generated_name: ref[Array[NodeName]]
    node_to_generated_private_name: ref[Array[NodeName]]
    auto_generated_id_to_generated_name: ref[Array[IdName]]
    name_generation_scope: ref[NameGenerationScope]?
    private_name_generation_scope: ref[NameGenerationScope]?
    generated_names: ref[Array[Slice[char]]]
)
{
    function create(host: ref[Page], context: ref[EmitContext]?, printer: ref[Printer]?) returns ref[NameGenerator]
    {
        let a &Array[NodeName]^host()
        let b &Array[NodeName]^host()
        let c &Array[IdName]^host()
        let g &Array[Slice[char]]^host()
        &NameGenerator^host(host, context, printer, a, b, c, null, null, g)
    }

    function new_scope(this, next: ref[NameGenerationScope]?) returns ref[NameGenerationScope]
    {
        let f &Array[NamedFlags]^host()
        let r &Array[Slice[char]]^host()
        &NameGenerationScope^host(next, TempFlagsAuto, f, r)
    }

    procedure push_scope(mutable this, reuse_temp_variable_scope: bool)
    {
        set this.private_name_generation_scope: this.new_scope(private_name_generation_scope)
        if reuse_temp_variable_scope = false
            set this.name_generation_scope: this.new_scope(name_generation_scope)
    }

    procedure pop_scope(mutable this, reuse_temp_variable_scope: bool)
    {
        if private_name_generation_scope <> null
            set this.private_name_generation_scope: (private_name_generation_scope as ref[NameGenerationScope]).next
        if reuse_temp_variable_scope = false
        {
            if name_generation_scope <> null
                set this.name_generation_scope: (name_generation_scope as ref[NameGenerationScope]).next
        }
    }

    function scope_of(this, private_name: bool) returns ref[NameGenerationScope]?
    {
        if private_name
            return private_name_generation_scope
        name_generation_scope
    }

    ; `*scope = &nameGenerationScope{}` — a missing scope is made on first write.
    procedure ensure_scope(mutable this, private_name: bool) returns ref[NameGenerationScope]
    {
        let existing this.scope_of(private_name)
        if existing <> null
            return existing as ref[NameGenerationScope]
        let made this.new_scope(null)
        if private_name
            set this.private_name_generation_scope: made
        else
            set this.name_generation_scope: made
        made
    }

    function get_temp_flags(this, private_name: bool) returns int
    {
        let scope this.scope_of(private_name)
        if scope = null
            return TempFlagsAuto
        (scope as ref[NameGenerationScope]).temp_flags
    }

    procedure set_temp_flags(mutable this, private_name: bool, flags: int)
        set this.ensure_scope(private_name).temp_flags: flags

    function get_temp_flags_for_formatted_name(this, private_name: bool, key: Slice[char]) returns int
    {
        let scope this.scope_of(private_name)
        if scope = null
            return TempFlagsAuto
        let list (scope as ref[NameGenerationScope]).formatted_name_temp_flags
        var i 0
        while i < (list.get_length() as int)
        {
            let e list[i as size_t]
            if e.key = key
                return e.flags
            set i: i + 1
        }
        TempFlagsAuto
    }

    procedure set_temp_flags_for_formatted_name(mutable this, private_name: bool, key: Slice[char], flags: int)
    {
        let scope this.ensure_scope(private_name)
        let list scope.formatted_name_temp_flags
        var i 0
        while i < (list.get_length() as int)
        {
            let e list[i as size_t]
            if e.key = key
            {
                list.put(i as size_t, NamedFlags(key, flags))
                return
            }
            set i: i + 1
        }
        list.add(NamedFlags(key, flags))
    }

    function names_contain(list: ref[Array[Slice[char]]], name: Slice[char]) returns bool
    {
        var i 0
        while i < (list.get_length() as int)
        {
            if list[i as size_t] = name
                return true
            set i: i + 1
        }
        false
    }

    ; reserveName. The unscoped, non-temp arm goes into the file-wide set —
    ; the reference's own note: matches Strada, and is incorrect.
    procedure reserve_name(mutable this, name: Slice[char], private_name: bool, scoped: bool, temp: bool)
    {
        let scope this.ensure_scope(private_name)
        if private_name or scoped
        {
            scope.reserved_names.add(name)
            return
        }
        if temp = false
            generated_names.add(name)
    }

    ; The two callbacks the printer installs (`GetTextOfNode`,
    ; `IsFileLevelUniqueNameInCurrentFile`): the printer itself when there is
    ; one (§3.18), else the reference's nil-callback arms — the node's own
    ; text, and "unique".
    procedure get_text_of_node(mutable this, node: ref[AstNode]) returns Slice[char]
    {
        if printer <> null
            return (printer as ref[Printer]).get_text_of_node(node, false)
        if node.kind = KindIdentifier
            return AstNode.identifier_text_of(node)
        if node.kind = KindPrivateIdentifier
            return AstNode.identifier_text_of(node)
        AstNode.literal_text_of(node)
    }

    procedure is_file_level_unique_name_in_current_file(mutable this, name: Slice[char], private_name: bool) returns bool
    {
        if printer = null
            return true
        (printer as ref[Printer]).is_file_level_unique_name_in_current_file(name, private_name)
    }

    function has_file_level_check(this) returns bool
        printer <> null

    ; GenerateName: the name of an auto-generated identifier — computed once
    ; per generated node, or per auto-generate id.
    procedure generate_name(mutable this, name: ref[AstNode]) returns Slice[char]
    {
        if context <> null
        {
            let ctx context as ref[EmitContext]
            let info ctx.get_auto_generate_info(name)
            if info <> null
            {
                let ag info as ref[AutoGenerateInfo]
                if (ag.flags & GeneratedIdentifierFlagsKindMask) = GeneratedIdentifierFlagsNode
                    return this.generate_name_for_node_cached(ctx.get_node_for_generated_name(name), name.kind = KindPrivateIdentifier, ag.flags, ag.prefix, ag.suffix)
                var i 0
                while i < (auto_generated_id_to_generated_name.get_length() as int)
                {
                    let e auto_generated_id_to_generated_name[i as size_t]
                    if e.id = ag.id
                        return e.name
                    set i: i + 1
                }
                let generated this.make_name(name)
                auto_generated_id_to_generated_name.add(IdName(ag.id, generated))
                return generated
            }
        }
        this.get_text_of_node(name)
    }

    procedure generate_name_for_node_cached(mutable this, node: ref[AstNode], private_name: bool, flags: int, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        var cache node_to_generated_name
        if private_name
            set cache: node_to_generated_private_name
        var i 0
        while i < (cache.get_length() as int)
        {
            let e cache[i as size_t]
            if e.node = node
                return e.name
            set i: i + 1
        }
        let name this.generate_name_for_node(node, private_name, flags, prefix, suffix)
        cache.add(NodeName(node, name))
        name
    }

    procedure generate_name_for_node(mutable this, node: ref[AstNode], private_name: bool, flags: int, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        let k node.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
            return this.make_unique_name(this.get_text_of_node(node), false, (flags & GeneratedIdentifierFlagsOptimistic) <> 0, (flags & GeneratedIdentifierFlagsReservedInNestedScopes) <> 0, private_name, prefix, suffix)
        if (k = KindModuleDeclaration) or (k = KindEnumDeclaration)
            return this.generate_name_for_module_or_enum(node)
        if (k = KindImportDeclaration) or (k = KindJSImportDeclaration) or (k = KindExportDeclaration)
            return this.generate_name_for_import_or_export_declaration(node)
        if (k = KindFunctionDeclaration) or (k = KindClassDeclaration)
        {
            let name AstNode.name_of(node)
            if name <> null
                return this.generate_name_for_node(name as ref[AstNode], false, flags, "", "")
            return this.generate_name_for_export_default()
        }
        if k = KindExportAssignment
            return this.generate_name_for_export_default()
        if k = KindClassExpression
            return this.generate_name_for_class_expression()
        if (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
            return this.generate_name_for_method_or_accessor(node, private_name, prefix, suffix)
        if k = KindComputedPropertyName
            return this.make_temp_variable_name(TempFlagsAuto, true, private_name, prefix, suffix)
        this.make_temp_variable_name(TempFlagsAuto, false, private_name, prefix, suffix)
    }

    procedure generate_name_for_module_or_enum(mutable this, node: ref[AstNode]) returns Slice[char]
    {
        let name this.get_text_of_node(AstNode.name_of(node) as ref[AstNode])
        if NameGenerator.is_unique_local_name(name, node)
            return name
        this.make_unique_name(name, false, false, false, false, "", "")
    }

    procedure generate_name_for_import_or_export_declaration(mutable this, node: ref[AstNode]) returns Slice[char]
    {
        let expr AstNode.get_external_module_name(node)
        var base_name: Slice[char] "module"
        if expr <> null
        {
            if (expr as ref[AstNode]).kind = KindStringLiteral
                set base_name: Printer.slice_on(host, Printer.make_identifier_from_module_name(host, AstNode.literal_text_of(expr)))
        }
        this.make_unique_name(base_name, false, false, false, false, "", "")
    }

    procedure generate_name_for_export_default(mutable this) returns Slice[char]
        this.make_unique_name("default", false, false, false, false, "", "")

    procedure generate_name_for_class_expression(mutable this) returns Slice[char]
        this.make_unique_name("class", false, false, false, false, "", "")

    procedure generate_name_for_method_or_accessor(mutable this, node: ref[AstNode], private_name: bool, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        let name AstNode.name_of(node)
        if name <> null
        {
            if (name as ref[AstNode]).kind = KindIdentifier
                return this.generate_name_for_node_cached(name as ref[AstNode], private_name, GeneratedIdentifierFlagsNone, prefix, suffix)
        }
        this.make_temp_variable_name(TempFlagsAuto, false, private_name, prefix, suffix)
    }

    ; makeName: an Auto/Loop/Unique generated identifier's name.
    procedure make_name(mutable this, name: ref[AstNode]) returns Slice[char]
    {
        if context <> null
        {
            let info (context as ref[EmitContext]).get_auto_generate_info(name)
            if info <> null
            {
                let ag info as ref[AutoGenerateInfo]
                let kind ag.flags & GeneratedIdentifierFlagsKindMask
                let reserved (ag.flags & GeneratedIdentifierFlagsReservedInNestedScopes) <> 0
                if kind = GeneratedIdentifierFlagsAuto
                    return this.make_temp_variable_name(TempFlagsAuto, reserved, name.kind = KindPrivateIdentifier, ag.prefix, ag.suffix)
                if kind = GeneratedIdentifierFlagsLoop
                    return this.make_temp_variable_name(TempFlagsI, reserved, false, ag.prefix, ag.suffix)
                if kind = GeneratedIdentifierFlagsUnique
                    return this.make_unique_name(AstNode.identifier_text_of(name), (ag.flags & GeneratedIdentifierFlagsFileLevel) <> 0, (ag.flags & GeneratedIdentifierFlagsOptimistic) <> 0, reserved, name.kind = KindPrivateIdentifier, ag.prefix, ag.suffix)
            }
        }
        this.get_text_of_node(name)
    }

    procedure temp_name_of(mutable this, count: int) returns Slice[char]
    {
        let b StringBuilder^host()
        b.append("_" as char)
        if count < 26
            b.append((97 + count) as char)
        else
            b.append(count - 26)
        Printer.slice_on(host, b.to_string())
    }

    ; makeTempVariableName: `_a` … `_z`, then `_0` …, skipping `_i` and `_n`
    ; (counts 8 and 13); a loop variable prefers `_i` once per scope.
    procedure make_temp_variable_name(mutable this, flags: int, reserved_in_nested_scopes: bool, private_name: bool, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        var temp_flags TempFlagsAuto
        var key: Slice[char] ""
        var simple ((prefix.length as int) = 0) and ((suffix.length as int) = 0)
        if simple
            set temp_flags: this.get_temp_flags(private_name)
        else
        {
            set key: Printer.slice_on(host, Printer.format_generated_name(host, private_name, prefix, "", suffix))
            if private_name
            {
                if Printer.has_leading_hash(key) = false
                {
                    let b StringBuilder^host()
                    b.append("#" as char)
                    b.append(key.data, key.length)
                    set key: Printer.slice_on(host, b.to_string())
                }
            }
            set temp_flags: this.get_temp_flags_for_formatted_name(private_name, key)
        }
        if flags <> 0
        {
            if (temp_flags & flags) = 0
            {
                let full_name Printer.slice_on(host, Printer.format_generated_name(host, private_name, prefix, "_i", suffix))
                if this.is_unique_name(full_name, private_name)
                {
                    set temp_flags: temp_flags | flags
                    this.reserve_name(full_name, private_name, reserved_in_nested_scopes, true)
                    if simple
                        this.set_temp_flags(private_name, temp_flags)
                    else
                        this.set_temp_flags_for_formatted_name(private_name, key, temp_flags)
                    return full_name
                }
            }
        }
        while true
        {
            let count temp_flags & TempFlagsCountMask
            set temp_flags: temp_flags + 1
            if (count <> 8) and (count <> 13)
            {
                let name this.temp_name_of(count)
                let full_name Printer.slice_on(host, Printer.format_generated_name(host, private_name, prefix, name, suffix))
                if this.is_unique_name(full_name, private_name)
                {
                    this.reserve_name(full_name, private_name, reserved_in_nested_scopes, true)
                    if simple
                        this.set_temp_flags(private_name, temp_flags)
                    else
                        this.set_temp_flags_for_formatted_name(private_name, key, temp_flags)
                    return full_name
                }
            }
        }
        ""
    }

    ; makeUniqueName: `base`, or `base_1`, `base_2`, …; `file_level` is the
    ; reference's checkFn being the file-level callback.
    procedure make_unique_name(mutable this, base_name_in: Slice[char], file_level: bool, optimistic: bool, scoped: bool, private_name: bool, prefix: Slice[char], suffix: Slice[char]) returns Slice[char]
    {
        var base_name Printer.remove_leading_hash(base_name_in)
        if optimistic
        {
            let full_name Printer.slice_on(host, Printer.format_generated_name(host, private_name, prefix, base_name, suffix))
            if this.check_unique_name(full_name, private_name, file_level)
            {
                this.reserve_name(full_name, private_name, scoped, false)
                return full_name
            }
        }
        var ends_in_underscore false
        if (base_name.length as int) > 0
        {
            if ((base_name[(base_name.length as int - 1) as size_t] as int) & 255) = ("_" as char) as int
                set ends_in_underscore: true
        }
        if ends_in_underscore = false
        {
            let b StringBuilder^host()
            b.append(base_name.data, base_name.length)
            b.append("_" as char)
            set base_name: Printer.slice_on(host, b.to_string())
        }
        var i 1
        while true
        {
            let b StringBuilder^host()
            b.append(base_name.data, base_name.length)
            b.append(i)
            let full_name Printer.slice_on(host, Printer.format_generated_name(host, private_name, prefix, Printer.slice_on(host, b.to_string()), suffix))
            if this.check_unique_name(full_name, private_name, file_level)
            {
                this.reserve_name(full_name, private_name, scoped, false)
                return full_name
            }
            set i: i + 1
        }
        ""
    }

    procedure make_file_level_optimistic_unique_name(mutable this, name: Slice[char]) returns Slice[char]
        this.make_unique_name(name, true, true, false, false, "", "")

    procedure check_unique_name(mutable this, name: Slice[char], private_name: bool, file_level: bool) returns bool
    {
        if file_level
            return this.is_file_level_unique_name_in_current_file(name, private_name)
        this.is_unique_name(name, private_name)
    }

    ; isUniqueLocalName: no local of a VALUE, export-value or alias meaning under
    ; the container carries the name. The reference walks the binder's
    ; NextContainer chain restricted to the container's descendants; this port
    ; has no such chain and walks the container's subtree for every node that
    ; holds locals, which is the same set.
    function is_unique_local_name(name: Slice[char], container: ref[AstNode]) returns bool
        NameGenerator.no_local_named(name, container)

    function no_local_named(name: Slice[char], node: ref[AstNode]) returns bool
    {
        let locals AstNode.locals_of(node)
        if locals <> null
        {
            let local SymbolTable.get(locals, name)
            if local <> null
            {
                if ((local as ref[Symbol]).flags & (SymbolFlagsValue | SymbolFlagsExportValue | SymbolFlagsAlias)) <> 0
                    return false
            }
        }
        var i 0
        while true
        {
            let c AstNode.child_at(node, i)
            if c = null
                break
            if NameGenerator.no_local_named(name, c as ref[AstNode]) = false
                return false
            set i: i + 1
        }
        true
    }

    procedure is_unique_name(mutable this, name: Slice[char], private_name: bool) returns bool
    {
        if this.is_file_level_unique_name_in_current_file(name, private_name) = false
            return false
        this.is_reserved_name(name, private_name) = false
    }

    function is_reserved_name(this, name: Slice[char], private_name: bool) returns bool
    {
        if NameGenerator.names_contain(generated_names, name)
            return true
        var scope this.scope_of(private_name)
        while scope <> null
        {
            let sc scope as ref[NameGenerationScope]
            if NameGenerator.names_contain(sc.reserved_names, name)
                return true
            set scope: sc.next
        }
        false
    }
}
