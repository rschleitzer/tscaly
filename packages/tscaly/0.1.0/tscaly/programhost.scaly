use tscaly.tracing.Tracing
use tscaly.tracing.TraceArg
use tscaly.system.VfsFile

; the messages of an explanation in order, a code and its arguments each
define ExplainMessages (codes: ref[Array[int]]  args: ref[Array[ref[Array[String]]?]])
{
    function create(host: ref[Page]) returns ref[ExplainMessages]
        &ExplainMessages^host(&Array[int]^host(), &Array[ref[Array[String]]?]^host())

    procedure add(this, code: int, a: ref[Array[String]]?)
    {
        codes.add(code)
        args.add(a)
    }
}

; tsoptions' config file reading for the driver
define ConfigFiles (reserved: int)
{
    ; core.ResolveConfigFileNameOfProjectReference
    function config_of_reference(host: ref[Page], path: Slice[char]) returns Slice[char]
    {
        if path.ends_with(".json")
            return path
        combine_paths(host, path, "tsconfig.json")
    }

    ; GetParsedCommandLineOfConfigFilePath through a host: the reference, its parse
    ; null when the file cannot be read; null after a stop
    procedure resolve(sys: ref[ExecSystem], config: Slice[char], options: ref[TsOptions]?, raw: ref[TsOptions]?) returns ref[ResolvedReference]?
    {
        let host sys.host
        let diagnostics &Array[ref[DriverDiagnostic]]^host()
        var text Slice[char]()
        var parsed: ref[TsParsedCommandLine]? null
        if sys.read_file(config, &text)
        {
            set parsed: ConfigFiles.parse(sys, options, raw, config, text, diagnostics)
            if parsed = null
                return null
        }
        &ResolvedReference^host(config, parsed, text, diagnostics, &Array[int]^host())
    }

    ; outputpaths.GetOutputDeclarationFileNameWorker over a config's own options:
    ; below declarationDir (else outDir) relative to the common source directory
    ; (rootDir, else the config's directory)
    function declaration_output_path(host: ref[Page], config: Slice[char], options: ref[TsOptions], file: Slice[char], cwd: Slice[char]) returns Slice[char]
    {
        var ext: Slice[char] ".d.ts"
        if file.ends_with(".mts") or file.ends_with(".mjs")
            set ext: ".d.mts"
        if file.ends_with(".cts") or file.ends_with(".cjs")
            set ext: ".d.cts"
        var dir options.text_of("declarationDir")
        if (dir.length as int) = 0
            set dir: options.text_of("outDir")
        ConfigFiles.output_path(host, config, options, file, ext, dir, cwd)
    }

    ; getOutputPathWithoutChangingExtension + ChangeExtension
    function output_path(host: ref[Page], config: Slice[char], options: ref[TsOptions], file: Slice[char], ext: Slice[char], out_dir: Slice[char], cwd: Slice[char]) returns Slice[char]
    {
        var path file
        if (out_dir.length as int) > 0
        {
            var common options.text_of("rootDir")
            if (common.length as int) = 0
                set common: get_directory_path(host, config)
            else
                set common: get_normalized_absolute_path(host, common, cwd)
            let new_dir get_normalized_absolute_path(host, out_dir, cwd)
            set path: Emitter.source_file_path_in_new_dir(host, file, new_dir, cwd, common)
        }
        let without path.subslice(0, remove_file_extension(path) as size_t)
        join_slices(host, without, ext)
    }

    ; outputpaths.GetBuildInfoFileName, absolute
    function build_info_file_name_of(host: ref[Page], o: ref[TsOptions], config: Slice[char], cwd: Slice[char]) returns Slice[char]
    {
        if (o.tristate_of("incremental") <> 1) and (o.tristate_of("composite") <> 1) and (o.tristate_of("build") <> 1)
            return ""
        let explicit o.text_of("tsBuildInfoFile")
        if (explicit.length as int) > 0
            return get_normalized_absolute_path(host, explicit, cwd)
        if (config.length as int) = 0
            return ""
        let ext_len remove_file_extension(config)
        let extension_less config.subslice(0, ext_len as size_t)
        var result extension_less
        let out_dir o.text_of("outDir")
        if (out_dir.length as int) > 0
        {
            let root_dir o.text_of("rootDir")
            if (root_dir.length as int) > 0
                set result: get_normalized_absolute_path(host, get_relative_path_to_directory_or_url(host, get_normalized_absolute_path(host, root_dir, cwd), extension_less, false, cwd), get_normalized_absolute_path(host, out_dir, cwd))
            else
                set result: combine_paths(host, get_normalized_absolute_path(host, out_dir, cwd), get_base_file_name(host, extension_less))
        }
        join_slices(host, result, ".tsbuildinfo")
    }

    ; GetParsedCommandLineOfConfigFile: the config's parse diagnostics into
    ; `diagnostics`; null after a stop
    procedure parse(sys: ref[ExecSystem], existing_options: ref[TsOptions]?, existing_raw: ref[TsOptions]?, config_file_name: Slice[char], text: Slice[char], diagnostics: ref[Array[ref[DriverDiagnostic]]]) returns ref[TsParsedCommandLine]?
    {
        let host sys.host
        let pf ProgramFiles.create(host)
        set pf.directory_paths: sys.directories
        set pf.case_insensitive: sys.case_sensitive = false
        var fi 0
        while fi < (sys.files.get_length() as int)
        {
            let entry sys.files[fi as size_t]
            set fi: fi + 1
            if entry = null
                continue
            let f entry as ref[VfsFile]
            if f.is_link
                pf.add_link(f.path, f.link_target)
            else
                ExecSystem.register_in(pf, f.path, f)
        }
        let tp TsConfigParser.create(host, pf, sys.cwd)
        set tp.existing_options: existing_options
        set tp.extended_reporting: true
        let none: Slice[char] ""
        if existing_raw <> null
        {
            let raw existing_raw as ref[TsOptions]
            let wrapper_keys &Array[Slice[char]]^host()
            wrapper_keys.add("compilerOptions")
            let wrapper_values &Array[ref[JsonValue]?]^host()
            wrapper_values.add(&JsonValue^host(JsonKindObject, none, false, raw.names, raw.values))
            set tp.existing_raw: &JsonValue^host(JsonKindObject, none, false, wrapper_keys, wrapper_values)
        }
        let found tp.config_file_diagnostics(config_file_name, text)
        if (found = null) or (tp.last_parsed = null)
        {
            sys.stop(tp.stop_tag)
            if (sys.stop_tag.length as int) = 0
                sys.stop("tsconfig")
            return null
        }
        let fl found as ref[Array[int]]
        var i 0
        while i < ((fl.get_length() as int) / 3)
        {
            let pos fl[(3 * i) as size_t]
            if pos < 0
                diagnostics.add(&DriverDiagnostic^host(none, none, 0, 0, fl[(3 * i + 2) as size_t], tp.diagnostic_args_at(i), null, null))
            else
            {
                let source tp.diagnostic_source_at(i)
                if (source.length as int) > 0
                    diagnostics.add(&DriverDiagnostic^host(source, pf.text_of_path(source), pos, fl[(3 * i + 1) as size_t], fl[(3 * i + 2) as size_t], tp.diagnostic_args_at(i), null, null))
                else
                    diagnostics.add(&DriverDiagnostic^host(config_file_name, text, pos, fl[(3 * i + 1) as size_t], fl[(3 * i + 2) as size_t], tp.diagnostic_args_at(i), null, null))
            }
            set i: i + 1
        }
        tp.last_parsed
    }

}

; a resolved project reference (projectReferenceParseTask): the config, its
; parse (null when the file could not be read), and the references it holds
; by index into the program's reference list
define ResolvedReference
(
    config: Slice[char]
    parsed: ref[TsParsedCommandLine]?
    text: Slice[char]
    diagnostics: ref[Array[ref[DriverDiagnostic]]]
    children: ref[Array[int]]
)

; EmitOptions.EmitOnly
define EmitOnlyAll: int 0
define EmitOnlyJs: int 1
define EmitOnlyDts: int 2
define EmitOnlyForcedDts: int 3

; one emitter.emit's outputs, not yet written
define FileEmitOutput
(
    skipped: bool
    has_js: bool
    js_path: Slice[char]
    js_text: Slice[char]
    has_dts: bool
    dts_path: Slice[char]
    dts_text: Slice[char]
    diagnostics: ref[Array[ref[DriverDiagnostic]]]
    ; the map files written before their outputs (empty for none), and the
    ; declaration text's sourceMappingURL position (-1 for none)
    js_map_path: Slice[char]
    js_map_text: Slice[char]
    dts_map_path: Slice[char]
    dts_map_text: Slice[char]
    dts_url_pos: int
)
{
    ; getTextHandlingSourceMapForSignature over the declaration text
    function dts_signature_text(this) returns Slice[char]
    {
        if dts_url_pos < 0
            return dts_text
        dts_text.subslice(0, dts_url_pos as size_t)
    }
}

define DriverProgram
(
    host: ref[Page]
    sys: ref[ExecSystem]
    options: EmitOptions
    ts: ref[TsOptions]
    pf: ref[ProgramFiles]
    root_names: ref[Array[Slice[char]]]
    loader: ref[ProgramLoader]?
    checker: ref[Checker]?
    ; the `createProgram` event, so that `load` can CLOSE it where the program is
    ; finished being created — upstream's `bindSourceFiles` is in tsc/emit.go,
    ; outside createProgram, and this port binds inside `load`
    cp_tid: int
    cp_args: ref[Array[ref[TraceArg]]]?
    config_path: Slice[char]
    config_text: Slice[char]
    config_diagnostics: ref[Array[ref[DriverDiagnostic]]]
    ; Program.Emit's answer
    emitted_files: ref[Array[Slice[char]]]
    emit_skipped: bool
    emit_diagnostics: ref[Array[ref[DriverDiagnostic]]]
    ; the lib chain's files, their paths and texts (a related diagnostic's file)
    lib_nodes: ref[Array[ref[AstNode]?]]
    lib_paths: ref[Array[Slice[char]]]
    lib_texts: ref[Array[Slice[char]]]
    ; the root config's parse (its project references), null without a config
    root_config: ref[TsParsedCommandLine]?
    ; the resolved project references (projectReferenceParser), shared with a build's
    ; other programs through `known_references`
    references: ref[Array[ref[ResolvedReference]]]
    root_references: ref[Array[int]]
    known_references: ref[Array[ref[ResolvedReference]]]?
    ; the command line's options a build host parses a reference with
    reference_options: ref[TsOptions]?
    reference_raw: ref[TsOptions]?
    ; verifyProjectReferences' diagnostics (a program diagnostic each)
    reference_diagnostics: ref[Array[ref[DriverDiagnostic]]]
    ; the lib chain's parsers (a program without a source file checks over a lib)
    lib_parsers: ref[Array[ref[Parser]?]]
    ; per entry of `references`: the indices of its own references in this program
    reference_children: ref[Array[ref[Array[int]]]]
    ; per lib file the lib file name it was loaded for (its path is a replacement's
    ; under libReplacement)
    lib_file_names: ref[Array[Slice[char]]]
    ; pathForLibFile's cache (the lib file name and its path) and, under
    ; libReplacement, each resolution's key (resolveFrom) and traces
    lib_resolution_names: ref[Array[Slice[char]]]
    lib_resolution_paths: ref[Array[Slice[char]]]
    lib_resolution_keys: ref[Array[Slice[char]]]
    lib_resolution_traces: ref[Array[ref[Array[String]]]]
)
{
    function create(host: ref[Page], sys: ref[ExecSystem], ts: ref[TsOptions], root_names: ref[Array[Slice[char]]], config_path: Slice[char], config_text: Slice[char], config_diagnostics: ref[Array[ref[DriverDiagnostic]]]) returns ref[DriverProgram]
    {
        let options DriverProgram.emit_options_of(host, ts, sys.cwd, config_path)
        let pf ProgramFiles.create(host)
        set pf.directory_paths: sys.directories
        set pf.case_insensitive: sys.case_sensitive = false
        &DriverProgram^host(host, sys, options, ts, pf, root_names, null, null, 0, null, config_path, config_text, config_diagnostics, &Array[Slice[char]]^host(), false, &Array[ref[DriverDiagnostic]]^host(), &Array[ref[AstNode]?]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), null, &Array[ref[ResolvedReference]]^host(), &Array[int]^host(), null, null, null, &Array[ref[DriverDiagnostic]]^host(), &Array[ref[Parser]?]^host(), &Array[ref[Array[int]]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[Slice[char]]^host(), &Array[ref[Array[String]]]^host())
    }

    ; ── project references ───────────────────────────────────────────────────

    ; host.GetResolvedProjectReference: the reference at `config`, parsed once;
    ; its index in `references`
    procedure resolve_reference(this, config: Slice[char]) returns int
    {
        var i 0
        while i < (references.get_length() as int)
        {
            let known references[i as size_t]
            if known.config.equals(config)
                return i
            set i: i + 1
        }
        var resolved: ref[ResolvedReference]? null
        if known_references <> null
        {
            let cache known_references as ref[Array[ref[ResolvedReference]]]
            var k 0
            while k < (cache.get_length() as int)
            {
                let candidate cache[k as size_t]
                if candidate.config.equals(config)
                    set resolved: candidate
                set k: k + 1
            }
        }
        if resolved = null
        {
            let made ConfigFiles.resolve(sys, config, reference_options, reference_raw)
            if made = null
                return 0 - 1
            set resolved: made
            if known_references <> null
                (known_references as ref[Array[ref[ResolvedReference]]]).add(made as ref[ResolvedReference])
        }
        let r resolved as ref[ResolvedReference]
        references.add(r)
        let children &Array[int]^host()
        reference_children.add(children)
        let index (references.get_length() as int) - 1
        if r.parsed <> null
        {
            let parsed r.parsed as ref[TsParsedCommandLine]
            if parsed.references <> null
            {
                let refs parsed.references as ref[Array[ProjectReference]]
                var c 0
                while c < (refs.get_length() as int)
                {
                    let child_reference refs[c as size_t]
                    let child_config ConfigFiles.config_of_reference(host, child_reference.path)
                    let child this.resolve_reference(child_config)
                    if (sys.stop_tag.length as int) > 0
                        return 0 - 1
                    children.add(child)
                    set c: c + 1
                }
            }
        }
        index
    }

    ; addProjectReferenceTasks and initMapper: the references parsed, every
    ; referenced project's sources mapped to their output declaration files (a
    ; later project overwriting an earlier one's entry); false after a stop
    procedure load_references(this, ld: ref[ProgramLoader]?) returns bool
    {
        if root_config = null
            return true
        let rc root_config as ref[TsParsedCommandLine]
        if rc.references = null
            return true
        let refs rc.references as ref[Array[ProjectReference]]
        var i 0
        while i < (refs.get_length() as int)
        {
            let root_reference refs[i as size_t]
            let index this.resolve_reference(ConfigFiles.config_of_reference(host, root_reference.path))
            if (sys.stop_tag.length as int) > 0
                return false
            root_references.add(index)
            set i: i + 1
        }
        if ld = null
            return true
        let loader_ref ld as ref[ProgramLoader]
        let seen &Array[int]^host()
        this.map_references(loader_ref, root_references, seen)
        true
    }

    ; the TS2878 comparison: the relative path between the root directories against
    ; the one between the output directories (an unset outDir is the root directory)
    procedure reference_rewrite_unsafe(this, reference_config: Slice[char], reference_options: ref[TsOptions]) returns bool
    {
        let cwd sys.cwd
        var own_root ts.text_of("rootDir")
        if (own_root.length as int) = 0
        {
            if (config_path.length as int) = 0
                return false
            set own_root: get_directory_path(host, get_normalized_absolute_path(host, config_path, cwd))
        }
        set own_root: get_normalized_absolute_path(host, own_root, cwd)
        var other_root reference_options.text_of("rootDir")
        if (other_root.length as int) = 0
            set other_root: get_directory_path(host, reference_config)
        set other_root: get_normalized_absolute_path(host, other_root, cwd)
        var own_out ts.text_of("outDir")
        if (own_out.length as int) = 0
            set own_out: own_root
        var other_out reference_options.text_of("outDir")
        if (other_out.length as int) = 0
            set other_out: other_root
        let root_path get_relative_path_to_directory_or_url(host, own_root, other_root, false, cwd)
        let out_path get_relative_path_to_directory_or_url(host, get_normalized_absolute_path(host, own_out, cwd), get_normalized_absolute_path(host, other_out, cwd), false, cwd)
        root_path.equals(out_path) = false
    }

    procedure map_references(this, ld: ref[ProgramLoader], list: ref[Array[int]], seen: ref[Array[int]])
    {
        var i 0
        while i < (list.get_length() as int)
        {
            let index list[i as size_t]
            set i: i + 1
            if index < 0
                continue
            var was_seen false
            var s 0
            while s < (seen.get_length() as int)
            {
                if seen[s as size_t] = index
                    set was_seen: true
                set s: s + 1
            }
            ; rangeResolvedProjectReference seeds the seen set with the root config
            let seen_ref references[index as size_t]
            let root_config_path get_normalized_absolute_path(host, config_path, sys.cwd)
            if seen_ref.config.equals(root_config_path)
                set was_seen: true
            if was_seen
                continue
            seen.add(index)
            let r references[index as size_t]
            if r.parsed <> null
            {
                let parsed r.parsed as ref[TsParsedCommandLine]
                if r.config.equals(config_path) = false
                {
                    ; the reference's options as the resolution redirect of its files
                    let redirect_index ld.redirect_configs.get_length() as int
                    ld.redirect_configs.add(r.config)
                    ld.redirect_options.add(DriverProgram.emit_options_of(host, parsed.options, sys.cwd, r.config))
                    let redirect_paths_value parsed.options.get("paths")
                    ld.redirect_path_options.add(redirect_paths_value)
                    var redirect_base sys.cwd
                    let recorded_base parsed.options.text_of("pathsBasePath")
                    if (recorded_base.length as int) > 0
                        set redirect_base: get_normalized_absolute_path(host, recorded_base, sys.cwd)
                    ld.redirect_paths_bases.add(redirect_base)
                    var f 0
                    while f < (parsed.file_names.get_length() as int)
                    {
                        let source get_normalized_absolute_path(host, parsed.file_names[f as size_t], sys.cwd)
                        set f: f + 1
                        var output Slice[char]()
                        if (is_declaration_file_name_of(source) = false) and (source.ends_with(".json") = false)
                        {
                            set output: ConfigFiles.declaration_output_path(host, r.config, parsed.options, source, sys.cwd)
                            let di pf.index_of_path(output)
                            if di >= 0
                            {
                                let po parsed.options
                                pf.set_reference_dts_preserve(di, (po.tristate_of("preserveConstEnums") = 1) or (po.tristate_of("isolatedModules") = 1) or (po.tristate_of("verbatimModuleSyntax") = 1))
                                ; getCompilerOptionsForFile: the referenced project's options
                                var ro DriverProgram.emit_options_of(host, po, sys.cwd, r.config)
                                set ro.package_json_type: this.unit_package_json_type(output)
                                pf.set_reference_module_format(di, ro.get_emit_module_format_of_file(output))
                            }
                        }
                        if this.reference_rewrite_unsafe(r.config, parsed.options)
                        {
                            let rsi pf.index_of_path(source)
                            if rsi >= 0
                                pf.set_reference_rewrite_unsafe(rsi)
                            if (output.length as int) > 0
                            {
                                let roi pf.index_of_path(output)
                                if roi >= 0
                                    pf.set_reference_rewrite_unsafe(roi)
                            }
                        }
                        let redirect_source_index pf.index_of_path(source)
                        let redirect_suffixes (ld.redirect_options[redirect_index as size_t]).module_suffixes
                        if redirect_source_index >= 0
                        {
                            pf.set_redirect_paths(redirect_source_index, redirect_paths_value, redirect_base)
                            pf.set_redirect_suffixes(redirect_source_index, redirect_suffixes)
                        }
                        if (output.length as int) > 0
                        {
                            let redirect_output_index pf.index_of_path(output)
                            if redirect_output_index >= 0
                            {
                                pf.set_redirect_paths(redirect_output_index, redirect_paths_value, redirect_base)
                                pf.set_redirect_suffixes(redirect_output_index, redirect_suffixes)
                            }
                        }
                        var replaced false
                        var k 0
                        while k < (ld.reference_sources.get_length() as int)
                        {
                            let known ld.reference_sources[k as size_t]
                            if known.equals(source)
                            {
                                ld.reference_outputs.put(k as size_t, output)
                                ld.reference_redirects.put(k as size_t, redirect_index)
                                set replaced: true
                            }
                            set k: k + 1
                        }
                        if replaced = false
                        {
                            ld.reference_sources.add(source)
                            ld.reference_outputs.add(output)
                            ld.reference_redirects.add(redirect_index)
                        }
                    }
                }
            }
            this.map_references(ld, reference_children[index as size_t], seen)
        }
    }

    ; the redirects the checker follows (GetSourceFileForResolvedModule) and the
    ; outputs it names when one was not built
    procedure apply_reference_redirects(this, ld: ref[ProgramLoader])
    {
        var i 0
        while i < (ld.reference_sources.get_length() as int)
        {
            let source ld.reference_sources[i as size_t]
            let output ld.reference_outputs[i as size_t]
            set i: i + 1
            if (output.length as int) = 0
                continue
            let source_node ld.find_node(source)
            if source_node <> null
            {
                if (source_node as ref[LoaderNode]).redirected
                    pf.add_included_output(output, source)
            }
            let si pf.index_of_path(source)
            if si < 0
                continue
            pf.set_reference_output(si, output)
            let di pf.index_of_path(output)
            if (di >= 0) and ld.holds(di)
                pf.set_redirect(si, di)
        }
    }

    ; verifyProjectReferences over RangeResolvedProjectReference
    procedure verify_project_references(this, ld: ref[ProgramLoader]?)
    {
        if root_config = null
            return
        let build_info_name ConfigFiles.build_info_file_name_of(host, ts, config_path, sys.cwd)
        let seen &Array[int]^host()
        this.verify_references_of(root_config as ref[TsParsedCommandLine], config_path, config_text, root_references, seen, build_info_name, ld)
    }

    procedure verify_references_of(this, parent: ref[TsParsedCommandLine], parent_path: Slice[char], parent_text: Slice[char], list: ref[Array[int]], seen: ref[Array[int]], build_info_name: Slice[char], ld: ref[ProgramLoader]?)
    {
        if parent.references = null
            return
        let refs parent.references as ref[Array[ProjectReference]]
        var i 0
        while i < (list.get_length() as int)
        {
            let index list[i as size_t]
            let position i
            set i: i + 1
            if index < 0
                continue
            var was_seen false
            var s 0
            while s < (seen.get_length() as int)
            {
                if seen[s as size_t] = index
                    set was_seen: true
                set s: s + 1
            }
            ; rangeResolvedProjectReference seeds the seen set with the root config
            let seen_ref references[index as size_t]
            let root_config_path get_normalized_absolute_path(host, config_path, sys.cwd)
            if seen_ref.config.equals(root_config_path)
                set was_seen: true
            if was_seen
                continue
            seen.add(index)
            let r references[index as size_t]
            let reference_entry refs[position as size_t]
            let ref_path reference_entry.path
            if r.parsed = null
            {
                this.add_reference_diagnostic(parent, parent_path, parent_text, position, DiagFile_0_not_found, ref_path, Slice[char]())
                continue
            }
            let config r.parsed as ref[TsParsedCommandLine]
            let composite config.options.tristate_of("composite") = 1
            let no_emit config.options.tristate_of("noEmit") = 1
            if ((composite = false) or no_emit) and (parent.file_names.get_length() > 0)
            {
                if composite = false
                    this.add_reference_diagnostic(parent, parent_path, parent_text, position, DiagReferenced_project_0_must_have_setting_composite_Colon_true, ref_path, Slice[char]())
                if no_emit
                    this.add_reference_diagnostic(parent, parent_path, parent_text, position, DiagReferenced_project_0_may_not_disable_emit, ref_path, Slice[char]())
            }
            if (build_info_name.length as int) > 0
            {
                let ref_build_info ConfigFiles.build_info_file_name_of(host, config.options, r.config, sys.cwd)
                if build_info_name.equals(ref_build_info)
                {
                    this.add_reference_diagnostic(parent, parent_path, parent_text, position, DiagCannot_write_file_0_because_it_will_overwrite_tsbuildinfo_file_generated_by_referenced_project_1, build_info_name, ref_path)
                    if ld <> null
                        (ld as ref[ProgramLoader]).blocked_paths.add(build_info_name)
                }
            }
            this.verify_references_of(config, r.config, r.text, reference_children[index as size_t], seen, build_info_name, ld)
        }
    }

    ; CreateDiagnosticAtReferenceSyntax, else a compiler diagnostic
    procedure add_reference_diagnostic(this, parent: ref[TsParsedCommandLine], parent_path: Slice[char], parent_text: Slice[char], position: int, code: int, a0: Slice[char], a1: Slice[char])
    {
        let args ProgramDiagnostic.args1(host, ProgramDiagnostic.text(a0))
        if (a1.length as int) > 0
            args.add(ProgramDiagnostic.text(a1))
        let none: Slice[char] ""
        if ((2 * position + 1) < (parent.reference_ranges.get_length() as int))
            reference_diagnostics.add(&DriverDiagnostic^host(parent_path, parent_text, parent.reference_ranges[(2 * position) as size_t], parent.reference_ranges[(2 * position + 1) as size_t], code, args, null, null))
        else
            reference_diagnostics.add(&DriverDiagnostic^host(none, none, 0, 0, code, args, null, null))
    }

    ; the compiler options as the case yardsticks spell them (`name=value`, the
    ; name lower-cased), over the current directory and the config file's path
    function emit_options_of(host: ref[Page], ts: ref[TsOptions], cwd: Slice[char], config_path: Slice[char]) returns EmitOptions
    {
        var o EmitOptions.defaults()
        var i 0
        while i < ts.count()
        {
            let v ts.value_at(i)
            let name ts.name_at(i)
            set i: i + 1
            if v = null
                continue
            set o: EmitOptions.apply(o, TsConfigParser.to_lower(host, name), TsOptions.render(host, v as ref[JsonValue]))
        }
        ; GetAllowJS: an unset allowJs follows checkJs
        if (ts.tristate_of("allowJs") < 0) and (ts.tristate_of("checkJs") = 1)
            set o: EmitOptions.apply(o, "allowjs", "true")
        set o: EmitOptions.apply(o, "currentdirectory", cwd)
        if (config_path.length as int) > 0
            set o: EmitOptions.apply(o, "configfilepath", config_path)
        o
    }

    function flag(this, name: Slice[char]) returns bool
        ts.tristate_of(name) = 1

    procedure stop(this, tag: Slice[char])
        sys.stop(tag)

    function stopped(this) returns bool
        (sys.stop_tag.length as int) > 0

    ; ── NewProgram ───────────────────────────────────────────────────────────

    function source_extension(path: Slice[char]) returns bool
    {
        if path.ends_with(".ts") or path.ends_with(".tsx") or path.ends_with(".mts") or path.ends_with(".cts")
            return true
        if path.ends_with(".js") or path.ends_with(".jsx") or path.ends_with(".mjs") or path.ends_with(".cjs")
            return true
        path.ends_with(".json")
    }

    function under_directory(path: Slice[char], directory: Slice[char]) returns bool
    {
        if path.length <= directory.length
            return false
        if path.starts_with(directory) = false
            return false
        (*(path.data + directory.length) as int) = ("/" as char) as int
    }

    ; an option value TS7 removed (verifyCompilerOptions' createRemovedOptionDiagnostic,
    ; which this port reports only for downlevelIteration: the case yardsticks skip a
    ; configuration carrying the others, and so does the driver)
    function uses_removed_option(this) returns bool
    {
        if ((ts.text_of("baseUrl").length as int) > 0) or ((ts.text_of("outFile").length as int) > 0)
            return true
        let module_kind TsConfigParser.to_lower(host, TsOptions.render(host, this.value_or_empty("module")))
        if module_kind.equals("amd") or module_kind.equals("system") or module_kind.equals("umd") or module_kind.equals("2") or module_kind.equals("3") or module_kind.equals("4")
            return true
        let resolution TsConfigParser.to_lower(host, TsOptions.render(host, this.value_or_empty("moduleResolution")))
        resolution.equals("classic") or resolution.equals("node10") or resolution.equals("node") or resolution.equals("1") or resolution.equals("2")
    }

    ; verifyCompilerOptions' paths loop would report: a key or substitution with
    ; two stars, a substitution list that is not a non-empty array, a substitution
    ; neither relative nor absolute
    function paths_need_validation(paths: ref[JsonValue]) returns bool
    {
        if paths.kind <> JsonKindObject
            return true
        var i 0
        while i < paths.size()
        {
            let key paths.key_at(i)
            let value paths.value_at(i)
            set i: i + 1
            if DriverProgram.star_count(key) > 1
                return true
            if value = null
                return true
            let list value as ref[JsonValue]
            if list.kind <> JsonKindArray
                return true
            if list.size() = 0
                return true
            var k 0
            while k < list.size()
            {
                let element list.value_at(k)
                set k: k + 1
                if element = null
                    return true
                let e element as ref[JsonValue]
                if e.kind <> JsonKindString
                    return true
                if DriverProgram.star_count(e.text) > 1
                    return true
                if (path_is_relative(e.text) = false) and (get_root_length(e.text) = 0)
                    return true
            }
        }
        false
    }

    function star_count(text: Slice[char]) returns int
    {
        var n 0
        var i 0
        while i < (text.length as int)
        {
            if (text[i as size_t] as int) = ("*" as char) as int
                set n: n + 1
            set i: i + 1
        }
        n
    }

    function value_or_empty(this, name: Slice[char]) returns ref[JsonValue]
    {
        let v ts.get(name)
        if v = null
            return &JsonValue^host(JsonKindString, Slice[char](), false, null, null)
        v as ref[JsonValue]
    }

    ; the program; false after a stop
    procedure load(this) returns bool
    {
        if this.uses_removed_option()
        {
            this.stop("removed-option")
            return false
        }
        ; compilerOptions.paths: the resolver's optional resolution setting; its
        ; validation diagnostics are a stop
        let paths_value ts.get("paths")
        if paths_value <> null
        {
            let pv paths_value as ref[JsonValue]
            if DriverProgram.paths_need_validation(pv)
            {
                this.stop("paths-validation")
                return false
            }
            var paths_base sys.cwd
            let recorded_base ts.text_of("pathsBasePath")
            if (recorded_base.length as int) > 0
                set paths_base: get_normalized_absolute_path(host, recorded_base, sys.cwd)
            pf.set_paths(pv, paths_base)
        }
        let cwd options.get_current_directory()
        var fi 0
        while fi < (sys.files.get_length() as int)
        {
            let entry sys.files[fi as size_t]
            set fi: fi + 1
            if entry = null
                continue
            let f entry as ref[VfsFile]
            if f.is_link
            {
                pf.add_link(f.path, f.link_target)
                continue
            }
            if DriverProgram.under_directory(f.path, sys.default_library_path)
                continue
            ; ★★★ THE SWEEP REGISTERS AND NO LONGER PARSES (slice 292). Every
            ; entry of the test filesystem goes into the table as a PATH and its
            ; RAW TEXT; `ProgramLoader.ensure_parsed` parses and binds one the
            ; first time the walk reaches it, which is what `fileLoader`
            ; does — and is why the config file is no longer parsed as a source
            ; file, why the libs are parsed before the unit, and why a program
            ; stops reading files it never asks for.
            ExecSystem.register_in(pf, f.path, f)
        }
        ; preserveSymlinks: a file reached through a symlink is a file of its own
        ; at the symlinked path
        if EmitOptions.on(options.preserve_symlinks)
        {
            set pf.preserve_symlinks: true
            var li 0
            while li < (sys.files.get_length() as int)
            {
                let link_entry sys.files[li as size_t]
                set li: li + 1
                if link_entry = null
                    continue
                let link link_entry as ref[VfsFile]
                if link.is_link = false
                    continue
                var ti 0
                while ti < (sys.files.get_length() as int)
                {
                    let target_entry sys.files[ti as size_t]
                    set ti: ti + 1
                    if target_entry = null
                        continue
                    let tf target_entry as ref[VfsFile]
                    if tf.is_link
                        continue
                    var linked Slice[char]()
                    if tf.path.equals(link.link_target)
                        set linked: link.path
                    else
                    {
                        if DriverProgram.under_directory(tf.path, link.link_target)
                            set linked: join_slices(host, link.path, tf.path.slice_from(link.link_target.length))
                    }
                    if (linked.length as int) = 0
                        continue
                    if pf.index_of_exact_path(linked) >= 0
                        continue
                    if DriverProgram.source_extension(linked) = false
                        ExecSystem.register_in(pf, linked, tf)
                    else
                    {
                        ExecSystem.register_in(pf, linked, tf)
                    }
                }
            }
        }
        if (config_path.length as int) > 0
            pf.set_config(config_path, config_text)
        set pf.module_suffixes: options.module_suffixes
        let custom options.custom_condition_list(host)
        var cc 0
        while cc < (custom.get_length() as int)
        {
            pf.add_custom_condition(custom[cc as size_t])
            set cc: cc + 1
        }
        var decl_dir Slice[char]()
        if (options.declaration_dir.length as int) > 0
            set decl_dir: get_normalized_absolute_path(host, options.declaration_dir, cwd)
        pf.set_output_options(decl_dir, config_path, cwd)
        var ti 0
        while ti < pf.count()
        {
            var uo options
            set uo.package_json_type: this.unit_package_json_type(pf.path_at(ti))
            pf.set_format(ti, uo.get_emit_module_format_of_file(pf.path_at(ti)))
            pf.set_package_json_type(ti, uo.package_json_type)
            set ti: ti + 1
        }
        ; processAllProgramFiles: no root file, no lib and no file at all
        if root_names.get_length() = 0
        {
            if this.load_references(null) = false
                return false
            this.verify_project_references(null)
            return true
        }
        var first 0 - 1
        let lib_files &Array[ref[AstNode]?]^host()
        let lib_binders &Array[ref[Binder]?]^host()
        let seen &Array[Slice[char]]^host()
        ; pathForLibFile resolves through the loader's resolver, whose package.json
        ; lookups the program keeps
        if this.flag("libReplacement")
            set pf.package_json_recording: true
        if this.load_lib_chain(options.lib_names(host), lib_files, lib_binders, seen) = false
            return false
        this.sort_libs(lib_files, lib_binders)
        let o options
        Checker.set_strict_null_checks(o.strict_null_checks_on())
        Checker.set_exact_optional_property_types(o.exact_optional_property_types_on())
        Checker.set_options(o.strict_option_on(o.no_implicit_any), o.strict_option_on(o.no_implicit_this), o.strict_option_on(o.use_unknown_in_catch_variables), o.strict_option_on(o.strict_property_initialization), o.strict_option_on(o.strict_function_types), o.strict_option_on(o.strict_bind_call_apply), o.strict_option_on(o.strict_builtin_iterator_return), o.check_js, EmitOptions.on(o.no_implicit_returns), EmitOptions.on(o.no_unchecked_indexed_access), EmitOptions.on(o.no_property_access_from_index_signature))
        Checker.set_resolution_options(EmitOptions.on(o.allow_importing_ts_extensions), EmitOptions.on(o.allow_arbitrary_extensions), EmitOptions.on(o.rewrite_relative_import_extensions), o.no_implicit_any_explicit())
        Checker.set_unused_options(EmitOptions.on(o.no_unused_locals), EmitOptions.on(o.no_unused_parameters))
        Checker.set_no_emit(EmitOptions.on(o.no_emit))
        Checker.set_lib_option_has_dom(o.lib_option_has_dom())
        Checker.set_report_options(o.allow_unreachable_code, o.allow_unused_labels, EmitOptions.on(o.no_fallthrough_cases_in_switch), EmitOptions.on(o.allow_umd_global_access))
        ; ★★★ NO CHECKER HERE SINCE SLICE 293. This call built a checker whose ONLY
        ; reader was the loader — the program's real one is built after the walk,
        ; below, exactly as the reference's `GetTypeChecker` is asked after
        ; `createProgram` returns. Its four questions are pure and are answered by
        ; `ResolutionContext` now, which is what freed the bind to become a pass.
        let ld ProgramLoader.create(host, pf, options, null)
        set ld.trace_resolution: this.flag("traceResolution")
        set ld.tracing: sys.tracing
        pf.enable_resolution_records()
        set pf.package_json_recording: true
        if this.load_references(ld) = false
            return false
        ld.load(root_names)
        if (ld.stop_tag.length as int) > 0
        {
            this.stop(ld.stop_tag)
            return false
        }
        ; processLibReferenceDirectives: a program file's `/// <reference lib>` brings
        ; its library in, and in collectFiles' order the directives' libraries come
        ; before compilerOptions' (the program's checker is made over the set below)
        if ld.lib_ref_names.get_length() > 0
        {
            lib_files.clear()
            lib_binders.clear()
            seen.clear()
            lib_nodes.clear()
            lib_paths.clear()
            lib_texts.clear()
            lib_parsers.clear()
            lib_file_names.clear()
            if this.load_lib_chain(ld.lib_ref_names, lib_files, lib_binders, seen) = false
                return false
            if this.load_lib_chain(options.lib_names(host), lib_files, lib_binders, seen) = false
                return false
            this.sort_libs(lib_files, lib_binders)
        }
        var k 0
        while k < pf.count()
        {
            ; ★The FIRST PROGRAM FILE of the table, the seed the checker is built
            ; over (its program files are selected one by one afterwards). Until
            ; 2026-09-16 this took the table's first source-extension entry and
            ; PARSED it eagerly, program file or not — a stray `.ts` nobody imports
            ; seeded the checker, and once the bind pass ran over the program's
            ; files only (as upstream's does) that seed had no binder (§3.5le).
            if (first < 0) and ld.holds(k) and (pf.file_at(k) <> null)
                set first: k
            set k: k + 1
        }
        this.close_create_program()
        ; ★★★ tsc/emit.go's `bindSourceFiles`: its own block after createProgram
        ; closes, the program's files first and the libraries after.
        let bsf_tid sys.trace_push(TracePhaseBind, "bindSourceFiles", null)
        let bound ld.bind_all()
        var libs_bound true
        if bound
            set libs_bound: this.bind_lib_chain(lib_files, lib_binders, lib_paths, lib_texts)
        sys.trace_pop(bsf_tid, TracePhaseBind, "bindSourceFiles", null)
        if bound = false
        {
            this.stop(ld.stop_tag)
            return false
        }
        if libs_bound = false
            return false
        ; no root file names a source file: the checker runs over the libraries alone
        if (first < 0) and (lib_files.get_length() = 0)
        {
            this.stop("program-without-source")
            return false
        }
        ; the compiler host's Trace over collectFiles' traces
        var tl 0
        while tl < (ld.trace_lines.get_length() as int)
        {
            let trace_line ld.trace_lines[tl as size_t]
            sys.trace(Slice[char](trace_line.get_length(), trace_line.get_buffer() as pointer[char]))
            set tl: tl + 1
        }
        ; pathForLibFileResolutions' traces, by key
        let lib_keys &Array[Slice[char]]^host()
        var lk 0
        while lk < (lib_resolution_keys.get_length() as int)
        {
            IncSort.insert_sorted(lib_keys, lib_resolution_keys[lk as size_t])
            set lk: lk + 1
        }
        var sk 0
        while sk < (lib_keys.get_length() as int)
        {
            let key lib_keys[sk as size_t]
            set sk: sk + 1
            var at 0
            while at < (lib_resolution_keys.get_length() as int)
            {
                let candidate lib_resolution_keys[at as size_t]
                if candidate.equals(key)
                    break
                set at: at + 1
            }
            let traces lib_resolution_traces[at as size_t]
            var t 0
            while t < (traces.get_length() as int)
            {
                let line traces[t as size_t]
                sys.trace(Slice[char](line.get_length(), line.get_buffer() as pointer[char]))
                set t: t + 1
            }
        }
        pf.set_members(ld.members)
        pf.set_order(ld.program_files)
        ; loadSourceFileMetaData's scope lookup of every file the program holds
        var mi 0
        while mi < (ld.program_files.get_length() as int)
        {
            pf.package_json_type_of(host, pf.path_at(ld.program_files[mi as size_t]))
            set mi: mi + 1
        }
        var ei 0
        while ei < pf.count()
        {
            pf.set_emit(ei, ld.holds(ei) and ld.source_file_may_be_emitted(ei))
            set ei: ei + 1
        }
        ; the program's checker, `GetTypeChecker` after createProgram: the file
        ; table is complete, the members are set and every file is bound
        Checker.set_defer_initialize(true)
        let pc this.checker_over(first, lib_files, lib_binders)
        set pc.record_events: false
        Checker.set_defer_initialize(false)
        this.apply_checker_options(pc)
        pc.set_message_specifiers(SpecifierHost.create(host, pc, pf, options))
        ld.set_checker(pc)
        let removed_false &Array[Slice[char]]^host()
        if ts.tristate_of("alwaysStrict") = 0
            removed_false.add("alwaysStrict")
        if ts.tristate_of("esModuleInterop") = 0
            removed_false.add("esModuleInterop")
        if ts.tristate_of("allowSyntheticDefaultImports") = 0
            removed_false.add("allowSyntheticDefaultImports")
        ld.verify_compiler_options(removed_false)
        if (ld.stop_tag.length as int) > 0
        {
            this.stop(ld.stop_tag)
            return false
        }
        this.verify_project_references(ld)
        this.apply_reference_redirects(ld)
        set this.loader: ld
        let mark pc.unported_mark()
        let log_before Checker.stop_count(pc)
        pc.initialize_checker()
        if this.checker_stopped(pc, mark, log_before)
            return false
        set this.checker: pc
        true
    }

    function checker_over(this, first: int, lib_files: ref[Array[ref[AstNode]?]], lib_binders: ref[Array[ref[Binder]?]]) returns ref[Checker]
    {
        var lib_file: ref[AstNode]? null
        var lib_b: ref[Binder]? null
        var extra_files: ref[Array[ref[AstNode]?]]? null
        var extra_binders: ref[Array[ref[Binder]?]]? null
        if first < 0
        {
            ; the first library in the main file's place, the rest as extra files
            let ef &Array[ref[AstNode]?]^host()
            let eb &Array[ref[Binder]?]^host()
            var xi 1
            while xi < (lib_files.get_length() as int)
            {
                ef.add(lib_files[xi as size_t])
                eb.add(lib_binders[xi as size_t])
                set xi: xi + 1
            }
            if ef.get_length() > 0
            {
                set extra_files: ef
                set extra_binders: eb
            }
            let lib_path0 lib_paths[0]
            return Checker.create_ex(host, lib_files[0] as ref[AstNode], String(lib_path0.data as pointer[const_char], lib_path0.length as size_t), lib_binders[0] as ref[Binder], lib_parsers[0] as ref[Parser], lib_files[0], lib_binders[0], extra_files, extra_binders, pf)
        }
        if lib_files.get_length() > 0
        {
            set lib_file: lib_files[0]
            set lib_b: lib_binders[0]
        }
        if lib_files.get_length() > 1
        {
            let ef &Array[ref[AstNode]?]^host()
            let eb &Array[ref[Binder]?]^host()
            var li 1
            while li < (lib_files.get_length() as int)
            {
                ef.add(lib_files[li as size_t])
                eb.add(lib_binders[li as size_t])
                set li: li + 1
            }
            set extra_files: ef
            set extra_binders: eb
        }
        let path0 pf.path_at(first)
        Checker.create_ex(host, pf.file_at(first) as ref[AstNode], String(path0.data as pointer[const_char], path0.length as size_t), pf.binder_at(first) as ref[Binder], pf.parser_at(first) as ref[Parser], lib_file, lib_b, extra_files, extra_binders, pf)
    }

    procedure apply_checker_options(this, cd: ref[Checker])
    {
        cd.set_lib_chain(lib_parsers, lib_paths)
        let o options
        set cd.module_kind: o.get_emit_module_kind()
        set cd.language_version: o.get_emit_script_target()
        set cd.use_define_for_class_fields: o.get_use_define_for_class_fields()
        set cd.emit_standard_class_fields: o.get_emit_standard_class_fields()
        set cd.legacy_decorators: EmitOptions.on(o.experimental_decorators)
        set cd.emit_decorator_metadata: EmitOptions.on(o.emit_decorator_metadata)
        set cd.verbatim_module_syntax: EmitOptions.on(o.verbatim_module_syntax)
        set cd.isolated_modules: EmitOptions.on(o.isolated_modules)
        set cd.preserve_const_enums: EmitOptions.on(o.preserve_const_enums)
        set cd.module_resolution_kind: o.get_module_resolution_kind()
        set cd.resolve_json_module: o.get_resolve_json_module()
        set cd.import_helpers: EmitOptions.on(o.import_helpers)
        set cd.erasable_syntax_only: EmitOptions.on(o.erasable_syntax_only)
        set cd.no_unchecked_side_effect_imports: EmitOptions.true_or_unknown(o.no_unchecked_side_effect_imports)
        set cd.no_implicit_override: EmitOptions.on(o.no_implicit_override)
        set cd.allow_js: EmitOptions.on(o.allow_js)
        set cd.resolve_package_json_exports: o.resolve_package_json_exports
        set cd.resolve_package_json_imports: o.resolve_package_json_imports
        set cd.jsx_emit: o.jsx
        set cd.jsx_factory_option: o.jsx_factory
        set cd.react_namespace_option: o.react_namespace
        set cd.jsx_fragment_factory_option: o.jsx_fragment_factory
        set cd.jsx_import_source_option: o.jsx_import_source
        cd.set_program_directories(o.out_dir, o.project_root_directory(host), o.get_current_directory())
    }

    ; TSCALY_STATS: the program's persistent structures by COUNT — nodes, flow nodes,
    ; symbols, types, signatures and every table row the checker holds — so a memory
    ; measurement can price them with the layouts and see what the rest is
    procedure report_stats(this)
    {
        if Checker.stats_enabled() = false
            return
        var nodes 0
        var flow_nodes 0
        var binder_symbols 0
        var i 0
        while i < pf.count()
        {
            let p pf.parser_at(i)
            if p <> null
            {
                let pp p as ref[Parser]
                set nodes: nodes + pp.nodes_allocated
            }
            let b pf.binder_at(i)
            if b <> null
            {
                let bb b as ref[Binder]
                set flow_nodes: flow_nodes + bb.flow_nodes_allocated
                set binder_symbols: binder_symbols + bb.symbol_count
            }
            set i: i + 1
        }
        var l 0
        while l < (lib_parsers.get_length() as int)
        {
            let lp lib_parsers[l as size_t]
            if lp <> null
            {
                let lpp lp as ref[Parser]
                set nodes: nodes + lpp.nodes_allocated
            }
            set l: l + 1
        }
        Checker.report_stat("parser_nodes", nodes)
        Checker.report_stat("binder_flow_nodes", flow_nodes)
        Checker.report_stat("binder_symbols", binder_symbols)
        if checker = null
            return
        let cd checker as ref[Checker]
        Checker.report_stat("checker_nodes", cd.nodes_allocated)
        Checker.report_stat("checker_flow_nodes", cd.flow_nodes_allocated)
        Checker.report_stat("checker_symbols", cd.symbols_allocated)
        Checker.report_stat("types", cd.type_count)
        Checker.report_stat("signatures", cd.signature_count)
        Checker.report_stat("instantiations", cd.instantiation_count)
        Checker.report_stat("table pattern_augmentation_symbols", cd.pattern_augmentation_symbols.get_length() as int)
        Checker.report_stat("table iteration_types_cache", cd.iteration_types_cache.get_length() as int)
        Checker.report_stat("table awaited_type_links", cd.awaited_type_links.get_length() as int)
        Checker.report_stat("table promised_type_links", cd.promised_type_links.get_length() as int)
        Checker.report_stat("table awaited_type_stack", cd.awaited_type_stack.get_length() as int)
        Checker.report_stat("table array_literal_type_links", cd.array_literal_type_links.get_length() as int)
        Checker.report_stat("table evolving_array_type_links", cd.evolving_array_type_links.get_length() as int)
        Checker.report_stat("table flow_type_cache", cd.flow_type_cache.get_length() as int)
        Checker.report_stat("table context_free_types", cd.context_free_types.get_length() as int)
        Checker.report_stat("table flow_loop_cache", cd.flow_loop_cache.get_length() as int)
        Checker.report_stat("table assertion_links", cd.assertion_links.get_length() as int)
        Checker.report_stat("table tuple_targets", cd.tuple_targets.get_length() as int)
        Checker.report_stat("table index_types", cd.index_types.get_length() as int)
        Checker.report_stat("table indexed_access_types", cd.indexed_access_types.get_length() as int)
        Checker.report_stat("table substitution_types", cd.substitution_types.get_length() as int)
        Checker.report_stat("table union_types", cd.union_types.get_length() as int)
        Checker.report_stat("table intersection_types", cd.intersection_types.get_length() as int)
        Checker.report_stat("table subtype_reduction_cache", cd.subtype_reduction_cache.get_length() as int)
        Checker.report_stat("table string_literal_types", cd.string_literal_types.get_length() as int)
        Checker.report_stat("table template_literal_types", cd.template_literal_types.get_length() as int)
        Checker.report_stat("table string_mapping_types", cd.string_mapping_types.get_length() as int)
        Checker.report_stat("table number_literal_types", cd.number_literal_types.get_length() as int)
        Checker.report_stat("table bigint_literal_types", cd.bigint_literal_types.get_length() as int)
        Checker.report_stat("table reported_ambient", cd.reported_ambient.get_length() as int)
        Checker.report_stat("table renamed_binding_elements_in_types", cd.renamed_binding_elements_in_types.get_length() as int)
        Checker.report_stat("table identifier_check_nodes", cd.identifier_check_nodes.get_length() as int)
        Checker.report_stat("table deferred_nodes", cd.deferred_nodes.get_length() as int)
        Checker.report_stat("table declared_type_links", cd.declared_type_links.get_length() as int)
        Checker.report_stat("table widened_type_links", cd.widened_type_links.get_length() as int)
        Checker.report_stat("table regular_object_literal_type_links", cd.regular_object_literal_type_links.get_length() as int)
        Checker.report_stat("table apparent_type_links", cd.apparent_type_links.get_length() as int)
