    ; a checker stop since `mark` is the step's stop, tagged with its first event
    procedure checker_stopped(this, cd: ref[Checker], mark: int, log_before: int) returns bool
    {
        if cd.unported_mark() = mark
            return false
        var tag: Slice[char] "checker-stop"
        if Checker.stop_count(cd) > log_before
            set tag: Checker.stop_tag_at(cd, log_before)
        this.stop(tag)
        true
    }

    ; SourceFileMetaData.PackageJsonType as the case yardstick computes it
    function unit_package_json_type(this, path: Slice[char]) returns Slice[char]
    {
        let t pf.package_json_type_of(host, path)
        if (t.length as int) = 0
            return t
        var under_node_modules false
        var i 0
        while (i + 14) <= (path.length as int)
        {
            let piece path.subslice(i as size_t, (i + 14) as size_t)
            if piece.equals("/node_modules/")
                set under_node_modules: true
            set i: i + 1
        }
        if under_node_modules
            return t
        if path.ends_with(".mts") or path.ends_with(".cts") or path.ends_with(".mjs") or path.ends_with(".cjs")
            return Slice[char]()
        if options.module_resolution_is_node()
            return t
        Slice[char]()
    }

    procedure close_create_program(this)
    {
        if cp_tid = 0
            return
        sys.trace_pop(cp_tid, TracePhaseProgram, "createProgram", cp_args)
        set this.cp_tid: 0
    }

    ; the library half of `bindSourceFiles`
    procedure bind_lib_chain(this, lib_files: ref[Array[ref[AstNode]?]], lib_binders: ref[Array[ref[Binder]?]], paths: ref[Array[Slice[char]]], texts: ref[Array[Slice[char]]]) returns bool
    {
        ; the libraries come FIRST in `SourceFiles()`, so the stack pops them LAST
        ; and in reverse — see ProgramLoader.bind_all's note
        var i (lib_files.get_length() as int) - 1
        while i >= 0
        {
            let lf lib_files[i as size_t]
            if (lf <> null) and (lib_binders[i as size_t] = null)
            {
                let lib_path paths[i as size_t]
                let path String^host(lib_path.data as pointer[const_char], lib_path.length as size_t)
                let raw texts[i as size_t]
                let text String^host(raw.data as pointer[const_char], raw.length as size_t)
                let is_external Parser.external_module_indicator(lf as ref[AstNode], AstNode.statements_of(lf as ref[AstNode]))
                let lbs Tracing.no_args(host)
                Tracing.add_arg(host, lbs, "path", lib_path)
                let lbs_tid sys.trace_push(TracePhaseBind, "bindSourceFile", lbs)
                let lb Binder.bind_source_file(host, lf as ref[AstNode], text, path, is_external)
                sys.trace_pop(lbs_tid, TracePhaseBind, "bindSourceFile", lbs)
                if Binder.unported_at(lb) >= 0
                {
                    this.stop(Binder.unported_tag_at(lb))
                    return false
                }
                lib_binders.put(i as size_t, lb)
            }
            set i: i - 1
        }
        true
    }

    ; fileLoader.sortLibs: lib.d.ts and lib.es6.d.ts first, then by the lib's
    ; position in tsoptions.Libs (stable)
    procedure sort_libs(this, files: ref[Array[ref[AstNode]?]], binders: ref[Array[ref[Binder]?]])
    {
        let n lib_paths.get_length() as int
        let priorities &Array[int]^host()
        var i 0
        while i < n
        {
            let lib_path lib_paths[i as size_t]
            if DriverProgram.under_directory(lib_path, sys.default_library_path)
                priorities.add(DriverProgram.lib_priority(host, lib_path))
            else
                priorities.add(DriverProgram.lib_priority(host, "x"))
            set i: i + 1
        }
        var k 1
        while k < n
        {
            var j k
            while j > 0
            {
                if priorities[(j - 1) as size_t] <= priorities[j as size_t]
                    break
                DriverProgram.swap_int(priorities, j)
                DriverProgram.swap_slice(lib_paths, j)
                DriverProgram.swap_slice(lib_file_names, j)
                DriverProgram.swap_slice(lib_texts, j)
                DriverProgram.swap_node(lib_nodes, j)
                DriverProgram.swap_node(files, j)
                let lpj lib_parsers[j as size_t]
                lib_parsers.put(j as size_t, lib_parsers[(j - 1) as size_t])
                lib_parsers.put((j - 1) as size_t, lpj)
                let b binders[j as size_t]
                binders.put(j as size_t, binders[(j - 1) as size_t])
                binders.put((j - 1) as size_t, b)
                set j: j - 1
            }
            set k: k + 1
        }
    }

    procedure swap_int(list: ref[Array[int]], j: int)
    {
        let t list[j as size_t]
        list.put(j as size_t, list[(j - 1) as size_t])
        list.put((j - 1) as size_t, t)
    }

    procedure swap_slice(list: ref[Array[Slice[char]]], j: int)
    {
        let t list[j as size_t]
        list.put(j as size_t, list[(j - 1) as size_t])
        list.put((j - 1) as size_t, t)
    }

    procedure swap_node(list: ref[Array[ref[AstNode]?]], j: int)
    {
        let t list[j as size_t]
        list.put(j as size_t, list[(j - 1) as size_t])
        list.put((j - 1) as size_t, t)
    }

    ; getDefaultLibFilePriority
    function lib_priority(host: ref[Page], path: Slice[char]) returns int
    {
        let base get_base_file_name(host, path)
        if base.equals("lib.d.ts") or base.equals("lib.es6.d.ts")
            return 0
        let keys TsOptionDecls.enum_keys_text(TsOptionDecls.index_of("lib"))
        var count 1
        var i 0
        while i < (keys.length as int)
        {
            if (keys[i as size_t] as int) = ("," as char) as int
                set count: count + 1
            set i: i + 1
        }
        if base.starts_with("lib.") and base.ends_with(".d.ts") and ((base.length as int) > 9)
        {
            let name base.subslice(4, ((base.length as int) - 5) as size_t)
            let quoted join_slices(host, join_slices(host, "'", name), "'")
            let at TsConfigParser.index_of_text(keys, quoted)
            if at >= 0
            {
                var commas 0
                var c 0
                while c < at
                {
                    if (keys[c as size_t] as int) = ("," as char) as int
                        set commas: commas + 1
                    set c: c + 1
                }
                return commas + 1
            }
        }
        count + 2
    }

    ; the lib chain read through the System (a read ends a default lib's status),
    ; each file's own `/// <reference lib>`s first
    procedure load_lib_chain(this, names: ref[Array[Slice[char]]], out_files: ref[Array[ref[AstNode]?]], out_binders: ref[Array[ref[Binder]?]], seen: ref[Array[Slice[char]]]) returns bool
    {
        var i 0
        while i < (names.get_length() as int)
        {
            let file_name Checker.lib_file_name(host, names[i as size_t])
            set i: i + 1
            if ExecSystem.contains(seen, file_name)
                continue
            seen.add(file_name)
            let lib_path this.path_for_lib_file(file_name)
            var raw Slice[char]()
            if sys.read_file(lib_path, &raw) = false
            {
                this.stop("lib-file-missing")
                return false
            }
            let path String^host(lib_path.data as pointer[const_char], lib_path.length as size_t)
            let text String^host(raw.data as pointer[const_char], raw.length as size_t)
            var unported 0 - 1
            var unported_tag: Slice[char] ""
            var unported_detail 0
            let lcs Tracing.no_args(host)
            Tracing.add_arg(host, lcs, "path", lib_path)
            let lcs_tid sys.trace_push(TracePhaseParse, "createSourceFile", lcs)
            let lp Parser.parse_ex(host, path, text, Parser.supported_script_kind(path), &unported, &unported_tag, &unported_detail)
            sys.trace_pop(lcs_tid, TracePhaseParse, "createSourceFile", lcs)
            if unported >= 0
            {
                this.stop(unported_tag)
                return false
            }
            let f Parser.source_file_of(lp)
            if f = null
            {
                this.stop("lib-no-tree")
                return false
            }
            let lf f as ref[AstNode]
            let refs AstNode.lib_references_of(lf)
            if refs <> null
            {
                if this.load_lib_chain(refs as ref[Array[Slice[char]]], out_files, out_binders, seen) = false
                    return false
            }
            let is_external Parser.external_module_indicator(lf, AstNode.statements_of(lf))
            ; ★The lib is PARSED here and bound in `bindSourceFiles` with everything
            ; else (slice 293) — upstream's block binds the program's files first
            ; and the libraries after, which is the order the trace shows.
            out_files.add(lf)
            out_binders.add(null)
            lib_nodes.add(lf)
            lib_paths.add(lib_path)
            lib_texts.add(Slice[char](text.get_length(), text.get_buffer() as pointer[char]))
            lib_parsers.add(lp)
            lib_file_names.add(file_name)
        }
        true
    }

    ; fileLoader.pathForLibFile: the default library's file, or under libReplacement
    ; the `@typescript/lib-*` package it resolves to from the config's directory
    procedure path_for_lib_file(this, file_name: Slice[char]) returns Slice[char]
    {
        var c 0
        while c < (lib_resolution_names.get_length() as int)
        {
            let known lib_resolution_names[c as size_t]
            if known.equals(file_name)
                return lib_resolution_paths[c as size_t]
            set c: c + 1
        }
        var path combine_paths(host, sys.default_library_path, file_name)
        if this.flag("libReplacement") and (file_name.equals("lib.d.ts") = false)
        {
            let library_name DriverProgram.library_name_from_lib_file_name(host, file_name)
            var containing sys.cwd
            if (config_path.length as int) > 0
                set containing: get_directory_path(host, get_normalized_absolute_path(host, config_path, sys.cwd))
            let resolve_from combine_paths(host, containing, join_slices(host, join_slices(host, "__lib_node_modules_lookup_", file_name), "__.ts"))
            let o options
            let resolver ModuleResolver.create(host, pf, o.get_module_resolution_kind(), o.get_resolve_json_module(), ModuleKindCommonJS, EmitOptions.on(o.allow_js), o.resolve_package_json_exports, o.resolve_package_json_imports, o.out_dir, o.project_root_directory(host))
            if this.flag("traceResolution")
                resolver.enable_trace(o.module_resolution = o.get_module_resolution_kind())
            let r resolver.resolve(library_name, resolve_from)
            if r >= 0
                set path: pf.path_at(r)
            let key_copy String^host(resolve_from.data as pointer[const_char], resolve_from.length as size_t)
            lib_resolution_keys.add(Slice[char](key_copy.get_length(), key_copy.get_buffer() as pointer[char]))
            let traces &Array[String]^host()
            ProgramLoader.append_traces(traces, resolver)
            lib_resolution_traces.add(traces)
        }
        let name_copy String^host(file_name.data as pointer[const_char], file_name.length as size_t)
        let path_copy String^host(path.data as pointer[const_char], path.length as size_t)
        lib_resolution_names.add(Slice[char](name_copy.get_length(), name_copy.get_buffer() as pointer[char]))
        lib_resolution_paths.add(Slice[char](path_copy.get_length(), path_copy.get_buffer() as pointer[char]))
        path
    }

    ; getLibraryNameFromLibFileName: lib.dom.iterable.d.ts → @typescript/lib-dom/iterable
    function library_name_from_lib_file_name(host: ref[Page], lib_file_name: Slice[char]) returns Slice[char]
    {
        let components &Array[Slice[char]]^host()
        var start 0
        var i 0
        while i <= (lib_file_name.length as int)
        {
            var at_end i = (lib_file_name.length as int)
            var dot false
            if at_end = false
                set dot: (lib_file_name[i as size_t] as int) = ("." as char) as int
            if at_end or dot
            {
                components.add(lib_file_name.subslice(start as size_t, i as size_t))
                set start: i + 1
            }
            set i: i + 1
        }
        let sb StringBuilder^host()
        sb.append("@typescript/lib-")
        if components.get_length() > 1
        {
            let second components[1]
            sb.append(second.data, second.length)
        }
        var k 2
        while k < (components.get_length() as int)
        {
            let component components[k as size_t]
            if ((component.length as int) = 0) or component.equals("d")
                break
            if k = 2
                sb.append("/")
            else
                sb.append("-")
            sb.append(component.data, component.length)
            set k: k + 1
        }
        let text String^host(sb.to_string())
        Slice[char](text.get_length(), text.get_buffer() as pointer[char])
    }

    ; ── GetDiagnosticsOfAnyProgram ───────────────────────────────────────────

    procedure from_list(this, list: ref[DiagnosticList], i: int, file_index: int, out: ref[Array[ref[DriverDiagnostic]]])
    {
        var p 0
        var e 0
        var c 0
        if list.at(i, &p, &e, &c) = false
            return
        out.add(&DriverDiagnostic^host(pf.path_at(file_index), pf.text_at(file_index), p, e, c, list.args_at(i), list.chain_at(i), this.related_of(list.related_at(i), file_index)))
    }

    ; related information as driver diagnostics: each in its own file, the entry's
    ; file when it has none (the parser's and the binder's)
    procedure related_of(this, infos: ref[Array[RelatedInfo]]?, file_index: int) returns ref[Array[ref[DriverDiagnostic]]]?
    {
        if infos = null
            return null
        let list infos as ref[Array[RelatedInfo]]
        let out &Array[ref[DriverDiagnostic]]^host()
        var k 0
        while k < (list.get_length() as int)
        {
            let info list[k as size_t]
            set k: k + 1
            var name: Slice[char] ""
            var text: Slice[char] ""
            if (info.file = null) and (file_index >= 0)
            {
                set name: pf.path_at(file_index)
                set text: pf.text_at(file_index)
            }
            if info.file <> null
            {
                let index pf.index_of_file(info.file)
                if index >= 0
                {
                    set name: pf.path_at(index)
                    set text: pf.text_at(index)
                }
                else
                {
                    var li 0
                    while li < (lib_nodes.get_length() as int)
                    {
                        let ln lib_nodes[li as size_t]
                        if ln = info.file
                        {
                            set name: lib_paths[li as size_t]
                            set text: lib_texts[li as size_t]
                        }
                        set li: li + 1
                    }
                }
            }
            out.add(&DriverDiagnostic^host(name, text, info.pos, info.end, info.code, info.args, info.chain, null))
        }
        out
    }

    ; GetSyntacticDiagnostics of one file: the parse's and the JavaScript parse's
    procedure syntactic(this, index: int, out: ref[Array[ref[DriverDiagnostic]]])
    {
        let file pf.file_at(index)
        if file = null
            return
        let parse_list AstNode.diagnostic_list_of(file, false)
        if parse_list <> null
        {
            let dl parse_list as ref[DiagnosticList]
            var i 0
            while i < dl.length()
            {
                this.from_list(dl, i, index, out)
                set i: i + 1
            }
        }
        let js_list AstNode.diagnostic_list_of(file, true)
        if js_list <> null
        {
            let jl js_list as ref[DiagnosticList]
            var j 0
            while j < jl.length()
            {
                this.from_list(jl, j, index, out)
                set j: j + 1
            }
        }
    }

    function is_js_path(path: Slice[char]) returns bool
        path.ends_with(".js") or path.ends_with(".jsx") or path.ends_with(".mjs") or path.ends_with(".cjs")

    ; SkipTypeChecking (no project references)
    function skip_type_checking(this, index: int) returns bool
        this.skip_type_checking_ex(index, false)

    function skip_type_checking_ex(this, index: int, ignore_no_check: bool) returns bool
    {
        if this.flag("noCheck") and (ignore_no_check = false)
            return true
        let path pf.path_at(index)
        if this.flag("skipLibCheck") and is_declaration_file_name_of(path)
            return true
        let file pf.file_at(index) as ref[AstNode]
        let directive AstNode.check_js_directive_of(file)
        if directive = 2
            return true
        if DriverProgram.is_js_path(path)
        {
            let check_js ts.tristate_of("checkJs")
            if (directive = 0) and (check_js = 0)
                return true
        }
        false
    }

    ; skipTypeChecking for a default library: `noCheck`, then `skipLibCheck` on a
    ; declaration file — which every lib is — and nothing else. A lib is never JS
    ; and carries no `@ts-nocheck`.
    function skip_lib_checking(this, i: int) returns bool
    {
        if this.flag("noCheck")
            return true
        if this.flag("skipLibCheck")
            return true
        false
    }

    ; checkSourceFile over one default library. The reference's program HOLDS its
    ; libs, so `checkSourceFiles` walks them ahead of the loader's files and their
    ; diagnostics are ordinary semantic ones; this port keeps the chain beside the
    ; table (see lib_nodes) and this is the walk that reaches it.
    procedure semantic_lib(this, i: int, out: ref[Array[ref[DriverDiagnostic]]]) returns bool
    {
        if checker = null
            return true
        let cd checker as ref[Checker]
        if this.skip_lib_checking(i)
            return true
        let mark cd.unported_mark()
        let log_before Checker.stop_count(cd)
        if cd.select_lib_file(i) = false
            return true
        cd.get_diagnostics()
        if this.checker_stopped(cd, mark, log_before)
            return false
        true
    }

    ; getSemanticDiagnosticsWithChecker for one file; false after a stop
    procedure semantic(this, index: int, out: ref[Array[ref[DriverDiagnostic]]]) returns bool
    {
        if this.bind_and_check(index, out) = false
            return false
        this.include_processor(index, out)
        true
    }

    ; getBindAndCheckDiagnosticsWithChecker for one file; false after a stop
    procedure bind_and_check(this, index: int, out: ref[Array[ref[DriverDiagnostic]]]) returns bool
    {
        let cd checker as ref[Checker]
        if this.skip_type_checking(index)
            return true
        let path pf.path_at(index)
        let file pf.file_at(index) as ref[AstNode]
        let diags &Array[ref[DriverDiagnostic]]^host()
        let b pf.binder_at(index) as ref[Binder]
        let bl b.bind_diagnostics
        var bi 0
        while bi < bl.length()
        {
            this.from_list(bl, bi, index, diags)
            set bi: bi + 1
        }
        Checker.report_progress(index, path)
        let mark cd.unported_mark()
        let log_before Checker.stop_count(cd)
        cd.select_program_file(index, pf.format_at(index))
        cd.get_diagnostics()
        if this.checker_stopped(cd, mark, log_before)
            return false
        let cl cd.diagnostics as ref[DiagnosticList]
        var ci 0
        while ci < cl.length()
        {
            if cl.file_tag_at(ci) = index
                this.from_list(cl, ci, index, diags)
            set ci: ci + 1
        }
        let directive AstNode.check_js_directive_of(file)
        let is_js DriverProgram.is_js_path(path)
        let check_js ts.tristate_of("checkJs")
        let parser pf.parser_at(index) as ref[Parser]
        if is_js and (directive = 0) and (check_js < 0)
        {
            var pi 0
            while pi < (diags.get_length() as int)
            {
                let d diags[pi as size_t]
                if DriverProgram.is_plain_js_error(d.code)
                    out.add(d)
                set pi: pi + 1
            }
        }
        else
        {
            if is_js and ((directive = 1) or ((directive = 0) and (check_js = 1)))
            {
                let jl parser.jsdoc_diagnostics
                var si 0
                while si < jl.length()
                {
                    this.from_list(jl, si, index, diags)
                    set si: si + 1
                }
            }
            this.with_preceding_directives(index, diags, true, out)
        }
        true
    }

    ; GetIncludeProcessorDiagnostics of one file
    procedure include_processor(this, index: int, out: ref[Array[ref[DriverDiagnostic]]])
    {
        let ld loader as ref[ProgramLoader]
        if this.skip_type_checking(index)
            return
        let path pf.path_at(index)
        let includes &Array[ref[DriverDiagnostic]]^host()
        var li 0
        while li < (ld.diagnostics.get_length() as int)
        {
            let pd ld.diagnostics[li as size_t]
            set li: li + 1
            if (pd.reason <> null) or (pd.explained_file >= 0)
            {
                let explained this.explaining_diagnostic(pd.explained_file, pd.reason, pd.code, pd.args)
                if explained <> null
                {
                    let e explained as ref[DriverDiagnostic]
                    if e.file_name.equals(path)
                        includes.add(e)
                }
                continue
            }
            if pd.file_index = index
                includes.add(&DriverDiagnostic^host(path, pf.text_at(index), pd.pos, pd.end, pd.code, pd.args, pd.chain, null))
        }
        this.with_preceding_directives(index, includes, false, out)
    }

    ; getDiagnosticsWithPrecedingDirectives, then the unused @ts-expect-error reports
    procedure with_preceding_directives(this, index: int, diags: ref[Array[ref[DriverDiagnostic]]], report_unused: bool, out: ref[Array[ref[DriverDiagnostic]]])
    {
        let parser pf.parser_at(index) as ref[Parser]
        let n Parser.comment_directive_count(parser)
        if n = 0
        {
            var k 0
            while k < (diags.get_length() as int)
            {
                out.add(diags[k as size_t])
                set k: k + 1
            }
            return
        }
        let text pf.text_at(index)
        let starts Printer.compute_ecma_line_starts(host, text)
        let lines &Array[int]^host()
        let kinds &Array[int]^host()
        let ranges &Array[int]^host()
        var di 0
        while di < n
        {
            var rs 0
            var re 0
            var rk 0
            Parser.comment_directive_at(parser, di, &rs, &re, &rk)
            let line DiagnosticWriter.line_of(starts, rs)
            var existing 0 - 1
            var q 0
            while q < (lines.get_length() as int)
            {
                if lines[q as size_t] = line
                    set existing: q
                set q: q + 1
            }
            if existing >= 0
            {
                kinds.put(existing as size_t, rk)
                ranges.put((2 * existing) as size_t, rs)
                ranges.put((2 * existing + 1) as size_t, re)
            }
            else
            {
                lines.add(line)
                kinds.add(rk)
                ranges.add(rs)
                ranges.add(re)
            }
            set di: di + 1
        }
        var i 0
        while i < (diags.get_length() as int)
        {
            let d diags[i as size_t]
            set i: i + 1
            var ignore false
            var line DiagnosticWriter.line_of(starts, d.pos) - 1
            while line >= 0
            {
                var found 0 - 1
                var q 0
                while q < (lines.get_length() as int)
                {
                    if lines[q as size_t] = line
                        set found: q
                    set q: q + 1
                }
                if found >= 0
                {
                    set ignore: true
                    kinds.put(found as size_t, 0)
                    break
                }
                if DriverProgram.is_comment_or_blank_line(text, starts[line as size_t]) = false
                    break
                set line: line - 1
            }
            if ignore = false
                out.add(d)
        }
        if report_unused = false
            return
        var u 0
        while u < (lines.get_length() as int)
        {
            if kinds[u as size_t] = 1
                out.add(&DriverDiagnostic^host(pf.path_at(index), text, ranges[(2 * u) as size_t], ranges[(2 * u + 1) as size_t], DiagUnused_ts_expect_error_directive, null, null, null))
            set u: u + 1
        }
    }

    function is_comment_or_blank_line(text: Slice[char], pos_in: int) returns bool
    {
        var pos pos_in
        let n text.length as int
        while (pos < n) and (((*(text.data + pos) as int) = 32) or ((*(text.data + pos) as int) = 9))
            set pos: pos + 1
        if pos = n
            return true
        let c *(text.data + pos) as int
        if (c = 13) or (c = 10)
            return true
        if (pos + 1) < n
            return (c = 47) and ((*(text.data + pos + 1) as int) = 47)
        false
    }

    ; the checker's global diagnostics, all of them
    procedure global(this, out: ref[Array[ref[DriverDiagnostic]]])
    {
        if checker = null
            return
        let cd checker as ref[Checker]
        let gl cd.global_diagnostic_list
        let none: Slice[char] ""
        var gi 0
        while gi < Checker.global_diagnostic_code_count(cd)
        {
            out.add(&DriverDiagnostic^host(none, none, 0, 0, Checker.global_diagnostic_code_at(cd, gi), gl.args_at(gi), gl.chain_at(gi), this.related_of(gl.related_at(gi), 0 - 1)))
            set gi: gi + 1
        }
    }

    ; GetProgramDiagnostics: the options diagnostics, global or in the config file
    procedure program_diagnostics(this, out: ref[Array[ref[DriverDiagnostic]]])
    {
        var ri 0
        while ri < (reference_diagnostics.get_length() as int)
        {
            out.add(reference_diagnostics[ri as size_t])
            set ri: ri + 1
        }
        if loader = null
            return
        let ld loader as ref[ProgramLoader]
        let none: Slice[char] ""
        var i 0
        while i < (ld.diagnostics.get_length() as int)
        {
            let pd ld.diagnostics[i as size_t]
            set i: i + 1
            if (pd.reason <> null) or (pd.explained_file >= 0)
            {
                let explained this.explaining_diagnostic(pd.explained_file, pd.reason, pd.code, pd.args)
                if explained <> null
                {
                    let e explained as ref[DriverDiagnostic]
                    if e.has_file() = false
                        out.add(e)
                }
                continue
            }
            if pd.file_index = ProgramDiagnosticGlobal
                out.add(&DriverDiagnostic^host(none, none, pd.pos, pd.end, pd.code, pd.args, pd.chain, null))
            if pd.file_index = ProgramDiagnosticConfig
                out.add(&DriverDiagnostic^host(config_path, config_text, pd.pos, pd.end, pd.code, pd.args, pd.chain, null))
        }
    }

    ; GetDeclarationDiagnostics of one file; false after a stop
    procedure declaration(this, index: int, out: ref[Array[ref[DriverDiagnostic]]]) returns bool
    {
        let ld loader as ref[ProgramLoader]
        let cd checker as ref[Checker]
        let path pf.path_at(index)
        if (ld.source_file_may_be_emitted(index) = false) or path.ends_with(".json")
            return true
        let file pf.file_at(index) as ref[AstNode]
        let db pf.binder_at(index) as ref[Binder]
        let info this.info_of(index, true)
        let em Emitter.create(host)
        let found &Array[int]^host()
        let found_args &Array[ref[Array[String]]?]^host()
        let found_related &Array[ref[Array[RelatedInfo]]?]^host()
        cd.select_program_file(index, pf.format_at(index))
        if em.declaration_diagnostics(file, info, this.unit_options(index), cd, db, found, found_args, found_related) = false
        {
            this.stop(em.unported_tag)
            return false
        }
        var xi 0
        while xi < ((found.get_length() as int) / 3)
        {
            out.add(&DriverDiagnostic^host(path, pf.text_at(index), found[(3 * xi) as size_t], found[(3 * xi + 1) as size_t], found[(3 * xi + 2) as size_t], found_args[xi as size_t], null, this.related_of(found_related[xi as size_t], index)))
            set xi: xi + 1
        }
        true
    }

    function emits_declarations(this) returns bool
        EmitOptions.on(options.declaration) or EmitOptions.on(options.composite)

    ; GetDiagnosticsOfAnyProgram(file nil); the two callbacks' clock ticks when
    ; `timed`; false after a stop
    ; the checker whose types `--generateTrace` dumps: checkerId 0, which this
    ; port has exactly one of per program (the reference's checkerPool hands out
    ; as many as it has threads, and `--singleThreaded` — which both trace
    ; baselines pass — pins it to one).
    function trace_checker(this) returns ref[Checker]?
        checker

    procedure diagnostics_of_any_program(this, out: ref[Array[ref[DriverDiagnostic]]], skip_no_emit_check: bool, timed: bool) returns bool
    {
        var ci 0
        while ci < (config_diagnostics.get_length() as int)
        {
            out.add(config_diagnostics[ci as size_t])
            set ci: ci + 1
        }
        if loader = null
        {
            if timed
            {
                sys.now()
                sys.now()
            }
            return true
        }
        let ld loader as ref[ProgramLoader]
        let config_count out.get_length()
        var k 0
        while k < (ld.program_files.get_length() as int)
        {
            this.syntactic(ld.program_files[k as size_t], out)
            set k: k + 1
        }
        if out.get_length() <> config_count
            return true
        this.program_diagnostics(out)
        if timed
        {
            sys.now()
            sys.now()
        }
        if this.flag("listFilesOnly")
            return true
        this.global(out)
        if out.get_length() = config_count
        {
            if timed
                sys.now()
            let cf_tid sys.trace_push(TracePhaseCheck, "checkSourceFiles", null)
            var lb 0
            while lb < this.lib_count()
            {
                let la Tracing.no_args(host)
                Tracing.add_num_arg(host, la, "checkerId", 0)
                Tracing.add_arg(host, la, "path", lib_paths[lb as size_t])
                let la_tid sys.trace_push(TracePhaseCheck, "checkSourceFile", la)
                let lok this.semantic_lib(lb, out)
                sys.trace_pop(la_tid, TracePhaseCheck, "checkSourceFile", la)
                if lok = false
                {
                    sys.trace_pop(cf_tid, TracePhaseCheck, "checkSourceFiles", null)
                    return false
                }
                set lb: lb + 1
            }
            var s 0
            while s < (ld.program_files.get_length() as int)
            {
                let unit ld.program_files[s as size_t]
                let one Tracing.no_args(host)
                Tracing.add_num_arg(host, one, "checkerId", 0)
                Tracing.add_arg(host, one, "path", pf.path_at(unit))
                let one_tid sys.trace_push(TracePhaseCheck, "checkSourceFile", one)
                let ok this.semantic(unit, out)
                sys.trace_pop(one_tid, TracePhaseCheck, "checkSourceFile", one)
                if ok = false
                {
                    sys.trace_pop(cf_tid, TracePhaseCheck, "checkSourceFiles", null)
                    return false
                }
                set s: s + 1
            }
            sys.trace_pop(cf_tid, TracePhaseCheck, "checkSourceFiles", null)
            this.report_stats()
            if timed
                sys.now()
            this.global(out)
        }
        if (skip_no_emit_check or EmitOptions.on(options.no_emit)) and this.emits_declarations() and (out.get_length() = config_count)
        {
            var d 0
            while d < (ld.program_files.get_length() as int)
            {
                if this.declaration(ld.program_files[d as size_t], out) = false
                    return false
                set d: d + 1
            }
        }
        true
    }

    ; ── Program.Emit ─────────────────────────────────────────────────────────

    function unit_options(this, index: int) returns EmitOptions
    {
        var uo options
        set uo.package_json_type: this.unit_package_json_type(pf.path_at(index))
        uo
    }

    function info_of(this, index: int, declaration: bool) returns ref[SourceFileInfo]
    {
        let file pf.file_at(index) as ref[AstNode]
        let path pf.path_at(index)
        let b pf.binder_at(index) as ref[Binder]
        let path_s String^host(path.data as pointer[const_char], path.length as size_t)
        var forced false
        if b.is_declaration_file_of() = false
            set forced: Emitter.is_file_forced_to_be_module_by_format(path, this.unit_options(index))
        ; file.Identifiers is the set at THIS point, before any transform adds
        ; synthesized names to the tree, so an emitting program collects it here;
        ; under --noEmit nothing prints and the set is collected only if asked
        var identifiers: ref[Array[Slice[char]]]? null
        if EmitOptions.on(options.no_emit) = false
        {
            let ids &Array[Slice[char]]^host()
            Emitter.collect_identifiers(host, file, ids)
            set identifiers: ids
        }
        &SourceFileInfo^host(file, path, pf.text_at(index), Printer.compute_ecma_line_starts(host, pf.text_at(index)), declaration or b.is_declaration_file_of(), Parser.supported_script_kind(path_s), b.is_external_module_of() or forced, identifiers, true)
    }

    function is_blocked(this, path: Slice[char]) returns bool
    {
        if loader = null
            return false
        let ld loader as ref[ProgramLoader]
        ExecSystem.contains(ld.blocked_paths, path)
    }

    ; the harness's writeFile, then the emitted-files record
    procedure write_output(this, path: Slice[char], builder: ref[StringBuilder])
    {
        let text builder.to_string()
        sys.write_file(path, Slice[char](text.get_length() as int, text.get_buffer() as pointer[char]))
        emitted_files.add(slice_copy_on(host, path))
    }

    ; Program.Emit; false after a stop
    procedure emit(this) returns bool
    {
        if loader = null
            return true
        let ld loader as ref[ProgramLoader]
        if EmitOptions.on(options.no_emit_on_error)
        {
            let found &Array[ref[DriverDiagnostic]]^host()
            if this.diagnostics_of_any_program(found, true, false) = false
                return false
            if found.get_length() > 0
            {
                set this.emit_diagnostics: found
                set this.emit_skipped: true
                return true
            }
        }
        ; ★★★ THE WORK RUNS BACKWARDS AND THE RESULTS ARE READ FORWARD, which is
        ; program.go:1655 exactly: the emitters are built in the program's order,
        ; one task per entry is queued into a `core.WorkGroup`, and the
        ; single-threaded group is a LIFO stack — so `emitter.emit()` runs from the
        ; last file to the first while `emitters` is consumed from the first. The
        ; trace sees the first order and `emitted_files` the second, and BOTH are
        ; observed: reversing them together named the wrong output in four
        ; up-to-date messages (`newest input 'd.ts' is older than output 'a.d.ts'`).
        let emit_indexes &Array[int]^host()
        var q 0
        while q < (ld.program_files.get_length() as int)
        {
            let index ld.program_files[q as size_t]
            set q: q + 1
            if ld.source_file_may_be_emitted(index) = false
                continue
            emit_indexes.add(index)
        }
        let emit_outputs &Array[ref[FileEmitOutput]?]^host()
        var z 0
        while z < (emit_indexes.get_length() as int)
        {
            emit_outputs.add(null)
            set z: z + 1
        }
        var k (emit_indexes.get_length() as int) - 1
        while k >= 0
        {
            let index emit_indexes[k as size_t]
            ; compiler/emitter.go:47 — one `emit` event per file, on the file's
            ; own thread, inside the program's
            let ea Tracing.no_args(host)
            Tracing.add_arg(host, ea, "path", pf.path_at(index))
            let ea_tid sys.trace_push(TracePhaseEmit, "emit", ea)
            let result this.emit_one(index, EmitOnlyAll)
            sys.trace_pop(ea_tid, TracePhaseEmit, "emit", ea)
            if result = null
                return false
            emit_outputs.put(k as size_t, result)
            set k: k - 1
        }
        var w 0
        while w < (emit_outputs.get_length() as int)
        {
            let out_opt emit_outputs[w as size_t]
            set w: w + 1
            if out_opt = null
                continue
            let r out_opt as ref[FileEmitOutput]
            if r.skipped
                set this.emit_skipped: true
            var di 0
            while di < (r.diagnostics.get_length() as int)
            {
                emit_diagnostics.add(r.diagnostics[di as size_t])
                set di: di + 1
            }
            if r.has_js
            {
                if (r.js_map_path.length as int) > 0
                {
                    sys.write_file(r.js_map_path, r.js_map_text)
                    emitted_files.add(r.js_map_path)
                }
                sys.write_file(r.js_path, r.js_text)
                emitted_files.add(slice_copy_on(host, r.js_path))
            }
            if r.has_dts
            {
                if (r.dts_map_path.length as int) > 0
                {
                    sys.write_file(r.dts_map_path, r.dts_map_text)
                    emitted_files.add(r.dts_map_path)
                }
                sys.write_file(r.dts_path, r.dts_text)
                emitted_files.add(slice_copy_on(host, r.dts_path))
            }
        }
        true
    }

    ; one emitter.emit of a file the program may emit: the JavaScript output and the
    ; declaration output as texts, not yet written (EmitOnly* selects which;
    ; EmitOnlyForcedDts emits the declaration file whatever the options say, as the
    ; incremental program's signature asks); null after a stop
    procedure emit_one(this, index: int, emit_only: int) returns ref[FileEmitOutput]?
    {
        let ld loader as ref[ProgramLoader]
        let cd checker as ref[Checker]
        let none: Slice[char] ""
        let result &FileEmitOutput^host(false, false, none, none, false, none, none, &Array[ref[DriverDiagnostic]]^host(), none, none, none, none, 0 - 1)
        let file pf.file_at(index) as ref[AstNode]
        let b pf.binder_at(index) as ref[Binder]
        let path pf.path_at(index)
        let is_json path.ends_with(".json")
        let forced emit_only = EmitOnlyForcedDts
        let uo this.unit_options(index)
        let mark cd.unported_mark()
        let log_before Checker.stop_count(cd)
        cd.select_program_file(index, pf.format_at(index))
        var wants_js (emit_only = EmitOnlyAll) or (emit_only = EmitOnlyJs)
        if EmitOptions.on(options.emit_declaration_only) or (is_json and ((options.out_dir.length as int) = 0))
            set wants_js: false
        if wants_js
        {
            let info this.info_of(index, false)
            let em Emitter.create(host)
            let js_path em.js_output_path(info, uo, uo.get_current_directory(), cd)
            if EmitOptions.on(options.no_emit) or this.is_blocked(js_path)
                set result.skipped: true
            else
            {
                let out StringBuilder^host()
                em.emit_js(file, info, uo, cd, b, &out)
                if em.unported_count > 0
                {
                    this.stop(em.unported_tag)
                    return null
                }
                if this.checker_stopped(cd, mark, log_before)
                    return null
                let js_text String^host(out.to_string())
                set result.has_js: true
                set result.js_path: slice_copy_on(host, js_path)
                set result.js_text: Slice[char](js_text.get_length(), js_text.get_buffer() as pointer[char])
                if (em.map_text.length as int) > 0
                {
                    set result.js_map_path: join_slices(host, result.js_path, ".map")
                    set result.js_map_text: em.map_text
                }
            }
        }
        var wants_dts emit_only <> EmitOnlyJs
        if (forced = false) and ((this.emits_declarations() = false) or is_json)
            set wants_dts: false
        if wants_dts
        {
            if is_json
            {
                this.stop("forced-dts-of-json")
                return null
            }
            let dinfo this.info_of(index, true)
            let dem Emitter.create(host)
            set dem.forced_dts: forced
            let dts_path dem.dts_output_path(dinfo, uo, uo.get_current_directory(), cd)
            if this.declaration(index, result.diagnostics) = false
                return null
            var blocked false
            if (forced = false) and (EmitOptions.on(options.no_emit) or this.is_blocked(dts_path) or (result.diagnostics.get_length() > 0))
                set blocked: true
            if blocked
                set result.skipped: true
            else
            {
                let dout StringBuilder^host()
                dem.emit_dts(file, dinfo, uo, cd, b, &dout)
                if dem.unported_count > 0
                {
                    this.stop(dem.unported_tag)
                    return null
                }
                if this.checker_stopped(cd, mark, log_before)
                    return null
                let dts_text String^host(dout.to_string())
                set result.has_dts: true
                set result.dts_path: slice_copy_on(host, dts_path)
                set result.dts_text: Slice[char](dts_text.get_length(), dts_text.get_buffer() as pointer[char])
                set result.dts_url_pos: dem.url_pos
                if (dem.map_text.length as int) > 0
                {
                    set result.dts_map_path: join_slices(host, result.dts_path, ".map")
                    set result.dts_map_text: dem.map_text
                }
            }
        }
        result
    }

    ; ── the incremental program's questions (internal/execute/incremental) ───

    function lib_count(this) returns int
        lib_paths.get_length() as int

    ; GetSourceFiles: the default libraries, then the loader's files
    function source_file_count(this) returns int
    {
        if loader = null
            return 0
        let ld loader as ref[ProgramLoader]
        this.lib_count() + (ld.program_files.get_length() as int)
    }

    ; the file table index of source file `i`, -1 for a default library
    function source_pf_index(this, i: int) returns int
    {
        let n this.lib_count()
        if i < n
            return 0 - 1
        let ld loader as ref[ProgramLoader]
        ld.program_files[(i - n) as size_t]
    }

    function source_path(this, i: int) returns Slice[char]
    {
        let index this.source_pf_index(i)
        if index < 0
            return lib_paths[i as size_t]
        pf.path_at(index)
    }

    function source_text(this, i: int) returns Slice[char]
    {
        let index this.source_pf_index(i)
        if index < 0
            return lib_texts[i as size_t]
        pf.text_at(index)
    }

    ; ── listFiles / explainFiles (execute/tsc/emit.go, Program.ExplainFiles) ──

    ; listFiles: the emitted files, then the explanation or the file list; false
    ; after a stop
    procedure list_files(this, emitted: ref[Array[Slice[char]]]) returns bool
    {
        let listing this.flag("explainFiles") or this.flag("listFiles") or this.flag("listFilesOnly")
        let out sys.output
        ; the harness's OnListFilesStart/End around whatever is listed
        out.append("!!! List files start\n")
        if this.flag("listEmittedFiles")
        {
            var i 0
            while i < (emitted.get_length() as int)
            {
                let file get_normalized_absolute_path(host, emitted[i as size_t], sys.cwd)
                set i: i + 1
                out.append("TSFILE: ")
                out.append(file.data, file.length)
                out.append("\n")
            }
        }
        if this.flag("explainFiles")
        {
            if this.explain_files() = false
                return false
        }
        else
        {
            if this.flag("listFiles") or this.flag("listFilesOnly")
            {
                var k 0
                while k < this.source_file_count()
                {
                    let path this.source_path(k)
                    set k: k + 1
                    out.append(path.data, path.length)
                    out.append("\n")
                }
            }
        }
        out.append("!!! List files end\n")
        true
    }

    ; Program.ExplainFiles: the source files in order, a package redirect at its
    ; own position between them
    procedure explain_files(this) returns bool
    {
        if loader = null
            return true
        let ld loader as ref[ProgramLoader]
        let lib_n this.lib_count()
        let total this.source_file_count()
        var explained 0
        var next_source 0
        var r 0
        while r < (ld.redirect_paths.get_length() as int)
        {
            let position ld.redirect_positions[r as size_t] + lib_n
            while explained < position
            {
                if this.explain_source_file(next_source) = false
                    return false
                set next_source: next_source + 1
                set explained: explained + 1
            }
            if this.explain_redirect_file(r) = false
                return false
            set explained: explained + 1
            set r: r + 1
        }
        while next_source < total
        {
            if this.explain_source_file(next_source) = false
                return false
            set next_source: next_source + 1
        }
        true
    }

    function explain_relative(this, file_name: Slice[char]) returns Slice[char]
        get_relative_path_to_directory_or_url(host, sys.cwd, file_name, false, sys.cwd)

    procedure explain_line(this, code: int, args: ref[Array[String]]?)
    {
        let out sys.output
        out.append("   ")
        out.append(DiagnosticWriter.format_message(code, args))
        out.append("\n")
    }

    procedure explain_name(this, file_name: Slice[char])
    {
        let out sys.output
        let relative this.explain_relative(file_name)
        out.append(relative.data, relative.length)
        out.append("\n")
    }

    ; the explanation's file names: relative to the current directory for
    ; ExplainFiles, as they are for a diagnostic's chain
    function explain_file_name(this, file_name: Slice[char], relative: bool) returns String
    {
        if relative
            return ProgramDiagnostic.text(this.explain_relative(file_name))
        ProgramDiagnostic.text(file_name)
    }

    procedure explain_messages(this, messages: ref[ExplainMessages])
    {
        var i 0
        while i < (messages.codes.get_length() as int)
        {
            this.explain_line(messages.codes[i as size_t], messages.args[i as size_t])
            set i: i + 1
        }
    }

    ; explainFile over source file `k`
    procedure explain_source_file(this, k: int) returns bool
    {
        let ld loader as ref[ProgramLoader]
        let path this.source_path(k)
        this.explain_name(path)
        let index this.source_pf_index(k)
        if index < 0
            return this.explain_lib_file(k)
        let node ld.node_for(ld.program_paths[(k - this.lib_count()) as size_t])
        let messages ExplainMessages.create(host)
        if this.reason_messages(node.reasons, true, messages) = false
            return false
        this.redirect_and_format_messages(path, index, 0 - 1, true, messages)
        this.explain_messages(messages)
        true
    }

    ; explainFile over the package redirect `r`
    procedure explain_redirect_file(this, r: int) returns bool
    {
        let ld loader as ref[ProgramLoader]
        let path ld.redirect_paths[r as size_t]
        this.explain_name(path)
        let node ld.node_for(path)
        let messages ExplainMessages.create(host)
        if this.reason_messages(node.reasons, true, messages) = false
            return false
        this.redirect_and_format_messages(path, 0 - 1, ld.redirect_targets[r as size_t], true, messages)
        this.explain_messages(messages)
        true
    }

    ; includeProcessor.explainRedirectAndImpliedFormat: the project reference
    ; source, the package redirect's target (`target` >= 0 for a redirect file), the
    ; implied module format of a source file (`index` >= 0)
    procedure redirect_and_format_messages(this, path: Slice[char], index: int, target: int, relative: bool, out: ref[ExplainMessages])
    {
        let source pf.source_of_reference_output(path)
        if source.equals(path) = false
            out.add(1428, ProgramDiagnostic.args1(host, this.explain_file_name(source, relative)))
        if target >= 0
            out.add(1429, ProgramDiagnostic.args1(host, this.explain_file_name(pf.path_at(target), relative)))
        if index < 0
            return
        let b pf.binder_at(index)
        if b = null
            return
        if (b as ref[Binder]).is_external_or_common_js_module() = false
            return
        var uo options
        set uo.package_json_type: pf.package_json_type_at(index)
        let format uo.implied_node_format_for_emit_of_file(path)
        let package_type pf.package_json_type_at(index)
        let directory pf.package_json_directory_of(host, path)
        let package_json join_slices(host, directory, "/package.json")
        if format = ModuleKindESNext
        {
            if package_type.equals("module")
                out.add(1458, ProgramDiagnostic.args1(host, this.explain_file_name(package_json, relative)))
        }
        if format = ModuleKindCommonJS
        {
            if (package_type.length as int) > 0
                out.add(1459, ProgramDiagnostic.args1(host, this.explain_file_name(package_json, relative)))
            else
            {
                if (directory.length as int) > 0
                    out.add(1460, ProgramDiagnostic.args1(host, this.explain_file_name(package_json, relative)))
                else
                    out.add(1461, null)
            }
        }
    }

    ; a default library's reasons: the lib option's entry, else the target's default
    procedure explain_lib_file(this, k: int) returns bool
    {
        let path this.source_path(k)
        let node lib_nodes[k as size_t]
        if node <> null
        {
            if AstNode.lib_references_of(node as ref[AstNode]) <> null
            {
                this.stop("explain-lib-reference")
                return false
            }
        }
        let base lib_file_names[k as size_t]
        ; fileIncludeKindLibReferenceDirective: the source files' directives come first
        ; (their tasks are reached from the root files before the lib tasks)
        var referenced false
        if loader <> null
        {
            let ld loader as ref[ProgramLoader]
            var r 0
            while r < (ld.lib_ref_names.get_length() as int)
            {
                let written ld.lib_ref_names[r as size_t]
                let file_index ld.lib_ref_files[r as size_t]
                set r: r + 1
                let lib_file Checker.lib_file_name(host, written)
                if lib_file.equals(base)
                {
                    let referencing this.explain_relative(pf.path_at(file_index))
                    let args ProgramDiagnostic.args1(host, ProgramDiagnostic.text(written))
                    args.add(ProgramDiagnostic.text(referencing))
                    this.explain_line(1405, args)
                    set referenced: true
                }
            }
        }
        if (options.lib.length as int) = 0
        {
            let defaults options.lib_names(host)
            var is_default referenced = false
            if defaults.get_length() > 0
            {
                let default_name Checker.lib_file_name(host, defaults[0])
                if default_name.equals(base)
                    set is_default: true
            }
            if is_default
            {
                let t options.get_emit_script_target()
                this.explain_line(1425, ProgramDiagnostic.args1(host, DriverProgram.script_target_name(t)))
            }
            return true
        }
        let names options.lib_names(host)
        var i 0
        while i < (names.get_length() as int)
        {
            let file_name Checker.lib_file_name(host, names[i as size_t])
            set i: i + 1
            if file_name.equals(base)
            {
                this.explain_line(1422, ProgramDiagnostic.args1(host, ProgramDiagnostic.text(file_name)))
                return true
            }
        }
        if referenced
            return true
        this.stop("explain-lib-reason")
        false
    }

    ; core.ScriptTarget.String
    function script_target_name(t: int) returns String
    {
        if t = 1
            return String("ES5")
        if t = 99
            return String("ESNext")
        if (t >= 2) and (t <= 12)
        {
            var sb StringBuilder()
            sb.append("ES")
            sb.append(2013 + t)
            return sb.to_string()
        }
        String("None")
    }

    ; FileIncludeReason.toDiagnostic per reason; false after a stop
    procedure reason_messages(this, reasons: ref[Array[ref[IncludeReason]]], relative: bool, out: ref[ExplainMessages]) returns bool
    {
        var i 0
        while i < (reasons.get_length() as int)
        {
            let reason reasons[i as size_t]
            set i: i + 1
            if this.reason_message(reason, relative, out) = false
                return false
        }
        true
    }

    procedure reason_message(this, reason: ref[IncludeReason], relative: bool, out: ref[ExplainMessages]) returns bool
    {
        let kind reason.kind
        if kind = FileIncludeKindRootFile
        {
            this.root_reason_message(reason.name, relative, out)
            return true
        }
        if kind = FileIncludeKindAutomaticTypeDirectiveFile
        {
            let wildcard DriverProgram.uses_wildcard_types(options.types)
            let has_package (reason.package_id.length as int) > 0
            let name ProgramDiagnostic.text(reason.name)
            if wildcard
            {
                if has_package
                    out.add(1421, ProgramDiagnostic.args2(host, name, DriverProgram.package_id_text(reason.package_id)))
                else
                    out.add(1420, ProgramDiagnostic.args1(host, name))
            }
            else
            {
                if has_package
                    out.add(1418, ProgramDiagnostic.args2(host, name, DriverProgram.package_id_text(reason.package_id)))
                else
                    out.add(1417, ProgramDiagnostic.args1(host, name))
            }
            return true
        }
        if reason.synthetic
        {
            this.stop("explain-synthetic-import")
            return false
        }
        let referencing pf.path_at(reason.file_index)
        let text ProgramDiagnostic.text(pf.text_at(reason.file_index).subslice(reason.pos as size_t, reason.end as size_t))
        let from this.explain_file_name(referencing, relative)
        let has_package (reason.package_id.length as int) > 0
        if kind = FileIncludeKindImport
        {
            if has_package
                out.add(1394, ProgramDiagnostic.args3(host, text, from, DriverProgram.package_id_text(reason.package_id)))
            else
                out.add(1393, ProgramDiagnostic.args2(host, text, from))
            return true
        }
        if kind = FileIncludeKindReferenceFile
        {
            out.add(1400, ProgramDiagnostic.args2(host, text, from))
            return true
        }
        if kind = FileIncludeKindTypeReferenceDirective
        {
            if has_package
                out.add(1403, ProgramDiagnostic.args3(host, text, from, DriverProgram.package_id_text(reason.package_id)))
            else
                out.add(1402, ProgramDiagnostic.args2(host, text, from))
            return true
        }
        this.stop("explain-reason-kind")
        false
    }

    ; GetMatchedFileSpec against the root config: its index, -1 for none
    function matched_file_spec(this, config: ref[TsParsedCommandLine], file_name: Slice[char]) returns int
    {
        let file_path get_normalized_absolute_path(host, file_name, config.base_path)
        var i 0
        while i < (config.files_specs.get_length() as int)
        {
            let spec_path get_normalized_absolute_path(host, config.files_specs[i as size_t], config.base_path)
            if spec_path.equals(file_path)
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; GetMatchedIncludeSpec's match (the default include aside): its index, -1 for none
    function matched_include_spec(this, config: ref[TsParsedCommandLine], file_name: Slice[char]) returns int
    {
        var j 0
        while j < (config.include_specs.get_length() as int)
        {
            let pattern TsGlobPattern.compile(host, config.include_specs[j as size_t], config.base_path, TsGlobUsageFiles)
            if pattern <> null
            {
                if (pattern as ref[TsGlobPattern]).matches(file_name)
                    return j
            }
            set j: j + 1
        }
        0 - 1
    }

    ; the root file reason against the config's specs
    procedure root_reason_message(this, root_name: Slice[char], relative: bool, out: ref[ExplainMessages])
    {
        if root_config = null
        {
            out.add(1427, null)
            return
        }
        let config root_config as ref[TsParsedCommandLine]
        let file_name get_normalized_absolute_path(host, root_name, sys.cwd)
        if this.matched_file_spec(config, file_name) >= 0
        {
            out.add(1409, null)
            return
        }
        if config.include_specs.get_length() > 0
        {
            if config.is_default_include
            {
                out.add(1457, null)
                return
            }
            let j this.matched_include_spec(config, file_name)
            if j >= 0
            {
                let spec ProgramDiagnostic.text(config.include_specs_raw[j as size_t])
                out.add(1407, ProgramDiagnostic.args2(host, spec, this.explain_file_name(get_normalized_absolute_path(host, config_path, sys.cwd), relative)))
                return
            }
        }
        out.add(1427, null)
    }

    ; FileIncludeReason.toRelatedInfo: null for none; false after a stop
    procedure reason_related_info(this, reason: ref[IncludeReason], out: ref[ref[DriverDiagnostic]?]) returns bool
    {
        set out: null
        let kind reason.kind
        if kind <= FileIncludeKindLibReferenceDirective
        {
            if reason.synthetic
                return true
            var code 1399
            if kind = FileIncludeKindReferenceFile
                set code: 1401
            if kind = FileIncludeKindTypeReferenceDirective
                set code: 1404
            if kind = FileIncludeKindLibReferenceDirective
                set code: 1406
            let made &DriverDiagnostic^host(pf.path_at(reason.file_index), pf.text_at(reason.file_index), reason.pos, reason.end, code, null, null, null)
            set out: made
            return true
        }
        if root_config = null
            return true
        let config root_config as ref[TsParsedCommandLine]
        if kind = FileIncludeKindRootFile
        {
            let file_name get_normalized_absolute_path(host, reason.name, sys.cwd)
            let fi this.matched_file_spec(config, file_name)
            if fi >= 0
            {
                set out: this.config_array_element_info(false, "files", config.files_specs_raw[fi as size_t], 1410)
                return true
            }
            if (config.include_specs.get_length() > 0) and (config.is_default_include = false)
            {
                let ii this.matched_include_spec(config, file_name)
                if ii >= 0
                    set out: this.config_array_element_info(false, "include", config.include_specs_raw[ii as size_t], 1408)
            }
            return true
        }
        if kind = FileIncludeKindAutomaticTypeDirectiveFile
        {
            if DriverProgram.uses_wildcard_types(options.types) = false
                set out: this.config_array_element_info(true, "types", reason.name, 1419)
        }
        true
    }

    ; processingDiagnostic.createDiagnosticExplainingFile: about a program file
    ; (`file_index` >= 0, its include reasons) and/or for one include reason; at the
    ; first reference that includes it, with the reasons as a chain unless that
    ; reference is the only one, the other reasons as related information; null
    ; after a stop
    procedure explaining_diagnostic(this, file_index: int, diagnostic_reason: ref[IncludeReason]?, code: int, args: ref[Array[String]]?) returns ref[DriverDiagnostic]?
    {
        let ld loader as ref[ProgramLoader]
        let reasons &Array[ref[IncludeReason]]^host()
        if file_index >= 0
        {
            let node ld.node_for(pf.path_at(file_index))
            var k 0
            while k < (node.reasons.get_length() as int)
            {
                reasons.add(node.reasons[k as size_t])
                set k: k + 1
            }
        }
        if diagnostic_reason <> null
        {
            let dr diagnostic_reason as ref[IncludeReason]
            var known false
            var k 0
            while k < (reasons.get_length() as int)
            {
                if (reasons[k as size_t] as ref[IncludeReason]) = dr
                    set known: true
                set k: k + 1
            }
            if known = false
                reasons.add(dr)
        }
        let details ExplainMessages.create(host)
        let related &Array[ref[DriverDiagnostic]]^host()
        var preferred: ref[IncludeReason]? null
        if diagnostic_reason <> null
        {
            let dr diagnostic_reason as ref[IncludeReason]
            if (dr.kind <= FileIncludeKindLibReferenceDirective) and (dr.synthetic = false)
                set preferred: dr
        }
        var i 0
        while i < (reasons.get_length() as int)
        {
            let reason reasons[i as size_t]
            set i: i + 1
            if this.reason_message(reason, false, details) = false
                return null
            if (preferred = null) and (reason.kind <= FileIncludeKindLibReferenceDirective) and (reason.synthetic = false)
            {
                set preferred: reason
                continue
            }
            if (preferred <> null) and ((preferred as ref[IncludeReason]) = reason)
                continue
            var info: ref[DriverDiagnostic]? null
            if this.reason_related_info(reason, &info) = false
                return null
            if info <> null
                related.add(info as ref[DriverDiagnostic])
        }
        let chain &Array[ChainLine]^host()
        if (file_index >= 0) or (reasons.get_length() > 0)
        {
            if (preferred = null) or (reasons.get_length() <> 1)
            {
                chain.add(ChainLine(1, 1430, null, false, null))
                var d 0
                while d < (details.codes.get_length() as int)
                {
                    chain.add(ChainLine(2, details.codes[d as size_t], details.args[d as size_t], false, null))
                    set d: d + 1
                }
            }
        }
        if file_index >= 0
        {
            let redirects ExplainMessages.create(host)
            this.redirect_and_format_messages(pf.path_at(file_index), file_index, 0 - 1, false, redirects)
            var r 0
            while r < (redirects.codes.get_length() as int)
            {
                chain.add(ChainLine(1, redirects.codes[r as size_t], redirects.args[r as size_t], false, null))
                set r: r + 1
            }
        }
        var chain_or_null: ref[Array[ChainLine]]? null
        if chain.get_length() > 0
            set chain_or_null: chain
        var related_or_null: ref[Array[ref[DriverDiagnostic]]]? null
        if related.get_length() > 0
            set related_or_null: related
        let none: Slice[char] ""
        if preferred <> null
        {
            let p preferred as ref[IncludeReason]
            return &DriverDiagnostic^host(pf.path_at(p.file_index), pf.text_at(p.file_index), p.pos, p.end, code, args, chain_or_null, related_or_null)
        }
        &DriverDiagnostic^host(none, none, 0, 0, code, args, chain_or_null, related_or_null)
    }

    ; GetTsConfigPropArrayElementValue / GetOptionsSyntaxByArrayElementValue: the
    ; config's string element `value` of the array at `property` (inside
    ; compilerOptions when `in_compiler_options`) as a related diagnostic; null
    ; when the config has none
    procedure config_array_element_info(this, in_compiler_options: bool, property: Slice[char], value: Slice[char], code: int) returns ref[DriverDiagnostic]?
    {
        if (config_path.length as int) = 0
            return null
        let ld loader as ref[ProgramLoader]
        let name String^host(config_path.data as pointer[const_char], config_path.length)
        let source String^host(config_text.data as pointer[const_char], config_text.length)
        var unported 0 - 1
        var tag: Slice[char] ""
        var detail 0
        let parsed Parser.parse_ex(host, name, source, ScriptKindJSON, &unported, &tag, &detail)
        if unported >= 0
            return null
        let verifier &OptionVerifier^host(host, ld, Parser.source_file_of(parsed), config_text)
        var object verifier.root_object()
        if in_compiler_options
        {
            let options_property verifier.property_named(object, "compilerOptions", "")
            if options_property = null
                return null
            set object: AstNode.initializer_of(options_property)
            if AstNode.kind_of(object) <> KindObjectLiteralExpression
                return null
        }
        let found verifier.property_named(object, property, "")
        if found = null
            return null
        let array AstNode.initializer_of(found)
        var e 0
        repeat
        {
            let element TsConfigParser.element_node_at(array, e)
            if element = null
                return null
            set e: e + 1
            let en element as ref[AstNode]
            if AstNode.kind_of(en) <> KindStringLiteral
                continue
            let text AstNode.literal_text_of(en)
            if text.equals(value)
            {
                let start Scanner.skip_trivia(config_text, AstNode.pos_of(en))
                return &DriverDiagnostic^host(config_path, config_text, start, AstNode.end_of(en), code, null, null, null)
            }
        }
    }

    ; CompilerOptions.UsesWildcardTypes
    function uses_wildcard_types(types: Slice[char]) returns bool
    {
        var start 0
        var i 0
        while i <= (types.length as int)
        {
            var at_end i = (types.length as int)
            var is_comma false
            if at_end = false
                set is_comma: (types[i as size_t] as int) = ("," as char) as int
            if at_end or is_comma
            {
                var s start
                var e i
                while (s < e) and ((types[s as size_t] as int) = (" " as char) as int)
                    set s: s + 1
                while (e > s) and ((types[(e - 1) as size_t] as int) = (" " as char) as int)
                    set e: e - 1
                if ((e - s) = 1) and ((types[s as size_t] as int) = ("*" as char) as int)
                    return true
                set start: i + 1
            }
            set i: i + 1
        }
        false
    }

    ; PackageId.String over the resolver's `name|sub|version|peers` key
    function package_id_text(key: Slice[char]) returns String
    {
        var parts 0
        var sb StringBuilder()
        var start 0
        var i 0
        while i <= (key.length as int)
        {
            var at_end i = (key.length as int)
            var is_bar false
            if at_end = false
                set is_bar: (key[i as size_t] as int) = ("|" as char) as int
            if at_end or is_bar
            {
                let piece key.subslice(start as size_t, i as size_t)
                if parts = 0
                    sb.append(piece.data, piece.length)
                if parts = 1
                {
                    if (piece.length as int) > 0
                    {
                        sb.append("/")
                        sb.append(piece.data, piece.length)
                    }
                }
                if parts = 2
                {
                    sb.append("@")
                    sb.append(piece.data, piece.length)
                }
                if parts = 3
                    sb.append(piece.data, piece.length)
                set parts: parts + 1
                set start: i + 1
            }
            set i: i + 1
        }
        sb.to_string()
    }

    function source_node(this, i: int) returns ref[AstNode]?
    {
        let index this.source_pf_index(i)
        if index < 0
            return lib_nodes[i as size_t]
        pf.file_at(index)
    }

    ; the source file whose path is `path`, -1 when the program holds none
    function source_index_of_path(this, path: Slice[char]) returns int
    {
        let n this.source_file_count()
        var i 0
        while i < n
        {
            let p this.source_path(i)
            if p.equals(path)
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; the source file of a node, -1 when the program holds none
    function source_index_of_node(this, file: ref[AstNode]?) returns int
    {
        if file = null
            return 0 - 1
        let n this.source_file_count()
        var i 0
        while i < n
        {
            let f this.source_node(i)
            if f = file
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; SourceFileMayBeEmitted(file, false)
    function source_may_be_emitted(this, i: int) returns bool
    {
        let index this.source_pf_index(i)
        if index < 0
            return false
        let ld loader as ref[ProgramLoader]
        ld.source_file_may_be_emitted(index)
    }

    function source_is_declaration_file(this, i: int) returns bool
    {
        let index this.source_pf_index(i)
        if index < 0
            return true
        is_declaration_file_name_of(pf.path_at(index))
    }

    ; SkipTypeChecking(file, ignoreNoCheck)
    function source_skip_type_checking(this, i: int, ignore_no_check: bool) returns bool
    {
        let index this.source_pf_index(i)
        if index < 0
        {
            if this.flag("noCheck") and (ignore_no_check = false)
                return true
            return this.flag("skipLibCheck") or this.flag("skipDefaultLibCheck")
        }
        this.skip_type_checking_ex(index, ignore_no_check)
    }

    ; SourceFileMetaData.ImpliedNodeFormat
    function source_implied_node_format(this, i: int) returns int
    {
        let index this.source_pf_index(i)
        if index < 0
            return 1
        let path pf.path_at(index)
        Checker.implied_node_format_for_file(path, this.unit_package_json_type(path))
    }

    ; fileAffectsGlobalScope
    function source_affects_global_scope(this, i: int) returns bool
    {
        let file_opt this.source_node(i)
        if file_opt = null
            return false
        let file file_opt as ref[AstNode]
        let index this.source_pf_index(i)
        var is_external false
        var is_declaration true
        if index >= 0
        {
            let b pf.binder_at(index) as ref[Binder]
            set is_external: b.is_external_or_common_js_module()
            set is_declaration: b.is_declaration_file_of()
            let path pf.path_at(index)
            if DriverProgram.has_global_augmentation(file, is_external, is_declaration)
                return true
            if path.ends_with(".json")
                return false
        }
        if is_external
            return false
        let statements AstNode.statements_of(file)
        var k 0
        while k < AstNode.list_count(statements)
        {
            let st AstNode.child_in_list(statements, k)
            set k: k + 1
            if st = null
                continue
            let sn st as ref[AstNode]
            if AstNode.kind_of(sn) <> KindModuleDeclaration
                return true
            let name AstNode.name_of(sn)
            if name = null
                return true
            if AstNode.kind_of(name as ref[AstNode]) <> KindStringLiteral
                return true
        }
        false
    }

    ; a `declare global` among the file's module augmentations (collectModuleReferences)
    function has_global_augmentation(file: ref[AstNode], is_external: bool, is_declaration: bool) returns bool
    {
        let statements AstNode.statements_of(file)
        var k 0
        while k < AstNode.list_count(statements)
        {
            let st AstNode.child_in_list(statements, k)
            set k: k + 1
            if st <> null
            {
                if DriverProgram.global_augmentation_in(st as ref[AstNode], false, is_external, is_declaration)
                    return true
            }
        }
        false
    }

    function global_augmentation_in(node: ref[AstNode], in_ambient_module: bool, is_external: bool, is_declaration: bool) returns bool
    {
        if AstNode.kind_of(node) <> KindModuleDeclaration
            return false
        if Binder.is_ambient_module(node) = false
            return false
        var eligible in_ambient_module or is_declaration
        if Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient)
            set eligible: true
        if eligible = false
            return false
        let name AstNode.name_of(node)
        var name_text Slice[char]()
        if name <> null
            set name_text: AstNode.literal_text_of(name as ref[AstNode])
        if is_external or (in_ambient_module and (is_external_module_name_relative(name_text) = false))
            return Binder.is_global_scope_augmentation(node)
        if in_ambient_module
            return false
        let body AstNode.body_of(node)
        if body = null
            return false
        let statements AstNode.statements_of(body)
        var k 0
        while k < AstNode.list_count(statements)
        {
            let st AstNode.child_in_list(statements, k)
            set k: k + 1
            if st <> null
            {
                if DriverProgram.global_augmentation_in(st as ref[AstNode], true, is_external, is_declaration)
                    return true
            }
        }
        false
    }

    ; getReferencedFiles: the paths a file's imports, references, type reference
    ; directives, module augmentations and every ambient module lead to; empty for
    ; none, null after a stop
    procedure referenced_files(this, i: int) returns ref[Array[Slice[char]]]?
    {
        let out &Array[Slice[char]]^host()
        let index this.source_pf_index(i)
        let file_opt this.source_node(i)
        if file_opt = null
            return out
        let file file_opt as ref[AstNode]
        let cd checker as ref[Checker]
        let ld loader as ref[ProgramLoader]
        let mark cd.unported_mark()
        let log_before Checker.stop_count(cd)
        if index >= 0
        {
            cd.select_program_file(index, pf.format_at(index))
            let imports ld.specifiers.imports_of(file)
            var ii 0
            while ii < (imports.get_length() as int)
            {
                let entry imports[ii as size_t]
                set ii: ii + 1
                if entry <> null
                {
                    let symbol cd.get_symbol_at_location(entry as ref[AstNode], false)
                    if this.checker_stopped(cd, mark, log_before)
                        return null
                    this.add_symbol_files(file, symbol, out)
                }
            }
            let directory get_directory_path(host, pf.path_at(index))
            let refs AstNode.referenced_files_of(file)
            if refs <> null
            {
                let rl refs as ref[Array[Slice[char]]]
                var ri 0
                while ri < (rl.get_length() as int)
                {
                    let name rl[ri as size_t]
                    set ri: ri + 1
                    DriverProgram.add_path(out, get_normalized_absolute_path(host, name, directory))
                }
            }
            let node_opt ld.node_for(pf.path_at(index))
            let edges node_opt.edges
            var ei 0
            while ei < (edges.get_length() as int)
            {
                let edge edges[ei as size_t]
                set ei: ei + 1
                if edge.reason.kind = FileIncludeKindTypeReferenceDirective
                    DriverProgram.add_path(out, edge.path)
            }
            let b pf.binder_at(index) as ref[Binder]
            let augmentations &Array[ref[AstNode]?]^host()
            ld.collect_module_augmentations(file, b.is_external_module_of(), b.is_declaration_file_of(), augmentations)
            var ai 0
            while ai < (augmentations.get_length() as int)
            {
                let name augmentations[ai as size_t]
                set ai: ai + 1
                if name <> null
                {
                    let symbol cd.get_symbol_at_location(name as ref[AstNode], false)
                    if this.checker_stopped(cd, mark, log_before)
                        return null
                    this.add_symbol_files(file, symbol, out)
                }
            }
        }
        let table cd.globals
        var gi 0
        while gi < SymbolTable.length(table)
        {
            let entry_opt SymbolTable.entry_at(table, gi)
            set gi: gi + 1
            if entry_opt = null
                continue
            let entry entry_opt as ref[SymbolTableEntry]
            if (entry.name.length as int) < 2
                continue
            if ((*(entry.name.data) as int) = 34) and ((*(entry.name.data + (entry.name.length - 1)) as int) = 34)
                this.add_symbol_files(file, entry.symbol, out)
        }
        out
    }

    procedure add_path(out: ref[Array[Slice[char]]], path: Slice[char])
    {
        if ExecSystem.contains(out, path) = false
            out.add(path)
    }

    ; addReferencedFilesFromSymbol
    procedure add_symbol_files(this, file: ref[AstNode], symbol: ref[Symbol]?, out: ref[Array[Slice[char]]])
    {
        if symbol = null
            return
        let s symbol as ref[Symbol]
        let dn Symbol.declaration_count(s)
        if dn = 0
            return
        var di 0
        while di < dn
        {
            let d Symbol.declaration_at(s, di)
            set di: di + 1
            let of Checker.source_file_of_node(d)
            if (of = null) or (of = file)
                continue
            let si this.source_index_of_node(of)
            if si >= 0
                DriverProgram.add_path(out, this.source_path(si))
        }
    }

    ; ── SortAndDeduplicateDiagnostics ────────────────────────────────────────

    function compare_args(a: ref[Array[String]]?, b: ref[Array[String]]?) returns int
    {
        var na 0
        var nb 0
        if a <> null
            set na: (a as ref[Array[String]]).get_length() as int
        if b <> null
            set nb: (b as ref[Array[String]]).get_length() as int
        var i 0
        while (i < na) and (i < nb)
        {
            let la a as ref[Array[String]]
            let lb b as ref[Array[String]]
            let sa la[i as size_t]
            let sb lb[i as size_t]
            let c DiagnosticWriter.compare_bytes(Slice[char](sa.get_length(), sa.get_buffer() as pointer[char]), Slice[char](sb.get_length(), sb.get_buffer() as pointer[char]))
            if c <> 0
                return c
            set i: i + 1
        }
        na - nb
    }

    function chain_size(chain: ref[Array[ChainLine]]?) returns int
    {
        if chain = null
            return 0
        (chain as ref[Array[ChainLine]]).get_length() as int
    }

    ; CompareDiagnostics without the related information this port does not carry
    function compare(a: ref[DriverDiagnostic], b: ref[DriverDiagnostic]) returns int
    {
        let c DiagnosticWriter.compare_bytes(a.file_name, b.file_name)
        if c <> 0
            return c
        if a.pos <> b.pos
            return a.pos - b.pos
        if a.end <> b.end
            return a.end - b.end
        if a.code <> b.code
            return a.code - b.code
        let ca DriverProgram.compare_args(a.args, b.args)
        if ca <> 0
            return ca
        let sa DriverProgram.chain_size(a.chain)
        let sb DriverProgram.chain_size(b.chain)
        if sa <> sb
            return sa - sb
        if sa > 0
        {
            let la a.chain as ref[Array[ChainLine]]
            let lb b.chain as ref[Array[ChainLine]]
            var i 0
            while i < sa
            {
                let x la[i as size_t]
                let y lb[i as size_t]
                if x.code <> y.code
                    return x.code - y.code
                let cx DriverProgram.compare_args(x.args, y.args)
                if cx <> 0
                    return cx
                if x.level <> y.level
                    return x.level - y.level
                set i: i + 1
            }
        }
        DriverProgram.compare_related(a.related, b.related)
    }

    function related_size(r: ref[Array[ref[DriverDiagnostic]]]?) returns int
    {
        if r = null
            return 0
        (r as ref[Array[ref[DriverDiagnostic]]]).get_length() as int
    }

    ; compareRelatedInfo: the LONGER list first, then element by element
    function compare_related(a: ref[Array[ref[DriverDiagnostic]]]?, b: ref[Array[ref[DriverDiagnostic]]]?) returns int
    {
        let na DriverProgram.related_size(a)
        let nb DriverProgram.related_size(b)
        if na <> nb
            return nb - na
        var i 0
        while i < na
        {
            let la a as ref[Array[ref[DriverDiagnostic]]]
            let lb b as ref[Array[ref[DriverDiagnostic]]]
            let c DriverProgram.compare(la[i as size_t], lb[i as size_t])
            if c <> 0
                return c
            set i: i + 1
        }
        0
    }

    ; EqualDiagnosticsNoRelatedInfo
    function equal_no_related(a: ref[DriverDiagnostic], b: ref[DriverDiagnostic]) returns bool
    {
        let ra a.related
        let rb b.related
        set a.related: null
        set b.related: null
        let c DriverProgram.compare(a, b)
        set a.related: ra
        set b.related: rb
        c = 0
    }

    ; a stable sort, then the equal runs collapsed to their first
    procedure sort_and_deduplicate(host: ref[Page], list: ref[Array[ref[DriverDiagnostic]]]) returns ref[Array[ref[DriverDiagnostic]]]
    {
        let sorted &Array[ref[DriverDiagnostic]]^host()
        var i 0
        while i < (list.get_length() as int)
        {
            let d list[i as size_t]
            set i: i + 1
            sorted.add(d)
            var j (sorted.get_length() as int) - 1
            while j > 0
            {
                let prev sorted[(j - 1) as size_t]
                if DriverProgram.compare(prev, d) <= 0
                    break
                sorted.put(j as size_t, prev)
                set j: j - 1
            }
            sorted.put(j as size_t, d)
        }
        ; compactAndMergeRelatedInfos: a run equal but for its related information is
        ; one diagnostic carrying the run's related information, sorted and compacted
        let out &Array[ref[DriverDiagnostic]]^host()
        var k 0
        let total sorted.get_length() as int
        while k < total
        {
            let d sorted[k as size_t]
            var n 1
            while ((k + n) < total) and DriverProgram.equal_no_related(d, sorted[(k + n) as size_t])
                set n: n + 1
            if n = 1
            {
                out.add(d)
                set k: k + 1
                continue
            }
            let merged &Array[ref[DriverDiagnostic]]^host()
            var m 0
            while m < n
            {
                let run_entry sorted[(k + m) as size_t]
                let r run_entry.related
                if r <> null
                {
                    let rl r as ref[Array[ref[DriverDiagnostic]]]
                    var q 0
                    while q < (rl.get_length() as int)
                    {
                        merged.add(rl[q as size_t])
                        set q: q + 1
                    }
                }
                set m: m + 1
            }
            if merged.get_length() = 0
                out.add(d)
            else
            {
                let compact DriverProgram.sort_and_deduplicate(host, merged)
                out.add(&DriverDiagnostic^host(d.file_name, d.text, d.pos, d.end, d.code, d.args, d.chain, compact))
            }
            set k: k + n
        }
        out
    }

    ; program.go plainJSErrors
    function is_plain_js_error(code: int) returns bool
    {
        if (code >= 1005) and (code <= 1215)
        {
            if (code = 1005) or (code = 1009) or (code = 1013) or (code = 1014) or (code = 1029) or (code = 1030) or (code = 1031) or (code = 1042) or (code = 1044) or (code = 1048) or (code = 1049) or (code = 1053) or (code = 1054)
                return true
            if (code = 1089) or (code = 1090) or (code = 1091) or (code = 1097) or (code = 1100) or (code = 1101) or (code = 1102) or (code = 1104) or (code = 1105) or (code = 1106) or (code = 1107) or (code = 1111) or (code = 1113)
                return true
            if (code = 1114) or (code = 1115) or (code = 1116) or (code = 1123) or (code = 1155) or (code = 1156) or (code = 1162) or (code = 1171) or (code = 1172) or (code = 1174) or (code = 1182) or (code = 1184) or (code = 1186)
                return true
            if (code = 1188) or (code = 1189) or (code = 1190) or (code = 1191) or (code = 1193) or (code = 1197) or (code = 1200) or (code = 1210) or (code = 1211) or (code = 1214) or (code = 1215)
                return true
            return false
        }
        if (code = 1248) or (code = 1255) or (code = 1258) or (code = 1262) or (code = 1308) or (code = 1312) or (code = 1325) or (code = 1341) or (code = 1344) or (code = 1358) or (code = 1359) or (code = 1368)
            return true
        if (code = 1450) or (code = 1451) or (code = 1473) or (code = 1474) or (code = 2451) or (code = 2462) or (code = 2480) or (code = 2492) or (code = 2501) or (code = 2528) or (code = 2566) or (code = 2633)
            return true
        if (code = 2752) or (code = 2753) or (code = 2803) or (code = 2839) or (code = 2852) or (code = 5076) or (code = 17000) or (code = 17001) or (code = 17012)
            return true
        (code = 18006) or (code = 18007) or (code = 18012) or (code = 18013) or (code = 18016) or (code = 18036) or (code = 18038) or (code = 18041)
    }
}
