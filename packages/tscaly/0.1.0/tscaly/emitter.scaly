; SPDX-License-Identifier: Apache-2.0
;
; emitter — the JS half of internal/compiler/emitter.go, and the TRANSFORMERS it
; runs: internal/transformers (transformer.go, chain.go, modifiervisitor.go,
; utilities.go), tstransforms/typeeraser.go, estransforms/usestrict.go and
; moduletransforms/esmodule.go (+ utilities.go). Ported from
; microsoft/typescript-go at the pin named in tscaly.scaly.
;
; ★★★ THE TRANSFORMER HIERARCHY IS ONE RECORD WITH A TAG (§3.41). The reference
; embeds `transformers.Transformer` in every transformer struct and hands the
; visitor a method value; here `Transformer` carries a `tag`, the fields of
; every transformer (prefixed where they would collide), and ONE `visit` that
; dispatches on the tag. The NodeVisitor reaches it through its `transformer`
; field under `VisitTagTransformer` (§3.18: a func value is a tag).
;
; ★★★ EVERY TRANSFORMER THE DRIVER DOES NOT RUN YET IS A SAID STOP. The reference
; gates each of them by the file's SubtreeFacts; this port has no facts, so the
; driver SCANS the file for what each unported transformer would act on and
; records `transform-<name>` when it finds it — the unit is UNPORTED, never
; emitted wrongly. The gates and the chain order are in `Emitter.emit_js`.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
; the whole ast module: the facts read a field of most of the 134 records
use tscaly.ast.*
use tscaly.parser.Parser
use tscaly.binder.Binder
use tscaly.checker.Checker
use tscaly.checker.EvalResult
use tscaly.printer.EmitContext
use tscaly.printer.NameGenerator
use tscaly.printer.EmitHelper
use tscaly.printer.Printer
use tscaly.printer.PrinterOptions
use tscaly.printer.SourceFileInfo
use tscaly.printer.TextWriter
use tscaly.printer.NameNode
use tscaly.printer.TextRange
use tscaly.factory.NodeFactory
use tscaly.factory.NodeVisitor

; core.JsxEmit
define JsxEmitNone: int 0
define JsxEmitPreserve: int 1
define JsxEmitReactNative: int 2
define JsxEmitReact: int 3
define JsxEmitReactJSX: int 4
define JsxEmitReactJSXDev: int 5

; ast.OEKAllExceptAssertionsOrExpressionsWithTypeArguments = OEKAll &^ OEKAssertions
; &^ OEKExpressionsWithTypeArguments = OEKParentheses | OEKPartiallyEmittedExpressions
define OEKAllExceptAssertionsOrExpressionsWithTypeArguments: int 9

define TransformerTagNone: int 0
define TransformerTagTypeEraser: int 1
define TransformerTagUseStrict: int 2
define TransformerTagESModule: int 3
define TransformerTagChain: int 4
define TransformerTagModifierVisitor: int 5
define TransformerTagImportElision: int 6
define TransformerTagRuntimeSyntax: int 7
define TransformerTagConstEnumInlining: int 8
define TransformerTagUsing: int 9
; estransforms/using.go usingKind
define UsingKindNone:  int 0
define UsingKindSync:  int 1
define UsingKindAsync: int 2
; ast.ModifierFlagsTypeScriptModifier
define ModifierFlagsTypeScriptModifier: int ModifierFlagsAmbient | ModifierFlagsPublic | ModifierFlagsPrivate | ModifierFlagsProtected | ModifierFlagsReadonly | ModifierFlagsAbstract | ModifierFlagsConst | ModifierFlagsOverride | ModifierFlagsIn | ModifierFlagsOut

; ── ast/subtreefacts.go — the transformers' gate (slice 237) ──────────────────
;
; The reference gates EVERY transformer on `node.SubtreeFacts()`: the type
; eraser returns a subtree without SubtreeContainsTypeScript untouched (so a
; bodiless overload `function f1(),` prints as `function f1() { }` and a `static
; constructor() { }` keeps its `static`), the class-fields transformer asks for
; ContainsClassFields, `using` for ContainsUsing, and so on. The facts are the
; per-kind computeSubtreeFacts of ast.go / ast_generated.go (110 of them, the
; scope exclusions of subtreefacts.go applied on the way UP by
; propagateSubtreeFacts), cached on the node behind SubtreeFactsComputed.
;
; ★ The cache slot is `AstNode.subtree_facts` (0 = not yet computed; the
; reference caches on CompositeBase nodes only and recomputes the leaves — the
; answer is the same, computeSubtreeFacts being idempotent). A node the FACTORY
; makes (an updated node) starts at 0 too, so a transformed tree is asked afresh.

define SubtreeContainsTypeScript:                    int 1 << 0
define SubtreeContainsJsx:                           int 1 << 1
define SubtreeContainsESDecorators:                  int 1 << 2
define SubtreeContainsUsing:                         int 1 << 3
define SubtreeContainsClassStaticBlocks:             int 1 << 4
define SubtreeContainsESClassFields:                 int 1 << 5
define SubtreeContainsLogicalAssignments:            int 1 << 6
define SubtreeContainsNullishCoalescing:             int 1 << 7
define SubtreeContainsOptionalChaining:              int 1 << 8
define SubtreeContainsMissingCatchClauseVariable:    int 1 << 9
define SubtreeContainsESObjectRestOrSpread:          int 1 << 10
define SubtreeContainsForAwaitOrAsyncGenerator:      int 1 << 11
define SubtreeContainsAnyAwait:                      int 1 << 12
define SubtreeContainsExponentiationOperator:        int 1 << 13
define SubtreeContainsLexicalThis:                   int 1 << 14
define SubtreeContainsLexicalSuper:                  int 1 << 15
define SubtreeContainsRestOrSpread:                  int 1 << 16
define SubtreeContainsObjectRestOrSpread:            int 1 << 17
define SubtreeContainsAwait:                         int 1 << 18
define SubtreeContainsDynamicImport:                 int 1 << 19
define SubtreeContainsClassFields:                   int 1 << 20
define SubtreeContainsDecorators:                    int 1 << 21
define SubtreeContainsIdentifier:                    int 1 << 22
define SubtreeContainsPrivateIdentifierInExpression: int 1 << 23
define SubtreeContainsInvalidTemplateEscape:         int 1 << 24
define SubtreeFactsComputed:                         int 1 << 25
define SubtreeFactsNone:                             int 0
; every fact bit below the Computed marker
define SubtreeFactsAllBits:                          int 33554431
define SubtreeContainsLexicalThisOrSuper:            int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper

; The scope exclusions, spelled as the bits a scope CLEARS on the way up
; (subtreefacts.go spells them as the complement; SubtreeExclusionsNode is the
; Computed marker alone, which `subtree_facts` never hands out)
define SubtreeClearsFunction:                int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper | SubtreeContainsAwait | SubtreeContainsObjectRestOrSpread
define SubtreeClearsArrowFunction:           int SubtreeContainsAwait | SubtreeContainsObjectRestOrSpread
define SubtreeClearsProperty:                int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper
define SubtreeClearsModule:                  int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper
define SubtreeClearsObjectLiteral:           int SubtreeContainsObjectRestOrSpread
define SubtreeClearsVariableDeclarationList: int SubtreeContainsObjectRestOrSpread
define SubtreeClearsCatchClause:             int SubtreeContainsObjectRestOrSpread
define SubtreeClearsBindingPattern:          int SubtreeContainsRestOrSpread

; core.CompilerOptions, the slots the emit reads. Every unset option is its zero
; (a Tristate is `TristateUnknown`), as the yardstick's `&core.CompilerOptions{}`.
define EmitOptions
(
    target: int
    module_kind: int
    jsx: int
    remove_comments: bool
    no_emit_helpers: bool
    new_line: int
    verbatim_module_syntax: int
    isolated_modules: int
    experimental_decorators: int
    emit_decorator_metadata: int
    import_helpers: int
    rewrite_relative_import_extensions: int
    use_define_for_class_fields: int
    preserve_const_enums: int
)
{
    function defaults() returns EmitOptions
        EmitOptions(ScriptTargetNone, ModuleKindNone, 0, false, false, NewLineKindNone, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown)

    function get_emit_script_target(this) returns int
    {
        if target <> ScriptTargetNone
            return target
        ; ScriptTargetLatestStandard
        ScriptTargetES2025
    }

    function get_emit_module_kind(this) returns int
    {
        if module_kind <> ModuleKindNone
            return module_kind
        let t this.get_emit_script_target()
        if t = ScriptTargetLatest
            return ModuleKindESNext
        if t >= ScriptTargetES2022
            return ModuleKindES2022
        if t >= ScriptTargetES2020
            return ModuleKindES2020
        if t >= ScriptTargetES2015
            return ModuleKindES2015
        ModuleKindCommonJS
    }

    function get_jsx_transform_enabled(this) returns bool
        (jsx = JsxEmitReact) or (jsx = JsxEmitReactJSX) or (jsx = JsxEmitReactJSXDev)

    function get_isolated_modules(this) returns bool
        (isolated_modules = TristateTrue) or (verbatim_module_syntax = TristateTrue)

    function get_use_define_for_class_fields(this) returns bool
    {
        if use_define_for_class_fields = TristateUnknown
            return this.get_emit_script_target() >= ScriptTargetES2022
        use_define_for_class_fields = TristateTrue
    }

    function should_preserve_const_enums(this) returns bool
        (preserve_const_enums = TristateTrue) or this.get_isolated_modules()

    ; ast.GetEmitModuleFormatOfFileWorker for a file with no package.json above
    ; it: the implied node format is CommonJS for `.cjs`/`.cts`, ESNext for
    ; `.mjs`/`.mts`, else the emit module kind itself.
    function get_emit_module_format_of_file(this, file_name: Slice[char]) returns int
    {
        let mk this.get_emit_module_kind()
        if (mk >= ModuleKindNode16) and (mk <= ModuleKindNodeNext)
        {
            if file_name.ends_with(".mjs") or file_name.ends_with(".mts")
                return ModuleKindESNext
            return ModuleKindCommonJS
        }
        if file_name.ends_with(".cjs") or file_name.ends_with(".cts")
            return ModuleKindCommonJS
        if file_name.ends_with(".mjs") or file_name.ends_with(".mts")
            return ModuleKindESNext
        mk
    }
}

; transformers.TransformOptions: the context, the options, and the resolver —
; which is the checker here (§3.41), beside the binder for the file's flags.
define TransformOptions
(
    context: ref[EmitContext]
    options: EmitOptions
    checker: ref[Checker]?
    binder: ref[Binder]?
    file_info: ref[SourceFileInfo]
)

define Transformer
(
    host: ref[Page]
    tag: int
    context: ref[EmitContext]
    factory: ref[NodeFactory]
    visitor: ref[NodeVisitor]?
    opts: TransformOptions
    parent_node: ref[AstNode]?
    current_node: ref[AstNode]?
    components: ref[Array[ref[Transformer]?]]
    allowed_modifiers: int
    current_source_file: ref[AstNode]?
    import_require_statements: ref[Array[ref[AstNode]?]]?
    require_helper_name: ref[AstNode]?
    ; runtimesyntax.go's scope state (slice 238)
    current_scope: ref[AstNode]?
    current_scope_first_declarations: ref[Array[NameNode]]?
    current_enum: ref[AstNode]?
    current_namespace: ref[AstNode]?
    ; using.go's hoisting state (slice 239)
    export_bindings: ref[Array[NameNode]]?
    export_vars: ref[Array[ref[AstNode]?]]?
    default_export_binding: ref[AstNode]?
    export_equals_binding: ref[AstNode]?
    unported_count: int
    unported_tag: Slice[char]
    unported_detail: int
)
{
    ; NewTransformer: the visitor is the context's, with this transformer as its
    ; visit callback.
    function create(host: ref[Page], tag: int, opts: TransformOptions) returns ref[Transformer]
    {
        let comps &Array[ref[Transformer]?]^host()
        let no_tag: Slice[char] ""
        let t &Transformer^host(host, tag, opts.context, opts.context.the_factory(), null, opts, null, null, comps, 0, null, null, null, null, null, null, null, null, null, null, null, 0, no_tag, 0)
        let v opts.context.new_node_visitor(VisitTagTransformer)
        set v.transformer: t
        set t.visitor: v
        t
    }

    procedure record_unported(this, tag_text: Slice[char], detail: int)
    {
        if unported_count = 0
        {
            set this.unported_tag: tag_text
            set this.unported_detail: detail
        }
        set this.unported_count: unported_count + 1
    }

    function the_visitor(this) returns ref[NodeVisitor]
        visitor as ref[NodeVisitor]

    function the_checker(this) returns ref[Checker]
        opts.checker as ref[Checker]

    procedure transform_source_file(this, file: ref[AstNode]) returns ref[AstNode]
    {
        let visited this.the_visitor().visit_node(file)
        if visited = null
        {
            this.record_unported("transform-dropped-source-file", tag)
            return file
        }
        visited as ref[AstNode]
    }

    ; the one `visit` — the func value of every transformer, by tag
    procedure visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if tag = TransformerTagTypeEraser
            return this.visit_type_eraser(node)
        if tag = TransformerTagUseStrict
            return this.visit_use_strict(node)
        if tag = TransformerTagESModule
            return this.visit_es_module(node)
        if tag = TransformerTagChain
            return this.visit_chain(node)
        if tag = TransformerTagModifierVisitor
            return this.visit_modifier(node)
        if tag = TransformerTagImportElision
            return this.visit_import_elision(node)
        if tag = TransformerTagRuntimeSyntax
            return this.visit_runtime_syntax(node)
        if tag = TransformerTagConstEnumInlining
            return this.visit_const_enum_inlining(node)
        if tag = TransformerTagUsing
            return this.visit_using(node)
        this.record_unported("transformer-tag", tag)
        node
    }

    ; ═══ tstransforms/importelision.go (slice 237) ═══

    procedure visit_import_elision(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let k node.kind
        if k = KindSourceFile
        {
            this.the_checker().mark_linked_references_recursively(context.most_original(node) as ref[AstNode])
            let saved current_source_file
            set this.current_source_file: node
            let visited v.visit_each_child(node)
            set this.current_source_file: saved
            return visited
        }
        if k = KindImportEqualsDeclaration
        {
            if AstNode.kind_of(AstNode.module_reference_of(node)) = KindExternalModuleReference
            {
                if this.should_emit_alias_declaration(node) = false
                    return null
            }
            else
            {
                if this.should_emit_import_equals_declaration(node) = false
                    return null
            }
            return v.visit_each_child(node)
        }
        if k = KindImportDeclaration
        {
            let import_clause AstNode.import_clause_of(node)
            if import_clause <> null
            {
                let visited v.visit_node(import_clause)
                if visited = null
                    return null
                return factory.update_import_declaration(node, Printer.modifier_list_of(node), visited, AstNode.module_specifier_of(node), v.visit_node(AstNode.import_attributes_of(node)))
            }
            return v.visit_each_child(node)
        }
        if k = KindImportClause
        {
            var name: ref[AstNode]? null
            if this.should_emit_alias_declaration(node)
                set name: Printer.declaration_name_of(node)
            let named_bindings v.visit_node(AstNode.named_bindings_of(node))
            if (name = null) and (named_bindings = null)
                return null
            return factory.update_import_clause(node, AstNode.import_clause_phase_modifier_of(node), name, named_bindings)
        }
        if k = KindNamespaceImport
        {
            if this.should_emit_alias_declaration(node) = false
                return null
            return node
        }
        if k = KindNamedImports
        {
            let elements v.visit_nodes(AstNode.elements_of(node))
            if Transformer.list_is_empty(elements)
                return null
            return factory.update_named_imports(node, elements)
        }
        if k = KindImportSpecifier
        {
            if this.should_emit_alias_declaration(node) = false
                return null
            return node
        }
        if k = KindExportAssignment
        {
            if (opts.options.verbatim_module_syntax <> TristateTrue) and (this.ie_is_value_alias_declaration(node) = false)
                return null
            return v.visit_each_child(node)
        }
        if k = KindExportDeclaration
        {
            var export_clause: ref[AstNode]? null
            let ec AstNode.export_clause_of(node)
            if ec <> null
            {
                set export_clause: v.visit_node(ec)
                if export_clause = null
                    return null
            }
            return factory.update_export_declaration(node, null, false, export_clause, v.visit_node(AstNode.module_specifier_of(node)), v.visit_node(AstNode.import_attributes_of(node)))
        }
        if k = KindNamedExports
        {
            let elements v.visit_nodes(AstNode.elements_of(node))
            if Transformer.list_is_empty(elements)
                return null
            return factory.update_named_exports(node, elements)
        }
        if k = KindExportSpecifier
        {
            if this.ie_is_value_alias_declaration(node) = false
                return null
            return node
        }
        if (k = KindModuleDeclaration) or (k = KindModuleBlock)
            return v.visit_each_child(node)
        node
    }

    procedure should_emit_alias_declaration(this, node: ref[AstNode]) returns bool
    {
        if (node.flags & NodeFlagsJavaScriptFile) <> 0
            return true
        this.ie_is_referenced_alias_declaration(node)
    }

    procedure should_emit_import_equals_declaration(this, node: ref[AstNode]) returns bool
    {
        if this.should_emit_alias_declaration(node)
            return true
        if opts.file_info.is_external_module
            return false
        this.ie_is_top_level_value_import_equals_with_entity_name(node)
    }

    procedure ie_is_referenced_alias_declaration(this, node: ref[AstNode]) returns bool
    {
        let p context.parse_node(node)
        if p = null
            return true
        this.the_checker().is_referenced_alias_declaration(p as ref[AstNode])
    }

    procedure ie_is_value_alias_declaration(this, node: ref[AstNode]) returns bool
    {
        let p context.parse_node(node)
        if p = null
            return true
        this.the_checker().is_value_alias_declaration(p as ref[AstNode])
    }

    procedure ie_is_top_level_value_import_equals_with_entity_name(this, node: ref[AstNode]) returns bool
    {
        let p context.parse_node(node)
        if p = null
            return false
        this.the_checker().is_top_level_value_import_equals_with_entity_name(p as ref[AstNode])
    }

    ; ═══ tstransforms/runtimesyntax.go (slice 238) ═══
    ;
    ; TypeScript's RUNTIME syntax — enums, namespaces, `import x = N.M`,
    ; parameter properties, the exports of a namespace body — into JavaScript.
    ; The reference's `resolver` (binder.ReferenceResolver with EMPTY hooks) is
    ; `Checker.get_referenced_export_container`, its `emitResolver` the checker
    ; itself (§3.41). One said stop: a destructuring `export var {a} = x` inside a
    ; namespace needs FlattenDestructuringAssignment (transformers/destructuring.go),
    ; which lands with the ES chapter that needs it everywhere.

    procedure push_scope(this, node: ref[AstNode], saved_scope: ref[ref[AstNode]?], saved_names: ref[ref[Array[NameNode]]?])
    {
        set saved_scope: current_scope
        set saved_names: current_scope_first_declarations
        let k node.kind
        if k = KindSourceFile
        {
            set this.current_scope: node
            set this.current_source_file: node
            set this.current_scope_first_declarations: null
            return
        }
        if (k = KindCaseBlock) or (k = KindModuleBlock) or (k = KindBlock)
        {
            set this.current_scope: node
            set this.current_scope_first_declarations: null
            return
        }
        if (k = KindFunctionDeclaration) or (k = KindClassDeclaration) or (k = KindVariableStatement)
            this.record_declaration_in_scope(node)
    }

    procedure pop_scope(this, saved_scope: ref[AstNode]?, saved_names: ref[Array[NameNode]]?)
    {
        if current_scope <> saved_scope
            set this.current_scope_first_declarations: saved_names
        set this.current_scope: saved_scope
    }

    procedure visit_runtime_syntax(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        var saved_scope: ref[AstNode]? null
        var saved_names: ref[Array[NameNode]]? null
        this.push_scope(node, &saved_scope, &saved_names)
        let result this.visit_runtime_syntax_worker(node)
        this.pop_scope(saved_scope, saved_names)
        this.pop_node(grandparent)
        result
    }

    procedure visit_runtime_syntax_worker(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let facts Emitter.subtree_facts(node)
        if (facts & SubtreeContainsTypeScript) = 0
        {
            if (current_namespace = null) and (current_enum = null)
                return node
            if (facts & SubtreeContainsIdentifier) = 0
                return node
        }
        let k node.kind
        ; TypeScript parameter property modifiers are elided
        if (k = KindPublicKeyword) or (k = KindPrivateKeyword) or (k = KindProtectedKeyword) or (k = KindReadonlyKeyword) or (k = KindOverrideKeyword)
            return null
        if k = KindEnumDeclaration
            return this.rs_visit_enum_declaration(node)
        if k = KindModuleDeclaration
            return this.rs_visit_module_declaration(node)
        if k = KindClassDeclaration
            return this.rs_visit_class_declaration(node)
        if k = KindClassExpression
            return this.rs_visit_class_expression(node)
        if k = KindConstructor
            return this.rs_visit_constructor_declaration(node)
        if k = KindFunctionDeclaration
            return this.rs_visit_function_declaration(node)
        if k = KindVariableStatement
            return this.rs_visit_variable_statement(node)
        if (k = KindExportDeclaration) or (k = KindImportDeclaration) or (k = KindImportClause)
        {
            ; do not emit ES6 imports and exports since they are illegal inside a namespace
            if this.rs_in_namespace_body()
                return null
            return v.visit_each_child(node)
        }
        if k = KindImportEqualsDeclaration
        {
            let external AstNode.kind_of(AstNode.module_reference_of(node)) = KindExternalModuleReference
            if this.rs_in_namespace_body() and external
                return null
            if (current_namespace <> null) and (current_scope <> null) and (AstNode.kind_of(current_scope) = KindBlock) and (external = false)
                return null
            return this.rs_visit_import_equals_declaration(node)
        }
        if k = KindIdentifier
            return this.rs_visit_identifier(node)
        if k = KindShorthandPropertyAssignment
            return this.rs_visit_shorthand_property_assignment(node)
        v.visit_each_child(node)
    }

    ; `tx.currentNamespace != nil && tx.currentScope != nil && tx.currentScope.Kind != KindBlock`
    function rs_in_namespace_body(this) returns bool
    {
        if current_namespace = null
            return false
        if current_scope = null
            return false
        AstNode.kind_of(current_scope) <> KindBlock
    }

    ; recordDeclarationInScope
    procedure record_declaration_in_scope(this, node: ref[AstNode])
    {
        let k node.kind
        if k = KindVariableStatement
        {
            let dl Printer.declaration_list_of(node)
            if dl <> null
                this.record_declaration_in_scope(dl as ref[AstNode])
            return
        }
        if k = KindVariableDeclarationList
        {
            this.record_declarations_in_scope(Printer.declarations_of(node))
            return
        }
        if (k = KindArrayBindingPattern) or (k = KindObjectBindingPattern)
        {
            this.record_declarations_in_scope(AstNode.elements_of(node))
            return
        }
        let name Printer.declaration_name_of(node)
        if name = null
            return
        let nm name as ref[AstNode]
        if nm.kind = KindIdentifier
        {
            if current_scope_first_declarations = null
                set this.current_scope_first_declarations: &Array[NameNode]^host()
            let table current_scope_first_declarations as ref[Array[NameNode]]
            let text AstNode.identifier_text_of(nm)
            if Transformer.first_declaration_of(table, text) = null
                table.add(NameNode(text, node))
            return
        }
        if AstNode.is_binding_pattern(nm)
            this.record_declaration_in_scope(nm)
    }

    procedure record_declarations_in_scope(this, list: ref[Array[ref[AstNode]?]]?)
    {
        if list = null
            return
        let l list as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (l.get_length() as int)
        {
            let d l[i as size_t]
            set i: i + 1
            if d <> null
                this.record_declaration_in_scope(d as ref[AstNode])
        }
    }

    function first_declaration_of(table: ref[Array[NameNode]], text: Slice[char]) returns ref[AstNode]?
    {
        var i 0
        while i < (table.get_length() as int)
        {
            let e table[i as size_t]
            set i: i + 1
            if e.name.equals(text)
                return e.node
        }
        null
    }

    ; isFirstDeclarationInScope
    function is_first_declaration_in_scope(this, node: ref[AstNode]) returns bool
    {
        let name Printer.declaration_name_of(node)
        if name = null
            return false
        let nm name as ref[AstNode]
        if nm.kind <> KindIdentifier
            return false
        if current_scope_first_declarations = null
            return false
        let first Transformer.first_declaration_of(current_scope_first_declarations as ref[Array[NameNode]], AstNode.identifier_text_of(nm))
        if first = null
            return false
        first = node
    }

    ; isExportOfNamespace
    function is_export_of_namespace(this, node: ref[AstNode]) returns bool
    {
        if current_namespace = null
            return false
        if current_scope <> null
        {
            if AstNode.kind_of(current_scope) = KindBlock
                return false
        }
        (Transformer.modifier_flags_of(node) & ModifierFlagsExport) <> 0
    }

    ; getExpressionForPropertyName: `"foo"` for the identifier `foo`
    procedure rs_expression_for_property_name(this, member: ref[AstNode]) returns ref[AstNode]?
    {
        let name Printer.declaration_name_of(member)
        if name = null
            return null
        let nm name as ref[AstNode]
        let k nm.kind
        if k = KindPrivateIdentifier
        {
            let empty: Slice[char] ""
            return factory.new_identifier(empty)
        }
        if k = KindComputedPropertyName
            return this.the_visitor().visit_node(AstNode.expression_of(nm))
        if k = KindIdentifier
            return factory.new_string_literal(AstNode.identifier_text_of(nm), TokenFlagsNone)
        if k = KindStringLiteral
            return factory.new_string_literal(AstNode.literal_text_of(nm), TokenFlagsNone)
        if k = KindNumericLiteral
            return factory.new_numeric_literal(AstNode.literal_text_of(nm), TokenFlagsNone)
        nm
    }

    ; getEnumQualifiedElement: `E["A"]`
    procedure rs_enum_qualified_element(this, enum_node: ref[AstNode], member: ref[AstNode]) returns ref[AstNode]
    {
        let prop this.rs_namespace_qualified_element(this.rs_namespace_container_name(enum_node), this.rs_expression_for_property_name(member))
        context.add_emit_flags(prop, EFNoComments | EFNoNestedComments | EFNoSourceMap | EFNoNestedSourceMaps)
        prop
    }

    ; getNamespaceContainerName
    procedure rs_namespace_container_name(this, node: ref[AstNode]) returns ref[AstNode]
        factory.new_generated_name_for_node(node)

    ; getNamespaceQualifiedProperty
    procedure rs_namespace_qualified_property(this, ns: ref[AstNode], name: ref[AstNode]) returns ref[AstNode]
        factory.get_namespace_member_name(ns, name, false, true)

    ; getNamespaceQualifiedElement
    procedure rs_namespace_qualified_element(this, ns: ref[AstNode], expression: ref[AstNode]?) returns ref[AstNode]
    {
        let qualified factory.new_element_access_expression(ns, null, expression, NodeFlagsNone)
        if expression <> null
            context.assign_comment_and_source_map_ranges(qualified, expression as ref[AstNode])
        qualified
    }

    ; getExportQualifiedReferenceToDeclaration
    procedure rs_export_qualified_reference_to_declaration(this, node: ref[AstNode]) returns ref[AstNode]
    {
        if this.is_export_of_namespace(node)
            return factory.get_external_module_or_namespace_export_name(this.rs_namespace_container_name(current_namespace as ref[AstNode]), node, false, true)
        factory.get_declaration_name_ex(node, false, true)
    }

    ; addVarForDeclaration: `var name;` once per scope, answered whether it was added
    procedure rs_add_var_for_declaration(this, statements: ref[Array[ref[AstNode]?]], node: ref[AstNode]) returns bool
    {
        this.record_declaration_in_scope(node)
        if this.is_first_declaration_in_scope(node) = false
            return false
        let name factory.get_local_name_ex(node, false, true, false)
        let var_decl factory.new_variable_declaration(name, null, null, null)
        var var_flags NodeFlagsNone
        if current_scope <> current_source_file
            set var_flags: NodeFlagsLet
        let decls &Array[ref[AstNode]?]^host()
        decls.add(var_decl)
        let var_decls factory.new_variable_declaration_list(decls, var_flags)
        ; Replicate modifierVisitor: strip decorators, TypeScript modifiers, and export when in namespace.
        var mask ModifierFlagsAll xor (ModifierFlagsTypeScriptModifier | ModifierFlagsDecorator)
        if current_namespace <> null
            set mask: mask & (ModifierFlagsAll xor ModifierFlagsExport)
        let modifiers Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), mask)
        let var_statement factory.new_variable_statement(modifiers, var_decls)
        context.set_original(var_decl, node)
        context.set_original(var_statement, node)
        ; Adjust the source map emit to match the old emitter.
        if node.kind = KindEnumDeclaration
            context.set_source_map_range(var_decls, TextRange.of_node(node))
        else
            context.set_source_map_range(var_statement, TextRange.of_node(node))
        ; Trailing comments for enum declaration should be emitted after the function closure
        ; instead of the variable statement
        context.set_comment_range(var_statement, TextRange.of_node(node))
        context.add_emit_flags(var_statement, EFNoTrailingComments)
        statements.add(var_statement)
        true
    }

    ; `(function (name) { ... })(name || (name = {}))` — the shape enum and
    ; module declarations share (visitEnumDeclaration / visitModuleDeclaration)
    procedure rs_visit_container_declaration(this, node: ref[AstNode], is_enum: bool) returns ref[AstNode]?
    {
        let statements &Array[ref[AstNode]?]^host()
        let var_added this.rs_add_var_for_declaration(statements, node)
        var emit_flags EFNone
        if var_added
        {
            if (opts.options.get_emit_module_kind() <> ModuleKindSystem) or (current_scope <> current_source_file)
                set emit_flags: emit_flags | EFNoLeadingComments
        }
        ;  x || (x = {})
        ;  exports.x || (exports.x = {})
        var arg factory.new_logical_or_expression(this.rs_export_qualified_reference_to_declaration(node), factory.new_assignment_expression(this.rs_export_qualified_reference_to_declaration(node), factory.new_object_literal_expression(&Array[ref[AstNode]?]^host(), false)))
        if this.is_export_of_namespace(node)
        {
            ;  x = (exports.x || (exports.x = {}))
            let local_name factory.get_local_name_ex(node, false, true, false)
            set arg: factory.new_assignment_expression(local_name, arg)
        }
        let param_name factory.new_generated_name_for_node(node)
        let name Printer.declaration_name_of(node)
        if name <> null
            context.set_source_map_range(param_name, TextRange.of_node(name as ref[AstNode]))
        let param factory.new_parameter_declaration(null, null, param_name, null, null, null)
        var body: ref[AstNode]? null
        if is_enum
            set body: this.rs_transform_enum_body(node)
        else
            set body: this.rs_transform_module_body(node, this.rs_namespace_container_name(node))
        let params &Array[ref[AstNode]?]^host()
        params.add(param)
        let func factory.new_function_expression(null, null, null, null, params, null, null, body)
        let args &Array[ref[AstNode]?]^host()
        args.add(arg)
        let call factory.new_call_expression(factory.new_parenthesized_expression(func), null, null, args, NodeFlagsNone)
        let statement factory.new_expression_statement(call)
        context.set_original(statement, node)
        context.assign_comment_and_source_map_ranges(statement, node)
        context.add_emit_flags(statement, emit_flags)
        statements.add(statement)
        factory.new_syntax_list(statements)
    }

    procedure rs_visit_enum_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if this.rs_should_emit_enum_declaration(node) = false
            return context.new_not_emitted_statement(node)
        this.rs_visit_container_declaration(node, true)
    }

    ; transformEnumBody
    procedure rs_transform_enum_body(this, node_in: ref[AstNode]) returns ref[AstNode]
    {
        let saved_enum current_enum
        set this.current_enum: node_in
        ; visit the children of `node` in advance to capture any references to enum members
        let node this.the_visitor().visit_each_child(node_in) as ref[AstNode]
        let statements &Array[ref[AstNode]?]^host()
        let members Printer.member_list_of(node)
        if members <> null
        {
            let ml members as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ml.get_length() as int)
            {
                this.rs_transform_enum_member(statements, node, i)
                set i: i + 1
            }
            var mp 0 - 1
            var me 0 - 1
            AstNode.list_range_of(current_source_file, members, &mp, &me)
            factory.set_list_range(statements, mp, me)
        }
        set this.current_enum: saved_enum
        factory.new_block(statements, true)
    }

    ; transformEnumMember: `E[E["A"] = 0] = "A";`
    procedure rs_transform_enum_member(this, statements: ref[Array[ref[AstNode]?]], enum_node: ref[AstNode], index: int)
    {
        let ml Printer.member_list_of(enum_node) as ref[Array[ref[AstNode]?]]
        let member ml[index as size_t] as ref[AstNode]
        let saved_parent parent_node
        set this.parent_node: current_node
        set this.current_node: member
        var expression AstNode.initializer_of(member)
        var use_explicit_reverse_mapping false
        let parse_node context.parse_node(member)
        let result this.the_checker().get_enum_member_value(parse_node)
        ; the reference's `result.Value` is a number, a string, or nil; here a
        ; String kind WITHOUT a buffer is the nil-but-syntactically-string case
        ; (Checker.eval_has_value)
        var has_value false
        if result.kind = EvalKindNumber
        {
            set expression: this.rs_constant_number_expression(result.bits)
            set use_explicit_reverse_mapping: true
            set has_value: true
        }
        if result.kind = EvalKindString
        {
            if Checker.eval_has_value(result)
            {
                set expression: factory.new_string_literal(result.text, TokenFlagsNone)
                set has_value: true
            }
        }
        if has_value = false
        {
            if expression = null
                set expression: factory.new_void_zero_expression()
            set use_explicit_reverse_mapping: result.is_syntactically_string = false
        }
        ;  E[E["A"] = 0] = "A";
        ;    ^^^^^^^^--_____
        set expression: factory.new_assignment_expression(this.rs_enum_qualified_element(enum_node, member), expression)
        if use_explicit_reverse_mapping
            set expression: factory.new_assignment_expression(factory.new_element_access_expression(this.rs_namespace_container_name(enum_node), null, expression, NodeFlagsNone), this.rs_expression_for_property_name(member))
        let member_statement factory.new_expression_statement(expression)
        context.assign_comment_and_source_map_ranges(expression as ref[AstNode], member)
        context.assign_comment_and_source_map_ranges(member_statement, member)
        statements.add(member_statement)
        set this.current_node: parent_node
        set this.parent_node: saved_parent
    }

    ; constantExpression for a jsnum value: the literal, `Infinity`, `NaN`, or
    ; a minus over the positive one
    procedure rs_constant_number_expression(this, bits: u64) returns ref[AstNode]
    {
        if jsnum_is_inf(bits)
        {
            let inf: Slice[char] "Infinity"
            if jsnum_double_of(bits) > 0.0
                return factory.new_identifier(inf)
            return factory.new_prefix_unary_expression(KindMinusToken, factory.new_identifier(inf))
        }
        if jsnum_is_nan(bits)
        {
            let nan: Slice[char] "NaN"
            return factory.new_identifier(nan)
        }
        if jsnum_double_of(bits) < 0.0
            return factory.new_prefix_unary_expression(KindMinusToken, this.rs_constant_number_expression(jsnum_negate_value(bits)))
        let buf allocate_slice[char](host, 64)
        let n jsnum_to_string(bits, buf)
        factory.new_numeric_literal(buf.subslice(0, n as size_t), TokenFlagsNone)
    }

    procedure rs_visit_module_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if this.rs_should_emit_module_declaration(node) = false
            return context.new_not_emitted_statement(node)
        this.rs_visit_container_declaration(node, false)
    }

    ; transformModuleBody
    procedure rs_transform_module_body(this, node_in: ref[AstNode], namespace_local_name: ref[AstNode]) returns ref[AstNode]
    {
        let saved_namespace current_namespace
        let saved_scope current_scope
        let saved_names current_scope_first_declarations
        set this.current_namespace: node_in
        set this.current_scope_first_declarations: null
        var statements: ref[Array[ref[AstNode]?]]? null
        context.start_variable_environment()
        var sp 0 - 1
        var se 0 - 1
        var bp 0 - 1
        var be 0 - 1
        let body_in Printer.module_body_of(node_in)
        if body_in <> null
        {
            if AstNode.kind_of(body_in) = KindModuleBlock
            {
                ; visit the children of `node` in advance to capture any references to namespace members
                let node this.the_visitor().visit_each_child(node_in) as ref[AstNode]
                let body Printer.module_body_of(node) as ref[AstNode]
                set statements: AstNode.statements_of(body)
                AstNode.list_range_of(current_source_file, statements, &sp, &se)
                set bp: body.pos
                set be: body.end
            }
            else
            {
                ; node.Body.Kind == KindModuleDeclaration
                let one &Array[ref[AstNode]?]^host()
                one.add(body_in)
                var changed false
                set statements: this.the_visitor().visit_slice(one, &changed)
                let inner Transformer.get_innermost_module_declaration_from_dotted_module(node_in)
                let inner_body Printer.module_body_of(inner)
                if inner_body <> null
                {
                    var ip 0 - 1
                    AstNode.list_range_of(current_source_file, AstNode.statements_of(inner_body as ref[AstNode]), &ip, &se)
                }
                set sp: 0 - 1
            }
        }
        set this.current_namespace: saved_namespace
        set this.current_scope: saved_scope
        set this.current_scope_first_declarations: saved_names
        set statements: context.end_and_merge_variable_environment(statements)
        let list &Array[ref[AstNode]?]^host()
        if statements <> null
        {
            let sl statements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (sl.get_length() as int)
            {
                list.add(sl[i as size_t])
                set i: i + 1
            }
        }
        factory.set_list_range(list, sp, se)
        let block factory.new_block(list, true)
        set block.pos: bp
        set block.end: be
        ; We only want to emit comment on the namespace which contains block body itself, not the containing namespaces.
        var no_comments true
        if body_in <> null
        {
            if AstNode.kind_of(body_in) = KindModuleBlock
                set no_comments: false
        }
        if no_comments
            context.add_emit_flags(block, EFNoComments)
        block
    }

    procedure rs_visit_import_equals_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let mr AstNode.module_reference_of(node) as ref[AstNode]
        if mr.kind = KindExternalModuleReference
            return this.the_visitor().visit_each_child(node)
        let module_reference factory.create_expression_from_entity_name(mr)
        context.set_emit_flags(module_reference, EFNoComments | EFNoNestedComments)
        let name Printer.declaration_name_of(node)
        if this.is_export_of_namespace(node) = false
        {
            ;  export var ${name} = ${moduleReference};
            ;  var ${name} = ${moduleReference};
            let var_decl factory.new_variable_declaration(name, null, null, module_reference)
            context.set_original(var_decl, node)
            let decls &Array[ref[AstNode]?]^host()
            decls.add(var_decl)
            let var_list factory.new_variable_declaration_list(decls, NodeFlagsNone)
            let var_modifiers Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsExport)
            let var_statement factory.new_variable_statement(var_modifiers, var_list)
            context.set_original(var_statement, node)
            context.assign_comment_and_source_map_ranges(var_statement, node)
            return var_statement
        }
        ; exports.${name} = ${moduleReference};
        let statement this.rs_create_export_statement(name as ref[AstNode], module_reference, TextRange.of_node(node), TextRange.of_node(node), node)
        set statement.pos: node.pos
        set statement.end: node.end
        statement
    }

    procedure rs_visit_variable_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if this.is_export_of_namespace(node) = false
            return v.visit_each_child(node)
        let expressions &Array[ref[AstNode]?]^host()
        let decls Printer.declarations_of(Printer.declaration_list_of(node) as ref[AstNode])
        if decls <> null
        {
            let dl decls as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (dl.get_length() as int)
            {
                let declaration dl[i as size_t] as ref[AstNode]
                set i: i + 1
                if AstNode.initializer_of(declaration) = null
                    continue
                if AstNode.is_binding_pattern(Printer.declaration_name_of(declaration))
                {
                    ; FlattenDestructuringAssignment (transformers/destructuring.go)
                    this.record_unported("transform-runtime-syntax-destructuring", 0)
                    return node
                }
                let expression Transformer.convert_variable_declaration_to_assignment_expression(context, declaration)
                if expression <> null
                    expressions.add(expression)
            }
        }
        if expressions.get_length() = 0
            return null
        let expression factory.inline_expressions(expressions)
        let statement factory.new_expression_statement(expression)
        context.set_original(statement, node)
        context.assign_comment_and_source_map_ranges(statement, node)
        ; re-visit as the new node
        let saved_current current_node
        set this.current_node: statement
        let visited v.visit_each_child(statement)
        set this.current_node: saved_current
        visited
    }

    ; transformers.ConvertVariableDeclarationToAssignmentExpression, for an
    ; IDENTIFIER name (the binding-pattern half is the destructuring chapter's)
    function convert_variable_declaration_to_assignment_expression(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]?
    {
        let initializer AstNode.initializer_of(element)
        if initializer = null
            return null
        let name Printer.declaration_name_of(element)
        let assignment ctx.the_factory().new_assignment_expression(name, initializer)
        ctx.set_original(assignment, element)
        ctx.assign_comment_and_source_map_ranges(assignment, element)
        assignment
    }

    procedure rs_visit_function_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if this.is_export_of_namespace(node) = false
            return v.visit_each_child(node)
        let updated factory.update_function_declaration(node, v.visit_modifiers(Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExport)), AstNode.asterisk_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        let export this.rs_create_export_statement_for_declaration(node)
        let pair &Array[ref[AstNode]?]^host()
        pair.add(updated)
        pair.add(export)
        factory.new_syntax_list(pair)
    }

    ; getParameterProperties
    procedure rs_parameter_properties(this, constructor: ref[AstNode]?) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        if constructor = null
            return out
        let c constructor as ref[AstNode]
        let params AstNode.parameters_of(c)
        if params = null
            return out
        let pl params as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (pl.get_length() as int)
        {
            let p pl[i as size_t]
            set i: i + 1
            if p = null
                continue
            if Transformer.is_parameter_property_declaration(p as ref[AstNode], c)
                out.add(p)
        }
        out
    }

    ; the property declarations a class gains for its parameter properties,
    ; prepended to the visited members (visitClassDeclaration / visitClassExpression)
    procedure rs_members_with_parameter_properties(this, node: ref[AstNode], members: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        let ctor Transformer.find_constructor(Printer.member_list_of(node))
        let parameter_properties this.rs_parameter_properties(ctor)
        if parameter_properties.get_length() = 0
            return members
        let new_members &Array[ref[AstNode]?]^host()
        var i 0
        while i < (parameter_properties.get_length() as int)
        {
            let parameter parameter_properties[i as size_t] as ref[AstNode]
            set i: i + 1
            let pname Printer.declaration_name_of(parameter)
            if AstNode.kind_of(pname) <> KindIdentifier
                continue
            let parameter_property factory.new_property_declaration(null, factory.clone(pname as ref[AstNode]), null, null, null)
            context.set_original(parameter_property, parameter)
            new_members.add(parameter_property)
        }
        if new_members.get_length() = 0
            return members
        if members <> null
        {
            let ml members as ref[Array[ref[AstNode]?]]
            var j 0
            while j < (ml.get_length() as int)
            {
                new_members.add(ml[j as size_t])
                set j: j + 1
            }
        }
        var mp 0 - 1
        var me 0 - 1
        AstNode.list_range_of(current_source_file, Printer.member_list_of(node), &mp, &me)
        factory.set_list_range(new_members, mp, me)
        new_members
    }

    function find_constructor(members: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        if members = null
            return null
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if AstNode.kind_of(m) = KindConstructor
                return m
        }
        null
    }

    procedure rs_visit_class_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let exported this.is_export_of_namespace(node)
        var modifiers: ref[Array[ref[AstNode]?]]? null
        if exported
            set modifiers: v.visit_modifiers(Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault))
        else
            set modifiers: v.visit_modifiers(Printer.modifier_list_of(node))
        var name v.visit_node(Printer.declaration_name_of(node))
        if name = null
        {
            if exported or this.the_checker().child_is_decorated(opts.options.experimental_decorators = TristateTrue, node, null)
                set name: factory.new_generated_name_for_node(node)
        }
        let heritage_clauses v.visit_nodes(AstNode.heritage_clauses_of(node))
        let members this.rs_members_with_parameter_properties(node, v.visit_nodes(Printer.member_list_of(node)))
        let updated factory.update_class_declaration(node, modifiers, name, null, heritage_clauses, members)
        if exported
        {
            let export this.rs_create_export_statement_for_declaration(node)
            let pair &Array[ref[AstNode]?]^host()
            pair.add(updated)
            pair.add(export)
            return factory.new_syntax_list(pair)
        }
        updated
    }

    procedure rs_visit_class_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let modifiers v.visit_modifiers(Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault))
        let name v.visit_node(Printer.declaration_name_of(node))
        let heritage_clauses v.visit_nodes(AstNode.heritage_clauses_of(node))
        let members this.rs_members_with_parameter_properties(node, v.visit_nodes(Printer.member_list_of(node)))
        factory.update_class_expression(node, modifiers, name, null, heritage_clauses, members)
    }

    procedure rs_visit_constructor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let modifiers v.visit_modifiers(Printer.modifier_list_of(node))
        let parameters context.visit_parameters(AstNode.parameters_of(node), v)
        let body this.rs_visit_constructor_body(AstNode.body_of(node), node)
        factory.update_constructor_declaration(node, modifiers, null, parameters, null, null, body)
    }

    ; visitConstructorBody: `constructor (public x) {}` → `constructor (x) { this.x = x; }`
    procedure rs_visit_constructor_body(this, body_in: ref[AstNode]?, constructor: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let parameter_properties this.rs_parameter_properties(constructor)
        if (parameter_properties.get_length() = 0) or (body_in = null)
            return context.visit_function_body(body_in, v)
        let body body_in as ref[AstNode]
        let grandparent_of_body this.push_node(body)
        var saved_scope: ref[AstNode]? null
        var saved_names: ref[Array[NameNode]]? null
        this.push_scope(body, &saved_scope, &saved_names)
        context.start_variable_environment()
        let source AstNode.statements_of(body) as ref[Array[ref[AstNode]?]]
        let prologue_end factory.split_standard_prologue(source)
        let statements &Array[ref[AstNode]?]^host()
        var i 0
        while i < prologue_end
        {
            statements.add(source[i as size_t])
            set i: i + 1
        }
        let rest &Array[ref[AstNode]?]^host()
        while i < (source.get_length() as int)
        {
            rest.add(source[i as size_t])
            set i: i + 1
        }
        let assignments &Array[ref[AstNode]?]^host()
        var p 0
        while p < (parameter_properties.get_length() as int)
        {
            let parameter parameter_properties[p as size_t] as ref[AstNode]
            set p: p + 1
            let pname Printer.declaration_name_of(parameter)
            if AstNode.kind_of(pname) <> KindIdentifier
                continue
            let nm pname as ref[AstNode]
            let property_name factory.clone(nm)
            set property_name.parent: nm.parent
            context.add_emit_flags(property_name, EFNoComments | EFNoSourceMap)
            let local_name factory.clone(nm)
            set local_name.parent: nm.parent
            context.add_emit_flags(local_name, EFNoComments)
            let assignment factory.new_expression_statement(factory.new_assignment_expression(factory.new_property_access_expression(factory.new_this_expression(), null, property_name, NodeFlagsNone), local_name))
            context.set_original(assignment, parameter)
            context.add_emit_flags(assignment, EFStartOnNewLine)
            assignments.add(assignment)
        }
        let super_path Transformer.find_super_statement_index_path(host, rest, 0)
        if super_path <> null
            this.rs_transform_constructor_body_worker(statements, rest, super_path as ref[Array[int]], 0, assignments)
        else
        {
            Transformer.add_all(statements, assignments)
            var changed false
            Transformer.add_all(statements, v.visit_slice(rest, &changed))
        }
        let merged context.end_and_merge_variable_environment(statements)
        let list &Array[ref[AstNode]?]^host()
        Transformer.add_all(list, merged)
        var sp 0 - 1
        var se 0 - 1
        AstNode.list_range_of(current_source_file, source, &sp, &se)
        factory.set_list_range(list, sp, se)
        this.pop_scope(saved_scope, saved_names)
        this.pop_node(grandparent_of_body)
        let updated factory.new_block(list, true)
        context.set_original(updated, body)
        set updated.pos: body.pos
        set updated.end: body.end
        updated
    }

    ; transformConstructorBodyWorker: the parameter-property assignments go right
    ; after the statement holding `super()`, into a `try` block if that is where it sits
    procedure rs_transform_constructor_body_worker(this, out: ref[Array[ref[AstNode]?]], statements_in: ref[Array[ref[AstNode]?]], super_path: ref[Array[int]], depth: int, initializers: ref[Array[ref[AstNode]?]])
    {
        let v this.the_visitor()
        let super_index super_path[depth as size_t]
        let super_statement statements_in[super_index as size_t] as ref[AstNode]
        var changed false
        ; visit up to the statement containing `super`
        Transformer.add_all(out, v.visit_slice(Transformer.sub_list(host, statements_in, 0, super_index), &changed))
        if super_statement.kind = KindTryStatement
        {
            let try_block AstNode.try_block_of(super_statement) as ref[AstNode]
            let grandparent_of_try this.push_node(super_statement)
            let grandparent_of_block this.push_node(try_block)
            var saved_scope: ref[AstNode]? null
            var saved_names: ref[Array[NameNode]]? null
            this.push_scope(try_block, &saved_scope, &saved_names)
            let try_statements &Array[ref[AstNode]?]^host()
            this.rs_transform_constructor_body_worker(try_statements, AstNode.statements_of(try_block) as ref[Array[ref[AstNode]?]], super_path, depth + 1, initializers)
            this.pop_scope(saved_scope, saved_names)
            this.pop_node(grandparent_of_block)
            var tp 0 - 1
            var te 0 - 1
            AstNode.list_range_of(current_source_file, AstNode.statements_of(try_block), &tp, &te)
            factory.set_list_range(try_statements, tp, te)
            out.add(factory.update_try_statement(super_statement, factory.update_block(try_block, try_statements, AstNode.multi_line_of(try_block)), v.visit_node(AstNode.catch_clause_of(super_statement)), v.visit_node(AstNode.finally_block_of(super_statement))))
            this.pop_node(grandparent_of_try)
        }
        else
        {
            ; visit the statement containing `super`, then insert the initializer statements
            Transformer.add_all(out, v.visit_slice(Transformer.sub_list(host, statements_in, super_index, super_index + 1), &changed))
            Transformer.add_all(out, initializers)
        }
        ; visit the statements after `super`
        Transformer.add_all(out, v.visit_slice(Transformer.sub_list(host, statements_in, super_index + 1, statements_in.get_length() as int), &changed))
    }

    function sub_list(host: ref[Page], list: ref[Array[ref[AstNode]?]], from: int, to: int) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        var i from
        while i < to
        {
            out.add(list[i as size_t])
            set i: i + 1
        }
        out
    }

    function add_all(out: ref[Array[ref[AstNode]?]], list: ref[Array[ref[AstNode]?]]?)
    {
        if list = null
            return
        let l list as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (l.get_length() as int)
        {
            out.add(l[i as size_t])
            set i: i + 1
        }
    }

    ; transformers.FindSuperStatementIndexPath: the indices, outermost first,
    ; to the statement holding the `super()` call (through `try` blocks); null
    ; when there is none
    function find_super_statement_index_path(host: ref[Page], statements: ref[Array[ref[AstNode]?]], start: int) returns ref[Array[int]]?
    {
        var i start
        while i < (statements.get_length() as int)
        {
            let statement statements[i as size_t]
            set i: i + 1
            if statement = null
                continue
            let s statement as ref[AstNode]
            if Transformer.get_super_call_from_statement(s) <> null
            {
                let path &Array[int]^host()
                path.add(i - 1)
                return path
            }
            if s.kind = KindTryStatement
            {
                let try_block AstNode.try_block_of(s)
                if try_block <> null
                {
                    let inner AstNode.statements_of(try_block as ref[AstNode])
                    if inner <> null
                    {
                        let rest Transformer.find_super_statement_index_path(host, inner as ref[Array[ref[AstNode]?]], 0)
                        if rest <> null
                        {
                            let path &Array[int]^host()
                            path.add(i - 1)
                            Transformer.add_all_ints(path, rest as ref[Array[int]])
                            return path
                        }
                    }
                }
            }
        }
        null
    }

    function add_all_ints(out: ref[Array[int]], list: ref[Array[int]])
    {
        var i 0
        while i < (list.get_length() as int)
        {
            out.add(list[i as size_t])
            set i: i + 1
        }
    }

    ; transformers.GetSuperCallFromStatement
    function get_super_call_from_statement(statement: ref[AstNode]) returns ref[AstNode]?
    {
        if statement.kind <> KindExpressionStatement
            return null
        let inner Printer.statement_expression_of(statement)
        if inner = null
            return null
        let e Checker.skip_parentheses(inner as ref[AstNode])
        if e.kind <> KindCallExpression
            return null
        if AstNode.kind_of(AstNode.expression_of(e)) = KindSuperKeyword
            return e
        null
    }

    procedure rs_visit_shorthand_property_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let name Printer.declaration_name_of(node) as ref[AstNode]
        let exported_or_imported_name this.rs_visit_expression_identifier(name)
        let oai AstNode.shorthand_object_assignment_initializer_of(node)
        if exported_or_imported_name <> name
        {
            var expression exported_or_imported_name
            if oai <> null
            {
                var equals_token AstNode.shorthand_equals_token_of(node)
                if equals_token = null
                    set equals_token: factory.new_token(KindEqualsToken)
                set expression: factory.new_binary_expression(null, expression, null, equals_token, v.visit_node(oai))
            }
            let updated factory.new_property_assignment(null, name, null, null, expression)
            set updated.pos: node.pos
            set updated.end: node.end
            context.set_original(updated, node)
            context.assign_comment_and_source_map_ranges(updated, node)
            return updated
        }
        factory.update_shorthand_property_assignment(node, null, exported_or_imported_name, null, null, AstNode.shorthand_equals_token_of(node), v.visit_node(oai))
    }

    procedure rs_visit_identifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if parent_node = null
            return node
        if Transformer.is_identifier_reference(node, parent_node as ref[AstNode])
            return this.rs_visit_expression_identifier(node)
        node
    }

    ; visitExpressionIdentifier: a reference to an export of the enclosing
    ; namespace or enum becomes `ns.name`
    procedure rs_visit_expression_identifier(this, node: ref[AstNode]) returns ref[AstNode]
    {
        if (current_enum = null) and (current_namespace = null)
            return node
        if context.has_auto_generate_info(node)
            return node
        if (context.emit_flags(node) & EFLocalName) <> 0
            return node
        let location context.most_original(node)
        if location = null
            return node
        let container this.the_checker().get_referenced_export_container(location as ref[AstNode], false)
        if container = null
            return node
        let c container as ref[AstNode]
        if (c.kind <> KindEnumDeclaration) and (c.kind <> KindModuleDeclaration)
            return node
        let container_name this.rs_namespace_container_name(c)
        let member_name factory.clone(node)
        context.set_emit_flags(member_name, EFNoComments | EFNoSourceMap)
        let expression factory.get_namespace_member_name(container_name, member_name, false, true)
        context.assign_comment_and_source_map_ranges(expression, node)
        expression
    }

    ; createExportStatementForDeclaration: `exports.x = x;` after the declaration
    procedure rs_create_export_statement_for_declaration(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let export_name factory.get_external_module_or_namespace_export_name(this.rs_namespace_container_name(current_namespace as ref[AstNode]), node, false, true)
        let local_name factory.get_local_name(node)
        let expression factory.new_assignment_expression(export_name, local_name)
        var range TextRange.of_node(node)
        let name Printer.declaration_name_of(node)
        if name <> null
            set range: TextRange((name as ref[AstNode]).pos, node.end)
        context.set_source_map_range(expression, range)
        let statement factory.new_expression_statement(expression)
        context.set_source_map_range(statement, TextRange(0 - 1, node.end))
        statement
    }

    procedure rs_create_export_assignment(this, name: ref[AstNode], expression: ref[AstNode], source_map_range: TextRange, original: ref[AstNode]) returns ref[AstNode]
    {
        let export_name this.rs_namespace_qualified_property(this.rs_namespace_container_name(current_namespace as ref[AstNode]), name)
        let export_assignment factory.new_assignment_expression(export_name, expression)
        context.set_original(export_assignment, original)
        context.set_source_map_range(export_assignment, source_map_range)
        export_assignment
    }

    procedure rs_create_export_statement(this, name: ref[AstNode], expression: ref[AstNode], assignment_range: TextRange, statement_range: TextRange, original: ref[AstNode]) returns ref[AstNode]
    {
        let export_statement factory.new_expression_statement(this.rs_create_export_assignment(name, expression, assignment_range, original))
        context.set_original(export_statement, original)
        context.set_source_map_range(export_statement, statement_range)
        export_statement
    }

    function rs_should_emit_enum_declaration(this, node: ref[AstNode]) returns bool
    {
        if this.the_checker().is_enum_const(node) = false
            return true
        opts.options.should_preserve_const_enums()
    }

    function rs_should_emit_module_declaration(this, node: ref[AstNode]) returns bool
    {
        let pn context.parse_node(node)
        if pn = null
            return true
        this.the_checker().is_instantiated_module(pn as ref[AstNode])
    }

    ; transformers.IsIdentifierReference: whether an identifier CHILD of `parent`
    ; is a reference (an expression) rather than a name
    function is_identifier_reference(name: ref[AstNode], parent: ref[AstNode]) returns bool
    {
        let k parent.kind
        if (k = KindBinaryExpression) or (k = KindPrefixUnaryExpression) or (k = KindPostfixUnaryExpression) or (k = KindYieldExpression) or (k = KindAsExpression) or (k = KindSatisfiesExpression) or (k = KindElementAccessExpression) or (k = KindNonNullExpression) or (k = KindSpreadElement) or (k = KindSpreadAssignment) or (k = KindParenthesizedExpression) or (k = KindArrayLiteralExpression) or (k = KindDeleteExpression) or (k = KindTypeOfExpression) or (k = KindVoidExpression) or (k = KindAwaitExpression) or (k = KindTypeAssertionExpression) or (k = KindExpressionWithTypeArguments) or (k = KindJsxSelfClosingElement) or (k = KindJsxSpreadAttribute) or (k = KindJsxExpression) or (k = KindPartiallyEmittedExpression)
            return true
        if (k = KindComputedPropertyName) or (k = KindDecorator) or (k = KindIfStatement) or (k = KindDoStatement) or (k = KindWhileStatement) or (k = KindWithStatement) or (k = KindReturnStatement) or (k = KindSwitchStatement) or (k = KindCaseClause) or (k = KindThrowStatement) or (k = KindExpressionStatement) or (k = KindExportAssignment) or (k = KindPropertyAccessExpression) or (k = KindTemplateSpan)
            return Transformer.expression_child_of(parent) = name
        if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindPropertyDeclaration) or (k = KindPropertySignature) or (k = KindPropertyAssignment) or (k = KindEnumMember) or (k = KindJsxAttribute)
            return AstNode.initializer_of(parent) = name
        if k = KindShorthandPropertyAssignment
            return AstNode.shorthand_object_assignment_initializer_of(parent) = name
        if k = KindForStatement
        {
            if AstNode.initializer_of(parent) = name
                return true
            if AstNode.for_condition_of(parent) = name
                return true
            return AstNode.for_incrementor_of(parent) = name
        }
        if (k = KindForInStatement) or (k = KindForOfStatement)
        {
            if AstNode.initializer_of(parent) = name
                return true
            return AstNode.expression_of(parent) = name
        }
        if k = KindImportEqualsDeclaration
            return AstNode.module_reference_of(parent) = name
        if k = KindArrowFunction
            return AstNode.body_of(parent) = name
        if k = KindConditionalExpression
        {
            if AstNode.conditional_condition_of(parent) = name
                return true
            if AstNode.conditional_when_true_of(parent) = name
                return true
            return AstNode.conditional_when_false_of(parent) = name
        }
        if (k = KindCallExpression) or (k = KindNewExpression)
        {
            if AstNode.expression_of(parent) = name
                return true
            return Transformer.list_contains(AstNode.call_arguments_of(parent), name)
        }
        if k = KindTaggedTemplateExpression
            return AstNode.tagged_template_tag_of(parent) = name
        if k = KindImportAttribute
            return AstNode.import_attribute_value_of(parent) = name
        if (k = KindJsxOpeningElement) or (k = KindJsxClosingElement)
            return AstNode.jsx_tag_name_of(parent) = name
        false
    }

    ; the reference's Node.Expression() for the parents IsIdentifierReference asks
    function expression_child_of(parent: ref[AstNode]) returns ref[AstNode]?
    {
        let k parent.kind
        if k = KindPropertyAccessExpression
            return AstNode.property_access_expression_of(parent)
        if (k = KindComputedPropertyName) or (k = KindDecorator)
            return Printer.wrapped_inner_of(parent)
        if (k = KindExpressionStatement) or (k = KindThrowStatement) or (k = KindReturnStatement)
            return Printer.statement_expression_of(parent)
        if k = KindExportAssignment
            return Checker.export_assignment_expression_of(parent)
        if k = KindTemplateSpan
            return AstNode.expression_of(parent)
        ; if / do / while / with / switch / case clause
        AstNode.expression_of(parent)
    }

    function list_contains(list: ref[Array[ref[AstNode]?]]?, n: ref[AstNode]) returns bool
    {
        if list = null
            return false
        let l list as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (l.get_length() as int)
        {
            if l[i as size_t] = n
                return true
            set i: i + 1
        }
        false
    }

    ; ═══ inliners/constenum.go (slice 238) ═══
    ;
    ; A property or element access that the checker knows as a const enum
    ; member becomes its value, with the original text as a trailing `/* */`
    ; comment unless comments are removed.
    procedure visit_const_enum_inlining(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let k node.kind
        if (k <> KindPropertyAccessExpression) and (k <> KindElementAccessExpression)
            return v.visit_each_child(node)
        let parse context.parse_node(node)
        if parse = null
            return v.visit_each_child(node)
        let value this.the_checker().get_constant_value(parse as ref[AstNode])
        if value.kind = EvalKindNone
            return v.visit_each_child(node)
        var replacement: ref[AstNode]? null
        if value.kind = EvalKindNumber
            set replacement: this.rs_constant_number_expression(value.bits)
        if value.kind = EvalKindString
            set replacement: factory.new_string_literal(value.text, TokenFlagsNone)
        if replacement = null
            return v.visit_each_child(node)
        let r replacement as ref[AstNode]
        if opts.options.remove_comments = false
        {
            let original context.most_original(node)
            if original <> null
            {
                let o original as ref[AstNode]
                if Printer.node_is_synthesized(o) = false
                {
                    let original_text Printer.get_text_of_node_from_source_text(host, opts.file_info.text, o, false)
                    context.add_synthetic_trailing_comment(r, KindMultiLineCommentTrivia, Transformer.safe_multi_line_comment(host, original_text), false)
                }
            }
        }
        r
    }

    ; safeMultiLineComment: ` text ` with every `*/` inside spelled `*_/`
    function safe_multi_line_comment(host: ref[Page], text: Slice[char]) returns Slice[char]
    {
        let b StringBuilder^host()
        b.append(" " as char)
        var i 0
        while i < text.length
        {
            let c text[i]
            if (c = ("*" as char)) and (i + 1 < text.length)
            {
                if text[i + 1] = ("/" as char)
                {
                    b.append("*_/")
                    set i: i + 2
                    continue
                }
            }
            b.append(c)
            set i: i + 1
        }
        b.append(" " as char)
        Printer.slice_on(host, b.to_string())
    }

    ; ═══ estransforms/using.go (slice 239) ═══
    ;
    ; `using` / `await using` declarations into the `env` record, the
    ; `__addDisposableResource` calls and the try/catch/finally that disposes;
    ; the top-level statements after the first `using` move into the `try`,
    ; imports, exports, functions and classes hoisted out of it.

    procedure visit_using(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsUsing) = 0
            return node
        let k node.kind
        if k = KindSourceFile
            return this.us_visit_source_file(node)
        if k = KindBlock
            return this.us_visit_block(node)
        if k = KindForStatement
            return this.us_visit_for_statement(node)
        if k = KindForOfStatement
            return this.us_visit_for_of_statement(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure us_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.file_info.is_declaration_file
            return node
        let v this.the_visitor()
        var visited: ref[AstNode]? null
        let statements AstNode.statements_of(node) as ref[Array[ref[AstNode]?]]
        let using_kind Transformer.get_using_kind_of_statements(statements)
        if using_kind <> UsingKindNone
        {
            context.start_variable_environment()
            set this.export_bindings: &Array[NameNode]^host()
            set this.export_vars: null
            let prologue_end factory.split_standard_prologue(statements)
            let top_level &Array[ref[AstNode]?]^host()
            var changed false
            Transformer.add_all(top_level, v.visit_slice(Transformer.sub_list(host, statements, 0, prologue_end), &changed))
            ; Collect and transform any leading statements up to the first `using` or `await using`.
            let rest Transformer.sub_list(host, statements, prologue_end, statements.get_length() as int)
            var pos 0
            while pos < (rest.get_length() as int)
            {
                let statement rest[pos as size_t]
                if Transformer.get_using_kind(statement) <> UsingKindNone
                {
                    if pos > 0
                        Transformer.add_all(top_level, v.visit_slice(Transformer.sub_list(host, rest, 0, pos), &changed))
                    break
                }
                set pos: pos + 1
            }
            ; transform the rest of the body
            let env_binding this.us_create_env_binding()
            let body_statements this.us_transform_using_declarations(Transformer.sub_list(host, rest, pos, rest.get_length() as int), env_binding, top_level)
            ; add `export {}` declarations for any hoisted bindings.
            let bindings export_bindings as ref[Array[NameNode]]
            if bindings.get_length() > 0
            {
                let specifiers &Array[ref[AstNode]?]^host()
                var i 0
                while i < (bindings.get_length() as int)
                {
                    let binding bindings[i as size_t]
                    specifiers.add(binding.node)
                    set i: i + 1
                }
                top_level.add(factory.new_export_declaration(null, false, factory.new_named_exports(specifiers), null, null))
            }
            Transformer.add_all(top_level, context.end_variable_environment())
            if export_vars <> null
            {
                let modifiers &Array[ref[AstNode]?]^host()
                modifiers.add(factory.new_token(KindExportKeyword))
                top_level.add(factory.new_variable_statement(modifiers, factory.new_variable_declaration_list(export_vars, NodeFlagsLet)))
            }
            Transformer.add_all(top_level, this.us_create_downlevel_using_statements(body_statements, env_binding, using_kind = UsingKindAsync))
            if export_equals_binding <> null
                top_level.add(factory.new_export_assignment(null, true, null, export_equals_binding))
            set visited: factory.update_source_file(node, top_level, AstNode.end_of_file_token_of(node))
        }
        else
            set visited: v.visit_each_child(node)
        let result visited as ref[AstNode]
        let helpers context.read_emit_helpers()
        var h 0
        while h < (helpers.get_length() as int)
        {
            let helper helpers[h as size_t]
            if helper <> null
                context.add_emit_helper(result, helper as ref[EmitHelper])
            set h: h + 1
        }
        set this.export_vars: null
        set this.export_bindings: null
        set this.default_export_binding: null
        set this.export_equals_binding: null
        result
    }

    procedure us_visit_block(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let statements AstNode.statements_of(node) as ref[Array[ref[AstNode]?]]
        let using_kind Transformer.get_using_kind_of_statements(statements)
        if using_kind = UsingKindNone
            return v.visit_each_child(node)
        let prologue_end factory.split_standard_prologue(statements)
        let env_binding this.us_create_env_binding()
        let out &Array[ref[AstNode]?]^host()
        var changed false
        Transformer.add_all(out, v.visit_slice(Transformer.sub_list(host, statements, 0, prologue_end), &changed))
        let rest Transformer.sub_list(host, statements, prologue_end, statements.get_length() as int)
        Transformer.add_all(out, this.us_create_downlevel_using_statements(this.us_transform_using_declarations(rest, env_binding, null), env_binding, using_kind = UsingKindAsync))
        var sp 0 - 1
        var se 0 - 1
        AstNode.list_range_of(current_source_file, statements, &sp, &se)
        factory.set_list_range(out, sp, se)
        factory.update_block(node, out, AstNode.multi_line_of(node))
    }

    ; `for (using x = expr; cond; incr) { ... }` → `{ using x = expr; for (; cond; incr) { ... } }`
    procedure us_visit_for_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let initializer AstNode.initializer_of(node)
        if initializer = null
            return v.visit_each_child(node)
        if Transformer.is_using_variable_declaration_list(initializer as ref[AstNode]) = false
            return v.visit_each_child(node)
        let statements &Array[ref[AstNode]?]^host()
        statements.add(factory.new_variable_statement(null, initializer))
        statements.add(factory.update_for_statement(node, null, AstNode.for_condition_of(node), AstNode.for_incrementor_of(node), Printer.statement_body_of(node)))
        v.visit_node(factory.new_block(statements, false))
    }

    ; `for (using x of y) { ... }` → `for (const x_1 of y) { using x = x_1; ... }`
    procedure us_visit_for_of_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let initializer AstNode.initializer_of(node)
        if initializer = null
            return v.visit_each_child(node)
        let init_node initializer as ref[AstNode]
        if Transformer.is_using_variable_declaration_list(init_node) = false
            return v.visit_each_child(node)
        let decls Printer.declarations_of(init_node)
        var for_decl: ref[AstNode]? null
        if decls <> null
        {
            let dl decls as ref[Array[ref[AstNode]?]]
            if dl.get_length() > 0
                set for_decl: dl[0]
        }
        if for_decl = null
            set for_decl: factory.new_variable_declaration(factory.new_temp_variable(), null, null, null)
        let fd for_decl as ref[AstNode]
        let is_await_using Transformer.get_using_kind_of_variable_declaration_list(init_node) = UsingKindAsync
        let fd_name Printer.declaration_name_of(fd) as ref[AstNode]
        let temp factory.new_generated_name_for_node(fd_name)
        let using_var factory.update_variable_declaration(fd, fd_name, null, null, temp)
        let one &Array[ref[AstNode]?]^host()
        one.add(using_var)
        var flags NodeFlagsUsing
        if is_await_using
            set flags: NodeFlagsAwaitUsing
        let using_var_statement factory.new_variable_statement(null, factory.new_variable_declaration_list(one, flags))
        let body Printer.statement_body_of(node) as ref[AstNode]
        var statement: ref[AstNode]? null
        if body.kind = KindBlock
        {
            let inner &Array[ref[AstNode]?]^host()
            inner.add(using_var_statement)
            Transformer.add_all(inner, AstNode.statements_of(body))
            set statement: factory.update_block(body, inner, AstNode.multi_line_of(body))
        }
        else
        {
            let inner &Array[ref[AstNode]?]^host()
            inner.add(using_var_statement)
            inner.add(body)
            set statement: factory.new_block(inner, true)
        }
        let temp_decls &Array[ref[AstNode]?]^host()
        temp_decls.add(factory.new_variable_declaration(temp, null, null, null))
        v.visit_node(factory.update_for_in_or_of_statement(node, AstNode.for_await_modifier_of(node), factory.new_variable_declaration_list(temp_decls, NodeFlagsConst), AstNode.expression_of(node), statement))
    }

    ; transformUsingDeclarations: the body statements, each `using` replaced by
    ; `const x = __addDisposableResource(env, init_node, async)`, the rest visited and
    ; — at the top level — hoisted
    procedure us_transform_using_declarations(this, statements_in: ref[Array[ref[AstNode]?]], env_binding: ref[AstNode], top_level: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]
    {
        let v this.the_visitor()
        let statements &Array[ref[AstNode]?]^host()
        var i 0
        while i < (statements_in.get_length() as int)
        {
            let statement statements_in[i as size_t]
            set i: i + 1
            if statement = null
                continue
            let s statement as ref[AstNode]
            let using_kind Transformer.get_using_kind(s)
            if using_kind <> UsingKindNone
            {
                let declaration_list Printer.declaration_list_of(s) as ref[AstNode]
                let declarations &Array[ref[AstNode]?]^host()
                var valid true
                let dl Printer.declarations_of(declaration_list)
                if dl <> null
                {
                    let list dl as ref[Array[ref[AstNode]?]]
                    var d 0
                    while d < (list.get_length() as int)
                    {
                        var declaration list[d as size_t] as ref[AstNode]
                        set d: d + 1
                        if AstNode.kind_of(Printer.declaration_name_of(declaration)) <> KindIdentifier
                        {
                            ; Since binding patterns are a grammar error, we reset `declarations` so we don't process this as a `using`.
                            set valid: false
                            break
                        }
                        ; perform a shallow transform for any named evaluation
                        if Transformer.is_named_evaluation(context, declaration)
                        {
                            let empty: Slice[char] ""
                            set declaration: Transformer.transform_named_evaluation(context, declaration, false, empty)
                        }
                        var initializer v.visit_node(AstNode.initializer_of(declaration))
                        if initializer = null
                            set initializer: factory.new_void_zero_expression()
                        declarations.add(factory.update_variable_declaration(declaration, Printer.declaration_name_of(declaration), null, null, factory.new_add_disposable_resource_helper(env_binding, initializer as ref[AstNode], using_kind = UsingKindAsync)))
                    }
                }
                ; Only replace the statement if it was valid.
                if valid and (declarations.get_length() > 0)
                {
                    let var_list factory.new_variable_declaration_list(declarations, NodeFlagsConst)
                    context.set_original(var_list, declaration_list)
                    set var_list.pos: declaration_list.pos
                    set var_list.end: declaration_list.end
                    this.us_hoist_or_append(statements, factory.update_variable_statement(s, null, var_list), top_level)
                    continue
                }
            }
            let result this.visit_using(s)
            if result = null
                continue
            let r result as ref[AstNode]
            if r.kind = KindSyntaxList
            {
                let children AstNode.elements_of(r)
                if children <> null
                {
                    let cl children as ref[Array[ref[AstNode]?]]
                    var c 0
                    while c < (cl.get_length() as int)
                    {
                        let child cl[c as size_t]
                        set c: c + 1
                        if child <> null
                            this.us_hoist_or_append(statements, child as ref[AstNode], top_level)
                    }
                }
            }
            else
                this.us_hoist_or_append(statements, r, top_level)
        }
        statements
    }

    ; hoistOrAppendNode: `hoist` answers the statement that stays in the body
    ; (or null), the top-level ones go out through `top_level`
    procedure us_hoist_or_append(this, statements: ref[Array[ref[AstNode]?]], node: ref[AstNode], top_level: ref[Array[ref[AstNode]?]]?)
    {
        var kept: ref[AstNode]? node
        if top_level <> null
        {
            let tl top_level as ref[Array[ref[AstNode]?]]
            let k node.kind
            if (k = KindImportDeclaration) or (k = KindImportEqualsDeclaration) or (k = KindExportDeclaration) or (k = KindFunctionDeclaration)
            {
                ; NOTE: `node` has already been visited
                tl.add(node)
                set kept: null
            }
            if k = KindExportAssignment
                set kept: this.us_hoist_export_assignment(node)
            if k = KindClassDeclaration
                set kept: this.us_hoist_class_declaration(node)
            if k = KindVariableStatement
                set kept: this.us_hoist_variable_statement(node)
        }
        if kept <> null
            statements.add(kept)
    }

    procedure us_hoist_export_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if AstNode.is_export_equals_of(node)
            return this.us_hoist_export_equals(node)
        this.us_hoist_export_default(node)
    }

    ; `export default expr;` → `var default_1; export { default_1 as default };` up top, `default_1 = expr;` in the body
    procedure us_hoist_export_default(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if default_export_binding <> null
            return node
        let default_text: Slice[char] "_default"
        let empty: Slice[char] ""
        set this.default_export_binding: factory.new_unique_name_ex(default_text, GeneratedIdentifierFlagsReservedInNestedScopes | GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic, empty, empty)
        let default_name: Slice[char] "default"
        this.us_hoist_binding_identifier(default_export_binding as ref[AstNode], true, factory.new_identifier(default_name), node)
        ; give a class or function expression an assigned name, if needed.
        var expression Checker.export_assignment_expression_of(node) as ref[AstNode]
        var inner Parser.skip_outer_expressions(expression, OEKAll) as ref[AstNode]
        if Transformer.is_named_evaluation(context, inner)
        {
            set inner: Transformer.transform_named_evaluation(context, inner, false, default_name)
            set expression: factory.restore_outer_expressions(expression, inner, OEKAll) as ref[AstNode]
        }
        factory.new_expression_statement(factory.new_assignment_expression(default_export_binding, expression))
    }

    ; `export = expr;` → `var default_1;` up top, `default_1 = expr;` in the body, `export = default_1;` after
    procedure us_hoist_export_equals(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if export_equals_binding <> null
            return node
        let default_text: Slice[char] "_default"
        let empty: Slice[char] ""
        set this.export_equals_binding: factory.new_unique_name_ex(default_text, GeneratedIdentifierFlagsReservedInNestedScopes | GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic, empty, empty)
        context.add_variable_declaration(export_equals_binding as ref[AstNode])
        factory.new_expression_statement(factory.new_assignment_expression(export_equals_binding, Checker.export_assignment_expression_of(node)))
    }

    ; a class declaration at the top level of a file with a top-level `using`
    ; becomes `C = class {}` in the body, its binding hoisted
    procedure us_hoist_class_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let name Printer.declaration_name_of(node)
        if (name = null) and (default_export_binding <> null)
            return node
        let is_exported Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        let is_default Transformer.has_syntactic_modifier(node, ModifierFlagsDefault)
        var expression this.convert_class_declaration_to_class_expression(node)
        let empty: Slice[char] ""
        if name <> null
        {
            this.us_hoist_binding_identifier(factory.get_local_name(node), is_exported and (is_default = false), null, node)
            set expression: factory.new_assignment_expression(factory.get_declaration_name(node), expression)
            context.set_original(expression, node)
            context.set_source_map_range(expression, TextRange.of_node(node))
            context.set_comment_range(expression, TextRange.of_node(node))
            if Transformer.is_named_evaluation(context, expression)
                set expression: Transformer.transform_named_evaluation(context, expression, false, empty)
        }
        if is_default and (default_export_binding = null)
        {
            let default_text: Slice[char] "_default"
            set this.default_export_binding: factory.new_unique_name_ex(default_text, GeneratedIdentifierFlagsReservedInNestedScopes | GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic, empty, empty)
            let default_name: Slice[char] "default"
            this.us_hoist_binding_identifier(default_export_binding as ref[AstNode], true, factory.new_identifier(default_name), node)
            set expression: factory.new_assignment_expression(default_export_binding, expression)
            context.set_original(expression, node)
            if Transformer.is_named_evaluation(context, expression)
                set expression: Transformer.transform_named_evaluation(context, expression, false, default_name)
        }
        factory.new_expression_statement(expression)
    }

    procedure us_hoist_variable_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expressions &Array[ref[AstNode]?]^host()
        let is_exported Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        let dl Printer.declarations_of(Printer.declaration_list_of(node) as ref[AstNode])
        if dl <> null
        {
            let list dl as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (list.get_length() as int)
            {
                let variable list[i as size_t] as ref[AstNode]
                set i: i + 1
                this.us_hoist_binding_element(variable, is_exported, variable)
                if AstNode.initializer_of(variable) <> null
                    expressions.add(this.us_hoist_initialized_variable(variable))
            }
        }
        if expressions.get_length() = 0
            return null
        let statement factory.new_expression_statement(factory.inline_expressions(expressions))
        context.set_original(statement, node)
        context.set_comment_range(statement, TextRange.of_node(node))
        context.set_source_map_range(statement, TextRange.of_node(node))
        statement
    }

    procedure us_hoist_initialized_variable(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let name Printer.declaration_name_of(node) as ref[AstNode]
        var target: ref[AstNode]? null
        if name.kind = KindIdentifier
        {
            let t factory.clone(name)
            context.set_emit_flags(t, context.emit_flags(t) & (SubtreeFactsAllBits xor (EFLocalName | EFExportName)))
            set target: t
        }
        else
            set target: Transformer.convert_binding_pattern_to_assignment_pattern(context, name)
        let assignment factory.new_assignment_expression(target, AstNode.initializer_of(node))
        context.set_original(assignment, node)
        context.set_comment_range(assignment, TextRange.of_node(node))
        context.set_source_map_range(assignment, TextRange.of_node(node))
        assignment
    }

    procedure us_hoist_binding_element(this, node: ref[AstNode], is_exported_declaration: bool, original: ref[AstNode])
    {
        let name Printer.declaration_name_of(node)
        if name = null
            return
        let nm name as ref[AstNode]
        if AstNode.is_binding_pattern(nm)
        {
            let elements AstNode.elements_of(nm)
            if elements = null
                return
            let el elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (el.get_length() as int)
            {
                let element el[i as size_t]
                set i: i + 1
                if element = null
                    continue
                if Printer.declaration_name_of(element as ref[AstNode]) <> null
                    this.us_hoist_binding_element(element as ref[AstNode], is_exported_declaration, original)
            }
            return
        }
        this.us_hoist_binding_identifier(nm, is_exported_declaration, null, original)
    }

    procedure us_hoist_binding_identifier(this, node: ref[AstNode], is_export: bool, export_alias: ref[AstNode]?, original: ref[AstNode]?)
    {
        var name node
        if context.has_auto_generate_info(node) = false
            set name: factory.clone(node)
        if is_export
        {
            if (export_alias = null) and ((context.emit_flags(name) & EFLocalName) = 0)
            {
                let var_decl factory.new_variable_declaration(name, null, null, null)
                if original <> null
                    context.set_original(var_decl, original as ref[AstNode])
                if export_vars = null
                    set this.export_vars: &Array[ref[AstNode]?]^host()
                (export_vars as ref[Array[ref[AstNode]?]]).add(var_decl)
                return
            }
            var local_name: ref[AstNode]? null
            var export_name: ref[AstNode]? name
            if export_alias <> null
            {
                set local_name: name
                set export_name: export_alias
            }
            let specifier factory.new_export_specifier(false, local_name, export_name)
            if original <> null
                context.set_original(specifier, original as ref[AstNode])
            if export_bindings = null
                set this.export_bindings: &Array[NameNode]^host()
            let table export_bindings as ref[Array[NameNode]]
            let text AstNode.identifier_text_of(name)
            var found false
            var i 0
            while i < (table.get_length() as int)
            {
                let entry table[i as size_t]
                if entry.name.equals(text)
                {
                    table.put(i as size_t, NameNode(text, specifier))
                    set found: true
                }
                set i: i + 1
            }
            if found = false
                table.add(NameNode(text, specifier))
        }
        context.add_variable_declaration(name)
    }

    procedure us_create_env_binding(this) returns ref[AstNode]
    {
        let env: Slice[char] "env"
        factory.new_unique_name(env)
    }

    ; createDownlevelUsingStatements: the `env` record and the try/catch/finally
    procedure us_create_downlevel_using_statements(this, body_statements: ref[Array[ref[AstNode]?]], env_binding: ref[AstNode], async: bool) returns ref[Array[ref[AstNode]?]]
    {
        let statements &Array[ref[AstNode]?]^host()
        ;  const env_1 = { stack: [], error: void 0, hasError: false };
        let stack_name: Slice[char] "stack"
        let error_name: Slice[char] "error"
        let has_error_name: Slice[char] "hasError"
        let props &Array[ref[AstNode]?]^host()
        let empty_stack &Array[ref[AstNode]?]^host()
        props.add(factory.new_property_assignment(null, factory.new_identifier(stack_name), null, null, factory.new_array_literal_expression(empty_stack, false)))
        props.add(factory.new_property_assignment(null, factory.new_identifier(error_name), null, null, factory.new_void_zero_expression()))
        props.add(factory.new_property_assignment(null, factory.new_identifier(has_error_name), null, null, factory.new_false_expression()))
        let env_object factory.new_object_literal_expression(props, false)
        let env_decls &Array[ref[AstNode]?]^host()
        env_decls.add(factory.new_variable_declaration(env_binding, null, null, env_object))
        statements.add(factory.new_variable_statement(null, factory.new_variable_declaration_list(env_decls, NodeFlagsConst)))
        ;  try { <body> } catch (e_1) { env_1.error = e_1; env_1.hasError = true; } finally { __disposeResources(env_1); }
        let try_block factory.new_block(body_statements, true)
        let e_name: Slice[char] "e"
        let body_catch_binding factory.new_unique_name(e_name)
        let catch_statements &Array[ref[AstNode]?]^host()
        catch_statements.add(factory.new_expression_statement(factory.new_assignment_expression(factory.new_property_access_expression(env_binding, null, factory.new_identifier(error_name), NodeFlagsNone), body_catch_binding)))
        catch_statements.add(factory.new_expression_statement(factory.new_assignment_expression(factory.new_property_access_expression(env_binding, null, factory.new_identifier(has_error_name), NodeFlagsNone), factory.new_true_expression())))
        let catch_clause factory.new_catch_clause(factory.new_variable_declaration(body_catch_binding, null, null, null), factory.new_block(catch_statements, true))
        let finally_statements &Array[ref[AstNode]?]^host()
        if async
        {
            let result_name: Slice[char] "result"
            let result factory.new_unique_name(result_name)
            let result_decls &Array[ref[AstNode]?]^host()
            result_decls.add(factory.new_variable_declaration(result, null, null, factory.new_dispose_resources_helper(env_binding)))
            finally_statements.add(factory.new_variable_statement(null, factory.new_variable_declaration_list(result_decls, NodeFlagsConst)))
            finally_statements.add(factory.new_if_statement(result, factory.new_expression_statement(factory.new_await_expression(result)), null))
        }
        else
            finally_statements.add(factory.new_expression_statement(factory.new_dispose_resources_helper(env_binding)))
        let finally_block factory.new_block(finally_statements, true)
        statements.add(factory.new_try_statement(try_block, catch_clause, finally_block))
        statements
    }

    function is_using_variable_declaration_list(node: ref[AstNode]) returns bool
    {
        if node.kind <> KindVariableDeclarationList
            return false
        Transformer.get_using_kind_of_variable_declaration_list(node) <> UsingKindNone
    }

    function get_using_kind_of_variable_declaration_list(node: ref[AstNode]) returns int
    {
        let scoped node.flags & NodeFlagsBlockScoped
        if scoped = NodeFlagsAwaitUsing
            return UsingKindAsync
        if scoped = NodeFlagsUsing
            return UsingKindSync
        UsingKindNone
    }

    function get_using_kind(statement: ref[AstNode]?) returns int
    {
        if AstNode.kind_of(statement) <> KindVariableStatement
            return UsingKindNone
        let dl Printer.declaration_list_of(statement as ref[AstNode])
        if dl = null
            return UsingKindNone
        Transformer.get_using_kind_of_variable_declaration_list(dl as ref[AstNode])
    }

    function get_using_kind_of_statements(statements: ref[Array[ref[AstNode]?]]) returns int
    {
        var result UsingKindNone
        var i 0
        while i < (statements.get_length() as int)
        {
            let k Transformer.get_using_kind(statements[i as size_t])
            set i: i + 1
            if k = UsingKindAsync
                return UsingKindAsync
            if k > result
                set result: k
        }
        result
    }

    ; ═══ estransforms/utilities.go convertClassDeclarationToClassExpression ═══
    procedure convert_class_declaration_to_class_expression(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let updated factory.new_class_expression(Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault), Printer.declaration_name_of(node), AstNode.type_parameters_of(node), AstNode.heritage_clauses_of(node), Printer.member_list_of(node))
        context.set_original(updated, node)
        set updated.pos: node.pos
        set updated.end: node.end
        updated
    }

    ; ═══ transformers/utilities.go ConvertBindingPatternToAssignmentPattern ═══
    function convert_binding_pattern_to_assignment_pattern(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        if element.kind = KindArrayBindingPattern
            return Transformer.convert_binding_element_to_array_assignment_pattern(ctx, element)
        Transformer.convert_binding_element_to_object_assignment_pattern(ctx, element)
    }

    function convert_binding_element_to_object_assignment_pattern(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let h ctx.host
        let properties &Array[ref[AstNode]?]^h()
        let elements AstNode.elements_of(element)
        if elements <> null
        {
            let el elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (el.get_length() as int)
            {
                let e el[i as size_t]
                set i: i + 1
                if e <> null
                    properties.add(Transformer.convert_binding_element_to_object_assignment_element(ctx, e as ref[AstNode]))
            }
        }
        var ep 0 - 1
        var ee 0 - 1
        AstNode.list_range_of(Checker.source_file_of_node(element), elements, &ep, &ee)
        f.set_list_range(properties, ep, ee)
        let object f.new_object_literal_expression(properties, false)
        ctx.set_original(object, element)
        ctx.assign_comment_and_source_map_ranges(object, element)
        object
    }

    function convert_binding_element_to_array_assignment_pattern(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let h ctx.host
        let out &Array[ref[AstNode]?]^h()
        let elements AstNode.elements_of(element)
        if elements <> null
        {
            let el elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (el.get_length() as int)
            {
                let e el[i as size_t]
                set i: i + 1
                if e <> null
                    out.add(Transformer.convert_binding_element_to_array_assignment_element(ctx, e as ref[AstNode]))
            }
        }
        var ep 0 - 1
        var ee 0 - 1
        AstNode.list_range_of(Checker.source_file_of_node(element), elements, &ep, &ee)
        f.set_list_range(out, ep, ee)
        let array f.new_array_literal_expression(out, false)
        ctx.set_original(array, element)
        ctx.assign_comment_and_source_map_ranges(array, element)
        array
    }

    function convert_binding_element_to_array_assignment_element(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let name Printer.declaration_name_of(element)
        if name = null
        {
            let elision f.new_omitted_expression()
            ctx.set_original(elision, element)
            ctx.assign_comment_and_source_map_ranges(elision, element)
            return elision
        }
        if AstNode.dot_dot_dot_token_of(element) <> null
        {
            let spread f.new_spread_element(name)
            ctx.set_original(spread, element)
            ctx.assign_comment_and_source_map_ranges(spread, element)
            return spread
        }
        let expression Transformer.convert_binding_name_to_assignment_element_target(ctx, name as ref[AstNode])
        let initializer AstNode.initializer_of(element)
        if initializer <> null
        {
            let assignment f.new_assignment_expression(expression, initializer)
            ctx.set_original(assignment, element)
            ctx.assign_comment_and_source_map_ranges(assignment, element)
            return assignment
        }
        expression
    }

    function convert_binding_element_to_object_assignment_element(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let name Printer.declaration_name_of(element)
        if AstNode.dot_dot_dot_token_of(element) <> null
        {
            let spread f.new_spread_assignment(name)
            ctx.set_original(spread, element)
            ctx.assign_comment_and_source_map_ranges(spread, element)
            return spread
        }
        let property_name AstNode.property_name_of(element)
        let initializer AstNode.initializer_of(element)
        if property_name <> null
        {
            var expression Transformer.convert_binding_name_to_assignment_element_target(ctx, name as ref[AstNode])
            if initializer <> null
                set expression: f.new_assignment_expression(expression, initializer)
            let assignment f.new_property_assignment(null, property_name, null, null, expression)
            ctx.set_original(assignment, element)
            ctx.assign_comment_and_source_map_ranges(assignment, element)
            return assignment
        }
        var equals_token: ref[AstNode]? null
        if initializer <> null
            set equals_token: f.new_token(KindEqualsToken)
        let assignment f.new_shorthand_property_assignment(null, name, null, null, equals_token, initializer)
        ctx.set_original(assignment, element)
        ctx.assign_comment_and_source_map_ranges(assignment, element)
        assignment
    }

    function convert_binding_name_to_assignment_element_target(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        if AstNode.is_binding_pattern(element)
            return Transformer.convert_binding_pattern_to_assignment_pattern(ctx, element)
        element
    }

    ; ═══ estransforms/namedevaluation.go ═══

    ; isClassNamedEvaluationHelperBlock: a `static {}` block holding only
    ; `__setFunctionName(this, <assignedName>)`
    function is_class_named_evaluation_helper_block(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if node.kind <> KindClassStaticBlockDeclaration
            return false
        let body Printer.statement_body_of(node)
        if body = null
            return false
        let statements AstNode.statements_of(body as ref[AstNode])
        if statements = null
            return false
        let sl statements as ref[Array[ref[AstNode]?]]
        if sl.get_length() <> 1
            return false
        let statement sl[0]
        if AstNode.kind_of(statement) <> KindExpressionStatement
            return false
        let expression Printer.statement_expression_of(statement as ref[AstNode])
        if expression = null
            return false
        let helper_name: Slice[char] "__setFunctionName"
        if ctx.is_call_to_helper(expression as ref[AstNode], helper_name) = false
            return false
        let arguments AstNode.call_arguments_of(expression as ref[AstNode])
        if arguments = null
            return false
        let al arguments as ref[Array[ref[AstNode]?]]
        if al.get_length() < 2
            return false
        al[1] = ctx.assigned_name(node)
    }

    function class_has_explicitly_assigned_name(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if ctx.assigned_name(node) = null
            return false
        let members Printer.member_list_of(node)
        if members = null
            return false
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if m <> null
            {
                if Transformer.is_class_named_evaluation_helper_block(ctx, m as ref[AstNode])
                    return true
            }
        }
        false
    }

    function class_has_declared_or_explicitly_assigned_name(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if Printer.declaration_name_of(node) <> null
            return true
        Transformer.class_has_explicitly_assigned_name(ctx, node)
    }

    ; IsAnonymousFunctionDefinition (no callback)
    function is_anonymous_function_definition(ctx: ref[EmitContext], node_in: ref[AstNode]?) returns bool
    {
        let skipped Parser.skip_outer_expressions(node_in, OEKAll)
        if skipped = null
            return false
        let node skipped as ref[AstNode]
        let k node.kind
        if k = KindClassExpression
            return Transformer.class_has_declared_or_explicitly_assigned_name(ctx, node) = false
        if k = KindFunctionExpression
            return Printer.declaration_name_of(node) = null
        if k = KindArrowFunction
            return true
        false
    }

    ; ast.IsNamedEvaluationSource
    function is_named_evaluation_source(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if k = KindPropertyAssignment
            return Transformer.is_proto_setter(Printer.declaration_name_of(node)) = false
        if k = KindShorthandPropertyAssignment
            return AstNode.shorthand_object_assignment_initializer_of(node) <> null
        if k = KindVariableDeclaration
            return (AstNode.kind_of(Printer.declaration_name_of(node)) = KindIdentifier) and (AstNode.initializer_of(node) <> null)
        if (k = KindParameter) or (k = KindBindingElement)
            return (AstNode.kind_of(Printer.declaration_name_of(node)) = KindIdentifier) and (AstNode.initializer_of(node) <> null) and (AstNode.dot_dot_dot_token_of(node) = null)
        if k = KindPropertyDeclaration
            return AstNode.initializer_of(node) <> null
        if k = KindBinaryExpression
        {
            let op AstNode.kind_of(AstNode.binary_operator_token_of(node))
            if (op = KindEqualsToken) or (op = KindAmpersandAmpersandEqualsToken) or (op = KindBarBarEqualsToken) or (op = KindQuestionQuestionEqualsToken)
                return AstNode.kind_of(AstNode.binary_left_of(node)) = KindIdentifier
            return false
        }
        if k = KindExportAssignment
            return true
        false
    }

    function is_proto_setter(node: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(node)
        if (k <> KindIdentifier) and (k <> KindStringLiteral)
            return false
        let proto: Slice[char] "__proto__"
        if k = KindIdentifier
            return AstNode.identifier_text_of(node).equals(proto)
        AstNode.literal_text_of(node).equals(proto)
    }

    function is_named_evaluation(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if Transformer.is_named_evaluation_source(node) = false
            return false
        let k node.kind
        if k = KindShorthandPropertyAssignment
            return Transformer.is_anonymous_function_definition(ctx, AstNode.shorthand_object_assignment_initializer_of(node))
        if (k = KindPropertyAssignment) or (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindPropertyDeclaration)
            return Transformer.is_anonymous_function_definition(ctx, AstNode.initializer_of(node))
        if k = KindBinaryExpression
            return Transformer.is_anonymous_function_definition(ctx, AstNode.binary_right_of(node))
        if k = KindExportAssignment
            return Transformer.is_anonymous_function_definition(ctx, Checker.export_assignment_expression_of(node))
        false
    }

    ; getAssignedNameOfIdentifier
    function assigned_name_of_identifier(ctx: ref[EmitContext], name: ref[AstNode], expression: ref[AstNode]?) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let original ctx.most_original(Parser.skip_outer_expressions(expression, OEKAll))
        if original <> null
        {
            let o original as ref[AstNode]
            if (o.kind = KindClassDeclaration) or (o.kind = KindFunctionDeclaration)
            {
                if (Printer.declaration_name_of(o) = null) and Transformer.has_syntactic_modifier(o, ModifierFlagsDefault)
                {
                    let default_name: Slice[char] "default"
                    return f.new_string_literal(default_name, TokenFlagsNone)
                }
            }
        }
        f.new_string_literal_from_node(name)
    }

    ; getAssignedNameOfPropertyName: (assignedName, updatedName) through the out-cell
    function assigned_name_of_property_name(ctx: ref[EmitContext], name: ref[AstNode], assigned_name_text: Slice[char], updated_name: ref[ref[AstNode]?]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        set updated_name: name
        if assigned_name_text.length > 0
            return f.new_string_literal(assigned_name_text, TokenFlagsNone)
        if Checker.is_property_name_literal(name.kind) or (name.kind = KindPrivateIdentifier)
            return f.new_string_literal_from_node(name)
        let expression AstNode.expression_of(name) as ref[AstNode]
        if Checker.is_property_name_literal(expression.kind) and (expression.kind <> KindIdentifier)
            return f.new_string_literal_from_node(expression)
        let assigned_name f.new_generated_name_for_node(name)
        ctx.add_variable_declaration(assigned_name)
        let key f.new_prop_key_helper(expression)
        let assignment f.new_assignment_expression(assigned_name, key)
        set updated_name: f.update_computed_property_name(name, assignment)
        assigned_name
    }

    ; createClassNamedEvaluationHelperBlock: `static { __setFunctionName(this, "C"); }`
    function create_class_named_evaluation_helper_block(ctx: ref[EmitContext], assigned_name: ref[AstNode], this_expression_in: ref[AstNode]?) returns ref[AstNode]
    {
        let f ctx.the_factory()
        var this_expression this_expression_in
        if this_expression = null
            set this_expression: f.new_this_expression()
        let empty: Slice[char] ""
        let expression f.new_set_function_name_helper(this_expression as ref[AstNode], assigned_name, empty)
        let statement f.new_expression_statement(expression)
        let h ctx.host
        let statements &Array[ref[AstNode]?]^h()
        statements.add(statement)
        let body f.new_block(statements, false)
        let block f.new_class_static_block_declaration(null, body)
        ctx.set_assigned_name(block, assigned_name)
        block
    }

    ; injectClassNamedEvaluationHelperBlockIfMissing
    function inject_class_named_evaluation_helper_block_if_missing(ctx: ref[EmitContext], node: ref[AstNode], assigned_name: ref[AstNode], this_expression: ref[AstNode]?) returns ref[AstNode]
    {
        if Transformer.class_has_explicitly_assigned_name(ctx, node)
            return node
        let f ctx.the_factory()
        let block Transformer.create_class_named_evaluation_helper_block(ctx, assigned_name, this_expression)
        let name Printer.declaration_name_of(node)
        if name <> null
        {
            let body Printer.statement_body_of(block) as ref[AstNode]
            let first (AstNode.statements_of(body) as ref[Array[ref[AstNode]?]])[0] as ref[AstNode]
            ctx.set_source_map_range(first, TextRange.of_node(name as ref[AstNode]))
        }
        let members Printer.member_list_of(node)
        let h ctx.host
        let new_members &Array[ref[AstNode]?]^h()
        var insertion_index 0
        if members <> null
        {
            let ml members as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ml.get_length() as int)
            {
                let m ml[i as size_t]
                if m <> null
                {
                    if Transformer.is_class_this_assignment_block(ctx, m as ref[AstNode])
                        set insertion_index: i + 1
                }
                set i: i + 1
            }
            set i: 0
            while i < (ml.get_length() as int)
            {
                if i = insertion_index
                    new_members.add(block)
                new_members.add(ml[i as size_t])
                set i: i + 1
            }
            if insertion_index >= (ml.get_length() as int)
                new_members.add(block)
        }
        else
            new_members.add(block)
        var mp 0 - 1
        var me 0 - 1
        AstNode.list_range_of(Checker.source_file_of_node(node), members, &mp, &me)
        f.set_list_range(new_members, mp, me)
        var updated: ref[AstNode]? null
        if node.kind = KindClassDeclaration
            set updated: f.update_class_declaration(node, Printer.modifier_list_of(node), name, AstNode.type_parameters_of(node), AstNode.heritage_clauses_of(node), new_members)
        else
            set updated: f.update_class_expression(node, Printer.modifier_list_of(node), name, AstNode.type_parameters_of(node), AstNode.heritage_clauses_of(node), new_members)
        let u updated as ref[AstNode]
        ctx.set_assigned_name(u, assigned_name)
        let ct ctx.class_this(node)
        if ct <> null
            ctx.set_class_this(u, ct)
        u
    }

    ; estransforms/classthis.go isClassThisAssignmentBlock: `static { _classThis = this; }`
    function is_class_this_assignment_block(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if node.kind <> KindClassStaticBlockDeclaration
            return false
        let body Printer.statement_body_of(node)
        if body = null
            return false
        let statements AstNode.statements_of(body as ref[AstNode])
        if statements = null
            return false
        let sl statements as ref[Array[ref[AstNode]?]]
        if sl.get_length() <> 1
            return false
        let statement sl[0]
        if AstNode.kind_of(statement) <> KindExpressionStatement
            return false
        let expression Printer.statement_expression_of(statement as ref[AstNode])
        if expression = null
            return false
        let e expression as ref[AstNode]
        if Emitter.is_assignment_expression(e, true) = false
            return false
        let left AstNode.binary_left_of(e)
        if AstNode.kind_of(left) <> KindIdentifier
            return false
        if ctx.class_this(node) <> left
            return false
        AstNode.kind_of(AstNode.binary_right_of(e)) = KindThisKeyword
    }

    function finish_transform_named_evaluation(ctx: ref[EmitContext], expression: ref[AstNode], assigned_name: ref[AstNode], ignore_empty_string_literal: bool) returns ref[AstNode]
    {
        if ignore_empty_string_literal and (assigned_name.kind = KindStringLiteral)
        {
            if AstNode.literal_text_of(assigned_name).length = 0
                return expression
        }
        let f ctx.the_factory()
        let inner Parser.skip_outer_expressions(expression, OEKAll) as ref[AstNode]
        var updated: ref[AstNode]? null
        if inner.kind = KindClassExpression
            set updated: Transformer.inject_class_named_evaluation_helper_block_if_missing(ctx, inner, assigned_name, null)
        else
        {
            let empty: Slice[char] ""
            set updated: f.new_set_function_name_helper(inner, assigned_name, empty)
        }
        f.restore_outer_expressions(expression, updated, OEKAll) as ref[AstNode]
    }

    ; transformNamedEvaluation: a shallow transformation of a NamedEvaluation node
    function transform_named_evaluation(ctx: ref[EmitContext], node: ref[AstNode], ignore_empty_string_literal: bool, assigned_name_text: Slice[char]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let k node.kind
        if k = KindPropertyAssignment
        {
            var updated_name: ref[AstNode]? null
            let assigned_name Transformer.assigned_name_of_property_name(ctx, Printer.declaration_name_of(node) as ref[AstNode], assigned_name_text, &updated_name)
            let initializer Transformer.finish_transform_named_evaluation(ctx, AstNode.initializer_of(node) as ref[AstNode], assigned_name, ignore_empty_string_literal)
            return f.update_property_assignment(node, null, updated_name, null, null, initializer)
        }
        if k = KindShorthandPropertyAssignment
        {
            let name Printer.declaration_name_of(node) as ref[AstNode]
            let oai AstNode.shorthand_object_assignment_initializer_of(node) as ref[AstNode]
            var assigned_name: ref[AstNode]? null
            if assigned_name_text.length > 0
                set assigned_name: f.new_string_literal(assigned_name_text, TokenFlagsNone)
            else
                set assigned_name: Transformer.assigned_name_of_identifier(ctx, name, oai)
            let initializer Transformer.finish_transform_named_evaluation(ctx, oai, assigned_name as ref[AstNode], ignore_empty_string_literal)
            return f.update_shorthand_property_assignment(node, null, name, null, null, AstNode.shorthand_equals_token_of(node), initializer)
        }
        if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement)
        {
            let name Printer.declaration_name_of(node) as ref[AstNode]
            let init_node AstNode.initializer_of(node) as ref[AstNode]
            var assigned_name: ref[AstNode]? null
            if assigned_name_text.length > 0
                set assigned_name: f.new_string_literal(assigned_name_text, TokenFlagsNone)
            else
                set assigned_name: Transformer.assigned_name_of_identifier(ctx, name, init_node)
            let initializer Transformer.finish_transform_named_evaluation(ctx, init_node, assigned_name as ref[AstNode], ignore_empty_string_literal)
            if k = KindVariableDeclaration
                return f.update_variable_declaration(node, name, null, null, initializer)
            if k = KindParameter
                return f.update_parameter_declaration(node, null, AstNode.dot_dot_dot_token_of(node), name, null, null, initializer)
            return f.update_binding_element(node, AstNode.dot_dot_dot_token_of(node), AstNode.property_name_of(node), name, initializer)
        }
        if k = KindPropertyDeclaration
        {
            var updated_name: ref[AstNode]? null
            let assigned_name Transformer.assigned_name_of_property_name(ctx, Printer.declaration_name_of(node) as ref[AstNode], assigned_name_text, &updated_name)
            let initializer Transformer.finish_transform_named_evaluation(ctx, AstNode.initializer_of(node) as ref[AstNode], assigned_name, ignore_empty_string_literal)
            return f.update_property_declaration(node, Printer.modifier_list_of(node), updated_name, null, null, initializer)
        }
        if k = KindBinaryExpression
        {
            let left AstNode.binary_left_of(node) as ref[AstNode]
            let right AstNode.binary_right_of(node) as ref[AstNode]
            var assigned_name: ref[AstNode]? null
            if assigned_name_text.length > 0
                set assigned_name: f.new_string_literal(assigned_name_text, TokenFlagsNone)
            else
                set assigned_name: Transformer.assigned_name_of_identifier(ctx, left, right)
            let new_right Transformer.finish_transform_named_evaluation(ctx, right, assigned_name as ref[AstNode], ignore_empty_string_literal)
            return f.update_binary_expression(node, null, left, null, AstNode.binary_operator_token_of(node), new_right)
        }
        if k = KindExportAssignment
        {
            var assigned_name: ref[AstNode]? null
            if assigned_name_text.length > 0
                set assigned_name: f.new_string_literal(assigned_name_text, TokenFlagsNone)
            else
            {
                if AstNode.is_export_equals_of(node)
                {
                    let empty: Slice[char] ""
                    set assigned_name: f.new_string_literal(empty, TokenFlagsNone)
                }
                else
                {
                    let default_name: Slice[char] "default"
                    set assigned_name: f.new_string_literal(default_name, TokenFlagsNone)
                }
            }
            let expression Transformer.finish_transform_named_evaluation(ctx, Checker.export_assignment_expression_of(node) as ref[AstNode], assigned_name as ref[AstNode], ignore_empty_string_literal)
            return f.update_export_assignment(node, null, AstNode.is_export_equals_of(node), null, expression)
        }
        node
    }

    ; ── the AST questions the transformers ask (ast/utilities.go) ──

    ; GetSyntacticModifierFlags over the COMPLETE modifier list (§3.5jh)
    function modifier_flags_of(n: ref[AstNode]?) returns int
    {
        let mods Printer.modifier_list_of(n)
        if mods = null
            return ModifierFlagsNone
        let list mods as ref[Array[ref[AstNode]?]]
        var flags ModifierFlagsNone
        var i 0
        while i < (list.get_length() as int)
        {
            set flags: flags | AstNode.modifier_to_flag(AstNode.kind_of(list[i as size_t]))
            set i: i + 1
        }
        flags
    }

    function has_syntactic_modifier(n: ref[AstNode]?, flag: int) returns bool
        (Transformer.modifier_flags_of(n) & flag) <> 0

    function has_decorators(n: ref[AstNode]?) returns bool
        (Transformer.modifier_flags_of(n) & ModifierFlagsDecorator) <> 0

    ; Node.Decorators(): the decorators of the modifier list, in order
    function decorators_of(host: ref[Page], n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        let mods Printer.modifier_list_of(n)
        if mods = null
            return out
        let list mods as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            let m list[i as size_t]
            if AstNode.is_decorator(m)
                out.add(m)
            set i: i + 1
        }
        out
    }

    ; IsParameterPropertyDeclaration(node, parent)
    function is_parameter_property_declaration(n: ref[AstNode], parent: ref[AstNode]?) returns bool
    {
        if n.kind <> KindParameter
            return false
        if parent = null
            return false
        if (parent as ref[AstNode]).kind <> KindConstructor
            return false
        Transformer.has_syntactic_modifier(n, ModifierFlagsParameterPropertyModifier)
    }

    function get_innermost_module_declaration_from_dotted_module(n: ref[AstNode]) returns ref[AstNode]
    {
        var m n
        while true
        {
            let body Printer.module_body_of(m)
            if body = null
                return m
            let b body as ref[AstNode]
            if b.kind <> KindModuleDeclaration
                return m
            set m: b
        }
        m
    }

    function is_assertion_expression(n: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(n)
        (k = KindTypeAssertionExpression) or (k = KindAsExpression)
    }

    ; SingleOrMany
    procedure single_or_many(this, nodes: ref[Array[ref[AstNode]?]]) returns ref[AstNode]?
    {
        let n nodes.get_length() as int
        if n = 0
            return null
        if n = 1
            return nodes[0]
        factory.new_syntax_list(nodes)
    }

    ; SplitStandardPrologue / SplitCustomPrologue: the index where the prologue ends
    function standard_prologue_end(statements: ref[Array[ref[AstNode]?]]) returns int
    {
        var i 0
        while i < (statements.get_length() as int)
        {
            if EmitContext.is_prologue_directive(statements[i as size_t]) = false
                return i
            set i: i + 1
        }
        i
    }

    function custom_prologue_end(this, statements: ref[Array[ref[AstNode]?]], from: int) returns int
    {
        var i from
        while i < (statements.get_length() as int)
        {
            if context.is_custom_prologue(statements[i as size_t]) = false
                return i
            set i: i + 1
        }
        i
    }

    ; ═══ tstransforms/typeeraser.go ═══

    procedure push_node(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent parent_node
        set this.parent_node: current_node
        set this.current_node: node
        grandparent
    }

    procedure pop_node(this, grandparent: ref[AstNode]?)
    {
        set this.current_node: parent_node
        set this.parent_node: grandparent
    }

    procedure elide(this, node: ref[AstNode]) returns ref[AstNode]?
        context.new_not_emitted_statement(node)

    procedure visit_type_eraser(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        ; a subtree without TypeScript facts is left UNTOUCHED — which is why a
        ; bodiless overload prints as `f() { }` and a `static constructor` keeps
        ; its modifier (§3.5ji 6)
        if (Emitter.subtree_facts(node) & SubtreeContainsTypeScript) = 0
            return node
        if Checker.is_statement(node) and Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient)
            return this.elide(node)
        let grandparent this.push_node(node)
        let result this.visit_type_eraser_worker(node)
        this.pop_node(grandparent)
        result
    }

    procedure visit_type_eraser_worker(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let k node.kind
        if (k = KindPublicKeyword) or (k = KindPrivateKeyword) or (k = KindProtectedKeyword) or (k = KindAbstractKeyword) or (k = KindOverrideKeyword) or (k = KindConstKeyword) or (k = KindDeclareKeyword) or (k = KindReadonlyKeyword) or (k = KindArrayType) or (k = KindTupleType) or (k = KindOptionalType) or (k = KindRestType) or (k = KindTypeLiteral) or (k = KindTypePredicate) or (k = KindTypeParameter) or (k = KindAnyKeyword) or (k = KindUnknownKeyword) or (k = KindBooleanKeyword) or (k = KindStringKeyword) or (k = KindNumberKeyword) or (k = KindNeverKeyword) or (k = KindVoidKeyword) or (k = KindSymbolKeyword) or (k = KindConstructorType) or (k = KindFunctionType) or (k = KindTypeQuery) or (k = KindTypeReference) or (k = KindUnionType) or (k = KindIntersectionType) or (k = KindConditionalType) or (k = KindParenthesizedType) or (k = KindThisType) or (k = KindTypeOperator) or (k = KindIndexedAccessType) or (k = KindMappedType) or (k = KindLiteralType) or (k = KindIndexSignature)
            return null
        if (k = KindInKeyword) or (k = KindOutKeyword)
        {
            if parent_node = null
                return null
            if (parent_node as ref[AstNode]).kind <> KindBinaryExpression
                return null
            return v.visit_each_child(node)
        }
        if k = KindJSImportDeclaration
            return null
        if (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration) or (k = KindInterfaceDeclaration)
            return this.elide(node)
        if k = KindNamespaceExportDeclaration
            return null
        if k = KindModuleDeclaration
        {
            let name Printer.declaration_name_of(node)
            var keep AstNode.kind_of(name) = KindIdentifier
            if keep
            {
                if this.the_checker().is_instantiated_module(node) = false
                    set keep: false
            }
            if keep
            {
                if Printer.module_body_of(Transformer.get_innermost_module_declaration_from_dotted_module(node)) = null
                    set keep: false
            }
            if keep = false
                return this.elide(node)
            return v.visit_each_child(node)
        }
        if k = KindExpressionWithTypeArguments
            return factory.update_expression_with_type_arguments(node, v.visit_node(AstNode.expression_of(node)), null)
        if k = KindPropertyDeclaration
        {
            if (opts.options.experimental_decorators = TristateTrue) and Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient | ModifierFlagsAbstract) and Transformer.has_decorators(node)
                return factory.update_property_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
            if Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient | ModifierFlagsAbstract)
                return null
            return factory.update_property_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
        }
        if k = KindConstructor
        {
            if Parser.node_is_missing(AstNode.body_of(node))
                return null
            return factory.update_constructor_declaration(node, null, null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        }
        if k = KindMethodDeclaration
        {
            if Parser.node_is_missing(AstNode.body_of(node))
                return null
            return factory.update_method_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        }
        if (k = KindGetAccessor) or (k = KindSetAccessor)
        {
            if Parser.node_is_missing(AstNode.body_of(node)) and Transformer.has_syntactic_modifier(node, ModifierFlagsAbstract)
                return null
            var body v.visit_node(AstNode.body_of(node))
            if body = null
                set body: factory.new_block(&Array[ref[AstNode]?]^host(), false)
            if k = KindGetAccessor
                return factory.update_get_accessor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, body)
            return factory.update_set_accessor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, body)
        }
        if k = KindVariableDeclaration
        {
            let updated factory.update_variable_declaration(node, v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
            let type_node AstNode.type_of(node)
            if type_node <> null
                context.set_type_node(Printer.declaration_name_of(updated) as ref[AstNode], type_node)
            return updated
        }
        if k = KindHeritageClause
        {
            let token AstNode.heritage_clause_token_of(node)
            if token = KindImplementsKeyword
                return null
            return factory.update_heritage_clause(node, token, v.visit_nodes(AstNode.heritage_clause_types_of(node)))
        }
        if k = KindClassDeclaration
            return factory.update_class_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.heritage_clauses_of(node)), v.visit_nodes(Printer.member_list_of(node)))
        if k = KindClassExpression
            return factory.update_class_expression(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.heritage_clauses_of(node)), v.visit_nodes(Printer.member_list_of(node)))
        if k = KindFunctionDeclaration
        {
            if Parser.node_is_missing(AstNode.body_of(node))
                return this.elide(node)
            return factory.update_function_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        }
        if k = KindFunctionExpression
            return factory.update_function_expression(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        if k = KindArrowFunction
            return factory.update_arrow_function(node, v.visit_modifiers(Printer.modifier_list_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, AstNode.equals_greater_than_token_of(node), v.visit_node(AstNode.body_of(node)))
        if k = KindParameter
        {
            if AstNode.is_this_parameter(node)
                return null
            var modifiers: ref[Array[ref[AstNode]?]]? null
            if Transformer.is_parameter_property_declaration(node, parent_node)
                set modifiers: Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsParameterPropertyModifier)
            if Transformer.has_decorators(node)
            {
                var changed false
                let visited v.visit_slice(Transformer.decorators_of(host, node), &changed)
                if modifiers = null
                    set modifiers: visited
                else
                {
                    let merged &Array[ref[AstNode]?]^host()
                    let ms modifiers as ref[Array[ref[AstNode]?]]
                    var i 0
                    while i < (ms.get_length() as int)
                    {
                        merged.add(ms[i as size_t])
                        set i: i + 1
                    }
                    set i: 0
                    while i < (visited.get_length() as int)
                    {
                        merged.add(visited[i as size_t])
                        set i: i + 1
                    }
                    set modifiers: merged
                }
            }
            return factory.update_parameter_declaration(node, modifiers, AstNode.dot_dot_dot_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
        }
        if k = KindCallExpression
            return factory.update_call_expression(node, v.visit_node(AstNode.expression_of(node)), AstNode.question_dot_token_of(node), null, v.visit_nodes(AstNode.call_arguments_of(node)), node.flags)
        if k = KindNewExpression
            return factory.update_new_expression(node, v.visit_node(AstNode.expression_of(node)), null, v.visit_nodes(AstNode.call_arguments_of(node)))
        if k = KindTaggedTemplateExpression
            return factory.update_tagged_template_expression(node, v.visit_node(AstNode.tagged_template_tag_of(node)), AstNode.question_dot_token_of(node), null, v.visit_node(AstNode.tagged_template_template_of(node)), node.flags)
        if (k = KindNonNullExpression) or (k = KindTypeAssertionExpression) or (k = KindAsExpression) or (k = KindSatisfiesExpression)
        {
            let partial factory.new_partially_emitted_expression(v.visit_node(AstNode.expression_of(node)))
            context.set_original(partial, node)
            set partial.pos: node.pos
            set partial.end: node.end
            return partial
        }
        if k = KindParenthesizedExpression
        {
            if Checker.is_jsdoc_type_assertion(node) = false
            {
                let inner AstNode.expression_of(node)
                let expression Parser.skip_outer_expressions(inner, OEKAllExceptAssertionsOrExpressionsWithTypeArguments)
                if Transformer.is_assertion_expression(expression) or (AstNode.kind_of(expression) = KindSatisfiesExpression)
                {
                    let partial factory.new_partially_emitted_expression(v.visit_node(inner))
                    context.set_original(partial, node)
                    set partial.pos: node.pos
                    set partial.end: node.end
                    return partial
                }
            }
            return v.visit_each_child(node)
        }
        if k = KindJsxSelfClosingElement
            return factory.update_jsx_self_closing_element(node, v.visit_node(AstNode.jsx_tag_name_of(node)), null, v.visit_node(AstNode.jsx_attributes_of(node)))
        if k = KindJsxOpeningElement
            return factory.update_jsx_opening_element(node, v.visit_node(AstNode.jsx_tag_name_of(node)), null, v.visit_node(AstNode.jsx_attributes_of(node)))
        if k = KindImportEqualsDeclaration
        {
            if AstNode.is_type_only_of(node)
                return null
            return v.visit_each_child(node)
        }
        if k = KindImportDeclaration
        {
            let import_clause AstNode.import_clause_of(node)
            if import_clause = null
                return node
            let visited_clause v.visit_node(import_clause)
            if visited_clause = null
                return null
            return factory.update_import_declaration(node, Printer.modifier_list_of(node), visited_clause, AstNode.module_specifier_of(node), AstNode.import_attributes_of(node))
        }
        if k = KindImportClause
        {
            if AstNode.is_type_only_of(node)
                return null
            let name Printer.declaration_name_of(node)
            let named_bindings v.visit_node(AstNode.named_bindings_of(node))
            if (name = null) and (named_bindings = null)
                return null
            return factory.update_import_clause(node, AstNode.import_clause_phase_modifier_of(node), name, named_bindings)
        }
        if k = KindNamedImports
        {
            let elements AstNode.elements_of(node)
            if Transformer.list_is_empty(elements)
                return node
            let visited v.visit_nodes(elements)
            if (opts.options.verbatim_module_syntax <> TristateTrue) and Transformer.list_is_empty(visited)
                return null
            return factory.update_named_imports(node, visited)
        }
        if k = KindImportSpecifier
        {
            if Printer.specifier_is_type_only_of(node)
                return null
            return node
        }
        if k = KindExportDeclaration
        {
            if AstNode.is_type_only_of(node)
                return null
            var export_clause: ref[AstNode]? null
            let ec AstNode.export_clause_of(node)
            if ec <> null
            {
                set export_clause: v.visit_node(ec)
                if export_clause = null
                    return null
            }
            return factory.update_export_declaration(node, null, false, export_clause, v.visit_node(AstNode.module_specifier_of(node)), v.visit_node(AstNode.import_attributes_of(node)))
        }
        if k = KindNamedExports
        {
            let elements AstNode.elements_of(node)
            if Transformer.list_is_empty(elements)
                return node
            let visited v.visit_nodes(elements)
            if (opts.options.verbatim_module_syntax <> TristateTrue) and Transformer.list_is_empty(visited)
                return null
            return factory.update_named_exports(node, visited)
        }
        if k = KindExportSpecifier
        {
            if Printer.specifier_is_type_only_of(node)
                return null
            return node
        }
        if k = KindEnumDeclaration
        {
            if this.the_checker().is_enum_const(node)
                return node
            return v.visit_each_child(node)
        }
        v.visit_each_child(node)
    }

    function list_is_empty(list: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if list = null
            return true
        ((list as ref[Array[ref[AstNode]?]]).get_length() as int) = 0
    }

    ; ═══ transformers/modifiervisitor.go ═══

    procedure visit_modifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let flags AstNode.modifier_to_flag(node.kind)
        if (flags <> ModifierFlagsNone) and ((flags & allowed_modifiers) = 0)
            return null
        node
    }

    ; ExtractModifiers
    function extract_modifiers(host: ref[Page], opts: TransformOptions, modifiers: ref[Array[ref[AstNode]?]]?, allowed: int) returns ref[Array[ref[AstNode]?]]?
    {
        if modifiers = null
            return null
        let tx Transformer.create(host, TransformerTagModifierVisitor, opts)
        set tx.allowed_modifiers: allowed
        tx.the_visitor().visit_modifiers(modifiers)
    }

    ; ═══ transformers/chain.go ═══

    procedure visit_chain(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind <> KindSourceFile
        {
            ; the reference PANICS ("Chained transform passed non-sourcefile initial node")
            this.record_unported("chain-non-source-file", node.kind)
            return node
        }
        var result node
        var i 0
        while i < (components.get_length() as int)
        {
            let t components[i as size_t] as ref[Transformer]
            set result: t.transform_source_file(result)
            if t.unported_count > 0
                this.record_unported(t.unported_tag, t.unported_detail)
            set i: i + 1
        }
        result
    }

    ; ═══ estransforms/usestrict.go ═══

    procedure visit_use_strict(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind <> KindSourceFile
            return node
        let info opts.file_info
        if info.script_kind = ScriptKindJSON
            return node
        let is_external_module info.is_external_module
        let module_kind opts.options.get_emit_module_kind()
        let format opts.options.get_emit_module_format_of_file(info.file_name)
        if is_external_module and (module_kind >= ModuleKindES2015) and ((module_kind = ModuleKindPreserve) or (format >= ModuleKindES2015))
            return node
        let old AstNode.statements_of(node)
        var statements old
        if statements = null
            set statements: &Array[ref[AstNode]?]^host()
        let ensured factory.ensure_use_strict(statements as ref[Array[ref[AstNode]?]])
        if ensured = statements
            return node
        let statement_list factory.new_node_list_like(ensured, old)
        factory.update_source_file(node, statement_list, AstNode.end_of_file_token_of(node))
    }

    ; ═══ moduletransforms/esmodule.go ═══

    procedure visit_es_module(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if k = KindSourceFile
            return this.es_visit_source_file(node)
        if k = KindImportDeclaration
            return this.es_visit_import_declaration(node)
        if k = KindImportEqualsDeclaration
            return this.es_visit_import_equals_declaration(node)
        if k = KindExportAssignment
            return this.es_visit_export_assignment(node)
        if k = KindExportDeclaration
            return this.es_visit_export_declaration(node)
        if k = KindCallExpression
            return this.es_visit_call_expression(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure es_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let info opts.file_info
        if info.is_declaration_file
            return node
        if (info.is_external_module = false) and (opts.options.get_isolated_modules() = false)
            return node
        set this.current_source_file: node
        set this.import_require_statements: null
        var result this.the_visitor().visit_each_child(node) as ref[AstNode]
        let helpers context.read_emit_helpers()
        var i 0
        while i < (helpers.get_length() as int)
        {
            context.add_emit_helper(result, helpers[i as size_t] as ref[EmitHelper])
            set i: i + 1
        }
        let external_helpers_import_declaration this.create_external_helpers_import_declaration_if_needed(result, opts.options.get_emit_module_format_of_file(info.file_name))
        if (external_helpers_import_declaration <> null) or (import_require_statements <> null)
        {
            let old AstNode.statements_of(result)
            var src old
            if src = null
                set src: &Array[ref[AstNode]?]^host()
            let s src as ref[Array[ref[AstNode]?]]
            let n s.get_length() as int
            let prologue_end Transformer.standard_prologue_end(s)
            let custom_end this.custom_prologue_end(s, prologue_end)
            let statements &Array[ref[AstNode]?]^host()
            var j 0
            while j < custom_end
            {
                statements.add(s[j as size_t])
                set j: j + 1
            }
            if external_helpers_import_declaration <> null
                statements.add(this.the_visitor().visit_node(external_helpers_import_declaration))
            if import_require_statements <> null
            {
                let irs import_require_statements as ref[Array[ref[AstNode]?]]
                var r 0
                while r < (irs.get_length() as int)
                {
                    statements.add(irs[r as size_t])
                    set r: r + 1
                }
            }
            while j < n
            {
                statements.add(s[j as size_t])
                set j: j + 1
            }
            set result: factory.update_source_file(result, factory.new_node_list_like(statements, old), AstNode.end_of_file_token_of(node))
        }
        if info.is_external_module and (opts.options.get_emit_module_kind() <> ModuleKindPreserve) and (Transformer.some_external_module_indicator(AstNode.statements_of(result)) = false)
        {
            let old AstNode.statements_of(result)
            let statements &Array[ref[AstNode]?]^host()
            if old <> null
            {
                let s old as ref[Array[ref[AstNode]?]]
                var j 0
                while j < (s.get_length() as int)
                {
                    statements.add(s[j as size_t])
                    set j: j + 1
                }
            }
            statements.add(this.create_empty_imports())
            set result: factory.update_source_file(result, factory.new_node_list_like(statements, old), AstNode.end_of_file_token_of(node))
        }
        set this.import_require_statements: null
        set this.current_source_file: null
        result
    }

    function some_external_module_indicator(statements: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if statements = null
            return false
        let s statements as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (s.get_length() as int)
        {
            if Parser.statement_is_external_module_indicator(s[i as size_t])
                return true
            set i: i + 1
        }
        false
    }

    ; createEmptyImports: `export {};`
    procedure create_empty_imports(this) returns ref[AstNode]
        factory.new_export_declaration(null, false, factory.new_named_exports(&Array[ref[AstNode]?]^host()), null, null)

    ; rewriteModuleSpecifier: identity unless rewriteRelativeImportExtensions
    ; (a said stop when the option is on — the extension rewrite needs tspath
    ; and outputpaths this port has not reached)
    procedure rewrite_module_specifier(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        if opts.options.rewrite_relative_import_extensions = TristateTrue
            this.record_unported("rewrite-relative-import-extensions", 0)
        node
    }

    ; createExternalHelpersImportDeclarationIfNeeded: nothing unless importHelpers
    ; (a said stop when the option is on)
    procedure create_external_helpers_import_declaration_if_needed(this, source_file: ref[AstNode], file_module_kind: int) returns ref[AstNode]?
    {
        if opts.options.import_helpers = TristateTrue
            this.record_unported("import-helpers", file_module_kind)
        null
    }

    procedure es_visit_import_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.options.rewrite_relative_import_extensions <> TristateTrue
            return node
        let updated_module_specifier this.rewrite_module_specifier(AstNode.module_specifier_of(node))
        factory.update_import_declaration(node, null, this.the_visitor().visit_node(AstNode.import_clause_of(node)), updated_module_specifier, this.the_visitor().visit_node(AstNode.import_attributes_of(node)))
    }

    procedure es_visit_import_equals_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.options.get_emit_module_kind() < ModuleKindNode16
            return null
        ; the node16+ `import x = require(...)` lowering (createRequireCall and the
        ; `_createRequire` prologue) — a said stop until a module kind reaches it
        this.record_unported("esmodule-import-equals", node.kind)
        null
    }

    procedure es_visit_export_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if AstNode.is_export_equals_of(node) = false
            return this.the_visitor().visit_each_child(node)
        if opts.options.get_emit_module_kind() <> ModuleKindPreserve
            return null
        let f factory
        let statement f.new_expression_statement(f.new_assignment_expression(f.new_property_access_expression(f.new_identifier("module"), null, f.new_identifier("exports"), NodeFlagsNone), this.the_visitor().visit_node(Printer.statement_expression_of(node))))
        context.set_original(statement, node)
        statement
    }

    procedure es_visit_export_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let module_specifier AstNode.module_specifier_of(node)
        if module_specifier = null
            return node
        let updated_module_specifier this.rewrite_module_specifier(module_specifier)
        let export_clause AstNode.export_clause_of(node)
        ; the RAW module option, as the reference reads it here
        if (opts.options.module_kind > ModuleKindES2015) or (export_clause = null) or (AstNode.kind_of(export_clause) <> KindNamespaceExport)
            return factory.update_export_declaration(node, null, false, export_clause, updated_module_specifier, this.the_visitor().visit_node(AstNode.import_attributes_of(node)))
        ; ES2015: `export * as ns from "m"` becomes an import plus a named export
        let ec export_clause as ref[AstNode]
        let old_identifier Printer.declaration_name_of(ec) as ref[AstNode]
        let f factory
        let synth_name f.new_generated_name_for_node(old_identifier)
        let import_decl f.new_import_declaration(null, f.new_import_clause(KindUnknown, null, f.new_namespace_import(synth_name)), updated_module_specifier, this.the_visitor().visit_node(AstNode.import_attributes_of(node)))
        context.set_original(import_decl, ec)
        var export_decl: ref[AstNode]? null
        if Checker.module_export_name_is_default(old_identifier)
            set export_decl: f.new_export_assignment(null, false, null, synth_name)
        else
        {
            let specifiers &Array[ref[AstNode]?]^host()
            specifiers.add(f.new_export_specifier(false, synth_name, old_identifier))
            set export_decl: f.new_export_declaration(null, false, f.new_named_exports(specifiers), null, null)
        }
        context.set_original(export_decl as ref[AstNode], node)
        let both &Array[ref[AstNode]?]^host()
        both.add(import_decl)
        both.add(export_decl)
        this.single_or_many(both)
    }

    procedure es_visit_call_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.options.rewrite_relative_import_extensions = TristateTrue
        {
            if (Parser.is_import_call(node) and (Transformer.list_is_empty(AstNode.call_arguments_of(node)) = false)) or (Checker.is_in_json_file(node) = false and Parser.is_require_call(node, false) and ((node.flags & NodeFlagsJavaScriptFile) <> 0))
                this.record_unported("rewrite-relative-import-extensions", node.kind)
        }
        this.the_visitor().visit_each_child(node)
    }
}

; ═══ compiler/emitter.go, the JS half, over the corpus's default options ═══

; What the driver scans a file for before it decides which transformers it
; needs: each bit names a transformer this port has not ported yet.
define EmitFacts
(
    has_import_or_export: bool
    has_runtime_syntax: bool
    has_decorator: bool
    has_using: bool
    has_auto_accessor: bool
    has_dynamic_import: bool
)

define Emitter
(
    host: ref[Page]
    unported_count: int
    unported_tag: Slice[char]
    unported_detail: int
)
{
    function create(host: ref[Page]) returns ref[Emitter]
    {
        let no_tag: Slice[char] ""
        &Emitter^host(host, 0, no_tag, 0)
    }

    procedure record_unported(this, tag_text: Slice[char], detail: int)
    {
        if unported_count = 0
        {
            set this.unported_tag: tag_text
            set this.unported_detail: detail
        }
        set this.unported_count: unported_count + 1
    }

    ; ast.isFileForcedToBeModuleByFormat under moduleDetection "auto": a file
    ; whose implied node format is ESNext (`.mts`/`.mjs`), or a `.mts`/`.mjs`
    ; file outright, is an external module whatever its statements say. The
    ; parser's `external_module_indicator` reads the statements only; the
    ; emitter's file record ORs this in.

    ; Node.SubtreeFacts(): the cached facts of a node, the Computed marker
    ; stripped
    function subtree_facts(n: ref[AstNode]) returns int
    {
        var f n.subtree_facts
        if (f & SubtreeFactsComputed) = 0
        {
            set f: Emitter.compute_subtree_facts(n) | SubtreeFactsComputed
            set n.subtree_facts: f
        }
        f & SubtreeFactsAllBits
    }

    function clear_facts(f: int, mask: int) returns int
        f & (SubtreeFactsAllBits xor mask)

    ; propagateSubtreeFacts(child): nil → none; a type-syntax node answers
    ; SubtreeContainsTypeScript whatever it holds; every other kind answers its
    ; facts minus the bits its scope keeps to itself
    function sf(c: ref[AstNode]?) returns int
    {
        if c = null
            return SubtreeFactsNone
        Emitter.propagate_subtree_facts(c as ref[AstNode])
    }

    function propagate_subtree_facts(n: ref[AstNode]) returns int
    {
        let k n.kind
        if Emitter.is_type_syntax_kind(k)
            return SubtreeContainsTypeScript
        let f Emitter.subtree_facts(n)
        if k = KindCatchClause
            return Emitter.clear_facts(f, SubtreeClearsCatchClause)
        if k = KindVariableDeclarationList
            return Emitter.clear_facts(f, SubtreeClearsVariableDeclarationList)
        if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern)
            return Emitter.clear_facts(f, SubtreeClearsBindingPattern)
        if (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindConstructor)
            return Emitter.clear_facts(f, SubtreeClearsFunction)
        if (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
            return Emitter.clear_facts(f, SubtreeClearsFunction) | Emitter.sf(Printer.declaration_name_of(n))
        if k = KindPropertyDeclaration
            return Emitter.clear_facts(f, SubtreeClearsProperty) | Emitter.sf(Printer.declaration_name_of(n))
        if k = KindModuleDeclaration
            return Emitter.clear_facts(f, SubtreeClearsModule)
        if k = KindObjectLiteralExpression
            return Emitter.clear_facts(f, SubtreeClearsObjectLiteral)
        if k = KindArrowFunction
            return Emitter.clear_facts(f, SubtreeClearsArrowFunction)
        f
    }

    ; propagateNodeListSubtreeFacts(children, propagateSubtreeFacts)
    function sfl(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sf(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    ; propagateEraseableSyntaxSubtreeFacts / propagateEraseableSyntaxListSubtreeFacts
    function sfe(c: ref[AstNode]?) returns int
    {
        if c = null
            return SubtreeFactsNone
        SubtreeContainsTypeScript
    }

    function sfel(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        SubtreeContainsTypeScript
    }

    ; propagateObjectBindingElementSubtreeFacts: a `...rest` inside `{ }` is an
    ; OBJECT rest
    function sfobe(c: ref[AstNode]?) returns int
    {
        var facts Emitter.sf(c)
        if (facts & SubtreeContainsRestOrSpread) <> 0
        {
            set facts: Emitter.clear_facts(facts, SubtreeContainsRestOrSpread)
            set facts: facts | SubtreeContainsObjectRestOrSpread | SubtreeContainsESObjectRestOrSpread
        }
        facts
    }

    ; propagateBindingElementSubtreeFacts: an array pattern's rest is cleared
    function sfbe(c: ref[AstNode]?) returns int
        Emitter.clear_facts(Emitter.sf(c), SubtreeContainsRestOrSpread)

    function sfl_object_binding(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sfobe(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    function sfl_array_binding(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sfbe(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    ; The kinds whose record embeds TypeSyntaxBase in the reference (every
    ; TypeNodeBase kind, the JSDoc types, the five type elements, the type
    ; parameter, interface, type alias and `export as namespace`): their facts are
    ; SubtreeContainsTypeScript, computed and propagated alike
    function is_type_syntax_kind(k: int) returns bool
    {
        if (k = KindTypeReference) or (k = KindTypeQuery) or (k = KindImportType) or (k = KindFunctionType) or (k = KindConstructorType) or (k = KindUnionType) or (k = KindIntersectionType) or (k = KindConditionalType) or (k = KindTypeOperator) or (k = KindInferType) or (k = KindArrayType) or (k = KindIndexedAccessType) or (k = KindLiteralType) or (k = KindThisType) or (k = KindTypePredicate) or (k = KindMappedType) or (k = KindTypeLiteral) or (k = KindTupleType) or (k = KindNamedTupleMember) or (k = KindOptionalType) or (k = KindRestType) or (k = KindParenthesizedType) or (k = KindTemplateLiteralType) or (k = KindTemplateLiteralTypeSpan)
            return true
        if (k = KindJSDocTypeExpression) or (k = KindJSDocNameReference) or (k = KindJSDocNonNullableType) or (k = KindJSDocNullableType) or (k = KindJSDocAllType) or (k = KindJSDocVariadicType) or (k = KindJSDocOptionalType) or (k = KindJSDocSignature) or (k = KindJSDocTypeLiteral)
            return true
        if (k = KindInterfaceDeclaration) or (k = KindTypeAliasDeclaration) or (k = KindNamespaceExportDeclaration) or (k = KindCallSignature) or (k = KindConstructSignature) or (k = KindIndexSignature) or (k = KindMethodSignature) or (k = KindPropertySignature) or (k = KindTypeParameter)
            return true
        false
    }

    ; Token.computeSubtreeFacts
    function token_subtree_facts(k: int) returns int
    {
        if k = KindUsingKeyword
            return SubtreeContainsUsing
        if (k = KindPublicKeyword) or (k = KindPrivateKeyword) or (k = KindProtectedKeyword) or (k = KindReadonlyKeyword) or (k = KindAbstractKeyword) or (k = KindDeclareKeyword) or (k = KindConstKeyword) or (k = KindAnyKeyword) or (k = KindNumberKeyword) or (k = KindBigIntKeyword) or (k = KindNeverKeyword) or (k = KindObjectKeyword) or (k = KindInKeyword) or (k = KindOutKeyword) or (k = KindOverrideKeyword) or (k = KindStringKeyword) or (k = KindBooleanKeyword) or (k = KindSymbolKeyword) or (k = KindVoidKeyword) or (k = KindUnknownKeyword) or (k = KindUndefinedKeyword) or (k = KindExportKeyword)
            return SubtreeContainsTypeScript
        if k = KindAccessorKeyword
            return SubtreeContainsClassFields
        if k = KindAsyncKeyword
            return SubtreeContainsAnyAwait
        if k = KindSuperKeyword
            return SubtreeContainsLexicalSuper
        if k = KindThisKeyword
            return SubtreeContainsLexicalThis
        if (k = KindAsteriskAsteriskToken) or (k = KindAsteriskAsteriskEqualsToken)
            return SubtreeContainsExponentiationOperator
        if k = KindQuestionQuestionToken
            return SubtreeContainsNullishCoalescing
        if k = KindQuestionDotToken
            return SubtreeContainsOptionalChaining
        if (k = KindQuestionQuestionEqualsToken) or (k = KindBarBarEqualsToken) or (k = KindAmpersandAmpersandEqualsToken)
            return SubtreeContainsLogicalAssignments
        ; JsxOpeningFragment / JsxClosingFragment are Token-arm nodes here
        if (k = KindJsxOpeningFragment) or (k = KindJsxClosingFragment)
            return SubtreeContainsJsx
        SubtreeFactsNone
    }

    function async_generator_facts(is_async: bool, is_generator: bool) returns int
    {
        if is_async and is_generator
            return SubtreeContainsForAwaitOrAsyncGenerator
        if is_async
            return SubtreeContainsAnyAwait
        SubtreeFactsNone
    }

    ; the 110 computeSubtreeFacts, by record and — where records are shared —
    ; by kind
    function compute_subtree_facts(n: ref[AstNode]) returns int
    {
        let k n.kind
        if Emitter.is_type_syntax_kind(k)
            return SubtreeContainsTypeScript
        choose n.data
            when d: Token
                return Emitter.token_subtree_facts(k)
            when d: Identifier
                return SubtreeContainsIdentifier
            when d: PrivateIdentifier
                return SubtreeContainsClassFields
            when d: NoSubstitutionTemplateLiteral
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateHead
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateMiddle
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateTail
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: SourceFile
                return Emitter.sfl(d.statements)
            when d: Block
                return Emitter.sfl(d.statements)
            when d: ModuleBlock
                return Emitter.sfl(d.statements)
            when d: ExpressionStatement
                return Emitter.sf(d.expression)
            when d: ThrowStatement
                return Emitter.sf(d.expression)
            when d: VariableStatement
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.declaration_list)
            }
            when d: VariableDeclarationList
            {
                var f Emitter.sfl(d.declarations)
                if (n.flags & NodeFlagsUsing) <> 0
                    set f: f | SubtreeContainsUsing
                return f
            }
            when d: VariableDeclaration
                return Emitter.sf(d.name) | Emitter.sfe(d.exclamation_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer)
            when d: IfStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.then_statement) | Emitter.sf(d.else_statement)
            when d: DoStatement
                return Emitter.sf(d.statement) | Emitter.sf(d.expression)
            when d: WhileStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: WithStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: ForStatement
                return Emitter.sf(d.initializer) | Emitter.sf(d.condition) | Emitter.sf(d.incrementor) | Emitter.sf(d.statement)
            when d: ForInStatement
                return Emitter.sf(d.initializer) | Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: ForOfStatement
            {
                var f Emitter.sf(d.initializer) | Emitter.sf(d.expression) | Emitter.sf(d.statement)
                if d.await_modifier <> null
                    set f: f | SubtreeContainsForAwaitOrAsyncGenerator
                return f
            }
            when d: ReturnStatement
                return Emitter.sf(d.expression) | SubtreeContainsForAwaitOrAsyncGenerator
            when d: SwitchStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.case_block)
            when d: CaseBlock
                return Emitter.sfl(d.elements)
            when d: CaseClause
                return Emitter.sf(d.expression) | Emitter.sfl(d.statements)
            when d: DefaultClause
                return Emitter.sf(d.expression) | Emitter.sfl(d.statements)
            when d: TryStatement
                return Emitter.sf(d.try_block) | Emitter.sf(d.catch_clause) | Emitter.sf(d.finally_block)
            when d: CatchClause
            {
                var f Emitter.sf(d.variable_declaration) | Emitter.sf(d.block)
                if d.variable_declaration = null
                    set f: f | SubtreeContainsMissingCatchClauseVariable
                return f
            }
            when d: LabeledStatement
                return Emitter.sf(d.label_name) | Emitter.sf(d.statement)
            when d: ObjectBindingPattern
                return Emitter.sfl_object_binding(d.elements)
            when d: ArrayBindingPattern
                return Emitter.sfl_array_binding(d.elements)
            when d: Parameter
            {
                if AstNode.is_this_identifier(d.name)
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfe(d.question_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer)
            }
            when d: BindingElement
            {
                var f Emitter.sf(d.property_name) | Emitter.sf(d.name) | Emitter.sf(d.initializer)
                if d.dot_dot_dot_token <> null
                    set f: f | SubtreeContainsRestOrSpread
                return f
            }
            when d: FunctionDeclaration
            {
                let flags Transformer.modifier_flags_of(n)
                if (d.body = null) or ((flags & ModifierFlagsAmbient) <> 0)
                    return SubtreeContainsTypeScript
                let is_async (flags & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: ClassDeclaration
                return Emitter.class_like_subtree_facts(n, d.modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: ClassExpression
                return Emitter.class_like_subtree_facts(n, d.modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: HeritageClause
            {
                if d.token = KindExtendsKeyword
                    return Emitter.sfl(d.types)
                if d.token = KindImplementsKeyword
                    return SubtreeContainsTypeScript
                return SubtreeFactsNone
            }
            when d: EnumMember
                return Emitter.sf(d.name) | Emitter.sf(d.initializer) | SubtreeContainsTypeScript
            when d: EnumDeclaration
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfl(d.members) | SubtreeContainsTypeScript
            }
            when d: ModuleDeclaration
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sf(d.body) | SubtreeContainsTypeScript
            }
            when d: ImportEqualsDeclaration
            {
                if d.is_type_only or (d.module_reference.kind <> KindExternalModuleReference)
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sf(d.module_reference)
            }
            when d: ImportSpecifier
            {
                if d.is_type_only
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.property_name) | Emitter.sf(d.name)
            }
            when d: ExportSpecifier
            {
                if d.is_type_only
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.property_name) | Emitter.sf(d.name)
            }
            when d: ImportClause
            {
                if d.phase_modifier = KindTypeKeyword
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.name) | Emitter.sf(d.named_bindings)
            }
            when d: ImportDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.import_clause) | Emitter.sf(d.module_specifier) | Emitter.sf(d.attributes)
            when d: ExportAssignment
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.type_node) | Emitter.sf(d.expression)
                if d.is_export_equals
                    set f: f | SubtreeContainsTypeScript
                return f
            }
            when d: ExportDeclaration
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.export_clause) | Emitter.sf(d.module_specifier) | Emitter.sf(d.attributes)
                if d.is_type_only
                    set f: f | SubtreeContainsTypeScript
                return f
            }
            when d: NamespaceImport
                return Emitter.sf(d.inner)
            when d: NamespaceExport
                return Emitter.sf(d.inner)
            when d: ExternalModuleReference
                return Emitter.sf(d.inner)
            when d: NamedImports
                return Emitter.sfl(d.elements)
            when d: NamedExports
                return Emitter.sfl(d.elements)
            when d: ImportAttribute
                return Emitter.sf(d.name) | Emitter.sf(d.value)
            when d: ImportAttributes
                return Emitter.sfl(d.attributes)
            when d: ConstructorDeclaration
            {
                if d.body = null
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body)
            }
            when d: GetAccessorDeclaration
                return Emitter.accessor_subtree_facts(d.modifiers, d.name, d.type_parameters, d.parameters, d.type_node, d.full_signature, d.body)
            when d: SetAccessorDeclaration
                return Emitter.accessor_subtree_facts(d.modifiers, d.name, d.type_parameters, d.parameters, d.type_node, d.full_signature, d.body)
            when d: MethodDeclaration
            {
                if d.body = null
                    return SubtreeContainsTypeScript
                let is_async (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfe(d.postfix_token) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sf(d.body) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: PropertyDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfe(d.postfix_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer) | SubtreeContainsClassFields
            when d: ClassStaticBlockDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.body) | SubtreeContainsClassFields
            when d: BinaryExpression
            {
                let op d.operator_token.kind
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.left) | Emitter.sf(d.type_node) | Emitter.sf(d.operator_token) | Emitter.sf(d.right)
                if (op = KindInKeyword) and AstNode.is_private_identifier(d.left)
                    set f: f | SubtreeContainsClassFields | SubtreeContainsPrivateIdentifierInExpression
                if op = KindEqualsToken
                {
                    let lk d.left.kind
                    if (lk = KindObjectLiteralExpression) or (lk = KindArrayLiteralExpression)
                    {
                        if Emitter.contains_object_rest_or_spread(d.left)
                            set f: f | SubtreeContainsObjectRestOrSpread
                    }
                }
                return f
            }
            when d: YieldExpression
                return Emitter.sf(d.expression) | SubtreeContainsForAwaitOrAsyncGenerator
            when d: ArrowFunction
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body)
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                    set f: f | SubtreeContainsAnyAwait
                return f
            }
            when d: FunctionExpression
            {
                let is_async (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: AsExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: SatisfiesExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: TypeAssertionExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: NonNullExpression
                return Emitter.sf(d.inner) | SubtreeContainsTypeScript
            when d: PropertyAccessExpression
            {
                var f Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sf(d.name)
                if AstNode.kind_of(d.name) <> KindIdentifier
                    set f: f | SubtreeContainsPrivateIdentifierInExpression
                return f
            }
            when d: ElementAccessExpression
                return Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sf(d.argument_expression)
            when d: CallExpression
            {
                var f Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sfel(d.type_arguments) | Emitter.sfl(d.arguments)
                if AstNode.kind_of(d.expression) = KindImportKeyword
                    set f: f | SubtreeContainsDynamicImport
                return f
            }
            when d: NewExpression
                return Emitter.sf(d.expression) | Emitter.sfel(d.type_arguments) | Emitter.sfl(d.arguments)
            when d: MetaProperty
                return Emitter.clear_facts(Emitter.sf(d.name), SubtreeContainsIdentifier)
            when d: SpreadElement
                return Emitter.sf(d.inner) | SubtreeContainsRestOrSpread
            when d: TaggedTemplateExpression
                return Emitter.sf(d.tag) | Emitter.sf(d.question_dot_token) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.template)
            when d: ArrayLiteralExpression
                return Emitter.sfl(d.elements)
            when d: ObjectLiteralExpression
                return Emitter.sfl(d.elements)
            when d: SpreadAssignment
                return Emitter.sf(d.inner) | SubtreeContainsESObjectRestOrSpread | SubtreeContainsObjectRestOrSpread
            when d: PropertyAssignment
                return Emitter.sf(d.name) | Emitter.sf(d.type_node) | Emitter.sf(d.initializer)
            when d: ShorthandPropertyAssignment
                return Emitter.sf(d.name) | Emitter.sf(d.type_node) | Emitter.sf(d.object_assignment_initializer) | SubtreeContainsTypeScript
            when d: AwaitExpression
                return Emitter.sf(d.inner) | SubtreeContainsAwait | SubtreeContainsAnyAwait | SubtreeContainsForAwaitOrAsyncGenerator
            when d: DeleteExpression
                return Emitter.sf(d.inner)
            when d: TypeOfExpression
                return Emitter.sf(d.inner)
            when d: VoidExpression
                return Emitter.sf(d.inner)
            when d: ParenthesizedExpression
                return Emitter.sf(d.inner)
            when d: PartiallyEmittedExpression
                return Emitter.sf(d.inner)
            when d: ComputedPropertyName
                return Emitter.sf(d.inner)
            when d: PrefixUnaryExpression
                return Emitter.sf(d.operand)
            when d: PostfixUnaryExpression
                return Emitter.sf(d.operand)
            when d: ConditionalExpression
                return Emitter.sf(d.condition) | Emitter.sf(d.question_token) | Emitter.sf(d.when_true) | Emitter.sf(d.colon_token) | Emitter.sf(d.when_false)
            when d: TemplateExpression
                return Emitter.sf(d.head) | Emitter.sfl(d.template_spans)
            when d: TemplateSpan
                return Emitter.sf(d.expression) | Emitter.sf(d.literal)
            when d: ExpressionWithTypeArguments
                return Emitter.sf(d.expression) | Emitter.sfel(d.type_arguments)
            when d: QualifiedName
                return Emitter.sf(d.left) | Emitter.sf(d.right)
            when d: SyntheticReferenceExpression
                return Emitter.sf(d.expression) | Emitter.sf(d.this_arg)
            when d: Decorator
                return Emitter.sf(d.inner) | SubtreeContainsTypeScript | SubtreeContainsDecorators
            when d: JsxElement
                return Emitter.sf(d.opening_element) | Emitter.sfl(d.children) | Emitter.sf(d.closing_element) | SubtreeContainsJsx
            when d: JsxAttributes
                return Emitter.sfl(d.elements) | SubtreeContainsJsx
            when d: JsxNamespacedName
                return Emitter.sf(d.namespace_name) | Emitter.sf(d.name) | SubtreeContainsJsx
            when d: JsxOpeningElement
                return Emitter.sf(d.tag_name) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.attributes) | SubtreeContainsJsx
            when d: JsxSelfClosingElement
                return Emitter.sf(d.tag_name) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.attributes) | SubtreeContainsJsx
            when d: JsxFragment
                return Emitter.sfl(d.children) | SubtreeContainsJsx
            when d: JsxAttribute
                return Emitter.sf(d.name) | Emitter.sf(d.initializer) | SubtreeContainsJsx
            when d: JsxSpreadAttribute
                return Emitter.sf(d.inner) | SubtreeContainsJsx
            when d: JsxClosingElement
                return Emitter.sf(d.inner) | SubtreeContainsJsx
            when d: JsxExpression
                return Emitter.sf(d.expression) | SubtreeContainsJsx
            when d: JsxText
                return SubtreeContainsJsx
            else
                return SubtreeFactsNone
        SubtreeFactsNone
    }

    ; ClassLikeBase.computeSubtreeFacts
    function class_like_subtree_facts(n: ref[AstNode], modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode]?, type_parameters: ref[Array[ref[AstNode]?]]?, heritage_clauses: ref[Array[ref[AstNode]?]]?, members: ref[Array[ref[AstNode]?]]?) returns int
    {
        if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
            return SubtreeContainsTypeScript
        Emitter.sfl(modifiers) | Emitter.sf(name) | Emitter.sfel(type_parameters) | Emitter.sfl(heritage_clauses) | Emitter.sfl(members)
    }

    ; AccessorDeclarationBase.computeSubtreeFacts
    function accessor_subtree_facts(modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode]?, type_parameters: ref[Array[ref[AstNode]?]]?, parameters: ref[Array[ref[AstNode]?]]?, type_node: ref[AstNode]?, full_signature: ref[AstNode]?, body: ref[AstNode]?) returns int
    {
        if body = null
            return SubtreeContainsTypeScript
        Emitter.sfl(modifiers) | Emitter.sf(name) | Emitter.sfel(type_parameters) | Emitter.sfl(parameters) | Emitter.sfe(type_node) | Emitter.sfe(full_signature) | Emitter.sf(body)
    }

    ; ── ast/utilities.go: the binding-pattern questions the facts ask ──

    ; IsAssignmentPattern
    function is_assignment_pattern(n: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(n)
        (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression)
    }

    ; GetElementsOfBindingOrAssignmentPattern
    function elements_of_binding_or_assignment_pattern(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let k n.kind
        if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern) or (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression)
            return Emitter.pattern_elements_of(n)
        null
    }

    ; the ElementListData arms a binding or assignment pattern can be
    function pattern_elements_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when d: ObjectBindingPattern
                return d.elements
            when d: ArrayBindingPattern
                return d.elements
            when d: ArrayLiteralExpression
                return d.elements
            when d: ObjectLiteralExpression
                return d.elements
        null
    }

    ; IsDeclarationBindingElement
    function is_declaration_binding_element(n: ref[AstNode]) returns bool
    {
        let k n.kind
        (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement)
    }

    ; IsObjectLiteralElement
    function is_object_literal_element(n: ref[AstNode]) returns bool
    {
        let k n.kind
        (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment) or (k = KindSpreadAssignment) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
    }

    ; GetTargetOfBindingOrAssignmentElement
    function target_of_binding_or_assignment_element(n: ref[AstNode]?) returns ref[AstNode]?
    {
        if n = null
            return null
        let e n as ref[AstNode]
        if Emitter.is_declaration_binding_element(e)
            return Printer.declaration_name_of(e)
        if Emitter.is_object_literal_element(e)
        {
            let k e.kind
            if k = KindPropertyAssignment
                return Emitter.target_of_binding_or_assignment_element(AstNode.initializer_of(e))
            if k = KindShorthandPropertyAssignment
                return Printer.declaration_name_of(e)
            if k = KindSpreadAssignment
                return Emitter.target_of_binding_or_assignment_element(Printer.wrapped_inner_of(e))
            return null
        }
        if Emitter.is_assignment_expression(e, true)
            return Emitter.target_of_binding_or_assignment_element(AstNode.binary_left_of(e))
        if e.kind = KindSpreadElement
            return Emitter.target_of_binding_or_assignment_element(Printer.wrapped_inner_of(e))
        e
    }

    ; IsAssignmentExpression(node, excludeCompoundAssignment)
    function is_assignment_expression(n: ref[AstNode], exclude_compound: bool) returns bool
    {
        if n.kind <> KindBinaryExpression
            return false
        let op AstNode.kind_of(AstNode.binary_operator_token_of(n))
        if exclude_compound
        {
            if op <> KindEqualsToken
                return false
        }
        if exclude_compound = false
        {
            if Parser.is_assignment_operator(op) = false
                return false
        }
        Parser.is_left_hand_side_expression_kind(AstNode.kind_of(AstNode.binary_left_of(n)))
    }

    ; ContainsObjectRestOrSpread
    function contains_object_rest_or_spread(n: ref[AstNode]) returns bool
    {
        if (Emitter.subtree_facts(n) & SubtreeContainsObjectRestOrSpread) <> 0
            return true
        if (Emitter.subtree_facts(n) & SubtreeContainsESObjectRestOrSpread) <> 0
        {
            ; check for nested spread assignments, otherwise '{ x: { a, ...b } = foo } = c'
            ; will not be correctly interpreted by the rest/spread transformer
            let elements Emitter.elements_of_binding_or_assignment_pattern(n)
            if elements = null
                return false
            let l elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (l.get_length() as int)
            {
                let target Emitter.target_of_binding_or_assignment_element(l[i as size_t])
                set i: i + 1
                if target = null
                    continue
                let t target as ref[AstNode]
                if Emitter.is_assignment_pattern(t) = false
                    continue
                if (Emitter.subtree_facts(t) & SubtreeContainsObjectRestOrSpread) <> 0
                    return true
                if (Emitter.subtree_facts(t) & SubtreeContainsESObjectRestOrSpread) <> 0
                {
                    if Emitter.contains_object_rest_or_spread(t)
                        return true
                }
            }
        }
        false
    }

    ; internal/vfs/internal/internal.go decodeBytes + decodeUtf16: the compiler
    ; host reads a source file THROUGH this — a UTF-16 file (either byte order
    ; mark) is transcoded to UTF-8 and a UTF-8 mark is dropped — while the
    ; yardstick oracles read the raw bytes (os.ReadFile). The emit baseline is
    ; the decoded file's, so the emit path decodes and the other six do not;
    ; tscaly_dump re-parses the decoded text for the emit alone. Answers true
    ; when `out` holds a DIFFERENT text than `text` (a mark was found).
    function decode_bytes(text: Slice[char], out: ref[StringBuilder]) returns bool
    {
        let n text.length
        if n >= 2
        {
            let b0 text[0] as int
            let b1 text[1] as int
            if (b0 = 0xFF) and (b1 = 0xFE)
            {
                Emitter.decode_utf16(text, 2, true, out)
                return true
            }
            if (b0 = 0xFE) and (b1 = 0xFF)
            {
                Emitter.decode_utf16(text, 2, false, out)
                return true
            }
        }
        if n >= 3
        {
            if ((text[0] as int) = 0xEF) and ((text[1] as int) = 0xBB) and ((text[2] as int) = 0xBF)
            {
                out.append(text.data + 3, (n - 3) as size_t)
                return true
            }
        }
        false
    }

    ; decodeUtf16: the code units in the given byte order (an odd trailing byte
    ; is dropped, as binary.Read's len/2 does), unicode/utf16.Decode's pairing
    ; (an unpaired surrogate becomes U+FFFD), then UTF-8.
    function decode_utf16(text: Slice[char], start: int, little_endian: bool, out: ref[StringBuilder])
    {
        let units (text.length - start) / 2
        var i 0
        while i < units
        {
            var u Emitter.utf16_unit_at(text, start + i * 2, little_endian)
            set i: i + 1
            var cp u
            if (u >= 0xD800) and (u < 0xDC00)
            {
                set cp: 0xFFFD
                if i < units
                {
                    let lo Emitter.utf16_unit_at(text, start + i * 2, little_endian)
                    if (lo >= 0xDC00) and (lo < 0xE000)
                    {
                        set cp: 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00)
                        set i: i + 1
                    }
                }
            }
            if (u >= 0xDC00) and (u < 0xE000)
                set cp: 0xFFFD
            Emitter.append_utf8(out, cp)
        }
    }

    function utf16_unit_at(text: Slice[char], at: int, little_endian: bool) returns int
    {
        let a text[at] as int
        let b text[at + 1] as int
        if little_endian
            return (a & 0xFF) | ((b & 0xFF) << 8)
        ((a & 0xFF) << 8) | (b & 0xFF)
    }

    function append_utf8(out: ref[StringBuilder], cp: int)
    {
        if cp < 0x80
        {
            out.append(cp as char)
            return
        }
        if cp < 0x800
        {
            out.append((0xC0 | (cp >> 6)) as char)
            out.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        if cp < 0x10000
        {
            out.append((0xE0 | (cp >> 12)) as char)
            out.append((0x80 | ((cp >> 6) & 0x3F)) as char)
            out.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        out.append((0xF0 | (cp >> 18)) as char)
        out.append((0x80 | ((cp >> 12) & 0x3F)) as char)
        out.append((0x80 | ((cp >> 6) & 0x3F)) as char)
        out.append((0x80 | (cp & 0x3F)) as char)
    }

    function is_file_forced_to_be_module_by_format(file_name: Slice[char], options: EmitOptions) returns bool
    {
        if options.get_emit_module_format_of_file(file_name) = ModuleKindESNext
            return true
        file_name.ends_with(".mts") or file_name.ends_with(".mjs")
    }

    ; the file's identifier table (sourceFile.Identifiers): every Identifier and
    ; PrivateIdentifier text in the tree, once
    function collect_identifiers(host: ref[Page], node: ref[AstNode], out: ref[Array[Slice[char]]])
    {
        let k node.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
        {
            let text AstNode.identifier_text_of(node)
            if NameGenerator.names_contain(out, text) = false
                out.add(text)
        }
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            Emitter.collect_identifiers(host, child as ref[AstNode], out)
            set i: i + 1
        }
    }

    procedure scan(this, node: ref[AstNode], checker: ref[Checker], facts: ref[EmitFacts])
    {
        let k node.kind
        if (k = KindImportDeclaration) or (k = KindExportDeclaration) or (k = KindExportAssignment) or (k = KindNamespaceExportDeclaration) or (k = KindImportEqualsDeclaration)
            set facts.has_import_or_export: true
        if k = KindEnumDeclaration
            set facts.has_runtime_syntax: true
        ; an INTERNAL `import x = N.M` (an entity-name reference) is rewritten to
        ; `var x = N.M` by runtimesyntax.go's visitImportEqualsDeclaration
        if k = KindImportEqualsDeclaration
        {
            if AstNode.kind_of(AstNode.module_reference_of(node)) <> KindExternalModuleReference
                set facts.has_runtime_syntax: true
        }
        if k = KindModuleDeclaration
        {
            ; the eraser drops a non-instantiated one itself; an instantiated one
            ; is the runtime-syntax transformer's
            if checker.is_instantiated_module(node)
                set facts.has_runtime_syntax: true
        }
        if k = KindParameter
        {
            if Transformer.is_parameter_property_declaration(node, node.parent)
                set facts.has_runtime_syntax: true
        }
        if k = KindDecorator
            set facts.has_decorator: true
        if k = KindVariableDeclarationList
        {
            if (node.flags & NodeFlagsUsing) <> 0
                set facts.has_using: true
        }
        if k = KindAccessorKeyword
            set facts.has_auto_accessor: true
        if k = KindCallExpression
        {
            if Parser.is_import_call(node)
                set facts.has_dynamic_import: true
        }
        if k = KindMetaProperty
        {
            if AstNode.meta_property_keyword_token_of(node) = KindImportKeyword
                set facts.has_dynamic_import: true
        }
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            this.scan(child as ref[AstNode], checker, facts)
            set i: i + 1
        }
    }

    ; emitJSFile for one file under the default options: the transformers in
    ; getScriptTransformers' order, then the printer. The JS text is APPENDED to
    ; `out`, the caller's builder; a said stop leaves `unported_count` > 0 and
    ; appends nothing. ★Neither a returned nor a stored String survives this
    ; routine: `to_string()` constructs on the CALLER page, which for a call
    ; made here is this routine's own region — gone with the return, and the
    ; text read back as garbage three units in (root CLAUDE.md, the out-param
    ; class). The bytes are copied out while the region lives.
    procedure emit_js(this, file: ref[AstNode], info: ref[SourceFileInfo], options: EmitOptions, checker: ref[Checker], binder: ref[Binder], out: ref[StringBuilder])
    {
        ; sourceFileMayBeEmitted: no JS for a declaration file, nor for JSON
        ; without an outDir
        if info.is_declaration_file
            return
        if info.script_kind = ScriptKindJSON
            return
        ; a JavaScript file is not in the program without allowJs (the yardstick's
        ; default options), so the reference emits nothing for it: 158 `.js`,
        ; 4 `.jsx` and 2 `.cjs` units of the corpus, every reference answer empty
        if (info.script_kind = ScriptKindJS) or (info.script_kind = ScriptKindJSX)
            return
        var facts EmitFacts(false, false, false, false, false, false)
        this.scan(file, checker, &facts)
        ; getScriptTransformers, each gate a transformer not yet ported
        let import_elision_enabled (options.verbatim_module_syntax <> TristateTrue) and ((file.flags & NodeFlagsJavaScriptFile) = 0)
        if options.experimental_decorators = TristateTrue
            this.record_unported("transform-legacy-decorators", 0)
        if options.get_jsx_transform_enabled()
            this.record_unported("transform-jsx", 0)
        ; estransforms.GetESTransformer at the default target: using, ES decorators, class fields
        let target options.get_emit_script_target()
        if target < ScriptTargetES2021
            this.record_unported("transform-es-downlevel", target)
        if facts.has_decorator and (target < ScriptTargetLatest)
            this.record_unported("transform-es-decorators", 0)
        if facts.has_auto_accessor and (target < ScriptTargetLatest)
            this.record_unported("transform-class-fields", 0)
        let module_kind options.get_emit_module_kind()
        let format options.get_emit_module_format_of_file(info.file_name)
        if module_kind = ModuleKindPreserve
            this.record_unported("transform-module-preserve", 0)
        else
        {
            if (module_kind >= ModuleKindES2015) and (module_kind <= ModuleKindNodeNext) and (module_kind <> ModuleKindSystem)
            {
                ; the implied module transformer: ESM by format, else CommonJS
                if format < ModuleKindES2015
                    this.record_unported("transform-commonjs", format)
            }
            else
                this.record_unported("transform-commonjs", module_kind)
        }
        if facts.has_dynamic_import and (format < ModuleKindES2015)
            this.record_unported("transform-commonjs", format)
        if unported_count > 0
            return
        let context EmitContext.create(host, AstNode.list_ranges_of(file))
        let opts TransformOptions(context, options, checker, binder, info)
        var current file
        let eraser Transformer.create(host, TransformerTagTypeEraser, opts)
        set current: eraser.transform_source_file(current)
        let elision Transformer.create(host, TransformerTagImportElision, opts)
        if import_elision_enabled
            set current: elision.transform_source_file(current)
        ; transform `enum`, `namespace`, and parameter properties
        let runtime Transformer.create(host, TransformerTagRuntimeSyntax, opts)
        set current: runtime.transform_source_file(current)
        ; estransforms.GetESTransformer at ES2025 (NewESNextTransformer): `using`
        ; first, then ES decorators and class fields (their gates stand above)
        let using_tx Transformer.create(host, TransformerTagUsing, opts)
        set current: using_tx.transform_source_file(current)
        let use_strict Transformer.create(host, TransformerTagUseStrict, opts)
        set current: use_strict.transform_source_file(current)
        let es_module Transformer.create(host, TransformerTagESModule, opts)
        set current: es_module.transform_source_file(current)
        ; inlining (formerly done via substitutions)
        let inliner Transformer.create(host, TransformerTagConstEnumInlining, opts)
        if options.get_isolated_modules() = false
            set current: inliner.transform_source_file(current)
        if eraser.unported_count > 0
            this.record_unported(eraser.unported_tag, eraser.unported_detail)
        if elision.unported_count > 0
            this.record_unported(elision.unported_tag, elision.unported_detail)
        if runtime.unported_count > 0
            this.record_unported(runtime.unported_tag, runtime.unported_detail)
        if using_tx.unported_count > 0
            this.record_unported(using_tx.unported_tag, using_tx.unported_detail)
        if use_strict.unported_count > 0
            this.record_unported(use_strict.unported_tag, use_strict.unported_detail)
        if es_module.unported_count > 0
            this.record_unported(es_module.unported_tag, es_module.unported_detail)
        if inliner.unported_count > 0
            this.record_unported(inliner.unported_tag, inliner.unported_detail)
        if unported_count > 0
            return
        ; the printer, over the TRANSFORMED file (its record's node is the one it prints)
        set info.node: current
        let printer_options PrinterOptions(options.remove_comments, options.new_line, options.no_emit_helpers, options.target, false, false, false, false, false, false, false, false)
        let printer Printer.create(host, printer_options, context)
        let writer TextWriter.create(host, printer_options.new_line_character(), 0)
        printer.write_node(current, info, writer, null)
        ; printSourceFile: no source maps, so a line, then the text
        writer.write_line()
        if printer.unported_count > 0
        {
            this.record_unported(printer.unported_tag, printer.unported_detail)
            return
        }
        let text writer.to_string()
        out.append(text.get_buffer(), text.get_length())
    }
}
