            return Transformer.dt_select_by_module_name(result, DiagPublic_static_method_0_of_exported_class_has_or_is_using_name_1_from_external_module_2_but_cannot_be_named, DiagPublic_static_method_0_of_exported_class_has_or_is_using_name_1_from_private_module_2, DiagPublic_static_method_0_of_exported_class_has_or_is_using_private_name_1)
