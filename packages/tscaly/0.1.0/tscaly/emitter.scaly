                        set code: DiagX_extends_clause_of_exported_class_0_has_or_is_using_private_name_1
                    else
                        set code: DiagX_extends_clause_of_exported_class_has_or_is_using_private_name_0
                }
            }
            return DtDiagnostic(node, code, Printer.declaration_name_of(owner))
        }
        if k = KindImportEqualsDeclaration
            return DtDiagnostic(node, DiagImport_declaration_0_is_using_private_name_1, simple_name)
        if (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration)
            return DtDiagnostic(AstNode.type_of(node), Transformer.dt_select_by_module_name_no_name_check(result, DiagExported_type_alias_0_has_or_is_using_private_name_1_from_module_2, DiagExported_type_alias_0_has_or_is_using_private_name_1), AstNode.name_of(node))
        if k = KindCallExpression
        {
            ; a JS Object.defineProperty call
            let args AstNode.call_arguments_of(node)
