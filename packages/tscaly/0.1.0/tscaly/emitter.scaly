    ; ast.ReplaceModifiers: the node with another modifier list — a factory
    ; update for the statement kinds, a clone with the slot rewritten for a
    ; class member (AstNode.set_modifiers covers those); anything else stands
    procedure dt_replace_modifiers(mutable this, mutable node: ref[AstNode], mutable modifiers: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]
    {
        let f factory
        choose node.data
            when d: VariableStatement
                return f.update_variable_statement(node, modifiers, d.declaration_list)
            when d: FunctionDeclaration
                return f.update_function_declaration(node, modifiers, d.asterisk_token, d.name, d.type_parameters, d.parameters, d.type_node, d.full_signature, d.body)
            when d: ClassDeclaration
                return f.update_class_declaration(node, modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: ClassExpression
                return f.update_class_expression(node, modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: InterfaceDeclaration
                return f.update_interface_declaration(node, modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: TypeAliasDeclaration
                return f.update_type_alias_declaration(node, modifiers, d.name, d.type_parameters, d.type_node)
            when d: JSTypeAliasDeclaration
                return f.update_type_alias_declaration(node, modifiers, d.name, d.type_parameters, d.type_node)
            when d: EnumDeclaration
                return f.update_enum_declaration(node, modifiers, d.name, d.members)
            when d: ModuleDeclaration
                return f.update_module_declaration(node, modifiers, d.keyword, d.name, d.body)
            when d: ImportEqualsDeclaration
                return f.update_import_equals_declaration(node, modifiers, d.is_type_only, d.name, d.module_reference)
            when d: ImportDeclaration
                return f.update_import_declaration(node, modifiers, d.import_clause, d.module_specifier, d.attributes)
            when d: ExportAssignment
                return f.update_export_assignment(node, modifiers, d.is_export_equals, d.type_node, d.expression)
            when d: ExportDeclaration
                return f.update_export_declaration(node, modifiers, d.is_type_only, d.export_clause, d.module_specifier, d.attributes)
            when d: Parameter
                return f.update_parameter_declaration(node, modifiers, d.dot_dot_dot_token, d.name, d.question_token, d.type_node, d.initializer)
            when d: TypeParameter
                return f.update_type_parameter_declaration(node, modifiers, d.name, d.constraint, d.expression, d.default_type)
        let k node.kind
        var member false
        if k = KindPropertyDeclaration
            set member: true
        if k = KindPropertySignature
            set member: true
        if k = KindMethodDeclaration
            set member: true
        if k = KindMethodSignature
            set member: true
        if k = KindConstructor
            set member: true
        if k = KindGetAccessor
            set member: true
        if k = KindSetAccessor
            set member: true
        if k = KindIndexSignature
            set member: true
        if member
        {
            let c f.clone(node)
            if modifiers <> null
                AstNode.set_modifiers(c, modifiers as ref[Array[ref[AstNode]?]])
            else
                AstNode.set_modifiers(c, &Array[ref[AstNode]?]^host())
            return c
        }
        node
    }

    ; ── util.go ──────────────────────────────────────────────────────────────

    ; needsScopeMarker: a statement that is neither an import/re-export, an
    ; export assignment, exported, nor an ambient module
    function dt_needs_scope_marker(this, result: ref[AstNode]) returns bool
    {
        let k result.kind
        if (k = KindImportDeclaration) or (k = KindJSImportDeclaration) or (k = KindImportEqualsDeclaration) or (k = KindExportDeclaration)
            return false
        if k = KindExportAssignment
            return false
        if Transformer.has_syntactic_modifier(result, ModifierFlagsExport)
            return false
        Binder.is_ambient_module(result) = false
    }

    function dt_can_produce_diagnostics(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if k = KindVariableDeclaration
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindPropertySignature
            return true
        if k = KindBindingElement
            return true
        if k = KindSetAccessor
            return true
        if k = KindGetAccessor
            return true
        if k = KindConstructSignature
            return true
        if k = KindCallSignature
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindFunctionDeclaration
            return true
        if k = KindParameter
            return true
        if k = KindTypeParameter
            return true
        if k = KindExpressionWithTypeArguments
            return true
        if k = KindImportEqualsDeclaration
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        if k = KindConstructor
            return true
        if k = KindIndexSignature
            return true
        if k = KindPropertyAccessExpression
            return true
        if k = KindElementAccessExpression
            return true
        if k = KindBinaryExpression
            return true
        k = KindCallExpression
    }

    ; canReuseModifierNodes: a reparsed modifier is not reused
    function dt_can_reuse_modifier_nodes(nodes: ref[Array[ref[AstNode]?]]) returns bool
    {
        var i 0
        while i < (nodes.get_length() as int)
        {
            let n nodes[i as size_t]
            if n <> null
            {
                let m n as ref[AstNode]
                if Printer.is_modifier_kind(m.kind) and ((m.flags & NodeFlagsReparsed) <> 0)
                    return false
            }
            set i: i + 1
        }
        true
    }

    procedure dt_is_declaration_and_not_visible(mutable this, mutable node_in: ref[AstNode]) returns bool
    {
        let pn context.parse_node(node_in)
        if pn = null
            return false
        let node pn as ref[AstNode]
        let k node.kind
        var checked false
        if k = KindFunctionDeclaration
            set checked: true
        if k = KindModuleDeclaration
            set checked: true
        if k = KindInterfaceDeclaration
            set checked: true
        if k = KindClassDeclaration
            set checked: true
        if k = KindTypeAliasDeclaration
            set checked: true
        if k = KindJSTypeAliasDeclaration
            set checked: true
        if k = KindEnumDeclaration
            set checked: true
        if checked
            return this.the_checker().is_declaration_visible(node) = false
        ; the following do their own visibility checks by filtering their members
        if k = KindVariableDeclaration
            return this.dt_get_binding_name_visible(node) = false
        if (k = KindImportEqualsDeclaration) or (k = KindImportDeclaration) or (k = KindJSImportDeclaration) or (k = KindExportDeclaration) or (k = KindExportAssignment)
            return false
        if k = KindClassStaticBlockDeclaration
            return true
        false
    }

    ; getBindingNameVisible: a pattern is visible when any element is (usually
    ; painted by collect linked aliases)
    procedure dt_get_binding_name_visible(mutable this, mutable elem: ref[AstNode]) returns bool
    {
        if elem.kind = KindOmittedExpression
            return false
        let name AstNode.name_of(elem)
        if name = null
            return false
        if AstNode.is_binding_pattern(name)
        {
            let elements AstNode.elements_of(name)
            if elements = null
                return false
            let el elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (el.get_length() as int)
            {
                let e el[i as size_t]
                if e <> null
                {
                    if this.dt_get_binding_name_visible(e as ref[AstNode])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        this.the_checker().is_declaration_visible(elem)
    }

    function dt_is_enclosing_declaration(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if k = KindSourceFile
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindJSTypeAliasDeclaration
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindClassDeclaration
            return true
        if k = KindInterfaceDeclaration
            return true
        if AstNode.is_function_like(node)
            return true
        if k = KindIndexSignature
            return true
        if k = KindMappedType
            return true
        k = KindVariableDeclaration
    }

    function dt_unwrap_parenthesized_expression(o: ref[AstNode]) returns ref[AstNode]
    {
        var n o
        while n.kind = KindParenthesizedExpression
            set n: AstNode.expression_of(n) as ref[AstNode]
        n
    }

    function dt_is_private_method_type_parameter(this, node: ref[AstNode]) returns bool
    {
        let parent AstNode.parent_node_of(node)
        if AstNode.kind_of(parent) <> KindMethodDeclaration
            return false
        this.the_checker().get_effective_declaration_flags(parent as ref[AstNode], ModifierFlagsPrivate) <> 0
    }

    ; shouldEmitFunctionProperties: expando properties are emitted when any
    ; overload in the symbol has a body
    function dt_should_emit_function_properties(input: ref[AstNode]) returns bool
    {
        if AstNode.body_of(input) <> null
            return true
        let symbol AstNode.symbol_of(input)
        if symbol = null
            return false
        let s symbol as ref[Symbol]
        let n Symbol.declaration_count(s)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(s, i)
            if d <> null
            {
                if AstNode.kind_of(d) = KindFunctionDeclaration
                {
                    if AstNode.body_of(d) <> null
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    function dt_has_scope_marker(statements: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if statements = null
            return false
        let list statements as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            let s list[i as size_t]
            if s <> null
            {
                let k AstNode.kind_of(s)
                if (k = KindExportAssignment) or (k = KindExportDeclaration)
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; ast.IsPrimitiveLiteralValue
    function dt_is_primitive_literal_value(node: ref[AstNode], include_big_int: bool) returns bool
    {
        let k node.kind
        if (k = KindTrueKeyword) or (k = KindFalseKeyword) or (k = KindNumericLiteral) or (k = KindStringLiteral) or (k = KindNoSubstitutionTemplateLiteral)
            return true
        if k = KindBigIntLiteral
            return include_big_int
        if k = KindPrefixUnaryExpression
        {
            let op AstNode.prefix_unary_operator_kind(node)
            let operand_kind AstNode.kind_of(AstNode.prefix_unary_operand_of(node))
            if op = KindMinusToken
            {
                if operand_kind = KindNumericLiteral
                    return true
                return include_big_int and (operand_kind = KindBigIntLiteral)
            }
            if op = KindPlusToken
                return operand_kind = KindNumericLiteral
        }
        false
    }

    ; ast.IsLiteralImportTypeNode: `import("m")` with a string literal argument
    function dt_is_literal_import_type_node(node: ref[AstNode]) returns bool
    {
        if node.kind <> KindImportType
            return false
        choose node.data
            when it: ImportType
            {
                if it.argument.kind <> KindLiteralType
                    return false
                return AstNode.kind_of(AstNode.literal_type_inner_of(it.argument)) = KindStringLiteral
            }
        false
    }

    function dt_get_leftmost_access_expression(expr: ref[AstNode]) returns ref[AstNode]
    {
        var e expr
        while Parser.is_access_expression(e)
            set e: AstNode.expression_of(e) as ref[AstNode]
        e
    }

    ; IsNonContextualKeyword: a keyword that is not contextual
    ; (KindFirstContextualKeyword = abstract … KindLastContextualKeyword = defer)
    function dt_is_non_contextual_keyword(k: int) returns bool
    {
        if k < KindFirstKeyword
            return false
        if k > KindLastKeyword
            return false
        k < KindAbstractKeyword
    }

    function dt_can_have_modifiers(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if k = KindTypeParameter
            return true
        if k = KindParameter
            return true
        if k = KindPropertySignature
            return true
        if k = KindPropertyDeclaration
            return true
        if k = KindMethodSignature
            return true
        if k = KindMethodDeclaration
            return true
        if k = KindConstructor
            return true
        if k = KindGetAccessor
            return true
        if k = KindSetAccessor
            return true
        if k = KindIndexSignature
            return true
        if k = KindConstructorType
            return true
        if k = KindFunctionExpression
            return true
        if k = KindArrowFunction
            return true
        if k = KindClassExpression
            return true
        if k = KindVariableStatement
            return true
        if k = KindFunctionDeclaration
            return true
        if k = KindClassDeclaration
            return true
        if k = KindInterfaceDeclaration
            return true
        if k = KindTypeAliasDeclaration
            return true
        if k = KindEnumDeclaration
            return true
        if k = KindModuleDeclaration
            return true
        if k = KindImportEqualsDeclaration
            return true
        if k = KindImportDeclaration
            return true
        if k = KindJSImportDeclaration
            return true
        if k = KindExportAssignment
            return true
        k = KindExportDeclaration
    }

    ; shouldStripInternal: a node whose leading comment carries `@internal`, under
    ; stripInternal
    procedure dt_should_strip_internal(mutable this, node: ref[AstNode]?) returns bool
    {
        if dt_strip_internal = false
            return false
        if node = null
            return false
        this.dt_is_internal_declaration(node as ref[AstNode])
    }

    procedure dt_is_internal_declaration(mutable this, node: ref[AstNode]) returns bool
    {
        let original context.most_original(node)
        if original = null
            return false
        let parse_tree_node original as ref[AstNode]
        if (parse_tree_node.flags & NodeFlagsSynthesized) <> 0
            return false
        let text opts.file_info.text
        if parse_tree_node.kind = KindParameter
        {
            ; `... parameters, /** @internal */ public param: string` — the
            ; trailing comments after the previous parameter and this one's leading
            let params AstNode.parameters_of(AstNode.parent_node_of(parse_tree_node))
            var previous_sibling: ref[AstNode]? null
            if params <> null
            {
                let pl params as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (pl.get_length() as int)
                {
                    let p pl[i as size_t]
                    if p <> null
                    {
                        if (p as ref[AstNode]) = parse_tree_node
                        {
                            if i > 0
                                set previous_sibling: pl[(i - 1) as size_t]
                        }
                    }
                    set i: i + 1
                }
            }
            var last_pos 0 - 1
            var last_end 0
            if previous_sibling <> null
            {
                let ps previous_sibling as ref[AstNode]
                let trailing_pos Scanner.skip_trivia_ex(text, ps.end + 1, false, true, false)
                let trailing Scanner.get_trailing_comment_ranges(host, text, trailing_pos)
                var ti 0
                while ti < (trailing.get_length() as int)
                {
                    let c trailing[ti as size_t]
                    set last_pos: c.pos
                    set last_end: c.end
                    set ti: ti + 1
                }
                let leading Scanner.get_leading_comment_ranges(host, text, node.pos)
                var li 0
                while li < (leading.get_length() as int)
                {
                    let c leading[li as size_t]
                    set last_pos: c.pos
                    set last_end: c.end
                    set li: li + 1
                }
            }
            else
            {
                let trailing_pos Scanner.skip_trivia_ex(text, node.pos, false, true, false)
                let trailing Scanner.get_trailing_comment_ranges(host, text, trailing_pos)
                var ti 0
                while ti < (trailing.get_length() as int)
                {
                    let c trailing[ti as size_t]
                    set last_pos: c.pos
                    set last_end: c.end
                    set ti: ti + 1
                }
            }
            if last_pos >= 0
                return Transformer.dt_has_internal_annotation(text, last_pos, last_end)
            return false
        }
        if parse_tree_node.kind = KindJsxText
            return false
        let leading Scanner.get_leading_comment_ranges(host, text, parse_tree_node.pos)
        var li 0
        while li < (leading.get_length() as int)
        {
            let c leading[li as size_t]
            if Transformer.dt_has_internal_annotation(text, c.pos, c.end)
                return true
            set li: li + 1
        }
        false
    }

    function dt_has_internal_annotation(text: Slice[char], pos: int, end: int) returns bool
    {
        let comment text.subslice(pos as size_t, end as size_t)
        Transformer.dt_slice_contains(comment, "@internal")
    }

    function dt_slice_contains(text: Slice[char], needle: Slice[char]) returns bool
    {
        if needle.length > text.length
            return false
        var i 0
        while i <= (text.length - needle.length)
        {
            if text.subslice(i as size_t, (i + needle.length) as size_t).equals(needle)
                return true
            set i: i + 1
        }
        false
    }

    ; transformers.IsOriginalNodeSingleLine: the most-original node starts and
    ; ends on one line of its file
    function dt_is_original_node_single_line(this, node: ref[AstNode]) returns bool
    {
        let original context.most_original(node)
        if original = null
            return false
        let o original as ref[AstNode]
        if o.pos < 0
            return false
        let starts opts.file_info.line_starts
        Scanner.compute_line_of_position(starts, o.pos) = Scanner.compute_line_of_position(starts, o.end)
    }
}

; transformers/destructuring.go's flattener: the state of one flattening, with
; the two MODES (assignment / binding) as a flag where the reference installs
; four callbacks, and the assignment callback as a tag the transformer dispatches
; (`Transformer.flatten_create_assignment`).

; ══════════════════════════════════════════════════════════════════════════════
; ── THE NODE BUILDER (slice 251) ─────────────────────────────────────────────
;
; checker/nodebuilderimpl.go, nodecopy.go, nodebuilderscopes.go, symboltracker.go
; and the entry points of checker/nodebuilder.go — the part of the checker that
; turns a TYPE back into a type NODE, which is what the declaration transformer
; asks for every declaration whose type it must infer. It lives in the emitter
; module rather than in the checker for a reason of ORDER: it constructs nodes
; through the factory, which is declared after the checker, and it reports to
; the declaration transformer's tracker (`dt_track_symbol` and its siblings),
; which is this file's own Transformer. The checker keeps its STRING printer
; (type_to_string_worker) untouched: the checker yardstick reads that one.
;
; ★★★ THE TRACKER IS A LAYER, NOT AN INTERFACE. Upstream wraps the transformer's
; tracker in a SymbolTrackerImpl (which records tracked symbols on the context
; and marks `reportedDiagnostic`) and, inside nodecopy's RECOVERY BOUNDARY, in a
; second wrapper that DEFERS every report and records every tracked symbol so a
; failed reuse can discard the symbols and still deliver the reports. Here that
; is a STACK of boundaries on the builder: a report at depth n is pushed into
; boundary n, a finalize at depth n delivers the deferred reports one level
; down (to boundary n-1, or to the transformer at depth 0) and replays the
; tracked symbols only when nothing failed — the same order of events the
; nested wrappers produce.
;
; ★★ THE PSEUDOCHECKER IS THE NEXT CHAPTER, AND ITS DIRECT HALF IS HERE. Corsa
; reuses an existing type node through a syntactic "pseudo type": an ANNOTATION
; (`PseudoTypeDirect`) is reused when its type is the checker's, and an
; initializer EXPRESSION is inferred syntactically (`PseudoTypeInferred` and the
; structural kinds). The Direct half — the annotation of a declaration, an
; accessor pair or a signature's return type — is ported here, because it is
; what makes `Array<string>` survive as `Array<string>`; the expression half
; (internal/pseudochecker, 1 100 lines) falls back to the checker's type, which
; prints the same node in every case but a reused annotation INSIDE the
; expression. That is a measured deviation, not a stop.
;
; ★ Two said stops: a module SPECIFIER (`import("./x").T`) needs the
; modulespecifiers package (2 300 lines, its own chapter), and a symbol chain
; through two module parents needs its ordering by specifier — both report
; `node-builder-module-specifier`.

define NbTrackedSymbol ( symbol: ref[Symbol]  enclosing: ref[AstNode]?  meaning: int )
define NbDeferredReport ( kind: int  text: Slice[char]  text2: Slice[char] )
define NbSymbolDepth ( is_constructor: bool  symbol: ref[Symbol]?  node: ref[AstNode]?  depth: int )
define NbTypeParamName ( type_id: int  name: ref[AstNode] )
define NbNameCount ( text: Slice[char]  count: int )
define NbSymbolType ( symbol: ref[Symbol]  t: ref[Type]? )
define NbFakeScope ( node: ref[AstNode]  kind: int )
define NbLocalsUndo ( name: Slice[char]  old_symbol: ref[Symbol]? )
define NbSeenName ( text: Slice[char]  t: ref[Type]  index: int )

; enterNewScope's cleanup, as a frame: the enclosing declaration and mapper to
; restore, and the fake-scope locals to undo
define NbScopeFrame
(
    old_enclosing: ref[AstNode]?
    old_mapper: ref[TypeMapper]?
    var params_locals: ref[SymbolTable]?
    var params_new_names: ref[Array[Slice[char]]]?
    var params_undo: ref[Array[NbLocalsUndo]]?
    var type_params_locals: ref[SymbolTable]?
    var type_params_new_names: ref[Array[Slice[char]]]?
    var type_params_undo: ref[Array[NbLocalsUndo]]?
)

; the serializedTypes cache: one row per (enclosing declaration, type, flags)
define NbCacheRow
(
    enclosing: ref[AstNode]
    type_id: int
    flags: int
    internal_flags: int
    node: ref[AstNode]?
    truncating: bool
    added_length: int
    tracked: ref[Array[NbTrackedSymbol]]?
)

; nodecopy.go's recoveryBoundary
define NbBoundary
(
    var had_error: bool
    var deferred: ref[Array[NbDeferredReport]]
    tracked: ref[Array[NbTrackedSymbol]]
    old_tracked: ref[Array[NbTrackedSymbol]]?
    old_encountered_error: bool
    old_approximate_length: int
)

; a scope of the four copy-on-write maps: the lengths at entry
define NbScopeMark ( names: int  names_by_text: int  next_counts: int  symbol_list: int )

; NodeBuilderContext
define NbContext
(
    var approximate_length: int
    max_truncation_length: int
    var encountered_error: bool
    var truncating: bool
    var reported_diagnostic: bool
    var flags: int
    var internal_flags: int
    var depth: int
    max_expansion_depth: int
    can_increase_expansion_depth: bool
    expansion_truncated: bool
    var enclosing_declaration: ref[AstNode]?
    enclosing_file: ref[AstNode]?
    var infer_type_parameters: ref[Array[ref[Type]?]]?
    var visited_types: ref[Array[int]]
    symbol_depth: ref[Array[NbSymbolDepth]]
    var tracked_symbols: ref[Array[NbTrackedSymbol]]?
    var mapper: ref[TypeMapper]?
    var reverse_mapped_stack: ref[Array[ref[Symbol]?]]
    var enclosing_symbol_types: ref[Array[NbSymbolType]]
    var suppress_report_inference_fallback: bool
    ; the four scoped maps: append-only rows, read from the END, truncated at
    ; scope exit — which is exactly copy-on-write with EnterScope
    var type_parameter_names: ref[Array[NbTypeParamName]]
    var type_parameter_names_by_text: ref[Array[Slice[char]]]
    var type_parameter_next_counts: ref[Array[NbNameCount]]
    var type_parameter_symbol_list: ref[Array[ref[Symbol]?]]
    var scope_marks: ref[Array[NbScopeMark]]
)
{
    function create(host: ref[Page], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[NbContext]
    {
        let visited &Array[int]^host()
        let depths &Array[NbSymbolDepth]^host()
        let tracked &Array[NbTrackedSymbol]^host()
        let reverse &Array[ref[Symbol]?]^host()
        let sym_types &Array[NbSymbolType]^host()
        let names &Array[NbTypeParamName]^host()
        let by_text &Array[Slice[char]]^host()
        let counts &Array[NbNameCount]^host()
        let sym_list &Array[ref[Symbol]?]^host()
        let marks &Array[NbScopeMark]^host()
        let infer &Array[ref[Type]?]^host()
        &NbContext^host(0, 0, false, false, false, flags, internal_flags, 0, 0 - 1, false, false, enclosing, Checker.source_file_of_node(enclosing), infer, visited, depths, tracked, null, reverse, sym_types, false, names, by_text, counts, sym_list, marks)
    }
}

; ── internal/pseudochecker (slice 252): type.go, lookup.go, checker.go ─────
;
; A pseudo type is the SKELETON of a declaration's type read off its syntax —
; an annotation (Direct), a literal, an `as const` tuple, an object literal, a
; function expression's one call signature — which the node builder maps to a
; type node directly when it is equivalent to the checker's type, keeping the
; source's spelling (`'a'`, `["404"]`, `get x()`/`set x()`, `...a: [n: "n"]`)
; and the source's STRUCTURE (a function expression's outer type is built from
; its own parameters, never pushed on the builder's visited stack).
;
; ★ One record for the twenty kinds, with the slots each kind reads (the
; reference's `PseudoTypeData` interface has no spelling here): `node` is the
; Direct kind's type node, the Inferred kind's expression, the NoResult kind's
; declaration, the MaybeConstLocation kind's location, a literal kind's literal
; and the SingleCallSignature kind's signature; `members` is a union's types and
; a tuple's elements; `elements` is an object literal's. The reference's
; singletons (PseudoTypeUndefined, …) are allocated per use: every reader asks
; the KIND, none compares identity.

define PseudoParameter
(
    is_rest: bool
    name: ref[AstNode]
    is_optional: bool
    pseudo_type: ref[PseudoType]
)

define PseudoType
(
    kind: int
    node: ref[AstNode]?
    error_nodes: ref[Array[ref[AstNode]?]]?
    is_signature_return: bool
    const_type: ref[PseudoType]?
    regular_type: ref[PseudoType]?
    members: ref[Array[ref[PseudoType]?]]?
    parameters: ref[Array[ref[PseudoParameter]?]]?
    type_parameters: ref[Array[ref[AstNode]?]]?
    return_type: ref[PseudoType]?
    elements: ref[Array[ref[PseudoObjectElement]?]]?
)

; PseudoObjectElement and its four kinds (method, property assignment, set and
; get accessor); `signature` is the reference's Signature() — null for a
; property assignment
define PseudoObjectElement
(
    kind: int
    name: ref[AstNode]
    is_optional: bool
    signature: ref[AstNode]?
    type_parameters: ref[Array[ref[AstNode]?]]?
    parameters: ref[Array[ref[PseudoParameter]?]]?
    return_type: ref[PseudoType]?
    is_readonly: bool
    pseudo_type: ref[PseudoType]?
    parameter: ref[PseudoParameter]?
)

define PseudoChecker
(
    host: ref[Page]
    strict_null_checks: bool
    exact_optional_property_types: bool
)
{
    ; ── type.go: the constructors ──────────────────────────────────────────

    procedure new_type(this, kind: int) returns ref[PseudoType]
    {
        let t &PseudoType^host(kind, null, null, false, null, null, null, null, null, null, null)
        t
    }

    procedure new_direct(this, type_node: ref[AstNode]) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindDirect, type_node, null, false, null, null, null, null, null, null, null)
        t
    }

    procedure new_inferred(this, expr: ref[AstNode], is_signature_return: bool) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindInferred, expr, null, is_signature_return, null, null, null, null, null, null, null)
        t
    }

    procedure new_inferred_with_errors(this, expr: ref[AstNode], is_signature_return: bool, error_nodes: ref[Array[ref[AstNode]?]]?) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindInferred, expr, error_nodes, is_signature_return, null, null, null, null, null, null, null)
        t
    }

    procedure new_no_result(this, decl: ref[AstNode]) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindNoResult, decl, null, false, null, null, null, null, null, null, null)
        t
    }

    procedure new_maybe_const_location(this, loc: ref[AstNode], const_type: ref[PseudoType], regular_type: ref[PseudoType]) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindMaybeConstLocation, loc, null, false, const_type, regular_type, null, null, null, null, null)
        t
    }

    procedure new_union(this, types: ref[Array[ref[PseudoType]?]]) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindUnion, null, null, false, null, null, types, null, null, null, null)
        t
    }

    ; NewPseudoTypeUnion([]*PseudoType{t, PseudoTypeUndefined})
    procedure new_union_with_undefined(this, member: ref[PseudoType]) returns ref[PseudoType]
    {
        let types &Array[ref[PseudoType]?]^host()
        types.add(member)
        types.add(this.new_type(PseudoTypeKindUndefined))
        this.new_union(types)
    }

    procedure new_single_call_signature(this, signature: ref[AstNode], parameters: ref[Array[ref[PseudoParameter]?]]?, type_parameters: ref[Array[ref[AstNode]?]]?, return_type: ref[PseudoType]) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindSingleCallSignature, signature, null, false, null, null, null, parameters, type_parameters, return_type, null)
        t
    }

    procedure new_tuple(this, elements: ref[Array[ref[PseudoType]?]]) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindTuple, null, null, false, null, null, elements, null, null, null, null)
        t
    }

    procedure new_object_literal(this, elements: ref[Array[ref[PseudoObjectElement]?]]?) returns ref[PseudoType]
    {
        let t &PseudoType^host(PseudoTypeKindObjectLiteral, null, null, false, null, null, null, null, null, null, elements)
        t
    }

    ; NewPseudoTypeStringLiteral / NumericLiteral / BigIntLiteral
    procedure new_literal(this, kind: int, literal: ref[AstNode]) returns ref[PseudoType]
    {
        let t &PseudoType^host(kind, literal, null, false, null, null, null, null, null, null, null)
        t
    }

    procedure new_parameter(this, is_rest: bool, name: ref[AstNode], is_optional: bool, pseudo_type: ref[PseudoType]) returns ref[PseudoParameter]
    {
        let p &PseudoParameter^host(is_rest, name, is_optional, pseudo_type)
        p
    }

    procedure new_object_method(this, signature: ref[AstNode], name: ref[AstNode], is_optional: bool, type_parameters: ref[Array[ref[AstNode]?]]?, parameters: ref[Array[ref[PseudoParameter]?]]?, return_type: ref[PseudoType]) returns ref[PseudoObjectElement]
    {
        let e &PseudoObjectElement^host(PseudoObjectElementKindMethod, name, is_optional, signature, type_parameters, parameters, return_type, false, null, null)
        e
    }

    procedure new_property_assignment(this, is_readonly: bool, name: ref[AstNode], is_optional: bool, pseudo_type: ref[PseudoType]) returns ref[PseudoObjectElement]
    {
        let e &PseudoObjectElement^host(PseudoObjectElementKindPropertyAssignment, name, is_optional, null, null, null, null, is_readonly, pseudo_type, null)
        e
    }

    procedure new_set_accessor(this, signature: ref[AstNode], name: ref[AstNode], is_optional: bool, parameter: ref[PseudoParameter]) returns ref[PseudoObjectElement]
    {
        let e &PseudoObjectElement^host(PseudoObjectElementKindSetAccessor, name, is_optional, signature, null, null, null, false, null, parameter)
        e
    }

    procedure new_get_accessor(this, signature: ref[AstNode], name: ref[AstNode], is_optional: bool, pseudo_type: ref[PseudoType]) returns ref[PseudoObjectElement]
    {
        let e &PseudoObjectElement^host(PseudoObjectElementKindGetAccessor, name, is_optional, signature, null, null, null, false, pseudo_type, null)
        e
    }

    function error_node_count(t: ref[PseudoType]) returns int
    {
        if t.error_nodes = null
            return 0
        (t.error_nodes as ref[Array[ref[AstNode]?]]).get_length() as int
    }

    function member_count(t: ref[PseudoType]) returns int
    {
        if t.members = null
            return 0
        (t.members as ref[Array[ref[PseudoType]?]]).get_length() as int
    }

    function element_count(t: ref[PseudoType]) returns int
    {
        if t.elements = null
            return 0
        (t.elements as ref[Array[ref[PseudoObjectElement]?]]).get_length() as int
    }

    function parameter_count(params: ref[Array[ref[PseudoParameter]?]]?) returns int
    {
        if params = null
            return 0
        (params as ref[Array[ref[PseudoParameter]?]]).get_length() as int
    }

    ; `expr.Kind != PseudoTypeKindInferred || len(expr.ErrorNodes) > 0` — the
    ; test every declaration arm puts between an initializer's pseudo type and
    ; the NoResult fallback
    function is_usable_expression_type(expr: ref[PseudoType]) returns bool
    {
        if expr.kind <> PseudoTypeKindInferred
            return true
        PseudoChecker.error_node_count(expr) > 0
    }

    ; ── lookup.go ──────────────────────────────────────────────────────────

    ; GetReturnTypeOfSignature; the reference fails on a kind outside its list,
    ; and createReturnFromSignature answers NoResult for such a node
    procedure get_return_type_of_signature(mutable this, signature_node: ref[AstNode]) returns ref[PseudoType]
    {
        if signature_node.kind = KindGetAccessor
            return this.get_type_of_accessor(signature_node)
        this.create_return_from_signature(signature_node)
    }

    procedure get_type_of_accessor(mutable this, accessor: ref[AstNode]) returns ref[PseudoType]
        this.type_from_accessor(accessor)

    procedure get_type_of_expression(mutable this, node: ref[AstNode]) returns ref[PseudoType]
        this.type_from_expression(node)

    ; GetTypeOfDeclaration: null for a kind outside the reference's switch (its
    ; debug.FailBadSyntaxKind); the caller says the stop
    procedure get_type_of_declaration(mutable this, node: ref[AstNode]) returns ref[PseudoType]?
    {
        let k node.kind
        if k = KindParameter
            return this.type_from_parameter(node)
        if k = KindVariableDeclaration
            return this.type_from_variable(node)
        if (k = KindPropertySignature) or (k = KindPropertyDeclaration) or (k = KindJSDocPropertyTag)
            return this.type_from_property(node)
        if k = KindBindingElement
            return this.new_no_result(node)
        if k = KindExportAssignment
        {
            let expression AstNode.expression_of(node)
            if expression = null
                return this.new_no_result(node)
            return this.type_from_expression(expression as ref[AstNode])
        }
        if (k = KindPropertyAccessExpression) or (k = KindElementAccessExpression) or (k = KindBinaryExpression)
            return this.type_from_expando_property(node)
        if (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment)
            return this.type_from_property_assignment(node)
        ; the two Object.defineProperty kinds are `!!!` in the reference
        if k = KindCallExpression
            return this.new_no_result(node)
        null
    }

    procedure type_from_property_assignment(mutable this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let annotation AstNode.type_of(node)
        if annotation <> null
            return this.new_direct(annotation as ref[AstNode])
        if node.kind = KindPropertyAssignment
        {
            let initializer_node AstNode.initializer_of(node)
            if initializer_node <> null
            {
                let expr this.type_from_expression(initializer_node as ref[AstNode])
                if PseudoChecker.is_usable_expression_type(expr)
                    return expr
            }
        }
        this.new_no_result(node)
    }

    procedure type_from_expando_property(this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let declared_type AstNode.type_of(node)
        if declared_type <> null
            return this.new_direct(declared_type as ref[AstNode])
        this.new_no_result(node)
    }

    procedure type_from_property(mutable this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let annotation AstNode.type_of(node)
        if annotation <> null
            return this.new_direct(annotation as ref[AstNode])
        if node.kind = KindPropertyDeclaration
        {
            let initializer_node AstNode.initializer_of(node)
            if initializer_node <> null
            {
                if PseudoChecker.is_contextually_typed(node) = false
                {
                    ; explicit fail on readonly template literals
                    if Transformer.has_syntactic_modifier(node, ModifierFlagsReadonly)
                    {
                        if AstNode.kind_of(initializer_node) = KindTemplateExpression
                            return this.new_no_result(node)
                    }
                    let expr this.type_from_expression(initializer_node as ref[AstNode])
                    if PseudoChecker.is_usable_expression_type(expr)
                    {
                        if expr.kind <> PseudoTypeKindDirect
                        {
                            if PseudoChecker.has_question_postfix(node)
                                return this.add_undefined_if_definitely_required(expr)
                        }
                        return expr
                    }
                }
            }
        }
        this.new_no_result(node)
    }

    procedure type_from_variable(mutable this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let annotation AstNode.type_of(node)
        if annotation <> null
            return this.new_direct(annotation as ref[AstNode])
        let initializer_node AstNode.initializer_of(node)
        if (initializer_node <> null) and (node.symbol <> null)
        {
            let s node.symbol as ref[Symbol]
            let n Symbol.declaration_count(s)
            var variable_declarations 0
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(s, i)
                if d <> null
                {
                    if (d as ref[AstNode]).kind = KindVariableDeclaration
                        set variable_declarations: variable_declarations + 1
                }
                set i: i + 1
            }
            if (n = 1) or (variable_declarations = 1)
            {
                if PseudoChecker.is_contextually_typed(node) = false
                {
                    if PseudoChecker.is_var_const(node)
                    {
                        if AstNode.kind_of(initializer_node) = KindTemplateExpression
                            return this.new_no_result(node)
                    }
                    let expr this.type_from_expression(initializer_node as ref[AstNode])
                    if PseudoChecker.is_usable_expression_type(expr)
                        return expr
                }
            }
        }
        this.new_no_result(node)
    }

    ; ast.IsVarConst
    function is_var_const(node: ref[AstNode]) returns bool
        (Binder.combined_node_flags(node) & NodeFlagsBlockScoped) = NodeFlagsConst

    function has_question_postfix(node: ref[AstNode]) returns bool
    {
        let postfix AstNode.postfix_token_of(node)
        if postfix = null
            return false
        (postfix as ref[AstNode]).kind = KindQuestionToken
    }

    ; ast.GetAllAccessorDeclarationsForDeclaration over the symbol's declarations
    procedure accessor_pair_of(mutable this, accessor: ref[AstNode]) returns AccessorPair
    {
        var declarations: ref[Array[ref[AstNode]?]]? null
        if accessor.symbol <> null
        {
            let s accessor.symbol as ref[Symbol]
            set declarations: Symbol.declarations_list(host, s)
        }
        if declarations = null
            set declarations: &Array[ref[AstNode]?]^host()
        Transformer.get_all_accessor_declarations_for_declaration(accessor, declarations as ref[Array[ref[AstNode]?]])
    }

    procedure type_from_accessor(mutable this, accessor: ref[AstNode]) returns ref[PseudoType]
    {
        let pair this.accessor_pair_of(accessor)
        let accessor_type PseudoChecker.get_type_annotation_from_all_accessor_declarations(accessor, pair)
        if accessor_type <> null
        {
            if (accessor_type as ref[AstNode]).kind <> KindTypePredicate
                return this.new_direct(accessor_type as ref[AstNode])
        }
        if pair.get_accessor <> null
        {
            let getter pair.get_accessor as ref[AstNode]
            let res this.create_return_from_signature(getter)
            if res.kind = PseudoTypeKindInferred
            {
                if PseudoChecker.error_node_count(res) = 0
                {
                    ; move the error up to the accessor
                    let error_nodes &Array[ref[AstNode]?]^host()
                    error_nodes.add(getter)
                    if pair.set_accessor <> null
                        error_nodes.add(pair.set_accessor)
                    return this.new_inferred_with_errors(res.node as ref[AstNode], res.is_signature_return, error_nodes)
                }
            }
            return res
        }
        this.new_no_result(accessor)
    }

    function get_type_annotation_from_all_accessor_declarations(node: ref[AstNode], accessors: AccessorPair) returns ref[AstNode]?
    {
        var accessor_type PseudoChecker.get_type_annotation_from_accessor(node)
        if accessor_type = null
        {
            if node <> accessors.first_accessor
                set accessor_type: PseudoChecker.get_type_annotation_from_accessor(accessors.first_accessor)
        }
        if accessor_type = null
        {
            if accessors.second_accessor <> null
            {
                if node <> accessors.second_accessor
                    set accessor_type: PseudoChecker.get_type_annotation_from_accessor(accessors.second_accessor)
            }
        }
        accessor_type
    }

    ; getTypeAnnotationFromAccessor: a getter's return annotation, a setter's
    ; FIRST parameter's annotation
    function get_type_annotation_from_accessor(node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        let n node as ref[AstNode]
        if n.kind = KindGetAccessor
            return AstNode.type_of(n)
        let params AstNode.parameters_of(n)
        if AstNode.list_count(params) < 1
            return null
        let p AstNode.child_in_list(params, 0)
        if p = null
            return null
        if (p as ref[AstNode]).kind <> KindParameter
            return null
        AstNode.type_of(p)
    }

    function is_value_signature_declaration(k: int) returns bool
    {
        if (k = KindFunctionExpression) or (k = KindArrowFunction) or (k = KindMethodDeclaration)
            return true
        if (k = KindGetAccessor) or (k = KindSetAccessor)
            return true
        (k = KindFunctionDeclaration) or (k = KindConstructor)
    }

    ; createReturnFromSignature: never null, a NoResult instead
    procedure create_return_from_signature(mutable this, fn: ref[AstNode]) returns ref[PseudoType]
    {
        if AstNode.is_function_like(fn)
        {
            let r AstNode.type_of(fn)
            if r <> null
                return this.new_direct(r as ref[AstNode])
        }
        if PseudoChecker.is_value_signature_declaration(fn.kind)
            return this.type_from_single_return_expression(fn)
        this.new_no_result(fn)
    }

    ; the Async and Generator bits of ast.GetFunctionFlags
    function async_generator_flags_of(n: ref[AstNode]) returns int
    {
        let k n.kind
        var flags FunctionFlagsNormal
        var generator_capable false
        if (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindMethodDeclaration)
            set generator_capable: true
        if generator_capable
        {
            if AstNode.asterisk_token_of(n) <> null
                set flags: flags | FunctionFlagsGenerator
        }
        var async_capable generator_capable
        if k = KindArrowFunction
            set async_capable: true
        if async_capable
        {
            if Transformer.has_syntactic_modifier(n, ModifierFlagsAsync)
                set flags: flags | FunctionFlagsAsync
        }
        flags
    }

    ; typeFromSingleReturnExpression. ★ The reference's flag test is
    ; `flags&FunctionFlagsAsyncGenerator != 0` — Async OR Generator — so an
    ; async function's one return is Inferred too; slice 251's Direct half read
    ; it as both bits.
    procedure type_from_single_return_expression(mutable this, fn: ref[AstNode]) returns ref[PseudoType]
    {
        var candidate: ref[AstNode]? null
        let body AstNode.body_of(fn)
        if Parser.node_is_missing(body) = false
        {
            if (PseudoChecker.async_generator_flags_of(fn) & FunctionFlagsAsyncGenerator) <> 0
                return this.new_inferred(fn, true)
            let b body as ref[AstNode]
            if b.kind = KindBlock
            {
                ; ast.ForEachReturnStatement with the reference's visitor: a
                ; nested return, or a second one, leaves no candidate
                let return_statements &Array[ref[AstNode]?]^host()
                PseudoChecker.collect_return_statements(b, return_statements)
                var i 0
                while i < (return_statements.get_length() as int)
                {
                    let stmt return_statements[i] as ref[AstNode]
                    set i: i + 1
                    if stmt.parent <> b
                    {
                        set candidate: null
                        break
                    }
                    if candidate = null
                        set candidate: AstNode.expression_of(stmt)
                    else
                    {
                        set candidate: null
                        break
                    }
                }
            }
            else
                set candidate: b
        }
        if candidate <> null
        {
            let ce candidate as ref[AstNode]
            if PseudoChecker.is_contextually_typed(ce)
            {
                var t: ref[AstNode]? null
                if (ce.kind = KindTypeAssertionExpression) or (ce.kind = KindAsExpression)
                    set t: AstNode.type_of(ce)
                if t <> null
                {
                    if Parser.is_const_type_reference(t) = false
                        return this.new_direct(t as ref[AstNode])
                }
            }
            else
                return this.type_from_expression(ce)
        }
        this.new_inferred(fn, true)
    }

    ; ast.ForEachReturnStatement, collecting in visit order
    procedure collect_return_statements(node: ref[AstNode], mutable out: ref[Array[ref[AstNode]?]])
    {
        let k node.kind
        if k = KindReturnStatement
        {
            out.add(node)
            return
        }
        var walk false
        if (k = KindCaseBlock) or (k = KindBlock) or (k = KindIfStatement) or (k = KindDoStatement) or (k = KindWhileStatement) or (k = KindForStatement)
            set walk: true
        if (k = KindForInStatement) or (k = KindForOfStatement) or (k = KindWithStatement) or (k = KindSwitchStatement) or (k = KindCaseClause) or (k = KindDefaultClause)
            set walk: true
        if (k = KindLabeledStatement) or (k = KindTryStatement) or (k = KindCatchClause)
            set walk: true
        if walk = false
            return
        if (k = KindBlock) or (k = KindCaseClause) or (k = KindDefaultClause)
        {
            let statements AstNode.statements_of(node)
            let n AstNode.list_count(statements)
            var i 0
            while i < n
            {
                let s AstNode.child_in_list(statements, i)
                if s <> null
                    PseudoChecker.collect_return_statements(s as ref[AstNode], out)
                set i: i + 1
            }
            return
        }
        if k = KindCaseBlock
        {
            let clauses AstNode.case_clauses_of(node)
            let n AstNode.list_count(clauses)
            var i 0
            while i < n
            {
                let s AstNode.child_in_list(clauses, i)
                if s <> null
                    PseudoChecker.collect_return_statements(s as ref[AstNode], out)
                set i: i + 1
            }
            return
        }
        if k = KindIfStatement
        {
            let t AstNode.then_statement_of(node)
            if t <> null
                PseudoChecker.collect_return_statements(t as ref[AstNode], out)
            let el AstNode.else_statement_of(node)
            if el <> null
                PseudoChecker.collect_return_statements(el as ref[AstNode], out)
            return
        }
        if k = KindSwitchStatement
        {
            let cb AstNode.case_block_of(node)
            if cb <> null
                PseudoChecker.collect_return_statements(cb as ref[AstNode], out)
            return
        }
        if k = KindTryStatement
        {
            let tb AstNode.try_block_of(node)
            if tb <> null
                PseudoChecker.collect_return_statements(tb as ref[AstNode], out)
            let cc AstNode.catch_clause_of(node)
            if cc <> null
                PseudoChecker.collect_return_statements(cc as ref[AstNode], out)
            let fb AstNode.finally_block_of(node)
            if fb <> null
                PseudoChecker.collect_return_statements(fb as ref[AstNode], out)
            return
        }
        if k = KindCatchClause
        {
            let cb AstNode.catch_block_of(node)
            if cb <> null
                PseudoChecker.collect_return_statements(cb as ref[AstNode], out)
            return
        }
        ; the loops, `with` and a label: the one statement they hold
        let s AstNode.statement_of(node)
        if s <> null
            PseudoChecker.collect_return_statements(s as ref[AstNode], out)
    }

    ; typeFromExpression — "basically `checkExpression` for pseudotypes"
    procedure type_from_expression(mutable this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let k node.kind
        if k = KindOmittedExpression
            return this.new_type(PseudoTypeKindUndefined)
        if k = KindParenthesizedExpression
        {
            let inner AstNode.expression_of(node)
            if inner <> null
                return this.type_from_expression(inner as ref[AstNode])
        }
        if k = KindIdentifier
        {
            let undefined_name: Slice[char] "undefined"
            if SymbolTable.names_equal(AstNode.identifier_text_of(node), undefined_name)
                return this.new_type(PseudoTypeKindUndefined)
        }
        if k = KindNullKeyword
            return this.new_type(PseudoTypeKindNull)
        if (k = KindArrowFunction) or (k = KindFunctionExpression)
            return this.type_from_function_like_expression(node)
        if (k = KindTypeAssertionExpression) or (k = KindAsExpression)
            return this.type_from_type_assertion(AstNode.expression_of(node), AstNode.type_of(node))
        if k = KindPrefixUnaryExpression
        {
            if Transformer.dt_is_primitive_literal_value(node, true)
                return this.type_from_primitive_literal_prefix(node)
        }
        if k = KindArrayLiteralExpression
            return this.type_from_array_literal(node)
        if k = KindObjectLiteralExpression
            return this.type_from_object_literal(node)
        if k = KindClassExpression
        {
            let error_nodes &Array[ref[AstNode]?]^host()
            error_nodes.add(node)
            return this.new_inferred_with_errors(node, false, error_nodes)
        }
        if k = KindTemplateExpression
        {
            ; templateLitWithHoles as const, not supported
            if PseudoChecker.is_in_const_context(node)
                return this.new_inferred(node, false)
            let inferred this.new_inferred(node, false)
            let string_type this.new_type(PseudoTypeKindString)
            return this.new_maybe_const_location(node, inferred, string_type)
        }
        if k = KindNumericLiteral
        {
            let literal this.new_literal(PseudoTypeKindNumericLiteral, node)
            let number_type this.new_type(PseudoTypeKindNumber)
            return this.new_maybe_const_location(node, literal, number_type)
        }
        if (k = KindNoSubstitutionTemplateLiteral) or (k = KindStringLiteral)
        {
            let literal this.new_literal(PseudoTypeKindStringLiteral, node)
            let string_type this.new_type(PseudoTypeKindString)
            return this.new_maybe_const_location(node, literal, string_type)
        }
        if k = KindBigIntLiteral
        {
            let literal this.new_literal(PseudoTypeKindBigIntLiteral, node)
            let bigint_type this.new_type(PseudoTypeKindBigInt)
            return this.new_maybe_const_location(node, literal, bigint_type)
        }
        if k = KindTrueKeyword
        {
            let true_type this.new_type(PseudoTypeKindTrue)
            let boolean_type this.new_type(PseudoTypeKindBoolean)
            return this.new_maybe_const_location(node, true_type, boolean_type)
        }
        if k = KindFalseKeyword
        {
            let false_type this.new_type(PseudoTypeKindFalse)
            let boolean_type this.new_type(PseudoTypeKindBoolean)
            return this.new_maybe_const_location(node, false_type, boolean_type)
        }
        this.new_inferred(node, false)
    }

    procedure type_from_object_literal(mutable this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let error_nodes this.can_get_type_from_object_literal(node)
        if error_nodes <> null
            return this.new_inferred_with_errors(node, false, error_nodes)
        ; a const context producing an object literal type: no shorthand or
        ; spread assignments
        let props AstNode.properties_of(node)
        let n AstNode.list_count(props)
        if n = 0
            return this.new_object_literal(null)
        let results &Array[ref[PseudoObjectElement]?]^host()
        var i 0
        while i < n
        {
            let ep AstNode.child_in_list(props, i)
            set i: i + 1
            if ep = null
                continue
            let e ep as ref[AstNode]
            let name_node AstNode.name_of(e)
            if name_node = null
                continue
            let name name_node as ref[AstNode]
            if e.kind = KindMethodDeclaration
            {
                let optional PseudoChecker.has_question_postfix(e)
                let full AstNode.full_signature_of(e)
                if full <> null
                {
                    let direct this.new_direct(full as ref[AstNode])
                    results.add(this.new_property_assignment(false, name, optional, direct))
                }
                else
                {
                    let type_parameters this.clone_type_parameters(AstNode.type_parameters_of(e))
                    let parameters this.clone_parameters(AstNode.parameters_of(e))
                    let return_type this.create_return_from_signature(e)
                    results.add(this.new_object_method(e, name, optional, type_parameters, parameters, return_type))
                }
            }
            if e.kind = KindPropertyAssignment
            {
                let optional PseudoChecker.has_question_postfix(e)
                let initializer_node AstNode.initializer_of(e)
                if initializer_node <> null
                {
                    let init_type this.type_from_expression(initializer_node as ref[AstNode])
                    results.add(this.new_property_assignment(false, name, optional, init_type))
                }
            }
            if (e.kind = KindSetAccessor) or (e.kind = KindGetAccessor)
            {
                let member this.get_accessor_member(e, name)
                if member <> null
                    results.add(member)
            }
        }
        this.new_object_literal(results)
    }

    ; getAccessorMember (typeFromObjectLiteralAccessor in strada)
    procedure get_accessor_member(mutable this, accessor: ref[AstNode], name: ref[AstNode]) returns ref[PseudoObjectElement]?
    {
        let all this.accessor_pair_of(accessor)
        var both_typed false
        if (all.get_accessor <> null) and (all.set_accessor <> null)
        {
            if AstNode.type_of(all.get_accessor) <> null
            {
                let setter_params AstNode.parameters_of(all.set_accessor)
                if AstNode.list_count(setter_params) > 0
                {
                    if AstNode.type_of(AstNode.child_in_list(setter_params, 0)) <> null
                        set both_typed: true
                }
            }
        }
        if both_typed
        {
            ; both accessors typed: we cannot know the types are the same, so
            ; both accessors are kept
            if accessor.kind = KindGetAccessor
            {
                let getter_type this.type_from_accessor(accessor)
                return this.new_get_accessor(accessor, name, false, getter_type)
            }
            let params this.clone_parameters(AstNode.parameters_of(accessor))
            if params = null
                return null
            let first (params as ref[Array[ref[PseudoParameter]?]])[0]
            if first = null
                return null
            return this.new_set_accessor(accessor, name, false, first as ref[PseudoParameter])
        }
        if accessor = all.first_accessor
        {
            ; only one annotated accessor: a property, `readonly` for a lone `get`
            let accessor_type this.type_from_accessor(accessor)
            var is_readonly false
            if accessor.kind = KindGetAccessor
            {
                if all.second_accessor = null
                    set is_readonly: true
            }
            return this.new_property_assignment(is_readonly, name, false, accessor_type)
        }
        null
    }

    ; canGetTypeFromObjectLiteral: null when the literal can be typed, else its
    ; error nodes
    procedure can_get_type_from_object_literal(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let props AstNode.properties_of(node)
        let n AstNode.list_count(props)
        if n = 0
            return null
        let error_nodes &Array[ref[AstNode]?]^host()
        var i 0
        while i < n
        {
            let ep AstNode.child_in_list(props, i)
            set i: i + 1
            if ep = null
                continue
            let e ep as ref[AstNode]
            if (AstNode.flags_of(e) & NodeFlagsThisNodeHasError) <> 0
            {
                error_nodes.add(e)
                continue
            }
            if (e.kind = KindShorthandPropertyAssignment) or (e.kind = KindSpreadAssignment)
            {
                error_nodes.add(e)
                continue
            }
            let name_node AstNode.name_of(e)
            if name_node = null
                continue
            let name name_node as ref[AstNode]
            if (AstNode.flags_of(name) & NodeFlagsThisNodeHasError) <> 0
            {
                error_nodes.add(name)
                continue
            }
            if name.kind = KindPrivateIdentifier
            {
                error_nodes.add(e)
                continue
            }
            if name.kind = KindComputedPropertyName
            {
                let expression AstNode.expression_of(name)
                if expression <> null
                {
                    if Transformer.dt_is_primitive_literal_value(expression as ref[AstNode], false) = false
                        error_nodes.add(name)
                }
            }
        }
        if (error_nodes.get_length() as int) = 0
            return null
        error_nodes
    }

    procedure type_from_array_literal(mutable this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let error_nodes this.can_get_type_from_array_literal(node)
        if error_nodes <> null
            return this.new_inferred_with_errors(node, false, error_nodes)
        if PseudoChecker.is_in_const_context(node)
        {
            ; an `as const` cast with a contextual type: readonly state varies
            if PseudoChecker.is_contextually_typed(node)
                return this.new_inferred(node, false)
        }
        let results &Array[ref[PseudoType]?]^host()
        let elements AstNode.elements_of(node)
        let n AstNode.list_count(elements)
        var i 0
        while i < n
        {
            let e AstNode.child_in_list(elements, i)
            if e <> null
                results.add(this.type_from_expression(e as ref[AstNode]))
            set i: i + 1
        }
        this.new_tuple(results)
    }

    ; canGetTypeFromArrayLiteral: a non-const array is its own error node; a
    ; const one with a spread names the spread
    procedure can_get_type_from_array_literal(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        if PseudoChecker.is_in_const_context(node) = false
        {
            let error_nodes &Array[ref[AstNode]?]^host()
            error_nodes.add(node)
            return error_nodes
        }
        let elements AstNode.elements_of(node)
        let n AstNode.list_count(elements)
        var i 0
        while i < n
        {
            let e AstNode.child_in_list(elements, i)
            if e <> null
            {
                if (e as ref[AstNode]).kind = KindSpreadElement
                {
                    let error_nodes &Array[ref[AstNode]?]^host()
                    error_nodes.add(e)
                    return error_nodes
                }
            }
            set i: i + 1
        }
        null
    }

    ; isConstContextPropagatingKind
    function is_const_context_propagating_kind(k: int) returns bool
    {
        if (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression) or (k = KindParenthesizedExpression) or (k = KindSpreadElement)
            return true
        (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment) or (k = KindTemplateSpan) or (k = KindPrefixUnaryExpression)
    }

    ; IsInConstContext: the first ancestor that is an assertion or does not
    ; propagate const-ness decides
    function is_in_const_context(node: ref[AstNode]) returns bool
    {
        var a node.parent
        while a <> null
        {
            let n a as ref[AstNode]
            var stop false
            if (n.kind = KindTypeAssertionExpression) or (n.kind = KindAsExpression)
                set stop: true
            if PseudoChecker.is_const_context_propagating_kind(n.kind) = false
                set stop: true
            if stop
                return Checker.is_const_assertion(n)
            set a: n.parent
        }
        false
    }

    procedure type_from_primitive_literal_prefix(this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let operand AstNode.prefix_unary_operand_of(node)
        if operand = null
            return this.new_inferred(node, false)
        let inner operand as ref[AstNode]
        var expr node
        if AstNode.prefix_unary_operator_kind(node) = KindPlusToken
            set expr: inner
        if inner.kind = KindBigIntLiteral
        {
            let literal this.new_literal(PseudoTypeKindBigIntLiteral, expr)
            let bigint_type this.new_type(PseudoTypeKindBigInt)
            return this.new_maybe_const_location(node, literal, bigint_type)
        }
        if inner.kind = KindNumericLiteral
        {
            let literal this.new_literal(PseudoTypeKindNumericLiteral, expr)
            let number_type this.new_type(PseudoTypeKindNumber)
            return this.new_maybe_const_location(node, literal, number_type)
        }
        this.new_inferred(node, false)
    }

    procedure type_from_type_assertion(mutable this, expression: ref[AstNode]?, type_node: ref[AstNode]?) returns ref[PseudoType]
    {
        if type_node = null
            return this.new_inferred(expression as ref[AstNode], false)
        if Parser.is_const_type_reference(type_node)
        {
            if expression <> null
                return this.type_from_expression(expression as ref[AstNode])
        }
        this.new_direct(type_node as ref[AstNode])
    }

    procedure type_from_function_like_expression(mutable this, node: ref[AstNode]) returns ref[PseudoType]
    {
        let full AstNode.full_signature_of(node)
        if full <> null
            return this.new_direct(full as ref[AstNode])
        let return_type this.create_return_from_signature(node)
        let type_parameters this.clone_type_parameters(AstNode.type_parameters_of(node))
        let parameters this.clone_parameters(AstNode.parameters_of(node))
        this.new_single_call_signature(node, parameters, type_parameters, return_type)
    }

    procedure clone_type_parameters(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        let n AstNode.list_count(nodes)
        if n = 0
            return null
        let result &Array[ref[AstNode]?]^host()
        var i 0
        while i < n
        {
            result.add(AstNode.child_in_list(nodes, i))
            set i: i + 1
        }
        result
    }

    function is_undefined_pseudo_type(t: ref[PseudoType]) returns bool
    {
        if t.kind = PseudoTypeKindUndefined
            return true
        if t.kind = PseudoTypeKindMaybeConstLocation
        {
            if t.const_type <> null
                return PseudoChecker.is_undefined_pseudo_type(t.const_type as ref[PseudoType])
        }
        false
    }

    ; typeNodeCouldReferToUndefined
    function type_node_could_refer_to_undefined(node_in: ref[AstNode]) returns bool
    {
        var node node_in
        while node.kind = KindParenthesizedType
        {
            let inner AstNode.parenthesized_type_inner_of(node)
            if inner = null
                return false
            set node: inner as ref[AstNode]
        }
        let k node.kind
        if (k = KindTypeReference) or (k = KindIndexedAccessType) or (k = KindTypeQuery) or (k = KindOptionalType) or (k = KindRestType) or (k = KindImportType)
            return true
        if (k = KindIntersectionType) or (k = KindUnionType)
        {
            let members AstNode.type_list_of(node)
            let n AstNode.list_count(members)
            var i 0
            while i < n
            {
                let m AstNode.child_in_list(members, i)
                if m <> null
                {
                    if PseudoChecker.type_node_could_refer_to_undefined(m as ref[AstNode])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        if (k = KindConditionalType) or (k = KindTypeOperator) or (k = KindTypePredicate) or (k = KindUndefinedKeyword)
            return true
        false
    }

    ; CouldAlreadyReferToUndefinedType
    function could_already_refer_to_undefined_type(t: ref[PseudoType]) returns bool
    {
        if (t.kind = PseudoTypeKindNoResult) or (t.kind = PseudoTypeKindInferred)
            return true
        if PseudoChecker.is_undefined_pseudo_type(t)
            return true
        if t.kind = PseudoTypeKindMaybeConstLocation
        {
            if t.regular_type = null
                return false
            return PseudoChecker.could_already_refer_to_undefined_type(t.regular_type as ref[PseudoType])
        }
        if t.kind = PseudoTypeKindDirect
            return PseudoChecker.type_node_could_refer_to_undefined(t.node as ref[AstNode])
        if t.kind = PseudoTypeKindUnion
        {
            let n PseudoChecker.member_count(t)
            let members t.members as ref[Array[ref[PseudoType]?]]
            var i 0
            while i < n
            {
                let m members[i]
                if m <> null
                {
                    if PseudoChecker.could_already_refer_to_undefined_type(m as ref[PseudoType])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        false
    }

    function is_optional_initialized_or_rest_parameter(p: ref[AstNode]) returns bool
    {
        if AstNode.dot_dot_dot_token_of(p) <> null
            return true
        if AstNode.initializer_of(p) <> null
            return true
        AstNode.parameter_question_token_of(p) <> null
    }

    ; lastRequiredParamIndex: one past the last required parameter
    function last_required_param_index(params: ref[Array[ref[AstNode]?]]?) returns int
    {
        var i AstNode.list_count(params) - 1
        while i >= 0
        {
            let p AstNode.child_in_list(params, i)
            if p <> null
            {
                if PseudoChecker.is_optional_initialized_or_rest_parameter(p as ref[AstNode]) = false
                    return i + 1
            }
            set i: i - 1
        }
        0
    }

    ; addUndefinedIfDefinitelyRequired
    procedure add_undefined_if_definitely_required(this, expr: ref[PseudoType]) returns ref[PseudoType]
    {
        if PseudoChecker.could_already_refer_to_undefined_type(expr)
            return expr
        this.new_union_with_undefined(expr)
    }

    procedure type_from_parameter(mutable this, node: ref[AstNode]) returns ref[PseudoType]
    {
        if node.parent = null
            return this.new_no_result(node)
        let parent node.parent as ref[AstNode]
        if parent.kind = KindSetAccessor
            return this.get_type_of_accessor(parent)
        ; fast path: no initializer, no position information needed
        if AstNode.initializer_of(node) = null
        {
            let annotation AstNode.type_of(node)
            if annotation <> null
                return this.new_direct(annotation as ref[AstNode])
            return this.new_no_result(node)
        }
        let params AstNode.parameters_of(parent)
        let n AstNode.list_count(params)
        var self_index 0 - 1
        var i 0
        while i < n
        {
            if AstNode.child_in_list(params, i) = node
            {
                set self_index: i
                break
            }
            set i: i + 1
        }
        let last_required PseudoChecker.last_required_param_index(params)
        this.type_from_parameter_worker(node, self_index, last_required)
    }

    procedure type_from_parameter_worker(mutable this, node: ref[AstNode], self_index: int, last_required: int) returns ref[PseudoType]
    {
        if node.parent <> null
        {
            let parent node.parent as ref[AstNode]
            if parent.kind = KindSetAccessor
                return this.get_type_of_accessor(parent)
        }
        let has_required_after (self_index < (last_required - 1))
        let declared_type AstNode.type_of(node)
        let initializer AstNode.initializer_of(node)
        if declared_type <> null
        {
            let result this.new_direct(declared_type as ref[AstNode])
            ; an initialized parameter before a required one is optional-typed
            if strict_null_checks and (initializer <> null) and has_required_after
                return this.add_undefined_if_definitely_required(result)
            return result
        }
        if initializer <> null
        {
            if AstNode.kind_of(AstNode.name_of(node)) = KindIdentifier
            {
                if PseudoChecker.is_contextually_typed(node) = false
                {
                    var expr: ref[PseudoType]? this.type_from_expression(initializer as ref[AstNode])
                    let first expr as ref[PseudoType]
                    if first.kind = PseudoTypeKindInferred
                    {
                        if PseudoChecker.error_node_count(first) = 0
                        {
                            ; move the error up to the parameter
                            let error_nodes &Array[ref[AstNode]?]^host()
                            error_nodes.add(node)
                            set expr: this.new_inferred_with_errors(first.node as ref[AstNode], false, error_nodes)
                        }
                    }
                    let chosen expr as ref[PseudoType]
                    if strict_null_checks = false
                        return chosen
                    if has_required_after = false
                        return chosen
                    return this.add_undefined_if_definitely_required(chosen)
                }
            }
        }
        ; a binding pattern name is not inferred (the strada limitation kept)
        this.new_no_result(node)
    }

    procedure clone_parameters(mutable this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[PseudoParameter]?]]?
    {
        let n AstNode.list_count(nodes)
        if n = 0
            return null
        let last_required PseudoChecker.last_required_param_index(nodes)
        let result &Array[ref[PseudoParameter]?]^host()
        var i 0
        while i < n
        {
            let ep AstNode.child_in_list(nodes, i)
            if ep <> null
            {
                let e ep as ref[AstNode]
                var optional (AstNode.parameter_question_token_of(e) <> null)
                if optional = false
                {
                    ; an initialized parameter is optional only when every later
                    ; one is (the checker's isOptionalParameter)
                    if AstNode.initializer_of(e) <> null
                        set optional: (i >= (last_required - 1))
                }
                let is_rest (AstNode.dot_dot_dot_token_of(e) <> null)
                let name AstNode.name_of(e)
                let parameter_type this.type_from_parameter_worker(e, i, last_required)
                if name <> null
                    result.add(this.new_parameter(is_rest, name as ref[AstNode], optional, parameter_type))
            }
            set i: i + 1
        }
        result
    }

    ; isContextuallyTyped: a call, a `satisfies`, an annotated variable,
    ; parameter, property or non-const assertion above the node, or JSX
    function is_contextually_typed(node: ref[AstNode]) returns bool
    {
        var a node.parent
        while a <> null
        {
            let n a as ref[AstNode]
            let k n.kind
            if (k = KindCallExpression) or (k = KindSatisfiesExpression)
                return true
            if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindPropertySignature) or (k = KindPropertyDeclaration) or (k = KindTypeAssertionExpression) or (k = KindAsExpression)
            {
                if AstNode.type_of(n) <> null
                {
                    if Checker.is_const_assertion(n) = false
                        return true
                }
            }
            if (k = KindJsxElement) or (k = KindJsxExpression)
                return true
            set a: n.parent
        }
        false
    }
}

; one memo row of getSpecifierForModuleSymbol
define NbSpecifierRow
(
    symbol: ref[Symbol]
    file_path: Slice[char]
    mode: int
    specifier: Slice[char]
)

define NodeBuilder
(
    host: ref[Page]
    checker: ref[Checker]
    factory: ref[NodeFactory]
    context: ref[EmitContext]
    tracker: ref[Transformer]?
    var ctx: ref[NbContext]?
    var ctx_stack: ref[Array[ref[NbContext]?]]
    cache_rows: ref[Array[ref[NbCacheRow]?]]
    fake_scopes: ref[Array[NbFakeScope]]
    boundaries: ref[Array[ref[NbBoundary]?]]
    var boundary_depth: int
    var existing_visitor: ref[NodeVisitor]?
    var clone_binding_visitor: ref[NodeVisitor]?
    var attach_visitor: ref[NodeVisitor]?
    var scopes: ref[Array[ref[NbScopeFrame]?]]
    var attach_leftmost: ref[AstNode]?
    var attach_symbol: ref[Symbol]?
    var introduces_error: bool
    var tracked_sym: ref[Symbol]?
    var unported_count: int
    var unported_tag: Slice[char]
    var unported_detail: int
    ; the pseudochecker (slice 252), under the program's two options
    pc: ref[PseudoChecker]
    ; the module specifier host, made on first use, and getSpecifierForModuleSymbol's
    ; memo (the reference's links.specifierCache, keyed by file path and mode)
    var specifier_host: ref[SpecifierHost]?
    specifier_cache: ref[Array[ref[NbSpecifierRow]?]]
)
{
    procedure create(host: ref[Page], checker: ref[Checker], context: ref[EmitContext], tracker: ref[Transformer]?) returns ref[NodeBuilder]
    {
        let stack &Array[ref[NbContext]?]^host()
        let rows &Array[ref[NbCacheRow]?]^host()
        let fakes &Array[NbFakeScope]^host()
        let bounds &Array[ref[NbBoundary]?]^host()
        let frames &Array[ref[NbScopeFrame]?]^host()
        let no_tag: Slice[char] ""
        let strict Checker.strict_null_checks()
        let exact Checker.exact_optional_property_types()
        let pseudo &PseudoChecker^host(host, strict, exact)
        let specifiers &Array[ref[NbSpecifierRow]?]^host()
        &NodeBuilder^host(host, checker, context.the_factory(), context, tracker, null, stack, rows, fakes, bounds, 0, null, null, null, frames, null, null, false, null, 0, no_tag, 0, pseudo, null, specifiers)
    }

    procedure record_unported(mutable this, tag_text: Slice[char], detail: int)
    {
        if unported_count = 0
        {
            set this.unported_tag: tag_text
            set this.unported_detail: detail
        }
        set this.unported_count: unported_count + 1
    }

    function the_ctx(this) returns ref[NbContext]
        ctx as ref[NbContext]

    procedure note_error(mutable this, site: Slice[char])
    {
        let c this.the_ctx()
        set c.encountered_error: true
    }

    function the_binder(this) returns ref[Binder]
        (tracker as ref[Transformer]).the_binder()

    ; ── nodebuilder.go: the context stack ────────────────────────────────────

    procedure enter_context(mutable this, enclosing: ref[AstNode]?, flags: int, internal_flags: int)
    {
        ctx_stack.add(ctx)
        set this.ctx: NbContext.create(host, enclosing, flags, internal_flags)
        this.sync_checker()
    }

    procedure pop_context(mutable this)
    {
        let n ctx_stack.get_length() as int
        if n = 0
        {
            set this.ctx: null
            return
        }
        set this.ctx: ctx_stack[n - 1]
        set this.ctx_stack: NodeBuilder.ctx_prefix(host, ctx_stack, n - 1)
        this.sync_checker()
    }

    ; the checker's chain machinery reads its enclosing declaration off a cell
    ; (printer_enclosing_declaration, slice 221) — kept in step with the context
    procedure sync_checker(mutable this)
    {
        if ctx = null
        {
            set checker.printer_enclosing_declaration: null
            set checker.printer_fully_qualified: false
            return
        }
        let c ctx as ref[NbContext]
        set checker.printer_enclosing_declaration: c.enclosing_declaration
        set checker.printer_fully_qualified: (c.flags & NbFlagsUseFullyQualifiedType) <> 0
    }

    procedure set_enclosing(mutable this, node: ref[AstNode]?)
    {
        let c this.the_ctx()
        set c.enclosing_declaration: node
        set checker.printer_enclosing_declaration: node
    }

    procedure exit_context(mutable this, result: ref[AstNode]?) returns ref[AstNode]?
    {
        let c this.the_ctx()
        if c.truncating and ((c.flags & NbFlagsNoTruncation) <> 0)
            this.report_truncation_error()
        var out result
        if c.encountered_error
            set out: null
        this.pop_context()
        out
    }

    procedure exit_context_list(mutable this, result: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        let c this.the_ctx()
        if c.truncating and ((c.flags & NbFlagsNoTruncation) <> 0)
            this.report_truncation_error()
        var out result
        if c.encountered_error
            set out: null
        this.pop_context()
        out
    }

    ; ── the entry points (nodebuilder.go) ────────────────────────────────────

    procedure type_to_type_node_ex(mutable this, mutable t: ref[Type]?, enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.type_to_type_node(t))
    }

    procedure symbol_to_entity_name_ex(mutable this, mutable symbol: ref[Symbol], meaning: int, enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.symbol_to_name(symbol, meaning, false))
    }

    procedure symbol_to_expression_ex(mutable this, mutable symbol: ref[Symbol], meaning: int, enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.symbol_to_expression(symbol, meaning))
    }

    procedure symbol_to_node_ex(mutable this, mutable symbol: ref[Symbol], meaning: int, enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.symbol_to_node(symbol, meaning))
    }

    procedure symbol_to_parameter_declaration_ex(mutable this, mutable symbol: ref[Symbol], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.symbol_to_parameter_declaration(symbol, false))
    }

    procedure symbol_to_type_parameter_declarations_ex(mutable this, mutable symbol: ref[Symbol], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[Array[ref[AstNode]?]]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context_list(this.type_parameters_to_type_parameter_declarations(symbol))
    }

    procedure type_parameter_to_declaration_ex(mutable this, mutable parameter: ref[Type], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.type_parameter_to_declaration(parameter))
    }

    procedure type_predicate_to_type_predicate_node_ex(mutable this, mutable predicate: ref[TypePredicate], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.type_predicate_to_type_predicate_node(predicate))
    }

    procedure serialize_type_for_declaration_ex(mutable this, mutable declaration: ref[AstNode]?, mutable symbol: ref[Symbol]?, enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.serialize_type_for_declaration(declaration, null, symbol, true))
    }

    procedure serialize_return_type_for_signature_ex(mutable this, mutable signature_declaration: ref[AstNode], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        let signature checker.get_signature_from_declaration(signature_declaration)
        if signature = null
        {
            this.record_unported("node-builder-signature", signature_declaration.kind)
            return this.exit_context(null)
        }
        let sig signature as ref[Signature]
        let expanded this.enter_signature_scope(sig)
        let result this.serialize_return_type_for_signature(sig, true)
        this.exit_scope()
        this.exit_context(result)
    }

    procedure serialize_type_parameters_for_signature_ex(mutable this, mutable signature_declaration: ref[AstNode], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[Array[ref[AstNode]?]]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        let symbol checker.get_symbol_of_declaration(signature_declaration)
        if symbol = null
            return this.exit_context_list(null)
        ; SymbolToTypeParameterDeclarations enters a context of its own
        this.enter_context(enclosing, flags, internal_flags)
        let inner this.exit_context_list(this.type_parameters_to_type_parameter_declarations(symbol as ref[Symbol]))
        this.exit_context_list(inner)
    }

    procedure serialize_type_for_expression_ex(mutable this, mutable expr: ref[AstNode], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.serialize_type_for_expression(expr))
    }

    procedure signature_to_signature_declaration_ex(mutable this, mutable signature: ref[Signature], kind: int, enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.signature_to_signature_declaration_helper(signature, kind, null, null, null))
    }

    procedure index_info_to_index_signature_declaration_ex(mutable this, mutable info: ref[IndexInfo], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.index_info_to_index_signature_declaration_helper(info, null))
    }

    procedure try_js_type_node_to_type_node_ex(mutable this, mutable node: ref[AstNode], enclosing: ref[AstNode]?, flags: int, internal_flags: int) returns ref[AstNode]?
    {
        this.enter_context(enclosing, flags, internal_flags)
        this.exit_context(this.reuse_node(node))
    }

    ; ── symboltracker.go + nodecopy.go's wrapping tracker, as a stack ────────

    function top_boundary(this) returns ref[NbBoundary]
        boundaries[boundary_depth - 1] as ref[NbBoundary]

    ; TrackSymbol: at depth n > 0 the boundary records it; at depth 0 the
    ; SymbolTrackerImpl asks the transformer and records it on the context
    procedure track_symbol(mutable this, mutable symbol: ref[Symbol], mutable enclosing: ref[AstNode]?, meaning: int) returns bool
        this.track_symbol_at(symbol, enclosing, meaning, boundary_depth)

    procedure track_symbol_at(mutable this, mutable symbol: ref[Symbol], mutable enclosing: ref[AstNode]?, meaning: int, level: int) returns bool
    {
        if level > 0
        {
            let b boundaries[level - 1] as ref[NbBoundary]
            b.tracked.add(NbTrackedSymbol(symbol, enclosing, meaning))
            ; the SymbolTrackerImpl around the wrapper appends to the context too
            this.append_tracked(symbol, enclosing, meaning)
            return false
        }
        if tracker <> null
        {
            if (tracker as ref[Transformer]).dt_track_symbol(symbol, enclosing, meaning)
            {
                let c this.the_ctx()
                set c.reported_diagnostic: true
                return true
            }
        }
        this.append_tracked(symbol, enclosing, meaning)
        false
    }

    procedure append_tracked(mutable this, symbol: ref[Symbol], enclosing: ref[AstNode]?, meaning: int)
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsTypeParameter) <> 0
            return
        let c this.the_ctx()
        if c.tracked_symbols = null
            set c.tracked_symbols: &Array[NbTrackedSymbol]^host()
        (c.tracked_symbols as ref[Array[NbTrackedSymbol]]).add(NbTrackedSymbol(symbol, enclosing, meaning))
    }

    procedure on_diagnostic_reported(mutable this)
    {
        let c this.the_ctx()
        set c.reported_diagnostic: true
    }

    ; a deferrable report: marked on the context, then deferred into the
    ; boundary or delivered to the transformer
    procedure report(mutable this, kind: int, text: Slice[char], text2: Slice[char])
    {
        this.on_diagnostic_reported()
        this.report_at(kind, text, text2, boundary_depth)
    }

    procedure report_at(mutable this, kind: int, text: Slice[char], text2: Slice[char], level: int)
    {
        if level > 0
        {
            let b boundaries[level - 1] as ref[NbBoundary]
            set b.had_error: true
            b.deferred.add(NbDeferredReport(kind, text, text2))
            return
        }
        if tracker = null
            return
        let tx tracker as ref[Transformer]
        if kind = NbReportCyclicStructure
            tx.dt_report_cyclic_structure_error()
        if kind = NbReportInaccessibleThis
            tx.dt_report_inaccessible_this_error()
        if kind = NbReportInaccessibleUniqueSymbol
            tx.dt_report_inaccessible_unique_symbol_error()
        if kind = NbReportLikelyUnsafeImportRequired
            tx.dt_report_likely_unsafe_import_required_error(text, text2)
        if kind = NbReportNonSerializableProperty
            tx.dt_report_non_serializable_property(text)
        if kind = NbReportPrivateInBaseOfClassExpression
            tx.dt_report_private_in_base_of_class_expression(text)
    }

    procedure report_cyclic_structure_error(mutable this)
        this.report(NbReportCyclicStructure, Slice[char](), Slice[char]())

    procedure report_inaccessible_this_error(mutable this)
        this.report(NbReportInaccessibleThis, Slice[char](), Slice[char]())

    procedure report_inaccessible_unique_symbol_error(mutable this)
        this.report(NbReportInaccessibleUniqueSymbol, Slice[char](), Slice[char]())

    procedure report_likely_unsafe_import_required_error(mutable this, specifier: Slice[char], symbol_name: Slice[char])
        this.report(NbReportLikelyUnsafeImportRequired, specifier, symbol_name)

    procedure report_non_serializable_property(mutable this, name: Slice[char])
        this.report(NbReportNonSerializableProperty, name, Slice[char]())

    procedure report_private_in_base_of_class_expression(mutable this, name: Slice[char])
        this.report(NbReportPrivateInBaseOfClassExpression, name, Slice[char]())

    ; the three that pass straight through every wrapper
    procedure report_truncation_error(mutable this)
    {
        this.on_diagnostic_reported()
        if tracker <> null
            (tracker as ref[Transformer]).dt_report_truncation_error()
    }

    procedure report_inference_fallback(mutable this, mutable node: ref[AstNode]?)
    {
        if node = null
            return
        if tracker <> null
            (tracker as ref[Transformer]).dt_report_inference_fallback(node as ref[AstNode])
    }

    procedure push_error_fallback_node(mutable this, node: ref[AstNode])
    {
        if tracker <> null
            (tracker as ref[Transformer]).dt_push_error_fallback_node(node)
    }

    procedure pop_error_fallback_node(mutable this)
    {
        if tracker <> null
            (tracker as ref[Transformer]).dt_pop_error_fallback_node()
    }

    ; createRecoveryBoundary
    procedure create_recovery_boundary(mutable this)
    {
        let c this.the_ctx()
        let deferred &Array[NbDeferredReport]^host()
        let tracked &Array[NbTrackedSymbol]^host()
        let b &NbBoundary^host(false, deferred, tracked, c.tracked_symbols, c.encountered_error, c.approximate_length)
        if boundary_depth < (boundaries.get_length() as int)
            boundaries.put(boundary_depth as size_t, b)
        else
            boundaries.add(b)
        set this.boundary_depth: boundary_depth + 1
        set c.tracked_symbols: null
    }

    ; finalizeBoundary: the deferred reports go one level down whatever
    ; happened; the tracked symbols only when nothing failed
    procedure finalize_boundary(mutable this) returns bool
    {
        let b this.top_boundary()
        let c this.the_ctx()
        set this.boundary_depth: boundary_depth - 1
        set c.tracked_symbols: b.old_tracked
        set c.encountered_error: b.old_encountered_error
        set c.approximate_length: b.old_approximate_length
        var i 0
        let nd b.deferred.get_length() as int
        while i < nd
        {
            let d b.deferred[i]
            ; the report was marked on the context when it was made
            this.report_at(d.kind, d.text, d.text2, boundary_depth)
            set i: i + 1
        }
        if b.had_error
            return false
        set i: 0
        let nt b.tracked.get_length() as int
        while i < nt
        {
            let t b.tracked[i]
            this.track_symbol_at(t.symbol, t.enclosing, t.meaning, boundary_depth)
            set i: i + 1
        }
        true
    }

    ; startRecoveryScope / endRecoveryScope: (tracked top, deferred top, had_error)
    function recovery_tracked_top(this) returns int
    {
        let c this.the_ctx()
        if c.tracked_symbols = null
            return 0
        (c.tracked_symbols as ref[Array[NbTrackedSymbol]]).get_length() as int
    }

    function recovery_deferred_top(this) returns int
        (this.top_boundary()).deferred.get_length() as int

    procedure end_recovery_scope(mutable this, tracked_top: int, deferred_top: int, had_error: bool)
    {
        let b this.top_boundary()
        let c this.the_ctx()
        set b.had_error: had_error
        if c.tracked_symbols <> null
        {
            let ts c.tracked_symbols as ref[Array[NbTrackedSymbol]]
            if (ts.get_length() as int) > tracked_top
                set c.tracked_symbols: NodeBuilder.tracked_prefix(host, ts, tracked_top)
        }
        if (b.deferred.get_length() as int) > deferred_top
            set b.deferred: NodeBuilder.deferred_prefix(host, b.deferred, deferred_top)
    }

    function tracked_prefix(host: ref[Page], list: ref[Array[NbTrackedSymbol]], n: int) returns ref[Array[NbTrackedSymbol]]
    {
        let out &Array[NbTrackedSymbol]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    function deferred_prefix(host: ref[Page], list: ref[Array[NbDeferredReport]], n: int) returns ref[Array[NbDeferredReport]]
    {
        let out &Array[NbDeferredReport]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    ; ── the flags and the scoped maps ────────────────────────────────────────

    ; saveRestoreFlags: the three slots, restored by restore_flags
    function save_flags(this) returns int
        (this.the_ctx()).flags

    function save_internal_flags(this) returns int
        (this.the_ctx()).internal_flags

    function save_depth(this) returns int
        (this.the_ctx()).depth

    procedure restore_flags(mutable this, flags: int, internal_flags: int, depth: int)
    {
        let c this.the_ctx()
        set c.flags: flags
        set c.internal_flags: internal_flags
        set c.depth: depth
    }

    procedure add_flag(mutable this, flag: int)
    {
        let c this.the_ctx()
        set c.flags: c.flags | flag
    }

    procedure clear_flag(mutable this, flag: int)
    {
        let c this.the_ctx()
        if (c.flags & flag) <> 0
            set c.flags: c.flags xor flag
    }

    function has_flag(this, flag: int) returns bool
        ((this.the_ctx()).flags & flag) <> 0

    function has_internal_flag(this, flag: int) returns bool
        ((this.the_ctx()).internal_flags & flag) <> 0

    ; cloneNodeBuilderContext: EnterScope on the four maps
    procedure enter_name_scope(mutable this)
    {
        let c this.the_ctx()
        c.scope_marks.add(NbScopeMark(c.type_parameter_names.get_length() as int, c.type_parameter_names_by_text.get_length() as int, c.type_parameter_next_counts.get_length() as int, c.type_parameter_symbol_list.get_length() as int))
    }

    procedure exit_name_scope(mutable this)
    {
        let c this.the_ctx()
        let n c.scope_marks.get_length() as int
        if n = 0
            return
        let m c.scope_marks[n - 1]
        set c.scope_marks: NodeBuilder.marks_prefix(host, c.scope_marks, n - 1)
        set c.type_parameter_names: NodeBuilder.names_prefix(host, c.type_parameter_names, m.names)
        set c.type_parameter_names_by_text: NodeBuilder.texts_prefix(host, c.type_parameter_names_by_text, m.names_by_text)
        set c.type_parameter_next_counts: NodeBuilder.counts_prefix(host, c.type_parameter_next_counts, m.next_counts)
        set c.type_parameter_symbol_list: NodeBuilder.symbols_prefix(host, c.type_parameter_symbol_list, m.symbol_list)
    }

    function marks_prefix(host: ref[Page], list: ref[Array[NbScopeMark]], n: int) returns ref[Array[NbScopeMark]]
    {
        let out &Array[NbScopeMark]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    function names_prefix(host: ref[Page], list: ref[Array[NbTypeParamName]], n: int) returns ref[Array[NbTypeParamName]]
    {
        let out &Array[NbTypeParamName]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    function texts_prefix(host: ref[Page], list: ref[Array[Slice[char]]], n: int) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    function counts_prefix(host: ref[Page], list: ref[Array[NbNameCount]], n: int) returns ref[Array[NbNameCount]]
    {
        let out &Array[NbNameCount]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    function symbols_prefix(host: ref[Page], list: ref[Array[ref[Symbol]?]], n: int) returns ref[Array[ref[Symbol]?]]
    {
        let out &Array[ref[Symbol]?]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    function type_parameter_name_of(this, type_id: int) returns ref[AstNode]?
    {
        let c this.the_ctx()
        var i (c.type_parameter_names.get_length() as int) - 1
        while i >= 0
        {
            let row c.type_parameter_names[i]
            if row.type_id = type_id
                return row.name
            set i: i - 1
        }
        null
    }

    function type_parameter_text_seen(this, text: Slice[char]) returns bool
    {
        let c this.the_ctx()
        var i 0
        let n c.type_parameter_names_by_text.get_length() as int
        while i < n
        {
            if SymbolTable.names_equal(c.type_parameter_names_by_text[i], text)
                return true
            set i: i + 1
        }
        false
    }

    function next_name_count_of(this, text: Slice[char]) returns int
    {
        let c this.the_ctx()
        var i (c.type_parameter_next_counts.get_length() as int) - 1
        while i >= 0
        {
            let row c.type_parameter_next_counts[i]
            if SymbolTable.names_equal(row.text, text)
                return row.count
            set i: i - 1
        }
        0
    }

    function type_parameter_symbol_listed(this, symbol: ref[Symbol]) returns bool
    {
        let c this.the_ctx()
        var i 0
        let n c.type_parameter_symbol_list.get_length() as int
        while i < n
        {
            let s c.type_parameter_symbol_list[i]
            if s <> null
            {
                if (s as ref[Symbol]) = symbol
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; enclosingSymbolTypes: the last row for a symbol
    function enclosing_symbol_type_of(this, symbol: ref[Symbol]) returns ref[Type]?
    {
        let c this.the_ctx()
        var i (c.enclosing_symbol_types.get_length() as int) - 1
        while i >= 0
        {
            let row c.enclosing_symbol_types[i]
            if row.symbol = symbol
                return row.t
            set i: i - 1
        }
        null
    }

    ; addSymbolTypeToContext: a row, removed by truncating back to the length
    procedure add_symbol_type_to_context(mutable this, symbol: ref[Symbol], t: ref[Type]?) returns int
    {
        let c this.the_ctx()
        let mark c.enclosing_symbol_types.get_length() as int
        c.enclosing_symbol_types.add(NbSymbolType(symbol, t))
        mark
    }

    procedure remove_symbol_type_from_context(mutable this, mark: int)
    {
        let c this.the_ctx()
        let out &Array[NbSymbolType]^host()
        var i 0
        while i < mark
        {
            out.add(c.enclosing_symbol_types[i])
            set i: i + 1
        }
        set c.enclosing_symbol_types: out
    }

    ; ── visitedTypes, symbolDepth, the type-parameter symbol list ────────────

    function visited_type(this, type_id: int) returns bool
    {
        let c this.the_ctx()
        var i 0
        let n c.visited_types.get_length() as int
        while i < n
        {
            if c.visited_types[i] = type_id
                return true
            set i: i + 1
        }
        false
    }

    procedure add_visited_type(mutable this, type_id: int)
        (this.the_ctx()).visited_types.add(type_id)

    procedure delete_visited_type(mutable this, type_id: int)
    {
        let c this.the_ctx()
        let n c.visited_types.get_length() as int
        var i n - 1
        while i >= 0
        {
            if c.visited_types[i] = type_id
            {
                let out &Array[int]^host()
                var j 0
                while j < n
                {
                    if j <> i
                        out.add(c.visited_types[j])
                    set j: j + 1
                }
                set c.visited_types: out
                return
            }
            set i: i - 1
        }
    }

    function symbol_depth_index(this, is_constructor: bool, symbol: ref[Symbol]?, node: ref[AstNode]?) returns int
    {
        let c this.the_ctx()
        var i 0
        let n c.symbol_depth.get_length() as int
        while i < n
        {
            let row c.symbol_depth[i]
            if row.is_constructor = is_constructor
            {
                var same true
                if row.symbol <> symbol
                    set same: false
                if row.node <> node
                    set same: false
                if same
                    return i
            }
            set i: i + 1
        }
        0 - 1
    }

    ; ── the small utilities of nodebuilderimpl.go ────────────────────────────

    procedure check_truncation_length(mutable this) returns bool
    {
        let c this.the_ctx()
        if c.truncating
            return true
        var max_length NbDefaultMaximumTruncationLength
        if (c.flags & NbFlagsNoTruncation) <> 0
            set max_length: NbNoTruncationMaximumTruncationLength
        else
        {
            if c.max_truncation_length > 0
                set max_length: c.max_truncation_length
        }
        set c.truncating: c.approximate_length > max_length
        c.truncating
    }

    procedure add_approximate_length(mutable this, n: int)
    {
        let c this.the_ctx()
        set c.approximate_length: c.approximate_length + n
    }

    ; the hover-expansion machinery: never on under declaration emit
    function should_expand_type(this, t: ref[Type], is_alias: bool) returns bool
    {
        let c this.the_ctx()
        if c.max_expansion_depth < 0
            return false
        false
    }

    function is_actively_expanding(this) returns bool
    {
        let c this.the_ctx()
        (c.max_expansion_depth > 0) and (c.depth < c.max_expansion_depth)
    }

    procedure check_type_expandability(this, t: ref[Type]?)
    {
        let c this.the_ctx()
        if c.max_expansion_depth < 0
            return
    }

    procedure create_elided_information_placeholder(mutable this) returns ref[AstNode]
    {
        this.add_approximate_length(3)
        if this.has_flag(NbFlagsNoTruncation) = false
            return factory.new_type_reference_node(factory.new_identifier("..."), null)
        context.add_synthetic_leading_comment(factory.new_keyword_type_node(KindAnyKeyword), KindMultiLineCommentTrivia, "elided", false)
    }

    ; newIdentifier: the idToSymbol table serves inlay hints only, not carried
    procedure new_identifier(mutable this, text: Slice[char]) returns ref[AstNode]
        factory.new_identifier(text)

    procedure new_string_literal(mutable this, text: Slice[char]) returns ref[AstNode]
        this.new_string_literal_ex(text, false)

    procedure new_string_literal_ex(mutable this, text: Slice[char], is_single_quote: bool) returns ref[AstNode]
    {
        var flags TokenFlagsNone
        if is_single_quote or this.has_flag(NbFlagsUseSingleQuotesForStringLiteralType)
            set flags: flags | TokenFlagsSingleQuote
        factory.new_string_literal(text, flags)
    }

    ; setCommentRange: comments carry over within the enclosing file only
    procedure set_comment_range(mutable this, mutable node: ref[AstNode], range_node: ref[AstNode]?)
    {
        if range_node = null
            return
        let c this.the_ctx()
        if c.enclosing_file = null
            return
        if Checker.source_file_of_node(range_node) <> c.enclosing_file
            return
        context.assign_comment_range(node, range_node as ref[AstNode])
    }

    ; setTextRange (nodebuilderimpl.go): a node from another file is cloned
    ; and loses its positions; the original pointer is set up unless `range`
    ; already points at `location`
    procedure set_text_range(mutable this, mutable range_in: ref[AstNode]?, location: ref[AstNode]?) returns ref[AstNode]?
    {
        if range_in = null
            return null
        var r range_in as ref[AstNode]
        let c this.the_ctx()
        var copy false
        if Printer.node_is_synthesized(r) = false
            set copy: true
        if (r.flags & NodeFlagsSynthesized) = 0
            set copy: true
        if c.enclosing_file = null
            set copy: true
        else
        {
            if c.enclosing_file <> Checker.source_file_of_node(context.most_original(r))
                set copy: true
        }
        if copy
        {
            set r: factory.clone(r)
            set r.pos: 0 - 1
            set r.end: 0 - 1
        }
        if location = null
            return r
        let loc location as ref[AstNode]
        if r = loc
            return r
        var original context.original(r)
        while original <> null
        {
            if (original as ref[AstNode]) = loc
                break
            set original: context.original(original as ref[AstNode])
        }
        if original = null
            context.set_original_ex(r, loc, true)
        if c.enclosing_file <> null
        {
            if c.enclosing_file = Checker.source_file_of_node(context.most_original(loc))
            {
                set r.pos: loc.pos
                set r.end: loc.end
                return r
            }
        }
        set r.pos: 0 - 1
        set r.end: 0 - 1
        r
    }

    procedure deep_clone(mutable this, mutable node: ref[AstNode]?) returns ref[AstNode]?
        DeepClone.deep_clone_node(host, factory, node)

    procedure deep_clone_req(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]
        DeepClone.deep_clone_node(host, factory, node) as ref[AstNode]

    ; a Slice of the builder's page from a builder
    procedure slice_of(mutable this, sb: ref[StringBuilder]) returns Slice[char]
        Printer.slice_on(host, sb.to_string())

    function slices_equal(a: Slice[char], b: Slice[char]) returns bool
        SymbolTable.names_equal(a, b)

    function starts_with_quote(s: Slice[char]) returns bool
    {
        if s.length = 0
            return false
        let c0 s[0]
        (c0 = ("'" as char)) or (c0 = ("\"" as char))
    }

    function starts_with_char(s: Slice[char], c: char) returns bool
    {
        if s.length = 0
            return false
        s[0] = c
    }

    ; jsnum.Number.String() into a fresh slice
    procedure number_text(mutable this, bits: u64) returns Slice[char]
    {
        let buf allocate_slice[char](host, 48)
        let n jsnum_to_string(bits, buf)
        buf.subslice(0, n as size_t)
    }

    procedure int_text(mutable this, v: int) returns Slice[char]
        this.number_text(jsnum_from_int(v))

    ; "<prefix>_<n>"
    procedure suffixed_name(mutable this, raw: Slice[char], n: int) returns Slice[char]
    {
        let sb StringBuilder^host()
        sb.append(raw.data, raw.length as size_t)
        sb.append("_" as char)
        let d this.int_text(n)
        sb.append(d.data, d.length as size_t)
        this.slice_of(sb)
    }

    procedure concat3(mutable this, a: Slice[char], b: Slice[char], c: Slice[char]) returns Slice[char]
    {
        let sb StringBuilder^host()
        sb.append(a.data, a.length as size_t)
        sb.append(b.data, b.length as size_t)
        sb.append(c.data, c.length as size_t)
        this.slice_of(sb)
    }

    function is_identifier_type_reference(node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if n.kind <> KindTypeReference
            return false
        let name AstNode.type_reference_name_of(n)
        if name = null
            return false
        (name as ref[AstNode]).kind = KindIdentifier
    }

    function types_are_same_reference(a: ref[Type], b: ref[Type]) returns bool
    {
        if a = b
            return true
        if a.symbol <> null
        {
            if a.symbol = b.symbol
                return true
        }
        if a.alias_symbol <> null
        {
            if a.alias_symbol = b.alias_symbol
                return true
        }
        false
    }

    ; ast.IsTypeNode
    function is_type_node_kind(k: int) returns bool
    {
        if (k >= KindFirstTypeNode) and (k <= KindLastTypeNode)
            return true
        if (k = KindAnyKeyword) or (k = KindUnknownKeyword) or (k = KindNumberKeyword) or (k = KindBigIntKeyword)
            return true
        if (k = KindObjectKeyword) or (k = KindBooleanKeyword) or (k = KindStringKeyword) or (k = KindSymbolKeyword)
            return true
        if (k = KindVoidKeyword) or (k = KindUndefinedKeyword) or (k = KindNeverKeyword) or (k = KindIntrinsicKeyword)
            return true
        if (k = KindExpressionWithTypeArguments) or (k = KindJSDocAllType) or (k = KindJSDocNullableType) or (k = KindJSDocNonNullableType)
            return true
        if (k = KindJSDocOptionalType) or (k = KindJSDocVariadicType)
            return true
        false
    }

    function is_accessor_kind(k: int) returns bool
        (k = KindGetAccessor) or (k = KindSetAccessor)

    ; ast.HasInferredType
    function has_inferred_type(k: int) returns bool
    {
        if (k = KindParameter) or (k = KindPropertySignature) or (k = KindPropertyDeclaration) or (k = KindBindingElement)
            return true
        if (k = KindPropertyAccessExpression) or (k = KindElementAccessExpression) or (k = KindBinaryExpression) or (k = KindCallExpression)
            return true
        if (k = KindVariableDeclaration) or (k = KindExportAssignment) or (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment)
            return true
        if (k = KindJSDocParameterTag) or (k = KindJSDocPropertyTag)
            return true
        false
    }

    function is_default_binding_context(node: ref[AstNode]) returns bool
    {
        if node.kind = KindSourceFile
            return true
        Binder.is_ambient_module(node)
    }

    function find_default_binding_context(node: ref[AstNode]?) returns ref[AstNode]?
    {
        var n node
        while n <> null
        {
            let cur n as ref[AstNode]
            if NodeBuilder.is_default_binding_context(cur)
                return cur
            set n: cur.parent
        }
        null
    }

    function is_class_like_kind(k: int) returns bool
        (k = KindClassDeclaration) or (k = KindClassExpression)

    ; containsNonMissingUndefinedType
    function contains_non_missing_undefined_type(this, t: ref[Type]) returns bool
    {
        var candidate t
        if (t.flags & TypeFlagsUnion) <> 0
        {
            let types Checker.union_types_of(t)
            if types <> null
            {
                let first (types as ref[Array[ref[Type]?]]).get(0)
                if first <> null
                    set candidate: first as ref[Type]
            }
        }
        if (candidate.flags & TypeFlagsUndefined) = 0
            return false
        candidate <> checker.missing_type
    }

    ; the value symbol links of a symbol — created on demand, exactly as the
    ; reference's Get; a null slot reads as the reference's Has() = false
    procedure links_of(mutable this, symbol: ref[Symbol]) returns ref[ValueSymbolLink]
        checker.value_symbol_link_of(symbol)

    procedure name_type_of(mutable this, symbol: ref[Symbol]) returns ref[Type]?
        (checker.value_symbol_link_of(symbol)).name_type

    function first_declaration(symbol: ref[Symbol]) returns ref[AstNode]?
    {
        if Symbol.declaration_count(symbol) = 0
            return null
        Symbol.declaration_at(symbol, 0)
    }

    ; getNameOfDeclaration through the binder
    function declaration_name_of(this, d: ref[AstNode]?) returns ref[AstNode]?
        (this.the_binder()).get_name_of_declaration(d)

    procedure is_value_symbol_accessible(mutable this, mutable symbol: ref[Symbol], mutable enclosing: ref[AstNode]?) returns bool
        (checker.is_symbol_accessible(symbol, enclosing, SymbolFlagsValue, false)).accessibility = SymbolAccessibilityAccessible

    procedure is_type_symbol_accessible(mutable this, mutable symbol: ref[Symbol], mutable enclosing: ref[AstNode]?) returns bool
        (checker.is_symbol_accessible(symbol, enclosing, SymbolFlagsType, false)).accessibility = SymbolAccessibilityAccessible

    procedure is_symbol_accessible_now(mutable this, mutable symbol: ref[Symbol], meaning: int) returns bool
        (checker.is_symbol_accessible(symbol, (this.the_ctx()).enclosing_declaration, meaning, false)).accessibility = SymbolAccessibilityAccessible

    ; getTypeFromTypeNode with the context's mapper applied
    procedure get_type_from_type_node(mutable this, mutable node: ref[AstNode], no_mapped_types: bool) returns ref[Type]?
    {
        let t checker.get_type_from_type_node(node)
        if t = null
            return null
        let c this.the_ctx()
        if c.mapper = null
            return t
        let instantiated checker.instantiate_type(t, c.mapper)
        if no_mapped_types
        {
            if instantiated <> t
                return null
        }
        instantiated
    }

    procedure try_get_resolved_symbol_from_type_node(mutable this, mutable node: ref[AstNode]?) returns ref[Symbol]?
    {
        if node = null
            return null
        let n node as ref[AstNode]
        checker.get_type_from_type_node(n)
        (checker.symbol_node_link_of(n)).resolved_symbol
    }

    procedure symbol_has_module_declaration(mutable this, symbol: ref[Symbol]) returns bool
        checker.symbol_has_non_global_augmentation_external_module_declaration(symbol)

    ; ── the symbol chain and the names it writes ─────────────────────────────

    function ctx_prefix(host: ref[Page], list: ref[Array[ref[NbContext]?]], n: int) returns ref[Array[ref[NbContext]?]]
    {
        let out &Array[ref[NbContext]?]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    ; lookupSymbolChain: track, then the worker
    procedure lookup_symbol_chain(mutable this, mutable symbol: ref[Symbol], meaning: int, yield_module_symbol: bool, mutable out: ref[Array[ref[Symbol]?]])
    {
        this.track_symbol(symbol, (this.the_ctx()).enclosing_declaration, meaning)
        this.lookup_symbol_chain_worker(symbol, meaning, yield_module_symbol, out)
    }

    ; lookupSymbolChainWorker: a type parameter is its own chain; under an
    ; enclosing declaration (or a fully-qualified ask) the chain is computed
    procedure lookup_symbol_chain_worker(mutable this, mutable symbol: ref[Symbol], meaning: int, yield_module_symbol: bool, mutable out: ref[Array[ref[Symbol]?]])
    {
        let c this.the_ctx()
        var compute false
        if (Symbol.flags_of(symbol) & SymbolFlagsTypeParameter) = 0
        {
            if (c.enclosing_declaration <> null) or ((c.flags & NbFlagsUseFullyQualifiedType) <> 0)
            {
                if (c.internal_flags & NbInternalFlagsDoNotIncludeSymbolChain) = 0
                    set compute: true
            }
        }
        if compute
        {
            this.get_symbol_chain(symbol, meaning, true, yield_module_symbol, out)
            if (out.get_length() as int) = 0
                out.add(symbol)
            return
        }
        out.add(symbol)
    }

    ; getSymbolChain — the checker's own port of it (slice 221) lacks the
    ; yieldModuleSymbol argument symbolToTypeNode sets, so it is written here
    ; against the same helpers. Two or more parents that are external modules
    ; are ordered by module SPECIFIER upstream (sortByBestName), which needs the
    ; modulespecifiers chapter — a said stop.
    procedure get_symbol_chain(mutable this, mutable symbol: ref[Symbol], meaning: int, end_of_chain: bool, yield_module_symbol: bool, mutable out: ref[Array[ref[Symbol]?]]) returns bool
    {
        this.sync_checker()
        let accessible &Array[ref[Symbol]?]^host()
        checker.get_accessible_symbol_chain(symbol, meaning, accessible)
        var qualifier_meaning meaning
        if (accessible.get_length() as int) > 1
            set qualifier_meaning: Checker.qualified_left_meaning(meaning)
        var go_up ((accessible.get_length() as int) = 0)
        if go_up = false
        {
            let head accessible[0]
            if head <> null
            {
                if checker.needs_qualification(head as ref[Symbol], qualifier_meaning)
                    set go_up: true
            }
        }
        var chained false
        if go_up
        {
            var root symbol
            if (accessible.get_length() as int) > 0
            {
                let head accessible[0]
                if head <> null
                    set root: head as ref[Symbol]
            }
            let parents &Array[ref[Symbol]?]^host()
            checker.containers_of_symbol(root, meaning, parents)
            let pn parents.get_length() as int
            ; parentSpecifiers: a module parent carries its specifier, and the
            ; parents are stably sorted by best name (sortByBestName)
            let parent_specifiers &Array[Slice[char]]^host()
            var pi 0
            while pi < pn
            {
                var parent_specifier Slice[char]()
                let po parents[pi]
                if po <> null
                {
                    if this.symbol_has_module_declaration(po as ref[Symbol])
                        set parent_specifier: this.get_specifier_for_module_symbol(po as ref[Symbol], ModuleKindNone)
                }
                parent_specifiers.add(parent_specifier)
                set pi: pi + 1
            }
            this.sort_by_best_name(parents, parent_specifiers)
            set pi: 0
            var going true
            if pn = 0
                set going: false
            while going
            {
                let po parents[pi]
                set pi: pi + 1
                if pi >= pn
                    set going: false
                if po <> null
                {
                    let parent po as ref[Symbol]
                    let parent_chain &Array[ref[Symbol]?]^host()
                    this.get_symbol_chain(parent, Checker.qualified_left_meaning(meaning), false, yield_module_symbol, parent_chain)
                    if (parent_chain.get_length() as int) > 0
                    {
                        var took false
                        let pexports Symbol.exports_of(parent)
                        if pexports <> null
                        {
                            let export_equals: Slice[char] "export="
                            let exported SymbolTable.get(pexports, export_equals)
                            if exported <> null
                            {
                                if checker.get_symbol_if_same_reference(exported, symbol) <> null
                                {
                                    Checker.append_symbols(out, parent_chain)
                                    set took: true
                                }
                            }
                        }
                        if took = false
                        {
                            Checker.append_symbols(out, parent_chain)
                            if (accessible.get_length() as int) > 0
                                Checker.append_symbols(out, accessible)
                            else
                            {
                                let fallback checker.get_alias_for_symbol_in_container(parent, symbol)
                                if fallback <> null
                                    out.add(fallback)
                                else
                                    out.add(symbol)
                            }
                        }
                        set chained: true
                        set going: false
                    }
                }
            }
        }
        if chained
            return true
        if (accessible.get_length() as int) > 0
        {
            Checker.append_symbols(out, accessible)
            return true
        }
        var write end_of_chain
        if (Symbol.flags_of(symbol) & (SymbolFlagsTypeLiteral | SymbolFlagsObjectLiteral)) = 0
            set write: true
        if write = false
            return false
        if end_of_chain = false
        {
            if yield_module_symbol = false
            {
                if this.symbol_has_module_declaration(symbol)
                    return false
            }
        }
        out.add(symbol)
        true
    }

    ; sortByBestName under slices.SortStableFunc: two specifiers by relativity then
    ; by path components, anything else by compareSymbols
    procedure sort_by_best_name(mutable this, mutable parents: ref[Array[ref[Symbol]?]], mutable specifiers: ref[Array[Slice[char]]])
    {
        let n parents.get_length() as int
        var i 1
        while i < n
        {
            let key_symbol parents[i as size_t]
            let key_name specifiers[i as size_t]
            var j i - 1
            while j >= 0
            {
                let cur_symbol parents[j as size_t]
                let cur_name specifiers[j as size_t]
                if this.compare_best_name(cur_symbol, cur_name, key_symbol, key_name) <= 0
                    break
                parents.put((j + 1) as size_t, cur_symbol)
                specifiers.put((j + 1) as size_t, cur_name)
                set j: j - 1
            }
            parents.put((j + 1) as size_t, key_symbol)
            specifiers.put((j + 1) as size_t, key_name)
            set i: i + 1
        }
    }

    procedure compare_best_name(mutable this, mutable a: ref[Symbol]?, specifier_a: Slice[char], mutable b: ref[Symbol]?, specifier_b: Slice[char]) returns int
    {
        if ((specifier_a.length as int) > 0) and ((specifier_b.length as int) > 0)
        {
            let b_relative path_is_relative(specifier_b)
            let a_relative path_is_relative(specifier_a)
            if a_relative = b_relative
                return SpecifierHost.count_path_components(specifier_a) - SpecifierHost.count_path_components(specifier_b)
            if b_relative
                return 0 - 1
            return 1
        }
        checker.compare_symbols(a, b)
    }

    ; the module specifier host over the program the transformer emits
    procedure the_specifier_host(mutable this) returns ref[SpecifierHost]?
    {
        if specifier_host <> null
            return specifier_host
        if tracker = null
            return null
        if checker.program = null
            return null
        let t tracker as ref[Transformer]
        let emit_options t.opts.options
        let made SpecifierHost.create(host, checker, checker.program as ref[ProgramFiles], emit_options)
        set this.specifier_host: made
        made
    }

    ; canHaveModuleSpecifier
    function can_have_module_specifier(k: int) returns bool
    {
        if (k = KindVariableDeclaration) or (k = KindBindingElement) or (k = KindImportDeclaration) or (k = KindExportDeclaration) or (k = KindImportEqualsDeclaration) or (k = KindImportClause)
            return true
        (k = KindNamespaceExport) or (k = KindNamespaceImport) or (k = KindExportSpecifier) or (k = KindImportSpecifier) or (k = KindImportType)
    }

    ; TryGetModuleSpecifierFromDeclaration: the worker's node when it is a string literal
    function try_get_module_specifier_from_declaration(node: ref[AstNode]) returns ref[AstNode]?
    {
        let res NodeBuilder.try_get_module_specifier_from_declaration_worker(node)
        if res = null
            return null
        if (res as ref[AstNode]).kind <> KindStringLiteral
            return null
        res
    }

    function try_get_module_specifier_from_declaration_worker(node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if (k = KindVariableDeclaration) or (k = KindBindingElement)
        {
            var a AstNode.initializer_of(node)
            while a <> null
            {
                if Parser.is_require_call(a, true)
                    return AstNode.child_in_list(AstNode.call_arguments_of(a), 0)
                set a: AstNode.parent_node_of(a)
            }
            return null
        }
        if (k = KindImportDeclaration) or (k = KindExportDeclaration)
            return AstNode.module_specifier_of(node)
        if k = KindImportEqualsDeclaration
        {
            let module_reference AstNode.module_reference_of(node)
            if AstNode.kind_of(module_reference) <> KindExternalModuleReference
                return null
            return AstNode.expression_of(module_reference)
        }
        if k = KindImportClause
            return AstNode.module_specifier_of(AstNode.parent_node_of(node))
        if k = KindNamespaceExport
            return AstNode.module_specifier_of(AstNode.parent_node_of(node))
        if (k = KindNamespaceImport) or (k = KindExportSpecifier)
            return AstNode.module_specifier_of(AstNode.parent_node_of(AstNode.parent_node_of(node)))
        if k = KindImportSpecifier
            return AstNode.module_specifier_of(AstNode.parent_node_of(AstNode.parent_node_of(AstNode.parent_node_of(node))))
        if k = KindImportType
        {
            if Transformer.dt_is_literal_import_type_node(node)
                return AstNode.literal_type_inner_of(AstNode.import_type_argument_of(node))
            return null
        }
        null
    }

    ; getSpecifierForModuleSymbol
    procedure get_specifier_for_module_symbol(mutable this, mutable symbol: ref[Symbol], override_import_mode: int) returns Slice[char]
    {
        var file Checker.get_declaration_of_kind(symbol, KindSourceFile)
        if file = null
        {
            let n Symbol.declaration_count(symbol)
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(symbol, i)
                if d <> null
                {
                    let equivalent checker.get_file_symbol_if_file_symbol_export_equals_container(d as ref[AstNode], symbol)
                    if equivalent <> null
                    {
                        set file: Checker.get_declaration_of_kind(equivalent as ref[Symbol], KindSourceFile)
                        set i: n
                    }
                }
                set i: i + 1
            }
        }
        let name Symbol.name_of(symbol)
        if file = null
        {
            if Checker.is_ambient_module_symbol_name(name)
                return name.subslice(1, (name.length - 1) as size_t)
        }
        let c this.the_ctx()
        let sh_opt this.the_specifier_host()
        if c.enclosing_file = null
        {
            if Checker.is_ambient_module_symbol_name(name)
                return name.subslice(1, (name.length - 1) as size_t)
            if sh_opt = null
            {
                this.record_unported("node-builder-module-specifier", 1)
                return Slice[char]()
            }
            let module_file (sh_opt as ref[SpecifierHost]).get_source_file_of_module(symbol)
            if module_file = null
                return Slice[char]()
            return (sh_opt as ref[SpecifierHost]).file_name_of(module_file as ref[AstNode])
        }
        if sh_opt = null
        {
            this.record_unported("node-builder-module-specifier", 0)
            return Slice[char]()
        }
        let sh sh_opt as ref[SpecifierHost]
        let enclosing_declaration context.most_original(c.enclosing_declaration)
        var original_module_specifier: ref[AstNode]? null
        if enclosing_declaration <> null
        {
            let ed enclosing_declaration as ref[AstNode]
            if NodeBuilder.can_have_module_specifier(ed.kind)
                set original_module_specifier: NodeBuilder.try_get_module_specifier_from_declaration(ed)
        }
        let context_file c.enclosing_file as ref[AstNode]
        var resolution_mode override_import_mode
        if resolution_mode = ModuleKindNone
        {
            if original_module_specifier <> null
                set resolution_mode: sh.get_mode_for_usage_location(context_file, original_module_specifier as ref[AstNode])
            else
                set resolution_mode: sh.get_default_resolution_mode_for_file(context_file)
        }
        let context_name sh.file_name_of(context_file)
        let file_path sh.to_path(context_name)
        var r 0
        while r < (specifier_cache.get_length() as int)
        {
            let row_opt specifier_cache[r as size_t]
            set r: r + 1
            if row_opt = null
                continue
            let row row_opt as ref[NbSpecifierRow]
            if row.symbol <> symbol
                continue
            if row.mode <> resolution_mode
                continue
            if row.file_path.equals(file_path)
                return row.specifier
        }
        ; a declaration bundle's absolute paths would ride on baseUrl and a
        ; non-relative preference; the preference is project-relative, the ending
        ; `.js` under ESM
        var ending_preference ImportSpecifierEndingPreferenceNone
        if resolution_mode = ModuleKindESNext
            set ending_preference: ImportSpecifierEndingPreferenceJs
        let all_specifiers sh.get_module_specifiers(symbol, context_file, ImportSpecifierPreferenceProjectRelative, ending_preference, override_import_mode)
        var specifier Slice[char]()
        if (all_specifiers.get_length() as int) > 0
            set specifier: all_specifiers[0]
        let memo &NbSpecifierRow^host(symbol, file_path, resolution_mode, specifier)
        specifier_cache.add(memo)
        specifier
    }

    ; symbolToTypeNode
    procedure symbol_to_type_node(mutable this, mutable symbol: ref[Symbol], mask: int, mutable type_arguments: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        let chain &Array[ref[Symbol]?]^host()
        this.lookup_symbol_chain(symbol, mask, this.has_flag(NbFlagsUseAliasDefinedOutsideCurrentScope) = false, chain)
        let n chain.get_length() as int
        if n = 0
            return null
        let is_type_of (mask = SymbolFlagsValue)
        let root chain[0] as ref[Symbol]
        if this.symbol_has_module_declaration(root)
        {
            ; the module is the chain's root: an ImportTypeNode
            var non_root_parts: ref[AstNode]? null
            if n > 1
                set non_root_parts: this.create_access_from_symbol_chain(chain, n - 1, 1, type_arguments)
            var type_parameter_nodes type_arguments
            if type_parameter_nodes = null
                set type_parameter_nodes: this.lookup_type_parameter_nodes(chain, 0)
            let mark unported_count
            let c this.the_ctx()
            let context_file Checker.source_file_of_node(context.most_original(c.enclosing_declaration))
            var target_file: ref[AstNode]? null
            let sh this.the_specifier_host()
            if sh <> null
                set target_file: (sh as ref[SpecifierHost]).get_source_file_of_module(root)
            var specifier Slice[char]()
            var attributes: ref[AstNode]? null
            let module_resolution checker.module_resolution_kind
            let node_resolution ((module_resolution = ModuleResolutionKindNode16) or (module_resolution = ModuleResolutionKindNodeNext))
            if node_resolution and (target_file <> null) and (context_file <> null)
            {
                ; an import type at an ESM file resolves only in ESM mode
                let target_format checker.file_emit_format_of(target_file)
                let context_format checker.file_emit_format_of(context_file)
                if (target_format = ModuleKindESNext) and (target_format <> context_format)
                {
                    set specifier: this.get_specifier_for_module_symbol(root, ModuleKindESNext)
                    set attributes: this.new_resolution_mode_attributes("import")
                }
            }
            if (specifier.length as int) = 0
                set specifier: this.get_specifier_for_module_symbol(root, ModuleKindNone)
            if ((c.flags & NbFlagsAllowNodeModulesRelativePaths) = 0) and slice_contains_node_modules(specifier)
            {
                let old_specifier specifier
                if node_resolution
                {
                    ; a portable import type through a mode override, maybe
                    var swapped_mode ModuleKindESNext
                    if context_file <> null
                    {
                        if checker.file_emit_format_of(context_file) = ModuleKindESNext
                            set swapped_mode: ModuleKindCommonJS
                    }
                    set specifier: this.get_specifier_for_module_symbol(root, swapped_mode)
                    if slice_contains_node_modules(specifier)
                        set specifier: old_specifier
                    else
                    {
                        if swapped_mode = ModuleKindESNext
                            set attributes: this.new_resolution_mode_attributes("import")
                        else
                            set attributes: this.new_resolution_mode_attributes("require")
                    }
                }
                if attributes = null
                {
                    ; a reference into node_modules is liable to fail when published
                    set c.encountered_error: true
                    this.report_likely_unsafe_import_required_error(old_specifier, Symbol.name_of(symbol))
                }
            }
            if unported_count > mark
                return null
            let lit factory.new_literal_type_node(this.new_string_literal(specifier))
            this.add_approximate_length(specifier.length + 10)
            var entity true
            if non_root_parts <> null
            {
                if Checker.is_entity_name(non_root_parts) = false
                    set entity: false
            }
            if entity
                return factory.new_import_type_node(is_type_of, lit, attributes, non_root_parts, type_parameter_nodes)
            let split_node NodeBuilder.get_topmost_indexed_access_type(non_root_parts as ref[AstNode])
            let object_type AstNode.indexed_access_object_type_of(split_node) as ref[AstNode]
            let qualifier AstNode.type_reference_name_of(object_type)
            return factory.new_indexed_access_type_node(factory.new_import_type_node(is_type_of, lit, attributes, qualifier, type_parameter_nodes), AstNode.indexed_access_index_type_of(split_node))
        }
        let entity_name this.create_access_from_symbol_chain(chain, n - 1, 0, type_arguments)
        if entity_name = null
            return null
        let en entity_name as ref[AstNode]
        if en.kind = KindIndexedAccessType
            return en
        if Checker.is_entity_name(en)
        {
            if is_type_of
                return factory.new_type_query_node(en, null)
            return factory.new_type_reference_node(en, type_arguments)
        }
        if is_type_of and (en.kind = KindExpressionWithTypeArguments)
            return factory.new_type_query_node(this.deep_clone(AstNode.expression_of(en)), AstNode.type_arguments_of(en))
        en
    }

    ; `with { "resolution-mode": "<mode>" }`
    procedure new_resolution_mode_attributes(mutable this, mode: Slice[char]) returns ref[AstNode]
    {
        let key: Slice[char] "resolution-mode"
        let attribute factory.new_import_attribute(this.new_string_literal(key), this.new_string_literal(mode))
        let list &Array[ref[AstNode]?]^host()
        list.add(attribute)
        factory.new_import_attributes(KindWithKeyword, list, false)
    }

    function get_topmost_indexed_access_type(node: ref[AstNode]) returns ref[AstNode]
    {
        let object_type AstNode.indexed_access_object_type_of(node)
        if object_type <> null
        {
            if (object_type as ref[AstNode]).kind = KindIndexedAccessType
                return NodeBuilder.get_topmost_indexed_access_type(object_type as ref[AstNode])
        }
        node
    }

    ; createAccessFromSymbolChain
    procedure create_access_from_symbol_chain(mutable this, mutable chain: ref[Array[ref[Symbol]?]], index: int, stopper: int, mutable override_type_arguments: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        let n chain.get_length() as int
        var type_parameter_nodes override_type_arguments
        if index <> (n - 1)
            set type_parameter_nodes: this.lookup_type_parameter_nodes(chain, index)
        let symbol chain[index] as ref[Symbol]
        var parent: ref[Symbol]? null
        if index > 0
            set parent: chain[index - 1]
        var symbol_name Slice[char]()
        if index = 0
        {
            this.add_flag(NbFlagsInInitialEntityName)
            set symbol_name: this.get_name_of_symbol_as_written(symbol)
            this.add_approximate_length(symbol_name.length + 1)
            this.clear_flag(NbFlagsInInitialEntityName)
        }
        else
        {
            ; a ref to symbol within parent handles export aliases
            if parent <> null
            {
                let exports checker.get_exports_of_symbol(parent as ref[Symbol])
                if exports <> null
                {
                    let export_equals: Slice[char] "export="
                    let own_name Symbol.name_of(symbol)
                    var direct false
                    if SymbolTable.names_equal(own_name, export_equals) = false
                    {
                        if Checker.is_late_bound_name(own_name) = false
                        {
                            let res SymbolTable.get(exports, own_name)
                            if res <> null
                            {
                                if checker.get_symbol_if_same_reference(res, symbol) <> null
                                    set direct: true
                            }
                        }
                    }
                    if direct
                        set symbol_name: own_name
                    else
                    {
                        ; the least symbol among every export naming this one
                        var best: ref[Symbol]? null
                        var best_name Slice[char]()
                        let count SymbolTable.length(exports)
                        var i 0
                        while i < count
                        {
                            let ex SymbolTable.entry_symbol_at(exports, i)
                            if ex <> null
                            {
                                let ename SymbolTable.entry_name_at(exports, i)
                                if checker.get_symbol_if_same_reference(ex, symbol) <> null
                                {
                                    if Checker.is_late_bound_name(ename) = false
                                    {
                                        if SymbolTable.names_equal(ename, export_equals) = false
                                        {
                                            var take (best = null)
                                            if take = false
                                            {
                                                if checker.compare_symbols(ex, best) < 0
                                                    set take: true
                                            }
                                            if take
                                            {
                                                set best: ex
                                                set best_name: ename
                                            }
                                        }
                                    }
                                }
                            }
                            set i: i + 1
                        }
                        if best <> null
                            set symbol_name: best_name
                    }
                }
            }
        }
        if symbol_name.length = 0
        {
            var name: ref[AstNode]? null
            let dn Symbol.declaration_count(symbol)
            var di 0
            while di < dn
            {
                let d Symbol.declaration_at(symbol, di)
                set name: this.declaration_name_of(d)
                if name <> null
                    set di: dn
                set di: di + 1
            }
            if name <> null
            {
                let nm name as ref[AstNode]
                if nm.kind = KindComputedPropertyName
                {
                    let ne AstNode.expression_of(nm)
                    if Checker.is_entity_name(ne)
                    {
                        let lhs this.create_access_from_symbol_chain(chain, index - 1, stopper, override_type_arguments)
                        if lhs = null
                            return null
                        if Checker.is_entity_name(lhs)
                            return factory.new_indexed_access_type_node(factory.new_parenthesized_type_node(factory.new_type_query_node(lhs, null)), factory.new_type_query_node(ne, null))
                        return lhs
                    }
                }
            }
            set symbol_name: this.get_name_of_symbol_as_written(symbol)
        }
        this.add_approximate_length(symbol_name.length + 1)
        if (this.has_flag(NbFlagsForbidIndexedAccessSymbolReferences) = false) and (parent <> null)
        {
            let members checker.get_members_of_symbol(parent as ref[Symbol])
            if members <> null
            {
                let member SymbolTable.get(members, Symbol.name_of(symbol))
                if member <> null
                {
                    if checker.get_symbol_if_same_reference(member, symbol) <> null
                    {
                        ; an indexed access
                        let lhs this.create_access_from_symbol_chain(chain, index - 1, stopper, override_type_arguments)
                        if lhs = null
                            return null
                        if (lhs as ref[AstNode]).kind = KindIndexedAccessType
                            return factory.new_indexed_access_type_node(lhs, factory.new_literal_type_node(this.new_string_literal(symbol_name)))
                        return factory.new_indexed_access_type_node(factory.new_type_reference_node(lhs, type_parameter_nodes), factory.new_literal_type_node(this.new_string_literal(symbol_name)))
                    }
                }
            }
        }
        let identifier this.new_identifier(symbol_name)
        context.add_emit_flags(identifier, EFNoAsciiEscaping)
        if index > stopper
        {
            let lhs this.create_access_from_symbol_chain(chain, index - 1, stopper, override_type_arguments)
            if lhs = null
                return null
            var qualified (this.has_flag(NbFlagsUseInstantiationExpressions) = false)
            if qualified = false
            {
                if Checker.is_entity_name(lhs)
                {
                    if (type_parameter_nodes = null) or (AstNode.list_count(type_parameter_nodes) = 0)
                        set qualified: true
                }
            }
            if qualified
                return factory.new_qualified_name(lhs, identifier)
            let access this.create_access_expression(lhs as ref[AstNode])
            if access = null
                return null
            return this.create_expression_with_type_arguments(factory.new_property_access_expression(access, null, identifier, NodeFlagsNone), type_parameter_nodes)
        }
        identifier
    }

    ; symbolToExpression
    procedure symbol_to_expression(mutable this, mutable symbol: ref[Symbol], mask: int) returns ref[AstNode]?
    {
        let chain &Array[ref[Symbol]?]^host()
        this.lookup_symbol_chain(symbol, mask, false, chain)
        this.create_expression_from_symbol_chain(chain, (chain.get_length() as int) - 1)
    }

    ; createExpressionFromSymbolChain
    procedure create_expression_from_symbol_chain(mutable this, mutable chain: ref[Array[ref[Symbol]?]], index: int) returns ref[AstNode]?
    {
        let type_parameter_nodes this.lookup_expression_chain_type_argument_nodes(chain, index)
        let symbol chain[index] as ref[Symbol]
        if index = 0
            this.add_flag(NbFlagsInInitialEntityName)
        var symbol_name this.get_name_of_symbol_as_written(symbol)
        if index = 0
            this.clear_flag(NbFlagsInInitialEntityName)
        if NodeBuilder.starts_with_quote(symbol_name)
        {
            if this.symbol_has_module_declaration(symbol)
            {
                let specifier this.get_specifier_for_module_symbol(symbol, 0)
                if unported_count > 0
                    return null
                this.add_approximate_length(2 + specifier.length)
                return this.new_string_literal(specifier)
            }
        }
        if (index = 0) or NodeBuilder.can_use_property_access(symbol_name)
        {
            let identifier this.new_identifier(symbol_name)
            context.add_emit_flags(identifier, EFNoAsciiEscaping)
            this.add_approximate_length(1 + symbol_name.length)
            if index > 0
            {
                let lhs this.create_expression_from_symbol_chain(chain, index - 1)
                if lhs = null
                    return null
                let result factory.new_property_access_expression(lhs, null, identifier, NodeFlagsNone)
                context.add_emit_flags(result, EFNoIndentation)
                return this.create_expression_with_type_arguments(result, type_parameter_nodes)
            }
            return this.create_expression_with_type_arguments(identifier, type_parameter_nodes)
        }
        if NodeBuilder.starts_with_char(symbol_name, "[" as char)
            set symbol_name: symbol_name.subslice(1, (symbol_name.length - 1) as size_t)
        var expression: ref[AstNode]? null
        if NodeBuilder.starts_with_quote(symbol_name) and ((Symbol.flags_of(symbol) & SymbolFlagsEnumMember) = 0)
        {
            let literal_text symbol_name.subslice(1, (symbol_name.length - 1) as size_t)
            this.add_approximate_length(literal_text.length + 2)
            set expression: this.new_string_literal_ex(literal_text, symbol_name[0] = ("'" as char))
        }
        else
        {
            let bits jsnum_from_string(symbol_name)
            if SymbolTable.names_equal(this.number_text(bits), symbol_name)
            {
                this.add_approximate_length(symbol_name.length)
                set expression: factory.new_numeric_literal(symbol_name, TokenFlagsNone)
            }
        }
        if expression = null
        {
            this.add_approximate_length(symbol_name.length)
            let id this.new_identifier(symbol_name)
            context.add_emit_flags(id, EFNoAsciiEscaping)
            set expression: id
        }
        this.add_approximate_length(2)
        let lhs this.create_expression_from_symbol_chain(chain, index - 1)
        if lhs = null
            return null
        this.create_expression_with_type_arguments(factory.new_element_access_expression(lhs, null, expression, NodeFlagsNone), type_parameter_nodes)
    }

    function can_use_property_access(name: Slice[char]) returns bool
    {
        if name.length = 0
            return false
        if name[0] = ("#" as char)
        {
            if name.length <= 1
                return false
            return Checker.is_identifier_text(name.slice_from(1))
        }
        Checker.is_identifier_text(name)
    }

    ; symbolToName
    procedure symbol_to_name(mutable this, mutable symbol: ref[Symbol], meaning: int, expects_identifier: bool) returns ref[AstNode]?
    {
        let chain &Array[ref[Symbol]?]^host()
        this.lookup_symbol_chain(symbol, meaning, false, chain)
        let c this.the_ctx()
        let n chain.get_length() as int
        if expects_identifier and (n <> 1) and (c.encountered_error = false) and ((c.flags & NbFlagsAllowQualifiedNameInPlaceOfIdentifier) <> 0)
            this.note_error("e1")
        this.create_entity_name_from_symbol_chain(chain, n - 1)
    }

    ; createEntityNameFromSymbolChain
    procedure create_entity_name_from_symbol_chain(mutable this, mutable chain: ref[Array[ref[Symbol]?]], index: int) returns ref[AstNode]?
    {
        let symbol chain[index] as ref[Symbol]
        if index = 0
            this.add_flag(NbFlagsInInitialEntityName)
        let symbol_name this.get_name_of_symbol_as_written(symbol)
        if index = 0
            this.clear_flag(NbFlagsInInitialEntityName)
        let identifier this.new_identifier(symbol_name)
        context.add_emit_flags(identifier, EFNoAsciiEscaping)
        if index > 0
            return factory.new_qualified_name(this.create_entity_name_from_symbol_chain(chain, index - 1), identifier)
        identifier
    }

    ; symbolToEntityNameNode: the symbol's own name, through its parents
    procedure symbol_to_entity_name_node(mutable this, symbol: ref[Symbol]) returns ref[AstNode]
    {
        let identifier this.new_identifier(Symbol.name_of(symbol))
        let parent Symbol.parent_of(symbol)
        if parent <> null
            return factory.new_qualified_name(this.symbol_to_entity_name_node(parent as ref[Symbol]), identifier)
        identifier
    }

    ; symbolToNode
    procedure symbol_to_node(mutable this, mutable symbol: ref[Symbol], meaning: int) returns ref[AstNode]?
    {
        if this.has_internal_flag(NbInternalFlagsWriteComputedProps)
        {
            let vd Symbol.value_declaration_of(symbol)
            if vd <> null
            {
                let name this.declaration_name_of(vd)
                if name <> null
                {
                    if (name as ref[AstNode]).kind = KindComputedPropertyName
                        return name
                }
            }
            let name_type this.name_type_of(symbol)
            if name_type <> null
            {
                let nt name_type as ref[Type]
                if (nt.flags & (TypeFlagsEnumLiteral | TypeFlagsUniqueESSymbol)) <> 0
                {
                    if nt.symbol <> null
                    {
                        let c this.the_ctx()
                        let old_enclosing c.enclosing_declaration
                        this.set_enclosing(Symbol.value_declaration_of(nt.symbol as ref[Symbol]))
                        let result factory.new_computed_property_name(this.symbol_to_expression(nt.symbol as ref[Symbol], meaning))
                        this.set_enclosing(old_enclosing)
                        return result
                    }
                }
            }
        }
        this.symbol_to_expression(symbol, meaning)
    }

    ; getNameOfSymbolFromNameType, through the checker's writer
    procedure get_name_of_symbol_from_name_type(mutable this, symbol: ref[Symbol]) returns Slice[char]
    {
        let sb StringBuilder^host()
        var wrote false
        checker.write_name_of_symbol_from_name_type(symbol, &sb, &wrote)
        if wrote = false
            return Slice[char]()
        this.slice_of(&sb)
    }

    ; getNameOfSymbolAsWritten
    procedure get_name_of_symbol_as_written(mutable this, symbol: ref[Symbol]) returns Slice[char]
    {
        let c this.the_ctx()
        let default_name: Slice[char] "default"
        let name Symbol.name_of(symbol)
        if SymbolTable.names_equal(name, default_name) and ((c.flags & NbFlagsUseAliasDefinedOutsideCurrentScope) = 0)
        {
            var print_default false
            if (c.flags & NbFlagsInInitialEntityName) = 0
                set print_default: true
            if Symbol.declaration_count(symbol) = 0
                set print_default: true
            if (print_default = false) and (c.enclosing_declaration <> null)
            {
                let d0 Symbol.declaration_at(symbol, 0)
                if NodeBuilder.find_default_binding_context(d0) <> NodeBuilder.find_default_binding_context(c.enclosing_declaration)
                    set print_default: true
            }
            if print_default
                return default_name
        }
        let dn Symbol.declaration_count(symbol)
        if dn > 0
        {
            var dname: ref[AstNode]? null
            var di 0
            while di < dn
            {
                set dname: this.declaration_name_of(Symbol.declaration_at(symbol, di))
                if dname <> null
                    set di: dn
                set di: di + 1
            }
            if dname <> null
            {
                let nm dname as ref[AstNode]
                if (nm.kind = KindComputedPropertyName) and ((Symbol.check_flags_of(symbol) & CheckFlagsLate) = 0)
                {
                    let name_type this.name_type_of(symbol)
                    if name_type <> null
                    {
                        if ((name_type as ref[Type]).flags & TypeFlagsStringOrNumberLiteral) <> 0
                        {
                            let from_type this.get_name_of_symbol_from_name_type(symbol)
                            if from_type.length > 0
                                return from_type
                        }
                    }
                }
                return this.declaration_name_text(nm)
            }
            let declaration Symbol.declaration_at(symbol, 0) as ref[AstNode]
            let parent declaration.parent
            if parent <> null
            {
                if (parent as ref[AstNode]).kind = KindVariableDeclaration
                    return this.declaration_name_text(AstNode.name_of(parent as ref[AstNode]) as ref[AstNode])
            }
            let k declaration.kind
            if (k = KindClassExpression) or (k = KindFunctionExpression) or (k = KindArrowFunction)
            {
                if (c.encountered_error = false) and ((c.flags & NbFlagsAllowAnonymousIdentifier) = 0)
                    this.note_error("e2")
                if k = KindClassExpression
                {
                    let anon_class: Slice[char] "(Anonymous class)"
                    return anon_class
                }
                let anon_function: Slice[char] "(Anonymous function)"
                return anon_function
            }
        }
        let from_type this.get_name_of_symbol_from_name_type(symbol)
        if from_type.length > 0
            return from_type
        let sb StringBuilder^host()
        Checker.write_escaped_internal_symbol_name(&sb, name)
        this.slice_of(&sb)
    }

    ; scanner.DeclarationNameToString through the checker's writer
    procedure declaration_name_text(mutable this, name: ref[AstNode]) returns Slice[char]
    {
        let sb StringBuilder^host()
        checker.write_declaration_name(name, &sb)
        this.slice_of(&sb)
    }

    ; ── type parameters ──────────────────────────────────────────────────────

    ; getTypeParametersOfClassOrInterface: outer, then local
    procedure get_type_parameters_of_class_or_interface(mutable this, mutable symbol: ref[Symbol]) returns ref[Array[ref[Type]?]]
    {
        let result &Array[ref[Type]?]^host()
        let outer checker.get_outer_type_parameters_of_class_or_interface(symbol)
        if outer <> null
        {
            let o outer as ref[Array[ref[Type]?]]
            var i 0
            while i < (o.get_length() as int)
            {
                result.add(o[i])
                set i: i + 1
            }
        }
        let local checker.get_local_type_parameters_of_class_or_interface_or_type_alias(symbol)
        if local <> null
        {
            let l local as ref[Array[ref[Type]?]]
            var i 0
            while i < (l.get_length() as int)
            {
                result.add(l[i])
                set i: i + 1
            }
        }
        result
    }

    ; lookupTypeParameterNodes
    procedure lookup_type_parameter_nodes(mutable this, mutable chain: ref[Array[ref[Symbol]?]], index: int) returns ref[Array[ref[AstNode]?]]?
    {
        let symbol chain[index] as ref[Symbol]
        if this.type_parameter_symbol_listed(symbol)
            return null
        (this.the_ctx()).type_parameter_symbol_list.add(symbol)
        if this.has_flag(NbFlagsWriteTypeParametersInQualifiedName) and (index < ((chain.get_length() as int) - 1))
        {
            let type_argument_nodes this.lookup_instantiated_type_argument_nodes(chain, index)
            if type_argument_nodes <> null
                return type_argument_nodes
            let type_parameter_nodes this.type_parameters_to_type_parameter_declarations(symbol)
            if type_parameter_nodes <> null
            {
                if AstNode.list_count(type_parameter_nodes) > 0
                    return type_parameter_nodes
            }
            return null
        }
        null
    }

    function should_write_type_parameters_in_qualified_name(this, chain: ref[Array[ref[Symbol]?]], index: int) returns bool
        this.has_flag(NbFlagsWriteTypeParametersInQualifiedName) and (index < ((chain.get_length() as int) - 1))

    ; lookupInstantiatedTypeArgumentNodes
    procedure lookup_instantiated_type_argument_nodes(mutable this, mutable chain: ref[Array[ref[Symbol]?]], index: int) returns ref[Array[ref[AstNode]?]]?
    {
        if this.should_write_type_parameters_in_qualified_name(chain, index) = false
            return null
        let symbol chain[index] as ref[Symbol]
        let next_symbol chain[index + 1] as ref[Symbol]
        if (Symbol.check_flags_of(next_symbol) & CheckFlagsInstantiated) = 0
            return null
        var target_symbol symbol
        if (Symbol.flags_of(symbol) & SymbolFlagsAlias) <> 0
        {
            let resolved checker.resolve_alias(symbol)
            if resolved <> null
                set target_symbol: resolved as ref[Symbol]
        }
        let params this.get_type_parameters_of_class_or_interface(target_symbol)
        let target_mapper (this.links_of(next_symbol)).mapper
        if target_mapper <> null
        {
            let mapped &Array[ref[Type]?]^host()
            var i 0
            while i < (params.get_length() as int)
            {
                mapped.add(checker.instantiate_type(params[i], target_mapper))
                set i: i + 1
            }
            return this.map_to_type_nodes(mapped, false)
        }
        this.map_to_type_nodes(params, false)
    }

    ; lookupExpressionChainTypeArgumentNodes
    procedure lookup_expression_chain_type_argument_nodes(mutable this, mutable chain: ref[Array[ref[Symbol]?]], index: int) returns ref[Array[ref[AstNode]?]]?
    {
        if this.should_write_type_parameters_in_qualified_name(chain, index) = false
            return null
        let symbol chain[index] as ref[Symbol]
        if this.type_parameter_symbol_listed(symbol)
            return null
        (this.the_ctx()).type_parameter_symbol_list.add(symbol)
        let type_argument_nodes this.lookup_instantiated_type_argument_nodes(chain, index)
        if type_argument_nodes <> null
            return type_argument_nodes
        let type_parameter_nodes this.type_parameters_to_type_parameter_declarations(symbol)
        if type_parameter_nodes <> null
        {
            if AstNode.list_count(type_parameter_nodes) > 0
                return type_parameter_nodes
        }
        null
    }

    ; typeParametersToTypeParameterDeclarations
    procedure type_parameters_to_type_parameter_declarations(mutable this, mutable symbol: ref[Symbol]) returns ref[Array[ref[AstNode]?]]?
    {
        let target_symbol checker.get_target_symbol(symbol)
        if target_symbol = null
            return null
        let tflags Symbol.flags_of(target_symbol as ref[Symbol])
        if (tflags & (SymbolFlagsClass | SymbolFlagsInterface | SymbolFlagsAlias)) <> 0
        {
            let results &Array[ref[AstNode]?]^host()
            let params checker.get_local_type_parameters_of_class_or_interface_or_type_alias(symbol)
            if params <> null
            {
                let ps params as ref[Array[ref[Type]?]]
                var i 0
                while i < (ps.get_length() as int)
                {
                    let p ps[i]
                    if p <> null
                        results.add(this.type_parameter_to_declaration(p as ref[Type]))
                    set i: i + 1
                }
            }
            return results
        }
        if (tflags & SymbolFlagsFunction) <> 0
        {
            let results &Array[ref[AstNode]?]^host()
            let vd Symbol.value_declaration_of(symbol)
            if vd <> null
            {
                let params checker.get_type_parameters_from_declaration(vd as ref[AstNode])
                if params <> null
                {
                    let ps params as ref[Array[ref[Type]?]]
                    var i 0
                    while i < (ps.get_length() as int)
                    {
                        let p ps[i]
                        if p <> null
                            results.add(this.type_parameter_to_declaration(p as ref[Type]))
                        set i: i + 1
                    }
                }
            }
            return results
        }
        null
    }

    ; typeParameterToDeclaration
    procedure type_parameter_to_declaration(mutable this, mutable parameter: ref[Type]) returns ref[AstNode]?
    {
        let constraint checker.get_constraint_of_type_parameter(parameter)
        var constraint_node: ref[AstNode]? null
        if constraint <> null
            set constraint_node: this.type_to_type_node_helper_with_possible_reusable_type_node(constraint, checker.get_constraint_declaration(parameter))
        this.type_parameter_to_declaration_with_constraint(parameter, constraint_node)
    }

    ; typeToTypeNodeHelperWithPossibleReusableTypeNode
    procedure type_to_type_node_helper_with_possible_reusable_type_node(mutable this, mutable t: ref[Type]?, mutable type_node: ref[AstNode]?) returns ref[AstNode]?
    {
        if t = null
            return factory.new_keyword_type_node(KindAnyKeyword)
        if (this.is_actively_expanding() = false) and (type_node <> null)
        {
            let tn type_node as ref[AstNode]
            if this.get_type_from_type_node(tn, false) = t
            {
                let reused this.try_reuse_existing_node_helper(tn)
                if reused <> null
                {
                    this.check_type_expandability(t)
                    return reused
                }
            }
        }
        this.type_to_type_node(t)
    }

    ; typeParameterToDeclarationWithConstraint
    procedure type_parameter_to_declaration_with_constraint(mutable this, mutable type_parameter: ref[Type], constraint_node: ref[AstNode]?) returns ref[AstNode]?
    {
        let f0 this.save_flags()
        let i0 this.save_internal_flags()
        let d0 this.save_depth()
        this.clear_flag(NbFlagsWriteTypeParametersInQualifiedName)
        let mods this.modifiers_from_flags(checker.get_type_parameter_modifiers(type_parameter))
        var modifiers_list: ref[Array[ref[AstNode]?]]? null
        if (mods.get_length() as int) > 0
            set modifiers_list: mods
        let name this.type_parameter_to_name(type_parameter)
        let default_parameter checker.get_default_from_type_parameter(type_parameter)
        var default_node: ref[AstNode]? null
        if default_parameter <> null
            set default_node: this.type_to_type_node(default_parameter)
        this.restore_flags(f0, i0, d0)
        factory.new_type_parameter_declaration(modifiers_list, name, constraint_node, null, default_node)
    }

    ; ast.CreateModifiersFromModifierFlags, in the reference's order
    procedure modifiers_from_flags(mutable this, flags: int) returns ref[Array[ref[AstNode]?]]
    {
        let result &Array[ref[AstNode]?]^host()
        if (flags & ModifierFlagsExport) <> 0
            result.add(factory.new_token(KindExportKeyword))
        if (flags & ModifierFlagsAmbient) <> 0
            result.add(factory.new_token(KindDeclareKeyword))
        if (flags & ModifierFlagsDefault) <> 0
            result.add(factory.new_token(KindDefaultKeyword))
        if (flags & ModifierFlagsConst) <> 0
            result.add(factory.new_token(KindConstKeyword))
        if (flags & ModifierFlagsPublic) <> 0
            result.add(factory.new_token(KindPublicKeyword))
        if (flags & ModifierFlagsPrivate) <> 0
            result.add(factory.new_token(KindPrivateKeyword))
        if (flags & ModifierFlagsProtected) <> 0
            result.add(factory.new_token(KindProtectedKeyword))
        if (flags & ModifierFlagsAbstract) <> 0
            result.add(factory.new_token(KindAbstractKeyword))
        if (flags & ModifierFlagsStatic) <> 0
            result.add(factory.new_token(KindStaticKeyword))
        if (flags & ModifierFlagsOverride) <> 0
            result.add(factory.new_token(KindOverrideKeyword))
        if (flags & ModifierFlagsReadonly) <> 0
            result.add(factory.new_token(KindReadonlyKeyword))
        if (flags & ModifierFlagsAccessor) <> 0
            result.add(factory.new_token(KindAccessorKeyword))
        if (flags & ModifierFlagsAsync) <> 0
            result.add(factory.new_token(KindAsyncKeyword))
        if (flags & ModifierFlagsIn) <> 0
            result.add(factory.new_token(KindInKeyword))
        if (flags & ModifierFlagsOut) <> 0
            result.add(factory.new_token(KindOutKeyword))
        result
    }

    ; ast.ModifiersToFlags
    function modifiers_to_flags(modifiers: ref[Array[ref[AstNode]?]]?) returns int
    {
        var flags 0
        let n AstNode.list_count(modifiers)
        var i 0
        while i < n
        {
            let m AstNode.child_in_list(modifiers, i)
            if m <> null
                set flags: flags | AstNode.modifier_to_flag((m as ref[AstNode]).kind)
            set i: i + 1
        }
        flags
    }

    ; typeParameterShadowsOtherTypeParameterInScope
    procedure type_parameter_shadows_other_type_parameter_in_scope(mutable this, mutable name: Slice[char], type_parameter: ref[Type]) returns bool
    {
        let result checker.resolve_name((this.the_ctx()).enclosing_declaration, name, SymbolFlagsType, 0, false, false)
        if result = null
            return false
        if (Symbol.flags_of(result as ref[Symbol]) & SymbolFlagsTypeParameter) = 0
            return false
        result <> type_parameter.symbol
    }

    ; typeParameterToName
    procedure type_parameter_to_name(mutable this, mutable type_parameter: ref[Type]) returns ref[AstNode]
    {
        let c this.the_ctx()
        let generate ((c.flags & NbFlagsGenerateNamesForShadowedTypeParams) <> 0)
        if generate
        {
            let cached this.type_parameter_name_of(type_parameter.id)
            if cached <> null
                return cached as ref[AstNode]
        }
        var result: ref[AstNode]? null
        if type_parameter.symbol <> null
            set result: this.symbol_to_name(type_parameter.symbol as ref[Symbol], SymbolFlagsType, true)
        if result = null
            return factory.new_identifier("(Missing type parameter)")
        var id result as ref[AstNode]
        if id.kind <> KindIdentifier
            return factory.new_identifier("(Missing type parameter)")
        if type_parameter.symbol <> null
        {
            let sym type_parameter.symbol as ref[Symbol]
            if Symbol.declaration_count(sym) > 0
            {
                let decl Symbol.declaration_at(sym, 0)
                if decl <> null
                {
                    if (decl as ref[AstNode]).kind = KindTypeParameter
                    {
                        let ranged this.set_text_range(id, AstNode.name_of(decl as ref[AstNode]))
                        if ranged <> null
                            set id: ranged as ref[AstNode]
                    }
                }
            }
        }
        if generate
        {
            let raw_text AstNode.identifier_text_of(id)
            var i this.next_name_count_of(raw_text)
            var text raw_text
            var searching true
            while searching
            {
                var taken this.type_parameter_text_seen(text)
                if taken = false
                    set taken: this.type_parameter_shadows_other_type_parameter_in_scope(text, type_parameter)
                if taken
                {
                    set i: i + 1
                    set text: this.suffixed_name(raw_text, i)
                }
                else
                    set searching: false
            }
            if SymbolTable.names_equal(text, raw_text) = false
                set id: this.new_identifier(text)
            c.type_parameter_next_counts.add(NbNameCount(raw_text, i))
            c.type_parameter_names.add(NbTypeParamName(type_parameter.id, id))
            c.type_parameter_names_by_text.add(text)
        }
        id
    }

    ; ── references and access chains ─────────────────────────────────────────

    ; appendReferenceToType
    procedure append_reference_to_type(mutable this, mutable root: ref[AstNode], mutable ref_node: ref[AstNode]) returns ref[AstNode]?
    {
        if root.kind = KindImportType
        {
            let ids this.get_access_stack(ref_node)
            var qualifier AstNode.import_type_qualifier_of(root)
            var i 0
            while i < (ids.get_length() as int)
            {
                if qualifier <> null
                    set qualifier: factory.new_qualified_name(qualifier, ids[i])
                else
                    set qualifier: ids[i]
                set i: i + 1
            }
            return factory.update_import_type_node(root, AstNode.import_type_is_type_of(root), AstNode.import_type_argument_of(root), AstNode.import_type_attributes_of(root), qualifier, AstNode.type_reference_arguments_of(ref_node))
        }
        if root.kind = KindTypeReference
        {
            let args AstNode.type_reference_arguments_of(root)
            if this.has_flag(NbFlagsUseInstantiationExpressions) and (AstNode.list_count(args) <> 0)
            {
                let access this.create_access_expression(AstNode.type_reference_name_of(root) as ref[AstNode])
                if access = null
                    return null
                var expr this.create_expression_with_type_arguments(access, args)
                let ids this.get_access_stack(ref_node)
                var i 0
                while i < (ids.get_length() as int)
                {
                    set expr: factory.new_property_access_expression(expr, null, ids[i], NodeFlagsNone)
                    set i: i + 1
                }
                return expr
            }
            var type_name AstNode.type_reference_name_of(root)
            let ids this.get_access_stack(ref_node)
            var i 0
            while i < (ids.get_length() as int)
            {
                set type_name: factory.new_qualified_name(type_name, ids[i])
                set i: i + 1
            }
            return factory.update_type_reference_node(root, type_name, AstNode.type_reference_arguments_of(ref_node))
        }
        let access this.create_access_expression(root)
        if access = null
            return null
        var expr access as ref[AstNode]
        let ids this.get_access_stack(ref_node)
        var i 0
        while i < (ids.get_length() as int)
        {
            set expr: factory.new_property_access_expression(expr, null, ids[i], NodeFlagsNone)
            set i: i + 1
        }
        expr
    }

    ; getAccessStack: the identifiers of a type reference's name, leftmost first
    function get_access_stack(this, ref_node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        var state AstNode.type_reference_name_of(ref_node) as ref[AstNode]
        let rights &Array[ref[AstNode]?]^host()
        while state.kind <> KindIdentifier
        {
            rights.add(AstNode.qualified_right_of(state))
            set state: AstNode.qualified_left_of(state) as ref[AstNode]
        }
        let ids &Array[ref[AstNode]?]^host()
        ids.add(state)
        var i (rights.get_length() as int) - 1
        while i >= 0
        {
            ids.add(rights[i])
            set i: i - 1
        }
        ids
    }

    ; createAccessExpression
    procedure create_access_expression(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindQualifiedName
        {
            let left this.create_access_expression(AstNode.qualified_left_of(node) as ref[AstNode])
            if left = null
                return null
            return factory.new_property_access_expression(left, null, this.deep_clone(AstNode.qualified_right_of(node)), NodeFlagsNone)
        }
        if (node.kind = KindIdentifier) or (node.kind = KindPropertyAccessExpression) or (node.kind = KindExpressionWithTypeArguments)
            return this.deep_clone(node)
        this.record_unported("node-builder-access-expression", node.kind)
        null
    }

    procedure create_expression_with_type_arguments(mutable this, expr: ref[AstNode]?, type_arguments: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        if expr = null
            return null
        if (type_arguments = null) or (AstNode.list_count(type_arguments) = 0)
            return expr
        factory.new_expression_with_type_arguments(expr, type_arguments)
    }

    ; serializeTypeName
    procedure serialize_type_name(mutable this, mutable node: ref[AstNode], is_type_of: bool, mutable type_arguments: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        var meaning SymbolFlagsType
        if is_type_of
            set meaning: SymbolFlagsValue
        let symbol checker.resolve_entity_name(node, meaning, true, false, node)
        if symbol = null
            return null
        let sym symbol as ref[Symbol]
        var resolved_symbol sym
        if (Symbol.flags_of(sym) & SymbolFlagsAlias) <> 0
        {
            let resolved checker.resolve_alias(sym)
            if resolved <> null
                set resolved_symbol: resolved as ref[Symbol]
        }
        if this.is_symbol_accessible_now(sym, meaning) = false
            return null
        this.symbol_to_type_node(resolved_symbol, meaning, type_arguments)
    }

    ; mapToTypeNodes
    procedure map_to_type_nodes(mutable this, mutable list: ref[Array[ref[Type]?]]?, is_bare_list: bool) returns ref[Array[ref[AstNode]?]]?
    {
        if list = null
            return null
        let types list as ref[Array[ref[Type]?]]
        let n types.get_length() as int
        if n = 0
            return null
        if this.check_truncation_length()
        {
            if is_bare_list = false
            {
                let nodes &Array[ref[AstNode]?]^host()
                if this.has_flag(NbFlagsNoTruncation)
                    nodes.add(context.add_synthetic_leading_comment(factory.new_keyword_type_node(KindAnyKeyword), KindMultiLineCommentTrivia, "elided", false))
                else
                    nodes.add(factory.new_type_reference_node(factory.new_identifier("..."), null))
                return nodes
            }
            if n > 2
            {
                let nodes &Array[ref[AstNode]?]^host()
                nodes.add(this.type_to_type_node(types[0]))
                let more this.int_text(n - 2)
                if this.has_flag(NbFlagsNoTruncation)
                    nodes.add(context.add_synthetic_leading_comment(factory.new_keyword_type_node(KindAnyKeyword), KindMultiLineCommentTrivia, this.concat3("... ", more, " more elided ..."), false))
                else
                    nodes.add(factory.new_type_reference_node(factory.new_identifier(this.concat3("... ", more, " more ...")), null))
                nodes.add(this.type_to_type_node(types[n - 1]))
                return nodes
            }
        }
        let may_have_name_collisions (this.has_flag(NbFlagsUseFullyQualifiedType) = false)
        let seen &Array[NbSeenName]^host()
        let result &Array[ref[AstNode]?]^host()
        var i 0
        while i < n
        {
            let t types[i]
            let display_index i + 1
            if this.check_truncation_length() and ((display_index + 2) < (n - 1))
            {
                let more this.int_text(n - display_index)
                if this.has_flag(NbFlagsNoTruncation)
                    result.add(context.add_synthetic_leading_comment(factory.new_keyword_type_node(KindAnyKeyword), KindMultiLineCommentTrivia, this.concat3("... ", more, " more elided ..."), false))
                else
                    result.add(factory.new_type_reference_node(factory.new_identifier(this.concat3("... ", more, " more ...")), null))
                let last this.type_to_type_node(types[n - 1])
                if last <> null
                    result.add(last)
                set i: n
            }
            else
            {
                this.add_approximate_length(2)
                let type_node this.type_to_type_node(t)
                if type_node <> null
                {
                    result.add(type_node)
                    if may_have_name_collisions and NodeBuilder.is_identifier_type_reference(type_node)
                    {
                        if t <> null
                            seen.add(NbSeenName(AstNode.identifier_text_of(AstNode.type_reference_name_of(type_node as ref[AstNode]) as ref[AstNode]), t as ref[Type], (result.get_length() as int) - 1))
                    }
                }
            }
            set i: i + 1
        }
        if may_have_name_collisions and ((seen.get_length() as int) > 1)
        {
            ; the same name for different types: regenerate those entries fully
            ; qualified
            let sn seen.get_length() as int
            var regenerate &Array[bool]^host()
            var any false
            var a 0
            while a < sn
            {
                var collides false
                var b 0
                while b < sn
                {
                    if b <> a
                    {
                        let ea seen[a]
                        let eb seen[b]
                        if SymbolTable.names_equal(ea.text, eb.text)
                        {
                            if NodeBuilder.types_are_same_reference(ea.t, eb.t) = false
                                set collides: true
                        }
                    }
                    set b: b + 1
                }
                regenerate.add(collides)
                if collides
                    set any: true
                set a: a + 1
            }
            if any
            {
                let f0 this.save_flags()
                let i0 this.save_internal_flags()
                let d0 this.save_depth()
                this.add_flag(NbFlagsUseFullyQualifiedType)
                set a: 0
                while a < sn
                {
                    if regenerate[a]
                    {
                        let e seen[a]
                        result.put(e.index as size_t, this.type_to_type_node(e.t))
                    }
                    set a: a + 1
                }
                this.restore_flags(f0, i0, d0)
            }
        }
        result
    }

    ; ── typeToTypeNode and the arms it dispatches to ─────────────────────────

    ; TypeAlias.ToTypeReferenceNode
    procedure alias_to_type_reference_node(mutable this, mutable t: ref[Type]) returns ref[AstNode]?
        factory.new_type_reference_node(this.symbol_to_entity_name_node(t.alias_symbol as ref[Symbol]), this.map_to_type_nodes(t.alias_type_arguments, false))

    procedure type_to_type_node(mutable this, mutable t_in: ref[Type]?) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let in_type_alias c.flags & NbFlagsInTypeAlias
        this.clear_flag(NbFlagsInTypeAlias)
        if t_in = null
        {
            if (c.flags & NbFlagsAllowEmptyUnionOrIntersection) = 0
            {
                this.note_error("e3")
                return null
            }
            this.add_approximate_length(3)
            return factory.new_keyword_type_node(KindAnyKeyword)
        }
        var t t_in as ref[Type]
        if (c.flags & NbFlagsNoTypeReduction) = 0
        {
            let reduced checker.get_reduced_type(t)
            if reduced <> null
                set t: reduced as ref[Type]
        }
        if (t.flags & TypeFlagsAny) <> 0
        {
            if t.alias_symbol <> null
                return this.alias_to_type_reference_node(t)
            if t = checker.unresolved_type
                return context.add_synthetic_leading_comment(factory.new_keyword_type_node(KindAnyKeyword), KindMultiLineCommentTrivia, "unresolved", false)
            this.add_approximate_length(3)
            if t = checker.intrinsic_marker_type
                return factory.new_keyword_type_node(KindIntrinsicKeyword)
            return factory.new_keyword_type_node(KindAnyKeyword)
        }
        if (t.flags & TypeFlagsUnknown) <> 0
            return factory.new_keyword_type_node(KindUnknownKeyword)
        if (t.flags & TypeFlagsString) <> 0
        {
            this.add_approximate_length(6)
            return factory.new_keyword_type_node(KindStringKeyword)
        }
        if (t.flags & TypeFlagsNumber) <> 0
        {
            this.add_approximate_length(6)
            return factory.new_keyword_type_node(KindNumberKeyword)
        }
        if (t.flags & TypeFlagsBigInt) <> 0
        {
            this.add_approximate_length(6)
            return factory.new_keyword_type_node(KindBigIntKeyword)
        }
        if ((t.flags & TypeFlagsBoolean) <> 0) and (t.alias_symbol = null)
        {
            this.add_approximate_length(7)
            return factory.new_keyword_type_node(KindBooleanKeyword)
        }
        if (t.flags & TypeFlagsEnumLike) <> 0
        {
            if t.symbol = null
            {
                this.record_unported("node-builder-enum-symbol", 0)
                return null
            }
            let sym t.symbol as ref[Symbol]
            if (Symbol.flags_of(sym) & SymbolFlagsEnumMember) <> 0
            {
                let parent_symbol checker.get_parent_of_symbol(sym)
                if parent_symbol = null
                {
                    this.record_unported("node-builder-enum-symbol", 1)
                    return null
                }
                let ps parent_symbol as ref[Symbol]
                let parent_name this.symbol_to_type_node(ps, SymbolFlagsType, null)
                if parent_name = null
                    return null
                if checker.get_declared_type_of_symbol(ps) = t
                    return parent_name
                let pn parent_name as ref[AstNode]
                let member_name Symbol.name_of(sym)
                if Checker.is_identifier_text(member_name)
                    return this.append_reference_to_type(pn, factory.new_type_reference_node(factory.new_identifier(member_name), null))
                if pn.kind = KindImportType
                {
                    let typeof_import factory.update_import_type_node(pn, true, AstNode.import_type_argument_of(pn), AstNode.import_type_attributes_of(pn), AstNode.import_type_qualifier_of(pn), AstNode.type_arguments_of(pn))
                    return factory.new_indexed_access_type_node(typeof_import, factory.new_literal_type_node(this.new_string_literal(member_name)))
                }
                if pn.kind = KindTypeReference
                    return factory.new_indexed_access_type_node(factory.new_type_query_node(AstNode.type_reference_name_of(pn), null), factory.new_literal_type_node(this.new_string_literal(member_name)))
                this.record_unported("node-builder-enum-member-name", pn.kind)
                return null
            }
            return this.symbol_to_type_node(sym, SymbolFlagsType, null)
        }
        if (t.flags & TypeFlagsStringLiteral) <> 0
        {
            let text Checker.literal_text_of(t)
            this.add_approximate_length(text.length + 2)
            let lit this.new_string_literal(text)
            context.add_emit_flags(lit, EFNoAsciiEscaping)
            return factory.new_literal_type_node(lit)
        }
        if (t.flags & TypeFlagsNumberLiteral) <> 0
        {
            let text this.number_text(Checker.literal_bits_of(t))
            this.add_approximate_length(text.length)
            if NodeBuilder.starts_with_char(text, "-" as char)
                return factory.new_literal_type_node(factory.new_prefix_unary_expression(KindMinusToken, factory.new_numeric_literal(text.slice_from(1), TokenFlagsNone)))
            return factory.new_literal_type_node(factory.new_numeric_literal(text, TokenFlagsNone))
        }
        if (t.flags & TypeFlagsBigIntLiteral) <> 0
        {
            let sb StringBuilder^host()
            Checker.write_pseudo_big_int_value(&sb, Checker.literal_text_of(t), Checker.literal_negative_of(t))
            sb.append("n" as char)
            let text this.slice_of(&sb)
            this.add_approximate_length(text.length)
            return factory.new_literal_type_node(factory.new_big_int_literal(text, TokenFlagsNone))
        }
        if (t.flags & TypeFlagsBooleanLiteral) <> 0
        {
            if Checker.literal_bool_of(t)
            {
                this.add_approximate_length(4)
                return factory.new_literal_type_node(factory.new_keyword_expression(KindTrueKeyword))
            }
            this.add_approximate_length(5)
            return factory.new_literal_type_node(factory.new_keyword_expression(KindFalseKeyword))
        }
        if (t.flags & TypeFlagsUniqueESSymbol) <> 0
        {
            if (c.flags & NbFlagsAllowUniqueESSymbolType) = 0
            {
                if t.symbol <> null
                {
                    if this.is_value_symbol_accessible(t.symbol as ref[Symbol], c.enclosing_declaration)
                    {
                        this.add_approximate_length(6)
                        return this.symbol_to_type_node(t.symbol as ref[Symbol], SymbolFlagsValue, null)
                    }
                }
                this.report_inaccessible_unique_symbol_error()
            }
            this.add_approximate_length(13)
            return factory.new_type_operator_node(KindUniqueKeyword, factory.new_keyword_type_node(KindSymbolKeyword))
        }
        if (t.flags & TypeFlagsVoid) <> 0
        {
            this.add_approximate_length(4)
            return factory.new_keyword_type_node(KindVoidKeyword)
        }
        if (t.flags & TypeFlagsUndefined) <> 0
        {
            this.add_approximate_length(9)
            return factory.new_keyword_type_node(KindUndefinedKeyword)
        }
        if (t.flags & TypeFlagsNull) <> 0
        {
            this.add_approximate_length(4)
            return factory.new_literal_type_node(factory.new_keyword_expression(KindNullKeyword))
        }
        if (t.flags & TypeFlagsNever) <> 0
        {
            this.add_approximate_length(5)
            return factory.new_keyword_type_node(KindNeverKeyword)
        }
        if (t.flags & TypeFlagsESSymbol) <> 0
        {
            this.add_approximate_length(6)
            return factory.new_keyword_type_node(KindSymbolKeyword)
        }
        if (t.flags & TypeFlagsNonPrimitive) <> 0
        {
            this.add_approximate_length(6)
            return factory.new_keyword_type_node(KindObjectKeyword)
        }
        if Checker.is_this_type_parameter(t)
        {
            if (c.flags & NbFlagsInObjectTypeLiteral) <> 0
            {
                if (c.encountered_error = false) and ((c.flags & NbFlagsAllowThisInObjectLiteral) = 0)
                    this.note_error("e4")
                this.report_inaccessible_this_error()
            }
            this.add_approximate_length(4)
            return factory.new_this_type_node()
        }
        if (in_type_alias = 0) and (t.alias_symbol <> null)
        {
            let alias_symbol t.alias_symbol as ref[Symbol]
            var usable ((c.flags & NbFlagsUseAliasDefinedOutsideCurrentScope) <> 0)
            if usable = false
                set usable: this.is_type_symbol_accessible(alias_symbol, c.enclosing_declaration)
            if usable
            {
                if this.should_expand_type(t, true) = false
                {
                    let type_argument_nodes this.map_to_type_nodes(t.alias_type_arguments, false)
                    if Checker.is_reserved_member_name(Symbol.name_of(alias_symbol)) and ((Symbol.flags_of(alias_symbol) & SymbolFlagsClass) = 0)
                        return factory.new_type_reference_node(factory.new_identifier(""), type_argument_nodes)
                    if type_argument_nodes <> null
                    {
                        if AstNode.list_count(type_argument_nodes) = 1
                        {
                            let global_array_alias checker.get_global_array_type()
                            if global_array_alias <> null
                            {
                                if alias_symbol = (global_array_alias as ref[Type]).symbol
                                    return factory.new_array_type_node(AstNode.child_in_list(type_argument_nodes, 0))
                            }
                        }
                    }
                    return this.symbol_to_type_node(alias_symbol, SymbolFlagsType, type_argument_nodes)
                }
            }
        }
        let object_flags t.object_flags
        if (object_flags & ObjectFlagsReference) <> 0
        {
            if Checker.reference_node_of(t) <> null
                return this.visit_and_transform_type(t, NbTransformTypeReference)
            return this.type_reference_to_type_node(t)
        }
        if ((t.flags & TypeFlagsTypeParameter) <> 0) or ((object_flags & ObjectFlagsClassOrInterface) <> 0)
        {
            if (t.flags & TypeFlagsTypeParameter) <> 0
            {
                if this.is_infer_type_parameter(t)
                {
                    var name_len 0
                    if t.symbol <> null
                        set name_len: Symbol.name_len_of(t.symbol as ref[Symbol])
                    this.add_approximate_length(name_len + 6)
                    var constraint_node: ref[AstNode]? null
                    let constraint checker.get_constraint_of_type_parameter(t)
                    if constraint <> null
                    {
                        var emit true
                        let inferred_constraint checker.get_inferred_type_parameter_constraint(t)
                        if inferred_constraint <> null
                        {
                            if checker.is_type_identical_to(constraint as ref[Type], inferred_constraint as ref[Type])
                                set emit: false
                        }
                        if emit
                        {
                            this.add_approximate_length(9)
                            set constraint_node: this.type_to_type_node(constraint)
                        }
                    }
                    return factory.new_infer_type_node(this.type_parameter_to_declaration_with_constraint(t, constraint_node))
                }
                if (c.flags & NbFlagsGenerateNamesForShadowedTypeParams) <> 0
                {
                    let name this.type_parameter_to_name(t)
                    let text AstNode.identifier_text_of(name)
                    this.add_approximate_length(text.length)
                    return factory.new_type_reference_node(this.new_identifier(text), null)
                }
            }
            if t.symbol <> null
                return this.symbol_to_type_node(t.symbol as ref[Symbol], SymbolFlagsType, null)
            var marker false
            if checker.marker_super_type_for_check <> null
            {
                if t = checker.marker_super_type_for_check
                    set marker: true
            }
            if checker.marker_sub_type_for_check <> null
            {
                if t = checker.marker_sub_type_for_check
                    set marker: true
            }
            if marker and (checker.variance_type_parameter <> null)
            {
                let vtp checker.variance_type_parameter as ref[Type]
                if vtp.symbol <> null
                {
                    let sb StringBuilder^host()
                    if t = checker.marker_sub_type_for_check
                        sb.append("sub-")
                    else
                        sb.append("super-")
                    let nm Symbol.name_of(vtp.symbol as ref[Symbol])
                    sb.append(nm.data, nm.length as size_t)
                    return factory.new_type_reference_node(this.new_identifier(this.slice_of(&sb)), null)
                }
            }
            return factory.new_type_reference_node(this.new_identifier("?"), null)
        }
        if (t.flags & TypeFlagsUnion) <> 0
        {
            choose t.data
                when u: Union
                {
                    if u.origin <> null
                        set t: u.origin as ref[Type]
                }
        }
        if (t.flags & (TypeFlagsUnion | TypeFlagsIntersection)) <> 0
        {
            var types: ref[Array[ref[Type]?]]? null
            if (t.flags & TypeFlagsUnion) <> 0
            {
                let members Checker.union_types_of(t)
                if members <> null
                    set types: checker.format_union_types(members as ref[Array[ref[Type]?]])
            }
            else
                set types: Checker.intersection_types_of(t)
            if types = null
                return null
            let ts types as ref[Array[ref[Type]?]]
            if (ts.get_length() as int) = 1
                return this.type_to_type_node(ts[0])
            let type_nodes this.map_to_type_nodes(ts, true)
            if type_nodes <> null
            {
                if AstNode.list_count(type_nodes) > 0
                {
                    if (t.flags & TypeFlagsUnion) <> 0
                        return factory.new_union_type_node(type_nodes)
                    return factory.new_intersection_type_node(type_nodes)
                }
            }
            if (c.encountered_error = false) and ((c.flags & NbFlagsAllowEmptyUnionOrIntersection) = 0)
                this.note_error("e5")
            return null
        }
        if (object_flags & (ObjectFlagsAnonymous | ObjectFlagsMapped)) <> 0
            return this.create_anonymous_type_node(t)
        if (t.flags & TypeFlagsIndex) <> 0
        {
            let indexed_type Checker.index_target_of(t)
            this.add_approximate_length(6)
            return factory.new_type_operator_node(KindKeyOfKeyword, this.type_to_type_node(indexed_type))
        }
        if (t.flags & TypeFlagsTemplateLiteral) <> 0
        {
            choose t.data
                when tl: TemplateLiteral
                {
                    let texts tl.texts as ref[Array[ref[String]?]]
                    let types tl.types as ref[Array[ref[Type]?]]
                    let head_str texts[0] as ref[String]
                    let head factory.new_template_head(Printer.slice_on(host, head_str), Slice[char](), TokenFlagsNone)
                    context.add_emit_flags(head, EFNoAsciiEscaping)
                    let spans &Array[ref[AstNode]?]^host()
                    let n types.get_length() as int
                    var i 0
                    while i < n
                    {
                        let text_str texts[i + 1] as ref[String]
                        let text Printer.slice_on(host, text_str)
                        var res: ref[AstNode]? null
                        if i < (n - 1)
                            set res: factory.new_template_middle(text, Slice[char](), TokenFlagsNone)
                        else
                            set res: factory.new_template_tail(text, Slice[char](), TokenFlagsNone)
                        context.add_emit_flags(res as ref[AstNode], EFNoAsciiEscaping)
                        spans.add(factory.new_template_literal_type_span(this.type_to_type_node(types[i]), res))
                        set i: i + 1
                    }
                    this.add_approximate_length(2)
                    return factory.new_template_literal_type_node(head, spans)
                }
            return null
        }
        if (t.flags & TypeFlagsStringMapping) <> 0
        {
            choose t.data
                when sm: StringMapping
                {
                    let type_node this.type_to_type_node(sm.target)
                    let args &Array[ref[AstNode]?]^host()
                    args.add(type_node)
                    if t.symbol = null
                        return null
                    return this.symbol_to_type_node(t.symbol as ref[Symbol], SymbolFlagsType, args)
                }
            return null
        }
        if (t.flags & TypeFlagsIndexedAccess) <> 0
        {
            let object_type_node this.type_to_type_node(Checker.indexed_access_object_type_of(t))
            let index_type_node this.type_to_type_node(Checker.indexed_access_index_type_of(t))
            this.add_approximate_length(2)
            return factory.new_indexed_access_type_node(object_type_node, index_type_node)
        }
        if (t.flags & TypeFlagsConditional) <> 0
            return this.visit_and_transform_type(t, NbTransformConditional)
        if (t.flags & TypeFlagsSubstitution) <> 0
        {
            let type_node this.type_to_type_node(Checker.substitution_base_type_of(t))
            if Checker.is_no_infer_type(t) = false
                return type_node
            let no_infer_symbol checker.get_global_type_alias_symbol("NoInfer", 1)
            if no_infer_symbol <> null
            {
                let args &Array[ref[AstNode]?]^host()
                args.add(type_node)
                return this.symbol_to_type_node(no_infer_symbol as ref[Symbol], SymbolFlagsType, args)
            }
            return type_node
        }
        this.record_unported("node-builder-type-kind", t.flags)
        null
    }

    function is_infer_type_parameter(this, t: ref[Type]) returns bool
    {
        let c this.the_ctx()
        if c.infer_type_parameters = null
            return false
        let list c.infer_type_parameters as ref[Array[ref[Type]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            let e list[i]
            if e <> null
            {
                if (e as ref[Type]) = t
                    return true
            }
            set i: i + 1
        }
        false
    }

    function type_prefix(host: ref[Page], list: ref[Array[ref[Type]?]], from: int, to: int) returns ref[Array[ref[Type]?]]
    {
        let out &Array[ref[Type]?]^host()
        var i from
        while i < to
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    ; getParentSymbolOfTypeParameter
    procedure get_parent_symbol_of_type_parameter(mutable this, mutable tp: ref[Type]) returns ref[Symbol]?
    {
        if tp.symbol = null
            return null
        let decl Checker.get_declaration_of_kind(tp.symbol as ref[Symbol], KindTypeParameter)
        if decl = null
            return null
        let host_node (decl as ref[AstNode]).parent
        if host_node = null
            return null
        checker.get_symbol_of_node(host_node)
    }

    ; typeReferenceToTypeNode
    procedure type_reference_to_type_node(mutable this, mutable t: ref[Type]) returns ref[AstNode]?
    {
        let c this.the_ctx()
        var type_arguments checker.get_type_arguments(t)
        if type_arguments = null
            set type_arguments: &Array[ref[Type]?]^host()
        var args type_arguments as ref[Array[ref[Type]?]]
        let target_opt Checker.target_of(t)
        if target_opt = null
        {
            this.record_unported("node-builder-reference-target", 0)
            return null
        }
        let target target_opt as ref[Type]
        var is_array false
        var is_readonly_array false
        ; the getters, not the fields: the reference fills both in
        ; initializeChecker, the port's memos only when first asked
        let global_array checker.get_global_array_type()
        if global_array <> null
        {
            if target = global_array
                set is_array: true
        }
        let global_readonly_array checker.get_global_readonly_array_type()
        if global_readonly_array <> null
        {
            if target = global_readonly_array
                set is_readonly_array: true
        }
        if is_array or is_readonly_array
        {
            if (c.flags & NbFlagsWriteArrayAsGenericType) <> 0
            {
                let type_argument_node this.type_to_type_node(args[0])
                let list &Array[ref[AstNode]?]^host()
                list.add(type_argument_node)
                var name: Slice[char] "ReadonlyArray"
                if is_array
                {
                    let array_name: Slice[char] "Array"
                    set name: array_name
                }
                return factory.new_type_reference_node(this.new_identifier(name), list)
            }
            let element_type this.type_to_type_node(args[0])
            let array_type factory.new_array_type_node(element_type)
            if is_array
                return array_type
            return factory.new_type_operator_node(KindReadonlyKeyword, array_type)
        }
        if (target.object_flags & ObjectFlagsTuple) <> 0
        {
            let infos_opt Checker.tuple_element_infos_of(target)
            let infos infos_opt as ref[Array[ref[TupleElementInfo]?]]
            let n_infos infos.get_length() as int
            ; removeMissingType on the optional elements
            let mapped &Array[ref[Type]?]^host()
            var ai 0
            while ai < (args.get_length() as int)
            {
                var is_optional false
                if ai < n_infos
                {
                    let info infos[ai]
                    if info <> null
                    {
                        if ((info as ref[TupleElementInfo]).flags & ElementFlagsOptional) <> 0
                            set is_optional: true
                    }
                }
                let a args[ai]
                if a <> null
                    mapped.add(checker.remove_missing_type(a as ref[Type], is_optional))
                else
                    mapped.add(null)
                set ai: ai + 1
            }
            set args: mapped
            if (args.get_length() as int) > 0
            {
                let arity Checker.get_type_reference_arity(t)
                let tuple_constituent_nodes this.map_to_type_nodes(NodeBuilder.type_prefix(host, args, 0, arity), false)
                if tuple_constituent_nodes <> null
                {
                    let nodes tuple_constituent_nodes as ref[Array[ref[AstNode]?]]
                    var i 0
                    while i < (nodes.get_length() as int)
                    {
                        let info infos[i] as ref[TupleElementInfo]
                        let flags info.flags
                        let node nodes[i]
                        if info.labeled_declaration <> null
                        {
                            var ddd: ref[AstNode]? null
                            if (flags & ElementFlagsVariable) <> 0
                                set ddd: factory.new_token(KindDotDotDotToken)
                            var question: ref[AstNode]? null
                            if (flags & ElementFlagsOptional) <> 0
                                set question: factory.new_token(KindQuestionToken)
                            var element node
                            if (flags & ElementFlagsRest) <> 0
                                set element: factory.new_array_type_node(node)
                            nodes.put(i as size_t, factory.new_named_tuple_member(ddd, this.new_identifier(checker.get_tuple_element_label(info, null, i)), question, element))
                        }
                        else
                        {
                            if (flags & ElementFlagsVariable) <> 0
                            {
                                var element node
                                if (flags & ElementFlagsRest) <> 0
                                    set element: factory.new_array_type_node(node)
                                nodes.put(i as size_t, factory.new_rest_type_node(element))
                            }
                            else
                            {
                                if (flags & ElementFlagsOptional) <> 0
                                    nodes.put(i as size_t, factory.new_optional_type_node(node))
                            }
                        }
                        set i: i + 1
                    }
                    let tuple_type_node factory.new_tuple_type_node(nodes)
                    context.set_emit_flags(tuple_type_node, EFSingleLine)
                    if Checker.tuple_readonly_of(target)
                        return factory.new_type_operator_node(KindReadonlyKeyword, tuple_type_node)
                    return tuple_type_node
                }
            }
            if c.encountered_error or ((c.flags & NbFlagsAllowEmptyTuple) <> 0)
            {
                let empty &Array[ref[AstNode]?]^host()
                let tuple_type_node factory.new_tuple_type_node(empty)
                context.set_emit_flags(tuple_type_node, EFSingleLine)
                if Checker.tuple_readonly_of(target)
                    return factory.new_type_operator_node(KindReadonlyKeyword, tuple_type_node)
                return tuple_type_node
            }
            this.note_error("e6")
            return null
        }
        if ((c.flags & NbFlagsWriteClassExpressionAsTypeLiteral) <> 0) and (t.symbol <> null)
        {
            let sym t.symbol as ref[Symbol]
            let vd Symbol.value_declaration_of(sym)
            if vd <> null
            {
                if NodeBuilder.is_class_like_kind((vd as ref[AstNode]).kind)
                {
                    if this.is_value_symbol_accessible(sym, c.enclosing_declaration) = false
                        return this.create_anonymous_type_node(t)
                }
            }
        }
        let outer checker.outer_type_parameters_of(target)
        var i 0
        var result_type: ref[AstNode]? null
        if outer <> null
        {
            let outers outer as ref[Array[ref[Type]?]]
            let length outers.get_length() as int
            while i < length
            {
                let start i
                let parent this.get_parent_symbol_of_type_parameter(outers[i] as ref[Type])
                var stepping true
                while stepping
                {
                    set i: i + 1
                    set stepping: false
                    if i < length
                    {
                        if this.get_parent_symbol_of_type_parameter(outers[i] as ref[Type]) = parent
                            set stepping: true
                    }
                }
                var same true
                var k start
                while k < i
                {
                    if k >= (args.get_length() as int)
                        set same: false
                    else
                    {
                        if outers[k] <> args[k]
                            set same: false
                    }
                    set k: k + 1
                }
                if same = false
                {
                    let type_argument_slice this.map_to_type_nodes(NodeBuilder.type_prefix(host, args, start, i), false)
                    let f0 this.save_flags()
                    let i0 this.save_internal_flags()
                    let d0 this.save_depth()
                    this.add_flag(NbFlagsForbidIndexedAccessSymbolReferences)
                    if parent = null
                        return null
                    let ref_node this.symbol_to_type_node(parent as ref[Symbol], SymbolFlagsType, type_argument_slice)
                    this.restore_flags(f0, i0, d0)
                    if ref_node = null
                        return null
                    if result_type = null
                        set result_type: ref_node
                    else
                        set result_type: this.append_reference_to_type(result_type as ref[AstNode], ref_node as ref[AstNode])
                }
            }
        }
        var type_argument_nodes: ref[Array[ref[AstNode]?]]? null
        let n_args args.get_length() as int
        if n_args > 0
        {
            var type_parameter_count 0
            let type_params checker.interface_type_parameters_of(target)
            if type_params <> null
            {
                let tps type_params as ref[Array[ref[Type]?]]
                set type_parameter_count: tps.get_length() as int
                if n_args < type_parameter_count
                    set type_parameter_count: n_args
                var iterable false
                if Checker.is_reference_to_type(t, checker.get_global_iterable_type())
                    set iterable: true
                if Checker.is_reference_to_type(t, checker.get_global_iterable_iterator_type())
                    set iterable: true
                if Checker.is_reference_to_type(t, checker.get_global_async_iterable_type())
                    set iterable: true
                if Checker.is_reference_to_type(t, checker.get_global_async_iterable_iterator_type())
                    set iterable: true
                if iterable
                {
                    var elide true
                    let node Checker.reference_node_of(t)
                    if node <> null
                    {
                        let nn node as ref[AstNode]
                        if nn.kind = KindTypeReference
                        {
                            let node_args AstNode.type_reference_arguments_of(nn)
                            if node_args <> null
                            {
                                if AstNode.list_count(node_args) >= type_parameter_count
                                    set elide: false
                            }
                        }
                    }
                    if elide
                    {
                        var going true
                        while going and (type_parameter_count > 0)
                        {
                            let type_argument args[type_parameter_count - 1]
                            let type_parameter tps[type_parameter_count - 1]
                            let default_type checker.get_default_from_type_parameter(type_parameter as ref[Type])
                            set going: false
                            if default_type <> null
                            {
                                if checker.is_type_identical_to(type_argument as ref[Type], default_type as ref[Type])
                                {
                                    set type_parameter_count: type_parameter_count - 1
                                    set going: true
                                }
                            }
                        }
                    }
                }
            }
            set type_argument_nodes: this.map_to_type_nodes(NodeBuilder.type_prefix(host, args, i, type_parameter_count), false)
        }
        let f0 this.save_flags()
        let i0 this.save_internal_flags()
        let d0 this.save_depth()
        this.add_flag(NbFlagsForbidIndexedAccessSymbolReferences)
        if t.symbol = null
            return null
        let final_ref this.symbol_to_type_node(t.symbol as ref[Symbol], SymbolFlagsType, type_argument_nodes)
        this.restore_flags(f0, i0, d0)
        if result_type = null
            return final_ref
        if final_ref = null
            return null
        this.append_reference_to_type(result_type as ref[AstNode], final_ref as ref[AstNode])
    }

    ; ── visitAndTransformType: the serialized-type cache and the depth guard ──

    procedure visit_and_transform_type(mutable this, mutable t: ref[Type], transform: int) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let type_id t.id
        var is_constructor_object false
        if ((t.object_flags & ObjectFlagsAnonymous) <> 0) and (t.symbol <> null)
        {
            if (Symbol.flags_of(t.symbol as ref[Symbol]) & SymbolFlagsClass) <> 0
                set is_constructor_object: true
        }
        var has_id false
        var id_constructor false
        var id_symbol: ref[Symbol]? null
        var id_node: ref[AstNode]? null
        if ((t.object_flags & ObjectFlagsReference) <> 0) and (Checker.reference_node_of(t) <> null)
        {
            set has_id: true
            set id_node: Checker.reference_node_of(t)
        }
        else
        {
            if (t.flags & TypeFlagsConditional) <> 0
            {
                let root Checker.conditional_root_of(t)
                if root <> null
                {
                    set has_id: true
                    set id_node: (root as ref[ConditionalRoot]).node
                }
            }
            else
            {
                if t.symbol <> null
                {
                    set has_id: true
                    set id_constructor: is_constructor_object
                    set id_symbol: t.symbol
                }
            }
        }
        let can_use_cache (c.max_expansion_depth < 0)
        if can_use_cache and (c.enclosing_declaration <> null)
        {
            let row this.find_cache_row(c.enclosing_declaration as ref[AstNode], type_id, c.flags, c.internal_flags)
            if row <> null
            {
                let r row as ref[NbCacheRow]
                if r.tracked <> null
                {
                    let tracked r.tracked as ref[Array[NbTrackedSymbol]]
                    var i 0
                    while i < (tracked.get_length() as int)
                    {
                        let ts tracked[i]
                        this.track_symbol(ts.symbol, ts.enclosing, ts.meaning)
                        set i: i + 1
                    }
                }
                if r.truncating
                    set c.truncating: true
                this.add_approximate_length(r.added_length)
                return this.deep_clone(r.node)
            }
        }
        var depth 0
        var depth_index 0 - 1
        if has_id
        {
            set depth_index: this.symbol_depth_index(id_constructor, id_symbol, id_node)
            if depth_index >= 0
                set depth: (c.symbol_depth[depth_index]).depth
            if depth > 10
                return this.create_elided_information_placeholder()
            if depth_index >= 0
                c.symbol_depth.put(depth_index as size_t, NbSymbolDepth(id_constructor, id_symbol, id_node, depth + 1))
            else
            {
                set depth_index: c.symbol_depth.get_length() as int
                c.symbol_depth.add(NbSymbolDepth(id_constructor, id_symbol, id_node, depth + 1))
            }
        }
        this.add_visited_type(type_id)
        let prev_tracked c.tracked_symbols
        set c.tracked_symbols: null
        let start_length c.approximate_length
        var result: ref[AstNode]? null
        if transform = NbTransformObjectType
            set result: this.create_type_node_from_object_type(t)
        if transform = NbTransformTypeToTypeNode
            set result: this.type_to_type_node(t)
        if transform = NbTransformTypeReference
            set result: this.type_reference_to_type_node(t)
        if transform = NbTransformConditional
            set result: this.conditional_type_to_type_node(t)
        let added_length c.approximate_length - start_length
        if can_use_cache and (c.reported_diagnostic = false) and (c.encountered_error = false) and (c.enclosing_declaration <> null)
            cache_rows.add(&NbCacheRow^host(c.enclosing_declaration as ref[AstNode], type_id, c.flags, c.internal_flags, result, c.truncating, added_length, c.tracked_symbols))
        this.delete_visited_type(type_id)
        if has_id
            c.symbol_depth.put(depth_index as size_t, NbSymbolDepth(id_constructor, id_symbol, id_node, depth))
        set c.tracked_symbols: prev_tracked
        result
    }

    function find_cache_row(this, enclosing: ref[AstNode], type_id: int, flags: int, internal_flags: int) returns ref[NbCacheRow]?
    {
        var i (cache_rows.get_length() as int) - 1
        while i >= 0
        {
            let row cache_rows[i]
            if row <> null
            {
                let r row as ref[NbCacheRow]
                if (r.type_id = type_id) and (r.flags = flags) and (r.internal_flags = internal_flags)
                {
                    if r.enclosing = enclosing
                        return r
                }
            }
            set i: i - 1
        }
        null
    }

    ; typeToTypeNodeOrCircularityElision
    procedure type_to_type_node_or_circularity_elision(mutable this, mutable t: ref[Type]?) returns ref[AstNode]?
    {
        if t = null
            return this.type_to_type_node(t)
        let tt t as ref[Type]
        if (tt.flags & TypeFlagsUnion) <> 0
        {
            if this.visited_type(tt.id)
            {
                if this.has_flag(NbFlagsAllowAnonymousIdentifier) = false
                {
                    let c this.the_ctx()
                    this.note_error("e7")
                    this.report_cyclic_structure_error()
                }
                return this.create_elided_information_placeholder()
            }
            return this.visit_and_transform_type(tt, NbTransformTypeToTypeNode)
        }
        this.type_to_type_node(tt)
    }

    ; conditionalTypeToTypeNode
    procedure conditional_type_to_type_node(mutable this, mutable t: ref[Type]) returns ref[AstNode]?
    {
        if this.check_truncation_length()
            return this.create_elided_information_placeholder()
        let c this.the_ctx()
        let root Checker.conditional_root_of(t) as ref[ConditionalRoot]
        var check_type: ref[Type]? null
        var extends_type: ref[Type]? null
        var mapper: ref[TypeMapper]? null
        choose t.data
            when cd: Conditional
            {
                set check_type: cd.check_type
                set extends_type: cd.extends_type
                set mapper: cd.mapper
            }
        let check_type_node this.type_to_type_node(check_type)
        this.add_approximate_length(15)
        var distributive_rewrite false
        if ((c.flags & NbFlagsGenerateNamesForShadowedTypeParams) <> 0) and root.is_distributive
        {
            if check_type <> null
            {
                if ((check_type as ref[Type]).flags & TypeFlagsTypeParameter) = 0
                    set distributive_rewrite: true
            }
        }
        if distributive_rewrite
        {
            let new_param checker.new_type_parameter(checker.new_symbol(SymbolFlagsTypeParameter, "T"))
            let name this.type_parameter_to_name(new_param)
            let new_type_variable factory.new_type_reference_node(name, null)
            this.add_approximate_length(37)
            let new_mapper checker.prepend_type_mapping(root.check_type, new_param, mapper)
            let save_infer c.infer_type_parameters
            set c.infer_type_parameters: root.infer_type_parameters
            let extends_type_node this.type_to_type_node(checker.instantiate_type(root.extends_type, new_mapper))
            set c.infer_type_parameters: save_infer
            let true_type_node this.type_to_type_node_or_circularity_elision(checker.instantiate_type(this.get_type_from_type_node(AstNode.conditional_type_true_of(root.node) as ref[AstNode], false), new_mapper))
            let false_type_node this.type_to_type_node_or_circularity_elision(checker.instantiate_type(this.get_type_from_type_node(AstNode.conditional_type_false_of(root.node) as ref[AstNode], false), new_mapper))
            let new_id factory.clone(name)
            let synthetic_extends_node factory.new_infer_type_node(factory.new_type_parameter_declaration(null, new_id, null, null, null))
            let inner_check_conditional_node factory.new_conditional_type_node(new_type_variable, extends_type_node, true_type_node, false_type_node)
            let synthetic_true_node factory.new_conditional_type_node(factory.new_type_reference_node(factory.clone(name), null), this.deep_clone(check_type_node), inner_check_conditional_node, factory.new_keyword_type_node(KindNeverKeyword))
            return factory.new_conditional_type_node(check_type_node, synthetic_extends_node, synthetic_true_node, factory.new_keyword_type_node(KindNeverKeyword))
        }
        let save_infer c.infer_type_parameters
        set c.infer_type_parameters: root.infer_type_parameters
        let extends_type_node this.type_to_type_node(extends_type)
        set c.infer_type_parameters: save_infer
        let true_type_node this.type_to_type_node_or_circularity_elision(checker.get_true_type_from_conditional_type(t))
        let false_type_node this.type_to_type_node_or_circularity_elision(checker.get_false_type_from_conditional_type(t))
        factory.new_conditional_type_node(check_type_node, extends_type_node, true_type_node, false_type_node)
    }

    ; ── mapped types ─────────────────────────────────────────────────────────

    procedure is_mapped_type_homomorphic(mutable this, mutable mapped: ref[Type]) returns bool
        checker.get_homomorphic_type_variable(mapped) <> null

    procedure is_homomorphic_mapped_type_with_non_homomorphic_instantiation(mutable this, mutable t: ref[Type]) returns bool
    {
        let target Checker.target_of(t)
        if target = null
            return false
        if this.is_mapped_type_homomorphic(t)
            return false
        this.is_mapped_type_homomorphic(target as ref[Type])
    }

    ; the constraint's inner type of a mapped type's parameter declaration
    function mapped_constraint_operand(decl: ref[AstNode]) returns ref[AstNode]?
    {
        let tp AstNode.mapped_type_parameter_of(decl)
        if tp = null
            return null
        let constraint AstNode.type_parameter_constraint_of(tp as ref[AstNode])
        if constraint = null
            return null
        let cn constraint as ref[AstNode]
        if cn.kind = KindTypeOperator
            return AstNode.type_operator_inner_of(cn)
        AstNode.type_of(cn)
    }

    ; createMappedTypeNodeFromType
    procedure create_mapped_type_node_from_type(mutable this, mutable t: ref[Type]) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let decl_opt Checker.mapped_declaration_of(t)
        if decl_opt = null
        {
            this.record_unported("node-builder-mapped-declaration", 0)
            return null
        }
        let declaration decl_opt as ref[AstNode]
        var mapper: ref[TypeMapper]? null
        choose t.data
            when md: Mapped
                set mapper: md.mapper
        var readonly_token: ref[AstNode]? null
        let rt AstNode.mapped_type_readonly_token_of(declaration)
        if rt <> null
            set readonly_token: factory.new_token((rt as ref[AstNode]).kind)
        var question_token: ref[AstNode]? null
        let qt AstNode.question_token_of(declaration)
        if qt <> null
            set question_token: factory.new_token((qt as ref[AstNode]).kind)
        var appropriate_constraint_type_node: ref[AstNode]? null
        var new_type_variable: ref[AstNode]? null
        var template_type checker.get_template_type_from_mapped_type(t)
        let type_parameter checker.get_type_parameter_from_mapped_type(t)
        if type_parameter = null
            return null
        let generate ((c.flags & NbFlagsGenerateNamesForShadowedTypeParams) <> 0)
        var needs_modifier_preserving_wrapper false
        if Checker.is_mapped_type_with_keyof_constraint_declaration(t) = false
        {
            let modifiers_type checker.get_modifiers_type_from_mapped_type(t)
            if modifiers_type <> null
            {
                if (((modifiers_type as ref[Type]).flags & TypeFlagsUnknown) = 0) and generate
                {
                    var keyof_constrained false
                    let constraint_type checker.get_constraint_type_from_mapped_type(t)
                    if constraint_type <> null
                    {
                        let ct constraint_type as ref[Type]
                        if (ct.flags & TypeFlagsTypeParameter) <> 0
                        {
                            let ctc checker.get_constraint_of_type_parameter(ct)
                            if ctc <> null
                            {
                                if ((ctc as ref[Type]).flags & TypeFlagsIndex) <> 0
                                    set keyof_constrained: true
                            }
                        }
                    }
                    if keyof_constrained = false
                        set needs_modifier_preserving_wrapper: true
                }
            }
        }
        if Checker.is_mapped_type_with_keyof_constraint_declaration(t)
        {
            if generate and this.is_homomorphic_mapped_type_with_non_homomorphic_instantiation(t)
            {
                let new_constraint_param checker.new_type_parameter(checker.new_symbol(SymbolFlagsTypeParameter, "T"))
                let name this.type_parameter_to_name(new_constraint_param)
                let target Checker.target_of(t) as ref[Type]
                set new_type_variable: factory.new_type_reference_node(name, null)
                let sources &Array[ref[Type]?]^host()
                sources.add(checker.get_type_parameter_from_mapped_type(target))
                sources.add(checker.get_modifiers_type_from_mapped_type(target))
                let targets &Array[ref[Type]?]^host()
                targets.add(type_parameter)
                targets.add(new_constraint_param)
                set template_type: checker.instantiate_type(checker.get_template_type_from_mapped_type(target), checker.new_type_mapper(sources, targets))
            }
            var index_target new_type_variable
            if index_target = null
                set index_target: this.type_to_type_node(checker.get_modifiers_type_from_mapped_type(t))
            set appropriate_constraint_type_node: factory.new_type_operator_node(KindKeyOfKeyword, index_target)
        }
        else
        {
            if needs_modifier_preserving_wrapper
            {
                let new_param checker.new_type_parameter(checker.new_symbol(SymbolFlagsTypeParameter, "T"))
                let name this.type_parameter_to_name(new_param)
                set new_type_variable: factory.new_type_reference_node(name, null)
                set appropriate_constraint_type_node: new_type_variable
            }
            else
                set appropriate_constraint_type_node: this.type_to_type_node(checker.get_constraint_type_from_mapped_type(t))
        }
        ; nameType and templateType nodes have to be in the new scope
        let scope_params &Array[ref[Type]?]^host()
        scope_params.add(checker.get_type_parameter_from_mapped_type(t))
        this.enter_new_scope(declaration, null, scope_params, null, null)
        let type_parameter_declaration_node this.type_parameter_to_declaration_with_constraint(type_parameter as ref[Type], appropriate_constraint_type_node)
        var name_type_node: ref[AstNode]? null
        if AstNode.mapped_type_name_type_of(declaration) <> null
            set name_type_node: this.type_to_type_node(checker.get_name_type_from_mapped_type(t))
        var include_optional false
        if (Checker.get_mapped_type_modifiers(t) & MappedTypeModifiersIncludeOptional) <> 0
            set include_optional: true
        var template_type_node: ref[AstNode]? null
        if template_type <> null
            set template_type_node: this.type_to_type_node(checker.remove_missing_type(template_type as ref[Type], include_optional))
        this.exit_scope()
        let result factory.new_mapped_type_node(readonly_token, type_parameter_declaration_node, name_type_node, question_token, template_type_node, null)
        this.add_approximate_length(10)
        context.add_emit_flags(result, EFSingleLine)
        if generate and this.is_homomorphic_mapped_type_with_non_homomorphic_instantiation(t)
        {
            var raw_constraint: ref[Type]? null
            let operand NodeBuilder.mapped_constraint_operand(declaration)
            if operand <> null
                set raw_constraint: this.get_type_from_type_node(operand as ref[AstNode], false)
            if raw_constraint <> null
                set raw_constraint: checker.get_constraint_of_type_parameter(raw_constraint as ref[Type])
            if raw_constraint = null
                set raw_constraint: checker.unknown_type
            let original_constraint checker.instantiate_type(raw_constraint, mapper)
            var original_constraint_node: ref[AstNode]? null
            if original_constraint <> null
            {
                if ((original_constraint as ref[Type]).flags & TypeFlagsUnknown) = 0
                    set original_constraint_node: this.type_to_type_node(original_constraint)
            }
            let ntv new_type_variable as ref[AstNode]
            return factory.new_conditional_type_node(this.type_to_type_node(checker.get_modifiers_type_from_mapped_type(t)), factory.new_infer_type_node(factory.new_type_parameter_declaration(null, factory.clone(AstNode.type_reference_name_of(ntv) as ref[AstNode]), original_constraint_node, null, null)), result, factory.new_keyword_type_node(KindNeverKeyword))
        }
        if needs_modifier_preserving_wrapper
        {
            let ntv new_type_variable as ref[AstNode]
            return factory.new_conditional_type_node(this.type_to_type_node(checker.get_constraint_type_from_mapped_type(t)), factory.new_infer_type_node(factory.new_type_parameter_declaration(null, factory.clone(AstNode.type_reference_name_of(ntv) as ref[AstNode]), factory.new_type_operator_node(KindKeyOfKeyword, this.type_to_type_node(checker.get_modifiers_type_from_mapped_type(t))), null, null)), result, factory.new_keyword_type_node(KindNeverKeyword))
        }
        result
    }

    ; ── anonymous and object types ───────────────────────────────────────────

    procedure create_anonymous_type_node(mutable this, mutable t: ref[Type]) returns ref[AstNode]?
        this.create_anonymous_type_node_ex(t, false, false)

    ; shouldWriteTypeOfFunctionSymbol, the boolean half
    procedure should_write_type_of_function_symbol(mutable this, mutable symbol: ref[Symbol], type_id: int) returns bool
    {
        let c this.the_ctx()
        var is_static_method_symbol false
        if (Symbol.flags_of(symbol) & SymbolFlagsMethod) <> 0
        {
            let b this.the_binder()
            let n Symbol.declaration_count(symbol)
            var i 0
            while i < n
            {
                let d Symbol.declaration_at(symbol, i)
                if d <> null
                {
                    if b.is_static(d)
                    {
                        let name this.declaration_name_of(d)
                        var late false
                        if name <> null
                            set late: checker.is_late_bindable_index_signature(name as ref[AstNode])
                        if late = false
                            set is_static_method_symbol: true
                    }
                }
                set i: i + 1
            }
        }
        let is_non_local_function_symbol this.is_non_local_function_symbol(symbol)
        if (is_static_method_symbol = false) and (is_non_local_function_symbol = false)
            return false
        let target this.type_of_function_symbol_target(symbol)
        var first ((c.flags & NbFlagsUseTypeOfFunction) <> 0)
        if first = false
            set first: this.visited_type(type_id)
        if first = false
            return false
        if (c.flags & NbFlagsUseStructuralFallback) = 0
            return true
        this.is_value_symbol_accessible(target, c.enclosing_declaration)
    }

    function is_non_local_function_symbol(this, symbol: ref[Symbol]) returns bool
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsFunction) = 0
            return false
        if Symbol.parent_of(symbol) <> null
            return true
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let decl d as ref[AstNode]
                let parent decl.parent
                if parent <> null
                {
                    let pk (parent as ref[AstNode]).kind
                    if (pk = KindSourceFile) or (pk = KindModuleBlock)
                        return true
                }
                if this.is_top_level_function_expression_symbol_declaration(decl)
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; the function-expression-in-a-top-level-variable shape
    function is_top_level_function_expression_symbol_declaration(this, decl: ref[AstNode]) returns bool
    {
        if (decl.kind <> KindFunctionExpression) and (decl.kind <> KindArrowFunction)
            return false
        let p1 decl.parent
        if p1 = null
            return false
        if (p1 as ref[AstNode]).kind <> KindVariableDeclaration
            return false
        let p2 (p1 as ref[AstNode]).parent
        if p2 = null
            return false
        if (p2 as ref[AstNode]).kind <> KindVariableDeclarationList
            return false
        let p3 (p2 as ref[AstNode]).parent
        if p3 = null
            return false
        if (p3 as ref[AstNode]).kind <> KindVariableStatement
            return false
        let p4 (p3 as ref[AstNode]).parent
        if p4 = null
            return false
        let k4 (p4 as ref[AstNode]).kind
        (k4 = KindSourceFile) or (k4 = KindModuleBlock)
    }

    ; the symbol shouldWriteTypeOfFunctionSymbol hands back: a function
    ; expression's variable is named through its parent
    function type_of_function_symbol_target(this, symbol: ref[Symbol]) returns ref[Symbol]
    {
        if (Symbol.flags_of(symbol) & SymbolFlagsFunction) = 0
            return symbol
        if Symbol.parent_of(symbol) <> null
            return symbol
        var is_function_expression_symbol false
        let n Symbol.declaration_count(symbol)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                let decl d as ref[AstNode]
                let parent decl.parent
                if parent <> null
                {
                    let pk (parent as ref[AstNode]).kind
                    if (pk = KindSourceFile) or (pk = KindModuleBlock)
                        return symbol
                }
                if this.is_top_level_function_expression_symbol_declaration(decl)
                {
                    set is_function_expression_symbol: true
                    set i: n
                }
            }
            set i: i + 1
        }
        if is_function_expression_symbol = false
            return symbol
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
            return symbol
        let vparent (vd as ref[AstNode]).parent
        if vparent = null
            return symbol
        if vparent = (this.the_ctx()).enclosing_declaration
            return symbol
        let merged checker.get_merged_symbol((vparent as ref[AstNode]).symbol)
        if merged = null
            return symbol
        merged as ref[Symbol]
    }

    ; shouldEmitTypeOfSymbol
    procedure should_emit_type_of_symbol(mutable this, force_expansion: bool, force_class_expansion: bool, is_instance_type: int, mutable symbol: ref[Symbol], type_id: int) returns bool
    {
        if force_expansion
            return false
        let c this.the_ctx()
        let flags Symbol.flags_of(symbol)
        var non_function_result false
        if ((flags & SymbolFlagsClass) <> 0) and (force_class_expansion = false)
        {
            if checker.get_base_type_variable_of_class(symbol) = null
            {
                var literal_class false
                let vd Symbol.value_declaration_of(symbol)
                if vd <> null
                {
                    let decl vd as ref[AstNode]
                    if NodeBuilder.is_class_like_kind(decl.kind) and ((c.flags & NbFlagsWriteClassExpressionAsTypeLiteral) <> 0)
                    {
                        if decl.kind <> KindClassDeclaration
                            set literal_class: true
                        else
                        {
                            if (checker.is_symbol_accessible(symbol, c.enclosing_declaration, is_instance_type, false)).accessibility <> SymbolAccessibilityAccessible
                                set literal_class: true
                        }
                    }
                }
                if literal_class = false
                    set non_function_result: true
            }
        }
        if (flags & (SymbolFlagsEnum | SymbolFlagsValueModule)) <> 0
            set non_function_result: true
        if non_function_result
            return true
        this.should_write_type_of_function_symbol(symbol, type_id)
    }

    ; createAnonymousTypeNodeEx
    procedure create_anonymous_type_node_ex(mutable this, mutable t: ref[Type], force_class_expansion: bool, force_expansion: bool) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let type_id t.id
        if t.symbol = null
            return this.create_type_node_from_object_type(t)
        let symbol t.symbol as ref[Symbol]
        if (t.object_flags & ObjectFlagsInstantiationExpressionType) <> 0
        {
            let existing Checker.instantiation_expression_node_of(t)
            if existing <> null
            {
                let ex existing as ref[AstNode]
                if ex.kind = KindTypeQuery
                {
                    if this.get_type_from_type_node(ex, false) = t
                    {
                        if this.visited_type(type_id)
                            return this.create_elided_information_placeholder()
                        this.add_visited_type(type_id)
                        let type_node this.try_reuse_existing_non_parameter_type_node(ex, t, null, null)
                        this.delete_visited_type(type_id)
                        if type_node <> null
                            return type_node
                    }
                }
            }
            if this.visited_type(type_id)
                return this.create_elided_information_placeholder()
            return this.visit_and_transform_type(t, NbTransformObjectType)
        }
        var is_instance_type SymbolFlagsValue
        if checker.is_class_instance_side(t, symbol)
            set is_instance_type: SymbolFlagsType
        if this.should_emit_type_of_symbol(force_expansion, force_class_expansion, is_instance_type, symbol, type_id)
        {
            if this.should_expand_type(t, false)
                set c.depth: c.depth + 1
            else
            {
                var target symbol
                if (Symbol.flags_of(symbol) & SymbolFlagsFunction) <> 0
                    set target: this.type_of_function_symbol_target(symbol)
                return this.symbol_to_type_node(target, is_instance_type, null)
            }
        }
        if this.visited_type(type_id)
        {
            let type_alias this.get_type_alias_for_type_literal(t)
            if type_alias <> null
                return this.symbol_to_type_node(type_alias as ref[Symbol], SymbolFlagsType, null)
            return this.create_elided_information_placeholder()
        }
        this.visit_and_transform_type(t, NbTransformObjectType)
    }

    ; getTypeAliasForTypeLiteral
    procedure get_type_alias_for_type_literal(mutable this, mutable t: ref[Type]) returns ref[Symbol]?
    {
        if t.symbol = null
            return null
        let sym t.symbol as ref[Symbol]
        if (Symbol.flags_of(sym) & SymbolFlagsTypeLiteral) = 0
            return null
        if Symbol.declaration_count(sym) = 0
            return null
        let d0 Symbol.declaration_at(sym, 0)
        if d0 = null
            return null
        let node Checker.walk_up_parenthesized_types((d0 as ref[AstNode]).parent)
        if node = null
            return null
        if (node as ref[AstNode]).kind <> KindTypeAliasDeclaration
            return null
        checker.get_symbol_of_declaration(node)
    }

    ; getResolvedTypeWithoutAbstractConstructSignatures
    procedure get_resolved_type_without_abstract_construct_signatures(mutable this, mutable t: ref[Type], mutable resolved: ref[StructuredMembers]) returns ref[Type]?
    {
        let construct_count this.construct_signature_count(resolved)
        if construct_count = 0
            return t
        if resolved.without_abstract_construct_signatures <> null
            return resolved.without_abstract_construct_signatures
        let sigs resolved.signatures as ref[Array[ref[Signature]?]]
        let call_sigs &Array[ref[Signature]?]^host()
        let construct_sigs &Array[ref[Signature]?]^host()
        var i 0
        while i < (sigs.get_length() as int)
        {
            let s sigs[i]
            if i < resolved.call_signature_count
                call_sigs.add(s)
            else
            {
                if s <> null
                {
                    if ((s as ref[Signature]).flags & SignatureFlagsAbstract) = 0
                        construct_sigs.add(s)
                }
            }
            set i: i + 1
        }
        if (construct_sigs.get_length() as int) = construct_count
        {
            set resolved.without_abstract_construct_signatures: t
            return t
        }
        let type_copy checker.new_anonymous_type(t.symbol, resolved.members, call_sigs, construct_sigs, resolved.index_infos)
        if type_copy = null
            return null
        set resolved.without_abstract_construct_signatures: type_copy
        let copy_resolved checker.resolve_structured_type_members(type_copy as ref[Type])
        if copy_resolved <> null
        {
            let cr copy_resolved as ref[StructuredMembers]
            set cr.without_abstract_construct_signatures: type_copy
        }
        type_copy
    }

    function construct_signature_count(this, resolved: ref[StructuredMembers]) returns int
    {
        if resolved.signatures = null
            return 0
        ((resolved.signatures as ref[Array[ref[Signature]?]]).get_length() as int) - resolved.call_signature_count
    }

    function property_count(resolved: ref[StructuredMembers]) returns int
    {
        if resolved.properties = null
            return 0
        (resolved.properties as ref[Array[ref[Symbol]?]]).get_length() as int
    }

    function index_info_count(resolved: ref[StructuredMembers]) returns int
    {
        if resolved.index_infos = null
            return 0
        (resolved.index_infos as ref[Array[ref[IndexInfo]?]]).get_length() as int
    }

    ; createTypeNodeFromObjectType
    procedure create_type_node_from_object_type(mutable this, mutable t: ref[Type]) returns ref[AstNode]?
    {
        let c this.the_ctx()
        var mapped_with_error false
        if (t.object_flags & ObjectFlagsMapped) <> 0
        {
            choose t.data
                when md: Mapped
                    set mapped_with_error: md.contains_error
        }
        if checker.is_generic_mapped_type(t) or mapped_with_error
            return this.create_mapped_type_node_from_type(t)
        let resolved_opt checker.resolve_structured_type_members(t)
        if resolved_opt = null
            return null
        let resolved resolved_opt as ref[StructuredMembers]
        let call_count resolved.call_signature_count
        let ctor_count this.construct_signature_count(resolved)
        if (NodeBuilder.property_count(resolved) = 0) and (NodeBuilder.index_info_count(resolved) = 0)
        {
            if (call_count = 0) and (ctor_count = 0)
            {
                this.add_approximate_length(2)
                let empty &Array[ref[AstNode]?]^host()
                let result factory.new_type_literal_node(empty)
                context.set_emit_flags(result, EFSingleLine)
                return result
            }
            let sigs resolved.signatures as ref[Array[ref[Signature]?]]
            if (call_count = 1) and (ctor_count = 0)
                return this.signature_to_signature_declaration_helper(sigs[0] as ref[Signature], KindFunctionType, null, null, null)
            if (ctor_count = 1) and (call_count = 0)
                return this.signature_to_signature_declaration_helper(sigs[0] as ref[Signature], KindConstructorType, null, null, null)
        }
        var abstract_count 0
        if ctor_count > 0
        {
            let sigs resolved.signatures as ref[Array[ref[Signature]?]]
            var i call_count
            while i < (sigs.get_length() as int)
            {
                let s sigs[i]
                if s <> null
                {
                    if ((s as ref[Signature]).flags & SignatureFlagsAbstract) <> 0
                        set abstract_count: abstract_count + 1
                }
                set i: i + 1
            }
        }
        if abstract_count > 0
        {
            let sigs resolved.signatures as ref[Array[ref[Signature]?]]
            let types &Array[ref[Type]?]^host()
            var i call_count
            while i < (sigs.get_length() as int)
            {
                let s sigs[i]
                if s <> null
                {
                    if ((s as ref[Signature]).flags & SignatureFlagsAbstract) <> 0
                        types.add(checker.get_or_create_type_from_signature(s as ref[Signature]))
                }
                set i: i + 1
            }
            var property_total NodeBuilder.property_count(resolved)
            if (c.flags & NbFlagsWriteClassExpressionAsTypeLiteral) <> 0
            {
                set property_total: 0
                let props resolved.properties as ref[Array[ref[Symbol]?]]
                var pi 0
                while pi < (props.get_length() as int)
                {
                    let p props[pi]
                    if p <> null
                    {
                        if (Symbol.flags_of(p as ref[Symbol]) & SymbolFlagsPrototype) = 0
                            set property_total: property_total + 1
                    }
                    set pi: pi + 1
                }
            }
            let type_element_count call_count + (ctor_count - abstract_count) + NodeBuilder.index_info_count(resolved) + property_total
            if type_element_count <> 0
                types.add(this.get_resolved_type_without_abstract_construct_signatures(t, resolved))
            return this.type_to_type_node(checker.get_intersection_type(types))
        }
        let f0 this.save_flags()
        let i0 this.save_internal_flags()
        let d0 this.save_depth()
        this.add_flag(NbFlagsInObjectTypeLiteral)
        let members this.create_type_nodes_from_resolved_type(t, resolved)
        this.restore_flags(f0, i0, d0)
        let type_literal_node factory.new_type_literal_node(members)
        this.add_approximate_length(2)
        if (c.flags & NbFlagsMultilineObjectLiterals) <> 0
            context.set_emit_flags(type_literal_node, 0)
        else
            context.set_emit_flags(type_literal_node, EFSingleLine)
        type_literal_node
    }

    ; createTypeNodesFromResolvedType
    procedure create_type_nodes_from_resolved_type(mutable this, t: ref[Type], mutable resolved: ref[StructuredMembers]) returns ref[Array[ref[AstNode]?]]?
    {
        let c this.the_ctx()
        if this.check_truncation_length()
        {
            let list &Array[ref[AstNode]?]^host()
            if (c.flags & NbFlagsNoTruncation) <> 0
                list.add(context.add_synthetic_trailing_comment(factory.new_not_emitted_type_element(), KindMultiLineCommentTrivia, "elided", false))
            else
                list.add(factory.new_property_signature_declaration(null, factory.new_identifier("..."), null, null, null))
            return list
        }
        let type_elements &Array[ref[AstNode]?]^host()
        if resolved.signatures <> null
        {
            let sigs resolved.signatures as ref[Array[ref[Signature]?]]
            var i 0
            while i < (sigs.get_length() as int)
            {
                let s sigs[i]
                if s <> null
                {
                    let sig s as ref[Signature]
                    if i < resolved.call_signature_count
                        type_elements.add(this.signature_to_signature_declaration_helper(sig, KindCallSignature, null, null, null))
                    else
                    {
                        if (sig.flags & SignatureFlagsAbstract) = 0
                            type_elements.add(this.signature_to_signature_declaration_helper(sig, KindConstructSignature, null, null, null))
                    }
                }
                set i: i + 1
            }
        }
        if resolved.index_infos <> null
        {
            let infos resolved.index_infos as ref[Array[ref[IndexInfo]?]]
            var i 0
            while i < (infos.get_length() as int)
            {
                let info infos[i]
                if info <> null
                {
                    var placeholder: ref[AstNode]? null
                    if (t.object_flags & ObjectFlagsReverseMapped) <> 0
                        set placeholder: this.create_elided_information_placeholder()
                    Transformer.add_all(type_elements, this.index_info_to_object_computed_names_or_signature_declaration(info as ref[IndexInfo], placeholder))
                }
                set i: i + 1
            }
        }
        if resolved.properties = null
            return type_elements
        let properties resolved.properties as ref[Array[ref[Symbol]?]]
        let n properties.get_length() as int
        if n = 0
            return type_elements
        var i 0
        var pi 0
        while pi < n
        {
            let p properties[pi]
            set pi: pi + 1
            if p <> null
            {
                let property_symbol p as ref[Symbol]
                set i: i + 1
                var skip false
                if (c.flags & NbFlagsWriteClassExpressionAsTypeLiteral) <> 0
                {
                    if (Symbol.flags_of(property_symbol) & SymbolFlagsPrototype) <> 0
                        set skip: true
                    else
                    {
                        if (checker.get_declaration_modifier_flags_from_symbol(property_symbol) & (ModifierFlagsPrivate | ModifierFlagsProtected)) <> 0
                            this.report_private_in_base_of_class_expression(Symbol.name_of(property_symbol))
                        if this.is_private_identifier_symbol(property_symbol)
                            this.report_private_in_base_of_class_expression(Printer.slice_on(host, checker.symbol_arg(property_symbol)))
                    }
                }
                if skip = false
                {
                    if this.check_truncation_length() and ((i + 2) < (n - 1))
                    {
                        let more this.int_text(n - i)
                        if (c.flags & NbFlagsNoTruncation) <> 0
                        {
                            let last_index (type_elements.get_length() as int) - 1
                            if last_index >= 0
                                type_elements.put(last_index as size_t, context.add_synthetic_trailing_comment(type_elements[last_index] as ref[AstNode], KindMultiLineCommentTrivia, this.concat3("... ", more, " more elided ..."), false))
                        }
                        else
                            type_elements.add(factory.new_property_signature_declaration(null, factory.new_identifier(this.concat3("... ", more, " more ...")), null, null, null))
                        let last properties[n - 1]
                        if last <> null
                            this.add_property_to_element_list(last as ref[Symbol], type_elements)
                        set pi: n
                    }
                    else
                        this.add_property_to_element_list(property_symbol, type_elements)
                }
            }
        }
        if (type_elements.get_length() as int) <> 0
            return type_elements
        null
    }

    ; IsPrivateIdentifierSymbol
    function is_private_identifier_symbol(this, symbol: ref[Symbol]) returns bool
    {
        let vd Symbol.value_declaration_of(symbol)
        if vd = null
            return false
        let name AstNode.name_of(vd)
        if name = null
            return false
        (name as ref[AstNode]).kind = KindPrivateIdentifier
    }

    ; shouldUsePlaceholderForProperty
    procedure should_use_placeholder_for_property(mutable this, property_symbol: ref[Symbol]) returns bool
    {
        if (Symbol.check_flags_of(property_symbol) & CheckFlagsReverseMapped) = 0
            return false
        let c this.the_ctx()
        let stack c.reverse_mapped_stack
        let n stack.get_length() as int
        var i 0
        while i < n
        {
            let s stack[i]
            if s <> null
            {
                if (s as ref[Symbol]) = property_symbol
                    return true
            }
            set i: i + 1
        }
        if n > 0
        {
            let last stack[n - 1]
            if last <> null
            {
                let property_type (checker.value_symbol_extra_read(this.links_of(last as ref[Symbol]))).reverse_property_type
                if property_type <> null
                {
                    if ((property_type as ref[Type]).object_flags & ObjectFlagsAnonymous) = 0
                        return true
                }
            }
        }
        if n < NbMaxReverseMappedNestingInspectionDepth
            return false
        let prop_mapped_type (checker.value_symbol_extra_read(this.links_of(property_symbol))).reverse_mapped_type
        if prop_mapped_type = null
            return false
        let pmt prop_mapped_type as ref[Type]
        if pmt.symbol = null
            return false
        set i: 0
        while i < n
        {
            if i > NbMaxReverseMappedNestingInspectionDepth
                return false
            let prop stack[n - 1 - i]
            if prop <> null
            {
                let mapped_type (checker.value_symbol_extra_read(this.links_of(prop as ref[Symbol]))).reverse_mapped_type
                if mapped_type <> null
                {
                    if (mapped_type as ref[Type]).symbol = pmt.symbol
                        return true
                }
            }
            set i: i + 1
        }
        false
    }

    ; trackComputedName
    procedure track_computed_name(mutable this, mutable access_expression: ref[AstNode], mutable enclosing: ref[AstNode]?)
    {
        let first_identifier Checker.get_first_identifier(access_expression)
        if first_identifier = null
            return
        let fi first_identifier as ref[AstNode]
        let text AstNode.identifier_text_of(fi)
        let name checker.resolve_name(enclosing, text, SymbolFlagsValue | SymbolFlagsExportValue, 0, true, false)
        if name <> null
        {
            this.track_symbol(name as ref[Symbol], enclosing, SymbolFlagsValue)
            return
        }
        let fallback checker.resolve_name(fi, text, SymbolFlagsValue | SymbolFlagsExportValue, 0, true, false)
        if fallback <> null
            this.track_symbol(fallback as ref[Symbol], enclosing, SymbolFlagsValue)
    }

    ; classifyPropertyName: 0 identifier, 1 numeric literal, 2 string literal
    function classify_property_name(name: Slice[char], string_named: bool, is_method: bool) returns int
    {
        let new_name: Slice[char] "new"
        if is_method and SymbolTable.names_equal(name, new_name)
            return 2
        if Checker.is_identifier_text(name)
            return 0
        if (string_named = false) and Checker.is_numeric_literal_name(name) and (NodeBuilder.starts_with_char(name, "-" as char) = false)
            return 1
        2
    }

    procedure create_property_name_node_for_identifier_or_literal(mutable this, name: Slice[char], single_quote: bool, string_named: bool, is_method: bool) returns ref[AstNode]
    {
        let kind NodeBuilder.classify_property_name(name, string_named, is_method)
        if kind = 0
            return this.new_identifier(name)
        if kind = 1
            return factory.new_numeric_literal(name, TokenFlagsNone)
        var flags TokenFlagsNone
        if single_quote
            set flags: TokenFlagsSingleQuote
        factory.new_string_literal(name, flags)
    }

    procedure is_string_named(mutable this, mutable d: ref[AstNode]) returns bool
    {
        let name this.declaration_name_of(d)
        if name = null
            return false
        let nm name as ref[AstNode]
        if nm.kind = KindComputedPropertyName
        {
            let t checker.check_expression(AstNode.expression_of(nm) as ref[AstNode])
            if t = null
                return false
            return ((t as ref[Type]).flags & TypeFlagsStringLike) <> 0
        }
        if nm.kind = KindElementAccessExpression
        {
            let t checker.check_expression(AstNode.element_access_argument_of(nm) as ref[AstNode])
            if t = null
                return false
            return ((t as ref[Type]).flags & TypeFlagsStringLike) <> 0
        }
        nm.kind = KindStringLiteral
    }

    function is_single_quoted_string_named(this, d: ref[AstNode]) returns bool
    {
        let name this.declaration_name_of(d)
        if name = null
            return false
        let nm name as ref[AstNode]
        if nm.kind <> KindStringLiteral
            return false
        (AstNode.string_token_flags_of(nm) & TokenFlagsSingleQuote) <> 0
    }

    ; getPropertyNameNodeForSymbol
    procedure get_property_name_node_for_symbol(mutable this, mutable symbol: ref[Symbol]) returns ref[AstNode]
    {
        let vd Symbol.value_declaration_of(symbol)
        if vd <> null
        {
            let decl_name AstNode.name_of(vd)
            if decl_name <> null
            {
                if (decl_name as ref[AstNode]).kind = KindPrivateIdentifier
                    return this.deep_clone_req(decl_name as ref[AstNode])
            }
        }
        let n Symbol.declaration_count(symbol)
        var string_named (n <> 0)
        var single_quote (n <> 0)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(symbol, i)
            if d <> null
            {
                if this.is_string_named(d as ref[AstNode]) = false
                    set string_named: false
                if this.is_single_quoted_string_named(d as ref[AstNode]) = false
                    set single_quote: false
            }
            set i: i + 1
        }
        let is_method ((Symbol.flags_of(symbol) & SymbolFlagsMethod) <> 0)
        let from_name_type this.get_property_name_node_for_symbol_from_name_type(symbol, single_quote, string_named, is_method)
        if from_name_type <> null
            return from_name_type as ref[AstNode]
        var name Symbol.name_of(symbol)
        ; `\xFE#nnn#x` — symbol ids are unstable, so the name becomes `__#private#x`
        if name.length >= 2
        {
            if ((name[0] as u8) = (0xFE as u8)) and (name[1] = ("#" as char))
            {
                var rest name.slice_from(2)
                while (rest.length > 0) and (rest[0] >= ("0" as char)) and (rest[0] <= ("9" as char))
                    set rest: rest.slice_from(1)
                let sb StringBuilder^host()
                sb.append("__#private")
                sb.append(rest.data, rest.length as size_t)
                set name: this.slice_of(&sb)
            }
        }
        this.create_property_name_node_for_identifier_or_literal(name, single_quote, string_named, is_method)
    }

    ; getPropertyNameNodeForSymbolFromNameType
    procedure get_property_name_node_for_symbol_from_name_type(mutable this, mutable symbol: ref[Symbol], single_quote: bool, string_named: bool, is_method: bool) returns ref[AstNode]?
    {
        let name_type this.name_type_of(symbol)
        if name_type = null
            return null
        let nt name_type as ref[Type]
        if (nt.flags & TypeFlagsStringOrNumberLiteral) <> 0
        {
            var name Slice[char]()
            if (nt.flags & TypeFlagsNumberLiteral) <> 0
                set name: this.number_text(Checker.literal_bits_of(nt))
            else
                set name: Checker.literal_text_of(nt)
            if Checker.is_identifier_text(name) = false
            {
                if string_named or (Checker.is_numeric_literal_name(name) = false)
                {
                    var flags TokenFlagsNone
                    if single_quote
                        set flags: TokenFlagsSingleQuote
                    return factory.new_string_literal(name, flags)
                }
            }
            if Checker.is_numeric_literal_name(name) and NodeBuilder.starts_with_char(name, "-" as char)
                return factory.new_computed_property_name(factory.new_prefix_unary_expression(KindMinusToken, factory.new_numeric_literal(name.slice_from(1), TokenFlagsNone)))
            return this.create_property_name_node_for_identifier_or_literal(name, single_quote, string_named, is_method)
        }
        if (nt.flags & TypeFlagsUniqueESSymbol) <> 0
        {
            if nt.symbol = null
                return null
            return factory.new_computed_property_name(this.symbol_to_expression(nt.symbol as ref[Symbol], SymbolFlagsValue))
        }
        null
    }

    ; filterType(t, not undefined)
    procedure without_undefined(mutable this, t: ref[Type]) returns ref[Type]?
    {
        if (t.flags & TypeFlagsUnion) = 0
            return t
        let members Checker.union_types_of(t)
        if members = null
            return t
        let ms members as ref[Array[ref[Type]?]]
        let kept &Array[ref[Type]?]^host()
        var i 0
        while i < (ms.get_length() as int)
        {
            let m ms[i]
            if m <> null
            {
                if ((m as ref[Type]).flags & TypeFlagsUndefined) = 0
                    kept.add(m)
            }
            set i: i + 1
        }
        if (kept.get_length() as int) = (ms.get_length() as int)
            return t
        checker.get_union_type(kept)
    }

    ; addPropertyToElementList
    procedure add_property_to_element_list(mutable this, mutable property_symbol: ref[Symbol], mutable type_elements: ref[Array[ref[AstNode]?]])
    {
        let c this.the_ctx()
        let property_is_reverse_mapped ((Symbol.check_flags_of(property_symbol) & CheckFlagsReverseMapped) <> 0)
        var property_type: ref[Type]? null
        if this.should_use_placeholder_for_property(property_symbol)
            set property_type: checker.any_type
        else
            set property_type: checker.get_non_missing_type_of_symbol(property_symbol)
        let save_enclosing_declaration c.enclosing_declaration
        this.set_enclosing(null)
        let name_text Symbol.name_of(property_symbol)
        if Checker.is_late_bound_name(name_text)
        {
            if Symbol.declaration_count(property_symbol) > 0
            {
                let decl_opt Symbol.declaration_at(property_symbol, 0)
                if decl_opt <> null
                {
                    let decl decl_opt as ref[AstNode]
                    if checker.has_late_bindable_name(decl)
                    {
                        if decl.kind = KindBinaryExpression
                        {
                            let name this.declaration_name_of(decl)
                            if name <> null
                            {
                                let nm name as ref[AstNode]
                                if nm.kind = KindElementAccessExpression
                                {
                                    let arg AstNode.element_access_argument_of(nm)
                                    if Parser.is_entity_name_expression(arg)
                                        this.track_computed_name(arg as ref[AstNode], save_enclosing_declaration)
                                }
                            }
                        }
                        else
                        {
                            let name AstNode.name_of(decl)
                            if name <> null
                            {
                                let expr AstNode.expression_of(name as ref[AstNode])
                                if expr <> null
                                    this.track_computed_name(expr as ref[AstNode], save_enclosing_declaration)
                            }
                        }
                    }
                }
            }
            else
                this.report_non_serializable_property(Printer.slice_on(host, checker.symbol_arg(property_symbol)))
        }
        let vd Symbol.value_declaration_of(property_symbol)
        if vd <> null
            this.set_enclosing(vd)
        else
        {
            var first: ref[AstNode]? null
            if Symbol.declaration_count(property_symbol) > 0
                set first: Symbol.declaration_at(property_symbol, 0)
            if first <> null
                this.set_enclosing(first)
            else
                this.set_enclosing(save_enclosing_declaration)
        }
        let property_name this.get_property_name_node_for_symbol(property_symbol)
        this.set_enclosing(save_enclosing_declaration)
        this.add_approximate_length(name_text.length + 1)
        if property_type = null
            set property_type: checker.error_type
        let ptype property_type as ref[Type]
        if (Symbol.flags_of(property_symbol) & SymbolFlagsAccessor) <> 0
        {
            let write_type_opt checker.get_write_type_of_symbol(property_symbol)
            if write_type_opt <> null
            {
                let write_type write_type_opt as ref[Type]
                if (checker.is_error_type(ptype) = false) and (checker.is_error_type(write_type) = false)
                {
                    let prop_declaration Checker.get_declaration_of_kind(property_symbol, KindPropertyDeclaration)
                    var parent_is_class false
                    let parent Symbol.parent_of(property_symbol)
                    if parent <> null
                    {
                        if (Symbol.flags_of(parent as ref[Symbol]) & SymbolFlagsClass) <> 0
                            set parent_is_class: true
                    }
                    var split (ptype <> write_type)
                    if parent_is_class and (prop_declaration = null)
                        set split: true
                    if split
                    {
                        let symbol_mapper (this.links_of(property_symbol)).mapper
                        let getter_declaration Checker.get_declaration_of_kind(property_symbol, KindGetAccessor)
                        if getter_declaration <> null
                        {
                            var getter_signature checker.get_signature_from_declaration(getter_declaration as ref[AstNode])
                            if (symbol_mapper <> null) and (getter_signature <> null)
                                set getter_signature: checker.instantiate_signature(getter_signature, symbol_mapper as ref[TypeMapper])
                            if getter_signature <> null
                            {
                                let getter this.signature_to_signature_declaration_helper(getter_signature as ref[Signature], KindGetAccessor, null, property_name, null)
                                if getter <> null
                                {
                                    this.set_comment_range(getter as ref[AstNode], getter_declaration)
                                    type_elements.add(getter)
                                }
                            }
                        }
                        let setter_declaration Checker.get_declaration_of_kind(property_symbol, KindSetAccessor)
                        if setter_declaration <> null
                        {
                            var setter_signature checker.get_signature_from_declaration(setter_declaration as ref[AstNode])
                            if (symbol_mapper <> null) and (setter_signature <> null)
                                set setter_signature: checker.instantiate_signature(setter_signature, symbol_mapper as ref[TypeMapper])
                            if setter_signature <> null
                            {
                                let setter this.signature_to_signature_declaration_helper(setter_signature as ref[Signature], KindSetAccessor, null, property_name, null)
                                if setter <> null
                                {
                                    this.set_comment_range(setter as ref[AstNode], setter_declaration)
                                    type_elements.add(setter)
                                }
                            }
                        }
                        return
                    }
                    if parent_is_class and (prop_declaration <> null)
                    {
                        if Parser.has_modifier(AstNode.modifiers_of(prop_declaration as ref[AstNode]), KindAccessorKeyword)
                        {
                            let fake_getter_signature checker.new_signature(0, null, null, null, null, ptype, 0)
                            let fake_getter this.signature_to_signature_declaration_helper(fake_getter_signature, KindGetAccessor, null, property_name, null)
                            if fake_getter <> null
                            {
                                this.set_comment_range(fake_getter as ref[AstNode], prop_declaration)
                                type_elements.add(fake_getter)
                            }
                            let setter_param checker.new_symbol(SymbolFlagsFunctionScopedVariable, "arg")
                            let setter_links this.links_of(setter_param)
                            set setter_links.resolved_type: write_type
                            let params &Array[ref[Symbol]?]^host()
                            params.add(setter_param)
                            let fake_setter_signature checker.new_signature(0, null, null, null, params, checker.void_type, 0)
                            let fake_setter this.signature_to_signature_declaration_helper(fake_setter_signature, KindSetAccessor, null, property_name, null)
                            if fake_setter <> null
                                type_elements.add(fake_setter)
                            return
                        }
                    }
                }
            }
        }
        var optional_token: ref[AstNode]? null
        if (Symbol.flags_of(property_symbol) & SymbolFlagsOptional) <> 0
            set optional_token: factory.new_token(KindQuestionToken)
        if (Symbol.flags_of(property_symbol) & (SymbolFlagsFunction | SymbolFlagsMethod)) <> 0
        {
            let props checker.get_properties_of_object_type(ptype)
            var no_props true
            if props <> null
            {
                if ((props as ref[Array[ref[Symbol]?]]).get_length() as int) > 0
                    set no_props: false
            }
            if no_props and (checker.is_readonly_symbol(property_symbol) = false)
            {
                let filtered this.without_undefined(ptype)
                var signature_count 0
                if filtered <> null
                {
                    let signatures checker.get_signatures_of_type(filtered as ref[Type], SignatureKindCall)
                    if signatures <> null
                    {
                        let sigs signatures as ref[Array[ref[Signature]?]]
                        set signature_count: sigs.get_length() as int
                        var i 0
                        while i < signature_count
                        {
                            let s sigs[i]
                            if s <> null
                            {
                                let sig s as ref[Signature]
                                let method_declaration this.signature_to_signature_declaration_helper(sig, KindMethodSignature, null, property_name, optional_token)
                                if method_declaration <> null
                                {
                                    var range sig.declaration
                                    if range = null
                                        set range: Symbol.value_declaration_of(property_symbol)
                                    this.set_comment_range(method_declaration as ref[AstNode], range)
                                    type_elements.add(method_declaration)
                                }
                            }
                            set i: i + 1
                        }
                    }
                }
                if (signature_count <> 0) or (optional_token = null)
                    return
            }
        }
        var property_type_node: ref[AstNode]? null
        if this.should_use_placeholder_for_property(property_symbol)
            set property_type_node: this.create_elided_information_placeholder()
        else
        {
            if property_is_reverse_mapped
                c.reverse_mapped_stack.add(property_symbol)
            set property_type_node: this.serialize_type_for_declaration(null, ptype, property_symbol, true)
            if property_is_reverse_mapped
            {
                let n c.reverse_mapped_stack.get_length() as int
                set c.reverse_mapped_stack: NodeBuilder.symbols_prefix(host, c.reverse_mapped_stack, n - 1)
            }
        }
        var modifiers: ref[Array[ref[AstNode]?]]? null
        if checker.is_readonly_symbol(property_symbol)
        {
            let mods &Array[ref[AstNode]?]^host()
            mods.add(factory.new_token(KindReadonlyKeyword))
            set modifiers: mods
            this.add_approximate_length(9)
        }
        let property_signature factory.new_property_signature_declaration(modifiers, property_name, optional_token, property_type_node, null)
        this.set_comment_range(property_signature, Symbol.value_declaration_of(property_symbol))
        type_elements.add(property_signature)
    }

    ; ── index signatures, predicates, signatures, parameters ─────────────────

    function get_name_from_index_info(info: ref[IndexInfo]) returns Slice[char]
    {
        let x_name: Slice[char] "x"
        if info.declaration = null
            return x_name
        let params AstNode.parameters_of(info.declaration)
        if AstNode.list_count(params) = 0
            return x_name
        let p AstNode.child_in_list(params, 0)
        if p = null
            return x_name
        let name AstNode.name_of(p)
        if name = null
            return x_name
        if (name as ref[AstNode]).kind <> KindIdentifier
            return x_name
        AstNode.identifier_text_of(name as ref[AstNode])
    }

    ; isTriviallySerializableComputedName: a computed name that is an entity
    ; name visible from the enclosing declaration
    procedure is_trivially_serializable_computed_name(mutable this, mutable e: ref[AstNode]?) returns bool
    {
        if e = null
            return false
        let name AstNode.name_of(e)
        if name = null
            return false
        let nm name as ref[AstNode]
        if nm.kind <> KindComputedPropertyName
            return false
        let expr AstNode.expression_of(nm)
        if Parser.is_entity_name_expression(expr) = false
            return false
        (checker.is_entity_name_visible(expr as ref[AstNode], (this.the_ctx()).enclosing_declaration, false)).accessibility = SymbolAccessibilityAccessible
    }

    procedure is_trivially_serializable_computed_name_at(mutable this, mutable e: ref[AstNode]?, mutable enclosing: ref[AstNode]?) returns bool
    {
        if e = null
            return false
        let name AstNode.name_of(e)
        if name = null
            return false
        let nm name as ref[AstNode]
        if nm.kind <> KindComputedPropertyName
            return false
        let expr AstNode.expression_of(nm)
        if Parser.is_entity_name_expression(expr) = false
            return false
        (checker.is_entity_name_visible(expr as ref[AstNode], enclosing, false)).accessibility = SymbolAccessibilityAccessible
    }

    ; indexInfoToObjectComputedNamesOrSignatureDeclaration: an index info derived
    ; from computed property names is written as those properties when every
    ; name is visible, else as the index signature
    procedure index_info_to_object_computed_names_or_signature_declaration(mutable this, mutable info: ref[IndexInfo], mutable type_node: ref[AstNode]?) returns ref[Array[ref[AstNode]?]]
    {
        let c this.the_ctx()
        if (info.components <> null) and (c.enclosing_declaration <> null)
        {
            let comps info.components as ref[Array[ref[AstNode]?]]
            let n comps.get_length() as int
            if n > 0
            {
                var all_serializable true
                var i 0
                while i < n
                {
                    if this.is_trivially_serializable_computed_name(comps[i]) = false
                        set all_serializable: false
                    set i: i + 1
                }
                if all_serializable
                {
                    let results &Array[ref[AstNode]?]^host()
                    var bailed false
                    set i: 0
                    while i < n
                    {
                        let co comps[i]
                        if co <> null
                        {
                            let e co as ref[AstNode]
                            ; late-bound props that contribute are created by property creation
                            if checker.has_late_bindable_name(e) = false
                            {
                                let name this.reuse_node(AstNode.name_of(e))
                                if name <> null
                                {
                                    let expr AstNode.expression_of(AstNode.name_of(e) as ref[AstNode])
                                    if expr <> null
                                        this.track_computed_name(expr as ref[AstNode], c.enclosing_declaration)
                                    var mods: ref[Array[ref[AstNode]?]]? null
                                    if info.is_readonly
                                    {
                                        let list &Array[ref[AstNode]?]^host()
                                        list.add(factory.new_token(KindReadonlyKeyword))
                                        set mods: list
                                    }
                                    var postfix_token: ref[AstNode]? null
                                    let pt AstNode.postfix_token_of(e)
                                    if pt <> null
                                        set postfix_token: factory.clone(pt as ref[AstNode])
                                    var current_type_node: ref[AstNode]? null
                                    if type_node <> null
                                        set current_type_node: this.deep_clone(type_node)
                                    else
                                    {
                                        if e.symbol <> null
                                            set current_type_node: this.type_to_type_node(checker.get_type_of_symbol(e.symbol as ref[Symbol]))
                                    }
                                    let sig factory.new_property_signature_declaration(mods, name, postfix_token, current_type_node, null)
                                    set sig.pos: e.pos
                                    set sig.end: e.end
                                    results.add(sig)
                                }
                                else
                                    set bailed: true
                            }
                        }
                        set i: i + 1
                    }
                    if bailed = false
                        return results
                }
            }
        }
        let out &Array[ref[AstNode]?]^host()
        out.add(this.index_info_to_index_signature_declaration_helper(info, type_node))
        out
    }

    ; indexInfoToIndexSignatureDeclarationHelper
    procedure index_info_to_index_signature_declaration_helper(mutable this, mutable info: ref[IndexInfo], type_node_in: ref[AstNode]?) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let name NodeBuilder.get_name_from_index_info(info)
        let indexer_type_node this.type_to_type_node(info.key_type)
        let indexing_parameter factory.new_parameter_declaration(null, null, this.new_identifier(name), null, indexer_type_node, null)
        var type_node type_node_in
        if type_node = null
        {
            if info.value_type = null
                set type_node: factory.new_keyword_type_node(KindAnyKeyword)
            else
                set type_node: this.type_to_type_node(info.value_type)
        }
        if (info.value_type = null) and ((c.flags & NbFlagsAllowEmptyIndexInfoType) = 0)
            this.note_error("e8")
        this.add_approximate_length(name.length + 4)
        var modifiers: ref[Array[ref[AstNode]?]]? null
        if info.is_readonly
        {
            this.add_approximate_length(9)
            let mods &Array[ref[AstNode]?]^host()
            mods.add(factory.new_token(KindReadonlyKeyword))
            set modifiers: mods
        }
        let params &Array[ref[AstNode]?]^host()
        params.add(indexing_parameter)
        factory.new_index_signature_declaration(modifiers, params, type_node)
    }

    ; typePredicateToTypePredicateNode and its helper — the same node
    procedure type_predicate_to_type_predicate_node(mutable this, mutable predicate: ref[TypePredicate]) returns ref[AstNode]?
        this.type_predicate_to_type_predicate_node_helper(predicate)

    procedure type_predicate_to_type_predicate_node_helper(mutable this, mutable predicate: ref[TypePredicate]) returns ref[AstNode]?
    {
        var asserts_modifier: ref[AstNode]? null
        if (predicate.kind = TypePredicateKindAssertsThis) or (predicate.kind = TypePredicateKindAssertsIdentifier)
            set asserts_modifier: factory.new_token(KindAssertsKeyword)
        var parameter_name: ref[AstNode]? null
        if (predicate.kind = TypePredicateKindIdentifier) or (predicate.kind = TypePredicateKindAssertsIdentifier)
        {
            let id this.new_identifier(predicate.parameter_name)
            context.set_emit_flags(id, EFNoAsciiEscaping)
            set parameter_name: id
        }
        else
            set parameter_name: factory.new_this_type_node()
        var type_node: ref[AstNode]? null
        if predicate.t <> null
            set type_node: this.type_to_type_node(predicate.t)
        factory.new_type_predicate_node(asserts_modifier, parameter_name, type_node)
    }

    ; getEffectiveParameterDeclaration
    function get_effective_parameter_declaration(symbol: ref[Symbol]) returns ref[AstNode]?
    {
        let parameter_declaration Checker.get_declaration_of_kind(symbol, KindParameter)
        if parameter_declaration <> null
            return parameter_declaration
        if (Symbol.flags_of(symbol) & SymbolFlagsTransient) = 0
            return Checker.get_declaration_of_kind(symbol, KindJSDocParameterTag)
        null
    }

    ; symbolToParameterDeclaration
    procedure symbol_to_parameter_declaration(mutable this, mutable parameter_symbol: ref[Symbol], preserve_modifier_flags: bool) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let parameter_declaration NodeBuilder.get_effective_parameter_declaration(parameter_symbol)
        let parameter_type checker.get_type_of_symbol(parameter_symbol)
        let parameter_type_node this.serialize_type_for_declaration(parameter_declaration, parameter_type, parameter_symbol, true)
        var modifiers: ref[Array[ref[AstNode]?]]? null
        if ((c.flags & NbFlagsOmitParameterModifiers) = 0) and preserve_modifier_flags and (parameter_declaration <> null)
        {
            let pd parameter_declaration as ref[AstNode]
            if Transformer.dt_can_have_modifiers(pd)
            {
                let originals AstNode.modifiers_of(pd)
                let n AstNode.list_count(originals)
                if n > 0
                {
                    let clones &Array[ref[AstNode]?]^host()
                    var i 0
                    while i < n
                    {
                        let m AstNode.child_in_list(originals, i)
                        if m <> null
                        {
                            if (m as ref[AstNode]).kind <> KindDecorator
                                clones.add(factory.clone(m as ref[AstNode]))
                        }
                        set i: i + 1
                    }
                    if (clones.get_length() as int) > 0
                        set modifiers: clones
                }
            }
        }
        var is_rest ((Symbol.check_flags_of(parameter_symbol) & CheckFlagsRestParameter) <> 0)
        if parameter_declaration <> null
        {
            if Checker.is_rest_parameter(parameter_declaration as ref[AstNode])
                set is_rest: true
        }
        var dot_dot_dot_token: ref[AstNode]? null
        if is_rest
            set dot_dot_dot_token: factory.new_token(KindDotDotDotToken)
        let name this.parameter_to_parameter_declaration_name(parameter_symbol, parameter_declaration)
        var is_optional ((Symbol.check_flags_of(parameter_symbol) & CheckFlagsOptionalParameter) <> 0)
        if parameter_declaration <> null
        {
            if checker.is_optional_parameter(parameter_declaration as ref[AstNode])
                set is_optional: true
        }
        var question_token: ref[AstNode]? null
        if is_optional
            set question_token: factory.new_token(KindQuestionToken)
        let parameter_node factory.new_parameter_declaration(modifiers, dot_dot_dot_token, name, question_token, parameter_type_node, null)
        this.add_approximate_length(Symbol.name_len_of(parameter_symbol) + 3)
        parameter_node
    }

    ; parameterToParameterDeclarationName
    procedure parameter_to_parameter_declaration_name(mutable this, parameter_symbol: ref[Symbol], mutable parameter_declaration: ref[AstNode]?) returns ref[AstNode]?
    {
        if parameter_declaration = null
            return this.new_identifier(Symbol.name_of(parameter_symbol))
        let name AstNode.name_of(parameter_declaration)
        if name = null
            return this.new_identifier(Symbol.name_of(parameter_symbol))
        let nm name as ref[AstNode]
        if nm.kind = KindIdentifier
        {
            let cloned this.deep_clone_req(nm)
            context.set_emit_flags(cloned, EFNoAsciiEscaping)
            return cloned
        }
        if nm.kind = KindQualifiedName
        {
            let cloned this.deep_clone_req(AstNode.qualified_right_of(nm) as ref[AstNode])
            context.set_emit_flags(cloned, EFNoAsciiEscaping)
            return cloned
        }
        this.clone_binding_name(nm)
    }

    ; the two sub-visitors, made on first use through the transformer's visitor
    procedure the_clone_binding_visitor(mutable this) returns ref[NodeVisitor]
    {
        if clone_binding_visitor = null
        {
            let v context.new_node_visitor(VisitTagTransformer)
            set v.transformer: tracker
            set v.sub_tag: DtSubNbCloneBinding
            set this.clone_binding_visitor: v
        }
        clone_binding_visitor as ref[NodeVisitor]
    }

    procedure the_existing_visitor(mutable this) returns ref[NodeVisitor]
    {
        if existing_visitor = null
        {
            let v context.new_node_visitor(VisitTagTransformer)
            set v.transformer: tracker
            set v.sub_tag: DtSubNbExisting
            set this.existing_visitor: v
        }
        existing_visitor as ref[NodeVisitor]
    }

    ; cloneBindingName — the visitor's callback and the entry alike
    procedure clone_binding_name(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindComputedPropertyName
        {
            if checker.is_late_bindable_name(node)
            {
                let expr AstNode.expression_of(node)
                if expr <> null
                    this.track_computed_name(expr as ref[AstNode], (this.the_ctx()).enclosing_declaration)
            }
        }
        var visited (this.the_clone_binding_visitor()).visit_each_child(node)
        if visited = null
            return null
        var v visited as ref[AstNode]
        if v.kind = KindBindingElement
            set v: factory.update_binding_element(v, AstNode.dot_dot_dot_token_of(v), AstNode.property_name_of(v), AstNode.name_of(v), null)
        if Printer.node_is_synthesized(v) = false
            set v: this.deep_clone_req(v)
        context.set_emit_flags(v, EFSingleLine | EFNoAsciiEscaping)
        v
    }

    ; serializeTypeForExpression
    procedure serialize_type_for_expression(mutable this, mutable expr: ref[AstNode]) returns ref[AstNode]?
    {
        let regular checker.get_regular_type_of_expression(expr)
        if regular = null
            return null
        let widened checker.get_widened_type(regular as ref[Type])
        if widened = null
            return null
        this.type_to_type_node(checker.instantiate_type(widened, (this.the_ctx()).mapper))
    }

    ; serializeInferredReturnTypeForSignature
    procedure serialize_inferred_return_type_for_signature(mutable this, mutable signature: ref[Signature], mutable return_type: ref[Type]?) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let old_suppress c.suppress_report_inference_fallback
        set c.suppress_report_inference_fallback: true
        var return_type_node: ref[AstNode]? null
        let type_predicate checker.get_type_predicate_of_signature(signature)
        if type_predicate <> null
        {
            var predicate type_predicate
            if c.mapper <> null
                set predicate: checker.instantiate_type_predicate(type_predicate as ref[TypePredicate], c.mapper)
            if predicate <> null
                set return_type_node: this.type_predicate_to_type_predicate_node_helper(predicate as ref[TypePredicate])
        }
        else
            set return_type_node: this.type_to_type_node(return_type)
        set c.suppress_report_inference_fallback: old_suppress
        return_type_node
    }

    ; ── checker/pseudotypenodebuilder.go (slice 252): pseudo types to nodes ──

    procedure report_error_nodes(mutable this, mutable error_nodes: ref[Array[ref[AstNode]?]]?)
    {
        if error_nodes = null
            return
        let list error_nodes as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            this.report_inference_fallback(list[i])
            set i: i + 1
        }
    }

    ; pseudoTypeToNodeWithCheckerFallback: an Inferred top level reports and
    ; serializes the checker's type; a Direct one the checker's type when the
    ; annotation cannot be reused
    procedure pseudo_type_to_node_with_checker_fallback(mutable this, mutable t: ref[PseudoType], mutable checker_type: ref[Type]?) returns ref[AstNode]?
    {
        let c this.the_ctx()
        if t.kind = PseudoTypeKindInferred
        {
            if c.suppress_report_inference_fallback = false
            {
                if PseudoChecker.error_node_count(t) > 0
                    this.report_error_nodes(t.error_nodes)
                else
                    this.report_inference_fallback(t.node)
            }
            let old_suppress c.suppress_report_inference_fallback
            set c.suppress_report_inference_fallback: true
            let result this.type_to_type_node(checker_type)
            set c.suppress_report_inference_fallback: old_suppress
            return result
        }
        if t.kind = PseudoTypeKindDirect
        {
            let existing t.node as ref[AstNode]
            var reusable true
            if checker_type <> null
                set reusable: this.can_reuse_existing_js_type_node(existing, checker_type as ref[Type])
            if reusable = false
            {
                if c.suppress_report_inference_fallback = false
                    this.report_inference_fallback(existing)
                let old_suppress c.suppress_report_inference_fallback
                set c.suppress_report_inference_fallback: true
                let result this.type_to_type_node(checker_type)
                set c.suppress_report_inference_fallback: old_suppress
                return result
            }
        }
        this.pseudo_type_to_node(t)
    }

    ; serializeReturnTypeForSignature(getSignatureFromDeclaration(node), false)
    procedure serialize_return_type_of_declaration(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        let signature checker.get_signature_from_declaration(node)
        if signature = null
        {
            this.record_unported("node-builder-pseudo-signature", node.kind)
            return null
        }
        this.serialize_return_type_for_signature(signature as ref[Signature], false)
    }

    ; pseudoTypeToNode: maps a pseudo type to a node and reports the inference
    ; fallbacks its structure implies
    procedure pseudo_type_to_node(mutable this, mutable t: ref[PseudoType]) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let k t.kind
        if k = PseudoTypeKindDirect
            return this.reuse_type_node(t.node)
        if k = PseudoTypeKindInferred
        {
            let node t.node as ref[AstNode]
            if PseudoChecker.error_node_count(t) > 0
                this.report_error_nodes(t.error_nodes)
            else
            {
                var at node
                if node.parent <> null
                {
                    if Parser.is_entity_name_expression(node)
                    {
                        if AstNode.is_declaration(node.parent)
                            set at: node.parent as ref[AstNode]
                    }
                }
                this.report_inference_fallback(at)
            }
            if t.is_signature_return
                return this.serialize_return_type_of_declaration(node)
            ; the symbol type of the parent declaration handles widening
            if node.parent <> null
            {
                let p node.parent as ref[AstNode]
                if p.kind = KindReturnStatement
                {
                    let enclosing Checker.get_containing_function(node)
                    if enclosing <> null
                    {
                        let en enclosing as ref[AstNode]
                        if NodeBuilder.is_accessor_kind(en.kind)
                            return this.serialize_type_for_declaration(en, null, null, false)
                        return this.serialize_return_type_of_declaration(en)
                    }
                }
                if p.kind = KindArrowFunction
                {
                    if AstNode.body_of(p) = node
                        return this.serialize_return_type_of_declaration(p)
                }
                if AstNode.is_declaration(p)
                    return this.serialize_type_for_declaration(p, null, null, false)
            }
            return this.type_to_type_node(checker.get_type_of_expression(node))
        }
        if k = PseudoTypeKindNoResult
        {
            let node t.node as ref[AstNode]
            this.report_inference_fallback(node)
            if AstNode.is_function_like(node)
            {
                if NodeBuilder.is_accessor_kind(node.kind) = false
                    return this.serialize_return_type_of_declaration(node)
            }
            return this.serialize_type_for_declaration(node, null, null, false)
        }
        if k = PseudoTypeKindMaybeConstLocation
        {
            ; checkExpressionWithContextualType's literal widening, emulated
            let loc t.node as ref[AstNode]
            var is_in_const_context checker.is_const_context(loc)
            if is_in_const_context = false
            {
                ; the contextual type only where the syntactic check also sees a
                ; const context (post-inference contextual types otherwise)
                if PseudoChecker.is_in_const_context(loc)
                {
                    let contextual_type checker.get_contextual_type(loc, ContextFlagsNone)
                    let const_type this.pseudo_type_to_type(t.const_type as ref[PseudoType])
                    if const_type <> null
                    {
                        let instantiated checker.instantiate_contextual_type(contextual_type, loc, ContextFlagsNone)
                        if checker.is_literal_of_contextual_type(const_type as ref[Type], instantiated)
                            set is_in_const_context: true
                    }
                }
            }
            if is_in_const_context
                return this.pseudo_type_to_node(t.const_type as ref[PseudoType])
            return this.pseudo_type_to_node(t.regular_type as ref[PseudoType])
        }
        if k = PseudoTypeKindUnion
        {
            let res &Array[ref[AstNode]?]^host()
            var has_elided_type false
            var has_undefined false
            let n PseudoChecker.member_count(t)
            var i 0
            while i < n
            {
                let members t.members as ref[Array[ref[PseudoType]?]]
                let m members[i] as ref[PseudoType]
                set i: i + 1
                if Checker.strict_null_checks() = false
                {
                    if (m.kind = PseudoTypeKindUndefined) or (m.kind = PseudoTypeKindNull)
                    {
                        set has_elided_type: true
                        continue
                    }
                }
                let member_node this.pseudo_type_to_node(m)
                if member_node <> null
                    this.append_union_member_node(res, member_node as ref[AstNode], &has_undefined)
            }
            let count res.get_length() as int
            if count = 1
                return res[0]
            if count = 0
            {
                if has_elided_type
                    return factory.new_keyword_type_node(KindAnyKeyword)
                return factory.new_keyword_type_node(KindNeverKeyword)
            }
            return factory.new_union_type_node(res)
        }
        if k = PseudoTypeKindUndefined
        {
            if Checker.strict_null_checks() = false
                return factory.new_keyword_type_node(KindAnyKeyword)
            return factory.new_keyword_type_node(KindUndefinedKeyword)
        }
        if k = PseudoTypeKindNull
        {
            if Checker.strict_null_checks() = false
                return factory.new_keyword_type_node(KindAnyKeyword)
            return factory.new_literal_type_node(factory.new_keyword_expression(KindNullKeyword))
        }
        if k = PseudoTypeKindAny
            return factory.new_keyword_type_node(KindAnyKeyword)
        if k = PseudoTypeKindString
            return factory.new_keyword_type_node(KindStringKeyword)
        if k = PseudoTypeKindNumber
            return factory.new_keyword_type_node(KindNumberKeyword)
        if k = PseudoTypeKindBigInt
            return factory.new_keyword_type_node(KindBigIntKeyword)
        if k = PseudoTypeKindBoolean
            return factory.new_keyword_type_node(KindBooleanKeyword)
        if k = PseudoTypeKindFalse
            return factory.new_literal_type_node(factory.new_keyword_expression(KindFalseKeyword))
        if k = PseudoTypeKindTrue
            return factory.new_literal_type_node(factory.new_keyword_expression(KindTrueKeyword))
        if k = PseudoTypeKindSingleCallSignature
        {
            let sig_node t.node as ref[AstNode]
            let signature checker.get_signature_from_declaration(sig_node)
            if signature = null
            {
                this.record_unported("node-builder-pseudo-signature", sig_node.kind)
                return null
            }
            let sig signature as ref[Signature]
            let expanded_params checker.get_expanded_parameters(sig)
            this.enter_new_scope(sig_node, expanded_params, sig.type_parameters, sig.parameters, sig.mapper)
            let type_params this.reuse_type_parameter_nodes(t.type_parameters)
            let params this.pseudo_parameters_to_node_list(t.parameters)
            let return_type this.pseudo_type_to_node(t.return_type as ref[PseudoType])
            let result factory.new_function_type_node(type_params, params, return_type)
            this.exit_scope()
            return result
        }
        if k = PseudoTypeKindTuple
        {
            let res &Array[ref[AstNode]?]^host()
            let n PseudoChecker.member_count(t)
            var i 0
            while i < n
            {
                let members t.members as ref[Array[ref[PseudoType]?]]
                let e members[i]
                if e <> null
                    res.add(this.pseudo_type_to_node(e as ref[PseudoType]))
                set i: i + 1
            }
            ; pseudo-tuples are implicitly `readonly`: they come from `as const`
            let result factory.new_tuple_type_node(res)
            context.add_emit_flags(result, EFSingleLine)
            return factory.new_type_operator_node(KindReadonlyKeyword, result)
        }
        if k = PseudoTypeKindObjectLiteral
            return this.pseudo_object_literal_to_node(t)
        if (k = PseudoTypeKindStringLiteral) or (k = PseudoTypeKindNumericLiteral) or (k = PseudoTypeKindBigIntLiteral)
            return factory.new_literal_type_node(this.reuse_node(t.node))
        this.record_unported("node-builder-pseudo-kind", k)
        null
    }

    ; the union arm's appendTypeNode: nested unions flattened, one `undefined`
    procedure append_union_member_node(this, mutable res: ref[Array[ref[AstNode]?]], node: ref[AstNode], mutable has_undefined: ref[bool])
    {
        if node.kind = KindUnionType
        {
            let inner AstNode.type_list_of(node)
            let n AstNode.list_count(inner)
            var i 0
            while i < n
            {
                let m AstNode.child_in_list(inner, i)
                if m <> null
                    this.append_union_member_node(res, m as ref[AstNode], has_undefined)
                set i: i + 1
            }
            return
        }
        if node.kind = KindUndefinedKeyword
        {
            if has_undefined
                return
            set has_undefined: true
        }
        res.add(node)
    }

    ; the type parameters of a pseudo signature, each through reuseNode
    procedure reuse_type_parameter_nodes(mutable this, mutable type_parameters: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        let n AstNode.list_count(type_parameters)
        if n = 0
            return null
        let res &Array[ref[AstNode]?]^host()
        var i 0
        while i < n
        {
            res.add(this.reuse_node(AstNode.child_in_list(type_parameters, i)))
            set i: i + 1
        }
        res
    }

    ; the ObjectLiteral arm of pseudoTypeToNode
    procedure pseudo_object_literal_to_node(mutable this, mutable t: ref[PseudoType]) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let n PseudoChecker.element_count(t)
        if n = 0
        {
            let no_members &Array[ref[AstNode]?]^host()
            let empty factory.new_type_literal_node(no_members)
            context.add_emit_flags(empty, EFSingleLine)
            return empty
        }
        let elements t.elements as ref[Array[ref[PseudoObjectElement]?]]
        let first elements[0] as ref[PseudoObjectElement]
        ; ★ the CHECKER's isConstContext, as the reference's note says
        let first_property first.name.parent as ref[AstNode]
        let first_literal first_property.parent as ref[AstNode]
        let is_const checker.is_const_context(first_literal)
        let new_elements &Array[ref[AstNode]?]^host()
        ; members are serialized within an object type literal (TS2527 reports)
        let f0 this.save_flags()
        let i0 this.save_internal_flags()
        let d0 this.save_depth()
        this.add_flag(NbFlagsInObjectTypeLiteral)
        var i 0
        while i < n
        {
            let ep elements[i]
            set i: i + 1
            if ep = null
                continue
            let e ep as ref[PseudoObjectElement]
            var modifiers: ref[Array[ref[AstNode]?]]? null
            var readonly_modifier is_const
            if e.kind = PseudoObjectElementKindPropertyAssignment
            {
                if e.is_readonly
                    set readonly_modifier: true
            }
            if readonly_modifier
            {
                let list &Array[ref[AstNode]?]^host()
                list.add(factory.new_token(KindReadonlyKeyword))
                set modifiers: list
            }
            var scoped false
            if e.kind <> PseudoObjectElementKindPropertyAssignment
            {
                let sig_node e.signature as ref[AstNode]
                let signature checker.get_signature_from_declaration(sig_node)
                if signature <> null
                {
                    let sig signature as ref[Signature]
                    let expanded_params checker.get_expanded_parameters(sig)
                    this.enter_new_scope(sig_node, expanded_params, sig.type_parameters, sig.parameters, sig.mapper)
                    set scoped: true
                }
            }
            let name e.name
            var new_prop: ref[AstNode]? null
            if e.kind = PseudoObjectElementKindMethod
            {
                let type_params this.reuse_type_parameter_nodes(e.type_parameters)
                if is_const
                {
                    let prop_name this.reuse_name(name, false)
                    let params this.pseudo_parameters_to_node_list(e.parameters)
                    let return_type this.pseudo_type_to_node(e.return_type as ref[PseudoType])
                    let fn_type factory.new_function_type_node(type_params, params, return_type)
                    set new_prop: factory.new_property_signature_declaration(modifiers, prop_name, null, fn_type, null)
                }
                else
                {
                    let prop_name this.reuse_name(name, true)
                    let params this.pseudo_parameters_to_node_list(e.parameters)
                    let return_type this.pseudo_type_to_node(e.return_type as ref[PseudoType])
                    set new_prop: factory.new_method_signature_declaration(modifiers, prop_name, null, type_params, params, return_type)
                }
            }
            if e.kind = PseudoObjectElementKindPropertyAssignment
            {
                let prop_name this.reuse_name(name, false)
                let prop_type this.pseudo_type_to_node(e.pseudo_type as ref[PseudoType])
                set new_prop: factory.new_property_signature_declaration(modifiers, prop_name, null, prop_type, null)
            }
            if e.kind = PseudoObjectElementKindSetAccessor
            {
                let prop_name this.reuse_name(name, false)
                let params &Array[ref[AstNode]?]^host()
                params.add(this.pseudo_parameter_to_node(e.parameter as ref[PseudoParameter]))
                set new_prop: factory.new_set_accessor_declaration(null, prop_name, null, params, null, null, null)
            }
            if e.kind = PseudoObjectElementKindGetAccessor
            {
                let prop_name this.reuse_name(name, false)
                let getter_type this.pseudo_type_to_node(e.pseudo_type as ref[PseudoType])
                let no_params &Array[ref[AstNode]?]^host()
                set new_prop: factory.new_get_accessor_declaration(null, prop_name, null, no_params, getter_type, null, null)
            }
            if new_prop <> null
            {
                if c.enclosing_file = Checker.source_file_of_node(name)
                {
                    let original name.parent as ref[AstNode]
                    context.set_comment_range(new_prop as ref[AstNode], TextRange(original.pos, original.end))
                }
                new_elements.add(new_prop)
            }
            if scoped
                this.exit_scope()
        }
        this.restore_flags(f0, i0, d0)
        let result factory.new_type_literal_node(new_elements)
        if (c.flags & NbFlagsMultilineObjectLiterals) = 0
            context.add_emit_flags(result, EFSingleLine)
        result
    }

    procedure pseudo_parameters_to_node_list(mutable this, mutable params: ref[Array[ref[PseudoParameter]?]]?) returns ref[Array[ref[AstNode]?]]
    {
        let res &Array[ref[AstNode]?]^host()
        let n PseudoChecker.parameter_count(params)
        var i 0
        while i < n
        {
            let list params as ref[Array[ref[PseudoParameter]?]]
            let p list[i]
            if p <> null
                res.add(this.pseudo_parameter_to_node(p as ref[PseudoParameter]))
            set i: i + 1
        }
        res
    }

    procedure pseudo_parameter_to_node(mutable this, mutable p: ref[PseudoParameter]) returns ref[AstNode]?
    {
        var dot_dot_dot: ref[AstNode]? null
        var question_mark: ref[AstNode]? null
        if p.is_rest
            set dot_dot_dot: factory.new_token(KindDotDotDotToken)
        if p.is_optional
            set question_mark: factory.new_token(KindQuestionToken)
        let original p.name.parent as ref[AstNode]
        ; strada re-serializes a parameter's name from scratch
        if original.symbol = null
        {
            this.record_unported("node-builder-pseudo-parameter", original.kind)
            return null
        }
        let parameter_name this.parameter_to_parameter_declaration_name(original.symbol as ref[Symbol], original)
        let parameter_type this.pseudo_type_to_node(p.pseudo_type)
        let parameter factory.new_parameter_declaration(null, dot_dot_dot, parameter_name, question_mark, parameter_type, null)
        if original.kind = KindParameter
            this.set_comment_range(parameter, original)
        parameter
    }

    ; reuseName (nodecopy.go): the reused name, re-spelled as an identifier or a
    ; string literal where classifyPropertyName asks for another form
    procedure reuse_name(mutable this, mutable node: ref[AstNode], is_method: bool) returns ref[AstNode]?
    {
        let res this.reuse_node(node)
        if res = null
            return res
        let r res as ref[AstNode]
        let text AstNode.property_name_text_of(r)
        if text.data = null
            return res
        let string_named (r.kind = KindStringLiteral)
        let name_kind NodeBuilder.classify_property_name(text, string_named, is_method)
        if (r.kind = KindIdentifier) and (name_kind = 0)
            return res
        if string_named and (name_kind = 2)
            return res
        var renamed: ref[AstNode]? null
        if name_kind = 0
            set renamed: this.new_identifier(text)
        else
        {
            if name_kind <> 2
                return res
            set renamed: factory.new_string_literal(text, TokenFlagsNone)
        }
        context.set_original(renamed as ref[AstNode], r)
        this.set_text_range(renamed, r)
    }

    ; pseudoTypeEquivalentToType (typeNodeIsEquivalentToType in strada, applied
    ; more broadly)
    procedure pseudo_type_equivalent_to_type(mutable this, mutable t: ref[PseudoType], mutable type_in: ref[Type]?, is_optional_annotated: bool, report_errors: bool) returns bool
    {
        ; an error type is charitably equal (single-file checking)
        if type_in <> null
        {
            if checker.is_error_type(type_in as ref[Type])
                return true
        }
        let type_from_pseudo this.pseudo_type_to_type(t)
        if type_from_pseudo = type_in
            return true
        var undefined_stripped type_in
        if is_optional_annotated and (type_in <> null)
            set undefined_stripped: checker.get_type_with_facts(type_in as ref[Type], TypeFactsNEUndefined)
        if (type_from_pseudo <> null) and (type_in <> null)
        {
            let tp type_from_pseudo as ref[Type]
            let tt type_in as ref[Type]
            if is_optional_annotated
            {
                if undefined_stripped = type_from_pseudo
                    return true
                if undefined_stripped <> null
                {
                    let us undefined_stripped as ref[Type]
                    if ((tp.flags & TypeFlagsUnion) <> 0) and ((us.flags & TypeFlagsUnion) <> 0)
                    {
                        if checker.compare_types_identical(tp, us)
                            return true
                    }
                }
            }
            ; freshness mismatches (fresh true against regular true under as const)
            let regular_pseudo checker.get_regular_type_of_literal_type(tp)
            let regular_type checker.get_regular_type_of_literal_type(tt)
            if regular_pseudo = regular_type
                return true
            if ((tp.flags & TypeFlagsUnion) <> 0) and ((tt.flags & TypeFlagsUnion) <> 0)
            {
                if checker.compare_types_identical(tp, tt)
                    return true
            }
        }
        let k t.kind
        if k = PseudoTypeKindInferred
        {
            if PseudoChecker.error_node_count(t) > 0
            {
                if report_errors
                    this.report_error_nodes(t.error_nodes)
                return false
            }
            if report_errors
                this.report_inference_fallback(t.node)
            return false
        }
        if k = PseudoTypeKindObjectLiteral
        {
            if (type_in = null) or (undefined_stripped = null)
                return false
            return this.pseudo_object_literal_equivalent_to_type(t, undefined_stripped as ref[Type], report_errors)
        }
        if k = PseudoTypeKindTuple
        {
            if undefined_stripped = null
                return false
            let us undefined_stripped as ref[Type]
            if Checker.is_tuple_type(us) = false
                return false
            ; pseudo-tuples only ever have required elements
            let target Checker.target_of(us)
            if target = null
                return false
            if (Checker.tuple_combined_flags_of(target as ref[Type]) & ElementFlagsNonRequired) <> 0
                return false
            let element_types checker.get_type_arguments(us)
            var element_count 0
            if element_types <> null
                set element_count: (element_types as ref[Array[ref[Type]?]]).get_length() as int
            let n PseudoChecker.member_count(t)
            if n <> element_count
                return false
            var i 0
            while i < n
            {
                let members t.members as ref[Array[ref[PseudoType]?]]
                let elem members[i] as ref[PseudoType]
                let types element_types as ref[Array[ref[Type]?]]
                if this.pseudo_type_equivalent_to_type(elem, types[i], false, report_errors) = false
                    return false
                set i: i + 1
            }
            return true
        }
        if k = PseudoTypeKindSingleCallSignature
        {
            if undefined_stripped = null
                return false
            let target_sig checker.get_single_call_signature(undefined_stripped as ref[Type])
            if target_sig = null
                return false
            let ts target_sig as ref[Signature]
            let sig_node t.node as ref[AstNode]
            var target_type_parameter_count 0
            if ts.type_parameters <> null
                set target_type_parameter_count: (ts.type_parameters as ref[Array[ref[Type]?]]).get_length() as int
            if target_type_parameter_count <> AstNode.list_count(t.type_parameters)
            {
                if report_errors
                    this.report_inference_fallback(sig_node)
                return false
            }
            if this.pseudo_parameters_equivalent_to_parameters(t.parameters, ts, report_errors, sig_node) = false
                return false
            let target_predicate checker.get_type_predicate_of_signature(ts)
            if target_predicate <> null
            {
                if this.pseudo_return_type_matches_predicate(t.return_type as ref[PseudoType], target_predicate as ref[TypePredicate]) = false
                {
                    if report_errors
                        this.report_inference_fallback(sig_node)
                    return false
                }
                return true
            }
            ; an error is reported within the return type
            if this.pseudo_type_equivalent_to_type(t.return_type as ref[PseudoType], checker.get_return_type_of_signature(ts), false, report_errors) = false
                return false
            return true
        }
        if k = PseudoTypeKindNoResult
        {
            if report_errors
                this.report_inference_fallback(t.node)
            return false
        }
        false
    }

    ; the ObjectLiteral arm of pseudoTypeEquivalentToType
    procedure pseudo_object_literal_equivalent_to_type(mutable this, mutable t: ref[PseudoType], mutable undefined_stripped: ref[Type], report_errors: bool) returns bool
    {
        let target_props checker.get_properties_of_type(undefined_stripped)
        var target_prop_count 0
        if target_props <> null
            set target_prop_count: (target_props as ref[Array[ref[Symbol]?]]).get_length() as int
        ; a getter/setter pair is two elements and one symbol: count declarations
        var target_decl_count 0
        var j 0
        while j < target_prop_count
        {
            let props target_props as ref[Array[ref[Symbol]?]]
            let prop props[j]
            if prop <> null
                set target_decl_count: target_decl_count + Symbol.declaration_count(prop as ref[Symbol])
            set j: j + 1
        }
        let n PseudoChecker.element_count(t)
        if n <> target_decl_count
            return false
        var i 0
        while i < n
        {
            let elements t.elements as ref[Array[ref[PseudoObjectElement]?]]
            let e elements[i] as ref[PseudoObjectElement]
            set i: i + 1
            let name_parent e.name.parent as ref[AstNode]
            var target_prop: ref[Symbol]? null
            let elem_symbol name_parent.symbol
            if elem_symbol <> null
                set target_prop: checker.get_property_of_type(undefined_stripped, Symbol.name_of(elem_symbol as ref[Symbol]))
            if target_prop = null
            {
                ; search the target's properties for the same declaration name node
                var p 0
                while p < target_prop_count
                {
                    let props target_props as ref[Array[ref[Symbol]?]]
                    let prop props[p]
                    if prop <> null
                    {
                        let vd Symbol.value_declaration_of(prop as ref[Symbol])
                        if vd <> null
                        {
                            if AstNode.name_of(vd) = e.name
                            {
                                set target_prop: prop
                                break
                            }
                        }
                    }
                    set p: p + 1
                }
                if target_prop = null
                {
                    if report_errors
                        this.report_inference_fallback(name_parent)
                    return false
                }
            }
            let tprop target_prop as ref[Symbol]
            let target_is_optional ((Symbol.flags_of(tprop) & SymbolFlagsOptional) <> 0)
            if e.is_optional <> target_is_optional
            {
                if report_errors
                    this.report_inference_fallback(name_parent)
                return false
            }
            var prop_type checker.get_type_of_symbol(tprop)
            if prop_type <> null
                set prop_type: checker.remove_missing_type(prop_type as ref[Type], target_is_optional)
            if e.kind = PseudoObjectElementKindPropertyAssignment
            {
                let pt e.pseudo_type as ref[PseudoType]
                if this.pseudo_type_equivalent_to_type(pt, prop_type, e.is_optional, false) = false
                {
                    if report_errors
                    {
                        var fine_grained false
                        if pt.kind = PseudoTypeKindInferred
                        {
                            if PseudoChecker.error_node_count(pt) > 0
                                set fine_grained: true
                        }
                        ; re-report the fine-grained nodes (the recursion did not)
                        if fine_grained
                            this.report_error_nodes(pt.error_nodes)
                        else
                        {
                            if NodeBuilder.is_structural_pseudo_type(pt) = false
                                this.report_inference_fallback(name_parent)
                        }
                    }
                    return false
                }
            }
            if e.kind = PseudoObjectElementKindMethod
            {
                var target_sig: ref[Signature]? null
                if prop_type <> null
                    set target_sig: checker.get_single_call_signature(prop_type as ref[Type])
                ; no single call signature: cannot validate
                if target_sig <> null
                {
                    let ts target_sig as ref[Signature]
                    if this.pseudo_parameters_equivalent_to_parameters(e.parameters, ts, report_errors, name_parent) = false
                        return false
                    let target_predicate checker.get_type_predicate_of_signature(ts)
                    if target_predicate <> null
                    {
                        if this.pseudo_return_type_matches_predicate(e.return_type as ref[PseudoType], target_predicate as ref[TypePredicate]) = false
                        {
                            if report_errors
                                this.report_inference_fallback(name_parent)
                            return false
                        }
                    }
                    else
                    {
                        if this.pseudo_type_equivalent_to_type(e.return_type as ref[PseudoType], checker.get_return_type_of_signature(ts), false, false) = false
                        {
                            if report_errors
                                this.report_inference_fallback(name_parent)
                            return false
                        }
                    }
                }
            }
            if e.kind = PseudoObjectElementKindGetAccessor
            {
                if this.pseudo_type_equivalent_to_type(e.pseudo_type as ref[PseudoType], prop_type, false, false) = false
                {
                    if report_errors
                        this.report_inference_fallback(name_parent)
                    return false
                }
            }
            if e.kind = PseudoObjectElementKindSetAccessor
            {
                let write_type checker.get_write_type_of_symbol(tprop)
                let parameter e.parameter as ref[PseudoParameter]
                if this.pseudo_type_equivalent_to_type(parameter.pseudo_type, write_type, false, false) = false
                {
                    if report_errors
                        this.report_inference_fallback(name_parent)
                    return false
                }
            }
        }
        true
    }

    ; pseudoParametersEquivalentToParameters
    procedure pseudo_parameters_equivalent_to_parameters(mutable this, mutable params: ref[Array[ref[PseudoParameter]?]]?, mutable target_sig: ref[Signature], report_errors: bool, mutable non_param_error_location: ref[AstNode]) returns bool
    {
        let n_params PseudoChecker.parameter_count(params)
        var offset 0
        if target_sig.this_parameter <> null
        {
            if n_params = 0
            {
                ; a missing `this` parameter
                if report_errors
                    this.report_inference_fallback(non_param_error_location)
                return false
            }
            let list params as ref[Array[ref[PseudoParameter]?]]
            let p0 list[0] as ref[PseudoParameter]
            if AstNode.is_this_identifier(p0.name) = false
            {
                if report_errors
                    this.report_inference_fallback(non_param_error_location)
                return false
            }
            let param_type checker.get_type_of_parameter(target_sig.this_parameter as ref[Symbol])
            if this.pseudo_type_equivalent_to_type(p0.pseudo_type, param_type, p0.is_optional, false) = false
            {
                if report_errors
                    this.report_inference_fallback(p0.name.parent)
                return false
            }
            set offset: 1
        }
        var target_count 0
        if target_sig.parameters <> null
            set target_count: (target_sig.parameters as ref[Array[ref[Symbol]?]]).get_length() as int
        if target_count <> (n_params - offset)
        {
            if report_errors
                this.report_inference_fallback(non_param_error_location)
            return false
        }
        var i 0
        while i < target_count
        {
            let list params as ref[Array[ref[PseudoParameter]?]]
            let p list[i + offset] as ref[PseudoParameter]
            let targets target_sig.parameters as ref[Array[ref[Symbol]?]]
            let target_param targets[i] as ref[Symbol]
            set i: i + 1
            var target_optional false
            let vd Symbol.value_declaration_of(target_param)
            if vd <> null
                set target_optional: checker.is_optional_parameter(vd as ref[AstNode])
            if p.is_optional <> target_optional
            {
                if report_errors
                    this.report_inference_fallback(p.name.parent)
                return false
            }
            let param_type checker.get_type_of_parameter(target_param)
            if this.pseudo_type_equivalent_to_type(p.pseudo_type, param_type, p.is_optional, false) = false
            {
                if report_errors
                    this.report_inference_fallback(p.name.parent)
                return false
            }
        }
        true
    }

    function is_structural_pseudo_type(t: ref[PseudoType]) returns bool
    {
        let k t.kind
        if (k = PseudoTypeKindObjectLiteral) or (k = PseudoTypeKindTuple) or (k = PseudoTypeKindSingleCallSignature)
            return true
        if k = PseudoTypeKindMaybeConstLocation
        {
            if t.const_type <> null
            {
                if NodeBuilder.is_structural_pseudo_type(t.const_type as ref[PseudoType])
                    return true
            }
            if t.regular_type <> null
                return NodeBuilder.is_structural_pseudo_type(t.regular_type as ref[PseudoType])
        }
        false
    }

    ; pseudoReturnTypeMatchesPredicate: a Direct type predicate node against
    ; the checker's predicate
    procedure pseudo_return_type_matches_predicate(mutable this, mutable rt: ref[PseudoType], mutable predicate: ref[TypePredicate]) returns bool
    {
        if rt.kind <> PseudoTypeKindDirect
            return false
        let node rt.node as ref[AstNode]
        if node.kind <> KindTypePredicate
            return false
        let is_asserts (AstNode.type_predicate_asserts_modifier_of(node) <> null)
        let predicate_is_asserts ((predicate.kind = TypePredicateKindAssertsThis) or (predicate.kind = TypePredicateKindAssertsIdentifier))
        if is_asserts <> predicate_is_asserts
            return false
        let param_name AstNode.type_predicate_parameter_name_of(node)
        if param_name = null
            return false
        let pn param_name as ref[AstNode]
        let is_this (pn.kind = KindThisType)
        let predicate_is_this ((predicate.kind = TypePredicateKindThis) or (predicate.kind = TypePredicateKindAssertsThis))
        if is_this <> predicate_is_this
            return false
        if is_this = false
        {
            if SymbolTable.names_equal(AstNode.identifier_text_of(pn), predicate.parameter_name) = false
                return false
        }
        let type_node AstNode.type_of(node)
        if predicate.t <> null
        {
            if type_node = null
                return false
            let from_node checker.get_type_from_type_node(type_node as ref[AstNode])
            if from_node <> predicate.t
            {
                if from_node = null
                    return false
                if checker.compare_types_identical(from_node as ref[Type], predicate.t as ref[Type]) = false
                    return false
            }
            return true
        }
        type_node = null
    }

    ; pseudoTypeToType: only the literal-ish kinds map (the structural ones are
    ; validated separately)
    procedure pseudo_type_to_type(mutable this, mutable t: ref[PseudoType]) returns ref[Type]?
    {
        let k t.kind
        if k = PseudoTypeKindDirect
            return checker.get_type_from_type_node(t.node as ref[AstNode])
        if k = PseudoTypeKindInferred
        {
            let node t.node as ref[AstNode]
            if t.is_signature_return
            {
                let signature checker.get_signature_from_declaration(node)
                if signature = null
                    return null
                return checker.get_return_type_of_signature(signature as ref[Signature])
            }
            let regular checker.get_regular_type_of_expression(node)
            if regular = null
                return null
            return checker.get_widened_type(regular as ref[Type])
        }
        if k = PseudoTypeKindNoResult
            return null
        if k = PseudoTypeKindMaybeConstLocation
        {
            if checker.is_const_context(t.node as ref[AstNode])
                return this.pseudo_type_to_type(t.const_type as ref[PseudoType])
            return this.pseudo_type_to_type(t.regular_type as ref[PseudoType])
        }
        if k = PseudoTypeKindUnion
        {
            let res &Array[ref[Type]?]^host()
            var has_elided_type false
            let n PseudoChecker.member_count(t)
            var i 0
            while i < n
            {
                let members t.members as ref[Array[ref[PseudoType]?]]
                let m members[i] as ref[PseudoType]
                set i: i + 1
                if Checker.strict_null_checks() = false
                {
                    if (m.kind = PseudoTypeKindUndefined) or (m.kind = PseudoTypeKindNull)
                    {
                        set has_elided_type: true
                        continue
                    }
                }
                let mt this.pseudo_type_to_type(m)
                ; propagate failure
                if mt = null
                    return null
                res.add(mt)
            }
            let count res.get_length() as int
            if count = 1
                return res[0]
            if count = 0
            {
                if has_elided_type
                    return checker.any_type
                return checker.never_type
            }
            return checker.get_union_type(res)
        }
        if k = PseudoTypeKindUndefined
            return checker.undefined_widening_type
        if k = PseudoTypeKindNull
            return checker.null_widening_type
        if k = PseudoTypeKindAny
            return checker.any_type
        if k = PseudoTypeKindString
            return checker.string_type
        if k = PseudoTypeKindNumber
            return checker.number_type
        if k = PseudoTypeKindBigInt
            return checker.bigint_type
        if k = PseudoTypeKindBoolean
            return checker.boolean_type
        if k = PseudoTypeKindFalse
            return checker.false_type
        if k = PseudoTypeKindTrue
            return checker.true_type
        if (k = PseudoTypeKindStringLiteral) or (k = PseudoTypeKindNumericLiteral) or (k = PseudoTypeKindBigIntLiteral)
            return checker.get_regular_type_of_expression(t.node as ref[AstNode])
        ; ObjectLiteral, SingleCallSignature, Tuple: structural, no simple mapping
        null
    }

    ; serializeReturnTypeForSignature
    procedure serialize_return_type_for_signature(mutable this, mutable signature: ref[Signature], try_reuse: bool) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let suppress_any ((c.flags & NbFlagsSuppressAnyReturnType) <> 0)
        let f0 this.save_flags()
        let i0 this.save_internal_flags()
        let d0 this.save_depth()
        if suppress_any
            this.clear_flag(NbFlagsSuppressAnyReturnType)
        var return_type_node: ref[AstNode]? null
        var return_type: ref[Type]? null
        var declared_locally false
        if signature.declaration <> null
        {
            if Printer.node_is_synthesized(signature.declaration as ref[AstNode]) = false
                set declared_locally: true
        }
        if declared_locally
        {
            let symbol checker.get_symbol_of_declaration(signature.declaration)
            if symbol <> null
                set return_type: this.enclosing_symbol_type_of(symbol as ref[Symbol])
            if return_type = null
                set return_type: checker.instantiate_type(checker.get_return_type_of_signature(signature), c.mapper)
        }
        else
            set return_type: checker.get_return_type_of_signature(signature)
        var is_any false
        if return_type <> null
        {
            if ((return_type as ref[Type]).flags & TypeFlagsAny) <> 0
                set is_any: true
        }
        if (suppress_any and is_any) = false
        {
            if (this.is_actively_expanding() = false) and try_reuse and (c.enclosing_declaration <> null) and declared_locally
            {
                let decl signature.declaration as ref[AstNode]
                let declaration_symbol checker.get_symbol_of_declaration(decl)
                var mark 0 - 1
                if declaration_symbol <> null
                    set mark: this.add_symbol_type_to_context(declaration_symbol as ref[Symbol], return_type)
                var pt: ref[PseudoType]? pc.get_return_type_of_signature(decl)
                let report_errors (c.suppress_report_inference_fallback = false)
                if this.pseudo_type_equivalent_to_type(pt as ref[PseudoType], return_type, false, report_errors)
                {
                    ; the pseudo type must capture an inferred type predicate too,
                    ; not only the boolean return type
                    let type_predicate checker.get_type_predicate_of_signature(signature)
                    if type_predicate <> null
                    {
                        if this.pseudo_return_type_matches_predicate(pt as ref[PseudoType], type_predicate as ref[TypePredicate]) = false
                        {
                            if c.suppress_report_inference_fallback = false
                                this.report_inference_fallback(decl)
                            set pt: null
                        }
                    }
                    if pt <> null
                        set return_type_node: this.pseudo_type_to_node_with_checker_fallback(pt as ref[PseudoType], return_type)
                }
                if mark >= 0
                    this.remove_symbol_type_from_context(mark)
            }
            if return_type_node = null
                set return_type_node: this.serialize_inferred_return_type_for_signature(signature, return_type)
        }
        if (return_type_node = null) and (suppress_any = false)
            set return_type_node: factory.new_keyword_type_node(KindAnyKeyword)
        this.restore_flags(f0, i0, d0)
        return_type_node
    }

    ; serializeTypeForDeclaration
    procedure serialize_type_for_declaration(mutable this, mutable declaration_in: ref[AstNode]?, mutable t_in: ref[Type]?, mutable symbol_in: ref[Symbol]?, try_reuse: bool) returns ref[AstNode]?
    {
        let c this.the_ctx()
        var declaration declaration_in
        var symbol symbol_in
        if declaration = null
        {
            if symbol <> null
            {
                set declaration: Symbol.value_declaration_of(symbol as ref[Symbol])
                if declaration = null
                    set declaration: NodeBuilder.first_declaration(symbol as ref[Symbol])
            }
        }
        if symbol = null
            set symbol: checker.get_symbol_of_declaration(declaration)
        var t t_in
        if t = null
        {
            if symbol <> null
            {
                let s symbol as ref[Symbol]
                set t: this.enclosing_symbol_type_of(s)
                if t = null
                {
                    var set_accessor false
                    if ((Symbol.flags_of(s) & SymbolFlagsAccessor) <> 0) and (declaration <> null)
                    {
                        if (declaration as ref[AstNode]).kind = KindSetAccessor
                            set set_accessor: true
                    }
                    if set_accessor
                        set t: checker.instantiate_type(checker.get_write_type_of_symbol(s), c.mapper)
                    else
                    {
                        if (Symbol.flags_of(s) & (SymbolFlagsTypeLiteral | SymbolFlagsSignature)) = 0
                        {
                            let of_symbol checker.get_type_of_symbol(s)
                            if of_symbol <> null
                                set t: checker.instantiate_type(checker.get_widened_literal_type(of_symbol as ref[Type]), c.mapper)
                        }
                    }
                }
            }
            if t = null
                set t: checker.error_type
        }
        let tt t as ref[Type]
        var requires_adding_undefined false
        var typed_declaration_kind false
        var is_parameter false
        if declaration <> null
        {
            let dk (declaration as ref[AstNode]).kind
            if dk = KindParameter
                set is_parameter: true
            if (dk = KindParameter) or (dk = KindPropertySignature) or (dk = KindPropertyDeclaration)
                set typed_declaration_kind: true
        }
        if typed_declaration_kind
            set requires_adding_undefined: checker.requires_adding_implicit_undefined_ex(declaration as ref[AstNode], c.enclosing_declaration)
        var type_for_node tt
        if requires_adding_undefined and is_parameter
        {
            let optional checker.get_optional_type(tt, false)
            if optional <> null
                set type_for_node: optional as ref[Type]
        }
        let f0 this.save_flags()
        let i0 this.save_internal_flags()
        let d0 this.save_depth()
        if ((type_for_node.flags & TypeFlagsUniqueESSymbol) <> 0) and (type_for_node.symbol = symbol) and (symbol <> null)
        {
            var allow (c.enclosing_declaration = null)
            if allow = false
            {
                let s symbol as ref[Symbol]
                let n Symbol.declaration_count(s)
                var i 0
                while i < n
                {
                    let d Symbol.declaration_at(s, i)
                    if d <> null
                    {
                        if Checker.source_file_of_node(d) = c.enclosing_file
                            set allow: true
                    }
                    set i: i + 1
                }
            }
            if allow
                this.add_flag(NbFlagsAllowUniqueESSymbolType)
        }
        var result: ref[AstNode]? null
        var reported_inference_fallback false
        var reusable false
        if (this.is_actively_expanding() = false) and try_reuse and (c.enclosing_declaration <> null) and (declaration <> null)
        {
            let decl declaration as ref[AstNode]
            if NodeBuilder.is_accessor_kind(decl.kind)
                set reusable: true
            else
            {
                if NodeBuilder.has_inferred_type(decl.kind) and (Printer.node_is_synthesized(decl) = false) and ((type_for_node.object_flags & ObjectFlagsRequiresWidening) = 0)
                    set reusable: true
            }
        }
        if reusable and (symbol <> null)
        {
            let decl declaration as ref[AstNode]
            let s symbol as ref[Symbol]
            let mark this.add_symbol_type_to_context(s, type_for_node)
            var pt: ref[PseudoType]? null
            if NodeBuilder.is_accessor_kind(decl.kind)
                set pt: pc.get_type_of_accessor(decl)
            else
                set pt: pc.get_type_of_declaration(decl)
            var no_result (pt = null)
            if pt <> null
            {
                if (pt as ref[PseudoType]).kind = PseudoTypeKindNoResult
                    set no_result: true
            }
            if no_result and (decl.kind = KindBinaryExpression)
            {
                ; binary expressions: the first annotated declaration supplies the
                ; type for the rest
                let n Symbol.declaration_count(s)
                var i 0
                while i < n
                {
                    let d Symbol.declaration_at(s, i)
                    if d <> null
                    {
                        if AstNode.type_of(d) <> null
                        {
                            set pt: pc.get_type_of_declaration(d as ref[AstNode])
                            break
                        }
                    }
                    set i: i + 1
                }
            }
            if pt = null
                this.record_unported("node-builder-pseudo-declaration-kind", decl.kind)
            else
            {
                let p pt as ref[PseudoType]
                let report_errors (c.suppress_report_inference_fallback = false)
                var is_optional_annotated false
                if (requires_adding_undefined = false) and typed_declaration_kind
                    set is_optional_annotated: Checker.is_optional_declaration(decl)
                if this.pseudo_type_equivalent_to_type(p, type_for_node, is_optional_annotated, report_errors)
                {
                    var chosen: ref[PseudoType]? p
                    if requires_adding_undefined
                    {
                        let ptt this.pseudo_type_to_type(p)
                        if ptt <> null
                        {
                            if this.contains_non_missing_undefined_type(type_for_node)
                            {
                                if this.contains_non_missing_undefined_type(ptt as ref[Type]) = false
                                    set chosen: pc.new_union_with_undefined(p)
                            }
                        }
                    }
                    set result: this.pseudo_type_to_node_with_checker_fallback(chosen as ref[PseudoType], type_for_node)
                }
                else
                {
                    ; suppress nested reports in the fallback serialization when
                    ; the inferred-with-errors nodes were reported
                    if report_errors and (p.kind = PseudoTypeKindInferred)
                    {
                        if PseudoChecker.error_node_count(p) > 0
                            set reported_inference_fallback: true
                    }
                    var should_add_undefined false
                    if requires_adding_undefined
                    {
                        let ptt this.pseudo_type_to_type(p)
                        if ptt <> null
                            set should_add_undefined: (this.contains_non_missing_undefined_type(ptt as ref[Type]) = false)
                        else
                            set should_add_undefined: (PseudoChecker.could_already_refer_to_undefined_type(p) = false)
                    }
                    if should_add_undefined
                    {
                        let with_undefined pc.new_union_with_undefined(p)
                        if this.pseudo_type_equivalent_to_type(with_undefined, type_for_node, false, report_errors)
                        {
                            set result: this.pseudo_type_to_node_with_checker_fallback(with_undefined, type_for_node)
                            set reported_inference_fallback: false
                        }
                    }
                }
            }
            this.remove_symbol_type_from_context(mark)
        }
        if result = null
        {
            if reported_inference_fallback
            {
                let old_suppress c.suppress_report_inference_fallback
                set c.suppress_report_inference_fallback: true
                set result: this.type_to_type_node(type_for_node)
                set c.suppress_report_inference_fallback: old_suppress
            }
            else
                set result: this.type_to_type_node(type_for_node)
        }
        this.restore_flags(f0, i0, d0)
        if result = null
            return factory.new_keyword_type_node(KindAnyKeyword)
        result
    }

    ; tryGetThisParameterDeclaration (the JSDoc @this tag is not written)
    procedure try_get_this_parameter_declaration(mutable this, mutable signature: ref[Signature]) returns ref[AstNode]?
    {
        if signature.this_parameter <> null
            return this.symbol_to_parameter_declaration(signature.this_parameter as ref[Symbol], false)
        null
    }

    ; signatureToSignatureDeclarationHelper
    procedure signature_to_signature_declaration_helper(mutable this, mutable signature: ref[Signature], kind: int, modifiers_in: ref[Array[ref[AstNode]?]]?, name_in: ref[AstNode]?, question_token: ref[AstNode]?) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let expanded_params this.enter_signature_scope(signature)
        this.add_approximate_length(3)
        let type_parameters &Array[ref[AstNode]?]^host()
        var wrote_arguments false
        if ((c.flags & NbFlagsWriteTypeArgumentsOfSignature) <> 0) and (signature.target <> null) and (signature.mapper <> null)
        {
            let target signature.target as ref[Signature]
            if target.type_parameters <> null
            {
                let tps target.type_parameters as ref[Array[ref[Type]?]]
                if (tps.get_length() as int) <> 0
                {
                    set wrote_arguments: true
                    var i 0
                    while i < (tps.get_length() as int)
                    {
                        type_parameters.add(this.type_to_type_node(checker.instantiate_type(tps[i], signature.mapper)))
                        set i: i + 1
                    }
                }
            }
        }
        if (wrote_arguments = false) and (signature.type_parameters <> null)
        {
            let tps signature.type_parameters as ref[Array[ref[Type]?]]
            var i 0
            while i < (tps.get_length() as int)
            {
                let p tps[i]
                if p <> null
                    type_parameters.add(this.type_parameter_to_declaration(p as ref[Type]))
                set i: i + 1
            }
        }
        let f0 this.save_flags()
        let i0 this.save_internal_flags()
        let d0 this.save_depth()
        this.clear_flag(NbFlagsSuppressAnyReturnType)
        ; a variadic in a non-trailing position keeps the unexpanded list
        var source expanded_params
        let en expanded_params.get_length() as int
        var i 0
        while i < en
        {
            let p expanded_params[i]
            if (p <> null) and (i <> (en - 1))
            {
                if (Symbol.check_flags_of(p as ref[Symbol]) & CheckFlagsRestParameter) <> 0
                {
                    if signature.parameters <> null
                        set source: signature.parameters as ref[Array[ref[Symbol]?]]
                    set i: en
                }
            }
            set i: i + 1
        }
        let parameters &Array[ref[AstNode]?]^host()
        if (c.flags & NbFlagsOmitThisParameter) = 0
        {
            let this_parameter this.try_get_this_parameter_declaration(signature)
            if this_parameter <> null
                parameters.add(this_parameter)
        }
        set i: 0
        while i < (source.get_length() as int)
        {
            let p source[i]
            if p <> null
                parameters.add(this.symbol_to_parameter_declaration(p as ref[Symbol], kind = KindConstructor))
            set i: i + 1
        }
        this.restore_flags(f0, i0, d0)
        var return_type_node this.serialize_return_type_for_signature(signature, true)
        var modifiers modifiers_in
        if (kind = KindConstructorType) and ((signature.flags & SignatureFlagsAbstract) <> 0)
            set modifiers: this.modifiers_from_flags(NodeBuilder.modifiers_to_flags(modifiers) | ModifierFlagsAbstract)
        var type_param_list: ref[Array[ref[AstNode]?]]? null
        if (type_parameters.get_length() as int) <> 0
            set type_param_list: type_parameters
        var modifier_list: ref[Array[ref[AstNode]?]]? null
        if modifiers <> null
        {
            if AstNode.list_count(modifiers) > 0
                set modifier_list: modifiers
        }
        var name name_in
        if name = null
            set name: factory.new_identifier("")
        var node: ref[AstNode]? null
        if kind = KindCallSignature
            set node: factory.new_call_signature_declaration(type_param_list, parameters, return_type_node)
        if kind = KindConstructSignature
            set node: factory.new_construct_signature_declaration(type_param_list, parameters, return_type_node)
        if kind = KindMethodSignature
            set node: factory.new_method_signature_declaration(modifier_list, name, question_token, type_param_list, parameters, return_type_node)
        if kind = KindMethodDeclaration
            set node: factory.new_method_declaration(modifier_list, null, name, null, type_param_list, parameters, return_type_node, null, null)
        if kind = KindConstructor
            set node: factory.new_constructor_declaration(modifier_list, null, parameters, null, null, null)
        if kind = KindGetAccessor
            set node: factory.new_get_accessor_declaration(modifier_list, name, null, parameters, return_type_node, null, null)
        if kind = KindSetAccessor
            set node: factory.new_set_accessor_declaration(modifier_list, name, null, parameters, null, null, null)
        if kind = KindIndexSignature
            set node: factory.new_index_signature_declaration(modifier_list, parameters, return_type_node)
        if kind = KindFunctionType
        {
            if return_type_node = null
                set return_type_node: factory.new_type_reference_node(factory.new_identifier(""), null)
            set node: factory.new_function_type_node(type_param_list, parameters, return_type_node)
        }
        if kind = KindConstructorType
        {
            if return_type_node = null
                set return_type_node: factory.new_type_reference_node(factory.new_identifier(""), null)
            set node: factory.new_constructor_type_node(modifier_list, type_param_list, parameters, return_type_node)
        }
        if kind = KindFunctionDeclaration
            set node: factory.new_function_declaration(modifier_list, null, name, type_param_list, parameters, return_type_node, null, null)
        if kind = KindFunctionExpression
        {
            let empty &Array[ref[AstNode]?]^host()
            set node: factory.new_function_expression(modifier_list, null, name, type_param_list, parameters, return_type_node, null, factory.new_block(empty, false))
        }
        if kind = KindArrowFunction
        {
            let empty &Array[ref[AstNode]?]^host()
            set node: factory.new_arrow_function(modifier_list, type_param_list, parameters, return_type_node, null, null, factory.new_block(empty, false))
        }
        if node = null
            this.record_unported("node-builder-signature-kind", kind)
        this.exit_scope()
        node
    }

    ; ── nodebuilderscopes.go: the fake scopes of a signature ─────────────────

    function fake_scope_kind_of(this, node: ref[AstNode]?) returns int
    {
        if node = null
            return 0
        var i 0
        while i < (fake_scopes.get_length() as int)
        {
            let fs fake_scopes[i]
            if fs.node = node
                return fs.kind
            set i: i + 1
        }
        0
    }

    ; enterSignatureScope: the expanded parameters, and the scope they live in
    procedure enter_signature_scope(mutable this, mutable signature: ref[Signature]) returns ref[Array[ref[Symbol]?]]
    {
        var expanded checker.get_expanded_parameters(signature)
        if expanded = null
            set expanded: &Array[ref[Symbol]?]^host()
        let params expanded as ref[Array[ref[Symbol]?]]
        this.enter_new_scope(signature.declaration, params, signature.type_parameters, signature.parameters, signature.mapper)
        params
    }

    ; enterNewScope: the names of a signature's parameters (and, under
    ; GenerateNamesForShadowedTypeParams, its type parameters) are made visible
    ; through a FAKE SCOPE — a synthesized Block with locals, parented on the
    ; enclosing declaration — which isSymbolAccessible walks like any other
    procedure enter_new_scope(mutable this, declaration: ref[AstNode]?, mutable expanded_params: ref[Array[ref[Symbol]?]]?, mutable type_parameters: ref[Array[ref[Type]?]]?, original_parameters: ref[Array[ref[Symbol]?]]?, mapper: ref[TypeMapper]?)
    {
        let c this.the_ctx()
        this.enter_name_scope()
        let frame &NbScopeFrame^host(c.enclosing_declaration, c.mapper, null, null, null, null, null, null)
        if mapper <> null
            set c.mapper: mapper
        if (c.enclosing_declaration <> null) and (declaration <> null)
        {
            var any_param false
            if expanded_params <> null
            {
                let ps expanded_params as ref[Array[ref[Symbol]?]]
                var i 0
                while i < (ps.get_length() as int)
                {
                    if ps[i] <> null
                        set any_param: true
                    set i: i + 1
                }
            }
            if any_param
                this.push_fake_scope(NbFakeScopeParams, frame, expanded_params as ref[Array[ref[Symbol]?]], original_parameters, null)
            var any_type_param false
            if ((c.flags & NbFlagsGenerateNamesForShadowedTypeParams) <> 0) and (type_parameters <> null)
            {
                let tps type_parameters as ref[Array[ref[Type]?]]
                var i 0
                while i < (tps.get_length() as int)
                {
                    if tps[i] <> null
                        set any_type_param: true
                    set i: i + 1
                }
            }
            if any_type_param
                this.push_fake_scope(NbFakeScopeTypeParams, frame, null, null, type_parameters)
        }
        scopes.add(frame)
    }

    ; pushFakeScope: an existing fake scope of the kind (the enclosing
    ; declaration or its parent) takes the names and records the undo; a fresh
    ; Block becomes the enclosing declaration
    procedure push_fake_scope(mutable this, kind: int, mutable frame: ref[NbScopeFrame], mutable expanded_params: ref[Array[ref[Symbol]?]]?, original_parameters: ref[Array[ref[Symbol]?]]?, mutable type_parameters: ref[Array[ref[Type]?]]?)
    {
        let c this.the_ctx()
        let enclosing c.enclosing_declaration as ref[AstNode]
        var existing: ref[AstNode]? null
        if this.fake_scope_kind_of(enclosing) = kind
            set existing: enclosing
        if (existing = null) and (enclosing.parent <> null)
        {
            if this.fake_scope_kind_of(enclosing.parent) = kind
                set existing: enclosing.parent
        }
        var locals: ref[SymbolTable]? null
        if existing <> null
            set locals: AstNode.locals_of(existing)
        if locals = null
            set locals: SymbolTable.create(host)
        let table locals as ref[SymbolTable]
        let new_names &Array[Slice[char]]^host()
        let undo &Array[NbLocalsUndo]^host()
        if kind = NbFakeScopeParams
        {
            let ps expanded_params as ref[Array[ref[Symbol]?]]
            var i 0
            while i < (ps.get_length() as int)
            {
                let po ps[i]
                if po <> null
                {
                    let param po as ref[Symbol]
                    var original_param: ref[Symbol]? null
                    if original_parameters <> null
                    {
                        let ops original_parameters as ref[Array[ref[Symbol]?]]
                        if i < (ops.get_length() as int)
                            set original_param: ops[i]
                    }
                    var differs false
                    if original_parameters <> null
                    {
                        if original_param <> param
                            set differs: true
                    }
                    if differs
                    {
                        if original_param <> null
                            this.add_fake_local(table, existing, new_names, undo, Symbol.name_of(original_param as ref[Symbol]), original_param)
                    }
                    else
                    {
                        if this.add_binding_pattern_locals(table, existing, new_names, undo, param) = false
                            this.add_fake_local(table, existing, new_names, undo, Symbol.name_of(param), param)
                    }
                }
                set i: i + 1
            }
        }
        else
        {
            let tps type_parameters as ref[Array[ref[Type]?]]
            var i 0
            while i < (tps.get_length() as int)
            {
                let tpo tps[i]
                if tpo <> null
                {
                    let tp tpo as ref[Type]
                    let name this.type_parameter_to_name(tp)
                    this.add_fake_local(table, existing, new_names, undo, AstNode.identifier_text_of(name), tp.symbol)
                }
                set i: i + 1
            }
        }
        if existing = null
        {
            let empty &Array[ref[AstNode]?]^host()
            let fake_scope factory.new_block(empty, false)
            fake_scopes.add(NbFakeScope(fake_scope, kind))
            AstNode.set_locals(fake_scope, table)
            set fake_scope.parent: enclosing
            this.set_enclosing(fake_scope)
            return
        }
        if kind = NbFakeScopeParams
        {
            set frame.params_locals: table
            set frame.params_new_names: new_names
            set frame.params_undo: undo
        }
        else
        {
            set frame.type_params_locals: table
            set frame.type_params_new_names: new_names
            set frame.type_params_undo: undo
        }
    }

    procedure add_fake_local(this, mutable table: ref[SymbolTable], existing: ref[AstNode]?, mutable new_names: ref[Array[Slice[char]]], mutable undo: ref[Array[NbLocalsUndo]], name: Slice[char], symbol: ref[Symbol]?)
    {
        if existing <> null
        {
            let old SymbolTable.get(table, name)
            if old = null
                new_names.add(name)
            else
                undo.add(NbLocalsUndo(name, old))
        }
        SymbolTable.set_entry(host, table, name, symbol)
    }

    ; a parameter declared with a binding pattern contributes the pattern's
    ; element names instead of its own; answers whether it did
    procedure add_binding_pattern_locals(mutable this, mutable table: ref[SymbolTable], existing: ref[AstNode]?, mutable new_names: ref[Array[Slice[char]]], mutable undo: ref[Array[NbLocalsUndo]], mutable param: ref[Symbol]) returns bool
    {
        let n Symbol.declaration_count(param)
        var i 0
        while i < n
        {
            let d Symbol.declaration_at(param, i)
            if d <> null
            {
                let decl d as ref[AstNode]
                if decl.kind = KindParameter
                {
                    let name AstNode.name_of(decl)
                    if name <> null
                    {
                        if AstNode.is_binding_pattern(name)
                        {
                            this.add_pattern_locals(table, existing, new_names, undo, name as ref[AstNode])
                            return true
                        }
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    procedure add_pattern_locals(mutable this, mutable table: ref[SymbolTable], existing: ref[AstNode]?, mutable new_names: ref[Array[Slice[char]]], mutable undo: ref[Array[NbLocalsUndo]], mutable pattern: ref[AstNode])
    {
        let elements AstNode.elements_of(pattern)
        let n AstNode.list_count(elements)
        var i 0
        while i < n
        {
            let e AstNode.child_in_list(elements, i)
            if e <> null
            {
                let el e as ref[AstNode]
                if el.kind = KindOmittedExpression
                    return
                if el.kind = KindBindingElement
                {
                    let name AstNode.name_of(el)
                    if name <> null
                    {
                        if AstNode.is_binding_pattern(name)
                            this.add_pattern_locals(table, existing, new_names, undo, name as ref[AstNode])
                        else
                        {
                            let symbol checker.get_symbol_of_declaration(el)
                            if symbol <> null
                                this.add_fake_local(table, existing, new_names, undo, Symbol.name_of(symbol as ref[Symbol]), symbol)
                        }
                    }
                    else
                    {
                        let symbol checker.get_symbol_of_declaration(el)
                        if symbol <> null
                            this.add_fake_local(table, existing, new_names, undo, Symbol.name_of(symbol as ref[Symbol]), symbol)
                    }
                }
            }
            set i: i + 1
        }
    }

    ; the cleanup enterNewScope answers
    procedure exit_scope(mutable this)
    {
        let n scopes.get_length() as int
        if n = 0
            return
        let frame scopes[n - 1] as ref[NbScopeFrame]
        set this.scopes: NodeBuilder.frames_prefix(host, scopes, n - 1)
        this.undo_fake_locals(frame.params_locals, frame.params_new_names, frame.params_undo)
        this.undo_fake_locals(frame.type_params_locals, frame.type_params_new_names, frame.type_params_undo)
        this.exit_name_scope()
        let c this.the_ctx()
        this.set_enclosing(frame.old_enclosing)
        set c.mapper: frame.old_mapper
    }

    procedure undo_fake_locals(this, mutable locals: ref[SymbolTable]?, new_names: ref[Array[Slice[char]]]?, undo: ref[Array[NbLocalsUndo]]?)
    {
        if locals = null
            return
        let table locals as ref[SymbolTable]
        if new_names <> null
        {
            let names new_names as ref[Array[Slice[char]]]
            var i 0
            while i < (names.get_length() as int)
            {
                SymbolTable.set_entry(host, table, names[i], null)
                set i: i + 1
            }
        }
        if undo <> null
        {
            let rows undo as ref[Array[NbLocalsUndo]]
            var i 0
            while i < (rows.get_length() as int)
            {
                let row rows[i]
                SymbolTable.set_entry(host, table, row.name, row.old_symbol)
                set i: i + 1
            }
        }
    }

    function frames_prefix(host: ref[Page], list: ref[Array[ref[NbScopeFrame]?]], n: int) returns ref[Array[ref[NbScopeFrame]?]]
    {
        let out &Array[ref[NbScopeFrame]?]^host()
        var i 0
        while i < n
        {
            out.add(list[i])
            set i: i + 1
        }
        out
    }

    ; getEnclosingDeclarationIgnoringFakeScope
    function get_enclosing_declaration_ignoring_fake_scope(this) returns ref[AstNode]?
    {
        var enc (this.the_ctx()).enclosing_declaration
        while enc <> null
        {
            if this.fake_scope_kind_of(enc) = 0
                return enc
            set enc: (enc as ref[AstNode]).parent
        }
        null
    }

    ; ── nodecopy.go: reusing an existing type node ───────────────────────────

    procedure reuse_node(mutable this, mutable node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        this.try_reuse_existing_node_helper(node as ref[AstNode])
    }

    ; reuseTypeNode: the node, or (after an inference-fallback report) the
    ; checker's rendering of its type
    procedure reuse_type_node(mutable this, mutable node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        let n node as ref[AstNode]
        let r this.reuse_node(n)
        if r <> null
            return r
        this.report_inference_fallback(n)
        this.type_to_type_node(this.get_type_from_type_node(n, false))
    }

    ; tryReuseExistingNodeHelper: the visitor under a recovery boundary
    procedure try_reuse_existing_node_helper(mutable this, mutable existing: ref[AstNode]) returns ref[AstNode]?
    {
        this.create_recovery_boundary()
        let transformed (this.the_existing_visitor()).visit_node(existing)
        if this.finalize_boundary() = false
            return null
        this.add_approximate_length(existing.end - existing.pos)
        transformed
    }

    ; typeNodeIsEquivalentToType
    procedure type_node_is_equivalent_to_type(mutable this, annotated_declaration: ref[AstNode]?, mutable t: ref[Type], type_from_type_node: ref[Type]?) returns bool
    {
        if type_from_type_node = t
            return true
        if annotated_declaration = null
            return false
        if Checker.is_optional_declaration(annotated_declaration as ref[AstNode])
            return checker.get_type_with_facts(t, TypeFactsNEUndefined) = type_from_type_node
        false
    }

    procedure can_reuse_existing_js_type_node(mutable this, mutable existing: ref[AstNode], t: ref[Type]) returns bool
    {
        if checker.get_intended_type_from_jsdoc_type_reference(existing) <> null
            return false
        this.existing_type_node_is_not_reference_or_is_reference_with_compatible_type_argument_count(existing, t)
    }

    procedure existing_type_node_is_not_reference_or_is_reference_with_compatible_type_argument_count(mutable this, mutable existing: ref[AstNode], t: ref[Type]) returns bool
    {
        if (t.object_flags & ObjectFlagsReference) = 0
            return true
        if existing.kind <> KindTypeReference
            return true
        let symbol this.try_get_resolved_symbol_from_type_node(existing)
        if symbol = null
            return true
        let existing_target checker.get_declared_type_of_symbol(symbol as ref[Symbol])
        if existing_target = null
            return true
        let target Checker.target_of(t)
        if existing_target <> target
            return true
        var params: ref[Array[ref[Type]?]]? null
        if target <> null
            set params: checker.interface_type_parameters_of(target as ref[Type])
        if params = null
            return true
        AstNode.list_count(AstNode.type_reference_arguments_of(existing)) >= checker.get_min_type_argument_count(params as ref[Array[ref[Type]?]])
    }

    ; tryReuseExistingNonParameterTypeNode
    procedure try_reuse_existing_non_parameter_type_node(mutable this, mutable existing: ref[AstNode], mutable t: ref[Type], host_in: ref[AstNode]?, annotation_type_in: ref[Type]?) returns ref[AstNode]?
    {
        var host_node host_in
        if host_node = null
            set host_node: (this.the_ctx()).enclosing_declaration
        var annotation_type annotation_type_in
        if annotation_type = null
            set annotation_type: this.get_type_from_type_node(existing, true)
        if annotation_type = null
            return null
        if this.type_node_is_equivalent_to_type(host_node, t, annotation_type) = false
            return null
        if this.can_reuse_existing_js_type_node(existing, t) = false
            return null
        this.try_reuse_existing_node_helper(existing)
    }

    ; rewriteModuleSpecifier: a specifier from another file is regenerated —
    ; the modulespecifiers chapter — so a differing one stops
    procedure rewrite_module_specifier(mutable this, mutable parent: ref[AstNode], mutable lit: ref[AstNode]) returns ref[AstNode]
    {
        let c this.the_ctx()
        if c.enclosing_file = Checker.source_file_of_node(lit)
            return lit
        var mode 0
        let attributes AstNode.import_type_attributes_of(parent)
        if attributes <> null
            set mode: checker.get_resolution_mode_override(attributes as ref[AstNode], false)
        let node_symbol this.try_get_resolved_symbol_from_type_node(parent)
        var meaning SymbolFlagsType
        if AstNode.import_type_is_type_of(parent)
            set meaning: SymbolFlagsValue
        var parent_symbol: ref[Symbol]? null
        if node_symbol <> null
        {
            if this.is_symbol_accessible_now(node_symbol as ref[Symbol], meaning)
            {
                let chain &Array[ref[Symbol]?]^host()
                this.lookup_symbol_chain(node_symbol as ref[Symbol], meaning, true, chain)
                if (chain.get_length() as int) > 0
                    set parent_symbol: chain[0]
            }
        }
        var name AstNode.literal_text_of(lit)
        var external false
        if parent_symbol <> null
        {
            let ps parent_symbol as ref[Symbol]
            if (Symbol.flags_of(ps) & SymbolFlagsValueModule) <> 0
            {
                if NodeBuilder.starts_with_quote(Symbol.name_of(ps))
                    set external: true
            }
        }
        if external
            set name: this.get_specifier_for_module_symbol(parent_symbol as ref[Symbol], mode)
        else
        {
            let target_file checker.get_external_module_file_from_declaration(parent)
            if target_file <> null
            {
                let file_symbol (target_file as ref[AstNode]).symbol
                if file_symbol <> null
                    set name: this.get_specifier_for_module_symbol(file_symbol as ref[Symbol], mode)
            }
        }
        if unported_count > 0
            return lit
        if SymbolTable.names_equal(name, AstNode.literal_text_of(lit))
            return lit
        let res factory.new_string_literal(name, TokenFlagsNone)
        context.set_original(res, lit)
        res
    }

    ; attachSymbolToLeftmostIdentifier: a visitor over `node` that replaces the
    ; leftmost identifier by a fresh one (a type parameter's generated name)
    procedure attach_symbol_to_leftmost_identifier(mutable this, leftmost: ref[AstNode], mutable node: ref[AstNode], sym: ref[Symbol]?) returns ref[AstNode]?
    {
        let old_leftmost attach_leftmost
        let old_symbol attach_symbol
        set this.attach_leftmost: leftmost
        set this.attach_symbol: sym
        let result this.attach_visit(node)
        set this.attach_leftmost: old_leftmost
        set this.attach_symbol: old_symbol
        result
    }

    procedure the_attach_visitor(mutable this) returns ref[NodeVisitor]
    {
        if attach_visitor = null
        {
            let v context.new_node_visitor(VisitTagTransformer)
            set v.transformer: tracker
            set v.sub_tag: DtSubNbAttach
            set this.attach_visitor: v
        }
        attach_visitor as ref[NodeVisitor]
    }

    ; the callback of that visitor
    procedure attach_visit(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        if node = attach_leftmost
        {
            var name: ref[AstNode]? null
            if attach_symbol <> null
            {
                let sym attach_symbol as ref[Symbol]
                if (Symbol.flags_of(sym) & SymbolFlagsTypeParameter) <> 0
                {
                    let declared checker.get_declared_type_of_symbol(sym)
                    if declared <> null
                        set name: this.type_parameter_to_name(declared as ref[Type])
                }
            }
            if name = null
                set name: this.new_identifier(AstNode.identifier_text_of(node))
            let ranged this.set_text_range(name, node)
            if ranged <> null
                context.add_emit_flags(ranged as ref[AstNode], EFNoAsciiEscaping)
            return ranged
        }
        this.set_text_range((this.the_attach_visitor()).visit_each_child(node), node)
    }

    ; trackExistingEntityName: the answer is the node; `introduces_error` and
    ; `tracked_sym` are the other two results of the reference's triple
    procedure track_existing_entity_name(mutable this, mutable node: ref[AstNode], override_enclosing: ref[AstNode]?) returns ref[AstNode]?
    {
        let c this.the_ctx()
        var enclosing c.enclosing_declaration
        if override_enclosing <> null
            set enclosing: override_enclosing
        set this.introduces_error: false
        set this.tracked_sym: null
        let leftmost_opt Checker.get_first_identifier(node)
        if leftmost_opt = null
            return this.set_text_range(this.deep_clone(node), node)
        let leftmost leftmost_opt as ref[AstNode]
        if Parser.is_in_js_file(node)
        {
            var exports_shape false
            if Parser.is_exports_identifier(leftmost)
                set exports_shape: true
            if leftmost.parent <> null
            {
                let lp leftmost.parent as ref[AstNode]
                if Parser.is_module_exports_access_expression(lp)
                    set exports_shape: true
                if lp.kind = KindQualifiedName
                {
                    if Parser.is_module_identifier(AstNode.qualified_left_of(lp)) and Parser.is_exports_identifier(AstNode.qualified_right_of(lp))
                        set exports_shape: true
                }
            }
            if exports_shape
            {
                set this.introduces_error: true
                return this.set_text_range(this.deep_clone(node), node)
            }
        }
        let meaning Checker.get_meaning_of_entity_name_reference(node)
        if AstNode.is_this_identifier(leftmost)
        {
            let container Binder.get_this_container(leftmost, false, false)
            let sym checker.get_symbol_of_declaration(container)
            if sym <> null
            {
                if (checker.is_symbol_accessible(sym, leftmost, meaning, false)).accessibility <> SymbolAccessibilityAccessible
                {
                    set this.introduces_error: true
                    this.report_inaccessible_this_error()
                }
            }
            return this.attach_symbol_to_leftmost_identifier(leftmost, node, sym)
        }
        var sym checker.resolve_entity_name(leftmost, meaning, true, true, null)
        var is_type_parameter false
        if sym <> null
        {
            if (Symbol.flags_of(sym as ref[Symbol]) & SymbolFlagsTypeParameter) <> 0
                set is_type_parameter: true
        }
        if (c.enclosing_declaration <> null) and (is_type_parameter = false)
        {
            set sym: checker.get_export_symbol_of_value_symbol_if_exported(sym)
            let sym_at_location checker.resolve_entity_name(leftmost, meaning, true, true, c.enclosing_declaration)
            var mismatch false
            if sym_at_location = checker.unknown_symbol
                set mismatch: true
            if (sym_at_location = null) and (sym <> null)
                set mismatch: true
            if (sym_at_location <> null) and (sym <> null)
            {
                if checker.get_symbol_if_same_reference(checker.get_export_symbol_of_value_symbol_if_exported(sym_at_location), sym) = null
                    set mismatch: true
            }
            if mismatch
            {
                if sym_at_location <> checker.unknown_symbol
                    this.report_inference_fallback(node)
                set this.introduces_error: true
                set this.tracked_sym: sym
                return this.set_text_range(this.deep_clone(node), node)
            }
            set sym: sym_at_location
        }
        if sym <> null
        {
            let s sym as ref[Symbol]
            if (Symbol.flags_of(s) & SymbolFlagsFunctionScopedVariable) <> 0
            {
                let vd Symbol.value_declaration_of(s)
                if vd <> null
                {
                    let vdn vd as ref[AstNode]
                    if Binder.is_part_of_parameter_declaration(vdn) or (vdn.kind = KindJSDocParameterTag)
                        return this.attach_symbol_to_leftmost_identifier(leftmost, node, s)
                }
            }
            var inaccessible false
            if ((Symbol.flags_of(s) & SymbolFlagsTypeParameter) = 0) and (AstNode.is_declaration_name(node) = false)
            {
                if (checker.is_symbol_accessible(s, enclosing, meaning, false)).accessibility <> SymbolAccessibilityAccessible
                    set inaccessible: true
            }
            if inaccessible
            {
                this.report_inference_fallback(node)
                set this.introduces_error: true
            }
            else
                this.track_symbol(s, enclosing, meaning)
            return this.attach_symbol_to_leftmost_identifier(leftmost, node, s)
        }
        this.set_text_range(this.deep_clone(node), node)
    }

    ; tryVisitSimpleTypeNode
    procedure try_visit_simple_type_node(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        var inner node
        let skipped Parser.skip_parentheses(node)
        if skipped <> null
            set inner: skipped as ref[AstNode]
        if inner.kind = KindTypeReference
            return this.try_visit_type_reference(inner)
        if inner.kind = KindTypeQuery
            return this.try_visit_type_query(inner)
        if inner.kind = KindIndexedAccessType
            return this.try_visit_indexed_access(inner)
        if inner.kind = KindTypeOperator
        {
            if AstNode.type_operator_operator_of(inner) = KindKeyOfKeyword
                return this.try_visit_key_of(inner)
        }
        (this.the_existing_visitor()).visit_node(node)
    }

    procedure try_visit_indexed_access(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        let object_type AstNode.indexed_access_object_type_of(node)
        if object_type = null
            return null
        let result_object_type this.try_visit_simple_type_node(object_type as ref[AstNode])
        if result_object_type = null
            return null
        this.set_text_range(factory.update_indexed_access_type_node(node, result_object_type, (this.the_existing_visitor()).visit_node(AstNode.indexed_access_index_type_of(node))), node)
    }

    procedure try_visit_key_of(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        let inner AstNode.type_operator_inner_of(node)
        if inner = null
            return null
        let t this.try_visit_simple_type_node(inner as ref[AstNode])
        if t = null
            return null
        this.set_text_range(factory.update_type_operator_node(node, AstNode.type_operator_operator_of(node), t), node)
    }

    procedure try_visit_type_query(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_existing_visitor()
        let expr_name AstNode.type_query_expr_name_of(node) as ref[AstNode]
        let tracked this.track_existing_entity_name(expr_name, null)
        if introduces_error = false
            return this.set_text_range(factory.update_type_query_node(node, tracked, v.visit_nodes(AstNode.type_arguments_of(node))), node)
        let serialized_name this.serialize_type_name(expr_name, true, v.visit_nodes(AstNode.type_arguments_of(node)))
        if serialized_name <> null
            return this.set_text_range(serialized_name, expr_name)
        null
    }

    procedure try_visit_type_reference(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_existing_visitor()
        if Parser.is_const_type_reference(node)
            return null
        let s this.try_get_resolved_symbol_from_type_node(node)
        if s = null
            return null
        let sym s as ref[Symbol]
        if (Symbol.flags_of(sym) & SymbolFlagsTypeParameter) <> 0
        {
            let declared_type checker.get_declared_type_of_symbol(sym)
            let c this.the_ctx()
            if (c.mapper <> null) and (declared_type <> null)
            {
                if checker.instantiate_type(declared_type, c.mapper) <> declared_type
                    return null
            }
        }
        let node_type this.get_type_from_type_node(node, false)
        if node_type <> null
        {
            if this.can_reuse_existing_js_type_node(node, node_type as ref[Type]) = false
                return null
        }
        let type_name AstNode.type_reference_name_of(node) as ref[AstNode]
        let new_name this.track_existing_entity_name(type_name, null)
        if introduces_error = false
        {
            let type_arguments v.visit_nodes(AstNode.type_reference_arguments_of(node))
            return this.set_text_range(factory.update_type_reference_node(node, new_name, type_arguments), node)
        }
        let serialized_name this.serialize_type_name(type_name, false, v.visit_nodes(AstNode.type_reference_arguments_of(node)))
        if serialized_name <> null
            return this.set_text_range(serialized_name, type_name)
        null
    }

    ; the inner slot of the one-child JSDoc type nodes
    function jsdoc_wrapped_inner_of(node: ref[AstNode]) returns ref[AstNode]?
    {
        choose node.data
            when d: JSDocNullableType
                return d.inner
            when d: JSDocNonNullableType
                return d.inner
            when d: JSDocOptionalType
                return d.inner
            when d: JSDocVariadicType
                return d.inner
            when d: JSDocTypeExpression
                return d.inner
        null
    }

    ; the callback of the existing-node visitor (getExistingNodeTreeVisitor's
    ; outer closure)
    procedure visit_existing_node(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        if boundary_depth = 0
            return node
        let bound this.top_boundary()
        if bound.had_error
            return node
        let tracked_top this.recovery_tracked_top()
        let deferred_top this.recovery_deferred_top()
        let had_error bound.had_error
        var introduces_new_scope false
        if AstNode.is_function_like(node)
            set introduces_new_scope: true
        if node.kind = KindMappedType
            set introduces_new_scope: true
        if introduces_new_scope
        {
            var params: ref[Array[ref[Symbol]?]]? null
            var type_params: ref[Array[ref[Type]?]]? null
            if AstNode.is_function_like(node)
            {
                let sig checker.get_signature_from_declaration(node)
                if sig <> null
                {
                    set params: (sig as ref[Signature]).parameters
                    set type_params: (sig as ref[Signature]).type_parameters
                }
            }
            else
            {
                let tp_symbol checker.get_symbol_of_declaration(AstNode.mapped_type_parameter_of(node))
                if tp_symbol <> null
                {
                    let list &Array[ref[Type]?]^host()
                    list.add(checker.get_declared_type_of_type_parameter(tp_symbol as ref[Symbol]))
                    set type_params: list
                }
            }
            this.enter_new_scope(node, params, type_params, null, null)
        }
        var result this.visit_existing_node_tree_symbols_worker(node)
        if introduces_new_scope
            this.exit_scope()
        if result = node
        {
            if Printer.node_is_synthesized(node) = false
                set result: this.deep_clone(node)
        }
        set result: this.set_text_range(result, node)
        let bound_after this.top_boundary()
        if bound_after.had_error
        {
            if NodeBuilder.is_type_node_kind(node.kind) and (node.kind <> KindTypePredicate)
            {
                this.end_recovery_scope(tracked_top, deferred_top, had_error)
                return this.type_to_type_node(this.get_type_from_type_node(node, false))
            }
            return this.set_text_range(factory.clone(node), node)
        }
        result
    }

    procedure mark_boundary_error(mutable this)
    {
        if boundary_depth = 0
            return
        let bound this.top_boundary()
        set bound.had_error: true
    }

    ; visitExistingNodeTreeSymbolsWorker
    procedure visit_existing_node_tree_symbols_worker(mutable this, mutable node: ref[AstNode]) returns ref[AstNode]?
    {
        let c this.the_ctx()
        let v this.the_existing_visitor()
        let k node.kind
        if k = KindJSDocTypeExpression
            return v.visit_node(NodeBuilder.jsdoc_wrapped_inner_of(node))
        if k = KindJSDocAllType
            return factory.new_keyword_type_node(KindAnyKeyword)
        if k = KindJSDocNullableType
        {
            let members &Array[ref[AstNode]?]^host()
            members.add(v.visit_node(NodeBuilder.jsdoc_wrapped_inner_of(node)))
            members.add(factory.new_literal_type_node(factory.new_keyword_expression(KindNullKeyword)))
            return factory.new_union_type_node(members)
        }
        if k = KindJSDocOptionalType
        {
            let members &Array[ref[AstNode]?]^host()
            members.add(v.visit_node(NodeBuilder.jsdoc_wrapped_inner_of(node)))
            members.add(factory.new_keyword_type_node(KindUndefinedKeyword))
            return factory.new_union_type_node(members)
        }
        if k = KindJSDocNonNullableType
            return v.visit_node(NodeBuilder.jsdoc_wrapped_inner_of(node))
        if k = KindJSDocVariadicType
            return factory.new_array_type_node(v.visit_node(NodeBuilder.jsdoc_wrapped_inner_of(node)))
        if k = KindJSDocTypeLiteral
        {
            let members &Array[ref[AstNode]?]^host()
            let tags AstNode.jsdoc_type_literal_tags_of(node)
            let n AstNode.list_count(tags)
            var i 0
            while i < n
            {
                let t AstNode.child_in_list(tags, i)
                if t <> null
                {
                    let tag t as ref[AstNode]
                    if (tag.kind = KindJSDocPropertyTag) or (tag.kind = KindJSDocParameterTag)
                    {
                        let tag_name AstNode.jsdoc_param_name_of(tag)
                        var target_name tag_name
                        if tag_name <> null
                        {
                            if (tag_name as ref[AstNode]).kind <> KindIdentifier
                                set target_name: AstNode.qualified_right_of(tag_name as ref[AstNode])
                        }
                        let name v.visit_node(target_name)
                        var should_be_optional false
                        choose tag.data
                            when pt: JSDocParameterOrPropertyTag
                                set should_be_optional: pt.is_bracketed
                        let type_expression AstNode.jsdoc_type_expression_of(tag)
                        if type_expression <> null
                        {
                            if (type_expression as ref[AstNode]).kind = KindJSDocOptionalType
                                set should_be_optional: true
                        }
                        var question: ref[AstNode]? null
                        if should_be_optional
                            set question: factory.new_token(KindQuestionToken)
                        let ty v.visit_node(type_expression)
                        members.add(factory.new_property_signature_declaration(null, name, question, ty, null))
                    }
                }
                set i: i + 1
            }
            return factory.new_type_literal_node(members)
        }
        if k = KindTypeReference
        {
            let type_name AstNode.type_reference_name_of(node)
            if type_name <> null
            {
                let tn type_name as ref[AstNode]
                if tn.kind = KindIdentifier
                {
                    if AstNode.identifier_text_of(tn).length = 0
                    {
                        let replacement factory.new_keyword_type_node(KindAnyKeyword)
                        context.set_original(replacement, node)
                        return replacement
                    }
                }
            }
        }
        if k = KindThisType
            return node
        if k = KindTypeParameter
        {
            let new_name this.track_existing_entity_name(AstNode.name_of(node) as ref[AstNode], null)
            return factory.update_type_parameter_declaration(node, v.visit_modifiers(AstNode.modifiers_of(node)), new_name, v.visit_node(AstNode.type_parameter_constraint_of(node)), v.visit_node(AstNode.type_parameter_expression_of(node)), v.visit_node(AstNode.type_parameter_default_of(node)))
        }
        if k = KindIndexedAccessType
        {
            let result this.try_visit_indexed_access(node)
            if result <> null
                return result
            this.mark_boundary_error()
            return node
        }
        if k = KindTypeReference
        {
            let result this.try_visit_type_reference(node)
            if result <> null
                return result
            this.mark_boundary_error()
            return node
        }
        if k = KindTypeQuery
        {
            let result this.try_visit_type_query(node)
            if result <> null
                return result
            this.mark_boundary_error()
            return node
        }
        if k = KindTypeOperator
        {
            let op AstNode.type_operator_operator_of(node)
            let inner AstNode.type_operator_inner_of(node)
            var unique_symbol false
            if (op = KindUniqueKeyword) and (inner <> null)
            {
                if (inner as ref[AstNode]).kind = KindSymbolKeyword
                    set unique_symbol: true
            }
            if unique_symbol
            {
                let non_fake_enclosing this.get_enclosing_declaration_ignoring_fake_scope()
                var same_scope false
                var a: ref[AstNode]? node
                while a <> null
                {
                    if a = non_fake_enclosing
                    {
                        set same_scope: true
                        set a: null
                    }
                    else
                        set a: (a as ref[AstNode]).parent
                }
                if same_scope = false
                {
                    this.mark_boundary_error()
                    return node
                }
            }
            else
            {
                if op = KindKeyOfKeyword
                {
                    let result this.try_visit_key_of(node)
                    if result <> null
                        return result
                    this.mark_boundary_error()
                    return node
                }
            }
        }
        if Transformer.dt_is_literal_import_type_node(node)
        {
            let attributes AstNode.import_type_attributes_of(node)
            if attributes <> null
            {
                if AstNode.import_attributes_token_of(attributes as ref[AstNode]) = KindAssertKeyword
                {
                    this.mark_boundary_error()
                    return node
                }
            }
            let t this.get_type_from_type_node(node, true)
            if t = null
            {
                this.mark_boundary_error()
                return node
            }
            let argument AstNode.import_type_argument_of(node) as ref[AstNode]
            let original_spec AstNode.literal_type_inner_of(argument) as ref[AstNode]
            var specifier this.rewrite_module_specifier(node, original_spec)
            var arg: ref[AstNode]? argument
            if specifier = original_spec
                set specifier: v.visit_node(specifier) as ref[AstNode]
            if specifier <> original_spec
                set arg: factory.new_literal_type_node(specifier)
            return factory.update_import_type_node(node, AstNode.import_type_is_type_of(node), arg, v.visit_node(attributes), v.visit_node(AstNode.import_type_qualifier_of(node)), v.visit_nodes(AstNode.type_arguments_of(node)))
        }
        let name AstNode.name_of(node)
        if name <> null
        {
            let nm name as ref[AstNode]
            if (nm.kind = KindComputedPropertyName) and (checker.has_late_bindable_name(node) = false)
            {
                if (this.the_binder()).has_dynamic_name(node) = false
                    return v.visit_each_child(node)
                var keep false
                if (c.internal_flags & NbInternalFlagsAllowUnresolvedNames) <> 0
                {
                    if Parser.is_entity_name_expression(AstNode.expression_of(nm))
                    {
                        let ct checker.check_computed_property_name(nm)
                        if ct <> null
                        {
                            if ((ct as ref[Type]).flags & TypeFlagsAny) <> 0
                                set keep: true
                        }
                    }
                }
                if keep = false
                    return null
            }
        }
        var needs_any_type false
        if AstNode.is_function_like(node) and (AstNode.type_of(node) = null)
            set needs_any_type: true
        if ((k = KindPropertyDeclaration) or (k = KindPropertySignature) or (k = KindParameter)) and (AstNode.type_of(node) = null) and (AstNode.initializer_of(node) = null)
            set needs_any_type: true
        if needs_any_type
        {
            var visited v.visit_each_child(node)
            if visited = node
                set visited: this.set_text_range(factory.clone(node), node)
            if visited = null
                return null
            let n visited as ref[AstNode]
            let new_type factory.new_keyword_type_node(KindAnyKeyword)
            if n.kind = KindPropertyDeclaration
                return factory.update_property_declaration(n, AstNode.modifiers_of(n), AstNode.name_of(n), AstNode.postfix_token_of(n), new_type, null)
            if n.kind = KindPropertySignature
                return factory.update_property_signature_declaration(n, AstNode.modifiers_of(n), AstNode.name_of(n), AstNode.postfix_token_of(n), new_type, null)
            if n.kind = KindParameter
                return factory.update_parameter_declaration(n, null, AstNode.dot_dot_dot_token_of(n), AstNode.name_of(n), AstNode.parameter_question_token_of(n), new_type, null)
            if n.kind = KindMethodSignature
                return factory.update_method_signature_declaration(n, AstNode.modifiers_of(n), AstNode.name_of(n), AstNode.postfix_token_of(n), AstNode.type_parameters_of(n), AstNode.parameters_of(n), new_type)
            if n.kind = KindCallSignature
                return factory.update_call_signature_declaration(n, AstNode.type_parameters_of(n), AstNode.parameters_of(n), new_type)
            if n.kind = KindJSDocSignature
                return factory.update_js_doc_signature(n, AstNode.type_parameters_of(n), AstNode.parameters_of(n), new_type)
            if n.kind = KindConstructSignature
                return factory.update_construct_signature_declaration(n, AstNode.type_parameters_of(n), AstNode.parameters_of(n), new_type)
            if n.kind = KindIndexSignature
                return factory.update_index_signature_declaration(n, AstNode.modifiers_of(n), AstNode.parameters_of(n), new_type)
            if n.kind = KindFunctionType
                return factory.update_function_type_node(n, AstNode.type_parameters_of(n), AstNode.parameters_of(n), new_type)
            if n.kind = KindConstructorType
                return factory.update_constructor_type_node(n, AstNode.modifiers_of(n), AstNode.type_parameters_of(n), AstNode.parameters_of(n), new_type)
            return n
        }
        if k = KindComputedPropertyName
        {
            let expr AstNode.expression_of(node)
            if Parser.is_entity_name_expression(expr)
            {
                let result this.track_existing_entity_name(expr as ref[AstNode], null)
                if introduces_error = false
                    return factory.update_computed_property_name(node, result)
                this.mark_boundary_error()
                return v.visit_each_child(node)
            }
        }
        if k = KindTypePredicate
        {
            let param_name AstNode.type_predicate_parameter_name_of(node) as ref[AstNode]
            var parameter_name: ref[AstNode]? null
            if param_name.kind = KindIdentifier
            {
                let result this.track_existing_entity_name(param_name, null)
                if introduces_error
                    this.mark_boundary_error()
                set parameter_name: result
            }
            else
                set parameter_name: factory.clone(param_name)
            return factory.update_type_predicate_node(node, v.visit_node(AstNode.type_predicate_asserts_modifier_of(node)), parameter_name, v.visit_node(AstNode.type_of(node)))
        }
        if k = KindConditionalType
        {
            let check_type v.visit_node(AstNode.conditional_type_check_of(node))
            this.enter_new_scope(node, null, checker.get_infer_type_parameters(node), null, null)
            let extends_type v.visit_node(AstNode.conditional_type_extends_of(node))
            let true_type v.visit_node(AstNode.conditional_type_true_of(node))
            this.exit_scope()
            let false_type v.visit_node(AstNode.conditional_type_false_of(node))
            return factory.update_conditional_type_node(node, check_type, extends_type, true_type, false_type)
        }
        var single_line false
        if (k = KindTupleType) or (k = KindMappedType)
            set single_line: true
        if (k = KindTypeLiteral) and ((c.flags & NbFlagsMultilineObjectLiterals) = 0)
            set single_line: true
        if single_line
        {
            var res v.visit_each_child(node)
            if res = node
                set res: this.set_text_range(factory.clone(node), node)
            if res <> null
                context.add_emit_flags(res as ref[AstNode], EFSingleLine)
            return res
        }
        if Parser.is_string_literal_like(node)
        {
            let cloned factory.clone(node)
            if (k = KindStringLiteral) and ((c.flags & NbFlagsUseSingleQuotesForStringLiteralType) <> 0)
            {
                if (AstNode.string_token_flags_of(node) & TokenFlagsSingleQuote) = 0
                {
                    choose cloned.data
                        when l: StringLiteral
                        {
                            var ld l
                            set ld.token_flags: ld.token_flags | TokenFlagsSingleQuote
                            set cloned.data: NodeData.StringLiteral(ld)
                        }
                }
            }
            context.add_emit_flags(cloned, EFNoAsciiEscaping)
            return cloned
        }
        v.visit_each_child(node)
    }
}

define Flattener
(
    host: ref[Page]
    tx: ref[Transformer]
    level: int
    callback: int
    binding_mode: bool
    var expressions: ref[Array[ref[AstNode]?]]
    declarations: ref[Array[ref[PendingDecl]?]]
    var has_transformed_prior_element: bool
    hoist_temp_variables: bool
)
{
    function create(host: ref[Page], tx: ref[Transformer], level: int, callback: int, binding_mode: bool, hoist_temp_variables: bool) returns ref[Flattener]
    {
        let expressions &Array[ref[AstNode]?]^host()
        let declarations &Array[ref[PendingDecl]?]^host()
        &Flattener^host(host, tx, level, callback, binding_mode, expressions, declarations, false, hoist_temp_variables)
    }

    ; FlattenDestructuringAssignment
    procedure flatten_destructuring_assignment(host: ref[Page], mutable tx: ref[Transformer], mutable node: ref[AstNode], needs_value: bool, level: int, callback: int) returns ref[AstNode]
    {
        let f Flattener.create(host, tx, level, callback, false, true)
        f.flatten_assignment(node, needs_value)
    }

    ; FlattenDestructuringBinding: one VariableDeclaration, a SyntaxList of them, or null
    procedure flatten_destructuring_binding(host: ref[Page], mutable tx: ref[Transformer], mutable node: ref[AstNode], mutable rval: ref[AstNode]?, level: int, hoist_temp_variables: bool, skip_initializer: bool) returns ref[AstNode]?
    {
        let f Flattener.create(host, tx, level, FlattenCallbackNone, true, hoist_temp_variables)
        f.flatten_binding(node, rval, skip_initializer)
    }

    function the_factory(this) returns ref[NodeFactory]
        tx.factory

    function the_context(this) returns ref[EmitContext]
        tx.context

    ; createArrayBindingOrAssignmentPattern / createObjectBindingOrAssignmentPattern
    procedure create_array_pattern(mutable this, elements: ref[Array[ref[AstNode]?]]) returns ref[AstNode]
    {
        let f this.the_factory()
        if binding_mode
            return f.new_binding_pattern(KindArrayBindingPattern, elements)
        f.new_array_literal_expression(elements, false)
    }

    procedure create_object_pattern(mutable this, elements: ref[Array[ref[AstNode]?]]) returns ref[AstNode]
    {
        let f this.the_factory()
        if binding_mode
            return f.new_binding_pattern(KindObjectBindingPattern, elements)
        f.new_object_literal_expression(elements, false)
    }

    ; createArrayBindingOrAssignmentElement
    procedure create_array_element(mutable this, expr: ref[AstNode]) returns ref[AstNode]
    {
        if binding_mode
            return this.the_factory().new_binding_element(null, null, expr, null)
        expr
    }

    ; emitBindingOrAssignment: emitAssignment / emitBinding
    procedure emit_binding_or_assignment(mutable this, mutable target: ref[AstNode], mutable value_in: ref[AstNode]?, pos: int, end: int, original: ref[AstNode]?)
    {
        let f this.the_factory()
        let ctx this.the_context()
        if binding_mode
        {
            var value value_in
            if expressions.get_length() > 0
            {
                expressions.add(value_in)
                set value: f.inline_expressions(expressions)
                set this.expressions: &Array[ref[AstNode]?]^host()
            }
            declarations.add(&PendingDecl^host(null, target, value, pos, end, original))
            return
        }
        var expression: ref[AstNode]? null
        if (callback <> FlattenCallbackNone) and (target.kind = KindIdentifier)
            set expression: tx.flatten_create_assignment(callback, target, value_in as ref[AstNode], true, TextRange(pos, end))
        else
        {
            let e f.new_assignment_expression(tx.the_visitor().visit_node(target), value_in)
            set e.pos: pos as i32
            set e.end: end as i32
            set expression: e
        }
        let ex expression as ref[AstNode]
        if original <> null
            ctx.set_original(ex, original as ref[AstNode])
        expressions.add(ex)
    }

    ; ensureIdentifier
    procedure ensure_identifier(mutable this, mutable value: ref[AstNode], reuse_identifier_expressions: bool, pos: int, end: int) returns ref[AstNode]
    {
        if reuse_identifier_expressions and (value.kind = KindIdentifier)
            return value
        let f this.the_factory()
        let temp f.new_temp_variable()
        if hoist_temp_variables
        {
            this.the_context().add_variable_declaration(temp)
            let assign f.new_assignment_expression(temp, value)
            set assign.pos: pos as i32
            set assign.end: end as i32
            expressions.add(assign)
        }
        else
            this.emit_binding_or_assignment(temp, value, pos, end, null)
        temp
    }

    ; createDefaultValueCheck: value === void 0 ? defaultValue : value
    procedure create_default_value_check(mutable this, mutable value_in: ref[AstNode], default_value: ref[AstNode], pos: int, end: int) returns ref[AstNode]
    {
        let f this.the_factory()
        let value this.ensure_identifier(value_in, true, pos, end)
        let undefined_text: Slice[char] "undefined"
        f.new_conditional_expression(f.new_type_check(value, undefined_text), f.new_token(KindQuestionToken), default_value, f.new_token(KindColonToken), value)
    }

    ; createDestructuringPropertyAccess
    procedure create_destructuring_property_access(mutable this, value: ref[AstNode], mutable property_name: ref[AstNode]) returns ref[AstNode]
    {
        let f this.the_factory()
        if property_name.kind = KindComputedPropertyName
        {
            let visited tx.the_visitor().visit_node(AstNode.expression_of(property_name)) as ref[AstNode]
            let argument_expression this.ensure_identifier(visited, false, property_name.pos, property_name.end)
            return f.new_element_access_expression(value, null, argument_expression, NodeFlagsNone)
        }
        if Binder.is_string_or_numeric_literal_like(property_name) or (property_name.kind = KindBigIntLiteral)
            return f.new_element_access_expression(value, null, f.clone(property_name), NodeFlagsNone)
        f.new_property_access_expression(value, null, f.new_identifier(AstNode.identifier_text_of(property_name)), NodeFlagsNone)
    }

    ; flattenDestructuringAssignment (the entry point's body)
    procedure flatten_assignment(mutable this, mutable node_in: ref[AstNode], needs_value: bool) returns ref[AstNode]
    {
        let f this.the_factory()
        let v tx.the_visitor()
        var node node_in
        var pos node.pos
        var end node.end
        var value: ref[AstNode]? null
        if Binder.is_destructuring_assignment(node)
        {
            set value: AstNode.binary_right_of(node)
            ; `[] = x` and `{} = x` peel down to the innermost assignment
            while Transformer.is_empty_array_or_object_literal(AstNode.binary_left_of(node) as ref[AstNode])
            {
                if Binder.is_destructuring_assignment(value)
                {
                    set node: value as ref[AstNode]
                    set pos: node.pos
                    set end: node.end
                    set value: AstNode.binary_right_of(node)
                }
                else
                    return v.visit_node(value) as ref[AstNode]
            }
        }
        if value <> null
        {
            let visited v.visit_node(value) as ref[AstNode]
            set value: visited
            var must_copy false
            if visited.kind = KindIdentifier
            {
                if Transformer.binding_or_assignment_element_assigns_to_name(node, AstNode.identifier_text_of(visited))
                    set must_copy: true
            }
            if Transformer.binding_or_assignment_element_contains_non_literal_computed_name(node)
                set must_copy: true
            if must_copy
                set value: this.ensure_identifier(visited, false, pos, end)
            else
            {
                if needs_value
                    set value: this.ensure_identifier(visited, true, pos, end)
                else
                {
                    if Printer.node_is_synthesized(node)
                    {
                        set pos: visited.pos
                        set end: visited.end
                    }
                }
            }
        }
        this.flatten_binding_or_assignment_element(node, value, pos, end, Binder.is_destructuring_assignment(node))
        if (value <> null) and needs_value
        {
            if expressions.get_length() = 0
                return value as ref[AstNode]
            expressions.add(value)
        }
        let res f.inline_expressions(expressions)
        if res <> null
            return res as ref[AstNode]
        f.new_omitted_expression()
    }

    ; flattenDestructuringBinding (the entry point's body)
    procedure flatten_binding(mutable this, mutable node_in: ref[AstNode], mutable rval: ref[AstNode]?, skip_initializer: bool) returns ref[AstNode]?
    {
        let f this.the_factory()
        let v tx.the_visitor()
        let ctx this.the_context()
        var node node_in
        if node.kind = KindVariableDeclaration
        {
            let initializer Transformer.get_initializer_of_binding_or_assignment_element(node)
            if initializer <> null
            {
                let init_node initializer as ref[AstNode]
                var must_copy false
                if init_node.kind = KindIdentifier
                {
                    if Transformer.binding_or_assignment_element_assigns_to_name(node, AstNode.identifier_text_of(init_node))
                        set must_copy: true
                }
                if Transformer.binding_or_assignment_element_contains_non_literal_computed_name(node)
                    set must_copy: true
                if must_copy
                {
                    let visited v.visit_node(init_node) as ref[AstNode]
                    let temp this.ensure_identifier(visited, false, init_node.pos, init_node.end)
                    set node: f.update_variable_declaration(node, AstNode.name_of(node), null, null, temp)
                }
            }
        }
        this.flatten_binding_or_assignment_element(node, rval, node.pos, node.end, skip_initializer)
        if expressions.get_length() > 0
        {
            let temp f.new_temp_variable()
            if hoist_temp_variables
            {
                let value f.inline_expressions(expressions)
                set this.expressions: &Array[ref[AstNode]?]^host()
                this.emit_binding_or_assignment(temp, value, 0 - 1, 0 - 1, null)
            }
            else
            {
                ctx.add_variable_declaration(temp)
                let last declarations[(declarations.get_length() - 1) as size_t] as ref[PendingDecl]
                let pending &Array[ref[AstNode]?]^host()
                Transformer.add_all(pending, last.pending_expressions)
                pending.add(f.new_assignment_expression(temp, last.value))
                Transformer.add_all(pending, expressions)
                set last.pending_expressions: pending
                set last.value: temp
            }
        }
        let decls &Array[ref[AstNode]?]^host()
        var i 0
        while i < (declarations.get_length() as int)
        {
            let pending declarations[i as size_t] as ref[PendingDecl]
            var expr pending.value
            if pending.pending_expressions <> null
            {
                let pe pending.pending_expressions as ref[Array[ref[AstNode]?]]
                if pe.get_length() > 0
                {
                    let all &Array[ref[AstNode]?]^host()
                    Transformer.add_all(all, pe)
                    all.add(pending.value)
                    set expr: f.inline_expressions(all)
                }
            }
            let decl f.new_variable_declaration(pending.name, null, null, expr)
            set decl.pos: pending.pos as i32
            set decl.end: pending.end as i32
            if pending.original <> null
                ctx.set_original(decl, pending.original as ref[AstNode])
            decls.add(decl)
            set i: i + 1
        }
        if decls.get_length() = 1
            return decls[0]
        if decls.get_length() = 0
            return null
        f.new_syntax_list(decls)
    }

    ; flattenBindingOrAssignmentElement
    procedure flatten_binding_or_assignment_element(mutable this, mutable element: ref[AstNode], mutable value_in: ref[AstNode]?, pos: int, end: int, skip_initializer: bool)
    {
        let f this.the_factory()
        let v tx.the_visitor()
        let binding_target_opt Emitter.target_of_binding_or_assignment_element(element)
        if binding_target_opt = null
            return
        let binding_target binding_target_opt as ref[AstNode]
        var value value_in
        if skip_initializer = false
        {
            let initializer v.visit_node(Transformer.get_initializer_of_binding_or_assignment_element(element))
            if initializer <> null
            {
                let init_node initializer as ref[AstNode]
                if value <> null
                {
                    let checked this.create_default_value_check(value as ref[AstNode], init_node, pos, end)
                    set value: checked
                    if (Transformer.is_simple_copiable_expression(init_node) = false) and (AstNode.is_binding_pattern(binding_target) or Emitter.is_assignment_pattern(binding_target))
                        set value: this.ensure_identifier(checked, true, pos, end)
                }
                else
                    set value: init_node
            }
            else
            {
                if value = null
                    set value: f.new_void_zero_expression()
            }
        }
        let tk binding_target.kind
        if (tk = KindObjectBindingPattern) or (tk = KindObjectLiteralExpression)
        {
            this.flatten_object_pattern(element, binding_target, value as ref[AstNode], pos, end)
            return
        }
        if (tk = KindArrayBindingPattern) or (tk = KindArrayLiteralExpression)
        {
            this.flatten_array_pattern(element, binding_target, value as ref[AstNode], pos, end)
            return
        }
        this.emit_binding_or_assignment(binding_target, value, pos, end, element)
    }

    ; flattenObjectBindingOrAssignmentPattern
    procedure flatten_object_pattern(mutable this, parent: ref[AstNode], mutable pattern: ref[AstNode], mutable value_in: ref[AstNode], pos: int, end: int)
    {
        let f this.the_factory()
        let v tx.the_visitor()
        let elements Emitter.pattern_elements_of(pattern) as ref[Array[ref[AstNode]?]]
        let num_elements elements.get_length() as int
        var value value_in
        if num_elements <> 1
        {
            let reuse_identifier_expressions (Emitter.is_declaration_binding_element(parent) = false) or (num_elements <> 0)
            set value: this.ensure_identifier(value_in, reuse_identifier_expressions, pos, end)
        }
        var binding_elements &Array[ref[AstNode]?]^host()
        let computed_temp_variables &Array[ref[AstNode]?]^host()
        var i 0
        while i < num_elements
        {
            let element elements[i as size_t] as ref[AstNode]
            if Transformer.rest_indicator_of_binding_or_assignment_element(element) = null
            {
                let property_name Transformer.try_get_property_name_of_binding_or_assignment_element(element) as ref[AstNode]
                let target Emitter.target_of_binding_or_assignment_element(element) as ref[AstNode]
                let rest_facts SubtreeContainsRestOrSpread | SubtreeContainsObjectRestOrSpread
                if (level >= FlattenLevelObjectRest) and ((Emitter.subtree_facts(element) & rest_facts) = 0) and ((Emitter.subtree_facts(target) & rest_facts) = 0) and (property_name.kind <> KindComputedPropertyName)
                    binding_elements.add(v.visit_node(element))
                else
                {
                    if binding_elements.get_length() > 0
                    {
                        this.emit_binding_or_assignment(this.create_object_pattern(binding_elements), value, pos, end, pattern)
                        set binding_elements: &Array[ref[AstNode]?]^host()
                    }
                    let rhs_value this.create_destructuring_property_access(value, property_name)
                    if property_name.kind = KindComputedPropertyName
                        computed_temp_variables.add(AstNode.element_access_argument_of(rhs_value))
                    this.flatten_binding_or_assignment_element(element, rhs_value, element.pos, element.end, false)
                }
            }
            else
            {
                if i = (num_elements - 1)
                {
                    if binding_elements.get_length() > 0
                    {
                        this.emit_binding_or_assignment(this.create_object_pattern(binding_elements), value, pos, end, pattern)
                        set binding_elements: &Array[ref[AstNode]?]^host()
                    }
                    let rhs_value tx.new_rest_helper(value, elements, computed_temp_variables, pattern.pos, pattern.end)
                    this.flatten_binding_or_assignment_element(element, rhs_value, element.pos, element.end, false)
                }
            }
            set i: i + 1
        }
        if binding_elements.get_length() > 0
            this.emit_binding_or_assignment(this.create_object_pattern(binding_elements), value, pos, end, pattern)
    }

    ; flattenArrayBindingOrAssignmentPattern
    procedure flatten_array_pattern(mutable this, parent: ref[AstNode], mutable pattern: ref[AstNode], mutable value_in: ref[AstNode], pos: int, end: int)
    {
        let f this.the_factory()
        let elements Emitter.pattern_elements_of(pattern) as ref[Array[ref[AstNode]?]]
        let num_elements elements.get_length() as int
        var value value_in
        var all_omitted true
        var oi 0
        while oi < num_elements
        {
            if AstNode.kind_of(elements[oi as size_t]) <> KindOmittedExpression
                set all_omitted: false
            set oi: oi + 1
        }
        if ((num_elements <> 1) and ((level < FlattenLevelObjectRest) or (num_elements = 0))) or all_omitted
        {
            let reuse_identifier_expressions (Emitter.is_declaration_binding_element(parent) = false) or (num_elements <> 0)
            set value: this.ensure_identifier(value_in, reuse_identifier_expressions, pos, end)
        }
        let binding_elements &Array[ref[AstNode]?]^host()
        let rest_ids &Array[ref[AstNode]?]^host()
        let rest_elements &Array[ref[AstNode]?]^host()
        var i 0
        while i < num_elements
        {
            let element elements[i as size_t] as ref[AstNode]
            if level >= FlattenLevelObjectRest
            {
                var needs_temp (Emitter.subtree_facts(element) & SubtreeContainsObjectRestOrSpread) <> 0
                if has_transformed_prior_element and (Transformer.is_simple_binding_or_assignment_element(element) = false)
                    set needs_temp: true
                if needs_temp
                {
                    set this.has_transformed_prior_element: true
                    let temp f.new_temp_variable()
                    if hoist_temp_variables
                        this.the_context().add_variable_declaration(temp)
                    rest_ids.add(temp)
                    rest_elements.add(element)
                    binding_elements.add(this.create_array_element(temp))
                }
                else
                    binding_elements.add(element)
            }
            else
            {
                if element.kind <> KindOmittedExpression
                {
                    if Transformer.rest_indicator_of_binding_or_assignment_element(element) = null
                    {
                        let index_text Transformer.decimal_slice(host, i)
                        let rhs_value f.new_element_access_expression(value, null, f.new_numeric_literal(index_text, TokenFlagsNone), NodeFlagsNone)
                        this.flatten_binding_or_assignment_element(element, rhs_value, element.pos, element.end, false)
                    }
                    else
                    {
                        if i = (num_elements - 1)
                        {
                            let rhs_value f.new_array_slice_call(value, i)
                            this.flatten_binding_or_assignment_element(element, rhs_value, element.pos, element.end, false)
                        }
                    }
                }
            }
            set i: i + 1
        }
        if binding_elements.get_length() > 0
            this.emit_binding_or_assignment(this.create_array_pattern(binding_elements), value, pos, end, pattern)
        var r 0
        while r < (rest_ids.get_length() as int)
        {
            let element rest_elements[r as size_t] as ref[AstNode]
            this.flatten_binding_or_assignment_element(element, rest_ids[r as size_t], element.pos, element.end, false)
            set r: r + 1
        }
    }

}

; ═══ compiler/emitter.go, the JS half, over the corpus's default options ═══

; What the driver scans a file for before it decides which transformers it
; needs: each bit names a transformer this port has not ported yet.
define EmitFacts
(
    var has_import_or_export: bool
    var has_runtime_syntax: bool
    var has_decorator: bool
    var has_using: bool
    var has_auto_accessor: bool
    var has_dynamic_import: bool
)

define Emitter
(
    host: ref[Page]
    var unported_count: int
    var unported_tag: Slice[char]
    var unported_detail: int
    ; emit_dts: the file's declaration emit reported, so no .d.ts is written
    var dts_blocked: bool
    ; EmitOnlyForcedDts: the declaration file is printed whatever its diagnostics,
    ; without a declaration map
    var forced_dts: bool
    ; the last emit's source map JSON (empty without a map file) and the position of
    ; its sourceMappingURL comment in the text (-1 for none), WriteFileData's
    var map_text: Slice[char]
    var url_pos: int
)
{
    function create(host: ref[Page]) returns ref[Emitter]
    {
        let no_tag: Slice[char] ""
        &Emitter^host(host, 0, no_tag, 0, false, false, null, 0 - 1)
    }

    procedure record_unported(mutable this, tag_text: Slice[char], detail: int)
    {
        if unported_count = 0
        {
            set this.unported_tag: tag_text
            set this.unported_detail: detail
        }
        set this.unported_count: unported_count + 1
    }

    ; ── the source-map half of printSourceFile (slice 247) ──

    ; getOwnEmitOutputFilePath for ONE root: the unit's directory (or outDir under
    ; the current directory) and the output extension
    procedure js_output_path(mutable this, info: ref[SourceFileInfo], mutable options: EmitOptions, cwd: Slice[char], mutable checker: ref[Checker]) returns Slice[char]
    {
        let base_name get_base_file_name(host, normalize_slashes(host, info.file_name))
        let base base_name.subslice(0, remove_file_extension(base_name) as size_t)
        var ext: Slice[char] ".js"
        let fname info.file_name
        if fname.ends_with(".mts") or fname.ends_with(".mjs")
        {
            let mjs: Slice[char] ".mjs"
            set ext: mjs
        }
        if fname.ends_with(".cts") or fname.ends_with(".cjs")
        {
            let cjs: Slice[char] ".cjs"
            set ext: cjs
        }
        if fname.ends_with(".json")
        {
            let json: Slice[char] ".json"
            set ext: json
        }
        if fname.ends_with(".tsx") or fname.ends_with(".jsx")
        {
            if (options.jsx = JsxEmitPreserve) or (options.jsx = JsxEmitReactNative)
            {
                let jsx: Slice[char] ".jsx"
                set ext: jsx
            }
        }
        var dir get_directory_path(host, normalize_slashes(host, info.file_name))
        if options.out_dir.length > 0
            set dir: this.output_directory_of(info, options, options.out_dir, cwd, checker)
        let sb StringBuilder^host()
        sb.append(dir.data, dir.length as size_t)
        if has_trailing_directory_separator(dir) = false
            sb.append("/")
        sb.append(base.data, base.length as size_t)
        sb.append(ext.data, ext.length as size_t)
        Printer.slice_on(host, sb.to_string())
    }

    ; the program's common source directory (Program.CommonSourceDirectory), the
    ; current directory for a unit emitted without a program
    procedure program_common_source_directory(mutable this, mutable options: EmitOptions, cwd: Slice[char], mutable checker: ref[Checker]) returns Slice[char]
    {
        if checker.program = null
            return ensure_trailing_directory_separator(host, cwd)
        let sh SpecifierHost.create(host, checker, checker.program as ref[ProgramFiles], options)
        sh.common_source_directory()
    }

    ; outputpaths.GetSourceFilePathInNewDir
    function source_file_path_in_new_dir(host: ref[Page], file_name: Slice[char], new_dir_path: Slice[char], cwd: Slice[char], common_in: Slice[char]) returns Slice[char]
    {
        var source_file_path get_normalized_absolute_path(host, file_name, cwd)
        let common ensure_trailing_directory_separator(host, common_in)
        if source_file_path.starts_with(common)
            set source_file_path: source_file_path.slice_from(common.length)
        combine_paths(host, new_dir_path, source_file_path)
    }

    ; outputpaths.GetSourceFilePathInNewDir's directory (slice 261): the file's own
    ; directory relative to the program's common source directory, below the output
    ; directory; a file outside the common directory keeps its own
    procedure output_directory_of(mutable this, info: ref[SourceFileInfo], mutable options: EmitOptions, out_dir_option: Slice[char], cwd: Slice[char], mutable checker: ref[Checker]) returns Slice[char]
    {
        let new_dir get_normalized_absolute_path(host, normalize_slashes(host, out_dir_option), cwd)
        if checker.program = null
            return new_dir
        let common this.program_common_source_directory(options, cwd, checker)
        get_directory_path(host, Emitter.source_file_path_in_new_dir(host, info.file_name, new_dir, cwd, common))
    }

    ; GetDeclarationEmitOutputFilePath: the `.d.ts` beside the JS output — under
    ; declarationDir, else outDir, else the source's directory; `.mts` → `.d.mts`,
    ; `.cts` → `.d.cts`, everything else `.d.ts`
    procedure dts_output_path(mutable this, info: ref[SourceFileInfo], mutable options: EmitOptions, cwd: Slice[char], mutable checker: ref[Checker]) returns Slice[char]
    {
        let base_name get_base_file_name(host, normalize_slashes(host, info.file_name))
        let base base_name.subslice(0, remove_file_extension(base_name) as size_t)
        var ext: Slice[char] ".d.ts"
        let fname info.file_name
        if fname.ends_with(".mts") or fname.ends_with(".mjs")
        {
            let dmts: Slice[char] ".d.mts"
            set ext: dmts
        }
        if fname.ends_with(".cts") or fname.ends_with(".cjs")
        {
            let dcts: Slice[char] ".d.cts"
            set ext: dcts
        }
        var dir get_directory_path(host, normalize_slashes(host, info.file_name))
        if options.out_dir.length > 0
            set dir: this.output_directory_of(info, options, options.out_dir, cwd, checker)
        if options.declaration_dir.length > 0
            set dir: this.output_directory_of(info, options, options.declaration_dir, cwd, checker)
        let sb StringBuilder^host()
        sb.append(dir.data, dir.length as size_t)
        if has_trailing_directory_separator(dir) = false
            sb.append("/")
        sb.append(base.data, base.length as size_t)
        sb.append(ext.data, ext.length as size_t)
        Printer.slice_on(host, sb.to_string())
    }

    ; getDeclarationEmitOutputFilePath's NAME rule alone, for the dump's section
    ; header: the program path with its extension replaced
    function dts_name_of(host: ref[Page], program_path: Slice[char]) returns Slice[char]
    {
        let base program_path.subslice(0, remove_file_extension(program_path) as size_t)
        var ext: Slice[char] ".d.ts"
        if program_path.ends_with(".mts") or program_path.ends_with(".mjs")
        {
            let dmts: Slice[char] ".d.mts"
            set ext: dmts
        }
        if program_path.ends_with(".cts") or program_path.ends_with(".cjs")
        {
            let dcts: Slice[char] ".d.cts"
            set ext: dcts
        }
        let sb StringBuilder^host()
        sb.append(base.data, base.length as size_t)
        sb.append(ext.data, ext.length as size_t)
        Printer.slice_on(host, sb.to_string())
    }

    ; getDeclarationDiagnostics for one file (slice 270): the declaration
    ; transformer's reports, appended to `out` as (pos, end, code); false after a
    ; said stop (`unported_count`)
    procedure declaration_diagnostics(mutable this, mutable file: ref[AstNode], mutable info: ref[SourceFileInfo], mutable options: EmitOptions, mutable checker: ref[Checker], mutable binder: ref[Binder], mutable out: ref[Array[int]], mutable out_args: ref[Array[ref[Array[String]]?]], mutable out_related: ref[Array[ref[Array[RelatedInfo]]?]]) returns bool
    {
        let context EmitContext.create(host, AstNode.list_ranges_of(file))
        let opts TransformOptions(context, options, checker, binder, info)
        let tx Transformer.create(host, TransformerTagDeclaration, opts)
        set tx.dt_isolated_declarations: options.isolated_declarations = TristateTrue
        set tx.dt_strip_internal: options.strip_internal = TristateTrue
        let stops_before checker.unported_mark()
        let log_before Checker.stop_count(checker)
        tx.transform_source_file(file)
        Checker.print_new_stops(checker)
        if tx.unported_count > 0
        {
            this.record_unported(tx.unported_tag, tx.unported_detail)
            return false
        }
        if checker.unported_mark() > stops_before
        {
            if Checker.stop_count(checker) > log_before
                this.record_unported(Checker.stop_tag_at(checker, log_before), Checker.stop_detail_at(checker, log_before))
            else
                this.record_unported("dts-checker-stop", checker.unported_mark() - stops_before)
            return false
        }
        var i 0
        while i < tx.dt_diagnostic_count()
        {
            var dp 0
            var de 0
            var dc 0
            tx.dt_diagnostic_at(i, &dp, &de, &dc)
            out.add(dp)
            out.add(de)
            out.add(dc)
            out_args.add(tx.dt_diagnostic_args_at(i))
            out_related.add(tx.dt_diagnostic_related_at(i))
            set i: i + 1
        }
        true
    }

    ; emitDeclarationFile for one file: the declaration transformer, then the
    ; printer under the reference's declaration printer options. The text is
    ; APPENDED to `out` (emit_js's rule about a String's region applies); a
    ; said stop leaves `unported_count` > 0 and appends nothing; a file whose
    ; declaration emit REPORTED is `dts_blocked` and appends nothing either — the
    ; reference writes no .d.ts for it (`declBlocked`).
    procedure emit_dts(mutable this, mutable file: ref[AstNode], mutable info: ref[SourceFileInfo], mutable options: EmitOptions, mutable checker: ref[Checker], mutable binder: ref[Binder], mutable out: ref[StringBuilder])
    {
        set this.dts_blocked: false
        ; sourceFileMayBeEmitted: no declaration for a declaration file, nor for
        ; JSON (the INPUT's flag is the binder's — the info carries the output's)
        if binder.is_declaration_file_of()
            return
        if info.script_kind = ScriptKindJSON
            return
        if (info.script_kind = ScriptKindJS) or (info.script_kind = ScriptKindJSX)
        {
            if options.allow_js <> TristateTrue
                return
        }
        let cwd options.get_current_directory()
        let dts_file_path this.dts_output_path(info, options, cwd, checker)
        let context EmitContext.create(host, AstNode.list_ranges_of(file))
        let opts TransformOptions(context, options, checker, binder, info)
        let tx Transformer.create(host, TransformerTagDeclaration, opts)
        set tx.dt_isolated_declarations: options.isolated_declarations = TristateTrue
        set tx.dt_strip_internal: options.strip_internal = TristateTrue
        let stops_before checker.unported_mark()
        let log_before Checker.stop_count(checker)
        let current tx.transform_source_file(file)
        Checker.print_new_stops(checker)
        if tx.unported_count > 0
        {
            this.record_unported(tx.unported_tag, tx.unported_detail)
            return
        }
        ; a checker stop inside the resolver's answers is this file's stop
        if checker.unported_mark() > stops_before
        {
            ; the checker's own first stop names it (slice 254)
            if Checker.stop_count(checker) > log_before
                this.record_unported(Checker.stop_tag_at(checker, log_before), Checker.stop_detail_at(checker, log_before))
            else
                this.record_unported("dts-checker-stop", checker.unported_mark() - stops_before)
            return
        }
        if (tx.dt_diagnostic_count() > 0) and (forced_dts = false)
        {
            set this.dts_blocked: true
            return
        }
        set info.node: current
        ; the declaration map (slice 254): the map options carry declarationMap as
        ; sourceMap, sourceRoot and mapRoot, and deliberately neither inline option
        let want_maps (options.declaration_map = TristateTrue) and (info.file_name.ends_with(".json") = false) and (forced_dts = false)
        var map_options options
        set map_options.source_map: TristateFalse
        if options.declaration_map = TristateTrue
            set map_options.source_map: TristateTrue
        set map_options.inline_source_map: TristateFalse
        let printer_options PrinterOptions(options.remove_comments, options.new_line, true, options.target, options.declaration_map = TristateTrue, options.inline_source_map = TristateTrue, false, true, true, false, false, false)
        let printer Printer.create(host, printer_options, context)
        set printer.dts_reference_names: this.dts_reference_names(file, info, dts_file_path, checker, cwd)
        let writer TextWriter.create(host, printer_options.new_line_character(), 0)
        var gen: ref[SourceMapGenerator]? null
        if want_maps
            set gen: SourceMapGenerator.create(host, get_base_file_name(host, normalize_slashes(host, dts_file_path)), Emitter.source_root_of(host, map_options), this.source_map_directory(map_options, info, dts_file_path, cwd, checker), cwd)
        printer.write_node(current, info, writer, gen)
        if gen <> null
        {
            let g gen as ref[SourceMapGenerator]
            let url this.source_mapping_url(map_options, info, g, dts_file_path, cwd, checker)
            if url.length > 0
            {
                if writer.is_at_start_of_line() = false
                    writer.raw_write(printer_options.new_line_character())
                set this.url_pos: writer.get_text_pos()
                writer.write_comment("//# sourceMappingURL=")
                writer.write_comment(url)
            }
            ; the declaration map file (declarationMapPath)
            set this.map_text: Printer.slice_on(host, g.to_json())
        }
        else
            writer.write_line()
        if printer.unported_count > 0
        {
            this.record_unported(printer.unported_tag, printer.unported_detail)
            return
        }
        let text writer.to_string()
        ; stringutil.AddUTF8ByteOrderMark under emitBOM, the JS and the declaration file
        if options.emit_bom = TristateTrue
        {
            out.append(0xEF as char)
            out.append(0xBB as char)
            out.append(0xBF as char)
        }
        out.append(text.get_buffer(), text.get_length())
    }

    ; declarations' getReferencedFiles (slice 256): each preserved `path` reference
    ; resolved against its file's directory and named relative to the declaration
    ; output's directory. A reference the program does not hold is skipped (an empty
    ; name). ★A DECLARATION file is named by its own path; a source file would be
    ; named by ITS declaration output, and that half keeps the printer's extension
    ; rule (a sibling's answer) until an outDir case asks for more. Null without a
    ; program: the printer's rule stands.
    procedure dts_reference_names(mutable this, mutable file: ref[AstNode], mutable info: ref[SourceFileInfo], mutable dts_file_path: Slice[char], mutable checker: ref[Checker], mutable cwd: Slice[char]) returns ref[Array[Slice[char]]]?
    {
        let refs AstNode.preserved_references_of(file)
        if refs = null
            return null
        if checker.program = null
            return null
        let pf checker.program as ref[ProgramFiles]
        let names &Array[Slice[char]]^host()
        let out_dir get_directory_path(host, get_normalized_absolute_path(host, normalize_slashes(host, dts_file_path), cwd))
        let src_dir get_directory_path(host, get_normalized_absolute_path(host, info.file_name, cwd))
        let list refs as ref[Array[PreservedReference]]
        var i 0
        while i < (list.get_length() as int)
        {
            let r list[i as size_t]
            set i: i + 1
            if r.kind <> 0
                continue
            let full get_normalized_absolute_path(host, r.name, src_dir)
            if pf.index_of_path(full) < 0
            {
                names.add(Slice[char]())
                continue
            }
            if is_declaration_file_name_of(full)
                names.add(get_relative_path_to_directory_or_url(host, out_dir, full, false, cwd))
            else
                names.add(Printer.declaration_path_name(host, r.name))
        }
        names
    }

    ; getSourceRoot: normalized, with its trailing separator
    function source_root_of(host: ref[Page], options: EmitOptions) returns Slice[char]
    {
        if options.source_root.length = 0
            return Slice[char]()
        ensure_trailing_directory_separator(host, normalize_slashes(host, options.source_root))
    }

    ; getSourceMapDirectory: the common source directory under sourceRoot, mapRoot
    ; resolved against it, else the JS file's own directory
    procedure source_map_directory(mutable this, mutable options: EmitOptions, info: ref[SourceFileInfo], js_file_path: Slice[char], cwd: Slice[char], mutable checker: ref[Checker]) returns Slice[char]
    {
        if options.source_root.length > 0
            return this.program_common_source_directory(options, cwd, checker)
        if options.map_root.length > 0
        {
            let common this.program_common_source_directory(options, cwd, checker)
            ; the maps keep the sources' directory structure below mapRoot
            var source_map_dir get_directory_path(host, Emitter.source_file_path_in_new_dir(host, info.file_name, normalize_slashes(host, options.map_root), cwd, common))
            if get_root_length(source_map_dir) = 0
                set source_map_dir: combine_paths(host, common, source_map_dir)
            return source_map_dir
        }
        get_directory_path(host, get_normalized_absolute_path(host, js_file_path, cwd))
    }

    ; getSourceMappingURL: the data URL inline, else the map's name (through mapRoot)
    procedure source_mapping_url(mutable this, mutable options: EmitOptions, mutable info: ref[SourceFileInfo], mutable gen: ref[SourceMapGenerator], mutable js_file_path: Slice[char], mutable cwd: Slice[char], mutable checker: ref[Checker]) returns Slice[char]
    {
        if options.inline_source_map = TristateTrue
            return Printer.slice_on(host, gen.base64_data_url())
        let base get_base_file_name(host, normalize_slashes(host, js_file_path))
        let sb StringBuilder^host()
        sb.append(base.data, base.length as size_t)
        sb.append(".map")
        let source_map_file Printer.slice_on(host, sb.to_string())
        if options.map_root.length > 0
        {
            let common this.program_common_source_directory(options, cwd, checker)
            var source_map_dir get_directory_path(host, Emitter.source_file_path_in_new_dir(host, info.file_name, normalize_slashes(host, options.map_root), cwd, common))
            if get_root_length(source_map_dir) = 0
            {
                set source_map_dir: combine_paths(host, common, source_map_dir)
                let rel get_relative_path_to_directory_or_url(host, get_directory_path(host, get_normalized_absolute_path(host, js_file_path, cwd)), combine_paths(host, source_map_dir, source_map_file), true, cwd)
                return encode_uri(host, rel)
            }
            return encode_uri(host, combine_paths(host, source_map_dir, source_map_file))
        }
        encode_uri(host, source_map_file)
    }

    ; ast.isFileForcedToBeModuleByFormat under moduleDetection "auto": a file
    ; whose implied node format is ESNext (`.mts`/`.mjs`), or a `.mts`/`.mjs`
    ; file outright, is an external module whatever its statements say. The
    ; parser's `external_module_indicator` reads the statements only; the
    ; emitter's file record ORs this in.

    ; Node.SubtreeFacts(): the cached facts of a node, the Computed marker
    ; stripped
    procedure subtree_facts(mutable n: ref[AstNode]) returns int
    {
        var f n.subtree_facts
        if (f & SubtreeFactsComputed) = 0
        {
            set f: (Emitter.compute_subtree_facts(n) | SubtreeFactsComputed) as u32
            set n.subtree_facts: f
        }
        f & SubtreeFactsAllBits
    }

    function clear_facts(f: int, mask: int) returns int
        f & (SubtreeFactsAllBits xor mask)

    ; propagateSubtreeFacts(child): nil → none; a type-syntax node answers
    ; SubtreeContainsTypeScript whatever it holds; every other kind answers its
    ; facts minus the bits its scope keeps to itself
    procedure sf(mutable c: ref[AstNode]?) returns int
    {
        if c = null
            return SubtreeFactsNone
        Emitter.propagate_subtree_facts(c as ref[AstNode])
    }

    procedure propagate_subtree_facts(mutable n: ref[AstNode]) returns int
    {
        let k n.kind
        if Emitter.is_type_syntax_kind(k)
            return SubtreeContainsTypeScript
        let f Emitter.subtree_facts(n)
        if k = KindCatchClause
            return Emitter.clear_facts(f, SubtreeClearsCatchClause)
        if k = KindVariableDeclarationList
            return Emitter.clear_facts(f, SubtreeClearsVariableDeclarationList)
        if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern)
            return Emitter.clear_facts(f, SubtreeClearsBindingPattern)
        if (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindConstructor)
            return Emitter.clear_facts(f, SubtreeClearsFunction)
        if (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
            return Emitter.clear_facts(f, SubtreeClearsFunction) | Emitter.sf(Printer.declaration_name_of(n))
        if k = KindPropertyDeclaration
            return Emitter.clear_facts(f, SubtreeClearsProperty) | Emitter.sf(Printer.declaration_name_of(n))
        if k = KindModuleDeclaration
            return Emitter.clear_facts(f, SubtreeClearsModule)
        if k = KindObjectLiteralExpression
            return Emitter.clear_facts(f, SubtreeClearsObjectLiteral)
        if k = KindArrowFunction
            return Emitter.clear_facts(f, SubtreeClearsArrowFunction)
        f
    }

    ; propagateNodeListSubtreeFacts(children, propagateSubtreeFacts)
    procedure sfl(mutable list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sf(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    ; propagateEraseableSyntaxSubtreeFacts / propagateEraseableSyntaxListSubtreeFacts
    function sfe(c: ref[AstNode]?) returns int
    {
        if c = null
            return SubtreeFactsNone
        SubtreeContainsTypeScript
    }

    function sfel(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        SubtreeContainsTypeScript
    }

    ; propagateObjectBindingElementSubtreeFacts: a `...rest` inside `{ }` is an
    ; OBJECT rest
    procedure sfobe(mutable c: ref[AstNode]?) returns int
    {
        var facts Emitter.sf(c)
        if (facts & SubtreeContainsRestOrSpread) <> 0
        {
            set facts: Emitter.clear_facts(facts, SubtreeContainsRestOrSpread)
            set facts: facts | SubtreeContainsObjectRestOrSpread | SubtreeContainsESObjectRestOrSpread
        }
        facts
    }

    ; propagateBindingElementSubtreeFacts: an array pattern's rest is cleared
    procedure sfbe(mutable c: ref[AstNode]?) returns int
        Emitter.clear_facts(Emitter.sf(c), SubtreeContainsRestOrSpread)

    procedure sfl_object_binding(mutable list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sfobe(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    procedure sfl_array_binding(mutable list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sfbe(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    ; The kinds whose record embeds TypeSyntaxBase in the reference (every
    ; TypeNodeBase kind, the JSDoc types, the five type elements, the type
    ; parameter, interface, type alias and `export as namespace`): their facts are
    ; SubtreeContainsTypeScript, computed and propagated alike
    function is_type_syntax_kind(k: int) returns bool
    {
        if (k = KindTypeReference) or (k = KindTypeQuery) or (k = KindImportType) or (k = KindFunctionType) or (k = KindConstructorType) or (k = KindUnionType) or (k = KindIntersectionType) or (k = KindConditionalType) or (k = KindTypeOperator) or (k = KindInferType) or (k = KindArrayType) or (k = KindIndexedAccessType) or (k = KindLiteralType) or (k = KindThisType) or (k = KindTypePredicate) or (k = KindMappedType) or (k = KindTypeLiteral) or (k = KindTupleType) or (k = KindNamedTupleMember) or (k = KindOptionalType) or (k = KindRestType) or (k = KindParenthesizedType) or (k = KindTemplateLiteralType) or (k = KindTemplateLiteralTypeSpan)
            return true
        if (k = KindJSDocTypeExpression) or (k = KindJSDocNameReference) or (k = KindJSDocNonNullableType) or (k = KindJSDocNullableType) or (k = KindJSDocAllType) or (k = KindJSDocVariadicType) or (k = KindJSDocOptionalType) or (k = KindJSDocSignature) or (k = KindJSDocTypeLiteral)
            return true
        if (k = KindInterfaceDeclaration) or (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration) or (k = KindNamespaceExportDeclaration) or (k = KindCallSignature) or (k = KindConstructSignature) or (k = KindIndexSignature) or (k = KindMethodSignature) or (k = KindPropertySignature) or (k = KindTypeParameter)
            return true
        false
    }

    ; Token.computeSubtreeFacts
    function token_subtree_facts(k: int) returns int
    {
        if k = KindUsingKeyword
            return SubtreeContainsUsing
        if (k = KindPublicKeyword) or (k = KindPrivateKeyword) or (k = KindProtectedKeyword) or (k = KindReadonlyKeyword) or (k = KindAbstractKeyword) or (k = KindDeclareKeyword) or (k = KindConstKeyword) or (k = KindAnyKeyword) or (k = KindNumberKeyword) or (k = KindBigIntKeyword) or (k = KindNeverKeyword) or (k = KindObjectKeyword) or (k = KindInKeyword) or (k = KindOutKeyword) or (k = KindOverrideKeyword) or (k = KindStringKeyword) or (k = KindBooleanKeyword) or (k = KindSymbolKeyword) or (k = KindVoidKeyword) or (k = KindUnknownKeyword) or (k = KindUndefinedKeyword) or (k = KindExportKeyword)
            return SubtreeContainsTypeScript
        if k = KindAccessorKeyword
            return SubtreeContainsClassFields
        if k = KindAsyncKeyword
            return SubtreeContainsAnyAwait
        if k = KindSuperKeyword
            return SubtreeContainsLexicalSuper
        if k = KindThisKeyword
            return SubtreeContainsLexicalThis
        if (k = KindAsteriskAsteriskToken) or (k = KindAsteriskAsteriskEqualsToken)
            return SubtreeContainsExponentiationOperator
        if k = KindQuestionQuestionToken
            return SubtreeContainsNullishCoalescing
        if k = KindQuestionDotToken
            return SubtreeContainsOptionalChaining
        if (k = KindQuestionQuestionEqualsToken) or (k = KindBarBarEqualsToken) or (k = KindAmpersandAmpersandEqualsToken)
            return SubtreeContainsLogicalAssignments
        ; JsxOpeningFragment / JsxClosingFragment are Token-arm nodes here
        if (k = KindJsxOpeningFragment) or (k = KindJsxClosingFragment)
            return SubtreeContainsJsx
        SubtreeFactsNone
    }

    function async_generator_facts(is_async: bool, is_generator: bool) returns int
    {
        if is_async and is_generator
            return SubtreeContainsForAwaitOrAsyncGenerator
        if is_async
            return SubtreeContainsAnyAwait
        SubtreeFactsNone
    }

    ; the 110 computeSubtreeFacts, by record and — where records are shared —
    ; by kind
    procedure compute_subtree_facts(mutable n: ref[AstNode]) returns int
    {
        let k n.kind
        if Emitter.is_type_syntax_kind(k)
            return SubtreeContainsTypeScript
        choose n.data
            when d: Token
                return Emitter.token_subtree_facts(k)
            when d: Identifier
                return SubtreeContainsIdentifier
            when d: PrivateIdentifier
                return SubtreeContainsClassFields
            when d: NoSubstitutionTemplateLiteral
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateHead
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateMiddle
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateTail
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: SourceFile
                return Emitter.sfl(d.statements)
            when d: Block
                return Emitter.sfl(d.statements)
            when d: ModuleBlock
                return Emitter.sfl(d.statements)
            when d: ExpressionStatement
                return Emitter.sf(d.expression)
            when d: ThrowStatement
                return Emitter.sf(d.expression)
            when d: VariableStatement
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.declaration_list)
            }
            when d: VariableDeclarationList
            {
                var f Emitter.sfl(d.declarations)
                if (n.flags & NodeFlagsUsing) <> 0
                    set f: f | SubtreeContainsUsing
                return f
            }
            when d: VariableDeclaration
                return Emitter.sf(d.name) | Emitter.sfe(d.exclamation_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer)
            when d: IfStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.then_statement) | Emitter.sf(d.else_statement)
            when d: DoStatement
                return Emitter.sf(d.statement) | Emitter.sf(d.expression)
            when d: WhileStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: WithStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: ForStatement
                return Emitter.sf(d.initializer) | Emitter.sf(d.condition) | Emitter.sf(d.incrementor) | Emitter.sf(d.statement)
            when d: ForInStatement
                return Emitter.sf(d.initializer) | Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: ForOfStatement
            {
                var f Emitter.sf(d.initializer) | Emitter.sf(d.expression) | Emitter.sf(d.statement)
                if d.await_modifier <> null
                    set f: f | SubtreeContainsForAwaitOrAsyncGenerator
                return f
            }
            when d: ReturnStatement
                return Emitter.sf(d.expression) | SubtreeContainsForAwaitOrAsyncGenerator
            when d: SwitchStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.case_block)
            when d: CaseBlock
                return Emitter.sfl(d.elements)
            when d: CaseClause
                return Emitter.sf(d.expression) | Emitter.sfl(d.statements)
            when d: DefaultClause
                return Emitter.sf(d.expression) | Emitter.sfl(d.statements)
            when d: TryStatement
                return Emitter.sf(d.try_block) | Emitter.sf(d.catch_clause) | Emitter.sf(d.finally_block)
            when d: CatchClause
            {
                var f Emitter.sf(d.variable_declaration) | Emitter.sf(d.block)
                if d.variable_declaration = null
                    set f: f | SubtreeContainsMissingCatchClauseVariable
                return f
            }
            when d: LabeledStatement
                return Emitter.sf(d.label_name) | Emitter.sf(d.statement)
            when d: ObjectBindingPattern
                return Emitter.sfl_object_binding(d.elements)
            when d: ArrayBindingPattern
                return Emitter.sfl_array_binding(d.elements)
            when d: Parameter
            {
                if AstNode.is_this_identifier(d.name)
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfe(d.question_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer)
            }
            when d: BindingElement
            {
                var f Emitter.sf(d.property_name) | Emitter.sf(d.name) | Emitter.sf(d.initializer)
                if d.dot_dot_dot_token <> null
                    set f: f | SubtreeContainsRestOrSpread
                return f
            }
            when d: FunctionDeclaration
            {
                let flags Transformer.modifier_flags_of(n)
                if (d.body = null) or ((flags & ModifierFlagsAmbient) <> 0)
                    return SubtreeContainsTypeScript
                let is_async (flags & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: ClassDeclaration
                return Emitter.class_like_subtree_facts(n, d.modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: ClassExpression
                return Emitter.class_like_subtree_facts(n, d.modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: HeritageClause
            {
                if d.token = KindExtendsKeyword
                    return Emitter.sfl(d.types)
                if d.token = KindImplementsKeyword
                    return SubtreeContainsTypeScript
                return SubtreeFactsNone
            }
            when d: EnumMember
                return Emitter.sf(d.name) | Emitter.sf(d.initializer) | SubtreeContainsTypeScript
            when d: EnumDeclaration
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfl(d.members) | SubtreeContainsTypeScript
            }
            when d: ModuleDeclaration
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sf(d.body) | SubtreeContainsTypeScript
            }
            when d: ImportEqualsDeclaration
            {
                if d.is_type_only or (d.module_reference.kind <> KindExternalModuleReference)
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sf(d.module_reference)
            }
            when d: ImportSpecifier
            {
                if d.is_type_only
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.property_name) | Emitter.sf(d.name)
            }
            when d: ExportSpecifier
            {
                if d.is_type_only
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.property_name) | Emitter.sf(d.name)
            }
            when d: ImportClause
            {
                if d.phase_modifier = KindTypeKeyword
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.name) | Emitter.sf(d.named_bindings)
            }
            when d: ImportDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.import_clause) | Emitter.sf(d.module_specifier) | Emitter.sf(d.attributes)
            when d: ExportAssignment
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.type_node) | Emitter.sf(d.expression)
                if d.is_export_equals
                    set f: f | SubtreeContainsTypeScript
                return f
            }
            when d: ExportDeclaration
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.export_clause) | Emitter.sf(d.module_specifier) | Emitter.sf(d.attributes)
                if d.is_type_only
                    set f: f | SubtreeContainsTypeScript
                return f
            }
            when d: NamespaceImport
                return Emitter.sf(d.inner)
            when d: NamespaceExport
                return Emitter.sf(d.inner)
            when d: ExternalModuleReference
                return Emitter.sf(d.inner)
            when d: NamedImports
                return Emitter.sfl(d.elements)
            when d: NamedExports
                return Emitter.sfl(d.elements)
            when d: ImportAttribute
                return Emitter.sf(d.name) | Emitter.sf(d.value)
            when d: ImportAttributes
                return Emitter.sfl(d.attributes)
            when d: ConstructorDeclaration
            {
                if d.body = null
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body)
            }
            when d: GetAccessorDeclaration
                return Emitter.accessor_subtree_facts(d.modifiers, d.name, d.type_parameters, d.parameters, d.type_node, d.full_signature, d.body)
            when d: SetAccessorDeclaration
                return Emitter.accessor_subtree_facts(d.modifiers, d.name, d.type_parameters, d.parameters, d.type_node, d.full_signature, d.body)
            when d: MethodDeclaration
            {
                if d.body = null
                    return SubtreeContainsTypeScript
                let is_async (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfe(d.postfix_token) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sf(d.body) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: PropertyDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfe(d.postfix_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer) | SubtreeContainsClassFields
            when d: ClassStaticBlockDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.body) | SubtreeContainsClassFields
            when d: BinaryExpression
            {
                let op d.operator_token.kind
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.left) | Emitter.sf(d.type_node) | Emitter.sf(d.operator_token) | Emitter.sf(d.right)
                if (op = KindInKeyword) and AstNode.is_private_identifier(d.left)
                    set f: f | SubtreeContainsClassFields | SubtreeContainsPrivateIdentifierInExpression
                if op = KindEqualsToken
                {
                    let lk d.left.kind
                    if (lk = KindObjectLiteralExpression) or (lk = KindArrayLiteralExpression)
                    {
                        if Emitter.contains_object_rest_or_spread(d.left)
                            set f: f | SubtreeContainsObjectRestOrSpread
                    }
                }
                return f
            }
            when d: YieldExpression
                return Emitter.sf(d.expression) | SubtreeContainsForAwaitOrAsyncGenerator
            when d: ArrowFunction
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body)
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                    set f: f | SubtreeContainsAnyAwait
                return f
            }
            when d: FunctionExpression
            {
                let is_async (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: AsExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: SatisfiesExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: TypeAssertionExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: NonNullExpression
                return Emitter.sf(d.inner) | SubtreeContainsTypeScript
            when d: PropertyAccessExpression
            {
                var f Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sf(d.name)
                if AstNode.kind_of(d.name) <> KindIdentifier
                    set f: f | SubtreeContainsPrivateIdentifierInExpression
                return f
            }
            when d: ElementAccessExpression
                return Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sf(d.argument_expression)
            when d: CallExpression
            {
                var f Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sfel(d.type_arguments) | Emitter.sfl(d.arguments)
                if AstNode.kind_of(d.expression) = KindImportKeyword
                    set f: f | SubtreeContainsDynamicImport
                return f
            }
            when d: NewExpression
                return Emitter.sf(d.expression) | Emitter.sfel(d.type_arguments) | Emitter.sfl(d.arguments)
            when d: MetaProperty
                return Emitter.clear_facts(Emitter.sf(d.name), SubtreeContainsIdentifier)
            when d: SpreadElement
                return Emitter.sf(d.inner) | SubtreeContainsRestOrSpread
            when d: TaggedTemplateExpression
                return Emitter.sf(d.tag) | Emitter.sf(d.question_dot_token) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.template)
            when d: ArrayLiteralExpression
                return Emitter.sfl(d.elements)
            when d: ObjectLiteralExpression
                return Emitter.sfl(d.elements)
            when d: SpreadAssignment
                return Emitter.sf(d.inner) | SubtreeContainsESObjectRestOrSpread | SubtreeContainsObjectRestOrSpread
            when d: PropertyAssignment
                return Emitter.sf(d.name) | Emitter.sf(d.type_node) | Emitter.sf(d.initializer)
            when d: ShorthandPropertyAssignment
                return Emitter.sf(d.name) | Emitter.sf(d.type_node) | Emitter.sf(d.object_assignment_initializer) | SubtreeContainsTypeScript
            when d: AwaitExpression
                return Emitter.sf(d.inner) | SubtreeContainsAwait | SubtreeContainsAnyAwait | SubtreeContainsForAwaitOrAsyncGenerator
            when d: DeleteExpression
                return Emitter.sf(d.inner)
            when d: TypeOfExpression
                return Emitter.sf(d.inner)
            when d: VoidExpression
                return Emitter.sf(d.inner)
            when d: ParenthesizedExpression
                return Emitter.sf(d.inner)
            when d: PartiallyEmittedExpression
                return Emitter.sf(d.inner)
            when d: ComputedPropertyName
                return Emitter.sf(d.inner)
            when d: PrefixUnaryExpression
                return Emitter.sf(d.operand)
            when d: PostfixUnaryExpression
                return Emitter.sf(d.operand)
            when d: ConditionalExpression
                return Emitter.sf(d.condition) | Emitter.sf(d.question_token) | Emitter.sf(d.when_true) | Emitter.sf(d.colon_token) | Emitter.sf(d.when_false)
            when d: TemplateExpression
                return Emitter.sf(d.head) | Emitter.sfl(d.template_spans)
            when d: TaggedTemplateExpression
                return Emitter.sf(d.tag) | Emitter.sf(d.question_dot_token) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.template)
            when d: TemplateSpan
                return Emitter.sf(d.expression) | Emitter.sf(d.literal)
            when d: ExpressionWithTypeArguments
                return Emitter.sf(d.expression) | Emitter.sfel(d.type_arguments)
            when d: QualifiedName
                return Emitter.sf(d.left) | Emitter.sf(d.right)
            when d: SyntheticReferenceExpression
                return Emitter.sf(d.expression) | Emitter.sf(d.this_arg)
            when d: Decorator
                return Emitter.sf(d.inner) | SubtreeContainsTypeScript | SubtreeContainsDecorators
            when d: JsxElement
                return Emitter.sf(d.opening_element) | Emitter.sfl(d.children) | Emitter.sf(d.closing_element) | SubtreeContainsJsx
            when d: JsxAttributes
                return Emitter.sfl(d.elements) | SubtreeContainsJsx
            when d: JsxNamespacedName
                return Emitter.sf(d.namespace_name) | Emitter.sf(d.name) | SubtreeContainsJsx
            when d: JsxOpeningElement
                return Emitter.sf(d.tag_name) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.attributes) | SubtreeContainsJsx
            when d: JsxSelfClosingElement
                return Emitter.sf(d.tag_name) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.attributes) | SubtreeContainsJsx
            when d: JsxFragment
                return Emitter.sfl(d.children) | SubtreeContainsJsx
            when d: JsxAttribute
                return Emitter.sf(d.name) | Emitter.sf(d.initializer) | SubtreeContainsJsx
            when d: JsxSpreadAttribute
                return Emitter.sf(d.inner) | SubtreeContainsJsx
            when d: JsxClosingElement
                return Emitter.sf(d.inner) | SubtreeContainsJsx
            when d: JsxExpression
                return Emitter.sf(d.expression) | SubtreeContainsJsx
            when d: JsxText
                return SubtreeContainsJsx
            else
                return SubtreeFactsNone
        SubtreeFactsNone
    }

    ; ClassLikeBase.computeSubtreeFacts
    procedure class_like_subtree_facts(n: ref[AstNode], mutable modifiers: ref[Array[ref[AstNode]?]]?, mutable name: ref[AstNode]?, type_parameters: ref[Array[ref[AstNode]?]]?, mutable heritage_clauses: ref[Array[ref[AstNode]?]]?, mutable members: ref[Array[ref[AstNode]?]]?) returns int
    {
        if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
            return SubtreeContainsTypeScript
        Emitter.sfl(modifiers) | Emitter.sf(name) | Emitter.sfel(type_parameters) | Emitter.sfl(heritage_clauses) | Emitter.sfl(members)
    }

    ; AccessorDeclarationBase.computeSubtreeFacts
    procedure accessor_subtree_facts(mutable modifiers: ref[Array[ref[AstNode]?]]?, mutable name: ref[AstNode]?, type_parameters: ref[Array[ref[AstNode]?]]?, mutable parameters: ref[Array[ref[AstNode]?]]?, type_node: ref[AstNode]?, full_signature: ref[AstNode]?, mutable body: ref[AstNode]?) returns int
    {
        if body = null
            return SubtreeContainsTypeScript
        Emitter.sfl(modifiers) | Emitter.sf(name) | Emitter.sfel(type_parameters) | Emitter.sfl(parameters) | Emitter.sfe(type_node) | Emitter.sfe(full_signature) | Emitter.sf(body)
    }

    ; ── ast/utilities.go: the binding-pattern questions the facts ask ──

    ; IsAssignmentPattern
    function is_assignment_pattern(n: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(n)
        (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression)
    }

    ; GetElementsOfBindingOrAssignmentPattern
    function elements_of_binding_or_assignment_pattern(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let k n.kind
        if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern) or (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression)
            return Emitter.pattern_elements_of(n)
        null
    }

    ; the ElementListData arms a binding or assignment pattern can be
    function pattern_elements_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when d: ObjectBindingPattern
                return d.elements
            when d: ArrayBindingPattern
                return d.elements
            when d: ArrayLiteralExpression
                return d.elements
            when d: ObjectLiteralExpression
                return d.elements
        null
    }

    ; IsDeclarationBindingElement
    function is_declaration_binding_element(n: ref[AstNode]) returns bool
    {
        let k n.kind
        (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement)
    }

    ; IsObjectLiteralElement
    function is_object_literal_element(n: ref[AstNode]) returns bool
    {
        let k n.kind
        (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment) or (k = KindSpreadAssignment) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
    }

    ; GetTargetOfBindingOrAssignmentElement
    function target_of_binding_or_assignment_element(n: ref[AstNode]?) returns ref[AstNode]?
    {
        if n = null
            return null
        let e n as ref[AstNode]
        if Emitter.is_declaration_binding_element(e)
            return Printer.declaration_name_of(e)
        if Emitter.is_object_literal_element(e)
        {
            let k e.kind
            if k = KindPropertyAssignment
                return Emitter.target_of_binding_or_assignment_element(AstNode.initializer_of(e))
            if k = KindShorthandPropertyAssignment
                return Printer.declaration_name_of(e)
            if k = KindSpreadAssignment
                return Emitter.target_of_binding_or_assignment_element(AstNode.expression_of(e))
            return null
        }
        if Emitter.is_assignment_expression(e, true)
            return Emitter.target_of_binding_or_assignment_element(AstNode.binary_left_of(e))
        if e.kind = KindSpreadElement
            return Emitter.target_of_binding_or_assignment_element(AstNode.expression_of(e))
        e
    }

    ; IsAssignmentExpression(node, excludeCompoundAssignment)
    function is_assignment_expression(n: ref[AstNode], exclude_compound: bool) returns bool
    {
        if n.kind <> KindBinaryExpression
            return false
        let op AstNode.kind_of(AstNode.binary_operator_token_of(n))
        if exclude_compound
        {
            if op <> KindEqualsToken
                return false
        }
        if exclude_compound = false
        {
            if Parser.is_assignment_operator(op) = false
                return false
        }
        ; ast.IsLeftHandSideExpression skips partially emitted expressions first: an
        ; erased `(x as T) = v` is still an assignment (slice 257)
        Parser.is_left_hand_side_expression_kind(AstNode.kind_of(Parser.skip_outer_expressions(AstNode.binary_left_of(n), OEKPartiallyEmittedExpressions)))
    }

    ; ContainsObjectRestOrSpread
    procedure contains_object_rest_or_spread(mutable n: ref[AstNode]) returns bool
    {
        if (Emitter.subtree_facts(n) & SubtreeContainsObjectRestOrSpread) <> 0
            return true
        if (Emitter.subtree_facts(n) & SubtreeContainsESObjectRestOrSpread) <> 0
        {
            ; check for nested spread assignments, otherwise '{ x: { a, ...b } = foo } = c'
            ; will not be correctly interpreted by the rest/spread transformer
            let elements Emitter.elements_of_binding_or_assignment_pattern(n)
            if elements = null
                return false
            let l elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (l.get_length() as int)
            {
                let target Emitter.target_of_binding_or_assignment_element(l[i as size_t])
                set i: i + 1
                if target = null
                    continue
                let t target as ref[AstNode]
                if Emitter.is_assignment_pattern(t) = false
                    continue
                if (Emitter.subtree_facts(t) & SubtreeContainsObjectRestOrSpread) <> 0
                    return true
                if (Emitter.subtree_facts(t) & SubtreeContainsESObjectRestOrSpread) <> 0
                {
                    if Emitter.contains_object_rest_or_spread(t)
                        return true
                }
            }
        }
        false
    }

    ; internal/vfs/internal/internal.go decodeBytes + decodeUtf16: the compiler
    ; host reads a source file THROUGH this — a UTF-16 file (either byte order
    ; mark) is transcoded to UTF-8 and a UTF-8 mark is dropped — while the
    ; yardstick oracles read the raw bytes (os.ReadFile). The emit baseline is
    ; the decoded file's, so the emit path decodes and the other six do not;
    ; tscaly_dump re-parses the decoded text for the emit alone. Answers true
    ; when `out` holds a DIFFERENT text than `text` (a mark was found).
    procedure decode_bytes(text: Slice[char], mutable out: ref[StringBuilder]) returns bool
    {
        let n text.length
        if n >= 2
        {
            let b0 text[0] as int
            let b1 text[1] as int
            if (b0 = 0xFF) and (b1 = 0xFE)
            {
                Emitter.decode_utf16(text, 2, true, out)
                return true
            }
            if (b0 = 0xFE) and (b1 = 0xFF)
            {
                Emitter.decode_utf16(text, 2, false, out)
                return true
            }
        }
        if n >= 3
        {
            if ((text[0] as int) = 0xEF) and ((text[1] as int) = 0xBB) and ((text[2] as int) = 0xBF)
            {
                out.append(text.data + 3, (n - 3) as size_t)
                return true
            }
        }
        false
    }

    ; decodeUtf16: the code units in the given byte order (an odd trailing byte
    ; is dropped, as binary.Read's len/2 does), unicode/utf16.Decode's pairing
    ; (an unpaired surrogate becomes U+FFFD), then UTF-8.
    procedure decode_utf16(text: Slice[char], start: int, little_endian: bool, mutable out: ref[StringBuilder])
    {
        let units (text.length - start) / 2
        var i 0
        while i < units
        {
            var u Emitter.utf16_unit_at(text, start + i * 2, little_endian)
            set i: i + 1
            var cp u
            if (u >= 0xD800) and (u < 0xDC00)
            {
                set cp: 0xFFFD
                if i < units
                {
                    let lo Emitter.utf16_unit_at(text, start + i * 2, little_endian)
                    if (lo >= 0xDC00) and (lo < 0xE000)
                    {
                        set cp: 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00)
                        set i: i + 1
                    }
                }
            }
            if (u >= 0xDC00) and (u < 0xE000)
                set cp: 0xFFFD
            Emitter.append_utf8(out, cp)
        }
    }

    function utf16_unit_at(text: Slice[char], at: int, little_endian: bool) returns int
    {
        let a text[at] as int
        let b text[at + 1] as int
        if little_endian
            return (a & 0xFF) | ((b & 0xFF) << 8)
        ((a & 0xFF) << 8) | (b & 0xFF)
    }

    procedure append_utf8(mutable out: ref[StringBuilder], cp: int)
    {
        if cp < 0x80
        {
            out.append(cp as char)
            return
        }
        if cp < 0x800
        {
            out.append((0xC0 | (cp >> 6)) as char)
            out.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        if cp < 0x10000
        {
            out.append((0xE0 | (cp >> 12)) as char)
            out.append((0x80 | ((cp >> 6) & 0x3F)) as char)
            out.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        out.append((0xF0 | (cp >> 18)) as char)
        out.append((0x80 | ((cp >> 12) & 0x3F)) as char)
        out.append((0x80 | ((cp >> 6) & 0x3F)) as char)
        out.append((0x80 | (cp & 0x3F)) as char)
    }

    function is_file_forced_to_be_module_by_format(file_name: Slice[char], options: EmitOptions) returns bool
    {
        ; a declaration file still needs an explicit `export {}` (the caller's
        ; IsDeclarationFileName guard in ast/parseoptions.go)
        if file_name.ends_with(".d.ts") or file_name.ends_with(".d.mts") or file_name.ends_with(".d.cts")
            return false
        ; getExternalModuleIndicator's first arm: a JSON file is never a module (slice 257)
        if file_name.ends_with(".json")
            return false
        ; moduleDetection force: every non-declaration file is a module
        if options.get_module_detection_kind() = ModuleDetectionKindForce
            return true
        if options.get_module_detection_kind() = ModuleDetectionKindLegacy
            return false
        ; GetImpliedNodeFormatForEmitWorker answers ESNext only for an .mjs/.mts file
        ; (or a package.json `type: module`, which no case here carries) — the module
        ; KIND alone forces nothing (§3.5jp)
        file_name.ends_with(".mts") or file_name.ends_with(".mjs") or file_name.ends_with(".cts") or file_name.ends_with(".cjs")
    }

    ; the file's identifier table (sourceFile.Identifiers): every Identifier and
    ; PrivateIdentifier text in the tree, once
    ; ast.isFileModuleFromUsingJSXTag (moduleDetection auto): a JSX file whose
    ; tags the automatic runtime rewrites is a module — the runtime import needs one
    procedure is_file_module_from_using_jsx_tag(mutable file: ref[AstNode], script_kind: int, options: EmitOptions) returns bool
    {
        if options.get_module_detection_kind() <> ModuleDetectionKindAuto
            return false
        if (script_kind <> ScriptKindTSX) and (script_kind <> ScriptKindJSX)
            return false
        if (options.jsx <> JsxEmitReactJSX) and (options.jsx <> JsxEmitReactJSXDev)
            return false
        (Emitter.subtree_facts(file) & SubtreeContainsJsx) <> 0
    }

    ; the case harness roots every unit at `/.src/<unit>` (its `_jsxFileName`,
    ; its `import.meta` paths); a batch path `/cases/<case>/<cfg>/u<i>/<unit>` maps
    ; back to that, any other path stands
    function harness_file_name(host: ref[Page], path: Slice[char]) returns Slice[char]
    {
        if path.starts_with("/cases/") = false
            return path
        let n path.length as int
        var i 0
        while i < n
        {
            ; the `/u<digits>/` segment
            if ((path[i as size_t] as int) = ("/" as char) as int) and ((i + 2) < n) and ((path[(i + 1) as size_t] as int) = ("u" as char) as int)
            {
                var j i + 2
                while (j < n) and ((path[j as size_t] as int) >= ("0" as char) as int) and ((path[j as size_t] as int) <= ("9" as char) as int)
                    set j: j + 1
                if (j > (i + 2)) and (j < n) and ((path[j as size_t] as int) = ("/" as char) as int)
                {
                    let tail path.subslice((j + 1) as size_t, n as size_t)
                    ; an absolute unit name (`/test.tsx`) stands as given
                    if tail.starts_with("/")
                        return tail
                    let sb StringBuilder^host()
                    sb.append("/.src/")
                    sb.append(tail.data, tail.length as size_t)
                    return Printer.slice_on(host, sb.to_string())
                }
            }
            set i: i + 1
        }
        path
    }

    ; file.Identifiers, in first-seen order; the set is a map upstream, so the
    ; duplicate test walks the rows of one hash and not the whole list
    procedure collect_identifiers(host: ref[Page], node: ref[AstNode], mutable out: ref[Array[Slice[char]]])
    {
        let seen HashChain.create(host)
        var i 0
        while i < (out.get_length() as int)
        {
            seen.add(ProgramFiles.fold_hash(out[i as size_t]))
            set i: i + 1
        }
        Emitter.collect_identifiers_into(node, out, seen)
    }

    procedure collect_identifiers_into(node: ref[AstNode], mutable out: ref[Array[Slice[char]]], mutable seen: ref[HashChain])
    {
        let k node.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
        {
            let text AstNode.identifier_text_of(node)
            let h ProgramFiles.fold_hash(text)
            var known false
            var r seen.first(h)
            while r >= 0
            {
                if out[r as size_t] = text
                {
                    set known: true
                    break
                }
                set r: seen.after(r)
            }
            if known = false
            {
                seen.add(h)
                out.add(text)
            }
        }
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            Emitter.collect_identifiers_into(child as ref[AstNode], out, seen)
            set i: i + 1
        }
    }

    procedure scan(this, mutable node: ref[AstNode], mutable checker: ref[Checker], mutable facts: ref[EmitFacts])
    {
        let k node.kind
        if (k = KindImportDeclaration) or (k = KindExportDeclaration) or (k = KindExportAssignment) or (k = KindNamespaceExportDeclaration) or (k = KindImportEqualsDeclaration)
            set facts.has_import_or_export: true
        if k = KindEnumDeclaration
            set facts.has_runtime_syntax: true
        ; an INTERNAL `import x = N.M` (an entity-name reference) is rewritten to
        ; `var x = N.M` by runtimesyntax.go's visitImportEqualsDeclaration
        if k = KindImportEqualsDeclaration
        {
            if AstNode.kind_of(AstNode.module_reference_of(node)) <> KindExternalModuleReference
                set facts.has_runtime_syntax: true
        }
        if k = KindModuleDeclaration
        {
            ; the eraser drops a non-instantiated one itself; an instantiated one
            ; is the runtime-syntax transformer's
            if checker.is_instantiated_module(node)
                set facts.has_runtime_syntax: true
        }
        if k = KindParameter
        {
            if Transformer.is_parameter_property_declaration(node, node.parent)
                set facts.has_runtime_syntax: true
        }
        if k = KindDecorator
            set facts.has_decorator: true
        if k = KindVariableDeclarationList
        {
            if (node.flags & NodeFlagsUsing) <> 0
                set facts.has_using: true
        }
        if k = KindAccessorKeyword
            set facts.has_auto_accessor: true
        if k = KindCallExpression
        {
            if Parser.is_import_call(node)
                set facts.has_dynamic_import: true
        }
        if k = KindMetaProperty
        {
            if AstNode.meta_property_keyword_token_of(node) = KindImportKeyword
                set facts.has_dynamic_import: true
        }
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            this.scan(child as ref[AstNode], checker, facts)
            set i: i + 1
        }
    }

    ; emitJSFile for one file under the default options: the transformers in
    ; getScriptTransformers' order, then the printer. The JS text is APPENDED to
    ; `out`, the caller's builder; a said stop leaves `unported_count` > 0 and
    ; appends nothing. ★Neither a returned nor a stored String survives this
    ; routine: `to_string()` constructs on the CALLER page, which for a call
    ; made here is this routine's own region — gone with the return, and the
    ; text read back as garbage three units in (root CLAUDE.md, the out-param
    ; class). The bytes are copied out while the region lives.
    procedure emit_js(mutable this, mutable file: ref[AstNode], mutable info: ref[SourceFileInfo], mutable options: EmitOptions, mutable checker: ref[Checker], mutable binder: ref[Binder], mutable out: ref[StringBuilder])
    {
        ; sourceFileMayBeEmitted: no JS for a declaration file, nor for JSON
        ; without an outDir
        if info.is_declaration_file
            return
        if info.script_kind = ScriptKindJSON
        {
            if options.out_dir.length = 0
                return
        }
        ; a JavaScript file is not in the program without allowJs (the yardstick's
        ; default options), so the reference emits nothing for it: 158 `.js`,
        ; 4 `.jsx` and 2 `.cjs` units of the corpus, every reference answer empty
        if (info.script_kind = ScriptKindJS) or (info.script_kind = ScriptKindJSX)
        {
            if options.allow_js <> TristateTrue
                return
        }
        var facts EmitFacts(false, false, false, false, false, false)
        this.scan(file, checker, &facts)
        ; getScriptTransformers, each gate a transformer not yet ported
        let import_elision_enabled (options.verbatim_module_syntax <> TristateTrue) and ((file.flags & NodeFlagsJavaScriptFile) = 0)
        ; estransforms.GetESTransformer at the default target: using, ES decorators, class fields
        ; below ES2015 (the TS7-removed ES5) the chain transforms maximally, as at ES2015
        let target options.get_emit_script_target()
        let module_kind options.get_emit_module_kind()
        let format options.get_emit_module_format_of_file(info.file_name)
        ; getModuleTransformer: ES2015..NodeNext → the implied module transformer,
        ; Preserve → ESM, System → its own transformer, the rest → CommonJS
        if module_kind = ModuleKindSystem
            this.record_unported("transform-system", module_kind)
        if unported_count > 0
            return
        let context EmitContext.create(host, AstNode.list_ranges_of(file))
        let opts TransformOptions(context, options, checker, binder, info)
        var current file
        ; use type nodes to add metadata decorators
        let metadata_tx Transformer.create(host, TransformerTagMetadata, opts)
        if options.emit_decorator_metadata = TristateTrue
        {
            set metadata_tx.md_strict_null_checks: options.get_strict_option_value(options.strict_null_checks)
            set current: metadata_tx.transform_source_file(current)
        }
        let eraser Transformer.create(host, TransformerTagTypeEraser, opts)
        set current: eraser.transform_source_file(current)
        let elision Transformer.create(host, TransformerTagImportElision, opts)
        if import_elision_enabled
            set current: elision.transform_source_file(current)
        ; transform `enum`, `namespace`, and parameter properties
        let runtime Transformer.create(host, TransformerTagRuntimeSyntax, opts)
        set current: runtime.transform_source_file(current)
        let legacy_tx Transformer.create(host, TransformerTagLegacyDecorators, opts)
        if options.experimental_decorators = TristateTrue
            set current: legacy_tx.transform_source_file(current)
        ; jsxtransforms: a file of the JSX language variant (a `.js` file is one, slice
        ; 255) under a transforming `jsx` option
        let jsx_tx Transformer.create(host, TransformerTagJsx, opts)
        if options.get_jsx_transform_enabled() and language_variant_is_jsx(info.script_kind)
            set current: jsx_tx.transform_source_file(current)
        ; estransforms.GetESTransformer: at ESNext only ES decorators and class
        ; fields; from ES2025 down (NewESNextTransformer) `using` runs first
        let using_tx Transformer.create(host, TransformerTagUsing, opts)
        if target < ScriptTargetLatest
            set current: using_tx.transform_source_file(current)
        ; newESDecoratorTransformer: nothing to do under experimentalDecorators or
        ; at ESNext with useDefineForClassFields
        let es_decorators Transformer.create(host, TransformerTagESDecorator, opts)
        if (options.experimental_decorators <> TristateTrue) and ((target < ScriptTargetLatest) or (options.get_use_define_for_class_fields() = false))
            set current: es_decorators.transform_source_file(current)
        ; newClassFieldsTransformer: nothing at ESNext with useDefineForClassFields
        let class_fields Transformer.create(host, TransformerTagClassFields, opts)
        if (target < ScriptTargetLatest) or (options.get_use_define_for_class_fields() = false)
        {
            class_fields.cf_configure()
            set current: class_fields.transform_source_file(current)
        }
        ; the rest of GetESTransformer's chains, one transformer per target step
        let logical_tx Transformer.create(host, TransformerTagLogicalAssignment, opts)
        if target < ScriptTargetES2021
            set current: logical_tx.transform_source_file(current)
        let nullish_tx Transformer.create(host, TransformerTagNullishCoalescing, opts)
        let chain_tx Transformer.create(host, TransformerTagOptionalChain, opts)
        if target < ScriptTargetES2020
        {
            set current: nullish_tx.transform_source_file(current)
            set current: chain_tx.transform_source_file(current)
        }
        let catch_tx Transformer.create(host, TransformerTagOptionalCatch, opts)
        if target < ScriptTargetES2019
            set current: catch_tx.transform_source_file(current)
        let ors_tx Transformer.create(host, TransformerTagObjectRestSpread, opts)
        let forawait_tx Transformer.create(host, TransformerTagForAwait, opts)
        let tagged_tx Transformer.create(host, TransformerTagTaggedTemplate, opts)
        if target < ScriptTargetES2018
        {
            set current: ors_tx.transform_source_file(current)
            set current: forawait_tx.transform_source_file(current)
            set current: tagged_tx.transform_source_file(current)
        }
        let async_tx Transformer.create(host, TransformerTagAsync, opts)
        if target < ScriptTargetES2017
            set current: async_tx.transform_source_file(current)
        let exp_tx Transformer.create(host, TransformerTagExponentiation, opts)
        if target < ScriptTargetES2016
            set current: exp_tx.transform_source_file(current)
        let use_strict Transformer.create(host, TransformerTagUseStrict, opts)
        set current: use_strict.transform_source_file(current)
        ; the implied module transformer: ESM by the file's format, else CommonJS
        ; (moduletransforms/impliedmodule.go; ES2015..NodeNext, Preserve → ESM)
        var module_tag TransformerTagESModule
        if format < ModuleKindES2015
            set module_tag: TransformerTagCommonJS
        ; getModuleTransformer: `--module preserve` is the ES module transformer for
        ; EVERY file, a `.cts` included (its CommonJS format decides nothing here)
        if module_kind = ModuleKindPreserve
            set module_tag: TransformerTagESModule
        let es_module Transformer.create(host, module_tag, opts)
        set current: es_module.transform_source_file(current)
        ; inlining (formerly done via substitutions)
        let inliner Transformer.create(host, TransformerTagConstEnumInlining, opts)
        if options.get_isolated_modules() = false
            set current: inliner.transform_source_file(current)
        if metadata_tx.unported_count > 0
            this.record_unported(metadata_tx.unported_tag, metadata_tx.unported_detail)
        if eraser.unported_count > 0
            this.record_unported(eraser.unported_tag, eraser.unported_detail)
        if legacy_tx.unported_count > 0
            this.record_unported(legacy_tx.unported_tag, legacy_tx.unported_detail)
        if jsx_tx.unported_count > 0
            this.record_unported(jsx_tx.unported_tag, jsx_tx.unported_detail)
        if elision.unported_count > 0
            this.record_unported(elision.unported_tag, elision.unported_detail)
        if runtime.unported_count > 0
            this.record_unported(runtime.unported_tag, runtime.unported_detail)
        if using_tx.unported_count > 0
            this.record_unported(using_tx.unported_tag, using_tx.unported_detail)
        if es_decorators.unported_count > 0
            this.record_unported(es_decorators.unported_tag, es_decorators.unported_detail)
        if class_fields.unported_count > 0
            this.record_unported(class_fields.unported_tag, class_fields.unported_detail)
        if logical_tx.unported_count > 0
            this.record_unported(logical_tx.unported_tag, logical_tx.unported_detail)
        if nullish_tx.unported_count > 0
            this.record_unported(nullish_tx.unported_tag, nullish_tx.unported_detail)
        if chain_tx.unported_count > 0
            this.record_unported(chain_tx.unported_tag, chain_tx.unported_detail)
        if catch_tx.unported_count > 0
            this.record_unported(catch_tx.unported_tag, catch_tx.unported_detail)
        if ors_tx.unported_count > 0
            this.record_unported(ors_tx.unported_tag, ors_tx.unported_detail)
        if forawait_tx.unported_count > 0
            this.record_unported(forawait_tx.unported_tag, forawait_tx.unported_detail)
        if tagged_tx.unported_count > 0
            this.record_unported(tagged_tx.unported_tag, tagged_tx.unported_detail)
        if async_tx.unported_count > 0
            this.record_unported(async_tx.unported_tag, async_tx.unported_detail)
        if exp_tx.unported_count > 0
            this.record_unported(exp_tx.unported_tag, exp_tx.unported_detail)
        if use_strict.unported_count > 0
            this.record_unported(use_strict.unported_tag, use_strict.unported_detail)
        if es_module.unported_count > 0
            this.record_unported(es_module.unported_tag, es_module.unported_detail)
        if inliner.unported_count > 0
            this.record_unported(inliner.unported_tag, inliner.unported_detail)
        if unported_count > 0
            return
        ; the printer, over the TRANSFORMED file (its record's node is the one it prints)
        set info.node: current
        ; printSourceFile: the JS path (the harness roots the unit at `/.src/`, an
        ; outDir below it), the generator when maps are asked for, the URL comment
        let cwd options.get_current_directory()
        let js_file_path this.js_output_path(info, options, cwd, checker)
        let want_maps ((options.source_map = TristateTrue) or (options.inline_source_map = TristateTrue)) and (info.file_name.ends_with(".json") = false)
        let printer_options PrinterOptions(options.remove_comments, options.new_line, options.no_emit_helpers, options.target, options.source_map = TristateTrue, options.inline_source_map = TristateTrue, options.inline_sources = TristateTrue, false, false, false, false, false)
        let printer Printer.create(host, printer_options, context)
        let writer TextWriter.create(host, printer_options.new_line_character(), 0)
        var gen: ref[SourceMapGenerator]? null
        if want_maps
            set gen: SourceMapGenerator.create(host, get_base_file_name(host, normalize_slashes(host, js_file_path)), Emitter.source_root_of(host, options), this.source_map_directory(options, info, js_file_path, cwd, checker), cwd)
        printer.write_node(current, info, writer, gen)
        if gen <> null
        {
            let g gen as ref[SourceMapGenerator]
            let url this.source_mapping_url(options, info, g, js_file_path, cwd, checker)
            if url.length > 0
            {
                if writer.is_at_start_of_line() = false
                    writer.raw_write(printer_options.new_line_character())
                set this.url_pos: writer.get_text_pos()
                writer.write_comment("//# sourceMappingURL=")
                writer.write_comment(url)
            }
            ; the source map file (SourceMapFilePath: not for an inline map)
            if (options.source_map = TristateTrue) and (options.inline_source_map <> TristateTrue)
                set this.map_text: Printer.slice_on(host, g.to_json())
        }
        else
            writer.write_line()
        if printer.unported_count > 0
        {
            this.record_unported(printer.unported_tag, printer.unported_detail)
            return
        }
        let text writer.to_string()
        ; stringutil.AddUTF8ByteOrderMark under emitBOM, the JS and the declaration file
        if options.emit_bom = TristateTrue
        {
            out.append(0xEF as char)
            out.append(0xBB as char)
            out.append(0xBF as char)
        }
        out.append(text.get_buffer(), text.get_length())
    }
}
