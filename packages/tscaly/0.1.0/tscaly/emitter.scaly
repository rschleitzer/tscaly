    ; getVariableDeclarationTypeVisibilityDiagnosticMessage: 0 for a kind the
    ; reference answers nil for (a silent state it carries from Strada)
    function dt_variable_declaration_type_visibility_code(node: ref[AstNode], result: SymbolAccessibilityResult) returns int
    {
        let k node.kind
        if (k = KindVariableDeclaration) or (k = KindBindingElement)
            return Transformer.dt_select_by_module_name(result, DiagExported_variable_0_has_or_is_using_name_1_from_external_module_2_but_cannot_be_named, DiagExported_variable_0_has_or_is_using_name_1_from_private_module_2, DiagExported_variable_0_has_or_is_using_private_name_1)
        var property_like false
        if k = KindPropertyDeclaration
            set property_like: true
        if k = KindPropertyAccessExpression
            set property_like: true
        if k = KindElementAccessExpression
            set property_like: true
        if k = KindBinaryExpression
            set property_like: true
        if k = KindPropertySignature
            set property_like: true
        ; a constructor parameter property is reported at the parameter, unless
        ; the constructor is private and its parameters are not emitted at all
        if k = KindParameter
        {
            if Transformer.has_syntactic_modifier(AstNode.parent_node_of(node), ModifierFlagsPrivate)
                set property_like: true
        }
        if property_like
        {
            if Transformer.is_static_member(node)
                return Transformer.dt_select_by_module_name(result, DiagPublic_static_property_0_of_exported_class_has_or_is_using_name_1_from_external_module_2_but_cannot_be_named, DiagPublic_static_property_0_of_exported_class_has_or_is_using_name_1_from_private_module_2, DiagPublic_static_property_0_of_exported_class_has_or_is_using_private_name_1)
            if (AstNode.kind_of(AstNode.parent_node_of(node)) = KindClassDeclaration) or (k = KindParameter)
                return Transformer.dt_select_by_module_name(result, DiagPublic_property_0_of_exported_class_has_or_is_using_name_1_from_external_module_2_but_cannot_be_named, DiagPublic_property_0_of_exported_class_has_or_is_using_name_1_from_private_module_2, DiagPublic_property_0_of_exported_class_has_or_is_using_private_name_1)
            ; interfaces cannot have types that cannot be named
            return Transformer.dt_select_by_module_name_no_name_check(result, DiagProperty_0_of_exported_interface_has_or_is_using_name_1_from_private_module_2, DiagProperty_0_of_exported_interface_has_or_is_using_private_name_1)
        }
        0
    }

