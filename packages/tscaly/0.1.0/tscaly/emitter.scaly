        if pk = KindMappedType
            return DiagType_parameter_0_of_exported_mapped_object_type_is_using_private_name_1
        if (pk = KindConstructorType) or (pk = KindConstructSignature)
            return DiagType_parameter_0_of_constructor_signature_from_exported_interface_has_or_is_using_private_name_1
        if pk = KindCallSignature
