        {
            let left AstNode.binary_left_of(node)
            set simple_name: left
            if (AstNode.kind_of(left) = KindPropertyAccessExpression) or (AstNode.kind_of(left) = KindElementAccessExpression)
            {
                let left_name AstNode.name_of(left)
                if left_name <> null
                    set simple_name: left_name
            }
        }
        let k node.kind
        if dt_diag_kind = 2
        {
            if (k = KindSetAccessor) or (k = KindGetAccessor)
                return DtDiagnostic(node, Transformer.dt_accessor_name_visibility_code(node, result), simple_name)
            if (k = KindMethodDeclaration) or (k = KindMethodSignature)
                return DtDiagnostic(node, Transformer.dt_method_name_visibility_code(node, result), simple_name)
        }
        ; createGetSymbolAccessibilityDiagnosticForNode
        var variable_like false
        if k = KindVariableDeclaration
            set variable_like: true
        if k = KindPropertyDeclaration
            set variable_like: true
        if k = KindPropertySignature
            set variable_like: true
        if k = KindPropertyAccessExpression
            set variable_like: true
        if k = KindElementAccessExpression
            set variable_like: true
        if k = KindBinaryExpression
            set variable_like: true
        if k = KindBindingElement
            set variable_like: true
        if k = KindConstructor
            set variable_like: true
        if variable_like
            return DtDiagnostic(node, Transformer.dt_variable_declaration_type_visibility_code(node, result), simple_name)
        if (k = KindSetAccessor) or (k = KindGetAccessor)
            return DtDiagnostic(simple_name, Transformer.dt_accessor_declaration_type_visibility_code(node, result), simple_name)
        var signature_like false
        if k = KindConstructSignature
            set signature_like: true
        if k = KindCallSignature
            set signature_like: true
        if k = KindMethodDeclaration
            set signature_like: true
        if k = KindMethodSignature
            set signature_like: true
        if k = KindFunctionDeclaration
            set signature_like: true
        if k = KindIndexSignature
            set signature_like: true
        if signature_like
        {
            var error_node Printer.declaration_name_of(node)
            if error_node = null
                set error_node: node
            return DtDiagnostic(error_node, Transformer.dt_return_type_visibility_code(node, result), null)
        }
        if k = KindParameter
        {
            let parent AstNode.parent_node_of(node)
            if Transformer.is_parameter_property_declaration(node, parent) and Transformer.has_syntactic_modifier(parent, ModifierFlagsPrivate)
                return DtDiagnostic(node, Transformer.dt_variable_declaration_type_visibility_code(node, result), simple_name)
            return DtDiagnostic(node, Transformer.dt_parameter_declaration_type_visibility_code(node, result), simple_name)
        }
        if k = KindTypeParameter
            return DtDiagnostic(node, Transformer.dt_type_parameter_constraint_visibility_code(node, result), simple_name)
        if k = KindExpressionWithTypeArguments
